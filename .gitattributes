# TypeLisp sources and shell scripts must stay LF in the working tree.
# The self-hosted formatter (`src/main.tl fmt`) emits LF, so a CRLF checkout
# (e.g. Git's `autocrlf=true` default on Windows CI runners) would make
# `typelisp fmt --check` report every .tl file as needing reformat, breaking the
# Windows formatter gate added in #763. Forcing LF keeps the gate consistent
# across Linux and Windows.
*.tl text eol=lf
*.sh text eol=lf
tests/tlci/corpus/*.stdout text eol=lf
tests/tlci/corpus/*.stderr text eol=lf
tests/tlci/corpus/SHA256SUMS text eol=lf
tests/tlci/corpus/*.tlci binary
tests/integration/include_str_comptime_payload.txt text eol=lf
# Application corpus inputs, expected outputs and manifests are byte oracles.
tests/apps/** text eol=lf

# ci-verify.sh reads the CI gate table on both hosts; keep it LF.
scripts/ci-gates.tsv text eol=lf
scripts/ci-affected-paths.tsv text eol=lf
scripts/ci-affected-inputs.tsv text eol=lf
tests/fixtures/ci-affected/** text eol=lf

# Unicode profile inputs are exact upstream byte oracles (including CSV CRLF).
tools/idna-unicode12-data/inputs/* binary

# ELF fixture objects and LLVM projections are exact byte oracles.
tests/fixtures/elf-object/*.in binary
tests/fixtures/elf-object/*.expected text eol=lf

# DSO images are data; their readelf projections are exact LF byte oracles.
tests/fixtures/elf-dso/*.in binary
tests/fixtures/elf-dso/*.expected text eol=lf
tests/fixtures/elf-dso/producer.manifest text eol=lf
