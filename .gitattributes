# TypeLisp sources and shell scripts must stay LF in the working tree.
# The self-hosted formatter (`src/main.tl fmt`) emits LF, so a CRLF checkout
# (e.g. Git's `autocrlf=true` default on Windows CI runners) would make
# `typelisp fmt --check` report every .tl file as needing reformat, breaking the
# Windows formatter gate added in #763. Forcing LF keeps the gate consistent
# across Linux and Windows.
*.tl text eol=lf
*.sh text eol=lf
tests/tlci/corpus/*.stdout text eol=lf
tests/tlci/corpus/*.stderr text eol=lf
tests/tlci/corpus/SHA256SUMS text eol=lf
tests/tlci/corpus/*.tlci binary
tests/integration/include_str_comptime_payload.txt text eol=lf
