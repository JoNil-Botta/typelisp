# TypeLisp build outputs. Nothing generated by the toolchain belongs in version
# control; see CONTRIBUTING.md ("Generated artifacts should not be committed").
#
# `scripts/check-gitignore.sh` gates this file: it asserts the patterns below
# still cover the toolchain's outputs and that no tracked file is ignored.

# ---------------------------------------------------------------------------
# Extensionless native executables
#
# `typelisp build path/to/foo.tl` writes the executable next to its source:
# `foo.exe` on Windows, and an extensionless `foo` on Linux. Git has no glob
# for "name without an extension", so ignore extensionless files repo-wide and
# re-include tracked exceptions by name. `git add` refuses an ignored path with
# an explicit hint, so tracking a new extensionless file is a one-line negation
# here.
#
# This block stays first: every rule after it may narrow what `!*.*` allows
# back in, and a re-inclusion cannot survive an excluded parent directory.
# ---------------------------------------------------------------------------
*
!*/
!*.*
!/tests/tlci/corpus/SHA256SUMS

# Extensionless names that are content rather than build output. Listed even
# when absent so adding one later does not need a .gitignore change first.
!/LICENSE
!/.github/CODEOWNERS

# Package, bootstrap, and experiment outputs, at the repository root and under
# nested package roots in the test corpora.
target/

# Native toolchain artifacts. `typelisp compile` writes assembly beside the
# source; assembling, linking, and `staticlib` builds add the rest.
*.s
!/tests/golden/*.s
*.o
*.obj
*.a
*.lib
*.exe
*.pdb
*.ilk

# Inline test and integration scratch space.
/tests/scratch/*
!/tests/scratch/.gitkeep

# Downloaded stage0 compiler cache (scripts/fetch-stage0.sh).
/tools/stage0/

# VS Code extension Node build artifacts.
/tools/vs-code-extension/node_modules/
/tools/vs-code-extension/out/
/tools/vs-code-extension/dist/

# Agent workspace and machine-specific editor settings.
.claude/
.vscode/
