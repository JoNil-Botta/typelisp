                buf)])]
        [(CompilerIrInstr.Load load-dst ptr load-ty)
          (if (and
            (compiler-backend-load-compare-type? load-ty)
            (compiler-backend-var-single-use? use-counts load-dst))
            (match (box-get rest)
              [(CompilerIrInstrList.Cons next after-cmp)
                (match next
                  [(CompilerIrInstr.Load second-dst second-src second-ty)
                    (if (compiler-backend-branch-uses-var? second-src load-dst)
                      (compiler-backend-emit-fused-result-rest
                        target
                        function
                        source-function
                        blocks
                        current-label
                        fallthrough
                        (compiler-backend-emit-load-load
                          assignments
                          load-dst
                          ptr
                          load-ty
                          second-dst
                          second-ty)
                        (box-get after-cmp)
                        assignments
                        vars
                        types
                        global-types
                        ret-ty
                        plan
                        functions
                        externs
                        program-index
                        spans
                        func-diag
                        use-counts
                        buf)
                      (compiler-backend-emit-instrs-normal
                        target
                        function
                        source-function
                        blocks
                        current-label
                        fallthrough
                        instr
                        (box-get rest)
                        assignments
                        vars
                        types
                        global-types
                        ret-ty
                        plan
                        functions
                        externs
                        program-index
                        spans
                        func-diag
                        use-counts
                        buf))]
                  [(CompilerIrInstr.BinOp cmp-dst op lhs rhs cmp-ty)
                    (if (and
                      (compiler-backend-compare-op? op)
                      (compiler-backend-branch-uses-var? lhs load-dst)
                      (compiler-backend-var-single-use? use-counts cmp-dst)
                      (not
                        (compiler-backend-binop-f64?
                          types
                          global-types
                          lhs
                          rhs
                          cmp-ty)))
                      (match (box-get after-cmp)
                        [(CompilerIrInstrList.Cons branch after-branch)
                          (match branch
                            [(CompilerIrInstr.Branch
                                cond
                                true-label
                                false-label)
                              (if (compiler-backend-branch-uses-var?
                                cond
                                cmp-dst)
                                (compiler-backend-emit-fused-load-compare-branch-rest
                                  target
                                  function
                                  source-function
                                  blocks
                                  current-label
                                  fallthrough
                                  load-dst
                                  ptr
                                  load-ty
                                  cmp-dst
                                  op
                                  rhs
                                  cmp-ty
                                  true-label
                                  false-label
                                  (box-get after-branch)
                                  assignments
                                  vars
                                  types
                                  global-types
                                  ret-ty
                                  plan
                                  functions
                                  externs
                                  program-index
                                  spans
                                  func-diag
                                  use-counts
                                  buf)
                                (compiler-backend-emit-instrs-normal
                                  target
                                  function
                                  source-function
                                  blocks
                                  current-label
                                  fallthrough
                                  instr
                                  (box-get rest)
                                  assignments
                                  vars
                                  types
                                  global-types
                                  ret-ty
                                  plan
                                  functions
                                  externs
                                  program-index
                                  spans
                                  func-diag
                                  use-counts
                                  buf))]
                            [_
                              (compiler-backend-emit-instrs-normal
                                target
                                function
                                source-function
                                blocks
                                current-label
                                fallthrough
                                instr
                                (box-get rest)
                                assignments
                                vars
                                types
                                global-types
                                ret-ty
                                plan
                                functions
                                externs
                                program-index
                                spans
                                func-diag
                                use-counts
                                buf)])]
                        [_
                          (compiler-backend-emit-instrs-normal
                            target
                            function
                            source-function
                            blocks
                            current-label
                            fallthrough
                            instr
                            (box-get rest)
                            assignments
                            vars
                            types
                            global-types
                            ret-ty
                            plan
                            functions
                            externs
                            program-index
                            spans
                            func-diag
                            use-counts
                            buf)])
                      (compiler-backend-emit-instrs-normal
                        target
                        function
                        source-function
                        blocks
                        current-label
                        fallthrough
                        instr
                        (box-get rest)
                        assignments
                        vars
                        types
                        global-types
                        ret-ty
                        plan
                        functions
                        externs
                        program-index
                        spans
                        func-diag
                        use-counts
                        buf))]
                  [_
                    (compiler-backend-emit-instrs-normal
                      target
                      function
                      source-function
                      blocks
                      current-label
                      fallthrough
                      instr
                      (box-get rest)
                      assignments
                      vars
                      types
                      global-types
                      ret-ty
                      plan
                      functions
                      externs
                      program-index
                      spans
                      func-diag
                      use-counts
                      buf)])]
              [_
                (compiler-backend-emit-instrs-normal
                  target
                  function
                  source-function
                  blocks
                  current-label
                  fallthrough
                  instr
                  (box-get rest)
                  assignments
                  vars
                  types
                  global-types
                  ret-ty
                  plan
                  functions
                  externs
                  program-index
                  spans
                  func-diag
                  use-counts
                  buf)])
            (compiler-backend-emit-instrs-normal
              target
              function
              source-function
              blocks
              current-label
              fallthrough
              instr
              (box-get rest)
              assignments
              vars
              types
              global-types
              ret-ty
              plan
              functions
              externs
              program-index
              spans
              func-diag
              use-counts
              buf))]
        [(CompilerIrInstr.BinOp dst op lhs rhs ty)
          (if (and
            (compiler-backend-var-single-use? use-counts dst)
            (compiler-backend-rax-forwardable-binop?
              types
              global-types
              assignments
              op
              lhs
              rhs
              ty)
            (compiler-backend-rest-starts-rax-forwardable-consumer?
              types
              global-types
              assignments
              dst
              (box-get rest)))
            (match (compiler-backend-emit-binop-to-rax
              types
              global-types
              assignments
              dst
              op
              lhs
              rhs
              ty
              false)
              [(ResultCompilerBackend.Ok head)
                (compiler-backend-emit-instrs-with-rax
                  target
                  function
                  source-function
                  blocks
                  current-label
                  fallthrough
                  dst
                  ty
                  (box-get rest)
                  assignments
                  vars
                  types
                  global-types
                  ret-ty
                  plan
                  functions
                  externs
                  program-index
                  spans
                  func-diag
                  use-counts
                  (text_buf.append buf (compiler-backend-emergency-wrap head)))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)])
            (if (and
              (compiler-backend-compare-op? op)
              (or
                (compiler-backend-var-single-use? use-counts dst)
                (compiler-backend-var-fuse-safe? dst))
              (not (compiler-backend-binop-f64? types global-types lhs rhs ty)))
              (match (box-get rest)
                [(CompilerIrInstrList.Cons next after-branch)
                  (match next
                    [(CompilerIrInstr.Return maybe)
                      (match (box-get after-branch)
                        [(CompilerIrInstrList.Nil)
                          (match maybe
                            [(CompilerIrMaybeValue.Some value)
                              (if (compiler-backend-branch-uses-var? value dst)
                                (compiler-backend-emit-terminator-into
                                  (compiler-backend-emit-binop-return
                                    source-function
                                    blocks
                                    types
                                    global-types
                                    assignments
                                    vars
                                    op
                                    lhs
                                    rhs
                                    ty)
                                  buf)
                                (compiler-backend-emit-instrs-normal
                                  target
                                  function
                                  source-function
                                  blocks
                                  current-label
                                  fallthrough
                                  instr
                                  (box-get rest)
                                  assignments
                                  vars
                                  types
                                  global-types
                                  ret-ty
                                  plan
                                  functions
                                  externs
                                  program-index
                                  spans
                                  func-diag
                                  use-counts
                                  buf))]
                            [(CompilerIrMaybeValue.No)
                              (compiler-backend-emit-instrs-normal
                                target
                                function
                                source-function
                                blocks
                                current-label
                                fallthrough
                                instr
                                (box-get rest)
                                assignments
                                vars
                                types
                                global-types
                                ret-ty
                                plan
                                functions
                                externs
                                program-index
                                spans
                                func-diag
                                use-counts
                                buf)])]
                        [_
                          (compiler-backend-emit-instrs-normal
                            target
                            function
                            source-function
                            blocks
                            current-label
                            fallthrough
                            instr
                            (box-get rest)
                            assignments
                            vars
                            types
                            global-types
                            ret-ty
                            plan
                            functions
                            externs
                            program-index
                            spans
                            func-diag
                            use-counts
                            buf)])]
                    [(CompilerIrInstr.Branch cond true-label false-label)
                      (if (compiler-backend-branch-uses-var? cond dst)
                        (compiler-backend-emit-fused-compare-branch-rest
                          target
                          function
                          source-function
                          blocks
                          current-label
                          fallthrough
                          dst
                          op
                          lhs
                          rhs
                          ty
                          true-label
                          false-label
                          (box-get after-branch)
                          assignments
                          vars
                          types
                          global-types
                          ret-ty
                          plan
                          functions
                          externs
                          program-index
                          spans
                          func-diag
                          use-counts
                          buf)
                        (compiler-backend-emit-instrs-normal
                          target
                          function
                          source-function
                          blocks
                          current-label
                          fallthrough
                          instr
                          (box-get rest)
                          assignments
                          vars
                          types
                          global-types
                          ret-ty
                          plan
                          functions
                          externs
                          program-index
                          spans
                          func-diag
                          use-counts
                          buf))]
                    [_
                      (compiler-backend-emit-instrs-normal
                        target
                        function
                        source-function
                        blocks
                        current-label
                        fallthrough
                        instr
                        (box-get rest)
                        assignments
                        vars
                        types
                        global-types
                        ret-ty
                        plan
                        functions
                        externs
                        program-index
                        spans
                        func-diag
                        use-counts
                        buf)])]
                [_
                  (compiler-backend-emit-instrs-normal
                    target
                    function
                    source-function
                    blocks
                    current-label
                    fallthrough
                    instr
                    (box-get rest)
                    assignments
                    vars
                    types
                    global-types
                    ret-ty
                    plan
                    functions
                    externs
                    program-index
                    spans
                    func-diag
                    use-counts
                    buf)])
              (compiler-backend-emit-instrs-normal
                target
                function
                source-function
                blocks
                current-label
                fallthrough
                instr
                (box-get rest)
                assignments
                vars
                types
                global-types
                ret-ty
                plan
                functions
                externs
                program-index
                spans
                func-diag
                use-counts
                buf)))]
        [_
          (compiler-backend-emit-instrs-normal
            target
            function
            source-function
            blocks
            current-label
            fallthrough
            instr
            (box-get rest)
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            func-diag
            use-counts
            buf)])]))

;; Drift-proof per-instruction position for the scavenge coordinate. `post-base`
;; is the cumulative instruction count through the current block (accumulated per
;; block in emit-blocks-into, reset per function in install-ctx); the structural
;; index of the head of `current-instrs` is `post-base - (count current-instrs)`,
;; which equals the interval walk's I (point = 2*I), fusion-proof because the emit
;; loop maintains current-instrs (consuming K drops its length by K). Consumed
;; under (cfg scavenge-self-check) to verify, and later by the no-dst scavenge.
(define compiler-backend-emit-instr-post-base : i64
  0)

;; The remaining-instruction count at the current emit step, captured per step so
;; the no-dst scavenge (compiler-backend-scavenge-reg-here) can derive its point =
;; 2*(post-base - count). Stored as a count, not the list, because the list is a
;; loop-carried owner value that cannot be moved into a global. No asm output.
(define compiler-backend-emit-current-count : i64
  0)

;; r8-collision detector (cfg r8-collision-check): with %r8 pooled, logs every
;; emitted %r8-write that occurs while a live value occupies %r8. Logs (does not panic) so one compile
;; yields the complete site list.
(define compiler-backend-r8c-len0 : i64
  0)
(define compiler-backend-r8c-point : i64
  0)

(define (compiler-backend-r8c-delta
  [chunks : TextBufChunkList]
  [need : i64]
  [acc : i64]
  [out : String]) : String
  (if (>= acc need)
    out
    (match chunks
      [(TextBufChunkNil) out]
      [(TextBufChunkCons s rest)
        (compiler-backend-r8c-delta
          (box-get rest)
          need
          (+ acc (string-length s))
          (str-cat s out))])))

(define (compiler-backend-r8c-write? [delta : String] [reg : String]) : bool
  (or
    (compiler-backend-string-contains? delta (str-cat reg "\n"))
    (compiler-backend-string-contains? delta (str-cat reg "d\n"))
    (compiler-backend-string-contains? delta (str-cat reg "w\n"))
    (compiler-backend-string-contains? delta (str-cat reg "b\n"))))

(define (compiler-backend-r8c-occupied-strict? [point : i64] [reg : String]) : bool
  (let
    [v : i64 0]
    [hit : bool false]
    (begin
      (while (and (< v compiler-backend-scavenge-ctx-vars) (not hit))
        (begin
          (if (and
            (>= (array-ref compiler-backend-scavenge-ctx-starts v) 0)
            (< (array-ref compiler-backend-scavenge-ctx-starts v) point)
            (< point (array-ref compiler-backend-scavenge-ctx-ends v))
            (compiler-backend-scavenge-var-holds?
              compiler-backend-scavenge-ctx-assignment-index
              v
              reg))
            (set! hit true)
            unit)
          (set! v (+ v 1))))
      hit)))

(define (compiler-backend-r8c-check-reg! [delta : String] [reg : String]) : unit
  (if (and
    (compiler-backend-r8c-write? delta reg)
    (compiler-backend-r8c-occupied-strict? compiler-backend-r8c-point reg))
    (print-error (str-cat "=RXC= " reg "\n" delta))
    unit))

(define (compiler-backend-r8c-check! [_function : String] [nb : TextBuf]) : unit
  (let
    [dl : i64 (- (text_buf.length nb) compiler-backend-r8c-len0)]
    (if (> dl 0)
      (let
        [delta : String
          (compiler-backend-r8c-delta (struct-get nb chunks) dl 0 "")]
        (begin
          (compiler-backend-r8c-check-reg! delta "%r8")
          (compiler-backend-r8c-check-reg! delta "%r10")
          (compiler-backend-r8c-check-reg! delta "%r11")))
      unit)))

(define (compiler-backend-emit-instrs-loop
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [mode : CompilerBackendEmitInstrsMode]
  [instrs : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (let
    [current-mode : CompilerBackendEmitInstrsMode mode]
    [current-instrs : CompilerIrInstrList instrs]
    [current-buf : text_buf.TextBuf buf]
    [done : bool false]
    [ok : bool true]
    [asm-out : String ""]
    [diag-out : (Box CompilerDiagnostic)
      (box (compiler-diagnostic-at-start "" ""))]
    (begin
      (set! compiler-backend-emit-instrs-loop-active true)
      (while (not done)
        (let
          [step-result : ResultCompilerBackend
            (begin
              (set!
                compiler-backend-emit-current-count
                (compiler-ir-instr-list-count current-instrs))
              (cfg
                r8-collision-check
                (begin
                  (set! compiler-backend-r8c-len0 (text_buf.length current-buf))
                  (set!
                    compiler-backend-r8c-point
                    (*
                      2
                      (-
                        compiler-backend-emit-instr-post-base
                        (compiler-ir-instr-list-count current-instrs)))))
                unit)
              (cfg
                scavenge-self-check
                (match current-instrs
                  [(CompilerIrInstrList.Cons head-instr _)
                    ;; Per-step used-var check against the LIVE installed ctx
                    ;; (real point). Live-through validation is done by the
                    ;; function-level scavenge-self-check (which has the liveness
                    ;; to supply live-after sets); pass empty here.
                    (compiler-backend-scavenge-check-instr
                      compiler-backend-scavenge-ctx-starts
                      compiler-backend-scavenge-ctx-ends
                      compiler-backend-scavenge-ctx-assignment-index
                      compiler-backend-scavenge-ctx-vars
                      function
                      (*
                        2
                        (-
                          compiler-backend-emit-instr-post-base
                          (compiler-ir-instr-list-count current-instrs)))
                      head-instr
                      (compiler-live-set-empty))]
                  [(CompilerIrInstrList.Nil) unit])
                unit)
              (set! compiler-backend-emit-instrs-continue-pending false)
              (match current-mode
                [(CompilerBackendEmitInstrsMode.Normal)
                  (compiler-backend-emit-instrs-step
                    target
                    function
                    source-function
                    blocks
                    current-label
                    fallthrough
                    current-instrs
                    assignments
                    vars
                    types
                    global-types
                    ret-ty
                    plan
                    functions
                    externs
                    program-index
                    spans
                    func-diag
                    use-counts
                    current-buf)]
                [(CompilerBackendEmitInstrsMode.Rax rax-var rax-ty)
                  (compiler-backend-emit-instrs-with-rax-step
                    target
                    function
                    source-function
                    blocks
                    current-label
                    fallthrough
                    rax-var
                    rax-ty
                    current-instrs
                    assignments
                    vars
                    types
                    global-types
                    ret-ty
                    plan
                    functions
                    externs
                    program-index
                    spans
                    func-diag
                    use-counts
                    current-buf)]
                [(CompilerBackendEmitInstrsMode.CallRax rax-var rax-ty)
                  (compiler-backend-emit-instrs-with-call-rax-step
                    target
                    function
                    source-function
                    blocks
                    current-label
                    fallthrough
                    rax-var
                    rax-ty
                    current-instrs
                    assignments
                    vars
                    types
                    global-types
                    ret-ty
                    plan
                    functions
                    externs
                    program-index
                    spans
                    func-diag
                    use-counts
                    current-buf)]))]
          (match step-result
            [(ResultCompilerBackend.Ok asm)
              (if compiler-backend-emit-instrs-continue-pending
                (begin
                  (cfg
                    r8-collision-check
                    (compiler-backend-r8c-check!
                      function
                      compiler-backend-emit-instrs-next-buf)
                    unit)
                  (set! current-mode compiler-backend-emit-instrs-next-mode)
                  (set! current-instrs compiler-backend-emit-instrs-next-instrs)
                  (set! current-buf compiler-backend-emit-instrs-next-buf))
                (begin
                  (set! asm-out asm)
                  (set! done true)))]
            [(ResultCompilerBackend.Err message)
              (begin
                (set! diag-out message)
                (set! ok false)
                (set! done true))])))
      (set! compiler-backend-emit-instrs-loop-active false)
      (if ok
        (ResultCompilerBackend.Ok asm-out)
        (ResultCompilerBackend.Err diag-out)))))

(define (compiler-backend-emit-instrs
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [instrs : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (if compiler-backend-emit-instrs-loop-active
    (compiler-backend-emit-instrs-set-continue!
      (CompilerBackendEmitInstrsMode.Normal)
      instrs
      buf)
    (compiler-backend-emit-instrs-loop
      target
      function
      source-function
      blocks
      current-label
      fallthrough
      (CompilerBackendEmitInstrsMode.Normal)
      instrs
      assignments
      vars
      types
      global-types
      ret-ty
      plan
      functions
      externs
      program-index
      spans
      func-diag
      use-counts
      buf)))

