(define (compiler-backend-windows-driver-runtime-source) : String
  "(extern (arg-count) : i64 (:symbol \"tl_arg_count\"))
(extern (io.arg [arg0 : i64]) : String (:symbol \"tl_arg\"))
(extern (raw-read-file [arg0 : String]) : String (:symbol \"tl_read_file\"))
(extern (raw-write-file [arg0 : String] [arg1 : String]) : unit (:symbol \"tl_write_file\"))
(extern (io.file-exists? [arg0 : String]) : bool (:symbol \"tl_file_exists\"))
(extern (io.print-error [arg0 : String]) : unit (:symbol \"tl_print_err\"))
(extern (string.eq [arg0 : String] [arg1 : String]) : bool (:symbol \"tl_string_eq\"))
(extern (string.>int [arg0 : String]) : i64 (:symbol \"tl_string_to_int\"))
(extern (string.int->string [arg0 : i64]) : String (:symbol \"tl_int_to_string\"))
(define (main) : i64
  (if (< (arg-count) 3)
    (begin
      (io.print-error \"runtime driver: expected input and output paths\")
      2)
    (let [input : String (io.arg 1)]
      [output : String (io.arg 2)]
      (let [content : String (raw-read-file (io.arg 1))]
        (if (io.file-exists? input)
          (let [n : i64 (string.>int content)]
            (let [rendered : String (string.int->string (+ n 1))]
              (begin
                (if (string.eq (raw-read-file (io.arg 1)) \"41\")
                  (io.print-error \"ok\")
                  (io.print-error \"mismatch\"))
                (raw-write-file output rendered)
                42)))
          3)))))")

(define (compiler-backend-windows-driver-runtime-ok?) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-windows-driver-runtime-source)
    (be_state.CompilerBackendTarget.Windows))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (be_operand.compiler-backend-string-contains?
            asm
            ".extern tl_arg_count\n")
          (be_operand.compiler-backend-string-contains? asm ".extern tl_arg\n")
          (be_operand.compiler-backend-string-contains?
            asm
            ".extern tl_read_file\n")
          (be_operand.compiler-backend-string-contains?
            asm
            ".extern tl_write_file\n")
          (be_operand.compiler-backend-string-contains?
            asm
            ".extern tl_file_exists\n")
          (be_operand.compiler-backend-string-contains?
            asm
            ".extern tl_print_err\n")
          (be_operand.compiler-backend-string-contains?
            asm
            ".extern tl_string_eq\n")
          (be_operand.compiler-backend-string-contains?
            asm
            ".extern tl_string_to_int\n"))
        (be_operand.compiler-backend-string-contains?
          asm
          "    call tl_int_to_string\n")
        (not
          (be_operand.compiler-backend-string-contains?
            asm
            "tl_int_to_string:\n"))
        (be_operand.compiler-backend-string-contains?
          asm
          ".extern tl_int_to_string\n")
        (be_operand.compiler-backend-string-contains?
          asm
          "    movq %rcx, .L_tl_argc(%rip)\n")
        (be_state.backend-and4
          (not
            (be_operand.compiler-backend-string-contains?
              asm
              ".L_tl_arg_count:\n"))
          (not
            (be_operand.compiler-backend-string-contains? asm ".L_tl_arg:\n"))
          (not
            (be_operand.compiler-backend-string-contains? asm "tl_print_err:\n"))
          (not
            (be_operand.compiler-backend-string-contains?
              asm
              ".L_tl_read_file:\n")))
        (not
          (be_operand.compiler-backend-string-contains?
            asm
            ".L_tl_write_file:\n"))
        (not
          (be_operand.compiler-backend-string-contains?
            asm
            ".L_tl_file_exists:\n"))
        (not
          (be_operand.compiler-backend-string-contains? asm "tl_string_eq:\n"))
        (not
          (be_operand.compiler-backend-string-contains?
            asm
            "tl_string_to_int:\n"))
        (not
          (be_operand.compiler-backend-string-contains? asm "    call _open\n"))
        (not (be_operand.compiler-backend-string-contains? asm "syscall\n")))]
    [(Err _) false]))

(define (compiler-backend-extern-metadata-symbol-ok?) : bool
  (let
    [target-ok?
      (lambda ([target : be_state.CompilerBackendTarget]) : bool
        (match (compiler-backend-emit-source-for-target
          (str_cat.str-cat
            "(extern (local-call [arg0 : i64]) : i64 (:abi c) (:symbol \"foreign_exact\"))\n"
            "(define (normal) : i64 1)\n"
            "(define (main) : i64 (+ (local-call 7) (normal)))")
          target)
          [(Ok asm)
            (and
              (be_operand.compiler-backend-string-contains?
                asm
                ".extern foreign_exact\n")
              (be_operand.compiler-backend-string-contains?
                asm
                "    call foreign_exact\n")
              (or
                (be_operand.compiler-backend-string-contains?
                  asm
                  "    call _tl_normal")
                (be_operand.compiler-backend-string-contains?
                  asm
                  "    call _tl_f"))
              (not
                (be_operand.compiler-backend-string-contains?
                  asm
                  ".extern local-call\n"))
              (not
                (be_operand.compiler-backend-string-contains?
                  asm
                  "    call local-call\n")))]
          [(Err _) false]))]
    (and
      (target-ok? (be_state.CompilerBackendTarget.Linux))
      (target-ok? (be_state.CompilerBackendTarget.Windows)))))

(define (compiler-backend-test-get-compiler-backend-rsp-rebase-no-push) : (__tl_dyn-array
    String)
  (unsafe
    (ptr-read (ptr-addr-of be_peephole.compiler-backend-rsp-rebase-no-push))))