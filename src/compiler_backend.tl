(define (compiler-backend-lazy-table-storage-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [scratch : arena.Arena (arena.make)]
    [backend-state : CompilerBackendState
      (compiler-backend-state-new (ci.intern-compat-state-capture-active))]
    [stream : CompilerBackendStreamState
      (compiler-backend-state-stream-state backend-state)]
    [initially-lazy? : bool
      (and
        (= (compiler-backend-state-lazy-table-arena backend-state) 0)
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              carry-safe-offsets))
          0)
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              owner-global-offsets))
          0)
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              sweep-sym-off))
          0)
        (= (compiler-backend-state-slot-cache-capacity backend-state) 0)
        (= (compiler-backend-state-frame-offset-cache-capacity backend-state) 0)
        (= (compiler-backend-state-immediate-cache-capacity backend-state) 0)
        (=
          (compiler-backend-state-operand-cache-retained-bytes backend-state)
          0))]
    [_set-scratch : unit
      (unsafe
        (arena.set! scratch))]
    [_carry : unit
      (compiler-backend-peephole-carry-safe-reset-with-backend-state!
        backend-state
        stream)]
    [carry-restored-caller? : bool (arena.eq? (arena.current) scratch)]
    [lazy-root : i64 (compiler-backend-state-lazy-table-arena backend-state)]
    [carry-table-grew? : bool
      (compiler-backend-peephole-carry-safe-table-grow! backend-state stream)]
    [carry-bytes-grew? : bool
      (compiler-backend-peephole-carry-safe-bytes-grow!
        backend-state
        stream
        (+ compiler-backend-peephole-carry-safe-initial-bytes-capacity 1))]
    [carry-growth-restored-caller? : bool (arena.eq? (arena.current) scratch)]
    [_owner : unit
      (compiler-backend-peephole-owner-global-reset-with-backend-state!
        backend-state
        stream)]
    [owner-restored-caller? : bool (arena.eq? (arena.current) scratch)]
    [owner-table-grew? : bool
      (compiler-backend-peephole-owner-global-table-grow! backend-state stream)]
    [owner-bytes-grew? : bool
      (compiler-backend-peephole-owner-global-bytes-grow!
        backend-state
        stream
        (+ compiler-backend-peephole-owner-global-initial-bytes-capacity 1))]
    [owner-growth-restored-caller? : bool (arena.eq? (arena.current) scratch)]
    [_sweep : unit
      (compiler-backend-sweep-storage-ensure! backend-state stream)]
    [sweep-table-grew? : bool
      (compiler-backend-sweep-table-grow! backend-state stream)]
    [sweep-bytes-grew? : bool
      (compiler-backend-sweep-bytes-grow!
        backend-state
        stream
        (+ compiler-backend-sweep-initial-bytes-capacity 1))]
    [sweep-coverage-grew? : bool
      (compiler-backend-sweep-coverage-ensure! backend-state stream 65)]
    [sweep-restored-caller? : bool (arena.eq? (arena.current) scratch)]
    [slot-render : String
      (compiler-backend-slot-with-backend-state backend-state 0)]
    [slot-restored-caller? : bool (arena.eq? (arena.current) scratch)]
    [frame-render : String
      (compiler-backend-frame-offset-with-backend-state backend-state -16)]
    [frame-restored-caller? : bool (arena.eq? (arena.current) scratch)]
    [immediate-render : String
      (compiler-backend-state-immediate-render backend-state 17)]
    [immediate-restored-caller? : bool (arena.eq? (arena.current) scratch)]
    [lazy-root-stable? : bool
      (= lazy-root (compiler-backend-state-lazy-table-arena backend-state))]
    [grown-capacities? : bool
      (and
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              carry-safe-offsets))
          (* 4 compiler-backend-peephole-carry-safe-initial-capacity))
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              carry-safe-lengths))
          (* 4 compiler-backend-peephole-carry-safe-initial-capacity))
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              carry-safe-bytes))
          (* 4 compiler-backend-peephole-carry-safe-initial-bytes-capacity))
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              owner-global-offsets))
          (* 2 compiler-backend-peephole-owner-global-initial-capacity))
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              owner-global-lengths))
          (* 2 compiler-backend-peephole-owner-global-initial-capacity))
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              owner-global-bytes))
          (* 2 compiler-backend-peephole-owner-global-initial-bytes-capacity))
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              sweep-sym-off))
          (* 4 compiler-backend-sweep-initial-capacity))
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              sweep-sym-bytes))
          (* 4 compiler-backend-sweep-initial-bytes-capacity))
        (=
          (array-length
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              sweep-coverage-bits))
          128)
        (=
          (compiler-backend-state-slot-cache-capacity backend-state)
          compiler-backend-slot-cache-capacity)
        (=
          (compiler-backend-state-frame-offset-cache-capacity backend-state)
          compiler-backend-slot-cache-capacity)
        (= (compiler-backend-state-immediate-cache-capacity backend-state) 8192)
        (=
          (compiler-backend-state-operand-cache-retained-bytes backend-state)
          655360))]
    (begin
      (unsafe
        (arena.set! caller))
      (arena.destroy-safe! scratch)
      (set!
        (array-ref
          (__tl-project-field
            (compiler-backend-stream-state-data stream)
            carry-safe-offsets)
          0)
        17)
      (set!
        (array-ref
          (__tl-project-field
            (compiler-backend-stream-state-data stream)
            owner-global-bytes)
          0)
        3)
      (set!
        (array-ref
          (__tl-project-field
            (compiler-backend-stream-state-data stream)
            sweep-sym-off)
          0)
        29)
      (set!
        (array-ref
          (__tl-project-field
            (compiler-backend-stream-state-data stream)
            sweep-coverage-bits)
          0)
        31)
      (set!
        (array-ref
          (__tl-project-field
            (compiler-backend-state-data backend-state)
            slot-cache-epochs)
          0)
        47)
      (set!
        (array-ref
          (__tl-project-field
            (compiler-backend-state-data backend-state)
            frame-offset-cache-epochs)
          0)
        53)
      (set!
        (array-ref
          (__tl-project-field
            (compiler-backend-state-data backend-state)
            immediate-cache-epochs)
          0)
        59)
      (let
        [survived? : bool
          (and
            (=
              (array-ref
                (__tl-project-field
                  (compiler-backend-stream-state-data stream)
                  carry-safe-offsets)
                0)
              17)
            (=
              (array-ref
                (__tl-project-field
                  (compiler-backend-stream-state-data stream)
                  owner-global-bytes)
                0)
              3)
            (=
              (array-ref
                (__tl-project-field
                  (compiler-backend-stream-state-data stream)
                  sweep-sym-off)
                0)
              29)
            (=
              (array-ref
                (__tl-project-field
                  (compiler-backend-stream-state-data stream)
                  sweep-coverage-bits)
                0)
              31)
            (string.eq slot-render "-8(%rbp)")
            (string.eq frame-render "-16(%rbp)")
            (string.eq immediate-render "$17")
            (=
              (array-ref
                (__tl-project-field
                  (compiler-backend-state-data backend-state)
                  slot-cache-epochs)
                0)
              47)
            (=
              (array-ref
                (__tl-project-field
                  (compiler-backend-state-data backend-state)
                  frame-offset-cache-epochs)
                0)
              53)
            (=
              (array-ref
                (__tl-project-field
                  (compiler-backend-state-data backend-state)
                  immediate-cache-epochs)
                0)
              59))]
        (begin
          (compiler-backend-peephole-carry-safe-reset-with-backend-state!
            backend-state
            stream)
          (compiler-backend-peephole-owner-global-reset-with-backend-state!
            backend-state
            stream)
          (and
            initially-lazy?
            carry-restored-caller?
            carry-table-grew?
            carry-bytes-grew?
            carry-growth-restored-caller?
            owner-restored-caller?
            owner-table-grew?
            owner-bytes-grew?
            owner-growth-restored-caller?
            sweep-table-grew?
            sweep-bytes-grew?
            sweep-coverage-grew?
            sweep-restored-caller?
            slot-restored-caller?
            frame-restored-caller?
            immediate-restored-caller?
            lazy-root-stable?
            grown-capacities?
            survived?))))))

(define (compiler-backend-forwarded-addr-of-register-home-refused-ok?) : bool
  (let
    [backend-state : CompilerBackendState
      (compiler-backend-state-new (ci.intern-compat-state-capture-active))]
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [forwarded : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [_forward : unit
      (begin
        (compiler-backend-addr-of-forwarding-fill! forwarded 0)
        (set! (array-ref forwarded 2) 1)
        (compiler-backend-function-state-set-i64-array!
          function-state
          compiler-backend-function-i64-array-addr-of-forwarding-src
          forwarded)
        (compiler-backend-function-state-set-bool!
          function-state
          compiler-backend-function-bool-addr-of-forwarding-enabled
          true))]
    [home : String
      (compiler-backend-value-register-home
        backend-state
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            2
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-rax))
          (compiler_regalloc.compiler-reg-assignment-table-empty))
        (compiler_ir_types.CompilerIrValue.Var 2))]
    (string.eq home "")))

