;; First-class arena runtime. `tl_arena_make` maps a fresh INDEPENDENT
;; 64 MiB arena chain (prev-link 0) and returns its header WITHOUT changing the
;; active arena. `tl_arena_current`/`tl_arena_set` read/write the active arena.
;; `tl_arena_destroy` releases an arena's whole active chain plus any retired
;; overflow chunks held by the chain root. Arena header is the same 64-byte
;; record as tl_alloc {0:prev, 8:base, 16:bump, 24:end, 32:retired, 40:root,
;; 48:kind/lock, 56:root-current}.
;; System V (mmap=9 / munmap=11) flavor.
;; These mmap/munmap calls are part of the checked backend-core page boundary,
;; not stdlib-owned OS helpers.
;;
;; These are `.globl` symbols. The runtime (arena primitives, tl_alloc, the
;; region runtime, and the `tl_current_arena` slot) is emitted in exactly ONE
;; object per executable ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â the entry/executable object (`emit-entry=true`).
;; Library/dependency objects (`emit-entry=false`) emit none of the runtime and
;; reference these symbols as externs, so a multi-object link (a package plus its
;; dependency .a archive) resolves every object's calls to the single definition
;; in the entry object ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â no `multiple definition` collision.
(define (compiler-backend-runtime-linux-arena-functions [profile : bool]) : String
  (string.append
    "    .globl tl_thread_init
tl_thread_init:
    movq $4096, %rsi
    xorq %rdi, %rdi
    movq $3, %rdx
    movq $0x22, %r10
    movq $-1, %r8
    xorq %r9, %r9
    movq $9, %rax
    syscall
    testq %rax, %rax
    js .L_tl_thread_init_abort
    movq $tl_current_arena@tpoff, %rdi
    subq %rdi, %rax
    movq %rax, %rsi
    movq $0x1002, %rdi
    movq $158, %rax
    syscall
    testq %rax, %rax
    js .L_tl_thread_init_abort
    ret
.L_tl_thread_init_abort:
    movq $60, %rax
    movq $134, %rdi
    syscall

    .globl tl_arena_current
tl_arena_current:
"
    (string.append
      (compiler-backend-current-arena-load (CompilerBackendTarget.Linux) "%rax")
      (string.append
        "    ret

    .globl tl_arena_set
tl_arena_set:
"
        (string.append
          (compiler-backend-current-arena-store
            (CompilerBackendTarget.Linux)
            "%rdi")
          (string.append
            "    ret

    .globl tl_arena_poison_enable
tl_arena_poison_enable:
    movq $1, .L_tl_arena_poison_enabled(%rip)
    ret

    .globl tl_arena_make
tl_arena_make:
    movq $0x4000000, %rsi
    xorq %rdi, %rdi
    movq $3, %rdx
    movq $0x22, %r10
    movq $-1, %r8
    xorq %r9, %r9
    movq $9, %rax
    syscall
    testq %rax, %rax
    js .L_tl_arena_make_abort
    movq $0, 0(%rax)
    movq $0, 32(%rax)
    movq %rax, 40(%rax)
    movq $0, 48(%rax)
    movq %rax, 56(%rax)
    leaq 64(%rax), %rcx
    movq %rcx, 8(%rax)
    movq %rcx, 16(%rax)
    movq %rax, %rcx
    addq $0x4000000, %rcx
    movq %rcx, 24(%rax)
    ret
.L_tl_arena_make_abort:
    movq $60, %rax
    movq $134, %rdi
    syscall

    .globl tl_arena_make_atomic
tl_arena_make_atomic:
    movq $0x4000000, %rsi
    xorq %rdi, %rdi
    movq $3, %rdx
    movq $0x22, %r10
    movq $-1, %r8
    xorq %r9, %r9
    movq $9, %rax
    syscall
    testq %rax, %rax
    js .L_tl_arena_make_atomic_abort
    movq $0, 0(%rax)
    movq $0, 32(%rax)
    movq %rax, 40(%rax)
    movq $1, 48(%rax)
    movq %rax, 56(%rax)
    leaq 64(%rax), %rcx
    movq %rcx, 8(%rax)
    movq %rcx, 16(%rax)
    movq %rax, %rcx
    addq $0x4000000, %rcx
    movq %rcx, 24(%rax)
    ret
.L_tl_arena_make_atomic_abort:
    movq $60, %rax
    movq $134, %rdi
    syscall

    .globl tl_arena_destroy
tl_arena_destroy:
