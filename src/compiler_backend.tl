(import stdlib.env)

;; Complete results use emission-arena; these private tables have no result
;; consumer. Unpublish their views before retiring the one-shot backend state.
;; The caller retains its intern capability, metrics and advisory sink.
(define (compiler-backend-state-release-final-arenas!
  [state : be_state.CompilerBackendState]) : unit
  (unsafe
    (let
      [data : (MutPtr be_state.CompilerBackendStateData)
        (be_state.compiler-backend-state-ptr state)]
      [lazy-owner : i64 (deref data).lazy-table-arena]
      [copy-thunk-owner : i64 (deref data).copy-thunk-arena]
      [representation-owner : i64 (deref data).representation-arena]
      (set!
        (deref data).emission-symbols
        be_state.CompilerBackendEmissionSymbols.None)
      (set! (deref data).lazy-table-arena 0)
      (set! (deref data).slot-cache-values (__tl_make-array String 0))
      (set! (deref data).slot-cache-epochs (__tl_make-array i64 0))
      (set! (deref data).frame-offset-cache-values (__tl_make-array String 0))
      (set! (deref data).frame-offset-cache-epochs (__tl_make-array i64 0))
      (set! (deref data).immediate-cache-values (__tl_make-array String 0))
      (set! (deref data).immediate-cache-epochs (__tl_make-array i64 0))
      (set! (deref data).copy-thunks (backend_string_i64_map.with-capacity 1))
      (set! (deref data).copy-thunk-bodies (__tl_make-array String 0))
      (set! (deref data).copy-thunk-count 0)
      (set! (deref data).copy-thunk-size-counts (__tl_make-array i64 0))
      (set! (deref data).copy-thunk-arena 0)
      (set! (deref data).copy-thunk-mark 0)
      (set! (deref data).function-state-address 0)
      (set! (deref data).stream-state-address 0)
      (set!
        (deref data).representations
        (compiler_ir_types.compiler-ir-representation-index-empty))
      (set! (deref data).has-representations false)
      (set!
        (deref data).representation-type-stamp
        (compiler_ast_types.AstMaybeTypePoolStamp.No))
      (set! (deref data).representation-arena 0)
      (set! (deref data).representation-mark 0)
      (set! (deref data).copy-thunk-arena 0)
      (set! (deref data).copy-thunk-mark 0)
      (if (> lazy-owner 0)
        (arena.tl_arena_destroy lazy-owner)
        unit)
      (if (> copy-thunk-owner 0)
        (arena.tl_arena_destroy copy-thunk-owner)
        unit)
      (if (and
        (> representation-owner 0)
        (not (= representation-owner lazy-owner)))
        (arena.tl_arena_destroy representation-owner)
        unit))))

(define (compiler-backend-state-prepare-representation-arena!
  [state : be_state.CompilerBackendState]) : arena.Arena
  (let
    [data : (MutPtr be_state.CompilerBackendStateData)
      (be_state.compiler-backend-state-ptr state)]
    [home : arena.Arena (arena.current)]
    (unsafe
      (if (= (deref data).representation-arena 0)
        (let
          [owner : arena.Arena
            (unsafe
              (arena.Arena (arena.tl_arena_make_small)))]
          [_set-owner : unit (arena.set! owner)]
          [mark : arena.ArenaMark (arena.mark)]
          (arena.set! home)
          (set! (deref data).representation-arena (arena.raw-handle owner))
          (set! (deref data).representation-mark (arena.mark-raw-handle mark))
          (set! (deref data).has-representations false)
          owner)
        (let
          [owner : arena.Arena
            (unsafe
              (arena.Arena (deref data).representation-arena))]
          [mark : arena.ArenaMark
            (arena.ArenaMark (deref data).representation-mark)]
          ;; Clear the validity bit before invalidating the old maps. The stale
          ;; carrier is overwritten immediately after the replacement build and
          ;; is never observed while `has-representations` is false.
          (set! (deref data).has-representations false)
          (arena.set! owner)
          (arena.rewind mark)
          (arena.set! home)
          owner)))))

;; This explicit live-owner entry runs before any per-function slot coloring.
;; Rebuild against this exact program revision and target, preserving the
;; separately retained nominal representation facts. The result is the
;; authority problem, empty when the program's evidence is valid. A stale or
;; malformed authority leaves no representation facts to consult, so emission
;; must stop rather than classify every nominal aggregate as Unknown.
(define (compiler-backend-state-authorize-return-storage!
  [state : be_state.CompilerBackendState]
  [pools : compiler_ast_types.AstNodePoolContext]
  [program : (& program compiler_ir_types.CompilerIrProgram)]
  [target : be_state.CompilerBackendTarget]) : String
  (let
    [data : be_state.CompilerBackendStateData
      (be_state.compiler-backend-state-data state)]
    [interns : ci.InternCompatState
      (be_state.compiler-backend-global-shared-view data.intern-state)]
    ;; Reuse the installed word counts and class masks only when they were
    ;; built from this program's type storage; otherwise rebuild all three.
    [reuse? : bool
      (be_state.compiler-backend-state-representations-for-pools?
        (& data)
        (& pools))]
    [owner : arena.Arena
      (if reuse?
        (unsafe
          (arena.Arena data.representation-arena))
        (compiler-backend-state-prepare-representation-arena! state))]
    [representation : compiler_ir_types.CompilerIrRepresentationIndex
      (in-arena
        owner
        (if reuse?
          (match program
            [(compiler_ir_types.CompilerIrProgram.Program
                _
                functions
                externs
                authority)
              (compiler_ir_types.CompilerIrRepresentationIndex
                data.representations.word-counts
                data.representations.class-masks
                data.representations.stable-word-masks
                (compiler_ir_types.compiler-ir-return-storage-index-authorized
                  pools
                  interns
                  (if (be_facts.compiler-backend-target-windows? target)
                    1
                    0)
                  functions
                  externs
                  authority))])
          (compiler_ir_types.compiler-ir-representation-index-with-authority
            pools
            interns
            (if (be_facts.compiler-backend-target-windows? target)
              1
              0)
            program
            ;; Facts built for other pools are not reused; a missing package
            ;; layout then stays Unknown and admission rejects it (#8532).
            (compiler_ir_types.compiler-ir-representation-index-empty))))]
    [problem : String (string.copy representation.return-storage.problem)]
    (be_state.compiler-backend-state-set-representations-for-pools!
      state
      (& pools)
      representation)
    problem))

;; The emitter's result, with an error restated at the instruction being emitted.
(defmacro (compiler-backend-with-instr-diagnostic
  [result : Expr]
  [instr-diag : Expr]) : Expr
  `(match ,result
    [(be_state.ResultCompilerBackend.Ok asm)
      (be_state.ResultCompilerBackend.Ok asm)]
    [(be_state.ResultCompilerBackend.Err message)
      (be_state.compiler-backend-instr-error-from ,instr-diag message)]))

(define (compiler-backend-mode-prologue [mode : be_state.CompilerBackendMode]) : String
  (match mode
    [(Avx2) "    vzeroupper\n"]
    [_ ""]))

;; Per-function dense operand-home view for emission.
;; compiler-backend-emit-function installs the function's FINAL (post-coloring)
;; assignment table after every re-plan stage (caller-save,
;; slot coloring) has been folded into it, so each operand-home
;; query is an O(1) array read. `active` gates the function-state view; callers
;; of emit helpers outside whole-function emission (unit tests, closure-entry
;; adapters) read the same authoritative table from their context. The rax
;; override is the single-entry call-result-forwarding delta: during call-arg
;; emission, `rax-override-var` names the one var whose home is pinned to %rax.
;; It applies to both the dense view and the context-table fallback, avoiding an
;; otherwise linear assignment-table copy for every forwarded call.
;; Short, emission-local home overrides used by the adjacent constant-divmod
;; folds.  They never alter the allocator plan: a producer and the divmod it
;; feeds may temporarily agree on the divmod SRC, and a single-use result may
;; remain there through its direct store.  Two slots cover those two SSA values
;; while the fused bundle is emitted.  Unlike the call-result %rax override,
;; these apply even when the function-state assignment view is disabled (unit
;; helpers and small functions still use their context table directly).
(define (compiler-backend-emit-home-overrides-disable!
  [function-state : be_state.CompilerBackendFunctionState]) : unit
  (be_state.compiler-backend-function-state-set-i64!
    function-state
    be_state.compiler-backend-function-i64-home-override0-var
    -1)
  (be_state.compiler-backend-function-state-set-i64!
    function-state
    be_state.compiler-backend-function-i64-home-override0-reg
    compiler_abi.compiler-reg-id-invalid)
  (be_state.compiler-backend-function-state-set-i64!
    function-state
    be_state.compiler-backend-function-i64-home-override1-var
    -1)
  (be_state.compiler-backend-function-state-set-i64!
    function-state
    be_state.compiler-backend-function-i64-home-override1-reg
    compiler_abi.compiler-reg-id-invalid))

(define (compiler-backend-instr-uses-simd?
  [instr : (& instr compiler_ir_types.CompilerIrInstr)]) : bool
  (match instr
    [(or (LaneId _ _ _) (Splat _ _ _ _) (VectorBinOp _) (VectorPrefix _)
         (VectorReduce _ _ _ _ _) (VectorCompare _) (MaskBinOp _ _ _ _ _)
         (MaskNot _ _ _) (MaskReduce _ _ _ _) (VectorLoad _ _ _ _ _)
         (VectorStore _) (PredicatedStore _) (PredicatedLoad _) (GatherLoad _)
         (VectorShuffle _) (TailMask _ _ _ _))
      true]
    [(SpmdCall p)
      (match (& p.backend)
        [(Scalar) false]
        [_ true])]
    [(Select p) (> p.lanes 0)]
    [_ false]))

(define (compiler-backend-function-uses-simd?
  [function-abi : (& function-abi compiler_ir_types.CompilerIrFunctionAbi)]
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockList)]) : bool
  (if (match function-abi
    [(SpmdPrivate abi)
      (match (& abi.backend)
        [(Scalar) false]
        [_ true])]
    [_ false])
    true
    (match blocks
      [(Array seq)
        (let
          [bcount : i64 (compiler_ir_types.compiler-ir-block-seq-count seq)]
          [b : i64 0]
          [found : bool false]
          (while (and (< b bcount) (not found))
            (match (compiler_ir_types.compiler-ir-block-seq-borrow seq b)
              [(Block _ instrs)
                (let
                  [icount : i64 instrs.len]
                  [i : i64 0]
                  (while (and (< i icount) (not found))
                    (when
                      (compiler-backend-instr-uses-simd?
                        (compiler_ir_types.compiler-ir-instr-seq-borrow
                          instrs
                          i))
                      (set! found true))
                    (set! i (+ i 1))))])
            (set! b (+ b 1)))
          found)])))

(define (compiler-backend-program-uses-simd?
  [program : (& program compiler_ir_types.CompilerIrProgram)]) : bool
  (match program
    [(Program _ functions _ _)
      (let
        [f : i64 0]
        [found : bool false]
        (while (and (< f functions.len) (not found))
          (match (& (array-ref functions.slots f))
            [(Function _ _ _ _ blocks function-abi)
              (when
                (compiler-backend-function-uses-simd? function-abi blocks)
                (set! found true))])
          (set! f (+ f 1)))
        found)]))

(define (compiler-backend-emit-vector-reduce
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrVectorReduceOp]
  [src : compiler_ir_types.CompilerIrValue]
  [lanes : i64]
  [elem-ty : compiler_ast_types.AstType]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (when
    (match (& op)
      [(LastLane) true]
      [_ false])
    (return
      (be_simd.compiler-backend-emit-vector-last-lane
        assignments
        dst
        src
        lanes
        elem-ty
        instr-diag
        backend-state)))
  (cond
    [(be_operand.compiler-backend-avx512-shape-ok? elem-ty lanes)
      (be_operand.compiler-backend-emit-avx512-vector-reduce
        type-segment-bases
        assignments
        dst
        op
        src
        lanes
        elem-ty
        instr-diag
        backend-state)]
    [(be_operand.compiler-backend-sse2-shape-ok? elem-ty lanes)
      (be_operand.compiler-backend-emit-sse2-vector-reduce
        type-segment-bases
        assignments
        dst
        op
        src
        lanes
        elem-ty
        instr-diag
        backend-state)]
    [else
      (be_operand.compiler-backend-emit-avx2-vector-reduce
        type-segment-bases
        assignments
        dst
        op
        src
        lanes
        elem-ty
        instr-diag
        backend-state)]))

;; Set by the two helpers below, the only spellings of an %rbp-relative frame
;; reference the emitter produces. The frame size is computed after the body and
;; the parameter spills are emitted (the same ordering the emergency/cycle-temp
;; flags rely on), so a function that never names a slot can drop its slot
;; region. Planning-time calls set it too, which costs the optimization but
;; never correctness.
(define (compiler-backend-frame-slot-referenced-reset!
  [function-state : be_state.CompilerBackendFunctionState]) : unit
  (be_state.compiler-backend-function-state-set-bool!
    function-state
    be_state.compiler-backend-function-bool-frame-slot-referenced
    false)
  (be_state.compiler-backend-function-state-set-bool!
    function-state
    be_state.compiler-backend-function-bool-nonsave-frame-slot-referenced
    false))

(define (compiler-backend-emit-windows-seh-endproc
  [target : be_state.CompilerBackendTarget]) : String
  (if (be_state.compiler-backend-target-seh-unwind? target)
    "    .seh_endproc\n"
    ""))

(define (compiler-backend-simd-scratch-drift-message
  [function-state : be_state.CompilerBackendFunctionState]) : String
  (str_cat.str-cat
    "backend: SIMD staging plan drift: planned "
    (string.int->string
      (be_state.compiler-backend-function-scratch-i64
        function-state
        be_state.compiler-backend-scratch-i64-simd-scratch-bytes))
    " bytes, the body used "
    (string.int->string
      (be_state.compiler-backend-function-scratch-i64
        function-state
        be_state.compiler-backend-scratch-i64-simd-scratch-used-bytes))))

(define (compiler-backend-debug-function-end-label
  [target : be_state.CompilerBackendTarget]
  [program-index : be_state.CompilerBackendProgramIndex]
  [function : i64]) : String
  (if (and
    (compiler_ir_types.compiler-debug-info-enabled?)
    (be_state.compiler-backend-target-coff? target))
    (match (be_operand.compiler-backend-index-function-slot
      program-index
      function)
      [(LookupFound function-id)
        (str_cat.str-cat
          ".Lcv_func_end_"
          (string.int->string function-id)
          ":\n")]
      [(LookupMissing) ""])
    ""))

;; Record the addressed object's extent for the sweep's precise leaq poison.
;; A register-resident group is two words; every other object is its declared
;; storage words (an `AddrOf`'s storage operand), never less than one slot.
(define (compiler-backend-note-addr-of-extent!
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [src : i64]
  [storage-words : i64]
  [backend-state : be_state.CompilerBackendState]) : unit
  (compiler-backend-sweep-addr-record!
    backend-state
    (be_operand.compiler-backend-addr-of-source-rbp-offset
      assignments
      src
      backend-state)
    (if (be_operand.compiler-backend-addressable-group-var? backend-state src)
      16
      (if (< storage-words 1)
        8
        (* 8 storage-words)))))

(define (compiler-backend-set-shift-count-bound!
  [function-state : be_state.CompilerBackendFunctionState]
  [bound : i64]) : unit
  (be_state.compiler-backend-function-state-set-i64!
    function-state
    be_state.compiler-backend-function-i64-shift-count-bound
    bound))

(define (compiler-backend-branch-value-direct?
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [value : compiler_ir_types.CompilerIrValue]
  [backend-state : be_state.CompilerBackendState]) : bool
  (match (& value)
    [(Var id)
      (not
        (string.eq
          (be_operand.compiler-backend-branch-test-var-asm
            assignments
            id
            backend-state)
          ""))]
    [_
      (match (be_operand.compiler-backend-value-as-i64 value)
        [(Some _) true]
        [(None) false])]))

;; The flags-reuse window rule. True when `head` -- the assembly a materialized
;; comparison just emitted -- ends with exactly the two lines
;;
;;     <setcc> <r8>
;;     movzb{l,q} <r8>, <r>
;;
;; and the `setcc` spelling is `setcc`, the mnemonic the caller's op/type maps
;; to. `setcc` and `movzb` both READ and neither WRITES EFLAGS, so the flags the
;; comparison itself set are still live at the end of `head`: a branch on the
;; materialized boolean may consume them with the matching `jcc` instead of
;; re-deriving them with `test`/`cmp $0`. Requiring the pair to be the LAST two
;; lines is what makes "nothing wrote flags in between" true -- the window is
;; closed, not enumerated -- and requiring the `setcc` mnemonic to be the one
;; the caller's `jcc` pair was derived from is what ties the reused condition to
;; the boolean the branch actually reads. Emergency spill save/restore text may
;; still wrap this head; it is `movq` only, and so flag-safe on both sides.
(define (compiler-backend-asm-tail-setcc-materializes?
  [head : (& head str)]
  [setcc : String]) : bool
  (let
    [data : (Ptr u8)
      (unsafe
        (string-data head))]
    [n : i64 (string.string-length head)]
    [cc-len : i64 (string.string-length setcc)]
    (if (or
      (= cc-len 0)
      (< n 2)
      (not (= (be_state.compiler-backend-peephole-byte-at data (- n 1)) 10)))
      false
      (let
        [zext-start : i64
          (be_operand.compiler-backend-asm-prev-line-start data (- n 1))]
        [src-start : i64 (+ zext-start 11)]
        (if (or
          (= zext-start 0)
          (>= src-start (- n 1))
          (not
            (or
              (be_operand.compiler-backend-peephole-range-eq?
                data
                zext-start
                src-start
                "    movzbq ")
              (be_operand.compiler-backend-peephole-range-eq?
                data
                zext-start
                src-start
                "    movzbl "))))
          false
          (let
            [comma : i64
              (be_operand.compiler-backend-peephole-scan-byte-range
                data
                src-start
                (- n 1)
                44)]
            [set-start : i64
              (be_operand.compiler-backend-asm-prev-line-start
                data
                (- zext-start 1))]
            [set-op : i64 (+ set-start 4)]
            [set-src : i64 (+ set-op (+ cc-len 1))]
            (and
              (> comma src-start)
              (< comma (- n 1))
              (< set-src (- zext-start 1))
              (be_operand.compiler-backend-peephole-range-eq?
                data
                set-start
                set-op
                "    ")
              (be_operand.compiler-backend-peephole-range-eq?
                data
                set-op
                (+ set-op cc-len)
                setcc)
              (=
                (be_state.compiler-backend-peephole-byte-at
                  data
                  (+ set-op cc-len))
                32)
              (be_operand.compiler-backend-peephole-ranges-eq?
                data
                set-src
                (- zext-start 1)
                data
                src-start
                comma))))))))

(define (compiler-backend-load-compare-type?
  [type-segment-bases : i64]
  [ty : (& compiler_ast_types.AstType)]) : bool
  (and
    (not (be_operand.compiler-backend-float-type? ty))
    (= (be_operand.compiler-backend-type-size type-segment-bases ty) 8)))

(define (compiler-backend-emit-addr-of
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [src : i64]
  [storage-words : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  ;; Record the addressed object's extent for the sweep's precise leaq poison.
  ;; A forwarded AddrOf emits no leaq here but materialises the same slot at
  ;; its use, so the extent applies to that later leaq too.
  (let
    [_extent : unit
      (compiler-backend-note-addr-of-extent!
        assignments
        src
        storage-words
        backend-state)]
    (if (>=
      (be_operand.compiler-backend-forwarded-addr-of-src backend-state dst)
      0)
      (Ok "")
      (let
        [slot : String
          (be_operand.compiler-backend-addr-of-source-slot
            assignments
            src
            backend-state)]
        (Ok
          (match (be_operand.compiler-backend-emit-assignment-lookup
            backend-state
            assignments
            dst)
            [(Some location)
              (match location
                [(or (Register home) (RegisterPair home _))
                  (str_cat.str-cat
                    "    leaq "
                    slot
                    ", "
                    (compiler_abi.compiler-abi-register-spelling home)
                    "\n")]
                [(Spill offset)
                  (let
                    [addr-reg : String
                      (be_operand.compiler-backend-scavenge-reg
                        dst
                        (be_facts.compiler-backend-addr-scavenge-exclude)
                        0
                        "%r8"
                        backend-state)]
                    (str_cat.str-cat
                      (str_cat.str-cat "    leaq " slot ", " addr-reg "\n")
                      (str_cat.str-cat
                        "    movq "
                        addr-reg
                        ", "
                        (be_operand.compiler-backend-frame-offset-with-backend-state
                          backend-state
                          offset)
                        "\n"
                        ""
                        "")))]
                ;; The address-of result is defined by CompilerIrInstr.AddrOf, never a remat
                ;; Mov; unreachable.
                [(Remat _) ""])]
            [(No)
              (let
                [addr-reg : String
                  (be_operand.compiler-backend-scavenge-reg
                    dst
                    (be_facts.compiler-backend-addr-scavenge-exclude)
                    0
                    "%r8"
                    backend-state)]
                (str_cat.str-cat
                  (str_cat.str-cat "    leaq " slot ", " addr-reg "\n")
                  (be_operand.compiler-backend-emit-store-var
                    assignments
                    dst
                    addr-reg
                    backend-state)))]))))))

(define (compiler-backend-copy-xmm-scratch
  [size : i64]
  [backend-state : be_state.CompilerBackendState]) : String
  (if (>= size 16)
    (let
      [no-exclude : (__tl_dyn-array String) (__tl_make-array String 0)]
      (be_operand.compiler-backend-scavenge-xmm-reg
        -1
        no-exclude
        0
        "%xmm2"
        backend-state))
    ""))

(define (compiler-backend-copy-needs-gp-scratch?
  [size : i64]
  [xmm-scratch : (& xmm-scratch str)]) : bool
  (if (> (string.string-length xmm-scratch) 0)
    (not (= (% size 16) 0))
    (> size 0)))

;; Arena for the registry's map and the keys and bodies it holds. It is
;; created on first use and rewound by `compiler-backend-copy-thunks-reset!`,
;; so nothing registered for one program survives that program's emission.
;; The emit-time arenas cannot host the registry (they are rewound around
;; program composition, underneath it) and the state's long-lived lazy arena
;; must not either: its pages are never reclaimed, so every thunk table and
;; body would still be live after the compile.
(define (compiler-backend-copy-thunk-arena-ensure!
  [state : be_state.CompilerBackendState]) : arena.Arena
  (let
    [data : (MutPtr be_state.CompilerBackendStateData)
      (be_state.compiler-backend-state-ptr state)]
    (unsafe
      (if (= (deref data).copy-thunk-arena 0)
        (let
          [home : arena.Arena (arena.current)]
          [owner : arena.Arena
            (unsafe
              (arena.Arena (arena.tl_arena_make_small)))]
          [_set-owner : unit (arena.set! owner)]
          [mark : arena.ArenaMark (arena.mark)]
          (arena.set! home)
          (set! (deref data).copy-thunk-arena (arena.raw-handle owner))
          (set! (deref data).copy-thunk-mark (arena.mark-raw-handle mark))
          owner)
        (unsafe
          (arena.Arena (deref data).copy-thunk-arena))))))

;; A fresh emission starts with no thunks: reclaim the previous emission's
;; map, keys and bodies with the program's emission, then drop every handle
;; into them so no later read can touch the rewound pages, and recreate both
;; tables in the arena, which now holds only them.
(define (compiler-backend-copy-thunks-reset!
  [state : be_state.CompilerBackendState]) : unit
  (let
    [data : (MutPtr be_state.CompilerBackendStateData)
      (be_state.compiler-backend-state-ptr state)]
    (unsafe
      (if (> (deref data).copy-thunk-arena 0)
        (let
          [home : arena.Arena (arena.current)]
          [owner : arena.Arena
            (unsafe
              (arena.Arena (deref data).copy-thunk-arena))]
          (unsafe
            (arena.set! owner)
            (arena.rewind (arena.ArenaMark (deref data).copy-thunk-mark))
            (arena.set! home)))
        unit)
      (in-arena
        (compiler-backend-copy-thunk-arena-ensure! state)
        (let
          [fresh : backend_string_i64_map.Map
            (backend_string_i64_map.with-capacity 1)]
          [bodies : (__tl_dyn-array String) (__tl_make-array String 0)]
          [counts : (__tl_dyn-array i64)
            (__tl_make-array
              i64
              (+ be_scalar.compiler-backend-copy-thunk-size-bucket-max 1))]
          (set! (deref data).copy-thunks fresh)
          (set! (deref data).copy-thunk-bodies bodies)
          (set! (deref data).copy-thunk-size-counts counts)
          unit))
      (set! (deref data).copy-thunk-count 0))))

(define (compiler-backend-copy-thunk-size-counts-scan-blocks!
  [blocks : (& blocks (Slice compiler_ir_types.CompilerIrBlock))]
  [counts : (&mut counts (__tl_dyn-array i64))]) : unit
  (match blocks
    [(slice) unit]
    [(slice block & rest)
      (match block
        [(Block _ instrs)
          (let
            [n : i64 instrs.len]
            (for [i (iterator.range 0 n)]
              (match (& (array-ref instrs.slots i))
                [(CopyBytes _ _ size)
                  (when
                    (and
                      (>=
                        size
                        be_scalar.compiler-backend-copy-thunk-size-opt-min-bytes)
                      (= (% size 4) 0))
                    (let
                      [bucket : i64
                        (be_scalar.compiler-backend-copy-thunk-size-bucket size)]
                      (when
                        (and (>= bucket 0) (< bucket (array-length counts)))
                        (set!
                          (array-ref counts bucket)
                          (+ (array-ref counts bucket) 1)))))]
                [_ unit])))])
      (compiler-backend-copy-thunk-size-counts-scan-blocks! rest counts)]))

;; Count eligible `CopyBytes` sizes across all functions with a returning call
;; before function emission starts, so single-use sizes in small binaries stay
;; inline instead of paying for a thunk definition + call overhead.
(define (compiler-backend-copy-thunk-size-counts-collect!
  [functions : (& functions compiler_ir_types.CompilerIrFunctionSeq)]
  [backend-state : be_state.CompilerBackendState]) : unit
  (let
    [data : (MutPtr be_state.CompilerBackendStateData)
      (be_state.compiler-backend-state-ptr backend-state)]
    [counts : (__tl_dyn-array i64)
      (unsafe
        (deref data).copy-thunk-size-counts)]
    (when
      (> (array-length counts) 0)
      (for [i (iterator.range 0 functions.len)]
        (match (& (array-ref functions.slots i))
          [(Function _ _ _ _ blocks _)
            (let
              [view (compiler_ir_types.compiler-ir-block-list-view blocks)]
              (when
                (compiler-backend-blocks-have-returning-call? view)
                (compiler-backend-copy-thunk-size-counts-scan-blocks!
                  view
                  (&mut counts))))])))))

(define (compiler-backend-copy-thunk-key
  [bytes : i64]
  [src-reg : (& str)]
  [dst-reg : (& str)]
  [dst-bias : i64]
  [xmm-scratch : (& str)]) : String
  (str_cat.str-cat
    (string.int->string bytes)
    "|"
    src-reg
    "|"
    dst-reg
    "|"
    (string.int->string dst-bias)
    "|"
    xmm-scratch))

(define (compiler-backend-copy-thunk-pair-src [tier : i64]) : String
  (cond [(= tier 0) "%rax"] [(= tier 1) "%r10"] [else "%rcx"]))

(define (compiler-backend-copy-thunk-pair-dst [tier : i64]) : String
  (cond [(= tier 0) "%rcx"] [(= tier 1) "%r11"] [else "%rax"]))

;; Common read-only register pairs emitted with ZERO setup instructions when
;; both bases already sit in those registers with displacement 0. Because a
;; canonical thunk (`size % 4 == 0`) never writes `src` or `dst`, reading a
;; callee-saved register preserves both System V and Win64 SEH invariants.
(define (compiler-backend-copy-thunk-direct-pair?
  [src-base : (& str)]
  [dst-base : (& str)]
  [size : i64]
  [size-count : i64]) : bool
  (cond
    [(and (= size 48) (>= size-count 120))
      (or
        (and
          (string.eq src-base "%rax")
          (or
            (string.eq dst-base "%r12")
            (string.eq dst-base "%rsi")
            (string.eq dst-base "%r13")
            (string.eq dst-base "%rdi")
            (string.eq dst-base "%r14")
            (string.eq dst-base "%rdx")
            (string.eq dst-base "%r8")))
        (and (string.eq src-base "%rsi") (string.eq dst-base "%rax"))
        (and (string.eq src-base "%r13") (string.eq dst-base "%r12"))
        (and (string.eq src-base "%r12") (string.eq dst-base "%r13"))
        (and (string.eq src-base "%rsi") (string.eq dst-base "%r13"))
        (and (string.eq src-base "%rdi") (string.eq dst-base "%rax")))]
    [(and (>= size 56) (<= size 112) (>= size-count 300))
      (or
        (and
          (string.eq src-base "%rax")
          (or
            (string.eq dst-base "%r12")
            (string.eq dst-base "%rsi")
            (string.eq dst-base "%r13")
            (and
              (>= size-count 450)
              (or (string.eq dst-base "%rdi") (string.eq dst-base "%r14")))
            (and (= size 56) (string.eq dst-base "%rdx"))))
        (and (string.eq src-base "%rsi") (string.eq dst-base "%rax"))
        (and
          (>= size-count 450)
          (string.eq src-base "%r13")
          (string.eq dst-base "%r12")))]
    [else false]))

;; Top enum-payload (`dst-disp == 8`) read-only pairs emitted with zero setup
;; instructions by baking the +8 destination bias into the canonical thunk body.
(define (compiler-backend-copy-thunk-direct-disp8-pair?
  [src-base : (& str)]
  [dst-base : (& str)]
  [size : i64]
  [size-count : i64]) : bool
  (or
    (and
      (>= size 48)
      (<= size 112)
      (>= size-count 300)
      (string.eq src-base "%rax")
      (string.eq dst-base "%r12"))
    (and
      (>= size 56)
      (<= size 104)
      (>= size-count 450)
      (or
        (and (string.eq src-base "%r13") (string.eq dst-base "%r12"))
        (and (string.eq src-base "%r14") (string.eq dst-base "%r12"))
        (and (string.eq src-base "%rsi") (string.eq dst-base "%rax"))))))

(define (compiler-backend-copy-thunk-pick-xmm [forbidden : i64]) : String
  (cond
    [(=
        (bit-and
          forbidden
          (be_operand.compiler-backend-scavenge-reg-bit "%xmm2"))
        0)
      "%xmm2"]
    [(=
        (bit-and
          forbidden
          (be_operand.compiler-backend-scavenge-reg-bit "%xmm3"))
        0)
      "%xmm3"]
    [(=
        (bit-and
          forbidden
          (be_operand.compiler-backend-scavenge-reg-bit "%xmm4"))
        0)
      "%xmm4"]
    [(=
        (bit-and
          forbidden
          (be_operand.compiler-backend-scavenge-reg-bit "%xmm5"))
        0)
      "%xmm5"]
    [else ""]))

(define (compiler-backend-copy-thunk-base-is-sib? [base : (& base str)]) : bool
  (be_operand.compiler-backend-string-contains? base ","))

(define (compiler-backend-copy-thunk-disp8? [disp : i64]) : bool
  (and (>= disp (- 0 128)) (<= disp 127)))

(define (compiler-backend-copy-thunk-setup-one-bytes
  [base : (& base str)]
  [disp : i64]
  [target : (& target str)]) : i64
  (cond
    [(string.eq base "")
      (cond
        [(= disp 0) 0]
        [(compiler-backend-copy-thunk-disp8? disp) 4]
        [else 7])]
    [(and (= disp 0) (string.eq base target)) 0]
    [(and (= disp 0) (not (compiler-backend-copy-thunk-base-is-sib? base))) 3]
    [(= disp 0) 4]
    [(compiler-backend-copy-thunk-disp8? disp) 4]
    [else 7]))

(define (compiler-backend-copy-thunk-base-uses-rex? [base : (& base str)]) : bool
  (or
    (be_operand.compiler-backend-string-contains? base "%r8")
    (be_operand.compiler-backend-string-contains? base "%r9")
    (be_operand.compiler-backend-string-contains? base "%r1")))

;; Byte profitability guard for `-Os` sub-48 B copies (`32..44 B`): emit a
;; canonical call only when `5 (call) + setup_bytes` beats the inline sequence
;; by at least 3 bytes per site.
(define (compiler-backend-copy-thunk-small-profitable?
  [size : i64]
  [src-base : (& str)]
  [src-disp : i64]
  [dst-base : (& str)]
  [dst-disp : i64]
  [c-src : (& str)]
  [c-dst : (& str)]) : bool
  (if (>= size 48)
    true
    (let
      [tail : i64 (% size 16)]
      [extra-inline : i64
        (if (or
          (not (= src-disp 0))
          (not (= dst-disp 0))
          (compiler-backend-copy-thunk-base-is-sib? src-base)
          (compiler-backend-copy-thunk-base-is-sib? dst-base)
          (compiler-backend-copy-thunk-base-uses-rex? src-base)
          (compiler-backend-copy-thunk-base-uses-rex? dst-base))
          4
          0)]
      [tail-bytes : i64
        (cond [(= tail 4) 6] [(= tail 8) 8] [(= tail 12) 14] [else 0])]
      [inline-est : i64 (+ 14 (+ extra-inline tail-bytes))]
      [setup-bytes : i64
        (+
          (compiler-backend-copy-thunk-setup-one-bytes src-base src-disp c-src)
          (compiler-backend-copy-thunk-setup-one-bytes dst-base dst-disp c-dst))]
      (<= (+ 5 setup-bytes) (- inline-est 3)))))

(define (compiler-backend-copy-thunk-setup-one-asm
  [base : (& base str)]
  [disp : i64]
  [target : (& target str)]) : String
  (cond
    [(string.eq base "") ""]
    [(and (= disp 0) (string.eq base target)) ""]
    [(and (= disp 0) (not (compiler-backend-copy-thunk-base-is-sib? base)))
      (str_cat.str-cat "    movq " base ", " target "\n")]
    [else
      (str_cat.str-cat
        "    leaq "
        (be_facts.compiler-backend-copy-address disp (string.copy base))
        ", "
        target
        "\n")]))

(define (compiler-backend-copy-thunk-forbidden-mask
  [protect : (& protect (__tl_dyn-array String))]
  [protect-n : i64]
  [backend-state : be_state.CompilerBackendState]) : i64
  (let
    [fn-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state backend-state)]
    [point : i64
      (be_state.compiler-backend-function-state-emission-point fn-state)]
    [occ : i64
      (if (be_state.compiler-backend-function-scratch-bool?
        fn-state
        be_state.compiler-backend-scratch-bool-pair-emission)
        (be_operand.compiler-backend-scavenge-occupied-mask-over-range
          fn-state
          point
          (+ point be_operand.compiler-backend-scavenge-staging-window))
        (be_operand.compiler-backend-scavenge-occupied-mask-at-point
          fn-state
          point))]
    [reserved : i64
      (be_state.compiler-backend-function-scratch-i64
        fn-state
        be_state.compiler-backend-scratch-i64-current-instr-reserved-mask)]
    [protect-mask : i64
      (be_operand.compiler-backend-scavenge-exclude-mask protect protect-n)]
    (bit-or occ (bit-or reserved protect-mask))))

;; Try to emit a canonical copy thunk call for `size` bytes (`size % 4 == 0`),
;; materializing `(src + src-disp, dst + dst-disp)` into a free volatile pair
;; and loading any spilled/remat operand directly into its canonical register.
;; Returns `(Ok "")` to decline (caller emits inline); non-empty `(Ok asm)` on
;; success; `(Err e)` on operand load failure.
(define (compiler-backend-try-emit-canonical-copy-thunk
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst-val : (& compiler_ir_types.CompilerIrValue)]
  [src-val : (& compiler_ir_types.CompilerIrValue)]
  [dst-base : (& str)]
  [src-base : (& str)]
  [src-disp : i64]
  [dst-disp : i64]
  [size : i64]
  [protect : (& (__tl_dyn-array String))]
  [protect-n : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (if (not (be_scalar.compiler-backend-copy-thunk-applies? size backend-state))
    (Ok "")
    (let
      [forbidden : i64
        (compiler-backend-copy-thunk-forbidden-mask
          protect
          protect-n
          backend-state)]
      [c-xmm : String (compiler-backend-copy-thunk-pick-xmm forbidden)]
      (if (string.eq c-xmm "")
        (Ok "")
        (let
          [size-count : i64
            (be_scalar.compiler-backend-copy-thunk-size-count
              backend-state
              size)]
          [opt-size? : bool
            (be_state.compiler-backend-state-optimize-for-size? backend-state)]
          [in-loop? : bool
            (let
              [fn-state : be_state.CompilerBackendFunctionState
                (be_state.compiler-backend-state-function-state backend-state)]
              [cur-label : i64
                (be_state.compiler-backend-function-state-i64
                  fn-state
                  be_state.compiler-backend-function-i64-current-block-label)]
              (be_state.compiler-backend-function-loop-block?
                fn-state
                cur-label))]
          [chosen-src : String ""]
          [chosen-dst : String ""]
          [chosen-dst-bias : i64 0]
          [chosen-swap? : bool false]
          [chosen-dst-first? : bool false]
          [chosen-cost : i64 99]
          [found? : bool false]
          ;; Fast path: zero-setup direct read-only pair for hot 48..112 B
          ;; shapes (neither base is written, so live-out / Win64 nonvolatile
          ;; registers are untouched and call-site setup is 0 instructions).
          (when
            (and
              (= src-disp 0)
              (= dst-disp 0)
              (string.eq (& c-xmm) "%xmm2")
              (compiler-backend-copy-thunk-direct-pair?
                src-base
                dst-base
                size
                size-count))
            (set! chosen-src (string.copy src-base))
            (set! chosen-dst (string.copy dst-base))
            (set! chosen-dst-bias 0)
            (set! chosen-cost 0)
            (set! found? true))
          ;; Fast path for top enum-payload (`dst-disp == 8`) read-only pairs.
          (when
            (and
              (not found?)
              (= src-disp 0)
              (= dst-disp 8)
              (string.eq (& c-xmm) "%xmm2")
              (compiler-backend-copy-thunk-direct-disp8-pair?
                src-base
                dst-base
                size
                size-count))
            (set! chosen-src (string.copy src-base))
            (set! chosen-dst (string.copy dst-base))
            (set! chosen-dst-bias 8)
            (set! chosen-cost 0)
            (set! found? true))
          (for [tier (iterator.range 0 3)]
            (when
              (> chosen-cost 0)
              (let
                [c-src : String (compiler-backend-copy-thunk-pair-src tier)]
                [c-dst : String (compiler-backend-copy-thunk-pair-dst tier)]
                ;; Tier 2 (%rcx,%rax) is only considered when dst is already
                ;; in %rax with displacement 0, avoiding a setup move.
                [tier-shape-ok? : bool
                  (if (< tier 2)
                    true
                    (and
                      (= dst-disp 0)
                      (string.eq dst-base "%rax")
                      (>= size 56)
                      (<= size 112)
                      (>= size-count 300)))]
                ;; A canonical register needs a write unless the corresponding
                ;; base is ALREADY that exact register with 0 displacement.
                ;; Every register written by setup MUST be dead after the copy
                ;; (0 in `forbidden`).
                [src-needs-write? : bool
                  (not (and (= src-disp 0) (string.eq src-base (& c-src))))]
                [dst-needs-write? : bool
                  (not (and (= dst-disp 0) (string.eq dst-base (& c-dst))))]
                [src-ok? : bool
                  (or
                    (not src-needs-write?)
                    (=
                      (bit-and
                        forbidden
                        (be_operand.compiler-backend-scavenge-reg-bit (& c-src)))
                      0))]
                [dst-ok? : bool
                  (or
                    (not dst-needs-write?)
                    (=
                      (bit-and
                        forbidden
                        (be_operand.compiler-backend-scavenge-reg-bit (& c-dst)))
                      0))]
                [src-uses-cdst? : bool
                  (and
                    (not (string.eq src-base ""))
                    (be_operand.compiler-backend-string-contains?
                      src-base
                      (& c-dst)))]
                [dst-uses-csrc? : bool
                  (and
                    (not (string.eq dst-base ""))
                    (be_operand.compiler-backend-string-contains?
                      dst-base
                      (& c-src)))]
                [exact-swap? : bool
                  (and
                    src-uses-cdst?
                    dst-uses-csrc?
                    (= src-disp 0)
                    (= dst-disp 0)
                    (string.eq src-base (& c-dst))
                    (string.eq dst-base (& c-src)))]
                [parallel-ok? : bool
                  (or (not (and src-uses-cdst? dst-uses-csrc?)) exact-swap?)]
                [primary? : bool (and (= tier 0) (string.eq (& c-xmm) "%xmm2"))]
                [setup-cost : i64
                  (if exact-swap?
                    1
                    (+
                      (if (or (string.eq src-base "") (not src-needs-write?))
                        0
                        1)
                      (if (or
                        (and (string.eq dst-base "") (= dst-disp 0))
                        (not dst-needs-write?))
                        0
                        1)))]
                ;; At -O2:
                ;; - Outside loops, >=56 B copies use canonical thunks; 48..52 B
                ;;   uses canonical thunks only when setup-cost == 0.
                ;; - Inside loops, <=104 B copies needing 2 setup moves stay
                ;;   inline to avoid per-iteration setup+call+ret overhead.
                [o2-cost-ok? : bool
                  (or
                    opt-size?
                    (if in-loop?
                      (not (and (= setup-cost 2) (<= size 104)))
                      (or (>= size 56) (= setup-cost 0))))]
                (when
                  (and
                    tier-shape-ok?
                    o2-cost-ok?
                    (< setup-cost chosen-cost)
                    src-ok?
                    dst-ok?
                    parallel-ok?
                    (or
                      primary?
                      (and
                        (>= size 48)
                        (let
                          [probe-key : String
                            (compiler-backend-copy-thunk-key
                              size
                              (& c-src)
                              (& c-dst)
                              0
                              (& c-xmm))]
                          (or
                            (be_scalar.compiler-backend-copy-thunk-registered?
                              (& probe-key)
                              backend-state)
                            (and
                              (= tier 1)
                              (string.eq (& c-xmm) "%xmm2")
                              (>= size-count 6))
                            (and
                              (= tier 2)
                              (string.eq (& c-xmm) "%xmm2")
                              (<= size 112)
                              (>= size-count 300))
                            (and
                              (>=
                                size
                                be_scalar.compiler-backend-copy-thunk-loop-min-bytes)
                              (>= size-count 32))))))
                    (compiler-backend-copy-thunk-small-profitable?
                      size
                      src-base
                      src-disp
                      dst-base
                      dst-disp
                      (& c-src)
                      (& c-dst)))
                  (set! chosen-src c-src)
                  (set! chosen-dst c-dst)
                  (set! chosen-dst-bias 0)
                  (set! chosen-swap? exact-swap?)
                  (set!
                    chosen-dst-first?
                    (and dst-uses-csrc? (not exact-swap?)))
                  (set! chosen-cost setup-cost)
                  (set! found? true)))))
          (if (not found?)
            (Ok "")
            (let
              ;; Step 1: parallel register/SIB setup for any register-homed
              ;; operands (runs BEFORE loading spilled/remat operands so
              ;; direct loads into `chosen-src`/`chosen-dst` never clobber a
              ;; register still waiting to be read).
              [reg-setup : String
                (if chosen-swap?
                  (str_cat.str-cat
                    "    xchgq "
                    (string.copy (& chosen-src))
                    ", "
                    (string.copy (& chosen-dst))
                    "\n")
                  (let
                    [src-setup : String
                      (compiler-backend-copy-thunk-setup-one-asm
                        src-base
                        src-disp
                        (& chosen-src))]
                    [dst-setup : String
                      (compiler-backend-copy-thunk-setup-one-asm
                        dst-base
                        (- dst-disp chosen-dst-bias)
                        (& chosen-dst))]
                    (if chosen-dst-first?
                      (str_cat.str-cat dst-setup src-setup)
                      (str_cat.str-cat src-setup dst-setup))))]
              ;; Step 2: load any spilled/remat operand directly into its
              ;; canonical register (reading no GP register).
              [dst-load-asm : String
                (try
                  (if (string.eq dst-base "")
                    (match (be_operand.compiler-backend-emit-load-value
                      assignments
                      dst-val
                      (string.copy (& chosen-dst))
                      backend-state)
                      [(Ok load-asm)
                        (if (= dst-disp 0)
                          (be_state.ResultCompilerBackend.Ok load-asm)
                          (be_state.ResultCompilerBackend.Ok
                            (str_cat.str-cat
                              load-asm
                              "    leaq "
                              (string.int->string dst-disp)
                              "("
                              (string.copy (& chosen-dst))
                              "), "
                              (string.copy (& chosen-dst))
                              "\n")))]
                      [(Err message)
                        (be_state.ResultCompilerBackend.Err message)])
                    (be_state.ResultCompilerBackend.Ok "")))]
              [src-load-asm : String
                (try
                  (if (string.eq src-base "")
                    (be_operand.compiler-backend-emit-load-value
                      assignments
                      src-val
                      (string.copy (& chosen-src))
                      backend-state)
                    (be_state.ResultCompilerBackend.Ok "")))]
              [call-asm : String
                (in-arena
                  (compiler-backend-copy-thunk-arena-ensure! backend-state)
                  (let
                    [key : String
                      (compiler-backend-copy-thunk-key
                        size
                        (& chosen-src)
                        (& chosen-dst)
                        chosen-dst-bias
                        (& c-xmm))]
                    [body : String
                      (if (be_scalar.compiler-backend-copy-thunk-registered?
                        (& key)
                        backend-state)
                        ""
                        (be_scalar.compiler-backend-emit-copy-bytes-chunks-canonical
                          (& chosen-dst)
                          (& chosen-src)
                          (& c-xmm)
                          0
                          size
                          chosen-dst-bias))]
                    (str_cat.str-cat
                      "    call "
                      (be_scalar.compiler-backend-copy-thunk-register
                        key
                        body
                        backend-state)
                      "\n")))]
              (Ok
                (str_cat.str-cat reg-setup dst-load-asm src-load-asm call-asm)))))))))

(define (compiler-backend-emit-copy-bytes-avoid
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : compiler_ir_types.CompilerIrValue]
  [src : compiler_ir_types.CompilerIrValue]
  [size : i64]
  [protect : (__tl_dyn-array String)]
  [protect-n : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (if (<= size 0)
    (Ok "")
    (let
      ;; GAP7: both homes serve as CONST-offset memory-operand bases in the chunk
      ;; copies -- a %rbp value has a spaced base operand.
      [dst-home : String
        (be_facts.compiler-backend-address-base-filter-direct
          (be_facts.compiler-backend-value-register-home
            backend-state
            assignments
            dst))]
      [src-home : String
        (be_facts.compiler-backend-address-base-filter-direct
          (be_facts.compiler-backend-value-register-home
            backend-state
            assignments
            src))]
      [thunk-asm : String
        (try
          (compiler-backend-try-emit-canonical-copy-thunk
            assignments
            (& dst)
            (& src)
            (& dst-home)
            (& src-home)
            0
            0
            size
            (& protect)
            protect-n
            backend-state))]
      (if (not (string.eq (& thunk-asm) ""))
        (Ok thunk-asm)
        (let
          [dst-reg : String
            (if (string.eq dst-home "")
              (be_operand.compiler-backend-scavenge-reg-here
                (be_state.compiler-backend-global-shared-view protect)
                protect-n
                "%r10"
                backend-state)
              (owned_view.compiler-owned-shared-view dst-home))]
          [dst-asm
            (try
              (if (string.eq dst-home "")
                (be_operand.compiler-backend-emit-load-value
                  assignments
                  dst
                  (be_state.compiler-backend-global-shared-view dst-reg)
                  backend-state)
                (be_state.ResultCompilerBackend.Ok "")))]
          [src-exclude-base : (__tl_dyn-array String)
            (be_operand.compiler-backend-one-exclude
              (be_state.compiler-backend-global-shared-view dst-reg))]
          [src-exclude : (__tl_dyn-array String)
            (be_scalar.compiler-backend-scavenge-exclude-merge
              src-exclude-base
              1
              protect
              protect-n)]
          [src-reg : String
            (if (string.eq src-home "")
              (be_operand.compiler-backend-scavenge-reg-here
                src-exclude
                (+ 1 protect-n)
                "%r9"
                backend-state)
              (owned_view.compiler-owned-shared-view src-home))]
          [copy-xmm : String
            (compiler-backend-copy-xmm-scratch size backend-state)]
          [copy-gp-exclude-base : (__tl_dyn-array String)
            (be_operand.compiler-backend-two-exclude
              (be_state.compiler-backend-global-shared-view dst-reg)
              (be_state.compiler-backend-global-shared-view src-reg))]
          [copy-gp-exclude : (__tl_dyn-array String)
            (be_scalar.compiler-backend-scavenge-exclude-merge
              copy-gp-exclude-base
              2
              protect
              protect-n)]
          [copy-gp : String
            (if (compiler-backend-copy-needs-gp-scratch? size copy-xmm)
              (be_operand.compiler-backend-scavenge-reg-here
                copy-gp-exclude
                (+ 2 protect-n)
                "%r8"
                backend-state)
              "")]
          [src-asm
            (try
              (if (string.eq src-home "")
                (be_operand.compiler-backend-emit-load-value
                  assignments
                  src
                  (be_state.compiler-backend-global-shared-view src-reg)
                  backend-state)
                (be_state.ResultCompilerBackend.Ok "")))]
          (Ok
            (str_cat.str-cat
              dst-asm
              src-asm
              (be_scalar.compiler-backend-emit-copy-bytes-chunks-inline
                type-segment-bases
                dst-reg
                src-reg
                copy-gp
                copy-xmm
                0
                size
                0))))))))

(define (compiler-backend-emit-copy-bytes
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : compiler_ir_types.CompilerIrValue]
  [src : compiler_ir_types.CompilerIrValue]
  [size : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [no-protect : (__tl_dyn-array String) (__tl_make-array String 0)]
    (compiler-backend-emit-copy-bytes-avoid
      type-segment-bases
      assignments
      dst
      src
      size
      no-protect
      0
      backend-state)))

;; GAP2a (M-C2/B2 for the aggregate/group copy path): fused Gep+CopyBytes.
;; CopyBytes writes only MEMORY (it defines no register), so reading the
;; base/src/index HOMES directly is unconditionally safe, with no staging pair
;; through a scavenged scratch (`movq %rHOME, %rSCAV; movups (%rSCAV), ...`).
;; #rbp-base homes are filtered to the staged path (frame-spelling invariant);
;; spilled/remat/non-var operands load into scavenged scratches.
(define (compiler-backend-emit-copy-bytes-from-gep-avoid
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [src : compiler_ir_types.CompilerIrValue]
  [size : i64]
  [protect : (__tl_dyn-array String)]
  [protect-n : i64]
  [gep-disp : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (if (<= size 0)
    (Ok "")
    (match (be_operand.compiler-backend-value-as-i64 offset)
      [(Some n)
        (compiler-backend-emit-copy-bytes-from-gep-const
          type-segment-bases
          assignments
          base
          src
          size
          ;; gep-disp is 0 here in practice (only Var-index geps carry a
          ;; folded displacement); merged for totality.
          (+
            (*
              n
              (be_operand.compiler-backend-type-size type-segment-bases elem-ty))
            gep-disp)
          protect
          protect-n
          backend-state)]
      [(None)
        (compiler-backend-emit-copy-bytes-from-gep-dyn
          type-segment-bases
          assignments
          base
          offset
          elem-ty
          src
          size
          protect
          protect-n
          gep-disp
          backend-state)])))

;; Constant-offset fused Gep+CopyBytes. When every chunk address (disp ..
;; disp+size) fits imm32 the gep displacement folds into the chunk DST
;; addresses (dst-bias), so a register-homed base is addressed directly (no
;; staging copy, no addq fold, no scavenge pick) and even a scavenge-loaded
;; base skips the addq. The source pointer home is likewise the chunk load
;; base directly. Out-of-imm32 displacements keep the staged addq fold.
(define (compiler-backend-emit-copy-bytes-from-gep-const
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [src : compiler_ir_types.CompilerIrValue]
  [size : i64]
  [disp : i64]
  [protect : (__tl_dyn-array String)]
  [protect-n : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [near? : bool
      (and
        (be_operand.compiler-backend-imm32? disp)
        (be_operand.compiler-backend-imm32? (+ disp size)))]
    [base-home : String
      (if near?
        (be_facts.compiler-backend-address-base-filter-direct
          (be_operand.compiler-backend-value-scalar-register
            backend-state
            assignments
            base))
        "")]
    [src-home : String
      (be_facts.compiler-backend-address-base-filter-direct
        (be_operand.compiler-backend-value-scalar-register
          backend-state
          assignments
          src))]
    [thunk-asm : String
      (try
        (if near?
          (compiler-backend-try-emit-canonical-copy-thunk
            assignments
            (& base)
            (& src)
            (& base-home)
            (& src-home)
            0
            disp
            size
            (& protect)
            protect-n
            backend-state)
          (be_state.ResultCompilerBackend.Ok "")))]
    (if (not (string.eq (& thunk-asm) ""))
      (Ok thunk-asm)
      (let
        [dst-reg : String
          (if (string.eq base-home "")
            (be_operand.compiler-backend-scavenge-reg-here
              (be_scalar.compiler-backend-scavenge-exclude-merge
                (be_operand.compiler-backend-one-exclude
                  (be_state.compiler-backend-global-shared-view src-home))
                1
                protect
                protect-n)
              (+ 1 protect-n)
              "%r10"
              backend-state)
            (owned_view.compiler-owned-shared-view base-home))]
        [dst-asm
          (try
            (if (string.eq base-home "")
              (match (be_operand.compiler-backend-emit-load-value
                assignments
                base
                (be_state.compiler-backend-global-shared-view dst-reg)
                backend-state)
                [(Ok load-asm)
                  (if near?
                    (be_state.ResultCompilerBackend.Ok load-asm)
                    (match (be_scalar.compiler-backend-gep-immediate-base-asm
                      dst-reg
                      disp)
                      [(Some fold-asm)
                        (be_state.ResultCompilerBackend.Ok
                          (str_cat.str-cat load-asm fold-asm))]
                      [(No)
                        (be_state.ResultCompilerBackend.Err
                          (box
                            (compiler_diagnostic.compiler-diagnostic-at-start
                              ""
                              "backend: fused gep copy displacement out of range")))]))]
                [(Err message) (be_state.ResultCompilerBackend.Err message)])
              (be_state.ResultCompilerBackend.Ok "")))]
        [src-reg : String
          (if (string.eq src-home "")
            (be_operand.compiler-backend-scavenge-reg-here
              (be_scalar.compiler-backend-scavenge-exclude-merge
                (be_operand.compiler-backend-one-exclude
                  (be_state.compiler-backend-global-shared-view dst-reg))
                1
                protect
                protect-n)
              (+ 1 protect-n)
              "%r9"
              backend-state)
            (owned_view.compiler-owned-shared-view src-home))]
        [copy-xmm : String
          (compiler-backend-copy-xmm-scratch size backend-state)]
        [copy-gp : String
          (if (compiler-backend-copy-needs-gp-scratch? size copy-xmm)
            (be_operand.compiler-backend-scavenge-reg-here
              (be_scalar.compiler-backend-scavenge-exclude-merge
                (be_operand.compiler-backend-two-exclude
                  (be_state.compiler-backend-global-shared-view dst-reg)
                  (be_state.compiler-backend-global-shared-view src-reg))
                2
                protect
                protect-n)
              (+ 2 protect-n)
              "%r8"
              backend-state)
            "")]
        [src-asm
          (try
            (if (string.eq src-home "")
              (be_operand.compiler-backend-emit-load-value
                assignments
                src
                (be_state.compiler-backend-global-shared-view src-reg)
                backend-state)
              (be_state.ResultCompilerBackend.Ok "")))]
        (Ok
          (str_cat.str-cat
            dst-asm
            (str_cat.str-cat
              src-asm
              (be_scalar.compiler-backend-emit-copy-bytes-chunks-inline
                type-segment-bases
                dst-reg
                src-reg
                copy-gp
                copy-xmm
                0
                size
                (if near?
                  disp
                  0)))))))))

;; Dynamic-index fused Gep+CopyBytes. The element address still composes into
;; a scavenged scratch (the chunk copies need one persistent base register),
;; but register-homed operands feed it directly: base+index homes with a SIB
;; scale compose in ONE leaq off the homes; a register-homed index folds
;; without an index scratch (SIB folds only READ the index register -- the
;; non-SIB imulq form MUTATES it and keeps the staged index); and the source
;; pointer home is the chunk load base directly.
(define (compiler-backend-emit-copy-bytes-from-gep-dyn
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [src : compiler_ir_types.CompilerIrValue]
  [size : i64]
  [protect : (__tl_dyn-array String)]
  [protect-n : i64]
  [gep-disp : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [scale : i64
      (be_operand.compiler-backend-type-size type-segment-bases elem-ty)]
    [base-home : String
      (be_scalar.compiler-backend-address-base-filter
        (be_operand.compiler-backend-value-scalar-register
          backend-state
          assignments
          base))]
    [offset-home : String
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        offset)]
    [src-home : String
      (be_scalar.compiler-backend-address-base-filter
        (be_operand.compiler-backend-value-scalar-register
          backend-state
          assignments
          src))]
    ;; When base and index are register-homed under a SIB scale the element
    ;; address does not need to exist: every chunk STORE spells
    ;; `disp(base,index,scale)` directly and the composing `leaq` disappears.
    ;; This is the destination-side twin of
    ;; `compiler-backend-emit-copy-bytes-gep-src`; the same register argument
    ;; applies (the chunks write only the scratch and the destination MEMORY, so
    ;; both operand homes stay valid across the whole run).
    [dst-spelling : String
      (be_scalar.compiler-backend-copy-gep-element-spelling
        backend-state
        type-segment-bases
        assignments
        (be_state.compiler-backend-global-shared-view base)
        (be_state.compiler-backend-global-shared-view offset)
        elem-ty
        size)]
    (if (not (string.eq dst-spelling ""))
      (compiler-backend-emit-copy-bytes-gep-dst
        type-segment-bases
        assignments
        src
        base
        offset
        dst-spelling
        gep-disp
        size
        protect
        protect-n
        backend-state)
      ;; M-D: `scav-base` is bound INSIDE the declining branch. Scavenging is
      ;; not a query -- under full occupancy it emergency-adds the picked
      ;; register to the global pending set -- so a pick made for a path that is
      ;; not taken leaks a stray restore into the surrounding emission.
      (let
        [scav-base : String
          (be_operand.compiler-backend-scavenge-reg-here
            (be_scalar.compiler-backend-scavenge-exclude-merge
              (be_operand.compiler-backend-two-exclude
                (be_state.compiler-backend-global-shared-view src-home)
                (be_state.compiler-backend-global-shared-view offset-home))
              2
              protect
              protect-n)
            (+ 2 protect-n)
            "%r10"
            backend-state)]
        [addr-asm
          (try
            (be_scalar.compiler-backend-emit-copy-gep-dyn-address
              assignments
              base
              offset
              scale
              (be_state.compiler-backend-global-shared-view scav-base)
              base-home
              offset-home
              (be_state.compiler-backend-global-shared-view src-home)
              protect
              protect-n
              gep-disp
              backend-state))]
        [thunk-asm : String
          (try
            (compiler-backend-try-emit-canonical-copy-thunk
              assignments
              (& src)
              (& src)
              (& scav-base)
              (& src-home)
              0
              0
              size
              (& protect)
              protect-n
              backend-state))]
        (if (not (string.eq (& thunk-asm) ""))
          (Ok (str_cat.str-cat addr-asm thunk-asm))
          (let
            [src-reg : String
              (if (string.eq src-home "")
                (be_operand.compiler-backend-scavenge-reg-here
                  (be_scalar.compiler-backend-scavenge-exclude-merge
                    (be_operand.compiler-backend-one-exclude
                      (be_state.compiler-backend-global-shared-view scav-base))
                    1
                    protect
                    protect-n)
                  (+ 1 protect-n)
                  "%r9"
                  backend-state)
                (owned_view.compiler-owned-shared-view src-home))]
            [copy-xmm : String
              (compiler-backend-copy-xmm-scratch size backend-state)]
            [copy-gp : String
              (if (compiler-backend-copy-needs-gp-scratch? size copy-xmm)
                (be_operand.compiler-backend-scavenge-reg-here
                  (be_scalar.compiler-backend-scavenge-exclude-merge
                    (be_operand.compiler-backend-two-exclude
                      (be_state.compiler-backend-global-shared-view scav-base)
                      (be_state.compiler-backend-global-shared-view src-reg))
                    2
                    protect
                    protect-n)
                  (+ 2 protect-n)
                  "%r8"
                  backend-state)
                "")]
            [src-asm
              (try
                (if (string.eq src-home "")
                  (be_operand.compiler-backend-emit-load-value
                    assignments
                    src
                    (be_state.compiler-backend-global-shared-view src-reg)
                    backend-state)
                  (be_state.ResultCompilerBackend.Ok "")))]
            (Ok
              (str_cat.str-cat
                addr-asm
                (str_cat.str-cat
                  src-asm
                  (be_scalar.compiler-backend-emit-copy-bytes-chunks-inline
                    type-segment-bases
                    scav-base
                    src-reg
                    copy-gp
                    copy-xmm
                    0
                    size
                    0))))))))))

;; The constant part of a gep element's byte displacement (0 for a dynamic
;; index). Callers add the GAP9 fold on top; for a constant offset that fold is
;; structurally 0.
(define (compiler-backend-gep-const-element-disp
  [type-segment-bases : i64]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]) : i64
  (match (be_operand.compiler-backend-value-as-i64 offset)
    [(Some n)
      (* n (be_operand.compiler-backend-type-size type-segment-bases elem-ty))]
    [(None) 0]))

;; Emit the fused copy. `src-spelling` is the non-empty result of
;; `-src-base-spelling`; `src-disp` its starting displacement. Chunk source
;; addresses run from `src-disp`, so the destination bias cancels it back to 0.
(define (compiler-backend-emit-copy-bytes-gep-src
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : compiler_ir_types.CompilerIrValue]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [src-spelling : String]
  [src-disp : i64]
  [size : i64]
  [protect : (__tl_dyn-array String)]
  [protect-n : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    ;; The two registers the fused source operand READS. Excluded from every
    ;; scavenge below so no staged destination load can overwrite the address
    ;; the chunk copies are still reading from.
    [operand-a : String
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        base)]
    [operand-b : String
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        offset)]
    [dst-home : String
      (be_facts.compiler-backend-address-base-filter-direct
        (be_facts.compiler-backend-value-register-home
          backend-state
          assignments
          dst))]
    [thunk-asm : String
      (try
        (compiler-backend-try-emit-canonical-copy-thunk
          assignments
          (& dst)
          (& dst)
          (& dst-home)
          (& src-spelling)
          src-disp
          0
          size
          (& protect)
          protect-n
          backend-state))]
    (if (not (string.eq (& thunk-asm) ""))
      (Ok thunk-asm)
      (let
        [dst-reg : String
          (if (string.eq dst-home "")
            (be_operand.compiler-backend-scavenge-reg-here
              (be_scalar.compiler-backend-scavenge-exclude-merge
                (be_operand.compiler-backend-two-exclude
                  (be_state.compiler-backend-global-shared-view operand-a)
                  (be_state.compiler-backend-global-shared-view operand-b))
                2
                protect
                protect-n)
              (+ 2 protect-n)
              "%r10"
              backend-state)
            (owned_view.compiler-owned-shared-view dst-home))]
        [dst-asm
          (try
            (if (string.eq dst-home "")
              (be_operand.compiler-backend-emit-load-value
                assignments
                dst
                (be_state.compiler-backend-global-shared-view dst-reg)
                backend-state)
              (be_state.ResultCompilerBackend.Ok "")))]
        [copy-xmm : String
          (compiler-backend-copy-xmm-scratch size backend-state)]
        [copy-gp : String
          (if (compiler-backend-copy-needs-gp-scratch? size copy-xmm)
            (be_operand.compiler-backend-scavenge-reg-here
              (be_scalar.compiler-backend-scavenge-exclude-merge
                (be_operand.compiler-backend-three-exclude
                  (be_state.compiler-backend-global-shared-view dst-reg)
                  operand-a
                  operand-b)
                3
                protect
                protect-n)
              (+ 3 protect-n)
              "%r8"
              backend-state)
            "")]
        (Ok
          (str_cat.str-cat
            dst-asm
            (be_scalar.compiler-backend-emit-copy-bytes-chunks-inline
              type-segment-bases
              dst-reg
              src-spelling
              copy-gp
              copy-xmm
              src-disp
              size
              (- 0 src-disp))))))))

;; Destination-side twin of the emitter above: the gep element is the copy
;; DESTINATION, so `dst-spelling` addresses the chunk STORES and the source
;; pointer keeps its ordinary register. Chunk destination addresses run from
;; `dst-disp` (the GAP9 fold) via the bias; source addresses start at 0.
(define (compiler-backend-emit-copy-bytes-gep-dst
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [src : compiler_ir_types.CompilerIrValue]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [dst-spelling : String]
  [dst-disp : i64]
  [size : i64]
  [protect : (__tl_dyn-array String)]
  [protect-n : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    ;; The two registers the fused destination operand READS; excluded from
    ;; every scavenge so a staged source load cannot overwrite the address the
    ;; chunk stores are still writing through.
    [operand-a : String
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        base)]
    [operand-b : String
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        offset)]
    [src-home : String
      (be_facts.compiler-backend-address-base-filter-direct
        (be_operand.compiler-backend-value-scalar-register
          backend-state
          assignments
          src))]
    [thunk-asm : String
      (try
        (compiler-backend-try-emit-canonical-copy-thunk
          assignments
          (& src)
          (& src)
          (& dst-spelling)
          (& src-home)
          0
          dst-disp
          size
          (& protect)
          protect-n
          backend-state))]
    (if (not (string.eq (& thunk-asm) ""))
      (Ok thunk-asm)
      (let
        [src-reg : String
          (if (string.eq src-home "")
            (be_operand.compiler-backend-scavenge-reg-here
              (be_scalar.compiler-backend-scavenge-exclude-merge
                (be_operand.compiler-backend-two-exclude
                  (be_state.compiler-backend-global-shared-view operand-a)
                  (be_state.compiler-backend-global-shared-view operand-b))
                2
                protect
                protect-n)
              (+ 2 protect-n)
              "%r9"
              backend-state)
            (owned_view.compiler-owned-shared-view src-home))]
        [src-asm
          (try
            (if (string.eq src-home "")
              (be_operand.compiler-backend-emit-load-value
                assignments
                src
                (be_state.compiler-backend-global-shared-view src-reg)
                backend-state)
              (be_state.ResultCompilerBackend.Ok "")))]
        [copy-xmm : String
          (compiler-backend-copy-xmm-scratch size backend-state)]
        [copy-gp : String
          (if (compiler-backend-copy-needs-gp-scratch? size copy-xmm)
            (be_operand.compiler-backend-scavenge-reg-here
              (be_scalar.compiler-backend-scavenge-exclude-merge
                (be_operand.compiler-backend-three-exclude
                  (be_state.compiler-backend-global-shared-view src-reg)
                  operand-a
                  operand-b)
                3
                protect
                protect-n)
              (+ 3 protect-n)
              "%r8"
              backend-state)
            "")]
        (Ok
          (str_cat.str-cat
            src-asm
            (be_scalar.compiler-backend-emit-copy-bytes-chunks-inline
              type-segment-bases
              dst-spelling
              src-reg
              copy-gp
              copy-xmm
              0
              size
              dst-disp)))))))

(define (compiler-backend-var-value-seq [count : i64] [idx : i64]) : compiler_ir_types.CompilerIrValueSeq
  (let
    [remaining : i64
      (if (< idx count)
        (- count idx)
        0)]
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrValue)
      (__tl_make-array compiler_ir_types.CompilerIrValue remaining)]
    (for [offset (iterator.range 0 remaining)]
      (set!
        (array-ref slots offset)
        (compiler_ir_types.CompilerIrValue.Var (+ idx offset))))
    (compiler_ir_types.CompilerIrValueSeq slots remaining)))

(define (compiler-backend-remap-group-vars
  [groups : compiler_liveness.CompilerLiveI64Set]
  [remap : (__tl_dyn-array i64)]) : compiler_liveness.CompilerLiveI64Set
  (let
    [out : compiler_liveness.CompilerLiveI64Set
      (compiler_liveness.compiler-live-set-empty)]
    (for [index (iterator.range 0 (array-length remap))]
      (if (compiler_liveness.compiler-live-set-contains? groups index)
        (let
          [mapped : i64
            (compiler_regalloc.compiler-reg-remap-id (& remap) index)]
          (if (>= mapped 0)
            (set! out (compiler_liveness.compiler-live-set-insert out mapped))
            unit))
        unit))
    out))

(define (compiler-backend-closure-call-arg-space
  [target : be_state.CompilerBackendTarget]
  [_args : (& _args compiler_ir_types.CompilerIrCallArgs)]
  [_types : (& _types compiler_ast_types.AstTypeList)]
  [_program-index : be_state.CompilerBackendProgramIndex]) : i64
  (be_operand.compiler-backend-call-arg-space-from target))

(define (compiler-backend-call-leading-arg-uses-var?
  [args : compiler_ir_types.CompilerIrCallArgs]
  [var : i64]) : bool
  ;; Keep call-result forwarding to the first user argument. Earlier argument
  ;; setup can use %rax as scratch for aggregate/memory copies.
  (if (>
    (be_facts.compiler-backend-call-args-count
      (be_state.compiler-backend-global-shared-view args))
    0)
    (be_operand.compiler-backend-branch-uses-var?
      (& (be_facts.compiler-backend-call-arg-at args 0))
      var)
    false))

(define (compiler-backend-rax-call-arg-eligible?
  [type-segment-bases : i64]
  [program-index : be_state.CompilerBackendProgramIndex]
  [ty : compiler_ast_types.AstType]) : bool
  (and
    (= (be_operand.compiler-backend-type-size type-segment-bases ty) 8)
    (not (be_operand.compiler-backend-float-type? ty))
    (not
      (be_facts.compiler-backend-group-type?
        type-segment-bases
        program-index
        ty))))

(define (compiler-backend-emit-xgetbv
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [index : compiler_ir_types.CompilerIrValue]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [index-asm
      (try
        (be_operand.compiler-backend-emit-load-value
          assignments
          index
          "%rcx"
          backend-state))]
    (Ok
      (str_cat.str-cat
        index-asm
        "    xgetbv\n    shlq $32, %rdx\n    orq %rdx, %rax\n"
        (be_operand.compiler-backend-emit-store-typed-var
          assignments
          dst
          "%rax"
          (I64)
          backend-state)))))

;; Every instruction emitted through here guards its shift against its OWN
;; count's bound, whichever instruction's step it runs inside; the step's bound
;; is restored afterwards for the rest of the step.
(define (compiler-backend-emit-instr
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]) : be_state.ResultCompilerBackend
  (let
    [saved : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-shift-count-bound)]
    [_own : unit
      (compiler-backend-set-shift-count-bound!
        ctx.function-state
        (be_scalar.compiler-backend-instr-shift-count-bound
          ctx.function-state
          (& (be_state.compiler-backend-global-shared-view instr))))]
    [result : be_state.ResultCompilerBackend
      (compiler-backend-emit-instr-with-bound
        (be_state.compiler-backend-global-shared-view ctx)
        fallthrough
        instr)]
    (compiler-backend-set-shift-count-bound! ctx.function-state saved)
    result))

(define (compiler-backend-emit-instr-with-bound
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]) : be_state.ResultCompilerBackend
  (let
    [instr-diag : compiler_diagnostic.CompilerDiagnostic
      (be_state.compiler-backend-instr-diagnostic
        ctx.spans
        ctx.source-function
        (be_state.compiler-backend-global-shared-view instr)
        ctx.func-diag)]
    [_abort-site : unit
      (be_scalar.compiler-backend-runtime-abort-site-install!
        (be_state.compiler-backend-global-shared-view ctx)
        (be_state.compiler-backend-global-shared-view instr))]
    ;; Sound-scavenger: reserve this instruction's operand + result homes so the
    ;; scavenge can never hand one back as scratch (LLVM RegScavenger model).
    [_reserved-mask : i64
      (begin
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          (compiler-backend-instr-reserved-home-mask
            ctx.function-state
            (be_state.compiler-backend-global-shared-view instr)))
        (compiler-backend-current-instr-reserved-mask ctx.function-state))]
    (match instr
      [(Mov dst src ty)
        (compiler-backend-with-instr-diagnostic
          (be_calls.compiler-backend-emit-class-correct-mov
            ctx.type-segment-bases
            ctx.assignments
            ctx.blocks
            dst
            src
            ty
            ctx.program-index
            ctx.vars
            ctx.backend-state)
          instr-diag)]
      [(or (Alloc _ _) (Phi _ _ _)) (Ok "")]
      [(AddrOf dst src storage-words)
        (compiler-backend-with-instr-diagnostic
          (compiler-backend-emit-addr-of
            ctx.assignments
            dst
            src
            storage-words
            ctx.backend-state)
          instr-diag)]
      [(Gep dst base offset elem-ty)
        (compiler-backend-with-instr-diagnostic
          (be_scalar.compiler-backend-emit-gep
            ctx.type-segment-bases
            ctx.assignments
            dst
            base
            (be_state.compiler-backend-global-shared-view offset)
            (be_state.compiler-backend-global-shared-view elem-ty)
            (compiler-backend-gep-fold-next!
              ctx.function-state
              ctx.type-segment-bases
              offset
              elem-ty)
            ctx.backend-state)
          instr-diag)]
      [(Load dst src ty)
        (compiler-backend-with-instr-diagnostic
          (be_scalar.compiler-backend-emit-load-instr
            ctx.type-segment-bases
            ctx.assignments
            dst
            src
            ty
            ctx.backend-state)
          instr-diag)]
      [(or (StorePtr dst src ty) (StoreOwned dst src ty))
        (compiler-backend-with-instr-diagnostic
          (be_scalar.compiler-backend-emit-store-ptr
            ctx.type-segment-bases
            ctx.assignments
            dst
            src
            ty
            ctx.program-index
            ctx.backend-state)
          instr-diag)]
      [(CopyBytes dst src size)
        (compiler-backend-with-instr-diagnostic
          (compiler-backend-emit-copy-bytes
            ctx.type-segment-bases
            ctx.assignments
            dst
            src
            size
            ctx.backend-state)
          instr-diag)]
      [(BoundsCheck index length ok-label)
        (compiler-backend-with-instr-diagnostic
          (be_scalar.compiler-backend-emit-bounds-check
            ctx.target-policy.target
            ctx.function
            ctx.assignments
            index
            length
            ok-label
            ctx.plan
            ctx.functions
            ctx.externs
            ctx.program-index)
          instr-diag)]
      [(Cast dst src from-ty to-ty)
        (compiler-backend-with-instr-diagnostic
          (be_scalar.compiler-backend-emit-cast
            ctx.type-segment-bases
            ctx.function
            ctx.current-label
            ctx.assignments
            dst
            src
            from-ty
            to-ty
            ctx.program-index
            ctx.backend-state)
          instr-diag)]
      [(Bitcast dst src from-ty to-ty)
        (compiler-backend-with-instr-diagnostic
          (be_scalar.compiler-backend-emit-bitcast
            ctx.type-segment-bases
            ctx.assignments
            dst
            src
            from-ty
            to-ty
            ctx.program-index
            ctx.backend-state)
          instr-diag)]
      [(BinOp dst op lhs rhs ty)
        (compiler-backend-with-instr-diagnostic
          (be_scalar.compiler-backend-emit-binop
            ctx.type-segment-bases
            ctx.types
            ctx.global-types
            ctx.assignments
            dst
            op
            lhs
            rhs
            ty
            ctx.backend-state)
          instr-diag)]
      [(UnOp dst op src ty)
        (compiler-backend-with-instr-diagnostic
          (be_scalar.compiler-backend-emit-unop
            ctx.type-segment-bases
            ctx.assignments
            dst
            op
            src
            ty
            ctx.backend-state)
          instr-diag)]
      [(LaneId dst lanes elem-ty)
        (be_simd.compiler-backend-emit-vector-lane-id
          ctx.type-segment-bases
          ctx.function
          ctx.current-label
          ctx.assignments
          dst
          lanes
          elem-ty
          instr-diag
          ctx.backend-state)]
      [(Splat dst value lanes elem-ty)
        (be_simd.compiler-backend-emit-vector-splat
          (be_operand.compiler-backend-vector-mode elem-ty lanes)
          ctx.type-segment-bases
          ctx.assignments
          dst
          value
          lanes
          elem-ty
          instr-diag
          ctx.backend-state)]
      [(VectorBinOp payload-box)
        (let
          [dst (deref payload-box).dst]
          [op (be_state.compiler-backend-box-field-shared-view payload-box op)]
          [lhs
            (be_state.compiler-backend-box-field-shared-view payload-box lhs)]
          [rhs
            (be_state.compiler-backend-box-field-shared-view payload-box rhs)]
          [lanes (deref payload-box).lanes]
          [elem-ty
            (be_state.compiler-backend-box-field-shared-view payload-box ty)]
          (be_simd.compiler-backend-emit-vector-binop
            (be_operand.compiler-backend-vector-mode elem-ty lanes)
            ctx.type-segment-bases
            ctx.assignments
            dst
            op
            lhs
            rhs
            lanes
            elem-ty
            instr-diag
            ctx.backend-state))]
      [(VectorPrefix payload-box)
        (let
          [dst (deref payload-box).dst]
          [op (deref payload-box).op]
          [src
            (be_state.compiler-backend-box-field-shared-view payload-box src)]
          [carry
            (be_state.compiler-backend-box-field-shared-view payload-box carry)]
          [lanes (deref payload-box).lanes]
          [elem-ty
            (be_state.compiler-backend-box-field-shared-view payload-box ty)]
          (be_simd.compiler-backend-emit-vector-prefix
            ctx.assignments
            dst
            op
            src
            carry
            lanes
            elem-ty
            instr-diag
            ctx.backend-state))]
      [(VectorReduce dst op src lanes elem-ty)
        (compiler-backend-emit-vector-reduce
          ctx.type-segment-bases
          ctx.assignments
          dst
          op
          src
          lanes
          elem-ty
          instr-diag
          ctx.backend-state)]
      [(VectorCompare payload-box)
        (let
          [dst (deref payload-box).dst]
          [op (be_state.compiler-backend-box-field-shared-view payload-box op)]
          [lhs
            (be_state.compiler-backend-box-field-shared-view payload-box lhs)]
          [rhs
            (be_state.compiler-backend-box-field-shared-view payload-box rhs)]
          [lanes (deref payload-box).lanes]
          [elem-ty
            (be_state.compiler-backend-box-field-shared-view payload-box ty)]
          (be_simd.compiler-backend-emit-vector-compare
            ctx.type-segment-bases
            ctx.assignments
            dst
            op
            lhs
            rhs
            lanes
            elem-ty
            instr-diag
            ctx.backend-state))]
      [(MaskBinOp dst op lhs rhs lanes)
        (be_simd.compiler-backend-emit-mask-binop
          ctx.type-segment-bases
          ctx.assignments
          dst
          op
          lhs
          rhs
          lanes
          instr-diag
          ctx.backend-state)]
      [(MaskNot dst src lanes)
        (be_simd.compiler-backend-emit-mask-not
          ctx.type-segment-bases
          ctx.assignments
          dst
          src
          lanes
          instr-diag
          ctx.backend-state)]
      [(MaskReduce dst op src lanes)
        (be_simd.compiler-backend-emit-mask-reduce
          ctx.type-segment-bases
          ctx.assignments
          dst
          op
          src
          lanes
          instr-diag
          ctx.backend-state)]
      [(Select payload-box)
        (let
          [dst (deref payload-box).dst]
          [mask
            (be_state.compiler-backend-box-field-shared-view payload-box mask)]
          [on-true
            (be_state.compiler-backend-box-field-shared-view
              payload-box
              on-true)]
          [on-false
            (be_state.compiler-backend-box-field-shared-view
              payload-box
              on-false)]
          [lanes (deref payload-box).lanes]
          [elem-ty
            (be_state.compiler-backend-box-field-shared-view payload-box ty)]
          (be_simd.compiler-backend-emit-select
            ctx.type-segment-bases
            ctx.assignments
            dst
            mask
            on-true
            on-false
            lanes
            elem-ty
            instr-diag
            ctx.backend-state))]
      [(VectorLoad dst base index lanes elem-ty)
        (be_simd.compiler-backend-emit-vector-load
          (be_operand.compiler-backend-vector-mode elem-ty lanes)
          ctx.type-segment-bases
          ctx.assignments
          dst
          base
          index
          lanes
          elem-ty
          instr-diag
          ctx.backend-state)]
      [(VectorStore payload-box)
        (let
          [base
            (be_state.compiler-backend-box-field-shared-view payload-box base)]
          [index
            (be_state.compiler-backend-box-field-shared-view payload-box index)]
          [value
            (be_state.compiler-backend-box-field-shared-view payload-box value)]
          [lanes (deref payload-box).lanes]
          [elem-ty
            (be_state.compiler-backend-box-field-shared-view payload-box ty)]
          (be_simd.compiler-backend-emit-vector-store
            (be_operand.compiler-backend-vector-mode elem-ty lanes)
            ctx.type-segment-bases
            ctx.assignments
            base
            index
            value
            lanes
            elem-ty
            instr-diag
            ctx.backend-state))]
      [(PredicatedStore payload-box)
        (let
          [base
            (be_state.compiler-backend-box-field-shared-view payload-box base)]
          [index
            (be_state.compiler-backend-box-field-shared-view payload-box index)]
          [value
            (be_state.compiler-backend-box-field-shared-view payload-box value)]
          [mask
            (be_state.compiler-backend-box-field-shared-view payload-box mask)]
          [lanes (deref payload-box).lanes]
          [elem-ty
            (be_state.compiler-backend-box-field-shared-view payload-box ty)]
          (be_simd.compiler-backend-emit-predicated-store
            ctx.type-segment-bases
            ctx.function
            ctx.current-label
            ctx.assignments
            base
            index
            value
            mask
            lanes
            elem-ty
            instr-diag
            ctx.backend-state))]
      [(PredicatedLoad payload-box)
        (let
          [dst (deref payload-box).dst]
          [base
            (be_state.compiler-backend-box-field-shared-view payload-box base)]
          [index
            (be_state.compiler-backend-box-field-shared-view payload-box index)]
          [mask
            (be_state.compiler-backend-box-field-shared-view payload-box mask)]
          [lanes (deref payload-box).lanes]
          [elem-ty
            (be_state.compiler-backend-box-field-shared-view payload-box ty)]
          (be_simd.compiler-backend-emit-predicated-load
            ctx.type-segment-bases
            ctx.function
            ctx.current-label
            ctx.assignments
            dst
            base
            index
            mask
            lanes
            elem-ty
            instr-diag
            ctx.backend-state))]
      [(GatherLoad payload-box)
        (let
          [dst (deref payload-box).dst]
          [base
            (be_state.compiler-backend-box-field-shared-view payload-box base)]
          [index-base
            (be_state.compiler-backend-box-field-shared-view
              payload-box
              index-base)]
          [index
            (be_state.compiler-backend-box-field-shared-view payload-box index)]
          [lane-offset (deref payload-box).lane-offset]
          [lanes (deref payload-box).lanes]
          [elem-ty
            (be_state.compiler-backend-box-field-shared-view payload-box ty)]
          (be_simd.compiler-backend-emit-gather-load
            ctx.type-segment-bases
            ctx.assignments
            dst
            base
            index-base
            index
            lane-offset
            lanes
            elem-ty
            instr-diag
            ctx.backend-state))]
      [(VectorShuffle payload-box)
        (let
          [dst (deref payload-box).dst]
          [source
            (be_state.compiler-backend-box-field-shared-view payload-box source)]
          [selector-low
            (be_state.compiler-backend-box-field-shared-view
              payload-box
              selector-low)]
          [selector-high
            (be_state.compiler-backend-box-field-shared-view
              payload-box
              selector-high)]
          [active-lanes
            (be_state.compiler-backend-box-field-shared-view
              payload-box
              active-lanes)]
          [lanes (deref payload-box).lanes]
          [elem-ty
            (be_state.compiler-backend-box-field-shared-view payload-box ty)]
          (be_simd.compiler-backend-emit-vector-shuffle
            ctx.type-segment-bases
            ctx.target-policy.target
            ctx.function
            ctx.current-label
            ctx.assignments
            dst
            source
            selector-low
            selector-high
            active-lanes
            lanes
            elem-ty
            ctx.plan
            ctx.program-index
            instr-diag))]
      [(TailMask dst index len lanes)
        (be_simd.compiler-backend-emit-tail-mask
          ctx.type-segment-bases
          ctx.function
          ctx.current-label
          ctx.assignments
          dst
          index
          len
          lanes
          instr-diag
          ctx.backend-state)]
      [(EntryArgc dst)
        (be_calls.compiler-backend-emit-entry-load
          ctx.assignments
          dst
          (compiler_ir_types.compiler-ir-label
            (if (be_state.compiler-backend-state-library-object?
              ctx.backend-state)
              "__tl_argc"
              ".L_tl_argc"))
          (I64)
          ctx.backend-state)]
      [(EntryArgv dst)
        (be_calls.compiler-backend-emit-entry-load
          ctx.assignments
          dst
          (compiler_ir_types.compiler-ir-label
            (if (be_state.compiler-backend-state-library-object?
              ctx.backend-state)
              "__tl_argv"
              ".L_tl_argv"))
          (compiler_ast_types.ast-ty-ptr
            (& (compiler_ast_types.ast-ty-ptr (& (U8)))))
          ctx.backend-state)]
      [(EntryEnvp dst)
        (be_calls.compiler-backend-emit-entry-load
          ctx.assignments
          dst
          (compiler_ir_types.compiler-ir-label
            (if (be_state.compiler-backend-state-library-object?
              ctx.backend-state)
              "__tl_envp"
              ".L_tl_envp"))
          (compiler_ast_types.ast-ty-ptr
            (& (compiler_ast_types.ast-ty-ptr (& (U8)))))
          ctx.backend-state)]
      [(CpuId dst leaf subleaf reg-index)
        (be_calls.compiler-backend-emit-cpuid
          ctx.assignments
          dst
          leaf
          subleaf
          reg-index
          ctx.backend-state)]
      [(Xgetbv dst index)
        (compiler-backend-emit-xgetbv
          ctx.assignments
          dst
          index
          ctx.backend-state)]
      [(Syscall dst args)
        (be_calls.compiler-backend-emit-syscall
          ctx.target-policy
          ctx.assignments
          dst
          args
          ctx.backend-state)]
      [(SpmdCall payload-box)
        (let
          [name (deref payload-box).callee]
          [backend (deref payload-box).backend]
          [lanes (deref payload-box).lanes]
          [active-mask
            (be_state.compiler-backend-box-field-shared-view
              payload-box
              active-mask)]
          [args
            (be_state.compiler-backend-box-field-shared-view payload-box args)]
          [result
            (be_state.compiler-backend-box-field-shared-view payload-box result)]
          (be_calls.compiler-backend-emit-spmd-call
            ctx.type-segment-bases
            ctx.target-policy.target
            name
            backend
            lanes
            active-mask
            args
            result
            ctx.assignments
            ctx.plan
            ctx.program-index
            ctx.vars
            instr-diag
            ctx.backend-state))]
      [(Call dst name args ty)
        (let
          [asm
            (try
              (be_calls.compiler-backend-emit-direct-call-with-arg-assignments
                ctx.type-segment-bases
                ctx.target-policy.target
                ctx.function
                ctx.current-label
                (be_state.compiler-backend-function-state-emit-current-site
                  ctx.function-state)
                dst
                name
                args
                ty
                ctx.assignments
                ctx.assignments
                ctx.types
                ctx.global-types
                ctx.plan
                ctx.externs
                ctx.program-index
                ctx.vars
                instr-diag
                ctx.backend-state))]
          (Ok
            (if (and
              (be_scalar.compiler-backend-abort-site-active? ctx.backend-state)
              (be_scalar.compiler-backend-stdlib-io-panic-name?
                ctx.backend-state
                name))
              (be_scalar.compiler-backend-rewrite-panic-call
                asm
                (be_operand.compiler-backend-call-symbol-index
                  name
                  ctx.plan
                  ctx.program-index)
                ctx.backend-state)
              asm)))]
      [(CallIndirect dst func args ty)
        (compiler-backend-emit-indirect-call
          ctx.type-segment-bases
          ctx.target-policy.target
          dst
          func
          args
          ty
          ctx.assignments
          ctx.types
          ctx.functions
          ctx.externs
          ctx.program-index
          ctx.vars
          instr-diag
          ctx.backend-state)]
      [(CallIndirectC dst func args ty)
        (compiler-backend-emit-indirect-c-call
          ctx.type-segment-bases
          ctx.target-policy.target
          dst
          func
          args
          ty
          ctx.assignments
          ctx.types
          ctx.functions
          ctx.externs
          ctx.program-index
          ctx.vars
          instr-diag
          ctx.backend-state)]
      [(CallCAbiStoreResult payload-box)
        (let
          [base
            (be_state.compiler-backend-box-field-shared-view payload-box base)]
          [name (deref payload-box).name]
          [args
            (be_state.compiler-backend-box-field-shared-view payload-box args)]
          [slots
            (be_state.compiler-backend-box-field-shared-view payload-box slots)]
          (compiler-backend-emit-c-abi-store-result-call
            ctx.type-segment-bases
            ctx.target-policy.target
            base
            name
            args
            slots
            ctx.assignments
            ctx.types
            ctx.global-types
            ctx.plan
            ctx.externs
            ctx.program-index
            ctx.vars
            instr-diag
            ctx.backend-state))]
      [(CallIndirectCAbiStoreResult
          (box (fields base [func callee] args slots)))
        (compiler-backend-emit-indirect-c-abi-store-result-call
          ctx.type-segment-bases
          ctx.target-policy.target
          base
          func
          args
          slots
          ctx.assignments
          ctx.types
          ctx.functions
          ctx.externs
          ctx.program-index
          ctx.vars
          instr-diag
          ctx.backend-state)]
      [(TailCall name args ty)
        (compiler-backend-with-instr-diagnostic
          (be_calls.compiler-backend-emit-tail-call
            ctx.type-segment-bases
            ctx.target-policy.target
            ctx.source-function
            ctx.blocks
            ctx.current-label
            name
            args
            ty
            ctx.assignments
            ctx.types
            ctx.global-types
            ctx.vars
            ctx.plan
            ctx.functions
            ctx.externs
            ctx.program-index
            (be_state.compiler-backend-global-shared-view instr-diag)
            ctx.backend-state)
          instr-diag)]
      [(Store name value ty)
        (let
          [symbol : String
            (be_operand.compiler-backend-global-symbol-index
              ctx.program-index
              name)]
          [addr : String (str_cat.str-cat symbol "(%rip)" "")]
          ;; Only word cells take a `Store`: an inline cell is written in place.
          (if (be_facts.compiler-backend-group-type?
            ctx.type-segment-bases
            ctx.program-index
            ty)
            ;; An internal store must preserve live homes across both words.
            (compiler-backend-with-instr-diagnostic
              (be_scalar.compiler-backend-emit-group-copy
                ctx.type-segment-bases
                ctx.assignments
                (& (Global name))
                value
                ctx.vars
                ty
                ctx.program-index
                ctx.backend-state)
              instr-diag)
            (let
              [no-exclude : (__tl_dyn-array String) (__tl_make-array String 0)]
              (compiler-backend-with-instr-diagnostic
                (be_scalar.compiler-backend-emit-store-value-to-address
                  ctx.type-segment-bases
                  ctx.assignments
                  value
                  ty
                  addr
                  ctx.program-index
                  no-exclude
                  0
                  ctx.backend-state)
                instr-diag))))]
      [(Jump target)
        (match (be_calls.compiler-backend-emit-trivial-phi-return-edge
          ctx.type-segment-bases
          ctx.source-function
          ctx.blocks
          target
          ctx.current-label
          ctx.assignments
          ctx.vars
          ctx.ret-ty
          ctx.program-index)
          [(Ok direct-return)
            (if (string.eq direct-return "")
              (match (be_calls.compiler-backend-emit-phi-edge-copies
                ctx.type-segment-bases
                ctx.assignments
                (be_state.compiler-backend-global-shared-view ctx.blocks)
                target
                ctx.current-label
                ctx.program-index
                ctx.vars)
                [(Ok copies)
                  (if (be_scalar.compiler-backend-jump-forward-drift?
                    ctx.backend-state
                    ctx.current-label
                    copies)
                    (be_state.compiler-backend-instr-error
                      instr-diag
                      "backend: jump-forward drift on a jump-only block")
                    (Ok
                      (str_cat.str-cat
                        copies
                        (let
                          [taken : i64
                            (be_scalar.compiler-backend-jump-resolve-target
                              ctx.backend-state
                              target
                              fallthrough)]
                          (if (be_scalar.compiler-backend-jump-target-is-fallthrough?
                            taken
                            fallthrough)
                            ""
                            ;; SCAV2. An emergency scavenge that is still
                            ;; pending here borrowed an occupied register for
                            ;; the phi edge copies above. The enclosing
                            ;; emergency-wrap appends its restore AFTER this
                            ;; whole string -- which, once a `jmp` ends it, is
                            ;; unreachable: the borrowed occupant stays
                            ;; clobbered on the taken edge. Emit the restores
                            ;; before the transfer instead (and suppress the
                            ;; wrap's trailing pair), exactly as the
                            ;; conditional-branch jumps
                            ;; (compiler-backend-emit-branch-jumps) and the
                            ;; switch dispatch already do. `movq` sets no
                            ;; flags and the copies are complete at this
                            ;; point, so the placement is sound; the
                            ;; FALLTHROUGH arm above needs nothing, its
                            ;; trailing restore is on the executed path.
                            (str_cat.str-cat
                              (be_scalar.compiler-backend-emergency-restore-before-jumps
                                ctx.backend-state)
                              "    jmp "
                              (be_operand.compiler-backend-asm-label
                                ctx.function
                                taken)
                              "\n"
                              ""))))))]
                [(Err message)
                  (be_state.compiler-backend-instr-error-from
                    instr-diag
                    message)])
              (Ok direct-return))]
          [(Err message)
            (be_state.compiler-backend-instr-error-from instr-diag message)])]
      [(Branch cond true-label false-label)
        (compiler-backend-with-instr-diagnostic
          (be_calls.compiler-backend-emit-branch-with-phi-copies
            ctx.type-segment-bases
            ctx.assignments
            ctx.function
            (be_state.compiler-backend-global-shared-view ctx.blocks)
            ctx.current-label
            cond
            true-label
            false-label
            fallthrough
            ctx.program-index
            ctx.vars
            ""
            "")
          instr-diag)]
      [(TotalEnumBranch cond true-label false-label)
        (compiler-backend-emit-instr
          (be_state.compiler-backend-global-shared-view ctx)
          fallthrough
          (Branch cond true-label false-label))]
      [(Return value)
        (compiler-backend-with-instr-diagnostic
          (be_scalar.compiler-backend-emit-return
            ctx.type-segment-bases
            ctx.source-function
            ctx.blocks
            value
            ctx.assignments
            ctx.vars
            ctx.ret-ty
            ctx.program-index)
          instr-diag)]
      [(Pack dst words ty)
        (be_scalar.compiler-backend-emit-pack
          ctx.type-segment-bases
          ctx.assignments
          dst
          words
          ty
          ctx.vars
          ctx.program-index
          instr-diag
          ctx.backend-state)]
      [(Word dst src index ty)
        (be_scalar.compiler-backend-emit-word
          ctx.type-segment-bases
          ctx.assignments
          dst
          src
          index
          ty
          ctx.vars
          instr-diag
          ctx.backend-state)]
      [(TailCallIndirect func args ty)
        (compiler-backend-with-instr-diagnostic
          (compiler-backend-emit-tail-indirect-call
            ctx.type-segment-bases
            ctx.target-policy.target
            ctx.source-function
            ctx.blocks
            ctx.current-label
            func
            args
            ty
            ctx.assignments
            ctx.types
            ctx.vars
            ctx.functions
            ctx.externs
            ctx.program-index
            (be_state.compiler-backend-global-shared-view instr-diag)
            ctx.backend-state)
          instr-diag)]
      [(Switch index base cases default-label)
        (compiler-backend-with-instr-diagnostic
          (be_calls.compiler-backend-emit-switch
            ctx.type-segment-bases
            ctx.function
            ctx.current-label
            index
            base
            cases
            default-label
            (compiler_ir_types.compiler-ir-label-none)
            ctx.assignments
            ctx.blocks
            ctx.program-index
            ctx.vars)
          instr-diag)]
      [(TotalEnumSwitch index base cases default-label trap-label)
        (compiler-backend-with-instr-diagnostic
          (be_calls.compiler-backend-emit-switch
            ctx.type-segment-bases
            ctx.function
            ctx.current-label
            index
            base
            cases
            default-label
            trap-label
            ctx.assignments
            ctx.blocks
            ctx.program-index
            ctx.vars)
          instr-diag)])))

(define (compiler-backend-use-count-inc
  [counts : (&mut counts (__tl_dyn-array i64))]
  [var : i64]) : unit
  (when
    (and (>= var 0) (< var (array-length counts)))
    (set! (array-ref counts var) (+ (array-ref counts var) 1))))

;; The backend also counts the storage home named by AddrOf.
(define (compiler-backend-instr-short-uses
  [instr : (& compiler_ir_types.CompilerIrInstr)]) : compiler_ir_types.CompilerIrShortVarUses
  (match instr
    [(AddrOf _ src _) (compiler_ir_types.CompilerIrShortVarUses true src -1)]
    [_ (compiler_ir_types.compiler-ir-instr-short-var-uses instr)]))

;; Every use counts, Pack words included, so the single-use fusion peepholes
;; cannot elide the home store of a var a Pack/Word still reads (-O2 copy-prop
;; substitutes vars directly into Pack/Word operands); so does AddrOf's storage
;; var.
(define (compiler-backend-count-instr-uses
  [counts : (&mut counts (__tl_dyn-array i64))]
  [instr : (& compiler_ir_types.CompilerIrInstr)]
  [ids : (&mut ids compiler_ir_types.CompilerIrIdList)]) : unit
  (let
    [short : compiler_ir_types.CompilerIrShortVarUses
      (compiler-backend-instr-short-uses instr)]
    (if short.fits?
      (begin
        (compiler-backend-use-count-inc counts short.first)
        (compiler-backend-use-count-inc counts short.second))
      (begin
        (set! ids.len 0)
        (compiler_ir_types.compiler-ir-instr-use-var-ids-into! instr ids)
        (for [id (& ids)]
          (compiler-backend-use-count-inc counts (deref id)))))))

(define (compiler-backend-count-instr-seq-uses
  [counts : (__tl_dyn-array i64)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [ids : (&mut compiler_ir_types.CompilerIrIdList)]) : unit
  (for [index (iterator.range 0 instrs.len)]
    (compiler-backend-count-instr-uses
      (&mut counts)
      (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)
      ids)))

(define (compiler-backend-count-block-uses
  [counts : (__tl_dyn-array i64)]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : unit
  (match blocks
    [(Array seq) (compiler-backend-count-block-seq-uses counts seq)]))

(define (compiler-backend-count-block-seq-uses
  [counts : (__tl_dyn-array i64)]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]) : unit
  (let
    [count : i64 (compiler_ir_types.compiler-ir-block-seq-count blocks)]
    [ids : compiler_ir_types.CompilerIrIdList
      (compiler_ir_types.compiler-ir-id-list-new)]
    (for [index (iterator.range 0 count)]
      (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
        [(Block _ instrs)
          (compiler-backend-count-instr-seq-uses
            (be_state.compiler-backend-global-shared-view counts)
            instrs
            (&mut ids))]))
    unit))

;; Pre-regalloc SIMD select-add/sub factoring
;; (be_simd.compiler-backend-simd-select-add-factor-blocks), fed this
;; function's use counts from the shared operand walk.
(define (compiler-backend-select-add-factor-blocks
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : be_simd.CompilerBackendSelectFactorResult
  (if (or
    (<= vars 0)
    (not
      (be_simd.compiler-backend-simd-select-factor-has-candidate? (& blocks))))
    (SelectFactorResult vars blocks)
    (let
      [uses : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
      [ids : compiler_ir_types.CompilerIrIdList
        (compiler_ir_types.compiler-ir-id-list-new)]
      (match (& blocks)
        [(Array seq)
          (for [b
            (iterator.range
              0
              (compiler_ir_types.compiler-ir-block-seq-count seq))]
            (match (compiler_ir_types.compiler-ir-block-seq-borrow seq b)
              [(Block _ instrs)
                (for [i (iterator.range 0 instrs.len)]
                  (compiler-backend-count-instr-uses
                    (&mut uses)
                    (compiler_ir_types.compiler-ir-instr-seq-borrow instrs i)
                    (&mut ids)))]))])
      (be_simd.compiler-backend-simd-select-add-factor-blocks
        vars
        blocks
        (& uses)))))

(define (compiler-backend-function-use-counts
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : (__tl_dyn-array i64)
  (let
    [counts : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    (compiler-backend-count-block-uses
      (be_state.compiler-backend-global-shared-view counts)
      blocks)
    counts))

;; --- fusion-pinned gep and load temps ---------------------------------------
;; A `Gep` whose destination is read by exactly one instruction, and that
;; instruction is the very next one in the same block, is the shape the gep
;; fusion cluster (compiler-backend-emit-gep-step) folds into the consumer's
;; addressing mode. A fused gep needs no register and no home: base and index
;; are read where they already live and the address never materialises.
;;
;; A `Load` destination in that same position is pinned for the same reason and
;; on the same terms. Every fold in the M6 family -- the bounds-check length,
;; the compare+branch, the narrow compare, the widening cast -- is gated on
;; `compiler-backend-var-single-use?` of the LOADED var, because that is what
;; proves the fold may retire it without writing its home. So the loaded var's
;; identity is load-bearing in exactly the way a gep temp's is, and losing it
;; costs strictly more: the gep temp falls back to a `leaq`, while the loaded
;; var falls back to a materialising load (a second scratch register, a store to
;; its home, and -- once the pool is saturated -- an emergency save/restore pair
;; around each scratch) whose result the consumer then re-reads from that home.
;; When slot coloring merges the compare operands of two `!=` tests onto ONE
;; representative id, the merged id's use count is 2, every M6 probe declines,
;; and each word compare costs nine instructions where three suffice.
;;
;; Slot coloring, however, merges non-interfering SPILLED variables onto one
;; representative id, and the emitter's use counts are computed on the remapped
;; blocks -- so a whole unrolled body's worth of independent gep temps can
;; collapse into one id with a use count in the dozens, `single-use?` turns
;; false, and every site falls back to the generic two-scratch staged emitter
;; (save two registers to their homes, leaq, store the address to its home,
;; restore, reload, use, restore). Reporting those temps to the coloring pass
;; keeps their ids distinct, which keeps the peepholes firing.
;;
;; Adjacency is read off the DIFFERENCE in the running use counter across a
;; single instruction: `counts` accumulates function-wide uses in program order,
;; so a rise in the pending Gep or Load destination's counter while counting the
;; next instruction proves that instruction reads it. When the walk finishes,
;; `counts` holds exactly the ordinary function-wide use counts, which decide
;; the "used exactly once" half of the test.
;;
;; The pin is withheld from every SHARING mechanism only; a pinned var still
;; gets a private slot, so a temp whose fold does not fire is unchanged in
;; instruction count and costs one frame slot. That is the same trade the gep
;; pin has always made, and it is bounded by the same two conditions: the var
;; must be spilled (register homes already survive the renumbering) and read by
;; exactly one instruction, the very next one.
;;
;; The pin is deliberately NOT narrowed to the M6 consumers. `single-use?` of a
;; loaded value gates far more than the compare folds: the GAP8 ALU shapes, the
;; gep-load pair and divmod bundles, and the load emitters' own direct paths all
;; ask the same question, and all of them fall back to a materialising load and
;; a home store when it answers false. Restricting the pin to compares and casts
;; costs more than the frame slots it saves, because the ALU shapes lose their
;; folds.
(define (compiler-backend-gep-fusion-pin-seq!
  [counts : (__tl_dyn-array i64)]
  [adjacent : (&mut adjacent (__tl_dyn-array bool))]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [ids : (&mut compiler_ir_types.CompilerIrIdList)]) : unit
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [pending : i64 (- 0 1)]
    (for [index (iterator.range 0 count)]
      (let
        [instr : compiler_ir_types.CompilerIrInstr
          (be_state.compiler-backend-global-array-element-shared-view
            slots
            index)]
        [before : i64
          (if (>= pending 0)
            (array-ref counts pending)
            0)]
        (compiler-backend-count-instr-uses (&mut counts) (& instr) ids)
        (if (and (>= pending 0) (> (array-ref counts pending) before))
          (set! (array-ref adjacent pending) true)
          unit)
        (set!
          pending
          (match instr
            [(or (Gep dst _ _ _) (Load dst _ _))
              (if (and (>= dst 0) (< dst (array-length adjacent)))
                dst
                (- 0 1))]
            [_ (- 0 1)]))))))

(define (compiler-backend-gep-fusion-pin-block-seq!
  [counts : (__tl_dyn-array i64)]
  [adjacent : (__tl_dyn-array bool)]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]) : unit
  (let
    [count : i64 (compiler_ir_types.compiler-ir-block-seq-count blocks)]
    [ids : compiler_ir_types.CompilerIrIdList
      (compiler_ir_types.compiler-ir-id-list-new)]
    (for [index (iterator.range 0 count)]
      (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
        [(Block _ instrs)
          (compiler-backend-gep-fusion-pin-seq!
            (be_state.compiler-backend-global-shared-view counts)
            (&mut adjacent)
            instrs
            (&mut ids))]))))

(define (compiler-backend-gep-fusion-pin-blocks!
  [counts : (__tl_dyn-array i64)]
  [adjacent : (__tl_dyn-array bool)]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : unit
  (match blocks
    [(Array seq)
      (compiler-backend-gep-fusion-pin-block-seq! counts adjacent seq)]))

(define (compiler-backend-gep-fusion-pin-candidate?
  [counts : (& counts (__tl_dyn-array i64))]
  [adjacent : (& adjacent (__tl_dyn-array bool))]
  [vars : i64]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (while (and (< index vars) (not found))
      (if (and (array-ref adjacent index) (= (array-ref counts index) 1))
        (set! found true)
        unit)
      (+= index 1))
    found))

;; Stack-homed single-use gep temps consumed by the immediately following
;; instruction, keyed by the PRE-coloring var ids the given blocks and plan
;; assignments use. Register-homed temps already keep distinct ids through the
;; renumbering, so only stack homes need reporting. An explicit `Spill` is a
;; stack home in scalar allocation plans; a missing assignment is the ordinary
;; stack home in stack-only opt0/opt1 plans.
(define (compiler-backend-gep-fusion-pinned-vars
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [missing-stack-home? : bool]) : compiler_liveness.CompilerLiveI64Set
  (if (<= vars 0)
    (compiler_liveness.compiler-live-set-empty)
    (let
      [counts : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
      [adjacent : (__tl_dyn-array bool) (__tl_make-array bool vars)]
      [_walk : unit
        (compiler-backend-gep-fusion-pin-blocks!
          (be_state.compiler-backend-global-shared-view counts)
          (be_state.compiler-backend-global-shared-view adjacent)
          blocks)]
      (if (not
        (compiler-backend-gep-fusion-pin-candidate? counts adjacent vars))
        (compiler_liveness.compiler-live-set-empty)
        (let
          [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
            (compiler_regalloc.compiler-reg-assignment-table-with-min-capacity
              assignments
              vars)]
          [words : (__tl_dyn-array i64)
            (compiler_liveness.compiler-live-set-builder (- vars 1))]
          [pinned : bool false]
          (for [index (iterator.range 0 vars)]
            (when
              (and
                (array-ref adjacent index)
                (= (array-ref counts index) 1)
                (match (compiler_regalloc.compiler-reg-assignment-table-lookup
                  assignment-index
                  index)
                  [(Some location)
                    (match location
                      [(Spill _) true]
                      [_ false])]
                  [(No) missing-stack-home?]))
              (compiler_liveness.compiler-live-set-builder-insert!
                (&mut words)
                index)
              (set! pinned true)))
          (if pinned
            (compiler_liveness.compiler-live-set-from-words-trimmed
              (be_state.compiler-backend-global-shared-view words)
              (array-length words))
            (compiler_liveness.compiler-live-set-empty)))))))

;; True when every use of `var` is a branch fed by its own adjacent compare, so
;; the boolean is never needed as a materialized value and a compare->branch on
;; it may fuse. Holds when the var's total use count equals its free-branch
;; count. Reads the per-function arrays installed by
;; compiler-backend-fuse-need-enable!; conservatively false when unset.
(define (compiler-backend-var-fuse-safe?
  [backend-state : be_state.CompilerBackendState]
  [var : i64]) : bool
  (let
    [function-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state backend-state)]
    [use-counts : (__tl_dyn-array i64)
      (be_state.compiler-backend-function-state-i64-array
        function-state
        be_state.compiler-backend-function-i64-array-fuse-use-counts)]
    [free-counts : (__tl_dyn-array i64)
      (be_state.compiler-backend-function-state-i64-array
        function-state
        be_state.compiler-backend-function-i64-array-fuse-free-counts)]
    (cond
      [(not
          (be_state.compiler-backend-function-state-bool?
            function-state
            be_state.compiler-backend-function-bool-fuse-need-ready))
        false]
      [(< var 0) false]
      [(>= var (array-length free-counts)) false]
      [(>= var (array-length use-counts)) false]
      [else (= (array-ref use-counts var) (array-ref free-counts var))])))

;; The condition var at slot `j` when the consumer there is fed by the
;; immediately preceding compare or boolean negation (a "free" consumer whose
;; boolean need not be materialized); otherwise -1.
;;
;; Two consumers qualify. A BRANCH reads the comparison's flags with its own
;; `jcc`. A scalar SELECT (SS-P5(b)) reads them with a `cmov<cc>`; the
;; adjacency requirement is identical, because in both cases the comparison is
;; re-emitted at the consumer and nothing may sit between them. A vector select
;; is excluded (its mask is a real ymm/zmm value), as is a select reached
;; through a copy of the boolean rather than the boolean itself.
(define (compiler-backend-fuse-free-branch-var
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [j : i64]) : i64
  (if (<= j 0)
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-scalar-fact
      (be_state.compiler-backend-global-array-element-shared-view slots j))
      [(Branch cond _ _)
        (match cond
          [(Var v)
            (match (be_state.compiler-backend-global-array-element-shared-view
              slots
              (- j 1))
              [(BinOp dst op _ _ _)
                (if (and (be_facts.compiler-backend-compare-op? op) (= dst v))
                  v
                  (- 0 1))]
              [(UnOp dst (Not) _ (Bool))
                (if (= dst v)
                  v
                  (- 0 1))]
              [_ (- 0 1)])]
          [_ (- 0 1)])]
      [_ (compiler-backend-fuse-free-select-var slots j)])))

;; The Select half of the adjacency test above, kept separate so the branch
;; shape stays one flat match.
(define (compiler-backend-fuse-free-select-var
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [j : i64]) : i64
  (match (owned_view.compiler-owned-element-view slots j)
    [(Select payload-box)
      (let
        [mask
          (be_state.compiler-backend-box-field-shared-view payload-box mask)]
        [lanes (deref payload-box).lanes]
        (if (not (= lanes 0))
          (- 0 1)
          (match mask
            [(Var v)
              (match (owned_view.compiler-owned-element-view slots (- j 1))
                [(BinOp dst op _ _ _)
                  (if (and (be_facts.compiler-backend-compare-op? op) (= dst v))
                    v
                    (- 0 1))]
                [_ (- 0 1)])]
            [_ (- 0 1)])))]
    [_ (- 0 1)]))

(define (compiler-backend-count-instr-seq-use-facts
  [counts : (__tl_dyn-array i64)]
  [free : (&mut free (__tl_dyn-array i64))]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [ids : (&mut compiler_ir_types.CompilerIrIdList)]) : unit
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [n : i64 instrs.len]
    (for [j (iterator.range 0 n)]
      (compiler-backend-count-instr-uses
        (&mut counts)
        (& (array-ref slots j))
        ids)
      (let
        [v : i64
          (compiler-backend-fuse-free-branch-var
            (be_state.compiler-backend-global-shared-view slots)
            j)]
        (if (and (>= v 0) (< v (array-length free)))
          (set! (array-ref free v) (+ (array-ref free v) 1))
          unit)))))

(define (compiler-backend-count-block-use-facts
  [counts : (__tl_dyn-array i64)]
  [free : (__tl_dyn-array i64)]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : unit
  (match blocks
    [(Array seq) (compiler-backend-count-block-seq-use-facts counts free seq)]))

(define (compiler-backend-count-block-seq-use-facts
  [counts : (__tl_dyn-array i64)]
  [free : (__tl_dyn-array i64)]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]) : unit
  (let
    [count : i64 (compiler_ir_types.compiler-ir-block-seq-count blocks)]
    [ids : compiler_ir_types.CompilerIrIdList
      (compiler_ir_types.compiler-ir-id-list-new)]
    (for [index (iterator.range 0 count)]
      (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
        [(Block _ instrs)
          (compiler-backend-count-instr-seq-use-facts
            (be_state.compiler-backend-global-shared-view counts)
            (&mut free)
            instrs
            (&mut ids))]))
    unit))

(define (compiler-backend-fuse-need-enable!
  [backend-state : be_state.CompilerBackendState]
  [use-counts : (__tl_dyn-array i64)]
  [free-counts : (__tl_dyn-array i64)]) : unit
  (let
    [function-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state backend-state)]
    (be_state.compiler-backend-function-state-set-i64-array!
      function-state
      be_state.compiler-backend-function-i64-array-fuse-use-counts
      use-counts)
    (be_state.compiler-backend-function-state-set-i64-array!
      function-state
      be_state.compiler-backend-function-i64-array-fuse-free-counts
      free-counts)
    (be_state.compiler-backend-function-state-set-bool!
      function-state
      be_state.compiler-backend-function-bool-fuse-need-ready
      true)))

(define (compiler-backend-fuse-need-disable!
  [backend-state : be_state.CompilerBackendState]) : unit
  (be_state.compiler-backend-function-state-set-bool!
    (be_state.compiler-backend-state-function-state backend-state)
    be_state.compiler-backend-function-bool-fuse-need-ready
    false))

(define (compiler-backend-addr-of-forwarding-fill!
  [items : (&mut items (__tl_dyn-array i64))]
  [index : i64]) : unit
  (unless
    (>= index (array-length items))
    (set! (array-ref items index) -1)
    (compiler-backend-addr-of-forwarding-fill! items (+ index 1))))

;; A candidate's one value use immediately after its definition is dominated
;; by that definition, even if coloring reuses the id elsewhere. The global
;; recipe is consulted only at that sole use; suppressing other, dead AddrOf
;; definitions is harmless. Phi inputs belong to predecessor edges, and an
;; AddrOf storage operand names a home rather than reading its value.
;; A scratch use counter measures the increment caused by one instruction;
;; only functions with address candidates allocate it.
(define (compiler-backend-addr-of-forwarding-record-seq!
  [items : (&mut items (__tl_dyn-array i64))]
  [use-counts : (& use-counts (__tl_dyn-array i64))]
  [instrs : (& instrs compiler_ir_types.CompilerIrInstrSeq)]
  [probe : (&mut probe (__tl_dyn-array i64))]
  [vars : i64]
  [local-pass : bool]) : bool
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
      (owned_view.compiler-owned-reference-shared-view (& instrs.slots))]
    [pending : i64 -1]
    [pending-root : i64 -1]
    [unproven : bool false]
    [ids : compiler_ir_types.CompilerIrIdList
      (compiler_ir_types.compiler-ir-id-list-new)]
    (for [index (iterator.range 0 instrs.len)]
      (let
        [instr
          (be_state.compiler-backend-global-array-element-shared-view
            slots
            index)]
        [kind : i64 0]
        [dst : i64 -1]
        [src : i64 -1]
        (match (& instr)
          [(AddrOf d r _)
            (set! kind 1)
            (set! dst d)
            (set! src r)]
          [(Mov d (Var r) _)
            (set! kind 2)
            (set! dst d)
            (set! src r)]
          [(Phi _ _ _) (set! kind 3)]
          [_ unit])
        (when
          (and local-pass (>= pending 0))
          (let
            [before : i64 (array-ref probe pending)]
            (unless
              (or (= kind 1) (= kind 3))
              (compiler-backend-count-instr-uses probe (& instr) (&mut ids)))
            (if (not (= (array-ref probe pending) before))
              (set! (array-ref items pending) pending-root)
              (set! unproven true))))
        (set! pending -1)
        (when
          (and
            (>= dst 0)
            (< dst vars)
            (be_simd.compiler-backend-var-single-use? use-counts dst))
          (let
            [root : i64
              (if (= kind 1)
                src
                (if (and (>= src 0) (< src (array-length items)))
                  (array-ref items src)
                  -1))]
            (when
              (>= root 0)
              (when
                (= (array-length items) 0)
                (set! (deref items) (__tl_make-array i64 vars))
                (set! (deref probe) (__tl_make-array i64 vars))
                (compiler-backend-addr-of-forwarding-fill! items 0))
              (if local-pass
                (begin
                  (set! pending dst)
                  (set! pending-root root))
                (when
                  (= (array-ref items dst) -1)
                  (set! (array-ref items dst) root))))))))
    (or unproven (>= pending 0))))

(define (compiler-backend-addr-of-forwarding-record-blocks!
  [items : (&mut items (__tl_dyn-array i64))]
  [use-counts : (& use-counts (__tl_dyn-array i64))]
  [blocks : (& compiler_ir_types.CompilerIrBlockList)]
  [probe : (&mut probe (__tl_dyn-array i64))]
  [vars : i64]
  [local-pass : bool]) : bool
  (match blocks
    [(Array seq)
      (let
        [unproven : bool false]
        (for [b
          (iterator.range 0 (compiler_ir_types.compiler-ir-block-seq-count seq))]
          (match (compiler_ir_types.compiler-ir-block-seq-borrow seq b)
            [(Block _ instrs)
              (when
                (compiler-backend-addr-of-forwarding-record-seq!
                  items
                  use-counts
                  instrs
                  probe
                  vars
                  local-pass)
                (set! unproven true))]))
        unproven)]))

;; Retain globally unique recipes for nonadjacent and cross-block uses. Most
;; functions need no such proof, so defer the complete definition walk until
;; the local pass leaves a candidate unproven.
(define (compiler-backend-addr-of-forwarding-enable!
  [backend-state : be_state.CompilerBackendState]
  [vars : i64]
  [params : (& params compiler_ir_types.CompilerIrParamSeq)]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [use-counts : (__tl_dyn-array i64)]) : unit
  (let
    [items : (__tl_dyn-array i64) (__tl_make-array i64 0)]
    [probe : (__tl_dyn-array i64) (__tl_make-array i64 0)]
    [unproven : bool
      (compiler-backend-addr-of-forwarding-record-blocks!
        (&mut items)
        (& use-counts)
        (& blocks)
        (&mut probe)
        vars
        true)]
    (if (= (array-length items) 0)
      (compiler-backend-addr-of-forwarding-disable! backend-state)
      (begin
        (when
          unproven
          (let
            [defs : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
            (compiler_regalloc.compiler-reg-param-count-defs!
              params
              (&mut defs))
            (compiler_regalloc.compiler-reg-count-block-defs!
              (& blocks)
              (&mut defs))
            (for [v (iterator.range 0 vars)]
              (when
                (and (= (array-ref items v) -1) (not (= (array-ref defs v) 1)))
                (set! (array-ref items v) -2))))
          (let
            [_global : bool
              (compiler-backend-addr-of-forwarding-record-blocks!
                (&mut items)
                (& use-counts)
                (& blocks)
                (&mut probe)
                vars
                false)]
            unit))
        (be_state.compiler-backend-function-state-set-i64-array!
          (be_state.compiler-backend-state-function-state backend-state)
          be_state.compiler-backend-function-i64-array-addr-of-forwarding-src
          items)
        (be_state.compiler-backend-function-state-set-bool!
          (be_state.compiler-backend-state-function-state backend-state)
          be_state.compiler-backend-function-bool-addr-of-forwarding-enabled
          true)))))

(define (compiler-backend-addr-of-forwarding-disable!
  [backend-state : be_state.CompilerBackendState]) : unit
  (be_state.compiler-backend-function-state-set-bool!
    (be_state.compiler-backend-state-function-state backend-state)
    be_state.compiler-backend-function-bool-addr-of-forwarding-enabled
    false))

(define (compiler-backend-rest-starts-load-compare-branch?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [load-dst : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [use-counts : (& use-counts (__tl_dyn-array i64))]) : bool
  (if (< index instrs.len)
    (let
      [maybe-cmp (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)]
      [after-cmp : i64 (+ index 1)]
      (match maybe-cmp
        [(BinOp cmp-dst op lhs rhs cmp-ty)
          (if (and
            (be_facts.compiler-backend-compare-op? op)
            (be_operand.compiler-backend-branch-uses-var? lhs load-dst)
            (be_simd.compiler-backend-var-single-use? use-counts cmp-dst)
            (not
              (be_scalar.compiler-backend-binop-f64?
                types
                global-types
                lhs
                rhs
                cmp-ty)))
            (if (< after-cmp instrs.len)
              (let
                [branch
                  (compiler_ir_types.compiler-ir-instr-seq-ref instrs after-cmp)]
                (match (compiler_ir_types.compiler-ir-instr-scalar-fact branch)
                  [(Branch cond _ _)
                    (be_operand.compiler-backend-branch-uses-var? cond cmp-dst)]
                  [_ false]))
              false)
            false)]
        [_ false]))
    false))

(define (compiler-backend-fused-compare-fallthrough
  [instrs : (& instrs compiler_ir_types.CompilerIrInstrSeq)]
  [index : i64]
  [fallthrough : be_state.CompilerBackendMaybeLabel]) : be_state.CompilerBackendMaybeLabel
  (if (< index instrs.len)
    (No)
    fallthrough))

;; A block-terminator fusion (mov/call/binop directly into a return) emits the
;; whole tail of the block and does not recurse, so it appends the terminator's
;; asm after the instructions already emitted into the body buffer.
(define (compiler-backend-emit-terminator-into
  [result : be_state.ResultCompilerBackend]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [asm (try result)]
    (be_scalar.compiler-backend-emergency-append out asm backend-state)
    (Ok "")))

(define (compiler-backend-emit-instr-with-call-rax
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]) : be_state.ResultCompilerBackend
  (let
    ;; The var whose call-argument home is pinned to %rax, or -1 when the
    ;; forward is ineligible. Published only for the dynamic extent of a call
    ;; that actually consumes the forwarded value.
    [rax-forward-pending : i64
      (if (and
        (>= rax-var 0)
        (compiler-backend-rax-call-arg-eligible?
          ctx.type-segment-bases
          ctx.program-index
          rax-ty))
        rax-var
        -1)]
    [instr-diag : compiler_diagnostic.CompilerDiagnostic
      (be_state.compiler-backend-instr-diagnostic
        (be_state.compiler-backend-global-shared-view ctx.spans)
        ctx.source-function
        (be_state.compiler-backend-global-shared-view instr)
        (be_state.compiler-backend-global-shared-view ctx.func-diag))]
    ;; Sound-scavenger: reserve this instruction's operand + result homes so the
    ;; scavenge can never hand one back as scratch (LLVM RegScavenger model).
    [_reserved-mask : i64
      (begin
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          (compiler-backend-instr-reserved-home-mask
            ctx.function-state
            (be_state.compiler-backend-global-shared-view instr)))
        (compiler-backend-current-instr-reserved-mask ctx.function-state))]
    (match (be_state.compiler-backend-global-shared-view instr)
      [(Call dst name args ty)
        (if (compiler-backend-call-leading-arg-uses-var?
          (be_state.compiler-backend-global-shared-view args)
          rax-var)
          (let
            [rax-forward-result : be_state.ResultCompilerBackend
              (begin
                (be_state.compiler-backend-function-state-set-i64!
                  ctx.function-state
                  be_state.compiler-backend-function-i64-rax-forward-pending-var
                  rax-forward-pending)
                (be_calls.compiler-backend-emit-direct-call-with-arg-assignments
                  ctx.type-segment-bases
                  ctx.target-policy.target
                  ctx.function
                  ctx.current-label
                  (be_state.compiler-backend-function-state-emit-current-site
                    ctx.function-state)
                  dst
                  name
                  args
                  ty
                  ctx.assignments
                  ctx.assignments
                  ctx.types
                  ctx.global-types
                  ctx.plan
                  ctx.externs
                  ctx.program-index
                  ctx.vars
                  instr-diag
                  ctx.backend-state))]
            (be_state.compiler-backend-function-state-set-i64!
              ctx.function-state
              be_state.compiler-backend-function-i64-rax-forward-pending-var
              -1)
            rax-forward-result)
          (compiler-backend-emit-instr ctx fallthrough instr))]
      [(CallIndirect dst func args ty)
        (if (compiler-backend-call-leading-arg-uses-var?
          (be_state.compiler-backend-global-shared-view args)
          rax-var)
          (let
            [rax-forward-result : be_state.ResultCompilerBackend
              (begin
                (be_state.compiler-backend-function-state-set-i64!
                  ctx.function-state
                  be_state.compiler-backend-function-i64-rax-forward-pending-var
                  rax-forward-pending)
                (compiler-backend-emit-indirect-call-with-arg-assignments
                  ctx.type-segment-bases
                  ctx.target-policy.target
                  dst
                  func
                  args
                  ty
                  ctx.assignments
                  ctx.assignments
                  ctx.types
                  ctx.functions
                  ctx.externs
                  ctx.program-index
                  ctx.vars
                  instr-diag
                  ctx.backend-state))]
            (be_state.compiler-backend-function-state-set-i64!
              ctx.function-state
              be_state.compiler-backend-function-i64-rax-forward-pending-var
              -1)
            rax-forward-result)
          (compiler-backend-emit-instr ctx fallthrough instr))]
      [_ (compiler-backend-emit-instr ctx fallthrough instr)])))

(define (compiler-backend-call-rax-forwardable-instr?
  [type-segment-bases : i64]
  [instr : compiler_ir_types.CompilerIrInstr]
  [program-index : be_state.CompilerBackendProgramIndex]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]) : bool
  (and
    (compiler-backend-rax-call-arg-eligible?
      type-segment-bases
      program-index
      rax-ty)
    (match instr
      [(or (Call _ _ args _) (CallIndirect _ _ args _))
        (compiler-backend-call-leading-arg-uses-var? args rax-var)]
      [_ false])))

(define (compiler-backend-append-located-instr
  [buf : text_buf.TextBuf]
  [location : String]
  [head : String]
  [backend-state : be_state.CompilerBackendState]) : text_buf.TextBuf
  ;; A .loc/.cv_loc directive is metadata, not an instruction. Keep the
  ;; emergency save/restore pending until the executable head is appended.
  (text_buf.append
    (text_buf.append buf location)
    (be_scalar.compiler-backend-emergency-wrap head backend-state)))

(define (compiler-backend-emit-instrs-after-emitted
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [head : String]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  ;; A .loc/.cv_loc directive is metadata, not an instruction. Append it
  ;; plainly and keep the emergency save/restore pending until the
  ;; executable head goes in (mirrors compiler-backend-append-located-instr
  ;; for the buffer spine).
  (let
    [location : String
      (be_scalar.compiler-backend-debug-instr-location
        (be_state.compiler-backend-global-shared-view ctx)
        (be_state.compiler-backend-global-shared-view instr))]
    (if (> (string.string-length location) 0)
      (be_state.compiler-backend-asm-append out location)
      unit))
  (be_scalar.compiler-backend-emergency-append out head ctx.backend-state)
  (match instr
    [(or (Call dst _ _ ty) (CallIndirect dst _ _ ty) (CallIndirectC dst _ _ ty))
      (compiler-backend-emit-instrs-with-call-rax
        ctx
        fallthrough
        dst
        ty
        instrs
        index
        out)]
    [_ (compiler-backend-emit-instrs ctx fallthrough instrs index out)]))

(define (compiler-backend-emit-instrs-normal
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [head
      (try
        (compiler-backend-emit-instr
          (be_state.compiler-backend-global-shared-view ctx)
          (if (< index instrs.len)
            (No)
            fallthrough)
          (be_state.compiler-backend-global-shared-view instr)))]
    (compiler-backend-emit-instrs-after-emitted
      ctx
      fallthrough
      instr
      instrs
      index
      head
      out)))

(define (compiler-backend-emit-fused-result-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [result : be_state.ResultCompilerBackend]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [head (try result)]
    (be_state.compiler-backend-asm-append
      out
      (be_scalar.compiler-backend-emergency-wrap head ctx.backend-state))
    (compiler-backend-emit-instrs ctx fallthrough instrs index out)))

(define (compiler-backend-rax-forwardable-consumer?
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [rax-var : i64]
  [instr : (& compiler_ir_types.CompilerIrInstr)]) : bool
  (match instr
    [(BinOp _ op lhs rhs ty)
      (and
        (be_scalar.compiler-backend-rax-forwardable-binop?
          types
          global-types
          assignments
          op
          lhs
          rhs
          ty)
        (or
          (be_operand.compiler-backend-branch-uses-var? lhs rax-var)
          (and
            (be_operand.compiler-backend-branch-uses-var? rhs rax-var)
            (be_operand.compiler-backend-commutative-binop? op))))]
    [(Mov _ src _) (be_operand.compiler-backend-branch-uses-var? src rax-var)]
    [(Return maybe)
      (match maybe
        [(Some value)
          (be_operand.compiler-backend-branch-uses-var? value rax-var)]
        [(No) false])]
    [_ false]))

(define (compiler-backend-rest-starts-rax-forwardable-consumer?
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [rax-var : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (< index instrs.len)
    (let
      [instr (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)]
      (compiler-backend-rax-forwardable-consumer?
        types
        global-types
        assignments
        rax-var
        instr))
    false))

(define (compiler-backend-emit-instrs-materialize-rax
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (be_calls.compiler-backend-emit-store-typed-var-into
    out
    ctx.assignments
    rax-var
    "%rax"
    rax-ty
    ctx.backend-state)
  (compiler-backend-emit-instrs ctx fallthrough instrs index out))

(define (compiler-backend-emit-instrs-with-rax-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [instr (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [rest : i64 (+ index 1)]
      (match (be_state.compiler-backend-global-shared-view instr)
        [(BinOp dst op lhs rhs ty)
          (if (compiler-backend-rax-forwardable-consumer?
            ctx.types
            (be_state.compiler-backend-global-shared-view ctx.global-types)
            ctx.assignments
            rax-var
            instr)
            (let
              [keep-live : bool
                (be_simd.compiler-backend-var-single-use? ctx.use-counts dst)]
              [head
                (try
                  (be_scalar.compiler-backend-emit-binop-with-rax-value
                    ctx.type-segment-bases
                    ctx.types
                    (be_state.compiler-backend-global-shared-view
                      ctx.global-types)
                    ctx.assignments
                    rax-var
                    dst
                    op
                    lhs
                    rhs
                    (be_state.compiler-backend-global-shared-view ty)
                    (not keep-live)
                    ctx.backend-state))]
              (be_state.compiler-backend-asm-append
                out
                (be_scalar.compiler-backend-emergency-wrap
                  head
                  ctx.backend-state))
              (if keep-live
                (compiler-backend-emit-instrs-with-rax
                  ctx
                  fallthrough
                  dst
                  ty
                  instrs
                  rest
                  out)
                (compiler-backend-emit-instrs ctx fallthrough instrs rest out)))
            (compiler-backend-emit-instrs-materialize-rax
              ctx
              fallthrough
              rax-var
              rax-ty
              instrs
              index
              out))]
        [(Mov dst src ty)
          (if (be_operand.compiler-backend-branch-uses-var? src rax-var)
            (if (be_simd.compiler-backend-var-single-use? ctx.use-counts dst)
              (compiler-backend-emit-instrs-with-rax
                ctx
                fallthrough
                dst
                ty
                instrs
                rest
                out)
              (begin
                (be_calls.compiler-backend-emit-store-typed-var-into
                  out
                  ctx.assignments
                  dst
                  "%rax"
                  ty
                  ctx.backend-state)
                (compiler-backend-emit-instrs ctx fallthrough instrs rest out)))
            (compiler-backend-emit-instrs-materialize-rax
              ctx
              fallthrough
              rax-var
              rax-ty
              instrs
              index
              out))]
        [(Return maybe)
          (match maybe
            [(Some value)
              (if (and
                (be_operand.compiler-backend-branch-uses-var? value rax-var)
                (if (< rest instrs.len)
                  false
                  true))
                (begin
                  (be_state.compiler-backend-asm-append
                    out
                    (be_scalar.compiler-backend-return-tail
                      ctx.backend-state
                      ctx.source-function
                      ctx.assignments
                      ctx.vars
                      ctx.blocks))
                  (Ok ""))
                (compiler-backend-emit-instrs-materialize-rax
                  ctx
                  fallthrough
                  rax-var
                  rax-ty
                  instrs
                  index
                  out))]
            [(No)
              (compiler-backend-emit-instrs-materialize-rax
                ctx
                fallthrough
                rax-var
                rax-ty
                instrs
                index
                out)])]
        [_
          (compiler-backend-emit-instrs-materialize-rax
            ctx
            fallthrough
            rax-var
            rax-ty
            instrs
            index
            out)]))
    (begin
      (be_calls.compiler-backend-emit-store-typed-var-into
        out
        ctx.assignments
        rax-var
        "%rax"
        rax-ty
        ctx.backend-state)
      (Ok ""))))

(define (compiler-backend-emit-instrs-with-call-rax-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [instr (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [rest : i64 (+ index 1)]
      (if (compiler-backend-call-rax-forwardable-instr?
        ctx.type-segment-bases
        (be_state.compiler-backend-global-shared-view instr)
        ctx.program-index
        rax-var
        (be_state.compiler-backend-global-shared-view rax-ty))
        (let
          [head
            (try
              (compiler-backend-emit-instr-with-call-rax
                (be_state.compiler-backend-global-shared-view ctx)
                (if (< rest instrs.len)
                  (No)
                  fallthrough)
                (be_state.compiler-backend-global-shared-view instr)
                rax-var
                rax-ty))]
          (compiler-backend-emit-instrs-after-emitted
            ctx
            fallthrough
            instr
            instrs
            rest
            head
            out))
        (compiler-backend-emit-instrs ctx fallthrough instrs index out)))
    (Ok "")))

(define (compiler-backend-emit-fused-compare-branch-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [true-label : i64]
  [false-label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [operand-ty : compiler_ast_types.AstType
      (be_scalar.compiler-backend-binop-operand-ty
        ctx.types
        (be_state.compiler-backend-global-shared-view ctx.global-types)
        (be_state.compiler-backend-global-shared-view op)
        (be_state.compiler-backend-global-shared-view lhs)
        (be_state.compiler-backend-global-shared-view rhs)
        (be_state.compiler-backend-global-shared-view ty))]
    ;; Cross-edge flags carry: this comparison, the block's own first
    ;; instruction when `index` is 2, either spends the flags the
    ;; layout-previous block's tail branch left live or records its own for the
    ;; block that follows. The operand type is already here, so the decision
    ;; costs no extra aliasing.
    [carry : i64
      (compiler-backend-edge-flags-take
        ctx.function-state
        ctx.type-segment-bases
        ctx.current-label
        (- index 1)
        (& op)
        (& lhs)
        (& rhs)
        (& operand-ty))]
    (if (= carry 0)
      (begin
        (compiler-backend-edge-flags-record-tail!
          ctx.function-state
          ctx.type-segment-bases
          index
          instrs.len
          fallthrough
          true-label
          false-label
          (& op)
          (& lhs)
          (& rhs)
          (& operand-ty))
        (match (be_calls.compiler-backend-emit-compare-branch-with-phi-copies
          ctx.type-segment-bases
          ctx.assignments
          (be_state.compiler-backend-global-shared-view ctx.function)
          (be_state.compiler-backend-global-shared-view ctx.blocks)
          ctx.current-label
          (be_state.compiler-backend-global-shared-view op)
          (be_state.compiler-backend-global-shared-view lhs)
          (be_state.compiler-backend-global-shared-view rhs)
          operand-ty
          true-label
          false-label
          (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
          ctx.program-index
          ctx.vars)
          [(Ok head)
            (be_state.compiler-backend-asm-append
              out
              (be_scalar.compiler-backend-emergency-wrap head ctx.backend-state))
            (compiler-backend-emit-instrs
              (be_state.compiler-backend-global-shared-view ctx)
              fallthrough
              instrs
              index
              out)]
          [(Err message)
            (be_state.compiler-backend-instr-error-from
              (be_state.compiler-backend-instr-diagnostic
                ctx.spans
                ctx.source-function
                (BinOp dst op lhs rhs ty)
                ctx.func-diag)
              message)]))
      (let
        [carry-op : compiler_ir_types.CompilerIrBinOp
          (if (= carry 2)
            (be_operand.compiler-backend-compare-swapped-op op)
            op)]
        [true-jcc : String
          (be_scalar.compiler-backend-compare-true-jcc
            ctx.type-segment-bases
            (& carry-op)
            (& operand-ty))]
        [false-jcc : String
          (be_scalar.compiler-backend-compare-false-jcc
            ctx.type-segment-bases
            (& carry-op)
            (& operand-ty))]
        (compiler-backend-emit-flags-reuse-branch-rest
          ctx
          fallthrough
          (Var dst)
          true-label
          false-label
          true-jcc
          false-jcc
          instrs
          index
          out)))))

(define (compiler-backend-emit-fused-load-compare-branch-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [load-dst : i64]
  [ptr : compiler_ir_types.CompilerIrValue]
  [load-ty : compiler_ast_types.AstType]
  [_cmp-dst : i64]
  [op : (& compiler_ir_types.CompilerIrBinOp)]
  [rhs : (& compiler_ir_types.CompilerIrValue)]
  [_cmp-ty : (& compiler_ast_types.AstType)]
  [true-label : i64]
  [false-label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (match (be_calls.compiler-backend-emit-load-compare-branch-with-phi-copies
    ctx.type-segment-bases
    ctx.assignments
    (be_state.compiler-backend-global-shared-view ctx.function)
    (be_state.compiler-backend-global-shared-view ctx.blocks)
    ctx.current-label
    (be_state.compiler-backend-global-shared-view ptr)
    op
    rhs
    (be_state.compiler-backend-global-shared-view load-ty)
    true-label
    false-label
    (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
    ctx.program-index
    ctx.vars)
    [(Ok head)
      (be_state.compiler-backend-asm-append
        out
        (be_scalar.compiler-backend-emergency-wrap head ctx.backend-state))
      (compiler-backend-emit-instrs ctx fallthrough instrs index out)]
    [(Err message)
      (be_state.compiler-backend-instr-error-from
        (be_state.compiler-backend-instr-diagnostic
          ctx.spans
          ctx.source-function
          (Load load-dst ptr load-ty)
          ctx.func-diag)
        message)]))

(define (compiler-backend-emit-fused-not-branch-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [true-label : i64]
  [false-label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  ;; `not src` branches to its false successor when src is true. Emit the
  ;; source branch directly with reversed successors, including the matching
  ;; phi-edge copies, instead of materializing the inverted boolean.
  (match (be_calls.compiler-backend-emit-branch-with-phi-copies
    ctx.type-segment-bases
    ctx.assignments
    (be_state.compiler-backend-global-shared-view ctx.function)
    (be_state.compiler-backend-global-shared-view ctx.blocks)
    ctx.current-label
    (be_state.compiler-backend-global-shared-view src)
    false-label
    true-label
    (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
    ctx.program-index
    ctx.vars
    ""
    "")
    [(Ok head)
      (be_state.compiler-backend-asm-append
        out
        (be_scalar.compiler-backend-emergency-wrap head ctx.backend-state))
      (compiler-backend-emit-instrs ctx fallthrough instrs index out)]
    [(Err message)
      (be_state.compiler-backend-instr-error-from
        (be_state.compiler-backend-instr-diagnostic
          ctx.spans
          ctx.source-function
          (UnOp dst (Not) src ty)
          ctx.func-diag)
        message)]))

(define (compiler-backend-emit-fused-gep-load-compare-branch-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [gep-dst : i64]
  ;; GAP9: the fused compare consumes this gep's ordinal at the dispatch
  ;; site; the path is const-offset-only so the displacement is always 0.
  [_gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [_load-dst : i64]
  [load-ty : (& compiler_ast_types.AstType)]
  [_cmp-dst : i64]
  [op : (& compiler_ir_types.CompilerIrBinOp)]
  [rhs : (& compiler_ir_types.CompilerIrValue)]
  [_cmp-ty : (& compiler_ast_types.AstType)]
  [true-label : i64]
  [false-label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (match (be_calls.compiler-backend-emit-gep-load-compare-branch-with-phi-copies
    ctx.type-segment-bases
    ctx.assignments
    (be_state.compiler-backend-global-shared-view ctx.function)
    (be_state.compiler-backend-global-shared-view ctx.blocks)
    ctx.current-label
    (be_state.compiler-backend-global-shared-view base)
    (be_state.compiler-backend-global-shared-view offset)
    (be_state.compiler-backend-global-shared-view elem-ty)
    op
    rhs
    load-ty
    true-label
    false-label
    (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
    ctx.program-index
    ctx.vars
    ;; The comparison result is not materialized in this fusion, so its
    ;; primary scalar slot is the RHS staging home. The address base above is
    ;; owned by the Gep site; these are deliberately different IR points.
    )
    [(Ok head)
      (be_state.compiler-backend-asm-append
        out
        (be_scalar.compiler-backend-emergency-wrap head ctx.backend-state))
      (compiler-backend-emit-instrs ctx fallthrough instrs index out)]
    [(Err message)
      (be_state.compiler-backend-instr-error-from
        (be_state.compiler-backend-instr-diagnostic
          ctx.spans
          ctx.source-function
          (Gep gep-dst base offset elem-ty)
          ctx.func-diag)
        message)]))

;; GAP8: fold a single-use fused-load result straight into the consuming ALU
;; op's memory operand -- `movq (b,i,8), %t; addq %t, %acc` becomes
;; `addq (b,i,8), %acc` -- one instruction and one register shorter, exactly
;; clang's selection for reduction loops. The probe is PURE (no scavenges, so
;; a rejected fold leaks no emergency-pending registers -- the M-D lesson);
;; the emitter mirrors emit-load-from-gep's two addressing arms and appends
;; the ALU line instead of the load. The non-loaded operand lands in the ALU
;; dst's home FIRST, so the probe rejects any dst-home that aliases an
;; address operand home, and every scavenge excludes dst-home.
(defenum CompilerBackendGepLoadAluFold
  (No)
  (Some String i64 compiler_ir_types.CompilerIrValue i64))

;; Two adjacent fused loads followed by a commutative ALU op can use the same
;; two-instruction shape as clang: load one memory operand straight into the
;; result home, then consume the other as the ALU memory operand. Keep this
;; direct-only (all address components and the result already register-homed),
;; so rejecting the fold has no scavenge or emergency-save side effects.
(defenum CompilerBackendGepLoadPairAluFold
  (No)
  (Some String i64 String String i64))

(define (compiler-backend-gep-load-pair-alu-mnemonic
  [op : (& compiler_ir_types.CompilerIrBinOp)]) : String
  (match op
    [(Add) "add"]
    [(Mul) "imul"]
    [(BitAnd) "and"]
    [(BitOr) "or"]
    [(BitXor) "xor"]
    [_ ""]))

(define (compiler-backend-gep-load-pair-alu-probe
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [use-counts : (& use-counts (__tl_dyn-array i64))]
  [base : compiler_ir_types.CompilerIrValue]
  [offset0 : compiler_ir_types.CompilerIrValue]
  [elem-ty0 : compiler_ast_types.AstType]
  [gep-disp0 : i64]
  [load-dst0 : i64]
  [load-ty0 : compiler_ast_types.AstType]
  [offset1 : (& compiler_ir_types.CompilerIrValue)]
  [elem-ty1 : (& compiler_ast_types.AstType)]
  [gep-disp1 : i64]
  [load-dst1 : i64]
  [load-ty1 : (& compiler_ast_types.AstType)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadPairAluFold
  (if (< index instrs.len)
    (let
      [maybe-binop
        (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)]
      [after-binop : i64 (+ index 1)]
      (match maybe-binop
        [(BinOp dst op lhs rhs ty)
          (let
            [mnem : String (compiler-backend-gep-load-pair-alu-mnemonic op)]
            [dst-home : String
              (be_scalar.compiler-backend-var-register-home
                backend-state
                assignments
                dst)]
            [base-home : String
              (be_scalar.compiler-backend-address-base-filter
                (be_operand.compiler-backend-value-scalar-register
                  backend-state
                  assignments
                  base))]
            [index0-home : String
              (be_operand.compiler-backend-value-scalar-register
                backend-state
                assignments
                offset0)]
            [index1-home : String
              (be_operand.compiler-backend-value-scalar-register
                backend-state
                assignments
                offset1)]
            [scale0 : i64
              (be_operand.compiler-backend-type-size
                type-segment-bases
                elem-ty0)]
            [scale1 : i64
              (be_operand.compiler-backend-type-size
                type-segment-bases
                elem-ty1)]
            [addr0 : String
              (if (and
                (not (string.eq base-home ""))
                (not (string.eq index0-home "")))
                (be_scalar.compiler-backend-gep-index-address-disp
                  gep-disp0
                  base-home
                  scale0
                  index0-home)
                "")]
            [addr1 : String
              (if (and
                (not (string.eq base-home ""))
                (not (string.eq index1-home "")))
                (be_scalar.compiler-backend-gep-index-address-disp
                  gep-disp1
                  base-home
                  scale1
                  index1-home)
                "")]
            (if (and
              (not (string.eq mnem ""))
              (=
                (be_operand.compiler-backend-type-size
                  type-segment-bases
                  load-ty0)
                8)
              (=
                (be_operand.compiler-backend-type-size
                  type-segment-bases
                  load-ty1)
                8)
              (=
                (be_operand.compiler-backend-type-size type-segment-bases ty)
                8)
              (not (be_operand.compiler-backend-float-type? load-ty0))
              (not (be_operand.compiler-backend-float-type? load-ty1))
              (not
                (be_scalar.compiler-backend-binop-f64?
                  types
                  global-types
                  lhs
                  rhs
                  ty))
              (be_simd.compiler-backend-var-single-use? use-counts load-dst0)
              (be_simd.compiler-backend-var-single-use? use-counts load-dst1)
              (or
                (and
                  (be_operand.compiler-backend-branch-uses-var? lhs load-dst0)
                  (be_operand.compiler-backend-branch-uses-var? rhs load-dst1))
                (and
                  (be_operand.compiler-backend-branch-uses-var? lhs load-dst1)
                  (be_operand.compiler-backend-branch-uses-var? rhs load-dst0)))
              (not (string.eq dst-home ""))
              (not (string.eq addr0 ""))
              (not (string.eq addr1 ""))
              (not (string.eq dst-home base-home))
              (not (string.eq dst-home index0-home))
              (not (string.eq dst-home index1-home)))
              (Some mnem dst addr0 addr1 after-binop)
              (No)))]
        [_ (No)]))
    (No)))

;; R4-C wrapper: bracket the reordering family with the pair-emission flag,
;; restoring the caller's value so a nested pair keeps the outer one flagged.
(define (compiler-backend-emit-gep-load-pair-alu
  [backend-state : be_state.CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [mnem : String]
  [dst : i64]
  [addr0 : String]
  [addr1 : String]) : be_state.ResultCompilerBackend
  (be_scalar.compiler-backend-with-pair-emission
    (be_state.compiler-backend-state-function-state backend-state)
    (let
      [dst-home : String
        (be_scalar.compiler-backend-var-register-home
          backend-state
          assignments
          dst)]
      (be_state.ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    movq "
          addr0
          ", "
          dst-home
          "\n    "
          mnem
          "q "
          addr1
          ", "
          dst-home
          "\n")))))

(defenum CompilerBackendMaybeGepLoadPairAluDivmodEmission
  (No)
  (Some be_state.ResultCompilerBackend))

(defenum CompilerBackendMaybeGepLoadPairAluDivmodStore
  (No)
  (Some
    i64
    compiler_ir_types.CompilerIrValue
    compiler_ir_types.CompilerIrValue
    compiler_ast_types.AstType
    compiler_ir_types.CompilerIrValue
    compiler_ast_types.AstType
    i64))

(define (compiler-backend-gep-load-pair-alu-divmod-store-probe
  [ctx : be_state.CompilerBackendEmissionContext]
  [div-dst : i64]
  [src : (& src str)]
  [magic : String]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeGepLoadPairAluDivmodStore
  (if (be_simd.compiler-backend-var-single-use? ctx.use-counts div-dst)
    (if (< index instrs.len)
      (let
        [maybe-gep (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
        [after-gep : i64 (+ index 1)]
        (match maybe-gep
          [(Gep gep-dst base offset elem-ty)
            (if (be_simd.compiler-backend-var-single-use?
              ctx.use-counts
              gep-dst)
              (if (< after-gep instrs.len)
                (let
                  [maybe-store
                    (compiler_ir_types.compiler-ir-instr-seq-ref
                      instrs
                      after-gep)]
                  [after-store : i64 (+ after-gep 1)]
                  (match maybe-store
                    [(StorePtr store-ptr store-value store-ty)
                      (if (and
                        (compiler-backend-divmod-direct-gep-store?
                          ctx.backend-state
                          ctx.type-segment-bases
                          ctx.assignments
                          div-dst
                          gep-dst
                          base
                          offset
                          elem-ty
                          store-ptr
                          store-value)
                        (compiler-backend-divmod-direct-gep-store-clobber-safe?
                          ctx.backend-state
                          ctx.assignments
                          src
                          magic
                          base
                          offset))
                        (Some
                          gep-dst
                          base
                          offset
                          elem-ty
                          store-value
                          store-ty
                          after-store)
                        (No))]
                    [_ (No)]))
                (No))
              (No))]
          [_ (No)]))
      (No))
    (No)))

;; R4-C wrapper: bracket the reordering family with the pair-emission flag,
;; restoring the caller's value so a nested pair keeps the outer one flagged.
(define (compiler-backend-emit-gep-load-pair-alu-divmod-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [mnem : String]
  [alu-dst : i64]
  [addr0 : String]
  [addr1 : String]
  [base : compiler_ir_types.CompilerIrValue]
  [offset0 : compiler_ir_types.CompilerIrValue]
  [offset1 : (& compiler_ir_types.CompilerIrValue)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepLoadPairAluDivmodEmission
  (let
    [function-state : be_state.CompilerBackendFunctionState ctx.function-state]
    [prev : bool
      (be_state.compiler-backend-function-scratch-bool?
        function-state
        be_state.compiler-backend-scratch-bool-pair-emission)]
    [_on : unit
      (be_state.compiler-backend-function-scratch-set-bool!
        function-state
        be_state.compiler-backend-scratch-bool-pair-emission
        true)]
    [result : CompilerBackendMaybeGepLoadPairAluDivmodEmission
      (compiler-backend-emit-gep-load-pair-alu-divmod-rest-unflagged
        ctx
        fallthrough
        mnem
        alu-dst
        addr0
        addr1
        base
        offset0
        offset1
        instrs
        index
        out)]
    [_off : unit
      (be_state.compiler-backend-function-scratch-set-bool!
        function-state
        be_state.compiler-backend-scratch-bool-pair-emission
        prev)]
    result))

(define (compiler-backend-emit-gep-load-pair-alu-divmod-rest-unflagged
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [mnem : String]
  [alu-dst : i64]
  [addr0 : String]
  [addr1 : String]
  [base : compiler_ir_types.CompilerIrValue]
  [offset0 : compiler_ir_types.CompilerIrValue]
  [offset1 : (& compiler_ir_types.CompilerIrValue)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepLoadPairAluDivmodEmission
  ;; Divmod polish normally retargets a one-use arithmetic producer into the
  ;; preserved-dividend register. A load-pair fold consumes that producer
  ;; first, so retain the same steering here instead of reintroducing a hot
  ;; producer-home -> dividend-home copy before the magic-mod sequence.
  (if (< index instrs.len)
    (let
      [div-instr (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [after-div : i64 (+ index 1)]
      (match (be_state.compiler-backend-global-shared-view div-instr)
        [(BinOp div-dst div-op div-lhs div-rhs div-ty)
          (let
            [magic : String
              (compiler-backend-divmod-polish-magic-ahead
                (be_state.compiler-backend-global-shared-view ctx)
                (be_state.compiler-backend-global-shared-view div-instr)
                div-dst
                (be_state.compiler-backend-global-shared-view div-op)
                (be_state.compiler-backend-global-shared-view div-rhs)
                (be_state.compiler-backend-global-shared-view div-ty)
                5)]
            [hoist-reg : String
              (compiler-backend-divmod-polish-hoist-reg-ahead
                (be_state.compiler-backend-global-shared-view ctx)
                (be_state.compiler-backend-global-shared-view div-instr)
                5)]
            [src : String
              (compiler-backend-divmod-polish-src
                (be_state.compiler-backend-global-shared-view ctx)
                div-dst
                (be_state.compiler-backend-global-shared-view div-lhs)
                (be_state.compiler-backend-global-shared-view magic)
                hoist-reg
                false
                (be_scalar.compiler-backend-binop-wants-remainder? div-op)
                alu-dst)]
            [div-dst-home : String
              (be_scalar.compiler-backend-var-register-home
                ctx.backend-state
                ctx.assignments
                div-dst)]
            [direct-store : CompilerBackendMaybeGepLoadPairAluDivmodStore
              (compiler-backend-gep-load-pair-alu-divmod-store-probe
                (be_state.compiler-backend-global-shared-view ctx)
                div-dst
                src
                magic
                (be_state.compiler-backend-global-shared-view instrs)
                after-div)]
            [base-home : String
              (be_operand.compiler-backend-value-scalar-register
                ctx.backend-state
                ctx.assignments
                base)]
            [index0-home : String
              (be_operand.compiler-backend-value-scalar-register
                ctx.backend-state
                ctx.assignments
                offset0)]
            [index1-home : String
              (be_operand.compiler-backend-value-scalar-register
                ctx.backend-state
                ctx.assignments
                offset1)]
            (if (and
              (be_simd.compiler-backend-var-single-use? ctx.use-counts alu-dst)
              (be_operand.compiler-backend-branch-uses-var? div-lhs alu-dst)
              (be_scalar.compiler-backend-signed-literal-divmod-src-shape?
                ctx.type-segment-bases
                div-op
                div-rhs
                div-ty)
              (be_scalar.compiler-backend-divmod-src-register? src)
              (or
                (not (string.eq div-dst-home ""))
                (match (& direct-store)
                  [(Some _ _ _ _ _ _ _) true]
                  [(No) false]))
              (not (string.eq src base-home))
              (not (string.eq src index0-home))
              (not (string.eq src index1-home)))
              (let
                [saved-count : i64
                  (be_state.compiler-backend-function-state-emit-current-count
                    ctx.function-state)]
                [saved-reserved : i64
                  (compiler-backend-current-instr-reserved-mask
                    ctx.function-state)]
                [saved0-var : i64
                  (be_state.compiler-backend-function-state-i64
                    ctx.function-state
                    be_state.compiler-backend-function-i64-home-override0-var)]
                [saved0-reg : i64
                  (be_state.compiler-backend-function-state-i64
                    ctx.function-state
                    be_state.compiler-backend-function-i64-home-override0-reg)]
                [saved1-var : i64
                  (be_state.compiler-backend-function-state-i64
                    ctx.function-state
                    be_state.compiler-backend-function-i64-home-override1-var)]
                [saved1-reg : i64
                  (be_state.compiler-backend-function-state-i64
                    ctx.function-state
                    be_state.compiler-backend-function-i64-home-override1-reg)]
                [continuation : i64 after-div]
                [emitted : be_state.ResultCompilerBackend
                  (begin
                    ;; The dividend register was selected speculatively
                    ;; while probing this fusion. Admission has now committed,
                    ;; so arm its live-through preservation around the complete
                    ;; Gep/load/ALU/divmod bundle before the producer writes it.
                    (compiler-backend-divmod-overrides-install-spellings!
                      ctx.function-state
                      alu-dst
                      (be_state.compiler-backend-global-shared-view src)
                      (match (& direct-store)
                        [(Some _ _ _ _ _ _ _) div-dst]
                        [(No) -1])
                      (match (& direct-store)
                        [(Some _ _ _ _ _ _ _) src]
                        [(No) ""]))
                    ;; The fused bundle starts at Gep0; div-instr is five IR
                    ;; instructions later (Load0, Gep1, Load1, producer).
                    (be_state.compiler-backend-function-state-set-emit-current-count!
                      ctx.function-state
                      (- saved-count 5))
                    (compiler-backend-set-current-instr-reserved-mask!
                      ctx.function-state
                      (compiler-backend-instr-reserved-home-mask
                        ctx.function-state
                        (be_state.compiler-backend-global-shared-view div-instr)))
                    (match (compiler-backend-emit-gep-load-pair-alu
                      ctx.backend-state
                      ctx.assignments
                      mnem
                      alu-dst
                      addr0
                      addr1)
                      [(Ok pair-asm)
                        (match (compiler-backend-emit-instr
                          (be_state.compiler-backend-global-shared-view ctx)
                          (No)
                          div-instr)
                          [(Ok div-asm)
                            (match direct-store
                              [(Some
                                gep-dst
                                store-base
                                store-offset
                                store-elem-ty
                                store-value
                                store-ty
                                after-store)
                                (be_state.compiler-backend-function-state-set-emit-current-count!
                                  ctx.function-state
                                  (- saved-count 6))
                                (match (compiler-backend-emit-divmod-direct-gep-store
                                  (be_state.compiler-backend-global-shared-view
                                    ctx)
                                  gep-dst
                                  store-base
                                  store-offset
                                  store-elem-ty
                                  store-value
                                  store-ty)
                                  [(Ok store-asm)
                                    (set! continuation after-store)
                                    (Ok
                                      (str_cat.str-cat
                                        pair-asm
                                        div-asm
                                        store-asm))]
                                  [(Err message) (Err message)])]
                              [(No) (Ok (str_cat.str-cat pair-asm div-asm))])]
                          [(Err message) (Err message)])]
                      [(Err message) (Err message)]))]
                [_restore : unit
                  (begin
                    (be_state.compiler-backend-function-state-set-emit-current-count!
                      ctx.function-state
                      saved-count)
                    (compiler-backend-set-current-instr-reserved-mask!
                      ctx.function-state
                      saved-reserved)
                    (compiler-backend-divmod-overrides-install!
                      ctx.function-state
                      saved0-var
                      saved0-reg
                      saved1-var
                      saved1-reg))]
                (Some
                  (compiler-backend-emit-fused-result-rest
                    ctx
                    fallthrough
                    emitted
                    instrs
                    continuation
                    out)))
              (No)))]
        [_ (No)]))
    (No)))

(defenum CompilerBackendMaybeGepLoadPairAluEmission
  (No)
  (Some be_state.ResultCompilerBackend))

(define (compiler-backend-emit-dynamic-gep-load-pair-alu-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepLoadPairAluEmission
  ;; The existing general pair path owns constant field offsets. This narrow
  ;; sibling admits only two dynamic indexed loads followed immediately by the
  ;; commutative ALU consumer, the stack-binary-op shape in vm-run.
  (match (be_operand.compiler-backend-value-as-i64 offset)
    [(Some _) (No)]
    [(None)
      (if (< index instrs.len)
        (let
          [maybe-gep (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
          [after-gep : i64 (+ index 1)]
          (match maybe-gep
            [(Gep gep-dst2 base2 offset2 elem-ty2)
              (if (and
                (be_simd.compiler-backend-var-single-use?
                  ctx.use-counts
                  gep-dst2)
                (compiler_optimize.opt-value-eq (& base2) (& base)))
                (match (be_operand.compiler-backend-value-as-i64 offset2)
                  [(Some _) (No)]
                  [(None)
                    (if (< after-gep instrs.len)
                      (let
                        [maybe-load
                          (compiler_ir_types.compiler-ir-instr-seq-ref
                            instrs
                            after-gep)]
                        [after-load2 : i64 (+ after-gep 1)]
                        (match maybe-load
                          [(Load load-dst2 src2 load-ty2)
                            (if (be_operand.compiler-backend-branch-uses-var?
                              src2
                              gep-dst2)
                              ;; Probe with zero before mutating the GAP9 cursor.
                              ;; A displacement changes only the spelling of an
                              ;; already-valid SIB operand, never admission.
                              (match (compiler-backend-gep-load-pair-alu-probe
                                ctx.backend-state
                                ctx.type-segment-bases
                                ctx.assignments
                                ctx.types
                                (be_state.compiler-backend-global-shared-view
                                  ctx.global-types)
                                ctx.use-counts
                                (be_state.compiler-backend-global-shared-view
                                  base)
                                (be_state.compiler-backend-global-shared-view
                                  offset)
                                (be_state.compiler-backend-global-shared-view
                                  elem-ty)
                                gep-fold-disp
                                load-dst
                                (be_state.compiler-backend-global-shared-view
                                  load-ty)
                                offset2
                                elem-ty2
                                0
                                load-dst2
                                load-ty2
                                (be_state.compiler-backend-global-shared-view
                                  instrs)
                                after-load2)
                                [(Some _ _ _ _ _)
                                  (let
                                    [gep-fold-disp2 : i64
                                      (compiler-backend-gep-fold-next!
                                        ctx.function-state
                                        ctx.type-segment-bases
                                        offset2
                                        elem-ty2)]
                                    (match (compiler-backend-gep-load-pair-alu-probe
                                      ctx.backend-state
                                      ctx.type-segment-bases
                                      ctx.assignments
                                      ctx.types
                                      (be_state.compiler-backend-global-shared-view
                                        ctx.global-types)
                                      ctx.use-counts
                                      (be_state.compiler-backend-global-shared-view
                                        base)
                                      (be_state.compiler-backend-global-shared-view
                                        offset)
                                      elem-ty
                                      gep-fold-disp
                                      load-dst
                                      load-ty
                                      offset2
                                      elem-ty2
                                      gep-fold-disp2
                                      load-dst2
                                      load-ty2
                                      (be_state.compiler-backend-global-shared-view
                                        instrs)
                                      after-load2)
                                      [(Some
                                          mnem
                                          alu-dst
                                          addr0
                                          addr1
                                          after-binop)
                                        (match (compiler-backend-emit-gep-load-pair-alu-divmod-rest
                                          (be_state.compiler-backend-global-shared-view
                                            ctx)
                                          fallthrough
                                          (be_state.compiler-backend-global-shared-view
                                            mnem)
                                          alu-dst
                                          (be_state.compiler-backend-global-shared-view
                                            addr0)
                                          (be_state.compiler-backend-global-shared-view
                                            addr1)
                                          base
                                          offset
                                          offset2
                                          (be_state.compiler-backend-global-shared-view
                                            instrs)
                                          after-binop
                                          out)
                                          [(Some result) (Some result)]
                                          [(No)
                                            (Some
                                              (compiler-backend-emit-fused-result-rest
                                                (be_state.compiler-backend-global-shared-view
                                                  ctx)
                                                fallthrough
                                                (compiler-backend-emit-gep-load-pair-alu
                                                  ctx.backend-state
                                                  ctx.assignments
                                                  mnem
                                                  alu-dst
                                                  addr0
                                                  addr1)
                                                instrs
                                                after-binop
                                                out))])]
                                      [(No)
                                        ;; The zero-displacement probe above
                                        ;; admitted this exact shape.
                                        (No)]))]
                                [(No) (No)])
                              (No))]
                          [_ (No)]))
                      (No))])
                (No))]
            [_ (No)]))
        (No))]))

;; Two-operand memory-form mnemonics only; Mul is excluded (imul mem needs
;; the two-operand register form and folds worse than the fused load).
(define (compiler-backend-gep-load-alu-mnemonic
  [op : (& op compiler_ir_types.CompilerIrBinOp)]) : String
  (match op
    [(Add) "add"]
    [(Sub) "sub"]
    [(BitAnd) "and"]
    [(BitOr) "or"]
    [(BitXor) "xor"]
    [_ ""]))

(define (compiler-backend-gep-load-alu-probe
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [use-counts : (& use-counts (__tl_dyn-array i64))]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadAluFold
  (if (or
    (be_operand.compiler-backend-float-type? load-ty)
    (not
      (= (be_operand.compiler-backend-type-size type-segment-bases load-ty) 8))
    (not (be_simd.compiler-backend-var-single-use? use-counts load-dst)))
    (No)
    (if (< index instrs.len)
      (let
        [maybe-binop (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
        [after-binop : i64 (+ index 1)]
        (match maybe-binop
          [(BinOp dst op lhs rhs ty)
            (let
              [mnem : String (compiler-backend-gep-load-alu-mnemonic op)]
              ;; GAP8-B: the loaded value on the RHS is the shape the two-address
              ;; lowering hands over directly -- `dst := lhs; dst op= rhs` puts
              ;; the memory operand in the ALU's source slot. A COMMUTATIVE op
              ;; folds the mirrored shape just as soundly: `dst = MEM op x` is
              ;; `dst = x op MEM`, so the non-loaded operand lands in dst's home
              ;; first and the fold reads memory from the other side. Sub is
              ;; excluded by construction -- compiler-backend-commutative-binop?
              ;; refuses it -- because `MEM - x` is not `x - MEM`.
              [mem-is-rhs? : bool
                (and
                  (be_operand.compiler-backend-branch-uses-var? rhs load-dst)
                  (not
                    (be_operand.compiler-backend-branch-uses-var? lhs load-dst)))]
              [mem-is-lhs? : bool
                (and
                  (be_operand.compiler-backend-commutative-binop? op)
                  (be_operand.compiler-backend-branch-uses-var? lhs load-dst)
                  (not
                    (be_operand.compiler-backend-branch-uses-var? rhs load-dst)))]
              ;; The operand that is NOT the folded load; it is staged into the
              ;; ALU destination's home before the memory operand is consumed.
              [x : compiler_ir_types.CompilerIrValue
                (if mem-is-rhs?
                  (owned_view.compiler-owned-shared-view lhs)
                  (owned_view.compiler-owned-shared-view rhs))]
              [dst-home : String
                (be_scalar.compiler-backend-var-register-home
                  backend-state
                  assignments
                  dst)]
              [base-home : String
                (be_operand.compiler-backend-value-scalar-register
                  backend-state
                  assignments
                  base)]
              [offset-home : String
                (be_operand.compiler-backend-value-scalar-register
                  backend-state
                  assignments
                  offset)]
              (if (and
                (not (string.eq mnem ""))
                (or mem-is-rhs? mem-is-lhs?)
                (not
                  (be_scalar.compiler-backend-binop-f64?
                    types
                    (be_state.compiler-backend-global-shared-view global-types)
                    lhs
                    rhs
                    ty))
                (=
                  (let
                    [ty-arg
                      (be_scalar.compiler-backend-binop-operand-ty
                        types
                        global-types
                        op
                        lhs
                        rhs
                        ty)]
                    (be_operand.compiler-backend-type-size
                      type-segment-bases
                      ty-arg))
                  8)
                (not (string.eq dst-home ""))
                (not (string.eq dst-home base-home))
                (not (string.eq dst-home offset-home)))
                (Some mnem dst x after-binop)
                (No)))]
          [_ (No)]))
      (No))))

;; The dynamic-index register pool mirror of scavenge-exclude-regs2, extended
;; with the ALU destination home.
;; The dynamic-index register pool mirror of scavenge-exclude-regs2, extended
;; with the ALU destination and non-loaded operand homes.
(define (compiler-backend-gep-load-alu-index-exclude
  [base-reg : String]
  [offset-home : String]
  [dst-home : String]
  [x-home : String]) : (__tl_dyn-array String)
  (__tl_make-array
    "%rax"
    "%rdx"
    "%rcx"
    (be_state.compiler-backend-global-shared-view base-reg)
    (if (string.eq offset-home "")
      base-reg
      offset-home)
    dst-home
    x-home))

(define (compiler-backend-emit-gep-load-alu
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [mnem : String]
  [alu-dst : i64]
  [x : compiler_ir_types.CompilerIrValue]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [gep-disp : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [scale : i64
      (be_operand.compiler-backend-type-size type-segment-bases elem-ty)]
    [displacement : option_i64.Option
      (be_scalar.compiler-backend-disp32-displacement offset scale gep-disp)]
    [dst-home : String
      (be_scalar.compiler-backend-var-register-home
        backend-state
        assignments
        alu-dst)]
    ;; #9976: `x` is read into dst-home AFTER the address is staged, so every
    ;; scavenge also excludes x's home -- an emergency-borrowed register is
    ;; preserved across the bracketed text but not during it (the
    ;; compiler-backend-scavenge-emergency-cand-index soundness rule).
    [x-home : String
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        x)]
    (match displacement
      [(Some disp)
        (let
          ;; gep-disp is 0 here in practice (only Var-index geps carry a
          ;; folded displacement); merged for totality.
          [base-home : String
            (be_facts.compiler-backend-address-base-filter-direct
              (be_operand.compiler-backend-value-scalar-register
                backend-state
                assignments
                base))]
          [base-reg : String
            (if (string.eq base-home "")
              (be_operand.compiler-backend-scavenge-reg
                alu-dst
                (be_operand.compiler-backend-two-exclude
                  (be_state.compiler-backend-global-shared-view dst-home)
                  x-home)
                2
                "%r10"
                backend-state)
              base-home)]
          [addr : String
            (be_scalar.compiler-backend-base-address
              disp
              (be_state.compiler-backend-global-shared-view base-reg))]
          [base-asm
            (try
              (be_operand.compiler-backend-emit-load-value
                assignments
                base
                base-reg
                backend-state))]
          [x-asm
            (try
              (be_operand.compiler-backend-emit-load-value
                assignments
                x
                (be_state.compiler-backend-global-shared-view dst-home)
                backend-state))]
          (Ok
            (str_cat.str-cat
              base-asm
              x-asm
              (str_cat.str-cat "    " mnem "q " addr ", " dst-home "\n"))))]
      [(None)
        (let
          [sib-scale? : bool (be_scalar.compiler-backend-gep-sib-scale? scale)]
          [base-home : String
            (be_scalar.compiler-backend-address-base-filter
              (be_operand.compiler-backend-value-scalar-register
                backend-state
                assignments
                base))]
          [offset-home : String
            (be_operand.compiler-backend-value-scalar-register
              backend-state
              assignments
              offset)]
          [use-base-home? : bool
            (and sib-scale? (not (string.eq base-home "")))]
          [base-reg : String
            (if use-base-home?
              base-home
              (be_operand.compiler-backend-scavenge-reg
                alu-dst
                (be_operand.compiler-backend-three-exclude
                  (be_state.compiler-backend-global-shared-view offset-home)
                  (be_state.compiler-backend-global-shared-view dst-home)
                  (string.copy (& x-home)))
                3
                "%r10"
                backend-state))]
          [use-offset-home? : bool
            (and
              sib-scale?
              (not (string.eq offset-home ""))
              (not (string.eq offset-home base-reg)))]
          [index-reg : String
            (if use-offset-home?
              offset-home
              (be_operand.compiler-backend-scavenge-reg
                alu-dst
                (compiler-backend-gep-load-alu-index-exclude
                  (be_state.compiler-backend-global-shared-view base-reg)
                  offset-home
                  (be_state.compiler-backend-global-shared-view dst-home)
                  x-home)
                7
                "%r8"
                backend-state))]
          [addr : String
            (be_scalar.compiler-backend-gep-index-address-disp
              gep-disp
              base-reg
              scale
              index-reg)]
          [addr-asm : String
            (if (string.eq addr "")
              (be_scalar.compiler-backend-gep-index-base-asm-disp
                gep-disp
                base-reg
                scale
                index-reg)
              "")]
          [load-addr : String
            (if (string.eq addr "")
              (str_cat.str-cat "(" base-reg ")" "")
              addr)]
          [base-asm
            (try
              (if use-base-home?
                (be_state.ResultCompilerBackend.Ok "")
                (be_operand.compiler-backend-emit-load-value
                  assignments
                  base
                  base-reg
                  backend-state)))]
          [offset-asm
            (try
              (if use-offset-home?
                (be_state.ResultCompilerBackend.Ok "")
                (be_operand.compiler-backend-emit-load-value
                  assignments
                  offset
                  index-reg
                  backend-state)))]
          [x-asm
            (try
              (be_operand.compiler-backend-emit-load-value
                assignments
                x
                (be_state.compiler-backend-global-shared-view dst-home)
                backend-state))]
          (Ok
            (str_cat.str-cat
              base-asm
              offset-asm
              addr-asm
              x-asm
              (str_cat.str-cat "    " mnem "q " load-addr ", " dst-home "\n"))))])))

;; --------------------------------------------------------------------------
;; M6: fold a single-use load into the comparing instruction's memory operand.
;;
;; TL emitted the load and the compare separately -- `movq 8(%rax), %rdi ;
;; cmpq %rdi, %rsi` -- where C folds the load into the compare's memory
;; operand: `cmpq 8(%rax), %rsi`, one instruction and one live register fewer.
;; GAP9 already folds the CONST-offset gep+load whose value is the compare's
;; LHS and whose compare feeds a branch. The M6 shapes below are the rest of
;; that family, reached through the same gep fusion cluster:
;;
;;   M6-A  the LENGTH operand of an immediately following bounds check
;;         (`movq 8(%rax),%rdi ; cmpq %rdi,%rsi ; jb ok` -> `cmpq 8(%rax),%rsi ;
;;         jb ok`), including the dynamic SIB-index address GAP9 declines.
;;   M6-B  a compare+branch with the loaded value on EITHER side, and the
;;         dynamic SIB-index address, which GAP9 declines on both counts.
;;   M6-C  a NARROW (byte/word/long) load whose widening cast feeds an equality
;;         compare: `movzbq (%r9,%rsi,1),%rsi ; cmpq $46,%rsi` -> `cmpb $46,
;;         (%r9,%rsi,1)`.
;;
;; Every M6 probe is PURE: it only spells an address out of register homes the
;; allocator already chose, so a declined fold performs no scavenge and leaks
;; no emergency-pending register (the M-D lesson recorded on the GAP8 probe).
;; That is why each shape requires its address components -- and the compare's
;; other operand -- to be register-homed or immediate; a spilled component
;; declines back to the existing emission instead of staging.
;;
;; The loaded value's own home register is simply never written when a fold
;; fires. That is sound exactly because every shape is gated on
;; `compiler-backend-var-single-use?` for the load destination (and for the
;; cast/compare destinations it chains through): nothing else can read the
;; home, so leaving its previous contents in place is unobservable.
(define (compiler-backend-gep-load-cmp-address
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : (& compiler_ir_types.CompilerIrValue)]
  [elem-ty : compiler_ast_types.AstType]
  [gep-disp : i64]) : String
  ;; %rbp is excluded from the BASE slot on BOTH arms, not just the dynamic arm
  ;; address-base-filter already guards: the `disp( %rbp)` spelling the const
  ;; arm would otherwise use is re-read by the bounds-abort tail after a `pushq`
  ;; has moved %rsp, and it is the exact shape the FPO rsp-rebase pass rewrites.
  (let
    ;; IAG-1: an inline aggregate global's field is already a complete
    ;; rip-relative operand -- no base register is needed or possible.
    [rip : String
      (be_scalar.compiler-backend-inline-aggregate-gep-operand
        backend-state
        type-segment-bases
        (be_state.compiler-backend-global-shared-view base)
        offset
        (be_state.compiler-backend-global-shared-view elem-ty)
        gep-disp)]
    [raw-home : String
      (if (string.eq rip "")
        (be_operand.compiler-backend-value-scalar-register
          backend-state
          assignments
          base)
        "")]
    [base-home : String
      (be_scalar.compiler-backend-address-base-filter
        (be_state.compiler-backend-global-shared-view raw-home))]
    (if (not (string.eq rip ""))
      rip
      (match (be_operand.compiler-backend-value-as-i64 offset)
        [(Some n)
          (if (string.eq base-home "")
            ""
            (let
              [disp : i64
                (+
                  (*
                    n
                    (be_operand.compiler-backend-type-size
                      type-segment-bases
                      elem-ty))
                  gep-disp)]
              (if (be_operand.compiler-backend-imm32? disp)
                (be_scalar.compiler-backend-base-address disp base-home)
                "")))]
        [(None)
          (let
            [scale : i64
              (be_operand.compiler-backend-type-size type-segment-bases elem-ty)]
            ;; BE-2: the dynamic arm reads a %rbp base at scale 1, swapped
            ;; into the SIB index slot by compiler-backend-gep-index-address;
            ;; the const arm keeps the exclusion above.
            [dyn-base-home : String
              (be_scalar.compiler-backend-address-base-filter-sib
                raw-home
                scale)]
            [index-home : String
              (be_operand.compiler-backend-value-scalar-register
                backend-state
                assignments
                offset)]
            (if (and
              (not (string.eq dyn-base-home ""))
              (be_scalar.compiler-backend-gep-sib-scale? scale)
              (not (string.eq index-home ""))
              (not (string.eq index-home "%rbp"))
              (be_operand.compiler-backend-imm32? gep-disp))
              (be_scalar.compiler-backend-gep-index-address-disp
                gep-disp
                dyn-base-home
                scale
                index-home)
              ""))]))))

;; M6-D. Every address above is spelled straight out of the homes the allocator
;; chose, so a gep whose BASE was spilled (or homed in %rbp, which the dynamic
;; arm's SIB base slot cannot take) declines and the ordinary path emits three
;; instructions:
;;
;;     movq SPILL, %t          ; stage the base
;;     movq (%t,%i,8), %r      ; load
;;     cmpq $K, %r             ; compare
;;
;; The staging `movq` is unavoidable -- x86 has no memory BASE operand -- but
;; the load is not: once the base sits in %t the compare reads `(%t,%i,8)`
;; itself, and the shape folds to two instructions instead of three.
;;
;; The staging register is the LOAD DESTINATION's own register home -- not a
;; scavenged one. That keeps the probe pure (the M-D lesson: a probe that may
;; still decline must never scavenge, or a rejected fold leaks an
;; emergency-pending register), and it is sound by construction:
;;
;;   - the whole M6 family is gated on `compiler-backend-var-single-use?` for
;;     the load destination, and the fold consumes that single use, so after the
;;     fold nothing reads the home at all;
;;   - the unfolded emission WRITES that same home at exactly this program point
;;     (it is the load's destination), so writing it here instead clobbers
;;     nothing the allocator had not already declared dead;
;;   - the compare's other operand is live ACROSS the load it replaces, so the
;;     allocator cannot have given it the load destination's home; the operands
;;     therefore cannot collide;
;;   - the base is register-less on this path, so it cannot collide either, and
;;     the index is checked explicitly below -- an index sharing the load
;;     destination's home (legal for `movq (%r11,%rcx,8), %rcx`) would be
;;     destroyed by the staging write, so that shape declines.
;;
;; A spilled load destination has no home and declines. %rbp is refused as a
;; staging base for the same reason address-base-filter refuses it elsewhere.
;;
;; Only shapes the DIRECT address declines reach here, and only where the
;; ordinary path would have staged too -- otherwise the "fold" would add a
;; staging `movq` that was never being paid. That is address-base-filter on the
;; dynamic arm (%rbp included: its home cannot serve as a SIB base) and a
;; genuinely register-less home on the const arm, where
;; address-base-filter-direct lets even %rbp address `disp( %rbp)` in place.
(define (compiler-backend-gep-load-cmp-staged-base
  [ctx : be_state.CompilerBackendEmissionContext]
  [load-dst : i64]) : String
  (be_scalar.compiler-backend-address-base-filter
    (be_scalar.compiler-backend-var-register-home
      ctx.backend-state
      ctx.assignments
      load-dst)))

(define (compiler-backend-gep-load-cmp-staged-address
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [gep-disp : i64]
  [direct-addr : (& direct-addr str)]
  [staged-base : String]) : String
  (let
    [raw-base-home : String
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        base)]
    (if (or
      (string.eq staged-base "")
      (string.eq staged-base "%rbp")
      ;; The direct address already spells this shape; staging would only add a
      ;; redundant copy.
      (not (string.eq direct-addr "")))
      ""
      (match (be_operand.compiler-backend-value-as-i64 offset)
        [(Some n)
          ;; Const arm: the ordinary path addresses a %rbp-homed base in place,
          ;; so only a base with no register home at all is staged there.
          (let
            [disp : i64
              (+
                (*
                  n
                  (be_operand.compiler-backend-type-size
                    type-segment-bases
                    elem-ty))
                gep-disp)]
            (if (and
              (string.eq raw-base-home "")
              (be_operand.compiler-backend-imm32? disp))
              (be_scalar.compiler-backend-base-address disp staged-base)
              ""))]
        [(None)
          (let
            [scale : i64
              (be_operand.compiler-backend-type-size type-segment-bases elem-ty)]
            [base-home : String
              (be_scalar.compiler-backend-address-base-filter raw-base-home)]
            [index-home : String
              (be_operand.compiler-backend-value-scalar-register
                backend-state
                assignments
                offset)]
            (if (or
              (not (be_scalar.compiler-backend-gep-sib-scale? scale))
              (not (be_operand.compiler-backend-imm32? gep-disp)))
              ""
              (cond
                ;; Stage the BASE: the index already occupies a register the SIB
                ;; index slot can take.
                [(and
                    (string.eq base-home "")
                    (not (string.eq index-home ""))
                    (not (string.eq index-home "%rbp"))
                    ;; The staging write must not land on the index register the
                    ;; same address then reads.
                    (not (string.eq index-home staged-base)))
                  (be_scalar.compiler-backend-gep-index-address-disp
                    gep-disp
                    staged-base
                    scale
                    index-home)]
                ;; Stage the INDEX: the mirror case, and the common one -- a
                ;; spilled loop index the ordinary path copies into a scavenged
                ;; register before the load. Staging it into the load
                ;; destination's home instead lets the compare read the element
                ;; without the load, for the same one staging `movq`.
                [(and
                    (not (string.eq base-home ""))
                    (string.eq index-home "")
                    (not (string.eq base-home staged-base)))
                  (be_scalar.compiler-backend-gep-index-address-disp
                    gep-disp
                    base-home
                    scale
                    staged-base)]
                ;; Both sides spilled would need two staging registers, and the
                ;; fold owns exactly one.
                [else ""])))]))))

;; Which operand M6-D stages. Mirrors the arms of
;; compiler-backend-gep-load-cmp-staged-address: a base the SIB base slot cannot
;; take is staged, otherwise it is the spilled index. Only ever consulted when
;; that function returned a non-empty address, so exactly one of the two arms
;; applies.
(define (compiler-backend-gep-load-cmp-staged-value
  [backend-state : be_state.CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrValue
  (if (string.eq
    (be_scalar.compiler-backend-address-base-filter
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        base))
    "")
    base
    offset))

;; --- M6-H: the staging register when the LOAD DESTINATION is SPILLED ---------
;;
;; M6-D above sources its one staging register from the load destination's own
;; register home, and a SPILLED destination therefore declines. That refusal
;; lands exactly where the fold is worth the most. When the base is spilled AND
;; the destination is spilled -- the shape a saturated register file produces --
;; the unfolded path emits FOUR instructions plus, under saturation, two
;; emergency wraps:
;;
;;     movq %occupant, EM0        ; emergency-save the base scratch
;;     movq %occupant2, EM1       ; emergency-save the value scratch
;;     movq SPILL, %t             ; stage the base
;;     movq (%t,%i,8), %v         ; load
;;     movq %v, SLOT              ; store the loaded value to its home
;;     movq EM1, %occupant2       ; emergency-restore
;;     movq EM0, %occupant        ; emergency-restore
;;     cmpq SLOT, %r              ; compare against the slot just written
;;
;; Folded, the same shape is one staging `movq` and one `cmpq` reading
;; `(%t,%i,8)` directly: the loaded var is never materialised, so it needs no
;; scratch, no home store and no second emergency wrap. The staging `movq` is
;; the one the unfolded path was already paying, so the fold never adds an
;; instruction.
;;
;; WHY A SCAVENGED STAGING REGISTER IS SOUND HERE. The M6-D argument that the
;; destination's home is safe has three parts -- nothing reads the loaded var
;; after the fold, the unfolded path writes that register at this same point,
;; and the compare's other operand cannot be homed there. Only the third part
;; needs replacing when the register comes from the scavenger instead, because a
;; scavenged register can be anything the pool offers, and the EMERGENCY tier
;; ignores occupancy by design. The replacement is the sound-scavenger's own
;; device: for the duration of the pick the reserved mask is widened from the
;; GEP's operand homes to the union of the operand+result homes of the
;; instructions the fold may swallow (the load's consumer, the compare, and its
;; branch). Both the ordinary candidate filter and the emergency tier honour
;; that mask, so the pick provably avoids the compare's other operand, the
;; branch's condition, and the address's own index -- the three registers that
;; must survive from the staging write to the compare. The base is register-less
;; on this path, so it cannot collide, and the loaded var is spilled, so it has
;; no home to protect.
;;
;; TWO-SIDED PINNING. The probe must stay pure (the M-D lesson: a probe that can
;; still decline must never scavenge, or a rejected fold leaks an
;; emergency-pending register), so admission PEEKS through
;; a non-committing compiler-backend-scavenge-reg-pick -- side-effect-free,
;; it predicts the ordinary picker's answer including its emergency tier --
;; and the committed emitter re-runs the identical pick for real through
;; compiler-backend-scavenge-reg. The two agree because this one helper is the
;; only caller of either on this path and it supplies the same arguments to
;; both: dst-var -1 (so neither appends a destination home), the same empty
;; exclude array, the same "%r10" fallback, and the same widened reserved mask,
;; queried at the same emission point -- nothing between the peek and the commit
;; touches the emit cursor, the occupancy map or the assignment index. `commit?`
;; is the ONLY difference between the two calls.
;;
;; REACH, and why the lookahead is exactly three. The widened mask has to cover
;; every instruction whose operand homes must survive from the staging write to
;; the folded compare, and `compiler-backend-cmp-fold-walk` can step over up to
;; four size-preserving casts before reaching that compare -- further than any
;; fixed window worth paying for. So the shape test below ADMITS only the two
;; positions a three-instruction window provably covers: the compare sitting
;; directly behind the load, or one cast then the compare. A deeper cast chain
;; is refused rather than half-protected; the direct-address M6-C/M6-D folds,
;; which need no staging register and therefore no mask, keep the full walk.
;;
;; ADMISSION COST. The peek is not free -- an occupancy query, a candidate walk
;; and the widened mask -- and it would otherwise run at every spilled-base
;; spilled-destination load in the program, most of which no fold claims. The
;; same shape test decides the peek before any address work happens: two enum
;; matches and no allocation.
(define compiler-backend-gep-load-cmp-staging-lookahead : i64
  3)

(define (compiler-backend-instr-size-preserving-cast?
  [instr : (& instr compiler_ir_types.CompilerIrInstr)]) : bool
  (match instr
    [(Cast _ _ _ _) true]
    [_ false]))

(define (compiler-backend-gep-load-cmp-staging-compare-here?
  [load-dst : i64]
  [instr : (& compiler_ir_types.CompilerIrInstr)]) : bool
  (match instr
    [(BinOp _ op lhs rhs _)
      (and
        (be_facts.compiler-backend-compare-op? op)
        (or
          (be_operand.compiler-backend-branch-uses-var? lhs load-dst)
          (be_operand.compiler-backend-branch-uses-var? rhs load-dst)))]
    [_ false]))

(define (compiler-backend-gep-load-cmp-staging-shape?
  [load-dst : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= (+ index 1) instrs.len)
    false
    (let
      [here (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)]
      [next (compiler_ir_types.compiler-ir-instr-seq-borrow instrs (+ index 1))]
      (if (compiler-backend-gep-load-cmp-staging-compare-here? load-dst here)
        true
        (match here
          [(Cast cast-dst cast-src _ _)
            (and
              (be_operand.compiler-backend-branch-uses-var? cast-src load-dst)
              ;; One cast, then the consumer. A second cast would let the walk
              ;; run past the window the mask covers, so it is refused here.
              (not (compiler-backend-instr-size-preserving-cast? next))
              (or
                (compiler-backend-gep-load-cmp-staging-compare-here?
                  cast-dst
                  next)
                ;; M6-G: the widening cast IS the consumer, and its own load is
                ;; emitted immediately behind the staging write, so nothing but
                ;; the gep's own operands has to survive.
                (< (+ index 1) instrs.len)))]
          [_ false])))))

(define (compiler-backend-gep-load-cmp-staging-reserved-mask
  [ctx : be_state.CompilerBackendEmissionContext]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [remaining : i64]
  [acc : i64]) : i64
  (if (or (<= remaining 0) (>= index instrs.len))
    acc
    (compiler-backend-gep-load-cmp-staging-reserved-mask
      (be_state.compiler-backend-global-shared-view ctx)
      (be_state.compiler-backend-global-shared-view instrs)
      (+ index 1)
      (- remaining 1)
      (bit-or
        acc
        (compiler-backend-instr-reserved-home-mask
          ctx.function-state
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index))))))

(define (compiler-backend-gep-load-cmp-scavenged-staging-base
  [ctx : be_state.CompilerBackendEmissionContext]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [commit? : bool]) : String
  (let
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [_widen : unit
      (compiler-backend-set-current-instr-reserved-mask!
        ctx.function-state
        (compiler-backend-gep-load-cmp-staging-reserved-mask
          (be_state.compiler-backend-global-shared-view ctx)
          instrs
          index
          compiler-backend-gep-load-cmp-staging-lookahead
          saved-reserved))]
    [reg : String
      (be_operand.compiler-backend-scavenge-reg-pick
        -1
        (be_operand.compiler-backend-one-exclude "")
        1
        "%r10"
        commit?
        ctx.backend-state)]
    [_restore : unit
      (compiler-backend-set-current-instr-reserved-mask!
        ctx.function-state
        saved-reserved)]
    (be_scalar.compiler-backend-address-base-filter reg)))

;; Follow the fused load's value forward to the instruction that consumes it,
;; stepping over the width-preserving casts TL's typed surface leaves between a
;; `.len` load and the bounds check that uses it (`%17 = cast %15 : i64 to u64`
;; with `%16 = cast %0 : i64 to u64` for the index sitting beside it). Two kinds
;; of step are admitted, and BOTH emit nothing on the machine:
;;
;;   - a size-preserving non-float cast OF the tracked value whose destination
;;     is single-use: it renames the value and is folded away with the load;
;;   - a size-preserving non-float cast of some OTHER value whose source and
;;     destination already share one register home: the allocator has made it a
;;     self-move, so skipping it neither drops work nor writes any register --
;;     in particular it cannot clobber the address registers the folded compare
;;     now reads at the consumer instead of at the load.
;;
;; Anything else ends the walk at that instruction; `fuel` bounds the scan.
;; The result carries the tracked value var and the index it stopped at.
(defenum CompilerBackendCmpFoldWalk
  (No)
  (Some i64 i64))

(define (compiler-backend-cmp-fold-walk
  [ctx : be_state.CompilerBackendEmissionContext]
  [instrs : (& compiler_ir_types.CompilerIrInstrSeq)]
  [index : i64]
  [value-var : i64]
  [fuel : i64]) : CompilerBackendCmpFoldWalk
  (if (>= index instrs.len)
    (No)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(Cast cast-dst cast-src from-ty to-ty)
        (if (or
          (<= fuel 0)
          (be_operand.compiler-backend-float-type? from-ty)
          (be_operand.compiler-backend-float-type? to-ty)
          (not
            (=
              (be_operand.compiler-backend-type-size
                ctx.type-segment-bases
                from-ty)
              (be_operand.compiler-backend-type-size
                ctx.type-segment-bases
                to-ty))))
          (Some value-var index)
          (if (be_operand.compiler-backend-branch-uses-var? cast-src value-var)
            (if (be_simd.compiler-backend-var-single-use?
              ctx.use-counts
              cast-dst)
              (compiler-backend-cmp-fold-walk
                ctx
                instrs
                (+ index 1)
                cast-dst
                (- fuel 1))
              (Some value-var index))
            (let
              [src-home : String
                (be_operand.compiler-backend-value-scalar-register
                  ctx.backend-state
                  ctx.assignments
                  cast-src)]
              [dst-home : String
                (be_scalar.compiler-backend-var-register-home
                  ctx.backend-state
                  ctx.assignments
                  cast-dst)]
              (if (and
                (not (string.eq src-home ""))
                (string.eq src-home dst-home))
                (compiler-backend-cmp-fold-walk
                  ctx
                  instrs
                  (+ index 1)
                  value-var
                  (- fuel 1))
                (Some value-var index)))))]
      [_ (Some value-var index)])))

(define compiler-backend-cmp-fold-walk-fuel : i64
  4)

;; M6-A: length memory operand, index register operand, ok-label, resume index.
(defenum CompilerBackendGepLoadBoundsFold
  (No)
  (Some String String i64 i64))

(define (compiler-backend-gep-load-bounds-probe
  [ctx : be_state.CompilerBackendEmissionContext]
  [addr : String]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadBoundsFold
  ;; The bounds compare is a 64-bit unsigned `cmpq len, idx`, so the loaded
  ;; length must be a full word: no narrow width and no float ever reaches here.
  ;; Size-preserving casts on the way leave that word's bit pattern alone, so
  ;; the walk may cross them.
  (if (or
    (string.eq addr "")
    (be_operand.compiler-backend-float-type? load-ty)
    (not
      (=
        (be_operand.compiler-backend-type-size ctx.type-segment-bases load-ty)
        8))
    (not (be_simd.compiler-backend-var-single-use? ctx.use-counts load-dst)))
    (No)
    (match (compiler-backend-cmp-fold-walk
      (be_state.compiler-backend-global-shared-view ctx)
      instrs
      index
      load-dst
      compiler-backend-cmp-fold-walk-fuel)
      [(No) (No)]
      [(Some length-var stop)
        (let
          [next (compiler_ir_types.compiler-ir-instr-seq-borrow instrs stop)]
          (match next
            [(BoundsCheck bc-index bc-length ok-label)
              (let
                [index-reg : String
                  (be_operand.compiler-backend-value-scalar-register-home
                    ctx.backend-state
                    ctx.assignments
                    bc-index)]
                ;; A register-homed INDEX is required: the folded length already
                ;; occupies the compare's memory operand and `cmp mem, mem` is
                ;; illegal, so a spilled or constant index declines to the
                ;; ordinary path (which owns its own index staging and its
                ;; GAP6d const form). That same requirement is what lets the
                ;; LOCATED tail keep the fold (ABT-1): the tail re-reads the
                ;; length through `pushq <memory operand>` FIRST, while %rsp is
                ;; still the compare's own, and the only operand it reads after
                ;; that push is the index -- a register here by construction.
                ;; The address itself can never be %rsp- or %rbp-relative:
                ;; compiler-backend-gep-load-cmp-address excludes %rbp from the
                ;; base slot on both arms for exactly this re-read (and for the
                ;; FPO rsp-rebase pass), and a non-register base home stages
                ;; instead of folding.
                (if (and
                  (be_operand.compiler-backend-branch-uses-var?
                    bc-length
                    length-var)
                  (not
                    (be_operand.compiler-backend-branch-uses-var?
                      bc-index
                      length-var))
                  (not (string.eq index-reg "")))
                  (Some addr index-reg ok-label (+ stop 1))
                  (No)))]
            [_ (No)]))])))

;; The M6-A mirror of compiler-backend-rest-starts-load-compare-branch?: the
;; adjacent-load PAIR rule declines when the second load is the length operand
;; of the bounds check right behind it, so that gep+load re-enters the fusion
;; cluster on its own and M6-A can put the length straight in the compare.
;; Unlike the compare-branch predicate this one runs the real probe, because
;; declining the pair for a fold that then refuses would leave two independent
;; single loads where the pair rule had one shared base. The displacement is
;; taken as 0: the pair arm is constant-offset-only, and a constant offset
;; contributes nothing to the GAP9 fold (whose ordinal must not be consumed by
;; a predicate anyway).
(define (compiler-backend-gep-load-bounds-foldable?
  [ctx : be_state.CompilerBackendEmissionContext]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : (& compiler_ir_types.CompilerIrValue)]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : bool
  (match (compiler-backend-gep-load-bounds-probe
    (be_state.compiler-backend-global-shared-view ctx)
    (compiler-backend-gep-load-cmp-address
      ctx.backend-state
      ctx.type-segment-bases
      ctx.assignments
      base
      offset
      elem-ty
      0)
    load-dst
    load-ty
    instrs
    index)
    [(Some _ _ _ _) true]
    [(No) false]))

;; ABT-1: the fused compare is emitted while the dispatch seam is on the
;; GEP/LOAD, so compiler-backend-emit-instr installed the abort site for THAT
;; instruction -- which carries none, and which therefore left the site
;; inactive. The check's own site has to be installed here, or the fold would
;; answer a located check with the bare `tl_oob_abort` the unfused form does
;; not: the same descriptor, on the same trap, for a compare that happens to
;; have folded.
;; BE-3: the bounds fold on a staged address, in M6-D's order -- the handle
;; goes to its staging register FIRST, then the compare reads the length word
;; through it. `staged-base` is "" whenever the fold spelled a direct address,
;; and then this is the direct emission.
(define (compiler-backend-emit-gep-load-bounds-fold-staged
  [ctx : be_state.CompilerBackendEmissionContext]
  [staged-value : compiler_ir_types.CompilerIrValue]
  [staged-base : String]
  [length-operand : String]
  [index-operand : String]
  [ok-label : i64]
  [bounds-instr : compiler_ir_types.CompilerIrInstr]) : be_state.ResultCompilerBackend
  (if (string.eq staged-base "")
    (compiler-backend-emit-gep-load-bounds-fold
      ctx
      length-operand
      index-operand
      ok-label
      bounds-instr)
    (let
      [stage-asm
        (try
          (be_operand.compiler-backend-emit-load-value
            ctx.assignments
            staged-value
            staged-base
            ctx.backend-state))]
      [body-asm
        (try
          (compiler-backend-emit-gep-load-bounds-fold
            ctx
            length-operand
            index-operand
            ok-label
            bounds-instr))]
      (Ok (str_cat.str-cat stage-asm body-asm)))))

;; BE-3: the sibling word of a staged bounds fold (see the fold site): the
;; load's assembly, read through the fold's staging register, when the two
;; instructions at `at` are that shape.
(defenum CompilerBackendBoundsSibling
  (No)
  (Some String))

(define (compiler-backend-bounds-fold-same-base?
  [a : compiler_ir_types.CompilerIrValue]
  [b : (& compiler_ir_types.CompilerIrValue)]) : bool
  (match a
    [(Global x)
      (match b
        [(Global y) (= x y)]
        [_ false])]
    [(Var x)
      (match b
        [(Var y) (= x y)]
        [_ false])]
    [_ false]))

(define (compiler-backend-bounds-fold-sibling
  [ctx : be_state.CompilerBackendEmissionContext]
  [base : compiler_ir_types.CompilerIrValue]
  [base-reg : String]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [at : i64]) : CompilerBackendBoundsSibling
  (if (or (string.eq base-reg "") (>= (+ at 1) instrs.len))
    (No)
    (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs at)
      [(Gep gep-dst gep-base gep-offset elem-ty)
        (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs (+ at 1))
          [(Load load-dst load-src load-ty)
            (match (be_operand.compiler-backend-value-as-i64 gep-offset)
              [(Some n)
                (let
                  [dst-home : String
                    (be_scalar.compiler-backend-var-register-home
                      ctx.backend-state
                      ctx.assignments
                      load-dst)]
                  [disp : i64
                    (*
                      n
                      (be_operand.compiler-backend-type-size
                        ctx.type-segment-bases
                        elem-ty))]
                  (if (and
                    (be_operand.compiler-backend-branch-uses-var?
                      load-src
                      gep-dst)
                    (compiler-backend-bounds-fold-same-base? base gep-base)
                    (be_simd.compiler-backend-var-single-use?
                      ctx.use-counts
                      gep-dst)
                    (not (string.eq dst-home ""))
                    (not (be_operand.compiler-backend-float-type? load-ty))
                    (=
                      (be_operand.compiler-backend-type-size
                        ctx.type-segment-bases
                        load-ty)
                      8)
                    (be_operand.compiler-backend-imm32? disp))
                    (let
                      ;; The walker would have dispatched this gep: consume its
                      ;; ordinal exactly as it would have.
                      [fold-disp : i64
                        (compiler-backend-gep-fold-next!
                          ctx.function-state
                          ctx.type-segment-bases
                          gep-offset
                          elem-ty)]
                      (Some
                        (str_cat.str-cat
                          "    movq "
                          (be_scalar.compiler-backend-base-address
                            (+ disp fold-disp)
                            base-reg)
                          ", "
                          dst-home
                          "\n")))
                    (No)))]
              [(None) (No)])]
          [_ (No)])]
      [_ (No)])))

(define (compiler-backend-emit-gep-load-bounds-fold
  [ctx : be_state.CompilerBackendEmissionContext]
  [length-operand : String]
  [index-operand : String]
  [ok-label : i64]
  [bounds-instr : compiler_ir_types.CompilerIrInstr]) : be_state.ResultCompilerBackend
  (let
    [_abort-site : unit
      (be_scalar.compiler-backend-runtime-abort-site-install!
        (be_state.compiler-backend-global-shared-view ctx)
        bounds-instr)]
    (Ok
      (be_scalar.compiler-backend-bounds-check-asm
        ""
        ""
        length-operand
        index-operand
        (let
          [args (compiler_ir_types.CompilerIrCallArgs.Nil)]
          [types (compiler_ast_types.ast-type-list-new)]
          (be_operand.compiler-backend-call-arg-space
            ctx.target-policy.target
            args
            types
            false
            ctx.program-index))
        (be_operand.compiler-backend-asm-label ctx.function ok-label)
        ctx.plan
        ctx.program-index))))

;; `cmp`/`test` with one memory operand, at an explicit width. `src` is the
;; AT&T source operand and `dst` the destination one: exactly one of them is
;; the folded memory address, and which one depends on where the loaded value
;; sat in the IR compare (`lhs OP rhs` renders as `cmp rhs, lhs`).
(define (compiler-backend-cmp-mem-operands-asm
  [op : compiler_ir_types.CompilerIrBinOp]
  [suffix : String]
  [src-operand : String]
  [dst-operand : String]) : String
  (str_cat.str-cat
    "    "
    (if (be_facts.compiler-backend-bit-test-op? op)
      "test"
      "cmp")
    suffix
    " "
    src-operand
    ", "
    dst-operand
    "\n"))

;; M6-C width/signedness table. The narrow fold replaces
;;
;;     mov{z,s}<W>q MEM, %r      ; 64-bit value = ext(MEM)
;;     cmpq $K, %r               ; equality at 64 bits
;;
;; with `cmp<W> $K, MEM` -- a comparison at W BYTES. Equality at the narrow
;; width agrees with equality at 64 bits exactly when the literal survives the
;; load's own extension unchanged, i.e. when K is in the range the extension
;; can produce:
;;
;;     width  load       extension     admitted K
;;     -----  ---------  ------------  --------------------------
;;     1      movzbq     zero          0 .. 255
;;     1      movsbq     sign          -128 .. 127
;;     2      movzwq     zero          0 .. 65535
;;     2      movswq     sign          -32768 .. 32767
;;     4      movl       zero          0 .. 2147483647
;;     4      movslq     sign          -2147483648 .. 2147483647
;;
;; Outside that range `ext(MEM) == K` is a CONSTANT (no W-byte value extends to
;; K), so the fold declines rather than inventing a comparison. The W=4
;; unsigned row stops at imm32's signed maximum on purpose: `cmpl $K, MEM`
;; renders K as a 32-bit immediate, and the values above that would have to be
;; spelled as their negative two's-complement twin.
;;
;; ORDERED narrow comparisons are NOT folded: a zero-extended byte compared
;; with `jl`/`jg` at 64 bits is a comparison of a non-negative value, which the
;; 8-bit signed compare does not reproduce (byte 200 is -56 there), and a
;; sign-extended byte compared unsigned is wrong the other way. Only Eq/Ne
;; reach the narrow arm, and their jcc (je/jne) is width- and sign-agnostic.
(define (compiler-backend-narrow-cmp-literal-ok?
  [width : i64]
  [signed? : bool]
  [k : i64]) : bool
  (cond
    [(= width 1)
      (if signed?
        (and (>= k (- 0 128)) (<= k 127))
        (and (>= k 0) (<= k 255)))]
    [(= width 2)
      (if signed?
        (and (>= k (- 0 32768)) (<= k 32767))
        (and (>= k 0) (<= k 65535)))]
    [(= width 4)
      (if signed?
        (be_operand.compiler-backend-imm32? k)
        (and (>= k 0) (<= k 2147483647)))]
    [else false]))

;; Equality-shaped compares set ZF symmetrically, so their operands may be
;; exchanged without touching the jcc. That is what lets the narrow arm always
;; put the literal in the source slot, and what lets the wide arm accept an
;; immediate on the side the memory operand does not occupy.
(define (compiler-backend-compare-operands-commute?
  [op : (& op compiler_ir_types.CompilerIrBinOp)]) : bool
  (match op
    [(or (Eq) (Ne) (BitTestEq) (BitTestNe)) true]
    [_ false]))

;; M6-B/M6-C: compare asm, true jcc, false jcc, true label, false label,
;; resume index.
(defenum CompilerBackendGepLoadCmpBranchFold
  (No)
  (Some String String String i64 i64 i64))

;; --- M6-G: a narrow element load whose only reader is its widening cast ------
;;
;; `(cast (array-ref slots i) : i64)` lowers to `Load : u8` followed by
;; `Cast u8 to i64`, and the x86 load ALREADY performs that extension: `movzbq
;; addr, %r` leaves the whole 64-bit register holding the byte. When the loaded
;; value's single reader is a compare the M6-C arm above folds the pair into a
;; `cmpb` and neither instruction survives. When it has several readers -- a
;; lexer's dispatch byte, tested against a dozen literals -- M6-C declines and
;; the pair is emitted in full: one `movzbq addr, %rax` and one `movzbq %al,
;; %r12` re-extending a register that is already extended.
;;
;; The second instruction is the whole of what this arm removes, by giving the
;; LOAD the cast's own destination register. What makes that sound is the same
;; single-use condition M6 already demands of every fold in this cluster
;; (`compiler-backend-gep-load-cmp-fold-rest` refuses a multiply-read load
;; outright): the loaded var is read by the cast and by nothing else, so its own
;; home is never observed and need not be written. The cast's destination is
;; where the value was going to end up either way.
;;
;; Rails, each mirroring the M6-C arm that reads the load's extension out of
;; `load-ty`:
;;   * the cast's source is exactly the loaded var, so no size-preserving cast
;;     crossed on the way can have flipped the signedness the width table
;;     depends on;
;;   * the cast's source width equals the load's width and their signedness
;;     agrees, so the extension the load performs IS the extension the cast
;;     asks for;
;;   * the cast widens to a full word. A narrower target would need the
;;     upper bits left alone, which a widening load does not do;
;;   * no float on any side -- those move through the SSE path, not `movzbq`;
;;   * the cast's destination has a general-register home that is not `%rbp`.
;;     A spilled destination still needs the store the ordinary path emits, and
;;     writing it here would buy nothing.
;; The address operands are read before the destination is written within one
;; instruction, so a destination that also spells the address's base or index is
;; safe; and the destination register belongs to the cast, whose live range
;; starts here, so nothing live across the pair can be homed in it.
;;
;; The M6-D staged address is taken too, on the same terms the compare arms
;; take it: a base or index the SIB slots cannot spell is materialized into the
;; LOAD destination's own register home first, and the load then reads through
;; it. That register is dead the moment the fold retires the loaded var, so
;; staging into it costs the one `movq` the unfolded path was already paying to
;; scavenge a base -- and the pair still loses its re-extension.
;;
;; destination register spelling, resume index.
(defenum CompilerBackendGepLoadWidenFold
  (No)
  (Some String i64))

(define (compiler-backend-gep-load-widen-cast-probe
  [ctx : be_state.CompilerBackendEmissionContext]
  [addr : String]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadWidenFold
  (if (or (string.eq addr "") (>= index instrs.len))
    (No)
    (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)
      [(Cast cast-dst cast-src from-ty to-ty)
        (let
          [width : i64
            (be_operand.compiler-backend-type-size
              ctx.type-segment-bases
              load-ty)]
          (if (or
            (not
              (be_operand.compiler-backend-branch-uses-var? cast-src load-dst))
            (not (or (= width 1) (= width 2) (= width 4)))
            (be_operand.compiler-backend-float-type? load-ty)
            (be_operand.compiler-backend-float-type? from-ty)
            (be_operand.compiler-backend-float-type? to-ty)
            (not
              (=
                (be_operand.compiler-backend-type-size
                  ctx.type-segment-bases
                  from-ty)
                width))
            (not
              (=
                (be_operand.compiler-backend-type-size
                  ctx.type-segment-bases
                  to-ty)
                8))
            (not
              (=
                (if (be_facts.compiler-backend-type-signed?
                  ctx.type-segment-bases
                  from-ty)
                  1
                  0)
                (if (be_facts.compiler-backend-type-signed?
                  ctx.type-segment-bases
                  load-ty)
                  1
                  0))))
            (No)
            (let
              [home : String
                (be_scalar.compiler-backend-var-register-home
                  ctx.backend-state
                  ctx.assignments
                  cast-dst)]
              (if (or (string.eq home "") (string.eq home "%rbp"))
                (No)
                (Some home (+ index 1))))))]
      [_ (No)])))

;; The compare's own source operand: the loaded value has been folded into the
;; memory operand, so the OTHER side must already be an immediate or a register
;; home. "" declines.
(define (compiler-backend-gep-load-cmp-other-operand
  [ctx : be_state.CompilerBackendEmissionContext]
  [value : compiler_ir_types.CompilerIrValue]) : String
  (match (be_operand.compiler-backend-immediate-operand ctx.backend-state value)
    [(Some imm) imm]
    [(No)
      (be_operand.compiler-backend-value-scalar-register
        ctx.backend-state
        ctx.assignments
        value)]))

;; The narrow (M6-C) arm: `Load` of a 1/2/4-byte element, its widening `Cast`,
;; then an equality compare against a literal. Returns "" when the shape or the
;; literal is not admitted.
(define (compiler-backend-gep-load-narrow-cmp-asm
  [ctx : (& ctx be_state.CompilerBackendEmissionContext)]
  [addr : String]
  [load-ty : compiler_ast_types.AstType]
  [from-ty : (& compiler_ast_types.AstType)]
  [to-ty : (& compiler_ast_types.AstType)]
  [op : compiler_ir_types.CompilerIrBinOp]
  [other : compiler_ir_types.CompilerIrValue]) : String
  (let
    [width : i64
      (be_operand.compiler-backend-type-size ctx.type-segment-bases load-ty)]
    (if (or
      (not (compiler-backend-compare-operands-commute? op))
      (be_facts.compiler-backend-bit-test-op? op)
      (be_operand.compiler-backend-float-type? from-ty)
      (be_operand.compiler-backend-float-type? to-ty)
      ;; The register value the compare would have read is the LOAD's own
      ;; extension, so the cast must be exactly that extension: same source
      ;; width, same source signedness, widened to a full word.
      (not
        (=
          (be_operand.compiler-backend-type-size ctx.type-segment-bases from-ty)
          width))
      (not
        (=
          (be_operand.compiler-backend-type-size ctx.type-segment-bases to-ty)
          8))
      (not
        (=
          (if (be_facts.compiler-backend-type-signed?
            ctx.type-segment-bases
            from-ty)
            1
            0)
          (if (be_facts.compiler-backend-type-signed?
            ctx.type-segment-bases
            load-ty)
            1
            0))))
      ""
      (match (be_operand.compiler-backend-value-as-i64 other)
        [(Some k)
          (if (compiler-backend-narrow-cmp-literal-ok?
            width
            (be_facts.compiler-backend-type-signed?
              ctx.type-segment-bases
              load-ty)
            k)
            (compiler-backend-cmp-mem-operands-asm
              op
              (be_operand.compiler-backend-int-instruction-suffix
                ctx.type-segment-bases
                load-ty)
              (str_cat.str-cat "$" (string.int->string k))
              addr)
            "")]
        [(None) ""]))))

;; The wide (M6-B) arm: a full-word load feeding a compare from EITHER side.
;; `mem-is-lhs?` says the loaded value was the IR compare's left operand, which
;; is the AT&T DESTINATION slot; the mirrored case puts the address in the
;; source slot instead, and only an equality compare may swap them.
(define (compiler-backend-gep-load-wide-cmp-asm
  [ctx : be_state.CompilerBackendEmissionContext]
  [addr : String]
  [op : compiler_ir_types.CompilerIrBinOp]
  [mem-is-lhs? : bool]
  [other : compiler_ir_types.CompilerIrValue]) : String
  ;; When the address occupies the SOURCE slot the other operand has to be a
  ;; legal destination: a register. An immediate destination is only reachable
  ;; by exchanging the operands, which only equality-shaped compares permit.
  (let
    [other-operand : String
      (compiler-backend-gep-load-cmp-other-operand ctx other)]
    (cond
      [(string.eq other-operand "") ""]
      [mem-is-lhs?
        (compiler-backend-cmp-mem-operands-asm op "q" other-operand addr)]
      [(be_operand.compiler-backend-string-prefix-at? other-operand "%" 0)
        (compiler-backend-cmp-mem-operands-asm op "q" addr other-operand)]
      [(compiler-backend-compare-operands-commute? op)
        (compiler-backend-cmp-mem-operands-asm op "q" other-operand addr)]
      [else ""])))

;; The direct narrow (M6-J) arm: a 1/2/4-byte `Load` compared at its OWN width,
;; with no widening cast in between -- the shape a `char`/`u8` scanner has, e.g.
;; `%b = load %p : char ; %c = ne %b, 47 : char`. Unfolded, the compare reads
;; the low W bytes of the loaded value's register (`movzbq MEM, %r ; cmpb $47,
;; %rb`), so reading those W bytes straight from memory is the same compare with
;; the load folded in -- for ordered compares too, because the width and the
;; signedness (and so the jcc) are the compare's own, not a widened value's.
;; The other operand is a literal that the W-byte compare reads unchanged, or a
;; register-homed value spelled at width W. With the memory operand on the
;; compare's RIGHT the other operand must be the destination: a register, or a
;; literal only when an equality compare lets the operands exchange.
(define (compiler-backend-gep-load-direct-narrow-cmp-asm
  [ctx : be_state.CompilerBackendEmissionContext]
  [addr : String]
  [load-ty : compiler_ast_types.AstType]
  [cmp-ty : compiler_ast_types.AstType]
  [op : compiler_ir_types.CompilerIrBinOp]
  [mem-is-lhs? : bool]
  [other : compiler_ir_types.CompilerIrValue]) : String
  (let
    [width : i64
      (be_operand.compiler-backend-type-size ctx.type-segment-bases load-ty)]
    [signed? : bool
      (be_facts.compiler-backend-type-signed? ctx.type-segment-bases load-ty)]
    [suffix : String
      (be_operand.compiler-backend-int-instruction-suffix
        ctx.type-segment-bases
        (be_state.compiler-backend-global-shared-view load-ty))]
    (if (or
      (not (or (= width 1) (= width 2) (= width 4)))
      (be_facts.compiler-backend-bit-test-op? op)
      (be_operand.compiler-backend-float-type? load-ty)
      (be_operand.compiler-backend-float-type? cmp-ty)
      (not
        (=
          (be_operand.compiler-backend-type-size ctx.type-segment-bases cmp-ty)
          width))
      (not
        (=
          (if (be_facts.compiler-backend-type-signed?
            ctx.type-segment-bases
            cmp-ty)
            1
            0)
          (if signed?
            1
            0))))
      ""
      (match (be_operand.compiler-backend-value-as-i64 other)
        [(Some k)
          (if (and
            (compiler-backend-narrow-cmp-literal-ok? width signed? k)
            (or mem-is-lhs? (compiler-backend-compare-operands-commute? op)))
            (compiler-backend-cmp-mem-operands-asm
              op
              suffix
              (str_cat.str-cat "$" (string.int->string k))
              addr)
            "")]
        [(None)
          (let
            [reg : String
              (be_operand.compiler-backend-value-scalar-register
                ctx.backend-state
                ctx.assignments
                other)]
            (if (string.eq reg "")
              ""
              (let
                [narrow-reg : String
                  (be_operand.compiler-backend-sized-reg
                    ctx.type-segment-bases
                    reg
                    load-ty)]
                (if mem-is-lhs?
                  (compiler-backend-cmp-mem-operands-asm
                    op
                    suffix
                    narrow-reg
                    addr)
                  (compiler-backend-cmp-mem-operands-asm
                    op
                    suffix
                    addr
                    narrow-reg)))))]))))

;; Walk `Load ; [Cast] ; BinOp compare ; Branch` and produce the folded
;; compare. Every destination in the chain is required to be single-use, which
;; is what makes dropping the load (and the cast the load already performed)
;; unobservable; the instructions are consumed as a contiguous run, so nothing
;; can write memory, the address registers or the flags in between.
(define (compiler-backend-gep-load-cmp-branch-probe
  [ctx : be_state.CompilerBackendEmissionContext]
  [addr : String]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadCmpBranchFold
  (match (compiler-backend-cmp-fold-walk
    (be_state.compiler-backend-global-shared-view ctx)
    instrs
    index
    load-dst
    compiler-backend-cmp-fold-walk-fuel)
    [(No) (No)]
    [(Some value-var stop)
      (compiler-backend-gep-load-cmp-branch-probe-at
        ctx
        addr
        load-dst
        load-ty
        value-var
        instrs
        stop)]))

(define (compiler-backend-gep-load-cmp-branch-probe-at
  [ctx : be_state.CompilerBackendEmissionContext]
  [addr : String]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [value-var : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadCmpBranchFold
  (let
    [maybe-cast (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)]
    [narrow? : bool
      (match (be_state.compiler-backend-global-shared-view maybe-cast)
        [(Cast cast-dst cast-src _ _)
          (and
            ;; The narrow arm reads the LOAD's own extension out of load-ty, so
            ;; the widening cast has to sit directly on the loaded value: a
            ;; size-preserving cast crossed on the way could have flipped the
            ;; signedness the width table depends on.
            (= value-var load-dst)
            (be_operand.compiler-backend-branch-uses-var? cast-src load-dst)
            (be_simd.compiler-backend-var-single-use? ctx.use-counts cast-dst))]
        [_ false])]
    ;; M6-J: no cast, and the load itself narrow -- the compare then runs at
    ;; the load's own width (checked with the rest of the shape below).
    [direct? : bool
      (and
        (not narrow?)
        (= value-var load-dst)
        (<
          (be_operand.compiler-backend-type-size ctx.type-segment-bases load-ty)
          8))]
    [cmp-index : i64
      (if narrow?
        (+ index 1)
        index)]
    [cmp-var : i64
      (match (be_state.compiler-backend-global-shared-view maybe-cast)
        [(Cast cast-dst _ _ _)
          (if narrow?
            cast-dst
            value-var)]
        [_ value-var])]
    ;; The wide arm needs a full-word load; the narrow arm needs the cast (and
    ;; checks its own admitted widths below).
    (if (or
      (and
        (not narrow?)
        (not direct?)
        (not
          (=
            (be_operand.compiler-backend-type-size
              ctx.type-segment-bases
              load-ty)
            8)))
      (>= (+ cmp-index 1) instrs.len))
      (No)
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs cmp-index)
        [(BinOp cmp-dst op lhs rhs cmp-ty)
          (let
            [type-segment-bases : i64 ctx.type-segment-bases]
            [mem-is-lhs? : bool
              (and
                (be_operand.compiler-backend-branch-uses-var? lhs cmp-var)
                (not (be_operand.compiler-backend-branch-uses-var? rhs cmp-var)))]
            [mem-is-rhs? : bool
              (and
                (be_operand.compiler-backend-branch-uses-var? rhs cmp-var)
                (not (be_operand.compiler-backend-branch-uses-var? lhs cmp-var)))]
            [other : compiler_ir_types.CompilerIrValue
              (if mem-is-lhs?
                (owned_view.compiler-owned-shared-view rhs)
                (owned_view.compiler-owned-shared-view lhs))]
            (if (and
              (be_facts.compiler-backend-compare-op? op)
              (be_simd.compiler-backend-var-single-use? ctx.use-counts cmp-dst)
              (or mem-is-lhs? mem-is-rhs?)
              ;; The wide arm renders `cmpq`, so the comparison itself must be
              ;; at full word width; the narrow arms carry their own width tables.
              (or
                narrow?
                direct?
                (=
                  (be_operand.compiler-backend-type-size
                    ctx.type-segment-bases
                    cmp-ty)
                  8))
              (not
                (be_scalar.compiler-backend-binop-f64?
                  ctx.types
                  (be_state.compiler-backend-global-shared-view
                    ctx.global-types)
                  lhs
                  rhs
                  cmp-ty)))
              (match (compiler_ir_types.compiler-ir-instr-scalar-fact
                (compiler_ir_types.compiler-ir-instr-seq-ref
                  instrs
                  (+ cmp-index 1)))
                [(Branch cond true-label false-label)
                  (let
                    [cmp-asm : String
                      (if narrow?
                        (match maybe-cast
                          [(Cast _ _ from-ty to-ty)
                            (compiler-backend-gep-load-narrow-cmp-asm
                              ctx
                              addr
                              (be_state.compiler-backend-global-shared-view
                                load-ty)
                              from-ty
                              to-ty
                              (be_state.compiler-backend-global-shared-view op)
                              other)]
                          [_ ""])
                        (if direct?
                          (compiler-backend-gep-load-direct-narrow-cmp-asm
                            ctx
                            addr
                            (be_state.compiler-backend-global-shared-view
                              load-ty)
                            (be_state.compiler-backend-global-shared-view
                              cmp-ty)
                            (be_state.compiler-backend-global-shared-view op)
                            mem-is-lhs?
                            other)
                          (compiler-backend-gep-load-wide-cmp-asm
                            ctx
                            addr
                            (be_state.compiler-backend-global-shared-view op)
                            mem-is-lhs?
                            other)))]
                    [jcc-ty : compiler_ast_types.AstType
                      (if narrow?
                        load-ty
                        cmp-ty)]
                    [true-jcc : String
                      (be_scalar.compiler-backend-compare-true-jcc
                        type-segment-bases
                        op
                        jcc-ty)]
                    [false-jcc : String
                      (be_scalar.compiler-backend-compare-false-jcc
                        type-segment-bases
                        op
                        jcc-ty)]
                    (if (and
                      (not (string.eq cmp-asm ""))
                      (not (string.eq true-jcc ""))
                      (be_operand.compiler-backend-branch-uses-var?
                        cond
                        cmp-dst))
                      (Some
                        cmp-asm
                        true-jcc
                        false-jcc
                        true-label
                        false-label
                        (+ cmp-index 2))
                      (No)))]
                [_ (No)])
              (No)))]
        [_ (No)]))))

(defenum CompilerBackendMaybeGepLoadCmpEmission
  (No)
  (Some be_state.ResultCompilerBackend))

;; M6-E: the folded compare sets the flags its branch consumes, so successor
;; phi-edge copies cannot sit between them -- they have to run ON the edge,
;; behind the jcc. That is exactly the shape
;; compiler-backend-emit-gep-load-compare-branch-with-phi-copies
;; already builds for the unfolded compare: each edge's copies become their own
;; block, the branch jumps to the edge labels instead of the real successors,
;; and the edge blocks are appended behind the branch. Reusing it costs nothing
;; -- those edge blocks are the very ones the unfolded path emits -- and lets
;; the fold keep shapes with successor phis instead of handing them back whole.
(define (compiler-backend-gep-load-cmp-branch-emit
  [ctx : be_state.CompilerBackendEmissionContext]
  [cmp-asm : String]
  [true-jcc : String]
  [false-jcc : String]
  [true-label : i64]
  [false-label : i64]
  [branch-fallthrough : be_state.CompilerBackendMaybeLabel]) : be_state.ResultCompilerBackend
  (if (not
    (be_peephole.compiler-backend-branch-needs-phi-copies?
      (be_state.compiler-backend-state-function-state ctx.backend-state)
      true-label
      false-label))
    (Ok
      (str_cat.str-cat
        cmp-asm
        (be_scalar.compiler-backend-emit-compare-branch-jumps
          ctx.function
          true-label
          false-label
          branch-fallthrough
          true-jcc
          false-jcc
          ctx.backend-state)))
    (let
      [true-copies
        (try
          (be_calls.compiler-backend-emit-phi-edge-copies
            ctx.type-segment-bases
            ctx.assignments
            (be_state.compiler-backend-global-shared-view ctx.blocks)
            true-label
            ctx.current-label
            ctx.program-index
            ctx.vars))]
      [false-copies
        (try
          (be_calls.compiler-backend-emit-phi-edge-copies
            ctx.type-segment-bases
            ctx.assignments
            ctx.blocks
            false-label
            ctx.current-label
            ctx.program-index
            ctx.vars))]
      [edges : be_calls.CompilerBackendBranchEdges
        (be_calls.compiler-backend-branch-edges-plan
          ctx.backend-state
          ctx.current-label
          true-label
          false-label
          true-copies
          false-copies
          branch-fallthrough)]
      (Ok
        (be_calls.compiler-backend-emit-branch-edges
          ctx.backend-state
          (be_state.compiler-backend-global-shared-view ctx.function)
          true-label
          false-label
          edges.true-target
          edges.false-target
          edges.true-copies
          edges.false-copies
          branch-fallthrough
          (str_cat.str-cat
            cmp-asm
            (be_scalar.compiler-backend-emit-compare-branch-jumps
              ctx.function
              edges.true-target
              edges.false-target
              edges.fallthrough
              true-jcc
              false-jcc
              ctx.backend-state)))))))

;; M6-D emission: put the base in its staging register FIRST, then build
;; the folded compare and its branch on top -- the same order the unfolded path
;; uses, so the phi-edge copies M6-E may emit still see the identical machine
;; state. `staged-base` is "" whenever the fold spelled a direct address, and
;; then this is just the branch emission. Nothing here runs until the fold has
;; COMMITTED, so the M-D rule holds: no probe that can still decline reaches an
;; emitter.
(define (compiler-backend-gep-load-cmp-emit
  [ctx : be_state.CompilerBackendEmissionContext]
  [staged-value : compiler_ir_types.CompilerIrValue]
  [staged-base : String]
  [cmp-asm : String]
  [true-jcc : String]
  [false-jcc : String]
  [true-label : i64]
  [false-label : i64]
  [branch-fallthrough : be_state.CompilerBackendMaybeLabel]) : be_state.ResultCompilerBackend
  (if (string.eq staged-base "")
    (compiler-backend-gep-load-cmp-branch-emit
      ctx
      cmp-asm
      true-jcc
      false-jcc
      true-label
      false-label
      branch-fallthrough)
    (let
      [stage-asm
        (try
          (be_operand.compiler-backend-emit-load-value
            ctx.assignments
            staged-value
            staged-base
            ctx.backend-state))]
      [body-asm
        (try
          (compiler-backend-gep-load-cmp-branch-emit
            ctx
            cmp-asm
            true-jcc
            false-jcc
            true-label
            false-label
            branch-fallthrough))]
      (Ok (str_cat.str-cat stage-asm body-asm)))))

;; M6-G emission, in M6-D's order: stage the operand the address needs into the
;; load destination's home first, then the widening load into the cast's own
;; register. `staged-base` is "" whenever the fold spelled a direct address.
(define (compiler-backend-gep-load-widen-emit
  [ctx : be_state.CompilerBackendEmissionContext]
  [staged-value : compiler_ir_types.CompilerIrValue]
  [staged-base : String]
  [addr : String]
  [load-ty : compiler_ast_types.AstType]
  [dst-reg : String]) : be_state.ResultCompilerBackend
  (let
    [load-asm : String
      (be_scalar.compiler-backend-emit-load-memory-to-reg
        ctx.type-segment-bases
        addr
        load-ty
        dst-reg)]
    (if (string.eq staged-base "")
      (Ok load-asm)
      (let
        [stage-asm
          (try
            (be_operand.compiler-backend-emit-load-value
              ctx.assignments
              staged-value
              staged-base
              ctx.backend-state))]
        (Ok (str_cat.str-cat stage-asm load-asm))))))

(define (compiler-backend-gep-load-cmp-fold-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [addr : String]
  ;; M6-D: the operand that has to be staged (base or index), the staging
  ;; register, and the address built on it. The last two are "" when the direct
  ;; address already spelled the operand.
  [staged-value : compiler_ir_types.CompilerIrValue]
  [staged-base : String]
  ;; M6-H: true when `staged-base` came from the scavenger's PEEK rather than
  ;; the load destination's home, so the committed emitter has to re-run the
  ;; pick for real (that is what enqueues the emergency save when the pool is
  ;; saturated). See compiler-backend-gep-load-cmp-scavenged-staging-base.
  [staged-scavenged? : bool]
  [staged-addr : String]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepLoadCmpEmission
  (if (or
    (and (string.eq addr "") (string.eq staged-addr ""))
    (be_operand.compiler-backend-float-type? load-ty)
    (not (be_simd.compiler-backend-var-single-use? ctx.use-counts load-dst))
    (>= index instrs.len))
    (No)
    ;; BE-3: the bounds fold takes the M6-D staged address too. A length read
    ;; through a descriptor HANDLE the allocator keeps out of a register --
    ;; `%l = load (gep @g, 1) ; bounds_check %i, %l`, the shape of every checked
    ;; global array read inside a loop that also calls -- has no register-homed
    ;; base, so the direct address is "" and the direct fold declines: `movq
    ;; g(%rip), %r10 ; movq 8(%r10), %rax ; cmpq %rax, %r15`. The staged address
    ;; puts the handle in the length's own (single-use, never otherwise
    ;; written) home and reads the word from there: `movq g(%rip), %rax ; cmpq
    ;; 8(%rax), %r15 ; jb ok`. The abort tail's discipline holds: the staging
    ;; register is a general register (M6-D's staged base excludes %rbp, and
    ;; %rsp is never a home), the tail's first act is the `pushq 8(%rax)`
    ;; re-read of the length while %rax is still the staged handle, and the
    ;; index it reads after that is a register by the probe's own rule.
    ;;
    ;; The SIBLING word. The check is followed, in every such read, by the data
    ;; word of the same handle -- `gep @g, 0 ; load` -- which the ordinary path
    ;; had read off the register it staged the handle into for the length
    ;; (`movq (%r10), %rax`). With the length folded that staging is gone, and
    ;; the sibling would re-materialise the handle (`movq g(%rip), %r10`) and
    ;; give the fold's instruction straight back. So the fold reads the sibling
    ;; word through its own staged register when it stands right behind the
    ;; check -- a single-use gep of the same base at a literal offset feeding a
    ;; full-word scalar load into a register home -- and resumes past both. The
    ;; gep's fold ordinal is consumed as the walker would have consumed it.
    (match (compiler-backend-gep-load-bounds-probe
      (be_state.compiler-backend-global-shared-view ctx)
      (if (string.eq addr "")
        (owned_view.compiler-owned-shared-view staged-addr)
        (owned_view.compiler-owned-shared-view addr))
      load-dst
      (be_state.compiler-backend-global-shared-view load-ty)
      (be_state.compiler-backend-global-shared-view instrs)
      index)
      [(Some length-operand index-operand ok-label after-bounds)
        (let
          [staged? : bool (string.eq addr "")]
          [base-reg : String
            (if staged?
              (if staged-scavenged?
                (compiler-backend-gep-load-cmp-scavenged-staging-base
                  (be_state.compiler-backend-global-shared-view ctx)
                  (be_state.compiler-backend-global-shared-view instrs)
                  index
                  true)
                staged-base)
              "")]
          [sibling : CompilerBackendBoundsSibling
            (if staged?
              (compiler-backend-bounds-fold-sibling
                (be_state.compiler-backend-global-shared-view ctx)
                (be_state.compiler-backend-global-shared-view staged-value)
                (be_state.compiler-backend-global-shared-view base-reg)
                (be_state.compiler-backend-global-shared-view instrs)
                after-bounds)
              (No))]
          [resume : i64
            (match (& sibling)
              [(Some _) (+ after-bounds 2)]
              [(No) after-bounds])]
          (Some
            (compiler-backend-emit-fused-result-rest
              (be_state.compiler-backend-global-shared-view ctx)
              fallthrough
              (match (compiler-backend-emit-gep-load-bounds-fold-staged
                ctx
                staged-value
                base-reg
                length-operand
                index-operand
                ok-label
                (compiler_ir_types.compiler-ir-instr-seq-ref
                  (be_state.compiler-backend-global-shared-view instrs)
                  (- after-bounds 1)))
                [(Ok fold-asm)
                  (Ok
                    (str_cat.str-cat
                      fold-asm
                      (match sibling
                        [(Some load-asm) load-asm]
                        [(No) ""])))]
                [(Err message) (Err message)])
              instrs
              resume
              out)))]
      [(No)
        (match (compiler-backend-gep-load-cmp-branch-probe
          (be_state.compiler-backend-global-shared-view ctx)
          (if (string.eq addr "")
            (owned_view.compiler-owned-shared-view staged-addr)
            (owned_view.compiler-owned-shared-view addr))
          load-dst
          (be_state.compiler-backend-global-shared-view load-ty)
          (be_state.compiler-backend-global-shared-view instrs)
          index)
          [(Some cmp-asm true-jcc false-jcc true-label false-label after-branch)
            (Some
              (compiler-backend-emit-fused-result-rest
                (be_state.compiler-backend-global-shared-view ctx)
                fallthrough
                (compiler-backend-gep-load-cmp-emit
                  (be_state.compiler-backend-global-shared-view ctx)
                  staged-value
                  (if (string.eq addr "")
                    staged-base
                    "")
                  cmp-asm
                  true-jcc
                  false-jcc
                  true-label
                  false-label
                  (compiler-backend-fused-compare-fallthrough
                    instrs
                    after-branch
                    fallthrough))
                (be_state.compiler-backend-global-shared-view instrs)
                after-branch
                out))]
          [(No)
            ;; M6-G last: the compare shapes above retire BOTH instructions of
            ;; the pair, this one retires the re-extension only, so it is only
            ;; ever offered a load neither of them claimed.
            (match (compiler-backend-gep-load-widen-cast-probe
              (be_state.compiler-backend-global-shared-view ctx)
              (if (string.eq addr "")
                (owned_view.compiler-owned-shared-view staged-addr)
                (owned_view.compiler-owned-shared-view addr))
              load-dst
              (be_state.compiler-backend-global-shared-view load-ty)
              (be_state.compiler-backend-global-shared-view instrs)
              index)
              [(Some dst-reg after-cast)
                (Some
                  (compiler-backend-emit-fused-result-rest
                    (be_state.compiler-backend-global-shared-view ctx)
                    fallthrough
                    (compiler-backend-gep-load-widen-emit
                      (be_state.compiler-backend-global-shared-view ctx)
                      staged-value
                      (if (string.eq addr "")
                        (if staged-scavenged?
                          (compiler-backend-gep-load-cmp-scavenged-staging-base
                            ctx
                            (be_state.compiler-backend-global-shared-view
                              instrs)
                            index
                            true)
                          staged-base)
                        "")
                      (if (string.eq addr "")
                        staged-addr
                        addr)
                      load-ty
                      dst-reg)
                    instrs
                    after-cast
                    out))]
              [(No) (No)])])])))

(define (compiler-backend-emit-fused-gep-load-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  ;; M6 first: its probes are pure, and the shapes they claim (bounds-check
  ;; length, compare+branch, narrow compare) are disjoint from the GAP8 ALU
  ;; shapes below, so the order only decides which rule sees the instruction.
  (let
    [direct-addr : String
      (compiler-backend-gep-load-cmp-address
        ctx.backend-state
        ctx.type-segment-bases
        ctx.assignments
        (be_state.compiler-backend-global-shared-view base)
        offset
        (be_state.compiler-backend-global-shared-view elem-ty)
        gep-fold-disp)]
    [home-staged-base : String
      (compiler-backend-gep-load-cmp-staged-base
        (be_state.compiler-backend-global-shared-view ctx)
        load-dst)]
    ;; M6-H: only a spilled load destination reaches the scavenged staging
    ;; register, and only where the direct address already declined -- otherwise
    ;; the "fold" would add a staging `movq` nobody was paying. The single-use
    ;; gate the whole M6 family runs on is re-stated here because it is what
    ;; retires the loaded var, and the fold is pointless without it.
    [staged-scavenged? : bool
      (and
        (string.eq home-staged-base "")
        (string.eq direct-addr "")
        (not (be_operand.compiler-backend-float-type? load-ty))
        (be_simd.compiler-backend-var-single-use? ctx.use-counts load-dst)
        (compiler-backend-gep-load-cmp-staging-shape?
          load-dst
          (be_state.compiler-backend-global-shared-view instrs)
          index))]
    [staged-base : String
      (if staged-scavenged?
        (compiler-backend-gep-load-cmp-scavenged-staging-base
          (be_state.compiler-backend-global-shared-view ctx)
          (be_state.compiler-backend-global-shared-view instrs)
          index
          false)
        home-staged-base)]
    [staged-addr : String
      (compiler-backend-gep-load-cmp-staged-address
        ctx.backend-state
        ctx.type-segment-bases
        ctx.assignments
        (be_state.compiler-backend-global-shared-view base)
        (be_state.compiler-backend-global-shared-view offset)
        (be_state.compiler-backend-global-shared-view elem-ty)
        gep-fold-disp
        direct-addr
        (be_state.compiler-backend-global-shared-view staged-base))]
    (match (compiler-backend-gep-load-cmp-fold-rest
      (be_state.compiler-backend-global-shared-view ctx)
      fallthrough
      direct-addr
      (compiler-backend-gep-load-cmp-staged-value
        ctx.backend-state
        ctx.assignments
        (be_state.compiler-backend-global-shared-view base)
        (be_state.compiler-backend-global-shared-view offset))
      staged-base
      staged-scavenged?
      staged-addr
      load-dst
      (be_state.compiler-backend-global-shared-view load-ty)
      (be_state.compiler-backend-global-shared-view instrs)
      index
      out)
      [(Some result) result]
      [(No)
        (compiler-backend-emit-fused-gep-load-rest-tail
          ctx
          fallthrough
          _gep-dst
          gep-fold-disp
          base
          offset
          elem-ty
          load-dst
          load-ty
          instrs
          index
          out)])))

;; ============================================================================
;; GAP10: memory-destination read-modify-write folding.
;;
;; x86 ALU ops take a MEMORY destination -- `orq %rsi, (%rax,%rcx,8)` reads,
;; combines and writes back in ONE instruction. Without that form
;; `dst[i] = dst[i] op x` lowers to the three-instruction register round trip
;;
;;   movq (%rax,%rcx,8), %r9 / orq (%rdi,%rcx,8), %r9 / movq %r9, (%rax,%rcx,8)
;;
;; where clang emits two (`movq (%rdi,%rcx,8), %rsi; orq %rsi, (%rax,%rcx,8)`),
;; or ONE when the other operand is already a register or an immediate.
;;
;; ADMISSION. The window starts at the gep+load pair this emitter already owns
;; (g0/`a`) and must continue with EXACTLY one of
;;
;;   direct: BinOp c = a op x ; Gep g2 ; StorePtr g2, c              (5 instrs)
;;   memory: Gep g1 ; Load b = g1 ; BinOp c = a op b ;
;;           Gep g2 ; StorePtr g2, c                                 (7 instrs)
;;
;; with `a` and `c` each read exactly once, every absorbed gep single-use, and
;; g2's base/offset/element operands syntactically IDENTICAL to g0's. Matching
;; the window structurally discharges three obligations at once:
;;
;;   * INTERVENING STORES. Nothing but the listed instructions may sit between
;;     the load and the store, and none of them writes memory, so no store to
;;     the folded address can be skipped over.
;;   * TRAPS. A BoundsCheck (or any other instruction) INSIDE the window fails
;;     the match, so nothing that can leave the block is ever moved across the
;;     folded access. Checks that PRECEDE the load are untouched and still
;;     precede it, so the fold fires on checked and check-free bodies alike and
;;     neither gains nor loses a trap: the abort still runs before any memory
;;     operation, exactly where it ran before.
;;   * FLAGS. The memory-destination form sets EFLAGS exactly as the register
;;     form did, on the same result, and the store it replaces wrote none. The
;;     ALU moves at most two instruction slots later and nothing in between
;;     reads or writes flags, so any consumer past the store sees what it saw.
;;
;; ALIASING is syntactic, never a semantic equality proof: the store address is
;; admitted only when it is spelled from the SAME base and index VALUES as the
;; load address, at the same GAP9 displacement. Reordering is safe for the same
;; reason -- the only memory read that moves ahead of the folded read is a LOAD,
;; which cannot change the folded location, and when the two addresses happen to
;; be the same location both orders compute `a op a`.
;;
;; ORDINALS. g0's ordinal was consumed by the dispatch site. This fold consumes
;; g1's and g2's itself, in walk order, and decides admission from
;; `compiler-backend-gep-fold-peek` (PURE) so a decline leaves every remaining
;; ordinal for the ordinary emission to consume exactly once.
;;
;; NARROWER THAN THE SHAPE ALLOWS, deliberately: 64-bit integer operands only
;; (no narrow widths, where the load's extension and the store's truncation stop
;; agreeing), dynamic SIB addressing only, and `imul` excluded (x86 has no
;; memory-destination two-operand form for it).
(define (compiler-backend-gep-rmw-mnemonic
  [op : (& op compiler_ir_types.CompilerIrBinOp)]) : String
  (match op
    [(Add) "add"]
    [(Sub) "sub"]
    [(BitAnd) "and"]
    [(BitOr) "or"]
    [(BitXor) "xor"]
    [_ ""]))

;; `sub` is the only admitted mnemonic that is not commutative, and the memory
;; destination is always the folded LEFT operand, so `x - dst[i]` has no
;; memory-destination spelling at all.
(define (compiler-backend-gep-rmw-commutative?
  [op : (& compiler_ir_types.CompilerIrBinOp)]) : bool
  (match op
    [(Sub) false]
    [_ true]))

;; The operand that is NOT the folded load, or No when the load is not an
;; operand at all (or sits on the right of a non-commutative op).
(defenum CompilerBackendGepRmwOther
  (No)
  (Some compiler_ir_types.CompilerIrValue))

(define (compiler-backend-gep-rmw-other-operand
  [op : (& compiler_ir_types.CompilerIrBinOp)]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [load-dst : i64]) : CompilerBackendGepRmwOther
  (if (be_operand.compiler-backend-branch-uses-var? lhs load-dst)
    (Some rhs)
    (if (and
      (be_operand.compiler-backend-branch-uses-var? rhs load-dst)
      (compiler-backend-gep-rmw-commutative? op))
      (Some lhs)
      (No))))

;; Source spelling for the one-instruction (direct) form: a register home or an
;; imm32. A spilled operand has neither -- x86 cannot take two memory operands
;; -- so it declines and keeps the register round trip.
(define (compiler-backend-gep-rmw-direct-source
  [backend-state : be_state.CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [value : compiler_ir_types.CompilerIrValue]) : String
  (let
    [home : String
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        value)]
    (if (not (string.eq home ""))
      home
      (match (be_operand.compiler-backend-value-as-i64 value)
        [(Some n)
          (if (be_operand.compiler-backend-imm32? n)
            (str_cat.str-cat "$" (string.int->string n))
            "")]
        [(None) ""]))))

;; The folded destination operand, or "" when any component declines: the base
;; must be register-homed and admissible as an address base (#rbp-base: the gep
;; index already occupies the SIB index slot), and the index must be a
;; register-homed dynamic offset.
(define (compiler-backend-gep-rmw-address
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [disp : i64]) : String
  (let
    [base-home : String
      (be_scalar.compiler-backend-address-base-filter
        (be_operand.compiler-backend-value-scalar-register
          backend-state
          assignments
          base))]
    [index-home : String
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        offset)]
    (if (or (string.eq base-home "") (string.eq index-home ""))
      ""
      (be_scalar.compiler-backend-gep-index-address-disp
        disp
        base-home
        (be_operand.compiler-backend-type-size type-segment-bases elem-ty)
        index-home))))

;; Does `reg` spell either component of the address built from base/offset?
;; The staging register is written before both addresses are read, so a hit
;; declines the fold.
(define (compiler-backend-gep-rmw-address-uses-register?
  [backend-state : be_state.CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [reg : (& reg str)]) : bool
  (or
    (string.eq
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        base)
      reg)
    (string.eq
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        offset)
      reg)))

;; Every 64-bit integer condition the fold needs of one value/type pair.
(define (compiler-backend-gep-rmw-word-type?
  [type-segment-bases : i64]
  [ty : (& compiler_ast_types.AstType)]) : bool
  (and
    (= (be_operand.compiler-backend-type-size type-segment-bases ty) 8)
    (not (be_operand.compiler-backend-float-type? ty))))

;; The `Gep g2 ; StorePtr g2, c` tail: g2 must address the same word as g0 and
;; the store must be the ALU result's only reader. Returns the index just past
;; the store, or -1.
(define (compiler-backend-gep-rmw-store-tail
  [ctx : (& ctx be_state.CompilerBackendEmissionContext)]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [alu-dst : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= (+ index 1) instrs.len)
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)
      [(Gep gep-dst2 base2 offset2 elem-ty2)
        (if (and
          (be_simd.compiler-backend-var-single-use? ctx.use-counts gep-dst2)
          (compiler_optimize.opt-value-eq (& base2) (& base))
          (compiler_optimize.opt-value-eq (& offset2) (& offset))
          (=
            (be_operand.compiler-backend-type-size
              ctx.type-segment-bases
              elem-ty2)
            (be_operand.compiler-backend-type-size
              ctx.type-segment-bases
              elem-ty)))
          (match (compiler_ir_types.compiler-ir-instr-seq-borrow
            instrs
            (+ index 1))
            [(StorePtr dst2 value2 store-ty)
              (if (and
                (be_operand.compiler-backend-branch-uses-var? dst2 gep-dst2)
                (be_operand.compiler-backend-branch-uses-var? value2 alu-dst)
                (compiler-backend-gep-rmw-word-type?
                  ctx.type-segment-bases
                  store-ty))
                (+ index 2)
                (- 0 1))]
            [_ (- 0 1)])
          (- 0 1))]
      [_ (- 0 1)])))

(defenum CompilerBackendMaybeGepRmwEmission
  (No)
  (Some be_state.ResultCompilerBackend))

;; The one-instruction form: the other operand is already a register or an
;; immediate, so the whole `load; op; store` triple becomes `op src, (mem)`.
;; No staging register is written, so there is nothing to exclude -- the
;; destination's base and index are only READ by the folded instruction, and
;; reading them from a register that also spells the source is harmless.
;;
;; PROBE COST. Every fused gep+load in the program reaches this rule, and only a
;; handful are read-modify-writes, so the tests are ordered cheapest-and-most-
;; selective first and NOTHING that allocates runs until the shape has already
;; matched. Building the destination operand up front instead would pay a
;; `str-cat` over five pieces per gep+load, almost always thrown away.
(define (compiler-backend-emit-gep-rmw-direct-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [alu-dst : i64]
  [op : (& compiler_ir_types.CompilerIrBinOp)]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [alu-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepRmwEmission
  (let
    [mnem : String (compiler-backend-gep-rmw-mnemonic op)]
    (if (or
      (string.eq mnem "")
      (not (be_simd.compiler-backend-var-single-use? ctx.use-counts load-dst))
      (not (be_simd.compiler-backend-var-single-use? ctx.use-counts alu-dst))
      (not (compiler-backend-gep-rmw-word-type? ctx.type-segment-bases alu-ty)))
      (No)
      (let
        [after-store : i64
          (compiler-backend-gep-rmw-store-tail
            ctx
            (be_state.compiler-backend-global-shared-view base)
            (be_state.compiler-backend-global-shared-view offset)
            (be_state.compiler-backend-global-shared-view elem-ty)
            alu-dst
            (be_state.compiler-backend-global-shared-view instrs)
            index)]
        (if (or
          (< after-store 0)
          (be_scalar.compiler-backend-binop-f64?
            ctx.types
            (be_state.compiler-backend-global-shared-view ctx.global-types)
            lhs
            rhs
            alu-ty)
          ;; g2's displacement decides whether the store really addresses the
          ;; word the load read. Peeked, not consumed: a mismatch must decline
          ;; without touching the cursor.
          (not
            (=
              (compiler-backend-gep-fold-peek
                ctx.function-state
                ctx.type-segment-bases
                0
                offset
                elem-ty)
              gep-fold-disp)))
          (No)
          (let
            [src : String
              (match (compiler-backend-gep-rmw-other-operand
                op
                lhs
                rhs
                load-dst)
                [(Some other)
                  (compiler-backend-gep-rmw-direct-source
                    ctx.backend-state
                    ctx.assignments
                    other)]
                [(No) ""])]
            (if (string.eq src "")
              (No)
              (let
                [addr : String
                  (compiler-backend-gep-rmw-address
                    ctx.backend-state
                    ctx.type-segment-bases
                    ctx.assignments
                    base
                    (be_state.compiler-backend-global-shared-view offset)
                    (be_state.compiler-backend-global-shared-view elem-ty)
                    gep-fold-disp)]
                (if (string.eq addr "")
                  (No)
                  (let
                    [_g2 : i64
                      (compiler-backend-gep-fold-next!
                        ctx.function-state
                        ctx.type-segment-bases
                        offset
                        elem-ty)]
                    (Some
                      (compiler-backend-emit-fused-result-rest
                        ctx
                        fallthrough
                        (Ok
                          (str_cat.str-cat "    " mnem "q " src ", " addr "\n"))
                        instrs
                        after-store
                        out))))))))))))

;; The two-instruction form: the other operand is a second fused gep+load, so
;; the source word is staged into the ALU result's own home and consumed as the
;; register operand of the memory-destination op. The staging register is
;; WRITTEN before the destination address is read, so it must not spell any
;; component of either address.
(define (compiler-backend-emit-gep-rmw-memory-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [base1 : compiler_ir_types.CompilerIrValue]
  [offset1 : compiler_ir_types.CompilerIrValue]
  [elem-ty1 : compiler_ast_types.AstType]
  [load-dst1 : i64]
  [load-ty1 : (& compiler_ast_types.AstType)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepRmwEmission
  (if (>= index instrs.len)
    (No)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(BinOp alu-dst op lhs rhs alu-ty)
        ;; Same cost discipline as the direct form: cheap structural tests
        ;; first, no allocation until the whole window has matched.
        (let
          [mnem : String (compiler-backend-gep-rmw-mnemonic op)]
          [other-is-load1 : bool
            (match (compiler-backend-gep-rmw-other-operand
              op
              (be_state.compiler-backend-global-shared-view lhs)
              (be_state.compiler-backend-global-shared-view rhs)
              load-dst)
              [(Some other)
                (be_operand.compiler-backend-branch-uses-var? other load-dst1)]
              [(No) false])]
          (if (or
            (string.eq mnem "")
            (not other-is-load1)
            (not
              (be_simd.compiler-backend-var-single-use? ctx.use-counts load-dst))
            (not
              (be_simd.compiler-backend-var-single-use?
                ctx.use-counts
                load-dst1))
            (not
              (be_simd.compiler-backend-var-single-use? ctx.use-counts alu-dst))
            (not
              (compiler-backend-gep-rmw-word-type?
                ctx.type-segment-bases
                load-ty1))
            (not
              (compiler-backend-gep-rmw-word-type?
                ctx.type-segment-bases
                alu-ty)))
            (No)
            (let
              [after-store : i64
                (compiler-backend-gep-rmw-store-tail
                  ctx
                  (be_state.compiler-backend-global-shared-view base)
                  (be_state.compiler-backend-global-shared-view offset)
                  (be_state.compiler-backend-global-shared-view elem-ty)
                  alu-dst
                  (be_state.compiler-backend-global-shared-view instrs)
                  (+ index 1))]
              [stage : String
                (be_scalar.compiler-backend-var-register-home
                  ctx.backend-state
                  ctx.assignments
                  alu-dst)]
              (if (or
                (< after-store 0)
                (string.eq stage "")
                (be_scalar.compiler-backend-binop-f64?
                  ctx.types
                  (be_state.compiler-backend-global-shared-view
                    ctx.global-types)
                  lhs
                  rhs
                  alu-ty)
                (compiler-backend-gep-rmw-address-uses-register?
                  ctx.backend-state
                  ctx.assignments
                  (be_state.compiler-backend-global-shared-view base)
                  (be_state.compiler-backend-global-shared-view offset)
                  stage)
                (compiler-backend-gep-rmw-address-uses-register?
                  ctx.backend-state
                  ctx.assignments
                  (be_state.compiler-backend-global-shared-view base1)
                  (be_state.compiler-backend-global-shared-view offset1)
                  stage)
                (not
                  (=
                    (compiler-backend-gep-fold-peek
                      ctx.function-state
                      ctx.type-segment-bases
                      1
                      offset
                      elem-ty)
                    gep-fold-disp)))
                (No)
                (let
                  [addr : String
                    (compiler-backend-gep-rmw-address
                      ctx.backend-state
                      ctx.type-segment-bases
                      ctx.assignments
                      base
                      (be_state.compiler-backend-global-shared-view offset)
                      (be_state.compiler-backend-global-shared-view elem-ty)
                      gep-fold-disp)]
                  [addr1 : String
                    (compiler-backend-gep-rmw-address
                      ctx.backend-state
                      ctx.type-segment-bases
                      ctx.assignments
                      base1
                      (be_state.compiler-backend-global-shared-view offset1)
                      (be_state.compiler-backend-global-shared-view elem-ty1)
                      (compiler-backend-gep-fold-peek
                        ctx.function-state
                        ctx.type-segment-bases
                        0
                        offset1
                        elem-ty1))]
                  (if (or (string.eq addr "") (string.eq addr1 ""))
                    (No)
                    (let
                      [_g1 : i64
                        (compiler-backend-gep-fold-next!
                          ctx.function-state
                          ctx.type-segment-bases
                          offset1
                          elem-ty1)]
                      [_g2 : i64
                        (compiler-backend-gep-fold-next!
                          ctx.function-state
                          ctx.type-segment-bases
                          offset
                          elem-ty)]
                      (Some
                        (compiler-backend-emit-fused-result-rest
                          ctx
                          fallthrough
                          (Ok
                            (str_cat.str-cat
                              "    movq "
                              addr1
                              ", "
                              stage
                              "\n    "
                              mnem
                              "q "
                              stage
                              ", "
                              addr
                              "\n"))
                          instrs
                          after-store
                          out)))))))))]
      [_ (No)])))

;; The fold's entry point: dispatch on what follows the gep+load pair.
(define (compiler-backend-emit-gep-rmw-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepRmwEmission
  ;; A constant gep offset addresses through the base register alone, which this
  ;; fold does not spell; the dynamic SIB form is the whole admitted family.
  ;; That value match is the cheapest test available and it retires every
  ;; constant-offset field access in the program before any type is measured.
  (if (>= index instrs.len)
    (No)
    (match (be_operand.compiler-backend-value-as-i64 offset)
      [(Some _) (No)]
      [(None)
        (if (not
          (compiler-backend-gep-rmw-word-type? ctx.type-segment-bases load-ty))
          (No)
          (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
            [(BinOp alu-dst op lhs rhs alu-ty)
              (compiler-backend-emit-gep-rmw-direct-rest
                ctx
                fallthrough
                gep-fold-disp
                base
                offset
                elem-ty
                load-dst
                alu-dst
                op
                lhs
                rhs
                alu-ty
                instrs
                (+ index 1)
                out)]
            [(Gep gep-dst1 base1 offset1 elem-ty1)
              (if (and
                (be_simd.compiler-backend-var-single-use?
                  ctx.use-counts
                  gep-dst1)
                (< (+ index 1) instrs.len))
                (match (compiler_ir_types.compiler-ir-instr-seq-ref
                  instrs
                  (+ index 1))
                  [(Load load-dst1 src1 load-ty1)
                    (if (be_operand.compiler-backend-branch-uses-var?
                      src1
                      gep-dst1)
                      (match (be_operand.compiler-backend-value-as-i64 offset1)
                        [(Some _) (No)]
                        [(None)
                          (compiler-backend-emit-gep-rmw-memory-rest
                            ctx
                            fallthrough
                            gep-fold-disp
                            base
                            offset
                            elem-ty
                            load-dst
                            base1
                            offset1
                            elem-ty1
                            load-dst1
                            load-ty1
                            instrs
                            (+ index 2)
                            out)])
                      (No))]
                  [_ (No)])
                (No))]
            [_ (No)]))])))

(define (compiler-backend-emit-fused-gep-load-rest-tail
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  ;; GAP10 first: it is the only rule here that retires the STORE as well, so a
  ;; window it claims would otherwise be split across two rules that each emit
  ;; one instruction more than the pair needs. Every rule below is offered the
  ;; window untouched -- GAP10's probe consumes no ordinal until it commits.
  (match (compiler-backend-emit-gep-rmw-rest
    (be_state.compiler-backend-global-shared-view ctx)
    fallthrough
    gep-fold-disp
    (be_state.compiler-backend-global-shared-view base)
    (be_state.compiler-backend-global-shared-view offset)
    (be_state.compiler-backend-global-shared-view elem-ty)
    load-dst
    (be_state.compiler-backend-global-shared-view load-ty)
    (be_state.compiler-backend-global-shared-view instrs)
    index
    out)
    [(Some result) result]
    [(No)
      (compiler-backend-emit-fused-gep-load-rest-alu-tail
        ctx
        fallthrough
        _gep-dst
        gep-fold-disp
        base
        offset
        elem-ty
        load-dst
        load-ty
        instrs
        index
        out)]))

(define (compiler-backend-emit-fused-gep-load-rest-alu-tail
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  ;; GAP8 ALU fold first: the probe is side-effect-free, so a rejection costs
  ;; nothing and falls through to the existing single/pair load fusion.
  (match (compiler-backend-gep-load-alu-probe
    ctx.backend-state
    ctx.type-segment-bases
    ctx.assignments
    ctx.types
    (be_state.compiler-backend-global-shared-view ctx.global-types)
    ctx.use-counts
    (be_state.compiler-backend-global-shared-view base)
    (be_state.compiler-backend-global-shared-view offset)
    load-dst
    (be_state.compiler-backend-global-shared-view load-ty)
    (be_state.compiler-backend-global-shared-view instrs)
    index)
    [(Some mnem alu-dst x after-binop)
      (compiler-backend-emit-fused-result-rest
        (be_state.compiler-backend-global-shared-view ctx)
        fallthrough
        (compiler-backend-emit-gep-load-alu
          ctx.type-segment-bases
          ctx.assignments
          mnem
          alu-dst
          x
          base
          offset
          elem-ty
          gep-fold-disp
          ctx.backend-state)
        instrs
        after-binop
        out)]
    [(No)
      (match (compiler-backend-emit-dynamic-gep-load-pair-alu-rest
        (be_state.compiler-backend-global-shared-view ctx)
        fallthrough
        gep-fold-disp
        (be_state.compiler-backend-global-shared-view base)
        (be_state.compiler-backend-global-shared-view offset)
        (be_state.compiler-backend-global-shared-view elem-ty)
        load-dst
        (be_state.compiler-backend-global-shared-view load-ty)
        (be_state.compiler-backend-global-shared-view instrs)
        index
        out)
        [(Some result) result]
        [(No)
          (compiler-backend-emit-fused-gep-load-plain-rest
            ctx
            fallthrough
            _gep-dst
            gep-fold-disp
            base
            offset
            elem-ty
            load-dst
            load-ty
            instrs
            index
            out)])]))

(define (compiler-backend-emit-fused-gep-load-plain-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  ;; M-D emergency-leak fix: the single gep+load emission is inlined at each
  ;; fallthrough site instead of being computed SPECULATIVELY up front.
  ;; emit-load-from-gep scavenges a base register; under full occupancy that
  ;; scavenge EMERGENCY-adds the picked register to the global pending set as
  ;; a side effect. The speculative single asm was discarded on the PAIR path,
  ;; but its pending registers leaked into the pair wrap, whose stray trailing
  ;; restore overwrote the pair's second loaded result (lex-parse-based-int:
  ;; string len in %r9 restored-over before its bounds compare -> false OOB
  ;; abort on every mid-band self-host build).
  (match (be_operand.compiler-backend-value-as-i64 offset)
    [(Some n)
      (if (< index instrs.len)
        (let
          [maybe-gep (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
          [after-gep : i64 (+ index 1)]
          (match maybe-gep
            [(Gep gep-dst2 base2 offset2 elem-ty2)
              (if (and
                (be_simd.compiler-backend-var-single-use?
                  ctx.use-counts
                  gep-dst2)
                (compiler_optimize.opt-value-eq (& base2) (& base)))
                (match (be_operand.compiler-backend-value-as-i64 offset2)
                  [(Some n2)
                    (if (and
                      (< after-gep instrs.len)
                      (be_operand.compiler-backend-imm32?
                        (*
                          n
                          (be_operand.compiler-backend-type-size
                            ctx.type-segment-bases
                            elem-ty)))
                      (be_operand.compiler-backend-imm32?
                        (*
                          n2
                          (be_operand.compiler-backend-type-size
                            ctx.type-segment-bases
                            elem-ty2))))
                      (let
                        [maybe-load
                          (compiler_ir_types.compiler-ir-instr-seq-ref
                            instrs
                            after-gep)]
                        [after-load2 : i64 (+ after-gep 1)]
                        (match maybe-load
                          [(Load load-dst2 src2 load-ty2)
                            (if (and
                              (be_operand.compiler-backend-branch-uses-var?
                                src2
                                gep-dst2)
                              (not
                                (and
                                  (compiler-backend-load-compare-type?
                                    ctx.type-segment-bases
                                    load-ty2)
                                  (be_simd.compiler-backend-var-single-use?
                                    ctx.use-counts
                                    load-dst2)
                                  (or
                                    (compiler-backend-rest-starts-load-compare-branch?
                                      (be_state.compiler-backend-global-shared-view
                                        instrs)
                                      after-load2
                                      load-dst2
                                      ctx.types
                                      (be_state.compiler-backend-global-shared-view
                                        ctx.global-types)
                                      ctx.use-counts)
                                    ;; M6-A: `.ptr` and `.len` of the same
                                    ;; string/vector are the canonical pair, and
                                    ;; `.len` is almost always the bounds
                                    ;; check's length operand right behind it.
                                    (compiler-backend-gep-load-bounds-foldable?
                                      (be_state.compiler-backend-global-shared-view
                                        ctx)
                                      (be_state.compiler-backend-global-shared-view
                                        base)
                                      offset2
                                      (be_state.compiler-backend-global-shared-view
                                        elem-ty2)
                                      load-dst2
                                      (be_state.compiler-backend-global-shared-view
                                        load-ty2)
                                      (be_state.compiler-backend-global-shared-view
                                        instrs)
                                      after-load2)))))
                              (let
                                ;; GAP9: the pair consumes a SECOND gep;
                                ;; advance its ordinal before either pair path.
                                [gep-fold-disp2 : i64
                                  (compiler-backend-gep-fold-next!
                                    ctx.function-state
                                    ctx.type-segment-bases
                                    offset2
                                    elem-ty2)]
                                (match (compiler-backend-gep-load-pair-alu-probe
                                  ctx.backend-state
                                  ctx.type-segment-bases
                                  ctx.assignments
                                  ctx.types
                                  (be_state.compiler-backend-global-shared-view
                                    ctx.global-types)
                                  ctx.use-counts
                                  (be_state.compiler-backend-global-shared-view
                                    base)
                                  (be_state.compiler-backend-global-shared-view
                                    offset)
                                  (be_state.compiler-backend-global-shared-view
                                    elem-ty)
                                  gep-fold-disp
                                  load-dst
                                  (be_state.compiler-backend-global-shared-view
                                    load-ty)
                                  offset2
                                  elem-ty2
                                  gep-fold-disp2
                                  load-dst2
                                  load-ty2
                                  (be_state.compiler-backend-global-shared-view
                                    instrs)
                                  after-load2)
                                  [(Some mnem alu-dst addr0 addr1 after-binop)
                                    (compiler-backend-emit-fused-result-rest
                                      (be_state.compiler-backend-global-shared-view
                                        ctx)
                                      fallthrough
                                      (compiler-backend-emit-gep-load-pair-alu
                                        ctx.backend-state
                                        ctx.assignments
                                        mnem
                                        alu-dst
                                        addr0
                                        addr1)
                                      instrs
                                      after-binop
                                      out)]
                                  [(No)
                                    (compiler-backend-emit-fused-result-rest
                                      (be_state.compiler-backend-global-shared-view
                                        ctx)
                                      fallthrough
                                      (be_scalar.compiler-backend-emit-load-from-gep-pair
                                        ctx.type-segment-bases
                                        ctx.assignments
                                        base
                                        offset
                                        elem-ty
                                        load-dst
                                        load-ty
                                        offset2
                                        elem-ty2
                                        load-dst2
                                        load-ty2
                                        ctx.backend-state)
                                      instrs
                                      after-load2
                                      out)]))
                              (compiler-backend-emit-fused-result-rest
                                (be_state.compiler-backend-global-shared-view
                                  ctx)
                                fallthrough
                                (be_scalar.compiler-backend-emit-load-from-gep
                                  ctx.type-segment-bases
                                  ctx.assignments
                                  load-dst
                                  base
                                  offset
                                  elem-ty
                                  load-ty
                                  gep-fold-disp
                                  ctx.backend-state)
                                instrs
                                index
                                out))]
                          [_
                            (compiler-backend-emit-fused-result-rest
                              (be_state.compiler-backend-global-shared-view ctx)
                              fallthrough
                              (be_scalar.compiler-backend-emit-load-from-gep
                                ctx.type-segment-bases
                                ctx.assignments
                                load-dst
                                base
                                offset
                                elem-ty
                                load-ty
                                gep-fold-disp
                                ctx.backend-state)
                              instrs
                              index
                              out)]))
                      (compiler-backend-emit-fused-result-rest
                        (be_state.compiler-backend-global-shared-view ctx)
                        fallthrough
                        (be_scalar.compiler-backend-emit-load-from-gep
                          ctx.type-segment-bases
                          ctx.assignments
                          load-dst
                          base
                          offset
                          elem-ty
                          load-ty
                          gep-fold-disp
                          ctx.backend-state)
                        instrs
                        index
                        out))]
                  [(None)
                    (compiler-backend-emit-fused-result-rest
                      (be_state.compiler-backend-global-shared-view ctx)
                      fallthrough
                      (be_scalar.compiler-backend-emit-load-from-gep
                        ctx.type-segment-bases
                        ctx.assignments
                        load-dst
                        base
                        offset
                        elem-ty
                        load-ty
                        gep-fold-disp
                        ctx.backend-state)
                      instrs
                      index
                      out)])
                (compiler-backend-emit-fused-result-rest
                  (be_state.compiler-backend-global-shared-view ctx)
                  fallthrough
                  (be_scalar.compiler-backend-emit-load-from-gep
                    ctx.type-segment-bases
                    ctx.assignments
                    load-dst
                    base
                    offset
                    elem-ty
                    load-ty
                    gep-fold-disp
                    ctx.backend-state)
                  instrs
                  index
                  out))]
            [_
              (compiler-backend-emit-fused-result-rest
                (be_state.compiler-backend-global-shared-view ctx)
                fallthrough
                (be_scalar.compiler-backend-emit-load-from-gep
                  ctx.type-segment-bases
                  ctx.assignments
                  load-dst
                  base
                  offset
                  elem-ty
                  load-ty
                  gep-fold-disp
                  ctx.backend-state)
                instrs
                index
                out)]))
        (compiler-backend-emit-fused-result-rest
          (be_state.compiler-backend-global-shared-view ctx)
          fallthrough
          (be_scalar.compiler-backend-emit-load-from-gep
            ctx.type-segment-bases
            ctx.assignments
            load-dst
            base
            offset
            elem-ty
            load-ty
            gep-fold-disp
            ctx.backend-state)
          instrs
          index
          out))]
    [(None)
      (compiler-backend-emit-fused-result-rest
        (be_state.compiler-backend-global-shared-view ctx)
        fallthrough
        (be_scalar.compiler-backend-emit-load-from-gep
          ctx.type-segment-bases
          ctx.assignments
          load-dst
          base
          offset
          elem-ty
          load-ty
          gep-fold-disp
          ctx.backend-state)
        instrs
        index
        out)]))

(define (compiler-backend-emit-fused-gep-store-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [gep-dst : i64]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [value : (& compiler_ir_types.CompilerIrValue)]
  [store-ty : (& compiler_ast_types.AstType)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (match (be_scalar.compiler-backend-emit-store-to-gep
    ctx.type-segment-bases
    ctx.assignments
    (be_state.compiler-backend-global-shared-view base)
    (be_state.compiler-backend-global-shared-view offset)
    (be_state.compiler-backend-global-shared-view elem-ty)
    value
    store-ty
    ctx.program-index
    gep-fold-disp
    ctx.backend-state)
    [(Ok head)
      (be_state.compiler-backend-asm-append
        out
        (be_scalar.compiler-backend-emergency-wrap head ctx.backend-state))
      (compiler-backend-emit-instrs ctx fallthrough instrs index out)]
    [(Err message)
      (be_state.compiler-backend-instr-error-from
        (be_state.compiler-backend-instr-diagnostic
          ctx.spans
          ctx.source-function
          (Gep gep-dst base offset elem-ty)
          ctx.func-diag)
        message)]))

(define (compiler-backend-emit-fused-mov-trivial-phi-return-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [target-label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (match (be_calls.compiler-backend-emit-mov-trivial-phi-return-edge
    ctx.type-segment-bases
    ctx.source-function
    ctx.blocks
    target-label
    ctx.current-label
    ctx.assignments
    ctx.vars
    (be_state.compiler-backend-global-shared-view ctx.ret-ty)
    dst
    (be_state.compiler-backend-global-shared-view src)
    ctx.program-index)
    [(Ok direct-return)
      (if (string.eq direct-return "")
        (if (be_simd.compiler-backend-var-single-use? ctx.use-counts dst)
          (match (be_calls.compiler-backend-emit-mov-phi-copy-edge
            ctx.type-segment-bases
            ctx.assignments
            (be_state.compiler-backend-global-shared-view ctx.blocks)
            target-label
            ctx.current-label
            dst
            (be_state.compiler-backend-global-shared-view src)
            ctx.program-index
            ctx.vars)
            [(Ok fused-copies)
              (if (string.eq fused-copies "")
                (compiler-backend-emit-instrs-normal
                  (be_state.compiler-backend-global-shared-view ctx)
                  fallthrough
                  (Mov dst src ty)
                  instrs
                  (- index 1)
                  out)
                (match (be_calls.compiler-backend-emit-trivial-phi-return-edge
                  ctx.type-segment-bases
                  ctx.source-function
                  (be_state.compiler-backend-global-shared-view ctx.blocks)
                  target-label
                  ctx.current-label
                  ctx.assignments
                  ctx.vars
                  (be_state.compiler-backend-global-shared-view ctx.ret-ty)
                  ctx.program-index)
                  [(Ok plain-direct-return)
                    (be_state.compiler-backend-asm-append
                      out
                      (if (string.eq plain-direct-return "")
                        (str_cat.str-cat
                          fused-copies
                          (if (be_scalar.compiler-backend-jump-target-is-fallthrough?
                            target-label
                            fallthrough)
                            ""
                            (be_scalar.compiler-backend-jump-label
                              (be_state.compiler-backend-global-shared-view
                                ctx.function)
                              target-label)))
                        plain-direct-return))
                    (compiler-backend-emit-instrs
                      (be_state.compiler-backend-global-shared-view ctx)
                      fallthrough
                      instrs
                      index
                      out)]
                  [(Err message)
                    (be_state.compiler-backend-instr-error-from
                      (be_state.compiler-backend-instr-diagnostic
                        (be_state.compiler-backend-global-shared-view ctx.spans)
                        ctx.source-function
                        (Mov dst src ty)
                        (be_state.compiler-backend-global-shared-view
                          ctx.func-diag))
                      message)]))]
            [(Err message)
              (be_state.compiler-backend-instr-error-from
                (be_state.compiler-backend-instr-diagnostic
                  (be_state.compiler-backend-global-shared-view ctx.spans)
                  ctx.source-function
                  (Mov dst src ty)
                  (be_state.compiler-backend-global-shared-view ctx.func-diag))
                message)])
          (compiler-backend-emit-instrs-normal
            (be_state.compiler-backend-global-shared-view ctx)
            fallthrough
            (Mov dst src ty)
            instrs
            (- index 1)
            out))
        (begin
          (be_scalar.compiler-backend-emergency-append
            out
            direct-return
            ctx.backend-state)
          (compiler-backend-emit-instrs
            (be_state.compiler-backend-global-shared-view ctx)
            fallthrough
            instrs
            index
            out)))]
    [(Err message)
      (be_state.compiler-backend-instr-error-from
        (be_state.compiler-backend-instr-diagnostic
          ctx.spans
          ctx.source-function
          (Mov dst src ty)
          ctx.func-diag)
        message)]))

(define (compiler-backend-emit-call-return
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [name : i64]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [vars : i64]
  [plan : be_state.CompilerBackendRuntimePlan]
  [_functions : compiler_ir_types.CompilerIrFunctionSeq]
  [_externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]) : be_state.ResultCompilerBackend
  (let
    [convention : compiler_abi.CompilerCallConvention
      (compiler_regalloc.compiler-reg-direct-call-convention name)]
    [call-symbol : String
      (be_operand.compiler-backend-call-symbol-index name plan program-index)]
    [inline-memory-name : String
      (if (and
        (be_state.compiler-backend-state-emission-target-policy
          program-index.backend-state).windows
        (be_operand.compiler-backend-index-c-export? program-index name))
        (be_operand.compiler-backend-index-extern-link-symbol
          program-index
          name)
        (be_calls.compiler-backend-inline-memory-call-target
          (be_state.compiler-backend-symbol-text-index program-index name)
          (be_state.compiler-backend-global-shared-view call-symbol)))]
    [extern-call-info : i64
      (be_operand.compiler-backend-index-extern-call-info program-index name)]
    [param-types : compiler_ast_types.AstTypeList
      (be_calls.compiler-backend-call-param-types-for-call
        type-segment-bases
        name
        (be_state.compiler-backend-global-shared-view args)
        types
        global-types
        extern-call-info
        program-index)]
    [c-abi? : bool
      (be_facts.compiler-backend-extern-call-info-aggregate-params?
        extern-call-info)]
    [call-space : i64
      (be_operand.compiler-backend-call-arg-space
        target
        args
        param-types
        c-abi?
        program-index)]
    (match (be_calls.compiler-backend-emit-call-args
      type-segment-bases
      target
      convention
      assignments
      args
      (be_state.compiler-backend-global-shared-view param-types)
      c-abi?
      0
      0
      0
      0
      0
      instr-diag
      program-index
      vars
      program-index.backend-state)
      [(Ok args-asm)
        (if (and
          (be_calls.compiler-backend-tls-current-arena-call-id? name)
          (not
            (be_operand.compiler-backend-index-function-defines?
              program-index
              name)))
          (match (be_calls.compiler-backend-tls-current-arena-inline-asm
            target
            convention
            name
            (be_state.compiler-backend-state-library-object?
              program-index.backend-state)
            (be_state.compiler-backend-global-shared-view instr-diag))
            [(Ok inline-asm)
              (Ok
                (str_cat.str-cat
                  (be_operand.compiler-backend-emit-call-space-sub call-space)
                  args-asm
                  inline-asm
                  (be_operand.compiler-backend-emit-call-space-add call-space)
                  (be_scalar.compiler-backend-return-tail
                    program-index.backend-state
                    source-function
                    assignments
                    vars
                    blocks)))]
            [(Err message)
              (be_state.compiler-backend-instr-error-from instr-diag message)])
          (if (be_facts.compiler-backend-inline-memory-call-name?
            inline-memory-name)
            (Ok
              (str_cat.str-cat
                (be_operand.compiler-backend-emit-call-space-sub call-space)
                args-asm
                (be_calls.compiler-backend-inline-memory-call-asm
                  target
                  convention
                  inline-memory-name)
                (be_operand.compiler-backend-emit-call-space-add call-space)
                (be_scalar.compiler-backend-return-tail
                  program-index.backend-state
                  source-function
                  assignments
                  vars
                  blocks)))
            (Ok
              (str_cat.str-cat
                (be_operand.compiler-backend-emit-call-space-sub call-space)
                args-asm
                (be_calls.compiler-backend-varargs-pre-call
                  type-segment-bases
                  target
                  extern-call-info
                  param-types)
                (str_cat.str-cat
                  "    call "
                  call-symbol
                  "\n"
                  (str_cat.str-cat
                    (be_operand.compiler-backend-emit-call-space-add call-space)
                    (be_scalar.compiler-backend-return-tail
                      program-index.backend-state
                      source-function
                      assignments
                      vars
                      blocks))
                  "")))))]
      [(Err message)
        (be_state.compiler-backend-instr-error-from instr-diag message)])))

(define (compiler-backend-top-level-structural-source-type?
  [type-segment-bases : i64]
  [ty : compiler_ast_types.AstType]) : bool
  (match ty
    [(Region _ inner)
      (compiler-backend-top-level-structural-source-type?
        type-segment-bases
        (compiler_ast_types.ast-type-segment-bases-get type-segment-bases inner))]
    [(or (Tuple _) (Array _ _)) true]
    [_ false]))

(define (compiler-backend-type-list-has-top-level-structural-source-at?
  [type-segment-bases : i64]
  [types : (& types compiler_ast_types.AstTypeList)]) : bool
  (for [index (iterator.range 0 (compiler_ast_types.ast-type-list-len types))]
    (when
      (compiler-backend-top-level-structural-source-type?
        type-segment-bases
        (compiler_ast_types.ast-type-segment-bases-get
          type-segment-bases
          (compiler_ast_types.ast-type-list-get
            types
            index
            (compiler_ast_types.ast-type-id-fallback))))
      (return true))
    unit)
  false)

(define (compiler-backend-effective-normal-indirect-param-types
  [type-segment-bases : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [_functions : (& _functions compiler_ir_types.CompilerIrFunctionSeq)]
  [_externs : (& _externs compiler_ir_types.CompilerIrExternSeq)]
  [program-index : be_state.CompilerBackendProgramIndex]) : compiler_ast_types.AstTypeList
  (let
    [declared : compiler_ast_types.AstTypeList
      (be_calls.compiler-backend-indirect-call-param-types
        type-segment-bases
        types
        (be_state.compiler-backend-global-shared-view func)
        program-index)]
    (match func
      ;; A known function's program-index signature is already the physical
      ;; ABI list (including hidden structural results), so never substitute
      ;; actual source-var types for it.
      [(Function _) declared]
      [_
        (if (or
          (not
            (=
              (be_facts.compiler-backend-call-args-count
                (be_state.compiler-backend-global-shared-view args))
              (be_facts.compiler-backend-type-list-count declared)))
          (compiler-backend-type-list-has-top-level-structural-source-at?
            type-segment-bases
            (& declared)))
          (be_calls.compiler-backend-call-actual-param-types
            type-segment-bases
            types
            (Empty)
            args)
          declared)])))

(define (compiler-backend-indirect-tail-call-register-only?
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [types : (& types compiler_ast_types.AstTypeList)]
  [program-index : be_state.CompilerBackendProgramIndex]) : bool
  (=
    (be_calls.compiler-backend-call-stack-arg-count
      type-segment-bases
      target
      (Internal)
      args
      types
      false
      0
      1
      0
      1
      0
      program-index)
    0))

(define (compiler-backend-scavenge-tail-call-target-reg
  [backend-state : be_state.CompilerBackendState]) : String
  ;; Tail jumps restore callee-saved homes before the final jmp. Keep the closure
  ;; pointer in a pooled caller-saved non-arg candidate instead.
  (be_operand.compiler-backend-scavenge-reg-here
    (be_scalar.compiler-backend-c-abi-stage-exclude-with "%r11")
    be_scalar.compiler-backend-c-abi-stage-exclude-count
    "%r10"
    backend-state))

(define (compiler-backend-indirect-call-callee-arg-overlap?
  [target : be_state.CompilerBackendTarget]
  [convention : compiler_abi.CompilerCallConvention]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [backend-state : be_state.CompilerBackendState]) : bool
  (let
    [home : String
      (be_facts.compiler-backend-value-register-home
        backend-state
        assignments
        func)]
    [index : i64 1]
    [overlap : bool false]
    ;; Slot zero is the hidden closure environment. Conservatively scan the
    ;; remaining GP argument bank whenever there is an explicit argument: a
    ;; register-group can consume more than one slot, while float-only calls
    ;; merely take this uncommon preservation path unnecessarily.
    (while (and
      (>
        (be_facts.compiler-backend-call-args-count
          (be_state.compiler-backend-global-shared-view args))
        0)
      (<
        index
        (be_facts.compiler-backend-call-register-count target convention))
      (not overlap))
      (match (be_facts.compiler-backend-target-arg-reg target convention index)
        [(Ok reg) (set! overlap (string.eq home reg))]
        [(Err _) unit])
      (+= index 1))
    overlap))

(define (compiler-backend-emit-indirect-call-with-arg-assignments
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [dst : i64]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [arg-assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [functions : (& functions compiler_ir_types.CompilerIrFunctionSeq)]
  [externs : (& externs compiler_ir_types.CompilerIrExternSeq)]
  [program-index : be_state.CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [param-types : compiler_ast_types.AstTypeList
      (compiler-backend-effective-normal-indirect-param-types
        type-segment-bases
        types
        (be_state.compiler-backend-global-shared-view func)
        (be_state.compiler-backend-global-shared-view args)
        functions
        externs
        program-index)]
    [effective-arg-assignments : compiler_regalloc.CompilerRegAssignmentTable
      (if (be_calls.compiler-backend-declared-first-call-arg-accepts-rax-forward?
        type-segment-bases
        program-index
        param-types)
        arg-assignments
        assignments)]
    ;; Dense-index override mirroring effective-arg-assignments: the
    ;; rax-forward insert reaches the arg emitters exactly when the declared
    ;; first arg accepts the forward.
    [effective-arg-override : i64
      (if (be_calls.compiler-backend-declared-first-call-arg-accepts-rax-forward?
        type-segment-bases
        program-index
        param-types)
        (be_simd.compiler-backend-function-state-rax-forward-pending-var
          backend-state)
        -1)]
    [call-space : i64
      (compiler-backend-closure-call-arg-space
        target
        args
        param-types
        program-index)]
    (match (be_calls.compiler-backend-emit-call-args-with-override
      type-segment-bases
      effective-arg-override
      target
      (Internal)
      effective-arg-assignments
      (be_state.compiler-backend-global-shared-view args)
      param-types
      false
      0
      1
      0
      1
      0
      (be_state.compiler-backend-global-shared-view instr-diag)
      program-index
      ;; vars must be the real frame var count: group-word1 slots live at
      ;; -(8*(vars+var+1))(%rbp), so 0 here would make a stack-homed group arg
      ;; read its word0 slot for BOTH words.
      vars
      backend-state)
      [(Ok args-asm)
        (match (be_facts.compiler-backend-target-arg-reg target (Internal) 0)
          [(Ok env-reg)
            (match (be_calls.compiler-backend-emit-call-result-store
              type-segment-bases
              assignments
              dst
              ty
              vars
              program-index)
              [(Ok result-store)
                (match (& func)
                  [(Function name)
                    (Ok
                      (str_cat.str-cat
                        (be_operand.compiler-backend-emit-call-space-sub
                          call-space)
                        args-asm
                        (be_scalar.compiler-backend-emit-load-i64-immediate
                          0
                          env-reg)
                        (str_cat.str-cat
                          "    call "
                          (be_facts.compiler-backend-closure-entry-label
                            (be_state.compiler-backend-symbol-text-index
                              program-index
                              name))
                          "\n"
                          (str_cat.str-cat
                            (be_operand.compiler-backend-emit-call-space-add
                              call-space)
                            result-store)
                          "")))]
                  [_
                    ;; Normally materialize the closure pointer after argument
                    ;; marshalling, so the marshalling scratch remains free to
                    ;; stage stack/group values. A register-resident callee can
                    ;; itself occupy an explicit argument register, though. Save
                    ;; that uncommon overlap to cycle-temp slot 1 before args
                    ;; (slot 0 belongs to parallel arg moves), then reload it
                    ;; afterward. This avoids making any GP scratch live across
                    ;; the whole marshalling sequence.
                    (let
                      [scav-clo : String
                        (be_scalar.compiler-backend-stack-call-arg-stage
                          backend-state)]
                      [overlap : bool
                        (compiler-backend-indirect-call-callee-arg-overlap?
                          target
                          (Internal)
                          assignments
                          (be_state.compiler-backend-global-shared-view func)
                          args
                          backend-state)]
                      (match (be_operand.compiler-backend-emit-load-value
                        assignments
                        func
                        (be_state.compiler-backend-global-shared-view scav-clo)
                        backend-state)
                        [(Ok func-asm)
                          (let
                            [call-tail : String
                              (str_cat.str-cat
                                "    movq 8("
                                scav-clo
                                "), "
                                env-reg
                                "\n    call *("
                                scav-clo
                                ")\n"
                                (str_cat.str-cat
                                  (be_operand.compiler-backend-emit-call-space-add
                                    call-space)
                                  result-store)
                                "")]
                            (if overlap
                              (let
                                [slot : String
                                  (be_scalar.compiler-backend-cycle-temp-slot-with-backend-state
                                    backend-state
                                    1)]
                                (Ok
                                  (str_cat.str-cat
                                    (be_operand.compiler-backend-emit-call-space-sub
                                      call-space)
                                    func-asm
                                    (str_cat.str-cat
                                      "    movq "
                                      scav-clo
                                      ", "
                                      slot
                                      "\n")
                                    args-asm
                                    (str_cat.str-cat
                                      "    movq "
                                      slot
                                      ", "
                                      scav-clo
                                      "\n")
                                    call-tail)))
                              (Ok
                                (str_cat.str-cat
                                  (be_operand.compiler-backend-emit-call-space-sub
                                    call-space)
                                  args-asm
                                  func-asm
                                  call-tail))))]
                        [(Err message)
                          (be_state.compiler-backend-instr-error-from
                            instr-diag
                            message)]))])]
              [(Err message)
                (be_state.compiler-backend-instr-error-from instr-diag message)])]
          [(Err message)
            (be_state.compiler-backend-instr-error instr-diag message)])]
      [(Err message)
        (be_state.compiler-backend-instr-error-from instr-diag message)])))

(define (compiler-backend-emit-indirect-call
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [dst : i64]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-indirect-call-with-arg-assignments
    type-segment-bases
    target
    dst
    func
    args
    ty
    assignments
    assignments
    types
    functions
    externs
    program-index
    vars
    instr-diag
    backend-state))

(define (compiler-backend-emit-tail-indirect-call
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [current-label : i64]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [vars : i64]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [param-types : compiler_ast_types.AstTypeList
      (compiler-backend-effective-normal-indirect-param-types
        type-segment-bases
        types
        (be_state.compiler-backend-global-shared-view func)
        (be_state.compiler-backend-global-shared-view args)
        functions
        externs
        program-index)]
    [call-space : i64
      (compiler-backend-closure-call-arg-space
        target
        args
        param-types
        program-index)]
    [register-only : bool
      (and
        ;; Loading the closure target does not extend outgoing frame-backed
        ;; arguments' lifetime. Keep the frame for an ordinary call instead.
        (not
          (be_calls.compiler-backend-blocks-expose-frame-at?
            backend-state
            (& blocks)
            current-label))
        (compiler-backend-indirect-tail-call-register-only?
          type-segment-bases
          target
          (be_state.compiler-backend-global-shared-view args)
          param-types
          program-index))]
    (match (be_calls.compiler-backend-emit-call-args
      type-segment-bases
      target
      (Internal)
      assignments
      args
      param-types
      false
      0
      1
      0
      1
      0
      instr-diag
      program-index
      vars
      backend-state)
      [(Ok args-asm)
        (let
          [clo-reg : String
            (compiler-backend-scavenge-tail-call-target-reg backend-state)]
          (match (be_operand.compiler-backend-emit-load-value
            assignments
            func
            (be_state.compiler-backend-global-shared-view clo-reg)
            backend-state)
            [(Ok func-asm)
              (match (be_facts.compiler-backend-target-arg-reg
                target
                (Internal)
                0)
                [(Ok env-reg)
                  (let
                    [target-addr : String
                      (str_cat.str-cat "*(" clo-reg ")" "" "")]
                    [descriptor-asm : String
                      (str_cat.str-cat
                        func-asm
                        "    movq 8("
                        clo-reg
                        "), "
                        env-reg
                        "\n"
                        "")]
                    (if register-only
                      (Ok
                        (str_cat.str-cat
                          args-asm
                          descriptor-asm
                          (be_scalar.compiler-backend-tail-jump-tail
                            assignments
                            vars
                            target-addr
                            backend-state)))
                      (Ok
                        (str_cat.str-cat
                          (be_operand.compiler-backend-emit-call-space-sub
                            call-space)
                          args-asm
                          descriptor-asm
                          (str_cat.str-cat
                            "    call "
                            target-addr
                            "\n"
                            (be_operand.compiler-backend-emit-call-space-add
                              call-space)
                            (str_cat.str-cat
                              (be_calls.compiler-backend-tail-call-return-normalize
                                type-segment-bases
                                ty)
                              (be_scalar.compiler-backend-return-tail
                                program-index.backend-state
                                source-function
                                assignments
                                vars
                                blocks))
                            ""
                            "")))))]
                [(Err message)
                  (be_state.compiler-backend-instr-error instr-diag message)])]
            [(Err message)
              (be_state.compiler-backend-instr-error-from instr-diag message)]))]
      [(Err message)
        (be_state.compiler-backend-instr-error-from instr-diag message)])))

(define (compiler-backend-indirect-c-call-direct-home?
  [_target : be_state.CompilerBackendTarget]
  [home : (& home str)]) : bool
  ;; Use the callee-saved homes common to SysV and Win64. Win64 also preserves
  ;; rdi/rsi, but those stay on the fallback path for this conservative pass.
  (or
    (string.eq home "%rbx")
    (string.eq home "%r12")
    (string.eq home "%r13")
    (string.eq home "%r14")
    (string.eq home "%r15")))

(define (compiler-backend-indirect-c-call-direct-home
  [backend-state : be_state.CompilerBackendState]
  [target : be_state.CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [func : compiler_ir_types.CompilerIrValue]) : String
  (let
    [home : String
      (be_facts.compiler-backend-value-register-home
        backend-state
        assignments
        func)]
    (if (compiler-backend-indirect-c-call-direct-home? target home)
      home
      "")))

(define (compiler-backend-emit-indirect-c-call
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [dst : i64]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [_functions : compiler_ir_types.CompilerIrFunctionSeq]
  [_externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [param-types : compiler_ast_types.AstTypeList
      (be_calls.compiler-backend-effective-c-abi-indirect-param-types
        type-segment-bases
        types
        (be_state.compiler-backend-global-shared-view func)
        (be_state.compiler-backend-global-shared-view args)
        program-index)]
    [call-space : i64
      (be_operand.compiler-backend-call-arg-space
        target
        args
        param-types
        true
        program-index)]
    [direct-home : String
      (compiler-backend-indirect-c-call-direct-home
        backend-state
        target
        assignments
        (be_state.compiler-backend-global-shared-view func))]
    (match (be_calls.compiler-backend-emit-call-args
      type-segment-bases
      target
      (Platform)
      assignments
      args
      param-types
      true
      0
      0
      0
      0
      0
      instr-diag
      program-index
      ;; Real frame var count for group-word1 slot addressing (see
      ;; emit-indirect-call): latent today because C-ABI lowering never passes
      ;; 16-byte aggregates by value, but keep it correct.
      vars
      backend-state)
      [(be_state.ResultCompilerBackend.Ok args-asm)
        (if (string.eq direct-home "")
          (let
            [call-reg : String
              (be_scalar.compiler-backend-stack-call-arg-stage backend-state)]
            (match (be_operand.compiler-backend-emit-load-value
              assignments
              func
              (be_state.compiler-backend-global-shared-view call-reg)
              backend-state)
              [(be_state.ResultCompilerBackend.Ok func-asm)
                (be_state.ResultCompilerBackend.Ok
                  (str_cat.str-cat
                    (be_operand.compiler-backend-emit-call-space-sub call-space)
                    args-asm
                    func-asm
                    (str_cat.str-cat
                      "    call *"
                      call-reg
                      "\n"
                      (be_operand.compiler-backend-emit-call-space-add
                        call-space)
                      (be_calls.compiler-backend-emit-c-abi-call-result-store-reg
                        assignments
                        dst
                        (if (be_operand.compiler-backend-float-type? ty)
                          "%xmm0"
                          "%rax")
                        ty
                        backend-state)
                      ""
                      "")))]
              [(be_state.ResultCompilerBackend.Err message)
                (be_state.compiler-backend-instr-error-from instr-diag message)]))
          (be_state.ResultCompilerBackend.Ok
            (str_cat.str-cat
              (be_operand.compiler-backend-emit-call-space-sub call-space)
              args-asm
              (str_cat.str-cat
                "    call *"
                direct-home
                "\n"
                (be_operand.compiler-backend-emit-call-space-add call-space)
                (be_calls.compiler-backend-emit-c-abi-call-result-store-reg
                  assignments
                  dst
                  (if (be_operand.compiler-backend-float-type? ty)
                    "%xmm0"
                    "%rax")
                  ty
                  backend-state)
                ""
                ""))))]
      [(be_state.ResultCompilerBackend.Err message)
        (be_state.compiler-backend-instr-error-from instr-diag message)])))

(define (compiler-backend-emit-c-abi-store-result-call
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [base : compiler_ir_types.CompilerIrValue]
  [name : i64]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [slots : compiler_ir_types.CompilerIrCAbiReturnSlotSeq]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [plan : be_state.CompilerBackendRuntimePlan]
  [_externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [extern-call-info : i64
      (be_operand.compiler-backend-index-extern-call-info program-index name)]
    [param-types : compiler_ast_types.AstTypeList
      (be_calls.compiler-backend-call-param-types-for-call
        type-segment-bases
        name
        (be_state.compiler-backend-global-shared-view args)
        types
        global-types
        extern-call-info
        program-index)]
    [c-abi? : bool
      (be_facts.compiler-backend-extern-call-info-aggregate-params?
        extern-call-info)]
    [call-space : i64
      (be_calls.compiler-backend-call-stack-arg-layout-space
        type-segment-bases
        target
        (Platform)
        (be_state.compiler-backend-global-shared-view args)
        (be_state.compiler-backend-global-shared-view param-types)
        c-abi?
        program-index)]
    ;; The args + 16-byte base-save region are reserved in the prologue frame
    ;; (instr-outgoing-stack-space), so no per-call %rsp dip is needed.
    [dip : i64 0]
    [call-symbol : String
      (be_operand.compiler-backend-call-symbol-index name plan program-index)]
    (match (be_calls.compiler-backend-emit-call-args
      type-segment-bases
      target
      (Platform)
      assignments
      args
      (be_state.compiler-backend-global-shared-view param-types)
      c-abi?
      0
      0
      0
      0
      0
      instr-diag
      program-index
      vars
      backend-state)
      [(Ok args-asm)
        (match (be_calls.compiler-backend-emit-c-abi-return-base-save
          assignments
          base
          call-space
          backend-state)
          [(Ok base-save)
            (Ok
              (str_cat.str-cat
                (be_operand.compiler-backend-emit-call-space-sub dip)
                args-asm
                base-save
                (be_calls.compiler-backend-varargs-pre-call
                  type-segment-bases
                  target
                  extern-call-info
                  param-types)
                (str_cat.str-cat
                  "    call "
                  call-symbol
                  "\n"
                  (str_cat.str-cat
                    (be_calls.compiler-backend-emit-c-abi-return-stores
                      type-segment-bases
                      call-space
                      slots
                      backend-state)
                    (be_operand.compiler-backend-emit-call-space-add dip))
                  "")))]
          [(Err message)
            (be_state.compiler-backend-instr-error-from instr-diag message)])]
      [(Err message)
        (be_state.compiler-backend-instr-error-from instr-diag message)])))

(define (compiler-backend-emit-indirect-c-abi-store-result-call
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [base : compiler_ir_types.CompilerIrValue]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [slots : compiler_ir_types.CompilerIrCAbiReturnSlotSeq]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [_functions : compiler_ir_types.CompilerIrFunctionSeq]
  [_externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [param-types : compiler_ast_types.AstTypeList
      (be_calls.compiler-backend-effective-c-abi-indirect-param-types
        type-segment-bases
        types
        (be_state.compiler-backend-global-shared-view func)
        (be_state.compiler-backend-global-shared-view args)
        program-index)]
    [call-space : i64
      (be_calls.compiler-backend-call-stack-arg-layout-space
        type-segment-bases
        target
        (Platform)
        (be_state.compiler-backend-global-shared-view args)
        (be_state.compiler-backend-global-shared-view param-types)
        true
        program-index)]
    ;; Mirrors the direct C-ABI store-result path: the frame reserves this region
    ;; and the call does not move %rsp.
    [dip : i64 0]
    (match (be_calls.compiler-backend-emit-call-args
      type-segment-bases
      target
      (Platform)
      assignments
      args
      param-types
      true
      0
      0
      0
      0
      0
      instr-diag
      program-index
      vars
      backend-state)
      [(be_state.ResultCompilerBackend.Ok args-asm)
        (match (be_calls.compiler-backend-emit-c-abi-return-base-save
          assignments
          base
          call-space
          backend-state)
          [(be_state.ResultCompilerBackend.Ok base-save)
            (let
              [call-reg : String
                (be_scalar.compiler-backend-stack-call-arg-stage backend-state)]
              (match (be_operand.compiler-backend-emit-load-value
                assignments
                func
                (be_state.compiler-backend-global-shared-view call-reg)
                backend-state)
                [(be_state.ResultCompilerBackend.Ok func-asm)
                  (be_state.ResultCompilerBackend.Ok
                    (str_cat.str-cat
                      (be_operand.compiler-backend-emit-call-space-sub dip)
                      args-asm
                      base-save
                      func-asm
                      (str_cat.str-cat
                        "    call *"
                        call-reg
                        "\n"
                        (str_cat.str-cat
                          (be_calls.compiler-backend-emit-c-abi-return-stores
                            type-segment-bases
                            call-space
                            slots
                            backend-state)
                          (be_operand.compiler-backend-emit-call-space-add dip))
                        ""
                        ""
                        "")))]
                [(be_state.ResultCompilerBackend.Err message)
                  (be_state.compiler-backend-instr-error-from
                    instr-diag
                    message)]))]
          [(be_state.ResultCompilerBackend.Err message)
            (be_state.compiler-backend-instr-error-from instr-diag message)])]
      [(be_state.ResultCompilerBackend.Err message)
        (be_state.compiler-backend-instr-error-from instr-diag message)])))

;; ---------------------------------------------------------------------------
;; Constant-divmod adjacent value forwarding.
;;
;; The signed literal expansion owns one non-fixed SRC register.  When its
;; dividend is the single-use result of the immediately preceding scalar op,
;; steer that producer into SRC instead of first defining a fixed %rax/%rdx
;; home.  Independently, when the divmod result has one use in the direct
;; Gep+StorePtr shape, leave the result in SRC and let the store read it there.
;; The home overrides below exist only while the fused IR bundle is emitted;
;; allocator assignments, liveness, and the IR itself remain unchanged.
(defenum CompilerBackendMaybeDivmodPolish
  (No)
  (Some be_state.ResultCompilerBackend))

(define (compiler-backend-divmod-producer-op?
  [op : (& op compiler_ir_types.CompilerIrBinOp)]) : bool
  (match op
    [(or (Add) (Mul) (BitXor)) true]
    [_ false]))

(define (compiler-backend-divmod-fixed-home? [home : String]) : bool
  (or (string.eq home "%rax") (string.eq home "%rdx")))

;; Conservative retargetability gate for the producer forms this fold owns.
;; A register LHS plus a direct register/immediate RHS makes Add/Mul/BitXor a
;; no-extra-scratch destination-targetable instruction (LEA/two-address
;; add/imul/xor).  Wider fallback shapes keep their ordinary home.
(define (compiler-backend-divmod-producer-retargetable?
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [backend-state : be_state.CompilerBackendState]) : bool
  (and
    (compiler-backend-divmod-producer-op? op)
    (match (& ty)
      [(I64) true]
      [_ false])
    (compiler-backend-divmod-fixed-home?
      (be_scalar.compiler-backend-var-register-home
        backend-state
        assignments
        dst))
    (not
      (string.eq
        (be_operand.compiler-backend-value-scalar-register
          backend-state
          assignments
          lhs)
        ""))
    (match (be_operand.compiler-backend-immediate-operand backend-state rhs)
      [(Some _)
        (and
          (be_scalar.compiler-backend-binop-direct-width-ok?
            type-segment-bases
            op
            (be_state.compiler-backend-global-shared-view ty))
          (be_scalar.compiler-backend-binop-direct-immediate-ok?
            type-segment-bases
            (be_scalar.compiler-backend-binop-direct-mnemonic op)
            op
            rhs
            ty
            backend-state))]
      [(No)
        (let
          [lhs-reg : String
            (be_operand.compiler-backend-value-scalar-register
              backend-state
              assignments
              lhs)]
          [rhs-reg : String
            (be_operand.compiler-backend-value-scalar-register
              backend-state
              assignments
              rhs)]
          (and
            (not (string.eq rhs-reg ""))
            ;; %rbp cannot be a SIB index.  The only direct Add form with both
            ;; operands there therefore stays on the ordinary emitter.
            (not
              (and
                (match op
                  [(Add) true]
                  [_ false])
                (string.eq lhs-reg "%rbp")
                (string.eq rhs-reg "%rbp")))))])))

;; Emit exactly the direct producer forms admitted above.  This avoids the
;; ordinary binop emitter's eagerly-computed fallback scavenge: after changing
;; the destination home to SRC that unused probe can otherwise manufacture an
;; emergency save/restore even though the selected LEA/IMUL/XOR needs no
;; scratch at all.
(define (compiler-backend-emit-divmod-producer-to-src
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [src : (& src str)]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [lhs-reg : String
      (be_operand.compiler-backend-value-scalar-register
        backend-state
        assignments
        lhs)]
    (match (be_operand.compiler-backend-immediate-operand backend-state rhs)
      [(Some imm)
        (match op
          ;; `K(%rbp)` would read as a frame address to the final rsp rebase;
          ;; a spaced base distinguishes a register value from a slot.
          [(Add)
            (Ok
              (str_cat.str-cat
                (str_cat.str-cat
                  "    leaq "
                  (string.substring imm 1 (- (string.string-length imm) 1))
                  (be_operand.compiler-backend-value-base-prefix lhs-reg)
                  lhs-reg)
                (str_cat.str-cat "), " src "\n")))]
          [(Mul)
            (Ok
              (str_cat.str-cat
                (str_cat.str-cat "    imulq " imm ", " lhs-reg)
                (str_cat.str-cat ", " src "\n")))]
          [(BitXor)
            (Ok
              (str_cat.str-cat
                (be_scalar.compiler-backend-divmod-result-move lhs-reg src)
                (str_cat.str-cat "    xorq " imm ", " src "\n")))]
          [_
            (Err
              (box
                (compiler_diagnostic.compiler-diagnostic-at-start
                  ""
                  "backend: non-retargetable divmod producer")))])]
      [(No)
        (let
          [rhs-reg : String
            (be_operand.compiler-backend-value-scalar-register
              backend-state
              assignments
              rhs)]
          (match op
            [(Add)
              (Ok
                (str_cat.str-cat
                  (str_cat.str-cat
                    "    leaq ("
                    (if (string.eq lhs-reg "%rbp")
                      (owned_view.compiler-owned-shared-view rhs-reg)
                      (owned_view.compiler-owned-shared-view lhs-reg))
                    ","
                    (if (string.eq lhs-reg "%rbp")
                      lhs-reg
                      rhs-reg))
                  (str_cat.str-cat "), " src "\n")))]
            [(Mul)
              (Ok
                (if (string.eq src lhs-reg)
                  (str_cat.str-cat "    imulq " rhs-reg ", " src "\n")
                  (if (string.eq src rhs-reg)
                    (str_cat.str-cat "    imulq " lhs-reg ", " src "\n")
                    (str_cat.str-cat
                      (be_scalar.compiler-backend-divmod-result-move
                        lhs-reg
                        src)
                      (str_cat.str-cat "    imulq " rhs-reg ", " src "\n")))))]
            [(BitXor)
              (Ok
                (if (string.eq src lhs-reg)
                  (str_cat.str-cat "    xorq " rhs-reg ", " src "\n")
                  (if (string.eq src rhs-reg)
                    (str_cat.str-cat "    xorq " lhs-reg ", " src "\n")
                    (str_cat.str-cat
                      (be_scalar.compiler-backend-divmod-result-move
                        lhs-reg
                        src)
                      (str_cat.str-cat "    xorq " rhs-reg ", " src "\n")))))]
            [_
              (Err
                (box
                  (compiler_diagnostic.compiler-diagnostic-at-start
                    ""
                    "backend: non-retargetable divmod producer")))]))])))

(define (compiler-backend-divmod-producer-feeds?
  [ctx : be_state.CompilerBackendEmissionContext]
  [producer-dst : i64]
  [producer-op : compiler_ir_types.CompilerIrBinOp]
  [producer-lhs : compiler_ir_types.CompilerIrValue]
  [producer-rhs : compiler_ir_types.CompilerIrValue]
  [producer-ty : compiler_ast_types.AstType]
  [div-op : (& div-op compiler_ir_types.CompilerIrBinOp)]
  [div-lhs : compiler_ir_types.CompilerIrValue]
  [div-rhs : compiler_ir_types.CompilerIrValue]
  [div-ty : compiler_ast_types.AstType]) : bool
  (and
    (be_simd.compiler-backend-var-single-use? ctx.use-counts producer-dst)
    (compiler-backend-divmod-producer-retargetable?
      ctx.type-segment-bases
      ctx.assignments
      producer-dst
      producer-op
      producer-lhs
      producer-rhs
      producer-ty
      ctx.backend-state)
    (be_operand.compiler-backend-branch-uses-var? div-lhs producer-dst)
    (be_scalar.compiler-backend-signed-literal-divmod-src-shape?
      ctx.type-segment-bases
      div-op
      div-rhs
      div-ty)))

;; The existing Gep+StorePtr fusion accepts the stored scalar in any GP
;; register when its address is already directly encodable.  Requiring that
;; direct address shape keeps SRC out of all later address scratches.
(define (compiler-backend-divmod-direct-gep-store?
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [result-dst : i64]
  [gep-dst : i64]
  [base : (& compiler_ir_types.CompilerIrValue)]
  [offset : (& compiler_ir_types.CompilerIrValue)]
  [elem-ty : (& compiler_ast_types.AstType)]
  [store-ptr : (& compiler_ir_types.CompilerIrValue)]
  [store-value : (& compiler_ir_types.CompilerIrValue)]) : bool
  (and
    (be_operand.compiler-backend-branch-uses-var? store-ptr gep-dst)
    (be_operand.compiler-backend-branch-uses-var? store-value result-dst)
    (match (be_operand.compiler-backend-value-as-i64 offset)
      [(Some _)
        (not
          (string.eq
            (be_facts.compiler-backend-value-register-home
              backend-state
              assignments
              base)
            ""))]
      [(None)
        (let
          [base-home : String
            (be_scalar.compiler-backend-address-base-filter
              (be_operand.compiler-backend-value-scalar-register
                backend-state
                assignments
                base))]
          [offset-home : String
            (be_operand.compiler-backend-value-scalar-register
              backend-state
              assignments
              offset)]
          (and
            (not (string.eq base-home ""))
            (not (string.eq offset-home ""))
            (not
              (string.eq
                (be_scalar.compiler-backend-gep-index-address-disp
                  0
                  base-home
                  (be_operand.compiler-backend-type-size
                    type-segment-bases
                    elem-ty)
                  offset-home)
                ""))))])))

;; A direct Gep+StorePtr remains inside the divmod emergency-save region, so
;; every address input must survive the complete expansion.  Compare physical
;; register homes against the expansion's full write set: fixed %rax/%rdx, the
;; selected dividend/result SRC, and the materialised magic/mask register (when
;; one is needed).  A rejected store resumes at Gep after the emergency restores.
(define (compiler-backend-divmod-direct-gep-store-clobber-safe?
  [backend-state : be_state.CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [src : (& src str)]
  [magic : String]
  [base : (& compiler_ir_types.CompilerIrValue)]
  [offset : (& compiler_ir_types.CompilerIrValue)]) : bool
  (let
    [base-home : String
      (match (be_operand.compiler-backend-value-as-i64 offset)
        [(Some _)
          (be_facts.compiler-backend-value-register-home
            backend-state
            assignments
            base)]
        [(None)
          (be_scalar.compiler-backend-address-base-filter
            (be_operand.compiler-backend-value-scalar-register
              backend-state
              assignments
              base))])]
    [offset-home : String
      (match (be_operand.compiler-backend-value-as-i64 offset)
        [(Some _) ""]
        [(None)
          (be_operand.compiler-backend-value-scalar-register
            backend-state
            assignments
            offset)])]
    [address-mask : i64
      (bit-or
        (be_operand.compiler-backend-scavenge-reg-bit base-home)
        (be_operand.compiler-backend-scavenge-reg-bit offset-home))]
    [clobber-mask : i64
      (bit-or
        (bit-or
          (be_operand.compiler-backend-scavenge-reg-bit "%rax")
          (be_operand.compiler-backend-scavenge-reg-bit "%rdx"))
        (bit-or
          (be_operand.compiler-backend-scavenge-reg-bit src)
          (be_operand.compiler-backend-scavenge-reg-bit magic)))]
    (= (bit-and address-mask clobber-mask) 0)))

;; The divmod emitter can discover an emergency scratch after the polish SRC
;; has been selected.  Restore any borrowed address input before the fused
;; store reads it; other borrowed registers (including SRC) remain protected
;; until the bundle's ordinary trailing restore.
(define (compiler-backend-divmod-address-emergency-restore-asm
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [src : String]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [index : i64]
  [backend-state : be_state.CompilerBackendState]) : String
  (let
    [function-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state backend-state)]
    (if (>=
      index
      (be_state.compiler-backend-function-scratch-i64
        function-state
        be_state.compiler-backend-scratch-i64-emergency-pending-count))
      ""
      (let
        ;; Inline restore emitted mid-instruction: no bracketed text to prove a
        ;; park register survives, so charge frame slots.
        [_slot-form : unit
          (be_scalar.compiler-backend-emergency-commit-slot-form!
            function-state)]
        [reg : i64
          (array-ref
            (be_state.compiler-backend-function-scratch-i64-array
              function-state
              be_state.compiler-backend-scratch-i64-array-emergency-regs)
            index)]
        [base-home : String
          (be_operand.compiler-backend-value-scalar-register
            backend-state
            assignments
            base)]
        [offset-home : String
          (match (be_operand.compiler-backend-value-as-i64 offset)
            [(Some _) ""]
            [(None)
              (be_operand.compiler-backend-value-scalar-register
                backend-state
                assignments
                offset)])]
        (str_cat.str-cat
          (if (and
            (not
              (=
                reg
                (compiler_abi.compiler-abi-register-id-from-spelling
                  (be_state.compiler-backend-global-shared-view src))))
            (or
              (=
                reg
                (compiler_abi.compiler-abi-register-id-from-spelling base-home))
              (=
                reg
                (compiler_abi.compiler-abi-register-id-from-spelling
                  offset-home))))
            (be_scalar.compiler-backend-emergency-entry-restore-asm
              function-state
              index
              backend-state)
            "")
          (compiler-backend-divmod-address-emergency-restore-asm
            assignments
            src
            base
            offset
            (+ index 1)
            backend-state))))))

;; Select the same SRC class as the ordinary divmod emitter.  At a divmod site
;; a dead non-fixed dividend home wins; otherwise a suitable result home wins.
;; The producer fold calls with allow-own=false because
;; its dividend is still being defined at the current point.  The final
;; scavenger fallback queries a forward occupancy window, so an emergency pick
;; is preserved around the complete fused bundle below.
(define (compiler-backend-divmod-polish-src
  [ctx : be_state.CompilerBackendEmissionContext]
  [dst : i64]
  [lhs : compiler_ir_types.CompilerIrValue]
  [magic : String]
  [hoist-reg : String]
  [allow-own : bool]
  [want-remainder? : bool]
  [scavenge-dst : i64]) : String
  (let
    [lhs-home : String
      (be_operand.compiler-backend-value-scalar-register
        ctx.backend-state
        ctx.assignments
        lhs)]
    [dst-home : String
      (be_scalar.compiler-backend-var-register-home
        ctx.backend-state
        ctx.assignments
        dst)]
    [own-src? : bool
      (and
        allow-own
        (be_scalar.compiler-backend-divmod-src-register? lhs-home)
        (not (string.eq lhs-home magic))
        (not (string.eq lhs-home hoist-reg))
        (not
          (be_scalar.compiler-backend-value-live-after-here?
            ctx.backend-state
            lhs))
        (be_scalar.compiler-backend-divmod-src-home-safe?
          ctx.backend-state
          want-remainder?
          (be_state.compiler-backend-global-shared-view lhs-home)
          dst-home))]
    [dst-src? : bool
      (and
        (not own-src?)
        (be_scalar.compiler-backend-divmod-src-register? dst-home)
        (not (string.eq dst-home magic))
        (not (string.eq dst-home hoist-reg))
        (not (string.eq dst-home lhs-home)))]
    [src-exclude : (__tl_dyn-array String)
      (be_scalar.compiler-backend-divmod-dividend-exclude magic)]
    (cond
      [own-src? lhs-home]
      [dst-src? dst-home]
      [else
        (be_scalar.compiler-backend-scavenge-divmod-src-reg
          scavenge-dst
          (if (string.eq hoist-reg "")
            src-exclude
            (be_operand.compiler-backend-scavenge-exclude-append
              src-exclude
              5
              (be_state.compiler-backend-global-shared-view hoist-reg)))
          (if (string.eq hoist-reg "")
            5
            6)
          ctx.backend-state)])))

;; Resolve the materialisation register with the same point, exclusions, and
;; fallback as emit-signed-literal-divmod-dst, but without reserving an
;; emergency slot.  Admission needs the exact physical write set before deciding
;; whether a following direct store can remain inside the divmod save region.
(define (compiler-backend-divmod-polish-magic-here
  [_ctx : be_state.CompilerBackendEmissionContext]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]) : String
  (let
    [hoist : be_scalar.CompilerBackendConstHoistHome
      (be_scalar.compiler-backend-const-hoist-here _ctx.function-state)]
    [hoist-reg : String
      (be_scalar.compiler-backend-magic-home-reg-name
        (be_state.compiler-backend-global-shared-view hoist))]
    (if (be_scalar.compiler-backend-signed-literal-divmod-needs-material-reg?
      _ctx.type-segment-bases
      rhs
      ty
      (be_scalar.compiler-backend-binop-wants-remainder? op)
      hoist)
      (be_operand.compiler-backend-scavenge-reg-pick
        dst
        (if (string.eq hoist-reg "")
          (be_scalar.compiler-backend-binop-scavenge-exclude-for-op op)
          (be_operand.compiler-backend-scavenge-exclude-append
            (be_scalar.compiler-backend-binop-scavenge-exclude-for-op op)
            5
            (be_state.compiler-backend-global-shared-view hoist-reg)))
        (if (string.eq hoist-reg "")
          5
          6)
        "%r8"
        false
        _ctx.backend-state)
      "")))

(define (compiler-backend-divmod-polish-magic-ahead
  [ctx : be_state.CompilerBackendEmissionContext]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instruction-offset : i64]) : String
  (let
    [saved-count : i64
      (be_state.compiler-backend-function-state-emit-current-count
        ctx.function-state)]
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [_position : unit
      (begin
        (be_state.compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          (- saved-count instruction-offset))
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          (compiler-backend-instr-reserved-home-mask
            ctx.function-state
            div-instr)))]
    [magic : String
      (compiler-backend-divmod-polish-magic-here
        (be_state.compiler-backend-global-shared-view ctx)
        dst
        op
        rhs
        ty)]
    [_restore : unit
      (begin
        (be_state.compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          saved-count)
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          saved-reserved))]
    magic))

;; The resident loop-hoisted magic is a read-only input rather than a clobber,
;; but SRC must still avoid it exactly as the ordinary divmod emitter does.
;; Resolve it at the divmod instruction rather than the earlier fused producer.
(define (compiler-backend-divmod-polish-hoist-reg-ahead
  [ctx : be_state.CompilerBackendEmissionContext]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [instruction-offset : i64]) : String
  (let
    [saved-count : i64
      (be_state.compiler-backend-function-state-emit-current-count
        ctx.function-state)]
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [_position : unit
      (begin
        (be_state.compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          (- saved-count instruction-offset))
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          (compiler-backend-instr-reserved-home-mask
            ctx.function-state
            div-instr)))]
    [hoist-reg : String
      (be_scalar.compiler-backend-magic-home-reg-name
        (be_scalar.compiler-backend-const-hoist-here ctx.function-state))]
    [_restore : unit
      (begin
        (be_state.compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          saved-count)
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          saved-reserved))]
    hoist-reg))

(define (compiler-backend-divmod-overrides-install!
  [function-state : be_state.CompilerBackendFunctionState]
  [first-var : i64]
  [first-reg : i64]
  [second-var : i64]
  [second-reg : i64]) : unit
  (be_state.compiler-backend-function-state-set-i64!
    function-state
    be_state.compiler-backend-function-i64-home-override0-var
    first-var)
  (be_state.compiler-backend-function-state-set-i64!
    function-state
    be_state.compiler-backend-function-i64-home-override0-reg
    first-reg)
  (be_state.compiler-backend-function-state-set-i64!
    function-state
    be_state.compiler-backend-function-i64-home-override1-var
    second-var)
  (be_state.compiler-backend-function-state-set-i64!
    function-state
    be_state.compiler-backend-function-i64-home-override1-reg
    second-reg))

(define (compiler-backend-divmod-overrides-install-spellings!
  [function-state : be_state.CompilerBackendFunctionState]
  [first-var : i64]
  [first-reg : String]
  [second-var : i64]
  [second-reg : String]) : unit
  (compiler-backend-divmod-overrides-install!
    function-state
    first-var
    (compiler_abi.compiler-abi-register-id-from-spelling first-reg)
    second-var
    (compiler_abi.compiler-abi-register-id-from-spelling second-reg)))

;; Emit a Gep+StorePtr as the already-existing direct fused store, but return
;; only its assembly so the surrounding divmod bundle can own one emergency
;; save/restore region.
(define (compiler-backend-emit-divmod-direct-gep-store
  [ctx : be_state.CompilerBackendEmissionContext]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [value : compiler_ir_types.CompilerIrValue]
  [store-ty : compiler_ast_types.AstType]) : be_state.ResultCompilerBackend
  (let
    [_reserved : unit
      (compiler-backend-set-current-instr-reserved-mask!
        ctx.function-state
        (compiler-backend-instr-reserved-home-mask
          ctx.function-state
          (Gep
            gep-dst
            (be_state.compiler-backend-global-shared-view base)
            (be_state.compiler-backend-global-shared-view offset)
            (be_state.compiler-backend-global-shared-view elem-ty))))]
    [gep-disp : i64
      (compiler-backend-gep-fold-next!
        ctx.function-state
        ctx.type-segment-bases
        offset
        elem-ty)]
    (be_scalar.compiler-backend-emit-store-to-gep
      ctx.type-segment-bases
      ctx.assignments
      base
      offset
      elem-ty
      value
      store-ty
      ctx.program-index
      gep-disp
      ctx.backend-state)))

(define (compiler-backend-emit-divmod-polish-continue
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [result : be_state.ResultCompilerBackend]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [asm (try result)]
    (be_state.compiler-backend-asm-append
      out
      (be_scalar.compiler-backend-emergency-wrap asm ctx.backend-state))
    (compiler-backend-emit-instrs ctx fallthrough instrs index out)))

(define (compiler-backend-emit-divmod-result-gep-store-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [div-dst : i64]
  [src : String]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [store-value : compiler_ir_types.CompilerIrValue]
  [store-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [saved-count : i64
      (be_state.compiler-backend-function-state-emit-current-count
        ctx.function-state)]
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [saved0-var : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override0-var)]
    [saved0-reg : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override0-reg)]
    [saved1-var : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override1-var)]
    [saved1-reg : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override1-reg)]
    [result : be_state.ResultCompilerBackend
      (begin
        (compiler-backend-divmod-overrides-install-spellings!
          ctx.function-state
          div-dst
          (be_state.compiler-backend-global-shared-view src)
          -1
          "")
        (match (compiler-backend-emit-instr
          (be_state.compiler-backend-global-shared-view ctx)
          (No)
          div-instr)
          [(Ok div-asm)
            (be_state.compiler-backend-function-state-set-emit-current-count!
              ctx.function-state
              (- saved-count 1))
            (let
              [address-restore : String
                (compiler-backend-divmod-address-emergency-restore-asm
                  ctx.assignments
                  src
                  (be_state.compiler-backend-global-shared-view base)
                  (be_state.compiler-backend-global-shared-view offset)
                  0
                  ctx.backend-state)]
              (match (compiler-backend-emit-divmod-direct-gep-store
                (be_state.compiler-backend-global-shared-view ctx)
                gep-dst
                base
                offset
                elem-ty
                store-value
                store-ty)
                [(Ok store-asm)
                  (Ok (str_cat.str-cat div-asm address-restore store-asm))]
                [(Err message) (Err message)]))]
          [(Err message) (Err message)]))]
    [_restore : unit
      (begin
        (be_state.compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          saved-count)
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          saved-reserved)
        (compiler-backend-divmod-overrides-install!
          ctx.function-state
          saved0-var
          saved0-reg
          saved1-var
          saved1-reg))]
    (compiler-backend-emit-divmod-polish-continue
      ctx
      fallthrough
      result
      instrs
      index
      out)))

(define (compiler-backend-emit-steered-producer-divmod-plain-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [producer-instr : compiler_ir_types.CompilerIrInstr]
  [producer-dst : i64]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [src : String]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [saved-count : i64
      (be_state.compiler-backend-function-state-emit-current-count
        ctx.function-state)]
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [saved0-var : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override0-var)]
    [saved0-reg : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override0-reg)]
    [saved1-var : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override1-var)]
    [saved1-reg : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override1-reg)]
    [result : be_state.ResultCompilerBackend
      (begin
        (compiler-backend-divmod-overrides-install-spellings!
          ctx.function-state
          producer-dst
          (be_state.compiler-backend-global-shared-view src)
          -1
          "")
        (match (match producer-instr
          [(BinOp _ op lhs rhs _)
            (compiler-backend-emit-divmod-producer-to-src
              ctx.assignments
              op
              lhs
              rhs
              src
              ctx.backend-state)]
          [_
            (be_state.ResultCompilerBackend.Err
              (box
                (compiler_diagnostic.compiler-diagnostic-at-start
                  ""
                  "backend: non-retargetable divmod producer")))])
          [(Ok producer-asm)
            (be_state.compiler-backend-function-state-set-emit-current-count!
              ctx.function-state
              (- saved-count 1))
            (match (compiler-backend-emit-instr
              (be_state.compiler-backend-global-shared-view ctx)
              (No)
              div-instr)
              [(Ok div-asm) (Ok (str_cat.str-cat producer-asm div-asm))]
              [(Err message) (Err message)])]
          [(Err message) (Err message)]))]
    [_restore : unit
      (begin
        (be_state.compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          saved-count)
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          saved-reserved)
        (compiler-backend-divmod-overrides-install!
          ctx.function-state
          saved0-var
          saved0-reg
          saved1-var
          saved1-reg))]
    (compiler-backend-emit-divmod-polish-continue
      ctx
      fallthrough
      result
      instrs
      index
      out)))

(define (compiler-backend-emit-steered-producer-divmod-gep-store-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [producer-instr : compiler_ir_types.CompilerIrInstr]
  [producer-dst : i64]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [div-dst : i64]
  [src : String]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [store-value : compiler_ir_types.CompilerIrValue]
  [store-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [saved-count : i64
      (be_state.compiler-backend-function-state-emit-current-count
        ctx.function-state)]
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [saved0-var : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override0-var)]
    [saved0-reg : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override0-reg)]
    [saved1-var : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override1-var)]
    [saved1-reg : i64
      (be_state.compiler-backend-function-state-i64
        ctx.function-state
        be_state.compiler-backend-function-i64-home-override1-reg)]
    [result : be_state.ResultCompilerBackend
      (begin
        (compiler-backend-divmod-overrides-install-spellings!
          ctx.function-state
          producer-dst
          (be_state.compiler-backend-global-shared-view src)
          div-dst
          (be_state.compiler-backend-global-shared-view src))
        (match (match producer-instr
          [(BinOp _ op lhs rhs _)
            (compiler-backend-emit-divmod-producer-to-src
              ctx.assignments
              op
              lhs
              rhs
              src
              ctx.backend-state)]
          [_
            (be_state.ResultCompilerBackend.Err
              (box
                (compiler_diagnostic.compiler-diagnostic-at-start
                  ""
                  "backend: non-retargetable divmod producer")))])
          [(Ok producer-asm)
            (be_state.compiler-backend-function-state-set-emit-current-count!
              ctx.function-state
              (- saved-count 1))
            (match (compiler-backend-emit-instr
              (be_state.compiler-backend-global-shared-view ctx)
              (No)
              div-instr)
              [(Ok div-asm)
                (be_state.compiler-backend-function-state-set-emit-current-count!
                  ctx.function-state
                  (- saved-count 2))
                (let
                  [address-restore : String
                    (compiler-backend-divmod-address-emergency-restore-asm
                      ctx.assignments
                      src
                      (be_state.compiler-backend-global-shared-view base)
                      (be_state.compiler-backend-global-shared-view offset)
                      0
                      ctx.backend-state)]
                  (match (compiler-backend-emit-divmod-direct-gep-store
                    (be_state.compiler-backend-global-shared-view ctx)
                    gep-dst
                    base
                    offset
                    elem-ty
                    store-value
                    store-ty)
                    [(Ok store-asm)
                      (Ok
                        (str_cat.str-cat
                          producer-asm
                          div-asm
                          address-restore
                          store-asm))]
                    [(Err message) (Err message)]))]
              [(Err message) (Err message)])]
          [(Err message) (Err message)]))]
    [_restore : unit
      (begin
        (be_state.compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          saved-count)
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          saved-reserved)
        (compiler-backend-divmod-overrides-install!
          ctx.function-state
          saved0-var
          saved0-reg
          saved1-var
          saved1-reg))]
    (compiler-backend-emit-divmod-polish-continue
      ctx
      fallthrough
      result
      instrs
      index
      out)))

(define (compiler-backend-emit-steered-producer-divmod-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [producer-instr : compiler_ir_types.CompilerIrInstr]
  [producer-dst : i64]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [div-dst : i64]
  [src : String]
  [magic : String]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (be_simd.compiler-backend-var-single-use? ctx.use-counts div-dst)
    (if (< index instrs.len)
      (let
        [maybe-gep (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
        [after-gep : i64 (+ index 1)]
        (match maybe-gep
          [(Gep gep-dst base offset elem-ty)
            (if (be_simd.compiler-backend-var-single-use?
              ctx.use-counts
              gep-dst)
              (if (< after-gep instrs.len)
                (let
                  [maybe-store
                    (compiler_ir_types.compiler-ir-instr-seq-ref
                      instrs
                      after-gep)]
                  [after-store : i64 (+ after-gep 1)]
                  (match maybe-store
                    [(StorePtr store-ptr store-value store-ty)
                      (if (and
                        (compiler-backend-divmod-direct-gep-store?
                          ctx.backend-state
                          ctx.type-segment-bases
                          ctx.assignments
                          div-dst
                          gep-dst
                          base
                          offset
                          elem-ty
                          store-ptr
                          store-value)
                        (compiler-backend-divmod-direct-gep-store-clobber-safe?
                          ctx.backend-state
                          ctx.assignments
                          src
                          magic
                          base
                          offset))
                        (compiler-backend-emit-steered-producer-divmod-gep-store-rest
                          ctx
                          fallthrough
                          producer-instr
                          producer-dst
                          div-instr
                          div-dst
                          src
                          gep-dst
                          base
                          offset
                          elem-ty
                          store-value
                          store-ty
                          instrs
                          after-store
                          out)
                        (compiler-backend-emit-steered-producer-divmod-plain-rest
                          ctx
                          fallthrough
                          producer-instr
                          producer-dst
                          div-instr
                          src
                          instrs
                          index
                          out))]
                    [_
                      (compiler-backend-emit-steered-producer-divmod-plain-rest
                        ctx
                        fallthrough
                        producer-instr
                        producer-dst
                        div-instr
                        src
                        instrs
                        index
                        out)]))
                (compiler-backend-emit-steered-producer-divmod-plain-rest
                  ctx
                  fallthrough
                  producer-instr
                  producer-dst
                  div-instr
                  src
                  instrs
                  index
                  out))
              (compiler-backend-emit-steered-producer-divmod-plain-rest
                ctx
                fallthrough
                producer-instr
                producer-dst
                div-instr
                src
                instrs
                index
                out))]
          [_
            (compiler-backend-emit-steered-producer-divmod-plain-rest
              ctx
              fallthrough
              producer-instr
              producer-dst
              div-instr
              src
              instrs
              index
              out)]))
      (compiler-backend-emit-steered-producer-divmod-plain-rest
        ctx
        fallthrough
        producer-instr
        producer-dst
        div-instr
        src
        instrs
        index
        out))
    (compiler-backend-emit-steered-producer-divmod-plain-rest
      ctx
      fallthrough
      producer-instr
      producer-dst
      div-instr
      src
      instrs
      index
      out)))

(define (compiler-backend-try-divmod-result-gep-store
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [div-dst : i64]
  [div-op : compiler_ir_types.CompilerIrBinOp]
  [div-lhs : compiler_ir_types.CompilerIrValue]
  [div-rhs : compiler_ir_types.CompilerIrValue]
  [div-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : CompilerBackendMaybeDivmodPolish
  (if (and
    (be_simd.compiler-backend-var-single-use? ctx.use-counts div-dst)
    (be_scalar.compiler-backend-signed-literal-divmod-src-shape?
      ctx.type-segment-bases
      div-op
      (be_state.compiler-backend-global-shared-view div-rhs)
      (be_state.compiler-backend-global-shared-view div-ty)))
    (if (< index instrs.len)
      (let
        [maybe-gep (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
        [after-gep : i64 (+ index 1)]
        (match maybe-gep
          [(Gep gep-dst base offset elem-ty)
            (if (be_simd.compiler-backend-var-single-use?
              ctx.use-counts
              gep-dst)
              (if (< after-gep instrs.len)
                (let
                  [maybe-store
                    (compiler_ir_types.compiler-ir-instr-seq-ref
                      instrs
                      after-gep)]
                  [after-store : i64 (+ after-gep 1)]
                  (match maybe-store
                    [(StorePtr store-ptr store-value store-ty)
                      (if (compiler-backend-divmod-direct-gep-store?
                        ctx.backend-state
                        ctx.type-segment-bases
                        ctx.assignments
                        div-dst
                        gep-dst
                        base
                        offset
                        elem-ty
                        store-ptr
                        store-value)
                        (let
                          [_reserved : unit
                            (compiler-backend-set-current-instr-reserved-mask!
                              ctx.function-state
                              (compiler-backend-instr-reserved-home-mask
                                ctx.function-state
                                (be_state.compiler-backend-global-shared-view
                                  div-instr)))]
                          [magic : String
                            (compiler-backend-divmod-polish-magic-ahead
                              (be_state.compiler-backend-global-shared-view ctx)
                              (be_state.compiler-backend-global-shared-view
                                div-instr)
                              div-dst
                              (be_state.compiler-backend-global-shared-view
                                div-op)
                              div-rhs
                              div-ty
                              0)]
                          [hoist-reg : String
                            (compiler-backend-divmod-polish-hoist-reg-ahead
                              (be_state.compiler-backend-global-shared-view ctx)
                              (be_state.compiler-backend-global-shared-view
                                div-instr)
                              0)]
                          [src : String
                            (compiler-backend-divmod-polish-src
                              (be_state.compiler-backend-global-shared-view ctx)
                              div-dst
                              div-lhs
                              (be_state.compiler-backend-global-shared-view
                                magic)
                              hoist-reg
                              true
                              (be_scalar.compiler-backend-binop-wants-remainder?
                                div-op)
                              div-dst)]
                          (if (compiler-backend-divmod-direct-gep-store-clobber-safe?
                            ctx.backend-state
                            ctx.assignments
                            src
                            magic
                            base
                            offset)
                            (Some
                              (compiler-backend-emit-divmod-result-gep-store-rest
                                ctx
                                fallthrough
                                div-instr
                                div-dst
                                src
                                gep-dst
                                base
                                offset
                                elem-ty
                                store-value
                                store-ty
                                instrs
                                after-store
                                out))
                            (No)))
                        (No))]
                    [_ (No)]))
                (No))
              (No))]
          [_ (No)]))
      (No))
    (No)))

(define (compiler-backend-try-divmod-polish
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : CompilerBackendMaybeDivmodPolish
  (match (be_state.compiler-backend-global-shared-view instr)
    [(BinOp producer-dst producer-op producer-lhs producer-rhs producer-ty)
      (if (< index instrs.len)
        (let
          [next (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
          [after-div : i64 (+ index 1)]
          (match (be_state.compiler-backend-global-shared-view next)
            [(BinOp div-dst div-op div-lhs div-rhs div-ty)
              (if (compiler-backend-divmod-producer-feeds?
                (be_state.compiler-backend-global-shared-view ctx)
                producer-dst
                (be_state.compiler-backend-global-shared-view producer-op)
                (be_state.compiler-backend-global-shared-view producer-lhs)
                (be_state.compiler-backend-global-shared-view producer-rhs)
                (be_state.compiler-backend-global-shared-view producer-ty)
                div-op
                (be_state.compiler-backend-global-shared-view div-lhs)
                (be_state.compiler-backend-global-shared-view div-rhs)
                (be_state.compiler-backend-global-shared-view div-ty))
                (let
                  [_reserved : unit
                    (compiler-backend-set-current-instr-reserved-mask!
                      ctx.function-state
                      (compiler-backend-instr-reserved-home-mask
                        ctx.function-state
                        (be_state.compiler-backend-global-shared-view instr)))]
                  [magic : String
                    (compiler-backend-divmod-polish-magic-ahead
                      (be_state.compiler-backend-global-shared-view ctx)
                      (be_state.compiler-backend-global-shared-view next)
                      div-dst
                      (be_state.compiler-backend-global-shared-view div-op)
                      div-rhs
                      div-ty
                      1)]
                  [hoist-reg : String
                    (compiler-backend-divmod-polish-hoist-reg-ahead
                      (be_state.compiler-backend-global-shared-view ctx)
                      (be_state.compiler-backend-global-shared-view next)
                      1)]
                  [src : String
                    (compiler-backend-divmod-polish-src
                      (be_state.compiler-backend-global-shared-view ctx)
                      div-dst
                      div-lhs
                      (be_state.compiler-backend-global-shared-view magic)
                      hoist-reg
                      false
                      (be_scalar.compiler-backend-binop-wants-remainder? div-op)
                      producer-dst)]
                  (Some
                    (compiler-backend-emit-steered-producer-divmod-rest
                      ctx
                      fallthrough
                      instr
                      producer-dst
                      next
                      div-dst
                      src
                      magic
                      instrs
                      after-div
                      out)))
                (compiler-backend-try-divmod-result-gep-store
                  ctx
                  fallthrough
                  instr
                  producer-dst
                  producer-op
                  producer-lhs
                  producer-rhs
                  producer-ty
                  instrs
                  index
                  out))]
            [_
              (compiler-backend-try-divmod-result-gep-store
                ctx
                fallthrough
                instr
                producer-dst
                producer-op
                producer-lhs
                producer-rhs
                producer-ty
                instrs
                index
                out)]))
        (compiler-backend-try-divmod-result-gep-store
          ctx
          fallthrough
          instr
          producer-dst
          producer-op
          producer-lhs
          producer-rhs
          producer-ty
          instrs
          index
          out))]
    [_ (No)]))

(define (compiler-backend-emit-load-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [load-dst : i64]
  [ptr : compiler_ir_types.CompilerIrValue]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (and
    (compiler-backend-load-compare-type? ctx.type-segment-bases load-ty)
    (be_simd.compiler-backend-var-single-use? ctx.use-counts load-dst))
    (if (< index instrs.len)
      (let
        [next (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
        [after-cmp : i64 (+ index 1)]
        (match next
          [(Load second-dst second-src second-ty)
            (if (be_operand.compiler-backend-branch-uses-var?
              second-src
              load-dst)
              (compiler-backend-emit-fused-result-rest
                (be_state.compiler-backend-global-shared-view ctx)
                fallthrough
                (be_scalar.compiler-backend-emit-load-load
                  ctx.type-segment-bases
                  ctx.assignments
                  load-dst
                  ptr
                  load-ty
                  second-dst
                  second-ty
                  ctx.backend-state)
                instrs
                after-cmp
                out)
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                index
                out))]
          [(BinOp cmp-dst op lhs rhs cmp-ty)
            (if (and
              (be_facts.compiler-backend-compare-op? op)
              (be_operand.compiler-backend-branch-uses-var? lhs load-dst)
              (be_simd.compiler-backend-var-single-use? ctx.use-counts cmp-dst)
              (not
                (be_scalar.compiler-backend-binop-f64?
                  ctx.types
                  (be_state.compiler-backend-global-shared-view
                    ctx.global-types)
                  lhs
                  rhs
                  cmp-ty)))
              (if (< after-cmp instrs.len)
                (let
                  [branch
                    (compiler_ir_types.compiler-ir-instr-seq-ref
                      instrs
                      after-cmp)]
                  [after-branch : i64 (+ after-cmp 1)]
                  (match (compiler_ir_types.compiler-ir-instr-scalar-fact
                    branch)
                    [(Branch cond true-label false-label)
                      (if (be_operand.compiler-backend-branch-uses-var?
                        cond
                        cmp-dst)
                        (compiler-backend-emit-fused-load-compare-branch-rest
                          ctx
                          fallthrough
                          load-dst
                          ptr
                          load-ty
                          cmp-dst
                          op
                          rhs
                          cmp-ty
                          true-label
                          false-label
                          instrs
                          after-branch
                          out)
                        (compiler-backend-emit-instrs-normal
                          ctx
                          fallthrough
                          instr
                          instrs
                          index
                          out))]
                    [_
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        instrs
                        index
                        out)]))
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out))
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                index
                out))]
          [_
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out)]))
      (compiler-backend-emit-instrs-normal
        ctx
        fallthrough
        instr
        instrs
        index
        out))
    (compiler-backend-emit-instrs-normal ctx fallthrough instr instrs index out)))

(define (compiler-backend-emit-store-ptr-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [ptr : compiler_ir_types.CompilerIrValue]
  [value0 : compiler_ir_types.CompilerIrValue]
  [ty0 : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [maybe-gep (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [after-gep : i64 (+ index 1)]
      (match maybe-gep
        [(Gep gep-dst base offset elem-ty)
          (if (and
            (compiler_optimize.opt-value-eq (& base) (& ptr))
            (be_simd.compiler-backend-var-single-use? ctx.use-counts gep-dst))
            (match (be_operand.compiler-backend-value-as-i64 offset)
              [(Some n)
                (let
                  [disp : i64
                    (*
                      n
                      (be_operand.compiler-backend-type-size
                        ctx.type-segment-bases
                        elem-ty))]
                  (if (be_operand.compiler-backend-imm32? disp)
                    (if (< after-gep instrs.len)
                      (let
                        [maybe-store
                          (compiler_ir_types.compiler-ir-instr-seq-ref
                            instrs
                            after-gep)]
                        [after-store : i64 (+ after-gep 1)]
                        (match maybe-store
                          [(StorePtr dst value1 ty1)
                            (if (be_operand.compiler-backend-branch-uses-var?
                              dst
                              gep-dst)
                              (compiler-backend-emit-fused-result-rest
                                (be_state.compiler-backend-global-shared-view
                                  ctx)
                                fallthrough
                                (be_scalar.compiler-backend-emit-store-ptr-pair
                                  ctx.type-segment-bases
                                  ctx.assignments
                                  ptr
                                  value0
                                  ty0
                                  ;; GAP9: this pair ABSORBS the second store's
                                  ;; gep -- the walker resumes past it -- so its
                                  ;; ordinal must be consumed here or every later
                                  ;; gep in the function reads a shifted entry.
                                  ;; The admitted shape is a constant offset, for
                                  ;; which the pre-pass records displacement 0, so
                                  ;; the sum is the same spelling it always was.
                                  (+
                                    disp
                                    (compiler-backend-gep-fold-next!
                                      ctx.function-state
                                      ctx.type-segment-bases
                                      offset
                                      elem-ty))
                                  value1
                                  ty1
                                  ctx.program-index
                                  ctx.backend-state)
                                instrs
                                after-store
                                out)
                              (compiler-backend-emit-instrs-normal
                                ctx
                                fallthrough
                                instr
                                instrs
                                index
                                out))]
                          [_
                            (compiler-backend-emit-instrs-normal
                              ctx
                              fallthrough
                              instr
                              instrs
                              index
                              out)]))
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        instrs
                        index
                        out))
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      instrs
                      index
                      out)))]
              [(None)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out)])
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out))]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out)]))
    (compiler-backend-emit-instrs-normal ctx fallthrough instr instrs index out)))

(define (compiler-backend-vector-sign-bit-mode-at
  [backend-state : be_state.CompilerBackendState]
  [instrs : (& instrs compiler_ir_types.CompilerIrInstrSeq)]
  [cmp-index : i64]) : i64
  (if (< cmp-index instrs.len)
    (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs cmp-index)
      [(VectorCompare cp)
        (be_simd.compiler-backend-avx2-sign-bit-mask-mode-for-var
          backend-state
          cp.dst)]
      [_ 0])
    0))

;; The sign-bit mask emission for an AVX2 (bit_and, compare) pair whose
;; compare at `cursor` the sign-bit plan rewrote, resuming after the compare.
(define (compiler-backend-emit-vector-sign-bit-mask-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [cmp-dst : i64]
  [src-val : compiler_ir_types.CompilerIrValue]
  [bit-index : i64]
  [and-lanes : i64]
  [and-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [cursor : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [fused : be_state.ResultCompilerBackend
      (be_simd.compiler-backend-emit-avx2-sign-bit-mask
        ctx.type-segment-bases
        ctx.assignments
        cmp-dst
        src-val
        bit-index
        and-lanes
        and-ty
        (be_state.compiler-backend-instr-diagnostic-ref
          (& ctx.spans)
          ctx.source-function
          (compiler_ir_types.compiler-ir-instr-seq-borrow instrs cursor))
        ctx.backend-state)]
    (compiler-backend-emit-fused-result-rest
      ctx
      fallthrough
      fused
      instrs
      (+ cursor 1)
      out)))

;; An AVX2 (bit_and, compare) pair whose compare at `cursor` has sign-bit mode
;; `sign-mode`: a bit-63 test feeding one 4-lane 64-bit Select as its only use
;; blends on the source directly; any other plans a shifted sign-bit mask.
(define (compiler-backend-emit-vector-sign-bit-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [sign-mode : i64]
  [and-lhs : compiler_ir_types.CompilerIrValue]
  [and-rhs : compiler_ir_types.CompilerIrValue]
  [and-lanes : i64]
  [and-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [cursor : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [cmp-dst : i64
      (compiler_ir_types.compiler-ir-instr-dst
        (compiler_ir_types.compiler-ir-instr-seq-borrow instrs cursor))]
    [src-val : compiler_ir_types.CompilerIrValue
      (if (= (% (/ sign-mode 64) 2) 1)
        and-rhs
        and-lhs)]
    [bit-index : i64 (% sign-mode 64)]
    [after-cmp : i64 (+ cursor 1)]
    [direct? : bool
      (and
        (be_state.compiler-backend-current-mode-avx2? ctx.function-state)
        (= bit-index 63)
        (< after-cmp instrs.len)
        (be_simd.compiler-backend-var-single-use? ctx.use-counts cmp-dst)
        (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs after-cmp)
          [(Select sp)
            (and
              (= sp.lanes 4)
              (be_operand.compiler-backend-branch-uses-var? (& sp.mask) cmp-dst)
              (be_simd.compiler-backend-avx2-sign-bit-select-ty? (& sp.ty)))]
          [_ false]))]
    (if direct?
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs after-cmp)
        [(Select
            (box
              (fields
                [sel-dst dst]
                [sel-true on-true]
                [sel-false on-false]
                [sel-lanes lanes]
                [sel-ty ty])))
          (let
            [fused : be_state.ResultCompilerBackend
              (be_simd.compiler-backend-emit-avx2-blend
                ctx.type-segment-bases
                ctx.assignments
                sel-dst
                true
                (/ sign-mode 256)
                src-val
                sel-true
                sel-false
                sel-lanes
                sel-ty
                (be_state.compiler-backend-instr-diagnostic-ref
                  (& ctx.spans)
                  ctx.source-function
                  (compiler_ir_types.compiler-ir-instr-seq-borrow
                    instrs
                    after-cmp))
                ctx.backend-state)]
            (compiler-backend-emit-fused-result-rest
              ctx
              fallthrough
              fused
              instrs
              (+ after-cmp 1)
              out))]
        [_
          (compiler-backend-emit-vector-sign-bit-mask-rest
            ctx
            fallthrough
            cmp-dst
            src-val
            bit-index
            and-lanes
            and-ty
            instrs
            cursor
            out)])
      (compiler-backend-emit-vector-sign-bit-mask-rest
        ctx
        fallthrough
        cmp-dst
        src-val
        bit-index
        and-lanes
        and-ty
        instrs
        cursor
        out))))

(define (compiler-backend-emit-vector-binop-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [and-lhs : compiler_ir_types.CompilerIrValue]
  [and-rhs : compiler_ir_types.CompilerIrValue]
  [and-lanes : i64]
  [and-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [cursor : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [sign-mode : i64
      (if (or
        (be_state.compiler-backend-current-mode-avx2? ctx.function-state)
        (be_state.compiler-backend-current-mode-sse2? ctx.function-state))
        (compiler-backend-vector-sign-bit-mode-at
          ctx.backend-state
          (& instrs)
          cursor)
        0)]
    (if (> sign-mode 0)
      (compiler-backend-emit-vector-sign-bit-step
        ctx
        fallthrough
        sign-mode
        and-lhs
        and-rhs
        and-lanes
        and-ty
        instrs
        cursor
        out)
      (compiler-backend-emit-instrs-normal
        ctx
        fallthrough
        instr
        instrs
        cursor
        out))))

;; The register operand of a dual-load memory fold: the single-use loads
;; LOAD-DST (the current instruction) and LOAD2-DST (at CURSOR) feed one
;; associative, commutative integer op at CURSOR + 1, whose single-use result
;; feeds the same op at CURSOR + 2 with that operand. No when the shape fails,
;; or when the outer op is a `bit_and` whose compare at CURSOR + 3 the AVX2
;; sign-bit plan rewrote: that compare is emitted by the `bit_and` step.
(define (compiler-backend-vector-dual-load-fold-value
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [use-counts : (& use-counts (__tl_dyn-array i64))]
  [load-dst : i64]
  [load2-dst : i64]
  [lanes : i64]
  [elem-ty : (& elem-ty compiler_ast_types.AstType)]
  [instrs : (& instrs compiler_ir_types.CompilerIrInstrSeq)]
  [cursor : i64]) : be_state.CompilerBackendVectorMemFold
  (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs (+ cursor 1))
    [(VectorBinOp
        (box
          (fields
            [t1-dst dst]
            [op1 op]
            [t1-lhs lhs]
            [t1-rhs rhs]
            [t1-lanes lanes]
            [t1-ty ty])))
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs (+ cursor 2))
        [(VectorBinOp
            (box
              (fields
                [op2 op]
                [t2-lhs lhs]
                [t2-rhs rhs]
                [t2-lanes lanes]
                [t2-ty ty])))
          (let
            [t2-other : be_state.CompilerBackendVectorMemFold
              (if (be_operand.compiler-backend-branch-uses-var? t2-lhs t1-dst)
                (Some t2-rhs)
                (if (be_operand.compiler-backend-branch-uses-var? t2-rhs t1-dst)
                  (Some t2-lhs)
                  (No)))]
            (if (and
              (or
                (and
                  (be_operand.compiler-backend-branch-uses-var? t1-lhs load-dst)
                  (be_operand.compiler-backend-branch-uses-var?
                    t1-rhs
                    load2-dst))
                (and
                  (be_operand.compiler-backend-branch-uses-var?
                    t1-lhs
                    load2-dst)
                  (be_operand.compiler-backend-branch-uses-var? t1-rhs load-dst)))
              (= t1-lanes lanes)
              (= t2-lanes lanes)
              (be_simd.compiler-backend-var-single-use? use-counts t1-dst)
              (be_simd.compiler-backend-vector-binop-assoc-comm-int?
                (& op1)
                (& t1-ty))
              (be_simd.compiler-backend-vector-binop-op-eq? (& op1) (& op2))
              (compiler_optimize.opt-type-eq
                type-segment-bases
                elem-ty
                (& t1-ty))
              (compiler_optimize.opt-type-eq
                type-segment-bases
                elem-ty
                (& t2-ty))
              (be_simd.compiler-backend-vector-binop-memory-source-supported?
                (& op1)
                t2-lanes
                (be_simd.compiler-backend-copy-int-ast-type (& t2-ty)))
              (not
                (and
                  (match (& op2)
                    [(BitAnd) true]
                    [_ false])
                  (>
                    (compiler-backend-vector-sign-bit-mode-at
                      backend-state
                      instrs
                      (+ cursor 3))
                    0))))
              (match t2-other
                [(Some reg-value)
                  (if (or
                    (be_operand.compiler-backend-branch-uses-var?
                      reg-value
                      load-dst)
                    (be_operand.compiler-backend-branch-uses-var?
                      reg-value
                      load2-dst)
                    (be_operand.compiler-backend-branch-uses-var?
                      reg-value
                      t1-dst))
                    (No)
                    (Some reg-value))]
                [(No) (No)])
              (No)))]
        [_ (No)])]
    [_ (No)]))

(define (compiler-backend-emit-vector-load-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [load-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [index : compiler_ir_types.CompilerIrValue]
  [lanes : i64]
  [elem-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [cursor : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (< cursor instrs.len)
    (let
      [next (compiler_ir_types.compiler-ir-instr-seq-ref instrs cursor)]
      [after-binop : i64 (+ cursor 1)]
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs cursor)
        [(VectorLoad load2-dst base2 index2 lanes2 elem-ty2)
          (match (if (and
            (< (+ cursor 2) instrs.len)
            (= lanes lanes2)
            (be_simd.compiler-backend-var-single-use? ctx.use-counts load-dst)
            (be_simd.compiler-backend-var-single-use? ctx.use-counts load2-dst)
            (compiler_optimize.opt-type-eq
              ctx.type-segment-bases
              elem-ty
              (& elem-ty2)))
            (compiler-backend-vector-dual-load-fold-value
              ctx.backend-state
              ctx.type-segment-bases
              ctx.use-counts
              load-dst
              load2-dst
              lanes
              (& elem-ty)
              (& instrs)
              cursor)
            (be_state.CompilerBackendVectorMemFold.No))
            [(Some reg-value)
              (let
                [op2-instr
                  (compiler_ir_types.compiler-ir-instr-seq-ref
                    instrs
                    (+ cursor 2))]
                (match (compiler_ir_types.compiler-ir-instr-seq-ref
                  instrs
                  (+ cursor 2))
                  [(VectorBinOp
                      (box (fields [t2-dst dst] op [t2-lanes lanes] ty)))
                    (let
                      [fused : be_state.ResultCompilerBackend
                        (be_simd.compiler-backend-emit-vector-binop-dual-memory-source
                          (be_operand.compiler-backend-vector-mode
                            (& ty)
                            t2-lanes)
                          ctx.type-segment-bases
                          ctx.assignments
                          t2-dst
                          op
                          reg-value
                          base
                          index
                          base2
                          index2
                          t2-lanes
                          ty
                          (be_state.compiler-backend-instr-diagnostic-ref
                            (& ctx.spans)
                            ctx.source-function
                            (& op2-instr))
                          ctx.backend-state)]
                      (compiler-backend-emit-fused-result-rest
                        ctx
                        fallthrough
                        fused
                        instrs
                        (+ cursor 3)
                        out))]
                  [_
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      instrs
                      cursor
                      out)]))]
            [(No)
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                cursor
                out)])]
        [(VectorBinOp
            (box
              (fields
                [bin-dst dst]
                op
                lhs
                rhs
                [bin-lanes lanes]
                [bin-elem-ty ty])))
          (match (if (and
            (not
              (and
                (match (& op)
                  [(BitAnd) true]
                  [_ false])
                (>
                  (compiler-backend-vector-sign-bit-mode-at
                    ctx.backend-state
                    (& instrs)
                    after-binop)
                  0)))
            (be_simd.compiler-backend-vector-load-binop-foldable?
              ctx.type-segment-bases
              ctx.use-counts
              load-dst
              lanes
              elem-ty
              op
              (be_state.compiler-backend-global-shared-view lhs)
              (be_state.compiler-backend-global-shared-view rhs)
              bin-lanes
              (be_state.compiler-backend-global-shared-view bin-elem-ty)))
            (be_simd.compiler-backend-vector-load-binop-fold-value
              load-dst
              op
              lhs
              rhs)
            (be_state.CompilerBackendVectorMemFold.No))
            [(Some reg-value)
              (compiler-backend-emit-fused-result-rest
                (be_state.compiler-backend-global-shared-view ctx)
                fallthrough
                (be_simd.compiler-backend-emit-vector-binop-memory-source
                  (be_operand.compiler-backend-vector-mode
                    bin-elem-ty
                    bin-lanes)
                  ctx.type-segment-bases
                  ctx.assignments
                  bin-dst
                  op
                  reg-value
                  base
                  index
                  bin-lanes
                  bin-elem-ty
                  (be_state.compiler-backend-instr-diagnostic
                    ctx.spans
                    ctx.source-function
                    next
                    ctx.func-diag)
                  ctx.backend-state)
                instrs
                after-binop
                out)]
            [(No)
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                cursor
                out)])]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            cursor
            out)]))
    (compiler-backend-emit-instrs-normal
      ctx
      fallthrough
      instr
      instrs
      cursor
      out)))

(define (compiler-backend-emit-copy-bytes-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [dst : compiler_ir_types.CompilerIrValue]
  [src : compiler_ir_types.CompilerIrValue]
  [size : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [protect-n : i64
      (be_scalar.compiler-backend-copy-run-protect-count
        ctx.backend-state
        ctx.assignments
        instrs
        index)]
    [protect : (__tl_dyn-array String)
      (be_scalar.compiler-backend-copy-run-protect-exclude
        ctx.backend-state
        ctx.assignments
        (be_state.compiler-backend-global-shared-view instrs)
        index)]
    (compiler-backend-emit-fused-result-rest
      (be_state.compiler-backend-global-shared-view ctx)
      fallthrough
      (compiler-backend-emit-copy-bytes-avoid
        ctx.type-segment-bases
        ctx.assignments
        dst
        src
        size
        protect
        protect-n
        ctx.backend-state)
      instrs
      index
      out)))

;; ============================================================================
;; M6-I: memory-operand compare for a scalar GLOBAL read.
;;
;; A scalar global read lowers to `Mov dst @g` and renders as
;; `movq g(%rip), %r`. When that register's ONLY reader is the compare right
;; behind it, x86 reads the cell through the compare itself:
;;
;;     movq g(%rip), %r8 ; cmpq %rax, %r8 ; jne L
;;  -> cmpq g(%rip), %rax ; jne L
;;
;; This is the M6-B wide arm with a rip-relative `addr` in place of a SIB
;; triple, and every rail it runs on is one M6-B already owns:
;;
;;   * the moved var must be single-use, so dropping the `Mov` leaves nothing
;;     observing its home -- the same condition that retires the fused load in
;;     the Gep+Load arm;
;;   * `compiler-backend-cmp-fold-walk` admits only size-preserving casts
;;     between the read and the compare, so no store, call or flag write can
;;     land inside the window and the cell is read at the same point in the
;;     program it was read at before. A store to the global (or anywhere) ends
;;     the walk at itself and the probe then finds no compare, so it declines;
;;   * the compare's OTHER operand must be an immediate or a register home
;;     (`compiler-backend-gep-load-cmp-other-operand`), because `cmp mem, mem`
;;     is illegal -- a spilled operand declines;
;;   * the compare and its branch are consumed as one contiguous run, so the
;;     flags the jcc reads are the ones this `cmp` set, and the operand order
;;     (and the condition-swap an equality compare permits) is decided by
;;     `compiler-backend-gep-load-wide-cmp-asm`, unchanged.
;;
;; A rip-relative operand names no base and no index register, so none of
;; M6-D's staging and none of M6-H's scavenging applies: the address is always
;; spellable, and the fold retires one instruction and one register write with
;; nothing added.
;;
;; Only a full-word non-group global takes this path. A narrow global read
;; carries the load's own extension into the register, which is the M6-C width
;; table's business and not this arm's; a group-typed move is two words and
;; never a compare operand.
;;
;; Windows spells a global read identically -- the `Global` arm of
;; `compiler-backend-emit-load-value-into` is target-independent --
;; so the fold needs no target split. The streaming peephole reads the emitted
;; `cmpq g(%rip), %rax` through `compiler-backend-peephole-cmp-or-test-token?`,
;; which classifies compares as flag-only and leaves the reload-elision owner
;; map untouched; the folded-away `movq` would have published a global owner
;; for the destination register, so dropping it can only make that map more
;; conservative.
(define (compiler-backend-mov-global-cmp-address
  [ctx : be_state.CompilerBackendEmissionContext]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]) : String
  (be_scalar.compiler-backend-value-global-memory-operand
    ctx.backend-state
    ctx.type-segment-bases
    src
    ty))

(define (compiler-backend-emit-mov-global-cmp-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepLoadCmpEmission
  (let
    [addr : String
      (compiler-backend-mov-global-cmp-address
        (be_state.compiler-backend-global-shared-view ctx)
        (be_state.compiler-backend-global-shared-view src)
        (be_state.compiler-backend-global-shared-view ty))]
    (if (or
      (string.eq addr "")
      (>= index instrs.len)
      (be_facts.compiler-backend-copy-group?
        ctx.type-segment-bases
        ctx.program-index
        (be_state.compiler-backend-global-shared-view ty)
        dst
        src)
      (not (be_simd.compiler-backend-var-single-use? ctx.use-counts dst)))
      (No)
      (match (compiler-backend-gep-load-cmp-branch-probe
        (be_state.compiler-backend-global-shared-view ctx)
        addr
        dst
        ty
        (be_state.compiler-backend-global-shared-view instrs)
        index)
        [(Some cmp-asm true-jcc false-jcc true-label false-label after-branch)
          (Some
            (compiler-backend-emit-fused-result-rest
              (be_state.compiler-backend-global-shared-view ctx)
              fallthrough
              (compiler-backend-gep-load-cmp-branch-emit
                ctx
                cmp-asm
                true-jcc
                false-jcc
                true-label
                false-label
                (compiler-backend-fused-compare-fallthrough
                  instrs
                  after-branch
                  fallthrough))
              instrs
              after-branch
              out))]
        [(No) (No)]))))

;; The source kinds the dead-Mov skip is allowed to swallow: a var-to-var copy
;; and the integer-family immediates. Everything else -- an f64 immediate above
;; all -- is a value the emitter DIAGNOSES rather than emits, and a skip must
;; never take a diagnostic with it: `backend: f64 values are not supported yet`
;; is raised from the immediate load, so a `Mov` carrying one has to reach it
;; whether or not anything reads the destination.
(define (compiler-backend-mov-skip-source?
  [src : (& src compiler_ir_types.CompilerIrValue)]) : bool
  (match src
    [(or (Var _) (I64 _) (Bool _) (Char _) (Unit)) true]
    [_ false]))

(define (compiler-backend-emit-mov-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  ;; DCE-LATE belt-and-braces: a `Mov` whose destination is read by NO
  ;; instruction of the final IR computes nothing observable. The value is a
  ;; register or slot write nothing reloads, nothing aliases (an AddrOf of the
  ;; var counts as a use) and no runtime walk inspects, so the whole
  ;; instruction may be dropped. The optimizer's own late sweep normally
  ;; retires these first; this keeps a Mov minted after it, or by a pass the
  ;; sweep does not run under, from reaching the assembler. Group (aggregate)
  ;; copies are excluded: their destination spans more vars than the one this
  ;; use count answers for. None of the fusion lookaheads below can fire on a
  ;; never-used destination -- every one of them requires a SINGLE use.
  (if (and
    (be_calls.compiler-backend-var-never-used? ctx.backend-state dst)
    (compiler-backend-mov-skip-source? src)
    (not
      (be_facts.compiler-backend-copy-group?
        ctx.type-segment-bases
        ctx.program-index
        (be_state.compiler-backend-global-shared-view ty)
        dst
        (be_state.compiler-backend-global-shared-view src))))
    (compiler-backend-emit-instrs ctx fallthrough instrs index out)
    (match (compiler-backend-emit-mov-global-cmp-step
      (be_state.compiler-backend-global-shared-view ctx)
      fallthrough
      dst
      (be_state.compiler-backend-global-shared-view src)
      (be_state.compiler-backend-global-shared-view ty)
      (be_state.compiler-backend-global-shared-view instrs)
      index
      out)
      [(Some result) result]
      [(No)
        (compiler-backend-emit-mov-step-tail
          ctx
          fallthrough
          instr
          dst
          src
          ty
          instrs
          index
          out)])))

(define (compiler-backend-emit-mov-step-tail
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [next (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [after-jump : i64 (+ index 1)]
      (match next
        [(Cast cast-dst cast-src _ _)
          (if (< after-jump instrs.len)
            (let
              [after-cast
                (compiler_ir_types.compiler-ir-instr-seq-ref instrs after-jump)]
              [after-binop : i64 (+ after-jump 1)]
              (match after-cast
                [(BinOp bin-dst op lhs rhs bin-ty)
                  (if (and
                    (be_scalar.compiler-backend-divmod-op? op)
                    (be_operand.compiler-backend-branch-uses-var? cast-src dst)
                    (be_operand.compiler-backend-branch-uses-var? rhs cast-dst)
                    (be_simd.compiler-backend-var-single-use?
                      ctx.use-counts
                      dst)
                    (be_simd.compiler-backend-var-single-use?
                      ctx.use-counts
                      cast-dst)
                    (be_scalar.compiler-backend-divmod-safe-literal?
                      ctx.type-segment-bases
                      (be_state.compiler-backend-global-shared-view src)
                      bin-ty))
                    ;; The Mov and Cast are elided, but the BinOp still owns
                    ;; its scratch requirements at lookahead point 2. The
                    ;; plan-less wrapper would make pressured div/mod
                    ;; destinations query the Mov's empty scratch site.
                    (let
                      [binop-asm
                        (try
                          (be_scalar.compiler-backend-emit-binop
                            ctx.type-segment-bases
                            ctx.types
                            (be_state.compiler-backend-global-shared-view
                              ctx.global-types)
                            ctx.assignments
                            bin-dst
                            op
                            lhs
                            src
                            bin-ty
                            ctx.backend-state))]
                      (be_scalar.compiler-backend-emergency-append
                        out
                        binop-asm
                        ctx.backend-state)
                      (compiler-backend-emit-instrs
                        ctx
                        fallthrough
                        instrs
                        after-binop
                        out))
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      instrs
                      index
                      out))]
                [_
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out)]))
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out))]
        [(BinOp bin-dst op lhs rhs bin-ty)
          (if (and
            (be_scalar.compiler-backend-divmod-op? op)
            (be_operand.compiler-backend-branch-uses-var? rhs dst)
            (be_scalar.compiler-backend-divmod-safe-literal?
              ctx.type-segment-bases
              (be_state.compiler-backend-global-shared-view src)
              bin-ty))
            (let
              [prefix
                (try
                  (if (be_simd.compiler-backend-var-single-use?
                    ctx.use-counts
                    dst)
                    (be_state.ResultCompilerBackend.Ok "")
                    (be_calls.compiler-backend-emit-mov
                      ctx.type-segment-bases
                      ctx.assignments
                      dst
                      (be_state.compiler-backend-global-shared-view src)
                      ty
                      ctx.program-index
                      ctx.vars
                      ctx.backend-state)))]
              ;; This fusion emits the consumer while the cursor still names
              ;; the eliminated Mov. Select the BinOp's point-one scratch
              ;; ordinals explicitly so high-pressure spill paths remain
              ;; modeled.
              [binop-asm
                (try
                  (be_scalar.compiler-backend-emit-binop
                    ctx.type-segment-bases
                    ctx.types
                    (be_state.compiler-backend-global-shared-view
                      ctx.global-types)
                    ctx.assignments
                    bin-dst
                    op
                    lhs
                    src
                    bin-ty
                    ctx.backend-state))]
              (be_scalar.compiler-backend-emergency-append
                out
                (str_cat.str-cat prefix binop-asm)
                ctx.backend-state)
              (compiler-backend-emit-instrs
                ctx
                fallthrough
                instrs
                after-jump
                out))
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out))]
        [(Jump target-label)
          (compiler-backend-emit-fused-mov-trivial-phi-return-rest
            ctx
            fallthrough
            dst
            src
            ty
            target-label
            instrs
            after-jump
            out)]
        [(Return maybe)
          (if (< after-jump instrs.len)
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out)
            (match maybe
              [(Some value)
                (if (be_operand.compiler-backend-branch-uses-var? value dst)
                  (match (be_scalar.compiler-backend-emit-return
                    ctx.type-segment-bases
                    ctx.source-function
                    ctx.blocks
                    (Some src)
                    ctx.assignments
                    ctx.vars
                    ctx.ret-ty
                    ctx.program-index)
                    [(Ok asm)
                      (be_scalar.compiler-backend-emergency-append
                        out
                        asm
                        ctx.backend-state)
                      (Ok "")]
                    [(Err message)
                      (be_state.compiler-backend-instr-error-from
                        (be_state.compiler-backend-instr-diagnostic
                          ctx.spans
                          ctx.source-function
                          instr
                          ctx.func-diag)
                        message)])
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(No)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out)]))]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out)]))
    (compiler-backend-emit-instrs-normal ctx fallthrough instr instrs index out)))

(define (compiler-backend-emit-call-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [name : i64]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [next (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [after-return : i64 (+ index 1)]
      (match next
        [(Return maybe)
          (if (< after-return instrs.len)
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out)
            (match maybe
              [(Some value)
                (if (and
                  (be_operand.compiler-backend-branch-uses-var? value dst)
                  (not
                    (be_scalar.compiler-backend-stdlib-io-panic-name?
                      ctx.backend-state
                      name))
                  (compiler_optimize.opt-type-eq
                    ctx.type-segment-bases
                    ty
                    (& ctx.ret-ty)))
                  (compiler-backend-emit-terminator-into
                    (compiler-backend-emit-call-return
                      ctx.type-segment-bases
                      ctx.target-policy.target
                      ctx.source-function
                      ctx.blocks
                      name
                      args
                      ctx.assignments
                      ctx.types
                      ctx.global-types
                      ctx.vars
                      ctx.plan
                      ctx.functions
                      ctx.externs
                      ctx.program-index
                      (be_state.compiler-backend-instr-diagnostic
                        ctx.spans
                        ctx.source-function
                        instr
                        ctx.func-diag))
                    out
                    ctx.backend-state)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(No)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out)]))]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out)]))
    (compiler-backend-emit-instrs-normal ctx fallthrough instr instrs index out)))

;; CopyBytes whose SOURCE is the gep element (the mirror of the copy-dst rule
;; beside every caller). Fuses when the source spelling admits -- a SIB
;; base+index for a variable gep index, the base home for a constant one (whose
;; displacement is admitted through a static bound, never by reading the GAP9
;; entry) -- so the chunk loads address the element directly and the `leaq` that
;; materialized it disappears. A declined spelling falls through to ordinary
;; emission, which consumes the GAP9 gep ordinal itself; the admission test never
;; reads that ordinal, so exactly one side consumes it on every path.
(define (compiler-backend-emit-gep-copy-src-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [copy-dst : compiler_ir_types.CompilerIrValue]
  [copy-src : compiler_ir_types.CompilerIrValue]
  [copy-size : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [after-gep : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [spelling : String
      (if (be_operand.compiler-backend-branch-uses-var? copy-src gep-dst)
        (be_scalar.compiler-backend-copy-gep-element-spelling
          ctx.backend-state
          ctx.type-segment-bases
          ctx.assignments
          (be_state.compiler-backend-global-shared-view base)
          (be_state.compiler-backend-global-shared-view offset)
          (be_state.compiler-backend-global-shared-view elem-ty)
          copy-size)
        "")]
    (if (string.eq spelling "")
      (compiler-backend-emit-instrs-normal
        ctx
        fallthrough
        instr
        instrs
        index
        out)
      (let
        [protect-n : i64
          (be_scalar.compiler-backend-copy-run-protect-count
            ctx.backend-state
            ctx.assignments
            instrs
            after-gep)]
        [protect : (__tl_dyn-array String)
          (be_scalar.compiler-backend-copy-run-protect-exclude
            ctx.backend-state
            ctx.assignments
            (be_state.compiler-backend-global-shared-view instrs)
            after-gep)]
        ;; A dynamic index carries no constant part, so the whole starting
        ;; displacement is the GAP9 fold; a constant index carries `n * scale`
        ;; and the fold contributes 0. The ordinal is consumed exactly once
        ;; here, only on the admitted path.
        [src-disp : i64
          (+
            (compiler-backend-gep-const-element-disp
              ctx.type-segment-bases
              (be_state.compiler-backend-global-shared-view offset)
              (be_state.compiler-backend-global-shared-view elem-ty))
            (compiler-backend-gep-fold-next!
              ctx.function-state
              ctx.type-segment-bases
              offset
              elem-ty))]
        (compiler-backend-emit-fused-result-rest
          (be_state.compiler-backend-global-shared-view ctx)
          fallthrough
          (compiler-backend-emit-copy-bytes-gep-src
            ctx.type-segment-bases
            ctx.assignments
            copy-dst
            base
            offset
            spelling
            src-disp
            copy-size
            protect
            protect-n
            ctx.backend-state)
          instrs
          after-gep
          out)))))

;; The `Gep` fusion cluster of `compiler-backend-emit-instrs-step`. It is the
;; peephole family that folds a single-use address computation into the
;; instruction that consumes it -- load, store, copy, binop and the branch
;; forms behind them -- so it is one step, like the `mov`/`call`/`store-ptr`
;; steps.
(define (compiler-backend-emit-gep-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (be_simd.compiler-backend-var-single-use? ctx.use-counts gep-dst)
    (match (be_operand.compiler-backend-value-as-i64 offset)
      [(Some n)
        (if (< index instrs.len)
          (let
            [next (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
            [after-load : i64 (+ index 1)]
            (match next
              [(Load load-dst src load-ty)
                (if (be_operand.compiler-backend-branch-uses-var? src gep-dst)
                  (if (and
                    (be_operand.compiler-backend-imm32?
                      (*
                        n
                        (be_operand.compiler-backend-type-size
                          ctx.type-segment-bases
                          elem-ty)))
                    (compiler-backend-load-compare-type?
                      ctx.type-segment-bases
                      load-ty)
                    (be_simd.compiler-backend-var-single-use?
                      ctx.use-counts
                      load-dst)
                    ;; The fused compare+branch needs TWO more instructions.
                    ;; The end test is a conjunct rather than another nested
                    ;; `if` because running off the end of the block takes the
                    ;; same fallback the non-compare shapes take.
                    (< after-load instrs.len))
                    (let
                      [maybe-cmp
                        (compiler_ir_types.compiler-ir-instr-seq-ref
                          instrs
                          after-load)]
                      [after-cmp : i64 (+ after-load 1)]
                      (match maybe-cmp
                        [(BinOp cmp-dst op lhs rhs cmp-ty)
                          (if (and
                            (be_facts.compiler-backend-compare-op? op)
                            (be_operand.compiler-backend-branch-uses-var?
                              lhs
                              load-dst)
                            (be_simd.compiler-backend-var-single-use?
                              ctx.use-counts
                              cmp-dst)
                            (not
                              (be_scalar.compiler-backend-binop-f64?
                                ctx.types
                                (be_state.compiler-backend-global-shared-view
                                  ctx.global-types)
                                lhs
                                rhs
                                cmp-ty)))
                            (if (< after-cmp instrs.len)
                              (let
                                [branch
                                  (compiler_ir_types.compiler-ir-instr-seq-ref
                                    instrs
                                    after-cmp)]
                                [after-branch : i64 (+ after-cmp 1)]
                                (match (compiler_ir_types.compiler-ir-instr-scalar-fact
                                  branch)
                                  [(Branch cond true-label false-label)
                                    (if (be_operand.compiler-backend-branch-uses-var?
                                      cond
                                      cmp-dst)
                                      (compiler-backend-emit-fused-gep-load-compare-branch-rest
                                        (be_state.compiler-backend-global-shared-view
                                          ctx)
                                        fallthrough
                                        gep-dst
                                        (compiler-backend-gep-fold-next!
                                          ctx.function-state
                                          ctx.type-segment-bases
                                          offset
                                          elem-ty)
                                        base
                                        offset
                                        elem-ty
                                        load-dst
                                        load-ty
                                        cmp-dst
                                        op
                                        rhs
                                        cmp-ty
                                        true-label
                                        false-label
                                        instrs
                                        after-branch
                                        out)
                                      (compiler-backend-emit-fused-gep-load-rest
                                        (be_state.compiler-backend-global-shared-view
                                          ctx)
                                        fallthrough
                                        gep-dst
                                        (compiler-backend-gep-fold-next!
                                          ctx.function-state
                                          ctx.type-segment-bases
                                          offset
                                          elem-ty)
                                        base
                                        (be_state.compiler-backend-global-shared-view
                                          offset)
                                        elem-ty
                                        load-dst
                                        load-ty
                                        instrs
                                        after-load
                                        out))]
                                  [_
                                    (compiler-backend-emit-fused-gep-load-rest
                                      (be_state.compiler-backend-global-shared-view
                                        ctx)
                                      fallthrough
                                      gep-dst
                                      (compiler-backend-gep-fold-next!
                                        ctx.function-state
                                        ctx.type-segment-bases
                                        offset
                                        elem-ty)
                                      base
                                      (be_state.compiler-backend-global-shared-view
                                        offset)
                                      (be_state.compiler-backend-global-shared-view
                                        elem-ty)
                                      load-dst
                                      load-ty
                                      instrs
                                      after-load
                                      out)]))
                              (compiler-backend-emit-fused-gep-load-rest
                                (be_state.compiler-backend-global-shared-view
                                  ctx)
                                fallthrough
                                gep-dst
                                (compiler-backend-gep-fold-next!
                                  ctx.function-state
                                  ctx.type-segment-bases
                                  offset
                                  elem-ty)
                                base
                                offset
                                (be_state.compiler-backend-global-shared-view
                                  elem-ty)
                                load-dst
                                load-ty
                                instrs
                                after-load
                                out))
                            (compiler-backend-emit-fused-gep-load-rest
                              (be_state.compiler-backend-global-shared-view ctx)
                              fallthrough
                              gep-dst
                              (compiler-backend-gep-fold-next!
                                ctx.function-state
                                ctx.type-segment-bases
                                offset
                                elem-ty)
                              base
                              (be_state.compiler-backend-global-shared-view
                                offset)
                              elem-ty
                              load-dst
                              load-ty
                              instrs
                              after-load
                              out))]
                        [_
                          (compiler-backend-emit-fused-gep-load-rest
                            (be_state.compiler-backend-global-shared-view ctx)
                            fallthrough
                            gep-dst
                            (compiler-backend-gep-fold-next!
                              ctx.function-state
                              ctx.type-segment-bases
                              offset
                              elem-ty)
                            base
                            (be_state.compiler-backend-global-shared-view
                              offset)
                            (be_state.compiler-backend-global-shared-view
                              elem-ty)
                            load-dst
                            load-ty
                            instrs
                            after-load
                            out)]))
                    (compiler-backend-emit-fused-gep-load-rest
                      (be_state.compiler-backend-global-shared-view ctx)
                      fallthrough
                      gep-dst
                      (compiler-backend-gep-fold-next!
                        ctx.function-state
                        ctx.type-segment-bases
                        offset
                        elem-ty)
                      base
                      offset
                      (be_state.compiler-backend-global-shared-view elem-ty)
                      load-dst
                      load-ty
                      instrs
                      after-load
                      out))
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(StorePtr dst value store-ty)
                (if (be_operand.compiler-backend-branch-uses-var? dst gep-dst)
                  (compiler-backend-emit-fused-gep-store-rest
                    (be_state.compiler-backend-global-shared-view ctx)
                    fallthrough
                    gep-dst
                    (compiler-backend-gep-fold-next!
                      ctx.function-state
                      ctx.type-segment-bases
                      offset
                      elem-ty)
                    base
                    (be_state.compiler-backend-global-shared-view offset)
                    elem-ty
                    value
                    store-ty
                    instrs
                    after-load
                    out)
                  (compiler-backend-emit-instrs-normal
                    (be_state.compiler-backend-global-shared-view ctx)
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(CopyBytes copy-dst copy-src copy-size)
                (if (and
                  (be_operand.compiler-backend-branch-uses-var?
                    copy-dst
                    gep-dst)
                  (be_operand.compiler-backend-imm32?
                    (*
                      n
                      (be_operand.compiler-backend-type-size
                        ctx.type-segment-bases
                        elem-ty))))
                  (let
                    [protect-n : i64
                      (be_scalar.compiler-backend-copy-run-protect-count
                        ctx.backend-state
                        ctx.assignments
                        instrs
                        after-load)]
                    [protect : (__tl_dyn-array String)
                      (be_scalar.compiler-backend-copy-run-protect-exclude
                        ctx.backend-state
                        ctx.assignments
                        (be_state.compiler-backend-global-shared-view instrs)
                        after-load)]
                    (compiler-backend-emit-fused-result-rest
                      (be_state.compiler-backend-global-shared-view ctx)
                      fallthrough
                      (compiler-backend-emit-copy-bytes-from-gep-avoid
                        ctx.type-segment-bases
                        ctx.assignments
                        base
                        (be_state.compiler-backend-global-shared-view offset)
                        (be_state.compiler-backend-global-shared-view elem-ty)
                        copy-src
                        copy-size
                        protect
                        protect-n
                        (compiler-backend-gep-fold-next!
                          ctx.function-state
                          ctx.type-segment-bases
                          offset
                          elem-ty)
                        ctx.backend-state)
                      instrs
                      after-load
                      out))
                  ;; Not the copy DESTINATION (or out of imm32 range there):
                  ;; the source-side rule owns the mirror shape and declines
                  ;; back to ordinary emission itself, so the ordinal is
                  ;; consumed exactly once either way. A copy whose dst AND src
                  ;; are both this gep cannot reach either rule: that is two
                  ;; uses, and the whole cluster is behind a single-use gate.
                  (compiler-backend-emit-gep-copy-src-rest
                    (be_state.compiler-backend-global-shared-view ctx)
                    fallthrough
                    instr
                    gep-dst
                    base
                    (be_state.compiler-backend-global-shared-view offset)
                    (be_state.compiler-backend-global-shared-view elem-ty)
                    copy-dst
                    copy-src
                    copy-size
                    instrs
                    index
                    after-load
                    out))]
              [_
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out)]))
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out))]
      [(None)
        (if (< index instrs.len)
          (let
            [next (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
            [after-gep : i64 (+ index 1)]
            (match next
              [(Gep _ load-base load-offset _)
                (compiler-backend-emit-fused-result-rest
                  (be_state.compiler-backend-global-shared-view ctx)
                  fallthrough
                  (if (be_operand.compiler-backend-branch-uses-var?
                    load-base
                    gep-dst)
                    (be_scalar.compiler-backend-emit-gep
                      ctx.type-segment-bases
                      ctx.assignments
                      gep-dst
                      base
                      (be_state.compiler-backend-global-shared-view offset)
                      (be_state.compiler-backend-global-shared-view elem-ty)
                      (compiler-backend-gep-fold-next!
                        ctx.function-state
                        ctx.type-segment-bases
                        offset
                        elem-ty)
                      ctx.backend-state)
                    (be_scalar.compiler-backend-emit-gep-staged-avoid
                      ctx.type-segment-bases
                      ctx.assignments
                      gep-dst
                      base
                      (be_state.compiler-backend-global-shared-view offset)
                      (be_state.compiler-backend-global-shared-view elem-ty)
                      (compiler-backend-gep-fold-next!
                        ctx.function-state
                        ctx.type-segment-bases
                        offset
                        elem-ty)
                      (be_operand.compiler-backend-value-scalar-register
                        ctx.backend-state
                        ctx.assignments
                        load-base)
                      (be_operand.compiler-backend-value-scalar-register
                        ctx.backend-state
                        ctx.assignments
                        load-offset)
                      ctx.backend-state))
                  instrs
                  index
                  out)]
              [(Mov ptr-var src _)
                (if (and
                  (be_operand.compiler-backend-branch-uses-var? src gep-dst)
                  (be_simd.compiler-backend-var-single-use?
                    ctx.use-counts
                    ptr-var))
                  (if (< after-gep instrs.len)
                    (let
                      [maybe-store
                        (compiler_ir_types.compiler-ir-instr-seq-ref
                          instrs
                          after-gep)]
                      [after-store : i64 (+ after-gep 1)]
                      (match maybe-store
                        [(StorePtr dst value store-ty)
                          (if (be_operand.compiler-backend-branch-uses-var?
                            dst
                            ptr-var)
                            (compiler-backend-emit-fused-gep-store-rest
                              (be_state.compiler-backend-global-shared-view ctx)
                              fallthrough
                              gep-dst
                              (compiler-backend-gep-fold-next!
                                ctx.function-state
                                ctx.type-segment-bases
                                offset
                                elem-ty)
                              base
                              (be_state.compiler-backend-global-shared-view
                                offset)
                              elem-ty
                              value
                              store-ty
                              instrs
                              after-store
                              out)
                            (compiler-backend-emit-instrs-normal
                              (be_state.compiler-backend-global-shared-view ctx)
                              fallthrough
                              instr
                              instrs
                              index
                              out))]
                        [_
                          (compiler-backend-emit-instrs-normal
                            (be_state.compiler-backend-global-shared-view ctx)
                            fallthrough
                            instr
                            instrs
                            index
                            out)]))
                    (compiler-backend-emit-instrs-normal
                      (be_state.compiler-backend-global-shared-view ctx)
                      fallthrough
                      instr
                      instrs
                      index
                      out))
                  (compiler-backend-emit-instrs-normal
                    (be_state.compiler-backend-global-shared-view ctx)
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(Load load-dst src load-ty)
                (if (be_operand.compiler-backend-branch-uses-var? src gep-dst)
                  (compiler-backend-emit-fused-gep-load-rest
                    (be_state.compiler-backend-global-shared-view ctx)
                    fallthrough
                    gep-dst
                    (compiler-backend-gep-fold-next!
                      ctx.function-state
                      ctx.type-segment-bases
                      offset
                      elem-ty)
                    base
                    (be_state.compiler-backend-global-shared-view offset)
                    (be_state.compiler-backend-global-shared-view elem-ty)
                    load-dst
                    load-ty
                    instrs
                    after-gep
                    out)
                  (compiler-backend-emit-instrs-normal
                    (be_state.compiler-backend-global-shared-view ctx)
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(StorePtr dst value store-ty)
                (if (be_operand.compiler-backend-branch-uses-var? dst gep-dst)
                  (compiler-backend-emit-fused-gep-store-rest
                    (be_state.compiler-backend-global-shared-view ctx)
                    fallthrough
                    gep-dst
                    (compiler-backend-gep-fold-next!
                      ctx.function-state
                      ctx.type-segment-bases
                      offset
                      elem-ty)
                    base
                    (be_state.compiler-backend-global-shared-view offset)
                    (be_state.compiler-backend-global-shared-view elem-ty)
                    value
                    store-ty
                    instrs
                    after-gep
                    out)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(CopyBytes copy-dst copy-src copy-size)
                (if (be_operand.compiler-backend-branch-uses-var?
                  copy-dst
                  gep-dst)
                  (let
                    [protect-n : i64
                      (be_scalar.compiler-backend-copy-run-protect-count
                        ctx.backend-state
                        ctx.assignments
                        instrs
                        after-gep)]
                    [protect : (__tl_dyn-array String)
                      (be_scalar.compiler-backend-copy-run-protect-exclude
                        ctx.backend-state
                        ctx.assignments
                        (be_state.compiler-backend-global-shared-view instrs)
                        after-gep)]
                    (compiler-backend-emit-fused-result-rest
                      (be_state.compiler-backend-global-shared-view ctx)
                      fallthrough
                      (compiler-backend-emit-copy-bytes-from-gep-avoid
                        ctx.type-segment-bases
                        ctx.assignments
                        base
                        (be_state.compiler-backend-global-shared-view offset)
                        (be_state.compiler-backend-global-shared-view elem-ty)
                        copy-src
                        copy-size
                        protect
                        protect-n
                        (compiler-backend-gep-fold-next!
                          ctx.function-state
                          ctx.type-segment-bases
                          offset
                          elem-ty)
                        ctx.backend-state)
                      instrs
                      after-gep
                      out))
                  (compiler-backend-emit-gep-copy-src-rest
                    (be_state.compiler-backend-global-shared-view ctx)
                    fallthrough
                    instr
                    gep-dst
                    base
                    offset
                    elem-ty
                    copy-dst
                    copy-src
                    copy-size
                    instrs
                    index
                    after-gep
                    out))]
              [_
                (compiler-backend-emit-instrs-normal
                  (be_state.compiler-backend-global-shared-view ctx)
                  fallthrough
                  instr
                  instrs
                  index
                  out)]))
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out))])
    (compiler-backend-emit-instrs-normal ctx fallthrough instr instrs index out)))

(defenum CompilerBackendMaybeBitTest
  (No)
  ;; mask, count var, true label, false label, index after the branch,
  ;; the shift's dst (the register the literal-mask materialization may borrow),
  ;; and whether the shift-count guard is still owed
  (Some be_operand.CompilerBackendBitTestMask i64 i64 i64 i64 i64 bool))

(define (compiler-backend-bit-test-one?
  [value : (& compiler_ir_types.CompilerIrValue)]) : bool
  (match value
    [(I64 n) (= n 1)]
    [_ false]))

;; `bt`'s base operand has to be a register: with a memory base the processor
;; reads the bit offset as an unbounded signed index instead of taking it modulo
;; the operand size. The mask goes in the shift result's own home when that is a
;; register the count does not also live in -- the allocator coalesces the two
;; whenever the count dies here, which is the common case -- and otherwise in a
;; scavenged register free at this emission point.
;; A literal mask is materialized into the shift result's own home when the
;; allocator did not coalesce that with the count -- it does whenever the count
;; dies here, which is the common case -- and otherwise into a scavenged
;; register. Scavenging is a mutating query
;; (it books the emergency save/restore), so it stays out of the match test.
(define (compiler-backend-bit-test-mask-reg
  [ctx : be_state.CompilerBackendEmissionContext]
  [dst : i64]
  [count-reg : String]) : String
  (let
    [dst-home : String
      (be_scalar.compiler-backend-var-register-home
        ctx.backend-state
        ctx.assignments
        dst)]
    (cond
      [(and (not (string.eq dst-home "")) (not (string.eq dst-home count-reg)))
        dst-home]
      [else
        (be_operand.compiler-backend-scavenge-reg
          dst
          (__tl_make-array
            (be_state.compiler-backend-global-shared-view count-reg)
            ""
            ""
            ""
            "")
          1
          (if (string.eq count-reg "%r11")
            "%r10"
            "%r11")
          ctx.backend-state)])))

(define (compiler-backend-bit-test-count-reg
  [ctx : be_state.CompilerBackendEmissionContext]
  [count : i64]) : String
  (be_scalar.compiler-backend-var-register-home
    ctx.backend-state
    ctx.assignments
    count))

(define (compiler-backend-bit-test-mask-known?
  [mask : be_operand.CompilerBackendBitTestMask]) : bool
  (match mask
    [(No) false]
    [_ true]))

;; Register the `bt` base operand ends up in: a register-homed mask keeps its own
;; home (nothing is written to it); a literal mask, or a var mask the allocator
;; left somewhere other than a register, is placed into a register the count does
;; not occupy. An empty answer keeps the general shift lowering.
(define (compiler-backend-bit-test-base-reg
  [ctx : be_state.CompilerBackendEmissionContext]
  [mask : be_operand.CompilerBackendBitTestMask]
  [dst : i64]
  [count-reg : String]) : String
  (match mask
    [(No) ""]
    [(Var mask-var)
      (let
        [home : String
          (be_scalar.compiler-backend-var-register-home
            ctx.backend-state
            ctx.assignments
            mask-var)]
        (if (string.eq home "")
          (compiler-backend-bit-test-mask-reg ctx dst count-reg)
          home))]
    [(Literal _) (compiler-backend-bit-test-mask-reg ctx dst count-reg)]))

;; Text placing the mask in `mask-reg` ahead of the `bt`: a literal is
;; materialized; a var the allocator did NOT leave in a register -- spilled,
;; rematerialized, or slot-homed -- is loaded through the ordinary scalar loader,
;; which is exactly the one load the general shift lowering would have performed
;; on the same operand. A register-homed var needs nothing.
;;
;; This is what keeps the wide-mask suppression in the optimizer
;; (`opt-global-copy-keep-wide-left`) a strict win. Before it, a mask the
;; optimizer had left as a Var only lowered to `bt` when the allocator found it
;; a register; under pressure it fell all the way back to the general quad --
;; and, shift-count guard, shift, test -- while the folded literal form kept its
;; two-instruction `movabsq`/`btq`. The register-poor case is now `load`/`btq`:
;; the same two instructions, and one fewer whenever the register IS free.
(define (compiler-backend-bit-test-load-mask
  [ctx : be_state.CompilerBackendEmissionContext]
  [mask : be_operand.CompilerBackendBitTestMask]
  [ty : compiler_ast_types.AstType]
  [mask-reg : String]) : String
  (match mask
    [(Literal literal)
      (be_scalar.compiler-backend-emit-load-i64-absolute literal mask-reg)]
    [(Var mask-var)
      (if (string.eq
        (be_scalar.compiler-backend-var-register-home
          ctx.backend-state
          ctx.assignments
          mask-var)
        "")
        (be_scalar.compiler-backend-emit-load-typed-var-to-reg
          ctx.type-segment-bases
          ctx.assignments
          mask-var
          ty
          mask-reg
          ctx.backend-state)
        "")]
    [_ ""]))

(define (compiler-backend-bit-test-shr-mask
  [lhs : (& compiler_ir_types.CompilerIrValue)]) : be_operand.CompilerBackendBitTestMask
  (match lhs
    [(I64 mask) (Literal mask)]
    [(Var mask-var) (Var mask-var)]
    [_ (No)]))

(define (compiler-backend-bit-test-branch-tail
  [ctx : be_state.CompilerBackendEmissionContext]
  [dst : i64]
  [mask : be_operand.CompilerBackendBitTestMask]
  [count : i64]
  [guard? : bool]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeBitTest
  (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)
    [(BinOp test-dst (BitTestNe) test-lhs test-rhs _)
      (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs (+ index 1))
        [(Branch cond true-label false-label)
          (if (and
            (be_operand.compiler-backend-branch-uses-var? test-lhs dst)
            (compiler-backend-bit-test-one? test-rhs)
            (be_simd.compiler-backend-var-single-use? ctx.use-counts test-dst)
            (be_operand.compiler-backend-branch-uses-var? cond test-dst)
            ;; The mask needs no availability test of its own: a known mask can
            ;; always be placed. A literal materializes into the result's home or
            ;; a scavenged register, and every allocator home a
            ;; var can have -- register, spill slot, remat, plain slot -- is
            ;; loadable by the same scalar loader the general lowering would have
            ;; used on it (compiler-backend-bit-test-load-mask).
            ;; A successor with phis takes its copies on an edge block behind
            ;; the jcc (compiler-backend-gep-load-cmp-branch-emit), as a fused
            ;; compare's do.
            (not
              (string.eq
                (compiler-backend-bit-test-count-reg
                  (be_state.compiler-backend-global-shared-view ctx)
                  count)
                "")))
            (Some mask count true-label false-label (+ index 2) dst guard?)
            (No))]
        [_ (No)])]
    [_ (No)]))

;; `(bit-and c 63)` feeding the shift: the count is six bits, so the shift's
;; abort is unreachable and `bt`'s modulo-64 offset already performs the mask.
;; The whole quad -- and, shift, bit test, branch -- becomes one `bt` reading
;; `c`'s own home, with no guard in front of it.
(define (compiler-backend-bit-test-count-mask?
  [value : compiler_ir_types.CompilerIrValue]) : bool
  (match value
    [(I64 n) (= n 63)]
    [_ false]))

(define (compiler-backend-bit-test-masked-shift
  [instr : (& compiler_ir_types.CompilerIrInstr)]
  [masked : i64]) : CompilerBackendMaybeBitTest
  (match instr
    [(BinOp shift-dst (Shr _) shift-lhs (Var shift-count) _)
      (if (= shift-count masked)
        (Some
          (compiler-backend-bit-test-shr-mask shift-lhs)
          shift-dst
          0
          0
          0
          shift-dst
          false)
        (No))]
    [_ (No)]))

(define (compiler-backend-bit-test-masked-count-match
  [ctx : be_state.CompilerBackendEmissionContext]
  [masked : i64]
  [count : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeBitTest
  (if (>= (+ index 2) instrs.len)
    (No)
    (match (compiler-backend-bit-test-masked-shift
      (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)
      masked)
      [(No) (No)]
      [(Some mask shift-dst _ _ _ _ _)
        (if (and
          (compiler-backend-bit-test-mask-known? mask)
          (be_simd.compiler-backend-var-single-use? ctx.use-counts masked)
          (be_simd.compiler-backend-var-single-use? ctx.use-counts shift-dst))
          (compiler-backend-bit-test-branch-tail
            ctx
            shift-dst
            mask
            count
            false
            instrs
            (+ index 1))
          (No))])))

(define (compiler-backend-bit-test-branch-match
  [ctx : be_state.CompilerBackendEmissionContext]
  [dst : i64]
  [op : (& op compiler_ir_types.CompilerIrBinOp)]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeBitTest
  (match op
    [(Shr _)
      (match rhs
        [(Var count)
          (let
            [mask : be_operand.CompilerBackendBitTestMask
              (compiler-backend-bit-test-shr-mask lhs)]
            (if (and
              (compiler-backend-bit-test-mask-known? mask)
              (be_simd.compiler-backend-var-single-use? ctx.use-counts dst)
              (< (+ index 1) instrs.len))
              (compiler-backend-bit-test-branch-tail
                ctx
                dst
                mask
                count
                true
                instrs
                index)
              (No)))]
        [_ (No)])]
    [(BitAnd)
      (match lhs
        [(Var count)
          (if (compiler-backend-bit-test-count-mask? rhs)
            (compiler-backend-bit-test-masked-count-match
              ctx
              dst
              count
              instrs
              index)
            (No))]
        [_ (No)])]
    [_ (No)]))

(define (compiler-backend-emit-bit-test-branch
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [ty : compiler_ast_types.AstType]
  [mask : be_operand.CompilerBackendBitTestMask]
  [count : i64]
  [true-label : i64]
  [false-label : i64]
  [guard? : bool]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [count-reg : String
      (compiler-backend-bit-test-count-reg
        (be_state.compiler-backend-global-shared-view ctx)
        count)]
    [mask-reg : String
      (compiler-backend-bit-test-base-reg
        (be_state.compiler-backend-global-shared-view ctx)
        mask
        dst
        (be_state.compiler-backend-global-shared-view count-reg))]
    [load-mask : String
      (compiler-backend-bit-test-load-mask
        (be_state.compiler-backend-global-shared-view ctx)
        mask
        (be_state.compiler-backend-global-shared-view ty)
        (be_state.compiler-backend-global-shared-view mask-reg))]
    [test-asm : String
      (str_cat.str-cat
        (if guard?
          (be_scalar.compiler-backend-shift-guard-asm
            ctx.type-segment-bases
            (be_state.compiler-backend-global-shared-view ty)
            (compiler_ir_types.compiler-ir-binop-rhs-type op ty)
            (be_state.compiler-backend-global-shared-view count-reg)
            ctx.backend-state)
          "")
        load-mask
        (str_cat.str-cat "    btq " count-reg ", " mask-reg "\n"))]
    [head : String
      (try
        (compiler-backend-gep-load-cmp-branch-emit
          (be_state.compiler-backend-global-shared-view ctx)
          test-asm
          "jb"
          "jae"
          true-label
          false-label
          (compiler-backend-fused-compare-fallthrough instrs index fallthrough)))]
    (be_state.compiler-backend-asm-append
      out
      (be_scalar.compiler-backend-emergency-wrap head ctx.backend-state))
    (compiler-backend-emit-instrs ctx fallthrough instrs index out)))

;; LEA selection across a sole-use pair. `t = mul x, n` (a SIB factor) or
;; `t = add x, k` whose only reader is the very next instruction
;; `u = add t, k'` / `u = add t, y` is one `leaq disp(base,index,scale), u`:
;;   mul x, 3 ; add t, 2   ->  leaq 2(x,x,2), u
;;   mul x, 4 ; add t, y   ->  leaq (y,x,4), u
;;   add x, -48 ; add t, y ->  leaq -48(y,x), u
;; LEA computes the same wrapped 64-bit sum, so `t` is simply never written.
;; It writes no EFLAGS where the consumer's `addq` would have, so a consumer
;; whose result the next instruction compares is refused: that compare's
;; `testq` is dropped after a flags-writing `addq` (the ZF/SF peephole), and
;; fusing there would only trade the saved instruction for the kept `testq`.
;; Every operand must sit in a register other than %rbp, which a base slot
;; would make look like a frame address to the rsp rebase.
(define (compiler-backend-lea-pair-asm
  [ctx : be_state.CompilerBackendEmissionContext]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : (& ty compiler_ast_types.AstType)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : be_state.CompilerBackendMaybeAsm
  (unless
    (and
      (< index instrs.len)
      (compiler-backend-gep-fold-64bit-int? ty)
      (be_simd.compiler-backend-var-single-use? ctx.use-counts dst)
      (match lhs
        [(Var _) true]
        [_ false]))
    (return (No)))
  (let
    [source : String
      (be_operand.compiler-backend-value-scalar-register
        ctx.backend-state
        ctx.assignments
        lhs)]
    ;; The first instruction as a LEA term: a product's factor, or an
    ;; immediate add's displacement (its index is `source` at scale 1).
    [scaled? : bool
      (match (& op)
        [(Mul) true]
        [_ false])]
    [factor : i64
      (match (& rhs)
        [(I64 n)
          (if scaled?
            n
            0)]
        [_ 0])]
    [offset : CompilerBackendMaybeVarImm
      (match (& op)
        [(or (Add) (Sub))
          (compiler-backend-gep-fold-offset-operands op lhs rhs)]
        [_ (No)])]
    [first-disp : i64
      (match (& offset)
        [(Some _ k) k]
        [(No) 0])]
    ;; A product's SIB text ("" for any other first instruction).
    [first-sib : String
      (if scaled?
        (be_scalar.compiler-backend-mul-sib-operand source factor false)
        "")]
    [term-ok? : bool
      (if scaled?
        (not (string.eq first-sib ""))
        (match (& offset)
          [(Some _ k) (be_operand.compiler-backend-imm32? k)]
          [(No) false]))]
    (when
      (or (string.eq source "") (string.eq source "%rbp") (not term-ok?))
      (return (No)))
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(BinOp u op2 a b ty2)
        (let
          [target : String
            (be_scalar.compiler-backend-var-register-home
              ctx.backend-state
              ctx.assignments
              u)]
          ;; The addend of `t + y`, when that is the consumer's shape.
          [addend : i64
            (match (& op2)
              [(Add)
                (match (& a)
                  [(Var av)
                    (match (& b)
                      [(Var bv)
                        (cond
                          [(and (= av dst) (not (= bv dst))) bv]
                          [(and (= bv dst) (not (= av dst))) av]
                          [else (- 0 1)])]
                      [_ (- 0 1)])]
                  [_ (- 0 1)])]
              [_ (- 0 1)])]
          [prev-dst : i64
            (if (>= index 2)
              (compiler_ir_types.compiler-ir-instr-dst
                (compiler_ir_types.compiler-ir-instr-seq-borrow
                  instrs
                  (- index 2)))
              -1)]
          [next-binop-reads-u? : bool
            (if (< (+ index 1) instrs.len)
              (match (compiler_ir_types.compiler-ir-instr-seq-borrow
                instrs
                (+ index 1))
                [(BinOp _ _ nl nr _)
                  (or
                    (match (& nl)
                      [(Var v) (= v u)]
                      [_ false])
                    (match (& nr)
                      [(Var v) (= v u)]
                      [_ false]))]
                [_ false])
              false)]
          (when
            (or
              (not (compiler-backend-gep-fold-64bit-int? (& ty2)))
              (string.eq target "")
              (compiler-backend-next-compare-reads-var? instrs (+ index 1) u))
            (return (No)))
          (if (>= addend 0)
            ;; `u = t + y`: needs a free base slot -- a 2/4/8 product (no base
            ;; register) or an add of an immediate (the sum's index alone).
            ;; A forwarded addr-of addend has no register home ("" here), so
            ;; it falls back to the plain pair.
            (let
              [base : String
                (be_operand.compiler-backend-value-scalar-register
                  ctx.backend-state
                  ctx.assignments
                  (& (compiler_ir_types.CompilerIrValue.Var addend)))]
              [free-base? : bool
                (or (not scaled?) (= factor 2) (= factor 4) (= factor 8))]
              (if (or
                (not free-base?)
                (string.eq base "")
                (string.eq base "%rbp"))
                (No)
                (let
                  ;; Avoid slow 3-component `leaq disp(dep, inv), dep` (3c
                  ;; latency on `dep`) when `dep` (`base == target`) was just
                  ;; produced by the preceding instruction and `inv` (`source`)
                  ;; is independent: splitting to `leaq disp(inv), tmp; addq
                  ;; tmp, dep` runs `leaq disp(inv)` in parallel with `dep`'s
                  ;; producer and leaves only a 1c `addq` on `dep`.
                  [split-3op? : bool
                    (and
                      (not scaled?)
                      (!= first-disp 0)
                      (string.eq base target)
                      (not (string.eq source target))
                      (= prev-dst addend)
                      next-binop-reads-u?)]
                  [dst-home-reg : String
                    (if split-3op?
                      (be_scalar.compiler-backend-var-register-home
                        ctx.backend-state
                        ctx.assignments
                        dst)
                      "")]
                  (match (if split-3op?
                    (be_scalar.compiler-backend-split-3op-lea-asm
                      ctx.backend-state
                      first-disp
                      (& source)
                      (& base)
                      (& dst-home-reg))
                    (be_state.CompilerBackendMaybeAsm.No))
                    [(Some split-asm) (Some split-asm)]
                    [(No)
                      (Some
                        (str_cat.str-cat
                          "    leaq "
                          (if (= first-disp 0)
                            ""
                            (string.int->string first-disp))
                          "("
                          base
                          (if scaled?
                            (string.substring
                              first-sib
                              1
                              (- (string.string-length first-sib) 1))
                            (str_cat.str-cat "," source ")"))
                          ", "
                          target
                          "\n"))]))))
            ;; `u = t + k'`: only after a product; two immediate adds are the
            ;; folder's job.
            (match (compiler-backend-gep-fold-offset-operands op2 a b)
              [(Some v k)
                (if (and
                  scaled?
                  (= v dst)
                  (be_operand.compiler-backend-imm32? k))
                  (Some
                    (str_cat.str-cat
                      "    leaq "
                      (string.int->string k)
                      first-sib
                      ", "
                      target
                      "\n"))
                  (No))]
              [(No) (No)])))]
      [_ (No)])))

;; Does the instruction at `index` compare `var`?
(define (compiler-backend-next-compare-reads-var?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [var : i64]) : bool
  (if (>= index instrs.len)
    false
    (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)
      [(BinOp _ op a b _)
        (and
          (be_facts.compiler-backend-compare-op? (& op))
          (or
            (be_operand.compiler-backend-branch-uses-var? (& a) var)
            (be_operand.compiler-backend-branch-uses-var? (& b) var)))]
      [_ false])))

;; A sole-use byte offset such as i*24 followed by an address addition can
;; use two LEAs: i*3, then base + scaled-index*8. This removes multiply latency
;; without adding instructions. Keep the existing homes and refuse any shape
;; whose Gep could disappear into a later memory operation.
;; The successful path owns the absorbed Gep ordinal; rejected probes are pure.
(define (compiler-backend-mul-gep-asm
  [ctx : be_state.CompilerBackendEmissionContext]
  [dst : i64]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : (& ty compiler_ast_types.AstType)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : be_state.CompilerBackendMaybeAsm
  (unless
    (and
      (< index instrs.len)
      (compiler-backend-gep-fold-64bit-int? ty)
      (be_simd.compiler-backend-var-single-use? ctx.use-counts dst))
    (return (No)))
  (match rhs
    [(I64 n)
      (let
        [factor : i64
          (cond
            [(or (= n 6) (= n 12) (= n 24)) 3]
            [(or (= n 10) (= n 20) (= n 40)) 5]
            [(or (= n 18) (= n 36) (= n 72)) 9]
            [else 0])]
        (when (= factor 0) (return (No)))
        (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs index)
          [(Gep address-dst base offset elem-ty)
            (unless
              (and
                (be_operand.compiler-backend-branch-uses-var? offset dst)
                (=
                  (be_operand.compiler-backend-type-size
                    ctx.type-segment-bases
                    elem-ty)
                  1)
                (not
                  (be_simd.compiler-backend-var-single-use?
                    ctx.use-counts
                    address-dst))
                (not
                  (compiler-backend-var-fuse-safe?
                    ctx.backend-state
                    address-dst))
                (=
                  (compiler-backend-gep-fold-peek
                    ctx.function-state
                    ctx.type-segment-bases
                    0
                    offset
                    elem-ty)
                  0))
              (return (No)))
            (let
              [source
                (be_operand.compiler-backend-value-scalar-register
                  ctx.backend-state
                  ctx.assignments
                  lhs)]
              [base-home
                (be_operand.compiler-backend-value-scalar-register
                  ctx.backend-state
                  ctx.assignments
                  base)]
              [temp
                (be_scalar.compiler-backend-var-register-home
                  ctx.backend-state
                  ctx.assignments
                  dst)]
              [target
                (be_scalar.compiler-backend-var-register-home
                  ctx.backend-state
                  ctx.assignments
                  address-dst)]
              ;; A %rbp base would be mistaken for a frame reference by
              ;; FPO rebasing. The scaled temporary may use the index slot.
              (when
                (or
                  (string.eq source "")
                  (string.eq base-home "")
                  (string.eq temp "")
                  (string.eq target "")
                  (string.eq source "%rbp")
                  (string.eq base-home "%rbp")
                  (string.eq temp base-home))
                (return (No)))
              (compiler-backend-gep-fold-next!
                ctx.function-state
                ctx.type-segment-bases
                offset
                elem-ty)
              (Some
                (str_cat.str-cat
                  "    leaq ("
                  source
                  ","
                  source
                  ","
                  (string.int->string (- factor 1))
                  "), "
                  temp
                  "\n    leaq ("
                  base-home
                  ","
                  temp
                  ","
                  (string.int->string (/ n factor))
                  "), "
                  target
                  "\n")))]
          [_ (No)]))]
    [_ (No)]))

(define (compiler-backend-emit-binop-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (match (compiler-backend-lea-pair-asm
    (be_state.compiler-backend-global-shared-view ctx)
    dst
    (be_state.compiler-backend-global-shared-view op)
    (be_state.compiler-backend-global-shared-view lhs)
    (be_state.compiler-backend-global-shared-view rhs)
    (& ty)
    (be_state.compiler-backend-global-shared-view instrs)
    index)
    [(Some text)
      (return
        (compiler-backend-emit-fused-result-rest
          ctx
          fallthrough
          (Ok text)
          instrs
          (+ index 1)
          out))]
    [(No) unit])
  (when
    (match (& op)
      [(Mul) true]
      [_ false])
    (match (compiler-backend-mul-gep-asm
      (be_state.compiler-backend-global-shared-view ctx)
      dst
      (be_state.compiler-backend-global-shared-view lhs)
      (be_state.compiler-backend-global-shared-view rhs)
      ty
      (be_state.compiler-backend-global-shared-view instrs)
      index)
      [(Some text)
        (return
          (compiler-backend-emit-fused-result-rest
            ctx
            fallthrough
            (Ok text)
            instrs
            (+ index 1)
            out))]
      [(No) unit]))
  (match (compiler-backend-bit-test-branch-match
    (be_state.compiler-backend-global-shared-view ctx)
    dst
    op
    (be_state.compiler-backend-global-shared-view lhs)
    (be_state.compiler-backend-global-shared-view rhs)
    (be_state.compiler-backend-global-shared-view instrs)
    index)
    [(Some mask count true-label false-label after-branch base-dst guard?)
      (compiler-backend-emit-bit-test-branch
        ctx
        fallthrough
        base-dst
        op
        ty
        mask
        count
        true-label
        false-label
        guard?
        instrs
        after-branch
        out)]
    [(No)
      (compiler-backend-emit-binop-step-general
        ctx
        fallthrough
        instr
        dst
        op
        lhs
        rhs
        ty
        instrs
        index
        out)]))

(defenum CompilerBackendMaybeFlagsBranch
  (No)
  ;; branch condition, true label, false label, index just past the branch
  (Some compiler_ir_types.CompilerIrValue i64 i64 i64))

;; The `not` shape of the flags-reuse match: the comparison materializes, a
;; boolean negation of it follows, and the branch reads the negation. The `not`
;; only swaps the two successors -- the same inversion
;; `compiler-backend-emit-fused-not-branch-rest` performs -- so the comparison's
;; own flags still decide the branch, read with the SAME jcc pair against
;; exchanged labels. Admitted only when the negation never materializes
;; (single-use or fuse-safe), because otherwise its `xorq $1` would land between
;; the comparison and the jumps and clobber the flags being reused.
(define (compiler-backend-flags-not-branch-match
  [ctx : be_state.CompilerBackendEmissionContext]
  [dst : i64]
  [next : compiler_ir_types.CompilerIrInstr]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeFlagsBranch
  (match next
    [(UnOp not-dst (Not) not-src (Bool))
      (if (and
        (be_operand.compiler-backend-branch-uses-var? not-src dst)
        (or
          (be_simd.compiler-backend-var-single-use? ctx.use-counts not-dst)
          (compiler-backend-var-fuse-safe? ctx.backend-state not-dst))
        (< index instrs.len))
        (match (compiler_ir_types.compiler-ir-instr-scalar-fact
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index))
          [(Branch cond true-label false-label)
            (if (be_operand.compiler-backend-branch-uses-var? cond not-dst)
              (Some cond false-label true-label (+ index 1))
              (No))]
          [_ (No)])
        (No))]
    [_ (No)]))

;; The branch that may consume a materialized comparison's own flags: it must be
;; the instruction right after the comparison and must read exactly the boolean
;; the comparison defined. `compiler-ir-instr-scalar-fact` folds TotalEnumBranch
;; into Branch, so both terminator spellings are covered. A branch on a COPY of
;; the boolean is refused -- the copy's home is what such a branch reads, and
;; whatever produced the copy is not this comparison.
(define (compiler-backend-flags-branch-match
  [ctx : be_state.CompilerBackendEmissionContext]
  [dst : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeFlagsBranch
  (if (>= index instrs.len)
    (No)
    (let
      [next (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      (match (compiler_ir_types.compiler-ir-instr-scalar-fact
        (be_state.compiler-backend-global-shared-view next))
        [(Branch cond true-label false-label)
          (if (be_operand.compiler-backend-branch-uses-var? cond dst)
            (Some cond true-label false-label (+ index 1))
            (No))]
        [_
          (compiler-backend-flags-not-branch-match
            ctx
            dst
            next
            instrs
            (+ index 1))]))))

;; Emit the jumps of a branch whose condition is already live in EFLAGS, then
;; the rest of the block, exactly as the ordinary branch emission would.
(define (compiler-backend-emit-flags-reuse-branch-rest
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [cond : compiler_ir_types.CompilerIrValue]
  [true-label : i64]
  [false-label : i64]
  [true-jcc : String]
  [false-jcc : String]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [head
      (try
        (be_calls.compiler-backend-emit-branch-with-phi-copies
          ctx.type-segment-bases
          ctx.assignments
          (be_state.compiler-backend-global-shared-view ctx.function)
          (be_state.compiler-backend-global-shared-view ctx.blocks)
          ctx.current-label
          cond
          true-label
          false-label
          (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
          ctx.program-index
          ctx.vars
          true-jcc
          false-jcc))]
    (be_state.compiler-backend-asm-append
      out
      (be_scalar.compiler-backend-emergency-wrap head ctx.backend-state))
    (compiler-backend-emit-instrs ctx fallthrough instrs index out)))

;; Cross-edge flags carry. The in-block reuse above keeps a comparison's flags
;; live to the branch that reads its boolean; a `jcc` writes no EFLAGS either,
;; and neither does the `movq`-only text the operand staging and the emergency
;; restore emit around a compare. So a block that ENDS in a compare+branch
;; fusion leaves its compare's flags live at the successor that branch's OWN
;; label names. When nothing else runs on the way in -- the successor's entry
;; carries no phi copies and the branch does not forward through another block
;; -- and that successor's FIRST instruction compares the same two vars at the
;; same width and feeds its own terminator, the `cmp` is redundant and only the
;; `jcc` is emitted, with the condition inverted when the operands are swapped.
;;
;; Every edge that would spend the carry is checked where it is spent:
;;   * the successor has exactly ONE predecessor, from the peephole's own
;;     predecessor counts, so no other edge reaches its label with stray flags;
;;   * the branch's true/false label names that successor itself, not a
;;     #jump-forward resolution of another label (which other blocks' jumps are
;;     retargeted onto, so the IR predecessor count cannot see them);
;;   * the successor's entry carries no phi copies, which would run on the way
;;     in and overwrite the flags;
;;   * the compare is not a bit-test, whose `test` flags are an AND, not a
;;     comparison of its operands;
;;   * the successor's block prologue emits no const-hoist code and the record
;;     was written by the fused compare+branch emission that actually ran, so
;;     nothing else sits between the compare and the successor's first
;;     instruction. The record is cleared on every other path.
;; Only register vars are carried: their homes are the same on both sides of
;; the edge, so the same operands and the same flags.
(define (compiler-backend-edge-flags-var-id
  [value : (& value compiler_ir_types.CompilerIrValue)]) : i64
  (match value
    [(Var id) id]
    [_ -1]))

(define (compiler-backend-edge-flags-clear!
  [function-state : be_state.CompilerBackendFunctionState]) : unit
  (be_state.compiler-backend-function-scratch-set-i64!
    function-state
    be_state.compiler-backend-scratch-i64-edge-flags-to
    (compiler_ir_types.compiler-ir-label-none)))

;; Record the compare a block's tail branch leaves live into `fallthrough`, or
;; clear the record. Only a branch whose OWN label names the layout-next block
;; carries flags: #jump-forward retargets other blocks' jumps onto that label
;; (so the IR predecessor count cannot see every emitted edge into it), and a
;; resolved target that merely lands there is not this block's fall-through. A
;; successor whose entry carries phi copies is refused too -- those copies run
;; on the way in and would overwrite the flags.
(define (compiler-backend-edge-flags-record-tail!
  [function-state : be_state.CompilerBackendFunctionState]
  [type-segment-bases : i64]
  [after : i64]
  [instr-count : i64]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [true-label : i64]
  [false-label : i64]
  [op : (& op compiler_ir_types.CompilerIrBinOp)]
  [lhs : (& lhs compiler_ir_types.CompilerIrValue)]
  [rhs : (& rhs compiler_ir_types.CompilerIrValue)]
  [operand-ty : (& operand-ty compiler_ast_types.AstType)]) : unit
  (let
    [lhs-id : i64 (compiler-backend-edge-flags-var-id lhs)]
    [rhs-id : i64 (compiler-backend-edge-flags-var-id rhs)]
    (if (and
      (= after instr-count)
      (not (be_operand.compiler-backend-float-type? operand-ty))
      (not (be_facts.compiler-backend-bit-test-op? op))
      (>= lhs-id 0)
      (>= rhs-id 0)
      (match fallthrough
        [(Some to)
          (and
            (or (= true-label to) (= false-label to))
            (not (be_peephole.compiler-backend-phi-target? function-state to)))]
        [(No) false]))
      (match fallthrough
        [(Some to)
          (be_state.compiler-backend-function-scratch-set-i64!
            function-state
            be_state.compiler-backend-scratch-i64-edge-flags-to
            to)
          (be_state.compiler-backend-function-scratch-set-i64!
            function-state
            be_state.compiler-backend-scratch-i64-edge-flags-lhs
            lhs-id)
          (be_state.compiler-backend-function-scratch-set-i64!
            function-state
            be_state.compiler-backend-scratch-i64-edge-flags-rhs
            rhs-id)
          (be_state.compiler-backend-function-scratch-set-i64!
            function-state
            be_state.compiler-backend-scratch-i64-edge-flags-width
            (be_operand.compiler-backend-type-size
              type-segment-bases
              operand-ty))]
        [(No) (compiler-backend-edge-flags-clear! function-state)])
      (compiler-backend-edge-flags-clear! function-state))))

;; The two cases the successor's compare can present: same operand order (1) and
;; swapped (2), which reads the same flags with the inverted condition. Zero is
;; no match. The record is cleared on every consult: the carry is a
;; one-instruction window, so the successor's first instruction either spends it
;; here or loses it.
(define (compiler-backend-edge-flags-take
  [function-state : be_state.CompilerBackendFunctionState]
  [type-segment-bases : i64]
  [label : i64]
  [index : i64]
  [op : (& op compiler_ir_types.CompilerIrBinOp)]
  [lhs : (& lhs compiler_ir_types.CompilerIrValue)]
  [rhs : (& rhs compiler_ir_types.CompilerIrValue)]
  [operand-ty : (& operand-ty compiler_ast_types.AstType)]) : i64
  (let
    [to : i64
      (be_state.compiler-backend-function-scratch-i64
        function-state
        be_state.compiler-backend-scratch-i64-edge-flags-to)]
    [recorded-lhs : i64
      (be_state.compiler-backend-function-scratch-i64
        function-state
        be_state.compiler-backend-scratch-i64-edge-flags-lhs)]
    [recorded-rhs : i64
      (be_state.compiler-backend-function-scratch-i64
        function-state
        be_state.compiler-backend-scratch-i64-edge-flags-rhs)]
    [recorded-width : i64
      (be_state.compiler-backend-function-scratch-i64
        function-state
        be_state.compiler-backend-scratch-i64-edge-flags-width)]
    [lhs-id : i64 (compiler-backend-edge-flags-var-id lhs)]
    [rhs-id : i64 (compiler-backend-edge-flags-var-id rhs)]
    [order : i64
      (if (= to label)
        (if (and (= lhs-id recorded-lhs) (= rhs-id recorded-rhs))
          1
          (if (and (= lhs-id recorded-rhs) (= rhs-id recorded-lhs))
            2
            0))
        0)]
    [taken : i64
      (if (or
        (= order 0)
        (not (= index 1))
        (be_operand.compiler-backend-float-type? operand-ty)
        (be_facts.compiler-backend-bit-test-op? op)
        (< lhs-id 0)
        (< rhs-id 0)
        (not
          (=
            (be_operand.compiler-backend-type-size
              type-segment-bases
              operand-ty)
            recorded-width)))
        0
        order)]
    (compiler-backend-edge-flags-clear! function-state)
    taken))

;; Take the cross-edge carry for the block about to be emitted, or clear it.
;; `injected?` reports a non-empty const-hoist injection, which is code between
;; the branching block's `jcc` and this block's first instruction and so closes
;; the window. The block must start with the compare: then nothing else can run
;; before the instruction that spends the flags.
(define (compiler-backend-edge-flags-enter-block!
  [function-state : be_state.CompilerBackendFunctionState]
  [label : i64]
  [instrs : (& instrs compiler_ir_types.CompilerIrInstrSeq)]
  [predcount : (& predcount backend_label_i64_map.Map)]
  [injected? : bool]) : unit
  (let
    [to : i64
      (be_state.compiler-backend-function-scratch-i64
        function-state
        be_state.compiler-backend-scratch-i64-edge-flags-to)]
    [pending : bool (= to label)]
    (compiler-backend-edge-flags-clear! function-state)
    (when
      (and pending (not injected?) (> instrs.len 0))
      (match (compiler_ir_types.compiler-ir-instr-seq-borrow instrs 0)
        [(BinOp _ op lhs rhs _)
          (when
            (and
              (be_facts.compiler-backend-compare-op? op)
              (not (be_facts.compiler-backend-bit-test-op? op))
              (>= (compiler-backend-edge-flags-var-id lhs) 0)
              (>= (compiler-backend-edge-flags-var-id rhs) 0)
              (= 1 (backend_label_i64_map.get-value-or predcount label 0)))
            (be_state.compiler-backend-function-scratch-set-i64!
              function-state
              be_state.compiler-backend-scratch-i64-edge-flags-to
              label))]
        [_ unit]))))

;; Flags reuse for a comparison that MUST materialize. The fused paths above
;; fire only when the boolean is never needed as a value; with a stored bool or
;; a phi input among its readers the setcc/movzb stay, and the adjacent branch
;; would re-derive the very flags they were computed from:
;;
;;     cmpq %rcx, %rax / setl %al / movzbq %al, %rax / testq %rax, %rax / jne L
;;
;; `setcc` and `movzb` read EFLAGS and write none, so the `cmp`'s flags are
;; still exactly what `setl` saw. Branching with the comparison's own `jcc`
;; retires the `test` -- one instruction, no duplicated compare, no extra live
;; range. The materialization is emitted first and then INSPECTED
;; (`compiler-backend-asm-tail-setcc-materializes?`): the rewrite is taken only
;; when the emitted text really ends with the matching `setcc`/`movzb` pair, so
;; every lowering that ends some other way -- a folded constant, a float
;; compare, an operand staged after the flags were set -- falls back to the
;; ordinary branch untouched instead of having to be enumerated here.
(define (compiler-backend-emit-materialized-compare-branch-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (match (if (be_facts.compiler-backend-compare-op? op)
    (compiler-backend-flags-branch-match
      (be_state.compiler-backend-global-shared-view ctx)
      dst
      (be_state.compiler-backend-global-shared-view instrs)
      index)
    (CompilerBackendMaybeFlagsBranch.No))
    [(No)
      (compiler-backend-emit-instrs-normal
        ctx
        fallthrough
        instr
        instrs
        index
        out)]
    [(Some cond true-label false-label after)
      (let
        [operand-ty : compiler_ast_types.AstType
          (be_scalar.compiler-backend-binop-operand-ty
            ctx.types
            (be_state.compiler-backend-global-shared-view ctx.global-types)
            (be_state.compiler-backend-global-shared-view op)
            (be_state.compiler-backend-global-shared-view lhs)
            (be_state.compiler-backend-global-shared-view rhs)
            (be_state.compiler-backend-global-shared-view ty))]
        [setcc : String
          (be_scalar.compiler-backend-compare-setcc
            ctx.type-segment-bases
            op
            (be_state.compiler-backend-global-shared-view operand-ty))]
        [true-jcc : String
          (be_scalar.compiler-backend-compare-true-jcc
            ctx.type-segment-bases
            op
            operand-ty)]
        [false-jcc : String
          (be_scalar.compiler-backend-compare-false-jcc
            ctx.type-segment-bases
            op
            operand-ty)]
        (if (or
          (string.eq setcc "")
          (string.eq true-jcc "")
          (string.eq false-jcc "")
          (be_scalar.compiler-backend-binop-f64?
            ctx.types
            (be_state.compiler-backend-global-shared-view ctx.global-types)
            lhs
            rhs
            ty))
          (compiler-backend-emit-instrs-normal
            (be_state.compiler-backend-global-shared-view ctx)
            fallthrough
            instr
            instrs
            index
            out)
          (let
            [head
              (try
                (compiler-backend-emit-instr
                  (be_state.compiler-backend-global-shared-view ctx)
                  (No)
                  (be_state.compiler-backend-global-shared-view instr)))]
            (if (compiler-backend-asm-tail-setcc-materializes? head setcc)
              (begin
                (let
                  [location : String
                    (be_scalar.compiler-backend-debug-instr-location
                      (be_state.compiler-backend-global-shared-view ctx)
                      instr)]
                  (if (> (string.string-length location) 0)
                    (be_state.compiler-backend-asm-append out location)
                    unit))
                (be_scalar.compiler-backend-emergency-append
                  out
                  head
                  ctx.backend-state)
                (compiler-backend-emit-flags-reuse-branch-rest
                  ctx
                  fallthrough
                  cond
                  true-label
                  false-label
                  true-jcc
                  false-jcc
                  instrs
                  after
                  out))
              (compiler-backend-emit-instrs-after-emitted
                ctx
                fallthrough
                instr
                instrs
                index
                head
                out)))))]))

(define (compiler-backend-emit-binop-step-general
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (and
    (be_simd.compiler-backend-var-single-use? ctx.use-counts dst)
    (be_scalar.compiler-backend-rax-forwardable-binop?
      ctx.types
      (be_state.compiler-backend-global-shared-view ctx.global-types)
      ctx.assignments
      op
      lhs
      rhs
      ty)
    (compiler-backend-rest-starts-rax-forwardable-consumer?
      ctx.types
      (be_state.compiler-backend-global-shared-view ctx.global-types)
      ctx.assignments
      dst
      (be_state.compiler-backend-global-shared-view instrs)
      index))
    (let
      [head
        (try
          (be_scalar.compiler-backend-emit-binop-to-rax
            ctx.type-segment-bases
            ctx.types
            (be_state.compiler-backend-global-shared-view ctx.global-types)
            ctx.assignments
            dst
            op
            lhs
            rhs
            (be_state.compiler-backend-global-shared-view ty)
            false
            ctx.backend-state))]
      (be_state.compiler-backend-asm-append
        out
        (be_scalar.compiler-backend-emergency-wrap head ctx.backend-state))
      (compiler-backend-emit-instrs-with-rax
        (be_state.compiler-backend-global-shared-view ctx)
        fallthrough
        dst
        ty
        instrs
        index
        out))
    (if (and
      (be_facts.compiler-backend-compare-op? op)
      (or
        (be_simd.compiler-backend-var-single-use? ctx.use-counts dst)
        (compiler-backend-var-fuse-safe? ctx.backend-state dst)))
      (if (< index instrs.len)
        (let
          [next (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
          [after-branch : i64 (+ index 1)]
          [float? : bool
            (be_scalar.compiler-backend-binop-f64?
              ctx.types
              (be_state.compiler-backend-global-shared-view ctx.global-types)
              lhs
              rhs
              ty)]
          (match next
            [(Return maybe)
              (if (or (< after-branch instrs.len) float?)
                (compiler-backend-emit-instrs-normal
                  (be_state.compiler-backend-global-shared-view ctx)
                  fallthrough
                  instr
                  instrs
                  index
                  out)
                (match maybe
                  [(Some value)
                    (if (be_operand.compiler-backend-branch-uses-var? value dst)
                      (compiler-backend-emit-terminator-into
                        (be_scalar.compiler-backend-emit-binop-return
                          ctx.type-segment-bases
                          ctx.backend-state
                          ctx.source-function
                          (be_state.compiler-backend-global-shared-view
                            ctx.blocks)
                          ctx.types
                          ctx.global-types
                          ctx.assignments
                          ctx.vars
                          op
                          lhs
                          rhs
                          ty)
                        out
                        ctx.backend-state)
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        instrs
                        index
                        out))]
                  [(No)
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      instrs
                      index
                      out)]))]
            [(or (Branch cond true-label false-label)
                 (TotalEnumBranch cond true-label false-label))
              (if (be_operand.compiler-backend-branch-uses-var? cond dst)
                (compiler-backend-emit-fused-compare-branch-rest
                  ctx
                  fallthrough
                  dst
                  op
                  lhs
                  rhs
                  ty
                  true-label
                  false-label
                  instrs
                  after-branch
                  out)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out))]
            ;; SS-P5(b) / VG-P-B: a scalar Select reading this comparison's
            ;; result and nothing else needs no boolean at all -- the compare's
            ;; own flags drive one `cmov<cc>`. The scratch registers are the
            ;; ones the SELECT's ordinary emission would have scavenged. The
            ;; emitter declines by
            ;; returning `No` whenever the operand shapes cannot guarantee the
            ;; compare's operands survive the two staging loads.
            [(Select
                (box
                  (fields
                    [select-dst dst]
                    [select-mask mask]
                    [select-true on-true]
                    [select-false on-false]
                    [select-lanes lanes]
                    [select-ty ty])))
              (match (if (and
                (= select-lanes 0)
                (not float?)
                (be_operand.compiler-backend-branch-uses-var? select-mask dst))
                (be_simd.compiler-backend-emit-select-on-flags
                  ctx.type-segment-bases
                  ctx.assignments
                  select-dst
                  select-true
                  select-false
                  select-ty
                  (be_state.compiler-backend-global-shared-view op)
                  (be_state.compiler-backend-global-shared-view lhs)
                  (be_state.compiler-backend-global-shared-view rhs)
                  (be_scalar.compiler-backend-binop-operand-ty
                    ctx.types
                    (be_state.compiler-backend-global-shared-view
                      ctx.global-types)
                    op
                    lhs
                    rhs
                    ty)
                  ctx.backend-state)
                (be_state.CompilerBackendMaybeAsm.No))
                [(Some head)
                  (compiler-backend-emit-fused-result-rest
                    ctx
                    fallthrough
                    (Ok head)
                    instrs
                    after-branch
                    out)]
                [(No)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out)])]
            [(UnOp not-dst (Not) not-src (Bool))
              ;; A single-use `not` between a comparison and its branch
              ;; only reverses the two successors. Keep the compare
              ;; flags live, omit both boolean materializations, and
              ;; branch to the opposite labels directly.
              (if (and
                (be_simd.compiler-backend-var-single-use? ctx.use-counts dst)
                (be_simd.compiler-backend-var-single-use?
                  ctx.use-counts
                  not-dst)
                (be_operand.compiler-backend-branch-uses-var? not-src dst))
                (if (< after-branch instrs.len)
                  (let
                    [branch
                      (compiler_ir_types.compiler-ir-instr-seq-ref
                        instrs
                        after-branch)]
                    [after-not-branch : i64 (+ after-branch 1)]
                    (match (compiler_ir_types.compiler-ir-instr-scalar-fact
                      branch)
                      [(Branch cond true-label false-label)
                        (if (be_operand.compiler-backend-branch-uses-var?
                          cond
                          not-dst)
                          (compiler-backend-emit-fused-compare-branch-rest
                            (be_state.compiler-backend-global-shared-view ctx)
                            fallthrough
                            dst
                            op
                            lhs
                            rhs
                            ty
                            false-label
                            true-label
                            instrs
                            after-not-branch
                            out)
                          (compiler-backend-emit-instrs-normal
                            (be_state.compiler-backend-global-shared-view ctx)
                            fallthrough
                            instr
                            instrs
                            index
                            out))]
                      [_
                        (compiler-backend-emit-instrs-normal
                          (be_state.compiler-backend-global-shared-view ctx)
                          fallthrough
                          instr
                          instrs
                          index
                          out)]))
                  (compiler-backend-emit-instrs-normal
                    (be_state.compiler-backend-global-shared-view ctx)
                    fallthrough
                    instr
                    instrs
                    index
                    out))
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out))]
            [_
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                index
                out)]))
        (compiler-backend-emit-instrs-normal
          ctx
          fallthrough
          instr
          instrs
          index
          out))
      ;; The comparison materializes (a stored bool or a phi input reads it), so
      ;; the setcc/movzb stay -- but an adjacent branch on that same boolean can
      ;; still read the comparison's own flags instead of re-deriving them. Every
      ;; other binop falls straight through to the ordinary emission there.
      (compiler-backend-emit-materialized-compare-branch-step
        ctx
        fallthrough
        instr
        dst
        op
        lhs
        rhs
        ty
        instrs
        index
        out))))

(define (compiler-backend-emit-instrs-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [cursor : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (< cursor instrs.len)
    (let
      [instr (compiler_ir_types.compiler-ir-instr-seq-ref instrs cursor)]
      [rest : i64 (+ cursor 1)]
      (match (be_state.compiler-backend-global-shared-view instr)
        [(Mov dst src ty)
          (if (be_state.compiler-backend-function-state-bool?
            ctx.function-state
            be_state.compiler-backend-function-bool-identity-tail-forwarder-active)
            ;; Whole-function admission proved these fresh snapshots only feed
            ;; the identity tail call, whose incoming registers remain intact.
            (compiler-backend-emit-instrs ctx fallthrough instrs rest out)
            (compiler-backend-emit-mov-step
              ctx
              fallthrough
              instr
              dst
              src
              ty
              instrs
              rest
              out))]
        [(Call dst name args ty)
          (compiler-backend-emit-call-step
            ctx
            fallthrough
            instr
            dst
            name
            args
            ty
            instrs
            rest
            out)]
        [(StorePtr ptr value0 ty0)
          (compiler-backend-emit-store-ptr-step
            ctx
            fallthrough
            instr
            ptr
            value0
            ty0
            instrs
            rest
            out)]
        [(Gep gep-dst base offset elem-ty)
          (compiler-backend-emit-gep-step
            ctx
            fallthrough
            instr
            gep-dst
            base
            offset
            elem-ty
            instrs
            rest
            out)]
        [(CopyBytes dst src size)
          (compiler-backend-emit-copy-bytes-step
            ctx
            fallthrough
            dst
            src
            size
            instrs
            rest
            out)]
        [(VectorLoad load-dst base index lanes elem-ty)
          (compiler-backend-emit-vector-load-step
            ctx
            fallthrough
            instr
            load-dst
            base
            index
            lanes
            elem-ty
            instrs
            rest
            out)]
        [(VectorBinOp (box (fields op lhs rhs lanes ty)))
          (if (match (& op)
            [(BitAnd) true]
            [_ false])
            (compiler-backend-emit-vector-binop-step
              ctx
              fallthrough
              instr
              lhs
              rhs
              lanes
              ty
              instrs
              rest
              out)
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              rest
              out))]
        [(Load load-dst ptr load-ty)
          (compiler-backend-emit-load-step
            ctx
            fallthrough
            instr
            load-dst
            ptr
            load-ty
            instrs
            rest
            out)]
        [(BinOp dst op lhs rhs ty)
          (compiler-backend-emit-binop-step
            ctx
            fallthrough
            instr
            dst
            op
            lhs
            rhs
            ty
            instrs
            rest
            out)]
        [(UnOp dst (Not) src (Bool))
          (if (or
            (be_simd.compiler-backend-var-single-use? ctx.use-counts dst)
            (compiler-backend-var-fuse-safe? ctx.backend-state dst))
            (if (< rest instrs.len)
              (let
                [branch
                  (compiler_ir_types.compiler-ir-instr-seq-ref instrs rest)]
                [after-branch : i64 (+ rest 1)]
                (match (compiler_ir_types.compiler-ir-instr-scalar-fact branch)
                  [(Branch cond true-label false-label)
                    (if (and
                      (be_operand.compiler-backend-branch-uses-var? cond dst)
                      (compiler-backend-branch-value-direct?
                        ctx.assignments
                        (be_state.compiler-backend-global-shared-view src)
                        ctx.backend-state))
                      (compiler-backend-emit-fused-not-branch-rest
                        ctx
                        fallthrough
                        dst
                        src
                        (Bool)
                        true-label
                        false-label
                        instrs
                        after-branch
                        out)
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        instrs
                        rest
                        out))]
                  [_
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      instrs
                      rest
                      out)]))
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                rest
                out))
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              rest
              out))]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            rest
            out)]))
    (Ok "")))

(define (compiler-backend-emit-instrs-divmod-polish-step
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [instr (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [rest : i64 (+ index 1)]
      (match (compiler-backend-try-divmod-polish
        (be_state.compiler-backend-global-shared-view ctx)
        fallthrough
        instr
        (be_state.compiler-backend-global-shared-view instrs)
        rest
        out)
        [(Some result) result]
        [(No)
          (compiler-backend-emit-instrs-step ctx fallthrough instrs index out)]))
    (compiler-backend-emit-instrs-step ctx fallthrough instrs index out)))

;; Drift-proof per-instruction position for the scavenge coordinate. `post-base`
;; is the cumulative instruction count through the current block (accumulated per
;; block in emit-blocks-into, reset per function in install-ctx); the structural
;; index of the head of `current-instrs` is `post-base - (count current-instrs)`,
;; which equals the interval walk's I (point = 2*I), fusion-proof because the emit
;; loop maintains current-instrs (consuming K drops its length by K). Consumed
;; by the no-dst scavenge.
;; The remaining-instruction count at the current emit step, captured per step so
;; the no-dst scavenge (compiler-backend-scavenge-reg-here) can derive its point =
;; 2*(post-base - count). Stored as a count, not the list, because the list is a
;; loop-carried owner value that cannot be moved into a global. No asm output.
;; Function-wide structural instruction ordinal of the current emit step. The
;; optimizer may clone or reuse an IR destination vreg, so backend-local labels
;; that surround one instruction need this site identity rather than assuming
;; `(block, dst)` is unique. Unlike current-count, this is always exact even for
;; stack-only plans because label identity is independent of register planning.
(define (compiler-backend-emit-needs-current-count?
  [plan-mask : i64]
  [const-hoist-sites : i64]
  [backend-mode : be_state.CompilerBackendMode]) : bool
  (or
    (not (= plan-mask 0))
    (not (= const-hoist-sites 0))
    ;; AVX2 and SSE2 predicated-store lane labels use the instruction point as
    ;; their identity. Even a stack-only plan therefore needs the exact count so
    ;; two stores in one block cannot emit the same local labels.
    (be_state.compiler-backend-mode-avx2? backend-mode)
    (be_state.compiler-backend-mode-sse2? backend-mode)))

(define (compiler-backend-emit-instrs-loop
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [mode : be_state.CompilerBackendEmitInstrsMode]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (let
    [current-mode : be_state.CompilerBackendEmitInstrsMode mode]
    ;; `current-count` is read BEFORE `current-instrs` takes ownership of the
    ;; sequence: the binding is an owner move, so `instrs` is not readable
    ;; afterwards. It is refreshed alongside the cursor on every continue.
    [current-count : i64 instrs.len]
    [current-instrs : compiler_ir_types.CompilerIrInstrSeq instrs]
    [current-index : i64 index]
    [done : bool false]
    [ok : bool true]
    [asm-out : String ""]
    [diag-out : (Box compiler_diagnostic.CompilerDiagnostic)
      (box (compiler_diagnostic.compiler-diagnostic-at-start "" ""))]
    (be_state.compiler-backend-function-state-set-bool!
      ctx.function-state
      be_state.compiler-backend-function-bool-emit-instrs-loop-active
      true)
    (while (not done)
      (let
        [step-result : be_state.ResultCompilerBackend
          (begin
            (be_state.compiler-backend-function-state-set-emit-current-site!
              ctx.function-state
              (-
                (be_state.compiler-backend-function-state-emit-instr-post-base
                  ctx.function-state)
                (- current-count current-index)))
            (be_state.compiler-backend-function-state-set-emit-current-count!
              ctx.function-state
              (if (compiler-backend-emit-needs-current-count?
                (be_state.compiler-backend-function-scratch-i64
                  ctx.function-state
                  be_state.compiler-backend-scratch-i64-scavenge-plan-reg-mask)
                (be_state.compiler-backend-function-scratch-i64
                  ctx.function-state
                  be_state.compiler-backend-scratch-i64-const-hoist-site-count)
                (be_state.compiler-backend-function-state-current-mode
                  ctx.function-state))
                (- current-count current-index)
                0))
            (be_state.compiler-backend-function-state-set-bool!
              ctx.function-state
              be_state.compiler-backend-function-bool-emit-instrs-continue-pending
              false)
            (if (< current-index current-count)
              (be_scalar.compiler-backend-runtime-abort-site-install!
                (be_state.compiler-backend-global-shared-view ctx)
                (compiler_ir_types.compiler-ir-instr-seq-ref
                  current-instrs
                  current-index))
              unit)
            (compiler-backend-set-shift-count-bound!
              ctx.function-state
              (if (< current-index current-count)
                (be_scalar.compiler-backend-instr-shift-count-bound
                  ctx.function-state
                  (compiler_ir_types.compiler-ir-instr-seq-borrow
                    current-instrs
                    current-index))
                0))
            (match (be_state.compiler-backend-global-shared-view current-mode)
              [(Normal)
                (compiler-backend-emit-instrs-divmod-polish-step
                  (be_state.compiler-backend-global-shared-view ctx)
                  fallthrough
                  (be_state.compiler-backend-global-shared-view current-instrs)
                  current-index
                  out)]
              [(Rax rax-var rax-ty)
                (compiler-backend-emit-instrs-with-rax-step
                  (be_state.compiler-backend-global-shared-view ctx)
                  fallthrough
                  rax-var
                  rax-ty
                  (be_state.compiler-backend-global-shared-view current-instrs)
                  current-index
                  out)]
              [(CallRax rax-var rax-ty)
                (compiler-backend-emit-instrs-with-call-rax-step
                  (be_state.compiler-backend-global-shared-view ctx)
                  fallthrough
                  rax-var
                  rax-ty
                  (be_state.compiler-backend-global-shared-view current-instrs)
                  current-index
                  out)]))]
        (compiler-backend-set-shift-count-bound! ctx.function-state 0)
        (match step-result
          [(Ok asm)
            (if (be_state.compiler-backend-function-state-bool?
              ctx.function-state
              be_state.compiler-backend-function-bool-emit-instrs-continue-pending)
              (begin
                (set!
                  current-mode
                  (be_state.compiler-backend-function-state-next-mode
                    ctx.function-state))
                (set!
                  current-instrs
                  (be_state.compiler-backend-function-state-next-instrs
                    ctx.function-state))
                (set!
                  current-index
                  (be_state.compiler-backend-function-state-i64
                    ctx.function-state
                    be_state.compiler-backend-function-i64-emit-instrs-next-index))
                (set! current-count current-instrs.len)
                unit)
              (begin
                (set! asm-out asm)
                (set! done true)))]
          [(Err message)
            (set! diag-out message)
            (set! ok false)
            (set! done true)])))
    (be_state.compiler-backend-function-state-set-bool!
      ctx.function-state
      be_state.compiler-backend-function-bool-emit-instrs-loop-active
      false)
    (if ok
      (Ok asm-out)
      (Err diag-out))))

(define (compiler-backend-emit-instrs
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (be_state.compiler-backend-function-state-bool?
    ctx.function-state
    be_state.compiler-backend-function-bool-emit-instrs-loop-active)
    (be_state.compiler-backend-emit-instrs-set-continue!
      ctx.function-state
      (Normal)
      instrs
      index)
    (compiler-backend-emit-instrs-loop
      ctx
      fallthrough
      (Normal)
      instrs
      index
      out)))

(define (compiler-backend-emit-instrs-with-call-rax
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (be_state.compiler-backend-function-state-bool?
    ctx.function-state
    be_state.compiler-backend-function-bool-emit-instrs-loop-active)
    (be_state.compiler-backend-emit-instrs-set-continue!
      ctx.function-state
      (CallRax rax-var rax-ty)
      instrs
      index)
    (compiler-backend-emit-instrs-loop
      ctx
      fallthrough
      (CallRax rax-var rax-ty)
      instrs
      index
      out)))

(define (compiler-backend-emit-instrs-with-rax
  [ctx : be_state.CompilerBackendEmissionContext]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (if (be_state.compiler-backend-function-state-bool?
    ctx.function-state
    be_state.compiler-backend-function-bool-emit-instrs-loop-active)
    (be_state.compiler-backend-emit-instrs-set-continue!
      ctx.function-state
      (Rax rax-var rax-ty)
      instrs
      index)
    (compiler-backend-emit-instrs-loop
      ctx
      fallthrough
      (Rax rax-var rax-ty)
      instrs
      index
      out)))

(define (compiler-backend-emit-block
  [type-segment-bases : i64]
  [function : String]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block : compiler_ir_types.CompilerIrBlock]
  [predcount : (& predcount backend_label_i64_map.Map)]
  [fallthrough : be_state.CompilerBackendMaybeLabel]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [ret-ty : compiler_ast_types.AstType]
  [plan : be_state.CompilerBackendRuntimePlan]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [func-diag : compiler_diagnostic.CompilerDiagnostic]
  [use-counts : (__tl_dyn-array i64)]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (match block
    [(Block label instrs)
      (be_state.compiler-backend-function-state-set-i64!
        (be_state.compiler-backend-state-function-state
          program-index.backend-state)
        be_state.compiler-backend-function-i64-current-block-label
        label)
      ;; The block header goes in FIRST because instructions append straight
      ;; into the body buffer. Both injection lookups and the label text are
      ;; pure reads of state frozen before emission (const-hoist-build! runs
      ;; per function, ahead of emit-blocks), so emitting them before the
      ;; body reads the same state.
      ;;
      ;; M-F: loop-hoisted constant loads registered for this block.
      ;; Before-label entries (header-is-entry-block loops) land at prologue
      ;; end, once per call; after-label entries run at a dedicated
      ;; preheader's start, once per loop entry. "" for every other block.
      ;; `compiler-backend-asm-label` is spelled out here so the label's four
      ;; parts land in the body buffer directly instead of through a fresh
      ;; per-block label String.
      (let
        [function-state : be_state.CompilerBackendFunctionState
          (be_state.compiler-backend-state-function-state
            program-index.backend-state)]
        [pre-injection : String
          (be_scalar.compiler-backend-const-hoist-injection-for
            function-state
            label
            true)]
        [post-injection : String
          (be_scalar.compiler-backend-const-hoist-injection-for
            function-state
            label
            false)]
        [ctx : be_state.CompilerBackendEmissionContext
          (be_state.CompilerBackendEmissionContext
            type-segment-bases
            (be_state.compiler-backend-state-emission-target-policy
              program-index.backend-state)
            function
            source-function
            blocks
            label
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            span-index
            func-diag
            use-counts
            program-index.backend-state
            function-state)]
        ;; Cross-edge flags carry: take the compare the layout-previous block's
        ;; tail branch left live, or clear the record. A non-empty const-hoist
        ;; injection is code between that `jcc` and this block's first
        ;; instruction, so it closes the window.
        (compiler-backend-edge-flags-enter-block!
          function-state
          label
          (& instrs)
          predcount
          (or
            (> (string.string-length pre-injection) 0)
            (> (string.string-length post-injection) 0)))
        (be_state.compiler-backend-asm-append out pre-injection)
        (be_state.compiler-backend-asm-append5
          out
          ".L"
          (be_operand.compiler-backend-asm-safe-symbol
            (be_state.compiler-backend-global-shared-view function))
          "_"
          (compiler_ir_types.compiler-ir-label-text label)
          ":\n")
        (be_state.compiler-backend-asm-append out post-injection)
        (compiler-backend-emit-instrs ctx fallthrough instrs 0 out))]))

;; Total IR instruction count over a function's blocks, read from the per-block
;; sequence lengths the emit loop already consults. Used only to size the body
;; buffer.
(define (compiler-backend-blocks-instr-count-seq
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockSeq)]
  [acc : i64]) : i64
  (for [index
    (iterator.range 0 (compiler_ir_types.compiler-ir-block-seq-count blocks))]
    (set!
      acc
      (+
        acc
        (match (compiler_ir_types.compiler-ir-block-seq-borrow blocks index)
          [(Block _ instrs) instrs.len]))))
  acc)

(define (compiler-backend-blocks-instr-count
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(Array seq) (compiler-backend-blocks-instr-count-seq seq 0)]))

(define (compiler-backend-next-block-label-seq
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockSeq)]
  [index : i64]) : be_state.CompilerBackendMaybeLabel
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    (No)
    (match (compiler_ir_types.compiler-ir-block-seq-borrow blocks index)
      [(Block label _) (Some label)])))

(define (compiler-backend-emit-block-seq-into
  [type-segment-bases : i64]
  [function : String]
  [source-function : i64]
  [all-blocks : compiler_ir_types.CompilerIrBlockList]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [ret-ty : compiler_ast_types.AstType]
  [plan : be_state.CompilerBackendRuntimePlan]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [func-diag : compiler_diagnostic.CompilerDiagnostic]
  [use-counts : (__tl_dyn-array i64)]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  ;; Cross-edge flags carry: one predecessor count per block, from the
  ;; peephole's own CFG enumeration (the authoritative successor set), so the
  ;; carry can require the successor's single predecessor without a second
  ;; walk of its own.
  (let
    [predcount : backend_label_i64_map.Map
      (be_peephole.compiler-backend-peephole-predcount-build-seq
        (& blocks)
        0
        (backend_label_i64_map.with-capacity 64))]
    (for [index
      (iterator.range 0 (compiler_ir_types.compiler-ir-block-seq-count blocks))]
      (let
        [block (compiler_ir_types.compiler-ir-block-seq-ref blocks index)]
        [mark : i64 (be_state.compiler-backend-asm-buf-len (& out))]
        ;; Read the count in its own binding: the borrow ends here, before
        ;; `block` moves into the emitter (a loop body's borrow would otherwise
        ;; stay open to the end of the iteration for the published stage0).
        [instr-count : i64
          (match (& block)
            [(Block _ instrs) instrs.len])]
        [dead-total-trap? : bool
          (match (& block)
            [(Block label instrs)
              (be_calls.compiler-backend-dead-total-switch-trap-block?
                (& blocks)
                index
                label
                (& instrs))])]
        [function-state : be_state.CompilerBackendFunctionState
          (be_state.compiler-backend-state-function-state
            program-index.backend-state)]
        (be_state.compiler-backend-function-state-set-emit-instr-post-base!
          function-state
          (+
            (be_state.compiler-backend-function-state-emit-instr-post-base
              function-state)
            instr-count))
        (unless
          dead-total-trap?
          (let
            [_
              (try
                (compiler-backend-emit-block
                  type-segment-bases
                  (be_state.compiler-backend-global-shared-view function)
                  source-function
                  (be_state.compiler-backend-global-shared-view all-blocks)
                  block
                  (& predcount)
                  (compiler-backend-next-block-label-seq blocks (+ index 1))
                  assignments
                  vars
                  types
                  (be_state.compiler-backend-global-shared-view global-types)
                  (be_state.compiler-backend-global-shared-view ret-ty)
                  plan
                  (be_state.compiler-backend-global-shared-view functions)
                  (be_state.compiler-backend-global-shared-view externs)
                  program-index
                  (be_state.compiler-backend-global-shared-view spans)
                  (be_state.compiler-backend-global-shared-view span-index)
                  (be_state.compiler-backend-global-shared-view func-diag)
                  (be_state.compiler-backend-global-shared-view use-counts)
                  out))]
            (be_scalar.compiler-backend-emergency-wrap-appended
              out
              mark
              program-index.backend-state)
            unit)))))
  (Ok ""))

(define (compiler-backend-emit-blocks-into
  [type-segment-bases : i64]
  [function : String]
  [source-function : i64]
  [all-blocks : compiler_ir_types.CompilerIrBlockList]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [ret-ty : compiler_ast_types.AstType]
  [plan : be_state.CompilerBackendRuntimePlan]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [func-diag : compiler_diagnostic.CompilerDiagnostic]
  [use-counts : (__tl_dyn-array i64)]
  [out : (&mut out be_state.CompilerBackendAsmBuf)]) : be_state.ResultCompilerBackend
  (match blocks
    [(Array seq)
      (compiler-backend-emit-block-seq-into
        type-segment-bases
        function
        source-function
        all-blocks
        seq
        assignments
        vars
        types
        global-types
        ret-ty
        plan
        functions
        externs
        program-index
        spans
        span-index
        func-diag
        use-counts
        out)]))

(define (compiler-backend-emit-blocks
  [type-segment-bases : i64]
  [function : String]
  [source-function : i64]
  [all-blocks : compiler_ir_types.CompilerIrBlockList]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [ret-ty : compiler_ast_types.AstType]
  [plan : be_state.CompilerBackendRuntimePlan]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [func-diag : compiler_diagnostic.CompilerDiagnostic]
  [use-counts : (__tl_dyn-array i64)]) : be_state.ResultCompilerBackend
  ;; One body buffer per function: the whole block/instruction spine appends
  ;; into it and this is the single finish boundary, handing the pipeline the
  ;; same body String emit-blocks always returned.
  (let
    ;; Edge lookups build this function's edge index from `all-blocks` on
    ;; first use; start without one.
    [_edge-index-clear : unit
      (be_state.compiler-backend-function-state-set-i64-array!
        (be_state.compiler-backend-state-function-state
          program-index.backend-state)
        be_state.compiler-backend-function-i64-array-edge-index
        (__tl_make-array i64 0))]
    [_avx2-sign-bit-plan : unit
      (be_simd.compiler-backend-avx2-sign-bit-mask-plan!
        (be_state.compiler-backend-state-function-state
          program-index.backend-state)
        vars
        (& all-blocks)
        (& use-counts))]
    ;; The frame-escape answer is per function too; see
    ;; compiler-backend-blocks-expose-frame-at?.
    [_frame-may-escape-clear : unit
      (be_state.compiler-backend-function-state-set-i64!
        (be_state.compiler-backend-state-function-state
          program-index.backend-state)
        be_state.compiler-backend-function-i64-frame-may-escape
        0)]
    [out : be_state.CompilerBackendAsmBuf
      (be_state.compiler-backend-asm-buf-with-capacity
        (+
          be_state.compiler-backend-asm-seq-capacity
          (*
            (compiler-backend-blocks-instr-count
              (be_state.compiler-backend-global-shared-view blocks))
            be_state.compiler-backend-asm-bytes-per-instr)))]
    [_
      (try
        (compiler-backend-emit-blocks-into
          type-segment-bases
          function
          source-function
          all-blocks
          blocks
          assignments
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          span-index
          func-diag
          use-counts
          (&mut out)))]
    (Ok (be_state.compiler-backend-asm-buf-finish (& out)))))

;; Move INCOMING parameters into their local frame slots. Register
;; params come from rdi/rsi/.. (or xmm0..) per the calling convention; params
;; beyond a bank's registers are read back from the caller's stack frame at
;; `compiler-backend-incoming-stack-arg-offset`, indexed by a sequential
;; stack-param counter that mirrors the call site.
(define (compiler-backend-spmd-private-function?
  [backend-state : be_state.CompilerBackendState]
  [name : i64]) : bool
  (or
    (be_scalar.compiler-backend-spmd-varying-return-function?
      backend-state
      name)
    (be_scalar.compiler-backend-spmd-mask-return-function? backend-state name)
    (be_scalar.compiler-backend-spmd-symbol-prefix?
      backend-state
      name
      "__tl_spmd_ret_uniform_")))

(define (compiler-backend-spmd-varying-param? [name : (& name str)]) : bool
  (be_operand.compiler-backend-string-prefix-at?
    name
    "__tl_spmd_varying_arg_"
    0))

(define (compiler-backend-spmd-mask-param? [name : (& name str)]) : bool
  (be_operand.compiler-backend-string-prefix-at? name "__tl_spmd_mask_arg_" 0))

(define (compiler-backend-spmd-active-mask-param? [name : (& name str)]) : bool
  (be_operand.compiler-backend-string-prefix-at? name "__tl_spmd_active_mask" 0))

;; Private AVX-512 helper masks arrive together in %k1-%k6, but the allocator
;; chooses their local homes independently of ABI order.  Keep the complete
;; register permutation as one graph: a sequential prologue can otherwise
;; overwrite an incoming value before its later parameter reads it.
(defenum CompilerBackendSpmdMaskEntryMove
  (SpmdMaskEntryMove i64 i64))

(defstruct CompilerBackendSpmdMaskEntryMoveSeq
  (slots (__tl_dyn-array CompilerBackendSpmdMaskEntryMove))
  (len i64))

(defenum CompilerBackendMaybeSpmdMaskEntryMove
  (NoSpmdMaskEntryMove)
  (SomeSpmdMaskEntryMove CompilerBackendSpmdMaskEntryMove))

(defstruct CompilerBackendSpmdMaskEntryPlan
  (moves CompilerBackendSpmdMaskEntryMoveSeq)
  (destinations (__tl_dyn-array i64))
  (destination-count i64)
  (spill-asm String))

(define (compiler-backend-spmd-mask-entry-move-seq-with-capacity
  [capacity : i64]) : CompilerBackendSpmdMaskEntryMoveSeq
  (CompilerBackendSpmdMaskEntryMoveSeq
    (__tl_make-array CompilerBackendSpmdMaskEntryMove capacity)
    0))

(define (compiler-backend-spmd-mask-entry-move-seq-copy-range!
  [dst : (&mut dst (__tl_dyn-array CompilerBackendSpmdMaskEntryMove))]
  [src : (& src (__tl_dyn-array CompilerBackendSpmdMaskEntryMove))]
  [count : i64]) : unit
  (for [index (iterator.range 0 count)]
    (set! (array-ref dst index) (array-ref src index))))

(define (compiler-backend-spmd-mask-entry-move-seq-push!
  [seq : (&mut seq CompilerBackendSpmdMaskEntryMoveSeq)]
  [move : CompilerBackendSpmdMaskEntryMove]) : unit
  (if (< seq.len (array-length seq.slots))
    unit
    (let
      [bigger : (__tl_dyn-array CompilerBackendSpmdMaskEntryMove)
        (__tl_make-array
          CompilerBackendSpmdMaskEntryMove
          (be_state.compiler-backend-seq-capacity (array-length seq.slots)))]
      (compiler-backend-spmd-mask-entry-move-seq-copy-range!
        (&mut bigger)
        (& seq.slots)
        seq.len)
      (set! seq.slots bigger)))
  (let
    [index : i64 seq.len]
    (set! (array-ref seq.slots index) move)
    (set! seq.len (+ index 1))))

(define (compiler-backend-spmd-mask-entry-error [message : String]) : be_state.ResultCompilerBackend
  (Err (box (compiler_diagnostic.compiler-diagnostic-at-start "" message))))

(define (compiler-backend-spmd-mask-entry-abi-reg? [reg : i64]) : bool
  (and
    (>= reg (compiler_abi.compiler-abi-mask-register-id 1))
    (<= reg (compiler_abi.compiler-abi-mask-register-id 6))))

(define (compiler-backend-spmd-mask-entry-move-duplicate-destination-before?
  [moves : CompilerBackendSpmdMaskEntryMoveSeq]
  [index : i64]
  [destination : i64]) : bool
  (for [cursor (iterator.range 0 index)]
    (match (array-ref moves.slots cursor)
      [(SpmdMaskEntryMove _ earlier)
        (when (= earlier destination) (return true))]))
  false)

(define (compiler-backend-spmd-mask-entry-moves-validate-from
  [moves : CompilerBackendSpmdMaskEntryMoveSeq]) : be_state.ResultCompilerBackend
  (for [index (iterator.range 0 moves.len)]
    (match (array-ref moves.slots index)
      [(SpmdMaskEntryMove source destination)
        (cond
          [(not (compiler-backend-spmd-mask-entry-abi-reg? source))
            (return
              (compiler-backend-spmd-mask-entry-error
                "backend: private AVX-512 SPMD mask entry source is not %k1-%k6"))]
          [(= destination (compiler_abi.compiler-abi-mask-register-id 7))
            (return
              (compiler-backend-spmd-mask-entry-error
                "backend: private AVX-512 SPMD mask allocator assigned reserved %k7 home"))]
          [(not (compiler-backend-spmd-mask-entry-abi-reg? destination))
            (return
              (compiler-backend-spmd-mask-entry-error
                "backend: private AVX-512 SPMD mask entry destination is not %k1-%k6"))]
          [(compiler-backend-spmd-mask-entry-move-duplicate-destination-before?
              (be_state.compiler-backend-global-shared-view moves)
              index
              destination)
            (return
              (compiler-backend-spmd-mask-entry-error
                "backend: duplicate live private AVX-512 SPMD mask entry destination"))]
          [else unit])]))
  (Ok ""))

(define (compiler-backend-spmd-mask-entry-move-parallel-edge
  [move : CompilerBackendSpmdMaskEntryMove]) : pmove.CompilerParallelMoveEdge
  (match move
    [(SpmdMaskEntryMove source destination)
      (let
        [destination-resource : i64
          (be_calls.compiler-backend-parallel-reg-id-resource destination)]
        (ParallelMoveEdge
          destination-resource
          destination-resource
          0
          (be_calls.compiler-backend-parallel-reg-id-resource source)
          0))]))

(define (compiler-backend-spmd-mask-entry-move-parallel-edges
  [moves : CompilerBackendSpmdMaskEntryMoveSeq]) : pmove.CompilerParallelMoveEdgeSeq
  (let
    [edges : pmove.CompilerParallelMoveEdgeSeq
      (pmove.compiler-parallel-move-edge-seq-with-capacity moves.len)]
    (for [index (iterator.range 0 moves.len)]
      (pmove.compiler-parallel-move-edge-push!
        (&mut edges)
        (compiler-backend-spmd-mask-entry-move-parallel-edge
          (array-ref moves.slots index))))
    edges))

(define (compiler-backend-spmd-mask-entry-move-decision
  [moves : CompilerBackendSpmdMaskEntryMoveSeq]) : pmove.CompilerParallelMoveDecision
  (let
    [edges : pmove.CompilerParallelMoveEdgeSeq
      (compiler-backend-spmd-mask-entry-move-parallel-edges moves)]
    (pmove.compiler-parallel-move-decision edges edges)))

(define (compiler-backend-spmd-mask-entry-move-find
  [moves : CompilerBackendSpmdMaskEntryMoveSeq]
  [wanted : i64]) : CompilerBackendMaybeSpmdMaskEntryMove
  (for [index (iterator.range 0 moves.len)]
    (let
      [move : CompilerBackendSpmdMaskEntryMove (array-ref moves.slots index)]
      (match move
        [(SpmdMaskEntryMove _ destination)
          (when
            (=
              (be_calls.compiler-backend-parallel-reg-id-resource destination)
              wanted)
            (return (SomeSpmdMaskEntryMove move)))])))
  NoSpmdMaskEntryMove)

(define (compiler-backend-spmd-mask-entry-move-remove
  [moves : CompilerBackendSpmdMaskEntryMoveSeq]
  [destination : i64]) : CompilerBackendSpmdMaskEntryMoveSeq
  (let
    [out : CompilerBackendSpmdMaskEntryMoveSeq
      (compiler-backend-spmd-mask-entry-move-seq-with-capacity moves.len)]
    [removed : bool false]
    (for [index (iterator.range 0 moves.len)]
      (let
        [move : CompilerBackendSpmdMaskEntryMove (array-ref moves.slots index)]
        (match move
          [(SpmdMaskEntryMove _ next-destination)
            (if (and (not removed) (= next-destination destination))
              (set! removed true)
              (compiler-backend-spmd-mask-entry-move-seq-push! (&mut out) move))])))
    out))

(define (compiler-backend-spmd-mask-entry-move-redirect
  [moves : CompilerBackendSpmdMaskEntryMoveSeq]
  [old-source : i64]
  [new-source : i64]) : CompilerBackendSpmdMaskEntryMoveSeq
  (let
    [out : CompilerBackendSpmdMaskEntryMoveSeq
      (compiler-backend-spmd-mask-entry-move-seq-with-capacity moves.len)]
    (for [index (iterator.range 0 moves.len)]
      (match (array-ref moves.slots index)
        [(SpmdMaskEntryMove source destination)
          (compiler-backend-spmd-mask-entry-move-seq-push!
            (&mut out)
            (SpmdMaskEntryMove
              (if (= source old-source)
                new-source
                source)
              destination))]))
    out))

(define (compiler-backend-emit-spmd-mask-entry-move
  [move : CompilerBackendSpmdMaskEntryMove]) : String
  (match move
    [(SpmdMaskEntryMove source destination)
      (if (= source destination)
        ""
        (str_cat.str-cat
          "    kmovq "
          (compiler_abi.compiler-abi-register-spelling source)
          ", "
          (compiler_abi.compiler-abi-register-spelling destination)
          "\n"))]))

(define (compiler-backend-emit-spmd-mask-entry-moves-unchecked
  [moves : CompilerBackendSpmdMaskEntryMoveSeq]) : be_state.ResultCompilerBackend
  (match (compiler-backend-spmd-mask-entry-move-decision
    (be_state.compiler-backend-global-shared-view moves))
    [(CompilerParallelMoveDone) (Ok "")]
    [(CompilerParallelMoveUnblocked move-id)
      (match (compiler-backend-spmd-mask-entry-move-find
        (be_state.compiler-backend-global-shared-view moves)
        move-id)
        [(SomeSpmdMaskEntryMove move)
          (match move
            [(SpmdMaskEntryMove _ destination)
              (let
                [tail
                  (try
                    (compiler-backend-emit-spmd-mask-entry-moves-unchecked
                      (compiler-backend-spmd-mask-entry-move-remove
                        moves
                        destination)))]
                (Ok
                  (str_cat.str-cat
                    (compiler-backend-emit-spmd-mask-entry-move move)
                    tail)))])]
        [(NoSpmdMaskEntryMove)
          (be_calls.compiler-backend-parallel-move-missing
            "SPMD mask entry"
            move-id)])]
    [(CompilerParallelMoveCycle move-id)
      (match (compiler-backend-spmd-mask-entry-move-find
        (be_state.compiler-backend-global-shared-view moves)
        move-id)
        [(SomeSpmdMaskEntryMove move)
          (match move
            [(SpmdMaskEntryMove source _)
              (let
                [tail
                  (try
                    (compiler-backend-emit-spmd-mask-entry-moves-unchecked
                      (compiler-backend-spmd-mask-entry-move-redirect
                        moves
                        source
                        (compiler_abi.compiler-abi-mask-register-id 7))))]
                (Ok
                  (str_cat.str-cat
                    "    kmovq "
                    (compiler_abi.compiler-abi-register-spelling source)
                    ", %k7\n"
                    tail)))])]
        [(NoSpmdMaskEntryMove)
          (be_calls.compiler-backend-parallel-move-missing
            "SPMD mask entry"
            move-id)])]))

(define (compiler-backend-emit-spmd-mask-entry-moves
  [moves : CompilerBackendSpmdMaskEntryMoveSeq]) : be_state.ResultCompilerBackend
  (let
    [_
      (try
        (compiler-backend-spmd-mask-entry-moves-validate-from
          (be_state.compiler-backend-global-shared-view moves)))]
    (compiler-backend-emit-spmd-mask-entry-moves-unchecked moves)))

(define (compiler-backend-spmd-mask-entry-plan-empty) : CompilerBackendSpmdMaskEntryPlan
  (CompilerBackendSpmdMaskEntryPlan
    (compiler-backend-spmd-mask-entry-move-seq-with-capacity 6)
    (__tl_make-array i64 6)
    0
    ""))

(define (compiler-backend-spmd-mask-entry-plan-has-destination?
  [plan : (&mut plan CompilerBackendSpmdMaskEntryPlan)]
  [destination : i64]) : bool
  (for [index (iterator.range 0 plan.destination-count)]
    (when (= (array-ref plan.destinations index) destination) (return true)))
  false)

(define (compiler-backend-spmd-mask-entry-plan-record-destination!
  [plan : (&mut plan CompilerBackendSpmdMaskEntryPlan)]
  [destination : i64]) : be_state.ResultCompilerBackend
  (cond
    [(compiler-backend-spmd-mask-entry-plan-has-destination? plan destination)
      (compiler-backend-spmd-mask-entry-error
        "backend: duplicate live private AVX-512 SPMD mask entry destination")]
    [(>= plan.destination-count (array-length plan.destinations))
      (compiler-backend-spmd-mask-entry-error
        "backend: private AVX-512 SPMD call supports at most 6 live mask parameters")]
    [else
      (set! (array-ref plan.destinations plan.destination-count) destination)
      (+= plan.destination-count 1)
      (Ok "")]))

(define (compiler-backend-spmd-mask-entry-plan-add-register!
  [plan : (&mut plan CompilerBackendSpmdMaskEntryPlan)]
  [source : i64]
  [destination : i64]) : be_state.ResultCompilerBackend
  (cond
    [(not (compiler-backend-spmd-mask-entry-abi-reg? source))
      (compiler-backend-spmd-mask-entry-error
        "backend: private AVX-512 SPMD mask entry source is not %k1-%k6")]
    [(= destination (compiler_abi.compiler-abi-mask-register-id 7))
      (compiler-backend-spmd-mask-entry-error
        "backend: private AVX-512 SPMD mask allocator assigned reserved %k7 home")]
    [(not (compiler-backend-spmd-mask-entry-abi-reg? destination))
      (compiler-backend-spmd-mask-entry-error
        "backend: private AVX-512 SPMD mask entry destination is not %k1-%k6")]
    [else
      (let
        [_
          (try
            (compiler-backend-spmd-mask-entry-plan-record-destination!
              plan
              (be_calls.compiler-backend-parallel-reg-id-resource destination)))]
        (compiler-backend-spmd-mask-entry-move-seq-push!
          (&mut plan.moves)
          (SpmdMaskEntryMove source destination))
        (Ok ""))]))

(define (compiler-backend-spmd-mask-entry-plan-add-spill!
  [plan : (&mut plan CompilerBackendSpmdMaskEntryPlan)]
  [source : i64]
  [destination-resource : i64]
  [operand : String]) : be_state.ResultCompilerBackend
  (if (not (compiler-backend-spmd-mask-entry-abi-reg? source))
    (compiler-backend-spmd-mask-entry-error
      "backend: private AVX-512 SPMD mask entry source is not %k1-%k6")
    (let
      [_
        (try
          (compiler-backend-spmd-mask-entry-plan-record-destination!
            plan
            destination-resource))]
      ;; KMOVQ supports a direct opmask-to-memory store, so spilling does
      ;; not consume %k7 or mutate any still-live incoming ABI register.
      (set!
        plan.spill-asm
        (str_cat.str-cat
          (string.copy (& plan.spill-asm))
          "    kmovq "
          (compiler_abi.compiler-abi-register-spelling source)
          ", "
          operand
          "\n"))
      (Ok ""))))

(define (compiler-backend-emit-spmd-mask-entry-plan
  [plan : CompilerBackendSpmdMaskEntryPlan]) : be_state.ResultCompilerBackend
  (let
    [register-asm
      (try (compiler-backend-emit-spmd-mask-entry-moves plan.moves))]
    (Ok (str_cat.str-cat plan.spill-asm register-asm))))

(define (compiler-backend-spmd-mask-entry-plan-collect!
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [params : compiler_ir_types.CompilerIrParamSeq]
  [plan : (&mut plan CompilerBackendSpmdMaskEntryPlan)]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [mask-index : i64 0]
    (for [param-index (iterator.range 0 params.len)]
      (match (compiler_ir_types.compiler-ir-param-seq-borrow params param-index)
        [(Param name _ var-id)
          (let
            [active? : bool (compiler-backend-spmd-active-mask-param? name)]
            [mask? : bool (compiler-backend-spmd-mask-param? name)]
            (when
              (and
                (or active? mask?)
                (not
                  (be_calls.compiler-backend-var-never-used?
                    backend-state
                    var-id)))
              (let
                [source : i64
                  (if active?
                    (compiler_abi.compiler-abi-mask-register-id 1)
                    (if (< mask-index 5)
                      (compiler_abi.compiler-abi-mask-register-id
                        (+ mask-index 2))
                      compiler_abi.compiler-reg-id-invalid))]
                (when
                  (= source compiler_abi.compiler-reg-id-invalid)
                  (return
                    (compiler-backend-spmd-mask-entry-error
                      "backend: private AVX-512 SPMD call supports at most 5 varying bool arguments")))
                (match (be_operand.compiler-backend-emit-assignment-lookup
                  backend-state
                  assignments
                  var-id)
                  [(Some location)
                    (match location
                      [(Register home)
                        (let
                          [_
                            (try
                              (compiler-backend-spmd-mask-entry-plan-add-register!
                                plan
                                source
                                home))]
                          unit)]
                      [(Spill offset)
                        (let
                          [_
                            (try
                              (compiler-backend-spmd-mask-entry-plan-add-spill!
                                plan
                                source
                                (be_calls.compiler-backend-parallel-spill-resource
                                  offset)
                                (be_operand.compiler-backend-frame-offset-with-backend-state
                                  backend-state
                                  offset)))]
                          unit)]
                      [_
                        (return
                          (compiler-backend-spmd-mask-entry-error
                            (be_operand.compiler-backend-mask-home-unavailable
                              "private SPMD helper mask parameter")))])]
                  [(No)
                    (let
                      [_
                        (try
                          (compiler-backend-spmd-mask-entry-plan-add-spill!
                            plan
                            source
                            (be_calls.compiler-backend-parallel-spill-resource
                              (- 0 (* 8 (+ var-id 1))))
                            (be_operand.compiler-backend-slot-with-backend-state
                              backend-state
                              var-id)))]
                      unit)])))
            (when mask? (+= mask-index 1)))]))
    (Ok "")))

(define (compiler-backend-emit-spmd-private-special-param
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [name : String]
  [ty : compiler_ast_types.AstType]
  [var-id : i64]
  [vector-index : i64]
  [special-index : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (if (be_calls.compiler-backend-var-never-used? backend-state var-id)
    (Ok "")
    (cond
      [(be_state.compiler-backend-current-mode-avx2?
          (be_state.compiler-backend-state-function-state backend-state))
        (let
          [storage-ty : compiler_ast_types.AstType
            (if (compiler-backend-spmd-varying-param? name)
              ty
              (I8))]
          (match (be_simd.compiler-backend-vector-dst-reg
            assignments
            var-id
            "private AVX2 SPMD helper parameter"
            "ymm"
            "%ymm14"
            backend-state)
            [(Ok home)
              (Ok
                (str_cat.str-cat
                  "    vmovdqu "
                  (string.int->string (* 32 special-index))
                  "(%r10), "
                  home
                  "\n"
                  (be_simd.compiler-backend-vector-store-dst
                    assignments
                    var-id
                    "ymm"
                    storage-ty
                    home
                    backend-state)))]
            [(Err message)
              (Err
                (box
                  (compiler_diagnostic.compiler-diagnostic-at-start "" message)))]))]
      [(be_state.compiler-backend-current-mode-sse2?
          (be_state.compiler-backend-state-function-state backend-state))
        (let
          [storage-ty : compiler_ast_types.AstType
            (if (compiler-backend-spmd-varying-param? name)
              ty
              (I8))]
          (match (be_simd.compiler-backend-vector-dst-reg
            assignments
            var-id
            "private SSE2 SPMD helper parameter"
            "xmm"
            "%xmm0"
            backend-state)
            [(Ok home)
              (Ok
                (str_cat.str-cat
                  "    movdqu "
                  (string.int->string (* 16 special-index))
                  "(%r10), "
                  home
                  "\n"
                  (be_simd.compiler-backend-vector-store-dst
                    assignments
                    var-id
                    "xmm"
                    storage-ty
                    home
                    backend-state)))]
            [(Err message)
              (Err
                (box
                  (compiler_diagnostic.compiler-diagnostic-at-start "" message)))]))]
      [(compiler-backend-spmd-varying-param? name)
        (let
          [incoming : String
            (be_calls.compiler-backend-spmd-private-vector-arg-reg vector-index)]
          (if (= (string.string-length incoming) 0)
            (Err
              (box
                (compiler_diagnostic.compiler-diagnostic-at-start
                  ""
                  "backend: private AVX-512 SPMD call supports at most 8 varying value arguments")))
            (match (be_simd.compiler-backend-vector-dst-reg
              assignments
              var-id
              "private SPMD helper parameter"
              "zmm"
              (string.copy (& incoming))
              backend-state)
              [(Ok home)
                (Ok
                  (str_cat.str-cat
                    (if (string.eq incoming home)
                      ""
                      (str_cat.str-cat
                        "    "
                        (be_operand.compiler-backend-avx512-vector-move ty)
                        " "
                        incoming
                        ", "
                        (string.copy (& home))
                        "\n"))
                    (be_simd.compiler-backend-vector-store-dst
                      assignments
                      var-id
                      "zmm"
                      ty
                      home
                      backend-state)))]
              [(Err message)
                (Err
                  (box
                    (compiler_diagnostic.compiler-diagnostic-at-start
                      ""
                      message)))])))]
      [else
        ;; The opmask prepass owns all active/varying-bool entry moves as one
        ;; parallel graph. Emitting one here would reintroduce source-order
        ;; clobbers.
        (Ok "")])))

(define (compiler-backend-emit-spmd-private-param-spills-from
  [entry : (&mut entry be_state.CompilerBackendAsmBuf)]
  [floats : (&mut floats be_state.CompilerBackendAsmBuf)]
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [params : compiler_ir_types.CompilerIrParamSeq]
  [param-index : i64]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [stack-idx : i64]
  [vector-index : i64]
  [special-index : i64]
  [vars : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (if (>= param-index params.len)
    (Ok "")
    (match (compiler_ir_types.compiler-ir-param-seq-ref params param-index)
      [(Param name ty var-id)
        (let
          [active? : bool (compiler-backend-spmd-active-mask-param? name)]
          [varying? : bool (compiler-backend-spmd-varying-param? name)]
          [mask? : bool (compiler-backend-spmd-mask-param? name)]
          [special? : bool (or active? varying? mask?)]
          [is-float : bool (be_operand.compiler-backend-float-type? ty)]
          [uniform-float? : bool (and is-float (not special?))]
          [on-stack : bool
            (if special?
              false
              (be_scalar.compiler-backend-stack-call-arg-for-banks?
                target
                (Internal)
                is-float
                int-idx
                float-idx
                position))]
          [head
            (try
              (if special?
                (compiler-backend-emit-spmd-private-special-param
                  assignments
                  name
                  ty
                  var-id
                  vector-index
                  special-index
                  backend-state)
                (if on-stack
                  (be_state.ResultCompilerBackend.Ok
                    (let
                      [addr : String
                        (be_operand.compiler-backend-frame-offset-with-backend-state
                          backend-state
                          (be_facts.compiler-backend-incoming-stack-arg-offset
                            target
                            stack-idx))]
                      (cond
                        ;; #9302: a frame-homed uniform float is an entry copy
                        ;; (compiler-backend-param-entry-memory-copy). Here the
                        ;; old pick could land on a varying home this walk had
                        ;; already loaded.
                        [(compiler-backend-param-entry-float-copy?
                          is-float
                          assignments
                          var-id
                          backend-state)
                          (compiler-backend-param-entry-float-copy!
                            entry
                            target
                            assignments
                            var-id
                            addr
                            ty
                            backend-state)
                          ""]
                        [is-float
                          (be_scalar.compiler-backend-emit-load-float-address-to-var
                            assignments
                            var-id
                            addr
                            ty
                            backend-state)]
                        [else
                          (be_scalar.compiler-backend-emit-load-scalar-address-to-var
                            type-segment-bases
                            assignments
                            var-id
                            addr
                            ty
                            (__tl_make-array String 0)
                            0
                            ""
                            backend-state)])))
                  (match (if is-float
                    (be_facts.compiler-backend-target-float-arg-reg-for-banks
                      target
                      (Internal)
                      float-idx
                      position)
                    (be_facts.compiler-backend-target-arg-reg-for-banks
                      target
                      (Internal)
                      int-idx
                      position))
                    [(Ok reg)
                      (be_state.ResultCompilerBackend.Ok
                        (be_operand.compiler-backend-emit-store-typed-var
                          assignments
                          var-id
                          reg
                          ty
                          backend-state))]
                    [(Err message)
                      (be_state.ResultCompilerBackend.Err
                        (box
                          (compiler_diagnostic.compiler-diagnostic-at-start
                            ""
                            message)))]))))]
          [_float : unit
            (when
              uniform-float?
              (be_state.compiler-backend-asm-append floats head))]
          [tail
            (try
              (compiler-backend-emit-spmd-private-param-spills-from
                entry
                floats
                type-segment-bases
                target
                assignments
                params
                (+ param-index 1)
                (if (or special? is-float)
                  int-idx
                  (+ int-idx 1))
                (if (or special? (not is-float))
                  float-idx
                  (+ float-idx 1))
                (if special?
                  position
                  (+ position 1))
                (if on-stack
                  (+ stack-idx 1)
                  stack-idx)
                (if varying?
                  (+ vector-index 1)
                  vector-index)
                (if special?
                  (+ special-index 1)
                  special-index)
                vars
                backend-state))]
          (Ok
            (if uniform-float?
              tail
              (str_cat.str-cat head tail))))])))

(define (compiler-backend-emit-spmd-private-param-spills
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [params : compiler_ir_types.CompilerIrParamSeq]
  [vars : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [mask-plan : CompilerBackendSpmdMaskEntryPlan
      (compiler-backend-spmd-mask-entry-plan-empty)]
    [opmask? : bool
      (not
        (or
          (be_state.compiler-backend-current-mode-avx2?
            (be_state.compiler-backend-state-function-state backend-state))
          (be_state.compiler-backend-current-mode-sse2?
            (be_state.compiler-backend-state-function-state backend-state))))]
    [_
      (try
        (if opmask?
          (compiler-backend-spmd-mask-entry-plan-collect!
            assignments
            (be_state.compiler-backend-global-shared-view params)
            (&mut mask-plan)
            backend-state)
          (be_state.ResultCompilerBackend.Ok "")))]
    [mask-asm
      (try
        (if opmask?
          (compiler-backend-emit-spmd-mask-entry-plan mask-plan)
          (be_state.ResultCompilerBackend.Ok "")))]
    ;; #9302: the walk's entry copies (compiler-backend-param-entry-memory-copy)
    ;; run ahead of the opmask plan and every special-parameter load.
    [entry : be_state.CompilerBackendAsmBuf
      (be_state.compiler-backend-asm-buf-with-capacity 0)]
    ;; #9301: home uniform floats before a varying destination can overwrite an
    ;; unread incoming XMM alias. Uniform homes use the scalar entry constraints;
    ;; their XMM0-XMM15 bank is disjoint from incoming AVX-512 ZMM17-ZMM24.
    ;; AVX2 special inputs stay in the caller's block until their loads run.
    ;; Keep integer-entry scratch scheduling with the special loads.
    [floats : be_state.CompilerBackendAsmBuf
      (be_state.compiler-backend-asm-buf-with-capacity 0)]
    [other-asm
      (try
        (compiler-backend-emit-spmd-private-param-spills-from
          (&mut entry)
          (&mut floats)
          type-segment-bases
          target
          assignments
          params
          0
          0
          0
          0
          0
          0
          0
          vars
          backend-state))]
    (Ok
      (str_cat.str-cat
        (be_state.compiler-backend-asm-buf-finish (& entry))
        mask-asm
        (be_state.compiler-backend-asm-buf-finish (& floats))
        other-asm))))

(define (compiler-backend-emit-private-memory-param-address
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [all-params : compiler_ir_types.CompilerIrParamSeq]
  [var-id : i64]
  [addr : String]
  [backend-state : be_state.CompilerBackendState]) : String
  (let
    [home : String
      (be_scalar.compiler-backend-var-register-home
        backend-state
        assignments
        var-id)]
    (if (string.eq home "")
      (let
        [exclude : (__tl_dyn-array String)
          (be_scalar.compiler-backend-param-register-exclude
            backend-state
            (be_state.compiler-backend-global-shared-view all-params)
            assignments)]
        [exclude-n : i64
          (be_scalar.compiler-backend-param-register-exclude-count
            backend-state
            all-params
            assignments)]
        [scratch : String
          (be_operand.compiler-backend-scavenge-pick-with-mask
            (be_state.compiler-backend-state-function-state backend-state)
            true
            0
            0
            exclude
            exclude-n
            "%r8")]
        (str_cat.str-cat
          "    leaq "
          addr
          ", "
          scratch
          "\n"
          (be_operand.compiler-backend-emit-store-var
            assignments
            var-id
            scratch
            backend-state)))
      (str_cat.str-cat "    leaq " addr ", " home "\n"))))

;; Is this stack-passed parameter an entry copy: a float homed in a frame slot?
(define (compiler-backend-param-entry-float-copy?
  [is-float : bool]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [var-id : i64]
  [backend-state : be_state.CompilerBackendState]) : bool
  (and
    is-float
    (string.eq
      (be_scalar.compiler-backend-var-register-home
        backend-state
        assignments
        var-id)
      "")))

;; Append the entry copy of the float parameter `var-id` from its incoming
;; stack slot `addr` to its frame home.
(define (compiler-backend-param-entry-float-copy!
  [entry : (&mut entry be_state.CompilerBackendAsmBuf)]
  [target : be_state.CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [var-id : i64]
  [addr : (& addr str)]
  [ty : (& compiler_ast_types.AstType)]
  [backend-state : be_state.CompilerBackendState]) : unit
  (let
    [dst : String
      (be_scalar.compiler-backend-float-value-stack-address
        assignments
        (Var var-id)
        backend-state)]
    (unless
      (string.eq dst "")
      (be_state.compiler-backend-asm-append
        entry
        (be_scalar.compiler-backend-param-entry-memory-copy
          target
          addr
          (& dst)
          ty)))))

(define (compiler-backend-direct-stack-param-note-use!
  [offsets : (&mut offsets (__tl_dyn-array i64))]
  [refs : (&mut refs (__tl_dyn-array i64))]
  [var : i64]
  [remaining : i64]) : i64
  (when
    (and
      (>= var 0)
      (< var (array-length offsets))
      (> (array-ref offsets var) 0))
    (let
      [next : i64 (+ (array-ref refs var) 1)]
      (set! (array-ref refs var) next)
      (when (> next 16) (set! (array-ref offsets var) 0) (-= remaining 1))))
  remaining)

(define (compiler-backend-direct-stack-param-count-uses!
  [offsets : (&mut offsets (__tl_dyn-array i64))]
  [refs : (&mut refs (__tl_dyn-array i64))]
  [instr : (& compiler_ir_types.CompilerIrInstr)]
  [remaining : i64]) : i64
  (let
    [ids : (__tl_dyn-array i64) (compiler_liveness.compiler-live-instr-ids)]
    [id-count : i64 (compiler_liveness.compiler-live-instr-use-ids! instr)]
    (if (< id-count 0)
      (let
        [uses : compiler_liveness.CompilerLiveI64Set
          (compiler_liveness.compiler-live-instr-uses instr)]
        [word-count : i64
          (compiler_liveness.compiler-live-set-word-count (& uses))]
        [word-bits : i64 (compiler_liveness.compiler-live-set-word-bits)]
        (for [w (iterator.range 0 word-count)]
          (let
            [bits : i64
              (compiler_liveness.compiler-live-set-word-at-bounded (& uses) w)]
            [base : i64 (* w word-bits)]
            (while (!= bits 0)
              (let
                [bit : i64
                  (compiler_regalloc.compiler-reg-low-bit-index32 bits)]
                (set!
                  remaining
                  (compiler-backend-direct-stack-param-note-use!
                    offsets
                    refs
                    (+ base bit)
                    remaining))
                (when (<= remaining 0) (return 0))
                (set! bits (bit-and bits (- bits 1))))))))
      (for [index (iterator.range 0 id-count)]
        (set!
          remaining
          (compiler-backend-direct-stack-param-note-use!
            offsets
            refs
            (array-ref ids index)
            remaining))
        (when (<= remaining 0) (return 0))))
    remaining))

(define (compiler-backend-direct-stack-param-filter-instr!
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [source-function : i64]
  [program-index : be_state.CompilerBackendProgramIndex]
  [blocks : (& compiler_ir_types.CompilerIrBlockList)]
  [block-label : i64]
  [frame-may-escape-state : (&mut frame-may-escape-state (__tl_dyn-array i64))]
  [instr : (& compiler_ir_types.CompilerIrInstr)]
  [offsets : (&mut offsets (__tl_dyn-array i64))]
  [refs : (&mut refs (__tl_dyn-array i64))]
  [count-hot? : bool]
  [remaining : i64]) : i64
  (match instr
    [(TailCallIndirect _ _ _) (return 0)]
    [(TailCall callee args _)
      (when
        (be_calls.compiler-backend-tail-call-writes-stack-args?
          type-segment-bases
          target
          source-function
          callee
          (compiler_ir_types.compiler-ir-call-args-count (& args))
          program-index)
        (let
          [known : i64 (array-ref frame-may-escape-state 0)]
          [may-escape? : bool
            (if (= known 0)
              (let
                [computed : bool
                  (compiler_ir_types.compiler-ir-blocks-frame-may-escape?
                    blocks)]
                (set!
                  (array-ref frame-may-escape-state 0)
                  (if computed
                    2
                    1))
                computed)
              (= known 2))]
          (unless
            (compiler_ir_types.compiler-ir-blocks-expose-frame-at-given?
              blocks
              may-escape?
              block-label)
            (return 0))))]
    [(AddrOf _ src _)
      (when
        (and
          (>= src 0)
          (< src (array-length offsets))
          (> (array-ref offsets src) 0))
        (set! (array-ref offsets src) 0)
        (-= remaining 1))]
    [_ unit])
  (let
    [dst : i64 (compiler_ir_types.compiler-ir-instr-dst instr)]
    (when
      (and
        (>= dst 0)
        (< dst (array-length offsets))
        (> (array-ref offsets dst) 0))
      (set! (array-ref offsets dst) 0)
      (-= remaining 1)))
  (if (and count-hot? (> remaining 0))
    (compiler-backend-direct-stack-param-count-uses!
      offsets
      refs
      instr
      remaining)
    remaining))

(define (compiler-backend-direct-stack-param-filter-instrs!
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [source-function : i64]
  [program-index : be_state.CompilerBackendProgramIndex]
  [blocks : (& compiler_ir_types.CompilerIrBlockList)]
  [block-label : i64]
  [frame-may-escape-state : (&mut frame-may-escape-state (__tl_dyn-array i64))]
  [instrs : (& compiler_ir_types.CompilerIrInstrSeq)]
  [offsets : (&mut offsets (__tl_dyn-array i64))]
  [refs : (&mut refs (__tl_dyn-array i64))]
  [count-hot? : bool]
  [remaining : i64]) : i64
  (let
    [count : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
    (for [i (iterator.range 0 count)]
      (set!
        remaining
        (compiler-backend-direct-stack-param-filter-instr!
          type-segment-bases
          target
          source-function
          program-index
          blocks
          block-label
          frame-may-escape-state
          (compiler_ir_types.compiler-ir-instr-seq-borrow instrs i)
          offsets
          refs
          count-hot?
          remaining))
      (when (<= remaining 0) (return 0))))
  remaining)

;; Filter candidate direct-home incoming stack parameters against the function
;; body in one pass: any TailCallIndirect or stack-arg-writing direct TailCall
;; disqualifies the whole function (caller incoming stack-arg slots can be
;; overwritten before the tail jump), any AddrOf or instruction/Phi write
;; disqualifies that parameter, and in large frames (`count-hot?`) any
;; candidate with >16 body uses is disqualified so it keeps a disp8 local slot.
(define (compiler-backend-direct-stack-param-filter-blocks!
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [source-function : i64]
  [program-index : be_state.CompilerBackendProgramIndex]
  [blocks : (& compiler_ir_types.CompilerIrBlockList)]
  [offsets : (&mut offsets (__tl_dyn-array i64))]
  [count-hot? : bool]
  [remaining : i64]) : i64
  (let
    [frame-may-escape-state : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [refs : (__tl_dyn-array i64)
      (if count-hot?
        (__tl_make-array i64 (array-length offsets))
        (__tl_make-array i64 0))]
    (match blocks
      [(Array seq)
        (for [b
          (iterator.range 0 (compiler_ir_types.compiler-ir-block-seq-count seq))]
          (match (compiler_ir_types.compiler-ir-block-seq-borrow seq b)
            [(Block block-label instrs)
              (set!
                remaining
                (compiler-backend-direct-stack-param-filter-instrs!
                  type-segment-bases
                  target
                  source-function
                  program-index
                  blocks
                  block-label
                  (&mut frame-may-escape-state)
                  (& instrs)
                  offsets
                  (&mut refs)
                  count-hot?
                  remaining))
              (when (<= remaining 0) (return 0))]))]))
  remaining)

;; Identify incoming 8-byte scalar/f64 stack parameters that can be read
;; directly from their caller-frame stack homes (`16+8*idx` SysV,
;; `48+8*idx` Win64) without a prologue copy or local spill slot.
(define (compiler-backend-direct-stack-param-offsets
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [scalar-registers-enabled : bool]
  [name : i64]
  [params : (& compiler_ir_types.CompilerIrParamSeq)]
  [blocks : (& compiler_ir_types.CompilerIrBlockList)]
  [plan : (& compiler_regalloc.CompilerRegPlan)]
  [fn-group-vars : (& compiler_liveness.CompilerLiveI64Set)]
  [vars : i64]
  [slot-candidate-vars : i64]
  [program-index : be_state.CompilerBackendProgramIndex]) : (__tl_dyn-array i64)
  (let
    [plan-assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-plan-assignments plan)]
    (when
      (or
        (not scalar-registers-enabled)
        (not (be_state.compiler-backend-mode-scalar? mode))
        (compiler_ir_types.compiler-debug-info-enabled?)
        (= params.len 0)
        (<= vars 0)
        (compiler_regalloc.compiler-reg-assignment-table-empty?
          plan-assignments)
        (compiler-backend-spmd-private-function?
          program-index.backend-state
          name)
        (be_operand.compiler-backend-index-c-export? program-index name))
      (return (__tl_make-array i64 0)))
    (let
      [offsets : (__tl_dyn-array i64) (__tl_make-array i64 0)]
      [candidate-count : i64 0]
      [banks : (Array i64 4) (make-array i64 4)]
      (for [param-index (iterator.range 0 params.len)]
        (match (compiler_ir_types.compiler-ir-param-seq-borrow
          params
          param-index)
          [(Param param-name ty var-id)
            (let
              [param-stack-idx : i64
                (be_calls.compiler-backend-abi-bank-step!
                  type-segment-bases
                  target
                  (Internal)
                  program-index
                  (& ty)
                  (&mut banks))]
              (when
                (>= param-stack-idx 0)
                (let
                  [incoming-offset : i64
                    (be_facts.compiler-backend-incoming-stack-arg-offset
                      target
                      param-stack-idx)]
                  [stack-homed? : bool
                    (match (compiler_regalloc.compiler-reg-assignment-table-lookup
                      plan-assignments
                      var-id)
                      [(Some location)
                        (match location
                          [(Spill _) true]
                          [_ false])]
                      [(No) true])]
                  (when
                    (and
                      (> incoming-offset 0)
                      (>= var-id 0)
                      (< var-id vars)
                      (< var-id slot-candidate-vars)
                      stack-homed?
                      (not
                        (compiler_regalloc.compiler-reg-spmd-wide-param?
                          param-name))
                      (not
                        (compiler_liveness.compiler-live-set-contains?
                          fn-group-vars
                          var-id))
                      (=
                        (be_operand.compiler-backend-type-size
                          type-segment-bases
                          (& ty))
                        8))
                    (when
                      (= (array-length offsets) 0)
                      (set! offsets (__tl_make-array i64 vars)))
                    (when
                      (= (array-ref offsets var-id) 0)
                      (set! (array-ref offsets var-id) incoming-offset)
                      (+= candidate-count 1))))))]))
      (if (= candidate-count 0)
        (__tl_make-array i64 0)
        (let
          [remaining : i64
            (compiler-backend-direct-stack-param-filter-blocks!
              type-segment-bases
              target
              name
              program-index
              blocks
              (&mut offsets)
              (> vars 16)
              candidate-count)]
          (if (<= remaining 0)
            (__tl_make-array i64 0)
            offsets))))))

;; Overlay positive caller-frame `(Spill +offset)` homes onto the post-coloring
;; assignment table for eligible direct-home incoming stack parameters.
(define (compiler-backend-overlay-direct-stack-params
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [coloring : (& compiler_regalloc.CompilerRegColoring)]
  [direct-stack-offsets : (& (__tl_dyn-array i64))]) : compiler_regalloc.CompilerRegAssignmentTable
  (let
    [n : i64 (array-length direct-stack-offsets)]
    (if (= n 0)
      assignments
      (match coloring
        [(None) assignments]
        [(Remap remap _)
          (let
            [out : compiler_regalloc.CompilerRegAssignmentTable assignments]
            (for [v (iterator.range 0 n)]
              (let
                [off : i64 (array-ref direct-stack-offsets v)]
                (when
                  (> off 0)
                  (set!
                    out
                    (compiler_regalloc.compiler-reg-assignment-table-insert
                      out
                      (compiler_regalloc.compiler-reg-remap-id (& remap) v)
                      (Spill off))))))
            out)]))))

(define (compiler-backend-emit-param-spills-from
  [entry : (&mut entry be_state.CompilerBackendAsmBuf)]
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [all-params : compiler_ir_types.CompilerIrParamSeq]
  [params : compiler_ir_types.CompilerIrParamSeq]
  [param-index : i64]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [stack-idx : i64]
  [program-index : be_state.CompilerBackendProgramIndex]
  [vars : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (if (>= param-index params.len)
    (Ok "")
    (match (compiler_ir_types.compiler-ir-param-seq-ref params param-index)
      [(Param _ ty var-id)
        (let
          [is-float : bool (be_operand.compiler-backend-float-type? ty)]
          [next-int : i64
            (if is-float
              int-idx
              (+ int-idx 1))]
          [next-float : i64
            (if is-float
              (+ float-idx 1)
              float-idx)]
          [private-memory-size : i64
            (be_facts.compiler-backend-abi-memory-size
              type-segment-bases
              (be_state.compiler-backend-global-shared-view ty))]
          ;; A register-group parameter occupies two eightbytes.
          ;; INTEGER words advance the integer bank; SSE words advance the float
          ;; bank. This mirrors emit-call-args so self-calls agree on register vs
          ;; stack placement for mixed-bank aggregate words.
          (cond
            [(and
                (be_state.compiler-backend-target-sysv-aggregates?
                  target
                  (Internal))
                (> private-memory-size 0))
              (let
                [tail
                  (try
                    (compiler-backend-emit-param-spills-from
                      entry
                      type-segment-bases
                      target
                      assignments
                      (be_state.compiler-backend-global-shared-view all-params)
                      params
                      (+ param-index 1)
                      int-idx
                      float-idx
                      (+ position 1)
                      (+
                        stack-idx
                        (be_calls.compiler-backend-stack-slots-for-size
                          private-memory-size))
                      program-index
                      vars
                      backend-state))]
                (Ok
                  (str_cat.str-cat
                    tail
                    (compiler-backend-emit-private-memory-param-address
                      assignments
                      all-params
                      var-id
                      (be_operand.compiler-backend-frame-offset-with-backend-state
                        backend-state
                        (be_facts.compiler-backend-incoming-stack-arg-offset
                          target
                          stack-idx))
                      backend-state))))]
            [(be_facts.compiler-backend-group-type?
                type-segment-bases
                program-index
                ty)
              (let
                [linux-group-fits : bool
                  (be_calls.compiler-backend-linux-group-register-banks-fit?
                    type-segment-bases
                    target
                    (Internal)
                    program-index
                    (be_state.compiler-backend-global-shared-view ty)
                    int-idx
                    float-idx
                    position)]
                [param-exclude : (__tl_dyn-array String)
                  (be_scalar.compiler-backend-param-register-exclude
                    backend-state
                    (be_state.compiler-backend-global-shared-view all-params)
                    assignments)]
                [param-exclude-n : i64
                  (be_scalar.compiler-backend-param-register-exclude-count
                    backend-state
                    (be_state.compiler-backend-global-shared-view all-params)
                    assignments)]
                [w0-sse : bool
                  (be_facts.compiler-backend-group-word-sse?
                    type-segment-bases
                    program-index
                    ty
                    0)]
                [w0-stack : bool
                  (be_scalar.compiler-backend-stack-call-arg-for-banks?
                    target
                    (Internal)
                    w0-sse
                    int-idx
                    float-idx
                    position)]
                [int1 : i64
                  (if w0-sse
                    int-idx
                    (+ int-idx 1))]
                [float1 : i64
                  (if w0-sse
                    (+ float-idx 1)
                    float-idx)]
                [stack1 : i64
                  (if w0-stack
                    (+ stack-idx 1)
                    stack-idx)]
                [w1-sse : bool
                  (be_facts.compiler-backend-group-word-sse?
                    type-segment-bases
                    program-index
                    ty
                    1)]
                [w1-stack : bool
                  (be_scalar.compiler-backend-stack-call-arg-for-banks?
                    target
                    (Internal)
                    w1-sse
                    int1
                    float1
                    (+ position 1))]
                (if (and
                  (be_state.compiler-backend-target-sysv-aggregates?
                    target
                    (Internal))
                  (not linux-group-fits))
                  (let
                    [head0
                      (try
                        (be_scalar.compiler-backend-emit-group-word-stack-param
                          entry
                          type-segment-bases
                          target
                          assignments
                          var-id
                          0
                          stack-idx
                          vars
                          (be_state.compiler-backend-global-shared-view ty)
                          program-index
                          (be_state.compiler-backend-global-shared-view
                            param-exclude)
                          param-exclude-n
                          backend-state))]
                    [head1
                      (try
                        (be_scalar.compiler-backend-emit-group-word-stack-param
                          entry
                          type-segment-bases
                          target
                          assignments
                          var-id
                          1
                          (+ stack-idx 1)
                          vars
                          (be_state.compiler-backend-global-shared-view ty)
                          program-index
                          param-exclude
                          param-exclude-n
                          backend-state))]
                    [tail
                      (try
                        (compiler-backend-emit-param-spills-from
                          entry
                          type-segment-bases
                          target
                          assignments
                          all-params
                          params
                          (+ param-index 1)
                          int-idx
                          float-idx
                          (+ position 2)
                          (+ stack-idx 2)
                          program-index
                          vars
                          backend-state))]
                    (Ok (str_cat.str-cat tail head0 head1)))
                  (let
                    [head0
                      (try
                        (be_scalar.compiler-backend-emit-group-word-param
                          entry
                          type-segment-bases
                          target
                          assignments
                          var-id
                          0
                          int-idx
                          float-idx
                          position
                          stack-idx
                          vars
                          (be_state.compiler-backend-global-shared-view ty)
                          program-index
                          (be_state.compiler-backend-global-shared-view
                            param-exclude)
                          param-exclude-n
                          backend-state))]
                    [head1
                      (try
                        (be_scalar.compiler-backend-emit-group-word-param
                          entry
                          type-segment-bases
                          target
                          assignments
                          var-id
                          1
                          int1
                          float1
                          (+ position 1)
                          stack1
                          vars
                          (be_state.compiler-backend-global-shared-view ty)
                          program-index
                          param-exclude
                          param-exclude-n
                          backend-state))]
                    [tail
                      (try
                        (compiler-backend-emit-param-spills-from
                          entry
                          type-segment-bases
                          target
                          assignments
                          all-params
                          params
                          (+ param-index 1)
                          (if w1-sse
                            int1
                            (+ int1 1))
                          (if w1-sse
                            (+ float1 1)
                            float1)
                          (+ position 2)
                          (if w1-stack
                            (+ stack1 1)
                            stack1)
                          program-index
                          vars
                          backend-state))]
                    (Ok (str_cat.str-cat head0 head1 tail)))))]
            [else
              (if (be_scalar.compiler-backend-stack-call-arg-for-banks?
                target
                (Internal)
                is-float
                int-idx
                float-idx
                position)
                (let
                  [incoming-offset : i64
                    (be_facts.compiler-backend-incoming-stack-arg-offset
                      target
                      stack-idx)]
                  [direct-home? : bool
                    (match (be_operand.compiler-backend-emit-assignment-lookup
                      backend-state
                      assignments
                      var-id)
                      [(Some location)
                        (match location
                          [(Spill offset) (= offset incoming-offset)]
                          [_ false])]
                      [(No) false])]
                  (if direct-home?
                    (compiler-backend-emit-param-spills-from
                      entry
                      type-segment-bases
                      target
                      assignments
                      all-params
                      params
                      (+ param-index 1)
                      next-int
                      next-float
                      (+ position 1)
                      (+ stack-idx 1)
                      program-index
                      vars
                      backend-state)
                    (let
                      [addr : String
                        (be_operand.compiler-backend-frame-offset-with-backend-state
                          backend-state
                          incoming-offset)]
                      ;; A float with a register home loads straight into it
                      ;; below.
                      [entry-copy? : bool
                        (compiler-backend-param-entry-float-copy?
                          is-float
                          assignments
                          var-id
                          backend-state)]
                      [_entry-copy : unit
                        (when
                          entry-copy?
                          (compiler-backend-param-entry-float-copy!
                            entry
                            target
                            assignments
                            var-id
                            addr
                            ty
                            backend-state))]
                      [tail
                        (try
                          (compiler-backend-emit-param-spills-from
                            entry
                            type-segment-bases
                            target
                            assignments
                            (be_state.compiler-backend-global-shared-view
                              all-params)
                            params
                            (+ param-index 1)
                            next-int
                            next-float
                            (+ position 1)
                            (+ stack-idx 1)
                            program-index
                            vars
                            backend-state))]
                      (Ok
                        (let
                          [exclude-n : i64
                            (be_scalar.compiler-backend-param-register-exclude-count
                              backend-state
                              (be_state.compiler-backend-global-shared-view
                                all-params)
                              assignments)]
                          [exclude : (__tl_dyn-array String)
                            (be_scalar.compiler-backend-param-register-exclude
                              backend-state
                              all-params
                              assignments)]
                          (str_cat.str-cat
                            (cond
                              [entry-copy? ""]
                              [is-float
                                (be_scalar.compiler-backend-emit-load-float-address-to-var
                                  assignments
                                  var-id
                                  addr
                                  ty
                                  backend-state)]
                              [else
                                (be_scalar.compiler-backend-emit-load-scalar-address-to-var
                                  type-segment-bases
                                  assignments
                                  var-id
                                  addr
                                  ty
                                  (be_state.compiler-backend-global-shared-view
                                    exclude)
                                  exclude-n
                                  (be_operand.compiler-backend-scavenge-pick-with-mask
                                    (be_state.compiler-backend-state-function-state
                                      backend-state)
                                    true
                                    0
                                    0
                                    exclude
                                    exclude-n
                                    "%r8")
                                  backend-state)])
                            tail))))))
                (match (if is-float
                  (be_facts.compiler-backend-target-float-arg-reg-for-banks
                    target
                    (Internal)
                    float-idx
                    position)
                  (be_facts.compiler-backend-target-arg-reg-for-banks
                    target
                    (Internal)
                    int-idx
                    position))
                  [(Ok reg)
                    (let
                      [tail
                        (try
                          (compiler-backend-emit-param-spills-from
                            entry
                            type-segment-bases
                            target
                            assignments
                            all-params
                            params
                            (+ param-index 1)
                            next-int
                            next-float
                            (+ position 1)
                            stack-idx
                            program-index
                            vars
                            backend-state))]
                      (Ok
                        (str_cat.str-cat
                          (be_operand.compiler-backend-emit-store-typed-var
                            assignments
                            var-id
                            reg
                            ty
                            backend-state)
                          tail)))]
                  [(Err _)
                    (Err
                      (box
                        (compiler_diagnostic.compiler-diagnostic-at-start
                          ""
                          "backend: too many params")))]))]))])))

(define (compiler-backend-emit-param-spills
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [params : compiler_ir_types.CompilerIrParamSeq]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [stack-idx : i64]
  [program-index : be_state.CompilerBackendProgramIndex]
  [vars : i64]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    ;; The walk's entry copies (compiler-backend-param-entry-memory-copy) run
    ;; ahead of every other parameter copy. Most functions have none, so the
    ;; buffer starts at the minimum size and grows on demand.
    [entry : be_state.CompilerBackendAsmBuf
      (be_state.compiler-backend-asm-buf-with-capacity 0)]
    [copies
      (try
        (compiler-backend-emit-param-spills-from
          (&mut entry)
          type-segment-bases
          target
          assignments
          (be_state.compiler-backend-global-shared-view params)
          params
          0
          int-idx
          float-idx
          position
          stack-idx
          program-index
          vars
          backend-state))]
    (Ok
      (str_cat.str-cat
        (be_state.compiler-backend-asm-buf-finish (& entry))
        copies))))

(define (compiler-backend-emit-windows-main-argv-capture
  [target : be_state.CompilerBackendTarget]
  [name : String]
  [emit-entry : bool]
  [plan : be_state.CompilerBackendRuntimePlan]) : String
  (if (and
    emit-entry
    (be_facts.compiler-backend-target-windows? target)
    (string.eq name "main"))
    (let
      [_ : be_state.CompilerBackendRuntimePlan plan]
      "    movq %rcx, .L_tl_argc(%rip)
    movq %rdx, .L_tl_argv(%rip)
")
    ""))

(define (compiler-backend-emit-linux-crt-main-argv-capture
  [target : be_state.CompilerBackendTarget]
  [name : String]
  [crt-entry : bool]
  [plan : be_state.CompilerBackendRuntimePlan]) : String
  (if (and
    crt-entry
    (be_facts.compiler-backend-target-linux? target)
    (string.eq name "main"))
    (let
      [_ : be_state.CompilerBackendRuntimePlan plan]
      "    movq %rdi, .L_tl_argc(%rip)
    movq %rsi, .L_tl_argv(%rip)
    movq %rdx, .L_tl_envp(%rip)
")
    ""))

(define compiler-backend-scavenge-reg-bit-count : i64
  30)

(define (compiler-backend-scavenge-location-mask
  [location : compiler_regalloc.CompilerRegLocation]) : i64
  (match location
    [(Register reg) (be_operand.compiler-backend-scavenge-reg-id-bit reg)]
    [(RegisterPair a b)
      (bit-or
        (be_operand.compiler-backend-scavenge-reg-id-bit a)
        (be_operand.compiler-backend-scavenge-reg-id-bit b))]
    [_ 0]))

(define (compiler-backend-scavenge-mask-bit-count [mask : i64]) : i64
  (let
    [count : i64 0]
    (for [bit-index (iterator.range 0 compiler-backend-scavenge-reg-bit-count)]
      (let
        [bit : i64 (shl 1 bit-index)]
        (if (not (= (bit-and mask bit) 0))
          (+= count 1)
          unit)))
    count))

;; ---------------------------------------------------------------------------
;; SEGMENT-PRECISE SCAVENGE OCCUPANCY.
;;
;; The occupancy table below answers "which registers carry a live value at
;; instruction i" for every scratch pick the emitter makes. It is built from
;; each var's live SEGMENTS, not from its COARSE HULL [starts[v], ends[v]] --
;; one contiguous range per var, which is all
;; `compiler-reg-interval-index-build` produces.
;;
;; A hull is not liveness. The allocator itself decides interference on the
;; SEGMENTED intervals (compiler-reg-vars-interfere-segmented-index?), so it
;; legitimately homes two values in one register whenever their hulls overlap
;; but their live segments do not. Read back through hulls, that same register
;; then looks occupied across the union of both hulls -- including the hole
;; where neither value is live. In a small function the difference is noise; in
;; a merged/inlined body it is fatal: any register holding one long-hulled value
;; anywhere reads occupied everywhere, so the union the pick queries saturates
;; to "every register busy" and EVERY scratch demand -- including a spilled
;; array base's reload, which needs a register and cannot be a memory operand --
;; falls to the emergency tier, which saves an occupant, reloads, and restores
;; it: four instructions where two would do.
;;
;; Using the segments makes the answer exact rather than merely cheap, and it
;; can only REMOVE bits: a segment set covers a subset of its own hull. Every
;; other guard the pick applies is untouched -- the instruction's operand/def
;; reserved mask, the explicit exclude list, the callee-saved plan-mask rule and
;; the forward staging window all still hold, so a register is handed out only
;; when nothing live occupies it. Vars with no segment row (the synthetic
;; const-hoist pseudo-vars appended past the function's var count) keep the
;; hull, which for a single-range synthetic interval is the same
;; answer.
(define (compiler-backend-scavenge-var-segment-count
  [segments
    : (& segments (__tl_dyn-array compiler_regalloc.CompilerRegIntervalSeq))]
  [var : i64]) : i64
  (if (or (< var 0) (>= var (array-length segments)))
    0
    (compiler_regalloc.compiler-reg-interval-seq-count
      (owned_view.compiler-owned-element-view segments var))))

(define (compiler-backend-scavenge-occupancy-event-capacity
  [starts : (& starts (__tl_dyn-array i64))]
  [ends : (& ends (__tl_dyn-array i64))]
  [present : (& present (__tl_dyn-array i64))]
  [items : (__tl_dyn-array compiler_regalloc.CompilerRegLocation)]
  [segments
    : (& segments (__tl_dyn-array compiler_regalloc.CompilerRegIntervalSeq))]
  [limit : i64]
  [vars : i64]
  [instr-count : i64]) : i64
  (let
    [events : i64 0]
    (for [v (iterator.range 0 vars)]
      (if (and
        (< v limit)
        (not (= (array-ref present v) 0))
        (>= (array-ref starts v) 0)
        (>= (array-ref ends v) 0))
        (let
          [loc-mask : i64
            (compiler-backend-scavenge-location-mask
              (be_state.compiler-backend-global-array-element-shared-view
                items
                v))]
          [start-i : i64 (/ (array-ref starts v) 2)]
          [raw-end-i : i64 (/ (array-ref ends v) 2)]
          [end-i : i64
            (if (>= raw-end-i instr-count)
              (- instr-count 1)
              raw-end-i)]
          [ranges : i64
            (let
              [count : i64
                (compiler-backend-scavenge-var-segment-count segments v)]
              (if (< count 1)
                1
                count))]
          (if (and (not (= loc-mask 0)) (<= start-i end-i))
            ;; One open/close pair per occupied bit per RANGE. A segmented
            ;; var contributes one range per segment; the count is an upper
            ;; bound (an empty or out-of-window segment simply goes unused),
            ;; which is all this sizing pass has to be.
            (+=
              events
              (*
                ranges
                (* 2 (compiler-backend-scavenge-mask-bit-count loc-mask))))
            unit))
        unit))
    (if (< events 1)
      1
      events)))

(define (compiler-backend-scavenge-occupancy-instr-count
  [ends : (& ends (__tl_dyn-array i64))]
  [vars : i64]) : i64
  (let
    [max-end : i64 0]
    (for [v (iterator.range 0 vars)]
      (if (>= (array-ref ends v) 0)
        (let
          [end-i : i64 (/ (array-ref ends v) 2)]
          (if (> end-i max-end)
            (set! max-end end-i)
            unit))
        unit))
    (+ max-end 1)))

(define (compiler-backend-scavenge-occupancy-add-event!
  [heads : (&mut heads (__tl_dyn-array i64))]
  [event-bits : (&mut event-bits (__tl_dyn-array i64))]
  [event-deltas : (&mut event-deltas (__tl_dyn-array i64))]
  [event-next : (&mut event-next (__tl_dyn-array i64))]
  [event : i64]
  [bit-index : i64]
  [delta : i64]
  [used : i64]) : i64
  (if (or
    (< event 0)
    (>= event (array-length heads))
    (>= used (array-length event-bits)))
    used
    (begin
      (set! (array-ref event-bits used) bit-index)
      (set! (array-ref event-deltas used) delta)
      (set! (array-ref event-next used) (array-ref heads event))
      (set! (array-ref heads event) used)
      (+ used 1))))

(define (compiler-backend-scavenge-occupancy-add-mask-events!
  [heads : (&mut heads (__tl_dyn-array i64))]
  [event-bits : (&mut event-bits (__tl_dyn-array i64))]
  [event-deltas : (&mut event-deltas (__tl_dyn-array i64))]
  [event-next : (&mut event-next (__tl_dyn-array i64))]
  [event : i64]
  [mask : i64]
  [delta : i64]
  [used : i64]) : i64
  (let
    [out : i64 used]
    (for [bit-index (iterator.range 0 compiler-backend-scavenge-reg-bit-count)]
      (let
        [bit : i64 (shl 1 bit-index)]
        (if (not (= (bit-and mask bit) 0))
          (set!
            out
            (compiler-backend-scavenge-occupancy-add-event!
              heads
              event-bits
              event-deltas
              event-next
              event
              bit-index
              delta
              out))
          unit)))
    out))

(define (compiler-backend-scavenge-occupancy-add-range!
  [heads : (&mut heads (__tl_dyn-array i64))]
  [event-bits : (&mut event-bits (__tl_dyn-array i64))]
  [event-deltas : (&mut event-deltas (__tl_dyn-array i64))]
  [event-next : (&mut event-next (__tl_dyn-array i64))]
  [start-i : i64]
  [end-i : i64]
  [mask : i64]
  [used : i64]) : i64
  (compiler-backend-scavenge-occupancy-add-mask-events!
    heads
    event-bits
    event-deltas
    event-next
    (+ end-i 1)
    mask
    (- 0 1)
    (compiler-backend-scavenge-occupancy-add-mask-events!
      heads
      event-bits
      event-deltas
      event-next
      start-i
      mask
      1
      used)))

(define (compiler-backend-scavenge-occupancy-mask-at-event
  [heads : (& heads (__tl_dyn-array i64))]
  [event-bits : (& event-bits (__tl_dyn-array i64))]
  [event-deltas : (& event-deltas (__tl_dyn-array i64))]
  [event-next : (& event-next (__tl_dyn-array i64))]
  [active-counts : (&mut active-counts (__tl_dyn-array i64))]
  [event : i64]) : i64
  (let
    [node : i64 (array-ref heads event)]
    [_apply-events : unit
      (while (>= node 0)
        (let
          [bit-index : i64 (array-ref event-bits node)]
          [next : i64
            (+
              (array-ref active-counts bit-index)
              (array-ref event-deltas node))]
          (set! (array-ref active-counts bit-index) next)
          (set! node (array-ref event-next node))))]
    [bit-index : i64 0]
    [mask : i64 0]
    (while (< bit-index compiler-backend-scavenge-reg-bit-count)
      (if (> (array-ref active-counts bit-index) 0)
        (set! mask (bit-or mask (shl 1 bit-index)))
        unit)
      (+= bit-index 1))
    mask))

(define (compiler-backend-scavenge-occupancy-add-var-segments!
  [heads : (&mut heads (__tl_dyn-array i64))]
  [event-bits : (&mut event-bits (__tl_dyn-array i64))]
  [event-deltas : (&mut event-deltas (__tl_dyn-array i64))]
  [event-next : (&mut event-next (__tl_dyn-array i64))]
  [rows : compiler_regalloc.CompilerRegIntervalSeq]
  [count : i64]
  [instr-count : i64]
  [loc-mask : i64]
  [used : i64]) : i64
  (let
    [event-used : i64 used]
    (for [index (iterator.range 0 count)]
      (let
        [row : compiler_regalloc.CompilerRegInterval
          (compiler_regalloc.compiler-reg-interval-seq-ref rows index)]
        [start-i : i64 (/ row.start 2)]
        [raw-end-i : i64 (/ row.end 2)]
        [end-i : i64
          (if (>= raw-end-i instr-count)
            (- instr-count 1)
            raw-end-i)]
        (if (and (>= row.start 0) (>= row.end 0) (<= start-i end-i))
          (set!
            event-used
            (compiler-backend-scavenge-occupancy-add-range!
              heads
              event-bits
              event-deltas
              event-next
              start-i
              end-i
              loc-mask
              event-used))
          unit)))
    event-used))

(define (compiler-backend-scavenge-occupancy-build
  [starts : (& starts (__tl_dyn-array i64))]
  [ends : (& ends (__tl_dyn-array i64))]
  [assignment-index : compiler_regalloc.CompilerRegAssignmentTable]
  [segments : (__tl_dyn-array compiler_regalloc.CompilerRegIntervalSeq)]
  [vars : i64]) : (__tl_dyn-array i64)
  (let
    [instr-count : i64
      (compiler-backend-scavenge-occupancy-instr-count ends vars)]
    [event-count : i64 (+ instr-count 1)]
    [heads : (__tl_dyn-array i64) (__tl_make-array i64 event-count)]
    [present : (__tl_dyn-array i64)
      (compiler_regalloc.compiler-reg-assignment-table-present assignment-index)]
    [items : (__tl_dyn-array compiler_regalloc.CompilerRegLocation)
      (compiler_regalloc.compiler-reg-assignment-table-items assignment-index)]
    [limit : i64 (array-length present)]
    [max-events : i64
      (compiler-backend-scavenge-occupancy-event-capacity
        starts
        ends
        present
        (be_state.compiler-backend-global-shared-view items)
        segments
        limit
        vars
        instr-count)]
    [event-bits : (__tl_dyn-array i64) (__tl_make-array i64 max-events)]
    [event-deltas : (__tl_dyn-array i64) (__tl_make-array i64 max-events)]
    [event-next : (__tl_dyn-array i64) (__tl_make-array i64 max-events)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 instr-count)]
    [active-counts : (__tl_dyn-array i64)
      (__tl_make-array i64 compiler-backend-scavenge-reg-bit-count)]
    [event-used : i64 0]
    (compiler_regalloc.compiler-reg-fill-i64-array (&mut heads) (- 0 1))
    (compiler_regalloc.compiler-reg-fill-i64-array (&mut event-next) (- 0 1))
    (for [v (iterator.range 0 vars)]
      (if (and
        (< v limit)
        (not (= (array-ref present v) 0))
        (>= (array-ref starts v) 0)
        (>= (array-ref ends v) 0))
        (let
          [loc-mask : i64
            (compiler-backend-scavenge-location-mask
              (be_state.compiler-backend-global-array-element-shared-view
                items
                v))]
          [start-i : i64 (/ (array-ref starts v) 2)]
          [raw-end-i : i64 (/ (array-ref ends v) 2)]
          [end-i : i64
            (if (>= raw-end-i instr-count)
              (- instr-count 1)
              raw-end-i)]
          [seg-count : i64
            (compiler-backend-scavenge-var-segment-count segments v)]
          (if (and (not (= loc-mask 0)) (<= start-i end-i))
            (if (< seg-count 1)
              (set!
                event-used
                (compiler-backend-scavenge-occupancy-add-range!
                  (&mut heads)
                  (&mut event-bits)
                  (&mut event-deltas)
                  (&mut event-next)
                  start-i
                  end-i
                  loc-mask
                  event-used))
              (set!
                event-used
                (compiler-backend-scavenge-occupancy-add-var-segments!
                  (&mut heads)
                  (&mut event-bits)
                  (&mut event-deltas)
                  (&mut event-next)
                  (be_state.compiler-backend-global-array-element-shared-view
                    segments
                    v)
                  seg-count
                  instr-count
                  loc-mask
                  event-used)))
            unit))
        unit))
    (for [i (iterator.range 0 instr-count)]
      (set!
        (array-ref out i)
        (compiler-backend-scavenge-occupancy-mask-at-event
          heads
          event-bits
          event-deltas
          event-next
          (&mut active-counts)
          i)))
    out))

(defstruct CompilerBackendScavengeAssignments
  (index compiler_regalloc.CompilerRegAssignmentTable)
  (plan-mask i64))

(define (compiler-backend-scavenge-assignment-mask
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]) : i64
  (let
    [present : (__tl_dyn-array i64)
      (compiler_regalloc.compiler-reg-assignment-table-present assignments)]
    [items : (__tl_dyn-array compiler_regalloc.CompilerRegLocation)
      (compiler_regalloc.compiler-reg-assignment-table-items assignments)]
    [var : i64 0]
    [mask : i64 0]
    (while (< var (array-length present))
      (if (= (array-ref present var) 0)
        unit
        (set!
          mask
          (bit-or
            mask
            (compiler-backend-scavenge-location-mask
              (be_state.compiler-backend-global-array-element-shared-view
                items
                var)))))
      (set! var (+ var 1)))
    mask))

(define (compiler-backend-scavenge-assignments-build
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]) : CompilerBackendScavengeAssignments
  (let
    [view : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignment-table-with-min-capacity
        assignments
        vars)]
    (CompilerBackendScavengeAssignments
      view
      (compiler-backend-scavenge-assignment-mask view))))

(define (compiler-backend-assignments-have-register-home?
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]) : bool
  (let
    [present : (__tl_dyn-array i64)
      (compiler_regalloc.compiler-reg-assignment-table-present assignments)]
    [items : (__tl_dyn-array compiler_regalloc.CompilerRegLocation)
      (compiler_regalloc.compiler-reg-assignment-table-items assignments)]
    [var : i64 0]
    [found : bool false]
    (while (and (< var (array-length present)) (not found))
      (if (= (array-ref present var) 0)
        unit
        (match (owned_view.compiler-owned-element-view items var)
          [(or (Register _) (RegisterPair _ _)) (set! found true)]
          [_ unit]))
      (+= var 1))
    found))

;; Shrink-wrapping is assembled with three textual splices.  A missing needle
;; must fail closed: the caller re-emits the original function with the
;; early-exit rewrite disabled, restoring the ordinary always-framed path.
;; Fail-closed proof that each of the three shrink-wrap text splices had a
;; needle to act on.  Comparing lengths before/after each `string.replace` is
;; a proxy that reports drift whenever the replacement happens to be the same
;; size as the needle.  That is the COMMON case, not a rare one: the planned
;; guard and the incoming guard are
;; byte-identical whenever every operand the guard reads is already pinned to
;; its own ABI register (a first-parameter `test %rdi,%rdi` guard), and they
;; are the same length whenever the two homes merely spell the same width
;; (`%rdi` vs `%r13`).  Both are correct splices -- rendering the prefix from
;; incoming ABI homes is exactly what the replacement is for -- so a length
;; test would refuse the whole shrink-wrap for perfectly admissible functions.
;; Check containment of each needle instead: that is what "the splice had
;; something to replace" actually means, and it is strictly stronger (a
;; same-length substitution of a MISSING needle would pass a length test).
(define (compiler-backend-shrinkwrap-splice-fallback-required?
  [active? : bool]
  [body : (& body str)]
  [planned-guard : (& planned-guard str)]
  [guarded-body : (& guarded-body str)]
  [saving-label-line : String]
  [final-body : (& final-body str)]) : bool
  (and
    active?
    (or
      (not (be_operand.compiler-backend-string-contains? body planned-guard))
      (not
        (be_operand.compiler-backend-string-contains?
          guarded-body
          saving-label-line))
      (not
        (be_operand.compiler-backend-string-contains?
          final-body
          saving-label-line)))))

(define (compiler-backend-set-scavenge-ctx-ready!
  [function-state : be_state.CompilerBackendFunctionState]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [assignment-index : compiler_regalloc.CompilerRegAssignmentTable]
  [plan-mask : i64]
  [occupied-masks : (__tl_dyn-array i64)]
  [vars : i64]) : unit
  (be_state.compiler-backend-function-scratch-set-i64-array!
    function-state
    be_state.compiler-backend-scratch-i64-array-scavenge-starts
    starts)
  (be_state.compiler-backend-function-scratch-set-i64-array!
    function-state
    be_state.compiler-backend-scratch-i64-array-scavenge-ends
    ends)
  (be_state.compiler-backend-function-scratch-set-assignment-index!
    function-state
    assignment-index)
  (be_state.compiler-backend-function-scratch-set-i64!
    function-state
    be_state.compiler-backend-scratch-i64-scavenge-plan-reg-mask
    plan-mask)
  (be_state.compiler-backend-function-scratch-set-i64-array!
    function-state
    be_state.compiler-backend-scratch-i64-array-scavenge-occupied-masks
    occupied-masks)
  (be_state.compiler-backend-function-scratch-set-i64!
    function-state
    be_state.compiler-backend-scratch-i64-scavenge-vars
    vars))

(define (compiler-backend-set-scavenge-ctx-index!
  [function-state : be_state.CompilerBackendFunctionState]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [assignment-index : compiler_regalloc.CompilerRegAssignmentTable]
  [segments : (__tl_dyn-array compiler_regalloc.CompilerRegIntervalSeq)]
  [plan-mask : i64]
  [vars : i64]) : unit
  (let
    [occupied-masks : (__tl_dyn-array i64)
      (compiler-backend-scavenge-occupancy-build
        starts
        ends
        assignment-index
        segments
        vars)]
    (compiler-backend-set-scavenge-ctx-ready!
      function-state
      starts
      ends
      assignment-index
      plan-mask
      occupied-masks
      vars)))

(define (compiler-backend-scavenge-install-ctx-from-intervals!
  [function-state : be_state.CompilerBackendFunctionState]
  [slot-vars : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [intervals : compiler_regalloc.CompilerRegIntervalSeq]
  [segments : (__tl_dyn-array compiler_regalloc.CompilerRegIntervalSeq)]) : unit
  (be_state.compiler-backend-function-state-set-emit-instr-post-base!
    function-state
    0)
  (if (< slot-vars 1)
    (match (compiler-backend-scavenge-assignments-build assignments 0)
      [(CompilerBackendScavengeAssignments assignment-index plan-mask)
        (compiler-backend-set-scavenge-ctx-index!
          function-state
          (__tl_make-array i64 0)
          (__tl_make-array i64 0)
          assignment-index
          segments
          plan-mask
          0)])
    (match (compiler-backend-scavenge-assignments-build assignments slot-vars)
      [(CompilerBackendScavengeAssignments assignment-index plan-mask)
        (let
          [interval-index : compiler_regalloc.CompilerRegIntervalIndex
            (compiler_regalloc.compiler-reg-interval-index-build
              (& intervals)
              slot-vars)]
          [starts : (__tl_dyn-array i64) interval-index.starts]
          [ends : (__tl_dyn-array i64) interval-index.ends]
          (compiler-backend-set-scavenge-ctx-ready!
            function-state
            (be_state.compiler-backend-global-shared-view starts)
            (be_state.compiler-backend-global-shared-view ends)
            assignment-index
            plan-mask
            (compiler-backend-scavenge-occupancy-build
              starts
              ends
              assignment-index
              segments
              slot-vars)
            slot-vars))])))

;; A candidate is usable as scratch iff: free at `point`, not excluded, and
;; (caller-saved OR already saved by the prologue).
;;
;; The third clause is essential for soundness. A callee-saved register belongs
;; to the CALLER and must be preserved across this function. The prologue/epilogue
;; only save+restore the callee registers the ALLOCATOR PLAN homes a value in
;; (`plan-uses-reg?`), and that set is fixed BEFORE body emission. If the scavenger
;; were allowed to hand out a callee register the plan does NOT save, the function
;; would clobber the caller's value with no save/restore -- and dynamically adding
;; it to the save set is itself unsound, because the prologue SAVE is emitted
;; post-body (final set) while every RESTORE (each return, each tail call) is
;; emitted inline DURING the body and sees only the set as it stood at that point,
;; so an early return restores a partial set and corrupts the caller. Restricting
;; callee picks to plan-saved registers keeps the save/restore set a pure function
;; of the plan (stable, order-independent) and still gives the scavenger every
;; callee register the allocator already pays to preserve, used as scratch only
;; where the freeness query certifies no live value occupies it.
;; R4-B: FRESH-REGISTER DEF STAGING -- which instructions may take the narrow
;; last-resort staging window.
;;
;; compiler-backend-scavenge-reg queries a staging register's freeness across
;; `point + staging-window` (16 = 8 instructions) rather than at the emit point,
;; because a FUSED destructure emits its field loads in offset order while the
;; lowering numbers their def points in the REVERSE order: a register-homed
;; sibling is written into its home BEFORE a spilled sibling's staging load yet
;; carries a HIGHER interval point, so only a forward window keeps it occupied.
;; That reordering is a property of the load-fusion families and of nothing else.
;;
;; The window is therefore right for loads and far too wide for a plain scalar
;; computation, whose staging register is dead at the end of the single emitted
;; step: a register that merely becomes live four instructions later is refused,
;; and when every candidate is refused the site falls to the EMERGENCY tier,
;; which borrows an occupied register and wraps the step in a save/restore pair
;; (2.6, 2.7a). This predicate marks the instructions whose emission reorders
;; nothing, so their staging pick may retry against the narrow [point, point+2]
;; window before paying for that wrap.
;;
;; Admitted: the scalar compute family whose lowering is `stage operands ->
;; apply -> write destination` in one step (BinOp/UnOp/Cast/Bitcast/Select) and
;; the plain register-to-register/immediate Mov. Refused: every load, gep,
;; store, call, copy and vector form -- the whole set the fusion clusters draw
;; from -- so the reorder hazard can never reach the narrow tier.
(define (compiler-backend-instr-staging-narrow-ok?
  [instr : (& instr compiler_ir_types.CompilerIrInstr)]) : bool
  (match instr
    [(or (BinOp _ _ _ _ _) (UnOp _ _ _ _) (Cast _ _ _ _) (Bitcast _ _ _ _)
         (Select _) (Mov _ _ _))
      true]
    [_ false]))

(define (compiler-backend-var-reserved-home-bit
  [assignment-index : compiler_regalloc.CompilerRegAssignmentTable]
  [var : i64]) : i64
  (if (< var 0)
    0
    (be_operand.compiler-backend-scavenge-reg-id-bit
      (compiler_regalloc.compiler-reg-assignment-table-primary-register-home
        assignment-index
        var))))

;; Sound-scavenger reserved mask (LLVM RegScavenger model): the pooled-register
;; homes of the CURRENT instruction's operand (use) + result (def) vars. The
;; scavenge must NEVER return one of these as scratch -- it would clobber an
;; operand the instruction reads, or the result it writes (the dst reads "free"
;; at the scavenge point but must still be reserved). Set once per instruction
;; at the emission dispatcher; consulted in candidate-ok? AND the emergency tier.
;; The same per-instruction visit records R4-B's narrow-staging admission
;; (compiler-backend-instr-staging-narrow-ok?), which the staging pick reads.
;; Fold instruction uses/def straight into their assigned register-home bits
;; rather than building generic liveness bitsets per emitted instruction only
;; to scan them into this small mask. The dense assignment index is already
;; installed for the function before emission, so operand visits are
;; constant-time lookups.
(define (compiler-backend-instr-reserved-home-mask
  [function-state : be_state.CompilerBackendFunctionState]
  [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (be_state.compiler-backend-function-scratch-set-bool!
    function-state
    be_state.compiler-backend-scratch-bool-instr-staging-narrow-ok
    (compiler-backend-instr-staging-narrow-ok? instr))
  (let
    [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
      (be_state.compiler-backend-function-scratch-assignment-index
        function-state)]
    [dst-bit : i64
      (compiler-backend-var-reserved-home-bit
        assignment-index
        (compiler_ir_types.compiler-ir-instr-dst (& instr)))]
    [short : compiler_ir_types.CompilerIrShortVarUses
      (compiler-backend-instr-short-uses (& instr))]
    (if short.fits?
      (bit-or
        dst-bit
        (bit-or
          (compiler-backend-var-reserved-home-bit assignment-index short.first)
          (compiler-backend-var-reserved-home-bit assignment-index short.second)))
      (unsafe
        (let
          [scratch : (MutPtr compiler_ir_types.CompilerIrIdList)
            (be_state.compiler-backend-function-use-ids function-state)]
          [ids : compiler_ir_types.CompilerIrIdList (ptr-read scratch)]
          [mask : i64 dst-bit]
          (set! ids.len 0)
          (compiler_ir_types.compiler-ir-instr-use-var-ids-into!
            (& instr)
            (&mut ids))
          (for [id (& ids)]
            (set!
              mask
              (bit-or
                mask
                (compiler-backend-var-reserved-home-bit
                  assignment-index
                  (deref id)))))
          (ptr-write! scratch ids)
          mask)))))

(define (compiler-backend-current-instr-reserved-mask
  [function-state : be_state.CompilerBackendFunctionState]) : i64
  (be_state.compiler-backend-function-scratch-i64
    function-state
    be_state.compiler-backend-scratch-i64-current-instr-reserved-mask))

(define (compiler-backend-set-current-instr-reserved-mask!
  [function-state : be_state.CompilerBackendFunctionState]
  [mask : i64]) : unit
  (be_state.compiler-backend-function-scratch-set-i64!
    function-state
    be_state.compiler-backend-scratch-i64-current-instr-reserved-mask
    mask))

;; Fill `regs` with the plan-saved CSR names (slot-idx order); returns the
;; count. The set is a pure function of the allocator plan (the scavenger only
;; hands out plan-saved callee regs; emergency picks are wrapped locally), so
;; it is fixed before body emission and matches every inline restore site.
(define (compiler-backend-fill-push-csr-regs!
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [regs : (&mut regs (__tl_dyn-array String))]
  [backend-state : be_state.CompilerBackendState]) : i64
  (let
    [count : i64 0]
    (for [idx (iterator.range 0 (array-length regs))]
      (let
        [reg-id : i64
          (be_operand.compiler-backend-callee-save-order-reg-id idx)]
        (if (and
          (not (= reg-id compiler_abi.compiler-reg-id-invalid))
          (be_operand.compiler-backend-callee-needs-save?
            backend-state
            assignments
            reg-id))
          (begin
            (set!
              (array-ref regs idx)
              (compiler_abi.compiler-abi-register-spelling reg-id))
            (+= count 1))
          (set! (array-ref regs idx) ""))))
    count))

(define (compiler-backend-csr-push-reg-count
  [push-regs : (__tl_dyn-array String)]) : i64
  (let
    [count : i64 0]
    (for [idx (iterator.range 0 (array-length push-regs))]
      (if (string.eq (array-ref push-regs idx) "")
        unit
        (+= count 1)))
    count))

;; The same census restricted to calls that RETURN here: a function whose only
;; call-shaped instructions are tail transfers needs no slot region for them.
;; The tail target inherits our caller's %rsp (the epilogue restores it before
;; the `jmp`), and whatever stack argument space the tail call itself wants is
;; sized separately by compiler-backend-outgoing-frame-space.
(define (compiler-backend-blocks-have-returning-call?
  [blocks : (& blocks (Slice compiler_ir_types.CompilerIrBlock))]) : bool
  (match blocks
    [(slice) false]
    [(slice block & rest)
      (match block
        [(Block _ instrs)
          (if (compiler_regalloc.compiler-reg-seq-has-returning-call-or-syscall?
            (& instrs))
            true
            (compiler-backend-blocks-have-returning-call? rest))])]))

(define compiler-backend-sweep-capacity : i64
  131072)

(define (compiler-backend-sweep-line-flag? [flags : i64] [flag : i64]) : bool
  (not (= (bit-and flags flag) 0)))

;; Initial capacity of the address-extent tables. They are allocated on the
;; first recorded frame address, not with the per-function table, so a program
;; that never takes a frame address pays nothing for them.
(define compiler-backend-sweep-addr-initial-capacity : i64
  16)

(define (compiler-backend-sweep-addr-ensure!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]) : unit
  (let
    [data : (MutPtr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-ptr stream)]
    (unsafe
      (if (> (array-length (deref data).sweep-addr-rbp) 0)
        unit
        (let
          [owner : arena.Arena
            (compiler-backend-sweep-addr-arena-ensure! backend-state stream)]
          [frames : i64 (array-length (deref data).sweep-sym-off)]
          [frame-cap : i64
            (if (> frames 0)
              frames
              be_peephole.compiler-backend-sweep-initial-capacity)]
          (in-arena
            owner
            (let
              [cap : i64 compiler-backend-sweep-addr-initial-capacity]
              (set! (deref data).sweep-addr-rbp (__tl_make-array i64 cap))
              (set! (deref data).sweep-addr-ext (__tl_make-array i64 cap))
              (set!
                (deref data).sweep-addr-start-arr
                (__tl_make-array i64 frame-cap))
              (set!
                (deref data).sweep-addr-len-arr
                (__tl_make-array i64 frame-cap)))))))))

(define (compiler-backend-sweep-table-grow!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]) : bool
  (let
    [data : be_state.CompilerBackendStreamStateData
      (be_state.compiler-backend-stream-state-data stream)]
    [old-cap : i64 (array-length data.sweep-sym-off)]
    [new-cap : i64
      (if (> (* old-cap 4) compiler-backend-sweep-capacity)
        compiler-backend-sweep-capacity
        (* old-cap 4))]
    (if (<= new-cap old-cap)
      false
      (let
        [owner : arena.Arena
          (be_state.compiler-backend-state-lazy-table-arena-ensure!
            backend-state)]
        (in-arena
          owner
          (let
            [sym-off : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
            [sym-len : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
            [lo-arr : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
            [hi-arr : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
            [disp-arr : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
            [win64-arr : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
            [em-lo-arr : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
            [em-hi-arr : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
            (for [i (iterator.range 0 data.sweep-count)]
              (set! (array-ref sym-off i) (array-ref data.sweep-sym-off i))
              (set! (array-ref sym-len i) (array-ref data.sweep-sym-len i))
              (set! (array-ref lo-arr i) (array-ref data.sweep-lo-arr i))
              (set! (array-ref hi-arr i) (array-ref data.sweep-hi-arr i))
              (set! (array-ref disp-arr i) (array-ref data.sweep-disp-arr i))
              (set! (array-ref win64-arr i) (array-ref data.sweep-win64-arr i))
              (set! (array-ref em-lo-arr i) (array-ref data.sweep-em-lo-arr i))
              (set! (array-ref em-hi-arr i) (array-ref data.sweep-em-hi-arr i)))
            (set! data.sweep-sym-off sym-off)
            (set! data.sweep-sym-len sym-len)
            (set! data.sweep-lo-arr lo-arr)
            (set! data.sweep-hi-arr hi-arr)
            (set! data.sweep-disp-arr disp-arr)
            (set! data.sweep-win64-arr win64-arr)
            (set! data.sweep-em-lo-arr em-lo-arr)
            (set! data.sweep-em-hi-arr em-hi-arr)
            (if (> (array-length data.sweep-addr-rbp) 0)
              (in-arena
                (compiler-backend-sweep-addr-arena-ensure! backend-state stream)
                (let
                  [addr-cap : i64
                    (if (< (array-length data.sweep-addr-rbp) new-cap)
                      new-cap
                      (array-length data.sweep-addr-rbp))]
                  [addr-rbp : (__tl_dyn-array i64)
                    (__tl_make-array i64 addr-cap)]
                  [addr-ext : (__tl_dyn-array i64)
                    (__tl_make-array i64 addr-cap)]
                  [addr-start : (__tl_dyn-array i64)
                    (__tl_make-array i64 addr-cap)]
                  [addr-len : (__tl_dyn-array i64)
                    (__tl_make-array i64 addr-cap)]
                  (for [i (iterator.range 0 data.sweep-addr-count)]
                    (set!
                      (array-ref addr-rbp i)
                      (array-ref data.sweep-addr-rbp i))
                    (set!
                      (array-ref addr-ext i)
                      (array-ref data.sweep-addr-ext i)))
                  (for [i (iterator.range 0 data.sweep-count)]
                    (set!
                      (array-ref addr-start i)
                      (array-ref data.sweep-addr-start-arr i))
                    (set!
                      (array-ref addr-len i)
                      (array-ref data.sweep-addr-len-arr i)))
                  (set! data.sweep-addr-rbp addr-rbp)
                  (set! data.sweep-addr-ext addr-ext)
                  (set! data.sweep-addr-start-arr addr-start)
                  (set! data.sweep-addr-len-arr addr-len)
                  unit))
              unit)
            (be_state.compiler-backend-stream-state-data-set! stream data)
            true))))))

(define (compiler-backend-sweep-reset!
  [_backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]) : unit
  (let
    [data : (MutPtr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-ptr stream)]
    (begin
      (unsafe
        (set! (deref data).sweep-count 0)
        (set! (deref data).sweep-sym-bytes-count 0)
        (set! (deref data).sweep-addr-count 0)
        (set! (deref data).sweep-addr-flushed 0)
        ;; Reclaim the address-extent tables and the poison bitmap with the
        ;; program's emission, then drop every handle into them so no later
        ;; read can touch the rewound pages.
        (if (> (deref data).sweep-addr-arena 0)
          (let
            [home : arena.Arena (arena.current)]
            [owner : arena.Arena
              (unsafe
                (arena.Arena (deref data).sweep-addr-arena))]
            (unsafe
              (arena.set! owner)
              (arena.rewind (arena.ArenaMark (deref data).sweep-addr-mark))
              (arena.set! home)))
          unit)
        (set! (deref data).sweep-addr-rbp (deref data).sweep-scratch-empty)
        (set! (deref data).sweep-addr-ext (deref data).sweep-scratch-empty)
        (set!
          (deref data).sweep-addr-start-arr
          (deref data).sweep-scratch-empty)
        (set! (deref data).sweep-addr-len-arr (deref data).sweep-scratch-empty)
        (set! (deref data).sweep-poison-bits (deref data).sweep-scratch-empty))
      (cfg
        test
        (profile_state.compiler-profile-metrics-reset-range!
          (be_state.compiler-backend-state-metrics _backend-state)
          be_state.compiler-backend-sweep-swept-stores-metric
          be_state.compiler-backend-census-metric-end)
        unit))))

;; Grow the address-extent table on demand. Records arrive per AddrOf, not per
;; function, so a single large function can outgrow the per-function table.
(define (compiler-backend-sweep-addr-grow!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]) : bool
  (let
    [data : be_state.CompilerBackendStreamStateData
      (be_state.compiler-backend-stream-state-data stream)]
    [old-cap : i64 (array-length data.sweep-addr-rbp)]
    [new-cap : i64
      (if (> (* old-cap 2) compiler-backend-sweep-capacity)
        compiler-backend-sweep-capacity
        (* old-cap 2))]
    (if (<= new-cap old-cap)
      false
      (let
        [owner : arena.Arena
          (compiler-backend-sweep-addr-arena-ensure! backend-state stream)]
        (in-arena
          owner
          (let
            [rbp : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
            [ext : (__tl_dyn-array i64) (__tl_make-array i64 new-cap)]
            (for [i (iterator.range 0 data.sweep-addr-count)]
              (set! (array-ref rbp i) (array-ref data.sweep-addr-rbp i))
              (set! (array-ref ext i) (array-ref data.sweep-addr-ext i)))
            (set! data.sweep-addr-rbp rbp)
            (set! data.sweep-addr-ext ext)
            (be_state.compiler-backend-stream-state-data-set! stream data)
            true))))))

;; Record one emitted frame-address object: its rbp-relative slot offset and
;; its extent in bytes. The sweep resolves a `leaq L(%rsp)` to the recorded
;; objects whose spans contain L and poisons exactly those spans; a leaq with
;; no recorded span at its offset keeps the old poison-everything watermark.
;; A record that cannot be stored is NOT soundness-neutral: two coloured
;; storage ranges can share a base slot, so a surviving narrower record would
;; win over the fallback for the wider object's leaq. The overflow flag
;; therefore invalidates this function's whole extent slice at commit, which
;; makes every leaq in it take the watermark fallback.
(define (compiler-backend-sweep-addr-record!
  [backend-state : be_state.CompilerBackendState]
  [rbp-offset : i64]
  [extent : i64]) : unit
  (let
    [stream : be_state.CompilerBackendStreamState
      (be_state.compiler-backend-state-stream-state backend-state)]
    [_storage : unit
      (be_peephole.compiler-backend-sweep-storage-ensure! backend-state stream)]
    [_addr : unit (compiler-backend-sweep-addr-ensure! backend-state stream)]
    [data : (MutPtr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-ptr stream)]
    (unsafe
      (when
        (>=
          (deref data).sweep-addr-count
          (array-length (deref data).sweep-addr-rbp))
        (unless
          (compiler-backend-sweep-addr-grow! backend-state stream)
          (set! (deref data).sweep-addr-overflow true))))
    (unsafe
      (let
        [count : i64 (deref data).sweep-addr-count]
        (if (< count (array-length (deref data).sweep-addr-rbp))
          (begin
            (set! (array-ref (deref data).sweep-addr-rbp count) rbp-offset)
            (set! (array-ref (deref data).sweep-addr-ext count) extent)
            (set! (deref data).sweep-addr-count (+ count 1)))
          unit)))))

;; Record one FPO-audited function's sweep metadata. A full table silently
;; drops the entry (the function is simply not swept -- sound).
(define (compiler-backend-sweep-record!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]
  [symbol : String]
  [lo : i64]
  [hi : i64]
  [disp : i64]
  [em-lo : i64]
  [em-hi : i64]
  [win64 : bool]) : unit
  (let
    [_storage : unit
      (be_peephole.compiler-backend-sweep-storage-ensure! backend-state stream)]
    [data : (Ptr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-view stream)]
    [len : i64 (string.string-length symbol)]
    [sdata : (Ptr u8)
      (unsafe
        (string-data symbol))]
    [start : i64
      (unsafe
        (deref data).sweep-sym-bytes-count)]
    [table-ok : bool
      (or
        (<
          (unsafe
            (deref data).sweep-count)
          (array-length
            (unsafe
              (deref data).sweep-sym-off)))
        (compiler-backend-sweep-table-grow! backend-state stream))]
    [bytes-ok : bool
      (or
        (<=
          (+ start len)
          (array-length
            (unsafe
              (deref data).sweep-sym-bytes)))
        (be_peephole.compiler-backend-sweep-bytes-grow!
          backend-state
          stream
          (+ start len)))]
    (if (or (not table-ok) (not bytes-ok))
      (begin
        (cfg
          test
          (be_state.compiler-backend-metric-add!
            backend-state
            be_state.compiler-backend-sweep-dropped-funcs-metric
            1)
          unit)
        (if (not table-ok)
          (cfg
            test
            (be_state.compiler-backend-metric-add!
              backend-state
              be_state.compiler-backend-sweep-dropped-table-cap-metric
              1)
            unit)
          unit)
        (if (not bytes-ok)
          (cfg
            test
            (be_state.compiler-backend-metric-add!
              backend-state
              be_state.compiler-backend-sweep-dropped-bytes-cap-metric
              1)
            unit)
          unit))
      (unsafe
        (let
          [current : (MutPtr be_state.CompilerBackendStreamStateData)
            (be_state.compiler-backend-stream-state-ptr stream)]
          [idx : i64 (deref current).sweep-count]
          (for [j (iterator.range 0 len)]
            (set!
              (array-ref (deref current).sweep-sym-bytes (+ start j))
              (cast (be_state.compiler-backend-peephole-byte-at sdata j) : u8)))
          (set! (array-ref (deref current).sweep-sym-off idx) start)
          (set! (array-ref (deref current).sweep-sym-len idx) len)
          (set! (array-ref (deref current).sweep-lo-arr idx) lo)
          (set! (array-ref (deref current).sweep-hi-arr idx) hi)
          (set! (array-ref (deref current).sweep-disp-arr idx) disp)
          (set!
            (array-ref (deref current).sweep-win64-arr idx)
            (if win64
              1
              0))
          (set! (array-ref (deref current).sweep-em-lo-arr idx) em-lo)
          (set! (array-ref (deref current).sweep-em-hi-arr idx) em-hi)
          (if (> (array-length (deref current).sweep-addr-start-arr) 0)
            (begin
              (set!
                (array-ref (deref current).sweep-addr-start-arr idx)
                (deref current).sweep-addr-flushed)
              (set!
                (array-ref (deref current).sweep-addr-len-arr idx)
                (if (deref current).sweep-addr-overflow
                  0
                  (-
                    (deref current).sweep-addr-count
                    (deref current).sweep-addr-flushed))))
            unit)
          (set!
            (deref current).sweep-addr-flushed
            (deref current).sweep-addr-count)
          (set! (deref current).sweep-addr-overflow false)
          (set! (deref current).sweep-sym-bytes-count (+ start len))
          (set! (deref current).sweep-count (+ idx 1)))))))

;; A squeezed rebase keeps every frame object below the callee-save band at
;; its original %rsp offset while the var region moves down by `squeeze`
;; bytes. The sweep spells an object's span from the var-region bias, so lift
;; this function's recorded objects below `band-lo` by the same amount.
(define (compiler-backend-sweep-addr-lift!
  [stream : be_state.CompilerBackendStreamState]
  [band-lo : i64]
  [squeeze : i64]) : unit
  (when
    (> squeeze 0)
    (unsafe
      (let
        [data : (MutPtr be_state.CompilerBackendStreamStateData)
          (be_state.compiler-backend-stream-state-ptr stream)]
        (for [i
          (iterator.range
            (deref data).sweep-addr-flushed
            (deref data).sweep-addr-count)]
          (let
            [rbp : i64 (array-ref (deref data).sweep-addr-rbp i)]
            (when
              (< rbp band-lo)
              (set! (array-ref (deref data).sweep-addr-rbp i) (+ rbp squeeze)))))))))

;; Compute [lo, hi] (the VAR-REGION slot-start span in canonical delta-0
;; rsp-relative bytes) and disp (total prologue rsp displacement) for one
;; FPO-audited function, then record it. Mirrors the rebase pass's biases:
;;   push mode (push-count > 0): bias_neg = sub-s, disp = 8n + sub-s
;;   plain FPO (push-count = 0):  bias_neg = frame, disp = frame + 8
;; lo = bias_neg - 8*slot-vars (deepest var slot), hi = bias_neg - 8 (var 0).
;; Every protected slot class sits at canonical < lo (CSR/group-word1/
;; emergency/outgoing) or > hi (positive incoming/tail stack args).
(define (compiler-backend-sweep-record-fpo!
  [stream : be_state.CompilerBackendStreamState]
  [symbol : String]
  [frame : i64]
  [push-count : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]
  [backend-state : be_state.CompilerBackendState]) : unit
  (let
    [sub-s : i64
      (be_operand.compiler-backend-rsp-rebase-push-sub
        backend-state
        frame
        push-count)]
    [bias-neg : i64
      (be_peephole.compiler-backend-frame-bias-neg
        backend-state
        true
        frame
        push-count)]
    ;; `sub-s` is the adjustment the prologue really emitted in both modes (0
    ;; for a bare frame, for a dropped alignment pad, and for a red-zone frame),
    ;; so the sweep's entry delta tracks the text rather than assuming the pad is
    ;; always there.
    [disp : i64 (+ (* push-count 8) sub-s)]
    ;; Emergency scavenge slots live at rbp offset em-slot-offset - 64*i for
    ;; i in [0, em-used-count); canonical = bias_neg + (negative rbp offset).
    ;; They are read only by their own restores (visible in the text), EXCEPT
    ;; when the function has outgoing stack-arg space: arg slots share the
    ;; frame bottom and are read by callees, so the window stays empty then.
    [em-hi : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (+
          (+ bias-neg em-slot-offset)
          (- (be_scalar.compiler-backend-emergency-slot-size) 8))
        0)]
    [em-lo : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (-
          (+ bias-neg em-slot-offset)
          (*
            (be_scalar.compiler-backend-emergency-slot-size)
            (- em-used-count 1)))
        8)]
    (compiler-backend-sweep-record!
      backend-state
      stream
      symbol
      (- bias-neg (* 8 slot-vars))
      (- bias-neg 8)
      disp
      em-lo
      em-hi
      (be_state.compiler-backend-current-fn-win64? backend-state))))

;; Compute [lo, hi] and disp for one Win64 rbp-framed function whose negative
;; rbp frame refs were successfully rebased to rsp-relative text. The body sees
;; rsp at rbp-frame, while the scanner starts before the prologue:
;; pushq %rbp (+8) plus subq $frame means disp = frame + 8.
(define (compiler-backend-sweep-record-win64!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]
  [symbol : String]
  [frame : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]) : unit
  (let
    [em-hi : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (+
          (+ frame em-slot-offset)
          (- (be_scalar.compiler-backend-emergency-slot-size) 8))
        0)]
    [em-lo : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (-
          (+ frame em-slot-offset)
          (*
            (be_scalar.compiler-backend-emergency-slot-size)
            (- em-used-count 1)))
        8)]
    (compiler-backend-sweep-record!
      backend-state
      stream
      symbol
      (- frame (* 8 slot-vars))
      (- frame 8)
      (+ frame 8)
      em-lo
      em-hi
      true)))

;; Commit census and sweep state only for the layout that emit-function returns.
;; Shrink-wrap fallback retries can change the prologue push count and frame
;; displacement, so a discarded attempt must never enter the ordered sweep
;; metadata stream.
(define (compiler-backend-commit-frame-layout!
  [backend-state : be_state.CompilerBackendState]
  [target : be_state.CompilerBackendTarget]
  [_assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [symbol : String]
  [frame : i64]
  [push-count : i64]
  [slot-vars : i64]
  [outgoing : i64]
  [squeeze : i64]
  [fpo-ok : bool]
  [rebase-ok : bool]
  [shrinkwrap-active? : bool]) : unit
  (if fpo-ok
    (cfg
      test
      (begin
        (be_state.compiler-backend-metric-add!
          backend-state
          be_state.compiler-backend-fpo-metric
          1)
        (if (> push-count 0)
          (be_state.compiler-backend-metric-add!
            backend-state
            be_state.compiler-backend-fpo-push-metric
            1)
          unit)
        (if (be_operand.compiler-backend-plan-uses-reg?
          backend-state
          _assignments
          compiler_abi.compiler-reg-id-rbp)
          (be_state.compiler-backend-metric-add!
            backend-state
            be_state.compiler-backend-fpo-rbp-plan-metric
            1)
          unit))
      unit)
    unit)
  ;; The sweep's displacement model starts at a function-entry prologue.
  ;; Keep shrink-wrapped interior prologues conservatively excluded.
  (cond
    [shrinkwrap-active? unit]
    [fpo-ok
      (compiler-backend-sweep-addr-lift!
        (be_state.compiler-backend-state-stream-state backend-state)
        (- (* -8 slot-vars) squeeze)
        squeeze)
      (compiler-backend-sweep-record-fpo!
        (be_state.compiler-backend-state-stream-state backend-state)
        symbol
        (- frame squeeze)
        push-count
        slot-vars
        (+
          (be_state.compiler-backend-function-scratch-i64
            (be_state.compiler-backend-state-function-state backend-state)
            be_state.compiler-backend-scratch-i64-emergency-slot-offset)
          squeeze)
        (be_state.compiler-backend-function-scratch-i64
          (be_state.compiler-backend-state-function-state backend-state)
          be_state.compiler-backend-scratch-i64-emergency-used-count)
        outgoing
        backend-state)]
    [(and (be_state.compiler-backend-target-seh-unwind? target) rebase-ok)
      (compiler-backend-sweep-record-win64!
        backend-state
        (be_state.compiler-backend-state-stream-state backend-state)
        symbol
        frame
        slot-vars
        (be_state.compiler-backend-function-scratch-i64
          (be_state.compiler-backend-state-function-state backend-state)
          be_state.compiler-backend-scratch-i64-emergency-slot-offset)
        (be_state.compiler-backend-function-scratch-i64
          (be_state.compiler-backend-state-function-state backend-state)
          be_state.compiler-backend-scratch-i64-emergency-used-count)
        outgoing)]
    [else unit]))

;; Append `v` at `count` into a growable i64 scratch array; returns the
;; (possibly reallocated) array. The caller advances its own count.
(define (compiler-backend-sweep-i64-push
  [arr : (__tl_dyn-array i64)]
  [count : i64]
  [v : i64]) : (__tl_dyn-array i64)
  (if (< count (array-length arr))
    (begin
      (set! (array-ref arr count) v)
      arr)
    (let
      [old : i64 (array-length arr)]
      [ncap : i64
        (if (< old 64)
          128
          (* old 2))]
      [na : (__tl_dyn-array i64) (__tl_make-array i64 ncap)]
      (for [k (iterator.range 0 count)]
        (set! (array-ref na k) (array-ref arr k)))
      (set! (array-ref na count) v)
      na)))

;; True iff the line [ls,le) is exactly "<sym>:" for metadata entry `idx`.
(define (compiler-backend-sweep-label-matches?
  [stream : be_state.CompilerBackendStreamState]
  [data : (Ptr u8)]
  [ls : i64]
  [le : i64]
  [idx : i64]) : bool
  (unsafe
    (let
      [state-data : (Ptr be_state.CompilerBackendStreamStateData)
        (be_state.compiler-backend-stream-state-view stream)]
      [off : i64 (array-ref (deref state-data).sweep-sym-off idx)]
      [len : i64 (array-ref (deref state-data).sweep-sym-len idx)]
      (if (not (= (- le ls) (+ len 1)))
        false
        (if (not
          (= (be_state.compiler-backend-peephole-byte-at data (- le 1)) 58))
          false
          (let
            [j : i64 0]
            [ok : bool true]
            (while (and ok (< j len))
              (if (=
                (be_state.compiler-backend-peephole-byte-at data (+ ls j))
                (cast
                  (array-ref (deref state-data).sweep-sym-bytes (+ off j))
                  : i64))
                unit
                (set! ok false))
              (+= j 1))
            ok))))))

;; Set every bit of [a, b) in one byte bitmap. Callers clip [a, b) to the
;; coverage window; every mark is slot-aligned.
(define (compiler-backend-sweep-bitmap-mark!
  [bits : (&mut bits (__tl_dyn-array i64))]
  [wlo : i64]
  [a : i64]
  [b : i64]) : unit
  (if (< a b)
    (let
      [aw : i64 (shr (- a wlo) 6)]
      [bw : i64 (shr (- (- b wlo) 1) 6)]
      (for [w (iterator.range aw (+ bw 1))]
        (let
          [lo-bit : i64
            (if (= w aw)
              (bit-and (- a wlo) 63)
              0)]
          [hi-bit : i64
            (if (= w bw)
              (bit-and (- (- b wlo) 1) 63)
              63)]
          [width : i64 (+ (- hi-bit lo-bit) 1)]
          [mask : i64
            (if (= width 64)
              -1
              (shl (- (shl 1 width) 1) lo-bit))]
          (set! (array-ref bits w) (bit-or (array-ref bits w) mask)))))
    unit))

;; True when any bit of the eight bytes at canonical `c` is set.
(define (compiler-backend-sweep-bitmap-hit?
  [bits : (& bits (__tl_dyn-array i64))]
  [wlo : i64]
  [c : i64]) : bool
  (let
    [a : i64 (- c wlo)]
    [aw : i64 (shr a 6)]
    [bw : i64 (shr (+ a 7) 6)]
    [w : i64 aw]
    [hit : bool false]
    (while (and (not hit) (<= w bw))
      (let
        [lo-bit : i64
          (if (= w aw)
            (bit-and a 63)
            0)]
        [hi-bit : i64
          (if (= w bw)
            (bit-and (+ a 7) 63)
            63)]
        [width : i64 (+ (- hi-bit lo-bit) 1)]
        [mask : i64
          (if (= width 64)
            -1
            (shl (- (shl 1 width) 1) lo-bit))]
        (if (not (= (bit-and (array-ref bits w) mask) 0))
          (set! hit true)
          unit)
        (+= w 1)))
    hit))

;; Sweep one function region [rstart,rend) of the record array: collect
;; reads/candidates/poison state in pass 1, then mark every dead candidate
;; store's record deleted. The line bytes are never re-read -- the per-record
;; summary already carries everything the byte walk derived, with the
;; delta-dependent offsets kept raw and rebased here.
;; Fixed-size scratch bitmap for the region sweep's pass 2: one bit per byte
;; of the eligibility coverage window, reused across regions (only the used
;; prefix is zeroed per region). Pass 2's per-candidate decisions are
;; mutually independent given the reads, watermark and windows, so the
;; overlap test runs against this bitmap when the window fits the cap:
;; candidate at c is swept iff no bit is set in [c-wlo, c+8-wlo). A set bit at
;; x means some read covers byte x, and eligibility forces c into a window
;; (hence [c,c+8) into the coverage window), so the query is literally the
;; per-read predicate it replaces: any bit in [c,c+8) iff exists r with
;; lo_r < c+8 and hi_r > c. Byte granularity keeps unaligned reads and
;; 16/32/64-byte widths exact.
;;
;; Largest coverage window served by the bitmap, in i64 words (64 bytes per
;; word). Wider frames keep the exact per-candidate read scan; the choice
;; depends only on region metadata, never on results.
(define compiler-backend-sweep-coverage-max-words : i64
  4096)

;; Arena for the address-extent tables and the poison bitmap. It is created on
;; first use and rewound by `sweep-reset!` at the end of every program's sweep,
;; so the tables never survive the emission that built them.
(define (compiler-backend-sweep-addr-arena-ensure!
  [_backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]) : arena.Arena
  (let
    [data : (MutPtr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-ptr stream)]
    (unsafe
      (if (= (deref data).sweep-addr-arena 0)
        (let
          [home : arena.Arena (arena.current)]
          [owner : arena.Arena
            (unsafe
              (arena.Arena (arena.tl_arena_make_small)))]
          [_set-owner : unit (arena.set! owner)]
          [mark : arena.ArenaMark (arena.mark)]
          (arena.set! home)
          (set! (deref data).sweep-addr-arena (arena.raw-handle owner))
          (set! (deref data).sweep-addr-mark (arena.mark-raw-handle mark))
          owner)
        (unsafe
          (arena.Arena (deref data).sweep-addr-arena))))))

(define (compiler-backend-sweep-coverage-ensure!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]
  [required : i64]) : bool
  (let
    [data : (MutPtr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-ptr stream)]
    [old : (__tl_dyn-array i64)
      (unsafe
        (deref data).sweep-coverage-bits)]
    [new-cap : i64
      (if (= (array-length old) 0)
        64
        (array-length old))]
    (while (and
      (< new-cap required)
      (< new-cap compiler-backend-sweep-coverage-max-words))
      (set!
        new-cap
        (if (> (* new-cap 2) compiler-backend-sweep-coverage-max-words)
          compiler-backend-sweep-coverage-max-words
          (* new-cap 2))))
    (if (< new-cap required)
      false
      (begin
        (unless
          (>=
            (array-length
              (unsafe
                (deref data).sweep-poison-bits))
            new-cap)
          (in-arena
            (compiler-backend-sweep-addr-arena-ensure! backend-state stream)
            (unsafe
              (set!
                (deref data).sweep-poison-bits
                (__tl_make-array i64 new-cap)))))
        (if (= new-cap (array-length old))
          true
          (let
            [owner : arena.Arena
              (be_state.compiler-backend-state-lazy-table-arena-ensure!
                backend-state)]
            (in-arena
              owner
              (unsafe
                (set!
                  (deref data).sweep-coverage-bits
                  (__tl_make-array i64 new-cap)))
              true)))))))

(define (compiler-backend-sweep-region-records!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]
  [recs : (__tl_dyn-array be_state.CompilerBackendPeepholeLineRecord)]
  [live : (&mut live (__tl_dyn-array i64))]
  [rstart : i64]
  [rend : i64]
  [lo : i64]
  [hi : i64]
  [disp : i64]
  [em-lo : i64]
  [em-hi : i64]
  [win64 : bool]
  [addr-start : i64]
  [addr-len : i64]) : unit
  (let
    [stream : be_state.CompilerBackendStreamState stream]
    [delta : i64 (- 0 disp)]
    [sweepable : bool true]
    [win64-tail : bool false]
    [watermark : i64 4611686018427387904]
    [leaqs : (__tl_dyn-array i64) (__tl_make-array i64 32)]
    [leaq-count : i64 0]
    [none : i64 be_peephole.compiler-backend-sweep-no-candidate]
    [reads-lo : (__tl_dyn-array i64) (__tl_make-array i64 64)]
    [reads-hi : (__tl_dyn-array i64) (__tl_make-array i64 64)]
    [read-count : i64 0]
    [cand-pos : (__tl_dyn-array i64) (__tl_make-array i64 32)]
    [cand-off : (__tl_dyn-array i64) (__tl_make-array i64 32)]
    [cand-count : i64 0]
    [i : i64 rstart]
    ;; ---- pass 1 ----
    (while (and sweepable (< i rend))
      (let
        [line : be_state.CompilerBackendPeepholeLineRecord
          (be_state.compiler-backend-global-array-element-shared-view recs i)]
        [kind : i64 (be_peephole.compiler-backend-peephole-record-kind line)]
        (cond
          [(= kind be_peephole.compiler-backend-sweep-line-kind-skip) unit]
          [(= kind be_peephole.compiler-backend-sweep-line-kind-label)
            ;; label: only reachable at delta 0 (the audit proved it).
            (if win64-tail
              (set! sweepable false)
              (set! delta 0))]
          [else
            (let
              [meta : i64 line.meta]
              (if (not
                (=
                  (bit-and
                    meta
                    be_peephole.compiler-backend-peephole-record-sweep-inert-bit)
                  0))
                ;; Sweep-inert record: no rsp motion, read, candidate or
                ;; epilogue effect by construction (the bit's comment at
                ;; the record packing gives the exact invariant); only
                ;; Win64-tail poisoning remains.
                (when win64-tail (set! sweepable false))
                (let
                  [cand-raw : i64 line.cand]
                  (if (not (= cand-raw none))
                    ;; Verified candidate store: flags, mem-count and
                    ;; epilogue are empty by construction, so only
                    ;; Win64-tail poisoning and the candidate pushes
                    ;; remain.
                    (begin
                      (when win64-tail (set! sweepable false))
                      (set!
                        cand-pos
                        (if (< cand-count (array-length cand-pos))
                          (begin
                            (set! (array-ref cand-pos cand-count) i)
                            cand-pos)
                          (compiler-backend-sweep-i64-push
                            cand-pos
                            cand-count
                            i)))
                      (set!
                        cand-off
                        (if (< cand-count (array-length cand-off))
                          (begin
                            (set!
                              (array-ref cand-off cand-count)
                              (- cand-raw delta))
                            cand-off)
                          (compiler-backend-sweep-i64-push
                            cand-off
                            cand-count
                            (- cand-raw delta))))
                      (+= cand-count 1))
                    (let
                      [flags : i64
                        (be_peephole.compiler-backend-peephole-record-flags
                          line)]
                      [push? : bool
                        (compiler-backend-sweep-line-flag?
                          flags
                          be_peephole.compiler-backend-sweep-line-flag-push)]
                      [pop? : bool
                        (compiler-backend-sweep-line-flag?
                          flags
                          be_peephole.compiler-backend-sweep-line-flag-pop)]
                      [leaq? : bool
                        (compiler-backend-sweep-line-flag?
                          flags
                          be_peephole.compiler-backend-sweep-line-flag-leaq)]
                      [leave? : bool
                        (compiler-backend-sweep-line-flag?
                          flags
                          be_peephole.compiler-backend-sweep-line-flag-leave)]
                      [subq? : bool
                        (compiler-backend-sweep-line-flag?
                          flags
                          be_peephole.compiler-backend-sweep-line-flag-subq)]
                      [rsp-dst? : bool
                        (compiler-backend-sweep-line-flag?
                          flags
                          be_peephole.compiler-backend-sweep-line-flag-rsp-dst)]
                      [tracked-rsp-write? : bool
                        (compiler-backend-sweep-line-flag?
                          flags
                          be_peephole.compiler-backend-sweep-line-flag-tracked-rsp-write)]
                      [win64-rbp-set? : bool
                        (and
                          win64
                          (compiler-backend-sweep-line-flag?
                            flags
                            be_peephole.compiler-backend-sweep-line-flag-win64-rbp-set))]
                      [epilogue-raw : i64 line.epilogue]
                      [win64-epilogue-c : i64
                        (if (or (not win64) (= epilogue-raw none))
                          none
                          (- epilogue-raw delta))]
                      [win64-epilogue-leaq? : bool
                        (and
                          (not (= win64-epilogue-c none))
                          (< win64-epilogue-c lo))]
                      [win64-tail-ok? : bool
                        (or
                          pop?
                          leave?
                          (compiler-backend-sweep-line-flag?
                            flags
                            be_peephole.compiler-backend-sweep-line-flag-ret)
                          (compiler-backend-sweep-line-flag?
                            flags
                            be_peephole.compiler-backend-sweep-line-flag-jmp))]
                      (if (and win64-tail (not win64-tail-ok?))
                        (set! sweepable false)
                        unit)
                      (if (and leave? (not win64))
                        (set! sweepable false)
                        unit)
                      ;; general line: replay the recorded %rsp classification.
                      (let
                        [mem-count : i64
                          (be_peephole.compiler-backend-peephole-record-mem-count
                            line)]
                        [w : i64
                          (be_peephole.compiler-backend-peephole-record-width
                            line)]
                        ;; "(%rsp," indexed / truncated.
                        (when
                          (compiler-backend-sweep-line-flag?
                            flags
                            be_peephole.compiler-backend-sweep-line-flag-fatal-mem)
                          (set! sweepable false))
                        ;; bare %rsp: only the tracked subq/addq $imm dst and
                        ;; proven Win64 prologue/epilogue shapes are allowed.
                        (when
                          (and
                            (compiler-backend-sweep-line-flag?
                              flags
                              be_peephole.compiler-backend-sweep-line-flag-bare-rsp)
                            (not win64-rbp-set?))
                          (set! sweepable false))
                        (when
                          (and
                            (compiler-backend-sweep-line-flag?
                              flags
                              be_peephole.compiler-backend-sweep-line-flag-bare-rsp-tail)
                            (not win64-rbp-set?)
                            (not win64-epilogue-leaq?)
                            (not tracked-rsp-write?))
                          (set! sweepable false))
                        (for [k (iterator.range 0 mem-count)]
                          (let
                            ;; `popq MEM` increments %rsp BEFORE computing
                            ;; its destination address, so its frame
                            ;; operand is canonical at delta-8 -- the same
                            ;; bias the FPO rebase pass applies (it lowers
                            ;; delta before rewriting a pop's refs). Every
                            ;; other line, push included (`push m` reads its
                            ;; operand at the ORIGINAL %rsp), is canonical
                            ;; at delta.
                            [c : i64
                              (-
                                (if (= k 0)
                                  line.value
                                  (be_peephole.compiler-backend-sweep-line-mem-off-nth
                                    (be_peephole.compiler-backend-peephole-record-data
                                      line)
                                    (be_peephole.compiler-backend-peephole-record-mnemonic-start
                                      line)
                                    (be_peephole.compiler-backend-peephole-record-end
                                      line)
                                    k))
                                (if pop?
                                  (- delta 8)
                                  delta))]
                            (if leaq?
                              ;; A frame address: remember its canonical offset;
                              ;; pass 2 resolves the addressed object's extent
                              ;; for it and poisons only that span.
                              (if win64-epilogue-leaq?
                                unit
                                (begin
                                  (set!
                                    leaqs
                                    (compiler-backend-sweep-i64-push
                                      leaqs
                                      leaq-count
                                      c))
                                  (+= leaq-count 1)
                                  (if (< c watermark)
                                    (set! watermark c)
                                    unit)))
                              (begin
                                (set!
                                  reads-lo
                                  (if (< read-count (array-length reads-lo))
                                    (begin
                                      (set! (array-ref reads-lo read-count) c)
                                      reads-lo)
                                    (compiler-backend-sweep-i64-push
                                      reads-lo
                                      read-count
                                      c)))
                                (set!
                                  reads-hi
                                  (if (< read-count (array-length reads-hi))
                                    (begin
                                      (set!
                                        (array-ref reads-hi read-count)
                                        (+ c w))
                                      reads-hi)
                                    (compiler-backend-sweep-i64-push
                                      reads-hi
                                      read-count
                                      (+ c w))))
                                (+= read-count 1))))))
                      ;; rsp motion
                      (if (and rsp-dst? (not pop?))
                        (if win64-epilogue-leaq?
                          (begin
                            (set! delta (- 0 win64-epilogue-c))
                            (set! win64-tail true))
                          (if tracked-rsp-write?
                            (if subq?
                              (+= delta line.value)
                              (-= delta line.value))
                            (set! sweepable false)))
                        unit)
                      (if push?
                        (+= delta 8)
                        unit)
                      (if pop?
                        (-= delta 8)
                        unit))))))])
        (+= i 1)))
    ;; ---- pass 2 ----
    ;; Coverage window over the eligibility windows (the em window's
    ;; emptiness convention is em-lo=8 > em-hi=0; the var window is empty
    ;; when slot-vars=0, i.e. lo > hi). whi gets +8 so a candidate at
    ;; exactly c == hi has its whole [hi, hi+8) store covered. Both windows
    ;; empty means no candidate can be eligible; a window wider than the
    ;; cap keeps the exact per-candidate read scan.
    (if (or (not sweepable) (= cand-count 0))
      unit
      (let
        [em-nonempty? : bool (<= em-lo em-hi)]
        [var-nonempty? : bool (<= lo hi)]
        [wlo : i64
          (if (and em-nonempty? (< em-lo lo))
            em-lo
            lo)]
        [whi : i64
          (+
            (if (> hi em-hi)
              hi
              em-hi)
            8)]
        [words : i64 (/ (+ (- whi wlo) 63) 64)]
        [use-bitmap? : bool
          (and
            (or em-nonempty? var-nonempty?)
            (<= words compiler-backend-sweep-coverage-max-words)
            (compiler-backend-sweep-coverage-ensure! backend-state stream words))]
        [coverage-data : (Ptr be_state.CompilerBackendStreamStateData)
          (be_state.compiler-backend-stream-state-view stream)]
        [coverage-bits : (__tl_dyn-array i64)
          (unsafe
            (deref coverage-data).sweep-coverage-bits)]
        [poison-bits : (__tl_dyn-array i64)
          (unsafe
            (deref coverage-data).sweep-poison-bits)]
        [addr-rbp : (__tl_dyn-array i64)
          (unsafe
            (deref coverage-data).sweep-addr-rbp)]
        [addr-ext : (__tl_dyn-array i64)
          (unsafe
            (deref coverage-data).sweep-addr-ext)]
        (when
          use-bitmap?
          (for [w (iterator.range 0 words)]
            (set! (array-ref coverage-bits w) 0)
            (set! (array-ref poison-bits w) 0))
          (for [r (iterator.range 0 read-count)]
            (compiler-backend-sweep-bitmap-mark!
              (&mut coverage-bits)
              wlo
              (if (> (array-ref reads-lo r) wlo)
                (array-ref reads-lo r)
                wlo)
              (if (< (array-ref reads-hi r) whi)
                (array-ref reads-hi r)
                whi)))
          ;; Poison: an addressing leaq protects the recorded object whose span
          ;; contains it (so a field/element leaq at B+k is covered by the
          ;; whole object), and a leaq with no recorded span at its offset
          ;; keeps the old poison-everything watermark from that offset.
          (for [k (iterator.range 0 leaq-count)]
            (let
              [l : i64 (array-ref leaqs k)]
              [found : bool false]
              [j : i64 0]
              (while (< j addr-len)
                (let
                  [span-lo : i64
                    (+ (+ hi 8) (array-ref addr-rbp (+ addr-start j)))]
                  [span-hi : i64
                    (+ span-lo (array-ref addr-ext (+ addr-start j)))]
                  (if (and (<= span-lo l) (< l span-hi))
                    (begin
                      (set! found true)
                      (compiler-backend-sweep-bitmap-mark!
                        (&mut poison-bits)
                        wlo
                        (if (> span-lo wlo)
                          span-lo
                          wlo)
                        (if (< span-hi whi)
                          span-hi
                          whi)))
                    unit))
                (+= j 1))
              (if found
                unit
                (compiler-backend-sweep-bitmap-mark!
                  (&mut poison-bits)
                  wlo
                  (if (> l wlo)
                    l
                    wlo)
                  whi)))))
        (let
          [swept : i64 0]
          (for [k (iterator.range 0 cand-count)]
            (let
              [c : i64 (array-ref cand-off k)]
              [pos : i64 (array-ref cand-pos k)]
              (if (and
                (or
                  (and (>= c lo) (<= c hi) (= (bit-and (- c lo) 7) 0))
                  (and (>= c em-lo) (<= c em-hi) (= (bit-and (- c em-lo) 7) 0)))
                (if use-bitmap?
                  (not
                    (compiler-backend-sweep-bitmap-hit? (& poison-bits) wlo c))
                  (< c watermark)))
                (let
                  [read : bool
                    (if use-bitmap?
                      (compiler-backend-sweep-bitmap-hit?
                        (& coverage-bits)
                        wlo
                        c)
                      (let
                        [r : i64 0]
                        [hit : bool false]
                        (while (and (not hit) (< r read-count))
                          (if (and
                            (< (array-ref reads-lo r) (+ c 8))
                            (< c (array-ref reads-hi r)))
                            (set! hit true)
                            unit)
                          (+= r 1))
                        hit))]
                  (unless read (set! (array-ref live pos) 0) (+= swept 1)))
                unit)))
          (if (> swept 0)
            (cfg
              test
              (begin
                (be_state.compiler-backend-metric-add!
                  backend-state
                  be_state.compiler-backend-sweep-swept-stores-metric
                  swept)
                (be_state.compiler-backend-metric-add!
                  backend-state
                  be_state.compiler-backend-sweep-swept-funcs-metric
                  1))
              unit)
            unit))))))

(define (compiler-backend-borrowed-copy-to-owned
  [buf : (text_buf_borrowed.TextBufBorrowed asm)]) : text_buf.TextBuf
  (match buf
    [(text_buf_borrowed.TextBufBorrowed chunks len)
      (text_buf.TextBuf (text_buf_borrowed.chunks-to-owned chunks) len)]))

;; Sweep one group's line records, resuming at the next metadata entry from an
;; earlier group. The caller owns the cursor and resets the job's sweep metrics
;; only after the final group. Dead stores are marked in the record array's
;; `live` mask; nothing is copied or rebuilt.
(define (compiler-backend-deadstore-sweep-records!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]
  [v : (& v be_state.CompilerBackendPeepholeLineVec)]
  [start-cursor : i64]) : i64
  (let
    [data : (Ptr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-view stream)]
    (unsafe
      (if (>= start-cursor (deref data).sweep-count)
        start-cursor
        (let
          [recs : (__tl_dyn-array be_state.CompilerBackendPeepholeLineRecord)
            v.lines]
          [live : (__tl_dyn-array i64)
            (owned_view.compiler-owned-reference-shared-view (& v.live))]
          [count : i64 v.len]
          [cursor : i64 start-cursor]
          [i : i64 0]
          (while (and (< i count) (< cursor (deref data).sweep-count))
            (let
              [line : be_state.CompilerBackendPeepholeLineRecord
                (be_state.compiler-backend-global-array-element-shared-view
                  recs
                  i)]
              (if (compiler-backend-sweep-label-matches?
                stream
                (be_peephole.compiler-backend-peephole-record-data line)
                (be_peephole.compiler-backend-peephole-record-start line)
                (be_peephole.compiler-backend-peephole-record-end line)
                cursor)
                (let
                  [rstart : i64 (+ i 1)]
                  [rend : i64
                    (be_peephole.compiler-backend-sweep-region-end-records
                      (be_state.compiler-backend-global-shared-view recs)
                      rstart
                      count)]
                  (compiler-backend-sweep-region-records!
                    backend-state
                    stream
                    (be_state.compiler-backend-global-shared-view recs)
                    (&mut live)
                    rstart
                    rend
                    (array-ref (deref data).sweep-lo-arr cursor)
                    (array-ref (deref data).sweep-hi-arr cursor)
                    (array-ref (deref data).sweep-disp-arr cursor)
                    (array-ref (deref data).sweep-em-lo-arr cursor)
                    (array-ref (deref data).sweep-em-hi-arr cursor)
                    (= (array-ref (deref data).sweep-win64-arr cursor) 1)
                    (if (> (array-length (deref data).sweep-addr-start-arr) 0)
                      (array-ref (deref data).sweep-addr-start-arr cursor)
                      0)
                    (if (> (array-length (deref data).sweep-addr-len-arr) 0)
                      (array-ref (deref data).sweep-addr-len-arr cursor)
                      0))
                  (+= cursor 1)
                  (set! i rend))
                (+= i 1))))
          cursor)))))

;; ============================================================================
;; GAP9: gep displacement folding (codegen phase 9 / P7a).
;;
;; The optimizer's affine rebase (phase 6) leaves unrolled loop bodies
;; addressing arrays with PARALLEL offset vars -- `i1 = i + 1; i2 = i + 2;
;; i3 = i + 3` -- each materialized as a leaq/addq and consumed as a Gep
;; index. clang folds the constant into the addressing displacement instead:
;; `addq 8(%rax,%r13,8), %r14`, no offset materialization at all.
;;
;; This pre-pass runs on the function's blocks BEFORE the register plan is
;; computed, so liveness and allocation see the folded program (the shared
;; base counter stays live through the folded uses; the offset vars vanish
;; and stop costing registers):
;;   * candidate: `dst = Add (Var j) (I64 k)` (either operand order) at
;;     64-bit int type, dst defined exactly once in the function, k != 0
;;     and |k| small;
;;   * every use of dst (function-wide use counts) must be the INDEX operand
;;     of a Gep in the SAME BLOCK after the add, whose own dst is single-def
;;     and whose byte displacement k*type-size stays small. Any other use --
;;     another block, a bounds check, a phi input, a store value, a gep
;;     BASE -- keeps the add;
;;   * no def of j between the add and the last folded gep (linear in-block
;;     execution then guarantees the gep reads the same j the add read), and
;;     j is not address-taken in the function (a store or call through &j
;;     redefines it without a direct def);
;;   * a candidate whose base j is ITSELF an elided candidate is dropped
;;     (its add is deleted, so the value would never exist).
;; The rewrite deletes the add, retargets the gep's index operand to j, and
;; records the byte displacement in the per-function ordinal-indexed side
;; table described below (walk order, one entry per Gep -- NOT keyed by gep
;; dst: the later register rewrites renumber vars). Emission threads the
;; displacement into the two bottom-most address builders, so every addressing
;; form -- SIB, staged non-SIB, spilled-operand fallbacks -- applies it exactly
;; once.
(defenum CompilerBackendMaybeVarImm
  (No)
  (Some i64 i64))

;; Ordinal-indexed (walk-order) per-gep tables: the register pipeline's later
;; IR rewrites (caller-save spills and region remaps) RENAME
;; vars inside loop regions but never create, delete, or reorder Gep
;; instructions, so the n-th Gep the emitter walks is the n-th Gep the
;; pre-pass saw. Each entry carries the byte displacement plus the gep's
;; offset kind (1 = Var, 0 = other) and element size as a drift check: a
;; consumption mismatch marks the function poisoned and emission fails loudly
;; rather than addressing with a stale displacement.
;;
;; The obligation the ordinal keying puts on EMISSION is the whole invariant:
;; every Gep in the walk consumes exactly one ordinal, whether the block walker
;; dispatches it or a peephole ABSORBS it (a fusion that resumes the walk past
;; a gep it folded into its own operand still owns that gep's ordinal). A path
;; that absorbs without consuming does not fail where it sits -- it shifts
;; every later gep in the function onto the previous entry, which is silent
;; whenever the shapes happen to agree. The audit below therefore checks the
;; ordinal COUNT as well as the shapes, so an absorbing path cannot go silent.
(define (compiler-backend-gep-fold-disable!
  [function-state : be_state.CompilerBackendFunctionState]) : unit
  (be_state.compiler-backend-function-state-set-bool!
    function-state
    be_state.compiler-backend-function-bool-gep-fold-ready
    false)
  (be_state.compiler-backend-function-state-set-i64-array!
    function-state
    be_state.compiler-backend-function-i64-array-gep-fold-disp-table
    (__tl_make-array i64 0))
  (be_state.compiler-backend-function-state-set-i64-array!
    function-state
    be_state.compiler-backend-function-i64-array-gep-fold-kind-table
    (__tl_make-array i64 0))
  (be_state.compiler-backend-function-state-set-i64-array!
    function-state
    be_state.compiler-backend-function-i64-array-gep-fold-scale-table
    (__tl_make-array i64 0))
  (be_state.compiler-backend-function-state-set-i64!
    function-state
    be_state.compiler-backend-function-i64-gep-fold-cursor
    0)
  (be_state.compiler-backend-function-state-set-bool!
    function-state
    be_state.compiler-backend-function-bool-gep-fold-drift
    false))

(define (compiler-backend-gep-fold-offset-kind
  [offset : (& compiler_ir_types.CompilerIrValue)]) : i64
  (match offset
    [(Var _) 1]
    [_ 0]))

;; Consume the next gep ordinal and return its folded displacement (0 for
;; unfolded geps). Called EXACTLY ONCE per Gep instruction the block walker
;; dispatches; kind/scale must match what the pre-pass recorded or the
;; function is poisoned (checked after body emission).
(define (compiler-backend-gep-fold-next!
  [function-state : be_state.CompilerBackendFunctionState]
  [type-segment-bases : i64]
  [offset : (& offset compiler_ir_types.CompilerIrValue)]
  [elem-ty : (& elem-ty compiler_ast_types.AstType)]) : i64
  (let
    [offset : compiler_ir_types.CompilerIrValue
      (owned_view.compiler-owned-reference-shared-view offset)]
    [elem-ty : compiler_ast_types.AstType
      (owned_view.compiler-owned-reference-shared-view elem-ty)]
    (if (not
      (be_state.compiler-backend-function-state-bool?
        function-state
        be_state.compiler-backend-function-bool-gep-fold-ready))
      0
      (let
        [cursor : i64
          (be_state.compiler-backend-function-state-i64
            function-state
            be_state.compiler-backend-function-i64-gep-fold-cursor)]
        [disp-table : (__tl_dyn-array i64)
          (be_state.compiler-backend-function-state-i64-array
            function-state
            be_state.compiler-backend-function-i64-array-gep-fold-disp-table)]
        [kind-table : (__tl_dyn-array i64)
          (be_state.compiler-backend-function-state-i64-array
            function-state
            be_state.compiler-backend-function-i64-array-gep-fold-kind-table)]
        [scale-table : (__tl_dyn-array i64)
          (be_state.compiler-backend-function-state-i64-array
            function-state
            be_state.compiler-backend-function-i64-array-gep-fold-scale-table)]
        (if (>= cursor (array-length disp-table))
          (begin
            (be_state.compiler-backend-function-state-set-bool!
              function-state
              be_state.compiler-backend-function-bool-gep-fold-drift
              true)
            0)
          (begin
            (be_state.compiler-backend-function-state-set-i64!
              function-state
              be_state.compiler-backend-function-i64-gep-fold-cursor
              (+ cursor 1))
            (if (and
              (=
                (array-ref kind-table cursor)
                (compiler-backend-gep-fold-offset-kind offset))
              (=
                (array-ref scale-table cursor)
                (be_operand.compiler-backend-type-size
                  type-segment-bases
                  elem-ty)))
              (array-ref disp-table cursor)
              (begin
                (be_state.compiler-backend-function-state-set-bool!
                  function-state
                  be_state.compiler-backend-function-bool-gep-fold-drift
                  true)
                0))))))))

;; PURE lookahead at an ordinal the walker has not consumed yet: returns exactly
;; what `compiler-backend-gep-fold-next!` WILL return for the gep sitting
;; `ahead` positions past the cursor (0 = the very next Gep the walker
;; dispatches), without advancing the cursor and without ever setting drift.
;;
;; ORDINAL SAFETY. Peeking is not consuming: the caller must still consume every
;; gep it absorbs, exactly once, in walk order. The peek exists for the one
;; admission question a displacement-blind probe cannot answer -- whether two
;; syntactically identical geps address the SAME byte. GAP9 folds `i+k` into the
;; displacement and retargets the gep index to `i`, so two geps can carry equal
;; base/offset/element operands and still address different words; the RMW fold
;; below is only sound when their displacements agree, and it must decide that
;; BEFORE it commits, because a decline after consumption would double-consume
;; on the fallback path (the store-pair ordinal bug class).
;;
;; `ahead` is counted in Gep instructions, which the caller establishes by
;; matching the intervening instructions structurally: it may only peek past
;; geps it has already seen in the sequence.
(define (compiler-backend-gep-fold-peek
  [function-state : be_state.CompilerBackendFunctionState]
  [type-segment-bases : i64]
  [ahead : i64]
  [offset : (& compiler_ir_types.CompilerIrValue)]
  [elem-ty : (& compiler_ast_types.AstType)]) : i64
  (if (not
    (be_state.compiler-backend-function-state-bool?
      function-state
      be_state.compiler-backend-function-bool-gep-fold-ready))
    0
    (let
      [cursor : i64
        (+
          (be_state.compiler-backend-function-state-i64
            function-state
            be_state.compiler-backend-function-i64-gep-fold-cursor)
          ahead)]
      [disp-table : (__tl_dyn-array i64)
        (be_state.compiler-backend-function-state-i64-array
          function-state
          be_state.compiler-backend-function-i64-array-gep-fold-disp-table)]
      [kind-table : (__tl_dyn-array i64)
        (be_state.compiler-backend-function-state-i64-array
          function-state
          be_state.compiler-backend-function-i64-array-gep-fold-kind-table)]
      [scale-table : (__tl_dyn-array i64)
        (be_state.compiler-backend-function-state-i64-array
          function-state
          be_state.compiler-backend-function-i64-array-gep-fold-scale-table)]
      (if (or (< cursor 0) (>= cursor (array-length disp-table)))
        0
        (if (and
          (=
            (array-ref kind-table cursor)
            (compiler-backend-gep-fold-offset-kind offset))
          (=
            (array-ref scale-table cursor)
            (be_operand.compiler-backend-type-size type-segment-bases elem-ty)))
          (array-ref disp-table cursor)
          0)))))

(define (compiler-backend-gep-fold-drift?
  [function-state : be_state.CompilerBackendFunctionState]) : bool
  (and
    (be_state.compiler-backend-function-state-bool?
      function-state
      be_state.compiler-backend-function-bool-gep-fold-ready)
    (be_state.compiler-backend-function-state-bool?
      function-state
      be_state.compiler-backend-function-bool-gep-fold-drift)))

;; Whole-function completeness half of the audit: after a body has been
;; emitted, every recorded ordinal must have been consumed. A shape mismatch
;; (above) only catches a misalignment that happens to land on a differently
;; shaped gep; an emission path that ABSORBS a gep without consuming its
;; ordinal -- the store-ptr pair peephole did exactly that -- shifts every
;; later gep in the function onto the wrong entry and can be shape-silent, so
;; the count is checked as well and drives the same hard error.
(define (compiler-backend-gep-fold-unconsumed?
  [function-state : be_state.CompilerBackendFunctionState]) : bool
  (and
    (be_state.compiler-backend-function-state-bool?
      function-state
      be_state.compiler-backend-function-bool-gep-fold-ready)
    (not
      (=
        (be_state.compiler-backend-function-state-i64
          function-state
          be_state.compiler-backend-function-i64-gep-fold-cursor)
        (array-length
          (be_state.compiler-backend-function-state-i64-array
            function-state
            be_state.compiler-backend-function-i64-array-gep-fold-disp-table))))))

;; The emit-function gate: either half of the GAP9 accounting audit fails the
;; compile loudly rather than addressing with a stale displacement.
(define (compiler-backend-gep-fold-audit-failed?
  [function-state : be_state.CompilerBackendFunctionState]) : bool
  (or
    (compiler-backend-gep-fold-drift? function-state)
    (compiler-backend-gep-fold-unconsumed? function-state)))

(define (compiler-backend-gep-fold-64bit-int?
  [ty : (& ty compiler_ast_types.AstType)]) : bool
  (match ty
    [(or (I64) (U64)) true]
    [_ false]))

;; The (var j, imm k) split of a candidate add's operands, or No.
(define (compiler-backend-gep-fold-add-operands
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]) : CompilerBackendMaybeVarImm
  (match lhs
    [(Var v)
      (match rhs
        [(I64 k) (Some v k)]
        [_ (No)])]
    [(I64 k)
      (match rhs
        [(Var v) (Some v k)]
        [_ (No)])]
    [_ (No)]))

;; The (base, displacement) an offset instruction contributes: an `add` with
;; the literal on either side, or a `sub` with the literal on the right (the
;; displacement negated; i64 MIN has no negation and declines).
(define (compiler-backend-gep-fold-offset-operands
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]) : CompilerBackendMaybeVarImm
  (match op
    [(Add) (compiler-backend-gep-fold-add-operands lhs rhs)]
    [(Sub)
      (match lhs
        [(Var v)
          (match rhs
            [(I64 k)
              (if (= k (- (- 0 9223372036854775807) 1))
                (No)
                (Some v (- 0 k)))]
            [_ (No)])]
        [_ (No)])]
    [_ (No)]))

(define (compiler-backend-gep-fold-block-instrs
  [block : compiler_ir_types.CompilerIrBlock]) : compiler_ir_types.CompilerIrInstrSeq
  (match block
    [(Block _ instrs) instrs]))

;; Blocks as an array so per-candidate segment scans can address their block
;; by ordinal.
(define (compiler-backend-gep-fold-block-array
  [blocks : compiler_ir_types.CompilerIrBlockList]) : (__tl_dyn-array
    compiler_ir_types.CompilerIrBlock)
  (match (& blocks)
    [(Array seq)
      (let
        [count : i64 (compiler_ir_types.compiler-ir-block-seq-count seq)]
        [out : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)
          (__tl_make-array compiler_ir_types.CompilerIrBlock count)]
        (for [j (iterator.range 0 count)]
          (set!
            (array-ref out j)
            (compiler_ir_types.compiler-ir-block-seq-ref seq j)))
        out)]))

(define (compiler-backend-gep-fold-count-geps
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]) : i64
  (let
    [total : i64 0]
    (for [b (iterator.range 0 (array-length barr))]
      (let
        [instrs : compiler_ir_types.CompilerIrInstrSeq
          (compiler-backend-gep-fold-block-instrs
            (be_state.compiler-backend-global-array-element-shared-view barr b))]
        [n : i64 instrs.len]
        [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
          instrs.slots]
        (for [j (iterator.range 0 n)]
          (match (be_state.compiler-backend-global-array-element-shared-view
            slots
            j)
            [(Gep _ _ _ _) (+= total 1)]
            [_ unit]))))
    total))

(define (compiler-backend-gep-fold-count-defs
  [defs : (&mut defs (__tl_dyn-array i64))]
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]) : unit
  (for [b (iterator.range 0 (array-length barr))]
    (let
      [instrs : compiler_ir_types.CompilerIrInstrSeq
        (compiler-backend-gep-fold-block-instrs
          (be_state.compiler-backend-global-array-element-shared-view barr b))]
      [n : i64 instrs.len]
      [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
      (for [j (iterator.range 0 n)]
        (let
          [dst : i64
            (let
              [instr
                (be_state.compiler-backend-global-array-element-shared-view
                  slots
                  j)]
              (compiler_ir_types.compiler-ir-instr-dst instr))]
          (if (and (>= dst 0) (< dst (array-length defs)))
            (set! (array-ref defs dst) (+ (array-ref defs dst) 1))
            unit))))))

;; Pass 1: record candidate adds (base, k, block ordinal, position).
(define (compiler-backend-gep-fold-scan-adds
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]
  [defs : (& defs (__tl_dyn-array i64))]
  [cand-base : (&mut cand-base (__tl_dyn-array i64))]
  [cand-k : (&mut cand-k (__tl_dyn-array i64))]
  [cand-block : (&mut cand-block (__tl_dyn-array i64))]
  [cand-pos : (&mut cand-pos (__tl_dyn-array i64))]) : unit
  (for [b (iterator.range 0 (array-length barr))]
    (let
      [instrs : compiler_ir_types.CompilerIrInstrSeq
        (compiler-backend-gep-fold-block-instrs
          (be_state.compiler-backend-global-array-element-shared-view barr b))]
      [n : i64 instrs.len]
      [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
      (for [j (iterator.range 0 n)]
        (match (be_state.compiler-backend-global-array-element-shared-view
          slots
          j)
          [(BinOp dst op lhs rhs ty)
            ;; GAP9-SUB: `j - k` is `j + (-k)`, the displacement negated
            ;; -- the descending walks the unroller leaves spell their
            ;; first copy's offset as the source's `sub` and the rest as
            ;; adds of negative literals, and only the adds folded. A
            ;; zero offset (the unroller's copy-0 `add j, 0`) folds too:
            ;; it is the identity, and dropping it removes the register
            ;; copy the add cost.
            (if (and
              (compiler-backend-gep-fold-64bit-int? ty)
              (>= dst 0)
              (< dst (array-length cand-base))
              (= (array-ref defs dst) 1))
              (match (compiler-backend-gep-fold-offset-operands op lhs rhs)
                [(Some base k)
                  (when
                    (and
                      (not (= base dst))
                      (< k (be_scalar.compiler-backend-gep-fold-k-bound))
                      (> k (- 0 (be_scalar.compiler-backend-gep-fold-k-bound))))
                    (set! (array-ref cand-base dst) base)
                    (set! (array-ref cand-k dst) k)
                    (set! (array-ref cand-block dst) b)
                    (set! (array-ref cand-pos dst) j))]
                [(No) unit])
              unit)]
          [_ unit])))))

;; Pass 2: count qualifying gep-index uses per candidate and track the last
;; folded gep position; a disqualifying gep-index use kills the candidate.
(define (compiler-backend-gep-fold-scan-geps
  [type-segment-bases : i64]
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]
  [defs : (__tl_dyn-array i64)]
  [cand-base : (&mut cand-base (__tl_dyn-array i64))]
  [cand-k : (& cand-k (__tl_dyn-array i64))]
  [cand-block : (& cand-block (__tl_dyn-array i64))]
  [cand-pos : (& cand-pos (__tl_dyn-array i64))]
  [gep-uses : (&mut gep-uses (__tl_dyn-array i64))]
  [gep-last : (&mut gep-last (__tl_dyn-array i64))]) : unit
  (for [b (iterator.range 0 (array-length barr))]
    (let
      [instrs : compiler_ir_types.CompilerIrInstrSeq
        (compiler-backend-gep-fold-block-instrs
          (be_state.compiler-backend-global-array-element-shared-view barr b))]
      [n : i64 instrs.len]
      [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
      (for [j (iterator.range 0 n)]
        (match (be_state.compiler-backend-global-array-element-shared-view
          slots
          j)
          [(Gep gdst _ offset elem-ty)
            (match offset
              [(Var ov)
                (if (and
                  (>= ov 0)
                  (< ov (array-length cand-base))
                  (>= (array-ref cand-base ov) 0))
                  (let
                    [scale : i64
                      (be_operand.compiler-backend-type-size
                        type-segment-bases
                        elem-ty)]
                    [bdisp : i64 (* (array-ref cand-k ov) scale)]
                    (if (and
                      (= (array-ref cand-block ov) b)
                      (> j (array-ref cand-pos ov))
                      (>= gdst 0)
                      (< gdst (array-length defs))
                      (= (array-ref defs gdst) 1)
                      (> scale 0)
                      (< bdisp (be_scalar.compiler-backend-gep-fold-k-bound))
                      (>
                        bdisp
                        (- 0 (be_scalar.compiler-backend-gep-fold-k-bound))))
                      (begin
                        (set!
                          (array-ref gep-uses ov)
                          (+ (array-ref gep-uses ov) 1))
                        (if (> j (array-ref gep-last ov))
                          (set! (array-ref gep-last ov) j)
                          unit))
                      ;; disqualifying gep-index use: kill the candidate.
                      (set! (array-ref cand-base ov) (- 0 1)))
                    unit)
                  unit)]
              [_ unit])]
          [_ unit])))))

;; True when any instruction in (from, to] defines `var`.
(define (compiler-backend-gep-fold-segment-defines?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [from : i64]
  [to : i64]
  [var : i64]) : bool
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [j : i64 (+ from 1)]
    [found : bool false]
    (while (<= j to)
      (if (=
        (let
          [instr
            (be_state.compiler-backend-global-array-element-shared-view slots j)]
          (compiler_ir_types.compiler-ir-instr-dst instr))
        var)
        (begin
          (set! found true)
          (set! j (+ to 1)))
        (+= j 1)))
    found))

;; Pass 3: totality (every use is a folded gep index), no def of the base
;; inside the (add, last-gep] segment, the base is not address-taken (a store
;; or call through its address redefines it without a direct def), and the
;; base is not itself an elided candidate (two rounds cover the
;; parallel-offset shape; deeper chains conservatively keep their adds).
;; The address-taken scan walks every instruction, so it runs only after the
;; cheap direct-def checks leave at least one candidate.
(define (compiler-backend-gep-fold-validate
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockList)]
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]
  [uses : (__tl_dyn-array i64)]
  [cand-base : (&mut cand-base (__tl_dyn-array i64))]
  [cand-block : (__tl_dyn-array i64)]
  [cand-pos : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [gep-last : (__tl_dyn-array i64)]) : unit
  (let
    [v : i64 0]
    (while (< v (array-length cand-base))
      (if (>= (array-ref cand-base v) 0)
        (if (or
          (= (array-ref gep-uses v) 0)
          (not (= (array-ref uses v) (array-ref gep-uses v)))
          (compiler-backend-gep-fold-segment-defines?
            (compiler-backend-gep-fold-block-instrs
              (be_state.compiler-backend-global-array-element-shared-view
                barr
                (array-ref cand-block v)))
            (array-ref cand-pos v)
            (array-ref gep-last v)
            (array-ref cand-base v)))
          (set! (array-ref cand-base v) (- 0 1))
          unit)
        unit)
      (+= v 1)))
  (if (compiler-backend-gep-fold-any-valid? cand-base)
    (let
      ;; compiler-reg-ineligible-memory is the backend's address-taken owner;
      ;; it also marks Alloc destinations, which is conservatively stronger.
      [address-taken : compiler_liveness.CompilerLiveI64Set
        (compiler_regalloc.compiler-reg-ineligible-memory
          blocks
          (compiler_liveness.compiler-live-set-empty))]
      [v : i64 0]
      (while (< v (array-length cand-base))
        (if (>= (array-ref cand-base v) 0)
          (if (compiler_liveness.compiler-live-set-contains?
            (& address-taken)
            (array-ref cand-base v))
            (set! (array-ref cand-base v) (- 0 1))
            unit)
          unit)
        (+= v 1)))
    unit)
  (for [round (iterator.range 0 2)]
    (let
      [v : i64 0]
      (while (< v (array-length cand-base))
        (if (>= (array-ref cand-base v) 0)
          (let
            [bv : i64 (array-ref cand-base v)]
            (if (and
              (< bv (array-length cand-base))
              (>= (array-ref cand-base bv) 0))
              (set! (array-ref cand-base v) (- 0 1))
              unit))
          unit)
        (+= v 1)))))

(define (compiler-backend-gep-fold-any-valid?
  [cand-base : (& cand-base (__tl_dyn-array i64))]) : bool
  (let
    [v : i64 0]
    [found : bool false]
    (while (< v (array-length cand-base))
      (if (>= (array-ref cand-base v) 0)
        (begin
          (set! found true)
          (set! v (array-length cand-base)))
        (+= v 1)))
    found))

;; Pass 4: rebuild each block with elided adds deleted and folded geps
;; retargeted to the base var; fill the dst -> byte-displacement table.
(define (compiler-backend-gep-fold-record-ordinal!
  [cursor-cell : (&mut cursor-cell (__tl_dyn-array i64))]
  [disp : i64]
  [kind : i64]
  [scale : i64]
  [disp-table : (&mut disp-table (__tl_dyn-array i64))]
  [kind-table : (&mut kind-table (__tl_dyn-array i64))]
  [scale-table : (&mut scale-table (__tl_dyn-array i64))]) : unit
  (let
    [cursor : i64 (array-ref cursor-cell 0)]
    (when
      (< cursor (array-length disp-table))
      (set! (array-ref disp-table cursor) disp)
      (set! (array-ref kind-table cursor) kind)
      (set! (array-ref scale-table cursor) scale)
      (set! (array-ref cursor-cell 0) (+ cursor 1)))))

(define (compiler-backend-gep-fold-rewrite-seq
  [type-segment-bases : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [block-ord : i64]
  [cand-base : (& cand-base (__tl_dyn-array i64))]
  [cand-k : (& cand-k (__tl_dyn-array i64))]
  [cand-block : (& cand-block (__tl_dyn-array i64))]
  [cursor-cell : (&mut cursor-cell (__tl_dyn-array i64))]
  [disp-table : (&mut disp-table (__tl_dyn-array i64))]
  [kind-table : (&mut kind-table (__tl_dyn-array i64))]
  [scale-table : (&mut scale-table (__tl_dyn-array i64))]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [n : i64 instrs.len]
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [out : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
      (__tl_make-array compiler_ir_types.CompilerIrInstr n)]
    [w : i64 0]
    (for [j (iterator.range 0 n)]
      (match (owned_view.compiler-owned-element-view slots j)
        [(BinOp dst _ _ _ _)
          (unless
            (and
              (>= dst 0)
              (< dst (array-length cand-base))
              (>= (array-ref cand-base dst) 0))
            ;; elided offset add: drop it.
            (set!
              (array-ref out w)
              (owned_view.compiler-owned-element-view slots j))
            (+= w 1))]
        [(Gep gdst base offset elem-ty)
          (let
            [scale : i64
              (be_operand.compiler-backend-type-size type-segment-bases elem-ty)]
            (match (& offset)
              [(Var ov)
                (if (and
                  (>= ov 0)
                  (< ov (array-length cand-base))
                  (>= (array-ref cand-base ov) 0)
                  (= (array-ref cand-block ov) block-ord))
                  (begin
                    ;; folded: post-rewrite offset stays a Var (the base
                    ;; counter), so the recorded kind is 1.
                    (compiler-backend-gep-fold-record-ordinal!
                      cursor-cell
                      (* (array-ref cand-k ov) scale)
                      1
                      scale
                      disp-table
                      kind-table
                      scale-table)
                    (set!
                      (array-ref out w)
                      (compiler_ir_types.CompilerIrInstr.Gep
                        gdst
                        base
                        (Var (array-ref cand-base ov))
                        elem-ty))
                    (+= w 1))
                  (begin
                    (compiler-backend-gep-fold-record-ordinal!
                      cursor-cell
                      0
                      1
                      scale
                      disp-table
                      kind-table
                      scale-table)
                    (set!
                      (array-ref out w)
                      (owned_view.compiler-owned-element-view slots j))
                    (+= w 1)))]
              [_
                (compiler-backend-gep-fold-record-ordinal!
                  cursor-cell
                  0
                  (compiler-backend-gep-fold-offset-kind offset)
                  scale
                  disp-table
                  kind-table
                  scale-table)
                (set!
                  (array-ref out w)
                  (owned_view.compiler-owned-element-view slots j))
                (+= w 1)]))]
        [_
          (set!
            (array-ref out w)
            (owned_view.compiler-owned-element-view slots j))
          (+= w 1)]))
    (compiler_ir_types.CompilerIrInstrSeq out w)))

(define (compiler-backend-gep-fold-rewrite-blocks
  [type-segment-bases : i64]
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]
  [cand-base : (__tl_dyn-array i64)]
  [cand-k : (__tl_dyn-array i64)]
  [cand-block : (__tl_dyn-array i64)]
  [disp-table : (&mut disp-table (__tl_dyn-array i64))]
  [kind-table : (&mut kind-table (__tl_dyn-array i64))]
  [scale-table : (&mut scale-table (__tl_dyn-array i64))]) : compiler_ir_types.CompilerIrBlockList
  (let
    [cursor-cell : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [rebuilt : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)
      (__tl_make-array compiler_ir_types.CompilerIrBlock (array-length barr))]
    ;; forward pass keeps the ordinal cursor in walk order
    (for [b (iterator.range 0 (array-length barr))]
      (match (be_state.compiler-backend-global-array-element-shared-view barr b)
        [(Block label instrs)
          (set!
            (array-ref rebuilt b)
            (compiler_ir_types.CompilerIrBlock.Block
              label
              (compiler-backend-gep-fold-rewrite-seq
                type-segment-bases
                instrs
                b
                cand-base
                cand-k
                cand-block
                (&mut cursor-cell)
                disp-table
                kind-table
                scale-table)))]))
    (Array (compiler_ir_types.CompilerIrBlockSeq rebuilt (array-length barr)))))

;; Cheap prescan: a variable-index gep at all? Most functions have none; the
;; full pass only runs when one exists.
(define (compiler-backend-gep-fold-blocks-have-candidate?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (match blocks
    [(Array seq) (compiler-backend-gep-fold-block-seq-has-candidate? seq)]))

(define (compiler-backend-gep-fold-block-seq-has-candidate?
  [blocks : compiler_ir_types.CompilerIrBlockSeq]) : bool
  (let
    [count : i64 (compiler_ir_types.compiler-ir-block-seq-count blocks)]
    [b : i64 0]
    [found : bool false]
    (while (and (< b count) (not found))
      (let
        [instrs : compiler_ir_types.CompilerIrInstrSeq
          (compiler-backend-gep-fold-block-instrs
            (compiler_ir_types.compiler-ir-block-seq-ref blocks b))]
        [n : i64 instrs.len]
        [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
          instrs.slots]
        [j : i64 0]
        (while (and (< j n) (not found))
          (match (owned_view.compiler-owned-element-view slots j)
            [(Gep _ _ offset _)
              (match offset
                [(Var _) (set! found true)]
                [_ unit])]
            [_ unit])
          (+= j 1)))
      (+= b 1))
    found))

;; Entry: returns the (possibly rewritten) blocks and installs the
;; per-function displacement table; when nothing folds the input list is
;; returned unchanged and the table stays disabled.
(define (compiler-backend-gep-fold-blocks
  [function-state : be_state.CompilerBackendFunctionState]
  [type-segment-bases : i64]
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (compiler-backend-gep-fold-disable! function-state)
  (if (or
    (<= vars 0)
    (not
      (compiler-backend-gep-fold-blocks-have-candidate?
        (be_state.compiler-backend-global-shared-view blocks))))
    blocks
    (let
      [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)
        (compiler-backend-gep-fold-block-array
          (be_state.compiler-backend-global-shared-view blocks))]
      [defs : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
      [uses : (__tl_dyn-array i64)
        (compiler-backend-function-use-counts
          vars
          (be_state.compiler-backend-global-shared-view blocks))]
      [cand-base : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
      [cand-k : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
      [cand-block : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
      [cand-pos : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
      [gep-uses : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
      [gep-last : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
      (compiler-backend-gep-fold-count-defs
        (&mut defs)
        (be_state.compiler-backend-global-shared-view barr))
      (for [v (iterator.range 0 vars)]
        (set! (array-ref cand-base v) (- 0 1)))
      (compiler-backend-gep-fold-scan-adds
        (be_state.compiler-backend-global-shared-view barr)
        defs
        (&mut cand-base)
        (&mut cand-k)
        (&mut cand-block)
        (&mut cand-pos))
      (compiler-backend-gep-fold-scan-geps
        type-segment-bases
        (be_state.compiler-backend-global-shared-view barr)
        defs
        (&mut cand-base)
        cand-k
        cand-block
        cand-pos
        (&mut gep-uses)
        (&mut gep-last))
      (compiler-backend-gep-fold-validate
        (& blocks)
        (be_state.compiler-backend-global-shared-view barr)
        uses
        (&mut cand-base)
        (be_state.compiler-backend-global-shared-view cand-block)
        cand-pos
        gep-uses
        gep-last)
      (if (compiler-backend-gep-fold-any-valid? cand-base)
        (let
          [gep-count : i64
            (compiler-backend-gep-fold-count-geps
              (be_state.compiler-backend-global-shared-view barr))]
          [disp-table : (__tl_dyn-array i64) (__tl_make-array i64 gep-count)]
          [kind-table : (__tl_dyn-array i64) (__tl_make-array i64 gep-count)]
          [scale-table : (__tl_dyn-array i64) (__tl_make-array i64 gep-count)]
          [out : compiler_ir_types.CompilerIrBlockList
            (compiler-backend-gep-fold-rewrite-blocks
              type-segment-bases
              barr
              cand-base
              cand-k
              cand-block
              (&mut disp-table)
              (&mut kind-table)
              (&mut scale-table))]
          (be_state.compiler-backend-function-state-set-i64-array!
            function-state
            be_state.compiler-backend-function-i64-array-gep-fold-disp-table
            disp-table)
          (be_state.compiler-backend-function-state-set-i64-array!
            function-state
            be_state.compiler-backend-function-i64-array-gep-fold-kind-table
            kind-table)
          (be_state.compiler-backend-function-state-set-i64-array!
            function-state
            be_state.compiler-backend-function-i64-array-gep-fold-scale-table
            scale-table)
          (be_state.compiler-backend-function-state-set-i64!
            function-state
            be_state.compiler-backend-function-i64-gep-fold-cursor
            0)
          (be_state.compiler-backend-function-state-set-bool!
            function-state
            be_state.compiler-backend-function-bool-gep-fold-drift
            false)
          (be_state.compiler-backend-function-state-set-bool!
            function-state
            be_state.compiler-backend-function-bool-gep-fold-ready
            true)
          out)
        blocks))))

;; ---------------------------------------------------------------------------
;; #block-placement: IR loop rotation, immediately before emission.
;;
;; `compiler-backend-emit-blocks-into` walks the CompilerIrBlockList in order
;; and hands every block the NEXT list entry as its fall-through, and
;; `compiler-backend-emit-branch-jumps` already inverts a `jcc` only to match an
;; order it did not choose.  Layout therefore IS list order, and this pass is
;; the one place that chooses it.  It runs on the final post-coloring list, so
;; every later view -- scavenge intervals, const-hoist, #jump-forward, phi
;; targets, the peephole's layout-next reasoning -- is derived from the order
;; actually emitted.
;;
;; LOOP ROTATION, LLVM's `MachineBlockPlacement::rotateLoop`
;; (llvm/lib/CodeGen/MachineBlockPlacement.cpp).  Each natural loop's
;; contiguous run is rotated so its EXITING block is last -- LLVM's
;; `std::rotate(LoopChain.begin(), std::next(ExitIt), LoopChain.end())` -- which
;; turns
;;
;;     H: cmp r12,r14 / jge exit             body ...
;;        body ...                   ->      add r12,1
;;        add r12,1                          L: cmp r12,r14 / jl body
;;        jmp H
;;
;; i.e. the latch falls through into the exit test and the back edge becomes a
;; conditional jump with no unconditional companion.  The rotation is what makes
;; the wrap-around adjacency real: old bottom -> old top, which is exactly the
;; back edge.  Declined when the header already has a viable fall-through
;; predecessor and the current bottom already exits -- LLVM's
;; `ViableTopFallthrough` test -- because that loop is already bottom-tested and
;; rotating it would only move its jumps around.
;;
;; The loop is then entered by one forward jump from the preheader, paid once
;; per entry rather than once per iteration; `compiler-backend-placement-
;; counting-loop?` below is the admission that keeps that trade profitable.
;;
;; The entry block stays first unconditionally: the prologue, the Windows SEH
;; directives that describe it, and the shrink-wrap splice all anchor there.
;; Nothing but a loop's own run ever moves, so every other block keeps its
;; original neighbours and a function with no rotatable loop comes out
;; byte-identical.
;;
;; A block that does not end in a terminator falls through to whatever the list
;; puts next, so its successor is named nowhere and moving either half would
;; lose the edge.  Such a function is declined whole rather than glued back
;; together -- every IR builder terminates its blocks, so this is a fail-closed
;; check and not a case to optimize.
;;
;; The GAP9 gep displacement table (`compiler-backend-gep-fold-*`) is a flat
;; array RECORDED in list order and CONSUMED by a cursor in emission order, so
;; a permutation has to carry it.  One entry per `Gep` instruction, in block
;; order, is exactly the invariant `compiler-backend-gep-fold-rewrite-seq`
;; maintains -- all three of its arms record one -- so the table is
;; re-concatenated per block alongside the blocks.  A gep count that disagrees
;; with the table length would mean a pass after the fold cloned a gep-bearing
;; block, and the function is declined rather than emitted against a shifted
;; table.
;;
;; Greedy CHAIN BUILDING, LLVM's `buildChain` / `selectBestSuccessor` with a
;; static HotProb, over this same state is a loss.  Appending the successor the
;; Ball & Larus set predicts taken moves a loop's latch to wherever the
;; predicted path reaches it, which destroys the "latch last" property the front
;; end's structured lowering already gives every loop -- and that property is
;; the one rotation needs.  The cold-arm out-lining it would have bought is what
;; the post-emission text pass `#block-layout` (mode bit 2) already does, from
;; the same predictor, without disturbing the loops.
;;
;; 0 disables the pass, 1 enables it.
(define compiler-backend-placement-mode : i64
  1)

;; Everything the layout reads about one function: the CFG in index space, the
;; loop tree, and the order under construction.
(defstruct CompilerBackendPlacement
  (count i64)
  (term-kind (__tl_dyn-array i64))
  (succ-off (__tl_dyn-array i64))
  (succ-buf (__tl_dyn-array i64))
  ;; innermost loop header of each block, or -1: what keeps a rotation's cut
  ;; point out of a nested loop's run
  (inner (__tl_dyn-array i64))
  (order (__tl_dyn-array i64))
  (pos (__tl_dyn-array i64))
  (scratch (__tl_dyn-array i64))
  ;; one loop's blocks, header first, copied out of the nest's shared member
  ;; buffer before the next stamped walk overwrites it
  (members (__tl_dyn-array i64))
  ;; Function-local dense slots for raw IR variable identities. Derived
  ;; symbols occupy a fixed high domain, so their raw values must never size or
  ;; index the stamp arrays below.
  (vars backend_label_i64_map.Map)
  ;; per-variable stamps for the trip-count admission
  (variant (__tl_dyn-array i64))
  (iv (__tl_dyn-array i64))
  (phis (__tl_dyn-array i64)))

(defstruct CompilerBackendPlacementVars
  (slots backend_label_i64_map.Map)
  (count i64))

(defenum CompilerBackendMaybePlacement
  (No)
  (Some CompilerBackendPlacement))

;; Terminator classes the layout needs to tell apart: 0 = none (the block falls
;; through to its list successor and cannot be moved), 1 = Jump, 2 = two-arm
;; branch, 3 = switch, 4 = leaves the function, 5 = a Jump that is the block's
;; only instruction -- a block that can emit nothing, so whatever precedes it
;; may in effect fall through past it to its target.
(define (compiler-backend-placement-term-kind
  [instrs : (& instrs compiler_ir_types.CompilerIrInstrSeq)]) : i64
  (let
    [n : i64 instrs.len]
    (if (= n 0)
      0
      (match (array-ref instrs.slots (- n 1))
        [(Jump _)
          (if (= n 1)
            5
            1)]
        [(or (Branch _ _ _) (TotalEnumBranch _ _ _)) 2]
        [(or (Switch _ _ _ _) (TotalEnumSwitch _ _ _ _ _)) 3]
        [(or (Return _) (TailCall _ _ _) (TailCallIndirect _ _ _)) 4]
        [_ 0]))))

(define (compiler-backend-placement-index-of
  [ids : (& ids backend_label_i64_map.Map)]
  [label : i64]) : i64
  (match (backend_label_i64_map.get (& ids) label)
    [(LookupFound q) q]
    [(LookupMissing) (- 0 1)]))

(define (compiler-backend-placement-fill!
  [slots : (__tl_dyn-array i64)]
  [value : i64]) : unit
  (let
    [n : i64 (array-length slots)]
    (for [i (iterator.range 0 n)]
      (set! (array-ref slots i) value))))

;; Upper bound on successor edges, so the flat CSR is allocated once.
(define (compiler-backend-placement-succ-bound
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]) : i64
  (let
    [n : i64 (compiler_ir_types.compiler-ir-block-seq-count seq)]
    [total : i64 0]
    (for [i (iterator.range 0 n)]
      (match (compiler_ir_types.compiler-ir-block-seq-borrow seq i)
        [(Block _ instrs)
          (if (= instrs.len 0)
            unit
            (match (owned_view.compiler-owned-element-view
              instrs.slots
              (- instrs.len 1))
              [(Jump _) (+= total 1)]
              [(or (Branch _ _ _) (TotalEnumBranch _ _ _)) (+= total 2)]
              [(Switch _ _ cases _) (+= total (+ cases.len 2))]
              [(TotalEnumSwitch _ _ cases _ _) (+= total (+ cases.len 3))]
              [_ unit]))]))
    (+ total 1)))

(define (compiler-backend-placement-push-succ!
  [buf : (&mut buf (__tl_dyn-array i64))]
  [write : i64]
  [target : i64]) : i64
  (if (< target 0)
    write
    (begin
      (set! (array-ref buf write) target)
      (+ write 1))))

(define (compiler-backend-placement-push-cases!
  [ids : (& ids backend_label_i64_map.Map)]
  [buf : (&mut buf (__tl_dyn-array i64))]
  [write : i64]
  [cases : compiler_ir_types.CompilerIrSwitchCaseSeq]) : i64
  (let
    [w : i64 write]
    (for [i (iterator.range 0 cases.len)]
      (match (compiler_ir_types.compiler-ir-switch-case-seq-borrow cases i)
        [(Case _ label)
          (set!
            w
            (compiler-backend-placement-push-succ!
              buf
              w
              (compiler-backend-placement-index-of ids label)))]))
    w))

;; Fill the successor CSR and the terminator classes, reading targets straight
;; off the terminators so nothing is allocated per block. Returns
;;   -1  a backward edge exists, but an implicit fallthrough prevents rotation;
;;    0  no edge runs backward in list order, so the function closes no cycle
;;       and this pass has nothing to rotate -- the answer that lets the common
;;       loop-free function stop before the loop nest is ever built;
;;    1  some edge does.
(define (compiler-backend-placement-fill-succ!
  [term-kind : (&mut term-kind (__tl_dyn-array i64))]
  [succ-off : (&mut succ-off (__tl_dyn-array i64))]
  [succ-buf : (&mut succ-buf (__tl_dyn-array i64))]
  [ids : backend_label_i64_map.Map]
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]) : i64
  (let
    [n : i64 (compiler_ir_types.compiler-ir-block-seq-count seq)]
    [write : i64 0]
    [ok : bool true]
    [closes? : bool false]
    (for [i (iterator.range 0 n)]
      (set! (array-ref succ-off i) write)
      (match (compiler_ir_types.compiler-ir-block-seq-ref seq i)
        [(Block _ instrs)
          (let
            [kind : i64 (compiler-backend-placement-term-kind instrs)]
            (set! (array-ref term-kind i) kind)
            (if (= kind 0)
              (set! ok false)
              (match (owned_view.compiler-owned-element-view
                instrs.slots
                (- instrs.len 1))
                [(Jump target)
                  (set!
                    write
                    (compiler-backend-placement-push-succ!
                      succ-buf
                      write
                      (compiler-backend-placement-index-of ids target)))]
                [(or (Branch _ true-label false-label)
                     (TotalEnumBranch _ true-label false-label))
                  (set!
                    write
                    (compiler-backend-placement-push-succ!
                      succ-buf
                      write
                      (compiler-backend-placement-index-of ids true-label)))
                  (set!
                    write
                    (compiler-backend-placement-push-succ!
                      succ-buf
                      write
                      (compiler-backend-placement-index-of ids false-label)))]
                [(Switch _ _ cases default-label)
                  (set!
                    write
                    (compiler-backend-placement-push-succ!
                      succ-buf
                      write
                      (compiler-backend-placement-index-of ids default-label)))
                  (set!
                    write
                    (compiler-backend-placement-push-cases!
                      ids
                      succ-buf
                      write
                      cases))]
                [(TotalEnumSwitch _ _ cases default-label trap-label)
                  (set!
                    write
                    (compiler-backend-placement-push-succ!
                      succ-buf
                      write
                      (compiler-backend-placement-index-of ids default-label)))
                  (set!
                    write
                    (compiler-backend-placement-push-succ!
                      succ-buf
                      write
                      (compiler-backend-placement-index-of ids trap-label)))
                  (set!
                    write
                    (compiler-backend-placement-push-cases!
                      ids
                      succ-buf
                      write
                      cases))]
                [_ unit])))])
      (for [edge (iterator.range (array-ref succ-off i) write)]
        (if (<= (array-ref succ-buf edge) i)
          (set! closes? true)
          unit)))
    (set! (array-ref succ-off n) write)
    (if closes?
      (if ok
        1
        -1)
      0)))

;; The condition of the two-arm branch that ends this block.
(define (compiler-backend-placement-branch-cond
  [instrs : (& instrs compiler_ir_types.CompilerIrInstrSeq)]) : compiler_ir_types.CompilerIrValue
  (if (= instrs.len 0)
    (Unit)
    ;; A shallow view: the block keeps owning its instructions.
    (match (owned_view.compiler-owned-element-view
      (& instrs.slots)
      (- instrs.len 1))
      [(Branch cond _ _) cond]
      [(TotalEnumBranch cond _ _) cond]
      [_ (Unit)])))

;; Headers ordered by loop size ascending, so the loop tree is filled innermost
;; first and every block lands on the smallest loop that contains it.
(define (compiler-backend-placement-sort-headers!
  [sorted : (&mut sorted (__tl_dyn-array i64))]
  [size : (__tl_dyn-array i64)]
  [count : i64]) : unit
  (for [i (iterator.range 1 count)]
    (let
      [h : i64 (array-ref sorted i)]
      [k : i64 (- i 1)]
      (while (and
        (>= k 0)
        (> (array-ref size (array-ref sorted k)) (array-ref size h)))
        (set! (array-ref sorted (+ k 1)) (array-ref sorted k))
        (-= k 1))
      (set! (array-ref sorted (+ k 1)) h))))

;; Two stamped walks per loop: the first sizes it so the headers can be sorted,
;; the second -- innermost first -- gives every block the smallest loop that
;; owns it.
(define (compiler-backend-placement-loop-info!
  [st : CompilerBackendPlacement]
  [nest : compiler_regalloc.CompilerRegLoopNest]
  [sorted : (&mut sorted (__tl_dyn-array i64))]
  [size : (__tl_dyn-array i64)]
  [header-count : i64]) : unit
  (let
    [generation : i64 0]
    (for [i (iterator.range 0 header-count)]
      (let
        [h : i64 (compiler_regalloc.compiler-reg-loop-nest-header (& nest) i)]
        (set! (array-ref sorted i) h)
        (+= generation 1)
        (set!
          (array-ref size h)
          (+
            (compiler_regalloc.compiler-reg-loop-nest-header-members!
              nest
              h
              generation)
            1))))
    (compiler-backend-placement-sort-headers! sorted size header-count)
    (for [i (iterator.range 0 header-count)]
      (let
        [h : i64 (array-ref sorted i)]
        (+= generation 1)
        (let
          [total : i64
            (compiler_regalloc.compiler-reg-loop-nest-header-members!
              nest
              h
              generation)]
          (if (< (array-ref st.inner h) 0)
            (set! (array-ref st.inner h) h)
            unit)
          (for [m (iterator.range 0 total)]
            (let
              [block : i64 (array-ref nest.members m)]
              (if (and
                (>= block 0)
                (< block st.count)
                (< (array-ref st.inner block) 0))
                (set! (array-ref st.inner block) h)
                unit))))))))

;; Geps in one block. The gep-fold rewrite records exactly one displacement
;; ordinal per Gep, whether or not the offset folded, so this count is the
;; block's slice of the table.
(define (compiler-backend-placement-gep-count
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (let
    [n : i64 instrs.len]
    [total : i64 0]
    (for [i (iterator.range 0 n)]
      (match (owned_view.compiler-owned-element-view instrs.slots i)
        [(Gep _ _ _ _) (+= total 1)]
        [_ unit]))
    total))

;; ---------------------------------------------------------------------------
;; Trip-count admission for rotation.
;;
;; Rotation trades ONE jump per loop ENTRY -- the preheader now jumps to a
;; header that sits at the bottom -- for one per LATCH execution, where the back
;; edge becomes a fall-through.  Writing K for header executions per entry, the
;; emitted-instruction delta is `2 - K`: a loop whose body runs more than about
;; twice per entry wins, and one that usually falls straight back out loses
;; exactly once per call.  A character scan runs many trips and wins; a hash
;; probe or a `n = next[n]` bucket walk usually exits within a trip or two and
;; loses.
;;
;; With no profile the trip count has to be read off the loop's SHAPE, and the
;; shape that separates the two groups is the classic one.  A COUNTING loop --
;; one whose exit test compares an affine induction variable against a
;; loop-invariant bound -- runs to its bound.  A SEARCH loop -- one whose exit
;; is decided by data it loads or computes each trip -- stops as soon as it
;; finds what it wants, which for a hash probe or a bucket chain is the first
;; test.  Rotation is admitted only for a loop with a counting exit.
;;
;; The recognizer is deliberately small:
;;   * every variable defined inside the loop is VARIANT and everything else --
;;     constants, parameters, values computed above the loop -- INVARIANT;
;;   * a header phi that some in-loop `add`/`sub` combines with an invariant is
;;     an INDUCTION VARIABLE, and so is anything built from one by another
;;     `add`/`sub` against an invariant, which is what the `i + 6 <= limit`
;;     bound test of a lookahead scan looks like;
;;   * the loop qualifies when some EXITING block's branch compares an
;;     induction variable against an invariant.
;; An instruction whose destination this pass cannot name -- the vector and
;; SPMD payload forms -- makes its loop decline rather than guess.
;; -1: defines no variable. -2: defines one this pass cannot name.
(define (compiler-backend-placement-instr-dst
  [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match (& instr)
    ;; A TailCall's callee and a Store's global are symbol ids; this pass reads
    ;; them as destinations.
    [(or (TailCall name _ _) (Store name _ _)) name]
    [(or (StoreOwned _ _ _) (VectorBinOp _) (VectorPrefix _) (VectorCompare _)
         (Select _) (VectorStore _) (PredicatedStore _) (PredicatedLoad _)
         (GatherLoad _) (VectorShuffle _) (CallCAbiStoreResult _)
         (CallIndirectCAbiStoreResult _) (SpmdCall _))
      (- 0 2)]
    [_ (compiler_ir_types.compiler-ir-instr-dst instr)]))

;; Assign every destination this pass can name a function-local dense slot.
;; Indexing the stamp arrays by raw variable would make an IR-owned symbol in
;; the fixed high namespace reserve a vast array for a function containing only
;; a handful of variables. A value absent here is a parameter (or otherwise has
;; no defining instruction), so it classifies as invariant without depending on
;; the numeric identity range.
(define (compiler-backend-placement-vars
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]) : CompilerBackendPlacementVars
  (let
    [n : i64 (compiler_ir_types.compiler-ir-block-seq-count seq)]
    [out : CompilerBackendPlacementVars
      (CompilerBackendPlacementVars
        (backend_label_i64_map.with-capacity
          (compiler_regalloc.compiler-reg-bits-map-capacity n))
        0)]
    (for [i (iterator.range 0 n)]
      (match (compiler_ir_types.compiler-ir-block-seq-borrow seq i)
        [(Block _ instrs)
          (for [k (iterator.range 0 instrs.len)]
            (let
              [dst : i64
                (compiler-backend-placement-instr-dst
                  (be_state.compiler-backend-global-array-element-shared-view
                    instrs.slots
                    k))]
              (when
                (>= dst 0)
                (match (backend_label_i64_map.get (& out.slots) dst)
                  [(LookupFound _) unit]
                  [(LookupMissing)
                    (backend_label_i64_map.insert-ref!
                      (&mut out.slots)
                      dst
                      out.count)
                    (+= out.count 1)]))))]))
    out))

(define (compiler-backend-placement-var-slot
  [st : CompilerBackendPlacement]
  [variable : i64]) : i64
  (match (backend_label_i64_map.get (& st.vars) variable)
    [(LookupFound slot) slot]
    [(LookupMissing) (- 0 1)]))

(define (compiler-backend-placement-stamped?
  [st : CompilerBackendPlacement]
  [table : (__tl_dyn-array i64)]
  [variable : i64]
  [generation : i64]) : bool
  (let
    [slot : i64 (compiler-backend-placement-var-slot st variable)]
    (and
      (>= slot 0)
      (< slot (array-length table))
      (= (array-ref table slot) generation))))

(define (compiler-backend-placement-stamp!
  [st : CompilerBackendPlacement]
  [table : (__tl_dyn-array i64)]
  [variable : i64]
  [generation : i64]) : unit
  (let
    [slot : i64 (compiler-backend-placement-var-slot st variable)]
    (if (and (>= slot 0) (< slot (array-length table)))
      (set! (array-ref table slot) generation)
      unit)))

(define (compiler-backend-placement-stamp-value!
  [st : CompilerBackendPlacement]
  [table : (__tl_dyn-array i64)]
  [value : compiler_ir_types.CompilerIrValue]
  [generation : i64]) : unit
  (match value
    [(Var v) (compiler-backend-placement-stamp! st table v generation)]
    [_ unit]))

;; A value nothing inside the loop writes. Constants qualify; a variable this
;; pass could not name does not.
(define (compiler-backend-placement-invariant?
  [st : CompilerBackendPlacement]
  [variant : (& variant (__tl_dyn-array i64))]
  [generation : i64]
  [value : compiler_ir_types.CompilerIrValue]) : bool
  (match value
    [(Var v)
      (let
        [slot : i64 (compiler-backend-placement-var-slot st v)]
        (if (and (>= slot 0) (< slot (array-length variant)))
          (not (= (array-ref variant slot) generation))
          ;; No instruction in the function defines it: a PARAMETER, which is
          ;; the usual spelling of a counting loop's bound.
          true))]
    [_ true]))

(define (compiler-backend-placement-marked?
  [st : CompilerBackendPlacement]
  [table : (__tl_dyn-array i64)]
  [generation : i64]
  [value : compiler_ir_types.CompilerIrValue]) : bool
  (match value
    [(Var v) (compiler-backend-placement-stamped? st table v generation)]
    [_ false]))

(define (compiler-backend-placement-affine-op?
  [op : (& op compiler_ir_types.CompilerIrBinOp)]) : bool
  (match op
    [(or (Add) (Sub)) true]
    [_ false]))

(define (compiler-backend-placement-commutes?
  [op : compiler_ir_types.CompilerIrBinOp]) : bool
  (match op
    [(Add) true]
    [_ false]))

;; Stamp every variable the loop writes. False when some instruction defines a
;; destination this pass cannot name.
(define (compiler-backend-placement-mark-variant!
  [st : CompilerBackendPlacement]
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]
  [total : i64]
  [generation : i64]) : bool
  (let
    [ok : bool true]
    (for [i (iterator.range 0 total)]
      (match (compiler_ir_types.compiler-ir-block-seq-borrow
        seq
        (array-ref st.members i))
        [(Block _ instrs)
          (for [k (iterator.range 0 instrs.len)]
            (let
              [dst : i64
                (compiler-backend-placement-instr-dst
                  (be_state.compiler-backend-global-array-element-shared-view
                    instrs.slots
                    k))]
              (if (= dst (- 0 2))
                (set! ok false)
                (compiler-backend-placement-stamp!
                  (be_state.compiler-backend-global-shared-view st)
                  (be_state.compiler-backend-global-shared-view st.variant)
                  dst
                  generation))))]))
    ok))

;; One `add`/`sub` against an invariant: it names a header phi as an induction
;; variable and carries the induction stamp to its own result.
(define (compiler-backend-placement-induction-step!
  [st : CompilerBackendPlacement]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [generation : i64]) : unit
  (if (not (compiler-backend-placement-affine-op? op))
    unit
    (let
      [swap? : bool (compiler-backend-placement-commutes? op)]
      (when
        (and
          (compiler-backend-placement-marked?
            (be_state.compiler-backend-global-shared-view st)
            (be_state.compiler-backend-global-shared-view st.phis)
            generation
            (be_state.compiler-backend-global-shared-view lhs))
          (compiler-backend-placement-invariant?
            (be_state.compiler-backend-global-shared-view st)
            st.variant
            generation
            (be_state.compiler-backend-global-shared-view rhs)))
        (compiler-backend-placement-stamp-value!
          (be_state.compiler-backend-global-shared-view st)
          (be_state.compiler-backend-global-shared-view st.iv)
          (be_state.compiler-backend-global-shared-view lhs)
          generation)
        (compiler-backend-placement-stamp!
          (be_state.compiler-backend-global-shared-view st)
          (be_state.compiler-backend-global-shared-view st.iv)
          dst
          generation))
      (when
        (and
          swap?
          (compiler-backend-placement-marked?
            (be_state.compiler-backend-global-shared-view st)
            (be_state.compiler-backend-global-shared-view st.phis)
            generation
            (be_state.compiler-backend-global-shared-view rhs))
          (compiler-backend-placement-invariant?
            (be_state.compiler-backend-global-shared-view st)
            st.variant
            generation
            (be_state.compiler-backend-global-shared-view lhs)))
        (compiler-backend-placement-stamp-value!
          (be_state.compiler-backend-global-shared-view st)
          (be_state.compiler-backend-global-shared-view st.iv)
          (be_state.compiler-backend-global-shared-view rhs)
          generation)
        (compiler-backend-placement-stamp!
          (be_state.compiler-backend-global-shared-view st)
          (be_state.compiler-backend-global-shared-view st.iv)
          dst
          generation))
      (if (and
        (compiler-backend-placement-marked?
          (be_state.compiler-backend-global-shared-view st)
          (be_state.compiler-backend-global-shared-view st.iv)
          generation
          (be_state.compiler-backend-global-shared-view lhs))
        (compiler-backend-placement-invariant?
          (be_state.compiler-backend-global-shared-view st)
          st.variant
          generation
          (be_state.compiler-backend-global-shared-view rhs)))
        (compiler-backend-placement-stamp!
          (be_state.compiler-backend-global-shared-view st)
          (be_state.compiler-backend-global-shared-view st.iv)
          dst
          generation)
        unit)
      (if (and
        swap?
        (compiler-backend-placement-marked?
          (be_state.compiler-backend-global-shared-view st)
          (be_state.compiler-backend-global-shared-view st.iv)
          generation
          rhs)
        (compiler-backend-placement-invariant?
          (be_state.compiler-backend-global-shared-view st)
          st.variant
          generation
          lhs))
        (compiler-backend-placement-stamp!
          (be_state.compiler-backend-global-shared-view st)
          st.iv
          dst
          generation)
        unit))))

;; Seed the induction set from the header's phis, then close it under
;; `add`/`sub` against an invariant. Two rounds reach a bound expression built
;; from a phi the header defines.
(define (compiler-backend-placement-mark-induction!
  [st : CompilerBackendPlacement]
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]
  [header : i64]
  [total : i64]
  [generation : i64]) : unit
  (match (compiler_ir_types.compiler-ir-block-seq-borrow seq header)
    [(Block _ instrs)
      (for [k (iterator.range 0 instrs.len)]
        (match (owned_view.compiler-owned-element-view instrs.slots k)
          [(Phi dst _ _)
            (compiler-backend-placement-stamp!
              (be_state.compiler-backend-global-shared-view st)
              (be_state.compiler-backend-global-shared-view st.phis)
              dst
              generation)]
          [_ unit]))])
  (for [round (iterator.range 0 2)]
    (for [i (iterator.range 0 total)]
      (match (compiler_ir_types.compiler-ir-block-seq-ref
        seq
        (array-ref st.members i))
        [(Block _ instrs)
          (for [k (iterator.range 0 instrs.len)]
            (match (owned_view.compiler-owned-element-view instrs.slots k)
              [(BinOp dst op lhs rhs _)
                (compiler-backend-placement-induction-step!
                  (be_state.compiler-backend-global-shared-view st)
                  dst
                  op
                  lhs
                  rhs
                  generation)]
              [_ unit]))]))))

;; Does the compare that decides this block's branch read an induction variable
;; against a loop-invariant bound?
(define (compiler-backend-placement-counting-test?
  [st : CompilerBackendPlacement]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [generation : i64]) : bool
  (match (compiler-backend-placement-branch-cond instrs)
    [(Var v)
      (let
        [i : i64 (- instrs.len 2)]
        [found : bool false]
        (while (>= i 0)
          (match (owned_view.compiler-owned-element-view instrs.slots i)
            [(BinOp dst op lhs rhs _)
              (when
                (= dst v)
                (set!
                  found
                  (and
                    (compiler_ir_types.compiler-ir-binop-compare? (& op))
                    (or
                      (and
                        (compiler-backend-placement-marked?
                          (be_state.compiler-backend-global-shared-view st)
                          (be_state.compiler-backend-global-shared-view st.iv)
                          generation
                          (be_state.compiler-backend-global-shared-view lhs))
                        (compiler-backend-placement-invariant?
                          (be_state.compiler-backend-global-shared-view st)
                          st.variant
                          generation
                          (be_state.compiler-backend-global-shared-view rhs)))
                      (and
                        (compiler-backend-placement-marked?
                          (be_state.compiler-backend-global-shared-view st)
                          (be_state.compiler-backend-global-shared-view st.iv)
                          generation
                          rhs)
                        (compiler-backend-placement-invariant?
                          (be_state.compiler-backend-global-shared-view st)
                          st.variant
                          generation
                          lhs)))))
                (set! i 0))]
            [_ unit])
          (-= i 1))
        found)]
    [_ false]))

;; The admission itself: some exiting block of this loop counts.
(define (compiler-backend-placement-counting-loop?
  [st : CompilerBackendPlacement]
  [nest : compiler_regalloc.CompilerRegLoopNest]
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]
  [header : i64]
  [total : i64]
  [generation : i64]) : bool
  (if (not
    (compiler-backend-placement-mark-variant!
      (be_state.compiler-backend-global-shared-view st)
      seq
      total
      generation))
    false
    (begin
      (compiler-backend-placement-mark-induction!
        (be_state.compiler-backend-global-shared-view st)
        seq
        header
        total
        generation)
      (let
        [i : i64 0]
        [found : bool false]
        (while (< i total)
          (let
            [b : i64 (array-ref st.members i)]
            (if (and
              (= (array-ref st.term-kind b) 2)
              (compiler-backend-placement-succ-outside?
                st
                (be_state.compiler-backend-global-shared-view nest)
                b
                generation))
              (match (compiler_ir_types.compiler-ir-block-seq-ref seq b)
                [(Block _ instrs)
                  (when
                    (compiler-backend-placement-counting-test?
                      (be_state.compiler-backend-global-shared-view st)
                      instrs
                      generation)
                    (set! found true)
                    (set! i total))])
              unit)
            (+= i 1)))
        found))))

(define (compiler-backend-placement-succ-outside?
  [st : (& st CompilerBackendPlacement)]
  [nest : compiler_regalloc.CompilerRegLoopNest]
  [b : i64]
  [generation : i64]) : bool
  (let
    [stop : i64 (array-ref st.succ-off (+ b 1))]
    [found : bool false]
    (for [edge (iterator.range (array-ref st.succ-off b) stop)]
      (if (compiler_regalloc.compiler-reg-loop-nest-member?
        nest
        (array-ref st.succ-buf edge)
        generation)
        unit
        (set! found true)))
    found))

(define (compiler-backend-placement-succ-inside?
  [st : (& st CompilerBackendPlacement)]
  [nest : compiler_regalloc.CompilerRegLoopNest]
  [b : i64]
  [generation : i64]) : bool
  (let
    [stop : i64 (array-ref st.succ-off (+ b 1))]
    [found : bool false]
    (for [edge (iterator.range (array-ref st.succ-off b) stop)]
      (if (compiler_regalloc.compiler-reg-loop-nest-member?
        nest
        (array-ref st.succ-buf edge)
        generation)
        (set! found true)
        unit))
    found))

(define (compiler-backend-placement-pred?
  [nest : (& nest compiler_regalloc.CompilerRegLoopNest)]
  [block : i64]
  [candidate : i64]) : bool
  (let
    [stop : i64 (array-ref nest.pred-offsets (+ block 1))]
    [found : bool false]
    (for [edge (iterator.range (array-ref nest.pred-offsets block) stop)]
      (if (= (array-ref nest.pred-sources edge) candidate)
        (set! found true)
        unit))
    found))

;; EXIT SINKING and RETURN-ARM SINKING, the full-speed half of the layout.
;;
;; The front end lowers `(if (>= i n) false (recur ...))` exit arm first, so a
;; loop's early `return` and `break` blocks land INSIDE its run, and the
;; in-loop continuation becomes the taken side of every exit test -- two taken
;; branches per iteration where one is enough:
;;
;;     H:  cmp i,n / jl B             H:  cmp i,n / jge X1
;;     X1: ret                        B:  ... / je X2
;;     B:  ... / jne L        ->      L:  add i,1 / jmp H
;;     X2: ret                        X1: ret
;;     L:  add i,1 / jmp H            X2: ret
;;
;; LLVM's `buildLoopChains` never admits a block outside the loop to the loop's
;; chain. Here the blocks that leave every loop move out of its run: right
;; behind it when the run's bottom block does not fall into what follows it,
;; else to the sink point (`compiler-backend-placement-sink-point`). A GROUP --
;; a maximal run of non-members between two members of one loop -- moves only
;; when
;;   * every block in it is outside every loop (`inner` = -1) and has no
;;     successor in this loop, so it is a pure exit and never a way back in;
;;   * none of it is pinned: the entry block, and the prefix the early-exit
;;     shrink-wrap renders by list index, stay where they are;
;;   * the member before it falls through past the whole group, or not into
;;     it at all, or into its first block as one arm of a two-arm branch whose
;;     other arm is the member after it. That branch then falls into its
;;     in-loop arm; the group's own exits were already explicit jumps (a group
;;     block has no successor in the loop, and the member after it is one); so
;;     no path executes one more instruction than before;
;;   * it is not a one-block arm ending in a jump whose exit test an
;;     unconditional jump enters: #block-layout's tail duplication already
;;     copies such a test and arm into the jumping block, which under a latch
;;     rotates the loop for free.
;; Rotation still sees only runs the front end laid out contiguously: a run
;; that sinking made contiguous is a search loop with early exits, which
;; usually leaves on its first trip and would pay rotation's entry jump.
;;
;; Outside loops the same shape is `test x / jge L / ret / L:` -- a guard's
;; return arm laid out as the fall-through. A RETURN block whose only
;; predecessor is the block before it -- a two-arm branch outside every loop
;; whose other arm is the block after it -- moves to the end when Ball and
;; Larus's heuristics predict it not taken: the opcode heuristic when it speaks,
;; else the return heuristic, which speaks only when the other arm does not
;; leave the function too. Each arm keeps exactly one jump, so only which one is
;; taken changes.
;; This runs only where the returns do not share an epilogue, so every return
;; block is self-contained.
;;
;; Moved blocks keep their relative order; nothing else moves. Size-optimized
;; and non-full builds skip both, because a jump to a moved block may need a
;; longer encoding.
;;
;; Both need every block to end in a terminator, so that every edge is named
;; and any permutation of the list is a layout of the same CFG.
(define (compiler-backend-placement-terminated?
  [term-kind : (& term-kind (__tl_dyn-array i64))]
  [n : i64]) : bool
  (let
    [i : i64 0]
    [ok : bool true]
    (while (< i n)
      (when (= (array-ref term-kind i) 0) (set! ok false) (set! i n))
      (+= i 1))
    ok))

;; Does block `b` name `target` as a successor?
(define (compiler-backend-placement-succ?
  [st : (& st CompilerBackendPlacement)]
  [b : i64]
  [target : i64]) : bool
  (let
    [stop : i64 (array-ref st.succ-off (+ b 1))]
    [found : bool false]
    (for [edge (iterator.range (array-ref st.succ-off b) stop)]
      (when (= (array-ref st.succ-buf edge) target) (set! found true)))
    found))

;; A fall-through from `a` into `into` may be traded for one into `next` only
;; when `a` is a two-arm branch between exactly those two blocks.
(define (compiler-backend-placement-arms?
  [st : (& st CompilerBackendPlacement)]
  [a : i64]
  [into : i64]
  [next : i64]) : bool
  (let
    [off : i64 (array-ref st.succ-off a)]
    (and
      (= (array-ref st.term-kind a) 2)
      (= (- (array-ref st.succ-off (+ a 1)) off) 2)
      (or
        (and
          (= (array-ref st.succ-buf off) into)
          (= (array-ref st.succ-buf (+ off 1)) next))
        (and
          (= (array-ref st.succ-buf off) next)
          (= (array-ref st.succ-buf (+ off 1)) into))))))

;; The first position in [k, limit) that block `x` names as a successor with
;; only jump-only blocks before it -- where `x`, emitted right before position
;; k, may fall through to -- or -1.
(define (compiler-backend-placement-falls-into
  [st : (& st CompilerBackendPlacement)]
  [x : i64]
  [k : i64]
  [limit : i64]) : i64
  (let
    [j : i64 k]
    [out : i64 -1]
    (while (< j limit)
      (let
        [b : i64 (array-ref st.order j)]
        (cond
          [(compiler-backend-placement-succ? st x b)
            (set! out j)
            (set! j limit)]
          [(= (array-ref st.term-kind b) 5) (+= j 1)]
          [else (set! j limit)])))
    out))

;; The first (`low?`) or last position of the run of loop `h`, whose `total`
;; members other than the header the last `header-members!` walk left in the
;; nest's member buffer.
(define (compiler-backend-placement-run-bound
  [st : (& st CompilerBackendPlacement)]
  [nest : (& nest compiler_regalloc.CompilerRegLoopNest)]
  [h : i64]
  [total : i64]
  [low? : bool]) : i64
  (let
    [out : i64 (array-ref st.pos h)]
    (for [m (iterator.range 0 total)]
      (let
        [q : i64 (array-ref st.pos (array-ref nest.members m))]
        (when
          (if low?
            (< q out)
            (> q out))
          (set! out q))))
    out))

;; Where moved blocks go: the very end, or -- when `keep-tail?` says the
;; function restores callee-saved registers, so its returns may share one
;; epilogue emitted after the last block -- before the function's trailing
;; fall-through chain. What precedes that epilogue, and every fall-through on
;; the way there, must stay as it was: the block before it may be the one that
;; falls into it, and #block-layout decides which arm it out-lines from the
;; region a `jmp` to it leaves behind.
;;
;; That chain may end inside a loop's run -- a loop whose bottom block falls
;; into the return, or a later loop the tail chain starts in -- and blocks
;; moved there would split that run. The point then steps up out of every run
;; that contains it: `st.scratch` counts, per position k, the runs [lo, hi]
;; with lo < k <= hi, which are the runs a block placed before position k
;; would land inside. Its walks stamp the generations above `generation-base`.
(define (compiler-backend-placement-sink-point
  [st : (&mut st CompilerBackendPlacement)]
  [nest : (& nest compiler_regalloc.CompilerRegLoopNest)]
  [sorted : (& sorted (__tl_dyn-array i64))]
  [header-count : i64]
  [generation-base : i64]
  [keep-tail? : bool]) : i64
  (if keep-tail?
    (let
      [k : i64 (- st.count 1)]
      [inside : i64 0]
      (while (and
        (> k 1)
        (>=
          (compiler-backend-placement-falls-into
            st
            (array-ref st.order (- k 1))
            k
            st.count)
          0))
        (-= k 1))
      (for [i (iterator.range 0 st.count)]
        (set! (array-ref st.scratch i) 0))
      (for [i (iterator.range 0 header-count)]
        (let
          [h : i64 (array-ref sorted i)]
          [total : i64
            (compiler_regalloc.compiler-reg-loop-nest-header-members!
              nest
              h
              (+ generation-base i 1))]
          [lo : i64 (compiler-backend-placement-run-bound st nest h total true)]
          [hi : i64
            (compiler-backend-placement-run-bound st nest h total false)]
          (when
            (< lo hi)
            (+= (array-ref st.scratch (+ lo 1)) 1)
            (when (< (+ hi 1) st.count) (-= (array-ref st.scratch (+ hi 1)) 1)))))
      (for [i (iterator.range 0 st.count)]
        (+= inside (array-ref st.scratch i))
        (set! (array-ref st.scratch i) inside))
      (while (and (> k 1) (> (array-ref st.scratch k) 0))
        (-= k 1))
      k)
    st.count))

;; Move the `count` blocks at positions [from, from + count) to just before
;; position `dest`, keeping their order and everyone else's. `dest` itself
;; stays the position of the block it named.
(define (compiler-backend-placement-move-before!
  [st : (&mut st CompilerBackendPlacement)]
  [from : i64]
  [count : i64]
  [dest : i64]) : unit
  (let
    [base : i64 (- dest count)]
    (for [k (iterator.range 0 count)]
      (set! (array-ref st.scratch k) (array-ref st.order (+ from k))))
    (for [k (iterator.range (+ from count) dest)]
      (let
        [b : i64 (array-ref st.order k)]
        (set! (array-ref st.order (- k count)) b)
        (set! (array-ref st.pos b) (- k count))))
    (for [k (iterator.range 0 count)]
      (let
        [b : i64 (array-ref st.scratch k)]
        (set! (array-ref st.order (+ base k)) b)
        (set! (array-ref st.pos b) (+ base k))))))

;; Does block `b` have a successor in the loop stamped `generation`?
(define (compiler-backend-placement-enters?
  [st : (& st CompilerBackendPlacement)]
  [nest : (& nest compiler_regalloc.CompilerRegLoopNest)]
  [b : i64]
  [generation : i64]) : bool
  (let
    [stop : i64 (array-ref st.succ-off (+ b 1))]
    [found : bool false]
    (for [edge (iterator.range (array-ref st.succ-off b) stop)]
      (when
        (compiler_regalloc.compiler-reg-loop-nest-member?
          nest
          (array-ref st.succ-buf edge)
          generation)
        (set! found true)))
    found))

;; Does some block reach `target` by an unconditional jump? A jump names one
;; successor, so any jumping predecessor of `target` jumps to it.
(define (compiler-backend-placement-jumped-to?
  [st : (& st CompilerBackendPlacement)]
  [nest : (& nest compiler_regalloc.CompilerRegLoopNest)]
  [target : i64]) : bool
  (let
    [stop : i64 (array-ref nest.pred-offsets (+ target 1))]
    [found : bool false]
    (for [edge (iterator.range (array-ref nest.pred-offsets target) stop)]
      (let
        [kind : i64 (array-ref st.term-kind (array-ref nest.pred-sources edge))]
        (when (or (= kind 1) (= kind 5)) (set! found true))))
    found))

;; The group at positions [start, stop) of loop `generation`: see the rules
;; above.
(define (compiler-backend-placement-sinkable-group?
  [st : (& st CompilerBackendPlacement)]
  [nest : (& nest compiler_regalloc.CompilerRegLoopNest)]
  [start : i64]
  [stop : i64]
  [pinned : i64]
  [dest : i64]
  [keep-tail? : bool]
  [generation : i64]) : bool
  (let
    [before : i64 (array-ref st.order (- start 1))]
    [first : i64 (array-ref st.order start)]
    [first-kind : i64 (array-ref st.term-kind first)]
    ;; A one-block exit arm that ends in a jump -- a Jump, or a return
    ;; through the shared epilogue -- stays when an unconditional jump enters
    ;; its exit test: #block-layout's tail duplication copies test and arm
    ;; into that jump's block (under a latch, a rotation at no entry cost),
    ;; and a test whose arm has gone no longer ends in a jump to copy.
    [copied? : bool
      (and
        (= stop (+ start 1))
        (or (= first-kind 1) (= first-kind 5) (and keep-tail? (= first-kind 4)))
        (compiler-backend-placement-jumped-to? st nest before))]
    [ok : bool (and (>= start pinned) (<= stop dest) (not copied?))]
    [p : i64 start]
    (while (and ok (< p stop))
      (let
        [b : i64 (array-ref st.order p)]
        (when
          (or
            (>= (array-ref st.inner b) 0)
            (compiler-backend-placement-enters? st nest b generation))
          (set! ok false)))
      (+= p 1))
    ;; Where the member before the group falls through to: past the whole
    ;; group (only jump-only blocks in the way) costs nothing once they are
    ;; gone; into its first block is the exit test this pass exists for; any
    ;; deeper landing is declined.
    (let
      [lands : i64
        (compiler-backend-placement-falls-into st before start (+ stop 1))]
      (and
        ok
        (or
          (< lands 0)
          (= lands stop)
          (and
            (= lands start)
            (compiler-backend-placement-arms?
              st
              before
              first
              (array-ref st.order stop))))))))

;; Exit sinking, innermost loops first, so an outer loop sees its inner loops'
;; exits already gone.
(define (compiler-backend-placement-sink-exits!
  [st : (&mut st CompilerBackendPlacement)]
  [nest : (& nest compiler_regalloc.CompilerRegLoopNest)]
  [sorted : (& sorted (__tl_dyn-array i64))]
  [header-count : i64]
  [generation-base : i64]
  [pinned : i64]
  [keep-tail? : bool]) : unit
  (let
    [generation : i64 (+ generation-base header-count)]
    [dest : i64 0]
    (for [i (iterator.range 0 (array-length st.order))]
      (set! (array-ref st.pos (array-ref st.order i)) i))
    (set!
      dest
      (compiler-backend-placement-sink-point
        st
        nest
        sorted
        header-count
        generation-base
        keep-tail?))
    (for [i (iterator.range 0 header-count)]
      (let
        [h : i64 (array-ref sorted i)]
        (+= generation 1)
        (let
          [total : i64
            (compiler_regalloc.compiler-reg-loop-nest-header-members!
              nest
              h
              generation)]
          [lo : i64 (compiler-backend-placement-run-bound st nest h total true)]
          [hi : i64
            (compiler-backend-placement-run-bound st nest h total false)]
          ;; Only a run that ends before the sink point has anywhere to sink
          ;; to: one at or past it is the tail the sink point keeps intact.
          (when
            (< hi dest)
            (let
              [p : i64 (+ lo 1)]
              ;; Exits land right after the loop's run, as LLVM lays them out,
              ;; when the run's bottom block does not fall into what follows
              ;; it; otherwise at the function's sink point. `placed` keeps
              ;; several groups in their order behind the run.
              [after? : bool
                (<
                  (compiler-backend-placement-falls-into
                    st
                    (array-ref st.order hi)
                    (+ hi 1)
                    st.count)
                  0)]
              [placed : i64 0]
              (while (< p hi)
                (if (compiler_regalloc.compiler-reg-loop-nest-member?
                  nest
                  (array-ref st.order p)
                  generation)
                  (+= p 1)
                  (let
                    [stop : i64 p]
                    (while (not
                      (compiler_regalloc.compiler-reg-loop-nest-member?
                        nest
                        (array-ref st.order stop)
                        generation))
                      (+= stop 1))
                    (if (compiler-backend-placement-sinkable-group?
                      st
                      nest
                      p
                      stop
                      pinned
                      dest
                      keep-tail?
                      generation)
                      (begin
                        (compiler-backend-placement-move-before!
                          st
                          p
                          (- stop p)
                          (if after?
                            (+ hi 1 placed)
                            dest))
                        (-= hi (- stop p))
                        (+= placed (- stop p)))
                      (set! p stop))))))))))))

;; Ball and Larus's opcode heuristic for the branch that ends `instrs`: 1 when
;; it predicts the TRUE arm, -1 the FALSE arm, 0 when it says nothing. An
;; equality with a constant fails; a sign test against zero is negative-false.
(define (compiler-backend-placement-opcode-predict
  [instrs : (& instrs compiler_ir_types.CompilerIrInstrSeq)]) : i64
  (match (compiler-backend-placement-branch-cond instrs)
    [(Var v)
      (let
        [i : i64 (- instrs.len 2)]
        [out : i64 0]
        (while (>= i 0)
          (match (owned_view.compiler-owned-element-view instrs.slots i)
            [(BinOp dst op lhs rhs _)
              (when
                (= dst v)
                (let
                  [rhs-const? : bool
                    (match rhs
                      [(or (I64 _) (Bool _) (Char _)) true]
                      [_ false])]
                  [rhs-zero? : bool
                    (match rhs
                      [(I64 k) (= k 0)]
                      [_ false])]
                  [lhs-zero? : bool
                    (match lhs
                      [(I64 k) (= k 0)]
                      [_ false])]
                  (set!
                    out
                    (match op
                      [(Eq)
                        (if rhs-const?
                          -1
                          0)]
                      [(Ne)
                        (if rhs-const?
                          1
                          0)]
                      [(or (Lt) (Le))
                        (cond [rhs-zero? -1] [lhs-zero? 1] [else 0])]
                      [(or (Gt) (Ge))
                        (cond [rhs-zero? 1] [lhs-zero? -1] [else 0])]
                      [_ 0])))
                (set! i 0))]
            ;; Any other definition of the condition is not a compare the
            ;; heuristic can read, and an older BinOp is not what it tests.
            [_
              (when
                (=
                  (compiler_ir_types.compiler-ir-instr-dst
                    (compiler_ir_types.compiler-ir-instr-seq-borrow instrs i))
                  v)
                (set! i 0))])
          (-= i 1))
        out)]
    [_ 0]))

;; Could return-arm sinking move anything in the identity order? Its candidate
;; is a return block after the pinned prefix, between a two-arm branch before it
;; and some block after it. A loop-free function with no such pair is declined
;; before any state is allocated for it.
(define (compiler-backend-placement-guard-return?
  [term-kind : (& term-kind (__tl_dyn-array i64))]
  [n : i64]
  [pinned : i64]) : bool
  (let
    [r : i64
      (if (< pinned 1)
        1
        pinned)]
    [found : bool false]
    (while (< (+ r 1) n)
      (when
        (and (= (array-ref term-kind r) 4) (= (array-ref term-kind (- r 1)) 2))
        (set! found true)
        (set! r n))
      (+= r 1))
    found))

;; Return-arm sinking over the final order. `preds` counts each block's
;; incoming edges. Only for a function whose returns do not share an epilogue
;; (see `compiler-backend-placement-sink-point`): there every return block is
;; self-contained, so moving one to the end moves nothing else's code.
(define (compiler-backend-placement-sink-returns!
  [st : (&mut st CompilerBackendPlacement)]
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]
  [preds : (&mut preds (__tl_dyn-array i64))]
  [pinned : i64]) : unit
  (let
    [n : i64 st.count]
    [dest : i64 n]
    [limit : i64 n]
    [r : i64 pinned]
    (for [edge (iterator.range 0 (array-ref st.succ-off n))]
      (+= (array-ref preds (array-ref st.succ-buf edge)) 1))
    (when (< r 1) (set! r 1))
    (while (< (+ r 1) limit)
      (let
        [b : i64 (array-ref st.order r)]
        [p : i64 (array-ref st.order (- r 1))]
        [next : i64 (array-ref st.order (+ r 1))]
        (if (and
          (= (array-ref st.term-kind b) 4)
          (= (array-ref preds b) 1)
          (< (array-ref st.inner p) 0)
          (compiler-backend-placement-arms? st p b next)
          (match (compiler_ir_types.compiler-ir-block-seq-borrow seq b)
            [(Block _ instrs)
              (match (owned_view.compiler-owned-element-view
                instrs.slots
                (- instrs.len 1))
                [(Return _) true]
                [_ false])])
          (match (compiler_ir_types.compiler-ir-block-seq-borrow seq p)
            [(Block _ instrs)
              (let
                [predict : i64
                  (compiler-backend-placement-opcode-predict instrs)]
                [on-true? : bool
                  (= (array-ref st.succ-buf (array-ref st.succ-off p)) b)]
                (cond
                  [(= predict 0) (not (= (array-ref st.term-kind next) 4))]
                  [on-true? (= predict -1)]
                  [else (= predict 1)]))]))
          (begin
            (compiler-backend-placement-move-before! st r 1 dest)
            (-= limit 1))
          (+= r 1))))))

;; C40 early-return guard flip, all or nothing: every guard of form (a)'s
;; prefix must keep an arm equal to its flipped layout successor (the next
;; guard, or the saving block after the prefix), and the opcode heuristic may
;; predict no guard's other arm -- the early return -- taken. An admitted
;; prefix falls through guard to guard into the saving block, and its bare
;; returns leave the hot path.
(define (compiler-backend-shrinkwrap-flip-admissible?
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockList)]
  [prefix-count : i64]) : bool
  (let
    [seq : compiler_ir_types.CompilerIrBlockSeq
      (compiler_liveness.compiler-live-ir-block-list-to-seq blocks)]
    [ok : bool
      (and
        (> prefix-count 0)
        (< prefix-count (compiler_ir_types.compiler-ir-block-seq-count seq)))]
    [index : i64 0]
    (while (and ok (< index prefix-count))
      (when
        (not
          (be_scalar.compiler-backend-shrinkwrap-bare-return-block?
            (& seq)
            index))
        (match (compiler_ir_types.compiler-ir-block-seq-borrow seq index)
          [(Block _ instrs)
            (set!
              ok
              (and
                (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 2)
                (match (compiler_ir_types.compiler-ir-instr-scalar-fact
                  (compiler_ir_types.compiler-ir-instr-seq-ref instrs 1))
                  [(Branch _ on-true on-false)
                    (match (be_scalar.compiler-backend-shrinkwrap-flip-fallthrough
                      (& seq)
                      index
                      prefix-count)
                      [(Some next)
                        (let
                          [predict : i64
                            (compiler-backend-placement-opcode-predict instrs)]
                          (cond
                            [(= on-false next) (not (= predict 1))]
                            [(= on-true next) (not (= predict -1))]
                            [else false]))]
                      [(No) false])]
                  [_ false])))]))
      (+= index 1))
    ok))

;; `rotateLoop`. Innermost loops first, so an outer rotation moves whole inner
;; runs. Each loop's run is rotated left past its exiting block, which lands
;; that block at the bottom and makes the old bottom -- the latch -- adjacent to
;; the header.
(define (compiler-backend-placement-rotate!
  [st : CompilerBackendPlacement]
  [nest : compiler_regalloc.CompilerRegLoopNest]
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]
  [sorted : (__tl_dyn-array i64)]
  [header-count : i64]
  [generation-base : i64]) : unit
  (let
    [n : i64 st.count]
    [generation : i64 generation-base]
    (for [i (iterator.range 0 n)]
      (set! (array-ref st.pos (array-ref st.order i)) i))
    (for [i (iterator.range 0 header-count)]
      (let
        [h : i64 (array-ref sorted i)]
        (+= generation 1)
        (let
          [total : i64
            (compiler_regalloc.compiler-reg-loop-nest-header-members!
              nest
              h
              generation)]
          [lo : i64 (array-ref st.pos h)]
          [hi : i64 (array-ref st.pos h)]
          ;; The run as the front end laid it out: before this pass the order
          ;; is the identity, so a block's index is its original position.
          [first : i64 h]
          [last : i64 h]
          [exiting : i64 (- 0 1)]
          [span : i64 0]
          [shift : i64 0]
          ;; The nest hands its member list back in one shared buffer, so
          ;; take a copy -- header first -- before anything stamps again.
          (set! (array-ref st.members 0) h)
          (for [m (iterator.range 0 total)]
            (let
              [q : i64 (array-ref st.pos (array-ref nest.members m))]
              (set! (array-ref st.members (+ m 1)) (array-ref nest.members m))
              (when
                (< (array-ref nest.members m) first)
                (set! first (array-ref nest.members m)))
              (when
                (> (array-ref nest.members m) last)
                (set! last (array-ref nest.members m)))
              (if (< q lo)
                (set! lo q)
                unit)
              (if (> q hi)
                (set! hi q)
                unit)))
          ;; Rotate only a run that is contiguous, that is entered at its
          ;; header, that is not the entry block's, and whose trip count
          ;; the counting-loop shape vouches for. A run that only exit
          ;; sinking made contiguous is a search loop with early exits:
          ;; when it also counts (a bounded hash probe) the admission
          ;; cannot tell it from a counting loop, and its usual single
          ;; trip would pay the entry jump, so it keeps its top test.
          (when
            (and
              (= (- (+ hi 1) lo) (+ total 1))
              (= (- (+ last 1) first) (+ total 1))
              (> lo 0)
              (= (array-ref st.order lo) h)
              (compiler-backend-placement-counting-loop?
                (be_state.compiler-backend-global-shared-view st)
                (be_state.compiler-backend-global-shared-view nest)
                seq
                h
                (+ total 1)
                generation))
            ;; The exiting block is the last one whose own innermost
            ;; loop is this one -- so the cut never lands inside a
            ;; nested run -- and which has both a successor that stays
            ;; and one that leaves, so it can sit at the bottom and fall
            ;; out of the loop.
            (for [p (iterator.range lo (+ hi 1))]
              (let
                [b : i64 (array-ref st.order p)]
                (if (and
                  (= (array-ref st.inner b) h)
                  (compiler-backend-placement-succ-inside?
                    st
                    (be_state.compiler-backend-global-shared-view nest)
                    b
                    generation)
                  (compiler-backend-placement-succ-outside?
                    st
                    (be_state.compiler-backend-global-shared-view nest)
                    b
                    generation))
                  (set! exiting p)
                  unit)))
            ;; ViableTopFallthrough: the header already falls through
            ;; from outside and the bottom already exits, so this loop
            ;; is bottom-tested already and rotating only moves its
            ;; jumps around.
            (unless
              (or
                (< exiting 0)
                (= exiting hi)
                (and
                  (compiler-backend-placement-pred?
                    nest
                    h
                    (array-ref st.order (- lo 1)))
                  (compiler-backend-placement-succ-outside?
                    st
                    (be_state.compiler-backend-global-shared-view nest)
                    (array-ref st.order hi)
                    generation)))
              (set! span (- (+ hi 1) lo))
              (set! shift (- (+ exiting 1) lo))
              (for [k (iterator.range 0 span)]
                (set!
                  (array-ref st.scratch k)
                  (array-ref st.order (+ lo (% (+ k shift) span)))))
              (for [k (iterator.range 0 span)]
                (set! (array-ref st.order (+ lo k)) (array-ref st.scratch k))
                (set! (array-ref st.pos (array-ref st.scratch k)) (+ lo k))))))))))

;; Where each block's slice of the gep displacement table starts, and how long
;; the whole table has to be for the permutation to be sound.
(define (compiler-backend-placement-gep-starts!
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]
  [starts : (&mut starts (__tl_dyn-array i64))]) : i64
  (let
    [n : i64 (compiler_ir_types.compiler-ir-block-seq-count seq)]
    [total : i64 0]
    (for [i (iterator.range 0 n)]
      (set! (array-ref starts i) total)
      (match (compiler_ir_types.compiler-ir-block-seq-ref seq i)
        [(Block _ instrs)
          (+= total (compiler-backend-placement-gep-count instrs))]))
    (set! (array-ref starts n) total)
    total))

(define (compiler-backend-placement-permute-table
  [source : (__tl_dyn-array i64)]
  [order : (& order (__tl_dyn-array i64))]
  [starts : (& starts (__tl_dyn-array i64))]
  [n : i64]
  [total : i64]) : (__tl_dyn-array i64)
  (let
    [out : (__tl_dyn-array i64) (__tl_make-array i64 total)]
    [write : i64 0]
    (for [i (iterator.range 0 n)]
      (let
        [b : i64 (array-ref order i)]
        [stop : i64 (array-ref starts (+ b 1))]
        (for [read (iterator.range (array-ref starts b) stop)]
          (set! (array-ref out write) (array-ref source read))
          (+= write 1))))
    out))

(define (compiler-backend-placement-permute-geps!
  [function-state : be_state.CompilerBackendFunctionState]
  [order : (& order (__tl_dyn-array i64))]
  [starts : (__tl_dyn-array i64)]
  [n : i64]
  [total : i64]) : unit
  (be_state.compiler-backend-function-state-set-i64-array!
    function-state
    be_state.compiler-backend-function-i64-array-gep-fold-disp-table
    (compiler-backend-placement-permute-table
      (be_state.compiler-backend-function-state-i64-array
        function-state
        be_state.compiler-backend-function-i64-array-gep-fold-disp-table)
      order
      starts
      n
      total))
  (be_state.compiler-backend-function-state-set-i64-array!
    function-state
    be_state.compiler-backend-function-i64-array-gep-fold-kind-table
    (compiler-backend-placement-permute-table
      (be_state.compiler-backend-function-state-i64-array
        function-state
        be_state.compiler-backend-function-i64-array-gep-fold-kind-table)
      order
      starts
      n
      total))
  (be_state.compiler-backend-function-state-set-i64-array!
    function-state
    be_state.compiler-backend-function-i64-array-gep-fold-scale-table
    (compiler-backend-placement-permute-table
      (be_state.compiler-backend-function-state-i64-array
        function-state
        be_state.compiler-backend-function-i64-array-gep-fold-scale-table)
      order
      starts
      n
      total)))

(define (compiler-backend-placement-identity?
  [order : (& order (__tl_dyn-array i64))]
  [n : i64]) : bool
  (let
    [i : i64 0]
    [same : bool true]
    (while (< i n)
      (unless (= (array-ref order i) i) (set! same false) (set! i n))
      (+= i 1))
    same))

(define (compiler-backend-placement-apply
  [seq : compiler_ir_types.CompilerIrBlockSeq]
  [order : (__tl_dyn-array i64)]
  [n : i64]) : compiler_ir_types.CompilerIrBlockList
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)
      (__tl_make-array compiler_ir_types.CompilerIrBlock n)]
    (for [i (iterator.range 0 n)]
      (set!
        (array-ref slots i)
        (compiler_ir_types.compiler-ir-block-seq-ref seq (array-ref order i))))
    (Array (compiler_ir_types.CompilerIrBlockSeq slots n))))

;; The gep table is sound to permute only when it holds exactly one entry per
;; Gep in the list being laid out. Anything else would mean a pass after the
;; fold cloned a gep-bearing block, and the emitter's cursor would then read a
;; shifted table -- decline the function instead.
(define (compiler-backend-placement-gep-table-permutable?
  [function-state : be_state.CompilerBackendFunctionState]
  [total : i64]) : bool
  (if (not
    (be_state.compiler-backend-function-state-bool?
      function-state
      be_state.compiler-backend-function-bool-gep-fold-ready))
    true
    (=
      total
      (array-length
        (be_state.compiler-backend-function-state-i64-array
          function-state
          be_state.compiler-backend-function-i64-array-gep-fold-disp-table)))))

(define (compiler-backend-placement-state
  [n : i64]
  [term-kind : (__tl_dyn-array i64)]
  [succ-off : (__tl_dyn-array i64)]
  [succ-buf : (__tl_dyn-array i64)]
  [vars : CompilerBackendPlacementVars]) : CompilerBackendPlacement
  (let
    [st : CompilerBackendPlacement
      (CompilerBackendPlacement
        n
        term-kind
        succ-off
        succ-buf
        (__tl_make-array i64 n)
        (__tl_make-array i64 n)
        (__tl_make-array i64 n)
        (__tl_make-array i64 n)
        (__tl_make-array i64 (+ n 1))
        vars.slots
        (__tl_make-array i64 vars.count)
        (__tl_make-array i64 vars.count)
        (__tl_make-array i64 vars.count))]
    (compiler-backend-placement-fill!
      (be_state.compiler-backend-global-shared-view st.inner)
      (- 0 1))
    ;; The three per-variable tables are deliberately NOT filled: the only
    ;; generations that read them come from the rotation walk, which starts
    ;; above `4 * (header-count + 1)` and so can never be the 0 a fresh array
    ;; holds. On the compiler's own large functions that fill would be three
    ;; passes over every variable, per function.
    (for [i (iterator.range 0 n)]
      (set! (array-ref st.order i) i))
    st))

;; Record loop membership and, when permitted, leave the layout in `st.order`.
(define (compiler-backend-placement-plan!
  [st : CompilerBackendPlacement]
  [nest : compiler_regalloc.CompilerRegLoopNest]
  [header-count : i64]
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]
  [rotate? : bool]
  [sink? : bool]
  [pinned : i64]
  [keep-tail? : bool]) : unit
  (let
    [sorted : (__tl_dyn-array i64) (__tl_make-array i64 (+ header-count 1))]
    [size : (__tl_dyn-array i64) (__tl_make-array i64 st.count)]
    (compiler-backend-placement-loop-info!
      (be_state.compiler-backend-global-shared-view st)
      (be_state.compiler-backend-global-shared-view nest)
      (&mut sorted)
      size
      header-count)
    ;; Each walk stamps the nest with its own generations: loop-info! [1, 2h],
    ;; exit sinking (2h, 4h] -- its sink point's spans, then its own walk --
    ;; rotation above 4h.
    (when
      sink?
      (compiler-backend-placement-sink-exits!
        (&mut st)
        (& nest)
        (& sorted)
        header-count
        (* 2 (+ header-count 1))
        pinned
        keep-tail?))
    (when
      rotate?
      (compiler-backend-placement-rotate!
        st
        nest
        seq
        sorted
        header-count
        (* 4 (+ header-count 1))))))

;; The state this pass builds for one block sequence, or `No` when the sequence
;; contains no loops. Shared by the production entry and by the unit
;; tests, which read the chosen order out of `st.order` rather than out of
;; emitted text.
(define (compiler-backend-placement-plan-for-seq
  [seq : compiler_ir_types.CompilerIrBlockSeq]
  [sink? : bool]
  [pinned : i64]
  [keep-tail? : bool]) : CompilerBackendMaybePlacement
  (let
    [n : i64 (compiler_ir_types.compiler-ir-block-seq-count seq)]
    [succ-bound : i64 (compiler-backend-placement-succ-bound seq)]
    (if (= succ-bound 1)
      (No)
      (let
        [term-kind : (__tl_dyn-array i64) (__tl_make-array i64 n)]
        [succ-off : (__tl_dyn-array i64) (__tl_make-array i64 (+ n 1))]
        [succ-buf : (__tl_dyn-array i64) (__tl_make-array i64 succ-bound)]
        [shape : i64
          (compiler-backend-placement-fill-succ!
            (&mut term-kind)
            (&mut succ-off)
            (&mut succ-buf)
            (compiler_regalloc.compiler-reg-loop-depth-block-ids-seq
              seq
              (backend_label_i64_map.with-capacity
                (compiler_regalloc.compiler-reg-bits-map-capacity n))
              0)
            seq)]
        [sinking? : bool
          (and
            sink?
            (= compiler-backend-placement-mode 1)
            (>= n 3)
            (compiler-backend-placement-terminated? (& term-kind) n))]
        ;; No backward edge means no cycle, and most functions are that: stop
        ;; here rather than build a loop nest whose answer is already known.
        ;; Only return-arm sinking has anything to do in such a function, and
        ;; it needs no variable table.
        (if (= shape 0)
          (if (and
            sinking?
            (not keep-tail?)
            (compiler-backend-placement-guard-return? (& term-kind) n pinned))
            (let
              [st : CompilerBackendPlacement
                (compiler-backend-placement-state
                  n
                  term-kind
                  succ-off
                  succ-buf
                  (CompilerBackendPlacementVars
                    (backend_label_i64_map.with-capacity
                      (compiler_regalloc.compiler-reg-bits-map-capacity 0))
                    0))]
              (compiler-backend-placement-sink-returns!
                (&mut st)
                (& seq)
                (&mut (__tl_make-array i64 n))
                pinned)
              (if (compiler-backend-placement-identity? st.order n)
                (No)
                (Some st)))
            (No))
          (let
            [nest : compiler_regalloc.CompilerRegLoopNest
              (compiler_regalloc.compiler-reg-loop-nest-build-seq seq)]
            [header-count : i64
              (compiler_regalloc.compiler-reg-loop-nest-header-count nest)]
            (if (= header-count 0)
              (No)
              (let
                [st : CompilerBackendPlacement
                  (compiler-backend-placement-state
                    n
                    term-kind
                    succ-off
                    succ-buf
                    (compiler-backend-placement-vars seq))]
                (compiler-backend-placement-plan!
                  (be_state.compiler-backend-global-shared-view st)
                  nest
                  header-count
                  (& seq)
                  (and
                    (= compiler-backend-placement-mode 1)
                    (>= n 3)
                    (= shape 1))
                  sinking?
                  pinned
                  keep-tail?)
                (when
                  (and sinking? (not keep-tail?))
                  (compiler-backend-placement-sink-returns!
                    (&mut st)
                    (& seq)
                    (&mut (__tl_make-array i64 n))
                    pinned))
                (Some st)))))))))

;; The nest and the placement order use original block indices. Compact the
;; finished membership array into labels so it also describes the emitted
;; order after a permutation. This array belongs to the function scratch.
(define (compiler-backend-placement-retain-loop-blocks!
  [function-state : be_state.CompilerBackendFunctionState]
  [seq : (& compiler_ir_types.CompilerIrBlockSeq)]
  [inner : (__tl_dyn-array i64)]) : unit
  (let
    [count : i64 0]
    (for [i (iterator.range 0 (array-length inner))]
      (when
        (>= (array-ref inner i) 0)
        (match (compiler_ir_types.compiler-ir-block-seq-borrow seq i)
          [(Block label _)
            (set! (array-ref inner count) label)
            (+= count 1)])))
    (be_state.compiler-backend-function-scratch-set-i64-array!
      function-state
      be_state.compiler-backend-scratch-i64-array-loop-block-labels
      inner)
    (be_state.compiler-backend-function-scratch-set-i64!
      function-state
      be_state.compiler-backend-scratch-i64-loop-block-count
      count)))

;; The pass entry. Returns the input list untouched whenever the layout is the
;; identity or the function declines, so a compile that gains nothing allocates
;; no blocks and rewrites no table.
(define (compiler-backend-placement-blocks
  [function-state : be_state.CompilerBackendFunctionState]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [sink? : bool]
  [pinned : i64]
  [keep-tail? : bool]) : compiler_ir_types.CompilerIrBlockList
  (let
    [dense : compiler_ir_types.CompilerIrBlockList
      (be_state.compiler-backend-global-shared-view blocks)]
    (match dense
      [(Array seq)
        (match (compiler-backend-placement-plan-for-seq
          (be_state.compiler-backend-global-shared-view seq)
          sink?
          pinned
          keep-tail?)
          [(No)
            ;; Frame-layout retries reuse this function's scratch owner.
            (be_state.compiler-backend-function-scratch-set-i64!
              function-state
              be_state.compiler-backend-scratch-i64-loop-block-count
              0)
            blocks]
          [(Some st)
            (let
              [n : i64 st.count]
              (compiler-backend-placement-retain-loop-blocks!
                function-state
                (& seq)
                st.inner)
              (if (compiler-backend-placement-identity? st.order n)
                blocks
                ;; Only a real permutation has to carry the gep displacement
                ;; table, so its walk is paid here and not on every function.
                (let
                  [starts : (__tl_dyn-array i64) (__tl_make-array i64 (+ n 1))]
                  [total : i64
                    (compiler-backend-placement-gep-starts! seq (&mut starts))]
                  (if (not
                    (compiler-backend-placement-gep-table-permutable?
                      function-state
                      total))
                    blocks
                    (begin
                      (if (be_state.compiler-backend-function-state-bool?
                        function-state
                        be_state.compiler-backend-function-bool-gep-fold-ready)
                        (compiler-backend-placement-permute-geps!
                          function-state
                          st.order
                          starts
                          n
                          total)
                        unit)
                      (compiler-backend-placement-apply seq st.order n))))))])])))

;; ---------------------------------------------------------------------------
;; SW-1: general shrink-wrapping -- the prologue at the dominator of the frame's
;; uses, the epilogue at the returns that dominator dominates.
;;
;; Form (a) (`compiler_regalloc.compiler-reg-early-exit-shrinkwrap-function`) is
;; an IR rewrite admitting ONE CFG shape: a prefix of blocks each proven to be a
;; compare+branch on parameters or a bare return.  Anything richer in the prefix
;; -- a global load, a descriptor derivation, a bounds check -- defeats it.
;;
;; Form (b) below is LLVM's rule (llvm/lib/CodeGen/ShrinkWrap.cpp:11-52) applied
;; to the FINAL emitted text of the function, after the register plan, the
;; scavenger, the const-hoist, the peephole owners and the rsp rebase have all
;; run:
;;
;;   U = every emitted block whose text names a callee-saved register, names
;;       %rsp or %rbp (ANY frame reference, including the ones no IR
;;       instruction implies: emergency saves, cycle temps, outgoing stack
;;       arguments, const-hoist slots, scavenged spills), pushes or pops,
;;       contains a `call`, or leaves through a tail `jmp`.
;;   S = the nearest common dominator of U, hoisted out of every loop.
;;
;; The text is the complete evidence.  A frame or callee-saved use that no IR
;; instruction mentions is still a line naming %rsp or %r12, so the analysis
;; cannot miss a user -- which is the property the placement needs, because a
;; block emitted before the prologue that touches the frame is a miscompile,
;; not a lost optimization.  Deriving U from the IR plus the assignment table
;; would have to model every one of those emitter-internal frame consumers.
;;
;; Well-formedness (ShrinkWrap.cpp's "give up when the pair is not
;; well-formed"): S must not be the entry (else nothing changes); every block
;; reachable from S must be dominated by S, so the framed region is
;; single-entry and no bypass path can merge into it before a return; no block
;; outside that region may be in U; and S must not sit inside a loop.  The
;; loop rule is the whole cost model: a block at loop depth 0 executes at most
;; once per activation, so a depth-0 Save can never be hotter than entry and no
;; block-frequency model is needed for the static form.
;;
;; Emission reuses form (a)'s splices unchanged.  The callee-save block and the
;; prologue are spliced at S's label instead of at the function symbol, and
;; every Return outside the framed region emits a bare `ret` -- no pops, no
;; `add rsp`.  Because the analysis runs on the emitted text, the placement is
;; decided by a first emission and applied by a second; the second re-runs the
;; analysis and falls back to entry placement if it does not reproduce the same
;; block, exactly as the three textual splices already fail closed.
;;
;; Windows keeps entry placement: its unwind program describes a fixed entry
;; prologue and the `.seh_*` opcodes may not follow an interior label.  The
;; target-parity gate therefore has to accept a Linux/Windows mismatch for a
;; shrink-wrapped fixture explicitly.
;;
;; Interaction with form (a): form (a) still runs first, as an IR rewrite before
;; allocation.  Where it fires, form (b) sees its saving block as an ordinary
;; bypass block and may sink the prologue FURTHER; where it does not, form (b)
;; runs on the plain CFG.  Both bare-return mechanisms coexist: form (a) marks
;; its returns by label prefix, form (b) by label id.  The red-zone leaf
;; decision is unchanged and takes precedence -- a function whose frame already
;; lives in the red zone has no prologue to move, and form (b) is refused for it
;; so the red zone is never traded away for a placement.
(defstruct CompilerBackendSwbPlan
  (label i64)
  (bare (__tl_dyn-array i64))
  ;; TD-1: byte offsets in the analysed text at which the duplicated tail's
  ;; label suffix is spliced onto a bypass branch operand, and the tail block
  ;; the emitter appends.  Empty when no tail was duplicated.
  (dup-sites (__tl_dyn-array i64))
  (dup-site-count i64)
  (dup-text String))

(define (compiler-backend-swb-no-plan) : CompilerBackendSwbPlan
  (CompilerBackendSwbPlan
    (compiler_ir_types.compiler-ir-label-none)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    0
    ""))

;; A function whose emitted text carries more label nodes than this is not
;; analysed.  The placement is a whole-function dominator computation with a
;; linear label lookup, and the shapes it exists for are small; the cap keeps it
;; off the compile-time critical path for the few very large emitted functions.
(define compiler-backend-swb-node-limit : i64
  384)

;; Not a label: the sentinel that turns the placement off for one function after
;; an applied placement failed to reproduce.
(define compiler-backend-swb-refused : i64
  -2)
(define compiler-backend-swb-flag-frame : i64
  1)
(define compiler-backend-swb-flag-return : i64
  2)
(define compiler-backend-swb-flag-opaque : i64
  4)

;; `.L<name>:` -- the only label shape the emitter produces inside a function.
(define (compiler-backend-swb-label-line?
  [data : (Ptr u8)]
  [start : i64]
  [stop : i64]) : bool
  (and
    (>= (- stop start) 4)
    (= (be_state.compiler-backend-peephole-byte-at data start) 46)
    (= (be_state.compiler-backend-peephole-byte-at data (+ start 1)) 76)
    (= (be_state.compiler-backend-peephole-byte-at data (- stop 1)) 58)))

(define (compiler-backend-swb-count-nodes [text : (& text str)]) : i64
  (let
    [n : i64 (string.string-length text)]
    [data : (Ptr u8)
      (unsafe
        (string-data text))]
    [i : i64 0]
    [count : i64 0]
    (while (< i n)
      (let
        [stop : i64
          (be_operand.compiler-backend-peephole-scan-byte-range data i n 10)]
        (if (compiler-backend-swb-label-line? data i stop)
          (+= count 1)
          unit)
        (set! i (+ stop 1))))
    count))

(define (compiler-backend-swb-count-lines [text : (& text str)]) : i64
  (let
    [n : i64 (string.string-length text)]
    [data : (Ptr u8)
      (unsafe
        (string-data text))]
    [i : i64 0]
    [count : i64 0]
    (while (< i n)
      (set!
        i
        (+ (be_operand.compiler-backend-peephole-scan-byte-range data i n 10) 1))
      (+= count 1))
    count))

;; Label name span [lab-start, lab-end) excludes the trailing colon; the body of
;; a node runs from the line after its label to the label line of the next node.
(define (compiler-backend-swb-collect-nodes!
  [text : (& text str)]
  [lab-start : (&mut lab-start (__tl_dyn-array i64))]
  [lab-end : (&mut lab-end (__tl_dyn-array i64))]
  [body-start : (&mut body-start (__tl_dyn-array i64))]
  [body-end : (&mut body-end (__tl_dyn-array i64))]) : unit
  (let
    [n : i64 (string.string-length text)]
    [data : (Ptr u8)
      (unsafe
        (string-data text))]
    [i : i64 0]
    [k : i64 0]
    (while (< i n)
      (let
        [stop : i64
          (be_operand.compiler-backend-peephole-scan-byte-range data i n 10)]
        (when
          (compiler-backend-swb-label-line? data i stop)
          (if (> k 0)
            (set! (array-ref body-end (- k 1)) i)
            unit)
          (set! (array-ref lab-start k) i)
          (set! (array-ref lab-end k) (- stop 1))
          (set! (array-ref body-start k) (+ stop 1))
          (+= k 1))
        (set! i (+ stop 1))))
    (if (> k 0)
      (set! (array-ref body-end (- k 1)) n)
      unit)))

(define (compiler-backend-swb-span-eq?
  [data : (Ptr u8)]
  [a0 : i64]
  [a1 : i64]
  [b0 : i64]
  [b1 : i64]) : bool
  (if (not (= (- a1 a0) (- b1 b0)))
    false
    (let
      [i : i64 0]
      [len : i64 (- a1 a0)]
      [ok : bool true]
      (while (and ok (< i len))
        (if (=
          (be_state.compiler-backend-peephole-byte-at data (+ a0 i))
          (be_state.compiler-backend-peephole-byte-at data (+ b0 i)))
          (+= i 1)
          (set! ok false)))
      ok)))

(define (compiler-backend-swb-span-eq-text?
  [data : (Ptr u8)]
  [a0 : i64]
  [a1 : i64]
  [needle : (& needle str)]) : bool
  (if (not (= (- a1 a0) (string.string-length needle)))
    false
    (let
      [i : i64 0]
      [len : i64 (- a1 a0)]
      [ok : bool true]
      (while (and ok (< i len))
        (if (=
          (be_state.compiler-backend-peephole-byte-at data (+ a0 i))
          (cast (string.string-ref needle i) : i64))
          (+= i 1)
          (set! ok false)))
      ok)))

(define (compiler-backend-swb-find-node
  [data : (Ptr u8)]
  [lab-start : (& lab-start (__tl_dyn-array i64))]
  [lab-end : (& lab-end (__tl_dyn-array i64))]
  [count : i64]
  [t0 : i64]
  [t1 : i64]) : i64
  (let
    [i : i64 0]
    [found : i64 -1]
    (while (and (< found 0) (< i count))
      (if (compiler-backend-swb-span-eq?
        data
        (array-ref lab-start i)
        (array-ref lab-end i)
        t0
        t1)
        (set! found i)
        unit)
      (+= i 1))
    found))

;; %rsp/%esp/%spl, %rbp/%ebp/%bpl/%bp, %rbx/%ebx/%bx/%bl/%bh and %r12..%r15 in
;; every width.  The System V callee-saved set is GP-only -- every xmm register
;; is caller-saved -- so no vector spelling can name a saved register, and the
;; Windows path never reaches here.
(define (compiler-backend-swb-frame-reg-at?
  [data : (Ptr u8)]
  [pos : i64]
  [stop : i64]) : bool
  (let
    [b1 : i64
      (if (< (+ pos 1) stop)
        (be_state.compiler-backend-peephole-byte-at data (+ pos 1))
        0)]
    [b2 : i64
      (if (< (+ pos 2) stop)
        (be_state.compiler-backend-peephole-byte-at data (+ pos 2))
        0)]
    [b3 : i64
      (if (< (+ pos 3) stop)
        (be_state.compiler-backend-peephole-byte-at data (+ pos 3))
        0)]
    (cond
      [(and (= b1 114) (= b2 49) (or (= b3 50) (= b3 51) (= b3 52) (= b3 53)))
        true]
      [(and (or (= b1 114) (= b1 101)) (= b2 115) (= b3 112)) true]
      [(and (or (= b1 114) (= b1 101)) (= b2 98) (or (= b3 112) (= b3 120)))
        true]
      [(and (= b1 115) (= b2 112) (= b3 108)) true]
      [(and (= b1 98) (or (= b2 112) (= b2 108) (= b2 120) (= b2 104))) true]
      [else false])))

(define (compiler-backend-swb-line-names-frame?
  [data : (Ptr u8)]
  [start : i64]
  [stop : i64]) : bool
  (let
    [i : i64 start]
    [hit : bool false]
    (while (and (not hit) (< i stop))
      (let
        [at : i64
          (be_operand.compiler-backend-peephole-scan-byte-range data i stop 37)]
        (if (>= at stop)
          (set! i stop)
          (begin
            (if (compiler-backend-swb-frame-reg-at? data at stop)
              (set! hit true)
              unit)
            (set! i (+ at 1))))))
    hit))

(define (compiler-backend-swb-call-mnemonic?
  [data : (Ptr u8)]
  [start : i64]
  [len : i64]) : bool
  (and
    (>= len 4)
    (= (be_state.compiler-backend-peephole-byte-at data start) 99)
    (= (be_state.compiler-backend-peephole-byte-at data (+ start 1)) 97)
    (= (be_state.compiler-backend-peephole-byte-at data (+ start 2)) 108)
    (= (be_state.compiler-backend-peephole-byte-at data (+ start 3)) 108)))

(define (compiler-backend-swb-text-reg-mask [text : (& text str)]) : i64
  (be_peephole.compiler-backend-swb-reg-mask-range
    (unsafe
      (string-data text))
    0
    (string.string-length text)))

(define (compiler-backend-swb-line-names-mask?
  [data : (Ptr u8)]
  [start : i64]
  [stop : i64]
  [mask : i64]) : bool
  (if (= mask 0)
    false
    (let
      [i : i64 start]
      [hit : bool false]
      (while (and (not hit) (< i stop))
        (let
          [at : i64
            (be_operand.compiler-backend-peephole-scan-byte-range
              data
              i
              stop
              37)]
          (if (>= at stop)
            (set! i stop)
            (let
              [bit : i64
                (be_peephole.compiler-backend-swb-reg-bit data at stop)]
              (if (and (>= bit 0) (not (= (bit-and mask (shl 1 bit)) 0)))
                (set! hit true)
                unit)
              (set! i (+ at 1))))))
      hit)))

;; The last `%` of a line -- the destination register of a two-operand form.
(define (compiler-backend-swb-line-tail-reg
  [data : (Ptr u8)]
  [start : i64]
  [stop : i64]) : i64
  (let
    [i : i64 (- stop 1)]
    [found : i64 -1]
    (while (and (< found 0) (>= i start))
      (if (= (be_state.compiler-backend-peephole-byte-at data i) 37)
        (set! found i)
        unit)
      (-= i 1))
    found))

(define (compiler-backend-swb-line-has-rbp-mem?
  [data : (Ptr u8)]
  [start : i64]
  [stop : i64]) : bool
  (let
    [i : i64 start]
    [hit : bool false]
    (while (and (not hit) (< i stop))
      (let
        [at : i64
          (be_operand.compiler-backend-peephole-scan-byte-range data i stop 37)]
        (if (>= at stop)
          (set! i stop)
          (begin
            (if (and
              (< (+ at 4) stop)
              (= (be_state.compiler-backend-peephole-byte-at data (+ at 1)) 114)
              (= (be_state.compiler-backend-peephole-byte-at data (+ at 2)) 98)
              (= (be_state.compiler-backend-peephole-byte-at data (+ at 3)) 112)
              (= (be_state.compiler-backend-peephole-byte-at data (+ at 4)) 41))
              (set! hit true)
              unit)
            (set! i (+ at 1))))))
    hit))

;; The epilogue is the code being PLACED, not a use of the frame: a bypass
;; return whose only frame reference is its own `add rsp` / pop run / `leave`
;; is exactly the block the placement exists to make bare. Recognize the
;; trailing epilogue run in front of a `ret` and exclude it from U.
;; The shapes the emitter produces here are `addq $N, %rsp` / `leaq D(%r_), %rsp`
;; (rsp restore), a `popq` run (FPO push mode), `leave`, and the rbp-frame
;; callee-save reloads `movq D(%rbp), %CSR`. A reload from an %rsp-relative slot
;; is NOT one of them and keeps its block in U.
(define (compiler-backend-swb-epilogue-line?
  [data : (Ptr u8)]
  [start : i64]
  [stop : i64]
  [kind : i64]) : bool
  (cond
    [(= kind be_operand.compiler-backend-control-mnemonic-pop) true]
    [(= kind be_operand.compiler-backend-control-mnemonic-leave) true]
    [(or
        (= kind be_operand.compiler-backend-control-mnemonic-addq)
        (= kind be_operand.compiler-backend-control-mnemonic-leaq))
      (let
        [pct : i64 (compiler-backend-swb-line-tail-reg data start stop)]
        (and
          (>= pct 0)
          (= (+ pct 4) stop)
          (= (be_state.compiler-backend-peephole-byte-at data (+ pct 1)) 114)
          (= (be_state.compiler-backend-peephole-byte-at data (+ pct 2)) 115)
          (= (be_state.compiler-backend-peephole-byte-at data (+ pct 3)) 112)))]
    [(= kind be_operand.compiler-backend-control-mnemonic-movq)
      (let
        [pct : i64 (compiler-backend-swb-line-tail-reg data start stop)]
        (and
          (>= pct 0)
          (compiler-backend-swb-frame-reg-at? data pct stop)
          (compiler-backend-swb-line-has-rbp-mem? data start stop)))]
    [else false]))

;; First byte of the trailing epilogue run in front of this node's `ret`, or the
;; node end when it has none.
(define (compiler-backend-swb-epilogue-start
  [data : (Ptr u8)]
  [body-start : i64]
  [body-stop : i64]) : i64
  (let
    [i : i64 body-start]
    [run : i64 -1]
    [answer : i64 body-stop]
    [done : bool false]
    (while (and (not done) (< i body-stop))
      (let
        [stop : i64
          (be_operand.compiler-backend-peephole-scan-byte-range
            data
            i
            body-stop
            10)]
        [m : i64 i]
        (while (and
          (< m stop)
          (= (be_state.compiler-backend-peephole-byte-at data m) 32))
          (+= m 1))
        (if (>= m stop)
          unit
          (let
            [tok : i64
              (-
                (be_operand.compiler-backend-peephole-scan-byte-range
                  data
                  m
                  stop
                  32)
                m)]
            [kind : i64
              (be_operand.compiler-backend-control-mnemonic-kind data m tok)]
            (cond
              [(= kind be_operand.compiler-backend-control-mnemonic-ret)
                (set!
                  answer
                  (if (>= run 0)
                    run
                    m))
                (set! done true)]
              [(compiler-backend-swb-epilogue-line? data m stop kind)
                (if (< run 0)
                  (set! run m)
                  unit)]
              [else (set! run -1)])))
        (set! i (+ stop 1))))
    answer))

;; Scan one node's body: classify it for U, record whether it returns, and
;; append its successors.  Returns the flag word; `succ-count` is written
;; through the supplied one-element array so the edge list stays flat.
(define (compiler-backend-swb-scan-node!
  [data : (Ptr u8)]
  [lab-start : (& lab-start (__tl_dyn-array i64))]
  [lab-end : (& lab-end (__tl_dyn-array i64))]
  [node-count : i64]
  [index : i64]
  [body-start : i64]
  [body-stop : i64]
  [return-label : (& return-label str)]
  [prologue-mask : i64]
  [succ : (&mut succ (__tl_dyn-array i64))]
  [succ-cursor : (&mut succ-cursor (__tl_dyn-array i64))]) : i64
  (let
    [epilogue : i64
      (compiler-backend-swb-epilogue-start data body-start body-stop)]
    [i : i64 body-start]
    [flags : i64 0]
    [falls : bool true]
    (while (< i body-stop)
      (let
        [stop : i64
          (be_operand.compiler-backend-peephole-scan-byte-range
            data
            i
            body-stop
            10)]
        [m : i64 i]
        (while (and
          (< m stop)
          (= (be_state.compiler-backend-peephole-byte-at data m) 32))
          (+= m 1))
        (if (>= m stop)
          unit
          (let
            [tok : i64
              (-
                (be_operand.compiler-backend-peephole-scan-byte-range
                  data
                  m
                  stop
                  32)
                m)]
            [kind : i64
              (be_operand.compiler-backend-control-mnemonic-kind data m tok)]
            [arg : i64 (+ m tok)]
            (while (and
              (< arg stop)
              (= (be_state.compiler-backend-peephole-byte-at data arg) 32))
              (+= arg 1))
            (cond
              [(compiler-backend-swb-call-mnemonic? data m tok)
                (set! flags (bit-or flags compiler-backend-swb-flag-frame))]
              [(>= m epilogue)
                ;; The trailing epilogue run: the code being placed.
                (when
                  (= kind be_operand.compiler-backend-control-mnemonic-ret)
                  (set! flags (bit-or flags compiler-backend-swb-flag-return))
                  (set! falls false))]
              [(= kind be_operand.compiler-backend-control-mnemonic-ret)
                (set! flags (bit-or flags compiler-backend-swb-flag-return))
                (set! falls false)]
              [(or
                  (= kind be_operand.compiler-backend-control-mnemonic-push)
                  (= kind be_operand.compiler-backend-control-mnemonic-pop)
                  (= kind be_operand.compiler-backend-control-mnemonic-leave))
                (set! flags (bit-or flags compiler-backend-swb-flag-frame))]
              [(and
                  (>= tok 1)
                  (= (be_state.compiler-backend-peephole-byte-at data m) 106))
                ;; Every `j*` mnemonic: `jmp` ends the node, a conditional
                ;; jump keeps its fall-through edge.
                (let
                  [target-stop : i64 stop]
                  (if (= kind be_operand.compiler-backend-control-mnemonic-jmp)
                    (set! falls false)
                    unit)
                  (cond
                    [(>= arg stop)
                      (set!
                        flags
                        (bit-or flags compiler-backend-swb-flag-opaque))]
                    [(=
                        (be_state.compiler-backend-peephole-byte-at data arg)
                        42)
                      (set!
                        flags
                        (bit-or flags compiler-backend-swb-flag-opaque))]
                    [(not
                        (and
                          (=
                            (be_state.compiler-backend-peephole-byte-at
                              data
                              arg)
                            46)
                          (=
                            (be_state.compiler-backend-peephole-byte-at
                              data
                              (+ arg 1))
                            76)))
                      ;; A tail `jmp` to another function: the frame has
                      ;; to be gone before it, so this block uses it.
                      (set!
                        flags
                        (bit-or flags compiler-backend-swb-flag-frame))]
                    [(compiler-backend-swb-span-eq-text?
                        data
                        arg
                        target-stop
                        return-label)
                      ;; The shared epilogue is the epilogue being
                      ;; placed, not a use of it: this edge is a return.
                      (set!
                        flags
                        (bit-or flags compiler-backend-swb-flag-return))]
                    [else
                      (let
                        [t : i64
                          (compiler-backend-swb-find-node
                            data
                            lab-start
                            lab-end
                            node-count
                            arg
                            target-stop)]
                        (if (< t 0)
                          (set!
                            flags
                            (bit-or flags compiler-backend-swb-flag-opaque))
                          (begin
                            (set! (array-ref succ (array-ref succ-cursor 0)) t)
                            (set!
                              (array-ref succ-cursor 0)
                              (+ (array-ref succ-cursor 0) 1)))))]))]
              [else unit])
            (if (and
              (< m epilogue)
              (or
                (compiler-backend-swb-line-names-frame? data m stop)
                ;; A register the saving prologue writes (a parameter
                ;; home) or still has to read (an incoming argument
                ;; register) may not be named before that prologue runs.
                (compiler-backend-swb-line-names-mask?
                  data
                  m
                  stop
                  prologue-mask)))
              (set! flags (bit-or flags compiler-backend-swb-flag-frame))
              unit)))
        (set! i (+ stop 1))))
    (when
      (and falls (< (+ index 1) node-count))
      (set! (array-ref succ (array-ref succ-cursor 0)) (+ index 1))
      (set! (array-ref succ-cursor 0) (+ (array-ref succ-cursor 0) 1)))
    ;; A return also reads its ABI result registers without naming them in
    ;; the assembly text.  A parameter-home move such as r8 -> rax in the
    ;; saving prologue must therefore precede even a bare `ret`, or an edge
    ;; to the shared epilogue.  Without value liveness here, conservatively
    ;; include both integer result words and the collapsed vector file.
    (if (and
      (!= (bit-and flags compiler-backend-swb-flag-return) 0)
      (!= (bit-and prologue-mask 65541) 0))
      (bit-or flags compiler-backend-swb-flag-frame)
      flags)))

;; The entry block decides almost every function: if it already names the frame
;; or a callee-saved register there is nothing to sink, and the whole placement
;; is refused before any edge is resolved.  This is the filter that keeps the
;; analysis off the compile-time critical path.
(define (compiler-backend-swb-node-holds-frame?
  [data : (Ptr u8)]
  [body-start : i64]
  [body-stop : i64]
  [prologue-mask : i64]) : bool
  (let
    [epilogue : i64
      (compiler-backend-swb-epilogue-start data body-start body-stop)]
    [i : i64 body-start]
    [hit : bool false]
    (while (and (not hit) (< i body-stop))
      (let
        [stop : i64
          (be_operand.compiler-backend-peephole-scan-byte-range
            data
            i
            body-stop
            10)]
        [m : i64 i]
        (while (and
          (< m stop)
          (= (be_state.compiler-backend-peephole-byte-at data m) 32))
          (+= m 1))
        (if (or (>= m stop) (>= m epilogue))
          unit
          (let
            [tok : i64
              (-
                (be_operand.compiler-backend-peephole-scan-byte-range
                  data
                  m
                  stop
                  32)
                m)]
            [kind : i64
              (be_operand.compiler-backend-control-mnemonic-kind data m tok)]
            (if (or
              (compiler-backend-swb-call-mnemonic? data m tok)
              (= kind be_operand.compiler-backend-control-mnemonic-push)
              (= kind be_operand.compiler-backend-control-mnemonic-pop)
              (= kind be_operand.compiler-backend-control-mnemonic-leave)
              (compiler-backend-swb-line-names-frame? data m stop)
              (compiler-backend-swb-line-names-mask? data m stop prologue-mask))
              (set! hit true)
              unit)))
        (set! i (+ stop 1))))
    hit))

(define (compiler-backend-swb-postorder!
  [succ-start : (& succ-start (__tl_dyn-array i64))]
  [succ-count : (& succ-count (__tl_dyn-array i64))]
  [succ : (& succ (__tl_dyn-array i64))]
  [node-count : i64]
  [po : (&mut po (__tl_dyn-array i64))]
  [order : (&mut order (__tl_dyn-array i64))]
  [root : i64]) : i64
  (let
    [stack : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
    [cursor : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
    [visited : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
    [sp : i64 1]
    [count : i64 0]
    (set! (array-ref visited root) 1)
    (set! (array-ref cursor root) 0)
    (set! (array-ref stack 0) root)
    (while (> sp 0)
      (let
        [v : i64 (array-ref stack (- sp 1))]
        (if (< (array-ref cursor v) (array-ref succ-count v))
          (let
            [w : i64
              (array-ref succ (+ (array-ref succ-start v) (array-ref cursor v)))]
            (set! (array-ref cursor v) (+ (array-ref cursor v) 1))
            (when
              (= (array-ref visited w) 0)
              (set! (array-ref visited w) 1)
              (set! (array-ref cursor w) 0)
              (set! (array-ref stack sp) w)
              (+= sp 1)))
          (begin
            (-= sp 1)
            (set! (array-ref po v) count)
            (set! (array-ref order count) v)
            (+= count 1)))))
    count))

;; Cooper/Harvey/Kennedy: walk both nodes up the partially built dominator tree
;; until they meet, ordering the walk by postorder number.
(define (compiler-backend-swb-intersect
  [idom : (& idom (__tl_dyn-array i64))]
  [po : (& po (__tl_dyn-array i64))]
  [left : i64]
  [right : i64]) : i64
  (let
    [a : i64 left]
    [b : i64 right]
    (while (not (= a b))
      (while (< (array-ref po a) (array-ref po b))
        (set! a (array-ref idom a)))
      (while (< (array-ref po b) (array-ref po a))
        (set! b (array-ref idom b))))
    a))

(define (compiler-backend-swb-build-idom!
  [pred-start : (__tl_dyn-array i64)]
  [pred-count : (__tl_dyn-array i64)]
  [pred : (__tl_dyn-array i64)]
  [po : (& po (__tl_dyn-array i64))]
  [order : (__tl_dyn-array i64)]
  [reach : i64]
  [idom : (&mut idom (__tl_dyn-array i64))]
  [root : i64]) : unit
  (let
    [changed : bool true]
    (set! (array-ref idom root) root)
    (while changed
      (set! changed false)
      (let
        [i : i64 (- reach 1)]
        (while (>= i 0)
          (let
            [b : i64 (array-ref order i)]
            (if (= b root)
              unit
              (let
                [best : i64 -1]
                (for [j (iterator.range 0 (array-ref pred-count b))]
                  (let
                    [p : i64 (array-ref pred (+ (array-ref pred-start b) j))]
                    (if (and (>= (array-ref po p) 0) (>= (array-ref idom p) 0))
                      (set!
                        best
                        (if (< best 0)
                          p
                          (compiler-backend-swb-intersect idom po p best)))
                      unit)))
                (when
                  (and (>= best 0) (not (= (array-ref idom b) best)))
                  (set! (array-ref idom b) best)
                  (set! changed true))))
            (-= i 1)))))))

(define (compiler-backend-swb-dominates?
  [idom : (& idom (__tl_dyn-array i64))]
  [node : i64]
  [dominator : i64]
  [root : i64]) : bool
  (let
    [x : i64 node]
    [done : bool false]
    [ok : bool false]
    (while (not done)
      (cond
        [(= x dominator)
          (set! ok true)
          (set! done true)]
        [(< x 0) (set! done true)]
        [(= x root) (set! done true)]
        [else (set! x (array-ref idom x))]))
    ok))

;; Reachability from `from`, written into `mark` (1 = reached).  Marking on
;; push keeps every node on the stack at most once.
(define (compiler-backend-swb-reach!
  [succ-start : (& succ-start (__tl_dyn-array i64))]
  [succ-count : (& succ-count (__tl_dyn-array i64))]
  [succ : (& succ (__tl_dyn-array i64))]
  [node-count : i64]
  [from : i64]
  [mark : (&mut mark (__tl_dyn-array i64))]) : unit
  (let
    [stack : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
    [sp : i64 0]
    (for [i (iterator.range 0 node-count)]
      (set! (array-ref mark i) 0))
    (for [i (iterator.range 0 (array-ref succ-count from))]
      (let
        [w : i64 (array-ref succ (+ (array-ref succ-start from) i))]
        (when
          (= (array-ref mark w) 0)
          (set! (array-ref mark w) 1)
          (set! (array-ref stack sp) w)
          (+= sp 1))))
    (while (> sp 0)
      (let
        [v : i64 (array-ref stack (- sp 1))]
        (-= sp 1)
        (for [j (iterator.range 0 (array-ref succ-count v))]
          (let
            [w : i64 (array-ref succ (+ (array-ref succ-start v) j))]
            (when
              (= (array-ref mark w) 0)
              (set! (array-ref mark w) 1)
              (set! (array-ref stack sp) w)
              (+= sp 1))))))))

;; Walk the chosen dominator up until it satisfies every well-formedness rule,
;; or give up.  Moving up can only shrink the bypass region, so the "no frame
;; use outside the region" and "the region is single-entry" tests improve
;; monotonically; only "the bypass still returns" can be lost by moving up, so
;; it is tested last, once.
;; --------------------------------------------------------------------------
;; TD-1: tail-duplicate the shared return tail so a guard bypass gets its own.
;;
;; SW-1 refuses a placement whose framed region is not single-entry.  The shape
;; this rule keeps refusing is the one LLVM's TailDuplicator opens up before it
;; shrink-wraps: the region is well formed except for ONE block -- the tail that
;; both the guard's bypass and the framed arms return through.  Give the bypass
;; its own copy of that tail (a fresh label whose return is bare, no epilogue)
;; and retarget the bypass edges to it; the Save-dominated predecessors keep the
;; original, framed tail.  That is the split SW-1 already emits between a
;; `swb-bare` label and a framed return -- the new part is minting the second
;; label when the block is SHARED.
;;
;; Every clause below is a refusal.  A shape that does not match to the byte
;; keeps the entry placement, and SW-1's drift check still runs on top.
;; The duplicated tail's label is the original's plus `__swb_tail`; no emitted
;; label ends that way, so the clone cannot collide with a block or with form
;; (a)'s `__shrinkwrap_*` names.  The suffix is written literally at both sites
;; because a borrow of a global String would escape the accumulator it folds
;; into.
;;
;; At most this many bypass edges are retargeted for one duplicated tail.  The
;; duplication is bounded by construction -- one clone per block, and the clone
;; is a return tail with no successor -- and this caps the edge rewrite too.
(define compiler-backend-swb-dup-site-limit : i64
  16)

;; SWB-FIX-1: form (a)'s bare-return clones are labelled
;; `<entry>__shrinkwrap_bare<digits>`, and the backend renders EVERY label with
;; that prefix as an unconditional bare `ret`
;; (`compiler-backend-return-tail-for-return-count`).  Such a block can
;; therefore never serve as the framed original of a duplicated tail: TD-1
;; would retarget the outside predecessors to the clone and keep the original
;; "framed", but the original still emits a bare `ret` and the general form's
;; pushes would never be popped on that path.  The test is a byte check on the
;; label span, like the rest of the swb code: strip the trailing decimal run,
;; then compare the 17 bytes before it against the fixed part of the suffix.
(define (compiler-backend-swb-bare-clone-label?
  [data : (Ptr u8)]
  [lab-start : i64]
  [lab-end : i64]) : bool
  (let
    [i : i64 lab-end]
    (while (and
      (> i lab-start)
      (>= (be_state.compiler-backend-peephole-byte-at data (- i 1)) 48)
      (<= (be_state.compiler-backend-peephole-byte-at data (- i 1)) 57))
      (-= i 1))
    (and
      (< i lab-end)
      (>= (- i 17) lab-start)
      (compiler-backend-swb-span-eq-text? data (- i 17) i "__shrinkwrap_bare"))))

;; The tail that may be duplicated: an IR block (so the bare-return set can name
;; it), which returns, has no resolved successor, and whose pre-epilogue body
;; never names the frame, a callee-saved register, or a register the saving
;; prologue writes.  The last clause is what makes the COPY safe to run before
;; the prologue exists, and it is already computed: it is the frame flag.
(define (compiler-backend-swb-dup-candidate?
  [flags : (& flags (__tl_dyn-array i64))]
  [succ-count : (& succ-count (__tl_dyn-array i64))]
  [block-start : (& block-start (__tl_dyn-array i64))]
  [bare-clone : (& bare-clone (__tl_dyn-array i64))]
  [node : i64]
  [candidate : i64]) : bool
  (and
    (not (= node candidate))
    (= (array-ref succ-count node) 0)
    (= (array-ref block-start node) 1)
    ;; SWB-FIX-1: a form (a) bare clone is rendered bare unconditionally, so it
    ;; cannot be the framed original the duplication leaves behind.
    (= (array-ref bare-clone node) 0)
    (not
      (= (bit-and (array-ref flags node) compiler-backend-swb-flag-return) 0))
    (= (bit-and (array-ref flags node) compiler-backend-swb-flag-frame) 0)))

;; One past the branch operand of a `j*` line naming the span [lab0, lab1), or
;; -1 when this line does not branch there.  The offset is where the fresh
;; label's suffix is spliced in.
(define (compiler-backend-swb-branch-target-end
  [data : (Ptr u8)]
  [m : i64]
  [stop : i64]
  [lab0 : i64]
  [lab1 : i64]) : i64
  (let
    [tok : i64
      (-
        (be_operand.compiler-backend-peephole-scan-byte-range data m stop 32)
        m)]
    (if (or
      (< tok 1)
      (not (= (be_state.compiler-backend-peephole-byte-at data m) 106)))
      (- 0 1)
      (let
        [arg : i64 (+ m tok)]
        (while (and
          (< arg stop)
          (= (be_state.compiler-backend-peephole-byte-at data arg) 32))
          (+= arg 1))
        (if (and
          (< arg stop)
          (compiler-backend-swb-span-eq? data arg stop lab0 lab1))
          stop
          (- 0 1))))))

;; Append every branch-to-[lab0,lab1) splice offset in one node's body; returns
;; how many this node contributed.  A predecessor that reaches the tail by
;; FALLING THROUGH contributes none, and the caller refuses the duplication --
;; there is no operand to retarget.
(define (compiler-backend-swb-collect-dup-sites!
  [data : (Ptr u8)]
  [body-start : i64]
  [body-stop : i64]
  [lab0 : i64]
  [lab1 : i64]
  [sites : (&mut sites (__tl_dyn-array i64))]
  [cursor : (&mut cursor (__tl_dyn-array i64))]) : i64
  (let
    [i : i64 body-start]
    [found : i64 0]
    (while (< i body-stop)
      (let
        [stop : i64
          (be_operand.compiler-backend-peephole-scan-byte-range
            data
            i
            body-stop
            10)]
        [m : i64 i]
        (while (and
          (< m stop)
          (= (be_state.compiler-backend-peephole-byte-at data m) 32))
          (+= m 1))
        (if (>= m stop)
          unit
          (let
            [end : i64
              (compiler-backend-swb-branch-target-end data m stop lab0 lab1)]
            (if (< end 0)
              unit
              (if (>= (array-ref cursor 0) compiler-backend-swb-dup-site-limit)
                (set! found (- 0 1))
                (begin
                  (set! (array-ref sites (array-ref cursor 0)) end)
                  (set! (array-ref cursor 0) (+ (array-ref cursor 0) 1))
                  (+= found 1))))))
        (set! i (+ stop 1))))
    found))

;; The duplicated tail's body: the tail's own pre-epilogue lines, with its
;; trailing `jmp <shared epilogue>` dropped, and a BARE `ret` in place of the
;; epilogue the bypass never has a prologue for.  `ok` is cleared for any line
;; the copy cannot reproduce safely -- a branch that is not that trailing jump
;; would send the bypass into framed code.
(define (compiler-backend-swb-dup-tail-body
  [text : (& text str)]
  [data : (Ptr u8)]
  [body-start : i64]
  [body-stop : i64]
  [return-label : String]
  [ok : (&mut ok (__tl_dyn-array i64))]) : String
  (let
    [epilogue : i64
      (compiler-backend-swb-epilogue-start data body-start body-stop)]
    [i : i64 body-start]
    [out : String ""]
    [tail-jump : bool false]
    (while (< i epilogue)
      (let
        [stop : i64
          (be_operand.compiler-backend-peephole-scan-byte-range
            data
            i
            epilogue
            10)]
        [m : i64 i]
        (while (and
          (< m stop)
          (= (be_state.compiler-backend-peephole-byte-at data m) 32))
          (+= m 1))
        (if (>= m stop)
          unit
          (let
            [tok : i64
              (-
                (be_operand.compiler-backend-peephole-scan-byte-range
                  data
                  m
                  stop
                  32)
                m)]
            [kind : i64
              (be_operand.compiler-backend-control-mnemonic-kind data m tok)]
            (if tail-jump
              ;; Anything after the tail jump is unreachable in the
              ;; original and must not be reproduced.
              (set! (array-ref ok 0) 0)
              (if (and
                (>= tok 1)
                (= (be_state.compiler-backend-peephole-byte-at data m) 106))
                (let
                  [arg : i64 (+ m tok)]
                  (while (and
                    (< arg stop)
                    (= (be_state.compiler-backend-peephole-byte-at data arg) 32))
                    (+= arg 1))
                  (if (and
                    (= kind be_operand.compiler-backend-control-mnemonic-jmp)
                    (< arg stop)
                    (compiler-backend-swb-span-eq-text?
                      data
                      arg
                      stop
                      return-label))
                    (set! tail-jump true)
                    (set! (array-ref ok 0) 0)))
                (set!
                  out
                  (str_cat.str-cat
                    out
                    (string.substring text i (- (+ stop 1) i))
                    ""))))))
        (set! i (+ stop 1))))
    out))

;; Splice `__swb_tail` onto every recorded branch operand and append the
;; duplicated tail.  `sites` is ascending, so one left-to-right pass rebuilds
;; the text.
(define (compiler-backend-swb-apply-dup
  [text : (& text str)]
  [sites : (__tl_dyn-array i64)]
  [site-count : i64]
  [dup-text : String]) : String
  (let
    [n : i64 (string.string-length text)]
    [out : String ""]
    [at : i64 0]
    (for [k (iterator.range 0 site-count)]
      (let
        [s : i64 (array-ref sites k)]
        (set!
          out
          (str_cat.str-cat out (string.substring text at (- s at)) "__swb_tail"))
        (set! at s)))
    (str_cat.str-cat out (string.substring text at (- n at)) dup-text)))

(define (compiler-backend-swb-node-targets?
  [succ-start : (& succ-start (__tl_dyn-array i64))]
  [succ-count : (& succ-count (__tl_dyn-array i64))]
  [succ : (& succ (__tl_dyn-array i64))]
  [node : i64]
  [target : i64]) : bool
  (let
    [hit : bool false]
    (for [j (iterator.range 0 (array-ref succ-count node))]
      (if (= (array-ref succ (+ (array-ref succ-start node) j)) target)
        (set! hit true)
        unit))
    hit))

(defstruct CompilerBackendSwbDup
  (ok bool)
  (sites (__tl_dyn-array i64))
  (site-count i64)
  (text String))

(define (compiler-backend-swb-no-dup) : CompilerBackendSwbDup
  (CompilerBackendSwbDup false (__tl_make-array i64 0) 0 ""))

;; Resolve the duplication for tail `dup-node` under Save `chosen`: every edge
;; into the tail from OUTSIDE the framed region is retargeted, the tail's own
;; body is copied with a bare return, and anything that does not reproduce
;; exactly refuses the whole duplication (and with it the placement).
(define (compiler-backend-swb-dup-plan
  [text : (& text str)]
  [lab-start : (__tl_dyn-array i64)]
  [lab-end : (__tl_dyn-array i64)]
  [body-start : (__tl_dyn-array i64)]
  [body-end : (__tl_dyn-array i64)]
  [succ-start : (& succ-start (__tl_dyn-array i64))]
  [succ-count : (& succ-count (__tl_dyn-array i64))]
  [succ : (& succ (__tl_dyn-array i64))]
  [po : (& po (__tl_dyn-array i64))]
  [idom : (& idom (__tl_dyn-array i64))]
  [node-count : i64]
  [chosen : i64]
  [dup-node : i64]
  [return-label : String]) : CompilerBackendSwbDup
  (let
    [data : (Ptr u8)
      (unsafe
        (string-data text))]
    [sites : (__tl_dyn-array i64)
      (__tl_make-array i64 compiler-backend-swb-dup-site-limit)]
    [cursor : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [ok : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [_init : unit (set! (array-ref ok 0) 1)]
    [_scan : unit
      (for [p (iterator.range 0 node-count)]
        (if (and
          (>= (array-ref po p) 0)
          (not (compiler-backend-swb-dominates? idom p chosen 0)))
          (let
            [targets : bool
              (compiler-backend-swb-node-targets?
                succ-start
                succ-count
                succ
                p
                dup-node)]
            (if targets
              (if (<=
                (compiler-backend-swb-collect-dup-sites!
                  data
                  (array-ref body-start p)
                  (array-ref body-end p)
                  (array-ref lab-start dup-node)
                  (array-ref lab-end dup-node)
                  (&mut sites)
                  (&mut cursor))
                0)
                (set! (array-ref ok 0) 0)
                unit)
              unit))
          unit))]
    ;; The tail's TEXTUAL predecessor can reach it by falling through, and a
    ;; fallthrough has no operand to retarget.  If that predecessor is outside
    ;; the region the bypass would keep entering the framed tail, so refuse --
    ;; even when it also branches there, because only the branch would move.
    [fallthrough-outside? : bool
      (and
        (> dup-node 0)
        (>= (array-ref po (- dup-node 1)) 0)
        (not (compiler-backend-swb-dominates? idom (- dup-node 1) chosen 0))
        (compiler-backend-swb-node-targets?
          succ-start
          succ-count
          succ
          (- dup-node 1)
          dup-node))]
    [body : String
      (compiler-backend-swb-dup-tail-body
        text
        data
        (array-ref body-start dup-node)
        (array-ref body-end dup-node)
        return-label
        (&mut ok))]
    (if (or
      (= (array-ref ok 0) 0)
      (= (array-ref cursor 0) 0)
      fallthrough-outside?)
      (compiler-backend-swb-no-dup)
      (CompilerBackendSwbDup
        true
        sites
        (array-ref cursor 0)
        (str_cat.str-cat
          (string.substring
            text
            (array-ref lab-start dup-node)
            (- (array-ref lab-end dup-node) (array-ref lab-start dup-node)))
          "__swb_tail:\n"
          body
          "    ret\n")))))

(define (compiler-backend-swb-choose-node
  [succ-start : (& succ-start (__tl_dyn-array i64))]
  [succ-count : (& succ-count (__tl_dyn-array i64))]
  [succ : (& succ (__tl_dyn-array i64))]
  [flags : (& flags (__tl_dyn-array i64))]
  [po : (& po (__tl_dyn-array i64))]
  [idom : (& idom (__tl_dyn-array i64))]
  [block-start : (& block-start (__tl_dyn-array i64))]
  [bare-clone : (& bare-clone (__tl_dyn-array i64))]
  [dup-out : (&mut dup-out (__tl_dyn-array i64))]
  [allow-dup : bool]
  [node-count : i64]) : i64
  (let
    [mark : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
    [candidate : i64 -1]
    [steps : i64 0]
    [answer : i64 -1]
    [done : bool false]
    ;; S starts at the nearest common dominator of every block that uses the
    ;; frame or a callee-saved register.
    (for [i (iterator.range 0 node-count)]
      (if (and
        (>= (array-ref po i) 0)
        (not
          (= (bit-and (array-ref flags i) compiler-backend-swb-flag-frame) 0)))
        (set!
          candidate
          (if (< candidate 0)
            i
            (compiler-backend-swb-intersect idom po candidate i)))
        unit))
    (while (not done)
      (cond
        [(< candidate 0) (set! done true)]
        [(= candidate 0) (set! done true)]
        [(> steps node-count) (set! done true)]
        [else
          (let
            [reject : bool false]
            (+= steps 1)
            ;; The duplication belongs to the candidate under test; a walk
            ;; up to the next dominator starts from no duplication again.
            (set! (array-ref dup-out 0) (- 0 1))
            ;; The prologue may not run more than once per activation.
            (compiler-backend-swb-reach!
              succ-start
              succ-count
              succ
              node-count
              candidate
              (&mut mark))
            (if (= (array-ref mark candidate) 1)
              (set! reject true)
              unit)
            ;; Every block reachable from S is dominated by S: the framed
            ;; region is single-entry and no bypass path merges into it.
            ;; TD-1: a SINGLE violator that is a duplicable return tail is
            ;; not a refusal.  The bypass edges into it are given their own
            ;; copy of the tail below, which restores the single entry; the
            ;; duplication itself still has to resolve, or the placement is
            ;; refused with it.
            (if reject
              unit
              (let
                [viol : i64 -1]
                [viol-count : i64 0]
                (for [j (iterator.range 0 node-count)]
                  (when
                    (and
                      (= (array-ref mark j) 1)
                      (not (compiler-backend-swb-dominates? idom j candidate 0)))
                    (set! viol j)
                    (+= viol-count 1)))
                (if (= viol-count 0)
                  unit
                  (if (and
                    allow-dup
                    (= viol-count 1)
                    (compiler-backend-swb-dup-candidate?
                      flags
                      succ-count
                      block-start
                      bare-clone
                      viol
                      candidate))
                    (set! (array-ref dup-out 0) viol)
                    (set! reject true)))))
            ;; Nothing outside the region may touch the frame.  By
            ;; construction of U this holds; assert it against the text.
            (if reject
              unit
              (for [j (iterator.range 0 node-count)]
                (if (and
                  (>= (array-ref po j) 0)
                  (not (compiler-backend-swb-dominates? idom j candidate 0))
                  (not
                    (=
                      (bit-and
                        (array-ref flags j)
                        compiler-backend-swb-flag-frame)
                      0)))
                  (set! reject true)
                  unit)))
            ;; The prologue is spliced at a block label, so S has to be one.
            (if (= (array-ref block-start candidate) 0)
              (set! reject true)
              unit)
            (if reject
              (set! candidate (array-ref idom candidate))
              (begin
                (set! answer candidate)
                (set! done true))))]))
    ;; A placement that bypasses no return saves nothing.
    (if (< answer 0)
      (begin
        (set! (array-ref dup-out 0) (- 0 1))
        -1)
      (let
        [bypass-return : bool false]
        (for [j (iterator.range 0 node-count)]
          (if (and
            (>= (array-ref po j) 0)
            (not (compiler-backend-swb-dominates? idom j answer 0))
            (not
              (=
                (bit-and (array-ref flags j) compiler-backend-swb-flag-return)
                0)))
            (set! bypass-return true)
            unit))
        (if bypass-return
          answer
          (begin
            (set! (array-ref dup-out 0) (- 0 1))
            -1))))))

;; SWB-FIX-1: the analysed text node of one IR block, resolved through the
;; label-to-node map `plan-for` already built.  -1 when the label is not a block
;; of this function or its block did not resolve to a label line.
(define (compiler-backend-swb-node-for-label
  [blocks : (& blocks compiler_ir_types.CompilerIrBlockSeq)]
  [block-index : (& block-index (__tl_dyn-array i64))]
  [block-count : i64]
  [label : i64]) : i64
  (let
    [b : i64 0]
    [found : i64 -1]
    (while (and (< found 0) (< b block-count))
      (match (compiler_ir_types.compiler-ir-block-seq-borrow blocks b)
        [(Block block-label _instrs)
          (if (= block-label label)
            (set! found (array-ref block-index b))
            unit)])
      (+= b 1))
    found))

(define (compiler-backend-swb-plan-for
  [text : (& text str)]
  [label-scope : String]
  [return-label : String]
  [prologue-mask : i64]
  ;; SWB-FIX-1: form (a)'s saving block (the single entry of ITS framed body),
  ;; or label-none when form (a) is not active for this function.
  [form-a-saving-label : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : CompilerBackendSwbPlan
  (let
    [data : (Ptr u8)
      (unsafe
        (string-data text))]
    [node-count : i64 (compiler-backend-swb-count-nodes text)]
    (if (or (< node-count 3) (> node-count compiler-backend-swb-node-limit))
      (compiler-backend-swb-no-plan)
      (let
        [lab-start : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
        [lab-end : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
        [body-start : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
        [body-end : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
        [_collect : unit
          (compiler-backend-swb-collect-nodes!
            text
            (&mut lab-start)
            (&mut lab-end)
            (&mut body-start)
            (&mut body-end))]
        (if (compiler-backend-swb-node-holds-frame?
          data
          (array-ref body-start 0)
          (array-ref body-end 0)
          prologue-mask)
          (compiler-backend-swb-no-plan)
          (let
            [edge-cap : i64
              (+ (compiler-backend-swb-count-lines text) node-count)]
            [succ : (__tl_dyn-array i64) (__tl_make-array i64 edge-cap)]
            [succ-start : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
            [succ-count : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
            [flags : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
            [cursor : (__tl_dyn-array i64) (__tl_make-array i64 1)]
            [opaque : bool false]
            [_scan : unit
              (let
                [i : i64 0]
                (while (< i node-count)
                  (set! (array-ref succ-start i) (array-ref cursor 0))
                  (set!
                    (array-ref flags i)
                    (compiler-backend-swb-scan-node!
                      data
                      lab-start
                      lab-end
                      node-count
                      i
                      (array-ref body-start i)
                      (array-ref body-end i)
                      return-label
                      prologue-mask
                      (&mut succ)
                      (&mut cursor)))
                  (set!
                    (array-ref succ-count i)
                    (- (array-ref cursor 0) (array-ref succ-start i)))
                  (if (not
                    (=
                      (bit-and
                        (array-ref flags i)
                        compiler-backend-swb-flag-opaque)
                      0))
                    (set! opaque true)
                    unit)
                  (+= i 1)))]
            (if opaque
              (compiler-backend-swb-no-plan)
              (let
                [po : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
                [order : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
                [idom : (__tl_dyn-array i64) (__tl_make-array i64 node-count)]
                [pred-start : (__tl_dyn-array i64)
                  (__tl_make-array i64 node-count)]
                [pred-count : (__tl_dyn-array i64)
                  (__tl_make-array i64 node-count)]
                [pred : (__tl_dyn-array i64) (__tl_make-array i64 edge-cap)]
                [block-start : (__tl_dyn-array i64)
                  (__tl_make-array i64 node-count)]
                ;; SWB-FIX-1: which nodes are form (a) bare-return clones.
                [bare-clone : (__tl_dyn-array i64)
                  (__tl_make-array i64 node-count)]
                [_bare-clone : unit
                  (for [i (iterator.range 0 node-count)]
                    (set!
                      (array-ref bare-clone i)
                      (if (compiler-backend-swb-bare-clone-label?
                        data
                        (array-ref lab-start i)
                        (array-ref lab-end i))
                        1
                        0)))]
                [_init : unit
                  (for [i (iterator.range 0 node-count)]
                    (set! (array-ref po i) -1)
                    (set! (array-ref idom i) -1)
                    (set! (array-ref pred-count i) 0))]
                [reach : i64
                  (compiler-backend-swb-postorder!
                    succ-start
                    succ-count
                    succ
                    node-count
                    (&mut po)
                    (&mut order)
                    0)]
                [_preds : unit
                  (let
                    [fill : i64 0]
                    (for [i (iterator.range 0 node-count)]
                      (for [j (iterator.range 0 (array-ref succ-count i))]
                        (set!
                          (array-ref
                            pred-count
                            (array-ref succ (+ (array-ref succ-start i) j)))
                          (+
                            (array-ref
                              pred-count
                              (array-ref succ (+ (array-ref succ-start i) j)))
                            1))))
                    (for [i (iterator.range 0 node-count)]
                      (set! (array-ref pred-start i) fill)
                      (+= fill (array-ref pred-count i))
                      (set! (array-ref pred-count i) 0))
                    (for [i (iterator.range 0 node-count)]
                      (for [j (iterator.range 0 (array-ref succ-count i))]
                        (let
                          [w : i64
                            (array-ref succ (+ (array-ref succ-start i) j))]
                          (set!
                            (array-ref
                              pred
                              (+
                                (array-ref pred-start w)
                                (array-ref pred-count w)))
                            i)
                          (set!
                            (array-ref pred-count w)
                            (+ (array-ref pred-count w) 1)))))
                    unit)]
                [_idom : unit
                  (compiler-backend-swb-build-idom!
                    pred-start
                    pred-count
                    pred
                    po
                    order
                    reach
                    (&mut idom)
                    0)]
                [seq : compiler_ir_types.CompilerIrBlockSeq
                  (compiler_liveness.compiler-live-ir-block-list-to-seq
                    (& blocks))]
                [block-count : i64
                  (compiler_ir_types.compiler-ir-block-seq-count seq)]
                [block-index : (__tl_dyn-array i64)
                  (__tl_make-array i64 block-count)]
                [_blocks : unit
                  (let
                    [scan : i64 0]
                    (for [b (iterator.range 0 block-count)]
                      (match (compiler_ir_types.compiler-ir-block-seq-borrow
                        seq
                        b)
                        [(Block label _)
                          (let
                            [asm : String
                              (be_operand.compiler-backend-asm-label
                                (be_state.compiler-backend-global-shared-view
                                  label-scope)
                                label)]
                            [found : i64 -1]
                            [i : i64 scan]
                            (while (and (< found 0) (< i node-count))
                              (if (compiler-backend-swb-span-eq-text?
                                data
                                (array-ref lab-start i)
                                (array-ref lab-end i)
                                asm)
                                (set! found i)
                                unit)
                              (+= i 1))
                            (set! (array-ref block-index b) found)
                            ;; Text follows IR order, except that the -O2
                            ;; guard flip places form (a)'s bare clones after
                            ;; the last block, so finding one does not move
                            ;; the scan past the blocks that follow it in IR.
                            (when
                              (>= found 0)
                              (set! (array-ref block-start found) 1)
                              (when
                                (= (array-ref bare-clone found) 0)
                                (set! scan (+ found 1)))))])))]
                ;; SWB-FIX-1: the text node of form (a)'s saving block, or -1
                ;; when it does not resolve (which is a refusal, not a pass).
                [saving-node : i64
                  (if (compiler_ir_types.compiler-ir-label-some?
                    form-a-saving-label)
                    (compiler-backend-swb-node-for-label
                      seq
                      block-index
                      block-count
                      form-a-saving-label)
                    (- 0 1))]
                [dup-out : (__tl_dyn-array i64) (__tl_make-array i64 1)]
                [_dup-init : unit (set! (array-ref dup-out 0) (- 0 1))]
                [chosen-dup : i64
                  (compiler-backend-swb-choose-node
                    succ-start
                    succ-count
                    succ
                    flags
                    po
                    idom
                    block-start
                    bare-clone
                    (&mut dup-out)
                    true
                    node-count)]
                ;; TD-1: the tail this placement duplicates, or -1.
                [dup-node-first : i64 (array-ref dup-out 0)]
                [dup-first : CompilerBackendSwbDup
                  (if (or (< chosen-dup 0) (< dup-node-first 0))
                    (compiler-backend-swb-no-dup)
                    (compiler-backend-swb-dup-plan
                      text
                      lab-start
                      lab-end
                      body-start
                      body-end
                      succ-start
                      succ-count
                      succ
                      po
                      idom
                      node-count
                      chosen-dup
                      dup-node-first
                      return-label))]
                ;; A duplication the text cannot reproduce rejects that
                ;; CANDIDATE, not the placement.  Re-run the walk with
                ;; duplication disabled -- which is exactly the pre-TD-1
                ;; search -- so a shape TD-1 cannot open keeps whatever
                ;; placement SW-1 alone would have found for it.
                [dup-usable? : bool (or (< dup-node-first 0) dup-first.ok)]
                [dup-retry : (__tl_dyn-array i64) (__tl_make-array i64 1)]
                [chosen : i64
                  (if dup-usable?
                    chosen-dup
                    (compiler-backend-swb-choose-node
                      succ-start
                      succ-count
                      succ
                      flags
                      po
                      idom
                      block-start
                      bare-clone
                      (&mut dup-retry)
                      false
                      node-count))]
                [dup-node : i64
                  (if dup-usable?
                    dup-node-first
                    (- 0 1))]
                [dup : CompilerBackendSwbDup
                  (if dup-usable?
                    dup-first
                    (compiler-backend-swb-no-dup))]
                ;; SWB-FIX-1: form (a) has already placed a Save at ITS
                ;; frontier, and every block of its prefix returns through a
                ;; label the backend renders as an unconditional bare `ret`.
                ;; The general form may only sink FURTHER: a chosen S strictly
                ;; above that frontier puts those bare returns inside the
                ;; framed region, where the pushes spliced at S are never
                ;; popped.  So accept S only when form (a)'s saving block
                ;; dominates it (S == the saving node counts), and fail closed
                ;; when the saving block does not resolve to a node of the
                ;; analysed text.  Form (a)'s own placement is kept instead --
                ;; it is the better one anyway, being at the frontier and below
                ;; every guard.
                [form-a-frontier-ok? : bool
                  (or
                    (not
                      (compiler_ir_types.compiler-ir-label-some?
                        form-a-saving-label))
                    (and
                      (>= saving-node 0)
                      (compiler-backend-swb-dominates?
                        idom
                        chosen
                        saving-node
                        0)))]
                (if (or (< chosen 0) (not form-a-frontier-ok?))
                  (compiler-backend-swb-no-plan)
                  (let
                    [bare : (__tl_dyn-array i64)
                      (__tl_make-array i64 block-count)]
                    [bare-count : i64 0]
                    [saving : i64 (compiler_ir_types.compiler-ir-label-none)]
                    (for [b (iterator.range 0 block-count)]
                      (match (compiler_ir_types.compiler-ir-block-seq-borrow
                        seq
                        b)
                        [(Block label _instrs)
                          (let
                            [node : i64 (array-ref block-index b)]
                            (if (= node chosen)
                              (set! saving label)
                              unit)
                            ;; Every reachable block outside the framed
                            ;; region returns bare. The set is NOT
                            ;; filtered by the block's IR `Return` count:
                            ;; the emitter also folds a `Jump` whose
                            ;; target is a return-only block into an
                            ;; inline return, so a block with no `Return`
                            ;; instruction can still emit a `ret` -- and
                            ;; that `ret` would carry an epilogue for a
                            ;; prologue this path never ran. Marking a
                            ;; block that does not return is inert.
                            ;; TD-1: the duplicated tail is NOT bare.
                            ;; Its clone carries the bare return for the
                            ;; bypass; the original keeps the framed
                            ;; epilogue for the predecessors the Save
                            ;; dominates, which are now its only ones.
                            (when
                              (and
                                (>= node 0)
                                (not (= node dup-node))
                                (>= (array-ref po node) 0)
                                (not
                                  (compiler-backend-swb-dominates?
                                    idom
                                    node
                                    chosen
                                    0)))
                              (set! (array-ref bare bare-count) label)
                              (+= bare-count 1)))]))
                    (if (= saving (compiler_ir_types.compiler-ir-label-none))
                      (compiler-backend-swb-no-plan)
                      (let
                        [packed : (__tl_dyn-array i64)
                          (__tl_make-array i64 bare-count)]
                        (for [k (iterator.range 0 bare-count)]
                          (set! (array-ref packed k) (array-ref bare k)))
                        (CompilerBackendSwbPlan
                          saving
                          packed
                          dup.sites
                          dup.site-count
                          dup.text)))))))))))))

;; --- hidden-result reuse ----------------------------------------------------
;; A hidden-result call returns the slot pointer it was passed: an internal
;; leading return-storage callee returns its hidden argument as `u64` on every
;; path (a C callee returns it in the same register by its ABI). After the
;; call, its result and the slot pointer name one address. Lowering reads the
;; result through the slot pointer, which slot forwarding and scalarization key
;; on; left that way at emission, the slot pointer stays live across the call
;; and takes a callee-saved register, while the result already sits in the
;; return register. So, before the register plan, later reads of a slot
;; pointer that exactly one call fills read that call's result instead, and
;; the slot pointer ends at the call. A call fills its marked Sret argument, or
;; the hidden argument of a direct callee the program index declares internal
;; leading. The slot pointer must have one definition, earlier in the call's
;; own block, and the result no other: that block then dominates every other
;; use, and every path to such a use runs the call after the definition. A
;; parameter is defined on entry, so one reassignment is a second definition.
;; Only reads after the call in walk order are renamed; phi inputs keep the
;; slot pointer.
;;
;; A site is `block * compiler-backend-sret-reuse-block-stride + index`; the
;; per-var tables hold `site + 1` for one definition (or fill), 0 for none and
;; -1 for more than one.
(define compiler-backend-sret-reuse-block-stride : i64
  4294967296)

(define (compiler-backend-sret-reuse-value-var
  [value : (& value compiler_ir_types.CompilerIrValue)]) : i64
  (match value
    [(Var id) id]
    [_ -1]))

;; The var at `index` of `args`, or -1.
(define (compiler-backend-sret-reuse-arg-var
  [args : (& args compiler_ir_types.CompilerIrCallArgs)]
  [index : i64]) : i64
  (match args
    [(One value)
      (if (= index 0)
        (compiler-backend-sret-reuse-value-var value)
        -1)]
    [(Two first second)
      (cond
        [(= index 0) (compiler-backend-sret-reuse-value-var first)]
        [(= index 1) (compiler-backend-sret-reuse-value-var second)]
        [else -1])]
    [(or (Array values) (Sret values _))
      (if (and (>= index 0) (< index (array-length values)))
        (compiler-backend-sret-reuse-value-var (& (array-ref values index)))
        -1)]
    [_ -1]))

;; The slot var a hidden-result call fills, or -1.
(define (compiler-backend-sret-reuse-call-slot
  [program-index : be_state.CompilerBackendProgramIndex]
  [instr : (& instr compiler_ir_types.CompilerIrInstr)]) : i64
  (match instr
    [(Call dst callee args _)
      (cond
        [(< dst 0) -1]
        [else
          (match args
            [(Sret _ index) (compiler-backend-sret-reuse-arg-var args index)]
            [_
              (compiler-backend-sret-reuse-arg-var
                args
                (be_operand.compiler-backend-index-function-leading-sret
                  program-index
                  callee))])])]
    [(CallIndirect dst _ args _)
      (if (< dst 0)
        -1
        (match args
          [(Sret _ index) (compiler-backend-sret-reuse-arg-var args index)]
          [_ -1]))]
    [_ -1]))

(define (compiler-backend-sret-reuse-note!
  [table : (&mut table (__tl_dyn-array i64))]
  [var : i64]
  [site : i64]) : unit
  (when
    (and (>= var 0) (< var (array-length table)))
    (set!
      (array-ref table var)
      (if (= (array-ref table var) 0)
        (+ site 1)
        -1))))

;; `old`'s first `len` entries in an array with room for one more.
(define (compiler-backend-sret-reuse-grown
  [old : (__tl_dyn-array i64)]
  [len : i64]) : (__tl_dyn-array i64)
  (if (< len (array-length old))
    old
    (let
      [grown : (__tl_dyn-array i64) (__tl_make-array i64 (+ (* len 2) 8))]
      (for [k (iterator.range 0 len)]
        (set! (array-ref grown k) (array-ref old k)))
      grown)))

;; One function's admitted hidden-result calls in walk order (the slot each
;; fills, its result and its site), and by var the `site + 1` of an admitted
;; slot's call, else 0.
(defstruct CompilerBackendSretReuseCalls
  (slot (__tl_dyn-array i64))
  (dst (__tl_dyn-array i64))
  (site (__tl_dyn-array i64))
  (count i64)
  (fills (__tl_dyn-array i64)))

;; Whether `var` is one of `params`.
(define (compiler-backend-sret-reuse-param?
  [params : (& params compiler_ir_types.CompilerIrParamSeq)]
  [var : i64]) : bool
  (let
    [found : bool false]
    (for [k (iterator.range 0 params.len)]
      (match (compiler_ir_types.compiler-ir-param-seq-borrow params k)
        [(Param _ _ id) (when (= id var) (set! found true))]))
    found))

;; One walk records definitions and fills; then the calls that admit their
;; slot. A parameter's entry value reaches every block, so no instruction is
;; its one definition and it is never admitted.
(define (compiler-backend-sret-reuse-admit
  [program-index : be_state.CompilerBackendProgramIndex]
  [params : (& params compiler_ir_types.CompilerIrParamSeq)]
  [vars : i64]
  [seq : (& seq compiler_ir_types.CompilerIrBlockSeq)]) : CompilerBackendSretReuseCalls
  (let
    [defs : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    [fills : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    [slot : (__tl_dyn-array i64) (__tl_make-array i64 0)]
    [dst : (__tl_dyn-array i64) (__tl_make-array i64 0)]
    [site : (__tl_dyn-array i64) (__tl_make-array i64 0)]
    [seen : i64 0]
    [admitted : i64 0]
    (for [b
      (iterator.range 0 (compiler_ir_types.compiler-ir-block-seq-count seq))]
      (match (compiler_ir_types.compiler-ir-block-seq-borrow seq b)
        [(Block _ instrs)
          (let
            [base : i64 (* b compiler-backend-sret-reuse-block-stride)]
            (for [j (iterator.range 0 instrs.len)]
              (let
                [instr : (& instrs compiler_ir_types.CompilerIrInstr)
                  (compiler_ir_types.compiler-ir-instr-seq-borrow instrs j)]
                [at : i64 (+ base j)]
                [def : i64 (compiler_ir_types.compiler-ir-instr-dst instr)]
                (when
                  (and (>= def 0) (< def vars))
                  (set!
                    (array-ref defs def)
                    (if (= (array-ref defs def) 0)
                      (+ at 1)
                      -1)))
                (match instr
                  [(or (Call _ _ _ _) (CallIndirect _ _ _ _))
                    (let
                      [filled : i64
                        (compiler-backend-sret-reuse-call-slot
                          program-index
                          instr)]
                      (when
                        (and (>= filled 0) (< filled vars))
                        (compiler-backend-sret-reuse-note!
                          (&mut fills)
                          filled
                          at)
                        (set!
                          slot
                          (compiler-backend-sret-reuse-grown slot seen))
                        (set! dst (compiler-backend-sret-reuse-grown dst seen))
                        (set!
                          site
                          (compiler-backend-sret-reuse-grown site seen))
                        (set! (array-ref slot seen) filled)
                        (set! (array-ref dst seen) def)
                        (set! (array-ref site seen) at)
                        (+= seen 1)))]
                  [_ unit]))))]))
    (for [k (iterator.range 0 seen)]
      (let
        [s : i64 (array-ref slot k)]
        [r : i64 (array-ref dst k)]
        [at : i64 (array-ref site k)]
        [def : i64 (- (array-ref defs s) 1)]
        (if (and
          (< r vars)
          (= (array-ref fills s) (+ at 1))
          (= (array-ref defs r) (+ at 1))
          (>= def 0)
          (=
            (/ def compiler-backend-sret-reuse-block-stride)
            (/ at compiler-backend-sret-reuse-block-stride))
          (< def at)
          (not (compiler-backend-sret-reuse-param? params s)))
          (begin
            (set! (array-ref slot admitted) s)
            (set! (array-ref dst admitted) r)
            (set! (array-ref site admitted) at)
            (+= admitted 1))
          ;; Only admitted slots keep a fill: a refused slot that one call
          ;; fills has no other call filling it.
          (when (> (array-ref fills s) 0) (set! (array-ref fills s) 0)))))
    (CompilerBackendSretReuseCalls slot dst site admitted fills)))

;; Whether every admitted slot `instr` reads (outside phi inputs) was filled
;; earlier in walk order than `at`, and it reads one. A read before its call
;; keeps the whole instruction unrenamed.
(define (compiler-backend-sret-reuse-renames?
  [fills : (& fills (__tl_dyn-array i64))]
  [at : i64]
  [instr : (& instr compiler_ir_types.CompilerIrInstr)]) : bool
  (let
    [ids : (__tl_dyn-array i64) (compiler_liveness.compiler-live-instr-ids)]
    [count : i64 (compiler_liveness.compiler-live-instr-use-ids-nophi! instr)]
    [after : bool false]
    [before : bool false]
    (for [k (iterator.range 0 count)]
      (let
        [v : i64 (array-ref ids k)]
        (when
          (and (>= v 0) (< v (array-length fills)) (> (array-ref fills v) 0))
          (if (<= (array-ref fills v) at)
            (set! after true)
            (set! before true)))))
    (and after (not before))))

;; Entry: the blocks with every admitted slot pointer read after its call
;; renamed, or the input list when none is.
(define (compiler-backend-sret-reuse-blocks
  [program-index : be_state.CompilerBackendProgramIndex]
  [params : (& params compiler_ir_types.CompilerIrParamSeq)]
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (match (& blocks)
    [(Array seq)
      (if (<= vars 0)
        blocks
        (let
          [calls : CompilerBackendSretReuseCalls
            (compiler-backend-sret-reuse-admit program-index params vars seq)]
          (if (= calls.count 0)
            blocks
            (let
              [block-count : i64
                (compiler_ir_types.compiler-ir-block-seq-count seq)]
              [map : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
              [_unmapped : unit
                (for [v (iterator.range 0 vars)]
                  (set! (array-ref map v) -1))]
              [_mapped : unit
                (for [k (iterator.range 0 calls.count)]
                  (set!
                    (array-ref map (array-ref calls.slot k))
                    (array-ref calls.dst k)))]
              [rename : compiler_optimize.OptOperandRewrite
                (compiler_optimize.OptOperandRewrite.Rename map)]
              [rw : compiler_ir_types.CompilerIrInstrRewrite
                (compiler_ir_types.compiler-ir-instr-rewrite-new)]
              [rebuilt : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)
                (__tl_make-array compiler_ir_types.CompilerIrBlock 0)]
              [start : i64 (array-ref calls.site 0)]
              [start-block : i64
                (/ start compiler-backend-sret-reuse-block-stride)]
              (for [b (iterator.range start-block block-count)]
                (match (compiler_ir_types.compiler-ir-block-seq-borrow seq b)
                  [(Block label instrs)
                    (let
                      [base : i64
                        (* b compiler-backend-sret-reuse-block-stride)]
                      [n : i64 instrs.len]
                      [out : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
                        (__tl_make-array compiler_ir_types.CompilerIrInstr 0)]
                      (for [j
                        (iterator.range
                          (if (= b start-block)
                            (+ (- start base) 1)
                            0)
                          n)]
                        (let
                          [instr : (& instrs compiler_ir_types.CompilerIrInstr)
                            (compiler_ir_types.compiler-ir-instr-seq-borrow
                              instrs
                              j)]
                          (when
                            (compiler-backend-sret-reuse-renames?
                              (& calls.fills)
                              (+ base j)
                              instr)
                            (when
                              (= (array-length out) 0)
                              (set!
                                out
                                (__tl_make-array
                                  compiler_ir_types.CompilerIrInstr
                                  n))
                              (for [k (iterator.range 0 n)]
                                (set!
                                  (array-ref out k)
                                  (compiler_ir_types.compiler-ir-instr-seq-ref
                                    instrs
                                    k))))
                            (set!
                              (array-ref out j)
                              (compiler_optimize.opt-rewrite-operands
                                (&mut rw)
                                (& rename)
                                instr)))))
                      (when
                        (> (array-length out) 0)
                        (when
                          (= (array-length rebuilt) 0)
                          (set!
                            rebuilt
                            (__tl_make-array
                              compiler_ir_types.CompilerIrBlock
                              block-count))
                          (for [k (iterator.range 0 block-count)]
                            (set!
                              (array-ref rebuilt k)
                              (compiler_ir_types.compiler-ir-block-seq-ref
                                seq
                                k))))
                        (set!
                          (array-ref rebuilt b)
                          (Block
                            label
                            (compiler_ir_types.CompilerIrInstrSeq out n)))))]))
              (if (= (array-length rebuilt) 0)
                blocks
                (Array
                  (compiler_ir_types.CompilerIrBlockSeq rebuilt block-count)))))))]))

(define (compiler-backend-emit-function
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [func : compiler_ir_types.CompilerIrFunction]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [allow-rbp : bool]
  [shrinkwrap-enabled : bool]
  ;; SW-1 general shrink-wrap placement, threaded through this function's own
  ;; retries. `compiler-ir-label-none` asks for the analysis, a real label
  ;; applies that placement, and `compiler-backend-swb-refused` disables it for
  ;; this function (used when an applied placement no longer reproduces).
  [swb-label : i64]
  [swb-bare : (__tl_dyn-array i64)]) : be_state.ResultCompilerBackend
  (match (be_state.compiler-backend-global-shared-view func)
    [(Function name params ret-ty vars raw-blocks function-abi)
      ;; The provenance fallback diagnostic for this function: backend
      ;; errors raised while emitting its body stamp this function's source span
      ;; (or `1:1` when none was recorded) rather than always `1:1`.
      (let
        ;; Every representation-aware register-allocation view below carries the
        ;; same pre-optimization job capability from `program-index`.
        [backend-state : be_state.CompilerBackendState
          program-index.backend-state]
        [target-policy : be_state.CompilerBackendTargetPolicy
          (be_state.compiler-backend-state-emission-target-policy backend-state)]
        [function-state : be_state.CompilerBackendFunctionState
          (be_state.compiler-backend-state-function-state backend-state)]
        [_current-source-function : unit
          (be_state.compiler-backend-function-scratch-set-i64!
            function-state
            be_state.compiler-backend-scratch-i64-current-source-function
            name)]
        [_sweep-addr-begin : unit
          (be_peephole.compiler-backend-sweep-addr-begin! backend-state)]
        [scalar-registers-enabled : bool
          (be_state.compiler-backend-state-scalar-registers-enabled?
            backend-state)]
        ;; Prefix dry-emission is part of shrink-wrap admission and precedes
        ;; this function's const-hoist build. Fail closed unless its scratch
        ;; state was reset successfully for this function.
        [shrinkwrap-state-admissible? : bool
          (be_scalar.compiler-backend-prepare-shrinkwrap-admission!
            function-state)]
        [_compact-switch : unit
          (be_state.compiler-backend-function-scratch-set-bool!
            function-state
            be_state.compiler-backend-scratch-bool-compact-switch
            (match (& raw-blocks)
              [(Array seq)
                (be_facts.compiler-backend-compact-switch-blocks?
                  backend-state
                  seq)]))]
        ;; GAP9: fold constant gep index offsets into addressing displacements
        ;; BEFORE the register plan, so liveness sees the folded program (the
        ;; shared counter stays live; the offset adds vanish).
        [folded-blocks : compiler_ir_types.CompilerIrBlockList
          (compiler-backend-gep-fold-blocks
            function-state
            type-segment-bases
            vars
            (compiler-backend-sret-reuse-blocks
              program-index
              (& params)
              vars
              raw-blocks))]
        ;; In SSE2 mode, non-SIMD functions demote to Scalar so every downstream
        ;; check (direct stack params, emergency XMM parking, red-zone leaf
        ;; frames, shrinkwrap, cold-call rewrite, %rbp pool, call-hole/loop
        ;; splitting, caller-save rewrite, stack coloring) stays bit-identical
        ;; to scalar mode.
        [function-uses-simd? : bool
          (if (be_state.compiler-backend-mode-sse2? mode)
            (compiler-backend-function-uses-simd?
              (& function-abi)
              (& folded-blocks))
            (not (be_state.compiler-backend-mode-scalar? mode)))]
        [mode : be_state.CompilerBackendMode
          (if (and
            (be_state.compiler-backend-mode-sse2? mode)
            (not function-uses-simd?))
            (Scalar)
            mode)]
        [scalar-pipeline? : bool (be_state.compiler-backend-mode-scalar? mode)]
        ;; Pre-regalloc SIMD algebraic select-add/sub factoring: hoist shared
        ;; `x` out of `select(m, x +- a, x +- b)` so regalloc allocates the
        ;; factored loop (and hoisted negated splats) cleanly.
        [select-factored : be_simd.CompilerBackendSelectFactorResult
          (if scalar-pipeline?
            (SelectFactorResult vars folded-blocks)
            (compiler-backend-select-add-factor-blocks vars folded-blocks))]
        [factored-vars : i64
          (match (& select-factored)
            [(SelectFactorResult out-vars _) out-vars])]
        [factored-blocks : compiler_ir_types.CompilerIrBlockList
          (match select-factored
            [(SelectFactorResult _ out-blocks) out-blocks])]
        ;; Cycle 26: split a property-proven frame-free entry region before
        ;; regalloc. Incoming parameters stay in ABI locations until the saving
        ;; edge, whose returned labels drive prologue placement and bare returns.
        [early-exit-func : compiler_ir_types.CompilerIrFunction
          (let
            [folded-func : compiler_ir_types.CompilerIrFunction
              (Function
                name
                (be_state.compiler-backend-global-shared-view params)
                (be_state.compiler-backend-global-shared-view ret-ty)
                factored-vars
                factored-blocks
                (be_state.compiler-backend-global-shared-view function-abi))]
            (if (and
              shrinkwrap-enabled
              scalar-pipeline?
              scalar-registers-enabled)
              (compiler_regalloc.compiler-reg-early-exit-shrinkwrap-function
                folded-func)
              (begin
                (compiler_regalloc.compiler-reg-early-exit-state-reset!)
                folded-func)))]
        ;; Cycle 20: protect GP values only on one admitted cold call edge.  The
        ;; rewrite follows the early-exit split and still precedes regalloc, so
        ;; liveness sees both transformations.
        [cold-call-rewrite : compiler_regalloc.CompilerRegColdCallRewrite
          (if (and scalar-pipeline? scalar-registers-enabled)
            (compiler_regalloc.compiler-reg-cold-call-rewrite-function-with-representations
              type-segment-bases
              early-exit-func
              (&
                (be_state.compiler-backend-program-index-representations
                  program-index)))
            (Rewrite early-exit-func (- 0 1)))]
        [cold-call-func : compiler_ir_types.CompilerIrFunction
          (compiler_regalloc.compiler-reg-cold-call-rewrite-function-value
            (be_state.compiler-backend-global-shared-view cold-call-rewrite))]
        [blocks : compiler_ir_types.CompilerIrBlockList
          (match (be_state.compiler-backend-global-shared-view cold-call-func)
            [(Function _ _ _ _ out-blocks _) out-blocks])]
        [walk-vars : i64
          (match cold-call-func
            [(Function _ _ _ out-vars _ _) out-vars])]
        [cold-call-temp-start : i64
          (compiler_regalloc.compiler-reg-cold-call-rewrite-temp-start
            (& cold-call-rewrite))]
        [walk-func : compiler_ir_types.CompilerIrFunction
          (Function
            name
            (be_state.compiler-backend-global-shared-view params)
            (be_state.compiler-backend-global-shared-view ret-ty)
            walk-vars
            blocks
            (be_state.compiler-backend-global-shared-view function-abi))]
        [func-diag : compiler_diagnostic.CompilerDiagnostic
          (be_state.compiler-backend-function-diagnostic-index
            span-index
            (compiler_ir_types.compiler-ir-symbol-typed-id name))]
        [_current-mode : unit
          (be_state.compiler-backend-set-current-mode!
            (be_state.compiler-backend-state-function-state
              program-index.backend-state)
            mode)]
        ;; M-G3 stage 2: enable %rbp as the final CSR for this function's plan
        ;; on both text backends. The `allow-rbp` parameter is false only on the
        ;; DEMOTION retry (the FPO audit failed on an rbp-planned function).
        [_rbp-pool-flag : unit
          (compiler_regalloc.compiler-reg-set-rbp-pool-enabled!
            (and
              allow-rbp
              (or target-policy.linux target-policy.windows)
              scalar-pipeline?
              scalar-registers-enabled))]
        [fn-abi : compiler_abi.CompilerRegTargetAbi target-policy.abi]
        [_fn-abi : unit
          (be_state.compiler-backend-set-current-fn-abi!
            program-index.backend-state
            fn-abi)]
        ;; The scalar-opt2 plan and the caller-save rewrite below both need the
        ;; var-type view of `walk-func`. Compute it once here, on exactly the
        ;; path that takes
        ;; both (the stack-only and SIMD plans do not need it, and the
        ;; rewrites are off when scalar registers are).
        [scalar-plan? : bool (and scalar-pipeline? scalar-registers-enabled)]
        [walk-types : compiler_regalloc.CompilerRegVarTypes
          (if scalar-plan?
            (compiler_regalloc.compiler-reg-function-var-types-with-representations-and-metrics
              (& walk-func)
              (&
                (be_state.compiler-backend-program-index-representations
                  program-index))
              (be_state.compiler-backend-state-metrics
                program-index.backend-state))
            (compiler_regalloc.compiler-reg-var-types-empty-with-representations
              (&
                (be_state.compiler-backend-program-index-representations
                  program-index))))]
        [reg-plan : compiler_regalloc.CompilerRegPlan
          (if scalar-pipeline?
            (if scalar-registers-enabled
              (compiler_regalloc.compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types-and-advisory-sink
                type-segment-bases
                fn-abi
                (& walk-func)
                cold-call-temp-start
                walk-types
                (be_state.compiler-backend-state-advisory-sink
                  program-index.backend-state))
              (compiler_regalloc.compiler-reg-plan-function-stack-only-with-representations-and-metrics-and-advisory-sink
                (& walk-func)
                (&
                  (be_state.compiler-backend-program-index-representations
                    program-index))
                (be_state.compiler-backend-state-metrics
                  program-index.backend-state)
                (be_state.compiler-backend-state-advisory-sink
                  program-index.backend-state)))
            (if (or
              (be_state.compiler-backend-mode-avx2? mode)
              (be_state.compiler-backend-mode-sse2? mode))
              (compiler_regalloc.compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi-and-representations-and-metrics-and-advisory-sink
                type-segment-bases
                fn-abi
                (& walk-func)
                (&
                  (be_state.compiler-backend-program-index-representations
                    program-index))
                (be_state.compiler-backend-state-metrics
                  program-index.backend-state)
                (be_state.compiler-backend-state-advisory-sink
                  program-index.backend-state))
              (compiler_regalloc.compiler-reg-plan-function-with-type-segment-bases-for-abi-and-representations-and-metrics-and-advisory-sink
                type-segment-bases
                fn-abi
                (& walk-func)
                (&
                  (be_state.compiler-backend-program-index-representations
                    program-index))
                (be_state.compiler-backend-state-metrics
                  program-index.backend-state)
                (be_state.compiler-backend-state-advisory-sink
                  program-index.backend-state))))]
        ;; Did the cold-call rewrite fire? That is the claim that this
        ;; function's ONLY kind-0 clobber was carried away, which is what lets a
        ;; replan below tell the param ABI-pin gate to ignore the clobber set.
        ;; The call-hole round below also mints forced-to-memory carriers, but it
        ;; leaves every call in place, so the two must not be conflated.
        [cold-call-split? : bool (>= cold-call-temp-start 0)]
        ;; P3: a GP value whose interval spans a call is callee-saved-only in the
        ;; greedy and, once those six are taken, is spilled for its WHOLE
        ;; interval -- every use, including the ones in the hot loop, becomes
        ;; frame traffic. Split such a value's range AROUND each call it is live
        ;; through (store to a stack-only carrier before, reload after) and
        ;; REPLAN, so the pieces are ordinary caller-saved candidates. The round
        ;; declines unless the replan actually registerises the selections and
        ;; the replanned function's estimated cost is strictly lower, so it can
        ;; only ever remove frame traffic.
        [call-hole-split : compiler_regalloc.CompilerRegCallHoleSplit
          (if scalar-plan?
            (compiler_regalloc.compiler-reg-call-hole-split-rewrite-function
              type-segment-bases
              fn-abi
              (& walk-func)
              walk-types
              (& reg-plan)
              cold-call-temp-start)
            (compiler_regalloc.compiler-reg-call-hole-split-none
              walk-func
              walk-vars
              reg-plan
              walk-types
              cold-call-temp-start))]
        ;; The P3 view. P3c below consumes it and produces the FURTHER split
        ;; view everything downstream reads; when P3c declines, the two are the
        ;; same values.
        [hole-func : compiler_ir_types.CompilerIrFunction
          (compiler_regalloc.compiler-reg-call-hole-split-function
            (be_state.compiler-backend-global-shared-view call-hole-split))]
        [hole-vars : i64
          (compiler_regalloc.compiler-reg-call-hole-split-vars
            (& call-hole-split))]
        [hole-types : compiler_regalloc.CompilerRegVarTypes
          (compiler_regalloc.compiler-reg-call-hole-split-types
            (& call-hole-split))]
        [hole-reg-plan : compiler_regalloc.CompilerRegPlan
          (compiler_regalloc.compiler-reg-call-hole-split-plan
            (be_state.compiler-backend-global-shared-view call-hole-split))]
        ;; One forced-spill threshold over EVERY carrier family: the cold-call
        ;; carriers occupy [cold-call-temp-start, walk-vars), the call-hole
        ;; carriers [walk-vars, hole-vars) and the loop-parking carriers
        ;; [hole-vars, split-vars), contiguously.
        [hole-temp-start : i64
          (compiler_regalloc.compiler-reg-call-hole-split-temp-start
            (& call-hole-split))]
        ;; P3c: the greedy homes a value for its WHOLE interval, so a value that
        ;; is live ACROSS a hot inner loop but never referenced in it keeps its
        ;; register through that loop while the loop's own residents spill or
        ;; scavenge. Park such a value at the loop boundary -- store to a
        ;; stack-only carrier in the preheader, reload on the exits -- so its
        ;; range has a hole over the loop, and REPLAN. Like P3 the round keeps
        ;; the rewrite only when the replanned function's estimated cost is
        ;; strictly lower, so it can only ever remove frame traffic.
        ;;
        ;; `cold-call-split?` is passed through rather than pinned false: the
        ;; rewrite adds and removes no call, so the claim the plan it improves on
        ;; was already made with still holds, and the replan stays consistent
        ;; with the plan it is compared against.
        [loop-park-split : compiler_regalloc.CompilerRegCallHoleSplit
          (if scalar-plan?
            (compiler_regalloc.compiler-reg-loop-park-rewrite-function
              type-segment-bases
              fn-abi
              (& hole-func)
              hole-types
              (& hole-reg-plan)
              hole-temp-start
              cold-call-split?
              false)
            (compiler_regalloc.compiler-reg-call-hole-split-none
              hole-func
              hole-vars
              hole-reg-plan
              hole-types
              hole-temp-start))]
        ;; S3: the P3c round again, in SPLIT mode. Where a hot loop's spilled
        ;; resident loses its register to a sprawling value that the loop
        ;; barely reads, split that value around the loop (copy in at the
        ;; preheader, write back on the exits) so it keeps its register
        ;; outside the loop and competes inside it only on its in-loop
        ;; references, and REPLAN. Kept only when the replanned function's
        ;; estimated cost, split copies included, is strictly lower.
        [loop-split : compiler_regalloc.CompilerRegCallHoleSplit
          (if scalar-plan?
            (match loop-park-split
              [(Split park-func _ park-plan park-types park-threshold)
                (compiler_regalloc.compiler-reg-loop-park-rewrite-function
                  type-segment-bases
                  fn-abi
                  (& park-func)
                  park-types
                  (& park-plan)
                  park-threshold
                  cold-call-split?
                  true)])
            loop-park-split)]
        ;; Everything downstream of the initial plan consumes the SPLIT view:
        ;; the caller-save rewrite, storage coloring and emission. When every
        ;; round declines, these are the pre-split values unchanged.
        [split-blocks : compiler_ir_types.CompilerIrBlockList
          (compiler_regalloc.compiler-reg-call-hole-split-blocks (& loop-split))]
        [split-vars : i64
          (compiler_regalloc.compiler-reg-call-hole-split-vars (& loop-split))]
        [split-types : compiler_regalloc.CompilerRegVarTypes
          (compiler_regalloc.compiler-reg-call-hole-split-types (& loop-split))]
        [split-reg-plan : compiler_regalloc.CompilerRegPlan
          (compiler_regalloc.compiler-reg-call-hole-split-plan
            (be_state.compiler-backend-global-shared-view loop-split))]
        ;; The caller-save rewrite runs whenever scalar register allocation is
        ;; enabled.
        [call-save-enabled : bool
          (if scalar-pipeline?
            scalar-registers-enabled
            false)]
        [call-save-rewrite : compiler_regalloc.CompilerRegCallSaveRewrite
          (if call-save-enabled
            (compiler_regalloc.compiler-reg-caller-save-rewrite-blocks
              split-blocks
              split-vars
              split-types
              (& split-reg-plan))
            (Rewrite
              split-blocks
              split-vars
              split-vars
              (compiler_regalloc.compiler-reg-assignment-table-empty)
              (compiler_regalloc.compiler-reg-var-types-empty)))]
        ;; The final pipeline plan, blocks and vars.
        [rewritten-reg-plan : compiler_regalloc.CompilerRegPlan
          (if call-save-enabled
            (compiler_regalloc.compiler-reg-plan-with-call-save-rewrite
              (be_state.compiler-backend-global-shared-view split-reg-plan)
              (& call-save-rewrite))
            split-reg-plan)]
        [rewritten-blocks : compiler_ir_types.CompilerIrBlockList
          (match (be_state.compiler-backend-global-shared-view
            call-save-rewrite)
            [(Rewrite out-blocks _ _ _ _) out-blocks])]
        [rewritten-vars : i64
          (match call-save-rewrite
            [(Rewrite _ _ out-vars _ _) out-vars])]
        ;; Scratch pseudos are not published as ordinary assignments; storage
        ;; coloring stays on the ordinary plan.
        [scratch-vars : i64
          (compiler_regalloc.compiler-reg-plan-var-count
            (& rewritten-reg-plan)
            rewritten-vars)]
        [plan-types : compiler_regalloc.CompilerRegVarTypes
          (compiler_regalloc.compiler-reg-plan-types (& rewritten-reg-plan))]
        ;; Computed once per function: the gate below, the coloring pass, and
        ;; the frame layout all consume it (the per-block fixpoint scan is too
        ;; costly to repeat).
        [fn-group-vars : compiler_liveness.CompilerLiveI64Set
          (compiler_regalloc.compiler-reg-function-group-vars
            type-segment-bases
            (&
              (Function
                name
                (be_state.compiler-backend-global-shared-view params)
                (be_state.compiler-backend-global-shared-view ret-ty)
                scratch-vars
                (be_state.compiler-backend-global-shared-view rewritten-blocks)
                (be_state.compiler-backend-global-shared-view function-abi)))
            plan-types)]
        ;; Address temps the gep fusion peepholes fold into their consumer.
        ;; Computed on the exact blocks and assignments the coloring pass reads,
        ;; so the ids line up; see compiler-backend-gep-fusion-pinned-vars.
        [fusion-pinned-vars : compiler_liveness.CompilerLiveI64Set
          (compiler-backend-gep-fusion-pinned-vars
            scratch-vars
            (be_state.compiler-backend-global-shared-view rewritten-blocks)
            (compiler_regalloc.compiler-reg-plan-assignments
              (& rewritten-reg-plan))
            (and scalar-pipeline? (not scalar-registers-enabled)))]
        ;; SIMD caller lanes and masks, as well as private entry stores, need
        ;; full-width homes under debug info. Scalar debug keeps its raw IDs.
        [color-stack-slots? : bool
          (or
            (not (compiler_ir_types.compiler-debug-info-enabled?))
            (not scalar-pipeline?)
            (compiler_regalloc.compiler-reg-spmd-wide-params? (& params)))]
        [coloring-spans : compiler_ir_types.CompilerSourceSpans
          (if color-stack-slots?
            (be_state.compiler-backend-function-source-spans
              (be_state.compiler-backend-global-shared-view spans)
              (& span-index)
              name)
            (be_state.compiler-backend-global-shared-view spans))]
        ;; Value ids are provenance keys: pin spanned scalars against sharing
        ;; and remap their keys alongside the emitted IR.
        [source-span-pinned-vars : compiler_liveness.CompilerLiveI64Set
          (if color-stack-slots?
            (be_state.compiler-backend-source-span-pinned-vars
              (be_state.compiler-backend-global-shared-view coloring-spans)
              name
              scratch-vars)
            (compiler_liveness.compiler-live-set-empty))]
        [coloring-pinned-vars : compiler_liveness.CompilerLiveI64Set
          (compiler_liveness.compiler-live-set-union
            fusion-pinned-vars
            (be_state.compiler-backend-global-shared-view
              source-span-pinned-vars))]
        ;; Direct caller-frame stack homes for eligible read-only 8-byte
        ;; incoming stack parameters: skip local spill slots during coloring
        ;; and elide their prologue copies.
        [direct-stack-offsets : (__tl_dyn-array i64)
          (if (not color-stack-slots?)
            (__tl_make-array i64 0)
            (compiler-backend-direct-stack-param-offsets
              type-segment-bases
              target
              (if scalar-pipeline?
                (be_state.CompilerBackendMode.Scalar)
                mode)
              scalar-registers-enabled
              name
              (& params)
              (& rewritten-blocks)
              (& rewritten-reg-plan)
              (& fn-group-vars)
              scratch-vars
              rewritten-vars
              program-index))]
        ;; Compact the frame after planning by renumbering stack-resident
        ;; values into a dense slot prefix. Scalar stack-only opt0/opt1 plans
        ;; carry conservative CFG intervals specifically for this pass; plans
        ;; from modes without intervals still pass through unchanged. Only real
        ;; remat vars can demand slots; scratch pseudo-vars are register-only.
        ;; `slot-vars` governs the physical frame; the final logical extent
        ;; below governs remapped per-variable side tables.
        [coloring
          : compiler_regalloc.CompilerRegColoring
          ;; Stack-homed register groups keep word0 in their remapped formula
          ;; slot; word1 indexes the second var-region by the same remapped id.
          ;; That keeps both words inside the `slot-vars`-sized frame rather
          ;; than at high raw ids that would grow it.
          (if (not color-stack-slots?)
            None
            (compiler_regalloc.compiler-reg-color-stack-slots-with-stack-only
              type-segment-bases
              (& rewritten-reg-plan)
              (& fn-group-vars)
              (& params)
              (& rewritten-blocks)
              scratch-vars
              rewritten-vars
              (& coloring-pinned-vars)
              (& direct-stack-offsets)
              (and scalar-pipeline? (not scalar-registers-enabled))))]
        [slot-vars : i64
          (match (be_state.compiler-backend-global-shared-view coloring)
            ;; Synthetic scratch ids are register-only and are not referenced
            ;; by the emitted IR. When stack coloring is unavailable, retain
            ;; the real rewritten var count so scratch ids cannot grow the
            ;; frame merely by numbering temporary register intervals.
            [(None) rewritten-vars]
            [(Remap _ slots) slots])]
        ;; Wide stack ranges can place remapped ids beyond the original plan.
        ;; Register-only ids can remain beyond the compacted frame. Every
        ;; final-IR side table must contain both domains.
        [emit-vars : i64
          (compiler_regalloc.compiler-reg-max scratch-vars slot-vars)]
        [emit-spans : compiler_ir_types.CompilerSourceSpans
          (match (be_state.compiler-backend-global-shared-view coloring)
            [(None) (owned_view.compiler-owned-shared-view coloring-spans)]
            [(Remap remap _)
              (if (>
                (compiler_liveness.compiler-live-set-word-count
                  source-span-pinned-vars)
                0)
                (be_state.compiler-backend-remap-source-spans
                  (be_state.compiler-backend-global-shared-view coloring-spans)
                  name
                  remap)
                (owned_view.compiler-owned-shared-view coloring-spans))])]
        [assignments : compiler_regalloc.CompilerRegAssignmentTable
          (compiler-backend-overlay-direct-stack-params
            (match (be_state.compiler-backend-global-shared-view coloring)
              [(None)
                (compiler_regalloc.compiler-reg-plan-assignments
                  (& rewritten-reg-plan))]
              [(Remap remap _)
                (compiler_regalloc.compiler-reg-color-rebuild-assignments
                  (& remap)
                  emit-vars
                  (compiler_regalloc.compiler-reg-plan-assignments
                    (& rewritten-reg-plan)))])
            (& coloring)
            (& direct-stack-offsets))]
        ;; Install the final authoritative table for direct operand-home lookup
        ;; in large functions. Caller-save and
        ;; slot-coloring re-plans are all folded into this table, so no emission
        ;; view can go stale. Small functions read the same table directly from
        ;; their emission context and avoid the state-wrapper setup.
        [_emit-assignment-index : unit
          (begin
            (if (>= emit-vars 64)
              (begin
                (be_state.compiler-backend-function-state-set-assignment-index!
                  function-state
                  (compiler_regalloc.compiler-reg-assignment-table-with-min-capacity
                    assignments
                    emit-vars))
                (be_state.compiler-backend-function-state-set-bool!
                  function-state
                  be_state.compiler-backend-function-bool-emit-assignment-index-active
                  true))
              (be_state.compiler-backend-function-state-set-bool!
                function-state
                be_state.compiler-backend-function-bool-emit-assignment-index-active
                false))
            ;; Same table, same "fixed before body emission" guarantee: fold the
            ;; plan's register homes into the per-function mask that
            ;; compiler-backend-plan-uses-reg? answers from. Unlike the dense
            ;; index this is installed for EVERY function -- it is one machine
            ;; word, so there is no size threshold to trade against.
            (be_scalar.compiler-backend-set-emit-plan-reg-mask!
              backend-state
              assignments)
            (be_state.compiler-backend-function-state-set-i64!
              function-state
              be_state.compiler-backend-function-i64-rax-override-var
              -1)
            (be_state.compiler-backend-function-state-set-i64!
              function-state
              be_state.compiler-backend-function-i64-rax-forward-pending-var
              -1)
            (compiler-backend-emit-home-overrides-disable! function-state))]
        [scavenge-assignments
          : compiler_regalloc.CompilerRegAssignmentTable
          ;; Start ordinary scavenging from real IR homes. Const-hoist
          ;; homes are appended below with exact intervals; retaining them as
          ;; interval-less pseudo-vars here would reserve each register for the
          ;; entire function and force unrelated sites into emergency saves.
          (match (be_state.compiler-backend-global-shared-view coloring)
            [(None)
              (compiler_regalloc.compiler-reg-plan-assignments
                (& rewritten-reg-plan))]
            [(Remap remap _)
              (compiler_regalloc.compiler-reg-color-rebuild-assignments
                (& remap)
                emit-vars
                (compiler_regalloc.compiler-reg-plan-assignments
                  (& rewritten-reg-plan)))])]
        [colored-blocks : compiler_ir_types.CompilerIrBlockList
          (match (be_state.compiler-backend-global-shared-view coloring)
            [(None) rewritten-blocks]
            [(Remap remap _)
              (compiler_regalloc.compiler-reg-remap-blocks
                (& remap)
                (& rewritten-blocks))])]
        ;; #block-placement: the last word on layout. Every view below --
        ;; scavenge intervals, const-hoist, #jump-forward, phi targets, the
        ;; emission walk itself -- is derived from THIS list, so choosing the
        ;; order here and nowhere later is what keeps them all agreeing with the
        ;; text that comes out.
        ;; Exit and return-arm sinking are full-speed only (not -O1, not -Os),
        ;; and never move the prefix the early-exit shrink-wrap renders by
        ;; index. Scalar registers are on exactly at the full levels.
        [emit-blocks-list : compiler_ir_types.CompilerIrBlockList
          (compiler-backend-placement-blocks
            function-state
            colored-blocks
            (and
              scalar-registers-enabled
              (not
                (be_state.compiler-backend-state-optimize-for-size?
                  backend-state)))
            (compiler_regalloc.compiler-reg-early-exit-prefix-count-current)
            (be_operand.compiler-backend-plan-uses-callee-regs?
              assignments
              backend-state))]
        [symbol : String
          (be_operand.compiler-backend-function-symbol-index program-index name)]
        [inline-memory-name : String
          (if (and
            target-policy.windows
            (be_operand.compiler-backend-index-c-export? program-index name))
            (be_operand.compiler-backend-index-extern-link-symbol
              program-index
              name)
            "")]
        [inline-memory-helper? : bool
          (if (> (string.string-length inline-memory-name) 0)
            (be_facts.compiler-backend-inline-memory-call-name?
              (& inline-memory-name))
            (be_facts.compiler-backend-inline-memory-call-name? (& symbol)))]
        [c-entry : String
          (if (and target-policy.windows (not inline-memory-helper?))
            (be_scalar.compiler-backend-emit-c-export-entry
              type-segment-bases
              target-policy
              program-index
              name
              (& params))
            "")]
        [emit-params : compiler_ir_types.CompilerIrParamSeq
          (match (be_state.compiler-backend-global-shared-view coloring)
            [(None) params]
            [(Remap remap _)
              (compiler_regalloc.compiler-reg-remap-params (& remap) (& params))])]
        ;; RG-1: the registers the FINAL body can name (see
        ;; compiler-backend-plan-body-reg-mask). Computed on the emitted IR and
        ;; the emitted parameter list, in the same var-id domain as
        ;; `assignments`, so it is comparable with the plan mask installed
        ;; above.
        [csr-body-mask : i64
          (if (compiler_regalloc.compiler-reg-debug-trace-homes?)
            (be_scalar.compiler-backend-plan-body-reg-mask
              assignments
              (be_state.compiler-backend-global-shared-view emit-blocks-list)
              (be_state.compiler-backend-global-shared-view emit-params))
            0)]
        [scavenge-selection
          : compiler_regalloc.CompilerRegIntervalSelection
          ;; Scavenge occupancy must be keyed to the FINAL emitted IR at
          ;; instruction precision. The allocator plan intervals predate
          ;; the call-save rewrite and frame slot compaction, and the cheap
          ;; block interval builder can miss within-block live-through scratch
          ;; hazards. The full live-after intervals are the source of truth for
          ;; register-owned values that must not be scavenged.
          ;;
          ;; The SEGMENTED build is used (one walk, same liveness): its coarse
          ;; starts/ends are identical to the plain hull builder's -- the
          ;; block-entry live-in bridge is off, see
          ;; compiler-reg-live-interval-selection-with-live-in -- and its per-var
          ;; segment rows give the occupancy table the allocator's own notion of
          ;; where a register actually carries a live value, instead of a hull
          ;; that saturates every register in a merged body.
          ;;
          ;; The liveness is EDGE-PRECISE, the analysis the allocator assigns
          ;; registers under (LP-1 in compiler_regalloc). A phi input is an
          ;; edge use: it is live to the end of its own predecessor, where the
          ;; edge copies are emitted, and no further. The baseline analysis
          ;; counts it as a use AT THE PHI, so a loop-carried input -- defined
          ;; in the latch, read by the header phi -- becomes upward-exposed on
          ;; the loop-entry path and live from function entry through every
          ;; block laid out before the loop. Its register then reads occupied
          ;; where the allocator has already given it to other values, and
          ;; scratch picks there take the emergency save/restore for nothing.
          ;; The one consumer that leaned on the baseline extent, the phi
          ;; staged-copy proof's target-entry query, gets the phi input homes
          ;; through its edge home mask instead.
          (compiler_regalloc.compiler-reg-with-analysis-scratch
            emit-vars
            (be_state.compiler-backend-global-shared-view emit-blocks-list)
            (if (compiler-backend-assignments-have-register-home?
              scavenge-assignments)
              (let
                [scavenge-func : compiler_ir_types.CompilerIrFunction
                  (Function
                    name
                    (be_state.compiler-backend-global-shared-view emit-params)
                    (be_state.compiler-backend-global-shared-view ret-ty)
                    emit-vars
                    (be_state.compiler-backend-global-shared-view
                      emit-blocks-list)
                    function-abi)]
                (unsafe
                  ;; unsafe: grows the global liveness id buffer here; reset before this arena ends
                  (compiler_regalloc.compiler-reg-live-interval-selection-with-live-in
                    (& scavenge-func)
                    (&
                      (compiler_liveness.compiler-live-analyze-function-edge-precise
                        (& scavenge-func)))
                    false)))
              (compiler_regalloc.CompilerRegIntervalSelection.Selection
                (compiler_regalloc.compiler-reg-interval-seq-empty)
                (compiler_regalloc.compiler-reg-interval-index-build
                  (& (compiler_regalloc.compiler-reg-interval-seq-empty))
                  0))))]
        [scavenge-intervals : compiler_regalloc.CompilerRegIntervalSeq
          (match (be_state.compiler-backend-global-shared-view
            scavenge-selection)
            [(Selection hulls _) hulls])]
        [scavenge-segments : (__tl_dyn-array
          compiler_regalloc.CompilerRegIntervalSeq)
          (match scavenge-selection
            [(Selection _ index) index.segments])]
        [types : compiler_regalloc.CompilerRegVarTypes
          (match (be_state.compiler-backend-global-shared-view coloring)
            [(None) plan-types]
            [(Remap remap _)
              (compiler_regalloc.compiler-reg-color-rebuild-types
                (& remap)
                emit-vars
                plan-types)])]
        [emit-group-vars-base : compiler_liveness.CompilerLiveI64Set
          (match coloring
            [(None) fn-group-vars]
            [(Remap remap _)
              (compiler-backend-remap-group-vars fn-group-vars remap)])]
        [emit-group-vars : compiler_liveness.CompilerLiveI64Set
          (compiler_regalloc.compiler-reg-group-vars-fixpoint
            (&
              (be_calls.compiler-backend-late-group-vars-blocks
                type-segment-bases
                program-index
                emit-group-vars-base
                (be_state.compiler-backend-global-shared-view emit-blocks-list)))
            (& emit-blocks-list))]
        [addressable-group-vars : compiler_liveness.CompilerLiveI64Set
          (if (> (compiler_liveness.compiler-live-set-count emit-group-vars) 0)
            (be_calls.compiler-backend-addressable-group-vars-blocks
              (be_state.compiler-backend-global-shared-view emit-group-vars)
              (be_state.compiler-backend-global-shared-view emit-blocks-list)
              (compiler_liveness.compiler-live-set-empty))
            (compiler_liveness.compiler-live-set-empty))]
        [emit-group-vars-filtered : compiler_liveness.CompilerLiveI64Set
          (be_facts.compiler-backend-const-pack-install!
            type-segment-bases
            program-index
            (& emit-params)
            (& emit-blocks-list)
            emit-group-vars
            (& addressable-group-vars)
            emit-vars)]
        [_group-var-flags : unit
          (begin
            (be_facts.compiler-backend-current-slot-vars-set!
              program-index.backend-state
              slot-vars)
            (be_facts.compiler-backend-group-vars-enable!
              program-index.backend-state
              emit-group-vars-filtered
              addressable-group-vars))]
        [label-scope : String
          (be_facts.compiler-backend-function-label-scope program-index name)]
        [use-counts : (__tl_dyn-array i64) (__tl_make-array i64 emit-vars)]
        [fuse-free-counts : (__tl_dyn-array i64)
          (__tl_make-array i64 emit-vars)]
        [_use-facts : unit
          (compiler-backend-count-block-use-facts
            (be_state.compiler-backend-global-shared-view use-counts)
            (be_state.compiler-backend-global-shared-view fuse-free-counts)
            (be_state.compiler-backend-global-shared-view emit-blocks-list))]
        [identity-tail-forwarder? : bool
          (be_calls.compiler-backend-identity-tail-forwarder?
            type-segment-bases
            target
            name
            (be_state.compiler-backend-global-shared-view emit-params)
            (be_state.compiler-backend-global-shared-view emit-blocks-list)
            program-index)]
        ;; #jump-forward: the shrink-wrap guard prefix rendered just below is a
        ;; textual needle that has to match the emitted body byte for byte. The
        ;; body's forwarding table cannot exist yet -- it reads the const-hoist
        ;; injections built further down -- so clear the lane here: label ids are
        ;; interned program-wide, and a previous function's table would otherwise
        ;; forward this one's labels. The build below refuses the guard region,
        ;; so needle and body still agree once the real table is installed.
        [_jump-forward-clear : unit
          (be_state.compiler-backend-function-state-set-i64-array!
            function-state
            be_state.compiler-backend-function-i64-array-jump-forward
            (__tl_make-array i64 0))]
        ;; SW-1: the general placement is decided by a first emission and
        ;; applied by a second, so an applied placement is already known here.
        ;; Both facts have to be installed before the body is emitted: the
        ;; bare-return set changes what every Return in the bypass renders, and
        ;; the saving label keeps the jump-forward table from forwarding a jump
        ;; past the block the prologue is spliced at.
        [swb-active? : bool
          (compiler_ir_types.compiler-ir-label-some? swb-label)]
        [_swb-install : unit
          (begin
            (be_state.compiler-backend-function-state-set-i64!
              function-state
              be_state.compiler-backend-function-i64-swb-saving-label
              (if swb-active?
                swb-label
                (compiler_ir_types.compiler-ir-label-none)))
            (be_state.compiler-backend-function-state-set-i64-array!
              function-state
              be_state.compiler-backend-function-i64-array-swb-bare-labels
              (if swb-active?
                (owned_view.compiler-owned-shared-view swb-bare)
                (__tl_make-array i64 0))))]
        [shrinkwrap-saving-label : i64
          (compiler_regalloc.compiler-reg-early-exit-saving-label-current)]
        [shrinkwrap-bare-label : String
          (compiler_regalloc.compiler-reg-early-exit-bare-label-current)]
        [shrinkwrap-prefix-count : i64
          (compiler_regalloc.compiler-reg-early-exit-prefix-count-current)]
        [shrinkwrap-planned-guard : String
          (if (or
            (not shrinkwrap-state-admissible?)
            (string.eq shrinkwrap-bare-label ""))
            ""
            (tuple-ref
              (be_scalar.compiler-backend-shrinkwrap-prefix-asm
                type-segment-bases
                target
                (be_state.compiler-backend-global-shared-view emit-params)
                emit-vars
                assignments
                (be_state.compiler-backend-global-shared-view label-scope)
                name
                (be_state.compiler-backend-global-shared-view emit-blocks-list)
                (be_state.compiler-backend-global-shared-view
                  shrinkwrap-bare-label)
                shrinkwrap-prefix-count
                (be_state.compiler-backend-global-shared-view ret-ty)
                program-index
                false
                false)
              0))]
        ;; C40: the early-return guard flip is full-speed only (not -O1, not
        ;; -Os) and Linux-shaped only: Win64 keeps its SEH unwind layout.
        [shrinkwrap-flip? : bool
          (and
            (not (string.eq shrinkwrap-planned-guard ""))
            scalar-registers-enabled
            (not
              (be_state.compiler-backend-state-optimize-for-size? backend-state))
            (not target-policy.seh-unwind)
            (compiler-backend-shrinkwrap-flip-admissible?
              (& emit-blocks-list)
              shrinkwrap-prefix-count))]
        [shrinkwrap-incoming-parts : (Tuple String String)
          (if (or
            (not shrinkwrap-state-admissible?)
            (string.eq shrinkwrap-bare-label ""))
            (tuple "" "")
            (be_scalar.compiler-backend-shrinkwrap-prefix-asm
              type-segment-bases
              target
              (be_state.compiler-backend-global-shared-view emit-params)
              emit-vars
              assignments
              (be_state.compiler-backend-global-shared-view label-scope)
              name
              (be_state.compiler-backend-global-shared-view emit-blocks-list)
              (be_state.compiler-backend-global-shared-view
                shrinkwrap-bare-label)
              shrinkwrap-prefix-count
              (be_state.compiler-backend-global-shared-view ret-ty)
              program-index
              true
              shrinkwrap-flip?))]
        [shrinkwrap-incoming-guard : String
          (if (string.eq (tuple-ref shrinkwrap-incoming-parts 0) "")
            ""
            (str_cat.str-cat
              (tuple-ref shrinkwrap-incoming-parts 0)
              "    # shrinkwrap incoming guard\n"
              ""))]
        ;; The flipped prefix's bare-return clones, placed after the return
        ;; epilogue: nothing falls into them, and they name no frame.
        [shrinkwrap-bare-tail : String (tuple-ref shrinkwrap-incoming-parts 1)]
        [shrinkwrap-candidate? : bool
          (and
            (not
              (and
                (compiler_ir_types.compiler-debug-info-enabled?)
                target-policy.linux))
            shrinkwrap-state-admissible?
            (not
              (=
                shrinkwrap-saving-label
                (compiler_ir_types.compiler-ir-label-none)))
            (not (string.eq shrinkwrap-bare-label ""))
            (not (string.eq shrinkwrap-planned-guard ""))
            (not (string.eq shrinkwrap-incoming-guard ""))
            (not
              (string.eq
                (be_state.compiler-backend-symbol-text-index program-index name)
                "main")))]
        ;; M-F: loop-hoisted divmod magic constants. Built over the FINAL
        ;; emitted IR + the same fresh intervals the scavenge occupancy uses,
        ;; so a hoist register is provably free over its whole loop region and
        ;; the synthetic entries below keep every scavenge away from it.
        ;; Scalar-opt2 text path. The candidate list filters Win64 callee-saved
        ;; %rsi/%rdi while retaining ABI-safe %r8/%r9 and %rbx (frame-homed for
        ;; divmod). An empty plan changes nothing.
        [const-hoist-synth : be_scalar.CompilerBackendConstHoistSynth
          (if (and
            call-save-enabled
            (not identity-tail-forwarder?)
            ;; Guard blocks contain comparisons only. Divmod hoists are placed
            ;; at their loop/body region, which is necessarily beyond the
            ;; saving frontier, so admitted functions retain the same general
            ;; loop-constant optimization as the unwrapped pipeline.
            )
            (be_scalar.compiler-backend-const-hoist-build!
              type-segment-bases
              target
              (be_state.compiler-backend-global-shared-view emit-blocks-list)
              assignments
              (be_state.compiler-backend-global-shared-view scavenge-intervals)
              emit-vars
              (be_scalar.compiler-backend-frame-slots-emergency-max
                slot-vars
                program-index.backend-state)
              function-state
              program-index.backend-state)
            (be_scalar.compiler-backend-const-hoist-disable! function-state))]
        ;; A stack frame alone is sufficient reason to wrap; limiting this to
        ;; plans with callee-saved homes left frame-only functions rewritten but
        ;; still prologued before their guard. Candidate proof plus the verified
        ;; textual splices is the complete activation condition.
        [shrinkwrap-active? : bool shrinkwrap-candidate?]
        ;; Either form places the prologue at an interior label; the general
        ;; form wins the placement when both apply, because SWB-FIX-1 ENFORCES
        ;; that its saving block is at or below form (a)'s frontier: form (a)'s
        ;; saving label is handed to `compiler-backend-swb-plan-for`, which
        ;; refuses any S that the saving block does not dominate (and refuses
        ;; outright when form (a) is active and its saving block does not
        ;; resolve).  The prefix is NOT frame-free by construction -- a guard
        ;; comparing an incoming argument register whose parameter has a
        ;; callee-saved home names a register the saving prologue reads, so it
        ;; joins U -- and without the enforced invariant S could land on that
        ;; guard, above form (a)'s unconditional bare returns.
        [wrap-active? : bool (or shrinkwrap-active? swb-active?)]
        [wrap-saving-label : i64
          (if swb-active?
            swb-label
            shrinkwrap-saving-label)]
        [scavenge-base-vars : i64
          (be_scalar.compiler-backend-const-hoist-extend-vars
            (be_state.compiler-backend-global-shared-view const-hoist-synth)
            emit-vars)]
        [scavenge-base-assignments : compiler_regalloc.CompilerRegAssignmentTable
          (be_scalar.compiler-backend-const-hoist-extend-assignments
            (be_state.compiler-backend-global-shared-view const-hoist-synth)
            emit-vars
            scavenge-assignments)]
        [scavenge-base-intervals : compiler_regalloc.CompilerRegIntervalSeq
          (be_scalar.compiler-backend-const-hoist-extend-intervals
            const-hoist-synth
            emit-vars
            scavenge-intervals)]
        [_scavenge-install-ctx
          : unit
          ;; The logical extent includes widened stack homes and register-only
          ;; ids beyond the physical frame. M-F appends synthetic register-homed
          ;; pseudo-vars so scavenging avoids the hoisted registers inside
          ;; their regions.
          (compiler-backend-scavenge-install-ctx-from-intervals!
            function-state
            scavenge-base-vars
            scavenge-base-assignments
            scavenge-base-intervals
            ;; Rows exist only for the emitted function's own vars; the
            ;; const-hoist pseudo-vars appended above sit past the end of this
            ;; array and fall back to their single-range hulls.
            scavenge-segments)]
        (if inline-memory-helper?
          (let
            [helper-name : String
              (if (> (string.string-length inline-memory-name) 0)
                inline-memory-name
                (string.copy (& symbol)))]
            (Ok
              (be_calls.compiler-backend-emit-inline-memory-helper-function
                target
                symbol
                helper-name)))
          (let
            [_phi-targets : unit
              (be_facts.compiler-backend-function-state-install-phi-targets!
                (be_state.compiler-backend-state-function-state
                  program-index.backend-state)
                (be_facts.compiler-backend-phi-target-labels-for-blocks
                  (be_state.compiler-backend-global-shared-view
                    emit-blocks-list)))]
            ;; #jump-forward: installed unconditionally (empty when the function
            ;; has no jump-only block) so no previous function's table can leak
            ;; into this one. Reads only the register plan and the const-hoist
            ;; table, both fixed above, so the result is as deterministic as the
            ;; assignment it derives from.
            [_jump-forward : unit
              (be_state.compiler-backend-function-state-set-i64-array!
                (be_state.compiler-backend-state-function-state
                  program-index.backend-state)
                be_state.compiler-backend-function-i64-array-jump-forward
                (be_calls.compiler-backend-jump-forward-build
                  program-index.backend-state
                  assignments
                  (be_state.compiler-backend-global-shared-view
                    emit-blocks-list)))]
            ;; Must precede the parameter spills: those store incoming registers
            ;; into frame slots, and their references have to count.
            [_frame-slot-flag : unit
              (compiler-backend-frame-slot-referenced-reset! function-state)]
            ;; Copy thunks: the fact that decides whether a copy may become a
            ;; `call` (see compiler-backend-function-bool-has-returning-call).
            [_copy-thunk-call-ok : unit
              (be_state.compiler-backend-function-state-set-bool!
                function-state
                be_state.compiler-backend-function-bool-has-returning-call
                (compiler-backend-blocks-have-returning-call?
                  (compiler_ir_types.compiler-ir-block-list-view
                    emit-blocks-list)))]
            [spills
              (try
                (if identity-tail-forwarder?
                  (be_state.ResultCompilerBackend.Ok "")
                  (if (compiler-backend-spmd-private-function?
                    program-index.backend-state
                    name)
                    (compiler-backend-emit-spmd-private-param-spills
                      type-segment-bases
                      target
                      assignments
                      (be_state.compiler-backend-global-shared-view emit-params)
                      slot-vars
                      program-index.backend-state)
                    (compiler-backend-emit-param-spills
                      type-segment-bases
                      target
                      assignments
                      (be_state.compiler-backend-global-shared-view emit-params)
                      0
                      0
                      0
                      0
                      program-index
                      slot-vars
                      program-index.backend-state))))]
            [_addr-forward : unit
              (compiler-backend-addr-of-forwarding-enable!
                program-index.backend-state
                emit-vars
                (& emit-params)
                (be_state.compiler-backend-global-shared-view emit-blocks-list)
                (be_state.compiler-backend-global-shared-view use-counts))]
            [_fuse-need : unit
              (compiler-backend-fuse-need-enable!
                program-index.backend-state
                (be_state.compiler-backend-global-shared-view use-counts)
                fuse-free-counts)]
            [_shift-count-bounds : unit
              (be_state.compiler-backend-function-state-set-i64-array!
                (be_state.compiler-backend-state-function-state
                  program-index.backend-state)
                be_state.compiler-backend-function-i64-array-shift-count-bounds
                (be_scalar.compiler-backend-shift-count-bounds
                  emit-vars
                  emit-params
                  (be_state.compiler-backend-global-shared-view
                    emit-blocks-list)))]
            [_identity-tail-forwarder : unit
              (be_state.compiler-backend-function-state-set-bool!
                (be_state.compiler-backend-state-function-state
                  program-index.backend-state)
                be_state.compiler-backend-function-bool-identity-tail-forwarder-active
                identity-tail-forwarder?)]
            [_shrinkwrap-return : unit
              (be_state.compiler-backend-function-state-set-string!
                (be_state.compiler-backend-state-function-state
                  program-index.backend-state)
                be_state.compiler-backend-function-string-shrinkwrap-bare-label
                (if shrinkwrap-active?
                  shrinkwrap-bare-label
                  ""))]
            [outgoing-frame-space : i64
              (be_calls.compiler-backend-outgoing-frame-space
                type-segment-bases
                target
                (be_state.compiler-backend-global-shared-view emit-blocks-list)
                plan-types
                (be_state.compiler-backend-global-shared-view global-types)
                program-index)]
            ;; The base the dynamic bottom-of-frame slots (cycle temps,
            ;; emergency spill) count down from: the maximum callee-save
            ;; area, and NOTHING else. The outgoing stack-arg area is
            ;; addressed from %rsp (0(%rsp) upward) and therefore occupies
            ;; the very bottom of the frame, so adding it here would push
            ;; the dynamic slots INTO it -- with the max emergency depth
            ;; the last slot landed exactly on outgoing argument 0, and an
            ;; emergency save taken while marshalling a call with stack
            ;; args was then overwritten by the argument it was protecting.
            ;; The frame total below still accounts for the outgoing area
            ;; separately, so the layout from the bottom is
            ;; [outgoing][cycle temps + emergency][slots] and the frame
            ;; SIZE is unchanged.
            [dynamic-frame-base : i64
              (be_facts.compiler-backend-frame-size
                (+
                  (be_scalar.compiler-backend-frame-slots-emergency-max
                    slot-vars
                    program-index.backend-state)
                  (be_state.compiler-backend-function-scratch-i64
                    function-state
                    be_state.compiler-backend-scratch-i64-const-hoist-frame-count)))]
            ;; The SIMD staging region (#7497) sits directly below the
            ;; base, above the cycle temps and emergency slots, which
            ;; move down by its size. A function whose body stages
            ;; nothing plans 0 bytes and keeps its layout.
            [simd-scratch-bytes : i64
              (be_scalar.compiler-backend-simd-scratch-census
                (be_state.compiler-backend-global-shared-view emit-blocks-list)
                (be_state.compiler-backend-function-state-current-mode
                  function-state))]
            [dynamic-slot-base : i64 (+ dynamic-frame-base simd-scratch-bytes)]
            [_emergency-init : unit
              (begin
                (be_scalar.compiler-backend-simd-scratch-plan!
                  function-state
                  simd-scratch-bytes
                  dynamic-frame-base)
                (be_state.compiler-backend-function-scratch-set-i64!
                  function-state
                  be_state.compiler-backend-scratch-i64-cycle-temp-used-count
                  0)
                (be_state.compiler-backend-function-scratch-set-i64!
                  function-state
                  be_state.compiler-backend-scratch-i64-cycle-temp-base-offset
                  (- 0 (+ dynamic-slot-base 8)))
                (be_state.compiler-backend-function-scratch-set-bool!
                  function-state
                  be_state.compiler-backend-scratch-bool-emergency-used
                  false)
                (be_state.compiler-backend-function-scratch-set-bool!
                  function-state
                  be_state.compiler-backend-scratch-bool-emergency-pending
                  false)
                (be_state.compiler-backend-function-scratch-set-bool!
                  function-state
                  be_state.compiler-backend-scratch-bool-emergency-restore-suppressed
                  false)
                (be_state.compiler-backend-function-scratch-set-i64!
                  function-state
                  be_state.compiler-backend-scratch-i64-emergency-used-count
                  0)
                (be_state.compiler-backend-function-scratch-set-i64!
                  function-state
                  be_state.compiler-backend-scratch-i64-emergency-pending-count
                  0)
                (be_state.compiler-backend-function-scratch-set-i64-array!
                  function-state
                  be_state.compiler-backend-scratch-i64-array-emergency-regs
                  (__tl_make-array i64 0))
                (be_state.compiler-backend-function-scratch-set-i64-array!
                  function-state
                  be_state.compiler-backend-scratch-i64-array-emergency-save-locs
                  (__tl_make-array i64 0))
                (be_state.compiler-backend-function-scratch-set-i64!
                  function-state
                  be_state.compiler-backend-scratch-i64-emergency-slot-offset
                  (-
                    0
                    (+
                      dynamic-slot-base
                      (+
                        (be_scalar.compiler-backend-cycle-temp-frame-extra
                          (be_scalar.compiler-backend-cycle-temp-max-slots))
                        (be_scalar.compiler-backend-emergency-slot-size))))))]
            (match (compiler-backend-emit-blocks
              type-segment-bases
              (be_state.compiler-backend-global-shared-view label-scope)
              name
              (be_state.compiler-backend-global-shared-view emit-blocks-list)
              (be_state.compiler-backend-global-shared-view emit-blocks-list)
              assignments
              slot-vars
              types
              (be_state.compiler-backend-global-shared-view global-types)
              ret-ty
              plan
              (be_state.compiler-backend-global-shared-view functions)
              (be_state.compiler-backend-global-shared-view externs)
              program-index
              emit-spans
              (be_state.compiler-backend-global-shared-view span-index)
              (be_state.compiler-backend-global-shared-view func-diag)
              use-counts)
              [(Ok body)
                ;; GAP9 drift check: every Gep must have consumed its
                ;; ordinal, and consumed it with a matching shape. Either
                ;; half failing means a displacement could have been
                ;; misapplied, so fail the compile loudly instead of
                ;; emitting wrong addressing. The SIMD staging plan is
                ;; checked the same way: the census must have sized the
                ;; region to exactly what the body claimed.
                (if (or
                  (compiler-backend-gep-fold-audit-failed? function-state)
                  (be_scalar.compiler-backend-simd-scratch-drift?
                    function-state))
                  (be_state.compiler-backend-instr-error
                    func-diag
                    (str_cat.str-cat
                      (if (compiler-backend-gep-fold-audit-failed?
                        function-state)
                        "backend: gep displacement ordinal drift"
                        (compiler-backend-simd-scratch-drift-message
                          function-state))
                      " in "
                      (be_state.compiler-backend-symbol-text-index
                        program-index
                        name)))
                  (let
                    [dynamic-frame-extra : i64
                      (+
                        simd-scratch-bytes
                        (be_scalar.compiler-backend-cycle-temp-frame-extra-needed
                          (be_state.compiler-backend-function-scratch-i64
                            function-state
                            be_state.compiler-backend-scratch-i64-cycle-temp-used-count)
                          (be_state.compiler-backend-function-scratch-bool?
                            function-state
                            be_state.compiler-backend-scratch-bool-emergency-used))
                        (be_scalar.compiler-backend-emergency-frame-extra
                          (be_state.compiler-backend-function-scratch-i64
                            function-state
                            be_state.compiler-backend-scratch-i64-emergency-used-count)))]
                    [frame : i64
                      (+
                        (+
                          (be_facts.compiler-backend-frame-size
                            (+
                              (if (or
                                (be_state.compiler-backend-function-scratch-bool?
                                  function-state
                                  be_state.compiler-backend-scratch-bool-emergency-used)
                                (>
                                  (be_state.compiler-backend-function-scratch-i64
                                    function-state
                                    be_state.compiler-backend-scratch-i64-cycle-temp-used-count)
                                  0)
                                (>
                                  (be_state.compiler-backend-function-scratch-i64
                                    function-state
                                    be_state.compiler-backend-scratch-i64-const-hoist-frame-count)
                                  0)
                                (> simd-scratch-bytes 0))
                                ;; A dynamic bottom-of-frame slot was used:
                                ;; reserve the max callee-save area so those
                                ;; slots never overlap on-demand CSR saves.
                                (be_scalar.compiler-backend-frame-slots-emergency-max
                                  slot-vars
                                  program-index.backend-state)
                                ;; Nothing named a frame slot: the slot
                                ;; region is dead. Leaf helpers stop paying
                                ;; sub/add for a frame they never touch.
                                ;; Outgoing stack args are %rsp-relative
                                ;; and stay accounted separately below.
                                ;; The call term asks about RETURNING calls
                                ;; only: a tail transfer leaves through the
                                ;; epilogue with the entry %rsp restored,
                                ;; so it can no more use a slot region than
                                ;; a leaf can. Its own stack argument space
                                ;; is in outgoing-frame-space above.
                                ;; Windows has no red zone: a function that
                                ;; saves callee registers into the slot
                                ;; region keeps it, so no save lands below
                                ;; %rsp and every save is described at a
                                ;; nonnegative offset from the allocation.
                                (if (or
                                  (be_state.compiler-backend-function-state-bool?
                                    function-state
                                    be_state.compiler-backend-function-bool-frame-slot-referenced)
                                  (> outgoing-frame-space 0)
                                  (compiler-backend-blocks-have-returning-call?
                                    (compiler_ir_types.compiler-ir-block-list-view
                                      emit-blocks-list))
                                  (and
                                    target-policy.windows
                                    (be_operand.compiler-backend-plan-uses-callee-regs?
                                      assignments
                                      program-index.backend-state)))
                                  (be_scalar.compiler-backend-frame-slots-with-groups
                                    slot-vars
                                    assignments
                                    program-index.backend-state)
                                  0))
                              (be_state.compiler-backend-function-scratch-i64
                                function-state
                                be_state.compiler-backend-scratch-i64-const-hoist-frame-count)))
                          outgoing-frame-space)
                        dynamic-frame-extra)]
                    [_addr-forward-done : unit
                      (begin
                        (be_state.compiler-backend-function-state-set-bool!
                          (be_state.compiler-backend-state-function-state
                            program-index.backend-state)
                          be_state.compiler-backend-function-bool-identity-tail-forwarder-active
                          false)
                        (compiler-backend-addr-of-forwarding-disable!
                          program-index.backend-state)
                        (be_facts.compiler-backend-group-vars-disable!
                          program-index.backend-state)
                        (compiler-backend-fuse-need-disable!
                          program-index.backend-state)
                        (compiler-backend-gep-fold-disable! function-state))]
                    [saving-prologue-body : String
                      (str_cat.str-cat
                        (be_scalar.compiler-backend-emit-save-callee-regs
                          assignments
                          slot-vars
                          program-index.backend-state)
                        (compiler-backend-emit-windows-main-argv-capture
                          target
                          (be_state.compiler-backend-symbol-text-index
                            program-index
                            name)
                          emit-entry
                          plan)
                        (compiler-backend-emit-linux-crt-main-argv-capture
                          target
                          (be_state.compiler-backend-symbol-text-index
                            program-index
                            name)
                          crt-entry
                          plan)
                        (if (and
                          (string.eq
                            (be_state.compiler-backend-symbol-text-index
                              program-index
                              name)
                            "main")
                          (or
                            target-policy.windows
                            (and crt-entry target-policy.linux)))
                          (be_data.compiler-backend-global-initializers
                            type-segment-bases
                            target
                            (be_state.compiler-backend-global-shared-view
                              globals)
                            program-index)
                          "")
                        spills
                        "")]
                    ;; SW-1: the saving prologue runs at the placement's
                    ;; saving edge, so a bypass block emitted ahead of it
                    ;; may neither read a parameter home it has not
                    ;; written yet nor clobber an incoming argument
                    ;; register it still has to read. Every such register
                    ;; is named in this text; a block naming one of them
                    ;; joins U and pushes the placement above itself.
                    [swb-prologue-mask : i64
                      (compiler-backend-swb-text-reg-mask saving-prologue-body)]
                    [saving-asm-label : String
                      (be_operand.compiler-backend-asm-label
                        (be_state.compiler-backend-global-shared-view
                          label-scope)
                        wrap-saving-label)]
                    [guarded-body : String
                      (if shrinkwrap-active?
                        (string.replace
                          (be_state.compiler-backend-global-shared-view body)
                          (be_state.compiler-backend-global-shared-view
                            shrinkwrap-planned-guard)
                          shrinkwrap-incoming-guard)
                        (owned_view.compiler-owned-shared-view body))]
                    [framed-body : String
                      (if wrap-active?
                        (let
                          [label-line : String
                            (str_cat.str-cat saving-asm-label ":\n" "")]
                          (string.replace
                            (be_state.compiler-backend-global-shared-view
                              guarded-body)
                            (be_state.compiler-backend-global-shared-view
                              label-line)
                            (str_cat.str-cat label-line saving-prologue-body "")))
                        (str_cat.str-cat saving-prologue-body guarded-body ""))]
                    [post-prologue : String
                      (str_cat.str-cat
                        (compiler-backend-mode-prologue mode)
                        framed-body
                        (be_calls.compiler-backend-return-epilogue
                          program-index.backend-state
                          name
                          assignments
                          slot-vars
                          (be_state.compiler-backend-global-shared-view
                            emit-blocks-list))
                        (if shrinkwrap-active?
                          shrinkwrap-bare-tail
                          ""))]
                    ;; The alignment duty is a property of the FINAL text,
                    ;; not of the IR: the prologue splice above adds the
                    ;; callee-save saves, the argv capture and (for `main`)
                    ;; the global initializers, and the body itself plants
                    ;; runtime helper calls no `Call` instruction names.
                    ;; Scanning `post-prologue` sees every one of them, and
                    ;; it is available here because the body is emitted
                    ;; before the prologue string is built.
                    [_call-align : unit
                      (be_state.compiler-backend-function-state-set-bool!
                        function-state
                        be_state.compiler-backend-function-bool-call-align-needed
                        (be_peephole.compiler-backend-text-has-call-needing-align?
                          post-prologue
                          (not target-policy.linux-syscall)))]
                    ;; M-G3 stage 2: attempt frame-pointer omission on both
                    ;; text backends. Win64's FPO prologue emits explicit
                    ;; push/stack/XMM SEH unwind codes and the audit rejects
                    ;; any body whose rsp shape cannot stay unwind-stable.
                    [fpo-target : bool
                      (or target-policy.linux target-policy.windows)]
                    ;; GAP1: push-style CSR saves ride the FPO audit --
                    ;; the plan-saved CSR set is fixed pre-body (the
                    ;; scavenger only hands out plan-saved callee regs;
                    ;; emergency picks are wrapped locally), so the push
                    ;; prologue below and the pass's save-deletion /
                    ;; epilogue rewrites see the same registers. On audit
                    ;; failure the ORIGINAL text (mov saves intact) feeds
                    ;; the stage-1 keep-rbp fallback unchanged.
                    [push-regs : (__tl_dyn-array String)
                      (be_peephole.compiler-backend-rsp-rebase-make-push-regs)]
                    [push-count : i64
                      (if fpo-target
                        (compiler-backend-fill-push-csr-regs!
                          assignments
                          (&mut push-regs)
                          program-index.backend-state)
                        0)]
                    ;; RG-1: the callee-saved summary line, emitted where
                    ;; the save set is final (the const-hoist and
                    ;; emergency scratch reservations that also force a
                    ;; save are settled by body emission, which has run).
                    [_trace-csr : unit
                      (if (compiler_regalloc.compiler-reg-debug-trace-homes?)
                        (be_scalar.compiler-backend-trace-csr-line!
                          program-index.backend-state
                          (be_state.compiler-backend-symbol-text-index
                            program-index
                            name)
                          assignments
                          csr-body-mask
                          push-count)
                        unit)]
                    ;; Win64 UWOP_SAVE_XMM128 encodes its stack offset in
                    ;; 16-byte units. An even GP-push count leaves the
                    ;; canonical frame slots at rsp+8 (mod 16), so retain
                    ;; the rbp frame for that uncommon mixed shape. GP-only
                    ;; functions and odd-push XMM functions remain FPO.
                    [fpo-attempt : bool
                      (and
                        (not
                          (and
                            (compiler_ir_types.compiler-debug-info-enabled?)
                            target-policy.linux))
                        fpo-target
                        (or
                          (not
                            (and
                              target-policy.windows
                              (be_operand.compiler-backend-plan-uses-win64-xmm-callee-regs?
                                assignments
                                program-index.backend-state)))
                          (= (bit-and push-count 1) 1)))]
                    [_fpo-bare : unit
                      (be_state.compiler-backend-function-state-set-bool!
                        function-state
                        be_state.compiler-backend-function-bool-fpo-bare-frame
                        (and
                          fpo-attempt
                          (= push-count 0)
                          (= frame 0)
                          (not
                            (be_state.compiler-backend-function-state-bool?
                              function-state
                              be_state.compiler-backend-function-bool-frame-slot-referenced))
                          (not
                            (be_state.compiler-backend-function-state-bool?
                              function-state
                              be_state.compiler-backend-function-bool-call-align-needed))))]
                    ;; GAP1 corollary: in PUSH mode the callee-save slot
                    ;; region is never written -- the rebase deletes the
                    ;; mov save/restore pairs and rewrites the pop-run
                    ;; leaq, so the pushes carry those registers instead.
                    ;; A function whose ONLY frame references were those
                    ;; slots therefore names nothing in the frame at all,
                    ;; and its slot region is as dead as a frameless
                    ;; leaf's. The alignment the region would supply is
                    ;; not lost: `S = frame + (n odd ? 0 : 8)` still holds
                    ;; the total displacement at `D % 16 == 8` for any
                    ;; frame, so every call in the body stays aligned.
                    ;; Every other frame consumer must be absent for the
                    ;; region to be droppable outright: outgoing stack
                    ;; args and the dynamic emergency/cycle-temp/const-
                    ;; hoist reservations are %rsp- or bottom-of-frame
                    ;; relative and are sized into `frame` separately, and
                    ;; Win64 XMM callee slots are real frame words the
                    ;; push prologue does not absorb.
                    ;; This value is used ONLY on the FPO path: the
                    ;; keep-rbp fallback below re-renders from
                    ;; `post-prologue` with the full `frame`, where the
                    ;; mov saves are still present and still need slots.
                    [fpo-frame-full : i64
                      (if (and
                        fpo-attempt
                        (> push-count 0)
                        (not
                          (be_state.compiler-backend-function-state-bool?
                            function-state
                            be_state.compiler-backend-function-bool-nonsave-frame-slot-referenced))
                        (= outgoing-frame-space 0)
                        (= dynamic-frame-extra 0)
                        (=
                          (be_state.compiler-backend-function-scratch-i64
                            function-state
                            be_state.compiler-backend-scratch-i64-const-hoist-frame-count)
                          0)
                        (not
                          (be_state.compiler-backend-function-scratch-bool?
                            function-state
                            be_state.compiler-backend-scratch-bool-emergency-used))
                        (=
                          (be_state.compiler-backend-function-scratch-i64
                            function-state
                            be_state.compiler-backend-scratch-i64-cycle-temp-used-count)
                          0)
                        (<
                          (be_operand.compiler-backend-win64-xmm-callee-highest
                            assignments
                            program-index.backend-state)
                          0))
                        0
                        frame)]
                    ;; T1-6 (a): red-zone decision. It reads the FINAL
                    ;; text (for the returning-call census and for the
                    ;; body's own deepest stack dip) and the frame size
                    ;; the FPO path will really use, so it must sit
                    ;; between `fpo-frame` and the rebase, whose biases
                    ;; and whose prologue both consult it.
                    [_red-zone : unit
                      (be_peephole.compiler-backend-red-zone-decide!
                        program-index.backend-state
                        post-prologue
                        fpo-attempt
                        fpo-frame-full
                        outgoing-frame-space
                        wrap-active?)]
                    ;; Push mode leaves the callee-save slot band between the
                    ;; var slots and the bottom-of-frame regions unwritten.
                    ;; Squeezing it out moves the hottest var slots (the
                    ;; frame order puts them lowest) into disp8 range. Only
                    ;; whole 16-byte units go, so the frame keeps its
                    ;; alignment. A failed audit keeps the full frame.
                    [squeeze-slots : i64
                      (if (and
                        fpo-attempt
                        (> push-count 0)
                        (> fpo-frame-full 0)
                        (not wrap-active?)
                        ;; Win64 XMM callee saves are real frame words in
                        ;; the band; the pushes absorb only GP saves.
                        (<
                          (be_operand.compiler-backend-win64-xmm-callee-highest
                            assignments
                            program-index.backend-state)
                          0)
                        (not
                          (be_operand.compiler-backend-red-zone?
                            program-index.backend-state)))
                        (-
                          (be_operand.compiler-backend-frame-slots
                            slot-vars
                            assignments
                            program-index.backend-state)
                          slot-vars)
                        0)]
                    [squeeze-attempt : i64 (bit-and (* 8 squeeze-slots) -16)]
                    [rebase-result : be_peephole.CompilerBackendRspRebaseResult
                      (be_peephole.compiler-backend-rsp-rebase-full-result-squeezed
                        (be_state.compiler-backend-global-shared-view
                          post-prologue)
                        (- fpo-frame-full squeeze-attempt)
                        fpo-attempt
                        (be_state.compiler-backend-global-shared-view push-regs)
                        push-count
                        slot-vars
                        squeeze-attempt
                        program-index.backend-state)]
                    [frame-squeeze : i64
                      (if rebase-result.ok
                        squeeze-attempt
                        0)]
                    [fpo-frame : i64 (- fpo-frame-full frame-squeeze)]
                    ;; RG-1 fix B. The first pass reported which
                    ;; callee-saved registers the body actually names;
                    ;; anything it saves but never names is a push and a
                    ;; pop paid on every call for nothing. Re-run the pass
                    ;; with those registers out of the PUSH set (the save
                    ;; set is unchanged, so their save/restore movqs are
                    ;; still deleted and their epilogue pops go with
                    ;; them). Held back on a Win64 function that also
                    ;; saves XMM callee registers: `fpo-attempt` admitted
                    ;; it on the PARITY of the push count, and the
                    ;; UWOP_SAVE_XMM128 offsets it implies are already
                    ;; baked into the emitted body.
                    [csr-trim-ok? : bool
                      (and
                        rebase-result.ok
                        fpo-attempt
                        (> push-count 0)
                        (not
                          (and
                            target-policy.windows
                            (be_operand.compiler-backend-plan-uses-win64-xmm-callee-regs?
                              assignments
                              program-index.backend-state))))]
                    [trim-regs : (__tl_dyn-array String)
                      (if csr-trim-ok?
                        (be_peephole.compiler-backend-csr-trimmed-push-regs
                          (be_state.compiler-backend-global-shared-view
                            push-regs)
                          rebase-result.csr-ref-mask
                          program-index.backend-state)
                        (be_peephole.compiler-backend-rsp-rebase-make-push-regs))]
                    [trim-count : i64
                      (if csr-trim-ok?
                        (compiler-backend-csr-push-reg-count
                          (be_state.compiler-backend-global-shared-view
                            trim-regs))
                        push-count)]
                    [trim-attempt? : bool (< trim-count push-count)]
                    [trim-result : be_peephole.CompilerBackendRspRebaseResult
                      (if trim-attempt?
                        (be_peephole.compiler-backend-rsp-rebase-full-result-with-saves
                          (be_state.compiler-backend-global-shared-view
                            post-prologue)
                          fpo-frame
                          fpo-attempt
                          (be_state.compiler-backend-global-shared-view
                            trim-regs)
                          trim-count
                          (be_state.compiler-backend-global-shared-view
                            push-regs)
                          push-count
                          slot-vars
                          frame-squeeze
                          program-index.backend-state)
                        (be_peephole.CompilerBackendRspRebaseResult "" false 0))]
                    ;; A trimmed run that fails the audit changes nothing:
                    ;; the untrimmed text is used and the function keeps
                    ;; the frame it had.
                    [use-trim? : bool (and trim-attempt? trim-result.ok)]
                    [final-push-regs : (__tl_dyn-array String)
                      (if use-trim?
                        trim-regs
                        push-regs)]
                    [final-push-count : i64
                      (if use-trim?
                        trim-count
                        push-count)]
                    [rebased : String
                      (if use-trim?
                        trim-result.text
                        rebase-result.text)]
                    [rebase-ok : bool rebase-result.ok]
                    [fpo-ok : bool (and fpo-attempt rebase-ok)]
                    ;; Form (a) must not turn a SysV leaf's red-zone slots into
                    ;; a frame when it has no save pushes to bypass. An already
                    ;; empty frame keeps the rewrite's useful guard placement.
                    ;; Query the ordinary layout without changing wrapped state;
                    ;; refusal below retries the original IR and register plan.
                    [shrinkwrap-frameless? : bool
                      (and
                        shrinkwrap-active?
                        fpo-ok
                        (= final-push-count 0)
                        (>=
                          (be_peephole.compiler-backend-red-zone-guard-for
                            program-index.backend-state
                            post-prologue
                            fpo-ok
                            fpo-frame
                            outgoing-frame-space
                            false)
                          0))]
                    ;; A failed audit falls back to the rbp frame, whose
                    ;; prologue moves %rsp again: retract the red-zone
                    ;; fact so no later reader (prologue, sweep record)
                    ;; describes a layout this function did not emit.
                    [_red-zone-retract : unit
                      (if fpo-ok
                        unit
                        (be_state.compiler-backend-function-state-set-bool!
                          function-state
                          be_state.compiler-backend-function-bool-red-zone
                          false))]
                    (if (and
                      (not fpo-ok)
                      (be_operand.compiler-backend-plan-uses-reg?
                        backend-state
                        assignments
                        compiler_abi.compiler-reg-id-rbp))
                      ;; DEMOTE: the FPO audit failed but the plan homes a
                      ;; value in %rbp (which has no frame base to fall
                      ;; back to) -- re-plan and re-emit without %rbp in
                      ;; the pool. The retry cannot demote again
                      ;; (allow-rbp=false => no %rbp homes).
                      (begin
                        (cfg
                          test
                          (be_state.compiler-backend-metric-add!
                            backend-state
                            be_state.compiler-backend-fpo-demote-metric
                            1)
                          unit)
                        ;; DEMOTE retry: re-plan/re-emit without %rbp in the
                        ;; pool (allow-rbp=false => no %rbp homes, so it
                        ;; cannot demote again).
                        (compiler-backend-emit-function
                          type-segment-bases
                          target
                          mode
                          func
                          functions
                          globals
                          global-types
                          externs
                          plan
                          program-index
                          spans
                          span-index
                          emit-entry
                          crt-entry
                          false
                          shrinkwrap-enabled
                          swb-label
                          swb-bare))
                      (let
                        [final-body : String
                          (if fpo-ok
                            rebased
                            (if fpo-attempt
                              ;; FPO audit failed with no %rbp in the
                              ;; plan: retain the stage-1 rbp frame.
                              (be_peephole.compiler-backend-rsp-rebase
                                post-prologue
                                frame
                                false
                                program-index.backend-state)
                              rebased))]
                        ;; SW-1: the placement analysis reads the FINAL
                        ;; text -- prologue not yet spliced, rsp rebased,
                        ;; FPO decided -- so every frame and callee-saved
                        ;; reference the emitter introduced on its own is
                        ;; visible to it. A function with no param spill
                        ;; is the only shape whose bypass can be emitted
                        ;; verbatim before the prologue: with spills the
                        ;; bypass would read a parameter from a home the
                        ;; saving edge has not written yet. `main`, the
                        ;; Windows unwind program, the debug-info CFI
                        ;; program and a red-zone frame each keep entry
                        ;; placement.
                        [swb-candidate? : bool
                          (and
                            shrinkwrap-enabled
                            target-policy.linux
                            scalar-pipeline?
                            scalar-registers-enabled
                            (not
                              (compiler_ir_types.compiler-debug-info-enabled?))
                            (not
                              (be_state.compiler-backend-current-fn-win64?
                                program-index.backend-state))
                            (not identity-tail-forwarder?)
                            (not
                              (be_state.compiler-backend-function-state-bool?
                                function-state
                                be_state.compiler-backend-function-bool-red-zone))
                            (or
                              (> final-push-count 0)
                              (>
                                (if fpo-ok
                                  fpo-frame
                                  frame)
                                0))
                            (not
                              (string.eq
                                (be_state.compiler-backend-symbol-text-index
                                  program-index
                                  name)
                                "main")))]
                        [swb-plan : CompilerBackendSwbPlan
                          (if (and
                            swb-candidate?
                            (or
                              swb-active?
                              (=
                                swb-label
                                (compiler_ir_types.compiler-ir-label-none))))
                            (compiler-backend-swb-plan-for
                              final-body
                              (be_state.compiler-backend-global-shared-view
                                label-scope)
                              (be_scalar.compiler-backend-return-label
                                program-index.backend-state
                                name)
                              swb-prologue-mask
                              ;; SWB-FIX-1: form (a)'s frontier, so the
                              ;; general placement can never be chosen
                              ;; above it.
                              (if shrinkwrap-active?
                                shrinkwrap-saving-label
                                (compiler_ir_types.compiler-ir-label-none))
                              (be_state.compiler-backend-global-shared-view
                                emit-blocks-list))
                            (compiler-backend-swb-no-plan))]
                        ;; An applied placement that the second emission
                        ;; no longer reproduces is drift, not a placement:
                        ;; retry with the general form disabled.
                        [swb-drift? : bool
                          (and swb-active? (not (= swb-plan.label swb-label)))]
                        ;; TD-1: the applied emission is the one that gets
                        ;; the duplicated tail.  The offsets come from the
                        ;; plan just computed over THIS text, so they are
                        ;; valid here and nowhere else; the clone is
                        ;; appended past the shared epilogue, where
                        ;; nothing falls into it.
                        [swb-body : String
                          (if (and
                            swb-active?
                            (not swb-drift?)
                            (> swb-plan.dup-site-count 0))
                            (compiler-backend-swb-apply-dup
                              final-body
                              swb-plan.dup-sites
                              swb-plan.dup-site-count
                              swb-plan.dup-text)
                            (owned_view.compiler-owned-shared-view final-body))]
                        [entry-symbol : String
                          (if wrap-active?
                            (owned_view.compiler-owned-shared-view
                              saving-asm-label)
                            (owned_view.compiler-owned-shared-view symbol))]
                        [windows-describe? : bool
                          (be_scalar.compiler-backend-windows-framed-describe-saves?
                            target-policy
                            fpo-ok
                            assignments
                            (be_state.compiler-backend-global-shared-view
                              swb-body)
                            program-index.backend-state)]
                        [selected-prologue : String
                          (if fpo-ok
                            (if target-policy.seh-unwind
                              (be_scalar.compiler-backend-emit-function-entry-fpo-windows
                                target-policy
                                backend-state
                                entry-symbol
                                fpo-frame
                                assignments
                                slot-vars
                                final-push-regs
                                final-push-count)
                              (if (> final-push-count 0)
                                (be_scalar.compiler-backend-emit-function-entry-fpo-push
                                  backend-state
                                  entry-symbol
                                  fpo-frame
                                  final-push-regs
                                  final-push-count)
                                (be_scalar.compiler-backend-emit-function-entry-fpo
                                  backend-state
                                  entry-symbol
                                  fpo-frame)))
                            (be_scalar.compiler-backend-emit-function-entry
                              target-policy
                              entry-symbol
                              frame
                              assignments
                              slot-vars
                              windows-describe?
                              program-index.backend-state))]
                        [emitted-body : String
                          (if wrap-active?
                            (string.replace
                              swb-body
                              (str_cat.str-cat saving-asm-label ":\n" "")
                              (be_state.compiler-backend-global-shared-view
                                selected-prologue))
                            swb-body)]
                        [described-result : be_state.ResultCompilerBackend
                          (if windows-describe?
                            (be_scalar.compiler-backend-windows-framed-save-splice
                              (be_state.compiler-backend-global-shared-view
                                emitted-body)
                              ;; A shrink-wrapped prologue sits at its
                              ;; saving label; its saves follow it.
                              (if wrap-active?
                                (let
                                  [at : i64
                                    (compiler-backend-string-find-from
                                      (be_state.compiler-backend-global-shared-view
                                        emitted-body)
                                      (be_state.compiler-backend-global-shared-view
                                        selected-prologue)
                                      0)]
                                  (if (< at 0)
                                    -1
                                    (+
                                      at
                                      (string.string-length selected-prologue))))
                                0)
                              (compiler-backend-mode-prologue mode)
                              assignments
                              slot-vars
                              frame
                              (be_state.compiler-backend-global-shared-view
                                symbol)
                              (be_state.compiler-backend-global-shared-view
                                func-diag)
                              program-index.backend-state)
                            (Ok emitted-body))]
                        (cond
                          ;; SW-1: the first emission found a placement.
                          ;; Re-emit applying it, so the bypass returns
                          ;; render bare and the prologue is spliced at
                          ;; the saving block.
                          [(and
                              (not shrinkwrap-frameless?)
                              (not swb-active?)
                              (compiler_ir_types.compiler-ir-label-some?
                                swb-plan.label))
                            (compiler-backend-emit-function
                              type-segment-bases
                              target
                              mode
                              func
                              functions
                              globals
                              global-types
                              externs
                              plan
                              program-index
                              spans
                              span-index
                              emit-entry
                              crt-entry
                              allow-rbp
                              shrinkwrap-enabled
                              swb-plan.label
                              swb-plan.bare)]
                          ;; SW-1: an applied placement the re-emission
                          ;; does not reproduce. Refuse it for this
                          ;; function and keep entry placement.
                          [swb-drift?
                            (compiler-backend-emit-function
                              type-segment-bases
                              target
                              mode
                              func
                              functions
                              globals
                              global-types
                              externs
                              plan
                              program-index
                              spans
                              span-index
                              emit-entry
                              crt-entry
                              allow-rbp
                              shrinkwrap-enabled
                              compiler-backend-swb-refused
                              (__tl_make-array i64 0))]
                          [(or
                              shrinkwrap-frameless?
                              ;; The IR was split before allocation. If later
                              ;; admission cannot render both scratch-free
                              ;; prefixes (or intentionally excludes `main`),
                              ;; do not leave the duplicated CFG under an
                              ;; always-framed prologue: retry from the original
                              ;; function with the rewrite disabled.
                              (and
                                (not shrinkwrap-active?)
                                (not
                                  (=
                                    shrinkwrap-saving-label
                                    (compiler_ir_types.compiler-ir-label-none))))
                              (compiler-backend-shrinkwrap-splice-fallback-required?
                                shrinkwrap-active?
                                body
                                shrinkwrap-planned-guard
                                guarded-body
                                (str_cat.str-cat saving-asm-label ":\n" "")
                                final-body))
                            ;; A textual invariant drifted. Re-run the full
                            ;; unwrapped pipeline so the IR split, bare return,
                            ;; register plan, and prologue placement are all
                            ;; consistently disabled together.
                            (compiler-backend-emit-function
                              type-segment-bases
                              target
                              mode
                              func
                              functions
                              globals
                              global-types
                              externs
                              plan
                              program-index
                              spans
                              span-index
                              emit-entry
                              crt-entry
                              allow-rbp
                              false
                              compiler-backend-swb-refused
                              (__tl_make-array i64 0))]
                          [else
                            (let
                              [described-body (try described-result)]
                              ;; Publish carry-safe labels transactionally:
                              ;; shrinkwrap/FPO attempts may recursively
                              ;; retry this function with different final
                              ;; blocks but reuse its assembly label scope.
                              ;; An abandoned attempt must not leave labels
                              ;; that make the accepted body inherit an
                              ;; owner map across a non-fallthrough edge.
                              (be_peephole.compiler-backend-peephole-collect-carry-safe!
                                program-index.backend-state
                                (be_state.compiler-backend-state-stream-state
                                  program-index.backend-state)
                                (be_state.compiler-backend-state-function-state
                                  program-index.backend-state)
                                label-scope
                                emit-blocks-list)
                              (compiler-backend-commit-frame-layout!
                                program-index.backend-state
                                target
                                assignments
                                (be_state.compiler-backend-global-shared-view
                                  symbol)
                                frame
                                final-push-count
                                slot-vars
                                outgoing-frame-space
                                (if fpo-ok
                                  frame-squeeze
                                  0)
                                fpo-ok
                                rebase-ok
                                wrap-active?)
                              (Ok
                                (str_cat.str-cat
                                  (be_scalar.compiler-backend-function-symbol-map-comment
                                    program-index
                                    name)
                                  (if (be_state.compiler-backend-state-library-object?
                                    program-index.backend-state)
                                    (be_operand.compiler-backend-function-section
                                      target
                                      (& symbol))
                                    "")
                                  ".globl "
                                  symbol
                                  "\n"
                                  (be_scalar.compiler-backend-debug-function-location
                                    target
                                    program-index
                                    span-index
                                    (be_state.compiler-backend-global-shared-view
                                      spans)
                                    name)
                                  ;; Immediately before the entry label:
                                  ;; the shrinkwrap and ordinary prologues
                                  ;; both open with `symbol:`.
                                  (be_operand.compiler-backend-emit-function-type-directive
                                    target
                                    symbol)
                                  (if wrap-active?
                                    (str_cat.str-cat symbol ":\n" "")
                                    selected-prologue)
                                  ""
                                  ""
                                  ;; The text is final here (prologue
                                  ;; spliced, rsp rebased, FPO decided);
                                  ;; the fallthrough-`jmp` deletion runs
                                  ;; later, folded into the streaming
                                  ;; records parse, over the same bytes.
                                  described-body
                                  (compiler-backend-debug-function-end-label
                                    target
                                    program-index
                                    name)
                                  (be_scalar.compiler-backend-backtrace-function-end-label
                                    program-index
                                    name)
                                  (if (and
                                    (compiler_ir_types.compiler-debug-info-enabled?)
                                    target-policy.linux)
                                    "    .cfi_endproc\n"
                                    "")
                                  (compiler-backend-emit-windows-seh-endproc
                                    target)
                                  ;; Closes the function at its last
                                  ;; emitted byte, before the next
                                  ;; function's `.globl`/`.type`.
                                  (be_operand.compiler-backend-emit-function-size-directive
                                    target
                                    symbol)
                                  c-entry
                                  "\n"
                                  (be_scalar.compiler-backend-backtrace-function-entry
                                    target
                                    program-index
                                    spans
                                    name
                                    symbol))))])))))]
              [(Err message)
                (let
                  [_addr-forward-done : unit
                    (begin
                      (be_state.compiler-backend-function-state-set-bool!
                        (be_state.compiler-backend-state-function-state
                          program-index.backend-state)
                        be_state.compiler-backend-function-bool-identity-tail-forwarder-active
                        false)
                      (compiler-backend-addr-of-forwarding-disable!
                        program-index.backend-state)
                      (be_facts.compiler-backend-group-vars-disable!
                        program-index.backend-state)
                      (compiler-backend-fuse-need-disable!
                        program-index.backend-state)
                      (compiler-backend-gep-fold-disable! function-state))]
                  (Err message))]))))]))

;; 0: every function escapes through a per-function scratch arena. The old
;; limit of 24 sent small-function transients to the program arena to skip
;; the scratch/clone overhead, but their summed assembly-text churn stays
;; resident for the whole compile (RSS calibration); the per-function
;; arena reclaims it.
(define (compiler-backend-direct-emit-instr-limit) : i64
  0)

(define (compiler-backend-clear-function-emit-state!
  [backend-state : be_state.CompilerBackendState]) : unit
  ;; Scratch-backed function state is retired before the caller-global
  ;; sentinels below are cleared. Do not recreate a lazy compatibility state
  ;; in the long-lived caller arena merely to reset an already-retired owner.
  (when
    (be_state.compiler-backend-state-function-state-active? backend-state)
    (compiler-backend-addr-of-forwarding-disable! backend-state)
    (be_facts.compiler-backend-group-vars-disable! backend-state)
    (compiler-backend-fuse-need-disable! backend-state))
  (be_facts.compiler-backend-clear-function-owned-state! backend-state))

(define (compiler-backend-clear-scratch-escaped-emit-state!
  [backend-state : be_state.CompilerBackendState]) : unit
  (compiler-backend-clear-function-emit-state! backend-state)
  unit)

(define (compiler-backend-emit-function-direct?
  [func : compiler_ir_types.CompilerIrFunction]) : bool
  (match func
    [(Function _ _ _ _ blocks _)
      (<=
        (compiler_ir_types.compiler-ir-block-list-instruction-count (& blocks))
        (compiler-backend-direct-emit-instr-limit))]))

(define (compiler-backend-emit-function-scratch
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [func : compiler_ir_types.CompilerIrFunction]
  [all-functions : compiler_ir_types.CompilerIrFunctionSeq]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [result : be_state.ResultCompilerBackend
      (with-escape
        (unsafe
          (arena.Arena scratch))
        (let
          [function-state : be_state.CompilerBackendFunctionState
            (be_state.compiler-backend-function-state-new)]
          [_install : unit
            (be_state.compiler-backend-state-install-function-state!
              backend-state
              function-state)]
          [emitted : be_state.ResultCompilerBackend
            (unsafe
              ;; unsafe: the early-exit label globals are reset for each function
              (compiler-backend-emit-function
                type-segment-bases
                target
                mode
                func
                all-functions
                globals
                global-types
                externs
                plan
                program-index
                spans
                span-index
                emit-entry
                crt-entry
                true
                true
                (compiler_ir_types.compiler-ir-label-none)
                (__tl_make-array i64 0)))]
          [wrapped : be_state.ResultCompilerBackend
            (match emitted
              [(Ok head)
                (Ok
                  (be_scalar.compiler-backend-emergency-wrap head backend-state))]
              [(Err message) (Err message)])]
          ;; Clear scratch-owned references while the scratch arena is still
          ;; live, then retire the only job-owned handle before with-escape
          ;; rewinds it. This runs for success and controlled diagnostics.
          (be_facts.compiler-backend-clear-function-owned-state! backend-state)
          (be_state.compiler-backend-state-retire-function-state! backend-state)
          wrapped))]
    result))

;; Keep the direct path available for A/B experiments by raising
;; `compiler-backend-direct-emit-instr-limit`; normal builds route emitted
;; functions through a scratch arena so transient assembly strings stay within
;; the self-build memory budget.
(define (compiler-backend-emit-function-escaping
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [func : compiler_ir_types.CompilerIrFunction]
  [all-functions : compiler_ir_types.CompilerIrFunctionSeq]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [optional-runtime : bool
      (and
        (be_state.compiler-backend-state-closed-executable? backend-state)
        (match (& func)
          [(Function name _ _ _ _ _)
            (be_scalar.compiler-backend-optional-runtime-function?
              backend-state
              name)]))]
    [result : be_state.ResultCompilerBackend
      (if (compiler-backend-emit-function-direct?
        (be_state.compiler-backend-global-shared-view func))
        (let
          [function-state : be_state.CompilerBackendFunctionState
            (be_state.compiler-backend-function-state-new)]
          [_install : unit
            (be_state.compiler-backend-state-install-function-state!
              backend-state
              function-state)]
          [emitted : be_state.ResultCompilerBackend
            (compiler-backend-emit-function
              type-segment-bases
              target
              mode
              func
              all-functions
              globals
              global-types
              externs
              plan
              program-index
              spans
              span-index
              emit-entry
              crt-entry
              true
              true
              (compiler_ir_types.compiler-ir-label-none)
              (__tl_make-array i64 0))]
          [wrapped : be_state.ResultCompilerBackend
            (match emitted
              [(Ok head)
                (Ok
                  (be_scalar.compiler-backend-emergency-wrap head backend-state))]
              [(Err message) (Err message)])]
          (be_facts.compiler-backend-clear-function-owned-state! backend-state)
          (be_state.compiler-backend-state-retire-function-state! backend-state)
          wrapped)
        (compiler-backend-emit-function-scratch
          type-segment-bases
          target
          mode
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch))]
    ;; Scratch-backed function owners are already retired here. Reset only
    ;; the remaining global sentinels in the caller arena; function-owned
    ;; cleanup above deliberately stays inactive after retirement.
    (compiler-backend-clear-function-emit-state! backend-state)
    (if optional-runtime
      (match result
        [(Ok body) (Ok (runtime_prune.optional-fragment body))]
        [(Err message) (Err message)])
      result)))

(define (compiler-backend-emit-functions-buffer-raw-into
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [all-functions : compiler_ir_types.CompilerIrFunctionSeq]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : be_state.ResultCompilerBackendBuffer
  (compiler-backend-emit-function-seq-buffer-into
    type-segment-bases
    target
    mode
    functions
    0
    all-functions
    globals
    global-types
    externs
    plan
    program-index
    spans
    span-index
    emit-entry
    crt-entry
    scratch
    buf))

(define (compiler-backend-emit-function-seq-buffer-into
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [index : i64]
  [all-functions : compiler_ir_types.CompilerIrFunctionSeq]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : be_state.ResultCompilerBackendBuffer
  (if (>= index (compiler_ir_types.compiler-ir-function-seq-count functions))
    (Ok buf)
    (let
      [func : compiler_ir_types.CompilerIrFunction
        (be_state.compiler-backend-global-array-element-shared-view
          functions.slots
          index)]
      (begin
        (cfg
          compile-profile
          (be_state.compiler-backend-profile-detail-start
            program-index.profile-state))
        (match (compiler-backend-emit-function-escaping
          type-segment-bases
          target
          (be_simd.compiler-backend-effective-function-mode
            mode
            program-index.backend-state
            (be_state.compiler-backend-global-shared-view func))
          (be_state.compiler-backend-global-shared-view func)
          (be_state.compiler-backend-global-shared-view all-functions)
          (be_state.compiler-backend-global-shared-view globals)
          (be_state.compiler-backend-global-shared-view global-types)
          (be_state.compiler-backend-global-shared-view externs)
          plan
          program-index
          (be_state.compiler-backend-global-shared-view spans)
          (be_state.compiler-backend-global-shared-view span-index)
          emit-entry
          crt-entry
          scratch)
          [(Ok head)
            (begin
              (cfg
                compile-profile
                (be_state.compiler-backend-profile-detail-finish
                  program-index.profile-state
                  "function"
                  (be_state.compiler-backend-profile-function-name
                    program-index.backend-state
                    func)))
              (compiler-backend-emit-function-seq-buffer-into
                type-segment-bases
                target
                mode
                functions
                (+ index 1)
                all-functions
                globals
                global-types
                externs
                plan
                program-index
                spans
                span-index
                emit-entry
                crt-entry
                scratch
                (text_buf.append buf head)))]
          [(Err message)
            (begin
              (cfg
                compile-profile
                (be_state.compiler-backend-profile-detail-finish
                  program-index.profile-state
                  "function"
                  (be_state.compiler-backend-profile-function-name
                    program-index.backend-state
                    func)))
              (Err message))])))))

;; Final-buffer streaming emits each function into a rewindable raw arena, then
;; immediately moves its optimized bytes into the home-owned output stream.
(define (compiler-backend-emit-functions-stream-into
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [all-functions : compiler_ir_types.CompilerIrFunctionSeq]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : be_state.ResultCompilerBackendBuffer
  (compiler-backend-emit-function-seq-stream-into
    type-segment-bases
    target
    mode
    functions
    all-functions
    globals
    global-types
    externs
    plan
    program-index
    spans
    span-index
    emit-entry
    crt-entry
    scratch
    buf))

(define (compiler-backend-emit-function-seq-stream-into
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [all-functions : compiler_ir_types.CompilerIrFunctionSeq]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : be_state.ResultCompilerBackendBuffer
  (for [index
    (iterator.range
      0
      (compiler_ir_types.compiler-ir-function-seq-count functions))]
    (let
      [func : compiler_ir_types.CompilerIrFunction
        (be_state.compiler-backend-global-array-element-shared-view
          functions.slots
          index)]
      [caller-arena : arena.Arena (arena.current)]
      (begin
        (compiler-backend-assembly-stream-begin-raw!
          program-index.backend-state
          (be_state.compiler-backend-state-stream-state
            program-index.backend-state))
        (cfg
          compile-profile
          (be_state.compiler-backend-profile-detail-start
            program-index.profile-state))
        (match (compiler-backend-emit-function-escaping
          type-segment-bases
          target
          (be_simd.compiler-backend-effective-function-mode
            mode
            program-index.backend-state
            (be_state.compiler-backend-global-shared-view func))
          (be_state.compiler-backend-global-shared-view func)
          (be_state.compiler-backend-global-shared-view all-functions)
          (be_state.compiler-backend-global-shared-view globals)
          (be_state.compiler-backend-global-shared-view global-types)
          (be_state.compiler-backend-global-shared-view externs)
          plan
          program-index
          (be_state.compiler-backend-global-shared-view spans)
          (be_state.compiler-backend-global-shared-view span-index)
          emit-entry
          crt-entry
          scratch)
          [(Ok head)
            (begin
              (cfg
                compile-profile
                (be_state.compiler-backend-profile-detail-finish
                  program-index.profile-state
                  "function"
                  (be_state.compiler-backend-profile-function-name
                    program-index.backend-state
                    func)))
              (compiler-backend-assembly-stream-process-string!
                head
                program-index.backend-state
                (be_state.compiler-backend-state-stream-state
                  program-index.backend-state))
              (compiler-backend-assembly-stream-rewind-raw!
                (be_state.compiler-backend-state-stream-state
                  program-index.backend-state))
              (unsafe
                (arena.set! caller-arena))
              unit)]
          [(Err message)
            (return
              (begin
                (cfg
                  compile-profile
                  (be_state.compiler-backend-profile-detail-finish
                    program-index.profile-state
                    "function"
                    (be_state.compiler-backend-profile-function-name
                      program-index.backend-state
                      func)))
                (unsafe
                  (arena.set! caller-arena))
                (Err message)))]))))
  (Ok buf))

(define (compiler-backend-emit-functions-buffer-into
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [all-functions : compiler_ir_types.CompilerIrFunctionSeq]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : be_state.CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : be_state.CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [buf : text_buf.TextBuf]) : be_state.ResultCompilerBackendBuffer
  (let
    [with-c-entry : text_buf.TextBuf
      (if (be_facts.compiler-backend-c-entry-shared-needed?
        type-segment-bases
        target
        program-index
        (& functions))
        (text_buf.append buf (be_scalar.compiler-backend-emit-c-entry-shared))
        buf)]
    [scratch : arena.Arena (arena.make)]
    [result : be_state.ResultCompilerBackendBuffer
      (if (be_facts.compiler-backend-assembly-stream-active?
        (be_state.compiler-backend-state-stream-state
          program-index.backend-state))
        (compiler-backend-emit-functions-stream-into
          type-segment-bases
          target
          mode
          functions
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          (arena.raw-handle scratch)
          with-c-entry)
        (compiler-backend-emit-functions-buffer-raw-into
          type-segment-bases
          target
          mode
          functions
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          (arena.raw-handle scratch)
          with-c-entry))]
    (arena.destroy-safe! scratch)
    result))

(define (compiler-backend-closure-adapter-outgoing-frame-space
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [convention : compiler_abi.CompilerCallConvention]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [param-types : compiler_ast_types.AstTypeList]
  [program-index : be_state.CompilerBackendProgramIndex]) : i64
  (match target
    ;; The adapter's forwarded call does not dip on Linux -> reserve
    ;; its actual outgoing space in the adapter frame.
    [(be_state.CompilerBackendTarget.Linux)
      (be_operand.compiler-backend-round-up-16
        (+
          (be_facts.compiler-backend-outgoing-shadow-space target convention)
          (be_calls.compiler-backend-linux-stack-arg-space
            type-segment-bases
            target
            convention
            args
            param-types
            program-index)))]
    [(be_state.CompilerBackendTarget.Windows)
      ;; No callee signature here -- size conservatively at two positions
      ;; per forwarded argument so a register-group never overruns the area.
      (be_operand.compiler-backend-round-up-16
        (+
          (be_facts.compiler-backend-outgoing-shadow-space target convention)
          (be_calls.compiler-backend-windows-words-stack-space
            (* 2 (be_facts.compiler-backend-call-args-count args)))))]))

(define (compiler-backend-emit-closure-entry-adapter
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [name : i64]
  [param-types : compiler_ast_types.AstTypeList]
  [_ret-ty : compiler_ast_types.AstType]
  [plan : be_state.CompilerBackendRuntimePlan]
  [_functions : compiler_ir_types.CompilerIrFunctionSeq]
  [_externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]) : be_state.ResultCompilerBackend
  (let
    [params : compiler_ir_types.CompilerIrParamSeq
      (be_calls.compiler-backend-param-list-from-types
        type-segment-bases
        param-types
        0)]
    [vars : i64 (be_facts.compiler-backend-type-list-count param-types)]
    [args : compiler_ir_types.CompilerIrCallArgs
      (compiler_ir_types.compiler-ir-call-args-from-seq
        (&
          (compiler-backend-var-value-seq
            (be_facts.compiler-backend-type-list-count param-types)
            0)))]
    [extern-call-info : i64
      (be_operand.compiler-backend-index-extern-call-info program-index name)]
    ;; The adapter is entered as an Internal closure, then forwards with its
    ;; target's own convention: a C extern target receives a Platform call.
    [convention : compiler_abi.CompilerCallConvention
      (compiler_regalloc.compiler-reg-direct-call-convention name)]
    ;; Group params spill word1 at -(8*(vars+rank+1))(%rbp) in the compact map
    ;; (no exposed group here), so the frame must cover one word per group
    ;; param (no red zone on Windows -- the outgoing stack-arg area would
    ;; clobber them otherwise). The region is sized from the very set the
    ;; param spills index, so it is installed before the frame is computed.
    [groups : compiler_liveness.CompilerLiveI64Set
      (be_calls.compiler-backend-type-list-group-vars
        type-segment-bases
        param-types
        program-index)]
    [_groups : unit
      (begin
        (be_facts.compiler-backend-current-slot-vars-set!
          program-index.backend-state
          (be_facts.compiler-backend-type-list-count param-types))
        (be_facts.compiler-backend-group-vars-enable!
          program-index.backend-state
          groups
          (compiler_liveness.compiler-live-set-empty)))]
    [frame : i64
      (+
        (be_facts.compiler-backend-frame-size
          (be_scalar.compiler-backend-frame-slots-with-groups
            vars
            (compiler_regalloc.compiler-reg-assignment-table-empty)
            program-index.backend-state))
        (compiler-backend-closure-adapter-outgoing-frame-space
          type-segment-bases
          target
          convention
          (be_state.compiler-backend-global-shared-view args)
          (be_state.compiler-backend-global-shared-view param-types)
          program-index))]
    [call-space : i64
      (be_operand.compiler-backend-call-arg-space
        target
        args
        param-types
        false
        program-index)]
    [diag : compiler_diagnostic.CompilerDiagnostic
      (compiler_diagnostic.compiler-diagnostic-at-start "" "")]
    [spills
      (try
        (compiler-backend-emit-param-spills
          type-segment-bases
          target
          (compiler_regalloc.compiler-reg-assignment-table-empty)
          params
          1
          0
          1
          0
          program-index
          vars
          program-index.backend-state))]
    [args-asm
      (try
        (be_calls.compiler-backend-emit-call-args
          type-segment-bases
          target
          convention
          (compiler_regalloc.compiler-reg-assignment-table-empty)
          args
          (be_state.compiler-backend-global-shared-view param-types)
          false
          0
          0
          0
          0
          0
          diag
          program-index
          vars
          program-index.backend-state))]
    [entry : String
      (be_facts.compiler-backend-closure-entry-label
        (be_state.compiler-backend-symbol-text-index program-index name))]
    (Ok
      (str_cat.str-cat
        (if (be_state.compiler-backend-state-library-object?
          program-index.backend-state)
          (be_operand.compiler-backend-function-section target (& entry))
          "")
        (be_scalar.compiler-backend-emit-function-entry
          (be_state.compiler-backend-state-emission-target-policy
            program-index.backend-state)
          entry
          frame
          (compiler_regalloc.compiler-reg-assignment-table-empty)
          vars
          false
          program-index.backend-state)
        ""
        ""
        ;; M-G3 stage 1: adapters go through the same rsp rebase as
        ;; user functions (their `movq %rbp,%rsp` epilogue ends rsp
        ;; validity; no frame refs follow it). Stage 2: adapters keep
        ;; the rbp prologue (fpo=false) -- their raw epilogue resets
        ;; rsp from rbp and they never home values in %rbp.
        (be_peephole.compiler-backend-rsp-rebase
          (str_cat.str-cat
            spills
            (be_operand.compiler-backend-emit-call-space-sub call-space)
            args-asm
            (be_calls.compiler-backend-varargs-pre-call
              type-segment-bases
              target
              extern-call-info
              param-types)
            (str_cat.str-cat
              "    call "
              (be_operand.compiler-backend-call-symbol-index
                name
                plan
                program-index)
              "\n"
              (str_cat.str-cat
                (be_operand.compiler-backend-emit-call-space-add call-space)
                (str_cat.str-cat
                  "    movq %rbp, %rsp\n    popq %rbp\n    ret\n"
                  (if (and
                    (compiler_ir_types.compiler-debug-info-enabled?)
                    (be_state.compiler-backend-target-elf? target))
                    "    .cfi_endproc\n"
                    "")
                  "")
                (compiler-backend-emit-windows-seh-endproc target)
                "\n")
              ""))
          frame
          false
          program-index.backend-state)
        ""))))

;; Closure entry adapters are emitted functions too: their argument shuffles can
;; scavenge and therefore must finish emergency wrapping before their scratch
;; owner is retired. Preserve a caller-installed owner for focused nested
;; fixtures, while production enters with no active function owner.
(define (compiler-backend-emit-closure-entry-adapter-owned
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [name : i64]
  [param-types : compiler_ast_types.AstTypeList]
  [ret-ty : compiler_ast_types.AstType]
  [plan : be_state.CompilerBackendRuntimePlan]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [program-index : be_state.CompilerBackendProgramIndex]) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [previous-address : i64
      (be_state.compiler-backend-state-function-state-address backend-state)]
    [function-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-function-state-new)]
    [_install : unit
      (be_state.compiler-backend-state-install-function-state!
        backend-state
        function-state)]
    [_abi : unit
      (be_state.compiler-backend-set-current-fn-abi!
        backend-state
        (be_state.compiler-backend-state-emission-target-policy backend-state).abi)]
    [emitted : be_state.ResultCompilerBackend
      (compiler-backend-emit-closure-entry-adapter
        type-segment-bases
        target
        name
        param-types
        ret-ty
        plan
        functions
        externs
        program-index)]
    [wrapped : be_state.ResultCompilerBackend
      (match emitted
        [(Ok head)
          (Ok (be_scalar.compiler-backend-emergency-wrap head backend-state))]
        [(Err message) (Err message)])]
    (be_facts.compiler-backend-clear-function-owned-state! backend-state)
    (be_state.compiler-backend-state-set-function-state-address!
      backend-state
      previous-address)
    wrapped))

(define (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [names : be_state.BackendSymbolSeq]
  [index : i64]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : be_state.ResultCompilerBackendBuffer
  (if (>= index names.len)
    (Ok buf)
    (let
      [name : i64 (array-ref names.slots index)]
      (match (be_facts.compiler-backend-index-signature program-index name)
        [(Some param-types ret-ty)
          (let
            [head
              (try
                (compiler-backend-emit-closure-entry-adapter-owned
                  type-segment-bases
                  target
                  name
                  param-types
                  ret-ty
                  plan
                  (be_state.compiler-backend-global-shared-view functions)
                  (be_state.compiler-backend-global-shared-view externs)
                  program-index))]
            (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
              type-segment-bases
              target
              names
              (+ index 1)
              functions
              externs
              plan
              program-index
              (text_buf.append buf head)))]
        [(No)
          (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
            type-segment-bases
            target
            names
            (+ index 1)
            functions
            externs
            plan
            program-index
            buf)]))))

(define (compiler-backend-emit-closure-entry-adapters-stream-into
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [names : be_state.BackendSymbolSeq]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : be_state.ResultCompilerBackendBuffer
  (for [index (iterator.range 0 names.len)]
    (let
      [name : i64 (array-ref names.slots index)]
      (match (be_facts.compiler-backend-index-signature program-index name)
        [(Some param-types ret-ty)
          (let
            [caller-arena : arena.Arena (arena.current)]
            (compiler-backend-assembly-stream-begin-raw!
              program-index.backend-state
              (be_state.compiler-backend-state-stream-state
                program-index.backend-state))
            (match (compiler-backend-emit-closure-entry-adapter-owned
              type-segment-bases
              target
              name
              param-types
              ret-ty
              plan
              (be_state.compiler-backend-global-shared-view functions)
              (be_state.compiler-backend-global-shared-view externs)
              program-index)
              [(Ok head)
                (compiler-backend-assembly-stream-process-string!
                  head
                  program-index.backend-state
                  (be_state.compiler-backend-state-stream-state
                    program-index.backend-state))
                (compiler-backend-assembly-stream-rewind-raw!
                  (be_state.compiler-backend-state-stream-state
                    program-index.backend-state))
                (unsafe
                  (arena.set! caller-arena))
                unit]
              [(Err message)
                (unsafe
                  (arena.set! caller-arena))
                (return (Err message))]))]
        [(No) unit])))
  (Ok buf))

(define (compiler-backend-emit-closure-entry-adapters-buffer-into
  [type-segment-bases : i64]
  [target : be_state.CompilerBackendTarget]
  [names : be_state.BackendSymbolSeq]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [program-index : be_state.CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : be_state.ResultCompilerBackendBuffer
  (if (be_facts.compiler-backend-assembly-stream-active?
    (be_state.compiler-backend-state-stream-state program-index.backend-state))
    (compiler-backend-emit-closure-entry-adapters-stream-into
      type-segment-bases
      target
      names
      functions
      externs
      plan
      program-index
      buf)
    (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
      type-segment-bases
      target
      names
      0
      functions
      externs
      plan
      program-index
      buf)))

(define (compiler-backend-program-collections-uses-avx512-i64-lane-id?
  [collections : (& collections be_state.CompilerBackendProgramCollections)]) : bool
  collections.uses-avx512-i64-lane-id)

(define (compiler-backend-debug-path-remap-load-environment!) : unit
  ;; The mapping strings belong to this emission arena. Reset and reload on
  ;; every batch entry so no later compile observes storage after a rewind.
  (compiler_ir_types.compiler-debug-path-remap-clear!)
  (when
    (compiler_ir_types.compiler-debug-info-enabled?)
    (let
      [spec : String (env.var-value "TYPELISP_REMAP_PATH_PREFIX")]
      (when
        (> (string.string-length spec) 0)
        (begin
          (compiler_ir_types.compiler-debug-path-remap-set! (& spec))
          unit)))))

;; --- Shared-object code model (#8257) ---------------------------------------
;; A Linux shared object needs object code with no text relocation, no
;; local-exec TLS and no exported internal symbol. The emission keeps the
;; executable code everywhere else, so the model is applied by one pass over
;; the finished assembly (`compiler-backend-shared-object-assembly`) plus
;; one emission change the pass cannot make: `tl_shared_object_init` takes
;; the place of the executable entry point.
(define (compiler-backend-shared-object-target-message
  [target : be_state.CompilerBackendTarget]) : String
  (str_cat.str-cat
    "backend: the shared-object code model needs an ELF target; "
    (be_state.compiler-backend-target-triple target)
    " has none"))

;; The shared object's one initializer: the program's global initializers,
;; which an executable runs from `_tl_start`. A host calls it once, through an
;; export shim, before any other entry; #8194's lifecycle child owns that
;; contract. The initializers only call ABI-conforming functions and copy
;; results into globals through %rax, %rdx, %r10 and %xmm0, so the wrapper only
;; realigns the stack for those calls.
(define (compiler-backend-shared-object-init [global-inits : String]) : String
  (str_cat.str-cat
    "    .text
    .globl tl_shared_object_init
    .type tl_shared_object_init,@function
tl_shared_object_init:
    subq $8, %rsp
"
    global-inits
    "    addq $8, %rsp
    ret
    .size tl_shared_object_init, . - tl_shared_object_init
"))

;; Emit a full program for `target`. Windows x64 has ABI-correct user function
;; entry/calls and target-specific runtime helpers.
;; Backend entry points come in two flavors: the original
;;
;; program-only variants (kept for existing call sites and smoke tests) supply
;;
;; an empty provenance table, so backend diagnostics fall back to `path:1:1`;
;;
;; the `-with-spans` variants thread the lowering provenance side table so
;;
;; backend errors report the offending function's real source location.
(define (compiler-backend-emit-program-for-target
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-program-target-with-mode
    program
    target
    (Scalar)
    (compiler_ir_types.compiler-source-spans-empty)
    true))

(define (compiler-backend-emit-program-linux
  [program : compiler_ir_types.CompilerIrProgram]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-program-for-target
    program
    (be_state.CompilerBackendTarget.Linux)))

(define (compiler-backend-emit-program-buffer-after-index
  [type-segment-bases : i64]
  [_program : compiler_ir_types.CompilerIrProgram]
  [target-policy : be_state.CompilerBackendTargetPolicy]
  [mode : be_state.CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [externs : compiler_ir_types.CompilerIrExternSeq]
  [plan : be_state.CompilerBackendRuntimePlan]
  [runtime-index : be_state.CompilerBackendRuntimeIndex]
  [program-index : be_state.CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [globals-buf : text_buf.TextBuf]
  [collections : be_state.CompilerBackendProgramCollections]
  [emit-entry : bool]
  [crt-entry : bool]) : be_state.ResultCompilerBackendBuffer
  (let
    [target : be_state.CompilerBackendTarget target-policy.target]
    [_arg-entries : unit
      (be_peephole.compiler-backend-arg-entry-prepare!
        program-index
        target
        emit-entry
        (& functions))]
    [closure-names : be_state.BackendSymbolSeq
      (be_data.compiler-backend-program-collections-functions
        (be_state.compiler-backend-global-shared-view collections))]
    [referenced-symbols : be_state.BackendSymbolSeq
      (be_data.compiler-backend-program-collections-references
        (be_state.compiler-backend-global-shared-view collections))]
    [strings : be_state.BackendStringSeq
      (be_data.compiler-backend-program-collections-strings
        (be_state.compiler-backend-global-shared-view collections))]
    [str-descs : be_state.BackendStringSeq
      (be_data.compiler-backend-program-collections-str-descs
        (be_state.compiler-backend-global-shared-view collections))]
    [bytes : be_state.BackendStringSeq
      (be_data.compiler-backend-program-collections-bytes
        (be_state.compiler-backend-global-shared-view collections))]
    [floats : be_state.BackendFloatSeq
      (be_data.compiler-backend-program-collections-floats
        (be_state.compiler-backend-global-shared-view collections))]
    [uses-avx2-i64-lane-id : bool
      (be_data.compiler-backend-program-collections-uses-avx2-i64-lane-id?
        collections)]
    [uses-avx512-i64-lane-id : bool
      (compiler-backend-program-collections-uses-avx512-i64-lane-id?
        collections)]
    [uses-f64-neg : bool
      (be_data.compiler-backend-program-collections-uses-f64-neg? collections)]
    [uses-f32-neg : bool
      (be_data.compiler-backend-program-collections-uses-f32-neg? collections)]
    [span-index : be_state.CompilerBackendSourceSpanIndex
      (be_state.compiler-backend-source-span-index-build-with-backend-state
        program-index.backend-state
        (be_state.compiler-backend-global-shared-view spans))]
    [global-types : be_state.CompilerBackendGlobalTypeTable
      (be_facts.compiler-backend-global-types
        (be_state.compiler-backend-global-shared-view globals))]
    [runtime-features : runtime_common.CompilerBackendRuntimeFeatures
      (be_data.compiler-backend-runtime-features-for-emission
        target
        plan
        program-index.backend-state
        runtime-index
        referenced-symbols
        (be_state.compiler-backend-global-shared-view externs)
        emit-entry)]
    (begin
      (cfg
        compile-profile
        (be_state.compiler-backend-profile-finish
          program-index.profile-state
          "collect"))
      (cfg
        compile-profile
        (be_state.compiler-backend-profile-start program-index.profile-state))
      (let
        ;; Prefix composition (string/bytes/float rodata, closure descriptors,
        ;; switch tables, runtime data, externs, debug prefix and the rendered
        ;; prefix string) is pure output text. Once the streaming emitter has
        ;; copied those bytes into the home-owned output stream, nothing reads
        ;; them again, so they are rewound rather than left resident in the
        ;; backend emit arena for the whole per-function loop.
        ;; Prefix helpers share a few ABI/rendering utilities with function
        ;; emission. Give them an entry-owned function carrier explicitly;
        ;; otherwise the compatibility getter installs one in the backend
        ;; state's process-lived owner on every batch entry.
        [prefix-previous-function-state-address : i64
          (be_state.compiler-backend-state-function-state-address
            program-index.backend-state)]
        [prefix-function-state : be_state.CompilerBackendFunctionState
          (be_state.compiler-backend-function-state-new)]
        [_prefix-function-state-install : unit
          (be_state.compiler-backend-state-install-function-state!
            program-index.backend-state
            prefix-function-state)]
        ;; Preserve the carrier across the prefix rewind; everything allocated
        ;; after this mark is pure prefix output and may be released once the
        ;; stream has consumed it.
        [prefix-mark : arena.ArenaMark (arena.mark)]
        [base-prefix-buf : text_buf.TextBuf
          (be_data.compiler-backend-emit-program-prefix-buffer
            target
            (be_state.compiler-backend-global-shared-view functions)
            (be_state.compiler-backend-global-shared-view externs)
            plan
            runtime-features
            program-index
            runtime-index
            (be_state.compiler-backend-global-shared-view closure-names)
            referenced-symbols
            strings
            str-descs
            bytes
            floats
            uses-avx2-i64-lane-id
            uses-avx512-i64-lane-id
            uses-f64-neg
            uses-f32-neg
            globals-buf
            emit-entry
            crt-entry)]
        [prefix-buf : text_buf.TextBuf
          (text_buf.append
            (text_buf.append
              base-prefix-buf
              (be_scalar.compiler-backend-debug-prefix
                target
                (be_state.compiler-backend-global-shared-view functions)
                program-index
                (be_state.compiler-backend-global-shared-view span-index)))
            (str_cat.str-cat
              (be_scalar.compiler-backend-backtrace-map-prefix target)
              (be_scalar.compiler-backend-abort-table-prefix
                target
                (be_state.compiler-backend-state-library-object?
                  program-index.backend-state)
                target-policy.shared-object)))]
        [function-input : text_buf.TextBuf
          (if (be_facts.compiler-backend-assembly-stream-active?
            (be_state.compiler-backend-state-stream-state
              program-index.backend-state))
            (begin
              (compiler-backend-assembly-stream-process-buffer!
                prefix-buf
                program-index.backend-state
                (be_state.compiler-backend-state-stream-state
                  program-index.backend-state))
              ;; The prefix bytes now live in the flushed output stream, and the
              ;; per-function caches that could still name region-owned strings
              ;; are cleared before the region goes away.
              (be_state.compiler-backend-state-user-symbol-cache-reset!
                program-index.backend-state)
              (be_facts.compiler-backend-state-slot-cache-epoch-bump!
                program-index.backend-state)
              (unsafe
                (arena.rewind prefix-mark))
              (text_buf.empty))
            prefix-buf)]
        [_prefix-function-state-retire : unit
          (begin
            (be_facts.compiler-backend-clear-function-owned-state!
              program-index.backend-state)
            (be_state.compiler-backend-state-set-function-state-address!
              program-index.backend-state
              prefix-previous-function-state-address))]
        (begin
          ;; Report the prefix-composition window before the next start
          ;; overwrites it, so it shows in the phase breakdown.
          (cfg
            compile-profile
            (be_state.compiler-backend-profile-finish
              program-index.profile-state
              "prefix"))
          (cfg
            compile-profile
            (be_state.compiler-backend-profile-start
              program-index.profile-state))
          (compiler-backend-copy-thunk-size-counts-collect!
            (& functions)
            program-index.backend-state)
          (match (compiler-backend-emit-functions-buffer-into
            type-segment-bases
            target
            mode
            (be_state.compiler-backend-global-shared-view functions)
            (be_state.compiler-backend-global-shared-view functions)
            (be_state.compiler-backend-global-shared-view globals)
            global-types
            (be_state.compiler-backend-global-shared-view externs)
            plan
            program-index
            spans
            span-index
            emit-entry
            crt-entry
            function-input)
            [(Ok with-functions)
              (begin
                (cfg
                  compile-profile
                  (be_state.compiler-backend-profile-finish
                    program-index.profile-state
                    "functions"))
                (cfg
                  compile-profile-summary
                  (be_state.compiler-backend-profile-summary-emit
                    program-index.profile-state))
                (cfg
                  compile-profile
                  (be_state.compiler-backend-profile-start
                    program-index.profile-state))
                (match (compiler-backend-emit-closure-entry-adapters-buffer-into
                  type-segment-bases
                  target
                  closure-names
                  (be_state.compiler-backend-global-shared-view functions)
                  externs
                  plan
                  program-index
                  (text_buf.append
                    with-functions
                    (str_cat.str-cat
                      (be_scalar.compiler-backend-abort-table-trailer
                        target
                        target-policy.shared-object
                        (be_state.compiler-backend-state-abort-site-counter
                          program-index.backend-state))
                      (be_scalar.compiler-backend-backtrace-map-trailer target)
                      (be_scalar.compiler-backend-debug-trailer
                        target
                        functions
                        program-index))))
                  [(Ok with-adapters)
                    (begin
                      (cfg
                        compile-profile
                        (be_state.compiler-backend-profile-finish
                          program-index.profile-state
                          "adapters"))
                      (cfg
                        compile-profile
                        (be_state.compiler-backend-profile-start
                          program-index.profile-state))
                      (let
                        [buf : text_buf.TextBuf
                          (text_buf.append
                            (text_buf.append
                              with-adapters
                              (str_cat.str-cat
                                (be_scalar.compiler-backend-copy-thunk-text
                                  program-index)
                                (if emit-entry
                                  (be_data.compiler-backend-runtime-functions-for-target
                                    target
                                    runtime-features
                                    (be_state.compiler-backend-state-closed-executable?
                                      program-index.backend-state)
                                    (be_state.compiler-backend-state-archive-runtime?
                                      program-index.backend-state)
                                    (not
                                      (or crt-entry target-policy.shared-object)))
                                  "")))
                            (cond
                              [(not emit-entry) ""]
                              [target-policy.shared-object
                                (compiler-backend-shared-object-init
                                  (be_data.compiler-backend-global-initializers
                                    type-segment-bases
                                    target
                                    globals
                                    program-index))]
                              [else
                                (be_data.compiler-backend-entry-for-target-with-crt
                                  type-segment-bases
                                  target
                                  plan
                                  globals
                                  crt-entry
                                  program-index)]))]
                        (begin
                          (cfg
                            compile-profile
                            (be_state.compiler-backend-profile-finish
                              program-index.profile-state
                              "compose_tail"))
                          (Ok
                            (if (be_facts.compiler-backend-assembly-stream-active?
                              (be_state.compiler-backend-state-stream-state
                                program-index.backend-state))
                              (begin
                                (compiler-backend-assembly-stream-process-buffer!
                                  buf
                                  program-index.backend-state
                                  (be_state.compiler-backend-state-stream-state
                                    program-index.backend-state))
                                (compiler-backend-assembly-stream-output
                                  (be_state.compiler-backend-state-stream-state
                                    program-index.backend-state)))
                              buf)))))]
                  [(Err message)
                    (begin
                      (cfg
                        compile-profile
                        (be_state.compiler-backend-profile-finish
                          program-index.profile-state
                          "adapters"))
                      (Err message))]))]
            [(Err message)
              (begin
                (cfg
                  compile-profile
                  (be_state.compiler-backend-profile-finish
                    program-index.profile-state
                    "functions"))
                (cfg
                  compile-profile-summary
                  (be_state.compiler-backend-profile-summary-emit
                    program-index.profile-state))
                (Err message))]))))))

(define (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-prepared-backend-state
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [pic-emit? : bool]
  [profile-state : profile_state.CompilerProfileState]) : be_state.ResultCompilerBackendBuffer
  (begin
    (when
      (and
        (be_state.compiler-backend-state-shared-object-code-model?
          backend-state)
        (not (be_state.compiler-backend-target-elf? target)))
      (return
        (Err
          (box
            (compiler_diagnostic.compiler-diagnostic-at-start
              ""
              (compiler-backend-shared-object-target-message target))))))
    (be_state.compiler-backend-state-set-library-object!
      backend-state
      (and (not emit-entry) (not pic-emit?)))
    (compiler-backend-debug-path-remap-load-environment!)
    (be_state.compiler-backend-state-set-emission-target-policy!
      backend-state
      (be_state.compiler-backend-target-policy-for-code-model
        target
        (be_state.compiler-backend-state-shared-object-code-model?
          backend-state)))
    (be_state.compiler-backend-state-set-metrics!
      backend-state
      (profile_state.compiler-profile-state-metrics profile-state))
    (be_facts.compiler-backend-state-set-emission-symbols!
      backend-state
      be_state.CompilerBackendEmissionSymbols.None)
    (be_state.compiler-backend-state-user-symbol-cache-reset! backend-state)
    (be_facts.compiler-backend-state-slot-cache-reset! backend-state)
    (compiler-backend-copy-thunks-reset! backend-state)
    (be_state.compiler-backend-peephole-carry-safe-reset-with-backend-state!
      backend-state
      (be_state.compiler-backend-state-stream-state backend-state))
    (be_peephole.compiler-backend-peephole-owner-global-storage-ensure-with-backend-state!
      backend-state
      (be_state.compiler-backend-state-stream-state backend-state))
    (be_state.compiler-backend-state-set-abort-site-counter! backend-state 0)
    ;; A 4-byte table entry holding an absolute case address needs a
    ;; 32-bit-absolute relocation, which only a non-PIC, non-shared ELF image
    ;; below 2 GiB can carry; every other model keeps the rip-relative table.
    (be_state.compiler-backend-state-set-absolute-switch-ok!
      backend-state
      (and
        (not pic-emit?)
        (not
          (be_state.compiler-backend-state-shared-object-code-model?
            backend-state))
        (be_state.compiler-backend-target-elf? target)))
    (cfg
      test
      (profile_state.compiler-profile-metrics-reset-range!
        (be_state.compiler-backend-state-metrics backend-state)
        be_state.compiler-backend-phi-xmm-cycle-register-metric
        be_state.compiler-backend-census-metric-end)
      unit)
    ;; GAP5: clear the post-emission dead-frame-store sweep metadata before
    ;; recording this program's FPO functions (a stale entry from a prior
    ;; program emit in the same process must not leak into the sweep).
    (compiler-backend-sweep-reset!
      backend-state
      (be_state.compiler-backend-state-stream-state backend-state))
    (cfg
      test
      (compiler_regalloc.compiler-reg-liveness-census-reset!
        (be_state.compiler-backend-state-metrics backend-state))
      unit)
    (cfg
      compile-profile
      (be_state.compiler-backend-profile-start profile-state))
    (match (be_data.compiler-backend-runtime-plan-with-index-with-backend-state
      backend-state
      (be_state.compiler-backend-global-shared-view program))
      [(Ok planned)
        (let
          [plan : be_state.CompilerBackendRuntimePlan planned.plan]
          [runtime-index : be_state.CompilerBackendRuntimeIndex planned.index]
          (begin
            (cfg
              compile-profile
              (be_state.compiler-backend-profile-finish
                profile-state
                "runtime_plan"))
            (cfg
              compile-profile
              (be_state.compiler-backend-profile-start profile-state))
            (match (be_state.compiler-backend-global-shared-view program)
              [(Program globals functions externs _authority)
                ;; Build the program index ONCE over the function list and share
                ;; it with the globals emission: each build walks every
                ;; function body for the register-group counts, so a second
                ;; build would double both that walk and its transient
                ;; allocation.
                (let
                  [program-index : be_state.CompilerBackendProgramIndex
                    (be_facts.compiler-backend-program-index-build-with-backend-state-and-profile-state
                      backend-state
                      type-segment-bases
                      (be_state.compiler-backend-global-shared-view functions)
                      (be_state.compiler-backend-global-shared-view externs)
                      profile-state)]
                  (begin
                    (cfg
                      compile-profile
                      (be_state.compiler-backend-profile-finish
                        profile-state
                        "index"))
                    (cfg
                      compile-profile
                      (be_state.compiler-backend-profile-start profile-state))
                    (match (be_data.compiler-backend-emit-globals-and-collections
                      type-segment-bases
                      target
                      (be_state.compiler-backend-global-shared-view globals)
                      (be_state.compiler-backend-global-shared-view functions)
                      (& externs)
                      program-index)
                      [(Ok globals-buf collections)
                        (begin
                          (cfg
                            compile-profile
                            (be_state.compiler-backend-profile-finish
                              profile-state
                              "globals"))
                          (cfg
                            compile-profile
                            (be_state.compiler-backend-profile-start
                              profile-state))
                          (let
                            [_
                              (try
                                (be_facts.compiler-backend-validate-program
                                  (be_state.compiler-backend-global-shared-view
                                    globals)
                                  (be_state.compiler-backend-global-shared-view
                                    functions)
                                  (be_state.compiler-backend-global-shared-view
                                    externs)
                                  plan
                                  program-index
                                  (& runtime-index)
                                  (& collections.references.items)
                                  emit-entry))]
                            (be_data.compiler-backend-shared-object-unstreamed
                              backend-state
                              (compiler-backend-emit-program-buffer-after-index
                                type-segment-bases
                                program
                                (be_state.compiler-backend-state-emission-target-policy
                                  backend-state)
                                mode
                                functions
                                globals
                                externs
                                plan
                                runtime-index
                                program-index
                                spans
                                globals-buf
                                collections
                                emit-entry
                                crt-entry))))]
                      [(Err message)
                        (begin
                          (cfg
                            compile-profile
                            (be_state.compiler-backend-profile-finish
                              profile-state
                              "globals"))
                          (Err message))])))])))]
      [(Err message)
        (begin
          (cfg
            compile-profile
            (be_state.compiler-backend-profile-finish
              profile-state
              "runtime_plan"))
          (Err
            (box (compiler_diagnostic.compiler-diagnostic-at-start "" message))))])))

(define (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [pic-emit? : bool]
  [profile-state : profile_state.CompilerProfileState]) : be_state.ResultCompilerBackendBuffer
  (let
    [_emission-arena : arena.Arena
      (be_state.compiler-backend-state-ensure-emission-arena! backend-state)]
    [result : be_state.ResultCompilerBackendBuffer
      (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-prepared-backend-state
        backend-state
        type-segment-bases
        program
        target
        mode
        spans
        emit-entry
        crt-entry
        pic-emit?
        profile-state)]
    (be_facts.compiler-backend-clear-function-owned-state! backend-state)
    (be_state.compiler-backend-state-retire-function-state! backend-state)
    (be_state.compiler-backend-state-clear-emission-arena! backend-state)
    result))

(define (compiler-backend-object-program-eligibility-with-pools-and-profile-state
  [backend-state : be_state.CompilerBackendState]
  [pools : compiler_ast_types.AstNodePoolContext]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]
  [profile-state : profile_state.CompilerProfileState]) : be_state.CompilerBackendObjectEligibility
  (if (>
    (string.string-length
      (compiler-backend-state-authorize-return-storage!
        backend-state
        pools
        program
        target))
    0)
    ;; The object emitter reports this authority problem as an error.
    (be_state.CompilerBackendObjectEligibility.Unsupported
      (be_state.compiler-backend-object-unsupported-semantics-category))
    (be_object.compiler-backend-object-program-eligibility-with-type-segment-bases-and-profile-state
      backend-state
      (compiler_ast_types.ast-node-pool-context-type-segment-bases pools)
      program
      target
      profile-state)))

(define (compiler-backend-emit-program-object-image-target-with-mode-with-pools-and-crt-and-profile-state-backend-state
  [backend-state : be_state.CompilerBackendState]
  [pools : compiler_ast_types.AstNodePoolContext]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : be_state.ResultCompilerBackendObject
  (let
    [problem : String
      (compiler-backend-state-authorize-return-storage!
        backend-state
        pools
        program
        target)]
    (if (> (string.string-length problem) 0)
      (be_state.ResultCompilerBackendObject.Err
        (be_state.compiler-backend-return-storage-authority-diagnostic problem))
      (be_object.compiler-backend-emit-program-object-image-target-with-mode-with-type-segment-bases-and-crt-and-profile-state-backend-state
        backend-state
        (compiler_ast_types.ast-node-pool-context-type-segment-bases pools)
        program
        target
        mode
        spans
        emit-entry
        crt-entry
        false
        profile-state))))

(define (compiler-backend-peephole-records-retire!
  [stream : be_state.CompilerBackendStreamState]) : unit
  (let
    [data : (MutPtr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-ptr stream)]
    (unsafe
      (set!
        (deref data).records-lines
        (__tl_make-array be_state.CompilerBackendPeepholeLineRecord 0))
      (set! (deref data).records-live (__tl_make-array i64 0))
      (set! (deref data).records-len 0))))

;; SCAV2: true iff the pending line (owned String or asm byte range) is a
;; noreturn abort call. Threaded as `prev-abort?` so the guard-ok label emitted
;; immediately after it carries the owner map (line-clobber-owners label arm).
;; User-function chunks begin with `.globl`; processing either side separately
;; matches a whole-text pass because that directive/function-entry boundary
;; clears pending pair and owner state.  Chunks that split a function remain in
;; the same group and are rendered together.
(define (compiler-backend-peephole-chunk-starts-global? [chunk : (& chunk str)]) : bool
  (let
    [data : (Ptr u8)
      (unsafe
        (string-data chunk))]
    [n : i64 (string.string-length chunk)]
    [i : i64 0]
    (while (and
      (< i n)
      (or
        (= (be_state.compiler-backend-peephole-byte-at data i) 32)
        (= (be_state.compiler-backend-peephole-byte-at data i) 9)
        (= (be_state.compiler-backend-peephole-byte-at data i) 10)
        (= (be_state.compiler-backend-peephole-byte-at data i) 13)))
      (+= i 1))
    (and
      (<= (+ i 6) n)
      (be_operand.compiler-backend-peephole-range-eq? data i (+ i 6) ".globl"))))

(define (compiler-backend-assembly-stream-carry-home-current!
  [stream : be_state.CompilerBackendStreamState]
  [home-arena : arena.Arena]) : unit
  ;; Rendering/appending the retained group can grow `home-arena`; its stable
  ;; root remains the owner used by every later flush.
  (unsafe
    (set!
      (deref (be_state.compiler-backend-stream-state-ptr stream)).assembly-home-arena
      home-arena)))

;; Flush one raw function group through the record pipeline. `scratch` is active
;; on entry and rewound before return: the chunk index, the line records and
;; every synthesized line live there, and only the single rendered group string
;; escapes into `home`. The group's raw chunks are parsed where the emitter left
;; them, so the flush neither flattens nor copies them -- one write per surviving
;; byte, into the final group string.
(define (compiler-backend-peephole-sweep-chunk-state-flush
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]
  [state : be_state.CompilerBackendPeepholeSweepChunkState]
  [scratch-mark : arena.ArenaMark]
  [home-arena : arena.Arena]) : be_state.CompilerBackendPeepholeSweepChunkState
  (if (text_buf.empty? (& state.group))
    state
    (let
      [chunks : be_state.CompilerBackendPeepholeChunkArray
        (be_peephole.compiler-backend-peephole-chunk-array state.group)]
      [records : be_state.CompilerBackendPeepholeLineVec
        (be_peephole.compiler-backend-peephole-asm-once-records-chunks
          backend-state
          stream
          chunks
          true)]
      [cursor : i64
        (compiler-backend-deadstore-sweep-records!
          backend-state
          stream
          records
          state.sweep-cursor)]
      ;; AFTER the dead-frame-store sweep: a triple whose store the sweep proved
      ;; dead is not a triple any more, and folding first would hide the store
      ;; the sweep is looking for behind a mnemonic it does not recognize.
      [_folded : unit
        (be_peephole.compiler-backend-peephole-rmw-fold-candidates!
          backend-state
          stream
          (be_state.compiler-backend-global-shared-view records))]
      [_compact : unit
        (be_peephole.compiler-backend-peephole-compact-stack-addresses!
          (&mut records))]
      [_compact-opt2 : unit
        (when
          (be_state.compiler-backend-state-tail-merging-enabled? backend-state)
          (be_peephole.compiler-backend-peephole-compact-records!
            backend-state
            (&mut records)))]
      [scratch-arena : arena.Arena (arena.current)]
      [merge? : bool
        (be_state.compiler-backend-state-tail-merging-enabled? backend-state)]
      [finished : be_state.CompilerBackendPeepholeSweepChunkState
        (unsafe
          ;; unsafe: a bare handle to the same home arena keeps an `in-arena`
          ;; result from naming a caller region; the state it returns lives in
          ;; that arena, whose owner outlives every use of it
          (in-arena
            (arena.Arena (arena.raw-handle home-arena))
            (let
              [_probes : unit
                (be_peephole.compiler-backend-expand-stack-probes!
                  backend-state
                  (&mut records))]
              ;; Win64 renders into scratch: the unwind lowering writes the
              ;; group's only home copy. Loop alignment reads the final order,
              ;; so it runs on the render; on Linux it writes the home copy.
              [align? : bool
                (be_state.compiler-backend-state-loop-align-enabled?
                  backend-state)]
              [kept : String
                (cond
                  [(be_state.compiler-backend-state-emission-target-policy
                      backend-state).seh-unwind
                    (in-arena
                      (arena.Arena (arena.raw-handle scratch-arena))
                      (be_peephole.compiler-backend-win64-lower-unwind
                        stream
                        (if align?
                          (be_peephole.compiler-backend-loop-align-text
                            (be_peephole.compiler-backend-peephole-records-render
                              records
                              merge?
                              merge?)
                            (arena.Arena (arena.raw-handle scratch-arena)))
                          (be_peephole.compiler-backend-peephole-records-render
                            records
                            merge?
                            merge?))
                        (arena.Arena (arena.raw-handle home-arena))))]
                  [align?
                    (in-arena
                      (arena.Arena (arena.raw-handle scratch-arena))
                      (be_peephole.compiler-backend-loop-align-text
                        (be_peephole.compiler-backend-peephole-records-render
                          records
                          merge?
                          merge?)
                        (arena.Arena (arena.raw-handle home-arena))))]
                  [else
                    (be_peephole.compiler-backend-peephole-records-render
                      records
                      merge?
                      merge?)])]
              (be_state.CompilerBackendPeepholeSweepChunkState
                (text_buf.append state.out kept)
                (text_buf.empty)
                cursor))))]
      [_carry-home : unit
        (compiler-backend-assembly-stream-carry-home-current! stream home-arena)]
      (compiler-backend-peephole-records-retire! stream)
      (unsafe
        (arena.rewind scratch-mark))
      finished)))

(define (compiler-backend-assembly-stream-start!
  [stream : be_state.CompilerBackendStreamState]
  [raw-arena : arena.Arena]
  [raw-mark : arena.ArenaMark]
  [peephole-arena : arena.Arena]
  [peephole-mark : arena.ArenaMark]
  [home-arena : arena.Arena]) : unit
  (let
    ;; unsafe: the stream state keeps these buffers while raw-arena and
    ;; home-arena live; a bare arena parameter's allocation cannot leave the call.
    [batch : text_buf.TextBuf
      (unsafe
        (in-arena (arena.Arena (arena.raw-handle raw-arena)) (text_buf.empty)))]
    [data : (MutPtr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-ptr stream)]
    (unsafe
      (set! (deref data).assembly-raw-arena raw-arena)
      (set! (deref data).assembly-raw-mark raw-mark)
      (set! (deref data).assembly-peephole-arena peephole-arena)
      (set! (deref data).assembly-peephole-mark peephole-mark)
      (set!
        (deref data).assembly-out
        (in-arena (arena.Arena (arena.raw-handle home-arena)) (text_buf.empty)))
      (set!
        (deref data).win64-xdata-ids
        (in-arena
          (arena.Arena (arena.raw-handle home-arena))
          (backend_string_i64_map.with-capacity 16)))
      (set! (deref data).win64-xdata-count 0)
      (set! (deref data).win64-unwind-end-count 0)
      (set! (deref data).assembly-home-arena home-arena)
      (set! (deref data).assembly-sweep-cursor 0)
      (set! (deref data).assembly-batch batch)
      (set! (deref data).assembly-batch-count 0)
      (set! (deref data).assembly-raw-ready false)
      (set! (deref data).assembly-active true))))

(define (compiler-backend-assembly-stream-begin-raw!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]) : unit
  (let
    [data : be_state.CompilerBackendStreamStateData
      (be_state.compiler-backend-stream-state-data stream)]
    (when
      data.assembly-active
      (unsafe
        (arena.set! data.assembly-raw-arena))
      (unless
        data.assembly-raw-ready
        (unsafe
          (arena.rewind data.assembly-raw-mark))
        (compiler-backend-clear-function-emit-state! backend-state)
        (set! data.assembly-raw-ready true)
        (be_state.compiler-backend-stream-state-data-set! stream data)))))

(define (compiler-backend-assembly-stream-rewind-raw!
  [_stream : be_state.CompilerBackendStreamState]) : unit
  ;; Raw function text stays until a bounded batch has passed peephole/sweep.
  unit)

;; Flush the current bounded raw batch, then reclaim its arena before the next
;; batch. The emitted output and sweep cursor are copied into the home-owned
;; stream state, so no references into the rewound raw arena remain.
(define (compiler-backend-assembly-stream-flush-batch!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]) : unit
  (let
    [data : be_state.CompilerBackendStreamStateData
      (be_state.compiler-backend-stream-state-data stream)]
    (unless
      (or (not data.assembly-active) (text_buf.empty? (& data.assembly-batch)))
      (let
        [source-arena : arena.Arena (arena.current)]
        [state : be_state.CompilerBackendPeepholeSweepChunkState
          (be_state.CompilerBackendPeepholeSweepChunkState
            data.assembly-out
            data.assembly-batch
            data.assembly-sweep-cursor)]
        (unsafe
          (arena.set! data.assembly-peephole-arena))
        (let
          [flushed : be_state.CompilerBackendPeepholeSweepChunkState
            (compiler-backend-peephole-sweep-chunk-state-flush
              backend-state
              stream
              state
              data.assembly-peephole-mark
              data.assembly-home-arena)]
          ;; The nested pass grows owner/sweep tables, retires its record
          ;; sink, and may carry a grown home-arena head. Reload every field
          ;; it published before updating the assembly half of the same
          ;; aggregate; writing the pre-pass snapshot here would resurrect
          ;; stale table handles/counts while leaving their in-place hash
          ;; entries live.
          [current : be_state.CompilerBackendStreamStateData
            (be_state.compiler-backend-stream-state-data stream)]
          (set! current.assembly-out flushed.out)
          (set! current.assembly-sweep-cursor flushed.sweep-cursor)
          (set! current.assembly-batch-count 0)
          (unsafe
            (arena.set! current.assembly-raw-arena))
          (unsafe
            (arena.rewind current.assembly-raw-mark))
          (set! current.assembly-batch (text_buf.empty))
          (compiler-backend-clear-function-emit-state! backend-state)
          (set! current.assembly-raw-ready true)
          (be_state.compiler-backend-stream-state-data-set! stream current)
          (unsafe
            (arena.set! source-arena)))))))

;; Append one function/adapter emission. A batch boundary is also a `.globl`
;; boundary, so flushing it matches a whole-stream peephole's output.
(define (compiler-backend-assembly-stream-process-string!
  [raw-asm : String]
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]) : unit
  ;; #block-layout does NOT run here. The text is appended to the batch exactly
  ;; as the emitter left it and each chunk is laid out inside the peephole's own
  ;; line walk at flush time: a batch chunk IS one whole emitted text, which is
  ;; the unit the layout rewrites are stated over, so folding the pass into that
  ;; walk keeps its input and its result while parsing the text once.
  (let
    [data : be_state.CompilerBackendStreamStateData
      (be_state.compiler-backend-stream-state-data stream)]
    (when
      data.assembly-active
      (set! data.assembly-batch (text_buf.append data.assembly-batch raw-asm))
      (+= data.assembly-batch-count 1)
      (be_state.compiler-backend-stream-state-data-set!
        stream
        (be_state.compiler-backend-global-shared-view data))
      (when
        (>=
          data.assembly-batch-count
          be_state.compiler-backend-assembly-stream-batch-function-limit)
        (compiler-backend-assembly-stream-flush-batch! backend-state stream)))))

(define (compiler-backend-assembly-stream-process-buffer!
  [raw : text_buf.TextBuf]
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]) : unit
  (unless
    (or
      (not (be_facts.compiler-backend-assembly-stream-active? stream))
      (text_buf.empty? (& raw)))
    (compiler-backend-assembly-stream-flush-batch! backend-state stream)
    ;; Preserve the chunked representation for oversized functions. Flattening
    ;; RAW here can require one allocation larger than an arena segment before
    ;; the peephole pipeline has a chance to consume its chunks.
    (let
      [data : (MutPtr be_state.CompilerBackendStreamStateData)
        (be_state.compiler-backend-stream-state-ptr stream)]
      (unsafe
        ;; The flush above leaves the batch empty, so moving RAW into it is
        ;; the chunk-preserving equivalent of appending to that empty batch.
        (set! (deref data).assembly-batch raw)
        (set! (deref data).assembly-batch-count 1)))
    (compiler-backend-assembly-stream-flush-batch! backend-state stream)))

(define (compiler-backend-assembly-stream-output
  [stream : be_state.CompilerBackendStreamState]) : text_buf.TextBuf
  (let
    [data : (Ptr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-view stream)]
    (unsafe
      (if (deref data).assembly-active
        (deref data).assembly-out
        (text_buf.empty)))))

(define (compiler-backend-assembly-stream-finish!
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]) : text_buf.TextBuf
  (compiler-backend-assembly-stream-flush-batch! backend-state stream)
  (let
    [out : text_buf.TextBuf (compiler-backend-assembly-stream-output stream)]
    [data : (MutPtr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-ptr stream)]
    (unsafe
      (set! (deref data).assembly-active false)
      (set!
        (deref data).assembly-raw-arena
        (unsafe
          (arena.Arena 0)))
      (set! (deref data).assembly-raw-mark (arena.ArenaMark 0))
      (set!
        (deref data).assembly-peephole-arena
        (unsafe
          (arena.Arena 0)))
      (set! (deref data).assembly-peephole-mark (arena.ArenaMark 0))
      (set! (deref data).assembly-batch (text_buf.empty))
      (set! (deref data).assembly-batch-count 0)
      (set! (deref data).assembly-raw-ready false))
    out))

(define (compiler-backend-assembly-stream-abort!
  [stream : be_state.CompilerBackendStreamState]) : unit
  (let
    [data : (MutPtr be_state.CompilerBackendStreamStateData)
      (be_state.compiler-backend-stream-state-ptr stream)]
    (unsafe
      (set! (deref data).assembly-active false)
      (set!
        (deref data).assembly-raw-arena
        (unsafe
          (arena.Arena 0)))
      (set! (deref data).assembly-raw-mark (arena.ArenaMark 0))
      (set!
        (deref data).assembly-peephole-arena
        (unsafe
          (arena.Arena 0)))
      (set! (deref data).assembly-peephole-mark (arena.ArenaMark 0))
      (set!
        (deref data).assembly-home-arena
        (unsafe
          (arena.Arena 0)))
      (set! (deref data).assembly-out (text_buf.empty))
      (set! (deref data).assembly-sweep-cursor 0)
      (set! (deref data).assembly-batch (text_buf.empty))
      (set! (deref data).assembly-batch-count 0)
      (set! (deref data).assembly-raw-ready false))))

(define (compiler-backend-peephole-asm-buffer-with-state
  [backend-state : be_state.CompilerBackendState]
  [stream : be_state.CompilerBackendStreamState]
  [asm : String]
  [drop-fallthrough? : bool]
  [probe-final? : bool]) : text_buf.TextBuf
  ;; The streaming pass runs the complete rule set while each line pair and its
  ;; owner state are hot. Re-running it would parse and copy the whole assembly
  ;; again to remove only a small fraction of what the first pass removes. Keep
  ;; that marginal reapplication out of the compile path; the missed cascades
  ;; are optional code-size rewrites.
  ;; GAP5 then sweeps never-read local frame stores recorded during emission --
  ;; over the same records, so the text is rendered exactly once.
  ;; #block-layout: the whole-text mirror of the streaming pipeline. The
  ;; streamed path lays out each emitted text as its own chunk of the walk; this
  ;; entry hands the walk the SAME texts concatenated as one chunk, and the
  ;; rewrites are function-local (they never cross a delimiting directive and
  ;; only name `.L` labels), so laying out the concatenation is laying out each
  ;; piece. Both are gated inside the walk on `drop-fallthrough?`, the flag that
  ;; already distinguishes the production shape from the bare peephole the unit
  ;; tests exercise.
  (let
    [records : be_state.CompilerBackendPeepholeLineVec
      (be_peephole.compiler-backend-peephole-asm-once-records
        backend-state
        stream
        (be_state.compiler-backend-global-shared-view asm)
        drop-fallthrough?)]
    [_swept : i64
      (compiler-backend-deadstore-sweep-records! backend-state stream records 0)]
    [_folded : unit
      (be_peephole.compiler-backend-peephole-rmw-fold-candidates!
        backend-state
        stream
        (be_state.compiler-backend-global-shared-view records))]
    [_compact : unit
      (when
        probe-final?
        (be_peephole.compiler-backend-peephole-compact-stack-addresses!
          (&mut records)))]
    [_compact-opt2 : unit
      (when
        (and
          probe-final?
          (be_state.compiler-backend-state-tail-merging-enabled? backend-state))
        (be_peephole.compiler-backend-peephole-compact-records!
          backend-state
          (&mut records)))]
    [_probed : unit
      (when
        probe-final?
        (be_peephole.compiler-backend-expand-stack-probes!
          backend-state
          (&mut records)))]
    [buf : text_buf.TextBuf
      (compiler-backend-borrowed-copy-to-owned
        (be_peephole.compiler-backend-peephole-records-buffer
          (text_buf_borrowed.empty-like (& asm))
          records
          asm
          (be_state.compiler-backend-state-tail-merging-enabled? backend-state)
          (and
            probe-final?
            (be_state.compiler-backend-state-tail-merging-enabled?
              backend-state))))]
    (compiler-backend-peephole-records-retire! stream)
    (compiler-backend-sweep-reset! backend-state stream)
    buf))

;; Production entry: same whole-text pass with the fallthrough-`jmp` deletion
;; folded in, matching what the streaming emission walk applies per group.
(define (compiler-backend-peephole-asm-drop-fallthrough [asm : String]) : String
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [stream : be_state.CompilerBackendStreamState
      (be_state.compiler-backend-state-stream-state backend-state)]
    (compiler-backend-sweep-reset! backend-state stream)
    (text_buf.render
      (compiler-backend-peephole-asm-buffer-with-state
        backend-state
        stream
        asm
        true
        false))))

;; PIC uses the whole-text finalizer rather than a streaming group flush.
;; Its production boundary must expand probes after the same analyses.
(define (compiler-backend-peephole-asm-drop-fallthrough-target
  [asm : String]
  [target : be_state.CompilerBackendTarget]
  [merge-tails? : bool]) : String
  (let
    [state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [stream : be_state.CompilerBackendStreamState
      (be_state.compiler-backend-state-stream-state state)]
    (be_state.compiler-backend-state-set-emission-target-policy!
      state
      (be_state.compiler-backend-target-policy-new target))
    (be_state.compiler-backend-state-set-tail-merging-enabled!
      state
      merge-tails?)
    (text_buf.render
      (compiler-backend-peephole-asm-buffer-with-state
        state
        stream
        asm
        true
        true))))

(define (compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : be_state.ResultCompilerBackendBuffer
  ;; Stream prefix/function/adapter/tail emission through peephole and sweep.
  ;; Each function's raw arena is rewound as soon as its final output chunk is
  ;; copied home, so the backend never retains the program's raw function text.
  (let
    [home-arena : arena.Arena (arena.current)]
    [stream : be_state.CompilerBackendStreamState
      (be_state.compiler-backend-state-stream-state backend-state)]
    [_set-emission-arena : unit
      (be_state.compiler-backend-state-set-emission-arena!
        backend-state
        home-arena)]
    [emit-arena : arena.Arena (arena.make)]
    [raw-arena : arena.Arena (arena.make)]
    [peephole-arena : arena.Arena (arena.make)]
    (unsafe
      (arena.set! raw-arena))
    (let
      [raw-mark : arena.ArenaMark (arena.mark)]
      (unsafe
        (arena.set! peephole-arena))
      (let
        [peephole-mark : arena.ArenaMark (arena.mark)]
        (unsafe
          (arena.set! emit-arena))
        (compiler-backend-assembly-stream-start!
          stream
          raw-arena
          raw-mark
          peephole-arena
          peephole-mark
          home-arena)
        (let
          [emitted : be_state.ResultCompilerBackendBuffer
            (if crt-entry
              (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
                backend-state
                type-segment-bases
                program
                target
                mode
                spans
                emit-entry
                crt-entry
                false
                profile-state)
              (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
                backend-state
                type-segment-bases
                program
                target
                mode
                spans
                emit-entry
                false
                false
                profile-state))]
          [stream-data : (MutPtr be_state.CompilerBackendStreamStateData)
            (be_state.compiler-backend-stream-state-ptr stream)]
          [arg-entries : i64
            (unsafe
              (deref stream-data).arg-entries)]
          (unsafe
            (set! (deref stream-data).arg-entries 0))
          (match emitted
            [(Ok _)
              (let
                [final-home-arena : arena.Arena
                  (unsafe
                    (deref stream-data).assembly-home-arena)]
                [final : text_buf.TextBuf
                  (compiler-backend-assembly-stream-finish!
                    backend-state
                    stream)]
                (when
                  (not (= arg-entries 0))
                  (unsafe
                    (arena.set! emit-arena))
                  (set!
                    final
                    (be_peephole.compiler-backend-arg-entry-optimize
                      final
                      (unsafe
                        (ptr-read
                          (int->ptr
                            (cast arg-entries : u64)
                            : (Ptr be_state.CompilerBackendArgEntries))))
                      final-home-arena)))
                (unsafe
                  (arena.destroy emit-arena))
                (unsafe
                  (arena.destroy raw-arena))
                (unsafe
                  (arena.set! final-home-arena))
                (compiler-backend-sweep-reset! backend-state stream)
                (unsafe
                  (arena.destroy peephole-arena))
                (compiler-backend-clear-scratch-escaped-emit-state!
                  backend-state)
                (if (be_state.compiler-backend-state-emission-target-policy
                  backend-state).shared-object
                  (be_data.compiler-backend-shared-object-assembly
                    (text_buf.render final))
                  (Ok final)))]
            [(Err message)
              (let
                [owned-message : (Box compiler_diagnostic.CompilerDiagnostic)
                  (in-arena
                    home-arena
                    (box
                      (compiler_diagnostic.compiler-diagnostic-copy
                        (deref message))))]
                (compiler-backend-assembly-stream-abort! stream)
                (unsafe
                  (arena.destroy emit-arena))
                (unsafe
                  (arena.destroy raw-arena))
                (unsafe
                  (arena.set! home-arena))
                (unsafe
                  (arena.destroy peephole-arena))
                (compiler-backend-clear-scratch-escaped-emit-state!
                  backend-state)
                (Err owned-message))]))))))

(define (compiler-backend-emit-program-target-with-mode-final-buffer-with-pools-and-crt-and-profile-state-backend-state
  [backend-state : be_state.CompilerBackendState]
  [pools : compiler_ast_types.AstNodePoolContext]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : be_state.ResultCompilerBackendBuffer
  (let
    [problem : String
      (compiler-backend-state-authorize-return-storage!
        backend-state
        pools
        program
        target)]
    (if (> (string.string-length problem) 0)
      (be_state.ResultCompilerBackendBuffer.Err
        (be_state.compiler-backend-return-storage-authority-diagnostic problem))
      (compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
        backend-state
        (compiler_ast_types.ast-node-pool-context-type-segment-bases pools)
        program
        target
        mode
        spans
        emit-entry
        crt-entry
        profile-state))))

(define (compiler-backend-emit-program-target-with-mode
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]) : be_state.ResultCompilerBackend
  (let
    [buf
      (try
        (compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
          (be_state.compiler-backend-state-new
            (ci.intern-compat-state-capture-active))
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          program
          target
          mode
          spans
          emit-entry
          false
          (profile_state.compiler-profile-state-new)))]
    (Ok (text_buf.render buf))))

(define (compiler-backend-emit-program-target-with-mode-with-pools-and-crt-and-profile-state-backend-state
  [backend-state : be_state.CompilerBackendState]
  [pools : compiler_ast_types.AstNodePoolContext]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : be_state.ResultCompilerBackend
  (let
    [buf
      (try
        (compiler-backend-emit-program-target-with-mode-final-buffer-with-pools-and-crt-and-profile-state-backend-state
          backend-state
          pools
          program
          target
          mode
          spans
          emit-entry
          crt-entry
          profile-state))]
    [asm : String (text_buf.render buf)]
    (Ok
      (if (be_state.compiler-backend-state-closed-executable? backend-state)
        (compiler-backend-closed-executable-finish backend-state target asm)
        asm))))

;; The closed program is the whole text, so only now are helper fragments
;; known dead and every surviving return tail known. Interning runs after the
;; prune: a shared tail must not live in a fragment the prune removes.
;; A program linked against a prebuilt stdlib archive is not the whole text:
;; archive members call runtime entry points (`tl_alloc16`, `tl_array_zero`,
;; ...) this text never names, so every helper stays and the linker's section
;; GC drops what no object references.
(define (compiler-backend-closed-executable-finish
  [backend-state : be_state.CompilerBackendState]
  [target : be_state.CompilerBackendTarget]
  [asm : String]) : String
  (let
    [kept : String
      (if (be_state.compiler-backend-state-archive-runtime? backend-state)
        asm
        (runtime_prune.prune asm))]
    (cond
      [(or
          (not
            (be_state.compiler-backend-state-optimize-for-size? backend-state))
          (compiler_ir_types.compiler-debug-info-enabled?))
        kept]
      [(be_state.compiler-backend-target-coff? target)
        (be_peephole.compiler-backend-machine-outline kept true)]
      [else
        (be_peephole.compiler-backend-machine-outline
          (runtime_prune.intern-epilogues kept)
          false)])))

(define (compiler-backend-lower-mode-for-target
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]) : compiler_lower.CompilerLowerMode
  (match mode
    [(Sse2)
      (match target
        [(be_state.CompilerBackendTarget.Linux)
          (compiler_lower.CompilerLowerMode.LinuxSse2)]
        [(be_state.CompilerBackendTarget.Windows)
          (compiler_lower.CompilerLowerMode.WindowsSse2)])]
    [(Avx2)
      (match target
        [(be_state.CompilerBackendTarget.Linux)
          (compiler_lower.CompilerLowerMode.LinuxAvx2)]
        [(be_state.CompilerBackendTarget.Windows)
          (compiler_lower.CompilerLowerMode.WindowsAvx2)])]
    [(Avx512)
      (match target
        [(be_state.CompilerBackendTarget.Linux)
          (compiler_lower.CompilerLowerMode.LinuxAvx512)]
        [(be_state.CompilerBackendTarget.Windows)
          (compiler_lower.CompilerLowerMode.WindowsAvx512)])]
    [_
      (match target
        [(be_state.CompilerBackendTarget.Linux)
          (compiler_lower.CompilerLowerMode.LinuxScalar)]
        [(be_state.CompilerBackendTarget.Windows)
          (compiler_lower.CompilerLowerMode.WindowsScalar)])]))

(define (compiler-backend-lower-source-for-target
  [src : String]
  [target : be_state.CompilerBackendTarget]) : compiler_lower.ResultCompilerLower
  (when
    (compiler_lower.lower-resetting-entry-in-live-session?)
    (return
      (compiler_lower.lower-resetting-entry-live-session-error
        "compiler-backend-lower-source-for-target"
        "<source>")))
  (let
    [request : compiler_lower.CompilerLowerRequest
      (compiler_lower.compiler-lower-request
        (compiler-backend-lower-mode-for-target target (Scalar)))]
    (set! request.executable true)
    (compiler_lower.lower-compiler-source-with-request
      "<source>"
      src
      (& request))))

;; Additive jobs share the enclosing node/name owners and use private import
;; and typecheck request state; they never reset the enclosing session.
(define (compiler-backend-lower-source-for-target-in-session
  [src : String]
  [target : be_state.CompilerBackendTarget]) : compiler_lower.ResultCompilerLower
  (let
    [request : compiler_lower.CompilerLowerRequest
      (compiler_lower.compiler-lower-request
        (compiler-backend-lower-mode-for-target target (Scalar)))]
    (set! request.in-session true)
    (set! request.executable true)
    (compiler_lower.lower-compiler-source-with-request
      "<source>"
      src
      (& request))))

(define (compiler-backend-emit-source [src : String]) : be_state.ResultCompilerBackend
  (match (compiler_lower.lower-compiler-source src)
    [(Ok program spans lower-state)
      (let
        [result : be_state.ResultCompilerBackend
          (compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Scalar)
            spans
            true)]
        (compiler_lower.compiler-lower-arena-state-release!
          (compiler_lower.compiler-lower-state-arenas lower-state))
        result)]
    [(Err diag) (Err diag)]))

(define (compiler-backend-emit-source-for-target
  [src : String]
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (match (compiler-backend-lower-source-for-target src target)
    [(Ok program spans lower-state)
      (let
        [result : be_state.ResultCompilerBackend
          (compiler-backend-emit-program-target-with-mode
            program
            target
            (Scalar)
            spans
            true)]
        (compiler_lower.compiler-lower-arena-state-release!
          (compiler_lower.compiler-lower-state-arenas lower-state))
        result)]
    [(Err diag) (Err diag)]))

(define (compiler-backend-emit-source-object-image-for-target
  [src : String]
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackendObject
  (match (compiler-backend-lower-source-for-target src target)
    [(Ok program spans lower-state)
      (let
        [result : be_state.ResultCompilerBackendObject
          (be_object.compiler-backend-emit-program-object-image-target-with-mode-and-crt
            program
            target
            (Scalar)
            spans
            true
            false)]
        (compiler_lower.compiler-lower-arena-state-release!
          (compiler_lower.compiler-lower-state-arenas lower-state))
        result)]
    [(Err diag) (Err diag)]))

(define (compiler-backend-string-count
  [text : (& text str)]
  [needle : (& needle str)]) : i64
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      0
      (let
        [i : i64 0]
        [count : i64 0]
        (while (<= (+ i needle-len) text-len)
          (if (be_operand.compiler-backend-string-prefix-at? text needle i)
            (begin
              (+= count 1)
              (+= i needle-len))
            (+= i 1)))
        count))))

(define compiler-backend-pic-image-base-label : String
  ".L_tl_pic_image_base")

(define (compiler-backend-string-find-from
  [text : (& text str)]
  [needle : (& needle str)]
  [start : i64]) : i64
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      start
      (if (= needle-len 1)
        (string.index-of-byte
          (& text)
          start
          (cast (string.string-ref needle 0) : u8))
        (let
          [i : i64 start]
          [found : i64 -1]
          [done : bool false]
          (while (not done)
            (if (<= (+ i needle-len) text-len)
              (if (be_operand.compiler-backend-string-prefix-at? text needle i)
                (begin
                  (set! found i)
                  (set! done true))
                (+= i 1))
              (set! done true)))
          found)))))

(define (compiler-backend-string-replace-all
  [text : String]
  [needle : String]
  [replacement : String]) : String
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      text
      (let
        [i : i64 0]
        [out : text_buf.TextBuf (text_buf.empty)]
        [done : bool false]
        (while (not done)
          (let
            [pos : i64 (compiler-backend-string-find-from text needle i)]
            (if (< pos 0)
              (begin
                (if (< i text-len)
                  (set!
                    out
                    (text_buf.append
                      out
                      (string.substring text i (- text-len i))))
                  unit)
                (set! done true))
              (begin
                (if (> pos i)
                  (set!
                    out
                    (text_buf.append out (string.substring text i (- pos i))))
                  unit)
                (set!
                  out
                  (text_buf.append
                    out
                    (be_state.compiler-backend-global-shared-view replacement)))
                (set! i (+ pos needle-len))))))
        (text_buf.render out)))))

(define (compiler-backend-pic-quad-pattern [target : (& target str)]) : String
  (str_cat.str-cat "    .quad " target "\n"))

(define (compiler-backend-pic-quad-replacement [_target : String]) : String
  "    .quad 0\n")

(define (compiler-backend-pic-rewrite-target [asm : String] [target : String]) : String
  (compiler-backend-string-replace-all
    asm
    (compiler-backend-pic-quad-pattern target)
    (compiler-backend-pic-quad-replacement target)))

(define (compiler-backend-pic-rewrite-relocs
  [asm : String]
  [relocs : cobj.CompilerObjectRelocationList]) : String
  (let
    [count : i64 (cobj.compiler-object-relocation-list-count relocs)]
    [out : String asm]
    (for [index (iterator.range 0 count)]
      (match (cobj.compiler-object-relocation-list-ref relocs index)
        [(Relocation _ _ kind target)
          (match kind
            [(Abs64)
              (set! out (compiler-backend-pic-rewrite-target out target))]
            [_ unit])]))
    out))

(define (compiler-backend-pic-data-record-end-offset
  [record : cobj.CompilerObjectDataRecord]
  [offset : i64]) : i64
  (cobj.compiler-object-data-record-end-offset (& record) offset))

(define (compiler-backend-pic-data-label-offset-from
  [records : cobj.CompilerObjectDataRecordList]
  [label : String]
  [offset : i64]) : i64
  (let
    [count : i64 (cobj.compiler-object-data-record-list-count records)]
    [index : i64 0]
    [cur-offset : i64 offset]
    [result : i64 -1]
    [done : bool false]
    (while (and (not done) (< index count))
      (let
        [record : cobj.CompilerObjectDataRecord
          (cobj.compiler-object-data-record-list-ref records index)]
        (match (& record)
          [(Label found)
            (if (string.eq found label)
              (begin
                (set! result cur-offset)
                (set! done true))
              (+= index 1))]
          [_
            (set!
              cur-offset
              (compiler-backend-pic-data-record-end-offset record cur-offset))
            (+= index 1)])))
    result))

(define (compiler-backend-pic-section-label-offset
  [image : cobj.CompilerObjectImage]
  [kind : cobj.CompilerObjectSectionKind]
  [label : String]) : i64
  (match (cobj.compiler-object-section-list-find image.sections kind)
    [(Section _ data _)
      (match kind
        [(Text) -1]
        [_ (compiler-backend-pic-data-label-offset-from data label 0)])]))

(define (compiler-backend-pic-section-name
  [kind : cobj.CompilerObjectSectionKind]) : String
  (match kind
    [(Text) "text"]
    [(Data) "data"]
    [(Rodata) "rodata"]
    [(Bss) "bss"]
    [(Pdata) "pdata"]
    [(Xdata) "xdata"]
    [(Rsrc) "rsrc"]))

(define (compiler-backend-pic-fixup-line
  [section : cobj.CompilerObjectSectionKind]
  [offset : i64]
  [site : String]
  [target : String]) : String
  (str_cat.str-cat
    (str_cat.str-cat
      (compiler-backend-pic-section-name section)
      " "
      (string.int->string offset)
      " "
      site)
    " "
    target
    "\n"))

(define (compiler-backend-pic-fixup-table-relocs
  [image : cobj.CompilerObjectImage]
  [relocs : cobj.CompilerObjectRelocationList]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (let
    [count : i64 (cobj.compiler-object-relocation-list-count relocs)]
    [out : text_buf.TextBuf buf]
    (for [index (iterator.range 0 count)]
      (match (cobj.compiler-object-relocation-list-ref relocs index)
        [(Relocation section site kind target)
          (match kind
            [(Abs64)
              (let
                [offset : i64
                  (compiler-backend-pic-section-label-offset
                    (be_state.compiler-backend-global-shared-view image)
                    section
                    (be_state.compiler-backend-global-shared-view site))]
                (if (>= offset 0)
                  (set!
                    out
                    (text_buf.append
                      out
                      (compiler-backend-pic-fixup-line
                        section
                        offset
                        site
                        target)))
                  unit))]
            [_ unit])]))
    out))

(define (compiler-backend-pic-fixup-table [image : cobj.CompilerObjectImage]) : String
  (text_buf.render
    (compiler-backend-pic-fixup-table-relocs
      (be_state.compiler-backend-global-shared-view image)
      image.relocations
      (text_buf.append (text_buf.empty) "typelisp-pic-fixups v1\n"))))

(define (compiler-backend-pic-symbols-have-extern?
  [symbols : cobj.CompilerObjectSymbolList]) : bool
  (let
    [count : i64 (cobj.compiler-object-symbol-list-count symbols)]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (cobj.compiler-object-symbol-list-ref symbols index)
        [(Symbol _ binding _ _)
          (match binding
            [(Extern) (set! found true)]
            [_ (+= index 1)])]))
    found))

(define (compiler-backend-pic-target-symbol-internal?
  [symbols : cobj.CompilerObjectSymbolList]
  [target : String]) : bool
  (let
    [count : i64 (cobj.compiler-object-symbol-list-count symbols)]
    [index : i64 0]
    [result : bool false]
    [done : bool false]
    (while (and (not done) (< index count))
      (match (cobj.compiler-object-symbol-list-ref symbols index)
        [(Symbol name binding _ section)
          (if (string.eq name target)
            (begin
              (set!
                result
                (match binding
                  [(Extern) false]
                  [_
                    (match section
                      [(No) false]
                      [_ true])]))
              (set! done true))
            (+= index 1))]))
    result))

(define (compiler-backend-pic-reloc-site-valid?
  [image : cobj.CompilerObjectImage]
  [reloc : cobj.CompilerObjectRelocation]) : bool
  (match reloc
    [(Relocation section site kind target)
      (match kind
        [(Abs64)
          (and
            (compiler-backend-pic-target-symbol-internal? image.symbols target)
            (match section
              [(or (Data) (Rodata))
                (let
                  [offset : i64
                    (compiler-backend-pic-section-label-offset
                      (be_state.compiler-backend-global-shared-view image)
                      section
                      site)]
                  (and (>= offset 0) (= (% offset 8) 0)))]
              [_ false]))]
        [_ true])]))

(define (compiler-backend-pic-relocs-valid?
  [image : cobj.CompilerObjectImage]
  [relocs : cobj.CompilerObjectRelocationList]) : bool
  (let
    [count : i64 (cobj.compiler-object-relocation-list-count relocs)]
    [index : i64 0]
    [ok : bool true]
    (while (and ok (< index count))
      (if (compiler-backend-pic-reloc-site-valid?
        (be_state.compiler-backend-global-shared-view image)
        (cobj.compiler-object-relocation-list-ref relocs index))
        (+= index 1)
        (set! ok false)))
    ok))

(define (compiler-backend-pic-asm
  [asm : String]
  [image : cobj.CompilerObjectImage]) : String
  (str_cat.str-cat
    (str_cat.str-cat
      ".text\n"
      (be_state.compiler-backend-string-shared-view
        (& compiler-backend-pic-image-base-label))
      ":\n")
    (compiler-backend-pic-rewrite-relocs asm image.relocations)))

(define (compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt-and-profile-state-backend-state
  [backend-state : be_state.CompilerBackendState]
  [type-segment-bases : i64]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : be_state.ResultCompilerBackendPic
  (let
    [buf
      (try
        (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
          backend-state
          type-segment-bases
          (be_state.compiler-backend-global-shared-view program)
          target
          mode
          (be_state.compiler-backend-global-shared-view spans)
          emit-entry
          crt-entry
          true
          profile-state))]
    [image
      (try
        (be_object.compiler-backend-emit-program-object-image-target-with-mode-with-type-segment-bases-and-crt-and-profile-state-backend-state
          backend-state
          type-segment-bases
          program
          target
          mode
          spans
          emit-entry
          crt-entry
          true
          profile-state))]
    (if (compiler-backend-pic-symbols-have-extern? image.symbols)
      (Err
        (box
          (compiler_diagnostic.compiler-diagnostic-at-start
            ""
            "backend: --pic supports only internal references; extern symbols are not supported")))
      (if (compiler-backend-pic-relocs-valid?
        (be_state.compiler-backend-global-shared-view image)
        image.relocations)
        (Ok
          (be_state.CompilerBackendPicOutput
            (compiler-backend-pic-asm
              (compiler-backend-peephole-asm-drop-fallthrough-target
                (text_buf.render buf)
                target
                (be_state.compiler-backend-state-tail-merging-enabled?
                  backend-state))
              (be_state.compiler-backend-global-shared-view image))
            (compiler-backend-pic-fixup-table
              (be_state.compiler-backend-global-shared-view image))))
        (Err
          (box
            (compiler_diagnostic.compiler-diagnostic-at-start
              ""
              "backend: --pic could not map every absolute pointer fixup to an 8-byte data slot")))))))

(define (compiler-backend-emit-program-pic-target-with-mode-with-pools-and-crt-and-profile-state-backend-state
  [backend-state : be_state.CompilerBackendState]
  [pools : compiler_ast_types.AstNodePoolContext]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : be_state.ResultCompilerBackendPic
  (let
    [problem : String
      (compiler-backend-state-authorize-return-storage!
        backend-state
        pools
        program
        target)]
    (if (> (string.string-length problem) 0)
      (be_state.ResultCompilerBackendPic.Err
        (be_state.compiler-backend-return-storage-authority-diagnostic problem))
      (compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt-and-profile-state-backend-state
        backend-state
        (compiler_ast_types.ast-node-pool-context-type-segment-bases pools)
        program
        target
        mode
        spans
        emit-entry
        crt-entry
        profile-state))))

(define (compiler-backend-emit-source-pic-for-target
  [src : String]
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackendPic
  (match (compiler-backend-lower-source-for-target src target)
    [(Ok program spans lower-state)
      (let
        [result : be_state.ResultCompilerBackendPic
          (compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt-and-profile-state-backend-state
            (be_state.compiler-backend-state-new
              (ci.intern-compat-state-capture-active))
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            program
            target
            (Scalar)
            spans
            true
            false
            (profile_state.compiler-profile-state-new))]
        (compiler_lower.compiler-lower-arena-state-release!
          (compiler_lower.compiler-lower-state-arenas lower-state))
        result)]
    [(Err diag) (Err diag)]))

