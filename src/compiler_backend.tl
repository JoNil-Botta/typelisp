      (compiler-backend-runtime-index-defines-concat? index)]
    [provides-substring : bool
      (compiler-backend-function-list-defines-runtime-prelude-helper?
        functions
        "substring")]
    [provides-str-view : bool
      (compiler-backend-function-list-defines-runtime-prelude-helper?
        functions
        "str-view")]
    [provides-concat : bool
      (backend-or4
        (compiler-backend-function-list-defines-runtime-prelude-helper?
