;; compiler_backend.tl - Selfhost CompilerIrProgram -> x86_64 .s emitter.
(cfg (any compile-profile regalloc-census scavenge-census) (import stdlib.io))
(cfg compile-profile (import stdlib.profile))
(cfg compile-profile-summary (import compiler_profile_summary as cps))
(import "compiler_lower.tl")
(import compiler_builtin_ids as cbi)
(import "compiler_diagnostic.tl")
(import "compiler_optimize.tl")
(import "compiler_abi.tl")
(import "compiler_regalloc.tl")
(import compiler_parallel_move as pmove)
(import compiler_profile_state as profile_state)
(import compiler_backend_runtime_common as runtime_common)
(import compiler_backend_runtime_linux as runtime_linux)
(import compiler_backend_runtime_windows as runtime_windows)
(import compiler_backend_object_target as object_target)
(import compiler_backend_object_target_linux as object_linux)
(import compiler_backend_object_target_windows as object_windows)
(import stdlib.text_buf)
(import stdlib.text_buf_borrowed)
(import compiler_object as cobj)
(import compiler_intern as ci)
(import sym_i64_env)
(import stdlib.array)
(import stdlib.arena)
(import stdlib.hash)
(import stdlib.hashmap)
(import (hashmap.hashmap String i64) as backend_string_i64_map)

;; Block labels are interned ids, so their maps are integer-keyed (refs #5718).
(import (hashmap.hashmap i64 i64) as backend_label_i64_map)
(import (hashmap.hashmap i64 i64) as backend_i64_i64_map)
(import stdlib.string)
(import stdlib.byte_buf_core)
(import stdlib.str_cat_runtime as str_cat)
(import stdlib.option)
(import (option.option i64) as option_i64)

(unsafe
  (extern (compiler-backend-runtime-index-of-byte
    [ptr : (Ptr u8)]
    [len : i64]
    [byte : u8]) : i64 (:symbol "tl_memchr")))

;; Raw active-arena bytes for the assembly-text builder below -- the same
;; allocator `stdlib.string`'s concat helpers use for every String they build.
(unsafe
  (extern (compiler-backend-asm-buf-alloc [size : i64]) : (MutPtr u8) (:symbol "tl_alloc")))

(cfg
  compile-profile
  (define compiler-backend-profile-start-ms-metric : i64
    28))
(cfg
  compile-profile
  (define compiler-backend-profile-start-total-metric : i64
    29))
(cfg
  compile-profile
  (define compiler-backend-profile-start-live-metric : i64
    30))
(cfg
  compile-profile
  (define compiler-backend-profile-detail-start-ms-metric : i64
    31))

(cfg
  compile-profile-summary
  (define (compiler-backend-profile-summary-reset!
    [state : profile_state.CompilerProfileState]) : unit
    ;; Optimizer and backend rows share one job table. The driver performs the
    ;; single reset before either phase begins.
    unit))

(cfg
  compile-profile-summary
  (define (compiler-backend-profile-summary-emit
    [state : profile_state.CompilerProfileState]) : unit
    (begin
      (cps.compiler-profile-summary-emit
        state
        cps.compiler-profile-summary-backend-function
        "backend"
        "function")
      (cps.compiler-profile-summary-emit
        state
        cps.compiler-profile-summary-backend-module
        "backend"
        "module"))))

(cfg
  compile-profile
  (define (compiler-backend-profile-field [value : i64]) : String
    (string.append "|" (string.int->string value))))

(cfg
  compile-profile
  (define (compiler-backend-profile-start
    [state : profile_state.CompilerProfileState]) : unit
    (begin
      (profile_state.compiler-profile-state-metric-set!
        state
        compiler-backend-profile-start-ms-metric
        (profile.now-ms))
      (profile_state.compiler-profile-state-metric-set!
        state
        compiler-backend-profile-start-total-metric
        (profile.alloc-total))
      (profile_state.compiler-profile-state-metric-set!
        state
        compiler-backend-profile-start-live-metric
        (profile.alloc-live))
      (profile.alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-backend-profile-finish
    [state : profile_state.CompilerProfileState]
    [phase : String]) : unit
    (let
      [end-ms : i64 (profile.now-ms)]
      [end-total : i64 (profile.alloc-total)]
      [end-live : i64 (profile.alloc-live)]
      [peak-delta : i64
        (-
          (profile.alloc-peak)
          (profile_state.compiler-profile-state-metric-value
            state
            compiler-backend-profile-start-live-metric))]
      (io.print-error
        (string.append
          "compile-profile|backend."
          (string.append
            phase
            (string.append
              (compiler-backend-profile-field
                (-
                  end-ms
                  (profile_state.compiler-profile-state-metric-value
                    state
                    compiler-backend-profile-start-ms-metric)))
              (string.append
                (compiler-backend-profile-field
                  (-
                    end-total
                    (profile_state.compiler-profile-state-metric-value
                      state
                      compiler-backend-profile-start-total-metric)))
                (string.append
                  (compiler-backend-profile-field
                    (-
                      end-live
                      (profile_state.compiler-profile-state-metric-value
                        state
                        compiler-backend-profile-start-live-metric)))
                  (string.append
                    (compiler-backend-profile-field peak-delta)
                    "\n"))))))))))

(cfg
  compile-profile
  (define (compiler-backend-profile-detail-start
    [state : profile_state.CompilerProfileState]) : unit
    (profile_state.compiler-profile-state-metric-set!
      state
      compiler-backend-profile-detail-start-ms-metric
      (profile.now-ms))))

(cfg
  compile-profile
  (define (compiler-backend-profile-detail-finish
    [state : profile_state.CompilerProfileState]
    [phase : String]
    [name : String]) : unit
    (let
      [elapsed : i64
        (-
          (profile.now-ms)
          (profile_state.compiler-profile-state-metric-value
            state
            compiler-backend-profile-detail-start-ms-metric))]
      (cfg
        compile-profile-summary
        (if (string.eq phase "function")
          (begin
            (cps.compiler-profile-summary-note!
              state
              cps.compiler-profile-summary-backend-function
              name
              elapsed)
            (cps.compiler-profile-summary-note-module!
              state
              cps.compiler-profile-summary-backend-module
              name
              elapsed))
          unit)
        (if (>= elapsed 1)
          (io.print-error
            (string.append
              "compile-profile-detail|backend."
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string elapsed)
                    (string.append "|" (string.append name "\n")))))))
          unit)))))

(cfg
  compile-profile
  (define (compiler-backend-profile-function-name [func : CompilerIrFunction]) : String
    (match func
      [(CompilerIrFunction.Function name _ _ _ _)
        (compiler-ir-symbol-text name)])))

(defenum ResultBackendReg
  (Ok String)
  (Err String))

(define (compiler-backend-result-reg [reg : String] [message : String]) : ResultBackendReg
  (if (string.eq reg "")
    (ResultBackendReg.Err message)
    (ResultBackendReg.Ok reg)))

(defenum ResultBackendValue
  (Ok CompilerIrValue)
  (Err String))

(defenum CompilerBackendVectorMemFold
  (No)
  (Some CompilerIrValue))

;; BackendPhiSourceTemp carries the location its saved value lives in while the
;; cycle is being broken: "" = the reserved frame temp slot, or a register name
;; (e.g. "%r10") when the outermost cycle break scavenged a free GP register
;; instead of staging on the stack. The single Temp consumer reads it back from
;; that location.
(defenum CompilerBackendPhiSource
  (Value CompilerIrValue)
  (Temp String))

(defenum CompilerBackendPhiCopy
  (Copy i64 CompilerBackendPhiSource AstType))

(defstruct CompilerBackendPhiCopySeq
  (slots (Array CompilerBackendPhiCopy))
  (len i64))

(define (compiler-backend-phi-copy-seq-with-capacity [capacity : i64]) : CompilerBackendPhiCopySeq
  (CompilerBackendPhiCopySeq
    (array.make-array CompilerBackendPhiCopy capacity)
    0))

(define (compiler-backend-phi-copy-copy-range!
  [dst : (&mut dst (Array CompilerBackendPhiCopy))]
  [src : (& src (Array CompilerBackendPhiCopy))]
  [count : i64]) : unit
  (let
    [index : i64 0]
    (while (< index count)
      (begin
        (array-set! dst index (array-ref src index))
        (set! index (+ index 1))))))

(define (compiler-backend-phi-copy-push!
  [seq : (&mut seq CompilerBackendPhiCopySeq)]
  [copy : CompilerBackendPhiCopy]) : unit
  (begin
    (if (< (struct-get seq len) (array-length (struct-get seq slots)))
      unit
      (let
        [bigger : (Array CompilerBackendPhiCopy)
          (array.make-array
            CompilerBackendPhiCopy
            (compiler-backend-seq-capacity
              (array-length (struct-get seq slots))))]
        (begin
          (compiler-backend-phi-copy-copy-range!
            (&mut bigger)
            (& (struct-get seq slots))
            (struct-get seq len))
          (set! (struct-get seq slots) bigger))))
    (let
      [index : i64 (struct-get seq len)]
      (begin
        (array-set! (struct-get seq slots) index copy)
        (set! (struct-get seq len) (+ index 1))))))

;; The object path stages an edge's copies in REVERSE instruction order (the old
;; cons scan prepended); this keeps that visit order byte-identical.
(defmacro (compiler-backend-phi-copy-seq-rev-ref
  [copies : CompilerBackendPhiCopySeq]
  [index : i64]) : CompilerBackendPhiCopy
  `(array-ref
    (struct-get ,copies slots)
    (- (- (struct-get ,copies len) 1) ,index)))

(defenum CompilerBackendMaybePhiCopy
  (No)
  (Some CompilerBackendPhiCopy))

(defenum ResultBackendPhiCopies
  (Ok CompilerBackendPhiCopySeq)
  (Err String))

(defenum CompilerBackendPhiReturnMatch
  (No)
  (Some CompilerIrValue))

(defenum ResultBackendPhiReturnMatch
  (Ok CompilerBackendPhiReturnMatch)
  (Err String))

(defenum CompilerBackendMaybeImmediate
  (No)
  (Some String))

(defenum CompilerBackendMaybeAsm
  (No)
  (Some String))

(defenum CompilerBackendMaybeStackOperand
  (No)
  (Some String))

(defenum CompilerBackendVectorUse
  (Use String String))

(defenum ResultBackendVectorUse
  (Ok CompilerBackendVectorUse)
  (Err String))

(defstruct CompilerBackendGatherAdjust
  (first String)
  (second String))

(defenum ResultBackendGatherAdjust
  (Ok CompilerBackendGatherAdjust)
  (Err (Box CompilerDiagnostic)))

(defenum CompilerBackendMaskUse
  (Use String String))

(defenum ResultBackendMaskUse
  (Ok CompilerBackendMaskUse)
  (Err String))

(defenum CompilerBackendPeepholeMove
  (NoMove)
  (Move String String))

;; Structured identity for memory locations the peephole owner map may track.
;; 0 is Unknown, positive keys are packed stack-slot identities
;; (%rbp/%rsp + displacement + explicit-displacement bit), and negative keys are
;; interned SYM(%rip) global symbols. Unknown never aliases a real location.
(define compiler-backend-peephole-owner-key-stack-bias : i64
  1073741824)

;; Per-register reload-elision owner map: for each general-purpose register
;; tracked by the register allocator, the parsed stack-slot/global key that the
;; register currently mirrors (loaded from and not yet clobbered), or Unknown if
;; the register's contents are unknown / not a known trackable memory location.
;; Used by the reload-elision peephole to drop redundant `movq <slot>, <reg>`
;; reloads for every register (not just %rax). %rbp and %rsp are intentionally
;; NOT tracked (frame/stack pointers); writing either invalidates the whole map.
(defstruct CompilerBackendPeepholeOwners
  (rax i64)
  (rcx i64)
  (rdx i64)
  (rbx i64)
  (rsi i64)
  (rdi i64)
  (r8 i64)
  (r9 i64)
  (r10 i64)
  (r11 i64)
  (r12 i64)
  (r13 i64)
  (r14 i64)
  (r15 i64))

;; Transient per-line descriptor for the streaming peephole. Every pair-rule
;; transfer copies this struct, and one is built for every assembly line, so it
;; stores only what the rules read and packs the small members into shared
;; words. The derived spellings are the `-desc-` accessors beside `parse-line`.
;;  * `span`      start in the low 32 bits, end in the high 32. Group texts are
;;                orders of magnitude below 2^31 bytes and both halves stay
;;                non-negative, so the shifts never touch the sign bit.
;;  * `mnemonic`  mnemonic start in the low 32 bits, its length in the high 32.
;;  * `flags`     the ten line predicates, one bit each.
;;  * `op-src-start` / `op-src-end` / `op-dst-start` the operand split. Only
;;                movq/zext lines split (the `has-operands` flag); the
;;                destination always runs to the line end, so it needs no field.
;;  * `op-flags`  source operand flags in bits 0..3, destination in bits 4..7.
;;  * `regs`      source / destination / last-operand register indices, biased
;;                by one so the -1 "none" sentinel packs, one byte each.
(defstruct CompilerBackendPeepholeLine
  (src String)
  (data (Ptr u8))
  (span i64)
  (mnemonic i64)
  (flags i64)
  (op-src-start i64)
  (op-src-end i64)
  (op-dst-start i64)
  (op-src-key i64)
  (op-dst-key i64)
  (op-flags i64)
  (regs i64))

;; Per-line GAP5 extraction result. Every offset is the RAW in-text frame
;; displacement (delta 0); the sweep subtracts its running rsp delta.
(defstruct CompilerBackendPeepholeLineSweepSummary
  (kind i64)
  (flags i64)
  (cand i64)
  (epilogue i64)
  (rsp-imm i64)
  (mem-count i64)
  (mem-off i64)
  (width i64))

;; One emitted line, compacted to 56 bytes for the dense array below. The fat
;; CompilerBackendPeepholeLine stays the TRANSIENT streaming descriptor; this is
;; what survives the emit step, carrying exactly what the three post-push
;; consumers read (sweep driver, sweep region, final render) and nothing else.
;;  * `src`    the owned synthesized text, or the group asm for borrowed lines.
;;             Uniform so `data` is always (string-data src) and never stored.
;;  * `span`   start | end << 32 (a group string is far below 2^31 bytes).
;;  * `meta`   kind / sweep flags / newline / owned / `.globl` / access width /
;;             memory-reference count -- see the accessors beside the builder.
;;  * `cand`     raw `movq SRC, N(%rsp)` offset, or the no-candidate sentinel.
;;  * `epilogue` raw `leaq N(%rsp), %rsp` offset, or the no-candidate sentinel.
;;  * `value`  the tracked rsp `$imm` when the line is a tracked rsp write, else
;;             the first `(%rsp)` displacement. The two are mutually exclusive:
;;             a tracked write has `$` immediately after its mnemonic, so it has
;;             no memory operand at all.
(defstruct CompilerBackendPeepholeLineRecord
  (src String)
  (span i64)
  (meta i64)
  (cand i64)
  (epilogue i64)
  (value i64))

;; Dense arena-backed line-record array produced by the streaming peephole and
;; consumed by the dead-store sweep and the single final render. `live` is the
;; parallel deletion mask (1 = emit, 0 = swept); marking is O(1), the arrays are
;; never rebuilt, and deadness stays OUT of the packed word because array-set!
;; rewrites a whole element.
(defstruct CompilerBackendPeepholeLineVec
  (lines (Array CompilerBackendPeepholeLineRecord))
  (live (Array i64))
  (len i64))

(defstruct CompilerBackendPeepholeEmitRecordResult
  (lines CompilerBackendPeepholeLineVec)
  (owners CompilerBackendPeepholeOwners))

;; The physical chunks the streaming peephole parses in place, in emission
;; order, plus their combined byte count. A group chunk is one whole emitted
;; function/adapter text and is newline terminated, so an assembly line never
;; spans two chunks and each record can reference its own chunk as `src`.
;; `chunks-normalize` restores that invariant for any caller that appends a
;; partial line, so the walk itself never has to join across a boundary.
(defstruct CompilerBackendPeepholeChunkArray
  (items (Array String))
  (count i64)
  (total i64))

;; One raw-assembly group plus already-optimized output chunks. A group ends at
;; a function-level `.globl` chunk, where peephole owner state is
;; conservatively reset by the legacy pass anyway.
(defstruct CompilerBackendPeepholeChunkState
  (out text_buf.TextBuf)
  (group text_buf.TextBuf))

;; State carried while sweeping chunked peephole output. Metadata is recorded
;; in function emission order, so the next entry is the only candidate to
;; match in each following assembly group.
(defstruct CompilerBackendPeepholeSweepChunkState
  (out text_buf.TextBuf)
  (group text_buf.TextBuf)
  (sweep-cursor i64))

;; Final-buffer emission uses these scoped stream fields only while the final
;; backend wrapper is active. Primitive inactive defaults avoid relying on a
;; module-global heap value before compiler global initialization runs.
(define compiler-backend-assembly-stream-active : bool
  false)
(define compiler-backend-assembly-stream-raw-arena : arena.Arena
  (arena.Arena 0))
(define compiler-backend-assembly-stream-raw-mark : arena.ArenaMark
  (arena.ArenaMark 0))
(define compiler-backend-assembly-stream-peephole-arena : arena.Arena
  (arena.Arena 0))
(define compiler-backend-assembly-stream-peephole-mark : arena.ArenaMark
  (arena.ArenaMark 0))
(define compiler-backend-assembly-stream-home-arena : arena.Arena
  (arena.Arena 0))
(define compiler-backend-assembly-stream-out : text_buf.TextBuf
  (text_buf.empty))
(define compiler-backend-assembly-stream-sweep-cursor : i64
  0)
(define compiler-backend-assembly-stream-batch : text_buf.TextBuf
  (text_buf.empty))
(define compiler-backend-assembly-stream-batch-count : i64
  0)
(define compiler-backend-assembly-stream-raw-ready : bool
  false)
(define compiler-backend-assembly-stream-batch-function-limit : i64
  64)

(define (compiler-backend-assembly-stream-home-arena-handle-value) : i64
  (arena.raw-handle compiler-backend-assembly-stream-home-arena))

(defenum CompilerBackendUnsignedDivMagic
  (No)
  (RoundUp u64 i64)
  (RoundDown u64 i64))

(defenum CompilerBackendMaybeLabel
  (No)
  (Some i64))

(defenum CompilerBackendMaybeSignature
  (No)
  (Some AstTypeList AstType))

(defenum CompilerBackendGlobalTypeList
  (Nil)
  (Cons i64 AstType (Box CompilerBackendGlobalTypeList))
  (Cache backend_i64_i64_map.Map (Array AstType)))

(defenum ResultCompilerBackend
  (Ok String)
  (Err (Box CompilerDiagnostic)))

;; Append-only function-body assembly text buffer.
;;
;; Block and instruction emission used to materialise a fresh String for every
;; assembly line (one str-cat of the mnemonic/operand parts) and hang it off a
;; TextBuf chunk node, so each part was copied into a throwaway line allocation
;; and then copied again by every render/splice on the way to the function body.
;; The block/instruction spine now appends emitted text straight into this
;; growth buffer and finishes ONCE to the body String the rest of the pipeline
;; already consumes: rsp-rebase-full, the prologue splice and the peephole/group
;; stage see exactly the same bytes, and the group-chunk invariant (one whole
;; newline-terminated function text per chunk) is unchanged.
;;
;; Only the prefix [0, len) is live. `finish` hands the live prefix out as a
;; String that ALIASES this storage, so a finished buffer is never appended to
;; or reused -- emission allocates a fresh one per body it builds.
;;
;; Storage comes straight from the active-arena allocator the String
;; constructors already use (`tl_alloc`, exactly what `string.concat*` calls),
;; not from `make-array`: an assembly buffer is fully overwritten by the
;; appends, so the element zero-fill `make-array` emits would be pure waste,
;; and the raw allocation lets `finish` publish the live prefix with no copy.
(defstruct CompilerBackendAsmBuf
  (data (MutPtr u8))
  (cap i64)
  (len i64))

(define (compiler-backend-asm-buf-with-capacity [capacity : i64]) : CompilerBackendAsmBuf
  (let
    [cap : i64
      (if (< capacity 16)
        16
        capacity)]
    (CompilerBackendAsmBuf
      (unsafe
        (compiler-backend-asm-buf-alloc cap))
      cap
      0)))

;; Bytes of assembly text budgeted per IR instruction when sizing a function
;; body buffer. Chosen so the overwhelming majority of functions never grow
;; while no function reserves much more than it writes (a fixed default would
;; either re-copy the large bodies or over-reserve for the many tiny ones).
(define compiler-backend-asm-bytes-per-instr : i64
  64)

;; Capacity for a one-line buffer (`    movq -1234(%rbp), %r11\n` and friends)
;; and for a short instruction sequence, so the common case never grows.
(define compiler-backend-asm-line-capacity : i64
  64)
(define compiler-backend-asm-seq-capacity : i64
  256)

(define (compiler-backend-asm-buf-grow!
  [buf : (&mut buf CompilerBackendAsmBuf)]
  [needed : i64]) : unit
  (let
    [doubled : i64 (* (struct-get buf cap) 2)]
    [capacity : i64
      (if (< doubled needed)
        needed
        doubled)]
    [bigger : (MutPtr u8)
      (unsafe
        (compiler-backend-asm-buf-alloc capacity))]
    (begin
      (string.str-copy-bytes-into
        (unsafe
          (ptr-cast (struct-get buf data) : (Ptr u8)))
        bigger
        0
        (struct-get buf len))
      (set! (struct-get buf data) bigger)
      (set! (struct-get buf cap) capacity))))

(define (compiler-backend-asm-buf-reserve!
  [buf : (&mut buf CompilerBackendAsmBuf)]
  [total : i64]) : unit
  (if (> total (struct-get buf cap))
    (compiler-backend-asm-buf-grow! buf total)
    unit))

;; Copy `n` bytes of `src` into `dst` at byte offset `off`, INLINE.
;;
;; This is the whole point of the builder: an operand part must reach the buffer
;; through one move loop, not through two call frames. `stdlib.string`'s
;; `str-copy-owned-bytes-into` does the identical word-then-tail copy, but as an
;; out-of-line call it costs about as much per part as the copy itself -- which
;; is exactly the cost `str-cat` was paying. Every macro argument is used more
;; than once, so callers pass plain locals.
(defmacro (compiler-backend-asm-copy-part!
  [dst : (MutPtr u8)]
  [off : i64]
  [src : String]
  [n : i64]) : unit
  `(let
    [asm-copy-src : (Ptr u8)
      (unsafe
        (string-data (& ,src)))]
    [asm-copy-words : i64 (/ ,n 8)]
    [asm-copy-src64 : (Ptr i64)
      (unsafe
        (ptr-cast asm-copy-src : (Ptr i64)))]
    [asm-copy-dst64 : (MutPtr i64)
      (unsafe
        (ptr-cast (ptr-offset ,dst ,off) : (MutPtr i64)))]
    [asm-copy-w : i64 0]
    [asm-copy-b : i64 (* asm-copy-words 8)]
    (begin
      (while (< asm-copy-w asm-copy-words)
        (begin
          (unsafe
            (ptr-write!
              (ptr-offset asm-copy-dst64 asm-copy-w)
              (ptr-read (ptr-offset asm-copy-src64 asm-copy-w))))
          (set! asm-copy-w (+ asm-copy-w 1))))
      (while (< asm-copy-b ,n)
        (begin
          (unsafe
            (ptr-write!
              (ptr-offset ,dst (+ ,off asm-copy-b))
              (ptr-read (ptr-offset asm-copy-src asm-copy-b))))
          (set! asm-copy-b (+ asm-copy-b 1))))
      unit)))

;; Copy `n` bytes of `part` to offset `off`; the caller has already reserved.
;; Out-of-line form for the cold splice path.
(define (compiler-backend-asm-buf-put!
  [buf : (&mut buf CompilerBackendAsmBuf)]
  [off : i64]
  [part : String]
  [n : i64]) : unit
  (if (= n 0)
    unit
    (string.str-copy-owned-bytes-into part (struct-get buf data) off n)))

(define (compiler-backend-asm-append
  [buf : (&mut buf CompilerBackendAsmBuf)]
  [part : String]) : unit
  (let
    [n : i64 (string-length part)]
    (if (= n 0)
      unit
      (let
        [off : i64 (struct-get buf len)]
        (begin
          (compiler-backend-asm-buf-reserve! buf (+ off n))
          (let
            [dst : (MutPtr u8) (struct-get buf data)]
            (compiler-backend-asm-copy-part! dst off part n))
          (set! (struct-get buf len) (+ off n)))))))

(define (compiler-backend-asm-append2
  [buf : (&mut buf CompilerBackendAsmBuf)]
  [a : String]
  [b : String]) : unit
  (let
    [na : i64 (string-length a)]
    [nb : i64 (string-length b)]
    [total : i64 (+ na nb)]
    [off : i64 (struct-get buf len)]
    (begin
      (compiler-backend-asm-buf-reserve! buf (+ off total))
      (let
        [dst : (MutPtr u8) (struct-get buf data)]
        [ob : i64 (+ off na)]
        (begin
          (compiler-backend-asm-copy-part! dst off a na)
          (compiler-backend-asm-copy-part! dst ob b nb)))
      (set! (struct-get buf len) (+ off total)))))

(define (compiler-backend-asm-append3
  [buf : (&mut buf CompilerBackendAsmBuf)]
  [a : String]
  [b : String]
  [c : String]) : unit
  (let
    [na : i64 (string-length a)]
    [nb : i64 (string-length b)]
    [nc : i64 (string-length c)]
    [total : i64 (+ na (+ nb nc))]
    [off : i64 (struct-get buf len)]
    (begin
      (compiler-backend-asm-buf-reserve! buf (+ off total))
      (let
        [dst : (MutPtr u8) (struct-get buf data)]
        [ob : i64 (+ off na)]
        [oc : i64 (+ ob nb)]
        (begin
          (compiler-backend-asm-copy-part! dst off a na)
          (compiler-backend-asm-copy-part! dst ob b nb)
          (compiler-backend-asm-copy-part! dst oc c nc)))
      (set! (struct-get buf len) (+ off total)))))

(define (compiler-backend-asm-append4
  [buf : (&mut buf CompilerBackendAsmBuf)]
  [a : String]
  [b : String]
  [c : String]
  [d : String]) : unit
  (let
    [na : i64 (string-length a)]
    [nb : i64 (string-length b)]
    [nc : i64 (string-length c)]
    [nd : i64 (string-length d)]
    [total : i64 (+ na (+ nb (+ nc nd)))]
    [off : i64 (struct-get buf len)]
    (begin
      (compiler-backend-asm-buf-reserve! buf (+ off total))
      (let
        [dst : (MutPtr u8) (struct-get buf data)]
        [ob : i64 (+ off na)]
        [oc : i64 (+ ob nb)]
        [od : i64 (+ oc nc)]
        (begin
          (compiler-backend-asm-copy-part! dst off a na)
          (compiler-backend-asm-copy-part! dst ob b nb)
          (compiler-backend-asm-copy-part! dst oc c nc)
          (compiler-backend-asm-copy-part! dst od d nd)))
      (set! (struct-get buf len) (+ off total)))))

(define (compiler-backend-asm-append5
  [buf : (&mut buf CompilerBackendAsmBuf)]
  [a : String]
  [b : String]
  [c : String]
  [d : String]
  [e : String]) : unit
  (let
    [na : i64 (string-length a)]
    [nb : i64 (string-length b)]
    [nc : i64 (string-length c)]
    [nd : i64 (string-length d)]
    [ne : i64 (string-length e)]
    [total : i64 (+ na (+ nb (+ nc (+ nd ne))))]
    [off : i64 (struct-get buf len)]
    (begin
      (compiler-backend-asm-buf-reserve! buf (+ off total))
      (let
        [dst : (MutPtr u8) (struct-get buf data)]
        [ob : i64 (+ off na)]
        [oc : i64 (+ ob nb)]
        [od : i64 (+ oc nc)]
        [oe : i64 (+ od nd)]
        (begin
          (compiler-backend-asm-copy-part! dst off a na)
          (compiler-backend-asm-copy-part! dst ob b nb)
          (compiler-backend-asm-copy-part! dst oc c nc)
          (compiler-backend-asm-copy-part! dst od d nd)
          (compiler-backend-asm-copy-part! dst oe e ne)))
      (set! (struct-get buf len) (+ off total)))))

(define (compiler-backend-asm-buf-len [buf : (& buf CompilerBackendAsmBuf)]) : i64
  (struct-get buf len))

;; Splice `part` in at offset `at`, shifting the live tail right. Only the rare
;; emergency-spill wrap (a save that has to land in FRONT of text already
;; emitted) needs this; every other write into the body buffer is a pure
;; append.
(define (compiler-backend-asm-buf-insert-at!
  [buf : (&mut buf CompilerBackendAsmBuf)]
  [at : i64]
  [part : String]) : unit
  (let
    [n : i64 (string-length part)]
    (if (= n 0)
      unit
      (let
        [len : i64 (struct-get buf len)]
        [tail : i64 (- len at)]
        (begin
          (compiler-backend-asm-buf-reserve! buf (+ len n))
          (let
            [dst : (MutPtr u8) (struct-get buf data)]
            [src : (Ptr u8)
              (unsafe
                (ptr-cast (struct-get buf data) : (Ptr u8)))]
            [i : i64 (- tail 1)]
            (begin
              (while (>= i 0)
                (begin
                  (unsafe
                    (ptr-write!
                      (ptr-offset dst (+ at (+ n i)))
                      (ptr-read (ptr-offset src (+ at i)))))
                  (set! i (- i 1))))
              unit))
          (compiler-backend-asm-buf-put! buf at part n)
          (set! (struct-get buf len) (+ len n)))))))

;; Hand the live prefix out as a String aliasing this buffer's storage. The
;; buffer is dead after this call.
(define (compiler-backend-asm-buf-finish [buf : (& buf CompilerBackendAsmBuf)]) : String
  (let
    [n : i64 (struct-get buf len)]
    (if (= n 0)
      ""
      (unsafe
        (string-from-bytes (ptr-cast (struct-get buf data) : (Ptr u8)) n)))))

(defenum ResultCompilerBackendObject
  (Ok cobj.CompilerObjectImage)
  (Err (Box CompilerDiagnostic)))

(defenum CompilerBackendSwitchValidation
  (Ok)
  (Err String))

(defstruct CompilerBackendPicOutput
  (asm String)
  (fixups String))

(defstruct CompilerBackendAddressBase
  (asm String)
  (reg String))

(defenum ResultCompilerBackendAddressBase
  (Ok CompilerBackendAddressBase)
  (Err (Box CompilerDiagnostic)))

(defstruct CompilerBackendSimdIndexedAddress
  (asm String)
  (addr String))

(defenum ResultCompilerBackendSimdIndexedAddress
  (Ok CompilerBackendSimdIndexedAddress)
  (Err (Box CompilerDiagnostic)))

(defstruct CompilerBackendU64DivPow2
  (quot u64)
  (rem u64)
  (overflow bool))

(defstruct CompilerBackendSignedDivMagic
  (magic u64)
  (shift i64))

(defenum ResultCompilerBackendPic
  (Ok CompilerBackendPicOutput)
  (Err (Box CompilerDiagnostic)))

(defstruct CompilerBackendRuntimeTailPlan
  (profile bool)
  (tlci-macro-entry bool)
  (arena-debug bool)
  (startup-profile bool))

(defenum CompilerBackendRuntimeHelperOwner
  (Unknown)
  (Core)
  (StdlibFfi)
  (StdlibTypeLisp))

(defenum ResultCompilerBackendBuffer
  (Ok text_buf.TextBuf)
  (Err (Box CompilerDiagnostic)))

(defenum ResultCompilerBackendSymbolValidation
  (Ok backend_string_i64_map.Map)
  (Err (Box CompilerDiagnostic)))

(defenum CompilerBackendRuntimePlan
  (Plan bool bool bool bool bool bool bool CompilerBackendRuntimeTailPlan)
  ;; Per-function code-generation view.  Reuse the runtime plan already threaded
  ;; through every emitter instead of installing scratch state in process globals.
  (WithScratch (Box CompilerBackendRuntimePlan) CompilerRegScratchPlan))

(defstruct CompilerBackendRuntimeIndex
  (defines backend_i64_i64_map.Map)
  (externs backend_i64_i64_map.Map)
  (calls backend_i64_i64_map.Map)
  (tlci-macro-entry-call-id i64)
  (startup-profile bool))

(defstruct CompilerBackendRuntimePlanWithIndex
  (plan CompilerBackendRuntimePlan)
  (index CompilerBackendRuntimeIndex))

(defstruct CompilerBackendProgramIndex
  (functions backend_i64_i64_map.Map)
  (function-names (Array String))
  (function-signatures (Array CompilerBackendMaybeSignature))
  (extern-signatures backend_i64_i64_map.Map)
  (extern-names (Array String))
  (extern-signature-values (Array CompilerBackendMaybeSignature))
  ;; Extern call classification, packed by extern slot: bit 0 is C ABI,
  ;; bit 1 has aggregate parameters, and the remaining bits encode the
  ;; C-varargs fixed-parameter count plus one. The reference index maps both
  ;; source names and link symbols to this same slot.
  (extern-call-infos (Array i64))
  (extern-references backend_i64_i64_map.Map)
  (extern-link-references backend_i64_i64_map.Map)
  (extern-link-symbols (Array i64))
  (extern-provided (Array bool))
  ;; Aggregate type name -> machine-word count, for every register-group
  ;; type constructed anywhere in the program (whole-program compile). Drives the
  ;; backend/regalloc 2-word-vs-handle decision that the type name alone cannot.
  (group-word-counts backend_string_i64_map.Map)
  ;; Aggregate type name -> bit mask of SSE-class words. Bit 0 marks
  ;; word0, bit 1 marks word1. A missing/zero mask means all INTEGER words.
  (group-word-class-masks backend_string_i64_map.Map)
  ;; Explicit type-reader handle for this backend job. It is snapshotted from
  ;; the job's pools once and then travels with the already-ubiquitous index.
  (type-segment-bases i64)
  ;; Profile hooks share this job-owned handle instead of selecting a global
  ;; timing/summary table.
  (profile-state profile_state.CompilerProfileState))

(defenum CompilerBackendDebugFileIndex
  (No)
  (Files (Array i64) (Array i64) i64))

(defstruct CompilerBackendSourceSpanIndex
  (entries backend_i64_i64_map.Map)
  (values (Array CompilerMaybeSourceSpan))
  (debug-files CompilerBackendDebugFileIndex))

(define (compiler-backend-debug-file-add!
  [numbers : (Array i64)]
  [paths : (Array i64)]
  [count : i64]
  [path-id : i64]) : i64
  (if (or
    (<= path-id 0)
    (>= path-id (array-length numbers))
    (> (array-ref numbers path-id) 0))
    count
    (begin
      (array-set! numbers path-id (+ count 1))
      (array-set! paths count path-id)
      (+ count 1))))

(define (compiler-backend-debug-files-from-function-entries
  [entries : CompilerSourceSpansEntryList]
  [index : i64]
  [numbers : (Array i64)]
  [paths : (Array i64)]
  [count : i64]) : i64
  (if (>= index (struct-get entries len))
    count
    (match (array-ref (struct-get entries slots) index)
      [(CompilerSourceSpansEntry.Entry _ path-id _)
        (compiler-backend-debug-files-from-function-entries
          entries
          (+ index 1)
          numbers
          paths
          (compiler-backend-debug-file-add! numbers paths count path-id))])))

(define (compiler-backend-debug-files-from-instr-entries
  [entries : CompilerSourceSpansInstrEntryList]
  [index : i64]
  [numbers : (Array i64)]
  [paths : (Array i64)]
  [count : i64]) : i64
  (if (>= index (struct-get entries len))
    count
    (match (array-ref (struct-get entries slots) index)
      [(CompilerSourceSpansInstrEntry.Entry _ path-id _)
        (compiler-backend-debug-files-from-instr-entries
          entries
          (+ index 1)
          numbers
          paths
          (compiler-backend-debug-file-add! numbers paths count path-id))])))

(define (compiler-backend-debug-file-index-build [spans : CompilerSourceSpans]) : CompilerBackendDebugFileIndex
  (if (compiler-debug-info-enabled?)
    (match spans
      [(CompilerSourceSpans.Spans entries instr-entries _)
        (let
          [capacity : i64
            (+ (struct-get entries len) (struct-get instr-entries len))]
          [numbers : (Array i64) (array.make-array i64 (ci.intern-capacity))]
          [paths : (Array i64) (array.make-array i64 capacity)]
          [function-count : i64
            (compiler-backend-debug-files-from-function-entries
              entries
              0
              numbers
              paths
              0)]
          [count : i64
            (compiler-backend-debug-files-from-instr-entries
              instr-entries
              0
              numbers
              paths
              function-count)]
          (CompilerBackendDebugFileIndex.Files numbers paths count))])
    (CompilerBackendDebugFileIndex.No)))

(define (compiler-backend-debug-file-number
  [index : CompilerBackendSourceSpanIndex]
  [path-id : i64]) : i64
  (match (struct-get index debug-files)
    [(CompilerBackendDebugFileIndex.No) 0]
    [(CompilerBackendDebugFileIndex.Files numbers _ _)
      (if (or (<= path-id 0) (>= path-id (array-length numbers)))
        0
        (array-ref numbers path-id))]))

(define (compiler-backend-runtime-tail-profile?
  [tail : CompilerBackendRuntimeTailPlan]) : bool
  (struct-get tail profile))

(define (compiler-backend-runtime-tail-tlci-macro-entry?
  [tail : CompilerBackendRuntimeTailPlan]) : bool
  (struct-get tail tlci-macro-entry))

(define (compiler-backend-runtime-tail-arena-debug?
  [tail : CompilerBackendRuntimeTailPlan]) : bool
  (struct-get tail arena-debug))

(define (compiler-backend-runtime-tail-startup-profile?
  [tail : CompilerBackendRuntimeTailPlan]) : bool
  (struct-get tail startup-profile))

(define (compiler-backend-runtime-plan-tail [plan : CompilerBackendRuntimePlan]) : CompilerBackendRuntimeTailPlan
  (match plan
    [(CompilerBackendRuntimePlan.WithScratch base _)
      (compiler-backend-runtime-plan-tail (box-get base))]
    [(CompilerBackendRuntimePlan.Plan _ _ _ _ _ _ _ tail) tail]))

(define compiler-backend-empty-scratch-plan : CompilerRegScratchPlan
  (compiler-reg-scratch-plan-empty))

(define (compiler-backend-runtime-plan-scratch
  [plan : CompilerBackendRuntimePlan]) : CompilerRegScratchPlan
  (match plan
    [(CompilerBackendRuntimePlan.WithScratch _ scratch) scratch]
    [(CompilerBackendRuntimePlan.Plan _ _ _ _ _ _ _ _)
      compiler-backend-empty-scratch-plan]))

;; Backend code-generation target. Linux/System V and Windows x64 are
;; both modeled here; target-specific runtime helpers are emitted below.
(defenum CompilerBackendTarget
  (Linux)
  (Windows))

(define (compiler-backend-target-abi [target : CompilerBackendTarget]) : CompilerRegTargetAbi
  (match target
    [(CompilerBackendTarget.Linux) CompilerRegTargetAbi.Linux]
    [(CompilerBackendTarget.Windows) CompilerRegTargetAbi.Windows]))

(define (compiler-backend-regalloc-abi [target : CompilerBackendTarget]) : CompilerRegTargetAbi
  (compiler-backend-target-abi target))

(defenum CompilerBackendMode
  (Scalar)
  (Avx2)
  (Avx512))

(define (compiler-backend-mode-scalar? [mode : CompilerBackendMode]) : bool
  (match mode
    [(CompilerBackendMode.Scalar) true]
    [_ false]))

(define (compiler-backend-mode-avx2? [mode : CompilerBackendMode]) : bool
  (match mode
    [(CompilerBackendMode.Avx2) true]
    [_ false]))

(define compiler-backend-current-mode : CompilerBackendMode
  (CompilerBackendMode.Scalar))

(define (compiler-backend-set-current-mode! [mode : CompilerBackendMode]) : unit
  (set! compiler-backend-current-mode mode))

(define (compiler-backend-current-mode-avx2?) : bool
  (compiler-backend-mode-avx2? compiler-backend-current-mode))

;; Whether scalar functions get full register allocation (#perf). Register
;; allocation makes the EMITTED binary faster but its planning + register-aware
;; emission cost more compile time than it saves on a single self-compile, so it
;; is reserved for opt level 2 Ã¢â‚¬â€ the high-quality path whose extra cost the
;; benchmark's 2x budget accommodates. opt levels 0-2 stay on the cheap
;; stack-only homing. The driver sets this from the opt level before emitting;
;; it is set deterministically per compile so a given opt level always produces
;; identical assembly (the stage2==stage3 fixpoint holds within each level). SIMD
;; (Avx2/Avx512) functions always use register allocation regardless.
(define compiler-backend-scalar-registers-enabled : bool
  false)

(define (compiler-backend-set-scalar-registers! [enabled : bool]) : unit
  (set! compiler-backend-scalar-registers-enabled enabled))

(define compiler-backend-current-fn-win64 : bool
  false)

(define (compiler-backend-set-current-fn-abi! [abi : CompilerRegTargetAbi]) : unit
  (set! compiler-backend-current-fn-win64 (compiler-abi-windows? abi)))

(define (compiler-backend-set-current-fn-linux!) : unit
  (set! compiler-backend-current-fn-win64 false))

(define (compiler-backend-set-current-fn-win64!) : unit
  (set! compiler-backend-current-fn-win64 true))

(define (compiler-backend-current-fn-win64?) : bool
  compiler-backend-current-fn-win64)

;; Per-emission cache for interned user-symbol mangling. Compat states may have
;; the same generation while assigning the same numeric id to different names,
;; so both the generation and pool identity guard cached values.
(define compiler-backend-user-symbol-cache-values : (Array String)
  (array.make-array String (ci.intern-capacity)))
(define compiler-backend-user-symbol-cache-epochs : (Array i64)
  (array.make-array i64 (ci.intern-capacity)))
(define compiler-backend-user-symbol-cache-epoch : i64
  1)
(define compiler-backend-user-symbol-cache-count-value : i64
  0)
(define compiler-backend-user-symbol-cache-generation : i64
  -1)
(define compiler-backend-user-symbol-cache-table-id : i64
  0)

(define (compiler-backend-user-symbol-cache-reset!) : unit
  (begin
    (set! compiler-backend-user-symbol-cache-count-value 0)
    (set!
      compiler-backend-user-symbol-cache-epoch
      (+ compiler-backend-user-symbol-cache-epoch 1))
    (set! compiler-backend-user-symbol-cache-generation (ci.intern-generation))
    (set!
      compiler-backend-user-symbol-cache-table-id
      (ci.intern-active-table-id))))

(define (compiler-backend-user-symbol-cache-ensure-current!) : unit
  (if (and
    (= compiler-backend-user-symbol-cache-generation (ci.intern-generation))
    (= compiler-backend-user-symbol-cache-table-id (ci.intern-active-table-id)))
    unit
    (compiler-backend-user-symbol-cache-reset!)))

(define (compiler-backend-user-symbol-cache-count) : i64
  compiler-backend-user-symbol-cache-count-value)

(define compiler-backend-addr-of-forwarding-enabled : bool
  false)
(define compiler-backend-addr-of-forwarding-src : (Array i64)
  (array.make-array i64 0))
(define compiler-backend-group-vars-enabled : bool
  false)
(define compiler-backend-group-vars : CompilerLiveI64Set
  (compiler-live-set-empty))
(define compiler-backend-addressable-group-vars : CompilerLiveI64Set
  (compiler-live-set-empty))
(define compiler-backend-current-slot-vars : i64
  0)
(define compiler-backend-shrinkwrap-bare-label : String
  "")
(define compiler-backend-current-block-label : i64
  -1)

;; Compare->branch fusion state. A comparison result may be fused to `cmp`/`jcc`
;; (never materialized as a boolean) when EVERY use of it is a branch fed by its
;; own adjacent compare. Equivalently: its total use count equals its count of
;; such "free branch" uses. This is strictly more permissive than a global
;; single-use gate: opt2 loop rotation duplicates a guard into an entry check
;; and a latch check that share one var id (two defs, two adjacent-branch uses),
;; which the single-use gate rejected even though each pair is locally fusable.
;;
;; To stay nearly free at compile time, this reuses the use-count array the
;; backend already computes (held by reference, not copied) and only adds a
;; cheap per-instruction scan that tallies free-branch uses.
(define compiler-backend-fuse-need-ready : bool
  false)
(define compiler-backend-fuse-use-counts : (Array i64)
  (array.make-array i64 0))
(define compiler-backend-fuse-free-counts : (Array i64)
  (array.make-array i64 0))

;; Stable state shared by one block's instruction-emission family. Keep
;; per-call control state (`fallthrough`, remaining instructions, RAX mode,
;; and the output buffer) explicit: those values change as fusion consumes the
;; stream. This context is the family-sized handoff that can become a field of
;; the per-job backend state tracked by #4963.
(defstruct CompilerBackendEmissionContext
  (type-segment-bases i64)
  (target CompilerBackendTarget)
  (function String)
  (source-function i64)
  (blocks CompilerIrBlockList)
  (current-label i64)
  (assignments CompilerRegAssignmentList)
  (vars i64)
  (types CompilerRegVarTypeList)
  (global-types CompilerBackendGlobalTypeList)
  (ret-ty AstType)
  (plan CompilerBackendRuntimePlan)
  (functions CompilerIrFunctionList)
  (externs CompilerIrExternList)
  (program-index CompilerBackendProgramIndex)
  (spans CompilerSourceSpans)
  (span-index CompilerBackendSourceSpanIndex)
  (func-diag CompilerDiagnostic)
  (use-counts (Array i64)))

(defenum CompilerBackendEmitInstrsMode
  (Normal)
  (Rax i64 AstType)
  (CallRax i64 AstType))

(define compiler-backend-emit-instrs-loop-active : bool
  false)
(define compiler-backend-emit-instrs-continue-pending : bool
  false)
(define compiler-backend-emit-instrs-next-mode : CompilerBackendEmitInstrsMode
  (CompilerBackendEmitInstrsMode.Normal))

(define (compiler-backend-empty-instr-list) : CompilerIrInstrList
  CompilerIrInstrList.Nil)

(define compiler-backend-emit-instrs-next-instrs : CompilerIrInstrList
  (compiler-backend-empty-instr-list))

;; The trampoline no longer carries a buffer across a continue step: the whole
;; block spine appends into ONE body buffer that the loop already holds, so the
;; only loop-carried emission state left is the mode and the remaining list.
(define (compiler-backend-emit-instrs-set-continue!
  [mode : CompilerBackendEmitInstrsMode]
  [instrs : CompilerIrInstrList]) : ResultCompilerBackend
  (begin
    (set! compiler-backend-emit-instrs-continue-pending true)
    (set! compiler-backend-emit-instrs-next-mode mode)
    (set! compiler-backend-emit-instrs-next-instrs instrs)
    (ResultCompilerBackend.Ok "")))

(defenum ResultBackendRuntimePlan
  (Ok CompilerBackendRuntimePlan)
  (Err String))

(defenum ResultBackendRuntimePlanWithIndex
  (Ok CompilerBackendRuntimePlanWithIndex)
  (Err String))

(defstruct BackendStringSeq
  (slots (Array String))
  (len i64))

(defstruct BackendSymbolSeq
  (slots (Array i64))
  (len i64))

(defenum BackendFloatList
  (Nil)
  (Cons AstType u64 (Box BackendFloatList)))

;; Capacity-doubling growth for the array-backed backend sequences (same shape as
;; compiler-ir-instr-builder-*): copy the live prefix into a doubled array.
(define (compiler-backend-seq-capacity [cap : i64]) : i64
  (if (< cap 1)
    4
    (* cap 2)))

(define (compiler-backend-string-copy-range!
  [dst : (&mut dst (Array String))]
  [src : (& src (Array String))]
  [count : i64]) : unit
  (let
    [index : i64 0]
    (while (< index count)
      (begin
        (array-set! dst index (array-ref src index))
        (set! index (+ index 1))))))

(define (compiler-backend-string-push!
  [seq : (&mut seq BackendStringSeq)]
  [head : String]) : unit
  (begin
    (if (< (struct-get seq len) (array-length (struct-get seq slots)))
      unit
      (let
        [bigger : (Array String)
          (array.make-array
            String
            (compiler-backend-seq-capacity
              (array-length (struct-get seq slots))))]
        (begin
          (compiler-backend-string-copy-range!
            (&mut bigger)
            (& (struct-get seq slots))
            (struct-get seq len))
          (set! (struct-get seq slots) bigger))))
    (let
      [index : i64 (struct-get seq len)]
      (begin
        (array-set! (struct-get seq slots) index head)
        (set! (struct-get seq len) (+ index 1))))))

(define (compiler-backend-symbol-copy-range!
  [dst : (&mut dst (Array i64))]
  [src : (& src (Array i64))]
  [count : i64]) : unit
  (let
    [index : i64 0]
    (while (< index count)
      (begin
        (array-set! dst index (array-ref src index))
        (set! index (+ index 1))))))

(define (compiler-backend-symbol-push!
  [seq : (&mut seq BackendSymbolSeq)]
  [head : i64]) : unit
  (begin
    (if (< (struct-get seq len) (array-length (struct-get seq slots)))
      unit
      (let
        [bigger : (Array i64)
          (array.make-array
            i64
            (compiler-backend-seq-capacity
              (array-length (struct-get seq slots))))]
        (begin
          (compiler-backend-symbol-copy-range!
            (&mut bigger)
            (& (struct-get seq slots))
            (struct-get seq len))
          (set! (struct-get seq slots) bigger))))
    (let
      [index : i64 (struct-get seq len)]
      (begin
        (array-set! (struct-get seq slots) index head)
        (set! (struct-get seq len) (+ index 1))))))

(define (compiler-backend-float-cons
  [ty : AstType]
  [bits : u64]
  [rest : BackendFloatList]) : BackendFloatList
  (BackendFloatList.Cons ty bits (box rest)))

(define (compiler-backend-empty-label-seq) : BackendSymbolSeq
  (BackendSymbolSeq (array.make-array i64 0) 0))

;; Phi targets are block labels, so they are a seq of interned ids rather than
;; of spellings (refs #5718). `compiler-backend-symbol-list-contains-id?` is an
;; i64 membership test -- `compiler-ir-symbol-id` is the identity -- so it serves
;; label ids unchanged.
(define compiler-backend-current-phi-targets : BackendSymbolSeq
  (compiler-backend-empty-label-seq))
(define compiler-backend-current-phi-target-count : i64
  0)
(define compiler-backend-identity-tail-forwarder-active : bool
  false)

;; CFG-aware cross-block reload-elision (carry-safe label set).
;; Holds the asm label strings (".L<scope>_<block>") of blocks across which the
;; peephole's reg->slot owner map may be CARRIED (instead of reset). A block
;; label is admitted ONLY when the block is reached exclusively by fall-through
;; from its single, layout-adjacent predecessor (see
;; compiler-backend-peephole-collect-carry-safe!). Populated per-function during
;; emission from the FINAL emitted blocks; reset (epoch bump) at the top of each
;; program emit. Read by the peephole. An empty set reproduces the old
;; reset-at-every-label behavior, so any not-proven-safe label stays sound.
;;
;; Backed ENTIRELY by pointer-free globals: an open-addressing table of byte
;; offsets/lengths (`(Array i64)`) into one flat `(Array u8)` key-byte arena.
;; Pointer-free Array globals are the only globals that reliably survive a full
;; program emission -- an `(Array String)`/string map/struct/box global has
;; its element/slots pointers dropped by the GC root scan and dangles mid-
;; peephole (observed SIGSEGV: contains? on a collected String cell). The intern
;; TABLE is likewise torn down before the peephole runs, so interning is NOT used
;; as the key: the bucket is `intern-hash` / `intern-hash-slice` (pure byte
;; hashes, no table) and membership is confirmed by an EXACT byte compare against
;; the arena, so a hash collision can never cause a wrong carry (it just probes
;; on) -- soundness does not rely on hash uniqueness. offset -1 = empty slot.
(define compiler-backend-peephole-carry-safe-capacity : i64
  262144)
(define compiler-backend-peephole-carry-safe-bytes-capacity : i64
  16777216)
(define compiler-backend-peephole-carry-safe-offsets : (Array i64)
  (array.make-array i64 262144))
(define compiler-backend-peephole-carry-safe-lengths : (Array i64)
  (array.make-array i64 262144))
(define compiler-backend-peephole-carry-safe-bytes : (Array u8)
  (array.make-array u8 16777216))
(define compiler-backend-peephole-carry-safe-bytes-count : i64
  0)

;; Clear the table: mark every slot empty (offset -1) and rewind the arena.
(define (compiler-backend-peephole-carry-safe-reset!) : unit
  (let
    [cap : i64 compiler-backend-peephole-carry-safe-capacity]
    [i : i64 0]
    (begin
      (while (< i cap)
        (begin
          (array-set! compiler-backend-peephole-carry-safe-offsets i -1)
          (set! i (+ i 1))))
      (set! compiler-backend-peephole-carry-safe-bytes-count 0)
      unit)))

;; True iff arena bytes [off,off+len) equal `klen` bytes read from `data` at
;; `kstart` (byte-exact key comparison).
(define (compiler-backend-peephole-carry-safe-bytes-eq?
  [off : i64]
  [len : i64]
  [data : (Ptr u8)]
  [kstart : i64]
  [klen : i64]) : bool
  (if (not (= len klen))
    false
    (let
      [j : i64 0]
      [ok : bool true]
      (begin
        (while (and ok (< j len))
          (begin
            (if (=
              (cast
                (array-ref compiler-backend-peephole-carry-safe-bytes (+ off j))
                : i64)
              (compiler-backend-peephole-byte-at data (+ kstart j)))
              unit
              (set! ok false))
            (set! j (+ j 1))))
        ok))))

;; Insert the key given by `klen` bytes at `data`+`kstart` with byte hash `hash`.
;; Reuses an empty (offset -1) slot; appends the key to the arena. A full table
;; or arena silently drops the key (sound: a missed carry-safe label only forgoes
;; one elision).
(define (compiler-backend-peephole-carry-safe-insert-bytes!
  [data : (Ptr u8)]
  [kstart : i64]
  [klen : i64]
  [hash : i64]) : unit
  (let
    [cap : i64 compiler-backend-peephole-carry-safe-capacity]
    [slot : i64 (bit-and hash (- cap 1))]
    [walked : i64 0]
    (begin
      (while (< walked cap)
        (let
          [off : i64
            (array-ref compiler-backend-peephole-carry-safe-offsets slot)]
          (if (< off 0)
            (let
              [start : i64 compiler-backend-peephole-carry-safe-bytes-count]
              (if (<=
                (+ start klen)
                compiler-backend-peephole-carry-safe-bytes-capacity)
                (let
                  [j : i64 0]
                  (begin
                    (while (< j klen)
                      (begin
                        (array-set!
                          compiler-backend-peephole-carry-safe-bytes
                          (+ start j)
                          (cast
                            (compiler-backend-peephole-byte-at
                              data
                              (+ kstart j))
                            : u8))
                        (set! j (+ j 1))))
                    (array-set!
                      compiler-backend-peephole-carry-safe-offsets
                      slot
                      start)
                    (array-set!
                      compiler-backend-peephole-carry-safe-lengths
                      slot
                      klen)
                    (set!
                      compiler-backend-peephole-carry-safe-bytes-count
                      (+ start klen))
                    (return unit)))
                (return unit)))
            (if (compiler-backend-peephole-carry-safe-bytes-eq?
              off
              (array-ref compiler-backend-peephole-carry-safe-lengths slot)
              data
              kstart
              klen)
              (return unit)
              (begin
                (set!
                  slot
                  (if (>= (+ slot 1) cap)
                    0
                    (+ slot 1)))
                (set! walked (+ walked 1)))))))
      unit)))

;; Insert a key String (used by the collector, which holds owned label Strings).
(define (compiler-backend-peephole-carry-safe-insert! [key : String]) : unit
  (compiler-backend-peephole-carry-safe-insert-bytes!
    (unsafe
      (string-data key))
    0
    (string.string-length key)
    (intern-hash key)))

;; True iff the key given by `klen` bytes at `data`+`kstart` (byte hash `hash`)
;; is in the set (exact byte match; an empty slot terminates the probe).
(define (compiler-backend-peephole-carry-safe-contains-bytes?
  [data : (Ptr u8)]
  [kstart : i64]
  [klen : i64]
  [hash : i64]) : bool
  (let
    [cap : i64 compiler-backend-peephole-carry-safe-capacity]
    [slot : i64 (bit-and hash (- cap 1))]
    [walked : i64 0]
    (begin
      (while (< walked cap)
        (let
          [off : i64
            (array-ref compiler-backend-peephole-carry-safe-offsets slot)]
          (if (< off 0)
            (return false)
            (if (compiler-backend-peephole-carry-safe-bytes-eq?
              off
              (array-ref compiler-backend-peephole-carry-safe-lengths slot)
              data
              kstart
              klen)
              (return true)
              (begin
                (set!
                  slot
                  (if (>= (+ slot 1) cap)
                    0
                    (+ slot 1)))
                (set! walked (+ walked 1)))))))
      false)))

(define (compiler-backend-string-list-contains?
  [items : BackendStringSeq]
  [needle : String]) : bool
  (let
    [i : i64 0]
    [n : i64 (struct-get items len)]
    (begin
      (while (< i n)
        (begin
          (when
            (string.eq (array-ref (struct-get items slots) i) needle)
            (return true))
          (set! i (+ i 1))))
      false)))

(define (compiler-backend-symbol-list-contains-id?
  [items : BackendSymbolSeq]
  [needle-id : i64]) : bool
  (let
    [i : i64 0]
    [n : i64 (struct-get items len)]
    (begin
      (while (< i n)
        (begin
          (when
            (=
              (compiler-ir-symbol-id (array-ref (struct-get items slots) i))
              needle-id)
            (return true))
          (set! i (+ i 1))))
      false)))

(defstruct BackendStringSet
  (seen backend_string_i64_map.Map)
  (items BackendStringSeq))

(defstruct BackendSymbolSet
  (seen backend_i64_i64_map.Map)
  (items BackendSymbolSeq))

(defstruct BackendFloatSet
  (seen backend_string_i64_map.Map)
  (items BackendFloatList))

(defstruct CompilerBackendProgramCollections
  (functions BackendSymbolSet)
  (strings BackendStringSet)
  (floats BackendFloatSet)
  (bytes BackendStringSet)
  (uses-avx2-i64-lane-id bool)
  (uses-avx512-i64-lane-id bool)
  (uses-f64-neg bool))

(defenum CompilerBackendCollectState
  (Collections CompilerBackendProgramCollections)
  (GroupCounts backend_string_i64_map.Map)
  (GroupClassMasks backend_string_i64_map.Map CompilerRegVarTypes))

(define (compiler-backend-string-set-new [capacity : i64]) : BackendStringSet
  (BackendStringSet
    (backend_string_i64_map.with-capacity capacity)
    (BackendStringSeq (array.make-array String 0) 0)))

(define (compiler-backend-symbol-set-new [capacity : i64]) : BackendSymbolSet
  (BackendSymbolSet
    (backend_i64_i64_map.with-capacity capacity)
    (BackendSymbolSeq (array.make-array i64 0) 0)))

(define (compiler-backend-float-payload-bits [ty : AstType] [bits : u64]) : u64
  (if (compiler-backend-f64-type? ty)
    bits
    (bit-and bits 0xffffffff)))

(define (compiler-backend-float-key [ty : AstType] [bits : u64]) : String
  (str_cat.str-cat
    (match ty
      [(AstType.F32) "f32"]
      [_ "f64"])
    ":"
    (string.int->string
      (cast (compiler-backend-float-payload-bits ty bits) : i64))))

(define (compiler-backend-float-set-new [capacity : i64]) : BackendFloatSet
  (BackendFloatSet
    (backend_string_i64_map.with-capacity capacity)
    BackendFloatList.Nil))

(define (compiler-backend-string-set-add
  [set : BackendStringSet]
  [text : String]) : BackendStringSet
  (let
    [seen : backend_string_i64_map.Map (struct-get set seen)]
    [items : BackendStringSeq (struct-get set items)]
    (if (backend_string_i64_map.contains? (& seen) text)
      set
      (begin
        (backend_string_i64_map.insert-ref! (&mut seen) text 1)
        (compiler-backend-string-push! (&mut items) text)
        (BackendStringSet seen items)))))

(define (compiler-backend-symbol-set-add
  [set : BackendSymbolSet]
  [symbol : i64]) : BackendSymbolSet
  (let
    [seen : backend_i64_i64_map.Map (struct-get set seen)]
    [id : i64 (compiler-ir-symbol-id symbol)]
    [items : BackendSymbolSeq (struct-get set items)]
    (if (backend_i64_i64_map.contains? (& seen) id)
      set
      (begin
        (backend_i64_i64_map.insert-ref! (&mut seen) id 1)
        (compiler-backend-symbol-push! (&mut items) symbol)
        (BackendSymbolSet seen items)))))

(define (compiler-backend-float-set-add
  [set : BackendFloatSet]
  [ty : AstType]
  [bits : u64]) : BackendFloatSet
  (let
    [payload-bits : u64 (compiler-backend-float-payload-bits ty bits)]
    [key : String (compiler-backend-float-key ty payload-bits)]
    [seen : backend_string_i64_map.Map (struct-get set seen)]
    (if (backend_string_i64_map.contains? (& seen) key)
      set
      (begin
        (backend_string_i64_map.insert-ref! (&mut seen) key 1)
        (BackendFloatSet
          seen
          (compiler-backend-float-cons ty payload-bits (struct-get set items)))))))

(define (compiler-backend-program-collections-new) : CompilerBackendProgramCollections
  (CompilerBackendProgramCollections
    (compiler-backend-symbol-set-new 256)
    (compiler-backend-string-set-new 256)
    (compiler-backend-float-set-new 256)
    (compiler-backend-string-set-new 64)
    false
    false
    false))

(define (compiler-backend-program-collections-add-function
  [collections : CompilerBackendProgramCollections]
  [name : i64]) : CompilerBackendProgramCollections
  (CompilerBackendProgramCollections
    (compiler-backend-symbol-set-add (struct-get collections functions) name)
    (struct-get collections strings)
    (struct-get collections floats)
    (struct-get collections bytes)
    (struct-get collections uses-avx2-i64-lane-id)
    (struct-get collections uses-avx512-i64-lane-id)
    (struct-get collections uses-f64-neg)))

(define (compiler-backend-program-collections-add-string
  [collections : CompilerBackendProgramCollections]
  [text : String]) : CompilerBackendProgramCollections
  (CompilerBackendProgramCollections
    (struct-get collections functions)
    (compiler-backend-string-set-add (struct-get collections strings) text)
    (struct-get collections floats)
    (struct-get collections bytes)
    (struct-get collections uses-avx2-i64-lane-id)
    (struct-get collections uses-avx512-i64-lane-id)
    (struct-get collections uses-f64-neg)))

(define (compiler-backend-program-collections-add-float
  [collections : CompilerBackendProgramCollections]
  [ty : AstType]
  [bits : u64]) : CompilerBackendProgramCollections
  (CompilerBackendProgramCollections
    (struct-get collections functions)
    (struct-get collections strings)
    (compiler-backend-float-set-add (struct-get collections floats) ty bits)
    (struct-get collections bytes)
    (struct-get collections uses-avx2-i64-lane-id)
    (struct-get collections uses-avx512-i64-lane-id)
    (struct-get collections uses-f64-neg)))

(define (compiler-backend-program-collections-add-bytes
  [collections : CompilerBackendProgramCollections]
  [text : String]) : CompilerBackendProgramCollections
  (CompilerBackendProgramCollections
    (struct-get collections functions)
    (struct-get collections strings)
    (struct-get collections floats)
    (compiler-backend-string-set-add (struct-get collections bytes) text)
    (struct-get collections uses-avx2-i64-lane-id)
    (struct-get collections uses-avx512-i64-lane-id)
    (struct-get collections uses-f64-neg)))

(define (compiler-backend-program-collections-mark-avx2-i64-lane-id
  [collections : CompilerBackendProgramCollections]) : CompilerBackendProgramCollections
  (CompilerBackendProgramCollections
    (struct-get collections functions)
    (struct-get collections strings)
    (struct-get collections floats)
    (struct-get collections bytes)
    true
    (struct-get collections uses-avx512-i64-lane-id)
    (struct-get collections uses-f64-neg)))

(define (compiler-backend-program-collections-mark-avx512-i64-lane-id
  [collections : CompilerBackendProgramCollections]) : CompilerBackendProgramCollections
  (CompilerBackendProgramCollections
    (struct-get collections functions)
    (struct-get collections strings)
    (struct-get collections floats)
    (struct-get collections bytes)
    (struct-get collections uses-avx2-i64-lane-id)
    true
    (struct-get collections uses-f64-neg)))

(define (compiler-backend-program-collections-mark-f64-neg
  [collections : CompilerBackendProgramCollections]) : CompilerBackendProgramCollections
  (CompilerBackendProgramCollections
    (struct-get collections functions)
    (struct-get collections strings)
    (struct-get collections floats)
    (struct-get collections bytes)
    (struct-get collections uses-avx2-i64-lane-id)
    (struct-get collections uses-avx512-i64-lane-id)
    true))

(define (backend-and4 [a : bool] [b : bool] [c : bool] [d : bool]) : bool
  (and a b c d))

(define (backend-or4 [a : bool] [b : bool] [c : bool] [d : bool]) : bool
  (or a b c d))

(define (backend-and8
  [a : bool]
  [b : bool]
  [c : bool]
  [d : bool]
  [e : bool]
  [f : bool]
  [g : bool]
  [h : bool]) : bool
  (and (backend-and4 a b c d) (backend-and4 e f g h)))

(define (backend-or8
  [a : bool]
  [b : bool]
  [c : bool]
  [d : bool]
  [e : bool]
  [f : bool]
  [g : bool]
  [h : bool]) : bool
  (or (backend-or4 a b c d) (backend-or4 e f g h)))

;; Best-available diagnostic for a backend error originating inside `function`.
;;
;; When the lowering provenance side table has a source span for the
;;
;; function, the diagnostic is stamped with that real line/column via
;;
;; `compiler-diagnostic-from-ast-span`; otherwise it falls back to the
;;
;; `path:1:1` location. `function` is the raw IR function name (the key used by
;;
;; the spans table), not the mangled assembly symbol.
(define (compiler-backend-source-span-index-fill
  [values : (Array CompilerMaybeSourceSpan)]
  [index : i64]) : unit
  (if (>= index (array-length values))
    unit
    (begin
      (array-set! values index (CompilerMaybeSourceSpan.No))
      (compiler-backend-source-span-index-fill values (+ index 1)))))

(define (compiler-backend-source-span-index-add
  [entries : CompilerSourceSpansEntryList]
  [map : backend_i64_i64_map.Map]
  [values : (Array CompilerMaybeSourceSpan)]) : backend_i64_i64_map.Map
  (compiler-backend-source-span-index-add-array
    (struct-get entries slots)
    (- (struct-get entries len) 1)
    map
    values))

(define (compiler-backend-source-span-index-add-array
  [slots : (Array CompilerSourceSpansEntry)]
  [index : i64]
  [map : backend_i64_i64_map.Map]
  [values : (Array CompilerMaybeSourceSpan)]) : backend_i64_i64_map.Map
  (if (< index 0)
    map
    (match (array-ref slots index)
      [(CompilerSourceSpansEntry.Entry name _ span)
        (if (backend_i64_i64_map.contains?
          (& map)
          (compiler-ir-symbol-id-value name))
          (compiler-backend-source-span-index-add-array
            slots
            (- index 1)
            map
            values)
          (begin
            (backend_i64_i64_map.insert-ref!
              (&mut map)
              (compiler-ir-symbol-id-value name)
              index)
            (array-set! values index (CompilerMaybeSourceSpan.Some span))
            (compiler-backend-source-span-index-add-array
              slots
              (- index 1)
              map
              values)))])))

(define (compiler-backend-source-span-index-build [spans : CompilerSourceSpans]) : CompilerBackendSourceSpanIndex
  (match spans
    [(CompilerSourceSpans.Spans entries _ _)
      (let
        [count : i64 (compiler-source-spans-count spans)]
        [values : (Array CompilerMaybeSourceSpan)
          (array.make-array CompilerMaybeSourceSpan count)]
        (begin
          (compiler-backend-source-span-index-fill values 0)
          (CompilerBackendSourceSpanIndex
            (compiler-backend-source-span-index-add
              entries
              (backend_i64_i64_map.with-capacity (+ (* count 2) 16))
              values)
            values
            (compiler-backend-debug-file-index-build spans))))]))

(define (compiler-backend-source-span-index-lookup
  [index : CompilerBackendSourceSpanIndex]
  [name : CompilerIrSymbolId]) : CompilerMaybeSourceSpan
  (match (backend_i64_i64_map.get
    (& (struct-get index entries))
    (compiler-ir-symbol-id-value name))
    [(backend_i64_i64_map.LookupFound slot)
      (if (and (>= slot 0) (< slot (array-length (struct-get index values))))
        (array-ref (struct-get index values) slot)
        (CompilerMaybeSourceSpan.No))]
    [(backend_i64_i64_map.LookupMissing) (CompilerMaybeSourceSpan.No)]))

(define (compiler-backend-function-diagnostic-index
  [index : CompilerBackendSourceSpanIndex]
  [function : CompilerIrSymbolId]
  [message : String]) : CompilerDiagnostic
  (match (compiler-backend-source-span-index-lookup index function)
    [(CompilerMaybeSourceSpan.Some span)
      (compiler-diagnostic-from-ast-span "" span message)]
    [(CompilerMaybeSourceSpan.No) (compiler-diagnostic-at-start "" message)]))

(define (compiler-backend-instr-diagnostic
  [spans : CompilerSourceSpans]
  [function : i64]
  [instr : CompilerIrInstr]
  [fallback : CompilerDiagnostic]
  [message : String]) : CompilerDiagnostic
  (match (compiler-source-spans-lookup-instr spans function instr)
    [(CompilerMaybeSourceSpan.Some span)
      (compiler-diagnostic-from-ast-span "" span message)]
    [(CompilerMaybeSourceSpan.No)
      (compiler-diagnostic-with-message fallback message)]))

(define (compiler-backend-apply-instr-diagnostic
  [diag : CompilerDiagnostic]
  [instr-diag : CompilerDiagnostic]) : CompilerDiagnostic
  (compiler-diagnostic-with-message
    instr-diag
    (compiler-diagnostic-message diag)))

(define (compiler-backend-mode-prologue [mode : CompilerBackendMode]) : String
  (match mode
    [(CompilerBackendMode.Avx2) "    vzeroupper\n"]
    [_ ""]))

(define (compiler-backend-dispatch-avx2-prefix) : String
  "__tl_dispatch_variant_avx2_")

(define (compiler-backend-dispatch-avx512-prefix) : String
  "__tl_dispatch_variant_avx512_")

(define (compiler-backend-effective-mode-for-function-name
  [mode : CompilerBackendMode]
  [name : String]) : CompilerBackendMode
  (if (compiler-backend-string-prefix-at?
    name
    (compiler-backend-dispatch-avx512-prefix)
    0)
    (CompilerBackendMode.Avx512)
    (if (compiler-backend-string-prefix-at?
      name
      (compiler-backend-dispatch-avx2-prefix)
      0)
      (CompilerBackendMode.Avx2)
      mode)))

(define (compiler-backend-effective-function-mode
  [mode : CompilerBackendMode]
  [func : CompilerIrFunction]) : CompilerBackendMode
  (match func
    [(CompilerIrFunction.Function name _ _ _ _)
      (compiler-backend-effective-mode-for-function-name
        mode
        (compiler-ir-symbol-text name))]))

(define (compiler-backend-avx2-shape-ok? [elem-ty : AstType] [lanes : i64]) : bool
  (match elem-ty
    [(AstType.I64) (= lanes 4)]
    [(AstType.U64) (= lanes 4)]
    [(AstType.F64) (= lanes 4)]
    [(AstType.F32) (= lanes 8)]
    [(AstType.I32) (= lanes 8)]
    [(AstType.U32) (= lanes 8)]
    [(AstType.I16) (= lanes 16)]
    [(AstType.U16) (= lanes 16)]
    [(AstType.I8) (= lanes 32)]
    [(AstType.U8) (= lanes 32)]
    [_ false]))

(define (compiler-backend-avx2-shape-diagnostic
  [type-segment-bases : i64]
  [instr-diag : CompilerDiagnostic]
  [elem-ty : AstType]
  [lanes : i64]) : ResultCompilerBackend
  (ResultCompilerBackend.Err
    (box
      (compiler-diagnostic-with-message
        instr-diag
        (str_cat.str-cat
          "backend: unsupported AVX2 vector shape "
          (string.int->string lanes)
          " x "
          (compiler-ir-type-name type-segment-bases elem-ty))))))

