      [(CompilerIrInstrList.Cons maybe-gep after-gep)
        (match maybe-gep
          [(CompilerIrInstr.Gep gep-dst base offset elem-ty)
            (if (compiler-backend-var-single-use? ctx.use-counts gep-dst)
              (match (box-get after-gep)
                [(CompilerIrInstrList.Cons maybe-store after-store)
                  (match maybe-store
                    [(CompilerIrInstr.StorePtr store-ptr store-value store-ty)
                      (if (compiler-backend-divmod-direct-gep-store?
                        ctx.type-segment-bases
                        ctx.assignments
                        div-dst
                        gep-dst
                        base
                        offset
                        elem-ty
                        store-ptr
                        store-value)
                        (let
                          [_reserved : unit
                            (set!
                              compiler-backend-current-instr-reserved-mask
                              (compiler-backend-instr-reserved-home-mask
                                div-instr))]
                          [planned-magic : String
                            (compiler-backend-scratch-plan-register-ahead
                              (compiler-backend-runtime-plan-scratch ctx.plan)
                              0
                              2)]
                          [magic : String
                            (compiler-backend-divmod-polish-magic-ahead
                              ctx
                              div-instr
                              div-dst
                              div-op
                              div-rhs
                              div-ty
                              0
                              planned-magic)]
                          [hoist-reg : String
                            (compiler-backend-divmod-polish-hoist-reg-ahead
                              div-instr
                              0)]
                          [src : String
                            (compiler-backend-divmod-polish-src
                              ctx
                              div-dst
                              div-lhs
                              magic
                              hoist-reg
                              (compiler-backend-scratch-plan-register-ahead
                                (compiler-backend-runtime-plan-scratch ctx.plan)
                                0
                                3)
                              true
                              (compiler-backend-binop-wants-remainder? div-op)
                              div-dst)]
                          (if (compiler-backend-divmod-direct-gep-store-clobber-safe?
                            ctx.assignments
                            src
                            magic
                            base
                            offset)
                            (CompilerBackendMaybeDivmodPolish.Some
                              (compiler-backend-emit-divmod-result-gep-store-rest
                                ctx
                                fallthrough
                                div-instr
                                div-dst
                                src
                                gep-dst
                                base
                                offset
                                elem-ty
                                store-value
                                store-ty
                                (box-get after-store)
                                out))
                            (CompilerBackendMaybeDivmodPolish.No)))
                        (CompilerBackendMaybeDivmodPolish.No))]
                    [_ (CompilerBackendMaybeDivmodPolish.No)])]
                [_ (CompilerBackendMaybeDivmodPolish.No)])
              (CompilerBackendMaybeDivmodPolish.No))]
          [_ (CompilerBackendMaybeDivmodPolish.No)])]
      [_ (CompilerBackendMaybeDivmodPolish.No)])
    (CompilerBackendMaybeDivmodPolish.No)))

(define (compiler-backend-try-divmod-polish
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeDivmodPolish
  (match instr
    [(CompilerIrInstr.BinOp
        producer-dst
        producer-op
        producer-lhs
        producer-rhs
        producer-ty)
      (match rest
        [(CompilerIrInstrList.Cons next after-div)
          (match next
            [(CompilerIrInstr.BinOp div-dst div-op div-lhs div-rhs div-ty)
              (if (compiler-backend-divmod-producer-feeds?
                ctx
                producer-dst
                producer-op
                producer-lhs
                producer-rhs
                producer-ty
                div-op
                div-lhs
                div-rhs
                div-ty)
                (let
                  [_reserved : unit
                    (set!
                      compiler-backend-current-instr-reserved-mask
                      (compiler-backend-instr-reserved-home-mask instr))]
                  [planned-magic : String
                    (compiler-backend-scratch-plan-register-ahead
                      (compiler-backend-runtime-plan-scratch ctx.plan)
                      1
                      2)]
                  [magic : String
                    (compiler-backend-divmod-polish-magic-ahead
                      ctx
                      next
                      div-dst
                      div-op
                      div-rhs
                      div-ty
                      1
                      planned-magic)]
                  [hoist-reg : String
                    (compiler-backend-divmod-polish-hoist-reg-ahead next 1)]
                  [src : String
                    (compiler-backend-divmod-polish-src
                      ctx
                      div-dst
                      div-lhs
                      magic
                      hoist-reg
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        1
                        3)
                      false
                      (compiler-backend-binop-wants-remainder? div-op)
                      producer-dst)]
                  (CompilerBackendMaybeDivmodPolish.Some
                    (compiler-backend-emit-steered-producer-divmod-rest
                      ctx
                      fallthrough
                      instr
                      producer-dst
                      next
                      div-dst
                      src
                      magic
                      (box-get after-div)
                      out)))
                (compiler-backend-try-divmod-result-gep-store
                  ctx
                  fallthrough
                  instr
                  producer-dst
                  producer-op
                  producer-lhs
                  producer-rhs
                  producer-ty
                  rest
                  out))]
            [_
              (compiler-backend-try-divmod-result-gep-store
                ctx
                fallthrough
                instr
                producer-dst
                producer-op
                producer-lhs
                producer-rhs
                producer-ty
                rest
                out)])]
        [_
          (compiler-backend-try-divmod-result-gep-store
            ctx
            fallthrough
            instr
            producer-dst
            producer-op
            producer-lhs
            producer-rhs
            producer-ty
            rest
            out)])]
    [_ (CompilerBackendMaybeDivmodPolish.No)]))

(define (compiler-backend-emit-load-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [load-dst : i64]
  [ptr : CompilerIrValue]
  [load-ty : AstType]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (and
    (compiler-backend-load-compare-type? ctx.type-segment-bases load-ty)
    (compiler-backend-var-single-use? ctx.use-counts load-dst))
    (match rest
      [(CompilerIrInstrList.Cons next after-cmp)
        (match next
          [(CompilerIrInstr.Load second-dst second-src second-ty)
            (if (compiler-backend-branch-uses-var? second-src load-dst)
              (compiler-backend-emit-fused-result-rest
                ctx
                fallthrough
                (compiler-backend-emit-load-load
                  ctx.type-segment-bases
                  ctx.assignments
                  load-dst
                  ptr
                  load-ty
                  second-dst
                  second-ty
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0
                    0)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0
                    1)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    0)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    1))
                (box-get after-cmp)
                out)
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                rest
                out))]
          [(CompilerIrInstr.BinOp cmp-dst op lhs rhs cmp-ty)
            (if (and
              (compiler-backend-compare-op? op)
              (compiler-backend-branch-uses-var? lhs load-dst)
              (compiler-backend-var-single-use? ctx.use-counts cmp-dst)
              (not
                (compiler-backend-binop-f64?
                  ctx.types
                  ctx.global-types
                  lhs
                  rhs
                  cmp-ty)))
              (match (box-get after-cmp)
                [(CompilerIrInstrList.Cons branch after-branch)
                  (match branch
                    [(CompilerIrInstr.Branch cond true-label false-label)
                      (if (compiler-backend-branch-uses-var? cond cmp-dst)
                        (compiler-backend-emit-fused-load-compare-branch-rest
                          ctx
                          fallthrough
                          load-dst
                          ptr
                          load-ty
                          cmp-dst
                          op
                          rhs
                          cmp-ty
                          true-label
                          false-label
                          (box-get after-branch)
                          out)
                        (compiler-backend-emit-instrs-normal
                          ctx
                          fallthrough
                          instr
                          rest
                          out))]
                    [_
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        rest
                        out)])]
                [_
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out)])
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                rest
                out))]
          [_
            (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)])]
      [_ (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)])
    (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)))

(define (compiler-backend-emit-store-ptr-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [ptr : CompilerIrValue]
  [value0 : CompilerIrValue]
  [ty0 : AstType]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match rest
    [(CompilerIrInstrList.Cons maybe-gep after-gep)
      (match maybe-gep
        [(CompilerIrInstr.Gep gep-dst base offset elem-ty)
          (if (and
            (opt-value-eq base ptr)
            (compiler-backend-var-single-use? ctx.use-counts gep-dst))
            (match (compiler-backend-value-as-i64 offset)
              [(option_i64.Some n)
                (let
                  [disp : i64
                    (*
                      n
                      (compiler-backend-type-size
                        ctx.type-segment-bases
                        elem-ty))]
                  (if (compiler-backend-imm32? disp)
                    (match (box-get after-gep)
                      [(CompilerIrInstrList.Cons maybe-store after-store)
                        (match maybe-store
                          [(CompilerIrInstr.StorePtr dst value1 ty1)
                            (if (compiler-backend-branch-uses-var? dst gep-dst)
                              (compiler-backend-emit-fused-result-rest
                                ctx
                                fallthrough
                                (compiler-backend-emit-store-ptr-pair
                                  ctx.type-segment-bases
                                  ctx.assignments
                                  ptr
                                  value0
                                  ty0
                                  disp
                                  value1
                                  ty1
                                  ctx.program-index
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    1
                                    0)
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    0
                                    1)
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    2
                                    1))
                                (box-get after-store)
                                out)
                              (compiler-backend-emit-instrs-normal
                                ctx
                                fallthrough
                                instr
                                rest
                                out))]
                          [_
                            (compiler-backend-emit-instrs-normal
                              ctx
                              fallthrough
                              instr
                              rest
                              out)])]
                      [_
                        (compiler-backend-emit-instrs-normal
                          ctx
                          fallthrough
                          instr
                          rest
                          out)])
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      rest
                      out)))]
              [(option_i64.None)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  rest
                  out)])
            (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out))]
        [_ (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)])]
    [_ (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)]))

(define (compiler-backend-emit-vector-load-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [load-dst : i64]
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [lanes : i64]
  [elem-ty : AstType]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match rest
    [(CompilerIrInstrList.Cons next after-binop)
      (match next
        [(CompilerIrInstr.VectorBinOp payload-box)
          (match (box-get payload-box)
            [(CompilerIrInstrVectorBinOpPayload.Payload
                bin-dst
                op
                lhs
                rhs
                bin-lanes
                bin-elem-ty)
              (if (compiler-backend-vector-load-binop-foldable?
                ctx.type-segment-bases
                ctx.use-counts
                load-dst
                lanes
                elem-ty
                op
                lhs
                rhs
                bin-lanes
                bin-elem-ty)
                (match (compiler-backend-vector-load-binop-fold-value
                  load-dst
                  op
                  lhs
                  rhs)
                  [(CompilerBackendVectorMemFold.Some reg-value)
                    (compiler-backend-emit-fused-result-rest
                      ctx
                      fallthrough
                      (compiler-backend-emit-vector-binop-memory-source
                        ctx.type-segment-bases
                        ctx.assignments
                        bin-dst
                        op
                        reg-value
                        base
                        index
                        bin-lanes
                        bin-elem-ty
                        (compiler-backend-scratch-plan-register-here
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0)
                        (compiler-backend-scratch-plan-register-here
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1)
                        (compiler-backend-instr-diagnostic
                          ctx.spans
                          ctx.source-function
                          next
                          ctx.func-diag
                          ""))
                      (box-get after-binop)
                      out)]
                  [(CompilerBackendVectorMemFold.No)
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      rest
                      out)])
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  rest
                  out))])]
        [_ (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)])]
    [_ (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)]))

(define (compiler-backend-emit-copy-bytes-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : CompilerIrValue]
  [src : CompilerIrValue]
  [size : i64]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [protect-n : i64
      (compiler-backend-copy-run-protect-count ctx.assignments rest)]
    [protect : (Array String)
      (compiler-backend-copy-run-protect-exclude ctx.assignments rest)]
    (compiler-backend-emit-fused-result-rest
      ctx
      fallthrough
      (compiler-backend-emit-copy-bytes-avoid
        ctx.type-segment-bases
        ctx.assignments
        dst
        src
        size
        protect
        protect-n
        (compiler-backend-scratch-plan-register-ahead
          (compiler-backend-runtime-plan-scratch ctx.plan)
          0
          0)
        (compiler-backend-scratch-plan-register-ahead
          (compiler-backend-runtime-plan-scratch ctx.plan)
          0
          1)
        (compiler-backend-scratch-plan-register-ahead
          (compiler-backend-runtime-plan-scratch ctx.plan)
          0
          (if (>= size 16)
            3
            2))
        (if (>= size 16)
          (compiler-backend-scratch-plan-register-ahead
            (compiler-backend-runtime-plan-scratch ctx.plan)
            0
            2)
          ""))
      rest
      out)))

(define (compiler-backend-emit-mov-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match rest
    [(CompilerIrInstrList.Cons next after-jump)
      (match next
        [(CompilerIrInstr.Cast cast-dst cast-src _ _)
          (match (box-get after-jump)
            [(CompilerIrInstrList.Cons after-cast after-binop)
              (match after-cast
                [(CompilerIrInstr.BinOp bin-dst op lhs rhs bin-ty)
                  (if (and
                    (compiler-backend-divmod-op? op)
                    (compiler-backend-branch-uses-var? cast-src dst)
                    (compiler-backend-branch-uses-var? rhs cast-dst)
                    (compiler-backend-var-single-use? ctx.use-counts dst)
                    (compiler-backend-var-single-use? ctx.use-counts cast-dst)
                    (compiler-backend-divmod-safe-literal? src bin-ty))
                    (match (compiler-backend-emit-binop
                      ctx.type-segment-bases
                      ctx.types
                      ctx.global-types
                      ctx.assignments
                      bin-dst
                      op
                      lhs
                      src
                      bin-ty)
                      [(ResultCompilerBackend.Ok binop-asm)
                        (begin
                          (compiler-backend-emergency-append out binop-asm)
                          (compiler-backend-emit-instrs
                            ctx
                            fallthrough
                            (box-get after-binop)
                            out))]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err message)])
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      rest
                      out))]
                [_
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out)])]
            [_
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                rest
                out)])]
        [(CompilerIrInstr.BinOp bin-dst op lhs rhs bin-ty)
          (if (and
            (compiler-backend-divmod-op? op)
            (compiler-backend-branch-uses-var? rhs dst)
            (compiler-backend-divmod-safe-literal? src bin-ty))
            (match (if (compiler-backend-var-single-use? ctx.use-counts dst)
              (ResultCompilerBackend.Ok "")
              (compiler-backend-emit-mov
                ctx.type-segment-bases
                ctx.assignments
                dst
                src
                ty
                ctx.program-index
                ctx.vars
                ""))
              [(ResultCompilerBackend.Ok prefix)
                (match (compiler-backend-emit-binop
                  ctx.type-segment-bases
                  ctx.types
                  ctx.global-types
                  ctx.assignments
                  bin-dst
                  op
                  lhs
                  src
                  bin-ty)
                  [(ResultCompilerBackend.Ok binop-asm)
                    (begin
                      (compiler-backend-emergency-append
                        out
                        (string.append prefix binop-asm))
                      (compiler-backend-emit-instrs
                        ctx
                        fallthrough
                        (box-get after-jump)
                        out))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)])
            (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out))]
        [(CompilerIrInstr.Jump target-label)
          (compiler-backend-emit-fused-mov-trivial-phi-return-rest
            ctx
            fallthrough
            dst
            src
            ty
            target-label
            (box-get after-jump)
            out)]
        [(CompilerIrInstr.Return maybe)
          (match (box-get after-jump)
            [(CompilerIrInstrList.Nil)
              (match maybe
                [(CompilerIrMaybeValue.Some value)
                  (if (compiler-backend-branch-uses-var? value dst)
                    (match (compiler-backend-emit-return
                      ctx.type-segment-bases
                      ctx.source-function
                      ctx.blocks
                      (CompilerIrMaybeValue.Some src)
                      ctx.assignments
                      ctx.vars
                      ctx.ret-ty
                      ctx.program-index)
                      [(ResultCompilerBackend.Ok asm)
                        (begin
                          (compiler-backend-emergency-append out asm)
                          (ResultCompilerBackend.Ok ""))]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err
                          (box
                            (compiler-backend-apply-instr-diagnostic
                              (box-get message)
                              (compiler-backend-instr-diagnostic
                                ctx.spans
                                ctx.source-function
                                instr
                                ctx.func-diag
                                ""))))])
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      rest
                      out))]
                [(CompilerIrMaybeValue.No)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out)])]
            [_
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                rest
                out)])]
        [_ (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)])]
    [_ (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)]))

(define (compiler-backend-emit-call-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [dst : i64]
  [name : i64]
  [args : CompilerIrCallArgs]
  [ty : AstType]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match rest
    [(CompilerIrInstrList.Cons next after-return)
      (match next
        [(CompilerIrInstr.Return maybe)
          (match (box-get after-return)
            [(CompilerIrInstrList.Nil)
              (match maybe
                [(CompilerIrMaybeValue.Some value)
                  (if (and
                    (compiler-backend-branch-uses-var? value dst)
                    (not (compiler-backend-stdlib-io-panic-name? name))
                    (opt-type-eq ctx.type-segment-bases ty ctx.ret-ty))
                    (compiler-backend-emit-terminator-into
                      (compiler-backend-emit-call-return
                        ctx.type-segment-bases
                        ctx.target
                        ctx.source-function
                        ctx.blocks
                        name
                        args
                        ctx.assignments
                        (compiler-backend-scratch-plan-register-here
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0)
                        ctx.types
                        ctx.global-types
                        ctx.vars
                        ctx.plan
                        ctx.functions
                        ctx.externs
                        ctx.program-index
                        (compiler-backend-instr-diagnostic
                          ctx.spans
                          ctx.source-function
                          instr
                          ctx.func-diag
                          ""))
                      out)
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      rest
                      out))]
                [(CompilerIrMaybeValue.No)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out)])]
            [_
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                rest
                out)])]
        [_ (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)])]
    [_ (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)]))

;; The `Gep` fusion cluster of `compiler-backend-emit-instrs-step`, extracted
;; unchanged (refs #5177). It is the peephole family that folds a single-use
;; address computation into the instruction that consumes it -- load, store,
;; copy, binop and the branch forms behind them -- so it is one cluster and
;; moves as one, matching the `mov`/`call`/`store-ptr` steps already split out.
(define (compiler-backend-emit-gep-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [gep-dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (compiler-backend-var-single-use? ctx.use-counts gep-dst)
    (match (compiler-backend-value-as-i64 offset)
      [(option_i64.Some n)
        (match rest
          [(CompilerIrInstrList.Cons next after-load)
            (match next
              [(CompilerIrInstr.Load load-dst src load-ty)
                (if (compiler-backend-branch-uses-var? src gep-dst)
                  (if (and
                    (compiler-backend-load-compare-type?
                      ctx.type-segment-bases
                      load-ty)
                    (compiler-backend-var-single-use? ctx.use-counts load-dst))
                    (match (box-get after-load)
                      [(CompilerIrInstrList.Cons maybe-cmp after-cmp)
                        (match maybe-cmp
                          [(CompilerIrInstr.BinOp cmp-dst op lhs rhs cmp-ty)
                            (if (and
                              (compiler-backend-compare-op? op)
                              (compiler-backend-branch-uses-var? lhs load-dst)
                              (compiler-backend-var-single-use?
                                ctx.use-counts
                                cmp-dst)
                              (not
                                (compiler-backend-binop-f64?
                                  ctx.types
                                  ctx.global-types
                                  lhs
                                  rhs
                                  cmp-ty)))
                              (match (box-get after-cmp)
                                [(CompilerIrInstrList.Cons branch after-branch)
                                  (match branch
                                    [(CompilerIrInstr.Branch
                                        cond
                                        true-label
                                        false-label)
                                      (if (compiler-backend-branch-uses-var?
                                        cond
                                        cmp-dst)
                                        (compiler-backend-emit-fused-gep-load-compare-branch-rest
                                          ctx
                                          fallthrough
                                          gep-dst
                                          (compiler-backend-gep-fold-next!
                                            ctx.type-segment-bases
                                            offset
                                            elem-ty)
                                          base
                                          offset
                                          elem-ty
                                          load-dst
                                          load-ty
                                          cmp-dst
                                          op
                                          rhs
                                          cmp-ty
                                          true-label
                                          false-label
                                          (box-get after-branch)
                                          out)
                                        (compiler-backend-emit-fused-gep-load-rest
                                          ctx
                                          fallthrough
                                          gep-dst
                                          (compiler-backend-gep-fold-next!
                                            ctx.type-segment-bases
                                            offset
                                            elem-ty)
                                          base
                                          offset
                                          elem-ty
                                          load-dst
                                          load-ty
                                          (box-get after-load)
                                          out))]
                                    [_
                                      (compiler-backend-emit-fused-gep-load-rest
                                        ctx
                                        fallthrough
                                        gep-dst
                                        (compiler-backend-gep-fold-next!
                                          ctx.type-segment-bases
                                          offset
                                          elem-ty)
                                        base
                                        offset
                                        elem-ty
                                        load-dst
                                        load-ty
                                        (box-get after-load)
                                        out)])]
                                [_
                                  (compiler-backend-emit-fused-gep-load-rest
                                    ctx
                                    fallthrough
                                    gep-dst
                                    (compiler-backend-gep-fold-next!
                                      ctx.type-segment-bases
                                      offset
                                      elem-ty)
                                    base
                                    offset
                                    elem-ty
                                    load-dst
                                    load-ty
                                    (box-get after-load)
                                    out)])
                              (compiler-backend-emit-fused-gep-load-rest
                                ctx
                                fallthrough
                                gep-dst
                                (compiler-backend-gep-fold-next!
                                  ctx.type-segment-bases
                                  offset
                                  elem-ty)
                                base
                                offset
                                elem-ty
                                load-dst
                                load-ty
                                (box-get after-load)
                                out))]
                          [_
                            (compiler-backend-emit-fused-gep-load-rest
                              ctx
                              fallthrough
                              gep-dst
                              (compiler-backend-gep-fold-next!
                                ctx.type-segment-bases
                                offset
                                elem-ty)
                              base
                              offset
                              elem-ty
                              load-dst
                              load-ty
                              (box-get after-load)
                              out)])]
                      [_
                        (compiler-backend-emit-fused-gep-load-rest
                          ctx
                          fallthrough
                          gep-dst
                          (compiler-backend-gep-fold-next!
                            ctx.type-segment-bases
                            offset
                            elem-ty)
                          base
                          offset
                          elem-ty
                          load-dst
                          load-ty
                          (box-get after-load)
                          out)])
                    (compiler-backend-emit-fused-gep-load-rest
                      ctx
                      fallthrough
                      gep-dst
                      (compiler-backend-gep-fold-next!
                        ctx.type-segment-bases
                        offset
                        elem-ty)
                      base
                      offset
                      elem-ty
                      load-dst
                      load-ty
                      (box-get after-load)
                      out))
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out))]
              [(CompilerIrInstr.StorePtr dst value store-ty)
                (if (compiler-backend-branch-uses-var? dst gep-dst)
                  (compiler-backend-emit-fused-gep-store-rest
                    ctx
                    fallthrough
                    gep-dst
                    (compiler-backend-gep-fold-next!
                      ctx.type-segment-bases
                      offset
                      elem-ty)
                    base
                    offset
                    elem-ty
                    value
                    store-ty
                    (box-get after-load)
                    out)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out))]
              [(CompilerIrInstr.CopyBytes copy-dst copy-src copy-size)
                (if (and
                  (compiler-backend-branch-uses-var? copy-dst gep-dst)
                  (compiler-backend-imm32?
                    (*
                      n
                      (compiler-backend-type-size
                        ctx.type-segment-bases
                        elem-ty))))
                  (let
                    [protect-n : i64
                      (compiler-backend-copy-run-protect-count
                        ctx.assignments
                        (box-get after-load))]
                    [protect : (Array String)
                      (compiler-backend-copy-run-protect-exclude
                        ctx.assignments
                        (box-get after-load))]
                    (compiler-backend-emit-fused-result-rest
                      ctx
                      fallthrough
                      (compiler-backend-emit-copy-bytes-from-gep-avoid
                        ctx.type-segment-bases
                        ctx.assignments
                        base
                        offset
                        elem-ty
                        copy-src
                        copy-size
                        protect
                        protect-n
                        (compiler-backend-gep-fold-next!
                          ctx.type-segment-bases
                          offset
                          elem-ty)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          0)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          1)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1
                          1)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1
                          (if (>= copy-size 16)
                            3
                            2))
                        (if (>= copy-size 16)
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            1
                            2)
                          ""))
                      (box-get after-load)
                      out))
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out))]
              [_
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  rest
                  out)])]
          [_
            (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)])]
      [(option_i64.None)
        (match rest
          [(CompilerIrInstrList.Cons next after-gep)
            (match next
              [(CompilerIrInstr.Gep _ load-base load-offset _)
                (compiler-backend-emit-fused-result-rest
                  ctx
                  fallthrough
                  (if (compiler-backend-branch-uses-var? load-base gep-dst)
                    (compiler-backend-emit-gep
                      ctx.type-segment-bases
                      ctx.assignments
                      gep-dst
                      base
                      offset
                      elem-ty
                      (compiler-backend-gep-fold-next!
                        ctx.type-segment-bases
                        offset
                        elem-ty)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        0
                        0)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        0
                        1))
                    (compiler-backend-emit-gep-staged-avoid
                      ctx.type-segment-bases
                      ctx.assignments
                      gep-dst
                      base
                      offset
                      elem-ty
                      (compiler-backend-gep-fold-next!
                        ctx.type-segment-bases
                        offset
                        elem-ty)
                      (compiler-backend-value-scalar-register
                        ctx.assignments
                        load-base)
                      (compiler-backend-value-scalar-register
                        ctx.assignments
                        load-offset)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        0
                        0)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        0
                        1)))
                  rest
                  out)]
              [(CompilerIrInstr.Mov ptr-var src _)
                (if (and
                  (compiler-backend-branch-uses-var? src gep-dst)
                  (compiler-backend-var-single-use? ctx.use-counts ptr-var))
                  (match (box-get after-gep)
                    [(CompilerIrInstrList.Cons maybe-store after-store)
                      (match maybe-store
                        [(CompilerIrInstr.StorePtr dst value store-ty)
                          (if (compiler-backend-branch-uses-var? dst ptr-var)
                            (compiler-backend-emit-fused-gep-store-rest
                              ctx
                              fallthrough
                              gep-dst
                              (compiler-backend-gep-fold-next!
                                ctx.type-segment-bases
                                offset
                                elem-ty)
                              base
                              offset
                              elem-ty
                              value
                              store-ty
                              (box-get after-store)
                              out)
                            (compiler-backend-emit-instrs-normal
                              ctx
                              fallthrough
                              instr
                              rest
                              out))]
                        [_
                          (compiler-backend-emit-instrs-normal
                            ctx
                            fallthrough
                            instr
                            rest
                            out)])]
                    [_
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        rest
                        out)])
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out))]
              [(CompilerIrInstr.Load load-dst src load-ty)
                (if (compiler-backend-branch-uses-var? src gep-dst)
                  (compiler-backend-emit-fused-gep-load-rest
                    ctx
                    fallthrough
                    gep-dst
                    (compiler-backend-gep-fold-next!
                      ctx.type-segment-bases
                      offset
                      elem-ty)
                    base
                    offset
                    elem-ty
                    load-dst
                    load-ty
                    (box-get after-gep)
                    out)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out))]
              [(CompilerIrInstr.StorePtr dst value store-ty)
                (if (compiler-backend-branch-uses-var? dst gep-dst)
                  (compiler-backend-emit-fused-gep-store-rest
                    ctx
                    fallthrough
                    gep-dst
                    (compiler-backend-gep-fold-next!
                      ctx.type-segment-bases
                      offset
                      elem-ty)
                    base
                    offset
                    elem-ty
                    value
                    store-ty
                    (box-get after-gep)
                    out)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out))]
              [(CompilerIrInstr.CopyBytes copy-dst copy-src copy-size)
                (if (compiler-backend-branch-uses-var? copy-dst gep-dst)
                  (let
                    [protect-n : i64
                      (compiler-backend-copy-run-protect-count
                        ctx.assignments
                        (box-get after-gep))]
                    [protect : (Array String)
                      (compiler-backend-copy-run-protect-exclude
                        ctx.assignments
                        (box-get after-gep))]
                    (compiler-backend-emit-fused-result-rest
                      ctx
                      fallthrough
                      (compiler-backend-emit-copy-bytes-from-gep-avoid
                        ctx.type-segment-bases
                        ctx.assignments
                        base
                        offset
                        elem-ty
                        copy-src
                        copy-size
                        protect
                        protect-n
                        (compiler-backend-gep-fold-next!
                          ctx.type-segment-bases
                          offset
                          elem-ty)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          0)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          1)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1
                          1)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1
                          (if (>= copy-size 16)
                            3
                            2))
                        (if (>= copy-size 16)
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            1
                            2)
                          ""))
                      (box-get after-gep)
                      out))
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    rest
                    out))]
              [_
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  rest
                  out)])]
          [_
            (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)])])
    (compiler-backend-emit-instrs-normal ctx fallthrough instr rest out)))

(define (compiler-backend-emit-instrs-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instrs : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match instrs
    [(CompilerIrInstrList.Nil) (ResultCompilerBackend.Ok "")]
    [(CompilerIrInstrList.Cons instr rest)
      (match instr
        [(CompilerIrInstr.Mov dst src ty)
          (compiler-backend-emit-mov-step
            ctx
            fallthrough
            instr
            dst
            src
            ty
            (box-get rest)
            out)]
        [(CompilerIrInstr.Call dst name args ty)
          (compiler-backend-emit-call-step
            ctx
            fallthrough
            instr
            dst
            name
            args
            ty
            (box-get rest)
            out)]
        [(CompilerIrInstr.StorePtr ptr value0 ty0)
          (compiler-backend-emit-store-ptr-step
            ctx
            fallthrough
            instr
            ptr
            value0
            ty0
            (box-get rest)
            out)]
        [(CompilerIrInstr.Gep gep-dst base offset elem-ty)
          (compiler-backend-emit-gep-step
            ctx
            fallthrough
            instr
            gep-dst
            base
            offset
            elem-ty
            (box-get rest)
            out)]
        [(CompilerIrInstr.CopyBytes dst src size)
          (compiler-backend-emit-copy-bytes-step
            ctx
            fallthrough
            dst
            src
            size
            (box-get rest)
            out)]
        [(CompilerIrInstr.VectorLoad load-dst base index lanes elem-ty)
          (compiler-backend-emit-vector-load-step
            ctx
            fallthrough
            instr
            load-dst
            base
            index
            lanes
            elem-ty
            (box-get rest)
            out)]
        [(CompilerIrInstr.Load load-dst ptr load-ty)
          (compiler-backend-emit-load-step
            ctx
            fallthrough
            instr
            load-dst
            ptr
            load-ty
            (box-get rest)
            out)]
        [(CompilerIrInstr.BinOp dst op lhs rhs ty)
          (if (and
            (compiler-backend-var-single-use? ctx.use-counts dst)
            (compiler-backend-rax-forwardable-binop?
              ctx.types
              ctx.global-types
              ctx.assignments
              op
              lhs
              rhs
              ty)
            (compiler-backend-rest-starts-rax-forwardable-consumer?
              ctx.types
              ctx.global-types
              ctx.assignments
              dst
              (box-get rest)))
            (match (compiler-backend-emit-binop-to-rax
              ctx.type-segment-bases
              ctx.types
              ctx.global-types
              ctx.assignments
              dst
              op
              lhs
              rhs
              ty
              false
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                0
                0)
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                0
                1)
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                0
                2)
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                0
                3)
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                0
                4))
              [(ResultCompilerBackend.Ok head)
                (begin
                  (compiler-backend-asm-append
                    out
                    (compiler-backend-emergency-wrap head))
                  (compiler-backend-emit-instrs-with-rax
                    ctx
                    fallthrough
                    dst
                    ty
                    (box-get rest)
                    out))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)])
            (if (and
              (compiler-backend-compare-op? op)
              (or
                (compiler-backend-var-single-use? ctx.use-counts dst)
                (compiler-backend-var-fuse-safe? dst))
              (not
                (compiler-backend-binop-f64?
                  ctx.types
                  ctx.global-types
                  lhs
                  rhs
                  ty)))
              (match (box-get rest)
                [(CompilerIrInstrList.Cons next after-branch)
                  (match next
                    [(CompilerIrInstr.Return maybe)
                      (match (box-get after-branch)
                        [(CompilerIrInstrList.Nil)
                          (match maybe
                            [(CompilerIrMaybeValue.Some value)
                              (if (compiler-backend-branch-uses-var? value dst)
                                (compiler-backend-emit-terminator-into
                                  (compiler-backend-emit-binop-return-with-plan
                                    ctx.type-segment-bases
                                    ctx.source-function
                                    ctx.blocks
                                    ctx.types
                                    ctx.global-types
                                    ctx.assignments
                                    ctx.vars
                                    op
                                    lhs
                                    rhs
                                    ty
                                    (compiler-backend-scratch-plan-register-ahead
                                      (compiler-backend-runtime-plan-scratch
                                        ctx.plan)
                                      0
                                      0)
                                    (compiler-backend-scratch-plan-register-ahead
                                      (compiler-backend-runtime-plan-scratch
                                        ctx.plan)
                                      0
                                      1)
                                    (compiler-backend-scratch-plan-register-ahead
                                      (compiler-backend-runtime-plan-scratch
                                        ctx.plan)
                                      0
                                      2)
                                    (compiler-backend-scratch-plan-register-ahead
                                      (compiler-backend-runtime-plan-scratch
                                        ctx.plan)
                                      0
                                      3)
                                    (compiler-backend-scratch-plan-register-ahead
                                      (compiler-backend-runtime-plan-scratch
                                        ctx.plan)
                                      0
                                      4))
                                  out)
                                (compiler-backend-emit-instrs-normal
                                  ctx
                                  fallthrough
                                  instr
                                  (box-get rest)
                                  out))]
                            [(CompilerIrMaybeValue.No)
                              (compiler-backend-emit-instrs-normal
                                ctx
                                fallthrough
                                instr
                                (box-get rest)
                                out)])]
                        [_
                          (compiler-backend-emit-instrs-normal
                            ctx
                            fallthrough
                            instr
                            (box-get rest)
                            out)])]
                    [(CompilerIrInstr.Branch cond true-label false-label)
                      (if (compiler-backend-branch-uses-var? cond dst)
                        (compiler-backend-emit-fused-compare-branch-rest
                          ctx
                          fallthrough
                          dst
                          op
                          lhs
                          rhs
                          ty
                          true-label
                          false-label
                          (box-get after-branch)
                          out)
                        (compiler-backend-emit-instrs-normal
                          ctx
                          fallthrough
                          instr
                          (box-get rest)
                          out))]
                    [(CompilerIrInstr.UnOp
                        not-dst
                        (CompilerIrUnOp.Not)
                        not-src
                        (AstType.Bool))
                      ;; A single-use `not` between a comparison and its branch
                      ;; only reverses the two successors. Keep the compare
                      ;; flags live, omit both boolean materializations, and
                      ;; branch to the opposite labels directly.
                      (if (and
                        (compiler-backend-var-single-use? ctx.use-counts dst)
                        (compiler-backend-var-single-use?
                          ctx.use-counts
                          not-dst)
                        (compiler-backend-branch-uses-var? not-src dst))
                        (match (box-get after-branch)
                          [(CompilerIrInstrList.Cons branch after-not-branch)
                            (match branch
                              [(CompilerIrInstr.Branch
                                  cond
                                  true-label
                                  false-label)
                                (if (compiler-backend-branch-uses-var?
                                  cond
                                  not-dst)
                                  (compiler-backend-emit-fused-compare-branch-rest
                                    ctx
                                    fallthrough
                                    dst
                                    op
                                    lhs
                                    rhs
                                    ty
                                    false-label
                                    true-label
                                    (box-get after-not-branch)
                                    out)
                                  (compiler-backend-emit-instrs-normal
                                    ctx
                                    fallthrough
                                    instr
                                    (box-get rest)
                                    out))]
                              [_
                                (compiler-backend-emit-instrs-normal
                                  ctx
                                  fallthrough
                                  instr
                                  (box-get rest)
                                  out)])]
                          [_
                            (compiler-backend-emit-instrs-normal
                              ctx
                              fallthrough
                              instr
                              (box-get rest)
                              out)])
                        (compiler-backend-emit-instrs-normal
                          ctx
                          fallthrough
                          instr
                          (box-get rest)
                          out))]
                    [_
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        (box-get rest)
                        out)])]
                [_
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    (box-get rest)
                    out)])
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                (box-get rest)
                out)))]
        [(CompilerIrInstr.UnOp dst (CompilerIrUnOp.Not) src (AstType.Bool))
          (if (or
            (compiler-backend-var-single-use? ctx.use-counts dst)
            (compiler-backend-var-fuse-safe? dst))
            (match (box-get rest)
              [(CompilerIrInstrList.Cons branch after-branch)
                (match branch
                  [(CompilerIrInstr.Branch cond true-label false-label)
                    (if (compiler-backend-branch-uses-var? cond dst)
                      (compiler-backend-emit-fused-not-branch-rest
                        ctx
                        fallthrough
                        dst
                        src
                        (AstType.Bool)
                        true-label
                        false-label
                        (box-get after-branch)
                        out)
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        (box-get rest)
                        out))]
                  [_
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      (box-get rest)
                      out)])]
              [_
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  (box-get rest)
                  out)])
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              (box-get rest)
              out))]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            (box-get rest)
            out)])]))

(define (compiler-backend-emit-instrs-divmod-polish-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instrs : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match instrs
    [(CompilerIrInstrList.Cons instr rest)
      (match (compiler-backend-try-divmod-polish
        ctx
        fallthrough
        instr
        (box-get rest)
        out)
        [(CompilerBackendMaybeDivmodPolish.Some result) result]
        [(CompilerBackendMaybeDivmodPolish.No)
          (compiler-backend-emit-instrs-step ctx fallthrough instrs out)])]
    [_ (compiler-backend-emit-instrs-step ctx fallthrough instrs out)]))

;; Drift-proof per-instruction position for the scavenge coordinate. `post-base`
;; is the cumulative instruction count through the current block (accumulated per
;; block in emit-blocks-into, reset per function in install-ctx); the structural
;; index of the head of `current-instrs` is `post-base - (count current-instrs)`,
;; which equals the interval walk's I (point = 2*I), fusion-proof because the emit
;; loop maintains current-instrs (consuming K drops its length by K). Consumed
;; under (cfg scavenge-self-check) to verify, and later by the no-dst scavenge.
(define compiler-backend-emit-instr-post-base : i64
  0)

;; The remaining-instruction count at the current emit step, captured per step so
;; the no-dst scavenge (compiler-backend-scavenge-reg-here) can derive its point =
;; 2*(post-base - count). Stored as a count, not the list, because the list is a
;; loop-carried owner value that cannot be moved into a global. No asm output.
(define compiler-backend-emit-current-count : i64
  0)

(define (compiler-backend-emit-needs-current-count?
  [plan-mask : i64]
  [const-hoist-sites : i64]
  [backend-mode : CompilerBackendMode]) : bool
  (or
    (not (= plan-mask 0))
    (not (= const-hoist-sites 0))
    ;; AVX2 predicated-store lane labels use the instruction point as their
    ;; identity. Even a stack-only plan therefore needs the exact count so two
    ;; stores in one block cannot emit the same local labels.
    (compiler-backend-mode-avx2? backend-mode)))

(define (compiler-backend-emit-instrs-loop
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [mode : CompilerBackendEmitInstrsMode]
  [instrs : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [current-mode : CompilerBackendEmitInstrsMode mode]
    [current-instrs : CompilerIrInstrList instrs]
    [done : bool false]
    [ok : bool true]
    [asm-out : String ""]
    [diag-out : (Box CompilerDiagnostic)
      (box (compiler-diagnostic-at-start "" ""))]
    (begin
      (set! compiler-backend-emit-instrs-loop-active true)
      (while (not done)
        (let
          [step-result : ResultCompilerBackend
            (begin
              ;; The remaining-instruction count derives the
              ;; scavenge/const-hoist/scratch point 2*(post-base - count).
              ;; When the plan homes nothing in registers (zero plan mask -
              ;; every stack-only opt0/opt1 plan) the occupancy masks carry
              ;; no set bits, so every mask query answers 0 at any point,
              ;; and with no const-hoist sites the point comparisons are
              ;; unreachable. Scalar/AVX-512 can then skip the O(n^2)
              ;; remaining-list walk; AVX2 also uses this point to make
              ;; predicated-store lane labels unique and retains the count.
              (set!
                compiler-backend-emit-current-count
                (if (compiler-backend-emit-needs-current-count?
                  compiler-backend-scavenge-ctx-plan-reg-mask
                  compiler-backend-const-hoist-site-count
                  compiler-backend-current-mode)
                  (compiler-ir-instr-list-count current-instrs)
                  0))
              (cfg
                scavenge-self-check
                (match current-instrs
                  [(CompilerIrInstrList.Cons head-instr _)
                    ;; Per-step used-var check against the LIVE installed ctx
                    ;; (real point). Live-through validation is done by the
                    ;; function-level scavenge-self-check (which has the liveness
                    ;; to supply live-after sets); pass empty here.
                    (compiler-backend-scavenge-check-instr
                      compiler-backend-scavenge-ctx-starts
                      compiler-backend-scavenge-ctx-ends
                      compiler-backend-scavenge-ctx-assignment-index
                      compiler-backend-scavenge-ctx-vars
                      ctx.function
                      (*
                        2
                        (-
                          compiler-backend-emit-instr-post-base
                          (compiler-ir-instr-list-count current-instrs)))
                      head-instr
                      (compiler-live-set-empty))]
                  [(CompilerIrInstrList.Nil) unit])
                unit)
              (set! compiler-backend-emit-instrs-continue-pending false)
              ;; Fast and fused emitters can bypass compiler-backend-emit-instr.
              ;; Install the head instruction's source context at the shared
              ;; dispatch seam so every abort guard sees the correct site.
              ;; Fusions that emit a later div/mod instruction still enter
              ;; compiler-backend-emit-instr for that instruction and replace
              ;; this state with its exact source location.
              (match current-instrs
                [(CompilerIrInstrList.Cons head-instr _)
                  (compiler-backend-runtime-abort-site-install! ctx head-instr)]
                [(CompilerIrInstrList.Nil) unit])
              (match current-mode
                [(CompilerBackendEmitInstrsMode.Normal)
                  (compiler-backend-emit-instrs-divmod-polish-step
                    ctx
                    fallthrough
                    current-instrs
                    out)]
                [(CompilerBackendEmitInstrsMode.Rax rax-var rax-ty)
                  (compiler-backend-emit-instrs-with-rax-step
                    ctx
                    fallthrough
                    rax-var
                    rax-ty
                    current-instrs
                    out)]
                [(CompilerBackendEmitInstrsMode.CallRax rax-var rax-ty)
                  (compiler-backend-emit-instrs-with-call-rax-step
                    ctx
                    fallthrough
                    rax-var
                    rax-ty
                    current-instrs
                    out)]))]
          (match step-result
            [(ResultCompilerBackend.Ok asm)
              (if compiler-backend-emit-instrs-continue-pending
                (begin
                  (set! current-mode compiler-backend-emit-instrs-next-mode)
                  (set! current-instrs compiler-backend-emit-instrs-next-instrs)
                  unit)
                (begin
                  (set! asm-out asm)
                  (set! done true)))]
            [(ResultCompilerBackend.Err message)
              (begin
                (set! diag-out message)
                (set! ok false)
                (set! done true))])))
      (set! compiler-backend-emit-instrs-loop-active false)
      (if ok
        (ResultCompilerBackend.Ok asm-out)
        (ResultCompilerBackend.Err diag-out)))))

(define (compiler-backend-emit-instrs
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instrs : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if compiler-backend-emit-instrs-loop-active
    (compiler-backend-emit-instrs-set-continue!
      (CompilerBackendEmitInstrsMode.Normal)
      instrs)
    (compiler-backend-emit-instrs-loop
      ctx
      fallthrough
      (CompilerBackendEmitInstrsMode.Normal)
      instrs
      out)))

(define (compiler-backend-emit-instrs-with-call-rax
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : AstType]
  [instrs : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if compiler-backend-emit-instrs-loop-active
    (compiler-backend-emit-instrs-set-continue!
      (CompilerBackendEmitInstrsMode.CallRax rax-var rax-ty)
      instrs)
    (compiler-backend-emit-instrs-loop
      ctx
      fallthrough
      (CompilerBackendEmitInstrsMode.CallRax rax-var rax-ty)
      instrs
      out)))

(define (compiler-backend-emit-instrs-with-rax
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : AstType]
  [instrs : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if compiler-backend-emit-instrs-loop-active
    (compiler-backend-emit-instrs-set-continue!
      (CompilerBackendEmitInstrsMode.Rax rax-var rax-ty)
      instrs)
    (compiler-backend-emit-instrs-loop
      ctx
      fallthrough
      (CompilerBackendEmitInstrsMode.Rax rax-var rax-ty)
      instrs
      out)))

(define (compiler-backend-emit-block
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : i64]
  [blocks : CompilerIrBlockList]
  [block : CompilerIrBlock]
  [fallthrough : CompilerBackendMaybeLabel]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match block
    [(CompilerIrBlock.Block label instrs)
      (begin
        (set! compiler-backend-current-block-label label)
        ;; The block header goes in FIRST now that instructions append straight
        ;; into the body buffer. Both injection lookups and the label text are
        ;; pure reads of state frozen before emission (const-hoist-build! runs
        ;; per function, ahead of emit-blocks), so the bytes are identical to
        ;; the former "emit body, then concatenate the header in front" order.
        ;;
        ;; M-F: loop-hoisted constant loads registered for this block.
        ;; Before-label entries (header-is-entry-block loops) land at prologue
        ;; end, once per call; after-label entries run at a dedicated
        ;; preheader's start, once per loop entry. "" for every other block.
        ;; `compiler-backend-asm-label` is spelled out here so the label's four
        ;; parts land in the body buffer directly instead of through a fresh
        ;; per-block label String.
        (compiler-backend-asm-append
          out
          (compiler-backend-const-hoist-injection-for label true))
        (compiler-backend-asm-append5
          out
          ".L"
          (compiler-backend-asm-safe-symbol function)
          "_"
          (compiler-ir-label-text label)
          ":\n")
        (compiler-backend-asm-append
          out
          (compiler-backend-const-hoist-injection-for label false))
        (compiler-backend-emit-instrs
          (CompilerBackendEmissionContext
            type-segment-bases
            target
            function
            source-function
            blocks
            label
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            span-index
            func-diag
            use-counts)
          fallthrough
          (compiler-ir-instr-seq-to-list instrs)
          out))]))

;; Total IR instruction count over a function's blocks, read from the per-block
;; sequence lengths the emit loop already consults. Used only to size the body
;; buffer.
(define (compiler-backend-blocks-instr-count-seq
  [blocks : CompilerIrBlockSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler-ir-block-seq-count blocks))
    acc
    (compiler-backend-blocks-instr-count-seq
      blocks
      (+ index 1)
      (+
        acc
        (match (compiler-ir-block-seq-ref blocks index)
          [(CompilerIrBlock.Block _ instrs) (struct-get instrs len)])))))

(define (compiler-backend-blocks-instr-count [blocks : CompilerIrBlockList]) : i64
  (match blocks
    [(CompilerIrBlockList.Nil) 0]
    [(CompilerIrBlockList.Cons block rest)
      (+
        (match block
          [(CompilerIrBlock.Block _ instrs) (struct-get instrs len)])
        (compiler-backend-blocks-instr-count (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-blocks-instr-count-seq seq 0 0)]))

(define (compiler-backend-next-block-label [blocks : CompilerIrBlockList]) : CompilerBackendMaybeLabel
  (match blocks
    [(CompilerIrBlockList.Nil) (CompilerBackendMaybeLabel.No)]
    [(CompilerIrBlockList.Cons block _)
      (match block
        [(CompilerIrBlock.Block label _) (CompilerBackendMaybeLabel.Some label)])]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-next-block-label-seq seq 0)]))

(define (compiler-backend-next-block-label-seq
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : CompilerBackendMaybeLabel
  (if (>= index (compiler-ir-block-seq-count blocks))
    (CompilerBackendMaybeLabel.No)
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block label _) (CompilerBackendMaybeLabel.Some label)])))

(define (compiler-backend-emit-block-seq-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : i64]
  [all-blocks : CompilerIrBlockList]
  [blocks : CompilerIrBlockSeq]
  [index : i64]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (>= index (compiler-ir-block-seq-count blocks))
    (ResultCompilerBackend.Ok "")
    (let
      [block : CompilerIrBlock (compiler-ir-block-seq-ref blocks index)]
      [mark : i64 (compiler-backend-asm-buf-len (& out))]
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (set!
              compiler-backend-emit-instr-post-base
              (+ compiler-backend-emit-instr-post-base (struct-get instrs len)))])
        (match (compiler-backend-emit-block
          type-segment-bases
          target
          function
          source-function
          all-blocks
          block
          (compiler-backend-next-block-label-seq blocks (+ index 1))
          assignments
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          span-index
          func-diag
          use-counts
          out)
          [(ResultCompilerBackend.Ok _)
            (begin
              (compiler-backend-emergency-wrap-appended out mark)
              (compiler-backend-emit-block-seq-into
                type-segment-bases
                target
                function
                source-function
                all-blocks
                blocks
                (+ index 1)
                assignments
                vars
                types
                global-types
                ret-ty
                plan
                functions
                externs
                program-index
                spans
                span-index
                func-diag
                use-counts
                out))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])))))

(define (compiler-backend-emit-blocks-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : i64]
  [all-blocks : CompilerIrBlockList]
  [blocks : CompilerIrBlockList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match blocks
    [(CompilerIrBlockList.Nil) (ResultCompilerBackend.Ok "")]
    [(CompilerIrBlockList.Cons block rest)
      (let
        [mark : i64 (compiler-backend-asm-buf-len (& out))]
        (begin
          (match block
            [(CompilerIrBlock.Block _ instrs)
              (set!
                compiler-backend-emit-instr-post-base
                (+
                  compiler-backend-emit-instr-post-base
                  (struct-get instrs len)))])
          (match (compiler-backend-emit-block
            type-segment-bases
            target
            function
            source-function
            all-blocks
            block
            (compiler-backend-next-block-label (box-get rest))
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            span-index
            func-diag
            use-counts
            out)
            [(ResultCompilerBackend.Ok _)
              (begin
                (compiler-backend-emergency-wrap-appended out mark)
                (compiler-backend-emit-blocks-into
                  type-segment-bases
                  target
                  function
                  source-function
                  all-blocks
                  (box-get rest)
                  assignments
                  vars
                  types
                  global-types
                  ret-ty
                  plan
                  functions
                  externs
                  program-index
                  spans
                  span-index
                  func-diag
                  use-counts
                  out))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)])))]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-emit-block-seq-into
        type-segment-bases
        target
        function
        source-function
        all-blocks
        seq
        0
        assignments
        vars
        types
        global-types
        ret-ty
        plan
        functions
        externs
        program-index
        spans
        span-index
        func-diag
        use-counts
        out)]))

(define (compiler-backend-emit-blocks
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : i64]
  [all-blocks : CompilerIrBlockList]
  [blocks : CompilerIrBlockList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]) : ResultCompilerBackend
  ;; One body buffer per function: the whole block/instruction spine appends
  ;; into it and this is the single finish boundary, handing the pipeline the
  ;; same body String emit-blocks always returned.
  (let
    [out : CompilerBackendAsmBuf
      (compiler-backend-asm-buf-with-capacity
        (+
          compiler-backend-asm-seq-capacity
          (*
            (compiler-backend-blocks-instr-count blocks)
            compiler-backend-asm-bytes-per-instr)))]
    (match (compiler-backend-emit-blocks-into
      type-segment-bases
      target
      function
      source-function
      all-blocks
      blocks
      assignments
      vars
      types
      global-types
      ret-ty
      plan
      functions
      externs
      program-index
      spans
      span-index
      func-diag
      use-counts
      (&mut out))
      [(ResultCompilerBackend.Ok _)
        (ResultCompilerBackend.Ok (compiler-backend-asm-buf-finish (& out)))]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

;; Move INCOMING parameters into their local frame slots. Register
;; params come from rdi/rsi/.. (or xmm0..) per the calling convention; params
;; beyond a bank's registers are read back from the caller's stack frame at
;; `compiler-backend-incoming-stack-arg-offset`, indexed by a sequential
;; stack-param counter that mirrors the call site.
(define (compiler-backend-spmd-private-function? [name : i64]) : bool
  (or
    (compiler-backend-spmd-varying-return-function? name)
    (compiler-backend-spmd-mask-return-function? name)
    (compiler-backend-spmd-symbol-prefix? name "__tl_spmd_ret_uniform_")))

(define (compiler-backend-spmd-varying-param? [name : String]) : bool
  (compiler-backend-string-prefix-at? name "__tl_spmd_varying_arg_" 0))

(define (compiler-backend-spmd-mask-param? [name : String]) : bool
  (compiler-backend-string-prefix-at? name "__tl_spmd_mask_arg_" 0))

(define (compiler-backend-spmd-private-vector-arg-reg [index : i64]) : String
  (if (and (>= index 0) (< index 8))
    (string.append "%zmm" (string.int->string (+ 17 index)))
    ""))

(define (compiler-backend-spmd-private-mask-arg-reg [index : i64]) : String
  (if (and (>= index 0) (< index 5))
    (string.append "%k" (string.int->string (+ 2 index)))
    ""))

(define (compiler-backend-emit-spmd-private-special-param
  [assignments : CompilerRegAssignmentList]
  [name : String]
  [ty : AstType]
  [var-id : i64]
  [vector-index : i64]
  [mask-index : i64]) : ResultCompilerBackend
  (if (compiler-backend-var-never-used? var-id)
    (ResultCompilerBackend.Ok "")
    (if (compiler-backend-spmd-varying-param? name)
      (let
        [incoming : String
          (compiler-backend-spmd-private-vector-arg-reg vector-index)]
        (if (= (string.string-length incoming) 0)
          (ResultCompilerBackend.Err
            (box
              (compiler-diagnostic-at-start
                ""
                "backend: private AVX-512 SPMD call supports at most 8 varying value arguments")))
          (match (compiler-backend-emit-assignment-lookup assignments var-id)
            [(CompilerRegMaybeLocation.No) (ResultCompilerBackend.Ok "")]
            [(CompilerRegMaybeLocation.Some _)
              (match (compiler-backend-vector-var-reg
                assignments
                var-id
                "private SPMD helper parameter"
                "zmm")
                [(ResultBackendReg.Ok home)
                  (ResultCompilerBackend.Ok
                    (if (string.eq incoming home)
                      ""
                      (str_cat.str-cat
                        "    "
                        (compiler-backend-avx512-vector-move ty)
                        " "
                        incoming
                        ", "
                        home
                        "\n")))]
                [(ResultBackendReg.Err message)
                  (ResultCompilerBackend.Err
                    (box (compiler-diagnostic-at-start "" message)))])])))
      (let
        [incoming : String
          (if (string.eq name "__tl_spmd_active_mask")
            "%k1"
            (compiler-backend-spmd-private-mask-arg-reg mask-index))]
        (if (= (string.string-length incoming) 0)
          (ResultCompilerBackend.Err
            (box
              (compiler-diagnostic-at-start
                ""
                "backend: private AVX-512 SPMD call supports at most 5 varying bool arguments")))
          (match (compiler-backend-avx512-mask-dst-reg
            assignments
            var-id
            "private SPMD helper mask parameter"
            "%k7")
            [(ResultBackendReg.Ok home)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  (if (string.eq incoming home)
                    ""
                    (str_cat.str-cat "    kmovq " incoming ", " home "\n" ""))
                  (compiler-backend-avx512-mask-store-dst
                    assignments
                    var-id
                    64
                    home)
                  ""))]
            [(ResultBackendReg.Err message)
              (ResultCompilerBackend.Err
                (box (compiler-diagnostic-at-start "" message)))]))))))

(define (compiler-backend-emit-spmd-private-param-spills-from
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [assignments : CompilerRegAssignmentList]
  [params : CompilerIrParamList]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [stack-idx : i64]
  [vector-index : i64]
  [mask-index : i64]
  [vars : i64]) : ResultCompilerBackend
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) (ResultCompilerBackend.Ok "")]
    [(CompilerIrParamList.Array seq)
      (compiler-backend-emit-spmd-private-param-spills-from
        type-segment-bases
        target
        assignments
        (compiler-ir-param-seq-to-list seq)
        int-idx
        float-idx
        position
        stack-idx
        vector-index
        mask-index
        vars)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param name ty var-id)
          (let
            [active? : bool (string.eq name "__tl_spmd_active_mask")]
            [varying? : bool (compiler-backend-spmd-varying-param? name)]
            [mask? : bool (compiler-backend-spmd-mask-param? name)]
            [special? : bool (or active? varying? mask?)]
            [is-float : bool (compiler-backend-float-type? ty)]
            [on-stack : bool
              (if special?
                false
                (compiler-backend-stack-call-arg-for-banks?
                  target
                  is-float
                  int-idx
                  float-idx
                  position))]
            (match (if special?
              (compiler-backend-emit-spmd-private-special-param
                assignments
                name
                ty
                var-id
                vector-index
                mask-index)
              (if on-stack
                (ResultCompilerBackend.Ok
                  (let
                    [addr : String
                      (compiler-backend-frame-offset
                        (compiler-backend-incoming-stack-arg-offset
                          target
                          stack-idx))]
                    (if is-float
                      (compiler-backend-emit-load-float-address-to-var
                        assignments
                        var-id
                        addr
                        ty
                        "")
                      (compiler-backend-emit-load-scalar-address-to-var
                        type-segment-bases
                        assignments
                        var-id
                        addr
                        ty
                        (make-array String 0)
                        0
                        ""))))
                (match (if is-float
                  (compiler-backend-target-float-arg-reg-for-banks
                    target
                    float-idx
                    position)
                  (compiler-backend-target-arg-reg-for-banks
                    target
                    int-idx
                    position))
                  [(ResultBackendReg.Ok reg)
                    (ResultCompilerBackend.Ok
                      (compiler-backend-emit-store-typed-var-with-plan
                        assignments
                        var-id
                        reg
                        ty))]
                  [(ResultBackendReg.Err message)
                    (ResultCompilerBackend.Err
                      (box (compiler-diagnostic-at-start "" message)))])))
              [(ResultCompilerBackend.Ok head)
                (match (compiler-backend-emit-spmd-private-param-spills-from
                  type-segment-bases
                  target
                  assignments
                  (box-get rest)
                  (if (or special? is-float)
                    int-idx
                    (+ int-idx 1))
                  (if (or special? (not is-float))
                    float-idx
                    (+ float-idx 1))
                  (if special?
                    position
                    (+ position 1))
                  (if on-stack
                    (+ stack-idx 1)
                    stack-idx)
                  (if varying?
                    (+ vector-index 1)
                    vector-index)
                  (if mask?
                    (+ mask-index 1)
                    mask-index)
                  vars)
                  [(ResultCompilerBackend.Ok tail)
                    (ResultCompilerBackend.Ok (string.append head tail))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)]))])]))

(define (compiler-backend-emit-spmd-private-param-spills
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [assignments : CompilerRegAssignmentList]
  [params : CompilerIrParamList]
  [vars : i64]) : ResultCompilerBackend
  (compiler-backend-emit-spmd-private-param-spills-from
    type-segment-bases
    target
    assignments
    params
    0
    0
    0
    0
    0
    0
    vars))

(define (compiler-backend-emit-param-spills-from
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [assignments : CompilerRegAssignmentList]
  [all-params : CompilerIrParamList]
  [params : CompilerIrParamList]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [stack-idx : i64]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]) : ResultCompilerBackend
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) (ResultCompilerBackend.Ok "")]
    [(CompilerIrParamList.Array seq)
      (compiler-backend-emit-param-spills-from
        type-segment-bases
        target
        assignments
        all-params
        (compiler-ir-param-seq-to-list seq)
        int-idx
        float-idx
        position
        stack-idx
        program-index
        vars)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ ty var-id)
          (let
            [is-float : bool (compiler-backend-float-type? ty)]
            [next-int : i64
              (if is-float
                int-idx
                (+ int-idx 1))]
            [next-float : i64
              (if is-float
                (+ float-idx 1)
                float-idx)]
            ;; A register-group parameter occupies two eightbytes.
            ;; INTEGER words advance the integer bank; SSE words advance the float
            ;; bank. This mirrors emit-call-args so self-calls agree on register vs
            ;; stack placement for mixed-bank aggregate words.
            (if (compiler-backend-group-type?
              type-segment-bases
              program-index
              ty)
              (let
                [w0-sse : bool
                  (compiler-backend-group-word-sse?
                    type-segment-bases
                    program-index
                    ty
                    0)]
                [w0-stack : bool
                  (compiler-backend-stack-call-arg-for-banks?
                    target
                    w0-sse
                    int-idx
                    float-idx
                    position)]
                [int1 : i64
                  (if w0-sse
                    int-idx
                    (+ int-idx 1))]
                [float1 : i64
                  (if w0-sse
                    (+ float-idx 1)
                    float-idx)]
                [stack1 : i64
                  (if w0-stack
                    (+ stack-idx 1)
                    stack-idx)]
                [w1-sse : bool
                  (compiler-backend-group-word-sse?
                    type-segment-bases
                    program-index
                    ty
                    1)]
                [w1-stack : bool
                  (compiler-backend-stack-call-arg-for-banks?
                    target
                    w1-sse
                    int1
                    float1
                    (+ position 1))]
                (match (compiler-backend-emit-group-word-param
                  type-segment-bases
                  target
                  assignments
                  var-id
                  0
                  int-idx
                  float-idx
                  position
                  stack-idx
                  vars
                  ty
                  program-index)
                  [(ResultCompilerBackend.Ok head0)
                    (match (compiler-backend-emit-group-word-param
                      type-segment-bases
                      target
                      assignments
                      var-id
                      1
                      int1
                      float1
                      (+ position 1)
                      stack1
                      vars
                      ty
                      program-index)
                      [(ResultCompilerBackend.Ok head1)
                        (match (compiler-backend-emit-param-spills-from
                          type-segment-bases
                          target
                          assignments
                          all-params
                          (box-get rest)
                          (if w1-sse
                            int1
                            (+ int1 1))
                          (if w1-sse
                            (+ float1 1)
                            float1)
                          (+ position 2)
                          (if w1-stack
                            (+ stack1 1)
                            stack1)
                          program-index
                          vars)
                          [(ResultCompilerBackend.Ok tail)
                            (ResultCompilerBackend.Ok
                              (string.append head0 (string.append head1 tail)))]
                          [(ResultCompilerBackend.Err message)
                            (ResultCompilerBackend.Err message)])]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err message)])]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)]))
              (if (compiler-backend-stack-call-arg-for-banks?
                target
                is-float
                int-idx
                float-idx
                position)
                (match (compiler-backend-emit-param-spills-from
                  type-segment-bases
                  target
                  assignments
                  all-params
                  (box-get rest)
                  next-int
                  next-float
                  (+ position 1)
                  (+ stack-idx 1)
                  program-index
                  vars)
                  [(ResultCompilerBackend.Ok tail)
                    (ResultCompilerBackend.Ok
                      (let
                        [addr : String
                          (compiler-backend-frame-offset
                            (compiler-backend-incoming-stack-arg-offset
                              target
                              stack-idx))]
                        [exclude-n : i64
                          (compiler-backend-param-register-exclude-count
                            all-params
                            assignments)]
                        [exclude : (Array String)
                          (compiler-backend-param-register-exclude
                            all-params
                            assignments)]
                        (str-cat
                          (if is-float
                            (compiler-backend-emit-load-float-address-to-var
                              assignments
                              var-id
                              addr
                              ty
                              "")
                            (compiler-backend-emit-load-scalar-address-to-var
                              type-segment-bases
                              assignments
                              var-id
                              addr
                              ty
                              exclude
                              exclude-n
                              ""))
                          tail)))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])
                (match (if is-float
                  (compiler-backend-target-float-arg-reg-for-banks
                    target
                    float-idx
                    position)
                  (compiler-backend-target-arg-reg-for-banks
                    target
                    int-idx
                    position))
                  [(ResultBackendReg.Ok reg)
                    (match (compiler-backend-emit-param-spills-from
                      type-segment-bases
                      target
                      assignments
                      all-params
                      (box-get rest)
                      next-int
                      next-float
                      (+ position 1)
                      stack-idx
                      program-index
                      vars)
                      [(ResultCompilerBackend.Ok tail)
                        (ResultCompilerBackend.Ok
                          (string.append
                            (compiler-backend-emit-store-typed-var-with-plan
                              assignments
                              var-id
                              reg
                              ty)
                            tail))]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err message)])]
                  [(ResultBackendReg.Err _)
                    (ResultCompilerBackend.Err
                      (box
                        (compiler-diagnostic-at-start
                          ""
                          "backend: too many params")))]))))])]))

(define (compiler-backend-emit-param-spills
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [assignments : CompilerRegAssignmentList]
  [params : CompilerIrParamList]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [stack-idx : i64]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]) : ResultCompilerBackend
  (compiler-backend-emit-param-spills-from
    type-segment-bases
    target
    assignments
    params
    params
    int-idx
    float-idx
    position
    stack-idx
    program-index
    vars))

(define (compiler-backend-emit-windows-main-argv-capture
  [target : CompilerBackendTarget]
  [name : String]
  [emit-entry : bool]
  [plan : CompilerBackendRuntimePlan]) : String
  (if (and
    emit-entry
    (compiler-backend-target-windows? target)
    (string.eq name "main"))
    (let
      [_ : CompilerBackendRuntimePlan plan]
      "    movq %rcx, .L_tl_argc(%rip)
    movq %rdx, .L_tl_argv(%rip)
")
    ""))

(define (compiler-backend-emit-linux-crt-main-argv-capture
  [target : CompilerBackendTarget]
  [name : String]
  [crt-entry : bool]
  [plan : CompilerBackendRuntimePlan]) : String
  (if (and
    crt-entry
    (compiler-backend-target-linux? target)
    (string.eq name "main"))
    (let
      [_ : CompilerBackendRuntimePlan plan]
      "    movq %rdi, .L_tl_argc(%rip)
    movq %rsi, .L_tl_argv(%rip)
    movq %rdx, .L_tl_envp(%rip)
")
    ""))

;; ============================================================================
;; Register scavenger -- per-instruction occupied-register masks computed on the
;; FINAL post-rewrite IR (emit-blocks-list + assignments + slot-vars). The
;; backend uses this query to pick allocator-owned scratch registers, and
;; --cfg scavenge-self-check verifies the masks against liveness.
;;
;; Point space matches compiler-reg-live-intervals EXACTLY: the global I-th
;; emitted instruction (block-list order, then instr-seq order) lives at point
;; = 2*I. The self-check walks the same traversal, so the mapping is consistent
;; by construction; the checks below catch any divergence loudly via panic.
;; Does var v occupy `reg` (the register itself, or either half of a pair)?
;; Character-dispatch register-name -> scavenge bit. The scavenger queries
;; this per emitted operand; the string.eq ladder paid up to eighteen string
;; compares per call. Length plus three character reads decide every case.
;; Unknown names map to 0.
(define (compiler-backend-scavenge-reg-bit [reg : String]) : i64
  (let
    [n : i64 (string.string-length reg)]
    (cond
      [(or (< n 3) (> n 5)) 0]
      [(not (= (string.string-ref reg 0) '%')) 0]
      [(= n 3)
        (if (= (string.string-ref reg 1) 'r')
          (cond
            [(= (string.string-ref reg 2) '9') 1]
            [(= (string.string-ref reg 2) '8') 32]
            [else 0])
          0)]
      [(= n 4)
        (if (= (string.string-ref reg 1) 'r')
          (let
            [c2 : char (string.string-ref reg 2)]
            [c3 : char (string.string-ref reg 3)]
            (cond
              [(= c2 'c')
                (if (= c3 'x')
                  2
                  0)]
              [(= c2 'd') (cond [(= c3 'x') 4] [(= c3 'i') 131072] [else 0])]
              [(= c2 'a')
                (if (= c3 'x')
                  32768
                  0)]
              [(= c2 's')
                (if (= c3 'i')
                  65536
                  0)]
              [(= c2 'b')
                (if (= c3 'x')
                  1024
                  0)]
              [(= c2 '1')
                (cond
                  [(= c3 '0') 8]
                  [(= c3 '1') 16]
                  [(= c3 '2') 64]
                  [(= c3 '3') 128]
                  [(= c3 '4') 256]
                  [(= c3 '5') 512]
                  [else 0])]
              [else 0]))
          0)]
      [else
        (let
          [c1 : char (string.string-ref reg 1)]
          [c2 : char (string.string-ref reg 2)]
          [c3 : char (string.string-ref reg 3)]
          (if (or
            (and (or (= c1 'x') (= c1 'y') (= c1 'z')) (= c2 'm') (= c3 'm'))
            (and (= c1 'v') (= c2 'e') (= c3 'c')))
            (cond
              [(= (string.string-ref reg 4) '2') 2048]
              [(= (string.string-ref reg 4) '3') 4096]
              [(= (string.string-ref reg 4) '4') 8192]
              [(= (string.string-ref reg 4) '5') 16384]
              [else 0])
            0))])))

(define (compiler-backend-scavenge-emergency-reg-supported? [reg : String]) : bool
  (or
    (string.eq reg "%rax")
    (not (= (compiler-backend-scavenge-reg-bit reg) 0))))

(define compiler-backend-scavenge-reg-bit-count : i64
  18)

(define (compiler-backend-scavenge-reg-bit-by-index [index : i64]) : i64
  (cond
    [(= index 0) 1]
    [(= index 1) 2]
    [(= index 2) 4]
    [(= index 3) 8]
    [(= index 4) 16]
    [(= index 5) 32]
    [(= index 6) 64]
    [(= index 7) 128]
    [(= index 8) 256]
    [(= index 9) 512]
    [(= index 10) 1024]
    [(= index 11) 2048]
    [(= index 12) 4096]
    [(= index 13) 8192]
    [(= index 14) 16384]
    [(= index 15) 32768]
    [(= index 16) 65536]
    [(= index 17) 131072]
    [else 0]))

(define (compiler-backend-scavenge-location-mask
  [location : CompilerRegLocation]) : i64
  (match location
    [(CompilerRegLocation.Register reg) (compiler-backend-scavenge-reg-bit reg)]
    [(CompilerRegLocation.RegisterPair a b)
      (bit-or
        (compiler-backend-scavenge-reg-bit a)
        (compiler-backend-scavenge-reg-bit b))]
    [_ 0]))

(define (compiler-backend-scavenge-mask-bit-count [mask : i64]) : i64
  (let
    [bit-index : i64 0]
    [count : i64 0]
    (begin
      (while (< bit-index compiler-backend-scavenge-reg-bit-count)
        (let
          [bit : i64 (compiler-backend-scavenge-reg-bit-by-index bit-index)]
          (begin
            (if (not (= (bit-and mask bit) 0))
              (set! count (+ count 1))
              unit)
            (set! bit-index (+ bit-index 1)))))
      count)))

(define (compiler-backend-scavenge-occupancy-event-capacity
  [starts : (Array i64)]
  [ends : (Array i64)]
  [present : (Array i64)]
  [items : (Array CompilerRegLocation)]
  [limit : i64]
  [vars : i64]
  [instr-count : i64]) : i64
  (let
    [v : i64 0]
    [events : i64 0]
    (begin
      (while (< v vars)
        (begin
          (if (and
            (< v limit)
            (not (= (array-ref present v) 0))
            (>= (array-ref starts v) 0)
            (>= (array-ref ends v) 0))
            (let
              [loc-mask : i64
                (compiler-backend-scavenge-location-mask (array-ref items v))]
              [start-i : i64 (/ (array-ref starts v) 2)]
              [raw-end-i : i64 (/ (array-ref ends v) 2)]
              [end-i : i64
                (if (>= raw-end-i instr-count)
                  (- instr-count 1)
                  raw-end-i)]
              (if (and (not (= loc-mask 0)) (<= start-i end-i))
                (set!
                  events
                  (+
                    events
                    (* 2 (compiler-backend-scavenge-mask-bit-count loc-mask))))
                unit))
            unit)
          (set! v (+ v 1))))
      (if (< events 1)
        1
        events))))

(define (compiler-backend-scavenge-exclude-mask
  [exclude : (Array String)]
  [n : i64]) : i64
  (let
    [i : i64 0]
    [mask : i64 0]
    (begin
      (while (< i n)
        (begin
          (set!
            mask
            (bit-or
              mask
              (compiler-backend-scavenge-reg-bit (array-ref exclude i))))
          (set! i (+ i 1))))
      mask)))

(define (compiler-backend-scavenge-occupancy-instr-count
  [ends : (Array i64)]
  [vars : i64]) : i64
  (let
    [v : i64 0]
    [max-end : i64 0]
    (begin
      (while (< v vars)
        (begin
          (if (>= (array-ref ends v) 0)
            (let
              [end-i : i64 (/ (array-ref ends v) 2)]
              (if (> end-i max-end)
                (set! max-end end-i)
                unit))
            unit)
          (set! v (+ v 1))))
      (+ max-end 1))))

(define (compiler-backend-scavenge-occupancy-add-event!
  [heads : (Array i64)]
  [event-bits : (Array i64)]
  [event-deltas : (Array i64)]
  [event-next : (Array i64)]
  [event : i64]
  [bit-index : i64]
  [delta : i64]
  [used : i64]) : i64
  (if (or
    (< event 0)
    (>= event (array-length heads))
    (>= used (array-length event-bits)))
    used
    (begin
      (array-set! event-bits used bit-index)
      (array-set! event-deltas used delta)
      (array-set! event-next used (array-ref heads event))
      (array-set! heads event used)
      (+ used 1))))

(define (compiler-backend-scavenge-occupancy-add-mask-events!
  [heads : (Array i64)]
  [event-bits : (Array i64)]
  [event-deltas : (Array i64)]
  [event-next : (Array i64)]
  [event : i64]
  [mask : i64]
  [delta : i64]
  [used : i64]) : i64
  (let
    [bit-index : i64 0]
    [out : i64 used]
    (begin
      (while (< bit-index compiler-backend-scavenge-reg-bit-count)
        (let
          [bit : i64 (compiler-backend-scavenge-reg-bit-by-index bit-index)]
          (begin
            (if (not (= (bit-and mask bit) 0))
              (set!
                out
                (compiler-backend-scavenge-occupancy-add-event!
                  heads
                  event-bits
                  event-deltas
                  event-next
                  event
                  bit-index
                  delta
                  out))
              unit)
            (set! bit-index (+ bit-index 1)))))
      out)))

(define (compiler-backend-scavenge-occupancy-add-range!
  [heads : (Array i64)]
  [event-bits : (Array i64)]
  [event-deltas : (Array i64)]
  [event-next : (Array i64)]
  [start-i : i64]
  [end-i : i64]
  [mask : i64]
  [used : i64]) : i64
  (compiler-backend-scavenge-occupancy-add-mask-events!
    heads
    event-bits
    event-deltas
    event-next
    (+ end-i 1)
    mask
    (- 0 1)
    (compiler-backend-scavenge-occupancy-add-mask-events!
      heads
      event-bits
      event-deltas
      event-next
      start-i
      mask
      1
      used)))

(define (compiler-backend-scavenge-occupancy-mask-at-event
  [heads : (Array i64)]
  [event-bits : (Array i64)]
  [event-deltas : (Array i64)]
  [event-next : (Array i64)]
  [active-counts : (Array i64)]
  [event : i64]) : i64
  (let
    [node : i64 (array-ref heads event)]
    [_apply-events : unit
      (while (>= node 0)
        (let
          [bit-index : i64 (array-ref event-bits node)]
          [next : i64
            (+
              (array-ref active-counts bit-index)
              (array-ref event-deltas node))]
          (begin
            (array-set! active-counts bit-index next)
            (set! node (array-ref event-next node)))))]
    [bit-index : i64 0]
    [mask : i64 0]
    (begin
      (while (< bit-index compiler-backend-scavenge-reg-bit-count)
        (begin
          (if (> (array-ref active-counts bit-index) 0)
            (set!
              mask
              (bit-or
                mask
                (compiler-backend-scavenge-reg-bit-by-index bit-index)))
            unit)
          (set! bit-index (+ bit-index 1))))
      mask)))

(define (compiler-backend-scavenge-occupancy-build
  [starts : (Array i64)]
  [ends : (Array i64)]
  [assignment-index : CompilerRegAssignmentIndex]
  [vars : i64]) : (Array i64)
  (let
    [instr-count : i64
      (compiler-backend-scavenge-occupancy-instr-count ends vars)]
    [event-count : i64 (+ instr-count 1)]
    [heads : (Array i64) (make-array i64 event-count)]
    [present : (Array i64) (struct-get assignment-index present)]
    [items : (Array CompilerRegLocation) (struct-get assignment-index items)]
    [limit : i64 (array-length present)]
    [max-events : i64
      (compiler-backend-scavenge-occupancy-event-capacity
        starts
        ends
        present
        items
        limit
        vars
        instr-count)]
    [event-bits : (Array i64) (make-array i64 max-events)]
    [event-deltas : (Array i64) (make-array i64 max-events)]
    [event-next : (Array i64) (make-array i64 max-events)]
    [out : (Array i64) (make-array i64 instr-count)]
    [active-counts : (Array i64)
      (make-array i64 compiler-backend-scavenge-reg-bit-count)]
    [v : i64 0]
    [event-used : i64 0]
    (begin
      (compiler-reg-fill-i64-array heads (- 0 1))
      (compiler-reg-fill-i64-array event-next (- 0 1))
      (while (< v vars)
        (begin
          (if (and
            (< v limit)
            (not (= (array-ref present v) 0))
            (>= (array-ref starts v) 0)
            (>= (array-ref ends v) 0))
            (let
              [loc-mask : i64
                (compiler-backend-scavenge-location-mask (array-ref items v))]
              [start-i : i64 (/ (array-ref starts v) 2)]
              [raw-end-i : i64 (/ (array-ref ends v) 2)]
              [end-i : i64
                (if (>= raw-end-i instr-count)
                  (- instr-count 1)
                  raw-end-i)]
              (if (and (not (= loc-mask 0)) (<= start-i end-i))
                (set!
                  event-used
                  (compiler-backend-scavenge-occupancy-add-range!
                    heads
                    event-bits
                    event-deltas
                    event-next
                    start-i
                    end-i
                    loc-mask
                    event-used))
                unit))
            unit)
          (set! v (+ v 1))))
      (let
        [i : i64 0]
        (begin
          (while (< i instr-count)
            (begin
              (array-set!
                out
                i
                (compiler-backend-scavenge-occupancy-mask-at-event
                  heads
                  event-bits
                  event-deltas
                  event-next
                  active-counts
                  i))
              (set! i (+ i 1))))
          out)))))

(define (compiler-backend-scavenge-reg-free-in-mask?
  [occupied-mask : i64]
  [reg : String]) : bool
  (= (bit-and occupied-mask (compiler-backend-scavenge-reg-bit reg)) 0))

(define (compiler-backend-var-register-home-index
  [assignment-index : CompilerRegAssignmentIndex]
  [var : i64]) : String
  (compiler-reg-assignment-index-primary-register-home assignment-index var))

(defstruct CompilerBackendScavengeAssignmentIndex
  (index CompilerRegAssignmentIndex)
  (plan-mask i64))

(define (compiler-backend-scavenge-assignment-index-fill!
  [assignments : CompilerRegAssignmentList]
  [present : (Array i64)]
  [items : (Array CompilerRegLocation)]
  [mask : i64]) : i64
  (match assignments
    [(CompilerRegAssignmentList.Nil) mask]
    [(CompilerRegAssignmentList.Cons item rest)
      (match item
        [(CompilerRegAssignment.Assignment var location)
          (compiler-backend-scavenge-assignment-index-fill!
            (box-get rest)
            present
            items
            (if (or
              (< var 0)
              (>= var (array-length present))
              (not (= (array-ref present var) 0)))
              mask
              (let
                [loc-mask : i64
                  (compiler-backend-scavenge-location-mask location)]
                (begin
                  (array-set! present var 1)
                  (array-set! items var location)
                  (bit-or mask loc-mask)))))])]))

(define (compiler-backend-scavenge-assignment-index-build
  [assignments : CompilerRegAssignmentList]
  [vars : i64]) : CompilerBackendScavengeAssignmentIndex
  (let
    [n : i64
      (if (< vars 1)
        1
        vars)]
    [present : (Array i64) (make-array i64 n)]
    [items : (Array CompilerRegLocation) (make-array CompilerRegLocation n)]
    (begin
      (compiler-reg-fill-location-array items (CompilerRegLocation.Spill 0))
      (let
        [plan-mask : i64
          (compiler-backend-scavenge-assignment-index-fill!
            assignments
            present
            items
            0)]
        (CompilerBackendScavengeAssignmentIndex
          (CompilerRegAssignmentIndex present items)
          plan-mask)))))

(define (compiler-backend-assignments-have-register-home?
  [assignments : CompilerRegAssignmentList]) : bool
  (match assignments
    [(CompilerRegAssignmentList.Nil) false]
    [(CompilerRegAssignmentList.Cons item rest)
      (match item
        [(CompilerRegAssignment.Assignment _ location)
          (match location
            [(CompilerRegLocation.Register _) true]
            [(CompilerRegLocation.RegisterPair _ _) true]
            [_
              (compiler-backend-assignments-have-register-home? (box-get rest))])])]))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-free-for-instr?
    [starts : (Array i64)]
    [ends : (Array i64)]
    [assignment-index : CompilerRegAssignmentIndex]
    [vars : i64]
    [point : i64]
    [reg : String]) : bool
    (compiler-reg-assignment-index-register-free-over-range?
      starts
      ends
      assignment-index
      vars
      point
      (+ point 1)
      reg)))

;; Register scavenger context (step 15b). Holds the FINAL-IR per-var live
;; intervals + assignments for the function currently being emitted, so the
;; backend can ask which physical register is free at an instruction's point
;; instead of hardcoding scratch. Installed once per function (read-only).
(define compiler-backend-scavenge-ctx-starts : (Array i64)
  (make-array i64 1))
(define compiler-backend-scavenge-ctx-ends : (Array i64)
  (make-array i64 1))

(define (compiler-backend-scavenge-empty-assignments) : CompilerRegAssignmentList
  CompilerRegAssignmentList.Nil)

(define compiler-backend-scavenge-ctx-assignment-index : CompilerRegAssignmentIndex
  (compiler-reg-assignment-index-build
    (compiler-backend-scavenge-empty-assignments)
    1))
(define compiler-backend-scavenge-ctx-plan-reg-mask : i64
  0)
(define compiler-backend-scavenge-ctx-occupied-masks : (Array i64)
  (make-array i64 1))
(define compiler-backend-scavenge-ctx-scratch-masks : (Array i64)
  (make-array i64 1))
(define compiler-backend-scavenge-ctx-vars : i64
  0)

;; Forward span (in point units; each instruction step is +2) that a scavenged
;; STAGING register is queried across, beyond its emit position. Loads sharing a
;; base register fuse into one emit step but the lowering numbers their def points
;; in REVERSE offset order, so a register-homed sibling carries an interval point
;; AHEAD of a spilled sibling's staging that is nonetheless emitted into its home
;; BEFORE it. Covering point + 2*(K-1) for the deepest K-field aggregate the
;; compiler binds-and-loads in one arm keeps every reordered sibling OCCUPIED in
;; the query so the staging scratch never clobbers it. See
;; compiler-backend-scavenge-reg.
(define compiler-backend-scavenge-staging-window : i64
  16)

(define (compiler-backend-scavenge-occupied-mask-at-point [point : i64]) : i64
  (let
    [masks : (Array i64) compiler-backend-scavenge-ctx-occupied-masks]
    [idx : i64
      (if (< point 0)
        -1
        (/ point 2))]
    (if (and (>= idx 0) (< idx (array-length masks)))
      (array-ref masks idx)
      0)))

;; Union the occupancy masks across every instruction event in [lo, hi] (point
;; coordinates; each event is point/2). A scavenge's staging scratch register
;; (e.g. a spilled load: `mov addr,scratch` then `mov scratch,spill`) is live not
;; only at the emit position but through the immediately following emission. A
;; FUSED destructure loads its fields in offset order while the lowering assigns
;; their interval points in the REVERSE order, so a register-homed sibling field
;; is emitted into its home one step BEFORE a spilled field's staging load yet
;; carries the HIGHER interval point (point+2). A single-point query at the emit
;; position read that register "free" and the scratch clobbered the just-loaded
;; sibling. ORing [point, point+2] keeps the emit-position endpoint (so a gep
;; operand live only at the instruction start is still protected) and adds the
;; next-step endpoint (so the reordered fused sibling is too). Scratch-plan
;; pseudo-vars are different: their modeled lifetime is the requirement range,
;; and a temporary in a later instruction cannot be clobbered by an earlier
;; staging sequence that has already ended. Keep planned scratch in the mask at
;; `lo`, but subtract it from later window samples; otherwise every future call
;; or phi slot lengthens unrelated legacy staging and creates emergency wraps.
(define (compiler-backend-scavenge-occupied-mask-over-range
  [lo : i64]
  [hi : i64]) : i64
  (let
    [masks : (Array i64) compiler-backend-scavenge-ctx-occupied-masks]
    [scratch-masks : (Array i64) compiler-backend-scavenge-ctx-scratch-masks]
    [count : i64 (array-length masks)]
    [lo-idx : i64
      (if (< lo 0)
        0
        (/ lo 2))]
    [hi-idx : i64
      (if (< hi 0)
        0
        (/ hi 2))]
    [i : i64 lo-idx]
    [acc : i64 0]
    (begin
      (while (<= i hi-idx)
        (begin
          (if (and (>= i 0) (< i count))
            (let
              [occupied : i64 (array-ref masks i)]
              [without-future-scratch : i64
                (if (or (= i lo-idx) (>= i (array-length scratch-masks)))
                  occupied
                  (bit-and occupied (bit-xor (array-ref scratch-masks i) -1)))]
              (set! acc (bit-or acc without-future-scratch)))
            unit)
          (set! i (+ i 1))))
      acc)))

;; Shrink-wrapping is assembled with three textual splices.  A missing needle
;; must fail closed: the caller re-emits the original function with the
;; early-exit rewrite disabled, restoring the ordinary always-framed path.
;; Each admitted replacement changes the byte length (the incoming guard,
;; saving prologue, and selected prologue all differ from their needles), so
;; length equality is a cheap, allocation-free proof that a splice did not
;; fire.
(define (compiler-backend-shrinkwrap-splice-fallback-required?
  [active? : bool]
  [body : String]
  [guarded-body : String]
  [framed-body : String]
  [final-body : String]
  [emitted-body : String]) : bool
  (and
    active?
    (or
      (= (string.string-length body) (string.string-length guarded-body))
      (= (string.string-length guarded-body) (string.string-length framed-body))
      (= (string.string-length final-body) (string.string-length emitted-body)))))

(define (compiler-backend-set-scavenge-ctx-ready!
  [starts : (Array i64)]
  [ends : (Array i64)]
  [assignment-index : CompilerRegAssignmentIndex]
  [plan-mask : i64]
  [occupied-masks : (Array i64)]
  [vars : i64]) : unit
  (begin
    (set! compiler-backend-scavenge-ctx-starts starts)
    (set! compiler-backend-scavenge-ctx-ends ends)
    (set! compiler-backend-scavenge-ctx-assignment-index assignment-index)
    (set! compiler-backend-scavenge-ctx-plan-reg-mask plan-mask)
    (set!
      compiler-backend-scavenge-ctx-scratch-masks
      (array.make-array i64 (array-length occupied-masks)))
    (set! compiler-backend-scavenge-ctx-occupied-masks occupied-masks)
    (set! compiler-backend-scavenge-ctx-vars vars)))

(define (compiler-backend-set-scavenge-ctx-index!
  [starts : (Array i64)]
  [ends : (Array i64)]
  [assignment-index : CompilerRegAssignmentIndex]
  [plan-mask : i64]
  [vars : i64]) : unit
  (let
    [occupied-masks : (Array i64)
      (compiler-backend-scavenge-occupancy-build
        starts
        ends
        assignment-index
        vars)]
    (compiler-backend-set-scavenge-ctx-ready!
      starts
      ends
      assignment-index
      plan-mask
      occupied-masks
      vars)))

(define (compiler-backend-set-scavenge-ctx!
  [starts : (Array i64)]
  [ends : (Array i64)]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]) : unit
  (match (compiler-backend-scavenge-assignment-index-build assignments vars)
    [(CompilerBackendScavengeAssignmentIndex assignment-index plan-mask)
      (compiler-backend-set-scavenge-ctx-index!
        starts
        ends
        assignment-index
        plan-mask
        vars)]))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-seed-block-liveins
    [blocks : CompilerIrBlockList]
    [liveness : CompilerFunctionLiveness]
    [point : i64]
    [starts : (Array i64)]
    [ends : (Array i64)]) : i64
    (match blocks
      [(CompilerIrBlockList.Nil) point]
      [(CompilerIrBlockList.Cons block rest)
        (match block
          [(CompilerIrBlock.Block label instrs)
            (let
              [live-afters : CompilerLiveInstrSetVec
                (compiler-reg-live-intervals-find-afters liveness label)]
              [after-items : (Array CompilerLiveI64Set)
                (struct-get live-afters items)]
              [count : i64 (struct-get instrs len)]
              (begin
                (if (> count 0)
                  (compiler-reg-extend-set-words
                    starts
                    ends
                    (if (> (array-length after-items) 0)
                      (array-ref after-items 0)
                      (compiler-live-set-empty))
                    0
                    point)
                  unit)
                (compiler-backend-scavenge-seed-block-liveins
                  (box-get rest)
                  liveness
                  (+ point (* 2 count))
                  starts
                  ends)))])]
      [(CompilerIrBlockList.Array seq)
        ;; cfg-gated self-check only; normal emission installs scavenge state
        ;; from interval arrays and stays on the dense block path.
        (compiler-backend-scavenge-seed-block-liveins
          (compiler-ir-block-seq-to-list seq)
          liveness
          point
          starts
          ends)])))

(define (compiler-backend-scavenge-install-ctx-from-intervals!
  [slot-vars : i64]
  [assignments : CompilerRegAssignmentList]
  [intervals : CompilerRegIntervalSeq]) : unit
  (begin
    (set! compiler-backend-emit-instr-post-base 0)
    (if (< slot-vars 1)
      (compiler-backend-set-scavenge-ctx!
        (make-array i64 1)
        (make-array i64 1)
        assignments
        0)
      (match (compiler-backend-scavenge-assignment-index-build
        assignments
        slot-vars)
        [(CompilerBackendScavengeAssignmentIndex assignment-index plan-mask)
          (let
            [interval-index : CompilerRegIntervalIndex
              (compiler-reg-interval-index-build intervals slot-vars)]
            [starts : (Array i64) (struct-get interval-index starts)]
            [ends : (Array i64) (struct-get interval-index ends)]
            (compiler-backend-set-scavenge-ctx-ready!
              starts
              ends
              assignment-index
              plan-mask
              (compiler-backend-scavenge-occupancy-build
                starts
                ends
                assignment-index
                slot-vars)
              slot-vars))]))))

(define (compiler-backend-scavenge-excluded?
  [exclude : (Array String)]
  [n : i64]
  [reg : String]) : bool
  (let
    [i : i64 0]
    [hit : bool false]
    (begin
      (while (and (< i n) (not hit))
        (begin
          (if (string.eq (array-ref exclude i) reg)
            (set! hit true)
            unit)
          (set! i (+ i 1))))
      hit)))

;; Exclude set for binop scavenging: a safe superset of every binop op's fixed
;; registers (div/mul: rax/rdx; shift: rcx; fallback binops: rax=lhs). Pooled
;; scratch registers such as r10/r11 must stay available to the scavenger.
(define (compiler-backend-binop-scavenge-exclude-build) : (Array String)
  (make-array "%rax" "%rdx" "%rcx" "" ""))

;; Op-specific scavenge exclude: only the registers THIS op actually clobbers
;; (beyond operand/dst homes, excluded separately). The over-broad superset
;; excluded rcx+rdx for every op, removing them as scratch candidates even for
;; add/sub/and/or/xor/cmp that don't touch them -> needless degradation to the
;; fallback. Returns a size-5 array (padded with zero-bit empty-string sentinels).
;; div/mod -> rax:rdx, mul -> rax/rdx, shift -> rcx, everything else -> nothing extra.
(define (compiler-backend-binop-scavenge-exclude-for-op [op : CompilerIrBinOp]) : (Array
    String)
  (let
    [rax-extra : String
      (match op
        [(CompilerIrBinOp.Div) "%rax"]
        [(CompilerIrBinOp.Mod) "%rax"]
        [(CompilerIrBinOp.SafeDiv) "%rax"]
        [(CompilerIrBinOp.SafeMod) "%rax"]
        [(CompilerIrBinOp.Mul) "%rax"]
        [_ ""])]
    [extra : String
      (match op
        [(CompilerIrBinOp.Div) "%rdx"]
        [(CompilerIrBinOp.Mod) "%rdx"]
        [(CompilerIrBinOp.SafeDiv) "%rdx"]
        [(CompilerIrBinOp.SafeMod) "%rdx"]
        [(CompilerIrBinOp.Shl) "%rcx"]
        [(CompilerIrBinOp.Shr) "%rcx"]
        [(CompilerIrBinOp.Mul) "%rdx"]
        [_ ""])]
    (make-array rax-extra extra "" "" "")))

;; Constant/magic-division 3-scratch discipline. The magic multiply needs a
;; scratch for the magic constant, a saved-dividend register read back for the
;; remainder, and a sign-mask register for signed cases. All three must be
;; mutually distinct and distinct from %rax/%rdx (the multiply/idiv clobbers).
;; The freeness query cannot see a sibling scratch's transient use at the same
;; point, so each scavenge excludes the already-picked regs. The sibling fallback
;; registers themselves stay available unless they were actually picked.
(define (compiler-backend-divmod-dividend-exclude [magic : String]) : (Array
    String)
  (make-array "%rax" "%rdx" "" "" magic))

(define (compiler-backend-divmod-mask-exclude
  [magic : String]
  [dividend : String]) : (Array String)
  (make-array "%rax" "%rdx" "" "" magic dividend))

;; Append one register to an exclude array (returns a fresh size-(n+1) array).
(define (compiler-backend-scavenge-exclude-append
  [exclude : (Array String)]
  [n : i64]
  [extra : String]) : (Array String)
  (let
    [a : (Array String) (make-array String (+ n 1))]
    [i : i64 0]
    (begin
      (while (< i n)
        (begin
          (array-set! a i (array-ref exclude i))
          (set! i (+ i 1))))
      (array-set! a n extra)
      a)))

;; Concatenate two exclude arrays into a fresh array.
(define (compiler-backend-scavenge-exclude-merge
  [left : (Array String)]
  [left-n : i64]
  [right : (Array String)]
  [right-n : i64]) : (Array String)
  (let
    [a : (Array String) (make-array String (+ left-n right-n))]
    [i : i64 0]
    [j : i64 0]
    (begin
      (while (< i left-n)
        (begin
          (array-set! a i (array-ref left i))
          (set! i (+ i 1))))
      (while (< j right-n)
        (begin
          (array-set! a (+ left-n j) (array-ref right j))
          (set! j (+ j 1))))
      a)))

;; Exclude set = the HW-fixed regs PLUS the home registers of two source operands.
;; Robustly prevents a scavenged scratch from clobbering an operand whose value is
;; needed by THIS instruction (e.g. a loop-invariant base/src whose register the
;; liveness query may not see occupied at the scavenge point). Non-register-homed
;; operands map to the zero-bit empty-string sentinel. Pooled scratch registers
;; such as r10/r11 stay available unless one is an operand home. n = 7.
(define (compiler-backend-scavenge-exclude-ops2
  [assignments : CompilerRegAssignmentList]
  [v1 : CompilerIrValue]
  [v2 : CompilerIrValue]) : (Array String)
  (let
    [h1 : String (compiler-backend-value-scalar-register assignments v1)]
    [h2 : String (compiler-backend-value-scalar-register assignments v2)]
    (make-array
      "%rax"
      "%rdx"
      "%rcx"
      ""
      ""
      (if (string.eq h1 "")
        ""
        h1)
      (if (string.eq h2 "")
        ""
        h2))))

;; Exclude set = HW-fixed regs PLUS two given register names (caller already knows
;; them, e.g. the emission's dst-home + an operand's home reg). "" stays a zero-bit
;; sentinel. Pooled scratch registers such as r10/r11 stay available unless one is
;; one of the explicit register names. n = 7.
(define (compiler-backend-scavenge-exclude-regs2 [r1 : String] [r2 : String]) : (Array
    String)
  (make-array
    "%rax"
    "%rdx"
    "%rcx"
    ""
    ""
    (if (string.eq r1 "")
      ""
      r1)
    (if (string.eq r2 "")
      ""
      r2)))

;; Scavenge candidate pool. The first 11 entries are the legacy pool; ABI-special
;; %rsi/%rdi/%rax come last so they are only used when the older pool is occupied
;; and the point-local occupancy/exclude masks prove them free.
(define (compiler-backend-scavenge-candidates) : (Array String)
  (make-array
    "%r9"
    "%rcx"
    "%rdx"
    "%r10"
    "%r11"
    "%r8"
    "%r12"
    "%r13"
    "%r14"
    "%r15"
    "%rbx"
    "%rsi"
    "%rdi"
    "%rax"))

(define compiler-backend-scavenge-candidate-pool : (Array String)
  (compiler-backend-scavenge-candidates))

(define (compiler-backend-scavenge-rcx-candidates) : (Array String)
  (make-array "%rcx"))

(define compiler-backend-scavenge-rcx-candidate-pool : (Array String)
  (compiler-backend-scavenge-rcx-candidates))

(define (compiler-backend-scavenge-xmm-candidates) : (Array String)
  (make-array "%xmm2" "%xmm3" "%xmm4" "%xmm5"))

(define compiler-backend-scavenge-xmm-candidate-pool : (Array String)
  (compiler-backend-scavenge-xmm-candidates))

(define (compiler-backend-callee-saved-reg? [reg : String]) : bool
  (or
    (>= (compiler-backend-scavenge-callee-idx reg) 0)
    (and
      (compiler-backend-current-fn-win64?)
      (or (string.eq reg "%rsi") (string.eq reg "%rdi")))))

;; A candidate is usable as scratch iff: free at `point`, not excluded, and
;; (caller-saved OR already saved by the prologue).
;;
;; The third clause is essential for soundness. A callee-saved register belongs
;; to the CALLER and must be preserved across this function. The prologue/epilogue
;; only save+restore the callee registers the ALLOCATOR PLAN homes a value in
;; (`plan-uses-reg?`), and that set is fixed BEFORE body emission. If the scavenger
;; were allowed to hand out a callee register the plan does NOT save, the function
;; would clobber the caller's value with no save/restore -- and dynamically adding
;; it to the save set is itself unsound, because the prologue SAVE is emitted
;; post-body (final set) while every RESTORE (each return, each tail call) is
;; emitted inline DURING the body and sees only the set as it stood at that point,
;; so an early return restores a partial set and corrupts the caller. Restricting
;; callee picks to plan-saved registers keeps the save/restore set a pure function
;; of the plan (stable, order-independent) and still gives the scavenger every
;; callee register the allocator already pays to preserve, used as scratch only
;; where the freeness query certifies no live value occupies it.
;; Sound-scavenger reserved mask (LLVM RegScavenger model): the pooled-register
;; homes of the CURRENT instruction's operand (use) + result (def) vars. The
;; scavenge must NEVER return one of these as scratch -- it would clobber an
;; operand the instruction reads, or the result it writes (the dst reads "free"
;; at the scavenge point but must still be reserved). Set once per instruction
;; at the emission dispatcher; consulted in candidate-ok? AND the emergency tier.
(define compiler-backend-current-instr-reserved-mask : i64
  0)

;; Fold instruction uses/def straight into their assigned register-home bits.
;; Building generic liveness bitsets here used to allocate and zero two arrays
;; per emitted instruction, only to scan them immediately into this small mask.
;; The dense assignment index is already installed for the function before
;; scratch planning or emission, so operand visits are constant-time lookups.
(define (compiler-backend-instr-reserved-home-mask [instr : CompilerIrInstr]) : i64
  (begin
    (set! compiler-backend-use-home-mask-value 0)
    (set! compiler-backend-use-home-mask-active true)
    (compiler-backend-use-count-inc
      compiler-backend-use-home-mask-empty-counts
      (compiler-reg-instr-def-var instr))
    (compiler-backend-count-instr-uses
      compiler-backend-use-home-mask-empty-counts
      instr)
    (set! compiler-backend-use-home-mask-active false)
    compiler-backend-use-home-mask-value))

(define (compiler-backend-scavenge-candidate-ok?
  [occupied-mask : i64]
  [exclude-mask : i64]
  [plan-mask : i64]
  [reg : String]) : bool
  (let
    [bit : i64 (compiler-backend-scavenge-reg-bit reg)]
    (and
      (not (= bit 0))
      (=
        (bit-and
          (bit-or exclude-mask compiler-backend-current-instr-reserved-mask)
          bit)
        0)
      (or
        (not (compiler-backend-callee-saved-reg? reg))
        (not (= (bit-and plan-mask bit) 0))
        ;; A frame-home divmod hoist makes %rbx part of the same immutable
        ;; function plan: the prologue saves it, but no synthetic interval owns
        ;; it after the preheader store, so sites may use it as their one copy.
        (and compiler-backend-const-hoist-frame-rbx (string.eq reg "%rbx")))
      (= (bit-and occupied-mask bit) 0))))

;; Emergency scratch register when no candidate is free. Soundness rule: the
;; chosen reg's held value must NOT be an operand of the instruction -- emergency-
;; wrap preserves the value ACROSS but not DURING, so an operand-home reg would be
;; read as the scratch mid-instruction. Prefer the fallback (the site's reserved
;; scratch) when it is FREE at this point: free => no var homes it => not an
;; operand home, so it is sound AND nothing needs preserving. This is byte-
;; identical to the legacy behaviour while the fallback regs are unpooled (they
;; are always free then) and it keeps the optimisation open (a free reg needs
;; no save/restore). If the fallback is OCCUPIED (a pooled reg now homing a value,
;; possibly an operand), use the first NON-EXCLUDED candidate: non-excluded =>
;; not an operand home AND not a template-fixed superset reg, so emergency-
;; wrapping it is sound (even a callee-saved or non-operand-occupied reg -- the
;; wrap restores it). All-excluded is pathological/unreachable (exclude is
;; superset(5)+a few operand homes vs candidate count) -> fallback last resort.
;; Returns the first non-excluded candidate index, or -1 = "use the fallback".
(define (compiler-backend-scavenge-emergency-fallback-free?
  [exclude : (Array String)]
  [exclude-n : i64]
  [occupied-mask : i64]
  [fallback : String]) : bool
  (and
    (not (compiler-backend-scavenge-excluded? exclude exclude-n fallback))
    (compiler-backend-scavenge-reg-free-in-mask? occupied-mask fallback)
    (=
      (bit-and
        compiler-backend-current-instr-reserved-mask
        (compiler-backend-scavenge-reg-bit fallback))
      0)))

(define (compiler-backend-scavenge-emergency-cand-index
  [exclude : (Array String)]
  [exclude-n : i64]
  [exclude-mask : i64]
  [occupied-mask : i64]
  [fallback : String]
  [cands : (Array String)]
  [n : i64]) : i64
  (if (compiler-backend-scavenge-emergency-fallback-free?
    exclude
    exclude-n
    occupied-mask
    fallback)
    -1
    (let
      [i : i64 0]
      [found : i64 -1]
      (begin
        (while (and (< i n) (< found 0))
          (begin
            (if (and
              (or
                (not compiler-backend-divmod-src-emergency-avoid-r10)
                (not (string.eq (array-ref cands i) "%r10")))
              (=
                (bit-and
                  (bit-or
                    exclude-mask
                    compiler-backend-current-instr-reserved-mask)
                  (compiler-backend-scavenge-reg-bit (array-ref cands i)))
                0))
              (set! found i)
              unit)
            (set! i (+ i 1))))
        found))))

(define (compiler-backend-scavenge-pick-iter
  [exclude : (Array String)]
  [exclude-n : i64]
  [exclude-mask : i64]
  [occupied-mask : i64]
  [plan-mask : i64]
  [fallback : String]
  [cands : (Array String)]
  [i : i64]
  [n : i64]) : String
  (if (>= i n)
    (let
      [emidx : i64
        (compiler-backend-scavenge-emergency-cand-index
          exclude
          exclude-n
          exclude-mask
          occupied-mask
          fallback
          cands
          n)]
      (if (< emidx 0)
        (begin
          (cfg
            scavenge-census
            (if (compiler-backend-scavenge-emergency-fallback-free?
              exclude
              exclude-n
              occupied-mask
              fallback)
              (compiler-backend-scavenge-census-record-fallback-free!)
              (compiler-backend-scavenge-census-record-fallback-last-resort!))
            unit)
          ;; emergency-reg MUST equal the returned reg (emergency-wrap saves/
          ;; restores it). Give the global save set a copy, then return the
          ;; owned fallback. (emidx<0 = the fallback is FREE here, preferred; or
          ;; the pathological all-excluded last resort.)
          (if (compiler-backend-scavenge-emergency-reg-supported? fallback)
            (compiler-backend-emergency-add! (string.copy fallback))
            (panic
              (string.append
                "backend: unsupported scavenge emergency fallback register "
                fallback)))
          fallback)
        (begin
          (cfg
            scavenge-census
            (compiler-backend-scavenge-census-record-occupied-candidate!)
            unit)
          (compiler-backend-emergency-add! (array-ref cands emidx))
          (array-ref cands emidx))))
    (if (compiler-backend-scavenge-candidate-ok?
      occupied-mask
      exclude-mask
      plan-mask
      (array-ref cands i))
      ;; A picked callee-saved register is, by candidate-ok?, one the plan already
      ;; saves -- so the prologue/epilogue (driven by the stable plan set) already
      ;; preserve it for the caller. No dynamic save-set growth (that was unsound:
      ;; post-body save vs inline partial-set restores).
      (array-ref cands i)
      (compiler-backend-scavenge-pick-iter
        exclude
        exclude-n
        exclude-mask
        occupied-mask
        plan-mask
        fallback
        cands
        (+ i 1)
        n))))

;; Pick a register free at `point`: prefer `fallback` (keeps it byte-identical
;; while the fallback is a reserved scratch), else the first usable pool
;; candidate, else `fallback` (degraded -- the freeness self-check flags this as
;; a no-free-register case).
(define (compiler-backend-scavenge-pick-with-mask
  [occupied-mask : i64]
  [exclude : (Array String)]
  [exclude-n : i64]
  [fallback : String]) : String
  (let
    [exclude-mask : i64
      (compiler-backend-scavenge-exclude-mask exclude exclude-n)]
    (if (and
      (not (compiler-backend-scavenge-excluded? exclude exclude-n fallback))
      (compiler-backend-scavenge-reg-free-in-mask? occupied-mask fallback))
      fallback
      (let
        [cands : (Array String) compiler-backend-scavenge-candidate-pool]
        (compiler-backend-scavenge-pick-iter
          exclude
          exclude-n
          exclude-mask
          occupied-mask
          compiler-backend-scavenge-ctx-plan-reg-mask
          fallback
          cands
          0
          (array-length cands))))))

(define (compiler-backend-scavenge-pick-from-mask
  [occupied-mask : i64]
  [exclude : (Array String)]
  [exclude-n : i64]
  [fallback : String]
  [cands : (Array String)]) : String
  (let
    [exclude-mask : i64
      (compiler-backend-scavenge-exclude-mask exclude exclude-n)]
    (if (and
      (not (compiler-backend-scavenge-excluded? exclude exclude-n fallback))
      (compiler-backend-scavenge-reg-free-in-mask? occupied-mask fallback))
      fallback
      (compiler-backend-scavenge-pick-iter
        exclude
        exclude-n
        exclude-mask
        occupied-mask
        compiler-backend-scavenge-ctx-plan-reg-mask
        fallback
        cands
        0
        (array-length cands)))))

(define (compiler-backend-scavenge-xmm-reg
  [dst-var : i64]
  [exclude : (Array String)]
  [exclude-n : i64]
  [fallback : String]) : String
  (let
    [assignment-index : CompilerRegAssignmentIndex
      compiler-backend-scavenge-ctx-assignment-index]
    [vars : i64 compiler-backend-scavenge-ctx-vars]
    ;; See compiler-backend-scavenge-reg: query the staging register's forward live
    ;; span so a fused/destructure float load cannot clobber a reordered sibling
    ;; field emitted into its home before it.
    [point : i64
      (*
        2
        (-
          compiler-backend-emit-instr-post-base
          compiler-backend-emit-current-count))]
    [hi-point : i64 (+ point compiler-backend-scavenge-staging-window)]
    [dst-home : String
      (if (and (>= dst-var 0) (< dst-var vars))
        (compiler-backend-var-register-home-index assignment-index dst-var)
        "")]
    [ex : (Array String)
      (if (string.eq dst-home "")
        exclude
        (compiler-backend-scavenge-exclude-append exclude exclude-n dst-home))]
    [ex-n : i64
      (if (string.eq dst-home "")
        exclude-n
        (+ exclude-n 1))]
    [reg : String
      (compiler-backend-scavenge-pick-from-mask
        (compiler-backend-scavenge-occupied-mask-over-range point hi-point)
        ex
        ex-n
        fallback
        compiler-backend-scavenge-xmm-candidate-pool)]
    (begin
      (cfg
        scavenge-self-check
        (compiler-backend-scavenge-freeness-check!
          compiler-backend-scavenge-ctx-starts
          compiler-backend-scavenge-ctx-ends
          assignment-index
          vars
          point
          reg)
        unit)
      reg)))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-freeness-check!
    [starts : (Array i64)]
    [ends : (Array i64)]
    [assignment-index : CompilerRegAssignmentIndex]
    [vars : i64]
    [point : i64]
    [reg : String]) : unit
    (if (or
      (compiler-backend-scavenge-free-for-instr?
        starts
        ends
        assignment-index
        vars
        point
        reg)
      compiler-backend-emergency-pending)
      unit
      (panic
        (str-cat
          "SCAVENGE-FREENESS-VIOLATION reg="
          reg
          " point="
          (int->string point)
          " -- pick returned an occupied register (no free scratch)")))))

;; Side-effect-free twin of the GP picker for fusion admission.  It predicts the
;; exact register the ordinary scavenger will return, including its emergency
;; tier, without adding a pending save that would leak when the fusion rejects.
(define (compiler-backend-scavenge-pick-iter-peek
  [occupied-mask : i64]
  [exclude : (Array String)]
  [exclude-n : i64]
  [exclude-mask : i64]
  [plan-mask : i64]
  [fallback : String]
  [cands : (Array String)]
  [i : i64]
  [n : i64]) : String
  (if (>= i n)
    (let
      [emidx : i64
        (compiler-backend-scavenge-emergency-cand-index
          exclude
          exclude-n
          exclude-mask
          occupied-mask
          fallback
          cands
          n)]
      (if (< emidx 0)
        fallback
        (array-ref cands emidx)))
    (if (compiler-backend-scavenge-candidate-ok?
      occupied-mask
      exclude-mask
      plan-mask
      (array-ref cands i))
      (array-ref cands i)
      (compiler-backend-scavenge-pick-iter-peek
        occupied-mask
        exclude
        exclude-n
        exclude-mask
        plan-mask
        fallback
        cands
        (+ i 1)
        n))))

(define (compiler-backend-scavenge-pick-with-mask-peek
  [occupied-mask : i64]
  [exclude : (Array String)]
  [exclude-n : i64]
  [fallback : String]) : String
  (let
    [exclude-mask : i64
      (compiler-backend-scavenge-exclude-mask exclude exclude-n)]
    (if (and
      (not (compiler-backend-scavenge-excluded? exclude exclude-n fallback))
      (compiler-backend-scavenge-reg-free-in-mask? occupied-mask fallback))
      fallback
      (compiler-backend-scavenge-pick-iter-peek
        occupied-mask
        exclude
        exclude-n
        exclude-mask
        compiler-backend-scavenge-ctx-plan-reg-mask
        fallback
        compiler-backend-scavenge-candidate-pool
        0
        (array-length compiler-backend-scavenge-candidate-pool)))))

(define (compiler-backend-scavenge-reg-peek
  [dst-var : i64]
  [exclude : (Array String)]
  [exclude-n : i64]
  [fallback : String]) : String
  (let
    [point : i64
      (*
        2
        (-
          compiler-backend-emit-instr-post-base
          compiler-backend-emit-current-count))]
    [hi-point : i64 (+ point compiler-backend-scavenge-staging-window)]
    [dst-home : String
      (if (and (>= dst-var 0) (< dst-var compiler-backend-scavenge-ctx-vars))
        (compiler-backend-var-register-home-index
          compiler-backend-scavenge-ctx-assignment-index
          dst-var)
        "")]
    [ex : (Array String)
      (if (string.eq dst-home "")
        exclude
        (compiler-backend-scavenge-exclude-append exclude exclude-n dst-home))]
    [ex-n : i64
      (if (string.eq dst-home "")
        exclude-n
        (+ exclude-n 1))]
    (compiler-backend-scavenge-pick-with-mask-peek
      (compiler-backend-scavenge-occupied-mask-over-range point hi-point)
      ex
      ex-n
      fallback)))

;; Return a register free at dst-var's def point (via the proven query),
;; excluding `exclude`, preferring `fallback`. If the preferred register is
;; occupied, pick another free pooled candidate or use the emergency wrapper.
(define (compiler-backend-scavenge-reg
  [dst-var : i64]
  [exclude : (Array String)]
  [exclude-n : i64]
  [fallback : String]) : String
  (let
    [assignment-index : CompilerRegAssignmentIndex
      compiler-backend-scavenge-ctx-assignment-index]
    [vars : i64 compiler-backend-scavenge-ctx-vars]
    ;; Query the occupancy across the staging register's live span, not just the
    ;; single emit POSITION. Loads sharing a base (a destructure's fields, fused by
    ;; emit-load-from-gep-pair / emit-load-load / emit-fused-gep-load-rest) are
    ;; emitted in OFFSET order while the lowering assigns their def points in the
    ;; REVERSE order, so a register-homed sibling (e.g. a String key in %r9) is
    ;; emitted into its home BEFORE a spilled sibling's staging load yet carries a
    ;; HIGHER interval point. Querying only `point` read that register "free" and
    ;; the scratch clobbered the just-loaded sibling (intern-lookup's slot-id load
    ;; picking %r9 over the live slot-key). A spilled field at offset position j in
    ;; a K-field group is preceded by j siblings at point+2..point+2j, so the
    ;; staging register's true upper coordinate is point + 2*(K-1); the window
    ;; below covers the deepest fully-bound aggregates the compiler destructures.
    ;; For a standalone def with nothing reordered ahead these forward events are
    ;; the next instructions' (whose registers the result must avoid anyway), so
    ;; this never under-protects. Exclude the dst home (not live yet) so the
    ;; scratch never overwrites the result register.
    [point : i64
      (*
        2
        (-
          compiler-backend-emit-instr-post-base
          compiler-backend-emit-current-count))]
    [hi-point : i64 (+ point compiler-backend-scavenge-staging-window)]
    [dst-home : String
      (if (and (>= dst-var 0) (< dst-var vars))
        (compiler-backend-var-register-home-index assignment-index dst-var)
        "")]
    [ex : (Array String)
      (if (string.eq dst-home "")
        exclude
        (compiler-backend-scavenge-exclude-append exclude exclude-n dst-home))]
    [ex-n : i64
      (if (string.eq dst-home "")
        exclude-n
        (+ exclude-n 1))]
    [reg : String
      (compiler-backend-scavenge-pick-with-mask
        (compiler-backend-scavenge-occupied-mask-over-range point hi-point)
        ex
        ex-n
        fallback)]
    (begin
      (cfg
        scavenge-self-check
        (compiler-backend-scavenge-freeness-check!
          compiler-backend-scavenge-ctx-starts
          compiler-backend-scavenge-ctx-ends
          assignment-index
          vars
          point
          reg)
        unit)
      reg)))

;; No-dst scavenge: same as scavenge-reg but the point comes from the drift-proof
;; per-instruction position (post-base - length(current-instrs)) instead of a dst
;; var's def point -- for instructions that define no variable (compare-branch,
;; GEP store/copy, etc.). Returns `fallback` until the fallback register is pooled.
(define (compiler-backend-scavenge-reg-here
  [exclude : (Array String)]
  [exclude-n : i64]
  [fallback : String]) : String
  (let
    [point : i64
      (*
        2
        (-
          compiler-backend-emit-instr-post-base
          compiler-backend-emit-current-count))]
    [reg : String
      (compiler-backend-scavenge-pick-with-mask
        (compiler-backend-scavenge-occupied-mask-at-point point)
        exclude
        exclude-n
        fallback)]
    (begin
      (cfg
        scavenge-self-check
        (compiler-backend-scavenge-freeness-check!
          compiler-backend-scavenge-ctx-starts
          compiler-backend-scavenge-ctx-ends
          compiler-backend-scavenge-ctx-assignment-index
          compiler-backend-scavenge-ctx-vars
          point
          reg)
        unit)
      reg)))

(define (compiler-backend-scavenge-rcx-reg-here
  [exclude : (Array String)]
  [exclude-n : i64]) : String
  (let
    [point : i64
      (*
        2
        (-
          compiler-backend-emit-instr-post-base
          compiler-backend-emit-current-count))]
    [reg : String
      (compiler-backend-scavenge-pick-from-mask
        (compiler-backend-scavenge-occupied-mask-at-point point)
        exclude
        exclude-n
        "%rcx"
        compiler-backend-scavenge-rcx-candidate-pool)]
    (begin
      (cfg
        scavenge-self-check
        (compiler-backend-scavenge-freeness-check!
          compiler-backend-scavenge-ctx-starts
          compiler-backend-scavenge-ctx-ends
          compiler-backend-scavenge-ctx-assignment-index
          compiler-backend-scavenge-ctx-vars
          point
          reg)
        unit)
      reg)))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-check-instr
    [starts : (Array i64)]
    [ends : (Array i64)]
    [assignment-index : CompilerRegAssignmentIndex]
    [vars : i64]
    [name : String]
    [point : i64]
    [instr : CompilerIrInstr]
    [live-after : CompilerLiveI64Set]) : unit
    (let
      [uses : CompilerLiveI64Set (compiler-live-instr-uses instr)]
      [v : i64 0]
      (begin
        (while (< v vars)
          (begin
            (if (compiler-live-set-contains? uses v)
              ;; Only REGISTER-HOMED used vars need interval coverage + a
              ;; not-free home: a spilled/untracked used var has no register to
              ;; clobber, and an all-spilled function installs an EMPTY scavenge
              ;; ctx (Nil intervals -> starts[v]=-1) on purpose, so asserting
              ;; coverage for non-register vars is a false positive (the old
              ;; check aborted at the first all-spilled function before reaching
              ;; the real register hazards). cfg-gated: oracle-only, no codegen.
              (match (compiler-reg-assignment-index-lookup assignment-index v)
                [(CompilerRegMaybeLocation.Some loc)
                  (match loc
                    [(CompilerRegLocation.Register home)
                      (begin
                        (if (and
                          (>= (array-ref starts v) 0)
                          (<= (array-ref starts v) point)
                          (<= point (array-ref ends v)))
                          unit
                          (panic
                            (str-cat
                              "SCAVENGE-VIOLATION interval fn="
                              name
                              " point="
                              (int->string point)
                              " use-var="
                              (int->string v)
                              " iv=["
                              (int->string (array-ref starts v))
                              ","
                              (int->string (array-ref ends v))
                              "]")))
                        (if (compiler-backend-scavenge-free-for-instr?
                          starts
                          ends
                          assignment-index
                          vars
                          point
                          home)
                          (panic
                            (str-cat
                              "SCAVENGE-VIOLATION free fn="
                              name
                              " point="
                              (int->string point)
                              " use-var="
                              (int->string v)
                              " reg="
                              home
                              " wrongly-reported-free"))
                          unit))]
                    [(CompilerRegLocation.RegisterPair _ _) unit]
                    [(CompilerRegLocation.Spill _) unit]
                    [(CompilerRegLocation.Remat _) unit])]
                [(CompilerRegMaybeLocation.No) unit])
              unit)
            (set! v (+ v 1))))
        ;; #FOUNDATION: the used-var loop above validates OPERAND homes; this
        ;; second loop validates LIVE-THROUGH values (live-after but not used
        ;; here). A value live ACROSS this instruction must be reported OCCUPIED
        ;; on its register -- a scavenge querying `point` would otherwise pick it
        ;; and clobber a call-spanning / loop-carried value. This is the class the
        ;; old used-var-only self-check missed (its blind spot).
        (let
          [w : i64 0]
          (while (< w vars)
            (begin
              (if (compiler-live-set-contains? live-after w)
                (match (compiler-reg-assignment-index-lookup assignment-index w)
                  [(CompilerRegMaybeLocation.Some loc)
                    (match loc
                      [(CompilerRegLocation.Register home)
                        (if (compiler-backend-scavenge-free-for-instr?
                          starts
                          ends
                          assignment-index
                          vars
                          point
                          home)
                          (panic
                            (str-cat
                              "SCAVENGE-LIVETHROUGH-VIOLATION fn="
                              name
                              " point="
                              (int->string point)
                              " live-var="
                              (int->string w)
                              " reg="
                              home
                              " WRONGLY-FREE iv=["
                              (int->string (array-ref starts w))
                              ","
                              (int->string (array-ref ends w))
                              "]"))
                          unit)]
                      [(CompilerRegLocation.RegisterPair _ _) unit]
                      [(CompilerRegLocation.Spill _) unit]
                      [(CompilerRegLocation.Remat _) unit])]
                  [(CompilerRegMaybeLocation.No) unit])
                unit)
              (set! w (+ w 1)))))
        unit))))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-check-seq
    [starts : (Array i64)]
    [ends : (Array i64)]
    [assignment-index : CompilerRegAssignmentIndex]
    [vars : i64]
    [name : String]
    [instrs : CompilerIrInstrSeq]
    [live-afters : CompilerLiveInstrSetVec]
    [point : i64]) : i64
    (let
      [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
      [count : i64 (struct-get instrs len)]
      [after-items : (Array CompilerLiveI64Set) (struct-get live-afters items)]
      [index : i64 0]
      [out : i64 point]
      (begin
        (while (< index count)
          (begin
            (compiler-backend-scavenge-check-instr
              starts
              ends
              assignment-index
              vars
              name
              out
              (array-ref slots index)
              (if (< index (array-length after-items))
                (array-ref after-items index)
                (compiler-live-set-empty)))
            (set! out (+ out 2))
            (set! index (+ index 1))))
        out))))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-check-blocks
    [starts : (Array i64)]
    [ends : (Array i64)]
    [assignment-index : CompilerRegAssignmentIndex]
    [vars : i64]
    [name : String]
    [liveness : CompilerFunctionLiveness]
    [blocks : CompilerIrBlockList]
    [point : i64]) : i64
    (match blocks
      [(CompilerIrBlockList.Nil) point]
      [(CompilerIrBlockList.Cons block rest)
        (match block
          [(CompilerIrBlock.Block label instrs)
            (compiler-backend-scavenge-check-blocks
              starts
              ends
              assignment-index
              vars
              name
              liveness
              (box-get rest)
              (compiler-backend-scavenge-check-seq
                starts
                ends
                assignment-index
                vars
                name
                instrs
                (compiler-reg-live-intervals-find-afters liveness label)
                point))])]
      [(CompilerIrBlockList.Array seq)
        ;; cfg-gated self-check only; normal emission installs scavenge state
        ;; from interval arrays and stays on the dense block path.
        (compiler-backend-scavenge-check-blocks
          starts
          ends
          assignment-index
          vars
          name
          liveness
          (compiler-ir-block-seq-to-list seq)
          point)])))

;; Build the per-var live intervals on the FINAL IR and self-check the query.
;; cfg-gated -> inert/DCE'd in a normal build (byte-identical codegen).
(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-self-check
    [name : i64]
    [params : CompilerIrParamList]
    [ret-ty : AstType]
    [slot-vars : i64]
    [emit-blocks : CompilerIrBlockList]
    [assignments : CompilerRegAssignmentList]) : unit
    (if (< slot-vars 1)
      unit
      (let
        [func : CompilerIrFunction
          (CompilerIrFunction.Function name params ret-ty slot-vars emit-blocks)]
        [liveness : CompilerFunctionLiveness
          (compiler-live-analyze-function func)]
        [starts : (Array i64) (make-array i64 slot-vars)]
        [ends : (Array i64) (make-array i64 slot-vars)]
        [assignment-index : CompilerRegAssignmentIndex
          (compiler-reg-assignment-index-build assignments slot-vars)]
        (begin
          (compiler-reg-fill-i64-array starts -1)
          (compiler-reg-fill-i64-array ends -1)
          (compiler-reg-live-intervals-blocks-with-live
            emit-blocks
            liveness
            0
            starts
            ends)
          (compiler-backend-scavenge-seed-block-liveins
            emit-blocks
            liveness
            0
            starts
            ends)
          (compiler-backend-scavenge-check-blocks
            starts
            ends
            assignment-index
            slot-vars
            (compiler-ir-symbol-text name)
            liveness
            emit-blocks
            0)
          unit)))))

;; Increment the predecessor count for every label in `labels` (a deduped CFG
;; successor set for one block). Each block contributes at most once per
;; successor, so the resulting count is the number of DISTINCT predecessor
;; blocks -- exactly the "is this label a merge?" signal we need.
(define (compiler-backend-peephole-predcount-bump
  [counts : backend_label_i64_map.Map]
  [labels : OptLabelSet]) : backend_label_i64_map.Map
  (match labels
    [(OptLabelSet.Nil) counts]
    [(OptLabelSet.Dense _ _)
      (let
        [label : i64 (opt-label-ref labels 0)]
        (begin
          (backend_label_i64_map.insert-ref!
            (&mut counts)
            label
            (+
              1
              (match (backend_label_i64_map.get (& counts) label)
                [(backend_label_i64_map.LookupFound v) v]
                [(backend_label_i64_map.LookupMissing) 0])))
          (compiler-backend-peephole-predcount-bump
            counts
            (opt-label-tail labels))))]))

;; Count predecessors of every block from the AUTHORITATIVE CFG successor set
;; (explicit IrInstrJump / IrInstrBranch / IrInstrSwitch targets PLUS the
;; implicit fall-through to the layout-next block), reusing the optimizer's own
;; successor enumeration so jump-table (switch) case + default targets are all
;; included. Under-counting an edge is the only way carry could go wrong, and
;; this enumeration is complete (those are the only label-bearing terminators).
(define (compiler-backend-peephole-predcount-build
  [blocks : CompilerIrBlockList]
  [counts : backend_label_i64_map.Map]) : backend_label_i64_map.Map
  (match blocks
    [(CompilerIrBlockList.Nil) counts]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-peephole-predcount-build-seq seq 0 counts)]
    [(CompilerIrBlockList.Cons block rest)
      (compiler-backend-peephole-predcount-build
        (box-get rest)
        (compiler-backend-peephole-predcount-bump
          counts
          (opt-cfg-block-successors-with-next
            block
            (opt-cfg-entry-label (box-get rest)))))]))

(define (compiler-backend-block-seq-label-or-empty
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : i64
  (if (>= index (compiler-ir-block-seq-count blocks))
    (compiler-ir-label-none)
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block label _) label])))

(define (compiler-backend-peephole-predcount-build-seq
  [blocks : CompilerIrBlockSeq]
  [index : i64]
  [counts : backend_label_i64_map.Map]) : backend_label_i64_map.Map
  (if (>= index (compiler-ir-block-seq-count blocks))
    counts
    (compiler-backend-peephole-predcount-build-seq
      blocks
      (+ index 1)
      (compiler-backend-peephole-predcount-bump
        counts
        (opt-cfg-block-successors-with-next
          (compiler-ir-block-seq-ref blocks index)
          (compiler-backend-block-seq-label-or-empty blocks (+ index 1)))))))

;; True iff `block`'s terminator is a conditional branch that NEEDS phi-copy edge
;; blocks. SOUNDNESS-CRITICAL: such a branch does NOT lower to a clean
;; fall-through into its layout-next arm -- compiler-backend-emit-branch-with-phi-
;; copies emits a SYNTHETIC edge-copy block (`<label>_branch_<suffix>`) on the
;; fall-through path and reaches the layout-next arm via an explicit jcc. So the
;; layout-next block is a JUMP target with foreign code (the other edge's copies)
;; textually preceding it -- its running owner map is NOT this block's exit map,
;; and carrying across it miscompiles (observed: a wrong reload reuse in the
;; dominator fixpoint -> non-termination). A branch that needs NO phi copies
;; lowers to `jcc <other-arm>` + clean fall-through (emit-compare-branch-jumps),
;; which IS safe. Jump terminators keep copies on their single edge. Switches
;; with phi targets now also split through synthetic edge blocks, so they must
;; reset the carry state before any layout-next block.
(define (compiler-backend-peephole-prev-splits-edge? [block : CompilerIrBlock]) : bool
  (match block
    [(CompilerIrBlock.Block _ instrs)
      (let
        [n : i64 (struct-get instrs len)]
        (if (= n 0)
          false
          (match (array-ref (struct-get instrs slots) (- n 1))
            [(CompilerIrInstr.Branch _ true-label false-label)
              (compiler-backend-branch-needs-phi-copies? true-label false-label)]
            [(CompilerIrInstr.Switch _ _ cases default-label)
              (compiler-backend-switch-target-phi? cases default-label)]
            [_ false])))]))

;; Walk blocks in LAYOUT order (prev = the textually-preceding block). A block B
;; is carry-safe -- the peephole may carry the owner map across B's label rather
;; than reset -- iff ALL hold:
;;   (1) B is not the function entry (the entry is reached by `call` with caller
;;       register state, never by fall-through; it is `prev` here, never `cur`,
;;       and is additionally guarded by entry-label);
;;   (2) B has exactly ONE predecessor in the CFG (predcount == 1) -- so it is
;;       not a merge / multi-pred branch/switch/jump-table target; and
;;   (3) that single predecessor is `prev`, the layout-adjacent block (prev's
;;       successor set contains B). (2)+(3) together prove B is reached ONLY by
;;       continuing from prev, so the peephole's running owner map at B's label
;;       equals prev's exit map. If B's lone predecessor were laid out elsewhere
;;       (e.g. a far switch case), (3) fails and we reset -- the sound default;
;;   (4) prev does NOT end in a phi-copy branch (compiler-backend-peephole-prev-
;;       splits-edge?), which would insert a synthetic edge-copy block between
;;       prev and B and reach B via an explicit jcc rather than fall-through --
;;       so B's running map would be the OTHER edge's, not prev's exit.
(define (compiler-backend-peephole-carry-safe-scan
  [label-scope : String]
  [entry-label : i64]
  [predcount : backend_label_i64_map.Map]
  [prev : CompilerIrBlock]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-peephole-carry-safe-scan-seq
        label-scope
        entry-label
        predcount
        prev
        seq
        0)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block cur-label _)
          (begin
            (if (and
              (not (= cur-label entry-label))
              (not (compiler-backend-peephole-prev-splits-edge? prev))
              (=
                1
                (match (backend_label_i64_map.get (& predcount) cur-label)
                  [(backend_label_i64_map.LookupFound v) v]
                  [(backend_label_i64_map.LookupMissing) 0]))
              (opt-label-contains
                (opt-cfg-block-successors-with-next prev cur-label)
                cur-label))
              (compiler-backend-peephole-carry-safe-insert!
                (compiler-backend-asm-label label-scope cur-label))
              unit)
            (compiler-backend-peephole-carry-safe-scan
              label-scope
              entry-label
              predcount
              block
              (box-get rest)))])]))

(define (compiler-backend-peephole-carry-safe-scan-seq
  [label-scope : String]
  [entry-label : i64]
  [predcount : backend_label_i64_map.Map]
  [prev : CompilerIrBlock]
  [blocks : CompilerIrBlockSeq]
  [index : i64]) : unit
  (if (>= index (compiler-ir-block-seq-count blocks))
    unit
    (let
      [block : CompilerIrBlock (compiler-ir-block-seq-ref blocks index)]
      (match block
        [(CompilerIrBlock.Block cur-label _)
          (begin
            (if (and
              (not (= cur-label entry-label))
              (not (compiler-backend-peephole-prev-splits-edge? prev))
              (=
                1
                (match (backend_label_i64_map.get (& predcount) cur-label)
                  [(backend_label_i64_map.LookupFound v) v]
                  [(backend_label_i64_map.LookupMissing) 0]))
              (opt-label-contains
                (opt-cfg-block-successors-with-next prev cur-label)
                cur-label))
              (compiler-backend-peephole-carry-safe-insert!
                (compiler-backend-asm-label label-scope cur-label))
              unit)
            (compiler-backend-peephole-carry-safe-scan-seq
              label-scope
              entry-label
              predcount
              block
              blocks
              (+ index 1)))]))))

;; Accumulate carry-safe block labels for one function's FINAL emitted blocks
;; into the global peephole carry-safe set. `label-scope` MUST be the same value
;; emit-blocks passes to compiler-backend-asm-label, so the keys match the
;; emitted label lines exactly. Computed from the post-transform emit-blocks so
;; the CFG it analyzes is the one actually emitted.
(define (compiler-backend-peephole-collect-carry-safe!
  [label-scope : String]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Array seq)
      (if (= (compiler-ir-block-seq-count seq) 0)
        unit
        (let
          [entry : CompilerIrBlock (compiler-ir-block-seq-ref seq 0)]
          (match entry
            [(CompilerIrBlock.Block entry-label _)
              (compiler-backend-peephole-carry-safe-scan-seq
                label-scope
                entry-label
                (compiler-backend-peephole-predcount-build-seq
                  seq
                  0
                  (backend_label_i64_map.with-capacity 64))
                entry
                seq
                1)])))]
    [(CompilerIrBlockList.Cons entry rest)
      (match entry
        [(CompilerIrBlock.Block entry-label _)
          (compiler-backend-peephole-carry-safe-scan
            label-scope
            entry-label
            (compiler-backend-peephole-predcount-build
              (compiler-ir-block-cons entry (box-get rest))
              (backend_label_i64_map.with-capacity 64))
            entry
            (box-get rest))])]))

;; ============================================================================
;; M-G3 stage 1: rsp-relative frame addressing (behavior-neutral rebase).
;;
;; Every frame slot is emitted rbp-relative (`-K(%rbp)`; prologue: pushq %rbp /
;; movq %rsp,%rbp / subq $frame,%rsp), so `-K(%rbp)` == `(frame-K)(%rsp)`
;; whenever %rsp still sits at its post-prologue value. The final frame constant
;; is only known AFTER the body is emitted (emergency-scavenge use grows the
;; callee-save area and appends extra slots), so the rebase runs as a
;; post-emission text pass over the function's post-prologue text -- this is the
;; single point where the per-function frame model (frame constant + rbp-or-rsp
;; choice) is applied; stage 2 (frame-pointer omission) changes only the
;; prologue/epilogue and the bias fed to this pass.
;;
;; The pass PROVES rsp-constancy line by line instead of assuming it:
;;   * `delta` tracks any in-body %rsp displacement (bytes pushed beyond the
;;     prologue sub), such as the AVX-512 `pushq $1` mask dip or conservative
;;     fallback emitters. All such windows are straight-line and balanced within
;;     one instruction emission; a label inside a nonzero-delta window, or a
;;     net-negative delta, fails the audit. C-ABI outgoing args and arg/phi
;;     cycle temps are pre-reserved frame uses and no longer create such dips.
;;   * `pushq MEM` computes its address BEFORE %rsp moves; `popq MEM` AFTER --
;;     the delta updates are ordered accordingly.
;;   * `leave` and any other %rsp write (`leaq slot,%rsp` pop-restore
;;     epilogues, the closure adapters' `movq %rbp,%rsp`) end rsp validity;
;;     validity resumes at the next label (labels are only reachable at
;;     delta 0). A frame reference while %rsp is unknown fails the audit.
;;   * POSITIVE rbp offsets (incoming stack args at 16+8k(%rbp) and tail-call
;;     final stack-arg stores into those same slots) are LEFT on rbp: %rbp is
;;     still materialized in stage 1, and those accesses stay valid regardless
;;     of %rsp motion. Stage 2 rebases them with its adjusted constant.
;;   * Indexed rbp forms (`(%rbp,...`), a bare `(%rbp)`, or a rewritten offset
;;     that would go negative fail the audit (none are emitted today).
;; On ANY audit failure the ORIGINAL text is returned unchanged -- that
;; function simply keeps rbp addressing (needs-rbp), preserving behavior.
;;
;; The post-emission peephole recognizes both slot spellings through its
;; parsed stack-slot range predicate. Within any owner-map
;; lifetime every %rsp-mutating line (pushq/popq/subq/addq/leave/movq-to-rsp/
;; leaq-to-rsp/ret) conservatively clears the map; a returned call restores
;; %rsp and keeps only callee-saved stack-slot owners. Equal operand strings
;; therefore imply equal addresses in both worlds and the elision behavior
;; carries over 1:1.
(define compiler-backend-rsp-rebase-ok-count : i64
  0)
(define compiler-backend-rsp-rebase-keep-count : i64
  0)

;; M-G3 stage 2: result of the LAST rsp-rebase invocation (true = audit passed
;; and the returned text is the rewritten one). The caller picks the prologue
;; (FPO subq vs rbp push/mov/sub) and the demotion path from this.
(define compiler-backend-rsp-rebase-last-ok : bool
  true)

;; M-G3 stage 2 census: functions emitted frame-pointer-free / whose final plan
;; homes a value in %rbp / demoted (FPO audit failed on an rbp-planned function
;; -> re-planned without %rbp).
(define compiler-backend-fpo-count : i64
  0)
(define compiler-backend-fpo-rbp-plan-count : i64
  0)
(define compiler-backend-fpo-demote-count : i64
  0)

;; GAP1 census: FPO functions emitted with the push-style CSR prologue
;; (push-count > 0).
(define compiler-backend-fpo-push-count : i64
  0)
(define compiler-backend-peephole-r10-dead-scan-cap-hits : i64
  0)

;; Packed control-mnemonic classification shared by the RSP rebase audit and
;; the dead-frame-store sweep. Both passes used to ask the generic byte-range
;; comparator about the same small fixed set repeatedly for every assembly
;; line. Values are deliberately scalar so callers can derive all predicates
;; from one classification without allocating a token object.
(define compiler-backend-control-mnemonic-none : i64
  0)
(define compiler-backend-control-mnemonic-movq : i64
  1)
(define compiler-backend-control-mnemonic-leaq : i64
  2)
(define compiler-backend-control-mnemonic-push : i64
  3)
(define compiler-backend-control-mnemonic-pop : i64
  4)
(define compiler-backend-control-mnemonic-leave : i64
  5)
(define compiler-backend-control-mnemonic-ret : i64
  6)
(define compiler-backend-control-mnemonic-jmp : i64
  7)
(define compiler-backend-control-mnemonic-subq : i64
  8)
(define compiler-backend-control-mnemonic-addq : i64
  9)
(define compiler-backend-control-mnemonic-syscall : i64
  10)

(define (compiler-backend-control-mnemonic-kind
  [data : (Ptr u8)]
  [start : i64]
  [len : i64]) : i64
  (if (< len 3)
    compiler-backend-control-mnemonic-none
    (let
      [b0 : i64 (compiler-backend-peephole-byte-at data start)]
      [b1 : i64 (compiler-backend-peephole-byte-at data (+ start 1))]
      [b2 : i64 (compiler-backend-peephole-byte-at data (+ start 2))]
      [key3 : i64 (+ b0 (+ (* b1 256) (* b2 65536)))]
      (cond
        [(= len 3)
          (cond
            [(= key3 7368560) compiler-backend-control-mnemonic-pop]
            [(= key3 7628146) compiler-backend-control-mnemonic-ret]
            [(= key3 7368042) compiler-backend-control-mnemonic-jmp]
            [else compiler-backend-control-mnemonic-none])]
        [(>= len 4)
          (let
            [b3 : i64 (compiler-backend-peephole-byte-at data (+ start 3))]
            [key4 : i64 (+ key3 (* b3 16777216))]
            (cond
              [(= len 4)
                (cond
                  [(= key4 1903587181) compiler-backend-control-mnemonic-movq]
                  [(= key4 1902208364) compiler-backend-control-mnemonic-leaq]
                  [(= key4 1752397168) compiler-backend-control-mnemonic-push]
                  [(= key4 1903193968) compiler-backend-control-mnemonic-pop]
                  [(= key4 1902278003) compiler-backend-control-mnemonic-subq]
                  [(= key4 1902404705) compiler-backend-control-mnemonic-addq]
                  [else compiler-backend-control-mnemonic-none])]
              [(= len 5)
                (let
                  [b4 : i64
                    (compiler-backend-peephole-byte-at data (+ start 4))]
                  (cond
                    [(and (= key4 1752397168) (= b4 113))
                      compiler-backend-control-mnemonic-push]
                    [(and (= key4 1986094444) (= b4 101))
                      compiler-backend-control-mnemonic-leave]
                    [else compiler-backend-control-mnemonic-none]))]
              [(= len 7)
                (if (and
                  (= key4 1668512115)
                  (= (compiler-backend-peephole-byte-at data (+ start 4)) 97)
                  (= (compiler-backend-peephole-byte-at data (+ start 5)) 108)
                  (= (compiler-backend-peephole-byte-at data (+ start 6)) 108))
                  compiler-backend-control-mnemonic-syscall
                  compiler-backend-control-mnemonic-none)]
              [else compiler-backend-control-mnemonic-none]))]
        [else compiler-backend-control-mnemonic-none]))))

;; Index of the first "(%rbp" occurrence in [start,end), or -1. Jumps between
;; '(' bytes with memchr instead of stepping every byte.
(define (compiler-backend-rsp-rebase-find-rbp
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [i : i64 start]
    [found : i64 -1]
    [done : bool false]
    (begin
      (while (and (not done) (<= (+ i 5) end))
        (let
          [offset : i64
            (unsafe
              (compiler-backend-runtime-index-of-byte
                (ptr-offset data i)
                (- (- end 4) i)
                (cast 40 : u8)))]
          (if (< offset 0)
            (set! done true)
            (let
              [pos : i64 (+ i offset)]
              (if (and
                (= (compiler-backend-peephole-byte-at data (+ pos 1)) 37)
                (= (compiler-backend-peephole-byte-at data (+ pos 2)) 114)
                (= (compiler-backend-peephole-byte-at data (+ pos 3)) 98)
                (= (compiler-backend-peephole-byte-at data (+ pos 4)) 112))
                (begin
                  (set! found pos)
                  (set! done true))
                (set! i (+ pos 1)))))))
      found)))

;; Start index of the signed decimal immediately preceding `pos`, or -1 when
;; there is none (a bare/indexed form the audit must reject).
(define (compiler-backend-rsp-rebase-int-start
  [data : (Ptr u8)]
  [line-start : i64]
  [pos : i64]) : i64
  (let
    [j : i64 pos]
    (begin
      (while (and
        (> j line-start)
        (let
          [b : i64 (compiler-backend-peephole-byte-at data (- j 1))]
          (and (>= b 48) (<= b 57))))
        (set! j (- j 1)))
      (if (= j pos)
        -1
        (if (and
          (> j line-start)
          (= (compiler-backend-peephole-byte-at data (- j 1)) 45))
          (- j 1)
          j)))))

;; Parse the (optionally '-'-signed) decimal in [start,end).
(define (compiler-backend-rsp-rebase-parse-int
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [neg : bool (= (compiler-backend-peephole-byte-at data start) 45)]
    [j : i64
      (if neg
        (+ start 1)
        start)]
    [v : i64 0]
    (begin
      (while (< j end)
        (begin
          (set!
            v
            (+ (* v 10) (- (compiler-backend-peephole-byte-at data j) 48)))
          (set! j (+ j 1))))
      (if neg
        (- 0 v)
        v))))

;; ============================================================================
;; GAP1 / Win64 FPO: push-style CSR prologue saves.
;;
;; The mov-form CSR save/restore (`movq %rXX, -K(%rbp)` / `movq -K(%rbp), %rXX`
;; / the pop-run `leaq -K(%rbp), %rsp; popq ...`) is converted AT THE REBASE
;; SEAM into clang's push form: the caller's prologue becomes
;;     pushq %r12 [.. pushq %rbp]      (plan-saved CSRs, slot-idx order)
;;     subq $S, %rsp                   (S = frame + pad; pad keeps alignment)
;; and the pass (push mode = fpo AND push-count > 0):
;;   * DELETES the save/restore movq lines (their slots -- the callee-save
;;     reservation inside `frame` -- become dead pad; the frame constant is
;;     NOT shrunk because the reservation sits mid-frame between the var area
;;     and the group/outgoing/emergency regions, so the offset span is fixed),
;;   * rewrites the pop-run entry `leaq CSRSLOT(%rbp), %rsp` to
;;     `addq $(S+delta), %rsp` (rsp -> the pushed area; the existing popq run
;;     then restores the same registers in the same order: the pop-run pops
;;     lowest-address-slot first = highest slot idx = exactly reverse push
;;     order) and the trailing `leave` folds to NOTHING (rsp is already at
;;     the return address; the fold amount D+delta must be exactly 0),
;;   * rewrites a bare `leave` (mov-restore epilogues, whose restore movs were
;;     deleted) to `addq $(S+delta), %rsp` + the full popq run.
;; Frame model: total displacement D = 8*n + S with S = frame + (n odd ? 0 : 8)
;; so D % 16 == 8 exactly like the old subq $(frame+8) -- call alignment holds.
;; The pushes occupy [entry_rsp-8n, entry_rsp-8), so local slots shift down 8n:
;;   negative K:  -K(%rbp) -> (S + delta - K)(%rsp)      (bias_neg = S)
;;   positive X:  +X(%rbp) -> (S + 8n - 8 + delta + X)(%rsp)  (bias_pos; the
;;     incoming-arg area is caller memory at fixed absolute addresses)
;; (n = 0 keeps the stage-2 single-bias formulas byte-identical.)
;; Soundness of the line classification: the ONLY emitters that reference the
;; callee-save slots (offset -(8*(slot-vars+idx+1)), idx in the plan-saved set)
;; are emit-save-callee-reg / emit-restore-callee-reg / the pop-run leaq --
;; group word1 slots start at frame-slots+1 (above every reserved CSR slot) and
;; emergency slots sit below frame-slots-emergency-max, so a saved-CSR-slot
;; offset is unambiguous. Any OTHER line shape referencing one fails the audit
;; (keep-rbp fallback on the ORIGINAL text stays correct: mov saves intact).
;; Win64 uses the same conversion, with every prologue push described by
;; `.seh_pushreg` and no `.seh_setframe`. Saved-CSR names are indexed by
;; ABI-specific callee-save slot: common 0..4 = r12..r15,rbx; Linux 5 = rbp;
;; Win64 5..7 = rsi,rdi,rbp. "" = not saved.
(define (compiler-backend-rsp-rebase-make-push-regs) : (Array String)
  (let
    [regs : (Array String) (make-array String 8)]
    [idx : i64 0]
    (begin
      (while (< idx (array-length regs))
        (begin
          (array-set! regs idx "")
          (set! idx (+ idx 1))))
      regs)))

;; Shared no-push array for the stage-1 / adapter / fallback call sites.
(define compiler-backend-rsp-rebase-no-push : (Array String)
  (compiler-backend-rsp-rebase-make-push-regs))

;; Fill `regs` with the plan-saved CSR names (slot-idx order); returns the
;; count. The set is a pure function of the allocator plan (the scavenger only
;; hands out plan-saved callee regs; emergency picks are wrapped locally), so
;; it is fixed before body emission and matches every inline restore site.
(define (compiler-backend-fill-push-csr-regs!
  [assignments : CompilerRegAssignmentList]
  [regs : (Array String)]) : i64
  (let
    [names : (Array String) (make-array String 8)]
    [idx : i64 0]
    [count : i64 0]
    (begin
      (array-set! names 0 "%r12")
      (array-set! names 1 "%r13")
      (array-set! names 2 "%r14")
      (array-set! names 3 "%r15")
      (array-set! names 4 "%rbx")
      (if (compiler-backend-current-fn-win64?)
        (begin
          (array-set! names 5 "%rsi")
          (array-set! names 6 "%rdi")
          (array-set! names 7 "%rbp"))
        (begin
          (array-set! names 5 "%rbp")
          (array-set! names 6 "")
          (array-set! names 7 "")))
      (while (< idx (array-length names))
        (begin
          (if (compiler-backend-callee-needs-save?
            assignments
            (array-ref names idx))
            (begin
              (array-set! regs idx (array-ref names idx))
              (set! count (+ count 1)))
            (array-set! regs idx ""))
          (set! idx (+ idx 1))))
      count)))

;; The prologue subq constant S under n pushes: frame + pad where pad keeps
;; the total displacement (8n + S) % 16 == 8 (frame is a 16-multiple), i.e.
;; the same call alignment as the no-push `subq $(frame+8)`.
(define (compiler-backend-rsp-rebase-push-sub [frame : i64] [push-count : i64]) : i64
  (if (and compiler-backend-fpo-bare-frame (= push-count 0))
    0
    (+
      frame
      (if (= (bit-and push-count 1) 1)
        0
        8))))

;; The popq run restoring the pushed CSRs: highest slot idx first (lowest
;; address = last pushed), matching the existing pop-run epilogue order.
;; Lines joined by newlines with NO trailing newline (append-line adds it).
(define (compiler-backend-rsp-rebase-pop-run [push-regs : (Array String)]) : String
  (let
    [idx : i64 (- (array-length push-regs) 1)]
    [acc : String ""]
    (begin
      (while (>= idx 0)
        (begin
          (if (string.eq (array-ref push-regs idx) "")
            unit
            (set!
              acc
              (str_cat.str-cat
                acc
                (if (string.eq acc "")
                  ""
                  "\n")
                "    popq "
                (array-ref push-regs idx)
                "")))
          (set! idx (- idx 1))))
      acc)))

;; Classify a line whose first frame ref hits a SAVED callee-save slot
;; (push mode only). Returns:
;;   0 = not a saved-CSR-slot line (normal handling)
;;   1 = CSR save/restore movq (delete)
;;   2 = pop-run entry `leaq CSRSLOT(%rbp), %rsp`
;;   3 = malformed saved-CSR-slot reference (fail the audit)
(define (compiler-backend-rsp-rebase-csr-classify
  [data : (Ptr u8)]
  [line-start : i64]
  [m : i64]
  [te : i64]
  [end : i64]
  [mnemonic-kind : i64]
  [push-regs : (Array String)]
  [slot-vars : i64]) : i64
  (let
    [p : i64 (compiler-backend-rsp-rebase-find-rbp data m end)]
    (if (or
      (< p 0)
      (>= (+ p 5) end)
      (not (= (compiler-backend-peephole-byte-at data (+ p 5)) 41)))
      0
      (let
        [ks : i64 (compiler-backend-rsp-rebase-int-start data line-start p)]
        (if (< ks 0)
          0
          (let
            [k : i64 (compiler-backend-rsp-rebase-parse-int data ks p)]
            (if (>= k 0)
              0
              (let
                [unit-idx : i64 (/ (- 0 k) 8)]
                (if (not (= (* unit-idx 8) (- 0 k)))
                  0
                  (let
                    [idx : i64 (- unit-idx (+ slot-vars 1))]
                    (if (or (< idx 0) (>= idx (array-length push-regs)))
                      0
                      (let
                        [reg : String (array-ref push-regs idx)]
                        (if (string.eq reg "")
                          0
                          (cond
                            [(=
                                mnemonic-kind
                                compiler-backend-control-mnemonic-movq)
                              ;; restore: movq -K(%rbp), %rXX
                              (if (and
                                (= ks (+ te 1))
                                (= (+ p 12) end)
                                (=
                                  (compiler-backend-peephole-byte-at
                                    data
                                    (+ p 6))
                                  44)
                                (=
                                  (compiler-backend-peephole-byte-at
                                    data
                                    (+ p 7))
                                  32)
                                (compiler-backend-peephole-range-eq?
                                  data
                                  (+ p 8)
                                  (+ p 12)
                                  reg))
                                1
                                ;; save: movq %rXX, -K(%rbp)
                                (if (and
                                  (= (+ p 6) end)
                                  (compiler-backend-peephole-range-eq?
                                    data
                                    (+ te 1)
                                    (+ te 5)
                                    reg)
                                  (=
                                    (compiler-backend-peephole-byte-at
                                      data
                                      (+ te 5))
                                    44)
                                  (=
                                    (compiler-backend-peephole-byte-at
                                      data
                                      (+ te 6))
                                    32)
                                  (= ks (+ te 7)))
                                  1
                                  3))]
                            [(=
                                mnemonic-kind
                                compiler-backend-control-mnemonic-leaq)
                              ;; pop-run entry: leaq -K(%rbp), %rsp
                              (if (and
                                (= ks (+ te 1))
                                (= (+ p 12) end)
                                (=
                                  (compiler-backend-peephole-byte-at
                                    data
                                    (+ p 6))
                                  44)
                                (=
                                  (compiler-backend-peephole-byte-at
                                    data
                                    (+ p 7))
                                  32)
                                (compiler-backend-peephole-range-eq?
                                  data
                                  (+ p 8)
                                  (+ p 12)
                                  "%rsp"))
                                2
                                3)]
                            [else 3]))))))))))))))

;; Rewrite one function's POST-PROLOGUE text to rsp-relative frame addressing
;; (`X(%rbp)` -> `(frame+delta+X)(%rsp)`); returns the ORIGINAL text when the
;; rsp-constancy audit fails (the function keeps rbp addressing).
;;
;; With `fpo = true` the function is emitted frame-pointer-free. A no-CSR
;; prologue uses `subq $(frame+8), %rsp`; a CSR plan uses push saves plus an
;; aligned sub-allocation. Win64 describes those operations with SEH unwind
;; codes. Differences from the stage-1 (behavior-neutral) mode:
;;   * POSITIVE rbp offsets (incoming stack args 16+8k(%rbp), tail-call final
;;     stack-arg stores) are rebased with the SAME formula -- the virtual rbp
;;     sits at rsp+frame post-prologue in both worlds.
;;   * `leave` becomes `addq $(frame+8+delta), %rsp` (there is no rbp frame to
;;     reset from). Requires a tracked rsp (valid); delta is normally 0.
;;   * the pop-restore epilogue `leaq slot,%rsp; popq CSR...` is TRACKED instead
;;     of ending validity: the leaq operand was just rebased on the same line
;;     (exactly one frame ref), so the new rsp is known (delta goes negative --
;;     the "epilogue tail"); the pops keep decrementing delta and the final
;;     `leave` rewrite folds the remainder. Negative delta stays a hard audit
;;     failure outside this recognized shape.
;;   * any OTHER rsp write (`movq %rbp,%rsp`, untracked leaq) FAILS the audit
;;     (stage 1 merely ended validity) -- without a frame pointer there is no
;;     way to re-establish rsp.
;; On audit failure the caller either re-runs in stage-1 mode (plan has no %rbp
;; home -> keep-rbp, byte-identical) or DEMOTES (re-plans the function without
;; %rbp in the pool and re-emits).
;;
;; #rbp-base invariant: in fpo mode every "(%rbp" occurrence is a frame
;; reference -- %rbp pool VALUES never appear as memory-operand bases (the
;; emitters stage them through a scratch; see address-base-filter) and bare
;; `%rbp` register operands contain no "(%rbp".
;; GAP1: 3-arg spelling for the stage-1 / adapter / fallback call sites --
;; byte-identical to the pre-GAP1 pass (no push mode).
(define (compiler-backend-rsp-rebase [text : String] [frame : i64] [fpo : bool]) : String
  (compiler-backend-rsp-rebase-full
    text
    frame
    fpo
    compiler-backend-rsp-rebase-no-push
    0
    0))

;; True when any block holds a call or syscall: such a function keeps the FPO
;; alignment adjustment.
(define (compiler-backend-blocks-have-call? [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (if (compiler-reg-loop-split-seq-has-call-or-syscall? instrs)
            true
            (compiler-backend-blocks-have-call? (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-blocks-have-call? (compiler-ir-block-seq-to-list seq))]))

(define (compiler-backend-rsp-rebase-full
  [text : String]
  [frame : i64]
  [fpo : bool]
  [push-regs : (Array String)]
  [push-count : i64]
  [slot-vars : i64]) : String
  (let
    [n : i64 (string.string-length text)]
    [data : (Ptr u8)
      (unsafe
        (string-data text))]
    [buf : (text_buf_borrowed.TextBufBorrowed text)
      (text_buf_borrowed.empty-like (& text))]
    [i : i64 0]
    [delta : i64 0]
    [valid : bool true]
    [ok : bool true]
    [tail : bool false]
    [last-noff : i64 -1]
    [ref-count : i64 0]
    ;; GAP1 push mode: prologue = pushes + subq $sub-s; disp = the total
    ;; prologue rsp displacement (plays frame+8's role in the leave fold).
    [pm : bool (and fpo (> push-count 0))]
    ;; Win64 unwind codes describe one fixed post-prologue %rsp. Unlike SysV
    ;; FPO, a Win64 FPO body cannot contain a transient stack dip: any ordinary
    ;; push/pop/sub/add/mov-to-rsp fails the audit. The recognized terminal
    ;; add/pop epilogue is still legal and is synthesized by this pass.
    [seh-fpo : bool (and fpo (compiler-backend-current-fn-win64?))]
    [sub-s : i64 (compiler-backend-rsp-rebase-push-sub frame push-count)]
    [disp : i64 (+ (* push-count 8) sub-s)]
    [bias-neg : i64
      (if pm
        sub-s
        frame)]
    [bias-pos : i64
      (if pm
        (- (+ sub-s (* push-count 8)) 8)
        frame)]
    (begin
      (while (and ok (< i n))
        (let
          [end : i64 (compiler-backend-peephole-line-end data i n)]
          [nl : bool (< end n)]
          [m : i64 i]
          (begin
            (while (and
              (< m end)
              (= (compiler-backend-peephole-byte-at data m) 32))
              (set! m (+ m 1)))
            (if (>= m end)
              ;; blank line
              (set!
                buf
                (compiler-backend-peephole-append-line-range buf text i end nl))
              (if (= (compiler-backend-peephole-byte-at data (- end 1)) 58)
                ;; a label: only reachable at delta 0 (dip windows are
                ;; straight-line); it also re-establishes rsp validity after an
                ;; epilogue's terminal rsp motion.
                (begin
                  (if (and valid (not (= delta 0)))
                    (set! ok false)
                    unit)
                  (set! delta 0)
                  (set! valid true)
                  (set! tail false)
                  (set!
                    buf
                    (compiler-backend-peephole-append-line-range
                      buf
                      text
                      i
                      end
                      nl)))
                (let
                  [tok : i64 (compiler-backend-peephole-token-len data m end)]
                  [te : i64 (+ m tok)]
                  [mnemonic-kind : i64
                    (compiler-backend-control-mnemonic-kind data m tok)]
                  [push? : bool
                    (= mnemonic-kind compiler-backend-control-mnemonic-push)]
                  [pop? : bool
                    (= mnemonic-kind compiler-backend-control-mnemonic-pop)]
                  [leave? : bool
                    (= mnemonic-kind compiler-backend-control-mnemonic-leave)]
                  ;; A raw `syscall` can REPLACE %rsp in a way this textual
                  ;; audit cannot track -- `clone` (syscall 56, the raw-thread
                  ;; spawn) hands the CHILD a fresh stack, and rt_sigreturn loads
                  ;; a saved rsp. After such a syscall rsp is no longer provably
                  ;; rbp-frame, so every post-syscall frame ref rebased to
                  ;; N(%rsp) would read the wrong stack in the child (observed
                  ;; SEGV: thread-linux-spawn marshalled entry/arg/result-addr to
                  ;; child-main via N(%rsp) after clone). Most syscalls (write /
                  ;; read / futex / exit) leave rsp untouched, but the number is
                  ;; not reliably knowable at this text seam, so ANY syscall makes
                  ;; the WHOLE function keep rbp (frame refs via %rbp survive
                  ;; clone in both parent and child -- CLONE_VM shares the address
                  ;; space and rbp is never in clone's register set; byte-
                  ;; identical to pre-FPO for that function -- the sound choice).
                  [syscall? : bool
                    (= mnemonic-kind compiler-backend-control-mnemonic-syscall)]
                  [rsp-dst? : bool
                    (and
                      (>= (- end i) 6)
                      (compiler-backend-peephole-range-eq?
                        data
                        (- end 6)
                        end
                        ", %rsp"))]
                  ;; GAP1 push mode: classify saved-CSR-slot lines FIRST --
                  ;; the save/restore movs are deleted (the prologue pushes /
                  ;; epilogue pops replace them) and the pop-run leaq is
                  ;; redirected at the pushed area. Only when rsp is tracked
                  ;; (an untracked CSR ref falls through and fails like any
                  ;; other frame ref).
                  [csr-kind : i64
                    (if (and pm valid)
                      (compiler-backend-rsp-rebase-csr-classify
                        data
                        i
                        m
                        te
                        end
                        mnemonic-kind
                        push-regs
                        slot-vars)
                      0)]
                  (begin
                    (set! last-noff -1)
                    (set! ref-count 0)
                    ;; Unprovable rsp shape -> keep rbp for the whole
                    ;; function (audit fail). ok=false terminates the pass loop;
                    ;; the caller falls back to rbp addressing (or demotes an
                    ;; rbp-planned function). Placed before the per-line frame /
                    ;; rsp logic: a syscall line carries no frame ref, so the
                    ;; remaining arms are inert on it.
                    (if syscall?
                      (set! ok false)
                      unit)
                    (if (and
                      seh-fpo
                      (or
                        push?
                        (and pop? (not tail))
                        (and rsp-dst? (not (= csr-kind 2)))))
                      (set! ok false)
                      unit)
                    ;; lint-allow: nested-if-ladder
                    (if (= csr-kind 1)
                      ;; CSR save/restore movq: drop the line.
                      unit
                      (if (= csr-kind 2)
                        ;; pop-run entry: point rsp at the pushed area
                        ;; (entry_rsp - 8n = rsp_f + sub-s); the following
                        ;; pops restore the pushed CSRs in reverse push
                        ;; order and the final leave folds to 0.
                        (if tail
                          (set! ok false)
                          (begin
                            (set!
                              buf
                              (compiler-backend-peephole-append-line
                                buf
                                (str_cat.str-cat
                                  "    addq $"
                                  (string.int->string (+ sub-s delta))
                                  ", %rsp")
                                nl))
                            (set! tail true)
                            (set! delta (- 0 sub-s))))
                        (if (= csr-kind 3)
                          ;; unrecognized saved-CSR-slot reference: the slot
                          ;; is unwritten under push saves -- keep rbp.
                          (set! ok false)
                          (begin
                            ;; popq MEM computes its address AFTER the rsp increment.
                            (if (and valid pop?)
                              (begin
                                (set! delta (- delta 8))
                                ;; negative delta is legal only inside the FPO epilogue
                                ;; tail (the pops after a rebased `leaq slot,%rsp`).
                                (if (and (< delta 0) (not (and fpo tail)))
                                  (set! ok false)
                                  unit))
                              unit)
                            (if (and fpo leave?)
                              ;; FPO: no rbp frame to `leave` from -- unwind rsp
                              ;; directly (prologue reserved frame+8, push mode
                              ;; 8n+sub-s; a negative delta folds the pop-restore
                              ;; epilogue tail when present).
                              (begin
                                ;; lint-allow: nested-if-ladder
                                (if (not valid)
                                  (set! ok false)
                                  (if (and pm tail)
                                    ;; GAP1 push mode after a pop run: every pushed
                                    ;; CSR was popped, rsp already sits at the return
                                    ;; address -- the fold must be EXACTLY 0 and the
                                    ;; leave vanishes.
                                    (if (= (+ disp delta) 0)
                                      unit
                                      (set! ok false))
                                    (if pm
                                      ;; GAP1 push mode, mov-restore epilogue (the
                                      ;; restore movs were deleted): deallocate the
                                      ;; subq area and pop the pushed CSRs.
                                      (let
                                        [amount : i64 (+ sub-s delta)]
                                        (if (< amount 0)
                                          (set! ok false)
                                          (set!
                                            buf
                                            (compiler-backend-peephole-append-line
                                              buf
                                              (str_cat.str-cat
                                                (if (= amount 0)
                                                  ""
                                                  (str_cat.str-cat
                                                    "    addq $"
                                                    (string.int->string amount)
                                                    ", %rsp\n"))
                                                (compiler-backend-rsp-rebase-pop-run
                                                  push-regs)
                                                "")
                                              nl))))
                                      (let
                                        [amount : i64
                                          (if compiler-backend-fpo-bare-frame
                                            delta
                                            (+ (+ frame 8) delta))]
                                        (if (< amount 0)
                                          (set! ok false)
                                          (if (= amount 0)
                                            unit
                                            (set!
                                              buf
                                              (compiler-backend-peephole-append-line
                                                buf
                                                (str_cat.str-cat
                                                  "    addq $"
                                                  (string.int->string amount)
                                                  ", %rsp")
                                                nl))))))))
                                (set! valid false)
                                (set! tail false))
                              (begin
                                ;; frame-reference rewrite
                                (let
                                  [p : i64
                                    (compiler-backend-rsp-rebase-find-rbp
                                      data
                                      m
                                      end)]
                                  (if (< p 0)
                                    (set!
                                      buf
                                      (compiler-backend-peephole-append-line-range
                                        buf
                                        text
                                        i
                                        end
                                        nl))
                                    (if (not valid)
                                      (set! ok false)
                                      (let
                                        [cursor : i64 i]
                                        (begin
                                          (while (and ok (>= p 0))
                                            (begin
                                              (if (or
                                                (>= (+ p 5) end)
                                                (not
                                                  (=
                                                    (compiler-backend-peephole-byte-at
                                                      data
                                                      (+ p 5))
                                                    41)))
                                                ;; "(%rbp," indexed or truncated
                                                (set! ok false)
                                                (let
                                                  [ks : i64
                                                    (compiler-backend-rsp-rebase-int-start
                                                      data
                                                      i
                                                      p)]
                                                  (if (< ks 0)
                                                    ;; bare "(%rbp)"
                                                    (set! ok false)
                                                    (let
                                                      [k : i64
                                                        (compiler-backend-rsp-rebase-parse-int
                                                          data
                                                          ks
                                                          p)]
                                                      (if (and
                                                        (>= k 0)
                                                        (not fpo))
                                                        ;; incoming stack-arg slot: keep
                                                        ;; rbp (stage 1 -- %rbp is live).
                                                        ;; In FPO mode positive offsets
                                                        ;; rebase with the SAME formula
                                                        ;; (virtual rbp = rsp+frame).
                                                        unit
                                                        (let
                                                          ;; GAP1 push mode: negative
                                                          ;; (local) offsets shift down by
                                                          ;; the pushed bytes (bias sub-s);
                                                          ;; positive (incoming-arg)
                                                          ;; offsets keep their absolute
                                                          ;; caller-side addresses (bias
                                                          ;; sub-s+8n-8). Both equal
                                                          ;; `frame` when push-count = 0.
                                                          [noff : i64
                                                            (+
                                                              (+
                                                                (if (>= k 0)
                                                                  bias-pos
                                                                  bias-neg)
                                                                delta)
                                                              k)]
                                                          (if (< noff 0)
                                                            (set! ok false)
                                                            (begin
                                                              (set!
                                                                buf
                                                                (compiler-backend-peephole-append-line-range
                                                                  buf
                                                                  text
                                                                  cursor
                                                                  ks
                                                                  false))
                                                              (set!
                                                                buf
                                                                (text_buf_borrowed.append-owned
                                                                  buf
                                                                  (string.int->string
                                                                    noff)))
                                                              (set!
                                                                buf
                                                                (text_buf_borrowed.append-owned
                                                                  buf
                                                                  "(%rsp)"))
                                                              (set!
                                                                last-noff
                                                                noff)
                                                              (set!
                                                                ref-count
                                                                (+ ref-count 1))
                                                              (set!
                                                                cursor
                                                                (+ p 6))))))))))
                                              (set!
                                                p
                                                (if ok
                                                  (compiler-backend-rsp-rebase-find-rbp
                                                    data
                                                    (+ p 6)
                                                    end)
                                                  -1))))
                                          (if ok
                                            (set!
                                              buf
                                              (compiler-backend-peephole-append-line-range
                                                buf
                                                text
                                                cursor
                                                end
                                                nl))
                                            unit))))))
                                ;; pushq MEM computes its address BEFORE the rsp decrement.
                                (if (and valid push?)
                                  (set! delta (+ delta 8))
                                  unit)
                                ;; explicit %rsp writes
                                (if (and rsp-dst? (not pop?))
                                  ;; lint-allow: nested-if-ladder
                                  (if (and
                                    valid
                                    (=
                                      mnemonic-kind
                                      compiler-backend-control-mnemonic-subq)
                                    (< (+ te 1) end)
                                    (=
                                      (compiler-backend-peephole-byte-at
                                        data
                                        (+ te 1))
                                      36))
                                    (set!
                                      delta
                                      (+
                                        delta
                                        (compiler-backend-rsp-rebase-parse-int
                                          data
                                          (+ te 2)
                                          (- end 6))))
                                    (if (and
                                      valid
                                      (=
                                        mnemonic-kind
                                        compiler-backend-control-mnemonic-addq)
                                      (< (+ te 1) end)
                                      (=
                                        (compiler-backend-peephole-byte-at
                                          data
                                          (+ te 1))
                                        36))
                                      (begin
                                        (set!
                                          delta
                                          (-
                                            delta
                                            (compiler-backend-rsp-rebase-parse-int
                                              data
                                              (+ te 2)
                                              (- end 6))))
                                        (if (< delta 0)
                                          (set! ok false)
                                          unit))
                                      (if fpo
                                        ;; FPO: only the pop-restore epilogue's
                                        ;; `leaq slot,%rsp` is provable -- the slot operand
                                        ;; was rebased on THIS line (exactly one frame
                                        ;; ref), so the new rsp is P + last-noff, i.e.
                                        ;; delta -= last-noff (the epilogue tail). Any
                                        ;; other rsp write is unrecoverable without a
                                        ;; frame pointer.
                                        (if (and
                                          valid
                                          (not tail)
                                          (= ref-count 1)
                                          (=
                                            mnemonic-kind
                                            compiler-backend-control-mnemonic-leaq))
                                          (begin
                                            (set! tail true)
                                            (set! delta (- delta last-noff)))
                                          (set! ok false))
                                        ;; unknown rsp write (leaq slot,%rsp epilogue,
                                        ;; movq %rbp,%rsp, ...): rsp no longer tracked.
                                        (set! valid false))))
                                  unit)
                                (if leave?
                                  (set! valid false)
                                  unit)))))))))))
            (set!
              i
              (if (< end n)
                (+ end 1)
                end)))))
      (if ok
        (begin
          (set! compiler-backend-rsp-rebase-last-ok true)
          (set!
            compiler-backend-rsp-rebase-ok-count
            (+ compiler-backend-rsp-rebase-ok-count 1))
          (text_buf_borrowed.render buf))
        (begin
          (set! compiler-backend-rsp-rebase-last-ok false)
          (set!
            compiler-backend-rsp-rebase-keep-count
            (+ compiler-backend-rsp-rebase-keep-count 1))
          text)))))

;; ============================================================================
;; GAP5: post-emission dead frame-store sweep.
;;
;; M-B elided IR-dead call-result stores, but a store whose every READ was
;; register-forwarded by the owner-map peephole (or that was asm-dead all
;; along, e.g. a syscall-result store whose return reload collapsed to an
;; elided self-move) is invisible at IR level. This pass runs on the FINAL
;; program text (after the peephole fixpoint) and deletes
;; `movq %rX|$imm, N(%rsp)` stores to LOCAL VAR-REGION frame slots that are
;; never read anywhere in the function body. It participates for Linux FPO
;; functions and for Win64 rbp-framed functions whose negative frame slots were
;; successfully rebased to rsp-relative text.
;;
;; Soundness ledger (conservative-by-class; when in doubt the store stays):
;;  * Only functions that passed an rsp-rebase audit participate.
;;    emit-function records (symbol, lo, hi, disp) into POINTER-FREE global
;;    tables (an `(Array String)` global dangles by peephole time -- the
;;    carry-safe lesson) where [lo, hi] is the VAR-REGION slot-start span in
;;    canonical (delta-0, rsp-relative) bytes: lo = bias_neg - 8*slot-vars,
;;    hi = bias_neg - 8 with bias_neg = sub-s (push mode) / frame -- exactly
;;    the rebase pass's negative-offset bias. The CSR save area, group word1
;;    region and emergency slots all sit at LARGER frame depths (canonical
;;    < lo); outgoing stack args (`(shadow+8k)(%rsp)`), c-abi dip windows and
;;    phi cycle-break push slots sit below the locals (canonical
;;    < outgoing+extra <= lo); rebased POSITIVE offsets (incoming stack args,
;;    tail-call stack-arg stores = caller memory) sit at canonical > hi. A
;;    candidate must land on an 8-aligned slot inside [lo, hi], so every
;;    protected class is excluded by construction.
;;  * The per-line rsp delta is re-tracked exactly like the audit that
;;    already validated this function: the region starts at delta = -disp so
;;    the prologue's pushes + subq land the body at 0; labels reset to 0;
;;    subq/addq $imm, %rsp and push/pop are tracked -- so refs inside c-abi
;;    dip windows canonicalize correctly.
;;  * Reads: EVERY frame ref that is not itself a candidate store marks
;;    [C, C+w) read, w = 16/32/64 when the line mentions %xmm/%ymm/%zmm (64
;;    for unmatched v*/k* vector mnemonics), else 8 -- a 16-byte movups
;;    covering two slots protects both. Presence-of-a-read ANYWHERE keeps all
;;    stores to the slot: no text-level flow analysis, so loops, shared
;;    epilogues and jump-table arms are covered by the whole-function scan.
;;  * Win64 keeps the rbp frame for SEH unwind (`pushq %rbp; movq %rsp,%rbp;
;;    subq $frame,%rsp`, `.seh_*` directives, `leave`). The unwind metadata
;;    describes prologue actions only; it does not expose local var slots to
;;    the runtime. For Win64 records the scanner therefore admits the rbp-set
;;    prologue line, terminal CSR pop-run `leaq K(%rsp),%rsp` where K is below
;;    the var span, and `leave`. Any non-terminal untracked rsp mutation still
;;    disables the function.
;;  * Address-taken slots: `leaq N(%rsp)` poisons every slot at canonical
;;    >= N-delta (an object pointer only ever indexes upward: gep field and
;;    element offsets are non-negative). Indexed rsp addressing "(%rsp,",
;;    popq with a frame operand (post-increment addressing), bare %rsp
;;    outside a tracked subq/addq dst or the proven Win64 prologue/epilogue
;;    shapes, and any other untracked rsp write each disable the WHOLE function.
;;  * Only whole `movq SRC, N(%rsp)` lines are removed, SRC a single %reg
;;    (not %rsp) or $imm token: a pure 8-byte store to a private, never-read,
;;    never-address-taken local slot has no observable effect (the runtime
;;    has no GC stack walk -- the M-B argument).
;; Driven from compiler-backend-peephole-asm (all text-emission paths); with
;; an empty metadata table (hand-written text or raw peephole callers) the
;; pass returns its input unchanged.
(define compiler-backend-sweep-capacity : i64
  131072)
(define compiler-backend-sweep-bytes-capacity : i64
  8388608)
(define compiler-backend-sweep-sym-off : (Array i64)
  (array.make-array i64 compiler-backend-sweep-capacity))
(define compiler-backend-sweep-sym-len : (Array i64)
  (array.make-array i64 compiler-backend-sweep-capacity))
(define compiler-backend-sweep-lo-arr : (Array i64)
  (array.make-array i64 compiler-backend-sweep-capacity))
(define compiler-backend-sweep-hi-arr : (Array i64)
  (array.make-array i64 compiler-backend-sweep-capacity))
(define compiler-backend-sweep-disp-arr : (Array i64)
  (array.make-array i64 compiler-backend-sweep-capacity))
(define compiler-backend-sweep-win64-arr : (Array i64)
  (array.make-array i64 compiler-backend-sweep-capacity))

;; Emergency-slot window [em-lo, em-hi] in the same canonical delta-0
;; rsp-relative bytes as [lo, hi]. Empty (em-lo > em-hi) when the function used
;; no emergency scavenge slots or has outgoing stack-arg space (whose callee
;; reads are invisible to the text scan and may alias the emergency window).
(define compiler-backend-sweep-em-lo-arr : (Array i64)
  (array.make-array i64 compiler-backend-sweep-capacity))
(define compiler-backend-sweep-em-hi-arr : (Array i64)
  (array.make-array i64 compiler-backend-sweep-capacity))
(define compiler-backend-sweep-sym-bytes : (Array u8)
  (array.make-array u8 compiler-backend-sweep-bytes-capacity))
(define compiler-backend-sweep-sym-bytes-count : i64
  0)
(define compiler-backend-sweep-count : i64
  0)
(define compiler-backend-sweep-swept-stores : i64
  0)
(define compiler-backend-sweep-swept-funcs : i64
  0)
(define compiler-backend-sweep-dropped-funcs : i64
  0)
(define compiler-backend-sweep-dropped-table-cap : i64
  0)
(define compiler-backend-sweep-dropped-bytes-cap : i64
  0)

;; Sentinel for "this line is not a candidate store".
(define compiler-backend-sweep-no-candidate : i64
  -4611686018427387904)

;; Per-line sweep classes stored on the record (`sweep-kind`).
;;  * Skip: blank lines, `.`-directives and `#` comments -- invisible to the
;;    scan, exactly like the byte walk's `unit` arms.
;;  * Label: resets the running rsp delta to 0 (or ends a Win64 tail).
;;  * Instruction: everything else; `sweep-flags` and the offset fields below
;;    describe it.
(define compiler-backend-sweep-line-kind-skip : i64
  0)
(define compiler-backend-sweep-line-kind-label : i64
  1)
(define compiler-backend-sweep-line-kind-instruction : i64
  2)

;; Packed delta-independent predicates for one instruction line (`sweep-flags`).
;; `win64-rbp-set` is the SHAPE only (`movq %rsp, %rbp`); the Win64 gate is
;; applied by the sweep, which alone knows the function's record.
(define compiler-backend-sweep-line-flag-push : i64
  1)
(define compiler-backend-sweep-line-flag-pop : i64
  2)
(define compiler-backend-sweep-line-flag-leaq : i64
  4)
(define compiler-backend-sweep-line-flag-leave : i64
  8)
(define compiler-backend-sweep-line-flag-ret : i64
  16)
(define compiler-backend-sweep-line-flag-jmp : i64
  32)
(define compiler-backend-sweep-line-flag-subq : i64
  64)
(define compiler-backend-sweep-line-flag-rsp-dst : i64
  128)
(define compiler-backend-sweep-line-flag-tracked-rsp-write : i64
  256)
(define compiler-backend-sweep-line-flag-win64-rbp-set : i64
  512)

;; An indexed / truncated `(%rsp` reference, or a `popq` whose operand
;; addresses the frame: both disable the whole function unconditionally.
(define compiler-backend-sweep-line-flag-fatal-mem : i64
  1024)

;; Bare `%rsp` occurrences, split by whether they sit at the line's final
;; operand position (`, %rsp`), which is the only position the tracked
;; subq/addq and Win64 epilogue shapes may write.
(define compiler-backend-sweep-line-flag-bare-rsp : i64
  2048)
(define compiler-backend-sweep-line-flag-bare-rsp-tail : i64
  4096)

(define (compiler-backend-sweep-line-flag? [flags : i64] [flag : i64]) : bool
  (not (= (bit-and flags flag) 0)))

(define (compiler-backend-sweep-reset!) : unit
  (begin
    (set! compiler-backend-sweep-count 0)
    (set! compiler-backend-sweep-sym-bytes-count 0)
    (set! compiler-backend-sweep-swept-stores 0)
    (set! compiler-backend-sweep-swept-funcs 0)
    (set! compiler-backend-sweep-dropped-funcs 0)
    (set! compiler-backend-sweep-dropped-table-cap 0)
    (set! compiler-backend-sweep-dropped-bytes-cap 0)))

;; Record one FPO-audited function's sweep metadata. A full table silently
;; drops the entry (the function is simply not swept -- sound).
(define (compiler-backend-sweep-record!
  [symbol : String]
  [lo : i64]
  [hi : i64]
  [disp : i64]
  [em-lo : i64]
  [em-hi : i64]
  [win64 : bool]) : unit
  (let
    [len : i64 (string.string-length symbol)]
    [sdata : (Ptr u8)
      (unsafe
        (string-data symbol))]
    [start : i64 compiler-backend-sweep-sym-bytes-count]
    (if (or
      (>= compiler-backend-sweep-count compiler-backend-sweep-capacity)
      (> (+ start len) compiler-backend-sweep-bytes-capacity))
      (begin
        (set!
          compiler-backend-sweep-dropped-funcs
          (+ compiler-backend-sweep-dropped-funcs 1))
        (if (>= compiler-backend-sweep-count compiler-backend-sweep-capacity)
          (set!
            compiler-backend-sweep-dropped-table-cap
            (+ compiler-backend-sweep-dropped-table-cap 1))
          unit)
        (if (> (+ start len) compiler-backend-sweep-bytes-capacity)
          (set!
            compiler-backend-sweep-dropped-bytes-cap
            (+ compiler-backend-sweep-dropped-bytes-cap 1))
          unit))
      (let
        [j : i64 0]
        [idx : i64 compiler-backend-sweep-count]
        (begin
          (while (< j len)
            (begin
              (array-set!
                compiler-backend-sweep-sym-bytes
                (+ start j)
                (cast (compiler-backend-peephole-byte-at sdata j) : u8))
              (set! j (+ j 1))))
          (array-set! compiler-backend-sweep-sym-off idx start)
          (array-set! compiler-backend-sweep-sym-len idx len)
          (array-set! compiler-backend-sweep-lo-arr idx lo)
          (array-set! compiler-backend-sweep-hi-arr idx hi)
          (array-set! compiler-backend-sweep-disp-arr idx disp)
          (array-set!
            compiler-backend-sweep-win64-arr
            idx
            (if win64
              1
              0))
          (array-set! compiler-backend-sweep-em-lo-arr idx em-lo)
          (array-set! compiler-backend-sweep-em-hi-arr idx em-hi)
          (set! compiler-backend-sweep-sym-bytes-count (+ start len))
          (set! compiler-backend-sweep-count (+ idx 1)))))))

;; Compute [lo, hi] (the VAR-REGION slot-start span in canonical delta-0
;; rsp-relative bytes) and disp (total prologue rsp displacement) for one
;; FPO-audited function, then record it. Mirrors the rebase pass's biases:
;;   push mode (push-count > 0): bias_neg = sub-s, disp = 8n + sub-s
;;   plain FPO (push-count = 0):  bias_neg = frame, disp = frame + 8
;; lo = bias_neg - 8*slot-vars (deepest var slot), hi = bias_neg - 8 (var 0).
;; Every protected slot class sits at canonical < lo (CSR/group-word1/
;; emergency/outgoing) or > hi (positive incoming/tail stack args).
(define (compiler-backend-sweep-record-fpo!
  [symbol : String]
  [frame : i64]
  [push-count : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]) : unit
  (let
    [sub-s : i64 (compiler-backend-rsp-rebase-push-sub frame push-count)]
    [pm : bool (> push-count 0)]
    [bias-neg : i64
      (if pm
        sub-s
        frame)]
    [disp : i64
      (if pm
        (+ (* push-count 8) sub-s)
        (+ frame 8))]
    ;; Emergency scavenge slots live at rbp offset em-slot-offset - 64*i for
    ;; i in [0, em-used-count); canonical = bias_neg + (negative rbp offset).
    ;; They are read only by their own restores (visible in the text), EXCEPT
    ;; when the function has outgoing stack-arg space: arg slots share the
    ;; frame bottom and are read by callees, so the window stays empty then.
    [em-hi : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (+
          (+ bias-neg em-slot-offset)
          (- (compiler-backend-emergency-slot-size) 8))
        0)]
    [em-lo : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (-
          (+ bias-neg em-slot-offset)
          (* (compiler-backend-emergency-slot-size) (- em-used-count 1)))
        8)]
    (compiler-backend-sweep-record!
      symbol
      (- bias-neg (* 8 slot-vars))
      (- bias-neg 8)
      disp
      em-lo
      em-hi
      (compiler-backend-current-fn-win64?))))

;; Compute [lo, hi] and disp for one Win64 rbp-framed function whose negative
;; rbp frame refs were successfully rebased to rsp-relative text. The body sees
;; rsp at rbp-frame, while the scanner starts before the prologue:
;; pushq %rbp (+8) plus subq $frame means disp = frame + 8.
(define (compiler-backend-sweep-record-win64!
  [symbol : String]
  [frame : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]) : unit
  (let
    [em-hi : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (+
          (+ frame em-slot-offset)
          (- (compiler-backend-emergency-slot-size) 8))
        0)]
    [em-lo : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (-
          (+ frame em-slot-offset)
          (* (compiler-backend-emergency-slot-size) (- em-used-count 1)))
        8)]
    (compiler-backend-sweep-record!
      symbol
      (- frame (* 8 slot-vars))
      (- frame 8)
      (+ frame 8)
      em-lo
      em-hi
      true)))

;; Commit census and sweep state only for the layout that emit-function returns.
;; Shrink-wrap fallback retries can change the prologue push count and frame
;; displacement, so a discarded attempt must never enter the ordered sweep
;; metadata stream.
(define (compiler-backend-commit-frame-layout!
  [target : CompilerBackendTarget]
  [assignments : CompilerRegAssignmentList]
  [symbol : String]
  [frame : i64]
  [push-count : i64]
  [slot-vars : i64]
  [outgoing : i64]
  [fpo-ok : bool]
  [rebase-ok : bool]
  [shrinkwrap-active? : bool]) : unit
  (begin
    (if fpo-ok
      (begin
        (set! compiler-backend-fpo-count (+ compiler-backend-fpo-count 1))
        (if (> push-count 0)
          (set!
            compiler-backend-fpo-push-count
            (+ compiler-backend-fpo-push-count 1))
          unit)
        (if (compiler-backend-plan-uses-reg? assignments "%rbp")
          (set!
            compiler-backend-fpo-rbp-plan-count
            (+ compiler-backend-fpo-rbp-plan-count 1))
          unit))
      unit)
    ;; The sweep's displacement model starts at a function-entry prologue.
    ;; Keep shrink-wrapped interior prologues conservatively excluded.
    (cond
      [shrinkwrap-active? unit]
      [fpo-ok
        (compiler-backend-sweep-record-fpo!
          symbol
          frame
          push-count
          slot-vars
          compiler-backend-emergency-slot-offset
          compiler-backend-emergency-used-count
          outgoing)]
      [(and (compiler-backend-target-windows? target) rebase-ok)
        (compiler-backend-sweep-record-win64!
          symbol
          frame
          slot-vars
          compiler-backend-emergency-slot-offset
          compiler-backend-emergency-used-count
          outgoing)]
      [else unit])))

;; Append `v` at `count` into a growable i64 scratch array; returns the
;; (possibly reallocated) array. The caller advances its own count.
(define (compiler-backend-sweep-i64-push
  [arr : (Array i64)]
  [count : i64]
  [v : i64]) : (Array i64)
  (if (< count (array-length arr))
    (begin
      (array-set! arr count v)
      arr)
    (let
      [old : i64 (array-length arr)]
      [ncap : i64
        (if (< old 64)
          128
          (* old 2))]
      [na : (Array i64) (make-array i64 ncap)]
      [k : i64 0]
      (begin
        (while (< k count)
          (begin
            (array-set! na k (array-ref arr k))
            (set! k (+ k 1))))
        (array-set! na count v)
        na))))

;; True iff the line [ls,le) is exactly "<sym>:" for metadata entry `idx`.
(define (compiler-backend-sweep-label-matches?
  [data : (Ptr u8)]
  [ls : i64]
  [le : i64]
  [idx : i64]) : bool
  (let
    [off : i64 (array-ref compiler-backend-sweep-sym-off idx)]
    [len : i64 (array-ref compiler-backend-sweep-sym-len idx)]
    (if (not (= (- le ls) (+ len 1)))
      false
      (if (not (= (compiler-backend-peephole-byte-at data (- le 1)) 58))
        false
        (let
          [j : i64 0]
          [ok : bool true]
          (begin
            (while (and ok (< j len))
              (begin
                (if (=
                  (compiler-backend-peephole-byte-at data (+ ls j))
                  (cast
                    (array-ref compiler-backend-sweep-sym-bytes (+ off j))
                    : i64))
                  unit
                  (set! ok false))
                (set! j (+ j 1))))
            ok))))))

;; First record at/after `start` whose trimmed content begins ".globl" (the next
;; function/helper boundary); returns that record's index, or `count`. The probe
;; is a packed bit decided once, when the record was built.
(define (compiler-backend-sweep-region-end-records
  [recs : (Array CompilerBackendPeepholeLineRecord)]
  [start : i64]
  [count : i64]) : i64
  (let
    [i : i64 start]
    (begin
      (while (< i count)
        (begin
          (when
            (compiler-backend-peephole-record-globl? (array-ref recs i))
            (return i))
          (set! i (+ i 1))))
      count)))

;; Conservative byte width of the memory access on line [m,end): 16/32/64 when
;; a %xmm/%ymm/%zmm operand appears, 64 for unmatched vector/mask mnemonics
;; (v*/k*), else 8 (GP memory operands never exceed 8 bytes).
;; Jumps between '%' bytes with memchr instead of stepping every byte.
(define (compiler-backend-sweep-line-width
  [data : (Ptr u8)]
  [m : i64]
  [end : i64]) : i64
  (let
    [w : i64 0]
    [j : i64 m]
    [b0 : i64 (compiler-backend-peephole-byte-at data m)]
    [done : bool false]
    (begin
      (while (and (not done) (< (+ j 1) end))
        (let
          [offset : i64
            (unsafe
              (compiler-backend-runtime-index-of-byte
                (ptr-offset data j)
                (- (- end 1) j)
                (cast 37 : u8)))]
          (if (< offset 0)
            (set! done true)
            (begin
              (set! j (+ j offset))
              (let
                [nb : i64 (compiler-backend-peephole-byte-at data (+ j 1))]
                ;; lint-allow: nested-if-ladder
                (if (= nb 122)
                  (set! w 64)
                  (if (= nb 121)
                    (if (< w 32)
                      (set! w 32)
                      unit)
                    (if (= nb 120)
                      (if (< w 16)
                        (set! w 16)
                        unit)
                      unit))))
              (set! j (+ j 1))))))
      ;; lint-allow: nested-if-ladder
      (if (> w 0)
        w
        (if (or (= b0 118) (= b0 107))
          64
          8)))))

;; First '%' index in [start, end-4], or -1: every position that can start a
;; four-byte "%rsp" reference. Jumps straight to it with memchr.
(define (compiler-backend-sweep-next-percent
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [offset : i64
      (unsafe
        (compiler-backend-runtime-index-of-byte
          (ptr-offset data start)
          (- (- end 3) start)
          (cast 37 : u8)))]
    (if (< offset 0)
      -1
      (+ start offset))))

;; If line [m,end) (mnemonic token ending at te) is exactly
;; `movq SRC, N(%rsp)` with SRC a single %reg (not %rsp) or $imm token and a
;; digits-only offset, return the store's canonical offset N-delta; else the
;; no-candidate sentinel.
(define (compiler-backend-sweep-candidate-c
  [data : (Ptr u8)]
  [m : i64]
  [te : i64]
  [end : i64]
  [mnemonic-kind : i64]
  [delta : i64]) : i64
  (let
    [none : i64 compiler-backend-sweep-no-candidate]
    ;; lint-allow: nested-if-ladder
    (if (not (= mnemonic-kind compiler-backend-control-mnemonic-movq))
      none
      (if (or (>= (+ te 1) end) (< (- end te) 10))
        none
        (if (not
          (and
            (= (compiler-backend-peephole-byte-at data (- end 1)) 41)
            (compiler-backend-peephole-range-eq?
              data
              (- end 6)
              (- end 1)
              "(%rsp")))
          none
          (let
            [s0 : i64 (+ te 1)]
            [b0 : i64 (compiler-backend-peephole-byte-at data s0)]
            (if (not (or (= b0 37) (= b0 36)))
              none
              (let
                [c : i64 s0]
                [found : bool false]
                (begin
                  (while (and (not found) (< (+ c 1) end))
                    (if (and
                      (= (compiler-backend-peephole-byte-at data c) 44)
                      (= (compiler-backend-peephole-byte-at data (+ c 1)) 32))
                      (set! found true)
                      (set! c (+ c 1))))
                  (if (not found)
                    none
                    (let
                      [j : i64 s0]
                      [bad : bool false]
                      (begin
                        (while (< j c)
                          (begin
                            (if (=
                              (compiler-backend-peephole-byte-at data j)
                              40)
                              (set! bad true)
                              unit)
                            (set! j (+ j 1))))
                        (if (compiler-backend-peephole-range-eq?
                          data
                          s0
                          c
                          "%rsp")
                          (set! bad true)
                          unit)
                        (if bad
                          none
                          (let
                            [ds : i64 (+ c 2)]
                            [de : i64 (- end 6)]
                            (if (>= ds de)
                              ;; bare "(%rsp)" store dst: not a rebased local.
                              none
                              (let
                                [ks : i64
                                  (compiler-backend-rsp-rebase-int-start
                                    data
                                    m
                                    de)]
                                (if (not (= ks ds))
                                  none
                                  (-
                                    (compiler-backend-rsp-rebase-parse-int
                                      data
                                      ks
                                      de)
                                    delta))))))))))))))))))

;; If line [m,end) is exactly `leaq N(%rsp), %rsp`, return the canonical N-delta.
;; Win64 uses this only for terminal CSR pop-run epilogues; callers still check
;; that the target is outside the local var span before admitting it.
(define (compiler-backend-sweep-rsp-leaq-to-rsp-c
  [data : (Ptr u8)]
  [m : i64]
  [te : i64]
  [end : i64]
  [mnemonic-kind : i64]
  [delta : i64]) : i64
  (let
    [none : i64 compiler-backend-sweep-no-candidate]
    ;; lint-allow: nested-if-ladder
    (if (not (= mnemonic-kind compiler-backend-control-mnemonic-leaq))
      none
      (if (or (>= (+ te 1) end) (< (- end te) 14))
        none
        (if (not
          (compiler-backend-peephole-range-eq? data (- end 6) end ", %rsp"))
          none
          (let
            [c : i64 (- end 6)]
            (if (or
              (< c (+ te 7))
              (not (= (compiler-backend-peephole-byte-at data (- c 1)) 41))
              (not
                (compiler-backend-peephole-range-eq?
                  data
                  (- c 6)
                  (- c 1)
                  "(%rsp")))
              none
              (let
                [ds : i64 (+ te 1)]
                [de : i64 (- c 6)]
                (if (>= ds de)
                  none
                  (let
                    [ks : i64 (compiler-backend-rsp-rebase-int-start data m de)]
                    (if (not (= ks ds))
                      none
                      (-
                        (compiler-backend-rsp-rebase-parse-int data ks de)
                        delta))))))))))))

;; True iff the "%rsp" at `q` on line [m,end) opens a MEMORY base reference,
;; i.e. it is preceded by '('. Whether that reference is CLOSED by ')' is asked
;; separately (below), because an unclosed one is the indexed/truncated form
;; that disables the function rather than a readable frame reference.
(define (compiler-backend-sweep-rsp-ref-memory-base?
  [data : (Ptr u8)]
  [m : i64]
  [q : i64]) : bool
  (and (> q m) (= (compiler-backend-peephole-byte-at data (- q 1)) 40)))

(define (compiler-backend-sweep-rsp-ref-closed?
  [data : (Ptr u8)]
  [q : i64]
  [end : i64]) : bool
  (and (< (+ q 4) end) (= (compiler-backend-peephole-byte-at data (+ q 4)) 41)))

;; Raw frame displacement of the `N(%rsp)` reference that starts at `q`.
;; A missing/indexed decimal reads as 0, exactly like the byte walk.
(define (compiler-backend-sweep-rsp-ref-offset
  [data : (Ptr u8)]
  [m : i64]
  [q : i64]) : i64
  (let
    [ks : i64 (compiler-backend-rsp-rebase-int-start data m (- q 1))]
    (if (< ks 0)
      0
      (compiler-backend-rsp-rebase-parse-int data ks (- q 1)))))

;; Raw displacement of the k-th closed `N(%rsp)` memory reference on line
;; [m,end). The record caches k = 0; x86 encodes at most one memory operand
;; per instruction, so this walk only ever serves a hand-written or future
;; multi-reference line (k >= 1) and keeps that case exact instead of
;; approximating it.
(define (compiler-backend-sweep-line-mem-off-nth
  [data : (Ptr u8)]
  [m : i64]
  [end : i64]
  [k : i64]) : i64
  (let
    [seen : i64 0]
    [q : i64 m]
    (begin
      (while (<= (+ q 4) end)
        (let
          [pct : i64 (compiler-backend-sweep-next-percent data q end)]
          (begin
            (if (< pct 0)
              (set! q end)
              (set! q pct))
            (if (and
              (>= pct 0)
              (= (compiler-backend-peephole-byte-at data (+ q 1)) 114)
              (= (compiler-backend-peephole-byte-at data (+ q 2)) 115)
              (= (compiler-backend-peephole-byte-at data (+ q 3)) 112))
              (begin
                (when
                  (and
                    (compiler-backend-sweep-rsp-ref-memory-base? data m q)
                    (compiler-backend-sweep-rsp-ref-closed? data q end))
                  (begin
                    (when
                      (= seen k)
                      (return (compiler-backend-sweep-rsp-ref-offset data m q)))
                    (set! seen (+ seen 1))))
                (set! q (+ q 4)))
              (set! q (+ q 1))))))
      0)))

;; Classify one line for the GAP5 sweep. This is the ONE per-line byte
;; inspection of the group stage: it runs when the record is built (in
;; parse-line, so peephole-synthesized lines are summarized from their own
;; rewritten text) and the sweep then reads only the packed result.
;;
;; Everything stored here is delta-INDEPENDENT: candidate/epilogue/memory
;; offsets are the raw in-text displacements, and the two Win64-gated
;; predicates keep their shape bit so the sweep can apply the per-function
;; record. The `%rsp` occurrence walk is skipped for verified candidate stores,
;; exactly like the byte walk it replaces.
(define (compiler-backend-peephole-line-sweep-summary
  [data : (Ptr u8)]
  [end : i64]
  [ms : i64]
  [mlen : i64]
  [is-label : bool]) : CompilerBackendPeepholeLineSweepSummary
  (let
    [none : i64 compiler-backend-sweep-no-candidate]
    [skip : CompilerBackendPeepholeLineSweepSummary
      (CompilerBackendPeepholeLineSweepSummary
        compiler-backend-sweep-line-kind-skip
        0
        none
        none
        0
        0
        0
        8)]
    ;; lint-allow: nested-if-ladder
    (if (>= ms end)
      skip
      (if is-label
        (CompilerBackendPeepholeLineSweepSummary
          compiler-backend-sweep-line-kind-label
          0
          none
          none
          0
          0
          0
          8)
        (let
          [b0 : i64 (compiler-backend-peephole-byte-at data ms)]
          (if (or (= b0 46) (= b0 35))
            skip
            (let
              [te : i64 (+ ms mlen)]
              [mnemonic-kind : i64
                (compiler-backend-control-mnemonic-kind data ms mlen)]
              [pop? : bool
                (= mnemonic-kind compiler-backend-control-mnemonic-pop)]
              [leaq? : bool
                (= mnemonic-kind compiler-backend-control-mnemonic-leaq)]
              [subq? : bool
                (= mnemonic-kind compiler-backend-control-mnemonic-subq)]
              [addq? : bool
                (= mnemonic-kind compiler-backend-control-mnemonic-addq)]
              [rsp-dst? : bool
                (and
                  (>= (- end ms) 6)
                  (compiler-backend-peephole-range-eq?
                    data
                    (- end 6)
                    end
                    ", %rsp"))]
              [imm? : bool
                (and
                  (< (+ te 1) end)
                  (= (compiler-backend-peephole-byte-at data (+ te 1)) 36))]
              [tracked-rsp-write? : bool (and rsp-dst? (or subq? addq?) imm?)]
              [cand : i64
                (compiler-backend-sweep-candidate-c
                  data
                  ms
                  te
                  end
                  mnemonic-kind
                  0)]
              [flags : i64
                (+
                  (+
                    (+
                      (if (=
                        mnemonic-kind
                        compiler-backend-control-mnemonic-push)
                        compiler-backend-sweep-line-flag-push
                        0)
                      (+
                        (if pop?
                          compiler-backend-sweep-line-flag-pop
                          0)
                        (if leaq?
                          compiler-backend-sweep-line-flag-leaq
                          0)))
                    (+
                      (+
                        (if (=
                          mnemonic-kind
                          compiler-backend-control-mnemonic-leave)
                          compiler-backend-sweep-line-flag-leave
                          0)
                        (if (=
                          mnemonic-kind
                          compiler-backend-control-mnemonic-ret)
                          compiler-backend-sweep-line-flag-ret
                          0))
                      (+
                        (if (=
                          mnemonic-kind
                          compiler-backend-control-mnemonic-jmp)
                          compiler-backend-sweep-line-flag-jmp
                          0)
                        (if subq?
                          compiler-backend-sweep-line-flag-subq
                          0))))
                  (+
                    (+
                      (if rsp-dst?
                        compiler-backend-sweep-line-flag-rsp-dst
                        0)
                      (if tracked-rsp-write?
                        compiler-backend-sweep-line-flag-tracked-rsp-write
                        0))
                    (if (compiler-backend-peephole-range-eq?
                      data
                      ms
                      end
                      "movq %rsp, %rbp")
                      compiler-backend-sweep-line-flag-win64-rbp-set
                      0)))]
              [walk-flags : i64 0]
              [mem-count : i64 0]
              [mem-off : i64 0]
              [q : i64 ms]
              (begin
                ;; A verified pure store has no other rsp effect, so the byte
                ;; walk is skipped for it -- as in the pass it replaces.
                (when
                  (= cand none)
                  (while (<= (+ q 4) end)
                    (let
                      [pct : i64
                        (compiler-backend-sweep-next-percent data q end)]
                      (begin
                        (if (< pct 0)
                          (set! q end)
                          (set! q pct))
                        (if (and
                          (>= pct 0)
                          (=
                            (compiler-backend-peephole-byte-at data (+ q 1))
                            114)
                          (=
                            (compiler-backend-peephole-byte-at data (+ q 2))
                            115)
                          (=
                            (compiler-backend-peephole-byte-at data (+ q 3))
                            112))
                          (begin
                            (if (compiler-backend-sweep-rsp-ref-memory-base?
                              data
                              ms
                              q)
                              ;; lint-allow: nested-if-ladder
                              (if (not
                                (compiler-backend-sweep-rsp-ref-closed?
                                  data
                                  q
                                  end))
                                (set!
                                  walk-flags
                                  (bit-or
                                    walk-flags
                                    compiler-backend-sweep-line-flag-fatal-mem))
                                (if pop?
                                  ;; popq MEM addresses AFTER the bump
                                  (set!
                                    walk-flags
                                    (bit-or
                                      walk-flags
                                      compiler-backend-sweep-line-flag-fatal-mem))
                                  (begin
                                    (when
                                      (= mem-count 0)
                                      (set!
                                        mem-off
                                        (compiler-backend-sweep-rsp-ref-offset
                                          data
                                          ms
                                          q)))
                                    (set! mem-count (+ mem-count 1)))))
                              (set!
                                walk-flags
                                (bit-or
                                  walk-flags
                                  (if (= q (- end 4))
                                    compiler-backend-sweep-line-flag-bare-rsp-tail
                                    compiler-backend-sweep-line-flag-bare-rsp))))
                            (set! q (+ q 4)))
                          (set! q (+ q 1)))))))
                (CompilerBackendPeepholeLineSweepSummary
                  compiler-backend-sweep-line-kind-instruction
                  (bit-or flags walk-flags)
                  cand
                  (compiler-backend-sweep-rsp-leaq-to-rsp-c
                    data
                    ms
                    te
                    end
                    mnemonic-kind
                    0)
                  (if tracked-rsp-write?
                    (compiler-backend-rsp-rebase-parse-int
                      data
                      (+ te 2)
                      (- end 6))
                    0)
                  mem-count
                  mem-off
                  (if (and (> mem-count 0) (not leaq?))
                    (compiler-backend-sweep-line-width data ms end)
                    8))))))))))

;; Sweep one function region [rstart,rend) of the record array: collect
;; reads/candidates/poison state in pass 1, then mark every dead candidate
;; store's record deleted. The line bytes are never re-read -- the per-record
;; summary already carries everything the byte walk derived, with the
;; delta-dependent offsets kept raw and rebased here.
(define (compiler-backend-sweep-region-records!
  [recs : (Array CompilerBackendPeepholeLineRecord)]
  [live : (Array i64)]
  [rstart : i64]
  [rend : i64]
  [lo : i64]
  [hi : i64]
  [disp : i64]
  [em-lo : i64]
  [em-hi : i64]
  [win64 : bool]) : unit
  (let
    [delta : i64 (- 0 disp)]
    [sweepable : bool true]
    [win64-tail : bool false]
    [watermark : i64 4611686018427387904]
    [none : i64 compiler-backend-sweep-no-candidate]
    [reads-lo : (Array i64) (make-array i64 64)]
    [reads-hi : (Array i64) (make-array i64 64)]
    [read-count : i64 0]
    [cand-pos : (Array i64) (make-array i64 32)]
    [cand-off : (Array i64) (make-array i64 32)]
    [cand-count : i64 0]
    [i : i64 rstart]
    (begin
      ;; ---- pass 1 ----
      (while (and sweepable (< i rend))
        (let
          [line : CompilerBackendPeepholeLineRecord (array-ref recs i)]
          [kind : i64 (compiler-backend-peephole-record-kind line)]
          (begin
            (cond
              [(= kind compiler-backend-sweep-line-kind-skip) unit]
              [(= kind compiler-backend-sweep-line-kind-label)
                ;; label: only reachable at delta 0 (the audit proved it).
                (if win64-tail
                  (set! sweepable false)
                  (set! delta 0))]
              [else
                (let
                  [flags : i64 (compiler-backend-peephole-record-flags line)]
                  [push? : bool
                    (compiler-backend-sweep-line-flag?
                      flags
                      compiler-backend-sweep-line-flag-push)]
                  [pop? : bool
                    (compiler-backend-sweep-line-flag?
                      flags
                      compiler-backend-sweep-line-flag-pop)]
                  [leaq? : bool
                    (compiler-backend-sweep-line-flag?
                      flags
                      compiler-backend-sweep-line-flag-leaq)]
                  [leave? : bool
                    (compiler-backend-sweep-line-flag?
                      flags
                      compiler-backend-sweep-line-flag-leave)]
                  [subq? : bool
                    (compiler-backend-sweep-line-flag?
                      flags
                      compiler-backend-sweep-line-flag-subq)]
                  [rsp-dst? : bool
                    (compiler-backend-sweep-line-flag?
                      flags
                      compiler-backend-sweep-line-flag-rsp-dst)]
                  [tracked-rsp-write? : bool
                    (compiler-backend-sweep-line-flag?
                      flags
                      compiler-backend-sweep-line-flag-tracked-rsp-write)]
                  [win64-rbp-set? : bool
                    (and
                      win64
                      (compiler-backend-sweep-line-flag?
                        flags
                        compiler-backend-sweep-line-flag-win64-rbp-set))]
                  [epilogue-raw : i64 (struct-get line epilogue)]
                  [win64-epilogue-c : i64
                    (if (or (not win64) (= epilogue-raw none))
                      none
                      (- epilogue-raw delta))]
                  [win64-epilogue-leaq? : bool
                    (and
                      (not (= win64-epilogue-c none))
                      (< win64-epilogue-c lo))]
                  [win64-tail-ok? : bool
                    (or
                      pop?
                      leave?
                      (compiler-backend-sweep-line-flag?
                        flags
                        compiler-backend-sweep-line-flag-ret)
                      (compiler-backend-sweep-line-flag?
                        flags
                        compiler-backend-sweep-line-flag-jmp))]
                  [cand-raw : i64 (struct-get line cand)]
                  [cand : i64
                    (if (= cand-raw none)
                      none
                      (- cand-raw delta))]
                  (begin
                    (if (and win64-tail (not win64-tail-ok?))
                      (set! sweepable false)
                      unit)
                    (if (and leave? (not win64))
                      (set! sweepable false)
                      unit)
                    (if (not (= cand none))
                      ;; verified pure store: record; no other rsp effect.
                      (begin
                        (set!
                          cand-pos
                          (compiler-backend-sweep-i64-push
                            cand-pos
                            cand-count
                            i))
                        (set!
                          cand-off
                          (compiler-backend-sweep-i64-push
                            cand-off
                            cand-count
                            cand))
                        (set! cand-count (+ cand-count 1)))
                      ;; general line: replay the recorded %rsp classification.
                      (let
                        [mem-count : i64
                          (compiler-backend-peephole-record-mem-count line)]
                        [w : i64 (compiler-backend-peephole-record-width line)]
                        [k : i64 0]
                        (begin
                          ;; "(%rsp," indexed / truncated, or popq MEM
                          ;; (which addresses AFTER the bump).
                          (when
                            (compiler-backend-sweep-line-flag?
                              flags
                              compiler-backend-sweep-line-flag-fatal-mem)
                            (set! sweepable false))
                          ;; bare %rsp: only the tracked subq/addq $imm dst and
                          ;; proven Win64 prologue/epilogue shapes are allowed.
                          (when
                            (and
                              (compiler-backend-sweep-line-flag?
                                flags
                                compiler-backend-sweep-line-flag-bare-rsp)
                              (not win64-rbp-set?))
                            (set! sweepable false))
                          (when
                            (and
                              (compiler-backend-sweep-line-flag?
                                flags
                                compiler-backend-sweep-line-flag-bare-rsp-tail)
                              (not win64-rbp-set?)
                              (not win64-epilogue-leaq?)
                              (not tracked-rsp-write?))
                            (set! sweepable false))
                          (while (< k mem-count)
                            (let
                              [c : i64
                                (-
                                  (if (= k 0)
                                    (struct-get line value)
                                    (compiler-backend-sweep-line-mem-off-nth
                                      (compiler-backend-peephole-record-data
                                        line)
                                      (compiler-backend-peephole-record-mnemonic-start
                                        line)
                                      (compiler-backend-peephole-record-end
                                        line)
                                      k))
                                  delta)]
                              (begin
                                (if leaq?
                                  ;; address taken: poison upward
                                  (if win64-epilogue-leaq?
                                    unit
                                    (if (< c watermark)
                                      (set! watermark c)
                                      unit))
                                  (begin
                                    (set!
                                      reads-lo
                                      (compiler-backend-sweep-i64-push
                                        reads-lo
                                        read-count
                                        c))
                                    (set!
                                      reads-hi
                                      (compiler-backend-sweep-i64-push
                                        reads-hi
                                        read-count
                                        (+ c w)))
                                    (set! read-count (+ read-count 1))))
                                (set! k (+ k 1))))))))
                    ;; rsp motion
                    (if (and rsp-dst? (not pop?))
                      (if win64-epilogue-leaq?
                        (begin
                          (set! delta (- 0 win64-epilogue-c))
                          (set! win64-tail true))
                        (if tracked-rsp-write?
                          (if subq?
                            (set! delta (+ delta (struct-get line value)))
                            (set! delta (- delta (struct-get line value))))
                          (set! sweepable false)))
                      unit)
                    (if push?
                      (set! delta (+ delta 8))
                      unit)
                    (if pop?
                      (set! delta (- delta 8))
                      unit)))])
            (set! i (+ i 1)))))
      ;; ---- pass 2 ----
      (if (or (not sweepable) (= cand-count 0))
        unit
        (let
          [k : i64 0]
          [swept : i64 0]
          (begin
            (while (< k cand-count)
              (let
                [c : i64 (array-ref cand-off k)]
                [pos : i64 (array-ref cand-pos k)]
                (begin
                  (if (and
                    (or
                      (and (>= c lo) (<= c hi) (= (bit-and (- c lo) 7) 0))
                      (and
                        (>= c em-lo)
                        (<= c em-hi)
                        (= (bit-and (- c em-lo) 7) 0)))
                    (< c watermark))
                    (let
                      [r : i64 0]
                      [read : bool false]
                      (begin
                        (while (and (not read) (< r read-count))
                          (begin
                            (if (and
                              (< (array-ref reads-lo r) (+ c 8))
                              (< c (array-ref reads-hi r)))
                              (set! read true)
                              unit)
                            (set! r (+ r 1))))
                        (if read
                          unit
                          (begin
                            (array-set! live pos 0)
                            (set! swept (+ swept 1))))))
                    unit)
                  (set! k (+ k 1)))))
            (if (> swept 0)
              (begin
                (set!
                  compiler-backend-sweep-swept-stores
                  (+ compiler-backend-sweep-swept-stores swept))
                (set!
                  compiler-backend-sweep-swept-funcs
                  (+ compiler-backend-sweep-swept-funcs 1)))
              unit)))))))

(define (compiler-backend-borrowed-copy-to-owned
  [buf : (text_buf_borrowed.TextBufBorrowed asm)]) : text_buf.TextBuf
  (match buf
    [(text_buf_borrowed.TextBufBorrowed chunks len)
      (text_buf.TextBuf (text_buf_borrowed.chunks-to-owned chunks) len)]))

;; Sweep one group's line records, resuming at the next metadata entry from an
;; earlier group. The caller owns the cursor and resets global sweep metadata
;; only after the final group. Dead stores are marked in the record array's
;; `live` mask; nothing is copied or rebuilt.
(define (compiler-backend-deadstore-sweep-records!
  [v : CompilerBackendPeepholeLineVec]
  [start-cursor : i64]) : i64
  (if (>= start-cursor compiler-backend-sweep-count)
    start-cursor
    (let
      [recs : (Array CompilerBackendPeepholeLineRecord) (struct-get v lines)]
      [live : (Array i64) (struct-get v live)]
      [count : i64 (struct-get v len)]
      [cursor : i64 start-cursor]
      [i : i64 0]
      (begin
        (while (and (< i count) (< cursor compiler-backend-sweep-count))
          (let
            [line : CompilerBackendPeepholeLineRecord (array-ref recs i)]
            (if (compiler-backend-sweep-label-matches?
              (compiler-backend-peephole-record-data line)
              (compiler-backend-peephole-record-start line)
              (compiler-backend-peephole-record-end line)
              cursor)
              (let
                [rstart : i64 (+ i 1)]
                [rend : i64
                  (compiler-backend-sweep-region-end-records recs rstart count)]
                (begin
                  (compiler-backend-sweep-region-records!
                    recs
                    live
                    rstart
                    rend
                    (array-ref compiler-backend-sweep-lo-arr cursor)
                    (array-ref compiler-backend-sweep-hi-arr cursor)
                    (array-ref compiler-backend-sweep-disp-arr cursor)
                    (array-ref compiler-backend-sweep-em-lo-arr cursor)
                    (array-ref compiler-backend-sweep-em-hi-arr cursor)
                    (= (array-ref compiler-backend-sweep-win64-arr cursor) 1))
                  (set! cursor (+ cursor 1))
                  (set! i rend)))
              (set! i (+ i 1)))))
        cursor))))

(define (compiler-backend-deadstore-sweep-report-and-reset!) : unit
  (begin
    (cfg
      regalloc-census
      (io.print-error
        (str_cat.str-cat
          "deadstore-sweep|funcs="
          (string.int->string compiler-backend-sweep-swept-funcs)
          "|stores="
          (string.int->string compiler-backend-sweep-swept-stores)
          "|dropped="
          (string.int->string compiler-backend-sweep-dropped-funcs)
          "|table-cap-drops="
          (string.int->string compiler-backend-sweep-dropped-table-cap)
          "|bytes-cap-drops="
          (string.int->string compiler-backend-sweep-dropped-bytes-cap)
          "\n"
          "")))
    (compiler-backend-sweep-reset!)))

;; ============================================================================
;; GAP9: gep displacement folding (codegen phase 9 / P7a).
;;
;; The optimizer's affine rebase (phase 6) leaves unrolled loop bodies
;; addressing arrays with PARALLEL offset vars -- `i1 = i + 1; i2 = i + 2;
;; i3 = i + 3` -- each materialized as a leaq/addq and consumed as a Gep
;; index. clang folds the constant into the addressing displacement instead:
;; `addq 8(%rax,%r13,8), %r14`, no offset materialization at all.
;;
;; This pre-pass runs on the function's blocks BEFORE the register plan is
;; computed, so liveness and allocation see the folded program (the shared
;; base counter stays live through the folded uses; the offset vars vanish
;; and stop costing registers):
;;   * candidate: `dst = Add (Var j) (I64 k)` (either operand order) at
;;     64-bit int type, dst defined exactly once in the function, k != 0
;;     and |k| small;
;;   * every use of dst (function-wide use counts) must be the INDEX operand
;;     of a Gep in the SAME BLOCK after the add, whose own dst is single-def
;;     and whose byte displacement k*type-size stays small. Any other use --
;;     another block, a bounds check, a phi input, a store value, a gep
;;     BASE -- keeps the add;
;;   * no def of j between the add and the last folded gep (linear in-block
;;     execution then guarantees the gep reads the same j the add read);
;;   * a candidate whose base j is ITSELF an elided candidate is dropped
;;     (its add is deleted, so the value would never exist).
;; The rewrite deletes the add, retargets the gep's index operand to j, and
;; records gep-dst -> byte displacement in a per-function side table sized
;; by the pre-rewrite var count (the later register rewrites insert copies
;; but never renumber a Gep's dst). Emission threads the displacement into
;; the two bottom-most address builders, so every addressing form -- SIB,
;; staged non-SIB, spilled-operand fallbacks -- applies it exactly once.
(defenum CompilerBackendMaybeVarImm
  (No)
  (Some i64 i64))

(define compiler-backend-gep-fold-ready : bool
  false)

;; Ordinal-indexed (walk-order) per-gep tables: the register pipeline's later
;; IR rewrites (caller-save spills, loop-split region remaps, remat) RENAME
;; vars inside loop regions but never create, delete, or reorder Gep
;; instructions, so the n-th Gep the emitter walks is the n-th Gep the
;; pre-pass saw. Each entry carries the byte displacement plus the gep's
;; offset kind (1 = Var, 0 = other) and element size as a drift check: a
;; consumption mismatch marks the function poisoned and emission fails loudly
;; rather than addressing with a stale displacement.
(define compiler-backend-gep-fold-disp-table : (Array i64)
  (array.make-array i64 0))
(define compiler-backend-gep-fold-kind-table : (Array i64)
  (array.make-array i64 0))
(define compiler-backend-gep-fold-scale-table : (Array i64)
  (array.make-array i64 0))
(define compiler-backend-gep-fold-cursor : i64
  0)
(define compiler-backend-gep-fold-drift : bool
  false)

(define (compiler-backend-gep-fold-disable!) : unit
  (begin
    (set! compiler-backend-gep-fold-ready false)
    (set! compiler-backend-gep-fold-disp-table (array.make-array i64 0))
    (set! compiler-backend-gep-fold-kind-table (array.make-array i64 0))
    (set! compiler-backend-gep-fold-scale-table (array.make-array i64 0))
    (set! compiler-backend-gep-fold-cursor 0)
    (set! compiler-backend-gep-fold-drift false)))

(define (compiler-backend-gep-fold-offset-kind [offset : CompilerIrValue]) : i64
  (match offset
    [(CompilerIrValue.Var _) 1]
    [_ 0]))

;; Consume the next gep ordinal and return its folded displacement (0 for
;; unfolded geps). Called EXACTLY ONCE per Gep instruction the block walker
;; dispatches; kind/scale must match what the pre-pass recorded or the
;; function is poisoned (checked after body emission).
(define (compiler-backend-gep-fold-next!
  [type-segment-bases : i64]
  [offset : CompilerIrValue]
  [elem-ty : AstType]) : i64
  (if (not compiler-backend-gep-fold-ready)
    0
    (let
      [cursor : i64 compiler-backend-gep-fold-cursor]
      (if (>= cursor (array-length compiler-backend-gep-fold-disp-table))
        (begin
          (set! compiler-backend-gep-fold-drift true)
          0)
        (begin
          (set! compiler-backend-gep-fold-cursor (+ cursor 1))
          (if (and
            (=
              (array-ref compiler-backend-gep-fold-kind-table cursor)
              (compiler-backend-gep-fold-offset-kind offset))
            (=
              (array-ref compiler-backend-gep-fold-scale-table cursor)
              (compiler-backend-type-size type-segment-bases elem-ty)))
            (array-ref compiler-backend-gep-fold-disp-table cursor)
            (begin
              (set! compiler-backend-gep-fold-drift true)
              0)))))))

(define (compiler-backend-gep-fold-drift?) : bool
  (and compiler-backend-gep-fold-ready compiler-backend-gep-fold-drift))

;; Conservative magnitude cap for the folded element offset and its byte
;; displacement: far below imm32 so downstream constant-offset merges can
;; never overflow.
(define (compiler-backend-gep-fold-k-bound) : i64
  16777216)

(define (compiler-backend-gep-fold-64bit-int? [ty : AstType]) : bool
  (match ty
    [(AstType.I64) true]
    [(AstType.U64) true]
    [_ false]))

;; The (var j, imm k) split of a candidate add's operands, or No.
(define (compiler-backend-gep-fold-add-operands
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]) : CompilerBackendMaybeVarImm
  (match lhs
    [(CompilerIrValue.Var v)
      (match rhs
        [(CompilerIrValue.I64 k) (CompilerBackendMaybeVarImm.Some v k)]
        [_ (CompilerBackendMaybeVarImm.No)])]
    [(CompilerIrValue.I64 k)
      (match rhs
        [(CompilerIrValue.Var v) (CompilerBackendMaybeVarImm.Some v k)]
        [_ (CompilerBackendMaybeVarImm.No)])]
    [_ (CompilerBackendMaybeVarImm.No)]))

(define (compiler-backend-gep-fold-block-instrs [block : CompilerIrBlock]) : CompilerIrInstrSeq
  (match block
    [(CompilerIrBlock.Block _ instrs) instrs]))

;; Blocks as an array so per-candidate segment scans can address their block
;; by ordinal.
(define (compiler-backend-gep-fold-block-array [blocks : CompilerIrBlockList]) : (Array
    CompilerIrBlock)
  (match blocks
    [(CompilerIrBlockList.Array seq)
      (let
        [count : i64 (compiler-ir-block-seq-count seq)]
        [out : (Array CompilerIrBlock) (array.make-array CompilerIrBlock count)]
        [j : i64 0]
        (begin
          (while (< j count)
            (begin
              (array-set! out j (compiler-ir-block-seq-ref seq j))
              (set! j (+ j 1))))
          out))]
    [_
      (let
        [flat : CompilerIrBlockList blocks]
        [count : i64 (compiler-ir-block-list-count-cons flat)]
        [out : (Array CompilerIrBlock) (array.make-array CompilerIrBlock count)]
        [cursor : CompilerIrBlockList flat]
        [j : i64 0]
        (begin
          (while (< j count)
            (match cursor
              [(CompilerIrBlockList.Cons block rest)
                (begin
                  (array-set! out j block)
                  (set! cursor (box-get rest))
                  (set! j (+ j 1)))]
              [_ (set! j count)]))
          out))]))

(define (compiler-backend-gep-fold-count-geps [barr : (Array CompilerIrBlock)]) : i64
  (let
    [total : i64 0]
    [b : i64 0]
    (begin
      (while (< b (array-length barr))
        (begin
          (let
            [instrs : CompilerIrInstrSeq
              (compiler-backend-gep-fold-block-instrs (array-ref barr b))]
            [n : i64 (struct-get instrs len)]
            [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
            [j : i64 0]
            (while (< j n)
              (begin
                (match (array-ref slots j)
                  [(CompilerIrInstr.Gep _ _ _ _) (set! total (+ total 1))]
                  [_ unit])
                (set! j (+ j 1)))))
          (set! b (+ b 1))))
      total)))

(define (compiler-backend-gep-fold-count-defs
  [defs : (Array i64)]
  [barr : (Array CompilerIrBlock)]) : unit
  (let
    [b : i64 0]
    (while (< b (array-length barr))
      (begin
        (let
          [instrs : CompilerIrInstrSeq
            (compiler-backend-gep-fold-block-instrs (array-ref barr b))]
          [n : i64 (struct-get instrs len)]
          [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
          [j : i64 0]
          (while (< j n)
            (begin
              (let
                [dst : i64 (compiler-reg-instr-def-var (array-ref slots j))]
                (if (and (>= dst 0) (< dst (array-length defs)))
                  (array-set! defs dst (+ (array-ref defs dst) 1))
                  unit))
              (set! j (+ j 1)))))
        (set! b (+ b 1))))))

;; Pass 1: record candidate adds (base, k, block ordinal, position).
(define (compiler-backend-gep-fold-scan-adds
  [barr : (Array CompilerIrBlock)]
  [defs : (Array i64)]
  [cand-base : (Array i64)]
  [cand-k : (Array i64)]
  [cand-block : (Array i64)]
  [cand-pos : (Array i64)]) : unit
  (let
    [b : i64 0]
    (while (< b (array-length barr))
      (begin
        (let
          [instrs : CompilerIrInstrSeq
            (compiler-backend-gep-fold-block-instrs (array-ref barr b))]
          [n : i64 (struct-get instrs len)]
          [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
          [j : i64 0]
          (while (< j n)
            (begin
              (match (array-ref slots j)
                [(CompilerIrInstr.BinOp dst op lhs rhs ty)
                  (match op
                    [(CompilerIrBinOp.Add)
                      (if (and
                        (compiler-backend-gep-fold-64bit-int? ty)
                        (>= dst 0)
                        (< dst (array-length cand-base))
                        (= (array-ref defs dst) 1))
                        (match (compiler-backend-gep-fold-add-operands lhs rhs)
                          [(CompilerBackendMaybeVarImm.Some base k)
                            (if (and
                              (not (= k 0))
                              (not (= base dst))
                              (< k (compiler-backend-gep-fold-k-bound))
                              (> k (- 0 (compiler-backend-gep-fold-k-bound))))
                              (begin
                                (array-set! cand-base dst base)
                                (array-set! cand-k dst k)
                                (array-set! cand-block dst b)
                                (array-set! cand-pos dst j))
                              unit)]
                          [(CompilerBackendMaybeVarImm.No) unit])
                        unit)]
                    [_ unit])]
                [_ unit])
              (set! j (+ j 1)))))
        (set! b (+ b 1))))))

;; Pass 2: count qualifying gep-index uses per candidate and track the last
;; folded gep position; a disqualifying gep-index use kills the candidate.
(define (compiler-backend-gep-fold-scan-geps
  [type-segment-bases : i64]
  [barr : (Array CompilerIrBlock)]
  [defs : (Array i64)]
  [cand-base : (Array i64)]
  [cand-k : (Array i64)]
  [cand-block : (Array i64)]
  [cand-pos : (Array i64)]
  [gep-uses : (Array i64)]
  [gep-last : (Array i64)]) : unit
  (let
    [b : i64 0]
    (while (< b (array-length barr))
      (begin
        (let
          [instrs : CompilerIrInstrSeq
            (compiler-backend-gep-fold-block-instrs (array-ref barr b))]
          [n : i64 (struct-get instrs len)]
          [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
          [j : i64 0]
          (while (< j n)
            (begin
              (match (array-ref slots j)
                [(CompilerIrInstr.Gep gdst _ offset elem-ty)
                  (match offset
                    [(CompilerIrValue.Var ov)
                      (if (and
                        (>= ov 0)
                        (< ov (array-length cand-base))
                        (>= (array-ref cand-base ov) 0))
                        (let
                          [scale : i64
                            (compiler-backend-type-size
                              type-segment-bases
                              elem-ty)]
                          [bdisp : i64 (* (array-ref cand-k ov) scale)]
                          (if (and
                            (= (array-ref cand-block ov) b)
                            (> j (array-ref cand-pos ov))
                            (>= gdst 0)
                            (< gdst (array-length defs))
                            (= (array-ref defs gdst) 1)
                            (> scale 0)
                            (< bdisp (compiler-backend-gep-fold-k-bound))
                            (> bdisp (- 0 (compiler-backend-gep-fold-k-bound))))
                            (begin
                              (array-set!
                                gep-uses
                                ov
                                (+ (array-ref gep-uses ov) 1))
                              (if (> j (array-ref gep-last ov))
                                (array-set! gep-last ov j)
                                unit))
                            ;; disqualifying gep-index use: kill the candidate.
                            (array-set! cand-base ov (- 0 1)))
                          unit)
                        unit)]
                    [_ unit])]
                [_ unit])
              (set! j (+ j 1)))))
        (set! b (+ b 1))))))

;; True when any instruction in (from, to] defines `var`.
(define (compiler-backend-gep-fold-segment-defines?
  [instrs : CompilerIrInstrSeq]
  [from : i64]
  [to : i64]
  [var : i64]) : bool
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [j : i64 (+ from 1)]
    [found : bool false]
    (begin
      (while (<= j to)
        (if (= (compiler-reg-instr-def-var (array-ref slots j)) var)
          (begin
            (set! found true)
            (set! j (+ to 1)))
          (set! j (+ j 1))))
      found)))

;; Pass 3: totality (every use is a folded gep index), no def of the base
;; inside the (add, last-gep] segment, and the base is not itself an elided
;; candidate (two rounds cover the parallel-offset shape; deeper chains
;; conservatively keep their adds).
(define (compiler-backend-gep-fold-validate
  [barr : (Array CompilerIrBlock)]
  [uses : (Array i64)]
  [cand-base : (Array i64)]
  [cand-block : (Array i64)]
  [cand-pos : (Array i64)]
  [gep-uses : (Array i64)]
  [gep-last : (Array i64)]) : unit
  (begin
    (let
      [v : i64 0]
      (while (< v (array-length cand-base))
        (begin
          (if (>= (array-ref cand-base v) 0)
            (if (or
              (= (array-ref gep-uses v) 0)
              (not (= (array-ref uses v) (array-ref gep-uses v)))
              (compiler-backend-gep-fold-segment-defines?
                (compiler-backend-gep-fold-block-instrs
                  (array-ref barr (array-ref cand-block v)))
                (array-ref cand-pos v)
                (array-ref gep-last v)
                (array-ref cand-base v)))
              (array-set! cand-base v (- 0 1))
              unit)
            unit)
          (set! v (+ v 1)))))
    (let
      [round : i64 0]
      (while (< round 2)
        (begin
          (let
            [v : i64 0]
            (while (< v (array-length cand-base))
              (begin
                (if (>= (array-ref cand-base v) 0)
                  (let
                    [bv : i64 (array-ref cand-base v)]
                    (if (and
                      (< bv (array-length cand-base))
                      (>= (array-ref cand-base bv) 0))
                      (array-set! cand-base v (- 0 1))
                      unit))
                  unit)
                (set! v (+ v 1)))))
          (set! round (+ round 1)))))))

(define (compiler-backend-gep-fold-any-valid? [cand-base : (Array i64)]) : bool
  (let
    [v : i64 0]
    [found : bool false]
    (begin
      (while (< v (array-length cand-base))
        (if (>= (array-ref cand-base v) 0)
          (begin
            (set! found true)
            (set! v (array-length cand-base)))
          (set! v (+ v 1))))
      found)))

;; Pass 4: rebuild each block with elided adds deleted and folded geps
;; retargeted to the base var; fill the dst -> byte-displacement table.
(define (compiler-backend-gep-fold-record-ordinal!
  [cursor-cell : (Array i64)]
  [disp : i64]
  [kind : i64]
  [scale : i64]
  [disp-table : (Array i64)]
  [kind-table : (Array i64)]
  [scale-table : (Array i64)]) : unit
  (let
    [cursor : i64 (array-ref cursor-cell 0)]
    (if (< cursor (array-length disp-table))
      (begin
        (array-set! disp-table cursor disp)
        (array-set! kind-table cursor kind)
        (array-set! scale-table cursor scale)
        (array-set! cursor-cell 0 (+ cursor 1)))
      unit)))

(define (compiler-backend-gep-fold-rewrite-seq
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [block-ord : i64]
  [cand-base : (Array i64)]
  [cand-k : (Array i64)]
  [cand-block : (Array i64)]
  [cursor-cell : (Array i64)]
  [disp-table : (Array i64)]
  [kind-table : (Array i64)]
  [scale-table : (Array i64)]) : CompilerIrInstrSeq
  (let
    [n : i64 (struct-get instrs len)]
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [out : (Array CompilerIrInstr) (array.make-array CompilerIrInstr n)]
    [w : i64 0]
    [j : i64 0]
    (begin
      (while (< j n)
        (begin
          (match (array-ref slots j)
            [(CompilerIrInstr.BinOp dst _ _ _ _)
              (if (and
                (>= dst 0)
                (< dst (array-length cand-base))
                (>= (array-ref cand-base dst) 0))
                ;; elided offset add: drop it.
                unit
                (begin
                  (array-set! out w (array-ref slots j))
                  (set! w (+ w 1))))]
            [(CompilerIrInstr.Gep gdst base offset elem-ty)
              (let
                [scale : i64
                  (compiler-backend-type-size type-segment-bases elem-ty)]
                (match offset
                  [(CompilerIrValue.Var ov)
                    (if (and
                      (>= ov 0)
                      (< ov (array-length cand-base))
                      (>= (array-ref cand-base ov) 0)
                      (= (array-ref cand-block ov) block-ord))
                      (begin
                        ;; folded: post-rewrite offset stays a Var (the base
                        ;; counter), so the recorded kind is 1.
                        (compiler-backend-gep-fold-record-ordinal!
                          cursor-cell
                          (* (array-ref cand-k ov) scale)
                          1
                          scale
                          disp-table
                          kind-table
                          scale-table)
                        (array-set!
                          out
                          w
                          (CompilerIrInstr.Gep
                            gdst
                            base
                            (CompilerIrValue.Var (array-ref cand-base ov))
                            elem-ty))
                        (set! w (+ w 1)))
                      (begin
                        (compiler-backend-gep-fold-record-ordinal!
                          cursor-cell
                          0
                          1
                          scale
                          disp-table
                          kind-table
                          scale-table)
                        (array-set! out w (array-ref slots j))
                        (set! w (+ w 1))))]
                  [_
                    (begin
                      (compiler-backend-gep-fold-record-ordinal!
                        cursor-cell
                        0
                        (compiler-backend-gep-fold-offset-kind offset)
                        scale
                        disp-table
                        kind-table
                        scale-table)
                      (array-set! out w (array-ref slots j))
                      (set! w (+ w 1)))]))]
            [_
              (begin
                (array-set! out w (array-ref slots j))
                (set! w (+ w 1)))])
          (set! j (+ j 1))))
      (CompilerIrInstrSeq out w))))

(define (compiler-backend-gep-fold-rewrite-blocks
  [type-segment-bases : i64]
  [barr : (Array CompilerIrBlock)]
  [cand-base : (Array i64)]
  [cand-k : (Array i64)]
  [cand-block : (Array i64)]
  [disp-table : (Array i64)]
  [kind-table : (Array i64)]
  [scale-table : (Array i64)]) : CompilerIrBlockList
  (let
    [cursor-cell : (Array i64) (array.make-array i64 1)]
    [rebuilt : (Array CompilerIrBlock)
      (array.make-array CompilerIrBlock (array-length barr))]
    [b : i64 0]
    [out : CompilerIrBlockList CompilerIrBlockList.Nil]
    [r : i64 (- (array-length barr) 1)]
    (begin
      ;; forward pass keeps the ordinal cursor in walk order ...
      (while (< b (array-length barr))
        (begin
          (match (array-ref barr b)
            [(CompilerIrBlock.Block label instrs)
              (array-set!
                rebuilt
                b
                (CompilerIrBlock.Block
                  label
                  (compiler-backend-gep-fold-rewrite-seq
                    type-segment-bases
                    instrs
                    b
                    cand-base
                    cand-k
                    cand-block
                    cursor-cell
                    disp-table
                    kind-table
                    scale-table)))])
          (set! b (+ b 1))))
      ;; ... and the list is assembled back-to-front.
      (while (>= r 0)
        (begin
          (set! out (compiler-ir-block-cons (array-ref rebuilt r) out))
          (set! r (- r 1))))
      out)))

;; Cheap prescan: a variable-index gep at all? Most functions have none; the
;; full pass only runs when one exists.
(define (compiler-backend-gep-fold-blocks-have-candidate?
  [blocks : CompilerIrBlockList]) : bool
  (match blocks
    [(CompilerIrBlockList.Nil) false]
    [(CompilerIrBlockList.Cons block rest)
      (let
        [instrs : CompilerIrInstrSeq
          (compiler-backend-gep-fold-block-instrs block)]
        [n : i64 (struct-get instrs len)]
        [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
        [j : i64 0]
        [found : bool false]
        (begin
          (while (< j n)
            (begin
              (match (array-ref slots j)
                [(CompilerIrInstr.Gep _ _ offset _)
                  (match offset
                    [(CompilerIrValue.Var _) (set! found true)]
                    [_ unit])]
                [_ unit])
              (set! j (+ j 1))))
          (if found
            true
            (compiler-backend-gep-fold-blocks-have-candidate? (box-get rest)))))]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-gep-fold-block-seq-has-candidate? seq)]))

(define (compiler-backend-gep-fold-block-seq-has-candidate?
  [blocks : CompilerIrBlockSeq]) : bool
  (let
    [count : i64 (compiler-ir-block-seq-count blocks)]
    [b : i64 0]
    [found : bool false]
    (begin
      (while (and (< b count) (not found))
        (begin
          (let
            [instrs : CompilerIrInstrSeq
              (compiler-backend-gep-fold-block-instrs
                (compiler-ir-block-seq-ref blocks b))]
            [n : i64 (struct-get instrs len)]
            [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
            [j : i64 0]
            (while (and (< j n) (not found))
              (begin
                (match (array-ref slots j)
                  [(CompilerIrInstr.Gep _ _ offset _)
                    (match offset
                      [(CompilerIrValue.Var _) (set! found true)]
                      [_ unit])]
                  [_ unit])
                (set! j (+ j 1)))))
          (set! b (+ b 1))))
      found)))

;; Entry: returns the (possibly rewritten) blocks and installs the
;; per-function displacement table; when nothing folds the input list is
;; returned unchanged and the table stays disabled.
(define (compiler-backend-gep-fold-blocks
  [type-segment-bases : i64]
  [vars : i64]
  [blocks : CompilerIrBlockList]) : CompilerIrBlockList
  (begin
    (compiler-backend-gep-fold-disable!)
    (if (or
      (<= vars 0)
      (not (compiler-backend-gep-fold-blocks-have-candidate? blocks)))
      blocks
      (let
        [barr : (Array CompilerIrBlock)
          (compiler-backend-gep-fold-block-array blocks)]
        [defs : (Array i64) (array.make-array i64 vars)]
        [uses : (Array i64) (compiler-backend-function-use-counts vars blocks)]
        [cand-base : (Array i64) (array.make-array i64 vars)]
        [cand-k : (Array i64) (array.make-array i64 vars)]
        [cand-block : (Array i64) (array.make-array i64 vars)]
        [cand-pos : (Array i64) (array.make-array i64 vars)]
        [gep-uses : (Array i64) (array.make-array i64 vars)]
        [gep-last : (Array i64) (array.make-array i64 vars)]
        (begin
          (compiler-backend-gep-fold-count-defs defs barr)
          (let
            [v : i64 0]
            (while (< v vars)
              (begin
                (array-set! cand-base v (- 0 1))
                (set! v (+ v 1)))))
          (compiler-backend-gep-fold-scan-adds
            barr
            defs
            cand-base
            cand-k
            cand-block
            cand-pos)
          (compiler-backend-gep-fold-scan-geps
            type-segment-bases
            barr
            defs
            cand-base
            cand-k
            cand-block
            cand-pos
            gep-uses
            gep-last)
          (compiler-backend-gep-fold-validate
            barr
            uses
            cand-base
            cand-block
            cand-pos
            gep-uses
            gep-last)
          (if (compiler-backend-gep-fold-any-valid? cand-base)
            (let
              [gep-count : i64 (compiler-backend-gep-fold-count-geps barr)]
              [disp-table : (Array i64) (array.make-array i64 gep-count)]
              [kind-table : (Array i64) (array.make-array i64 gep-count)]
              [scale-table : (Array i64) (array.make-array i64 gep-count)]
              [out : CompilerIrBlockList
                (compiler-backend-gep-fold-rewrite-blocks
                  type-segment-bases
                  barr
                  cand-base
                  cand-k
                  cand-block
                  disp-table
                  kind-table
                  scale-table)]
              (begin
                (set! compiler-backend-gep-fold-disp-table disp-table)
                (set! compiler-backend-gep-fold-kind-table kind-table)
                (set! compiler-backend-gep-fold-scale-table scale-table)
                (set! compiler-backend-gep-fold-cursor 0)
                (set! compiler-backend-gep-fold-drift false)
                (set! compiler-backend-gep-fold-ready true)
                out))
            blocks))))))

(define (compiler-backend-emit-function
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [func : CompilerIrFunction]
  [functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [global-types : CompilerBackendGlobalTypeList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [allow-rbp : bool]
  [shrinkwrap-enabled : bool]) : ResultCompilerBackend
  (match func
    [(CompilerIrFunction.Function name params ret-ty vars raw-blocks)
      ;; The provenance fallback diagnostic for this function: backend
      ;; errors raised while emitting its body stamp this function's source span
      ;; (or `1:1` when none was recorded) rather than always `1:1`.
      (let
        ;; Prefix dry-emission is part of shrink-wrap admission and precedes
        ;; this function's const-hoist build. Fail closed unless its scratch
        ;; state was reset successfully for this function.
        [shrinkwrap-state-admissible? : bool
          (compiler-backend-prepare-shrinkwrap-admission!)]
        ;; GAP9: fold constant gep index offsets into addressing displacements
        ;; BEFORE the register plan, so liveness sees the folded program (the
        ;; shared counter stays live; the offset adds vanish).
        [folded-blocks : CompilerIrBlockList
          (compiler-backend-gep-fold-blocks type-segment-bases vars raw-blocks)]
        ;; Cycle 26: split a property-proven frame-free entry region before
        ;; regalloc. Incoming parameters stay in ABI locations until the saving
        ;; edge, whose returned labels drive prologue placement and bare returns.
        [early-exit-func : CompilerIrFunction
          (let
            [folded-func : CompilerIrFunction
              (CompilerIrFunction.Function
                name
                params
                ret-ty
                vars
                folded-blocks)]
            (if (and
              shrinkwrap-enabled
              (compiler-backend-mode-scalar? mode)
              compiler-backend-scalar-registers-enabled)
              (compiler-reg-early-exit-shrinkwrap-function folded-func)
              (begin
                (set!
                  compiler-reg-early-exit-saving-label
                  (compiler-ir-label-none))
                (set! compiler-reg-early-exit-bare-label "")
                (set! compiler-reg-early-exit-prefix-count 0)
                folded-func)))]
        ;; Cycle 20: protect GP values only on one admitted cold call edge.  The
        ;; rewrite follows the early-exit split and still precedes regalloc, so
        ;; liveness sees both transformations.
        [cold-call-rewrite : CompilerRegColdCallRewrite
          (if (and
            (compiler-backend-mode-scalar? mode)
            compiler-backend-scalar-registers-enabled)
            (compiler-reg-cold-call-rewrite-function
              type-segment-bases
              early-exit-func)
            (CompilerRegColdCallRewrite.Rewrite early-exit-func (- 0 1)))]
        [cold-call-func : CompilerIrFunction
          (compiler-reg-cold-call-rewrite-function-value cold-call-rewrite)]
        [blocks : CompilerIrBlockList
          (match cold-call-func
            [(CompilerIrFunction.Function _ _ _ _ out-blocks) out-blocks])]
        [walk-vars : i64
          (match cold-call-func
            [(CompilerIrFunction.Function _ _ _ out-vars _) out-vars])]
        [cold-call-temp-start : i64
          (compiler-reg-cold-call-rewrite-temp-start cold-call-rewrite)]
        [walk-func : CompilerIrFunction
          (CompilerIrFunction.Function name params ret-ty walk-vars blocks)]
        [func-diag : CompilerDiagnostic
          (compiler-backend-function-diagnostic-index
            span-index
            (compiler-ir-symbol-typed-id name)
            "")]
        [_current-mode : unit (compiler-backend-set-current-mode! mode)]
        ;; Ensure the register allocator can see the program-wide group
        ;; word-count map (so a group-typed call result / param / mov gets a
        ;; register PAIR, not a single register). Idempotent per function.
        [_ra-grp : unit
          (compiler-reg-set-group-counts!
            (struct-get program-index group-word-counts))]
        [_ra-grp-mask : unit
          (compiler-reg-set-group-class-masks!
            (struct-get program-index group-word-class-masks))]
        ;; M-G3 stage 2: enable %rbp as the final CSR for this function's plan
        ;; on both text backends. The `allow-rbp` parameter is false only on the
        ;; DEMOTION retry (the FPO audit failed on an rbp-planned function).
        [_rbp-pool-flag : unit
          (compiler-reg-set-rbp-pool-enabled!
            (and
              allow-rbp
              (or
                (compiler-backend-target-linux? target)
                (compiler-backend-target-windows? target))
              (compiler-backend-mode-scalar? mode)
              compiler-backend-scalar-registers-enabled))]
        [fn-abi : CompilerRegTargetAbi (compiler-backend-regalloc-abi target)]
        [_fn-abi : unit (compiler-backend-set-current-fn-abi! fn-abi)]
        ;; The scalar-opt2 plan and the caller-save rewrite below both need the
        ;; var-type view of `walk-func`, and each used to walk the function for
        ;; its own copy. Compute it once here, on exactly the path that takes
        ;; both (`compiler-reg-plan-function-stack-only` and the SIMD plans do
        ;; not need it, and the rewrites are off when scalar registers are).
        [scalar-plan? : bool
          (and
            (compiler-backend-mode-scalar? mode)
            compiler-backend-scalar-registers-enabled)]
        [walk-types : CompilerRegVarTypes
          (if scalar-plan?
            (compiler-reg-function-var-types walk-func)
            (compiler-reg-var-types-empty))]
        [reg-plan : CompilerRegPlan
          (if (compiler-backend-mode-scalar? mode)
            (if compiler-backend-scalar-registers-enabled
              (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types
                type-segment-bases
                fn-abi
                walk-func
                cold-call-temp-start
                walk-types)
              (compiler-reg-plan-function-stack-only walk-func))
            (if (compiler-backend-mode-avx2? mode)
              (compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi
                type-segment-bases
                fn-abi
                walk-func)
              (compiler-reg-plan-function-with-type-segment-bases-for-abi
                type-segment-bases
                fn-abi
                walk-func)))]
        ;; A call-free natural loop can leave one volatile register dead before
        ;; the loop and another dead inside it while the whole-range greedy pays
        ;; for a callee-saved home. Detect that shape against the initial plan,
        ;; split the read-only range in IR, then REPLAN the rewritten function.
        ;; Replanning is essential: both physical pieces receive ordinary exact
        ;; intervals, so scratch occupancy and frame coloring never see the
        ;; conservative interval-less homes used by post-allocation rescues.
        [leaf-csr-rewrite : CompilerRegCallSaveRewrite
          (if scalar-plan?
            (compiler-reg-leaf-csr-split-rewrite-one
              type-segment-bases
              fn-abi
              walk-func
              blocks
              walk-vars
              walk-types
              reg-plan)
            (CompilerRegCallSaveRewrite.Rewrite
              blocks
              walk-vars
              walk-vars
              CompilerRegAssignmentList.Nil
              CompilerRegVarTypeList.Nil))]
        [alloc-blocks : CompilerIrBlockList
          (match leaf-csr-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite out-blocks _ _ _ _) out-blocks])]
        [alloc-vars : i64
          (match leaf-csr-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite _ _ out-vars _ _) out-vars])]
        [alloc-func : CompilerIrFunction
          (CompilerIrFunction.Function
            name
            params
            ret-ty
            alloc-vars
            alloc-blocks)]
        [alloc-types : CompilerRegVarTypes
          (if (= alloc-vars walk-vars)
            walk-types
            (compiler-reg-function-var-types alloc-func))]
        [alloc-preassignments : CompilerRegAssignmentList
          (match leaf-csr-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite _ _ _ assignments _)
              assignments])]
        [raw-alloc-reg-plan : CompilerRegPlan
          (if (= alloc-vars walk-vars)
            reg-plan
            (compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types-and-preassignments
              type-segment-bases
              fn-abi
              alloc-func
              cold-call-temp-start
              alloc-types
              alloc-preassignments))]
        [alloc-reg-plan : CompilerRegPlan
          (if (= alloc-vars walk-vars)
            raw-alloc-reg-plan
            (compiler-reg-plan-hide-leaf-csr-phantoms
              raw-alloc-reg-plan
              alloc-preassignments
              walk-vars))]
        [_cold-call-self-check : unit
          (cfg
            scavenge-self-check
            (if (compiler-reg-cold-call-carriers-stack?
              alloc-reg-plan
              cold-call-temp-start
              alloc-vars)
              unit
              (io.panic "regalloc: cold-call carrier escaped its stack home"))
            unit)]
        [call-save-enabled : bool
          (if (compiler-backend-mode-scalar? mode)
            compiler-backend-scalar-registers-enabled
            false)]
        ;; The caller-save / loop-split / remat IR-mutating rewrites run whenever
        ;; scalar register allocation is enabled.
        [non-split-passes-enabled : bool call-save-enabled]
        [call-save-rewrite : CompilerRegCallSaveRewrite
          (if non-split-passes-enabled
            (compiler-reg-caller-save-rewrite-blocks
              alloc-blocks
              alloc-vars
              alloc-types
              alloc-reg-plan)
            (CompilerRegCallSaveRewrite.Rewrite
              alloc-blocks
              alloc-vars
              alloc-vars
              CompilerRegAssignmentList.Nil
              CompilerRegVarTypeList.Nil))]
        [call-save-reg-plan : CompilerRegPlan
          (if call-save-enabled
            (compiler-reg-plan-with-call-save-rewrite
              alloc-reg-plan
              call-save-rewrite)
            alloc-reg-plan)]
        [call-save-blocks : CompilerIrBlockList
          (match call-save-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite out-blocks _ _ _ _) out-blocks])]
        [call-save-vars : i64
          (match call-save-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite _ _ out-vars _ _) out-vars])]
        [loop-split-func : CompilerIrFunction
          (CompilerIrFunction.Function
            name
            params
            ret-ty
            call-save-vars
            call-save-blocks)]
        [loop-split-rewrite : CompilerRegCallSaveRewrite
          (if non-split-passes-enabled
            (compiler-reg-loop-split-rewrite-blocks
              type-segment-bases
              loop-split-func
              call-save-blocks
              call-save-vars
              (compiler-reg-function-var-types loop-split-func)
              call-save-reg-plan)
            (CompilerRegCallSaveRewrite.Rewrite
              call-save-blocks
              call-save-vars
              call-save-vars
              CompilerRegAssignmentList.Nil
              CompilerRegVarTypeList.Nil))]
        [rewrite-reg-plan : CompilerRegPlan
          (if call-save-enabled
            (compiler-reg-plan-with-call-save-rewrite
              call-save-reg-plan
              loop-split-rewrite)
            alloc-reg-plan)]
        [rewritten-blocks : CompilerIrBlockList
          (match loop-split-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite out-blocks _ _ _ _) out-blocks])]
        [rewritten-vars : i64
          (match loop-split-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite _ _ out-vars _ _) out-vars])]
        ;; Pipeline order: caller-save -> loop-split -> REMAT. The remat output is
        ;; the intermediate (`remat0-*`); the identity `splitkit-rewrite` stage
        ;; below re-exports it under the downstream-facing `remat-*` names (final
        ;; pipeline blocks/vars/plan), so nothing downstream changes.
        [remat0-func : CompilerIrFunction
          (CompilerIrFunction.Function
            name
            params
            ret-ty
            rewritten-vars
            rewritten-blocks)]
        [remat0-rewrite : CompilerRegCallSaveRewrite
          (if call-save-enabled
            (compiler-reg-remat-rewrite-blocks
              type-segment-bases
              remat0-func
              rewritten-blocks
              rewritten-vars
              (compiler-reg-function-var-types remat0-func)
              rewrite-reg-plan)
            (CompilerRegCallSaveRewrite.Rewrite
              rewritten-blocks
              rewritten-vars
              rewritten-vars
              CompilerRegAssignmentList.Nil
              CompilerRegVarTypeList.Nil))]
        [remat0-reg-plan : CompilerRegPlan
          (if call-save-enabled
            (compiler-reg-plan-with-call-save-rewrite
              rewrite-reg-plan
              remat0-rewrite)
            rewrite-reg-plan)]
        [remat0-blocks : CompilerIrBlockList
          (match remat0-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite out-blocks _ _ _ _) out-blocks])]
        [remat0-vars : i64
          (match remat0-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite _ _ out-vars _ _) out-vars])]
        ;; SplitKit removed: it was inert on the shipped path (the realization
        ;; declined every recorded piece), replaced by M-G2b's per-call-region
        ;; split + FPO. The final pipeline stage is the identity of the remat
        ;; output.
        [splitkit-rewrite : CompilerRegCallSaveRewrite
          (CompilerRegCallSaveRewrite.Rewrite
            remat0-blocks
            remat0-vars
            remat0-vars
            CompilerRegAssignmentList.Nil
            CompilerRegVarTypeList.Nil)]
        ;; Downstream-facing FINAL pipeline names (= identity of the remat output).
        [remat-reg-plan : CompilerRegPlan
          (if call-save-enabled
            (compiler-reg-plan-with-call-save-rewrite
              remat0-reg-plan
              splitkit-rewrite)
            remat0-reg-plan)]
        [remat-blocks : CompilerIrBlockList
          (match splitkit-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite out-blocks _ _ _ _) out-blocks])]
        [remat-vars : i64
          (match splitkit-rewrite
            [(CompilerRegCallSaveRewrite.Rewrite _ _ out-vars _ _) out-vars])]
        [_regalloc-census : unit
          (cfg
            regalloc-census
            (if call-save-enabled
              (compiler-reg-call-span-census-record-plan!
                alloc-func
                alloc-reg-plan)
              unit)
            unit)]
        [scratch-plan-result : CompilerRegScratchPlanResult
          (if call-save-enabled
            (compiler-reg-plan-with-scratch-vreg-result
              type-segment-bases
              fn-abi
              (CompilerIrFunction.Function
                name
                params
                ret-ty
                remat-vars
                remat-blocks)
              remat-reg-plan
              remat-vars)
            (CompilerRegScratchPlanResult.Result
              remat-reg-plan
              (compiler-reg-scratch-plan-empty)))]
        [scratch-plan : CompilerRegScratchPlan
          (match scratch-plan-result
            [(CompilerRegScratchPlanResult.Result _ out-plan) out-plan])]
        [scratch-reg-plan : CompilerRegPlan
          (match scratch-plan-result
            [(CompilerRegScratchPlanResult.Result out-plan _) out-plan])]
        [scratch-vars : i64
          (compiler-reg-plan-var-count scratch-reg-plan remat-vars)]
        [plan-types : CompilerRegVarTypeList
          (compiler-reg-plan-types scratch-reg-plan)]
        ;; Computed once per function: the gate below, the coloring pass, and
        ;; the frame layout all consume it (the per-block fixpoint scan is too
        ;; costly to repeat).
        [fn-group-vars : CompilerLiveI64Set
          (compiler-reg-function-group-vars
            type-segment-bases
            (CompilerIrFunction.Function
              name
              params
              ret-ty
              scratch-vars
              remat-blocks)
            plan-types)]
        [has-group-vars : bool (> (compiler-live-set-count fn-group-vars) 0)]
        ;; Compact the frame after regalloc by renumbering stack-resident
        ;; values into a dense slot prefix. Plans without intervals (the
        ;; stack-only opt0/opt1 path) pass through unchanged. Only real remat
        ;; vars can demand slots; scratch pseudo-vars are register-only.
        ;; `slot-vars` replaces the raw var count everywhere the frame layout
        ;; is derived, while `scratch-vars` keeps indexing per-variable side
        ;; tables.
        [coloring
          : CompilerRegColoring
          ;; Stack-homed register groups keep word0 in their remapped formula
          ;; slot; word1 indexes the second var-region by the same remapped id.
          ;; That keeps both words inside the `slot-vars`-sized frame instead of
          ;; preserving the old high raw ids that drove frame growth.
          (compiler-reg-color-stack-slots
            type-segment-bases
            scratch-reg-plan
            fn-group-vars
            params
            remat-blocks
            scratch-vars
            remat-vars)]
        [assignments : CompilerRegAssignmentList
          (match coloring
            [(CompilerRegColoring.None)
              (compiler-reg-plan-assignments scratch-reg-plan)]
            [(CompilerRegColoring.Remap remap _)
              (compiler-reg-color-rebuild-assignments
                remap
                scratch-vars
                (compiler-reg-plan-assignments scratch-reg-plan))])]
        ;; Dense O(1) operand-home index for emission, built ONCE per function
        ;; from the final list above (caller-save / loop-split / remat /
        ;; scratch-vreg / slot-coloring re-plans are all folded into it by this
        ;; point, so no stage can go stale). Sized by scratch-vars -- the full
        ;; var count the assignments and the emitted IR are keyed to -- matching
        ;; the scavenge self-check idiom. Small functions skip the build: an
        ;; early-exit walk of a short sorted list is already cheaper than the
        ;; wrapper's array setup, so they stay on the list lookup (identical
        ;; results) and pay no per-function array allocation.
        [_emit-assignment-index : unit
          (begin
            (if (>= scratch-vars 64)
              (begin
                (set!
                  compiler-backend-emit-assignment-index
                  (compiler-reg-assignment-index-build assignments scratch-vars))
                (set! compiler-backend-emit-assignment-index-active true))
              (set! compiler-backend-emit-assignment-index-active false))
            (set! compiler-backend-rax-override-var -1)
            (set! compiler-backend-rax-forward-pending-var -1)
            (compiler-backend-emit-home-overrides-disable!))]
        [scavenge-assignments
          : CompilerRegAssignmentList
          ;; Start ordinary scavenging from real IR homes. Planned scratch
          ;; homes are appended below with exact intervals; retaining them as
          ;; interval-less pseudo-vars here would reserve each register for the
          ;; entire function and force unrelated sites into emergency saves.
          (match coloring
            [(CompilerRegColoring.None)
              (compiler-reg-plan-assignments remat-reg-plan)]
            [(CompilerRegColoring.Remap remap _)
              (compiler-reg-color-rebuild-assignments
                remap
                scratch-vars
                (compiler-reg-plan-assignments remat-reg-plan))])]
        [emit-blocks-list : CompilerIrBlockList
          (match coloring
            [(CompilerRegColoring.None) remat-blocks]
            [(CompilerRegColoring.Remap remap _)
              (compiler-reg-remap-blocks remap remat-blocks)])]
        [slot-vars : i64
          (match coloring
            ;; Synthetic scratch ids are register-only and are not referenced
            ;; by the emitted IR. When stack coloring is unavailable, retain
            ;; the real rewritten var count so scratch planning cannot grow
            ;; the frame merely by numbering temporary register intervals.
            [(CompilerRegColoring.None) remat-vars]
            [(CompilerRegColoring.Remap _ slots) slots])]
        [scavenge-intervals
          : CompilerRegIntervalSeq
          ;; Scavenge occupancy must be keyed to the FINAL emitted IR at
          ;; instruction precision. The allocator plan intervals predate
          ;; call-save/remat rewrites and frame slot compaction, and the cheap
          ;; block interval builder can miss within-block live-through scratch
          ;; hazards. The full live-after intervals are the source of truth for
          ;; register-owned values that must not be scavenged.
          (if (compiler-backend-assignments-have-register-home?
            scavenge-assignments)
            (let
              [scavenge-func : CompilerIrFunction
                (CompilerIrFunction.Function
                  name
                  params
                  ret-ty
                  scratch-vars
                  emit-blocks-list)]
              (compiler-reg-live-intervals
                scavenge-func
                (compiler-live-analyze-function scavenge-func)))
            (compiler-reg-interval-seq-empty))]
        [types : CompilerRegVarTypeList
          (match coloring
            [(CompilerRegColoring.None) plan-types]
            [(CompilerRegColoring.Remap remap _)
              (compiler-reg-color-rebuild-types remap scratch-vars plan-types)])]
        [emit-group-vars : CompilerLiveI64Set
          (match coloring
            [(CompilerRegColoring.None) fn-group-vars]
            [(CompilerRegColoring.Remap remap _)
              (compiler-backend-remap-group-vars fn-group-vars remap)])]
        [addressable-group-vars : CompilerLiveI64Set
          (if (> (compiler-live-set-count emit-group-vars) 0)
            (compiler-backend-addressable-group-vars-blocks
              emit-group-vars
              emit-blocks-list
              (compiler-live-set-empty))
            (compiler-live-set-empty))]
        [_group-var-flags : unit
          (begin
            (compiler-backend-current-slot-vars-set! slot-vars)
            (compiler-backend-group-vars-enable!
              emit-group-vars
              addressable-group-vars))]
        [symbol : String
          (compiler-backend-function-symbol-index program-index name)]
        [label-scope : String
          (compiler-backend-function-label-scope program-index name)]
        [use-counts : (Array i64) (array.make-array i64 scratch-vars)]
        [fuse-free-counts : (Array i64) (array.make-array i64 scratch-vars)]
        [_use-facts : unit
          (compiler-backend-count-block-use-facts
            use-counts
            fuse-free-counts
            emit-blocks-list)]
        [identity-tail-forwarder? : bool
          (compiler-backend-identity-tail-forwarder?
            type-segment-bases
            target
            name
            params
            emit-blocks-list
            program-index)]
        [shrinkwrap-saving-label : i64 compiler-reg-early-exit-saving-label]
        [shrinkwrap-bare-label : String compiler-reg-early-exit-bare-label]
        [shrinkwrap-prefix-count : i64 compiler-reg-early-exit-prefix-count]
        [shrinkwrap-planned-guard : String
          (if (or
            (not shrinkwrap-state-admissible?)
            (string.eq shrinkwrap-bare-label ""))
            ""
            (compiler-backend-shrinkwrap-prefix-asm
              type-segment-bases
              target
              params
              scratch-vars
              assignments
              label-scope
              name
              emit-blocks-list
              shrinkwrap-bare-label
              shrinkwrap-prefix-count
              ret-ty
              program-index
              false))]
        [shrinkwrap-incoming-prefix : String
          (if (or
            (not shrinkwrap-state-admissible?)
            (string.eq shrinkwrap-bare-label ""))
            ""
            (compiler-backend-shrinkwrap-prefix-asm
              type-segment-bases
              target
              params
              scratch-vars
              assignments
              label-scope
              name
              emit-blocks-list
              shrinkwrap-bare-label
              shrinkwrap-prefix-count
              ret-ty
              program-index
              true))]
        [shrinkwrap-incoming-guard : String
          (if (string.eq shrinkwrap-incoming-prefix "")
            ""
            (str_cat.str-cat
              shrinkwrap-incoming-prefix
              "    # shrinkwrap incoming guard\n"
              ""))]
        [shrinkwrap-candidate? : bool
          (and
            (not
              (and
                (compiler-debug-info-enabled?)
                (compiler-backend-target-linux? target)))
            shrinkwrap-state-admissible?
            (not (= shrinkwrap-saving-label (compiler-ir-label-none)))
            (not (string.eq shrinkwrap-bare-label ""))
            (not (string.eq shrinkwrap-planned-guard ""))
            (not (string.eq shrinkwrap-incoming-guard ""))
            (not (string.eq (compiler-ir-symbol-text name) "main")))]
        ;; Const-hoist register admission must see every cfg-gated scratch-vreg
        ;; home over its exact point range. The published scratch reg-plan keeps
        ;; only unique callee-saved homes for prologue accounting, so append the
        ;; complete scratch plan as fresh synthetic vars for this occupancy
        ;; query. Otherwise a caller-saved scratch such as %r9 can be selected
        ;; for a loop magic and then overwrite that magic at a divmod site.
        [const-hoist-occupancy-vars : i64
          (compiler-backend-scratch-plan-extend-vars scratch-plan scratch-vars)]
        [const-hoist-occupancy-assignments : CompilerRegAssignmentList
          (compiler-backend-scratch-plan-extend-assignments
            scratch-plan
            scratch-vars
            assignments)]
        [const-hoist-occupancy-intervals : CompilerRegIntervalSeq
          (compiler-backend-scratch-plan-extend-intervals
            scratch-plan
            scratch-vars
            scavenge-intervals)]
        ;; M-F: loop-hoisted divmod magic constants. Built over the FINAL
        ;; emitted IR + the same fresh intervals the scavenge occupancy uses,
        ;; so a hoist register is provably free over its whole loop region and
        ;; the synthetic entries below keep every scavenge away from it.
        ;; Scalar-opt2 text path. The candidate list filters Win64 callee-saved
        ;; %rsi/%rdi while retaining ABI-safe %r8/%r9 and %rbx (frame-homed for
        ;; divmod). Empty plan = byte-identical.
        [const-hoist-synth : CompilerBackendConstHoistSynth
          (if (and
            call-save-enabled
            (not identity-tail-forwarder?)
            ;; Guard blocks contain comparisons only. Divmod hoists are placed
            ;; at their loop/body region, which is necessarily beyond the
            ;; saving frontier, so admitted functions retain the same general
            ;; loop-constant optimization as the unwrapped pipeline.
            true)
            (compiler-backend-const-hoist-build!
              type-segment-bases
              target
              emit-blocks-list
              const-hoist-occupancy-assignments
              const-hoist-occupancy-intervals
              const-hoist-occupancy-vars
              (compiler-backend-frame-slots-emergency-max
                slot-vars
                has-group-vars))
            (compiler-backend-const-hoist-disable!))]
        ;; A stack frame alone is sufficient reason to wrap; limiting this to
        ;; plans with callee-saved homes left frame-only functions rewritten but
        ;; still prologued before their guard. Candidate proof plus the verified
        ;; textual splices is the complete activation condition.
        [shrinkwrap-active? : bool shrinkwrap-candidate?]
        [scavenge-base-vars : i64
          (compiler-backend-const-hoist-extend-vars
            const-hoist-synth
            scratch-vars)]
        [scavenge-base-assignments : CompilerRegAssignmentList
          (compiler-backend-const-hoist-extend-assignments
            const-hoist-synth
            scratch-vars
            scavenge-assignments)]
        [scavenge-base-intervals : CompilerRegIntervalSeq
          (compiler-backend-const-hoist-extend-intervals
            const-hoist-synth
            scratch-vars
            scavenge-intervals)]
        [_scavenge-install-ctx
          : unit
          ;; Use scratch-vars (the FULL var count the assignments are sized for), NOT
          ;; slot-vars (the compacted stack-slot count): register-homed vars keep
          ;; indices >= slot-vars, so a slot-vars-sized ctx would miss them and the
          ;; free-register query would false-free their registers (e.g. a pooled %r8
          ;; holding a register var). M-F and the cfg-gated scratch-vreg path append
          ;; synthetic register-homed pseudo-vars so scavenging avoids those planned
          ;; registers inside their regions.
          (begin
            (compiler-backend-scavenge-install-ctx-from-intervals!
              (compiler-backend-scratch-plan-extend-vars
                scratch-plan
                scavenge-base-vars)
              (compiler-backend-scratch-plan-extend-assignments
                scratch-plan
                scavenge-base-vars
                scavenge-base-assignments)
              (compiler-backend-scratch-plan-extend-intervals
                scratch-plan
                scavenge-base-vars
                scavenge-base-intervals))
            (set!
              compiler-backend-scavenge-ctx-scratch-masks
              (compiler-backend-scratch-plan-occupancy-build
                scratch-plan
                (array-length compiler-backend-scavenge-ctx-occupied-masks))))]
        [_scavenge-self-check : unit
          (cfg
            scavenge-self-check
            (compiler-backend-scavenge-self-check
              name
              params
              ret-ty
              scratch-vars
              emit-blocks-list
              assignments)
            unit)]
        (if (compiler-backend-inline-memory-call-name? symbol)
          (ResultCompilerBackend.Ok
            (compiler-backend-emit-inline-memory-helper-function target symbol))
          (let
            [_phi-targets : unit
              (set!
                compiler-backend-current-phi-targets
                (compiler-backend-phi-target-labels-for-blocks emit-blocks-list))]
            ;; Must precede the parameter spills: those store incoming registers
            ;; into frame slots, and their references have to count.
            [_frame-slot-flag : unit
              (compiler-backend-frame-slot-referenced-reset!)]
            (match (if identity-tail-forwarder?
              (ResultCompilerBackend.Ok "")
              (if (compiler-backend-spmd-private-function? name)
                (compiler-backend-emit-spmd-private-param-spills
                  type-segment-bases
                  target
                  assignments
                  params
                  slot-vars)
                (compiler-backend-emit-param-spills
                  type-segment-bases
                  target
                  assignments
                  params
                  0
                  0
                  0
                  0
                  program-index
                  slot-vars)))
              [(ResultCompilerBackend.Ok spills)
                (let
                  [_carry-safe : unit
                    (compiler-backend-peephole-collect-carry-safe!
                      label-scope
                      emit-blocks-list)]
                  [_addr-forward : unit
                    (compiler-backend-addr-of-forwarding-enable!
                      scratch-vars
                      emit-blocks-list
                      use-counts)]
                  [_fuse-need : unit
                    (compiler-backend-fuse-need-enable!
                      use-counts
                      fuse-free-counts)]
                  [_identity-tail-forwarder : unit
                    (set!
                      compiler-backend-identity-tail-forwarder-active
                      identity-tail-forwarder?)]
                  [_shrinkwrap-return : unit
                    (set!
                      compiler-backend-shrinkwrap-bare-label
                      (if shrinkwrap-active?
                        shrinkwrap-bare-label
                        ""))]
                  [outgoing-frame-space : i64
                    (compiler-backend-outgoing-frame-space
                      type-segment-bases
                      target
                      emit-blocks-list
                      program-index)]
                  [dynamic-frame-base : i64
                    (+
                      (compiler-backend-frame-size
                        (+
                          (compiler-backend-frame-slots-emergency-max
                            slot-vars
                            has-group-vars)
                          compiler-backend-const-hoist-frame-count))
                      outgoing-frame-space)]
                  [_emergency-init : unit
                    (begin
                      (set! compiler-backend-cycle-temp-used-count 0)
                      (set!
                        compiler-backend-cycle-temp-base-offset
                        (- 0 (+ dynamic-frame-base 8)))
                      (set! compiler-backend-emergency-used false)
                      (set! compiler-backend-emergency-pending false)
                      (set! compiler-backend-emergency-restore-suppressed false)
                      (set! compiler-backend-emergency-used-count 0)
                      (set! compiler-backend-emergency-pending-count 0)
                      (set!
                        compiler-backend-emergency-slot-offset
                        (-
                          0
                          (+
                            dynamic-frame-base
                            (+
                              (compiler-backend-cycle-temp-frame-extra
                                (compiler-backend-cycle-temp-max-slots))
                              (compiler-backend-emergency-slot-size))))))]
                  (match (compiler-backend-emit-blocks
                    type-segment-bases
                    target
                    label-scope
                    name
                    emit-blocks-list
                    emit-blocks-list
                    assignments
                    slot-vars
                    types
                    global-types
                    ret-ty
                    (cfg
                      scratch-vreg
                      (CompilerBackendRuntimePlan.WithScratch
                        (box plan)
                        scratch-plan)
                      plan)
                    functions
                    externs
                    program-index
                    spans
                    span-index
                    func-diag
                    use-counts)
                    [(ResultCompilerBackend.Ok body)
                      ;; GAP9 drift check: every Gep must have consumed its
                      ;; ordinal with a matching shape; a mismatch means a
                      ;; displacement could have been misapplied, so fail the
                      ;; compile loudly instead of emitting wrong addressing.
                      (if (compiler-backend-gep-fold-drift?)
                        (ResultCompilerBackend.Err
                          (box
                            (compiler-backend-apply-instr-diagnostic
                              (compiler-diagnostic-at-start
                                ""
                                (string.append
                                  "backend: gep displacement ordinal drift in "
                                  (compiler-ir-symbol-text name)))
                              func-diag)))
                        (let
                          [dynamic-frame-extra : i64
                            (+
                              (compiler-backend-cycle-temp-frame-extra-needed
                                compiler-backend-cycle-temp-used-count
                                compiler-backend-emergency-used)
                              (compiler-backend-emergency-frame-extra
                                compiler-backend-emergency-used-count))]
                          [frame : i64
                            (+
                              (+
                                (compiler-backend-frame-size
                                  (+
                                    (if (or
                                      compiler-backend-emergency-used
                                      (>
                                        compiler-backend-cycle-temp-used-count
                                        0)
                                      (>
                                        compiler-backend-const-hoist-frame-count
                                        0))
                                      ;; A dynamic bottom-of-frame slot was used:
                                      ;; reserve the max callee-save area so those
                                      ;; slots never overlap on-demand CSR saves.
                                      (compiler-backend-frame-slots-emergency-max
                                        slot-vars
                                        has-group-vars)
                                      ;; Nothing named a frame slot: the slot
                                      ;; region is dead. Leaf helpers stop paying
                                      ;; sub/add for a frame they never touch.
                                      ;; Outgoing stack args are %rsp-relative
                                      ;; and stay accounted separately below.
                                      (if (or
                                        compiler-backend-frame-slot-referenced
                                        (> outgoing-frame-space 0)
                                        (compiler-backend-blocks-have-call?
                                          emit-blocks-list))
                                        (compiler-backend-frame-slots-with-groups
                                          slot-vars
                                          assignments
                                          has-group-vars)
                                        0))
                                    compiler-backend-const-hoist-frame-count))
                                outgoing-frame-space)
                              dynamic-frame-extra)]
                          [_addr-forward-done : unit
                            (begin
                              (set!
                                compiler-backend-identity-tail-forwarder-active
                                false)
                              (compiler-backend-addr-of-forwarding-disable!)
                              (compiler-backend-group-vars-disable!)
                              (compiler-backend-fuse-need-disable!)
                              (compiler-backend-gep-fold-disable!))]
                          [saving-prologue-body : String
                            (str_cat.str-cat
                              (compiler-backend-emit-save-callee-regs
                                assignments
                                slot-vars)
                              (compiler-backend-emit-windows-main-argv-capture
                                target
                                (compiler-ir-symbol-text name)
                                emit-entry
                                plan)
                              (compiler-backend-emit-linux-crt-main-argv-capture
                                target
                                (compiler-ir-symbol-text name)
                                crt-entry
                                plan)
                              (if (and
                                (string.eq
                                  (compiler-ir-symbol-text name)
                                  "main")
                                (or
                                  (compiler-backend-target-windows? target)
                                  (and
                                    crt-entry
                                    (compiler-backend-target-linux? target))))
                                (compiler-backend-global-initializers
                                  type-segment-bases
                                  globals
                                  program-index)
                                "")
                              spills
                              "")]
                          [saving-asm-label : String
                            (compiler-backend-asm-label
                              label-scope
                              shrinkwrap-saving-label)]
                          [guarded-body : String
                            (if shrinkwrap-active?
                              (string.replace
                                body
                                shrinkwrap-planned-guard
                                shrinkwrap-incoming-guard)
                              body)]
                          [framed-body : String
                            (if shrinkwrap-active?
                              (let
                                [label-line : String
                                  (str_cat.str-cat saving-asm-label ":\n" "")]
                                (string.replace
                                  guarded-body
                                  label-line
                                  (str_cat.str-cat
                                    label-line
                                    saving-prologue-body
                                    "")))
                              (str_cat.str-cat
                                saving-prologue-body
                                guarded-body
                                ""))]
                          [post-prologue : String
                            (str_cat.str-cat
                              (compiler-backend-mode-prologue mode)
                              framed-body
                              (compiler-backend-return-epilogue
                                name
                                assignments
                                slot-vars
                                emit-blocks-list)
                              "")]
                          ;; M-G3 stage 2: attempt frame-pointer omission on both
                          ;; text backends. Win64's FPO prologue emits explicit
                          ;; push/stack/XMM SEH unwind codes and the audit rejects
                          ;; any body whose rsp shape cannot stay unwind-stable.
                          [fpo-target : bool
                            (or
                              (compiler-backend-target-linux? target)
                              (compiler-backend-target-windows? target))]
                          ;; GAP1: push-style CSR saves ride the FPO audit --
                          ;; the plan-saved CSR set is fixed pre-body (the
                          ;; scavenger only hands out plan-saved callee regs;
                          ;; emergency picks are wrapped locally), so the push
                          ;; prologue below and the pass's save-deletion /
                          ;; epilogue rewrites see the same registers. On audit
                          ;; failure the ORIGINAL text (mov saves intact) feeds
                          ;; the stage-1 keep-rbp fallback unchanged.
                          [push-regs : (Array String)
                            (compiler-backend-rsp-rebase-make-push-regs)]
                          [push-count : i64
                            (if fpo-target
                              (compiler-backend-fill-push-csr-regs!
                                assignments
                                push-regs)
                              0)]
                          ;; Win64 UWOP_SAVE_XMM128 encodes its stack offset in
                          ;; 16-byte units. An even GP-push count leaves the
                          ;; canonical frame slots at rsp+8 (mod 16), so retain
                          ;; the rbp frame for that uncommon mixed shape. GP-only
                          ;; functions and odd-push XMM functions remain FPO.
                          [fpo-attempt : bool
                            (and
                              (not
                                (and
                                  (compiler-debug-info-enabled?)
                                  (compiler-backend-target-linux? target)))
                              fpo-target
                              (or
                                (not
                                  (and
                                    (compiler-backend-target-windows? target)
                                    (compiler-backend-plan-uses-win64-xmm-callee-regs?
                                      assignments)))
                                (= (bit-and push-count 1) 1)))]
                          [_fpo-bare : unit
                            (set!
                              compiler-backend-fpo-bare-frame
                              (and
                                fpo-attempt
                                (= push-count 0)
                                (= frame 0)
                                (not compiler-backend-frame-slot-referenced)
                                (not
                                  (compiler-backend-blocks-have-call?
                                    emit-blocks-list))))]
                          [rebased : String
                            (compiler-backend-rsp-rebase-full
                              post-prologue
                              frame
                              fpo-attempt
                              push-regs
                              push-count
                              slot-vars)]
                          [rebase-ok : bool compiler-backend-rsp-rebase-last-ok]
                          [fpo-ok : bool (and fpo-attempt rebase-ok)]
                          (if (and
                            (not fpo-ok)
                            (compiler-backend-plan-uses-reg? assignments "%rbp"))
                            ;; DEMOTE: the FPO audit failed but the plan homes a
                            ;; value in %rbp (which has no frame base to fall
                            ;; back to) -- re-plan and re-emit without %rbp in
                            ;; the pool. The retry cannot demote again
                            ;; (allow-rbp=false => no %rbp homes).
                            (begin
                              (set!
                                compiler-backend-fpo-demote-count
                                (+ compiler-backend-fpo-demote-count 1))
                              ;; DEMOTE retry: re-plan/re-emit without %rbp in the
                              ;; pool (allow-rbp=false => no %rbp homes, so it
                              ;; cannot demote again).
                              (compiler-backend-emit-function
                                type-segment-bases
                                target
                                mode
                                func
                                functions
                                globals
                                global-types
                                externs
                                plan
                                program-index
                                spans
                                span-index
                                emit-entry
                                crt-entry
                                false
                                shrinkwrap-enabled))
                            (let
                              [final-body : String
                                (if fpo-ok
                                  rebased
                                  (if fpo-attempt
                                    ;; FPO audit failed with no %rbp in the
                                    ;; plan: retain the stage-1 rbp frame.
                                    (compiler-backend-rsp-rebase
                                      post-prologue
                                      frame
                                      false)
                                    rebased))]
                              [entry-symbol : String
                                (if shrinkwrap-active?
                                  saving-asm-label
                                  symbol)]
                              [selected-prologue : String
                                (if fpo-ok
                                  (if (compiler-backend-target-windows? target)
                                    (compiler-backend-emit-function-entry-fpo-windows
                                      entry-symbol
                                      frame
                                      assignments
                                      slot-vars
                                      push-regs
                                      push-count)
                                    (if (> push-count 0)
                                      (compiler-backend-emit-function-entry-fpo-push
                                        entry-symbol
                                        frame
                                        push-regs
                                        push-count)
                                      (compiler-backend-emit-function-entry-fpo
                                        entry-symbol
                                        frame)))
                                  (compiler-backend-emit-function-entry
                                    target
                                    entry-symbol
                                    frame
                                    assignments
                                    slot-vars))]
                              [emitted-body : String
                                (if shrinkwrap-active?
                                  (string.replace
                                    final-body
                                    (str_cat.str-cat saving-asm-label ":\n" "")
                                    selected-prologue)
                                  final-body)]
                              (if (or
                                ;; The IR was split before allocation. If later
                                ;; admission cannot render both scratch-free
                                ;; prefixes (or intentionally excludes `main`),
                                ;; do not leave the duplicated CFG under an
                                ;; always-framed prologue: retry from the original
                                ;; function with the rewrite disabled.
                                (and
                                  (not shrinkwrap-active?)
                                  (not
                                    (=
                                      shrinkwrap-saving-label
                                      (compiler-ir-label-none))))
                                (compiler-backend-shrinkwrap-splice-fallback-required?
                                  shrinkwrap-active?
                                  body
                                  guarded-body
                                  framed-body
                                  final-body
                                  emitted-body))
                                ;; A textual invariant drifted. Re-run the full
                                ;; unwrapped pipeline so the IR split, bare return,
                                ;; register plan, and prologue placement are all
                                ;; consistently disabled together.
                                (compiler-backend-emit-function
                                  type-segment-bases
                                  target
                                  mode
                                  func
                                  functions
                                  globals
                                  global-types
                                  externs
                                  plan
                                  program-index
                                  spans
                                  span-index
                                  emit-entry
                                  crt-entry
                                  allow-rbp
                                  false)
                                (begin
                                  (compiler-backend-commit-frame-layout!
                                    target
                                    assignments
                                    symbol
                                    frame
                                    push-count
                                    slot-vars
                                    outgoing-frame-space
                                    fpo-ok
                                    rebase-ok
                                    shrinkwrap-active?)
                                  (ResultCompilerBackend.Ok
                                    (str_cat.str-cat
                                      (compiler-backend-function-symbol-map-comment
                                        program-index
                                        name)
                                      ".globl "
                                      symbol
                                      "\n"
                                      (compiler-backend-debug-function-location
                                        target
                                        program-index
                                        span-index
                                        spans
                                        name)
                                      (if shrinkwrap-active?
                                        (str_cat.str-cat symbol ":\n" "")
                                        selected-prologue)
                                      ""
                                      ""
                                      ;; Last body rewrite: the text is final
                                      ;; here (prologue spliced, rsp rebased, FPO
                                      ;; decided) and every text target shares
                                      ;; this seam, so the scan sees exactly the
                                      ;; bytes the assembler will.
                                      (compiler-backend-drop-fallthrough-jumps
                                        emitted-body)
                                      (compiler-backend-debug-function-end-label
                                        target
                                        program-index
                                        name)
                                      (if (and
                                        (compiler-debug-info-enabled?)
                                        (compiler-backend-target-linux? target))
                                        "    .cfi_endproc\n"
                                        "")
                                      (compiler-backend-emit-windows-seh-endproc
                                        target)
                                      "\n"))))))))]
                    [(ResultCompilerBackend.Err message)
                      (let
                        [_addr-forward-done : unit
                          (begin
                            (set!
                              compiler-backend-identity-tail-forwarder-active
                              false)
                            (compiler-backend-addr-of-forwarding-disable!)
                            (compiler-backend-group-vars-disable!)
                            (compiler-backend-fuse-need-disable!)
                            (compiler-backend-gep-fold-disable!))]
                        (ResultCompilerBackend.Err message))]))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)]))))]))

;; 0: every function escapes through a per-function scratch arena. The old
;; limit of 24 sent small-function transients to the program arena to skip
;; the scratch/clone overhead, but their summed assembly-text churn stays
;; resident for the whole compile (RSS calibration); the per-function
;; arena reclaims it.
(define (compiler-backend-direct-emit-instr-limit) : i64
  0)

(define (compiler-backend-clear-function-emit-state!) : unit
  (begin
    (set! compiler-backend-emit-assignment-index-active false)
    (set! compiler-backend-rax-override-var -1)
    (set! compiler-backend-rax-forward-pending-var -1)
    (compiler-backend-set-scavenge-ctx!
      (make-array i64 1)
      (make-array i64 1)
      CompilerRegAssignmentList.Nil
      0)
    (compiler-backend-addr-of-forwarding-disable!)
    (compiler-backend-group-vars-disable!)
    (compiler-backend-fuse-need-disable!)
    (compiler-backend-gep-fold-disable!)
    (set!
      compiler-backend-current-phi-targets
      (compiler-backend-empty-label-seq))
    (set! compiler-backend-current-phi-target-count 0)
    (set! compiler-backend-emit-instr-post-base 0)
    (set! compiler-backend-emit-current-count 0)
    (set! compiler-backend-emit-instrs-loop-active false)
    (set! compiler-backend-emit-instrs-continue-pending false)
    (set! compiler-backend-shrinkwrap-bare-label "")
    (set! compiler-backend-current-block-label (compiler-ir-label-none))
    (compiler-backend-set-current-mode! (CompilerBackendMode.Scalar))
    (set! compiler-backend-identity-tail-forwarder-active false)
    (set! compiler-backend-emergency-used false)
    (set! compiler-backend-emergency-pending false)
    (set! compiler-backend-emergency-restore-suppressed false)
    (set! compiler-backend-emergency-used-count 0)
    (set! compiler-backend-emergency-pending-count 0)
    (set! compiler-backend-emergency-reg "")))

(define (compiler-backend-clear-scratch-escaped-emit-state!) : unit
  (begin
    (compiler-backend-clear-function-emit-state!)
    (compiler-backend-const-hoist-disable!)
    unit))

(define (compiler-backend-emit-function-direct? [func : CompilerIrFunction]) : bool
  (match func
    [(CompilerIrFunction.Function _ _ _ _ blocks)
      (<=
        (compiler-ir-block-list-instruction-count blocks)
        (compiler-backend-direct-emit-instr-limit))]))

(define (compiler-backend-emit-function-scratch
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [func : CompilerIrFunction]
  [all-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [global-types : CompilerBackendGlobalTypeList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]) : ResultCompilerBackend
  (let
    ;; The symbol cache stores generated strings. Per-function emission runs in
    ;; a scratch arena, so cached values must not survive across functions.
    [_cache-before : unit (compiler-backend-user-symbol-cache-reset!)]
    [result : ResultCompilerBackend
      (with-escape
        (arena.Arena scratch)
        (compiler-backend-emit-function
          type-segment-bases
          target
          mode
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          true
          true))]
    (begin
      (compiler-backend-user-symbol-cache-reset!)
      result)))

;; Keep the direct path available for A/B experiments by raising
;; `compiler-backend-direct-emit-instr-limit`; normal builds route emitted
;; functions through a scratch arena so transient assembly strings stay within
;; the self-build memory budget.
(define (compiler-backend-emit-function-escaping
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [func : CompilerIrFunction]
  [all-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [global-types : CompilerBackendGlobalTypeList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]) : ResultCompilerBackend
  (let
    [result : ResultCompilerBackend
      (if (compiler-backend-emit-function-direct? func)
        (compiler-backend-emit-function
          type-segment-bases
          target
          mode
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          true
          true)
        (compiler-backend-emit-function-scratch
          type-segment-bases
          target
          mode
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch))]
    (begin
      (compiler-backend-clear-function-emit-state!)
      result)))

(define (compiler-backend-implicit-main-function) : CompilerIrFunction
  (CompilerIrFunction.Function
    cbi.compiler-builtin-id-fix-main
    CompilerIrParamList.Nil
    (AstType.I64)
    1
    (compiler-ir-block-list-compact
      (compiler-ir-block-cons
        (compiler-ir-block
          (compiler-ir-label "entry")
          (compiler-ir-instr-cons
            (CompilerIrInstr.Return
              (CompilerIrMaybeValue.Some (CompilerIrValue.I64 0)))
            CompilerIrInstrList.Nil))
        CompilerIrBlockList.Nil))))

(define (compiler-backend-functions-with-implicit-main
  [functions : CompilerIrFunctionList]
  [emit-entry : bool]) : CompilerIrFunctionList
  (if (and
    emit-entry
    (not
      (compiler-backend-function-list-defines?
        functions
        cbi.compiler-builtin-id-fix-main)))
    (compiler-ir-function-cons
      (compiler-backend-implicit-main-function)
      functions)
    functions))

(define (compiler-backend-emit-functions-buffer-raw-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [functions : CompilerIrFunctionList]
  [all-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [global-types : CompilerBackendGlobalTypeList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (match functions
    [(CompilerIrFunctionList.Nil) (ResultCompilerBackendBuffer.Ok buf)]
    [(CompilerIrFunctionList.Cons func rest)
      (begin
        (cfg
          compile-profile
          (compiler-backend-profile-detail-start
            (struct-get program-index profile-state)))
        (match (compiler-backend-emit-function-escaping
          type-segment-bases
          target
          (compiler-backend-effective-function-mode mode func)
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch)
          [(ResultCompilerBackend.Ok head)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  (struct-get program-index profile-state)
                  "function"
                  (compiler-backend-profile-function-name func)))
              (compiler-backend-emit-functions-buffer-raw-into
                type-segment-bases
                target
                mode
                (box-get rest)
                all-functions
                globals
                global-types
                externs
                plan
                program-index
                spans
                span-index
                emit-entry
                crt-entry
                scratch
                (text_buf.append buf (compiler-backend-emergency-wrap head))))]
          [(ResultCompilerBackend.Err message)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  (struct-get program-index profile-state)
                  "function"
                  (compiler-backend-profile-function-name func)))
              (ResultCompilerBackendBuffer.Err message))]))]
    [(CompilerIrFunctionList.Array seq)
      (compiler-backend-emit-function-seq-buffer-into
        type-segment-bases
        target
        mode
        seq
        0
        all-functions
        globals
        global-types
        externs
        plan
        program-index
        spans
        span-index
        emit-entry
        crt-entry
        scratch
        buf)]))

(define (compiler-backend-emit-function-seq-buffer-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [functions : CompilerIrFunctionSeq]
  [index : i64]
  [all-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [global-types : CompilerBackendGlobalTypeList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (if (>= index (compiler-ir-function-seq-count functions))
    (ResultCompilerBackendBuffer.Ok buf)
    (let
      [func : CompilerIrFunction (compiler-ir-function-seq-ref functions index)]
      (begin
        (cfg
          compile-profile
          (compiler-backend-profile-detail-start
            (struct-get program-index profile-state)))
        (match (compiler-backend-emit-function-escaping
          type-segment-bases
          target
          (compiler-backend-effective-function-mode mode func)
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch)
          [(ResultCompilerBackend.Ok head)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  (struct-get program-index profile-state)
                  "function"
                  (compiler-backend-profile-function-name func)))
              (compiler-backend-emit-function-seq-buffer-into
                type-segment-bases
                target
                mode
                functions
                (+ index 1)
                all-functions
                globals
                global-types
                externs
                plan
                program-index
                spans
                span-index
                emit-entry
                crt-entry
                scratch
                (text_buf.append buf (compiler-backend-emergency-wrap head))))]
          [(ResultCompilerBackend.Err message)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  (struct-get program-index profile-state)
                  "function"
                  (compiler-backend-profile-function-name func)))
              (ResultCompilerBackendBuffer.Err message))])))))

;; Final-buffer streaming emits each function into a rewindable raw arena, then
;; immediately moves its optimized bytes into the home-owned output stream.
(define (compiler-backend-emit-functions-stream-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [functions : CompilerIrFunctionList]
  [all-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [global-types : CompilerBackendGlobalTypeList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (match functions
    [(CompilerIrFunctionList.Nil) (ResultCompilerBackendBuffer.Ok buf)]
    [(CompilerIrFunctionList.Cons func rest)
      (let
        [caller-arena : arena.Arena (arena.current)]
        (begin
          (compiler-backend-assembly-stream-begin-raw!)
          (cfg
            compile-profile
            (compiler-backend-profile-detail-start
              (struct-get program-index profile-state)))
          (match (compiler-backend-emit-function-escaping
            type-segment-bases
            target
            (compiler-backend-effective-function-mode mode func)
            func
            all-functions
            globals
            global-types
            externs
            plan
            program-index
            spans
            span-index
            emit-entry
            crt-entry
            scratch)
            [(ResultCompilerBackend.Ok head)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-detail-finish
                    (struct-get program-index profile-state)
                    "function"
                    (compiler-backend-profile-function-name func)))
                (compiler-backend-assembly-stream-process-string!
                  (compiler-backend-emergency-wrap head))
                (compiler-backend-assembly-stream-rewind-raw!)
                (unsafe
                  (arena.set! caller-arena))
                (compiler-backend-emit-functions-stream-into
                  type-segment-bases
                  target
                  mode
                  (box-get rest)
                  all-functions
                  globals
                  global-types
                  externs
                  plan
                  program-index
                  spans
                  span-index
                  emit-entry
                  crt-entry
                  scratch
                  buf))]
            [(ResultCompilerBackend.Err message)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-detail-finish
                    (struct-get program-index profile-state)
                    "function"
                    (compiler-backend-profile-function-name func)))
                (unsafe
                  (arena.set! caller-arena))
                (ResultCompilerBackendBuffer.Err message))])))]
    [(CompilerIrFunctionList.Array seq)
      (compiler-backend-emit-function-seq-stream-into
        type-segment-bases
        target
        mode
        seq
        0
        all-functions
        globals
        global-types
        externs
        plan
        program-index
        spans
        span-index
        emit-entry
        crt-entry
        scratch
        buf)]))

(define (compiler-backend-emit-function-seq-stream-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [functions : CompilerIrFunctionSeq]
  [index : i64]
  [all-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [global-types : CompilerBackendGlobalTypeList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (if (>= index (compiler-ir-function-seq-count functions))
    (ResultCompilerBackendBuffer.Ok buf)
    (let
      [func : CompilerIrFunction (compiler-ir-function-seq-ref functions index)]
      [caller-arena : arena.Arena (arena.current)]
      (begin
        (compiler-backend-assembly-stream-begin-raw!)
        (cfg
          compile-profile
          (compiler-backend-profile-detail-start
            (struct-get program-index profile-state)))
        (match (compiler-backend-emit-function-escaping
          type-segment-bases
          target
          (compiler-backend-effective-function-mode mode func)
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch)
          [(ResultCompilerBackend.Ok head)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  (struct-get program-index profile-state)
                  "function"
                  (compiler-backend-profile-function-name func)))
              (compiler-backend-assembly-stream-process-string!
                (compiler-backend-emergency-wrap head))
              (compiler-backend-assembly-stream-rewind-raw!)
              (unsafe
                (arena.set! caller-arena))
              (compiler-backend-emit-function-seq-stream-into
                type-segment-bases
                target
                mode
                functions
                (+ index 1)
                all-functions
                globals
                global-types
                externs
                plan
                program-index
                spans
                span-index
                emit-entry
                crt-entry
                scratch
                buf))]
          [(ResultCompilerBackend.Err message)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  (struct-get program-index profile-state)
                  "function"
                  (compiler-backend-profile-function-name func)))
              (unsafe
                (arena.set! caller-arena))
              (ResultCompilerBackendBuffer.Err message))])))))

(define (compiler-backend-emit-functions-buffer-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [functions : CompilerIrFunctionList]
  [all-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [global-types : CompilerBackendGlobalTypeList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (let
    [scratch : i64 (arena.tl_arena_make)]
    [result : ResultCompilerBackendBuffer
      (if (compiler-backend-assembly-stream-active?)
        (compiler-backend-emit-functions-stream-into
          type-segment-bases
          target
          mode
          functions
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch
          buf)
        (compiler-backend-emit-functions-buffer-raw-into
          type-segment-bases
          target
          mode
          functions
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch
          buf))]
    (begin
      (unsafe
        (arena.tl_arena_destroy scratch))
      result)))

(define (compiler-backend-emit-closure-descriptor-entry [name : String]) : String
  (str_cat.str-cat
    (compiler-backend-closure-descriptor-label name)
    ":\n    .quad "
    (compiler-backend-closure-entry-label name)
    "\n    .quad 0\n"
    ""))

(define (compiler-backend-emit-closure-descriptor-entry-into
  [name : i64]
  [_functions : CompilerIrFunctionList]
  [_externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match (compiler-backend-index-signature program-index name)
    [(CompilerBackendMaybeSignature.Some _ _)
      (text_buf.append
        buf
        (compiler-backend-emit-closure-descriptor-entry
          (compiler-ir-symbol-text name)))]
    [(CompilerBackendMaybeSignature.No) buf]))

(define (compiler-backend-emit-closure-descriptor-entries-into
  [names : BackendSymbolSeq]
  [index : i64]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (>= index (struct-get names len))
    buf
    (compiler-backend-emit-closure-descriptor-entries-into
      names
      (+ index 1)
      functions
      externs
      program-index
      (compiler-backend-emit-closure-descriptor-entry-into
        (array-ref (struct-get names slots) index)
        functions
        externs
        program-index
        buf))))

(define (compiler-backend-emit-closure-descriptors-into
  [names : BackendSymbolSeq]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (= (struct-get names len) 0)
    buf
    (compiler-backend-emit-closure-descriptor-entries-into
      names
      0
      functions
      externs
      program-index
      (text_buf.append buf "    .section .rodata\n    .balign 8\n"))))

(define (compiler-backend-closure-adapter-outgoing-frame-space
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [args : CompilerIrCallArgs]
  [param-types : AstTypeList]
  [program-index : CompilerBackendProgramIndex]) : i64
  (match target
    ;; The adapter's forwarded call does not dip on Linux -> reserve
    ;; its actual outgoing space in the adapter frame.
    [(CompilerBackendTarget.Linux)
      (compiler-backend-round-up-16
        (+
          (compiler-backend-outgoing-shadow-space target)
          (compiler-backend-linux-stack-arg-space
            type-segment-bases
            target
            args
            param-types
            program-index)))]
    [(CompilerBackendTarget.Windows)
      ;; No callee signature here -- size conservatively at two positions
      ;; per forwarded argument so a register-group never overruns the area.
      (compiler-backend-round-up-16
        (+
          (compiler-backend-outgoing-shadow-space target)
          (compiler-backend-windows-words-stack-space
            (* 2 (compiler-backend-call-args-count args)))))]))

(define (compiler-backend-emit-closure-entry-adapter
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [name : i64]
  [param-types : AstTypeList]
  [_ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [_functions : CompilerIrFunctionList]
  [_externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (let
    [params : CompilerIrParamList
      (compiler-backend-param-list-from-types type-segment-bases param-types 0)]
    [vars : i64 (compiler-backend-type-list-count param-types)]
    [args : CompilerIrCallArgs
      (compiler-ir-call-args-from-list
        (compiler-backend-var-value-list
          (compiler-backend-type-list-count param-types)
          0))]
    [extern-call-info : i64
      (compiler-backend-index-extern-call-info program-index name)]
    [frame : i64
      (+
        (compiler-backend-frame-size
          ;; Group params spill word1 at -(8*(vars+var+1))(%rbp); the
          ;; frame must cover those slots (no red zone on Windows -- the
          ;; outgoing stack-arg area would clobber them otherwise).
          (compiler-backend-frame-slots-with-groups
            vars
            CompilerRegAssignmentList.Nil
            (compiler-backend-type-list-has-group?
              type-segment-bases
              param-types
              program-index)))
        (compiler-backend-closure-adapter-outgoing-frame-space
          type-segment-bases
          target
          args
          param-types
          program-index))]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        false
        program-index)]
    [diag : CompilerDiagnostic (compiler-diagnostic-at-start "" "")]
    (match (compiler-backend-emit-param-spills
      type-segment-bases
      target
      CompilerRegAssignmentList.Nil
      params
      1
      0
      1
      0
      program-index
      vars)
      [(ResultCompilerBackend.Ok spills)
        (match (compiler-backend-emit-call-args
          type-segment-bases
          target
          CompilerRegAssignmentList.Nil
          args
          param-types
          false
          0
          0
          0
          0
          0
          ""
          diag
          program-index
          vars)
          [(ResultCompilerBackend.Ok args-asm)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (compiler-backend-emit-function-entry
                  target
                  (compiler-backend-closure-entry-label
                    (compiler-ir-symbol-text name))
                  frame
                  CompilerRegAssignmentList.Nil
                  vars)
                ""
                ""
                ;; M-G3 stage 1: adapters go through the same rsp rebase as
                ;; user functions (their `movq %rbp,%rsp` epilogue ends rsp
                ;; validity; no frame refs follow it). Stage 2: adapters keep
                ;; the rbp prologue (fpo=false) -- their raw epilogue resets
                ;; rsp from rbp and they never home values in %rbp.
                (compiler-backend-rsp-rebase
                  (string.append
                    spills
                    (string.append
                      (compiler-backend-emit-call-space-sub call-space)
                      (string.append
                        args-asm
                        (string.append
                          (compiler-backend-varargs-pre-call
                            type-segment-bases
                            target
                            extern-call-info
                            param-types)
                          (str_cat.str-cat
                            "    call "
                            (compiler-backend-call-symbol-index
                              name
                              plan
                              program-index)
                            "\n"
                            (string.append
                              (compiler-backend-emit-call-space-add call-space)
                              (string.append
                                (str_cat.str-cat
                                  "    movq %rbp, %rsp\n    popq %rbp\n    ret\n"
                                  (if (and
                                    (compiler-debug-info-enabled?)
                                    (compiler-backend-target-linux? target))
                                    "    .cfi_endproc\n"
                                    "")
                                  "")
                                (string.append
                                  (compiler-backend-emit-windows-seh-endproc
                                    target)
                                  "\n")))
                            "")))))
                  frame
                  false)
                ""))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

(define (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [names : BackendSymbolSeq]
  [index : i64]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (if (>= index (struct-get names len))
    (ResultCompilerBackendBuffer.Ok buf)
    (let
      [name : i64 (array-ref (struct-get names slots) index)]
      (match (compiler-backend-index-signature program-index name)
        [(CompilerBackendMaybeSignature.Some param-types ret-ty)
          (match (compiler-backend-emit-closure-entry-adapter
            type-segment-bases
            target
            name
            param-types
            ret-ty
            plan
            functions
            externs
            program-index)
            [(ResultCompilerBackend.Ok head)
              (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
                type-segment-bases
                target
                names
                (+ index 1)
                functions
                externs
                plan
                program-index
                (text_buf.append buf (compiler-backend-emergency-wrap head)))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackendBuffer.Err message)])]
        [(CompilerBackendMaybeSignature.No)
          (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
            type-segment-bases
            target
            names
            (+ index 1)
            functions
            externs
            plan
            program-index
            buf)]))))

(define (compiler-backend-emit-closure-entry-adapters-stream-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [names : BackendSymbolSeq]
  [index : i64]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (if (>= index (struct-get names len))
    (ResultCompilerBackendBuffer.Ok buf)
    (let
      [name : i64 (array-ref (struct-get names slots) index)]
      (match (compiler-backend-index-signature program-index name)
        [(CompilerBackendMaybeSignature.Some param-types ret-ty)
          (let
            [caller-arena : arena.Arena (arena.current)]
            (begin
              (compiler-backend-assembly-stream-begin-raw!)
              (match (compiler-backend-emit-closure-entry-adapter
                type-segment-bases
                target
                name
                param-types
                ret-ty
                plan
                functions
                externs
                program-index)
                [(ResultCompilerBackend.Ok head)
                  (begin
                    (compiler-backend-assembly-stream-process-string!
                      (compiler-backend-emergency-wrap head))
                    (compiler-backend-assembly-stream-rewind-raw!)
                    (unsafe
                      (arena.set! caller-arena))
                    (compiler-backend-emit-closure-entry-adapters-stream-into
                      type-segment-bases
                      target
                      names
                      (+ index 1)
                      functions
                      externs
                      plan
                      program-index
                      buf))]
                [(ResultCompilerBackend.Err message)
                  (begin
                    (unsafe
                      (arena.set! caller-arena))
                    (ResultCompilerBackendBuffer.Err message))])))]
        [(CompilerBackendMaybeSignature.No)
          (compiler-backend-emit-closure-entry-adapters-stream-into
            type-segment-bases
            target
            names
            (+ index 1)
            functions
            externs
            plan
            program-index
            buf)]))))

(define (compiler-backend-emit-closure-entry-adapters-buffer-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [names : BackendSymbolSeq]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (if (compiler-backend-assembly-stream-active?)
    (compiler-backend-emit-closure-entry-adapters-stream-into
      type-segment-bases
      target
      names
      0
      functions
      externs
      plan
      program-index
      buf)
    (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
      type-segment-bases
      target
      names
      0
      functions
      externs
      plan
      program-index
      buf)))

(define (compiler-backend-float-list-reverse-into
  [floats : BackendFloatList]
  [out : BackendFloatList]) : BackendFloatList
  (match floats
    [(BackendFloatList.Nil) out]
    [(BackendFloatList.Cons ty bits rest)
      (compiler-backend-float-list-reverse-into
        (box-get rest)
        (compiler-backend-float-cons ty bits out))]))

(define (compiler-backend-float-list-reverse [floats : BackendFloatList]) : BackendFloatList
  (compiler-backend-float-list-reverse-into floats BackendFloatList.Nil))

(define (compiler-backend-string-set-list [set : BackendStringSet]) : BackendStringSeq
  (struct-get set items))

(define (compiler-backend-symbol-set-list [set : BackendSymbolSet]) : BackendSymbolSeq
  (struct-get set items))

(define (compiler-backend-float-set-list [set : BackendFloatSet]) : BackendFloatList
  (compiler-backend-float-list-reverse (struct-get set items)))

(define (compiler-backend-program-collections-functions
  [collections : CompilerBackendProgramCollections]) : BackendSymbolSeq
  (compiler-backend-symbol-set-list (struct-get collections functions)))

(define (compiler-backend-program-collections-strings
  [collections : CompilerBackendProgramCollections]) : BackendStringSeq
  (compiler-backend-string-set-list (struct-get collections strings)))

(define (compiler-backend-program-collections-floats
  [collections : CompilerBackendProgramCollections]) : BackendFloatList
  (compiler-backend-float-set-list (struct-get collections floats)))

(define (compiler-backend-program-collections-bytes
  [collections : CompilerBackendProgramCollections]) : BackendStringSeq
  (compiler-backend-string-set-list (struct-get collections bytes)))

(define (compiler-backend-program-collections-uses-avx2-i64-lane-id?
  [collections : CompilerBackendProgramCollections]) : bool
  (struct-get collections uses-avx2-i64-lane-id))

(define (compiler-backend-program-collections-uses-avx512-i64-lane-id?
  [collections : CompilerBackendProgramCollections]) : bool
  (struct-get collections uses-avx512-i64-lane-id))

(define (compiler-backend-program-collections-uses-f64-neg?
  [collections : CompilerBackendProgramCollections]) : bool
  (struct-get collections uses-f64-neg))

(define (compiler-backend-collect-float-both-collections
  [collections : CompilerBackendProgramCollections]
  [bits : u64]) : CompilerBackendProgramCollections
  (compiler-backend-program-collections-add-float
    (compiler-backend-program-collections-add-float
      collections
      (AstType.F64)
      bits)
    (AstType.F32)
    bits))

(define (compiler-backend-collect-lane-id-collections
  [collections : CompilerBackendProgramCollections]
  [lanes : i64]
  [elem-ty : AstType]) : CompilerBackendProgramCollections
  (if (compiler-backend-lane-id-avx512-i64-shape-ok? elem-ty lanes)
    (compiler-backend-program-collections-mark-avx512-i64-lane-id collections)
    (if (compiler-backend-lane-id-avx2-i64-shape-ok? elem-ty lanes)
      (compiler-backend-program-collections-mark-avx2-i64-lane-id collections)
      collections)))

(define (compiler-backend-collect-lane-offset-gather-collections
  [collections : CompilerBackendProgramCollections]
  [lanes : i64]
  [elem-ty : AstType]) : CompilerBackendProgramCollections
  (cond
    [(and (compiler-backend-gather-dword-element? elem-ty) (= lanes 8))
      (compiler-backend-program-collections-mark-avx2-i64-lane-id collections)]
    [(and (compiler-backend-gather-dword-element? elem-ty) (= lanes 16))
      (compiler-backend-program-collections-mark-avx512-i64-lane-id collections)]
    [(and (not (compiler-backend-gather-dword-element? elem-ty)) (= lanes 4))
      (compiler-backend-program-collections-mark-avx2-i64-lane-id collections)]
    [(and (not (compiler-backend-gather-dword-element? elem-ty)) (= lanes 8))
      (compiler-backend-program-collections-mark-avx512-i64-lane-id collections)]
    [else collections]))

(define (compiler-backend-collect-value-collections
  [collections : CompilerBackendProgramCollections]
  [value : CompilerIrValue]) : CompilerBackendProgramCollections
  (match value
    [(CompilerIrValue.Function name)
      (compiler-backend-program-collections-add-function collections name)]
    [(CompilerIrValue.String text)
      (compiler-backend-program-collections-add-string collections text)]
    [(CompilerIrValue.F64 bits)
      (compiler-backend-collect-float-both-collections collections bits)]
    [(CompilerIrValue.Bytes text)
      (compiler-backend-program-collections-add-bytes collections text)]
    [_ collections]))

(define (compiler-backend-collect-maybe-value-collections
  [collections : CompilerBackendProgramCollections]
  [value : CompilerIrMaybeValue]) : CompilerBackendProgramCollections
  (match value
    [(CompilerIrMaybeValue.No) collections]
    [(CompilerIrMaybeValue.Some inner)
      (compiler-backend-collect-value-collections collections inner)]))

(define (compiler-backend-collect-value-list-collections
  [collections : CompilerBackendProgramCollections]
  [values : CompilerIrValueList]) : CompilerBackendProgramCollections
  (match values
    [(CompilerIrValueList.Nil) collections]
    [(CompilerIrValueList.Array seq)
      (compiler-backend-collect-value-list-collections
        collections
        (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (compiler-backend-collect-value-list-collections
        (compiler-backend-collect-value-collections collections value)
        (box-get rest))]))

(define (compiler-backend-collect-call-args-array-collections
  [collections : CompilerBackendProgramCollections]
  [values : (Array CompilerIrValue)]
  [index : i64]) : CompilerBackendProgramCollections
  (if (>= index (array-length values))
    collections
    (compiler-backend-collect-call-args-array-collections
      (compiler-backend-collect-value-collections
        collections
        (array-ref values index))
      values
      (+ index 1))))

(define (compiler-backend-collect-call-args-collections
  [collections : CompilerBackendProgramCollections]
  [args : CompilerIrCallArgs]) : CompilerBackendProgramCollections
  (match args
    [(CompilerIrCallArgs.Nil) collections]
    [(CompilerIrCallArgs.One value)
      (compiler-backend-collect-value-collections collections value)]
    [(CompilerIrCallArgs.Two a b)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections a)
        b)]
    [(CompilerIrCallArgs.Array values)
      (compiler-backend-collect-call-args-array-collections
        collections
        values
        0)]))

(define (compiler-backend-collect-spmd-call-args-collections
  [collections : CompilerBackendProgramCollections]
  [args : CompilerIrSpmdCallArgList]) : CompilerBackendProgramCollections
  (match args
    [(CompilerIrSpmdCallArgList.Nil) collections]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (compiler-backend-collect-spmd-call-args-collections
            (compiler-backend-collect-value-collections collections value)
            (box-get rest))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : CompilerBackendProgramCollections collections]
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(CompilerIrSpmdCallArg.Arg _ value _)
                  (set!
                    out
                    (compiler-backend-collect-value-collections out value))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-backend-collect-phi-collections
  [collections : CompilerBackendProgramCollections]
  [inputs : CompilerIrPhiInputList]) : CompilerBackendProgramCollections
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) collections]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-backend-collect-phi-collections
        collections
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (compiler-backend-collect-phi-collections
        (compiler-backend-collect-value-collections collections value)
        (box-get rest))]))

(define (compiler-backend-collect-instr-collections
  [collections : CompilerBackendProgramCollections]
  [instr : CompilerIrInstr]) : CompilerBackendProgramCollections
  (match instr
    [(CompilerIrInstr.Mov _ src _)
      (compiler-backend-collect-value-collections collections src)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections lhs)
        rhs)]
    [(CompilerIrInstr.UnOp _ op src ty)
      (let
        [with-src : CompilerBackendProgramCollections
          (compiler-backend-collect-value-collections collections src)]
        (match op
          [(CompilerIrUnOp.Neg)
            (if (compiler-backend-f64-type? ty)
              (compiler-backend-program-collections-mark-f64-neg with-src)
              with-src)]
          [_ with-src]))]
    [(CompilerIrInstr.Call _ _ args _)
      (compiler-backend-collect-call-args-collections collections args)]
    [(CompilerIrInstr.CallIndirect _ func args _)
      (compiler-backend-collect-call-args-collections
        (compiler-backend-collect-value-collections collections func)
        args)]
    [(CompilerIrInstr.CallIndirectC _ func args _)
      (compiler-backend-collect-call-args-collections
        (compiler-backend-collect-value-collections collections func)
        args)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base _ args _)
          (compiler-backend-collect-call-args-collections
            (compiler-backend-collect-value-collections collections base)
            args)])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            func
            args
            _)
          (compiler-backend-collect-call-args-collections
            (compiler-backend-collect-value-collections
              (compiler-backend-collect-value-collections collections base)
              func)
            args)])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ active-mask args _)
          (compiler-backend-collect-spmd-call-args-collections
            (compiler-backend-collect-value-collections collections active-mask)
            args)])]
    [(CompilerIrInstr.TailCall _ args _)
      (compiler-backend-collect-call-args-collections collections args)]
    [(CompilerIrInstr.Store _ value _)
      (compiler-backend-collect-value-collections collections value)]
    [(CompilerIrInstr.Branch cond _ _)
      (compiler-backend-collect-value-collections collections cond)]
    [(CompilerIrInstr.Return maybe)
      (compiler-backend-collect-maybe-value-collections collections maybe)]
    [(CompilerIrInstr.Phi _ inputs _)
      (compiler-backend-collect-phi-collections collections inputs)]
    [(CompilerIrInstr.Gep _ base offset _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections base)
        offset)]
    [(CompilerIrInstr.Load _ src _)
      (compiler-backend-collect-value-collections collections src)]
    [(CompilerIrInstr.StorePtr dst src _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections dst)
        src)]
    [(CompilerIrInstr.CopyBytes dst src _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections dst)
        src)]
    [(CompilerIrInstr.BoundsCheck index length _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections index)
        length)]
    [(CompilerIrInstr.Cast _ src _ _)
      (compiler-backend-collect-value-collections collections src)]
    [(CompilerIrInstr.Bitcast _ src _ _)
      (compiler-backend-collect-value-collections collections src)]
    [(CompilerIrInstr.Splat _ value _ _)
      (compiler-backend-collect-value-collections collections value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections collections lhs)
            rhs)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections collections src)
            carry)])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (compiler-backend-collect-value-collections collections src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections collections lhs)
            rhs)])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections lhs)
        rhs)]
    [(CompilerIrInstr.MaskNot _ src _)
      (compiler-backend-collect-value-collections collections src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (compiler-backend-collect-value-collections collections src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections
              (compiler-backend-collect-value-collections collections mask)
              on-true)
            on-false)])]
    [(CompilerIrInstr.VectorLoad _ base index _ _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections base)
        index)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value _ _)
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections
              (compiler-backend-collect-value-collections collections base)
              index)
            value)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            _
            _)
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections
              (compiler-backend-collect-value-collections
                (compiler-backend-collect-value-collections collections base)
                index)
              value)
            mask)])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base index mask _ _)
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections
              (compiler-backend-collect-value-collections collections base)
              index)
            mask)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            _
            base
            index-base
            index
            lane-offset
            lanes
            elem-ty)
          (let
            [values : CompilerBackendProgramCollections
              (compiler-backend-collect-value-collections
                (compiler-backend-collect-value-collections
                  (compiler-backend-collect-value-collections collections base)
                  index-base)
                index)]
            (if lane-offset
              (compiler-backend-collect-lane-offset-gather-collections
                values
                lanes
                elem-ty)
              values))])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            _)
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-maybe-value-collections
              (compiler-backend-collect-value-collections
                (compiler-backend-collect-value-collections collections source)
                selector-low)
              selector-high)
            active-lanes)])]
    [(CompilerIrInstr.TailMask _ index length lanes)
      (let
        [values : CompilerBackendProgramCollections
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections collections index)
            length)]
        (if (= lanes 4)
          (compiler-backend-program-collections-mark-avx2-i64-lane-id values)
          values))]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections leaf)
        subleaf)]
    [(CompilerIrInstr.Xgetbv _ index)
      (compiler-backend-collect-value-collections collections index)]
    [(CompilerIrInstr.Syscall _ args)
      (compiler-backend-collect-call-args-collections collections args)]
    [(CompilerIrInstr.Pack _ words _)
      (compiler-backend-collect-value-list-collections collections words)]
    [(CompilerIrInstr.Word _ src _ _)
      (compiler-backend-collect-value-collections collections src)]
    [(CompilerIrInstr.TailCallIndirect func args _)
      (compiler-backend-collect-call-args-collections
        (compiler-backend-collect-value-collections collections func)
        args)]
    [(CompilerIrInstr.Alloc _ _) collections]
    [(CompilerIrInstr.AddrOf _ _) collections]
    [(CompilerIrInstr.LaneId _ lanes elem-ty)
      (compiler-backend-collect-lane-id-collections collections lanes elem-ty)]
    [(CompilerIrInstr.EntryArgc _) collections]
    [(CompilerIrInstr.EntryArgv _) collections]
    [(CompilerIrInstr.EntryEnvp _) collections]
    [(CompilerIrInstr.Jump _) collections]
    [(CompilerIrInstr.Switch index _ _ _)
      (compiler-backend-collect-value-collections collections index)]))

(define (compiler-backend-collect-instr-seq-collections
  [collections : CompilerBackendProgramCollections]
  [instrs : CompilerIrInstrSeq]) : CompilerBackendProgramCollections
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    [out : CompilerBackendProgramCollections collections]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (compiler-backend-collect-instr-collections
              out
              (array-ref slots index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-backend-collect-function-collections
  [type-segment-bases : i64]
  [collections : CompilerBackendProgramCollections]
  [functions : CompilerIrFunctionList]) : CompilerBackendProgramCollections
  (match (compiler-backend-collect-functions-shared
    type-segment-bases
    (CompilerBackendCollectState.Collections collections)
    functions)
    [(CompilerBackendCollectState.Collections out) out]
    [_ collections]))

(define (compiler-backend-collect-global-collections
  [collections : CompilerBackendProgramCollections]
  [globals : CompilerIrGlobalList]) : CompilerBackendProgramCollections
  (match globals
    [(CompilerIrGlobalList.Nil) collections]
    [(CompilerIrGlobalList.Cons global rest)
      (match global
        [(CompilerIrGlobal.Global _ _ value)
          (compiler-backend-collect-global-collections
            (compiler-backend-collect-value-collections collections value)
            (box-get rest))])]
    [(CompilerIrGlobalList.Array seq)
      (compiler-backend-collect-global-collections
        collections
        (compiler-ir-global-seq-to-list seq))]))

(define (compiler-backend-collect-program-collections
  [type-segment-bases : i64]
  [program : CompilerIrProgram]) : CompilerBackendProgramCollections
  (match program
    [(CompilerIrProgram.Program globals functions _)
      (compiler-backend-collect-function-collections
        type-segment-bases
        (compiler-backend-collect-global-collections
          (compiler-backend-program-collections-new)
          globals)
        functions)]))

(define (compiler-backend-collect-source-path-strings
  [collections : CompilerBackendProgramCollections]
  [spans : CompilerSourceSpans]) : CompilerBackendProgramCollections
  (match spans
    [(CompilerSourceSpans.Spans _ instr-entries _)
      (let
        [slots : (Array CompilerSourceSpansInstrEntry)
          (struct-get instr-entries slots)]
        [count : i64 (struct-get instr-entries len)]
        [index : i64 0]
        [out : CompilerBackendProgramCollections collections]
        (begin
          (while (< index count)
            (begin
              (match (array-ref slots index)
                [(CompilerSourceSpansInstrEntry.Entry _ path-id _)
                  (when
                    (> path-id 0)
                    (set!
                      out
                      (compiler-backend-program-collections-add-string
                        out
                        (ci.intern-str path-id))))])
              (set! index (+ index 1))))
          out))]))

(define (compiler-backend-emit-string-entry-into
  [text : String]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (let
    [suffix : String (compiler-backend-string-label-suffix text)]
    [data-label : String (string.append ".L_tl_str_data_" suffix)]
    [fat-label : String (string.append ".L_tl_str_" suffix)]
    [escaped : String (compiler-backend-escape-string text)]
    [len-text : String (string.int->string (string.string-length text))]
    (text_buf.append
      (text_buf.append
        (text_buf.append
          (text_buf.append
            (text_buf.append
              (text_buf.append
                (text_buf.append
                  (text_buf.append
                    (text_buf.append
                      (text_buf.append
                        (text_buf.append buf data-label)
                        ":\n    .string \"")
                      escaped)
                    "\"\n    .balign 8\n")
                  fat-label)
                ":\n    .quad ")
              data-label)
            "\n    .quad ")
          len-text)
        "\n")
      "")))

(define (compiler-backend-emit-string-entries-into
  [strings : BackendStringSeq]
  [index : i64]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (>= index (struct-get strings len))
    buf
    (compiler-backend-emit-string-entries-into
      strings
      (+ index 1)
      (compiler-backend-emit-string-entry-into
        (array-ref (struct-get strings slots) index)
        buf))))

(define (compiler-backend-emit-string-rodata-into
  [strings : BackendStringSeq]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (= (struct-get strings len) 0)
    buf
    (text_buf.append
      (compiler-backend-emit-string-entries-into
        strings
        0
        (text_buf.append buf "    .section .rodata\n"))
      "\n")))

(define (compiler-backend-emit-byte-directives-into
  [bytes : String]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (let
    [i : i64 0]
    [n : i64 (string.string-length bytes)]
    [col : i64 0]
    [out : text_buf.TextBuf buf]
    (begin
      (if (= n 0)
        (set! out (text_buf.append out "    .byte 0\n"))
        (while (< i n)
          (begin
            (if (= col 0)
              (set! out (text_buf.append out "    .byte "))
              (set! out (text_buf.append out ",")))
            (set!
              out
              (text_buf.append
                out
                (string.int->string
                  (compiler-backend-char-code (string.string-ref bytes i)))))
            (set! i (+ i 1))
            (set! col (+ col 1))
            (if (or (= col 16) (= i n))
              (begin
                (set! out (text_buf.append out "\n"))
                (set! col 0))
              unit))))
      out)))

(define (compiler-backend-emit-bytes-entry-into
  [bytes : String]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (let
    [data-label : String (compiler-backend-bytes-data-label bytes)]
    [fat-label : String (compiler-backend-bytes-fat-label bytes)]
    [len-text : String (string.int->string (string.string-length bytes))]
    [data-buf : text_buf.TextBuf
      (compiler-backend-emit-byte-directives-into
        bytes
        (text_buf.append
          (text_buf.append buf "    .balign 8\n")
          (str_cat.str-cat data-label ":\n" "")))]
    (text_buf.append
      (text_buf.append
        (text_buf.append
          (text_buf.append
            (text_buf.append
              (text_buf.append data-buf "    .balign 8\n")
              fat-label)
            ":\n    .quad ")
          data-label)
        "\n    .quad ")
      (string.append len-text "\n"))))

(define (compiler-backend-emit-bytes-entries-into
  [items : BackendStringSeq]
  [index : i64]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (>= index (struct-get items len))
    buf
    (compiler-backend-emit-bytes-entries-into
      items
      (+ index 1)
      (compiler-backend-emit-bytes-entry-into
        (array-ref (struct-get items slots) index)
        buf))))

(define (compiler-backend-emit-bytes-data-into
  [items : BackendStringSeq]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (= (struct-get items len) 0)
    buf
    (text_buf.append
      (compiler-backend-emit-bytes-entries-into
        items
        0
        (text_buf.append buf "    .data\n"))
      "\n")))

(define (compiler-backend-float-bits-directive [ty : AstType] [bits : u64]) : String
  (if (compiler-backend-f64-type? ty)
    (str_cat.str-cat "    .quad " (string.int->string (cast bits : i64)) "\n")
    (str_cat.str-cat
      "    .long "
      (string.int->string
        (cast (compiler-backend-float-payload-bits ty bits) : i64))
      "\n")))

(define (compiler-backend-float-object-data [ty : AstType] [bits : u64]) : cobj.CompilerObjectDataRecord
  (if (compiler-backend-f64-type? ty)
    (cobj.CompilerObjectDataRecord.F64 bits)
    (cobj.CompilerObjectDataRecord.F32
      (compiler-backend-float-payload-bits ty bits))))

(define (compiler-backend-emit-float-entry [ty : AstType] [bits : u64]) : String
  (str_cat.str-cat
    (if (compiler-backend-f64-type? ty)
      "    .balign 8\n"
      "    .balign 4\n")
    (compiler-backend-float-label ty bits)
    ":\n"
    (compiler-backend-float-bits-directive ty bits)))

(define (compiler-backend-emit-float-entries-into
  [floats : BackendFloatList]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match floats
    [(BackendFloatList.Nil) buf]
    [(BackendFloatList.Cons ty bits rest)
      (compiler-backend-emit-float-entries-into
        (box-get rest)
        (text_buf.append buf (compiler-backend-emit-float-entry ty bits)))]))

(define (compiler-backend-emit-float-rodata-into
  [floats : BackendFloatList]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match floats
    [(BackendFloatList.Nil) buf]
    [_
      (compiler-backend-emit-float-entries-into
        floats
        (text_buf.append buf "    .section .rodata\n"))]))

(define (compiler-backend-emit-f64-sign-bit-rodata-into
  [enabled : bool]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if enabled
    (text_buf.append
      (text_buf.append
        (text_buf.append buf "    .section .rodata\n    .balign 16\n")
        (compiler-backend-f64-sign-bit-label))
      ":\n    .quad 0x8000000000000000\n    .quad 0\n")
    buf))

(define (compiler-backend-global-value-asm
  [type-segment-bases : i64]
  [ty : AstType]
  [value : CompilerIrValue]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (match value
    ;; A register-group global stores its value inline (16 bytes), so its
    ;; startup-initialized slot reserves two words rather than one.
    [(CompilerIrValue.Unit)
      (if (compiler-backend-group-type? type-segment-bases program-index ty)
        (ResultCompilerBackend.Ok "    .quad 0\n    .quad 0\n")
        (ResultCompilerBackend.Ok "    .quad 0\n"))]
    [(CompilerIrValue.I64 n)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat "    .quad " (string.int->string n) "\n"))]
    [(CompilerIrValue.Bool b)
      (if b
        (ResultCompilerBackend.Ok "    .quad 1\n")
        (ResultCompilerBackend.Ok "    .quad 0\n"))]
    [(CompilerIrValue.Char c)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (string.int->string (compiler-backend-char-code c))
          "\n"))]
    [(CompilerIrValue.F64 bits)
      (ResultCompilerBackend.Ok (compiler-backend-float-bits-directive ty bits))]
    [(CompilerIrValue.Global name)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (compiler-backend-user-symbol-id name)
          "\n"))]
    [(CompilerIrValue.GlobalAddr name)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (compiler-backend-user-symbol-id name)
          "\n"))]
    [(CompilerIrValue.Function name)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (compiler-backend-closure-descriptor-label
            (compiler-ir-symbol-text name))
          "\n"))]
    [(CompilerIrValue.String text)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (compiler-backend-string-fat-label text)
          "\n"))]
    [(CompilerIrValue.Bytes text)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (compiler-backend-bytes-fat-label text)
          "\n"))]
    [_
      (ResultCompilerBackend.Err
        (box
          (compiler-diagnostic-at-start
            ""
            "backend: unsupported global initializer")))]))

(define (compiler-backend-runtime-global?
  [ty : AstType]
  [value : CompilerIrValue]) : bool
  (match value
    [(CompilerIrValue.RuntimeGlobal _) true]
    [(CompilerIrValue.Unit)
      (match ty
        [(AstType.Unit) false]
        [_ true])]
    [_ false]))

(define (compiler-backend-emit-runtime-global
  [target : CompilerBackendTarget]
  [symbol : String]
  [size : i64]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (str_cat.str-cat
        "    .comm "
        symbol
        ", "
        (string.int->string size)
        ", 8\n")]
    [(CompilerBackendTarget.Windows)
      (str_cat.str-cat
        "    .comm "
        symbol
        ", "
        (string.int->string size)
        ", 3\n")]))

(define (compiler-backend-emit-global
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [global : CompilerIrGlobal]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (match global
    [(CompilerIrGlobal.Global name ty value)
      (let
        [symbol : String (compiler-backend-user-symbol-id name)]
        (if (compiler-backend-runtime-global? ty value)
          (ResultCompilerBackend.Ok
            (str_cat.str-cat
              ".globl "
              symbol
              "\n"
              (compiler-backend-emit-runtime-global
                target
                symbol
                (if (compiler-backend-group-type?
                  type-segment-bases
                  program-index
                  ty)
                  16
                  8))
              ""))
          (match (compiler-backend-global-value-asm
            type-segment-bases
            ty
            value
            program-index)
            [(ResultCompilerBackend.Ok value-asm)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  ".globl "
                  symbol
                  "\n"
                  symbol
                  ":\n"
                  value-asm
                  ""))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)])))]))

(define (compiler-backend-emit-globals-buffer-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [globals : CompilerIrGlobalList]
  [buf : text_buf.TextBuf]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackendBuffer
  (match globals
    [(CompilerIrGlobalList.Nil) (ResultCompilerBackendBuffer.Ok buf)]
    [(CompilerIrGlobalList.Cons global rest)
      (match (compiler-backend-emit-global
        type-segment-bases
        target
        global
        program-index)
        [(ResultCompilerBackend.Ok head)
          (compiler-backend-emit-globals-buffer-into
            type-segment-bases
            target
            (box-get rest)
            (text_buf.append buf (compiler-backend-emergency-wrap head))
            program-index)]
        [(ResultCompilerBackend.Err message)
          (ResultCompilerBackendBuffer.Err message)])]
    [(CompilerIrGlobalList.Array seq)
      (compiler-backend-emit-globals-buffer-into
        type-segment-bases
        target
        (compiler-ir-global-seq-to-list seq)
        buf
        program-index)]))

(define (compiler-backend-global-init-call
  [type-segment-bases : i64]
  [name : i64]
  [init : i64]
  [ty : AstType]
  [program-index : CompilerBackendProgramIndex]) : String
  (let
    [symbol : String (compiler-backend-user-symbol-id name)]
    [init-symbol : String (compiler-backend-user-symbol-id init)]
    (str_cat.str-cat
      "    call "
      init-symbol
      "\n"
      (if (compiler-backend-group-type? type-segment-bases program-index ty)
        ;; A register-group init returns word0:word1 in %rax:%rdx; store
        ;; both into the inline 16-byte global slot.
        (str_cat.str-cat
          "    movq %rax, "
          symbol
          "(%rip)\n    movq %rdx, "
          symbol
          "+8(%rip)\n"
          "")
        (if (compiler-backend-float-type? ty)
          (str_cat.str-cat
            "    "
            (compiler-backend-float-move ty)
            " %xmm0, "
            symbol
            "(%rip)\n")
          (str_cat.str-cat "    movq %rax, " symbol "(%rip)\n")))
      "")))

(define (compiler-backend-global-initializers
  [type-segment-bases : i64]
  [globals : CompilerIrGlobalList]
  [program-index : CompilerBackendProgramIndex]) : String
  (match globals
    [(CompilerIrGlobalList.Nil) ""]
    [(CompilerIrGlobalList.Cons global rest)
      (match global
        [(CompilerIrGlobal.Global name ty value)
          (str_cat.str-cat
            (match value
              [(CompilerIrValue.RuntimeGlobal init)
                (compiler-backend-global-init-call
                  type-segment-bases
                  name
                  init
                  ty
                  program-index)]
              [_ ""])
            (compiler-backend-global-initializers
              type-segment-bases
              (box-get rest)
              program-index))])]
    [(CompilerIrGlobalList.Array seq)
      (compiler-backend-global-initializers
        type-segment-bases
        (compiler-ir-global-seq-to-list seq)
        program-index)]))

(define (compiler-backend-function-list-defines?
  [functions : CompilerIrFunctionList]
  [name : i64]) : bool
  (match functions
    [(CompilerIrFunctionList.Nil) false]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function func-name _ _ _ _)
          (if (compiler-ir-symbol-eq? func-name name)
            true
            (compiler-backend-function-list-defines? (box-get rest) name))])]
    [(CompilerIrFunctionList.Array seq)
      (compiler-backend-function-seq-defines? seq name 0)]))

(define (compiler-backend-function-seq-defines?
  [functions : CompilerIrFunctionSeq]
  [name : i64]
  [index : i64]) : bool
  (if (>= index (compiler-ir-function-seq-count functions))
    false
    (match (compiler-ir-function-seq-ref functions index)
      [(CompilerIrFunction.Function func-name _ _ _ _)
        (if (compiler-ir-symbol-eq? func-name name)
          true
          (compiler-backend-function-seq-defines? functions name (+ index 1)))])))

(define (compiler-backend-runtime-prelude-helper-function?
  [name : String]
  [helper : String]) : bool
  (and
    (string.eq (compiler-backend-symbol-leaf name) helper)
    (compiler-backend-stdlib-runtime-function-name? name)))

(define (compiler-backend-function-list-defines-runtime-prelude-helper?
  [functions : CompilerIrFunctionList]
  [helper : String]) : bool
  (match functions
    [(CompilerIrFunctionList.Nil) false]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name _ _ _ _)
          (if (compiler-backend-runtime-prelude-helper-function?
            (compiler-ir-symbol-text name)
            helper)
            true
            (compiler-backend-function-list-defines-runtime-prelude-helper?
              (box-get rest)
              helper))])]
    [(CompilerIrFunctionList.Array seq)
      (compiler-backend-function-seq-defines-runtime-prelude-helper?
        seq
        helper
        0)]))

(define (compiler-backend-function-seq-defines-runtime-prelude-helper?
  [functions : CompilerIrFunctionSeq]
  [helper : String]
  [index : i64]) : bool
  (if (>= index (compiler-ir-function-seq-count functions))
    false
    (match (compiler-ir-function-seq-ref functions index)
      [(CompilerIrFunction.Function name _ _ _ _)
        (if (compiler-backend-runtime-prelude-helper-function?
          (compiler-ir-symbol-text name)
          helper)
          true
          (compiler-backend-function-seq-defines-runtime-prelude-helper?
            functions
            helper
            (+ index 1)))])))

(define (compiler-backend-runtime-index-empty) : CompilerBackendRuntimeIndex
  (CompilerBackendRuntimeIndex
    (backend_i64_i64_map.with-capacity 256)
    (backend_i64_i64_map.with-capacity 256)
    (backend_i64_i64_map.with-capacity 256)
    -1
    false))

(define (compiler-backend-runtime-index-defines?
  [index : CompilerBackendRuntimeIndex]
  [name-id : i64]) : bool
  (backend_i64_i64_map.contains? (& (struct-get index defines)) name-id))

(define (compiler-backend-runtime-index-extern?
  [index : CompilerBackendRuntimeIndex]
  [name-id : i64]) : bool
  (backend_i64_i64_map.contains? (& (struct-get index externs)) name-id))

(define (compiler-backend-runtime-index-calls?
  [index : CompilerBackendRuntimeIndex]
  [name-id : i64]) : bool
  (backend_i64_i64_map.contains? (& (struct-get index calls)) name-id))

(define (compiler-backend-runtime-index-add-define
  [index : CompilerBackendRuntimeIndex]
  [name-id : i64]) : CompilerBackendRuntimeIndex
  (let
    [defines : backend_i64_i64_map.Map (struct-get index defines)]
    (begin
      (backend_i64_i64_map.insert-ref! (&mut defines) name-id 1)
      (CompilerBackendRuntimeIndex
        defines
        (struct-get index externs)
        (struct-get index calls)
        (struct-get index tlci-macro-entry-call-id)
        (struct-get index startup-profile)))))

(define (compiler-backend-runtime-index-add-extern-name
  [index : CompilerBackendRuntimeIndex]
  [name-id : i64]) : CompilerBackendRuntimeIndex
  (let
    [externs : backend_i64_i64_map.Map (struct-get index externs)]
    (begin
      (backend_i64_i64_map.insert-ref! (&mut externs) name-id 1)
      (CompilerBackendRuntimeIndex
        (struct-get index defines)
        externs
        (struct-get index calls)
        (struct-get index tlci-macro-entry-call-id)
        (struct-get index startup-profile)))))

(define (compiler-backend-runtime-index-add-call
  [index : CompilerBackendRuntimeIndex]
  [name-id : i64]) : CompilerBackendRuntimeIndex
  (let
    [calls : backend_i64_i64_map.Map (struct-get index calls)]
    (begin
      (backend_i64_i64_map.insert-ref! (&mut calls) name-id 1)
      (CompilerBackendRuntimeIndex
        (struct-get index defines)
        (struct-get index externs)
        calls
        (struct-get index tlci-macro-entry-call-id)
        (struct-get index startup-profile)))))

(define (compiler-backend-runtime-index-with-extern-role
  [index : CompilerBackendRuntimeIndex]
  [call-id : i64]
  [link-id : i64]) : CompilerBackendRuntimeIndex
  (CompilerBackendRuntimeIndex
    (struct-get index defines)
    (struct-get index externs)
    (struct-get index calls)
    (if (cbi.compiler-builtin-backend-tlci-call-macro-entry-id? link-id)
      call-id
      (struct-get index tlci-macro-entry-call-id))
    (struct-get index startup-profile)))

(define (compiler-backend-runtime-index-with-startup-profile-role
  [index : CompilerBackendRuntimeIndex]
  [link-id : i64]) : CompilerBackendRuntimeIndex
  (if (string.eq
    (compiler-ir-symbol-text link-id)
    "tl_startup_profile_process_entry_tick")
    (CompilerBackendRuntimeIndex
      (struct-get index defines)
      (struct-get index externs)
      (struct-get index calls)
      (struct-get index tlci-macro-entry-call-id)
      true)
    index))

(define (compiler-backend-runtime-index-instr
  [index : CompilerBackendRuntimeIndex]
  [instr : CompilerIrInstr]) : CompilerBackendRuntimeIndex
  (match instr
    [(CompilerIrInstr.Call _ call-name _ _)
      (compiler-backend-runtime-index-add-call index call-name)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload _ call-name _ _)
          (compiler-backend-runtime-index-add-call index call-name)])]
    [(CompilerIrInstr.TailCall call-name _ _)
      (compiler-backend-runtime-index-add-call index call-name)]
    [_ index]))

(define (compiler-backend-runtime-index-instr-seq
  [index : CompilerBackendRuntimeIndex]
  [instrs : CompilerIrInstrSeq]) : CompilerBackendRuntimeIndex
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [i : i64 0]
    [out : CompilerBackendRuntimeIndex index]
    (begin
      (while (< i count)
        (begin
          (set!
            out
            (compiler-backend-runtime-index-instr out (array-ref slots i)))
          (set! i (+ i 1))))
      out)))

(define (compiler-backend-runtime-index-blocks
  [index : CompilerBackendRuntimeIndex]
  [blocks : CompilerIrBlockList]) : CompilerBackendRuntimeIndex
  (match blocks
    [(CompilerIrBlockList.Nil) index]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-backend-runtime-index-blocks
            (compiler-backend-runtime-index-instr-seq index instrs)
            (box-get rest))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-runtime-index-block-seq index seq 0)]))

(define (compiler-backend-runtime-index-block-seq
  [index : CompilerBackendRuntimeIndex]
  [blocks : CompilerIrBlockSeq]
  [seq-index : i64]) : CompilerBackendRuntimeIndex
  (if (>= seq-index (compiler-ir-block-seq-count blocks))
    index
    (match (compiler-ir-block-seq-ref blocks seq-index)
      [(CompilerIrBlock.Block _ instrs)
        (compiler-backend-runtime-index-block-seq
          (compiler-backend-runtime-index-instr-seq index instrs)
          blocks
          (+ seq-index 1))])))

(define (compiler-backend-runtime-index-functions
  [index : CompilerBackendRuntimeIndex]
  [functions : CompilerIrFunctionList]) : CompilerBackendRuntimeIndex
  (match functions
    [(CompilerIrFunctionList.Nil) index]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name _ _ _ blocks)
          (compiler-backend-runtime-index-functions
            (compiler-backend-runtime-index-blocks
              (compiler-backend-runtime-index-add-define index name)
              blocks)
            (box-get rest))])]
    [(CompilerIrFunctionList.Array seq)
      (compiler-backend-runtime-index-function-seq index seq 0)]))

(define (compiler-backend-runtime-index-function-seq
  [index : CompilerBackendRuntimeIndex]
  [functions : CompilerIrFunctionSeq]
  [seq-index : i64]) : CompilerBackendRuntimeIndex
  (if (>= seq-index (compiler-ir-function-seq-count functions))
    index
    (match (compiler-ir-function-seq-ref functions seq-index)
      [(CompilerIrFunction.Function name _ _ _ blocks)
        (compiler-backend-runtime-index-function-seq
          (compiler-backend-runtime-index-blocks
            (compiler-backend-runtime-index-add-define index name)
            blocks)
          functions
          (+ seq-index 1))])))

(define (compiler-backend-runtime-index-externs
  [index : CompilerBackendRuntimeIndex]
  [externs : CompilerIrExternList]) : CompilerBackendRuntimeIndex
  (match externs
    [(CompilerIrExternList.Nil) index]
    [(CompilerIrExternList.Cons item rest)
      (match item
        [(CompilerIrExtern.Extern
            name-id
            source-name-id
            _
            _
            _
            link-symbol
            _
            provided)
          (let
            [with-startup-role : CompilerBackendRuntimeIndex
              (compiler-backend-runtime-index-with-startup-profile-role
                index
                link-symbol)]
            (if provided
              (compiler-backend-runtime-index-externs
                with-startup-role
                (box-get rest))
              (let
                [with-names : CompilerBackendRuntimeIndex
                  (compiler-backend-runtime-index-add-extern-name
                    (compiler-backend-runtime-index-add-extern-name
                      (compiler-backend-runtime-index-add-extern-name
                        with-startup-role
                        name-id)
                      source-name-id)
                    link-symbol)]
                [with-runtime-role : CompilerBackendRuntimeIndex
                  (compiler-backend-runtime-index-with-extern-role
                    with-names
                    name-id
                    link-symbol)]
                (compiler-backend-runtime-index-externs
                  with-runtime-role
                  (box-get rest)))))])]
    [(CompilerIrExternList.Array seq)
      (compiler-backend-runtime-index-externs
        index
        (compiler-ir-extern-seq-to-list seq))]))

(define (compiler-backend-runtime-index-arena-debug-call-links
  [index : CompilerBackendRuntimeIndex]
  [externs : CompilerIrExternList]) : CompilerBackendRuntimeIndex
  (match externs
    [(CompilerIrExternList.Nil) index]
    [(CompilerIrExternList.Cons item rest)
      (match item
        [(CompilerIrExtern.Extern name-id source-name-id _ _ _ link-symbol _ _)
          (compiler-backend-runtime-index-arena-debug-call-links
            (if (and
              (cbi.compiler-builtin-backend-runtime-arena-debug-id? link-symbol)
              (or
                (compiler-backend-runtime-index-calls? index name-id)
                (compiler-backend-runtime-index-calls? index source-name-id)))
              (compiler-backend-runtime-index-add-call index link-symbol)
              index)
            (box-get rest))])]
    [(CompilerIrExternList.Array seq)
      (compiler-backend-runtime-index-arena-debug-call-links
        index
        (compiler-ir-extern-seq-to-list seq))]))

(define (compiler-backend-runtime-index
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]) : CompilerBackendRuntimeIndex
  (compiler-backend-runtime-index-arena-debug-call-links
    (compiler-backend-runtime-index-functions
      (compiler-backend-runtime-index-externs
        (compiler-backend-runtime-index-empty)
        externs)
      functions)
    externs))

(define (compiler-backend-runtime-helper-core-id? [name-id : i64]) : bool
  ;; The allocator/arena/TLS substrate is irreducible backend core runtime.
  ;; It bootstraps ordinary TypeLisp allocation, owns the
  ;; `tl_current_arena` slot, and must remain import-free/allocation-free while
  ;; acquiring and releasing arena pages. Linux page ownership is the
  ;; mmap/munmap sequence in `tl_alloc`, `tl_arena_make`, `tl_arena_destroy`,
  ;; and `tl_region_reset`; Windows uses kernel32 VirtualAlloc/VirtualFree in
  ;; the same allocation/release paths. `tl_region_mark`, `tl_arena_current`,
  ;; `tl_arena_set`, `tl_arena_poison_enable`, and the thread entry helpers
  ;; read or update backend runtime TLS state.
  ;; tl_oob_abort / tl_div_abort / tl_shift_abort live in the runtime prelude
  ;; (stdlib/runtime.tl) and are provided by export-symbol, so they are not
  ;; backend-owned runtime helpers (keeping them here would make the export
  ;; collide with a "known runtime symbol").
  (cbi.compiler-builtin-backend-runtime-core-id? name-id))

;; Stdlib modules depend on these backend runtime shims for
;; unavoidable profile operations.
(define (compiler-backend-runtime-helper-stdlib-ffi-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-backend-runtime-stdlib-ffi-id? name-id))

;; Runtime helpers whose implementation and fixed export symbols are owned by
;; the TypeLisp stdlib prelude.
(define (compiler-backend-runtime-helper-stdlib-type-lisp-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-backend-runtime-stdlib-type-lisp-id? name-id))

(define (compiler-backend-runtime-helper-owner-id [name-id : i64]) : CompilerBackendRuntimeHelperOwner
  (cond
    [(compiler-backend-runtime-helper-core-id? name-id)
      (CompilerBackendRuntimeHelperOwner.Core)]
    [(compiler-backend-runtime-helper-stdlib-ffi-id? name-id)
      (CompilerBackendRuntimeHelperOwner.StdlibFfi)]
    [(compiler-backend-runtime-helper-stdlib-type-lisp-id? name-id)
      (CompilerBackendRuntimeHelperOwner.StdlibTypeLisp)]
    [else (CompilerBackendRuntimeHelperOwner.Unknown)]))

(define (compiler-backend-runtime-helper-known-id? [name-id : i64]) : bool
  (match (compiler-backend-runtime-helper-owner-id name-id)
    [(CompilerBackendRuntimeHelperOwner.Unknown) false]
    [_ true]))

;; First-class arena runtime helpers and the arena poison debug toggle
;; are always emitted, so they are provided runtime symbols (resolve to
;; their raw names, not the mangled `_tl_tl_arena_*`).
(define (compiler-backend-plan-provides-id?
  [plan : CompilerBackendRuntimePlan]
  [name-id : i64]) : bool
  (or
    (cbi.compiler-builtin-backend-runtime-always-provided-id? name-id)
    (cbi.compiler-builtin-backend-runtime-always-provided-tail-id? name-id)
    (compiler-backend-plan-provides-rest-id? plan name-id)))

(define (compiler-backend-plan-provides-rest-id?
  [plan : CompilerBackendRuntimePlan]
  [name-id : i64]) : bool
  (match plan
    [(CompilerBackendRuntimePlan.WithScratch base _)
      (compiler-backend-plan-provides-rest-id? (box-get base) name-id)]
    [(CompilerBackendRuntimePlan.Plan
        alloc
        substring
        str-view
        concat
        provides-int-to-string
        region-mark
        region-reset
        provides-tail)
      (or
        (backend-or8
          (and alloc (cbi.compiler-builtin-backend-tl-alloc-id? name-id))
          (and
            region-mark
            (cbi.compiler-builtin-backend-tl-region-mark-id? name-id))
          (and
            region-reset
            (cbi.compiler-builtin-backend-tl-region-reset-id? name-id))
          (and
            substring
            (cbi.compiler-builtin-backend-tl-substring-id? name-id))
          (and str-view (cbi.compiler-builtin-backend-tl-str-view-id? name-id))
          (and concat (cbi.compiler-builtin-backend-runtime-concat-id? name-id))
          (and
            provides-int-to-string
            (cbi.compiler-builtin-backend-tl-int-to-string-id? name-id))
          (and
            (compiler-backend-runtime-tail-profile? provides-tail)
            (cbi.compiler-builtin-backend-runtime-profile-id? name-id)))
        (and
          (compiler-backend-runtime-tail-arena-debug? provides-tail)
          (cbi.compiler-builtin-backend-runtime-arena-debug-id? name-id)))]))

(define (compiler-backend-runtime-plan-with-index-for
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]) : ResultBackendRuntimePlanWithIndex
  (let
    [index : CompilerBackendRuntimeIndex
      (compiler-backend-runtime-index functions externs)]
    [defines-alloc : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-alloc)]
    [defines-substring : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-substring)]
    [defines-str-view : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-str-view)]
    [defines-concat : bool
      (backend-or4
        (compiler-backend-runtime-index-defines?
          index
          cbi.compiler-builtin-id-tl-string-concat)
        (compiler-backend-runtime-index-defines?
          index
          cbi.compiler-builtin-id-tl-string-concat3)
        (compiler-backend-runtime-index-defines?
          index
          cbi.compiler-builtin-id-tl-string-concat4)
        (compiler-backend-runtime-index-defines?
          index
          cbi.compiler-builtin-id-tl-string-concat5))]
    [defines-int-to-string : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-int-to-string)]
    [provides-substring : bool
      (compiler-backend-function-list-defines-runtime-prelude-helper?
        functions
        "substring")]
    [provides-str-view : bool
      (compiler-backend-function-list-defines-runtime-prelude-helper?
        functions
        "str-view")]
    [provides-concat : bool
      (backend-or4
        (compiler-backend-function-list-defines-runtime-prelude-helper?
          functions
          "string-concat")
        (compiler-backend-function-list-defines-runtime-prelude-helper?
          functions
          "string-concat3")
        (compiler-backend-function-list-defines-runtime-prelude-helper?
          functions
          "string-concat4")
        (compiler-backend-function-list-defines-runtime-prelude-helper?
          functions
          "string-concat5"))]
    [provides-int-to-string : bool
      (compiler-backend-function-list-defines-runtime-prelude-helper?
        functions
        "int-to-string")]
    [defines-region-mark : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-region-mark)]
    [defines-region-reset : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-region-reset)]
    [defines-profile-alloc-total : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-total)]
    [defines-profile-alloc-live : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-live)]
    [defines-profile-alloc-peak : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-peak)]
    [defines-profile-alloc-reset-peak : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-reset-peak)]
    [extern-region-mark : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-region-mark)]
    [extern-region-reset : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-region-reset)]
    [extern-profile-alloc-total : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-total)]
    [extern-profile-alloc-live : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-live)]
    [extern-profile-alloc-peak : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-peak)]
    [extern-profile-alloc-reset-peak : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-reset-peak)]
    [calls-alloc : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-alloc)]
    [calls-substring : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-substring)]
    [calls-str-view : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-str-view)]
    [calls-concat : bool
      (backend-or4
        (compiler-backend-runtime-index-calls?
          index
          cbi.compiler-builtin-id-tl-string-concat)
        (compiler-backend-runtime-index-calls?
          index
          cbi.compiler-builtin-id-tl-string-concat3)
        (compiler-backend-runtime-index-calls?
          index
          cbi.compiler-builtin-id-tl-string-concat4)
        (compiler-backend-runtime-index-calls?
          index
          cbi.compiler-builtin-id-tl-string-concat5))]
    [calls-int-to-string : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-int-to-string)]
    [calls-region-mark : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-region-mark)]
    [calls-region-reset : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-region-reset)]
    [calls-profile-alloc-total : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-total)]
    [calls-profile-alloc-live : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-live)]
    [calls-profile-alloc-peak : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-peak)]
    [calls-profile-alloc-reset-peak : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-reset-peak)]
    [calls-arena-debug-protect : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-arena-debug-protect-never-reset)]
    [calls-arena-debug-pool-install : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-arena-debug-assert-pool-install)]
    ;; Prelude string helpers keep fixed export symbols for validation and call
    ;; spelling, but their TypeLisp bodies expose allocator calls directly in
    ;; the runtime index. The plan therefore retains only these symbol facts;
    ;; only a real `tl_alloc` call enables allocator asm.
    [needs-substring : bool
      (or provides-substring (and (not defines-substring) calls-substring))]
    [needs-str-view : bool
      (or provides-str-view (and (not defines-str-view) calls-str-view))]
    [needs-concat : bool
      (or provides-concat (and (not defines-concat) calls-concat))]
    [needs-int-to-string : bool
      (or
        provides-int-to-string
        (and (not defines-int-to-string) calls-int-to-string))]
    [needs-alloc : bool (and (not defines-alloc) calls-alloc)]
    [needs-region-mark : bool
      (and (not defines-region-mark) (or extern-region-mark calls-region-mark))]
    [needs-region-reset : bool
      (and
        (not defines-region-reset)
        (or extern-region-reset calls-region-reset))]
    [needs-profile : bool
      (backend-or4
        (and
          (not defines-profile-alloc-total)
          (or extern-profile-alloc-total calls-profile-alloc-total))
        (and
          (not defines-profile-alloc-live)
          (or extern-profile-alloc-live calls-profile-alloc-live))
        (and
          (not defines-profile-alloc-peak)
          (or extern-profile-alloc-peak calls-profile-alloc-peak))
        (and
          (not defines-profile-alloc-reset-peak)
          (or extern-profile-alloc-reset-peak calls-profile-alloc-reset-peak)))]
    [needs-arena-debug : bool
      (or calls-arena-debug-protect calls-arena-debug-pool-install)]
    [needs-tlci-macro-entry : bool
      (let
        [call-id : i64 (struct-get index tlci-macro-entry-call-id)]
        (and
          (>= call-id 0)
          (compiler-backend-runtime-index-calls? index call-id)))]
    [needs-startup-profile : bool (struct-get index startup-profile)]
    (ResultBackendRuntimePlanWithIndex.Ok
      (CompilerBackendRuntimePlanWithIndex
        (CompilerBackendRuntimePlan.Plan
          needs-alloc
          needs-substring
          needs-str-view
          needs-concat
          needs-int-to-string
          needs-region-mark
          needs-region-reset
          (CompilerBackendRuntimeTailPlan
            needs-profile
            needs-tlci-macro-entry
            needs-arena-debug
            needs-startup-profile))
        index))))

(define (compiler-backend-runtime-plan-for
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]) : ResultBackendRuntimePlan
  (match (compiler-backend-runtime-plan-with-index-for functions externs)
    [(ResultBackendRuntimePlanWithIndex.Ok planned)
      (ResultBackendRuntimePlan.Ok (struct-get planned plan))]
    [(ResultBackendRuntimePlanWithIndex.Err message)
      (ResultBackendRuntimePlan.Err message)]))

(define (compiler-backend-runtime-plan [program : CompilerIrProgram]) : ResultBackendRuntimePlan
  (begin
    ;; Seed builtin/runtime ids before scratch-backed per-function emission. The
    ;; runtime-plan id predicates are then lookup-only in scratch arenas.
    (cbi.compiler-builtin-refresh!)
    (match program
      [(CompilerIrProgram.Program _ functions externs)
        (compiler-backend-runtime-plan-for functions externs)])))

(define (compiler-backend-runtime-plan-with-index [program : CompilerIrProgram]) : ResultBackendRuntimePlanWithIndex
  (begin
    ;; Seed builtin/runtime ids before scratch-backed per-function emission. The
    ;; runtime-plan id predicates are then lookup-only in scratch arenas.
    (cbi.compiler-builtin-refresh!)
    (match program
      [(CompilerIrProgram.Program _ functions externs)
        (compiler-backend-runtime-plan-with-index-for functions externs)])))

(define (compiler-backend-extern-symbol-referenced?
  [runtime-index : CompilerBackendRuntimeIndex]
  [referenced-functions : BackendSymbolSeq]
  [extern-name-id : i64]
  [link-symbol-id : i64]) : bool
  (let
    [foreign-link-symbol : bool
      (and
        (not (= extern-name-id link-symbol-id))
        (not (compiler-backend-runtime-helper-known-id? extern-name-id))
        (not (compiler-backend-runtime-helper-known-id? link-symbol-id)))]
    (or
      foreign-link-symbol
      (backend-or4
        (compiler-backend-runtime-index-calls? runtime-index extern-name-id)
        (compiler-backend-runtime-index-calls? runtime-index link-symbol-id)
        (compiler-backend-symbol-list-contains-id?
          referenced-functions
          extern-name-id)
        false)
      false)))

(define (compiler-backend-emit-externs-into
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [runtime-index : CompilerBackendRuntimeIndex]
  [referenced-functions : BackendSymbolSeq]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match externs
    [(CompilerIrExternList.Nil) buf]
    [(CompilerIrExternList.Cons item rest)
      (match item
        [(CompilerIrExtern.Extern name-id _ name _ _ link-symbol-id _ provided)
          (if (and
            (compiler-backend-emits-extern-symbol?
              name-id
              link-symbol-id
              provided
              plan)
            (compiler-backend-extern-symbol-referenced?
              runtime-index
              referenced-functions
              name-id
              link-symbol-id))
            (compiler-backend-emit-externs-into
              (box-get rest)
              plan
              runtime-index
              referenced-functions
              (text_buf.append
                (text_buf.append buf ".extern ")
                (str_cat.str-cat
                  (compiler-backend-link-symbol-id link-symbol-id plan)
                  "\n"
                  "")))
            (compiler-backend-emit-externs-into
              (box-get rest)
              plan
              runtime-index
              referenced-functions
              buf))])]
    [(CompilerIrExternList.Array seq)
      (compiler-backend-emit-externs-into
        (compiler-ir-extern-seq-to-list seq)
        plan
        runtime-index
        referenced-functions
        buf)]))

;; `tl_current_arena` is the live bump-arena pointer shared by tl_alloc, the
;; region runtime, and the first-class arena builtins. It is a
;; per-thread active-arena slot: Linux uses local-exec ELF TLS; Windows
;; stores the pointer in the TEB arbitrary-user slot (GS:0x28). Like the arena
;; primitives, the runtime lives in exactly ONE object per executable (the entry
;; object, `emit-entry=true`); library/dependency objects (`emit-entry=false`)
;; emit none of the runtime and reference the Linux TLS slot as an extern.
;; Runtime planning and indexing stay in this module. Emission consumes one
;; narrow immutable recipe and selects a platform leaf once for each composed
;; data, function, and extern fragment.
(define (compiler-backend-runtime-features [plan : CompilerBackendRuntimePlan]) : runtime_common.CompilerBackendRuntimeFeatures
  (begin
    (cbi.compiler-builtin-refresh!)
    (match plan
      [(CompilerBackendRuntimePlan.WithScratch base _)
        (compiler-backend-runtime-features (box-get base))]
      [(CompilerBackendRuntimePlan.Plan
          alloc
          _
          _
          _
          _
          region-mark
          region-reset
          tail-plan)
        (let
          [write-exit : bool
            (or
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-alloc)
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-oob-abort)
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-abort-label)
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-div-abort)
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-shift-abort)
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-region-reset))]
          [print-f64 : bool
            (compiler-backend-plan-provides-id?
              plan
              cbi.compiler-builtin-id-tl-print-f64)]
          (runtime_common.CompilerBackendRuntimeFeatures
            alloc
            region-mark
            region-reset
            (compiler-backend-runtime-tail-arena-debug? tail-plan)
            (compiler-backend-runtime-tail-profile? tail-plan)
            (compiler-backend-runtime-tail-tlci-macro-entry? tail-plan)
            write-exit
            print-f64
            (compiler-backend-runtime-tail-startup-profile? tail-plan)))])))

(define (compiler-backend-current-arena-load
  [target : CompilerBackendTarget]
  [dst : String]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (runtime_linux.compiler-backend-current-arena-load dst)]
    [(CompilerBackendTarget.Windows)
      (runtime_windows.compiler-backend-current-arena-load dst)]))

(define (compiler-backend-current-arena-store
  [target : CompilerBackendTarget]
  [src : String]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (runtime_linux.compiler-backend-current-arena-store src)]
    [(CompilerBackendTarget.Windows)
      (runtime_windows.compiler-backend-current-arena-store src)]))

(define (compiler-backend-runtime-data-for-target
  [target : CompilerBackendTarget]
  [features : (& features runtime_common.CompilerBackendRuntimeFeatures)]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (runtime_linux.compiler-backend-runtime-data features)]
    [(CompilerBackendTarget.Windows)
      (runtime_windows.compiler-backend-runtime-data features)]))

(define (compiler-backend-runtime-functions-for-target
  [target : CompilerBackendTarget]
  [features : (& features runtime_common.CompilerBackendRuntimeFeatures)]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (runtime_linux.compiler-backend-runtime-functions features)]
    [(CompilerBackendTarget.Windows)
      (runtime_windows.compiler-backend-runtime-functions features)]))

(define (compiler-backend-runtime-externs-for-target
  [target : CompilerBackendTarget]
  [features : (& features runtime_common.CompilerBackendRuntimeFeatures)]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (runtime_linux.compiler-backend-runtime-externs features)]
    [(CompilerBackendTarget.Windows)
      (runtime_windows.compiler-backend-runtime-externs features)]))

;; Argument register for call arg `idx` under the target's calling convention.
;; System V (Linux) uses rdi/rsi/rdx/rcx/r8/r9;
;; Windows x64 passes the first four integer/pointer args in rcx/rdx/r8/r9.
(define (compiler-backend-target-arg-reg
  [target : CompilerBackendTarget]
  [idx : i64]) : ResultBackendReg
  (compiler-backend-result-reg
    (compiler-abi-gp-arg-register (compiler-backend-target-abi target) idx)
    "backend: too many call args"))

(define (compiler-backend-target-float-arg-reg
  [target : CompilerBackendTarget]
  [idx : i64]) : ResultBackendReg
  (compiler-backend-result-reg
    (compiler-abi-float-arg-register (compiler-backend-target-abi target) idx)
    "backend: too many call args"))

(define (compiler-backend-call-bank-index
  [target : CompilerBackendTarget]
  [bank-idx : i64]
  [position : i64]) : i64
  (if (compiler-abi-arg-banks-independent? (compiler-backend-target-abi target))
    bank-idx
    position))

(define (compiler-backend-target-arg-reg-for-banks
  [target : CompilerBackendTarget]
  [int-idx : i64]
  [position : i64]) : ResultBackendReg
  (compiler-backend-target-arg-reg
    target
    (compiler-backend-call-bank-index target int-idx position)))

(define (compiler-backend-target-float-arg-reg-for-banks
  [target : CompilerBackendTarget]
  [float-idx : i64]
  [position : i64]) : ResultBackendReg
  (compiler-backend-target-float-arg-reg
    target
    (compiler-backend-call-bank-index target float-idx position)))

;; Caller-reserved outgoing shadow space in bytes: none on System V, 32 on
;; Windows x64.
(define (compiler-backend-outgoing-shadow-space
  [target : CompilerBackendTarget]) : i64
  (compiler-abi-outgoing-shadow-space (compiler-backend-target-abi target)))

;; Program entry section and global symbol. Freestanding Linux links the
;; backend-owned `_tl_start`; CRT entry mode links `main` through the C runtime.
;; Windows links `main` through the CRT.
(define (compiler-backend-target-linux? [target : CompilerBackendTarget]) : bool
  (compiler-abi-linux? (compiler-backend-target-abi target)))

(define (compiler-backend-target-entry-text-with-crt
  [target : CompilerBackendTarget]
  [emit-entry : bool]
  [crt-entry : bool]) : String
  (if emit-entry
    (match target
      [(CompilerBackendTarget.Linux)
        (if crt-entry
          ".text\n.globl main\n"
          ".text\n.globl _tl_start\n")]
      [(CompilerBackendTarget.Windows) ".text\n.globl main\n"])
    ".text\n"))

(define (compiler-backend-target-entry-text
  [target : CompilerBackendTarget]
  [emit-entry : bool]) : String
  (compiler-backend-target-entry-text-with-crt target emit-entry false))

;; Run main on a fresh 1 GiB mmap'd stack, then exit(main()). The compiler
;; recurses far deeper than the default 8 MiB stack rlimit allows ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â type-directed
;; `clone` of large IR values during arena escapes is the worst case ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â so
;; a self-hosted compiler segfaults compiling a large program on the default
;; stack. argc/argv/envp are already captured into globals before this runs, so
;; switching %rsp is safe (main reads them from globals, not the stack). A failed
;; mmap (negative result) keeps the original stack; the unmapped page below the
;; region turns any overflow into a clean SIGSEGV rather than silent corruption.
(define (compiler-backend-entry-call-main) : String
  "    movq $0x40000000, %rsi
    xorq %rdi, %rdi
    movq $3, %rdx
    movq $0x22, %r10
    movq $-1, %r8
    xorq %r9, %r9
    movq $9, %rax
    syscall
    testq %rax, %rax
    js .L_tl_main_keep_stack
    addq $0x40000000, %rax
    andq $-16, %rax
    movq %rax, %rsp
.L_tl_main_keep_stack:
    call main
    movq %rax, %rdi
    movq $60, %rax
    syscall
")

(define (compiler-backend-entry
  [capture-argv : bool]
  [capture-env : bool]
  [startup-profile : bool]
  [global-inits : String]) : String
  (let
    [startup-profile-asm : String
      (if startup-profile
        "    movq $228, %rax
    movq $1, %rdi
    leaq .L_tl_startup_profile_timespec(%rip), %rsi
    syscall
    testq %rax, %rax
    js .L_tl_startup_profile_process_entry_done
    movq .L_tl_startup_profile_timespec(%rip), %rax
    imulq $1000000000, %rax
    addq .L_tl_startup_profile_timespec+8(%rip), %rax
    movq %rax, .L_tl_startup_profile_process_entry_tick(%rip)
.L_tl_startup_profile_process_entry_done:
"
        "")]
    (if (or capture-argv capture-env)
      (str_cat.str-cat
        "_tl_start:\n"
        startup-profile-asm
        "    movq (%rsp), %rax\n"
        (if capture-argv
          "    movq %rax, .L_tl_argc(%rip)
    leaq 8(%rsp), %rax
    movq %rax, .L_tl_argv(%rip)
"
          "")
        (if capture-env
          (str_cat.str-cat
            (if capture-argv
              "    movq (%rsp), %rax\n"
              "")
            "    leaq 16(%rsp,%rax,8), %rax
    movq %rax, .L_tl_envp(%rip)
")
          "")
        "    call tl_thread_init\n"
        global-inits
        (compiler-backend-entry-call-main))
      (str_cat.str-cat
        "_tl_start:\n"
        startup-profile-asm
        "    call tl_thread_init\n"
        global-inits
        (compiler-backend-entry-call-main)))))

(define (compiler-backend-entry-for-target-with-crt
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [plan : CompilerBackendRuntimePlan]
  [globals : CompilerIrGlobalList]
  [crt-entry : bool]
  [program-index : CompilerBackendProgramIndex]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (if crt-entry
        ""
        (compiler-backend-entry
          true
          true
          (compiler-backend-runtime-tail-startup-profile?
            (compiler-backend-runtime-plan-tail plan))
          (compiler-backend-global-initializers
            type-segment-bases
            globals
            program-index)))]
    [(CompilerBackendTarget.Windows) ""]))

(define (compiler-backend-target-windows? [target : CompilerBackendTarget]) : bool
  (compiler-abi-windows? (compiler-backend-target-abi target)))

;; Emit a full program for `target`. Windows x64 has ABI-correct user function
;; entry/calls and target-specific runtime helpers.
;; Backend entry points come in two flavors: the original
;;
;; program-only variants (kept for existing call sites and smoke tests) supply
;;
;; an empty provenance table, so backend diagnostics fall back to `path:1:1`;
;;
;; the `-with-spans` variants thread the lowering provenance side table so
;;
;; backend errors report the offending function's real source location.
(define (compiler-backend-emit-program-for-target
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (compiler-backend-emit-program-target
    program
    target
    (compiler-source-spans-empty)
    true))

(define (compiler-backend-emit-program-linux [program : CompilerIrProgram]) : ResultCompilerBackend
  (compiler-backend-emit-program-for-target
    program
    (CompilerBackendTarget.Linux)))

(define (compiler-backend-emit-program-linux-with-spans
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]) : ResultCompilerBackend
  (compiler-backend-emit-program-target
    program
    (CompilerBackendTarget.Linux)
    spans
    true))

(define (compiler-backend-emit-program-with-spans-for-target
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (compiler-backend-emit-program-target program target spans true))

(define (compiler-backend-emit-program-with-spans-for-target-and-entry
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [target : CompilerBackendTarget]
  [emit-entry : bool]) : ResultCompilerBackend
  (compiler-backend-emit-program-target program target spans emit-entry))

(define (compiler-backend-emit-program-target
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackend
  (compiler-backend-emit-program-target-with-mode
    program
    target
    (CompilerBackendMode.Scalar)
    spans
    emit-entry))

(define (compiler-backend-emit-program-target-with-mode-buffer
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackendBuffer
  (compiler-backend-emit-program-target-with-mode-buffer-and-crt
    program
    target
    mode
    spans
    emit-entry
    false
    false))

(define (compiler-backend-emit-program-prefix-buffer
  [target : CompilerBackendTarget]
  [entry-functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [runtime-features
    : (& features runtime_common.CompilerBackendRuntimeFeatures)]
  [program-index : CompilerBackendProgramIndex]
  [runtime-index : CompilerBackendRuntimeIndex]
  [closure-names : BackendSymbolSeq]
  [strings : BackendStringSeq]
  [bytes : BackendStringSeq]
  [floats : BackendFloatList]
  [uses-avx2-i64-lane-id : bool]
  [uses-avx512-i64-lane-id : bool]
  [uses-f64-neg : bool]
  [globals-buf : text_buf.TextBuf]
  [emit-entry : bool]
  [crt-entry : bool]) : text_buf.TextBuf
  (let
    [string-buf : text_buf.TextBuf
      (compiler-backend-emit-string-rodata-into strings globals-buf)]
    (begin
      (cfg
        compile-profile
        (compiler-backend-profile-finish
          (struct-get program-index profile-state)
          "compose.string_rodata"))
      (cfg
        compile-profile
        (compiler-backend-profile-start
          (struct-get program-index profile-state)))
      (let
        [bytes-buf : text_buf.TextBuf
          (compiler-backend-emit-bytes-data-into bytes string-buf)]
        (begin
          (cfg
            compile-profile
            (compiler-backend-profile-finish
              (struct-get program-index profile-state)
              "compose.bytes_data"))
          (cfg
            compile-profile
            (compiler-backend-profile-start
              (struct-get program-index profile-state)))
          (let
            [float-literals-buf : text_buf.TextBuf
              (compiler-backend-emit-float-rodata-into floats bytes-buf)]
            [f64-buf : text_buf.TextBuf
              (compiler-backend-emit-f64-sign-bit-rodata-into
                uses-f64-neg
                float-literals-buf)]
            [lane-id-buf : text_buf.TextBuf
              (compiler-backend-emit-lane-id-rodata-into
                uses-avx2-i64-lane-id
                uses-avx512-i64-lane-id
                f64-buf)]
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-finish
                  (struct-get program-index profile-state)
                  "compose.float_rodata"))
              (cfg
                compile-profile
                (compiler-backend-profile-start
                  (struct-get program-index profile-state)))
              (let
                [descriptor-buf : text_buf.TextBuf
                  (compiler-backend-emit-closure-descriptors-into
                    closure-names
                    entry-functions
                    externs
                    program-index
                    lane-id-buf)]
                (begin
                  (cfg
                    compile-profile
                    (compiler-backend-profile-finish
                      (struct-get program-index profile-state)
                      "compose.closure_descriptors"))
                  (cfg
                    compile-profile
                    (compiler-backend-profile-start
                      (struct-get program-index profile-state)))
                  (let
                    [switch-buf : text_buf.TextBuf
                      (compiler-backend-emit-switch-tables-functions-into
                        entry-functions
                        program-index
                        descriptor-buf)]
                    [runtime-data-buf : text_buf.TextBuf
                      (text_buf.append
                        switch-buf
                        (if emit-entry
                          (compiler-backend-runtime-data-for-target
                            target
                            runtime-features)
                          ""))]
                    (begin
                      (cfg
                        compile-profile
                        (compiler-backend-profile-finish
                          (struct-get program-index profile-state)
                          "compose.runtime_data"))
                      (cfg
                        compile-profile
                        (compiler-backend-profile-start
                          (struct-get program-index profile-state)))
                      (let
                        [externs-buf : text_buf.TextBuf
                          (compiler-backend-emit-externs-into
                            externs
                            plan
                            runtime-index
                            closure-names
                            runtime-data-buf)]
                        (begin
                          (cfg
                            compile-profile
                            (compiler-backend-profile-finish
                              (struct-get program-index profile-state)
                              "compose.externs"))
                          (cfg
                            compile-profile
                            (compiler-backend-profile-start
                              (struct-get program-index profile-state)))
                          (let
                            [runtime-externs-buf : text_buf.TextBuf
                              (text_buf.append
                                externs-buf
                                (if emit-entry
                                  (compiler-backend-runtime-externs-for-target
                                    target
                                    runtime-features)
                                  ""))]
                            (begin
                              (cfg
                                compile-profile
                                (compiler-backend-profile-finish
                                  (struct-get program-index profile-state)
                                  "compose.runtime_externs"))
                              (cfg
                                compile-profile
                                (compiler-backend-profile-start
                                  (struct-get program-index profile-state)))
                              (let
                                [prefix-buf : text_buf.TextBuf
                                  (text_buf.append
                                    runtime-externs-buf
                                    (compiler-backend-target-entry-text-with-crt
                                      target
                                      emit-entry
                                      crt-entry))]
                                (begin
                                  (cfg
                                    compile-profile
                                    (compiler-backend-profile-finish
                                      (struct-get program-index profile-state)
                                      "compose.entry_text"))
                                  prefix-buf)))))))))))))))))

(define (compiler-backend-emit-program-buffer-after-index
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [entry-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [runtime-index : CompilerBackendRuntimeIndex]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [globals-buf : text_buf.TextBuf]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendBuffer
  (let
    [collections : CompilerBackendProgramCollections
      (compiler-backend-collect-source-path-strings
        (compiler-backend-collect-program-collections
          type-segment-bases
          program)
        spans)]
    [closure-names : BackendSymbolSeq
      (compiler-backend-program-collections-functions collections)]
    [strings : BackendStringSeq
      (compiler-backend-program-collections-strings collections)]
    [bytes : BackendStringSeq
      (compiler-backend-program-collections-bytes collections)]
    [floats : BackendFloatList
      (compiler-backend-program-collections-floats collections)]
    [uses-avx2-i64-lane-id : bool
      (compiler-backend-program-collections-uses-avx2-i64-lane-id? collections)]
    [uses-avx512-i64-lane-id : bool
      (compiler-backend-program-collections-uses-avx512-i64-lane-id?
        collections)]
    [uses-f64-neg : bool
      (compiler-backend-program-collections-uses-f64-neg? collections)]
    [span-index : CompilerBackendSourceSpanIndex
      (compiler-backend-source-span-index-build spans)]
    [global-types : CompilerBackendGlobalTypeList
      (compiler-backend-global-types globals)]
    [runtime-features : runtime_common.CompilerBackendRuntimeFeatures
      (compiler-backend-runtime-features plan)]
    (begin
      (cfg
        compile-profile
        (compiler-backend-profile-finish
          (struct-get program-index profile-state)
          "collect"))
      (cfg
        compile-profile
        (compiler-backend-profile-start
          (struct-get program-index profile-state)))
      (let
        [base-prefix-buf : text_buf.TextBuf
          (compiler-backend-emit-program-prefix-buffer
            target
            entry-functions
            externs
            plan
            (& runtime-features)
            program-index
            runtime-index
            closure-names
            strings
            bytes
            floats
            uses-avx2-i64-lane-id
            uses-avx512-i64-lane-id
            uses-f64-neg
            globals-buf
            emit-entry
            crt-entry)]
        [prefix-buf : text_buf.TextBuf
          (text_buf.append
            base-prefix-buf
            (compiler-backend-debug-prefix
              target
              entry-functions
              program-index
              span-index))]
        [function-input : text_buf.TextBuf
          (if (compiler-backend-assembly-stream-active?)
            (begin
              (compiler-backend-assembly-stream-process-buffer! prefix-buf)
              (text_buf.empty))
            prefix-buf)]
        (begin
          ;; This window previously started at the "collect" finish and was
          ;; overwritten by the next start without ever being reported,
          ;; hiding the prefix composition from the phase breakdown.
          (cfg
            compile-profile
            (compiler-backend-profile-finish
              (struct-get program-index profile-state)
              "prefix"))
          (cfg
            compile-profile
            (compiler-backend-profile-start
              (struct-get program-index profile-state)))
          (match (compiler-backend-emit-functions-buffer-into
            type-segment-bases
            target
            mode
            entry-functions
            entry-functions
            globals
            global-types
            externs
            plan
            program-index
            spans
            span-index
            emit-entry
            crt-entry
            function-input)
            [(ResultCompilerBackendBuffer.Ok with-functions)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-finish
                    (struct-get program-index profile-state)
                    "functions"))
                (cfg
                  compile-profile-summary
                  (compiler-backend-profile-summary-emit
                    (struct-get program-index profile-state)))
                (cfg
                  compile-profile
                  (compiler-backend-profile-start
                    (struct-get program-index profile-state)))
                (match (compiler-backend-emit-closure-entry-adapters-buffer-into
                  type-segment-bases
                  target
                  closure-names
                  entry-functions
                  externs
                  plan
                  program-index
                  (text_buf.append
                    with-functions
                    (compiler-backend-debug-trailer
                      target
                      entry-functions
                      program-index)))
                  [(ResultCompilerBackendBuffer.Ok with-adapters)
                    (begin
                      (cfg
                        compile-profile
                        (compiler-backend-profile-finish
                          (struct-get program-index profile-state)
                          "adapters"))
                      (cfg
                        compile-profile
                        (compiler-backend-profile-start
                          (struct-get program-index profile-state)))
                      (let
                        [buf : text_buf.TextBuf
                          (text_buf.append
                            (text_buf.append
                              with-adapters
                              (if emit-entry
                                (compiler-backend-runtime-functions-for-target
                                  target
                                  (& runtime-features))
                                ""))
                            (if emit-entry
                              (compiler-backend-entry-for-target-with-crt
                                type-segment-bases
                                target
                                plan
                                globals
                                crt-entry
                                program-index)
                              ""))]
                        (begin
                          (cfg
                            compile-profile
                            (compiler-backend-profile-finish
                              (struct-get program-index profile-state)
                              "compose_tail"))
                          (cfg
                            regalloc-census
                            (begin
                              (compiler-reg-call-span-census-print!)
                              (compiler-reg-move-census-print!)
                              (io.print-error
                                (str_cat.str-cat
                                  "rsp-rebase|ok="
                                  (string.int->string
                                    compiler-backend-rsp-rebase-ok-count)
                                  "|keep-rbp="
                                  (string.int->string
                                    compiler-backend-rsp-rebase-keep-count)
                                  "|fpo="
                                  (string.int->string
                                    compiler-backend-fpo-count)
                                  (str_cat.str-cat
                                    "|rbp-pool="
                                    (string.int->string
                                      compiler-backend-fpo-rbp-plan-count)
                                    "|demote="
                                    (string.int->string
                                      compiler-backend-fpo-demote-count)
                                    "|push="
                                    (string.int->string
                                      compiler-backend-fpo-push-count)
                                    "\n"
                                    "")))
                              (io.print-error
                                (str_cat.str-cat
                                  "phi-xmm-cycle|register="
                                  (string.int->string
                                    compiler-backend-phi-xmm-cycle-register-count)
                                  "|fallback="
                                  (string.int->string
                                    compiler-backend-phi-xmm-cycle-fallback-count)
                                  "\n"
                                  ""))
                              (io.print-error
                                (str_cat.str-cat
                                  "peephole-r10-dead-scan|cap="
                                  (string.int->string
                                    compiler-backend-peephole-r10-dead-scan-line-cap)
                                  "|cap-hits="
                                  (string.int->string
                                    compiler-backend-peephole-r10-dead-scan-cap-hits)
                                  "\n"
                                  ""))))
                          (cfg
                            scavenge-census
                            (compiler-backend-scavenge-census-print!))
                          (ResultCompilerBackendBuffer.Ok
                            (if (compiler-backend-assembly-stream-active?)
                              (begin
                                (compiler-backend-assembly-stream-process-buffer!
                                  buf)
                                (compiler-backend-assembly-stream-output))
                              buf)))))]
                  [(ResultCompilerBackendBuffer.Err message)
                    (begin
                      (cfg
                        compile-profile
                        (compiler-backend-profile-finish
                          (struct-get program-index profile-state)
                          "adapters"))
                      (ResultCompilerBackendBuffer.Err message))]))]
            [(ResultCompilerBackendBuffer.Err message)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-finish
                    (struct-get program-index profile-state)
                    "functions"))
                (cfg
                  compile-profile-summary
                  (compiler-backend-profile-summary-emit
                    (struct-get program-index profile-state)))
                (ResultCompilerBackendBuffer.Err message))]))))))

(define (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [pic-emit? : bool]
  [profile-state : profile_state.CompilerProfileState]) : ResultCompilerBackendBuffer
  (begin
    (compiler-backend-user-symbol-cache-reset!)
    (compiler-backend-peephole-carry-safe-reset!)
    (set! compiler-backend-abort-site-counter 0)
    (compiler-backend-set-absolute-switch-ok!
      (and (not pic-emit?) (not (compiler-backend-target-windows? target))))
    (set! compiler-backend-rsp-rebase-ok-count 0)
    (set! compiler-backend-rsp-rebase-keep-count 0)
    (set! compiler-backend-fpo-count 0)
    (set! compiler-backend-fpo-rbp-plan-count 0)
    (set! compiler-backend-fpo-demote-count 0)
    (set! compiler-backend-fpo-push-count 0)
    (set! compiler-backend-peephole-r10-dead-scan-cap-hits 0)
    (set! compiler-backend-phi-xmm-cycle-register-count 0)
    (set! compiler-backend-phi-xmm-cycle-fallback-count 0)
    ;; GAP5: clear the post-emission dead-frame-store sweep metadata before
    ;; recording this program's FPO functions (a stale entry from a prior
    ;; program emit in the same process must not leak into the sweep).
    (compiler-backend-sweep-reset!)
    (cfg
      regalloc-census
      (begin
        (compiler-reg-call-span-census-reset!)
        (compiler-reg-move-census-reset!)))
    (cfg scavenge-census (compiler-backend-scavenge-census-reset!))
    (cfg compile-profile (compiler-backend-profile-start profile-state))
    (match (compiler-backend-runtime-plan-with-index program)
      [(ResultBackendRuntimePlanWithIndex.Ok planned)
        (let
          [plan : CompilerBackendRuntimePlan (struct-get planned plan)]
          [runtime-index : CompilerBackendRuntimeIndex
            (struct-get planned index)]
          (begin
            (cfg
              compile-profile
              (compiler-backend-profile-finish profile-state "runtime_plan"))
            (cfg compile-profile (compiler-backend-profile-start profile-state))
            (match program
              [(CompilerIrProgram.Program globals functions externs)
                ;; Build the program index ONCE over the entry function list
                ;; and share it with the globals emission: each build walks
                ;; every function body for the register-group counts, so the
                ;; former second build doubled both that walk and its ~120MB
                ;; of transient allocation. The entry list is a superset of
                ;; `functions` (at most the synthesized implicit main, which
                ;; no global initializer can reference), so globals resolve
                ;; identically against the shared index.
                (let
                  [entry-functions : CompilerIrFunctionList
                    (compiler-backend-functions-with-implicit-main
                      functions
                      emit-entry)]
                  [program-index : CompilerBackendProgramIndex
                    (compiler-backend-program-index-build-with-profile-state
                      type-segment-bases
                      entry-functions
                      externs
                      profile-state)]
                  (begin
                    (cfg
                      compile-profile
                      (compiler-backend-profile-finish profile-state "index"))
                    (cfg
                      compile-profile
                      (compiler-backend-profile-start profile-state))
                    (match (compiler-backend-emit-globals-buffer-into
                      type-segment-bases
                      target
                      globals
                      (text_buf.append (text_buf.empty) ".data\n")
                      program-index)
                      [(ResultCompilerBackendBuffer.Ok globals-buf)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-backend-profile-finish
                              profile-state
                              "globals"))
                          (cfg
                            compile-profile
                            (compiler-backend-profile-start profile-state))
                          (match (compiler-backend-validate-function-symbols
                            globals
                            entry-functions
                            externs
                            plan
                            program-index)
                            [(ResultCompilerBackendSymbolValidation.Ok _)
                              (compiler-backend-emit-program-buffer-after-index
                                type-segment-bases
                                program
                                target
                                mode
                                entry-functions
                                globals
                                externs
                                plan
                                runtime-index
                                program-index
                                spans
                                globals-buf
                                emit-entry
                                crt-entry)]
                            [(ResultCompilerBackendSymbolValidation.Err message)
                              (ResultCompilerBackendBuffer.Err message)]))]
                      [(ResultCompilerBackendBuffer.Err message)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-backend-profile-finish
                              profile-state
                              "globals"))
                          (ResultCompilerBackendBuffer.Err message))])))])))]
      [(ResultBackendRuntimePlanWithIndex.Err message)
        (begin
          (cfg
            compile-profile
            (compiler-backend-profile-finish profile-state "runtime_plan"))
          (ResultCompilerBackendBuffer.Err
            (box (compiler-diagnostic-at-start "" message))))])))

(define (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [pic-emit? : bool]) : ResultCompilerBackendBuffer
  (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state
    type-segment-bases
    program
    target
    mode
    spans
    emit-entry
    crt-entry
    pic-emit?
    (profile_state.compiler-profile-state-new)))

(define (compiler-backend-emit-program-target-with-mode-buffer-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [pic-emit? : bool]) : ResultCompilerBackendBuffer
  (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt
    (ast-node-pool-reader-type-segment-bases)
    program
    target
    mode
    spans
    emit-entry
    crt-entry
    pic-emit?))

(define (compiler-backend-object-value-ref
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [value : CompilerIrValue]) : object_target.CompilerBackendObjectTargetParts
  (match value
    [(CompilerIrValue.Global name)
      (let
        [symbol : String (compiler-backend-user-symbol-id name)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipValue)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRip symbol)))]
    [(CompilerIrValue.GlobalAddr name)
      (let
        [symbol : String (compiler-backend-user-symbol-id name)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [(CompilerIrValue.String text)
      (let
        [symbol : String (compiler-backend-string-fat-label text)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [(CompilerIrValue.Bytes text)
      (let
        [symbol : String (compiler-backend-bytes-fat-label text)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [(CompilerIrValue.F64 bits)
      (let
        [symbol : String (compiler-backend-f64-label bits)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipValue)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRip symbol)))]
    [(CompilerIrValue.Function name)
      (let
        [symbol : String
          (compiler-backend-closure-descriptor-label
            (compiler-ir-symbol-text name))]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [_ parts]))

(define (compiler-backend-object-value-ref-with-type
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [value : CompilerIrValue]
  [ty : AstType]) : object_target.CompilerBackendObjectTargetParts
  (match value
    [(CompilerIrValue.F64 bits)
      (let
        [symbol : String (compiler-backend-float-label ty bits)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipValue)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRip symbol)))]
    [_ (compiler-backend-object-value-ref parts site value)]))

(define (compiler-backend-object-call-args
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [args : CompilerIrCallArgs]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (compiler-backend-call-args-count args))
    parts
    (compiler-backend-object-call-args
      (compiler-backend-object-value-ref
        parts
        site
        (compiler-backend-call-arg-at args index))
      site
      args
      (+ index 1))))

(define (compiler-backend-object-spmd-call-args
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [args : CompilerIrSpmdCallArgList]) : object_target.CompilerBackendObjectTargetParts
  (match args
    [(CompilerIrSpmdCallArgList.Nil) parts]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (compiler-backend-object-spmd-call-args
            (compiler-backend-object-value-ref parts site value)
            site
            (box-get rest))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : object_target.CompilerBackendObjectTargetParts parts]
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(CompilerIrSpmdCallArg.Arg _ value _)
                  (set! out (compiler-backend-object-value-ref out site value))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-backend-object-value-list-ref
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [values : CompilerIrValueList]) : object_target.CompilerBackendObjectTargetParts
  (match values
    [(CompilerIrValueList.Nil) parts]
    [(CompilerIrValueList.Array seq)
      (compiler-backend-object-value-list-ref
        parts
        site
        (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (compiler-backend-object-value-list-ref
        (compiler-backend-object-value-ref parts site value)
        site
        (box-get rest))]))

(define (compiler-backend-object-byte [value : i64]) : u8
  (cast (bit-and value 0xff) : u8))

;; Private hot object-code fragments use the narrow append-only ByteBuf core.
(define (compiler-backend-object-push-u8!
  [out : (&mut out byte_buf_core.ByteBufBuilder)]
  [value : i64]) : unit
  (byte_buf_core.byte-buf-builder-push out (compiler-backend-object-byte value)))

(define (compiler-backend-object-push-u32!
  [out : (&mut out byte_buf_core.ByteBufBuilder)]
  [value : i64]) : unit
  (begin
    (compiler-backend-object-push-u8! out value)
    (compiler-backend-object-push-u8! out (shr value 8))
    (compiler-backend-object-push-u8! out (shr value 16))
    (compiler-backend-object-push-u8! out (shr value 24))))

(define (compiler-backend-object-bytes-finish
  [out : (& out byte_buf_core.ByteBufBuilder)]) : String
  (byte_buf_core.byte-buf-builder-finish-string out))

(define (compiler-backend-object-add-nonempty-bytes
  [parts : object_target.CompilerBackendObjectTargetParts]
  [bytes : String]) : object_target.CompilerBackendObjectTargetParts
  (if (= (string.string-length bytes) 0)
    parts
    (object_target.compiler-backend-object-add-text
      parts
      (cobj.CompilerObjectX64Instr.Bytes bytes))))

(define (compiler-backend-object-reg-low-code [reg : String]) : i64
  (cond
    [(or (string.eq reg "%rax") (string.eq reg "%r8")) 0]
    [(or (string.eq reg "%rcx") (string.eq reg "%r9")) 1]
    [(or (string.eq reg "%rdx") (string.eq reg "%r10")) 2]
    [(or (string.eq reg "%rbx") (string.eq reg "%r11")) 3]
    [(or (string.eq reg "%rsp") (string.eq reg "%r12")) 4]
    [(or (string.eq reg "%rbp") (string.eq reg "%r13")) 5]
    [(or (string.eq reg "%rsi") (string.eq reg "%r14")) 6]
    [else 7]))

(define (compiler-backend-object-reg-high? [reg : String]) : bool
  (or
    (string.eq reg "%r8")
    (string.eq reg "%r9")
    (string.eq reg "%r10")
    (string.eq reg "%r11")
    (string.eq reg "%r12")
    (string.eq reg "%r13")
    (string.eq reg "%r14")
    (string.eq reg "%r15")))

(define (compiler-backend-object-slot-disp [var-id : i64]) : i64
  (- 0 (* 8 (+ var-id 1))))

(define (compiler-backend-object-disp8? [disp : i64]) : bool
  (and (>= disp -128) (<= disp 127)))

(define (compiler-backend-object-load-rbp-disp-bytes
  [disp : i64]
  [reg : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
    [rex : i64
      (+
        0x48
        (if (compiler-backend-object-reg-high? reg)
          4
          0))]
    (begin
      (compiler-backend-object-push-u8! (&mut out) rex)
      (compiler-backend-object-push-u8! (&mut out) 0x8b)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x45 (* reg-code 8)))
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x85 (* reg-code 8)))
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-store-slot-bytes [var-id : i64] [reg : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [disp : i64 (compiler-backend-object-slot-disp var-id)]
    [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
    [rex : i64
      (+
        0x48
        (if (compiler-backend-object-reg-high? reg)
          4
          0))]
    (begin
      (compiler-backend-object-push-u8! (&mut out) rex)
      (compiler-backend-object-push-u8! (&mut out) 0x89)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x45 (* reg-code 8)))
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x85 (* reg-code 8)))
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-mov-imm32-reg-bytes
  [value : i64]
  [reg : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
    [rex : i64
      (+
        0x48
        (if (compiler-backend-object-reg-high? reg)
          1
          0))]
    (begin
      (compiler-backend-object-push-u8! (&mut out) rex)
      (compiler-backend-object-push-u8! (&mut out) 0xc7)
      (compiler-backend-object-push-u8! (&mut out) (+ 0xc0 reg-code))
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-mov-reg-reg-bytes
  [src : String]
  [dst : String]) : String
  (if (string.eq src dst)
    ""
    (let
      [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
      [src-code : i64 (compiler-backend-object-reg-low-code src)]
      [dst-code : i64 (compiler-backend-object-reg-low-code dst)]
      [rex : i64
        (+
          0x48
          (+
            (if (compiler-backend-object-reg-high? src)
              4
              0)
            (if (compiler-backend-object-reg-high? dst)
              1
              0)))]
      (begin
        (compiler-backend-object-push-u8! (&mut out) rex)
        (compiler-backend-object-push-u8! (&mut out) 0x89)
        (compiler-backend-object-push-u8!
          (&mut out)
          (+ 0xc0 (+ (* src-code 8) dst-code)))
        (compiler-backend-object-bytes-finish (& out))))))

(define (compiler-backend-object-push-sub-rsp!
  [out : (&mut out byte_buf_core.ByteBufBuilder)]
  [amount : i64]) : unit
  (if (<= amount 127)
    (begin
      (compiler-backend-object-push-u8! out 0x48)
      (compiler-backend-object-push-u8! out 0x83)
      (compiler-backend-object-push-u8! out 0xec)
      (compiler-backend-object-push-u8! out amount))
    (begin
      (compiler-backend-object-push-u8! out 0x48)
      (compiler-backend-object-push-u8! out 0x81)
      (compiler-backend-object-push-u8! out 0xec)
      (compiler-backend-object-push-u32! out amount))))

(define (compiler-backend-object-prologue-bytes
  [target : CompilerBackendTarget]
  [frame-size : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [probe : bool
      (match target
        [(CompilerBackendTarget.Windows) (>= frame-size 4096)]
        [_ false])]
    [remaining : i64 frame-size]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x55)
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x89)
      (compiler-backend-object-push-u8! (&mut out) 0xe5)
      (if (= frame-size 0)
        unit
        (if probe
          ;; Windows guard-page discipline: a frame that skips past the
          ;; single guard page faults, so large frames extend the stack one
          ;; page at a time with a touch per page (the inline equivalent of
          ;; the asm path's __chkstk call, which mapped images cannot make).
          (begin
            (while (> remaining 4096)
              (begin
                (compiler-backend-object-push-sub-rsp! (&mut out) 4096)
                ;; orl $0, (%rsp)
                (compiler-backend-object-push-u8! (&mut out) 0x83)
                (compiler-backend-object-push-u8! (&mut out) 0x0c)
                (compiler-backend-object-push-u8! (&mut out) 0x24)
                (compiler-backend-object-push-u8! (&mut out) 0x00)
                (set! remaining (- remaining 4096))))
            (if (> remaining 0)
              (compiler-backend-object-push-sub-rsp! (&mut out) remaining)
              unit))
          (compiler-backend-object-push-sub-rsp! (&mut out) frame-size)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-leave-ret-bytes) : String
  (object_target.compiler-backend-object-bytes-from-hex "c9c3"))

(define (compiler-backend-object-zero-eax-bytes) : String
  (object_target.compiler-backend-object-bytes-from-hex "31c0"))

(define (compiler-backend-object-rsp-imm-bytes [opcode : i64] [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (if (<= value 127)
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x48)
          (compiler-backend-object-push-u8! (&mut out) 0x83)
          (compiler-backend-object-push-u8! (&mut out) opcode)
          (compiler-backend-object-push-u8! (&mut out) value))
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x48)
          (compiler-backend-object-push-u8! (&mut out) 0x81)
          (compiler-backend-object-push-u8! (&mut out) opcode)
          (compiler-backend-object-push-u32! (&mut out) value)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-sub-rsp-bytes [value : i64]) : String
  (if (= value 0)
    ""
    (compiler-backend-object-rsp-imm-bytes 0xec value)))

(define (compiler-backend-object-unop-rax-bytes [op : CompilerIrUnOp]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (match op
        [(CompilerIrUnOp.Neg)
          (begin
            (compiler-backend-object-push-u8! (&mut out) 0x48)
            (compiler-backend-object-push-u8! (&mut out) 0xf7)
            (compiler-backend-object-push-u8! (&mut out) 0xd8))]
        [(CompilerIrUnOp.Not)
          (begin
            (compiler-backend-object-push-u8! (&mut out) 0x48)
            (compiler-backend-object-push-u8! (&mut out) 0x83)
            (compiler-backend-object-push-u8! (&mut out) 0xf0)
            (compiler-backend-object-push-u8! (&mut out) 0x01))]
        [(CompilerIrUnOp.BitNot)
          (begin
            (compiler-backend-object-push-u8! (&mut out) 0x48)
            (compiler-backend-object-push-u8! (&mut out) 0xf7)
            (compiler-backend-object-push-u8! (&mut out) 0xd0))]
        [(CompilerIrUnOp.Sqrt) unit])
      (byte_buf_core.byte-buf-builder-finish-string (& out)))))

(define (compiler-backend-object-call-r11-bytes) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x41)
      (compiler-backend-object-push-u8! (&mut out) 0xff)
      (compiler-backend-object-push-u8! (&mut out) 0xd3)
      (byte_buf_core.byte-buf-builder-finish-string (& out)))))

(define (compiler-backend-object-add-rsp-bytes [value : i64]) : String
  (if (= value 0)
    ""
    (compiler-backend-object-rsp-imm-bytes 0xc4 value)))

(define (compiler-backend-object-store-rax-rsp-bytes [disp : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x89)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x44)
          (compiler-backend-object-push-u8! (&mut out) 0x24)
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x84)
          (compiler-backend-object-push-u8! (&mut out) 0x24)
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-load-rax-rsp-bytes [disp : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x8b)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x44)
          (compiler-backend-object-push-u8! (&mut out) 0x24)
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x84)
          (compiler-backend-object-push-u8! (&mut out) 0x24)
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-load-rax-pointee-bytes
  [type-segment-bases : i64]
  [ty : AstType]) : String
  (let
    [size : i64 (compiler-backend-type-size type-segment-bases ty)]
    [signed : bool (compiler-backend-type-signed? ty)]
    (cond
      [(= size 8)
        (object_target.compiler-backend-object-bytes-from-hex "488b00")]
      [(= size 4)
        (if signed
          (object_target.compiler-backend-object-bytes-from-hex "486300")
          (object_target.compiler-backend-object-bytes-from-hex "8b00"))]
      [(= size 2)
        (if signed
          (object_target.compiler-backend-object-bytes-from-hex "480fbf00")
          (object_target.compiler-backend-object-bytes-from-hex "0fb700"))]
      [(= size 1)
        (if signed
          (object_target.compiler-backend-object-bytes-from-hex "480fbe00")
          (object_target.compiler-backend-object-bytes-from-hex "0fb600"))]
      [else (object_target.compiler-backend-object-bytes-from-hex "488b00")])))

(define (compiler-backend-object-leave-bytes) : String
  (object_target.compiler-backend-object-bytes-from-hex "c9"))

(define (compiler-backend-object-load-value-to-reg
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [value : CompilerIrValue]
  [reg : String]) : object_target.CompilerBackendObjectTargetParts
  (match value
    [(CompilerIrValue.Var id)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-load-rbp-disp-bytes
          (compiler-backend-object-slot-disp id)
          reg))]
    [(CompilerIrValue.I64 n)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes n reg))]
    [(CompilerIrValue.Bool b)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes
          (if b
            1
            0)
          reg))]
    [(CompilerIrValue.Char c)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes
          (compiler-backend-char-code c)
          reg))]
    [(CompilerIrValue.Unit)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes 0 reg))]
    [(CompilerIrValue.Global _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.GlobalAddr _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.String _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.Bytes _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.Function _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.F64 _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.RuntimeGlobal _) parts]))

(define (compiler-backend-object-load-value-to-reg-with-type
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [value : CompilerIrValue]
  [ty : AstType]
  [reg : String]) : object_target.CompilerBackendObjectTargetParts
  (match value
    [(CompilerIrValue.F64 _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref-with-type parts site value ty)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [_ (compiler-backend-object-load-value-to-reg parts site value reg)]))

(define (compiler-backend-object-store-reg-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [dst : i64]
  [reg : String]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-add-nonempty-bytes
    parts
    (compiler-backend-object-store-slot-bytes dst reg)))

(define (compiler-backend-object-move-value-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-store-reg-to-var
    (compiler-backend-object-load-value-to-reg-with-type
      parts
      site
      src
      ty
      "%rax")
    dst
    "%rax"))

(define (compiler-backend-object-group-word-var [var : i64] [word-index : i64]) : i64
  (if (= word-index 0)
    var
    (+ compiler-backend-current-slot-vars var)))

(define (compiler-backend-object-load-group-word-to-reg
  [parts : object_target.CompilerBackendObjectTargetParts]
  [var : i64]
  [word-index : i64]
  [reg : String]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-add-nonempty-bytes
    parts
    (compiler-backend-object-load-rbp-disp-bytes
      (compiler-backend-object-slot-disp
        (compiler-backend-object-group-word-var var word-index))
      reg)))

(define (compiler-backend-object-store-reg-to-group-word
  [parts : object_target.CompilerBackendObjectTargetParts]
  [var : i64]
  [word-index : i64]
  [reg : String]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-add-nonempty-bytes
    parts
    (compiler-backend-object-store-slot-bytes
      (compiler-backend-object-group-word-var var word-index)
      reg)))

(define (compiler-backend-object-move-group-value-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [src : CompilerIrValue]) : object_target.CompilerBackendObjectTargetParts
  (match src
    [(CompilerIrValue.Var src-var)
      (compiler-backend-object-store-reg-to-group-word
        (compiler-backend-object-store-reg-to-group-word
          (compiler-backend-object-load-group-word-to-reg
            (compiler-backend-object-load-group-word-to-reg
              parts
              src-var
              0
              "%rax")
            src-var
            1
            "%rdx")
          dst
          0
          "%rax")
        dst
        1
        "%rdx")]
    [_ (compiler-backend-object-value-ref parts site src)]))

(define (compiler-backend-object-pack-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [words : CompilerIrValueList]) : object_target.CompilerBackendObjectTargetParts
  (match (compiler-ir-value-list-force-cons words)
    [(CompilerIrValueList.Cons word0 rest0)
      (match (compiler-ir-value-list-force-cons (box-get rest0))
        [(CompilerIrValueList.Cons word1 _)
          (compiler-backend-object-store-reg-to-group-word
            (compiler-backend-object-store-reg-to-group-word
              (compiler-backend-object-load-value-to-reg
                (compiler-backend-object-load-value-to-reg
                  parts
                  site
                  word0
                  "%rax")
                site
                word1
                "%rdx")
              dst
              0
              "%rax")
            dst
            1
            "%rdx")]
        [_ (compiler-backend-object-value-list-ref parts site words)])]
    [_ (compiler-backend-object-value-list-ref parts site words)]))

(define (compiler-backend-object-word-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [src : CompilerIrValue]
  [word-index : i64]) : object_target.CompilerBackendObjectTargetParts
  (match src
    [(CompilerIrValue.Var src-var)
      (compiler-backend-object-store-reg-to-var
        (compiler-backend-object-load-group-word-to-reg
          parts
          src-var
          word-index
          "%rax")
        dst
        "%rax")]
    [_ (compiler-backend-object-value-ref parts site src)]))

(define (compiler-backend-object-load-ptr-to-var
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-store-reg-to-var
    (compiler-backend-object-add-nonempty-bytes
      (compiler-backend-object-load-value-to-reg parts site src "%rax")
      (compiler-backend-object-load-rax-pointee-bytes type-segment-bases ty))
    dst
    "%rax"))

(define (compiler-backend-object-sub-imm32-rax-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x2d)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-add-imm32-rax-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x05)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-imul-imm32-r8-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x4d)
      (compiler-backend-object-push-u8! (&mut out) 0x69)
      (compiler-backend-object-push-u8! (&mut out) 0xc0)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-add-r8-rax-bytes) : String
  (object_target.compiler-backend-object-bytes-from-hex "4c01c0"))

(define (compiler-backend-object-gep-to-var
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]) : object_target.CompilerBackendObjectTargetParts
  (let
    [elem-size : i64 (compiler-backend-type-size type-segment-bases elem-ty)]
    [with-base : object_target.CompilerBackendObjectTargetParts
      (compiler-backend-object-load-value-to-reg parts site base "%rax")]
    [with-offset : object_target.CompilerBackendObjectTargetParts
      (match offset
        [(CompilerIrValue.I64 n)
          (let
            [disp : i64 (* n elem-size)]
            (if (= disp 0)
              with-base
              (compiler-backend-object-add-nonempty-bytes
                with-base
                (compiler-backend-object-add-imm32-rax-bytes disp))))]
        [_
          (compiler-backend-object-add-nonempty-bytes
            (if (= elem-size 1)
              (compiler-backend-object-load-value-to-reg
                with-base
                site
                offset
                "%r8")
              (compiler-backend-object-add-nonempty-bytes
                (compiler-backend-object-load-value-to-reg
                  with-base
                  site
                  offset
                  "%r8")
                (compiler-backend-object-imul-imm32-r8-bytes elem-size)))
            (compiler-backend-object-add-r8-rax-bytes))])]
    (compiler-backend-object-store-reg-to-var with-offset dst "%rax")))

(define (compiler-backend-object-cmp-imm32-rax-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x3d)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-switch-indirect-jump-bytes) : String
  (object_target.compiler-backend-object-bytes-from-hex "49ff24c3"))

(define (compiler-backend-object-switch-entry-label
  [table-label : String]
  [index : i64]) : String
  (string.append
    (string.append table-label "_entry_")
    (string.int->string index)))

(define (compiler-backend-object-switch-table-cases
  [parts : object_target.CompilerBackendObjectTargetParts]
  [label-scope : String]
  [table-label : String]
  [cases : CompilerIrSwitchCaseList]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (match cases
    [(CompilerIrSwitchCaseList.Nil) parts]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case _ label)
          (let
            [entry-label : String
              (compiler-backend-object-switch-entry-label table-label index)]
            [target : String (compiler-backend-asm-label label-scope label)]
            (compiler-backend-object-switch-table-cases
              (object_target.compiler-backend-object-add-rodata
                (object_target.compiler-backend-object-add-rodata-relocation
                  (object_target.compiler-backend-object-add-rodata
                    parts
                    (cobj.CompilerObjectDataRecord.Label entry-label))
                  entry-label
                  (cobj.CompilerObjectRelocationKind.Abs64)
                  target)
                (cobj.CompilerObjectDataRecord.SymbolAddress target))
              label-scope
              table-label
              (box-get rest)
              (+ index 1)))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (compiler-backend-object-switch-table-cases
        parts
        label-scope
        table-label
        (compiler-ir-switch-case-seq-to-list seq)
        index)]))

(define (compiler-backend-object-switch-table
  [parts : object_target.CompilerBackendObjectTargetParts]
  [label-scope : String]
  [current-label : i64]
  [cases : CompilerIrSwitchCaseList]) : object_target.CompilerBackendObjectTargetParts
  (let
    [table-label : String
      (compiler-backend-switch-table-label label-scope current-label)]
    (compiler-backend-object-switch-table-cases
      (object_target.compiler-backend-object-add-rodata
        (object_target.compiler-backend-object-add-rodata
          (object_target.compiler-backend-object-symbol-local-section
            parts
            table-label
            (cobj.CompilerObjectSectionKind.Rodata)
            (cobj.CompilerObjectSymbolKind.Data))
          (cobj.CompilerObjectDataRecord.Align 8))
        (cobj.CompilerObjectDataRecord.Label table-label))
      label-scope
      table-label
      cases
      0)))

(define (compiler-backend-object-switch-dispatch
  [parts : object_target.CompilerBackendObjectTargetParts]
  [function-symbol : String]
  [label-scope : String]
  [current-label : i64]
  [index : CompilerIrValue]
  [base : i64]
  [case-count : i64]
  [default-label : i64]
  [total-switch : bool]) : object_target.CompilerBackendObjectTargetParts
  (let
    [default-symbol : String
      (compiler-backend-asm-label label-scope default-label)]
    [table-label : String
      (compiler-backend-switch-table-label label-scope current-label)]
    [with-index : object_target.CompilerBackendObjectTargetParts
      (compiler-backend-object-load-value-to-reg
        parts
        function-symbol
        index
        "%rax")]
    [with-base : object_target.CompilerBackendObjectTargetParts
      (if (= base 0)
        with-index
        (object_target.compiler-backend-object-add-text
          with-index
          (cobj.CompilerObjectX64Instr.Bytes
            (compiler-backend-object-sub-imm32-rax-bytes base))))]
    [with-cmp : object_target.CompilerBackendObjectTargetParts
      (if total-switch
        with-base
        (object_target.compiler-backend-object-add-text
          with-base
          (cobj.CompilerObjectX64Instr.Bytes
            (compiler-backend-object-cmp-imm32-rax-bytes (- case-count 1)))))]
    [with-ja : object_target.CompilerBackendObjectTargetParts
      (if total-switch
        with-cmp
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            with-cmp
            function-symbol
            (cobj.CompilerObjectRelocationKind.Branch)
            default-symbol)
          (cobj.CompilerObjectX64Instr.Ja default-symbol)))]
    [with-table : object_target.CompilerBackendObjectTargetParts
      (object_target.compiler-backend-object-add-text
        (object_target.compiler-backend-object-add-text-relocation
          with-ja
          function-symbol
          (cobj.CompilerObjectRelocationKind.RipAddress)
          table-label)
        (cobj.CompilerObjectX64Instr.LoadRipAddressR11 table-label))]
    (object_target.compiler-backend-object-add-text
      with-table
      (cobj.CompilerObjectX64Instr.Bytes
        (compiler-backend-object-switch-indirect-jump-bytes)))))

(define (compiler-backend-object-switch
  [parts : object_target.CompilerBackendObjectTargetParts]
  [function-symbol : String]
  [label-scope : String]
  [current-label : i64]
  [index : CompilerIrValue]
  [base : i64]
  [cases : CompilerIrSwitchCaseList]
  [default-label : i64]) : object_target.CompilerBackendObjectTargetParts
  (let
    ;; Decide before the table walker consumes its case-list cursor.
    [total-switch : bool
      (compiler-backend-object-total-switch? base cases default-label)]
    [case-count : i64 (compiler-backend-switch-case-count cases)]
    (compiler-backend-object-switch-dispatch
      (compiler-backend-object-switch-table
        parts
        label-scope
        current-label
        cases)
      function-symbol
      label-scope
      current-label
      index
      base
      case-count
      default-label
      total-switch)))

(define (compiler-backend-object-binop-bytes [op : CompilerIrBinOp]) : String
  (match op
    [(CompilerIrBinOp.Add)
      (object_target.compiler-backend-object-bytes-from-hex "4c01c0")]
    [(CompilerIrBinOp.Sub)
      (object_target.compiler-backend-object-bytes-from-hex "4c29c0")]
    [(CompilerIrBinOp.Mul)
      (object_target.compiler-backend-object-bytes-from-hex "490fafc0")]
    [(CompilerIrBinOp.Eq)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f94c0480fb6c0")]
    [(CompilerIrBinOp.Ne)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f95c0480fb6c0")]
    [(CompilerIrBinOp.Lt)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f9cc0480fb6c0")]
    [(CompilerIrBinOp.Le)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f9ec0480fb6c0")]
    [(CompilerIrBinOp.Gt)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f9fc0480fb6c0")]
    [(CompilerIrBinOp.Ge)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f9dc0480fb6c0")]
    [(CompilerIrBinOp.BitTestEq)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c85c00f94c0480fb6c0")]
    [(CompilerIrBinOp.BitTestNe)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c85c00f95c0480fb6c0")]
    [(CompilerIrBinOp.And)
      (object_target.compiler-backend-object-bytes-from-hex "4c21c0")]
    [(CompilerIrBinOp.Or)
      (object_target.compiler-backend-object-bytes-from-hex "4c09c0")]
    [(CompilerIrBinOp.BitAnd)
      (object_target.compiler-backend-object-bytes-from-hex "4c21c0")]
    [(CompilerIrBinOp.BitOr)
      (object_target.compiler-backend-object-bytes-from-hex "4c09c0")]
    [(CompilerIrBinOp.BitXor)
      (object_target.compiler-backend-object-bytes-from-hex "4c31c0")]
    [_ ""]))

(define (compiler-backend-object-zero-compare-bytes [op : CompilerIrBinOp]) : String
  (match op
    [(CompilerIrBinOp.Eq)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c85c00f94c0480fb6c0")]
    [(CompilerIrBinOp.Ne)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c85c00f95c0480fb6c0")]
    [(CompilerIrBinOp.Lt)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c85c00f9cc0480fb6c0")]
    [(CompilerIrBinOp.Le)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c85c00f9ec0480fb6c0")]
    [(CompilerIrBinOp.Gt)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c85c00f9fc0480fb6c0")]
    [(CompilerIrBinOp.Ge)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c85c00f9dc0480fb6c0")]
    [_ ""]))

(define (compiler-backend-object-binop
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : object_target.CompilerBackendObjectTargetParts
  (let
    [op-bytes : String
      (if (match rhs
        [(CompilerIrValue.I64 value)
          (and (= value 0) (compiler-backend-compare-uses-zero-test? op))]
        [_ false])
        (compiler-backend-object-zero-compare-bytes op)
        (compiler-backend-object-binop-bytes op))]
    (if (or
      (= (string.string-length op-bytes) 0)
      (compiler-backend-float-type? ty))
      (compiler-backend-object-value-ref-with-type
        (compiler-backend-object-value-ref-with-type parts site lhs ty)
        site
        rhs
        ty)
      (compiler-backend-object-store-reg-to-var
        (compiler-backend-object-add-nonempty-bytes
          (compiler-backend-object-load-value-to-reg
            (compiler-backend-object-load-value-to-reg parts site lhs "%rax")
            site
            rhs
            "%r8")
          op-bytes)
        dst
        "%rax"))))

(define (compiler-backend-object-scalar-select
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [condition : CompilerIrValue]
  [on-true : CompilerIrValue]
  [on-false : CompilerIrValue]) : object_target.CompilerBackendObjectTargetParts
  ;; Object emission keeps scalar vars in frame homes, so fixed temporaries are
  ;; safe here: false -> rax, true -> r8, condition -> r11, then cmovne.
  (compiler-backend-object-store-reg-to-var
    (compiler-backend-object-add-nonempty-bytes
      (compiler-backend-object-load-value-to-reg
        (compiler-backend-object-load-value-to-reg
          (compiler-backend-object-load-value-to-reg parts site on-false "%rax")
          site
          on-true
          "%r8")
        site
        condition
        "%r11")
      (object_target.compiler-backend-object-bytes-from-hex "4d85db490f45c0"))
    dst
    "%rax"))

(define (compiler-backend-object-call-arg-reg
  [target : CompilerBackendTarget]
  [index : i64]) : String
  (match (compiler-backend-target-arg-reg target index)
    [(ResultBackendReg.Ok reg) reg]
    [(ResultBackendReg.Err _) "%rax"]))

(define (compiler-backend-object-call-reg-count
  [target : CompilerBackendTarget]) : i64
  (compiler-backend-call-register-count target))

(define (compiler-backend-object-call-stack-word-count
  [target : CompilerBackendTarget]
  [args : CompilerIrCallArgs]) : i64
  (let
    [count : i64 (compiler-backend-call-args-count args)]
    [regs : i64 (compiler-backend-object-call-reg-count target)]
    (if (> count regs)
      (- count regs)
      0)))

(define (compiler-backend-object-call-space
  [target : CompilerBackendTarget]
  [args : CompilerIrCallArgs]) : i64
  (match target
    [(CompilerBackendTarget.Linux) 0]
    [(CompilerBackendTarget.Windows)
      (compiler-backend-round-up-16
        (+
          (compiler-backend-outgoing-shadow-space target)
          (* 8 (compiler-backend-object-call-stack-word-count target args))))]))

(define (compiler-backend-object-call-stack-arg
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [site : String]
  [value : CompilerIrValue]
  [stack-index : i64]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-add-nonempty-bytes
    (compiler-backend-object-load-value-to-reg parts site value "%rax")
    (compiler-backend-object-store-rax-rsp-bytes
      (compiler-backend-outgoing-stack-arg-offset target stack-index))))

(define (compiler-backend-object-call-arg-moves
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [site : String]
  [args : CompilerIrCallArgs]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (compiler-backend-call-args-count args))
    parts
    (if (>= index (compiler-backend-object-call-reg-count target))
      (match target
        [(CompilerBackendTarget.Linux) parts]
        [(CompilerBackendTarget.Windows)
          (compiler-backend-object-call-arg-moves
            (compiler-backend-object-call-stack-arg
              parts
              target
              site
              (compiler-backend-call-arg-at args index)
              (- index (compiler-backend-object-call-reg-count target)))
            target
            site
            args
            (+ index 1))])
      (compiler-backend-object-call-arg-moves
        (compiler-backend-object-load-value-to-reg
          parts
          site
          (compiler-backend-call-arg-at args index)
          (compiler-backend-object-call-arg-reg target index))
        target
        site
        args
        (+ index 1)))))

(define (compiler-backend-object-direct-call
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [site : String]
  [symbol : String]
  [args : CompilerIrCallArgs]) : object_target.CompilerBackendObjectTargetParts
  (let
    [space : i64 (compiler-backend-object-call-space target args)]
    (compiler-backend-object-add-nonempty-bytes
      (object_target.compiler-backend-object-add-text
        (object_target.compiler-backend-object-add-text-relocation
          (compiler-backend-object-call-arg-moves
            (compiler-backend-object-add-nonempty-bytes
              parts
              (compiler-backend-object-sub-rsp-bytes space))
            target
            site
            args
            0)
          site
          (cobj.CompilerObjectRelocationKind.Call)
          symbol)
        (cobj.CompilerObjectX64Instr.Call symbol))
      (compiler-backend-object-add-rsp-bytes space))))

(define (compiler-backend-object-param-spills
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [params : CompilerIrParamList]
  [int-index : i64]) : object_target.CompilerBackendObjectTargetParts
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) parts]
    [(CompilerIrParamList.Array seq)
      (compiler-backend-object-param-spills
        parts
        target
        (compiler-ir-param-seq-to-list seq)
        int-index)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ ty var-id)
          (if (compiler-backend-float-type? ty)
            (compiler-backend-object-param-spills
              parts
              target
              (box-get rest)
              int-index)
            (if (>= int-index (compiler-backend-object-call-reg-count target))
              (compiler-backend-object-param-spills
                (match target
                  [(CompilerBackendTarget.Linux) parts]
                  [(CompilerBackendTarget.Windows)
                    (compiler-backend-object-store-reg-to-var
                      (compiler-backend-object-add-nonempty-bytes
                        parts
                        (compiler-backend-object-load-rbp-disp-bytes
                          (compiler-backend-incoming-stack-arg-offset
                            target
                            (-
                              int-index
                              (compiler-backend-object-call-reg-count target)))
                          "%rax"))
                      var-id
                      "%rax")])
                target
                (box-get rest)
                (+ int-index 1))
              (compiler-backend-object-param-spills
                (compiler-backend-object-store-reg-to-var
                  parts
                  var-id
                  (compiler-backend-object-call-arg-reg target int-index))
                target
                (box-get rest)
                (+ int-index 1))))])]))

;; --- object-image phi edge copies --------------------------------------------
;;
;; The object emitter assigns every IR var its own rbp slot, so a phi whose
;; destination differs from an input needs a real copy on each incoming edge;
;; materializing the inputs and dropping the destination (the historical Phi
;; case) silently reads an uninitialized slot at the merge. Jump and Branch
;; terminators targeting a block with leading phis emit these copies before
;; transferring control; conditional edges are split into tiny edge blocks so
;; each edge's copies run only when that edge is taken. Copies are staged
;; through the stack (sources first, destinations after) so parallel-copy
;; cycles like a<-b, b<-a cannot clobber a pending source. Aggregate
;; (copy-group) phis keep the previous materialize-only behavior; the tlci
;; image path never lowers those.
(define (compiler-backend-object-phi-copy-list-count
  [copies : CompilerBackendPhiCopySeq]) : i64
  (struct-get copies len))

(define (compiler-backend-object-phi-copy-list-nil?
  [copies : CompilerBackendPhiCopySeq]) : bool
  (= (struct-get copies len) 0))

;; Collected in instruction order; the stage/store walkers read it back to front
;; (compiler-backend-phi-copy-seq-rev-ref) to keep the old prepend order.
(define (compiler-backend-object-edge-phi-copies-scan
  [type-segment-bases : i64]
  [instrs : CompilerIrInstrSeq]
  [program-index : CompilerBackendProgramIndex]
  [from-label : i64]
  [index : i64]) : CompilerBackendPhiCopySeq
  (let
    [out : CompilerBackendPhiCopySeq
      (compiler-backend-phi-copy-seq-with-capacity 0)]
    [i : i64 index]
    [n : i64 (compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< i n)
        (match (compiler-ir-instr-seq-ref instrs i)
          [(CompilerIrInstr.Phi dst inputs ty)
            (begin
              (match (compiler-backend-phi-input-value inputs from-label)
                [(ResultBackendValue.Ok value)
                  (if (compiler-backend-copy-group?
                    type-segment-bases
                    program-index
                    ty
                    dst
                    value)
                    unit
                    (compiler-backend-phi-copy-push!
                      (&mut out)
                      (CompilerBackendPhiCopy.Copy
                        dst
                        (CompilerBackendPhiSource.Value value)
                        ty)))]
                [(ResultBackendValue.Err _) unit])
              (set! i (+ i 1)))]
          [_ (set! i n)]))
      out)))

(define (compiler-backend-object-edge-phi-copies-seq
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockSeq]
  [program-index : CompilerBackendProgramIndex]
  [target-label : i64]
  [from-label : i64]
  [index : i64]) : CompilerBackendPhiCopySeq
  (if (>= index (compiler-ir-block-seq-count blocks))
    (compiler-backend-phi-copy-seq-with-capacity 0)
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block label instrs)
        (if (= label target-label)
          (compiler-backend-object-edge-phi-copies-scan
            type-segment-bases
            instrs
            program-index
            from-label
            0)
          (compiler-backend-object-edge-phi-copies-seq
            type-segment-bases
            blocks
            program-index
            target-label
            from-label
            (+ index 1)))])))

(define (compiler-backend-object-edge-phi-copies
  [type-segment-bases : i64]
  [blocks : CompilerIrBlockList]
  [program-index : CompilerBackendProgramIndex]
  [target-label : i64]
  [from-label : i64]) : CompilerBackendPhiCopySeq
  (match blocks
    [(CompilerIrBlockList.Nil) (compiler-backend-phi-copy-seq-with-capacity 0)]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (if (= label target-label)
            (compiler-backend-object-edge-phi-copies-scan
              type-segment-bases
              instrs
              program-index
              from-label
              0)
            (compiler-backend-object-edge-phi-copies
              type-segment-bases
              (box-get rest)
              program-index
              target-label
              from-label))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-object-edge-phi-copies-seq
        type-segment-bases
        seq
        program-index
        target-label
        from-label
        0)]))

(define (compiler-backend-object-emit-phi-copies-stage
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [copies : CompilerBackendPhiCopySeq]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (struct-get copies len))
    parts
    (match (compiler-backend-phi-copy-seq-rev-ref copies index)
      [(CompilerBackendPhiCopy.Copy _ source ty)
        (match source
          [(CompilerBackendPhiSource.Value value)
            (compiler-backend-object-emit-phi-copies-stage
              (compiler-backend-object-add-nonempty-bytes
                (compiler-backend-object-load-value-to-reg-with-type
                  parts
                  site
                  value
                  ty
                  "%rax")
                (compiler-backend-object-store-rax-rsp-bytes (* index 8)))
              site
              copies
              (+ index 1))]
          [(CompilerBackendPhiSource.Temp _)
            (compiler-backend-object-emit-phi-copies-stage
              parts
              site
              copies
              (+ index 1))])])))

(define (compiler-backend-object-emit-phi-copies-store
  [parts : object_target.CompilerBackendObjectTargetParts]
  [copies : CompilerBackendPhiCopySeq]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (struct-get copies len))
    parts
    (match (compiler-backend-phi-copy-seq-rev-ref copies index)
      [(CompilerBackendPhiCopy.Copy dst _ _)
        (compiler-backend-object-emit-phi-copies-store
          (compiler-backend-object-store-reg-to-var
            (compiler-backend-object-add-nonempty-bytes
              parts
              (compiler-backend-object-load-rax-rsp-bytes (* index 8)))
            dst
            "%rax")
          copies
          (+ index 1))])))

(define (compiler-backend-object-emit-phi-copies
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [copies : CompilerBackendPhiCopySeq]) : object_target.CompilerBackendObjectTargetParts
  (let
    [count : i64 (compiler-backend-object-phi-copy-list-count copies)]
    (if (= count 0)
      parts
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-emit-phi-copies-store
          (compiler-backend-object-emit-phi-copies-stage
            (compiler-backend-object-add-nonempty-bytes
              parts
              (compiler-backend-object-sub-rsp-bytes (* count 8)))
            site
            copies
            0)
          copies
          0)
        (compiler-backend-object-add-rsp-bytes (* count 8))))))

(define (compiler-backend-object-instr
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [function : String]
  [label-scope : String]
  [current-label : i64]
  [blocks : CompilerIrBlockList]
  [instr : CompilerIrInstr]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (if (compiler-backend-copy-group?
        type-segment-bases
        program-index
        ty
        dst
        src)
        (compiler-backend-object-move-group-value-to-var parts function dst src)
        (compiler-backend-object-move-value-to-var parts function dst src ty))]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (compiler-backend-object-binop parts function dst op lhs rhs ty)]
    [(CompilerIrInstr.UnOp dst op src ty)
      (let
        [with-src : object_target.CompilerBackendObjectTargetParts
          (compiler-backend-object-value-ref-with-type parts function src ty)]
        (if (and
          (compiler-backend-f64-type? ty)
          (match op
            [(CompilerIrUnOp.Neg) true]
            [_ false]))
          (compiler-backend-object-store-reg-to-var
            (object_target.compiler-backend-object-add-rip-instr
              with-src
              function
              (cobj.CompilerObjectRelocationKind.RipValue)
              (compiler-backend-f64-sign-bit-label)
              (cobj.CompilerObjectX64Instr.XorpdRip
                (compiler-backend-f64-sign-bit-label)))
            dst
            "%rax")
          (compiler-backend-object-store-reg-to-var
            (compiler-backend-object-add-nonempty-bytes
              with-src
              (compiler-backend-object-unop-rax-bytes op))
            dst
            "%rax")))]
    [(CompilerIrInstr.Call dst name args _)
      (let
        [call-target : String
          (compiler-backend-call-symbol-index name plan program-index)]
        (compiler-backend-object-store-reg-to-var
          (compiler-backend-object-direct-call
            parts
            target
            function
            call-target
            args)
          dst
          "%rax"))]
    [(CompilerIrInstr.CallIndirect _ callee args _)
      (compiler-backend-object-call-args
        (compiler-backend-object-value-ref parts function callee)
        function
        args
        0)]
    [(CompilerIrInstr.CallIndirectC dst callee args _)
      ;; Mirror object-direct-call, with the callee loaded into %r11 after
      ;; the argument moves (load-value-to-reg scratches through %rax, and
      ;; %r11 survives the C argument registers), an indirect call, and the
      ;; result stored from %rax.
      (let
        [space : i64 (compiler-backend-object-call-space target args)]
        (compiler-backend-object-store-reg-to-var
          (compiler-backend-object-add-nonempty-bytes
            (object_target.compiler-backend-object-add-text
              (compiler-backend-object-load-value-to-reg
                (compiler-backend-object-call-arg-moves
                  (compiler-backend-object-add-nonempty-bytes
                    parts
                    (compiler-backend-object-sub-rsp-bytes space))
                  target
                  function
                  args
                  0)
                function
                callee
                "%r11")
              (cobj.CompilerObjectX64Instr.Bytes
                (compiler-backend-object-call-r11-bytes)))
            (compiler-backend-object-add-rsp-bytes space))
          dst
          "%rax"))]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base name args _)
          (let
            [call-target : String
              (compiler-backend-call-symbol-index name plan program-index)]
            (compiler-backend-object-direct-call
              (compiler-backend-object-value-ref parts function base)
              target
              function
              call-target
              args))])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            callee
            args
            _)
          (compiler-backend-object-call-args
            (compiler-backend-object-value-ref
              (compiler-backend-object-value-ref parts function base)
              function
              callee)
            function
            args
            0)])]
    [(CompilerIrInstr.TailCall name args _)
      (let
        [call-target : String
          (compiler-backend-call-symbol-index name plan program-index)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            (compiler-backend-object-add-nonempty-bytes
              (compiler-backend-object-call-arg-moves
                parts
                target
                function
                args
                0)
              (compiler-backend-object-leave-bytes))
            function
            (cobj.CompilerObjectRelocationKind.TailCall)
            call-target)
          (cobj.CompilerObjectX64Instr.TailCall call-target)))]
    [(CompilerIrInstr.Store name value ty)
      (let
        [symbol : String (compiler-backend-user-symbol-id name)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            (compiler-backend-object-value-ref-with-type
              parts
              function
              value
              ty)
            function
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.StoreRip symbol)))]
    [(CompilerIrInstr.Jump target)
      (let
        [symbol : String (compiler-backend-asm-label label-scope target)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            (compiler-backend-object-emit-phi-copies
              parts
              function
              (compiler-backend-object-edge-phi-copies
                type-segment-bases
                blocks
                program-index
                target
                current-label))
            function
            (cobj.CompilerObjectRelocationKind.Branch)
            symbol)
          (cobj.CompilerObjectX64Instr.Jump symbol)))]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (let
        [true-symbol : String
          (compiler-backend-asm-label label-scope true-label)]
        [false-symbol : String
          (compiler-backend-asm-label label-scope false-label)]
        [true-copies : CompilerBackendPhiCopySeq
          (compiler-backend-object-edge-phi-copies
            type-segment-bases
            blocks
            program-index
            true-label
            current-label)]
        [false-copies : CompilerBackendPhiCopySeq
          (compiler-backend-object-edge-phi-copies
            type-segment-bases
            blocks
            program-index
            false-label
            current-label)]
        (if (and
          (compiler-backend-object-phi-copy-list-nil? true-copies)
          (compiler-backend-object-phi-copy-list-nil? false-copies))
          (object_target.compiler-backend-object-add-text
            (object_target.compiler-backend-object-add-text-relocation
              (object_target.compiler-backend-object-add-text-relocation
                (compiler-backend-object-value-ref parts function cond)
                function
                (cobj.CompilerObjectRelocationKind.Branch)
                true-symbol)
              function
              (cobj.CompilerObjectRelocationKind.Branch)
              false-symbol)
            (cobj.CompilerObjectX64Instr.Branch true-symbol false-symbol))
          (let
            [true-edge : String
              (compiler-backend-asm-label
                label-scope
                (compiler-ir-label
                  (str_cat.str-cat
                    (compiler-ir-label-text current-label)
                    ".phit")))]
            [false-edge : String
              (compiler-backend-asm-label
                label-scope
                (compiler-ir-label
                  (str_cat.str-cat
                    (compiler-ir-label-text current-label)
                    ".phif")))]
            (object_target.compiler-backend-object-add-text
              (object_target.compiler-backend-object-add-text-relocation
                (compiler-backend-object-emit-phi-copies
                  (object_target.compiler-backend-object-add-text
                    (object_target.compiler-backend-object-symbol-local-section
                      (object_target.compiler-backend-object-add-text
                        (object_target.compiler-backend-object-add-text-relocation
                          (compiler-backend-object-emit-phi-copies
                            (object_target.compiler-backend-object-add-text
                              (object_target.compiler-backend-object-symbol-local-section
                                (object_target.compiler-backend-object-add-text
                                  (object_target.compiler-backend-object-add-text-relocation
                                    (object_target.compiler-backend-object-add-text-relocation
                                      (compiler-backend-object-value-ref
                                        parts
                                        function
                                        cond)
                                      function
                                      (cobj.CompilerObjectRelocationKind.Branch)
                                      true-edge)
                                    function
                                    (cobj.CompilerObjectRelocationKind.Branch)
                                    false-edge)
                                  (cobj.CompilerObjectX64Instr.Branch
                                    true-edge
                                    false-edge))
                                true-edge
                                (cobj.CompilerObjectSectionKind.Text)
                                (cobj.CompilerObjectSymbolKind.Function))
                              (cobj.CompilerObjectX64Instr.Label true-edge))
                            function
                            true-copies)
                          function
                          (cobj.CompilerObjectRelocationKind.Branch)
                          true-symbol)
                        (cobj.CompilerObjectX64Instr.Jump true-symbol))
                      false-edge
                      (cobj.CompilerObjectSectionKind.Text)
                      (cobj.CompilerObjectSymbolKind.Function))
                    (cobj.CompilerObjectX64Instr.Label false-edge))
                  function
                  false-copies)
                function
                (cobj.CompilerObjectRelocationKind.Branch)
                false-symbol)
              (cobj.CompilerObjectX64Instr.Jump false-symbol)))))]
    [(CompilerIrInstr.Return value)
      (compiler-backend-object-add-nonempty-bytes
        (match value
          [(CompilerIrMaybeValue.No)
            (if (string.eq function "main")
              (compiler-backend-object-add-nonempty-bytes
                parts
                (compiler-backend-object-zero-eax-bytes))
              parts)]
          [(CompilerIrMaybeValue.Some inner)
            (compiler-backend-object-load-value-to-reg
              parts
              function
              inner
              "%rax")])
        (compiler-backend-object-leave-ret-bytes))]
    ;; Edge copies are emitted by the Jump/Branch terminators that target this
    ;; block, so the phi itself emits nothing.
    [(CompilerIrInstr.Phi _ _ _) parts]
    [(CompilerIrInstr.Gep dst base offset elem-ty)
      (compiler-backend-object-gep-to-var
        type-segment-bases
        parts
        function
        dst
        base
        offset
        elem-ty)]
    [(CompilerIrInstr.Load dst src ty)
      (compiler-backend-object-load-ptr-to-var
        type-segment-bases
        parts
        function
        dst
        src
        ty)]
    [(CompilerIrInstr.StorePtr dst src ty)
      (compiler-backend-object-value-ref-with-type
        (compiler-backend-object-value-ref parts function dst)
        function
        src
        ty)]
    [(CompilerIrInstr.CopyBytes dst src _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function dst)
        function
        src)]
    [(CompilerIrInstr.BoundsCheck index length _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function index)
        function
        length)]
    [(CompilerIrInstr.Cast dst src from-ty _)
      (compiler-backend-object-move-value-to-var parts function dst src from-ty)]
    [(CompilerIrInstr.Bitcast dst src from-ty _)
      (compiler-backend-object-move-value-to-var parts function dst src from-ty)]
    [(CompilerIrInstr.Splat _ value _ elem-ty)
      (compiler-backend-object-value-ref-with-type parts function value elem-ty)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ elem-ty)
          (compiler-backend-object-value-ref-with-type
            (compiler-backend-object-value-ref-with-type
              parts
              function
              lhs
              elem-ty)
            function
            rhs
            elem-ty)])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ elem-ty)
          (compiler-backend-object-value-ref-with-type
            (compiler-backend-object-value-ref-with-type
              parts
              function
              src
              elem-ty)
            function
            carry
            elem-ty)])]
    [(CompilerIrInstr.VectorReduce _ _ src _ elem-ty)
      (compiler-backend-object-value-ref-with-type parts function src elem-ty)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ elem-ty)
          (compiler-backend-object-value-ref-with-type
            (compiler-backend-object-value-ref-with-type
              parts
              function
              lhs
              elem-ty)
            function
            rhs
            elem-ty)])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function lhs)
        function
        rhs)]
    [(CompilerIrInstr.MaskNot _ src _)
      (compiler-backend-object-value-ref parts function src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (compiler-backend-object-value-ref parts function src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload
            dst
            mask
            on-true
            on-false
            lanes
            ty)
          (if (= lanes 0)
            (compiler-backend-object-scalar-select
              parts
              function
              dst
              mask
              on-true
              on-false)
            (compiler-backend-object-value-ref-with-type
              (compiler-backend-object-value-ref-with-type
                (compiler-backend-object-value-ref parts function mask)
                function
                on-true
                ty)
              function
              on-false
              ty))])]
    [(CompilerIrInstr.VectorLoad _ base index _ _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function base)
        function
        index)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value _ elem-ty)
          (compiler-backend-object-value-ref-with-type
            (compiler-backend-object-value-ref
              (compiler-backend-object-value-ref parts function base)
              function
              index)
            function
            value
            elem-ty)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            _
            elem-ty)
          (compiler-backend-object-value-ref
            (compiler-backend-object-value-ref-with-type
              (compiler-backend-object-value-ref
                (compiler-backend-object-value-ref parts function base)
                function
                index)
              function
              value
              elem-ty)
            function
            mask)])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base index mask _ _)
          (compiler-backend-object-value-ref
            (compiler-backend-object-value-ref
              (compiler-backend-object-value-ref parts function base)
              function
              index)
            function
            mask)])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            _
            base
            index-base
            index
            _
            _
            _)
          (compiler-backend-object-value-ref
            (compiler-backend-object-value-ref
              (compiler-backend-object-value-ref parts function base)
              function
              index-base)
            function
            index)])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            elem-ty)
          (let
            [with-low : object_target.CompilerBackendObjectTargetParts
              (compiler-backend-object-value-ref
                (compiler-backend-object-value-ref-with-type
                  parts
                  function
                  source
                  elem-ty)
                function
                selector-low)]
            [with-high : object_target.CompilerBackendObjectTargetParts
              (match selector-high
                [(CompilerIrMaybeValue.Some value)
                  (compiler-backend-object-value-ref with-low function value)]
                [(CompilerIrMaybeValue.No) with-low])]
            (compiler-backend-object-value-ref with-high function active-lanes))])]
    [(CompilerIrInstr.TailMask _ index length _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function index)
        function
        length)]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function leaf)
        function
        subleaf)]
    [(CompilerIrInstr.Xgetbv _ index)
      (compiler-backend-object-value-ref parts function index)]
    [(CompilerIrInstr.Syscall _ args)
      (compiler-backend-object-call-args parts function args 0)]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ active-mask args _)
          (compiler-backend-object-spmd-call-args
            (compiler-backend-object-value-ref parts function active-mask)
            function
            args)])]
    [(CompilerIrInstr.Pack dst words _)
      (compiler-backend-object-pack-to-var parts function dst words)]
    [(CompilerIrInstr.Word dst src index _)
      (compiler-backend-object-word-to-var parts function dst src index)]
    [(CompilerIrInstr.TailCallIndirect callee args _)
      (compiler-backend-object-call-args
        (compiler-backend-object-value-ref parts function callee)
        function
        args
        0)]
    ;; Operand-free instructions and raw address-of emit no object references.
    [(CompilerIrInstr.Alloc _ _) parts]
    [(CompilerIrInstr.AddrOf _ _) parts]
    [(CompilerIrInstr.LaneId _ _ _) parts]
    [(CompilerIrInstr.EntryArgc _) parts]
    [(CompilerIrInstr.EntryArgv _) parts]
    [(CompilerIrInstr.EntryEnvp _) parts]
    [(CompilerIrInstr.Switch index base cases default-label)
      (compiler-backend-object-switch
        parts
        function
        label-scope
        current-label
        index
        base
        cases
        default-label)]))

(define (compiler-backend-object-instr-seq
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [function : String]
  [label-scope : String]
  [current-label : i64]
  [blocks : CompilerIrBlockList]
  [instrs : CompilerIrInstrSeq]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (compiler-ir-instr-seq-count instrs))
    parts
    (compiler-backend-object-instr-seq
      type-segment-bases
      (compiler-backend-object-instr
        type-segment-bases
        parts
        target
        function
        label-scope
        current-label
        blocks
        (compiler-ir-instr-seq-ref instrs index)
        plan
        program-index)
      target
      function
      label-scope
      current-label
      blocks
      instrs
      plan
      program-index
      (+ index 1))))

(define (compiler-backend-object-blocks
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [function-symbol : String]
  [label-scope : String]
  [blocks : CompilerIrBlockList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match blocks
    [(CompilerIrBlockList.Nil) parts]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [block-label : String
              (compiler-backend-asm-label label-scope label)]
            (compiler-backend-object-blocks
              type-segment-bases
              (compiler-backend-object-instr-seq
                type-segment-bases
                (object_target.compiler-backend-object-add-text
                  (object_target.compiler-backend-object-symbol-local-section
                    parts
                    block-label
                    (cobj.CompilerObjectSectionKind.Text)
                    (cobj.CompilerObjectSymbolKind.Function))
                  (cobj.CompilerObjectX64Instr.Label block-label))
                target
                function-symbol
                label-scope
                label
                blocks
                instrs
                plan
                program-index
                0)
              target
              function-symbol
              label-scope
              (box-get rest)
              plan
              program-index))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-object-block-seq
        type-segment-bases
        parts
        target
        function-symbol
        label-scope
        seq
        plan
        program-index
        0)]))

(define (compiler-backend-object-block-seq
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [function-symbol : String]
  [label-scope : String]
  [blocks : CompilerIrBlockSeq]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (compiler-ir-block-seq-count blocks))
    parts
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block label instrs)
        (let
          [block-label : String (compiler-backend-asm-label label-scope label)]
          (compiler-backend-object-block-seq
            type-segment-bases
            (compiler-backend-object-instr-seq
              type-segment-bases
              (object_target.compiler-backend-object-add-text
                (object_target.compiler-backend-object-symbol-local-section
                  parts
                  block-label
                  (cobj.CompilerObjectSectionKind.Text)
                  (cobj.CompilerObjectSymbolKind.Function))
                (cobj.CompilerObjectX64Instr.Label block-label))
              target
              function-symbol
              label-scope
              label
              (CompilerIrBlockList.Array blocks)
              instrs
              plan
              program-index
              0)
            target
            function-symbol
            label-scope
            blocks
            plan
            program-index
            (+ index 1)))])))

(define (compiler-backend-object-functions
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [functions : CompilerIrFunctionList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match functions
    [(CompilerIrFunctionList.Nil) parts]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name params ret-ty vars blocks)
          (let
            [symbol : String
              (compiler-backend-function-symbol-index program-index name)]
            [label-scope : String
              (compiler-backend-function-label-scope program-index name)]
            [types : CompilerRegVarTypes
              (compiler-reg-function-var-types
                (CompilerIrFunction.Function name params ret-ty vars blocks))]
            [groups : CompilerLiveI64Set
              (compiler-reg-function-group-vars
                type-segment-bases
                (CompilerIrFunction.Function name params ret-ty vars blocks)
                (compiler-reg-var-types-list types))]
            [_group-enable : unit
              (begin
                (compiler-backend-current-slot-vars-set! vars)
                (compiler-backend-group-vars-enable!
                  groups
                  (compiler-live-set-empty)))]
            [emitted : object_target.CompilerBackendObjectTargetParts
              (compiler-backend-object-blocks
                type-segment-bases
                (compiler-backend-object-param-spills
                  (compiler-backend-object-add-nonempty-bytes
                    (object_target.compiler-backend-object-add-text
                      (object_target.compiler-backend-object-symbol-export-section
                        parts
                        symbol
                        (cobj.CompilerObjectSectionKind.Text)
                        (cobj.CompilerObjectSymbolKind.Function))
                      (cobj.CompilerObjectX64Instr.Label symbol))
                    (compiler-backend-object-prologue-bytes
                      target
                      (compiler-backend-frame-size
                        (if (> (compiler-live-set-count groups) 0)
                          (* vars 2)
                          vars))))
                  target
                  params
                  0)
                target
                symbol
                label-scope
                blocks
                plan
                program-index)]
            [_group-disable : unit (compiler-backend-group-vars-disable!)]
            (compiler-backend-object-functions
              type-segment-bases
              emitted
              target
              (box-get rest)
              plan
              program-index))])]
    [(CompilerIrFunctionList.Array seq)
      (compiler-backend-object-function-seq
        type-segment-bases
        parts
        target
        seq
        plan
        program-index
        0)]))

(define (compiler-backend-object-function-seq
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [functions : CompilerIrFunctionSeq]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (compiler-ir-function-seq-count functions))
    parts
    (match (compiler-ir-function-seq-ref functions index)
      [(CompilerIrFunction.Function name params ret-ty vars blocks)
        (let
          [symbol : String
            (compiler-backend-function-symbol-index program-index name)]
          [label-scope : String
            (compiler-backend-function-label-scope program-index name)]
          [types : CompilerRegVarTypes
            (compiler-reg-function-var-types
              (CompilerIrFunction.Function name params ret-ty vars blocks))]
          [groups : CompilerLiveI64Set
            (compiler-reg-function-group-vars
              type-segment-bases
              (CompilerIrFunction.Function name params ret-ty vars blocks)
              (compiler-reg-var-types-list types))]
          [_group-enable : unit
            (begin
              (compiler-backend-current-slot-vars-set! vars)
              (compiler-backend-group-vars-enable!
                groups
                (compiler-live-set-empty)))]
          [emitted : object_target.CompilerBackendObjectTargetParts
            (compiler-backend-object-blocks
              type-segment-bases
              (compiler-backend-object-param-spills
                (compiler-backend-object-add-nonempty-bytes
                  (object_target.compiler-backend-object-add-text
                    (object_target.compiler-backend-object-symbol-export-section
                      parts
                      symbol
                      (cobj.CompilerObjectSectionKind.Text)
                      (cobj.CompilerObjectSymbolKind.Function))
                    (cobj.CompilerObjectX64Instr.Label symbol))
                  (compiler-backend-object-prologue-bytes
                    target
                    (compiler-backend-frame-size
                      (if (> (compiler-live-set-count groups) 0)
                        (* vars 2)
                        vars))))
                target
                params
                0)
              target
              symbol
              label-scope
              blocks
              plan
              program-index)]
          [_group-disable : unit (compiler-backend-group-vars-disable!)]
          (compiler-backend-object-function-seq
            type-segment-bases
            emitted
            target
            functions
            plan
            program-index
            (+ index 1)))])))

(define (compiler-backend-object-global-value
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [ty : AstType]
  [value : CompilerIrValue]) : object_target.CompilerBackendObjectTargetParts
  (match value
    [(CompilerIrValue.I64 n)
      (object_target.compiler-backend-object-add-data
        parts
        (cobj.CompilerObjectDataRecord.I64 n))]
    [(CompilerIrValue.Bool b)
      (object_target.compiler-backend-object-add-data
        parts
        (cobj.CompilerObjectDataRecord.I64
          (if b
            1
            0)))]
    [(CompilerIrValue.Char c)
      (object_target.compiler-backend-object-add-data
        parts
        (cobj.CompilerObjectDataRecord.I64 (compiler-backend-char-code c)))]
    [(CompilerIrValue.Unit)
      (object_target.compiler-backend-object-add-data
        parts
        (cobj.CompilerObjectDataRecord.I64 0))]
    [(CompilerIrValue.F64 bits)
      (object_target.compiler-backend-object-add-data
        parts
        (compiler-backend-float-object-data ty bits))]
    [(CompilerIrValue.String text)
      (let
        [symbol : String (compiler-backend-string-fat-label text)]
        (object_target.compiler-backend-object-add-data
          (object_target.compiler-backend-object-add-data-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.Abs64)
            symbol)
          (cobj.CompilerObjectDataRecord.SymbolAddress symbol)))]
    [(CompilerIrValue.Bytes text)
      (let
        [symbol : String (compiler-backend-bytes-fat-label text)]
        (object_target.compiler-backend-object-add-data
          (object_target.compiler-backend-object-add-data-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.Abs64)
            symbol)
          (cobj.CompilerObjectDataRecord.SymbolAddress symbol)))]
    [(CompilerIrValue.Global name)
      (let
        [symbol : String (compiler-backend-user-symbol-id name)]
        (object_target.compiler-backend-object-add-data
          (object_target.compiler-backend-object-add-data-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.Abs64)
            symbol)
          (cobj.CompilerObjectDataRecord.SymbolAddress symbol)))]
    [(CompilerIrValue.GlobalAddr name)
      (let
        [symbol : String (compiler-backend-user-symbol-id name)]
        (object_target.compiler-backend-object-add-data
          (object_target.compiler-backend-object-add-data-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.Abs64)
            symbol)
          (cobj.CompilerObjectDataRecord.SymbolAddress symbol)))]
    [(CompilerIrValue.Function name)
      (let
        [symbol : String
          (compiler-backend-closure-descriptor-label
            (compiler-ir-symbol-text name))]
        (object_target.compiler-backend-object-add-data
          (object_target.compiler-backend-object-add-data-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.Abs64)
            symbol)
          (cobj.CompilerObjectDataRecord.SymbolAddress symbol)))]
    [_ parts]))

(define (compiler-backend-object-globals
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [globals : CompilerIrGlobalList]) : object_target.CompilerBackendObjectTargetParts
  (match globals
    [(CompilerIrGlobalList.Nil) parts]
    [(CompilerIrGlobalList.Cons global rest)
      (match global
        [(CompilerIrGlobal.Global name ty value)
          (let
            [symbol : String (compiler-backend-user-symbol-id name)]
            (compiler-backend-object-globals
              (if (compiler-backend-runtime-global? ty value)
                (object_target.compiler-backend-object-add-bss
                  (object_target.compiler-backend-object-add-bss
                    (object_target.compiler-backend-object-symbol-export-section
                      parts
                      symbol
                      (cobj.CompilerObjectSectionKind.Bss)
                      (cobj.CompilerObjectSymbolKind.Data))
                    (cobj.CompilerObjectDataRecord.Label symbol))
                  (cobj.CompilerObjectDataRecord.Zero 8))
                (compiler-backend-object-global-value
                  (object_target.compiler-backend-object-add-data
                    (object_target.compiler-backend-object-symbol-export-section
                      parts
                      symbol
                      (cobj.CompilerObjectSectionKind.Data)
                      (cobj.CompilerObjectSymbolKind.Data))
                    (cobj.CompilerObjectDataRecord.Label symbol))
                  symbol
                  ty
                  value))
              target
              (box-get rest)))])]
    [(CompilerIrGlobalList.Array seq)
      (compiler-backend-object-globals
        parts
        target
        (compiler-ir-global-seq-to-list seq))]))

(define (compiler-backend-object-strings
  [parts : object_target.CompilerBackendObjectTargetParts]
  [strings : BackendStringSeq]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (struct-get strings len))
    parts
    (let
      [text : String (array-ref (struct-get strings slots) index)]
      [data-symbol : String (compiler-backend-string-data-label text)]
      [fat-symbol : String (compiler-backend-string-fat-label text)]
      (compiler-backend-object-strings
        (object_target.compiler-backend-object-add-rodata
          (object_target.compiler-backend-object-add-rodata
            (object_target.compiler-backend-object-add-rodata
              (object_target.compiler-backend-object-add-rodata-relocation
                (object_target.compiler-backend-object-add-rodata
                  (object_target.compiler-backend-object-symbol-local-section
                    (object_target.compiler-backend-object-add-rodata
                      (object_target.compiler-backend-object-add-rodata
                        (object_target.compiler-backend-object-symbol-local-section
                          parts
                          data-symbol
                          (cobj.CompilerObjectSectionKind.Rodata)
                          (cobj.CompilerObjectSymbolKind.Data))
                        (cobj.CompilerObjectDataRecord.Label data-symbol))
                      (cobj.CompilerObjectDataRecord.String text))
                    fat-symbol
                    (cobj.CompilerObjectSectionKind.Rodata)
                    (cobj.CompilerObjectSymbolKind.Data))
                  (cobj.CompilerObjectDataRecord.Align 8))
                fat-symbol
                (cobj.CompilerObjectRelocationKind.Abs64)
                data-symbol)
              (cobj.CompilerObjectDataRecord.Label fat-symbol))
            (cobj.CompilerObjectDataRecord.SymbolAddress data-symbol))
          (cobj.CompilerObjectDataRecord.I64 (string.string-length text)))
        strings
        (+ index 1)))))

(define (compiler-backend-object-bytes
  [parts : object_target.CompilerBackendObjectTargetParts]
  [items : BackendStringSeq]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (struct-get items len))
    parts
    (let
      [bytes : String (array-ref (struct-get items slots) index)]
      [data-symbol : String (compiler-backend-bytes-data-label bytes)]
      [fat-symbol : String (compiler-backend-bytes-fat-label bytes)]
      (compiler-backend-object-bytes
        (object_target.compiler-backend-object-add-data
          (object_target.compiler-backend-object-add-data
            (object_target.compiler-backend-object-add-data
              (object_target.compiler-backend-object-add-data
                (object_target.compiler-backend-object-add-data-relocation
                  (object_target.compiler-backend-object-add-data
                    (object_target.compiler-backend-object-add-data
                      (object_target.compiler-backend-object-add-data
                        (object_target.compiler-backend-object-symbol-local-section
                          (object_target.compiler-backend-object-symbol-local-section
                            parts
                            data-symbol
                            (cobj.CompilerObjectSectionKind.Data)
                            (cobj.CompilerObjectSymbolKind.Data))
                          fat-symbol
                          (cobj.CompilerObjectSectionKind.Data)
                          (cobj.CompilerObjectSymbolKind.Data))
                        (cobj.CompilerObjectDataRecord.Align 8))
                      (cobj.CompilerObjectDataRecord.Label data-symbol))
                    (if (= (string.string-length bytes) 0)
                      (cobj.CompilerObjectDataRecord.Zero 1)
                      (cobj.CompilerObjectDataRecord.Bytes bytes)))
                  fat-symbol
                  (cobj.CompilerObjectRelocationKind.Abs64)
                  data-symbol)
                (cobj.CompilerObjectDataRecord.Align 8))
              (cobj.CompilerObjectDataRecord.Label fat-symbol))
            (cobj.CompilerObjectDataRecord.SymbolAddress data-symbol))
          (cobj.CompilerObjectDataRecord.I64 (string.string-length bytes)))
        items
        (+ index 1)))))

(define (compiler-backend-object-floats
  [parts : object_target.CompilerBackendObjectTargetParts]
  [floats : BackendFloatList]) : object_target.CompilerBackendObjectTargetParts
  (match floats
    [(BackendFloatList.Nil) parts]
    [(BackendFloatList.Cons ty bits rest)
      (let
        [symbol : String (compiler-backend-float-label ty bits)]
        (compiler-backend-object-floats
          (object_target.compiler-backend-object-add-rodata
            (object_target.compiler-backend-object-add-rodata
              (object_target.compiler-backend-object-add-rodata
                (object_target.compiler-backend-object-symbol-local-section
                  parts
                  symbol
                  (cobj.CompilerObjectSectionKind.Rodata)
                  (cobj.CompilerObjectSymbolKind.Data))
                (cobj.CompilerObjectDataRecord.Align
                  (if (compiler-backend-f64-type? ty)
                    8
                    4)))
              (cobj.CompilerObjectDataRecord.Label symbol))
            (compiler-backend-float-object-data ty bits))
          (box-get rest)))]))

(define (compiler-backend-object-f64-sign-bit
  [parts : object_target.CompilerBackendObjectTargetParts]
  [enabled : bool]) : object_target.CompilerBackendObjectTargetParts
  (if enabled
    (let
      [symbol : String (compiler-backend-f64-sign-bit-label)]
      (object_target.compiler-backend-object-add-rodata
        (object_target.compiler-backend-object-add-rodata
          (object_target.compiler-backend-object-add-rodata
            (object_target.compiler-backend-object-add-rodata
              (object_target.compiler-backend-object-symbol-local-section
                parts
                symbol
                (cobj.CompilerObjectSectionKind.Rodata)
                (cobj.CompilerObjectSymbolKind.Data))
              (cobj.CompilerObjectDataRecord.Align 16))
            (cobj.CompilerObjectDataRecord.Label symbol))
          (cobj.CompilerObjectDataRecord.I64 -9223372036854775808))
        (cobj.CompilerObjectDataRecord.I64 0)))
    parts))

(define (compiler-backend-object-closure-descriptors
  [parts : object_target.CompilerBackendObjectTargetParts]
  [names : BackendSymbolSeq]
  [index : i64]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (struct-get names len))
    parts
    (let
      [name : i64 (array-ref (struct-get names slots) index)]
      [name-text : String (compiler-ir-symbol-text name)]
      [descriptor : String
        (compiler-backend-closure-descriptor-label name-text)]
      [entry : String (compiler-backend-closure-entry-label name-text)]
      (compiler-backend-object-closure-descriptors
        (match (compiler-backend-index-signature program-index name)
          [(CompilerBackendMaybeSignature.Some _ _)
            (object_target.compiler-backend-object-add-rodata
              (object_target.compiler-backend-object-add-rodata
                (object_target.compiler-backend-object-add-rodata-relocation
                  (object_target.compiler-backend-object-add-rodata
                    (object_target.compiler-backend-object-add-rodata
                      (object_target.compiler-backend-object-symbol-local-section
                        (object_target.compiler-backend-object-symbol-local-section
                          parts
                          descriptor
                          (cobj.CompilerObjectSectionKind.Rodata)
                          (cobj.CompilerObjectSymbolKind.Data))
                        entry
                        (cobj.CompilerObjectSectionKind.Text)
                        (cobj.CompilerObjectSymbolKind.Function))
                      (cobj.CompilerObjectDataRecord.Align 8))
                    (cobj.CompilerObjectDataRecord.Label descriptor))
                  descriptor
                  (cobj.CompilerObjectRelocationKind.Abs64)
                  entry)
                (cobj.CompilerObjectDataRecord.SymbolAddress entry))
              (cobj.CompilerObjectDataRecord.I64 0))]
          [(CompilerBackendMaybeSignature.No) parts])
        names
        (+ index 1)
        program-index))))

(define (compiler-backend-object-externs
  [parts : object_target.CompilerBackendObjectTargetParts]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [runtime-index : CompilerBackendRuntimeIndex]
  [referenced-functions : BackendSymbolSeq]) : object_target.CompilerBackendObjectTargetParts
  (match externs
    [(CompilerIrExternList.Nil) parts]
    [(CompilerIrExternList.Cons item rest)
      (match item
        [(CompilerIrExtern.Extern name-id _ name _ _ link-symbol-id _ provided)
          (compiler-backend-object-externs
            (if (and
              (not
                (compiler-backend-object-runtime-symbol-provided-id?
                  plan
                  link-symbol-id))
              (compiler-backend-emits-extern-symbol?
                name-id
                link-symbol-id
                provided
                plan)
              (compiler-backend-extern-symbol-referenced?
                runtime-index
                referenced-functions
                name-id
                link-symbol-id))
              (object_target.compiler-backend-object-symbol-extern
                parts
                (compiler-backend-link-symbol-id link-symbol-id plan)
                (cobj.CompilerObjectSymbolKind.Function))
              parts)
            (box-get rest)
            plan
            runtime-index
            referenced-functions)])]
    [(CompilerIrExternList.Array seq)
      (compiler-backend-object-externs
        parts
        (compiler-ir-extern-seq-to-list seq)
        plan
        runtime-index
        referenced-functions)]))

;; Emitted in this order (the old cons chain was built back-to-front).
(define (compiler-backend-object-runtime-symbols-list) : BackendStringSeq
  (let
    [symbols : BackendStringSeq
      (BackendStringSeq (array.make-array String 15) 0)]
    (begin
      (compiler-backend-string-push! (&mut symbols) "tl_alloc")
      (compiler-backend-string-push! (&mut symbols) "tl_arena_current")
      (compiler-backend-string-push! (&mut symbols) "tl_arena_set")
      (compiler-backend-string-push! (&mut symbols) "tl_arena_make_small")
      (compiler-backend-string-push! (&mut symbols) "tl_arena_make_atomic")
      (compiler-backend-string-push! (&mut symbols) "tl_region_mark")
      (compiler-backend-string-push! (&mut symbols) "tl_region_reset")
      (compiler-backend-string-push! (&mut symbols) "tl_div_abort")
      (compiler-backend-string-push! (&mut symbols) "tl_shift_abort")
      (compiler-backend-string-push! (&mut symbols) "tl_memcpy")
      (compiler-backend-string-push! (&mut symbols) "tl_memchr")
      (compiler-backend-string-push! (&mut symbols) "tl_tlci_call_macro_entry")
      (compiler-backend-string-push! (&mut symbols) "tl_tlci_call_image_entry")
      (compiler-backend-string-push!
        (&mut symbols)
        "tl_arena_debug_protect_never_reset")
      (compiler-backend-string-push!
        (&mut symbols)
        "tl_arena_debug_assert_pool_install")
      symbols)))

(define (compiler-backend-object-runtime-symbol-provided?
  [plan : CompilerBackendRuntimePlan]
  [name : String]) : bool
  (begin
    (cbi.compiler-builtin-refresh!)
    (cond
      [(string.eq name "tl_alloc") true]
      [(string.eq name "tl_memcpy") true]
      [(string.eq name "tl_memchr") true]
      [(string.eq name "tl_tlci_call_image_entry") true]
      [(string.eq name "tl_tlci_call_macro_entry")
        (compiler-backend-runtime-tail-tlci-macro-entry?
          (compiler-backend-runtime-plan-tail plan))]
      [(string.eq name "tl_shift_abort")
        (compiler-backend-plan-provides-id?
          plan
          cbi.compiler-builtin-id-tl-shift-abort)]
      [(string.eq name "tl_div_abort")
        (compiler-backend-plan-provides-id?
          plan
          cbi.compiler-builtin-id-tl-div-abort)]
      [(string.eq name "tl_region_reset")
        (compiler-backend-plan-provides-id?
          plan
          cbi.compiler-builtin-id-tl-region-reset)]
      [(string.eq name "tl_region_mark")
        (compiler-backend-plan-provides-id?
          plan
          cbi.compiler-builtin-id-tl-region-mark)]
      [(string.eq name "tl_arena_make_atomic")
        (compiler-backend-plan-provides-id?
          plan
          cbi.compiler-builtin-id-tl-arena-make-atomic)]
      [(string.eq name "tl_arena_make_small")
        (compiler-backend-plan-provides-id?
          plan
          cbi.compiler-builtin-id-tl-arena-make-small)]
      [(string.eq name "tl_arena_set")
        (compiler-backend-plan-provides-id?
          plan
          cbi.compiler-builtin-id-tl-arena-set)]
      [(string.eq name "tl_arena_current")
        (compiler-backend-plan-provides-id?
          plan
          cbi.compiler-builtin-id-tl-arena-current)]
      [(string.eq name "tl_arena_debug_protect_never_reset")
        (compiler-backend-plan-provides-id?
          plan
          cbi.compiler-builtin-id-tl-arena-debug-protect-never-reset)]
      [(string.eq name "tl_arena_debug_assert_pool_install")
        (compiler-backend-plan-provides-id?
          plan
          cbi.compiler-builtin-id-tl-arena-debug-assert-pool-install)]
      [else false])))

(define (compiler-backend-object-runtime-symbol-provided-id?
  [plan : CompilerBackendRuntimePlan]
  [name-id : i64]) : bool
  (or
    (compiler-backend-plan-provides-id? plan name-id)
    (cbi.compiler-builtin-backend-tl-alloc-id? name-id)
    (compiler-backend-fixed-fault-symbol-id? name-id)))

(define (compiler-backend-object-runtime-symbols
  [parts : object_target.CompilerBackendObjectTargetParts]
  [plan : CompilerBackendRuntimePlan]
  [names : BackendStringSeq]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (struct-get names len))
    parts
    (let
      [name : String (array-ref (struct-get names slots) index)]
      (compiler-backend-object-runtime-symbols
        (if (compiler-backend-object-runtime-symbol-provided? plan name)
          (object_target.compiler-backend-object-symbol-local-section
            parts
            name
            (cobj.CompilerObjectSectionKind.Text)
            (cobj.CompilerObjectSymbolKind.Runtime))
          parts)
        plan
        names
        (+ index 1)))))

(define (compiler-backend-object-image-for-target
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [macro-entry : bool]
  [emit-entry : bool]
  [crt-entry : bool]) : cobj.CompilerObjectImage
  (match target
    [(CompilerBackendTarget.Linux)
      (object_linux.compiler-backend-object-target-linux-image
        parts
        macro-entry
        emit-entry
        crt-entry)]
    [(CompilerBackendTarget.Windows)
      (object_windows.compiler-backend-object-target-windows-image
        parts
        macro-entry
        emit-entry
        crt-entry)]))

(define (compiler-backend-object-image-after-index
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [_mode : CompilerBackendMode]
  [entry-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [emit-entry : bool]
  [crt-entry : bool]) : cobj.CompilerObjectImage
  (let
    [collections : CompilerBackendProgramCollections
      (compiler-backend-collect-program-collections type-segment-bases program)]
    [closure-names : BackendSymbolSeq
      (compiler-backend-program-collections-functions collections)]
    [strings : BackendStringSeq
      (compiler-backend-program-collections-strings collections)]
    [bytes : BackendStringSeq
      (compiler-backend-program-collections-bytes collections)]
    [floats : BackendFloatList
      (compiler-backend-program-collections-floats collections)]
    [uses-f64-neg : bool
      (compiler-backend-program-collections-uses-f64-neg? collections)]
    [runtime-index : CompilerBackendRuntimeIndex
      (compiler-backend-runtime-index entry-functions externs)]
    [seed : object_target.CompilerBackendObjectTargetParts
      (compiler-backend-object-runtime-symbols
        (compiler-backend-object-externs
          (compiler-backend-object-f64-sign-bit
            (compiler-backend-object-floats
              (compiler-backend-object-bytes
                (compiler-backend-object-strings
                  (compiler-backend-object-closure-descriptors
                    (compiler-backend-object-globals
                      (compiler-backend-object-functions
                        type-segment-bases
                        (object_target.compiler-backend-object-parts-empty)
                        target
                        entry-functions
                        plan
                        program-index)
                      target
                      globals)
                    closure-names
                    0
                    program-index)
                  strings
                  0)
                bytes
                0)
              floats)
            uses-f64-neg)
          externs
          plan
          runtime-index
          closure-names)
        plan
        (compiler-backend-object-runtime-symbols-list)
        0)]
    (compiler-backend-object-image-for-target
      seed
      target
      (compiler-backend-runtime-tail-tlci-macro-entry?
        (compiler-backend-runtime-plan-tail plan))
      emit-entry
      crt-entry)))

(define (compiler-backend-emit-program-object-image-target-with-mode-with-type-segment-bases-and-crt-and-profile-state
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [_spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : ResultCompilerBackendObject
  (begin
    (compiler-backend-user-symbol-cache-reset!)
    (match (compiler-backend-runtime-plan program)
      [(ResultBackendRuntimePlan.Ok plan)
        (match program
          [(CompilerIrProgram.Program globals functions externs)
            (let
              [entry-functions : CompilerIrFunctionList
                (compiler-backend-functions-with-implicit-main
                  functions
                  emit-entry)]
              [program-index : CompilerBackendProgramIndex
                (compiler-backend-program-index-build-with-profile-state
                  type-segment-bases
                  entry-functions
                  externs
                  profile-state)]
              ;; Object lowering performs the same aggregate group discovery as
              ;; assembly lowering. Install this image's maps before that walk:
              ;; a prior batch entry may have left arena-owned maps in the
              ;; register allocator globals, and aggregate functions are the
              ;; first consumers that dereference them.
              [_ra-groups : unit
                (compiler-reg-set-group-counts!
                  (struct-get program-index group-word-counts))]
              [_ra-group-masks : unit
                (compiler-reg-set-group-class-masks!
                  (struct-get program-index group-word-class-masks))]
              (match (compiler-backend-validate-function-symbols
                globals
                entry-functions
                externs
                plan
                program-index)
                [(ResultCompilerBackendSymbolValidation.Ok _)
                  (match (compiler-backend-switch-validate-functions
                    entry-functions)
                    [(CompilerBackendSwitchValidation.Ok)
                      (ResultCompilerBackendObject.Ok
                        (compiler-backend-object-image-after-index
                          type-segment-bases
                          program
                          target
                          mode
                          entry-functions
                          globals
                          externs
                          plan
                          program-index
                          emit-entry
                          crt-entry))]
                    [(CompilerBackendSwitchValidation.Err message)
                      (ResultCompilerBackendObject.Err
                        (box (compiler-diagnostic-at-start "" message)))])]
                [(ResultCompilerBackendSymbolValidation.Err message)
                  (ResultCompilerBackendObject.Err message)]))])]
      [(ResultBackendRuntimePlan.Err message)
        (ResultCompilerBackendObject.Err
          (box (compiler-diagnostic-at-start "" message)))])))

(define (compiler-backend-emit-program-object-image-target-with-mode-with-type-segment-bases-and-crt
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendObject
  (compiler-backend-emit-program-object-image-target-with-mode-with-type-segment-bases-and-crt-and-profile-state
    type-segment-bases
    program
    target
    mode
    spans
    emit-entry
    crt-entry
    (profile_state.compiler-profile-state-new)))

(define (compiler-backend-emit-program-object-image-target-with-mode-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendObject
  (compiler-backend-emit-program-object-image-target-with-mode-with-type-segment-bases-and-crt
    (ast-node-pool-reader-type-segment-bases)
    program
    target
    mode
    spans
    emit-entry
    crt-entry))

(define (compiler-backend-emit-program-object-image-target-with-mode-with-pools-and-crt
  [pools : AstNodePoolContext]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendObject
  (compiler-backend-emit-program-object-image-target-with-mode-with-type-segment-bases-and-crt
    (ast-node-pool-context-type-segment-bases pools)
    program
    target
    mode
    spans
    emit-entry
    crt-entry))

(define (compiler-backend-emit-program-object-image-target-with-mode-with-pools-and-crt-and-profile-state
  [pools : AstNodePoolContext]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : ResultCompilerBackendObject
  (compiler-backend-emit-program-object-image-target-with-mode-with-type-segment-bases-and-crt-and-profile-state
    (ast-node-pool-context-type-segment-bases pools)
    program
    target
    mode
    spans
    emit-entry
    crt-entry
    profile-state))

(define (compiler-backend-emit-program-object-image-target-with-mode
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackendObject
  (compiler-backend-emit-program-object-image-target-with-mode-and-crt
    program
    target
    mode
    spans
    emit-entry
    false))

(define (compiler-backend-emit-program-object-image-target
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackendObject
  (compiler-backend-emit-program-object-image-target-with-mode
    program
    target
    (CompilerBackendMode.Scalar)
    spans
    emit-entry))

(define (compiler-backend-emit-program-object-image-linux
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]) : ResultCompilerBackendObject
  (compiler-backend-emit-program-object-image-target
    program
    (CompilerBackendTarget.Linux)
    spans
    true))

(define (compiler-backend-peephole-byte-at [data : (Ptr u8)] [index : i64]) : i64
  (cast
    (unsafe
      (ptr-read (ptr-offset data index)))
    : i64))

(define (compiler-backend-peephole-line-end
  [asm-data : (Ptr u8)]
  [start : i64]
  [n : i64]) : i64
  (let
    [offset : i64
      (if (< start n)
        (unsafe
          (compiler-backend-runtime-index-of-byte
            (ptr-offset asm-data start)
            (- n start)
            (cast 10 : u8)))
        -1)]
    (if (< offset 0)
      n
      (+ start offset))))

(define (compiler-backend-peephole-append-line
  [buf : (text_buf_borrowed.TextBufBorrowed asm)]
  [line : String]
  [newline : bool]) : (text_buf_borrowed.TextBufBorrowed asm)
  (if newline
    (text_buf_borrowed.append-char
      (text_buf_borrowed.append-owned buf line)
      '\n')
    (text_buf_borrowed.append-owned buf line)))

(define (compiler-backend-peephole-append-line-range
  [buf : (text_buf_borrowed.TextBufBorrowed asm)]
  [asm : String]
  [start : i64]
  [end : i64]
  [newline : bool]) : (text_buf_borrowed.TextBufBorrowed asm)
  (let
    [slice-end : i64
      (if newline
        (+ end 1)
        end)]
    (if (> slice-end start)
      (text_buf_borrowed.append-slice buf (& asm) start (- slice-end start))
      buf)))

(define (compiler-backend-peephole-find-comma-space
  [line : String]
  [start : i64]) : i64
  (let
    [n : i64 (string.string-length line)]
    [i : i64 start]
    [found : i64 -1]
    [done : bool false]
    (begin
      (while (not done)
        (if (< (+ i 1) n)
          (if (and
            (= (string.string-ref line i) ',')
            (= (string.string-ref line (+ i 1)) ' '))
            (begin
              (set! found i)
              (set! done true))
            (set! i (+ i 1)))
          (set! done true)))
      found)))

(define (compiler-backend-peephole-movq [line : String]) : CompilerBackendPeepholeMove
  (let
    [prefix : String "    movq "]
    [prefix-len : i64 (string.string-length prefix)]
    [n : i64 (string.string-length line)]
    (if (compiler-backend-string-prefix-at? line prefix 0)
      (let
        [comma : i64
          (compiler-backend-peephole-find-comma-space line prefix-len)]
        (if (and (> comma prefix-len) (< (+ comma 2) n))
          (CompilerBackendPeepholeMove.Move
            (string.substring line prefix-len (- comma prefix-len))
            (string.substring line (+ comma 2) (- n (+ comma 2))))
          (CompilerBackendPeepholeMove.NoMove)))
      (CompilerBackendPeepholeMove.NoMove))))

(define (compiler-backend-peephole-movq-prefix-len) : i64
  9)

(define (compiler-backend-peephole-movq-prefix-at-range?
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (if (> (+ start (compiler-backend-peephole-movq-prefix-len)) end)
    false
    (and
      (= (compiler-backend-peephole-byte-at asm-data start) 32)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 1)) 32)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 2)) 32)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 3)) 32)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 4)) 109)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 5)) 111)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 6)) 118)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 7)) 113)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 8)) 32))))

;; First ", " in [start, end), or -1. Jumps between ',' bytes with memchr
;; instead of stepping every byte.
(define (compiler-backend-peephole-find-comma-space-range
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [i : i64 start]
    [found : i64 -1]
    [done : bool false]
    (begin
      (while (and (not done) (< (+ i 1) end))
        (let
          [offset : i64
            (unsafe
              (compiler-backend-runtime-index-of-byte
                (ptr-offset asm-data i)
                (- (- end 1) i)
                (cast 44 : u8)))]
          (if (< offset 0)
            (set! done true)
            (let
              [pos : i64 (+ i offset)]
              (if (= (compiler-backend-peephole-byte-at asm-data (+ pos 1)) 32)
                (begin
                  (set! found pos)
                  (set! done true))
                (set! i (+ pos 1)))))))
      found)))

(define (compiler-backend-peephole-movq-range
  [asm : String]
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]) : CompilerBackendPeepholeMove
  (let
    [prefix-len : i64 (compiler-backend-peephole-movq-prefix-len)]
    [operand-start : i64 (+ start prefix-len)]
    (if (compiler-backend-peephole-movq-prefix-at-range? asm-data start end)
      (let
        [comma : i64
          (compiler-backend-peephole-find-comma-space-range
            asm-data
            operand-start
            end)]
        (if (and (> comma operand-start) (< (+ comma 2) end))
          (CompilerBackendPeepholeMove.Move
            (string.substring asm operand-start (- comma operand-start))
            (string.substring asm (+ comma 2) (- end (+ comma 2))))
          (CompilerBackendPeepholeMove.NoMove)))
      (CompilerBackendPeepholeMove.NoMove))))

(define (compiler-backend-peephole-register-operand? [operand : String]) : bool
  (and
    (> (string.string-length operand) 0)
    (= (string.string-ref operand 0) '%')))

;; M-G3 stage 1: frame slots are emitted rsp-relative (`N(%rsp)`); rbp forms
;; survive in needs-rbp functions and at positive incoming-stack-arg offsets.
;; Recognizing `(%rsp)` operands as slots is sound with the same argument as
;; rbp: every %rsp-mutating line (pushq/popq/subq/addq/leave/leaq-to-rsp/
;; movq-to-rsp/ret) is a non-movq/movq-to-untracked line that clears the whole
;; owner map; a returned call restores %rsp and keeps only callee-saved
;; stack-slot owners. Within any owner-map lifetime %rsp is therefore constant
;; for a tracked owner, and equal operand strings imply equal addresses (and
;; distinct strings, distinct addresses). Indexed forms contain "(%rsp," /
;; "(%rbp," and stay excluded.
;; SCAV2: true iff `operand` is a RIP-relative global reference `SYM(%rip)` -- a
;; load of a module-level global's contents. Its address is a fixed symbol, so
;; the operand string uniquely identifies the memory location (equal strings =>
;; equal addresses, distinct strings => distinct addresses), exactly like a stack
;; slot. Indexed rip forms do not exist on x86-64, so a trailing "(%rip)" is
;; unambiguous. Distinct from stack slots (which spell "(%rbp)"/"(%rsp)").
;; SCAV2: memory operands the owner map may track with structured identity:
;; rbp/rsp stack slots AND SYM(%rip) globals. Both are stable addresses whose contents
;; change only via a store to that exact operand: a store to a slot clears just
;; that slot's mirrors (movq-owners-transfer stack-slot arm); a store to a global
;; or through any pointer clears the whole map (the else arm /
;; line-clobber-owners). Calls clear all global mirrors and caller-saved stack
;; mirrors, while preserving only callee-saved stack-slot mirrors. Since a stack
;; store cannot alias a global and vice versa, keeping a global mirror across a
;; stack store (and a slot mirror across a global store's whole-map clear is
;; moot) is sound.
(define (compiler-backend-peephole-owner-key-unknown) : i64
  0)

(define (compiler-backend-peephole-owner-key-known? [key : i64]) : bool
  (not (= key 0)))

(define (compiler-backend-peephole-owner-key-stack? [key : i64]) : bool
  (> key 0))

(define (compiler-backend-peephole-owner-key-eq? [left : i64] [right : i64]) : bool
  (= left right))

(define compiler-backend-peephole-owner-global-capacity : i64
  16384)
(define compiler-backend-peephole-owner-global-bytes-capacity : i64
  1048576)
(define compiler-backend-peephole-owner-global-offsets : (Array i64)
  (array.make-array i64 16384))
(define compiler-backend-peephole-owner-global-lengths : (Array i64)
  (array.make-array i64 16384))
(define compiler-backend-peephole-owner-global-bytes : (Array u8)
  (array.make-array u8 1048576))
(define compiler-backend-peephole-owner-global-bytes-count : i64
  0)

(define (compiler-backend-peephole-owner-global-reset!) : unit
  (let
    [cap : i64 compiler-backend-peephole-owner-global-capacity]
    [i : i64 0]
    (begin
      (while (< i cap)
        (begin
          (array-set! compiler-backend-peephole-owner-global-offsets i -1)
          (set! i (+ i 1))))
      (set! compiler-backend-peephole-owner-global-bytes-count 0)
      unit)))

(define (compiler-backend-peephole-owner-global-bytes-eq?
  [off : i64]
  [len : i64]
  [data : (Ptr u8)]
  [data-start : i64]
  [klen : i64]) : bool
  (if (not (= len klen))
    false
    (let
      [j : i64 0]
      [ok : bool true]
      (begin
        (while (and ok (< j len))
          (begin
            (if (=
              (cast
                (array-ref
                  compiler-backend-peephole-owner-global-bytes
                  (+ off j))
                : i64)
              (compiler-backend-peephole-byte-at data (+ data-start j)))
              unit
              (set! ok false))
            (set! j (+ j 1))))
        ok))))

(define (compiler-backend-peephole-owner-global-key-range
  [operand : String]
  [data : (Ptr u8)]
  [operand-start : i64]
  [symbol-len : i64]) : i64
  (let
    [hash : i64 (intern-hash-slice operand operand-start symbol-len)]
    [cap : i64 compiler-backend-peephole-owner-global-capacity]
    [slot : i64 (bit-and hash (- cap 1))]
    [walked : i64 0]
    (begin
      (while (< walked cap)
        (let
          [off : i64
            (array-ref compiler-backend-peephole-owner-global-offsets slot)]
          (if (< off 0)
            (let
              [start : i64 compiler-backend-peephole-owner-global-bytes-count]
              (if (<=
                (+ start symbol-len)
                compiler-backend-peephole-owner-global-bytes-capacity)
                (let
                  [j : i64 0]
                  (begin
                    (while (< j symbol-len)
                      (begin
                        (array-set!
                          compiler-backend-peephole-owner-global-bytes
                          (+ start j)
                          (cast
                            (compiler-backend-peephole-byte-at
                              data
                              (+ operand-start j))
                            : u8))
                        (set! j (+ j 1))))
                    (array-set!
                      compiler-backend-peephole-owner-global-offsets
                      slot
                      start)
                    (array-set!
                      compiler-backend-peephole-owner-global-lengths
                      slot
                      symbol-len)
                    (set!
                      compiler-backend-peephole-owner-global-bytes-count
                      (+ start symbol-len))
                    (return (- 0 (+ slot 1)))))
                (return (compiler-backend-peephole-owner-key-unknown))))
            (if (compiler-backend-peephole-owner-global-bytes-eq?
              off
              (array-ref compiler-backend-peephole-owner-global-lengths slot)
              data
              operand-start
              symbol-len)
              (return (- 0 (+ slot 1)))
              (begin
                (set!
                  slot
                  (if (>= (+ slot 1) cap)
                    0
                    (+ slot 1)))
                (set! walked (+ walked 1)))))))
      (compiler-backend-peephole-owner-key-unknown))))

(define (compiler-backend-peephole-stack-owner-key-from-parts
  [base : i64]
  [offset : i64]
  [explicit : bool]) : i64
  (let
    [bias : i64 compiler-backend-peephole-owner-key-stack-bias]
    (if (or (< offset (- 0 bias)) (> offset bias))
      (compiler-backend-peephole-owner-key-unknown)
      (+
        1
        (+
          (* 4 (+ offset bias))
          (+
            (* base 2)
            (if explicit
              1
              0)))))))

;; Range forms used by the streaming descriptor path. They preserve operand
;; identity without allocating a substring for each side of every movq.
(define (compiler-backend-peephole-decimal-range-valid?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [i : i64 start]
    [ok : bool (< start end)]
    (begin
      (if (and ok (= (compiler-backend-peephole-byte-at data i) 45))
        (begin
          (set! i (+ i 1))
          (if (= i end)
            (set! ok false)
            unit))
        unit)
      (while (and ok (< i end))
        (let
          [b : i64 (compiler-backend-peephole-byte-at data i)]
          (begin
            (if (and (>= b 48) (<= b 57))
              unit
              (set! ok false))
            (set! i (+ i 1)))))
      ok)))

(define (compiler-backend-peephole-decimal-range-value
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [neg : bool (= (compiler-backend-peephole-byte-at data start) 45)]
    [i : i64
      (if neg
        (+ start 1)
        start)]
    [value : i64 0]
    (begin
      (while (< i end)
        (begin
          (set!
            value
            (+ (* value 10) (- (compiler-backend-peephole-byte-at data i) 48)))
          (set! i (+ i 1))))
      (if neg
        (- 0 value)
        value))))

(define compiler-backend-peephole-memory-base-none : i64
  0)
(define compiler-backend-peephole-memory-base-rbp : i64
  1)
(define compiler-backend-peephole-memory-base-rsp : i64
  2)
(define compiler-backend-peephole-memory-base-rip : i64
  3)
(define compiler-backend-peephole-memory-base-r10 : i64
  4)

;; Fixed memory bases emitted by the backend all have a six-byte suffix. Parse
;; that suffix once per movq operand, then share the compact result between
;; owner-key construction and the operand flags instead of independently
;; comparing or searching the same bytes for rbp, rsp, rip, and r10.
(define (compiler-backend-peephole-memory-base-range
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (if (< (- end start) 6)
    compiler-backend-peephole-memory-base-none
    (let
      [s : i64 (- end 6)]
      (if (and
        (= (compiler-backend-peephole-byte-at data s) 40)
        (= (compiler-backend-peephole-byte-at data (+ s 1)) 37)
        (= (compiler-backend-peephole-byte-at data (+ s 2)) 114)
        (= (compiler-backend-peephole-byte-at data (+ s 5)) 41))
        (let
          [b3 : i64 (compiler-backend-peephole-byte-at data (+ s 3))]
          [b4 : i64 (compiler-backend-peephole-byte-at data (+ s 4))]
          (if (= b4 112)
            (cond
              [(= b3 98) compiler-backend-peephole-memory-base-rbp]
              [(= b3 115) compiler-backend-peephole-memory-base-rsp]
              [(= b3 105) compiler-backend-peephole-memory-base-rip]
              [else compiler-backend-peephole-memory-base-none])
            (if (and (= b3 49) (= b4 48))
              compiler-backend-peephole-memory-base-r10
              compiler-backend-peephole-memory-base-none)))
        compiler-backend-peephole-memory-base-none))))

(define (compiler-backend-peephole-owner-key-from-range
  [operand : String]
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [memory-base : i64]) : i64
  (let
    [prefix-end : i64 (- end 6)]
    (cond
      [(or
          (= memory-base compiler-backend-peephole-memory-base-rbp)
          (= memory-base compiler-backend-peephole-memory-base-rsp))
        (let
          [base : i64
            (if (= memory-base compiler-backend-peephole-memory-base-rbp)
              0
              1)]
          (cond
            [(= prefix-end start)
              (compiler-backend-peephole-stack-owner-key-from-parts
                base
                0
                false)]
            [(compiler-backend-peephole-decimal-range-valid?
                data
                start
                prefix-end)
              (compiler-backend-peephole-stack-owner-key-from-parts
                base
                (compiler-backend-peephole-decimal-range-value
                  data
                  start
                  prefix-end)
                true)]
            [else (compiler-backend-peephole-owner-key-unknown)]))]
      [(and
          (= memory-base compiler-backend-peephole-memory-base-rip)
          (> prefix-end start))
        (compiler-backend-peephole-owner-global-key-range
          operand
          data
          start
          (- prefix-end start))]
      [else (compiler-backend-peephole-owner-key-unknown)])))

;; Local frame slots: every rsp-form slot (the rebased local frame; incoming
;; stack args stay on rbp in stage 1), plus the pre-rebase rbp spelling at
;; NEGATIVE offsets (needs-rbp functions), mirroring the historical exclusion
;; of the positive incoming-arg region.
(define (compiler-backend-peephole-local-frame-slot-operand? [operand : String]) : bool
  (or
    (compiler-backend-string-contains? operand "(%rsp)")
    (and
      (> (string.string-length operand) 0)
      (= (string.string-ref operand 0) '-')
      (compiler-backend-string-contains? operand "(%rbp)"))))

(define (compiler-backend-peephole-forward-frame-load-operands?
  [src : String]
  [dst : String]
  [next-src : String]
  [next-dst : String]) : bool
  (and
    (compiler-backend-peephole-register-operand? src)
    (compiler-backend-peephole-local-frame-slot-operand? dst)
    (compiler-backend-peephole-local-frame-slot-operand? next-src)
    (compiler-backend-peephole-register-operand? next-dst)
    (string.eq dst next-src)))

(define (compiler-backend-peephole-forward-frame-load-line
  [pending : String]
  [next : String]) : String
  (match (compiler-backend-peephole-movq pending)
    [(CompilerBackendPeepholeMove.Move src dst)
      (match (compiler-backend-peephole-movq next)
        [(CompilerBackendPeepholeMove.Move next-src next-dst)
          (if (compiler-backend-peephole-forward-frame-load-operands?
            src
            dst
            next-src
            next-dst)
            (str_cat.str-cat "    movq " src ", " next-dst)
            next)]
        [(CompilerBackendPeepholeMove.NoMove) next])]
    [(CompilerBackendPeepholeMove.NoMove) next]))

;; ---- Fold `movq SRC,%r10 ; movq DISP(%r10),DST` -> `movq DISP(SRC),DST` ----
;; SRC must be a register (not %r10); the deref source must be a base-only %r10
;; memory operand DISP(%r10) (no index). Sound iff %r10 is dead after the deref:
;; either DST==%r10 (the staged value is immediately overwritten by the load), or
;; the forward scan proves %r10's next textual touch is a clean re-write with only
;; non-%r10 movq lines in between (conservative: any non-movq / control flow stops
;; the scan as "not provably dead").
(define (compiler-backend-peephole-r10-base-rewrite
  [operand : String]
  [base : String]) : String
  (let
    [len : i64 (string.string-length operand)]
    (str_cat.str-cat (string.substring operand 0 (- len 6)) "(" base ")")))

(define (compiler-backend-peephole-range-mentions-r10?
  [asm : String]
  [start : i64]
  [end : i64]) : bool
  (if (>= start end)
    false
    (compiler-backend-peephole-range-mentions-r10-data?
      (unsafe
        (string-data asm))
      start
      end)))

(define (compiler-backend-peephole-line-clean-writes-r10?
  [asm : String]
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (match (compiler-backend-peephole-movq-range asm asm-data start end)
    [(CompilerBackendPeepholeMove.Move src dst)
      (and
        (string.eq dst "%r10")
        (not (compiler-backend-string-contains? src "%r10")))]
    [(CompilerBackendPeepholeMove.NoMove) false]))

;; Is %r10 dead after `start`? Conservative movq-only scan: the first line that
;; touches %r10 must be a clean write; the scan passes only over non-%r10 movq
;; lines; any other line (ALU / call / jmp / label / ret / directive) stops the
;; scan as "not provably dead". Returns true only on a definite clean re-write.
(define compiler-backend-peephole-r10-dead-scan-line-cap : i64
  128)

(define (compiler-backend-peephole-r10-dead-after?
  [asm : String]
  [asm-data : (Ptr u8)]
  [start : i64]
  [n : i64]) : bool
  (let
    [i : i64 start]
    [k : i64 0]
    [result : i64 -1]
    (begin
      (while (and
        (< i n)
        (< result 0)
        (< k compiler-backend-peephole-r10-dead-scan-line-cap))
        (let
          [end : i64 (compiler-backend-peephole-line-end asm-data i n)]
          (begin
            (if (compiler-backend-peephole-range-mentions-r10? asm i end)
              (if (compiler-backend-peephole-line-clean-writes-r10?
                asm
                asm-data
                i
                end)
                (set! result 1)
                (set! result 0))
              (if (compiler-backend-peephole-movq-prefix-at-range?
                asm-data
                i
                end)
                unit
                (set! result 0)))
            (set!
              i
              (if (< end n)
                (+ end 1)
                end))
            (set! k (+ k 1)))))
      (if (and (< result 0) (< i n))
        (set!
          compiler-backend-peephole-r10-dead-scan-cap-hits
          (+ compiler-backend-peephole-r10-dead-scan-cap-hits 1))
        unit)
      (= result 1))))

;; Zext dedup: the 64-bit destination register of a `movzbq`/`movzbl` line over
;; [start,end), or "" when the line is not a byte zero-extend into a tracked GP
;; register. Both forms leave the full 64-bit destination holding a value in
;; [0,255] (32-bit writes zero the upper half), so a following
;; `movzbq %<dst-low-byte>, %<dst>` re-extend is an identity.
;; True when the line [ns,ne) is exactly `movzbq %B, R` with %B the low-byte
;; sub-register of R. Paired with a pending byte zero-extend into R, this
;; re-extend is an identity and is dropped (pair-action 2). The source token
;; must be a byte register ('l'/'b' suffix); 16/32-bit sub-register tokens and
;; memory operands never match.
;; True when pending is a byte zero-extend into register R and next is the
;; identity re-extend `movzbq %<R-low-byte>, R`.
;; All-unknown owner map: every tracked register mirrors no known location.
(define (compiler-backend-peephole-owners-empty) : CompilerBackendPeepholeOwners
  (CompilerBackendPeepholeOwners
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)))

(define (compiler-backend-peephole-owners-copy
  [owners : CompilerBackendPeepholeOwners]) : CompilerBackendPeepholeOwners
  (CompilerBackendPeepholeOwners
    (struct-get owners rax)
    (struct-get owners rcx)
    (struct-get owners rdx)
    (struct-get owners rbx)
    (struct-get owners rsi)
    (struct-get owners rdi)
    (struct-get owners r8)
    (struct-get owners r9)
    (struct-get owners r10)
    (struct-get owners r11)
    (struct-get owners r12)
    (struct-get owners r13)
    (struct-get owners r14)
    (struct-get owners r15)))

;; Dense index 0..13 for the 14 general-purpose registers owned by the register
;; allocator, or -1 for anything else (immediates, stack slots, %rbp/%rsp/%rip,
;; xmm/untracked registers). Register operands are a fixed tiny set, so classify
;; them by their bytes in a single pass instead of up to 14 sequential
;; `string.eq` calls: this is the hot dispatch behind the peephole owner map and
;; the byte scan short-circuits the overwhelmingly common non-register operand on
;; the first one or two bytes. The mapping is exact (same accept set, same
;; ordering as the string-compare chains it replaces), so owner-map decisions --
;; and therefore emitted assembly -- stay byte-identical.
(define (compiler-backend-peephole-reg-index-range
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [n : i64 (- end start)]
    (if (or (< n 3) (> n 4))
      -1
      (let
        [b0 : i64 (compiler-backend-peephole-byte-at data start)]
        [b1 : i64 (compiler-backend-peephole-byte-at data (+ start 1))]
        [b2 : i64 (compiler-backend-peephole-byte-at data (+ start 2))]
        (if (or (not (= b0 37)) (not (= b1 114)))
          -1
          (if (= n 3)
            (cond [(= b2 56) 6] [(= b2 57) 7] [else -1])
            (let
              [b3 : i64 (compiler-backend-peephole-byte-at data (+ start 3))]
              (cond
                [(= b2 97)
                  (if (= b3 120)
                    0
                    -1)]
                [(= b2 99)
                  (if (= b3 120)
                    1
                    -1)]
                [(= b2 100) (cond [(= b3 120) 2] [(= b3 105) 5] [else -1])]
                [(= b2 98)
                  (if (= b3 120)
                    3
                    -1)]
                [(= b2 115)
                  (if (= b3 105)
                    4
                    -1)]
                [(= b2 49)
                  (cond
                    [(= b3 48) 8]
                    [(= b3 49) 9]
                    [(= b3 50) 10]
                    [(= b3 51) 11]
                    [(= b3 52) 12]
                    [(= b3 53) 13]
                    [else -1])]
                [else -1]))))))))

;; True iff `operand` is exactly one of the 14 general-purpose registers owned
;; by the register allocator. %rbp and %rsp are deliberately excluded.
;; Location currently mirrored by `reg`, or Unknown if unknown / `reg` is not tracked.
(define (compiler-backend-peephole-owners-get-index
  [owners : CompilerBackendPeepholeOwners]
  [idx : i64]) : i64
  (cond
    [(= idx 0) (struct-get owners rax)]
    [(= idx 1) (struct-get owners rcx)]
    [(= idx 2) (struct-get owners rdx)]
    [(= idx 3) (struct-get owners rbx)]
    [(= idx 4) (struct-get owners rsi)]
    [(= idx 5) (struct-get owners rdi)]
    [(= idx 6) (struct-get owners r8)]
    [(= idx 7) (struct-get owners r9)]
    [(= idx 8) (struct-get owners r10)]
    [(= idx 9) (struct-get owners r11)]
    [(= idx 10) (struct-get owners r12)]
    [(= idx 11) (struct-get owners r13)]
    [(= idx 12) (struct-get owners r14)]
    [(= idx 13) (struct-get owners r15)]
    [else (compiler-backend-peephole-owner-key-unknown)]))

;; The first tracked GP register whose mirrored location equals `slot`, other than
;; `exclude`, or "" if none. Drives cross-register reload reuse: a redundant
;; `movq SLOT, exclude` becomes `movq <found>, exclude` (reg-reg, cheaper) when
;; another register already holds SLOT's value. The per-location owner-clear
;; invariant guarantees `found` still holds SLOT (not written since it loaded it,
;; and SLOT not written since -- a location write clears every mirror). Unknown
;; matches nothing (a reg with unknown owner must never be "reused").
(define (compiler-backend-peephole-owners-find-reg-for-slot-index
  [owners : CompilerBackendPeepholeOwners]
  [slot : i64]
  [exclude : i64]) : String
  (if (not (compiler-backend-peephole-owner-key-known? slot))
    ""
    (let
      [ex : i64 exclude]
      (cond
        [(and
            (not (= ex 0))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rax)
              slot))
          "%rax"]
        [(and
            (not (= ex 1))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rcx)
              slot))
          "%rcx"]
        [(and
            (not (= ex 2))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rdx)
              slot))
          "%rdx"]
        [(and
            (not (= ex 3))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rbx)
              slot))
          "%rbx"]
        [(and
            (not (= ex 4))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rsi)
              slot))
          "%rsi"]
        [(and
            (not (= ex 5))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rdi)
              slot))
          "%rdi"]
        [(and
            (not (= ex 6))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r8)
              slot))
          "%r8"]
        [(and
            (not (= ex 7))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r9)
              slot))
          "%r9"]
        [(and
            (not (= ex 8))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r10)
              slot))
          "%r10"]
        [(and
            (not (= ex 9))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r11)
              slot))
          "%r11"]
        [(and
            (not (= ex 10))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r12)
              slot))
          "%r12"]
        [(and
            (not (= ex 11))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r13)
              slot))
          "%r13"]
        [(and
            (not (= ex 12))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r14)
              slot))
          "%r14"]
        [(and
            (not (= ex 13))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r15)
              slot))
          "%r15"]
        [else ""]))))

;; Owner map with `reg`'s owner set to `slot` (Unknown clears it). No-op when `reg`
;; is not a tracked register (e.g. an immediate or untracked register source).
(define (compiler-backend-peephole-owners-set-reg-index
  [owners : CompilerBackendPeepholeOwners]
  [idx : i64]
  [slot : i64]) : CompilerBackendPeepholeOwners
  (CompilerBackendPeepholeOwners
    (if (= idx 0)
      slot
      (struct-get owners rax))
    (if (= idx 1)
      slot
      (struct-get owners rcx))
    (if (= idx 2)
      slot
      (struct-get owners rdx))
    (if (= idx 3)
      slot
      (struct-get owners rbx))
    (if (= idx 4)
      slot
      (struct-get owners rsi))
    (if (= idx 5)
      slot
      (struct-get owners rdi))
    (if (= idx 6)
      slot
      (struct-get owners r8))
    (if (= idx 7)
      slot
      (struct-get owners r9))
    (if (= idx 8)
      slot
      (struct-get owners r10))
    (if (= idx 9)
      slot
      (struct-get owners r11))
    (if (= idx 10)
      slot
      (struct-get owners r12))
    (if (= idx 11)
      slot
      (struct-get owners r13))
    (if (= idx 12)
      slot
      (struct-get owners r14))
    (if (= idx 13)
      slot
      (struct-get owners r15))))

;; Owner map with every register that mirrored `slot` reset to unknown. Used
;; when `slot` is written (its memory value changed) so stale mirrors are dropped.
(define (compiler-backend-peephole-owners-clear-slot
  [owners : CompilerBackendPeepholeOwners]
  [slot : i64]) : CompilerBackendPeepholeOwners
  (CompilerBackendPeepholeOwners
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rax) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rax))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rcx) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rcx))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rdx) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rdx))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rbx) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rbx))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rsi) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rsi))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rdi) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rdi))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r8) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r8))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r9) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r9))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r10) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r10))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r11) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r11))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r12) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r12))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r13) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r13))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r14) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r14))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r15) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r15))))

;; Owner key that can survive a normal call. Calls may mutate globals, so a
;; callee-saved register keeps only stack-slot ownership across the boundary.
(define (compiler-backend-peephole-call-preserved-owner [owner : i64]) : i64
  (if (compiler-backend-peephole-owner-key-stack? owner)
    owner
    (compiler-backend-peephole-owner-key-unknown)))

;; Owner map after a normal call returns. Preserve only stack-slot owners in the
;; tracked registers whose values are guaranteed across both SysV and Win64
;; calls; Win64 also preserves %rsi/%rdi, but SysV does not, and %rbp is
;; intentionally untracked.
(define (compiler-backend-peephole-owners-clear-call-clobbers
  [owners : CompilerBackendPeepholeOwners]) : CompilerBackendPeepholeOwners
  (CompilerBackendPeepholeOwners
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-call-preserved-owner (struct-get owners rbx))
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-call-preserved-owner (struct-get owners r12))
    (compiler-backend-peephole-call-preserved-owner (struct-get owners r13))
    (compiler-backend-peephole-call-preserved-owner (struct-get owners r14))
    (compiler-backend-peephole-call-preserved-owner (struct-get owners r15))))

;; Owner-map transfer for a recognized `movq SRC, DST` line.
;;  * DST is a clean stack slot (a store): SRC's value is written to
;;    the slot. Every OTHER register that mirrored the slot becomes stale and is
;;    dropped (`owners-clear-slot`, which also drops SRC's entry when it happened
;;    to mirror this slot). SRC's value itself is unchanged, so any slot SRC
;;    already mirrors is preserved; only when SRC is a tracked register with no
;;    known location do we record that it now mirrors DST (a sound store-to-reload
;;    forward). Preserving an existing SRC owner is required: it keeps reloads of
;;    a *different* slot still resident in SRC eligible for elision.
;;  * DST is a tracked GP register (a load or reg-reg move): DST is overwritten,
;;    so it mirrors SRC when SRC is a known stack/global key, otherwise becomes unknown.
;;  * anything else for DST (%rbp/%rsp, an xmm/untracked register, or any memory
;;    operand that is not a clean stack slot -- indexed, pointer, rip-relative,
;;    or segment relative) may change the frame base or alias an unknown slot, so
;;    conservatively clear the whole map.
(define (compiler-backend-peephole-movq-owners-transfer-keyed-index
  [owners : CompilerBackendPeepholeOwners]
  [src-reg : i64]
  [dst-reg : i64]
  [src-key : i64]
  [dst-key : i64]) : CompilerBackendPeepholeOwners
  (cond
    [(compiler-backend-peephole-owner-key-stack? dst-key)
      (let
        [cleared : CompilerBackendPeepholeOwners
          (compiler-backend-peephole-owners-clear-slot owners dst-key)]
        (if (and
          (>= src-reg 0)
          (not
            (compiler-backend-peephole-owner-key-known?
              (compiler-backend-peephole-owners-get-index cleared src-reg))))
          (compiler-backend-peephole-owners-set-reg-index
            cleared
            src-reg
            dst-key)
          cleared))]
    [(>= dst-reg 0)
      ;; DST is a load/reg-reg dest: it mirrors a clean stack slot OR a SYM(%rip)
      ;; global load (SCAV2); otherwise its contents become unknown.
      (compiler-backend-peephole-owners-set-reg-index owners dst-reg src-key)]
    [else (compiler-backend-peephole-owners-empty)]))

;; Length of the leading token at `i`: bytes up to the next space or `end`.
;; Uses memchr to jump straight to the next space byte instead of stepping
;; every byte.
(define (compiler-backend-peephole-token-len
  [data : (Ptr u8)]
  [i : i64]
  [end : i64]) : i64
  (if (>= i end)
    0
    (let
      [offset : i64
        (unsafe
          (compiler-backend-runtime-index-of-byte
            (ptr-offset data i)
            (- end i)
            (cast 32 : u8)))]
      (if (< offset 0)
        (- end i)
        offset))))

;; True iff byte `b` is a movq-style size suffix: q, l, w, or b.
(define (compiler-backend-peephole-size-suffix-byte? [b : i64]) : bool
  (or (= b 113) (= b 108) (= b 119) (= b 98)))

;; True iff the mnemonic token at `i` is exactly a cmp/test compare (cmp, cmpq,
;; cmpl, cmpw, cmpb, test, testq, testl, testw, testb). These write only the
;; flags, never a GP register or memory, so they need no owner invalidation.
;; cmpxchg, cmps, and similar (which DO write registers/memory) are excluded by
;; the strict token-length / suffix check.
(define (compiler-backend-peephole-cmp-or-test-token?
  [data : (Ptr u8)]
  [i : i64]
  [tlen : i64]) : bool
  (or
    (and
      (>= tlen 3)
      (= (compiler-backend-peephole-byte-at data i) 99)
      (= (compiler-backend-peephole-byte-at data (+ i 1)) 109)
      (= (compiler-backend-peephole-byte-at data (+ i 2)) 112)
      (or
        (= tlen 3)
        (and
          (= tlen 4)
          (compiler-backend-peephole-size-suffix-byte?
            (compiler-backend-peephole-byte-at data (+ i 3))))))
    (and
      (>= tlen 4)
      (= (compiler-backend-peephole-byte-at data i) 116)
      (= (compiler-backend-peephole-byte-at data (+ i 1)) 101)
      (= (compiler-backend-peephole-byte-at data (+ i 2)) 115)
      (= (compiler-backend-peephole-byte-at data (+ i 3)) 116)
      (or
        (= tlen 4)
        (and
          (= tlen 5)
          (compiler-backend-peephole-size-suffix-byte?
            (compiler-backend-peephole-byte-at data (+ i 4))))))))

;; SCAV2: true iff line [start,end) is `call <F>` where F is a runtime NORETURN
;; abort helper (including the location-aware `_at` variants). A noreturn call
;; never returns, so the textual fall-through into
;; the next line is DEAD: the owner map is carried unchanged across it, so the
;; guard-ok continuation label immediately after it (reached ONLY via the guard's
;; own conditional jump, across which the register map is identical) sees the
;; live map from the guard test -- see line-clobber-owners' label arm.
(define (compiler-backend-peephole-line-noreturn-abort?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [i : i64 start]
    (begin
      (while (and (< i end) (= (compiler-backend-peephole-byte-at data i) 32))
        (set! i (+ i 1)))
      (let
        [e : i64 end]
        (begin
          (while (and
            (> e i)
            (= (compiler-backend-peephole-byte-at data (- e 1)) 32))
            (set! e (- e 1)))
          (or
            (compiler-backend-peephole-range-eq? data i e "call tl_oob_abort")
            (compiler-backend-peephole-range-eq?
              data
              i
              e
              "call tl_oob_abort_at")
            (compiler-backend-peephole-range-eq? data i e "call tl_shift_abort")
            (compiler-backend-peephole-range-eq?
              data
              i
              e
              "call tl_shift_abort_at")
            (compiler-backend-peephole-range-eq? data i e "call tl_div_abort")
            (compiler-backend-peephole-range-eq?
              data
              i
              e
              "call tl_div_abort_at")
            (compiler-backend-peephole-range-eq? data i e "call tl_panic_at")
            (compiler-backend-peephole-range-eq?
              data
              i
              e
              "call tl_region_abort")
            (compiler-backend-peephole-range-eq? data i e "call tl_oom_abort")))))))

;; True iff the byte range [start,end) of `data` contains `needle` as a substring.
(define (compiler-backend-peephole-range-contains-substr?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [needle : String]) : bool
  (let
    [nlen : i64 (string.string-length needle)]
    [nd : (Ptr u8)
      (unsafe
        (string-data needle))]
    [i : i64 start]
    [found : bool false]
    (begin
      (while (and (not found) (<= (+ i nlen) end))
        (let
          [k : i64 0]
          [ok : bool true]
          (begin
            (while (and ok (< k nlen))
              (begin
                (if (=
                  (compiler-backend-peephole-byte-at data (+ i k))
                  (compiler-backend-peephole-byte-at nd k))
                  unit
                  (set! ok false))
                (set! k (+ k 1))))
            (if ok
              (set! found true)
              (set! i (+ i 1))))))
      found)))

;; SCAV2: true iff label line [start,end) is a guard-check CONTINUATION label --
;; its name contains "_ok" (`..._bounds_ok.N`, `..._str_bounds_ok.N`,
;; `..._make_array_len_ok.N`, ...) and does NOT contain "_fail". Such labels are
;; backend-emitted per guard and targeted ONLY by that guard's own conditional
;; jump (single live predecessor), so when the map was carried across a preceding
;; noreturn abort it is valid here. Excluding any "_fail" is essential: inlined
;; compound labels like `..._make_array_len_ok.2.8.array_push_fail.4:` are FAIL
;; handlers (last component wins) that happen to carry an "_ok" inline-context
;; prefix; carrying across them would be unsound. Numeric `1:` labels lack "_ok".
;; Only consulted when prev-abort? holds.
(define (compiler-backend-peephole-label-guard-ok?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (and
    (compiler-backend-peephole-range-contains-substr? data start end "_ok")
    (not
      (compiler-backend-peephole-range-contains-substr? data start end "_fail"))))

;; Owner-map transfer for a non-movq line (everything `line-movq` does not parse
;; as a clean two-operand movq). `line-clears-owners?` returns true when the line
;; needs conservative owner invalidation. The line is classified from its raw
;; bytes:
;;  * blank / whitespace-only -> no effect.
;;  * a label (ends in ':') -> a control-flow merge target; arbitrary predecessors
;;    can reach it with different register contents -> clear all.
;;  * an assembler directive (first non-space byte '.') -> no register/memory
;;    effect -> no clear.
;;  * a jump ('j...': jmp/jcc/jrcxz/jecxz) -> writes no register; the fall-through
;;    keeps the current state and every branch target is itself a label that
;;    clears -> no clear.
;;  * cmp / test -> flags only -> no clear.
;;  * everything else (call, ret, leave, syscall, every arithmetic/vector op, any
;;    store through a pointer/index/segment, and any unrecognized mnemonic) may
;;    write a GP register or alias a frame slot -> invalidate conservatively.
;; True iff the mnemonic token is a call instruction (`call` or `callq`).
(define (compiler-backend-peephole-mnemonic-call?
  [data : (Ptr u8)]
  [i : i64]
  [mlen : i64]) : bool
  (and
    (or (= mlen 4) (= mlen 5))
    (= (compiler-backend-peephole-byte-at data i) 99)
    (= (compiler-backend-peephole-byte-at data (+ i 1)) 97)
    (= (compiler-backend-peephole-byte-at data (+ i 2)) 108)
    (= (compiler-backend-peephole-byte-at data (+ i 3)) 108)
    (or (= mlen 4) (= (compiler-backend-peephole-byte-at data (+ i 4)) 113))))

;; True iff the byte range [s,e) of `data` equals the literal `lit` exactly.
(define (compiler-backend-peephole-range-eq?
  [data : (Ptr u8)]
  [s : i64]
  [e : i64]
  [lit : String]) : bool
  (let
    [ln : i64 (string.string-length lit)]
    (if (not (= (- e s) ln))
      false
      (let
        [ld : (Ptr u8)
          (unsafe
            (string-data lit))]
        [k : i64 0]
        [ok : bool true]
        (begin
          (while (and ok (< k ln))
            (begin
              (if (=
                (compiler-backend-peephole-byte-at data (+ s k))
                (compiler-backend-peephole-byte-at ld k))
                unit
                (set! ok false))
              (set! k (+ k 1))))
          ok)))))

(define (compiler-backend-peephole-ranges-eq?
  [left : (Ptr u8)]
  [ls : i64]
  [le : i64]
  [right : (Ptr u8)]
  [rs : i64]
  [re : i64]) : bool
  (let
    [len : i64 (- le ls)]
    (if (not (= len (- re rs)))
      false
      (let
        [i : i64 0]
        [same : bool true]
        (begin
          (while (and same (< i len))
            (begin
              (if (=
                (compiler-backend-peephole-byte-at left (+ ls i))
                (compiler-backend-peephole-byte-at right (+ rs i)))
                unit
                (set! same false))
              (set! i (+ i 1))))
          same)))))

(define (compiler-backend-peephole-register-range?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (and (< start end) (= (compiler-backend-peephole-byte-at data start) 37)))

;; One pass over the operand finds "(%rbp)" and "(%rsp)" occurrences (indexed
;; forms place them mid-operand where the end-anchored memory-base probe
;; cannot see them): bit 1 = has "(%rbp)", bit 2 = has "(%rsp)". Replaces up
;; to three separate substring searches per operand with the same existence
;; answers.
(define (compiler-backend-peephole-stack-parens-range
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [i : i64 start]
    [bits : i64 0]
    (begin
      (while (and (< bits 3) (<= (+ i 6) end))
        (begin
          (if (and
            (= (compiler-backend-peephole-byte-at data i) 40)
            (= (compiler-backend-peephole-byte-at data (+ i 1)) 37)
            (= (compiler-backend-peephole-byte-at data (+ i 2)) 114)
            (= (compiler-backend-peephole-byte-at data (+ i 4)) 112)
            (= (compiler-backend-peephole-byte-at data (+ i 5)) 41))
            (let
              [b3 : i64 (compiler-backend-peephole-byte-at data (+ i 3))]
              (cond
                [(= b3 98) (set! bits (bit-or bits 1))]
                [(= b3 115) (set! bits (bit-or bits 2))]
                [else unit]))
            unit)
          (set! i (+ i 1))))
      bits)))

(define compiler-backend-peephole-op-register-flag : i64
  1)
(define compiler-backend-peephole-op-stack-flag : i64
  2)
(define compiler-backend-peephole-op-local-frame-flag : i64
  4)
(define compiler-backend-peephole-op-r10-base-flag : i64
  8)

(define (compiler-backend-peephole-operand-flags
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [key : i64]
  [memory-base : i64]) : i64
  (let
    [register? : bool
      (compiler-backend-peephole-register-range? data start end)]
    [packed-stack? : bool (compiler-backend-peephole-owner-key-stack? key)]
    [base-rbp? : bool (= memory-base compiler-backend-peephole-memory-base-rbp)]
    [base-rsp? : bool (= memory-base compiler-backend-peephole-memory-base-rsp)]
    [leading-minus? : bool
      (and (< start end) (= (compiler-backend-peephole-byte-at data start) 45))]
    ;; The single parenthetical scan is needed exactly where the replaced
    ;; substring searches ran: the general stack probe (no packed key, no
    ;; end-anchored rbp/rsp base) and the rbp-base local-frame arm's
    ;; "(%rsp)" search.
    [parens : i64
      (if (and
        (not packed-stack?)
        (or base-rbp? (and (not base-rsp?) (>= (- end start) 6))))
        (compiler-backend-peephole-stack-parens-range data start end)
        0)]
    [stack? : bool (or packed-stack? base-rbp? base-rsp? (not (= parens 0)))]
    [local-frame? : bool
      (if packed-stack?
        (or (not (= (bit-and (- key 1) 2) 0)) leading-minus?)
        (cond
          [base-rsp? true]
          [base-rbp? (or leading-minus? (not (= (bit-and parens 2) 0)))]
          [else
            (and
              stack?
              (or
                (not (= (bit-and parens 2) 0))
                (and leading-minus? (not (= (bit-and parens 1) 0)))))]))]
    [r10-base? : bool (= memory-base compiler-backend-peephole-memory-base-r10)]
    (+
      (if register?
        compiler-backend-peephole-op-register-flag
        0)
      (+
        (if stack?
          compiler-backend-peephole-op-stack-flag
          0)
        (+
          (if local-frame?
            compiler-backend-peephole-op-local-frame-flag
            0)
          (if r10-base?
            compiler-backend-peephole-op-r10-base-flag
            0))))))

(define (compiler-backend-peephole-op-flag? [flags : i64] [flag : i64]) : bool
  (not (= (bit-and flags flag) 0)))

;; SCAV3: the 64-bit parent of a 32/16/8-bit sub-register token [ts,te), or ""
;; if it is not a sub-register of one of the 14 owner-tracked GP registers. A
;; write to a sub-register (movl/xorl/movb/setcc dest) changes the full parent
;; register's value (32-bit forms zero-extend; 8/16-bit forms overwrite low
;; bytes), so the parent's slot mirror must be dropped -- returning the parent
;; here lets `last-operand-reg` clear exactly that register instead of forcing a
;; whole-map clear. %rbp/%rsp sub-registers (%ebp/%esp/%bp/%sp/%bpl/%spl) are
;; DELIBERATELY unmapped -> "" -> whole-map clear, preserving the frame/stack
;; pointer invalidation invariant (owner-reg? already excludes %rbp/%rsp).
;; Dense owner-register index for a full or partial GP register token. The
;; token grammar is a fixed set, so classify its 3--5 bytes once instead of
;; walking 56 literal comparisons. Partial-register writes map to their 64-bit
;; owner; rbp/rsp and their partial forms remain deliberately untracked.
(define (compiler-backend-peephole-token-reg-index-range
  [data : (Ptr u8)]
  [ts : i64]
  [te : i64]) : i64
  (let
    [n : i64 (- te ts)]
    (if (or
      (< n 3)
      (> n 5)
      (not (= (compiler-backend-peephole-byte-at data ts) 37)))
      -1
      (let
        [b1 : i64 (compiler-backend-peephole-byte-at data (+ ts 1))]
        [b2 : i64 (compiler-backend-peephole-byte-at data (+ ts 2))]
        (cond
          [(= n 3)
            (cond
              [(= b1 114) (cond [(= b2 56) 6] [(= b2 57) 7] [else -1])]
              [(= b1 97)
                (if (or (= b2 120) (= b2 108))
                  0
                  -1)]
              [(= b1 99)
                (if (or (= b2 120) (= b2 108))
                  1
                  -1)]
              [(= b1 100)
                (cond [(or (= b2 120) (= b2 108)) 2] [(= b2 105) 5] [else -1])]
              [(= b1 98)
                (if (or (= b2 120) (= b2 108))
                  3
                  -1)]
              [(= b1 115)
                (if (= b2 105)
                  4
                  -1)]
              [else -1])]
          [(= n 4)
            (let
              [b3 : i64 (compiler-backend-peephole-byte-at data (+ ts 3))]
              (cond
                [(= b1 114)
                  (cond
                    [(= b2 97)
                      (if (= b3 120)
                        0
                        -1)]
                    [(= b2 99)
                      (if (= b3 120)
                        1
                        -1)]
                    [(= b2 100) (cond [(= b3 120) 2] [(= b3 105) 5] [else -1])]
                    [(= b2 98)
                      (if (= b3 120)
                        3
                        -1)]
                    [(= b2 115)
                      (if (= b3 105)
                        4
                        -1)]
                    [(= b2 56)
                      (if (or (= b3 100) (= b3 119) (= b3 98))
                        6
                        -1)]
                    [(= b2 57)
                      (if (or (= b3 100) (= b3 119) (= b3 98))
                        7
                        -1)]
                    [(= b2 49)
                      (cond
                        [(= b3 48) 8]
                        [(= b3 49) 9]
                        [(= b3 50) 10]
                        [(= b3 51) 11]
                        [(= b3 52) 12]
                        [(= b3 53) 13]
                        [else -1])]
                    [else -1])]
                [(= b1 101)
                  (cond
                    [(= b2 97)
                      (if (= b3 120)
                        0
                        -1)]
                    [(= b2 99)
                      (if (= b3 120)
                        1
                        -1)]
                    [(= b2 100) (cond [(= b3 120) 2] [(= b3 105) 5] [else -1])]
                    [(= b2 98)
                      (if (= b3 120)
                        3
                        -1)]
                    [(= b2 115)
                      (if (= b3 105)
                        4
                        -1)]
                    [else -1])]
                [(and (= b1 115) (= b2 105) (= b3 108)) 4]
                [(and (= b1 100) (= b2 105) (= b3 108)) 5]
                [else -1]))]
          [else
            (let
              [b3 : i64 (compiler-backend-peephole-byte-at data (+ ts 3))]
              [b4 : i64 (compiler-backend-peephole-byte-at data (+ ts 4))]
              (if (and
                (= b1 114)
                (= b2 49)
                (or (= b4 100) (= b4 119) (= b4 98)))
                (cond
                  [(= b3 48) 8]
                  [(= b3 49) 9]
                  [(= b3 50) 10]
                  [(= b3 51) 11]
                  [(= b3 52) 12]
                  [(= b3 53) 13]
                  [else -1])
                -1))])))))

;; The single tracked GP register that is the LAST operand of the line [start,end),
;; or "" if the last operand is not a simple tracked register (memory, immediate,
;; xmm, or an untracked reg). Used to invalidate exactly the register a single-dest
;; instruction writes. A memory last operand ends in ')' so the backward reg-token
;; scan yields an empty token -> "".
(define (compiler-backend-peephole-last-operand-reg-index
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [te : i64 end]
    (begin
      (while (and
        (> te start)
        (= (compiler-backend-peephole-byte-at data (- te 1)) 32))
        (set! te (- te 1)))
      (let
        [ts : i64 te]
        (begin
          (while (and
            (> ts start)
            (let
              [b : i64 (compiler-backend-peephole-byte-at data (- ts 1))]
              (or (= b 37) (and (>= b 97) (<= b 122)) (and (>= b 48) (<= b 57)))))
            (set! ts (- ts 1)))
          (if (and
            (< ts te)
            (= (compiler-backend-peephole-byte-at data ts) 37)
            (or
              (= ts start)
              (let
                [pb : i64 (compiler-backend-peephole-byte-at data (- ts 1))]
                (or (= pb 32) (= pb 44) (= pb 9)))))
            (compiler-backend-peephole-token-reg-index-range data ts te)
            -1))))))

;; AVX instructions with a vector-register destination do not change any GP
;; register or memory slot tracked by the reload-elision owner map. Preserve
;; those owners across the instruction so one spilled scalar address index can
;; be loaded once and reused by an adjacent vector load/binop sequence. A GP
;; destination (for example `vpmovmskb ..., %r8`) or a memory destination stays
;; on the conservative clobber path.
(define (compiler-backend-peephole-vector-preserves-gp-owners?
  [data : (Ptr u8)]
  [mnemonic-start : i64]
  [mnemonic-len : i64]
  [start : i64]
  [end : i64]) : bool
  (if (or
    (= mnemonic-len 0)
    (not (= (compiler-backend-peephole-byte-at data mnemonic-start) 118)))
    false
    (let
      [index : i64 start]
      [last-comma : i64 -1]
      [paren-depth : i64 0]
      (begin
        (while (< index end)
          (let
            [byte : i64 (compiler-backend-peephole-byte-at data index)]
            (begin
              (cond
                [(= byte 40) (set! paren-depth (+ paren-depth 1))]
                [(= byte 41) (set! paren-depth (- paren-depth 1))]
                [(and (= byte 44) (= paren-depth 0)) (set! last-comma index)]
                [else unit])
              (set! index (+ index 1)))))
        (let
          [dest-start : i64
            (if (< last-comma 0)
              (+ mnemonic-start mnemonic-len)
              (+ last-comma 1))]
          [cursor : i64 dest-start]
          [memory-dest : bool false]
          (begin
            (while (and (not memory-dest) (< cursor end))
              (begin
                (if (= (compiler-backend-peephole-byte-at data cursor) 40)
                  (set! memory-dest true)
                  unit)
                (set! cursor (+ cursor 1))))
            (and
              (not memory-dest)
              (<
                (compiler-backend-peephole-last-operand-reg-index
                  data
                  start
                  end)
                0))))))))

;; True iff the mnemonic token [i,i+mlen) is an instruction whose ONLY written GP
;; register is its last operand (so invalidating just that register is sound):
;; the fixed q/l/w/b base set, the movabsq imm->reg load, any set<cc> (8-bit
;; dest), or one of the five widening moves. Classify the token from its length
;; and bytes once: this runs for every non-movq assembly line, and the former
;; chain re-entered the generic range/string comparator up to twenty times.
;; Excludes multi-writers (imul/mul/div/cqo/call/xchg); plain movq remains on the
;; dedicated move-transfer path and is deliberately not classified here.
(define (compiler-backend-peephole-mnemonic-single-dest?
  [data : (Ptr u8)]
  [i : i64]
  [mlen : i64]) : bool
  (if (< mlen 3)
    false
    (let
      [b0 : i64 (compiler-backend-peephole-byte-at data i)]
      [b1 : i64 (compiler-backend-peephole-byte-at data (+ i 1))]
      [b2 : i64 (compiler-backend-peephole-byte-at data (+ i 2))]
      [base3 : i64 (+ b0 (+ (* b1 256) (* b2 65536)))]
      (cond
        ;; set<cc>: preserve the existing prefix classification.
        [(and (= b0 115) (= b1 101) (= b2 116)) true]
        ;; movabsq
        [(= mlen 7)
          (and
            (= base3 7761773)
            (= (compiler-backend-peephole-byte-at data (+ i 3)) 97)
            (= (compiler-backend-peephole-byte-at data (+ i 4)) 98)
            (= (compiler-backend-peephole-byte-at data (+ i 5)) 115)
            (= (compiler-backend-peephole-byte-at data (+ i 6)) 113))]
        ;; movzbq, movzwq, movsbq, movswq, movslq
        [(= mlen 6)
          (let
            [kind : i64 (compiler-backend-peephole-byte-at data (+ i 3))]
            [width : i64 (compiler-backend-peephole-byte-at data (+ i 4))]
            (and
              (= base3 7761773)
              (= (compiler-backend-peephole-byte-at data (+ i 5)) 113)
              (or
                (and (= kind 122) (or (= width 98) (= width 119)))
                (and (= kind 115) (or (= width 98) (= width 119) (= width 108))))))]
        [else
          (let
            [suffix : i64
              (compiler-backend-peephole-byte-at data (+ i (- mlen 1)))]
            [width-suffix? : bool
              (or (= suffix 113) (= suffix 108) (= suffix 119) (= suffix 98))]
            (and
              width-suffix?
              (or
                ;; or{q,l,w,b}
                (and (= mlen 3) (= b0 111) (= b1 114))
                (and
                  (= mlen 4)
                  ;; mov{l,w,b}; movq stays on the dedicated move path.
                  (or
                    (and (not (= suffix 113)) (= base3 7761773))
                    (= base3 6579297)
                    (= base3 6452595)
                    (= base3 6581857)
                    (= base3 7499640)
                    (= base3 7104627)
                    (= base3 7497843)
                    (= base3 7496051)
                    (= base3 7102835)
                    (= base3 6776174)
                    (= base3 7630702)
                    (= base3 6516329)
                    (= base3 6514020)
                    (= base3 6382956))))))]))))

(define (compiler-backend-peephole-range-mentions-r10-data?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [i : i64 start]
    [found : bool false]
    (begin
      (while (and (not found) (<= (+ i 4) end))
        (if (and
          (= (compiler-backend-peephole-byte-at data i) 37)
          (= (compiler-backend-peephole-byte-at data (+ i 1)) 114)
          (= (compiler-backend-peephole-byte-at data (+ i 2)) 49)
          (= (compiler-backend-peephole-byte-at data (+ i 3)) 48))
          (set! found true)
          (set! i (+ i 1))))
      found)))

;; ---- transient line descriptor packing -------------------------------------
;; Low/high halves of the `span` and `mnemonic` words.
(define compiler-backend-peephole-desc-pack-shift : i64
  32)
(define compiler-backend-peephole-desc-pack-mask : i64
  4294967295)

;; One bit per line predicate in `flags`.
(define compiler-backend-peephole-desc-flag-newline : i64
  1)
(define compiler-backend-peephole-desc-flag-owned : i64
  2)
(define compiler-backend-peephole-desc-flag-movq : i64
  4)
(define compiler-backend-peephole-desc-flag-label : i64
  8)
(define compiler-backend-peephole-desc-flag-noreturn-abort : i64
  16)
(define compiler-backend-peephole-desc-flag-clears-owners : i64
  32)
(define compiler-backend-peephole-desc-flag-call : i64
  64)
(define compiler-backend-peephole-desc-flag-single-dest : i64
  128)
(define compiler-backend-peephole-desc-flag-zext : i64
  256)
(define compiler-backend-peephole-desc-flag-has-operands : i64
  512)

;; `op-flags` holds the 4-bit operand flag sets side by side.
(define compiler-backend-peephole-desc-op-flags-mask : i64
  15)
(define compiler-backend-peephole-desc-op-flags-dst-shift : i64
  4)

;; `regs` holds three 1-biased register indices (-1 becomes 0).
(define compiler-backend-peephole-desc-reg-mask : i64
  255)
(define compiler-backend-peephole-desc-reg-dst-shift : i64
  8)
(define compiler-backend-peephole-desc-reg-last-shift : i64
  16)

(define (compiler-backend-peephole-desc-start
  [line : CompilerBackendPeepholeLine]) : i64
  (bit-and (struct-get line span) compiler-backend-peephole-desc-pack-mask))

(define (compiler-backend-peephole-desc-end
  [line : CompilerBackendPeepholeLine]) : i64
  (bit-and
    (shr (struct-get line span) compiler-backend-peephole-desc-pack-shift)
    compiler-backend-peephole-desc-pack-mask))

(define (compiler-backend-peephole-desc-mnemonic-start
  [line : CompilerBackendPeepholeLine]) : i64
  (bit-and (struct-get line mnemonic) compiler-backend-peephole-desc-pack-mask))

(define (compiler-backend-peephole-desc-mnemonic-len
  [line : CompilerBackendPeepholeLine]) : i64
  (bit-and
    (shr (struct-get line mnemonic) compiler-backend-peephole-desc-pack-shift)
    compiler-backend-peephole-desc-pack-mask))

(define (compiler-backend-peephole-desc-newline?
  [line : CompilerBackendPeepholeLine]) : bool
  (not
    (=
      (bit-and
        (struct-get line flags)
        compiler-backend-peephole-desc-flag-newline)
      0)))

(define (compiler-backend-peephole-desc-owned?
  [line : CompilerBackendPeepholeLine]) : bool
  (not
    (=
      (bit-and
        (struct-get line flags)
        compiler-backend-peephole-desc-flag-owned)
      0)))

(define (compiler-backend-peephole-desc-movq?
  [line : CompilerBackendPeepholeLine]) : bool
  (not
    (=
      (bit-and (struct-get line flags) compiler-backend-peephole-desc-flag-movq)
      0)))

(define (compiler-backend-peephole-desc-label?
  [line : CompilerBackendPeepholeLine]) : bool
  (not
    (=
      (bit-and
        (struct-get line flags)
        compiler-backend-peephole-desc-flag-label)
      0)))

(define (compiler-backend-peephole-desc-noreturn-abort?
  [line : CompilerBackendPeepholeLine]) : bool
  (not
    (=
      (bit-and
        (struct-get line flags)
        compiler-backend-peephole-desc-flag-noreturn-abort)
      0)))

(define (compiler-backend-peephole-desc-clears-owners?
  [line : CompilerBackendPeepholeLine]) : bool
  (not
    (=
      (bit-and
        (struct-get line flags)
        compiler-backend-peephole-desc-flag-clears-owners)
      0)))

(define (compiler-backend-peephole-desc-call?
  [line : CompilerBackendPeepholeLine]) : bool
  (not
    (=
      (bit-and (struct-get line flags) compiler-backend-peephole-desc-flag-call)
      0)))

(define (compiler-backend-peephole-desc-single-dest?
  [line : CompilerBackendPeepholeLine]) : bool
  (not
    (=
      (bit-and
        (struct-get line flags)
        compiler-backend-peephole-desc-flag-single-dest)
      0)))

;; A generated guard branches over its cold abort preparation to an `_ok`
;; continuation. Remember the owner map at that branch so extra value/site
;; argument setup on the dead textual path cannot force reloads on the real
;; success path.
(define (compiler-backend-peephole-desc-guard-ok-branch?
  [line : CompilerBackendPeepholeLine]) : bool
  (let
    [data : (Ptr u8) (struct-get line data)]
    [start : i64 (compiler-backend-peephole-desc-start line)]
    [end : i64 (compiler-backend-peephole-desc-end line)]
    [ms : i64 (compiler-backend-peephole-desc-mnemonic-start line)]
    [mlen : i64 (compiler-backend-peephole-desc-mnemonic-len line)]
    (and
      (> mlen 1)
      (= (compiler-backend-peephole-byte-at data ms) 106)
      (not (compiler-backend-peephole-range-eq? data ms (+ ms mlen) "jmp"))
      (compiler-backend-peephole-range-contains-substr? data start end "_ok")
      (not
        (compiler-backend-peephole-range-contains-substr?
          data
          start
          end
          "_fail")))))

(define (compiler-backend-peephole-desc-guard-ok-label?
  [line : CompilerBackendPeepholeLine]) : bool
  (and
    (compiler-backend-peephole-desc-label? line)
    (compiler-backend-peephole-label-guard-ok?
      (struct-get line data)
      (compiler-backend-peephole-desc-start line)
      (compiler-backend-peephole-desc-end line))))

(define (compiler-backend-peephole-desc-pushq?
  [line : CompilerBackendPeepholeLine]) : bool
  (let
    [data : (Ptr u8) (struct-get line data)]
    [ms : i64 (compiler-backend-peephole-desc-mnemonic-start line)]
    [mlen : i64 (compiler-backend-peephole-desc-mnemonic-len line)]
    (and
      (= mlen 5)
      (= (compiler-backend-peephole-byte-at data ms) 112)
      (= (compiler-backend-peephole-byte-at data (+ ms 1)) 117)
      (= (compiler-backend-peephole-byte-at data (+ ms 2)) 115)
      (= (compiler-backend-peephole-byte-at data (+ ms 3)) 104)
      (= (compiler-backend-peephole-byte-at data (+ ms 4)) 113))))

(define (compiler-backend-peephole-desc-has-operands?
  [line : CompilerBackendPeepholeLine]) : bool
  (not
    (=
      (bit-and
        (struct-get line flags)
        compiler-backend-peephole-desc-flag-has-operands)
      0)))

(define (compiler-backend-peephole-desc-op-src-start
  [line : CompilerBackendPeepholeLine]) : i64
  (struct-get line op-src-start))

(define (compiler-backend-peephole-desc-op-src-end
  [line : CompilerBackendPeepholeLine]) : i64
  (struct-get line op-src-end))

(define (compiler-backend-peephole-desc-op-dst-start
  [line : CompilerBackendPeepholeLine]) : i64
  (struct-get line op-dst-start))

;; The destination operand always runs to the end of the line.
(define (compiler-backend-peephole-desc-op-dst-end
  [line : CompilerBackendPeepholeLine]) : i64
  (bit-and
    (shr (struct-get line span) compiler-backend-peephole-desc-pack-shift)
    compiler-backend-peephole-desc-pack-mask))

(define (compiler-backend-peephole-desc-op-src-flags
  [line : CompilerBackendPeepholeLine]) : i64
  (bit-and
    (struct-get line op-flags)
    compiler-backend-peephole-desc-op-flags-mask))

(define (compiler-backend-peephole-desc-op-dst-flags
  [line : CompilerBackendPeepholeLine]) : i64
  (bit-and
    (shr
      (struct-get line op-flags)
      compiler-backend-peephole-desc-op-flags-dst-shift)
    compiler-backend-peephole-desc-op-flags-mask))

(define (compiler-backend-peephole-desc-op-src-reg
  [line : CompilerBackendPeepholeLine]) : i64
  (- (bit-and (struct-get line regs) compiler-backend-peephole-desc-reg-mask) 1))

(define (compiler-backend-peephole-desc-op-dst-reg
  [line : CompilerBackendPeepholeLine]) : i64
  (-
    (bit-and
      (shr (struct-get line regs) compiler-backend-peephole-desc-reg-dst-shift)
      compiler-backend-peephole-desc-reg-mask)
    1))

(define (compiler-backend-peephole-desc-last-reg
  [line : CompilerBackendPeepholeLine]) : i64
  (-
    (bit-and
      (shr (struct-get line regs) compiler-backend-peephole-desc-reg-last-shift)
      compiler-backend-peephole-desc-reg-mask)
    1))

;; The zext pair rule reads the widening move's destination register; it is the
;; last-operand register of a `movzb{q,l}` line and "none" everywhere else.
(define (compiler-backend-peephole-desc-zext-dst
  [line : CompilerBackendPeepholeLine]) : i64
  (if (=
    (bit-and (struct-get line flags) compiler-backend-peephole-desc-flag-zext)
    0)
    -1
    (-
      (bit-and
        (shr
          (struct-get line regs)
          compiler-backend-peephole-desc-reg-last-shift)
        compiler-backend-peephole-desc-reg-mask)
      1)))

(define (compiler-backend-peephole-line-mnemonic-eq?
  [line : CompilerBackendPeepholeLine]
  [name : String]) : bool
  (let
    [ms : i64 (compiler-backend-peephole-desc-mnemonic-start line)]
    (compiler-backend-peephole-range-eq?
      (struct-get line data)
      ms
      (+ ms (compiler-backend-peephole-desc-mnemonic-len line))
      name)))

(define (compiler-backend-peephole-line-text
  [line : CompilerBackendPeepholeLine]) : String
  (let
    [start : i64 (compiler-backend-peephole-desc-start line)]
    (string.substring
      (struct-get line src)
      start
      (- (compiler-backend-peephole-desc-end line) start))))

(define (compiler-backend-peephole-line-op-src-text
  [line : CompilerBackendPeepholeLine]) : String
  (let
    [start : i64 (compiler-backend-peephole-desc-op-src-start line)]
    (string.substring
      (struct-get line src)
      start
      (- (compiler-backend-peephole-desc-op-src-end line) start))))

(define (compiler-backend-peephole-line-op-dst-text
  [line : CompilerBackendPeepholeLine]) : String
  (let
    [start : i64 (compiler-backend-peephole-desc-op-dst-start line)]
    (string.substring
      (struct-get line src)
      start
      (- (compiler-backend-peephole-desc-op-dst-end line) start))))

(define (compiler-backend-peephole-mnemonic-zext?
  [data : (Ptr u8)]
  [i : i64]
  [mlen : i64]) : bool
  (and
    (= mlen 6)
    (= (compiler-backend-peephole-byte-at data i) 109)
    (= (compiler-backend-peephole-byte-at data (+ i 1)) 111)
    (= (compiler-backend-peephole-byte-at data (+ i 2)) 118)
    (= (compiler-backend-peephole-byte-at data (+ i 3)) 122)
    (= (compiler-backend-peephole-byte-at data (+ i 4)) 98)
    (let
      [suffix : i64 (compiler-backend-peephole-byte-at data (+ i 5))]
      (or (= suffix 113) (= suffix 108)))))

(define (compiler-backend-peephole-parse-line
  [src : String]
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [newline : bool]
  [owned : bool]) : CompilerBackendPeepholeLine
  (let
    [ms : i64 start]
    (begin
      (while (and (< ms end) (= (compiler-backend-peephole-byte-at data ms) 32))
        (set! ms (+ ms 1)))
      (let
        [mlen : i64 (compiler-backend-peephole-token-len data ms end)]
        [operand-start : i64 (+ ms mlen)]
        [has-operands : bool false]
        [comma : i64 -1]
        [movq-prefix? : bool
          (compiler-backend-peephole-movq-prefix-at-range? data start end)]
        [zext? : bool (compiler-backend-peephole-mnemonic-zext? data ms mlen)]
        (begin
          ;; Only move/zext pair rules consume split operands. Most assembly
          ;; lines need just their mnemonic classification, so do not rescan
          ;; their full text looking for a comma that no rule will read.
          (if (or movq-prefix? zext?)
            (begin
              (while (and
                (< operand-start end)
                (= (compiler-backend-peephole-byte-at data operand-start) 32))
                (set! operand-start (+ operand-start 1)))
              (set!
                comma
                (compiler-backend-peephole-find-comma-space-range
                  data
                  operand-start
                  end))
              (if (and (> comma operand-start) (< (+ comma 2) end))
                (set! has-operands true)
                unit))
            unit)
          (let
            [is-movq : bool (and has-operands movq-prefix?)]
            [op-src-start : i64 operand-start]
            [op-src-end : i64
              (if has-operands
                comma
                operand-start)]
            [op-dst-start : i64
              (if has-operands
                (+ comma 2)
                end)]
            [op-dst-end : i64 end]
            [is-label : bool
              (and
                (< ms end)
                (= (compiler-backend-peephole-byte-at data (- end 1)) 58))]
            [cmp-or-test? : bool
              (compiler-backend-peephole-cmp-or-test-token? data ms mlen)]
            [clears : bool
              (cond
                [(>= ms end) false]
                [is-label true]
                [(= (compiler-backend-peephole-byte-at data ms) 46) false]
                [(= (compiler-backend-peephole-byte-at data ms) 106) false]
                [cmp-or-test? false]
                [(compiler-backend-peephole-vector-preserves-gp-owners?
                    data
                    ms
                    mlen
                    start
                    end)
                  false]
                [else true])]
            [call? : bool
              (compiler-backend-peephole-mnemonic-call? data ms mlen)]
            [single-dest?
              : bool
              ;; The clobber transfer handles moves, labels, non-clobbering
              ;; directives/branches, and calls before consulting this field.
              (and
                (not is-movq)
                (not is-label)
                clears
                (not call?)
                (compiler-backend-peephole-mnemonic-single-dest? data ms mlen))]
            [last-reg : i64
              (if (or single-dest? zext?)
                (compiler-backend-peephole-last-operand-reg-index
                  data
                  start
                  end)
                -1)]
            [src-memory-base : i64
              (if is-movq
                (compiler-backend-peephole-memory-base-range
                  data
                  op-src-start
                  op-src-end)
                compiler-backend-peephole-memory-base-none)]
            [dst-memory-base : i64
              (if is-movq
                (compiler-backend-peephole-memory-base-range
                  data
                  op-dst-start
                  op-dst-end)
                compiler-backend-peephole-memory-base-none)]
            [src-key : i64
              (if is-movq
                (compiler-backend-peephole-owner-key-from-range
                  src
                  data
                  op-src-start
                  op-src-end
                  src-memory-base)
                (compiler-backend-peephole-owner-key-unknown))]
            [dst-key : i64
              (if is-movq
                (compiler-backend-peephole-owner-key-from-range
                  src
                  data
                  op-dst-start
                  op-dst-end
                  dst-memory-base)
                (compiler-backend-peephole-owner-key-unknown))]
            [src-reg : i64
              (if is-movq
                (compiler-backend-peephole-reg-index-range
                  data
                  op-src-start
                  op-src-end)
                -1)]
            [dst-reg : i64
              (if is-movq
                (compiler-backend-peephole-reg-index-range
                  data
                  op-dst-start
                  op-dst-end)
                -1)]
            [src-flags : i64
              (if is-movq
                (compiler-backend-peephole-operand-flags
                  data
                  op-src-start
                  op-src-end
                  src-key
                  src-memory-base)
                0)]
            [dst-flags : i64
              (if is-movq
                (compiler-backend-peephole-operand-flags
                  data
                  op-dst-start
                  op-dst-end
                  dst-key
                  dst-memory-base)
                0)]
            (CompilerBackendPeepholeLine
              src
              data
              (bit-or start (shl end compiler-backend-peephole-desc-pack-shift))
              (bit-or ms (shl mlen compiler-backend-peephole-desc-pack-shift))
              (bit-or
                (bit-or
                  (if newline
                    compiler-backend-peephole-desc-flag-newline
                    0)
                  (bit-or
                    (if owned
                      compiler-backend-peephole-desc-flag-owned
                      0)
                    (if is-movq
                      compiler-backend-peephole-desc-flag-movq
                      0)))
                (bit-or
                  (bit-or
                    (if is-label
                      compiler-backend-peephole-desc-flag-label
                      0)
                    (if (and
                      call?
                      (compiler-backend-peephole-line-noreturn-abort?
                        data
                        start
                        end))
                      compiler-backend-peephole-desc-flag-noreturn-abort
                      0))
                  (bit-or
                    (bit-or
                      (if clears
                        compiler-backend-peephole-desc-flag-clears-owners
                        0)
                      (if call?
                        compiler-backend-peephole-desc-flag-call
                        0))
                    (bit-or
                      (if single-dest?
                        compiler-backend-peephole-desc-flag-single-dest
                        0)
                      (bit-or
                        (if zext?
                          compiler-backend-peephole-desc-flag-zext
                          0)
                        (if has-operands
                          compiler-backend-peephole-desc-flag-has-operands
                          0))))))
              op-src-start
              op-src-end
              op-dst-start
              src-key
              dst-key
              (bit-or
                src-flags
                (shl
                  dst-flags
                  compiler-backend-peephole-desc-op-flags-dst-shift))
              (bit-or
                (+ src-reg 1)
                (bit-or
                  (shl
                    (+ dst-reg 1)
                    compiler-backend-peephole-desc-reg-dst-shift)
                  (shl
                    (+ last-reg 1)
                    compiler-backend-peephole-desc-reg-last-shift))))))))))

(define (compiler-backend-peephole-owned-line [line : String] [newline : bool]) : CompilerBackendPeepholeLine
  (compiler-backend-peephole-parse-line
    line
    (unsafe
      (string-data line))
    0
    (string.string-length line)
    newline
    true))

(define (compiler-backend-peephole-empty-line) : CompilerBackendPeepholeLine
  (compiler-backend-peephole-owned-line "" false))

(define (compiler-backend-peephole-line-copy
  [line : CompilerBackendPeepholeLine]) : CompilerBackendPeepholeLine
  (CompilerBackendPeepholeLine
    (struct-get line src)
    (struct-get line data)
    (struct-get line span)
    (struct-get line mnemonic)
    (struct-get line flags)
    (struct-get line op-src-start)
    (struct-get line op-src-end)
    (struct-get line op-dst-start)
    (struct-get line op-src-key)
    (struct-get line op-dst-key)
    (struct-get line op-flags)
    (struct-get line regs)))

;; ---- compact line-record packing -------------------------------------------
;; `span` holds start in the low 32 bits and end in the high 32. Assembly group
;; strings (and the whole-program text of the non-streaming path) are orders of
;; magnitude below 2^31 bytes, and both halves stay non-negative, so the shifts
;; never touch the sign bit.
(define compiler-backend-peephole-record-span-shift : i64
  32)
(define compiler-backend-peephole-record-span-mask : i64
  4294967295)

;; `meta` low half: sweep line kind, the 13 sweep line flags in their own bit
;; values, the two render bits, the `.globl` region-boundary bit and the access
;; width. High half: the count of `(%rsp)` memory references, which is bounded
;; by the line length and so always fits.
(define compiler-backend-peephole-record-kind-mask : i64
  3)
(define compiler-backend-peephole-record-flags-shift : i64
  2)
(define compiler-backend-peephole-record-flags-mask : i64
  8191)
(define compiler-backend-peephole-record-newline-bit : i64
  32768)
(define compiler-backend-peephole-record-owned-bit : i64
  65536)
(define compiler-backend-peephole-record-globl-bit : i64
  131072)
(define compiler-backend-peephole-record-width-shift : i64
  18)
(define compiler-backend-peephole-record-width-mask : i64
  255)
(define compiler-backend-peephole-record-mem-count-shift : i64
  32)

(define (compiler-backend-peephole-record-start
  [rec : CompilerBackendPeepholeLineRecord]) : i64
  (bit-and (struct-get rec span) compiler-backend-peephole-record-span-mask))

(define (compiler-backend-peephole-record-end
  [rec : CompilerBackendPeepholeLineRecord]) : i64
  (bit-and
    (shr (struct-get rec span) compiler-backend-peephole-record-span-shift)
    compiler-backend-peephole-record-span-mask))

(define (compiler-backend-peephole-record-data
  [rec : CompilerBackendPeepholeLineRecord]) : (Ptr u8)
  (unsafe
    (string-data (struct-get rec src))))

(define (compiler-backend-peephole-record-kind
  [rec : CompilerBackendPeepholeLineRecord]) : i64
  (bit-and (struct-get rec meta) compiler-backend-peephole-record-kind-mask))

(define (compiler-backend-peephole-record-flags
  [rec : CompilerBackendPeepholeLineRecord]) : i64
  (bit-and
    (shr (struct-get rec meta) compiler-backend-peephole-record-flags-shift)
    compiler-backend-peephole-record-flags-mask))

(define (compiler-backend-peephole-record-newline?
  [rec : CompilerBackendPeepholeLineRecord]) : bool
  (not
    (=
      (bit-and
        (struct-get rec meta)
        compiler-backend-peephole-record-newline-bit)
      0)))

(define (compiler-backend-peephole-record-owned?
  [rec : CompilerBackendPeepholeLineRecord]) : bool
  (not
    (=
      (bit-and (struct-get rec meta) compiler-backend-peephole-record-owned-bit)
      0)))

(define (compiler-backend-peephole-record-globl?
  [rec : CompilerBackendPeepholeLineRecord]) : bool
  (not
    (=
      (bit-and (struct-get rec meta) compiler-backend-peephole-record-globl-bit)
      0)))

(define (compiler-backend-peephole-record-width
  [rec : CompilerBackendPeepholeLineRecord]) : i64
  (bit-and
    (shr (struct-get rec meta) compiler-backend-peephole-record-width-shift)
    compiler-backend-peephole-record-width-mask))

(define (compiler-backend-peephole-record-mem-count
  [rec : CompilerBackendPeepholeLineRecord]) : i64
  (shr (struct-get rec meta) compiler-backend-peephole-record-mem-count-shift))

;; First non-space index of the record's line. Only the never-in-practice
;; multi-reference fallback needs it, so it is recomputed instead of stored.
(define (compiler-backend-peephole-record-mnemonic-start
  [rec : CompilerBackendPeepholeLineRecord]) : i64
  (let
    [data : (Ptr u8) (compiler-backend-peephole-record-data rec)]
    [end : i64 (compiler-backend-peephole-record-end rec)]
    [m : i64 (compiler-backend-peephole-record-start rec)]
    (begin
      (while (and (< m end) (= (compiler-backend-peephole-byte-at data m) 32))
        (set! m (+ m 1)))
      m)))

;; True iff the line's trimmed content begins ".globl" -- the next
;; function/helper boundary for the sweep's region scan.
(define (compiler-backend-peephole-line-globl?
  [data : (Ptr u8)]
  [ms : i64]
  [end : i64]) : bool
  (and
    (<= (+ ms 6) end)
    (compiler-backend-peephole-range-eq? data ms (+ ms 6) ".globl")))

;; Compact one emitted streaming descriptor into its array record. This is where
;; the GAP5 extraction runs -- once per SURVIVING line, from that line's final
;; bytes, so peephole-synthesized lines are summarized from their own rewritten
;; text and lines the pair rules drop or the lookahead parses cost nothing.
(define (compiler-backend-peephole-line-record
  [line : CompilerBackendPeepholeLine]) : CompilerBackendPeepholeLineRecord
  (let
    [data : (Ptr u8) (struct-get line data)]
    [end : i64 (compiler-backend-peephole-desc-end line)]
    [ms : i64 (compiler-backend-peephole-desc-mnemonic-start line)]
    [sweep : CompilerBackendPeepholeLineSweepSummary
      (compiler-backend-peephole-line-sweep-summary
        data
        end
        ms
        (compiler-backend-peephole-desc-mnemonic-len line)
        (compiler-backend-peephole-desc-label? line))]
    (CompilerBackendPeepholeLineRecord
      (struct-get line src)
      (bit-or
        (compiler-backend-peephole-desc-start line)
        (shl end compiler-backend-peephole-record-span-shift))
      (bit-or
        (bit-or
          (bit-or
            (struct-get sweep kind)
            (shl
              (struct-get sweep flags)
              compiler-backend-peephole-record-flags-shift))
          (bit-or
            (if (compiler-backend-peephole-desc-newline? line)
              compiler-backend-peephole-record-newline-bit
              0)
            (if (compiler-backend-peephole-desc-owned? line)
              compiler-backend-peephole-record-owned-bit
              0)))
        (bit-or
          (if (compiler-backend-peephole-line-globl? data ms end)
            compiler-backend-peephole-record-globl-bit
            0)
          (bit-or
            (shl
              (struct-get sweep width)
              compiler-backend-peephole-record-width-shift)
            (shl
              (struct-get sweep mem-count)
              compiler-backend-peephole-record-mem-count-shift))))
      (struct-get sweep cand)
      (struct-get sweep epilogue)
      (if (compiler-backend-sweep-line-flag?
        (struct-get sweep flags)
        compiler-backend-sweep-line-flag-tracked-rsp-write)
        (struct-get sweep rsp-imm)
        (struct-get sweep mem-off)))))

;; Records-per-line capacity estimate for a raw group of `n` bytes. Emitted
;; assembly averages ~27 bytes per line, so a 20-byte divisor sizes the dense
;; record array once and the geometric grow below stays unused in practice.
(define (compiler-backend-peephole-line-vec-capacity-for [n : i64]) : i64
  (+ (/ n 20) 16))

(define (compiler-backend-peephole-line-vec-with-capacity [capacity : i64]) : CompilerBackendPeepholeLineVec
  (let
    [cap : i64
      (if (< capacity 1)
        1
        capacity)]
    (CompilerBackendPeepholeLineVec
      (array.make-array CompilerBackendPeepholeLineRecord cap)
      (array.make-array i64 cap)
      0)))

(define (compiler-backend-peephole-line-vec-grow
  [v : CompilerBackendPeepholeLineVec]) : CompilerBackendPeepholeLineVec
  (let
    [len : i64 (struct-get v len)]
    [old-lines : (Array CompilerBackendPeepholeLineRecord) (struct-get v lines)]
    [old-live : (Array i64) (struct-get v live)]
    [new-cap : i64
      (if (< (array-length old-lines) 1)
        1
        (* (array-length old-lines) 2))]
    [lines : (Array CompilerBackendPeepholeLineRecord)
      (array.make-array CompilerBackendPeepholeLineRecord new-cap)]
    [live : (Array i64) (array.make-array i64 new-cap)]
    [k : i64 0]
    (begin
      (while (< k len)
        (begin
          (array-set! lines k (array-ref old-lines k))
          (array-set! live k (array-ref old-live k))
          (set! k (+ k 1))))
      (CompilerBackendPeepholeLineVec lines live len))))

;; Append one surviving line, compacted. Records are live until the sweep marks
;; them dead, and the arrays are never rebuilt.
(define (compiler-backend-peephole-line-vec-push
  [v : CompilerBackendPeepholeLineVec]
  [line : CompilerBackendPeepholeLine]) : CompilerBackendPeepholeLineVec
  (let
    [grown : CompilerBackendPeepholeLineVec
      (if (< (struct-get v len) (array-length (struct-get v lines)))
        v
        (compiler-backend-peephole-line-vec-grow v))]
    [index : i64 (struct-get grown len)]
    (begin
      (array-set!
        (struct-get grown lines)
        index
        (compiler-backend-peephole-line-record line))
      (array-set! (struct-get grown live) index 1)
      (CompilerBackendPeepholeLineVec
        (struct-get grown lines)
        (struct-get grown live)
        (+ index 1)))))

;; True iff the line [start,end) is a label (non-blank after leading spaces and
;; ends in ':'). Mirrors the label arm of line-clears-owners?.
;; True iff the label on line [start,end) (its name = first-non-space..':') is in
;; the backend-collected carry-safe set -- i.e. a block reached only by
;; fall-through from its single layout-adjacent predecessor, so the running owner
;; map may be CARRIED across it. Any label absent from the set (every merge /
;; branch / switch / jump-table target, every synthetic non-block label, and the
;; function entry) is NOT carry-safe and must reset. `src` is the String the
;; byte offsets index into (the asm buffer or a rewritten pending line). The
;; label name is interned and looked up in the i64-id carry-safe set.
(define (compiler-backend-peephole-label-carry-safe?
  [src : String]
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [i : i64 start]
    (begin
      (while (and (< i end) (= (compiler-backend-peephole-byte-at data i) 32))
        (set! i (+ i 1)))
      (if (>= i (- end 1))
        false
        (let
          [klen : i64 (- (- end 1) i)]
          (compiler-backend-peephole-carry-safe-contains-bytes?
            data
            i
            klen
            (intern-hash-slice src i klen)))))))

;; Per-destination owner invalidation for a non-movq line.
;;  * A NORETURN abort call (SCAV2): keep the map unchanged -- the fall-through is
;;    dead, so nothing observes it until the guard-ok label below.
;;  * A LABEL: reset the whole map UNLESS the label is carry-safe (a provably
;;    single-pred fall-through block), OR (SCAV2) it is a guard-ok continuation
;;    label reached immediately after a noreturn abort (`prev-abort?`): its only
;;    live predecessor is the guard's conditional jump, across which the register
;;    map is identical to the map carried through the abort, so the map is valid.
;;  * A normal call: preserve callee-saved register owners, clear caller-saved
;;    owners.
;;  * A whitelisted single-GP-dest q-op whose last operand is a tracked register:
;;    clear only that register's owner (everything else's reg<->slot mirror
;;    survives).
;;  * Otherwise fall back to the conservative whole-map clear.
(define (compiler-backend-peephole-line-clobber-owners-desc
  [owners : CompilerBackendPeepholeOwners]
  [line : CompilerBackendPeepholeLine]
  [prev-abort? : bool]) : CompilerBackendPeepholeOwners
  (cond
    [(compiler-backend-peephole-desc-noreturn-abort? line) owners]
    [(compiler-backend-peephole-desc-label? line)
      (if (or
        (compiler-backend-peephole-label-carry-safe?
          (struct-get line src)
          (struct-get line data)
          (compiler-backend-peephole-desc-start line)
          (compiler-backend-peephole-desc-end line))
        (and
          prev-abort?
          (compiler-backend-peephole-label-guard-ok?
            (struct-get line data)
            (compiler-backend-peephole-desc-start line)
            (compiler-backend-peephole-desc-end line))))
        owners
        (compiler-backend-peephole-owners-empty))]
    [(not (compiler-backend-peephole-desc-clears-owners? line)) owners]
    [(compiler-backend-peephole-desc-call? line)
      (compiler-backend-peephole-owners-clear-call-clobbers owners)]
    [(compiler-backend-peephole-desc-single-dest? line)
      (let
        [dreg : i64 (compiler-backend-peephole-desc-last-reg line)]
        (if (< dreg 0)
          (compiler-backend-peephole-owners-empty)
          (compiler-backend-peephole-owners-set-reg-index
            owners
            dreg
            (compiler-backend-peephole-owner-key-unknown))))]
    [else (compiler-backend-peephole-owners-empty)]))

(define (compiler-backend-peephole-line-self-move-desc?
  [line : CompilerBackendPeepholeLine]) : bool
  (and
    (compiler-backend-peephole-desc-movq? line)
    (not (= (bit-and (compiler-backend-peephole-desc-op-src-flags line) 3) 0))
    (compiler-backend-peephole-ranges-eq?
      (struct-get line data)
      (compiler-backend-peephole-desc-op-src-start line)
      (compiler-backend-peephole-desc-op-src-end line)
      (struct-get line data)
      (compiler-backend-peephole-desc-op-dst-start line)
      (compiler-backend-peephole-desc-op-dst-end line))))

(define (compiler-backend-peephole-redundant-zext-next-desc?
  [next : CompilerBackendPeepholeLine]
  [reg : i64]) : bool
  (if (or
    (not (compiler-backend-peephole-desc-has-operands? next))
    (not (compiler-backend-peephole-line-mnemonic-eq? next "movzbq")))
    false
    (let
      [data : (Ptr u8) (struct-get next data)]
      [src-start : i64 (compiler-backend-peephole-desc-op-src-start next)]
      [src-end : i64 (compiler-backend-peephole-desc-op-src-end next)]
      [src-len : i64 (- src-end src-start)]
      (if (or
        (= src-len 0)
        (not (= (compiler-backend-peephole-byte-at data src-start) 37)))
        false
        (let
          [last : i64 (compiler-backend-peephole-byte-at data (- src-end 1))]
          (if (not (or (= last 108) (= last 98)))
            false
            (and
              (=
                (compiler-backend-peephole-token-reg-index-range
                  data
                  src-start
                  src-end)
                reg)
              (= (compiler-backend-peephole-desc-last-reg next) reg))))))))

(define (compiler-backend-peephole-redundant-zext-pair-desc?
  [pending : CompilerBackendPeepholeLine]
  [next : CompilerBackendPeepholeLine]) : bool
  (let
    [dst : i64 (compiler-backend-peephole-desc-zext-dst pending)]
    (if (< dst 0)
      false
      (compiler-backend-peephole-redundant-zext-next-desc? next dst))))

;; True iff any assembly text is left at or after chunk `chunk` offset `start`.
;; The scan below stops on its line cap, and the cap census counts only the
;; stops that left text unexamined.
(define (compiler-backend-peephole-chunks-text-remaining?
  [chunks : CompilerBackendPeepholeChunkArray]
  [chunk : i64]
  [start : i64]) : bool
  (let
    [items : (Array String) (struct-get chunks items)]
    [count : i64 (struct-get chunks count)]
    [c : i64 chunk]
    [i : i64 start]
    [found : bool false]
    (begin
      (while (and (not found) (< c count))
        (if (< i (string.string-length (array-ref items c)))
          (set! found true)
          (begin
            (set! c (+ c 1))
            (set! i 0))))
      found)))

;; Scan forward from chunk `chunk` offset `start`, across chunk boundaries
;; exactly as the former contiguous group render did.
(define (compiler-backend-peephole-r10-dead-after-desc?
  [chunks : CompilerBackendPeepholeChunkArray]
  [chunk : i64]
  [start : i64]) : bool
  (let
    [items : (Array String) (struct-get chunks items)]
    [count : i64 (struct-get chunks count)]
    [c : i64 chunk]
    [i : i64 start]
    [k : i64 0]
    [result : i64 -1]
    (begin
      (while (and
        (< c count)
        (< result 0)
        (< k compiler-backend-peephole-r10-dead-scan-line-cap))
        (let
          [asm : String (array-ref items c)]
          [n : i64 (string.string-length asm)]
          (if (>= i n)
            (begin
              (set! c (+ c 1))
              (set! i 0))
            (let
              [asm-data : (Ptr u8)
                (unsafe
                  (string-data asm))]
              [end : i64 (compiler-backend-peephole-line-end asm-data i n)]
              [next-start : i64
                (if (< end n)
                  (+ end 1)
                  end)]
              [line : CompilerBackendPeepholeLine
                (compiler-backend-peephole-parse-line
                  asm
                  asm-data
                  i
                  end
                  (< end n)
                  false)]
              [mentions-r10 : bool
                (compiler-backend-peephole-range-mentions-r10-data?
                  asm-data
                  i
                  end)]
              [clean-writes-r10 : bool
                (and
                  (compiler-backend-peephole-desc-movq? line)
                  (= (compiler-backend-peephole-desc-op-dst-reg line) 8)
                  (not
                    (compiler-backend-peephole-range-mentions-r10-data?
                      (struct-get line data)
                      (compiler-backend-peephole-desc-op-src-start line)
                      (compiler-backend-peephole-desc-op-src-end line))))]
              (begin
                (if mentions-r10
                  (if clean-writes-r10
                    (set! result 1)
                    (set! result 0))
                  (if (compiler-backend-peephole-desc-movq? line)
                    unit
                    (set! result 0)))
                (set! i next-start)
                (set! k (+ k 1)))))))
      (if (and
        (< result 0)
        (compiler-backend-peephole-chunks-text-remaining? chunks c i))
        (set!
          compiler-backend-peephole-r10-dead-scan-cap-hits
          (+ compiler-backend-peephole-r10-dead-scan-cap-hits 1))
        unit)
      (= result 1))))

(define (compiler-backend-peephole-pair-action-desc
  [chunks : CompilerBackendPeepholeChunkArray]
  [chunk : i64]
  [pending : CompilerBackendPeepholeLine]
  [next : CompilerBackendPeepholeLine]) : i64
  (if (compiler-backend-peephole-redundant-zext-pair-desc? pending next)
    2
    (if (compiler-backend-peephole-desc-movq? pending)
      (if (compiler-backend-peephole-line-self-move-desc? pending)
        1
        (if (compiler-backend-peephole-desc-movq? next)
          (let
            [pd : (Ptr u8) (struct-get pending data)]
            [nd : (Ptr u8) (struct-get next data)]
            [pss : i64 (compiler-backend-peephole-desc-op-src-start pending)]
            [pse : i64 (compiler-backend-peephole-desc-op-src-end pending)]
            [pds : i64 (compiler-backend-peephole-desc-op-dst-start pending)]
            [pde : i64 (compiler-backend-peephole-desc-op-dst-end pending)]
            [nss : i64 (compiler-backend-peephole-desc-op-src-start next)]
            [nse : i64 (compiler-backend-peephole-desc-op-src-end next)]
            [nds : i64 (compiler-backend-peephole-desc-op-dst-start next)]
            [nde : i64 (compiler-backend-peephole-desc-op-dst-end next)]
            [psf : i64 (compiler-backend-peephole-desc-op-src-flags pending)]
            [pdf : i64 (compiler-backend-peephole-desc-op-dst-flags pending)]
            [nsf : i64 (compiler-backend-peephole-desc-op-src-flags next)]
            [ndf : i64 (compiler-backend-peephole-desc-op-dst-flags next)]
            (cond
              [(and
                  (compiler-backend-peephole-op-flag?
                    psf
                    compiler-backend-peephole-op-register-flag)
                  (compiler-backend-peephole-op-flag?
                    pdf
                    compiler-backend-peephole-op-local-frame-flag)
                  (compiler-backend-peephole-op-flag?
                    nsf
                    compiler-backend-peephole-op-register-flag)
                  (compiler-backend-peephole-op-flag?
                    ndf
                    compiler-backend-peephole-op-local-frame-flag)
                  (compiler-backend-peephole-ranges-eq? pd pds pde nd nds nde))
                1]
              [(and
                  (not (= (bit-and psf 3) 0))
                  (not (= (bit-and pdf 3) 0))
                  (not (= (bit-and nsf 3) 0))
                  (not (= (bit-and ndf 3) 0))
                  (or
                    (and
                      (compiler-backend-peephole-ranges-eq?
                        pd
                        pss
                        pse
                        nd
                        nss
                        nse)
                      (compiler-backend-peephole-ranges-eq?
                        pd
                        pds
                        pde
                        nd
                        nds
                        nde))
                    (and
                      (compiler-backend-peephole-ranges-eq?
                        pd
                        pds
                        pde
                        nd
                        nss
                        nse)
                      (compiler-backend-peephole-ranges-eq?
                        pd
                        pss
                        pse
                        nd
                        nds
                        nde))))
                2]
              [(and
                  (compiler-backend-peephole-op-flag?
                    psf
                    compiler-backend-peephole-op-register-flag)
                  (compiler-backend-peephole-op-flag?
                    pdf
                    compiler-backend-peephole-op-local-frame-flag)
                  (compiler-backend-peephole-op-flag?
                    nsf
                    compiler-backend-peephole-op-local-frame-flag)
                  (compiler-backend-peephole-op-flag?
                    ndf
                    compiler-backend-peephole-op-register-flag)
                  (compiler-backend-peephole-ranges-eq? pd pds pde nd nss nse))
                3]
              [(and
                  (compiler-backend-peephole-op-flag?
                    psf
                    compiler-backend-peephole-op-register-flag)
                  (not (compiler-backend-peephole-range-eq? pd pss pse "%r10"))
                  (not (compiler-backend-peephole-range-eq? pd pss pse "%rbp"))
                  (= (compiler-backend-peephole-desc-op-dst-reg pending) 8)
                  (compiler-backend-peephole-op-flag?
                    nsf
                    compiler-backend-peephole-op-r10-base-flag)
                  (compiler-backend-peephole-op-flag?
                    ndf
                    compiler-backend-peephole-op-register-flag)
                  (or
                    (= (compiler-backend-peephole-desc-op-dst-reg next) 8)
                    (let
                      [nend : i64 (compiler-backend-peephole-desc-end next)]
                      [nlen : i64
                        (string.string-length
                          (array-ref (struct-get chunks items) chunk))]
                      (compiler-backend-peephole-r10-dead-after-desc?
                        chunks
                        chunk
                        (if (< nend nlen)
                          (+ nend 1)
                          nend)))))
                4]
              [else 0]))
          0))
      0)))

(define (compiler-backend-peephole-forward-frame-load-line-desc
  [pending : CompilerBackendPeepholeLine]
  [next : CompilerBackendPeepholeLine]) : String
  (if (and
    (compiler-backend-peephole-desc-movq? pending)
    (compiler-backend-peephole-desc-movq? next))
    (str_cat.str-cat
      "    movq "
      (compiler-backend-peephole-line-op-src-text pending)
      ", "
      (compiler-backend-peephole-line-op-dst-text next))
    (compiler-backend-peephole-line-text next)))

(define (compiler-backend-peephole-r10-base-fold-line-desc
  [pending : CompilerBackendPeepholeLine]
  [next : CompilerBackendPeepholeLine]) : String
  (if (and
    (compiler-backend-peephole-desc-movq? pending)
    (compiler-backend-peephole-desc-movq? next))
    (str_cat.str-cat
      "    movq "
      (compiler-backend-peephole-r10-base-rewrite
        (compiler-backend-peephole-line-op-src-text next)
        (compiler-backend-peephole-line-op-src-text pending))
      ", "
      (compiler-backend-peephole-line-op-dst-text next))
    (compiler-backend-peephole-line-text next)))

;; Emit one line as a RECORD. Identical rule semantics to the text emitter this
;; replaces: an elided reload pushes nothing, a reload rewritten onto a register
;; that already owns the slot pushes the synthesized `movq %rY, DST` line (whose
;; own sweep summary is extracted by the owned-line builder), everything else
;; pushes the parsed record unchanged.
(define (compiler-backend-peephole-emit-line-desc-record
  [out : CompilerBackendPeepholeLineVec]
  [line : CompilerBackendPeepholeLine]
  [owners : CompilerBackendPeepholeOwners]
  [prev-abort? : bool]) : CompilerBackendPeepholeEmitRecordResult
  (if (compiler-backend-peephole-desc-movq? line)
    (let
      [src-reg : i64 (compiler-backend-peephole-desc-op-src-reg line)]
      [dst-reg : i64 (compiler-backend-peephole-desc-op-dst-reg line)]
      [src-key : i64 (struct-get line op-src-key)]
      [dst-key : i64 (struct-get line op-dst-key)]
      [is-slot : bool (compiler-backend-peephole-owner-key-known? src-key)]
      [dst-owns : bool
        (and
          is-slot
          (compiler-backend-peephole-owner-key-eq?
            (compiler-backend-peephole-owners-get-index owners dst-reg)
            src-key))]
      [ry : String
        (if (and is-slot (not dst-owns) (>= dst-reg 0))
          (compiler-backend-peephole-owners-find-reg-for-slot-index
            owners
            src-key
            dst-reg)
          "")]
      [next-out : CompilerBackendPeepholeLineVec
        (cond
          [dst-owns out]
          [(not (string.eq ry ""))
            (compiler-backend-peephole-line-vec-push
              out
              (compiler-backend-peephole-owned-line
                (str_cat.str-cat
                  "    movq "
                  ry
                  ", "
                  (compiler-backend-peephole-line-op-dst-text line))
                (compiler-backend-peephole-desc-newline? line)))]
          [else (compiler-backend-peephole-line-vec-push out line)])]
      [next-owners : CompilerBackendPeepholeOwners
        (compiler-backend-peephole-movq-owners-transfer-keyed-index
          owners
          src-reg
          dst-reg
          src-key
          dst-key)]
      (CompilerBackendPeepholeEmitRecordResult next-out next-owners))
    (CompilerBackendPeepholeEmitRecordResult
      (compiler-backend-peephole-line-vec-push out line)
      (compiler-backend-peephole-line-clobber-owners-desc
        owners
        line
        prev-abort?))))

;; SCAV2: true iff the pending line (owned String or asm byte range) is a
;; noreturn abort call. Threaded as `prev-abort?` so the guard-ok label emitted
;; immediately after it carries the owner map (line-clobber-owners label arm).
;; User-function chunks begin with `.globl`; processing either side separately
;; preserves the legacy pass because that directive/function-entry boundary
;; clears pending pair and owner state.  Chunks that split a function remain in
;; the same group and are rendered together.
(define (compiler-backend-peephole-chunk-starts-global? [chunk : String]) : bool
  (let
    [data : (Ptr u8)
      (unsafe
        (string-data chunk))]
    [n : i64 (string.string-length chunk)]
    [i : i64 0]
    (begin
      (while (and
        (< i n)
        (or
          (= (compiler-backend-peephole-byte-at data i) 32)
          (= (compiler-backend-peephole-byte-at data i) 9)
          (= (compiler-backend-peephole-byte-at data i) 10)
          (= (compiler-backend-peephole-byte-at data i) 13)))
        (set! i (+ i 1)))
      (and
        (<= (+ i 6) n)
        (compiler-backend-peephole-range-eq? data i (+ i 6) ".globl")))))

(define (compiler-backend-peephole-chunk-newline-terminated? [chunk : String]) : bool
  (let
    [n : i64 (string.string-length chunk)]
    (and (> n 0) (= (string.string-ref chunk (- n 1)) '\n'))))

;; How many chunks continue an assembly line into their successor. Zero for
;; every group the backend emits (each chunk is one whole function text), so
;; this pass is the invariant check that keeps the walk render-free.
(define (compiler-backend-peephole-chunks-split-line-count
  [items : (Array String)]
  [count : i64]) : i64
  (let
    [k : i64 0]
    [split : i64 0]
    (begin
      (while (< k (- count 1))
        (begin
          (unless
            (compiler-backend-peephole-chunk-newline-terminated?
              (array-ref items k))
            (set! split (+ split 1)))
          (set! k (+ k 1))))
      split)))

;; Join any run of chunks that a line spans into one chunk, so the walk holds a
;; single invariant: a line is always contained in the chunk it starts in. The
;; join allocates only when a caller appended a partial line.
(define (compiler-backend-peephole-chunks-normalize
  [items : (Array String)]
  [count : i64]
  [total : i64]) : CompilerBackendPeepholeChunkArray
  (let
    [split : i64
      (compiler-backend-peephole-chunks-split-line-count items count)]
    (if (= split 0)
      (CompilerBackendPeepholeChunkArray items count total)
      (let
        [joined : (Array String) (array.make-array String (- count split))]
        [w : i64 0]
        [k : i64 0]
        (begin
          (while (< k count)
            (let
              [buf : text_buf.TextBuf
                (text_buf.append (text_buf.empty) (array-ref items k))]
              (begin
                (while (and
                  (< k (- count 1))
                  (not
                    (compiler-backend-peephole-chunk-newline-terminated?
                      (array-ref items k))))
                  (begin
                    (set! k (+ k 1))
                    (set! buf (text_buf.append buf (array-ref items k)))))
                (array-set! joined w (text_buf.render buf))
                (set! w (+ w 1))
                (set! k (+ k 1)))))
          (CompilerBackendPeepholeChunkArray joined w total))))))

;; Materialize a group's physical chunks in emission order. The chunk Strings
;; themselves are borrowed, not copied: the peephole parses them in place.
(define (compiler-backend-peephole-chunk-array [group : text_buf.TextBuf]) : CompilerBackendPeepholeChunkArray
  (let
    [chunks : text_buf.TextBufChunkList (struct-get group chunks)]
    [count : i64 (text_buf.chunk-count chunks 0)]
    [items : (Array String) (array.make-array String count)]
    (begin
      (text_buf.chunks-fill-array-rev chunks items (- count 1))
      (compiler-backend-peephole-chunks-normalize
        items
        count
        (struct-get group len)))))

;; One String holding one chunk's worth of assembly, wrapped as a chunk array
;; so the whole-string peephole entry points share the chunk walk.
(define (compiler-backend-peephole-single-chunk-array [asm : String]) : CompilerBackendPeepholeChunkArray
  (let
    [items : (Array String) (array.make-array String 1)]
    (begin
      (array-set! items 0 asm)
      (CompilerBackendPeepholeChunkArray items 1 (string.string-length asm)))))

;; Rendered byte count of the surviving records: each keeps its own source
;; range plus its newline.
(define (compiler-backend-peephole-records-length
  [v : CompilerBackendPeepholeLineVec]) : i64
  (let
    [recs : (Array CompilerBackendPeepholeLineRecord) (struct-get v lines)]
    [live : (Array i64) (struct-get v live)]
    [count : i64 (struct-get v len)]
    [total : i64 0]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (when
            (= (array-ref live i) 1)
            (let
              [rec : CompilerBackendPeepholeLineRecord (array-ref recs i)]
              (set!
                total
                (+
                  total
                  (+
                    (-
                      (compiler-backend-peephole-record-end rec)
                      (compiler-backend-peephole-record-start rec))
                    (if (compiler-backend-peephole-record-newline? rec)
                      1
                      0))))))
          (set! i (+ i 1))))
      total)))

;; Copy the surviving records into `dst`. Adjacent survivors that are contiguous
;; in the same source string are copied as one run, so a group the sweep did not
;; touch still renders as a single copy of its range -- the coalescing the
;; borrowed-chunk builder used to do, without building the chunk list.
(define (compiler-backend-peephole-records-blit!
  [v : CompilerBackendPeepholeLineVec]
  [dst : (MutPtr u8)]) : unit
  (let
    [recs : (Array CompilerBackendPeepholeLineRecord) (struct-get v lines)]
    [live : (Array i64) (struct-get v live)]
    [count : i64 (struct-get v len)]
    [out-pos : i64 0]
    [run-active : bool false]
    [run-data : (Ptr u8)
      (unsafe
        (string-data ""))]
    [run-addr : u64
      (unsafe
        (ptr->int (string-data "")))]
    [run-start : i64 0]
    [run-end : i64 0]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (when
            (= (array-ref live i) 1)
            (let
              [rec : CompilerBackendPeepholeLineRecord (array-ref recs i)]
              [data : (Ptr u8) (compiler-backend-peephole-record-data rec)]
              [addr : u64
                (unsafe
                  (ptr->int data))]
              [start : i64 (compiler-backend-peephole-record-start rec)]
              [end : i64 (compiler-backend-peephole-record-end rec)]
              [newline? : bool (compiler-backend-peephole-record-newline? rec)]
              [owned? : bool (compiler-backend-peephole-record-owned? rec)]
              [hi : i64
                (if (and newline? (not owned?))
                  (+ end 1)
                  end)]
              (begin
                (if (and run-active (= addr run-addr) (= start run-end))
                  (set! run-end hi)
                  (begin
                    (when
                      run-active
                      (begin
                        (text_buf_borrowed.copy-byte-range-into
                          run-data
                          run-start
                          (- run-end run-start)
                          dst
                          out-pos)
                        (set! out-pos (+ out-pos (- run-end run-start)))))
                    (set! run-active true)
                    (set! run-data data)
                    (set! run-addr addr)
                    (set! run-start start)
                    (set! run-end hi)))
                (when
                  (and newline? owned?)
                  (begin
                    (text_buf_borrowed.copy-byte-range-into
                      run-data
                      run-start
                      (- run-end run-start)
                      dst
                      out-pos)
                    (set! out-pos (+ out-pos (- run-end run-start)))
                    (unsafe
                      (ptr-write! (ptr-offset dst out-pos) (cast 10 : u8)))
                    (set! out-pos (+ out-pos 1))
                    (set! run-active false))))))
          (set! i (+ i 1))))
      (when
        run-active
        (begin
          (text_buf_borrowed.copy-byte-range-into
            run-data
            run-start
            (- run-end run-start)
            dst
            out-pos)
          (set! out-pos (+ out-pos (- run-end run-start)))))
      unit)))

;; The single render of the group: one allocation in the active arena, then the
;; surviving records' bytes blitted straight in. Records carry their own source
;; string, so the group never has to be flattened first.
(define (compiler-backend-peephole-records-render
  [v : CompilerBackendPeepholeLineVec]) : String
  (let
    [total : i64 (compiler-backend-peephole-records-length v)]
    (if (= total 0)
      ""
      (let
        [out : (Array u8) (array.make-array u8 total)]
        [dst : (MutPtr u8)
          (unsafe
            (array-data out))]
        (begin
          (compiler-backend-peephole-records-blit! v dst)
          (unsafe
            (string-from-bytes (ptr-cast dst : (Ptr u8)) total)))))))

;; Optimize only the accumulated function group.  The group's chunks are parsed
;; in place; the complete peephole result is allocated in the caller arena
;; before the scoped record arena is released.
(define (compiler-backend-peephole-chunk-state-flush
  [state : CompilerBackendPeepholeChunkState]) : CompilerBackendPeepholeChunkState
  (if (text_buf.empty? (struct-get state group))
    state
    (let
      [output-arena : arena.Arena (arena.current)]
      [render-arena : arena.Arena (arena.make)]
      (begin
        (unsafe
          (arena.set! render-arena))
        (let
          [chunks : CompilerBackendPeepholeChunkArray
            (compiler-backend-peephole-chunk-array (struct-get state group))]
          [records : CompilerBackendPeepholeLineVec
            (compiler-backend-peephole-asm-once-records-chunks chunks)]
          (begin
            (unsafe
              (arena.set! output-arena))
            (let
              [peepholed-asm : String
                (compiler-backend-peephole-records-render records)]
              (begin
                (unsafe
                  (arena.destroy render-arena))
                (CompilerBackendPeepholeChunkState
                  (text_buf.append (struct-get state out) peepholed-asm)
                  (text_buf.empty))))))))))

(define (compiler-backend-peephole-text-buf-once-in-arena
  [buf : text_buf.TextBuf]
  [group-arena : arena.Arena]) : text_buf.TextBuf
  (let
    [chunks : text_buf.TextBufChunkList (struct-get buf chunks)]
    [chunk-count : i64 (text_buf.chunk-count chunks 0)]
    [items : (Array String) (array.make-array String chunk-count)]
    [initial : CompilerBackendPeepholeChunkState
      (CompilerBackendPeepholeChunkState (text_buf.empty) (text_buf.empty))]
    (begin
      (text_buf.chunks-fill-array-rev chunks items (- chunk-count 1))
      (let
        [state : CompilerBackendPeepholeChunkState initial]
        [i : i64 0]
        (begin
          (while (< i chunk-count)
            (let
              [chunk : String (array-ref items i)]
              [at-boundary : CompilerBackendPeepholeChunkState
                (if (and
                  (compiler-backend-peephole-chunk-starts-global? chunk)
                  (not (text_buf.empty? (struct-get state group))))
                  (compiler-backend-peephole-chunk-state-flush state)
                  state)]
              [group : text_buf.TextBuf
                (in-arena
                  group-arena
                  (text_buf.append (struct-get at-boundary group) chunk))]
              (begin
                (set!
                  state
                  (CompilerBackendPeepholeChunkState
                    (struct-get at-boundary out)
                    group))
                (set! i (+ i 1)))))
          (let
            [flushed : CompilerBackendPeepholeChunkState
              (compiler-backend-peephole-chunk-state-flush state)]
            (struct-get flushed out)))))))

(define (compiler-backend-peephole-text-buf-once [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (compiler-backend-peephole-text-buf-once-in-arena buf (arena.current)))

(define (compiler-backend-arena-owner-current-head [owner : arena.Arena]) : arena.Arena
  (let
    [handle : i64 (arena.raw-handle owner)]
    (if (= handle 0)
      owner
      (let
        [root-candidate : i64
          (unsafe
            (ptr-read (ptr-offset (int->ptr handle : (Ptr i64)) 5)))]
        [root : i64
          (if (= root-candidate 0)
            handle
            root-candidate)]
        [head : i64
          (unsafe
            (ptr-read (ptr-offset (int->ptr root : (Ptr i64)) 7)))]
        (arena.Arena
          (if (= head 0)
            root
            head))))))

(define (compiler-backend-assembly-stream-carry-home-current!
  [home-arena : arena.Arena]) : unit
  ;; Rendering/appending the retained group can grow `home-arena`. Carry its
  ;; root-tracked current head into the next flush instead of re-entering the
  ;; old segment and creating a detached sibling overflow chain.
  (set!
    compiler-backend-assembly-stream-home-arena
    (compiler-backend-arena-owner-current-head home-arena)))

;; Flush one raw function group through the record pipeline. `scratch` is active
;; on entry and rewound before return: the chunk index, the line records and
;; every synthesized line live there, and only the single rendered group string
;; escapes into `home`. The group's raw chunks are parsed where the emitter left
;; them, so the flush neither flattens nor copies them -- one write per surviving
;; byte, into the final group string.
(define (compiler-backend-peephole-sweep-chunk-state-flush
  [state : CompilerBackendPeepholeSweepChunkState]
  [scratch-mark : arena.ArenaMark]
  [home-arena : arena.Arena]) : CompilerBackendPeepholeSweepChunkState
  (if (text_buf.empty? (struct-get state group))
    state
    (let
      [chunks : CompilerBackendPeepholeChunkArray
        (compiler-backend-peephole-chunk-array (struct-get state group))]
      [records : CompilerBackendPeepholeLineVec
        (compiler-backend-peephole-asm-once-records-chunks chunks)]
      [cursor : i64
        (compiler-backend-deadstore-sweep-records!
          records
          (struct-get state sweep-cursor))]
      [finished : CompilerBackendPeepholeSweepChunkState
        (in-arena
          home-arena
          (let
            [kept : String (compiler-backend-peephole-records-render records)]
            (CompilerBackendPeepholeSweepChunkState
              (text_buf.append (struct-get state out) kept)
              (text_buf.empty)
              cursor)))]
      [_carry-home : unit
        (compiler-backend-assembly-stream-carry-home-current! home-arena)]
      (begin
        (unsafe
          (arena.rewind scratch-mark))
        finished))))

(define (compiler-backend-assembly-stream-active?) : bool
  compiler-backend-assembly-stream-active)

(define (compiler-backend-assembly-stream-start!
  [raw-arena : arena.Arena]
  [raw-mark : arena.ArenaMark]
  [peephole-arena : arena.Arena]
  [peephole-mark : arena.ArenaMark]
  [home-arena : arena.Arena]) : unit
  (let
    [batch : text_buf.TextBuf (in-arena raw-arena (text_buf.empty))]
    (begin
      (set! compiler-backend-assembly-stream-raw-arena raw-arena)
      (set! compiler-backend-assembly-stream-raw-mark raw-mark)
      (set! compiler-backend-assembly-stream-peephole-arena peephole-arena)
      (set! compiler-backend-assembly-stream-peephole-mark peephole-mark)
      (set!
        compiler-backend-assembly-stream-out
        (in-arena home-arena (text_buf.empty)))
      (set! compiler-backend-assembly-stream-home-arena home-arena)
      (set! compiler-backend-assembly-stream-sweep-cursor 0)
      (set! compiler-backend-assembly-stream-batch batch)
      (set! compiler-backend-assembly-stream-batch-count 0)
      (set! compiler-backend-assembly-stream-raw-ready false)
      (set! compiler-backend-assembly-stream-active true))))

(define (compiler-backend-assembly-stream-begin-raw!) : unit
  (when
    compiler-backend-assembly-stream-active
    (begin
      (unsafe
        (arena.set! compiler-backend-assembly-stream-raw-arena))
      (unless
        compiler-backend-assembly-stream-raw-ready
        (begin
          (unsafe
            (arena.rewind compiler-backend-assembly-stream-raw-mark))
          (compiler-backend-clear-function-emit-state!)
          (set! compiler-backend-assembly-stream-raw-ready true))))))

(define (compiler-backend-assembly-stream-rewind-raw!) : unit
  ;; Raw function text stays until a bounded batch has passed peephole/sweep.
  unit)

;; Flush the current bounded raw batch, then reclaim its arena before the next
;; batch. The emitted output and sweep cursor are copied into the home-owned
;; stream state, so no references into the rewound raw arena remain.
(define (compiler-backend-assembly-stream-flush-batch!) : unit
  (unless
    (or
      (not compiler-backend-assembly-stream-active)
      (text_buf.empty? compiler-backend-assembly-stream-batch))
    (let
      [source-arena : arena.Arena (arena.current)]
      [state : CompilerBackendPeepholeSweepChunkState
        (CompilerBackendPeepholeSweepChunkState
          compiler-backend-assembly-stream-out
          compiler-backend-assembly-stream-batch
          compiler-backend-assembly-stream-sweep-cursor)]
      (begin
        (unsafe
          (arena.set! compiler-backend-assembly-stream-peephole-arena))
        (let
          [flushed : CompilerBackendPeepholeSweepChunkState
            (compiler-backend-peephole-sweep-chunk-state-flush
              state
              compiler-backend-assembly-stream-peephole-mark
              compiler-backend-assembly-stream-home-arena)]
          (begin
            (set! compiler-backend-assembly-stream-out (struct-get flushed out))
            (set!
              compiler-backend-assembly-stream-sweep-cursor
              (struct-get flushed sweep-cursor))
            (set! compiler-backend-assembly-stream-batch-count 0)
            (unsafe
              (arena.set! compiler-backend-assembly-stream-raw-arena))
            (unsafe
              (arena.rewind compiler-backend-assembly-stream-raw-mark))
            (set! compiler-backend-assembly-stream-batch (text_buf.empty))
            (compiler-backend-clear-function-emit-state!)
            (set! compiler-backend-assembly-stream-raw-ready true)
            (unsafe
              (arena.set! source-arena))))))))

;; Append one function/adapter emission. A batch boundary is also a `.globl`
;; boundary, so flushing it preserves the legacy whole-stream peephole output.
(define (compiler-backend-assembly-stream-process-string! [raw-asm : String]) : unit
  (when
    compiler-backend-assembly-stream-active
    (begin
      (set!
        compiler-backend-assembly-stream-batch
        (text_buf.append compiler-backend-assembly-stream-batch raw-asm))
      (set!
        compiler-backend-assembly-stream-batch-count
        (+ compiler-backend-assembly-stream-batch-count 1))
      (when
        (>=
          compiler-backend-assembly-stream-batch-count
          compiler-backend-assembly-stream-batch-function-limit)
        (compiler-backend-assembly-stream-flush-batch!)))))

(define (compiler-backend-assembly-stream-process-buffer!
  [raw : text_buf.TextBuf]) : unit
  (unless
    (or (not compiler-backend-assembly-stream-active) (text_buf.empty? raw))
    (begin
      (compiler-backend-assembly-stream-flush-batch!)
      (compiler-backend-assembly-stream-process-string! (text_buf.render raw))
      (compiler-backend-assembly-stream-flush-batch!))))

(define (compiler-backend-assembly-stream-output) : text_buf.TextBuf
  (if compiler-backend-assembly-stream-active
    compiler-backend-assembly-stream-out
    (text_buf.empty)))

(define (compiler-backend-assembly-stream-finish!) : text_buf.TextBuf
  (begin
    (compiler-backend-assembly-stream-flush-batch!)
    (let
      [out : text_buf.TextBuf (compiler-backend-assembly-stream-output)]
      (begin
        (set! compiler-backend-assembly-stream-active false)
        out))))

(define (compiler-backend-assembly-stream-abort!) : unit
  (set! compiler-backend-assembly-stream-active false))

;; Byte length of the emitted direct-jump prefix `"    jmp "`, shared by the
;; fallthrough-chain recognizer below and its operand-range computation so the
;; two cannot drift.
(define (compiler-backend-asm-jmp-prefix-len) : i64
  8)

;; A line that is a label followed by `:` and nothing else. Whitespace anywhere
;; (an indented directive, `.globl sym`, a label with a trailing comment) or an
;; interior colon disqualifies it, so only real label definitions -- the one
;; thing that emits zero bytes -- can separate a `jmp` from its target.
(define (compiler-backend-asm-label-def-line?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (if (< (- end start) 2)
    false
    (if (not (= (compiler-backend-peephole-byte-at data (- end 1)) 58))
      false
      (let
        [limit : i64 (- end 1)]
        [i : i64 start]
        [ok : bool true]
        (begin
          (while (and ok (< i limit))
            (let
              [b : i64 (compiler-backend-peephole-byte-at data i)]
              (begin
                (if (or (= b 32) (= b 9) (= b 58))
                  (set! ok false)
                  unit)
                (set! i (+ i 1)))))
          ok)))))

;; Does the line begin with the emitted direct-jump prefix `"    jmp "`?
;; Tested byte-wise, `j` first: this runs on every line of the body, and the `j`
;; alone rejects all but a handful of them for one load and compare. Comparing a
;; string literal here instead cost enough per line to move the self_compile
;; instruction-count row.
(define (compiler-backend-asm-jmp-prefix-at? [data : (Ptr u8)] [start : i64]) : bool
  (and
    (= (compiler-backend-peephole-byte-at data (+ start 4)) 106)
    (= (compiler-backend-peephole-byte-at data (+ start 5)) 109)
    (= (compiler-backend-peephole-byte-at data (+ start 6)) 112)
    (= (compiler-backend-peephole-byte-at data (+ start 7)) 32)
    (= (compiler-backend-peephole-byte-at data start) 32)
    (= (compiler-backend-peephole-byte-at data (+ start 1)) 32)
    (= (compiler-backend-peephole-byte-at data (+ start 2)) 32)
    (= (compiler-backend-peephole-byte-at data (+ start 3)) 32)))

;; A line that is exactly `    jmp <symbol>`. The operand must be a bare
;; symbol: `*`, `%`, `(` and `,` reject the indirect register/memory/table
;; forms, and whitespace rejects operands with a suffix or comment.
(define (compiler-backend-asm-direct-jmp-line?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [operand-start : i64 (+ start (compiler-backend-asm-jmp-prefix-len))]
    (if (<= end operand-start)
      false
      (if (not (compiler-backend-asm-jmp-prefix-at? data start))
        false
        (let
          [i : i64 operand-start]
          [ok : bool true]
          (begin
            (while (and ok (< i end))
              (let
                [b : i64 (compiler-backend-peephole-byte-at data i)]
                (begin
                  (if (or (= b 32) (= b 9) (= b 42) (= b 37) (= b 40) (= b 44))
                    (set! ok false)
                    unit)
                  (set! i (+ i 1)))))
            ok))))))

;; Delete every unconditional `jmp` whose target execution would reach anyway by
;; falling through nothing but label definitions.
;;
;; `compiler-backend-jump-target-is-fallthrough?` can only suppress a
;; terminator's `jmp` when the target is the IMMEDIATELY next block. When the
;; target is instead reached through a CHAIN of blocks that each emit zero
;; instructions, the `jmp` survives and jumps to the very next instruction. That
;; shape is pervasive: source-level `(if c (begin ...) unit)` leaves an else
;; block whose own jump was already fallthrough-suppressed and whose phi-edge
;; copies coalesced to nothing, so the then block's `jmp` lands on `else:`
;; `merge:` and falls straight through.
;;
;; The rewrite is unconditionally correct at the machine level: deleting the
;; `jmp` makes execution fall through zero emitted bytes to the exact same
;; label. It runs on the fully assembled function body -- after the prologue
;; splice, rsp rebase and FPO audit -- so every emitted byte is visible,
;; including the assembler directives (`.p2align`, `.seh_*`, `.cfi_*`) that must
;; inhibit it, and both text targets share the one seam. Only a run of pure
;; label-definition lines may separate the `jmp` from its target; anything else
;; (instruction, directive, comment, blank line) keeps it, as does a target
;; never seen scanning forward -- backward jumps, i.e. loop back edges and the
;; `call tl_oob_abort` / `jmp self` trap loops.
;;
;; One forward pass over the lines, examining each exactly once (linear, no
;; rescans; the self-compile body text is megabytes). At most one candidate
;; `jmp` is deferred at a time, and it is resolved before the next can start, so
;; the deleted line ranges are discovered in increasing position order.
;;
;; The rewrite only ever DELETES whole lines, so the output is the input minus
;; those ranges: the buffer is fed the COMPLEMENT, one slice per deletion,
;; rather than one slice per line. Appending line by line rebuilt the immutable
;; buffer and its head chunk on every one of the ~10^6 lines of a large module,
;; which cost more than the pass saved at `--opt-level 1` (few empty blocks, so
;; few deletions) and moved the gated self_compile row. A body with no deletion
;; now allocates nothing at all and is returned unchanged, and an unresolved
;; candidate needs no special case: a backward jump is simply never excised.
(define (compiler-backend-drop-fallthrough-jumps [asm : String]) : String
  (let
    [n : i64 (string.string-length asm)]
    [asm-data : (Ptr u8)
      (unsafe
        (string-data asm))]
    [i : i64 0]
    [out : (text_buf_borrowed.TextBufBorrowed asm)
      (text_buf_borrowed.empty-like (& asm))]
    ;; First byte not yet handed to `out`; deletions advance it past the
    ;; excised line.
    [copy-start : i64 0]
    ;; Deferred candidate: its own line range and its target operand range.
    [pending? : bool false]
    [jmp-start : i64 0]
    [jmp-stop : i64 0]
    [target-start : i64 0]
    [target-stop : i64 0]
    ;; Did the pending-candidate arm already account for the current line?
    [consumed? : bool false]
    [dropped : i64 0]
    (begin
      (while (< i n)
        (let
          [end : i64 (compiler-backend-peephole-line-end asm-data i n)]
          [next-start : i64
            (if (< end n)
              (+ end 1)
              end)]
          (begin
            (set! consumed? false)
            (if pending?
              (if (compiler-backend-asm-label-def-line? asm-data i end)
                (begin
                  (set! consumed? true)
                  (if (compiler-backend-peephole-ranges-eq?
                    asm-data
                    target-start
                    target-stop
                    asm-data
                    i
                    (- end 1))
                    ;; Target reached across label definitions only: excise the
                    ;; `jmp` line by copying everything before it and resuming
                    ;; after it.
                    (begin
                      (set!
                        out
                        (text_buf_borrowed.append-slice
                          out
                          (& asm)
                          copy-start
                          (- jmp-start copy-start)))
                      (set! copy-start jmp-stop)
                      (set! dropped (+ dropped 1))
                      (set! pending? false))
                    unit))
                ;; Emitted bytes intervene: the `jmp` stays (it is still inside
                ;; the uncopied region), and the arm below reconsiders this line.
                (set! pending? false))
              unit)
            (if consumed?
              unit
              (if (compiler-backend-asm-direct-jmp-line? asm-data i end)
                (begin
                  (set! pending? true)
                  (set! jmp-start i)
                  (set! jmp-stop next-start)
                  (set!
                    target-start
                    (+ i (compiler-backend-asm-jmp-prefix-len)))
                  (set! target-stop end))
                unit))
            (set! i next-start))))
      (if (= dropped 0)
        asm
        (text_buf_borrowed.render
          (text_buf_borrowed.append-slice
            out
            (& asm)
            copy-start
            (- n copy-start)))))))

;; Streaming peephole over line RECORDS: identical rule set, pair state and
;; owner-map handling to the text pass it replaces, except that each surviving
;; emit step pushes its record into a dense arena-backed array instead of
;; appending bytes. The array is the pipeline: the dead-store sweep consumes it
;; and the group is rendered exactly once, afterwards.
;;
;; The walk runs over the group's physical chunks, parsing each in place; a
;; record's `src` is the chunk its line came from. Chunk boundaries are NOT
;; pass boundaries: `pending`, the owner map and `prev-abort?` all carry across
;; them, so a pair whose two lines sit in different chunks still forms exactly
;; as it did when the group was flattened first.
(define (compiler-backend-peephole-asm-once-records-chunks
  [chunks : CompilerBackendPeepholeChunkArray]) : CompilerBackendPeepholeLineVec
  (let
    [items : (Array String) (struct-get chunks items)]
    [chunk-count : i64 (struct-get chunks count)]
    [out : CompilerBackendPeepholeLineVec
      (compiler-backend-peephole-line-vec-with-capacity
        (compiler-backend-peephole-line-vec-capacity-for
          (struct-get chunks total)))]
    [has-pending : bool false]
    [pending : CompilerBackendPeepholeLine
      (compiler-backend-peephole-empty-line)]
    ;; SCAV2: was the last EMITTED line a noreturn abort call?
    [prev-abort? : bool false]
    [owners : CompilerBackendPeepholeOwners
      (compiler-backend-peephole-owners-empty)]
    [guard-owners-active? : bool false]
    [guard-owners : CompilerBackendPeepholeOwners
      (compiler-backend-peephole-owners-empty)]
    [c : i64 0]
    (begin
      (compiler-backend-peephole-owner-global-reset!)
      (while (< c chunk-count)
        (let
          [asm : String (array-ref items c)]
          [n : i64 (string.string-length asm)]
          [asm-data : (Ptr u8)
            (unsafe
              (string-data asm))]
          [i : i64 0]
          (begin
            (while (< i n)
              (let
                [end : i64 (compiler-backend-peephole-line-end asm-data i n)]
                [next-start : i64
                  (if (< end n)
                    (+ end 1)
                    end)]
                [line-newline : bool (< end n)]
                (begin
                  (if has-pending
                    (let
                      [line : CompilerBackendPeepholeLine
                        (compiler-backend-peephole-parse-line
                          asm
                          asm-data
                          i
                          end
                          line-newline
                          false)]
                      [action : i64
                        (compiler-backend-peephole-pair-action-desc
                          chunks
                          c
                          pending
                          line)]
                      (cond
                        [(= action 1)
                          (set!
                            pending
                            (compiler-backend-peephole-line-copy line))]
                        [(= action 2) unit]
                        [(= action 3)
                          (let
                            [forwarded-line : String
                              (compiler-backend-peephole-forward-frame-load-line-desc
                                pending
                                line)]
                            (begin
                              (let
                                [emit : CompilerBackendPeepholeEmitRecordResult
                                  (compiler-backend-peephole-emit-line-desc-record
                                    out
                                    pending
                                    owners
                                    prev-abort?)]
                                (begin
                                  (set! out (struct-get emit lines))
                                  (set! owners (struct-get emit owners))))
                              (set!
                                prev-abort?
                                (compiler-backend-peephole-desc-noreturn-abort?
                                  pending))
                              (set!
                                pending
                                (compiler-backend-peephole-owned-line
                                  forwarded-line
                                  line-newline))))]
                        [(= action 4)
                          (let
                            [folded-line : String
                              (compiler-backend-peephole-r10-base-fold-line-desc
                                pending
                                line)]
                            (set!
                              pending
                              (compiler-backend-peephole-owned-line
                                folded-line
                                line-newline)))]
                        [else
                          (let
                            [restore-guard-owners? : bool
                              (and
                                guard-owners-active?
                                (compiler-backend-peephole-desc-guard-ok-label?
                                  pending))]
                            [emit : CompilerBackendPeepholeEmitRecordResult
                              (compiler-backend-peephole-emit-line-desc-record
                                out
                                pending
                                (if restore-guard-owners?
                                  (compiler-backend-peephole-owners-copy
                                    guard-owners)
                                  owners)
                                (or prev-abort? restore-guard-owners?))]
                            (begin
                              (set! out (struct-get emit lines))
                              (set! owners (struct-get emit owners))
                              (when
                                restore-guard-owners?
                                (set! guard-owners-active? false))
                              (when
                                (and
                                  (compiler-backend-peephole-desc-pushq? line)
                                  (compiler-backend-peephole-desc-guard-ok-branch?
                                    pending))
                                (begin
                                  (set!
                                    guard-owners
                                    (compiler-backend-peephole-owners-copy
                                      owners))
                                  (set! guard-owners-active? true)))
                              (set!
                                prev-abort?
                                (compiler-backend-peephole-desc-noreturn-abort?
                                  pending))
                              (set!
                                pending
                                (compiler-backend-peephole-line-copy line))))]))
                    (begin
                      (set! has-pending true)
                      (set!
                        pending
                        (compiler-backend-peephole-line-copy
                          (compiler-backend-peephole-parse-line
                            asm
                            asm-data
                            i
                            end
                            line-newline
                            false)))))
                  (set! i next-start))))
            (set! c (+ c 1)))))
      (if (and
        has-pending
        (not (compiler-backend-peephole-line-self-move-desc? pending)))
        (let
          [emit : CompilerBackendPeepholeEmitRecordResult
            (compiler-backend-peephole-emit-line-desc-record
              out
              pending
              owners
              prev-abort?)]
          (begin
            (set! out (struct-get emit lines))
            (set! owners (struct-get emit owners))))
        unit)
      out)))

(define (compiler-backend-peephole-asm-once-records [asm : String]) : CompilerBackendPeepholeLineVec
  (compiler-backend-peephole-asm-once-records-chunks
    (compiler-backend-peephole-single-chunk-array asm)))

;; The single render of the group: append each surviving record's exact bytes
;; plus its newline flag. Runs of adjacent surviving asm lines coalesce into
;; one borrowed slice, so a group that the sweep did not touch renders as a
;; single copy of its range.
(define (compiler-backend-peephole-records-buffer
  [out : (text_buf_borrowed.TextBufBorrowed asm)]
  [v : CompilerBackendPeepholeLineVec]
  [asm : String]) : (text_buf_borrowed.TextBufBorrowed asm)
  (let
    [recs : (Array CompilerBackendPeepholeLineRecord) (struct-get v lines)]
    [live : (Array i64) (struct-get v live)]
    [count : i64 (struct-get v len)]
    [buf : (text_buf_borrowed.TextBufBorrowed asm) out]
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (when
            (= (array-ref live i) 1)
            (let
              [rec : CompilerBackendPeepholeLineRecord (array-ref recs i)]
              (set!
                buf
                (if (compiler-backend-peephole-record-owned? rec)
                  (compiler-backend-peephole-append-line
                    buf
                    (struct-get rec src)
                    (compiler-backend-peephole-record-newline? rec))
                  (compiler-backend-peephole-append-line-range
                    buf
                    asm
                    (compiler-backend-peephole-record-start rec)
                    (compiler-backend-peephole-record-end rec)
                    (compiler-backend-peephole-record-newline? rec))))))
          (set! i (+ i 1))))
      buf)))

(define (compiler-backend-peephole-asm-once [asm : String]) : String
  (text_buf_borrowed.render
    (compiler-backend-peephole-records-buffer
      (text_buf_borrowed.empty-like (& asm))
      (compiler-backend-peephole-asm-once-records asm)
      asm)))

(define (compiler-backend-peephole-asm-buffer [asm : String]) : text_buf.TextBuf
  ;; The streaming pass runs the complete rule set while each line pair and its
  ;; owner state are hot. Re-running it used to parse and copy the whole ~40MB
  ;; self-compile assembly again to remove only ~1% as many bytes as the first
  ;; pass (~10KB after ~910KB). Keep that marginal reapplication out of the
  ;; compile path; the missed cascades are optional code-size rewrites.
  ;; GAP5 then sweeps never-read local frame stores recorded during emission --
  ;; over the same records, so the text is rendered exactly once.
  (let
    [records : CompilerBackendPeepholeLineVec
      (compiler-backend-peephole-asm-once-records asm)]
    [_swept : i64 (compiler-backend-deadstore-sweep-records! records 0)]
    [buf : text_buf.TextBuf
      (compiler-backend-borrowed-copy-to-owned
        (compiler-backend-peephole-records-buffer
          (text_buf_borrowed.empty-like (& asm))
          records
          asm))]
    (begin
      (compiler-backend-deadstore-sweep-report-and-reset!)
      buf)))

(define (compiler-backend-peephole-asm [asm : String]) : String
  (text_buf.render (compiler-backend-peephole-asm-buffer asm)))

(define (compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt-and-profile-state
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : ResultCompilerBackendBuffer
  ;; Stream prefix/function/adapter/tail emission through peephole and sweep.
  ;; Each function's raw arena is rewound as soon as its final output chunk is
  ;; copied home, so the backend never retains the program's raw function text.
  (let
    [home-arena : arena.Arena (arena.current)]
    [emit-arena : arena.Arena (arena.make)]
    [raw-arena : arena.Arena (arena.make)]
    [peephole-arena : arena.Arena (arena.make)]
    (begin
      (unsafe
        (arena.set! raw-arena))
      (let
        [raw-mark : arena.ArenaMark (arena.mark)]
        (begin
          (unsafe
            (arena.set! peephole-arena))
          (let
            [peephole-mark : arena.ArenaMark (arena.mark)]
            (begin
              (unsafe
                (arena.set! emit-arena))
              (compiler-backend-assembly-stream-start!
                raw-arena
                raw-mark
                peephole-arena
                peephole-mark
                home-arena)
              (let
                [emitted : ResultCompilerBackendBuffer
                  (if crt-entry
                    (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state
                      type-segment-bases
                      program
                      target
                      mode
                      spans
                      emit-entry
                      crt-entry
                      false
                      profile-state)
                    (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state
                      type-segment-bases
                      program
                      target
                      mode
                      spans
                      emit-entry
                      false
                      false
                      profile-state))]
                (match emitted
                  [(ResultCompilerBackendBuffer.Ok _)
                    (let
                      [final : text_buf.TextBuf
                        (compiler-backend-assembly-stream-finish!)]
                      [final-home-arena : arena.Arena
                        compiler-backend-assembly-stream-home-arena]
                      (begin
                        (unsafe
                          (arena.destroy emit-arena))
                        (unsafe
                          (arena.destroy raw-arena))
                        (unsafe
                          (arena.set! final-home-arena))
                        (compiler-backend-deadstore-sweep-report-and-reset!)
                        (unsafe
                          (arena.destroy peephole-arena))
                        (compiler-backend-clear-scratch-escaped-emit-state!)
                        (ResultCompilerBackendBuffer.Ok final)))]
                  [(ResultCompilerBackendBuffer.Err message)
                    (begin
                      ;; Preserve arenas that may own the diagnostic, matching
                      ;; the legacy error lifetime contract.
                      (compiler-backend-assembly-stream-abort!)
                      (unsafe
                        (arena.set! compiler-backend-assembly-stream-home-arena))
                      (unsafe
                        (arena.destroy peephole-arena))
                      (compiler-backend-clear-scratch-escaped-emit-state!)
                      (ResultCompilerBackendBuffer.Err message))])))))))))

(define (compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendBuffer
  (compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt-and-profile-state
    type-segment-bases
    program
    target
    mode
    spans
    emit-entry
    crt-entry
    (profile_state.compiler-profile-state-new)))

(define (compiler-backend-emit-program-target-with-mode-final-buffer-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendBuffer
  (compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt
    (ast-node-pool-reader-type-segment-bases)
    program
    target
    mode
    spans
    emit-entry
    crt-entry))

(define (compiler-backend-emit-program-target-with-mode-final-buffer-with-pools-and-crt
  [pools : AstNodePoolContext]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendBuffer
  (compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt
    (ast-node-pool-context-type-segment-bases pools)
    program
    target
    mode
    spans
    emit-entry
    crt-entry))

(define (compiler-backend-emit-program-target-with-mode-final-buffer-with-pools-and-crt-and-profile-state
  [pools : AstNodePoolContext]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : ResultCompilerBackendBuffer
  (compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt-and-profile-state
    (ast-node-pool-context-type-segment-bases pools)
    program
    target
    mode
    spans
    emit-entry
    crt-entry
    profile-state))

(define (compiler-backend-emit-program-target-with-mode-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackend
  (match (compiler-backend-emit-program-target-with-mode-final-buffer-and-crt
    program
    target
    mode
    spans
    emit-entry
    crt-entry)
    [(ResultCompilerBackendBuffer.Ok buf)
      (ResultCompilerBackend.Ok (text_buf.render buf))]
    [(ResultCompilerBackendBuffer.Err message)
      (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-program-target-with-mode-with-pools-and-crt
  [pools : AstNodePoolContext]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackend
  (match (compiler-backend-emit-program-target-with-mode-final-buffer-with-pools-and-crt
    pools
    program
    target
    mode
    spans
    emit-entry
    crt-entry)
    [(ResultCompilerBackendBuffer.Ok buf)
      (ResultCompilerBackend.Ok (text_buf.render buf))]
    [(ResultCompilerBackendBuffer.Err message)
      (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-program-target-with-mode-with-pools-and-crt-and-profile-state
  [pools : AstNodePoolContext]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : ResultCompilerBackend
  (match (compiler-backend-emit-program-target-with-mode-final-buffer-with-pools-and-crt-and-profile-state
    pools
    program
    target
    mode
    spans
    emit-entry
    crt-entry
    profile-state)
    [(ResultCompilerBackendBuffer.Ok buf)
      (ResultCompilerBackend.Ok (text_buf.render buf))]
    [(ResultCompilerBackendBuffer.Err message)
      (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-program-target-with-mode
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackend
  (compiler-backend-emit-program-target-with-mode-and-crt
    program
    target
    mode
    spans
    emit-entry
    false))

(define (compiler-backend-target-cfgs [target : CompilerBackendTarget]) : sym_i64_env.SymI64Env
  (match target
    [(CompilerBackendTarget.Linux)
      (compiler-cfg-enable
        (compiler-cfg-enable
          (compiler-cfg-enable
            (compiler-cfg-enable (compiler-cfg-empty) "linux")
            "unix")
          "target-linux")
        "os-linux")]
    [(CompilerBackendTarget.Windows)
      (compiler-cfg-enable
        (compiler-cfg-enable
          (compiler-cfg-enable (compiler-cfg-empty) "windows")
          "target-windows")
        "os-windows")]))

(define (compiler-backend-lower-mode-for-target
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]) : CompilerLowerMode
  (match mode
    [(CompilerBackendMode.Avx2)
      (match target
        [(CompilerBackendTarget.Linux) (CompilerLowerMode.LinuxAvx2)]
        [(CompilerBackendTarget.Windows) (CompilerLowerMode.WindowsAvx2)])]
    [(CompilerBackendMode.Avx512)
      (match target
        [(CompilerBackendTarget.Linux) (CompilerLowerMode.LinuxAvx512)]
        [(CompilerBackendTarget.Windows) (CompilerLowerMode.WindowsAvx512)])]
    [_
      (match target
        [(CompilerBackendTarget.Linux) (CompilerLowerMode.LinuxScalar)]
        [(CompilerBackendTarget.Windows) (CompilerLowerMode.WindowsScalar)])]))

(define (compiler-backend-lower-source-for-target
  [src : String]
  [target : CompilerBackendTarget]) : ResultCompilerLower
  (begin
    (ci.intern-reset!)
    (lower-reset-intern-owned-state!)
    (cbi.compiler-builtin-reset!)
    (match (parse-ast-source-diagnostic-with-cfg
      "<source>"
      src
      (compiler-backend-target-cfgs target))
      [(ResultAstProgramDiagnostic.Ok program)
        (lower-compiler-program-with-path-mode
          "<source>"
          program
          (compiler-backend-lower-mode-for-target
            target
            (CompilerBackendMode.Scalar)))]
      [(ResultAstProgramDiagnostic.Err diag) (ResultCompilerLower.Err diag)])))

;; Session-additive variant for compiles nested inside a live build session:
;; interning, builtin ids, and typecheck caches stay untouched so the
;; enclosing session's id-keyed state remains valid. The tool-grade entry
;; above resets those globals and must never run mid-session.
(define (compiler-backend-lower-source-for-target-in-session
  [src : String]
  [target : CompilerBackendTarget]) : ResultCompilerLower
  (match (parse-ast-source-diagnostic-with-cfg
    "<source>"
    src
    (compiler-backend-target-cfgs target))
    [(ResultAstProgramDiagnostic.Ok program)
      (lower-compiler-program-with-path-mode
        "<source>"
        program
        (compiler-backend-lower-mode-for-target
          target
          (CompilerBackendMode.Scalar)))]
    [(ResultAstProgramDiagnostic.Err diag) (ResultCompilerLower.Err diag)]))

(define (compiler-backend-emit-source [src : String]) : ResultCompilerBackend
  (match (lower-compiler-source src)
    [(ResultCompilerLower.Ok program spans)
      (compiler-backend-emit-program-linux-with-spans program spans)]
    [(ResultCompilerLower.Err diag) (ResultCompilerBackend.Err diag)]))

(define (compiler-backend-emit-source-for-target
  [src : String]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (match (compiler-backend-lower-source-for-target src target)
    [(ResultCompilerLower.Ok program spans)
      (compiler-backend-emit-program-with-spans-for-target program spans target)]
    [(ResultCompilerLower.Err diag) (ResultCompilerBackend.Err diag)]))

;; Inline-by-value aggregates are the always-on default lowering, so
;; emitting "in inline-aggregates mode" is just the ordinary target emit. The
;; explicit name is retained for the backend self-tests.
(define (compiler-backend-emit-source-inline-aggregates-for-target
  [src : String]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (compiler-backend-emit-source-for-target src target))

(define (compiler-backend-emit-source-object-image [src : String]) : ResultCompilerBackendObject
  (match (lower-compiler-source src)
    [(ResultCompilerLower.Ok program spans)
      (compiler-backend-emit-program-object-image-linux program spans)]
    [(ResultCompilerLower.Err diag) (ResultCompilerBackendObject.Err diag)]))

(define (compiler-backend-emit-source-object-image-for-target
  [src : String]
  [target : CompilerBackendTarget]) : ResultCompilerBackendObject
  (match (compiler-backend-lower-source-for-target src target)
    [(ResultCompilerLower.Ok program spans)
      (compiler-backend-emit-program-object-image-target
        program
        target
        spans
        true)]
    [(ResultCompilerLower.Err diag) (ResultCompilerBackendObject.Err diag)]))

(define (compiler-backend-string-prefix-at?
  [text : String]
  [prefix : String]
  [start : i64]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< start 0)
      false
      (if (> (+ start prefix-len) text-len)
        false
        (let
          [i : i64 0]
          [ok : bool true]
          (begin
            (while ok
              (if (< i prefix-len)
                (if (=
                  (string.string-ref text (+ start i))
                  (string.string-ref prefix i))
                  (set! i (+ i 1))
                  (set! ok false))
                (set! ok false)))
            (= i prefix-len)))))))

(define (compiler-backend-string-contains? [text : String] [needle : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      true
      (let
        [i : i64 0]
        [found : bool false]
        [done : bool false]
        (begin
          (while (not done)
            (if (<= (+ i needle-len) text-len)
              (if (compiler-backend-string-prefix-at? text needle i)
                (begin
                  (set! found true)
                  (set! done true))
                (set! i (+ i 1)))
              (set! done true)))
          found)))))

(define (compiler-backend-string-count [text : String] [needle : String]) : i64
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      0
      (let
        [i : i64 0]
        [count : i64 0]
        (begin
          (while (<= (+ i needle-len) text-len)
            (if (compiler-backend-string-prefix-at? text needle i)
              (begin
                (set! count (+ count 1))
                (set! i (+ i needle-len)))
              (set! i (+ i 1))))
          count)))))

(define compiler-backend-pic-image-base-label : String
  ".L_tl_pic_image_base")

(define (compiler-backend-string-find-from
  [text : String]
  [needle : String]
  [start : i64]) : i64
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      start
      (if (= needle-len 1)
        (string.index-of-byte
          (& text)
          start
          (cast (string.string-ref needle 0) : u8))
        (let
          [i : i64 start]
          [found : i64 -1]
          [done : bool false]
          (begin
            (while (not done)
              (if (<= (+ i needle-len) text-len)
                (if (compiler-backend-string-prefix-at? text needle i)
                  (begin
                    (set! found i)
                    (set! done true))
                  (set! i (+ i 1)))
                (set! done true)))
            found))))))

(define (compiler-backend-string-replace-all
  [text : String]
  [needle : String]
  [replacement : String]) : String
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      text
      (let
        [i : i64 0]
        [out : text_buf.TextBuf (text_buf.empty)]
        [done : bool false]
        (begin
          (while (not done)
            (let
              [pos : i64 (compiler-backend-string-find-from text needle i)]
              (if (< pos 0)
                (begin
                  (if (< i text-len)
                    (set!
                      out
                      (text_buf.append
                        out
                        (string.substring text i (- text-len i))))
                    unit)
                  (set! done true))
                (begin
                  (if (> pos i)
                    (set!
                      out
                      (text_buf.append out (string.substring text i (- pos i))))
                    unit)
                  (set! out (text_buf.append out replacement))
                  (set! i (+ pos needle-len))))))
          (text_buf.render out))))))

(define (compiler-backend-pic-quad-pattern [target : String]) : String
  (str_cat.str-cat "    .quad " target "\n"))

(define (compiler-backend-pic-quad-replacement [_target : String]) : String
  "    .quad 0\n")

(define (compiler-backend-pic-rewrite-target [asm : String] [target : String]) : String
  (compiler-backend-string-replace-all
    asm
    (compiler-backend-pic-quad-pattern target)
    (compiler-backend-pic-quad-replacement target)))

(define (compiler-backend-pic-rewrite-relocs
  [asm : String]
  [relocs : cobj.CompilerObjectRelocationList]) : String
  (let
    [count : i64 (cobj.compiler-object-relocation-list-count relocs)]
    [index : i64 0]
    [out : String asm]
    (begin
      (while (< index count)
        (begin
          (match (cobj.compiler-object-relocation-list-ref relocs index)
            [(cobj.CompilerObjectRelocation.Relocation _ _ kind target)
              (match kind
                [(cobj.CompilerObjectRelocationKind.Abs64)
                  (set! out (compiler-backend-pic-rewrite-target out target))]
                [_ unit])])
          (set! index (+ index 1))))
      out)))

(define (compiler-backend-pic-align-offset [offset : i64] [align : i64]) : i64
  (if (<= align 1)
    offset
    (let
      [rem : i64 (% offset align)]
      (if (= rem 0)
        offset
        (+ offset (- align rem))))))

(define (compiler-backend-pic-data-record-end-offset
  [record : cobj.CompilerObjectDataRecord]
  [offset : i64]) : i64
  (match record
    [(cobj.CompilerObjectDataRecord.Label _) offset]
    [(cobj.CompilerObjectDataRecord.Align align)
      (compiler-backend-pic-align-offset offset align)]
    [(cobj.CompilerObjectDataRecord.Bytes bytes)
      (+ offset (string.string-length bytes))]
    [(cobj.CompilerObjectDataRecord.String text)
      (+ offset (+ (string.string-length text) 1))]
    [(cobj.CompilerObjectDataRecord.F64 _) (+ offset 8)]
    [(cobj.CompilerObjectDataRecord.F32 _) (+ offset 4)]
    [(cobj.CompilerObjectDataRecord.I64 _) (+ offset 8)]
    [(cobj.CompilerObjectDataRecord.Zero count) (+ offset count)]
    [(cobj.CompilerObjectDataRecord.SymbolAddress _) (+ offset 8)]
    [(cobj.CompilerObjectDataRecord.SymbolRva32 _) (+ offset 4)]))

(define (compiler-backend-pic-data-label-offset-from
  [records : cobj.CompilerObjectDataRecordList]
  [label : String]
  [offset : i64]) : i64
  (let
    [count : i64 (cobj.compiler-object-data-record-list-count records)]
    [index : i64 0]
    [cur-offset : i64 offset]
    [result : i64 -1]
    [done : bool false]
    (begin
      (while (and (not done) (< index count))
        (let
          [record : cobj.CompilerObjectDataRecord
            (cobj.compiler-object-data-record-list-ref records index)]
          (match record
            [(cobj.CompilerObjectDataRecord.Label found)
              (if (string.eq found label)
                (begin
                  (set! result cur-offset)
                  (set! done true))
                (set! index (+ index 1)))]
            [_
              (begin
                (set!
                  cur-offset
                  (compiler-backend-pic-data-record-end-offset
                    record
                    cur-offset))
                (set! index (+ index 1)))])))
      result)))

(define (compiler-backend-pic-section-label-offset
  [image : cobj.CompilerObjectImage]
  [kind : cobj.CompilerObjectSectionKind]
  [label : String]) : i64
  (match (cobj.compiler-object-section-list-find
    (struct-get image sections)
    kind)
    [(cobj.CompilerObjectSection.Section _ data _)
      (match kind
        [(cobj.CompilerObjectSectionKind.Text) -1]
        [_ (compiler-backend-pic-data-label-offset-from data label 0)])]))

(define (compiler-backend-pic-section-name
  [kind : cobj.CompilerObjectSectionKind]) : String
  (match kind
    [(cobj.CompilerObjectSectionKind.Text) "text"]
    [(cobj.CompilerObjectSectionKind.Data) "data"]
    [(cobj.CompilerObjectSectionKind.Rodata) "rodata"]
    [(cobj.CompilerObjectSectionKind.Bss) "bss"]
    [(cobj.CompilerObjectSectionKind.Pdata) "pdata"]
    [(cobj.CompilerObjectSectionKind.Xdata) "xdata"]
    [(cobj.CompilerObjectSectionKind.Rsrc) "rsrc"]))

(define (compiler-backend-pic-fixup-line
  [section : cobj.CompilerObjectSectionKind]
  [offset : i64]
  [site : String]
  [target : String]) : String
  (string.append
    (str_cat.str-cat
      (compiler-backend-pic-section-name section)
      " "
      (string.int->string offset)
      " "
      site)
    (string.append " " (string.append target "\n"))))

(define (compiler-backend-pic-fixup-table-relocs
  [image : cobj.CompilerObjectImage]
  [relocs : cobj.CompilerObjectRelocationList]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (let
    [count : i64 (cobj.compiler-object-relocation-list-count relocs)]
    [index : i64 0]
    [out : text_buf.TextBuf buf]
    (begin
      (while (< index count)
        (begin
          (match (cobj.compiler-object-relocation-list-ref relocs index)
            [(cobj.CompilerObjectRelocation.Relocation section site kind target)
              (match kind
                [(cobj.CompilerObjectRelocationKind.Abs64)
                  (let
                    [offset : i64
                      (compiler-backend-pic-section-label-offset
                        image
                        section
                        site)]
                    (if (>= offset 0)
                      (set!
                        out
                        (text_buf.append
                          out
                          (compiler-backend-pic-fixup-line
                            section
                            offset
                            site
                            target)))
                      unit))]
                [_ unit])])
          (set! index (+ index 1))))
      out)))

(define (compiler-backend-pic-fixup-table [image : cobj.CompilerObjectImage]) : String
  (text_buf.render
    (compiler-backend-pic-fixup-table-relocs
      image
      (struct-get image relocations)
      (text_buf.append (text_buf.empty) "typelisp-pic-fixups v1\n"))))

(define (compiler-backend-pic-symbols-have-extern?
  [symbols : cobj.CompilerObjectSymbolList]) : bool
  (let
    [count : i64 (cobj.compiler-object-symbol-list-count symbols)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (cobj.compiler-object-symbol-list-ref symbols index)
          [(cobj.CompilerObjectSymbol.Symbol _ binding _ _)
            (match binding
              [(cobj.CompilerObjectSymbolBinding.Extern) (set! found true)]
              [_ (set! index (+ index 1))])]))
      found)))

(define (compiler-backend-pic-target-symbol-internal?
  [symbols : cobj.CompilerObjectSymbolList]
  [target : String]) : bool
  (let
    [count : i64 (cobj.compiler-object-symbol-list-count symbols)]
    [index : i64 0]
    [result : bool false]
    [done : bool false]
    (begin
      (while (and (not done) (< index count))
        (match (cobj.compiler-object-symbol-list-ref symbols index)
          [(cobj.CompilerObjectSymbol.Symbol name binding _ section)
            (if (string.eq name target)
              (begin
                (set!
                  result
                  (match binding
                    [(cobj.CompilerObjectSymbolBinding.Extern) false]
                    [_
                      (match section
                        [(cobj.CompilerObjectMaybeSection.No) false]
                        [_ true])]))
                (set! done true))
              (set! index (+ index 1)))]))
      result)))

(define (compiler-backend-pic-reloc-site-valid?
  [image : cobj.CompilerObjectImage]
  [reloc : cobj.CompilerObjectRelocation]) : bool
  (match reloc
    [(cobj.CompilerObjectRelocation.Relocation section site kind target)
      (match kind
        [(cobj.CompilerObjectRelocationKind.Abs64)
          (and
            (compiler-backend-pic-target-symbol-internal?
              (struct-get image symbols)
              target)
            (match section
              [(cobj.CompilerObjectSectionKind.Data)
                (let
                  [offset : i64
                    (compiler-backend-pic-section-label-offset
                      image
                      section
                      site)]
                  (and (>= offset 0) (= (% offset 8) 0)))]
              [(cobj.CompilerObjectSectionKind.Rodata)
                (let
                  [offset : i64
                    (compiler-backend-pic-section-label-offset
                      image
                      section
                      site)]
                  (and (>= offset 0) (= (% offset 8) 0)))]
              [_ false]))]
        [_ true])]))

(define (compiler-backend-pic-relocs-valid?
  [image : cobj.CompilerObjectImage]
  [relocs : cobj.CompilerObjectRelocationList]) : bool
  (let
    [count : i64 (cobj.compiler-object-relocation-list-count relocs)]
    [index : i64 0]
    [ok : bool true]
    (begin
      (while (and ok (< index count))
        (if (compiler-backend-pic-reloc-site-valid?
          image
          (cobj.compiler-object-relocation-list-ref relocs index))
          (set! index (+ index 1))
          (set! ok false)))
      ok)))

(define (compiler-backend-pic-asm
  [asm : String]
  [image : cobj.CompilerObjectImage]) : String
  (string.append
    (str_cat.str-cat ".text\n" compiler-backend-pic-image-base-label ":\n")
    (compiler-backend-pic-rewrite-relocs asm (struct-get image relocations))))

(define (compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt-and-profile-state
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [profile-state : profile_state.CompilerProfileState]) : ResultCompilerBackendPic
  (match (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state
    type-segment-bases
    program
    target
    mode
    spans
    emit-entry
    crt-entry
    true
    profile-state)
    [(ResultCompilerBackendBuffer.Ok buf)
      (match (compiler-backend-emit-program-object-image-target-with-mode-with-type-segment-bases-and-crt-and-profile-state
        type-segment-bases
        program
        target
        mode
        spans
        emit-entry
        crt-entry
        profile-state)
        [(ResultCompilerBackendObject.Ok image)
          (if (compiler-backend-pic-symbols-have-extern?
            (struct-get image symbols))
            (ResultCompilerBackendPic.Err
              (box
                (compiler-diagnostic-at-start
                  ""
                  "backend: --pic supports only internal references; extern symbols are not supported")))
            (if (compiler-backend-pic-relocs-valid?
              image
              (struct-get image relocations))
              (ResultCompilerBackendPic.Ok
                (CompilerBackendPicOutput
                  (compiler-backend-pic-asm
                    (compiler-backend-peephole-asm (text_buf.render buf))
                    image)
                  (compiler-backend-pic-fixup-table image)))
              (ResultCompilerBackendPic.Err
                (box
                  (compiler-diagnostic-at-start
                    ""
                    "backend: --pic could not map every absolute pointer fixup to an 8-byte data slot")))))]
        [(ResultCompilerBackendObject.Err diag)
          (ResultCompilerBackendPic.Err diag)])]
    [(ResultCompilerBackendBuffer.Err diag) (ResultCompilerBackendPic.Err diag)]))

(define (compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt
  [type-segment-bases : i64]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendPic
  (compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt-and-profile-state
    type-segment-bases
    program
    target
    mode
    spans
    emit-entry
    crt-entry
    (profile_state.compiler-profile-state-new)))

(define (compiler-backend-emit-program-pic-target-with-mode-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendPic
  (compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt
    (ast-node-pool-reader-type-segment-bases)
    program
    target
    mode
    spans
    emit-entry
    crt-entry))

(define (compiler-backend-emit-program-pic-target-with-mode-with-pools-and-crt
  [pools : AstNodePoolContext]
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendPic
  (compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt
    (ast-node-pool-context-type-segment-bases pools)
    program
    target
