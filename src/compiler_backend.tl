              slots)
            (compiler-backend-emit-c-abi-store-result-call
              target
              base
              name
              args
              slots
              assignments
              types
              global-types
              plan
              externs
              program-index
              vars
              instr-diag)])]
      [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
        (match (box-get payload-box)
          [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
              base
              func
              args
              slots)
            (compiler-backend-emit-indirect-c-abi-store-result-call
              target
              base
              func
              args
              slots
              assignments
              types
              functions
              externs
              program-index
              vars
              instr-diag)])]
      [(CompilerIrInstr.TailCall name args ty)
        (match (compiler-backend-emit-tail-call
          target
          source-function
          blocks
          name
          args
          ty
          assignments
          types
          global-types
          vars
          plan
          functions
          externs
          program-index
          instr-diag)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (box-get message)
                  instr-diag)))])]
      [(CompilerIrInstr.Store name value ty)
        (let
          [addr : String
            (str_cat.str-cat (compiler-backend-user-symbol name) "(%rip)" "")]
          (if (compiler-backend-group-type? program-index ty)
            ;; #2386: storing a register-group into a global writes both words
            ;; inline (word0 at sym, word1 at sym+8).
            (let
              [reg0 : String
                (compiler-backend-group-return-reg program-index ty 0)]
              [reg1 : String
                (compiler-backend-group-return-reg program-index ty 1)]
              [sym0 : String
                (str_cat.str-cat
                  (compiler-backend-user-symbol name)
                  "(%rip)"
                  "")]
              [sym1 : String
                (str_cat.str-cat
                  (compiler-backend-user-symbol name)
                  "+8(%rip)"
                  "")]
              (match (compiler-backend-emit-group-load
                assignments
                value
                reg0
                reg1
                vars
                ty
                program-index)
                [(ResultCompilerBackend.Ok load)
                  (ResultCompilerBackend.Ok
                    (string.append
                      load
                      (string.append
                        (compiler-backend-emit-group-word-move
                          reg0
                          sym0
                          (compiler-backend-group-word-sse? program-index ty 0))
                        (compiler-backend-emit-group-word-move
                          reg1
                          sym1
                          (compiler-backend-group-word-sse? program-index ty 1)))))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err
                    (box
                      (compiler-backend-apply-instr-diagnostic
                        (box-get message)
                        instr-diag)))]))
            (let
              [no-exclude : (Array String) (array.make-array String 0)]
              (match (compiler-backend-emit-store-value-to-address
                assignments
                value
                ty
                addr
                program-index
                no-exclude
                0)
                [(ResultCompilerBackend.Ok store-asm)
                  (ResultCompilerBackend.Ok store-asm)]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err
                    (box
                      (compiler-backend-apply-instr-diagnostic
                        (box-get message)
                        instr-diag)))]))))]
      [(CompilerIrInstr.Jump target)
        (match (compiler-backend-emit-trivial-phi-return-edge
          source-function
          blocks
          target
          current-label
          assignments
          vars
          ret-ty
          program-index)
          [(ResultCompilerBackend.Ok direct-return)
            (if (string.eq direct-return "")
              (match (compiler-backend-emit-phi-edge-copies
                assignments
                blocks
                target
                current-label
                program-index
                vars)
                [(ResultCompilerBackend.Ok copies)
                  (ResultCompilerBackend.Ok
                    (str_cat.str-cat
                      copies
                      (if (compiler-backend-jump-target-is-fallthrough?
                        target
                        fallthrough)
                        ""
                        (str_cat.str-cat
                          "    jmp "
                          (compiler-backend-asm-label function target)
                          "\n"
                          ""))))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err
                    (box
                      (compiler-backend-apply-instr-diagnostic
                        (box-get message)
                        instr-diag)))])
              (ResultCompilerBackend.Ok direct-return))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (box-get message)
                  instr-diag)))])]
      [(CompilerIrInstr.Branch cond true-label false-label)
        (match (compiler-backend-emit-branch-with-phi-copies
          assignments
          function
          blocks
          current-label
          cond
          true-label
          false-label
          fallthrough
          program-index
          vars)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (box-get message)
                  instr-diag)))])]
      [(CompilerIrInstr.Return value)
        (match (compiler-backend-emit-return
          source-function
          blocks
          value
          assignments
          vars
          ret-ty
          program-index)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (box-get message)
                  instr-diag)))])]
      [(CompilerIrInstr.Phi _ _ _) (ResultCompilerBackend.Ok "")]
      [(CompilerIrInstr.Pack dst words ty)
        (compiler-backend-emit-pack
          assignments
          dst
          words
          ty
          vars
          program-index
          instr-diag)]
      [(CompilerIrInstr.Word dst src index ty)
        (compiler-backend-emit-word
          assignments
          dst
          src
          index
          ty
          vars
          instr-diag)]
      [(CompilerIrInstr.TailCallIndirect func args ty)
        (match (compiler-backend-emit-tail-indirect-call
          target
          source-function
          blocks
          func
          args
          ty
          assignments
          types
          vars
          functions
          externs
          program-index
          instr-diag)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (box-get message)
                  instr-diag)))])]
      [(CompilerIrInstr.Switch index base cases default-label)
        (match (compiler-backend-emit-switch
          function
          current-label
          index
          base
          cases
          default-label
          assignments)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (box-get message)
                  instr-diag)))])])))

(define (compiler-backend-use-count-inc [counts : (Array i64)] [var : i64]) : unit
  (if (< var 0)
    unit
    (if (>= var (array-length counts))
      unit
      (begin
        (array-set! counts var (+ (array-ref counts var) 1))
        unit))))

(define (compiler-backend-count-value-use
  [counts : (Array i64)]
  [value : CompilerIrValue]) : unit
  (match value
    [(CompilerIrValue.Var id) (compiler-backend-use-count-inc counts id)]
    [_ unit]))

(define (compiler-backend-count-value-list-uses
  [counts : (Array i64)]
  [values : CompilerIrValueList]) : unit
  (match values
    [(CompilerIrValueList.Nil) unit]
    [(CompilerIrValueList.Cons value rest)
      (begin
        (compiler-backend-count-value-use counts value)
        (compiler-backend-count-value-list-uses counts (box-get rest)))]))

(define (compiler-backend-count-call-args-array-uses
  [counts : (Array i64)]
  [values : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length values))
    unit
    (begin
      (compiler-backend-count-value-use counts (array-ref values index))
      (compiler-backend-count-call-args-array-uses counts values (+ index 1)))))

(define (compiler-backend-count-call-args-uses
  [counts : (Array i64)]
  [args : CompilerIrCallArgs]) : unit
  (match args
    [(CompilerIrCallArgs.Nil) unit]
    [(CompilerIrCallArgs.One value)
      (compiler-backend-count-value-use counts value)]
    [(CompilerIrCallArgs.Two a b)
      (begin
        (compiler-backend-count-value-use counts a)
        (compiler-backend-count-value-use counts b))]
    [(CompilerIrCallArgs.Array values)
      (compiler-backend-count-call-args-array-uses counts values 0)]))

(define (compiler-backend-count-spmd-call-args-uses
  [counts : (Array i64)]
  [args : CompilerIrSpmdCallArgList]) : unit
  (match args
    [(IrSpmdCallArgNil) unit]
    [(IrSpmdCallArgCons arg rest)
      (match arg
        [(IrSpmdCallArg _ value _)
          (begin
            (compiler-backend-count-value-use counts value)
            (compiler-backend-count-spmd-call-args-uses counts (box-get rest)))])]))

(define (compiler-backend-count-phi-input-uses
  [counts : (Array i64)]
  [inputs : CompilerIrPhiInputList]) : unit
  (match inputs
    [(CompilerIrPhiInputList.Nil) unit]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (compiler-backend-count-value-use counts value)
        (compiler-backend-count-phi-input-uses counts (box-get rest)))]))

(define (compiler-backend-count-instr-uses
  [counts : (Array i64)]
  [instr : CompilerIrInstr]) : unit
  (match instr
    [(CompilerIrInstr.Mov _ src _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.AddrOf _ src) (compiler-backend-use-count-inc counts src)]
    [(CompilerIrInstr.Gep _ base offset _)
      (begin
        (compiler-backend-count-value-use counts base)
        (compiler-backend-count-value-use counts offset))]
    [(CompilerIrInstr.Load _ src _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.StorePtr dst src _)
      (begin
        (compiler-backend-count-value-use counts dst)
        (compiler-backend-count-value-use counts src))]
    [(CompilerIrInstr.CopyBytes dst src _)
      (begin
        (compiler-backend-count-value-use counts dst)
        (compiler-backend-count-value-use counts src))]
    [(CompilerIrInstr.BoundsCheck index length _)
      (begin
        (compiler-backend-count-value-use counts index)
        (compiler-backend-count-value-use counts length))]
    [(CompilerIrInstr.Cast _ src _ _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.Bitcast _ src _ _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (begin
        (compiler-backend-count-value-use counts lhs)
        (compiler-backend-count-value-use counts rhs))]
    [(CompilerIrInstr.UnOp _ _ src _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.Splat _ value _ _)
      (compiler-backend-count-value-use counts value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (begin
            (compiler-backend-count-value-use counts lhs)
            (compiler-backend-count-value-use counts rhs))])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (begin
            (compiler-backend-count-value-use counts lhs)
            (compiler-backend-count-value-use counts rhs))])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (compiler-backend-count-value-use counts lhs)
        (compiler-backend-count-value-use counts rhs))]
    [(CompilerIrInstr.MaskNot _ src _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (begin
            (compiler-backend-count-value-use counts mask)
            (compiler-backend-count-value-use counts on-true)
            (compiler-backend-count-value-use counts on-false))])]
    [(CompilerIrInstr.VectorLoad _ base index _ _)
      (begin
        (compiler-backend-count-value-use counts base)
        (compiler-backend-count-value-use counts index))]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value _ _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-value-use counts index)
            (compiler-backend-count-value-use counts value))])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            _
            _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-value-use counts index)
            (compiler-backend-count-value-use counts value)
            (compiler-backend-count-value-use counts mask))])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base index mask _ _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-value-use counts index)
            (compiler-backend-count-value-use counts mask))])]
    [(CompilerIrInstr.TailMask _ index length _)
      (begin
        (compiler-backend-count-value-use counts index)
        (compiler-backend-count-value-use counts length))]
    [(CompilerIrInstr.EntryArgc _) unit]
    [(CompilerIrInstr.EntryArgv _) unit]
    [(CompilerIrInstr.EntryEnvp _) unit]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (begin
        (compiler-backend-count-value-use counts leaf)
        (compiler-backend-count-value-use counts subleaf))]
    [(CompilerIrInstr.Xgetbv _ index)
      (compiler-backend-count-value-use counts index)]
    [(CompilerIrInstr.Syscall _ args)
      (compiler-backend-count-call-args-uses counts args)]
    [(CompilerIrInstr.Call _ _ args _)
      (compiler-backend-count-call-args-uses counts args)]
    [(CompilerIrInstr.CallIndirect _ callee args _)
      (begin
        (compiler-backend-count-value-use counts callee)
        (compiler-backend-count-call-args-uses counts args))]
    [(CompilerIrInstr.CallIndirectC _ callee args _)
      (begin
        (compiler-backend-count-value-use counts callee)
        (compiler-backend-count-call-args-uses counts args))]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base _ args _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-call-args-uses counts args))])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            callee
            args
            _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-value-use counts callee)
            (compiler-backend-count-call-args-uses counts args))])]
    [(IrInstrSpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload _ _ _ active-mask args _)
          (begin
            (compiler-backend-count-value-use counts active-mask)
            (compiler-backend-count-spmd-call-args-uses counts args))])]
    [(CompilerIrInstr.TailCall _ args _)
      (compiler-backend-count-call-args-uses counts args)]
    [(CompilerIrInstr.TailCallIndirect callee args _)
      (begin
        (compiler-backend-count-value-use counts callee)
        (compiler-backend-count-call-args-uses counts args))]
    [(CompilerIrInstr.Store _ value _)
      (compiler-backend-count-value-use counts value)]
    [(CompilerIrInstr.Branch cond _ _)
      (compiler-backend-count-value-use counts cond)]
    [(CompilerIrInstr.Return maybe)
      (match maybe
        [(CompilerIrMaybeValue.No) unit]
        [(CompilerIrMaybeValue.Some value)
          (compiler-backend-count-value-use counts value)])]
    [(CompilerIrInstr.Phi _ inputs _)
      (compiler-backend-count-phi-input-uses counts inputs)]
    ;; #2386 register-group instrs: count their operand uses so the
    ;; single-use fusion peepholes cannot elide the home store of a var a
    ;; Pack/Word still reads (-O2 copy-prop substitutes vars directly into
    ;; Pack/Word operands).
    [(CompilerIrInstr.Pack _ words _)
      (compiler-backend-count-value-list-uses counts words)]
    [(CompilerIrInstr.Word _ src _ _)
      (compiler-backend-count-value-use counts src)]
    ;; Operand-free IR instructions intentionally add no value uses.
    [(CompilerIrInstr.Alloc _ _) unit]
    [(CompilerIrInstr.LaneId _ _ _) unit]
    [(CompilerIrInstr.EntryArgc _) unit]
    [(CompilerIrInstr.EntryArgv _) unit]
    [(CompilerIrInstr.EntryEnvp _) unit]
    [(CompilerIrInstr.Jump _) unit]
    [(CompilerIrInstr.Switch index _ _ _)
      (compiler-backend-count-value-use counts index)]))

(define (compiler-backend-count-instr-seq-uses
  [counts : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-backend-count-instr-uses counts (array-ref slots index))
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-count-block-uses
  [counts : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-backend-count-instr-seq-uses counts instrs)
            (compiler-backend-count-block-uses counts (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-count-block-uses
        counts
        (compiler-ir-block-seq-to-list seq))]))

(define (compiler-backend-function-use-counts
  [vars : i64]
  [blocks : CompilerIrBlockList]) : (Array i64)
  (let
    [counts : (Array i64) (array.make-array i64 vars)]
    (begin
      (compiler-backend-count-block-uses counts blocks)
      counts)))

(define (compiler-backend-var-single-use? [counts : (Array i64)] [var : i64]) : bool
  (if (< var 0)
    false
    (if (>= var (array-length counts))
      false
      (= (array-ref counts var) 1))))

;; Dead result-store elision: true when `var` is read by NO instruction in the
;; final emitted IR (use count 0 over emit-blocks-list, the post-rewrite
;; post-coloring blocks the emitter walks). Every operand read counts as a use,
;; including IrInstrAddrOf's raw var id (compiler-backend-count-instr-uses), so
;; a never-used var's frame slot is unobservable: no reload, no address-taken
;; alias, no Pack/Word read. The runtime has no GC/stack-root walk and the
;; backend emits no per-slot unwind metadata, so skipping the slot store of such
;; a var (a call result whose value is ignored -- DCE cannot drop the call) is
;; behavior-preserving. Reads the per-function array installed by
;; compiler-backend-fuse-need-enable!; conservatively false when unset.
(define (compiler-backend-var-never-used? [var : i64]) : bool
  (cond
    [(not compiler-backend-fuse-need-ready) false]
    [(< var 0) false]
    [(>= var (array-length compiler-backend-fuse-use-counts)) false]
    [else (= (array-ref compiler-backend-fuse-use-counts var) 0)]))

;; True when every use of `var` is a branch fed by its own adjacent compare, so
;; the boolean is never needed as a materialized value and a compare->branch on
;; it may fuse. Holds when the var's total use count equals its free-branch
;; count. Reads the per-function arrays installed by
;; compiler-backend-fuse-need-enable!; conservatively false when unset.
(define (compiler-backend-var-fuse-safe? [var : i64]) : bool
  (cond
    [(not compiler-backend-fuse-need-ready) false]
    [(< var 0) false]
    [(>= var (array-length compiler-backend-fuse-free-counts)) false]
    [(>= var (array-length compiler-backend-fuse-use-counts)) false]
    [else
      (=
        (array-ref compiler-backend-fuse-use-counts var)
        (array-ref compiler-backend-fuse-free-counts var))]))

;; The branch condition var at slot `j` when that branch is fed by the
;; immediately preceding compare (a "free branch" that reads flags, not a
;; materialized boolean); otherwise -1.
(define (compiler-backend-fuse-free-branch-var
  [slots : (Array CompilerIrInstr)]
  [j : i64]) : i64
  (if (<= j 0)
    (- 0 1)
    (match (array-ref slots j)
      [(CompilerIrInstr.Branch cond _ _)
        (match cond
          [(CompilerIrValue.Var v)
            (match (array-ref slots (- j 1))
              [(CompilerIrInstr.BinOp dst op _ _ _)
                (if (and (compiler-backend-compare-op? op) (= dst v))
                  v
                  (- 0 1))]
              [_ (- 0 1)])]
          [_ (- 0 1)])]
      [_ (- 0 1)])))

(define (compiler-backend-fuse-free-seq
  [free : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [n : i64 (struct-get instrs len)]
    [j : i64 0]
    (while (< j n)
      (begin
        (let
          [v : i64 (compiler-backend-fuse-free-branch-var slots j)]
          (if (and (>= v 0) (< v (array-length free)))
            (array-set! free v (+ (array-ref free v) 1))
            unit))
        (set! j (+ j 1))))))

(define (compiler-backend-fuse-free-blocks
  [free : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-backend-fuse-free-seq free instrs)])
        (compiler-backend-fuse-free-blocks free (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-fuse-free-blocks
        free
        (compiler-ir-block-seq-to-list seq))]))

(define (compiler-backend-fuse-need-enable!
  [vars : i64]
  [use-counts : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (let
    [free : (Array i64) (array.make-array i64 vars)]
    (begin
      (compiler-backend-fuse-free-blocks free blocks)
      (set! compiler-backend-fuse-use-counts use-counts)
      (set! compiler-backend-fuse-free-counts free)
      (set! compiler-backend-fuse-need-ready true))))

(define (compiler-backend-fuse-need-disable!) : unit
  (begin
    (set! compiler-backend-fuse-need-ready false)
    (set! compiler-backend-fuse-use-counts (array.make-array i64 0))
    (set! compiler-backend-fuse-free-counts (array.make-array i64 0))))

(define (compiler-backend-addr-of-forwarding-fill!
  [items : (Array i64)]
  [index : i64]) : unit
  (if (>= index (array-length items))
    unit
    (begin
      (array-set! items index (- 0 1))
      (compiler-backend-addr-of-forwarding-fill! items (+ index 1)))))

(define (compiler-backend-addr-of-forwarding-record!
  [items : (Array i64)]
  [use-counts : (Array i64)]
  [instr : CompilerIrInstr]) : unit
  (match instr
    [(CompilerIrInstr.AddrOf dst src)
      (if (and
        (>= dst 0)
        (< dst (array-length items))
        (compiler-backend-var-single-use? use-counts dst))
        (array-set! items dst src)
        unit)]
    [_ unit]))

(define (compiler-backend-addr-of-forwarding-record-seq!
  [items : (Array i64)]
  [use-counts : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-backend-addr-of-forwarding-record!
            items
            use-counts
            (array-ref slots index))
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-addr-of-forwarding-record-blocks!
  [items : (Array i64)]
  [use-counts : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-backend-addr-of-forwarding-record-seq!
              items
              use-counts
              instrs)
            (compiler-backend-addr-of-forwarding-record-blocks!
              items
              use-counts
              (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-addr-of-forwarding-record-blocks!
        items
        use-counts
        (compiler-ir-block-seq-to-list seq))]))

(define (compiler-backend-addr-of-forwarding-enable!
  [vars : i64]
  [blocks : CompilerIrBlockList]
  [use-counts : (Array i64)]) : unit
  (let
    [items : (Array i64) (array.make-array i64 vars)]
    (begin
      (compiler-backend-addr-of-forwarding-fill! items 0)
      (compiler-backend-addr-of-forwarding-record-blocks!
        items
        use-counts
        blocks)
      (set! compiler-backend-addr-of-forwarding-src items)
      (set! compiler-backend-addr-of-forwarding-enabled true))))

(define (compiler-backend-addr-of-forwarding-disable!) : unit
  (begin
    (set! compiler-backend-addr-of-forwarding-enabled false)
    (set! compiler-backend-addr-of-forwarding-src (array.make-array i64 0))))

(define (compiler-backend-branch-uses-var? [cond : CompilerIrValue] [var : i64]) : bool
  (match cond
    [(CompilerIrValue.Var id) (= id var)]
    [_ false]))

(define (compiler-backend-rest-starts-load-compare-branch?
  [rest : CompilerIrInstrList]
  [load-dst : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [use-counts : (Array i64)]) : bool
  (match rest
    [(CompilerIrInstrList.Cons maybe-cmp after-cmp)
      (match maybe-cmp
        [(CompilerIrInstr.BinOp cmp-dst op lhs rhs cmp-ty)
          (if (and
            (compiler-backend-compare-op? op)
            (compiler-backend-branch-uses-var? lhs load-dst)
            (compiler-backend-var-single-use? use-counts cmp-dst)
            (not
              (compiler-backend-binop-f64? types global-types lhs rhs cmp-ty)))
            (match (box-get after-cmp)
              [(CompilerIrInstrList.Cons branch _)
                (match branch
                  [(CompilerIrInstr.Branch cond _ _)
                    (compiler-backend-branch-uses-var? cond cmp-dst)]
                  [_ false])]
              [_ false])
            false)]
        [_ false])]
    [_ false]))

(define (compiler-backend-fused-compare-fallthrough
  [rest : CompilerIrInstrList]
  [fallthrough : CompilerBackendMaybeLabel]) : CompilerBackendMaybeLabel
  (match rest
    [(CompilerIrInstrList.Nil) fallthrough]
    [_ (CompilerBackendMaybeLabel.No)]))

;; A block-terminator fusion (mov/call/binop directly into a return) emits the
;; whole tail of the block and does not recurse, so it must flush the buffer of
;; the instructions already emitted before it: render buf followed by the
;; terminator's asm.
(define (compiler-backend-emit-terminator-into
  [result : ResultCompilerBackend]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match result
    [(ResultCompilerBackend.Ok asm)
      (ResultCompilerBackend.Ok
        (compiler-backend-emergency-render-append buf asm))]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-instr-with-call-rax
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [assignments : CompilerRegAssignmentList]
  [rax-var : i64]
  [rax-ty : AstType]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [arg-assignments : CompilerRegAssignmentList
      (compiler-backend-rax-call-arg-assignments
        assignments
        program-index
        rax-var
        rax-ty)]
    [instr-diag : CompilerDiagnostic
      (compiler-backend-instr-diagnostic
        spans
        source-function
        instr
        func-diag
        "")]
    ;; Sound-scavenger: reserve this instruction's operand + result homes so the
    ;; scavenge can never hand one back as scratch (LLVM RegScavenger model).
    [_reserved-mask : i64
      (begin
        (set!
          compiler-backend-current-instr-reserved-mask
          (compiler-backend-live-set-home-mask
            assignments
            (compiler-live-instr-defs instr)
            (compiler-backend-live-set-home-mask
              assignments
              (compiler-live-instr-uses instr)
              0)))
        compiler-backend-current-instr-reserved-mask)]
    (match instr
      [(CompilerIrInstr.Call dst name args ty)
        (if (compiler-backend-call-leading-arg-uses-var? args rax-var)
          (compiler-backend-emit-direct-call-with-arg-assignments
            target
            function
            current-label
            dst
            name
            args
            ty
            assignments
            arg-assignments
            types
            global-types
            plan
            externs
            program-index
            vars
            instr-diag)
          (compiler-backend-emit-instr
            target
            function
            source-function
            blocks
            current-label
            fallthrough
            instr
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            func-diag))]
      [(CompilerIrInstr.CallIndirect dst func args ty)
        (if (compiler-backend-call-leading-arg-uses-var? args rax-var)
          (compiler-backend-emit-indirect-call-with-arg-assignments
            target
            dst
            func
            args
            ty
            assignments
            arg-assignments
            types
            functions
            externs
            program-index
            vars
            instr-diag)
          (compiler-backend-emit-instr
            target
            function
            source-function
            blocks
            current-label
            fallthrough
            instr
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            func-diag))]
      [_
        (compiler-backend-emit-instr
          target
          function
          source-function
          blocks
          current-label
          fallthrough
          instr
          assignments
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          func-diag)])))

(define (compiler-backend-call-rax-forwardable-instr?
  [instr : CompilerIrInstr]
  [program-index : CompilerBackendProgramIndex]
  [rax-var : i64]
  [rax-ty : AstType]) : bool
  (and
    (compiler-backend-rax-call-arg-eligible? program-index rax-ty)
    (match instr
      [(CompilerIrInstr.Call _ _ args _)
        (compiler-backend-call-leading-arg-uses-var? args rax-var)]
      [(CompilerIrInstr.CallIndirect _ _ args _)
        (compiler-backend-call-leading-arg-uses-var? args rax-var)]
      [_ false])))

(define (compiler-backend-emit-instrs-after-emitted
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [rest : CompilerIrInstrList]
  [head : String]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (let
    [next-buf : TextBuf (compiler-backend-emergency-append buf head)]
    (match instr
      [(CompilerIrInstr.Call dst _ _ ty)
        (compiler-backend-emit-instrs-with-call-rax
          target
          function
          source-function
          blocks
          current-label
          fallthrough
          dst
          ty
          rest
          assignments
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          func-diag
          use-counts
          next-buf)]
      [(CompilerIrInstr.CallIndirect dst _ _ ty)
        (compiler-backend-emit-instrs-with-call-rax
          target
          function
          source-function
          blocks
          current-label
          fallthrough
          dst
          ty
          rest
          assignments
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          func-diag
          use-counts
          next-buf)]
      [(CompilerIrInstr.CallIndirectC dst _ _ ty)
        (compiler-backend-emit-instrs-with-call-rax
          target
          function
          source-function
          blocks
          current-label
          fallthrough
          dst
          ty
          rest
          assignments
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          func-diag
          use-counts
          next-buf)]
      [_
        (compiler-backend-emit-instrs
          target
          function
          source-function
          blocks
          current-label
          fallthrough
          rest
          assignments
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          func-diag
          use-counts
          next-buf)])))

(define (compiler-backend-emit-instrs-normal
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [rest : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match (compiler-backend-emit-instr
    target
    function
    source-function
    blocks
    current-label
    (match rest
      [(CompilerIrInstrList.Nil) fallthrough]
      [_ (CompilerBackendMaybeLabel.No)])
    instr
    assignments
    vars
    types
    global-types
    ret-ty
    plan
    functions
    externs
    program-index
    spans
    func-diag)
    [(ResultCompilerBackend.Ok head)
      (compiler-backend-emit-instrs-after-emitted
        target
        function
        source-function
        blocks
        current-label
        fallthrough
        instr
        rest
        head
        assignments
        vars
        types
        global-types
        ret-ty
        plan
        functions
        externs
        program-index
        spans
        func-diag
        use-counts
        buf)]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-fused-result-rest
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [result : ResultCompilerBackend]
  [rest : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match result
    [(ResultCompilerBackend.Ok head)
      (compiler-backend-emit-instrs
        target
        function
        source-function
        blocks
        current-label
        fallthrough
        rest
        assignments
        vars
        types
        global-types
        ret-ty
        plan
        functions
        externs
        program-index
        spans
        func-diag
        use-counts
        (text_buf.append buf (compiler-backend-emergency-wrap head)))]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-rax-forwardable-consumer?
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [assignments : CompilerRegAssignmentList]
  [rax-var : i64]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ op lhs rhs ty)
      (and
        (compiler-backend-rax-forwardable-binop?
          types
          global-types
          assignments
          op
          lhs
          rhs
          ty)
        (or
          (compiler-backend-branch-uses-var? lhs rax-var)
          (and
            (compiler-backend-branch-uses-var? rhs rax-var)
            (compiler-backend-commutative-binop? op))))]
    [(CompilerIrInstr.Mov _ src _)
      (compiler-backend-branch-uses-var? src rax-var)]
    [(CompilerIrInstr.Return maybe)
      (match maybe
        [(CompilerIrMaybeValue.Some value)
          (compiler-backend-branch-uses-var? value rax-var)]
        [(CompilerIrMaybeValue.No) false])]
    [_ false]))

(define (compiler-backend-rest-starts-rax-forwardable-consumer?
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [assignments : CompilerRegAssignmentList]
  [rax-var : i64]
  [rest : CompilerIrInstrList]) : bool
  (match rest
    [(CompilerIrInstrList.Cons instr _)
      (compiler-backend-rax-forwardable-consumer?
        types
        global-types
        assignments
        rax-var
        instr)]
    [(CompilerIrInstrList.Nil) false]))

(define (compiler-backend-emit-instrs-materialize-rax
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : AstType]
  [instrs : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (compiler-backend-emit-instrs
    target
    function
    source-function
    blocks
    current-label
    fallthrough
    instrs
    assignments
    vars
    types
    global-types
    ret-ty
    plan
    functions
    externs
    program-index
    spans
    func-diag
    use-counts
    (text_buf.append
      buf
      (compiler-backend-emit-store-typed-var-with-plan
        assignments
        rax-var
        "%rax"
        rax-ty))))

(define (compiler-backend-emit-instrs-with-rax-step
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : AstType]
  [instrs : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match instrs
    [(CompilerIrInstrList.Nil)
      (ResultCompilerBackend.Ok
        (text_buf.render
          (text_buf.append
            buf
            (compiler-backend-emit-store-typed-var-with-plan
              assignments
              rax-var
              "%rax"
              rax-ty))))]
    [(CompilerIrInstrList.Cons instr rest)
      (match instr
        [(CompilerIrInstr.BinOp dst op lhs rhs ty)
          (if (compiler-backend-rax-forwardable-consumer?
            types
            global-types
            assignments
            rax-var
            instr)
            (let
              [keep-live : bool
                (compiler-backend-var-single-use? use-counts dst)]
              (match (compiler-backend-emit-binop-with-rax-value
                types
                global-types
                assignments
                rax-var
                dst
                op
                lhs
                rhs
                ty
                (not keep-live))
                [(ResultCompilerBackend.Ok head)
                  (if keep-live
                    (compiler-backend-emit-instrs-with-rax
                      target
                      function
                      source-function
                      blocks
                      current-label
                      fallthrough
                      dst
                      ty
                      (box-get rest)
                      assignments
                      vars
                      types
                      global-types
                      ret-ty
                      plan
                      functions
                      externs
                      program-index
                      spans
                      func-diag
                      use-counts
                      (text_buf.append
                        buf
                        (compiler-backend-emergency-wrap head)))
                    (compiler-backend-emit-instrs
                      target
                      function
                      source-function
                      blocks
                      current-label
                      fallthrough
                      (box-get rest)
                      assignments
                      vars
                      types
                      global-types
                      ret-ty
                      plan
                      functions
                      externs
                      program-index
                      spans
                      func-diag
                      use-counts
                      (text_buf.append
                        buf
                        (compiler-backend-emergency-wrap head))))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)]))
            (compiler-backend-emit-instrs-materialize-rax
              target
              function
              source-function
              blocks
              current-label
              fallthrough
              rax-var
              rax-ty
              instrs
              assignments
              vars
              types
              global-types
              ret-ty
              plan
              functions
              externs
              program-index
              spans
              func-diag
              use-counts
              buf))]
        [(CompilerIrInstr.Mov dst src ty)
          (if (compiler-backend-branch-uses-var? src rax-var)
            (if (compiler-backend-var-single-use? use-counts dst)
              (compiler-backend-emit-instrs-with-rax
                target
                function
                source-function
                blocks
                current-label
                fallthrough
                dst
                ty
                (box-get rest)
                assignments
                vars
                types
                global-types
                ret-ty
                plan
                functions
                externs
                program-index
                spans
                func-diag
                use-counts
                buf)
              (compiler-backend-emit-instrs
                target
                function
                source-function
                blocks
                current-label
                fallthrough
                (box-get rest)
                assignments
                vars
                types
                global-types
                ret-ty
                plan
                functions
                externs
                program-index
                spans
                func-diag
                use-counts
                (text_buf.append
                  buf
                  (compiler-backend-emit-store-typed-var-with-plan
                    assignments
                    dst
                    "%rax"
                    ty))))
            (compiler-backend-emit-instrs-materialize-rax
              target
              function
              source-function
              blocks
              current-label
              fallthrough
              rax-var
              rax-ty
              instrs
              assignments
              vars
              types
              global-types
              ret-ty
              plan
              functions
              externs
              program-index
              spans
              func-diag
              use-counts
              buf))]
        [(CompilerIrInstr.Return maybe)
          (match maybe
            [(CompilerIrMaybeValue.Some value)
              (if (and
                (compiler-backend-branch-uses-var? value rax-var)
                (match (box-get rest)
                  [(CompilerIrInstrList.Nil) true]
                  [_ false]))
                (ResultCompilerBackend.Ok
                  (text_buf.render
                    (text_buf.append
                      buf
                      (compiler-backend-return-tail
                        source-function
                        assignments
                        vars
                        blocks))))
                (compiler-backend-emit-instrs-materialize-rax
                  target
                  function
                  source-function
                  blocks
                  current-label
                  fallthrough
                  rax-var
                  rax-ty
                  instrs
                  assignments
                  vars
                  types
                  global-types
                  ret-ty
                  plan
                  functions
                  externs
                  program-index
                  spans
                  func-diag
                  use-counts
                  buf))]
            [(CompilerIrMaybeValue.No)
              (compiler-backend-emit-instrs-materialize-rax
                target
                function
                source-function
                blocks
                current-label
                fallthrough
                rax-var
                rax-ty
                instrs
                assignments
                vars
                types
                global-types
                ret-ty
                plan
                functions
                externs
                program-index
                spans
                func-diag
                use-counts
                buf)])]
        [_
          (compiler-backend-emit-instrs-materialize-rax
            target
            function
            source-function
            blocks
            current-label
            fallthrough
            rax-var
            rax-ty
            instrs
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            func-diag
            use-counts
            buf)])]))

(define (compiler-backend-emit-instrs-with-call-rax-step
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : AstType]
  [instrs : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match instrs
    [(CompilerIrInstrList.Nil) (ResultCompilerBackend.Ok (text_buf.render buf))]
    [(CompilerIrInstrList.Cons instr rest)
      (if (compiler-backend-call-rax-forwardable-instr?
        instr
        program-index
        rax-var
        rax-ty)
        (match (compiler-backend-emit-instr-with-call-rax
          target
          function
          source-function
          blocks
          current-label
          (match (box-get rest)
            [(CompilerIrInstrList.Nil) fallthrough]
            [_ (CompilerBackendMaybeLabel.No)])
          instr
          assignments
          rax-var
          rax-ty
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          func-diag)
          [(ResultCompilerBackend.Ok head)
            (compiler-backend-emit-instrs-after-emitted
              target
              function
              source-function
              blocks
              current-label
              fallthrough
              instr
              (box-get rest)
              head
              assignments
              vars
              types
              global-types
              ret-ty
              plan
              functions
              externs
              program-index
              spans
              func-diag
              use-counts
              buf)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])
        (compiler-backend-emit-instrs
          target
          function
          source-function
          blocks
          current-label
          fallthrough
          instrs
          assignments
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          func-diag
          use-counts
          buf))]))

(define (compiler-backend-emit-fused-compare-branch-rest
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : i64]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]
  [true-label : String]
  [false-label : String]
  [rest : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match (compiler-backend-emit-compare-branch-with-phi-copies
    assignments
    function
    blocks
    current-label
    op
    lhs
    rhs
    (compiler-backend-binop-operand-ty types global-types op lhs rhs ty)
    true-label
    false-label
    (compiler-backend-fused-compare-fallthrough rest fallthrough)
    program-index
    vars)
    [(ResultCompilerBackend.Ok head)
      (compiler-backend-emit-instrs
        target
        function
        source-function
        blocks
        current-label
        fallthrough
        rest
        assignments
        vars
        types
        global-types
        ret-ty
        plan
        functions
        externs
        program-index
        spans
        func-diag
        use-counts
        (text_buf.append buf (compiler-backend-emergency-wrap head)))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              spans
              source-function
              (CompilerIrInstr.BinOp dst op lhs rhs ty)
              func-diag
              ""))))]))

(define (compiler-backend-emit-fused-load-compare-branch-rest
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [load-dst : i64]
  [ptr : CompilerIrValue]
  [load-ty : AstType]
  [_cmp-dst : i64]
  [op : CompilerIrBinOp]
  [rhs : CompilerIrValue]
  [_cmp-ty : AstType]
  [true-label : String]
  [false-label : String]
  [rest : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match (compiler-backend-emit-load-compare-branch-with-phi-copies
    assignments
    function
    blocks
    current-label
    ptr
    op
    rhs
    load-ty
    true-label
    false-label
    (compiler-backend-fused-compare-fallthrough rest fallthrough)
    program-index
    vars)
    [(ResultCompilerBackend.Ok head)
      (compiler-backend-emit-instrs
        target
        function
        source-function
        blocks
        current-label
        fallthrough
        rest
        assignments
        vars
        types
        global-types
        ret-ty
        plan
        functions
        externs
        program-index
        spans
        func-diag
        use-counts
        (text_buf.append buf (compiler-backend-emergency-wrap head)))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              spans
              source-function
              (CompilerIrInstr.Load load-dst ptr load-ty)
              func-diag
              ""))))]))

(define (compiler-backend-emit-fused-gep-load-compare-branch-rest
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [_load-dst : i64]
  [load-ty : AstType]
  [_cmp-dst : i64]
  [op : CompilerIrBinOp]
  [rhs : CompilerIrValue]
  [_cmp-ty : AstType]
  [true-label : String]
  [false-label : String]
  [rest : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match (compiler-backend-emit-gep-load-compare-branch-with-phi-copies
    assignments
    function
    blocks
    current-label
    base
    offset
    elem-ty
    op
    rhs
    load-ty
    true-label
    false-label
    (compiler-backend-fused-compare-fallthrough rest fallthrough)
    program-index
    vars)
    [(ResultCompilerBackend.Ok head)
      (compiler-backend-emit-instrs
        target
        function
        source-function
        blocks
        current-label
        fallthrough
        rest
        assignments
        vars
        types
        global-types
        ret-ty
        plan
        functions
        externs
        program-index
        spans
        func-diag
        use-counts
        (text_buf.append buf (compiler-backend-emergency-wrap head)))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              spans
              source-function
              (CompilerIrInstr.Gep gep-dst base offset elem-ty)
              func-diag
              ""))))]))

(define (compiler-backend-emit-fused-gep-load-rest
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [load-dst : i64]
  [load-ty : AstType]
  [rest : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  ;; M-D emergency-leak fix: the single gep+load emission is inlined at each
  ;; fallthrough site instead of being computed SPECULATIVELY up front.
  ;; emit-load-from-gep scavenges a base register; under full occupancy that
  ;; scavenge EMERGENCY-adds the picked register to the global pending set as
  ;; a side effect. The speculative single asm was discarded on the PAIR path,
  ;; but its pending registers leaked into the pair wrap, whose stray trailing
  ;; restore overwrote the pair's second loaded result (lex-parse-based-int:
  ;; string len in %r9 restored-over before its bounds compare -> false OOB
  ;; abort on every mid-band self-host build).
  (match (compiler-backend-value-as-i64 offset)
    [(option_i64.Some _)
      (match rest
        [(CompilerIrInstrList.Cons maybe-gep after-gep)
          (match maybe-gep
            [(CompilerIrInstr.Gep gep-dst2 base2 offset2 elem-ty2)
              (if (and
                (compiler-backend-var-single-use? use-counts gep-dst2)
                (opt-value-eq base2 base))
                (match (compiler-backend-value-as-i64 offset2)
                  [(option_i64.Some _)
                    (match (box-get after-gep)
                      [(CompilerIrInstrList.Cons maybe-load after-load2)
                        (match maybe-load
                          [(CompilerIrInstr.Load load-dst2 src2 load-ty2)
                            (if (and
                              (compiler-backend-branch-uses-var? src2 gep-dst2)
                              (not
                                (and
                                  (compiler-backend-load-compare-type? load-ty2)
                                  (compiler-backend-var-single-use?
                                    use-counts
                                    load-dst2)
                                  (compiler-backend-rest-starts-load-compare-branch?
                                    (box-get after-load2)
                                    load-dst2
                                    types
                                    global-types
                                    use-counts))))
                              (compiler-backend-emit-fused-result-rest
                                target
                                function
                                source-function
                                blocks
                                current-label
                                fallthrough
                                (compiler-backend-emit-load-from-gep-pair
                                  assignments
                                  base
                                  offset
                                  elem-ty
                                  load-dst
                                  load-ty
                                  offset2
                                  elem-ty2
                                  load-dst2
                                  load-ty2)
                                (box-get after-load2)
                                assignments
                                vars
                                types
                                global-types
                                ret-ty
                                plan
                                functions
                                externs
                                program-index
                                spans
                                func-diag
                                use-counts
                                buf)
                              (compiler-backend-emit-fused-result-rest
                                target
                                function
                                source-function
                                blocks
                                current-label
                                fallthrough
                                (compiler-backend-emit-load-from-gep
                                  assignments
                                  load-dst
                                  base
                                  offset
                                  elem-ty
                                  load-ty
                                  "")
                                rest
                                assignments
                                vars
                                types
                                global-types
                                ret-ty
                                plan
                                functions
                                externs
                                program-index
                                spans
                                func-diag
                                use-counts
                                buf))]
                          [_
                            (compiler-backend-emit-fused-result-rest
                              target
                              function
                              source-function
                              blocks
                              current-label
                              fallthrough
                              (compiler-backend-emit-load-from-gep
                                assignments
                                load-dst
                                base
                                offset
                                elem-ty
                                load-ty
                                "")
                              rest
                              assignments
                              vars
                              types
                              global-types
                              ret-ty
                              plan
                              functions
                              externs
                              program-index
                              spans
                              func-diag
                              use-counts
                              buf)])]
                      [_
                        (compiler-backend-emit-fused-result-rest
                          target
                          function
                          source-function
                          blocks
                          current-label
                          fallthrough
                          (compiler-backend-emit-load-from-gep
                            assignments
                            load-dst
                            base
                            offset
                            elem-ty
                            load-ty
                            "")
                          rest
                          assignments
                          vars
                          types
                          global-types
                          ret-ty
                          plan
                          functions
                          externs
                          program-index
                          spans
                          func-diag
                          use-counts
                          buf)])]
                  [(option_i64.None)
                    (compiler-backend-emit-fused-result-rest
                      target
                      function
                      source-function
                      blocks
                      current-label
                      fallthrough
                      (compiler-backend-emit-load-from-gep
                        assignments
                        load-dst
                        base
                        offset
                        elem-ty
                        load-ty
                        "")
                      rest
                      assignments
                      vars
                      types
                      global-types
                      ret-ty
                      plan
                      functions
                      externs
                      program-index
                      spans
                      func-diag
                      use-counts
                      buf)])
                (compiler-backend-emit-fused-result-rest
                  target
                  function
                  source-function
                  blocks
                  current-label
                  fallthrough
                  (compiler-backend-emit-load-from-gep
                    assignments
                    load-dst
                    base
                    offset
                    elem-ty
                    load-ty
                    "")
                  rest
                  assignments
                  vars
                  types
                  global-types
                  ret-ty
                  plan
                  functions
                  externs
                  program-index
                  spans
                  func-diag
                  use-counts
                  buf))]
            [_
              (compiler-backend-emit-fused-result-rest
                target
                function
                source-function
                blocks
                current-label
                fallthrough
                (compiler-backend-emit-load-from-gep
                  assignments
                  load-dst
                  base
                  offset
                  elem-ty
                  load-ty
                  "")
                rest
                assignments
                vars
                types
                global-types
                ret-ty
                plan
                functions
                externs
                program-index
                spans
                func-diag
                use-counts
                buf)])]
        [_
          (compiler-backend-emit-fused-result-rest
            target
            function
            source-function
            blocks
            current-label
            fallthrough
            (compiler-backend-emit-load-from-gep
              assignments
              load-dst
              base
              offset
              elem-ty
              load-ty
              "")
            rest
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            func-diag
            use-counts
            buf)])]
    [(option_i64.None)
      (compiler-backend-emit-fused-result-rest
        target
        function
        source-function
        blocks
        current-label
        fallthrough
        (compiler-backend-emit-load-from-gep
          assignments
          load-dst
          base
          offset
          elem-ty
          load-ty
          "")
        rest
        assignments
        vars
        types
        global-types
        ret-ty
        plan
        functions
        externs
        program-index
        spans
        func-diag
        use-counts
        buf)]))

(define (compiler-backend-emit-fused-gep-store-rest
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [value : CompilerIrValue]
  [store-ty : AstType]
  [rest : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match (compiler-backend-emit-store-to-gep
    assignments
    base
    offset
    elem-ty
    value
    store-ty
    program-index)
    [(ResultCompilerBackend.Ok head)
      (compiler-backend-emit-instrs
        target
        function
        source-function
        blocks
        current-label
        fallthrough
        rest
        assignments
        vars
        types
        global-types
        ret-ty
        plan
        functions
        externs
        program-index
        spans
        func-diag
        use-counts
        (text_buf.append buf (compiler-backend-emergency-wrap head)))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              spans
              source-function
              (CompilerIrInstr.Gep gep-dst base offset elem-ty)
              func-diag
              ""))))]))

(define (compiler-backend-emit-fused-mov-trivial-phi-return-rest
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]
  [target-label : String]
  [after-jump : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match (compiler-backend-emit-mov-trivial-phi-return-edge
    source-function
    blocks
    target-label
    current-label
    assignments
    vars
    ret-ty
    dst
    src
    program-index)
    [(ResultCompilerBackend.Ok direct-return)
      (if (string.eq direct-return "")
        (if (compiler-backend-var-single-use? use-counts dst)
          (match (compiler-backend-emit-mov-phi-copy-edge
            assignments
            blocks
            target-label
            current-label
            dst
            src
            program-index
            vars)
            [(ResultCompilerBackend.Ok fused-copies)
              (if (string.eq fused-copies "")
                (compiler-backend-emit-instrs-normal
                  target
                  function
                  source-function
                  blocks
                  current-label
                  fallthrough
                  (CompilerIrInstr.Mov dst src ty)
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Jump target-label)
                    after-jump)
                  assignments
                  vars
                  types
                  global-types
                  ret-ty
                  plan
                  functions
                  externs
                  program-index
                  spans
                  func-diag
                  use-counts
                  buf)
                (match (compiler-backend-emit-trivial-phi-return-edge
                  source-function
                  blocks
                  target-label
                  current-label
                  assignments
                  vars
                  ret-ty
                  program-index)
                  [(ResultCompilerBackend.Ok plain-direct-return)
                    (compiler-backend-emit-instrs
                      target
                      function
                      source-function
                      blocks
                      current-label
                      fallthrough
                      after-jump
                      assignments
                      vars
                      types
                      global-types
                      ret-ty
                      plan
                      functions
                      externs
                      program-index
                      spans
                      func-diag
                      use-counts
                      (text_buf.append
                        buf
                        (if (string.eq plain-direct-return "")
                          (str_cat.str-cat
                            fused-copies
                            (if (compiler-backend-jump-target-is-fallthrough?
                              target-label
                              fallthrough)
                              ""
                              (compiler-backend-jump-label
                                function
                                target-label)))
                          plain-direct-return)))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err
                      (box
                        (compiler-backend-apply-instr-diagnostic
                          (box-get message)
                          (compiler-backend-instr-diagnostic
                            spans
                            source-function
                            (CompilerIrInstr.Mov dst src ty)
                            func-diag
                            ""))))]))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler-backend-apply-instr-diagnostic
                    (box-get message)
                    (compiler-backend-instr-diagnostic
                      spans
                      source-function
                      (CompilerIrInstr.Mov dst src ty)
                      func-diag
                      ""))))])
          (compiler-backend-emit-instrs-normal
            target
            function
            source-function
            blocks
            current-label
            fallthrough
            (CompilerIrInstr.Mov dst src ty)
            (compiler-ir-instr-cons
              (CompilerIrInstr.Jump target-label)
              after-jump)
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            func-diag
            use-counts
            buf))
        (compiler-backend-emit-instrs
          target
          function
          source-function
          blocks
          current-label
          fallthrough
          after-jump
          assignments
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          func-diag
          use-counts
          (compiler-backend-emergency-append buf direct-return)))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              spans
              source-function
              (CompilerIrInstr.Mov dst src ty)
              func-diag
              ""))))]))

(define (compiler-backend-emit-call-return
  [target : CompilerBackendTarget]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [name : String]
  [args : CompilerIrCallArgs]
  [assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [vars : i64]
  [plan : CompilerBackendRuntimePlan]
  [_functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [call-symbol : String
      (compiler-backend-call-symbol-index name plan program-index)]
    [param-types : AstTypeList
      (compiler-backend-call-param-types-for-call
        name
        args
        types
        global-types
        externs
        program-index)]
    [c-abi? : bool (compiler-backend-c-aggregate-extern-call? externs name)]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        c-abi?
        program-index)]
    (match (compiler-backend-emit-call-args
      target
      assignments
      args
      param-types
      c-abi?
      0
      0
      0
      0
      0
      instr-diag
      program-index
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (if (and
          (compiler-backend-tls-current-arena-call-name? name)
          (not (compiler-backend-index-function-defines? program-index name)))
          (match (compiler-backend-tls-current-arena-inline-asm
            target
            name
            instr-diag)
            [(ResultCompilerBackend.Ok inline-asm)
              (ResultCompilerBackend.Ok
                (string.append
                  (compiler-backend-emit-call-space-sub call-space)
                  (string.append
                    args-asm
                    (string.append
                      inline-asm
                      (string.append
                        (compiler-backend-emit-call-space-add call-space)
                        (compiler-backend-return-tail
                          source-function
                          assignments
                          vars
                          blocks))))))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler-backend-apply-instr-diagnostic
                    (box-get message)
                    instr-diag)))])
          (if (compiler-backend-atomic-call-name? call-symbol)
            (ResultCompilerBackend.Ok
              (string.append
                (compiler-backend-emit-call-space-sub call-space)
                (string.append
                  args-asm
                  (string.append
                    (compiler-backend-atomic-inline-asm target call-symbol)
                    (string.append
                      (compiler-backend-emit-call-space-add call-space)
                      (compiler-backend-return-tail
                        source-function
                        assignments
                        vars
                        blocks))))))
            (ResultCompilerBackend.Ok
              (string.append
                (compiler-backend-emit-call-space-sub call-space)
                (string.append
                  args-asm
                  (string.append
                    (compiler-backend-varargs-pre-call
                      target
                      name
                      externs
                      param-types)
                    (str_cat.str-cat
                      "    call "
                      call-symbol
                      "\n"
                      (string.append
                        (compiler-backend-emit-call-space-add call-space)
                        (compiler-backend-return-tail
                          source-function
                          assignments
                          vars
                          blocks))
                      "")))))))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-indirect-call-param-types
  [types : CompilerRegVarTypeList]
  [func : CompilerIrValue]
  [_functions : CompilerIrFunctionList]
  [_externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]) : AstTypeList
  (match func
    [(CompilerIrValue.Function name)
      (match (compiler-backend-index-signature program-index name)
        [(CompilerBackendMaybeSignature.Some param-types _) param-types]
        [(CompilerBackendMaybeSignature.No) (ast-type-list-new)])]
    [_
      (match (compiler-backend-value-type
        types
        (CompilerBackendGlobalTypeList.Nil)
        func)
        [(CompilerRegMaybeType.Some ty)
          (match ty
            [(AstType.Func param-types _) (box-get param-types)]
            [_ (ast-type-list-new)])]
        [(CompilerRegMaybeType.No) (ast-type-list-new)])]))

(define (compiler-backend-indirect-tail-call-register-only?
  [target : CompilerBackendTarget]
  [args : CompilerIrCallArgs]
  [types : AstTypeList]
  [program-index : CompilerBackendProgramIndex]) : bool
  (=
    (compiler-backend-call-stack-arg-count
      target
      args
      types
      false
      0
      1
      0
      1
      0
      program-index)
    0))

(define (compiler-backend-scavenge-tail-call-target-reg) : String
  ;; Tail jumps restore callee-saved homes before the final jmp. Keep the closure
  ;; pointer in a pooled caller-saved non-arg candidate instead.
  (compiler-backend-scavenge-reg-here
    (compiler-backend-c-abi-stage-exclude-with "%r11")
    5
    "%r10"))

(define (compiler-backend-emit-indirect-call-with-arg-assignments
  [target : CompilerBackendTarget]
  [dst : i64]
  [func : CompilerIrValue]
  [args : CompilerIrCallArgs]
  [ty : AstType]
  [assignments : CompilerRegAssignmentList]
  [arg-assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [param-types : AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    [call-space : i64
      (compiler-backend-closure-call-arg-space
        target
        args
        param-types
        program-index)]
    (match (compiler-backend-emit-call-args
      target
      arg-assignments
      args
      param-types
      false
      0
      1
      0
      1
      0
      instr-diag
      program-index
      ;; vars must be the real frame var count: group-word1 slots live at
      ;; -(8*(vars+var+1))(%rbp), so 0 here made a stack-homed group arg read
      ;; its word0 slot for BOTH words (#2386 closure-arg miscompile).
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-target-arg-reg target 0)
          [(ResultBackendReg.Ok env-reg)
            (match (compiler-backend-emit-call-result-store
              assignments
              dst
              ty
              vars
              program-index)
              [(ResultCompilerBackend.Ok result-store)
                (match func
                  [(CompilerIrValue.Function name)
                    (ResultCompilerBackend.Ok
                      (string.append
                        (compiler-backend-emit-call-space-sub call-space)
                        (string.append
                          args-asm
                          (string.append
                            (compiler-backend-emit-load-i64-immediate 0 env-reg)
                            (str_cat.str-cat
                              "    call "
                              (compiler-backend-closure-entry-label name)
                              "\n"
                              (string.append
                                (compiler-backend-emit-call-space-add
                                  call-space)
                                result-store)
                              "")))))]
                  [_
                    ;; Active-scavenge the closure pointer after arg marshalling.
                    ;; It must dodge in-flight arg registers, but it can use the
                    ;; pooled caller-saved non-arg target register.
                    (let
                      [scav-clo : String
                        (compiler-backend-scavenge-call-target-reg)]
                      (match (compiler-backend-emit-load-value-with-plan
                        assignments
                        func
                        scav-clo)
                        [(ResultCompilerBackend.Ok func-asm)
                          (ResultCompilerBackend.Ok
                            (string.append
                              (compiler-backend-emit-call-space-sub call-space)
                              (string.append
                                args-asm
                                (string.append
                                  func-asm
                                  (str_cat.str-cat
                                    "    movq 8("
                                    scav-clo
                                    "), "
                                    env-reg
                                    "\n    call *("
                                    scav-clo
                                    ")\n"
                                    (string.append
                                      (compiler-backend-emit-call-space-add
                                        call-space)
                                      result-store)
                                    "")))))]
                        [(ResultCompilerBackend.Err message)
                          (ResultCompilerBackend.Err
                            (box
                              (compiler-backend-apply-instr-diagnostic
                                (box-get message)
                                instr-diag)))]))])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err
                  (box
                    (compiler-backend-apply-instr-diagnostic
                      (box-get message)
                      instr-diag)))])]
          [(ResultBackendReg.Err message)
            (ResultCompilerBackend.Err
              (box (compiler-diagnostic-with-message instr-diag message)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-emit-indirect-call
  [target : CompilerBackendTarget]
  [dst : i64]
  [func : CompilerIrValue]
  [args : CompilerIrCallArgs]
  [ty : AstType]
  [assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (compiler-backend-emit-indirect-call-with-arg-assignments
    target
    dst
    func
    args
    ty
    assignments
    assignments
    types
    functions
    externs
    program-index
    vars
    instr-diag))

(define (compiler-backend-emit-tail-indirect-call
  [target : CompilerBackendTarget]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [func : CompilerIrValue]
  [args : CompilerIrCallArgs]
  [ty : AstType]
  [assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [vars : i64]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [param-types : AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    [call-space : i64
      (compiler-backend-closure-call-arg-space
        target
        args
        param-types
        program-index)]
    [register-only : bool
      (compiler-backend-indirect-tail-call-register-only?
        target
        args
        param-types
        program-index)]
    (match (compiler-backend-emit-call-args
      target
      assignments
      args
      param-types
      false
      0
      1
      0
      1
      0
      instr-diag
      program-index
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (let
          [clo-reg : String (compiler-backend-scavenge-tail-call-target-reg)]
          (match (compiler-backend-emit-load-value-with-plan
            assignments
            func
            clo-reg)
            [(ResultCompilerBackend.Ok func-asm)
              (match (compiler-backend-target-arg-reg target 0)
                [(ResultBackendReg.Ok env-reg)
                  (let
                    [target-addr : String
                      (str_cat.str-cat "*(" clo-reg ")" "" "")]
                    [descriptor-asm : String
                      (str_cat.str-cat
                        func-asm
                        "    movq 8("
                        clo-reg
                        "), "
                        env-reg
                        "\n"
                        "")]
                    (if register-only
                      (ResultCompilerBackend.Ok
                        (string.append
                          args-asm
                          (string.append
                            descriptor-asm
                            (compiler-backend-tail-jump-tail
                              assignments
                              vars
                              target-addr))))
                      (ResultCompilerBackend.Ok
                        (string.append
                          (compiler-backend-emit-call-space-sub call-space)
                          (string.append
                            args-asm
                            (string.append
                              descriptor-asm
                              (str_cat.str-cat
                                "    call "
                                target-addr
                                "\n"
                                (compiler-backend-emit-call-space-add
                                  call-space)
                                (string.append
                                  (compiler-backend-tail-call-return-normalize
                                    ty)
                                  (compiler-backend-return-tail
                                    source-function
                                    assignments
                                    vars
                                    blocks))
                                ""
                                "")))))))]
                [(ResultBackendReg.Err message)
                  (ResultCompilerBackend.Err
                    (box (compiler-diagnostic-with-message instr-diag message)))])]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler-backend-apply-instr-diagnostic
                    (box-get message)
                    instr-diag)))]))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-indirect-c-call-direct-home?
  [_target : CompilerBackendTarget]
  [home : String]) : bool
  ;; Use the callee-saved homes common to SysV and Win64. Win64 also preserves
  ;; rdi/rsi, but those stay on the fallback path for this conservative pass.
  (or
    (string.eq home "%rbx")
    (string.eq home "%r12")
    (string.eq home "%r13")
    (string.eq home "%r14")
    (string.eq home "%r15")))

(define (compiler-backend-indirect-c-call-direct-home
  [target : CompilerBackendTarget]
  [assignments : CompilerRegAssignmentList]
  [func : CompilerIrValue]) : String
  (let
    [home : String (compiler-backend-value-register-home assignments func)]
    (if (compiler-backend-indirect-c-call-direct-home? target home)
      home
      "")))

(define (compiler-backend-scavenge-call-target-reg) : String
  ;; Indirect call targets are materialized after argument marshalling. Do not
  ;; reuse pooled caller-arg candidates that may already hold in-flight args, and
  ;; keep %r11 available for ABI/runtime clobber semantics instead of staging.
  (compiler-backend-scavenge-reg-here
    (compiler-backend-c-abi-stage-exclude-with "%r11")
    5
    "%r10"))

(define (compiler-backend-emit-indirect-c-call
  [target : CompilerBackendTarget]
  [dst : i64]
  [func : CompilerIrValue]
  [args : CompilerIrCallArgs]
  [ty : AstType]
  [assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [declared-param-types : AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    [param-types : AstTypeList
      (if (compiler-backend-type-list-has-aggregate? declared-param-types)
        (compiler-backend-call-c-abi-param-types
          types
          (CompilerBackendGlobalTypeList.Nil)
          args
          declared-param-types
          program-index)
        (if (=
          (compiler-backend-call-args-count args)
          (compiler-backend-type-list-count declared-param-types))
          declared-param-types
          (compiler-backend-call-actual-param-types
            types
            (CompilerBackendGlobalTypeList.Nil)
            args)))]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        true
        program-index)]
    [direct-home : String
      (compiler-backend-indirect-c-call-direct-home target assignments func)]
    (match (compiler-backend-emit-call-args
      target
      assignments
      args
      param-types
      true
      0
      0
      0
      0
      0
      instr-diag
      program-index
      ;; Real frame var count for group-word1 slot addressing (see
      ;; emit-indirect-call): latent today because C-ABI lowering never passes
      ;; 16-byte aggregates by value, but keep it correct.
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (if (string.eq direct-home "")
          (let
            [call-reg : String (compiler-backend-scavenge-call-target-reg)]
            (match (compiler-backend-emit-load-value-with-plan
              assignments
              func
              call-reg)
              [(ResultCompilerBackend.Ok func-asm)
                (ResultCompilerBackend.Ok
                  (string.append
                    (compiler-backend-emit-call-space-sub call-space)
                    (string.append
                      args-asm
                      (string.append
                        func-asm
                        (str_cat.str-cat
                          "    call *"
                          call-reg
                          "\n"
                          (compiler-backend-emit-call-space-add call-space)
                          (compiler-backend-emit-call-result-store-reg
                            assignments
                            dst
                            (if (compiler-backend-float-type? ty)
                              "%xmm0"
                              "%rax")
                            ty)
                          ""
                          "")))))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err
                  (box
                    (compiler-backend-apply-instr-diagnostic
                      (box-get message)
                      instr-diag)))]))
          (ResultCompilerBackend.Ok
            (string.append
              (compiler-backend-emit-call-space-sub call-space)
              (string.append
                args-asm
                (str_cat.str-cat
                  "    call *"
                  direct-home
                  "\n"
                  (compiler-backend-emit-call-space-add call-space)
                  (compiler-backend-emit-call-result-store-reg
                    assignments
                    dst
                    (if (compiler-backend-float-type? ty)
                      "%xmm0"
                      "%rax")
                    ty)
                  ""
                  "")))))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-emit-c-abi-store-result-call
  [target : CompilerBackendTarget]
  [base : CompilerIrValue]
  [name : String]
  [args : CompilerIrCallArgs]
  [slots : CompilerIrCAbiReturnSlotList]
  [assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [plan : CompilerBackendRuntimePlan]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [param-types : AstTypeList
      (compiler-backend-call-param-types-for-call
        name
        args
        types
        global-types
        externs
        program-index)]
    [c-abi? : bool (compiler-backend-c-aggregate-extern-call? externs name)]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        c-abi?
        program-index)]
    [total-space : i64 (+ call-space 16)]
    ;; #65a-ii: on Linux the args + 16-byte base-save region are reserved in the
    ;; prologue frame (instr-outgoing-stack-space), so no per-call %rsp dip.
    ;; Windows keeps rbp + dips per-call -> unchanged.
    [dip : i64
      (match target
        [(CompilerBackendTarget.Linux) 0]
        [(CompilerBackendTarget.Windows) total-space])]
    [call-symbol : String
      (compiler-backend-call-symbol-index name plan program-index)]
    (match (compiler-backend-emit-call-args
      target
      assignments
      args
      param-types
      c-abi?
      0
      0
      0
      0
      0
      instr-diag
      program-index
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-emit-c-abi-return-base-save
          assignments
          base
          call-space)
          [(ResultCompilerBackend.Ok base-save)
            (ResultCompilerBackend.Ok
              (string.append
                (compiler-backend-emit-call-space-sub dip)
                (string.append
                  args-asm
                  (string.append
                    base-save
                    (string.append
                      (compiler-backend-varargs-pre-call
                        target
                        name
                        externs
                        param-types)
                      (str_cat.str-cat
                        "    call "
                        call-symbol
                        "\n"
                        (string.append
                          (compiler-backend-emit-c-abi-return-stores
                            call-space
                            slots)
                          (compiler-backend-emit-call-space-add dip))
                        ""))))))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (box-get message)
                  instr-diag)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-emit-indirect-c-abi-store-result-call
  [target : CompilerBackendTarget]
  [base : CompilerIrValue]
  [func : CompilerIrValue]
  [args : CompilerIrCallArgs]
  [slots : CompilerIrCAbiReturnSlotList]
  [assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [declared-param-types : AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    [param-types : AstTypeList
      (if (compiler-backend-type-list-has-aggregate? declared-param-types)
        (compiler-backend-call-c-abi-param-types
          types
          (CompilerBackendGlobalTypeList.Nil)
          args
          declared-param-types
          program-index)
        (if (=
          (compiler-backend-call-args-count args)
          (compiler-backend-type-list-count declared-param-types))
          declared-param-types
          (compiler-backend-call-actual-param-types
            types
            (CompilerBackendGlobalTypeList.Nil)
            args)))]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        true
        program-index)]
    [total-space : i64 (+ call-space 16)]
    ;; #65a-ii: Linux folds the c-abi dip into the frame (see named variant).
    [dip : i64
      (match target
        [(CompilerBackendTarget.Linux) 0]
        [(CompilerBackendTarget.Windows) total-space])]
    (match (compiler-backend-emit-call-args
      target
      assignments
      args
      param-types
      true
      0
      0
      0
      0
      0
      instr-diag
      program-index
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-emit-c-abi-return-base-save
          assignments
          base
          call-space)
          [(ResultCompilerBackend.Ok base-save)
            (let
              [call-reg : String (compiler-backend-scavenge-call-target-reg)]
              (match (compiler-backend-emit-load-value-with-plan
                assignments
                func
                call-reg)
                [(ResultCompilerBackend.Ok func-asm)
                  (ResultCompilerBackend.Ok
                    (string.append
                      (compiler-backend-emit-call-space-sub dip)
                      (string.append
                        args-asm
                        (string.append
                          base-save
                          (string.append
                            func-asm
                            (str_cat.str-cat
                              "    call *"
                              call-reg
                              "\n"
                              (string.append
                                (compiler-backend-emit-c-abi-return-stores
                                  call-space
                                  slots)
                                (compiler-backend-emit-call-space-add dip))
                              ""
                              ""
                              ""))))))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err
                    (box
                      (compiler-backend-apply-instr-diagnostic
                        (box-get message)
                        instr-diag)))]))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (box-get message)
                  instr-diag)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-emit-instrs-step
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : String]
  [blocks : CompilerIrBlockList]
  [current-label : String]
  [fallthrough : CompilerBackendMaybeLabel]
  [instrs : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [ret-ty : AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [func-diag : CompilerDiagnostic]
  [use-counts : (Array i64)]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (match instrs
    [(CompilerIrInstrList.Nil) (ResultCompilerBackend.Ok (text_buf.render buf))]
    [(CompilerIrInstrList.Cons instr rest)
      (match instr
        [(CompilerIrInstr.Mov dst src ty)
          (match (box-get rest)
            [(CompilerIrInstrList.Cons next after-jump)
              (match next
                [(CompilerIrInstr.Cast cast-dst cast-src _ _)
                  (match (box-get after-jump)
                    [(CompilerIrInstrList.Cons after-cast after-binop)
                      (match after-cast
                        [(CompilerIrInstr.BinOp bin-dst op lhs rhs bin-ty)
                          (if (and
                            (compiler-backend-divmod-op? op)
                            (compiler-backend-branch-uses-var? cast-src dst)
                            (compiler-backend-branch-uses-var? rhs cast-dst)
                            (compiler-backend-var-single-use? use-counts dst)
                            (compiler-backend-var-single-use?
                              use-counts
                              cast-dst)
                            (compiler-backend-divmod-safe-literal? src bin-ty))
                            (match (compiler-backend-emit-binop
                              types
                              global-types
                              assignments
                              bin-dst
                              op
                              lhs
                              src
                              bin-ty)
                              [(ResultCompilerBackend.Ok binop-asm)
                                (compiler-backend-emit-instrs
                                  target
                                  function
                                  source-function
                                  blocks
                                  current-label
                                  fallthrough
                                  (box-get after-binop)
                                  assignments
                                  vars
                                  types
                                  global-types
                                  ret-ty
                                  plan
                                  functions
                                  externs
                                  program-index
                                  spans
                                  func-diag
                                  use-counts
                                  (compiler-backend-emergency-append
                                    buf
                                    binop-asm))]
                              [(ResultCompilerBackend.Err message)
                                (ResultCompilerBackend.Err message)])
                            (compiler-backend-emit-instrs-normal
                              target
                              function
                              source-function
                              blocks
                              current-label
                              fallthrough
                              instr
                              (box-get rest)
                              assignments
                              vars
                              types
                              global-types
                              ret-ty
                              plan
                              functions
                              externs
                              program-index
                              spans
                              func-diag
                              use-counts
                              buf))]
                        [_
                          (compiler-backend-emit-instrs-normal
                            target
                            function
                            source-function
                            blocks
                            current-label
                            fallthrough
                            instr
                            (box-get rest)
                            assignments
                            vars
                            types
                            global-types
                            ret-ty
                            plan
                            functions
                            externs
                            program-index
                            spans
                            func-diag
                            use-counts
                            buf)])]
                    [_
                      (compiler-backend-emit-instrs-normal
                        target
                        function
                        source-function
                        blocks
                        current-label
                        fallthrough
                        instr
                        (box-get rest)
                        assignments
                        vars
                        types
                        global-types
                        ret-ty
                        plan
                        functions
                        externs
                        program-index
                        spans
                        func-diag
                        use-counts
                        buf)])]
                [(CompilerIrInstr.BinOp bin-dst op lhs rhs bin-ty)
                  (if (and
                    (compiler-backend-divmod-op? op)
                    (compiler-backend-branch-uses-var? rhs dst)
                    (compiler-backend-divmod-safe-literal? src bin-ty))
                    (match (if (compiler-backend-var-single-use? use-counts dst)
                      (ResultCompilerBackend.Ok "")
                      (compiler-backend-emit-mov
                        assignments
                        dst
                        src
                        ty
                        program-index
                        vars))
                      [(ResultCompilerBackend.Ok prefix)
                        (match (compiler-backend-emit-binop
                          types
                          global-types
                          assignments
                          bin-dst
                          op
                          lhs
                          src
                          bin-ty)
                          [(ResultCompilerBackend.Ok binop-asm)
                            (compiler-backend-emit-instrs
                              target
                              function
                              source-function
                              blocks
                              current-label
                              fallthrough
                              (box-get after-jump)
                              assignments
                              vars
                              types
                              global-types
                              ret-ty
                              plan
                              functions
                              externs
                              program-index
                              spans
                              func-diag
                              use-counts
                              (compiler-backend-emergency-append
                                buf
                                (string.append prefix binop-asm)))]
                          [(ResultCompilerBackend.Err message)
                            (ResultCompilerBackend.Err message)])]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err message)])
                    (compiler-backend-emit-instrs-normal
                      target
                      function
                      source-function
                      blocks
                      current-label
                      fallthrough
                      instr
                      (box-get rest)
                      assignments
                      vars
                      types
                      global-types
                      ret-ty
                      plan
                      functions
                      externs
                      program-index
                      spans
                      func-diag
                      use-counts
                      buf))]
                [(CompilerIrInstr.Jump target-label)
                  (compiler-backend-emit-fused-mov-trivial-phi-return-rest
                    target
                    function
                    source-function
                    blocks
                    current-label
                    fallthrough
                    dst
                    src
                    ty
                    target-label
                    (box-get after-jump)
                    assignments
                    vars
                    types
                    global-types
                    ret-ty
                    plan
                    functions
                    externs
                    program-index
                    spans
                    func-diag
                    use-counts
                    buf)]
                [(CompilerIrInstr.Return maybe)
                  (match (box-get after-jump)
                    [(CompilerIrInstrList.Nil)
                      (match maybe
                        [(CompilerIrMaybeValue.Some value)
                          (if (compiler-backend-branch-uses-var? value dst)
                            (match (compiler-backend-emit-return
                              source-function
                              blocks
                              (CompilerIrMaybeValue.Some src)
                              assignments
                              vars
                              ret-ty
                              program-index)
                              [(ResultCompilerBackend.Ok asm)
                                (ResultCompilerBackend.Ok
                                  (compiler-backend-emergency-render-append
                                    buf
                                    asm))]
                              [(ResultCompilerBackend.Err message)
                                (ResultCompilerBackend.Err
                                  (box
                                    (compiler-backend-apply-instr-diagnostic
                                      (box-get message)
                                      (compiler-backend-instr-diagnostic
                                        spans
                                        source-function
                                        instr
                                        func-diag
                                        ""))))])
                            (compiler-backend-emit-instrs-normal
                              target
                              function
                              source-function
                              blocks
                              current-label
                              fallthrough
                              instr
                              (box-get rest)
                              assignments
                              vars
                              types
                              global-types
                              ret-ty
                              plan
                              functions
                              externs
                              program-index
                              spans
                              func-diag
                              use-counts
                              buf))]
                        [(CompilerIrMaybeValue.No)
                          (compiler-backend-emit-instrs-normal
                            target
                            function
                            source-function
                            blocks
                            current-label
                            fallthrough
                            instr
                            (box-get rest)
                            assignments
                            vars
                            types
                            global-types
                            ret-ty
                            plan
                            functions
                            externs
                            program-index
                            spans
                            func-diag
                            use-counts
                            buf)])]
                    [_
                      (compiler-backend-emit-instrs-normal
                        target
                        function
                        source-function
                        blocks
                        current-label
                        fallthrough
                        instr
                        (box-get rest)
                        assignments
                        vars
                        types
                        global-types
                        ret-ty
                        plan
                        functions
                        externs
                        program-index
                        spans
                        func-diag
                        use-counts
                        buf)])]
                [_
                  (compiler-backend-emit-instrs-normal
                    target
                    function
                    source-function
                    blocks
                    current-label
                    fallthrough
                    instr
                    (box-get rest)
                    assignments
                    vars
                    types
                    global-types
                    ret-ty
                    plan
                    functions
                    externs
                    program-index
                    spans
                    func-diag
                    use-counts
                    buf)])]
            [_
              (compiler-backend-emit-instrs-normal
                target
                function
                source-function
                blocks
                current-label
                fallthrough
                instr
                (box-get rest)
                assignments
                vars
                types
                global-types
                ret-ty
                plan
                functions
                externs
                program-index
                spans
                func-diag
                use-counts
                buf)])]
        [(CompilerIrInstr.Call dst name args ty)
          (match (box-get rest)
            [(CompilerIrInstrList.Cons next after-return)
              (match next
                [(CompilerIrInstr.Return maybe)
                  (match (box-get after-return)
                    [(CompilerIrInstrList.Nil)
                      (match maybe
                        [(CompilerIrMaybeValue.Some value)
                          (if (and
                            (compiler-backend-branch-uses-var? value dst)
                            (opt-type-eq ty ret-ty))
                            (compiler-backend-emit-terminator-into
                              (compiler-backend-emit-call-return
                                target
                                source-function
                                blocks
                                name
                                args
                                assignments
                                types
                                global-types
                                vars
                                plan
                                functions
                                externs
                                program-index
                                (compiler-backend-instr-diagnostic
                                  spans
                                  source-function
                                  instr
                                  func-diag
                                  ""))
                              buf)
                            (compiler-backend-emit-instrs-normal
                              target
                              function
                              source-function
                              blocks
                              current-label
                              fallthrough
                              instr
                              (box-get rest)
                              assignments
                              vars
                              types
                              global-types
                              ret-ty
                              plan
                              functions
                              externs
                              program-index
                              spans
                              func-diag
                              use-counts
                              buf))]
                        [(CompilerIrMaybeValue.No)
                          (compiler-backend-emit-instrs-normal
                            target
                            function
                            source-function
                            blocks
                            current-label
                            fallthrough
                            instr
                            (box-get rest)
                            assignments
                            vars
                            types
                            global-types
                            ret-ty
                            plan
                            functions
                            externs
                            program-index
                            spans
                            func-diag
                            use-counts
                            buf)])]
                    [_
                      (compiler-backend-emit-instrs-normal
                        target
                        function
                        source-function
                        blocks
                        current-label
                        fallthrough
                        instr
                        (box-get rest)
                        assignments
                        vars
                        types
                        global-types
                        ret-ty
                        plan
                        functions
                        externs
                        program-index
                        spans
                        func-diag
                        use-counts
                        buf)])]
                [_
                  (compiler-backend-emit-instrs-normal
                    target
                    function
                    source-function
                    blocks
                    current-label
                    fallthrough
                    instr
                    (box-get rest)
                    assignments
                    vars
                    types
                    global-types
                    ret-ty
                    plan
                    functions
                    externs
                    program-index
                    spans
                    func-diag
                    use-counts
                    buf)])]
            [_
              (compiler-backend-emit-instrs-normal
                target
                function
                source-function
                blocks
                current-label
                fallthrough
                instr
                (box-get rest)
                assignments
                vars
                types
                global-types
                ret-ty
                plan
                functions
                externs
                program-index
                spans
                func-diag
                use-counts
                buf)])]
        [(CompilerIrInstr.StorePtr ptr value0 ty0)
          (match (box-get rest)
            [(CompilerIrInstrList.Cons maybe-gep after-gep)
              (match maybe-gep
                [(CompilerIrInstr.Gep gep-dst base offset elem-ty)
                  (if (and
                    (opt-value-eq base ptr)
                    (compiler-backend-var-single-use? use-counts gep-dst))
                    (match (compiler-backend-value-as-i64 offset)
                      [(option_i64.Some n)
                        (let
                          [disp : i64
                            (* n (compiler-backend-type-size elem-ty))]
                          (if (compiler-backend-imm32? disp)
                            (match (box-get after-gep)
                              [(CompilerIrInstrList.Cons
                                  maybe-store
                                  after-store)
                                (match maybe-store
                                  [(CompilerIrInstr.StorePtr dst value1 ty1)
                                    (if (compiler-backend-branch-uses-var?
                                      dst
                                      gep-dst)
                                      (compiler-backend-emit-fused-result-rest
                                        target
                                        function
                                        source-function
                                        blocks
                                        current-label
                                        fallthrough
                                        (compiler-backend-emit-store-ptr-pair
                                          assignments
                                          ptr
                                          value0
                                          ty0
                                          disp
                                          value1
                                          ty1
                                          program-index)
                                        (box-get after-store)
                                        assignments
                                        vars
                                        types
                                        global-types
                                        ret-ty
                                        plan
                                        functions
                                        externs
                                        program-index
                                        spans
                                        func-diag
                                        use-counts
                                        buf)
                                      (compiler-backend-emit-instrs-normal
                                        target
                                        function
                                        source-function
                                        blocks
                                        current-label
                                        fallthrough
                                        instr
                                        (box-get rest)
                                        assignments
                                        vars
                                        types
                                        global-types
                                        ret-ty
                                        plan
                                        functions
                                        externs
                                        program-index
                                        spans
                                        func-diag
                                        use-counts
                                        buf))]
                                  [_
                                    (compiler-backend-emit-instrs-normal
                                      target
                                      function
                                      source-function
                                      blocks
                                      current-label
                                      fallthrough
                                      instr
                                      (box-get rest)
                                      assignments
                                      vars
                                      types
                                      global-types
                                      ret-ty
                                      plan
                                      functions
                                      externs
                                      program-index
                                      spans
                                      func-diag
                                      use-counts
                                      buf)])]
                              [_
                                (compiler-backend-emit-instrs-normal
                                  target
                                  function
                                  source-function
                                  blocks
                                  current-label
                                  fallthrough
                                  instr
                                  (box-get rest)
                                  assignments
                                  vars
                                  types
                                  global-types
                                  ret-ty
                                  plan
                                  functions
                                  externs
                                  program-index
                                  spans
                                  func-diag
                                  use-counts
                                  buf)])
                            (compiler-backend-emit-instrs-normal
                              target
                              function
                              source-function
                              blocks
                              current-label
                              fallthrough
                              instr
                              (box-get rest)
                              assignments
                              vars
                              types
                              global-types
                              ret-ty
                              plan
                              functions
                              externs
                              program-index
                              spans
                              func-diag
                              use-counts
                              buf)))]
                      [(option_i64.None)
                        (compiler-backend-emit-instrs-normal
                          target
                          function
                          source-function
                          blocks
                          current-label
                          fallthrough
                          instr
                          (box-get rest)
                          assignments
                          vars
                          types
                          global-types
                          ret-ty
                          plan
                          functions
                          externs
                          program-index
                          spans
                          func-diag
                          use-counts
                          buf)])
                    (compiler-backend-emit-instrs-normal
                      target
                      function
                      source-function
                      blocks
                      current-label
                      fallthrough
                      instr
                      (box-get rest)
                      assignments
                      vars
                      types
                      global-types
                      ret-ty
                      plan
                      functions
                      externs
                      program-index
                      spans
                      func-diag
                      use-counts
                      buf))]
                [_
                  (compiler-backend-emit-instrs-normal
                    target
                    function
                    source-function
                    blocks
                    current-label
                    fallthrough
                    instr
                    (box-get rest)
                    assignments
                    vars
                    types
                    global-types
                    ret-ty
                    plan
                    functions
                    externs
                    program-index
                    spans
                    func-diag
                    use-counts
                    buf)])]
            [_
              (compiler-backend-emit-instrs-normal
                target
                function
                source-function
                blocks
                current-label
                fallthrough
                instr
                (box-get rest)
                assignments
                vars
                types
                global-types
                ret-ty
                plan
                functions
                externs
                program-index
                spans
                func-diag
                use-counts
                buf)])]
        [(CompilerIrInstr.Gep gep-dst base offset elem-ty)
          (if (compiler-backend-var-single-use? use-counts gep-dst)
            (match (compiler-backend-value-as-i64 offset)
              [(option_i64.Some n)
                (match (box-get rest)
                  [(CompilerIrInstrList.Cons next after-load)
                    (match next
                      [(CompilerIrInstr.Load load-dst src load-ty)
                        (if (compiler-backend-branch-uses-var? src gep-dst)
                          (if (and
                            (compiler-backend-load-compare-type? load-ty)
                            (compiler-backend-var-single-use?
                              use-counts
                              load-dst))
                            (match (box-get after-load)
                              [(CompilerIrInstrList.Cons maybe-cmp after-cmp)
                                (match maybe-cmp
                                  [(CompilerIrInstr.BinOp
                                      cmp-dst
                                      op
                                      lhs
                                      rhs
                                      cmp-ty)
                                    (if (and
                                      (compiler-backend-compare-op? op)
                                      (compiler-backend-branch-uses-var?
                                        lhs
                                        load-dst)
                                      (compiler-backend-var-single-use?
                                        use-counts
                                        cmp-dst)
                                      (not
                                        (compiler-backend-binop-f64?
                                          types
                                          global-types
                                          lhs
                                          rhs
                                          cmp-ty)))
                                      (match (box-get after-cmp)
                                        [(CompilerIrInstrList.Cons
                                            branch
                                            after-branch)
                                          (match branch
                                            [(CompilerIrInstr.Branch
                                                cond
                                                true-label
                                                false-label)
                                              (if (compiler-backend-branch-uses-var?
                                                cond
                                                cmp-dst)
                                                (compiler-backend-emit-fused-gep-load-compare-branch-rest
                                                  target
                                                  function
                                                  source-function
