      (compiler-backend-runtime-index-calls? index "tl_profile_alloc_live")]
    [calls-profile-alloc-peak : bool
      (compiler-backend-runtime-index-calls? index "tl_profile_alloc_peak")]
    [calls-profile-alloc-reset-peak : bool
      (compiler-backend-runtime-index-calls?
        index
        "tl_profile_alloc_reset_peak")]
    [needs-oob : bool (and (not defines-oob) (or extern-oob calls-oob))]
    [needs-div-abort : bool
      (or
        (compiler-backend-runtime-index-needs-div-abort? index)
        (and (not defines-div-abort) (or extern-div-abort calls-div-abort)))]
    [needs-shift-abort : bool
      (or
        (compiler-backend-runtime-index-needs-shift-abort? index)
        (and
          (not defines-shift-abort)
          (or extern-shift-abort calls-shift-abort)))]
    ;; Migrated string helpers live in stdlib/runtime.tl, but the backend owns
    ;; their fixed ABI labels once those prelude helpers are emitted.
    [needs-substring : bool
      (or provides-substring (and (not defines-substring) calls-substring))]
    [needs-str-view : bool
      (or provides-str-view (and (not defines-str-view) calls-str-view))]
    [needs-concat : bool
      (or provides-concat (and (not defines-concat) calls-concat))]
    [_needs-string-eq : bool false]
    [_needs-string-to-int : bool false]
    [_needs-hash-string : bool false]
    [needs-int-to-string : bool
      (or
        provides-int-to-string
        (and (not defines-int-to-string) calls-int-to-string))]
    [_direct-abort : bool false]
    [needs-print-err : bool false]
    [needs-print-str : bool false]
    [needs-print-char : bool false]
    [needs-print-f64 : bool false]
    [needs-arg-count : bool false]
    [needs-arg : bool false]
    [needs-read-file : bool false]
    [needs-write-file : bool false]
    [needs-file-exists : bool false]
    [needs-file-handle : bool false]
    [needs-file-read-chunk : bool false]
    [needs-fs-runtime : bool false]
    [needs-read-line : bool false]
    [needs-read-bytes : bool false]
    [needs-stdin-eof : bool false]
    [needs-flush-stdout : bool false]
    [needs-region-mark : bool
      (and (not defines-region-mark) (or extern-region-mark calls-region-mark))]
    [needs-region-reset : bool
      (and
        (not defines-region-reset)
        (or extern-region-reset calls-region-reset))]
    [needs-random-system-seed : bool false]
    [needs-env-var-exists : bool
      (and (not defines-env-var-exists) calls-env-var-exists)]
    [needs-env-var-value : bool
      (and (not defines-env-var-value) calls-env-var-value)]
    [needs-env-path-separator : bool
      (and (not defines-env-path-separator) calls-env-path-separator)]
    [direct-alloc : bool (and (not defines-alloc) calls-alloc)]
    [needs-abort : bool
      (or extern-abort calls-abort needs-arg needs-read-file needs-write-file)]
    [needs-alloc : bool
      (or
        (backend-or8
          direct-alloc
          needs-int-to-string
          needs-substring
          needs-str-view
          needs-arg
          needs-read-file
          needs-write-file
          needs-file-exists)
        (backend-or8
          needs-file-handle
          needs-file-read-chunk
          needs-fs-runtime
          false
          needs-read-line
          needs-read-bytes
          needs-random-system-seed
          false)
        (backend-or4
          needs-env-var-exists
          needs-env-var-value
          needs-env-path-separator
          false))]
    [needs-profile : bool
      (backend-or4
        (and
          (not defines-profile-alloc-total)
          (or extern-profile-alloc-total calls-profile-alloc-total))
        (and
          (not defines-profile-alloc-live)
          (or extern-profile-alloc-live calls-profile-alloc-live))
        (and
          (not defines-profile-alloc-peak)
          (or extern-profile-alloc-peak calls-profile-alloc-peak))
        (and
          (not defines-profile-alloc-reset-peak)
          (or extern-profile-alloc-reset-peak calls-profile-alloc-reset-peak)))]
    [needs-tlci-macro-entry : bool
      (or
        (compiler-backend-runtime-index-calls? index "tl_tlci_call_macro_entry")
        (compiler-backend-runtime-index-calls?
          index
          "tlci-loader-call-macro-entry-raw"))]
    (ResultBackendRuntimePlanWithIndex.Ok
      (CompilerBackendRuntimePlanWithIndex
        (CompilerBackendRuntimePlan.Plan
          needs-alloc
          needs-oob
          needs-substring
          needs-str-view
          needs-concat
          false
          false
          needs-int-to-string
          needs-abort
          needs-print-err
          needs-print-str
          needs-print-char
          needs-print-f64
          needs-arg-count
          needs-arg
          needs-read-file
          needs-write-file
          needs-file-exists
          needs-file-handle
          needs-file-read-chunk
          needs-fs-runtime
          false
          needs-read-line
          needs-read-bytes
          needs-stdin-eof
          needs-flush-stdout
          needs-region-mark
          needs-region-reset
          needs-random-system-seed
          needs-env-var-exists
          needs-env-var-value
          needs-env-path-separator
          needs-div-abort
          needs-shift-abort
          (CompilerBackendRuntimeTailPlan
            needs-profile
            false
            needs-tlci-macro-entry))
        index))))

(define (compiler-backend-runtime-plan-for
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]) : ResultBackendRuntimePlan
  (match (compiler-backend-runtime-plan-with-index-for functions externs)
    [(ResultBackendRuntimePlanWithIndex.Ok planned)
      (ResultBackendRuntimePlan.Ok (struct-get planned plan))]
    [(ResultBackendRuntimePlanWithIndex.Err message)
      (ResultBackendRuntimePlan.Err message)]))

(define (compiler-backend-runtime-plan [program : CompilerIrProgram]) : ResultBackendRuntimePlan
  (begin
    ;; Seed builtin/runtime ids before scratch-backed per-function emission. The
    ;; runtime-plan id predicates are then lookup-only in scratch arenas.
    (cbi.compiler-builtin-refresh!)
    (match program
      [(CompilerIrProgram.Program _ functions externs)
        (compiler-backend-runtime-plan-for functions externs)])))

(define (compiler-backend-runtime-plan-with-index [program : CompilerIrProgram]) : ResultBackendRuntimePlanWithIndex
  (begin
    ;; Seed builtin/runtime ids before scratch-backed per-function emission. The
    ;; runtime-plan id predicates are then lookup-only in scratch arenas.
    (cbi.compiler-builtin-refresh!)
    (match program
      [(CompilerIrProgram.Program _ functions externs)
        (compiler-backend-runtime-plan-with-index-for functions externs)])))

(define (compiler-backend-extern-symbol-referenced?
  [runtime-index : CompilerBackendRuntimeIndex]
  [referenced-functions : BackendStringList]
  [extern-name : String]
  [link-symbol : String]) : bool
  (let
    [user-symbol : String (compiler-backend-user-symbol extern-name)]
    [foreign-link-symbol : bool
      (and
        (not (string.eq extern-name link-symbol))
        (not (compiler-backend-runtime-helper-known? extern-name))
        (not (compiler-backend-runtime-helper-known? link-symbol)))]
    (or
      foreign-link-symbol
      (backend-or4
        (compiler-backend-runtime-index-calls? runtime-index extern-name)
        (compiler-backend-runtime-index-calls? runtime-index link-symbol)
        (compiler-backend-string-list-contains?
          referenced-functions
          extern-name)
        (compiler-backend-string-list-contains?
          referenced-functions
          link-symbol))
      (compiler-backend-runtime-index-calls? runtime-index user-symbol)
      (compiler-backend-string-list-contains? referenced-functions user-symbol))))

(define (compiler-backend-emit-externs-into
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [runtime-index : CompilerBackendRuntimeIndex]
  [referenced-functions : BackendStringList]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match externs
    [(CompilerIrExternList.Nil) buf]
    [(CompilerIrExternList.Cons item rest)
      (match item
        [(CompilerIrExtern.Extern name _ _ link-symbol _ provided)
          (if (and
            (compiler-backend-emits-extern-symbol?
              name
              link-symbol
              provided
              plan)
            (compiler-backend-extern-symbol-referenced?
              runtime-index
              referenced-functions
              name
              link-symbol))
            (compiler-backend-emit-externs-into
              (box-get rest)
              plan
              runtime-index
              referenced-functions
              (text_buf.append
                (text_buf.append buf ".extern ")
                (str_cat.str-cat
                  (compiler-backend-link-symbol link-symbol plan)
                  "\n"
                  "")))
            (compiler-backend-emit-externs-into
              (box-get rest)
              plan
              runtime-index
              referenced-functions
              buf))])]
    [(CompilerIrExternList.Array seq)
      (compiler-backend-emit-externs-into
        (compiler-ir-extern-seq-to-list seq)
        plan
        runtime-index
        referenced-functions
        buf)]))

;; Allocation-failure messages live in the runtime prelude (stdlib/runtime.tl):
;; generic overflow/non-OS paths use `oom-abort`/`tl_oom_abort`, while Windows
;; VirtualAlloc failures pass captured provenance to
;; `tl_windows_allocation_abort`. The allocator contributes no runtime data.
(define (compiler-backend-runtime-alloc-data-for-target
  [_target : CompilerBackendTarget]) : String
  "")

;; `tl_current_arena` is the live bump-arena pointer shared by tl_alloc, the
;; region runtime, and the first-class arena builtins. It is a
;; per-thread active-arena slot: Linux uses local-exec ELF TLS; Windows
;; stores the pointer in the TEB arbitrary-user slot (GS:0x28). Like the arena
;; primitives, the runtime lives in exactly ONE object per executable (the entry
;; object, `emit-entry=true`); library/dependency objects (`emit-entry=false`)
;; emit none of the runtime and reference the Linux TLS slot as an extern.
(define (compiler-backend-runtime-arena-data-for-target
  [target : CompilerBackendTarget]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      "    .section .tbss,\"awT\",@nobits
    .balign 8
    .globl tl_current_arena
tl_current_arena:
    .zero 8

    .section .bss
    .balign 8
.L_tl_arena_poison_enabled:
    .zero 8

"]
    [(CompilerBackendTarget.Windows)
      "    .section .bss
    .balign 8
.L_tl_arena_poison_enabled:
    .zero 8

"]))

(define (compiler-backend-current-arena-load
  [target : CompilerBackendTarget]
  [dst : String]) : String
  (if (compiler-backend-target-windows? target)
    (str_cat.str-cat "    movq %gs:0x28, " dst "\n")
    (str_cat.str-cat "    movq %fs:tl_current_arena@tpoff, " dst "\n")))

(define (compiler-backend-current-arena-store
  [target : CompilerBackendTarget]
  [src : String]) : String
  (if (compiler-backend-target-windows? target)
    (str_cat.str-cat "    movq " src ", %gs:0x28\n")
    (str_cat.str-cat "    movq " src ", %fs:tl_current_arena@tpoff\n")))

(define (compiler-backend-current-arena-clear [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    "    movq $0, %gs:0x28\n"
    "    movq $0, %fs:tl_current_arena@tpoff\n"))

(define (compiler-backend-runtime-profile-data [profile : bool]) : String
  (if profile
    "    .section .bss
    .balign 8
tl_profile_alloc_total_bytes:
    .zero 8
tl_profile_alloc_live_bytes:
    .zero 8
tl_profile_alloc_peak_bytes:
    .zero 8

"
    ""))

(define (compiler-backend-runtime-region-reset-data) : String
  "    .section .rodata
.L_tl_region_reset_msg:
    .byte 116,108,58,32,105,110,118,97,108,105,100,32,114,101,103,105,111,110,32,109,97,114,107,10
    .set .L_tl_region_reset_msg_len, . - .L_tl_region_reset_msg

")

;; The oob/division/shift fault message data lives in the runtime prelude
;; (stdlib/runtime.tl) handlers; the backend does not emit it.
(define (compiler-backend-runtime-argv-data) : String
  "    .data
    .balign 8
.L_tl_argc:
    .quad 0
.L_tl_argv:
    .quad 0

")

(define (compiler-backend-runtime-env-data
  [target : CompilerBackendTarget]
  [env-data : bool]) : String
  (let
    [_target : CompilerBackendTarget target]
    [_env-data : bool env-data]
    "    .data
    .balign 8
.L_tl_envp:
    .quad 0

"))

(define (compiler-backend-runtime-data-for-target
  [target : CompilerBackendTarget]
  [plan : CompilerBackendRuntimePlan]) : String
  (match plan
    [(CompilerBackendRuntimePlan.WithScratch base _)
      (compiler-backend-runtime-data-for-target target (box-get base))]
    [(CompilerBackendRuntimePlan.Plan
        alloc
        oob
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        region-mark
        region-reset
        _
        env-var-exists
        var-value
        _
        div-abort
        shift-abort
        tail-plan)
      (str_cat.str-cat
        (compiler-backend-runtime-arena-data-for-target target)
        (compiler-backend-runtime-profile-data
          (compiler-backend-runtime-tail-profile? tail-plan))
        (if alloc
          (compiler-backend-runtime-alloc-data-for-target target)
          "")
        ;; The oob/division/shift fault messages live in the runtime
        ;; prelude (stdlib/runtime.tl) handlers, not backend rodata.
        ""
        (if region-reset
          (compiler-backend-runtime-region-reset-data)
          "")
        (compiler-backend-runtime-argv-data)
        (compiler-backend-runtime-env-data target (or env-var-exists var-value)))]))

(define (compiler-backend-runtime-profile-alloc-account-with-scratch
  [size-reg : String]
  [done-label : String]
  [profile : bool]
  [scratch-reg : String]) : String
  (if profile
    (string.append
      (str_cat.str-cat
        "    addq "
        size-reg
        ", tl_profile_alloc_total_bytes(%rip)\n    addq "
        size-reg
        ", tl_profile_alloc_live_bytes(%rip)\n")
      (str_cat.str-cat
        "    movq tl_profile_alloc_live_bytes(%rip), "
        scratch-reg
        "\n    cmpq tl_profile_alloc_peak_bytes(%rip), "
        scratch-reg
        "\n    jbe "
        done-label
        "\n    movq "
        scratch-reg
        ", tl_profile_alloc_peak_bytes(%rip)\n"
        done-label
        ":\n"))
    ""))

(define (compiler-backend-runtime-profile-alloc-account
  [size-reg : String]
  [done-label : String]
  [profile : bool]) : String
  (compiler-backend-runtime-profile-alloc-account-with-scratch
    size-reg
    done-label
    profile
    "%r10"))

(define (compiler-backend-runtime-profile-live-sub
  [arena-reg : String]
  [used-reg : String]
  [profile : bool]) : String
  (if profile
    (str_cat.str-cat
      "    movq 16("
      arena-reg
      "), "
      used-reg
      "\n    subq 8("
      arena-reg
      "), "
      used-reg
      "\n    subq "
      used-reg
      ", tl_profile_alloc_live_bytes(%rip)\n")
    ""))

(define (compiler-backend-runtime-profile-live-rewind
  [arena-reg : String]
  [mark-reg : String]
  [used-reg : String]
  [profile : bool]) : String
  (if profile
    (str_cat.str-cat
      "    movq 16("
      arena-reg
      "), "
      used-reg
      "\n    subq "
      mark-reg
      ", "
      used-reg
      "\n    subq "
      used-reg
      ", tl_profile_alloc_live_bytes(%rip)\n")
    ""))

(define (compiler-backend-runtime-fast-alloc-function
  [target : CompilerBackendTarget]
  [size : i64]
  [size-reg : String]
  [next-reg : String]
  [profile : bool]) : String
  (let
    [size-text : String (string.int->string size)]
    [size-imm : String (string.append "$" size-text)]
    [label : String (compiler-backend-fast-alloc-label size)]
    [slow-label : String (string.append label "_slow")]
    [atomic-label : String (string.append label "_atomic")]
    [atomic-cas-label : String (string.append label "_atomic_cas")]
    [atomic-profile-label : String (string.append label "_atomic_profile_done")]
    [profile-label : String (string.append label "_profile_done")]
    ;; Windows reserves a full logical segment but commits it incrementally;
    ;; offset 64 is its committed-end pointer. Linux mappings are fully usable
    ;; through the reserved end at offset 24.
    [usable-end-offset : String
      (match target
        [(CompilerBackendTarget.Windows) "64"]
        [_ "24"])]
    [prologue : String
      (str_cat.str-cat
        label
        ":\n"
        (compiler-backend-current-arena-load target "%r8")
        "    testq %r8, %r8\n    jz "
        slow-label
        "\n")]
    [ordinary-body-a : String
      (str-cat
        "    movq 40(%r8), %r9
    testq $1, 48(%r9)
    jnz "
        atomic-label
        "
    movq 16(%r8), %rax")]
    [ordinary-body-b : String
      (str_cat.str-cat "\n    leaq " size-text "(%rax), " next-reg)]
    [ordinary-body-c : String
      (str_cat.str-cat
        (str_cat.str-cat "\n    cmpq %rax, " next-reg "\n    jb " slow-label)
        (str_cat.str-cat "\n    cmpq " usable-end-offset "(%r8), " next-reg))]
    [ordinary-body-d : String
      (str_cat.str-cat "\n    ja " slow-label "\n    movq " next-reg)]
    [ordinary-body : String
      (str_cat.str-cat
        ordinary-body-a
        ordinary-body-b
        ordinary-body-c
        ordinary-body-d
        ", 16(%r8)\n")]
    [ordinary-profile : String
      (compiler-backend-runtime-profile-alloc-account
        size-imm
        profile-label
        profile)]
    [atomic-body-a : String
      (str_cat.str-cat
        "    ret
"
        atomic-label
        ":
    movq 56(%r9), %r8
    movq 16(%r8), %rax
"
        atomic-cas-label)]
    [atomic-body-b : String
      (str_cat.str-cat ":\n    leaq " size-text "(%rax), " next-reg)]
    [atomic-body-c : String
      (str_cat.str-cat "\n    cmpq %rax, " next-reg "\n    jb " slow-label)]
    [atomic-body-d : String
      (str_cat.str-cat
        "\n    cmpq "
        usable-end-offset
        "(%r8), "
        next-reg
        "\n    ja "
        slow-label)]
    [atomic-body-e : String
      (str_cat.str-cat
        "\n    lock cmpxchgq "
        next-reg
        ", 16(%r8)\n    jne "
        atomic-cas-label)]
    [atomic-body : String
      (str_cat.str-cat
        atomic-body-a
        atomic-body-b
        atomic-body-c
        atomic-body-d
        atomic-body-e
        "\n")]
    [atomic-profile : String
      (compiler-backend-runtime-profile-alloc-account
        size-imm
        atomic-profile-label
        profile)]
    [slow-body : String
      (str_cat.str-cat
        "    ret
"
        slow-label
        ":\n    movq $"
        size-text
        ", "
        size-reg
        "\n    jmp tl_alloc\n")]
    (string.append
      prologue
      (string.append
        ordinary-body
        (string.append
          ordinary-profile
          (string.append atomic-body (string.append atomic-profile slow-body)))))))

(define (compiler-backend-runtime-fast-alloc-functions
  [target : CompilerBackendTarget]
  [size-reg : String]
  [next-reg : String]
  [profile : bool]) : String
  (string.append
    (string.append
      (compiler-backend-runtime-fast-alloc-function
        target
        8
        size-reg
        next-reg
        profile)
      (compiler-backend-runtime-fast-alloc-function
        target
        16
        size-reg
        next-reg
        profile))
    (string.append
      (string.append
        (compiler-backend-runtime-fast-alloc-function
          target
          24
          size-reg
          next-reg
          profile)
        (compiler-backend-runtime-fast-alloc-function
          target
          32
          size-reg
          next-reg
          profile))
      (string.append
        (string.append
          (compiler-backend-runtime-fast-alloc-function
            target
            40
            size-reg
            next-reg
            profile)
          (compiler-backend-runtime-fast-alloc-function
            target
            48
            size-reg
            next-reg
            profile))
        (string.append
          (compiler-backend-runtime-fast-alloc-function
            target
            56
            size-reg
            next-reg
            profile)
          (compiler-backend-runtime-fast-alloc-function
            target
            64
            size-reg
            next-reg
            profile))))))

(define (compiler-backend-runtime-linux-alloc-functions [profile : bool]) : String
  (let
    [fast-profile : String
      (compiler-backend-runtime-profile-alloc-account
        "%rsi"
        ".L_tl_alloc_profile_fast_done"
        profile)]
    [atomic-fast-profile : String
      (compiler-backend-runtime-profile-alloc-account
        "%rsi"
        ".L_tl_alloc_profile_atomic_fast_done"
        profile)]
    [atomic-locked-profile : String
      (compiler-backend-runtime-profile-alloc-account
        "%rsi"
        ".L_tl_alloc_profile_atomic_locked_done"
        profile)]
    [atomic-new-profile : String
      (compiler-backend-runtime-profile-alloc-account
        "%rsi"
        ".L_tl_alloc_profile_atomic_new_done"
        profile)]
    [new-profile : String
      (compiler-backend-runtime-profile-alloc-account
        "%rsi"
        ".L_tl_alloc_profile_new_done"
        profile)]
    [prefix : String
      (str_cat.str-cat
        (compiler-backend-runtime-fast-alloc-functions
          (CompilerBackendTarget.Linux)
          "%rdi"
          "%rcx"
          profile)
        "    .globl tl_alloc
tl_alloc:
    addq $7, %rdi
    jc .L_tl_alloc_abort
    andq $-8, %rdi
    movq %rdi, %rsi
    movq %fs:tl_current_arena@tpoff, %r8
    testq %r8, %r8
    jz .L_tl_alloc_new_arena
    movq 40(%r8), %r9
    testq $1, 48(%r9)
    jnz .L_tl_alloc_atomic
    movq 16(%r8), %rcx
    movq %rcx, %rax
    addq %rsi, %rcx
    jc .L_tl_alloc_abort
    cmpq 24(%r8), %rcx
    ja .L_tl_alloc_new_arena
    movq %rcx, 16(%r8)
"
        "")]
    [atomic-fast-asm : String
      "    ret
.L_tl_alloc_atomic:
    movq 56(%r9), %r8
    movq 16(%r8), %rax
.L_tl_alloc_atomic_cas:
    movq %rax, %rcx
    addq %rsi, %rcx
    jc .L_tl_alloc_abort
    cmpq 24(%r8), %rcx
    ja .L_tl_alloc_atomic_new_arena
    lock cmpxchgq %rcx, 16(%r8)
    jne .L_tl_alloc_atomic_cas
"]
    [atomic-lock-asm : String
      "    ret
.L_tl_alloc_atomic_new_arena:
    movq $1, %rax
    movq $3, %rcx
    lock cmpxchgq %rcx, 48(%r9)
    je .L_tl_alloc_atomic_locked
    pause
    jmp .L_tl_alloc_atomic_new_arena
.L_tl_alloc_atomic_locked:
    movq 56(%r9), %r8
    movq 16(%r8), %rax
.L_tl_alloc_atomic_locked_cas:
    movq %rax, %rcx
    addq %rsi, %rcx
    jc .L_tl_alloc_atomic_abort_locked
    cmpq 24(%r8), %rcx
    ja .L_tl_alloc_atomic_map
    lock cmpxchgq %rcx, 16(%r8)
    jne .L_tl_alloc_atomic_locked_cas
    movq $1, 48(%r9)
"]
    [atomic-map-asm : String
      "    ret
.L_tl_alloc_atomic_abort_locked:
    movq $1, 48(%r9)
    jmp .L_tl_alloc_abort
.L_tl_alloc_atomic_map:
    movq $0x4000000, %rdx
    movq %rsi, %rcx
    addq $64, %rcx
    jc .L_tl_alloc_abort
    cmpq %rdx, %rcx
    jbe .L_tl_alloc_atomic_len_ready
    movq %rcx, %rdx
.L_tl_alloc_atomic_len_ready:
    push %r9
    push %rdx
    push %rsi
    movq %rdx, %rsi
    xorq %rdi, %rdi
    movq $3, %rdx
    movq $0x22, %r10
    movq $-1, %r8
    xorq %r9, %r9
    movq $9, %rax
    syscall
    pop %rsi
    pop %rdx
    pop %r9
    testq %rax, %rax
    js .L_tl_alloc_abort
    movq %rax, %rcx
    addq %rdx, %rcx
    jc .L_tl_alloc_abort
    movq 56(%r9), %r8
    movq %r8, 0(%rax)
    movq $0, 32(%rax)
    movq %r9, 40(%rax)
    movq $1, 48(%rax)
    movq $0, 56(%rax)
    leaq 64(%rax), %r8
    movq %r8, 8(%rax)
    movq %rcx, 24(%rax)
    movq %r8, %rcx
    addq %rsi, %rcx
    movq %rcx, 16(%rax)
    movq %rax, 56(%r9)
    movq %rax, %fs:tl_current_arena@tpoff
    movq $1, 48(%r9)
    movq %r8, %rax
"]
    [ordinary-new-asm : String
      "    ret
.L_tl_alloc_new_arena:
    movq $0x4000000, %rdx
    movq %rsi, %rcx
    addq $64, %rcx
    jc .L_tl_alloc_abort
    cmpq %rdx, %rcx
    jbe .L_tl_alloc_len_ready
    movq %rcx, %rdx
.L_tl_alloc_len_ready:
    push %rdx
    push %rsi
    movq %rdx, %rsi
    xorq %rdi, %rdi
    movq $3, %rdx
    movq $0x22, %r10
    movq $-1, %r8
    xorq %r9, %r9
    movq $9, %rax
    syscall
    pop %rsi
    pop %rdx
    testq %rax, %rax
    js .L_tl_alloc_abort
    movq %rax, %rcx
    addq %rdx, %rcx
    jc .L_tl_alloc_abort
    movq %fs:tl_current_arena@tpoff, %r8
    movq %r8, 0(%rax)
    movq $0, 32(%rax)
    testq %r8, %r8
    jz .L_tl_alloc_root_self
    movq 40(%r8), %r10
    jmp .L_tl_alloc_root_ready
.L_tl_alloc_root_self:
    movq %rax, %r10
.L_tl_alloc_root_ready:
    movq %r10, 40(%rax)
    movq $0, 48(%rax)
    movq %rax, 56(%r10)
    movq %rax, 56(%rax)
    leaq 64(%rax), %r8
    movq %r8, 8(%rax)
    movq %rcx, 24(%rax)
    movq %r8, %rcx
    addq %rsi, %rcx
    movq %rcx, 16(%rax)
    movq %rax, %fs:tl_current_arena@tpoff
    movq %r8, %rax
"]
    [tail-asm : String "    ret
.L_tl_alloc_abort:
    jmp tl_oom_abort

"]
    (str_cat.str-cat
      prefix
      fast-profile
      atomic-fast-asm
      atomic-fast-profile
      atomic-lock-asm
      atomic-locked-profile
      atomic-map-asm
      atomic-new-profile
      ordinary-new-asm
      new-profile
      tail-asm)))

(define (compiler-backend-runtime-region-mark-functions
  [target : CompilerBackendTarget]) : String
  (string.append
    "    .globl tl_region_mark
tl_region_mark:
"
    (string.append
      (compiler-backend-current-arena-load target "%rax")
      "    testq %rax, %rax
    jz .L_tl_region_mark_zero
.L_tl_region_mark_current:
    movq 40(%rax), %r8
    testq $1, 48(%r8)
    jz .L_tl_region_mark_read
    movq 56(%r8), %rax
.L_tl_region_mark_read:
    movq 16(%rax), %rax
    ret
.L_tl_region_mark_zero:
    xorq %rax, %rax
    ret

")))

;; Freestanding Linux runtime support. Most stdlib OS calls are raw
;; `syscall`s in TypeLisp bodies (tl/fs.tl/env.tl/runtime.tl). The
;; allocator/arena page calls are the deliberate backend-core exception.
;; The `strlen`/`getenv`/`fflush` shims and private errno accessor live in
;; TypeLisp stdlib code, so the final link needs no `-lc` and no
;; dynamic loader.
(define (compiler-backend-runtime-linux-libc-shim-functions) : String
  "")

;; Windows freestanding runtime support (kernel32-only). Like the Linux side,
;; most OS-calling primitives live in TypeLisp (tl/fs.tl/env.tl/
;; runtime.tl via direct kernel32 bindings). The allocator/arena VirtualAlloc/
;; VirtualFree page calls are the deliberate backend-core exception, and
;; this block retains the other genuinely backend-level pieces: `__chkstk`
;; (required by the MSVC ABI for large stack frames), and the program entry
;; (`tl_setup_argv` builds argv from
;; GetCommandLineA, `_tl_start` is the entry thunk). There are no `_errno`,
