    jz .L_tl_arena_make_atomic_win_reserve_os_fail
    movq %rax, %rbx
    movq %rbx, %rcx
    movq $0x400000, %rdx
    movq $0x1000, %r8
    movq $0x4, %r9
    call VirtualAlloc
    testq %rax, %rax
    jz .L_tl_arena_make_atomic_win_initial_commit_os_fail
    movq $0, 0(%rbx)
    movq $0, 32(%rbx)
    movq %rbx, 40(%rbx)
    movq $1, 48(%rbx)
