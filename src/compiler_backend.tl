;; The Linux out-of-bounds/division/shift abort handlers live in the runtime
;; prelude (stdlib/runtime.tl as `*-abort`, exported as the fixed
;; `tl_*_abort` symbols); the backend does not emit them as asm.
;; `tl_abort_string` (the general panic handler) lives in the runtime prelude
;; (stdlib/runtime.tl as `abort-string`); the backend does not emit
;; it as asm on either target.
(define (compiler-backend-runtime-abort-functions) : String
  "")

;; Environment lookups moved entirely into TypeLisp (stdlib/env.tl): the Linux
;; side walks the SysV stack-captured environment via the program-argv/argc
;; builtins, and the Windows side calls kernel32 GetEnvironmentStringsA directly,
;; with the name match and value copy done in TypeLisp. The backend therefore
;; emits no `tl_env_var_exists` / `tl_env_var_value` / `_tl_env_path_separator`
;; asm on either target (these were the last consumers of the removed `getenv`
;; and `strlen` libc shims). The generators are retained as empty strings so the
;; runtime-plan gating (which still tracks the now-never-set env call sites) does
;; not need a struct change.
(define (compiler-backend-runtime-env-var-exists-functions) : String
  "")

(define (compiler-backend-runtime-env-var-value-functions) : String
  "")

(define (compiler-backend-runtime-env-path-separator-functions) : String
  "")

(define (compiler-backend-runtime-windows-env-path-separator-functions) : String
  "")

(define (compiler-backend-runtime-windows-env-var-exists-functions) : String
  "")

(define (compiler-backend-runtime-windows-env-var-value-functions) : String
  "")

;; Windows variant of `tl_region_reset`. Identical arena-walk structure to the
;; Linux helper (offsets: 0=prev arena, 8=usable base, 16=bump pointer, 24=end,
;; 32=retired list link/head, 40=root, 48=kind/lock, 56=root-current; the arena header sits at the VirtualAlloc
;; base). Nonzero reset retires newer chunks; reset-all releases chunks with
;; `VirtualFree(lpAddress=arena, dwSize=0, dwFreeType=MEM_RELEASE=0x8000)` ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â the
;; arena node address is exactly the VirtualAlloc base, so MEM_RELEASE frees the
;; whole chunk. Arg (the mark) arrives in %rcx.
(define (compiler-backend-runtime-windows-region-reset-functions
  [profile : bool]) : String
  (string.append
    "    .globl tl_region_reset
tl_region_reset:
    push %rbp
    mov %rsp, %rbp
    push %rbx
    push %r12
    push %r13
    push %r14
    movq %rcx, %r12
    testq %r12, %r12
    jz .L_tl_region_reset_win_all
    movq %gs:0x28, %r13
    testq %r13, %r13
    jz .L_tl_region_reset_win_invalid
    movq 40(%r13), %r11
    testq $1, 48(%r11)
    jz .L_tl_region_reset_win_find
    movq 56(%r11), %r13
.L_tl_region_reset_win_find:
    movq 8(%r13), %rax
    cmpq %rax, %r12
    jb .L_tl_region_reset_win_next
    movq 24(%r13), %rax
    cmpq %rax, %r12
    jbe .L_tl_region_reset_win_found
.L_tl_region_reset_win_next:
    movq 0(%r13), %r13
    testq %r13, %r13
    jnz .L_tl_region_reset_win_find
    jmp .L_tl_region_reset_win_invalid
.L_tl_region_reset_win_invalid:
    sub $32, %rsp
    call tl_region_abort
.L_tl_region_reset_win_found:
    movq 40(%r13), %r11
    movq %gs:0x28, %r14
.L_tl_region_reset_win_drop:
    cmpq %r13, %r14
    je .L_tl_region_reset_win_restore
    movq 0(%r14), %rbx
"
    (string.append
      (compiler-backend-runtime-profile-live-sub "%r14" "%rax" profile)
      (string.append
        "    movq 32(%r11), %rax
    movq %rax, 32(%r14)
    movq $0, 0(%r14)
    movq %r14, 32(%r11)
    movq %rbx, %r14
    jmp .L_tl_region_reset_win_drop
.L_tl_region_reset_win_restore:
"
        (string.append
          (compiler-backend-runtime-profile-live-rewind
            "%r13"
            "%r12"
            "%rax"
            profile)
          (string.append
            "    movq %r12, 16(%r13)
    movq %r13, 56(%r11)
    movq %r13, %gs:0x28
    jmp .L_tl_region_reset_win_done
.L_tl_region_reset_win_all:
    movq %gs:0x28, %r14
    movq $0, %gs:0x28
    xorq %r12, %r12
    testq %r14, %r14
    jz .L_tl_region_reset_win_done
    movq 40(%r14), %r12
    testq %r12, %r12
    jz .L_tl_region_reset_win_all_drop
    movq 56(%r12), %r14
    testq %r14, %r14
    jnz .L_tl_region_reset_win_all_head_ready
    movq %r12, %r14
.L_tl_region_reset_win_all_head_ready:
.L_tl_region_reset_win_all_retired_ready:
    movq 32(%r12), %r12
.L_tl_region_reset_win_all_drop:
    testq %r14, %r14
    jz .L_tl_region_reset_win_all_retired
    movq 0(%r14), %rbx
"
            (string.append
              (compiler-backend-runtime-profile-live-sub "%r14" "%rax" profile)
              "    movq %r14, %rcx
    xorq %rdx, %rdx
    movq $0x8000, %r8
    sub $32, %rsp
    call VirtualFree
    add $32, %rsp
    movq %rbx, %r14
    jmp .L_tl_region_reset_win_all_drop
.L_tl_region_reset_win_all_retired:
    movq %r12, %r14
.L_tl_region_reset_win_all_retired_drop:
    testq %r14, %r14
    jz .L_tl_region_reset_win_done
    movq 32(%r14), %rbx
    movq %r14, %rcx
    xorq %rdx, %rdx
    movq $0x8000, %r8
    sub $32, %rsp
    call VirtualFree
    add $32, %rsp
    movq %rbx, %r14
    jmp .L_tl_region_reset_win_all_retired_drop
.L_tl_region_reset_win_done:
    pop %r14
    pop %r13
    pop %r12
    pop %rbx
    pop %rbp
    ret

")))))))

(define (compiler-backend-runtime-windows-thread-functions) : String
  "    .data
    .globl tl_thread_entry_ptr
    .balign 8
tl_thread_entry_ptr:
    .quad .L_tl_thread_entry

    .text
.L_tl_thread_entry:
    pushq %r12
    pushq %r13
    subq $40, %rsp
    movq $0, %gs:0x28
    movq (%rcx), %r11
    movq 8(%rcx), %rdx
    movq 16(%rcx), %r12
    movq 24(%rcx), %r13
    movl $1, (%r13)
    movq 8(%r11), %rcx
    call *(%r11)
    movq %rax, (%r12)
    addq $40, %rsp
    popq %r13
    popq %r12
    ret

")

(define (compiler-backend-runtime-profile-functions) : String
  "    .globl tl_profile_alloc_total
tl_profile_alloc_total:
    movq tl_profile_alloc_total_bytes(%rip), %rax
    ret

    .globl tl_profile_alloc_live
tl_profile_alloc_live:
    movq tl_profile_alloc_live_bytes(%rip), %rax
    ret

    .globl tl_profile_alloc_peak
tl_profile_alloc_peak:
    movq tl_profile_alloc_peak_bytes(%rip), %rax
    ret

    .globl tl_profile_alloc_reset_peak
tl_profile_alloc_reset_peak:
    movq tl_profile_alloc_live_bytes(%rip), %rax
    movq %rax, tl_profile_alloc_peak_bytes(%rip)
    xorq %rax, %rax
    ret

")

(define (compiler-backend-runtime-profile-functions-for-target
  [target : CompilerBackendTarget]
  [profile : bool]) : String
  (let
    [_target : CompilerBackendTarget target]
    (if profile
      (compiler-backend-runtime-profile-functions)
      "")))

(define (compiler-backend-runtime-fs-functions) : String
  "")

(define (compiler-backend-runtime-windows-fs-functions) : String
  "")

(define (compiler-backend-runtime-fs-functions-for-target
  [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    (compiler-backend-runtime-windows-fs-functions)
    (compiler-backend-runtime-fs-functions)))

;; The Windows out-of-bounds/division/shift abort handlers (and their shared
;; fixed-abort emitter) live in the runtime prelude (stdlib/runtime.tl),
;; exported as the fixed `tl_*_abort` symbols; the backend emits no
;; asm for them.
;; `tl_abort_string` lives in the runtime prelude (see
;; `compiler-backend-runtime-abort-functions`); the Windows target emits no asm
;; for it either.
(define (compiler-backend-runtime-windows-abort-functions) : String
  "")

(define (compiler-backend-runtime-int-to-string-functions) : String
  "")

(define (compiler-backend-runtime-windows-int-to-string-functions) : String
  "")

(define (compiler-backend-runtime-substring-functions) : String
  "")

(define (compiler-backend-runtime-windows-substring-functions) : String
  "")

(define (compiler-backend-runtime-str-view-functions) : String
  "")

(define (compiler-backend-runtime-windows-str-view-functions) : String
  "")

(define (compiler-backend-runtime-concat-functions) : String
  "")

(define (compiler-backend-runtime-windows-concat-functions) : String
  "")

;; Byte copy helper used by lower-emit-memcpy for large by-value aggregate
;; copies. Always emitted. Linux SysV args rdi=dst, rsi=src, rdx=len; rep movsb
;; consumes rdi/rsi/rcx (all caller-saved). Windows x64 args rcx=dst, rdx=src,
;; r8=len; rdi/rsi are NONvolatile there, so save/restore them around the copy.
;;
;; Memmove semantics. The lowerer threads by-value aggregates through
;; sret buffers and back into operands they may alias (e.g. a cache value
;; rebuilt from itself across a recursion), so dst can overlap src from above;
;; a forward rep movsb then reads bytes it already overwrote and corrupts the
;; value. Copy backward (std) for the overlapping dst>src case; DF is restored
;; before returning per the ABI.
;;
;; On Win64 the dominant calls copy 88-120 B by-value compiler aggregates.
;; Copy those medium ranges in unrolled 64/32/16 B baseline-SSE2 blocks; this
;; avoids the host's fast-string setup. Both directions use the same chunking so
;; overlapping dst>src copies stay memmove-safe. Linux retains rep movsq: its
;; deterministic instruction-count gate favors the microcoded qword loop.
(define (compiler-backend-runtime-memcpy-functions
  [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    "    .globl tl_memcpy
tl_memcpy:
    cmpq $1, %r8
    jne .Ltl_memcpy_setup
    movzbl (%rdx), %eax
    movb %al, (%rcx)
    ret
.Ltl_memcpy_setup:
    movq %rdi, %rax
    movq %rsi, %r10
    movq %rcx, %rdi
    movq %rdx, %rsi
    movq %r8, %rcx
    cmpq %rsi, %rdi
    jbe .Ltl_memcpy_fwd
    movq %rsi, %r9
    addq %rcx, %r9
    cmpq %r9, %rdi
    jae .Ltl_memcpy_fwd
.Ltl_memcpy_bwd_64:
    cmpq $64, %rcx
    jb .Ltl_memcpy_bwd_32
    subq $64, %rcx
    movups (%rsi,%rcx), %xmm0
    movups 16(%rsi,%rcx), %xmm1
    movups 32(%rsi,%rcx), %xmm2
    movups 48(%rsi,%rcx), %xmm3
    movups %xmm0, (%rdi,%rcx)
    movups %xmm1, 16(%rdi,%rcx)
    movups %xmm2, 32(%rdi,%rcx)
    movups %xmm3, 48(%rdi,%rcx)
    jmp .Ltl_memcpy_bwd_64
.Ltl_memcpy_bwd_32:
    cmpq $32, %rcx
    jb .Ltl_memcpy_bwd_16
    subq $32, %rcx
    movups (%rsi,%rcx), %xmm0
    movups 16(%rsi,%rcx), %xmm1
    movups %xmm0, (%rdi,%rcx)
    movups %xmm1, 16(%rdi,%rcx)
.Ltl_memcpy_bwd_16:
    cmpq $16, %rcx
    jb .Ltl_memcpy_bwd_tail
    subq $16, %rcx
    movups (%rsi,%rcx), %xmm0
    movups %xmm0, (%rdi,%rcx)
.Ltl_memcpy_bwd_tail:
    testq %rcx, %rcx
    je .Ltl_memcpy_done
    leaq -1(%rdi,%rcx), %rdi
    leaq -1(%rsi,%rcx), %rsi
    std
    rep movsb
    cld
.Ltl_memcpy_done:
    movq %rax, %rdi
    movq %r10, %rsi
    ret
.Ltl_memcpy_fwd:
.Ltl_memcpy_fwd_64:
    cmpq $64, %rcx
    jb .Ltl_memcpy_fwd_32
    movups (%rsi), %xmm0
    movups 16(%rsi), %xmm1
    movups 32(%rsi), %xmm2
    movups 48(%rsi), %xmm3
    movups %xmm0, (%rdi)
    movups %xmm1, 16(%rdi)
    movups %xmm2, 32(%rdi)
    movups %xmm3, 48(%rdi)
    addq $64, %rsi
    addq $64, %rdi
    subq $64, %rcx
    jmp .Ltl_memcpy_fwd_64
.Ltl_memcpy_fwd_32:
    cmpq $32, %rcx
    jb .Ltl_memcpy_fwd_16
    movups (%rsi), %xmm0
    movups 16(%rsi), %xmm1
    movups %xmm0, (%rdi)
    movups %xmm1, 16(%rdi)
    addq $32, %rsi
    addq $32, %rdi
    subq $32, %rcx
.Ltl_memcpy_fwd_16:
    cmpq $16, %rcx
    jb .Ltl_memcpy_fwd_tail
    movups (%rsi), %xmm0
    movups %xmm0, (%rdi)
    addq $16, %rsi
    addq $16, %rdi
    subq $16, %rcx
.Ltl_memcpy_fwd_tail:
    rep movsb
    movq %rax, %rdi
    movq %r10, %rsi
    ret
"
    "    .globl tl_memcpy
tl_memcpy:
    movq %rdx, %rcx
    cmpq %rsi, %rdi
    jbe .Ltl_memcpy_fwd
    movq %rsi, %rax
    addq %rcx, %rax
    cmpq %rax, %rdi
    jae .Ltl_memcpy_fwd
    leaq -1(%rdi,%rcx), %rdi
    leaq -1(%rsi,%rcx), %rsi
    std
    rep movsb
    cld
    ret
.Ltl_memcpy_fwd:
    movq %rcx, %r11
    shrq $3, %rcx
    rep movsq
    movq %r11, %rcx
    andq $7, %rcx
    rep movsb
    ret
"))

;; Byte-search helper used by borrowed string/bytes scanners. Always
;; emitted alongside tl_memcpy. Linux SysV args rdi=ptr, rsi=len, dl=byte.
;; Windows x64 args rcx=ptr, rdx=len, r8b=byte. Return the zero-based offset in
;; rax or -1 when absent. All clobbered registers are caller-saved on both ABIs.
(define (compiler-backend-runtime-memchr-functions
  [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    "    .globl tl_memchr
tl_memchr:
    testq %rdx, %rdx
    jle .Ltl_memchr_not_found
    movzbl %r8b, %r8d
    xorq %rax, %rax
.Ltl_memchr_loop:
    cmpb %r8b, (%rcx,%rax)
    je .Ltl_memchr_found
    incq %rax
    cmpq %rdx, %rax
    jl .Ltl_memchr_loop
.Ltl_memchr_not_found:
    movq $-1, %rax
.Ltl_memchr_found:
    ret
"
    "    .globl tl_memchr
tl_memchr:
    testq %rsi, %rsi
    jle .Ltl_memchr_not_found
    movzbl %dl, %edx
    xorq %rax, %rax
.Ltl_memchr_loop:
    cmpb %dl, (%rdi,%rax)
    je .Ltl_memchr_found
    incq %rax
    cmpq %rsi, %rax
    jl .Ltl_memchr_loop
.Ltl_memchr_not_found:
    movq $-1, %rax
.Ltl_memchr_found:
    ret
"))

(define (compiler-backend-runtime-tlci-entry-functions
  [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    "    .globl tl_tlci_call_image_entry
tl_tlci_call_image_entry:
    movq %rcx, %rax
    movq %rdx, %rcx
    movq %r8, %rdx
    subq $40, %rsp
    call *%rax
    addq $40, %rsp
    ret

"
    "    .globl tl_tlci_call_image_entry
tl_tlci_call_image_entry:
    movq %rdi, %rax
    movq %rsi, %rdi
    movq %rdx, %rsi
    subq $8, %rsp
    call *%rax
    addq $8, %rsp
    ret

"))

(define (compiler-backend-runtime-tlci-macro-entry-functions
  [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    "    .globl tl_tlci_call_macro_entry
tl_tlci_call_macro_entry:
    movq %rcx, %rax
    movq %rdx, %rcx
    movq %r8, %rdx
    movq %r9, %r8
    movq 40(%rsp), %r9
    movq 48(%rsp), %r10
    movq 56(%rsp), %r11
    subq $56, %rsp
    movq %r10, 32(%rsp)
    movq %r11, 40(%rsp)
    call *%rax
    addq $56, %rsp
    ret

"
    "    .globl tl_tlci_call_macro_entry
tl_tlci_call_macro_entry:
    movq %rdi, %rax
    movq %rsi, %rdi
    movq %rdx, %rsi
    movq %rcx, %rdx
    movq %r8, %rcx
    movq %r9, %r8
    movq 8(%rsp), %r9
    subq $8, %rsp
    call *%rax
    addq $8, %rsp
    ret

"))

(define (compiler-backend-runtime-atomic-functions
  [_target : CompilerBackendTarget]) : String
  "")

(define (compiler-backend-runtime-linux-only
  [target : CompilerBackendTarget]
  [enabled : bool]
  [asm : String]) : String
  (if enabled
    (if (compiler-backend-target-windows? target)
      ""
      asm)
    ""))

(define (compiler-backend-runtime-functions-for-target
  [target : CompilerBackendTarget]
  [plan : CompilerBackendRuntimePlan]) : String
  (match plan
    [(CompilerBackendRuntimePlan.WithScratch base _)
      (compiler-backend-runtime-functions-for-target target (box-get base))]
    [(CompilerBackendRuntimePlan.Plan
        alloc
        oob
        substring
        str-view
        concat
        _
        _
        int-to-string
        abort
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        _
        fs-runtime
        _
        _
        _
        _
        _
        region-mark
        region-reset
        _
        env-var-exists
        var-value
        path-separator
        div-abort
        shift-abort
        tail-plan)
      (let
        [profile : bool (compiler-backend-runtime-tail-profile? tail-plan)]
        [alloc-asm : String
          (if alloc
            (if (compiler-backend-target-windows? target)
              (compiler-backend-runtime-windows-alloc-functions profile)
              (compiler-backend-runtime-linux-alloc-functions profile))
            "")]
        ;; The out-of-bounds/division/shift fault handlers live in the
        ;; runtime prelude (stdlib/runtime.tl); the backend
        ;; emits no asm for them. The plan flags are retained for the runtime
        ;; index (which still tracks the `tl_*_abort` call sites).
        [oob-asm : String
          (if oob
            ""
            "")]
        [div-abort-asm : String
          (if div-abort
            ""
            "")]
        [shift-abort-asm : String
          (if shift-abort
            ""
            "")]
        [substring-asm : String
          (if substring
            (if (compiler-backend-target-windows? target)
              (compiler-backend-runtime-windows-substring-functions)
              (compiler-backend-runtime-substring-functions))
            "")]
        [str-view-asm : String
          (if str-view
            (if (compiler-backend-target-windows? target)
              (compiler-backend-runtime-windows-str-view-functions)
              (compiler-backend-runtime-str-view-functions))
            "")]
        [concat-asm : String
          (if concat
            (if (compiler-backend-target-windows? target)
              (compiler-backend-runtime-windows-concat-functions)
              (compiler-backend-runtime-concat-functions))
            "")]
        [int-to-string-asm : String
          (if int-to-string
            (if (compiler-backend-target-windows? target)
              (compiler-backend-runtime-windows-int-to-string-functions)
              (compiler-backend-runtime-int-to-string-functions))
            "")]
        [abort-asm : String
          (if abort
            (if (compiler-backend-target-windows? target)
              (compiler-backend-runtime-windows-abort-functions)
              (compiler-backend-runtime-abort-functions))
            "")]
        [fs-asm : String
          (if fs-runtime
            (compiler-backend-runtime-fs-functions-for-target target)
            "")]
        [region-mark-asm : String
          (if region-mark
            (compiler-backend-runtime-region-mark-functions target)
            "")]
        [region-reset-asm : String
          (if region-reset
            (if (compiler-backend-target-windows? target)
              (compiler-backend-runtime-windows-region-reset-functions profile)
              (compiler-backend-runtime-region-reset-functions profile))
            "")]
        [arena-asm : String
          (if (compiler-backend-target-windows? target)
            (compiler-backend-runtime-windows-arena-functions profile)
            (compiler-backend-runtime-linux-arena-functions profile))]
        [profile-asm : String
          (compiler-backend-runtime-profile-functions-for-target target profile)]
        [memcpy-asm : String (compiler-backend-runtime-memcpy-functions target)]
        [memchr-asm : String (compiler-backend-runtime-memchr-functions target)]
        [tlci-entry-asm : String
          (compiler-backend-runtime-tlci-entry-functions target)]
        [tlci-macro-entry-asm : String
          (if (compiler-backend-runtime-tail-tlci-macro-entry? tail-plan)
            (compiler-backend-runtime-tlci-macro-entry-functions target)
            "")]
        [atomic-asm : String (compiler-backend-runtime-atomic-functions target)]
        [runtime-front-asm : String
          (string.append
            memcpy-asm
            (string.append
              memchr-asm
              (string.append
                tlci-entry-asm
                (string.append
                  tlci-macro-entry-asm
                  (string.append
                    atomic-asm
                    (string.append
                      arena-asm
                      (string.append
                        profile-asm
                        (str_cat.str-cat
                          alloc-asm
                          region-mark-asm
                          region-reset-asm
                          oob-asm
                          div-abort-asm))))))))]
        [runtime-string-asm : String
          (string.append
            (str_cat.str-cat
              shift-abort-asm
              substring-asm
              str-view-asm
              concat-asm
              "")
            (string.append int-to-string-asm abort-asm))]
        [env-var-exists-asm : String
          (if env-var-exists
            (if (compiler-backend-target-windows? target)
              (compiler-backend-runtime-windows-env-var-exists-functions)
              (compiler-backend-runtime-env-var-exists-functions))
            "")]
        [env-var-value-asm : String
          (if var-value
            (if (compiler-backend-target-windows? target)
              (compiler-backend-runtime-windows-env-var-value-functions)
              (compiler-backend-runtime-env-var-value-functions))
            "")]
        [env-path-separator-asm : String
          (if path-separator
            (if (compiler-backend-target-windows? target)
              (compiler-backend-runtime-windows-env-path-separator-functions)
              (compiler-backend-runtime-env-path-separator-functions))
            "")]
        [linux-libc-shims-asm : String
          (if (compiler-backend-target-windows? target)
            (compiler-backend-runtime-windows-libc-shim-functions)
            (compiler-backend-runtime-linux-libc-shim-functions))]
        [thread-asm : String
          (if (compiler-backend-target-windows? target)
            (compiler-backend-runtime-windows-thread-functions)
            "")]
        (str_cat.str-cat
          runtime-front-asm
          runtime-string-asm
          fs-asm
          thread-asm
          env-var-exists-asm
          env-var-value-asm
          env-path-separator-asm
          linux-libc-shims-asm
          ""))]))

;; Argument register for call arg `idx` under the target's calling convention.
;; System V (Linux) uses rdi/rsi/rdx/rcx/r8/r9 via `compiler-backend-arg-reg`;
;; Windows x64 passes the first four integer/pointer args in rcx/rdx/r8/r9.
(define (compiler-backend-target-arg-reg
  [target : CompilerBackendTarget]
  [idx : i64]) : ResultBackendReg
  (compiler-backend-result-reg
    (compiler-abi-gp-arg-register (compiler-backend-target-abi target) idx)
    "backend: too many call args"))

(define (compiler-backend-target-float-arg-reg
  [target : CompilerBackendTarget]
  [idx : i64]) : ResultBackendReg
  (compiler-backend-result-reg
    (compiler-abi-float-arg-register (compiler-backend-target-abi target) idx)
    "backend: too many call args"))

(define (compiler-backend-call-bank-index
  [target : CompilerBackendTarget]
  [bank-idx : i64]
  [position : i64]) : i64
  (if (compiler-abi-arg-banks-independent? (compiler-backend-target-abi target))
    bank-idx
    position))

(define (compiler-backend-target-arg-reg-for-banks
  [target : CompilerBackendTarget]
  [int-idx : i64]
  [position : i64]) : ResultBackendReg
  (compiler-backend-target-arg-reg
    target
    (compiler-backend-call-bank-index target int-idx position)))

(define (compiler-backend-target-float-arg-reg-for-banks
  [target : CompilerBackendTarget]
  [float-idx : i64]
  [position : i64]) : ResultBackendReg
  (compiler-backend-target-float-arg-reg
    target
    (compiler-backend-call-bank-index target float-idx position)))

;; Caller-reserved outgoing shadow space in bytes: none on System V, 32 on
;; Windows x64.
(define (compiler-backend-outgoing-shadow-space
  [target : CompilerBackendTarget]) : i64
  (compiler-abi-outgoing-shadow-space (compiler-backend-target-abi target)))

;; Program entry section and global symbol. Freestanding Linux links the
;; backend-owned `_tl_start`; CRT entry mode links `main` through the C runtime.
;; Windows links `main` through the CRT.
(define (compiler-backend-target-linux? [target : CompilerBackendTarget]) : bool
  (compiler-abi-linux? (compiler-backend-target-abi target)))

(define (compiler-backend-target-entry-text-with-crt
  [target : CompilerBackendTarget]
  [emit-entry : bool]
  [crt-entry : bool]) : String
  (if emit-entry
    (match target
      [(CompilerBackendTarget.Linux)
        (if crt-entry
          ".text\n.globl main\n"
          ".text\n.globl _tl_start\n")]
      [(CompilerBackendTarget.Windows) ".text\n.globl main\n"])
    ".text\n"))

(define (compiler-backend-target-entry-text
  [target : CompilerBackendTarget]
  [emit-entry : bool]) : String
  (compiler-backend-target-entry-text-with-crt target emit-entry false))

;; Run main on a fresh 1 GiB mmap'd stack, then exit(main()). The compiler
;; recurses far deeper than the default 8 MiB stack rlimit allows ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â type-directed
;; `clone` of large IR values during arena escapes is the worst case ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â so
;; a self-hosted compiler segfaults compiling a large program on the default
;; stack. argc/argv/envp are already captured into globals before this runs, so
;; switching %rsp is safe (main reads them from globals, not the stack). A failed
;; mmap (negative result) keeps the original stack; the unmapped page below the
;; region turns any overflow into a clean SIGSEGV rather than silent corruption.
(define (compiler-backend-entry-call-main) : String
  "    movq $0x40000000, %rsi
    xorq %rdi, %rdi
    movq $3, %rdx
    movq $0x22, %r10
    movq $-1, %r8
    xorq %r9, %r9
    movq $9, %rax
    syscall
    testq %rax, %rax
    js .L_tl_main_keep_stack
    addq $0x40000000, %rax
    andq $-16, %rax
    movq %rax, %rsp
.L_tl_main_keep_stack:
    call main
    movq %rax, %rdi
    movq $60, %rax
    syscall
")

(define (compiler-backend-entry
  [capture-argv : bool]
  [capture-env : bool]
  [global-inits : String]) : String
  (if (or capture-argv capture-env)
    (str_cat.str-cat
      "_tl_start:
    movq (%rsp), %rax
"
      (if capture-argv
        "    movq %rax, .L_tl_argc(%rip)
    leaq 8(%rsp), %rax
    movq %rax, .L_tl_argv(%rip)
"
        "")
      (if capture-env
        (str_cat.str-cat
          (if capture-argv
            "    movq (%rsp), %rax\n"
            "")
          "    leaq 16(%rsp,%rax,8), %rax
    movq %rax, .L_tl_envp(%rip)
")
        "")
      "    call tl_thread_init\n"
      global-inits
      (compiler-backend-entry-call-main))
    (str_cat.str-cat
      "_tl_start:\n"
      "    call tl_thread_init\n"
      global-inits
      (compiler-backend-entry-call-main))))

(define (compiler-backend-entry-for-target-with-crt
  [target : CompilerBackendTarget]
  [plan : CompilerBackendRuntimePlan]
  [globals : CompilerIrGlobalList]
  [crt-entry : bool]
  [program-index : CompilerBackendProgramIndex]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (if crt-entry
        ""
        (let
          [_ : CompilerBackendRuntimePlan plan]
          (compiler-backend-entry
            true
            true
            (compiler-backend-global-initializers globals program-index))))]
    [(CompilerBackendTarget.Windows) ""]))

(define (compiler-backend-target-windows? [target : CompilerBackendTarget]) : bool
  (compiler-abi-windows? (compiler-backend-target-abi target)))

;; All runtime helpers the backend can be asked to emit now have a Windows
;; variant (region mark/reset and the env-var/env-path helpers were the last
;; Windows-unsupported ones; see the *-windows-* runtime functions above), so no
;; plan is rejected on either target. The `plan` parameter is retained for the
;; signature shape and possible future target-specific gating.
(define (compiler-backend-target-runtime-ok?
  [target : CompilerBackendTarget]
  [plan : CompilerBackendRuntimePlan]) : bool
  (let
    [_ : CompilerBackendTarget target]
    [_plan : CompilerBackendRuntimePlan plan]
    true))

(define (compiler-backend-runtime-externs-for-target
  [target : CompilerBackendTarget]
  [plan : CompilerBackendRuntimePlan]) : String
  (if (compiler-backend-target-windows? target)
    (let
      [needs-write-exit : bool
        (or
          (compiler-backend-plan-provides? plan "tl_alloc")
          (compiler-backend-plan-provides? plan "tl_oob_abort")
          (compiler-backend-plan-provides? plan ".L_tl_abort")
          (compiler-backend-plan-provides? plan "tl_div_abort")
          (compiler-backend-plan-provides? plan "tl_shift_abort")
          (compiler-backend-plan-provides? plan "tl_region_reset"))]
      [needs-get-std-handle : bool needs-write-exit]
      (str_cat.str-cat
        "    .extern VirtualAlloc
    .extern VirtualFree
    .extern GetLastError
    .extern ExitProcess
"
        (if needs-write-exit
          "    .extern WriteFile
"
          "")
        (if needs-get-std-handle
          "    .extern GetStdHandle
"
          "")
        (if (compiler-backend-plan-provides? plan "tl_print_f64")
          "    .extern _snprintf
"
          "")))
    ""))

;; Emit a full program for `target`. Windows x64 has ABI-correct user function
;; entry/calls and target-specific runtime helpers.
;; Backend entry points come in two flavors: the original
;;
;; program-only variants (kept for existing call sites and smoke tests) supply
;;
;; an empty provenance table, so backend diagnostics fall back to `path:1:1`;
;;
;; the `-with-spans` variants thread the lowering provenance side table so
;;
;; backend errors report the offending function's real source location.
(define (compiler-backend-emit-program-for-target
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (compiler-backend-emit-program-target
    program
    target
    (compiler-source-spans-empty)
    true))

(define (compiler-backend-emit-program-linux [program : CompilerIrProgram]) : ResultCompilerBackend
  (compiler-backend-emit-program-for-target
    program
    (CompilerBackendTarget.Linux)))

(define (compiler-backend-emit-program-linux-with-spans
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]) : ResultCompilerBackend
  (compiler-backend-emit-program-target
    program
    (CompilerBackendTarget.Linux)
    spans
    true))

(define (compiler-backend-emit-program-linux-with-spans-and-entry
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackend
  (compiler-backend-emit-program-target
    program
    (CompilerBackendTarget.Linux)
    spans
    emit-entry))

(define (compiler-backend-emit-program-with-spans-for-target
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (compiler-backend-emit-program-target program target spans true))

(define (compiler-backend-emit-program-with-spans-for-target-and-entry
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]
  [target : CompilerBackendTarget]
  [emit-entry : bool]) : ResultCompilerBackend
  (compiler-backend-emit-program-target program target spans emit-entry))

(define (compiler-backend-emit-program-target
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackend
  (compiler-backend-emit-program-target-with-mode
    program
    target
    (CompilerBackendMode.Scalar)
    spans
    emit-entry))

(define (compiler-backend-emit-program-target-with-mode-buffer
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackendBuffer
  (compiler-backend-emit-program-target-with-mode-buffer-and-crt
    program
    target
    mode
    spans
    emit-entry
    false))

(define (compiler-backend-emit-program-prefix-buffer
  [target : CompilerBackendTarget]
  [entry-functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [runtime-index : CompilerBackendRuntimeIndex]
  [closure-names : BackendStringList]
  [strings : BackendStringList]
  [bytes : BackendStringList]
  [floats : BackendFloatList]
  [uses-avx2-i64-lane-id : bool]
  [uses-avx512-i64-lane-id : bool]
  [uses-f64-neg : bool]
  [globals-buf : text_buf.TextBuf]
  [emit-entry : bool]
  [crt-entry : bool]) : text_buf.TextBuf
  (let
    [string-buf : text_buf.TextBuf
      (compiler-backend-emit-string-rodata-into strings globals-buf)]
    (begin
      (cfg
        compile-profile
        (compiler-backend-profile-finish "compose.string_rodata"))
      (cfg compile-profile (compiler-backend-profile-start))
      (let
        [bytes-buf : text_buf.TextBuf
          (compiler-backend-emit-bytes-data-into bytes string-buf)]
        (begin
          (cfg
            compile-profile
            (compiler-backend-profile-finish "compose.bytes_data"))
          (cfg compile-profile (compiler-backend-profile-start))
          (let
            [float-literals-buf : text_buf.TextBuf
              (compiler-backend-emit-float-rodata-into floats bytes-buf)]
            [f64-buf : text_buf.TextBuf
              (compiler-backend-emit-f64-sign-bit-rodata-into
                uses-f64-neg
                float-literals-buf)]
            [lane-id-buf : text_buf.TextBuf
              (compiler-backend-emit-lane-id-rodata-into
                uses-avx2-i64-lane-id
                uses-avx512-i64-lane-id
                f64-buf)]
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-finish "compose.float_rodata"))
              (cfg compile-profile (compiler-backend-profile-start))
              (let
                [descriptor-buf : text_buf.TextBuf
                  (compiler-backend-emit-closure-descriptors-into
                    closure-names
                    entry-functions
                    externs
                    program-index
                    lane-id-buf)]
                (begin
                  (cfg
                    compile-profile
                    (compiler-backend-profile-finish
                      "compose.closure_descriptors"))
                  (cfg compile-profile (compiler-backend-profile-start))
                  (let
                    [switch-buf : text_buf.TextBuf
                      (compiler-backend-emit-switch-tables-functions-into
                        entry-functions
                        program-index
                        descriptor-buf)]
                    [runtime-data-buf : text_buf.TextBuf
                      (text_buf.append
                        switch-buf
                        (if emit-entry
                          (compiler-backend-runtime-data-for-target target plan)
                          ""))]
                    (begin
                      (cfg
                        compile-profile
                        (compiler-backend-profile-finish "compose.runtime_data"))
                      (cfg compile-profile (compiler-backend-profile-start))
                      (let
                        [externs-buf : text_buf.TextBuf
                          (compiler-backend-emit-externs-into
                            externs
                            plan
                            runtime-index
                            closure-names
                            runtime-data-buf)]
                        (begin
                          (cfg
                            compile-profile
                            (compiler-backend-profile-finish "compose.externs"))
                          (cfg compile-profile (compiler-backend-profile-start))
                          (let
                            [runtime-externs-buf : text_buf.TextBuf
                              (text_buf.append
                                externs-buf
                                (if emit-entry
                                  (compiler-backend-runtime-externs-for-target
                                    target
                                    plan)
                                  ""))]
                            (begin
                              (cfg
                                compile-profile
                                (compiler-backend-profile-finish
                                  "compose.runtime_externs"))
                              (cfg
                                compile-profile
                                (compiler-backend-profile-start))
                              (let
                                [prefix-buf : text_buf.TextBuf
                                  (text_buf.append
                                    runtime-externs-buf
                                    (compiler-backend-target-entry-text-with-crt
                                      target
                                      emit-entry
                                      crt-entry))]
                                (begin
                                  (cfg
                                    compile-profile
                                    (compiler-backend-profile-finish
                                      "compose.entry_text"))
                                  prefix-buf)))))))))))))))))

(define (compiler-backend-emit-program-buffer-after-index
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [entry-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [runtime-index : CompilerBackendRuntimeIndex]
  [program-index : CompilerBackendProgramIndex]
  [spans : CompilerSourceSpans]
  [globals-buf : text_buf.TextBuf]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendBuffer
  (let
    [collections : CompilerBackendProgramCollections
      (compiler-backend-collect-program-collections program)]
    [closure-names : BackendStringList
      (compiler-backend-program-collections-functions collections)]
    [strings : BackendStringList
      (compiler-backend-program-collections-strings collections)]
    [bytes : BackendStringList
      (compiler-backend-program-collections-bytes collections)]
    [floats : BackendFloatList
      (compiler-backend-program-collections-floats collections)]
    [uses-avx2-i64-lane-id : bool
      (compiler-backend-program-collections-uses-avx2-i64-lane-id? collections)]
    [uses-avx512-i64-lane-id : bool
      (compiler-backend-program-collections-uses-avx512-i64-lane-id?
        collections)]
    [uses-f64-neg : bool
      (compiler-backend-program-collections-uses-f64-neg? collections)]
    [span-index : CompilerBackendSourceSpanIndex
      (compiler-backend-source-span-index-build spans)]
    [global-types : CompilerBackendGlobalTypeList
      (compiler-backend-global-types globals)]
    (begin
      (cfg compile-profile (compiler-backend-profile-finish "collect"))
      (cfg compile-profile (compiler-backend-profile-start))
      (let
        [prefix-buf : text_buf.TextBuf
          (compiler-backend-emit-program-prefix-buffer
            target
            entry-functions
            externs
            plan
            program-index
            runtime-index
            closure-names
            strings
            bytes
            floats
            uses-avx2-i64-lane-id
            uses-avx512-i64-lane-id
            uses-f64-neg
            globals-buf
            emit-entry
            crt-entry)]
        [function-input : text_buf.TextBuf
          (if (compiler-backend-assembly-stream-active?)
            (begin
              (compiler-backend-assembly-stream-process-buffer! prefix-buf)
              (text_buf.empty))
            prefix-buf)]
        (begin
          ;; This window previously started at the "collect" finish and was
          ;; overwritten by the next start without ever being reported,
          ;; hiding the prefix composition from the phase breakdown.
          (cfg compile-profile (compiler-backend-profile-finish "prefix"))
          (cfg compile-profile (compiler-backend-profile-start))
          (match (compiler-backend-emit-functions-buffer-into
            target
            mode
            entry-functions
            entry-functions
            globals
            global-types
            externs
            plan
            program-index
            spans
            span-index
            emit-entry
            crt-entry
            function-input)
            [(ResultCompilerBackendBuffer.Ok with-functions)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-finish "functions"))
                (cfg
                  compile-profile-summary
                  (compiler-backend-profile-summary-emit))
                (cfg compile-profile (compiler-backend-profile-start))
                (match (compiler-backend-emit-closure-entry-adapters-buffer-into
                  target
                  closure-names
                  entry-functions
                  externs
                  plan
                  program-index
                  with-functions)
                  [(ResultCompilerBackendBuffer.Ok with-adapters)
                    (begin
                      (cfg
                        compile-profile
                        (compiler-backend-profile-finish "adapters"))
                      (cfg compile-profile (compiler-backend-profile-start))
                      (let
                        [buf : text_buf.TextBuf
                          (text_buf.append
                            (text_buf.append
                              with-adapters
                              (if emit-entry
                                (compiler-backend-runtime-functions-for-target
                                  target
                                  plan)
                                ""))
                            (if emit-entry
                              (compiler-backend-entry-for-target-with-crt
                                target
                                plan
                                globals
                                crt-entry
                                program-index)
                              ""))]
                        (begin
                          (cfg
                            compile-profile
                            (compiler-backend-profile-finish "compose_tail"))
                          (cfg
                            regalloc-census
                            (begin
                              (compiler-reg-call-span-census-print!)
                              (compiler-reg-move-census-print!)
                              (io.print-error
                                (str_cat.str-cat
                                  "rsp-rebase|ok="
                                  (string.int->string
                                    compiler-backend-rsp-rebase-ok-count)
                                  "|keep-rbp="
                                  (string.int->string
                                    compiler-backend-rsp-rebase-keep-count)
                                  "|fpo="
                                  (string.int->string
                                    compiler-backend-fpo-count)
                                  (str_cat.str-cat
                                    "|rbp-pool="
                                    (string.int->string
                                      compiler-backend-fpo-rbp-plan-count)
                                    "|demote="
                                    (string.int->string
                                      compiler-backend-fpo-demote-count)
                                    "|push="
                                    (string.int->string
                                      compiler-backend-fpo-push-count)
                                    "\n"
                                    "")))
                              (io.print-error
                                (str_cat.str-cat
                                  "peephole-r10-dead-scan|cap="
                                  (string.int->string
                                    compiler-backend-peephole-r10-dead-scan-line-cap)
                                  "|cap-hits="
                                  (string.int->string
                                    compiler-backend-peephole-r10-dead-scan-cap-hits)
                                  "\n"
                                  ""))))
                          (cfg
                            scavenge-census
                            (compiler-backend-scavenge-census-print!))
                          (ResultCompilerBackendBuffer.Ok
                            (if (compiler-backend-assembly-stream-active?)
                              (begin
                                (compiler-backend-assembly-stream-process-buffer!
                                  buf)
                                (compiler-backend-assembly-stream-output))
                              buf)))))]
                  [(ResultCompilerBackendBuffer.Err message)
                    (begin
                      (cfg
                        compile-profile
                        (compiler-backend-profile-finish "adapters"))
                      (ResultCompilerBackendBuffer.Err message))]))]
            [(ResultCompilerBackendBuffer.Err message)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-finish "functions"))
                (cfg
                  compile-profile-summary
                  (compiler-backend-profile-summary-emit))
                (ResultCompilerBackendBuffer.Err message))]))))))

(define (compiler-backend-emit-program-target-with-mode-buffer-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendBuffer
  (begin
    (compiler-backend-user-symbol-cache-reset!)
    (compiler-backend-peephole-carry-safe-reset!)
    (set! compiler-backend-rsp-rebase-ok-count 0)
    (set! compiler-backend-rsp-rebase-keep-count 0)
    (set! compiler-backend-fpo-count 0)
    (set! compiler-backend-fpo-rbp-plan-count 0)
    (set! compiler-backend-fpo-demote-count 0)
    (set! compiler-backend-fpo-push-count 0)
    (set! compiler-backend-peephole-r10-dead-scan-cap-hits 0)
    ;; GAP5: clear the post-emission dead-frame-store sweep metadata before
    ;; recording this program's FPO functions (a stale entry from a prior
    ;; program emit in the same process must not leak into the sweep).
    (compiler-backend-sweep-reset!)
    (cfg
      regalloc-census
      (begin
        (compiler-reg-call-span-census-reset!)
        (compiler-reg-move-census-reset!)))
    (cfg scavenge-census (compiler-backend-scavenge-census-reset!))
    (cfg compile-profile (compiler-backend-profile-start))
    (match (compiler-backend-runtime-plan-with-index program)
      [(ResultBackendRuntimePlanWithIndex.Ok planned)
        (let
          [plan : CompilerBackendRuntimePlan (struct-get planned plan)]
          [runtime-index : CompilerBackendRuntimeIndex
            (struct-get planned index)]
          (begin
            (cfg
              compile-profile
              (compiler-backend-profile-finish "runtime_plan"))
            (cfg compile-profile (compiler-backend-profile-start))
            (if (compiler-backend-target-runtime-ok? target plan)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-finish "target_check"))
                (cfg compile-profile (compiler-backend-profile-start))
                (match program
                  [(CompilerIrProgram.Program globals functions externs)
                    ;; Build the program index ONCE over the entry function list
                    ;; and share it with the globals emission: each build walks
                    ;; every function body for the register-group counts, so the
                    ;; former second build doubled both that walk and its ~120MB
                    ;; of transient allocation. The entry list is a superset of
                    ;; `functions` (at most the synthesized implicit main, which
                    ;; no global initializer can reference), so globals resolve
                    ;; identically against the shared index.
                    (let
                      [entry-functions : CompilerIrFunctionList
                        (compiler-backend-functions-with-implicit-main
                          functions
                          emit-entry)]
                      [program-index : CompilerBackendProgramIndex
                        (compiler-backend-program-index-build
                          entry-functions
                          externs)]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-backend-profile-finish "index"))
                        (cfg compile-profile (compiler-backend-profile-start))
                        (match (compiler-backend-emit-globals-buffer-into
                          target
                          globals
                          (text_buf.append (text_buf.empty) ".data\n")
                          program-index)
                          [(ResultCompilerBackendBuffer.Ok globals-buf)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-backend-profile-finish "globals"))
                              (cfg
                                compile-profile
                                (compiler-backend-profile-start))
                              (match (compiler-backend-validate-function-symbols
                                globals
                                entry-functions
                                externs
                                plan
                                program-index)
                                [(ResultCompilerBackendSymbolValidation.Ok _)
                                  (compiler-backend-emit-program-buffer-after-index
                                    program
                                    target
                                    mode
                                    entry-functions
                                    globals
                                    externs
                                    plan
                                    runtime-index
                                    program-index
                                    spans
                                    globals-buf
                                    emit-entry
                                    crt-entry)]
                                [(ResultCompilerBackendSymbolValidation.Err
                                    message)
                                  (ResultCompilerBackendBuffer.Err message)]))]
                          [(ResultCompilerBackendBuffer.Err message)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-backend-profile-finish "globals"))
                              (ResultCompilerBackendBuffer.Err message))])))]))
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-finish "target_check"))
                (ResultCompilerBackendBuffer.Err
                  (box
                    (compiler-diagnostic-at-start
                      ""
                      "backend: internal target runtime rejection")))))))]
      [(ResultBackendRuntimePlanWithIndex.Err message)
        (begin
          (cfg compile-profile (compiler-backend-profile-finish "runtime_plan"))
          (ResultCompilerBackendBuffer.Err
            (box (compiler-diagnostic-at-start "" message))))])))

(defstruct CompilerBackendObjectParts
  (text cobj.CompilerObjectX64InstrBuilder)
  (data cobj.CompilerObjectDataRecordBuilder)
  (rodata cobj.CompilerObjectDataRecordBuilder)
  (bss cobj.CompilerObjectDataRecordBuilder)
  (pdata cobj.CompilerObjectDataRecordBuilder)
  (xdata cobj.CompilerObjectDataRecordBuilder)
  (symbols cobj.CompilerObjectSymbolBuilder)
  (relocations cobj.CompilerObjectRelocationBuilder))

(define (compiler-backend-object-parts-empty) : CompilerBackendObjectParts
  (CompilerBackendObjectParts
    (cobj.compiler-object-instr-builder-new)
    (cobj.compiler-object-data-record-builder-new)
    (cobj.compiler-object-data-record-builder-new)
    (cobj.compiler-object-data-record-builder-new)
    (cobj.compiler-object-data-record-builder-new)
    (cobj.compiler-object-data-record-builder-new)
    (cobj.compiler-object-symbol-builder-new)
    (cobj.compiler-object-relocation-builder-new)))

(define (compiler-backend-object-add-text
  [parts : CompilerBackendObjectParts]
  [instr : cobj.CompilerObjectX64Instr]) : CompilerBackendObjectParts
  (CompilerBackendObjectParts
    (cobj.compiler-object-instr-builder-push (struct-get parts text) instr)
    (struct-get parts data)
    (struct-get parts rodata)
    (struct-get parts bss)
    (struct-get parts pdata)
    (struct-get parts xdata)
    (struct-get parts symbols)
    (struct-get parts relocations)))

(define (compiler-backend-object-add-data
  [parts : CompilerBackendObjectParts]
  [record : cobj.CompilerObjectDataRecord]) : CompilerBackendObjectParts
  (CompilerBackendObjectParts
    (struct-get parts text)
    (cobj.compiler-object-data-record-builder-push
      (struct-get parts data)
      record)
    (struct-get parts rodata)
    (struct-get parts bss)
    (struct-get parts pdata)
    (struct-get parts xdata)
    (struct-get parts symbols)
    (struct-get parts relocations)))

(define (compiler-backend-object-add-rodata
  [parts : CompilerBackendObjectParts]
  [record : cobj.CompilerObjectDataRecord]) : CompilerBackendObjectParts
  (CompilerBackendObjectParts
    (struct-get parts text)
    (struct-get parts data)
    (cobj.compiler-object-data-record-builder-push
      (struct-get parts rodata)
      record)
    (struct-get parts bss)
    (struct-get parts pdata)
    (struct-get parts xdata)
    (struct-get parts symbols)
    (struct-get parts relocations)))

(define (compiler-backend-object-add-bss
  [parts : CompilerBackendObjectParts]
  [record : cobj.CompilerObjectDataRecord]) : CompilerBackendObjectParts
  (CompilerBackendObjectParts
    (struct-get parts text)
    (struct-get parts data)
    (struct-get parts rodata)
    (cobj.compiler-object-data-record-builder-push
      (struct-get parts bss)
      record)
    (struct-get parts pdata)
    (struct-get parts xdata)
    (struct-get parts symbols)
    (struct-get parts relocations)))

(define (compiler-backend-object-add-pdata
  [parts : CompilerBackendObjectParts]
  [record : cobj.CompilerObjectDataRecord]) : CompilerBackendObjectParts
  (CompilerBackendObjectParts
    (struct-get parts text)
    (struct-get parts data)
    (struct-get parts rodata)
    (struct-get parts bss)
    (cobj.compiler-object-data-record-builder-push
      (struct-get parts pdata)
      record)
    (struct-get parts xdata)
    (struct-get parts symbols)
    (struct-get parts relocations)))

(define (compiler-backend-object-add-xdata
  [parts : CompilerBackendObjectParts]
  [record : cobj.CompilerObjectDataRecord]) : CompilerBackendObjectParts
  (CompilerBackendObjectParts
    (struct-get parts text)
    (struct-get parts data)
    (struct-get parts rodata)
    (struct-get parts bss)
    (struct-get parts pdata)
    (cobj.compiler-object-data-record-builder-push
      (struct-get parts xdata)
      record)
    (struct-get parts symbols)
    (struct-get parts relocations)))

(define (compiler-backend-object-add-symbol
  [parts : CompilerBackendObjectParts]
  [name : String]
  [binding : cobj.CompilerObjectSymbolBinding]
  [kind : cobj.CompilerObjectSymbolKind]
  [section : cobj.CompilerObjectMaybeSection]) : CompilerBackendObjectParts
  (CompilerBackendObjectParts
    (struct-get parts text)
    (struct-get parts data)
    (struct-get parts rodata)
    (struct-get parts bss)
    (struct-get parts pdata)
    (struct-get parts xdata)
    (cobj.compiler-object-symbol-builder-push
      (struct-get parts symbols)
      (cobj.CompilerObjectSymbol.Symbol name binding kind section))
    (struct-get parts relocations)))

(define (compiler-backend-object-add-relocation
  [parts : CompilerBackendObjectParts]
  [section : cobj.CompilerObjectSectionKind]
  [site : String]
  [kind : cobj.CompilerObjectRelocationKind]
  [target : String]) : CompilerBackendObjectParts
  (CompilerBackendObjectParts
    (struct-get parts text)
    (struct-get parts data)
    (struct-get parts rodata)
    (struct-get parts bss)
    (struct-get parts pdata)
    (struct-get parts xdata)
    (struct-get parts symbols)
    (cobj.compiler-object-relocation-builder-push
      (struct-get parts relocations)
      (cobj.CompilerObjectRelocation.Relocation section site kind target))))

(define (compiler-backend-object-symbol-local-section
  [parts : CompilerBackendObjectParts]
  [name : String]
  [section : cobj.CompilerObjectSectionKind]
  [kind : cobj.CompilerObjectSymbolKind]) : CompilerBackendObjectParts
  (compiler-backend-object-add-symbol
    parts
    name
    (cobj.CompilerObjectSymbolBinding.Local)
    kind
    (cobj.CompilerObjectMaybeSection.Some section)))

(define (compiler-backend-object-symbol-export-section
  [parts : CompilerBackendObjectParts]
  [name : String]
  [section : cobj.CompilerObjectSectionKind]
  [kind : cobj.CompilerObjectSymbolKind]) : CompilerBackendObjectParts
  (compiler-backend-object-add-symbol
    parts
    name
    (cobj.CompilerObjectSymbolBinding.Export)
    kind
    (cobj.CompilerObjectMaybeSection.Some section)))

(define (compiler-backend-object-symbol-extern
  [parts : CompilerBackendObjectParts]
  [name : String]
  [kind : cobj.CompilerObjectSymbolKind]) : CompilerBackendObjectParts
  (compiler-backend-object-add-symbol
    parts
    name
    (cobj.CompilerObjectSymbolBinding.Extern)
    kind
    (cobj.CompilerObjectMaybeSection.No)))

(define (compiler-backend-object-symbol-extern-once
  [parts : CompilerBackendObjectParts]
  [name : String]
  [kind : cobj.CompilerObjectSymbolKind]) : CompilerBackendObjectParts
  (if (cobj.compiler-object-symbol-builder-contains?
    (struct-get parts symbols)
    name
    (cobj.CompilerObjectSymbolBinding.Extern)
    kind)
    parts
    (compiler-backend-object-symbol-extern parts name kind)))

(define (compiler-backend-object-add-text-relocation
  [parts : CompilerBackendObjectParts]
  [site : String]
  [kind : cobj.CompilerObjectRelocationKind]
  [target : String]) : CompilerBackendObjectParts
  (compiler-backend-object-add-relocation
    parts
    (cobj.CompilerObjectSectionKind.Text)
    site
    kind
    target))

(define (compiler-backend-object-add-data-relocation
  [parts : CompilerBackendObjectParts]
  [site : String]
  [kind : cobj.CompilerObjectRelocationKind]
  [target : String]) : CompilerBackendObjectParts
  (compiler-backend-object-add-relocation
    parts
    (cobj.CompilerObjectSectionKind.Data)
    site
    kind
    target))

(define (compiler-backend-object-add-rodata-relocation
  [parts : CompilerBackendObjectParts]
  [site : String]
  [kind : cobj.CompilerObjectRelocationKind]
  [target : String]) : CompilerBackendObjectParts
  (compiler-backend-object-add-relocation
    parts
    (cobj.CompilerObjectSectionKind.Rodata)
    site
    kind
    target))

(define (compiler-backend-object-add-pdata-relocation
  [parts : CompilerBackendObjectParts]
  [site : String]
  [kind : cobj.CompilerObjectRelocationKind]
  [target : String]) : CompilerBackendObjectParts
  (compiler-backend-object-add-relocation
    parts
    (cobj.CompilerObjectSectionKind.Pdata)
    site
    kind
    target))

(define (compiler-backend-object-value-ref
  [parts : CompilerBackendObjectParts]
  [site : String]
  [value : CompilerIrValue]) : CompilerBackendObjectParts
  (match value
    [(CompilerIrValue.Global name)
      (let
        [symbol : String (compiler-backend-user-symbol name)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipValue)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRip symbol)))]
    [(CompilerIrValue.GlobalAddr name)
      (let
        [symbol : String (compiler-backend-user-symbol name)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [(CompilerIrValue.String text)
      (let
        [symbol : String (compiler-backend-string-fat-label text)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [(CompilerIrValue.Bytes text)
      (let
        [symbol : String (compiler-backend-bytes-fat-label text)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [(CompilerIrValue.F64 bits)
      (let
        [symbol : String (compiler-backend-f64-label bits)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipValue)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRip symbol)))]
    [(CompilerIrValue.Function name)
      (let
        [symbol : String (compiler-backend-closure-descriptor-label name)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [_ parts]))

(define (compiler-backend-object-value-ref-with-type
  [parts : CompilerBackendObjectParts]
  [site : String]
  [value : CompilerIrValue]
  [ty : AstType]) : CompilerBackendObjectParts
  (match value
    [(CompilerIrValue.F64 bits)
      (let
        [symbol : String (compiler-backend-float-label ty bits)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipValue)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRip symbol)))]
    [_ (compiler-backend-object-value-ref parts site value)]))

(define (compiler-backend-object-call-args
  [parts : CompilerBackendObjectParts]
  [site : String]
  [args : CompilerIrCallArgs]
  [index : i64]) : CompilerBackendObjectParts
  (if (>= index (compiler-backend-call-args-count args))
    parts
    (compiler-backend-object-call-args
      (compiler-backend-object-value-ref
        parts
        site
        (compiler-backend-call-arg-at args index))
      site
      args
      (+ index 1))))

(define (compiler-backend-object-spmd-call-args
  [parts : CompilerBackendObjectParts]
  [site : String]
  [args : CompilerIrSpmdCallArgList]) : CompilerBackendObjectParts
  (match args
    [(CompilerIrSpmdCallArgList.Nil) parts]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (compiler-backend-object-spmd-call-args
            (compiler-backend-object-value-ref parts site value)
            site
            (box-get rest))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : CompilerBackendObjectParts parts]
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(CompilerIrSpmdCallArg.Arg _ value _)
                  (set! out (compiler-backend-object-value-ref out site value))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-backend-object-value-list-ref
  [parts : CompilerBackendObjectParts]
  [site : String]
  [values : CompilerIrValueList]) : CompilerBackendObjectParts
  (match values
    [(CompilerIrValueList.Nil) parts]
    [(CompilerIrValueList.Array seq)
      (compiler-backend-object-value-list-ref
        parts
        site
        (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (compiler-backend-object-value-list-ref
        (compiler-backend-object-value-ref parts site value)
        site
        (box-get rest))]))

(define (compiler-backend-object-phi-inputs
  [parts : CompilerBackendObjectParts]
  [site : String]
  [inputs : CompilerIrPhiInputList]) : CompilerBackendObjectParts
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) parts]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-backend-object-phi-inputs
        parts
        site
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (compiler-backend-object-phi-inputs
        (compiler-backend-object-value-ref parts site value)
        site
        (box-get rest))]))

(define (compiler-backend-object-phi-inputs-with-type
  [parts : CompilerBackendObjectParts]
  [site : String]
  [inputs : CompilerIrPhiInputList]
  [ty : AstType]) : CompilerBackendObjectParts
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) parts]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-backend-object-phi-inputs-with-type
        parts
        site
        (compiler-ir-phi-input-seq-to-list seq)
        ty)]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (compiler-backend-object-phi-inputs-with-type
        (compiler-backend-object-value-ref-with-type parts site value ty)
        site
        (box-get rest)
        ty)]))

(define (compiler-backend-object-byte [value : i64]) : u8
  (cast (bit-and value 0xff) : u8))

;; Private hot object-code fragments use the narrow append-only ByteBuf core.
(define (compiler-backend-object-push-u8!
  [out : (&mut out byte_buf_core.ByteBufBuilder)]
  [value : i64]) : unit
  (byte_buf_core.byte-buf-builder-push out (compiler-backend-object-byte value)))

(define (compiler-backend-object-push-u32!
  [out : (&mut out byte_buf_core.ByteBufBuilder)]
  [value : i64]) : unit
  (begin
    (compiler-backend-object-push-u8! out value)
    (compiler-backend-object-push-u8! out (shr value 8))
    (compiler-backend-object-push-u8! out (shr value 16))
    (compiler-backend-object-push-u8! out (shr value 24))))

(define (compiler-backend-object-bytes-finish
  [out : (& out byte_buf_core.ByteBufBuilder)]) : String
  (byte_buf_core.byte-buf-builder-finish-string out))

(define (compiler-backend-object-add-nonempty-bytes
  [parts : CompilerBackendObjectParts]
  [bytes : String]) : CompilerBackendObjectParts
  (if (= (string.string-length bytes) 0)
    parts
    (compiler-backend-object-add-text
      parts
      (cobj.CompilerObjectX64Instr.Bytes bytes))))

(define (compiler-backend-object-reg-low-code [reg : String]) : i64
  (cond
    [(or (string.eq reg "%rax") (string.eq reg "%r8")) 0]
    [(or (string.eq reg "%rcx") (string.eq reg "%r9")) 1]
    [(or (string.eq reg "%rdx") (string.eq reg "%r10")) 2]
    [(or (string.eq reg "%rbx") (string.eq reg "%r11")) 3]
    [(or (string.eq reg "%rsp") (string.eq reg "%r12")) 4]
    [(or (string.eq reg "%rbp") (string.eq reg "%r13")) 5]
    [(or (string.eq reg "%rsi") (string.eq reg "%r14")) 6]
    [else 7]))

(define (compiler-backend-object-reg-high? [reg : String]) : bool
  (or
    (string.eq reg "%r8")
    (string.eq reg "%r9")
    (string.eq reg "%r10")
    (string.eq reg "%r11")
    (string.eq reg "%r12")
    (string.eq reg "%r13")
    (string.eq reg "%r14")
    (string.eq reg "%r15")))

(define (compiler-backend-object-slot-disp [var-id : i64]) : i64
  (- 0 (* 8 (+ var-id 1))))

(define (compiler-backend-object-disp8? [disp : i64]) : bool
  (and (>= disp -128) (<= disp 127)))

(define (compiler-backend-object-load-rbp-disp-bytes
  [disp : i64]
  [reg : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
    [rex : i64
      (+
        0x48
        (if (compiler-backend-object-reg-high? reg)
          4
          0))]
    (begin
      (compiler-backend-object-push-u8! (&mut out) rex)
      (compiler-backend-object-push-u8! (&mut out) 0x8b)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x45 (* reg-code 8)))
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x85 (* reg-code 8)))
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-store-slot-bytes [var-id : i64] [reg : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [disp : i64 (compiler-backend-object-slot-disp var-id)]
    [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
    [rex : i64
      (+
        0x48
        (if (compiler-backend-object-reg-high? reg)
          4
          0))]
    (begin
      (compiler-backend-object-push-u8! (&mut out) rex)
      (compiler-backend-object-push-u8! (&mut out) 0x89)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x45 (* reg-code 8)))
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x85 (* reg-code 8)))
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-mov-imm32-reg-bytes
  [value : i64]
  [reg : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
    [rex : i64
      (+
        0x48
        (if (compiler-backend-object-reg-high? reg)
          1
          0))]
    (begin
      (compiler-backend-object-push-u8! (&mut out) rex)
      (compiler-backend-object-push-u8! (&mut out) 0xc7)
      (compiler-backend-object-push-u8! (&mut out) (+ 0xc0 reg-code))
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-mov-reg-reg-bytes
  [src : String]
  [dst : String]) : String
  (if (string.eq src dst)
    ""
    (let
      [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
      [src-code : i64 (compiler-backend-object-reg-low-code src)]
      [dst-code : i64 (compiler-backend-object-reg-low-code dst)]
      [rex : i64
        (+
          0x48
          (+
            (if (compiler-backend-object-reg-high? src)
              4
              0)
            (if (compiler-backend-object-reg-high? dst)
              1
              0)))]
      (begin
        (compiler-backend-object-push-u8! (&mut out) rex)
        (compiler-backend-object-push-u8! (&mut out) 0x89)
        (compiler-backend-object-push-u8!
          (&mut out)
          (+ 0xc0 (+ (* src-code 8) dst-code)))
        (compiler-backend-object-bytes-finish (& out))))))

(define (compiler-backend-object-prologue-bytes [frame-size : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x55)
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x89)
      (compiler-backend-object-push-u8! (&mut out) 0xe5)
      (if (= frame-size 0)
        unit
        (if (<= frame-size 127)
          (begin
            (compiler-backend-object-push-u8! (&mut out) 0x48)
            (compiler-backend-object-push-u8! (&mut out) 0x83)
            (compiler-backend-object-push-u8! (&mut out) 0xec)
            (compiler-backend-object-push-u8! (&mut out) frame-size))
          (begin
            (compiler-backend-object-push-u8! (&mut out) 0x48)
            (compiler-backend-object-push-u8! (&mut out) 0x81)
            (compiler-backend-object-push-u8! (&mut out) 0xec)
            (compiler-backend-object-push-u32! (&mut out) frame-size))))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-leave-ret-bytes) : String
  (compiler-backend-object-bytes-from-hex "c9c3"))

(define (compiler-backend-object-zero-eax-bytes) : String
  (compiler-backend-object-bytes-from-hex "31c0"))

(define (compiler-backend-object-rsp-imm-bytes [opcode : i64] [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (if (<= value 127)
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x48)
          (compiler-backend-object-push-u8! (&mut out) 0x83)
          (compiler-backend-object-push-u8! (&mut out) opcode)
          (compiler-backend-object-push-u8! (&mut out) value))
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x48)
          (compiler-backend-object-push-u8! (&mut out) 0x81)
          (compiler-backend-object-push-u8! (&mut out) opcode)
          (compiler-backend-object-push-u32! (&mut out) value)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-sub-rsp-bytes [value : i64]) : String
  (if (= value 0)
    ""
    (compiler-backend-object-rsp-imm-bytes 0xec value)))

(define (compiler-backend-object-add-rsp-bytes [value : i64]) : String
  (if (= value 0)
    ""
    (compiler-backend-object-rsp-imm-bytes 0xc4 value)))

(define (compiler-backend-object-store-rax-rsp-bytes [disp : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x89)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x44)
          (compiler-backend-object-push-u8! (&mut out) 0x24)
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x84)
          (compiler-backend-object-push-u8! (&mut out) 0x24)
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-load-rax-pointee-bytes [ty : AstType]) : String
  (let
    [size : i64 (compiler-backend-type-size ty)]
    [signed : bool (compiler-backend-type-signed? ty)]
    (cond
      [(= size 8) (compiler-backend-object-bytes-from-hex "488b00")]
      [(= size 4)
        (if signed
          (compiler-backend-object-bytes-from-hex "486300")
          (compiler-backend-object-bytes-from-hex "8b00"))]
      [(= size 2)
        (if signed
          (compiler-backend-object-bytes-from-hex "480fbf00")
          (compiler-backend-object-bytes-from-hex "0fb700"))]
      [(= size 1)
        (if signed
          (compiler-backend-object-bytes-from-hex "480fbe00")
          (compiler-backend-object-bytes-from-hex "0fb600"))]
      [else (compiler-backend-object-bytes-from-hex "488b00")])))

(define (compiler-backend-object-leave-bytes) : String
  (compiler-backend-object-bytes-from-hex "c9"))

(define (compiler-backend-object-load-value-to-reg
  [parts : CompilerBackendObjectParts]
  [site : String]
  [value : CompilerIrValue]
  [reg : String]) : CompilerBackendObjectParts
  (match value
    [(CompilerIrValue.Var id)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-load-rbp-disp-bytes
          (compiler-backend-object-slot-disp id)
          reg))]
    [(CompilerIrValue.I64 n)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes n reg))]
    [(CompilerIrValue.Bool b)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes
          (if b
            1
            0)
          reg))]
    [(CompilerIrValue.Char c)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes
          (compiler-backend-char-code c)
          reg))]
    [(CompilerIrValue.Unit)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes 0 reg))]
    [(CompilerIrValue.Global _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.GlobalAddr _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.String _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.Bytes _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.Function _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(CompilerIrValue.F64 _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]))

(define (compiler-backend-object-load-value-to-reg-with-type
  [parts : CompilerBackendObjectParts]
  [site : String]
  [value : CompilerIrValue]
  [ty : AstType]
  [reg : String]) : CompilerBackendObjectParts
  (match value
    [(CompilerIrValue.F64 _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref-with-type parts site value ty)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [_ (compiler-backend-object-load-value-to-reg parts site value reg)]))

(define (compiler-backend-object-store-reg-to-var
  [parts : CompilerBackendObjectParts]
  [dst : i64]
  [reg : String]) : CompilerBackendObjectParts
  (compiler-backend-object-add-nonempty-bytes
    parts
    (compiler-backend-object-store-slot-bytes dst reg)))

(define (compiler-backend-object-move-value-to-var
  [parts : CompilerBackendObjectParts]
  [site : String]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]) : CompilerBackendObjectParts
  (compiler-backend-object-store-reg-to-var
    (compiler-backend-object-load-value-to-reg-with-type
      parts
      site
      src
      ty
      "%rax")
    dst
    "%rax"))

(define (compiler-backend-object-group-word-var [var : i64] [word-index : i64]) : i64
  (if (= word-index 0)
    var
    (+ compiler-backend-current-slot-vars var)))

(define (compiler-backend-object-load-group-word-to-reg
  [parts : CompilerBackendObjectParts]
  [var : i64]
  [word-index : i64]
  [reg : String]) : CompilerBackendObjectParts
  (compiler-backend-object-add-nonempty-bytes
    parts
    (compiler-backend-object-load-rbp-disp-bytes
      (compiler-backend-object-slot-disp
        (compiler-backend-object-group-word-var var word-index))
      reg)))

(define (compiler-backend-object-store-reg-to-group-word
  [parts : CompilerBackendObjectParts]
  [var : i64]
  [word-index : i64]
  [reg : String]) : CompilerBackendObjectParts
  (compiler-backend-object-add-nonempty-bytes
    parts
    (compiler-backend-object-store-slot-bytes
      (compiler-backend-object-group-word-var var word-index)
      reg)))

(define (compiler-backend-object-move-group-value-to-var
  [parts : CompilerBackendObjectParts]
  [site : String]
  [dst : i64]
  [src : CompilerIrValue]) : CompilerBackendObjectParts
  (match src
    [(CompilerIrValue.Var src-var)
      (compiler-backend-object-store-reg-to-group-word
        (compiler-backend-object-store-reg-to-group-word
          (compiler-backend-object-load-group-word-to-reg
            (compiler-backend-object-load-group-word-to-reg
              parts
              src-var
              0
              "%rax")
            src-var
            1
            "%rdx")
          dst
          0
          "%rax")
        dst
        1
        "%rdx")]
    [_ (compiler-backend-object-value-ref parts site src)]))

(define (compiler-backend-object-pack-to-var
  [parts : CompilerBackendObjectParts]
  [site : String]
  [dst : i64]
  [words : CompilerIrValueList]) : CompilerBackendObjectParts
  (match (compiler-ir-value-list-force-cons words)
    [(CompilerIrValueList.Cons word0 rest0)
      (match (compiler-ir-value-list-force-cons (box-get rest0))
        [(CompilerIrValueList.Cons word1 _)
          (compiler-backend-object-store-reg-to-group-word
            (compiler-backend-object-store-reg-to-group-word
              (compiler-backend-object-load-value-to-reg
                (compiler-backend-object-load-value-to-reg
                  parts
                  site
                  word0
                  "%rax")
                site
                word1
                "%rdx")
              dst
              0
              "%rax")
            dst
            1
            "%rdx")]
        [_ (compiler-backend-object-value-list-ref parts site words)])]
    [_ (compiler-backend-object-value-list-ref parts site words)]))

(define (compiler-backend-object-word-to-var
  [parts : CompilerBackendObjectParts]
  [site : String]
  [dst : i64]
  [src : CompilerIrValue]
  [word-index : i64]) : CompilerBackendObjectParts
  (match src
    [(CompilerIrValue.Var src-var)
      (compiler-backend-object-store-reg-to-var
        (compiler-backend-object-load-group-word-to-reg
          parts
          src-var
          word-index
          "%rax")
        dst
        "%rax")]
    [_ (compiler-backend-object-value-ref parts site src)]))

(define (compiler-backend-object-load-ptr-to-var
  [parts : CompilerBackendObjectParts]
  [site : String]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]) : CompilerBackendObjectParts
  (compiler-backend-object-store-reg-to-var
    (compiler-backend-object-add-nonempty-bytes
      (compiler-backend-object-load-value-to-reg parts site src "%rax")
      (compiler-backend-object-load-rax-pointee-bytes ty))
    dst
    "%rax"))

(define (compiler-backend-object-sub-imm32-rax-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x2d)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-add-imm32-rax-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x05)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-imul-imm32-r8-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x4d)
      (compiler-backend-object-push-u8! (&mut out) 0x69)
      (compiler-backend-object-push-u8! (&mut out) 0xc0)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-add-r8-rax-bytes) : String
  (compiler-backend-object-bytes-from-hex "4c01c0"))

(define (compiler-backend-object-gep-to-var
  [parts : CompilerBackendObjectParts]
  [site : String]
  [dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]) : CompilerBackendObjectParts
  (let
    [elem-size : i64 (compiler-backend-type-size elem-ty)]
    [with-base : CompilerBackendObjectParts
      (compiler-backend-object-load-value-to-reg parts site base "%rax")]
    [with-offset : CompilerBackendObjectParts
      (match offset
        [(CompilerIrValue.I64 n)
          (let
            [disp : i64 (* n elem-size)]
            (if (= disp 0)
              with-base
              (compiler-backend-object-add-nonempty-bytes
                with-base
                (compiler-backend-object-add-imm32-rax-bytes disp))))]
        [_
          (compiler-backend-object-add-nonempty-bytes
            (if (= elem-size 1)
              (compiler-backend-object-load-value-to-reg
                with-base
                site
                offset
                "%r8")
              (compiler-backend-object-add-nonempty-bytes
                (compiler-backend-object-load-value-to-reg
                  with-base
                  site
                  offset
                  "%r8")
                (compiler-backend-object-imul-imm32-r8-bytes elem-size)))
            (compiler-backend-object-add-r8-rax-bytes))])]
    (compiler-backend-object-store-reg-to-var with-offset dst "%rax")))

(define (compiler-backend-object-cmp-imm32-rax-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x3d)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-switch-indirect-jump-bytes) : String
  (compiler-backend-object-bytes-from-hex "49ff24c3"))

(define (compiler-backend-object-switch-entry-label
  [table-label : String]
  [index : i64]) : String
  (string.append
    (string.append table-label "_entry_")
    (string.int->string index)))

(define (compiler-backend-object-switch-table-cases
  [parts : CompilerBackendObjectParts]
  [label-scope : String]
  [table-label : String]
  [cases : CompilerIrSwitchCaseList]
  [index : i64]) : CompilerBackendObjectParts
  (match cases
    [(CompilerIrSwitchCaseList.Nil) parts]
    [(CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(CompilerIrSwitchCase.Case _ label)
          (let
            [entry-label : String
              (compiler-backend-object-switch-entry-label table-label index)]
            [target : String (compiler-backend-asm-label label-scope label)]
            (compiler-backend-object-switch-table-cases
              (compiler-backend-object-add-rodata
                (compiler-backend-object-add-rodata-relocation
                  (compiler-backend-object-add-rodata
                    parts
                    (cobj.CompilerObjectDataRecord.Label entry-label))
                  entry-label
                  (cobj.CompilerObjectRelocationKind.Abs64)
                  target)
                (cobj.CompilerObjectDataRecord.SymbolAddress target))
              label-scope
              table-label
              (box-get rest)
              (+ index 1)))])]
    [(CompilerIrSwitchCaseList.Array seq)
      (compiler-backend-object-switch-table-cases
        parts
        label-scope
        table-label
        (compiler-ir-switch-case-seq-to-list seq)
        index)]))

(define (compiler-backend-object-switch-table
  [parts : CompilerBackendObjectParts]
  [label-scope : String]
  [current-label : String]
  [cases : CompilerIrSwitchCaseList]) : CompilerBackendObjectParts
  (let
    [table-label : String
      (compiler-backend-switch-table-label label-scope current-label)]
    (compiler-backend-object-switch-table-cases
      (compiler-backend-object-add-rodata
        (compiler-backend-object-add-rodata
          (compiler-backend-object-symbol-local-section
            parts
            table-label
            (cobj.CompilerObjectSectionKind.Rodata)
            (cobj.CompilerObjectSymbolKind.Data))
          (cobj.CompilerObjectDataRecord.Align 8))
        (cobj.CompilerObjectDataRecord.Label table-label))
      label-scope
      table-label
      cases
      0)))

(define (compiler-backend-object-switch-dispatch
  [parts : CompilerBackendObjectParts]
  [function-symbol : String]
  [label-scope : String]
  [current-label : String]
  [index : CompilerIrValue]
  [base : i64]
  [case-count : i64]
  [default-label : String]) : CompilerBackendObjectParts
  (let
    [default-symbol : String
      (compiler-backend-asm-label label-scope default-label)]
    [table-label : String
      (compiler-backend-switch-table-label label-scope current-label)]
    [with-index : CompilerBackendObjectParts
      (compiler-backend-object-load-value-to-reg
        parts
        function-symbol
        index
        "%rax")]
    [with-base : CompilerBackendObjectParts
      (if (= base 0)
        with-index
        (compiler-backend-object-add-text
          with-index
          (cobj.CompilerObjectX64Instr.Bytes
            (compiler-backend-object-sub-imm32-rax-bytes base))))]
    [with-cmp : CompilerBackendObjectParts
      (compiler-backend-object-add-text
        with-base
        (cobj.CompilerObjectX64Instr.Bytes
          (compiler-backend-object-cmp-imm32-rax-bytes (- case-count 1))))]
    [with-ja : CompilerBackendObjectParts
      (compiler-backend-object-add-text
        (compiler-backend-object-add-text-relocation
          with-cmp
          function-symbol
          (cobj.CompilerObjectRelocationKind.Branch)
          default-symbol)
        (cobj.CompilerObjectX64Instr.Ja default-symbol))]
    [with-table : CompilerBackendObjectParts
      (compiler-backend-object-add-text
        (compiler-backend-object-add-text-relocation
          with-ja
          function-symbol
          (cobj.CompilerObjectRelocationKind.RipAddress)
          table-label)
        (cobj.CompilerObjectX64Instr.LoadRipAddressR11 table-label))]
    (compiler-backend-object-add-text
      with-table
      (cobj.CompilerObjectX64Instr.Bytes
        (compiler-backend-object-switch-indirect-jump-bytes)))))

(define (compiler-backend-object-switch
  [parts : CompilerBackendObjectParts]
  [function-symbol : String]
  [label-scope : String]
  [current-label : String]
  [index : CompilerIrValue]
  [base : i64]
  [cases : CompilerIrSwitchCaseList]
  [default-label : String]) : CompilerBackendObjectParts
  (compiler-backend-object-switch-dispatch
    (compiler-backend-object-switch-table parts label-scope current-label cases)
    function-symbol
    label-scope
    current-label
    index
    base
    (compiler-backend-switch-case-count cases)
    default-label))

(define (compiler-backend-object-binop-bytes [op : CompilerIrBinOp]) : String
  (match op
    [(CompilerIrBinOp.Add) (compiler-backend-object-bytes-from-hex "4c01c0")]
    [(CompilerIrBinOp.Sub) (compiler-backend-object-bytes-from-hex "4c29c0")]
    [(CompilerIrBinOp.Mul) (compiler-backend-object-bytes-from-hex "490fafc0")]
    [(CompilerIrBinOp.Eq)
      (compiler-backend-object-bytes-from-hex "4c39c00f94c0480fb6c0")]
    [(CompilerIrBinOp.Ne)
      (compiler-backend-object-bytes-from-hex "4c39c00f95c0480fb6c0")]
    [(CompilerIrBinOp.Lt)
      (compiler-backend-object-bytes-from-hex "4c39c00f9cc0480fb6c0")]
    [(CompilerIrBinOp.Le)
      (compiler-backend-object-bytes-from-hex "4c39c00f9ec0480fb6c0")]
    [(CompilerIrBinOp.Gt)
      (compiler-backend-object-bytes-from-hex "4c39c00f9fc0480fb6c0")]
    [(CompilerIrBinOp.Ge)
      (compiler-backend-object-bytes-from-hex "4c39c00f9dc0480fb6c0")]
    [(CompilerIrBinOp.And) (compiler-backend-object-bytes-from-hex "4c21c0")]
    [(CompilerIrBinOp.Or) (compiler-backend-object-bytes-from-hex "4c09c0")]
    [(CompilerIrBinOp.BitAnd) (compiler-backend-object-bytes-from-hex "4c21c0")]
    [(CompilerIrBinOp.BitOr) (compiler-backend-object-bytes-from-hex "4c09c0")]
    [(CompilerIrBinOp.BitXor) (compiler-backend-object-bytes-from-hex "4c31c0")]
    [_ ""]))

(define (compiler-backend-object-binop
  [parts : CompilerBackendObjectParts]
  [site : String]
  [dst : i64]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : CompilerBackendObjectParts
  (let
    [op-bytes : String (compiler-backend-object-binop-bytes op)]
    (if (or
      (= (string.string-length op-bytes) 0)
      (compiler-backend-float-type? ty))
      (compiler-backend-object-value-ref-with-type
        (compiler-backend-object-value-ref-with-type parts site lhs ty)
        site
        rhs
        ty)
      (compiler-backend-object-store-reg-to-var
        (compiler-backend-object-add-nonempty-bytes
          (compiler-backend-object-load-value-to-reg
            (compiler-backend-object-load-value-to-reg parts site lhs "%rax")
            site
            rhs
            "%r8")
          op-bytes)
        dst
        "%rax"))))

(define (compiler-backend-object-call-arg-reg
  [target : CompilerBackendTarget]
  [index : i64]) : String
  (match (compiler-backend-target-arg-reg target index)
    [(ResultBackendReg.Ok reg) reg]
    [(ResultBackendReg.Err _) "%rax"]))

(define (compiler-backend-object-call-reg-count
  [target : CompilerBackendTarget]) : i64
  (compiler-backend-call-register-count target))

(define (compiler-backend-object-call-stack-word-count
  [target : CompilerBackendTarget]
  [args : CompilerIrCallArgs]) : i64
  (let
    [count : i64 (compiler-backend-call-args-count args)]
    [regs : i64 (compiler-backend-object-call-reg-count target)]
    (if (> count regs)
      (- count regs)
      0)))

(define (compiler-backend-object-call-space
  [target : CompilerBackendTarget]
  [args : CompilerIrCallArgs]) : i64
  (match target
    [(CompilerBackendTarget.Linux) 0]
    [(CompilerBackendTarget.Windows)
      (compiler-backend-round-up-16
        (+
          (compiler-backend-outgoing-shadow-space target)
          (* 8 (compiler-backend-object-call-stack-word-count target args))))]))

(define (compiler-backend-object-call-stack-arg
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [site : String]
  [value : CompilerIrValue]
  [stack-index : i64]) : CompilerBackendObjectParts
  (compiler-backend-object-add-nonempty-bytes
    (compiler-backend-object-load-value-to-reg parts site value "%rax")
    (compiler-backend-object-store-rax-rsp-bytes
      (compiler-backend-outgoing-stack-arg-offset target stack-index))))

(define (compiler-backend-object-call-arg-moves
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [site : String]
  [args : CompilerIrCallArgs]
  [index : i64]) : CompilerBackendObjectParts
  (if (>= index (compiler-backend-call-args-count args))
    parts
    (if (>= index (compiler-backend-object-call-reg-count target))
      (match target
        [(CompilerBackendTarget.Linux) parts]
        [(CompilerBackendTarget.Windows)
          (compiler-backend-object-call-arg-moves
            (compiler-backend-object-call-stack-arg
              parts
              target
              site
              (compiler-backend-call-arg-at args index)
              (- index (compiler-backend-object-call-reg-count target)))
            target
            site
            args
            (+ index 1))])
      (compiler-backend-object-call-arg-moves
        (compiler-backend-object-load-value-to-reg
          parts
          site
          (compiler-backend-call-arg-at args index)
          (compiler-backend-object-call-arg-reg target index))
        target
        site
        args
        (+ index 1)))))

(define (compiler-backend-object-direct-call
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [site : String]
  [symbol : String]
  [args : CompilerIrCallArgs]) : CompilerBackendObjectParts
  (let
    [space : i64 (compiler-backend-object-call-space target args)]
    (compiler-backend-object-add-nonempty-bytes
      (compiler-backend-object-add-text
        (compiler-backend-object-add-text-relocation
          (compiler-backend-object-call-arg-moves
            (compiler-backend-object-add-nonempty-bytes
              parts
              (compiler-backend-object-sub-rsp-bytes space))
            target
            site
            args
            0)
          site
          (cobj.CompilerObjectRelocationKind.Call)
          symbol)
        (cobj.CompilerObjectX64Instr.Call symbol))
      (compiler-backend-object-add-rsp-bytes space))))

(define (compiler-backend-object-param-spills
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [params : CompilerIrParamList]
  [int-index : i64]) : CompilerBackendObjectParts
  (match (compiler-ir-param-list-force-cons params)
    [(CompilerIrParamList.Nil) parts]
    [(CompilerIrParamList.Array seq)
      (compiler-backend-object-param-spills
        parts
        target
        (compiler-ir-param-seq-to-list seq)
        int-index)]
    [(CompilerIrParamList.Cons param rest)
      (match param
        [(CompilerIrParam.Param _ ty var-id)
          (if (compiler-backend-float-type? ty)
            (compiler-backend-object-param-spills
              parts
              target
              (box-get rest)
              int-index)
            (if (>= int-index (compiler-backend-object-call-reg-count target))
              (compiler-backend-object-param-spills
                (match target
                  [(CompilerBackendTarget.Linux) parts]
                  [(CompilerBackendTarget.Windows)
                    (compiler-backend-object-store-reg-to-var
                      (compiler-backend-object-add-nonempty-bytes
                        parts
                        (compiler-backend-object-load-rbp-disp-bytes
                          (compiler-backend-incoming-stack-arg-offset
                            target
                            (-
                              int-index
                              (compiler-backend-object-call-reg-count target)))
                          "%rax"))
                      var-id
                      "%rax")])
                target
                (box-get rest)
                (+ int-index 1))
              (compiler-backend-object-param-spills
                (compiler-backend-object-store-reg-to-var
                  parts
                  var-id
                  (compiler-backend-object-call-arg-reg target int-index))
                target
                (box-get rest)
                (+ int-index 1))))])]))

(define (compiler-backend-object-instr
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [function : String]
  [label-scope : String]
  [current-label : String]
  [instr : CompilerIrInstr]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]) : CompilerBackendObjectParts
  (match instr
    [(CompilerIrInstr.Mov dst src ty)
      (if (compiler-backend-copy-group? program-index ty dst src)
        (compiler-backend-object-move-group-value-to-var parts function dst src)
        (compiler-backend-object-move-value-to-var parts function dst src ty))]
    [(CompilerIrInstr.BinOp dst op lhs rhs ty)
      (compiler-backend-object-binop parts function dst op lhs rhs ty)]
    [(CompilerIrInstr.UnOp _ op src ty)
      (let
        [with-src : CompilerBackendObjectParts
          (compiler-backend-object-value-ref-with-type parts function src ty)]
        (match op
          [(CompilerIrUnOp.Neg)
            (if (compiler-backend-f64-type? ty)
              (compiler-backend-object-add-rip-instr
                with-src
                function
                (cobj.CompilerObjectRelocationKind.RipValue)
                (compiler-backend-f64-sign-bit-label)
                (cobj.CompilerObjectX64Instr.XorpdRip
                  (compiler-backend-f64-sign-bit-label)))
              with-src)]
          [_ with-src]))]
    [(CompilerIrInstr.Call dst name args _)
      (let
        [call-target : String
          (compiler-backend-call-symbol-index name plan program-index)]
        (compiler-backend-object-store-reg-to-var
          (compiler-backend-object-direct-call
            parts
            target
            function
            call-target
            args)
          dst
          "%rax"))]
    [(CompilerIrInstr.CallIndirect _ callee args _)
      (compiler-backend-object-call-args
        (compiler-backend-object-value-ref parts function callee)
        function
        args
        0)]
    [(CompilerIrInstr.CallIndirectC _ callee args _)
      (compiler-backend-object-call-args
        (compiler-backend-object-value-ref parts function callee)
        function
        args
        0)]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base name args _)
          (let
            [call-target : String
              (compiler-backend-call-symbol-index name plan program-index)]
            (compiler-backend-object-direct-call
              (compiler-backend-object-value-ref parts function base)
              target
              function
              call-target
              args))])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            callee
            args
            _)
          (compiler-backend-object-call-args
            (compiler-backend-object-value-ref
              (compiler-backend-object-value-ref parts function base)
              function
              callee)
            function
            args
            0)])]
    [(CompilerIrInstr.TailCall name args _)
      (let
        [call-target : String
          (compiler-backend-call-symbol-index name plan program-index)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            (compiler-backend-object-add-nonempty-bytes
              (compiler-backend-object-call-arg-moves
                parts
                target
                function
                args
                0)
              (compiler-backend-object-leave-bytes))
            function
            (cobj.CompilerObjectRelocationKind.TailCall)
            call-target)
          (cobj.CompilerObjectX64Instr.TailCall call-target)))]
    [(CompilerIrInstr.Store name value ty)
      (let
        [symbol : String (compiler-backend-user-symbol name)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            (compiler-backend-object-value-ref-with-type
              parts
              function
              value
              ty)
            function
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.StoreRip symbol)))]
    [(CompilerIrInstr.Jump target)
      (let
        [symbol : String (compiler-backend-asm-label label-scope target)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            parts
            function
            (cobj.CompilerObjectRelocationKind.Branch)
            symbol)
          (cobj.CompilerObjectX64Instr.Jump symbol)))]
    [(CompilerIrInstr.Branch cond true-label false-label)
      (let
        [true-symbol : String
          (compiler-backend-asm-label label-scope true-label)]
        [false-symbol : String
          (compiler-backend-asm-label label-scope false-label)]
        (compiler-backend-object-add-text
          (compiler-backend-object-add-text-relocation
            (compiler-backend-object-add-text-relocation
              (compiler-backend-object-value-ref parts function cond)
              function
              (cobj.CompilerObjectRelocationKind.Branch)
              true-symbol)
            function
            (cobj.CompilerObjectRelocationKind.Branch)
            false-symbol)
          (cobj.CompilerObjectX64Instr.Branch true-symbol false-symbol)))]
    [(CompilerIrInstr.Return value)
      (compiler-backend-object-add-nonempty-bytes
        (match value
          [(CompilerIrMaybeValue.No)
            (if (string.eq function "main")
              (compiler-backend-object-add-nonempty-bytes
                parts
                (compiler-backend-object-zero-eax-bytes))
              parts)]
          [(CompilerIrMaybeValue.Some inner)
            (compiler-backend-object-load-value-to-reg
              parts
              function
              inner
              "%rax")])
        (compiler-backend-object-leave-ret-bytes))]
    [(CompilerIrInstr.Phi _ inputs ty)
      (compiler-backend-object-phi-inputs-with-type parts function inputs ty)]
    [(CompilerIrInstr.Gep dst base offset elem-ty)
      (compiler-backend-object-gep-to-var
        parts
        function
        dst
        base
        offset
        elem-ty)]
    [(CompilerIrInstr.Load dst src ty)
      (compiler-backend-object-load-ptr-to-var parts function dst src ty)]
    [(CompilerIrInstr.StorePtr dst src ty)
      (compiler-backend-object-value-ref-with-type
        (compiler-backend-object-value-ref parts function dst)
        function
        src
        ty)]
    [(CompilerIrInstr.CopyBytes dst src _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function dst)
        function
        src)]
    [(CompilerIrInstr.BoundsCheck index length _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function index)
        function
        length)]
    [(CompilerIrInstr.Cast dst src from-ty _)
      (compiler-backend-object-move-value-to-var parts function dst src from-ty)]
    [(CompilerIrInstr.Bitcast dst src from-ty _)
      (compiler-backend-object-move-value-to-var parts function dst src from-ty)]
    [(CompilerIrInstr.Splat _ value _ elem-ty)
      (compiler-backend-object-value-ref-with-type parts function value elem-ty)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ elem-ty)
          (compiler-backend-object-value-ref-with-type
            (compiler-backend-object-value-ref-with-type
              parts
              function
              lhs
              elem-ty)
            function
            rhs
            elem-ty)])]
    [(CompilerIrInstr.VectorReduce _ _ src _ elem-ty)
      (compiler-backend-object-value-ref-with-type parts function src elem-ty)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ elem-ty)
          (compiler-backend-object-value-ref-with-type
            (compiler-backend-object-value-ref-with-type
              parts
              function
              lhs
              elem-ty)
            function
            rhs
            elem-ty)])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function lhs)
        function
        rhs)]
    [(CompilerIrInstr.MaskNot _ src _)
      (compiler-backend-object-value-ref parts function src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (compiler-backend-object-value-ref parts function src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ ty)
          (compiler-backend-object-value-ref-with-type
            (compiler-backend-object-value-ref-with-type
              (compiler-backend-object-value-ref parts function mask)
              function
              on-true
              ty)
            function
            on-false
            ty)])]
    [(CompilerIrInstr.VectorLoad _ base index _ _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function base)
        function
        index)]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value _ elem-ty)
          (compiler-backend-object-value-ref-with-type
            (compiler-backend-object-value-ref
              (compiler-backend-object-value-ref parts function base)
              function
              index)
            function
            value
            elem-ty)])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            _
            elem-ty)
          (compiler-backend-object-value-ref
            (compiler-backend-object-value-ref-with-type
              (compiler-backend-object-value-ref
                (compiler-backend-object-value-ref parts function base)
                function
                index)
              function
              value
              elem-ty)
            function
            mask)])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base index mask _ _)
          (compiler-backend-object-value-ref
            (compiler-backend-object-value-ref
              (compiler-backend-object-value-ref parts function base)
              function
              index)
            function
            mask)])]
    [(CompilerIrInstr.TailMask _ index length _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function index)
        function
        length)]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (compiler-backend-object-value-ref
        (compiler-backend-object-value-ref parts function leaf)
        function
        subleaf)]
    [(CompilerIrInstr.Xgetbv _ index)
      (compiler-backend-object-value-ref parts function index)]
    [(CompilerIrInstr.Syscall _ args)
      (compiler-backend-object-call-args parts function args 0)]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ active-mask args _)
          (compiler-backend-object-spmd-call-args
            (compiler-backend-object-value-ref parts function active-mask)
            function
            args)])]
    [(CompilerIrInstr.Pack dst words _)
      (compiler-backend-object-pack-to-var parts function dst words)]
    [(CompilerIrInstr.Word dst src index _)
      (compiler-backend-object-word-to-var parts function dst src index)]
    [(CompilerIrInstr.TailCallIndirect callee args _)
      (compiler-backend-object-call-args
        (compiler-backend-object-value-ref parts function callee)
        function
        args
        0)]
    ;; Operand-free instructions and raw address-of emit no object references.
    [(CompilerIrInstr.Alloc _ _) parts]
    [(CompilerIrInstr.AddrOf _ _) parts]
    [(CompilerIrInstr.LaneId _ _ _) parts]
    [(CompilerIrInstr.EntryArgc _) parts]
    [(CompilerIrInstr.EntryArgv _) parts]
    [(CompilerIrInstr.EntryEnvp _) parts]
    [(CompilerIrInstr.Switch index base cases default-label)
      (compiler-backend-object-switch
        parts
        function
        label-scope
        current-label
        index
        base
        cases
        default-label)]))

(define (compiler-backend-object-instr-seq
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [function : String]
  [label-scope : String]
  [current-label : String]
  [instrs : CompilerIrInstrSeq]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [index : i64]) : CompilerBackendObjectParts
  (if (>= index (compiler-ir-instr-seq-count instrs))
    parts
    (compiler-backend-object-instr-seq
      (compiler-backend-object-instr
        parts
        target
        function
        label-scope
        current-label
        (compiler-ir-instr-seq-ref instrs index)
        plan
        program-index)
      target
      function
      label-scope
      current-label
      instrs
      plan
      program-index
      (+ index 1))))

(define (compiler-backend-object-blocks
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [function-symbol : String]
  [label-scope : String]
  [blocks : CompilerIrBlockList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]) : CompilerBackendObjectParts
  (match blocks
    [(CompilerIrBlockList.Nil) parts]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block label instrs)
          (let
            [block-label : String
              (compiler-backend-asm-label label-scope label)]
            (compiler-backend-object-blocks
              (compiler-backend-object-instr-seq
                (compiler-backend-object-add-text
                  (compiler-backend-object-symbol-local-section
                    parts
                    block-label
                    (cobj.CompilerObjectSectionKind.Text)
                    (cobj.CompilerObjectSymbolKind.Function))
                  (cobj.CompilerObjectX64Instr.Label block-label))
                target
                function-symbol
                label-scope
                label
                instrs
                plan
                program-index
                0)
              target
              function-symbol
              label-scope
              (box-get rest)
              plan
              program-index))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-object-block-seq
        parts
        target
        function-symbol
        label-scope
        seq
        plan
        program-index
        0)]))

(define (compiler-backend-object-block-seq
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [function-symbol : String]
  [label-scope : String]
  [blocks : CompilerIrBlockSeq]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [index : i64]) : CompilerBackendObjectParts
  (if (>= index (compiler-ir-block-seq-count blocks))
    parts
    (match (compiler-ir-block-seq-ref blocks index)
      [(CompilerIrBlock.Block label instrs)
        (let
          [block-label : String (compiler-backend-asm-label label-scope label)]
          (compiler-backend-object-block-seq
            (compiler-backend-object-instr-seq
              (compiler-backend-object-add-text
                (compiler-backend-object-symbol-local-section
                  parts
                  block-label
                  (cobj.CompilerObjectSectionKind.Text)
                  (cobj.CompilerObjectSymbolKind.Function))
                (cobj.CompilerObjectX64Instr.Label block-label))
              target
              function-symbol
              label-scope
              label
              instrs
              plan
              program-index
              0)
            target
            function-symbol
            label-scope
            blocks
            plan
            program-index
            (+ index 1)))])))

(define (compiler-backend-object-functions
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [functions : CompilerIrFunctionList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]) : CompilerBackendObjectParts
  (match functions
    [(CompilerIrFunctionList.Nil) parts]
    [(CompilerIrFunctionList.Cons func rest)
      (match func
        [(CompilerIrFunction.Function name params ret-ty vars blocks)
          (let
            [symbol : String
              (compiler-backend-function-symbol-index program-index name)]
            [label-scope : String
              (compiler-backend-function-label-scope program-index name)]
            [types : CompilerRegVarTypes
              (compiler-reg-function-var-types
                (CompilerIrFunction.Function name params ret-ty vars blocks))]
            [groups : CompilerLiveI64Set
              (compiler-reg-function-group-vars
                (CompilerIrFunction.Function name params ret-ty vars blocks)
                (struct-get types entries))]
            [_group-enable : unit
              (begin
                (compiler-backend-current-slot-vars-set! vars)
                (compiler-backend-group-vars-enable!
                  groups
                  (compiler-live-set-empty)))]
            [emitted : CompilerBackendObjectParts
              (compiler-backend-object-blocks
                (compiler-backend-object-param-spills
                  (compiler-backend-object-add-nonempty-bytes
                    (compiler-backend-object-add-text
                      (compiler-backend-object-symbol-export-section
                        parts
                        symbol
                        (cobj.CompilerObjectSectionKind.Text)
                        (cobj.CompilerObjectSymbolKind.Function))
                      (cobj.CompilerObjectX64Instr.Label symbol))
                    (compiler-backend-object-prologue-bytes
                      (compiler-backend-frame-size
                        (if (> (compiler-live-set-count groups) 0)
                          (* vars 2)
                          vars))))
                  target
                  params
                  0)
                target
                symbol
                label-scope
                blocks
                plan
                program-index)]
            [_group-disable : unit (compiler-backend-group-vars-disable!)]
            (compiler-backend-object-functions
              emitted
              target
              (box-get rest)
              plan
              program-index))])]
    [(CompilerIrFunctionList.Array seq)
      (compiler-backend-object-function-seq
        parts
        target
        seq
        plan
        program-index
        0)]))

(define (compiler-backend-object-function-seq
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [functions : CompilerIrFunctionSeq]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [index : i64]) : CompilerBackendObjectParts
  (if (>= index (compiler-ir-function-seq-count functions))
    parts
    (match (compiler-ir-function-seq-ref functions index)
      [(CompilerIrFunction.Function name params ret-ty vars blocks)
        (let
          [symbol : String
            (compiler-backend-function-symbol-index program-index name)]
          [label-scope : String
            (compiler-backend-function-label-scope program-index name)]
          [types : CompilerRegVarTypes
            (compiler-reg-function-var-types
              (CompilerIrFunction.Function name params ret-ty vars blocks))]
          [groups : CompilerLiveI64Set
            (compiler-reg-function-group-vars
              (CompilerIrFunction.Function name params ret-ty vars blocks)
              (struct-get types entries))]
          [_group-enable : unit
            (begin
              (compiler-backend-current-slot-vars-set! vars)
              (compiler-backend-group-vars-enable!
                groups
                (compiler-live-set-empty)))]
          [emitted : CompilerBackendObjectParts
            (compiler-backend-object-blocks
              (compiler-backend-object-param-spills
                (compiler-backend-object-add-nonempty-bytes
                  (compiler-backend-object-add-text
                    (compiler-backend-object-symbol-export-section
                      parts
                      symbol
                      (cobj.CompilerObjectSectionKind.Text)
                      (cobj.CompilerObjectSymbolKind.Function))
                    (cobj.CompilerObjectX64Instr.Label symbol))
                  (compiler-backend-object-prologue-bytes
                    (compiler-backend-frame-size
                      (if (> (compiler-live-set-count groups) 0)
                        (* vars 2)
                        vars))))
                target
                params
                0)
              target
              symbol
              label-scope
              blocks
              plan
              program-index)]
          [_group-disable : unit (compiler-backend-group-vars-disable!)]
          (compiler-backend-object-function-seq
            emitted
            target
            functions
            plan
            program-index
            (+ index 1)))])))

(define (compiler-backend-object-global-value
  [parts : CompilerBackendObjectParts]
  [site : String]
  [ty : AstType]
  [value : CompilerIrValue]) : CompilerBackendObjectParts
  (match value
    [(CompilerIrValue.I64 n)
      (compiler-backend-object-add-data
        parts
        (cobj.CompilerObjectDataRecord.I64 n))]
    [(CompilerIrValue.Bool b)
      (compiler-backend-object-add-data
        parts
        (cobj.CompilerObjectDataRecord.I64
          (if b
            1
            0)))]
    [(CompilerIrValue.Char c)
      (compiler-backend-object-add-data
        parts
        (cobj.CompilerObjectDataRecord.I64 (compiler-backend-char-code c)))]
    [(CompilerIrValue.Unit)
      (compiler-backend-object-add-data
        parts
        (cobj.CompilerObjectDataRecord.I64 0))]
    [(CompilerIrValue.F64 bits)
      (compiler-backend-object-add-data
        parts
        (compiler-backend-float-object-data ty bits))]
    [(CompilerIrValue.String text)
      (let
        [symbol : String (compiler-backend-string-fat-label text)]
        (compiler-backend-object-add-data
          (compiler-backend-object-add-data-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.Abs64)
            symbol)
          (cobj.CompilerObjectDataRecord.SymbolAddress symbol)))]
    [(CompilerIrValue.Bytes text)
      (let
        [symbol : String (compiler-backend-bytes-fat-label text)]
        (compiler-backend-object-add-data
          (compiler-backend-object-add-data-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.Abs64)
            symbol)
          (cobj.CompilerObjectDataRecord.SymbolAddress symbol)))]
    [(CompilerIrValue.Global name)
      (let
        [symbol : String (compiler-backend-user-symbol name)]
        (compiler-backend-object-add-data
          (compiler-backend-object-add-data-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.Abs64)
            symbol)
          (cobj.CompilerObjectDataRecord.SymbolAddress symbol)))]
    [(CompilerIrValue.GlobalAddr name)
      (let
        [symbol : String (compiler-backend-user-symbol name)]
        (compiler-backend-object-add-data
          (compiler-backend-object-add-data-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.Abs64)
            symbol)
          (cobj.CompilerObjectDataRecord.SymbolAddress symbol)))]
    [(CompilerIrValue.Function name)
      (let
        [symbol : String (compiler-backend-closure-descriptor-label name)]
        (compiler-backend-object-add-data
          (compiler-backend-object-add-data-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.Abs64)
            symbol)
          (cobj.CompilerObjectDataRecord.SymbolAddress symbol)))]
    [_ parts]))

(define (compiler-backend-object-globals
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [globals : CompilerIrGlobalList]) : CompilerBackendObjectParts
  (match globals
    [(CompilerIrGlobalList.Nil) parts]
    [(CompilerIrGlobalList.Cons global rest)
      (match global
        [(CompilerIrGlobal.Global name ty value)
          (let
            [symbol : String (compiler-backend-user-symbol name)]
            (compiler-backend-object-globals
              (if (compiler-backend-runtime-global? ty value)
                (compiler-backend-object-add-bss
                  (compiler-backend-object-add-bss
                    (compiler-backend-object-symbol-export-section
                      parts
                      symbol
                      (cobj.CompilerObjectSectionKind.Bss)
                      (cobj.CompilerObjectSymbolKind.Data))
                    (cobj.CompilerObjectDataRecord.Label symbol))
                  (cobj.CompilerObjectDataRecord.Zero 8))
                (compiler-backend-object-global-value
                  (compiler-backend-object-add-data
                    (compiler-backend-object-symbol-export-section
                      parts
                      symbol
                      (cobj.CompilerObjectSectionKind.Data)
                      (cobj.CompilerObjectSymbolKind.Data))
                    (cobj.CompilerObjectDataRecord.Label symbol))
                  symbol
                  ty
                  value))
              target
              (box-get rest)))])]
    [(CompilerIrGlobalList.Array seq)
      (compiler-backend-object-globals
        parts
        target
        (compiler-ir-global-seq-to-list seq))]))

(define (compiler-backend-object-strings
  [parts : CompilerBackendObjectParts]
  [strings : BackendStringList]) : CompilerBackendObjectParts
  (match strings
    [(BackendStringList.Nil) parts]
    [(BackendStringList.Cons text rest)
      (let
        [data-symbol : String (compiler-backend-string-data-label text)]
        [fat-symbol : String (compiler-backend-string-fat-label text)]
        (compiler-backend-object-strings
          (compiler-backend-object-add-rodata
            (compiler-backend-object-add-rodata
              (compiler-backend-object-add-rodata
                (compiler-backend-object-add-rodata-relocation
                  (compiler-backend-object-add-rodata
                    (compiler-backend-object-symbol-local-section
                      (compiler-backend-object-add-rodata
                        (compiler-backend-object-add-rodata
                          (compiler-backend-object-symbol-local-section
                            parts
                            data-symbol
                            (cobj.CompilerObjectSectionKind.Rodata)
                            (cobj.CompilerObjectSymbolKind.Data))
                          (cobj.CompilerObjectDataRecord.Label data-symbol))
                        (cobj.CompilerObjectDataRecord.String text))
                      fat-symbol
                      (cobj.CompilerObjectSectionKind.Rodata)
                      (cobj.CompilerObjectSymbolKind.Data))
                    (cobj.CompilerObjectDataRecord.Align 8))
                  fat-symbol
                  (cobj.CompilerObjectRelocationKind.Abs64)
                  data-symbol)
                (cobj.CompilerObjectDataRecord.Label fat-symbol))
              (cobj.CompilerObjectDataRecord.SymbolAddress data-symbol))
            (cobj.CompilerObjectDataRecord.I64 (string.string-length text)))
          (box-get rest)))]))

(define (compiler-backend-object-bytes
  [parts : CompilerBackendObjectParts]
  [items : BackendStringList]) : CompilerBackendObjectParts
  (match items
    [(BackendStringList.Nil) parts]
    [(BackendStringList.Cons bytes rest)
      (let
        [data-symbol : String (compiler-backend-bytes-data-label bytes)]
        [fat-symbol : String (compiler-backend-bytes-fat-label bytes)]
        (compiler-backend-object-bytes
          (compiler-backend-object-add-data
            (compiler-backend-object-add-data
              (compiler-backend-object-add-data
                (compiler-backend-object-add-data
                  (compiler-backend-object-add-data-relocation
                    (compiler-backend-object-add-data
                      (compiler-backend-object-add-data
                        (compiler-backend-object-add-data
                          (compiler-backend-object-symbol-local-section
                            (compiler-backend-object-symbol-local-section
                              parts
                              data-symbol
                              (cobj.CompilerObjectSectionKind.Data)
                              (cobj.CompilerObjectSymbolKind.Data))
                            fat-symbol
                            (cobj.CompilerObjectSectionKind.Data)
                            (cobj.CompilerObjectSymbolKind.Data))
                          (cobj.CompilerObjectDataRecord.Align 8))
                        (cobj.CompilerObjectDataRecord.Label data-symbol))
                      (if (= (string.string-length bytes) 0)
                        (cobj.CompilerObjectDataRecord.Zero 1)
                        (cobj.CompilerObjectDataRecord.Bytes bytes)))
                    fat-symbol
                    (cobj.CompilerObjectRelocationKind.Abs64)
                    data-symbol)
                  (cobj.CompilerObjectDataRecord.Align 8))
                (cobj.CompilerObjectDataRecord.Label fat-symbol))
              (cobj.CompilerObjectDataRecord.SymbolAddress data-symbol))
            (cobj.CompilerObjectDataRecord.I64 (string.string-length bytes)))
          (box-get rest)))]))

(define (compiler-backend-object-floats
  [parts : CompilerBackendObjectParts]
  [floats : BackendFloatList]) : CompilerBackendObjectParts
  (match floats
    [(BackendFloatList.Nil) parts]
    [(BackendFloatList.Cons ty bits rest)
      (let
        [symbol : String (compiler-backend-float-label ty bits)]
        (compiler-backend-object-floats
          (compiler-backend-object-add-rodata
            (compiler-backend-object-add-rodata
              (compiler-backend-object-add-rodata
                (compiler-backend-object-symbol-local-section
                  parts
                  symbol
                  (cobj.CompilerObjectSectionKind.Rodata)
                  (cobj.CompilerObjectSymbolKind.Data))
                (cobj.CompilerObjectDataRecord.Align
                  (if (compiler-backend-f64-type? ty)
                    8
                    4)))
              (cobj.CompilerObjectDataRecord.Label symbol))
            (compiler-backend-float-object-data ty bits))
          (box-get rest)))]))

(define (compiler-backend-object-f64-sign-bit
  [parts : CompilerBackendObjectParts]
  [enabled : bool]) : CompilerBackendObjectParts
  (if enabled
    (let
      [symbol : String (compiler-backend-f64-sign-bit-label)]
      (compiler-backend-object-add-rodata
        (compiler-backend-object-add-rodata
          (compiler-backend-object-add-rodata
            (compiler-backend-object-add-rodata
              (compiler-backend-object-symbol-local-section
                parts
                symbol
                (cobj.CompilerObjectSectionKind.Rodata)
                (cobj.CompilerObjectSymbolKind.Data))
              (cobj.CompilerObjectDataRecord.Align 16))
            (cobj.CompilerObjectDataRecord.Label symbol))
          (cobj.CompilerObjectDataRecord.I64 -9223372036854775808))
        (cobj.CompilerObjectDataRecord.I64 0)))
    parts))

(define (compiler-backend-object-closure-descriptors
  [parts : CompilerBackendObjectParts]
  [names : BackendStringList]
  [program-index : CompilerBackendProgramIndex]) : CompilerBackendObjectParts
  (match names
    [(BackendStringList.Nil) parts]
    [(BackendStringList.Cons name rest)
      (let
        [descriptor : String (compiler-backend-closure-descriptor-label name)]
        [entry : String (compiler-backend-closure-entry-label name)]
        (compiler-backend-object-closure-descriptors
          (match (compiler-backend-index-signature program-index name)
            [(CompilerBackendMaybeSignature.Some _ _)
              (compiler-backend-object-add-rodata
                (compiler-backend-object-add-rodata
                  (compiler-backend-object-add-rodata-relocation
                    (compiler-backend-object-add-rodata
                      (compiler-backend-object-add-rodata
                        (compiler-backend-object-symbol-local-section
                          (compiler-backend-object-symbol-local-section
                            parts
                            descriptor
                            (cobj.CompilerObjectSectionKind.Rodata)
                            (cobj.CompilerObjectSymbolKind.Data))
                          entry
                          (cobj.CompilerObjectSectionKind.Text)
                          (cobj.CompilerObjectSymbolKind.Function))
                        (cobj.CompilerObjectDataRecord.Align 8))
                      (cobj.CompilerObjectDataRecord.Label descriptor))
                    descriptor
                    (cobj.CompilerObjectRelocationKind.Abs64)
                    entry)
                  (cobj.CompilerObjectDataRecord.SymbolAddress entry))
                (cobj.CompilerObjectDataRecord.I64 0))]
            [(CompilerBackendMaybeSignature.No) parts])
          (box-get rest)
          program-index))]))

(define (compiler-backend-object-externs
  [parts : CompilerBackendObjectParts]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [runtime-index : CompilerBackendRuntimeIndex]
  [referenced-functions : BackendStringList]) : CompilerBackendObjectParts
  (match externs
    [(CompilerIrExternList.Nil) parts]
    [(CompilerIrExternList.Cons item rest)
      (match item
        [(CompilerIrExtern.Extern name _ _ link-symbol _ provided)
          (compiler-backend-object-externs
            (if (and
              (not
                (compiler-backend-object-runtime-symbol-provided?
                  plan
                  link-symbol))
              (compiler-backend-emits-extern-symbol?
                name
                link-symbol
                provided
                plan)
              (compiler-backend-extern-symbol-referenced?
                runtime-index
                referenced-functions
                name
                link-symbol))
              (compiler-backend-object-symbol-extern
                parts
                (compiler-backend-link-symbol link-symbol plan)
                (cobj.CompilerObjectSymbolKind.Function))
              parts)
            (box-get rest)
            plan
            runtime-index
            referenced-functions)])]
    [(CompilerIrExternList.Array seq)
      (compiler-backend-object-externs
        parts
        (compiler-ir-extern-seq-to-list seq)
        plan
        runtime-index
        referenced-functions)]))

(define (compiler-backend-object-runtime-symbols-list) : BackendStringList
  (let
    [symbols : BackendStringList BackendStringList.Nil]
    (begin
      (set!
        symbols
        (compiler-backend-string-cons "tl_tlci_call_image_entry" symbols))
      (set!
        symbols
        (compiler-backend-string-cons "tl_tlci_call_macro_entry" symbols))
      (set! symbols (compiler-backend-string-cons "tl_memchr" symbols))
      (set! symbols (compiler-backend-string-cons "tl_memcpy" symbols))
      (set! symbols (compiler-backend-string-cons "tl_shift_abort" symbols))
      (set! symbols (compiler-backend-string-cons "tl_div_abort" symbols))
      (set! symbols (compiler-backend-string-cons "tl_region_reset" symbols))
      (set! symbols (compiler-backend-string-cons "tl_region_mark" symbols))
      (set!
        symbols
        (compiler-backend-string-cons "tl_arena_make_atomic" symbols))
      (set! symbols (compiler-backend-string-cons "tl_arena_set" symbols))
      (set! symbols (compiler-backend-string-cons "tl_arena_current" symbols))
      (set! symbols (compiler-backend-string-cons "tl_alloc" symbols))
      symbols)))

(define (compiler-backend-object-runtime-symbol-provided?
  [plan : CompilerBackendRuntimePlan]
  [name : String]) : bool
  (or
    (compiler-backend-plan-provides? plan name)
    (string.eq name "tl_alloc")
    (string.eq name "tl_memcpy")
    (string.eq name "tl_memchr")
    (string.eq name "tl_tlci_call_image_entry")))

(define (compiler-backend-object-runtime-symbols
  [parts : CompilerBackendObjectParts]
  [plan : CompilerBackendRuntimePlan]
  [names : BackendStringList]) : CompilerBackendObjectParts
  (match names
    [(BackendStringList.Nil) parts]
    [(BackendStringList.Cons name rest)
      (compiler-backend-object-runtime-symbols
        (if (compiler-backend-object-runtime-symbol-provided? plan name)
          (compiler-backend-object-symbol-local-section
            parts
            name
            (cobj.CompilerObjectSectionKind.Text)
            (cobj.CompilerObjectSymbolKind.Runtime))
          parts)
        plan
        (box-get rest))]))

(define (compiler-backend-object-hex-value [c : char]) : i64
  (cond
    [(and (>= c '0') (<= c '9')) (- (cast c : i64) (cast '0' : i64))]
    [(and (>= c 'a') (<= c 'f')) (+ 10 (- (cast c : i64) (cast 'a' : i64)))]
    [(and (>= c 'A') (<= c 'F')) (+ 10 (- (cast c : i64) (cast 'A' : i64)))]
    [else 0]))

(define (compiler-backend-object-bytes-from-hex [hex : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [i : i64 0]
    [n : i64 (string.string-length hex)]
    (begin
      (while (< (+ i 1) n)
        (let
          [hi : i64
            (compiler-backend-object-hex-value (string.string-ref hex i))]
          [lo : i64
            (compiler-backend-object-hex-value (string.string-ref hex (+ i 1)))]
          (begin
            (byte_buf_core.byte-buf-builder-push
              (&mut out)
              (cast (+ (* hi 16) lo) : u8))
            (set! i (+ i 2)))))
      (byte_buf_core.byte-buf-builder-finish-string (& out)))))

