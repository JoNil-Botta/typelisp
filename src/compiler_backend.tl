(define (compiler-backend-tail-call-return-normalize
  [type-segment-bases : i64]
  [ty : compiler_ast_types.AstType]) : String
  (if (= (compiler-backend-type-size type-segment-bases ty) 0)
    "    movq $0, %rax\n"
    ""))

(define (compiler-backend-instr-return-count
  [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Return _) 1]
    [_ 0]))

(define (compiler-backend-instr-seq-return-count
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [out : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (+
              out
              (compiler-backend-instr-return-count (array-ref slots index))))
          (set! index (+ index 1))))
      out)))

(define (compiler-backend-shared-return-block-count
  [backend-state : CompilerBackendState]
  [label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : i64
  ;; Bare shrink-wrap exits return before the frame exists and never target the
  ;; framed epilogue. Excluding them keeps a function with one ordinary framed
  ;; return on the inline-epilogue path instead of adding a useless jump merely
  ;; because the entry return was cloned.
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [bare-label : String
      (compiler-backend-function-state-string
        function-state
        compiler-backend-function-string-shrinkwrap-bare-label)]
    (if (and
      (not (string.eq bare-label ""))
      (compiler-backend-string-prefix-at?
        (compiler_ir_types.compiler-ir-label-text label)
        bare-label
        0))
      0
      (compiler-backend-instr-seq-return-count instrs))))

(define (compiler-backend-block-list-return-count
  [backend-state : CompilerBackendState]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block label instrs)
          (+
            (compiler-backend-shared-return-block-count
              backend-state
              label
              instrs)
            (compiler-backend-block-list-return-count
              backend-state
              (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-block-seq-return-count backend-state seq 0)]))

(define (compiler-backend-block-seq-return-count
  [backend-state : CompilerBackendState]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    0
    (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
      [(compiler_ir_types.CompilerIrBlock.Block label instrs)
        (+
          (compiler-backend-shared-return-block-count
            backend-state
            label
            instrs)
          (compiler-backend-block-seq-return-count
            backend-state
            blocks
            (+ index 1)))])))

;; The shared-return tail is only reachable for plans that save callee
;; registers, so plans without them (every stack-only opt0/opt1 plan) skip
;; the whole-function return walk; the count is only consumed through
;; use-shared-return-count?, where 0 and the true count decide identically
;; once the callee-regs conjunct is false.
(define (compiler-backend-shared-return-count
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (if (compiler-backend-plan-uses-callee-regs? assignments backend-state)
    (compiler-backend-block-list-return-count backend-state blocks)
    0))

(define (compiler-backend-use-shared-return?
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (compiler-backend-use-shared-return-count?
    backend-state
    assignments
    (compiler-backend-shared-return-count backend-state assignments blocks)))

(define (compiler-backend-use-shared-return-count?
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [return-count : i64]) : bool
  (and
    (compiler-backend-plan-uses-callee-regs? assignments backend-state)
    (> return-count 1)))

(define (compiler-backend-return-tail-for-return-count
  [backend-state : CompilerBackendState]
  [source-function : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [return-count : i64]) : String
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [bare-label : String
      (compiler-backend-function-state-string
        function-state
        compiler-backend-function-string-shrinkwrap-bare-label)]
    (if (and
      (not (string.eq bare-label ""))
      (compiler-backend-string-prefix-at?
        (compiler_ir_types.compiler-ir-label-text
          (compiler-backend-function-state-i64
            function-state
            compiler-backend-function-i64-current-block-label))
        bare-label
        0))
      "    ret\n"
      (if (compiler-backend-use-shared-return-count?
        backend-state
        assignments
        return-count)
        (str_cat.str-cat
          "    jmp "
          (compiler-backend-return-label backend-state source-function)
          "\n"
          "")
        (compiler-backend-inline-return-tail assignments vars backend-state)))))

(define (compiler-backend-return-tail
  [backend-state : CompilerBackendState]
  [source-function : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : String
  (compiler-backend-return-tail-for-return-count
    backend-state
    source-function
    assignments
    vars
    (compiler-backend-shared-return-count backend-state assignments blocks)))

(define (compiler-backend-return-epilogue
  [backend-state : CompilerBackendState]
  [source-function : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : String
  (if (compiler-backend-use-shared-return? backend-state assignments blocks)
    (str_cat.str-cat
      (compiler-backend-return-label backend-state source-function)
      ":\n"
      (compiler-backend-inline-return-tail assignments vars backend-state)
      "")
    ""))

(define (compiler-backend-spmd-symbol-prefix?
  [backend-state : CompilerBackendState]
  [name : i64]
  [prefix : String]) : bool
  (compiler-backend-string-prefix-at?
    (compiler-backend-symbol-text-state backend-state name)
    prefix
    0))

(define (compiler-backend-spmd-varying-return-function?
  [backend-state : CompilerBackendState]
  [name : i64]) : bool
  (compiler-backend-spmd-symbol-prefix?
    backend-state
    name
    "__tl_spmd_ret_varying_"))

(define (compiler-backend-spmd-mask-return-function?
  [backend-state : CompilerBackendState]
  [name : i64]) : bool
  (compiler-backend-spmd-symbol-prefix?
    backend-state
    name
    "__tl_spmd_ret_mask_"))

(define (compiler-backend-emit-spmd-private-return-value
  [backend-state : CompilerBackendState]
  [source-function : i64]
  [value : compiler_ir_types.CompilerIrValue]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [ret-ty : compiler_ast_types.AstType]) : ResultCompilerBackend
  (if (compiler-backend-current-mode-avx2?
    (compiler-backend-state-function-state backend-state))
    (let
      [elem-ty : compiler_ast_types.AstType
        (if (compiler-backend-spmd-mask-return-function?
          backend-state
          source-function)
          (compiler_ast_types.AstType.I8)
          ret-ty)]
      (match (compiler-backend-vector-register-use
        assignments
        value
        "private AVX2 SPMD return value"
        "ymm"
        elem-ty
        "%ymm14"
        backend-state)
        [(ResultBackendVectorUse.Ok use)
          (match use
            [(CompilerBackendVectorUse.Use load-asm reg)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  load-asm
                  (if (string.eq reg "%ymm0")
                    ""
                    (str_cat.str-cat "    vmovdqu " reg ", %ymm0\n"))
                  ""))])]
        [(ResultBackendVectorUse.Err message)
          (ResultCompilerBackend.Err
            (box (compiler_diagnostic.compiler-diagnostic-at-start "" message)))]))
    (if (compiler-backend-spmd-mask-return-function?
      backend-state
      source-function)
      (match (compiler-backend-avx512-mask-register-use
        assignments
        value
        "private SPMD return value"
        64
        "%k7"
        backend-state)
        [(ResultBackendMaskUse.Ok use)
          (match use
            [(CompilerBackendMaskUse.Use load-asm reg)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  load-asm
                  (if (string.eq reg "%k1")
                    ""
                    (str_cat.str-cat "    kmovq " reg ", %k1\n" ""))
                  ""))])]
        [(ResultBackendMaskUse.Err message)
          (ResultCompilerBackend.Err
            (box (compiler_diagnostic.compiler-diagnostic-at-start "" message)))])
      (match (compiler-backend-vector-register-use
        assignments
        value
        "private SPMD return value"
        "zmm"
        ret-ty
        "%zmm14"
        backend-state)
        [(ResultBackendVectorUse.Ok use)
          (match use
            [(CompilerBackendVectorUse.Use load-asm reg)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  load-asm
                  (if (string.eq reg "%zmm16")
                    ""
                    (str_cat.str-cat
                      "    "
                      (compiler-backend-avx512-vector-move ret-ty)
                      " "
                      reg
                      ", %zmm16\n"))
                  ""))])]
        [(ResultBackendVectorUse.Err message)
          (ResultCompilerBackend.Err
            (box (compiler_diagnostic.compiler-diagnostic-at-start "" message)))]))))

(define (compiler-backend-emit-return-with-return-count
  [type-segment-bases : i64]
  [source-function : i64]
  [return-count : i64]
  [value : compiler_ir_types.CompilerIrMaybeValue]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [ret-ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (match value
    [(compiler_ir_types.CompilerIrMaybeValue.No)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          (if (=
            (compiler_ir_types.compiler-ir-symbol-id source-function)
            cbi.compiler-builtin-id-fix-main)
            "    xorl %eax, %eax\n"
            "")
          (compiler-backend-return-tail-for-return-count
            program-index.backend-state
            source-function
            assignments
            vars
            return-count)))]
    [(compiler_ir_types.CompilerIrMaybeValue.Some v)
      ;; A register-group return goes in %rax:%rdx (word0:word1).
      (if (or
        (compiler-backend-spmd-varying-return-function?
          program-index.backend-state
          source-function)
        (compiler-backend-spmd-mask-return-function?
          program-index.backend-state
          source-function))
        (match (compiler-backend-emit-spmd-private-return-value
          program-index.backend-state
          source-function
          v
          assignments
          ret-ty)
          [(ResultCompilerBackend.Ok load)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                load
                (compiler-backend-return-tail-for-return-count
                  program-index.backend-state
                  source-function
                  assignments
                  vars
                  return-count)))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])
        (if (compiler-backend-group-type?
          type-segment-bases
          program-index
          ret-ty)
          (match (compiler-backend-emit-group-load
            type-segment-bases
            assignments
            v
            (compiler-backend-group-return-reg
              type-segment-bases
              program-index
              ret-ty
              0)
            (compiler-backend-group-return-reg
              type-segment-bases
              program-index
              ret-ty
              1)
            vars
            ret-ty
            program-index
            program-index.backend-state)
            [(ResultCompilerBackend.Ok load)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  load
                  (compiler-backend-return-tail-for-return-count
                    program-index.backend-state
                    source-function
                    assignments
                    vars
                    return-count)))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)])
          (match (compiler-backend-emit-load-typed-value-with-plan
            type-segment-bases
            assignments
            v
            ret-ty
            program-index
            program-index.backend-state)
            [(ResultCompilerBackend.Ok load)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  load
                  (compiler-backend-return-tail-for-return-count
                    program-index.backend-state
                    source-function
                    assignments
                    vars
                    return-count)))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)])))]))

(define (compiler-backend-emit-return
  [type-segment-bases : i64]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [value : compiler_ir_types.CompilerIrMaybeValue]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [ret-ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (compiler-backend-emit-return-with-return-count
    type-segment-bases
    source-function
    (compiler-backend-shared-return-count
      program-index.backend-state
      assignments
      blocks)
    value
    assignments
    vars
    ret-ty
    program-index))

(define (compiler-backend-emit-tail-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [name : i64]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-stage : String]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [vars : i64]
  [plan : CompilerBackendRuntimePlan]
  [_functions : compiler_ir_types.CompilerIrFunctionList]
  [_externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [extern-call-info : i64
      (compiler-backend-index-extern-call-info program-index name)]
    [param-types : compiler_ast_types.AstTypeList
      (compiler-backend-call-param-types-for-call
        type-segment-bases
        name
        args
        types
        global-types
        extern-call-info
        program-index)]
    [c-abi? : bool
      (compiler-backend-extern-call-info-aggregate-params? extern-call-info)]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        c-abi?
        program-index)]
    [tail-stack-count : i64
      (compiler-backend-call-stack-arg-count
        type-segment-bases
        target
        args
        param-types
        c-abi?
        0
        0
        0
        0
        0
        program-index)]
    [target-symbol : String
      (compiler-backend-call-symbol-index name plan program-index)]
    [return-normalize : String
      (compiler-backend-tail-call-return-normalize type-segment-bases ty)]
    [varargs-pre-call : String
      (compiler-backend-varargs-pre-call
        type-segment-bases
        target
        extern-call-info
        param-types)]
    (if (compiler-backend-direct-tail-call?
      type-segment-bases
      target
      source-function
      name
      args
      param-types
      program-index)
      (match (if (compiler-backend-function-state-bool?
        (compiler-backend-state-function-state backend-state)
        compiler-backend-function-bool-identity-tail-forwarder-active)
        (ResultCompilerBackend.Ok "")
        (if (= tail-stack-count 0)
          (compiler-backend-emit-call-args
            type-segment-bases
            target
            assignments
            args
            param-types
            c-abi?
            0
            0
            0
            0
            0
            planned-stage
            instr-diag
            program-index
            vars
            backend-state)
          (compiler-backend-emit-direct-tail-call-args
            type-segment-bases
            target
            assignments
            args
            param-types
            planned-stage
            instr-diag
            backend-state)))
        [(ResultCompilerBackend.Ok args-asm)
          (ResultCompilerBackend.Ok
            (str_cat.str-cat
              args-asm
              (compiler-backend-tail-jump-tail
                assignments
                vars
                target-symbol
                backend-state)))]
        [(ResultCompilerBackend.Err message)
          (ResultCompilerBackend.Err message)])
      (match (compiler-backend-emit-call-args
        type-segment-bases
        target
        assignments
        args
        param-types
        c-abi?
        0
        0
        0
        0
        0
        planned-stage
        instr-diag
        program-index
        vars
        backend-state)
        [(ResultCompilerBackend.Ok args-asm)
          (if (and
            (= call-space 0)
            (= tail-stack-count 0)
            (string.eq return-normalize ""))
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                args-asm
                varargs-pre-call
                (compiler-backend-tail-jump-tail
                  assignments
                  vars
                  target-symbol
                  backend-state)))
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (compiler-backend-emit-call-space-sub call-space)
                args-asm
                varargs-pre-call
                (str_cat.str-cat
                  "    call "
                  target-symbol
                  "\n"
                  (str_cat.str-cat
                    (compiler-backend-emit-call-space-add call-space)
                    return-normalize
                    (compiler-backend-return-tail
                      program-index.backend-state
                      source-function
                      assignments
                      vars
                      blocks))
                  ""))))]
        [(ResultCompilerBackend.Err message)
          (ResultCompilerBackend.Err message)]))))

(define (compiler-backend-trivial-phi-return-find
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [from-label : i64]
  [returned-dst : i64]
  [index : i64]
  [last-index : i64]
  [found : CompilerBackendPhiReturnMatch]) : ResultBackendPhiReturnMatch
  (if (>= index last-index)
    (ResultBackendPhiReturnMatch.Ok found)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Phi dst inputs _)
        (match (compiler-backend-phi-input-value inputs from-label)
          [(ResultBackendValue.Ok incoming)
            (compiler-backend-trivial-phi-return-find
              instrs
              from-label
              returned-dst
              (+ index 1)
              last-index
              (if (= dst returned-dst)
                (CompilerBackendPhiReturnMatch.Some incoming)
                found))]
          [(ResultBackendValue.Err message)
            (ResultBackendPhiReturnMatch.Err message)])]
      [_ (ResultBackendPhiReturnMatch.Ok (CompilerBackendPhiReturnMatch.No))])))

(define (compiler-backend-emit-trivial-phi-return-edge-instrs
  [type-segment-bases : i64]
  [source-function : i64]
  [return-count : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [from-label : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [ret-ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (if (< (compiler_ir_types.compiler-ir-instr-seq-count instrs) 2)
    (ResultCompilerBackend.Ok "")
    (let
      [last-index : i64
        (- (compiler_ir_types.compiler-ir-instr-seq-count instrs) 1)]
      [last : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs last-index)]
      (match last
        [(compiler_ir_types.CompilerIrInstr.Return maybe)
          (match maybe
            [(compiler_ir_types.CompilerIrMaybeValue.Some value)
              (match value
                [(compiler_ir_types.CompilerIrValue.Var returned-dst)
                  (match (compiler-backend-trivial-phi-return-find
                    instrs
                    from-label
                    returned-dst
                    0
                    last-index
                    (CompilerBackendPhiReturnMatch.No))
                    [(ResultBackendPhiReturnMatch.Ok found)
                      (match found
                        [(CompilerBackendPhiReturnMatch.Some incoming)
                          ;; The real program-index must reach emit-return here:
                          ;; an empty index makes the register-group return check
                          ;; always false, so a 16-byte group return would load
                          ;; only word0 (word1-drop miscompile).
                          (compiler-backend-emit-return-with-return-count
                            type-segment-bases
                            source-function
                            return-count
                            (compiler_ir_types.CompilerIrMaybeValue.Some
                              incoming)
                            assignments
                            vars
                            ret-ty
                            program-index)]
                        [(CompilerBackendPhiReturnMatch.No)
                          (ResultCompilerBackend.Ok "")])]
                    [(ResultBackendPhiReturnMatch.Err message)
                      (ResultCompilerBackend.Err
                        (box
                          (compiler_diagnostic.compiler-diagnostic-at-start
                            ""
                            message)))])]
                [_ (ResultCompilerBackend.Ok "")])]
            [(compiler_ir_types.CompilerIrMaybeValue.No)
              (ResultCompilerBackend.Ok "")])]
        [_ (ResultCompilerBackend.Ok "")]))))

(define (compiler-backend-emit-trivial-phi-return-edge
  [type-segment-bases : i64]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [target-label : i64]
  [from-label : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [ret-ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (ResultCompilerBackend.Ok "")]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block block-label instrs)
          (if (= block-label target-label)
            (compiler-backend-emit-trivial-phi-return-edge-instrs
              type-segment-bases
              source-function
              (compiler-backend-shared-return-count
                program-index.backend-state
                assignments
                blocks)
              instrs
              from-label
              assignments
              vars
              ret-ty
              program-index)
            (compiler-backend-emit-trivial-phi-return-edge
              type-segment-bases
              source-function
              (__tl-box-place rest)
              target-label
              from-label
              assignments
              vars
              ret-ty
              program-index))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-emit-trivial-phi-return-edge-seq
        type-segment-bases
        source-function
        seq
        0
        target-label
        from-label
        assignments
        vars
        ret-ty
        program-index)]))

(define (compiler-backend-emit-trivial-phi-return-edge-seq
  [type-segment-bases : i64]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]
  [target-label : i64]
  [from-label : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [ret-ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    (ResultCompilerBackend.Ok "")
    (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
      [(compiler_ir_types.CompilerIrBlock.Block block-label instrs)
        (if (= block-label target-label)
          (compiler-backend-emit-trivial-phi-return-edge-instrs
            type-segment-bases
            source-function
            (compiler-backend-block-seq-return-count
              program-index.backend-state
              blocks
              index)
            instrs
            from-label
            assignments
            vars
            ret-ty
            program-index)
          (compiler-backend-emit-trivial-phi-return-edge-seq
            type-segment-bases
            source-function
            blocks
            (+ index 1)
            target-label
            from-label
            assignments
            vars
            ret-ty
            program-index))])))

(define (compiler-backend-emit-mov-trivial-phi-return-edge-instrs
  [type-segment-bases : i64]
  [source-function : i64]
  [return-count : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [from-label : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [ret-ty : compiler_ast_types.AstType]
  [moved-dst : i64]
  [moved-src : compiler_ir_types.CompilerIrValue]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (if (< (compiler_ir_types.compiler-ir-instr-seq-count instrs) 2)
    (ResultCompilerBackend.Ok "")
    (let
      [last-index : i64
        (- (compiler_ir_types.compiler-ir-instr-seq-count instrs) 1)]
      [last : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs last-index)]
      (match last
        [(compiler_ir_types.CompilerIrInstr.Return maybe)
          (match maybe
            [(compiler_ir_types.CompilerIrMaybeValue.Some value)
              (match value
                [(compiler_ir_types.CompilerIrValue.Var returned-dst)
                  (match (compiler-backend-trivial-phi-return-find
                    instrs
                    from-label
                    returned-dst
                    0
                    last-index
                    (CompilerBackendPhiReturnMatch.No))
                    [(ResultBackendPhiReturnMatch.Ok found)
                      (match found
                        [(CompilerBackendPhiReturnMatch.Some incoming)
                          (if (compiler-backend-branch-uses-var?
                            incoming
                            moved-dst)
                            ;; Same word1-drop hazard as the plain trivial
                            ;; phi return edge: emit-return needs the real
                            ;; program-index to spot register-group returns.
                            (compiler-backend-emit-return-with-return-count
                              type-segment-bases
                              source-function
                              return-count
                              (compiler_ir_types.CompilerIrMaybeValue.Some
                                moved-src)
                              assignments
                              vars
                              ret-ty
                              program-index)
                            (ResultCompilerBackend.Ok ""))]
                        [(CompilerBackendPhiReturnMatch.No)
                          (ResultCompilerBackend.Ok "")])]
                    [(ResultBackendPhiReturnMatch.Err message)
                      (ResultCompilerBackend.Err
                        (box
                          (compiler_diagnostic.compiler-diagnostic-at-start
                            ""
                            message)))])]
                [_ (ResultCompilerBackend.Ok "")])]
            [(compiler_ir_types.CompilerIrMaybeValue.No)
              (ResultCompilerBackend.Ok "")])]
        [_ (ResultCompilerBackend.Ok "")]))))

(define (compiler-backend-emit-mov-trivial-phi-return-edge
  [type-segment-bases : i64]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [target-label : i64]
  [from-label : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [ret-ty : compiler_ast_types.AstType]
  [moved-dst : i64]
  [moved-src : compiler_ir_types.CompilerIrValue]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (ResultCompilerBackend.Ok "")]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block block-label instrs)
          (if (= block-label target-label)
            (compiler-backend-emit-mov-trivial-phi-return-edge-instrs
              type-segment-bases
              source-function
              (compiler-backend-shared-return-count
                program-index.backend-state
                assignments
                blocks)
              instrs
              from-label
              assignments
              vars
              ret-ty
              moved-dst
              moved-src
              program-index)
            (compiler-backend-emit-mov-trivial-phi-return-edge
              type-segment-bases
              source-function
              (__tl-box-place rest)
              target-label
              from-label
              assignments
              vars
              ret-ty
              moved-dst
              moved-src
              program-index))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-emit-mov-trivial-phi-return-edge-seq
        type-segment-bases
        source-function
        seq
        0
        target-label
        from-label
        assignments
        vars
        ret-ty
        moved-dst
        moved-src
        program-index)]))

(define (compiler-backend-emit-mov-trivial-phi-return-edge-seq
  [type-segment-bases : i64]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]
  [target-label : i64]
  [from-label : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [ret-ty : compiler_ast_types.AstType]
  [moved-dst : i64]
  [moved-src : compiler_ir_types.CompilerIrValue]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    (ResultCompilerBackend.Ok "")
    (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
      [(compiler_ir_types.CompilerIrBlock.Block block-label instrs)
        (if (= block-label target-label)
          (compiler-backend-emit-mov-trivial-phi-return-edge-instrs
            type-segment-bases
            source-function
            (compiler-backend-block-seq-return-count
              program-index.backend-state
              blocks
              index)
            instrs
            from-label
            assignments
            vars
            ret-ty
            moved-dst
            moved-src
            program-index)
          (compiler-backend-emit-mov-trivial-phi-return-edge-seq
            type-segment-bases
            source-function
            blocks
            (+ index 1)
            target-label
            from-label
            assignments
            vars
            ret-ty
            moved-dst
            moved-src
            program-index))])))

;; The destination's home register, or "" if it is spilled / has no home. Used to
;; load a move's source directly into the destination register (1 instr) instead
;; of routing through %rax and storing back (2 instrs).
(define (compiler-backend-var-register-home
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [var : i64]) : String
  (match (compiler-backend-emit-assignment-lookup backend-state assignments var)
    [(compiler_regalloc.CompilerRegMaybeLocation.Some location)
      (match location
        [(compiler_regalloc.CompilerRegLocation.Register r)
          (compiler_abi.compiler-abi-register-spelling r)]
        [(compiler_regalloc.CompilerRegLocation.RegisterPair r _)
          (compiler_abi.compiler-abi-register-spelling r)]
        [_ ""])]
    [_ ""]))

(define (compiler-backend-value-register-home
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [value : compiler_ir_types.CompilerIrValue]) : String
  (match value
    [(compiler_ir_types.CompilerIrValue.Var id)
      ;; A single-use AddrOf definition is suppressed by forwarding. Its
      ;; allocator home therefore never receives the address; consumers must
      ;; materialize the source slot address through the ordinary load path.
      (if (>= (compiler-backend-forwarded-addr-of-src backend-state id) 0)
        ""
        (match (compiler-backend-emit-assignment-lookup
          backend-state
          assignments
          id)
          [(compiler_regalloc.CompilerRegMaybeLocation.Some location)
            (match location
              [(compiler_regalloc.CompilerRegLocation.Register home)
                (compiler_abi.compiler-abi-register-spelling home)]
              [_ ""])]
          [(compiler_regalloc.CompilerRegMaybeLocation.No) ""]))]
    [_ ""]))

(define (compiler-backend-emit-mov-with-plan
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [planned0 : String]
  [planned1 : String]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (cond
    ;; M-B: a group mov whose src and dst share a home (the coloring's
    ;; group-mov slot aliasing merges their ids, so both formula word slots
    ;; coincide; a register-pair dst can also equal its src's pair) copies a
    ;; value onto itself -- emit nothing instead of round-tripping both words
    ;; through the group-return register pair.
    [(and
        (compiler-backend-copy-group?
          type-segment-bases
          program-index
          ty
          dst
          src)
        (compiler-backend-value-same-home? backend-state assignments dst src))
      (ResultCompilerBackend.Ok "")]
    [(compiler-backend-copy-group? type-segment-bases program-index ty dst src)
      (compiler-backend-emit-group-copy-with-plan
        type-segment-bases
        assignments
        dst
        src
        vars
        ty
        program-index
        planned0
        planned1
        backend-state)]
    [(compiler-backend-value-same-home? backend-state assignments dst src)
      (ResultCompilerBackend.Ok "")]
    [(compiler-backend-float-type? ty)
      (let
        [dst-home : String
          (compiler-backend-var-register-home backend-state assignments dst)]
        [src-home : String
          (compiler-backend-float-value-register backend-state assignments src)]
        [exclude : (__tl_dyn-array String)
          (if (string.eq src-home "")
            (array.make-array String 0)
            (compiler-backend-one-exclude src-home))]
        [exclude-n : i64
          (if (string.eq src-home "")
            0
            1)]
        [reg : String
          (if (string.eq dst-home "")
            (if (> (string.string-length planned0) 0)
              planned0
              (compiler-backend-scavenge-xmm-reg
                dst
                exclude
                exclude-n
                "%xmm2"
                backend-state))
            dst-home)]
        (match (compiler-backend-emit-load-typed-value-to-reg-with-plan
          type-segment-bases
          assignments
          src
          ty
          reg
          program-index)
          [(ResultCompilerBackend.Ok load)
            (ResultCompilerBackend.Ok
              (if (string.eq dst-home "")
                (str_cat.str-cat
                  load
                  (compiler-backend-emit-store-typed-var-with-plan
                    assignments
                    dst
                    reg
                    ty
                    backend-state))
                load))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)]))]
    [else
      (match (compiler-backend-emit-store-immediate-to-var-home
        assignments
        dst
        src
        backend-state)
        [(CompilerBackendMaybeAsm.Some asm) (ResultCompilerBackend.Ok asm)]
        [(CompilerBackendMaybeAsm.No)
          (let
            [dst-home : String
              (compiler-backend-var-register-home backend-state assignments dst)]
            ;; Load src straight into the destination register home (a plain movq
            ;; / leaq), skipping the %rax staging store. emit-load-value-with-plan
            ;; handles var/global/global-addr sources and elides the move when src
            ;; already lives in dst's home.
            ;;
            ;; A var source can always take this path regardless of `ty`
            ;; width. Register and spill homes always hold the full normalized
            ;; 64-bit value (emit-store-var-with-plan stores every scalar with a
            ;; bare `movq`, and narrowing/extension happens when the value is first
            ;; produced), so a `movq src-home, dst-home` copy needs no per-type
            ;; reload. Non-var sources (globals/global-addr loaded from memory)
            ;; still require the typed narrowing path unless they are 8 bytes.
            (if (if (string.eq dst-home "")
              false
              (match src
                [(compiler_ir_types.CompilerIrValue.Var _) true]
                [_ (= (compiler-backend-type-size type-segment-bases ty) 8)]))
              (compiler-backend-emit-load-value-with-plan
                assignments
                src
                dst-home
                backend-state)
              (let
                [src-home : String
                  (compiler-backend-value-scalar-register
                    backend-state
                    assignments
                    src)]
                [exclude : (__tl_dyn-array String)
                  (if (string.eq src-home "")
                    (array.make-array String 0)
                    (compiler-backend-one-exclude src-home))]
                [exclude-n : i64
                  (if (string.eq src-home "")
                    0
                    1)]
                [reg : String
                  (compiler-backend-planned-or-scavenge-reg
                    planned0
                    dst
                    exclude
                    exclude-n
                    "%r8"
                    backend-state)]
                (match (compiler-backend-emit-load-typed-value-to-reg-with-plan
                  type-segment-bases
                  assignments
                  src
                  ty
                  reg
                  program-index)
                  [(ResultCompilerBackend.Ok load)
                    (ResultCompilerBackend.Ok
                      (str_cat.str-cat
                        load
                        (compiler-backend-emit-store-typed-var-with-plan
                          assignments
                          dst
                          reg
                          ty
                          backend-state)))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)]))))])]))

(define (compiler-backend-emit-mov
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [planned0 : String]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (compiler-backend-emit-mov-with-plan
    type-segment-bases
    assignments
    dst
    src
    ty
    program-index
    vars
    planned0
    ""
    backend-state))

;; Dead result-store elision (M-B): a call must be emitted for its effects, but
;; when its dst var is slot-homed (no register/pair home) AND never read in the
;; final IR (compiler-backend-var-never-used?), the store of the return
;; register(s) into the frame slot(s) is dead -- nothing reloads the slot, no
;; AddrOf aliases it, and no runtime walk observes frames. Register-homed dsts
;; keep their store: the scavenge occupancy model may treat the home register
;; as holding the value across its (empty) interval, so leave those untouched.
(define (compiler-backend-call-result-store-dead?
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]) : bool
  (and
    (compiler-backend-var-never-used? backend-state dst)
    (match (compiler-backend-emit-assignment-lookup
      backend-state
      assignments
      dst)
      [(compiler_regalloc.CompilerRegMaybeLocation.Some location)
        (match location
          [(compiler_regalloc.CompilerRegLocation.Spill _) true]
          [_ false])]
      [(compiler_regalloc.CompilerRegMaybeLocation.No) true])))

;; Scalar/float call-result store through the dead-elision gate: the syscall
;; and C-ABI indirect-call paths store %rax/%xmm0 inline rather than via
;; emit-call-result-store; route their stores through the same deadness check.
(define (compiler-backend-emit-call-result-store-reg-normalize
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [reg : String]
  [ty : compiler_ast_types.AstType]
  [normalize? : bool]
  [backend-state : CompilerBackendState]) : String
  (if (compiler-backend-call-result-store-dead? backend-state assignments dst)
    ""
    (str_cat.str-cat
      (compiler-backend-call-result-normalize normalize? reg ty)
      (compiler-backend-emit-store-typed-var-with-plan
        assignments
        dst
        reg
        ty
        backend-state))))

(define (compiler-backend-emit-call-result-store-reg
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [reg : String]
  [ty : compiler_ast_types.AstType]
  [backend-state : CompilerBackendState]) : String
  (compiler-backend-emit-call-result-store-reg-normalize
    assignments
    dst
    reg
    ty
    false
    backend-state))

(define (compiler-backend-emit-c-abi-call-result-store-reg
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [reg : String]
  [ty : compiler_ast_types.AstType]
  [backend-state : CompilerBackendState]) : String
  (compiler-backend-emit-call-result-store-reg-normalize
    assignments
    dst
    reg
    ty
    true
    backend-state))

(define (compiler-backend-call-result-normalize
  [normalize? : bool]
  [reg : String]
  [ty : compiler_ast_types.AstType]) : String
  (if (and normalize? (string.eq reg "%rax"))
    (match ty
      [(compiler_ast_types.AstType.Bool) "    movzbq %al, %rax\n"]
      [_ ""])
    ""))

(define (compiler-backend-emit-call-result-store
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [ty : compiler_ast_types.AstType]
  [vars : i64]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (compiler-backend-emit-call-result-store-normalize
    type-segment-bases
    assignments
    dst
    ty
    vars
    program-index
    false))

(define (compiler-backend-emit-c-abi-call-result-store
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [ty : compiler_ast_types.AstType]
  [vars : i64]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (compiler-backend-emit-call-result-store-normalize
    type-segment-bases
    assignments
    dst
    ty
    vars
    program-index
    true))

(define (compiler-backend-emit-call-result-store-normalize
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [ty : compiler_ast_types.AstType]
  [vars : i64]
  [program-index : CompilerBackendProgramIndex]
  [normalize? : bool]) : ResultCompilerBackend
  (if (compiler-backend-call-result-store-dead?
    program-index.backend-state
    assignments
    dst)
    (ResultCompilerBackend.Ok "")
    (compiler-backend-emit-call-result-store-live
      type-segment-bases
      assignments
      dst
      ty
      vars
      program-index
      normalize?)))

(define (compiler-backend-emit-call-result-store-live
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [ty : compiler_ast_types.AstType]
  [vars : i64]
  [program-index : CompilerBackendProgramIndex]
  [normalize? : bool]) : ResultCompilerBackend
  (if (compiler-backend-group-type? type-segment-bases program-index ty)
    (compiler-backend-emit-group-store
      type-segment-bases
      assignments
      dst
      (compiler-backend-group-return-reg type-segment-bases program-index ty 0)
      (compiler-backend-group-return-reg type-segment-bases program-index ty 1)
      vars
      ty
      program-index
      program-index.backend-state)
    (ResultCompilerBackend.Ok
      (let
        [reg : String
          (if (compiler-backend-float-type? ty)
            "%xmm0"
            "%rax")]
        (str_cat.str-cat
          (compiler-backend-call-result-normalize normalize? reg ty)
          (compiler-backend-emit-store-typed-var-with-plan
            assignments
            dst
            reg
            ty
            program-index.backend-state))))))

;; Append-form of the result store for callers that already own a sequence
;; buffer (the direct/indirect call emitters). The group store keeps the String
;; emitter -- it is a cold two-word path -- and its text goes in with one
;; append.
(define (compiler-backend-emit-call-result-store-normalize-into
  [out : (&mut out CompilerBackendAsmBuf)]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [ty : compiler_ast_types.AstType]
  [vars : i64]
  [program-index : CompilerBackendProgramIndex]
  [normalize? : bool]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (if (compiler-backend-call-result-store-dead? backend-state assignments dst)
    (ResultCompilerBackend.Ok "")
    (if (compiler-backend-group-type? type-segment-bases program-index ty)
      (match (compiler-backend-emit-group-store
        type-segment-bases
        assignments
        dst
        (compiler-backend-group-return-reg
          type-segment-bases
          program-index
          ty
          0)
        (compiler-backend-group-return-reg
          type-segment-bases
          program-index
          ty
          1)
        vars
        ty
        program-index
        backend-state)
        [(ResultCompilerBackend.Ok store)
          (begin
            (compiler-backend-asm-append out store)
            (ResultCompilerBackend.Ok ""))]
        [(ResultCompilerBackend.Err message)
          (ResultCompilerBackend.Err message)])
      (let
        [reg : String
          (if (compiler-backend-float-type? ty)
            "%xmm0"
            "%rax")]
        (begin
          (compiler-backend-asm-append
            out
            (compiler-backend-call-result-normalize normalize? reg ty))
          (compiler-backend-emit-store-typed-var-with-plan-into
            out
            assignments
            dst
            reg
            ty
            backend-state)
          (ResultCompilerBackend.Ok ""))))))

(define (compiler-backend-tls-current-arena-call-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-backend-tls-current-arena-call-id? name-id))

(define (compiler-backend-tls-current-arena-inline-asm
  [target : CompilerBackendTarget]
  [name-id : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]) : ResultCompilerBackend
  (cond
    [(cbi.compiler-builtin-backend-tls-current-arena-load-id? name-id)
      (ResultCompilerBackend.Ok
        (compiler-backend-current-arena-load target "%rax"))]
    [(cbi.compiler-builtin-backend-tls-current-arena-store-id? name-id)
      (match (compiler-backend-target-arg-reg target 0)
        [(ResultBackendReg.Ok reg)
          (ResultCompilerBackend.Ok
            (compiler-backend-current-arena-store target reg))]
        [(ResultBackendReg.Err message)
          (ResultCompilerBackend.Err
            (box
              (compiler_diagnostic.compiler-diagnostic-with-message
                instr-diag
                message)))])]
    [else
      (ResultCompilerBackend.Err
        (box
          (compiler_diagnostic.compiler-diagnostic-with-message
            instr-diag
            "backend: unknown tls current arena helper")))]))

(define (compiler-backend-emit-inline-tls-current-arena-call-with-arg-assignments
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [arg-assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-stage : String]
  [dst : i64]
  [name : i64]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [_externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [extern-call-info : i64
      (compiler-backend-index-extern-call-info program-index name)]
    [param-types : compiler_ast_types.AstTypeList
      (compiler-backend-call-param-types-for-call
        type-segment-bases
        name
        args
        types
        global-types
        extern-call-info
        program-index)]
    [c-abi? : bool
      (compiler-backend-extern-call-info-aggregate-params? extern-call-info)]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        c-abi?
        program-index)]
    (match (compiler-backend-emit-call-args-with-override
      type-segment-bases
      (compiler-backend-function-state-rax-forward-pending-var backend-state)
      target
      arg-assignments
      args
      param-types
      c-abi?
      0
      0
      0
      0
      0
      planned-stage
      instr-diag
      program-index
      vars
      backend-state)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-emit-call-result-store
          type-segment-bases
          assignments
          dst
          ty
          vars
          program-index)
          [(ResultCompilerBackend.Ok result-store)
            (match (compiler-backend-tls-current-arena-inline-asm
              target
              name
              instr-diag)
              [(ResultCompilerBackend.Ok inline-asm)
                (ResultCompilerBackend.Ok
                  (str_cat.str-cat
                    (compiler-backend-emit-call-space-sub call-space)
                    args-asm
                    inline-asm
                    (compiler-backend-emit-call-space-add call-space)
                    result-store))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err
                  (box
                    (compiler-backend-apply-instr-diagnostic
                      (__tl-box-place message)
                      instr-diag)))])]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              instr-diag)))])))

(define (compiler-backend-atomic-call-name? [name : String]) : bool
  (or
    (string.eq name "tl_atomic_i64_load_ptr")
    (string.eq name "tl_atomic_i64_store_ptr")
    (string.eq name "tl_atomic_i64_add_ptr")
    (string.eq name "tl_atomic_i64_fetch_add_ptr")
    (string.eq name "tl_atomic_i64_cas_ptr")
    (string.eq name "tl_atomic_i32_load_ptr")
    (string.eq name "tl_atomic_i32_store_ptr")
    (string.eq name "tl_atomic_i32_add_ptr")
    (string.eq name "tl_atomic_i32_fetch_add_ptr")
    (string.eq name "tl_atomic_i32_cas_ptr")))

(define (compiler-backend-atomic-i32-call? [name : String]) : bool
  (or
    (string.eq name "tl_atomic_i32_load_ptr")
    (string.eq name "tl_atomic_i32_store_ptr")
    (string.eq name "tl_atomic_i32_add_ptr")
    (string.eq name "tl_atomic_i32_fetch_add_ptr")
    (string.eq name "tl_atomic_i32_cas_ptr")))

(define (compiler-backend-atomic-op-load? [name : String]) : bool
  (or
    (string.eq name "tl_atomic_i64_load_ptr")
    (string.eq name "tl_atomic_i32_load_ptr")))

(define (compiler-backend-atomic-op-store? [name : String]) : bool
  (or
    (string.eq name "tl_atomic_i64_store_ptr")
    (string.eq name "tl_atomic_i32_store_ptr")))

(define (compiler-backend-atomic-op-add? [name : String]) : bool
  (or
    (string.eq name "tl_atomic_i64_add_ptr")
    (string.eq name "tl_atomic_i32_add_ptr")))

(define (compiler-backend-atomic-op-fetch-add? [name : String]) : bool
  (or
    (string.eq name "tl_atomic_i64_fetch_add_ptr")
    (string.eq name "tl_atomic_i32_fetch_add_ptr")))

(define (compiler-backend-atomic-ptr-reg [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    "%rcx"
    "%rdi"))

(define (compiler-backend-atomic-value-reg
  [target : CompilerBackendTarget]
  [i32? : bool]) : String
  (if (compiler-backend-target-windows? target)
    (if i32?
      "%edx"
      "%rdx")
    (if i32?
      "%esi"
      "%rsi")))

(define (compiler-backend-atomic-new-reg
  [target : CompilerBackendTarget]
  [i32? : bool]) : String
  (if (compiler-backend-target-windows? target)
    (if i32?
      "%r8d"
      "%r8")
    (if i32?
      "%edx"
      "%rdx")))

(define (compiler-backend-atomic-rax [i32? : bool]) : String
  (if i32?
    "%eax"
    "%rax"))

(define (compiler-backend-atomic-width-suffix [i32? : bool]) : String
  (if i32?
    "l"
    "q"))

(define (compiler-backend-atomic-inline-asm
  [target : CompilerBackendTarget]
  [name : String]) : String
  (let
    [i32? : bool (compiler-backend-atomic-i32-call? name)]
    [ptr : String (compiler-backend-atomic-ptr-reg target)]
    [value : String (compiler-backend-atomic-value-reg target i32?)]
    [new-value : String (compiler-backend-atomic-new-reg target i32?)]
    [rax : String (compiler-backend-atomic-rax i32?)]
    [suffix : String (compiler-backend-atomic-width-suffix i32?)]
    (cond
      [(compiler-backend-atomic-op-load? name)
        (str_cat.str-cat "    mov" suffix " (" ptr "), " rax "\n")]
      [(compiler-backend-atomic-op-store? name)
        (str_cat.str-cat "    xchg" suffix " " value ", (" ptr ")\n")]
      [(compiler-backend-atomic-op-add? name)
        (str_cat.str-cat "    lock add" suffix " " value ", (" ptr ")\n")]
      [(compiler-backend-atomic-op-fetch-add? name)
        (str_cat.str-cat
          "    mov"
          suffix
          " "
          value
          ", "
          rax
          "\n    lock xadd"
          suffix
          " "
          rax
          ", ("
          ptr
          ")\n")]
      [else
        (str_cat.str-cat
          "    mov"
          suffix
          " "
          value
          ", "
          rax
          "\n    lock cmpxchg"
          suffix
          " "
          new-value
          ", ("
          ptr
          ")\n")])))

(define (compiler-backend-volatile-call-name? [name : String]) : bool
  (or
    (string.eq name "tl_volatile_i64_load_ptr")
    (string.eq name "tl_volatile_i64_store_ptr")
    (string.eq name "tl_volatile_i32_load_ptr")
    (string.eq name "tl_volatile_i32_store_ptr")))

(define (compiler-backend-volatile-i32-call? [name : String]) : bool
  (or
    (string.eq name "tl_volatile_i32_load_ptr")
    (string.eq name "tl_volatile_i32_store_ptr")))

(define (compiler-backend-volatile-op-load? [name : String]) : bool
  (or
    (string.eq name "tl_volatile_i64_load_ptr")
    (string.eq name "tl_volatile_i32_load_ptr")))

(define (compiler-backend-volatile-inline-asm
  [target : CompilerBackendTarget]
  [name : String]) : String
  (let
    [i32? : bool (compiler-backend-volatile-i32-call? name)]
    [ptr : String (compiler-backend-atomic-ptr-reg target)]
    [value : String (compiler-backend-atomic-value-reg target i32?)]
    [rax : String (compiler-backend-atomic-rax i32?)]
    [suffix : String (compiler-backend-atomic-width-suffix i32?)]
    (if (compiler-backend-volatile-op-load? name)
      (str_cat.str-cat "    mov" suffix " (" ptr "), " rax "\n")
      (str_cat.str-cat "    mov" suffix " " value ", (" ptr ")\n"))))

(define (compiler-backend-inline-memory-call-name? [name : String]) : bool
  (or
    (compiler-backend-atomic-call-name? name)
    (compiler-backend-volatile-call-name? name)))

(define (compiler-backend-inline-memory-call-target
  [name : String]
  [call-symbol : String]) : String
  (if (compiler-backend-inline-memory-call-name? name)
    name
    call-symbol))

(define (compiler-backend-inline-memory-call-asm
  [target : CompilerBackendTarget]
  [name : String]) : String
  (if (compiler-backend-atomic-call-name? name)
    (compiler-backend-atomic-inline-asm target name)
    (compiler-backend-volatile-inline-asm target name)))

(define (compiler-backend-emit-inline-memory-helper-function
  [target : CompilerBackendTarget]
  [symbol : String]) : String
  (str_cat.str-cat
    ".globl "
    symbol
    "\n"
    (compiler-backend-emit-function-type-directive target symbol)
    symbol
    ":\n"
    (compiler-backend-inline-memory-call-asm target symbol)
    "    ret\n"
    (compiler-backend-emit-function-size-directive target symbol)))

(define (compiler-backend-emit-inline-memory-call-with-arg-assignments
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [arg-assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-stage : String]
  [dst : i64]
  [name : i64]
  [inline-name : String]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [_externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [extern-call-info : i64
      (compiler-backend-index-extern-call-info program-index name)]
    [param-types : compiler_ast_types.AstTypeList
      (compiler-backend-call-param-types-for-call
        type-segment-bases
        name
        args
        types
        global-types
        extern-call-info
        program-index)]
    [c-abi? : bool
      (compiler-backend-extern-call-info-aggregate-params? extern-call-info)]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        c-abi?
        program-index)]
    (match (compiler-backend-emit-call-args-with-override
      type-segment-bases
      (compiler-backend-function-state-rax-forward-pending-var backend-state)
      target
      arg-assignments
      args
      param-types
      c-abi?
      0
      0
      0
      0
      0
      planned-stage
      instr-diag
      program-index
      vars
      backend-state)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-emit-call-result-store
          type-segment-bases
          assignments
          dst
          ty
          vars
          program-index)
          [(ResultCompilerBackend.Ok result-store)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (compiler-backend-emit-call-space-sub call-space)
                args-asm
                (compiler-backend-inline-memory-call-asm target inline-name)
                (compiler-backend-emit-call-space-add call-space)
                result-store))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              instr-diag)))])))

(define (compiler-backend-emit-direct-call-with-arg-assignments
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [function : String]
  [current-label : i64]
  [current-site : i64]
  [dst : i64]
  [name : i64]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [arg-assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-stage : String]
  [planned-stage2 : String]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [plan : CompilerBackendRuntimePlan]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [fast-alloc-size : i64 (compiler-backend-fast-alloc-size args)]
    [call-symbol : String
      (compiler-backend-call-symbol-index name plan program-index)]
    [inline-memory-name : String
      (compiler-backend-inline-memory-call-target
        (compiler-backend-symbol-text-index program-index name)
        call-symbol)]
    (cond
      [(and
          (> fast-alloc-size 0)
          (cbi.compiler-builtin-backend-tl-alloc-id? name)
          (compiler-backend-plan-provides-id?
            plan
            cbi.compiler-builtin-id-tl-alloc)
          (string.eq call-symbol "tl_alloc"))
        (ResultCompilerBackend.Ok
          (str_cat.str-cat
            (if (compiler-backend-inline-fast-alloc? fast-alloc-size)
              (compiler-backend-emit-inline-fast-alloc
                target
                function
                current-label
                current-site
                dst
                fast-alloc-size
                (compiler-backend-plan-provides-id?
                  plan
                  cbi.compiler-builtin-id-tl-profile-alloc-total)
                planned-stage
                planned-stage2
                backend-state)
              (str_cat.str-cat
                "    call "
                (compiler-backend-fast-alloc-label fast-alloc-size)
                "\n"
                ""
                ""))
            (compiler-backend-emit-store-typed-var-with-plan
              assignments
              dst
              "%rax"
              ty
              backend-state)))]
      [(and
          (compiler-backend-tls-current-arena-call-id? name)
          (not (compiler-backend-index-function-defines? program-index name)))
        (compiler-backend-emit-inline-tls-current-arena-call-with-arg-assignments
          type-segment-bases
          target
          assignments
          arg-assignments
          planned-stage
          dst
          name
          args
          ty
          types
          global-types
          externs
          program-index
          vars
          instr-diag
          backend-state)]
      [(compiler-backend-inline-memory-call-name? inline-memory-name)
        (compiler-backend-emit-inline-memory-call-with-arg-assignments
          type-segment-bases
          target
          assignments
          arg-assignments
          planned-stage
          dst
          name
          inline-memory-name
          args
          ty
          types
          global-types
          externs
          program-index
          vars
          instr-diag
          backend-state)]
      [else
        (let
          [extern-call-info : i64
            (compiler-backend-index-extern-call-info program-index name)]
          [param-types : compiler_ast_types.AstTypeList
            (compiler-backend-call-param-types-for-call
              type-segment-bases
              name
              args
              types
              global-types
              extern-call-info
              program-index)]
          [effective-arg-assignments : compiler_regalloc.CompilerRegAssignmentTable
            (if (compiler-backend-declared-first-call-arg-accepts-rax-forward?
              type-segment-bases
              program-index
              param-types)
              arg-assignments
              assignments)]
          ;; Dense-index override mirroring effective-arg-assignments: the
          ;; rax-forward insert reaches the arg emitters exactly when the
          ;; declared first arg accepts the forward.
          [effective-arg-override : i64
            (if (compiler-backend-declared-first-call-arg-accepts-rax-forward?
              type-segment-bases
              program-index
              param-types)
              (compiler-backend-function-state-rax-forward-pending-var
                backend-state)
              -1)]
          [c-abi? : bool
            (compiler-backend-extern-call-info-aggregate-params?
              extern-call-info)]
          [c-return? : bool
            (compiler-backend-extern-call-info-c-abi? extern-call-info)]
          [call-space : i64
            (compiler-backend-call-arg-space
              target
              args
              param-types
              c-abi?
              program-index)]
          ;; Route the non-tail direct call through the parallel-move wrapper (not
          ;; the raw naive emitter): a register-homed arg's source register can be
          ;; another arg's destination arg register (e.g. once mixed scalar+handle
          ;; calls leave their scalar args register-eligible), so the naive ascending
          ;; marshalling could clobber a source before it is read. The wrapper resolves
          ;; only real GP source/dest conflicts via a sound parallel move and otherwise
          ;; delegates to the byte-identical naive path (so conflict-free calls -- the
          ;; overwhelming common case -- are unchanged). Mirrors the tail-call path.
          ;; The whole call sequence (space sub, marshalled args, varargs
          ;; prologue, the call, space add, result store) goes into one
          ;; sequence buffer. `emit-call-space-sub` is a pure formatter, so
          ;; appending it before the argument emitters run leaves both the
          ;; emitted bytes and the emitters' order untouched.
          [seq : CompilerBackendAsmBuf
            (compiler-backend-asm-buf-with-capacity
              compiler-backend-asm-seq-capacity)]
          (begin
            (compiler-backend-asm-append
              (&mut seq)
              (compiler-backend-emit-call-space-sub call-space))
            (match (compiler-backend-emit-call-args-with-override-into
              (&mut seq)
              type-segment-bases
              effective-arg-override
              target
              effective-arg-assignments
              args
              param-types
              c-abi?
              0
              0
              0
              0
              0
              planned-stage
              instr-diag
              program-index
              vars
              backend-state)
              [(ResultCompilerBackend.Ok _)
                ;; `varargs-pre-call`, `emit-call-space-add` and the call line
                ;; are pure formatters over already-computed state, so emitting
                ;; them before the result store leaves the result store's own
                ;; (scavenging) emitters in the same relative order they had
                ;; against the argument emitters.
                (begin
                  (compiler-backend-asm-append
                    (&mut seq)
                    (compiler-backend-varargs-pre-call
                      type-segment-bases
                      target
                      extern-call-info
                      param-types))
                  (compiler-backend-asm-append4
                    (&mut seq)
                    "    call "
                    call-symbol
                    "\n"
                    (compiler-backend-emit-call-space-add call-space))
                  (match (compiler-backend-emit-call-result-store-normalize-into
                    (&mut seq)
                    type-segment-bases
                    assignments
                    dst
                    ty
                    vars
                    program-index
                    c-return?
                    backend-state)
                    [(ResultCompilerBackend.Ok _)
                      (ResultCompilerBackend.Ok
                        (compiler-backend-asm-buf-finish (& seq)))]
                    [(ResultCompilerBackend.Err message)
                      (ResultCompilerBackend.Err
                        (box
                          (compiler-backend-apply-instr-diagnostic
                            (__tl-box-place message)
                            instr-diag)))]))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err
                  (box
                    (compiler-backend-apply-instr-diagnostic
                      (__tl-box-place message)
                      instr-diag)))])))])))

(define (compiler-backend-spmd-call-arg-at
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [index : i64]) : compiler_ir_types.CompilerIrSpmdCallArg
  (match args
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Nil)
      (compiler_ir_types.CompilerIrSpmdCallArg.Arg
        (compiler_ir_types.CompilerIrSpmdValueClass.Uniform)
        compiler_ir_types.CompilerIrValue.Unit
        (compiler_ast_types.AstType.Unit))]
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Array seq)
      (if (and (>= index 0) (< index seq.len))
        (array-ref seq.slots index)
        (compiler_ir_types.CompilerIrSpmdCallArg.Arg
          (compiler_ir_types.CompilerIrSpmdValueClass.Uniform)
          compiler_ir_types.CompilerIrValue.Unit
          (compiler_ast_types.AstType.Unit)))]
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Cons arg rest)
      (if (= index 0)
        arg
        (compiler-backend-spmd-call-arg-at (__tl-box-place rest) (- index 1)))]))

(define (compiler-backend-spmd-class-uniform?
  [class : compiler_ir_types.CompilerIrSpmdValueClass]) : bool
  (match class
    [(compiler_ir_types.CompilerIrSpmdValueClass.Uniform) true]
    [_ false]))

(define (compiler-backend-spmd-class-varying?
  [class : compiler_ir_types.CompilerIrSpmdValueClass]) : bool
  (match class
    [(compiler_ir_types.CompilerIrSpmdValueClass.Varying) true]
    [_ false]))

(define (compiler-backend-spmd-class-mask?
  [class : compiler_ir_types.CompilerIrSpmdValueClass]) : bool
  (match class
    [(compiler_ir_types.CompilerIrSpmdValueClass.Mask) true]
    [_ false]))

(define (compiler-backend-spmd-call-values-from
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [index : i64]
  [uniform-only : bool]) : compiler_ir_types.CompilerIrValueList
  (if (>= index (compiler_ir_types.compiler-ir-spmd-call-arg-count args))
    compiler_ir_types.CompilerIrValueList.Nil
    (match (compiler-backend-spmd-call-arg-at args index)
      [(compiler_ir_types.CompilerIrSpmdCallArg.Arg class value _)
        (let
          [rest : compiler_ir_types.CompilerIrValueList
            (compiler-backend-spmd-call-values-from
              args
              (+ index 1)
              uniform-only)]
          (if (or
            (not uniform-only)
            (compiler-backend-spmd-class-uniform? class))
            (compiler_ir_types.compiler-ir-value-cons value rest)
            rest))])))

(define (compiler-backend-spmd-call-types-from
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [index : i64]
  [uniform-only : bool]) : compiler_ast_types.AstTypeList
  (if (>= index (compiler_ir_types.compiler-ir-spmd-call-arg-count args))
    (compiler_ast_types.ast-type-list-new)
    (match (compiler-backend-spmd-call-arg-at args index)
      [(compiler_ir_types.CompilerIrSpmdCallArg.Arg class _ ty)
        (let
          [rest : compiler_ast_types.AstTypeList
            (compiler-backend-spmd-call-types-from
              args
              (+ index 1)
              uniform-only)]
          (if (or
            (not uniform-only)
            (compiler-backend-spmd-class-uniform? class))
            (compiler_ast_types.ast-type-cons ty rest)
            rest))])))

(define (compiler-backend-spmd-call-class-count
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [index : i64]
  [want-mask : bool]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-spmd-call-arg-count args))
    0
    (match (compiler-backend-spmd-call-arg-at args index)
      [(compiler_ir_types.CompilerIrSpmdCallArg.Arg class _ _)
        (+
          (if (if want-mask
            (compiler-backend-spmd-class-mask? class)
            (compiler-backend-spmd-class-varying? class))
            1
            0)
          (compiler-backend-spmd-call-class-count args (+ index 1) want-mask))])))

(define (compiler-backend-spmd-avx2-special-count
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]) : i64
  (+
    1
    (+
      (compiler-backend-spmd-call-class-count args 0 false)
      (compiler-backend-spmd-call-class-count args 0 true))))

(define (compiler-backend-spmd-avx2-save-value
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [value : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [mask? : bool]
  [lanes : i64]
  [offset : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (if (if mask?
    (compiler-backend-avx2-mask-shape-ok? lanes)
    (compiler-backend-avx2-shape-ok? elem-ty lanes))
    (let
      [storage-ty : compiler_ast_types.AstType
        (if mask?
          (compiler_ast_types.AstType.I8)
          elem-ty)]
      (match (compiler-backend-vector-register-use
        assignments
        value
        "private AVX2 SPMD call argument"
        "ymm"
        storage-ty
        "%ymm14"
        backend-state)
        [(ResultBackendVectorUse.Ok use)
          (match use
            [(CompilerBackendVectorUse.Use load-asm src)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  load-asm
                  "    vmovdqu "
                  src
                  ", "
                  (string.int->string offset)
                  "(%rsp)\n"))])]
        [(ResultBackendVectorUse.Err message)
          (ResultCompilerBackend.Err
            (box
              (compiler_diagnostic.compiler-diagnostic-with-message
                instr-diag
                message)))]))
    (compiler-backend-avx2-shape-diagnostic
      type-segment-bases
      instr-diag
      (if mask?
        (compiler_ast_types.AstType.Bool)
        elem-ty)
      lanes)))

(define (compiler-backend-spmd-avx2-save-args
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [index : i64]
  [special-index : i64]
  [lanes : i64]
  [base-offset : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (if (>= index (compiler_ir_types.compiler-ir-spmd-call-arg-count args))
    (ResultCompilerBackend.Ok "")
    (match (compiler-backend-spmd-call-arg-at args index)
      [(compiler_ir_types.CompilerIrSpmdCallArg.Arg class value ty)
        (if (compiler-backend-spmd-class-uniform? class)
          (compiler-backend-spmd-avx2-save-args
            type-segment-bases
            assignments
            args
            (+ index 1)
            special-index
            lanes
            base-offset
            instr-diag
            backend-state)
          (let
            [mask? : bool (compiler-backend-spmd-class-mask? class)]
            (match (compiler-backend-spmd-avx2-save-value
              type-segment-bases
              assignments
              value
              ty
              mask?
              lanes
              (+ base-offset (* 32 special-index))
              instr-diag
              backend-state)
              [(ResultCompilerBackend.Ok head)
                (match (compiler-backend-spmd-avx2-save-args
                  type-segment-bases
                  assignments
                  args
                  (+ index 1)
                  (+ special-index 1)
                  lanes
                  base-offset
                  instr-diag
                  backend-state)
                  [(ResultCompilerBackend.Ok tail)
                    (ResultCompilerBackend.Ok (str_cat.str-cat head tail))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)])))])))

(define (compiler-backend-spmd-avx2-result-store
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [result : compiler_ir_types.CompilerIrSpmdCallResult]
  [vars : i64]
  [program-index : CompilerBackendProgramIndex]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (match result
    [(compiler_ir_types.CompilerIrSpmdCallResult.Unit)
      (ResultCompilerBackend.Ok "")]
    [(compiler_ir_types.CompilerIrSpmdCallResult.Value dst class ty)
      (if (compiler-backend-spmd-class-uniform? class)
        (compiler-backend-emit-call-result-store
          type-segment-bases
          assignments
          dst
          ty
          vars
          program-index)
        (let
          [storage-ty : compiler_ast_types.AstType
            (if (compiler-backend-spmd-class-mask? class)
              (compiler_ast_types.AstType.I8)
              ty)]
          (match (compiler-backend-vector-dst-reg
            assignments
            dst
            "private AVX2 SPMD call result"
            "ymm"
            "%ymm14"
            backend-state)
            [(ResultBackendReg.Ok home)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  (if (string.eq home "%ymm0")
                    ""
                    (str_cat.str-cat "    vmovdqu %ymm0, " home "\n" ""))
                  (compiler-backend-vector-store-dst
                    assignments
                    dst
                    "ymm"
                    storage-ty
                    home
                    backend-state)))]
            [(ResultBackendReg.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler_diagnostic.compiler-diagnostic-with-message
                    instr-diag
                    message)))])))]))

(define (compiler-backend-spmd-private-vector-args-asm
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [index : i64]
  [vector-index : i64]
  [lanes : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (if (>= index (compiler_ir_types.compiler-ir-spmd-call-arg-count args))
    (ResultCompilerBackend.Ok "")
    (match (compiler-backend-spmd-call-arg-at args index)
      [(compiler_ir_types.CompilerIrSpmdCallArg.Arg class value ty)
        (if (compiler-backend-spmd-class-varying? class)
          (let
            [dst : String
              (compiler-backend-spmd-private-vector-arg-reg vector-index)]
            (if (= (string.string-length dst) 0)
              (ResultCompilerBackend.Err
                (box
                  (compiler_diagnostic.compiler-diagnostic-with-message
                    instr-diag
                    "backend: private AVX-512 SPMD call supports at most 8 varying value arguments")))
              (if (not (compiler-backend-avx512-shape-ok? ty lanes))
                (compiler-backend-avx512-shape-diagnostic
                  type-segment-bases
                  instr-diag
                  ty
                  lanes)
                (match (compiler-backend-vector-register-use
                  assignments
                  value
                  "private SPMD call argument"
                  "zmm"
                  ty
                  "%zmm14"
                  backend-state)
                  [(ResultBackendVectorUse.Ok use)
                    (match use
                      [(CompilerBackendVectorUse.Use load-asm src)
                        (match (compiler-backend-spmd-private-vector-args-asm
                          type-segment-bases
                          assignments
                          args
                          (+ index 1)
                          (+ vector-index 1)
                          lanes
                          instr-diag
                          backend-state)
                          [(ResultCompilerBackend.Ok tail)
                            (ResultCompilerBackend.Ok
                              (str_cat.str-cat
                                load-asm
                                (if (string.eq src dst)
                                  ""
                                  (str_cat.str-cat
                                    "    "
                                    (compiler-backend-avx512-vector-move ty)
                                    " "
                                    src
                                    ", "
                                    dst
                                    "\n"))
                                tail))]
                          [(ResultCompilerBackend.Err message)
                            (ResultCompilerBackend.Err message)])])]
                  [(ResultBackendVectorUse.Err message)
                    (ResultCompilerBackend.Err
                      (box
                        (compiler_diagnostic.compiler-diagnostic-with-message
                          instr-diag
                          message)))]))))
          (compiler-backend-spmd-private-vector-args-asm
            type-segment-bases
            assignments
            args
            (+ index 1)
            vector-index
            lanes
            instr-diag
            backend-state))])))

(define (compiler-backend-spmd-private-save-mask-value
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [value : compiler_ir_types.CompilerIrValue]
  [lanes : i64]
  [offset : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (match (compiler-backend-avx512-mask-source-into-gpr
    assignments
    value
    "private SPMD call mask"
    lanes
    (compiler-backend-avx512-mask-gpr lanes)
    backend-state)
    [(ResultBackendVectorUse.Ok use)
      (match use
        [(CompilerBackendVectorUse.Use load-asm _)
          (ResultCompilerBackend.Ok
            (str_cat.str-cat
              load-asm
              "    movq %rax, "
              (string.int->string offset)
              "(%rsp)\n"
              ""))])]
    [(ResultBackendVectorUse.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler_diagnostic.compiler-diagnostic-with-message
            instr-diag
            message)))]))

(define (compiler-backend-spmd-private-save-mask-args
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [index : i64]
  [mask-index : i64]
  [lanes : i64]
  [base-offset : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (if (>= index (compiler_ir_types.compiler-ir-spmd-call-arg-count args))
    (ResultCompilerBackend.Ok "")
    (match (compiler-backend-spmd-call-arg-at args index)
      [(compiler_ir_types.CompilerIrSpmdCallArg.Arg class value _)
        (if (compiler-backend-spmd-class-mask? class)
          (if (>= mask-index 5)
            (ResultCompilerBackend.Err
              (box
                (compiler_diagnostic.compiler-diagnostic-with-message
                  instr-diag
                  "backend: private AVX-512 SPMD call supports at most 5 varying bool arguments")))
            (match (compiler-backend-spmd-private-save-mask-value
              assignments
              value
              lanes
              (+ base-offset (* 8 (+ mask-index 1)))
              instr-diag
              backend-state)
              [(ResultCompilerBackend.Ok head)
                (match (compiler-backend-spmd-private-save-mask-args
                  assignments
                  args
                  (+ index 1)
                  (+ mask-index 1)
                  lanes
                  base-offset
                  instr-diag
                  backend-state)
                  [(ResultCompilerBackend.Ok tail)
                    (ResultCompilerBackend.Ok (str_cat.str-cat head tail))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)]))
          (compiler-backend-spmd-private-save-mask-args
            assignments
            args
            (+ index 1)
            mask-index
            lanes
            base-offset
            instr-diag
            backend-state))])))

(define (compiler-backend-spmd-private-load-mask-args
  [mask-count : i64]
  [mask-index : i64]
  [base-offset : i64]) : String
  (if (>= mask-index mask-count)
    ""
    (str_cat.str-cat
      "    kmovq "
      (string.int->string (+ base-offset (* 8 (+ mask-index 1))))
      "(%rsp), "
      (compiler-backend-spmd-private-mask-arg-reg mask-index)
      "\n"
      (compiler-backend-spmd-private-load-mask-args
        mask-count
        (+ mask-index 1)
        base-offset))))

(define (compiler-backend-spmd-private-result-store
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [result : compiler_ir_types.CompilerIrSpmdCallResult]
  [vars : i64]
  [program-index : CompilerBackendProgramIndex]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (match result
    [(compiler_ir_types.CompilerIrSpmdCallResult.Unit)
      (ResultCompilerBackend.Ok "")]
    [(compiler_ir_types.CompilerIrSpmdCallResult.Value dst class ty)
      (match class
        [(compiler_ir_types.CompilerIrSpmdValueClass.Uniform)
          (compiler-backend-emit-call-result-store
            type-segment-bases
            assignments
            dst
            ty
            vars
            program-index)]
        [(compiler_ir_types.CompilerIrSpmdValueClass.Varying)
          (match (compiler-backend-vector-dst-reg
            assignments
            dst
            "private SPMD call result"
            "zmm"
            "%zmm14"
            backend-state)
            [(ResultBackendReg.Ok home)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  (if (string.eq home "%zmm16")
                    ""
                    (str_cat.str-cat
                      "    "
                      (compiler-backend-avx512-vector-move ty)
                      " %zmm16, "
                      home
                      "\n"))
                  (compiler-backend-vector-store-dst
                    assignments
                    dst
                    "zmm"
                    ty
                    home
                    backend-state)))]
            [(ResultBackendReg.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler_diagnostic.compiler-diagnostic-with-message
                    instr-diag
                    message)))])]
        [(compiler_ir_types.CompilerIrSpmdValueClass.Mask)
          (match (compiler-backend-avx512-mask-dst-reg
            assignments
            dst
            "private SPMD call mask result"
            "%k7"
            backend-state)
            [(ResultBackendReg.Ok home)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  (if (string.eq home "%k1")
                    ""
                    (str_cat.str-cat "    kmovq %k1, " home "\n" ""))
                  (compiler-backend-avx512-mask-store-dst
                    assignments
                    dst
                    64
                    home
                    backend-state)
                  ""))]
            [(ResultBackendReg.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler_diagnostic.compiler-diagnostic-with-message
                    instr-diag
                    message)))])])]))

(define (compiler-backend-emit-spmd-call-scalar
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [name : i64]
  [active-mask : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [result : compiler_ir_types.CompilerIrSpmdCallResult]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [values : compiler_ir_types.CompilerIrValueList
      (compiler_ir_types.compiler-ir-value-cons
        active-mask
        (compiler-backend-spmd-call-values-from args 0 false))]
    [call-args : compiler_ir_types.CompilerIrCallArgs
      (compiler_ir_types.compiler-ir-call-args-from-list values)]
    [param-types : compiler_ast_types.AstTypeList
      (compiler_ast_types.ast-type-cons
        (compiler_ast_types.AstType.Bool)
        (compiler-backend-spmd-call-types-from args 0 false))]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        call-args
        param-types
        false
        program-index)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      call-args
      param-types
      false
      0
      0
      0
      0
      0
      ""
      instr-diag
      program-index
      vars
      backend-state)
      [(ResultCompilerBackend.Ok args-asm)
        (match (match result
          [(compiler_ir_types.CompilerIrSpmdCallResult.Unit)
            (ResultCompilerBackend.Ok "")]
          [(compiler_ir_types.CompilerIrSpmdCallResult.Value dst _ ty)
            (compiler-backend-emit-call-result-store
              type-segment-bases
              assignments
              dst
              ty
              vars
              program-index)])
          [(ResultCompilerBackend.Ok result-asm)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (compiler-backend-emit-call-space-sub call-space)
                args-asm
                "    call "
                (compiler-backend-call-symbol-index name plan program-index)
                "\n"
                (compiler-backend-emit-call-space-add call-space)
                result-asm))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

(define (compiler-backend-emit-spmd-call-avx512
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [name : i64]
  [lanes : i64]
  [active-mask : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [result : compiler_ir_types.CompilerIrSpmdCallResult]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [uniform-values : compiler_ir_types.CompilerIrValueList
      (compiler-backend-spmd-call-values-from args 0 true)]
    [uniform-args : compiler_ir_types.CompilerIrCallArgs
      (compiler_ir_types.compiler-ir-call-args-from-list uniform-values)]
    [uniform-types : compiler_ast_types.AstTypeList
      (compiler-backend-spmd-call-types-from args 0 true)]
    ;; The private mask block lives below the ordinary outgoing call layout.
    ;; This includes Win64's callee-owned shadow space and every stack-passed
    ;; uniform argument, so neither the callee nor emit-call-args can overwrite
    ;; masks while the call is active.
    [call-space : i64
      (compiler-backend-call-stack-arg-layout-space
        type-segment-bases
        target
        uniform-args
        uniform-types
        false
        program-index)]
    [mask-count : i64 (compiler-backend-spmd-call-class-count args 0 true)]
    [mask-bytes : i64 (* 8 (+ mask-count 1))]
    [mask-space : i64 (* 16 (/ (+ mask-bytes 15) 16))]
    [total-space : i64 (+ call-space mask-space)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      uniform-args
      uniform-types
      false
      0
      0
      0
      0
      0
      ""
      instr-diag
      program-index
      vars
      program-index.backend-state)
      [(ResultCompilerBackend.Ok uniform-asm)
        (match (compiler-backend-spmd-private-vector-args-asm
          type-segment-bases
          assignments
          args
          0
          0
          lanes
          instr-diag
          backend-state)
          [(ResultCompilerBackend.Ok vector-asm)
            (match (compiler-backend-spmd-private-save-mask-value
              assignments
              active-mask
              lanes
              call-space
              instr-diag
              backend-state)
              [(ResultCompilerBackend.Ok active-save)
                (match (compiler-backend-spmd-private-save-mask-args
                  assignments
                  args
                  0
                  0
                  lanes
                  call-space
                  instr-diag
                  backend-state)
                  [(ResultCompilerBackend.Ok mask-saves)
                    (match (compiler-backend-spmd-private-result-store
                      type-segment-bases
                      assignments
                      result
                      vars
                      program-index
                      instr-diag
                      backend-state)
                      [(ResultCompilerBackend.Ok result-asm)
                        (ResultCompilerBackend.Ok
                          (str_cat.str-cat
                            (compiler-backend-emit-call-space-sub total-space)
                            active-save
                            mask-saves
                            "    kmovq "
                            (string.int->string call-space)
                            "(%rsp), %k1\n"
                            (compiler-backend-spmd-private-load-mask-args
                              mask-count
                              0
                              call-space)
                            uniform-asm
                            vector-asm
                            "    call "
                            (compiler-backend-call-symbol-index
                              name
                              plan
                              program-index)
                            "\n"
                            (compiler-backend-emit-call-space-add total-space)
                            result-asm))]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err message)])]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)])]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

(define (compiler-backend-emit-spmd-call-avx2
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [name : i64]
  [lanes : i64]
  [active-mask : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [result : compiler_ir_types.CompilerIrSpmdCallResult]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [uniform-values : compiler_ir_types.CompilerIrValueList
      (compiler-backend-spmd-call-values-from args 0 true)]
    [uniform-args : compiler_ir_types.CompilerIrCallArgs
      (compiler_ir_types.compiler-ir-call-args-from-list uniform-values)]
    [uniform-types : compiler_ast_types.AstTypeList
      (compiler-backend-spmd-call-types-from args 0 true)]
    ;; Keep the private vector block disjoint from ordinary outgoing storage.
    ;; Win64 callees own the first 32 bytes at %rsp, and uniform arguments on
    ;; either ABI may occupy stack slots beyond their register banks.
    [call-space : i64
      (compiler-backend-call-stack-arg-layout-space
        type-segment-bases
        target
        uniform-args
        uniform-types
        false
        program-index)]
    [special-space : i64 (* 32 (compiler-backend-spmd-avx2-special-count args))]
    [total-space : i64 (+ call-space special-space)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      uniform-args
      uniform-types
      false
      0
      0
      0
      0
      0
      ""
      instr-diag
      program-index
      vars
      program-index.backend-state)
      [(ResultCompilerBackend.Ok uniform-asm)
        (match (compiler-backend-spmd-avx2-save-value
          type-segment-bases
          assignments
          active-mask
          (compiler_ast_types.AstType.I8)
          true
          lanes
          call-space
          instr-diag
          backend-state)
          [(ResultCompilerBackend.Ok active-save)
            (match (compiler-backend-spmd-avx2-save-args
              type-segment-bases
              assignments
              args
              0
              1
              lanes
              call-space
              instr-diag
              backend-state)
              [(ResultCompilerBackend.Ok arg-saves)
                (match (compiler-backend-spmd-avx2-result-store
                  type-segment-bases
                  assignments
                  result
                  vars
                  program-index
                  instr-diag
                  backend-state)
                  [(ResultCompilerBackend.Ok result-asm)
                    (ResultCompilerBackend.Ok
                      (str_cat.str-cat
                        (compiler-backend-emit-call-space-sub total-space)
                        active-save
                        arg-saves
                        uniform-asm
                        "    leaq "
                        (string.int->string call-space)
                        "(%rsp), %r10\n    call "
                        (compiler-backend-call-symbol-index
                          name
                          plan
                          program-index)
                        "\n"
                        (compiler-backend-emit-call-space-add total-space)
                        result-asm))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)])]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

(define (compiler-backend-emit-spmd-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [name : i64]
  [backend : compiler_ir_types.CompilerIrSpmdBackend]
  [lanes : i64]
  [active-mask : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [result : compiler_ir_types.CompilerIrSpmdCallResult]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (match backend
    [(compiler_ir_types.CompilerIrSpmdBackend.Scalar)
      (compiler-backend-emit-spmd-call-scalar
        type-segment-bases
        target
        name
        active-mask
        args
        result
        assignments
        plan
        program-index
        vars
        instr-diag
        backend-state)]
    [(compiler_ir_types.CompilerIrSpmdBackend.Avx512)
      (compiler-backend-emit-spmd-call-avx512
        type-segment-bases
        target
        name
        lanes
        active-mask
        args
        result
        assignments
        plan
        program-index
        vars
        instr-diag
        backend-state)]
    [(compiler_ir_types.CompilerIrSpmdBackend.Avx2)
      (compiler-backend-emit-spmd-call-avx2
        type-segment-bases
        target
        name
        lanes
        active-mask
        args
        result
        assignments
        plan
        program-index
        vars
        instr-diag
        backend-state)]))

(define (compiler-backend-c-abi-return-int-reg [idx : i64]) : String
  (if (= idx 0)
    "%rax"
    "%rdx"))

(define (compiler-backend-c-abi-return-sse-reg [idx : i64]) : String
  (if (= idx 0)
    "%xmm0"
    "%xmm1"))

(define (compiler-backend-c-abi-return-slot-addr
  [base-reg : String]
  [offset : i64]) : String
  (str_cat.str-cat (string.int->string offset) "(" base-reg ")"))

(define (compiler-backend-emit-c-abi-return-slot-store
  [type-segment-bases : i64]
  [base-reg : String]
  [slot : compiler_ir_types.CompilerIrCAbiReturnSlot]
  [int-idx : i64]
  [sse-idx : i64]) : String
  (match slot
    [(compiler_ir_types.CompilerIrCAbiReturnSlot.Slot ty offset)
      (let
        [sse? : bool (compiler-backend-float-type? ty)]
        [reg : String
          (if sse?
            (compiler-backend-c-abi-return-sse-reg sse-idx)
            (compiler-backend-c-abi-return-int-reg int-idx))]
        [addr : String
          (compiler-backend-c-abi-return-slot-addr base-reg offset)]
        (if sse?
          (compiler-backend-emit-store-xmm-to-memory addr reg ty)
          (compiler-backend-emit-store-reg-to-memory
            type-segment-bases
            addr
            reg
            ty)))]))

(define (compiler-backend-emit-c-abi-return-slot-stores
  [type-segment-bases : i64]
  [base-reg : String]
  [slots : compiler_ir_types.CompilerIrCAbiReturnSlotSeq]
  [int-idx : i64]
  [sse-idx : i64]) : String
  (compiler-backend-emit-c-abi-return-slot-stores-array
    type-segment-bases
    base-reg
    slots.slots
    0
    slots.len
    int-idx
    sse-idx))

(define (compiler-backend-emit-c-abi-return-slot-stores-array
  [type-segment-bases : i64]
  [base-reg : String]
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrCAbiReturnSlot)]
  [index : i64]
  [count : i64]
  [int-idx : i64]
  [sse-idx : i64]) : String
  (if (>= index count)
    ""
    (let
      [slot : compiler_ir_types.CompilerIrCAbiReturnSlot
        (array-ref slots index)]
      (match slot
        [(compiler_ir_types.CompilerIrCAbiReturnSlot.Slot ty _)
          (let
            [sse? : bool (compiler-backend-float-type? ty)]
            (str_cat.str-cat
              (compiler-backend-emit-c-abi-return-slot-store
                type-segment-bases
                base-reg
                slot
                int-idx
                sse-idx)
              (compiler-backend-emit-c-abi-return-slot-stores-array
                type-segment-bases
                base-reg
                slots
                (+ index 1)
                count
                (if sse?
                  int-idx
                  (+ int-idx 1))
                (if sse?
                  (+ sse-idx 1)
                  sse-idx))))]))))

(define (compiler-backend-scavenge-c-abi-return-base-save-reg
  [planned : String]
  [backend-state : CompilerBackendState]) : String
  (if (string.eq planned "")
    (compiler-backend-scavenge-reg-here
      (compiler-backend-c-abi-stage-exclude-with "%r11")
      compiler-backend-c-abi-stage-exclude-count
      "%r10"
      backend-state)
    planned))

(define (compiler-backend-emit-c-abi-return-base-save
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [save-offset : i64]
  [planned : String]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [base-reg : String
      (compiler-backend-scavenge-c-abi-return-base-save-reg
        planned
        backend-state)]
    (match (compiler-backend-emit-load-value-with-plan
      assignments
      base
      base-reg
      backend-state)
      [(ResultCompilerBackend.Ok base-asm)
        (ResultCompilerBackend.Ok
          (str_cat.str-cat
            base-asm
            (str_cat.str-cat
              "    movq "
              base-reg
              ", "
              (string.int->string save-offset)
              "(%rsp)\n")))]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

(define (compiler-backend-c-abi-return-store-base-exclude) : (__tl_dyn-array
    String)
  (__tl_make-array "%rax" "%rdx"))

(define (compiler-backend-scavenge-c-abi-return-store-base-reg
  [planned : String]
  [backend-state : CompilerBackendState]) : String
  (if (string.eq planned "")
    (compiler-backend-scavenge-reg-here
      (compiler-backend-c-abi-return-store-base-exclude)
      2
      "%r11"
      backend-state)
    planned))

(define (compiler-backend-emit-c-abi-return-stores
  [type-segment-bases : i64]
  [save-offset : i64]
  [slots : compiler_ir_types.CompilerIrCAbiReturnSlotSeq]
  [planned : String]
  [backend-state : CompilerBackendState]) : String
  (let
    [base-reg : String
      (compiler-backend-scavenge-c-abi-return-store-base-reg
        planned
        backend-state)]
    (str_cat.str-cat
      (str_cat.str-cat
        "    movq "
        (string.int->string save-offset)
        "(%rsp), "
        base-reg
        "\n")
      (compiler-backend-emit-c-abi-return-slot-stores
        type-segment-bases
        base-reg
        slots
        0
        0))))

(define (compiler-backend-assignments-use-reg?
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [reg : String]) : bool
  (compiler_regalloc.compiler-reg-assignments-use-register?
    assignments
    (compiler_abi.compiler-abi-register-id-from-spelling reg)))

(define (compiler-backend-emit-entry-load
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [label : i64]
  [ty : compiler_ast_types.AstType]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [r11-occupied : bool
      (compiler-backend-assignments-use-reg? assignments "%r11")]
    [exclude : (__tl_dyn-array String)
      (if r11-occupied
        (compiler-backend-scavenge-exclude-append
          (compiler-backend-scavenge-exclude-with "%r8")
          6
          "%r11")
        (compiler-backend-c-abi-return-store-base-exclude))]
    [exclude-n : i64
      (if r11-occupied
        7
        2)]
    [scratch-reg : String
      (compiler-backend-scavenge-reg dst exclude exclude-n "%r11" backend-state)]
    [scratch-asm : String
      (str_cat.str-cat
        (str_cat.str-cat
          "    movq "
          (compiler_ir_types.compiler-ir-label-text label)
          "(%rip), "
          scratch-reg
          "\n")
        (compiler-backend-emit-store-typed-var-with-plan
          assignments
          dst
          scratch-reg
          ty
          backend-state))]
    (match (compiler-backend-emit-assignment-lookup
      backend-state
      assignments
      dst)
      [(compiler_regalloc.CompilerRegMaybeLocation.Some location)
        (match location
          ;; Entry loads produce one pointer-sized word; aggregate register-pair
          ;; homes stay on the scratch fallback.
          [(compiler_regalloc.CompilerRegLocation.Register home)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                "    movq "
                (compiler_ir_types.compiler-ir-label-text label)
                "(%rip), "
                (compiler_abi.compiler-abi-register-spelling home)
                "\n"))]
          [_ (ResultCompilerBackend.Ok scratch-asm)])]
      [(compiler_regalloc.CompilerRegMaybeLocation.No)
        (ResultCompilerBackend.Ok scratch-asm)])))

(define (compiler-backend-cpuid-result-move [reg-index : i64]) : String
  (cond
    [(= reg-index 0) ""]
    [(= reg-index 1) "    movl %ebx, %eax\n"]
    [(= reg-index 2) "    movl %ecx, %eax\n"]
    [(= reg-index 3) "    movl %edx, %eax\n"]
    [else "    xorq %rax, %rax\n"]))

(define (compiler-backend-emit-cpuid
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [leaf : compiler_ir_types.CompilerIrValue]
  [subleaf : compiler_ir_types.CompilerIrValue]
  [reg-index : i64]
  [planned-save : String]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (match (compiler-backend-emit-load-value-with-plan
    assignments
    subleaf
    "%rcx"
    backend-state)
    [(ResultCompilerBackend.Ok subleaf-asm)
      (match (compiler-backend-emit-load-value-with-plan
        assignments
        leaf
        "%rax"
        backend-state)
        [(ResultCompilerBackend.Ok leaf-asm)
          (let
            [ex : (__tl_dyn-array String) (array.make-array String 3)]
            (begin
              (set! (array-ref ex 0) "%rcx")
              (set! (array-ref ex 1) "%rdx")
              (set! (array-ref ex 2) "%rbx")
              (let
                ;; cpuid clobbers rax/rbx/rcx/rdx; preserve the caller's %rbx in a
                ;; scavenged free reg instead of pushq/popq (the no-stack-staging
                ;; goal). rax/rsi/rdi aren't scavenge candidates, so excluding
                ;; rcx/rdx/rbx leaves the temp in {r8-r15}, none of which cpuid
                ;; touches. Falls back to %r8 / the emergency wrap if none free.
                [scav : String
                  (compiler-backend-planned-or-scavenge-reg-here
                    planned-save
                    ex
                    3
                    "%r8"
                    backend-state)]
                (ResultCompilerBackend.Ok
                  (str_cat.str-cat
                    subleaf-asm
                    leaf-asm
                    (str_cat.str-cat "    movq %rbx, " scav "\n    cpuid\n")
                    (compiler-backend-cpuid-result-move reg-index)
                    (str_cat.str-cat "    movq " scav ", %rbx\n")
                    (compiler-backend-emit-store-typed-var-with-plan
                      assignments
                      dst
                      "%rax"
                      (compiler_ast_types.AstType.I64)
                      backend-state))))))]
        [(ResultCompilerBackend.Err message)
          (ResultCompilerBackend.Err message)])]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-xgetbv
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [index : compiler_ir_types.CompilerIrValue]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (match (compiler-backend-emit-load-value-with-plan
    assignments
    index
    "%rcx"
    backend-state)
    [(ResultCompilerBackend.Ok index-asm)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          index-asm
          "    xgetbv\n    shlq $32, %rdx\n    orq %rdx, %rax\n"
          (compiler-backend-emit-store-typed-var-with-plan
            assignments
            dst
            "%rax"
            (compiler_ast_types.AstType.I64)
            backend-state)))]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

;; Linux syscall argument register for operand position: 0=number, 1..6=args.
(define (compiler-backend-syscall-reg [pos : i64]) : i64
  (cond
    [(= pos 0) compiler_abi.compiler-reg-id-rax]
    [(= pos 1) compiler_abi.compiler-reg-id-rdi]
    [(= pos 2) compiler_abi.compiler-reg-id-rsi]
    [(= pos 3) compiler_abi.compiler-reg-id-rdx]
    [(= pos 4) compiler_abi.compiler-reg-id-r10]
    [(= pos 5) compiler_abi.compiler-reg-id-r8]
    [(= pos 6) compiler_abi.compiler-reg-id-r9]
    [else compiler_abi.compiler-reg-id-rax]))

;; Build the syscall operand -> kernel-arg-register parallel move list. The Linux
;; syscall registers (%rdi/%rsi/%rdx/%r10/%r8/%r9 for args, %rax for the number)
;; are allocator-pooled, so a source operand can already live in a kernel register
;; that a DIFFERENT operand must be moved into. Reuse the call path's BackendArgMove
;; representation so the same sound parallel-move solver
;; (compiler-backend-emit-arg-move-list) resolves any source/dest conflict. The arg
;; positions (1..n) come FIRST and the number (position 0 -> %rax) LAST, matching
;; the prior "number-last" order: with no register source/dest conflict the solver
;; emits the moves in this list order through the same emit-load-value-with-plan the
;; old naive path used, so every conflict-free site stays byte-identical.
(define (compiler-backend-syscall-arg-moves-build-from
  [args : compiler_ir_types.CompilerIrCallArgs]
  [index : i64]
  [count : i64]) : CompilerBackendArgMoveSeq
  (let
    [out : CompilerBackendArgMoveSeq
      (compiler-backend-arg-move-seq-with-capacity 0)]
    [i : i64 index]
    (begin
      (while (< i count)
        (begin
          (compiler-backend-arg-move-push!
            (&mut out)
            (BackendArgMove
              (compiler-backend-syscall-reg i)
              (BackendArgMoveValue (compiler-backend-call-arg-at args i))))
          (set! i (+ i 1))))
      ;; Number-last: position 0 -> %rax is the final move in the list.
      (compiler-backend-arg-move-push!
        (&mut out)
        (BackendArgMove
          (compiler-backend-syscall-reg 0)
          (BackendArgMoveValue (compiler-backend-call-arg-at args 0))))
      out)))

(define (compiler-backend-syscall-arg-moves-build
  [args : compiler_ir_types.CompilerIrCallArgs]
  [count : i64]) : CompilerBackendArgMoveSeq
  (compiler-backend-syscall-arg-moves-build-from args 1 count))

;; `syscall` clobbers %rcx/%r11 and uses Linux syscall arg registers. The primary
;; integer pool is callee-saved, and the scalar caller-saved extension rejects
;; intervals spanning syscall points, so no live register home can be lost; the
;; raw kernel result lands in %rax -> dst. The raw `syscall` instruction and its
;; register ABI are Linux x86_64 only; emitting it for any other target would
;; silently miscompile, so reject it instead.
;;
;; The operand -> kernel-register setup goes through the SAME parallel-move solver
;; the call path uses. Now that the kernel arg registers are pooled, an operand can
;; be homed in a kernel register that is another operand's destination (incl. the
;; number's %rax). A naive ascending emit could clobber such a source before it is
;; read (the same aliasing/overwrite hazard fixed for call args); the solver
;; emits the moves in a safe order and breaks true cycles
;; with a scavenged temp. Conflict-free sites stay byte-identical (see the builder).
(define (compiler-backend-emit-syscall
  [target : CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (if (compiler-backend-target-windows? target)
    (ResultCompilerBackend.Err
      (box
        (compiler_diagnostic.compiler-diagnostic-at-start
          ""
          "backend: syscall is only supported on the linux-x86_64 target")))
    (let
      [count : i64 (compiler-backend-call-args-count args)]
      (match (compiler-backend-emit-arg-move-list
        assignments
        (compiler-backend-syscall-arg-moves-build args count)
        backend-state)
        [(ResultCompilerBackend.Ok setup-asm)
          (ResultCompilerBackend.Ok
            (str_cat.str-cat
              setup-asm
              "    syscall\n"
              (compiler-backend-emit-call-result-store-reg
                assignments
                dst
                "%rax"
                (compiler_ast_types.AstType.I64)
                backend-state)))]
        [(ResultCompilerBackend.Err message)
          (ResultCompilerBackend.Err message)]))))

(define (compiler-backend-switch-phi-target-message) : String
  "backend: CompilerIrInstr.Switch target requires unsupported phi edge copies")

(define (compiler-backend-switch-shape-message) : String
  "backend: CompilerIrInstr.Switch requires non-empty contiguous ordered cases")

(define (compiler-backend-switch-case-count
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]) : i64
  (compiler_ir_types.compiler-ir-switch-case-list-count cases))

(define (compiler-backend-switch-cases-contiguous-from?
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [expected : i64]) : bool
  (match cases
    [(compiler_ir_types.CompilerIrSwitchCaseList.Nil) true]
    [(compiler_ir_types.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(compiler_ir_types.CompilerIrSwitchCase.Case tag _)
          (and
            (= tag expected)
            (compiler-backend-switch-cases-contiguous-from?
              (__tl-box-place rest)
              (+ expected 1)))])]
    [(compiler_ir_types.CompilerIrSwitchCaseList.Array seq)
      (compiler-backend-switch-cases-contiguous-from?
        (compiler_ir_types.compiler-ir-switch-case-seq-to-list seq)
        expected)]))

(define (compiler-backend-total-switch-trap-instrs?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [label : i64]) : bool
  (and
    (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 2)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
      [(compiler_ir_types.CompilerIrInstr.Call _ name _ _)
        (cbi.compiler-builtin-backend-tl-oob-abort-id? name)]
      [_ false])
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 1)
      [(compiler_ir_types.CompilerIrInstr.Jump target) (= target label)]
      [_ false])))

(define (compiler-backend-total-switch-trap-block-from?
  [all-blocks : compiler_ir_types.CompilerIrBlockList]
  [cursor : compiler_ir_types.CompilerIrBlockList]
  [label : i64]
  [trap-label : i64]
  [fuel : i64]) : bool
  (if (<= fuel 0)
    false
    (match cursor
      [(compiler_ir_types.CompilerIrBlockList.Nil) false]
      [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block block-label instrs)
            (if (= block-label label)
              (if (= label trap-label)
                (compiler-backend-total-switch-trap-instrs? instrs label)
                ;; Loop canonicalization may retarget the default through a
                ;; jump-only preheader. The separately carried trap label is
                ;; the authority; display text is never consulted.
                (and
                  (= (compiler_ir_types.compiler-ir-instr-seq-count instrs) 1)
                  (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs 0)
                    [(compiler_ir_types.CompilerIrInstr.Jump target)
                      (and
                        (not (= target label))
                        (compiler-backend-total-switch-trap-block-from?
                          all-blocks
                          all-blocks
                          target
                          trap-label
                          (- fuel 1)))]
                    [_ false])))
              (compiler-backend-total-switch-trap-block-from?
                all-blocks
                (__tl-box-place rest)
                label
                trap-label
                fuel))])]
      [(compiler_ir_types.CompilerIrBlockList.Array seq)
        (compiler-backend-total-switch-trap-block-from?
          all-blocks
          (compiler_ir_types.compiler-ir-block-seq-to-list seq)
          label
          trap-label
          fuel)])))

(define (compiler-backend-total-switch-trap-block?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [label : i64]
  [trap-label : i64]) : bool
  (and
    (!= trap-label (compiler_ir_types.compiler-ir-label-none))
    (compiler-backend-total-switch-trap-block-from?
      blocks
      blocks
      label
      trap-label
      8)))

(define (compiler-backend-total-switch?
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [base : i64]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [default-label : i64]
  [trap-label : i64]) : bool
  (and
    (= base 0)
    (> (compiler-backend-switch-case-count cases) 0)
    (compiler-backend-switch-cases-contiguous-from? cases 0)
    (compiler-backend-total-switch-trap-block? blocks default-label trap-label)))

(define (compiler-backend-object-total-switch?
  [base : i64]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [trap-label : i64]) : bool
  (and
    (= base 0)
    (> (compiler-backend-switch-case-count cases) 0)
    (compiler-backend-switch-cases-contiguous-from? cases 0)
    ;; Direct-object emission consumes the explicit switch variant and trap
    ;; provenance. Source assembly additionally validates the abort block.
    (!= trap-label (compiler_ir_types.compiler-ir-label-none))))

(define (compiler-backend-switch-cases-target-phi?
  [targets : BackendSymbolSeq]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]) : bool
  (match cases
    [(compiler_ir_types.CompilerIrSwitchCaseList.Nil) false]
    [(compiler_ir_types.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(compiler_ir_types.CompilerIrSwitchCase.Case _ label)
          (or
            (compiler-backend-symbol-list-contains-id? targets label)
            (compiler-backend-switch-cases-target-phi?
              targets
              (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrSwitchCaseList.Array seq)
      (compiler-backend-switch-cases-target-phi?
        targets
        (compiler_ir_types.compiler-ir-switch-case-seq-to-list seq))]))

(define (compiler-backend-switch-target-phi?
  [targets : BackendSymbolSeq]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [default-label : i64]) : bool
  (if (= targets.len 0)
    false
    (or
      (compiler-backend-symbol-list-contains-id? targets default-label)
      (compiler-backend-switch-cases-target-phi? targets cases))))

;; A switch case value spells part of the edge block's label, and a case value
;; may be NEGATIVE: a dense switch is built from whatever integers the arms
;; carry, and folding or inlining can leave a table whose lowest case is below
;; zero (the emitted base is then subtracted, `subq $-109, %reg`). `-` is an
;; operator in the assembler's expression grammar and not a symbol character,
;; so a label spelled `..._switch_case_-105:` is not read as a label at all --
;; `as` sees a line starting with `.` and reports `unknown pseudo-op`. Spell a
;; negative tag with a leading `m` instead. The mapping stays injective because
;; a decimal tag never contains `m`, and the common non-negative tag pays
;; nothing for it.
(define (compiler-backend-switch-case-tag-text [tag : i64]) : String
  (let
    [digits : String (string.int->string tag)]
    (if (< tag 0)
      (string.replace digits "-" "m")
      digits)))

(define (compiler-backend-switch-case-edge-label
  [current-label : i64]
  [tag : i64]) : i64
  (compiler_ir_types.compiler-ir-label
    (str_cat.str-cat
      (compiler_ir_types.compiler-ir-label-text current-label)
      "_switch_case_"
      (compiler-backend-switch-case-tag-text tag))))

(define (compiler-backend-switch-default-edge-label [current-label : i64]) : i64
  (compiler_ir_types.compiler-ir-label
    (str_cat.str-cat
      (compiler_ir_types.compiler-ir-label-text current-label)
      "_switch_default")))

(define (compiler-backend-emit-switch-edge-block
  [function : String]
  [edge-label : i64]
  [target-label : i64]
  [copies : String]) : String
  (str_cat.str-cat
    (compiler-backend-asm-label function edge-label)
    ":\n"
    (str_cat.str-cat
      copies
      (compiler-backend-jump-label function target-label)
      "")))

(define (compiler-backend-emit-switch-case-edge-blocks
  [type-segment-bases : i64]
  [function : String]
  [current-label : i64]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [planned-cycle : String]
  [planned-stage : String]) : ResultCompilerBackend
  (let
    [targets : BackendSymbolSeq
      (compiler-backend-function-state-phi-targets
        (compiler-backend-state-function-state program-index.backend-state))]
    (match cases
      [(compiler_ir_types.CompilerIrSwitchCaseList.Nil)
        (ResultCompilerBackend.Ok "")]
      [(compiler_ir_types.CompilerIrSwitchCaseList.Cons case rest)
        (match case
          [(compiler_ir_types.CompilerIrSwitchCase.Case tag label)
            (if (compiler-backend-symbol-list-contains-id? targets label)
              (match (compiler-backend-emit-phi-edge-copies
                type-segment-bases
                assignments
                blocks
                label
                current-label
                program-index
                vars
                planned-cycle
                planned-stage
                "")
                [(ResultCompilerBackend.Ok copies)
                  (match (compiler-backend-emit-switch-case-edge-blocks
                    type-segment-bases
                    function
                    current-label
                    (__tl-box-place rest)
                    assignments
                    blocks
                    program-index
                    vars
                    planned-cycle
                    planned-stage)
                    [(ResultCompilerBackend.Ok rest-blocks)
                      (ResultCompilerBackend.Ok
                        (str_cat.str-cat
                          (compiler-backend-emit-switch-edge-block
                            function
                            (compiler-backend-switch-case-edge-label
                              current-label
                              tag)
                            label
                            copies)
                          rest-blocks))]
                    [(ResultCompilerBackend.Err message)
                      (ResultCompilerBackend.Err message)])]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)])
              (compiler-backend-emit-switch-case-edge-blocks
                type-segment-bases
                function
                current-label
                (__tl-box-place rest)
                assignments
                blocks
                program-index
                vars
                planned-cycle
                planned-stage))])]
      [(compiler_ir_types.CompilerIrSwitchCaseList.Array seq)
        (compiler-backend-emit-switch-case-edge-blocks
          type-segment-bases
          function
          current-label
          (compiler_ir_types.compiler-ir-switch-case-seq-to-list seq)
          assignments
          blocks
          program-index
          vars
          planned-cycle
          planned-stage)])))

(define (compiler-backend-switch-table-label
  [function : String]
  [current-label : i64]) : String
  (compiler-backend-asm-label
    function
    (compiler_ir_types.compiler-ir-label
      (str_cat.str-cat
        (compiler_ir_types.compiler-ir-label-text current-label)
        "_switch_table"
        ""))))

(define (compiler-backend-emit-switch-table-cases-into
  [function : String]
  [current-label : i64]
  [retarget-phi-edges : bool]
  [targets : BackendSymbolSeq]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match cases
    [(compiler_ir_types.CompilerIrSwitchCaseList.Nil) buf]
    [(compiler_ir_types.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(compiler_ir_types.CompilerIrSwitchCase.Case tag label)
          (compiler-backend-emit-switch-table-cases-into
            function
            current-label
            retarget-phi-edges
            targets
            (__tl-box-place rest)
            (text_buf.append
              (text_buf.append
                (text_buf.append buf "    .quad ")
                (compiler-backend-asm-label
                  function
                  (if (and
                    retarget-phi-edges
                    (compiler-backend-symbol-list-contains-id? targets label))
                    (compiler-backend-switch-case-edge-label current-label tag)
                    label)))
              "\n"))])]
    [(compiler_ir_types.CompilerIrSwitchCaseList.Array seq)
      (compiler-backend-emit-switch-table-cases-into
        function
        current-label
        retarget-phi-edges
        targets
        (compiler_ir_types.compiler-ir-switch-case-seq-to-list seq)
        buf)]))

(define (compiler-backend-emit-switch-table
  [function : String]
  [current-label : i64]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [retarget-phi-edges : bool]
  [targets : BackendSymbolSeq]) : String
  (text_buf.render
    (compiler-backend-emit-switch-table-cases-into
      function
      current-label
      retarget-phi-edges
      targets
      cases
      (text_buf.append
        (text_buf.append
          (text_buf.append
            (text_buf.empty)
            "    .section .rodata\n    .balign 8\n")
          (compiler-backend-switch-table-label function current-label))
        ":\n"))))

(define (compiler-backend-emit-switch-tables-instr-seq-into
  [function : String]
  [current-label : i64]
  [targets : BackendSymbolSeq]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    buf
    (compiler-backend-emit-switch-tables-instr-seq-into
      function
      current-label
      targets
      instrs
      (+ index 1)
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
        [(compiler_ir_types.CompilerIrInstr.Switch _ _ cases default-label)
          (text_buf.append
            buf
            (compiler-backend-emit-switch-table
              function
              current-label
              cases
              (compiler-backend-switch-target-phi? targets cases default-label)
              targets))]
        [(compiler_ir_types.CompilerIrInstr.TotalEnumSwitch
            _
            _
            cases
            default-label
            _)
          (text_buf.append
            buf
            (compiler-backend-emit-switch-table
              function
              current-label
              cases
              (compiler-backend-switch-target-phi? targets cases default-label)
              targets))]
        [_ buf]))))

(define (compiler-backend-emit-switch-tables-seq-into
  [function : String]
  [targets : BackendSymbolSeq]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    buf
    (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
      [(compiler_ir_types.CompilerIrBlock.Block label instrs)
        (compiler-backend-emit-switch-tables-seq-into
          function
          targets
          blocks
          (+ index 1)
          (compiler-backend-emit-switch-tables-instr-seq-into
            function
            label
            targets
            instrs
            0
            buf))])))

(define (compiler-backend-emit-switch-tables-blocks-into
  [function : String]
  [targets : BackendSymbolSeq]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) buf]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block label instrs)
          (compiler-backend-emit-switch-tables-blocks-into
            function
            targets
            (__tl-box-place rest)
            (compiler-backend-emit-switch-tables-instr-seq-into
              function
              label
              targets
              instrs
              0
              buf))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-emit-switch-tables-seq-into function targets seq 0 buf)]))

(define (compiler-backend-emit-switch-tables-functions-into
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match functions
    [(compiler_ir_types.CompilerIrFunctionList.Nil) buf]
    [(compiler_ir_types.CompilerIrFunctionList.Cons func rest)
      (match func
        [(compiler_ir_types.CompilerIrFunction.Function name _ _ _ blocks)
          (let
            [_phi-targets : unit
              (compiler-backend-function-state-install-phi-targets!
                (compiler-backend-state-function-state
                  program-index.backend-state)
                (compiler-backend-phi-target-labels-for-blocks blocks))]
            (compiler-backend-emit-switch-tables-functions-into
              (__tl-box-place rest)
              program-index
              (match blocks
                [(compiler_ir_types.CompilerIrBlockList.Array seq)
                  (compiler-backend-emit-switch-tables-seq-into
                    (compiler-backend-function-label-scope program-index name)
                    (compiler-backend-function-state-phi-targets
                      (compiler-backend-state-function-state
                        program-index.backend-state))
                    seq
                    0
                    buf)]
                [_
                  (compiler-backend-emit-switch-tables-blocks-into
                    (compiler-backend-function-label-scope program-index name)
                    (compiler-backend-function-state-phi-targets
                      (compiler-backend-state-function-state
                        program-index.backend-state))
                    blocks
                    buf)])))])]
    [(compiler_ir_types.CompilerIrFunctionList.Array seq)
      (compiler-backend-emit-switch-tables-function-seq-into
        seq
        program-index
        0
        buf)]))

(define (compiler-backend-emit-switch-tables-function-seq-into
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [program-index : CompilerBackendProgramIndex]
  [index : i64]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (>= index (compiler_ir_types.compiler-ir-function-seq-count functions))
    buf
    (match (compiler_ir_types.compiler-ir-function-seq-ref functions index)
      [(compiler_ir_types.CompilerIrFunction.Function name _ _ _ blocks)
        (let
          [_phi-targets : unit
            (compiler-backend-function-state-install-phi-targets!
              (compiler-backend-state-function-state
                program-index.backend-state)
              (compiler-backend-phi-target-labels-for-blocks blocks))]
          (compiler-backend-emit-switch-tables-function-seq-into
            functions
            program-index
            (+ index 1)
            (match blocks
              [(compiler_ir_types.CompilerIrBlockList.Array seq)
                (compiler-backend-emit-switch-tables-seq-into
                  (compiler-backend-function-label-scope program-index name)
                  (compiler-backend-function-state-phi-targets
                    (compiler-backend-state-function-state
                      program-index.backend-state))
                  seq
                  0
                  buf)]
              [_
                (compiler-backend-emit-switch-tables-blocks-into
                  (compiler-backend-function-label-scope program-index name)
                  (compiler-backend-function-state-phi-targets
                    (compiler-backend-state-function-state
                      program-index.backend-state))
                  blocks
                  buf)])))])))

;; Sound emergency-scavenge dispatch (GAP2b-v2). When the register pool is
;; saturated at a switch dispatch, one or both of the index / jump-table-base
;; scratches is EMERGENCY-borrowed from a live occupant. The enclosing
;; emergency-wrap saves that occupant BEFORE this head and would normally
;; restore it AFTER -- but the borrowed register is consumed by the indirect
;; `jmp *`, a control transfer, so a trailing restore lands on UNREACHABLE code
;; (dead on every taken arm AND on the `ja default` edge). The occupant would
;; then arrive in the successor blocks holding the jump-table / arm address (the
;; GAP2b vm_run miscompile: an arm's bounds check compared against a code
;; pointer).
;; Fix: compute the FINAL target block address (an arm's, or the default block's
;; when out of range) into table-reg, STASH it into a dedicated frame slot,
;; restore every borrowed occupant INLINE (emergency-restore-before-jumps, which
;; sets restore-suppressed so the wrap omits its now-redundant trailing
;; restore), then jump SLOT-INDIRECT through the stash. Both borrowed registers
;; are dead by the stash, so every occupant is restored on the single path that
;; reaches the transfer; the provisional `leaq default` folds the out-of-range
;; edge into the same restore+jump so the default path is covered too. The
;; target slot sits one past the borrowed emergency slots (at index
;; emergency-pending-count); used-count is bumped so the frame reserves it.
;; The rsp-rebase (FPO) pass rewrites the `-K(%rbp)` stash-store and
;; `jmp *-K(%rbp)` like any other frame reference (delta 0, no rsp motion).
(define (compiler-backend-emit-switch-dispatch-emergency
  [function : String]
  [current-label : i64]
  [default-label : i64]
  [total-switch : bool]
  [case-count : i64]
  [base : i64]
  [index-reg : String]
  [table-reg : String]
  [load-index : String]
  [backend-state : CompilerBackendState]) : String
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [target-idx : i64
      (compiler-backend-function-scratch-i64
        function-state
        compiler-backend-scratch-i64-emergency-pending-count)]
    [target-slot : String
      (compiler-backend-frame-offset-with-backend-state
        backend-state
        (compiler-backend-emergency-reg-offset function-state target-idx))]
    [_reserve-target-slot : unit
      (if (<
        (compiler-backend-function-scratch-i64
          function-state
          compiler-backend-scratch-i64-emergency-used-count)
        (+ target-idx 1))
        (compiler-backend-function-scratch-set-i64!
          function-state
          compiler-backend-scratch-i64-emergency-used-count
          (+ target-idx 1))
        unit)]
    [done-label : String
      (compiler-backend-asm-label
        function
        (compiler_ir_types.compiler-ir-label
          (str_cat.str-cat
            (compiler_ir_types.compiler-ir-label-text current-label)
            "_disp_j"
            "")))]
    ;; Emits the borrowed-occupant restores here (before the transfer) and
    ;; suppresses the wrap's trailing restore. Must be spliced AFTER the target
    ;; stash and BEFORE the indirect jump.
    [restore : String
      (compiler-backend-emergency-restore-before-jumps backend-state)]
    (if total-switch
      (str_cat.str-cat
        load-index
        (if (= base 0)
          ""
          (str_cat.str-cat
            "    subq $"
            (string.int->string base)
            ", "
            index-reg
            "\n"
            ""))
        "    leaq "
        (compiler-backend-switch-table-label function current-label)
        "(%rip), "
        table-reg
        "\n    movq ("
        table-reg
        ","
        index-reg
        ",8), "
        table-reg
        "\n    movq "
        table-reg
        ", "
        target-slot
        "\n"
        restore
        "    jmp *"
        target-slot
        "\n")
      (str_cat.str-cat
        load-index
        (if (= base 0)
          ""
          (str_cat.str-cat
            "    subq $"
            (string.int->string base)
            ", "
            index-reg
            "\n"
            ""))
        "    leaq "
        (compiler-backend-asm-label function default-label)
        "(%rip), "
        table-reg
        "\n    cmpq $"
        (string.int->string (- case-count 1))
        ", "
        index-reg
        "\n    ja "
        done-label
        "\n    leaq "
        (compiler-backend-switch-table-label function current-label)
        "(%rip), "
        table-reg
        "\n    movq ("
        table-reg
        ","
        index-reg
        ",8), "
        table-reg
        "\n"
        done-label
        ":\n    movq "
        table-reg
        ", "
        target-slot
        "\n"
        restore
        "    jmp *"
        target-slot
        "\n"))))

;; The same GAP2b hazard on the absolute (non-PIC) dispatch form, which has no
;; table register to stash through and so was left splicing the inline restore
;; straight into the sequence. That splice is correct for a conditional branch
;; -- emergency-restore-before-jumps documents its precondition as "the
;; scavenged scratch is dead after the compare, because the jumps read EFLAGS,
;; not the register" -- and it is false here: `jmp *table(,index-reg,8)` reads
;; the index register, and the `subq $base` that computed the index wrote it
;; into the very register the restore overwrites. The emitted code then
;; dispatches on the restored occupant.
;;
;; Same fix as the PIC path, one register short: the final target address is
;; resolved into the index register itself -- the table entry when in range, a
;; `leaq` of the default block when not -- stashed to the dedicated slot, and
;; only then are the occupants restored and the slot-indirect jump taken. The
;; index is dead from the stash onward, so every occupant is restored exactly
;; once on the single path reaching the transfer.
(define (compiler-backend-emit-switch-dispatch-absolute-emergency
  [function : String]
  [current-label : i64]
  [default-label : i64]
  [total-switch : bool]
  [case-count : i64]
  [base : i64]
  [index-reg : String]
  [load-index : String]
  [backend-state : CompilerBackendState]) : String
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [target-idx : i64
      (compiler-backend-function-scratch-i64
        function-state
        compiler-backend-scratch-i64-emergency-pending-count)]
    [target-slot : String
      (compiler-backend-frame-offset-with-backend-state
        backend-state
        (compiler-backend-emergency-reg-offset function-state target-idx))]
    [_reserve-target-slot : unit
      (if (<
        (compiler-backend-function-scratch-i64
          function-state
          compiler-backend-scratch-i64-emergency-used-count)
        (+ target-idx 1))
        (compiler-backend-function-scratch-set-i64!
          function-state
          compiler-backend-scratch-i64-emergency-used-count
          (+ target-idx 1))
        unit)]
    [table-label : String
      (compiler-backend-switch-table-label function current-label)]
    [done-label : String
      (compiler-backend-asm-label
        function
        (compiler_ir_types.compiler-ir-label
          (str_cat.str-cat
            (compiler_ir_types.compiler-ir-label-text current-label)
            "_disp_j"
            "")))]
    [default-stub-label : String
      (compiler-backend-asm-label
        function
        (compiler_ir_types.compiler-ir-label
          (str_cat.str-cat
            (compiler_ir_types.compiler-ir-label-text current-label)
            "_disp_d"
            "")))]
    [rebase : String
      (if (= base 0)
        ""
        (str_cat.str-cat
          "    subq $"
          (string.int->string base)
          ", "
          index-reg
          "\n"
          ""))]
    ;; Emitted after the last read of index-reg, before the transfer.
    [restore : String
      (compiler-backend-emergency-restore-before-jumps backend-state)]
    (if total-switch
      (str_cat.str-cat
        load-index
        rebase
        "    movq "
        table-label
        "(,"
        index-reg
        ",8), "
        index-reg
        "\n    movq "
        index-reg
        ", "
        target-slot
        "\n"
        restore
        "    jmp *"
        target-slot
        "\n")
      (str_cat.str-cat
        load-index
        rebase
        "    cmpq $"
        (string.int->string (- case-count 1))
        ", "
        index-reg
        "\n    ja "
        default-stub-label
        "\n    movq "
        table-label
        "(,"
        index-reg
        ",8), "
        index-reg
        "\n    jmp "
        done-label
        "\n"
        default-stub-label
        ":\n    leaq "
        (compiler-backend-asm-label function default-label)
        "(%rip), "
        index-reg
        "\n"
        done-label
        ":\n    movq "
        index-reg
        ", "
        target-slot
        "\n"
        restore
        "    jmp *"
        target-slot
        "\n"))))

(define (compiler-backend-emit-switch-dispatch
  [backend-state : CompilerBackendState]
  [function : String]
  [current-label : i64]
  [index : compiler_ir_types.CompilerIrValue]
  [base : i64]
  [case-count : i64]
  [default-label : i64]
  [total-switch : bool]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-index-reg : String]
  [planned-table-reg : String]) : ResultCompilerBackend
  (let
    [index-home : String
      (compiler-backend-value-scalar-register backend-state assignments index)]
    [need-index-scratch : bool (or (not (= base 0)) (string.eq index-home ""))]
    [index-exclude : (__tl_dyn-array String)
      (if (and need-index-scratch (not (string.eq index-home "")))
        (compiler-backend-one-exclude index-home)
        (array.make-array String 0))]
    [index-exclude-n : i64
      (if (and need-index-scratch (not (string.eq index-home "")))
        1
        0)]
    [index-reg : String
      (if need-index-scratch
        (if (string.eq planned-index-reg "")
          (compiler-backend-scavenge-reg-here
            index-exclude
            index-exclude-n
            "%r8"
            backend-state)
          planned-index-reg)
        index-home)]
    [table-exclude : (__tl_dyn-array String)
      (compiler-backend-one-exclude index-reg)]
    [table-reg : String
      (if (compiler-backend-state-absolute-switch-ok? backend-state)
        ""
        (if (string.eq planned-table-reg "")
          (compiler-backend-scavenge-reg-here
            table-exclude
            1
            "%r9"
            backend-state)
          planned-table-reg))]
    [index-load : ResultCompilerBackend
      (if need-index-scratch
        (compiler-backend-emit-load-value-with-plan
          assignments
          index
          index-reg
          backend-state)
        (ResultCompilerBackend.Ok ""))]
    (match index-load
      [(ResultCompilerBackend.Ok load-index)
        (ResultCompilerBackend.Ok
          ;; lint-allow: nested-if-ladder
          (if (and
            (compiler-backend-state-absolute-switch-ok? backend-state)
            (compiler-backend-function-scratch-bool?
              (compiler-backend-state-function-state backend-state)
              compiler-backend-scratch-bool-emergency-pending))
            ;; GAP2b on the absolute form: the index register is live through
            ;; the indirect jump, so the restore cannot precede it.
            (compiler-backend-emit-switch-dispatch-absolute-emergency
              function
              current-label
              default-label
              total-switch
              case-count
              base
              index-reg
              load-index
              backend-state)
            (if (compiler-backend-state-absolute-switch-ok? backend-state)
              ;; Absolute indexed form (non-PIC Linux): no table register at
              ;; all, so the dispatch never borrows one. Pending emergency
              ;; occupants from earlier borrows take the slot-indirect form
              ;; above; this arm has none to restore.
              (if total-switch
                (str_cat.str-cat
                  load-index
                  (if (= base 0)
                    ""
                    (str_cat.str-cat
                      "    subq $"
                      (string.int->string base)
                      ", "
                      index-reg
                      "\n"
                      ""))
                  "    jmp *"
                  (compiler-backend-switch-table-label function current-label)
                  "(,"
                  index-reg
                  ",8)\n")
                (str_cat.str-cat
                  load-index
                  (if (= base 0)
                    ""
                    (str_cat.str-cat
                      "    subq $"
                      (string.int->string base)
                      ", "
                      index-reg
                      "\n"
                      ""))
                  "    cmpq $"
                  (string.int->string (- case-count 1))
                  ", "
                  index-reg
                  "\n    ja "
                  (compiler-backend-asm-label function default-label)
                  "\n    jmp *"
                  (compiler-backend-switch-table-label function current-label)
                  "(,"
                  index-reg
                  ",8)\n"))
              (if (compiler-backend-function-scratch-bool?
                (compiler-backend-state-function-state backend-state)
                compiler-backend-scratch-bool-emergency-pending)
                ;; GAP2b-v2: a scratch was emergency-borrowed from a live occupant;
                ;; a trailing restore after the indirect jmp is unreachable. Emit the
                ;; slot-indirect form with the restore BEFORE the transfer.
                (compiler-backend-emit-switch-dispatch-emergency
                  function
                  current-label
                  default-label
                  total-switch
                  case-count
                  base
                  index-reg
                  table-reg
                  load-index
                  backend-state)
                (if total-switch
                  (str_cat.str-cat
                    load-index
                    (if (= base 0)
                      ""
                      (str_cat.str-cat
                        "    subq $"
                        (string.int->string base)
                        ", "
                        index-reg
                        "\n"
                        ""))
                    "    leaq "
                    (compiler-backend-switch-table-label function current-label)
                    "(%rip), "
                    table-reg
                    "\n    jmp *("
                    table-reg
                    ","
                    index-reg
                    ",8)\n")
                  (str_cat.str-cat
                    load-index
                    (if (= base 0)
                      ""
                      (str_cat.str-cat
                        "    subq $"
                        (string.int->string base)
                        ", "
                        index-reg
                        "\n"
                        ""))
                    "    cmpq $"
                    (string.int->string (- case-count 1))
                    ", "
                    index-reg
                    "\n    ja "
                    (compiler-backend-asm-label function default-label)
                    "\n    leaq "
                    (compiler-backend-switch-table-label function current-label)
                    "(%rip), "
                    table-reg
                    "\n    jmp *("
                    table-reg
                    ","
                    index-reg
                    ",8)\n"))))))]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

(define (compiler-backend-emit-switch
  [type-segment-bases : i64]
  [function : String]
  [current-label : i64]
  [index : compiler_ir_types.CompilerIrValue]
  [base : i64]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [default-label : i64]
  [trap-label : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-index-reg : String]
  [planned-table-reg : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]) : ResultCompilerBackend
  (let
    [case-count : i64 (compiler-backend-switch-case-count cases)]
    [total-switch : bool
      (compiler-backend-total-switch?
        blocks
        base
        cases
        default-label
        trap-label)]
    (cond
      [(= case-count 0)
        (ResultCompilerBackend.Err
          (box
            (compiler_diagnostic.compiler-diagnostic-at-start
              ""
              (compiler-backend-switch-shape-message))))]
      [(not (compiler-backend-switch-cases-contiguous-from? cases base))
        (ResultCompilerBackend.Err
          (box
            (compiler_diagnostic.compiler-diagnostic-at-start
              ""
              (compiler-backend-switch-shape-message))))]
      [(compiler-backend-switch-target-phi?
          (compiler-backend-function-state-phi-targets
            (compiler-backend-state-function-state program-index.backend-state))
          cases
          default-label)
        (match (compiler-backend-emit-switch-case-edge-blocks
          type-segment-bases
          function
          current-label
          cases
          assignments
          blocks
          program-index
          vars
          planned-index-reg
          planned-table-reg)
          [(ResultCompilerBackend.Ok case-blocks)
            (let
              [default-needs-edge : bool
                (compiler-backend-symbol-list-contains-id?
                  (compiler-backend-function-state-phi-targets
                    (compiler-backend-state-function-state
                      program-index.backend-state))
                  default-label)]
              (match (if default-needs-edge
                (match (compiler-backend-emit-phi-edge-copies
                  type-segment-bases
                  assignments
                  blocks
                  default-label
                  current-label
                  program-index
                  vars
                  planned-index-reg
                  planned-table-reg
                  "")
                  [(ResultCompilerBackend.Ok copies)
                    (ResultCompilerBackend.Ok
                      (compiler-backend-emit-switch-edge-block
                        function
                        (compiler-backend-switch-default-edge-label
                          current-label)
                        default-label
                        copies))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])
                (ResultCompilerBackend.Ok ""))
                [(ResultCompilerBackend.Ok default-block)
                  (match (compiler-backend-emit-switch-dispatch
                    program-index.backend-state
                    function
                    current-label
                    index
                    base
                    case-count
                    (if default-needs-edge
                      (compiler-backend-switch-default-edge-label current-label)
                      default-label)
                    total-switch
                    assignments
                    planned-index-reg
                    planned-table-reg)
                    [(ResultCompilerBackend.Ok dispatch)
                      (ResultCompilerBackend.Ok
                        (str_cat.str-cat dispatch case-blocks default-block))]
                    [(ResultCompilerBackend.Err message)
                      (ResultCompilerBackend.Err message)])]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)]))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])]
      [else
        (match (compiler-backend-emit-switch-dispatch
          program-index.backend-state
          function
          current-label
          index
          base
          case-count
          default-label
          total-switch
          assignments
          planned-index-reg
          planned-table-reg)
          [(ResultCompilerBackend.Ok dispatch)
            (ResultCompilerBackend.Ok dispatch)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])])))

(define (compiler-backend-switch-validate-one
  [targets : BackendSymbolSeq]
  [base : i64]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [default-label : i64]) : CompilerBackendSwitchValidation
  (let
    [case-count : i64 (compiler-backend-switch-case-count cases)]
    (cond
      [(= case-count 0)
        (CompilerBackendSwitchValidation.Err
          (compiler-backend-switch-shape-message))]
      [(not (compiler-backend-switch-cases-contiguous-from? cases base))
        (CompilerBackendSwitchValidation.Err
          (compiler-backend-switch-shape-message))]
      [(compiler-backend-switch-target-phi? targets cases default-label)
        (CompilerBackendSwitchValidation.Err
          (compiler-backend-switch-phi-target-message))]
      [else (CompilerBackendSwitchValidation.Ok)])))

(define (compiler-backend-switch-validate-instr
  [targets : BackendSymbolSeq]
  [instr : compiler_ir_types.CompilerIrInstr]) : CompilerBackendSwitchValidation
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Switch _ base cases default-label)
      (compiler-backend-switch-validate-one targets base cases default-label)]
    [(compiler_ir_types.CompilerIrInstr.TotalEnumSwitch
        _
        base
        cases
        default-label
        _)
      (compiler-backend-switch-validate-one targets base cases default-label)]
    [_ (CompilerBackendSwitchValidation.Ok)]))

(define (compiler-backend-switch-validate-instr-seq
  [targets : BackendSymbolSeq]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendSwitchValidation
  (if (>= index (compiler_ir_types.compiler-ir-instr-seq-count instrs))
    (CompilerBackendSwitchValidation.Ok)
    (match (compiler-backend-switch-validate-instr
      targets
      (compiler_ir_types.compiler-ir-instr-seq-ref instrs index))
      [(CompilerBackendSwitchValidation.Ok)
        (compiler-backend-switch-validate-instr-seq targets instrs (+ index 1))]
      [(CompilerBackendSwitchValidation.Err message)
        (CompilerBackendSwitchValidation.Err message)])))

(define (compiler-backend-switch-validate-blocks
  [targets : BackendSymbolSeq]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : CompilerBackendSwitchValidation
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil)
      (CompilerBackendSwitchValidation.Ok)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (match (compiler-backend-switch-validate-instr-seq targets instrs 0)
            [(CompilerBackendSwitchValidation.Ok)
              (compiler-backend-switch-validate-blocks
                targets
                (__tl-box-place rest))]
            [(CompilerBackendSwitchValidation.Err message)
              (CompilerBackendSwitchValidation.Err message)])])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-switch-validate-block-seq targets seq 0)]))

(define (compiler-backend-switch-validate-block-seq
  [targets : BackendSymbolSeq]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]) : CompilerBackendSwitchValidation
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    (CompilerBackendSwitchValidation.Ok)
    (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
      [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
        (match (compiler-backend-switch-validate-instr-seq targets instrs 0)
          [(CompilerBackendSwitchValidation.Ok)
            (compiler-backend-switch-validate-block-seq
              targets
              blocks
              (+ index 1))]
          [(CompilerBackendSwitchValidation.Err message)
            (CompilerBackendSwitchValidation.Err message)])])))

(define (compiler-backend-switch-validate-functions
  [functions : compiler_ir_types.CompilerIrFunctionList]) : CompilerBackendSwitchValidation
  (match functions
    [(compiler_ir_types.CompilerIrFunctionList.Nil)
      (CompilerBackendSwitchValidation.Ok)]
    [(compiler_ir_types.CompilerIrFunctionList.Cons func rest)
      (match func
        [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ blocks)
          (let
            [targets : BackendSymbolSeq
              (compiler-backend-phi-target-labels-for-blocks blocks)]
            (match (compiler-backend-switch-validate-blocks targets blocks)
              [(CompilerBackendSwitchValidation.Ok)
                (compiler-backend-switch-validate-functions
                  (__tl-box-place rest))]
              [(CompilerBackendSwitchValidation.Err message)
                (CompilerBackendSwitchValidation.Err message)]))])]
    [(compiler_ir_types.CompilerIrFunctionList.Array seq)
      (compiler-backend-switch-validate-function-seq seq 0)]))

(define (compiler-backend-switch-validate-function-seq
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [index : i64]) : CompilerBackendSwitchValidation
  (if (>= index (compiler_ir_types.compiler-ir-function-seq-count functions))
    (CompilerBackendSwitchValidation.Ok)
    (match (compiler_ir_types.compiler-ir-function-seq-ref functions index)
      [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ blocks)
        (let
          [targets : BackendSymbolSeq
            (compiler-backend-phi-target-labels-for-blocks blocks)]
          (match (compiler-backend-switch-validate-blocks targets blocks)
            [(CompilerBackendSwitchValidation.Ok)
              (compiler-backend-switch-validate-function-seq
                functions
                (+ index 1))]
            [(CompilerBackendSwitchValidation.Err message)
              (CompilerBackendSwitchValidation.Err message)]))])))

(define (compiler-backend-emit-instr
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]) : ResultCompilerBackend
  (let
    [instr-diag : compiler_diagnostic.CompilerDiagnostic
      (compiler-backend-instr-diagnostic
        ctx.spans
        ctx.source-function
        instr
        ctx.func-diag
        "")]
    [_abort-site : unit
      (compiler-backend-runtime-abort-site-install! ctx instr)]
    [_scratch-plan : compiler_regalloc.CompilerRegScratchPlan
      (cfg
        scratch-vreg
        (compiler-backend-runtime-plan-scratch ctx.plan)
        (compiler-backend-global-shared-view
          compiler-backend-empty-scratch-plan))]
    [planned-scratch0 : String
      (cfg
        scratch-vreg
        (compiler-backend-scratch-plan-register-here
          _scratch-plan
          0
          ctx.backend-state)
        "")]
    [planned-scratch1 : String
      (cfg
        scratch-vreg
        (compiler-backend-scratch-plan-register-here
          _scratch-plan
          1
          ctx.backend-state)
        "")]
    [planned-scratch2 : String
      (cfg
        scratch-vreg
        (compiler-backend-scratch-plan-register-here
          _scratch-plan
          2
          ctx.backend-state)
        "")]
    [planned-scratch3 : String
      (cfg
        scratch-vreg
        (compiler-backend-scratch-plan-register-here
          _scratch-plan
          3
          ctx.backend-state)
        "")]
    [planned-scratch4 : String
      (cfg
        scratch-vreg
        (compiler-backend-scratch-plan-register-here
          _scratch-plan
          4
          ctx.backend-state)
        "")]
    [_c-memory-planned-xmm : unit
      (compiler-backend-function-state-set-string!
        ctx.function-state
        compiler-backend-function-string-current-c-memory-planned-xmm
        (match instr
          [(compiler_ir_types.CompilerIrInstr.Call _ _ _ _) planned-scratch1]
          [(compiler_ir_types.CompilerIrInstr.CallIndirectC _ _ _ _)
            planned-scratch2]
          [(compiler_ir_types.CompilerIrInstr.CallCAbiStoreResult _)
            planned-scratch2]
          [(compiler_ir_types.CompilerIrInstr.CallIndirectCAbiStoreResult _)
            planned-scratch2]
          [_ ""]))]
    [_phi-planned-xmm : unit
      (compiler-backend-function-state-set-string!
        ctx.function-state
        compiler-backend-function-string-current-phi-planned-xmm-cycle
        (match instr
          [(compiler_ir_types.CompilerIrInstr.Jump _) planned-scratch2]
          [(compiler_ir_types.CompilerIrInstr.Branch _ _ _) planned-scratch3]
          [(compiler_ir_types.CompilerIrInstr.TotalEnumBranch _ _ _)
            planned-scratch3]
          [_ ""]))]
    ;; Sound-scavenger: reserve this instruction's operand + result homes so the
    ;; scavenge can never hand one back as scratch (LLVM RegScavenger model).
    [_reserved-mask : i64
      (begin
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          (compiler-backend-instr-reserved-home-mask ctx.function-state instr))
        (compiler-backend-current-instr-reserved-mask ctx.function-state))]
    (match instr
      [(compiler_ir_types.CompilerIrInstr.Mov dst src ty)
        (match (compiler-backend-emit-mov-with-plan
          ctx.type-segment-bases
          ctx.assignments
          dst
          src
          ty
          ctx.program-index
          ctx.vars
          planned-scratch0
          planned-scratch1
          ctx.backend-state)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(compiler_ir_types.CompilerIrInstr.Alloc _ _)
        (ResultCompilerBackend.Ok "")]
      [(compiler_ir_types.CompilerIrInstr.AddrOf dst src)
        (match (compiler-backend-emit-addr-of
          ctx.assignments
          dst
          src
          planned-scratch0
          ctx.backend-state)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(compiler_ir_types.CompilerIrInstr.Gep dst base offset elem-ty)
        (match (compiler-backend-emit-gep
          ctx.type-segment-bases
          ctx.assignments
          dst
          base
          offset
          elem-ty
          (compiler-backend-gep-fold-next!
            ctx.function-state
            ctx.type-segment-bases
            offset
            elem-ty)
          planned-scratch0
          planned-scratch1
          ctx.backend-state)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(compiler_ir_types.CompilerIrInstr.Load dst src ty)
        (match (compiler-backend-emit-load-instr
          ctx.type-segment-bases
          ctx.assignments
          dst
          src
          ty
          planned-scratch0
          planned-scratch1
          ctx.backend-state)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(compiler_ir_types.CompilerIrInstr.StorePtr dst src ty)
        (match (compiler-backend-emit-store-ptr
          ctx.type-segment-bases
          ctx.assignments
          dst
          src
          ty
          ctx.program-index
          planned-scratch0
          planned-scratch1
          ctx.backend-state)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(compiler_ir_types.CompilerIrInstr.CopyBytes dst src size)
        (match (compiler-backend-emit-copy-bytes
          ctx.type-segment-bases
          ctx.assignments
          dst
          src
          size
          planned-scratch0
          planned-scratch1
          (if (>= size 16)
            planned-scratch3
            planned-scratch2)
          (if (>= size 16)
            planned-scratch2
            "")
          ctx.backend-state)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(compiler_ir_types.CompilerIrInstr.BoundsCheck index length ok-label)
        (match (compiler-backend-emit-bounds-check
          ctx.target
          ctx.function
          ctx.assignments
          planned-scratch0
          planned-scratch1
          index
          length
          ok-label
          ctx.plan
          ctx.functions
          ctx.externs
          ctx.program-index)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(compiler_ir_types.CompilerIrInstr.Cast dst src from-ty to-ty)
        (match (compiler-backend-emit-cast
          ctx.type-segment-bases
          ctx.function
          ctx.current-label
          ctx.assignments
          dst
          src
          from-ty
          to-ty
          ctx.program-index
          planned-scratch0
          planned-scratch1
          planned-scratch2
          ctx.backend-state)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
