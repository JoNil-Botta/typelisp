;; Windows flavor: VirtualAlloc/VirtualFree under the Win64 ABI. Reserve the
;; same 64 MiB logical segments as Linux, but initially commit only 4 MiB and
;; grow the committed range on demand. Windows charges MEM_COMMIT against the
;; system commit limit even for untouched capacity, so eagerly committing every
;; sparse compiler arena used tens of gigabytes while resident data stayed much
;; smaller. Header offset 64 stores committed-end; data begins at offset 72.
;; The arg arrives in %rcx; a 32-byte shadow space is reserved before each call.
(define (compiler-backend-runtime-windows-arena-functions [profile : bool]) : String
  (string.append
    "    .globl tl_arena_current
tl_arena_current:
"
    (string.append
      (compiler-backend-current-arena-load
        (CompilerBackendTarget.Windows)
        "%rax")
      (string.append
        "    ret

    .globl tl_arena_set
tl_arena_set:
"
        (string.append
          (compiler-backend-current-arena-store
            (CompilerBackendTarget.Windows)
            "%rcx")
          (string.append
            "    ret

    .globl tl_arena_poison_enable
tl_arena_poison_enable:
    ret

    .globl tl_arena_make
tl_arena_make:
    push %rbp
    mov %rsp, %rbp
    push %rbx
    push %rsi
    sub $48, %rsp
    xorq %rcx, %rcx
    movq $0x4000000, %rdx
    movq $0x2000, %r8
    movq $0x4, %r9
    call VirtualAlloc
    testq %rax, %rax
    jz .L_tl_arena_make_win_reserve_os_fail
    movq %rax, %rbx
    movq %rbx, %rcx
    movq $0x400000, %rdx
    movq $0x1000, %r8
    movq $0x4, %r9
    call VirtualAlloc
    testq %rax, %rax
    jz .L_tl_arena_make_win_initial_commit_os_fail
    movq $0, 0(%rbx)
    movq $0, 32(%rbx)
    movq %rbx, 40(%rbx)
    movq $0, 48(%rbx)
    movq %rbx, 56(%rbx)
    leaq 72(%rbx), %rcx
    movq %rcx, 8(%rbx)
    movq %rcx, 16(%rbx)
    movq %rbx, %rsi
    addq $0x400000, %rsi
    movq %rsi, 64(%rbx)
    movq %rbx, %rcx
    addq $0x4000000, %rcx
    movq %rcx, 24(%rbx)
    movq %rbx, %rax
    add $48, %rsp
    popq %rsi
    popq %rbx
    popq %rbp
    ret
.L_tl_arena_make_win_reserve_os_fail:
    call GetLastError
    movl %eax, %eax
    movq %rax, 40(%rsp)
    movq $0, 32(%rsp)
    xorq %rcx, %rcx
    xorq %rdx, %rdx
    movq $0x4000000, %r8
    xorq %r9, %r9
    call tl_windows_allocation_abort
    call tl_oom_abort
.L_tl_arena_make_win_initial_commit_os_fail:
    call GetLastError
    movl %eax, %esi
    movq %rbx, %rcx
    xorq %rdx, %rdx
    movq $0x8000, %r8
    call VirtualFree
    movq %rsi, 40(%rsp)
    movq $0, 32(%rsp)
    xorq %rcx, %rcx
    movq $1, %rdx
    movq $0x400000, %r8
    movq $0x4000000, %r9
    call tl_windows_allocation_abort
    call tl_oom_abort

    .globl tl_arena_make_atomic
tl_arena_make_atomic:
