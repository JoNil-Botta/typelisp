      [(compiler_ir_types.CompilerIrInstr.Phi _ _ _)
        (ResultCompilerBackend.Ok "")]
      [(compiler_ir_types.CompilerIrInstr.Pack dst words ty)
        (compiler-backend-emit-pack
          ctx.type-segment-bases
          ctx.assignments
          dst
          words
          ty
          ctx.vars
          ctx.program-index
          planned-scratch0
          planned-scratch1
          instr-diag
          ctx.backend-state)]
      [(compiler_ir_types.CompilerIrInstr.Word dst src index ty)
        (compiler-backend-emit-word
          ctx.type-segment-bases
          ctx.assignments
          dst
          src
          index
          ty
          ctx.vars
          planned-scratch0
          instr-diag
          ctx.backend-state)]
      [(compiler_ir_types.CompilerIrInstr.TailCallIndirect func args ty)
        (match (compiler-backend-emit-tail-indirect-call
          ctx.type-segment-bases
          ctx.target
          ctx.source-function
          ctx.blocks
          func
          args
          ty
          ctx.assignments
          planned-scratch0
          planned-scratch1
          ctx.types
          ctx.vars
          ctx.functions
          ctx.externs
          ctx.program-index
          instr-diag
          ctx.backend-state)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(compiler_ir_types.CompilerIrInstr.Switch index base cases default-label)
        (match (compiler-backend-emit-switch
          ctx.type-segment-bases
          ctx.function
          ctx.current-label
          index
          base
          cases
          default-label
          (compiler_ir_types.compiler-ir-label-none)
          ctx.assignments
          planned-scratch0
          planned-scratch1
          ctx.blocks
          ctx.program-index
          ctx.vars)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(compiler_ir_types.CompilerIrInstr.TotalEnumSwitch
          index
          base
          cases
          default-label
          trap-label)
        (match (compiler-backend-emit-switch
          ctx.type-segment-bases
          ctx.function
          ctx.current-label
          index
          base
          cases
          default-label
          trap-label
          ctx.assignments
          planned-scratch0
          planned-scratch1
          ctx.blocks
          ctx.program-index
          ctx.vars)
          [(ResultCompilerBackend.Ok asm) (ResultCompilerBackend.Ok asm)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])])))

;; The backend already has one complete, allocation-free instruction operand
;; walk for use counts. Reuse that walk when emission only needs the register
;; homes mentioned by one instruction instead of compiling a second giant
;; CompilerIrInstr match into the compiler. A two-word `[-1,
;; function-state-address]` carrier selects mask-only mode; ordinary
;; nonnegative use-count arrays keep their existing behavior.
(define (compiler-backend-use-count-inc
  [counts : (__tl_dyn-array i64)]
  [var : i64]) : unit
  (if (< var 0)
    unit
    (let
      [home-mask-mode : bool
        (and (= (array-length counts) 2) (= (array-ref counts 0) -1))]
      (if home-mask-mode
        (let
          [function-state : CompilerBackendFunctionState
            (CompilerBackendFunctionState (array-ref counts 1))]
          [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
            (compiler-backend-function-scratch-assignment-index function-state)]
          (if (compiler-backend-function-state-bool?
            function-state
            compiler-backend-function-bool-use-home-mask-active)
            (compiler-backend-function-state-set-i64!
              function-state
              compiler-backend-function-i64-use-home-mask-value
              (bit-or
                (compiler-backend-function-state-i64
                  function-state
                  compiler-backend-function-i64-use-home-mask-value)
                (compiler-backend-scavenge-reg-bit
                  (compiler-backend-var-register-home-index
                    assignment-index
                    var))))
            unit))
        (if (>= var (array-length counts))
          unit
          (begin
            (set! (array-ref counts var) (+ (array-ref counts var) 1))
            unit))))))

(define (compiler-backend-count-value-use
  [counts : (__tl_dyn-array i64)]
  [value : compiler_ir_types.CompilerIrValue]) : unit
  (match value
    [(compiler_ir_types.CompilerIrValue.Var id)
      (compiler-backend-use-count-inc counts id)]
    [_ unit]))

(define (compiler-backend-count-value-list-uses
  [counts : (__tl_dyn-array i64)]
  [values : compiler_ir_types.CompilerIrValueList]) : unit
  (match values
    [(compiler_ir_types.CompilerIrValueList.Nil) unit]
    [(compiler_ir_types.CompilerIrValueList.Array seq)
      (compiler-backend-count-value-list-uses
        counts
        (compiler_ir_types.compiler-ir-value-seq-to-list seq))]
    [(compiler_ir_types.CompilerIrValueList.Cons value rest)
      (begin
        (compiler-backend-count-value-use counts value)
        (compiler-backend-count-value-list-uses counts (__tl-box-place rest)))]))

(define (compiler-backend-count-call-args-array-uses
  [counts : (__tl_dyn-array i64)]
  [values : (__tl_dyn-array compiler_ir_types.CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length values))
    unit
    (begin
      (compiler-backend-count-value-use counts (array-ref values index))
      (compiler-backend-count-call-args-array-uses counts values (+ index 1)))))

(define (compiler-backend-count-call-args-uses
  [counts : (__tl_dyn-array i64)]
  [args : compiler_ir_types.CompilerIrCallArgs]) : unit
  (match args
    [(compiler_ir_types.CompilerIrCallArgs.Nil) unit]
    [(compiler_ir_types.CompilerIrCallArgs.One value)
      (compiler-backend-count-value-use counts value)]
    [(compiler_ir_types.CompilerIrCallArgs.Two a b)
      (begin
        (compiler-backend-count-value-use counts a)
        (compiler-backend-count-value-use counts b))]
    [(compiler_ir_types.CompilerIrCallArgs.Array values)
      (compiler-backend-count-call-args-array-uses counts values 0)]))

(define (compiler-backend-count-spmd-call-args-uses
  [counts : (__tl_dyn-array i64)]
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]) : unit
  (match args
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Nil) unit]
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(compiler_ir_types.CompilerIrSpmdCallArg.Arg _ value _)
          (begin
            (compiler-backend-count-value-use counts value)
            (compiler-backend-count-spmd-call-args-uses
              counts
              (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Array seq)
      (let
        [i : i64 0]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array compiler_ir_types.CompilerIrSpmdCallArg)
          seq.slots]
        (while (< i count)
          (begin
            (match (array-ref slots i)
              [(compiler_ir_types.CompilerIrSpmdCallArg.Arg _ value _)
                (compiler-backend-count-value-use counts value)])
            (set! i (+ i 1)))))]))

(define (compiler-backend-count-phi-input-uses
  [counts : (__tl_dyn-array i64)]
  [inputs : compiler_ir_types.CompilerIrPhiInputList]) : unit
  (match (compiler_ir_types.compiler-ir-phi-input-list-force-cons inputs)
    [(compiler_ir_types.CompilerIrPhiInputList.Nil) unit]
    [(compiler_ir_types.CompilerIrPhiInputList.Array seq)
      (compiler-backend-count-phi-input-uses
        counts
        (compiler_ir_types.compiler-ir-phi-input-seq-to-list seq))]
    [(compiler_ir_types.CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (compiler-backend-count-value-use counts value)
        (compiler-backend-count-phi-input-uses counts (__tl-box-place rest)))]))

(define (compiler-backend-count-instr-uses
  [counts : (__tl_dyn-array i64)]
  [instr : compiler_ir_types.CompilerIrInstr]) : unit
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Mov _ src _)
      (compiler-backend-count-value-use counts src)]
    [(compiler_ir_types.CompilerIrInstr.AddrOf _ src)
      (compiler-backend-use-count-inc counts src)]
    [(compiler_ir_types.CompilerIrInstr.Gep _ base offset _)
      (begin
        (compiler-backend-count-value-use counts base)
        (compiler-backend-count-value-use counts offset))]
    [(compiler_ir_types.CompilerIrInstr.Load _ src _)
      (compiler-backend-count-value-use counts src)]
    [(compiler_ir_types.CompilerIrInstr.StorePtr dst src _)
      (begin
        (compiler-backend-count-value-use counts dst)
        (compiler-backend-count-value-use counts src))]
    [(compiler_ir_types.CompilerIrInstr.CopyBytes dst src _)
      (begin
        (compiler-backend-count-value-use counts dst)
        (compiler-backend-count-value-use counts src))]
    [(compiler_ir_types.CompilerIrInstr.BoundsCheck index length _)
      (begin
        (compiler-backend-count-value-use counts index)
        (compiler-backend-count-value-use counts length))]
    [(compiler_ir_types.CompilerIrInstr.Cast _ src _ _)
      (compiler-backend-count-value-use counts src)]
    [(compiler_ir_types.CompilerIrInstr.Bitcast _ src _ _)
      (compiler-backend-count-value-use counts src)]
    [(compiler_ir_types.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (begin
        (compiler-backend-count-value-use counts lhs)
        (compiler-backend-count-value-use counts rhs))]
    [(compiler_ir_types.CompilerIrInstr.UnOp _ _ src _)
      (compiler-backend-count-value-use counts src)]
    [(compiler_ir_types.CompilerIrInstr.Splat _ value _ _)
      (compiler-backend-count-value-use counts value)]
    [(compiler_ir_types.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (begin
          (compiler-backend-count-value-use counts lhs)
          (compiler-backend-count-value-use counts rhs)))]
    [(compiler_ir_types.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (begin
          (compiler-backend-count-value-use counts src)
          (compiler-backend-count-value-use counts carry)))]
    [(compiler_ir_types.CompilerIrInstr.VectorReduce _ _ src _ _)
      (compiler-backend-count-value-use counts src)]
    [(compiler_ir_types.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (begin
          (compiler-backend-count-value-use counts lhs)
          (compiler-backend-count-value-use counts rhs)))]
    [(compiler_ir_types.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (compiler-backend-count-value-use counts lhs)
        (compiler-backend-count-value-use counts rhs))]
    [(compiler_ir_types.CompilerIrInstr.MaskNot _ src _)
      (compiler-backend-count-value-use counts src)]
    [(compiler_ir_types.CompilerIrInstr.MaskReduce _ _ src _)
      (compiler-backend-count-value-use counts src)]
    [(compiler_ir_types.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (begin
          (compiler-backend-count-value-use counts mask)
          (compiler-backend-count-value-use counts on-true)
          (compiler-backend-count-value-use counts on-false)))]
    [(compiler_ir_types.CompilerIrInstr.VectorLoad _ base index _ _)
      (begin
        (compiler-backend-count-value-use counts base)
        (compiler-backend-count-value-use counts index))]
    [(compiler_ir_types.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (begin
          (compiler-backend-count-value-use counts base)
          (compiler-backend-count-value-use counts index)
          (compiler-backend-count-value-use counts value)))]
    [(compiler_ir_types.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (begin
          (compiler-backend-count-value-use counts base)
          (compiler-backend-count-value-use counts index)
          (compiler-backend-count-value-use counts value)
          (compiler-backend-count-value-use counts mask)))]
    [(compiler_ir_types.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (begin
          (compiler-backend-count-value-use counts base)
          (compiler-backend-count-value-use counts index)
          (compiler-backend-count-value-use counts mask)))]
    [(compiler_ir_types.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        (begin
          (compiler-backend-count-value-use counts base)
          (compiler-backend-count-value-use counts index-base)
          (compiler-backend-count-value-use counts index)))]
    [(compiler_ir_types.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (begin
          (compiler-backend-count-value-use counts source)
          (compiler-backend-count-value-use counts selector-low)
          (match selector-high
            [(compiler_ir_types.CompilerIrMaybeValue.Some value)
              (compiler-backend-count-value-use counts value)]
            [(compiler_ir_types.CompilerIrMaybeValue.No) unit])
          (compiler-backend-count-value-use counts active-lanes)))]
    [(compiler_ir_types.CompilerIrInstr.TailMask _ index length _)
      (begin
        (compiler-backend-count-value-use counts index)
        (compiler-backend-count-value-use counts length))]
    [(compiler_ir_types.CompilerIrInstr.EntryArgc _) unit]
    [(compiler_ir_types.CompilerIrInstr.EntryArgv _) unit]
    [(compiler_ir_types.CompilerIrInstr.EntryEnvp _) unit]
    [(compiler_ir_types.CompilerIrInstr.CpuId _ leaf subleaf _)
      (begin
        (compiler-backend-count-value-use counts leaf)
        (compiler-backend-count-value-use counts subleaf))]
    [(compiler_ir_types.CompilerIrInstr.Xgetbv _ index)
      (compiler-backend-count-value-use counts index)]
    [(compiler_ir_types.CompilerIrInstr.Syscall _ args)
      (compiler-backend-count-call-args-uses counts args)]
    [(compiler_ir_types.CompilerIrInstr.Call _ _ args _)
      (compiler-backend-count-call-args-uses counts args)]
    [(compiler_ir_types.CompilerIrInstr.CallIndirect _ callee args _)
      (begin
        (compiler-backend-count-value-use counts callee)
        (compiler-backend-count-call-args-uses counts args))]
    [(compiler_ir_types.CompilerIrInstr.CallIndirectC _ callee args _)
      (begin
        (compiler-backend-count-value-use counts callee)
        (compiler-backend-count-call-args-uses counts args))]
    [(compiler_ir_types.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (begin
          (compiler-backend-count-value-use counts base)
          (compiler-backend-count-call-args-uses counts args)))]
    [(compiler_ir_types.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [callee (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (begin
          (compiler-backend-count-value-use counts base)
          (compiler-backend-count-value-use counts callee)
          (compiler-backend-count-call-args-uses counts args)))]
    [(compiler_ir_types.CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (begin
          (compiler-backend-count-value-use counts active-mask)
          (compiler-backend-count-spmd-call-args-uses counts args)))]
    [(compiler_ir_types.CompilerIrInstr.TailCall _ args _)
      (compiler-backend-count-call-args-uses counts args)]
    [(compiler_ir_types.CompilerIrInstr.TailCallIndirect callee args _)
      (begin
        (compiler-backend-count-value-use counts callee)
        (compiler-backend-count-call-args-uses counts args))]
    [(compiler_ir_types.CompilerIrInstr.Store _ value _)
      (compiler-backend-count-value-use counts value)]
    [(compiler_ir_types.CompilerIrInstr.Branch cond _ _)
      (compiler-backend-count-value-use counts cond)]
    [(compiler_ir_types.CompilerIrInstr.TotalEnumBranch cond _ _)
      (compiler-backend-count-value-use counts cond)]
    [(compiler_ir_types.CompilerIrInstr.Return maybe)
      (match maybe
        [(compiler_ir_types.CompilerIrMaybeValue.No) unit]
        [(compiler_ir_types.CompilerIrMaybeValue.Some value)
          (compiler-backend-count-value-use counts value)])]
    [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
      (compiler-backend-count-phi-input-uses counts inputs)]
    ;; Register-group instrs: count their operand uses so the
    ;; single-use fusion peepholes cannot elide the home store of a var a
    ;; Pack/Word still reads (-O2 copy-prop substitutes vars directly into
    ;; Pack/Word operands).
    [(compiler_ir_types.CompilerIrInstr.Pack _ words _)
      (compiler-backend-count-value-list-uses counts words)]
    [(compiler_ir_types.CompilerIrInstr.Word _ src _ _)
      (compiler-backend-count-value-use counts src)]
    ;; Operand-free IR instructions intentionally add no value uses.
    [(compiler_ir_types.CompilerIrInstr.Alloc _ _) unit]
    [(compiler_ir_types.CompilerIrInstr.LaneId _ _ _) unit]
    [(compiler_ir_types.CompilerIrInstr.EntryArgc _) unit]
    [(compiler_ir_types.CompilerIrInstr.EntryArgv _) unit]
    [(compiler_ir_types.CompilerIrInstr.EntryEnvp _) unit]
    [(compiler_ir_types.CompilerIrInstr.Jump _) unit]
    [(compiler_ir_types.CompilerIrInstr.Switch index _ _ _)
      (compiler-backend-count-value-use counts index)]
    [(compiler_ir_types.CompilerIrInstr.TotalEnumSwitch index _ _ _ _)
      (compiler-backend-count-value-use counts index)]))

(define (compiler-backend-count-instr-seq-uses
  [counts : (__tl_dyn-array i64)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : unit
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-backend-count-instr-uses counts (array-ref slots index))
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-count-block-uses
  [counts : (__tl_dyn-array i64)]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : unit
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) unit]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-backend-count-instr-seq-uses counts instrs)
            (compiler-backend-count-block-uses counts (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-count-block-seq-uses counts seq)]))

(define (compiler-backend-count-block-seq-uses
  [counts : (__tl_dyn-array i64)]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler_ir_types.compiler-ir-block-seq-count blocks)]
    (begin
      (while (< index count)
        (begin
          (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
            [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
              (compiler-backend-count-instr-seq-uses counts instrs)])
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-function-use-counts
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : (__tl_dyn-array i64)
  (let
    [counts : (__tl_dyn-array i64) (array.make-array i64 vars)]
    (begin
      (compiler-backend-count-block-uses counts blocks)
      counts)))

(define (compiler-backend-var-single-use?
  [counts : (__tl_dyn-array i64)]
  [var : i64]) : bool
  (if (< var 0)
    false
    (if (>= var (array-length counts))
      false
      (= (array-ref counts var) 1))))

;; --- fusion-pinned gep and load temps ---------------------------------------
;; A `Gep` whose destination is read by exactly one instruction, and that
;; instruction is the very next one in the same block, is the shape the gep
;; fusion cluster (compiler-backend-emit-gep-step) folds into the consumer's
;; addressing mode. A fused gep needs no register and no home: base and index
;; are read where they already live and the address never materialises.
;;
;; A `Load` destination in that same position is pinned for the same reason and
;; on the same terms. Every fold in the M6 family -- the bounds-check length,
;; the compare+branch, the narrow compare, the widening cast -- is gated on
;; `compiler-backend-var-single-use?` of the LOADED var, because that is what
;; proves the fold may retire it without writing its home. So the loaded var's
;; identity is load-bearing in exactly the way a gep temp's is, and losing it
;; costs strictly more: the gep temp falls back to a `leaq`, while the loaded
;; var falls back to a materialising load (a second scratch register, a store to
;; its home, and -- once the pool is saturated -- an emergency save/restore pair
;; around each scratch) whose result the consumer then re-reads from that home.
;; Measured in liveness_scan's change-detection loop, where slot coloring merged
;; the two compare operands of the two `!=` tests onto ONE representative id:
;; the merged id's recomputed use count was 2, every M6 probe declined, and each
;; word compare cost nine instructions where three suffice.
;;
;; Slot coloring, however, merges non-interfering SPILLED variables onto one
;; representative id, and the emitter's use counts are computed on the remapped
;; blocks -- so a whole unrolled body's worth of independent gep temps can
;; collapse into one id with a use count in the dozens, `single-use?` turns
;; false, and every site falls back to the generic two-scratch staged emitter
;; (save two registers to their homes, leaq, store the address to its home,
;; restore, reload, use, restore). Reporting those temps to the coloring pass
;; keeps their ids distinct, which keeps the peepholes firing.
;;
;; Adjacency is read off the DIFFERENCE in the running use counter across a
;; single instruction: `counts` accumulates function-wide uses in program order,
;; so a rise in the pending Gep or Load destination's counter while counting the
;; next instruction proves that instruction reads it. When the walk finishes,
;; `counts` holds exactly the ordinary function-wide use counts, which decide
;; the "used exactly once" half of the test.
;;
;; The pin is withheld from every SHARING mechanism only; a pinned var still
;; gets a private slot, so a temp whose fold does not fire is unchanged in
;; instruction count and costs one frame slot. That is the same trade the gep
;; pin has always made, and it is bounded by the same two conditions: the var
;; must be spilled (register homes already survive the renumbering) and read by
;; exactly one instruction, the very next one.
;;
;; The pin is deliberately NOT narrowed to the M6 consumers. `single-use?` of a
;; loaded value gates far more than the compare folds: the GAP8 ALU shapes, the
;; gep-load pair and divmod bundles, and the load emitters' own direct paths all
;; ask the same question, and all of them fall back to a materialising load and
;; a home store when it answers false. Restricting the pin to compares and casts
;; was measured on an opt2 self-compile and cost more than the frame slots it
;; saved (+57M at opt2, +25M at opt1), because the ALU shapes lost their folds.
(define (compiler-backend-gep-fusion-pin-seq!
  [counts : (__tl_dyn-array i64)]
  [adjacent : (__tl_dyn-array bool)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : unit
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [pending : i64 (- 0 1)]
    (while (< index count)
      (let
        [instr : compiler_ir_types.CompilerIrInstr (array-ref slots index)]
        [before : i64
          (if (>= pending 0)
            (array-ref counts pending)
            0)]
        (begin
          (compiler-backend-count-instr-uses counts instr)
          (if (and (>= pending 0) (> (array-ref counts pending) before))
            (set! (array-ref adjacent pending) true)
            unit)
          (set!
            pending
            (match instr
              [(compiler_ir_types.CompilerIrInstr.Gep dst _ _ _)
                (if (and (>= dst 0) (< dst (array-length adjacent)))
                  dst
                  (- 0 1))]
              [(compiler_ir_types.CompilerIrInstr.Load dst _ _)
                (if (and (>= dst 0) (< dst (array-length adjacent)))
                  dst
                  (- 0 1))]
              [_ (- 0 1)]))
          (set! index (+ index 1)))))))

(define (compiler-backend-gep-fusion-pin-block-seq!
  [counts : (__tl_dyn-array i64)]
  [adjacent : (__tl_dyn-array bool)]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler_ir_types.compiler-ir-block-seq-count blocks)]
    (while (< index count)
      (begin
        (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
          [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
            (compiler-backend-gep-fusion-pin-seq! counts adjacent instrs)])
        (set! index (+ index 1))))))

(define (compiler-backend-gep-fusion-pin-blocks!
  [counts : (__tl_dyn-array i64)]
  [adjacent : (__tl_dyn-array bool)]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : unit
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) unit]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-backend-gep-fusion-pin-seq! counts adjacent instrs)
            (compiler-backend-gep-fusion-pin-blocks!
              counts
              adjacent
              (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-gep-fusion-pin-block-seq! counts adjacent seq)]))

(define (compiler-backend-gep-fusion-pin-candidate?
  [counts : (__tl_dyn-array i64)]
  [adjacent : (__tl_dyn-array bool)]
  [vars : i64]) : bool
  (let
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (< index vars) (not found))
        (begin
          (if (and (array-ref adjacent index) (= (array-ref counts index) 1))
            (set! found true)
            unit)
          (set! index (+ index 1))))
      found)))

;; Spilled single-use gep temps consumed by the immediately following
;; instruction, keyed by the PRE-coloring var ids the given blocks and plan
;; assignments use. Register-homed temps already keep distinct ids through the
;; renumbering, so only the spilled ones need reporting.
(define (compiler-backend-gep-fusion-pinned-vars
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]) : compiler_liveness.CompilerLiveI64Set
  (if (<= vars 0)
    (compiler_liveness.compiler-live-set-empty)
    (let
      [counts : (__tl_dyn-array i64) (array.make-array i64 vars)]
      [adjacent : (__tl_dyn-array bool) (array.make-array bool vars)]
      [_walk : unit
        (compiler-backend-gep-fusion-pin-blocks! counts adjacent blocks)]
      (if (not
        (compiler-backend-gep-fusion-pin-candidate? counts adjacent vars))
        (compiler_liveness.compiler-live-set-empty)
        (let
          [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
            (compiler_regalloc.compiler-reg-assignment-table-with-min-capacity
              assignments
              vars)]
          [words : (__tl_dyn-array i64)
            (compiler_liveness.compiler-live-set-builder (- vars 1))]
          [index : i64 0]
          [pinned : bool false]
          (begin
            (while (< index vars)
              (begin
                (if (and
                  (array-ref adjacent index)
                  (= (array-ref counts index) 1)
                  (match (compiler_regalloc.compiler-reg-assignment-table-lookup
                    assignment-index
                    index)
                    [(compiler_regalloc.CompilerRegMaybeLocation.Some location)
                      (match location
                        [(compiler_regalloc.CompilerRegLocation.Spill _) true]
                        [_ false])]
                    [(compiler_regalloc.CompilerRegMaybeLocation.No) false]))
                  (begin
                    (compiler_liveness.compiler-live-set-builder-insert!
                      words
                      index)
                    (set! pinned true))
                  unit)
                (set! index (+ index 1))))
            (if pinned
              (compiler_liveness.compiler-live-set-from-words-trimmed
                words
                (array-length words))
              (compiler_liveness.compiler-live-set-empty))))))))

;; Dead result-store elision: true when `var` is read by NO instruction in the
;; final emitted IR (use count 0 over emit-blocks-list, the post-rewrite
;; post-coloring blocks the emitter walks). Every operand read counts as a use,
;; including IrInstrAddrOf's raw var id (compiler-backend-count-instr-uses), so
;; a never-used var's frame slot is unobservable: no reload, no address-taken
;; alias, no Pack/Word read. The runtime has no GC/stack-root walk and the
;; backend emits no per-slot unwind metadata, so skipping the slot store of such
;; a var (a call result whose value is ignored -- DCE cannot drop the call) is
;; behavior-preserving. Reads the per-function array installed by
;; compiler-backend-fuse-need-enable!; conservatively false when unset.
(define (compiler-backend-var-never-used?
  [backend-state : CompilerBackendState]
  [var : i64]) : bool
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [use-counts : (__tl_dyn-array i64)
      (compiler-backend-function-state-i64-array
        function-state
        compiler-backend-function-i64-array-fuse-use-counts)]
    (cond
      [(not
          (compiler-backend-function-state-bool?
            function-state
            compiler-backend-function-bool-fuse-need-ready))
        false]
      [(< var 0) false]
      [(>= var (array-length use-counts)) false]
      [else (= (array-ref use-counts var) 0)])))

;; True when every use of `var` is a branch fed by its own adjacent compare, so
;; the boolean is never needed as a materialized value and a compare->branch on
;; it may fuse. Holds when the var's total use count equals its free-branch
;; count. Reads the per-function arrays installed by
;; compiler-backend-fuse-need-enable!; conservatively false when unset.
(define (compiler-backend-var-fuse-safe?
  [backend-state : CompilerBackendState]
  [var : i64]) : bool
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [use-counts : (__tl_dyn-array i64)
      (compiler-backend-function-state-i64-array
        function-state
        compiler-backend-function-i64-array-fuse-use-counts)]
    [free-counts : (__tl_dyn-array i64)
      (compiler-backend-function-state-i64-array
        function-state
        compiler-backend-function-i64-array-fuse-free-counts)]
    (cond
      [(not
          (compiler-backend-function-state-bool?
            function-state
            compiler-backend-function-bool-fuse-need-ready))
        false]
      [(< var 0) false]
      [(>= var (array-length free-counts)) false]
      [(>= var (array-length use-counts)) false]
      [else (= (array-ref use-counts var) (array-ref free-counts var))])))

;; The branch condition var at slot `j` when that branch is fed by the
;; immediately preceding compare or boolean negation (a "free branch" whose
;; result need not be materialized); otherwise -1.
(define (compiler-backend-fuse-free-branch-var
  [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)]
  [j : i64]) : i64
  (if (<= j 0)
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-scalar-fact (array-ref slots j))
      [(compiler_ir_types.CompilerIrInstrScalarFact.Branch cond _ _)
        (match cond
          [(compiler_ir_types.CompilerIrValue.Var v)
            (match (array-ref slots (- j 1))
              [(compiler_ir_types.CompilerIrInstr.BinOp dst op _ _ _)
                (if (and (compiler-backend-compare-op? op) (= dst v))
                  v
                  (- 0 1))]
              [(compiler_ir_types.CompilerIrInstr.UnOp
                  dst
                  (compiler_ir_types.CompilerIrUnOp.Not)
                  _
                  (compiler_ast_types.AstType.Bool))
                (if (= dst v)
                  v
                  (- 0 1))]
              [_ (- 0 1)])]
          [_ (- 0 1)])]
      [_ (- 0 1)])))

(define (compiler-backend-count-instr-seq-use-facts
  [counts : (__tl_dyn-array i64)]
  [free : (__tl_dyn-array i64)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : unit
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [n : i64 instrs.len]
    [j : i64 0]
    (while (< j n)
      (begin
        (compiler-backend-count-instr-uses counts (array-ref slots j))
        (let
          [v : i64 (compiler-backend-fuse-free-branch-var slots j)]
          (if (and (>= v 0) (< v (array-length free)))
            (set! (array-ref free v) (+ (array-ref free v) 1))
            unit))
        (set! j (+ j 1))))))

(define (compiler-backend-count-block-use-facts
  [counts : (__tl_dyn-array i64)]
  [free : (__tl_dyn-array i64)]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : unit
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) unit]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
            (compiler-backend-count-instr-seq-use-facts counts free instrs)])
        (compiler-backend-count-block-use-facts
          counts
          free
          (__tl-box-place rest)))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-count-block-seq-use-facts counts free seq)]))

(define (compiler-backend-count-block-seq-use-facts
  [counts : (__tl_dyn-array i64)]
  [free : (__tl_dyn-array i64)]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler_ir_types.compiler-ir-block-seq-count blocks)]
    (begin
      (while (< index count)
        (begin
          (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
            [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
              (compiler-backend-count-instr-seq-use-facts counts free instrs)])
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-fuse-need-enable!
  [backend-state : CompilerBackendState]
  [use-counts : (__tl_dyn-array i64)]
  [free-counts : (__tl_dyn-array i64)]) : unit
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    (begin
      (compiler-backend-function-state-set-i64-array!
        function-state
        compiler-backend-function-i64-array-fuse-use-counts
        use-counts)
      (compiler-backend-function-state-set-i64-array!
        function-state
        compiler-backend-function-i64-array-fuse-free-counts
        free-counts)
      (compiler-backend-function-state-set-bool!
        function-state
        compiler-backend-function-bool-fuse-need-ready
        true))))

(define (compiler-backend-fuse-need-disable!
  [backend-state : CompilerBackendState]) : unit
  (compiler-backend-function-state-set-bool!
    (compiler-backend-state-function-state backend-state)
    compiler-backend-function-bool-fuse-need-ready
    false))

(define (compiler-backend-addr-of-forwarding-fill!
  [items : (__tl_dyn-array i64)]
  [index : i64]) : unit
  (if (>= index (array-length items))
    unit
    (begin
      (set! (array-ref items index) (- 0 1))
      (compiler-backend-addr-of-forwarding-fill! items (+ index 1)))))

(define (compiler-backend-addr-of-forwarding-record!
  [items : (__tl_dyn-array i64)]
  [use-counts : (__tl_dyn-array i64)]
  [instr : compiler_ir_types.CompilerIrInstr]) : unit
  (match instr
    [(compiler_ir_types.CompilerIrInstr.AddrOf dst src)
      (if (and
        (>= dst 0)
        (< dst (array-length items))
        (compiler-backend-var-single-use? use-counts dst))
        (set! (array-ref items dst) src)
        unit)]
    [(compiler_ir_types.CompilerIrInstr.Mov dst src _)
      (match src
        [(compiler_ir_types.CompilerIrValue.Var src-var)
          (let
            [forward-src : i64
              (if (and (>= src-var 0) (< src-var (array-length items)))
                (array-ref items src-var)
                (- 0 1))]
            (if (and
              (>= forward-src 0)
              (>= dst 0)
              (< dst (array-length items))
              (compiler-backend-var-single-use? use-counts dst))
              (set! (array-ref items dst) forward-src)
              unit))]
        [_ unit])]
    [_ unit]))

(define (compiler-backend-addr-of-forwarding-record-seq!
  [items : (__tl_dyn-array i64)]
  [use-counts : (__tl_dyn-array i64)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : unit
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-backend-addr-of-forwarding-record!
            items
            use-counts
            (array-ref slots index))
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-addr-of-forwarding-record-blocks!
  [items : (__tl_dyn-array i64)]
  [use-counts : (__tl_dyn-array i64)]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : unit
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) unit]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-backend-addr-of-forwarding-record-seq!
              items
              use-counts
              instrs)
            (compiler-backend-addr-of-forwarding-record-blocks!
              items
              use-counts
              (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-addr-of-forwarding-record-block-seq!
        items
        use-counts
        seq)]))

(define (compiler-backend-addr-of-forwarding-record-block-seq!
  [items : (__tl_dyn-array i64)]
  [use-counts : (__tl_dyn-array i64)]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler_ir_types.compiler-ir-block-seq-count blocks)]
    (begin
      (while (< index count)
        (begin
          (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
            [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
              (compiler-backend-addr-of-forwarding-record-seq!
                items
                use-counts
                instrs)])
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-addr-of-forwarding-enable!
  [backend-state : CompilerBackendState]
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [use-counts : (__tl_dyn-array i64)]) : unit
  (let
    [items : (__tl_dyn-array i64) (array.make-array i64 vars)]
    (begin
      (compiler-backend-addr-of-forwarding-fill! items 0)
      (compiler-backend-addr-of-forwarding-record-blocks!
        items
        use-counts
        blocks)
      (compiler-backend-function-state-set-i64-array!
        (compiler-backend-state-function-state backend-state)
        compiler-backend-function-i64-array-addr-of-forwarding-src
        items)
      (compiler-backend-function-state-set-bool!
        (compiler-backend-state-function-state backend-state)
        compiler-backend-function-bool-addr-of-forwarding-enabled
        true))))

(define (compiler-backend-addr-of-forwarding-disable!
  [backend-state : CompilerBackendState]) : unit
  (compiler-backend-function-state-set-bool!
    (compiler-backend-state-function-state backend-state)
    compiler-backend-function-bool-addr-of-forwarding-enabled
    false))

(define (compiler-backend-branch-uses-var?
  [cond : compiler_ir_types.CompilerIrValue]
  [var : i64]) : bool
  (match cond
    [(compiler_ir_types.CompilerIrValue.Var id) (= id var)]
    [_ false]))

(define (compiler-backend-rest-starts-load-compare-branch?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [load-dst : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [use-counts : (__tl_dyn-array i64)]) : bool
  (if (< index instrs.len)
    (let
      [maybe-cmp : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [after-cmp : i64 (+ index 1)]
      (match maybe-cmp
        [(compiler_ir_types.CompilerIrInstr.BinOp cmp-dst op lhs rhs cmp-ty)
          (if (and
            (compiler-backend-compare-op? op)
            (compiler-backend-branch-uses-var? lhs load-dst)
            (compiler-backend-var-single-use? use-counts cmp-dst)
            (not
              (compiler-backend-binop-f64? types global-types lhs rhs cmp-ty)))
            (if (< after-cmp instrs.len)
              (let
                [branch : compiler_ir_types.CompilerIrInstr
                  (compiler_ir_types.compiler-ir-instr-seq-ref instrs after-cmp)]
                (match (compiler_ir_types.compiler-ir-instr-scalar-fact branch)
                  [(compiler_ir_types.CompilerIrInstrScalarFact.Branch cond _ _)
                    (compiler-backend-branch-uses-var? cond cmp-dst)]
                  [_ false]))
              false)
            false)]
        [_ false]))
    false))

(define (compiler-backend-fused-compare-fallthrough
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [fallthrough : CompilerBackendMaybeLabel]) : CompilerBackendMaybeLabel
  (if (< index instrs.len)
    (CompilerBackendMaybeLabel.No)
    fallthrough))

;; A block-terminator fusion (mov/call/binop directly into a return) emits the
;; whole tail of the block and does not recurse, so it appends the terminator's
;; asm after the instructions already emitted into the body buffer.
(define (compiler-backend-emit-terminator-into
  [result : ResultCompilerBackend]
  [out : (&mut out CompilerBackendAsmBuf)]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (match result
    [(ResultCompilerBackend.Ok asm)
      (begin
        (compiler-backend-emergency-append out asm backend-state)
        (ResultCompilerBackend.Ok ""))]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-instr-with-call-rax
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]) : ResultCompilerBackend
  (let
    ;; The var whose call-argument home is pinned to %rax, or -1 when the
    ;; forward is ineligible. Published only for the dynamic extent of a call
    ;; that actually consumes the forwarded value.
    [rax-forward-pending : i64
      (if (and
        (>= rax-var 0)
        (compiler-backend-rax-call-arg-eligible?
          ctx.type-segment-bases
          ctx.program-index
          rax-ty))
        rax-var
        -1)]
    [instr-diag : compiler_diagnostic.CompilerDiagnostic
      (compiler-backend-instr-diagnostic
        ctx.spans
        ctx.source-function
        instr
        ctx.func-diag
        "")]
    ;; Sound-scavenger: reserve this instruction's operand + result homes so the
    ;; scavenge can never hand one back as scratch (LLVM RegScavenger model).
    [_reserved-mask : i64
      (begin
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          (compiler-backend-instr-reserved-home-mask ctx.function-state instr))
        (compiler-backend-current-instr-reserved-mask ctx.function-state))]
    (match instr
      [(compiler_ir_types.CompilerIrInstr.Call dst name args ty)
        (if (compiler-backend-call-leading-arg-uses-var? args rax-var)
          (let
            [rax-forward-result : ResultCompilerBackend
              (begin
                (compiler-backend-function-state-set-i64!
                  ctx.function-state
                  compiler-backend-function-i64-rax-forward-pending-var
                  rax-forward-pending)
                (compiler-backend-emit-direct-call-with-arg-assignments
                  ctx.type-segment-bases
                  ctx.target
                  ctx.function
                  ctx.current-label
                  (compiler-backend-function-state-emit-current-site
                    ctx.function-state)
                  dst
                  name
                  args
                  ty
                  ctx.assignments
                  ctx.assignments
                  (compiler-backend-scratch-plan-register-here
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-here
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    ctx.backend-state)
                  ctx.types
                  ctx.global-types
                  ctx.plan
                  ctx.externs
                  ctx.program-index
                  ctx.vars
                  instr-diag
                  ctx.backend-state))]
            (begin
              (compiler-backend-function-state-set-i64!
                ctx.function-state
                compiler-backend-function-i64-rax-forward-pending-var
                -1)
              rax-forward-result))
          (compiler-backend-emit-instr ctx fallthrough instr))]
      [(compiler_ir_types.CompilerIrInstr.CallIndirect dst func args ty)
        (if (compiler-backend-call-leading-arg-uses-var? args rax-var)
          (let
            [rax-forward-result : ResultCompilerBackend
              (begin
                (compiler-backend-function-state-set-i64!
                  ctx.function-state
                  compiler-backend-function-i64-rax-forward-pending-var
                  rax-forward-pending)
                (compiler-backend-emit-indirect-call-with-arg-assignments
                  ctx.type-segment-bases
                  ctx.target
                  dst
                  func
                  args
                  ty
                  ctx.assignments
                  ctx.assignments
                  (compiler-backend-scratch-plan-register-here
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-here
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    ctx.backend-state)
                  ctx.types
                  ctx.functions
                  ctx.externs
                  ctx.program-index
                  ctx.vars
                  instr-diag
                  ctx.backend-state))]
            (begin
              (compiler-backend-function-state-set-i64!
                ctx.function-state
                compiler-backend-function-i64-rax-forward-pending-var
                -1)
              rax-forward-result))
          (compiler-backend-emit-instr ctx fallthrough instr))]
      [_ (compiler-backend-emit-instr ctx fallthrough instr)])))

(define (compiler-backend-call-rax-forwardable-instr?
  [type-segment-bases : i64]
  [instr : compiler_ir_types.CompilerIrInstr]
  [program-index : CompilerBackendProgramIndex]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]) : bool
  (and
    (compiler-backend-rax-call-arg-eligible?
      type-segment-bases
      program-index
      rax-ty)
    (match instr
      [(compiler_ir_types.CompilerIrInstr.Call _ _ args _)
        (compiler-backend-call-leading-arg-uses-var? args rax-var)]
      [(compiler_ir_types.CompilerIrInstr.CallIndirect _ _ args _)
        (compiler-backend-call-leading-arg-uses-var? args rax-var)]
      [_ false])))

(define (compiler-backend-append-located-instr
  [buf : text_buf.TextBuf]
  [location : String]
  [head : String]
  [backend-state : CompilerBackendState]) : text_buf.TextBuf
  ;; A .loc/.cv_loc directive is metadata, not an instruction. Keep the
  ;; emergency save/restore pending until the executable head is appended.
  (text_buf.append
    (text_buf.append buf location)
    (compiler-backend-emergency-wrap head backend-state)))

(define (compiler-backend-emit-instrs-after-emitted
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [head : String]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (begin
    ;; A .loc/.cv_loc directive is metadata, not an instruction. Append it
    ;; plainly and keep the emergency save/restore pending until the
    ;; executable head goes in (mirrors compiler-backend-append-located-instr
    ;; for the buffer spine).
    (let
      [location : String (compiler-backend-debug-instr-location ctx instr)]
      (if (> (string.string-length location) 0)
        (compiler-backend-asm-append out location)
        unit))
    (compiler-backend-emergency-append out head ctx.backend-state)
    (match instr
      [(compiler_ir_types.CompilerIrInstr.Call dst _ _ ty)
        (compiler-backend-emit-instrs-with-call-rax
          ctx
          fallthrough
          dst
          ty
          instrs
          index
          out)]
      [(compiler_ir_types.CompilerIrInstr.CallIndirect dst _ _ ty)
        (compiler-backend-emit-instrs-with-call-rax
          ctx
          fallthrough
          dst
          ty
          instrs
          index
          out)]
      [(compiler_ir_types.CompilerIrInstr.CallIndirectC dst _ _ ty)
        (compiler-backend-emit-instrs-with-call-rax
          ctx
          fallthrough
          dst
          ty
          instrs
          index
          out)]
      [_ (compiler-backend-emit-instrs ctx fallthrough instrs index out)])))

(define (compiler-backend-emit-instrs-normal
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (compiler-backend-emit-instr
    ctx
    (if (< index instrs.len)
      (CompilerBackendMaybeLabel.No)
      fallthrough)
    instr)
    [(ResultCompilerBackend.Ok head)
      (compiler-backend-emit-instrs-after-emitted
        ctx
        fallthrough
        instr
        instrs
        index
        head
        out)]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-fused-result-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [result : ResultCompilerBackend]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match result
    [(ResultCompilerBackend.Ok head)
      (begin
        (compiler-backend-asm-append
          out
          (compiler-backend-emergency-wrap head ctx.backend-state))
        (compiler-backend-emit-instrs ctx fallthrough instrs index out))]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-rax-forwardable-consumer?
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [rax-var : i64]
  [instr : compiler_ir_types.CompilerIrInstr]) : bool
  (match instr
    [(compiler_ir_types.CompilerIrInstr.BinOp _ op lhs rhs ty)
      (and
        (compiler-backend-rax-forwardable-binop?
          types
          global-types
          assignments
          op
          lhs
          rhs
          ty)
        (or
          (compiler-backend-branch-uses-var? lhs rax-var)
          (and
            (compiler-backend-branch-uses-var? rhs rax-var)
            (compiler-backend-commutative-binop? op))))]
    [(compiler_ir_types.CompilerIrInstr.Mov _ src _)
      (compiler-backend-branch-uses-var? src rax-var)]
    [(compiler_ir_types.CompilerIrInstr.Return maybe)
      (match maybe
        [(compiler_ir_types.CompilerIrMaybeValue.Some value)
          (compiler-backend-branch-uses-var? value rax-var)]
        [(compiler_ir_types.CompilerIrMaybeValue.No) false])]
    [_ false]))

(define (compiler-backend-rest-starts-rax-forwardable-consumer?
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [rax-var : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (< index instrs.len)
    (let
      [instr : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      (compiler-backend-rax-forwardable-consumer?
        types
        global-types
        assignments
        rax-var
        instr))
    false))

(define (compiler-backend-rest-starts-return-of-var?
  [var : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (< index instrs.len)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Return maybe)
        (match maybe
          [(compiler_ir_types.CompilerIrMaybeValue.Some value)
            (compiler-backend-branch-uses-var? value var)]
          [(compiler_ir_types.CompilerIrMaybeValue.No) false])]
      [_ false])
    false))

(define (compiler-backend-emit-instrs-materialize-rax
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (begin
    (compiler-backend-emit-store-typed-var-with-plan-into
      out
      ctx.assignments
      rax-var
      "%rax"
      rax-ty
      ctx.backend-state)
    (compiler-backend-emit-instrs ctx fallthrough instrs index out)))

(define (compiler-backend-emit-instrs-with-rax-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [instr : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [rest : i64 (+ index 1)]
      (match instr
        [(compiler_ir_types.CompilerIrInstr.BinOp dst op lhs rhs ty)
          (if (compiler-backend-rax-forwardable-consumer?
            ctx.types
            ctx.global-types
            ctx.assignments
            rax-var
            instr)
            (let
              [keep-live : bool
                (compiler-backend-var-single-use? ctx.use-counts dst)]
              (match (compiler-backend-emit-binop-with-rax-value
                ctx.type-segment-bases
                ctx.types
                ctx.global-types
                ctx.assignments
                rax-var
                dst
                op
                lhs
                rhs
                ty
                (not keep-live)
                (compiler-backend-scratch-plan-register-ahead
                  (compiler-backend-runtime-plan-scratch ctx.plan)
                  0
                  0
                  ctx.backend-state)
                (compiler-backend-scratch-plan-register-ahead
                  (compiler-backend-runtime-plan-scratch ctx.plan)
                  0
                  1
                  ctx.backend-state)
                (compiler-backend-scratch-plan-register-ahead
                  (compiler-backend-runtime-plan-scratch ctx.plan)
                  0
                  2
                  ctx.backend-state)
                (compiler-backend-scratch-plan-register-ahead
                  (compiler-backend-runtime-plan-scratch ctx.plan)
                  0
                  3
                  ctx.backend-state)
                (compiler-backend-scratch-plan-register-ahead
                  (compiler-backend-runtime-plan-scratch ctx.plan)
                  0
                  4
                  ctx.backend-state)
                (compiler-backend-rest-starts-return-of-var? dst instrs rest)
                ctx.backend-state)
                [(ResultCompilerBackend.Ok head)
                  (begin
                    (compiler-backend-asm-append
                      out
                      (compiler-backend-emergency-wrap head ctx.backend-state))
                    (if keep-live
                      (compiler-backend-emit-instrs-with-rax
                        ctx
                        fallthrough
                        dst
                        ty
                        instrs
                        rest
                        out)
                      (compiler-backend-emit-instrs
                        ctx
                        fallthrough
                        instrs
                        rest
                        out)))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)]))
            (compiler-backend-emit-instrs-materialize-rax
              ctx
              fallthrough
              rax-var
              rax-ty
              instrs
              index
              out))]
        [(compiler_ir_types.CompilerIrInstr.Mov dst src ty)
          (if (compiler-backend-branch-uses-var? src rax-var)
            (if (compiler-backend-var-single-use? ctx.use-counts dst)
              (compiler-backend-emit-instrs-with-rax
                ctx
                fallthrough
                dst
                ty
                instrs
                rest
                out)
              (begin
                (compiler-backend-emit-store-typed-var-with-plan-into
                  out
                  ctx.assignments
                  dst
                  "%rax"
                  ty
                  ctx.backend-state)
                (compiler-backend-emit-instrs ctx fallthrough instrs rest out)))
            (compiler-backend-emit-instrs-materialize-rax
              ctx
              fallthrough
              rax-var
              rax-ty
              instrs
              index
              out))]
        [(compiler_ir_types.CompilerIrInstr.Return maybe)
          (match maybe
            [(compiler_ir_types.CompilerIrMaybeValue.Some value)
              (if (and
                (compiler-backend-branch-uses-var? value rax-var)
                (if (< rest instrs.len)
                  false
                  true))
                (begin
                  (compiler-backend-asm-append
                    out
                    (compiler-backend-return-tail
                      ctx.backend-state
                      ctx.source-function
                      ctx.assignments
                      ctx.vars
                      ctx.blocks))
                  (ResultCompilerBackend.Ok ""))
                (compiler-backend-emit-instrs-materialize-rax
                  ctx
                  fallthrough
                  rax-var
                  rax-ty
                  instrs
                  index
                  out))]
            [(compiler_ir_types.CompilerIrMaybeValue.No)
              (compiler-backend-emit-instrs-materialize-rax
                ctx
                fallthrough
                rax-var
                rax-ty
                instrs
                index
                out)])]
        [_
          (compiler-backend-emit-instrs-materialize-rax
            ctx
            fallthrough
            rax-var
            rax-ty
            instrs
            index
            out)]))
    (begin
      (compiler-backend-emit-store-typed-var-with-plan-into
        out
        ctx.assignments
        rax-var
        "%rax"
        rax-ty
        ctx.backend-state)
      (ResultCompilerBackend.Ok ""))))

(define (compiler-backend-emit-instrs-with-call-rax-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [instr : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [rest : i64 (+ index 1)]
      (if (compiler-backend-call-rax-forwardable-instr?
        ctx.type-segment-bases
        instr
        ctx.program-index
        rax-var
        rax-ty)
        (match (compiler-backend-emit-instr-with-call-rax
          ctx
          (if (< rest instrs.len)
            (CompilerBackendMaybeLabel.No)
            fallthrough)
          instr
          rax-var
          rax-ty)
          [(ResultCompilerBackend.Ok head)
            (compiler-backend-emit-instrs-after-emitted
              ctx
              fallthrough
              instr
              instrs
              rest
              head
              out)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])
        (compiler-backend-emit-instrs ctx fallthrough instrs index out)))
    (ResultCompilerBackend.Ok "")))

(define (compiler-backend-publish-phi-planned-xmm-ahead!
  [ctx : CompilerBackendEmissionContext]
  [instruction-offset : i64]) : unit
  (compiler-backend-function-state-set-string!
    ctx.function-state
    compiler-backend-function-string-current-phi-planned-xmm-cycle
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      instruction-offset
      3
      ctx.backend-state)))

(define (compiler-backend-emit-fused-compare-branch-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [true-label : i64]
  [false-label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (begin
    (compiler-backend-publish-phi-planned-xmm-ahead! ctx 1)
    (match (compiler-backend-emit-compare-branch-with-phi-copies-with-plan
      ctx.type-segment-bases
      ctx.assignments
      ctx.function
      ctx.blocks
      ctx.current-label
      op
      lhs
      rhs
      (compiler-backend-binop-operand-ty
        ctx.types
        ctx.global-types
        op
        lhs
        rhs
        ty)
      true-label
      false-label
      (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
      ctx.program-index
      ctx.vars
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        0
        ctx.backend-state)
      (if (compiler_regalloc.compiler-reg-scratch-compare-lhs-direct?
        ctx.assignments
        lhs
        rhs)
        (compiler-backend-scratch-plan-register-ahead
          (compiler-backend-runtime-plan-scratch ctx.plan)
          0
          0
          ctx.backend-state)
        (compiler-backend-scratch-plan-register-ahead
          (compiler-backend-runtime-plan-scratch ctx.plan)
          0
          1
          ctx.backend-state))
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        1
        1
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        1
        2
        ctx.backend-state))
      [(ResultCompilerBackend.Ok head)
        (begin
          (compiler-backend-asm-append
            out
            (compiler-backend-emergency-wrap head ctx.backend-state))
          (compiler-backend-emit-instrs ctx fallthrough instrs index out))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              (compiler-backend-instr-diagnostic
                ctx.spans
                ctx.source-function
                (compiler_ir_types.CompilerIrInstr.BinOp dst op lhs rhs ty)
                ctx.func-diag
                ""))))])))

(define (compiler-backend-emit-fused-load-compare-branch-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [load-dst : i64]
  [ptr : compiler_ir_types.CompilerIrValue]
  [load-ty : compiler_ast_types.AstType]
  [_cmp-dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [rhs : compiler_ir_types.CompilerIrValue]
  [_cmp-ty : compiler_ast_types.AstType]
  [true-label : i64]
  [false-label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (begin
    (compiler-backend-publish-phi-planned-xmm-ahead! ctx 2)
    (match (compiler-backend-emit-load-compare-branch-with-phi-copies-with-plan
      ctx.type-segment-bases
      ctx.assignments
      ctx.function
      ctx.blocks
      ctx.current-label
      ptr
      op
      rhs
      load-ty
      true-label
      false-label
      (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
      ctx.program-index
      ctx.vars
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        0
        ctx.backend-state)
      ;; The comparison result is not materialized in this fusion, so its primary
      ;; scalar slot is the RHS staging home regardless of the folded Load's home.
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        1
        0
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        2
        1
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        2
        2
        ctx.backend-state))
      [(ResultCompilerBackend.Ok head)
        (begin
          (compiler-backend-asm-append
            out
            (compiler-backend-emergency-wrap head ctx.backend-state))
          (compiler-backend-emit-instrs ctx fallthrough instrs index out))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              (compiler-backend-instr-diagnostic
                ctx.spans
                ctx.source-function
                (compiler_ir_types.CompilerIrInstr.Load load-dst ptr load-ty)
                ctx.func-diag
                ""))))])))

(define (compiler-backend-emit-fused-not-branch-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [true-label : i64]
  [false-label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  ;; `not src` branches to its false successor when src is true. Emit the
  ;; source branch directly with reversed successors, including the matching
  ;; phi-edge copies, instead of materializing the inverted boolean.
  (begin
    (compiler-backend-publish-phi-planned-xmm-ahead! ctx 1)
    (match (compiler-backend-emit-branch-with-phi-copies-with-plan
      ctx.type-segment-bases
      ctx.assignments
      ctx.function
      ctx.blocks
      ctx.current-label
      src
      false-label
      true-label
      (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
      ctx.program-index
      ctx.vars
      ""
      ""
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        1
        0
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        1
        1
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        1
        2
        ctx.backend-state))
      [(ResultCompilerBackend.Ok head)
        (begin
          (compiler-backend-asm-append
            out
            (compiler-backend-emergency-wrap head ctx.backend-state))
          (compiler-backend-emit-instrs ctx fallthrough instrs index out))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              (compiler-backend-instr-diagnostic
                ctx.spans
                ctx.source-function
                (compiler_ir_types.CompilerIrInstr.UnOp
                  dst
                  (compiler_ir_types.CompilerIrUnOp.Not)
                  src
                  ty)
                ctx.func-diag
                ""))))])))

(define (compiler-backend-emit-fused-gep-load-compare-branch-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-dst : i64]
  ;; GAP9: the fused compare consumes this gep's ordinal at the dispatch
  ;; site; the path is const-offset-only so the displacement is always 0.
  [_gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [_load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [_cmp-dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [rhs : compiler_ir_types.CompilerIrValue]
  [_cmp-ty : compiler_ast_types.AstType]
  [true-label : i64]
  [false-label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (begin
    (compiler-backend-publish-phi-planned-xmm-ahead! ctx 3)
    (match (compiler-backend-emit-gep-load-compare-branch-with-phi-copies-with-plan
      ctx.type-segment-bases
      ctx.assignments
      ctx.function
      ctx.blocks
      ctx.current-label
      base
      offset
      elem-ty
      op
      rhs
      load-ty
      true-label
      false-label
      (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
      ctx.program-index
      ctx.vars
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        0
        ctx.backend-state)
      ;; The comparison result is not materialized in this fusion, so its primary
      ;; scalar slot is the RHS staging home regardless of the folded Load's home.
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        2
        0
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        3
        1
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        3
        2
        ctx.backend-state))
      [(ResultCompilerBackend.Ok head)
        (begin
          (compiler-backend-asm-append
            out
            (compiler-backend-emergency-wrap head ctx.backend-state))
          (compiler-backend-emit-instrs ctx fallthrough instrs index out))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              (compiler-backend-instr-diagnostic
                ctx.spans
                ctx.source-function
                (compiler_ir_types.CompilerIrInstr.Gep
                  gep-dst
                  base
                  offset
                  elem-ty)
                ctx.func-diag
                ""))))])))

;; GAP8: fold a single-use fused-load result straight into the consuming ALU
;; op's memory operand -- `movq (b,i,8), %t; addq %t, %acc` becomes
;; `addq (b,i,8), %acc` -- one instruction and one register shorter, exactly
;; clang's selection for reduction loops. The probe is PURE (no scavenges, so
;; a rejected fold leaks no emergency-pending registers -- the M-D lesson);
;; the emitter mirrors emit-load-from-gep's two addressing arms and appends
;; the ALU line instead of the load. The non-loaded operand lands in the ALU
;; dst's home FIRST, so the probe rejects any dst-home that aliases an
;; address operand home, and every scavenge excludes dst-home.
(defenum CompilerBackendGepLoadAluFold
  (No)
  (Some String i64 compiler_ir_types.CompilerIrValue i64))

;; Two adjacent fused loads followed by a commutative ALU op can use the same
;; two-instruction shape as clang: load one memory operand straight into the
;; result home, then consume the other as the ALU memory operand. Keep this
;; direct-only (all address components and the result already register-homed),
;; so rejecting the fold has no scavenge or emergency-save side effects.
(defenum CompilerBackendGepLoadPairAluFold
  (No)
  (Some String i64 String String i64))

(define (compiler-backend-gep-load-pair-alu-mnemonic
  [op : compiler_ir_types.CompilerIrBinOp]) : String
  (match op
    [(compiler_ir_types.CompilerIrBinOp.Add) "add"]
    [(compiler_ir_types.CompilerIrBinOp.Mul) "imul"]
    [(compiler_ir_types.CompilerIrBinOp.BitAnd) "and"]
    [(compiler_ir_types.CompilerIrBinOp.BitOr) "or"]
    [(compiler_ir_types.CompilerIrBinOp.BitXor) "xor"]
    [_ ""]))

(define (compiler-backend-gep-load-pair-alu-probe
  [backend-state : CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [use-counts : (__tl_dyn-array i64)]
  [base : compiler_ir_types.CompilerIrValue]
  [offset0 : compiler_ir_types.CompilerIrValue]
  [elem-ty0 : compiler_ast_types.AstType]
  [gep-disp0 : i64]
  [load-dst0 : i64]
  [load-ty0 : compiler_ast_types.AstType]
  [offset1 : compiler_ir_types.CompilerIrValue]
  [elem-ty1 : compiler_ast_types.AstType]
  [gep-disp1 : i64]
  [load-dst1 : i64]
  [load-ty1 : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadPairAluFold
  (if (< index instrs.len)
    (let
      [maybe-binop : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [after-binop : i64 (+ index 1)]
      (match maybe-binop
        [(compiler_ir_types.CompilerIrInstr.BinOp dst op lhs rhs ty)
          (let
            [mnem : String (compiler-backend-gep-load-pair-alu-mnemonic op)]
            [dst-home : String
              (compiler-backend-var-register-home backend-state assignments dst)]
            [base-home : String
              (compiler-backend-address-base-filter
                (compiler-backend-value-scalar-register
                  backend-state
                  assignments
                  base))]
            [index0-home : String
              (compiler-backend-value-scalar-register
                backend-state
                assignments
                offset0)]
            [index1-home : String
              (compiler-backend-value-scalar-register
                backend-state
                assignments
                offset1)]
            [scale0 : i64
              (compiler-backend-type-size type-segment-bases elem-ty0)]
            [scale1 : i64
              (compiler-backend-type-size type-segment-bases elem-ty1)]
            [addr0 : String
              (if (and
                (not (string.eq base-home ""))
                (not (string.eq index0-home "")))
                (compiler-backend-gep-index-address-disp
                  gep-disp0
                  base-home
                  scale0
                  index0-home)
                "")]
            [addr1 : String
              (if (and
                (not (string.eq base-home ""))
                (not (string.eq index1-home "")))
                (compiler-backend-gep-index-address-disp
                  gep-disp1
                  base-home
                  scale1
                  index1-home)
                "")]
            (if (and
              (not (string.eq mnem ""))
              (= (compiler-backend-type-size type-segment-bases load-ty0) 8)
              (= (compiler-backend-type-size type-segment-bases load-ty1) 8)
              (= (compiler-backend-type-size type-segment-bases ty) 8)
              (not (compiler-backend-float-type? load-ty0))
              (not (compiler-backend-float-type? load-ty1))
              (not (compiler-backend-binop-f64? types global-types lhs rhs ty))
              (compiler-backend-var-single-use? use-counts load-dst0)
              (compiler-backend-var-single-use? use-counts load-dst1)
              (or
                (and
                  (compiler-backend-branch-uses-var? lhs load-dst0)
                  (compiler-backend-branch-uses-var? rhs load-dst1))
                (and
                  (compiler-backend-branch-uses-var? lhs load-dst1)
                  (compiler-backend-branch-uses-var? rhs load-dst0)))
              (not (string.eq dst-home ""))
              (not (string.eq addr0 ""))
              (not (string.eq addr1 ""))
              (not (string.eq dst-home base-home))
              (not (string.eq dst-home index0-home))
              (not (string.eq dst-home index1-home)))
              (CompilerBackendGepLoadPairAluFold.Some
                mnem
                dst
                addr0
                addr1
                after-binop)
              (CompilerBackendGepLoadPairAluFold.No)))]
        [_ (CompilerBackendGepLoadPairAluFold.No)]))
    (CompilerBackendGepLoadPairAluFold.No)))

(define (compiler-backend-emit-gep-load-pair-alu
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [mnem : String]
  [dst : i64]
  [addr0 : String]
  [addr1 : String]) : ResultCompilerBackend
  (let
    [dst-home : String
      (compiler-backend-var-register-home backend-state assignments dst)]
    (ResultCompilerBackend.Ok
      (str_cat.str-cat
        "    movq "
        addr0
        ", "
        dst-home
        "\n    "
        mnem
        "q "
        addr1
        ", "
        dst-home
        "\n"))))

(defenum CompilerBackendMaybeGepLoadPairAluDivmodEmission
  (No)
  (Some ResultCompilerBackend))

(defenum CompilerBackendMaybeGepLoadPairAluDivmodStore
  (No)
  (Some
    i64
    compiler_ir_types.CompilerIrValue
    compiler_ir_types.CompilerIrValue
    compiler_ast_types.AstType
    compiler_ir_types.CompilerIrValue
    compiler_ast_types.AstType
    i64))

(define (compiler-backend-gep-load-pair-alu-divmod-store-probe
  [ctx : CompilerBackendEmissionContext]
  [div-dst : i64]
  [src : String]
  [magic : String]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeGepLoadPairAluDivmodStore
  (if (compiler-backend-var-single-use? ctx.use-counts div-dst)
    (if (< index instrs.len)
      (let
        [maybe-gep : compiler_ir_types.CompilerIrInstr
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
        [after-gep : i64 (+ index 1)]
        (match maybe-gep
          [(compiler_ir_types.CompilerIrInstr.Gep gep-dst base offset elem-ty)
            (if (compiler-backend-var-single-use? ctx.use-counts gep-dst)
              (if (< after-gep instrs.len)
                (let
                  [maybe-store : compiler_ir_types.CompilerIrInstr
                    (compiler_ir_types.compiler-ir-instr-seq-ref
                      instrs
                      after-gep)]
                  [after-store : i64 (+ after-gep 1)]
                  (match maybe-store
                    [(compiler_ir_types.CompilerIrInstr.StorePtr
                        store-ptr
                        store-value
                        store-ty)
                      (if (and
                        (compiler-backend-divmod-direct-gep-store?
                          ctx.backend-state
                          ctx.type-segment-bases
                          ctx.assignments
                          div-dst
                          gep-dst
                          base
                          offset
                          elem-ty
                          store-ptr
                          store-value)
                        (compiler-backend-divmod-direct-gep-store-clobber-safe?
                          ctx.backend-state
                          ctx.assignments
                          src
                          magic
                          base
                          offset))
                        (CompilerBackendMaybeGepLoadPairAluDivmodStore.Some
                          gep-dst
                          base
                          offset
                          elem-ty
                          store-value
                          store-ty
                          after-store)
                        (CompilerBackendMaybeGepLoadPairAluDivmodStore.No))]
                    [_ (CompilerBackendMaybeGepLoadPairAluDivmodStore.No)]))
                (CompilerBackendMaybeGepLoadPairAluDivmodStore.No))
              (CompilerBackendMaybeGepLoadPairAluDivmodStore.No))]
          [_ (CompilerBackendMaybeGepLoadPairAluDivmodStore.No)]))
      (CompilerBackendMaybeGepLoadPairAluDivmodStore.No))
    (CompilerBackendMaybeGepLoadPairAluDivmodStore.No)))

(define (compiler-backend-emit-gep-load-pair-alu-divmod-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [mnem : String]
  [alu-dst : i64]
  [addr0 : String]
  [addr1 : String]
  [base : compiler_ir_types.CompilerIrValue]
  [offset0 : compiler_ir_types.CompilerIrValue]
  [offset1 : compiler_ir_types.CompilerIrValue]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepLoadPairAluDivmodEmission
  ;; Divmod polish normally retargets a one-use arithmetic producer into the
  ;; preserved-dividend register. A load-pair fold consumes that producer
  ;; first, so retain the same steering here instead of reintroducing a hot
  ;; producer-home -> dividend-home copy before the magic-mod sequence.
  (if (< index instrs.len)
    (let
      [div-instr : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [after-div : i64 (+ index 1)]
      (match div-instr
        [(compiler_ir_types.CompilerIrInstr.BinOp
            div-dst
            div-op
            div-lhs
            div-rhs
            div-ty)
          (let
            [planned-magic : String
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                5
                2
                ctx.backend-state)]
            [planned-src : String
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                5
                3
                ctx.backend-state)]
            [magic : String
              (compiler-backend-divmod-polish-magic-ahead
                ctx
                div-instr
                div-dst
                div-op
                div-rhs
                div-ty
                5
                planned-magic)]
            [hoist-reg : String
              (compiler-backend-divmod-polish-hoist-reg-ahead ctx div-instr 5)]
            [src : String
              (compiler-backend-divmod-polish-src
                ctx
                div-dst
                div-lhs
                magic
                hoist-reg
                planned-src
                false
                (compiler-backend-binop-wants-remainder? div-op)
                alu-dst)]
            [div-dst-home : String
              (compiler-backend-var-register-home
                ctx.backend-state
                ctx.assignments
                div-dst)]
            [direct-store : CompilerBackendMaybeGepLoadPairAluDivmodStore
              (compiler-backend-gep-load-pair-alu-divmod-store-probe
                ctx
                div-dst
                src
                magic
                instrs
                after-div)]
            [base-home : String
              (compiler-backend-value-scalar-register
                ctx.backend-state
                ctx.assignments
                base)]
            [index0-home : String
              (compiler-backend-value-scalar-register
                ctx.backend-state
                ctx.assignments
                offset0)]
            [index1-home : String
              (compiler-backend-value-scalar-register
                ctx.backend-state
                ctx.assignments
                offset1)]
            (if (and
              (compiler-backend-var-single-use? ctx.use-counts alu-dst)
              (compiler-backend-branch-uses-var? div-lhs alu-dst)
              (compiler-backend-signed-literal-divmod-src-shape?
                ctx.type-segment-bases
                div-op
                div-rhs
                div-ty)
              (compiler-backend-divmod-src-register? src)
              (or
                (not (string.eq div-dst-home ""))
                (match direct-store
                  [(CompilerBackendMaybeGepLoadPairAluDivmodStore.Some
                      _
                      _
                      _
                      _
                      _
                      _
                      _)
                    true]
                  [(CompilerBackendMaybeGepLoadPairAluDivmodStore.No) false]))
              (not (string.eq src base-home))
              (not (string.eq src index0-home))
              (not (string.eq src index1-home)))
              (let
                [saved-count : i64
                  (compiler-backend-function-state-emit-current-count
                    ctx.function-state)]
                [saved-reserved : i64
                  (compiler-backend-current-instr-reserved-mask
                    ctx.function-state)]
                [saved0-var : i64
                  (compiler-backend-function-state-i64
                    ctx.function-state
                    compiler-backend-function-i64-home-override0-var)]
                [saved0-reg : i64
                  (compiler-backend-function-state-i64
                    ctx.function-state
                    compiler-backend-function-i64-home-override0-reg)]
                [saved1-var : i64
                  (compiler-backend-function-state-i64
                    ctx.function-state
                    compiler-backend-function-i64-home-override1-var)]
                [saved1-reg : i64
                  (compiler-backend-function-state-i64
                    ctx.function-state
                    compiler-backend-function-i64-home-override1-reg)]
                [continuation : i64 after-div]
                [emitted : ResultCompilerBackend
                  (begin
                    ;; The planned dividend register was selected speculatively
                    ;; while probing this fusion. Admission has now committed,
                    ;; so arm its live-through preservation around the complete
                    ;; Gep/load/ALU/divmod bundle before the producer writes it.
                    (compiler-backend-preserve-planned-register!
                      src
                      ctx.backend-state)
                    (compiler-backend-divmod-overrides-install-spellings!
                      ctx.function-state
                      alu-dst
                      src
                      (match direct-store
                        [(CompilerBackendMaybeGepLoadPairAluDivmodStore.Some
                            _
                            _
                            _
                            _
                            _
                            _
                            _)
                          div-dst]
                        [(CompilerBackendMaybeGepLoadPairAluDivmodStore.No) -1])
                      (match direct-store
                        [(CompilerBackendMaybeGepLoadPairAluDivmodStore.Some
                            _
                            _
                            _
                            _
                            _
                            _
                            _)
                          src]
                        [(CompilerBackendMaybeGepLoadPairAluDivmodStore.No) ""]))
                    ;; The fused bundle starts at Gep0; div-instr is five IR
                    ;; instructions later (Load0, Gep1, Load1, producer).
                    (compiler-backend-function-state-set-emit-current-count!
                      ctx.function-state
                      (- saved-count 5))
                    (compiler-backend-set-current-instr-reserved-mask!
                      ctx.function-state
                      (compiler-backend-instr-reserved-home-mask
                        ctx.function-state
                        div-instr))
                    (match (compiler-backend-emit-gep-load-pair-alu
                      ctx.backend-state
                      ctx.assignments
                      mnem
                      alu-dst
                      addr0
                      addr1)
                      [(ResultCompilerBackend.Ok pair-asm)
                        (match (compiler-backend-emit-instr
                          ctx
                          (CompilerBackendMaybeLabel.No)
                          div-instr)
                          [(ResultCompilerBackend.Ok div-asm)
                            (match direct-store
                              [(CompilerBackendMaybeGepLoadPairAluDivmodStore.Some
                                  gep-dst
                                  store-base
                                  store-offset
                                  store-elem-ty
                                  store-value
                                  store-ty
                                  after-store)
                                (begin
                                  (compiler-backend-function-state-set-emit-current-count!
                                    ctx.function-state
                                    (- saved-count 6))
                                  (match (compiler-backend-emit-divmod-direct-gep-store
                                    ctx
                                    gep-dst
                                    store-base
                                    store-offset
                                    store-elem-ty
                                    store-value
                                    store-ty)
                                    [(ResultCompilerBackend.Ok store-asm)
                                      (begin
                                        (set! continuation after-store)
                                        (ResultCompilerBackend.Ok
                                          (str_cat.str-cat
                                            pair-asm
                                            div-asm
                                            store-asm)))]
                                    [(ResultCompilerBackend.Err message)
                                      (ResultCompilerBackend.Err message)]))]
                              [(CompilerBackendMaybeGepLoadPairAluDivmodStore.No)
                                (ResultCompilerBackend.Ok
                                  (str_cat.str-cat pair-asm div-asm))])]
                          [(ResultCompilerBackend.Err message)
                            (ResultCompilerBackend.Err message)])]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err message)]))]
                [_restore : unit
                  (begin
                    (compiler-backend-function-state-set-emit-current-count!
                      ctx.function-state
                      saved-count)
                    (compiler-backend-set-current-instr-reserved-mask!
                      ctx.function-state
                      saved-reserved)
                    (compiler-backend-divmod-overrides-install!
                      ctx.function-state
                      saved0-var
                      saved0-reg
                      saved1-var
                      saved1-reg))]
                (CompilerBackendMaybeGepLoadPairAluDivmodEmission.Some
                  (compiler-backend-emit-fused-result-rest
                    ctx
                    fallthrough
                    emitted
                    instrs
                    continuation
                    out)))
              (CompilerBackendMaybeGepLoadPairAluDivmodEmission.No)))]
        [_ (CompilerBackendMaybeGepLoadPairAluDivmodEmission.No)]))
    (CompilerBackendMaybeGepLoadPairAluDivmodEmission.No)))

(defenum CompilerBackendMaybeGepLoadPairAluEmission
  (No)
  (Some ResultCompilerBackend))

(define (compiler-backend-emit-dynamic-gep-load-pair-alu-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepLoadPairAluEmission
  ;; The existing general pair path owns constant field offsets. This narrow
  ;; sibling admits only two dynamic indexed loads followed immediately by the
  ;; commutative ALU consumer, the stack-binary-op shape in vm-run.
  (match (compiler-backend-value-as-i64 offset)
    [(option_i64.Some _) (CompilerBackendMaybeGepLoadPairAluEmission.No)]
    [(option_i64.None)
      (if (< index instrs.len)
        (let
          [maybe-gep : compiler_ir_types.CompilerIrInstr
            (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
          [after-gep : i64 (+ index 1)]
          (match maybe-gep
            [(compiler_ir_types.CompilerIrInstr.Gep
                gep-dst2
                base2
                offset2
                elem-ty2)
              (if (and
                (compiler-backend-var-single-use? ctx.use-counts gep-dst2)
                (compiler_optimize.opt-value-eq base2 base))
                (match (compiler-backend-value-as-i64 offset2)
                  [(option_i64.Some _)
                    (CompilerBackendMaybeGepLoadPairAluEmission.No)]
                  [(option_i64.None)
                    (if (< after-gep instrs.len)
                      (let
                        [maybe-load : compiler_ir_types.CompilerIrInstr
                          (compiler_ir_types.compiler-ir-instr-seq-ref
                            instrs
                            after-gep)]
                        [after-load2 : i64 (+ after-gep 1)]
                        (match maybe-load
                          [(compiler_ir_types.CompilerIrInstr.Load
                              load-dst2
                              src2
                              load-ty2)
                            (if (compiler-backend-branch-uses-var?
                              src2
                              gep-dst2)
                              ;; Probe with zero before mutating the GAP9 cursor.
                              ;; A displacement changes only the spelling of an
                              ;; already-valid SIB operand, never admission.
                              (match (compiler-backend-gep-load-pair-alu-probe
                                ctx.backend-state
                                ctx.type-segment-bases
                                ctx.assignments
                                ctx.types
                                ctx.global-types
                                ctx.use-counts
                                base
                                offset
                                elem-ty
                                gep-fold-disp
                                load-dst
                                load-ty
                                offset2
                                elem-ty2
                                0
                                load-dst2
                                load-ty2
                                instrs
                                after-load2)
                                [(CompilerBackendGepLoadPairAluFold.Some
                                    _
                                    _
                                    _
                                    _
                                    _)
                                  (let
                                    [gep-fold-disp2 : i64
                                      (compiler-backend-gep-fold-next!
                                        ctx.function-state
                                        ctx.type-segment-bases
                                        offset2
                                        elem-ty2)]
                                    (match (compiler-backend-gep-load-pair-alu-probe
                                      ctx.backend-state
                                      ctx.type-segment-bases
                                      ctx.assignments
                                      ctx.types
                                      ctx.global-types
                                      ctx.use-counts
                                      base
                                      offset
                                      elem-ty
                                      gep-fold-disp
                                      load-dst
                                      load-ty
                                      offset2
                                      elem-ty2
                                      gep-fold-disp2
                                      load-dst2
                                      load-ty2
                                      instrs
                                      after-load2)
                                      [(CompilerBackendGepLoadPairAluFold.Some
                                          mnem
                                          alu-dst
                                          addr0
                                          addr1
                                          after-binop)
                                        (match (compiler-backend-emit-gep-load-pair-alu-divmod-rest
                                          ctx
                                          fallthrough
                                          mnem
                                          alu-dst
                                          addr0
                                          addr1
                                          base
                                          offset
                                          offset2
                                          instrs
                                          after-binop
                                          out)
                                          [(CompilerBackendMaybeGepLoadPairAluDivmodEmission.Some
                                              result)
                                            (CompilerBackendMaybeGepLoadPairAluEmission.Some
                                              result)]
                                          [(CompilerBackendMaybeGepLoadPairAluDivmodEmission.No)
                                            (CompilerBackendMaybeGepLoadPairAluEmission.Some
                                              (compiler-backend-emit-fused-result-rest
                                                ctx
                                                fallthrough
                                                (compiler-backend-emit-gep-load-pair-alu
                                                  ctx.backend-state
                                                  ctx.assignments
                                                  mnem
                                                  alu-dst
                                                  addr0
                                                  addr1)
                                                instrs
                                                after-binop
                                                out))])]
                                      [(CompilerBackendGepLoadPairAluFold.No)
                                        ;; The zero-displacement probe above
                                        ;; admitted this exact shape.
                                        (CompilerBackendMaybeGepLoadPairAluEmission.No)]))]
                                [(CompilerBackendGepLoadPairAluFold.No)
                                  (CompilerBackendMaybeGepLoadPairAluEmission.No)])
                              (CompilerBackendMaybeGepLoadPairAluEmission.No))]
                          [_ (CompilerBackendMaybeGepLoadPairAluEmission.No)]))
                      (CompilerBackendMaybeGepLoadPairAluEmission.No))])
                (CompilerBackendMaybeGepLoadPairAluEmission.No))]
            [_ (CompilerBackendMaybeGepLoadPairAluEmission.No)]))
        (CompilerBackendMaybeGepLoadPairAluEmission.No))]))

;; Two-operand memory-form mnemonics only; Mul is excluded (imul mem needs
;; the two-operand register form and folds worse than the fused load).
(define (compiler-backend-gep-load-alu-mnemonic
  [op : compiler_ir_types.CompilerIrBinOp]) : String
  (match op
    [(compiler_ir_types.CompilerIrBinOp.Add) "add"]
    [(compiler_ir_types.CompilerIrBinOp.Sub) "sub"]
    [(compiler_ir_types.CompilerIrBinOp.BitAnd) "and"]
    [(compiler_ir_types.CompilerIrBinOp.BitOr) "or"]
    [(compiler_ir_types.CompilerIrBinOp.BitXor) "xor"]
    [_ ""]))

(define (compiler-backend-gep-load-alu-probe
  [backend-state : CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [use-counts : (__tl_dyn-array i64)]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadAluFold
  (if (or
    (compiler-backend-float-type? load-ty)
    (not (= (compiler-backend-type-size type-segment-bases load-ty) 8))
    (not (compiler-backend-var-single-use? use-counts load-dst)))
    (CompilerBackendGepLoadAluFold.No)
    (if (< index instrs.len)
      (let
        [maybe-binop : compiler_ir_types.CompilerIrInstr
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
        [after-binop : i64 (+ index 1)]
        (match maybe-binop
          [(compiler_ir_types.CompilerIrInstr.BinOp dst op lhs rhs ty)
            (let
              [mnem : String (compiler-backend-gep-load-alu-mnemonic op)]
              ;; GAP8-B: the loaded value on the RHS is the shape the two-address
              ;; lowering hands over directly -- `dst := lhs; dst op= rhs` puts
              ;; the memory operand in the ALU's source slot. A COMMUTATIVE op
              ;; folds the mirrored shape just as soundly: `dst = MEM op x` is
              ;; `dst = x op MEM`, so the non-loaded operand lands in dst's home
              ;; first and the fold reads memory from the other side. Sub is
              ;; excluded by construction -- compiler-backend-commutative-binop?
              ;; refuses it -- because `MEM - x` is not `x - MEM`.
              [mem-is-rhs? : bool
                (and
                  (compiler-backend-branch-uses-var? rhs load-dst)
                  (not (compiler-backend-branch-uses-var? lhs load-dst)))]
              [mem-is-lhs? : bool
                (and
                  (compiler-backend-commutative-binop? op)
                  (compiler-backend-branch-uses-var? lhs load-dst)
                  (not (compiler-backend-branch-uses-var? rhs load-dst)))]
              ;; The operand that is NOT the folded load; it is staged into the
              ;; ALU destination's home before the memory operand is consumed.
              [x : compiler_ir_types.CompilerIrValue
                (if mem-is-rhs?
                  lhs
                  rhs)]
              [dst-home : String
                (compiler-backend-var-register-home
                  backend-state
                  assignments
                  dst)]
              [base-home : String
                (compiler-backend-value-scalar-register
                  backend-state
                  assignments
                  base)]
              [offset-home : String
                (compiler-backend-value-scalar-register
                  backend-state
                  assignments
                  offset)]
              (if (and
                (not (string.eq mnem ""))
                (or mem-is-rhs? mem-is-lhs?)
                (not
                  (compiler-backend-binop-f64? types global-types lhs rhs ty))
                (=
                  (compiler-backend-type-size
                    type-segment-bases
                    (compiler-backend-binop-operand-ty
                      types
                      global-types
                      op
                      lhs
                      rhs
                      ty))
                  8)
                (not (string.eq dst-home ""))
                (not (string.eq dst-home base-home))
                (not (string.eq dst-home offset-home)))
                (CompilerBackendGepLoadAluFold.Some mnem dst x after-binop)
                (CompilerBackendGepLoadAluFold.No)))]
          [_ (CompilerBackendGepLoadAluFold.No)]))
      (CompilerBackendGepLoadAluFold.No))))

;; The dynamic-index register pool mirror of scavenge-exclude-regs2, extended
;; with the ALU destination home.
(define (compiler-backend-gep-load-alu-index-exclude
  [base-reg : String]
  [offset-home : String]
  [dst-home : String]) : (__tl_dyn-array String)
  (__tl_make-array
    "%rax"
    "%rdx"
    "%rcx"
    base-reg
    (if (string.eq offset-home "")
      base-reg
      offset-home)
    dst-home))

(define (compiler-backend-emit-gep-load-alu
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [mnem : String]
  [alu-dst : i64]
  [x : compiler_ir_types.CompilerIrValue]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [gep-disp : i64]
  [planned-base : String]
  [planned-index : String]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [dst-home : String
      (compiler-backend-var-register-home backend-state assignments alu-dst)]
    (match (compiler-backend-value-as-i64 offset)
      [(option_i64.Some n)
        (let
          ;; gep-disp is 0 here in practice (only Var-index geps carry a
          ;; folded displacement); merged for totality.
          [disp : i64
            (+
              (* n (compiler-backend-type-size type-segment-bases elem-ty))
              gep-disp)]
          [base-home : String
            (compiler-backend-address-base-filter-direct
              (compiler-backend-value-scalar-register
                backend-state
                assignments
                base))]
          [base-reg : String
            (if (string.eq base-home "")
              (compiler-backend-planned-or-scavenge-reg
                planned-base
                alu-dst
                (compiler-backend-one-exclude dst-home)
                1
                "%r10"
                backend-state)
              base-home)]
          [addr : String (compiler-backend-base-address disp base-reg)]
          (match (compiler-backend-emit-load-value-with-plan
            assignments
            base
            base-reg
            backend-state)
            [(ResultCompilerBackend.Ok base-asm)
              (match (compiler-backend-emit-load-value-with-plan
                assignments
                x
                dst-home
                backend-state)
                [(ResultCompilerBackend.Ok x-asm)
                  (ResultCompilerBackend.Ok
                    (str_cat.str-cat
                      base-asm
                      x-asm
                      (str_cat.str-cat "    " mnem "q " addr ", " dst-home "\n")))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)])]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)]))]
      [(option_i64.None)
        (let
          [scale : i64 (compiler-backend-type-size type-segment-bases elem-ty)]
          [sib-scale? : bool (compiler-backend-gep-sib-scale? scale)]
          [base-home : String
            (compiler-backend-address-base-filter
              (compiler-backend-value-scalar-register
                backend-state
                assignments
                base))]
          [offset-home : String
            (compiler-backend-value-scalar-register
              backend-state
              assignments
              offset)]
          [use-base-home? : bool
            (and sib-scale? (not (string.eq base-home "")))]
          [base-reg : String
            (if use-base-home?
              base-home
              (compiler-backend-planned-or-scavenge-reg
                planned-base
                alu-dst
                (compiler-backend-two-exclude offset-home dst-home)
                2
                "%r10"
                backend-state))]
          [use-offset-home? : bool
            (and
              sib-scale?
              (not (string.eq offset-home ""))
              (not (string.eq offset-home base-reg)))]
          [index-reg : String
            (if use-offset-home?
              offset-home
              (compiler-backend-planned-or-scavenge-reg
                planned-index
                alu-dst
                (compiler-backend-gep-load-alu-index-exclude
                  base-reg
                  offset-home
                  dst-home)
                6
                "%r8"
                backend-state))]
          [addr : String
            (compiler-backend-gep-index-address-disp
              gep-disp
              base-reg
              scale
              index-reg)]
          [addr-asm : String
            (if (string.eq addr "")
              (compiler-backend-gep-index-base-asm-disp
                gep-disp
                base-reg
                scale
                index-reg)
              "")]
          [load-addr : String
            (if (string.eq addr "")
              (str_cat.str-cat "(" base-reg ")" "")
              addr)]
          (match (if use-base-home?
            (ResultCompilerBackend.Ok "")
            (compiler-backend-emit-load-value-with-plan
              assignments
              base
              base-reg
              backend-state))
            [(ResultCompilerBackend.Ok base-asm)
              (match (if use-offset-home?
                (ResultCompilerBackend.Ok "")
                (compiler-backend-emit-load-value-with-plan
                  assignments
                  offset
                  index-reg
                  backend-state))
                [(ResultCompilerBackend.Ok offset-asm)
                  (match (compiler-backend-emit-load-value-with-plan
                    assignments
                    x
                    dst-home
                    backend-state)
                    [(ResultCompilerBackend.Ok x-asm)
                      (ResultCompilerBackend.Ok
                        (str_cat.str-cat
                          base-asm
                          offset-asm
                          addr-asm
                          x-asm
                          (str_cat.str-cat
                            "    "
                            mnem
                            "q "
                            load-addr
                            ", "
                            dst-home
                            "\n")))]
                    [(ResultCompilerBackend.Err message)
                      (ResultCompilerBackend.Err message)])]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)])]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)]))])))

;; --------------------------------------------------------------------------
;; M6: fold a single-use load into the comparing instruction's memory operand.
;;
;; TL emitted the load and the compare separately -- `movq 8(%rax), %rdi ;
;; cmpq %rdi, %rsi` -- where C folds the load into the compare's memory
;; operand: `cmpq 8(%rax), %rsi`, one instruction and one live register fewer.
;; GAP9 already folds the CONST-offset gep+load whose value is the compare's
;; LHS and whose compare feeds a branch. The M6 shapes below are the rest of
;; that family, reached through the same gep fusion cluster:
;;
;;   M6-A  the LENGTH operand of an immediately following bounds check
;;         (`movq 8(%rax),%rdi ; cmpq %rdi,%rsi ; jb ok` -> `cmpq 8(%rax),%rsi ;
;;         jb ok`), including the dynamic SIB-index address GAP9 declines.
;;   M6-B  a compare+branch with the loaded value on EITHER side, and the
;;         dynamic SIB-index address, which GAP9 declines on both counts.
;;   M6-C  a NARROW (byte/word/long) load whose widening cast feeds an equality
;;         compare: `movzbq (%r9,%rsi,1),%rsi ; cmpq $46,%rsi` -> `cmpb $46,
;;         (%r9,%rsi,1)`.
;;
;; Every M6 probe is PURE: it only spells an address out of register homes the
;; allocator already chose, so a declined fold performs no scavenge and leaks
;; no emergency-pending register (the M-D lesson recorded on the GAP8 probe).
;; That is why each shape requires its address components -- and the compare's
;; other operand -- to be register-homed or immediate; a spilled component
;; declines back to the existing emission instead of staging.
;;
;; The loaded value's own home register is simply never written when a fold
;; fires. That is sound exactly because every shape is gated on
;; `compiler-backend-var-single-use?` for the load destination (and for the
;; cast/compare destinations it chains through): nothing else can read the
;; home, so leaving its previous contents in place is unobservable.
(define (compiler-backend-gep-load-cmp-address
  [backend-state : CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [gep-disp : i64]) : String
  ;; %rbp is excluded from the BASE slot on BOTH arms, not just the dynamic arm
  ;; address-base-filter already guards: the `disp(,%rbp,1)` spelling the const
  ;; arm would otherwise use is re-read by the bounds-abort tail after a `pushq`
  ;; has moved %rsp, and it is the exact shape the FPO rsp-rebase pass rewrites.
  (let
    [base-home : String
      (compiler-backend-address-base-filter
        (compiler-backend-value-scalar-register backend-state assignments base))]
    (if (string.eq base-home "")
      ""
      (match (compiler-backend-value-as-i64 offset)
        [(option_i64.Some n)
          (let
            [disp : i64
              (+
                (* n (compiler-backend-type-size type-segment-bases elem-ty))
                gep-disp)]
            (if (compiler-backend-imm32? disp)
              (compiler-backend-base-address disp base-home)
              ""))]
        [(option_i64.None)
          (let
            [scale : i64
              (compiler-backend-type-size type-segment-bases elem-ty)]
            [index-home : String
              (compiler-backend-value-scalar-register
                backend-state
                assignments
                offset)]
            (if (and
              (compiler-backend-gep-sib-scale? scale)
              (not (string.eq index-home ""))
              (not (string.eq index-home "%rbp"))
              (compiler-backend-imm32? gep-disp))
              (compiler-backend-gep-index-address-disp
                gep-disp
                base-home
                scale
                index-home)
              ""))]))))

;; M6-D. Every address above is spelled straight out of the homes the allocator
;; chose, so a gep whose BASE was spilled (or homed in %rbp, which the dynamic
;; arm's SIB base slot cannot take) declines and the ordinary path emits three
;; instructions:
;;
;;     movq SPILL, %t          ; stage the base
;;     movq (%t,%i,8), %r      ; load
;;     cmpq $K, %r             ; compare
;;
;; The staging `movq` is unavoidable -- x86 has no memory BASE operand -- but
;; the load is not: once the base sits in %t the compare reads `(%t,%i,8)`
;; itself, and the shape folds to two instructions instead of three.
;;
;; The staging register is the LOAD DESTINATION's own register home -- not a
;; scavenged one. That keeps the probe pure (the M-D lesson: a probe that may
;; still decline must never scavenge, or a rejected fold leaks an
;; emergency-pending register), and it is sound by construction:
;;
;;   - the whole M6 family is gated on `compiler-backend-var-single-use?` for
;;     the load destination, and the fold consumes that single use, so after the
;;     fold nothing reads the home at all;
;;   - the unfolded emission WRITES that same home at exactly this program point
;;     (it is the load's destination), so writing it here instead clobbers
;;     nothing the allocator had not already declared dead;
;;   - the compare's other operand is live ACROSS the load it replaces, so the
;;     allocator cannot have given it the load destination's home; the operands
;;     therefore cannot collide;
;;   - the base is register-less on this path, so it cannot collide either, and
;;     the index is checked explicitly below -- an index sharing the load
;;     destination's home (legal for `movq (%r11,%rcx,8), %rcx`) would be
;;     destroyed by the staging write, so that shape declines.
;;
;; A spilled load destination has no home and declines. %rbp is refused as a
;; staging base for the same reason address-base-filter refuses it elsewhere.
;;
;; Only shapes the DIRECT address declines reach here, and only where the
;; ordinary path would have staged too -- otherwise the "fold" would add a
;; staging `movq` that was never being paid. That is address-base-filter on the
;; dynamic arm (%rbp included: its home cannot serve as a SIB base) and a
;; genuinely register-less home on the const arm, where
;; address-base-filter-direct lets even %rbp address `disp(,%rbp,1)` in place.
(define (compiler-backend-gep-load-cmp-staged-base
  [ctx : CompilerBackendEmissionContext]
  [load-dst : i64]) : String
  (compiler-backend-address-base-filter
    (compiler-backend-var-register-home
      ctx.backend-state
      ctx.assignments
      load-dst)))

(define (compiler-backend-gep-load-cmp-staged-address
  [backend-state : CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [gep-disp : i64]
  [direct-addr : String]
  [staged-base : String]) : String
  (let
    [raw-base-home : String
      (compiler-backend-value-scalar-register backend-state assignments base)]
    (if (or
      (string.eq staged-base "")
      (string.eq staged-base "%rbp")
      ;; The direct address already spells this shape; staging would only add a
      ;; redundant copy.
      (not (string.eq direct-addr "")))
      ""
      (match (compiler-backend-value-as-i64 offset)
        [(option_i64.Some n)
          ;; Const arm: the ordinary path addresses a %rbp-homed base in place,
          ;; so only a base with no register home at all is staged there.
          (let
            [disp : i64
              (+
                (* n (compiler-backend-type-size type-segment-bases elem-ty))
                gep-disp)]
            (if (and
              (string.eq raw-base-home "")
              (compiler-backend-imm32? disp))
              (compiler-backend-base-address disp staged-base)
              ""))]
        [(option_i64.None)
          (let
            [scale : i64
              (compiler-backend-type-size type-segment-bases elem-ty)]
            [base-home : String
              (compiler-backend-address-base-filter raw-base-home)]
            [index-home : String
              (compiler-backend-value-scalar-register
                backend-state
                assignments
                offset)]
            (if (or
              (not (compiler-backend-gep-sib-scale? scale))
              (not (compiler-backend-imm32? gep-disp)))
              ""
              (cond
                ;; Stage the BASE: the index already occupies a register the SIB
                ;; index slot can take.
                [(and
                    (string.eq base-home "")
                    (not (string.eq index-home ""))
                    (not (string.eq index-home "%rbp"))
                    ;; The staging write must not land on the index register the
                    ;; same address then reads.
                    (not (string.eq index-home staged-base)))
                  (compiler-backend-gep-index-address-disp
                    gep-disp
                    staged-base
                    scale
                    index-home)]
                ;; Stage the INDEX: the mirror case, and the common one -- a
                ;; spilled loop index the ordinary path copies into a scavenged
                ;; register before the load. Staging it into the load
                ;; destination's home instead lets the compare read the element
                ;; without the load, for the same one staging `movq`.
                [(and
                    (not (string.eq base-home ""))
                    (string.eq index-home "")
                    (not (string.eq base-home staged-base)))
                  (compiler-backend-gep-index-address-disp
                    gep-disp
                    base-home
                    scale
                    staged-base)]
                ;; Both sides spilled would need two staging registers, and the
                ;; fold owns exactly one.
                [else ""])))]))))

;; Which operand M6-D stages. Mirrors the arms of
;; compiler-backend-gep-load-cmp-staged-address: a base the SIB base slot cannot
;; take is staged, otherwise it is the spilled index. Only ever consulted when
;; that function returned a non-empty address, so exactly one of the two arms
;; applies.
(define (compiler-backend-gep-load-cmp-staged-value
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrValue
  (if (string.eq
    (compiler-backend-address-base-filter
      (compiler-backend-value-scalar-register backend-state assignments base))
    "")
    base
    offset))

;; --- M6-H: the staging register when the LOAD DESTINATION is SPILLED ---------
;;
;; M6-D above sources its one staging register from the load destination's own
;; register home, and a SPILLED destination therefore declines. That refusal
;; lands exactly where the fold is worth the most. When the base is spilled AND
;; the destination is spilled -- the shape a saturated register file produces --
;; the unfolded path emits FOUR instructions plus, under saturation, two
;; emergency wraps:
;;
;;     movq %occupant, EM0        ; emergency-save the base scratch
;;     movq %occupant2, EM1       ; emergency-save the value scratch
;;     movq SPILL, %t             ; stage the base
;;     movq (%t,%i,8), %v         ; load
;;     movq %v, SLOT              ; store the loaded value to its home
;;     movq EM1, %occupant2       ; emergency-restore
;;     movq EM0, %occupant        ; emergency-restore
;;     cmpq SLOT, %r              ; compare against the slot just written
;;
;; measured verbatim in liveness_scan's change-detection loop. Folded, the same
;; shape is one staging `movq` and one `cmpq` reading `(%t,%i,8)` directly: the
;; loaded var is never materialised, so it needs no scratch, no home store and
;; no second emergency wrap. The staging `movq` is the one the unfolded path
;; was already paying, so the fold never adds an instruction.
;;
;; WHY A SCAVENGED STAGING REGISTER IS SOUND HERE. The M6-D argument that the
;; destination's home is safe has three parts -- nothing reads the loaded var
;; after the fold, the unfolded path writes that register at this same point,
;; and the compare's other operand cannot be homed there. Only the third part
;; needs replacing when the register comes from the scavenger instead, because a
;; scavenged register can be anything the pool offers, and the EMERGENCY tier
;; ignores occupancy by design. The replacement is the sound-scavenger's own
;; device: for the duration of the pick the reserved mask is widened from the
;; GEP's operand homes to the union of the operand+result homes of the
;; instructions the fold may swallow (the load's consumer, the compare, and its
;; branch). Both the ordinary candidate filter and the emergency tier honour
;; that mask, so the pick provably avoids the compare's other operand, the
;; branch's condition, and the address's own index -- the three registers that
;; must survive from the staging write to the compare. The base is register-less
;; on this path, so it cannot collide, and the loaded var is spilled, so it has
;; no home to protect.
;;
;; TWO-SIDED PINNING. The probe must stay pure (the M-D lesson: a probe that can
;; still decline must never scavenge, or a rejected fold leaks an
;; emergency-pending register), so admission PEEKS through
;; compiler-backend-scavenge-reg-peek -- the documented side-effect-free twin
;; that predicts the ordinary picker's answer including its emergency tier --
;; and the committed emitter re-runs the identical pick for real through
;; compiler-backend-scavenge-reg. The two agree because this one helper is the
;; only caller of either on this path and it supplies the same arguments to
;; both: dst-var -1 (so neither appends a destination home), the same empty
;; exclude array, the same "%r10" fallback, and the same widened reserved mask,
;; queried at the same emission point -- nothing between the peek and the commit
;; touches the emit cursor, the occupancy map or the assignment index. `commit?`
;; is the ONLY difference between the two calls.
;;
;; REACH, and why the lookahead is exactly three. The widened mask has to cover
;; every instruction whose operand homes must survive from the staging write to
;; the folded compare, and `compiler-backend-cmp-fold-walk` can step over up to
;; four size-preserving casts before reaching that compare -- further than any
;; fixed window worth paying for. So the shape test below ADMITS only the two
;; positions a three-instruction window provably covers: the compare sitting
;; directly behind the load, or one cast then the compare. A deeper cast chain
;; is refused rather than half-protected; the direct-address M6-C/M6-D folds,
;; which need no staging register and therefore no mask, keep the full walk.
;;
;; ADMISSION COST. The peek is not free -- an occupancy query, a candidate walk
;; and the widened mask -- and it would otherwise run at every spilled-base
;; spilled-destination load in the program, most of which no fold claims. The
;; same shape test decides the peek before any address work happens: two enum
;; matches and no allocation.
(define compiler-backend-gep-load-cmp-staging-lookahead : i64
  3)

(define (compiler-backend-instr-size-preserving-cast?
  [instr : compiler_ir_types.CompilerIrInstr]) : bool
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Cast _ _ _ _) true]
    [_ false]))

(define (compiler-backend-gep-load-cmp-staging-compare-here?
  [load-dst : i64]
  [instr : compiler_ir_types.CompilerIrInstr]) : bool
  (match instr
    [(compiler_ir_types.CompilerIrInstr.BinOp _ op lhs rhs _)
      (and
        (compiler-backend-compare-op? op)
        (or
          (compiler-backend-branch-uses-var? lhs load-dst)
          (compiler-backend-branch-uses-var? rhs load-dst)))]
    [_ false]))

(define (compiler-backend-gep-load-cmp-staging-shape?
  [load-dst : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : bool
  (if (>= (+ index 1) instrs.len)
    false
    (let
      [here : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [next : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs (+ index 1))]
      (if (compiler-backend-gep-load-cmp-staging-compare-here? load-dst here)
        true
        (match here
          [(compiler_ir_types.CompilerIrInstr.Cast cast-dst cast-src _ _)
            (and
              (compiler-backend-branch-uses-var? cast-src load-dst)
              ;; One cast, then the consumer. A second cast would let the walk
              ;; run past the window the mask covers, so it is refused here.
              (not (compiler-backend-instr-size-preserving-cast? next))
              (or
                (compiler-backend-gep-load-cmp-staging-compare-here?
                  cast-dst
                  next)
                ;; M6-G: the widening cast IS the consumer, and its own load is
                ;; emitted immediately behind the staging write, so nothing but
                ;; the gep's own operands has to survive.
                (< (+ index 1) instrs.len)))]
          [_ false])))))

(define (compiler-backend-gep-load-cmp-staging-reserved-mask
  [ctx : CompilerBackendEmissionContext]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [remaining : i64]
  [acc : i64]) : i64
  (if (or (<= remaining 0) (>= index instrs.len))
    acc
    (compiler-backend-gep-load-cmp-staging-reserved-mask
      ctx
      instrs
      (+ index 1)
      (- remaining 1)
      (bit-or
        acc
        (compiler-backend-instr-reserved-home-mask
          ctx.function-state
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index))))))

(define (compiler-backend-gep-load-cmp-scavenged-staging-base
  [ctx : CompilerBackendEmissionContext]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [commit? : bool]) : String
  (let
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [_widen : unit
      (compiler-backend-set-current-instr-reserved-mask!
        ctx.function-state
        (compiler-backend-gep-load-cmp-staging-reserved-mask
          ctx
          instrs
          index
          compiler-backend-gep-load-cmp-staging-lookahead
          saved-reserved))]
    [reg : String
      (if commit?
        (compiler-backend-scavenge-reg
          -1
          (compiler-backend-one-exclude "")
          1
          "%r10"
          ctx.backend-state)
        (compiler-backend-scavenge-reg-peek
          -1
          (compiler-backend-one-exclude "")
          1
          "%r10"
          ctx.backend-state))]
    [_restore : unit
      (compiler-backend-set-current-instr-reserved-mask!
        ctx.function-state
        saved-reserved)]
    (compiler-backend-address-base-filter reg)))

;; True when the instruction would emit the LOCATED runtime-abort tail
;; (`tl_oob_abort_at`), which re-reads both compare operands through `pushq`
;; after %rsp has already moved. M6-A keeps that tail on the register form it
;; was validated with and declines instead. Pure: it mirrors the predicate
;; compiler-backend-runtime-abort-site-install! uses without mutating the
;; function state the dispatch seam installs for the instruction it is really
;; emitting.
(define (compiler-backend-abort-site-would-activate?
  [ctx : CompilerBackendEmissionContext]
  [instr : compiler_ir_types.CompilerIrInstr]) : bool
  (and
    (compiler-backend-runtime-abort-site-instr? ctx.backend-state instr)
    (match (compiler_ir_types.compiler-source-spans-lookup-instr-location
      ctx.spans
      ctx.source-function
      instr)
      [(compiler_ir_types.CompilerMaybeSourceLocation.No) false]
      [(compiler_ir_types.CompilerMaybeSourceLocation.Some location)
        (> location.path-id 0)])))

;; Follow the fused load's value forward to the instruction that consumes it,
;; stepping over the width-preserving casts TL's typed surface leaves between a
;; `.len` load and the bounds check that uses it (`%17 = cast %15 : i64 to u64`
;; with `%16 = cast %0 : i64 to u64` for the index sitting beside it). Two kinds
;; of step are admitted, and BOTH emit nothing on the machine:
;;
;;   - a size-preserving non-float cast OF the tracked value whose destination
;;     is single-use: it renames the value and is folded away with the load;
;;   - a size-preserving non-float cast of some OTHER value whose source and
;;     destination already share one register home: the allocator has made it a
;;     self-move, so skipping it neither drops work nor writes any register --
;;     in particular it cannot clobber the address registers the folded compare
;;     now reads at the consumer instead of at the load.
;;
;; Anything else ends the walk at that instruction; `fuel` bounds the scan.
;; The result carries the tracked value var and the index it stopped at.
(defenum CompilerBackendCmpFoldWalk
  (No)
  (Some i64 i64))

(define (compiler-backend-cmp-fold-walk
  [ctx : CompilerBackendEmissionContext]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [value-var : i64]
  [fuel : i64]) : CompilerBackendCmpFoldWalk
  (if (>= index instrs.len)
    (CompilerBackendCmpFoldWalk.No)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Cast cast-dst cast-src from-ty to-ty)
        (if (or
          (<= fuel 0)
          (compiler-backend-float-type? from-ty)
          (compiler-backend-float-type? to-ty)
          (not
            (=
              (compiler-backend-type-size ctx.type-segment-bases from-ty)
              (compiler-backend-type-size ctx.type-segment-bases to-ty))))
          (CompilerBackendCmpFoldWalk.Some value-var index)
          (if (compiler-backend-branch-uses-var? cast-src value-var)
            (if (compiler-backend-var-single-use? ctx.use-counts cast-dst)
              (compiler-backend-cmp-fold-walk
                ctx
                instrs
                (+ index 1)
                cast-dst
                (- fuel 1))
              (CompilerBackendCmpFoldWalk.Some value-var index))
            (let
              [src-home : String
                (compiler-backend-value-scalar-register
                  ctx.backend-state
                  ctx.assignments
                  cast-src)]
              [dst-home : String
                (compiler-backend-var-register-home
                  ctx.backend-state
                  ctx.assignments
                  cast-dst)]
              (if (and
                (not (string.eq src-home ""))
                (string.eq src-home dst-home))
                (compiler-backend-cmp-fold-walk
                  ctx
                  instrs
                  (+ index 1)
                  value-var
                  (- fuel 1))
                (CompilerBackendCmpFoldWalk.Some value-var index)))))]
      [_ (CompilerBackendCmpFoldWalk.Some value-var index)])))

(define compiler-backend-cmp-fold-walk-fuel : i64
  4)

;; M6-A: length memory operand, index register operand, ok-label, resume index.
(defenum CompilerBackendGepLoadBoundsFold
  (No)
  (Some String String i64 i64))

(define (compiler-backend-gep-load-bounds-probe
  [ctx : CompilerBackendEmissionContext]
  [addr : String]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadBoundsFold
  ;; The bounds compare is a 64-bit unsigned `cmpq len, idx`, so the loaded
  ;; length must be a full word: no narrow width and no float ever reaches here.
  ;; Size-preserving casts on the way leave that word's bit pattern alone, so
  ;; the walk may cross them.
  (if (or
    (string.eq addr "")
    (compiler-backend-float-type? load-ty)
    (not (= (compiler-backend-type-size ctx.type-segment-bases load-ty) 8))
    (not (compiler-backend-var-single-use? ctx.use-counts load-dst)))
    (CompilerBackendGepLoadBoundsFold.No)
    (match (compiler-backend-cmp-fold-walk
      ctx
      instrs
      index
      load-dst
      compiler-backend-cmp-fold-walk-fuel)
      [(CompilerBackendCmpFoldWalk.No) (CompilerBackendGepLoadBoundsFold.No)]
      [(CompilerBackendCmpFoldWalk.Some length-var stop)
        (let
          [next : compiler_ir_types.CompilerIrInstr
            (compiler_ir_types.compiler-ir-instr-seq-ref instrs stop)]
          (match next
            [(compiler_ir_types.CompilerIrInstr.BoundsCheck
                bc-index
                bc-length
                ok-label)
              (let
                [index-reg : String
                  (compiler-backend-value-scalar-register-home
                    ctx.backend-state
                    ctx.assignments
                    bc-index)]
                ;; A register-homed INDEX is required: the folded length already
                ;; occupies the compare's memory operand and `cmp mem, mem` is
                ;; illegal, so a spilled or constant index declines to the
                ;; ordinary path (which owns its own index staging and its
                ;; GAP6d const form).
                (if (and
                  (compiler-backend-branch-uses-var? bc-length length-var)
                  (not (compiler-backend-branch-uses-var? bc-index length-var))
                  (not (string.eq index-reg ""))
                  (not (compiler-backend-abort-site-would-activate? ctx next)))
                  (CompilerBackendGepLoadBoundsFold.Some
                    addr
                    index-reg
                    ok-label
                    (+ stop 1))
                  (CompilerBackendGepLoadBoundsFold.No)))]
            [_ (CompilerBackendGepLoadBoundsFold.No)]))])))

;; The M6-A mirror of compiler-backend-rest-starts-load-compare-branch?: the
;; adjacent-load PAIR rule declines when the second load is the length operand
;; of the bounds check right behind it, so that gep+load re-enters the fusion
;; cluster on its own and M6-A can put the length straight in the compare.
;; Unlike the compare-branch predicate this one runs the real probe, because
;; declining the pair for a fold that then refuses would leave two independent
;; single loads where the pair rule had one shared base. The displacement is
;; taken as 0: the pair arm is constant-offset-only, and a constant offset
;; contributes nothing to the GAP9 fold (whose ordinal must not be consumed by
;; a predicate anyway).
(define (compiler-backend-gep-load-bounds-foldable?
  [ctx : CompilerBackendEmissionContext]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : bool
  (match (compiler-backend-gep-load-bounds-probe
    ctx
    (compiler-backend-gep-load-cmp-address
      ctx.backend-state
      ctx.type-segment-bases
      ctx.assignments
      base
      offset
      elem-ty
      0)
    load-dst
    load-ty
    instrs
    index)
    [(CompilerBackendGepLoadBoundsFold.Some _ _ _ _) true]
    [(CompilerBackendGepLoadBoundsFold.No) false]))

(define (compiler-backend-emit-gep-load-bounds-fold
  [ctx : CompilerBackendEmissionContext]
  [length-operand : String]
  [index-operand : String]
  [ok-label : i64]) : ResultCompilerBackend
  (ResultCompilerBackend.Ok
    (compiler-backend-bounds-check-asm
      ""
      ""
      length-operand
      index-operand
      (compiler-backend-call-arg-space
        ctx.target
        (compiler_ir_types.CompilerIrCallArgs.Nil)
        (compiler_ast_types.ast-type-list-new)
        false
        ctx.program-index)
      (compiler-backend-asm-label ctx.function ok-label)
      ctx.plan
      ctx.program-index)))

;; `cmp`/`test` with one memory operand, at an explicit width. `src` is the
;; AT&T source operand and `dst` the destination one: exactly one of them is
;; the folded memory address, and which one depends on where the loaded value
;; sat in the IR compare (`lhs OP rhs` renders as `cmp rhs, lhs`).
(define (compiler-backend-cmp-mem-operands-asm
  [op : compiler_ir_types.CompilerIrBinOp]
  [suffix : String]
  [src-operand : String]
  [dst-operand : String]) : String
  (str_cat.str-cat
    "    "
    (if (compiler-backend-bit-test-op? op)
      "test"
      "cmp")
    suffix
    " "
    src-operand
    ", "
    dst-operand
    "\n"))

;; M6-C width/signedness table. The narrow fold replaces
;;
;;     mov{z,s}<W>q MEM, %r      ; 64-bit value = ext(MEM)
;;     cmpq $K, %r               ; equality at 64 bits
;;
;; with `cmp<W> $K, MEM` -- a comparison at W BYTES. Equality at the narrow
;; width agrees with equality at 64 bits exactly when the literal survives the
;; load's own extension unchanged, i.e. when K is in the range the extension
;; can produce:
;;
;;     width  load       extension     admitted K
;;     -----  ---------  ------------  --------------------------
;;     1      movzbq     zero          0 .. 255
;;     1      movsbq     sign          -128 .. 127
;;     2      movzwq     zero          0 .. 65535
;;     2      movswq     sign          -32768 .. 32767
;;     4      movl       zero          0 .. 2147483647
;;     4      movslq     sign          -2147483648 .. 2147483647
;;
;; Outside that range `ext(MEM) == K` is a CONSTANT (no W-byte value extends to
;; K), so the fold declines rather than inventing a comparison. The W=4
;; unsigned row stops at imm32's signed maximum on purpose: `cmpl $K, MEM`
;; renders K as a 32-bit immediate, and the values above that would have to be
;; spelled as their negative two's-complement twin.
;;
;; ORDERED narrow comparisons are NOT folded: a zero-extended byte compared
;; with `jl`/`jg` at 64 bits is a comparison of a non-negative value, which the
;; 8-bit signed compare does not reproduce (byte 200 is -56 there), and a
;; sign-extended byte compared unsigned is wrong the other way. Only Eq/Ne
;; reach the narrow arm, and their jcc (je/jne) is width- and sign-agnostic.
(define (compiler-backend-narrow-cmp-literal-ok?
  [width : i64]
  [signed? : bool]
  [k : i64]) : bool
  (cond
    [(= width 1)
      (if signed?
        (and (>= k (- 0 128)) (<= k 127))
        (and (>= k 0) (<= k 255)))]
    [(= width 2)
      (if signed?
        (and (>= k (- 0 32768)) (<= k 32767))
        (and (>= k 0) (<= k 65535)))]
    [(= width 4)
      (if signed?
        (compiler-backend-imm32? k)
        (and (>= k 0) (<= k 2147483647)))]
    [else false]))

;; Equality-shaped compares set ZF symmetrically, so their operands may be
;; exchanged without touching the jcc. That is what lets the narrow arm always
;; put the literal in the source slot, and what lets the wide arm accept an
;; immediate on the side the memory operand does not occupy.
(define (compiler-backend-compare-operands-commute?
  [op : compiler_ir_types.CompilerIrBinOp]) : bool
  (match op
    [(compiler_ir_types.CompilerIrBinOp.Eq) true]
    [(compiler_ir_types.CompilerIrBinOp.Ne) true]
    [(compiler_ir_types.CompilerIrBinOp.BitTestEq) true]
    [(compiler_ir_types.CompilerIrBinOp.BitTestNe) true]
    [_ false]))

;; M6-B/M6-C: compare asm, true jcc, false jcc, true label, false label,
;; resume index.
(defenum CompilerBackendGepLoadCmpBranchFold
  (No)
  (Some String String String i64 i64 i64))

;; --- M6-G: a narrow element load whose only reader is its widening cast ------
;;
;; `(cast (array-ref slots i) : i64)` lowers to `Load : u8` followed by
;; `Cast u8 to i64`, and the x86 load ALREADY performs that extension: `movzbq
;; addr, %r` leaves the whole 64-bit register holding the byte. When the loaded
;; value's single reader is a compare the M6-C arm above folds the pair into a
;; `cmpb` and neither instruction survives. When it has several readers -- a
;; lexer's dispatch byte, tested against a dozen literals -- M6-C declines and
;; the pair is emitted in full: one `movzbq addr, %rax` and one `movzbq %al,
;; %r12` re-extending a register that is already extended.
;;
;; The second instruction is the whole of what this arm removes, by giving the
;; LOAD the cast's own destination register. What makes that sound is the same
;; single-use condition M6 already demands of every fold in this cluster
;; (`compiler-backend-gep-load-cmp-fold-rest` refuses a multiply-read load
;; outright): the loaded var is read by the cast and by nothing else, so its own
;; home is never observed and need not be written. The cast's destination is
;; where the value was going to end up either way.
;;
;; Rails, each mirroring the M6-C arm that reads the load's extension out of
;; `load-ty`:
;;   * the cast's source is exactly the loaded var, so no size-preserving cast
;;     crossed on the way can have flipped the signedness the width table
;;     depends on;
;;   * the cast's source width equals the load's width and their signedness
;;     agrees, so the extension the load performs IS the extension the cast
;;     asks for;
;;   * the cast widens to a full word. A narrower target would need the
;;     upper bits left alone, which a widening load does not do;
;;   * no float on any side -- those move through the SSE path, not `movzbq`;
;;   * the cast's destination has a general-register home that is not `%rbp`.
;;     A spilled destination still needs the store the ordinary path emits, and
;;     writing it here would buy nothing.
;; The address operands are read before the destination is written within one
;; instruction, so a destination that also spells the address's base or index is
;; safe; and the destination register belongs to the cast, whose live range
;; starts here, so nothing live across the pair can be homed in it.
;;
;; The M6-D staged address is taken too, on the same terms the compare arms
;; take it: a base or index the SIB slots cannot spell is materialized into the
;; LOAD destination's own register home first, and the load then reads through
;; it. That register is dead the moment the fold retires the loaded var, so
;; staging into it costs the one `movq` the unfolded path was already paying to
;; scavenge a base -- and the pair still loses its re-extension.
;;
;; destination register spelling, resume index.
(defenum CompilerBackendGepLoadWidenFold
  (No)
  (Some String i64))

(define (compiler-backend-gep-load-widen-cast-probe
  [ctx : CompilerBackendEmissionContext]
  [addr : String]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadWidenFold
  (if (or (string.eq addr "") (>= index instrs.len))
    (CompilerBackendGepLoadWidenFold.No)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Cast cast-dst cast-src from-ty to-ty)
        (let
          [width : i64
            (compiler-backend-type-size ctx.type-segment-bases load-ty)]
          (if (or
            (not (compiler-backend-branch-uses-var? cast-src load-dst))
            (not (or (= width 1) (= width 2) (= width 4)))
            (compiler-backend-float-type? load-ty)
            (compiler-backend-float-type? from-ty)
            (compiler-backend-float-type? to-ty)
            (not
              (=
                (compiler-backend-type-size ctx.type-segment-bases from-ty)
                width))
            (not
              (= (compiler-backend-type-size ctx.type-segment-bases to-ty) 8))
            (not
              (=
                (if (compiler-backend-type-signed? from-ty)
                  1
                  0)
                (if (compiler-backend-type-signed? load-ty)
                  1
                  0))))
            (CompilerBackendGepLoadWidenFold.No)
            (let
              [home : String
                (compiler-backend-var-register-home
                  ctx.backend-state
                  ctx.assignments
                  cast-dst)]
              (if (or (string.eq home "") (string.eq home "%rbp"))
                (CompilerBackendGepLoadWidenFold.No)
                (CompilerBackendGepLoadWidenFold.Some home (+ index 1))))))]
      [_ (CompilerBackendGepLoadWidenFold.No)])))

;; The compare's own source operand: the loaded value has been folded into the
;; memory operand, so the OTHER side must already be an immediate or a register
;; home. "" declines.
(define (compiler-backend-gep-load-cmp-other-operand
  [ctx : CompilerBackendEmissionContext]
  [value : compiler_ir_types.CompilerIrValue]) : String
  (match (compiler-backend-immediate-operand ctx.backend-state value)
    [(CompilerBackendMaybeImmediate.Some imm) imm]
    [(CompilerBackendMaybeImmediate.No)
      (compiler-backend-value-scalar-register
        ctx.backend-state
        ctx.assignments
        value)]))

;; The narrow (M6-C) arm: `Load` of a 1/2/4-byte element, its widening `Cast`,
;; then an equality compare against a literal. Returns "" when the shape or the
;; literal is not admitted.
(define (compiler-backend-gep-load-narrow-cmp-asm
  [ctx : CompilerBackendEmissionContext]
  [addr : String]
  [load-ty : compiler_ast_types.AstType]
  [from-ty : compiler_ast_types.AstType]
  [to-ty : compiler_ast_types.AstType]
  [op : compiler_ir_types.CompilerIrBinOp]
  [other : compiler_ir_types.CompilerIrValue]) : String
  (let
    [width : i64 (compiler-backend-type-size ctx.type-segment-bases load-ty)]
    (if (or
      (not (compiler-backend-compare-operands-commute? op))
      (compiler-backend-bit-test-op? op)
      (compiler-backend-float-type? from-ty)
      (compiler-backend-float-type? to-ty)
      ;; The register value the compare would have read is the LOAD's own
      ;; extension, so the cast must be exactly that extension: same source
      ;; width, same source signedness, widened to a full word.
      (not
        (= (compiler-backend-type-size ctx.type-segment-bases from-ty) width))
      (not (= (compiler-backend-type-size ctx.type-segment-bases to-ty) 8))
      (not
        (=
          (if (compiler-backend-type-signed? from-ty)
            1
            0)
          (if (compiler-backend-type-signed? load-ty)
            1
            0))))
      ""
      (match (compiler-backend-value-as-i64 other)
        [(option_i64.Some k)
          (if (compiler-backend-narrow-cmp-literal-ok?
            width
            (compiler-backend-type-signed? load-ty)
            k)
            (compiler-backend-cmp-mem-operands-asm
              op
              (compiler-backend-int-instruction-suffix
                ctx.type-segment-bases
                load-ty)
              (str_cat.str-cat "$" (string.int->string k))
              addr)
            "")]
        [(option_i64.None) ""]))))

;; The wide (M6-B) arm: a full-word load feeding a compare from EITHER side.
;; `mem-is-lhs?` says the loaded value was the IR compare's left operand, which
;; is the AT&T DESTINATION slot; the mirrored case puts the address in the
;; source slot instead, and only an equality compare may swap them.
(define (compiler-backend-gep-load-wide-cmp-asm
  [ctx : CompilerBackendEmissionContext]
  [addr : String]
  [op : compiler_ir_types.CompilerIrBinOp]
  [mem-is-lhs? : bool]
  [other : compiler_ir_types.CompilerIrValue]) : String
  ;; When the address occupies the SOURCE slot the other operand has to be a
  ;; legal destination: a register. An immediate destination is only reachable
  ;; by exchanging the operands, which only equality-shaped compares permit.
  (let
    [other-operand : String
      (compiler-backend-gep-load-cmp-other-operand ctx other)]
    (cond
      [(string.eq other-operand "") ""]
      [mem-is-lhs?
        (compiler-backend-cmp-mem-operands-asm op "q" other-operand addr)]
      [(compiler-backend-string-prefix-at? other-operand "%" 0)
        (compiler-backend-cmp-mem-operands-asm op "q" addr other-operand)]
      [(compiler-backend-compare-operands-commute? op)
        (compiler-backend-cmp-mem-operands-asm op "q" other-operand addr)]
      [else ""])))

;; Walk `Load ; [Cast] ; BinOp compare ; Branch` and produce the folded
;; compare. Every destination in the chain is required to be single-use, which
;; is what makes dropping the load (and the cast the load already performed)
;; unobservable; the instructions are consumed as a contiguous run, so nothing
;; can write memory, the address registers or the flags in between.
(define (compiler-backend-gep-load-cmp-branch-probe
  [ctx : CompilerBackendEmissionContext]
  [addr : String]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendGepLoadCmpBranchFold
  (match (compiler-backend-cmp-fold-walk
    ctx
    instrs
    index
    load-dst
    compiler-backend-cmp-fold-walk-fuel)
    [(CompilerBackendCmpFoldWalk.No) (CompilerBackendGepLoadCmpBranchFold.No)]
    [(CompilerBackendCmpFoldWalk.Some value-var stop)
      (compiler-backend-gep-load-cmp-branch-probe-at
        ctx
        addr
        load-dst
        load-ty
        value-var
        instrs
        index
        stop)]))

(define (compiler-backend-gep-load-cmp-branch-probe-at
  [ctx : CompilerBackendEmissionContext]
  [addr : String]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [value-var : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  ;; The instruction right behind the fused load, i.e. where the walk started.
  ;; M6-E threads phi-edge copies only when the compare sits exactly there, so
  ;; that the branch lands on the scratch-plan offset the copies read.
  [origin : i64]
  [index : i64]) : CompilerBackendGepLoadCmpBranchFold
  (let
    [maybe-cast : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
    [narrow? : bool
      (match maybe-cast
        [(compiler_ir_types.CompilerIrInstr.Cast cast-dst cast-src _ _)
          (and
            ;; The narrow arm reads the LOAD's own extension out of load-ty, so
            ;; the widening cast has to sit directly on the loaded value: a
            ;; size-preserving cast crossed on the way could have flipped the
            ;; signedness the width table depends on.
            (= value-var load-dst)
            (compiler-backend-branch-uses-var? cast-src load-dst)
            (compiler-backend-var-single-use? ctx.use-counts cast-dst))]
        [_ false])]
    [cmp-index : i64
      (if narrow?
        (+ index 1)
        index)]
    [cmp-var : i64
      (match maybe-cast
        [(compiler_ir_types.CompilerIrInstr.Cast cast-dst _ _ _)
          (if narrow?
            cast-dst
            value-var)]
        [_ value-var])]
    ;; The wide arm needs a full-word load; the narrow arm needs the cast (and
    ;; checks its own admitted widths below).
    (if (or
      (and
        (not narrow?)
        (not (= (compiler-backend-type-size ctx.type-segment-bases load-ty) 8)))
      (>= (+ cmp-index 1) instrs.len))
      (CompilerBackendGepLoadCmpBranchFold.No)
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs cmp-index)
        [(compiler_ir_types.CompilerIrInstr.BinOp cmp-dst op lhs rhs cmp-ty)
          (let
            [mem-is-lhs? : bool
              (and
                (compiler-backend-branch-uses-var? lhs cmp-var)
                (not (compiler-backend-branch-uses-var? rhs cmp-var)))]
            [mem-is-rhs? : bool
              (and
                (compiler-backend-branch-uses-var? rhs cmp-var)
                (not (compiler-backend-branch-uses-var? lhs cmp-var)))]
            [other : compiler_ir_types.CompilerIrValue
              (if mem-is-lhs?
                rhs
                lhs)]
            (if (and
              (compiler-backend-compare-op? op)
              (compiler-backend-var-single-use? ctx.use-counts cmp-dst)
              (or mem-is-lhs? mem-is-rhs?)
              ;; The wide arm renders `cmpq`, so the comparison itself must be
              ;; at full word width; the narrow arm carries its own width table.
              (or
                narrow?
                (= (compiler-backend-type-size ctx.type-segment-bases cmp-ty) 8))
              (not
                (compiler-backend-binop-f64?
                  ctx.types
                  ctx.global-types
                  lhs
                  rhs
                  cmp-ty)))
              (match (compiler_ir_types.compiler-ir-instr-scalar-fact
                (compiler_ir_types.compiler-ir-instr-seq-ref
                  instrs
                  (+ cmp-index 1)))
                [(compiler_ir_types.CompilerIrInstrScalarFact.Branch
                    cond
                    true-label
                    false-label)
                  (let
                    [cmp-asm : String
                      (if narrow?
                        (match maybe-cast
                          [(compiler_ir_types.CompilerIrInstr.Cast
                              _
                              _
                              from-ty
                              to-ty)
                            (compiler-backend-gep-load-narrow-cmp-asm
                              ctx
                              addr
                              load-ty
                              from-ty
                              to-ty
                              op
                              other)]
                          [_ ""])
                        (compiler-backend-gep-load-wide-cmp-asm
                          ctx
                          addr
                          op
                          mem-is-lhs?
                          other))]
                    [jcc-ty : compiler_ast_types.AstType
                      (if narrow?
                        load-ty
                        cmp-ty)]
                    [true-jcc : String
                      (compiler-backend-compare-true-jcc op jcc-ty)]
                    [false-jcc : String
                      (compiler-backend-compare-false-jcc op jcc-ty)]
                    (if (and
                      (not (string.eq cmp-asm ""))
                      (not (string.eq true-jcc ""))
                      (compiler-backend-branch-uses-var? cond cmp-dst)
                      ;; M6-E: phi-edge copies are threaded onto the successor
                      ;; edges by compiler-backend-gep-load-cmp-branch-emit,
                      ;; which reads the BRANCH's own cycle/stage scratch out of
                      ;; the allocator plan at offset 3 (gep, load, compare,
                      ;; branch). A fold that swallowed extra instructions -- a
                      ;; widening cast, or one the walk stepped over -- puts the
                      ;; branch at a different offset, so it keeps declining
                      ;; rather than reading a slot planned for some other
                      ;; instruction.
                      (or
                        (not
                          (compiler-backend-branch-needs-phi-copies?
                            (compiler-backend-state-function-state
                              ctx.backend-state)
                            true-label
                            false-label))
                        (= cmp-index origin)))
                      (CompilerBackendGepLoadCmpBranchFold.Some
                        cmp-asm
                        true-jcc
                        false-jcc
                        true-label
                        false-label
                        (+ cmp-index 2))
                      (CompilerBackendGepLoadCmpBranchFold.No)))]
                [_ (CompilerBackendGepLoadCmpBranchFold.No)])
              (CompilerBackendGepLoadCmpBranchFold.No)))]
        [_ (CompilerBackendGepLoadCmpBranchFold.No)]))))

(defenum CompilerBackendMaybeGepLoadCmpEmission
  (No)
  (Some ResultCompilerBackend))

;; M6-E: the folded compare sets the flags its branch consumes, so successor
;; phi-edge copies cannot sit between them -- they have to run ON the edge,
;; behind the jcc. That is exactly the shape
;; compiler-backend-emit-gep-load-compare-branch-with-phi-copies-with-plan
;; already builds for the unfolded compare: each edge's copies become their own
;; block, the branch jumps to the edge labels instead of the real successors,
;; and the edge blocks are appended behind the branch. Reusing it costs nothing
;; -- those edge blocks are the very ones the unfolded path emitted -- and lets
;; the fold keep shapes it used to hand back whole.
(define (compiler-backend-gep-load-cmp-branch-emit
  [ctx : CompilerBackendEmissionContext]
  [cmp-asm : String]
  [true-jcc : String]
  [false-jcc : String]
  [true-label : i64]
  [false-label : i64]
  [branch-fallthrough : CompilerBackendMaybeLabel]) : ResultCompilerBackend
  (if (not
    (compiler-backend-branch-needs-phi-copies?
      (compiler-backend-state-function-state ctx.backend-state)
      true-label
      false-label))
    (ResultCompilerBackend.Ok
      (str_cat.str-cat
        cmp-asm
        (compiler-backend-emit-compare-branch-jumps
          ctx.function
          true-label
          false-label
          branch-fallthrough
          true-jcc
          false-jcc
          ctx.backend-state)))
    (let
      [planned-cycle : String
        (compiler-backend-scratch-plan-register-ahead
          (compiler-backend-runtime-plan-scratch ctx.plan)
          3
          1
          ctx.backend-state)]
      [planned-stage : String
        (compiler-backend-scratch-plan-register-ahead
          (compiler-backend-runtime-plan-scratch ctx.plan)
          3
          2
          ctx.backend-state)]
      (match (compiler-backend-emit-phi-edge-copies
        ctx.type-segment-bases
        ctx.assignments
        ctx.blocks
        true-label
        ctx.current-label
        ctx.program-index
        ctx.vars
        planned-cycle
        planned-stage
        (compiler-backend-current-phi-planned-xmm-cycle ctx.backend-state))
        [(ResultCompilerBackend.Ok true-copies)
          (match (compiler-backend-emit-phi-edge-copies
            ctx.type-segment-bases
            ctx.assignments
            ctx.blocks
            false-label
            ctx.current-label
            ctx.program-index
            ctx.vars
            planned-cycle
            planned-stage
            (compiler-backend-current-phi-planned-xmm-cycle ctx.backend-state))
            [(ResultCompilerBackend.Ok false-copies)
              (ResultCompilerBackend.Ok
                (compiler-backend-emit-branch-edges
                  ctx.backend-state
                  ctx.function
                  ctx.current-label
                  true-label
                  false-label
                  true-copies
                  false-copies
                  branch-fallthrough
                  (str_cat.str-cat
                    cmp-asm
                    (compiler-backend-emit-compare-branch-jumps
                      ctx.function
                      (compiler-backend-branch-edge-target
                        (compiler-backend-branch-edge-label
                          ctx.current-label
                          "true")
                        true-label
                        true-copies)
                      (compiler-backend-branch-edge-target
                        (compiler-backend-branch-edge-label
                          ctx.current-label
                          "false")
                        false-label
                        false-copies)
                      (compiler-backend-branch-edge-fallthrough
                        ctx.current-label
                        true-copies
                        false-copies
                        branch-fallthrough)
                      true-jcc
                      false-jcc
                      ctx.backend-state))))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)])]
        [(ResultCompilerBackend.Err message)
          (ResultCompilerBackend.Err message)]))))

;; M6-D emission: put the base in its planned staging register FIRST, then build
;; the folded compare and its branch on top -- the same order the unfolded path
;; used, so the phi-edge copies M6-E may emit still see the identical machine
;; state. `staged-base` is "" whenever the fold spelled a direct address, and
;; then this is just the branch emission. Nothing here runs until the fold has
;; COMMITTED, so the M-D rule holds: no probe that can still decline reaches an
;; emitter.
(define (compiler-backend-gep-load-cmp-emit
  [ctx : CompilerBackendEmissionContext]
  [staged-value : compiler_ir_types.CompilerIrValue]
  [staged-base : String]
  [cmp-asm : String]
  [true-jcc : String]
  [false-jcc : String]
  [true-label : i64]
  [false-label : i64]
  [branch-fallthrough : CompilerBackendMaybeLabel]) : ResultCompilerBackend
  (if (string.eq staged-base "")
    (compiler-backend-gep-load-cmp-branch-emit
      ctx
      cmp-asm
      true-jcc
      false-jcc
      true-label
      false-label
      branch-fallthrough)
    (match (compiler-backend-emit-load-value-with-plan
      ctx.assignments
      staged-value
      staged-base
      ctx.backend-state)
      [(ResultCompilerBackend.Ok stage-asm)
        (match (compiler-backend-gep-load-cmp-branch-emit
          ctx
          cmp-asm
          true-jcc
          false-jcc
          true-label
          false-label
          branch-fallthrough)
          [(ResultCompilerBackend.Ok body-asm)
            (ResultCompilerBackend.Ok (str_cat.str-cat stage-asm body-asm))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

;; M6-G emission, in M6-D's order: stage the operand the address needs into the
;; load destination's home first, then the widening load into the cast's own
;; register. `staged-base` is "" whenever the fold spelled a direct address.
(define (compiler-backend-gep-load-widen-emit
  [ctx : CompilerBackendEmissionContext]
  [staged-value : compiler_ir_types.CompilerIrValue]
  [staged-base : String]
  [addr : String]
  [load-ty : compiler_ast_types.AstType]
  [dst-reg : String]) : ResultCompilerBackend
  (let
    [load-asm : String
      (compiler-backend-emit-load-memory-to-reg
        ctx.type-segment-bases
        addr
        load-ty
        dst-reg)]
    (if (string.eq staged-base "")
      (ResultCompilerBackend.Ok load-asm)
      (match (compiler-backend-emit-load-value-with-plan
        ctx.assignments
        staged-value
        staged-base
        ctx.backend-state)
        [(ResultCompilerBackend.Ok stage-asm)
          (ResultCompilerBackend.Ok (str_cat.str-cat stage-asm load-asm))]
        [(ResultCompilerBackend.Err message)
          (ResultCompilerBackend.Err message)]))))

(define (compiler-backend-gep-load-cmp-fold-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [addr : String]
  ;; M6-D: the operand that has to be staged (base or index), the staging
  ;; register, and the address built on it. The last two are "" when the direct
  ;; address already spelled the operand.
  [staged-value : compiler_ir_types.CompilerIrValue]
  [staged-base : String]
  ;; M6-H: true when `staged-base` came from the scavenger's PEEK rather than
  ;; the load destination's home, so the committed emitter has to re-run the
  ;; pick for real (that is what enqueues the emergency save when the pool is
  ;; saturated). See compiler-backend-gep-load-cmp-scavenged-staging-base.
  [staged-scavenged? : bool]
  [staged-addr : String]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepLoadCmpEmission
  (if (or
    (and (string.eq addr "") (string.eq staged-addr ""))
    (compiler-backend-float-type? load-ty)
    (not (compiler-backend-var-single-use? ctx.use-counts load-dst))
    (>= index instrs.len))
    (CompilerBackendMaybeGepLoadCmpEmission.No)
    (match (compiler-backend-gep-load-bounds-probe
      ctx
      addr
      load-dst
      load-ty
      instrs
      index)
      [(CompilerBackendGepLoadBoundsFold.Some
          length-operand
          index-operand
          ok-label
          after-bounds)
        (CompilerBackendMaybeGepLoadCmpEmission.Some
          (compiler-backend-emit-fused-result-rest
            ctx
            fallthrough
            (compiler-backend-emit-gep-load-bounds-fold
              ctx
              length-operand
              index-operand
              ok-label)
            instrs
            after-bounds
            out))]
      [(CompilerBackendGepLoadBoundsFold.No)
        ;; The bounds fold above stays on the DIRECT address: its abort tail
        ;; re-reads both operands and owns its own operand discipline, so M6-D
        ;; leaves it exactly as validated. Only the compare+branch shapes take
        ;; the staged address.
        (match (compiler-backend-gep-load-cmp-branch-probe
          ctx
          (if (string.eq addr "")
            staged-addr
            addr)
          load-dst
          load-ty
          instrs
          index)
          [(CompilerBackendGepLoadCmpBranchFold.Some
              cmp-asm
              true-jcc
              false-jcc
              true-label
              false-label
              after-branch)
            (CompilerBackendMaybeGepLoadCmpEmission.Some
              (compiler-backend-emit-fused-result-rest
                ctx
                fallthrough
                (compiler-backend-gep-load-cmp-emit
                  ctx
                  staged-value
                  (if (string.eq addr "")
                    (if staged-scavenged?
                      (compiler-backend-gep-load-cmp-scavenged-staging-base
                        ctx
                        instrs
                        index
                        true)
                      staged-base)
                    "")
                  cmp-asm
                  true-jcc
                  false-jcc
                  true-label
                  false-label
                  (compiler-backend-fused-compare-fallthrough
                    instrs
                    after-branch
                    fallthrough))
                instrs
                after-branch
                out))]
          [(CompilerBackendGepLoadCmpBranchFold.No)
            ;; M6-G last: the compare shapes above retire BOTH instructions of
            ;; the pair, this one retires the re-extension only, so it is only
            ;; ever offered a load neither of them claimed.
            (match (compiler-backend-gep-load-widen-cast-probe
              ctx
              (if (string.eq addr "")
                staged-addr
                addr)
              load-dst
              load-ty
              instrs
              index)
              [(CompilerBackendGepLoadWidenFold.Some dst-reg after-cast)
                (CompilerBackendMaybeGepLoadCmpEmission.Some
                  (compiler-backend-emit-fused-result-rest
                    ctx
                    fallthrough
                    (compiler-backend-gep-load-widen-emit
                      ctx
                      staged-value
                      (if (string.eq addr "")
                        (if staged-scavenged?
                          (compiler-backend-gep-load-cmp-scavenged-staging-base
                            ctx
                            instrs
                            index
                            true)
                          staged-base)
                        "")
                      (if (string.eq addr "")
                        staged-addr
                        addr)
                      load-ty
                      dst-reg)
                    instrs
                    after-cast
                    out))]
              [(CompilerBackendGepLoadWidenFold.No)
                (CompilerBackendMaybeGepLoadCmpEmission.No)])])])))

(define (compiler-backend-emit-fused-gep-load-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  ;; M6 first: its probes are pure, and the shapes they claim (bounds-check
  ;; length, compare+branch, narrow compare) are disjoint from the GAP8 ALU
  ;; shapes below, so the order only decides which rule sees the instruction.
  (let
    [direct-addr : String
      (compiler-backend-gep-load-cmp-address
        ctx.backend-state
        ctx.type-segment-bases
        ctx.assignments
        base
        offset
        elem-ty
        gep-fold-disp)]
    [home-staged-base : String
      (compiler-backend-gep-load-cmp-staged-base ctx load-dst)]
    ;; M6-H: only a spilled load destination reaches the scavenged staging
    ;; register, and only where the direct address already declined -- otherwise
    ;; the "fold" would add a staging `movq` nobody was paying. The single-use
    ;; gate the whole M6 family runs on is re-stated here because it is what
    ;; retires the loaded var, and the fold is pointless without it.
    [staged-scavenged? : bool
      (and
        (string.eq home-staged-base "")
        (string.eq direct-addr "")
        (not (compiler-backend-float-type? load-ty))
        (compiler-backend-var-single-use? ctx.use-counts load-dst)
        (compiler-backend-gep-load-cmp-staging-shape? load-dst instrs index))]
    [staged-base : String
      (if staged-scavenged?
        (compiler-backend-gep-load-cmp-scavenged-staging-base
          ctx
          instrs
          index
          false)
        home-staged-base)]
    [staged-addr : String
      (compiler-backend-gep-load-cmp-staged-address
        ctx.backend-state
        ctx.type-segment-bases
        ctx.assignments
        base
        offset
        elem-ty
        gep-fold-disp
        direct-addr
        staged-base)]
    (match (compiler-backend-gep-load-cmp-fold-rest
      ctx
      fallthrough
      direct-addr
      (compiler-backend-gep-load-cmp-staged-value
        ctx.backend-state
        ctx.assignments
        base
        offset)
      staged-base
      staged-scavenged?
      staged-addr
      load-dst
      load-ty
      instrs
      index
      out)
      [(CompilerBackendMaybeGepLoadCmpEmission.Some result) result]
      [(CompilerBackendMaybeGepLoadCmpEmission.No)
        (compiler-backend-emit-fused-gep-load-rest-tail
          ctx
          fallthrough
          _gep-dst
          gep-fold-disp
          base
          offset
          elem-ty
          load-dst
          load-ty
          instrs
          index
          out)])))

;; ============================================================================
;; GAP10: memory-destination read-modify-write folding.
;;
;; x86 ALU ops take a MEMORY destination -- `orq %rsi, (%rax,%rcx,8)` reads,
;; combines and writes back in ONE instruction. This backend had never emitted
;; that form, so `dst[i] = dst[i] op x` always lowered to the three-instruction
;; register round trip
;;
;;   movq (%rax,%rcx,8), %r9 / orq (%rdi,%rcx,8), %r9 / movq %r9, (%rax,%rcx,8)
;;
;; where clang emits two (`movq (%rdi,%rcx,8), %rsi; orq %rsi, (%rax,%rcx,8)`),
;; or ONE when the other operand is already a register or an immediate. That is
;; the whole of liveness_scan's live-out union bucket L2(a): 3 instructions per
;; word against clang's 2.
;;
;; ADMISSION. The window starts at the gep+load pair this emitter already owns
;; (g0/`a`) and must continue with EXACTLY one of
;;
;;   direct: BinOp c = a op x ; Gep g2 ; StorePtr g2, c              (5 instrs)
;;   memory: Gep g1 ; Load b = g1 ; BinOp c = a op b ;
;;           Gep g2 ; StorePtr g2, c                                 (7 instrs)
;;
;; with `a` and `c` each read exactly once, every absorbed gep single-use, and
;; g2's base/offset/element operands syntactically IDENTICAL to g0's. Matching
;; the window structurally discharges three obligations at once:
;;
;;   * INTERVENING STORES. Nothing but the listed instructions may sit between
;;     the load and the store, and none of them writes memory, so no store to
;;     the folded address can be skipped over.
;;   * TRAPS. A BoundsCheck (or any other instruction) INSIDE the window fails
;;     the match, so nothing that can leave the block is ever moved across the
;;     folded access. Checks that PRECEDE the load are untouched and still
;;     precede it, so the fold fires on checked and check-free bodies alike and
;;     neither gains nor loses a trap: the abort still runs before any memory
;;     operation, exactly where it ran before. (Contrast the unroll class below,
;;     whose admission really does require a check-free clone -- there the cost
;;     is duplicated CHECKS, which this fold never duplicates.)
;;   * FLAGS. The memory-destination form sets EFLAGS exactly as the register
;;     form did, on the same result, and the store it replaces wrote none. The
;;     ALU moves at most two instruction slots later and nothing in between
;;     reads or writes flags, so any consumer past the store sees what it saw.
;;
;; ALIASING is syntactic, never a semantic equality proof: the store address is
;; admitted only when it is spelled from the SAME base and index VALUES as the
;; load address, at the same GAP9 displacement. Reordering is safe for the same
;; reason -- the only memory read that moves ahead of the folded read is a LOAD,
;; which cannot change the folded location, and when the two addresses happen to
;; be the same location both orders compute `a op a`.
;;
;; ORDINALS. g0's ordinal was consumed by the dispatch site. This fold consumes
;; g1's and g2's itself, in walk order, and decides admission from
;; `compiler-backend-gep-fold-peek` (PURE) so a decline leaves every remaining
;; ordinal for the ordinary emission to consume exactly once. (Rebase note: main
;; carries the store-pair double-consume fix for this same obligation; this
;; branch predates it, and the peek-then-consume discipline here is written to
;; be independent of that fix rather than to depend on it.)
;;
;; NARROWER THAN THE SHAPE ALLOWS, deliberately: 64-bit integer operands only
;; (no narrow widths, where the load's extension and the store's truncation stop
;; agreeing), dynamic SIB addressing only, and `imul` excluded (x86 has no
;; memory-destination two-operand form for it).
(define (compiler-backend-gep-rmw-mnemonic
  [op : compiler_ir_types.CompilerIrBinOp]) : String
  (match op
    [(compiler_ir_types.CompilerIrBinOp.Add) "add"]
    [(compiler_ir_types.CompilerIrBinOp.Sub) "sub"]
    [(compiler_ir_types.CompilerIrBinOp.BitAnd) "and"]
    [(compiler_ir_types.CompilerIrBinOp.BitOr) "or"]
    [(compiler_ir_types.CompilerIrBinOp.BitXor) "xor"]
    [_ ""]))

;; `sub` is the only admitted mnemonic that is not commutative, and the memory
;; destination is always the folded LEFT operand, so `x - dst[i]` has no
;; memory-destination spelling at all.
(define (compiler-backend-gep-rmw-commutative?
  [op : compiler_ir_types.CompilerIrBinOp]) : bool
  (match op
    [(compiler_ir_types.CompilerIrBinOp.Sub) false]
    [_ true]))

;; The operand that is NOT the folded load, or No when the load is not an
;; operand at all (or sits on the right of a non-commutative op).
(defenum CompilerBackendGepRmwOther
  (No)
  (Some compiler_ir_types.CompilerIrValue))

(define (compiler-backend-gep-rmw-other-operand
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [load-dst : i64]) : CompilerBackendGepRmwOther
  (if (compiler-backend-branch-uses-var? lhs load-dst)
    (CompilerBackendGepRmwOther.Some rhs)
    (if (and
      (compiler-backend-branch-uses-var? rhs load-dst)
      (compiler-backend-gep-rmw-commutative? op))
      (CompilerBackendGepRmwOther.Some lhs)
      (CompilerBackendGepRmwOther.No))))

;; Source spelling for the one-instruction (direct) form: a register home or an
;; imm32. A spilled operand has neither -- x86 cannot take two memory operands
;; -- so it declines and keeps the register round trip.
(define (compiler-backend-gep-rmw-direct-source
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [value : compiler_ir_types.CompilerIrValue]) : String
  (let
    [home : String
      (compiler-backend-value-scalar-register backend-state assignments value)]
    (if (not (string.eq home ""))
      home
      (match (compiler-backend-value-as-i64 value)
        [(option_i64.Some n)
          (if (compiler-backend-imm32? n)
            (str_cat.str-cat "$" (string.int->string n))
            "")]
        [(option_i64.None) ""]))))

;; The folded destination operand, or "" when any component declines: the base
;; must be register-homed and admissible as an address base (#rbp-base: the gep
;; index already occupies the SIB index slot), and the index must be a
;; register-homed dynamic offset.
(define (compiler-backend-gep-rmw-address
  [backend-state : CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [disp : i64]) : String
  (let
    [base-home : String
      (compiler-backend-address-base-filter
        (compiler-backend-value-scalar-register backend-state assignments base))]
    [index-home : String
      (compiler-backend-value-scalar-register backend-state assignments offset)]
    (if (or (string.eq base-home "") (string.eq index-home ""))
      ""
      (compiler-backend-gep-index-address-disp
        disp
        base-home
        (compiler-backend-type-size type-segment-bases elem-ty)
        index-home))))

;; Does `reg` spell either component of the address built from base/offset?
;; The staging register is written before both addresses are read, so a hit
;; declines the fold.
(define (compiler-backend-gep-rmw-address-uses-register?
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [reg : String]) : bool
  (or
    (string.eq
      (compiler-backend-value-scalar-register backend-state assignments base)
      reg)
    (string.eq
      (compiler-backend-value-scalar-register backend-state assignments offset)
      reg)))

;; Every 64-bit integer condition the fold needs of one value/type pair.
(define (compiler-backend-gep-rmw-word-type?
  [type-segment-bases : i64]
  [ty : compiler_ast_types.AstType]) : bool
  (and
    (= (compiler-backend-type-size type-segment-bases ty) 8)
    (not (compiler-backend-float-type? ty))))

;; The `Gep g2 ; StorePtr g2, c` tail: g2 must address the same word as g0 and
;; the store must be the ALU result's only reader. Returns the index just past
;; the store, or -1.
(define (compiler-backend-gep-rmw-store-tail
  [ctx : CompilerBackendEmissionContext]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [alu-dst : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : i64
  (if (>= (+ index 1) instrs.len)
    (- 0 1)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.Gep gep-dst2 base2 offset2 elem-ty2)
        (if (and
          (compiler-backend-var-single-use? ctx.use-counts gep-dst2)
          (compiler_optimize.opt-value-eq base2 base)
          (compiler_optimize.opt-value-eq offset2 offset)
          (=
            (compiler-backend-type-size ctx.type-segment-bases elem-ty2)
            (compiler-backend-type-size ctx.type-segment-bases elem-ty)))
          (match (compiler_ir_types.compiler-ir-instr-seq-ref
            instrs
            (+ index 1))
            [(compiler_ir_types.CompilerIrInstr.StorePtr dst2 value2 store-ty)
              (if (and
                (compiler-backend-branch-uses-var? dst2 gep-dst2)
                (compiler-backend-branch-uses-var? value2 alu-dst)
                (compiler-backend-gep-rmw-word-type?
                  ctx.type-segment-bases
                  store-ty))
                (+ index 2)
                (- 0 1))]
            [_ (- 0 1)])
          (- 0 1))]
      [_ (- 0 1)])))

(defenum CompilerBackendMaybeGepRmwEmission
  (No)
  (Some ResultCompilerBackend))

;; The one-instruction form: the other operand is already a register or an
;; immediate, so the whole `load; op; store` triple becomes `op src, (mem)`.
;; No staging register is written, so there is nothing to exclude -- the
;; destination's base and index are only READ by the folded instruction, and
;; reading them from a register that also spells the source is harmless.
;;
;; PROBE COST. Every fused gep+load in the program reaches this rule, and only a
;; handful are read-modify-writes, so the tests are ordered cheapest-and-most-
;; selective first and NOTHING that allocates runs until the shape has already
;; matched. Building the destination operand up front instead cost +0.14% on an
;; opt1 self-compile all by itself: `str-cat` over five pieces, per gep+load,
;; almost always thrown away.
(define (compiler-backend-emit-gep-rmw-direct-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [alu-dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [alu-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepRmwEmission
  (let
    [mnem : String (compiler-backend-gep-rmw-mnemonic op)]
    (if (or
      (string.eq mnem "")
      (not (compiler-backend-var-single-use? ctx.use-counts load-dst))
      (not (compiler-backend-var-single-use? ctx.use-counts alu-dst))
      (not (compiler-backend-gep-rmw-word-type? ctx.type-segment-bases alu-ty)))
      (CompilerBackendMaybeGepRmwEmission.No)
      (let
        [after-store : i64
          (compiler-backend-gep-rmw-store-tail
            ctx
            base
            offset
            elem-ty
            alu-dst
            instrs
            index)]
        (if (or
          (< after-store 0)
          (compiler-backend-binop-f64?
            ctx.types
            ctx.global-types
            lhs
            rhs
            alu-ty)
          ;; g2's displacement decides whether the store really addresses the
          ;; word the load read. Peeked, not consumed: a mismatch must decline
          ;; without touching the cursor.
          (not
            (=
              (compiler-backend-gep-fold-peek
                ctx.function-state
                ctx.type-segment-bases
                0
                offset
                elem-ty)
              gep-fold-disp)))
          (CompilerBackendMaybeGepRmwEmission.No)
          (let
            [src : String
              (match (compiler-backend-gep-rmw-other-operand
                op
                lhs
                rhs
                load-dst)
                [(CompilerBackendGepRmwOther.Some other)
                  (compiler-backend-gep-rmw-direct-source
                    ctx.backend-state
                    ctx.assignments
                    other)]
                [(CompilerBackendGepRmwOther.No) ""])]
            (if (string.eq src "")
              (CompilerBackendMaybeGepRmwEmission.No)
              (let
                [addr : String
                  (compiler-backend-gep-rmw-address
                    ctx.backend-state
                    ctx.type-segment-bases
                    ctx.assignments
                    base
                    offset
                    elem-ty
                    gep-fold-disp)]
                (if (string.eq addr "")
                  (CompilerBackendMaybeGepRmwEmission.No)
                  (let
                    [_g2 : i64
                      (compiler-backend-gep-fold-next!
                        ctx.function-state
                        ctx.type-segment-bases
                        offset
                        elem-ty)]
                    (CompilerBackendMaybeGepRmwEmission.Some
                      (compiler-backend-emit-fused-result-rest
                        ctx
                        fallthrough
                        (ResultCompilerBackend.Ok
                          (str_cat.str-cat "    " mnem "q " src ", " addr "\n"))
                        instrs
                        after-store
                        out))))))))))))

;; The two-instruction form: the other operand is a second fused gep+load, so
;; the source word is staged into the ALU result's own home and consumed as the
;; register operand of the memory-destination op. The staging register is
;; WRITTEN before the destination address is read, so it must not spell any
;; component of either address.
(define (compiler-backend-emit-gep-rmw-memory-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [base1 : compiler_ir_types.CompilerIrValue]
  [offset1 : compiler_ir_types.CompilerIrValue]
  [elem-ty1 : compiler_ast_types.AstType]
  [load-dst1 : i64]
  [load-ty1 : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepRmwEmission
  (if (>= index instrs.len)
    (CompilerBackendMaybeGepRmwEmission.No)
    (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      [(compiler_ir_types.CompilerIrInstr.BinOp alu-dst op lhs rhs alu-ty)
        ;; Same cost discipline as the direct form: cheap structural tests
        ;; first, no allocation until the whole window has matched.
        (let
          [mnem : String (compiler-backend-gep-rmw-mnemonic op)]
          [other-is-load1 : bool
            (match (compiler-backend-gep-rmw-other-operand op lhs rhs load-dst)
              [(CompilerBackendGepRmwOther.Some other)
                (compiler-backend-branch-uses-var? other load-dst1)]
              [(CompilerBackendGepRmwOther.No) false])]
          (if (or
            (string.eq mnem "")
            (not other-is-load1)
            (not (compiler-backend-var-single-use? ctx.use-counts load-dst))
            (not (compiler-backend-var-single-use? ctx.use-counts load-dst1))
            (not (compiler-backend-var-single-use? ctx.use-counts alu-dst))
            (not
              (compiler-backend-gep-rmw-word-type?
                ctx.type-segment-bases
                load-ty1))
            (not
              (compiler-backend-gep-rmw-word-type?
                ctx.type-segment-bases
                alu-ty)))
            (CompilerBackendMaybeGepRmwEmission.No)
            (let
              [after-store : i64
                (compiler-backend-gep-rmw-store-tail
                  ctx
                  base
                  offset
                  elem-ty
                  alu-dst
                  instrs
                  (+ index 1))]
              [stage : String
                (compiler-backend-var-register-home
                  ctx.backend-state
                  ctx.assignments
                  alu-dst)]
              (if (or
                (< after-store 0)
                (string.eq stage "")
                (compiler-backend-binop-f64?
                  ctx.types
                  ctx.global-types
                  lhs
                  rhs
                  alu-ty)
                (compiler-backend-gep-rmw-address-uses-register?
                  ctx.backend-state
                  ctx.assignments
                  base
                  offset
                  stage)
                (compiler-backend-gep-rmw-address-uses-register?
                  ctx.backend-state
                  ctx.assignments
                  base1
                  offset1
                  stage)
                (not
                  (=
                    (compiler-backend-gep-fold-peek
                      ctx.function-state
                      ctx.type-segment-bases
                      1
                      offset
                      elem-ty)
                    gep-fold-disp)))
                (CompilerBackendMaybeGepRmwEmission.No)
                (let
                  [addr : String
                    (compiler-backend-gep-rmw-address
                      ctx.backend-state
                      ctx.type-segment-bases
                      ctx.assignments
                      base
                      offset
                      elem-ty
                      gep-fold-disp)]
                  [addr1 : String
                    (compiler-backend-gep-rmw-address
                      ctx.backend-state
                      ctx.type-segment-bases
                      ctx.assignments
                      base1
                      offset1
                      elem-ty1
                      (compiler-backend-gep-fold-peek
                        ctx.function-state
                        ctx.type-segment-bases
                        0
                        offset1
                        elem-ty1))]
                  (if (or (string.eq addr "") (string.eq addr1 ""))
                    (CompilerBackendMaybeGepRmwEmission.No)
                    (let
                      [_g1 : i64
                        (compiler-backend-gep-fold-next!
                          ctx.function-state
                          ctx.type-segment-bases
                          offset1
                          elem-ty1)]
                      [_g2 : i64
                        (compiler-backend-gep-fold-next!
                          ctx.function-state
                          ctx.type-segment-bases
                          offset
                          elem-ty)]
                      (CompilerBackendMaybeGepRmwEmission.Some
                        (compiler-backend-emit-fused-result-rest
                          ctx
                          fallthrough
                          (ResultCompilerBackend.Ok
                            (str_cat.str-cat
                              "    movq "
                              addr1
                              ", "
                              stage
                              "\n    "
                              mnem
                              "q "
                              stage
                              ", "
                              addr
                              "\n"))
                          instrs
                          after-store
                          out)))))))))]
      [_ (CompilerBackendMaybeGepRmwEmission.No)])))

;; The fold's entry point: dispatch on what follows the gep+load pair.
(define (compiler-backend-emit-gep-rmw-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepRmwEmission
  ;; A constant gep offset addresses through the base register alone, which this
  ;; fold does not spell; the dynamic SIB form is the whole admitted family.
  ;; That value match is the cheapest test available and it retires every
  ;; constant-offset field access in the program before any type is measured.
  (if (>= index instrs.len)
    (CompilerBackendMaybeGepRmwEmission.No)
    (match (compiler-backend-value-as-i64 offset)
      [(option_i64.Some _) (CompilerBackendMaybeGepRmwEmission.No)]
      [(option_i64.None)
        (if (not
          (compiler-backend-gep-rmw-word-type? ctx.type-segment-bases load-ty))
          (CompilerBackendMaybeGepRmwEmission.No)
          (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
            [(compiler_ir_types.CompilerIrInstr.BinOp alu-dst op lhs rhs alu-ty)
              (compiler-backend-emit-gep-rmw-direct-rest
                ctx
                fallthrough
                gep-fold-disp
                base
                offset
                elem-ty
                load-dst
                alu-dst
                op
                lhs
                rhs
                alu-ty
                instrs
                (+ index 1)
                out)]
            [(compiler_ir_types.CompilerIrInstr.Gep
                gep-dst1
                base1
                offset1
                elem-ty1)
              (if (and
                (compiler-backend-var-single-use? ctx.use-counts gep-dst1)
                (< (+ index 1) instrs.len))
                (match (compiler_ir_types.compiler-ir-instr-seq-ref
                  instrs
                  (+ index 1))
                  [(compiler_ir_types.CompilerIrInstr.Load
                      load-dst1
                      src1
                      load-ty1)
                    (if (compiler-backend-branch-uses-var? src1 gep-dst1)
                      (match (compiler-backend-value-as-i64 offset1)
                        [(option_i64.Some _)
                          (CompilerBackendMaybeGepRmwEmission.No)]
                        [(option_i64.None)
                          (compiler-backend-emit-gep-rmw-memory-rest
                            ctx
                            fallthrough
                            gep-fold-disp
                            base
                            offset
                            elem-ty
                            load-dst
                            base1
                            offset1
                            elem-ty1
                            load-dst1
                            load-ty1
                            instrs
                            (+ index 2)
                            out)])
                      (CompilerBackendMaybeGepRmwEmission.No))]
                  [_ (CompilerBackendMaybeGepRmwEmission.No)])
                (CompilerBackendMaybeGepRmwEmission.No))]
            [_ (CompilerBackendMaybeGepRmwEmission.No)]))])))

(define (compiler-backend-emit-fused-gep-load-rest-tail
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  ;; GAP10 first: it is the only rule here that retires the STORE as well, so a
  ;; window it claims would otherwise be split across two rules that each emit
  ;; one instruction more than the pair needs. Every rule below is offered the
  ;; window untouched -- GAP10's probe consumes no ordinal until it commits.
  (match (compiler-backend-emit-gep-rmw-rest
    ctx
    fallthrough
    gep-fold-disp
    base
    offset
    elem-ty
    load-dst
    load-ty
    instrs
    index
    out)
    [(CompilerBackendMaybeGepRmwEmission.Some result) result]
    [(CompilerBackendMaybeGepRmwEmission.No)
      (compiler-backend-emit-fused-gep-load-rest-alu-tail
        ctx
        fallthrough
        _gep-dst
        gep-fold-disp
        base
        offset
        elem-ty
        load-dst
        load-ty
        instrs
        index
        out)]))

(define (compiler-backend-emit-fused-gep-load-rest-alu-tail
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  ;; GAP8 ALU fold first: the probe is side-effect-free, so a rejection costs
  ;; nothing and falls through to the existing single/pair load fusion.
  (match (compiler-backend-gep-load-alu-probe
    ctx.backend-state
    ctx.type-segment-bases
    ctx.assignments
    ctx.types
    ctx.global-types
    ctx.use-counts
    base
    offset
    load-dst
    load-ty
    instrs
    index)
    [(CompilerBackendGepLoadAluFold.Some mnem alu-dst x after-binop)
      (compiler-backend-emit-fused-result-rest
        ctx
        fallthrough
        (compiler-backend-emit-gep-load-alu
          ctx.type-segment-bases
          ctx.assignments
          mnem
          alu-dst
          x
          base
          offset
          elem-ty
          gep-fold-disp
          (compiler-backend-scratch-plan-register-ahead
            (compiler-backend-runtime-plan-scratch ctx.plan)
            0
            0
            ctx.backend-state)
          (compiler-backend-scratch-plan-register-ahead
            (compiler-backend-runtime-plan-scratch ctx.plan)
            0
            1
            ctx.backend-state)
          ctx.backend-state)
        instrs
        after-binop
        out)]
    [(CompilerBackendGepLoadAluFold.No)
      (match (compiler-backend-emit-dynamic-gep-load-pair-alu-rest
        ctx
        fallthrough
        gep-fold-disp
        base
        offset
        elem-ty
        load-dst
        load-ty
        instrs
        index
        out)
        [(CompilerBackendMaybeGepLoadPairAluEmission.Some result) result]
        [(CompilerBackendMaybeGepLoadPairAluEmission.No)
          (compiler-backend-emit-fused-gep-load-plain-rest
            ctx
            fallthrough
            _gep-dst
            gep-fold-disp
            base
            offset
            elem-ty
            load-dst
            load-ty
            instrs
            index
            out)])]))

(define (compiler-backend-emit-fused-gep-load-plain-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [load-dst : i64]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  ;; M-D emergency-leak fix: the single gep+load emission is inlined at each
  ;; fallthrough site instead of being computed SPECULATIVELY up front.
  ;; emit-load-from-gep scavenges a base register; under full occupancy that
  ;; scavenge EMERGENCY-adds the picked register to the global pending set as
  ;; a side effect. The speculative single asm was discarded on the PAIR path,
  ;; but its pending registers leaked into the pair wrap, whose stray trailing
  ;; restore overwrote the pair's second loaded result (lex-parse-based-int:
  ;; string len in %r9 restored-over before its bounds compare -> false OOB
  ;; abort on every mid-band self-host build).
  (match (compiler-backend-value-as-i64 offset)
    [(option_i64.Some _)
      (if (< index instrs.len)
        (let
          [maybe-gep : compiler_ir_types.CompilerIrInstr
            (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
          [after-gep : i64 (+ index 1)]
          (match maybe-gep
            [(compiler_ir_types.CompilerIrInstr.Gep
                gep-dst2
                base2
                offset2
                elem-ty2)
              (if (and
                (compiler-backend-var-single-use? ctx.use-counts gep-dst2)
                (compiler_optimize.opt-value-eq base2 base))
                (match (compiler-backend-value-as-i64 offset2)
                  [(option_i64.Some _)
                    (if (< after-gep instrs.len)
                      (let
                        [maybe-load : compiler_ir_types.CompilerIrInstr
                          (compiler_ir_types.compiler-ir-instr-seq-ref
                            instrs
                            after-gep)]
                        [after-load2 : i64 (+ after-gep 1)]
                        (match maybe-load
                          [(compiler_ir_types.CompilerIrInstr.Load
                              load-dst2
                              src2
                              load-ty2)
                            (if (and
                              (compiler-backend-branch-uses-var? src2 gep-dst2)
                              (not
                                (and
                                  (compiler-backend-load-compare-type?
                                    ctx.type-segment-bases
                                    load-ty2)
                                  (compiler-backend-var-single-use?
                                    ctx.use-counts
                                    load-dst2)
                                  (or
                                    (compiler-backend-rest-starts-load-compare-branch?
                                      instrs
                                      after-load2
                                      load-dst2
                                      ctx.types
                                      ctx.global-types
                                      ctx.use-counts)
                                    ;; M6-A: `.ptr` and `.len` of the same
                                    ;; string/vector are the canonical pair, and
                                    ;; `.len` is almost always the bounds
                                    ;; check's length operand right behind it.
                                    (compiler-backend-gep-load-bounds-foldable?
                                      ctx
                                      base
                                      offset2
                                      elem-ty2
                                      load-dst2
                                      load-ty2
                                      instrs
                                      after-load2)))))
                              (let
                                ;; GAP9: the pair consumes a SECOND gep;
                                ;; advance its ordinal before either pair path.
                                [gep-fold-disp2 : i64
                                  (compiler-backend-gep-fold-next!
                                    ctx.function-state
                                    ctx.type-segment-bases
                                    offset2
                                    elem-ty2)]
                                (match (compiler-backend-gep-load-pair-alu-probe
                                  ctx.backend-state
                                  ctx.type-segment-bases
                                  ctx.assignments
                                  ctx.types
                                  ctx.global-types
                                  ctx.use-counts
                                  base
                                  offset
                                  elem-ty
                                  gep-fold-disp
                                  load-dst
                                  load-ty
                                  offset2
                                  elem-ty2
                                  gep-fold-disp2
                                  load-dst2
                                  load-ty2
                                  instrs
                                  after-load2)
                                  [(CompilerBackendGepLoadPairAluFold.Some
                                      mnem
                                      alu-dst
                                      addr0
                                      addr1
                                      after-binop)
                                    (compiler-backend-emit-fused-result-rest
                                      ctx
                                      fallthrough
                                      (compiler-backend-emit-gep-load-pair-alu
                                        ctx.backend-state
                                        ctx.assignments
                                        mnem
                                        alu-dst
                                        addr0
                                        addr1)
                                      instrs
                                      after-binop
                                      out)]
                                  [(CompilerBackendGepLoadPairAluFold.No)
                                    (compiler-backend-emit-fused-result-rest
                                      ctx
                                      fallthrough
                                      (compiler-backend-emit-load-from-gep-pair-planned
                                        ctx.type-segment-bases
                                        ctx.assignments
                                        base
                                        offset
                                        elem-ty
                                        load-dst
                                        load-ty
                                        offset2
                                        elem-ty2
                                        load-dst2
                                        load-ty2
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          0
                                          0
                                          ctx.backend-state)
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          0
                                          1
                                          ctx.backend-state)
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          1
                                          1
                                          ctx.backend-state)
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          2
                                          0
                                          ctx.backend-state)
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          2
                                          1
                                          ctx.backend-state)
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          3
                                          1
                                          ctx.backend-state)
                                        ctx.backend-state)
                                      instrs
                                      after-load2
                                      out)]))
                              (compiler-backend-emit-fused-result-rest
                                ctx
                                fallthrough
                                (compiler-backend-emit-load-from-gep
                                  ctx.type-segment-bases
                                  ctx.assignments
                                  load-dst
                                  base
                                  offset
                                  elem-ty
                                  load-ty
                                  ""
                                  gep-fold-disp
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    0
                                    0
                                    ctx.backend-state)
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    0
                                    1
                                    ctx.backend-state)
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    1
                                    1
                                    ctx.backend-state)
                                  ctx.backend-state)
                                instrs
                                index
                                out))]
                          [_
                            (compiler-backend-emit-fused-result-rest
                              ctx
                              fallthrough
                              (compiler-backend-emit-load-from-gep
                                ctx.type-segment-bases
                                ctx.assignments
                                load-dst
                                base
                                offset
                                elem-ty
                                load-ty
                                ""
                                gep-fold-disp
                                (compiler-backend-scratch-plan-register-ahead
                                  (compiler-backend-runtime-plan-scratch
                                    ctx.plan)
                                  0
                                  0
                                  ctx.backend-state)
                                (compiler-backend-scratch-plan-register-ahead
                                  (compiler-backend-runtime-plan-scratch
                                    ctx.plan)
                                  0
                                  1
                                  ctx.backend-state)
                                (compiler-backend-scratch-plan-register-ahead
                                  (compiler-backend-runtime-plan-scratch
                                    ctx.plan)
                                  1
                                  1
                                  ctx.backend-state)
                                ctx.backend-state)
                              instrs
                              index
                              out)]))
                      (compiler-backend-emit-fused-result-rest
                        ctx
                        fallthrough
                        (compiler-backend-emit-load-from-gep
                          ctx.type-segment-bases
                          ctx.assignments
                          load-dst
                          base
                          offset
                          elem-ty
                          load-ty
                          ""
                          gep-fold-disp
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            0
                            0
                            ctx.backend-state)
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            0
                            1
                            ctx.backend-state)
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            1
                            1
                            ctx.backend-state)
                          ctx.backend-state)
                        instrs
                        index
                        out))]
                  [(option_i64.None)
                    (compiler-backend-emit-fused-result-rest
                      ctx
                      fallthrough
                      (compiler-backend-emit-load-from-gep
                        ctx.type-segment-bases
                        ctx.assignments
                        load-dst
                        base
                        offset
                        elem-ty
                        load-ty
                        ""
                        gep-fold-disp
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          0
                          ctx.backend-state)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          1
                          ctx.backend-state)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1
                          1
                          ctx.backend-state)
                        ctx.backend-state)
                      instrs
                      index
                      out)])
                (compiler-backend-emit-fused-result-rest
                  ctx
                  fallthrough
                  (compiler-backend-emit-load-from-gep
                    ctx.type-segment-bases
                    ctx.assignments
                    load-dst
                    base
                    offset
                    elem-ty
                    load-ty
                    ""
                    gep-fold-disp
                    (compiler-backend-scratch-plan-register-ahead
                      (compiler-backend-runtime-plan-scratch ctx.plan)
                      0
                      0
                      ctx.backend-state)
                    (compiler-backend-scratch-plan-register-ahead
                      (compiler-backend-runtime-plan-scratch ctx.plan)
                      0
                      1
                      ctx.backend-state)
                    (compiler-backend-scratch-plan-register-ahead
                      (compiler-backend-runtime-plan-scratch ctx.plan)
                      1
                      1
                      ctx.backend-state)
                    ctx.backend-state)
                  instrs
                  index
                  out))]
            [_
              (compiler-backend-emit-fused-result-rest
                ctx
                fallthrough
                (compiler-backend-emit-load-from-gep
                  ctx.type-segment-bases
                  ctx.assignments
                  load-dst
                  base
                  offset
                  elem-ty
                  load-ty
                  ""
                  gep-fold-disp
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0
                    0
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0
                    1
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    1
                    ctx.backend-state)
                  ctx.backend-state)
                instrs
                index
                out)]))
        (compiler-backend-emit-fused-result-rest
          ctx
          fallthrough
          (compiler-backend-emit-load-from-gep
            ctx.type-segment-bases
            ctx.assignments
            load-dst
            base
            offset
            elem-ty
            load-ty
            ""
            gep-fold-disp
            (compiler-backend-scratch-plan-register-ahead
              (compiler-backend-runtime-plan-scratch ctx.plan)
              0
              0
              ctx.backend-state)
            (compiler-backend-scratch-plan-register-ahead
              (compiler-backend-runtime-plan-scratch ctx.plan)
              0
              1
              ctx.backend-state)
            (compiler-backend-scratch-plan-register-ahead
              (compiler-backend-runtime-plan-scratch ctx.plan)
              1
              1
              ctx.backend-state)
            ctx.backend-state)
          instrs
          index
          out))]
    [(option_i64.None)
      (compiler-backend-emit-fused-result-rest
        ctx
        fallthrough
        (compiler-backend-emit-load-from-gep
          ctx.type-segment-bases
          ctx.assignments
          load-dst
          base
          offset
          elem-ty
          load-ty
          ""
          gep-fold-disp
          (compiler-backend-scratch-plan-register-ahead
            (compiler-backend-runtime-plan-scratch ctx.plan)
            0
            0
            ctx.backend-state)
          (compiler-backend-scratch-plan-register-ahead
            (compiler-backend-runtime-plan-scratch ctx.plan)
            0
            1
            ctx.backend-state)
          (compiler-backend-scratch-plan-register-ahead
            (compiler-backend-runtime-plan-scratch ctx.plan)
            1
            1
            ctx.backend-state)
          ctx.backend-state)
        instrs
        index
        out)]))

(define (compiler-backend-emit-fused-gep-store-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-dst : i64]
  [gep-fold-disp : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [value : compiler_ir_types.CompilerIrValue]
  [store-ty : compiler_ast_types.AstType]
  [store-instruction-offset : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (compiler-backend-emit-store-to-gep
    ctx.type-segment-bases
    ctx.assignments
    base
    offset
    elem-ty
    value
    store-ty
    ctx.program-index
    gep-fold-disp
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      0
      0
      ctx.backend-state)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      0
      1
      ctx.backend-state)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      store-instruction-offset
      1
      ctx.backend-state)
    ctx.backend-state)
    [(ResultCompilerBackend.Ok head)
      (begin
        (compiler-backend-asm-append
          out
          (compiler-backend-emergency-wrap head ctx.backend-state))
        (compiler-backend-emit-instrs ctx fallthrough instrs index out))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (__tl-box-place message)
            (compiler-backend-instr-diagnostic
              ctx.spans
              ctx.source-function
              (compiler_ir_types.CompilerIrInstr.Gep
                gep-dst
                base
                offset
                elem-ty)
              ctx.func-diag
              ""))))]))

(define (compiler-backend-emit-fused-mov-trivial-phi-return-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [target-label : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (compiler-backend-emit-mov-trivial-phi-return-edge
    ctx.type-segment-bases
    ctx.source-function
    ctx.blocks
    target-label
    ctx.current-label
    ctx.assignments
    ctx.vars
    ctx.ret-ty
    dst
    src
    ctx.program-index)
    [(ResultCompilerBackend.Ok direct-return)
      (if (string.eq direct-return "")
        (if (compiler-backend-var-single-use? ctx.use-counts dst)
          (match (compiler-backend-emit-mov-phi-copy-edge
            ctx.type-segment-bases
            ctx.assignments
            ctx.blocks
            target-label
            ctx.current-label
            dst
            src
            ctx.program-index
            ctx.vars
            (compiler-backend-scratch-plan-register-ahead
              (compiler-backend-runtime-plan-scratch ctx.plan)
              1
              0
              ctx.backend-state)
            (compiler-backend-scratch-plan-register-ahead
              (compiler-backend-runtime-plan-scratch ctx.plan)
              1
              1
              ctx.backend-state))
            [(ResultCompilerBackend.Ok fused-copies)
              (if (string.eq fused-copies "")
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  (compiler_ir_types.CompilerIrInstr.Mov dst src ty)
                  instrs
                  (- index 1)
                  out)
                (match (compiler-backend-emit-trivial-phi-return-edge
                  ctx.type-segment-bases
                  ctx.source-function
                  ctx.blocks
                  target-label
                  ctx.current-label
                  ctx.assignments
                  ctx.vars
                  ctx.ret-ty
                  ctx.program-index)
                  [(ResultCompilerBackend.Ok plain-direct-return)
                    (begin
                      (compiler-backend-asm-append
                        out
                        (if (string.eq plain-direct-return "")
                          (str_cat.str-cat
                            fused-copies
                            (let
                              [taken : i64
                                (compiler-backend-jump-resolve-target
                                  ctx.backend-state
                                  target-label
                                  fallthrough)]
                              (if (compiler-backend-jump-target-is-fallthrough?
                                taken
                                fallthrough)
                                ""
                                (compiler-backend-jump-label ctx.function taken))))
                          plain-direct-return))
                      (compiler-backend-emit-instrs
                        ctx
                        fallthrough
                        instrs
                        index
                        out))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err
                      (box
                        (compiler-backend-apply-instr-diagnostic
                          (__tl-box-place message)
                          (compiler-backend-instr-diagnostic
                            ctx.spans
                            ctx.source-function
                            (compiler_ir_types.CompilerIrInstr.Mov dst src ty)
                            ctx.func-diag
                            ""))))]))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler-backend-apply-instr-diagnostic
                    (__tl-box-place message)
                    (compiler-backend-instr-diagnostic
                      ctx.spans
                      ctx.source-function
                      (compiler_ir_types.CompilerIrInstr.Mov dst src ty)
                      ctx.func-diag
                      ""))))])
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            (compiler_ir_types.CompilerIrInstr.Mov dst src ty)
            instrs
            (- index 1)
            out))
        (begin
          (compiler-backend-emergency-append
            out
            direct-return
            ctx.backend-state)
          (compiler-backend-emit-instrs ctx fallthrough instrs index out)))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (__tl-box-place message)
            (compiler-backend-instr-diagnostic
              ctx.spans
              ctx.source-function
              (compiler_ir_types.CompilerIrInstr.Mov dst src ty)
              ctx.func-diag
              ""))))]))

(define (compiler-backend-emit-call-return
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [name : i64]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-stage : String]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [vars : i64]
  [plan : CompilerBackendRuntimePlan]
  [_functions : compiler_ir_types.CompilerIrFunctionList]
  [_externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [call-symbol : String
      (compiler-backend-call-symbol-index name plan program-index)]
    [inline-memory-name : String
      (compiler-backend-inline-memory-call-target
        (compiler-backend-symbol-text-index program-index name)
        call-symbol)]
    [extern-call-info : i64
      (compiler-backend-index-extern-call-info program-index name)]
    [param-types : compiler_ast_types.AstTypeList
      (compiler-backend-call-param-types-for-call
        type-segment-bases
        name
        args
        types
        global-types
        extern-call-info
        program-index)]
    [c-abi? : bool
      (compiler-backend-extern-call-info-aggregate-params? extern-call-info)]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        c-abi?
        program-index)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      args
      param-types
      c-abi?
      0
      0
      0
      0
      0
      planned-stage
      instr-diag
      program-index
      vars
      program-index.backend-state)
      [(ResultCompilerBackend.Ok args-asm)
        (if (and
          (compiler-backend-tls-current-arena-call-id? name)
          (not (compiler-backend-index-function-defines? program-index name)))
          (match (compiler-backend-tls-current-arena-inline-asm
            target
            name
            instr-diag)
            [(ResultCompilerBackend.Ok inline-asm)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  (compiler-backend-emit-call-space-sub call-space)
                  args-asm
                  inline-asm
                  (compiler-backend-emit-call-space-add call-space)
                  (compiler-backend-return-tail
                    program-index.backend-state
                    source-function
                    assignments
                    vars
                    blocks)))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler-backend-apply-instr-diagnostic
                    (__tl-box-place message)
                    instr-diag)))])
          (if (compiler-backend-inline-memory-call-name? inline-memory-name)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (compiler-backend-emit-call-space-sub call-space)
                args-asm
                (compiler-backend-inline-memory-call-asm
                  target
                  inline-memory-name)
                (compiler-backend-emit-call-space-add call-space)
                (compiler-backend-return-tail
                  program-index.backend-state
                  source-function
                  assignments
                  vars
                  blocks)))
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (compiler-backend-emit-call-space-sub call-space)
                args-asm
                (compiler-backend-varargs-pre-call
                  type-segment-bases
                  target
                  extern-call-info
                  param-types)
                (str_cat.str-cat
                  "    call "
                  call-symbol
                  "\n"
                  (str_cat.str-cat
                    (compiler-backend-emit-call-space-add call-space)
                    (compiler-backend-return-tail
                      program-index.backend-state
                      source-function
                      assignments
                      vars
                      blocks))
                  "")))))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              instr-diag)))])))

(define (compiler-backend-indirect-call-param-types
  [types : compiler_regalloc.CompilerRegVarTypes]
  [func : compiler_ir_types.CompilerIrValue]
  [_functions : compiler_ir_types.CompilerIrFunctionList]
  [_externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]) : compiler_ast_types.AstTypeList
  (match func
    [(compiler_ir_types.CompilerIrValue.Function name)
      (match (compiler-backend-index-signature program-index name)
        [(CompilerBackendMaybeSignature.Some param-types _) param-types]
        [(CompilerBackendMaybeSignature.No)
          (compiler_ast_types.ast-type-list-new)])]
    [_
      (match (compiler-backend-value-type
        types
        (CompilerBackendGlobalTypeTable.Empty)
        func)
        [(compiler_regalloc.CompilerRegMaybeType.Some ty)
          (match ty
            [(compiler_ast_types.AstType.Func param-types _)
              (__tl-box-place param-types)]
            [_ (compiler_ast_types.ast-type-list-new)])]
        [(compiler_regalloc.CompilerRegMaybeType.No)
          (compiler_ast_types.ast-type-list-new)])]))

(define (compiler-backend-top-level-structural-source-type?
  [type-segment-bases : i64]
  [ty : compiler_ast_types.AstType]) : bool
  (match ty
    [(compiler_ast_types.AstType.Region _ inner)
      (compiler-backend-top-level-structural-source-type?
        type-segment-bases
        (compiler_ast_types.ast-type-segment-bases-get type-segment-bases inner))]
    [(compiler_ast_types.AstType.Tuple _) true]
    [(compiler_ast_types.AstType.Array _ _) true]
    [_ false]))

(define (compiler-backend-type-list-has-top-level-structural-source-at?
  [type-segment-bases : i64]
  [types : (& types compiler_ast_types.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (compiler_ast_types.ast-type-list-len types))
    false
    (or
      (compiler-backend-top-level-structural-source-type?
        type-segment-bases
        (compiler_ast_types.ast-type-segment-bases-get
          type-segment-bases
          (compiler_ast_types.ast-type-list-get
            types
            index
            (compiler_ast_types.ast-type-id-fallback))))
      (compiler-backend-type-list-has-top-level-structural-source-at?
        type-segment-bases
        types
        (+ index 1)))))

(define (compiler-backend-effective-normal-indirect-param-types
  [type-segment-bases : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]) : compiler_ast_types.AstTypeList
  (let
    [declared : compiler_ast_types.AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    (match func
      ;; A known function's program-index signature is already the physical
      ;; ABI list (including hidden structural results), so never substitute
      ;; actual source-var types for it.
      [(compiler_ir_types.CompilerIrValue.Function _) declared]
      [_
        (if (or
          (not
            (=
              (compiler-backend-call-args-count args)
              (compiler-backend-type-list-count declared)))
          (compiler-backend-type-list-has-top-level-structural-source-at?
            type-segment-bases
            (& declared)
            0))
          (compiler-backend-call-actual-param-types
            type-segment-bases
            types
            (CompilerBackendGlobalTypeTable.Empty)
            args)
          declared)])))

(define (compiler-backend-indirect-tail-call-register-only?
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [types : compiler_ast_types.AstTypeList]
  [program-index : CompilerBackendProgramIndex]) : bool
  (=
    (compiler-backend-call-stack-arg-count
      type-segment-bases
      target
      args
      types
      false
      0
      1
      0
      1
      0
      program-index)
    0))

(define (compiler-backend-scavenge-tail-call-target-reg
  [planned : String]
  [backend-state : CompilerBackendState]) : String
  ;; Tail jumps restore callee-saved homes before the final jmp. Keep the closure
  ;; pointer in a pooled caller-saved non-arg candidate instead.
  (if (string.eq planned "")
    (compiler-backend-scavenge-reg-here
      (compiler-backend-c-abi-stage-exclude-with "%r11")
      compiler-backend-c-abi-stage-exclude-count
      "%r10"
      backend-state)
    planned))

(define (compiler-backend-indirect-call-callee-arg-overlap?
  [target : CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [backend-state : CompilerBackendState]) : bool
  (let
    [home : String
      (compiler-backend-value-register-home backend-state assignments func)]
    [index : i64 1]
    [overlap : bool false]
    (begin
      ;; Slot zero is the hidden closure environment. Conservatively scan the
      ;; remaining GP argument bank whenever there is an explicit argument: a
      ;; register-group can consume more than one slot, while float-only calls
      ;; merely take this uncommon preservation path unnecessarily.
      (while (and
        (> (compiler-backend-call-args-count args) 0)
        (< index (compiler-backend-call-register-count target))
        (not overlap))
        (begin
          (match (compiler-backend-target-arg-reg target index)
            [(ResultBackendReg.Ok reg) (set! overlap (string.eq home reg))]
            [(ResultBackendReg.Err _) unit])
          (set! index (+ index 1))))
      overlap)))

(define (compiler-backend-emit-indirect-call-with-arg-assignments
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [dst : i64]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [arg-assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-target : String]
  [planned-stage : String]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [param-types : compiler_ast_types.AstTypeList
      (compiler-backend-effective-normal-indirect-param-types
        type-segment-bases
        types
        func
        args
        functions
        externs
        program-index)]
    [effective-arg-assignments : compiler_regalloc.CompilerRegAssignmentTable
      (if (compiler-backend-declared-first-call-arg-accepts-rax-forward?
        type-segment-bases
        program-index
        param-types)
        arg-assignments
        assignments)]
    ;; Dense-index override mirroring effective-arg-assignments: the
    ;; rax-forward insert reaches the arg emitters exactly when the declared
    ;; first arg accepts the forward.
    [effective-arg-override : i64
      (if (compiler-backend-declared-first-call-arg-accepts-rax-forward?
        type-segment-bases
        program-index
        param-types)
        (compiler-backend-function-state-rax-forward-pending-var backend-state)
        -1)]
    [call-space : i64
      (compiler-backend-closure-call-arg-space
        target
        args
        param-types
        program-index)]
    (match (compiler-backend-emit-call-args-with-override
      type-segment-bases
      effective-arg-override
      target
      effective-arg-assignments
      args
      param-types
      false
      0
      1
      0
      1
      0
      planned-stage
      instr-diag
      program-index
      ;; vars must be the real frame var count: group-word1 slots live at
      ;; -(8*(vars+var+1))(%rbp), so 0 here made a stack-homed group arg read
      ;; its word0 slot for BOTH words (closure-arg miscompile).
      vars
      backend-state)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-target-arg-reg target 0)
          [(ResultBackendReg.Ok env-reg)
            (match (compiler-backend-emit-call-result-store
              type-segment-bases
              assignments
              dst
              ty
              vars
              program-index)
              [(ResultCompilerBackend.Ok result-store)
                (match func
                  [(compiler_ir_types.CompilerIrValue.Function name)
                    (ResultCompilerBackend.Ok
                      (str_cat.str-cat
                        (compiler-backend-emit-call-space-sub call-space)
                        args-asm
                        (compiler-backend-emit-load-i64-immediate 0 env-reg)
                        (str_cat.str-cat
                          "    call "
                          (compiler-backend-closure-entry-label
                            (compiler-backend-symbol-text-index
                              program-index
                              name))
                          "\n"
                          (str_cat.str-cat
                            (compiler-backend-emit-call-space-add call-space)
                            result-store)
                          "")))]
                  [_
                    ;; Normally materialize the closure pointer after argument
                    ;; marshalling, so the marshalling scratch remains free to
                    ;; stage stack/group values. A register-resident callee can
                    ;; itself occupy an explicit argument register, though. Save
                    ;; that uncommon overlap to cycle-temp slot 1 before args
                    ;; (slot 0 belongs to parallel arg moves), then reload it
                    ;; afterward. This avoids making any GP scratch live across
                    ;; the whole marshalling sequence.
                    (let
                      [scav-clo : String
                        (compiler-backend-scavenge-call-target-reg
                          planned-target
                          backend-state)]
                      [overlap : bool
                        (compiler-backend-indirect-call-callee-arg-overlap?
                          target
                          assignments
                          func
                          args
                          backend-state)]
                      (match (compiler-backend-emit-load-value-with-plan
                        assignments
                        func
                        scav-clo
                        backend-state)
                        [(ResultCompilerBackend.Ok func-asm)
                          (let
                            [call-tail : String
                              (str_cat.str-cat
                                "    movq 8("
                                scav-clo
                                "), "
                                env-reg
                                "\n    call *("
                                scav-clo
                                ")\n"
                                (str_cat.str-cat
                                  (compiler-backend-emit-call-space-add
                                    call-space)
                                  result-store)
                                "")]
                            (if overlap
                              (let
                                [slot : String
                                  (compiler-backend-cycle-temp-slot-with-backend-state
                                    backend-state
                                    1)]
                                (ResultCompilerBackend.Ok
                                  (str_cat.str-cat
                                    (compiler-backend-emit-call-space-sub
                                      call-space)
                                    func-asm
                                    (str_cat.str-cat
                                      "    movq "
                                      scav-clo
                                      ", "
                                      slot
                                      "\n")
                                    args-asm
                                    (str_cat.str-cat
                                      "    movq "
                                      slot
                                      ", "
                                      scav-clo
                                      "\n")
                                    call-tail)))
                              (ResultCompilerBackend.Ok
                                (str_cat.str-cat
                                  (compiler-backend-emit-call-space-sub
                                    call-space)
                                  args-asm
                                  func-asm
                                  call-tail))))]
                        [(ResultCompilerBackend.Err message)
                          (ResultCompilerBackend.Err
                            (box
                              (compiler-backend-apply-instr-diagnostic
                                (__tl-box-place message)
                                instr-diag)))]))])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err
                  (box
                    (compiler-backend-apply-instr-diagnostic
                      (__tl-box-place message)
                      instr-diag)))])]
          [(ResultBackendReg.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler_diagnostic.compiler-diagnostic-with-message
                  instr-diag
                  message)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              instr-diag)))])))

(define (compiler-backend-emit-indirect-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [dst : i64]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-target : String]
  [planned-stage : String]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (compiler-backend-emit-indirect-call-with-arg-assignments
    type-segment-bases
    target
    dst
    func
    args
    ty
    assignments
    assignments
    planned-target
    planned-stage
    types
    functions
    externs
    program-index
    vars
    instr-diag
    backend-state))

(define (compiler-backend-emit-tail-indirect-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-target : String]
  [planned-stage : String]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [vars : i64]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [param-types : compiler_ast_types.AstTypeList
      (compiler-backend-effective-normal-indirect-param-types
        type-segment-bases
        types
        func
        args
        functions
        externs
        program-index)]
    [call-space : i64
      (compiler-backend-closure-call-arg-space
        target
        args
        param-types
        program-index)]
    [register-only : bool
      (compiler-backend-indirect-tail-call-register-only?
        type-segment-bases
        target
        args
        param-types
        program-index)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      args
      param-types
      false
      0
      1
      0
      1
      0
      planned-stage
      instr-diag
      program-index
      vars
      backend-state)
      [(ResultCompilerBackend.Ok args-asm)
        (let
          [clo-reg : String
            (compiler-backend-scavenge-tail-call-target-reg
              planned-target
              backend-state)]
          (match (compiler-backend-emit-load-value-with-plan
            assignments
            func
            clo-reg
            backend-state)
            [(ResultCompilerBackend.Ok func-asm)
              (match (compiler-backend-target-arg-reg target 0)
                [(ResultBackendReg.Ok env-reg)
                  (let
                    [target-addr : String
                      (str_cat.str-cat "*(" clo-reg ")" "" "")]
                    [descriptor-asm : String
                      (str_cat.str-cat
                        func-asm
                        "    movq 8("
                        clo-reg
                        "), "
                        env-reg
                        "\n"
                        "")]
                    (if register-only
                      (ResultCompilerBackend.Ok
                        (str_cat.str-cat
                          args-asm
                          descriptor-asm
                          (compiler-backend-tail-jump-tail
                            assignments
                            vars
                            target-addr
                            backend-state)))
                      (ResultCompilerBackend.Ok
                        (str_cat.str-cat
                          (compiler-backend-emit-call-space-sub call-space)
                          args-asm
                          descriptor-asm
                          (str_cat.str-cat
                            "    call "
                            target-addr
                            "\n"
                            (compiler-backend-emit-call-space-add call-space)
                            (str_cat.str-cat
                              (compiler-backend-tail-call-return-normalize
                                type-segment-bases
                                ty)
                              (compiler-backend-return-tail
                                program-index.backend-state
                                source-function
                                assignments
                                vars
                                blocks))
                            ""
                            "")))))]
                [(ResultBackendReg.Err message)
                  (ResultCompilerBackend.Err
                    (box
                      (compiler_diagnostic.compiler-diagnostic-with-message
                        instr-diag
                        message)))])]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler-backend-apply-instr-diagnostic
                    (__tl-box-place message)
                    instr-diag)))]))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              instr-diag)))])))

(define (compiler-backend-indirect-c-call-direct-home?
  [_target : CompilerBackendTarget]
  [home : String]) : bool
  ;; Use the callee-saved homes common to SysV and Win64. Win64 also preserves
  ;; rdi/rsi, but those stay on the fallback path for this conservative pass.
  (or
    (string.eq home "%rbx")
    (string.eq home "%r12")
    (string.eq home "%r13")
    (string.eq home "%r14")
    (string.eq home "%r15")))

(define (compiler-backend-indirect-c-call-direct-home
  [backend-state : CompilerBackendState]
  [target : CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [func : compiler_ir_types.CompilerIrValue]) : String
  (let
    [home : String
      (compiler-backend-value-register-home backend-state assignments func)]
    (if (compiler-backend-indirect-c-call-direct-home? target home)
      home
      "")))

(define (compiler-backend-scavenge-call-target-reg
  [planned : String]
  [backend-state : CompilerBackendState]) : String
  ;; The final target load follows argument marshalling, so it must not clobber
  ;; any placed argument. Keep pooled caller-arg candidates unavailable and
  ;; reserve %r11 for ABI/runtime clobber semantics.
  (if (string.eq planned "")
    (compiler-backend-scavenge-reg-here
      (compiler-backend-c-abi-stage-exclude-with "%r11")
      compiler-backend-c-abi-stage-exclude-count
      "%r10"
      backend-state)
    planned))

(define (compiler-backend-emit-indirect-c-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [dst : i64]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-target : String]
  [planned-stage : String]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [declared-param-types : compiler_ast_types.AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    [param-types : compiler_ast_types.AstTypeList
      (if (compiler-backend-type-list-has-aggregate?
        type-segment-bases
        declared-param-types)
        (compiler-backend-call-c-abi-param-types
          type-segment-bases
          types
          (CompilerBackendGlobalTypeTable.Empty)
          args
          declared-param-types
          program-index)
        (if (=
          (compiler-backend-call-args-count args)
          (compiler-backend-type-list-count declared-param-types))
          declared-param-types
          (compiler-backend-call-actual-param-types
            type-segment-bases
            types
            (CompilerBackendGlobalTypeTable.Empty)
            args)))]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        true
        program-index)]
    [direct-home : String
      (compiler-backend-indirect-c-call-direct-home
        backend-state
        target
        assignments
        func)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      args
      param-types
      true
      0
      0
      0
      0
      0
      planned-stage
      instr-diag
      program-index
      ;; Real frame var count for group-word1 slot addressing (see
      ;; emit-indirect-call): latent today because C-ABI lowering never passes
      ;; 16-byte aggregates by value, but keep it correct.
      vars
      backend-state)
      [(ResultCompilerBackend.Ok args-asm)
        (if (string.eq direct-home "")
          (let
            [call-reg : String
              (compiler-backend-scavenge-call-target-reg
                planned-target
                backend-state)]
            (match (compiler-backend-emit-load-value-with-plan
              assignments
              func
              call-reg
              backend-state)
              [(ResultCompilerBackend.Ok func-asm)
                (ResultCompilerBackend.Ok
                  (str_cat.str-cat
                    (compiler-backend-emit-call-space-sub call-space)
                    args-asm
                    func-asm
                    (str_cat.str-cat
                      "    call *"
                      call-reg
                      "\n"
                      (compiler-backend-emit-call-space-add call-space)
                      (compiler-backend-emit-c-abi-call-result-store-reg
                        assignments
                        dst
                        (if (compiler-backend-float-type? ty)
                          "%xmm0"
                          "%rax")
                        ty
                        backend-state)
                      ""
                      "")))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err
                  (box
                    (compiler-backend-apply-instr-diagnostic
                      (__tl-box-place message)
                      instr-diag)))]))
          (ResultCompilerBackend.Ok
            (str_cat.str-cat
              (compiler-backend-emit-call-space-sub call-space)
              args-asm
              (str_cat.str-cat
                "    call *"
                direct-home
                "\n"
                (compiler-backend-emit-call-space-add call-space)
                (compiler-backend-emit-c-abi-call-result-store-reg
                  assignments
                  dst
                  (if (compiler-backend-float-type? ty)
                    "%xmm0"
                    "%rax")
                  ty
                  backend-state)
                ""
                ""))))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              instr-diag)))])))

(define (compiler-backend-emit-c-abi-store-result-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [base : compiler_ir_types.CompilerIrValue]
  [name : i64]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [slots : compiler_ir_types.CompilerIrCAbiReturnSlotSeq]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-target : String]
  [planned-stage : String]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [plan : CompilerBackendRuntimePlan]
  [_externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [extern-call-info : i64
      (compiler-backend-index-extern-call-info program-index name)]
    [param-types : compiler_ast_types.AstTypeList
      (compiler-backend-call-param-types-for-call
        type-segment-bases
        name
        args
        types
        global-types
        extern-call-info
        program-index)]
    [c-abi? : bool
      (compiler-backend-extern-call-info-aggregate-params? extern-call-info)]
    [call-space : i64
      (compiler-backend-call-stack-arg-layout-space
        type-segment-bases
        target
        args
        param-types
        c-abi?
        program-index)]
    ;; The args + 16-byte base-save region are reserved in the prologue frame
    ;; (instr-outgoing-stack-space), so no per-call %rsp dip is needed.
    [dip : i64 0]
    [call-symbol : String
      (compiler-backend-call-symbol-index name plan program-index)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      args
      param-types
      c-abi?
      0
      0
      0
      0
      0
      planned-stage
      instr-diag
      program-index
      vars
      backend-state)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-emit-c-abi-return-base-save
          assignments
          base
          call-space
          planned-target
          backend-state)
          [(ResultCompilerBackend.Ok base-save)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (compiler-backend-emit-call-space-sub dip)
                args-asm
                base-save
                (compiler-backend-varargs-pre-call
                  type-segment-bases
                  target
                  extern-call-info
                  param-types)
                (str_cat.str-cat
                  "    call "
                  call-symbol
                  "\n"
                  (str_cat.str-cat
                    (compiler-backend-emit-c-abi-return-stores
                      type-segment-bases
                      call-space
                      slots
                      planned-target
                      backend-state)
                    (compiler-backend-emit-call-space-add dip))
                  "")))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              instr-diag)))])))

(define (compiler-backend-emit-indirect-c-abi-store-result-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [base : compiler_ir_types.CompilerIrValue]
  [func : compiler_ir_types.CompilerIrValue]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [slots : compiler_ir_types.CompilerIrCAbiReturnSlotSeq]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [planned-target : String]
  [planned-stage : String]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : compiler_diagnostic.CompilerDiagnostic]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [declared-param-types : compiler_ast_types.AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    [param-types : compiler_ast_types.AstTypeList
      (if (compiler-backend-type-list-has-aggregate?
        type-segment-bases
        declared-param-types)
        (compiler-backend-call-c-abi-param-types
          type-segment-bases
          types
          (CompilerBackendGlobalTypeTable.Empty)
          args
          declared-param-types
          program-index)
        (if (=
          (compiler-backend-call-args-count args)
          (compiler-backend-type-list-count declared-param-types))
          declared-param-types
          (compiler-backend-call-actual-param-types
            type-segment-bases
            types
            (CompilerBackendGlobalTypeTable.Empty)
            args)))]
    [call-space : i64
      (compiler-backend-call-stack-arg-layout-space
        type-segment-bases
        target
        args
        param-types
        true
        program-index)]
    ;; Mirrors the direct C-ABI store-result path: the frame reserves this region
    ;; and the call does not move %rsp.
    [dip : i64 0]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      args
      param-types
      true
      0
      0
      0
      0
      0
      planned-stage
      instr-diag
      program-index
      vars
      backend-state)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-emit-c-abi-return-base-save
          assignments
          base
          call-space
          planned-target
          backend-state)
          [(ResultCompilerBackend.Ok base-save)
            (let
              [call-reg : String
                (compiler-backend-scavenge-call-target-reg
                  planned-target
                  backend-state)]
              (match (compiler-backend-emit-load-value-with-plan
                assignments
                func
                call-reg
                backend-state)
                [(ResultCompilerBackend.Ok func-asm)
                  (ResultCompilerBackend.Ok
                    (str_cat.str-cat
                      (compiler-backend-emit-call-space-sub dip)
                      args-asm
                      base-save
                      func-asm
                      (str_cat.str-cat
                        "    call *"
                        call-reg
                        "\n"
                        (str_cat.str-cat
                          (compiler-backend-emit-c-abi-return-stores
                            type-segment-bases
                            call-space
                            slots
                            planned-target
                            backend-state)
                          (compiler-backend-emit-call-space-add dip))
                        ""
                        ""
                        "")))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err
                    (box
                      (compiler-backend-apply-instr-diagnostic
                        (__tl-box-place message)
                        instr-diag)))]))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (__tl-box-place message)
                  instr-diag)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (__tl-box-place message)
              instr-diag)))])))

;; ---------------------------------------------------------------------------
;; Constant-divmod adjacent value forwarding.
;;
;; The signed literal expansion owns one non-fixed SRC register.  When its
;; dividend is the single-use result of the immediately preceding scalar op,
;; steer that producer into SRC instead of first defining a fixed %rax/%rdx
;; home.  Independently, when the divmod result has one use in the direct
;; Gep+StorePtr shape, leave the result in SRC and let the store read it there.
;; The home overrides below exist only while the fused IR bundle is emitted;
;; allocator assignments, liveness, and the IR itself remain unchanged.
(defenum CompilerBackendMaybeDivmodPolish
  (No)
  (Some ResultCompilerBackend))

(define (compiler-backend-divmod-producer-op?
  [op : compiler_ir_types.CompilerIrBinOp]) : bool
  (match op
    [(compiler_ir_types.CompilerIrBinOp.Add) true]
    [(compiler_ir_types.CompilerIrBinOp.Mul) true]
    [(compiler_ir_types.CompilerIrBinOp.BitXor) true]
    [_ false]))

(define (compiler-backend-divmod-fixed-home? [home : String]) : bool
  (or (string.eq home "%rax") (string.eq home "%rdx")))

;; Conservative retargetability gate for the producer forms this fold owns.
;; A register LHS plus a direct register/immediate RHS makes Add/Mul/BitXor a
;; no-extra-scratch destination-targetable instruction (LEA/two-address
;; add/imul/xor).  Wider fallback shapes keep their ordinary home.
(define (compiler-backend-divmod-producer-retargetable?
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [backend-state : CompilerBackendState]) : bool
  (and
    (compiler-backend-divmod-producer-op? op)
    (match ty
      [(compiler_ast_types.AstType.I64) true]
      [_ false])
    (compiler-backend-divmod-fixed-home?
      (compiler-backend-var-register-home backend-state assignments dst))
    (not
      (string.eq
        (compiler-backend-value-scalar-register backend-state assignments lhs)
        ""))
    (match (compiler-backend-immediate-operand backend-state rhs)
      [(CompilerBackendMaybeImmediate.Some _)
        (and
          (compiler-backend-binop-direct-width-ok? type-segment-bases op ty)
          (compiler-backend-binop-direct-immediate-ok?
            type-segment-bases
            (compiler-backend-binop-direct-mnemonic op)
            op
            rhs
            ty
            backend-state))]
      [(CompilerBackendMaybeImmediate.No)
        (let
          [lhs-reg : String
            (compiler-backend-value-scalar-register
              backend-state
              assignments
              lhs)]
          [rhs-reg : String
            (compiler-backend-value-scalar-register
              backend-state
              assignments
              rhs)]
          (and
            (not (string.eq rhs-reg ""))
            ;; %rbp cannot be a SIB index.  The only direct Add form with both
            ;; operands there therefore stays on the ordinary emitter.
            (not
              (and
                (match op
                  [(compiler_ir_types.CompilerIrBinOp.Add) true]
                  [_ false])
                (string.eq lhs-reg "%rbp")
                (string.eq rhs-reg "%rbp")))))])))

;; Emit exactly the direct producer forms admitted above.  This avoids the
;; ordinary binop emitter's eagerly-computed fallback scavenge: after changing
;; the destination home to SRC that unused probe can otherwise manufacture an
;; emergency save/restore even though the selected LEA/IMUL/XOR needs no
;; scratch at all.
(define (compiler-backend-emit-divmod-producer-to-src
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [src : String]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (let
    [lhs-reg : String
      (compiler-backend-value-scalar-register backend-state assignments lhs)]
    (match (compiler-backend-immediate-operand backend-state rhs)
      [(CompilerBackendMaybeImmediate.Some imm)
        (match op
          [(compiler_ir_types.CompilerIrBinOp.Add)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (str_cat.str-cat
                  "    leaq "
                  (string.substring imm 1 (- (string.string-length imm) 1))
                  "("
                  lhs-reg)
                (str_cat.str-cat "), " src "\n")))]
          [(compiler_ir_types.CompilerIrBinOp.Mul)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (str_cat.str-cat "    imulq " imm ", " lhs-reg)
                (str_cat.str-cat ", " src "\n")))]
          [(compiler_ir_types.CompilerIrBinOp.BitXor)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (compiler-backend-divmod-result-move lhs-reg src)
                (str_cat.str-cat "    xorq " imm ", " src "\n")))]
          [_
            (ResultCompilerBackend.Err
              (box
                (compiler_diagnostic.compiler-diagnostic-at-start
                  ""
                  "backend: non-retargetable divmod producer")))])]
      [(CompilerBackendMaybeImmediate.No)
        (let
          [rhs-reg : String
            (compiler-backend-value-scalar-register
              backend-state
              assignments
              rhs)]
          (match op
            [(compiler_ir_types.CompilerIrBinOp.Add)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  (str_cat.str-cat
                    "    leaq ("
                    (if (string.eq lhs-reg "%rbp")
                      rhs-reg
                      lhs-reg)
                    ","
                    (if (string.eq lhs-reg "%rbp")
                      lhs-reg
                      rhs-reg))
                  (str_cat.str-cat "), " src "\n")))]
            [(compiler_ir_types.CompilerIrBinOp.Mul)
              (ResultCompilerBackend.Ok
                (if (string.eq src lhs-reg)
                  (str_cat.str-cat "    imulq " rhs-reg ", " src "\n")
                  (if (string.eq src rhs-reg)
                    (str_cat.str-cat "    imulq " lhs-reg ", " src "\n")
                    (str_cat.str-cat
                      (compiler-backend-divmod-result-move lhs-reg src)
                      (str_cat.str-cat "    imulq " rhs-reg ", " src "\n")))))]
            [(compiler_ir_types.CompilerIrBinOp.BitXor)
              (ResultCompilerBackend.Ok
                (if (string.eq src lhs-reg)
                  (str_cat.str-cat "    xorq " rhs-reg ", " src "\n")
                  (if (string.eq src rhs-reg)
                    (str_cat.str-cat "    xorq " lhs-reg ", " src "\n")
                    (str_cat.str-cat
                      (compiler-backend-divmod-result-move lhs-reg src)
                      (str_cat.str-cat "    xorq " rhs-reg ", " src "\n")))))]
            [_
              (ResultCompilerBackend.Err
                (box
                  (compiler_diagnostic.compiler-diagnostic-at-start
                    ""
                    "backend: non-retargetable divmod producer")))]))])))

(define (compiler-backend-divmod-producer-feeds?
  [ctx : CompilerBackendEmissionContext]
  [producer-dst : i64]
  [producer-op : compiler_ir_types.CompilerIrBinOp]
  [producer-lhs : compiler_ir_types.CompilerIrValue]
  [producer-rhs : compiler_ir_types.CompilerIrValue]
  [producer-ty : compiler_ast_types.AstType]
  [div-op : compiler_ir_types.CompilerIrBinOp]
  [div-lhs : compiler_ir_types.CompilerIrValue]
  [div-rhs : compiler_ir_types.CompilerIrValue]
  [div-ty : compiler_ast_types.AstType]) : bool
  (and
    (compiler-backend-var-single-use? ctx.use-counts producer-dst)
    (compiler-backend-divmod-producer-retargetable?
      ctx.type-segment-bases
      ctx.assignments
      producer-dst
      producer-op
      producer-lhs
      producer-rhs
      producer-ty
      ctx.backend-state)
    (compiler-backend-branch-uses-var? div-lhs producer-dst)
    (compiler-backend-signed-literal-divmod-src-shape?
      ctx.type-segment-bases
      div-op
      div-rhs
      div-ty)))

;; The existing Gep+StorePtr fusion accepts the stored scalar in any GP
;; register when its address is already directly encodable.  Requiring that
;; direct address shape keeps SRC out of all later planned address scratches.
(define (compiler-backend-divmod-direct-gep-store?
  [backend-state : CompilerBackendState]
  [type-segment-bases : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [result-dst : i64]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [store-ptr : compiler_ir_types.CompilerIrValue]
  [store-value : compiler_ir_types.CompilerIrValue]) : bool
  (and
    (compiler-backend-branch-uses-var? store-ptr gep-dst)
    (compiler-backend-branch-uses-var? store-value result-dst)
    (match (compiler-backend-value-as-i64 offset)
      [(option_i64.Some _)
        (not
          (string.eq
            (compiler-backend-value-register-home
              backend-state
              assignments
              base)
            ""))]
      [(option_i64.None)
        (let
          [base-home : String
            (compiler-backend-address-base-filter
              (compiler-backend-value-scalar-register
                backend-state
                assignments
                base))]
          [offset-home : String
            (compiler-backend-value-scalar-register
              backend-state
              assignments
              offset)]
          (and
            (not (string.eq base-home ""))
            (not (string.eq offset-home ""))
            (not
              (string.eq
                (compiler-backend-gep-index-address-disp
                  0
                  base-home
                  (compiler-backend-type-size type-segment-bases elem-ty)
                  offset-home)
                ""))))])))

;; A direct Gep+StorePtr remains inside the divmod emergency-save region, so
;; every address input must survive the complete expansion.  Compare physical
;; register homes against the expansion's full write set: fixed %rax/%rdx, the
;; selected dividend/result SRC, and the materialised magic/mask register (when
;; one is needed).  A rejected store resumes at Gep after the emergency restores.
(define (compiler-backend-divmod-direct-gep-store-clobber-safe?
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [src : String]
  [magic : String]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]) : bool
  (let
    [base-home : String
      (match (compiler-backend-value-as-i64 offset)
        [(option_i64.Some _)
          (compiler-backend-value-register-home backend-state assignments base)]
        [(option_i64.None)
          (compiler-backend-address-base-filter
            (compiler-backend-value-scalar-register
              backend-state
              assignments
              base))])]
    [offset-home : String
      (match (compiler-backend-value-as-i64 offset)
        [(option_i64.Some _) ""]
        [(option_i64.None)
          (compiler-backend-value-scalar-register
            backend-state
            assignments
            offset)])]
    [address-mask : i64
      (bit-or
        (compiler-backend-scavenge-reg-bit base-home)
        (compiler-backend-scavenge-reg-bit offset-home))]
    [clobber-mask : i64
      (bit-or
        (bit-or
          (compiler-backend-scavenge-reg-bit "%rax")
          (compiler-backend-scavenge-reg-bit "%rdx"))
        (bit-or
          (compiler-backend-scavenge-reg-bit src)
          (compiler-backend-scavenge-reg-bit magic)))]
    (= (bit-and address-mask clobber-mask) 0)))

;; The divmod emitter can discover an emergency scratch after the polish SRC
;; has been selected.  Restore any borrowed address input before the fused
;; store reads it; other borrowed registers (including SRC) remain protected
;; until the bundle's ordinary trailing restore.
(define (compiler-backend-divmod-address-emergency-restore-asm
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [src : String]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [index : i64]
  [backend-state : CompilerBackendState]) : String
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    (if (>=
      index
      (compiler-backend-function-scratch-i64
        function-state
        compiler-backend-scratch-i64-emergency-pending-count))
      ""
      (let
        [reg : i64
          (array-ref
            (compiler-backend-function-scratch-i64-array
              function-state
              compiler-backend-scratch-i64-array-emergency-regs)
            index)]
        [base-home : String
          (compiler-backend-value-scalar-register
            backend-state
            assignments
            base)]
        [offset-home : String
          (match (compiler-backend-value-as-i64 offset)
            [(option_i64.Some _) ""]
            [(option_i64.None)
              (compiler-backend-value-scalar-register
                backend-state
                assignments
                offset)])]
        (str_cat.str-cat
          (if (and
            (not
              (= reg (compiler_abi.compiler-abi-register-id-from-spelling src)))
            (or
              (=
                reg
                (compiler_abi.compiler-abi-register-id-from-spelling base-home))
              (=
                reg
                (compiler_abi.compiler-abi-register-id-from-spelling
                  offset-home))))
            (compiler-backend-emergency-reg-restore-asm
              reg
              (compiler-backend-emergency-reg-offset function-state index)
              backend-state)
            "")
          (compiler-backend-divmod-address-emergency-restore-asm
            assignments
            src
            base
            offset
            (+ index 1)
            backend-state))))))

;; Select the same SRC class as the ordinary divmod emitter.  At a divmod site
;; a dead non-fixed dividend home wins; otherwise a suitable result home wins,
;; then the planned SRC.  The producer fold calls with allow-own=false because
;; its dividend is still being defined at the current point.  The final
;; scavenger fallback queries a forward occupancy window, so an emergency pick
;; is preserved around the complete fused bundle below.
(define (compiler-backend-divmod-polish-src
  [ctx : CompilerBackendEmissionContext]
  [dst : i64]
  [lhs : compiler_ir_types.CompilerIrValue]
  [magic : String]
  [hoist-reg : String]
  [planned-src : String]
  [allow-own : bool]
  [want-remainder? : bool]
  [scavenge-dst : i64]) : String
  (let
    [lhs-home : String
      (compiler-backend-value-scalar-register
        ctx.backend-state
        ctx.assignments
        lhs)]
    [dst-home : String
      (compiler-backend-var-register-home ctx.backend-state ctx.assignments dst)]
    [own-src? : bool
      (and
        allow-own
        (compiler-backend-divmod-src-register? lhs-home)
        (not (string.eq lhs-home magic))
        (not (string.eq lhs-home hoist-reg))
        (not (compiler-backend-value-live-after-here? ctx.backend-state lhs))
        (compiler-backend-divmod-src-home-safe?
          ctx.backend-state
          want-remainder?
          lhs-home
          dst-home))]
    [dst-src? : bool
      (and
        (not own-src?)
        (compiler-backend-divmod-src-register? dst-home)
        (not (string.eq dst-home magic))
        (not (string.eq dst-home hoist-reg))
        (not (string.eq dst-home lhs-home)))]
    [src-exclude : (__tl_dyn-array String)
      (compiler-backend-divmod-dividend-exclude magic)]
    (cond
      [own-src? lhs-home]
      [dst-src? dst-home]
      [(compiler-backend-divmod-src-register? planned-src) planned-src]
      [else
        (compiler-backend-scavenge-divmod-src-reg
          scavenge-dst
          (if (string.eq hoist-reg "")
            src-exclude
            (compiler-backend-scavenge-exclude-append src-exclude 5 hoist-reg))
          (if (string.eq hoist-reg "")
            5
            6)
          ctx.backend-state)])))

;; Resolve the materialisation register with the same point, exclusions, and
;; fallback as emit-signed-literal-divmod-dst-with-plan, but without reserving an
;; emergency slot.  Admission needs the exact physical write set before deciding
;; whether a following direct store can remain inside the divmod save region.
(define (compiler-backend-divmod-polish-magic-here
  [_ctx : CompilerBackendEmissionContext]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [planned-magic : String]) : String
  (let
    [hoist : CompilerBackendConstHoistHome
      (compiler-backend-const-hoist-here _ctx.function-state)]
    [hoist-reg : String (compiler-backend-magic-home-reg-name hoist)]
    (if (compiler-backend-signed-literal-divmod-needs-material-reg?
      rhs
      ty
      (compiler-backend-binop-wants-remainder? op)
      hoist)
      (if (string.eq planned-magic "")
        (compiler-backend-scavenge-reg-peek
          dst
          (if (string.eq hoist-reg "")
            (compiler-backend-binop-scavenge-exclude-for-op op)
            (compiler-backend-scavenge-exclude-append
              (compiler-backend-binop-scavenge-exclude-for-op op)
              5
              hoist-reg))
          (if (string.eq hoist-reg "")
            5
            6)
          "%r8"
          _ctx.backend-state)
        planned-magic)
      "")))

(define (compiler-backend-divmod-polish-magic-ahead
  [ctx : CompilerBackendEmissionContext]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instruction-offset : i64]
  [planned-magic : String]) : String
  (let
    [saved-count : i64
      (compiler-backend-function-state-emit-current-count ctx.function-state)]
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [_position : unit
      (begin
        (compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          (- saved-count instruction-offset))
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          (compiler-backend-instr-reserved-home-mask
            ctx.function-state
            div-instr)))]
    [magic : String
      (compiler-backend-divmod-polish-magic-here
        ctx
        dst
        op
        rhs
        ty
        planned-magic)]
    [_restore : unit
      (begin
        (compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          saved-count)
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          saved-reserved))]
    magic))

;; The resident loop-hoisted magic is a read-only input rather than a clobber,
;; but SRC must still avoid it exactly as the ordinary divmod emitter does.
;; Resolve it at the divmod instruction rather than the earlier fused producer.
(define (compiler-backend-divmod-polish-hoist-reg-ahead
  [ctx : CompilerBackendEmissionContext]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [instruction-offset : i64]) : String
  (let
    [saved-count : i64
      (compiler-backend-function-state-emit-current-count ctx.function-state)]
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [_position : unit
      (begin
        (compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          (- saved-count instruction-offset))
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          (compiler-backend-instr-reserved-home-mask
            ctx.function-state
            div-instr)))]
    [hoist-reg : String
      (compiler-backend-magic-home-reg-name
        (compiler-backend-const-hoist-here ctx.function-state))]
    [_restore : unit
      (begin
        (compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          saved-count)
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          saved-reserved))]
    hoist-reg))

(define (compiler-backend-divmod-overrides-install!
  [function-state : CompilerBackendFunctionState]
  [first-var : i64]
  [first-reg : i64]
  [second-var : i64]
  [second-reg : i64]) : unit
  (begin
    (compiler-backend-function-state-set-i64!
      function-state
      compiler-backend-function-i64-home-override0-var
      first-var)
    (compiler-backend-function-state-set-i64!
      function-state
      compiler-backend-function-i64-home-override0-reg
      first-reg)
    (compiler-backend-function-state-set-i64!
      function-state
      compiler-backend-function-i64-home-override1-var
      second-var)
    (compiler-backend-function-state-set-i64!
      function-state
      compiler-backend-function-i64-home-override1-reg
      second-reg)))

(define (compiler-backend-divmod-overrides-install-spellings!
  [function-state : CompilerBackendFunctionState]
  [first-var : i64]
  [first-reg : String]
  [second-var : i64]
  [second-reg : String]) : unit
  (compiler-backend-divmod-overrides-install!
    function-state
    first-var
    (compiler_abi.compiler-abi-register-id-from-spelling first-reg)
    second-var
    (compiler_abi.compiler-abi-register-id-from-spelling second-reg)))

;; Emit a Gep+StorePtr as the already-existing direct fused store, but return
;; only its assembly so the surrounding divmod bundle can own one emergency
;; save/restore region.
(define (compiler-backend-emit-divmod-direct-gep-store
  [ctx : CompilerBackendEmissionContext]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [value : compiler_ir_types.CompilerIrValue]
  [store-ty : compiler_ast_types.AstType]) : ResultCompilerBackend
  (let
    [_reserved : unit
      (compiler-backend-set-current-instr-reserved-mask!
        ctx.function-state
        (compiler-backend-instr-reserved-home-mask
          ctx.function-state
          (compiler_ir_types.CompilerIrInstr.Gep gep-dst base offset elem-ty)))]
    [gep-disp : i64
      (compiler-backend-gep-fold-next!
        ctx.function-state
        ctx.type-segment-bases
        offset
        elem-ty)]
    (compiler-backend-emit-store-to-gep
      ctx.type-segment-bases
      ctx.assignments
      base
      offset
      elem-ty
      value
      store-ty
      ctx.program-index
      gep-disp
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        0
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        1
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        1
        1
        ctx.backend-state)
      ctx.backend-state)))

(define (compiler-backend-emit-divmod-polish-continue
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [result : ResultCompilerBackend]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match result
    [(ResultCompilerBackend.Ok asm)
      (begin
        (compiler-backend-asm-append
          out
          (compiler-backend-emergency-wrap asm ctx.backend-state))
        (compiler-backend-emit-instrs ctx fallthrough instrs index out))]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-divmod-result-gep-store-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [div-dst : i64]
  [src : String]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [store-value : compiler_ir_types.CompilerIrValue]
  [store-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [saved-count : i64
      (compiler-backend-function-state-emit-current-count ctx.function-state)]
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [saved0-var : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override0-var)]
    [saved0-reg : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override0-reg)]
    [saved1-var : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override1-var)]
    [saved1-reg : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override1-reg)]
    [result : ResultCompilerBackend
      (begin
        ;; `src` can be the divmod instruction's preserved planned ordinal.
        ;; The polish probe only peeks at it; consume it once the fused result
        ;; store has committed so the wrapper owns the whole bundle.
        (compiler-backend-preserve-planned-register! src ctx.backend-state)
        (compiler-backend-divmod-overrides-install-spellings!
          ctx.function-state
          div-dst
          src
          -1
          "")
        (match (compiler-backend-emit-instr
          ctx
          (CompilerBackendMaybeLabel.No)
          div-instr)
          [(ResultCompilerBackend.Ok div-asm)
            (begin
              (compiler-backend-function-state-set-emit-current-count!
                ctx.function-state
                (- saved-count 1))
              (let
                [address-restore : String
                  (compiler-backend-divmod-address-emergency-restore-asm
                    ctx.assignments
                    src
                    base
                    offset
                    0
                    ctx.backend-state)]
                (match (compiler-backend-emit-divmod-direct-gep-store
                  ctx
                  gep-dst
                  base
                  offset
                  elem-ty
                  store-value
                  store-ty)
                  [(ResultCompilerBackend.Ok store-asm)
                    (ResultCompilerBackend.Ok
                      (str_cat.str-cat div-asm address-restore store-asm))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)]))]
    [_restore : unit
      (begin
        (compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          saved-count)
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          saved-reserved)
        (compiler-backend-divmod-overrides-install!
          ctx.function-state
          saved0-var
          saved0-reg
          saved1-var
          saved1-reg))]
    (compiler-backend-emit-divmod-polish-continue
      ctx
      fallthrough
      result
      instrs
      index
      out)))

(define (compiler-backend-emit-steered-producer-divmod-plain-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [producer-instr : compiler_ir_types.CompilerIrInstr]
  [producer-dst : i64]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [src : String]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [saved-count : i64
      (compiler-backend-function-state-emit-current-count ctx.function-state)]
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [saved0-var : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override0-var)]
    [saved0-reg : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override0-reg)]
    [saved1-var : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override1-var)]
    [saved1-reg : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override1-reg)]
    [result : ResultCompilerBackend
      (begin
        ;; Producer steering writes `src` before the ordinary divmod emitter
        ;; gets a chance to consume its planned ordinal. Arm preservation here
        ;; and let the bundle wrapper restore the live-through resident.
        (compiler-backend-preserve-planned-register! src ctx.backend-state)
        (compiler-backend-divmod-overrides-install-spellings!
          ctx.function-state
          producer-dst
          src
          -1
          "")
        (match (match producer-instr
          [(compiler_ir_types.CompilerIrInstr.BinOp _ op lhs rhs _)
            (compiler-backend-emit-divmod-producer-to-src
              ctx.assignments
              op
              lhs
              rhs
              src
              ctx.backend-state)]
          [_
            (ResultCompilerBackend.Err
              (box
                (compiler_diagnostic.compiler-diagnostic-at-start
                  ""
                  "backend: non-retargetable divmod producer")))])
          [(ResultCompilerBackend.Ok producer-asm)
            (begin
              (compiler-backend-function-state-set-emit-current-count!
                ctx.function-state
                (- saved-count 1))
              (match (compiler-backend-emit-instr
                ctx
                (CompilerBackendMaybeLabel.No)
                div-instr)
                [(ResultCompilerBackend.Ok div-asm)
                  (ResultCompilerBackend.Ok
                    (str_cat.str-cat producer-asm div-asm))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)]))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)]))]
    [_restore : unit
      (begin
        (compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          saved-count)
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          saved-reserved)
        (compiler-backend-divmod-overrides-install!
          ctx.function-state
          saved0-var
          saved0-reg
          saved1-var
          saved1-reg))]
    (compiler-backend-emit-divmod-polish-continue
      ctx
      fallthrough
      result
      instrs
      index
      out)))

(define (compiler-backend-emit-steered-producer-divmod-gep-store-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [producer-instr : compiler_ir_types.CompilerIrInstr]
  [producer-dst : i64]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [div-dst : i64]
  [src : String]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [store-value : compiler_ir_types.CompilerIrValue]
  [store-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [saved-count : i64
      (compiler-backend-function-state-emit-current-count ctx.function-state)]
    [saved-reserved : i64
      (compiler-backend-current-instr-reserved-mask ctx.function-state)]
    [saved0-var : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override0-var)]
    [saved0-reg : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override0-reg)]
    [saved1-var : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override1-var)]
    [saved1-reg : i64
      (compiler-backend-function-state-i64
        ctx.function-state
        compiler-backend-function-i64-home-override1-reg)]
    [result : ResultCompilerBackend
      (begin
        ;; As above, the steered producer is the first write to the planned
        ;; dividend register. Preserve it across producer+divmod+store as one
        ;; atomic fused region.
        (compiler-backend-preserve-planned-register! src ctx.backend-state)
        (compiler-backend-divmod-overrides-install-spellings!
          ctx.function-state
          producer-dst
          src
          div-dst
          src)
        (match (match producer-instr
          [(compiler_ir_types.CompilerIrInstr.BinOp _ op lhs rhs _)
            (compiler-backend-emit-divmod-producer-to-src
              ctx.assignments
              op
              lhs
              rhs
              src
              ctx.backend-state)]
          [_
            (ResultCompilerBackend.Err
              (box
                (compiler_diagnostic.compiler-diagnostic-at-start
                  ""
                  "backend: non-retargetable divmod producer")))])
          [(ResultCompilerBackend.Ok producer-asm)
            (begin
              (compiler-backend-function-state-set-emit-current-count!
                ctx.function-state
                (- saved-count 1))
              (match (compiler-backend-emit-instr
                ctx
                (CompilerBackendMaybeLabel.No)
                div-instr)
                [(ResultCompilerBackend.Ok div-asm)
                  (begin
                    (compiler-backend-function-state-set-emit-current-count!
                      ctx.function-state
                      (- saved-count 2))
                    (let
                      [address-restore : String
                        (compiler-backend-divmod-address-emergency-restore-asm
                          ctx.assignments
                          src
                          base
                          offset
                          0
                          ctx.backend-state)]
                      (match (compiler-backend-emit-divmod-direct-gep-store
                        ctx
                        gep-dst
                        base
                        offset
                        elem-ty
                        store-value
                        store-ty)
                        [(ResultCompilerBackend.Ok store-asm)
                          (ResultCompilerBackend.Ok
                            (str_cat.str-cat
                              producer-asm
                              div-asm
                              address-restore
                              store-asm))]
                        [(ResultCompilerBackend.Err message)
                          (ResultCompilerBackend.Err message)])))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)]))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)]))]
    [_restore : unit
      (begin
        (compiler-backend-function-state-set-emit-current-count!
          ctx.function-state
          saved-count)
        (compiler-backend-set-current-instr-reserved-mask!
          ctx.function-state
          saved-reserved)
        (compiler-backend-divmod-overrides-install!
          ctx.function-state
          saved0-var
          saved0-reg
          saved1-var
          saved1-reg))]
    (compiler-backend-emit-divmod-polish-continue
      ctx
      fallthrough
      result
      instrs
      index
      out)))

(define (compiler-backend-emit-steered-producer-divmod-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [producer-instr : compiler_ir_types.CompilerIrInstr]
  [producer-dst : i64]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [div-dst : i64]
  [src : String]
  [magic : String]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (compiler-backend-var-single-use? ctx.use-counts div-dst)
    (if (< index instrs.len)
      (let
        [maybe-gep : compiler_ir_types.CompilerIrInstr
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
        [after-gep : i64 (+ index 1)]
        (match maybe-gep
          [(compiler_ir_types.CompilerIrInstr.Gep gep-dst base offset elem-ty)
            (if (compiler-backend-var-single-use? ctx.use-counts gep-dst)
              (if (< after-gep instrs.len)
                (let
                  [maybe-store : compiler_ir_types.CompilerIrInstr
                    (compiler_ir_types.compiler-ir-instr-seq-ref
                      instrs
                      after-gep)]
                  [after-store : i64 (+ after-gep 1)]
                  (match maybe-store
                    [(compiler_ir_types.CompilerIrInstr.StorePtr
                        store-ptr
                        store-value
                        store-ty)
                      (if (and
                        (compiler-backend-divmod-direct-gep-store?
                          ctx.backend-state
                          ctx.type-segment-bases
                          ctx.assignments
                          div-dst
                          gep-dst
                          base
                          offset
                          elem-ty
                          store-ptr
                          store-value)
                        (compiler-backend-divmod-direct-gep-store-clobber-safe?
                          ctx.backend-state
                          ctx.assignments
                          src
                          magic
                          base
                          offset))
                        (compiler-backend-emit-steered-producer-divmod-gep-store-rest
                          ctx
                          fallthrough
                          producer-instr
                          producer-dst
                          div-instr
                          div-dst
                          src
                          gep-dst
                          base
                          offset
                          elem-ty
                          store-value
                          store-ty
                          instrs
                          after-store
                          out)
                        (compiler-backend-emit-steered-producer-divmod-plain-rest
                          ctx
                          fallthrough
                          producer-instr
                          producer-dst
                          div-instr
                          src
                          instrs
                          index
                          out))]
                    [_
                      (compiler-backend-emit-steered-producer-divmod-plain-rest
                        ctx
                        fallthrough
                        producer-instr
                        producer-dst
                        div-instr
                        src
                        instrs
                        index
                        out)]))
                (compiler-backend-emit-steered-producer-divmod-plain-rest
                  ctx
                  fallthrough
                  producer-instr
                  producer-dst
                  div-instr
                  src
                  instrs
                  index
                  out))
              (compiler-backend-emit-steered-producer-divmod-plain-rest
                ctx
                fallthrough
                producer-instr
                producer-dst
                div-instr
                src
                instrs
                index
                out))]
          [_
            (compiler-backend-emit-steered-producer-divmod-plain-rest
              ctx
              fallthrough
              producer-instr
              producer-dst
              div-instr
              src
              instrs
              index
              out)]))
      (compiler-backend-emit-steered-producer-divmod-plain-rest
        ctx
        fallthrough
        producer-instr
        producer-dst
        div-instr
        src
        instrs
        index
        out))
    (compiler-backend-emit-steered-producer-divmod-plain-rest
      ctx
      fallthrough
      producer-instr
      producer-dst
      div-instr
      src
      instrs
      index
      out)))

(define (compiler-backend-try-divmod-result-gep-store
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [div-instr : compiler_ir_types.CompilerIrInstr]
  [div-dst : i64]
  [div-op : compiler_ir_types.CompilerIrBinOp]
  [div-lhs : compiler_ir_types.CompilerIrValue]
  [div-rhs : compiler_ir_types.CompilerIrValue]
  [div-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeDivmodPolish
  (if (and
    (compiler-backend-var-single-use? ctx.use-counts div-dst)
    (compiler-backend-signed-literal-divmod-src-shape?
      ctx.type-segment-bases
      div-op
      div-rhs
      div-ty))
    (if (< index instrs.len)
      (let
        [maybe-gep : compiler_ir_types.CompilerIrInstr
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
        [after-gep : i64 (+ index 1)]
        (match maybe-gep
          [(compiler_ir_types.CompilerIrInstr.Gep gep-dst base offset elem-ty)
            (if (compiler-backend-var-single-use? ctx.use-counts gep-dst)
              (if (< after-gep instrs.len)
                (let
                  [maybe-store : compiler_ir_types.CompilerIrInstr
                    (compiler_ir_types.compiler-ir-instr-seq-ref
                      instrs
                      after-gep)]
                  [after-store : i64 (+ after-gep 1)]
                  (match maybe-store
                    [(compiler_ir_types.CompilerIrInstr.StorePtr
                        store-ptr
                        store-value
                        store-ty)
                      (if (compiler-backend-divmod-direct-gep-store?
                        ctx.backend-state
                        ctx.type-segment-bases
                        ctx.assignments
                        div-dst
                        gep-dst
                        base
                        offset
                        elem-ty
                        store-ptr
                        store-value)
                        (let
                          [_reserved : unit
                            (compiler-backend-set-current-instr-reserved-mask!
                              ctx.function-state
                              (compiler-backend-instr-reserved-home-mask
                                ctx.function-state
                                div-instr))]
                          [planned-magic : String
                            (compiler-backend-scratch-plan-register-ahead
                              (compiler-backend-runtime-plan-scratch ctx.plan)
                              0
                              2
                              ctx.backend-state)]
                          [magic : String
                            (compiler-backend-divmod-polish-magic-ahead
                              ctx
                              div-instr
                              div-dst
                              div-op
                              div-rhs
                              div-ty
                              0
                              planned-magic)]
                          [hoist-reg : String
                            (compiler-backend-divmod-polish-hoist-reg-ahead
                              ctx
                              div-instr
                              0)]
                          [src : String
                            (compiler-backend-divmod-polish-src
                              ctx
                              div-dst
                              div-lhs
                              magic
                              hoist-reg
                              (compiler-backend-scratch-plan-register-ahead
                                (compiler-backend-runtime-plan-scratch ctx.plan)
                                0
                                3
                                ctx.backend-state)
                              true
                              (compiler-backend-binop-wants-remainder? div-op)
                              div-dst)]
                          (if (compiler-backend-divmod-direct-gep-store-clobber-safe?
                            ctx.backend-state
                            ctx.assignments
                            src
                            magic
                            base
                            offset)
                            (CompilerBackendMaybeDivmodPolish.Some
                              (compiler-backend-emit-divmod-result-gep-store-rest
                                ctx
                                fallthrough
                                div-instr
                                div-dst
                                src
                                gep-dst
                                base
                                offset
                                elem-ty
                                store-value
                                store-ty
                                instrs
                                after-store
                                out))
                            (CompilerBackendMaybeDivmodPolish.No)))
                        (CompilerBackendMaybeDivmodPolish.No))]
                    [_ (CompilerBackendMaybeDivmodPolish.No)]))
                (CompilerBackendMaybeDivmodPolish.No))
              (CompilerBackendMaybeDivmodPolish.No))]
          [_ (CompilerBackendMaybeDivmodPolish.No)]))
      (CompilerBackendMaybeDivmodPolish.No))
    (CompilerBackendMaybeDivmodPolish.No)))

(define (compiler-backend-try-divmod-polish
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeDivmodPolish
  (match instr
    [(compiler_ir_types.CompilerIrInstr.BinOp
        producer-dst
        producer-op
        producer-lhs
        producer-rhs
        producer-ty)
      (if (< index instrs.len)
        (let
          [next : compiler_ir_types.CompilerIrInstr
            (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
          [after-div : i64 (+ index 1)]
          (match next
            [(compiler_ir_types.CompilerIrInstr.BinOp
                div-dst
                div-op
                div-lhs
                div-rhs
                div-ty)
              (if (compiler-backend-divmod-producer-feeds?
                ctx
                producer-dst
                producer-op
                producer-lhs
                producer-rhs
                producer-ty
                div-op
                div-lhs
                div-rhs
                div-ty)
                (let
                  [_reserved : unit
                    (compiler-backend-set-current-instr-reserved-mask!
                      ctx.function-state
                      (compiler-backend-instr-reserved-home-mask
                        ctx.function-state
                        instr))]
                  [planned-magic : String
                    (compiler-backend-scratch-plan-register-ahead
                      (compiler-backend-runtime-plan-scratch ctx.plan)
                      1
                      2
                      ctx.backend-state)]
                  [magic : String
                    (compiler-backend-divmod-polish-magic-ahead
                      ctx
                      next
                      div-dst
                      div-op
                      div-rhs
                      div-ty
                      1
                      planned-magic)]
                  [hoist-reg : String
                    (compiler-backend-divmod-polish-hoist-reg-ahead ctx next 1)]
                  [src : String
                    (compiler-backend-divmod-polish-src
                      ctx
                      div-dst
                      div-lhs
                      magic
                      hoist-reg
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        1
                        3
                        ctx.backend-state)
                      false
                      (compiler-backend-binop-wants-remainder? div-op)
                      producer-dst)]
                  (CompilerBackendMaybeDivmodPolish.Some
                    (compiler-backend-emit-steered-producer-divmod-rest
                      ctx
                      fallthrough
                      instr
                      producer-dst
                      next
                      div-dst
                      src
                      magic
                      instrs
                      after-div
                      out)))
                (compiler-backend-try-divmod-result-gep-store
                  ctx
                  fallthrough
                  instr
                  producer-dst
                  producer-op
                  producer-lhs
                  producer-rhs
                  producer-ty
                  instrs
                  index
                  out))]
            [_
              (compiler-backend-try-divmod-result-gep-store
                ctx
                fallthrough
                instr
                producer-dst
                producer-op
                producer-lhs
                producer-rhs
                producer-ty
                instrs
                index
                out)]))
        (compiler-backend-try-divmod-result-gep-store
          ctx
          fallthrough
          instr
          producer-dst
          producer-op
          producer-lhs
          producer-rhs
          producer-ty
          instrs
          index
          out))]
    [_ (CompilerBackendMaybeDivmodPolish.No)]))

(define (compiler-backend-emit-load-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [load-dst : i64]
  [ptr : compiler_ir_types.CompilerIrValue]
  [load-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (and
    (compiler-backend-load-compare-type? ctx.type-segment-bases load-ty)
    (compiler-backend-var-single-use? ctx.use-counts load-dst))
    (if (< index instrs.len)
      (let
        [next : compiler_ir_types.CompilerIrInstr
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
        [after-cmp : i64 (+ index 1)]
        (match next
          [(compiler_ir_types.CompilerIrInstr.Load
              second-dst
              second-src
              second-ty)
            (if (compiler-backend-branch-uses-var? second-src load-dst)
              (compiler-backend-emit-fused-result-rest
                ctx
                fallthrough
                (compiler-backend-emit-load-load
                  ctx.type-segment-bases
                  ctx.assignments
                  load-dst
                  ptr
                  load-ty
                  second-dst
                  second-ty
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0
                    0
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0
                    1
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    0
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    1
                    ctx.backend-state)
                  ctx.backend-state)
                instrs
                after-cmp
                out)
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                index
                out))]
          [(compiler_ir_types.CompilerIrInstr.BinOp cmp-dst op lhs rhs cmp-ty)
            (if (and
              (compiler-backend-compare-op? op)
              (compiler-backend-branch-uses-var? lhs load-dst)
              (compiler-backend-var-single-use? ctx.use-counts cmp-dst)
              (not
                (compiler-backend-binop-f64?
                  ctx.types
                  ctx.global-types
                  lhs
                  rhs
                  cmp-ty)))
              (if (< after-cmp instrs.len)
                (let
                  [branch : compiler_ir_types.CompilerIrInstr
                    (compiler_ir_types.compiler-ir-instr-seq-ref
                      instrs
                      after-cmp)]
                  [after-branch : i64 (+ after-cmp 1)]
                  (match (compiler_ir_types.compiler-ir-instr-scalar-fact
                    branch)
                    [(compiler_ir_types.CompilerIrInstrScalarFact.Branch
                        cond
                        true-label
                        false-label)
                      (if (compiler-backend-branch-uses-var? cond cmp-dst)
                        (compiler-backend-emit-fused-load-compare-branch-rest
                          ctx
                          fallthrough
                          load-dst
                          ptr
                          load-ty
                          cmp-dst
                          op
                          rhs
                          cmp-ty
                          true-label
                          false-label
                          instrs
                          after-branch
                          out)
                        (compiler-backend-emit-instrs-normal
                          ctx
                          fallthrough
                          instr
                          instrs
                          index
                          out))]
                    [_
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        instrs
                        index
                        out)]))
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out))
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                index
                out))]
          [_
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out)]))
      (compiler-backend-emit-instrs-normal
        ctx
        fallthrough
        instr
        instrs
        index
        out))
    (compiler-backend-emit-instrs-normal ctx fallthrough instr instrs index out)))

(define (compiler-backend-emit-store-ptr-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [ptr : compiler_ir_types.CompilerIrValue]
  [value0 : compiler_ir_types.CompilerIrValue]
  [ty0 : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [maybe-gep : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [after-gep : i64 (+ index 1)]
      (match maybe-gep
        [(compiler_ir_types.CompilerIrInstr.Gep gep-dst base offset elem-ty)
          (if (and
            (compiler_optimize.opt-value-eq base ptr)
            (compiler-backend-var-single-use? ctx.use-counts gep-dst))
            (match (compiler-backend-value-as-i64 offset)
              [(option_i64.Some n)
                (let
                  [disp : i64
                    (*
                      n
                      (compiler-backend-type-size
                        ctx.type-segment-bases
                        elem-ty))]
                  (if (compiler-backend-imm32? disp)
                    (if (< after-gep instrs.len)
                      (let
                        [maybe-store : compiler_ir_types.CompilerIrInstr
                          (compiler_ir_types.compiler-ir-instr-seq-ref
                            instrs
                            after-gep)]
                        [after-store : i64 (+ after-gep 1)]
                        (match maybe-store
                          [(compiler_ir_types.CompilerIrInstr.StorePtr
                              dst
                              value1
                              ty1)
                            (if (compiler-backend-branch-uses-var? dst gep-dst)
                              (compiler-backend-emit-fused-result-rest
                                ctx
                                fallthrough
                                (compiler-backend-emit-store-ptr-pair
                                  ctx.type-segment-bases
                                  ctx.assignments
                                  ptr
                                  value0
                                  ty0
                                  ;; GAP9: this pair ABSORBS the second store's
                                  ;; gep -- the walker resumes past it -- so its
                                  ;; ordinal must be consumed here or every later
                                  ;; gep in the function reads a shifted entry.
                                  ;; The admitted shape is a constant offset, for
                                  ;; which the pre-pass records displacement 0, so
                                  ;; the sum is the same spelling it always was.
                                  (+
                                    disp
                                    (compiler-backend-gep-fold-next!
                                      ctx.function-state
                                      ctx.type-segment-bases
                                      offset
                                      elem-ty))
                                  value1
                                  ty1
                                  ctx.program-index
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    1
                                    0
                                    ctx.backend-state)
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    0
                                    1
                                    ctx.backend-state)
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    2
                                    1
                                    ctx.backend-state)
                                  ctx.backend-state)
                                instrs
                                after-store
                                out)
                              (compiler-backend-emit-instrs-normal
                                ctx
                                fallthrough
                                instr
                                instrs
                                index
                                out))]
                          [_
                            (compiler-backend-emit-instrs-normal
                              ctx
                              fallthrough
                              instr
                              instrs
                              index
                              out)]))
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        instrs
                        index
                        out))
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      instrs
                      index
                      out)))]
              [(option_i64.None)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out)])
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out))]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out)]))
    (compiler-backend-emit-instrs-normal ctx fallthrough instr instrs index out)))

(define (compiler-backend-emit-vector-load-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [load-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [index : compiler_ir_types.CompilerIrValue]
  [lanes : i64]
  [elem-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [cursor : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (< cursor instrs.len)
    (let
      [next : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs cursor)]
      [after-binop : i64 (+ cursor 1)]
      (match next
        [(compiler_ir_types.CompilerIrInstr.VectorBinOp payload-box)
          (let
            [bin-dst (__tl-project-field (__tl-box-place payload-box) dst)]
            [op (__tl-project-field (__tl-box-place payload-box) op)]
            [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
            [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
            [bin-lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
            [bin-elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
            (if (compiler-backend-vector-load-binop-foldable?
              ctx.type-segment-bases
              ctx.use-counts
              load-dst
              lanes
              elem-ty
              op
              lhs
              rhs
              bin-lanes
              bin-elem-ty)
              (match (compiler-backend-vector-load-binop-fold-value
                load-dst
                op
                lhs
                rhs)
                [(CompilerBackendVectorMemFold.Some reg-value)
                  (compiler-backend-emit-fused-result-rest
                    ctx
                    fallthrough
                    (compiler-backend-emit-vector-binop-memory-source
                      ctx.type-segment-bases
                      ctx.assignments
                      bin-dst
                      op
                      reg-value
                      base
                      index
                      bin-lanes
                      bin-elem-ty
                      (compiler-backend-scratch-plan-register-here
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        0
                        ctx.backend-state)
                      (compiler-backend-scratch-plan-register-here
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        1
                        ctx.backend-state)
                      (compiler-backend-instr-diagnostic
                        ctx.spans
                        ctx.source-function
                        next
                        ctx.func-diag
                        "")
                      ctx.backend-state)
                    instrs
                    after-binop
                    out)]
                [(CompilerBackendVectorMemFold.No)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    cursor
                    out)])
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                cursor
                out)))]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            cursor
            out)]))
    (compiler-backend-emit-instrs-normal
      ctx
      fallthrough
      instr
      instrs
      cursor
      out)))

(define (compiler-backend-emit-copy-bytes-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : compiler_ir_types.CompilerIrValue]
  [src : compiler_ir_types.CompilerIrValue]
  [size : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [protect-n : i64
      (compiler-backend-copy-run-protect-count
        ctx.backend-state
        ctx.assignments
        instrs
        index)]
    [protect : (__tl_dyn-array String)
      (compiler-backend-copy-run-protect-exclude
        ctx.backend-state
        ctx.assignments
        instrs
        index)]
    (compiler-backend-emit-fused-result-rest
      ctx
      fallthrough
      (compiler-backend-emit-copy-bytes-avoid
        ctx.type-segment-bases
        ctx.assignments
        dst
        src
        size
        protect
        protect-n
        (compiler-backend-scratch-plan-register-ahead
          (compiler-backend-runtime-plan-scratch ctx.plan)
          0
          0
          ctx.backend-state)
        (compiler-backend-scratch-plan-register-ahead
          (compiler-backend-runtime-plan-scratch ctx.plan)
          0
          1
          ctx.backend-state)
        (compiler-backend-scratch-plan-register-ahead
          (compiler-backend-runtime-plan-scratch ctx.plan)
          0
          (if (>= size 16)
            3
            2)
          ctx.backend-state)
        (if (>= size 16)
          (compiler-backend-scratch-plan-register-ahead
            (compiler-backend-runtime-plan-scratch ctx.plan)
            0
            2
            ctx.backend-state)
          "")
        ctx.backend-state)
      instrs
      index
      out)))

(define (compiler-backend-emit-mov-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [next : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [after-jump : i64 (+ index 1)]
      (match next
        [(compiler_ir_types.CompilerIrInstr.Cast cast-dst cast-src _ _)
          (if (< after-jump instrs.len)
            (let
              [after-cast : compiler_ir_types.CompilerIrInstr
                (compiler_ir_types.compiler-ir-instr-seq-ref instrs after-jump)]
              [after-binop : i64 (+ after-jump 1)]
              (match after-cast
                [(compiler_ir_types.CompilerIrInstr.BinOp
                    bin-dst
                    op
                    lhs
                    rhs
                    bin-ty)
                  (if (and
                    (compiler-backend-divmod-op? op)
                    (compiler-backend-branch-uses-var? cast-src dst)
                    (compiler-backend-branch-uses-var? rhs cast-dst)
                    (compiler-backend-var-single-use? ctx.use-counts dst)
                    (compiler-backend-var-single-use? ctx.use-counts cast-dst)
                    (compiler-backend-divmod-safe-literal? src bin-ty))
                    (match (compiler-backend-emit-binop-with-plan
                      ctx.type-segment-bases
                      ctx.types
                      ctx.global-types
                      ctx.assignments
                      bin-dst
                      op
                      lhs
                      src
                      bin-ty
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        2
                        0
                        ctx.backend-state)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        2
                        1
                        ctx.backend-state)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        2
                        2
                        ctx.backend-state)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        2
                        3
                        ctx.backend-state)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        2
                        4
                        ctx.backend-state)
                      ctx.backend-state)
                      [(ResultCompilerBackend.Ok binop-asm)
                        (begin
                          (compiler-backend-emergency-append
                            out
                            binop-asm
                            ctx.backend-state)
                          (compiler-backend-emit-instrs
                            ctx
                            fallthrough
                            instrs
                            after-binop
                            out))]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err message)])
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      instrs
                      index
                      out))]
                [_
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out)]))
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out))]
        [(compiler_ir_types.CompilerIrInstr.BinOp bin-dst op lhs rhs bin-ty)
          (if (and
            (compiler-backend-divmod-op? op)
            (compiler-backend-branch-uses-var? rhs dst)
            (compiler-backend-divmod-safe-literal? src bin-ty))
            (match (if (compiler-backend-var-single-use? ctx.use-counts dst)
              (ResultCompilerBackend.Ok "")
              (compiler-backend-emit-mov
                ctx.type-segment-bases
                ctx.assignments
                dst
                src
                ty
                ctx.program-index
                ctx.vars
                ""
                ctx.backend-state))
              [(ResultCompilerBackend.Ok prefix)
                (match (compiler-backend-emit-binop-with-plan
                  ctx.type-segment-bases
                  ctx.types
                  ctx.global-types
                  ctx.assignments
                  bin-dst
                  op
                  lhs
                  src
                  bin-ty
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    0
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    1
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    2
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    3
                    ctx.backend-state)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    4
                    ctx.backend-state)
                  ctx.backend-state)
                  [(ResultCompilerBackend.Ok binop-asm)
                    (begin
                      (compiler-backend-emergency-append
                        out
                        (str_cat.str-cat prefix binop-asm)
                        ctx.backend-state)
                      (compiler-backend-emit-instrs
                        ctx
                        fallthrough
                        instrs
                        after-jump
                        out))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)])
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out))]
        [(compiler_ir_types.CompilerIrInstr.Jump target-label)
          (compiler-backend-emit-fused-mov-trivial-phi-return-rest
            ctx
            fallthrough
            dst
            src
            ty
            target-label
            instrs
            after-jump
            out)]
        [(compiler_ir_types.CompilerIrInstr.Return maybe)
          (if (< after-jump instrs.len)
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out)
            (match maybe
              [(compiler_ir_types.CompilerIrMaybeValue.Some value)
                (if (compiler-backend-branch-uses-var? value dst)
                  (match (compiler-backend-emit-return
                    ctx.type-segment-bases
                    ctx.source-function
                    ctx.blocks
                    (compiler_ir_types.CompilerIrMaybeValue.Some src)
                    ctx.assignments
                    ctx.vars
                    ctx.ret-ty
                    ctx.program-index)
                    [(ResultCompilerBackend.Ok asm)
                      (begin
                        (compiler-backend-emergency-append
                          out
                          asm
                          ctx.backend-state)
                        (ResultCompilerBackend.Ok ""))]
                    [(ResultCompilerBackend.Err message)
                      (ResultCompilerBackend.Err
                        (box
                          (compiler-backend-apply-instr-diagnostic
                            (__tl-box-place message)
                            (compiler-backend-instr-diagnostic
                              ctx.spans
                              ctx.source-function
                              instr
                              ctx.func-diag
                              ""))))])
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(compiler_ir_types.CompilerIrMaybeValue.No)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out)]))]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out)]))
    (compiler-backend-emit-instrs-normal ctx fallthrough instr instrs index out)))

(define (compiler-backend-emit-call-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [name : i64]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [next : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [after-return : i64 (+ index 1)]
      (match next
        [(compiler_ir_types.CompilerIrInstr.Return maybe)
          (if (< after-return instrs.len)
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              index
              out)
            (match maybe
              [(compiler_ir_types.CompilerIrMaybeValue.Some value)
                (if (and
                  (compiler-backend-branch-uses-var? value dst)
                  (not
                    (compiler-backend-stdlib-io-panic-name?
                      ctx.backend-state
                      name))
                  (compiler_optimize.opt-type-eq
                    ctx.type-segment-bases
                    ty
                    ctx.ret-ty))
                  (compiler-backend-emit-terminator-into
                    (compiler-backend-emit-call-return
                      ctx.type-segment-bases
                      ctx.target
                      ctx.source-function
                      ctx.blocks
                      name
                      args
                      ctx.assignments
                      (compiler-backend-scratch-plan-register-here
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        0
                        ctx.backend-state)
                      ctx.types
                      ctx.global-types
                      ctx.vars
                      ctx.plan
                      ctx.functions
                      ctx.externs
                      ctx.program-index
                      (compiler-backend-instr-diagnostic
                        ctx.spans
                        ctx.source-function
                        instr
                        ctx.func-diag
                        ""))
                    out
                    ctx.backend-state)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(compiler_ir_types.CompilerIrMaybeValue.No)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out)]))]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out)]))
    (compiler-backend-emit-instrs-normal ctx fallthrough instr instrs index out)))

;; CopyBytes whose SOURCE is the gep element (the mirror of the copy-dst rule
;; beside every caller). Fuses when the source spelling admits -- a SIB
;; base+index for a variable gep index, the base home for a constant one (whose
;; displacement is admitted through a static bound, never by reading the GAP9
;; entry) -- so the chunk loads address the element directly and the `leaq` that
;; materialized it disappears. A declined spelling falls through to ordinary
;; emission, which consumes the GAP9 gep ordinal itself; the admission test never
;; reads that ordinal, so exactly one side consumes it on every path.
(define (compiler-backend-emit-gep-copy-src-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [copy-dst : compiler_ir_types.CompilerIrValue]
  [copy-src : compiler_ir_types.CompilerIrValue]
  [copy-size : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [after-gep : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [spelling : String
      (if (compiler-backend-branch-uses-var? copy-src gep-dst)
        (compiler-backend-copy-gep-element-spelling
          ctx.backend-state
          ctx.type-segment-bases
          ctx.assignments
          base
          offset
          elem-ty
          copy-size)
        "")]
    (if (string.eq spelling "")
      (compiler-backend-emit-instrs-normal
        ctx
        fallthrough
        instr
        instrs
        index
        out)
      (let
        [protect-n : i64
          (compiler-backend-copy-run-protect-count
            ctx.backend-state
            ctx.assignments
            instrs
            after-gep)]
        [protect : (__tl_dyn-array String)
          (compiler-backend-copy-run-protect-exclude
            ctx.backend-state
            ctx.assignments
            instrs
            after-gep)]
        ;; A dynamic index carries no constant part, so the whole starting
        ;; displacement is the GAP9 fold; a constant index carries `n * scale`
        ;; and the fold contributes 0. The ordinal is consumed exactly once
        ;; here, only on the admitted path.
        [src-disp : i64
          (+
            (compiler-backend-gep-const-element-disp
              ctx.type-segment-bases
              offset
              elem-ty)
            (compiler-backend-gep-fold-next!
              ctx.function-state
              ctx.type-segment-bases
              offset
              elem-ty))]
        (compiler-backend-emit-fused-result-rest
          ctx
          fallthrough
          (compiler-backend-emit-copy-bytes-gep-src
            ctx.type-segment-bases
            ctx.assignments
            copy-dst
            base
            offset
            spelling
            src-disp
            copy-size
            protect
            protect-n
            (compiler-backend-scratch-plan-register-ahead
              (compiler-backend-runtime-plan-scratch ctx.plan)
              0
              0
              ctx.backend-state)
            (compiler-backend-scratch-plan-register-ahead
              (compiler-backend-runtime-plan-scratch ctx.plan)
              1
              (if (>= copy-size 16)
                3
                2)
              ctx.backend-state)
            (if (>= copy-size 16)
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                1
                2
                ctx.backend-state)
              "")
            ctx.backend-state)
          instrs
          after-gep
          out)))))

;; The `Gep` fusion cluster of `compiler-backend-emit-instrs-step`, extracted
;; unchanged (refs #5177). It is the peephole family that folds a single-use
;; address computation into the instruction that consumes it -- load, store,
;; copy, binop and the branch forms behind them -- so it is one cluster and
;; moves as one, matching the `mov`/`call`/`store-ptr` steps already split out.
(define (compiler-backend-emit-gep-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [gep-dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (compiler-backend-var-single-use? ctx.use-counts gep-dst)
    (match (compiler-backend-value-as-i64 offset)
      [(option_i64.Some n)
        (if (< index instrs.len)
          (let
            [next : compiler_ir_types.CompilerIrInstr
              (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
            [after-load : i64 (+ index 1)]
            (match next
              [(compiler_ir_types.CompilerIrInstr.Load load-dst src load-ty)
                (if (compiler-backend-branch-uses-var? src gep-dst)
                  (if (and
                    (compiler-backend-load-compare-type?
                      ctx.type-segment-bases
                      load-ty)
                    (compiler-backend-var-single-use? ctx.use-counts load-dst)
                    ;; The fused compare+branch needs TWO more instructions.
                    ;; The end test is a conjunct rather than another nested
                    ;; `if` because running off the end of the block takes the
                    ;; same fallback the non-compare shapes take.
                    (< after-load instrs.len))
                    (let
                      [maybe-cmp : compiler_ir_types.CompilerIrInstr
                        (compiler_ir_types.compiler-ir-instr-seq-ref
                          instrs
                          after-load)]
                      [after-cmp : i64 (+ after-load 1)]
                      (match maybe-cmp
                        [(compiler_ir_types.CompilerIrInstr.BinOp
                            cmp-dst
                            op
                            lhs
                            rhs
                            cmp-ty)
                          (if (and
                            (compiler-backend-compare-op? op)
                            (compiler-backend-branch-uses-var? lhs load-dst)
                            (compiler-backend-var-single-use?
                              ctx.use-counts
                              cmp-dst)
                            (not
                              (compiler-backend-binop-f64?
                                ctx.types
                                ctx.global-types
                                lhs
                                rhs
                                cmp-ty)))
                            (if (< after-cmp instrs.len)
                              (let
                                [branch : compiler_ir_types.CompilerIrInstr
                                  (compiler_ir_types.compiler-ir-instr-seq-ref
                                    instrs
                                    after-cmp)]
                                [after-branch : i64 (+ after-cmp 1)]
                                (match (compiler_ir_types.compiler-ir-instr-scalar-fact
                                  branch)
                                  [(compiler_ir_types.CompilerIrInstrScalarFact.Branch
                                      cond
                                      true-label
                                      false-label)
                                    (if (compiler-backend-branch-uses-var?
                                      cond
                                      cmp-dst)
                                      (compiler-backend-emit-fused-gep-load-compare-branch-rest
                                        ctx
                                        fallthrough
                                        gep-dst
                                        (compiler-backend-gep-fold-next!
                                          ctx.function-state
                                          ctx.type-segment-bases
                                          offset
                                          elem-ty)
                                        base
                                        offset
                                        elem-ty
                                        load-dst
                                        load-ty
                                        cmp-dst
                                        op
                                        rhs
                                        cmp-ty
                                        true-label
                                        false-label
                                        instrs
                                        after-branch
                                        out)
                                      (compiler-backend-emit-fused-gep-load-rest
                                        ctx
                                        fallthrough
                                        gep-dst
                                        (compiler-backend-gep-fold-next!
                                          ctx.function-state
                                          ctx.type-segment-bases
                                          offset
                                          elem-ty)
                                        base
                                        offset
                                        elem-ty
                                        load-dst
                                        load-ty
                                        instrs
                                        after-load
                                        out))]
                                  [_
                                    (compiler-backend-emit-fused-gep-load-rest
                                      ctx
                                      fallthrough
                                      gep-dst
                                      (compiler-backend-gep-fold-next!
                                        ctx.function-state
                                        ctx.type-segment-bases
                                        offset
                                        elem-ty)
                                      base
                                      offset
                                      elem-ty
                                      load-dst
                                      load-ty
                                      instrs
                                      after-load
                                      out)]))
                              (compiler-backend-emit-fused-gep-load-rest
                                ctx
                                fallthrough
                                gep-dst
                                (compiler-backend-gep-fold-next!
                                  ctx.function-state
                                  ctx.type-segment-bases
                                  offset
                                  elem-ty)
                                base
                                offset
                                elem-ty
                                load-dst
                                load-ty
                                instrs
                                after-load
                                out))
                            (compiler-backend-emit-fused-gep-load-rest
                              ctx
                              fallthrough
                              gep-dst
                              (compiler-backend-gep-fold-next!
                                ctx.function-state
                                ctx.type-segment-bases
                                offset
                                elem-ty)
                              base
                              offset
                              elem-ty
                              load-dst
                              load-ty
                              instrs
                              after-load
                              out))]
                        [_
                          (compiler-backend-emit-fused-gep-load-rest
                            ctx
                            fallthrough
                            gep-dst
                            (compiler-backend-gep-fold-next!
                              ctx.function-state
                              ctx.type-segment-bases
                              offset
                              elem-ty)
                            base
                            offset
                            elem-ty
                            load-dst
                            load-ty
                            instrs
                            after-load
                            out)]))
                    (compiler-backend-emit-fused-gep-load-rest
                      ctx
                      fallthrough
                      gep-dst
                      (compiler-backend-gep-fold-next!
                        ctx.function-state
                        ctx.type-segment-bases
                        offset
                        elem-ty)
                      base
                      offset
                      elem-ty
                      load-dst
                      load-ty
                      instrs
                      after-load
                      out))
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(compiler_ir_types.CompilerIrInstr.StorePtr dst value store-ty)
                (if (compiler-backend-branch-uses-var? dst gep-dst)
                  (compiler-backend-emit-fused-gep-store-rest
                    ctx
                    fallthrough
                    gep-dst
                    (compiler-backend-gep-fold-next!
                      ctx.function-state
                      ctx.type-segment-bases
                      offset
                      elem-ty)
                    base
                    offset
                    elem-ty
                    value
                    store-ty
                    1
                    instrs
                    after-load
                    out)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(compiler_ir_types.CompilerIrInstr.CopyBytes
                  copy-dst
                  copy-src
                  copy-size)
                (if (and
                  (compiler-backend-branch-uses-var? copy-dst gep-dst)
                  (compiler-backend-imm32?
                    (*
                      n
                      (compiler-backend-type-size
                        ctx.type-segment-bases
                        elem-ty))))
                  (let
                    [protect-n : i64
                      (compiler-backend-copy-run-protect-count
                        ctx.backend-state
                        ctx.assignments
                        instrs
                        after-load)]
                    [protect : (__tl_dyn-array String)
                      (compiler-backend-copy-run-protect-exclude
                        ctx.backend-state
                        ctx.assignments
                        instrs
                        after-load)]
                    (compiler-backend-emit-fused-result-rest
                      ctx
                      fallthrough
                      (compiler-backend-emit-copy-bytes-from-gep-avoid
                        ctx.type-segment-bases
                        ctx.assignments
                        base
                        offset
                        elem-ty
                        copy-src
                        copy-size
                        protect
                        protect-n
                        (compiler-backend-gep-fold-next!
                          ctx.function-state
                          ctx.type-segment-bases
                          offset
                          elem-ty)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          0
                          ctx.backend-state)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          1
                          ctx.backend-state)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1
                          1
                          ctx.backend-state)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1
                          (if (>= copy-size 16)
                            3
                            2)
                          ctx.backend-state)
                        (if (>= copy-size 16)
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            1
                            2
                            ctx.backend-state)
                          "")
                        ctx.backend-state)
                      instrs
                      after-load
                      out))
                  ;; Not the copy DESTINATION (or out of imm32 range there):
                  ;; the source-side rule owns the mirror shape and declines
                  ;; back to ordinary emission itself, so the ordinal is
                  ;; consumed exactly once either way. A copy whose dst AND src
                  ;; are both this gep cannot reach either rule: that is two
                  ;; uses, and the whole cluster is behind a single-use gate.
                  (compiler-backend-emit-gep-copy-src-rest
                    ctx
                    fallthrough
                    instr
                    gep-dst
                    base
                    offset
                    elem-ty
                    copy-dst
                    copy-src
                    copy-size
                    instrs
                    index
                    after-load
                    out))]
              [_
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out)]))
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out))]
      [(option_i64.None)
        (if (< index instrs.len)
          (let
            [next : compiler_ir_types.CompilerIrInstr
              (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
            [after-gep : i64 (+ index 1)]
            (match next
              [(compiler_ir_types.CompilerIrInstr.Gep _ load-base load-offset _)
                (compiler-backend-emit-fused-result-rest
                  ctx
                  fallthrough
                  (if (compiler-backend-branch-uses-var? load-base gep-dst)
                    (compiler-backend-emit-gep
                      ctx.type-segment-bases
                      ctx.assignments
                      gep-dst
                      base
                      offset
                      elem-ty
                      (compiler-backend-gep-fold-next!
                        ctx.function-state
                        ctx.type-segment-bases
                        offset
                        elem-ty)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        0
                        0
                        ctx.backend-state)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        0
                        1
                        ctx.backend-state)
                      ctx.backend-state)
                    (compiler-backend-emit-gep-staged-avoid
                      ctx.type-segment-bases
                      ctx.assignments
                      gep-dst
                      base
                      offset
                      elem-ty
                      (compiler-backend-gep-fold-next!
                        ctx.function-state
                        ctx.type-segment-bases
                        offset
                        elem-ty)
                      (compiler-backend-value-scalar-register
                        ctx.backend-state
                        ctx.assignments
                        load-base)
                      (compiler-backend-value-scalar-register
                        ctx.backend-state
                        ctx.assignments
                        load-offset)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        0
                        0
                        ctx.backend-state)
                      (compiler-backend-scratch-plan-register-ahead
                        (compiler-backend-runtime-plan-scratch ctx.plan)
                        0
                        1
                        ctx.backend-state)
                      ctx.backend-state))
                  instrs
                  index
                  out)]
              [(compiler_ir_types.CompilerIrInstr.Mov ptr-var src _)
                (if (and
                  (compiler-backend-branch-uses-var? src gep-dst)
                  (compiler-backend-var-single-use? ctx.use-counts ptr-var))
                  (if (< after-gep instrs.len)
                    (let
                      [maybe-store : compiler_ir_types.CompilerIrInstr
                        (compiler_ir_types.compiler-ir-instr-seq-ref
                          instrs
                          after-gep)]
                      [after-store : i64 (+ after-gep 1)]
                      (match maybe-store
                        [(compiler_ir_types.CompilerIrInstr.StorePtr
                            dst
                            value
                            store-ty)
                          (if (compiler-backend-branch-uses-var? dst ptr-var)
                            (compiler-backend-emit-fused-gep-store-rest
                              ctx
                              fallthrough
                              gep-dst
                              (compiler-backend-gep-fold-next!
                                ctx.function-state
                                ctx.type-segment-bases
                                offset
                                elem-ty)
                              base
                              offset
                              elem-ty
                              value
                              store-ty
                              2
                              instrs
                              after-store
                              out)
                            (compiler-backend-emit-instrs-normal
                              ctx
                              fallthrough
                              instr
                              instrs
                              index
                              out))]
                        [_
                          (compiler-backend-emit-instrs-normal
                            ctx
                            fallthrough
                            instr
                            instrs
                            index
                            out)]))
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      instrs
                      index
                      out))
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(compiler_ir_types.CompilerIrInstr.Load load-dst src load-ty)
                (if (compiler-backend-branch-uses-var? src gep-dst)
                  (compiler-backend-emit-fused-gep-load-rest
                    ctx
                    fallthrough
                    gep-dst
                    (compiler-backend-gep-fold-next!
                      ctx.function-state
                      ctx.type-segment-bases
                      offset
                      elem-ty)
                    base
                    offset
                    elem-ty
                    load-dst
                    load-ty
                    instrs
                    after-gep
                    out)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(compiler_ir_types.CompilerIrInstr.StorePtr dst value store-ty)
                (if (compiler-backend-branch-uses-var? dst gep-dst)
                  (compiler-backend-emit-fused-gep-store-rest
                    ctx
                    fallthrough
                    gep-dst
                    (compiler-backend-gep-fold-next!
                      ctx.function-state
                      ctx.type-segment-bases
                      offset
                      elem-ty)
                    base
                    offset
                    elem-ty
                    value
                    store-ty
                    1
                    instrs
                    after-gep
                    out)
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))]
              [(compiler_ir_types.CompilerIrInstr.CopyBytes
                  copy-dst
                  copy-src
                  copy-size)
                (if (compiler-backend-branch-uses-var? copy-dst gep-dst)
                  (let
                    [protect-n : i64
                      (compiler-backend-copy-run-protect-count
                        ctx.backend-state
                        ctx.assignments
                        instrs
                        after-gep)]
                    [protect : (__tl_dyn-array String)
                      (compiler-backend-copy-run-protect-exclude
                        ctx.backend-state
                        ctx.assignments
                        instrs
                        after-gep)]
                    (compiler-backend-emit-fused-result-rest
                      ctx
                      fallthrough
                      (compiler-backend-emit-copy-bytes-from-gep-avoid
                        ctx.type-segment-bases
                        ctx.assignments
                        base
                        offset
                        elem-ty
                        copy-src
                        copy-size
                        protect
                        protect-n
                        (compiler-backend-gep-fold-next!
                          ctx.function-state
                          ctx.type-segment-bases
                          offset
                          elem-ty)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          0
                          ctx.backend-state)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          1
                          ctx.backend-state)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1
                          1
                          ctx.backend-state)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1
                          (if (>= copy-size 16)
                            3
                            2)
                          ctx.backend-state)
                        (if (>= copy-size 16)
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            1
                            2
                            ctx.backend-state)
                          "")
                        ctx.backend-state)
                      instrs
                      after-gep
                      out))
                  (compiler-backend-emit-gep-copy-src-rest
                    ctx
                    fallthrough
                    instr
                    gep-dst
                    base
                    offset
                    elem-ty
                    copy-dst
                    copy-src
                    copy-size
                    instrs
                    index
                    after-gep
                    out))]
              [_
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out)]))
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out))])
    (compiler-backend-emit-instrs-normal ctx fallthrough instr instrs index out)))

;; The remaining `BinOp` fusion cluster of
;; `compiler-backend-emit-instrs-step`, extracted unchanged (refs #5177).
;; It owns the shared lookahead for RAX forwarding and compare consumers
;; (return, direct/total-enum branches, and comparison-plus-not branches).
;; `((mask >>u d) & 1) != 0` over a literal mask, feeding a branch, is `bt` plus
;; its jump. Lowered as a real shift it costs an order of magnitude more: x86
;; pins a variable count to `%cl`, so whatever lives there spills and reloads
;; around the shift, and the count still pays the shift-count guard. The
;; optimizer's bit_test pass emits exactly this triple for a classifier chain,
;; and any hand-written `(!= (bit-and (shr MASK d) 1) 0)` gets the same
;; treatment.
;;
;; The guard stays wherever the count could be out of range: `bt` reads its
;; offset modulo 64 where the language aborts, so dropping it there would change
;; what an out-of-range count does. It goes away where the count is spelled
;; `(bit-and c 63)`: six bits cannot name an out-of-range shift, the abort is
;; unreachable, and `bt` already reads its offset modulo 64 -- so the mask is
;; exactly `bt`'s own behavior and both it and the guard fold into the one
;; instruction. That is the shape the optimizer's bit_test pass emits
;; (opt-bit-test-mask-block); a bare count keeps the guard, which is the only
;; cost that then survives on the taken path.
;; A literal mask still has to be materialized, so it needs a register the count
;; does not occupy; a mask already in a var is only READ by `bt` and needs
;; nothing beyond its own home. The optimizer emits the second form, and the
;; first covers a mask a later fold pushed back into the shift operand.
(defenum CompilerBackendBitTestMask
  (No)
  (Literal i64)
  (Var i64))

(defenum CompilerBackendMaybeBitTest
  (No)
  ;; mask, count var, true label, false label, index after the branch,
  ;; the shift's dst (the register the literal-mask materialization may borrow),
  ;; and whether the shift-count guard is still owed
  (Some CompilerBackendBitTestMask i64 i64 i64 i64 i64 bool))

(define (compiler-backend-bit-test-one?
  [value : compiler_ir_types.CompilerIrValue]) : bool
  (match value
    [(compiler_ir_types.CompilerIrValue.I64 n) (= n 1)]
    [_ false]))

;; `bt`'s base operand has to be a register: with a memory base the processor
;; reads the bit offset as an unbounded signed index instead of taking it modulo
;; the operand size. The mask goes in the shift result's own home when that is a
;; register the count does not also live in -- the allocator coalesces the two
;; whenever the count dies here, which is the common case -- and otherwise in a
;; planned scratch register, which the constrained allocation proves free at
;; this emission point. Neither is available: keep the general lowering.
;; A literal mask is materialized into the shift result's own home when the
;; allocator did not coalesce that with the count -- it does whenever the count
;; dies here, which is the common case -- and otherwise into a planned scratch
;; register or, failing that, a scavenged one. Scavenging is a mutating query
;; (it books the emergency save/restore), so it stays out of the match test.
(define (compiler-backend-bit-test-mask-reg
  [ctx : CompilerBackendEmissionContext]
  [dst : i64]
  [count-reg : String]) : String
  (let
    [dst-home : String
      (compiler-backend-var-register-home ctx.backend-state ctx.assignments dst)]
    [scratch0 : String
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        0
        ctx.backend-state)]
    [scratch1 : String
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        1
        ctx.backend-state)]
    (cond
      [(and (not (string.eq dst-home "")) (not (string.eq dst-home count-reg)))
        dst-home]
      [(and (not (string.eq scratch0 "")) (not (string.eq scratch0 count-reg)))
        scratch0]
      [(and (not (string.eq scratch1 "")) (not (string.eq scratch1 count-reg)))
        scratch1]
      [else
        (compiler-backend-scavenge-reg
          dst
          (__tl_make-array count-reg "" "" "" "")
          1
          (if (string.eq count-reg "%r11")
            "%r10"
            "%r11")
          ctx.backend-state)])))

(define (compiler-backend-bit-test-count-reg
  [ctx : CompilerBackendEmissionContext]
  [count : i64]) : String
  (compiler-backend-var-register-home ctx.backend-state ctx.assignments count))

(define (compiler-backend-bit-test-mask-known?
  [mask : CompilerBackendBitTestMask]) : bool
  (match mask
    [(CompilerBackendBitTestMask.No) false]
    [_ true]))

;; Register the `bt` base operand ends up in: a register-homed mask keeps its own
;; home (nothing is written to it); a literal mask, or a var mask the allocator
;; left somewhere other than a register, is placed into a register the count does
;; not occupy. An empty answer keeps the general shift lowering.
(define (compiler-backend-bit-test-base-reg
  [ctx : CompilerBackendEmissionContext]
  [mask : CompilerBackendBitTestMask]
  [dst : i64]
  [count-reg : String]) : String
  (match mask
    [(CompilerBackendBitTestMask.No) ""]
    [(CompilerBackendBitTestMask.Var mask-var)
      (let
        [home : String
          (compiler-backend-var-register-home
            ctx.backend-state
            ctx.assignments
            mask-var)]
        (if (string.eq home "")
          (compiler-backend-bit-test-mask-reg ctx dst count-reg)
          home))]
    [(CompilerBackendBitTestMask.Literal _)
      (compiler-backend-bit-test-mask-reg ctx dst count-reg)]))

;; Text placing the mask in `mask-reg` ahead of the `bt`: a literal is
;; materialized; a var the allocator did NOT leave in a register -- spilled,
;; rematerialized, or slot-homed -- is loaded through the ordinary scalar loader,
;; which is exactly the one load the general shift lowering would have performed
;; on the same operand. A register-homed var needs nothing.
;;
;; This is what keeps the wide-mask suppression in the optimizer
;; (`opt-global-copy-keep-wide-left`) a strict win. Before it, a mask the
;; optimizer had left as a Var only lowered to `bt` when the allocator found it
;; a register; under pressure it fell all the way back to the general quad --
;; and, shift-count guard, shift, test -- while the folded literal form kept its
;; two-instruction `movabsq`/`btq`. The register-poor case is now `load`/`btq`:
;; the same two instructions, and one fewer whenever the register IS free.
(define (compiler-backend-bit-test-load-mask
  [ctx : CompilerBackendEmissionContext]
  [mask : CompilerBackendBitTestMask]
  [ty : compiler_ast_types.AstType]
  [mask-reg : String]) : String
  (match mask
    [(CompilerBackendBitTestMask.Literal literal)
      (compiler-backend-emit-load-i64-absolute literal mask-reg)]
    [(CompilerBackendBitTestMask.Var mask-var)
      (if (string.eq
        (compiler-backend-var-register-home
          ctx.backend-state
          ctx.assignments
          mask-var)
        "")
        (compiler-backend-emit-load-typed-var-to-reg-with-plan
          ctx.type-segment-bases
          ctx.assignments
          mask-var
          ty
          mask-reg
          ctx.backend-state)
        "")]
    [_ ""]))

(define (compiler-backend-bit-test-shr-mask
  [lhs : compiler_ir_types.CompilerIrValue]) : CompilerBackendBitTestMask
  (match lhs
    [(compiler_ir_types.CompilerIrValue.I64 mask)
      (CompilerBackendBitTestMask.Literal mask)]
    [(compiler_ir_types.CompilerIrValue.Var mask-var)
      (CompilerBackendBitTestMask.Var mask-var)]
    [_ (CompilerBackendBitTestMask.No)]))

(define (compiler-backend-bit-test-branch-tail
  [ctx : CompilerBackendEmissionContext]
  [dst : i64]
  [mask : CompilerBackendBitTestMask]
  [count : i64]
  [guard? : bool]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeBitTest
  (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
    [(compiler_ir_types.CompilerIrInstr.BinOp
        test-dst
        (compiler_ir_types.CompilerIrBinOp.BitTestNe)
        test-lhs
        test-rhs
        _)
      (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs (+ index 1))
        [(compiler_ir_types.CompilerIrInstr.Branch cond true-label false-label)
          (if (and
            (compiler-backend-branch-uses-var? test-lhs dst)
            (compiler-backend-bit-test-one? test-rhs)
            (compiler-backend-var-single-use? ctx.use-counts test-dst)
            (compiler-backend-branch-uses-var? cond test-dst)
            ;; The mask needs no availability test of its own: a known mask can
            ;; always be placed. A literal materializes into the planned scratch
            ;; (falling back to a scavenged register), and every allocator home a
            ;; var can have -- register, spill slot, remat, plain slot -- is
            ;; loadable by the same scalar loader the general lowering would have
            ;; used on it (compiler-backend-bit-test-load-mask).
            (not (string.eq (compiler-backend-bit-test-count-reg ctx count) ""))
            (not
              (compiler-backend-branch-needs-phi-copies?
                ctx.function-state
                true-label
                false-label)))
            (CompilerBackendMaybeBitTest.Some
              mask
              count
              true-label
              false-label
              (+ index 2)
              dst
              guard?)
            (CompilerBackendMaybeBitTest.No))]
        [_ (CompilerBackendMaybeBitTest.No)])]
    [_ (CompilerBackendMaybeBitTest.No)]))

;; `(bit-and c 63)` feeding the shift: the count is six bits, so the shift's
;; abort is unreachable and `bt`'s modulo-64 offset already performs the mask.
;; The whole quad -- and, shift, bit test, branch -- becomes one `bt` reading
;; `c`'s own home, with no guard in front of it.
(define (compiler-backend-bit-test-count-mask?
  [value : compiler_ir_types.CompilerIrValue]) : bool
  (match value
    [(compiler_ir_types.CompilerIrValue.I64 n) (= n 63)]
    [_ false]))

(define (compiler-backend-bit-test-masked-shift
  [instr : compiler_ir_types.CompilerIrInstr]
  [masked : i64]) : CompilerBackendMaybeBitTest
  (match instr
    [(compiler_ir_types.CompilerIrInstr.BinOp
        shift-dst
        (compiler_ir_types.CompilerIrBinOp.Shr _)
        shift-lhs
        (compiler_ir_types.CompilerIrValue.Var shift-count)
        _)
      (if (= shift-count masked)
        (CompilerBackendMaybeBitTest.Some
          (compiler-backend-bit-test-shr-mask shift-lhs)
          shift-dst
          0
          0
          0
          shift-dst
          false)
        (CompilerBackendMaybeBitTest.No))]
    [_ (CompilerBackendMaybeBitTest.No)]))

(define (compiler-backend-bit-test-masked-count-match
  [ctx : CompilerBackendEmissionContext]
  [masked : i64]
  [count : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeBitTest
  (if (>= (+ index 2) instrs.len)
    (CompilerBackendMaybeBitTest.No)
    (match (compiler-backend-bit-test-masked-shift
      (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)
      masked)
      [(CompilerBackendMaybeBitTest.No) (CompilerBackendMaybeBitTest.No)]
      [(CompilerBackendMaybeBitTest.Some mask shift-dst _ _ _ _ _)
        (if (and
          (compiler-backend-bit-test-mask-known? mask)
          (compiler-backend-var-single-use? ctx.use-counts masked)
          (compiler-backend-var-single-use? ctx.use-counts shift-dst))
          (compiler-backend-bit-test-branch-tail
            ctx
            shift-dst
            mask
            count
            false
            instrs
            (+ index 1))
          (CompilerBackendMaybeBitTest.No))])))

(define (compiler-backend-bit-test-branch-match
  [ctx : CompilerBackendEmissionContext]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeBitTest
  (match op
    [(compiler_ir_types.CompilerIrBinOp.Shr _)
      (match rhs
        [(compiler_ir_types.CompilerIrValue.Var count)
          (let
            [mask : CompilerBackendBitTestMask
              (compiler-backend-bit-test-shr-mask lhs)]
            (if (and
              (compiler-backend-bit-test-mask-known? mask)
              (compiler-backend-var-single-use? ctx.use-counts dst)
              (< (+ index 1) instrs.len))
              (compiler-backend-bit-test-branch-tail
                ctx
                dst
                mask
                count
                true
                instrs
                index)
              (CompilerBackendMaybeBitTest.No)))]
        [_ (CompilerBackendMaybeBitTest.No)])]
    [(compiler_ir_types.CompilerIrBinOp.BitAnd)
      (match lhs
        [(compiler_ir_types.CompilerIrValue.Var count)
          (if (compiler-backend-bit-test-count-mask? rhs)
            (compiler-backend-bit-test-masked-count-match
              ctx
              dst
              count
              instrs
              index)
            (CompilerBackendMaybeBitTest.No))]
        [_ (CompilerBackendMaybeBitTest.No)])]
    [_ (CompilerBackendMaybeBitTest.No)]))

(define (compiler-backend-emit-bit-test-branch
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [ty : compiler_ast_types.AstType]
  [mask : CompilerBackendBitTestMask]
  [count : i64]
  [true-label : i64]
  [false-label : i64]
  [guard? : bool]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [count-reg : String (compiler-backend-bit-test-count-reg ctx count)]
    [mask-reg : String
      (compiler-backend-bit-test-base-reg ctx mask dst count-reg)]
    [load-mask : String
      (compiler-backend-bit-test-load-mask ctx mask ty mask-reg)]
    [head : String
      (str_cat.str-cat
        (if guard?
          (compiler-backend-shift-guard-asm
            ctx.type-segment-bases
            ty
            (compiler_ir_types.compiler-ir-binop-rhs-type op ty)
            count-reg
            ctx.backend-state)
          "")
        load-mask
        (str_cat.str-cat "    btq " count-reg ", " mask-reg "\n")
        (compiler-backend-emit-compare-branch-jumps
          ctx.function
          true-label
          false-label
          (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
          "jb"
          "jae"
          ctx.backend-state))]
    (begin
      (compiler-backend-asm-append
        out
        (compiler-backend-emergency-wrap head ctx.backend-state))
      (compiler-backend-emit-instrs ctx fallthrough instrs index out))))

(define (compiler-backend-emit-binop-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (compiler-backend-bit-test-branch-match
    ctx
    dst
    op
    lhs
    rhs
    instrs
    index)
    [(CompilerBackendMaybeBitTest.Some
        mask
        count
        true-label
        false-label
        after-branch
        base-dst
        guard?)
      (compiler-backend-emit-bit-test-branch
        ctx
        fallthrough
        base-dst
        op
        ty
        mask
        count
        true-label
        false-label
        guard?
        instrs
        after-branch
        out)]
    [(CompilerBackendMaybeBitTest.No)
      (compiler-backend-emit-binop-step-general
        ctx
        fallthrough
        instr
        dst
        op
        lhs
        rhs
        ty
        instrs
        index
        out)]))

(defenum CompilerBackendMaybeFlagsBranch
  (No)
  ;; branch condition, true label, false label, index just past the branch
  (Some compiler_ir_types.CompilerIrValue i64 i64 i64))

;; The `not` shape of the flags-reuse match: the comparison materializes, a
;; boolean negation of it follows, and the branch reads the negation. The `not`
;; only swaps the two successors -- the same inversion
;; `compiler-backend-emit-fused-not-branch-rest` performs -- so the comparison's
;; own flags still decide the branch, read with the SAME jcc pair against
;; exchanged labels. Admitted only when the negation never materializes
;; (single-use or fuse-safe), because otherwise its `xorq $1` would land between
;; the comparison and the jumps and clobber the flags being reused.
(define (compiler-backend-flags-not-branch-match
  [ctx : CompilerBackendEmissionContext]
  [dst : i64]
  [next : compiler_ir_types.CompilerIrInstr]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeFlagsBranch
  (match next
    [(compiler_ir_types.CompilerIrInstr.UnOp
        not-dst
        (compiler_ir_types.CompilerIrUnOp.Not)
        not-src
        (compiler_ast_types.AstType.Bool))
      (if (and
        (compiler-backend-branch-uses-var? not-src dst)
        (or
          (compiler-backend-var-single-use? ctx.use-counts not-dst)
          (compiler-backend-var-fuse-safe? ctx.backend-state not-dst))
        (< index instrs.len))
        (match (compiler_ir_types.compiler-ir-instr-scalar-fact
          (compiler_ir_types.compiler-ir-instr-seq-ref instrs index))
          [(compiler_ir_types.CompilerIrInstrScalarFact.Branch
              cond
              true-label
              false-label)
            (if (compiler-backend-branch-uses-var? cond not-dst)
              (CompilerBackendMaybeFlagsBranch.Some
                cond
                false-label
                true-label
                (+ index 1))
              (CompilerBackendMaybeFlagsBranch.No))]
          [_ (CompilerBackendMaybeFlagsBranch.No)])
        (CompilerBackendMaybeFlagsBranch.No))]
    [_ (CompilerBackendMaybeFlagsBranch.No)]))

;; The branch that may consume a materialized comparison's own flags: it must be
;; the instruction right after the comparison and must read exactly the boolean
;; the comparison defined. `compiler-ir-instr-scalar-fact` folds TotalEnumBranch
;; into Branch, so both terminator spellings are covered. A branch on a COPY of
;; the boolean is refused -- the copy's home is what such a branch reads, and
;; whatever produced the copy is not this comparison.
(define (compiler-backend-flags-branch-match
  [ctx : CompilerBackendEmissionContext]
  [dst : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]) : CompilerBackendMaybeFlagsBranch
  (if (>= index instrs.len)
    (CompilerBackendMaybeFlagsBranch.No)
    (let
      [next : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      (match (compiler_ir_types.compiler-ir-instr-scalar-fact next)
        [(compiler_ir_types.CompilerIrInstrScalarFact.Branch
            cond
            true-label
            false-label)
          (if (compiler-backend-branch-uses-var? cond dst)
            (CompilerBackendMaybeFlagsBranch.Some
              cond
              true-label
              false-label
              (+ index 1))
            (CompilerBackendMaybeFlagsBranch.No))]
        [_
          (compiler-backend-flags-not-branch-match
            ctx
            dst
            next
            instrs
            (+ index 1))]))))

;; Emit the jumps of a branch whose condition is already live in EFLAGS, then
;; the rest of the block. `ahead` is how many instructions past the comparison
;; the branch sits, so the phi-copy scratch comes from that instruction's own
;; planned allocation, exactly as the ordinary branch emission would take it.
(define (compiler-backend-emit-flags-reuse-branch-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [cond : compiler_ir_types.CompilerIrValue]
  [true-label : i64]
  [false-label : i64]
  [true-jcc : String]
  [false-jcc : String]
  [ahead : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (begin
    (compiler-backend-publish-phi-planned-xmm-ahead! ctx ahead)
    (match (compiler-backend-emit-branch-with-phi-copies-with-plan
      ctx.type-segment-bases
      ctx.assignments
      ctx.function
      ctx.blocks
      ctx.current-label
      cond
      true-label
      false-label
      (compiler-backend-fused-compare-fallthrough instrs index fallthrough)
      ctx.program-index
      ctx.vars
      true-jcc
      false-jcc
      ""
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        ahead
        1
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        ahead
        2
        ctx.backend-state))
      [(ResultCompilerBackend.Ok head)
        (begin
          (compiler-backend-asm-append
            out
            (compiler-backend-emergency-wrap head ctx.backend-state))
          (compiler-backend-emit-instrs ctx fallthrough instrs index out))]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

;; Flags reuse for a comparison that MUST materialize. The fused paths above
;; fire only when the boolean is never needed as a value; with a stored bool or
;; a phi input among its readers the setcc/movzb stay, and the adjacent branch
;; used to re-derive the very flags they were computed from:
;;
;;     cmpq %rcx, %rax / setl %al / movzbq %al, %rax / testq %rax, %rax / jne L
;;
;; `setcc` and `movzb` read EFLAGS and write none, so the `cmp`'s flags are
;; still exactly what `setl` saw. Branching with the comparison's own `jcc`
;; retires the `test` -- one instruction, no duplicated compare, no extra live
;; range. The materialization is emitted first and then INSPECTED
;; (`compiler-backend-asm-tail-setcc-materializes?`): the rewrite is taken only
;; when the emitted text really ends with the matching `setcc`/`movzb` pair, so
;; every lowering that ends some other way -- a folded constant, a float
;; compare, an operand staged after the flags were set -- falls back to the
;; ordinary branch untouched instead of having to be enumerated here.
(define (compiler-backend-emit-materialized-compare-branch-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (if (compiler-backend-compare-op? op)
    (compiler-backend-flags-branch-match ctx dst instrs index)
    (CompilerBackendMaybeFlagsBranch.No))
    [(CompilerBackendMaybeFlagsBranch.No)
      (compiler-backend-emit-instrs-normal
        ctx
        fallthrough
        instr
        instrs
        index
        out)]
    [(CompilerBackendMaybeFlagsBranch.Some cond true-label false-label after)
      (let
        [operand-ty : compiler_ast_types.AstType
          (compiler-backend-binop-operand-ty
            ctx.types
            ctx.global-types
            op
            lhs
            rhs
            ty)]
        [setcc : String (compiler-backend-compare-setcc op operand-ty)]
        [true-jcc : String (compiler-backend-compare-true-jcc op operand-ty)]
        [false-jcc : String (compiler-backend-compare-false-jcc op operand-ty)]
        (if (or
          (string.eq setcc "")
          (string.eq true-jcc "")
          (string.eq false-jcc "")
          (compiler-backend-binop-f64? ctx.types ctx.global-types lhs rhs ty))
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            index
            out)
          (match (compiler-backend-emit-instr
            ctx
            (CompilerBackendMaybeLabel.No)
            instr)
            [(ResultCompilerBackend.Ok head)
              (if (compiler-backend-asm-tail-setcc-materializes? head setcc)
                (begin
                  (let
                    [location : String
                      (compiler-backend-debug-instr-location ctx instr)]
                    (if (> (string.string-length location) 0)
                      (compiler-backend-asm-append out location)
                      unit))
                  (compiler-backend-emergency-append out head ctx.backend-state)
                  (compiler-backend-emit-flags-reuse-branch-rest
                    ctx
                    fallthrough
                    cond
                    true-label
                    false-label
                    true-jcc
                    false-jcc
                    (- after index)
                    instrs
                    after
                    out))
                (compiler-backend-emit-instrs-after-emitted
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  head
                  out))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)])))]))

(define (compiler-backend-emit-binop-step-general
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : compiler_ir_types.CompilerIrInstr]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (and
    (compiler-backend-var-single-use? ctx.use-counts dst)
    (compiler-backend-rax-forwardable-binop?
      ctx.types
      ctx.global-types
      ctx.assignments
      op
      lhs
      rhs
      ty)
    (compiler-backend-rest-starts-rax-forwardable-consumer?
      ctx.types
      ctx.global-types
      ctx.assignments
      dst
      instrs
      index))
    (match (compiler-backend-emit-binop-to-rax
      ctx.type-segment-bases
      ctx.types
      ctx.global-types
      ctx.assignments
      dst
      op
      lhs
      rhs
      ty
      false
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        0
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        1
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        2
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        3
        ctx.backend-state)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        4
        ctx.backend-state)
      (compiler-backend-rest-starts-return-of-var? dst instrs index)
      ctx.backend-state)
      [(ResultCompilerBackend.Ok head)
        (begin
          (compiler-backend-asm-append
            out
            (compiler-backend-emergency-wrap head ctx.backend-state))
          (compiler-backend-emit-instrs-with-rax
            ctx
            fallthrough
            dst
            ty
            instrs
            index
            out))]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])
    (if (and
      (compiler-backend-compare-op? op)
      (or
        (compiler-backend-var-single-use? ctx.use-counts dst)
        (compiler-backend-var-fuse-safe? ctx.backend-state dst))
      (not (compiler-backend-binop-f64? ctx.types ctx.global-types lhs rhs ty)))
      (if (< index instrs.len)
        (let
          [next : compiler_ir_types.CompilerIrInstr
            (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
          [after-branch : i64 (+ index 1)]
          (match next
            [(compiler_ir_types.CompilerIrInstr.Return maybe)
              (if (< after-branch instrs.len)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out)
                (match maybe
                  [(compiler_ir_types.CompilerIrMaybeValue.Some value)
                    (if (compiler-backend-branch-uses-var? value dst)
                      (compiler-backend-emit-terminator-into
                        (compiler-backend-emit-binop-return-with-plan
                          ctx.type-segment-bases
                          ctx.backend-state
                          ctx.source-function
                          ctx.blocks
                          ctx.types
                          ctx.global-types
                          ctx.assignments
                          ctx.vars
                          op
                          lhs
                          rhs
                          ty
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            0
                            0
                            ctx.backend-state)
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            0
                            1
                            ctx.backend-state)
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            0
                            2
                            ctx.backend-state)
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            0
                            3
                            ctx.backend-state)
                          (compiler-backend-scratch-plan-register-ahead
                            (compiler-backend-runtime-plan-scratch ctx.plan)
                            0
                            4
                            ctx.backend-state))
                        out
                        ctx.backend-state)
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        instrs
                        index
                        out))]
                  [(compiler_ir_types.CompilerIrMaybeValue.No)
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      instrs
                      index
                      out)]))]
            [(compiler_ir_types.CompilerIrInstr.Branch
                cond
                true-label
                false-label)
              (if (compiler-backend-branch-uses-var? cond dst)
                (compiler-backend-emit-fused-compare-branch-rest
                  ctx
                  fallthrough
                  dst
                  op
                  lhs
                  rhs
                  ty
                  true-label
                  false-label
                  instrs
                  after-branch
                  out)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out))]
            [(compiler_ir_types.CompilerIrInstr.TotalEnumBranch
                cond
                true-label
                false-label)
              (if (compiler-backend-branch-uses-var? cond dst)
                (compiler-backend-emit-fused-compare-branch-rest
                  ctx
                  fallthrough
                  dst
                  op
                  lhs
                  rhs
                  ty
                  true-label
                  false-label
                  instrs
                  after-branch
                  out)
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out))]
            [(compiler_ir_types.CompilerIrInstr.UnOp
                not-dst
                (compiler_ir_types.CompilerIrUnOp.Not)
                not-src
                (compiler_ast_types.AstType.Bool))
              ;; A single-use `not` between a comparison and its branch
              ;; only reverses the two successors. Keep the compare
              ;; flags live, omit both boolean materializations, and
              ;; branch to the opposite labels directly.
              (if (and
                (compiler-backend-var-single-use? ctx.use-counts dst)
                (compiler-backend-var-single-use? ctx.use-counts not-dst)
                (compiler-backend-branch-uses-var? not-src dst))
                (if (< after-branch instrs.len)
                  (let
                    [branch : compiler_ir_types.CompilerIrInstr
                      (compiler_ir_types.compiler-ir-instr-seq-ref
                        instrs
                        after-branch)]
                    [after-not-branch : i64 (+ after-branch 1)]
                    (match (compiler_ir_types.compiler-ir-instr-scalar-fact
                      branch)
                      [(compiler_ir_types.CompilerIrInstrScalarFact.Branch
                          cond
                          true-label
                          false-label)
                        (if (compiler-backend-branch-uses-var? cond not-dst)
                          (compiler-backend-emit-fused-compare-branch-rest
                            ctx
                            fallthrough
                            dst
                            op
                            lhs
                            rhs
                            ty
                            false-label
                            true-label
                            instrs
                            after-not-branch
                            out)
                          (compiler-backend-emit-instrs-normal
                            ctx
                            fallthrough
                            instr
                            instrs
                            index
                            out))]
                      [_
                        (compiler-backend-emit-instrs-normal
                          ctx
                          fallthrough
                          instr
                          instrs
                          index
                          out)]))
                  (compiler-backend-emit-instrs-normal
                    ctx
                    fallthrough
                    instr
                    instrs
                    index
                    out))
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  instr
                  instrs
                  index
                  out))]
            [_
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                index
                out)]))
        (compiler-backend-emit-instrs-normal
          ctx
          fallthrough
          instr
          instrs
          index
          out))
      ;; The comparison materializes (a stored bool or a phi input reads it), so
      ;; the setcc/movzb stay -- but an adjacent branch on that same boolean can
      ;; still read the comparison's own flags instead of re-deriving them. Every
      ;; other binop falls straight through to the ordinary emission there.
      (compiler-backend-emit-materialized-compare-branch-step
        ctx
        fallthrough
        instr
        dst
        op
        lhs
        rhs
        ty
        instrs
        index
        out))))

(define (compiler-backend-emit-instrs-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [cursor : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (< cursor instrs.len)
    (let
      [instr : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs cursor)]
      [rest : i64 (+ cursor 1)]
      (match instr
        [(compiler_ir_types.CompilerIrInstr.Mov dst src ty)
          (compiler-backend-emit-mov-step
            ctx
            fallthrough
            instr
            dst
            src
            ty
            instrs
            rest
            out)]
        [(compiler_ir_types.CompilerIrInstr.Call dst name args ty)
          (compiler-backend-emit-call-step
            ctx
            fallthrough
            instr
            dst
            name
            args
            ty
            instrs
            rest
            out)]
        [(compiler_ir_types.CompilerIrInstr.StorePtr ptr value0 ty0)
          (compiler-backend-emit-store-ptr-step
            ctx
            fallthrough
            instr
            ptr
            value0
            ty0
            instrs
            rest
            out)]
        [(compiler_ir_types.CompilerIrInstr.Gep gep-dst base offset elem-ty)
          (compiler-backend-emit-gep-step
            ctx
            fallthrough
            instr
            gep-dst
            base
            offset
            elem-ty
            instrs
            rest
            out)]
        [(compiler_ir_types.CompilerIrInstr.CopyBytes dst src size)
          (compiler-backend-emit-copy-bytes-step
            ctx
            fallthrough
            dst
            src
            size
            instrs
            rest
            out)]
        [(compiler_ir_types.CompilerIrInstr.VectorLoad
            load-dst
            base
            index
            lanes
            elem-ty)
          (compiler-backend-emit-vector-load-step
            ctx
            fallthrough
            instr
            load-dst
            base
            index
            lanes
            elem-ty
            instrs
            rest
            out)]
        [(compiler_ir_types.CompilerIrInstr.Load load-dst ptr load-ty)
          (compiler-backend-emit-load-step
            ctx
            fallthrough
            instr
            load-dst
            ptr
            load-ty
            instrs
            rest
            out)]
        [(compiler_ir_types.CompilerIrInstr.BinOp dst op lhs rhs ty)
          (compiler-backend-emit-binop-step
            ctx
            fallthrough
            instr
            dst
            op
            lhs
            rhs
            ty
            instrs
            rest
            out)]
        [(compiler_ir_types.CompilerIrInstr.UnOp
            dst
            (compiler_ir_types.CompilerIrUnOp.Not)
            src
            (compiler_ast_types.AstType.Bool))
          (if (or
            (compiler-backend-var-single-use? ctx.use-counts dst)
            (compiler-backend-var-fuse-safe? ctx.backend-state dst))
            (if (< rest instrs.len)
              (let
                [branch : compiler_ir_types.CompilerIrInstr
                  (compiler_ir_types.compiler-ir-instr-seq-ref instrs rest)]
                [after-branch : i64 (+ rest 1)]
                (match (compiler_ir_types.compiler-ir-instr-scalar-fact branch)
                  [(compiler_ir_types.CompilerIrInstrScalarFact.Branch
                      cond
                      true-label
                      false-label)
                    (if (and
                      (compiler-backend-branch-uses-var? cond dst)
                      (compiler-backend-branch-value-direct?
                        ctx.assignments
                        src
                        ctx.backend-state))
                      (compiler-backend-emit-fused-not-branch-rest
                        ctx
                        fallthrough
                        dst
                        src
                        (compiler_ast_types.AstType.Bool)
                        true-label
                        false-label
                        instrs
                        after-branch
                        out)
                      (compiler-backend-emit-instrs-normal
                        ctx
                        fallthrough
                        instr
                        instrs
                        rest
                        out))]
                  [_
                    (compiler-backend-emit-instrs-normal
                      ctx
                      fallthrough
                      instr
                      instrs
                      rest
                      out)]))
              (compiler-backend-emit-instrs-normal
                ctx
                fallthrough
                instr
                instrs
                rest
                out))
            (compiler-backend-emit-instrs-normal
              ctx
              fallthrough
              instr
              instrs
              rest
              out))]
        [_
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            instr
            instrs
            rest
            out)]))
    (ResultCompilerBackend.Ok "")))

(define (compiler-backend-emit-instrs-divmod-polish-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (< index instrs.len)
    (let
      [instr : compiler_ir_types.CompilerIrInstr
        (compiler_ir_types.compiler-ir-instr-seq-ref instrs index)]
      [rest : i64 (+ index 1)]
      (match (compiler-backend-try-divmod-polish
        ctx
        fallthrough
        instr
        instrs
        rest
        out)
        [(CompilerBackendMaybeDivmodPolish.Some result) result]
        [(CompilerBackendMaybeDivmodPolish.No)
          (compiler-backend-emit-instrs-step ctx fallthrough instrs index out)]))
    (compiler-backend-emit-instrs-step ctx fallthrough instrs index out)))

;; Drift-proof per-instruction position for the scavenge coordinate. `post-base`
;; is the cumulative instruction count through the current block (accumulated per
;; block in emit-blocks-into, reset per function in install-ctx); the structural
;; index of the head of `current-instrs` is `post-base - (count current-instrs)`,
;; which equals the interval walk's I (point = 2*I), fusion-proof because the emit
;; loop maintains current-instrs (consuming K drops its length by K). Consumed
;; under (cfg scavenge-self-check) to verify, and later by the no-dst scavenge.
;; The remaining-instruction count at the current emit step, captured per step so
;; the no-dst scavenge (compiler-backend-scavenge-reg-here) can derive its point =
;; 2*(post-base - count). Stored as a count, not the list, because the list is a
;; loop-carried owner value that cannot be moved into a global. No asm output.
;; Function-wide structural instruction ordinal of the current emit step. The
;; optimizer may clone or reuse an IR destination vreg, so backend-local labels
;; that surround one instruction need this site identity rather than assuming
;; `(block, dst)` is unique. Unlike current-count, this is always exact even for
;; stack-only plans because label identity is independent of register planning.
(define (compiler-backend-emit-needs-current-count?
  [plan-mask : i64]
  [const-hoist-sites : i64]
  [backend-mode : CompilerBackendMode]) : bool
  (or
    ;; Scratch-plan lookup is keyed by the exact global instruction point even
    ;; when an opt0/opt1 function has no ordinary register homes (plan-mask 0).
    (compiler-backend-scratch-vreg-enabled?)
    (not (= plan-mask 0))
    (not (= const-hoist-sites 0))
    ;; AVX2 predicated-store lane labels use the instruction point as their
    ;; identity. Even a stack-only plan therefore needs the exact count so two
    ;; stores in one block cannot emit the same local labels.
    (compiler-backend-mode-avx2? backend-mode)))

(define (compiler-backend-emit-instrs-loop
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [mode : CompilerBackendEmitInstrsMode]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [current-mode : CompilerBackendEmitInstrsMode mode]
    ;; `current-count` is read BEFORE `current-instrs` takes ownership of the
    ;; sequence: the binding is an owner move, so `instrs` is not readable
    ;; afterwards. It is refreshed alongside the cursor on every continue.
    [current-count : i64 instrs.len]
    [current-instrs : compiler_ir_types.CompilerIrInstrSeq instrs]
    [current-index : i64 index]
    [done : bool false]
    [ok : bool true]
    [asm-out : String ""]
    [diag-out : (Box compiler_diagnostic.CompilerDiagnostic)
      (box (compiler_diagnostic.compiler-diagnostic-at-start "" ""))]
    (begin
      (compiler-backend-function-state-set-bool!
        ctx.function-state
        compiler-backend-function-bool-emit-instrs-loop-active
        true)
      (while (not done)
        (let
          [step-mark : i64 (compiler-backend-asm-buf-len out)]
          [step-result : ResultCompilerBackend
            (begin
              ;; The remaining-instruction count derives the
              ;; scavenge/const-hoist/scratch point 2*(post-base - count).
              ;; With the cursor the count IS `current-count - current-index`,
              ;; read off the block sequence length instead of walked: the
              ;; pre-cursor spine recomputed it once per emitted instruction,
              ;; an O(n^2) cons-spine walk per block. The needs-count? guard
              ;; stays because the answer must still be 0 (not the true
              ;; remaining count) for plans that must not see a point at all -
              ;; when the plan homes nothing in registers (zero plan mask -
              ;; every stack-only opt0/opt1 plan) the occupancy masks carry no
              ;; set bits, so every mask query answers 0 at any point, and with
              ;; no const-hoist sites the point comparisons are unreachable.
              ;; AVX2 also uses this point to make predicated-store lane labels
              ;; unique and retains the count.
              (compiler-backend-function-state-set-emit-current-site!
                ctx.function-state
                (-
                  (compiler-backend-function-state-emit-instr-post-base
                    ctx.function-state)
                  (- current-count current-index)))
              (compiler-backend-function-state-set-emit-current-count!
                ctx.function-state
                (if (compiler-backend-emit-needs-current-count?
                  (compiler-backend-function-scratch-i64
                    ctx.function-state
                    compiler-backend-scratch-i64-scavenge-plan-reg-mask)
                  (compiler-backend-function-scratch-i64
                    ctx.function-state
                    compiler-backend-scratch-i64-const-hoist-site-count)
                  (compiler-backend-function-state-current-mode
                    ctx.function-state))
                  (- current-count current-index)
                  0))
              (cfg
                scavenge-self-check
                (if (< current-index current-count)
                  ;; Per-step used-var check against the LIVE installed ctx
                  ;; (real point). Live-through validation is done by the
                  ;; function-level scavenge-self-check (which has the liveness
                  ;; to supply live-after sets); pass empty here.
                  (compiler-backend-scavenge-check-instr
                    (compiler-backend-function-scratch-i64-array
                      ctx.function-state
                      compiler-backend-scratch-i64-array-scavenge-starts)
                    (compiler-backend-function-scratch-i64-array
                      ctx.function-state
                      compiler-backend-scratch-i64-array-scavenge-ends)
                    (compiler-backend-function-scratch-assignment-index
                      ctx.function-state)
                    (compiler-backend-function-scratch-i64
                      ctx.function-state
                      compiler-backend-scratch-i64-scavenge-vars)
                    ctx.function
                    (*
                      2
                      (-
                        (compiler-backend-function-state-emit-instr-post-base
                          ctx.function-state)
                        (- current-count current-index)))
                    (compiler_ir_types.compiler-ir-instr-seq-ref
                      current-instrs
                      current-index)
                    (compiler_liveness.compiler-live-set-empty))
                  unit)
                unit)
              (compiler-backend-function-state-set-bool!
                ctx.function-state
                compiler-backend-function-bool-emit-instrs-continue-pending
                false)
              (compiler-backend-function-scratch-set-i64!
                ctx.function-state
                compiler-backend-scratch-i64-current-planned-preserve-count
                0)
              (compiler-backend-function-scratch-set-i64!
                ctx.function-state
                compiler-backend-scratch-i64-current-planned-local-preserve-count
                0)
              ;; Fast and fused emitters can bypass compiler-backend-emit-instr.
              ;; Install the head instruction's source context at the shared
              ;; dispatch seam so every abort guard sees the correct site.
              ;; Fusions that emit a later div/mod instruction still enter
              ;; compiler-backend-emit-instr for that instruction and replace
              ;; this state with its exact source location.
              (if (< current-index current-count)
                (compiler-backend-runtime-abort-site-install!
                  ctx
                  (compiler_ir_types.compiler-ir-instr-seq-ref
                    current-instrs
                    current-index))
                unit)
              (match current-mode
                [(CompilerBackendEmitInstrsMode.Normal)
                  (compiler-backend-emit-instrs-divmod-polish-step
                    ctx
                    fallthrough
                    current-instrs
                    current-index
                    out)]
                [(CompilerBackendEmitInstrsMode.Rax rax-var rax-ty)
                  (compiler-backend-emit-instrs-with-rax-step
                    ctx
                    fallthrough
                    rax-var
                    rax-ty
                    current-instrs
                    current-index
                    out)]
                [(CompilerBackendEmitInstrsMode.CallRax rax-var rax-ty)
                  (compiler-backend-emit-instrs-with-call-rax-step
                    ctx
                    fallthrough
                    rax-var
                    rax-ty
                    current-instrs
                    current-index
                    out)]))]
          (match step-result
            [(ResultCompilerBackend.Ok asm)
              (begin
                (compiler-backend-emergency-wrap-appended
                  out
                  step-mark
                  ctx.backend-state)
                (if (compiler-backend-function-state-bool?
                  ctx.function-state
                  compiler-backend-function-bool-emit-instrs-continue-pending)
                  (begin
                    (set!
                      current-mode
                      (compiler-backend-function-state-next-mode
                        ctx.function-state))
                    (set!
                      current-instrs
                      (compiler-backend-function-state-next-instrs
                        ctx.function-state))
                    (set!
                      current-index
                      (compiler-backend-function-state-i64
                        ctx.function-state
                        compiler-backend-function-i64-emit-instrs-next-index))
                    (set! current-count current-instrs.len)
                    unit)
                  (begin
                    (set! asm-out asm)
                    (set! done true))))]
            [(ResultCompilerBackend.Err message)
              (begin
                (set! diag-out message)
                (set! ok false)
                (set! done true))])))
      (compiler-backend-function-state-set-bool!
        ctx.function-state
        compiler-backend-function-bool-emit-instrs-loop-active
        false)
      (if ok
        (ResultCompilerBackend.Ok asm-out)
        (ResultCompilerBackend.Err diag-out)))))

(define (compiler-backend-emit-instrs
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (compiler-backend-function-state-bool?
    ctx.function-state
    compiler-backend-function-bool-emit-instrs-loop-active)
    (compiler-backend-emit-instrs-set-continue!
      ctx.function-state
      (CompilerBackendEmitInstrsMode.Normal)
      instrs
      index)
    (compiler-backend-emit-instrs-loop
      ctx
      fallthrough
      (CompilerBackendEmitInstrsMode.Normal)
      instrs
      index
      out)))

(define (compiler-backend-emit-instrs-with-call-rax
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (compiler-backend-function-state-bool?
    ctx.function-state
    compiler-backend-function-bool-emit-instrs-loop-active)
    (compiler-backend-emit-instrs-set-continue!
      ctx.function-state
      (CompilerBackendEmitInstrsMode.CallRax rax-var rax-ty)
      instrs
      index)
    (compiler-backend-emit-instrs-loop
      ctx
      fallthrough
      (CompilerBackendEmitInstrsMode.CallRax rax-var rax-ty)
      instrs
      index
      out)))

(define (compiler-backend-emit-instrs-with-rax
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : compiler_ast_types.AstType]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [index : i64]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (compiler-backend-function-state-bool?
    ctx.function-state
    compiler-backend-function-bool-emit-instrs-loop-active)
    (compiler-backend-emit-instrs-set-continue!
      ctx.function-state
      (CompilerBackendEmitInstrsMode.Rax rax-var rax-ty)
      instrs
      index)
    (compiler-backend-emit-instrs-loop
      ctx
      fallthrough
      (CompilerBackendEmitInstrsMode.Rax rax-var rax-ty)
      instrs
      index
      out)))

(define (compiler-backend-emit-block
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [block : compiler_ir_types.CompilerIrBlock]
  [fallthrough : CompilerBackendMaybeLabel]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [ret-ty : compiler_ast_types.AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [func-diag : compiler_diagnostic.CompilerDiagnostic]
  [use-counts : (__tl_dyn-array i64)]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match block
    [(compiler_ir_types.CompilerIrBlock.Block label instrs)
      (begin
        (compiler-backend-function-state-set-i64!
          (compiler-backend-state-function-state program-index.backend-state)
          compiler-backend-function-i64-current-block-label
          label)
        ;; The block header goes in FIRST now that instructions append straight
        ;; into the body buffer. Both injection lookups and the label text are
        ;; pure reads of state frozen before emission (const-hoist-build! runs
        ;; per function, ahead of emit-blocks), so the bytes are identical to
        ;; the former "emit body, then concatenate the header in front" order.
        ;;
        ;; M-F: loop-hoisted constant loads registered for this block.
        ;; Before-label entries (header-is-entry-block loops) land at prologue
        ;; end, once per call; after-label entries run at a dedicated
        ;; preheader's start, once per loop entry. "" for every other block.
        ;; `compiler-backend-asm-label` is spelled out here so the label's four
        ;; parts land in the body buffer directly instead of through a fresh
        ;; per-block label String.
        (compiler-backend-asm-append
          out
          (compiler-backend-const-hoist-injection-for
            (compiler-backend-state-function-state program-index.backend-state)
            label
            true))
        (compiler-backend-asm-append5
          out
          ".L"
          (compiler-backend-asm-safe-symbol function)
          "_"
          (compiler_ir_types.compiler-ir-label-text label)
          ":\n")
        (compiler-backend-asm-append
          out
          (compiler-backend-const-hoist-injection-for
            (compiler-backend-state-function-state program-index.backend-state)
            label
            false))
        (compiler-backend-emit-instrs
          (CompilerBackendEmissionContext
            type-segment-bases
            target
            function
            source-function
            blocks
            label
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            span-index
            func-diag
            use-counts
            program-index.backend-state
            (compiler-backend-state-function-state program-index.backend-state))
          fallthrough
          instrs
          0
          out))]))

;; Total IR instruction count over a function's blocks, read from the per-block
;; sequence lengths the emit loop already consults. Used only to size the body
;; buffer.
(define (compiler-backend-blocks-instr-count-seq
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]
  [acc : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    acc
    (compiler-backend-blocks-instr-count-seq
      blocks
      (+ index 1)
      (+
        acc
        (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
          [(compiler_ir_types.CompilerIrBlock.Block _ instrs) instrs.len])))))

(define (compiler-backend-blocks-instr-count
  [blocks : compiler_ir_types.CompilerIrBlockList]) : i64
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) 0]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (+
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block _ instrs) instrs.len])
        (compiler-backend-blocks-instr-count (__tl-box-place rest)))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-blocks-instr-count-seq seq 0 0)]))

(define (compiler-backend-next-block-label
  [blocks : compiler_ir_types.CompilerIrBlockList]) : CompilerBackendMaybeLabel
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (CompilerBackendMaybeLabel.No)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block _)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block label _)
          (CompilerBackendMaybeLabel.Some label)])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-next-block-label-seq seq 0)]))

(define (compiler-backend-next-block-label-seq
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]) : CompilerBackendMaybeLabel
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    (CompilerBackendMaybeLabel.No)
    (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
      [(compiler_ir_types.CompilerIrBlock.Block label _)
        (CompilerBackendMaybeLabel.Some label)])))

(define (compiler-backend-emit-block-seq-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : i64]
  [all-blocks : compiler_ir_types.CompilerIrBlockList]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [ret-ty : compiler_ast_types.AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [func-diag : compiler_diagnostic.CompilerDiagnostic]
  [use-counts : (__tl_dyn-array i64)]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    (ResultCompilerBackend.Ok "")
    (let
      [block : compiler_ir_types.CompilerIrBlock
        (compiler_ir_types.compiler-ir-block-seq-ref blocks index)]
      [mark : i64 (compiler-backend-asm-buf-len (& out))]
      (begin
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
            (let
              [function-state : CompilerBackendFunctionState
                (compiler-backend-state-function-state
                  program-index.backend-state)]
              (compiler-backend-function-state-set-emit-instr-post-base!
                function-state
                (+
                  (compiler-backend-function-state-emit-instr-post-base
                    function-state)
                  instrs.len)))])
        (match (compiler-backend-emit-block
          type-segment-bases
          target
          function
          source-function
          all-blocks
          block
          (compiler-backend-next-block-label-seq blocks (+ index 1))
          assignments
          vars
          types
          global-types
          ret-ty
          plan
          functions
          externs
          program-index
          spans
          span-index
          func-diag
          use-counts
          out)
          [(ResultCompilerBackend.Ok _)
            (begin
              (compiler-backend-emergency-wrap-appended
                out
                mark
                program-index.backend-state)
              (compiler-backend-emit-block-seq-into
                type-segment-bases
                target
                function
                source-function
                all-blocks
                blocks
                (+ index 1)
                assignments
                vars
                types
                global-types
                ret-ty
                plan
                functions
                externs
                program-index
                spans
                span-index
                func-diag
                use-counts
                out))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])))))

(define (compiler-backend-emit-blocks-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : i64]
  [all-blocks : compiler_ir_types.CompilerIrBlockList]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [ret-ty : compiler_ast_types.AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [func-diag : compiler_diagnostic.CompilerDiagnostic]
  [use-counts : (__tl_dyn-array i64)]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) (ResultCompilerBackend.Ok "")]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (let
        [mark : i64 (compiler-backend-asm-buf-len (& out))]
        (begin
          (match block
            [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
              (let
                [function-state : CompilerBackendFunctionState
                  (compiler-backend-state-function-state
                    program-index.backend-state)]
                (compiler-backend-function-state-set-emit-instr-post-base!
                  function-state
                  (+
                    (compiler-backend-function-state-emit-instr-post-base
                      function-state)
                    instrs.len)))])
          (match (compiler-backend-emit-block
            type-segment-bases
            target
            function
            source-function
            all-blocks
            block
            (compiler-backend-next-block-label (__tl-box-place rest))
            assignments
            vars
            types
            global-types
            ret-ty
            plan
            functions
            externs
            program-index
            spans
            span-index
            func-diag
            use-counts
            out)
            [(ResultCompilerBackend.Ok _)
              (begin
                (compiler-backend-emergency-wrap-appended
                  out
                  mark
                  program-index.backend-state)
                (compiler-backend-emit-blocks-into
                  type-segment-bases
                  target
                  function
                  source-function
                  all-blocks
                  (__tl-box-place rest)
                  assignments
                  vars
                  types
                  global-types
                  ret-ty
                  plan
                  functions
                  externs
                  program-index
                  spans
                  span-index
                  func-diag
                  use-counts
                  out))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)])))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-emit-block-seq-into
        type-segment-bases
        target
        function
        source-function
        all-blocks
        seq
        0
        assignments
        vars
        types
        global-types
        ret-ty
        plan
        functions
        externs
        program-index
        spans
        span-index
        func-diag
        use-counts
        out)]))

(define (compiler-backend-emit-blocks
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [function : String]
  [source-function : i64]
  [all-blocks : compiler_ir_types.CompilerIrBlockList]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [types : compiler_regalloc.CompilerRegVarTypes]
  [global-types : CompilerBackendGlobalTypeTable]
  [ret-ty : compiler_ast_types.AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [func-diag : compiler_diagnostic.CompilerDiagnostic]
  [use-counts : (__tl_dyn-array i64)]) : ResultCompilerBackend
  ;; One body buffer per function: the whole block/instruction spine appends
  ;; into it and this is the single finish boundary, handing the pipeline the
  ;; same body String emit-blocks always returned.
  (let
    [out : CompilerBackendAsmBuf
      (compiler-backend-asm-buf-with-capacity
        (+
          compiler-backend-asm-seq-capacity
          (*
            (compiler-backend-blocks-instr-count blocks)
            compiler-backend-asm-bytes-per-instr)))]
    (match (compiler-backend-emit-blocks-into
      type-segment-bases
      target
      function
      source-function
      all-blocks
      blocks
      assignments
      vars
      types
      global-types
      ret-ty
      plan
      functions
      externs
      program-index
      spans
      span-index
      func-diag
      use-counts
      (&mut out))
      [(ResultCompilerBackend.Ok _)
        (ResultCompilerBackend.Ok (compiler-backend-asm-buf-finish (& out)))]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

;; Move INCOMING parameters into their local frame slots. Register
;; params come from rdi/rsi/.. (or xmm0..) per the calling convention; params
;; beyond a bank's registers are read back from the caller's stack frame at
;; `compiler-backend-incoming-stack-arg-offset`, indexed by a sequential
;; stack-param counter that mirrors the call site.
(define (compiler-backend-spmd-private-function?
  [backend-state : CompilerBackendState]
  [name : i64]) : bool
  (or
    (compiler-backend-spmd-varying-return-function? backend-state name)
    (compiler-backend-spmd-mask-return-function? backend-state name)
    (compiler-backend-spmd-symbol-prefix?
      backend-state
      name
      "__tl_spmd_ret_uniform_")))

(define (compiler-backend-spmd-varying-param? [name : String]) : bool
  (compiler-backend-string-prefix-at? name "__tl_spmd_varying_arg_" 0))

(define (compiler-backend-spmd-mask-param? [name : String]) : bool
  (compiler-backend-string-prefix-at? name "__tl_spmd_mask_arg_" 0))

(define (compiler-backend-spmd-active-mask-param? [name : String]) : bool
  (compiler-backend-string-prefix-at? name "__tl_spmd_active_mask" 0))

(define (compiler-backend-spmd-private-vector-arg-reg [index : i64]) : String
  (if (and (>= index 0) (< index 8))
    (str_cat.str-cat "%zmm" (string.int->string (+ 17 index)))
    ""))

(define (compiler-backend-spmd-private-mask-arg-reg [index : i64]) : String
  (if (and (>= index 0) (< index 5))
    (str_cat.str-cat "%k" (string.int->string (+ 2 index)))
    ""))

(define (compiler-backend-emit-spmd-private-special-param
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [name : String]
  [ty : compiler_ast_types.AstType]
  [var-id : i64]
  [vector-index : i64]
  [mask-index : i64]
  [special-index : i64]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (if (compiler-backend-var-never-used? backend-state var-id)
    (ResultCompilerBackend.Ok "")
    (cond
      [(compiler-backend-current-mode-avx2?
          (compiler-backend-state-function-state backend-state))
        (let
          [storage-ty : compiler_ast_types.AstType
            (if (compiler-backend-spmd-varying-param? name)
              ty
              (compiler_ast_types.AstType.I8))]
          (match (compiler-backend-vector-dst-reg
            assignments
            var-id
            "private AVX2 SPMD helper parameter"
            "ymm"
            "%ymm14"
            backend-state)
            [(ResultBackendReg.Ok home)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  "    vmovdqu "
                  (string.int->string (* 32 special-index))
                  "(%r10), "
                  home
                  "\n"
                  (compiler-backend-vector-store-dst
                    assignments
                    var-id
                    "ymm"
                    storage-ty
                    home
                    backend-state)))]
            [(ResultBackendReg.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler_diagnostic.compiler-diagnostic-at-start "" message)))]))]
      [(compiler-backend-spmd-varying-param? name)
        (let
          [incoming : String
            (compiler-backend-spmd-private-vector-arg-reg vector-index)]
          (if (= (string.string-length incoming) 0)
            (ResultCompilerBackend.Err
              (box
                (compiler_diagnostic.compiler-diagnostic-at-start
                  ""
                  "backend: private AVX-512 SPMD call supports at most 8 varying value arguments")))
            (match (compiler-backend-emit-assignment-lookup
              backend-state
              assignments
              var-id)
              [(compiler_regalloc.CompilerRegMaybeLocation.No)
                (ResultCompilerBackend.Ok "")]
              [(compiler_regalloc.CompilerRegMaybeLocation.Some _)
                (match (compiler-backend-vector-var-reg
                  backend-state
                  assignments
                  var-id
                  "private SPMD helper parameter"
                  "zmm")
                  [(ResultBackendReg.Ok home)
                    (ResultCompilerBackend.Ok
                      (if (string.eq incoming home)
                        ""
                        (str_cat.str-cat
                          "    "
                          (compiler-backend-avx512-vector-move ty)
                          " "
                          incoming
                          ", "
                          home
                          "\n")))]
                  [(ResultBackendReg.Err message)
                    (ResultCompilerBackend.Err
                      (box
                        (compiler_diagnostic.compiler-diagnostic-at-start
                          ""
                          message)))])])))]
      [else
        (let
          [incoming : String
            (if (compiler-backend-spmd-active-mask-param? name)
              "%k1"
              (compiler-backend-spmd-private-mask-arg-reg mask-index))]
          (if (= (string.string-length incoming) 0)
            (ResultCompilerBackend.Err
              (box
                (compiler_diagnostic.compiler-diagnostic-at-start
                  ""
                  "backend: private AVX-512 SPMD call supports at most 5 varying bool arguments")))
            (match (compiler-backend-avx512-mask-dst-reg
              assignments
              var-id
              "private SPMD helper mask parameter"
              "%k7"
              backend-state)
              [(ResultBackendReg.Ok home)
                (ResultCompilerBackend.Ok
                  (str_cat.str-cat
                    (if (string.eq incoming home)
                      ""
                      (str_cat.str-cat "    kmovq " incoming ", " home "\n" ""))
                    (compiler-backend-avx512-mask-store-dst
                      assignments
                      var-id
                      64
                      home
                      backend-state)
                    ""))]
              [(ResultBackendReg.Err message)
                (ResultCompilerBackend.Err
                  (box
                    (compiler_diagnostic.compiler-diagnostic-at-start
                      ""
                      message)))])))])))

(define (compiler-backend-emit-spmd-private-param-spills-from
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [params : compiler_ir_types.CompilerIrParamList]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [stack-idx : i64]
  [vector-index : i64]
  [mask-index : i64]
  [special-index : i64]
  [vars : i64]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (match (compiler_ir_types.compiler-ir-param-list-force-cons params)
    [(compiler_ir_types.CompilerIrParamList.Nil) (ResultCompilerBackend.Ok "")]
    [(compiler_ir_types.CompilerIrParamList.Array seq)
      (compiler-backend-emit-spmd-private-param-spills-from
        type-segment-bases
        target
        assignments
        (compiler_ir_types.compiler-ir-param-seq-to-list seq)
        int-idx
        float-idx
        position
        stack-idx
        vector-index
        mask-index
        special-index
        vars
        backend-state)]
    [(compiler_ir_types.CompilerIrParamList.Cons param rest)
      (match param
        [(compiler_ir_types.CompilerIrParam.Param name ty var-id)
          (let
            [active? : bool (compiler-backend-spmd-active-mask-param? name)]
            [varying? : bool (compiler-backend-spmd-varying-param? name)]
            [mask? : bool (compiler-backend-spmd-mask-param? name)]
            [special? : bool (or active? varying? mask?)]
            [is-float : bool (compiler-backend-float-type? ty)]
            [on-stack : bool
              (if special?
                false
                (compiler-backend-stack-call-arg-for-banks?
                  target
                  is-float
                  int-idx
                  float-idx
                  position))]
            (match (if special?
              (compiler-backend-emit-spmd-private-special-param
                assignments
                name
                ty
                var-id
                vector-index
                mask-index
                special-index
                backend-state)
              (if on-stack
                (ResultCompilerBackend.Ok
                  (let
                    [addr : String
                      (compiler-backend-frame-offset-with-backend-state
                        backend-state
                        (compiler-backend-incoming-stack-arg-offset
                          target
                          stack-idx))]
                    (if is-float
                      (compiler-backend-emit-load-float-address-to-var
                        assignments
                        var-id
                        addr
                        ty
                        ""
                        backend-state)
                      (compiler-backend-emit-load-scalar-address-to-var
                        type-segment-bases
                        assignments
                        var-id
                        addr
                        ty
                        (__tl_make-array String 0)
                        0
                        ""
                        backend-state))))
                (match (if is-float
                  (compiler-backend-target-float-arg-reg-for-banks
                    target
                    float-idx
                    position)
                  (compiler-backend-target-arg-reg-for-banks
                    target
                    int-idx
                    position))
                  [(ResultBackendReg.Ok reg)
                    (ResultCompilerBackend.Ok
                      (compiler-backend-emit-store-typed-var-with-plan
                        assignments
                        var-id
                        reg
                        ty
                        backend-state))]
                  [(ResultBackendReg.Err message)
                    (ResultCompilerBackend.Err
                      (box
                        (compiler_diagnostic.compiler-diagnostic-at-start
                          ""
                          message)))])))
              [(ResultCompilerBackend.Ok head)
                (match (compiler-backend-emit-spmd-private-param-spills-from
                  type-segment-bases
                  target
                  assignments
                  (__tl-box-place rest)
                  (if (or special? is-float)
                    int-idx
                    (+ int-idx 1))
                  (if (or special? (not is-float))
                    float-idx
                    (+ float-idx 1))
                  (if special?
                    position
                    (+ position 1))
                  (if on-stack
                    (+ stack-idx 1)
                    stack-idx)
                  (if varying?
                    (+ vector-index 1)
                    vector-index)
                  (if mask?
                    (+ mask-index 1)
                    mask-index)
                  (if special?
                    (+ special-index 1)
                    special-index)
                  vars
                  backend-state)
                  [(ResultCompilerBackend.Ok tail)
                    (ResultCompilerBackend.Ok (str_cat.str-cat head tail))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)]))])]))

(define (compiler-backend-emit-spmd-private-param-spills
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [params : compiler_ir_types.CompilerIrParamList]
  [vars : i64]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (compiler-backend-emit-spmd-private-param-spills-from
    type-segment-bases
    target
    assignments
    params
    0
    0
    0
    0
    0
    0
    0
    vars
    backend-state))

(define (compiler-backend-emit-private-memory-param-address
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [all-params : compiler_ir_types.CompilerIrParamList]
  [var-id : i64]
  [addr : String]
  [backend-state : CompilerBackendState]) : String
  (let
    [home : String
      (compiler-backend-var-register-home backend-state assignments var-id)]
    (if (string.eq home "")
      (let
        [exclude : (__tl_dyn-array String)
          (compiler-backend-param-register-exclude
            backend-state
            all-params
            assignments)]
        [exclude-n : i64
          (compiler-backend-param-register-exclude-count
            backend-state
            all-params
            assignments)]
        [scratch : String
          (compiler-backend-scavenge-pick-with-mask
            (compiler-backend-state-function-state backend-state)
            0
            exclude
            exclude-n
            "%r8")]
        (str_cat.str-cat
          "    leaq "
          addr
          ", "
          scratch
          "\n"
          (compiler-backend-emit-store-var-with-plan
            assignments
            var-id
            scratch
            backend-state)))
      (str_cat.str-cat "    leaq " addr ", " home "\n"))))

(define (compiler-backend-emit-param-spills-from
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [all-params : compiler_ir_types.CompilerIrParamList]
  [params : compiler_ir_types.CompilerIrParamList]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [stack-idx : i64]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (match (compiler_ir_types.compiler-ir-param-list-force-cons params)
    [(compiler_ir_types.CompilerIrParamList.Nil) (ResultCompilerBackend.Ok "")]
    [(compiler_ir_types.CompilerIrParamList.Array seq)
      (compiler-backend-emit-param-spills-from
        type-segment-bases
        target
        assignments
        all-params
        (compiler_ir_types.compiler-ir-param-seq-to-list seq)
        int-idx
        float-idx
        position
        stack-idx
        program-index
        vars
        backend-state)]
    [(compiler_ir_types.CompilerIrParamList.Cons param rest)
      (match param
        [(compiler_ir_types.CompilerIrParam.Param _ ty var-id)
          (let
            [is-float : bool (compiler-backend-float-type? ty)]
            [next-int : i64
              (if is-float
                int-idx
                (+ int-idx 1))]
            [next-float : i64
              (if is-float
                (+ float-idx 1)
                float-idx)]
            [private-memory-size : i64
              (compiler-backend-abi-memory-size type-segment-bases ty)]
            ;; A register-group parameter occupies two eightbytes.
            ;; INTEGER words advance the integer bank; SSE words advance the float
            ;; bank. This mirrors emit-call-args so self-calls agree on register vs
            ;; stack placement for mixed-bank aggregate words.
            (cond
              [(and
                  (compiler-backend-target-linux? target)
                  (> private-memory-size 0))
                (match (compiler-backend-emit-param-spills-from
                  type-segment-bases
                  target
                  assignments
                  all-params
                  (__tl-box-place rest)
                  int-idx
                  float-idx
                  (+ position 1)
                  (+
                    stack-idx
                    (compiler-backend-stack-slots-for-size private-memory-size))
                  program-index
                  vars
                  backend-state)
                  [(ResultCompilerBackend.Ok tail)
                    (ResultCompilerBackend.Ok
                      (str_cat.str-cat
                        tail
                        (compiler-backend-emit-private-memory-param-address
                          assignments
                          all-params
                          var-id
                          (compiler-backend-frame-offset-with-backend-state
                            backend-state
                            (compiler-backend-incoming-stack-arg-offset
                              target
                              stack-idx))
                          backend-state)))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])]
              [(compiler-backend-group-type?
                  type-segment-bases
                  program-index
                  ty)
                (let
                  [linux-group-fits : bool
                    (compiler-backend-linux-group-register-banks-fit?
                      type-segment-bases
                      target
                      program-index
                      ty
                      int-idx
                      float-idx
                      position)]
                  [param-exclude : (__tl_dyn-array String)
                    (compiler-backend-param-register-exclude
                      backend-state
                      all-params
                      assignments)]
                  [param-exclude-n : i64
                    (compiler-backend-param-register-exclude-count
                      backend-state
                      all-params
                      assignments)]
                  [w0-sse : bool
                    (compiler-backend-group-word-sse?
                      type-segment-bases
                      program-index
                      ty
                      0)]
                  [w0-stack : bool
                    (compiler-backend-stack-call-arg-for-banks?
                      target
                      w0-sse
                      int-idx
                      float-idx
                      position)]
                  [int1 : i64
                    (if w0-sse
                      int-idx
                      (+ int-idx 1))]
                  [float1 : i64
                    (if w0-sse
                      (+ float-idx 1)
                      float-idx)]
                  [stack1 : i64
                    (if w0-stack
                      (+ stack-idx 1)
                      stack-idx)]
                  [w1-sse : bool
                    (compiler-backend-group-word-sse?
                      type-segment-bases
                      program-index
                      ty
                      1)]
                  [w1-stack : bool
                    (compiler-backend-stack-call-arg-for-banks?
                      target
                      w1-sse
                      int1
                      float1
                      (+ position 1))]
                  (if (and
                    (compiler-backend-target-linux? target)
                    (not linux-group-fits))
                    (match (compiler-backend-emit-group-word-stack-param
                      type-segment-bases
                      target
                      assignments
                      var-id
                      0
                      stack-idx
                      vars
                      ty
                      program-index
                      param-exclude
                      param-exclude-n
                      backend-state)
                      [(ResultCompilerBackend.Ok head0)
                        (match (compiler-backend-emit-group-word-stack-param
                          type-segment-bases
                          target
                          assignments
                          var-id
                          1
                          (+ stack-idx 1)
                          vars
                          ty
                          program-index
                          param-exclude
                          param-exclude-n
                          backend-state)
                          [(ResultCompilerBackend.Ok head1)
                            (match (compiler-backend-emit-param-spills-from
                              type-segment-bases
                              target
                              assignments
                              all-params
                              (__tl-box-place rest)
                              int-idx
                              float-idx
                              (+ position 2)
                              (+ stack-idx 2)
                              program-index
                              vars
                              backend-state)
                              [(ResultCompilerBackend.Ok tail)
                                (ResultCompilerBackend.Ok
                                  (str_cat.str-cat tail head0 head1))]
                              [(ResultCompilerBackend.Err message)
                                (ResultCompilerBackend.Err message)])]
                          [(ResultCompilerBackend.Err message)
                            (ResultCompilerBackend.Err message)])]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err message)])
                    (match (compiler-backend-emit-group-word-param
                      type-segment-bases
                      target
                      assignments
                      var-id
                      0
                      int-idx
                      float-idx
                      position
                      stack-idx
                      vars
                      ty
                      program-index
                      param-exclude
                      param-exclude-n
                      backend-state)
                      [(ResultCompilerBackend.Ok head0)
                        (match (compiler-backend-emit-group-word-param
                          type-segment-bases
                          target
                          assignments
                          var-id
                          1
                          int1
                          float1
                          (+ position 1)
                          stack1
                          vars
                          ty
                          program-index
                          param-exclude
                          param-exclude-n
                          backend-state)
                          [(ResultCompilerBackend.Ok head1)
                            (match (compiler-backend-emit-param-spills-from
                              type-segment-bases
                              target
                              assignments
                              all-params
                              (__tl-box-place rest)
                              (if w1-sse
                                int1
                                (+ int1 1))
                              (if w1-sse
                                (+ float1 1)
                                float1)
                              (+ position 2)
                              (if w1-stack
                                (+ stack1 1)
                                stack1)
                              program-index
                              vars
                              backend-state)
                              [(ResultCompilerBackend.Ok tail)
                                (ResultCompilerBackend.Ok
                                  (str_cat.str-cat head0 head1 tail))]
                              [(ResultCompilerBackend.Err message)
                                (ResultCompilerBackend.Err message)])]
                          [(ResultCompilerBackend.Err message)
                            (ResultCompilerBackend.Err message)])]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err message)])))]
              [else
                (if (compiler-backend-stack-call-arg-for-banks?
                  target
                  is-float
                  int-idx
                  float-idx
                  position)
                  (match (compiler-backend-emit-param-spills-from
                    type-segment-bases
                    target
                    assignments
                    all-params
                    (__tl-box-place rest)
                    next-int
                    next-float
                    (+ position 1)
                    (+ stack-idx 1)
                    program-index
                    vars
                    backend-state)
                    [(ResultCompilerBackend.Ok tail)
                      (ResultCompilerBackend.Ok
                        (let
                          [addr : String
                            (compiler-backend-frame-offset-with-backend-state
                              backend-state
                              (compiler-backend-incoming-stack-arg-offset
                                target
                                stack-idx))]
                          [exclude-n : i64
                            (compiler-backend-param-register-exclude-count
                              backend-state
                              all-params
                              assignments)]
                          [exclude : (__tl_dyn-array String)
                            (compiler-backend-param-register-exclude
                              backend-state
                              all-params
                              assignments)]
                          (str_cat.str-cat
                            (if is-float
                              (compiler-backend-emit-load-float-address-to-var
                                assignments
                                var-id
                                addr
                                ty
                                ""
                                backend-state)
                              (compiler-backend-emit-load-scalar-address-to-var
                                type-segment-bases
                                assignments
                                var-id
                                addr
                                ty
                                exclude
                                exclude-n
                                (compiler-backend-scavenge-pick-with-mask
                                  (compiler-backend-state-function-state
                                    backend-state)
                                  0
                                  exclude
                                  exclude-n
                                  "%r8")
                                backend-state))
                            tail)))]
                    [(ResultCompilerBackend.Err message)
                      (ResultCompilerBackend.Err message)])
                  (match (if is-float
                    (compiler-backend-target-float-arg-reg-for-banks
                      target
                      float-idx
                      position)
                    (compiler-backend-target-arg-reg-for-banks
                      target
                      int-idx
                      position))
                    [(ResultBackendReg.Ok reg)
                      (match (compiler-backend-emit-param-spills-from
                        type-segment-bases
                        target
                        assignments
                        all-params
                        (__tl-box-place rest)
                        next-int
                        next-float
                        (+ position 1)
                        stack-idx
                        program-index
                        vars
                        backend-state)
                        [(ResultCompilerBackend.Ok tail)
                          (ResultCompilerBackend.Ok
                            (str_cat.str-cat
                              (compiler-backend-emit-store-typed-var-with-plan
                                assignments
                                var-id
                                reg
                                ty
                                backend-state)
                              tail))]
                        [(ResultCompilerBackend.Err message)
                          (ResultCompilerBackend.Err message)])]
                    [(ResultBackendReg.Err _)
                      (ResultCompilerBackend.Err
                        (box
                          (compiler_diagnostic.compiler-diagnostic-at-start
                            ""
                            "backend: too many params")))]))]))])]))

(define (compiler-backend-emit-param-spills
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [params : compiler_ir_types.CompilerIrParamList]
  [int-idx : i64]
  [float-idx : i64]
  [position : i64]
  [stack-idx : i64]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [backend-state : CompilerBackendState]) : ResultCompilerBackend
  (compiler-backend-emit-param-spills-from
    type-segment-bases
    target
    assignments
    params
    params
    int-idx
    float-idx
    position
    stack-idx
    program-index
    vars
    backend-state))

(define (compiler-backend-emit-windows-main-argv-capture
  [target : CompilerBackendTarget]
  [name : String]
  [emit-entry : bool]
  [plan : CompilerBackendRuntimePlan]) : String
  (if (and
    emit-entry
    (compiler-backend-target-windows? target)
    (string.eq name "main"))
    (let
      [_ : CompilerBackendRuntimePlan plan]
      "    movq %rcx, .L_tl_argc(%rip)
    movq %rdx, .L_tl_argv(%rip)
")
    ""))

(define (compiler-backend-emit-linux-crt-main-argv-capture
  [target : CompilerBackendTarget]
  [name : String]
  [crt-entry : bool]
  [plan : CompilerBackendRuntimePlan]) : String
  (if (and
    crt-entry
    (compiler-backend-target-linux? target)
    (string.eq name "main"))
    (let
      [_ : CompilerBackendRuntimePlan plan]
      "    movq %rdi, .L_tl_argc(%rip)
    movq %rsi, .L_tl_argv(%rip)
    movq %rdx, .L_tl_envp(%rip)
")
    ""))

;; ============================================================================
;; Register scavenger -- per-instruction occupied-register masks computed on the
;; FINAL post-rewrite IR (emit-blocks-list + assignments + slot-vars). The
;; backend uses this query to pick allocator-owned scratch registers, and
;; --cfg scavenge-self-check verifies the masks against liveness.
;;
;; Point space matches compiler-reg-live-intervals EXACTLY: the global I-th
;; emitted instruction (block-list order, then instr-seq order) lives at point
;; = 2*I. The self-check walks the same traversal, so the mapping is consistent
;; by construction; the checks below catch any divergence loudly via panic.
;; Does var v occupy `reg` (the register itself, or either half of a pair)?
;; Character-dispatch register-name -> scavenge bit. The scavenger queries
;; this per emitted operand; the eq-mnemonic ladder paid up to eighteen string
;; compares per call. Length plus three character reads decide every case.
;; Unknown names map to 0.
(define (compiler-backend-scavenge-reg-bit [reg : String]) : i64
  (let
    [n : i64 (string.string-length reg)]
    (cond
      [(or (< n 3) (> n 5)) 0]
      [(not (= (string.string-ref reg 0) '%')) 0]
      [(= n 3)
        (if (= (string.string-ref reg 1) 'r')
          (cond
            [(= (string.string-ref reg 2) '9') 1]
            [(= (string.string-ref reg 2) '8') 32]
            [else 0])
          0)]
      [(= n 4)
        (if (= (string.string-ref reg 1) 'r')
          (let
            [c2 : char (string.string-ref reg 2)]
            [c3 : char (string.string-ref reg 3)]
            (cond
              [(= c2 'c')
                (if (= c3 'x')
                  2
                  0)]
              [(= c2 'd') (cond [(= c3 'x') 4] [(= c3 'i') 131072] [else 0])]
              [(= c2 'a')
                (if (= c3 'x')
                  32768
                  0)]
              [(= c2 's')
                (if (= c3 'i')
                  65536
                  0)]
              [(= c2 'b')
                (if (= c3 'x')
                  1024
                  0)]
              [(= c2 '1')
                (cond
                  [(= c3 '0') 8]
                  [(= c3 '1') 16]
                  [(= c3 '2') 64]
                  [(= c3 '3') 128]
                  [(= c3 '4') 256]
                  [(= c3 '5') 512]
                  [else 0])]
              [else 0]))
          0)]
      [else
        (let
          [c1 : char (string.string-ref reg 1)]
          [c2 : char (string.string-ref reg 2)]
          [c3 : char (string.string-ref reg 3)]
          (if (or
            (and (or (= c1 'x') (= c1 'y') (= c1 'z')) (= c2 'm') (= c3 'm'))
            (and (= c1 'v') (= c2 'e') (= c3 'c')))
            (cond
              [(= (string.string-ref reg 4) '2') 2048]
              [(= (string.string-ref reg 4) '3') 4096]
              [(= (string.string-ref reg 4) '4') 8192]
              [(= (string.string-ref reg 4) '5') 16384]
              [else 0])
            0))])))

(define (compiler-backend-scavenge-emergency-reg-supported? [reg : String]) : bool
  (or
    (string.eq reg "%rax")
    (not (= (compiler-backend-scavenge-reg-bit reg) 0))))

(define (compiler-backend-scavenge-reg-id-bit [reg : i64]) : i64
  (cond
    [(= reg compiler_abi.compiler-reg-id-r9) 1]
    [(= reg compiler_abi.compiler-reg-id-rcx) 2]
    [(= reg compiler_abi.compiler-reg-id-rdx) 4]
    [(= reg compiler_abi.compiler-reg-id-r10) 8]
    [(= reg compiler_abi.compiler-reg-id-r11) 16]
    [(= reg compiler_abi.compiler-reg-id-r8) 32]
    [(= reg compiler_abi.compiler-reg-id-r12) 64]
    [(= reg compiler_abi.compiler-reg-id-r13) 128]
    [(= reg compiler_abi.compiler-reg-id-r14) 256]
    [(= reg compiler_abi.compiler-reg-id-r15) 512]
    [(= reg compiler_abi.compiler-reg-id-rbx) 1024]
    [(= reg compiler_abi.compiler-reg-id-rax) 32768]
    [(= reg compiler_abi.compiler-reg-id-rsi) 65536]
    [(= reg compiler_abi.compiler-reg-id-rdi) 131072]
    [else
      (let
        [family : i64
          (compiler_abi.compiler-abi-register-vector-family-index reg)]
        (cond
          [(= family 2) 2048]
          [(= family 3) 4096]
          [(= family 4) 8192]
          [(= family 5) 16384]
          [else 0]))]))

(define compiler-backend-scavenge-reg-bit-count : i64
  18)

(define (compiler-backend-scavenge-reg-bit-by-index [index : i64]) : i64
  (cond
    [(= index 0) 1]
    [(= index 1) 2]
    [(= index 2) 4]
    [(= index 3) 8]
    [(= index 4) 16]
    [(= index 5) 32]
    [(= index 6) 64]
    [(= index 7) 128]
    [(= index 8) 256]
    [(= index 9) 512]
    [(= index 10) 1024]
    [(= index 11) 2048]
    [(= index 12) 4096]
    [(= index 13) 8192]
    [(= index 14) 16384]
    [(= index 15) 32768]
    [(= index 16) 65536]
    [(= index 17) 131072]
    [else 0]))

(define (compiler-backend-scavenge-location-mask
  [location : compiler_regalloc.CompilerRegLocation]) : i64
  (match location
    [(compiler_regalloc.CompilerRegLocation.Register reg)
      (compiler-backend-scavenge-reg-id-bit reg)]
    [(compiler_regalloc.CompilerRegLocation.RegisterPair a b)
      (bit-or
        (compiler-backend-scavenge-reg-id-bit a)
        (compiler-backend-scavenge-reg-id-bit b))]
    [_ 0]))

(define (compiler-backend-scavenge-mask-bit-count [mask : i64]) : i64
  (let
    [bit-index : i64 0]
    [count : i64 0]
    (begin
      (while (< bit-index compiler-backend-scavenge-reg-bit-count)
        (let
          [bit : i64 (compiler-backend-scavenge-reg-bit-by-index bit-index)]
          (begin
            (if (not (= (bit-and mask bit) 0))
              (set! count (+ count 1))
              unit)
            (set! bit-index (+ bit-index 1)))))
      count)))

(define (compiler-backend-scavenge-occupancy-event-capacity
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [present : (__tl_dyn-array i64)]
  [items : (__tl_dyn-array compiler_regalloc.CompilerRegLocation)]
  [limit : i64]
  [vars : i64]
  [instr-count : i64]) : i64
  (let
    [v : i64 0]
    [events : i64 0]
    (begin
      (while (< v vars)
        (begin
          (if (and
            (< v limit)
            (not (= (array-ref present v) 0))
            (>= (array-ref starts v) 0)
            (>= (array-ref ends v) 0))
            (let
              [loc-mask : i64
                (compiler-backend-scavenge-location-mask (array-ref items v))]
              [start-i : i64 (/ (array-ref starts v) 2)]
              [raw-end-i : i64 (/ (array-ref ends v) 2)]
              [end-i : i64
                (if (>= raw-end-i instr-count)
                  (- instr-count 1)
                  raw-end-i)]
              (if (and (not (= loc-mask 0)) (<= start-i end-i))
                (set!
                  events
                  (+
                    events
                    (* 2 (compiler-backend-scavenge-mask-bit-count loc-mask))))
                unit))
            unit)
          (set! v (+ v 1))))
      (if (< events 1)
        1
        events))))

(define (compiler-backend-scavenge-exclude-mask
  [exclude : (__tl_dyn-array String)]
  [n : i64]) : i64
  (let
    [i : i64 0]
    [mask : i64 0]
    (begin
      (while (< i n)
        (begin
          (set!
            mask
            (bit-or
              mask
              (compiler-backend-scavenge-reg-bit (array-ref exclude i))))
          (set! i (+ i 1))))
      mask)))

(define (compiler-backend-scavenge-occupancy-instr-count
  [ends : (__tl_dyn-array i64)]
  [vars : i64]) : i64
  (let
    [v : i64 0]
    [max-end : i64 0]
    (begin
      (while (< v vars)
        (begin
          (if (>= (array-ref ends v) 0)
            (let
              [end-i : i64 (/ (array-ref ends v) 2)]
              (if (> end-i max-end)
                (set! max-end end-i)
                unit))
            unit)
          (set! v (+ v 1))))
      (+ max-end 1))))

(define (compiler-backend-scavenge-occupancy-add-event!
  [heads : (__tl_dyn-array i64)]
  [event-bits : (__tl_dyn-array i64)]
  [event-deltas : (__tl_dyn-array i64)]
  [event-next : (__tl_dyn-array i64)]
  [event : i64]
  [bit-index : i64]
  [delta : i64]
  [used : i64]) : i64
  (if (or
    (< event 0)
    (>= event (array-length heads))
    (>= used (array-length event-bits)))
    used
    (begin
      (set! (array-ref event-bits used) bit-index)
      (set! (array-ref event-deltas used) delta)
      (set! (array-ref event-next used) (array-ref heads event))
      (set! (array-ref heads event) used)
      (+ used 1))))

(define (compiler-backend-scavenge-occupancy-add-mask-events!
  [heads : (__tl_dyn-array i64)]
  [event-bits : (__tl_dyn-array i64)]
  [event-deltas : (__tl_dyn-array i64)]
  [event-next : (__tl_dyn-array i64)]
  [event : i64]
  [mask : i64]
  [delta : i64]
  [used : i64]) : i64
  (let
    [bit-index : i64 0]
    [out : i64 used]
    (begin
      (while (< bit-index compiler-backend-scavenge-reg-bit-count)
        (let
          [bit : i64 (compiler-backend-scavenge-reg-bit-by-index bit-index)]
          (begin
            (if (not (= (bit-and mask bit) 0))
              (set!
                out
                (compiler-backend-scavenge-occupancy-add-event!
                  heads
                  event-bits
                  event-deltas
                  event-next
                  event
                  bit-index
                  delta
                  out))
              unit)
            (set! bit-index (+ bit-index 1)))))
      out)))

(define (compiler-backend-scavenge-occupancy-add-range!
  [heads : (__tl_dyn-array i64)]
  [event-bits : (__tl_dyn-array i64)]
  [event-deltas : (__tl_dyn-array i64)]
  [event-next : (__tl_dyn-array i64)]
  [start-i : i64]
  [end-i : i64]
  [mask : i64]
  [used : i64]) : i64
  (compiler-backend-scavenge-occupancy-add-mask-events!
    heads
    event-bits
    event-deltas
    event-next
    (+ end-i 1)
    mask
    (- 0 1)
    (compiler-backend-scavenge-occupancy-add-mask-events!
      heads
      event-bits
      event-deltas
      event-next
      start-i
      mask
      1
      used)))

(define (compiler-backend-scavenge-occupancy-mask-at-event
  [heads : (__tl_dyn-array i64)]
  [event-bits : (__tl_dyn-array i64)]
  [event-deltas : (__tl_dyn-array i64)]
  [event-next : (__tl_dyn-array i64)]
  [active-counts : (__tl_dyn-array i64)]
  [event : i64]) : i64
  (let
    [node : i64 (array-ref heads event)]
    [_apply-events : unit
      (while (>= node 0)
        (let
          [bit-index : i64 (array-ref event-bits node)]
          [next : i64
            (+
              (array-ref active-counts bit-index)
              (array-ref event-deltas node))]
          (begin
            (set! (array-ref active-counts bit-index) next)
            (set! node (array-ref event-next node)))))]
    [bit-index : i64 0]
    [mask : i64 0]
    (begin
      (while (< bit-index compiler-backend-scavenge-reg-bit-count)
        (begin
          (if (> (array-ref active-counts bit-index) 0)
            (set!
              mask
              (bit-or
                mask
                (compiler-backend-scavenge-reg-bit-by-index bit-index)))
            unit)
          (set! bit-index (+ bit-index 1))))
      mask)))

(define (compiler-backend-scavenge-occupancy-build
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [assignment-index : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]) : (__tl_dyn-array i64)
  (let
    [instr-count : i64
      (compiler-backend-scavenge-occupancy-instr-count ends vars)]
    [event-count : i64 (+ instr-count 1)]
    [heads : (__tl_dyn-array i64) (__tl_make-array i64 event-count)]
    [present : (__tl_dyn-array i64) assignment-index.present]
    [items : (__tl_dyn-array compiler_regalloc.CompilerRegLocation)
      assignment-index.items]
    [limit : i64 (array-length present)]
    [max-events : i64
      (compiler-backend-scavenge-occupancy-event-capacity
        starts
        ends
        present
        items
        limit
        vars
        instr-count)]
    [event-bits : (__tl_dyn-array i64) (__tl_make-array i64 max-events)]
    [event-deltas : (__tl_dyn-array i64) (__tl_make-array i64 max-events)]
    [event-next : (__tl_dyn-array i64) (__tl_make-array i64 max-events)]
    [out : (__tl_dyn-array i64) (__tl_make-array i64 instr-count)]
    [active-counts : (__tl_dyn-array i64)
      (__tl_make-array i64 compiler-backend-scavenge-reg-bit-count)]
    [v : i64 0]
    [event-used : i64 0]
    (begin
      (compiler_regalloc.compiler-reg-fill-i64-array heads (- 0 1))
      (compiler_regalloc.compiler-reg-fill-i64-array event-next (- 0 1))
      (while (< v vars)
        (begin
          (if (and
            (< v limit)
            (not (= (array-ref present v) 0))
            (>= (array-ref starts v) 0)
            (>= (array-ref ends v) 0))
            (let
              [loc-mask : i64
                (compiler-backend-scavenge-location-mask (array-ref items v))]
              [start-i : i64 (/ (array-ref starts v) 2)]
              [raw-end-i : i64 (/ (array-ref ends v) 2)]
              [end-i : i64
                (if (>= raw-end-i instr-count)
                  (- instr-count 1)
                  raw-end-i)]
              (if (and (not (= loc-mask 0)) (<= start-i end-i))
                (set!
                  event-used
                  (compiler-backend-scavenge-occupancy-add-range!
                    heads
                    event-bits
                    event-deltas
                    event-next
                    start-i
                    end-i
                    loc-mask
                    event-used))
                unit))
            unit)
          (set! v (+ v 1))))
      (let
        [i : i64 0]
        (begin
          (while (< i instr-count)
            (begin
              (set!
                (array-ref out i)
                (compiler-backend-scavenge-occupancy-mask-at-event
                  heads
                  event-bits
                  event-deltas
                  event-next
                  active-counts
                  i))
              (set! i (+ i 1))))
          out)))))

(define (compiler-backend-scavenge-reg-free-in-mask?
  [occupied-mask : i64]
  [reg : String]) : bool
  (= (bit-and occupied-mask (compiler-backend-scavenge-reg-bit reg)) 0))

(define (compiler-backend-var-register-home-index
  [assignment-index
    : (& assignment-index compiler_regalloc.CompilerRegAssignmentTable)]
  [var : i64]) : String
  (compiler_abi.compiler-abi-register-spelling
    (compiler_regalloc.compiler-reg-assignment-table-primary-register-home
      assignment-index
      var)))

(defstruct CompilerBackendScavengeAssignments
  (index compiler_regalloc.CompilerRegAssignmentTable)
  (plan-mask i64))

(define (compiler-backend-scavenge-assignment-mask
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]) : i64
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array compiler_regalloc.CompilerRegLocation)
      assignments.items]
    [var : i64 0]
    [mask : i64 0]
    (begin
      (while (< var (array-length present))
        (begin
          (if (= (array-ref present var) 0)
            unit
            (set!
              mask
              (bit-or
                mask
                (compiler-backend-scavenge-location-mask (array-ref items var)))))
          (set! var (+ var 1))))
      mask)))

(define (compiler-backend-scavenge-assignments-build
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]) : CompilerBackendScavengeAssignments
  (let
    [view : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignment-table-with-min-capacity
        assignments
        vars)]
    (CompilerBackendScavengeAssignments
      view
      (compiler-backend-scavenge-assignment-mask view))))

(define (compiler-backend-assignments-have-register-home?
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]) : bool
  (let
    [present : (__tl_dyn-array i64) assignments.present]
    [items : (__tl_dyn-array compiler_regalloc.CompilerRegLocation)
      assignments.items]
    [var : i64 0]
    [found : bool false]
    (begin
      (while (and (< var (array-length present)) (not found))
        (begin
          (if (= (array-ref present var) 0)
            unit
            (match (array-ref items var)
              [(compiler_regalloc.CompilerRegLocation.Register _)
                (set! found true)]
              [(compiler_regalloc.CompilerRegLocation.RegisterPair _ _)
                (set! found true)]
              [_ unit]))
          (set! var (+ var 1))))
      found)))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-free-for-instr?
    [starts : (& starts (__tl_dyn-array i64))]
    [ends : (& ends (__tl_dyn-array i64))]
    [assignment-index
      : (& assignment-index compiler_regalloc.CompilerRegAssignmentTable)]
    [vars : i64]
    [point : i64]
    [reg : String]) : bool
    (compiler_regalloc.compiler-reg-assignment-table-register-free-over-range?
      starts
      ends
      assignment-index
      vars
      point
      (+ point 1)
      (compiler_abi.compiler-abi-register-id-from-spelling reg))))

;; Forward span (in point units; each instruction step is +2) that a scavenged
;; STAGING register is queried across, beyond its emit position. Loads sharing a
;; base register fuse into one emit step but the lowering numbers their def points
;; in REVERSE offset order, so a register-homed sibling carries an interval point
;; AHEAD of a spilled sibling's staging that is nonetheless emitted into its home
;; BEFORE it. Covering point + 2*(K-1) for the deepest K-field aggregate the
;; compiler binds-and-loads in one arm keeps every reordered sibling OCCUPIED in
;; the query so the staging scratch never clobbers it. See
;; compiler-backend-scavenge-reg.
(define compiler-backend-scavenge-staging-window : i64
  16)

(define (compiler-backend-scavenge-occupied-mask-at-point
  [function-state : CompilerBackendFunctionState]
  [point : i64]) : i64
  (let
    [occupied-masks : (__tl_dyn-array i64)
      (compiler-backend-function-scratch-i64-array
        function-state
        compiler-backend-scratch-i64-array-scavenge-occupied-masks)]
    [idx : i64
      (if (< point 0)
        -1
        (/ point 2))]
    (if (and (>= idx 0) (< idx (array-length occupied-masks)))
      (array-ref occupied-masks idx)
      0)))

;; Union the occupancy masks across every instruction event in [lo, hi] (point
;; coordinates; each event is point/2). A scavenge's staging scratch register
;; (e.g. a spilled load: `mov addr,scratch` then `mov scratch,spill`) is live not
;; only at the emit position but through the immediately following emission. A
;; FUSED destructure loads its fields in offset order while the lowering assigns
;; their interval points in the REVERSE order, so a register-homed sibling field
;; is emitted into its home one step BEFORE a spilled field's staging load yet
;; carries the HIGHER interval point (point+2). A single-point query at the emit
;; position read that register "free" and the scratch clobbered the just-loaded
;; sibling. ORing [point, point+2] keeps the emit-position endpoint (so a gep
;; operand live only at the instruction start is still protected) and adds the
;; next-step endpoint (so the reordered fused sibling is too). Scratch-plan
;; pseudo-vars are different: their modeled lifetime is the requirement range,
;; and a temporary in a later instruction cannot be clobbered by an earlier
;; staging sequence that has already ended. Keep planned scratch in the mask at
;; `lo`, but subtract it from later window samples; otherwise every future call
;; or phi slot lengthens unrelated legacy staging and creates emergency wraps.
(define (compiler-backend-scavenge-occupied-mask-over-range
  [function-state : CompilerBackendFunctionState]
  [lo : i64]
  [hi : i64]) : i64
  (let
    [occupied-masks : (__tl_dyn-array i64)
      (compiler-backend-function-scratch-i64-array
        function-state
        compiler-backend-scratch-i64-array-scavenge-occupied-masks)]
    [scratch-masks : (__tl_dyn-array i64)
      (compiler-backend-function-scratch-i64-array
        function-state
        compiler-backend-scratch-i64-array-scavenge-scratch-masks)]
    [count : i64 (array-length occupied-masks)]
    [lo-idx : i64
      (if (< lo 0)
        0
        (/ lo 2))]
    [hi-idx : i64
      (if (< hi 0)
        0
        (/ hi 2))]
    [i : i64 lo-idx]
    [acc : i64 0]
    (begin
      (while (<= i hi-idx)
        (begin
          (if (and (>= i 0) (< i count))
            (let
              [occupied : i64 (array-ref occupied-masks i)]
              [without-future-scratch : i64
                (if (or (= i lo-idx) (>= i (array-length scratch-masks)))
                  occupied
                  (bit-and occupied (bit-xor (array-ref scratch-masks i) -1)))]
              (set! acc (bit-or acc without-future-scratch)))
            unit)
          (set! i (+ i 1))))
      acc)))

;; Shrink-wrapping is assembled with three textual splices.  A missing needle
;; must fail closed: the caller re-emits the original function with the
;; early-exit rewrite disabled, restoring the ordinary always-framed path.
;; Each admitted replacement changes the byte length (the incoming guard,
;; saving prologue, and selected prologue all differ from their needles), so
;; length equality is a cheap, allocation-free proof that a splice did not
;; fire.
(define (compiler-backend-shrinkwrap-splice-fallback-required?
  [active? : bool]
  [body : String]
  [guarded-body : String]
  [framed-body : String]
  [final-body : String]
  [emitted-body : String]) : bool
  (and
    active?
    (or
      (= (string.string-length body) (string.string-length guarded-body))
      (= (string.string-length guarded-body) (string.string-length framed-body))
      (= (string.string-length final-body) (string.string-length emitted-body)))))

(define (compiler-backend-set-scavenge-ctx-ready!
  [function-state : CompilerBackendFunctionState]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [assignment-index : compiler_regalloc.CompilerRegAssignmentTable]
  [plan-mask : i64]
  [occupied-masks : (__tl_dyn-array i64)]
  [vars : i64]) : unit
  (begin
    (compiler-backend-function-scratch-set-i64-array!
      function-state
      compiler-backend-scratch-i64-array-scavenge-starts
      starts)
    (compiler-backend-function-scratch-set-i64-array!
      function-state
      compiler-backend-scratch-i64-array-scavenge-ends
      ends)
    (compiler-backend-function-scratch-set-assignment-index!
      function-state
      assignment-index)
    (compiler-backend-function-scratch-set-i64!
      function-state
      compiler-backend-scratch-i64-scavenge-plan-reg-mask
      plan-mask)
    (compiler-backend-function-scratch-set-i64-array!
      function-state
      compiler-backend-scratch-i64-array-scavenge-scratch-masks
      (array.make-array i64 (array-length occupied-masks)))
    (compiler-backend-function-scratch-set-i64-array!
      function-state
      compiler-backend-scratch-i64-array-scavenge-occupied-masks
      occupied-masks)
    (compiler-backend-function-scratch-set-i64!
      function-state
      compiler-backend-scratch-i64-scavenge-vars
      vars)))

(define (compiler-backend-set-scavenge-ctx-index!
  [function-state : CompilerBackendFunctionState]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [assignment-index : compiler_regalloc.CompilerRegAssignmentTable]
  [plan-mask : i64]
  [vars : i64]) : unit
  (let
    [occupied-masks : (__tl_dyn-array i64)
      (compiler-backend-scavenge-occupancy-build
        starts
        ends
        assignment-index
        vars)]
    (compiler-backend-set-scavenge-ctx-ready!
      function-state
      starts
      ends
      assignment-index
      plan-mask
      occupied-masks
      vars)))

(define (compiler-backend-set-scavenge-ctx!
  [function-state : CompilerBackendFunctionState]
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [vars : i64]) : unit
  (match (compiler-backend-scavenge-assignments-build assignments vars)
    [(CompilerBackendScavengeAssignments assignment-index plan-mask)
      (compiler-backend-set-scavenge-ctx-index!
        function-state
        starts
        ends
        assignment-index
        plan-mask
        vars)]))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-seed-block-liveins
    [blocks : compiler_ir_types.CompilerIrBlockList]
    [liveness : compiler_liveness.CompilerFunctionLiveness]
    [point : i64]
    [starts : (__tl_dyn-array i64)]
    [ends : (__tl_dyn-array i64)]) : i64
    (match blocks
      [(compiler_ir_types.CompilerIrBlockList.Nil) point]
      [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block label instrs)
            (let
              [live-afters : compiler_liveness.CompilerLiveInstrSetVec
                (compiler_regalloc.compiler-reg-live-intervals-find-afters
                  liveness
                  label)]
              [after-items : (__tl_dyn-array
                compiler_liveness.CompilerLiveI64Set)
                live-afters.items]
              [count : i64 instrs.len]
              (begin
                (if (> count 0)
                  (compiler_regalloc.compiler-reg-extend-set-words
                    starts
                    ends
                    (if (> (array-length after-items) 0)
                      (array-ref after-items 0)
                      (compiler_liveness.compiler-live-set-empty))
                    0
                    point)
                  unit)
                (compiler-backend-scavenge-seed-block-liveins
                  (__tl-box-place rest)
                  liveness
                  (+ point (* 2 count))
                  starts
                  ends)))])]
      [(compiler_ir_types.CompilerIrBlockList.Array seq)
        ;; cfg-gated self-check only; normal emission installs scavenge state
        ;; from interval arrays and stays on the dense block path.
        (compiler-backend-scavenge-seed-block-liveins
          (compiler_ir_types.compiler-ir-block-seq-to-list seq)
          liveness
          point
          starts
          ends)])))

(define (compiler-backend-scavenge-install-ctx-from-intervals!
  [function-state : CompilerBackendFunctionState]
  [slot-vars : i64]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [intervals : compiler_regalloc.CompilerRegIntervalSeq]
  [backend-state : CompilerBackendState]) : unit
  (let
    [abi-mask : i64
      (if (compiler-backend-current-fn-win64? backend-state)
        compiler-backend-scavenge-plan-win64-bit
        0)]
    (begin
      (compiler-backend-function-state-set-emit-instr-post-base!
        function-state
        0)
      (if (< slot-vars 1)
        (match (compiler-backend-scavenge-assignments-build assignments 0)
          [(CompilerBackendScavengeAssignments assignment-index plan-mask)
            (compiler-backend-set-scavenge-ctx-index!
              function-state
              (__tl_make-array i64 0)
              (__tl_make-array i64 0)
              assignment-index
              (bit-or plan-mask abi-mask)
              0)])
        (match (compiler-backend-scavenge-assignments-build
          assignments
          slot-vars)
          [(CompilerBackendScavengeAssignments assignment-index plan-mask)
            (let
              [interval-index : compiler_regalloc.CompilerRegIntervalIndex
                (compiler_regalloc.compiler-reg-interval-index-build
                  intervals
                  slot-vars)]
              [starts : (__tl_dyn-array i64) interval-index.starts]
              [ends : (__tl_dyn-array i64) interval-index.ends]
              (compiler-backend-set-scavenge-ctx-ready!
                function-state
                starts
                ends
                assignment-index
                (bit-or plan-mask abi-mask)
                (compiler-backend-scavenge-occupancy-build
                  starts
                  ends
                  assignment-index
                  slot-vars)
                slot-vars))])))))

(define (compiler-backend-scavenge-excluded?
  [exclude : (__tl_dyn-array String)]
  [n : i64]
  [reg : String]) : bool
  (let
    [i : i64 0]
    [hit : bool false]
    (begin
      (while (and (< i n) (not hit))
        (begin
          (if (string.eq (array-ref exclude i) reg)
            (set! hit true)
            unit)
          (set! i (+ i 1))))
      hit)))

;; Exclude set for binop scavenging: a safe superset of every binop op's fixed
;; registers (div/mul: rax/rdx; shift: rcx; fallback binops: rax=lhs). Pooled
;; scratch registers such as r10/r11 must stay available to the scavenger.
(define (compiler-backend-binop-scavenge-exclude-build) : (__tl_dyn-array
    String)
  (__tl_make-array "%rax" "%rdx" "%rcx" "" ""))

;; Op-specific scavenge exclude: only the registers THIS op actually clobbers
;; (beyond operand/dst homes, excluded separately). The over-broad superset
;; excluded rcx+rdx for every op, removing them as scratch candidates even for
;; add/sub/and/or/xor/cmp that don't touch them -> needless degradation to the
;; fallback. Returns a size-5 array (padded with zero-bit empty-string sentinels).
;; div/mod -> rax:rdx, mul -> rax/rdx, shift -> rcx, everything else -> nothing extra.
(define (compiler-backend-binop-scavenge-exclude-for-op
  [op : compiler_ir_types.CompilerIrBinOp]) : (__tl_dyn-array String)
  (let
    [rax-extra : String
      (match op
        [(compiler_ir_types.CompilerIrBinOp.Div) "%rax"]
        [(compiler_ir_types.CompilerIrBinOp.Mod) "%rax"]
        [(compiler_ir_types.CompilerIrBinOp.SafeDiv) "%rax"]
        [(compiler_ir_types.CompilerIrBinOp.SafeMod) "%rax"]
        [(compiler_ir_types.CompilerIrBinOp.Mul) "%rax"]
        [_ ""])]
    [extra : String
      (match op
        [(compiler_ir_types.CompilerIrBinOp.Div) "%rdx"]
        [(compiler_ir_types.CompilerIrBinOp.Mod) "%rdx"]
        [(compiler_ir_types.CompilerIrBinOp.SafeDiv) "%rdx"]
        [(compiler_ir_types.CompilerIrBinOp.SafeMod) "%rdx"]
        [(compiler_ir_types.CompilerIrBinOp.Shl _) "%rcx"]
        [(compiler_ir_types.CompilerIrBinOp.Shr _) "%rcx"]
        [(compiler_ir_types.CompilerIrBinOp.Mul) "%rdx"]
        [_ ""])]
    (__tl_make-array rax-extra extra "" "" "")))

;; Constant/magic-division 3-scratch discipline. The magic multiply needs a
;; scratch for the magic constant, a saved-dividend register read back for the
;; remainder, and a sign-mask register for signed cases. All three must be
;; mutually distinct and distinct from %rax/%rdx (the multiply/idiv clobbers).
;; The freeness query cannot see a sibling scratch's transient use at the same
;; point, so each scavenge excludes the already-picked regs. The sibling fallback
;; registers themselves stay available unless they were actually picked.
(define (compiler-backend-divmod-dividend-exclude [magic : String]) : (__tl_dyn-array
    String)
  (__tl_make-array "%rax" "%rdx" "" "" magic))

(define (compiler-backend-divmod-mask-exclude
  [magic : String]
  [dividend : String]) : (__tl_dyn-array String)
  (__tl_make-array "%rax" "%rdx" "" "" magic dividend))

;; Append one register to an exclude array (returns a fresh size-(n+1) array).
(define (compiler-backend-scavenge-exclude-append
  [exclude : (__tl_dyn-array String)]
  [n : i64]
  [extra : String]) : (__tl_dyn-array String)
  (let
    [a : (__tl_dyn-array String) (__tl_make-array String (+ n 1))]
    [i : i64 0]
    (begin
      (while (< i n)
        (begin
          (set! (array-ref a i) (array-ref exclude i))
          (set! i (+ i 1))))
      (set! (array-ref a n) extra)
      a)))

;; Concatenate two exclude arrays into a fresh array.
(define (compiler-backend-scavenge-exclude-merge
  [left : (__tl_dyn-array String)]
  [left-n : i64]
  [right : (__tl_dyn-array String)]
  [right-n : i64]) : (__tl_dyn-array String)
  (let
    [a : (__tl_dyn-array String) (__tl_make-array String (+ left-n right-n))]
    [i : i64 0]
    [j : i64 0]
    (begin
      (while (< i left-n)
        (begin
          (set! (array-ref a i) (array-ref left i))
          (set! i (+ i 1))))
      (while (< j right-n)
        (begin
          (set! (array-ref a (+ left-n j)) (array-ref right j))
          (set! j (+ j 1))))
      a)))

;; Exclude set = the HW-fixed regs PLUS the home registers of two source operands.
;; Robustly prevents a scavenged scratch from clobbering an operand whose value is
;; needed by THIS instruction (e.g. a loop-invariant base/src whose register the
;; liveness query may not see occupied at the scavenge point). Non-register-homed
;; operands map to the zero-bit empty-string sentinel. Pooled scratch registers
;; such as r10/r11 stay available unless one is an operand home. n = 7.
(define (compiler-backend-scavenge-exclude-ops2
  [backend-state : CompilerBackendState]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [v1 : compiler_ir_types.CompilerIrValue]
  [v2 : compiler_ir_types.CompilerIrValue]) : (__tl_dyn-array String)
  (let
    [h1 : String
      (compiler-backend-value-scalar-register backend-state assignments v1)]
    [h2 : String
      (compiler-backend-value-scalar-register backend-state assignments v2)]
    (__tl_make-array
      "%rax"
      "%rdx"
      "%rcx"
      ""
      ""
      (if (string.eq h1 "")
        ""
        h1)
      (if (string.eq h2 "")
        ""
        h2))))

;; Exclude set = HW-fixed regs PLUS two given register names (caller already knows
;; them, e.g. the emission's dst-home + an operand's home reg). "" stays a zero-bit
;; sentinel. Pooled scratch registers such as r10/r11 stay available unless one is
;; one of the explicit register names. n = 7.
(define (compiler-backend-scavenge-exclude-regs2 [r1 : String] [r2 : String]) : (__tl_dyn-array
    String)
  (__tl_make-array
    "%rax"
    "%rdx"
    "%rcx"
    ""
    ""
    (if (string.eq r1 "")
      ""
      r1)
    (if (string.eq r2 "")
      ""
      r2)))

;; Scavenge candidate pool. The first 11 entries are the legacy pool; ABI-special
;; %rsi/%rdi/%rax come last so they are only used when the older pool is occupied
;; and the point-local occupancy/exclude masks prove them free.
(define (compiler-backend-scavenge-candidates) : (__tl_dyn-array i64)
  (__tl_make-array
    compiler_abi.compiler-reg-id-r9
    compiler_abi.compiler-reg-id-rcx
    compiler_abi.compiler-reg-id-rdx
    compiler_abi.compiler-reg-id-r10
    compiler_abi.compiler-reg-id-r11
    compiler_abi.compiler-reg-id-r8
    compiler_abi.compiler-reg-id-r12
    compiler_abi.compiler-reg-id-r13
    compiler_abi.compiler-reg-id-r14
    compiler_abi.compiler-reg-id-r15
    compiler_abi.compiler-reg-id-rbx
    compiler_abi.compiler-reg-id-rsi
    compiler_abi.compiler-reg-id-rdi
    compiler_abi.compiler-reg-id-rax))

(define compiler-backend-scavenge-candidate-pool : (__tl_dyn-array i64)
  (compiler-backend-scavenge-candidates))

(define (compiler-backend-scavenge-rcx-candidates) : (__tl_dyn-array i64)
  (__tl_make-array compiler_abi.compiler-reg-id-rcx))

(define compiler-backend-scavenge-rcx-candidate-pool : (__tl_dyn-array i64)
  (compiler-backend-scavenge-rcx-candidates))

(define (compiler-backend-scavenge-xmm-candidates) : (__tl_dyn-array i64)
  (__tl_make-array
    (compiler_abi.compiler-abi-xmm-register-id 2)
    (compiler_abi.compiler-abi-xmm-register-id 3)
    (compiler_abi.compiler-abi-xmm-register-id 4)
    (compiler_abi.compiler-abi-xmm-register-id 5)))

(define compiler-backend-scavenge-xmm-candidate-pool : (__tl_dyn-array i64)
  (compiler-backend-scavenge-xmm-candidates))
(define compiler-backend-scavenge-plan-win64-bit : i64
  0x4000000000000000)

(define (compiler-backend-callee-saved-reg? [plan-mask : i64] [reg : i64]) : bool
  (or
    (>=
      (compiler_regalloc.compiler-reg-id-seq-index-of
        (compiler-backend-global-shared-view
          compiler-backend-scavenge-callee-list)
        reg
        0)
      0)
    (and
      (not (= (bit-and plan-mask compiler-backend-scavenge-plan-win64-bit) 0))
      (or
        (= reg compiler_abi.compiler-reg-id-rsi)
        (= reg compiler_abi.compiler-reg-id-rdi)))))

;; A candidate is usable as scratch iff: free at `point`, not excluded, and
;; (caller-saved OR already saved by the prologue).
;;
;; The third clause is essential for soundness. A callee-saved register belongs
;; to the CALLER and must be preserved across this function. The prologue/epilogue
;; only save+restore the callee registers the ALLOCATOR PLAN homes a value in
;; (`plan-uses-reg?`), and that set is fixed BEFORE body emission. If the scavenger
;; were allowed to hand out a callee register the plan does NOT save, the function
;; would clobber the caller's value with no save/restore -- and dynamically adding
;; it to the save set is itself unsound, because the prologue SAVE is emitted
;; post-body (final set) while every RESTORE (each return, each tail call) is
;; emitted inline DURING the body and sees only the set as it stood at that point,
;; so an early return restores a partial set and corrupts the caller. Restricting
;; callee picks to plan-saved registers keeps the save/restore set a pure function
;; of the plan (stable, order-independent) and still gives the scavenger every
;; callee register the allocator already pays to preserve, used as scratch only
;; where the freeness query certifies no live value occupies it.
;; Sound-scavenger reserved mask (LLVM RegScavenger model): the pooled-register
;; homes of the CURRENT instruction's operand (use) + result (def) vars. The
;; scavenge must NEVER return one of these as scratch -- it would clobber an
;; operand the instruction reads, or the result it writes (the dst reads "free"
;; at the scavenge point but must still be reserved). Set once per instruction
;; at the emission dispatcher; consulted in candidate-ok? AND the emergency tier.
;; Fold instruction uses/def straight into their assigned register-home bits.
;; Building generic liveness bitsets here used to allocate and zero two arrays
;; per emitted instruction, only to scan them immediately into this small mask.
;; The dense assignment index is already installed for the function before
;; scratch planning or emission, so operand visits are constant-time lookups.
(define (compiler-backend-instr-reserved-home-mask
  [function-state : CompilerBackendFunctionState]
  [instr : compiler_ir_types.CompilerIrInstr]) : i64
  (let
    [mask-counts : (__tl_dyn-array i64)
      (__tl_make-array -1 function-state.address)]
    (begin
      (compiler-backend-function-state-set-i64!
        function-state
        compiler-backend-function-i64-use-home-mask-value
        0)
      (compiler-backend-function-state-set-bool!
        function-state
        compiler-backend-function-bool-use-home-mask-active
        true)
      (compiler-backend-use-count-inc
        mask-counts
        (compiler_regalloc.compiler-reg-instr-def-var instr))
      (compiler-backend-count-instr-uses mask-counts instr)
      (compiler-backend-function-state-set-bool!
        function-state
        compiler-backend-function-bool-use-home-mask-active
        false)
      (compiler-backend-function-state-i64
        function-state
        compiler-backend-function-i64-use-home-mask-value))))

(define (compiler-backend-current-instr-reserved-mask
  [function-state : CompilerBackendFunctionState]) : i64
  (compiler-backend-function-scratch-i64
    function-state
    compiler-backend-scratch-i64-current-instr-reserved-mask))

(define (compiler-backend-set-current-instr-reserved-mask!
  [function-state : CompilerBackendFunctionState]
  [mask : i64]) : unit
  (compiler-backend-function-scratch-set-i64!
    function-state
    compiler-backend-scratch-i64-current-instr-reserved-mask
    mask))

(define (compiler-backend-scavenge-candidate-ok?
  [function-state : CompilerBackendFunctionState]
  [occupied-mask : i64]
  [exclude-mask : i64]
  [plan-mask : i64]
  [reg : i64]) : bool
  (let
    [bit : i64 (compiler-backend-scavenge-reg-id-bit reg)]
    (and
      (not (= bit 0))
      (=
        (bit-and
          (bit-or
            exclude-mask
            (compiler-backend-function-scratch-i64
              function-state
              compiler-backend-scratch-i64-current-instr-reserved-mask))
          bit)
        0)
      (or
        (not (compiler-backend-callee-saved-reg? plan-mask reg))
        (not (= (bit-and plan-mask bit) 0))
        ;; A frame-home divmod hoist makes %rbx part of the same immutable
        ;; function plan: the prologue saves it, but no synthetic interval owns
        ;; it after the preheader store, so sites may use it as their one copy.
        (and
          (compiler-backend-function-scratch-bool?
            function-state
            compiler-backend-scratch-bool-const-hoist-frame-rbx)
          (= reg compiler_abi.compiler-reg-id-rbx)))
      (= (bit-and occupied-mask bit) 0))))

;; Emergency scratch register when no candidate is free. Soundness rule: the
;; chosen reg's held value must NOT be an operand of the instruction -- emergency-
;; wrap preserves the value ACROSS but not DURING, so an operand-home reg would be
;; read as the scratch mid-instruction. Prefer the fallback (the site's reserved
;; scratch) when it is FREE at this point: free => no var homes it => not an
;; operand home, so it is sound AND nothing needs preserving. This is byte-
;; identical to the legacy behaviour while the fallback regs are unpooled (they
;; are always free then) and it keeps the optimisation open (a free reg needs
;; no save/restore). If the fallback is OCCUPIED (a pooled reg now homing a value,
;; possibly an operand), use the first NON-EXCLUDED candidate: non-excluded =>
;; not an operand home AND not a template-fixed superset reg, so emergency-
;; wrapping it is sound (even a callee-saved or non-operand-occupied reg -- the
;; wrap restores it). All-excluded is pathological/unreachable (exclude is
;; superset(5)+a few operand homes vs candidate count) -> fallback last resort.
;; Returns the first non-excluded candidate index, or -1 = "use the fallback".
(define (compiler-backend-scavenge-emergency-fallback-free?
  [function-state : CompilerBackendFunctionState]
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [occupied-mask : i64]
  [fallback : String]) : bool
  (and
    (not (compiler-backend-scavenge-excluded? exclude exclude-n fallback))
    (compiler-backend-scavenge-reg-free-in-mask? occupied-mask fallback)
    (=
      (bit-and
        (compiler-backend-function-scratch-i64
          function-state
          compiler-backend-scratch-i64-current-instr-reserved-mask)
        (compiler-backend-scavenge-reg-bit fallback))
      0)))

(define (compiler-backend-scavenge-emergency-cand-index
  [function-state : CompilerBackendFunctionState]
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [exclude-mask : i64]
  [occupied-mask : i64]
  [fallback : String]
  [cands : (& cands (__tl_dyn-array i64))]
  [n : i64]) : i64
  (if (compiler-backend-scavenge-emergency-fallback-free?
    function-state
    exclude
    exclude-n
    occupied-mask
    fallback)
    -1
    (let
      [i : i64 0]
      [found : i64 -1]
      (begin
        (while (and (< i n) (< found 0))
          (begin
            (if (and
              (or
                (not
                  (compiler-backend-function-scratch-bool?
                    function-state
                    compiler-backend-scratch-bool-divmod-src-emergency-avoid-r10))
                (not (= (array-ref cands i) compiler_abi.compiler-reg-id-r10)))
              (=
                (bit-and
                  (bit-or
                    exclude-mask
                    (compiler-backend-function-scratch-i64
                      function-state
                      compiler-backend-scratch-i64-current-instr-reserved-mask))
                  (compiler-backend-scavenge-reg-id-bit (array-ref cands i)))
                0))
              (set! found i)
              unit)
            (set! i (+ i 1))))
        found))))

(define (compiler-backend-scavenge-pick-iter
  [function-state : CompilerBackendFunctionState]
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [exclude-mask : i64]
  [occupied-mask : i64]
  [plan-mask : i64]
  [fallback : String]
  [cands : (& cands (__tl_dyn-array i64))]
  [i : i64]
  [n : i64]) : String
  (if (>= i n)
    (let
      [emidx : i64
        (compiler-backend-scavenge-emergency-cand-index
          function-state
          exclude
          exclude-n
          exclude-mask
          occupied-mask
          fallback
          cands
          n)]
      (if (< emidx 0)
        (begin
          (cfg
            scavenge-census
            (if (compiler-backend-scavenge-emergency-fallback-free?
              function-state
              exclude
              exclude-n
              occupied-mask
              fallback)
              (compiler-backend-scavenge-census-record-fallback-free!)
              (compiler-backend-scavenge-census-record-fallback-last-resort!))
            unit)
          ;; emergency-reg MUST equal the returned reg (emergency-wrap saves/
          ;; restores it). Give the global save set a copy, then return the
          ;; owned fallback. (emidx<0 = the fallback is FREE here, preferred; or
          ;; the pathological all-excluded last resort.)
          (if (compiler-backend-scavenge-emergency-reg-supported? fallback)
            (compiler-backend-emergency-add!
              function-state
              (string.copy fallback))
            (io.panic
              (str_cat.str-cat
                "backend: unsupported scavenge emergency fallback register "
                fallback)))
          fallback)
        (begin
          (cfg
            scavenge-census
            (compiler-backend-scavenge-census-record-occupied-candidate!)
            unit)
          (compiler-backend-emergency-add-id!
            function-state
            (array-ref cands emidx))
          (compiler_abi.compiler-abi-register-spelling (array-ref cands emidx)))))
    (if (compiler-backend-scavenge-candidate-ok?
      function-state
      occupied-mask
      exclude-mask
      plan-mask
      (array-ref cands i))
      ;; A picked callee-saved register is, by candidate-ok?, one the plan already
      ;; saves -- so the prologue/epilogue (driven by the stable plan set) already
      ;; preserve it for the caller. No dynamic save-set growth (that was unsound:
      ;; post-body save vs inline partial-set restores).
      (compiler_abi.compiler-abi-register-spelling (array-ref cands i))
      (compiler-backend-scavenge-pick-iter
        function-state
        exclude
        exclude-n
        exclude-mask
        occupied-mask
        plan-mask
        fallback
        cands
        (+ i 1)
        n))))

;; Pick a register free at `point`: prefer `fallback` (keeps it byte-identical
;; while the fallback is a reserved scratch), else the first usable pool
;; candidate, else `fallback` (degraded -- the freeness self-check flags this as
;; a no-free-register case).
(define (compiler-backend-scavenge-pick-with-mask
  [function-state : CompilerBackendFunctionState]
  [occupied-mask : i64]
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [fallback : String]) : String
  (let
    [exclude-mask : i64
      (compiler-backend-scavenge-exclude-mask exclude exclude-n)]
    (if (and
      (not (compiler-backend-scavenge-excluded? exclude exclude-n fallback))
      (compiler-backend-scavenge-reg-free-in-mask? occupied-mask fallback))
      fallback
      (compiler-backend-scavenge-pick-iter
        function-state
        exclude
        exclude-n
        exclude-mask
        occupied-mask
        (compiler-backend-function-scratch-i64
          function-state
          compiler-backend-scratch-i64-scavenge-plan-reg-mask)
        fallback
        compiler-backend-scavenge-candidate-pool
        0
        (array-length compiler-backend-scavenge-candidate-pool)))))

(define (compiler-backend-scavenge-pick-from-mask
  [function-state : CompilerBackendFunctionState]
  [occupied-mask : i64]
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [fallback : String]
  [cands : (& cands (__tl_dyn-array i64))]) : String
  (let
    [exclude-mask : i64
      (compiler-backend-scavenge-exclude-mask exclude exclude-n)]
    (if (and
      (not (compiler-backend-scavenge-excluded? exclude exclude-n fallback))
      (compiler-backend-scavenge-reg-free-in-mask? occupied-mask fallback))
      fallback
      (compiler-backend-scavenge-pick-iter
        function-state
        exclude
        exclude-n
        exclude-mask
        occupied-mask
        (compiler-backend-function-scratch-i64
          function-state
          compiler-backend-scratch-i64-scavenge-plan-reg-mask)
        fallback
        cands
        0
        (array-length cands)))))

(define (compiler-backend-scavenge-xmm-reg
  [dst-var : i64]
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [fallback : String]
  [backend-state : CompilerBackendState]) : String
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [vars : i64
      (compiler-backend-function-scratch-i64
        function-state
        compiler-backend-scratch-i64-scavenge-vars)]
    [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-function-scratch-assignment-index function-state)]
    ;; See compiler-backend-scavenge-reg: query the staging register's forward live
    ;; span so a fused/destructure float load cannot clobber a reordered sibling
    ;; field emitted into its home before it.
    [point : i64
      (compiler-backend-function-state-emission-point function-state)]
    [hi-point : i64 (+ point compiler-backend-scavenge-staging-window)]
    [dst-home : String
      (if (and (>= dst-var 0) (< dst-var vars))
        (compiler-backend-var-register-home-index assignment-index dst-var)
        "")]
    [ex : (__tl_dyn-array String)
      (if (string.eq dst-home "")
        exclude
        (compiler-backend-scavenge-exclude-append exclude exclude-n dst-home))]
    [ex-n : i64
      (if (string.eq dst-home "")
        exclude-n
        (+ exclude-n 1))]
    [reg : String
      (compiler-backend-scavenge-pick-from-mask
        function-state
        (compiler-backend-scavenge-occupied-mask-over-range
          function-state
          point
          hi-point)
        ex
        ex-n
        fallback
        compiler-backend-scavenge-xmm-candidate-pool)]
    (begin
      (cfg
        scavenge-self-check
        (let
          [check-starts : (__tl_dyn-array i64)
            (compiler-backend-function-scratch-i64-array
              function-state
              compiler-backend-scratch-i64-array-scavenge-starts)]
          [check-ends : (__tl_dyn-array i64)
            (compiler-backend-function-scratch-i64-array
              function-state
              compiler-backend-scratch-i64-array-scavenge-ends)]
          (compiler-backend-scavenge-freeness-check!
            function-state
            check-starts
            check-ends
            assignment-index
            vars
            point
            reg))
        unit)
      reg)))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-freeness-check!
    [function-state : CompilerBackendFunctionState]
    [starts : (& starts (__tl_dyn-array i64))]
    [ends : (& ends (__tl_dyn-array i64))]
    [assignment-index
      : (& assignment-index compiler_regalloc.CompilerRegAssignmentTable)]
    [vars : i64]
    [point : i64]
    [reg : String]) : unit
    (if (or
      (compiler-backend-scavenge-free-for-instr?
        starts
        ends
        assignment-index
        vars
        point
        reg)
      (compiler-backend-function-scratch-bool?
        function-state
        compiler-backend-scratch-bool-emergency-pending))
      unit
      (io.panic
        (str_cat.str-cat
          "SCAVENGE-FREENESS-VIOLATION reg="
          reg
          " point="
          (string.int->string point)
          " -- pick returned an occupied register (no free scratch)")))))

;; Side-effect-free twin of the GP picker for fusion admission.  It predicts the
;; exact register the ordinary scavenger will return, including its emergency
;; tier, without adding a pending save that would leak when the fusion rejects.
(define (compiler-backend-scavenge-pick-iter-peek
  [function-state : CompilerBackendFunctionState]
  [occupied-mask : i64]
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [exclude-mask : i64]
  [plan-mask : i64]
  [fallback : String]
  [cands : (& cands (__tl_dyn-array i64))]
  [i : i64]
  [n : i64]) : String
  (if (>= i n)
    (let
      [emidx : i64
        (compiler-backend-scavenge-emergency-cand-index
          function-state
          exclude
          exclude-n
          exclude-mask
          occupied-mask
          fallback
          cands
          n)]
      (if (< emidx 0)
        fallback
        (compiler_abi.compiler-abi-register-spelling (array-ref cands emidx))))
    (if (compiler-backend-scavenge-candidate-ok?
      function-state
      occupied-mask
      exclude-mask
      plan-mask
      (array-ref cands i))
      (compiler_abi.compiler-abi-register-spelling (array-ref cands i))
      (compiler-backend-scavenge-pick-iter-peek
        function-state
        occupied-mask
        exclude
        exclude-n
        exclude-mask
        plan-mask
        fallback
        cands
        (+ i 1)
        n))))

(define (compiler-backend-scavenge-pick-with-mask-peek
  [function-state : CompilerBackendFunctionState]
  [occupied-mask : i64]
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [fallback : String]) : String
  (let
    [exclude-mask : i64
      (compiler-backend-scavenge-exclude-mask exclude exclude-n)]
    (if (and
      (not (compiler-backend-scavenge-excluded? exclude exclude-n fallback))
      (compiler-backend-scavenge-reg-free-in-mask? occupied-mask fallback))
      fallback
      (compiler-backend-scavenge-pick-iter-peek
        function-state
        occupied-mask
        exclude
        exclude-n
        exclude-mask
        (compiler-backend-function-scratch-i64
          function-state
          compiler-backend-scratch-i64-scavenge-plan-reg-mask)
        fallback
        compiler-backend-scavenge-candidate-pool
        0
        (array-length compiler-backend-scavenge-candidate-pool)))))

(define (compiler-backend-scavenge-reg-peek
  [dst-var : i64]
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [fallback : String]
  [backend-state : CompilerBackendState]) : String
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [point : i64
      (compiler-backend-function-state-emission-point function-state)]
    [hi-point : i64 (+ point compiler-backend-scavenge-staging-window)]
    [vars : i64
      (compiler-backend-function-scratch-i64
        function-state
        compiler-backend-scratch-i64-scavenge-vars)]
    [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-function-scratch-assignment-index function-state)]
    [dst-home : String
      (if (and (>= dst-var 0) (< dst-var vars))
        (compiler-backend-var-register-home-index assignment-index dst-var)
        "")]
    [ex : (__tl_dyn-array String)
      (if (string.eq dst-home "")
        exclude
        (compiler-backend-scavenge-exclude-append exclude exclude-n dst-home))]
    [ex-n : i64
      (if (string.eq dst-home "")
        exclude-n
        (+ exclude-n 1))]
    (compiler-backend-scavenge-pick-with-mask-peek
      function-state
      (compiler-backend-scavenge-occupied-mask-over-range
        function-state
        point
        hi-point)
      ex
      ex-n
      fallback)))

;; Return a register free at dst-var's def point (via the proven query),
;; excluding `exclude`, preferring `fallback`. If the preferred register is
;; occupied, pick another free pooled candidate or use the emergency wrapper.
(define (compiler-backend-scavenge-reg
  [dst-var : i64]
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [fallback : String]
  [backend-state : CompilerBackendState]) : String
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [vars : i64
      (compiler-backend-function-scratch-i64
        function-state
        compiler-backend-scratch-i64-scavenge-vars)]
    [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-function-scratch-assignment-index function-state)]
    ;; Query the occupancy across the staging register's live span, not just the
    ;; single emit POSITION. Loads sharing a base (a destructure's fields, fused by
    ;; emit-load-from-gep-pair / emit-load-load / emit-fused-gep-load-rest) are
    ;; emitted in OFFSET order while the lowering assigns their def points in the
    ;; REVERSE order, so a register-homed sibling (e.g. a String key in %r9) is
    ;; emitted into its home BEFORE a spilled sibling's staging load yet carries a
    ;; HIGHER interval point. Querying only `point` read that register "free" and
    ;; the scratch clobbered the just-loaded sibling (intern-lookup's slot-id load
    ;; picking %r9 over the live slot-key). A spilled field at offset position j in
    ;; a K-field group is preceded by j siblings at point+2..point+2j, so the
    ;; staging register's true upper coordinate is point + 2*(K-1); the window
    ;; below covers the deepest fully-bound aggregates the compiler destructures.
    ;; For a standalone def with nothing reordered ahead these forward events are
    ;; the next instructions' (whose registers the result must avoid anyway), so
    ;; this never under-protects. Exclude the dst home (not live yet) so the
    ;; scratch never overwrites the result register.
    [point : i64
      (compiler-backend-function-state-emission-point function-state)]
    [hi-point : i64 (+ point compiler-backend-scavenge-staging-window)]
    [dst-home : String
      (if (and (>= dst-var 0) (< dst-var vars))
        (compiler-backend-var-register-home-index assignment-index dst-var)
        "")]
    [ex : (__tl_dyn-array String)
      (if (string.eq dst-home "")
        exclude
        (compiler-backend-scavenge-exclude-append exclude exclude-n dst-home))]
    [ex-n : i64
      (if (string.eq dst-home "")
        exclude-n
        (+ exclude-n 1))]
    [reg : String
      (compiler-backend-scavenge-pick-with-mask
        function-state
        (compiler-backend-scavenge-occupied-mask-over-range
          function-state
          point
          hi-point)
        ex
        ex-n
        fallback)]
    (begin
      (cfg
        scavenge-self-check
        (let
          [check-starts : (__tl_dyn-array i64)
            (compiler-backend-function-scratch-i64-array
              function-state
              compiler-backend-scratch-i64-array-scavenge-starts)]
          [check-ends : (__tl_dyn-array i64)
            (compiler-backend-function-scratch-i64-array
              function-state
              compiler-backend-scratch-i64-array-scavenge-ends)]
          (compiler-backend-scavenge-freeness-check!
            function-state
            check-starts
            check-ends
            assignment-index
            vars
            point
            reg))
        unit)
      reg)))

;; No-dst scavenge: same as scavenge-reg but the point comes from the drift-proof
;; per-instruction position (post-base - length(current-instrs)) instead of a dst
;; var's def point -- for instructions that define no variable (compare-branch,
;; GEP store/copy, etc.). Returns `fallback` until the fallback register is pooled.
(define (compiler-backend-scavenge-reg-here
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [fallback : String]
  [backend-state : CompilerBackendState]) : String
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [point : i64
      (compiler-backend-function-state-emission-point function-state)]
    [reg : String
      (compiler-backend-scavenge-pick-with-mask
        function-state
        (compiler-backend-scavenge-occupied-mask-at-point function-state point)
        exclude
        exclude-n
        fallback)]
    (begin
      (cfg
        scavenge-self-check
        (let
          [check-starts : (__tl_dyn-array i64)
            (compiler-backend-function-scratch-i64-array
              function-state
              compiler-backend-scratch-i64-array-scavenge-starts)]
          [check-ends : (__tl_dyn-array i64)
            (compiler-backend-function-scratch-i64-array
              function-state
              compiler-backend-scratch-i64-array-scavenge-ends)]
          [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
            (compiler-backend-function-scratch-assignment-index function-state)]
          (compiler-backend-scavenge-freeness-check!
            function-state
            check-starts
            check-ends
            assignment-index
            (compiler-backend-function-scratch-i64
              function-state
              compiler-backend-scratch-i64-scavenge-vars)
            point
            reg))
        unit)
      reg)))

(define (compiler-backend-scavenge-rcx-reg-here
  [exclude : (__tl_dyn-array String)]
  [exclude-n : i64]
  [backend-state : CompilerBackendState]) : String
  (let
    [function-state : CompilerBackendFunctionState
      (compiler-backend-state-function-state backend-state)]
    [point : i64
      (compiler-backend-function-state-emission-point function-state)]
    [reg : String
      (compiler-backend-scavenge-pick-from-mask
        function-state
        (compiler-backend-scavenge-occupied-mask-at-point function-state point)
        exclude
        exclude-n
        "%rcx"
        compiler-backend-scavenge-rcx-candidate-pool)]
    (begin
      (cfg
        scavenge-self-check
        (let
          [check-starts : (__tl_dyn-array i64)
            (compiler-backend-function-scratch-i64-array
              function-state
              compiler-backend-scratch-i64-array-scavenge-starts)]
          [check-ends : (__tl_dyn-array i64)
            (compiler-backend-function-scratch-i64-array
              function-state
              compiler-backend-scratch-i64-array-scavenge-ends)]
          [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
            (compiler-backend-function-scratch-assignment-index function-state)]
          (compiler-backend-scavenge-freeness-check!
            function-state
            check-starts
            check-ends
            assignment-index
            (compiler-backend-function-scratch-i64
              function-state
              compiler-backend-scratch-i64-scavenge-vars)
            point
            reg))
        unit)
      reg)))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-check-instr
    [starts : (__tl_dyn-array i64)]
    [ends : (__tl_dyn-array i64)]
    [assignment-index : compiler_regalloc.CompilerRegAssignmentTable]
    [vars : i64]
    [name : String]
    [point : i64]
    [instr : compiler_ir_types.CompilerIrInstr]
    [live-after : compiler_liveness.CompilerLiveI64Set]) : unit
    (let
      [uses : compiler_liveness.CompilerLiveI64Set
        (compiler_liveness.compiler-live-instr-uses instr)]
      [v : i64 0]
      (begin
        (while (< v vars)
          (begin
            (if (compiler_liveness.compiler-live-set-contains? uses v)
              ;; Only REGISTER-HOMED used vars need interval coverage + a
              ;; not-free home: a spilled/untracked used var has no register to
              ;; clobber, and an all-spilled function installs an EMPTY scavenge
              ;; ctx (Nil intervals -> starts[v]=-1) on purpose, so asserting
              ;; coverage for non-register vars is a false positive (the old
              ;; check aborted at the first all-spilled function before reaching
              ;; the real register hazards). cfg-gated: oracle-only, no codegen.
              (match (compiler_regalloc.compiler-reg-assignment-table-lookup
                assignment-index
                v)
                [(compiler_regalloc.CompilerRegMaybeLocation.Some loc)
                  (match loc
                    [(compiler_regalloc.CompilerRegLocation.Register home)
                      (let
                        [home-name : String
                          (compiler_abi.compiler-abi-register-spelling home)]
                        (begin
                          (if (and
                            (>= (array-ref starts v) 0)
                            (<= (array-ref starts v) point)
                            (<= point (array-ref ends v)))
                            unit
                            (io.panic
                              (str_cat.str-cat
                                "SCAVENGE-VIOLATION interval fn="
                                name
                                " point="
                                (string.int->string point)
                                " use-var="
                                (string.int->string v)
                                " iv=["
                                (string.int->string (array-ref starts v))
                                ","
                                (string.int->string (array-ref ends v))
                                "]")))
                          (if (compiler-backend-scavenge-free-for-instr?
                            starts
                            ends
                            assignment-index
                            vars
                            point
                            home-name)
                            (io.panic
                              (str_cat.str-cat
                                "SCAVENGE-VIOLATION free fn="
                                name
                                " point="
                                (string.int->string point)
                                " use-var="
                                (string.int->string v)
                                " reg="
                                home-name
                                " wrongly-reported-free"))
                            unit)))]
                    [(compiler_regalloc.CompilerRegLocation.RegisterPair _ _)
                      unit]
                    [(compiler_regalloc.CompilerRegLocation.Spill _) unit]
                    [(compiler_regalloc.CompilerRegLocation.Remat _) unit])]
                [(compiler_regalloc.CompilerRegMaybeLocation.No) unit])
              unit)
            (set! v (+ v 1))))
        ;; #FOUNDATION: the used-var loop above validates OPERAND homes; this
        ;; second loop validates LIVE-THROUGH values (live-after but not used
        ;; here). A value live ACROSS this instruction must be reported OCCUPIED
        ;; on its register -- a scavenge querying `point` would otherwise pick it
        ;; and clobber a call-spanning / loop-carried value. This is the class the
        ;; old used-var-only self-check missed (its blind spot).
        (let
          [w : i64 0]
          (while (< w vars)
            (begin
              (if (compiler_liveness.compiler-live-set-contains? live-after w)
                (match (compiler_regalloc.compiler-reg-assignment-table-lookup
                  assignment-index
                  w)
                  [(compiler_regalloc.CompilerRegMaybeLocation.Some loc)
                    (match loc
                      [(compiler_regalloc.CompilerRegLocation.Register home)
                        (let
                          [home-name : String
                            (compiler_abi.compiler-abi-register-spelling home)]
                          (if (compiler-backend-scavenge-free-for-instr?
                            starts
                            ends
                            assignment-index
                            vars
                            point
                            home-name)
                            (io.panic
                              (str_cat.str-cat
                                "SCAVENGE-LIVETHROUGH-VIOLATION fn="
                                name
                                " point="
                                (string.int->string point)
                                " live-var="
                                (string.int->string w)
                                " reg="
                                home-name
                                " WRONGLY-FREE iv=["
                                (string.int->string (array-ref starts w))
                                ","
                                (string.int->string (array-ref ends w))
                                "]"))
                            unit))]
                      [(compiler_regalloc.CompilerRegLocation.RegisterPair _ _)
                        unit]
                      [(compiler_regalloc.CompilerRegLocation.Spill _) unit]
                      [(compiler_regalloc.CompilerRegLocation.Remat _) unit])]
                  [(compiler_regalloc.CompilerRegMaybeLocation.No) unit])
                unit)
              (set! w (+ w 1)))))
        unit))))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-check-seq
    [starts : (__tl_dyn-array i64)]
    [ends : (__tl_dyn-array i64)]
    [assignment-index : compiler_regalloc.CompilerRegAssignmentTable]
    [vars : i64]
    [name : String]
    [instrs : compiler_ir_types.CompilerIrInstrSeq]
    [live-afters : compiler_liveness.CompilerLiveInstrSetVec]
    [point : i64]) : i64
    (let
      [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
      [count : i64 instrs.len]
      [after-items : (__tl_dyn-array compiler_liveness.CompilerLiveI64Set)
        live-afters.items]
      [index : i64 0]
      [out : i64 point]
      (begin
        (while (< index count)
          (begin
            (compiler-backend-scavenge-check-instr
              starts
              ends
              assignment-index
              vars
              name
              out
              (array-ref slots index)
              (if (< index (array-length after-items))
                (array-ref after-items index)
                (compiler_liveness.compiler-live-set-empty)))
            (set! out (+ out 2))
            (set! index (+ index 1))))
        out))))

(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-check-blocks
    [starts : (__tl_dyn-array i64)]
    [ends : (__tl_dyn-array i64)]
    [assignment-index : compiler_regalloc.CompilerRegAssignmentTable]
    [vars : i64]
    [name : String]
    [liveness : compiler_liveness.CompilerFunctionLiveness]
    [blocks : compiler_ir_types.CompilerIrBlockList]
    [point : i64]) : i64
    (match blocks
      [(compiler_ir_types.CompilerIrBlockList.Nil) point]
      [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
        (match block
          [(compiler_ir_types.CompilerIrBlock.Block label instrs)
            (compiler-backend-scavenge-check-blocks
              starts
              ends
              assignment-index
              vars
              name
              liveness
              (__tl-box-place rest)
              (compiler-backend-scavenge-check-seq
                starts
                ends
                assignment-index
                vars
                name
                instrs
                (compiler_regalloc.compiler-reg-live-intervals-find-afters
                  liveness
                  label)
                point))])]
      [(compiler_ir_types.CompilerIrBlockList.Array seq)
        ;; cfg-gated self-check only; normal emission installs scavenge state
        ;; from interval arrays and stays on the dense block path.
        (compiler-backend-scavenge-check-blocks
          starts
          ends
          assignment-index
          vars
          name
          liveness
          (compiler_ir_types.compiler-ir-block-seq-to-list seq)
          point)])))

;; Build the per-var live intervals on the FINAL IR and self-check the query.
;; cfg-gated -> inert/DCE'd in a normal build (byte-identical codegen).
(cfg
  scavenge-self-check
  (define (compiler-backend-scavenge-self-check
    [name : i64]
    [name-text : String]
    [params : compiler_ir_types.CompilerIrParamList]
    [ret-ty : compiler_ast_types.AstType]
    [slot-vars : i64]
    [emit-blocks : compiler_ir_types.CompilerIrBlockList]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable]) : unit
    (if (< slot-vars 1)
      unit
      (let
        [func : compiler_ir_types.CompilerIrFunction
          (compiler_ir_types.CompilerIrFunction.Function
            name
            params
            ret-ty
            slot-vars
            emit-blocks)]
        [liveness : compiler_liveness.CompilerFunctionLiveness
          (compiler_liveness.compiler-live-analyze-function func)]
        [starts : (__tl_dyn-array i64) (__tl_make-array i64 slot-vars)]
        [ends : (__tl_dyn-array i64) (__tl_make-array i64 slot-vars)]
        [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
          (compiler_regalloc.compiler-reg-assignment-table-with-min-capacity
            assignments
            slot-vars)]
        (begin
          (compiler_regalloc.compiler-reg-fill-i64-array starts -1)
          (compiler_regalloc.compiler-reg-fill-i64-array ends -1)
          (compiler_regalloc.compiler-reg-live-intervals-blocks-with-live
            emit-blocks
            liveness
            0
            starts
            ends)
          (compiler-backend-scavenge-seed-block-liveins
            emit-blocks
            liveness
            0
            starts
            ends)
          (compiler-backend-scavenge-check-blocks
            starts
            ends
            assignment-index
            slot-vars
            name-text
            liveness
            emit-blocks
            0)
          unit)))))

;; Increment the predecessor count for every label in `labels` (a deduped CFG
;; successor set for one block). Each block contributes at most once per
;; successor, so the resulting count is the number of DISTINCT predecessor
;; blocks -- exactly the "is this label a merge?" signal we need.
(define (compiler-backend-peephole-predcount-bump
  [counts : backend_label_i64_map.Map (:consume)]
  [labels : compiler_optimize.OptLabelSet]) : backend_label_i64_map.Map
  (match labels
    [(compiler_optimize.OptLabelSet.Nil) counts]
    [(compiler_optimize.OptLabelSet.Dense _ _)
      (let
        [label : i64 (compiler_optimize.opt-label-ref labels 0)]
        (begin
          (backend_label_i64_map.insert-ref!
            (&mut counts)
            label
            (+ 1 (backend_label_i64_map.get-value-or (& counts) label 0)))
          (compiler-backend-peephole-predcount-bump
            counts
            (compiler_optimize.opt-label-tail labels))))]))

;; Count predecessors of every block from the AUTHORITATIVE CFG successor set
;; (explicit IrInstrJump / IrInstrBranch / IrInstrSwitch targets PLUS the
;; implicit fall-through to the layout-next block), reusing the optimizer's own
;; successor enumeration so jump-table (switch) case + default targets are all
;; included. Under-counting an edge is the only way carry could go wrong, and
;; this enumeration is complete (those are the only label-bearing terminators).
(define (compiler-backend-peephole-predcount-build
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [counts : backend_label_i64_map.Map (:consume)]) : backend_label_i64_map.Map
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) counts]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-peephole-predcount-build-seq seq 0 counts)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (compiler-backend-peephole-predcount-build
        (__tl-box-place rest)
        (compiler-backend-peephole-predcount-bump
          counts
          (compiler_optimize.opt-cfg-block-successors-with-next
            block
            (compiler_optimize.opt-cfg-entry-label (__tl-box-place rest)))))]))

(define (compiler-backend-block-seq-label-or-empty
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]) : i64
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    (compiler_ir_types.compiler-ir-label-none)
    (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
      [(compiler_ir_types.CompilerIrBlock.Block label _) label])))

(define (compiler-backend-peephole-predcount-build-seq
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]
  [counts : backend_label_i64_map.Map (:consume)]) : backend_label_i64_map.Map
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    counts
    (compiler-backend-peephole-predcount-build-seq
      blocks
      (+ index 1)
      (compiler-backend-peephole-predcount-bump
        counts
        (compiler_optimize.opt-cfg-block-successors-with-next
          (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
          (compiler-backend-block-seq-label-or-empty blocks (+ index 1)))))))

;; True iff `block`'s terminator is a conditional branch that NEEDS phi-copy edge
;; blocks. SOUNDNESS-CRITICAL: such a branch does NOT lower to a clean
;; fall-through into its layout-next arm -- compiler-backend-emit-branch-with-phi-
;; copies emits a SYNTHETIC edge-copy block (`<label>_branch_<suffix>`) on the
;; fall-through path and reaches the layout-next arm via an explicit jcc. So the
;; layout-next block is a JUMP target with foreign code (the other edge's copies)
;; textually preceding it -- its running owner map is NOT this block's exit map,
;; and carrying across it miscompiles (observed: a wrong reload reuse in the
;; dominator fixpoint -> non-termination). A branch that needs NO phi copies
;; lowers to `jcc <other-arm>` + clean fall-through (emit-compare-branch-jumps),
;; which IS safe. Jump terminators keep copies on their single edge. Switches
;; with phi targets now also split through synthetic edge blocks, so they must
;; reset the carry state before any layout-next block.
(define (compiler-backend-peephole-prev-splits-edge?
  [function-state : CompilerBackendFunctionState]
  [block : compiler_ir_types.CompilerIrBlock]) : bool
  (match block
    [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
      (let
        [n : i64 instrs.len]
        (if (= n 0)
          false
          (match (array-ref instrs.slots (- n 1))
            [(compiler_ir_types.CompilerIrInstr.Branch _ true-label false-label)
              (compiler-backend-branch-needs-phi-copies?
                function-state
                true-label
                false-label)]
            [(compiler_ir_types.CompilerIrInstr.TotalEnumBranch
                _
                true-label
                false-label)
              (compiler-backend-branch-needs-phi-copies?
                function-state
                true-label
                false-label)]
            [(compiler_ir_types.CompilerIrInstr.Switch _ _ cases default-label)
              (compiler-backend-switch-target-phi?
                (compiler-backend-function-state-phi-targets function-state)
                cases
                default-label)]
            [(compiler_ir_types.CompilerIrInstr.TotalEnumSwitch
                _
                _
                cases
                default-label
                _)
              (compiler-backend-switch-target-phi?
                (compiler-backend-function-state-phi-targets function-state)
                cases
                default-label)]
            [_ false])))]))

;; Walk blocks in LAYOUT order (prev = the textually-preceding block). A block B
;; is carry-safe -- the peephole may carry the owner map across B's label rather
;; than reset -- iff ALL hold:
;;   (1) B is not the function entry (the entry is reached by `call` with caller
;;       register state, never by fall-through; it is `prev` here, never `cur`,
;;       and is additionally guarded by entry-label);
;;   (2) B has exactly ONE predecessor in the CFG (predcount == 1) -- so it is
;;       not a merge / multi-pred branch/switch/jump-table target; and
;;   (3) that single predecessor is `prev`, the layout-adjacent block (prev's
;;       successor set contains B). (2)+(3) together prove B is reached ONLY by
;;       continuing from prev, so the peephole's running owner map at B's label
;;       equals prev's exit map. If B's lone predecessor were laid out elsewhere
;;       (e.g. a far switch case), (3) fails and we reset -- the sound default;
;;   (4) prev does NOT end in a phi-copy branch (compiler-backend-peephole-prev-
;;       splits-edge?), which would insert a synthetic edge-copy block between
;;       prev and B and reach B via an explicit jcc rather than fall-through --
;;       so B's running map would be the OTHER edge's, not prev's exit.
(define (compiler-backend-peephole-carry-safe-scan
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]
  [function-state : CompilerBackendFunctionState]
  [label-scope : String]
  [entry-label : i64]
  [predcount : backend_label_i64_map.Map]
  [prev : compiler_ir_types.CompilerIrBlock]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : unit
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) unit]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-peephole-carry-safe-scan-seq
        backend-state
        stream
        function-state
        label-scope
        entry-label
        predcount
        prev
        seq
        0)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block cur-label _)
          (begin
            (if (and
              (not (= cur-label entry-label))
              (not
                (compiler-backend-peephole-prev-splits-edge?
                  function-state
                  prev))
              (=
                1
                (backend_label_i64_map.get-value-or (& predcount) cur-label 0))
              (compiler_optimize.opt-label-contains
                (compiler_optimize.opt-cfg-block-successors-with-next
                  prev
                  cur-label)
                cur-label))
              (compiler-backend-peephole-carry-safe-insert!
                backend-state
                stream
                (compiler-backend-asm-label label-scope cur-label))
              unit)
            (compiler-backend-peephole-carry-safe-scan
              backend-state
              stream
              function-state
              label-scope
              entry-label
              predcount
              block
              (__tl-box-place rest)))])]))

(define (compiler-backend-peephole-carry-safe-scan-seq
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]
  [function-state : CompilerBackendFunctionState]
  [label-scope : String]
  [entry-label : i64]
  [predcount : backend_label_i64_map.Map]
  [prev : compiler_ir_types.CompilerIrBlock]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [index : i64]) : unit
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    unit
    (let
      [block : compiler_ir_types.CompilerIrBlock
        (compiler_ir_types.compiler-ir-block-seq-ref blocks index)]
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block cur-label _)
          (begin
            (if (and
              (not (= cur-label entry-label))
              (not
                (compiler-backend-peephole-prev-splits-edge?
                  function-state
                  prev))
              (=
                1
                (backend_label_i64_map.get-value-or (& predcount) cur-label 0))
              (compiler_optimize.opt-label-contains
                (compiler_optimize.opt-cfg-block-successors-with-next
                  prev
                  cur-label)
                cur-label))
              (compiler-backend-peephole-carry-safe-insert!
                backend-state
                stream
                (compiler-backend-asm-label label-scope cur-label))
              unit)
            (compiler-backend-peephole-carry-safe-scan-seq
              backend-state
              stream
              function-state
              label-scope
              entry-label
              predcount
              block
              blocks
              (+ index 1)))]))))

;; Accumulate carry-safe block labels for one function's FINAL emitted blocks
;; into the global peephole carry-safe set. `label-scope` MUST be the same value
;; emit-blocks passes to compiler-backend-asm-label, so the keys match the
;; emitted label lines exactly. Computed from the post-transform emit-blocks so
;; the CFG it analyzes is the one actually emitted.
(define (compiler-backend-peephole-collect-carry-safe!
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]
  [function-state : CompilerBackendFunctionState]
  [label-scope : String]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : unit
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) unit]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (if (= (compiler_ir_types.compiler-ir-block-seq-count seq) 0)
        unit
        (let
          [entry : compiler_ir_types.CompilerIrBlock
            (compiler_ir_types.compiler-ir-block-seq-ref seq 0)]
          (match entry
            [(compiler_ir_types.CompilerIrBlock.Block entry-label _)
              (compiler-backend-peephole-carry-safe-scan-seq
                backend-state
                stream
                function-state
                label-scope
                entry-label
                (compiler-backend-peephole-predcount-build-seq
                  seq
                  0
                  (backend_label_i64_map.with-capacity 64))
                entry
                seq
                1)])))]
    [(compiler_ir_types.CompilerIrBlockList.Cons entry rest)
      (match entry
        [(compiler_ir_types.CompilerIrBlock.Block entry-label _)
          (compiler-backend-peephole-carry-safe-scan
            backend-state
            stream
            function-state
            label-scope
            entry-label
            (compiler-backend-peephole-predcount-build
              (compiler_ir_types.compiler-ir-block-cons
                entry
                (__tl-box-place rest))
              (backend_label_i64_map.with-capacity 64))
            entry
            (__tl-box-place rest))])]))

;; ============================================================================
;; M-G3 stage 1: rsp-relative frame addressing (behavior-neutral rebase).
;;
;; Every frame slot is emitted rbp-relative (`-K(%rbp)`; prologue: pushq %rbp /
;; movq %rsp,%rbp / subq $frame,%rsp), so `-K(%rbp)` == `(frame-K)(%rsp)`
;; whenever %rsp still sits at its post-prologue value. The final frame constant
;; is only known AFTER the body is emitted (emergency-scavenge use grows the
;; callee-save area and appends extra slots), so the rebase runs as a
;; post-emission text pass over the function's post-prologue text -- this is the
;; single point where the per-function frame model (frame constant + rbp-or-rsp
;; choice) is applied; stage 2 (frame-pointer omission) changes only the
;; prologue/epilogue and the bias fed to this pass.
;;
;; The pass PROVES rsp-constancy line by line instead of assuming it:
;;   * `delta` tracks any in-body %rsp displacement (bytes pushed beyond the
;;     prologue sub), such as the AVX-512 `pushq $1` mask dip or conservative
;;     fallback emitters. All such windows are straight-line and balanced within
;;     one instruction emission; a label inside a nonzero-delta window, or a
;;     net-negative delta, fails the audit. C-ABI outgoing args and arg/phi
;;     cycle temps are pre-reserved frame uses and no longer create such dips.
;;   * `pushq MEM` computes its address BEFORE %rsp moves; `popq MEM` AFTER --
;;     the delta updates are ordered accordingly.
;;   * `leave` and any other %rsp write (`leaq slot,%rsp` pop-restore
;;     epilogues, the closure adapters' `movq %rbp,%rsp`) end rsp validity;
;;     validity resumes at the next label (labels are only reachable at
;;     delta 0). A frame reference while %rsp is unknown fails the audit.
;;   * POSITIVE rbp offsets (incoming stack args at 16+8k(%rbp) and tail-call
;;     final stack-arg stores into those same slots) are LEFT on rbp: %rbp is
;;     still materialized in stage 1, and those accesses stay valid regardless
;;     of %rsp motion. Stage 2 rebases them with its adjusted constant.
;;   * Indexed rbp forms (`(%rbp,...`), a bare `(%rbp)`, or a rewritten offset
;;     that would go negative fail the audit (none are emitted today).
;; On ANY audit failure the ORIGINAL text is returned unchanged -- that
;; function simply keeps rbp addressing (needs-rbp), preserving behavior.
;;
;; The post-emission peephole recognizes both slot spellings through its
;; parsed stack-slot range predicate. Within any owner-map
;; lifetime every %rsp-mutating line (pushq/popq/subq/addq/leave/movq-to-rsp/
;; leaq-to-rsp/ret) conservatively clears the map; a returned call restores
;; %rsp and keeps only callee-saved stack-slot owners. Equal operand strings
;; therefore imply equal addresses in both worlds and the elision behavior
;; carries over 1:1.
(define compiler-backend-rsp-rebase-ok-count : i64
  0)
(define compiler-backend-rsp-rebase-keep-count : i64
  0)

;; M-G3 stage 2: result of the LAST rsp-rebase invocation (true = audit passed
;; and the returned text is the rewritten one). The caller picks the prologue
;; (FPO subq vs rbp push/mov/sub) and the demotion path from this.
(define compiler-backend-rsp-rebase-last-ok : bool
  true)

;; M-G3 stage 2 census: functions emitted frame-pointer-free / whose final plan
;; homes a value in %rbp / demoted (FPO audit failed on an rbp-planned function
;; -> re-planned without %rbp).
(define compiler-backend-fpo-count : i64
  0)
(define compiler-backend-fpo-rbp-plan-count : i64
  0)
(define compiler-backend-fpo-demote-count : i64
  0)

;; GAP1 census: FPO functions emitted with the push-style CSR prologue
;; (push-count > 0).
(define compiler-backend-fpo-push-count : i64
  0)
(define compiler-backend-peephole-r10-dead-scan-cap-hits : i64
  0)

;; Packed control-mnemonic classification shared by the RSP rebase audit and
;; the dead-frame-store sweep. Both passes used to ask the generic byte-range
;; comparator about the same small fixed set repeatedly for every assembly
;; line. Values are deliberately scalar so callers can derive all predicates
;; from one classification without allocating a token object.
(define compiler-backend-control-mnemonic-none : i64
  0)
(define compiler-backend-control-mnemonic-movq : i64
  1)
(define compiler-backend-control-mnemonic-leaq : i64
  2)
(define compiler-backend-control-mnemonic-push : i64
  3)
(define compiler-backend-control-mnemonic-pop : i64
  4)
(define compiler-backend-control-mnemonic-leave : i64
  5)
(define compiler-backend-control-mnemonic-ret : i64
  6)
(define compiler-backend-control-mnemonic-jmp : i64
  7)
(define compiler-backend-control-mnemonic-subq : i64
  8)
(define compiler-backend-control-mnemonic-addq : i64
  9)
(define compiler-backend-control-mnemonic-syscall : i64
  10)

(define (compiler-backend-control-mnemonic-kind
  [data : (Ptr u8)]
  [start : i64]
  [len : i64]) : i64
  (if (< len 3)
    compiler-backend-control-mnemonic-none
    (let
      [b0 : i64 (compiler-backend-peephole-byte-at data start)]
      [b1 : i64 (compiler-backend-peephole-byte-at data (+ start 1))]
      [b2 : i64 (compiler-backend-peephole-byte-at data (+ start 2))]
      [key3 : i64 (+ b0 (+ (* b1 256) (* b2 65536)))]
      (cond
        [(= len 3)
          (cond
            [(= key3 7368560) compiler-backend-control-mnemonic-pop]
            [(= key3 7628146) compiler-backend-control-mnemonic-ret]
            [(= key3 7368042) compiler-backend-control-mnemonic-jmp]
            [else compiler-backend-control-mnemonic-none])]
        [(>= len 4)
          (let
            [b3 : i64 (compiler-backend-peephole-byte-at data (+ start 3))]
            [key4 : i64 (+ key3 (* b3 16777216))]
            (cond
              [(= len 4)
                (cond
                  [(= key4 1903587181) compiler-backend-control-mnemonic-movq]
                  [(= key4 1902208364) compiler-backend-control-mnemonic-leaq]
                  [(= key4 1752397168) compiler-backend-control-mnemonic-push]
                  [(= key4 1903193968) compiler-backend-control-mnemonic-pop]
                  [(= key4 1902278003) compiler-backend-control-mnemonic-subq]
                  [(= key4 1902404705) compiler-backend-control-mnemonic-addq]
                  [else compiler-backend-control-mnemonic-none])]
              [(= len 5)
                (let
                  [b4 : i64
                    (compiler-backend-peephole-byte-at data (+ start 4))]
                  (cond
                    [(and (= key4 1752397168) (= b4 113))
                      compiler-backend-control-mnemonic-push]
                    [(and (= key4 1986094444) (= b4 101))
                      compiler-backend-control-mnemonic-leave]
                    [else compiler-backend-control-mnemonic-none]))]
              [(= len 7)
                (if (and
                  (= key4 1668512115)
                  (= (compiler-backend-peephole-byte-at data (+ start 4)) 97)
                  (= (compiler-backend-peephole-byte-at data (+ start 5)) 108)
                  (= (compiler-backend-peephole-byte-at data (+ start 6)) 108))
                  compiler-backend-control-mnemonic-syscall
                  compiler-backend-control-mnemonic-none)]
              [else compiler-backend-control-mnemonic-none]))]
        [else compiler-backend-control-mnemonic-none]))))

;; Index of the first "(%rbp" occurrence in [start,end), or -1. Jumps between
;; '(' bytes a word at a time instead of stepping every byte.
(define (compiler-backend-rsp-rebase-find-rbp
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [stop : i64 (- end 4)]
    [i : i64 start]
    [found : i64 -1]
    [done : bool false]
    (begin
      (while (and (not done) (<= (+ i 5) end))
        (let
          [pos : i64 (compiler-backend-peephole-scan-byte-range data i stop 40)]
          (if (>= pos stop)
            (set! done true)
            (if (and
              (= (compiler-backend-peephole-byte-at data (+ pos 1)) 37)
              (= (compiler-backend-peephole-byte-at data (+ pos 2)) 114)
              (= (compiler-backend-peephole-byte-at data (+ pos 3)) 98)
              (= (compiler-backend-peephole-byte-at data (+ pos 4)) 112))
              (begin
                (set! found pos)
                (set! done true))
              (set! i (+ pos 1))))))
      found)))

;; Start index of the signed decimal immediately preceding `pos`, or -1 when
;; there is none (a bare/indexed form the audit must reject).
(define (compiler-backend-rsp-rebase-int-start
  [data : (Ptr u8)]
  [line-start : i64]
  [pos : i64]) : i64
  (let
    [j : i64 pos]
    (begin
      (while (and
        (> j line-start)
        (let
          [b : i64 (compiler-backend-peephole-byte-at data (- j 1))]
          (and (>= b 48) (<= b 57))))
        (set! j (- j 1)))
      (if (= j pos)
        -1
        (if (and
          (> j line-start)
          (= (compiler-backend-peephole-byte-at data (- j 1)) 45))
          (- j 1)
          j)))))

;; Parse the (optionally '-'-signed) decimal in [start,end).
(define (compiler-backend-rsp-rebase-parse-int
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [neg : bool (= (compiler-backend-peephole-byte-at data start) 45)]
    [j : i64
      (if neg
        (+ start 1)
        start)]
    [v : i64 0]
    (begin
      (while (< j end)
        (begin
          (set!
            v
            (+ (* v 10) (- (compiler-backend-peephole-byte-at data j) 48)))
          (set! j (+ j 1))))
      (if neg
        (- 0 v)
        v))))

;; ============================================================================
;; GAP1 / Win64 FPO: push-style CSR prologue saves.
;;
;; The mov-form CSR save/restore (`movq %rXX, -K(%rbp)` / `movq -K(%rbp), %rXX`
;; / the pop-run `leaq -K(%rbp), %rsp; popq ...`) is converted AT THE REBASE
;; SEAM into clang's push form: the caller's prologue becomes
;;     pushq %r12 [.. pushq %rbp]      (plan-saved CSRs, slot-idx order)
;;     subq $S, %rsp                   (S = frame + pad; pad keeps alignment)
;; and the pass (push mode = fpo AND push-count > 0):
;;   * DELETES the save/restore movq lines (their slots -- the callee-save
;;     reservation inside `frame` -- become dead pad; the frame constant is
;;     NOT shrunk because the reservation sits mid-frame between the var area
;;     and the group/outgoing/emergency regions, so the offset span is fixed),
;;   * rewrites the pop-run entry `leaq CSRSLOT(%rbp), %rsp` to
;;     `addq $(S+delta), %rsp` (rsp -> the pushed area; the existing popq run
;;     then restores the same registers in the same order: the pop-run pops
;;     lowest-address-slot first = highest slot idx = exactly reverse push
;;     order) and the trailing `leave` folds to NOTHING (rsp is already at
;;     the return address; the fold amount D+delta must be exactly 0),
;;   * rewrites a bare `leave` (mov-restore epilogues, whose restore movs were
;;     deleted) to `addq $(S+delta), %rsp` + the full popq run.
;; Frame model: total displacement D = 8*n + S with S = frame + (n odd ? 0 : 8)
;; so D % 16 == 8 exactly like the old subq $(frame+8) -- call alignment holds.
;; The pushes occupy [entry_rsp-8n, entry_rsp-8), so local slots shift down 8n:
;;   negative K:  -K(%rbp) -> (S + delta - K)(%rsp)      (bias_neg = S)
;;   positive X:  +X(%rbp) -> (S + 8n - 8 + delta + X)(%rsp)  (bias_pos; the
;;     incoming-arg area is caller memory at fixed absolute addresses)
;; (n = 0 keeps the stage-2 single-bias formulas byte-identical.)
;; Soundness of the line classification: the ONLY emitters that reference the
;; callee-save slots (offset -(8*(slot-vars+idx+1)), idx in the plan-saved set)
;; are emit-save-callee-reg / emit-restore-callee-reg / the pop-run leaq --
;; group word1 slots start at frame-slots+1 (above every reserved CSR slot) and
;; emergency slots sit below frame-slots-emergency-max, so a saved-CSR-slot
;; offset is unambiguous. Any OTHER line shape referencing one fails the audit
;; (keep-rbp fallback on the ORIGINAL text stays correct: mov saves intact).
;; Win64 uses the same conversion, with every prologue push described by
;; `.seh_pushreg` and no `.seh_setframe`. Saved-CSR names are indexed by
;; ABI-specific callee-save slot: common 0..4 = r12..r15,rbx; Linux 5 = rbp;
;; Win64 5..7 = rsi,rdi,rbp. "" = not saved.
(define (compiler-backend-rsp-rebase-make-push-regs) : (__tl_dyn-array String)
  (let
    [regs : (__tl_dyn-array String) (__tl_make-array String 8)]
    [idx : i64 0]
    (begin
      (while (< idx (array-length regs))
        (begin
          (set! (array-ref regs idx) "")
          (set! idx (+ idx 1))))
      regs)))

;; Shared no-push array for the stage-1 / adapter / fallback call sites.
(define compiler-backend-rsp-rebase-no-push : (__tl_dyn-array String)
  (compiler-backend-rsp-rebase-make-push-regs))

;; Fill `regs` with the plan-saved CSR names (slot-idx order); returns the
;; count. The set is a pure function of the allocator plan (the scavenger only
;; hands out plan-saved callee regs; emergency picks are wrapped locally), so
;; it is fixed before body emission and matches every inline restore site.
(define (compiler-backend-fill-push-csr-regs!
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [regs : (__tl_dyn-array String)]
  [backend-state : CompilerBackendState]) : i64
  (let
    [names : (__tl_dyn-array i64) (__tl_make-array i64 8)]
    [idx : i64 0]
    [count : i64 0]
    (begin
      (set! (array-ref names 0) compiler_abi.compiler-reg-id-r12)
      (set! (array-ref names 1) compiler_abi.compiler-reg-id-r13)
      (set! (array-ref names 2) compiler_abi.compiler-reg-id-r14)
      (set! (array-ref names 3) compiler_abi.compiler-reg-id-r15)
      (set! (array-ref names 4) compiler_abi.compiler-reg-id-rbx)
      (if (compiler-backend-current-fn-win64? backend-state)
        (begin
          (set! (array-ref names 5) compiler_abi.compiler-reg-id-rsi)
          (set! (array-ref names 6) compiler_abi.compiler-reg-id-rdi)
          (set! (array-ref names 7) compiler_abi.compiler-reg-id-rbp))
        (begin
          (set! (array-ref names 5) compiler_abi.compiler-reg-id-rbp)
          (set! (array-ref names 6) compiler_abi.compiler-reg-id-invalid)
          (set! (array-ref names 7) compiler_abi.compiler-reg-id-invalid)))
      (while (< idx (array-length names))
        (let
          [reg-id : i64 (array-ref names idx)]
          (begin
            (if (and
              (not (= reg-id compiler_abi.compiler-reg-id-invalid))
              (compiler-backend-callee-needs-save?
                backend-state
                assignments
                reg-id))
              (begin
                (set!
                  (array-ref regs idx)
                  (compiler_abi.compiler-abi-register-spelling reg-id))
                (set! count (+ count 1)))
              (set! (array-ref regs idx) ""))
            (set! idx (+ idx 1)))))
      count)))

;; The prologue subq constant S under n pushes: frame + pad where pad keeps
;; the total displacement (8n + S) % 16 == 8 (frame is a 16-multiple), i.e.
;; the same call alignment as the no-push `subq $(frame+8)`.
(define (compiler-backend-rsp-rebase-push-sub
  [backend-state : CompilerBackendState]
  [frame : i64]
  [push-count : i64]) : i64
  (if (and
    (compiler-backend-function-state-bool?
      (compiler-backend-state-function-state backend-state)
      compiler-backend-function-bool-fpo-bare-frame)
    (= push-count 0))
    0
    (+
      frame
      (if (= (bit-and push-count 1) 1)
        0
        8))))

;; The popq run restoring the pushed CSRs: highest slot idx first (lowest
;; address = last pushed), matching the existing pop-run epilogue order.
;; Lines joined by newlines with NO trailing newline (append-line adds it).
(define (compiler-backend-rsp-rebase-pop-run
  [push-regs : (__tl_dyn-array String)]) : String
  (let
    [idx : i64 (- (array-length push-regs) 1)]
    [acc : String ""]
    (begin
      (while (>= idx 0)
        (begin
          (if (string.eq (array-ref push-regs idx) "")
            unit
            (set!
              acc
              (str_cat.str-cat
                acc
                (if (string.eq acc "")
                  ""
                  "\n")
                "    popq "
                (array-ref push-regs idx)
                "")))
          (set! idx (- idx 1))))
      acc)))

;; Classify a line whose first frame ref hits a SAVED callee-save slot
;; (push mode only). Returns:
;;   0 = not a saved-CSR-slot line (normal handling)
;;   1 = CSR save/restore movq (delete)
;;   2 = pop-run entry `leaq CSRSLOT(%rbp), %rsp`
;;   3 = malformed saved-CSR-slot reference (fail the audit)
(define (compiler-backend-rsp-rebase-csr-classify
  [data : (Ptr u8)]
  [line-start : i64]
  [m : i64]
  [te : i64]
  [end : i64]
  [mnemonic-kind : i64]
  [push-regs : (__tl_dyn-array String)]
  [slot-vars : i64]) : i64
  (let
    [p : i64 (compiler-backend-rsp-rebase-find-rbp data m end)]
    (if (or
      (< p 0)
      (>= (+ p 5) end)
      (not (= (compiler-backend-peephole-byte-at data (+ p 5)) 41)))
      0
      (let
        [ks : i64 (compiler-backend-rsp-rebase-int-start data line-start p)]
        (if (< ks 0)
          0
          (let
            [k : i64 (compiler-backend-rsp-rebase-parse-int data ks p)]
            (if (>= k 0)
              0
              (let
                [unit-idx : i64 (/ (- 0 k) 8)]
                (if (not (= (* unit-idx 8) (- 0 k)))
                  0
                  (let
                    [idx : i64 (- unit-idx (+ slot-vars 1))]
                    (if (or (< idx 0) (>= idx (array-length push-regs)))
                      0
                      (let
                        [reg : String (array-ref push-regs idx)]
                        (if (string.eq reg "")
                          0
                          (cond
                            [(=
                                mnemonic-kind
                                compiler-backend-control-mnemonic-movq)
                              ;; restore: movq -K(%rbp), %rXX
                              (if (and
                                (= ks (+ te 1))
                                (= (+ p 12) end)
                                (=
                                  (compiler-backend-peephole-byte-at
                                    data
                                    (+ p 6))
                                  44)
                                (=
                                  (compiler-backend-peephole-byte-at
                                    data
                                    (+ p 7))
                                  32)
                                (compiler-backend-peephole-range-eq?
                                  data
                                  (+ p 8)
                                  (+ p 12)
                                  reg))
                                1
                                ;; save: movq %rXX, -K(%rbp)
                                (if (and
                                  (= (+ p 6) end)
                                  (compiler-backend-peephole-range-eq?
                                    data
                                    (+ te 1)
                                    (+ te 5)
                                    reg)
                                  (=
                                    (compiler-backend-peephole-byte-at
                                      data
                                      (+ te 5))
                                    44)
                                  (=
                                    (compiler-backend-peephole-byte-at
                                      data
                                      (+ te 6))
                                    32)
                                  (= ks (+ te 7)))
                                  1
                                  3))]
                            [(=
                                mnemonic-kind
                                compiler-backend-control-mnemonic-leaq)
                              ;; pop-run entry: leaq -K(%rbp), %rsp
                              (if (and
                                (= ks (+ te 1))
                                (= (+ p 12) end)
                                (=
                                  (compiler-backend-peephole-byte-at
                                    data
                                    (+ p 6))
                                  44)
                                (=
                                  (compiler-backend-peephole-byte-at
                                    data
                                    (+ p 7))
                                  32)
                                (compiler-backend-peephole-range-eq?
                                  data
                                  (+ p 8)
                                  (+ p 12)
                                  "%rsp"))
                                2
                                3)]
                            [else 3]))))))))))))))

;; Rewrite one function's POST-PROLOGUE text to rsp-relative frame addressing
;; (`X(%rbp)` -> `(frame+delta+X)(%rsp)`); returns the ORIGINAL text when the
;; rsp-constancy audit fails (the function keeps rbp addressing).
;;
;; With `fpo = true` the function is emitted frame-pointer-free. A no-CSR
;; prologue uses `subq $(frame+8), %rsp`; a CSR plan uses push saves plus an
;; aligned sub-allocation. Win64 describes those operations with SEH unwind
;; codes. Differences from the stage-1 (behavior-neutral) mode:
;;   * POSITIVE rbp offsets (incoming stack args 16+8k(%rbp), tail-call final
;;     stack-arg stores) are rebased with the SAME formula -- the virtual rbp
;;     sits at rsp+frame post-prologue in both worlds.
;;   * `leave` becomes `addq $(frame+8+delta), %rsp` (there is no rbp frame to
;;     reset from). Requires a tracked rsp (valid); delta is normally 0.
;;   * the pop-restore epilogue `leaq slot,%rsp; popq CSR...` is TRACKED instead
;;     of ending validity: the leaq operand was just rebased on the same line
;;     (exactly one frame ref), so the new rsp is known (delta goes negative --
;;     the "epilogue tail"); the pops keep decrementing delta and the final
;;     `leave` rewrite folds the remainder. Negative delta stays a hard audit
;;     failure outside this recognized shape.
;;   * any OTHER rsp write (`movq %rbp,%rsp`, untracked leaq) FAILS the audit
;;     (stage 1 merely ended validity) -- without a frame pointer there is no
;;     way to re-establish rsp.
;; On audit failure the caller either re-runs in stage-1 mode (plan has no %rbp
;; home -> keep-rbp, byte-identical) or DEMOTES (re-plans the function without
;; %rbp in the pool and re-emits).
;;
;; #rbp-base invariant: in fpo mode every "(%rbp" occurrence is a frame
;; reference. Emitters structurally distinguish %rbp pool VALUES with a
;; no-base SIB spelling `(,%rbp,1)` where possible and otherwise stage through
;; a scratch (see address-base-filter); bare `%rbp` register operands also
;; contain no "(%rbp".
;; GAP1: 3-arg spelling for the stage-1 / adapter / fallback call sites --
;; byte-identical to the pre-GAP1 pass (no push mode).
(define (compiler-backend-rsp-rebase
  [text : String]
  [frame : i64]
  [fpo : bool]
  [backend-state : CompilerBackendState]) : String
  (compiler-backend-rsp-rebase-full
    text
    frame
    fpo
    (compiler-backend-global-shared-view compiler-backend-rsp-rebase-no-push)
    0
    0
    backend-state))

;; True when any block holds a call or syscall: such a function keeps the FPO
;; alignment adjustment.
(define (compiler-backend-blocks-have-call?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) false]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (if (compiler_regalloc.compiler-reg-loop-split-seq-has-call-or-syscall?
            instrs)
            true
            (compiler-backend-blocks-have-call? (__tl-box-place rest)))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-blocks-have-call?
        (compiler_ir_types.compiler-ir-block-seq-to-list seq))]))

(define (compiler-backend-rsp-rebase-full
  [text : String]
  [frame : i64]
  [fpo : bool]
  [push-regs : (__tl_dyn-array String)]
  [push-count : i64]
  [slot-vars : i64]
  [backend-state : CompilerBackendState]) : String
  (let
    [n : i64 (string.string-length text)]
    [data : (Ptr u8)
      (unsafe
        (string-data text))]
    [buf : (text_buf_borrowed.TextBufBorrowed text)
      (text_buf_borrowed.empty-like (& text))]
    [i : i64 0]
    [delta : i64 0]
    [valid : bool true]
    [ok : bool true]
    [tail : bool false]
    [last-noff : i64 -1]
    [ref-count : i64 0]
    ;; GAP1 push mode: prologue = pushes + subq $sub-s; disp = the total
    ;; prologue rsp displacement (plays frame+8's role in the leave fold).
    [pm : bool (and fpo (> push-count 0))]
    ;; Win64 unwind codes describe one fixed post-prologue %rsp. Unlike SysV
    ;; FPO, a Win64 FPO body cannot contain a transient stack dip: any ordinary
    ;; push/pop/sub/add/mov-to-rsp fails the audit. The recognized terminal
    ;; add/pop epilogue is still legal and is synthesized by this pass.
    [seh-fpo : bool
      (and fpo (compiler-backend-current-fn-win64? backend-state))]
    [sub-s : i64
      (compiler-backend-rsp-rebase-push-sub backend-state frame push-count)]
    [disp : i64 (+ (* push-count 8) sub-s)]
    [bias-neg : i64
      (if pm
        sub-s
        frame)]
    [bias-pos : i64
      (if pm
        (- (+ sub-s (* push-count 8)) 8)
        frame)]
    (begin
      (while (and ok (< i n))
        (let
          ;; The line ends at its newline, or at the text end.
          [end : i64 (compiler-backend-peephole-scan-byte-range data i n 10)]
          [nl : bool (< end n)]
          [m : i64 i]
          (begin
            (while (and
              (< m end)
              (= (compiler-backend-peephole-byte-at data m) 32))
              (set! m (+ m 1)))
            (if (>= m end)
              ;; blank line
              (set!
                buf
                (compiler-backend-peephole-append-line-range buf text i end nl))
              (if (= (compiler-backend-peephole-byte-at data (- end 1)) 58)
                ;; a label: only reachable at delta 0 (dip windows are
                ;; straight-line); it also re-establishes rsp validity after an
                ;; epilogue's terminal rsp motion.
                (begin
                  (if (and valid (not (= delta 0)))
                    (set! ok false)
                    unit)
                  (set! delta 0)
                  (set! valid true)
                  (set! tail false)
                  (set!
                    buf
                    (compiler-backend-peephole-append-line-range
                      buf
                      text
                      i
                      end
                      nl)))
                (let
                  [tok : i64
                    (-
                      (compiler-backend-peephole-scan-byte-range data m end 32)
                      m)]
                  [te : i64 (+ m tok)]
                  [mnemonic-kind : i64
                    (compiler-backend-control-mnemonic-kind data m tok)]
                  [push? : bool
                    (= mnemonic-kind compiler-backend-control-mnemonic-push)]
                  [pop? : bool
                    (= mnemonic-kind compiler-backend-control-mnemonic-pop)]
                  [leave? : bool
                    (= mnemonic-kind compiler-backend-control-mnemonic-leave)]
                  ;; A raw `syscall` can REPLACE %rsp in a way this textual
                  ;; audit cannot track -- `clone` (syscall 56, the raw-thread
                  ;; spawn) hands the CHILD a fresh stack, and rt_sigreturn loads
                  ;; a saved rsp. After such a syscall rsp is no longer provably
                  ;; rbp-frame, so every post-syscall frame ref rebased to
                  ;; N(%rsp) would read the wrong stack in the child (observed
                  ;; SEGV: thread-linux-spawn marshalled entry/arg/result-addr to
                  ;; child-main via N(%rsp) after clone). Most syscalls (write /
                  ;; read / futex / exit) leave rsp untouched, but the number is
                  ;; not reliably knowable at this text seam, so ANY syscall makes
                  ;; the WHOLE function keep rbp (frame refs via %rbp survive
                  ;; clone in both parent and child -- CLONE_VM shares the address
                  ;; space and rbp is never in clone's register set; byte-
                  ;; identical to pre-FPO for that function -- the sound choice).
                  [syscall? : bool
                    (= mnemonic-kind compiler-backend-control-mnemonic-syscall)]
                  [rsp-dst? : bool
                    (and
                      (>= (- end i) 6)
                      (= (compiler-backend-peephole-byte-at data (- end 1)) 112)
                      (= (compiler-backend-peephole-byte-at data (- end 6)) 44)
                      (= (compiler-backend-peephole-byte-at data (- end 5)) 32)
                      (= (compiler-backend-peephole-byte-at data (- end 4)) 37)
                      (= (compiler-backend-peephole-byte-at data (- end 3)) 114)
                      (= (compiler-backend-peephole-byte-at data (- end 2)) 115))]
                  ;; GAP1 push mode: classify saved-CSR-slot lines FIRST --
                  ;; the save/restore movs are deleted (the prologue pushes /
                  ;; epilogue pops replace them) and the pop-run leaq is
                  ;; redirected at the pushed area. Only when rsp is tracked
                  ;; (an untracked CSR ref falls through and fails like any
                  ;; other frame ref).
                  [csr-kind : i64
                    (if (and pm valid)
                      (compiler-backend-rsp-rebase-csr-classify
                        data
                        i
                        m
                        te
                        end
                        mnemonic-kind
                        push-regs
                        slot-vars)
                      0)]
                  (begin
                    (set! last-noff -1)
                    (set! ref-count 0)
                    ;; Unprovable rsp shape -> keep rbp for the whole
                    ;; function (audit fail). ok=false terminates the pass loop;
                    ;; the caller falls back to rbp addressing (or demotes an
                    ;; rbp-planned function). Placed before the per-line frame /
                    ;; rsp logic: a syscall line carries no frame ref, so the
                    ;; remaining arms are inert on it.
                    (if syscall?
                      (set! ok false)
                      unit)
                    (if (and
                      seh-fpo
                      (or
                        push?
                        (and pop? (not tail))
                        (and rsp-dst? (not (= csr-kind 2)))))
                      (set! ok false)
                      unit)
                    ;; lint-allow: nested-if-ladder
                    (if (= csr-kind 1)
                      ;; CSR save/restore movq: drop the line.
                      unit
                      (if (= csr-kind 2)
                        ;; pop-run entry: point rsp at the pushed area
                        ;; (entry_rsp - 8n = rsp_f + sub-s); the following
                        ;; pops restore the pushed CSRs in reverse push
                        ;; order and the final leave folds to 0.
                        (if tail
                          (set! ok false)
                          (begin
                            ;; `addq $0` would point rsp where it already is:
                            ;; with a dead slot region the pushed area starts at
                            ;; the current rsp, so the pop run needs no rebase
                            ;; line at all. (The rewrite already replaces a
                            ;; flag-free `leaq` with a flag-setting `addq`, so
                            ;; dropping the line cannot lose a live flag.)
                            (if (= (+ sub-s delta) 0)
                              unit
                              (set!
                                buf
                                (compiler-backend-peephole-append-line
                                  buf
                                  (str_cat.str-cat
                                    "    addq $"
                                    (string.int->string (+ sub-s delta))
                                    ", %rsp")
                                  nl)))
                            (set! tail true)
                            (set! delta (- 0 sub-s))))
                        (if (= csr-kind 3)
                          ;; unrecognized saved-CSR-slot reference: the slot
                          ;; is unwritten under push saves -- keep rbp.
                          (set! ok false)
                          (begin
                            ;; popq MEM computes its address AFTER the rsp increment.
                            (if (and valid pop?)
                              (begin
                                (set! delta (- delta 8))
                                ;; negative delta is legal only inside the FPO epilogue
                                ;; tail (the pops after a rebased `leaq slot,%rsp`).
                                (if (and (< delta 0) (not (and fpo tail)))
                                  (set! ok false)
                                  unit))
                              unit)
                            (if (and fpo leave?)
                              ;; FPO: no rbp frame to `leave` from -- unwind rsp
                              ;; directly (prologue reserved frame+8, push mode
                              ;; 8n+sub-s; a negative delta folds the pop-restore
                              ;; epilogue tail when present).
                              (begin
                                ;; lint-allow: nested-if-ladder
                                (if (not valid)
                                  (set! ok false)
                                  (if (and pm tail)
                                    ;; GAP1 push mode after a pop run: every pushed
                                    ;; CSR was popped, rsp already sits at the return
                                    ;; address -- the fold must be EXACTLY 0 and the
                                    ;; leave vanishes.
                                    (if (= (+ disp delta) 0)
                                      unit
                                      (set! ok false))
                                    (if pm
                                      ;; GAP1 push mode, mov-restore epilogue (the
                                      ;; restore movs were deleted): deallocate the
                                      ;; subq area and pop the pushed CSRs.
                                      (let
                                        [amount : i64 (+ sub-s delta)]
                                        (if (< amount 0)
                                          (set! ok false)
                                          (set!
                                            buf
                                            (compiler-backend-peephole-append-line
                                              buf
                                              (str_cat.str-cat
                                                (if (= amount 0)
                                                  ""
                                                  (str_cat.str-cat
                                                    "    addq $"
                                                    (string.int->string amount)
                                                    ", %rsp\n"))
                                                (compiler-backend-rsp-rebase-pop-run
                                                  push-regs)
                                                "")
                                              nl))))
                                      (let
                                        [amount : i64
                                          (if (compiler-backend-function-state-bool?
                                            (compiler-backend-state-function-state
                                              backend-state)
                                            compiler-backend-function-bool-fpo-bare-frame)
                                            delta
                                            (+ (+ frame 8) delta))]
                                        (if (< amount 0)
                                          (set! ok false)
                                          (if (= amount 0)
                                            unit
                                            (set!
                                              buf
                                              (compiler-backend-peephole-append-line
                                                buf
                                                (str_cat.str-cat
                                                  "    addq $"
                                                  (string.int->string amount)
                                                  ", %rsp")
                                                nl))))))))
                                (set! valid false)
                                (set! tail false))
                              (begin
                                ;; frame-reference rewrite
                                (let
                                  [rbp-stop : i64 (- end 4)]
                                  [first-paren : i64
                                    (if (<= (+ m 5) end)
                                      (compiler-backend-peephole-scan-byte-range
                                        data
                                        m
                                        rbp-stop
                                        40)
                                      rbp-stop)]
                                  [p : i64
                                    (if (>= first-paren rbp-stop)
                                      -1
                                      (if (and
                                        (=
                                          (compiler-backend-peephole-byte-at
                                            data
                                            (+ first-paren 1))
                                          37)
                                        (=
                                          (compiler-backend-peephole-byte-at
                                            data
                                            (+ first-paren 2))
                                          114)
                                        (=
                                          (compiler-backend-peephole-byte-at
                                            data
                                            (+ first-paren 3))
                                          98)
                                        (=
                                          (compiler-backend-peephole-byte-at
                                            data
                                            (+ first-paren 4))
                                          112))
                                        first-paren
                                        (compiler-backend-rsp-rebase-find-rbp
                                          data
                                          (+ first-paren 1)
                                          end)))]
                                  (if (< p 0)
                                    (set!
                                      buf
                                      (compiler-backend-peephole-append-line-range
                                        buf
                                        text
                                        i
                                        end
                                        nl))
                                    (if (not valid)
                                      (set! ok false)
                                      (let
                                        [cursor : i64 i]
                                        (begin
                                          (while (and ok (>= p 0))
                                            (begin
                                              (if (or
                                                (>= (+ p 5) end)
                                                (not
                                                  (=
                                                    (compiler-backend-peephole-byte-at
                                                      data
                                                      (+ p 5))
                                                    41)))
                                                ;; "(%rbp," indexed or truncated
                                                (set! ok false)
                                                (let
                                                  [ks : i64
                                                    (compiler-backend-rsp-rebase-int-start
                                                      data
                                                      i
                                                      p)]
                                                  (if (< ks 0)
                                                    ;; bare "(%rbp)"
                                                    (set! ok false)
                                                    (let
                                                      [k : i64
                                                        (compiler-backend-rsp-rebase-parse-int
                                                          data
                                                          ks
                                                          p)]
                                                      (if (and
                                                        (>= k 0)
                                                        (not fpo))
                                                        ;; incoming stack-arg slot: keep
                                                        ;; rbp (stage 1 -- %rbp is live).
                                                        ;; In FPO mode positive offsets
                                                        ;; rebase with the SAME formula
                                                        ;; (virtual rbp = rsp+frame).
                                                        unit
                                                        (let
                                                          ;; GAP1 push mode: negative
                                                          ;; (local) offsets shift down by
                                                          ;; the pushed bytes (bias sub-s);
                                                          ;; positive (incoming-arg)
                                                          ;; offsets keep their absolute
                                                          ;; caller-side addresses (bias
                                                          ;; sub-s+8n-8). Both equal
                                                          ;; `frame` when push-count = 0.
                                                          [noff : i64
                                                            (+
                                                              (+
                                                                (if (>= k 0)
                                                                  bias-pos
                                                                  bias-neg)
                                                                delta)
                                                              k)]
                                                          (if (< noff 0)
                                                            (set! ok false)
                                                            (begin
                                                              (set!
                                                                buf
                                                                (compiler-backend-peephole-append-line-range
                                                                  buf
                                                                  text
                                                                  cursor
                                                                  ks
                                                                  false))
                                                              (set!
                                                                buf
                                                                (text_buf_borrowed.append-owned
                                                                  buf
                                                                  (string.int->string
                                                                    noff)))
                                                              (set!
                                                                buf
                                                                (text_buf_borrowed.append-owned
                                                                  buf
                                                                  "(%rsp)"))
                                                              (set!
                                                                last-noff
                                                                noff)
                                                              (set!
                                                                ref-count
                                                                (+ ref-count 1))
                                                              (set!
                                                                cursor
                                                                (+ p 6))))))))))
                                              (set!
                                                p
                                                (if ok
                                                  (let
                                                    [next-start : i64 (+ p 6)]
                                                    [next-paren : i64
                                                      (if (<=
                                                        (+ next-start 5)
                                                        end)
                                                        (compiler-backend-peephole-scan-byte-range
                                                          data
                                                          next-start
                                                          rbp-stop
                                                          40)
                                                        rbp-stop)]
                                                    (if (>= next-paren rbp-stop)
                                                      -1
                                                      (if (and
                                                        (=
                                                          (compiler-backend-peephole-byte-at
                                                            data
                                                            (+ next-paren 1))
                                                          37)
                                                        (=
                                                          (compiler-backend-peephole-byte-at
                                                            data
                                                            (+ next-paren 2))
                                                          114)
                                                        (=
                                                          (compiler-backend-peephole-byte-at
                                                            data
                                                            (+ next-paren 3))
                                                          98)
                                                        (=
                                                          (compiler-backend-peephole-byte-at
                                                            data
                                                            (+ next-paren 4))
                                                          112))
                                                        next-paren
                                                        (compiler-backend-rsp-rebase-find-rbp
                                                          data
                                                          (+ next-paren 1)
                                                          end))))
                                                  -1))))
                                          (if ok
                                            (set!
                                              buf
                                              (compiler-backend-peephole-append-line-range
                                                buf
                                                text
                                                cursor
                                                end
                                                nl))
                                            unit))))))
                                ;; pushq MEM computes its address BEFORE the rsp decrement.
                                (if (and valid push?)
                                  (set! delta (+ delta 8))
                                  unit)
                                ;; explicit %rsp writes
                                (if (and rsp-dst? (not pop?))
                                  ;; lint-allow: nested-if-ladder
                                  (if (and
                                    valid
                                    (=
                                      mnemonic-kind
                                      compiler-backend-control-mnemonic-subq)
                                    (< (+ te 1) end)
                                    (=
                                      (compiler-backend-peephole-byte-at
                                        data
                                        (+ te 1))
                                      36))
                                    (set!
                                      delta
                                      (+
                                        delta
                                        (compiler-backend-rsp-rebase-parse-int
                                          data
                                          (+ te 2)
                                          (- end 6))))
                                    (if (and
                                      valid
                                      (=
                                        mnemonic-kind
                                        compiler-backend-control-mnemonic-addq)
                                      (< (+ te 1) end)
                                      (=
                                        (compiler-backend-peephole-byte-at
                                          data
                                          (+ te 1))
                                        36))
                                      (begin
                                        (set!
                                          delta
                                          (-
                                            delta
                                            (compiler-backend-rsp-rebase-parse-int
                                              data
                                              (+ te 2)
                                              (- end 6))))
                                        (if (< delta 0)
                                          (set! ok false)
                                          unit))
                                      (if fpo
                                        ;; FPO: only the pop-restore epilogue's
                                        ;; `leaq slot,%rsp` is provable -- the slot operand
                                        ;; was rebased on THIS line (exactly one frame
                                        ;; ref), so the new rsp is P + last-noff, i.e.
                                        ;; delta -= last-noff (the epilogue tail). Any
                                        ;; other rsp write is unrecoverable without a
                                        ;; frame pointer.
                                        (if (and
                                          valid
                                          (not tail)
                                          (= ref-count 1)
                                          (=
                                            mnemonic-kind
                                            compiler-backend-control-mnemonic-leaq))
                                          (begin
                                            (set! tail true)
                                            (set! delta (- delta last-noff)))
                                          (set! ok false))
                                        ;; unknown rsp write (leaq slot,%rsp epilogue,
                                        ;; movq %rbp,%rsp, ...): rsp no longer tracked.
                                        (set! valid false))))
                                  unit)
                                (if leave?
                                  (set! valid false)
                                  unit)))))))))))
            (set!
              i
              (if (< end n)
                (+ end 1)
                end)))))
      (if ok
        (begin
          (set! compiler-backend-rsp-rebase-last-ok true)
          (set!
            compiler-backend-rsp-rebase-ok-count
            (+ compiler-backend-rsp-rebase-ok-count 1))
          (text_buf_borrowed.render buf))
        (begin
          (set! compiler-backend-rsp-rebase-last-ok false)
          (set!
            compiler-backend-rsp-rebase-keep-count
            (+ compiler-backend-rsp-rebase-keep-count 1))
          text)))))

;; ============================================================================
;; GAP5: post-emission dead frame-store sweep.
;;
;; M-B elided IR-dead call-result stores, but a store whose every READ was
;; register-forwarded by the owner-map peephole (or that was asm-dead all
;; along, e.g. a syscall-result store whose return reload collapsed to an
;; elided self-move) is invisible at IR level. This pass runs on the FINAL
;; program text (after the peephole fixpoint) and deletes
;; `movq %rX|$imm, N(%rsp)` stores to LOCAL VAR-REGION frame slots that are
;; never read anywhere in the function body. It participates for Linux FPO
;; functions and for Win64 rbp-framed functions whose negative frame slots were
;; successfully rebased to rsp-relative text.
;;
;; Soundness ledger (conservative-by-class; when in doubt the store stays):
;;  * Only functions that passed an rsp-rebase audit participate.
;;    emit-function records (symbol, lo, hi, disp) into POINTER-FREE global
;;    tables (an `(Array String)` global dangles by peephole time -- the
;;    carry-safe lesson) where [lo, hi] is the VAR-REGION slot-start span in
;;    canonical (delta-0, rsp-relative) bytes: lo = bias_neg - 8*slot-vars,
;;    hi = bias_neg - 8 with bias_neg = sub-s (push mode) / frame -- exactly
;;    the rebase pass's negative-offset bias. The CSR save area, group word1
;;    region and emergency slots all sit at LARGER frame depths (canonical
;;    < lo); outgoing stack args (`(shadow+8k)(%rsp)`), c-abi dip windows and
;;    phi cycle-break push slots sit below the locals (canonical
;;    < outgoing+extra <= lo); rebased POSITIVE offsets (incoming stack args,
;;    tail-call stack-arg stores = caller memory) sit at canonical > hi. A
;;    candidate must land on an 8-aligned slot inside [lo, hi], so every
;;    protected class is excluded by construction.
;;  * The per-line rsp delta is re-tracked exactly like the audit that
;;    already validated this function: the region starts at delta = -disp so
;;    the prologue's pushes + subq land the body at 0; labels reset to 0;
;;    subq/addq $imm, %rsp and push/pop are tracked -- so refs inside c-abi
;;    dip windows canonicalize correctly.
;;  * Reads: EVERY frame ref that is not itself a candidate store marks
;;    [C, C+w) read, w = 16/32/64 when the line mentions %xmm/%ymm/%zmm (64
;;    for unmatched v*/k* vector mnemonics), else 8 -- a 16-byte movups
;;    covering two slots protects both. Presence-of-a-read ANYWHERE keeps all
;;    stores to the slot: no text-level flow analysis, so loops, shared
;;    epilogues and jump-table arms are covered by the whole-function scan.
;;  * Win64 keeps the rbp frame for SEH unwind (`pushq %rbp; movq %rsp,%rbp;
;;    subq $frame,%rsp`, `.seh_*` directives, `leave`). The unwind metadata
;;    describes prologue actions only; it does not expose local var slots to
;;    the runtime. For Win64 records the scanner therefore admits the rbp-set
;;    prologue line, terminal CSR pop-run `leaq K(%rsp),%rsp` where K is below
;;    the var span, and `leave`. Any non-terminal untracked rsp mutation still
;;    disables the function.
;;  * Address-taken slots: `leaq N(%rsp)` poisons every slot at canonical
;;    >= N-delta (an object pointer only ever indexes upward: gep field and
;;    element offsets are non-negative). Indexed rsp addressing "(%rsp,",
;;    popq with a frame operand (post-increment addressing), bare %rsp
;;    outside a tracked subq/addq dst or the proven Win64 prologue/epilogue
;;    shapes, and any other untracked rsp write each disable the WHOLE function.
;;  * Only whole `movq SRC, N(%rsp)` lines are removed, SRC a single %reg
;;    (not %rsp) or $imm token: a pure 8-byte store to a private, never-read,
;;    never-address-taken local slot has no observable effect (the runtime
;;    has no GC stack walk -- the M-B argument).
;; Driven from compiler-backend-peephole-asm (all text-emission paths); with
;; an empty metadata table (hand-written text or raw peephole callers) the
;; pass returns its input unchanged.
(define compiler-backend-sweep-initial-capacity : i64
  128)
(define compiler-backend-sweep-capacity : i64
  131072)
(define compiler-backend-sweep-initial-bytes-capacity : i64
  4096)
(define compiler-backend-sweep-bytes-capacity : i64
  8388608)

;; Emergency-slot window [em-lo, em-hi] in the same canonical delta-0
;; rsp-relative bytes as [lo, hi]. Empty (em-lo > em-hi) when the function used
;; no emergency scavenge slots or has outgoing stack-arg space (whose callee
;; reads are invisible to the text scan and may alias the emergency window).
(define compiler-backend-sweep-swept-stores : i64
  0)
(define compiler-backend-sweep-swept-funcs : i64
  0)
(define compiler-backend-sweep-dropped-funcs : i64
  0)
(define compiler-backend-sweep-dropped-table-cap : i64
  0)
(define compiler-backend-sweep-dropped-bytes-cap : i64
  0)

;; Sentinel for "this line is not a candidate store".
(define compiler-backend-sweep-no-candidate : i64
  -4611686018427387904)

;; Per-line sweep classes stored on the record (`sweep-kind`).
;;  * Skip: blank lines, `.`-directives and `#` comments -- invisible to the
;;    scan, exactly like the byte walk's `unit` arms.
;;  * Label: resets the running rsp delta to 0 (or ends a Win64 tail).
;;  * Instruction: everything else; `sweep-flags` and the offset fields below
;;    describe it.
(define compiler-backend-sweep-line-kind-skip : i64
  0)
(define compiler-backend-sweep-line-kind-label : i64
  1)
(define compiler-backend-sweep-line-kind-instruction : i64
  2)

;; Packed delta-independent predicates for one instruction line (`sweep-flags`).
;; `win64-rbp-set` is the SHAPE only (`movq %rsp, %rbp`); the Win64 gate is
;; applied by the sweep, which alone knows the function's record.
(define compiler-backend-sweep-line-flag-push : i64
  1)
(define compiler-backend-sweep-line-flag-pop : i64
  2)
(define compiler-backend-sweep-line-flag-leaq : i64
  4)
(define compiler-backend-sweep-line-flag-leave : i64
  8)
(define compiler-backend-sweep-line-flag-ret : i64
  16)
(define compiler-backend-sweep-line-flag-jmp : i64
  32)
(define compiler-backend-sweep-line-flag-subq : i64
  64)
(define compiler-backend-sweep-line-flag-rsp-dst : i64
  128)
(define compiler-backend-sweep-line-flag-tracked-rsp-write : i64
  256)
(define compiler-backend-sweep-line-flag-win64-rbp-set : i64
  512)

;; An indexed / truncated `(%rsp` reference: disables the whole function
;; unconditionally (the sweep cannot bound what such a line touches).
;;
;; A `popq` whose operand addresses the frame used to be fatal here too. It is
;; not: a pop's frame operand is a perfectly ordinary bounded reference, it just
;; sits at a %rsp that has ALREADY been incremented, so the replay canonicalizes
;; it at delta-8 (matching the FPO rebase pass, which lowers delta before
;; rewriting a pop's refs). Production emission contains no `popq MEM` today, so
;; the fatal arms were unreachable -- but a single such line would have silently
;; disqualified its whole function from the dead-frame-store sweep (+7,292 dead
;; stores measured when one was emitted experimentally).
(define compiler-backend-sweep-line-flag-fatal-mem : i64
  1024)

;; Bare `%rsp` occurrences, split by whether they sit at the line's final
;; operand position (`, %rsp`), which is the only position the tracked
;; subq/addq and Win64 epilogue shapes may write.
(define compiler-backend-sweep-line-flag-bare-rsp : i64
  2048)
(define compiler-backend-sweep-line-flag-bare-rsp-tail : i64
  4096)

(define (compiler-backend-sweep-line-flag? [flags : i64] [flag : i64]) : bool
  (not (= (bit-and flags flag) 0)))

(define (compiler-backend-sweep-storage-ensure!
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]) : unit
  (let
    [data : CompilerBackendStreamStateData
      (compiler-backend-stream-state-data stream)]
    (if (> (array-length data.sweep-sym-off) 0)
      unit
      (let
        [owner : arena.Arena
          (compiler-backend-state-lazy-table-arena-ensure! backend-state)]
        (in-arena
          owner
          (let
            [cap : i64 compiler-backend-sweep-initial-capacity]
            (begin
              (set! data.sweep-sym-off (array.make-array i64 cap))
              (set! data.sweep-sym-len (array.make-array i64 cap))
              (set! data.sweep-lo-arr (array.make-array i64 cap))
              (set! data.sweep-hi-arr (array.make-array i64 cap))
              (set! data.sweep-disp-arr (array.make-array i64 cap))
              (set! data.sweep-win64-arr (array.make-array i64 cap))
              (set! data.sweep-em-lo-arr (array.make-array i64 cap))
              (set! data.sweep-em-hi-arr (array.make-array i64 cap))
              (set!
                data.sweep-sym-bytes
                (array.make-array
                  u8
                  compiler-backend-sweep-initial-bytes-capacity))
              (compiler-backend-stream-state-data-set! stream data))))))))

(define (compiler-backend-sweep-table-grow!
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]) : bool
  (let
    [data : CompilerBackendStreamStateData
      (compiler-backend-stream-state-data stream)]
    [old-cap : i64 (array-length data.sweep-sym-off)]
    [new-cap : i64
      (if (> (* old-cap 4) compiler-backend-sweep-capacity)
        compiler-backend-sweep-capacity
        (* old-cap 4))]
    (if (<= new-cap old-cap)
      false
      (let
        [owner : arena.Arena
          (compiler-backend-state-lazy-table-arena-ensure! backend-state)]
        (in-arena
          owner
          (let
            [sym-off : (__tl_dyn-array i64) (array.make-array i64 new-cap)]
            [sym-len : (__tl_dyn-array i64) (array.make-array i64 new-cap)]
            [lo-arr : (__tl_dyn-array i64) (array.make-array i64 new-cap)]
            [hi-arr : (__tl_dyn-array i64) (array.make-array i64 new-cap)]
            [disp-arr : (__tl_dyn-array i64) (array.make-array i64 new-cap)]
            [win64-arr : (__tl_dyn-array i64) (array.make-array i64 new-cap)]
            [em-lo-arr : (__tl_dyn-array i64) (array.make-array i64 new-cap)]
            [em-hi-arr : (__tl_dyn-array i64) (array.make-array i64 new-cap)]
            [i : i64 0]
            (begin
              (while (< i data.sweep-count)
                (begin
                  (set! (array-ref sym-off i) (array-ref data.sweep-sym-off i))
                  (set! (array-ref sym-len i) (array-ref data.sweep-sym-len i))
                  (set! (array-ref lo-arr i) (array-ref data.sweep-lo-arr i))
                  (set! (array-ref hi-arr i) (array-ref data.sweep-hi-arr i))
                  (set!
                    (array-ref disp-arr i)
                    (array-ref data.sweep-disp-arr i))
                  (set!
                    (array-ref win64-arr i)
                    (array-ref data.sweep-win64-arr i))
                  (set!
                    (array-ref em-lo-arr i)
                    (array-ref data.sweep-em-lo-arr i))
                  (set!
                    (array-ref em-hi-arr i)
                    (array-ref data.sweep-em-hi-arr i))
                  (set! i (+ i 1))))
              (set! data.sweep-sym-off sym-off)
              (set! data.sweep-sym-len sym-len)
              (set! data.sweep-lo-arr lo-arr)
              (set! data.sweep-hi-arr hi-arr)
              (set! data.sweep-disp-arr disp-arr)
              (set! data.sweep-win64-arr win64-arr)
              (set! data.sweep-em-lo-arr em-lo-arr)
              (set! data.sweep-em-hi-arr em-hi-arr)
              (compiler-backend-stream-state-data-set! stream data)
              true)))))))

(define (compiler-backend-sweep-bytes-grow!
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]
  [required : i64]) : bool
  (let
    [data : CompilerBackendStreamStateData
      (compiler-backend-stream-state-data stream)]
    [old : (__tl_dyn-array u8) data.sweep-sym-bytes]
    [new-cap : i64 (array-length old)]
    (begin
      (while (and
        (< new-cap required)
        (< new-cap compiler-backend-sweep-bytes-capacity))
        (set!
          new-cap
          (if (> (* new-cap 4) compiler-backend-sweep-bytes-capacity)
            compiler-backend-sweep-bytes-capacity
            (* new-cap 4))))
      (if (< new-cap required)
        false
        (let
          [owner : arena.Arena
            (compiler-backend-state-lazy-table-arena-ensure! backend-state)]
          (in-arena
            owner
            (let
              [bytes : (__tl_dyn-array u8) (array.make-array u8 new-cap)]
              [i : i64 0]
              (begin
                (while (< i data.sweep-sym-bytes-count)
                  (begin
                    (set! (array-ref bytes i) (array-ref old i))
                    (set! i (+ i 1))))
                (set! data.sweep-sym-bytes bytes)
                (compiler-backend-stream-state-data-set! stream data)
                true))))))))

(define (compiler-backend-sweep-reset! [stream : CompilerBackendStreamState]) : unit
  (let
    [data : CompilerBackendStreamStateData
      (compiler-backend-stream-state-data stream)]
    (begin
      (set! data.sweep-count 0)
      (set! data.sweep-sym-bytes-count 0)
      (compiler-backend-stream-state-data-set! stream data)
      (set! compiler-backend-sweep-swept-stores 0)
      (set! compiler-backend-sweep-swept-funcs 0)
      (set! compiler-backend-sweep-dropped-funcs 0)
      (set! compiler-backend-sweep-dropped-table-cap 0)
      (set! compiler-backend-sweep-dropped-bytes-cap 0))))

;; Record one FPO-audited function's sweep metadata. A full table silently
;; drops the entry (the function is simply not swept -- sound).
(define (compiler-backend-sweep-record!
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]
  [symbol : String]
  [lo : i64]
  [hi : i64]
  [disp : i64]
  [em-lo : i64]
  [em-hi : i64]
  [win64 : bool]) : unit
  (let
    [_storage : unit
      (compiler-backend-sweep-storage-ensure! backend-state stream)]
    [data : CompilerBackendStreamStateData
      (compiler-backend-stream-state-data stream)]
    [len : i64 (string.string-length symbol)]
    [sdata : (Ptr u8)
      (unsafe
        (string-data symbol))]
    [start : i64 data.sweep-sym-bytes-count]
    [table-ok : bool
      (or
        (< data.sweep-count (array-length data.sweep-sym-off))
        (compiler-backend-sweep-table-grow! backend-state stream))]
    [bytes-ok : bool
      (or
        (<= (+ start len) (array-length data.sweep-sym-bytes))
        (compiler-backend-sweep-bytes-grow! backend-state stream (+ start len)))]
    (if (or (not table-ok) (not bytes-ok))
      (begin
        (set!
          compiler-backend-sweep-dropped-funcs
          (+ compiler-backend-sweep-dropped-funcs 1))
        (if (not table-ok)
          (set!
            compiler-backend-sweep-dropped-table-cap
            (+ compiler-backend-sweep-dropped-table-cap 1))
          unit)
        (if (not bytes-ok)
          (set!
            compiler-backend-sweep-dropped-bytes-cap
            (+ compiler-backend-sweep-dropped-bytes-cap 1))
          unit))
      (let
        [current : CompilerBackendStreamStateData
          (compiler-backend-stream-state-data stream)]
        [j : i64 0]
        [idx : i64 current.sweep-count]
        (begin
          (while (< j len)
            (begin
              (set!
                (array-ref current.sweep-sym-bytes (+ start j))
                (cast (compiler-backend-peephole-byte-at sdata j) : u8))
              (set! j (+ j 1))))
          (set! (array-ref current.sweep-sym-off idx) start)
          (set! (array-ref current.sweep-sym-len idx) len)
          (set! (array-ref current.sweep-lo-arr idx) lo)
          (set! (array-ref current.sweep-hi-arr idx) hi)
          (set! (array-ref current.sweep-disp-arr idx) disp)
          (set!
            (array-ref current.sweep-win64-arr idx)
            (if win64
              1
              0))
          (set! (array-ref current.sweep-em-lo-arr idx) em-lo)
          (set! (array-ref current.sweep-em-hi-arr idx) em-hi)
          (set! current.sweep-sym-bytes-count (+ start len))
          (set! current.sweep-count (+ idx 1))
          (compiler-backend-stream-state-data-set! stream current))))))

;; Compute [lo, hi] (the VAR-REGION slot-start span in canonical delta-0
;; rsp-relative bytes) and disp (total prologue rsp displacement) for one
;; FPO-audited function, then record it. Mirrors the rebase pass's biases:
;;   push mode (push-count > 0): bias_neg = sub-s, disp = 8n + sub-s
;;   plain FPO (push-count = 0):  bias_neg = frame, disp = frame + 8
;; lo = bias_neg - 8*slot-vars (deepest var slot), hi = bias_neg - 8 (var 0).
;; Every protected slot class sits at canonical < lo (CSR/group-word1/
;; emergency/outgoing) or > hi (positive incoming/tail stack args).
(define (compiler-backend-sweep-record-fpo!
  [stream : CompilerBackendStreamState]
  [symbol : String]
  [frame : i64]
  [push-count : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]
  [backend-state : CompilerBackendState]) : unit
  (let
    [sub-s : i64
      (compiler-backend-rsp-rebase-push-sub backend-state frame push-count)]
    [pm : bool (> push-count 0)]
    [bias-neg : i64
      (if pm
        sub-s
        frame)]
    [disp : i64
      (if pm
        (+ (* push-count 8) sub-s)
        (+ frame 8))]
    ;; Emergency scavenge slots live at rbp offset em-slot-offset - 64*i for
    ;; i in [0, em-used-count); canonical = bias_neg + (negative rbp offset).
    ;; They are read only by their own restores (visible in the text), EXCEPT
    ;; when the function has outgoing stack-arg space: arg slots share the
    ;; frame bottom and are read by callees, so the window stays empty then.
    [em-hi : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (+
          (+ bias-neg em-slot-offset)
          (- (compiler-backend-emergency-slot-size) 8))
        0)]
    [em-lo : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (-
          (+ bias-neg em-slot-offset)
          (* (compiler-backend-emergency-slot-size) (- em-used-count 1)))
        8)]
    (compiler-backend-sweep-record!
      backend-state
      stream
      symbol
      (- bias-neg (* 8 slot-vars))
      (- bias-neg 8)
      disp
      em-lo
      em-hi
      (compiler-backend-current-fn-win64? backend-state))))

;; Compute [lo, hi] and disp for one Win64 rbp-framed function whose negative
;; rbp frame refs were successfully rebased to rsp-relative text. The body sees
;; rsp at rbp-frame, while the scanner starts before the prologue:
;; pushq %rbp (+8) plus subq $frame means disp = frame + 8.
(define (compiler-backend-sweep-record-win64!
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]
  [symbol : String]
  [frame : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]) : unit
  (let
    [em-hi : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (+
          (+ frame em-slot-offset)
          (- (compiler-backend-emergency-slot-size) 8))
        0)]
    [em-lo : i64
      (if (and (> em-used-count 0) (= outgoing 0))
        (-
          (+ frame em-slot-offset)
          (* (compiler-backend-emergency-slot-size) (- em-used-count 1)))
        8)]
    (compiler-backend-sweep-record!
      backend-state
      stream
      symbol
      (- frame (* 8 slot-vars))
      (- frame 8)
      (+ frame 8)
      em-lo
      em-hi
      true)))

;; Commit census and sweep state only for the layout that emit-function returns.
;; Shrink-wrap fallback retries can change the prologue push count and frame
;; displacement, so a discarded attempt must never enter the ordered sweep
;; metadata stream.
(define (compiler-backend-commit-frame-layout!
  [backend-state : CompilerBackendState]
  [target : CompilerBackendTarget]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]
  [symbol : String]
  [frame : i64]
  [push-count : i64]
  [slot-vars : i64]
  [outgoing : i64]
  [fpo-ok : bool]
  [rebase-ok : bool]
  [shrinkwrap-active? : bool]) : unit
  (begin
    (if fpo-ok
      (begin
        (set! compiler-backend-fpo-count (+ compiler-backend-fpo-count 1))
        (if (> push-count 0)
          (set!
            compiler-backend-fpo-push-count
            (+ compiler-backend-fpo-push-count 1))
          unit)
        (if (compiler-backend-plan-uses-reg?
          backend-state
          assignments
          compiler_abi.compiler-reg-id-rbp)
          (set!
            compiler-backend-fpo-rbp-plan-count
            (+ compiler-backend-fpo-rbp-plan-count 1))
          unit))
      unit)
    ;; The sweep's displacement model starts at a function-entry prologue.
    ;; Keep shrink-wrapped interior prologues conservatively excluded.
    (cond
      [shrinkwrap-active? unit]
      [fpo-ok
        (compiler-backend-sweep-record-fpo!
          (compiler-backend-state-stream-state backend-state)
          symbol
          frame
          push-count
          slot-vars
          (compiler-backend-function-scratch-i64
            (compiler-backend-state-function-state backend-state)
            compiler-backend-scratch-i64-emergency-slot-offset)
          (compiler-backend-function-scratch-i64
            (compiler-backend-state-function-state backend-state)
            compiler-backend-scratch-i64-emergency-used-count)
          outgoing
          backend-state)]
      [(and (compiler-backend-target-windows? target) rebase-ok)
        (compiler-backend-sweep-record-win64!
          backend-state
          (compiler-backend-state-stream-state backend-state)
          symbol
          frame
          slot-vars
          (compiler-backend-function-scratch-i64
            (compiler-backend-state-function-state backend-state)
            compiler-backend-scratch-i64-emergency-slot-offset)
          (compiler-backend-function-scratch-i64
            (compiler-backend-state-function-state backend-state)
            compiler-backend-scratch-i64-emergency-used-count)
          outgoing)]
      [else unit])))

;; Append `v` at `count` into a growable i64 scratch array; returns the
;; (possibly reallocated) array. The caller advances its own count.
(define (compiler-backend-sweep-i64-push
  [arr : (__tl_dyn-array i64)]
  [count : i64]
  [v : i64]) : (__tl_dyn-array i64)
  (if (< count (array-length arr))
    (begin
      (set! (array-ref arr count) v)
      arr)
    (let
      [old : i64 (array-length arr)]
      [ncap : i64
        (if (< old 64)
          128
          (* old 2))]
      [na : (__tl_dyn-array i64) (__tl_make-array i64 ncap)]
      [k : i64 0]
      (begin
        (while (< k count)
          (begin
            (set! (array-ref na k) (array-ref arr k))
            (set! k (+ k 1))))
        (set! (array-ref na count) v)
        na))))

;; True iff the line [ls,le) is exactly "<sym>:" for metadata entry `idx`.
(define (compiler-backend-sweep-label-matches?
  [stream : CompilerBackendStreamState]
  [data : (Ptr u8)]
  [ls : i64]
  [le : i64]
  [idx : i64]) : bool
  (let
    [state-data : CompilerBackendStreamStateData
      (compiler-backend-stream-state-data stream)]
    [off : i64 (array-ref state-data.sweep-sym-off idx)]
    [len : i64 (array-ref state-data.sweep-sym-len idx)]
    (if (not (= (- le ls) (+ len 1)))
      false
      (if (not (= (compiler-backend-peephole-byte-at data (- le 1)) 58))
        false
        (let
          [j : i64 0]
          [ok : bool true]
          (begin
            (while (and ok (< j len))
              (begin
                (if (=
                  (compiler-backend-peephole-byte-at data (+ ls j))
                  (cast (array-ref state-data.sweep-sym-bytes (+ off j)) : i64))
                  unit
                  (set! ok false))
                (set! j (+ j 1))))
            ok))))))

;; First record at/after `start` whose trimmed content begins ".globl" (the next
;; function/helper boundary); returns that record's index, or `count`. The probe
;; is a packed bit decided once, when the record was built.
(define (compiler-backend-sweep-region-end-records
  [recs : (__tl_dyn-array CompilerBackendPeepholeLineRecord)]
  [start : i64]
  [count : i64]) : i64
  (let
    [i : i64 start]
    (begin
      (while (< i count)
        (begin
          (when
            (compiler-backend-peephole-record-globl? (array-ref recs i))
            (return i))
          (set! i (+ i 1))))
      count)))

;; First '%' index in [start, end-4], or -1: every position that can start a
;; four-byte "%rsp" reference. Jumps straight to it a word at a time.
(define (compiler-backend-sweep-next-percent
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [stop : i64 (- end 3)]
    [hit : i64 (compiler-backend-peephole-scan-byte-range data start stop 37)]
    (if (>= hit stop)
      -1
      hit)))

;; If line [m,end) (mnemonic token ending at te) is exactly
;; `movq SRC, N(%rsp)` with SRC a single %reg (not %rsp) or $imm token and a
;; digits-only offset, return the store's canonical offset N-delta; else the
;; no-candidate sentinel.
(define (compiler-backend-sweep-candidate-c
  [data : (Ptr u8)]
  [m : i64]
  [te : i64]
  [end : i64]
  [mnemonic-kind : i64]
  [comma-hint : i64]
  [delta : i64]) : i64
  (let
    [none : i64 compiler-backend-sweep-no-candidate]
    ;; lint-allow: nested-if-ladder
    (if (not (= mnemonic-kind compiler-backend-control-mnemonic-movq))
      none
      (if (or (>= (+ te 1) end) (< (- end te) 10))
        none
        (if (not
          (and
            (= (compiler-backend-peephole-byte-at data (- end 1)) 41)
            (compiler-backend-peephole-range-eq?
              data
              (- end 6)
              (- end 1)
              "(%rsp")))
          none
          (let
            [s0 : i64 (+ te 1)]
            [b0 : i64 (compiler-backend-peephole-byte-at data s0)]
            (if (not (or (= b0 37) (= b0 36)))
              none
              (let
                [c
                  : i64
                  ;; >= 0: the caller's descriptor already found this ", " at
                  ;; the same position the scan below would return.
                  (if (>= comma-hint 0)
                    comma-hint
                    (let
                      [q : i64 s0]
                      [found : i64 -1]
                      (begin
                        (while (and (= found -1) (< (+ q 1) end))
                          (if (and
                            (= (compiler-backend-peephole-byte-at data q) 44)
                            (=
                              (compiler-backend-peephole-byte-at data (+ q 1))
                              32))
                            (set! found q)
                            (set! q (+ q 1))))
                        found)))]
                (if (< c 0)
                  none
                  (let
                    [j : i64 s0]
                    [bad : bool false]
                    (begin
                      (while (< j c)
                        (begin
                          (if (= (compiler-backend-peephole-byte-at data j) 40)
                            (set! bad true)
                            unit)
                          (set! j (+ j 1))))
                      (if (compiler-backend-peephole-range-eq? data s0 c "%rsp")
                        (set! bad true)
                        unit)
                      (if bad
                        none
                        (let
                          [ds : i64 (+ c 2)]
                          [de : i64 (- end 6)]
                          (if (>= ds de)
                            ;; bare "(%rsp)" store dst: not a rebased local.
                            none
                            (let
                              [ks : i64
                                (compiler-backend-rsp-rebase-int-start
                                  data
                                  m
                                  de)]
                              (if (not (= ks ds))
                                none
                                (-
                                  (compiler-backend-rsp-rebase-parse-int
                                    data
                                    ks
                                    de)
                                  delta)))))))))))))))))

;; If line [m,end) is exactly `leaq N(%rsp), %rsp`, return the canonical N-delta.
;; Win64 uses this only for terminal CSR pop-run epilogues; callers still check
;; that the target is outside the local var span before admitting it.
(define (compiler-backend-sweep-rsp-leaq-to-rsp-c
  [data : (Ptr u8)]
  [m : i64]
  [te : i64]
  [end : i64]
  [mnemonic-kind : i64]
  [delta : i64]) : i64
  (let
    [none : i64 compiler-backend-sweep-no-candidate]
    ;; lint-allow: nested-if-ladder
    (if (not (= mnemonic-kind compiler-backend-control-mnemonic-leaq))
      none
      (if (or (>= (+ te 1) end) (< (- end te) 14))
        none
        (if (not
          (compiler-backend-peephole-range-eq? data (- end 6) end ", %rsp"))
          none
          (let
            [c : i64 (- end 6)]
            (if (or
              (< c (+ te 7))
              (not (= (compiler-backend-peephole-byte-at data (- c 1)) 41))
              (not
                (compiler-backend-peephole-range-eq?
                  data
                  (- c 6)
                  (- c 1)
                  "(%rsp")))
              none
              (let
                [ds : i64 (+ te 1)]
                [de : i64 (- c 6)]
                (if (>= ds de)
                  none
                  (let
                    [ks : i64 (compiler-backend-rsp-rebase-int-start data m de)]
                    (if (not (= ks ds))
                      none
                      (-
                        (compiler-backend-rsp-rebase-parse-int data ks de)
                        delta))))))))))))

;; True iff the "%rsp" at `q` on line [m,end) opens a MEMORY base reference,
;; i.e. it is preceded by '('. Whether that reference is CLOSED by ')' is asked
;; separately (below), because an unclosed one is the indexed/truncated form
;; that disables the function rather than a readable frame reference.
(define (compiler-backend-sweep-rsp-ref-memory-base?
  [data : (Ptr u8)]
  [m : i64]
  [q : i64]) : bool
  (and (> q m) (= (compiler-backend-peephole-byte-at data (- q 1)) 40)))

(define (compiler-backend-sweep-rsp-ref-closed?
  [data : (Ptr u8)]
  [q : i64]
  [end : i64]) : bool
  (and (< (+ q 4) end) (= (compiler-backend-peephole-byte-at data (+ q 4)) 41)))

;; Raw frame displacement of the `N(%rsp)` reference that starts at `q`.
;; A missing/indexed decimal reads as 0, exactly like the byte walk.
(define (compiler-backend-sweep-rsp-ref-offset
  [data : (Ptr u8)]
  [m : i64]
  [q : i64]) : i64
  (let
    [ks : i64 (compiler-backend-rsp-rebase-int-start data m (- q 1))]
    (if (< ks 0)
      0
      (compiler-backend-rsp-rebase-parse-int data ks (- q 1)))))

;; Raw displacement of the k-th closed `N(%rsp)` memory reference on line
;; [m,end). The record caches k = 0; x86 encodes at most one memory operand
;; per instruction, so this walk only ever serves a hand-written or future
;; multi-reference line (k >= 1) and keeps that case exact instead of
;; approximating it.
(define (compiler-backend-sweep-line-mem-off-nth
  [data : (Ptr u8)]
  [m : i64]
  [end : i64]
  [k : i64]) : i64
  (let
    [seen : i64 0]
    [q : i64 m]
    (begin
      (while (<= (+ q 4) end)
        (let
          [pct : i64 (compiler-backend-sweep-next-percent data q end)]
          (begin
            (if (< pct 0)
              (set! q end)
              (set! q pct))
            (if (and
              (>= pct 0)
              (= (compiler-backend-peephole-byte-at data (+ q 1)) 114)
              (= (compiler-backend-peephole-byte-at data (+ q 2)) 115)
              (= (compiler-backend-peephole-byte-at data (+ q 3)) 112))
              (begin
                (when
                  (and
                    (compiler-backend-sweep-rsp-ref-memory-base? data m q)
                    (compiler-backend-sweep-rsp-ref-closed? data q end))
                  (begin
                    (when
                      (= seen k)
                      (return (compiler-backend-sweep-rsp-ref-offset data m q)))
                    (set! seen (+ seen 1))))
                (set! q (+ q 4)))
              (set! q (+ q 1))))))
      0)))

;; Sweep one function region [rstart,rend) of the record array: collect
;; reads/candidates/poison state in pass 1, then mark every dead candidate
;; store's record deleted. The line bytes are never re-read -- the per-record
;; summary already carries everything the byte walk derived, with the
;; delta-dependent offsets kept raw and rebased here.
;; Fixed-size scratch bitmap for the region sweep's pass 2: one bit per byte
;; of the eligibility coverage window, reused across regions (only the used
;; prefix is zeroed per region). Pass 2's per-candidate decisions are
;; mutually independent given the reads, watermark and windows, so the
;; overlap test runs against this bitmap when the window fits the cap:
;; candidate at c is swept iff no bit is set in [c-wlo, c+8-wlo). A set bit at
;; x means some read covers byte x, and eligibility forces c into a window
;; (hence [c,c+8) into the coverage window), so the query is literally the
;; per-read predicate it replaces: any bit in [c,c+8) iff exists r with
;; lo_r < c+8 and hi_r > c. Byte granularity keeps unaligned reads and
;; 16/32/64-byte widths exact.
;;
;; Largest coverage window served by the bitmap, in i64 words (64 bytes per
;; word). Wider frames keep the exact per-candidate read scan; the choice
;; depends only on region metadata, never on results.
(define compiler-backend-sweep-coverage-max-words : i64
  4096)

(define (compiler-backend-sweep-coverage-ensure!
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]
  [required : i64]) : bool
  (let
    [data : CompilerBackendStreamStateData
      (compiler-backend-stream-state-data stream)]
    [old : (__tl_dyn-array i64) data.sweep-coverage-bits]
    [new-cap : i64
      (if (= (array-length old) 0)
        64
        (array-length old))]
    (begin
      (while (and
        (< new-cap required)
        (< new-cap compiler-backend-sweep-coverage-max-words))
        (set!
          new-cap
          (if (> (* new-cap 2) compiler-backend-sweep-coverage-max-words)
            compiler-backend-sweep-coverage-max-words
            (* new-cap 2))))
      (if (< new-cap required)
        false
        (if (= new-cap (array-length old))
          true
          (let
            [owner : arena.Arena
              (compiler-backend-state-lazy-table-arena-ensure! backend-state)]
            (in-arena
              owner
              (let
                [bits : (__tl_dyn-array i64) (array.make-array i64 new-cap)]
                (begin
                  (set! data.sweep-coverage-bits bits)
                  (compiler-backend-stream-state-data-set! stream data)
                  true)))))))))

(define (compiler-backend-sweep-region-records!
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]
  [recs : (__tl_dyn-array CompilerBackendPeepholeLineRecord)]
  [live : (__tl_dyn-array i64)]
  [rstart : i64]
  [rend : i64]
  [lo : i64]
  [hi : i64]
  [disp : i64]
  [em-lo : i64]
  [em-hi : i64]
  [win64 : bool]) : unit
  (let
    [delta : i64 (- 0 disp)]
    [sweepable : bool true]
    [win64-tail : bool false]
    [watermark : i64 4611686018427387904]
    [none : i64 compiler-backend-sweep-no-candidate]
    [reads-lo : (__tl_dyn-array i64) (__tl_make-array i64 64)]
    [reads-hi : (__tl_dyn-array i64) (__tl_make-array i64 64)]
    [read-count : i64 0]
    [cand-pos : (__tl_dyn-array i64) (__tl_make-array i64 32)]
    [cand-off : (__tl_dyn-array i64) (__tl_make-array i64 32)]
    [cand-count : i64 0]
    [i : i64 rstart]
    (begin
      ;; ---- pass 1 ----
      (while (and sweepable (< i rend))
        (let
          [line : CompilerBackendPeepholeLineRecord (array-ref recs i)]
          [kind : i64 (compiler-backend-peephole-record-kind line)]
          (begin
            (cond
              [(= kind compiler-backend-sweep-line-kind-skip) unit]
              [(= kind compiler-backend-sweep-line-kind-label)
                ;; label: only reachable at delta 0 (the audit proved it).
                (if win64-tail
                  (set! sweepable false)
                  (set! delta 0))]
              [else
                (let
                  [meta : i64 line.meta]
                  (if (not
                    (=
                      (bit-and
                        meta
                        compiler-backend-peephole-record-sweep-inert-bit)
                      0))
                    ;; Sweep-inert record: no rsp motion, read, candidate or
                    ;; epilogue effect by construction (the bit's comment at
                    ;; the record packing gives the exact invariant); only
                    ;; Win64-tail poisoning remains.
                    (when win64-tail (set! sweepable false))
                    (let
                      [cand-raw : i64 line.cand]
                      (if (not (= cand-raw none))
                        ;; Verified candidate store: flags, mem-count and
                        ;; epilogue are empty by construction, so only
                        ;; Win64-tail poisoning and the candidate pushes
                        ;; remain.
                        (begin
                          (when win64-tail (set! sweepable false))
                          (set!
                            cand-pos
                            (if (< cand-count (array-length cand-pos))
                              (begin
                                (set! (array-ref cand-pos cand-count) i)
                                cand-pos)
                              (compiler-backend-sweep-i64-push
                                cand-pos
                                cand-count
                                i)))
                          (set!
                            cand-off
                            (if (< cand-count (array-length cand-off))
                              (begin
                                (set!
                                  (array-ref cand-off cand-count)
                                  (- cand-raw delta))
                                cand-off)
                              (compiler-backend-sweep-i64-push
                                cand-off
                                cand-count
                                (- cand-raw delta))))
                          (set! cand-count (+ cand-count 1)))
                        (let
                          [flags : i64
                            (compiler-backend-peephole-record-flags line)]
                          [push? : bool
                            (compiler-backend-sweep-line-flag?
                              flags
                              compiler-backend-sweep-line-flag-push)]
                          [pop? : bool
                            (compiler-backend-sweep-line-flag?
                              flags
                              compiler-backend-sweep-line-flag-pop)]
                          [leaq? : bool
                            (compiler-backend-sweep-line-flag?
                              flags
                              compiler-backend-sweep-line-flag-leaq)]
                          [leave? : bool
                            (compiler-backend-sweep-line-flag?
                              flags
                              compiler-backend-sweep-line-flag-leave)]
                          [subq? : bool
                            (compiler-backend-sweep-line-flag?
                              flags
                              compiler-backend-sweep-line-flag-subq)]
                          [rsp-dst? : bool
                            (compiler-backend-sweep-line-flag?
                              flags
                              compiler-backend-sweep-line-flag-rsp-dst)]
                          [tracked-rsp-write? : bool
                            (compiler-backend-sweep-line-flag?
                              flags
                              compiler-backend-sweep-line-flag-tracked-rsp-write)]
                          [win64-rbp-set? : bool
                            (and
                              win64
                              (compiler-backend-sweep-line-flag?
                                flags
                                compiler-backend-sweep-line-flag-win64-rbp-set))]
                          [epilogue-raw : i64 line.epilogue]
                          [win64-epilogue-c : i64
                            (if (or (not win64) (= epilogue-raw none))
                              none
                              (- epilogue-raw delta))]
                          [win64-epilogue-leaq? : bool
                            (and
                              (not (= win64-epilogue-c none))
                              (< win64-epilogue-c lo))]
                          [win64-tail-ok? : bool
                            (or
                              pop?
                              leave?
                              (compiler-backend-sweep-line-flag?
                                flags
                                compiler-backend-sweep-line-flag-ret)
                              (compiler-backend-sweep-line-flag?
                                flags
                                compiler-backend-sweep-line-flag-jmp))]
                          (begin
                            (if (and win64-tail (not win64-tail-ok?))
                              (set! sweepable false)
                              unit)
                            (if (and leave? (not win64))
                              (set! sweepable false)
                              unit)
                            ;; general line: replay the recorded %rsp classification.
                            (let
                              [mem-count : i64
                                (compiler-backend-peephole-record-mem-count
                                  line)]
                              [w : i64
                                (compiler-backend-peephole-record-width line)]
                              [k : i64 0]
                              (begin
                                ;; "(%rsp," indexed / truncated.
                                (when
                                  (compiler-backend-sweep-line-flag?
                                    flags
                                    compiler-backend-sweep-line-flag-fatal-mem)
                                  (set! sweepable false))
                                ;; bare %rsp: only the tracked subq/addq $imm dst and
                                ;; proven Win64 prologue/epilogue shapes are allowed.
                                (when
                                  (and
                                    (compiler-backend-sweep-line-flag?
                                      flags
                                      compiler-backend-sweep-line-flag-bare-rsp)
                                    (not win64-rbp-set?))
                                  (set! sweepable false))
                                (when
                                  (and
                                    (compiler-backend-sweep-line-flag?
                                      flags
                                      compiler-backend-sweep-line-flag-bare-rsp-tail)
                                    (not win64-rbp-set?)
                                    (not win64-epilogue-leaq?)
                                    (not tracked-rsp-write?))
                                  (set! sweepable false))
                                (while (< k mem-count)
                                  (let
                                    ;; `popq MEM` increments %rsp BEFORE computing
                                    ;; its destination address, so its frame
                                    ;; operand is canonical at delta-8 -- the same
                                    ;; bias the FPO rebase pass applies (it lowers
                                    ;; delta before rewriting a pop's refs). Every
                                    ;; other line, push included (`push m` reads its
                                    ;; operand at the ORIGINAL %rsp), is canonical
                                    ;; at delta.
                                    [c : i64
                                      (-
                                        (if (= k 0)
                                          line.value
                                          (compiler-backend-sweep-line-mem-off-nth
                                            (compiler-backend-peephole-record-data
                                              line)
                                            (compiler-backend-peephole-record-mnemonic-start
                                              line)
                                            (compiler-backend-peephole-record-end
                                              line)
                                            k))
                                        (if pop?
                                          (- delta 8)
                                          delta))]
                                    (begin
                                      (if leaq?
                                        ;; address taken: poison upward
                                        (if win64-epilogue-leaq?
                                          unit
                                          (if (< c watermark)
                                            (set! watermark c)
                                            unit))
                                        (begin
                                          (set!
                                            reads-lo
                                            (if (<
                                              read-count
                                              (array-length reads-lo))
                                              (begin
                                                (set!
                                                  (array-ref
                                                    reads-lo
                                                    read-count)
                                                  c)
                                                reads-lo)
                                              (compiler-backend-sweep-i64-push
                                                reads-lo
                                                read-count
                                                c)))
                                          (set!
                                            reads-hi
                                            (if (<
                                              read-count
                                              (array-length reads-hi))
                                              (begin
                                                (set!
                                                  (array-ref
                                                    reads-hi
                                                    read-count)
                                                  (+ c w))
                                                reads-hi)
                                              (compiler-backend-sweep-i64-push
                                                reads-hi
                                                read-count
                                                (+ c w))))
                                          (set! read-count (+ read-count 1))))
                                      (set! k (+ k 1)))))))
                            ;; rsp motion
                            (if (and rsp-dst? (not pop?))
                              (if win64-epilogue-leaq?
                                (begin
                                  (set! delta (- 0 win64-epilogue-c))
                                  (set! win64-tail true))
                                (if tracked-rsp-write?
                                  (if subq?
                                    (set! delta (+ delta line.value))
                                    (set! delta (- delta line.value)))
                                  (set! sweepable false)))
                              unit)
                            (if push?
                              (set! delta (+ delta 8))
                              unit)
                            (if pop?
                              (set! delta (- delta 8))
                              unit)))))))])
            (set! i (+ i 1)))))
      ;; ---- pass 2 ----
      ;; Coverage window over the eligibility windows (the em window's
      ;; emptiness convention is em-lo=8 > em-hi=0; the var window is empty
      ;; when slot-vars=0, i.e. lo > hi). whi gets +8 so a candidate at
      ;; exactly c == hi has its whole [hi, hi+8) store covered. Both windows
      ;; empty means no candidate can be eligible; a window wider than the
      ;; cap keeps the exact per-candidate read scan.
      (if (or (not sweepable) (= cand-count 0))
        unit
        (let
          [em-nonempty? : bool (<= em-lo em-hi)]
          [var-nonempty? : bool (<= lo hi)]
          [wlo : i64
            (if (and em-nonempty? (< em-lo lo))
              em-lo
              lo)]
          [whi : i64
            (+
              (if (> hi em-hi)
                hi
                em-hi)
              8)]
          [words : i64 (/ (+ (- whi wlo) 63) 64)]
          [use-bitmap? : bool
            (and
              (or em-nonempty? var-nonempty?)
              (<= words compiler-backend-sweep-coverage-max-words)
              (compiler-backend-sweep-coverage-ensure!
                backend-state
                stream
                words))]
          [coverage-bits : (__tl_dyn-array i64)
            (__tl-project-field
              (compiler-backend-stream-state-data stream)
              sweep-coverage-bits)]
          (begin
            (if use-bitmap?
              (begin
                (let
                  [w : i64 0]
                  (while (< w words)
                    (begin
                      (set! (array-ref coverage-bits w) 0)
                      (set! w (+ w 1)))))
                (let
                  [r : i64 0]
                  (while (< r read-count)
                    (let
                      [a : i64
                        (-
                          (if (> (array-ref reads-lo r) wlo)
                            (array-ref reads-lo r)
                            wlo)
                          wlo)]
                      [b : i64
                        (-
                          (if (< (array-ref reads-hi r) whi)
                            (array-ref reads-hi r)
                            whi)
                          wlo)]
                      (begin
                        (if (< a b)
                          (let
                            [aw : i64 (shr a 6)]
                            [bw : i64 (shr (- b 1) 6)]
                            [w : i64 aw]
                            (while (<= w bw)
                              (let
                                [lo-bit : i64
                                  (if (= w aw)
                                    (bit-and a 63)
                                    0)]
                                [hi-bit : i64
                                  (if (= w bw)
                                    (bit-and (- b 1) 63)
                                    63)]
                                [width : i64 (+ (- hi-bit lo-bit) 1)]
                                [mask : i64
                                  (if (= width 64)
                                    -1
                                    (shl (- (shl 1 width) 1) lo-bit))]
                                (begin
                                  (set!
                                    (array-ref coverage-bits w)
                                    (bit-or (array-ref coverage-bits w) mask))
                                  (set! w (+ w 1))))))
                          unit)
                        (set! r (+ r 1)))))))
              unit)
            (let
              [k : i64 0]
              [swept : i64 0]
              (begin
                (while (< k cand-count)
                  (let
                    [c : i64 (array-ref cand-off k)]
                    [pos : i64 (array-ref cand-pos k)]
                    (begin
                      (if (and
                        (or
                          (and (>= c lo) (<= c hi) (= (bit-and (- c lo) 7) 0))
                          (and
                            (>= c em-lo)
                            (<= c em-hi)
                            (= (bit-and (- c em-lo) 7) 0)))
                        (< c watermark))
                        (let
                          [read : bool
                            (if use-bitmap?
                              (let
                                [a : i64 (- c wlo)]
                                [aw : i64 (shr a 6)]
                                [bw : i64 (shr (+ a 7) 6)]
                                [w : i64 aw]
                                [hit : bool false]
                                (begin
                                  (while (and (not hit) (<= w bw))
                                    (let
                                      [lo-bit : i64
                                        (if (= w aw)
                                          (bit-and a 63)
                                          0)]
                                      [hi-bit : i64
                                        (if (= w bw)
                                          (bit-and (+ a 7) 63)
                                          63)]
                                      [width : i64 (+ (- hi-bit lo-bit) 1)]
                                      [mask : i64
                                        (if (= width 64)
                                          -1
                                          (shl (- (shl 1 width) 1) lo-bit))]
                                      (begin
                                        (if (not
                                          (=
                                            (bit-and
                                              (array-ref coverage-bits w)
                                              mask)
                                            0))
                                          (set! hit true)
                                          unit)
                                        (set! w (+ w 1)))))
                                  hit))
                              (let
                                [r : i64 0]
                                [hit : bool false]
                                (begin
                                  (while (and (not hit) (< r read-count))
                                    (begin
                                      (if (and
                                        (< (array-ref reads-lo r) (+ c 8))
                                        (< c (array-ref reads-hi r)))
                                        (set! hit true)
                                        unit)
                                      (set! r (+ r 1))))
                                  hit)))]
                          (if read
                            unit
                            (begin
                              (set! (array-ref live pos) 0)
                              (set! swept (+ swept 1)))))
                        unit)
                      (set! k (+ k 1)))))
                (if (> swept 0)
                  (begin
                    (set!
                      compiler-backend-sweep-swept-stores
                      (+ compiler-backend-sweep-swept-stores swept))
                    (set!
                      compiler-backend-sweep-swept-funcs
                      (+ compiler-backend-sweep-swept-funcs 1)))
                  unit)))))))))

(define (compiler-backend-borrowed-copy-to-owned
  [buf : (text_buf_borrowed.TextBufBorrowed asm)]) : text_buf.TextBuf
  (match buf
    [(text_buf_borrowed.TextBufBorrowed chunks len)
      (text_buf.TextBuf (text_buf_borrowed.chunks-to-owned chunks) len)]))

;; Sweep one group's line records, resuming at the next metadata entry from an
;; earlier group. The caller owns the cursor and resets global sweep metadata
;; only after the final group. Dead stores are marked in the record array's
;; `live` mask; nothing is copied or rebuilt.
(define (compiler-backend-deadstore-sweep-records!
  [backend-state : CompilerBackendState]
  [stream : CompilerBackendStreamState]
  [v : CompilerBackendPeepholeLineVec]
  [start-cursor : i64]) : i64
  (let
    [data : CompilerBackendStreamStateData
      (compiler-backend-stream-state-data stream)]
    (if (>= start-cursor data.sweep-count)
      start-cursor
      (let
        [recs : (__tl_dyn-array CompilerBackendPeepholeLineRecord) v.lines]
        [live : (__tl_dyn-array i64) v.live]
        [count : i64 v.len]
        [cursor : i64 start-cursor]
        [i : i64 0]
        (begin
          (while (and (< i count) (< cursor data.sweep-count))
            (let
              [line : CompilerBackendPeepholeLineRecord (array-ref recs i)]
              (if (compiler-backend-sweep-label-matches?
                stream
                (compiler-backend-peephole-record-data line)
                (compiler-backend-peephole-record-start line)
                (compiler-backend-peephole-record-end line)
                cursor)
                (let
                  [rstart : i64 (+ i 1)]
                  [rend : i64
                    (compiler-backend-sweep-region-end-records
                      recs
                      rstart
                      count)]
                  (begin
                    (compiler-backend-sweep-region-records!
                      backend-state
                      stream
                      recs
                      live
                      rstart
                      rend
                      (array-ref data.sweep-lo-arr cursor)
                      (array-ref data.sweep-hi-arr cursor)
                      (array-ref data.sweep-disp-arr cursor)
                      (array-ref data.sweep-em-lo-arr cursor)
                      (array-ref data.sweep-em-hi-arr cursor)
                      (= (array-ref data.sweep-win64-arr cursor) 1))
                    (set! cursor (+ cursor 1))
                    (set! i rend)))
                (set! i (+ i 1)))))
          cursor)))))

(define (compiler-backend-deadstore-sweep-report-and-reset!
  [stream : CompilerBackendStreamState]) : unit
  (begin
    (cfg
      regalloc-census
      (io.print-error
        (str_cat.str-cat
          "deadstore-sweep|funcs="
          (string.int->string compiler-backend-sweep-swept-funcs)
          "|stores="
          (string.int->string compiler-backend-sweep-swept-stores)
          "|dropped="
          (string.int->string compiler-backend-sweep-dropped-funcs)
          "|table-cap-drops="
          (string.int->string compiler-backend-sweep-dropped-table-cap)
          "|bytes-cap-drops="
          (string.int->string compiler-backend-sweep-dropped-bytes-cap)
          "|carry-cap="
          (string.int->string
            (compiler-backend-stream-state-carry-capacity stream))
          "|carry-bytes-cap="
          (string.int->string
            (compiler-backend-stream-state-carry-bytes-capacity stream))
          "|owner-cap="
          (string.int->string
            (compiler-backend-stream-state-owner-capacity stream))
          "|owner-bytes-cap="
          (string.int->string
            (compiler-backend-stream-state-owner-bytes-capacity stream))
          "|sweep-cap="
          (string.int->string
            (compiler-backend-stream-state-sweep-capacity stream))
          "|sweep-bytes-cap="
          (string.int->string
            (compiler-backend-stream-state-sweep-bytes-capacity stream))
          "|coverage-cap="
          (string.int->string
            (compiler-backend-stream-state-coverage-capacity stream))
          "|retained-table-bytes="
          (string.int->string
            (compiler-backend-stream-state-retained-table-bytes stream))
          "\n"
          "")))
    (compiler-backend-sweep-reset! stream)))

;; ============================================================================
;; GAP9: gep displacement folding (codegen phase 9 / P7a).
;;
;; The optimizer's affine rebase (phase 6) leaves unrolled loop bodies
;; addressing arrays with PARALLEL offset vars -- `i1 = i + 1; i2 = i + 2;
;; i3 = i + 3` -- each materialized as a leaq/addq and consumed as a Gep
;; index. clang folds the constant into the addressing displacement instead:
;; `addq 8(%rax,%r13,8), %r14`, no offset materialization at all.
;;
;; This pre-pass runs on the function's blocks BEFORE the register plan is
;; computed, so liveness and allocation see the folded program (the shared
;; base counter stays live through the folded uses; the offset vars vanish
;; and stop costing registers):
;;   * candidate: `dst = Add (Var j) (I64 k)` (either operand order) at
;;     64-bit int type, dst defined exactly once in the function, k != 0
;;     and |k| small;
;;   * every use of dst (function-wide use counts) must be the INDEX operand
;;     of a Gep in the SAME BLOCK after the add, whose own dst is single-def
;;     and whose byte displacement k*type-size stays small. Any other use --
;;     another block, a bounds check, a phi input, a store value, a gep
;;     BASE -- keeps the add;
;;   * no def of j between the add and the last folded gep (linear in-block
;;     execution then guarantees the gep reads the same j the add read);
;;   * a candidate whose base j is ITSELF an elided candidate is dropped
;;     (its add is deleted, so the value would never exist).
;; The rewrite deletes the add, retargets the gep's index operand to j, and
;; records the byte displacement in the per-function ordinal-indexed side
;; table described below (walk order, one entry per Gep -- NOT keyed by gep
;; dst: the later register rewrites renumber vars). Emission threads the
;; displacement into the two bottom-most address builders, so every addressing
;; form -- SIB, staged non-SIB, spilled-operand fallbacks -- applies it exactly
;; once.
(defenum CompilerBackendMaybeVarImm
  (No)
  (Some i64 i64))

;; Ordinal-indexed (walk-order) per-gep tables: the register pipeline's later
;; IR rewrites (caller-save spills, loop-split region remaps, remat) RENAME
;; vars inside loop regions but never create, delete, or reorder Gep
;; instructions, so the n-th Gep the emitter walks is the n-th Gep the
;; pre-pass saw. Each entry carries the byte displacement plus the gep's
;; offset kind (1 = Var, 0 = other) and element size as a drift check: a
;; consumption mismatch marks the function poisoned and emission fails loudly
;; rather than addressing with a stale displacement.
;;
;; The obligation the ordinal keying puts on EMISSION is the whole invariant:
;; every Gep in the walk consumes exactly one ordinal, whether the block walker
;; dispatches it or a peephole ABSORBS it (a fusion that resumes the walk past
;; a gep it folded into its own operand still owns that gep's ordinal). A path
;; that absorbs without consuming does not fail where it sits -- it shifts
;; every later gep in the function onto the previous entry, which is silent
;; whenever the shapes happen to agree. That was a real backend defect, not a
;; theoretical one: the `StorePtr;Gep;StorePtr` store-ptr pair peephole
;; absorbed its gep without consuming, so any function with a folded gep after
;; a store pair addressed with a stale displacement. It is the defect behind
;; #6307 ("call-carrying multiblock clones miscompile"), whose re-triage as
;; false against regalloc #6288 was INCOMPLETE -- the regalloc report was a
;; separate bug; this ordinal-accounting one was real and is fixed here, and
;; the audit below now checks the ordinal COUNT as well as the shapes so an
;; absorbing path can never again go silent.
(define (compiler-backend-gep-fold-disable!
  [function-state : CompilerBackendFunctionState]) : unit
  (begin
    (compiler-backend-function-state-set-bool!
      function-state
      compiler-backend-function-bool-gep-fold-ready
      false)
    (compiler-backend-function-state-set-i64-array!
      function-state
      compiler-backend-function-i64-array-gep-fold-disp-table
      (array.make-array i64 0))
    (compiler-backend-function-state-set-i64-array!
      function-state
      compiler-backend-function-i64-array-gep-fold-kind-table
      (array.make-array i64 0))
    (compiler-backend-function-state-set-i64-array!
      function-state
      compiler-backend-function-i64-array-gep-fold-scale-table
      (array.make-array i64 0))
    (compiler-backend-function-state-set-i64!
      function-state
      compiler-backend-function-i64-gep-fold-cursor
      0)
    (compiler-backend-function-state-set-bool!
      function-state
      compiler-backend-function-bool-gep-fold-drift
      false)))

(define (compiler-backend-gep-fold-offset-kind
  [offset : compiler_ir_types.CompilerIrValue]) : i64
  (match offset
    [(compiler_ir_types.CompilerIrValue.Var _) 1]
    [_ 0]))

;; Consume the next gep ordinal and return its folded displacement (0 for
;; unfolded geps). Called EXACTLY ONCE per Gep instruction the block walker
;; dispatches; kind/scale must match what the pre-pass recorded or the
;; function is poisoned (checked after body emission).
(define (compiler-backend-gep-fold-next!
  [function-state : CompilerBackendFunctionState]
  [type-segment-bases : i64]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]) : i64
  (if (not
    (compiler-backend-function-state-bool?
      function-state
      compiler-backend-function-bool-gep-fold-ready))
    0
    (let
      [cursor : i64
        (compiler-backend-function-state-i64
          function-state
          compiler-backend-function-i64-gep-fold-cursor)]
      [disp-table : (__tl_dyn-array i64)
        (compiler-backend-function-state-i64-array
          function-state
          compiler-backend-function-i64-array-gep-fold-disp-table)]
      [kind-table : (__tl_dyn-array i64)
        (compiler-backend-function-state-i64-array
          function-state
          compiler-backend-function-i64-array-gep-fold-kind-table)]
      [scale-table : (__tl_dyn-array i64)
        (compiler-backend-function-state-i64-array
          function-state
          compiler-backend-function-i64-array-gep-fold-scale-table)]
      (if (>= cursor (array-length disp-table))
        (begin
          (compiler-backend-function-state-set-bool!
            function-state
            compiler-backend-function-bool-gep-fold-drift
            true)
          0)
        (begin
          (compiler-backend-function-state-set-i64!
            function-state
            compiler-backend-function-i64-gep-fold-cursor
            (+ cursor 1))
          (if (and
            (=
              (array-ref kind-table cursor)
              (compiler-backend-gep-fold-offset-kind offset))
            (=
              (array-ref scale-table cursor)
              (compiler-backend-type-size type-segment-bases elem-ty)))
            (array-ref disp-table cursor)
            (begin
              (compiler-backend-function-state-set-bool!
                function-state
                compiler-backend-function-bool-gep-fold-drift
                true)
              0)))))))

;; PURE lookahead at an ordinal the walker has not consumed yet: returns exactly
;; what `compiler-backend-gep-fold-next!` WILL return for the gep sitting
;; `ahead` positions past the cursor (0 = the very next Gep the walker
;; dispatches), without advancing the cursor and without ever setting drift.
;;
;; ORDINAL SAFETY. Peeking is not consuming: the caller must still consume every
;; gep it absorbs, exactly once, in walk order. The peek exists for the one
;; admission question a displacement-blind probe cannot answer -- whether two
;; syntactically identical geps address the SAME byte. GAP9 folds `i+k` into the
;; displacement and retargets the gep index to `i`, so two geps can carry equal
;; base/offset/element operands and still address different words; the RMW fold
;; below is only sound when their displacements agree, and it must decide that
;; BEFORE it commits, because a decline after consumption would double-consume
;; on the fallback path (the store-pair ordinal bug class).
;;
;; `ahead` is counted in Gep instructions, which the caller establishes by
;; matching the intervening instructions structurally: it may only peek past
;; geps it has already seen in the sequence.
(define (compiler-backend-gep-fold-peek
  [function-state : CompilerBackendFunctionState]
  [type-segment-bases : i64]
  [ahead : i64]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]) : i64
  (if (not
    (compiler-backend-function-state-bool?
      function-state
      compiler-backend-function-bool-gep-fold-ready))
    0
    (let
      [cursor : i64
        (+
          (compiler-backend-function-state-i64
            function-state
            compiler-backend-function-i64-gep-fold-cursor)
          ahead)]
      [disp-table : (__tl_dyn-array i64)
        (compiler-backend-function-state-i64-array
          function-state
          compiler-backend-function-i64-array-gep-fold-disp-table)]
      [kind-table : (__tl_dyn-array i64)
        (compiler-backend-function-state-i64-array
          function-state
          compiler-backend-function-i64-array-gep-fold-kind-table)]
      [scale-table : (__tl_dyn-array i64)
        (compiler-backend-function-state-i64-array
          function-state
          compiler-backend-function-i64-array-gep-fold-scale-table)]
      (if (or (< cursor 0) (>= cursor (array-length disp-table)))
        0
        (if (and
          (=
            (array-ref kind-table cursor)
            (compiler-backend-gep-fold-offset-kind offset))
          (=
            (array-ref scale-table cursor)
            (compiler-backend-type-size type-segment-bases elem-ty)))
          (array-ref disp-table cursor)
          0)))))

(define (compiler-backend-gep-fold-drift?
  [function-state : CompilerBackendFunctionState]) : bool
  (and
    (compiler-backend-function-state-bool?
      function-state
      compiler-backend-function-bool-gep-fold-ready)
    (compiler-backend-function-state-bool?
      function-state
      compiler-backend-function-bool-gep-fold-drift)))

;; Whole-function completeness half of the audit: after a body has been
;; emitted, every recorded ordinal must have been consumed. A shape mismatch
;; (above) only catches a misalignment that happens to land on a differently
;; shaped gep; an emission path that ABSORBS a gep without consuming its
;; ordinal -- the store-ptr pair peephole did exactly that -- shifts every
;; later gep in the function onto the wrong entry and can be shape-silent, so
;; the count is checked as well and drives the same hard error.
(define (compiler-backend-gep-fold-unconsumed?
  [function-state : CompilerBackendFunctionState]) : bool
  (and
    (compiler-backend-function-state-bool?
      function-state
      compiler-backend-function-bool-gep-fold-ready)
    (not
      (=
        (compiler-backend-function-state-i64
          function-state
          compiler-backend-function-i64-gep-fold-cursor)
        (array-length
          (compiler-backend-function-state-i64-array
            function-state
            compiler-backend-function-i64-array-gep-fold-disp-table))))))

;; The emit-function gate: either half of the GAP9 accounting audit fails the
;; compile loudly rather than addressing with a stale displacement.
(define (compiler-backend-gep-fold-audit-failed?
  [function-state : CompilerBackendFunctionState]) : bool
  (or
    (compiler-backend-gep-fold-drift? function-state)
    (compiler-backend-gep-fold-unconsumed? function-state)))

;; Conservative magnitude cap for the folded element offset and its byte
;; displacement: far below imm32 so downstream constant-offset merges can
;; never overflow.
(define (compiler-backend-gep-fold-k-bound) : i64
  16777216)

(define (compiler-backend-gep-fold-64bit-int? [ty : compiler_ast_types.AstType]) : bool
  (match ty
    [(compiler_ast_types.AstType.I64) true]
    [(compiler_ast_types.AstType.U64) true]
    [_ false]))

;; The (var j, imm k) split of a candidate add's operands, or No.
(define (compiler-backend-gep-fold-add-operands
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]) : CompilerBackendMaybeVarImm
  (match lhs
    [(compiler_ir_types.CompilerIrValue.Var v)
      (match rhs
        [(compiler_ir_types.CompilerIrValue.I64 k)
          (CompilerBackendMaybeVarImm.Some v k)]
        [_ (CompilerBackendMaybeVarImm.No)])]
    [(compiler_ir_types.CompilerIrValue.I64 k)
      (match rhs
        [(compiler_ir_types.CompilerIrValue.Var v)
          (CompilerBackendMaybeVarImm.Some v k)]
        [_ (CompilerBackendMaybeVarImm.No)])]
    [_ (CompilerBackendMaybeVarImm.No)]))

(define (compiler-backend-gep-fold-block-instrs
  [block : compiler_ir_types.CompilerIrBlock]) : compiler_ir_types.CompilerIrInstrSeq
  (match block
    [(compiler_ir_types.CompilerIrBlock.Block _ instrs) instrs]))

;; Blocks as an array so per-candidate segment scans can address their block
;; by ordinal.
(define (compiler-backend-gep-fold-block-array
  [blocks : compiler_ir_types.CompilerIrBlockList]) : (__tl_dyn-array
    compiler_ir_types.CompilerIrBlock)
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (let
        [count : i64 (compiler_ir_types.compiler-ir-block-seq-count seq)]
        [out : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)
          (array.make-array compiler_ir_types.CompilerIrBlock count)]
        [j : i64 0]
        (begin
          (while (< j count)
            (begin
              (set!
                (array-ref out j)
                (compiler_ir_types.compiler-ir-block-seq-ref seq j))
              (set! j (+ j 1))))
          out))]
    [_
      (let
        [flat : compiler_ir_types.CompilerIrBlockList blocks]
        [count : i64 (compiler_ir_types.compiler-ir-block-list-count-cons flat)]
        [out : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)
          (array.make-array compiler_ir_types.CompilerIrBlock count)]
        [cursor : compiler_ir_types.CompilerIrBlockList flat]
        [j : i64 0]
        (begin
          (while (< j count)
            (match cursor
              [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
                (begin
                  (set! (array-ref out j) block)
                  (set! cursor (__tl-box-place rest))
                  (set! j (+ j 1)))]
              [_ (set! j count)]))
          out))]))

(define (compiler-backend-gep-fold-count-geps
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]) : i64
  (let
    [total : i64 0]
    [b : i64 0]
    (begin
      (while (< b (array-length barr))
        (begin
          (let
            [instrs : compiler_ir_types.CompilerIrInstrSeq
              (compiler-backend-gep-fold-block-instrs (array-ref barr b))]
            [n : i64 instrs.len]
            [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
              instrs.slots]
            [j : i64 0]
            (while (< j n)
              (begin
                (match (array-ref slots j)
                  [(compiler_ir_types.CompilerIrInstr.Gep _ _ _ _)
                    (set! total (+ total 1))]
                  [_ unit])
                (set! j (+ j 1)))))
          (set! b (+ b 1))))
      total)))

(define (compiler-backend-gep-fold-count-defs
  [defs : (__tl_dyn-array i64)]
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]) : unit
  (let
    [b : i64 0]
    (while (< b (array-length barr))
      (begin
        (let
          [instrs : compiler_ir_types.CompilerIrInstrSeq
            (compiler-backend-gep-fold-block-instrs (array-ref barr b))]
          [n : i64 instrs.len]
          [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
            instrs.slots]
          [j : i64 0]
          (while (< j n)
            (begin
              (let
                [dst : i64
                  (compiler_regalloc.compiler-reg-instr-def-var
                    (array-ref slots j))]
                (if (and (>= dst 0) (< dst (array-length defs)))
                  (set! (array-ref defs dst) (+ (array-ref defs dst) 1))
                  unit))
              (set! j (+ j 1)))))
        (set! b (+ b 1))))))

;; Pass 1: record candidate adds (base, k, block ordinal, position).
(define (compiler-backend-gep-fold-scan-adds
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]
  [defs : (__tl_dyn-array i64)]
  [cand-base : (__tl_dyn-array i64)]
  [cand-k : (__tl_dyn-array i64)]
  [cand-block : (__tl_dyn-array i64)]
  [cand-pos : (__tl_dyn-array i64)]) : unit
  (let
    [b : i64 0]
    (while (< b (array-length barr))
      (begin
        (let
          [instrs : compiler_ir_types.CompilerIrInstrSeq
            (compiler-backend-gep-fold-block-instrs (array-ref barr b))]
          [n : i64 instrs.len]
          [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
            instrs.slots]
          [j : i64 0]
          (while (< j n)
            (begin
              (match (array-ref slots j)
                [(compiler_ir_types.CompilerIrInstr.BinOp dst op lhs rhs ty)
                  (match op
                    [(compiler_ir_types.CompilerIrBinOp.Add)
                      (if (and
                        (compiler-backend-gep-fold-64bit-int? ty)
                        (>= dst 0)
                        (< dst (array-length cand-base))
                        (= (array-ref defs dst) 1))
                        (match (compiler-backend-gep-fold-add-operands lhs rhs)
                          [(CompilerBackendMaybeVarImm.Some base k)
                            (if (and
                              (not (= k 0))
                              (not (= base dst))
                              (< k (compiler-backend-gep-fold-k-bound))
                              (> k (- 0 (compiler-backend-gep-fold-k-bound))))
                              (begin
                                (set! (array-ref cand-base dst) base)
                                (set! (array-ref cand-k dst) k)
                                (set! (array-ref cand-block dst) b)
                                (set! (array-ref cand-pos dst) j))
                              unit)]
                          [(CompilerBackendMaybeVarImm.No) unit])
                        unit)]
                    [_ unit])]
                [_ unit])
              (set! j (+ j 1)))))
        (set! b (+ b 1))))))

;; Pass 2: count qualifying gep-index uses per candidate and track the last
;; folded gep position; a disqualifying gep-index use kills the candidate.
(define (compiler-backend-gep-fold-scan-geps
  [type-segment-bases : i64]
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]
  [defs : (__tl_dyn-array i64)]
  [cand-base : (__tl_dyn-array i64)]
  [cand-k : (__tl_dyn-array i64)]
  [cand-block : (__tl_dyn-array i64)]
  [cand-pos : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [gep-last : (__tl_dyn-array i64)]) : unit
  (let
    [b : i64 0]
    (while (< b (array-length barr))
      (begin
        (let
          [instrs : compiler_ir_types.CompilerIrInstrSeq
            (compiler-backend-gep-fold-block-instrs (array-ref barr b))]
          [n : i64 instrs.len]
          [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
            instrs.slots]
          [j : i64 0]
          (while (< j n)
            (begin
              (match (array-ref slots j)
                [(compiler_ir_types.CompilerIrInstr.Gep gdst _ offset elem-ty)
                  (match offset
                    [(compiler_ir_types.CompilerIrValue.Var ov)
                      (if (and
                        (>= ov 0)
                        (< ov (array-length cand-base))
                        (>= (array-ref cand-base ov) 0))
                        (let
                          [scale : i64
                            (compiler-backend-type-size
                              type-segment-bases
                              elem-ty)]
                          [bdisp : i64 (* (array-ref cand-k ov) scale)]
                          (if (and
                            (= (array-ref cand-block ov) b)
                            (> j (array-ref cand-pos ov))
                            (>= gdst 0)
                            (< gdst (array-length defs))
                            (= (array-ref defs gdst) 1)
                            (> scale 0)
                            (< bdisp (compiler-backend-gep-fold-k-bound))
                            (> bdisp (- 0 (compiler-backend-gep-fold-k-bound))))
                            (begin
                              (set!
                                (array-ref gep-uses ov)
                                (+ (array-ref gep-uses ov) 1))
                              (if (> j (array-ref gep-last ov))
                                (set! (array-ref gep-last ov) j)
                                unit))
                            ;; disqualifying gep-index use: kill the candidate.
                            (set! (array-ref cand-base ov) (- 0 1)))
                          unit)
                        unit)]
                    [_ unit])]
                [_ unit])
              (set! j (+ j 1)))))
        (set! b (+ b 1))))))

;; True when any instruction in (from, to] defines `var`.
(define (compiler-backend-gep-fold-segment-defines?
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [from : i64]
  [to : i64]
  [var : i64]) : bool
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [j : i64 (+ from 1)]
    [found : bool false]
    (begin
      (while (<= j to)
        (if (=
          (compiler_regalloc.compiler-reg-instr-def-var (array-ref slots j))
          var)
          (begin
            (set! found true)
            (set! j (+ to 1)))
          (set! j (+ j 1))))
      found)))

;; Pass 3: totality (every use is a folded gep index), no def of the base
;; inside the (add, last-gep] segment, and the base is not itself an elided
;; candidate (two rounds cover the parallel-offset shape; deeper chains
;; conservatively keep their adds).
(define (compiler-backend-gep-fold-validate
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]
  [uses : (__tl_dyn-array i64)]
  [cand-base : (__tl_dyn-array i64)]
  [cand-block : (__tl_dyn-array i64)]
  [cand-pos : (__tl_dyn-array i64)]
  [gep-uses : (__tl_dyn-array i64)]
  [gep-last : (__tl_dyn-array i64)]) : unit
  (begin
    (let
      [v : i64 0]
      (while (< v (array-length cand-base))
        (begin
          (if (>= (array-ref cand-base v) 0)
            (if (or
              (= (array-ref gep-uses v) 0)
              (not (= (array-ref uses v) (array-ref gep-uses v)))
              (compiler-backend-gep-fold-segment-defines?
                (compiler-backend-gep-fold-block-instrs
                  (array-ref barr (array-ref cand-block v)))
                (array-ref cand-pos v)
                (array-ref gep-last v)
                (array-ref cand-base v)))
              (set! (array-ref cand-base v) (- 0 1))
              unit)
            unit)
          (set! v (+ v 1)))))
    (let
      [round : i64 0]
      (while (< round 2)
        (begin
          (let
            [v : i64 0]
            (while (< v (array-length cand-base))
              (begin
                (if (>= (array-ref cand-base v) 0)
                  (let
                    [bv : i64 (array-ref cand-base v)]
                    (if (and
                      (< bv (array-length cand-base))
                      (>= (array-ref cand-base bv) 0))
                      (set! (array-ref cand-base v) (- 0 1))
                      unit))
                  unit)
                (set! v (+ v 1)))))
          (set! round (+ round 1)))))))

(define (compiler-backend-gep-fold-any-valid?
  [cand-base : (__tl_dyn-array i64)]) : bool
  (let
    [v : i64 0]
    [found : bool false]
    (begin
      (while (< v (array-length cand-base))
        (if (>= (array-ref cand-base v) 0)
          (begin
            (set! found true)
            (set! v (array-length cand-base)))
          (set! v (+ v 1))))
      found)))

;; Pass 4: rebuild each block with elided adds deleted and folded geps
;; retargeted to the base var; fill the dst -> byte-displacement table.
(define (compiler-backend-gep-fold-record-ordinal!
  [cursor-cell : (__tl_dyn-array i64)]
  [disp : i64]
  [kind : i64]
  [scale : i64]
  [disp-table : (__tl_dyn-array i64)]
  [kind-table : (__tl_dyn-array i64)]
  [scale-table : (__tl_dyn-array i64)]) : unit
  (let
    [cursor : i64 (array-ref cursor-cell 0)]
    (if (< cursor (array-length disp-table))
      (begin
        (set! (array-ref disp-table cursor) disp)
        (set! (array-ref kind-table cursor) kind)
        (set! (array-ref scale-table cursor) scale)
        (set! (array-ref cursor-cell 0) (+ cursor 1)))
      unit)))

(define (compiler-backend-gep-fold-rewrite-seq
  [type-segment-bases : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [block-ord : i64]
  [cand-base : (__tl_dyn-array i64)]
  [cand-k : (__tl_dyn-array i64)]
  [cand-block : (__tl_dyn-array i64)]
  [cursor-cell : (__tl_dyn-array i64)]
  [disp-table : (__tl_dyn-array i64)]
  [kind-table : (__tl_dyn-array i64)]
  [scale-table : (__tl_dyn-array i64)]) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [n : i64 instrs.len]
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [out : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
      (array.make-array compiler_ir_types.CompilerIrInstr n)]
    [w : i64 0]
    [j : i64 0]
    (begin
      (while (< j n)
        (begin
          (match (array-ref slots j)
            [(compiler_ir_types.CompilerIrInstr.BinOp dst _ _ _ _)
              (if (and
                (>= dst 0)
                (< dst (array-length cand-base))
                (>= (array-ref cand-base dst) 0))
                ;; elided offset add: drop it.
                unit
                (begin
                  (set! (array-ref out w) (array-ref slots j))
                  (set! w (+ w 1))))]
            [(compiler_ir_types.CompilerIrInstr.Gep gdst base offset elem-ty)
              (let
                [scale : i64
                  (compiler-backend-type-size type-segment-bases elem-ty)]
                (match offset
                  [(compiler_ir_types.CompilerIrValue.Var ov)
                    (if (and
                      (>= ov 0)
                      (< ov (array-length cand-base))
                      (>= (array-ref cand-base ov) 0)
                      (= (array-ref cand-block ov) block-ord))
                      (begin
                        ;; folded: post-rewrite offset stays a Var (the base
                        ;; counter), so the recorded kind is 1.
                        (compiler-backend-gep-fold-record-ordinal!
                          cursor-cell
                          (* (array-ref cand-k ov) scale)
                          1
                          scale
                          disp-table
                          kind-table
                          scale-table)
                        (set!
                          (array-ref out w)
                          (compiler_ir_types.CompilerIrInstr.Gep
                            gdst
                            base
                            (compiler_ir_types.CompilerIrValue.Var
                              (array-ref cand-base ov))
                            elem-ty))
                        (set! w (+ w 1)))
                      (begin
                        (compiler-backend-gep-fold-record-ordinal!
                          cursor-cell
                          0
                          1
                          scale
                          disp-table
                          kind-table
                          scale-table)
                        (set! (array-ref out w) (array-ref slots j))
                        (set! w (+ w 1))))]
                  [_
                    (begin
                      (compiler-backend-gep-fold-record-ordinal!
                        cursor-cell
                        0
                        (compiler-backend-gep-fold-offset-kind offset)
                        scale
                        disp-table
                        kind-table
                        scale-table)
                      (set! (array-ref out w) (array-ref slots j))
                      (set! w (+ w 1)))]))]
            [_
              (begin
                (set! (array-ref out w) (array-ref slots j))
                (set! w (+ w 1)))])
          (set! j (+ j 1))))
      (compiler_ir_types.CompilerIrInstrSeq out w))))

(define (compiler-backend-gep-fold-rewrite-blocks
  [type-segment-bases : i64]
  [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)]
  [cand-base : (__tl_dyn-array i64)]
  [cand-k : (__tl_dyn-array i64)]
  [cand-block : (__tl_dyn-array i64)]
  [disp-table : (__tl_dyn-array i64)]
  [kind-table : (__tl_dyn-array i64)]
  [scale-table : (__tl_dyn-array i64)]) : compiler_ir_types.CompilerIrBlockList
  (let
    [cursor-cell : (__tl_dyn-array i64) (array.make-array i64 1)]
    [rebuilt : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)
      (array.make-array compiler_ir_types.CompilerIrBlock (array-length barr))]
    [b : i64 0]
    [out : compiler_ir_types.CompilerIrBlockList
      compiler_ir_types.CompilerIrBlockList.Nil]
    [r : i64 (- (array-length barr) 1)]
    (begin
      ;; forward pass keeps the ordinal cursor in walk order ...
      (while (< b (array-length barr))
        (begin
          (match (array-ref barr b)
            [(compiler_ir_types.CompilerIrBlock.Block label instrs)
              (set!
                (array-ref rebuilt b)
                (compiler_ir_types.CompilerIrBlock.Block
                  label
                  (compiler-backend-gep-fold-rewrite-seq
                    type-segment-bases
                    instrs
                    b
                    cand-base
                    cand-k
                    cand-block
                    cursor-cell
                    disp-table
                    kind-table
                    scale-table)))])
          (set! b (+ b 1))))
      ;; ... and the list is assembled back-to-front.
      (while (>= r 0)
        (begin
          (set!
            out
            (compiler_ir_types.compiler-ir-block-cons (array-ref rebuilt r) out))
          (set! r (- r 1))))
      out)))

;; Cheap prescan: a variable-index gep at all? Most functions have none; the
;; full pass only runs when one exists.
(define (compiler-backend-gep-fold-blocks-have-candidate?
  [blocks : compiler_ir_types.CompilerIrBlockList]) : bool
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) false]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (let
        [instrs : compiler_ir_types.CompilerIrInstrSeq
          (compiler-backend-gep-fold-block-instrs block)]
        [n : i64 instrs.len]
        [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
          instrs.slots]
        [j : i64 0]
        [found : bool false]
        (begin
          (while (< j n)
            (begin
              (match (array-ref slots j)
                [(compiler_ir_types.CompilerIrInstr.Gep _ _ offset _)
                  (match offset
                    [(compiler_ir_types.CompilerIrValue.Var _)
                      (set! found true)]
                    [_ unit])]
                [_ unit])
              (set! j (+ j 1))))
          (if found
            true
            (compiler-backend-gep-fold-blocks-have-candidate?
              (__tl-box-place rest)))))]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-gep-fold-block-seq-has-candidate? seq)]))

(define (compiler-backend-gep-fold-block-seq-has-candidate?
  [blocks : compiler_ir_types.CompilerIrBlockSeq]) : bool
  (let
    [count : i64 (compiler_ir_types.compiler-ir-block-seq-count blocks)]
    [b : i64 0]
    [found : bool false]
    (begin
      (while (and (< b count) (not found))
        (begin
          (let
            [instrs : compiler_ir_types.CompilerIrInstrSeq
              (compiler-backend-gep-fold-block-instrs
                (compiler_ir_types.compiler-ir-block-seq-ref blocks b))]
            [n : i64 instrs.len]
            [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
              instrs.slots]
            [j : i64 0]
            (while (and (< j n) (not found))
              (begin
                (match (array-ref slots j)
                  [(compiler_ir_types.CompilerIrInstr.Gep _ _ offset _)
                    (match offset
                      [(compiler_ir_types.CompilerIrValue.Var _)
                        (set! found true)]
                      [_ unit])]
                  [_ unit])
                (set! j (+ j 1)))))
          (set! b (+ b 1))))
      found)))

;; Entry: returns the (possibly rewritten) blocks and installs the
;; per-function displacement table; when nothing folds the input list is
;; returned unchanged and the table stays disabled.
(define (compiler-backend-gep-fold-blocks
  [function-state : CompilerBackendFunctionState]
  [type-segment-bases : i64]
  [vars : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrBlockList
  (begin
    (compiler-backend-gep-fold-disable! function-state)
    (if (or
      (<= vars 0)
      (not (compiler-backend-gep-fold-blocks-have-candidate? blocks)))
      blocks
      (let
        [barr : (__tl_dyn-array compiler_ir_types.CompilerIrBlock)
          (compiler-backend-gep-fold-block-array blocks)]
        [defs : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [uses : (__tl_dyn-array i64)
          (compiler-backend-function-use-counts vars blocks)]
        [cand-base : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [cand-k : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [cand-block : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [cand-pos : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [gep-uses : (__tl_dyn-array i64) (array.make-array i64 vars)]
        [gep-last : (__tl_dyn-array i64) (array.make-array i64 vars)]
        (begin
          (compiler-backend-gep-fold-count-defs defs barr)
          (let
            [v : i64 0]
            (while (< v vars)
              (begin
                (set! (array-ref cand-base v) (- 0 1))
                (set! v (+ v 1)))))
          (compiler-backend-gep-fold-scan-adds
            barr
            defs
            cand-base
            cand-k
            cand-block
            cand-pos)
          (compiler-backend-gep-fold-scan-geps
            type-segment-bases
            barr
            defs
            cand-base
            cand-k
            cand-block
            cand-pos
            gep-uses
            gep-last)
          (compiler-backend-gep-fold-validate
            barr
            uses
            cand-base
            cand-block
            cand-pos
            gep-uses
            gep-last)
          (if (compiler-backend-gep-fold-any-valid? cand-base)
            (let
              [gep-count : i64 (compiler-backend-gep-fold-count-geps barr)]
              [disp-table : (__tl_dyn-array i64)
                (array.make-array i64 gep-count)]
              [kind-table : (__tl_dyn-array i64)
                (array.make-array i64 gep-count)]
              [scale-table : (__tl_dyn-array i64)
                (array.make-array i64 gep-count)]
              [out : compiler_ir_types.CompilerIrBlockList
                (compiler-backend-gep-fold-rewrite-blocks
                  type-segment-bases
                  barr
                  cand-base
                  cand-k
                  cand-block
                  disp-table
                  kind-table
                  scale-table)]
              (begin
                (compiler-backend-function-state-set-i64-array!
                  function-state
                  compiler-backend-function-i64-array-gep-fold-disp-table
                  disp-table)
                (compiler-backend-function-state-set-i64-array!
                  function-state
                  compiler-backend-function-i64-array-gep-fold-kind-table
                  kind-table)
                (compiler-backend-function-state-set-i64-array!
                  function-state
                  compiler-backend-function-i64-array-gep-fold-scale-table
                  scale-table)
                (compiler-backend-function-state-set-i64!
                  function-state
                  compiler-backend-function-i64-gep-fold-cursor
                  0)
                (compiler-backend-function-state-set-bool!
                  function-state
                  compiler-backend-function-bool-gep-fold-drift
                  false)
                (compiler-backend-function-state-set-bool!
                  function-state
                  compiler-backend-function-bool-gep-fold-ready
                  true)
                out))
            blocks))))))

(define (compiler-backend-emit-function
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [func : compiler_ir_types.CompilerIrFunction]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [allow-rbp : bool]
  [shrinkwrap-enabled : bool]) : ResultCompilerBackend
  (match func
    [(compiler_ir_types.CompilerIrFunction.Function
        name
        params
        ret-ty
        vars
        raw-blocks)
      ;; The provenance fallback diagnostic for this function: backend
      ;; errors raised while emitting its body stamp this function's source span
      ;; (or `1:1` when none was recorded) rather than always `1:1`.
      (let
        ;; Every representation-aware register-allocation view below carries the
        ;; same pre-optimization job capability from `program-index`.
        [backend-state : CompilerBackendState program-index.backend-state]
        [function-state : CompilerBackendFunctionState
          (compiler-backend-state-function-state backend-state)]
        [_current-source-function : unit
          (compiler-backend-function-scratch-set-i64!
            function-state
            compiler-backend-scratch-i64-current-source-function
            name)]
        [scalar-registers-enabled : bool
          (compiler-backend-state-scalar-registers-enabled? backend-state)]
        ;; Prefix dry-emission is part of shrink-wrap admission and precedes
        ;; this function's const-hoist build. Fail closed unless its scratch
        ;; state was reset successfully for this function.
        [shrinkwrap-state-admissible? : bool
          (compiler-backend-prepare-shrinkwrap-admission! function-state)]
        ;; GAP9: fold constant gep index offsets into addressing displacements
        ;; BEFORE the register plan, so liveness sees the folded program (the
        ;; shared counter stays live; the offset adds vanish).
        [folded-blocks : compiler_ir_types.CompilerIrBlockList
          (compiler-backend-gep-fold-blocks
            function-state
            type-segment-bases
            vars
            raw-blocks)]
        ;; Cycle 26: split a property-proven frame-free entry region before
        ;; regalloc. Incoming parameters stay in ABI locations until the saving
        ;; edge, whose returned labels drive prologue placement and bare returns.
        [early-exit-func : compiler_ir_types.CompilerIrFunction
          (let
            [folded-func : compiler_ir_types.CompilerIrFunction
              (compiler_ir_types.CompilerIrFunction.Function
                name
                params
                ret-ty
                vars
                folded-blocks)]
            (if (and
              shrinkwrap-enabled
              (compiler-backend-mode-scalar? mode)
              scalar-registers-enabled)
              (compiler_regalloc.compiler-reg-early-exit-shrinkwrap-function
                folded-func)
              (begin
                (compiler_regalloc.compiler-reg-early-exit-state-reset!)
                folded-func)))]
        ;; Cycle 20: protect GP values only on one admitted cold call edge.  The
        ;; rewrite follows the early-exit split and still precedes regalloc, so
        ;; liveness sees both transformations.
        [cold-call-rewrite : compiler_regalloc.CompilerRegColdCallRewrite
          (if (and
            (compiler-backend-mode-scalar? mode)
            scalar-registers-enabled)
            (compiler_regalloc.compiler-reg-cold-call-rewrite-function-with-representations
              type-segment-bases
              early-exit-func
              program-index.representations)
            (compiler_regalloc.CompilerRegColdCallRewrite.Rewrite
              early-exit-func
              (- 0 1)))]
        [cold-call-func : compiler_ir_types.CompilerIrFunction
          (compiler_regalloc.compiler-reg-cold-call-rewrite-function-value
            cold-call-rewrite)]
        [blocks : compiler_ir_types.CompilerIrBlockList
          (match cold-call-func
            [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ out-blocks)
              out-blocks])]
        [walk-vars : i64
          (match cold-call-func
            [(compiler_ir_types.CompilerIrFunction.Function _ _ _ out-vars _)
              out-vars])]
        [cold-call-temp-start : i64
          (compiler_regalloc.compiler-reg-cold-call-rewrite-temp-start
            cold-call-rewrite)]
        [walk-func : compiler_ir_types.CompilerIrFunction
          (compiler_ir_types.CompilerIrFunction.Function
            name
            params
            ret-ty
            walk-vars
            blocks)]
        [func-diag : compiler_diagnostic.CompilerDiagnostic
          (compiler-backend-function-diagnostic-index
            span-index
            (compiler_ir_types.compiler-ir-symbol-typed-id name)
            "")]
        [_current-mode : unit
          (compiler-backend-set-current-mode!
            (compiler-backend-state-function-state program-index.backend-state)
            mode)]
        ;; M-G3 stage 2: enable %rbp as the final CSR for this function's plan
        ;; on both text backends. The `allow-rbp` parameter is false only on the
        ;; DEMOTION retry (the FPO audit failed on an rbp-planned function).
        [_rbp-pool-flag : unit
          (compiler_regalloc.compiler-reg-set-rbp-pool-enabled!
            (and
              allow-rbp
              (or
                (compiler-backend-target-linux? target)
                (compiler-backend-target-windows? target))
              (compiler-backend-mode-scalar? mode)
              scalar-registers-enabled))]
        [fn-abi : compiler_abi.CompilerRegTargetAbi
          (compiler-backend-regalloc-abi target)]
        [_fn-abi : unit
          (compiler-backend-set-current-fn-abi!
            program-index.backend-state
            fn-abi)]
        ;; The scalar-opt2 plan and the caller-save rewrite below both need the
        ;; var-type view of `walk-func`, and each used to walk the function for
        ;; its own copy. Compute it once here, on exactly the path that takes
        ;; both (`compiler-reg-plan-function-stack-only` and the SIMD plans do
        ;; not need it, and the rewrites are off when scalar registers are).
        [scalar-plan? : bool
          (and (compiler-backend-mode-scalar? mode) scalar-registers-enabled)]
        [walk-types : compiler_regalloc.CompilerRegVarTypes
          (if scalar-plan?
            (compiler_regalloc.compiler-reg-function-var-types-with-representations
              walk-func
              program-index.representations)
            (compiler_regalloc.compiler-reg-var-types-empty-with-representations
              program-index.representations))]
        [reg-plan : compiler_regalloc.CompilerRegPlan
          (if (compiler-backend-mode-scalar? mode)
            (if scalar-registers-enabled
              (compiler_regalloc.compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types
                type-segment-bases
                fn-abi
                walk-func
                cold-call-temp-start
                walk-types)
              (compiler_regalloc.compiler-reg-plan-function-stack-only-with-representations
                walk-func
                program-index.representations))
            (if (compiler-backend-mode-avx2? mode)
              (compiler_regalloc.compiler-reg-plan-function-avx2-with-type-segment-bases-for-abi-and-representations
                type-segment-bases
                fn-abi
                walk-func
                program-index.representations)
              (compiler_regalloc.compiler-reg-plan-function-with-type-segment-bases-for-abi-and-representations
                type-segment-bases
                fn-abi
                walk-func
                program-index.representations)))]
        ;; A call-free natural loop can leave one volatile register dead before
        ;; the loop and another dead inside it while the whole-range greedy pays
        ;; for a callee-saved home. Detect that shape against the initial plan,
        ;; split the read-only range in IR, then REPLAN the rewritten function.
        ;; Replanning is essential: both physical pieces receive ordinary exact
        ;; intervals, so scratch occupancy and frame coloring never see the
        ;; conservative interval-less homes used by post-allocation rescues.
        [leaf-csr-rewrite : compiler_regalloc.CompilerRegCallSaveRewrite
          (if scalar-plan?
            (compiler_regalloc.compiler-reg-leaf-csr-split-rewrite-one
              type-segment-bases
              fn-abi
              walk-func
              blocks
              walk-vars
              walk-types
              reg-plan)
            (compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
              blocks
              walk-vars
              walk-vars
              (compiler_regalloc.compiler-reg-assignment-table-empty)
              (compiler_regalloc.compiler-reg-var-types-empty)))]
        [alloc-blocks : compiler_ir_types.CompilerIrBlockList
          (match leaf-csr-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                out-blocks
                _
                _
                _
                _)
              out-blocks])]
        [alloc-vars : i64
          (match leaf-csr-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                _
                _
                out-vars
                _
                _)
              out-vars])]
        [alloc-func : compiler_ir_types.CompilerIrFunction
          (compiler_ir_types.CompilerIrFunction.Function
            name
            params
            ret-ty
            alloc-vars
            alloc-blocks)]
        [alloc-types : compiler_regalloc.CompilerRegVarTypes
          (if (= alloc-vars walk-vars)
            walk-types
            (compiler_regalloc.compiler-reg-function-var-types alloc-func))]
        [alloc-preassignments : compiler_regalloc.CompilerRegAssignmentTable
          (match leaf-csr-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                _
                _
                _
                assignments
                _)
              assignments])]
        [raw-alloc-reg-plan : compiler_regalloc.CompilerRegPlan
          (if (= alloc-vars walk-vars)
            reg-plan
            (compiler_regalloc.compiler-reg-plan-function-scalar-cold-with-type-segment-bases-for-abi-with-types-and-preassignments
              type-segment-bases
              fn-abi
              alloc-func
              cold-call-temp-start
              alloc-types
              alloc-preassignments))]
        [alloc-reg-plan : compiler_regalloc.CompilerRegPlan
          (if (= alloc-vars walk-vars)
            raw-alloc-reg-plan
            (compiler_regalloc.compiler-reg-plan-hide-leaf-csr-phantoms
              raw-alloc-reg-plan
              alloc-preassignments
              walk-vars))]
        [_cold-call-self-check : unit
          (cfg
            scavenge-self-check
            (if (compiler_regalloc.compiler-reg-cold-call-carriers-stack?
              alloc-reg-plan
              cold-call-temp-start
              alloc-vars)
              unit
              (io.panic "regalloc: cold-call carrier escaped its stack home"))
            unit)]
        [call-save-enabled : bool
          (if (compiler-backend-mode-scalar? mode)
            scalar-registers-enabled
            false)]
        ;; The caller-save / loop-split / remat IR-mutating rewrites run whenever
        ;; scalar register allocation is enabled.
        [non-split-passes-enabled : bool call-save-enabled]
        [call-save-rewrite : compiler_regalloc.CompilerRegCallSaveRewrite
          (if non-split-passes-enabled
            (compiler_regalloc.compiler-reg-caller-save-rewrite-blocks
              alloc-blocks
              alloc-vars
              alloc-types
              alloc-reg-plan)
            (compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
              alloc-blocks
              alloc-vars
              alloc-vars
              (compiler_regalloc.compiler-reg-assignment-table-empty)
              (compiler_regalloc.compiler-reg-var-types-empty)))]
        [call-save-reg-plan : compiler_regalloc.CompilerRegPlan
          (if call-save-enabled
            (compiler_regalloc.compiler-reg-plan-with-call-save-rewrite
              alloc-reg-plan
              call-save-rewrite)
            alloc-reg-plan)]
        [call-save-blocks : compiler_ir_types.CompilerIrBlockList
          (match call-save-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                out-blocks
                _
                _
                _
                _)
              out-blocks])]
        [call-save-vars : i64
          (match call-save-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                _
                _
                out-vars
                _
                _)
              out-vars])]
        [loop-split-func : compiler_ir_types.CompilerIrFunction
          (compiler_ir_types.CompilerIrFunction.Function
            name
            params
            ret-ty
            call-save-vars
            call-save-blocks)]
        [loop-split-rewrite : compiler_regalloc.CompilerRegCallSaveRewrite
          (if non-split-passes-enabled
            (compiler_regalloc.compiler-reg-loop-split-rewrite-blocks
              type-segment-bases
              loop-split-func
              call-save-blocks
              call-save-vars
              (compiler_regalloc.compiler-reg-function-var-types
                loop-split-func)
              call-save-reg-plan)
            (compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
              call-save-blocks
              call-save-vars
              call-save-vars
              (compiler_regalloc.compiler-reg-assignment-table-empty)
              (compiler_regalloc.compiler-reg-var-types-empty)))]
        [rewrite-reg-plan : compiler_regalloc.CompilerRegPlan
          (if call-save-enabled
            (compiler_regalloc.compiler-reg-plan-with-call-save-rewrite
              call-save-reg-plan
              loop-split-rewrite)
            alloc-reg-plan)]
        [rewritten-blocks : compiler_ir_types.CompilerIrBlockList
          (match loop-split-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                out-blocks
                _
                _
                _
                _)
              out-blocks])]
        [rewritten-vars : i64
          (match loop-split-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                _
                _
                out-vars
                _
                _)
              out-vars])]
        ;; Pipeline order: caller-save -> loop-split -> REMAT. The remat output is
        ;; the intermediate (`remat0-*`); the identity `splitkit-rewrite` stage
        ;; below re-exports it under the downstream-facing `remat-*` names (final
        ;; pipeline blocks/vars/plan), so nothing downstream changes.
        [remat0-func : compiler_ir_types.CompilerIrFunction
          (compiler_ir_types.CompilerIrFunction.Function
            name
            params
            ret-ty
            rewritten-vars
            rewritten-blocks)]
        [remat0-rewrite : compiler_regalloc.CompilerRegCallSaveRewrite
          (if call-save-enabled
            (compiler_regalloc.compiler-reg-remat-rewrite-blocks
              type-segment-bases
              remat0-func
              rewritten-blocks
              rewritten-vars
              (compiler_regalloc.compiler-reg-function-var-types remat0-func)
              rewrite-reg-plan)
            (compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
              rewritten-blocks
              rewritten-vars
              rewritten-vars
              (compiler_regalloc.compiler-reg-assignment-table-empty)
              (compiler_regalloc.compiler-reg-var-types-empty)))]
        [remat0-reg-plan : compiler_regalloc.CompilerRegPlan
          (if call-save-enabled
            (compiler_regalloc.compiler-reg-plan-with-call-save-rewrite
              rewrite-reg-plan
              remat0-rewrite)
            rewrite-reg-plan)]
        [remat0-blocks : compiler_ir_types.CompilerIrBlockList
          (match remat0-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                out-blocks
                _
                _
                _
                _)
              out-blocks])]
        [remat0-vars : i64
          (match remat0-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                _
                _
                out-vars
                _
                _)
              out-vars])]
        ;; SplitKit removed: it was inert on the shipped path (the realization
        ;; declined every recorded piece), replaced by M-G2b's per-call-region
        ;; split + FPO. The final pipeline stage is the identity of the remat
        ;; output.
        [splitkit-rewrite : compiler_regalloc.CompilerRegCallSaveRewrite
          (compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
            remat0-blocks
            remat0-vars
            remat0-vars
            (compiler_regalloc.compiler-reg-assignment-table-empty)
            (compiler_regalloc.compiler-reg-var-types-empty))]
        ;; Downstream-facing FINAL pipeline names (= identity of the remat output).
        [remat-reg-plan : compiler_regalloc.CompilerRegPlan
          (if call-save-enabled
            (compiler_regalloc.compiler-reg-plan-with-call-save-rewrite
              remat0-reg-plan
              splitkit-rewrite)
            remat0-reg-plan)]
        [remat-blocks : compiler_ir_types.CompilerIrBlockList
          (match splitkit-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                out-blocks
                _
                _
                _
                _)
              out-blocks])]
        [remat-vars : i64
          (match splitkit-rewrite
            [(compiler_regalloc.CompilerRegCallSaveRewrite.Rewrite
                _
                _
                out-vars
                _
                _)
              out-vars])]
        [_regalloc-census : unit
          (cfg
            regalloc-census
            (if call-save-enabled
              (compiler_regalloc.compiler-reg-call-span-census-record-plan!
                alloc-func
                alloc-reg-plan)
              unit)
            unit)]
        ;; Scratch pseudos are no longer published as ordinary assignments.
        ;; Keep storage coloring on the ordinary plan, then build the scratch
        ;; plan below from the FINAL remapped IR and assignment table. Planning
        ;; here used to attach point/ordinal requirements to pre-color var ids;
        ;; after coloring reused those ids for different storage shapes, an
        ;; apparent register result could become a spilled emitted result with
        ;; no modeled slot (#5808).
        [scratch-vars : i64
          (compiler_regalloc.compiler-reg-plan-var-count
            remat-reg-plan
            remat-vars)]
        [plan-types : compiler_regalloc.CompilerRegVarTypes
          (compiler_regalloc.compiler-reg-plan-types remat-reg-plan)]
        ;; Computed once per function: the gate below, the coloring pass, and
        ;; the frame layout all consume it (the per-block fixpoint scan is too
        ;; costly to repeat).
        [fn-group-vars : compiler_liveness.CompilerLiveI64Set
          (compiler_regalloc.compiler-reg-function-group-vars
            type-segment-bases
            (compiler_ir_types.CompilerIrFunction.Function
              name
              params
              ret-ty
              scratch-vars
              remat-blocks)
            plan-types)]
        [has-group-vars : bool
          (> (compiler_liveness.compiler-live-set-count fn-group-vars) 0)]
        ;; Address temps the gep fusion peepholes fold into their consumer.
        ;; Computed on the exact blocks and assignments the coloring pass reads,
        ;; so the ids line up; see compiler-backend-gep-fusion-pinned-vars.
        [fusion-pinned-vars : compiler_liveness.CompilerLiveI64Set
          (compiler-backend-gep-fusion-pinned-vars
            scratch-vars
            remat-blocks
            (compiler_regalloc.compiler-reg-plan-assignments remat-reg-plan))]
        ;; Compact the frame after regalloc by renumbering stack-resident
        ;; values into a dense slot prefix. Plans without intervals (the
        ;; stack-only opt0/opt1 path) pass through unchanged. Only real remat
        ;; vars can demand slots; scratch pseudo-vars are register-only.
        ;; `slot-vars` replaces the raw var count everywhere the frame layout
        ;; is derived, while `scratch-vars` keeps indexing per-variable side
        ;; tables.
        [coloring
          : compiler_regalloc.CompilerRegColoring
          ;; Stack-homed register groups keep word0 in their remapped formula
          ;; slot; word1 indexes the second var-region by the same remapped id.
          ;; That keeps both words inside the `slot-vars`-sized frame instead of
          ;; preserving the old high raw ids that drove frame growth.
          (compiler_regalloc.compiler-reg-color-stack-slots
            type-segment-bases
            remat-reg-plan
            fn-group-vars
            params
            remat-blocks
            scratch-vars
            remat-vars
            fusion-pinned-vars)]
        [assignments : compiler_regalloc.CompilerRegAssignmentTable
          (match coloring
            [(compiler_regalloc.CompilerRegColoring.None)
              (compiler_regalloc.compiler-reg-plan-assignments remat-reg-plan)]
            [(compiler_regalloc.CompilerRegColoring.Remap remap _)
              (compiler_regalloc.compiler-reg-color-rebuild-assignments
                remap
                scratch-vars
                (compiler_regalloc.compiler-reg-plan-assignments remat-reg-plan))])]
        [_regalloc-assignment-census : unit
          (cfg
            regalloc-census
            (compiler_regalloc.compiler-reg-assignment-census-record!
              (& assignments))
            unit)]
        ;; Install the final authoritative table for direct operand-home lookup
        ;; in large functions. Caller-save / loop-split / remat / scratch-vreg /
        ;; slot-coloring re-plans are all folded into this table, so no emission
        ;; view can go stale. Small functions read the same table directly from
        ;; their emission context and avoid the state-wrapper setup.
        [_emit-assignment-index : unit
          (begin
            (if (>= scratch-vars 64)
              (begin
                (compiler-backend-function-state-set-assignment-index!
                  function-state
                  (compiler_regalloc.compiler-reg-assignment-table-with-min-capacity
                    assignments
                    scratch-vars))
                (compiler-backend-function-state-set-bool!
                  function-state
                  compiler-backend-function-bool-emit-assignment-index-active
                  true))
              (compiler-backend-function-state-set-bool!
                function-state
                compiler-backend-function-bool-emit-assignment-index-active
                false))
            ;; Same table, same "fixed before body emission" guarantee: fold the
            ;; plan's register homes into the per-function mask that
            ;; compiler-backend-plan-uses-reg? answers from. Unlike the dense
            ;; index this is installed for EVERY function -- it is one machine
            ;; word, so there is no size threshold to trade against.
            (compiler-backend-set-emit-plan-reg-mask! backend-state assignments)
            (compiler-backend-function-state-set-i64!
              function-state
              compiler-backend-function-i64-rax-override-var
              -1)
            (compiler-backend-function-state-set-i64!
              function-state
              compiler-backend-function-i64-rax-forward-pending-var
              -1)
            (compiler-backend-emit-home-overrides-disable! function-state))]
        [scavenge-assignments
          : compiler_regalloc.CompilerRegAssignmentTable
          ;; Start ordinary scavenging from real IR homes. Planned scratch
          ;; homes are appended below with exact intervals; retaining them as
          ;; interval-less pseudo-vars here would reserve each register for the
          ;; entire function and force unrelated sites into emergency saves.
          (match coloring
            [(compiler_regalloc.CompilerRegColoring.None)
              (compiler_regalloc.compiler-reg-plan-assignments remat-reg-plan)]
            [(compiler_regalloc.CompilerRegColoring.Remap remap _)
              (compiler_regalloc.compiler-reg-color-rebuild-assignments
                remap
                scratch-vars
                (compiler_regalloc.compiler-reg-plan-assignments remat-reg-plan))])]
        [emit-blocks-list : compiler_ir_types.CompilerIrBlockList
          (match coloring
            [(compiler_regalloc.CompilerRegColoring.None) remat-blocks]
            [(compiler_regalloc.CompilerRegColoring.Remap remap _)
              (compiler_regalloc.compiler-reg-remap-blocks remap remat-blocks)])]
        [emit-params : compiler_ir_types.CompilerIrParamList
          (match coloring
            [(compiler_regalloc.CompilerRegColoring.None) params]
            [(compiler_regalloc.CompilerRegColoring.Remap remap _)
              (compiler_regalloc.compiler-reg-remap-params remap params)])]
        [slot-vars : i64
          (match coloring
            ;; Synthetic scratch ids are register-only and are not referenced
            ;; by the emitted IR. When stack coloring is unavailable, retain
            ;; the real rewritten var count so scratch planning cannot grow
            ;; the frame merely by numbering temporary register intervals.
            [(compiler_regalloc.CompilerRegColoring.None) remat-vars]
            [(compiler_regalloc.CompilerRegColoring.Remap _ slots) slots])]
        [scavenge-intervals
          : compiler_regalloc.CompilerRegIntervalSeq
          ;; Scavenge occupancy must be keyed to the FINAL emitted IR at
          ;; instruction precision. The allocator plan intervals predate
          ;; call-save/remat rewrites and frame slot compaction, and the cheap
          ;; block interval builder can miss within-block live-through scratch
          ;; hazards. The full live-after intervals are the source of truth for
          ;; register-owned values that must not be scavenged.
          (if (compiler-backend-assignments-have-register-home?
            scavenge-assignments)
            (let
              [scavenge-func : compiler_ir_types.CompilerIrFunction
                (compiler_ir_types.CompilerIrFunction.Function
                  name
                  emit-params
                  ret-ty
                  scratch-vars
                  emit-blocks-list)]
              (compiler_regalloc.compiler-reg-live-intervals
                scavenge-func
                (compiler_liveness.compiler-live-analyze-function scavenge-func)))
            (compiler_regalloc.compiler-reg-interval-seq-empty))]
        [types : compiler_regalloc.CompilerRegVarTypes
          (match coloring
            [(compiler_regalloc.CompilerRegColoring.None) plan-types]
            [(compiler_regalloc.CompilerRegColoring.Remap remap _)
              (compiler_regalloc.compiler-reg-color-rebuild-types
                remap
                scratch-vars
                plan-types)])]
        [scratch-base-plan : compiler_regalloc.CompilerRegPlan
          (match remat-reg-plan
            [(compiler_regalloc.CompilerRegPlan.Plan
                _
                ineligible
                _
                _
                call-split
                split-plan)
              (compiler_regalloc.CompilerRegPlan.Plan
                assignments
                ineligible
                scavenge-intervals
                types
                call-split
                split-plan)])]
        [emit-group-vars-base : compiler_liveness.CompilerLiveI64Set
          (match coloring
            [(compiler_regalloc.CompilerRegColoring.None) fn-group-vars]
            [(compiler_regalloc.CompilerRegColoring.Remap remap _)
              (compiler-backend-remap-group-vars fn-group-vars remap)])]
        [emit-group-vars : compiler_liveness.CompilerLiveI64Set
          (compiler_regalloc.compiler-reg-group-vars-fixpoint
            (compiler-backend-late-group-vars-blocks
              type-segment-bases
              program-index
              emit-group-vars-base
              emit-blocks-list)
            emit-blocks-list)]
        [scratch-plan-result : compiler_regalloc.CompilerRegScratchPlanResult
          (cfg
            scratch-vreg
            (compiler_regalloc.compiler-reg-plan-with-scratch-vreg-result-with-groups
              type-segment-bases
              fn-abi
              (compiler_ir_types.CompilerIrFunction.Function
                name
                emit-params
                ret-ty
                scratch-vars
                emit-blocks-list)
              emit-group-vars
              scratch-base-plan
              scratch-vars)
            (compiler_regalloc.CompilerRegScratchPlanResult.Result
              scratch-base-plan
              (compiler_regalloc.compiler-reg-scratch-plan-empty)))]
        [scratch-plan : compiler_regalloc.CompilerRegScratchPlan
          (match scratch-plan-result
            [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ out-plan)
              out-plan])]
        [_emit-scratch-plan-mask : unit
          (compiler-backend-function-scratch-set-i64!
            function-state
            compiler-backend-scratch-i64-planned-scratch-reg-mask
            (compiler_regalloc.compiler-reg-scratch-plan-register-mask
              scratch-plan))]
        [addressable-group-vars : compiler_liveness.CompilerLiveI64Set
          (if (> (compiler_liveness.compiler-live-set-count emit-group-vars) 0)
            (compiler-backend-addressable-group-vars-blocks
              emit-group-vars
              emit-blocks-list
              (compiler_liveness.compiler-live-set-empty))
            (compiler_liveness.compiler-live-set-empty))]
        [_group-var-flags : unit
          (begin
            (compiler-backend-current-slot-vars-set!
              program-index.backend-state
              slot-vars)
            (compiler-backend-group-vars-enable!
              program-index.backend-state
              emit-group-vars
              addressable-group-vars))]
        [symbol : String
          (compiler-backend-function-symbol-index program-index name)]
        [label-scope : String
          (compiler-backend-function-label-scope program-index name)]
        [use-counts : (__tl_dyn-array i64) (array.make-array i64 scratch-vars)]
        [fuse-free-counts : (__tl_dyn-array i64)
          (array.make-array i64 scratch-vars)]
        [_use-facts : unit
          (compiler-backend-count-block-use-facts
            use-counts
            fuse-free-counts
            emit-blocks-list)]
        [identity-tail-forwarder? : bool
          (compiler-backend-identity-tail-forwarder?
            type-segment-bases
            target
            name
            emit-params
            emit-blocks-list
            program-index)]
        ;; #jump-forward: the shrink-wrap guard prefix rendered just below is a
        ;; textual needle that has to match the emitted body byte for byte. The
        ;; body's forwarding table cannot exist yet -- it reads the const-hoist
        ;; injections built further down -- so clear the lane here: label ids are
        ;; interned program-wide, and a previous function's table would otherwise
        ;; forward this one's labels. The build below refuses the guard region,
        ;; so needle and body still agree once the real table is installed.
        [_jump-forward-clear : unit
          (compiler-backend-function-state-set-i64-array!
            function-state
            compiler-backend-function-i64-array-jump-forward
            (array.make-array i64 0))]
        [shrinkwrap-saving-label : i64
          (compiler_regalloc.compiler-reg-early-exit-saving-label-current)]
        [shrinkwrap-bare-label : String
          (compiler_regalloc.compiler-reg-early-exit-bare-label-current)]
        [shrinkwrap-prefix-count : i64
          (compiler_regalloc.compiler-reg-early-exit-prefix-count-current)]
        [shrinkwrap-planned-guard : String
          (if (or
            (not shrinkwrap-state-admissible?)
            (string.eq shrinkwrap-bare-label ""))
            ""
            (compiler-backend-shrinkwrap-prefix-asm
              type-segment-bases
              target
              emit-params
              scratch-vars
              assignments
              label-scope
              name
              emit-blocks-list
              shrinkwrap-bare-label
              shrinkwrap-prefix-count
              ret-ty
              program-index
              false))]
        [shrinkwrap-incoming-prefix : String
          (if (or
            (not shrinkwrap-state-admissible?)
            (string.eq shrinkwrap-bare-label ""))
            ""
            (compiler-backend-shrinkwrap-prefix-asm
              type-segment-bases
              target
              emit-params
              scratch-vars
              assignments
              label-scope
              name
              emit-blocks-list
              shrinkwrap-bare-label
              shrinkwrap-prefix-count
              ret-ty
              program-index
              true))]
        [shrinkwrap-incoming-guard : String
          (if (string.eq shrinkwrap-incoming-prefix "")
            ""
            (str_cat.str-cat
              shrinkwrap-incoming-prefix
              "    # shrinkwrap incoming guard\n"
              ""))]
        [shrinkwrap-candidate? : bool
          (and
            (not
              (and
                (compiler_ir_types.compiler-debug-info-enabled?)
                (compiler-backend-target-linux? target)))
            shrinkwrap-state-admissible?
            (not
              (=
                shrinkwrap-saving-label
                (compiler_ir_types.compiler-ir-label-none)))
            (not (string.eq shrinkwrap-bare-label ""))
            (not (string.eq shrinkwrap-planned-guard ""))
            (not (string.eq shrinkwrap-incoming-guard ""))
            (not
              (string.eq
                (compiler-backend-symbol-text-index program-index name)
                "main")))]
        ;; Const-hoist register admission must see every cfg-gated scratch-vreg
        ;; home over its exact point range. The published scratch reg-plan keeps
        ;; only unique callee-saved homes for prologue accounting, so append the
        ;; complete scratch plan as fresh synthetic vars for this occupancy
        ;; query. Otherwise a caller-saved scratch such as %r9 can be selected
        ;; for a loop magic and then overwrite that magic at a divmod site.
        [const-hoist-occupancy-vars : i64
          (compiler-backend-scratch-plan-extend-vars scratch-plan scratch-vars)]
        [const-hoist-occupancy-assignments : compiler_regalloc.CompilerRegAssignmentTable
          (compiler-backend-scratch-plan-extend-assignments
            scratch-plan
            scratch-vars
            assignments)]
        [const-hoist-occupancy-intervals : compiler_regalloc.CompilerRegIntervalSeq
          (compiler-backend-scratch-plan-extend-intervals
            scratch-plan
            scratch-vars
            scavenge-intervals)]
        ;; M-F: loop-hoisted divmod magic constants. Built over the FINAL
        ;; emitted IR + the same fresh intervals the scavenge occupancy uses,
        ;; so a hoist register is provably free over its whole loop region and
        ;; the synthetic entries below keep every scavenge away from it.
        ;; Scalar-opt2 text path. The candidate list filters Win64 callee-saved
        ;; %rsi/%rdi while retaining ABI-safe %r8/%r9 and %rbx (frame-homed for
        ;; divmod). Empty plan = byte-identical.
        [const-hoist-synth : CompilerBackendConstHoistSynth
          (if (and
            call-save-enabled
            (not identity-tail-forwarder?)
            ;; Guard blocks contain comparisons only. Divmod hoists are placed
            ;; at their loop/body region, which is necessarily beyond the
            ;; saving frontier, so admitted functions retain the same general
            ;; loop-constant optimization as the unwrapped pipeline.
            true)
            (compiler-backend-const-hoist-build!
              type-segment-bases
              target
              emit-blocks-list
              const-hoist-occupancy-assignments
              const-hoist-occupancy-intervals
              const-hoist-occupancy-vars
              (compiler-backend-frame-slots-emergency-max
                slot-vars
                has-group-vars
                program-index.backend-state)
              function-state
              program-index.backend-state)
            (compiler-backend-const-hoist-disable! function-state))]
        ;; A stack frame alone is sufficient reason to wrap; limiting this to
        ;; plans with callee-saved homes left frame-only functions rewritten but
        ;; still prologued before their guard. Candidate proof plus the verified
        ;; textual splices is the complete activation condition.
        [shrinkwrap-active? : bool shrinkwrap-candidate?]
        [scavenge-base-vars : i64
          (compiler-backend-const-hoist-extend-vars
            const-hoist-synth
            scratch-vars)]
        [scavenge-base-assignments : compiler_regalloc.CompilerRegAssignmentTable
          (compiler-backend-const-hoist-extend-assignments
            const-hoist-synth
            scratch-vars
            scavenge-assignments)]
        [scavenge-base-intervals : compiler_regalloc.CompilerRegIntervalSeq
          (compiler-backend-const-hoist-extend-intervals
            const-hoist-synth
            scratch-vars
            scavenge-intervals)]
        [_scavenge-install-ctx
          : unit
          ;; Use scratch-vars (the FULL var count the assignments are sized for), NOT
          ;; slot-vars (the compacted stack-slot count): register-homed vars keep
          ;; indices >= slot-vars, so a slot-vars-sized ctx would miss them and the
          ;; free-register query would false-free their registers (e.g. a pooled %r8
          ;; holding a register var). M-F and the cfg-gated scratch-vreg path append
          ;; synthetic register-homed pseudo-vars so scavenging avoids those planned
          ;; registers inside their regions.
          (begin
            (compiler-backend-scavenge-install-ctx-from-intervals!
              function-state
              (compiler-backend-scratch-plan-extend-vars
                scratch-plan
                scavenge-base-vars)
              (compiler-backend-scratch-plan-extend-assignments
                scratch-plan
                scavenge-base-vars
                scavenge-base-assignments)
              (compiler-backend-scratch-plan-extend-intervals
                scratch-plan
                scavenge-base-vars
                scavenge-base-intervals)
              program-index.backend-state)
            (compiler-backend-function-scratch-set-i64-array!
              function-state
              compiler-backend-scratch-i64-array-scavenge-scratch-masks
              (compiler-backend-scratch-plan-occupancy-build
                scratch-plan
                (array-length
                  (compiler-backend-function-scratch-i64-array
                    function-state
                    compiler-backend-scratch-i64-array-scavenge-occupied-masks)))))]
        [_scavenge-self-check : unit
          (cfg
            scavenge-self-check
            (compiler-backend-scavenge-self-check
              name
              symbol
              emit-params
              ret-ty
              scratch-vars
              emit-blocks-list
              assignments)
            unit)]
        (if (compiler-backend-inline-memory-call-name? symbol)
          (ResultCompilerBackend.Ok
            (compiler-backend-emit-inline-memory-helper-function target symbol))
          (let
            [_phi-targets : unit
              (compiler-backend-function-state-install-phi-targets!
                (compiler-backend-state-function-state
                  program-index.backend-state)
                (compiler-backend-phi-target-labels-for-blocks emit-blocks-list))]
            ;; #jump-forward: installed unconditionally (empty when the function
            ;; has no jump-only block) so no previous function's table can leak
            ;; into this one. Reads only the register plan and the const-hoist
            ;; table, both fixed above, so the result is as deterministic as the
            ;; assignment it derives from.
            [_jump-forward : unit
              (compiler-backend-function-state-set-i64-array!
                (compiler-backend-state-function-state
                  program-index.backend-state)
                compiler-backend-function-i64-array-jump-forward
                (compiler-backend-jump-forward-build
                  program-index.backend-state
                  assignments
                  emit-blocks-list))]
            ;; Must precede the parameter spills: those store incoming registers
            ;; into frame slots, and their references have to count.
            [_frame-slot-flag : unit
              (compiler-backend-frame-slot-referenced-reset! function-state)]
            (match (if identity-tail-forwarder?
              (ResultCompilerBackend.Ok "")
              (if (compiler-backend-spmd-private-function?
                program-index.backend-state
                name)
                (compiler-backend-emit-spmd-private-param-spills
                  type-segment-bases
                  target
                  assignments
                  emit-params
                  slot-vars
                  program-index.backend-state)
                (compiler-backend-emit-param-spills
                  type-segment-bases
                  target
                  assignments
                  emit-params
                  0
                  0
                  0
                  0
                  program-index
                  slot-vars
                  program-index.backend-state)))
              [(ResultCompilerBackend.Ok spills)
                (let
                  [_addr-forward : unit
                    (compiler-backend-addr-of-forwarding-enable!
                      program-index.backend-state
                      scratch-vars
                      emit-blocks-list
                      use-counts)]
                  [_fuse-need : unit
                    (compiler-backend-fuse-need-enable!
                      program-index.backend-state
                      use-counts
                      fuse-free-counts)]
                  [_identity-tail-forwarder : unit
                    (compiler-backend-function-state-set-bool!
                      (compiler-backend-state-function-state
                        program-index.backend-state)
                      compiler-backend-function-bool-identity-tail-forwarder-active
                      identity-tail-forwarder?)]
                  [_shrinkwrap-return : unit
                    (compiler-backend-function-state-set-string!
                      (compiler-backend-state-function-state
                        program-index.backend-state)
                      compiler-backend-function-string-shrinkwrap-bare-label
                      (if shrinkwrap-active?
                        shrinkwrap-bare-label
                        ""))]
                  [outgoing-frame-space : i64
                    (compiler-backend-outgoing-frame-space
                      type-segment-bases
                      target
                      emit-blocks-list
                      plan-types
                      program-index)]
                  [dynamic-frame-base : i64
                    (+
                      (compiler-backend-frame-size
                        (+
                          (compiler-backend-frame-slots-emergency-max
                            slot-vars
                            has-group-vars
                            program-index.backend-state)
                          (compiler-backend-function-scratch-i64
                            function-state
                            compiler-backend-scratch-i64-const-hoist-frame-count)))
                      outgoing-frame-space)]
                  [_emergency-init : unit
                    (begin
                      (compiler-backend-function-scratch-set-i64!
                        function-state
                        compiler-backend-scratch-i64-cycle-temp-used-count
                        0)
                      (compiler-backend-function-scratch-set-i64!
                        function-state
                        compiler-backend-scratch-i64-cycle-temp-base-offset
                        (- 0 (+ dynamic-frame-base 8)))
                      (compiler-backend-function-scratch-set-bool!
                        function-state
                        compiler-backend-scratch-bool-emergency-used
                        false)
                      (compiler-backend-function-scratch-set-bool!
                        function-state
                        compiler-backend-scratch-bool-emergency-pending
                        false)
                      (compiler-backend-function-scratch-set-bool!
                        function-state
                        compiler-backend-scratch-bool-emergency-restore-suppressed
                        false)
                      (compiler-backend-function-scratch-set-i64!
                        function-state
                        compiler-backend-scratch-i64-emergency-used-count
                        0)
                      (compiler-backend-function-scratch-set-i64!
                        function-state
                        compiler-backend-scratch-i64-emergency-pending-count
                        0)
                      (compiler-backend-function-scratch-set-i64-array!
                        function-state
                        compiler-backend-scratch-i64-array-emergency-regs
                        (array.make-array i64 0))
                      (compiler-backend-function-scratch-set-i64!
                        function-state
                        compiler-backend-scratch-i64-emergency-slot-offset
                        (-
                          0
                          (+
                            dynamic-frame-base
                            (+
                              (compiler-backend-cycle-temp-frame-extra
                                (compiler-backend-cycle-temp-max-slots))
                              (compiler-backend-emergency-slot-size))))))]
                  (match (compiler-backend-emit-blocks
                    type-segment-bases
                    target
                    label-scope
                    name
                    emit-blocks-list
                    emit-blocks-list
                    assignments
                    slot-vars
                    types
                    global-types
                    ret-ty
                    (cfg
                      scratch-vreg
                      (CompilerBackendRuntimePlan.WithScratch
                        (box plan)
                        scratch-plan)
                      plan)
                    functions
                    externs
                    program-index
                    spans
                    span-index
                    func-diag
                    use-counts)
                    [(ResultCompilerBackend.Ok body)
                      ;; GAP9 drift check: every Gep must have consumed its
                      ;; ordinal, and consumed it with a matching shape. Either
                      ;; half failing means a displacement could have been
                      ;; misapplied, so fail the compile loudly instead of
                      ;; emitting wrong addressing.
                      (if (compiler-backend-gep-fold-audit-failed?
                        function-state)
                        (ResultCompilerBackend.Err
                          (box
                            (compiler-backend-apply-instr-diagnostic
                              (compiler_diagnostic.compiler-diagnostic-at-start
                                ""
                                (str_cat.str-cat
                                  "backend: gep displacement ordinal drift in "
                                  (compiler-backend-symbol-text-index
                                    program-index
                                    name)))
                              func-diag)))
                        (let
                          [dynamic-frame-extra : i64
                            (+
                              (compiler-backend-cycle-temp-frame-extra-needed
                                (compiler-backend-function-scratch-i64
                                  function-state
                                  compiler-backend-scratch-i64-cycle-temp-used-count)
                                (compiler-backend-function-scratch-bool?
                                  function-state
                                  compiler-backend-scratch-bool-emergency-used))
                              (compiler-backend-emergency-frame-extra
                                (compiler-backend-function-scratch-i64
                                  function-state
                                  compiler-backend-scratch-i64-emergency-used-count)))]
                          [frame : i64
                            (+
                              (+
                                (compiler-backend-frame-size
                                  (+
                                    (if (or
                                      (compiler-backend-function-scratch-bool?
                                        function-state
                                        compiler-backend-scratch-bool-emergency-used)
                                      (>
                                        (compiler-backend-function-scratch-i64
                                          function-state
                                          compiler-backend-scratch-i64-cycle-temp-used-count)
                                        0)
                                      (>
                                        (compiler-backend-function-scratch-i64
                                          function-state
                                          compiler-backend-scratch-i64-const-hoist-frame-count)
                                        0))
                                      ;; A dynamic bottom-of-frame slot was used:
                                      ;; reserve the max callee-save area so those
                                      ;; slots never overlap on-demand CSR saves.
                                      (compiler-backend-frame-slots-emergency-max
                                        slot-vars
                                        has-group-vars
                                        program-index.backend-state)
                                      ;; Nothing named a frame slot: the slot
                                      ;; region is dead. Leaf helpers stop paying
                                      ;; sub/add for a frame they never touch.
                                      ;; Outgoing stack args are %rsp-relative
                                      ;; and stay accounted separately below.
                                      (if (or
                                        (compiler-backend-function-state-bool?
                                          function-state
                                          compiler-backend-function-bool-frame-slot-referenced)
                                        (> outgoing-frame-space 0)
                                        (compiler-backend-blocks-have-call?
                                          emit-blocks-list))
                                        (compiler-backend-frame-slots-with-groups
                                          slot-vars
                                          assignments
                                          has-group-vars
                                          program-index.backend-state)
                                        0))
                                    (compiler-backend-function-scratch-i64
                                      function-state
                                      compiler-backend-scratch-i64-const-hoist-frame-count)))
                                outgoing-frame-space)
                              dynamic-frame-extra)]
                          [_addr-forward-done : unit
                            (begin
                              (compiler-backend-function-state-set-bool!
                                (compiler-backend-state-function-state
                                  program-index.backend-state)
                                compiler-backend-function-bool-identity-tail-forwarder-active
                                false)
                              (compiler-backend-addr-of-forwarding-disable!
                                program-index.backend-state)
                              (compiler-backend-group-vars-disable!
                                program-index.backend-state)
                              (compiler-backend-fuse-need-disable!
                                program-index.backend-state)
                              (compiler-backend-gep-fold-disable!
                                function-state))]
                          [saving-prologue-body : String
                            (str_cat.str-cat
                              (compiler-backend-emit-save-callee-regs
                                assignments
                                slot-vars
                                program-index.backend-state)
                              (compiler-backend-emit-windows-main-argv-capture
                                target
                                (compiler-backend-symbol-text-index
                                  program-index
                                  name)
                                emit-entry
                                plan)
                              (compiler-backend-emit-linux-crt-main-argv-capture
                                target
                                (compiler-backend-symbol-text-index
                                  program-index
                                  name)
                                crt-entry
                                plan)
                              (if (and
                                (string.eq
                                  (compiler-backend-symbol-text-index
                                    program-index
                                    name)
                                  "main")
                                (or
                                  (compiler-backend-target-windows? target)
                                  (and
                                    crt-entry
                                    (compiler-backend-target-linux? target))))
                                (compiler-backend-global-initializers
                                  type-segment-bases
                                  globals
                                  program-index)
                                "")
                              spills
                              "")]
                          [saving-asm-label : String
                            (compiler-backend-asm-label
                              label-scope
                              shrinkwrap-saving-label)]
                          [guarded-body : String
                            (if shrinkwrap-active?
                              (string.replace
                                body
                                shrinkwrap-planned-guard
                                shrinkwrap-incoming-guard)
                              body)]
                          [framed-body : String
                            (if shrinkwrap-active?
                              (let
                                [label-line : String
                                  (str_cat.str-cat saving-asm-label ":\n" "")]
                                (string.replace
                                  guarded-body
                                  label-line
                                  (str_cat.str-cat
                                    label-line
                                    saving-prologue-body
                                    "")))
                              (str_cat.str-cat
                                saving-prologue-body
                                guarded-body
                                ""))]
                          [post-prologue : String
                            (str_cat.str-cat
                              (compiler-backend-mode-prologue mode)
                              framed-body
                              (compiler-backend-return-epilogue
                                program-index.backend-state
                                name
                                assignments
                                slot-vars
                                emit-blocks-list)
                              "")]
                          ;; M-G3 stage 2: attempt frame-pointer omission on both
                          ;; text backends. Win64's FPO prologue emits explicit
                          ;; push/stack/XMM SEH unwind codes and the audit rejects
                          ;; any body whose rsp shape cannot stay unwind-stable.
                          [fpo-target : bool
                            (or
                              (compiler-backend-target-linux? target)
                              (compiler-backend-target-windows? target))]
                          ;; GAP1: push-style CSR saves ride the FPO audit --
                          ;; the plan-saved CSR set is fixed pre-body (the
                          ;; scavenger only hands out plan-saved callee regs;
                          ;; emergency picks are wrapped locally), so the push
                          ;; prologue below and the pass's save-deletion /
                          ;; epilogue rewrites see the same registers. On audit
                          ;; failure the ORIGINAL text (mov saves intact) feeds
                          ;; the stage-1 keep-rbp fallback unchanged.
                          [push-regs : (__tl_dyn-array String)
                            (compiler-backend-rsp-rebase-make-push-regs)]
                          [push-count : i64
                            (if fpo-target
                              (compiler-backend-fill-push-csr-regs!
                                assignments
                                push-regs
                                program-index.backend-state)
                              0)]
                          ;; Win64 UWOP_SAVE_XMM128 encodes its stack offset in
                          ;; 16-byte units. An even GP-push count leaves the
                          ;; canonical frame slots at rsp+8 (mod 16), so retain
                          ;; the rbp frame for that uncommon mixed shape. GP-only
                          ;; functions and odd-push XMM functions remain FPO.
                          [fpo-attempt : bool
                            (and
                              (not
                                (and
                                  (compiler_ir_types.compiler-debug-info-enabled?)
                                  (compiler-backend-target-linux? target)))
                              fpo-target
                              (or
                                (not
                                  (and
                                    (compiler-backend-target-windows? target)
                                    (compiler-backend-plan-uses-win64-xmm-callee-regs?
                                      assignments
                                      program-index.backend-state)))
                                (= (bit-and push-count 1) 1)))]
                          [_fpo-bare : unit
                            (compiler-backend-function-state-set-bool!
                              function-state
                              compiler-backend-function-bool-fpo-bare-frame
                              (and
                                fpo-attempt
                                (= push-count 0)
                                (= frame 0)
                                (not
                                  (compiler-backend-function-state-bool?
                                    function-state
                                    compiler-backend-function-bool-frame-slot-referenced))
                                (not
                                  (compiler-backend-blocks-have-call?
                                    emit-blocks-list))))]
                          ;; GAP1 corollary: in PUSH mode the callee-save slot
                          ;; region is never written -- the rebase deletes the
                          ;; mov save/restore pairs and rewrites the pop-run
                          ;; leaq, so the pushes carry those registers instead.
                          ;; A function whose ONLY frame references were those
                          ;; slots therefore names nothing in the frame at all,
                          ;; and its slot region is as dead as a frameless
                          ;; leaf's. The alignment the region used to supply is
                          ;; not lost: `S = frame + (n odd ? 0 : 8)` still holds
                          ;; the total displacement at `D % 16 == 8` for any
                          ;; frame, so every call in the body stays aligned.
                          ;; Every other frame consumer must be absent for the
                          ;; region to be droppable outright: outgoing stack
                          ;; args and the dynamic emergency/cycle-temp/const-
                          ;; hoist reservations are %rsp- or bottom-of-frame
                          ;; relative and are sized into `frame` separately, and
                          ;; Win64 XMM callee slots are real frame words the
                          ;; push prologue does not absorb.
                          ;; This value is used ONLY on the FPO path: the
                          ;; keep-rbp fallback below re-renders from
                          ;; `post-prologue` with the full `frame`, where the
                          ;; mov saves are still present and still need slots.
                          [fpo-frame : i64
                            (if (and
                              fpo-attempt
                              (> push-count 0)
                              (not
                                (compiler-backend-function-state-bool?
                                  function-state
                                  compiler-backend-function-bool-nonsave-frame-slot-referenced))
                              (= outgoing-frame-space 0)
                              (= dynamic-frame-extra 0)
                              (=
                                (compiler-backend-function-scratch-i64
                                  function-state
                                  compiler-backend-scratch-i64-const-hoist-frame-count)
                                0)
                              (not
                                (compiler-backend-function-scratch-bool?
                                  function-state
                                  compiler-backend-scratch-bool-emergency-used))
                              (=
                                (compiler-backend-function-scratch-i64
                                  function-state
                                  compiler-backend-scratch-i64-cycle-temp-used-count)
                                0)
                              (<
                                (compiler-backend-win64-xmm-callee-highest
                                  assignments
                                  program-index.backend-state)
                                0))
                              0
                              frame)]
                          [rebased : String
                            (compiler-backend-rsp-rebase-full
                              post-prologue
                              fpo-frame
                              fpo-attempt
                              push-regs
                              push-count
                              slot-vars
                              program-index.backend-state)]
                          [rebase-ok : bool compiler-backend-rsp-rebase-last-ok]
                          [fpo-ok : bool (and fpo-attempt rebase-ok)]
                          (if (and
                            (not fpo-ok)
                            (compiler-backend-plan-uses-reg?
                              backend-state
                              assignments
                              compiler_abi.compiler-reg-id-rbp))
                            ;; DEMOTE: the FPO audit failed but the plan homes a
                            ;; value in %rbp (which has no frame base to fall
                            ;; back to) -- re-plan and re-emit without %rbp in
                            ;; the pool. The retry cannot demote again
                            ;; (allow-rbp=false => no %rbp homes).
                            (begin
                              (set!
                                compiler-backend-fpo-demote-count
                                (+ compiler-backend-fpo-demote-count 1))
                              ;; DEMOTE retry: re-plan/re-emit without %rbp in the
                              ;; pool (allow-rbp=false => no %rbp homes, so it
                              ;; cannot demote again).
                              (compiler-backend-emit-function
                                type-segment-bases
                                target
                                mode
                                func
                                functions
                                globals
                                global-types
                                externs
                                plan
                                program-index
                                spans
                                span-index
                                emit-entry
                                crt-entry
                                false
                                shrinkwrap-enabled))
                            (let
                              [final-body : String
                                (if fpo-ok
                                  rebased
                                  (if fpo-attempt
                                    ;; FPO audit failed with no %rbp in the
                                    ;; plan: retain the stage-1 rbp frame.
                                    (compiler-backend-rsp-rebase
                                      post-prologue
                                      frame
                                      false
                                      program-index.backend-state)
                                    rebased))]
                              [entry-symbol : String
                                (if shrinkwrap-active?
                                  saving-asm-label
                                  symbol)]
                              [selected-prologue : String
                                (if fpo-ok
                                  (if (compiler-backend-target-windows? target)
                                    (compiler-backend-emit-function-entry-fpo-windows
                                      backend-state
                                      entry-symbol
                                      fpo-frame
                                      assignments
                                      slot-vars
                                      push-regs
                                      push-count)
                                    (if (> push-count 0)
                                      (compiler-backend-emit-function-entry-fpo-push
                                        backend-state
                                        entry-symbol
                                        fpo-frame
                                        push-regs
                                        push-count)
                                      (compiler-backend-emit-function-entry-fpo
                                        backend-state
                                        entry-symbol
                                        fpo-frame)))
                                  (compiler-backend-emit-function-entry
                                    target
                                    entry-symbol
                                    frame
                                    assignments
                                    slot-vars
                                    program-index.backend-state))]
                              [emitted-body : String
                                (if shrinkwrap-active?
                                  (string.replace
                                    final-body
                                    (str_cat.str-cat saving-asm-label ":\n" "")
                                    selected-prologue)
                                  final-body)]
                              (if (or
                                ;; The IR was split before allocation. If later
                                ;; admission cannot render both scratch-free
                                ;; prefixes (or intentionally excludes `main`),
                                ;; do not leave the duplicated CFG under an
                                ;; always-framed prologue: retry from the original
                                ;; function with the rewrite disabled.
                                (and
                                  (not shrinkwrap-active?)
                                  (not
                                    (=
                                      shrinkwrap-saving-label
                                      (compiler_ir_types.compiler-ir-label-none))))
                                (compiler-backend-shrinkwrap-splice-fallback-required?
                                  shrinkwrap-active?
                                  body
                                  guarded-body
                                  framed-body
                                  final-body
                                  emitted-body))
                                ;; A textual invariant drifted. Re-run the full
                                ;; unwrapped pipeline so the IR split, bare return,
                                ;; register plan, and prologue placement are all
                                ;; consistently disabled together.
                                (compiler-backend-emit-function
                                  type-segment-bases
                                  target
                                  mode
                                  func
                                  functions
                                  globals
                                  global-types
                                  externs
                                  plan
                                  program-index
                                  spans
                                  span-index
                                  emit-entry
                                  crt-entry
                                  allow-rbp
                                  false)
                                (begin
                                  ;; Publish carry-safe labels transactionally:
                                  ;; shrinkwrap/FPO attempts may recursively
                                  ;; retry this function with different final
                                  ;; blocks but reuse its assembly label scope.
                                  ;; An abandoned attempt must not leave labels
                                  ;; that make the accepted body inherit an
                                  ;; owner map across a non-fallthrough edge.
                                  (compiler-backend-peephole-collect-carry-safe!
                                    program-index.backend-state
                                    (compiler-backend-state-stream-state
                                      program-index.backend-state)
                                    (compiler-backend-state-function-state
                                      program-index.backend-state)
                                    label-scope
                                    emit-blocks-list)
                                  (compiler-backend-commit-frame-layout!
                                    program-index.backend-state
                                    target
                                    assignments
                                    symbol
                                    frame
                                    push-count
                                    slot-vars
                                    outgoing-frame-space
                                    fpo-ok
                                    rebase-ok
                                    shrinkwrap-active?)
                                  (ResultCompilerBackend.Ok
                                    (str_cat.str-cat
                                      (compiler-backend-function-symbol-map-comment
                                        program-index
                                        name)
                                      ".globl "
                                      symbol
                                      "\n"
                                      (compiler-backend-debug-function-location
                                        target
                                        program-index
                                        span-index
                                        spans
                                        name)
                                      ;; Immediately before the entry label:
                                      ;; the shrinkwrap and ordinary prologues
                                      ;; both open with `symbol:`.
                                      (compiler-backend-emit-function-type-directive
                                        target
                                        symbol)
                                      (if shrinkwrap-active?
                                        (str_cat.str-cat symbol ":\n" "")
                                        selected-prologue)
                                      ""
                                      ""
                                      ;; The text is final here (prologue
                                      ;; spliced, rsp rebased, FPO decided);
                                      ;; the fallthrough-`jmp` deletion runs
                                      ;; later, folded into the streaming
                                      ;; records parse, over the same bytes.
                                      emitted-body
                                      (compiler-backend-debug-function-end-label
                                        target
                                        program-index
                                        name)
                                      (if (and
                                        (compiler_ir_types.compiler-debug-info-enabled?)
                                        (compiler-backend-target-linux? target))
                                        "    .cfi_endproc\n"
                                        "")
                                      (compiler-backend-emit-windows-seh-endproc
                                        target)
                                      ;; Closes the function at its last
                                      ;; emitted byte, before the next
                                      ;; function's `.globl`/`.type`.
                                      (compiler-backend-emit-function-size-directive
                                        target
                                        symbol)
                                      "\n"))))))))]
                    [(ResultCompilerBackend.Err message)
                      (let
                        [_addr-forward-done : unit
                          (begin
                            (compiler-backend-function-state-set-bool!
                              (compiler-backend-state-function-state
                                program-index.backend-state)
                              compiler-backend-function-bool-identity-tail-forwarder-active
                              false)
                            (compiler-backend-addr-of-forwarding-disable!
                              program-index.backend-state)
                            (compiler-backend-group-vars-disable!
                              program-index.backend-state)
                            (compiler-backend-fuse-need-disable!
                              program-index.backend-state)
                            (compiler-backend-gep-fold-disable! function-state))]
                        (ResultCompilerBackend.Err message))]))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)]))))]))

;; 0: every function escapes through a per-function scratch arena. The old
;; limit of 24 sent small-function transients to the program arena to skip
;; the scratch/clone overhead, but their summed assembly-text churn stays
;; resident for the whole compile (RSS calibration); the per-function
;; arena reclaims it.
(define (compiler-backend-direct-emit-instr-limit) : i64
  0)

(define (compiler-backend-clear-function-owned-state!
  [backend-state : CompilerBackendState]) : unit
  (let
    [function-state-address : i64
      (__tl-project-field
        (compiler-backend-state-data backend-state)
        function-state-address)]
    (when
      (not (= function-state-address 0))
      (compiler-backend-function-state-reset!
        (CompilerBackendFunctionState function-state-address)))))

(define (compiler-backend-clear-function-emit-state!
  [backend-state : CompilerBackendState]) : unit
  (begin
    ;; Scratch-backed function state is retired before the caller-global
    ;; sentinels below are cleared. Do not recreate a lazy compatibility state
    ;; in the long-lived caller arena merely to reset an already-retired owner.
    (when
      (compiler-backend-state-function-state-active? backend-state)
      (begin
        (compiler-backend-addr-of-forwarding-disable! backend-state)
        (compiler-backend-group-vars-disable! backend-state)
        (compiler-backend-fuse-need-disable! backend-state)))
    (compiler-backend-clear-function-owned-state! backend-state)))

(define (compiler-backend-clear-scratch-escaped-emit-state!
  [backend-state : CompilerBackendState]) : unit
  (begin
    (compiler-backend-clear-function-emit-state! backend-state)
    unit))

(define (compiler-backend-emit-function-direct?
  [func : compiler_ir_types.CompilerIrFunction]) : bool
  (match func
    [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ blocks)
      (<=
        (compiler_ir_types.compiler-ir-block-list-instruction-count blocks)
        (compiler-backend-direct-emit-instr-limit))]))

(define (compiler-backend-emit-function-scratch
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [func : compiler_ir_types.CompilerIrFunction]
  [all-functions : compiler_ir_types.CompilerIrFunctionList]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]) : ResultCompilerBackend
  (let
    [backend-state : CompilerBackendState program-index.backend-state]
    [result : ResultCompilerBackend
      (with-escape
        (arena.Arena scratch)
        (let
          [function-state : CompilerBackendFunctionState
            (compiler-backend-function-state-new)]
          [_install : unit
            (compiler-backend-state-install-function-state!
              backend-state
              function-state)]
          [emitted : ResultCompilerBackend
            (compiler-backend-emit-function
              type-segment-bases
              target
              mode
              func
              all-functions
              globals
              global-types
              externs
              plan
              program-index
              spans
              span-index
              emit-entry
              crt-entry
              true
              true)]
          [wrapped : ResultCompilerBackend
            (match emitted
              [(ResultCompilerBackend.Ok head)
                (ResultCompilerBackend.Ok
                  (compiler-backend-emergency-wrap head backend-state))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)])]
          (begin
            ;; Clear scratch-owned references while the scratch arena is still
            ;; live, then retire the only job-owned handle before with-escape
            ;; rewinds it. This runs for success and controlled diagnostics.
            (compiler-backend-clear-function-owned-state! backend-state)
            (compiler-backend-state-retire-function-state! backend-state)
            wrapped)))]
    result))

;; Keep the direct path available for A/B experiments by raising
;; `compiler-backend-direct-emit-instr-limit`; normal builds route emitted
;; functions through a scratch arena so transient assembly strings stay within
;; the self-build memory budget.
(define (compiler-backend-emit-function-escaping
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [func : compiler_ir_types.CompilerIrFunction]
  [all-functions : compiler_ir_types.CompilerIrFunctionList]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]) : ResultCompilerBackend
  (let
    [backend-state : CompilerBackendState program-index.backend-state]
    [result : ResultCompilerBackend
      (if (compiler-backend-emit-function-direct? func)
        (let
          [function-state : CompilerBackendFunctionState
            (compiler-backend-function-state-new)]
          [_install : unit
            (compiler-backend-state-install-function-state!
              backend-state
              function-state)]
          [emitted : ResultCompilerBackend
            (compiler-backend-emit-function
              type-segment-bases
              target
              mode
              func
              all-functions
              globals
              global-types
              externs
              plan
              program-index
              spans
              span-index
              emit-entry
              crt-entry
              true
              true)]
          [wrapped : ResultCompilerBackend
            (match emitted
              [(ResultCompilerBackend.Ok head)
                (ResultCompilerBackend.Ok
                  (compiler-backend-emergency-wrap head backend-state))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err message)])]
          (begin
            (compiler-backend-clear-function-owned-state! backend-state)
            (compiler-backend-state-retire-function-state! backend-state)
            wrapped))
        (compiler-backend-emit-function-scratch
          type-segment-bases
          target
          mode
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch))]
    (begin
      ;; Scratch-backed function owners are already retired here. Reset only
      ;; the remaining global sentinels in the caller arena; function-owned
      ;; cleanup above deliberately stays inactive after retirement.
      (compiler-backend-clear-function-emit-state! backend-state)
      result)))

(define (compiler-backend-implicit-main-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    cbi.compiler-builtin-id-fix-main
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.I64)
    1
    (compiler_ir_types.compiler-ir-block-list-compact
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-instr-seq1
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.I64 0)))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (compiler-backend-functions-with-implicit-main
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [emit-entry : bool]) : compiler_ir_types.CompilerIrFunctionList
  (if (and
    emit-entry
    (not
      (compiler-backend-function-list-defines?
        functions
        cbi.compiler-builtin-id-fix-main)))
    (compiler_ir_types.compiler-ir-function-cons
      (compiler-backend-implicit-main-function)
      functions)
    functions))

(define (compiler-backend-emit-functions-buffer-raw-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [all-functions : compiler_ir_types.CompilerIrFunctionList]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (match functions
    [(compiler_ir_types.CompilerIrFunctionList.Nil)
      (ResultCompilerBackendBuffer.Ok buf)]
    [(compiler_ir_types.CompilerIrFunctionList.Cons func rest)
      (begin
        (cfg
          compile-profile
          (compiler-backend-profile-detail-start program-index.profile-state))
        (match (compiler-backend-emit-function-escaping
          type-segment-bases
          target
          (compiler-backend-effective-function-mode
            mode
            program-index.backend-state
            func)
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch)
          [(ResultCompilerBackend.Ok head)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  program-index.profile-state
                  "function"
                  (compiler-backend-profile-function-name
                    program-index.backend-state
                    func)))
              (compiler-backend-emit-functions-buffer-raw-into
                type-segment-bases
                target
                mode
                (__tl-box-place rest)
                all-functions
                globals
                global-types
                externs
                plan
                program-index
                spans
                span-index
                emit-entry
                crt-entry
                scratch
                (text_buf.append buf head)))]
          [(ResultCompilerBackend.Err message)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  program-index.profile-state
                  "function"
                  (compiler-backend-profile-function-name
                    program-index.backend-state
                    func)))
              (ResultCompilerBackendBuffer.Err message))]))]
    [(compiler_ir_types.CompilerIrFunctionList.Array seq)
      (compiler-backend-emit-function-seq-buffer-into
        type-segment-bases
        target
        mode
        seq
        0
        all-functions
        globals
        global-types
        externs
        plan
        program-index
        spans
        span-index
        emit-entry
        crt-entry
        scratch
        buf)]))

(define (compiler-backend-emit-function-seq-buffer-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [index : i64]
  [all-functions : compiler_ir_types.CompilerIrFunctionList]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (if (>= index (compiler_ir_types.compiler-ir-function-seq-count functions))
    (ResultCompilerBackendBuffer.Ok buf)
    (let
      [func : compiler_ir_types.CompilerIrFunction
        (compiler_ir_types.compiler-ir-function-seq-ref functions index)]
      (begin
        (cfg
          compile-profile
          (compiler-backend-profile-detail-start program-index.profile-state))
        (match (compiler-backend-emit-function-escaping
          type-segment-bases
          target
          (compiler-backend-effective-function-mode
            mode
            program-index.backend-state
            func)
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch)
          [(ResultCompilerBackend.Ok head)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  program-index.profile-state
                  "function"
                  (compiler-backend-profile-function-name
                    program-index.backend-state
                    func)))
              (compiler-backend-emit-function-seq-buffer-into
                type-segment-bases
                target
                mode
                functions
                (+ index 1)
                all-functions
                globals
                global-types
                externs
                plan
                program-index
                spans
                span-index
                emit-entry
                crt-entry
                scratch
                (text_buf.append buf head)))]
          [(ResultCompilerBackend.Err message)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  program-index.profile-state
                  "function"
                  (compiler-backend-profile-function-name
                    program-index.backend-state
                    func)))
              (ResultCompilerBackendBuffer.Err message))])))))

;; Final-buffer streaming emits each function into a rewindable raw arena, then
;; immediately moves its optimized bytes into the home-owned output stream.
(define (compiler-backend-emit-functions-stream-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [all-functions : compiler_ir_types.CompilerIrFunctionList]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (match functions
    [(compiler_ir_types.CompilerIrFunctionList.Nil)
      (ResultCompilerBackendBuffer.Ok buf)]
    [(compiler_ir_types.CompilerIrFunctionList.Cons func rest)
      (let
        [caller-arena : arena.Arena (arena.current)]
        (begin
          (compiler-backend-assembly-stream-begin-raw!
            program-index.backend-state
            (compiler-backend-state-stream-state program-index.backend-state))
          (cfg
            compile-profile
            (compiler-backend-profile-detail-start program-index.profile-state))
          (match (compiler-backend-emit-function-escaping
            type-segment-bases
            target
            (compiler-backend-effective-function-mode
              mode
              program-index.backend-state
              func)
            func
            all-functions
            globals
            global-types
            externs
            plan
            program-index
            spans
            span-index
            emit-entry
            crt-entry
            scratch)
            [(ResultCompilerBackend.Ok head)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-detail-finish
                    program-index.profile-state
                    "function"
                    (compiler-backend-profile-function-name
                      program-index.backend-state
                      func)))
                (compiler-backend-assembly-stream-process-string!
                  head
                  program-index.backend-state
                  (compiler-backend-state-stream-state
                    program-index.backend-state))
                (compiler-backend-assembly-stream-rewind-raw!
                  (compiler-backend-state-stream-state
                    program-index.backend-state))
                (unsafe
                  (arena.set! caller-arena))
                (compiler-backend-emit-functions-stream-into
                  type-segment-bases
                  target
                  mode
                  (__tl-box-place rest)
                  all-functions
                  globals
                  global-types
                  externs
                  plan
                  program-index
                  spans
                  span-index
                  emit-entry
                  crt-entry
                  scratch
                  buf))]
            [(ResultCompilerBackend.Err message)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-detail-finish
                    program-index.profile-state
                    "function"
                    (compiler-backend-profile-function-name
                      program-index.backend-state
                      func)))
                (unsafe
                  (arena.set! caller-arena))
                (ResultCompilerBackendBuffer.Err message))])))]
    [(compiler_ir_types.CompilerIrFunctionList.Array seq)
      (compiler-backend-emit-function-seq-stream-into
        type-segment-bases
        target
        mode
        seq
        0
        all-functions
        globals
        global-types
        externs
        plan
        program-index
        spans
        span-index
        emit-entry
        crt-entry
        scratch
        buf)]))

(define (compiler-backend-emit-function-seq-stream-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [index : i64]
  [all-functions : compiler_ir_types.CompilerIrFunctionList]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [scratch : i64]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (if (>= index (compiler_ir_types.compiler-ir-function-seq-count functions))
    (ResultCompilerBackendBuffer.Ok buf)
    (let
      [func : compiler_ir_types.CompilerIrFunction
        (compiler_ir_types.compiler-ir-function-seq-ref functions index)]
      [caller-arena : arena.Arena (arena.current)]
      (begin
        (compiler-backend-assembly-stream-begin-raw!
          program-index.backend-state
          (compiler-backend-state-stream-state program-index.backend-state))
        (cfg
          compile-profile
          (compiler-backend-profile-detail-start program-index.profile-state))
        (match (compiler-backend-emit-function-escaping
          type-segment-bases
          target
          (compiler-backend-effective-function-mode
            mode
            program-index.backend-state
            func)
          func
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          scratch)
          [(ResultCompilerBackend.Ok head)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  program-index.profile-state
                  "function"
                  (compiler-backend-profile-function-name
                    program-index.backend-state
                    func)))
              (compiler-backend-assembly-stream-process-string!
                head
                program-index.backend-state
                (compiler-backend-state-stream-state
                  program-index.backend-state))
              (compiler-backend-assembly-stream-rewind-raw!
                (compiler-backend-state-stream-state
                  program-index.backend-state))
              (unsafe
                (arena.set! caller-arena))
              (compiler-backend-emit-function-seq-stream-into
                type-segment-bases
                target
                mode
                functions
                (+ index 1)
                all-functions
                globals
                global-types
                externs
                plan
                program-index
                spans
                span-index
                emit-entry
                crt-entry
                scratch
                buf))]
          [(ResultCompilerBackend.Err message)
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-detail-finish
                  program-index.profile-state
                  "function"
                  (compiler-backend-profile-function-name
                    program-index.backend-state
                    func)))
              (unsafe
                (arena.set! caller-arena))
              (ResultCompilerBackendBuffer.Err message))])))))

(define (compiler-backend-emit-functions-buffer-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [all-functions : compiler_ir_types.CompilerIrFunctionList]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [global-types : CompilerBackendGlobalTypeTable]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [span-index : CompilerBackendSourceSpanIndex]
  [emit-entry : bool]
  [crt-entry : bool]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (let
    [scratch : arena.Arena (arena.make)]
    [result : ResultCompilerBackendBuffer
      (if (compiler-backend-assembly-stream-active?
        (compiler-backend-state-stream-state program-index.backend-state))
        (compiler-backend-emit-functions-stream-into
          type-segment-bases
          target
          mode
          functions
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          (arena.raw-handle scratch)
          buf)
        (compiler-backend-emit-functions-buffer-raw-into
          type-segment-bases
          target
          mode
          functions
          all-functions
          globals
          global-types
          externs
          plan
          program-index
          spans
          span-index
          emit-entry
          crt-entry
          (arena.raw-handle scratch)
          buf))]
    (begin
      (arena.destroy-safe! scratch)
      result)))

(define (compiler-backend-emit-closure-descriptor-entry [name : String]) : String
  (str_cat.str-cat
    (compiler-backend-closure-descriptor-label name)
    ":\n    .quad "
    (compiler-backend-closure-entry-label name)
    "\n    .quad 0\n"
    ""))

(define (compiler-backend-emit-closure-descriptor-entry-into
  [name : i64]
  [_functions : compiler_ir_types.CompilerIrFunctionList]
  [_externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match (compiler-backend-index-signature program-index name)
    [(CompilerBackendMaybeSignature.Some _ _)
      (text_buf.append
        buf
        (compiler-backend-emit-closure-descriptor-entry
          (compiler-backend-symbol-text-index program-index name)))]
    [(CompilerBackendMaybeSignature.No) buf]))

(define (compiler-backend-emit-closure-descriptor-entries-into
  [names : BackendSymbolSeq]
  [index : i64]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (>= index names.len)
    buf
    (compiler-backend-emit-closure-descriptor-entries-into
      names
      (+ index 1)
      functions
      externs
      program-index
      (compiler-backend-emit-closure-descriptor-entry-into
        (array-ref names.slots index)
        functions
        externs
        program-index
        buf))))

(define (compiler-backend-emit-closure-descriptors-into
  [names : BackendSymbolSeq]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (= names.len 0)
    buf
    (compiler-backend-emit-closure-descriptor-entries-into
      names
      0
      functions
      externs
      program-index
      (text_buf.append buf "    .section .rodata\n    .balign 8\n"))))

(define (compiler-backend-closure-adapter-outgoing-frame-space
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [param-types : compiler_ast_types.AstTypeList]
  [program-index : CompilerBackendProgramIndex]) : i64
  (match target
    ;; The adapter's forwarded call does not dip on Linux -> reserve
    ;; its actual outgoing space in the adapter frame.
    [(CompilerBackendTarget.Linux)
      (compiler-backend-round-up-16
        (+
          (compiler-backend-outgoing-shadow-space target)
          (compiler-backend-linux-stack-arg-space
            type-segment-bases
            target
            args
            param-types
            program-index)))]
    [(CompilerBackendTarget.Windows)
      ;; No callee signature here -- size conservatively at two positions
      ;; per forwarded argument so a register-group never overruns the area.
      (compiler-backend-round-up-16
        (+
          (compiler-backend-outgoing-shadow-space target)
          (compiler-backend-windows-words-stack-space
            (* 2 (compiler-backend-call-args-count args)))))]))

(define (compiler-backend-emit-closure-entry-adapter
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [name : i64]
  [param-types : compiler_ast_types.AstTypeList]
  [_ret-ty : compiler_ast_types.AstType]
  [plan : CompilerBackendRuntimePlan]
  [_functions : compiler_ir_types.CompilerIrFunctionList]
  [_externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (let
    [params : compiler_ir_types.CompilerIrParamList
      (compiler-backend-param-list-from-types type-segment-bases param-types 0)]
    [vars : i64 (compiler-backend-type-list-count param-types)]
    [args : compiler_ir_types.CompilerIrCallArgs
      (compiler_ir_types.compiler-ir-call-args-from-list
        (compiler-backend-var-value-list
          (compiler-backend-type-list-count param-types)
          0))]
    [extern-call-info : i64
      (compiler-backend-index-extern-call-info program-index name)]
    [frame : i64
      (+
        (compiler-backend-frame-size
          ;; Group params spill word1 at -(8*(vars+var+1))(%rbp); the
          ;; frame must cover those slots (no red zone on Windows -- the
          ;; outgoing stack-arg area would clobber them otherwise).
          (compiler-backend-frame-slots-with-groups
            vars
            (compiler_regalloc.compiler-reg-assignment-table-empty)
            (compiler-backend-type-list-has-group?
              type-segment-bases
              param-types
              program-index)
            program-index.backend-state))
        (compiler-backend-closure-adapter-outgoing-frame-space
          type-segment-bases
          target
          args
          param-types
          program-index))]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        false
        program-index)]
    [diag : compiler_diagnostic.CompilerDiagnostic
      (compiler_diagnostic.compiler-diagnostic-at-start "" "")]
    (match (compiler-backend-emit-param-spills
      type-segment-bases
      target
      (compiler_regalloc.compiler-reg-assignment-table-empty)
      params
      1
      0
      1
      0
      program-index
      vars
      program-index.backend-state)
      [(ResultCompilerBackend.Ok spills)
        (match (compiler-backend-emit-call-args
          type-segment-bases
          target
          (compiler_regalloc.compiler-reg-assignment-table-empty)
          args
          param-types
          false
          0
          0
          0
          0
          0
          ""
          diag
          program-index
          vars
          program-index.backend-state)
          [(ResultCompilerBackend.Ok args-asm)
            (ResultCompilerBackend.Ok
              (str_cat.str-cat
                (compiler-backend-emit-function-entry
                  target
                  (compiler-backend-closure-entry-label
                    (compiler-backend-symbol-text-index program-index name))
                  frame
                  (compiler_regalloc.compiler-reg-assignment-table-empty)
                  vars
                  program-index.backend-state)
                ""
                ""
                ;; M-G3 stage 1: adapters go through the same rsp rebase as
                ;; user functions (their `movq %rbp,%rsp` epilogue ends rsp
                ;; validity; no frame refs follow it). Stage 2: adapters keep
                ;; the rbp prologue (fpo=false) -- their raw epilogue resets
                ;; rsp from rbp and they never home values in %rbp.
                (compiler-backend-rsp-rebase
                  (str_cat.str-cat
                    spills
                    (compiler-backend-emit-call-space-sub call-space)
                    args-asm
                    (compiler-backend-varargs-pre-call
                      type-segment-bases
                      target
                      extern-call-info
                      param-types)
                    (str_cat.str-cat
                      "    call "
                      (compiler-backend-call-symbol-index
                        name
                        plan
                        program-index)
                      "\n"
                      (str_cat.str-cat
                        (compiler-backend-emit-call-space-add call-space)
                        (str_cat.str-cat
                          "    movq %rbp, %rsp\n    popq %rbp\n    ret\n"
                          (if (and
                            (compiler_ir_types.compiler-debug-info-enabled?)
                            (compiler-backend-target-linux? target))
                            "    .cfi_endproc\n"
                            "")
                          "")
                        (compiler-backend-emit-windows-seh-endproc target)
                        "\n")
                      ""))
                  frame
                  false
                  program-index.backend-state)
                ""))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])]
      [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)])))

;; Closure entry adapters are emitted functions too: their argument shuffles can
;; scavenge and therefore must finish emergency wrapping before their scratch
;; owner is retired. Preserve a caller-installed owner for focused nested
;; fixtures, while production enters with no active function owner.
(define (compiler-backend-emit-closure-entry-adapter-owned
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [name : i64]
  [param-types : compiler_ast_types.AstTypeList]
  [ret-ty : compiler_ast_types.AstType]
  [plan : CompilerBackendRuntimePlan]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (let
    [backend-state : CompilerBackendState program-index.backend-state]
    [previous-address : i64
      (compiler-backend-state-function-state-address backend-state)]
    [function-state : CompilerBackendFunctionState
      (compiler-backend-function-state-new)]
    [_install : unit
      (compiler-backend-state-install-function-state!
        backend-state
        function-state)]
    [_abi : unit
      (compiler-backend-set-current-fn-abi!
        backend-state
        (compiler-backend-regalloc-abi target))]
    [groups : compiler_liveness.CompilerLiveI64Set
      (compiler-backend-type-list-group-vars
        type-segment-bases
        param-types
        program-index)]
    [_groups : unit
      (begin
        (compiler-backend-current-slot-vars-set!
          backend-state
          (compiler-backend-type-list-count param-types))
        (compiler-backend-group-vars-enable!
          backend-state
          groups
          (compiler_liveness.compiler-live-set-empty)))]
    [emitted : ResultCompilerBackend
      (compiler-backend-emit-closure-entry-adapter
        type-segment-bases
        target
        name
        param-types
        ret-ty
        plan
        functions
        externs
        program-index)]
    [wrapped : ResultCompilerBackend
      (match emitted
        [(ResultCompilerBackend.Ok head)
          (ResultCompilerBackend.Ok
            (compiler-backend-emergency-wrap head backend-state))]
        [(ResultCompilerBackend.Err message)
          (ResultCompilerBackend.Err message)])]
    (begin
      (compiler-backend-clear-function-owned-state! backend-state)
      (compiler-backend-state-set-function-state-address!
        backend-state
        previous-address)
      wrapped)))

(define (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [names : BackendSymbolSeq]
  [index : i64]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (if (>= index names.len)
    (ResultCompilerBackendBuffer.Ok buf)
    (let
      [name : i64 (array-ref names.slots index)]
      (match (compiler-backend-index-signature program-index name)
        [(CompilerBackendMaybeSignature.Some param-types ret-ty)
          (match (compiler-backend-emit-closure-entry-adapter-owned
            type-segment-bases
            target
            name
            param-types
            ret-ty
            plan
            functions
            externs
            program-index)
            [(ResultCompilerBackend.Ok head)
              (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
                type-segment-bases
                target
                names
                (+ index 1)
                functions
                externs
                plan
                program-index
                (text_buf.append buf head))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackendBuffer.Err message)])]
        [(CompilerBackendMaybeSignature.No)
          (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
            type-segment-bases
            target
            names
            (+ index 1)
            functions
            externs
            plan
            program-index
            buf)]))))

(define (compiler-backend-emit-closure-entry-adapters-stream-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [names : BackendSymbolSeq]
  [index : i64]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (if (>= index names.len)
    (ResultCompilerBackendBuffer.Ok buf)
    (let
      [name : i64 (array-ref names.slots index)]
      (match (compiler-backend-index-signature program-index name)
        [(CompilerBackendMaybeSignature.Some param-types ret-ty)
          (let
            [caller-arena : arena.Arena (arena.current)]
            (begin
              (compiler-backend-assembly-stream-begin-raw!
                program-index.backend-state
                (compiler-backend-state-stream-state
                  program-index.backend-state))
              (match (compiler-backend-emit-closure-entry-adapter-owned
                type-segment-bases
                target
                name
                param-types
                ret-ty
                plan
                functions
                externs
                program-index)
                [(ResultCompilerBackend.Ok head)
                  (begin
                    (compiler-backend-assembly-stream-process-string!
                      head
                      program-index.backend-state
                      (compiler-backend-state-stream-state
                        program-index.backend-state))
                    (compiler-backend-assembly-stream-rewind-raw!
                      (compiler-backend-state-stream-state
                        program-index.backend-state))
                    (unsafe
                      (arena.set! caller-arena))
                    (compiler-backend-emit-closure-entry-adapters-stream-into
                      type-segment-bases
                      target
                      names
                      (+ index 1)
                      functions
                      externs
                      plan
                      program-index
                      buf))]
                [(ResultCompilerBackend.Err message)
                  (begin
                    (unsafe
                      (arena.set! caller-arena))
                    (ResultCompilerBackendBuffer.Err message))])))]
        [(CompilerBackendMaybeSignature.No)
          (compiler-backend-emit-closure-entry-adapters-stream-into
            type-segment-bases
            target
            names
            (+ index 1)
            functions
            externs
            plan
            program-index
            buf)]))))

(define (compiler-backend-emit-closure-entry-adapters-buffer-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [names : BackendSymbolSeq]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [buf : text_buf.TextBuf]) : ResultCompilerBackendBuffer
  (if (compiler-backend-assembly-stream-active?
    (compiler-backend-state-stream-state program-index.backend-state))
    (compiler-backend-emit-closure-entry-adapters-stream-into
      type-segment-bases
      target
      names
      0
      functions
      externs
      plan
      program-index
      buf)
    (compiler-backend-emit-closure-entry-adapters-buffer-raw-into
      type-segment-bases
      target
      names
      0
      functions
      externs
      plan
      program-index
      buf)))

(define (compiler-backend-string-set-list [set : BackendStringSet]) : BackendStringSeq
  set.items)

(define (compiler-backend-symbol-set-list [set : BackendSymbolSet]) : BackendSymbolSeq
  set.items)

(define (compiler-backend-float-set-list [set : BackendFloatSet]) : BackendFloatSeq
  set.items)

(define (compiler-backend-program-collections-functions
  [collections : CompilerBackendProgramCollections]) : BackendSymbolSeq
  (compiler-backend-symbol-set-list collections.functions))

(define (compiler-backend-program-collections-strings
  [collections : CompilerBackendProgramCollections]) : BackendStringSeq
  (compiler-backend-string-set-list collections.strings))

(define (compiler-backend-program-collections-floats
  [collections : CompilerBackendProgramCollections]) : BackendFloatSeq
  (compiler-backend-float-set-list collections.floats))

(define (compiler-backend-program-collections-bytes
  [collections : CompilerBackendProgramCollections]) : BackendStringSeq
  (compiler-backend-string-set-list collections.bytes))

(define (compiler-backend-program-collections-uses-avx2-i64-lane-id?
  [collections : CompilerBackendProgramCollections]) : bool
  collections.uses-avx2-i64-lane-id)

(define (compiler-backend-program-collections-uses-avx512-i64-lane-id?
  [collections : CompilerBackendProgramCollections]) : bool
  collections.uses-avx512-i64-lane-id)

(define (compiler-backend-program-collections-uses-f64-neg?
  [collections : CompilerBackendProgramCollections]) : bool
  collections.uses-f64-neg)

(define (compiler-backend-collect-float-both-collections
  [collections : CompilerBackendProgramCollections (:consume)]
  [bits : u64]) : CompilerBackendProgramCollections
  (compiler-backend-program-collections-add-float
    (compiler-backend-program-collections-add-float
      collections
      (compiler_ast_types.AstType.F64)
      bits)
    (compiler_ast_types.AstType.F32)
    bits))

(define (compiler-backend-collect-lane-id-collections
  [collections : CompilerBackendProgramCollections]
  [lanes : i64]
  [elem-ty : compiler_ast_types.AstType]) : CompilerBackendProgramCollections
  (if (compiler-backend-lane-id-avx512-i64-shape-ok? elem-ty lanes)
    (compiler-backend-program-collections-mark-avx512-i64-lane-id collections)
    (if (compiler-backend-lane-id-avx2-i64-shape-ok? elem-ty lanes)
      (compiler-backend-program-collections-mark-avx2-i64-lane-id collections)
      collections)))

(define (compiler-backend-collect-lane-offset-gather-collections
  [collections : CompilerBackendProgramCollections]
  [lanes : i64]
  [elem-ty : compiler_ast_types.AstType]) : CompilerBackendProgramCollections
  (cond
    [(and (compiler-backend-gather-dword-element? elem-ty) (= lanes 8))
      (compiler-backend-program-collections-mark-avx2-i64-lane-id collections)]
    [(and (compiler-backend-gather-dword-element? elem-ty) (= lanes 16))
      (compiler-backend-program-collections-mark-avx512-i64-lane-id collections)]
    [(and (not (compiler-backend-gather-dword-element? elem-ty)) (= lanes 4))
      (compiler-backend-program-collections-mark-avx2-i64-lane-id collections)]
    [(and (not (compiler-backend-gather-dword-element? elem-ty)) (= lanes 8))
      (compiler-backend-program-collections-mark-avx512-i64-lane-id collections)]
    [else collections]))

(define (compiler-backend-collect-value-collections
  [collections : CompilerBackendProgramCollections]
  [value : compiler_ir_types.CompilerIrValue]) : CompilerBackendProgramCollections
  (match value
    [(compiler_ir_types.CompilerIrValue.Function name)
      (compiler-backend-program-collections-add-function collections name)]
    [(compiler_ir_types.CompilerIrValue.String text)
      (compiler-backend-program-collections-add-string collections text)]
    [(compiler_ir_types.CompilerIrValue.F64 bits)
      (compiler-backend-collect-float-both-collections collections bits)]
    [(compiler_ir_types.CompilerIrValue.Bytes text)
      (compiler-backend-program-collections-add-bytes collections text)]
    [_ collections]))

(define (compiler-backend-collect-maybe-value-collections
  [collections : CompilerBackendProgramCollections (:consume)]
  [value : compiler_ir_types.CompilerIrMaybeValue]) : CompilerBackendProgramCollections
  (match value
    [(compiler_ir_types.CompilerIrMaybeValue.No) collections]
    [(compiler_ir_types.CompilerIrMaybeValue.Some inner)
      (compiler-backend-collect-value-collections collections inner)]))

(define (compiler-backend-collect-value-list-collections
  [collections : CompilerBackendProgramCollections (:consume)]
  [values : compiler_ir_types.CompilerIrValueList]) : CompilerBackendProgramCollections
  (match values
    [(compiler_ir_types.CompilerIrValueList.Nil) collections]
    [(compiler_ir_types.CompilerIrValueList.Array seq)
      (compiler-backend-collect-value-list-collections
        collections
        (compiler_ir_types.compiler-ir-value-seq-to-list seq))]
    [(compiler_ir_types.CompilerIrValueList.Cons value rest)
      (compiler-backend-collect-value-list-collections
        (compiler-backend-collect-value-collections collections value)
        (__tl-box-place rest))]))

(define (compiler-backend-collect-call-args-array-collections
  [collections : CompilerBackendProgramCollections (:consume)]
  [values : (__tl_dyn-array compiler_ir_types.CompilerIrValue)]
  [index : i64]) : CompilerBackendProgramCollections
  (if (>= index (array-length values))
    collections
    (compiler-backend-collect-call-args-array-collections
      (compiler-backend-collect-value-collections
        collections
        (array-ref values index))
      values
      (+ index 1))))

(define (compiler-backend-collect-call-args-collections
  [collections : CompilerBackendProgramCollections (:consume)]
  [args : compiler_ir_types.CompilerIrCallArgs]) : CompilerBackendProgramCollections
  (match args
    [(compiler_ir_types.CompilerIrCallArgs.Nil) collections]
    [(compiler_ir_types.CompilerIrCallArgs.One value)
      (compiler-backend-collect-value-collections collections value)]
    [(compiler_ir_types.CompilerIrCallArgs.Two a b)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections a)
        b)]
    [(compiler_ir_types.CompilerIrCallArgs.Array values)
      (compiler-backend-collect-call-args-array-collections
        collections
        values
        0)]))

(define (compiler-backend-collect-spmd-call-args-collections
  [collections : CompilerBackendProgramCollections (:consume)]
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]) : CompilerBackendProgramCollections
  (match args
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Nil) collections]
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(compiler_ir_types.CompilerIrSpmdCallArg.Arg _ value _)
          (compiler-backend-collect-spmd-call-args-collections
            (compiler-backend-collect-value-collections collections value)
            (__tl-box-place rest))])]
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : CompilerBackendProgramCollections collections]
        [i : i64 0]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array compiler_ir_types.CompilerIrSpmdCallArg)
          seq.slots]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(compiler_ir_types.CompilerIrSpmdCallArg.Arg _ value _)
                  (set!
                    out
                    (compiler-backend-collect-value-collections out value))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-backend-collect-phi-collections
  [collections : CompilerBackendProgramCollections (:consume)]
  [inputs : compiler_ir_types.CompilerIrPhiInputList]) : CompilerBackendProgramCollections
  (match (compiler_ir_types.compiler-ir-phi-input-list-force-cons inputs)
    [(compiler_ir_types.CompilerIrPhiInputList.Nil) collections]
    [(compiler_ir_types.CompilerIrPhiInputList.Array seq)
      (compiler-backend-collect-phi-collections
        collections
        (compiler_ir_types.compiler-ir-phi-input-seq-to-list seq))]
    [(compiler_ir_types.CompilerIrPhiInputList.Cons value _ rest)
      (compiler-backend-collect-phi-collections
        (compiler-backend-collect-value-collections collections value)
        (__tl-box-place rest))]))

(define (compiler-backend-collect-instr-collections
  [collections : CompilerBackendProgramCollections]
  [instr : compiler_ir_types.CompilerIrInstr]) : CompilerBackendProgramCollections
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Mov _ src _)
      (compiler-backend-collect-value-collections collections src)]
    [(compiler_ir_types.CompilerIrInstr.BinOp _ _ lhs rhs _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections lhs)
        rhs)]
    [(compiler_ir_types.CompilerIrInstr.UnOp _ op src ty)
      (let
        [with-src : CompilerBackendProgramCollections
          (compiler-backend-collect-value-collections collections src)]
        (match op
          [(compiler_ir_types.CompilerIrUnOp.Neg)
            (if (compiler-backend-f64-type? ty)
              (compiler-backend-program-collections-mark-f64-neg with-src)
              with-src)]
          [_ with-src]))]
    [(compiler_ir_types.CompilerIrInstr.Call _ _ args _)
      (compiler-backend-collect-call-args-collections collections args)]
    [(compiler_ir_types.CompilerIrInstr.CallIndirect _ func args _)
      (compiler-backend-collect-call-args-collections
        (compiler-backend-collect-value-collections collections func)
        args)]
    [(compiler_ir_types.CompilerIrInstr.CallIndirectC _ func args _)
      (compiler-backend-collect-call-args-collections
        (compiler-backend-collect-value-collections collections func)
        args)]
    [(compiler_ir_types.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (compiler-backend-collect-call-args-collections
          (compiler-backend-collect-value-collections collections base)
          args))]
    [(compiler_ir_types.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [func (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (compiler-backend-collect-call-args-collections
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections collections base)
            func)
          args))]
    [(compiler_ir_types.CompilerIrInstr.SpmdCall payload-box)
      (let
        [active-mask
          (__tl-project-field (__tl-box-place payload-box) active-mask)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (compiler-backend-collect-spmd-call-args-collections
          (compiler-backend-collect-value-collections collections active-mask)
          args))]
    [(compiler_ir_types.CompilerIrInstr.TailCall _ args _)
      (compiler-backend-collect-call-args-collections collections args)]
    [(compiler_ir_types.CompilerIrInstr.Store _ value _)
      (compiler-backend-collect-value-collections collections value)]
    [(compiler_ir_types.CompilerIrInstr.Branch cond _ _)
      (compiler-backend-collect-value-collections collections cond)]
    [(compiler_ir_types.CompilerIrInstr.TotalEnumBranch cond _ _)
      (compiler-backend-collect-value-collections collections cond)]
    [(compiler_ir_types.CompilerIrInstr.Return maybe)
      (compiler-backend-collect-maybe-value-collections collections maybe)]
    [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
      (compiler-backend-collect-phi-collections collections inputs)]
    [(compiler_ir_types.CompilerIrInstr.Gep _ base offset _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections base)
        offset)]
    [(compiler_ir_types.CompilerIrInstr.Load _ src _)
      (compiler-backend-collect-value-collections collections src)]
    [(compiler_ir_types.CompilerIrInstr.StorePtr dst src _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections dst)
        src)]
    [(compiler_ir_types.CompilerIrInstr.CopyBytes dst src _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections dst)
        src)]
    [(compiler_ir_types.CompilerIrInstr.BoundsCheck index length _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections index)
        length)]
    [(compiler_ir_types.CompilerIrInstr.Cast _ src _ _)
      (compiler-backend-collect-value-collections collections src)]
    [(compiler_ir_types.CompilerIrInstr.Bitcast _ src _ _)
      (compiler-backend-collect-value-collections collections src)]
    [(compiler_ir_types.CompilerIrInstr.Splat _ value _ _)
      (compiler-backend-collect-value-collections collections value)]
    [(compiler_ir_types.CompilerIrInstr.VectorBinOp payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (compiler-backend-collect-value-collections
          (compiler-backend-collect-value-collections collections lhs)
          rhs))]
    [(compiler_ir_types.CompilerIrInstr.VectorPrefix payload-box)
      (let
        [src (__tl-project-field (__tl-box-place payload-box) src)]
        [carry (__tl-project-field (__tl-box-place payload-box) carry)]
        (compiler-backend-collect-value-collections
          (compiler-backend-collect-value-collections collections src)
          carry))]
    [(compiler_ir_types.CompilerIrInstr.VectorReduce _ _ src _ _)
      (compiler-backend-collect-value-collections collections src)]
    [(compiler_ir_types.CompilerIrInstr.VectorCompare payload-box)
      (let
        [lhs (__tl-project-field (__tl-box-place payload-box) lhs)]
        [rhs (__tl-project-field (__tl-box-place payload-box) rhs)]
        (compiler-backend-collect-value-collections
          (compiler-backend-collect-value-collections collections lhs)
          rhs))]
    [(compiler_ir_types.CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections lhs)
        rhs)]
    [(compiler_ir_types.CompilerIrInstr.MaskNot _ src _)
      (compiler-backend-collect-value-collections collections src)]
    [(compiler_ir_types.CompilerIrInstr.MaskReduce _ _ src _)
      (compiler-backend-collect-value-collections collections src)]
    [(compiler_ir_types.CompilerIrInstr.Select payload-box)
      (let
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        [on-true (__tl-project-field (__tl-box-place payload-box) on-true)]
        [on-false (__tl-project-field (__tl-box-place payload-box) on-false)]
        (compiler-backend-collect-value-collections
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections collections mask)
            on-true)
          on-false))]
    [(compiler_ir_types.CompilerIrInstr.VectorLoad _ base index _ _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections base)
        index)]
    [(compiler_ir_types.CompilerIrInstr.VectorStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        (compiler-backend-collect-value-collections
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections collections base)
            index)
          value))]
    [(compiler_ir_types.CompilerIrInstr.PredicatedStore payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [value (__tl-project-field (__tl-box-place payload-box) value)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (compiler-backend-collect-value-collections
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections
              (compiler-backend-collect-value-collections collections base)
              index)
            value)
          mask))]
    [(compiler_ir_types.CompilerIrInstr.PredicatedLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [mask (__tl-project-field (__tl-box-place payload-box) mask)]
        (compiler-backend-collect-value-collections
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections collections base)
            index)
          mask))]
    [(compiler_ir_types.CompilerIrInstr.GatherLoad payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [index-base
          (__tl-project-field (__tl-box-place payload-box) index-base)]
        [index (__tl-project-field (__tl-box-place payload-box) index)]
        [lane-offset
          (__tl-project-field (__tl-box-place payload-box) lane-offset)]
        [lanes (__tl-project-field (__tl-box-place payload-box) lanes)]
        [elem-ty (__tl-project-field (__tl-box-place payload-box) ty)]
        [values : CompilerBackendProgramCollections
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections
              (compiler-backend-collect-value-collections collections base)
              index-base)
            index)]
        (if lane-offset
          (compiler-backend-collect-lane-offset-gather-collections
            values
            lanes
            elem-ty)
          values))]
    [(compiler_ir_types.CompilerIrInstr.VectorShuffle payload-box)
      (let
        [source (__tl-project-field (__tl-box-place payload-box) source)]
        [selector-low
          (__tl-project-field (__tl-box-place payload-box) selector-low)]
        [selector-high
          (__tl-project-field (__tl-box-place payload-box) selector-high)]
        [active-lanes
          (__tl-project-field (__tl-box-place payload-box) active-lanes)]
        (compiler-backend-collect-value-collections
          (compiler-backend-collect-maybe-value-collections
            (compiler-backend-collect-value-collections
              (compiler-backend-collect-value-collections collections source)
              selector-low)
            selector-high)
          active-lanes))]
    [(compiler_ir_types.CompilerIrInstr.TailMask _ index length lanes)
      (let
        [values : CompilerBackendProgramCollections
          (compiler-backend-collect-value-collections
            (compiler-backend-collect-value-collections collections index)
            length)]
        (if (= lanes 4)
          (compiler-backend-program-collections-mark-avx2-i64-lane-id values)
          values))]
    [(compiler_ir_types.CompilerIrInstr.CpuId _ leaf subleaf _)
      (compiler-backend-collect-value-collections
        (compiler-backend-collect-value-collections collections leaf)
        subleaf)]
    [(compiler_ir_types.CompilerIrInstr.Xgetbv _ index)
      (compiler-backend-collect-value-collections collections index)]
    [(compiler_ir_types.CompilerIrInstr.Syscall _ args)
      (compiler-backend-collect-call-args-collections collections args)]
    [(compiler_ir_types.CompilerIrInstr.Pack _ words _)
      (compiler-backend-collect-value-list-collections collections words)]
    [(compiler_ir_types.CompilerIrInstr.Word _ src _ _)
      (compiler-backend-collect-value-collections collections src)]
    [(compiler_ir_types.CompilerIrInstr.TailCallIndirect func args _)
      (compiler-backend-collect-call-args-collections
        (compiler-backend-collect-value-collections collections func)
        args)]
    [(compiler_ir_types.CompilerIrInstr.Alloc _ _) collections]
    [(compiler_ir_types.CompilerIrInstr.AddrOf _ _) collections]
    [(compiler_ir_types.CompilerIrInstr.LaneId _ lanes elem-ty)
      (compiler-backend-collect-lane-id-collections collections lanes elem-ty)]
    [(compiler_ir_types.CompilerIrInstr.EntryArgc _) collections]
    [(compiler_ir_types.CompilerIrInstr.EntryArgv _) collections]
    [(compiler_ir_types.CompilerIrInstr.EntryEnvp _) collections]
    [(compiler_ir_types.CompilerIrInstr.Jump _) collections]
    [(compiler_ir_types.CompilerIrInstr.Switch index _ _ _)
      (compiler-backend-collect-value-collections collections index)]
    [(compiler_ir_types.CompilerIrInstr.TotalEnumSwitch index _ _ _ _)
      (compiler-backend-collect-value-collections collections index)]))

(define (compiler-backend-collect-instr-seq-collections
  [collections : CompilerBackendProgramCollections]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : CompilerBackendProgramCollections
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [index : i64 0]
    [out : CompilerBackendProgramCollections collections]
    (begin
      (while (< index count)
        (begin
          (set!
            out
            (compiler-backend-collect-instr-collections
              out
              (array-ref slots index)))
          (set! index (+ index 1))))
      out)))

(define (compiler-backend-collect-function-collections
  [collections : CompilerBackendProgramCollections]
  [functions : compiler_ir_types.CompilerIrFunctionList]) : CompilerBackendProgramCollections
  (match (compiler-backend-collect-functions-shared
    (CompilerBackendCollectState.Collections collections)
    functions)
    [(CompilerBackendCollectState.Collections out) out]
    [_ collections]))

(define (compiler-backend-collect-global-collections-from
  [collections : CompilerBackendProgramCollections (:consume)]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [index : i64]) : CompilerBackendProgramCollections
  (if (>= index globals.len)
    collections
    (match (compiler_ir_types.compiler-ir-global-seq-ref globals index)
      [(compiler_ir_types.CompilerIrGlobal.Global _ _ value)
        (compiler-backend-collect-global-collections-from
          (compiler-backend-collect-value-collections collections value)
          globals
          (+ index 1))])))

(define (compiler-backend-collect-global-collections
  [collections : CompilerBackendProgramCollections (:consume)]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]) : CompilerBackendProgramCollections
  (compiler-backend-collect-global-collections-from collections globals 0))

(define (compiler-backend-collect-program-collections
  [program : compiler_ir_types.CompilerIrProgram]) : CompilerBackendProgramCollections
  (match program
    [(compiler_ir_types.CompilerIrProgram.Program globals functions _)
      (compiler-backend-collect-function-collections
        (compiler-backend-collect-global-collections
          (compiler-backend-program-collections-new)
          globals)
        functions)]))

(define (compiler-backend-collect-source-path-strings
  [backend-state : CompilerBackendState]
  [collections : CompilerBackendProgramCollections (:consume)]
  [spans : compiler_ir_types.CompilerSourceSpans]) : CompilerBackendProgramCollections
  (match spans
    [(compiler_ir_types.CompilerSourceSpans.Spans _ instr-entries _)
      (let
        [slots : (__tl_dyn-array
          compiler_ir_types.CompilerSourceSpansInstrEntry)
          instr-entries.slots]
        [count : i64 instr-entries.len]
        [index : i64 0]
        [out : CompilerBackendProgramCollections collections]
        (begin
          (while (< index count)
            (begin
              (match (array-ref slots index)
                [(compiler_ir_types.CompilerSourceSpansInstrEntry.Entry
                    _
                    path-id
                    _)
                  (when
                    (> path-id 0)
                    (set!
                      out
                      (compiler-backend-program-collections-add-string
                        out
                        (ci.intern-compat-state-str
                          (compiler-backend-state-intern backend-state)
                          path-id))))])
              (set! index (+ index 1))))
          out))]))

(define (compiler-backend-emit-string-entry-into
  [text : String]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (let
    [suffix : String (compiler-backend-string-label-suffix text)]
    [data-label : String (str_cat.str-cat ".L_tl_str_data_" suffix)]
    [fat-label : String (str_cat.str-cat ".L_tl_str_" suffix)]
    [escaped : String (compiler-backend-escape-string text)]
    [len-text : String (string.int->string (string.string-length text))]
    (text_buf.append
      (text_buf.append
        (text_buf.append
          (text_buf.append
            (text_buf.append
              (text_buf.append
                (text_buf.append
                  (text_buf.append
                    (text_buf.append
                      (text_buf.append
                        (text_buf.append buf data-label)
                        ":\n    .string \"")
                      escaped)
                    "\"\n    .balign 8\n")
                  fat-label)
                ":\n    .quad ")
              data-label)
            "\n    .quad ")
          len-text)
        "\n")
      "")))

(define (compiler-backend-emit-string-entries-into
  [strings : BackendStringSeq]
  [index : i64]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (>= index strings.len)
    buf
    (compiler-backend-emit-string-entries-into
      strings
      (+ index 1)
      (compiler-backend-emit-string-entry-into
        (array-ref strings.slots index)
        buf))))

(define (compiler-backend-emit-string-rodata-into
  [strings : BackendStringSeq]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (= strings.len 0)
    buf
    (text_buf.append
      (compiler-backend-emit-string-entries-into
        strings
        0
        (text_buf.append buf "    .section .rodata\n"))
      "\n")))

(define (compiler-backend-emit-byte-directives-into
  [bytes : String]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (let
    [i : i64 0]
    [n : i64 (string.string-length bytes)]
    [col : i64 0]
    [out : text_buf.TextBuf buf]
    (begin
      (if (= n 0)
        (set! out (text_buf.append out "    .byte 0\n"))
        (while (< i n)
          (begin
            (if (= col 0)
              (set! out (text_buf.append out "    .byte "))
              (set! out (text_buf.append out ",")))
            (set!
              out
              (text_buf.append
                out
                (string.int->string
                  (compiler-backend-char-code (string.string-ref bytes i)))))
            (set! i (+ i 1))
            (set! col (+ col 1))
            (if (or (= col 16) (= i n))
              (begin
                (set! out (text_buf.append out "\n"))
                (set! col 0))
              unit))))
      out)))

(define (compiler-backend-emit-bytes-entry-into
  [bytes : String]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (let
    [data-label : String (compiler-backend-bytes-data-label bytes)]
    [fat-label : String (compiler-backend-bytes-fat-label bytes)]
    [len-text : String (string.int->string (string.string-length bytes))]
    [data-buf : text_buf.TextBuf
      (compiler-backend-emit-byte-directives-into
        bytes
        (text_buf.append
          (text_buf.append buf "    .balign 8\n")
          (str_cat.str-cat data-label ":\n" "")))]
    (text_buf.append
      (text_buf.append
        (text_buf.append
          (text_buf.append
            (text_buf.append
              (text_buf.append data-buf "    .balign 8\n")
              fat-label)
            ":\n    .quad ")
          data-label)
        "\n    .quad ")
      (str_cat.str-cat len-text "\n"))))

(define (compiler-backend-emit-bytes-entries-into
  [items : BackendStringSeq]
  [index : i64]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (>= index items.len)
    buf
    (compiler-backend-emit-bytes-entries-into
      items
      (+ index 1)
      (compiler-backend-emit-bytes-entry-into (array-ref items.slots index) buf))))

(define (compiler-backend-emit-bytes-data-into
  [items : BackendStringSeq]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (= items.len 0)
    buf
    (text_buf.append
      (compiler-backend-emit-bytes-entries-into
        items
        0
        (text_buf.append buf "    .data\n"))
      "\n")))

(define (compiler-backend-float-bits-directive
  [ty : compiler_ast_types.AstType]
  [bits : u64]) : String
  (if (compiler-backend-f64-type? ty)
    (str_cat.str-cat "    .quad " (string.int->string (cast bits : i64)) "\n")
    (str_cat.str-cat
      "    .long "
      (string.int->string
        (cast (compiler-backend-float-payload-bits ty bits) : i64))
      "\n")))

(define (compiler-backend-float-object-data
  [ty : compiler_ast_types.AstType]
  [bits : u64]) : cobj.CompilerObjectDataRecord
  (if (compiler-backend-f64-type? ty)
    (cobj.CompilerObjectDataRecord.F64 bits)
    (cobj.CompilerObjectDataRecord.F32
      (compiler-backend-float-payload-bits ty bits))))

(define (compiler-backend-emit-float-entry
  [ty : compiler_ast_types.AstType]
  [bits : u64]) : String
  (str_cat.str-cat
    (if (compiler-backend-f64-type? ty)
      "    .balign 8\n"
      "    .balign 4\n")
    (compiler-backend-float-label ty bits)
    ":\n"
    (compiler-backend-float-bits-directive ty bits)))

(define (compiler-backend-emit-float-entries-into
  [floats : BackendFloatSeq]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (let
    [slots : (__tl_dyn-array BackendFloatEntry) floats.slots]
    [count : i64 floats.len]
    [index : i64 0]
    [out : text_buf.TextBuf buf]
    (begin
      (while (< index count)
        (let
          [entry : BackendFloatEntry (array-ref slots index)]
          (begin
            (set!
              out
              (text_buf.append
                out
                (compiler-backend-emit-float-entry entry.ty entry.bits)))
            (set! index (+ index 1)))))
      out)))

(define (compiler-backend-emit-float-rodata-into
  [floats : BackendFloatSeq]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if (= floats.len 0)
    buf
    (compiler-backend-emit-float-entries-into
      floats
      (text_buf.append buf "    .section .rodata\n"))))

(define (compiler-backend-emit-f64-sign-bit-rodata-into
  [enabled : bool]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (if enabled
    (text_buf.append
      (text_buf.append
        (text_buf.append buf "    .section .rodata\n    .balign 16\n")
        (compiler-backend-f64-sign-bit-label))
      ":\n    .quad 0x8000000000000000\n    .quad 0\n")
    buf))

(define (compiler-backend-global-value-asm
  [type-segment-bases : i64]
  [ty : compiler_ast_types.AstType]
  [value : compiler_ir_types.CompilerIrValue]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (match value
    ;; A register-group global stores its value inline (16 bytes), so its
    ;; startup-initialized slot reserves two words rather than one.
    [(compiler_ir_types.CompilerIrValue.Unit)
      (if (compiler-backend-group-type? type-segment-bases program-index ty)
        (ResultCompilerBackend.Ok "    .quad 0\n    .quad 0\n")
        (ResultCompilerBackend.Ok "    .quad 0\n"))]
    [(compiler_ir_types.CompilerIrValue.I64 n)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat "    .quad " (string.int->string n) "\n"))]
    [(compiler_ir_types.CompilerIrValue.Bool b)
      (if b
        (ResultCompilerBackend.Ok "    .quad 1\n")
        (ResultCompilerBackend.Ok "    .quad 0\n"))]
    [(compiler_ir_types.CompilerIrValue.Char c)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (string.int->string (compiler-backend-char-code c))
          "\n"))]
    [(compiler_ir_types.CompilerIrValue.F64 bits)
      (ResultCompilerBackend.Ok (compiler-backend-float-bits-directive ty bits))]
    [(compiler_ir_types.CompilerIrValue.Global name)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (compiler-backend-state-user-symbol-id
            program-index.backend-state
            name)
          "\n"))]
    [(compiler_ir_types.CompilerIrValue.GlobalAddr name)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (compiler-backend-state-user-symbol-id
            program-index.backend-state
            name)
          "\n"))]
    [(compiler_ir_types.CompilerIrValue.Function name)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (compiler-backend-closure-descriptor-label
            (compiler-backend-symbol-text-index program-index name))
          "\n"))]
    [(compiler_ir_types.CompilerIrValue.String text)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (compiler-backend-string-fat-label text)
          "\n"))]
    [(compiler_ir_types.CompilerIrValue.Bytes text)
      (ResultCompilerBackend.Ok
        (str_cat.str-cat
          "    .quad "
          (compiler-backend-bytes-fat-label text)
          "\n"))]
    [_
      (ResultCompilerBackend.Err
        (box
          (compiler_diagnostic.compiler-diagnostic-at-start
            ""
            "backend: unsupported global initializer")))]))

(define (compiler-backend-runtime-global?
  [ty : compiler_ast_types.AstType]
  [value : compiler_ir_types.CompilerIrValue]) : bool
  (match value
    [(compiler_ir_types.CompilerIrValue.RuntimeGlobal _) true]
    [(compiler_ir_types.CompilerIrValue.Unit)
      (match ty
        [(compiler_ast_types.AstType.Unit) false]
        [_ true])]
    [_ false]))

(define (compiler-backend-emit-runtime-global
  [target : CompilerBackendTarget]
  [symbol : String]
  [size : i64]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (str_cat.str-cat
        "    .comm "
        symbol
        ", "
        (string.int->string size)
        ", 8\n")]
    [(CompilerBackendTarget.Windows)
      (str_cat.str-cat
        "    .comm "
        symbol
        ", "
        (string.int->string size)
        ", 3\n")]))

(define (compiler-backend-emit-global
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [global : compiler_ir_types.CompilerIrGlobal]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (match global
    [(compiler_ir_types.CompilerIrGlobal.Global name ty value)
      (let
        [symbol : String
          (compiler-backend-state-user-symbol-id
            program-index.backend-state
            name)]
        (if (compiler-backend-runtime-global? ty value)
          (ResultCompilerBackend.Ok
            (str_cat.str-cat
              ".globl "
              symbol
              "\n"
              (compiler-backend-emit-runtime-global
                target
                symbol
                (if (compiler-backend-group-type?
                  type-segment-bases
                  program-index
                  ty)
                  16
                  8))
              ""))
          (match (compiler-backend-global-value-asm
            type-segment-bases
            ty
            value
            program-index)
            [(ResultCompilerBackend.Ok value-asm)
              (ResultCompilerBackend.Ok
                (str_cat.str-cat
                  ".globl "
                  symbol
                  "\n"
                  symbol
                  ":\n"
                  value-asm
                  ""))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)])))]))

(define (compiler-backend-emit-globals-buffer-from
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [buf : text_buf.TextBuf]
  [program-index : CompilerBackendProgramIndex]
  [index : i64]) : ResultCompilerBackendBuffer
  (if (>= index globals.len)
    (ResultCompilerBackendBuffer.Ok buf)
    (match (compiler-backend-emit-global
      type-segment-bases
      target
      (compiler_ir_types.compiler-ir-global-seq-ref globals index)
      program-index)
      [(ResultCompilerBackend.Ok head)
        (compiler-backend-emit-globals-buffer-from
          type-segment-bases
          target
          globals
          (text_buf.append buf head)
          program-index
          (+ index 1))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackendBuffer.Err message)])))

(define (compiler-backend-emit-globals-buffer-into
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [buf : text_buf.TextBuf]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackendBuffer
  (compiler-backend-emit-globals-buffer-from
    type-segment-bases
    target
    globals
    buf
    program-index
    0))

(define (compiler-backend-global-init-call
  [type-segment-bases : i64]
  [name : i64]
  [init : i64]
  [ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : String
  (let
    [symbol : String
      (compiler-backend-state-user-symbol-id program-index.backend-state name)]
    [init-symbol : String
      (compiler-backend-state-user-symbol-id program-index.backend-state init)]
    (str_cat.str-cat
      "    call "
      init-symbol
      "\n"
      (if (compiler-backend-group-type? type-segment-bases program-index ty)
        ;; A register-group init returns word0:word1 in %rax:%rdx; store
        ;; both into the inline 16-byte global slot.
        (str_cat.str-cat
          "    movq %rax, "
          symbol
          "(%rip)\n    movq %rdx, "
          symbol
          "+8(%rip)\n"
          "")
        (if (compiler-backend-float-type? ty)
          (str_cat.str-cat
            "    "
            (compiler-backend-float-move ty)
            " %xmm0, "
            symbol
            "(%rip)\n")
          (str_cat.str-cat "    movq %rax, " symbol "(%rip)\n")))
      "")))

(define (compiler-backend-global-initializers-from
  [type-segment-bases : i64]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [program-index : CompilerBackendProgramIndex]
  [index : i64]) : String
  (if (>= index globals.len)
    ""
    (match (compiler_ir_types.compiler-ir-global-seq-ref globals index)
      [(compiler_ir_types.CompilerIrGlobal.Global name ty value)
        (str_cat.str-cat
          (match value
            [(compiler_ir_types.CompilerIrValue.RuntimeGlobal init)
              (compiler-backend-global-init-call
                type-segment-bases
                name
                init
                ty
                program-index)]
            [_ ""])
          (compiler-backend-global-initializers-from
            type-segment-bases
            globals
            program-index
            (+ index 1)))])))

(define (compiler-backend-global-initializers
  [type-segment-bases : i64]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [program-index : CompilerBackendProgramIndex]) : String
  (compiler-backend-global-initializers-from
    type-segment-bases
    globals
    program-index
    0))

(define (compiler-backend-function-list-defines?
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [name : i64]) : bool
  (match functions
    [(compiler_ir_types.CompilerIrFunctionList.Nil) false]
    [(compiler_ir_types.CompilerIrFunctionList.Cons func rest)
      (match func
        [(compiler_ir_types.CompilerIrFunction.Function func-name _ _ _ _)
          (if (compiler_ir_types.compiler-ir-symbol-eq? func-name name)
            true
            (compiler-backend-function-list-defines? (__tl-box-place rest) name))])]
    [(compiler_ir_types.CompilerIrFunctionList.Array seq)
      (compiler-backend-function-seq-defines? seq name 0)]))

(define (compiler-backend-function-seq-defines?
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [name : i64]
  [index : i64]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-function-seq-count functions))
    false
    (match (compiler_ir_types.compiler-ir-function-seq-ref functions index)
      [(compiler_ir_types.CompilerIrFunction.Function func-name _ _ _ _)
        (if (compiler_ir_types.compiler-ir-symbol-eq? func-name name)
          true
          (compiler-backend-function-seq-defines? functions name (+ index 1)))])))

(define (compiler-backend-runtime-prelude-helper-function?
  [name : String]
  [helper : String]) : bool
  (and
    (string.eq (compiler-backend-symbol-leaf name) helper)
    (compiler-backend-stdlib-runtime-function-name? name)))

(define (compiler-backend-function-list-defines-runtime-prelude-helper?
  [backend-state : CompilerBackendState]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [helper : String]) : bool
  (match functions
    [(compiler_ir_types.CompilerIrFunctionList.Nil) false]
    [(compiler_ir_types.CompilerIrFunctionList.Cons func rest)
      (match func
        [(compiler_ir_types.CompilerIrFunction.Function name _ _ _ _)
          (if (compiler-backend-runtime-prelude-helper-function?
            (compiler-backend-symbol-text-state backend-state name)
            helper)
            true
            (compiler-backend-function-list-defines-runtime-prelude-helper?
              backend-state
              (__tl-box-place rest)
              helper))])]
    [(compiler_ir_types.CompilerIrFunctionList.Array seq)
      (compiler-backend-function-seq-defines-runtime-prelude-helper?
        backend-state
        seq
        helper
        0)]))

(define (compiler-backend-function-seq-defines-runtime-prelude-helper?
  [backend-state : CompilerBackendState]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [helper : String]
  [index : i64]) : bool
  (if (>= index (compiler_ir_types.compiler-ir-function-seq-count functions))
    false
    (match (compiler_ir_types.compiler-ir-function-seq-ref functions index)
      [(compiler_ir_types.CompilerIrFunction.Function name _ _ _ _)
        (if (compiler-backend-runtime-prelude-helper-function?
          (compiler-backend-symbol-text-state backend-state name)
          helper)
          true
          (compiler-backend-function-seq-defines-runtime-prelude-helper?
            backend-state
            functions
            helper
            (+ index 1)))])))

(define (compiler-backend-runtime-index-empty) : CompilerBackendRuntimeIndex
  (CompilerBackendRuntimeIndex
    (backend_i64_i64_map.with-capacity 256)
    (backend_i64_i64_map.with-capacity 256)
    (backend_i64_i64_map.with-capacity 256)
    -1
    false))

(define (compiler-backend-runtime-index-defines?
  [index : CompilerBackendRuntimeIndex]
  [name-id : i64]) : bool
  (backend_i64_i64_map.contains? (& index.defines) name-id))

(define (compiler-backend-runtime-index-extern?
  [index : CompilerBackendRuntimeIndex]
  [name-id : i64]) : bool
  (backend_i64_i64_map.contains? (& index.externs) name-id))

(define (compiler-backend-runtime-index-calls?
  [index : CompilerBackendRuntimeIndex]
  [name-id : i64]) : bool
  (backend_i64_i64_map.contains? (& index.calls) name-id))

(define (compiler-backend-runtime-index-add-define
  [index : CompilerBackendRuntimeIndex (:consume)]
  [name-id : i64]) : CompilerBackendRuntimeIndex
  (let
    [defines : backend_i64_i64_map.Map index.defines]
    (begin
      (backend_i64_i64_map.insert-ref! (&mut defines) name-id 1)
      (CompilerBackendRuntimeIndex
        defines
        index.externs
        index.calls
        index.tlci-macro-entry-call-id
        index.startup-profile))))

(define (compiler-backend-runtime-index-add-extern-name
  [index : CompilerBackendRuntimeIndex (:consume)]
  [name-id : i64]) : CompilerBackendRuntimeIndex
  (let
    [externs : backend_i64_i64_map.Map index.externs]
    (begin
      (backend_i64_i64_map.insert-ref! (&mut externs) name-id 1)
      (CompilerBackendRuntimeIndex
        index.defines
        externs
        index.calls
        index.tlci-macro-entry-call-id
        index.startup-profile))))

(define (compiler-backend-runtime-index-add-call
  [index : CompilerBackendRuntimeIndex (:consume)]
  [name-id : i64]) : CompilerBackendRuntimeIndex
  (let
    [calls : backend_i64_i64_map.Map index.calls]
    (begin
      (backend_i64_i64_map.insert-ref! (&mut calls) name-id 1)
      (CompilerBackendRuntimeIndex
        index.defines
        index.externs
        calls
        index.tlci-macro-entry-call-id
        index.startup-profile))))

(define (compiler-backend-runtime-index-with-extern-role
  [index : CompilerBackendRuntimeIndex]
  [call-id : i64]
  [link-id : i64]) : CompilerBackendRuntimeIndex
  (CompilerBackendRuntimeIndex
    index.defines
    index.externs
    index.calls
    (if (cbi.compiler-builtin-backend-tlci-call-macro-entry-id? link-id)
      call-id
      index.tlci-macro-entry-call-id)
    index.startup-profile))

(define (compiler-backend-runtime-index-with-startup-profile-role
  [index : CompilerBackendRuntimeIndex]
  [link-id : i64]
  [backend-state : CompilerBackendState]) : CompilerBackendRuntimeIndex
  (if (string.eq
    (compiler-backend-symbol-text-state backend-state link-id)
    "tl_startup_profile_process_entry_tick")
    (CompilerBackendRuntimeIndex
      index.defines
      index.externs
      index.calls
      index.tlci-macro-entry-call-id
      true)
    index))

(define (compiler-backend-runtime-index-instr
  [index : CompilerBackendRuntimeIndex]
  [instr : compiler_ir_types.CompilerIrInstr]) : CompilerBackendRuntimeIndex
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Call _ call-name _ _)
      (compiler-backend-runtime-index-add-call index call-name)]
    [(compiler_ir_types.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [call-name (__tl-project-field (__tl-box-place payload-box) name)]
        (compiler-backend-runtime-index-add-call index call-name))]
    [(compiler_ir_types.CompilerIrInstr.TailCall call-name _ _)
      (compiler-backend-runtime-index-add-call index call-name)]
    [_ index]))

(define (compiler-backend-runtime-index-instr-seq
  [index : CompilerBackendRuntimeIndex (:consume)]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]) : CompilerBackendRuntimeIndex
  (let
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr) instrs.slots]
    [count : i64 instrs.len]
    [i : i64 0]
    [out : CompilerBackendRuntimeIndex index]
    (begin
      (while (< i count)
        (begin
          (set!
            out
            (compiler-backend-runtime-index-instr out (array-ref slots i)))
          (set! i (+ i 1))))
      out)))

(define (compiler-backend-runtime-index-blocks
  [index : CompilerBackendRuntimeIndex]
  [blocks : compiler_ir_types.CompilerIrBlockList]) : CompilerBackendRuntimeIndex
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil) index]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (compiler-backend-runtime-index-blocks
            (compiler-backend-runtime-index-instr-seq index instrs)
            (__tl-box-place rest))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-runtime-index-block-seq index seq 0)]))

(define (compiler-backend-runtime-index-block-seq
  [index : CompilerBackendRuntimeIndex]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [seq-index : i64]) : CompilerBackendRuntimeIndex
  (if (>= seq-index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    index
    (match (compiler_ir_types.compiler-ir-block-seq-ref blocks seq-index)
      [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
        (compiler-backend-runtime-index-block-seq
          (compiler-backend-runtime-index-instr-seq index instrs)
          blocks
          (+ seq-index 1))])))

(define (compiler-backend-runtime-index-functions
  [index : CompilerBackendRuntimeIndex]
  [functions : compiler_ir_types.CompilerIrFunctionList]) : CompilerBackendRuntimeIndex
  (match functions
    [(compiler_ir_types.CompilerIrFunctionList.Nil) index]
    [(compiler_ir_types.CompilerIrFunctionList.Cons func rest)
      (match func
        [(compiler_ir_types.CompilerIrFunction.Function name _ _ _ blocks)
          (compiler-backend-runtime-index-functions
            (compiler-backend-runtime-index-blocks
              (compiler-backend-runtime-index-add-define index name)
              blocks)
            (__tl-box-place rest))])]
    [(compiler_ir_types.CompilerIrFunctionList.Array seq)
      (compiler-backend-runtime-index-function-seq index seq 0)]))

(define (compiler-backend-runtime-index-function-seq
  [index : CompilerBackendRuntimeIndex]
  [functions : compiler_ir_types.CompilerIrFunctionSeq]
  [seq-index : i64]) : CompilerBackendRuntimeIndex
  (if (>=
    seq-index
    (compiler_ir_types.compiler-ir-function-seq-count functions))
    index
    (match (compiler_ir_types.compiler-ir-function-seq-ref functions seq-index)
      [(compiler_ir_types.CompilerIrFunction.Function name _ _ _ blocks)
        (compiler-backend-runtime-index-function-seq
          (compiler-backend-runtime-index-blocks
            (compiler-backend-runtime-index-add-define index name)
            blocks)
          functions
          (+ seq-index 1))])))

(define (compiler-backend-runtime-index-externs
  [backend-state : CompilerBackendState]
  [index : CompilerBackendRuntimeIndex]
  [externs : compiler_ir_types.CompilerIrExternList]) : CompilerBackendRuntimeIndex
  (match externs
    [(compiler_ir_types.CompilerIrExternList.Nil) index]
    [(compiler_ir_types.CompilerIrExternList.Cons item rest)
      (match item
        [(compiler_ir_types.CompilerIrExtern.Extern
            name-id
            source-name-id
            _
            _
            _
            link-symbol
            _
            provided)
          (let
            [with-startup-role : CompilerBackendRuntimeIndex
              (compiler-backend-runtime-index-with-startup-profile-role
                index
                link-symbol
                backend-state)]
            (if provided
              (compiler-backend-runtime-index-externs
                backend-state
                with-startup-role
                (__tl-box-place rest))
              (let
                [with-names : CompilerBackendRuntimeIndex
                  (compiler-backend-runtime-index-add-extern-name
                    (compiler-backend-runtime-index-add-extern-name
                      (compiler-backend-runtime-index-add-extern-name
                        with-startup-role
                        name-id)
                      source-name-id)
                    link-symbol)]
                [with-runtime-role : CompilerBackendRuntimeIndex
                  (compiler-backend-runtime-index-with-extern-role
                    with-names
                    name-id
                    link-symbol)]
                (compiler-backend-runtime-index-externs
                  backend-state
                  with-runtime-role
                  (__tl-box-place rest)))))])]
    [(compiler_ir_types.CompilerIrExternList.Array seq)
      (compiler-backend-runtime-index-externs
        backend-state
        index
        (compiler_ir_types.compiler-ir-extern-seq-to-list seq))]))

(define (compiler-backend-runtime-index-arena-debug-call-links
  [index : CompilerBackendRuntimeIndex (:consume)]
  [externs : compiler_ir_types.CompilerIrExternList]) : CompilerBackendRuntimeIndex
  (match externs
    [(compiler_ir_types.CompilerIrExternList.Nil) index]
    [(compiler_ir_types.CompilerIrExternList.Cons item rest)
      (match item
        [(compiler_ir_types.CompilerIrExtern.Extern
            name-id
            source-name-id
            _
            _
            _
            link-symbol
            _
            _)
          (compiler-backend-runtime-index-arena-debug-call-links
            (if (and
              (cbi.compiler-builtin-backend-runtime-arena-debug-id? link-symbol)
              (or
                (compiler-backend-runtime-index-calls? index name-id)
                (compiler-backend-runtime-index-calls? index source-name-id)))
              (compiler-backend-runtime-index-add-call index link-symbol)
              index)
            (__tl-box-place rest))])]
    [(compiler_ir_types.CompilerIrExternList.Array seq)
      (compiler-backend-runtime-index-arena-debug-call-links
        index
        (compiler_ir_types.compiler-ir-extern-seq-to-list seq))]))

(define (compiler-backend-runtime-index
  [backend-state : CompilerBackendState]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]) : CompilerBackendRuntimeIndex
  (compiler-backend-runtime-index-arena-debug-call-links
    (compiler-backend-runtime-index-functions
      (compiler-backend-runtime-index-externs
        backend-state
        (compiler-backend-runtime-index-empty)
        externs)
      functions)
    externs))

(define (compiler-backend-runtime-helper-core-id? [name-id : i64]) : bool
  ;; The allocator/arena/TLS substrate is irreducible backend core runtime.
  ;; It bootstraps ordinary TypeLisp allocation, owns the
  ;; `tl_current_arena` slot, and must remain import-free/allocation-free while
  ;; acquiring and releasing arena pages. Linux page ownership is the
  ;; mmap/munmap sequence in `tl_alloc`, `tl_arena_make`, `tl_arena_destroy`,
  ;; and `tl_region_reset`; Windows uses kernel32 VirtualAlloc/VirtualFree in
  ;; the same allocation/release paths. `tl_region_mark`, `tl_arena_current`,
  ;; `tl_arena_set`, `tl_arena_poison_enable`, and the thread entry helpers
  ;; read or update backend runtime TLS state.
  ;; tl_oob_abort / tl_div_abort / tl_shift_abort live in the runtime prelude
  ;; (stdlib/runtime.tl) and are provided by export-symbol, so they are not
  ;; backend-owned runtime helpers (keeping them here would make the export
  ;; collide with a "known runtime symbol").
  (cbi.compiler-builtin-backend-runtime-core-id? name-id))

;; Stdlib modules depend on these backend runtime shims for
;; unavoidable profile operations.
(define (compiler-backend-runtime-helper-stdlib-ffi-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-backend-runtime-stdlib-ffi-id? name-id))

;; Runtime helpers whose implementation and fixed export symbols are owned by
;; the TypeLisp stdlib prelude.
(define (compiler-backend-runtime-helper-stdlib-type-lisp-id? [name-id : i64]) : bool
  (cbi.compiler-builtin-backend-runtime-stdlib-type-lisp-id? name-id))

(define (compiler-backend-runtime-helper-owner-id [name-id : i64]) : CompilerBackendRuntimeHelperOwner
  (cond
    [(compiler-backend-runtime-helper-core-id? name-id)
      (CompilerBackendRuntimeHelperOwner.Core)]
    [(compiler-backend-runtime-helper-stdlib-ffi-id? name-id)
      (CompilerBackendRuntimeHelperOwner.StdlibFfi)]
    [(compiler-backend-runtime-helper-stdlib-type-lisp-id? name-id)
      (CompilerBackendRuntimeHelperOwner.StdlibTypeLisp)]
    [else (CompilerBackendRuntimeHelperOwner.Unknown)]))

(define (compiler-backend-runtime-helper-known-id? [name-id : i64]) : bool
  (match (compiler-backend-runtime-helper-owner-id name-id)
    [(CompilerBackendRuntimeHelperOwner.Unknown) false]
    [_ true]))

;; First-class arena runtime helpers and the arena poison debug toggle
;; are always emitted, so they are provided runtime symbols (resolve to
;; their raw names, not the mangled `_tl_tl_arena_*`).
(define (compiler-backend-plan-provides-id?
  [plan : CompilerBackendRuntimePlan]
  [name-id : i64]) : bool
  (or
    (cbi.compiler-builtin-backend-runtime-always-provided-id? name-id)
    (cbi.compiler-builtin-backend-runtime-always-provided-tail-id? name-id)
    (compiler-backend-plan-provides-rest-id? plan name-id)))

(define (compiler-backend-plan-provides-rest-id?
  [plan : CompilerBackendRuntimePlan]
  [name-id : i64]) : bool
  (match plan
    [(CompilerBackendRuntimePlan.WithScratch base _)
      (compiler-backend-plan-provides-rest-id? (__tl-box-place base) name-id)]
    [(CompilerBackendRuntimePlan.Plan
        alloc
        substring
        str-view
        concat
        provides-int-to-string
        region-mark
        region-reset
        provides-tail)
      (or
        (backend-or8
          (and alloc (cbi.compiler-builtin-backend-tl-alloc-id? name-id))
          (and
            region-mark
            (cbi.compiler-builtin-backend-tl-region-mark-id? name-id))
          (and
            region-reset
            (cbi.compiler-builtin-backend-tl-region-reset-id? name-id))
          (and
            substring
            (cbi.compiler-builtin-backend-tl-substring-id? name-id))
          (and str-view (cbi.compiler-builtin-backend-tl-str-view-id? name-id))
          (and concat (cbi.compiler-builtin-backend-runtime-concat-id? name-id))
          (and
            provides-int-to-string
            (cbi.compiler-builtin-backend-tl-int-to-string-id? name-id))
          (and
            (compiler-backend-runtime-tail-profile? provides-tail)
            (cbi.compiler-builtin-backend-runtime-profile-id? name-id)))
        (and
          (compiler-backend-runtime-tail-arena-debug? provides-tail)
          (cbi.compiler-builtin-backend-runtime-arena-debug-id? name-id)))]))

(define (compiler-backend-runtime-plan-with-index-for-with-backend-state
  [backend-state : CompilerBackendState]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]) : ResultBackendRuntimePlanWithIndex
  (let
    [index : CompilerBackendRuntimeIndex
      (compiler-backend-runtime-index backend-state functions externs)]
    [defines-alloc : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-alloc)]
    [defines-substring : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-substring)]
    [defines-str-view : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-str-view)]
    [defines-concat : bool
      (backend-or4
        (compiler-backend-runtime-index-defines?
          index
          cbi.compiler-builtin-id-tl-string-concat)
        (compiler-backend-runtime-index-defines?
          index
          cbi.compiler-builtin-id-tl-string-concat3)
        (compiler-backend-runtime-index-defines?
          index
          cbi.compiler-builtin-id-tl-string-concat4)
        (compiler-backend-runtime-index-defines?
          index
          cbi.compiler-builtin-id-tl-string-concat5))]
    [defines-int-to-string : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-int-to-string)]
    [provides-substring : bool
      (compiler-backend-function-list-defines-runtime-prelude-helper?
        backend-state
        functions
        "substring")]
    [provides-str-view : bool
      (compiler-backend-function-list-defines-runtime-prelude-helper?
        backend-state
        functions
        "str-view")]
    [provides-concat : bool
      (backend-or4
        (compiler-backend-function-list-defines-runtime-prelude-helper?
          backend-state
          functions
          "string-concat")
        (compiler-backend-function-list-defines-runtime-prelude-helper?
          backend-state
          functions
          "string-concat3")
        (compiler-backend-function-list-defines-runtime-prelude-helper?
          backend-state
          functions
          "string-concat4")
        (compiler-backend-function-list-defines-runtime-prelude-helper?
          backend-state
          functions
          "string-concat5"))]
    [provides-int-to-string : bool
      (compiler-backend-function-list-defines-runtime-prelude-helper?
        backend-state
        functions
        "int-to-string")]
    [defines-region-mark : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-region-mark)]
    [defines-region-reset : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-region-reset)]
    [defines-profile-alloc-total : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-total)]
    [defines-profile-alloc-live : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-live)]
    [defines-profile-alloc-peak : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-peak)]
    [defines-profile-alloc-reset-peak : bool
      (compiler-backend-runtime-index-defines?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-reset-peak)]
    [extern-region-mark : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-region-mark)]
    [extern-region-reset : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-region-reset)]
    [extern-profile-alloc-total : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-total)]
    [extern-profile-alloc-live : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-live)]
    [extern-profile-alloc-peak : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-peak)]
    [extern-profile-alloc-reset-peak : bool
      (compiler-backend-runtime-index-extern?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-reset-peak)]
    [calls-alloc : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-alloc)]
    [calls-substring : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-substring)]
    [calls-str-view : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-str-view)]
    [calls-concat : bool
      (backend-or4
        (compiler-backend-runtime-index-calls?
          index
          cbi.compiler-builtin-id-tl-string-concat)
        (compiler-backend-runtime-index-calls?
          index
          cbi.compiler-builtin-id-tl-string-concat3)
        (compiler-backend-runtime-index-calls?
          index
          cbi.compiler-builtin-id-tl-string-concat4)
        (compiler-backend-runtime-index-calls?
          index
          cbi.compiler-builtin-id-tl-string-concat5))]
    [calls-int-to-string : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-int-to-string)]
    [calls-region-mark : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-region-mark)]
    [calls-region-reset : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-region-reset)]
    [calls-profile-alloc-total : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-total)]
    [calls-profile-alloc-live : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-live)]
    [calls-profile-alloc-peak : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-peak)]
    [calls-profile-alloc-reset-peak : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-profile-alloc-reset-peak)]
    [calls-arena-debug-protect : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-arena-debug-protect-never-reset)]
    [calls-arena-debug-pool-install : bool
      (compiler-backend-runtime-index-calls?
        index
        cbi.compiler-builtin-id-tl-arena-debug-assert-pool-install)]
    ;; Prelude string helpers keep fixed export symbols for validation and call
    ;; spelling, but their TypeLisp bodies expose allocator calls directly in
    ;; the runtime index. The plan therefore retains only these symbol facts;
    ;; only a real `tl_alloc` call enables allocator asm.
    [needs-substring : bool
      (or provides-substring (and (not defines-substring) calls-substring))]
    [needs-str-view : bool
      (or provides-str-view (and (not defines-str-view) calls-str-view))]
    [needs-concat : bool
      (or provides-concat (and (not defines-concat) calls-concat))]
    [needs-int-to-string : bool
      (or
        provides-int-to-string
        (and (not defines-int-to-string) calls-int-to-string))]
    [needs-alloc : bool (and (not defines-alloc) calls-alloc)]
    [needs-region-mark : bool
      (and (not defines-region-mark) (or extern-region-mark calls-region-mark))]
    [needs-region-reset : bool
      (and
        (not defines-region-reset)
        (or extern-region-reset calls-region-reset))]
    [needs-profile : bool
      (backend-or4
        (and
          (not defines-profile-alloc-total)
          (or extern-profile-alloc-total calls-profile-alloc-total))
        (and
          (not defines-profile-alloc-live)
          (or extern-profile-alloc-live calls-profile-alloc-live))
        (and
          (not defines-profile-alloc-peak)
          (or extern-profile-alloc-peak calls-profile-alloc-peak))
        (and
          (not defines-profile-alloc-reset-peak)
          (or extern-profile-alloc-reset-peak calls-profile-alloc-reset-peak)))]
    [needs-arena-debug : bool
      (or calls-arena-debug-protect calls-arena-debug-pool-install)]
    [needs-tlci-macro-entry : bool
      (let
        [call-id : i64 index.tlci-macro-entry-call-id]
        (and
          (>= call-id 0)
          (compiler-backend-runtime-index-calls? index call-id)))]
    [needs-startup-profile : bool index.startup-profile]
    (ResultBackendRuntimePlanWithIndex.Ok
      (CompilerBackendRuntimePlanWithIndex
        (CompilerBackendRuntimePlan.Plan
          needs-alloc
          needs-substring
          needs-str-view
          needs-concat
          needs-int-to-string
          needs-region-mark
          needs-region-reset
          (CompilerBackendRuntimeTailPlan
            needs-profile
            needs-tlci-macro-entry
            needs-arena-debug
            needs-startup-profile))
        index))))

(define (compiler-backend-runtime-plan-for-with-backend-state
  [backend-state : CompilerBackendState]
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]) : ResultBackendRuntimePlan
  (match (compiler-backend-runtime-plan-with-index-for-with-backend-state
    backend-state
    functions
    externs)
    [(ResultBackendRuntimePlanWithIndex.Ok planned)
      (ResultBackendRuntimePlan.Ok planned.plan)]
    [(ResultBackendRuntimePlanWithIndex.Err message)
      (ResultBackendRuntimePlan.Err message)]))

(define (compiler-backend-runtime-plan-for
  [functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]) : ResultBackendRuntimePlan
  (compiler-backend-runtime-plan-for-with-backend-state
    (compiler-backend-state-new (ci.intern-compat-state-capture-active))
    functions
    externs))

(define (compiler-backend-runtime-plan-with-backend-state
  [backend-state : CompilerBackendState]
  [program : compiler_ir_types.CompilerIrProgram]) : ResultBackendRuntimePlan
  (begin
    ;; Seed builtin/runtime ids before scratch-backed per-function emission. The
    ;; runtime-plan id predicates are then lookup-only in scratch arenas.
    (cbi.compiler-builtin-refresh!)
    (match program
      [(compiler_ir_types.CompilerIrProgram.Program _ functions externs)
        (compiler-backend-runtime-plan-for-with-backend-state
          backend-state
          functions
          externs)])))

(define (compiler-backend-runtime-plan
  [program : compiler_ir_types.CompilerIrProgram]) : ResultBackendRuntimePlan
  (compiler-backend-runtime-plan-with-backend-state
    (compiler-backend-state-new (ci.intern-compat-state-capture-active))
    program))

(define (compiler-backend-runtime-plan-with-index-with-backend-state
  [backend-state : CompilerBackendState]
  [program : compiler_ir_types.CompilerIrProgram]) : ResultBackendRuntimePlanWithIndex
  (begin
    ;; Seed builtin/runtime ids before scratch-backed per-function emission. The
    ;; runtime-plan id predicates are then lookup-only in scratch arenas.
    (cbi.compiler-builtin-refresh!)
    (match program
      [(compiler_ir_types.CompilerIrProgram.Program _ functions externs)
        (compiler-backend-runtime-plan-with-index-for-with-backend-state
          backend-state
          functions
          externs)])))

(define (compiler-backend-extern-symbol-referenced?
  [runtime-index : CompilerBackendRuntimeIndex]
  [referenced-functions : BackendSymbolSeq]
  [extern-name-id : i64]
  [link-symbol-id : i64]) : bool
  (let
    [foreign-link-symbol : bool
      (and
        (not (= extern-name-id link-symbol-id))
        (not (compiler-backend-runtime-helper-known-id? extern-name-id))
        (not (compiler-backend-runtime-helper-known-id? link-symbol-id)))]
    (or
      foreign-link-symbol
      (backend-or4
        (compiler-backend-runtime-index-calls? runtime-index extern-name-id)
        (compiler-backend-runtime-index-calls? runtime-index link-symbol-id)
        (compiler-backend-symbol-list-contains-id?
          referenced-functions
          extern-name-id)
        false)
      false)))

(define (compiler-backend-emit-externs-into
  [backend-state : CompilerBackendState]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [runtime-index : CompilerBackendRuntimeIndex]
  [referenced-functions : BackendSymbolSeq]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (match externs
    [(compiler_ir_types.CompilerIrExternList.Nil) buf]
    [(compiler_ir_types.CompilerIrExternList.Cons item rest)
      (match item
        [(compiler_ir_types.CompilerIrExtern.Extern
            name-id
            _
            name
            _
            _
            link-symbol-id
            _
            provided)
          (if (and
            (compiler-backend-emits-extern-symbol?
              backend-state
              name-id
              link-symbol-id
              provided
              plan)
            (compiler-backend-extern-symbol-referenced?
              runtime-index
              referenced-functions
              name-id
              link-symbol-id))
            (compiler-backend-emit-externs-into
              backend-state
              (__tl-box-place rest)
              plan
              runtime-index
              referenced-functions
              (text_buf.append
                (text_buf.append buf ".extern ")
                (str_cat.str-cat
                  (compiler-backend-link-symbol-id
                    link-symbol-id
                    plan
                    backend-state)
                  "\n"
                  "")))
            (compiler-backend-emit-externs-into
              backend-state
              (__tl-box-place rest)
              plan
              runtime-index
              referenced-functions
              buf))])]
    [(compiler_ir_types.CompilerIrExternList.Array seq)
      (compiler-backend-emit-externs-into
        backend-state
        (compiler_ir_types.compiler-ir-extern-seq-to-list seq)
        plan
        runtime-index
        referenced-functions
        buf)]))

;; `tl_current_arena` is the stable first-segment root handle shared by tl_alloc,
;; the region runtime, and the first-class arena builtins. Physical growth heads
;; are reached through root+56 and never replace this public identity. It is a
;; per-thread active-arena slot: Linux uses local-exec ELF TLS; Windows stores
;; the root in the TEB arbitrary-user slot (GS:0x28). Like the arena
;; primitives, the runtime lives in exactly ONE object per executable (the entry
;; object, `emit-entry=true`); library/dependency objects (`emit-entry=false`)
;; emit none of the runtime and reference the Linux TLS slot as an extern.
;; Runtime planning and indexing stay in this module. Emission consumes one
;; narrow immutable recipe and selects a platform leaf once for each composed
;; data, function, and extern fragment.
(define (compiler-backend-runtime-features [plan : CompilerBackendRuntimePlan]) : runtime_common.CompilerBackendRuntimeFeatures
  (begin
    (cbi.compiler-builtin-refresh!)
    (match plan
      [(CompilerBackendRuntimePlan.WithScratch base _)
        (compiler-backend-runtime-features (__tl-box-place base))]
      [(CompilerBackendRuntimePlan.Plan
          alloc
          _
          _
          _
          _
          region-mark
          region-reset
          tail-plan)
        (let
          [write-exit : bool
            (or
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-alloc)
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-oob-abort)
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-abort-label)
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-div-abort)
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-shift-abort)
              (compiler-backend-plan-provides-id?
                plan
                cbi.compiler-builtin-id-tl-region-reset))]
          (runtime_common.CompilerBackendRuntimeFeatures
            alloc
            region-mark
            region-reset
            (compiler-backend-runtime-tail-arena-debug? tail-plan)
            (compiler-backend-runtime-tail-profile? tail-plan)
            (compiler-backend-runtime-tail-tlci-macro-entry? tail-plan)
            write-exit
            (compiler-backend-runtime-tail-startup-profile? tail-plan)))])))

(define (compiler-backend-current-arena-load
  [target : CompilerBackendTarget]
  [dst : String]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (runtime_linux.compiler-backend-current-arena-load dst)]
    [(CompilerBackendTarget.Windows)
      (runtime_windows.compiler-backend-current-arena-load dst)]))

(define (compiler-backend-current-arena-store
  [target : CompilerBackendTarget]
  [src : String]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (runtime_linux.compiler-backend-current-arena-store src)]
    [(CompilerBackendTarget.Windows)
      (runtime_windows.compiler-backend-current-arena-store src)]))

(define (compiler-backend-runtime-data-for-target
  [target : CompilerBackendTarget]
  [features : (& features runtime_common.CompilerBackendRuntimeFeatures)]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (runtime_linux.compiler-backend-runtime-data features)]
    [(CompilerBackendTarget.Windows)
      (runtime_windows.compiler-backend-runtime-data features)]))

(define (compiler-backend-runtime-functions-for-target
  [target : CompilerBackendTarget]
  [features : (& features runtime_common.CompilerBackendRuntimeFeatures)]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (runtime_linux.compiler-backend-runtime-functions features)]
    [(CompilerBackendTarget.Windows)
      (runtime_windows.compiler-backend-runtime-functions features)]))

(define (compiler-backend-runtime-externs-for-target
  [target : CompilerBackendTarget]
  [features : (& features runtime_common.CompilerBackendRuntimeFeatures)]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (runtime_linux.compiler-backend-runtime-externs features)]
    [(CompilerBackendTarget.Windows)
      (runtime_windows.compiler-backend-runtime-externs features)]))

;; Argument register for call arg `idx` under the target's calling convention.
;; System V (Linux) uses rdi/rsi/rdx/rcx/r8/r9;
;; Windows x64 passes the first four integer/pointer args in rcx/rdx/r8/r9.
(define (compiler-backend-target-arg-reg
  [target : CompilerBackendTarget]
  [idx : i64]) : ResultBackendReg
  (compiler-backend-result-reg
    (compiler_abi.compiler-abi-gp-arg-register
      (compiler-backend-target-abi target)
      idx)
    "backend: too many call args"))

(define (compiler-backend-target-float-arg-reg
  [target : CompilerBackendTarget]
  [idx : i64]) : ResultBackendReg
  (compiler-backend-result-reg
    (compiler_abi.compiler-abi-float-arg-register
      (compiler-backend-target-abi target)
      idx)
    "backend: too many call args"))

(define (compiler-backend-call-bank-index
  [target : CompilerBackendTarget]
  [bank-idx : i64]
  [position : i64]) : i64
  (if (compiler_abi.compiler-abi-arg-banks-independent?
    (compiler-backend-target-abi target))
    bank-idx
    position))

(define (compiler-backend-target-arg-reg-for-banks
  [target : CompilerBackendTarget]
  [int-idx : i64]
  [position : i64]) : ResultBackendReg
  (compiler-backend-target-arg-reg
    target
    (compiler-backend-call-bank-index target int-idx position)))

(define (compiler-backend-target-float-arg-reg-for-banks
  [target : CompilerBackendTarget]
  [float-idx : i64]
  [position : i64]) : ResultBackendReg
  (compiler-backend-target-float-arg-reg
    target
    (compiler-backend-call-bank-index target float-idx position)))

;; Caller-reserved outgoing shadow space in bytes: none on System V, 32 on
;; Windows x64.
(define (compiler-backend-outgoing-shadow-space
  [target : CompilerBackendTarget]) : i64
  (compiler_abi.compiler-abi-outgoing-shadow-space
    (compiler-backend-target-abi target)))

;; Program entry section and global symbol. Freestanding Linux links the
;; backend-owned `_tl_start`; CRT entry mode links `main` through the C runtime.
;; Windows links `main` through the CRT.
(define (compiler-backend-target-linux? [target : CompilerBackendTarget]) : bool
  (compiler_abi.compiler-abi-linux? (compiler-backend-target-abi target)))

(define (compiler-backend-target-entry-text-with-crt
  [target : CompilerBackendTarget]
  [emit-entry : bool]
  [crt-entry : bool]) : String
  (if emit-entry
    (match target
      [(CompilerBackendTarget.Linux)
        (if crt-entry
          ".text\n.globl main\n"
          ".text\n.globl _tl_start\n")]
      [(CompilerBackendTarget.Windows) ".text\n.globl main\n"])
    ".text\n"))

(define (compiler-backend-target-entry-text
  [target : CompilerBackendTarget]
  [emit-entry : bool]) : String
  (compiler-backend-target-entry-text-with-crt target emit-entry false))

;; `_tl_start` is the freestanding Linux entry and the only function this
;; module emits outside compiler-backend-emit-function, so it carries the same
;; ELF symbol typing (see compiler-backend-emit-function-type-directive). This
;; text is emitted only from the Linux arm of
;; compiler-backend-entry-for-target-with-crt, so neither needs a target test.
;; The label line itself is untouched: scripts detect the freestanding entry by
;; grepping for `^_tl_start:$`.
;;
;; The size closes the entry at the exit syscall rather than after the
;; mmap-failure stub, because that stub re-enters `.text` by name. In a debug
;; build the entry itself sits in `.text.typelisp_runtime` (the debug trailer
;; parks the runtime there), and `. - _tl_start` spanning two sections is not
;; an assemble-time constant.
(define compiler-backend-entry-type-directive : String
  "    .type _tl_start,@function\n")
(define compiler-backend-entry-size-directive : String
  "    .size _tl_start, . - _tl_start\n")

;; Run main on a fresh 1 GiB mmap'd stack, then exit(main()). The compiler
;; recurses far deeper than the default 8 MiB stack rlimit allows ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â type-directed
;; `clone` of large IR values during arena escapes is the worst case ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â so
;; a self-hosted compiler segfaults compiling a large program on the default
;; stack. argc/argv/envp are already captured into globals before this runs, so
;; switching %rsp is safe (main reads them from globals, not the stack). Do not
;; silently continue on the original small stack when mmap fails: report the
;; failed reservation and exit 134 so a runner constraint cannot masquerade as
;; an unrelated compiler SIGSEGV.
(define (compiler-backend-entry-call-main) : String
  (str_cat.str-cat
    "    movq $0x40000000, %rsi
    xorq %rdi, %rdi
    movq $3, %rdx
    movq $0x22, %r10
    movq $-1, %r8
    xorq %r9, %r9
    movq $9, %rax
    syscall
    testq %rax, %rax
    js .L_tl_main_stack_abort
    addq $0x40000000, %rax
    andq $-16, %rax
    movq %rax, %rsp
    call main
    movq %rax, %rdi
    movq $60, %rax
    syscall
"
    (compiler-backend-global-shared-view compiler-backend-entry-size-directive)
    "    .section .rodata
.L_tl_main_stack_mmap_error:
    .ascii \"typelisp runtime: 1 GiB main-stack mmap failed\\n\"
    .text
.L_tl_main_stack_abort:
    movq $1, %rax
    movq $2, %rdi
    leaq .L_tl_main_stack_mmap_error(%rip), %rsi
    movq $47, %rdx
    syscall
    movq $60, %rax
    movq $134, %rdi
    syscall
"))

(define (compiler-backend-entry
  [capture-argv : bool]
  [capture-env : bool]
  [startup-profile : bool]
  [global-inits : String]) : String
  (let
    [startup-profile-asm : String
      (if startup-profile
        "    movq $228, %rax
    movq $1, %rdi
    leaq .L_tl_startup_profile_timespec(%rip), %rsi
    syscall
    testq %rax, %rax
    js .L_tl_startup_profile_process_entry_done
    movq .L_tl_startup_profile_timespec(%rip), %rax
    imulq $1000000000, %rax
    addq .L_tl_startup_profile_timespec+8(%rip), %rax
    movq %rax, .L_tl_startup_profile_process_entry_tick(%rip)
.L_tl_startup_profile_process_entry_done:
"
        "")]
    (if (or capture-argv capture-env)
      (str_cat.str-cat
        (compiler-backend-global-shared-view
          compiler-backend-entry-type-directive)
        "_tl_start:\n"
        startup-profile-asm
        "    movq (%rsp), %rax\n"
        (if capture-argv
          "    movq %rax, .L_tl_argc(%rip)
    leaq 8(%rsp), %rax
    movq %rax, .L_tl_argv(%rip)
"
          "")
        (if capture-env
          (str_cat.str-cat
            (if capture-argv
              "    movq (%rsp), %rax\n"
              "")
            "    leaq 16(%rsp,%rax,8), %rax
    movq %rax, .L_tl_envp(%rip)
")
          "")
        "    call tl_thread_init\n"
        global-inits
        (compiler-backend-entry-call-main))
      (str_cat.str-cat
        (compiler-backend-global-shared-view
          compiler-backend-entry-type-directive)
        "_tl_start:\n"
        startup-profile-asm
        "    call tl_thread_init\n"
        global-inits
        (compiler-backend-entry-call-main)))))

(define (compiler-backend-entry-for-target-with-crt
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [plan : CompilerBackendRuntimePlan]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [crt-entry : bool]
  [program-index : CompilerBackendProgramIndex]) : String
  (match target
    [(CompilerBackendTarget.Linux)
      (if crt-entry
        ""
        (compiler-backend-entry
          true
          true
          (compiler-backend-runtime-tail-startup-profile?
            (compiler-backend-runtime-plan-tail plan))
          (compiler-backend-global-initializers
            type-segment-bases
            globals
            program-index)))]
    [(CompilerBackendTarget.Windows) ""]))

(define (compiler-backend-target-windows? [target : CompilerBackendTarget]) : bool
  (compiler_abi.compiler-abi-windows? (compiler-backend-target-abi target)))

;; Emit a full program for `target`. Windows x64 has ABI-correct user function
;; entry/calls and target-specific runtime helpers.
;; Backend entry points come in two flavors: the original
;;
;; program-only variants (kept for existing call sites and smoke tests) supply
;;
;; an empty provenance table, so backend diagnostics fall back to `path:1:1`;
;;
;; the `-with-spans` variants thread the lowering provenance side table so
;;
;; backend errors report the offending function's real source location.
(define (compiler-backend-emit-program-for-target
  [program : compiler_ir_types.CompilerIrProgram]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (compiler-backend-emit-program-target-with-mode
    program
    target
    (CompilerBackendMode.Scalar)
    (compiler_ir_types.compiler-source-spans-empty)
    true))

(define (compiler-backend-emit-program-linux
  [program : compiler_ir_types.CompilerIrProgram]) : ResultCompilerBackend
  (compiler-backend-emit-program-for-target
    program
    (CompilerBackendTarget.Linux)))

(define (compiler-backend-emit-program-linux-with-spans
  [program : compiler_ir_types.CompilerIrProgram]
  [spans : compiler_ir_types.CompilerSourceSpans]) : ResultCompilerBackend
  (compiler-backend-emit-program-target-with-mode
    program
    (CompilerBackendTarget.Linux)
    (CompilerBackendMode.Scalar)
    spans
    true))

(define (compiler-backend-emit-program-with-spans-for-target
  [program : compiler_ir_types.CompilerIrProgram]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (compiler-backend-emit-program-target-with-mode
    program
    target
    (CompilerBackendMode.Scalar)
    spans
    true))

(define (compiler-backend-emit-program-with-spans-for-target-and-entry
  [program : compiler_ir_types.CompilerIrProgram]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [target : CompilerBackendTarget]
  [emit-entry : bool]) : ResultCompilerBackend
  (compiler-backend-emit-program-target-with-mode
    program
    target
    (CompilerBackendMode.Scalar)
    spans
    emit-entry))

(define (compiler-backend-emit-program-prefix-buffer
  [target : CompilerBackendTarget]
  [entry-functions : compiler_ir_types.CompilerIrFunctionList]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [runtime-features
    : (& features runtime_common.CompilerBackendRuntimeFeatures)]
  [program-index : CompilerBackendProgramIndex]
  [runtime-index : CompilerBackendRuntimeIndex]
  [closure-names : BackendSymbolSeq]
  [strings : BackendStringSeq]
  [bytes : BackendStringSeq]
  [floats : BackendFloatSeq]
  [uses-avx2-i64-lane-id : bool]
  [uses-avx512-i64-lane-id : bool]
  [uses-f64-neg : bool]
  [globals-buf : text_buf.TextBuf]
  [emit-entry : bool]
  [crt-entry : bool]) : text_buf.TextBuf
  (let
    [string-buf : text_buf.TextBuf
      (compiler-backend-emit-string-rodata-into strings globals-buf)]
    (begin
      (cfg
        compile-profile
        (compiler-backend-profile-finish
          program-index.profile-state
          "compose.string_rodata"))
      (cfg
        compile-profile
        (compiler-backend-profile-start program-index.profile-state))
      (let
        [bytes-buf : text_buf.TextBuf
          (compiler-backend-emit-bytes-data-into bytes string-buf)]
        (begin
          (cfg
            compile-profile
            (compiler-backend-profile-finish
              program-index.profile-state
              "compose.bytes_data"))
          (cfg
            compile-profile
            (compiler-backend-profile-start program-index.profile-state))
          (let
            [float-literals-buf : text_buf.TextBuf
              (compiler-backend-emit-float-rodata-into floats bytes-buf)]
            [f64-buf : text_buf.TextBuf
              (compiler-backend-emit-f64-sign-bit-rodata-into
                uses-f64-neg
                float-literals-buf)]
            [lane-id-buf : text_buf.TextBuf
              (compiler-backend-emit-lane-id-rodata-into
                uses-avx2-i64-lane-id
                uses-avx512-i64-lane-id
                f64-buf)]
            (begin
              (cfg
                compile-profile
                (compiler-backend-profile-finish
                  program-index.profile-state
                  "compose.float_rodata"))
              (cfg
                compile-profile
                (compiler-backend-profile-start program-index.profile-state))
              (let
                [descriptor-buf : text_buf.TextBuf
                  (compiler-backend-emit-closure-descriptors-into
                    closure-names
                    entry-functions
                    externs
                    program-index
                    lane-id-buf)]
                (begin
                  (cfg
                    compile-profile
                    (compiler-backend-profile-finish
                      program-index.profile-state
                      "compose.closure_descriptors"))
                  (cfg
                    compile-profile
                    (compiler-backend-profile-start program-index.profile-state))
                  (let
                    [switch-buf : text_buf.TextBuf
                      (compiler-backend-emit-switch-tables-functions-into
                        entry-functions
                        program-index
                        descriptor-buf)]
                    [runtime-data-buf : text_buf.TextBuf
                      (text_buf.append
                        switch-buf
                        (if emit-entry
                          (compiler-backend-runtime-data-for-target
                            target
                            runtime-features)
                          ""))]
                    (begin
                      (cfg
                        compile-profile
                        (compiler-backend-profile-finish
                          program-index.profile-state
                          "compose.runtime_data"))
                      (cfg
                        compile-profile
                        (compiler-backend-profile-start
                          program-index.profile-state))
                      (let
                        [externs-buf : text_buf.TextBuf
                          (compiler-backend-emit-externs-into
                            program-index.backend-state
                            externs
                            plan
                            runtime-index
                            closure-names
                            runtime-data-buf)]
                        (begin
                          (cfg
                            compile-profile
                            (compiler-backend-profile-finish
                              program-index.profile-state
                              "compose.externs"))
                          (cfg
                            compile-profile
                            (compiler-backend-profile-start
                              program-index.profile-state))
                          (let
                            [runtime-externs-buf : text_buf.TextBuf
                              (text_buf.append
                                externs-buf
                                (if emit-entry
                                  (compiler-backend-runtime-externs-for-target
                                    target
                                    runtime-features)
                                  ""))]
                            (begin
                              (cfg
                                compile-profile
                                (compiler-backend-profile-finish
                                  program-index.profile-state
                                  "compose.runtime_externs"))
                              (cfg
                                compile-profile
                                (compiler-backend-profile-start
                                  program-index.profile-state))
                              (let
                                [prefix-buf : text_buf.TextBuf
                                  (text_buf.append
                                    runtime-externs-buf
                                    (compiler-backend-target-entry-text-with-crt
                                      target
                                      emit-entry
                                      crt-entry))]
                                (begin
                                  (cfg
                                    compile-profile
                                    (compiler-backend-profile-finish
                                      program-index.profile-state
                                      "compose.entry_text"))
                                  prefix-buf)))))))))))))))))

(define (compiler-backend-emit-program-buffer-after-index
  [type-segment-bases : i64]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [entry-functions : compiler_ir_types.CompilerIrFunctionList]
  [globals : compiler_ir_types.CompilerIrGlobalSeq]
  [externs : compiler_ir_types.CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [runtime-index : CompilerBackendRuntimeIndex]
  [program-index : CompilerBackendProgramIndex]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [globals-buf : text_buf.TextBuf]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendBuffer
  (let
    [collections : CompilerBackendProgramCollections
      (compiler-backend-collect-source-path-strings
        program-index.backend-state
        (compiler-backend-collect-program-collections program)
        spans)]
    [closure-names : BackendSymbolSeq
      (compiler-backend-program-collections-functions collections)]
    [strings : BackendStringSeq
      (compiler-backend-program-collections-strings collections)]
    [bytes : BackendStringSeq
      (compiler-backend-program-collections-bytes collections)]
    [floats : BackendFloatSeq
      (compiler-backend-program-collections-floats collections)]
    [uses-avx2-i64-lane-id : bool
      (compiler-backend-program-collections-uses-avx2-i64-lane-id? collections)]
    [uses-avx512-i64-lane-id : bool
      (compiler-backend-program-collections-uses-avx512-i64-lane-id?
        collections)]
    [uses-f64-neg : bool
      (compiler-backend-program-collections-uses-f64-neg? collections)]
    [span-index : CompilerBackendSourceSpanIndex
      (compiler-backend-source-span-index-build-with-backend-state
        program-index.backend-state
        spans)]
    [global-types : CompilerBackendGlobalTypeTable
      (compiler-backend-global-types globals)]
    [runtime-features : runtime_common.CompilerBackendRuntimeFeatures
      (compiler-backend-runtime-features plan)]
    (begin
      (cfg
        compile-profile
        (compiler-backend-profile-finish program-index.profile-state "collect"))
      (cfg
        compile-profile
        (compiler-backend-profile-start program-index.profile-state))
      (let
        ;; Prefix composition (string/bytes/float rodata, closure descriptors,
        ;; switch tables, runtime data, externs, debug prefix and the rendered
        ;; prefix string) is pure output text. Once the streaming emitter has
        ;; copied those bytes into the home-owned output stream, nothing reads
        ;; them again, but they used to stay resident in the backend emit arena
        ;; for the whole per-function loop -- underneath the compile-wide peak.
        ;; Mark here and release after the stream has consumed the prefix.
        [prefix-mark : arena.ArenaMark (arena.mark)]
        [base-prefix-buf : text_buf.TextBuf
          (compiler-backend-emit-program-prefix-buffer
            target
            entry-functions
            externs
            plan
            (& runtime-features)
            program-index
            runtime-index
            closure-names
            strings
            bytes
            floats
            uses-avx2-i64-lane-id
            uses-avx512-i64-lane-id
            uses-f64-neg
            globals-buf
            emit-entry
            crt-entry)]
        [prefix-buf : text_buf.TextBuf
          (text_buf.append
            base-prefix-buf
            (compiler-backend-debug-prefix
              target
              entry-functions
              program-index
              span-index))]
        [function-input : text_buf.TextBuf
          (if (compiler-backend-assembly-stream-active?
            (compiler-backend-state-stream-state program-index.backend-state))
            (begin
              (compiler-backend-assembly-stream-process-buffer!
                prefix-buf
                program-index.backend-state
                (compiler-backend-state-stream-state
                  program-index.backend-state))
              ;; The prefix bytes now live in the flushed output stream, and the
              ;; per-function caches that could still name region-owned strings
              ;; are cleared before the region goes away.
              (compiler-backend-state-user-symbol-cache-reset!
                program-index.backend-state)
              (compiler-backend-state-slot-cache-epoch-bump!
                program-index.backend-state)
              (unsafe
                (arena.rewind prefix-mark))
              (text_buf.empty))
            prefix-buf)]
        (begin
          ;; This window previously started at the "collect" finish and was
          ;; overwritten by the next start without ever being reported,
          ;; hiding the prefix composition from the phase breakdown.
          (cfg
            compile-profile
            (compiler-backend-profile-finish
              program-index.profile-state
              "prefix"))
          (cfg
            compile-profile
            (compiler-backend-profile-start program-index.profile-state))
          (match (compiler-backend-emit-functions-buffer-into
            type-segment-bases
            target
            mode
            entry-functions
            entry-functions
            globals
            global-types
            externs
            plan
            program-index
            spans
            span-index
            emit-entry
            crt-entry
            function-input)
            [(ResultCompilerBackendBuffer.Ok with-functions)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-finish
                    program-index.profile-state
                    "functions"))
                (cfg
                  compile-profile-summary
                  (compiler-backend-profile-summary-emit
                    program-index.profile-state))
                (cfg
                  compile-profile
                  (compiler-backend-profile-start program-index.profile-state))
                (match (compiler-backend-emit-closure-entry-adapters-buffer-into
                  type-segment-bases
                  target
                  closure-names
                  entry-functions
                  externs
                  plan
                  program-index
                  (text_buf.append
                    with-functions
                    (compiler-backend-debug-trailer
                      target
                      entry-functions
                      program-index)))
                  [(ResultCompilerBackendBuffer.Ok with-adapters)
                    (begin
                      (cfg
                        compile-profile
                        (compiler-backend-profile-finish
                          program-index.profile-state
                          "adapters"))
                      (cfg
                        compile-profile
                        (compiler-backend-profile-start
                          program-index.profile-state))
                      (let
                        [buf : text_buf.TextBuf
                          (text_buf.append
                            (text_buf.append
                              with-adapters
                              (if emit-entry
                                (compiler-backend-runtime-functions-for-target
                                  target
                                  (& runtime-features))
                                ""))
                            (if emit-entry
                              (compiler-backend-entry-for-target-with-crt
                                type-segment-bases
                                target
                                plan
                                globals
                                crt-entry
                                program-index)
                              ""))]
                        (begin
                          (cfg
                            compile-profile
                            (compiler-backend-profile-finish
                              program-index.profile-state
                              "compose_tail"))
                          (cfg
                            regalloc-census
                            (begin
                              (compiler_regalloc.compiler-reg-call-span-census-print!)
                              (compiler_regalloc.compiler-reg-evict-census-print!)
                              (compiler_regalloc.compiler-reg-assignment-census-print!)
                              (compiler_regalloc.compiler-reg-move-census-print!)
                              (io.print-error
                                (str_cat.str-cat
                                  "rsp-rebase|ok="
                                  (string.int->string
                                    compiler-backend-rsp-rebase-ok-count)
                                  "|keep-rbp="
                                  (string.int->string
                                    compiler-backend-rsp-rebase-keep-count)
                                  "|fpo="
                                  (string.int->string
                                    compiler-backend-fpo-count)
                                  (str_cat.str-cat
                                    "|rbp-pool="
                                    (string.int->string
                                      compiler-backend-fpo-rbp-plan-count)
                                    "|demote="
                                    (string.int->string
                                      compiler-backend-fpo-demote-count)
                                    "|push="
                                    (string.int->string
                                      compiler-backend-fpo-push-count)
                                    "\n"
                                    "")))
                              (io.print-error
                                (str_cat.str-cat
                                  "phi-xmm-cycle|register="
                                  (string.int->string
                                    compiler-backend-phi-xmm-cycle-register-count)
                                  "|fallback="
                                  (string.int->string
                                    compiler-backend-phi-xmm-cycle-fallback-count)
                                  "\n"
                                  ""))
                              (io.print-error
                                (str_cat.str-cat
                                  "peephole-r10-dead-scan|cap="
                                  (string.int->string
                                    compiler-backend-peephole-r10-dead-scan-line-cap)
                                  "|cap-hits="
                                  (string.int->string
                                    compiler-backend-peephole-r10-dead-scan-cap-hits)
                                  "\n"
                                  ""))))
                          (cfg
                            scavenge-census
                            (compiler-backend-scavenge-census-print!))
                          (ResultCompilerBackendBuffer.Ok
                            (if (compiler-backend-assembly-stream-active?
                              (compiler-backend-state-stream-state
                                program-index.backend-state))
                              (begin
                                (compiler-backend-assembly-stream-process-buffer!
                                  buf
                                  program-index.backend-state
                                  (compiler-backend-state-stream-state
                                    program-index.backend-state))
                                (compiler-backend-assembly-stream-output
                                  (compiler-backend-state-stream-state
                                    program-index.backend-state)))
                              buf)))))]
                  [(ResultCompilerBackendBuffer.Err message)
                    (begin
                      (cfg
                        compile-profile
                        (compiler-backend-profile-finish
                          program-index.profile-state
                          "adapters"))
                      (ResultCompilerBackendBuffer.Err message))]))]
            [(ResultCompilerBackendBuffer.Err message)
              (begin
                (cfg
                  compile-profile
                  (compiler-backend-profile-finish
                    program-index.profile-state
                    "functions"))
                (cfg
                  compile-profile-summary
                  (compiler-backend-profile-summary-emit
                    program-index.profile-state))
                (ResultCompilerBackendBuffer.Err message))]))))))

(define (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-prepared-backend-state
  [backend-state : CompilerBackendState]
  [type-segment-bases : i64]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [pic-emit? : bool]
  [profile-state : profile_state.CompilerProfileState]) : ResultCompilerBackendBuffer
  (begin
    (compiler-backend-state-user-symbol-cache-reset! backend-state)
    (compiler-backend-state-slot-cache-reset! backend-state)
    (compiler-backend-peephole-carry-safe-reset-with-backend-state!
      backend-state
      (compiler-backend-state-stream-state backend-state))
    (compiler-backend-peephole-owner-global-storage-ensure-with-backend-state!
      backend-state
      (compiler-backend-state-stream-state backend-state))
    (compiler-backend-state-set-abort-site-counter! backend-state 0)
    (compiler-backend-state-set-absolute-switch-ok!
      backend-state
      (and (not pic-emit?) (not (compiler-backend-target-windows? target))))
    (set! compiler-backend-rsp-rebase-ok-count 0)
    (set! compiler-backend-rsp-rebase-keep-count 0)
    (set! compiler-backend-fpo-count 0)
    (set! compiler-backend-fpo-rbp-plan-count 0)
    (set! compiler-backend-fpo-demote-count 0)
    (set! compiler-backend-fpo-push-count 0)
    (set! compiler-backend-peephole-r10-dead-scan-cap-hits 0)
    (set! compiler-backend-phi-xmm-cycle-register-count 0)
    (set! compiler-backend-phi-xmm-cycle-fallback-count 0)
    ;; GAP5: clear the post-emission dead-frame-store sweep metadata before
    ;; recording this program's FPO functions (a stale entry from a prior
    ;; program emit in the same process must not leak into the sweep).
    (compiler-backend-sweep-reset!
      (compiler-backend-state-stream-state backend-state))
    (cfg
      regalloc-census
      (begin
        (compiler_regalloc.compiler-reg-call-span-census-reset!)
        (compiler_regalloc.compiler-reg-assignment-census-reset!)
        (compiler_regalloc.compiler-reg-move-census-reset!)))
    (cfg scavenge-census (compiler-backend-scavenge-census-reset!))
    (cfg compile-profile (compiler-backend-profile-start profile-state))
    (match (compiler-backend-runtime-plan-with-index-with-backend-state
      backend-state
      program)
      [(ResultBackendRuntimePlanWithIndex.Ok planned)
        (let
          [plan : CompilerBackendRuntimePlan planned.plan]
          [runtime-index : CompilerBackendRuntimeIndex planned.index]
          (begin
            (cfg
              compile-profile
              (compiler-backend-profile-finish profile-state "runtime_plan"))
            (cfg compile-profile (compiler-backend-profile-start profile-state))
            (match program
              [(compiler_ir_types.CompilerIrProgram.Program
                  globals
                  functions
                  externs)
                ;; Build the program index ONCE over the entry function list
                ;; and share it with the globals emission: each build walks
                ;; every function body for the register-group counts, so the
                ;; former second build doubled both that walk and its ~120MB
                ;; of transient allocation. The entry list is a superset of
                ;; `functions` (at most the synthesized implicit main, which
                ;; no global initializer can reference), so globals resolve
                ;; identically against the shared index.
                (let
                  [entry-functions : compiler_ir_types.CompilerIrFunctionList
                    (compiler-backend-functions-with-implicit-main
                      functions
                      emit-entry)]
                  [program-index : CompilerBackendProgramIndex
                    (compiler-backend-program-index-build-with-backend-state-and-profile-state
                      backend-state
                      type-segment-bases
                      entry-functions
                      externs
                      profile-state)]
                  (begin
                    (cfg
                      compile-profile
                      (compiler-backend-profile-finish profile-state "index"))
                    (cfg
                      compile-profile
                      (compiler-backend-profile-start profile-state))
                    (match (compiler-backend-emit-globals-buffer-into
                      type-segment-bases
                      target
                      globals
                      (text_buf.append (text_buf.empty) ".data\n")
                      program-index)
                      [(ResultCompilerBackendBuffer.Ok globals-buf)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-backend-profile-finish
                              profile-state
                              "globals"))
                          (cfg
                            compile-profile
                            (compiler-backend-profile-start profile-state))
                          (match (compiler-backend-validate-function-symbols
                            globals
                            entry-functions
                            externs
                            plan
                            program-index)
                            [(ResultCompilerBackendSymbolValidation.Ok _)
                              (compiler-backend-emit-program-buffer-after-index
                                type-segment-bases
                                program
                                target
                                mode
                                entry-functions
                                globals
                                externs
                                plan
                                runtime-index
                                program-index
                                spans
                                globals-buf
                                emit-entry
                                crt-entry)]
                            [(ResultCompilerBackendSymbolValidation.Err message)
                              (ResultCompilerBackendBuffer.Err message)]))]
                      [(ResultCompilerBackendBuffer.Err message)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-backend-profile-finish
                              profile-state
                              "globals"))
                          (ResultCompilerBackendBuffer.Err message))])))])))]
      [(ResultBackendRuntimePlanWithIndex.Err message)
        (begin
          (cfg
            compile-profile
            (compiler-backend-profile-finish profile-state "runtime_plan"))
          (ResultCompilerBackendBuffer.Err
            (box (compiler_diagnostic.compiler-diagnostic-at-start "" message))))])))

(define (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
  [backend-state : CompilerBackendState]
  [type-segment-bases : i64]
  [program : compiler_ir_types.CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : compiler_ir_types.CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]
  [pic-emit? : bool]
  [profile-state : profile_state.CompilerProfileState]) : ResultCompilerBackendBuffer
  (let
    [_emission-arena : arena.Arena
      (compiler-backend-state-ensure-emission-arena! backend-state)]
    [result : ResultCompilerBackendBuffer
      (compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-prepared-backend-state
        backend-state
        type-segment-bases
        program
        target
        mode
        spans
        emit-entry
        crt-entry
        pic-emit?
        profile-state)]
    (begin
      (compiler-backend-clear-function-owned-state! backend-state)
      (compiler-backend-state-retire-function-state! backend-state)
      (compiler-backend-state-clear-emission-arena! backend-state)
      result)))

(define (compiler-backend-object-value-ref
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [value : compiler_ir_types.CompilerIrValue]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match value
    [(compiler_ir_types.CompilerIrValue.Global name)
      (let
        [symbol : String
          (compiler-backend-state-user-symbol-id
            program-index.backend-state
            name)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipValue)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRip symbol)))]
    [(compiler_ir_types.CompilerIrValue.GlobalAddr name)
      (let
        [symbol : String
          (compiler-backend-state-user-symbol-id
            program-index.backend-state
            name)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [(compiler_ir_types.CompilerIrValue.String text)
      (let
        [symbol : String (compiler-backend-string-fat-label text)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [(compiler_ir_types.CompilerIrValue.Bytes text)
      (let
        [symbol : String (compiler-backend-bytes-fat-label text)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [(compiler_ir_types.CompilerIrValue.F64 bits)
      (let
        [symbol : String (compiler-backend-f64-label bits)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipValue)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRip symbol)))]
    [(compiler_ir_types.CompilerIrValue.Function name)
      (let
        [symbol : String
          (compiler-backend-closure-descriptor-label
            (compiler-backend-symbol-text-index program-index name))]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRipAddress symbol)))]
    [_ parts]))

(define (compiler-backend-object-value-ref-with-type
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [value : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match value
    [(compiler_ir_types.CompilerIrValue.F64 bits)
      (let
        [symbol : String (compiler-backend-float-label ty bits)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            parts
            site
            (cobj.CompilerObjectRelocationKind.RipValue)
            symbol)
          (cobj.CompilerObjectX64Instr.LoadRip symbol)))]
    [_ (compiler-backend-object-value-ref parts site value program-index)]))

(define (compiler-backend-object-call-args
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [index : i64]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (compiler-backend-call-args-count args))
    parts
    (compiler-backend-object-call-args
      (compiler-backend-object-value-ref
        parts
        site
        (compiler-backend-call-arg-at args index)
        program-index)
      site
      args
      (+ index 1)
      program-index)))

(define (compiler-backend-object-spmd-call-args
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [args : compiler_ir_types.CompilerIrSpmdCallArgList]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match args
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Nil) parts]
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(compiler_ir_types.CompilerIrSpmdCallArg.Arg _ value _)
          (compiler-backend-object-spmd-call-args
            (compiler-backend-object-value-ref parts site value program-index)
            site
            (__tl-box-place rest)
            program-index)])]
    [(compiler_ir_types.CompilerIrSpmdCallArgList.Array seq)
      (let
        [out : object_target.CompilerBackendObjectTargetParts parts]
        [i : i64 0]
        [count : i64 seq.len]
        [slots : (__tl_dyn-array compiler_ir_types.CompilerIrSpmdCallArg)
          seq.slots]
        (begin
          (while (< i count)
            (begin
              (match (array-ref slots i)
                [(compiler_ir_types.CompilerIrSpmdCallArg.Arg _ value _)
                  (set!
                    out
                    (compiler-backend-object-value-ref
                      out
                      site
                      value
                      program-index))])
              (set! i (+ i 1))))
          out))]))

(define (compiler-backend-object-value-list-ref
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [values : compiler_ir_types.CompilerIrValueList]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match values
    [(compiler_ir_types.CompilerIrValueList.Nil) parts]
    [(compiler_ir_types.CompilerIrValueList.Array seq)
      (compiler-backend-object-value-list-ref
        parts
        site
        (compiler_ir_types.compiler-ir-value-seq-to-list seq)
        program-index)]
    [(compiler_ir_types.CompilerIrValueList.Cons value rest)
      (compiler-backend-object-value-list-ref
        (compiler-backend-object-value-ref parts site value program-index)
        site
        (__tl-box-place rest)
        program-index)]))

(define (compiler-backend-object-byte [value : i64]) : u8
  (cast (bit-and value 0xff) : u8))

;; Private hot object-code fragments use the narrow append-only ByteBuf core.
(define (compiler-backend-object-push-u8!
  [out : (&mut out byte_buf_core.ByteBufBuilder)]
  [value : i64]) : unit
  (byte_buf_core.byte-buf-builder-push out (compiler-backend-object-byte value)))

(define (compiler-backend-object-push-u32!
  [out : (&mut out byte_buf_core.ByteBufBuilder)]
  [value : i64]) : unit
  (begin
    (compiler-backend-object-push-u8! out value)
    (compiler-backend-object-push-u8! out (shr value 8))
    (compiler-backend-object-push-u8! out (shr value 16))
    (compiler-backend-object-push-u8! out (shr value 24))))

(define (compiler-backend-object-push-u64!
  [out : (&mut out byte_buf_core.ByteBufBuilder)]
  [value : i64]) : unit
  (begin
    (compiler-backend-object-push-u32! out value)
    (compiler-backend-object-push-u32! out (shr value 32))))

(define (compiler-backend-object-bytes-finish
  [out : (& out byte_buf_core.ByteBufBuilder)]) : String
  (byte_buf_core.byte-buf-builder-finish-string out))

(define (compiler-backend-object-add-nonempty-bytes
  [parts : object_target.CompilerBackendObjectTargetParts]
  [bytes : String]) : object_target.CompilerBackendObjectTargetParts
  (if (= (string.string-length bytes) 0)
    parts
    (object_target.compiler-backend-object-add-text
      parts
      (cobj.CompilerObjectX64Instr.Bytes bytes))))

(define (compiler-backend-object-reg-low-code [reg : String]) : i64
  (cond
    [(or (string.eq reg "%rax") (string.eq reg "%r8")) 0]
    [(or (string.eq reg "%rcx") (string.eq reg "%r9")) 1]
    [(or (string.eq reg "%rdx") (string.eq reg "%r10")) 2]
    [(or (string.eq reg "%rbx") (string.eq reg "%r11")) 3]
    [(or (string.eq reg "%rsp") (string.eq reg "%r12")) 4]
    [(or (string.eq reg "%rbp") (string.eq reg "%r13")) 5]
    [(or (string.eq reg "%rsi") (string.eq reg "%r14")) 6]
    [else 7]))

(define (compiler-backend-object-reg-high? [reg : String]) : bool
  (or
    (string.eq reg "%r8")
    (string.eq reg "%r9")
    (string.eq reg "%r10")
    (string.eq reg "%r11")
    (string.eq reg "%r12")
    (string.eq reg "%r13")
    (string.eq reg "%r14")
    (string.eq reg "%r15")))

(define (compiler-backend-object-slot-disp [var-id : i64]) : i64
  (- 0 (* 8 (+ var-id 1))))

(define (compiler-backend-object-disp8? [disp : i64]) : bool
  (and (>= disp -128) (<= disp 127)))

(define (compiler-backend-object-load-rbp-disp-bytes
  [disp : i64]
  [reg : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
    [rex : i64
      (+
        0x48
        (if (compiler-backend-object-reg-high? reg)
          4
          0))]
    (begin
      (compiler-backend-object-push-u8! (&mut out) rex)
      (compiler-backend-object-push-u8! (&mut out) 0x8b)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x45 (* reg-code 8)))
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x85 (* reg-code 8)))
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-lea-rbp-disp-bytes [disp : i64] [reg : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
    [rex : i64
      (+
        0x48
        (if (compiler-backend-object-reg-high? reg)
          4
          0))]
    (begin
      (compiler-backend-object-push-u8! (&mut out) rex)
      (compiler-backend-object-push-u8! (&mut out) 0x8d)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x45 (* reg-code 8)))
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x85 (* reg-code 8)))
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-store-slot-bytes [var-id : i64] [reg : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [disp : i64 (compiler-backend-object-slot-disp var-id)]
    [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
    [rex : i64
      (+
        0x48
        (if (compiler-backend-object-reg-high? reg)
          4
          0))]
    (begin
      (compiler-backend-object-push-u8! (&mut out) rex)
      (compiler-backend-object-push-u8! (&mut out) 0x89)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x45 (* reg-code 8)))
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) (+ 0x85 (* reg-code 8)))
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-mov-imm32-reg-bytes
  [value : i64]
  [reg : String]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
    [rex : i64
      (+
        0x48
        (if (compiler-backend-object-reg-high? reg)
          1
          0))]
    (begin
      (compiler-backend-object-push-u8! (&mut out) rex)
      (compiler-backend-object-push-u8! (&mut out) 0xc7)
      (compiler-backend-object-push-u8! (&mut out) (+ 0xc0 reg-code))
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

;; `REX.W + C7 /0` sign-extends its imm32 payload. Keep that compact encoding
;; only for values it can represent; wide literals need `REX.W + B8+r imm64`.
;; Native TLCI entries pass source integer literals through this path, so
;; truncating one here changes the AST produced by the next bootstrap stage.
(define (compiler-backend-object-mov-i64-reg-bytes [value : i64] [reg : String]) : String
  (if (compiler-backend-imm32? value)
    (compiler-backend-object-mov-imm32-reg-bytes value reg)
    (let
      [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
      [reg-code : i64 (compiler-backend-object-reg-low-code reg)]
      [rex : i64
        (+
          0x48
          (if (compiler-backend-object-reg-high? reg)
            1
            0))]
      (begin
        (compiler-backend-object-push-u8! (&mut out) rex)
        (compiler-backend-object-push-u8! (&mut out) (+ 0xb8 reg-code))
        (compiler-backend-object-push-u64! (&mut out) value)
        (compiler-backend-object-bytes-finish (& out))))))

(define (compiler-backend-object-mov-reg-reg-bytes
  [src : String]
  [dst : String]) : String
  (if (string.eq src dst)
    ""
    (let
      [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
      [src-code : i64 (compiler-backend-object-reg-low-code src)]
      [dst-code : i64 (compiler-backend-object-reg-low-code dst)]
      [rex : i64
        (+
          0x48
          (+
            (if (compiler-backend-object-reg-high? src)
              4
              0)
            (if (compiler-backend-object-reg-high? dst)
              1
              0)))]
      (begin
        (compiler-backend-object-push-u8! (&mut out) rex)
        (compiler-backend-object-push-u8! (&mut out) 0x89)
        (compiler-backend-object-push-u8!
          (&mut out)
          (+ 0xc0 (+ (* src-code 8) dst-code)))
        (compiler-backend-object-bytes-finish (& out))))))

(define (compiler-backend-object-push-sub-rsp!
  [out : (&mut out byte_buf_core.ByteBufBuilder)]
  [amount : i64]) : unit
  (if (<= amount 127)
    (begin
      (compiler-backend-object-push-u8! out 0x48)
      (compiler-backend-object-push-u8! out 0x83)
      (compiler-backend-object-push-u8! out 0xec)
      (compiler-backend-object-push-u8! out amount))
    (begin
      (compiler-backend-object-push-u8! out 0x48)
      (compiler-backend-object-push-u8! out 0x81)
      (compiler-backend-object-push-u8! out 0xec)
      (compiler-backend-object-push-u32! out amount))))

(define (compiler-backend-object-prologue-bytes
  [target : CompilerBackendTarget]
  [frame-size : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    [probe : bool
      (match target
        [(CompilerBackendTarget.Windows) (>= frame-size 4096)]
        [_ false])]
    [remaining : i64 frame-size]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x55)
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x89)
      (compiler-backend-object-push-u8! (&mut out) 0xe5)
      (if (= frame-size 0)
        unit
        (if probe
          ;; Windows guard-page discipline: a frame that skips past the
          ;; single guard page faults, so large frames extend the stack one
          ;; page at a time with a touch per page (the inline equivalent of
          ;; the asm path's __chkstk call, which mapped images cannot make).
          (begin
            (while (> remaining 4096)
              (begin
                (compiler-backend-object-push-sub-rsp! (&mut out) 4096)
                ;; orl $0, (%rsp)
                (compiler-backend-object-push-u8! (&mut out) 0x83)
                (compiler-backend-object-push-u8! (&mut out) 0x0c)
                (compiler-backend-object-push-u8! (&mut out) 0x24)
                (compiler-backend-object-push-u8! (&mut out) 0x00)
                (set! remaining (- remaining 4096))))
            (if (> remaining 0)
              (compiler-backend-object-push-sub-rsp! (&mut out) remaining)
              unit))
          (compiler-backend-object-push-sub-rsp! (&mut out) frame-size)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-leave-ret-bytes) : String
  (object_target.compiler-backend-object-bytes-from-hex "c9c3"))

(define (compiler-backend-object-zero-eax-bytes) : String
  (object_target.compiler-backend-object-bytes-from-hex "31c0"))

(define (compiler-backend-object-rsp-imm-bytes [opcode : i64] [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (if (<= value 127)
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x48)
          (compiler-backend-object-push-u8! (&mut out) 0x83)
          (compiler-backend-object-push-u8! (&mut out) opcode)
          (compiler-backend-object-push-u8! (&mut out) value))
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x48)
          (compiler-backend-object-push-u8! (&mut out) 0x81)
          (compiler-backend-object-push-u8! (&mut out) opcode)
          (compiler-backend-object-push-u32! (&mut out) value)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-sub-rsp-bytes [value : i64]) : String
  (if (= value 0)
    ""
    (compiler-backend-object-rsp-imm-bytes 0xec value)))

(define (compiler-backend-object-unop-rax-bytes
  [op : compiler_ir_types.CompilerIrUnOp]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (match op
        [(compiler_ir_types.CompilerIrUnOp.Neg)
          (begin
            (compiler-backend-object-push-u8! (&mut out) 0x48)
            (compiler-backend-object-push-u8! (&mut out) 0xf7)
            (compiler-backend-object-push-u8! (&mut out) 0xd8))]
        [(compiler_ir_types.CompilerIrUnOp.Not)
          (begin
            (compiler-backend-object-push-u8! (&mut out) 0x48)
            (compiler-backend-object-push-u8! (&mut out) 0x83)
            (compiler-backend-object-push-u8! (&mut out) 0xf0)
            (compiler-backend-object-push-u8! (&mut out) 0x01))]
        [(compiler_ir_types.CompilerIrUnOp.BitNot)
          (begin
            (compiler-backend-object-push-u8! (&mut out) 0x48)
            (compiler-backend-object-push-u8! (&mut out) 0xf7)
            (compiler-backend-object-push-u8! (&mut out) 0xd0))]
        [(compiler_ir_types.CompilerIrUnOp.Sqrt) unit])
      (byte_buf_core.byte-buf-builder-finish-string (& out)))))

(define (compiler-backend-object-call-r11-bytes) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x41)
      (compiler-backend-object-push-u8! (&mut out) 0xff)
      (compiler-backend-object-push-u8! (&mut out) 0xd3)
      (byte_buf_core.byte-buf-builder-finish-string (& out)))))

(define (compiler-backend-object-add-rsp-bytes [value : i64]) : String
  (if (= value 0)
    ""
    (compiler-backend-object-rsp-imm-bytes 0xc4 value)))

(define (compiler-backend-object-store-rax-rsp-bytes [disp : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x89)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x44)
          (compiler-backend-object-push-u8! (&mut out) 0x24)
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x84)
          (compiler-backend-object-push-u8! (&mut out) 0x24)
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-load-rax-rsp-bytes [disp : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x8b)
      (if (compiler-backend-object-disp8? disp)
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x44)
          (compiler-backend-object-push-u8! (&mut out) 0x24)
          (compiler-backend-object-push-u8! (&mut out) disp))
        (begin
          (compiler-backend-object-push-u8! (&mut out) 0x84)
          (compiler-backend-object-push-u8! (&mut out) 0x24)
          (compiler-backend-object-push-u32! (&mut out) disp)))
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-load-rax-pointee-bytes
  [type-segment-bases : i64]
  [ty : compiler_ast_types.AstType]) : String
  (let
    [size : i64 (compiler-backend-type-size type-segment-bases ty)]
    [signed : bool (compiler-backend-type-signed? ty)]
    (cond
      [(= size 8)
        (object_target.compiler-backend-object-bytes-from-hex "488b00")]
      [(= size 4)
        (if signed
          (object_target.compiler-backend-object-bytes-from-hex "486300")
          (object_target.compiler-backend-object-bytes-from-hex "8b00"))]
      [(= size 2)
        (if signed
          (object_target.compiler-backend-object-bytes-from-hex "480fbf00")
          (object_target.compiler-backend-object-bytes-from-hex "0fb700"))]
      [(= size 1)
        (if signed
          (object_target.compiler-backend-object-bytes-from-hex "480fbe00")
          (object_target.compiler-backend-object-bytes-from-hex "0fb600"))]
      [else (object_target.compiler-backend-object-bytes-from-hex "488b00")])))

(define (compiler-backend-object-leave-bytes) : String
  (object_target.compiler-backend-object-bytes-from-hex "c9"))

(define (compiler-backend-object-load-value-to-reg
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [value : compiler_ir_types.CompilerIrValue]
  [reg : String]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match value
    [(compiler_ir_types.CompilerIrValue.Var id)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-load-rbp-disp-bytes
          (compiler-backend-object-slot-disp id)
          reg))]
    [(compiler_ir_types.CompilerIrValue.I64 n)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-i64-reg-bytes n reg))]
    [(compiler_ir_types.CompilerIrValue.Bool b)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes
          (if b
            1
            0)
          reg))]
    [(compiler_ir_types.CompilerIrValue.Char c)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes
          (compiler-backend-char-code c)
          reg))]
    [(compiler_ir_types.CompilerIrValue.Unit)
      (compiler-backend-object-add-nonempty-bytes
        parts
        (compiler-backend-object-mov-imm32-reg-bytes 0 reg))]
    [(compiler_ir_types.CompilerIrValue.Global _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value program-index)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(compiler_ir_types.CompilerIrValue.GlobalAddr _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value program-index)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(compiler_ir_types.CompilerIrValue.String _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value program-index)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(compiler_ir_types.CompilerIrValue.Bytes _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value program-index)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(compiler_ir_types.CompilerIrValue.Function _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value program-index)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(compiler_ir_types.CompilerIrValue.F64 _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref parts site value program-index)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [(compiler_ir_types.CompilerIrValue.RuntimeGlobal _) parts]))

(define (compiler-backend-object-load-value-to-reg-with-type
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [value : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [reg : String]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match value
    [(compiler_ir_types.CompilerIrValue.F64 _)
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-value-ref-with-type
          parts
          site
          value
          ty
          program-index)
        (compiler-backend-object-mov-reg-reg-bytes "%rax" reg))]
    [_
      (compiler-backend-object-load-value-to-reg
        parts
        site
        value
        reg
        program-index)]))

(define (compiler-backend-object-store-reg-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [dst : i64]
  [reg : String]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-add-nonempty-bytes
    parts
    (compiler-backend-object-store-slot-bytes dst reg)))

(define (compiler-backend-object-addr-of-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [dst : i64]
  [src : i64]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-store-reg-to-var
    (compiler-backend-object-add-nonempty-bytes
      parts
      (compiler-backend-object-lea-rbp-disp-bytes
        (compiler-backend-object-slot-disp src)
        "%rax"))
    dst
    "%rax"))

(define (compiler-backend-object-move-value-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-store-reg-to-var
    (compiler-backend-object-load-value-to-reg-with-type
      parts
      site
      src
      ty
      "%rax"
      program-index)
    dst
    "%rax"))

(define (compiler-backend-object-group-word-var
  [backend-state : CompilerBackendState]
  [var : i64]
  [word-index : i64]) : i64
  (if (= word-index 0)
    var
    (+
      (compiler-backend-function-state-i64
        (compiler-backend-state-function-state backend-state)
        compiler-backend-function-i64-current-slot-vars)
      var)))

(define (compiler-backend-object-load-group-word-to-reg
  [backend-state : CompilerBackendState]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [var : i64]
  [word-index : i64]
  [reg : String]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-add-nonempty-bytes
    parts
    (compiler-backend-object-load-rbp-disp-bytes
      (compiler-backend-object-slot-disp
        (compiler-backend-object-group-word-var backend-state var word-index))
      reg)))

(define (compiler-backend-object-store-reg-to-group-word
  [backend-state : CompilerBackendState]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [var : i64]
  [word-index : i64]
  [reg : String]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-add-nonempty-bytes
    parts
    (compiler-backend-object-store-slot-bytes
      (compiler-backend-object-group-word-var backend-state var word-index)
      reg)))

(define (compiler-backend-object-move-group-value-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match src
    [(compiler_ir_types.CompilerIrValue.Var src-var)
      (compiler-backend-object-store-reg-to-group-word
        program-index.backend-state
        (compiler-backend-object-store-reg-to-group-word
          program-index.backend-state
          (compiler-backend-object-load-group-word-to-reg
            program-index.backend-state
            (compiler-backend-object-load-group-word-to-reg
              program-index.backend-state
              parts
              src-var
              0
              "%rax")
            src-var
            1
            "%rdx")
          dst
          0
          "%rax")
        dst
        1
        "%rdx")]
    [_ (compiler-backend-object-value-ref parts site src program-index)]))

(define (compiler-backend-object-pack-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [words : compiler_ir_types.CompilerIrValueList]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match (compiler_ir_types.compiler-ir-value-list-force-cons words)
    [(compiler_ir_types.CompilerIrValueList.Cons word0 rest0)
      (match (compiler_ir_types.compiler-ir-value-list-force-cons
        (__tl-box-place rest0))
        [(compiler_ir_types.CompilerIrValueList.Cons word1 _)
          (compiler-backend-object-store-reg-to-group-word
            program-index.backend-state
            (compiler-backend-object-store-reg-to-group-word
              program-index.backend-state
              (compiler-backend-object-load-value-to-reg
                (compiler-backend-object-load-value-to-reg
                  parts
                  site
                  word0
                  "%rax"
                  program-index)
                site
                word1
                "%rdx"
                program-index)
              dst
              0
              "%rax")
            dst
            1
            "%rdx")]
        [_
          (compiler-backend-object-value-list-ref
            parts
            site
            words
            program-index)])]
    [_ (compiler-backend-object-value-list-ref parts site words program-index)]))

(define (compiler-backend-object-word-to-var
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [word-index : i64]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match src
    [(compiler_ir_types.CompilerIrValue.Var src-var)
      (compiler-backend-object-store-reg-to-var
        (compiler-backend-object-load-group-word-to-reg
          program-index.backend-state
          parts
          src-var
          word-index
          "%rax")
        dst
        "%rax")]
    [_ (compiler-backend-object-value-ref parts site src program-index)]))

(define (compiler-backend-object-load-ptr-to-var
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [src : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-store-reg-to-var
    (compiler-backend-object-add-nonempty-bytes
      (compiler-backend-object-load-value-to-reg
        parts
        site
        src
        "%rax"
        program-index)
      (compiler-backend-object-load-rax-pointee-bytes type-segment-bases ty))
    dst
    "%rax"))

(define (compiler-backend-object-sub-imm32-rax-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x2d)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-add-imm32-rax-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x05)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-imul-imm32-r8-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x4d)
      (compiler-backend-object-push-u8! (&mut out) 0x69)
      (compiler-backend-object-push-u8! (&mut out) 0xc0)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-add-r8-rax-bytes) : String
  (object_target.compiler-backend-object-bytes-from-hex "4c01c0"))

(define (compiler-backend-object-gep-to-var
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [base : compiler_ir_types.CompilerIrValue]
  [offset : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (let
    [elem-size : i64 (compiler-backend-type-size type-segment-bases elem-ty)]
    [with-base : object_target.CompilerBackendObjectTargetParts
      (compiler-backend-object-load-value-to-reg
        parts
        site
        base
        "%rax"
        program-index)]
    [with-offset : object_target.CompilerBackendObjectTargetParts
      (match offset
        [(compiler_ir_types.CompilerIrValue.I64 n)
          (let
            [disp : i64 (* n elem-size)]
            (if (= disp 0)
              with-base
              (compiler-backend-object-add-nonempty-bytes
                with-base
                (compiler-backend-object-add-imm32-rax-bytes disp))))]
        [_
          (compiler-backend-object-add-nonempty-bytes
            (if (= elem-size 1)
              (compiler-backend-object-load-value-to-reg
                with-base
                site
                offset
                "%r8"
                program-index)
              (compiler-backend-object-add-nonempty-bytes
                (compiler-backend-object-load-value-to-reg
                  with-base
                  site
                  offset
                  "%r8"
                  program-index)
                (compiler-backend-object-imul-imm32-r8-bytes elem-size)))
            (compiler-backend-object-add-r8-rax-bytes))])]
    (compiler-backend-object-store-reg-to-var with-offset dst "%rax")))

(define (compiler-backend-object-cmp-imm32-rax-bytes [value : i64]) : String
  (let
    [out : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (begin
      (compiler-backend-object-push-u8! (&mut out) 0x48)
      (compiler-backend-object-push-u8! (&mut out) 0x3d)
      (compiler-backend-object-push-u32! (&mut out) value)
      (compiler-backend-object-bytes-finish (& out)))))

(define (compiler-backend-object-switch-indirect-jump-bytes) : String
  (object_target.compiler-backend-object-bytes-from-hex "49ff24c3"))

(define (compiler-backend-object-switch-entry-label
  [table-label : String]
  [index : i64]) : String
  (str_cat.str-cat table-label "_entry_" (string.int->string index)))

(define (compiler-backend-object-switch-table-cases
  [parts : object_target.CompilerBackendObjectTargetParts]
  [label-scope : String]
  [table-label : String]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (match cases
    [(compiler_ir_types.CompilerIrSwitchCaseList.Nil) parts]
    [(compiler_ir_types.CompilerIrSwitchCaseList.Cons case rest)
      (match case
        [(compiler_ir_types.CompilerIrSwitchCase.Case _ label)
          (let
            [entry-label : String
              (compiler-backend-object-switch-entry-label table-label index)]
            [target : String (compiler-backend-asm-label label-scope label)]
            (compiler-backend-object-switch-table-cases
              (object_target.compiler-backend-object-add-rodata
                (object_target.compiler-backend-object-add-rodata-relocation
                  (object_target.compiler-backend-object-add-rodata
                    parts
                    (cobj.CompilerObjectDataRecord.Label entry-label))
                  entry-label
                  (cobj.CompilerObjectRelocationKind.Abs64)
                  target)
                (cobj.CompilerObjectDataRecord.SymbolAddress target))
              label-scope
              table-label
              (__tl-box-place rest)
              (+ index 1)))])]
    [(compiler_ir_types.CompilerIrSwitchCaseList.Array seq)
      (compiler-backend-object-switch-table-cases
        parts
        label-scope
        table-label
        (compiler_ir_types.compiler-ir-switch-case-seq-to-list seq)
        index)]))

(define (compiler-backend-object-switch-table
  [parts : object_target.CompilerBackendObjectTargetParts]
  [label-scope : String]
  [current-label : i64]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]) : object_target.CompilerBackendObjectTargetParts
  (let
    [table-label : String
      (compiler-backend-switch-table-label label-scope current-label)]
    (compiler-backend-object-switch-table-cases
      (object_target.compiler-backend-object-add-rodata
        (object_target.compiler-backend-object-add-rodata
          (object_target.compiler-backend-object-symbol-local-section
            parts
            table-label
            (cobj.CompilerObjectSectionKind.Rodata)
            (cobj.CompilerObjectSymbolKind.Data))
          (cobj.CompilerObjectDataRecord.Align 8))
        (cobj.CompilerObjectDataRecord.Label table-label))
      label-scope
      table-label
      cases
      0)))

(define (compiler-backend-object-switch-dispatch
  [parts : object_target.CompilerBackendObjectTargetParts]
  [function-symbol : String]
  [label-scope : String]
  [current-label : i64]
  [index : compiler_ir_types.CompilerIrValue]
  [base : i64]
  [case-count : i64]
  [default-label : i64]
  [total-switch : bool]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (let
    [default-symbol : String
      (compiler-backend-asm-label label-scope default-label)]
    [table-label : String
      (compiler-backend-switch-table-label label-scope current-label)]
    [with-index : object_target.CompilerBackendObjectTargetParts
      (compiler-backend-object-load-value-to-reg
        parts
        function-symbol
        index
        "%rax"
        program-index)]
    [with-base : object_target.CompilerBackendObjectTargetParts
      (if (= base 0)
        with-index
        (object_target.compiler-backend-object-add-text
          with-index
          (cobj.CompilerObjectX64Instr.Bytes
            (compiler-backend-object-sub-imm32-rax-bytes base))))]
    [with-cmp : object_target.CompilerBackendObjectTargetParts
      (if total-switch
        with-base
        (object_target.compiler-backend-object-add-text
          with-base
          (cobj.CompilerObjectX64Instr.Bytes
            (compiler-backend-object-cmp-imm32-rax-bytes (- case-count 1)))))]
    [with-ja : object_target.CompilerBackendObjectTargetParts
      (if total-switch
        with-cmp
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            with-cmp
            function-symbol
            (cobj.CompilerObjectRelocationKind.Branch)
            default-symbol)
          (cobj.CompilerObjectX64Instr.Ja default-symbol)))]
    [with-table : object_target.CompilerBackendObjectTargetParts
      (object_target.compiler-backend-object-add-text
        (object_target.compiler-backend-object-add-text-relocation
          with-ja
          function-symbol
          (cobj.CompilerObjectRelocationKind.RipAddress)
          table-label)
        (cobj.CompilerObjectX64Instr.LoadRipAddressR11 table-label))]
    (object_target.compiler-backend-object-add-text
      with-table
      (cobj.CompilerObjectX64Instr.Bytes
        (compiler-backend-object-switch-indirect-jump-bytes)))))

(define (compiler-backend-object-switch
  [parts : object_target.CompilerBackendObjectTargetParts]
  [function-symbol : String]
  [label-scope : String]
  [current-label : i64]
  [index : compiler_ir_types.CompilerIrValue]
  [base : i64]
  [cases : compiler_ir_types.CompilerIrSwitchCaseList]
  [default-label : i64]
  [trap-label : i64]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (let
    ;; Decide before the table walker consumes its case-list cursor.
    [total-switch : bool
      (compiler-backend-object-total-switch? base cases trap-label)]
    [case-count : i64 (compiler-backend-switch-case-count cases)]
    (compiler-backend-object-switch-dispatch
      (compiler-backend-object-switch-table
        parts
        label-scope
        current-label
        cases)
      function-symbol
      label-scope
      current-label
      index
      base
      case-count
      default-label
      total-switch
      program-index)))

(define (compiler-backend-object-divmod-bytes
  [signed : bool]
  [remainder : bool]) : String
  (object_target.compiler-backend-object-bytes-from-hex
    (cond
      ;; cqo; idivq %r8; optionally movq %rdx, %rax
      [(and signed remainder) "489949f7f84889d0"]
      [signed "489949f7f8"]
      ;; xorl %edx, %edx; divq %r8; optionally movq %rdx, %rax
      [remainder "31d249f7f04889d0"]
      [else "31d249f7f0"])))

(define (compiler-backend-object-binop-bytes
  [op : compiler_ir_types.CompilerIrBinOp]
  [ty : compiler_ast_types.AstType]) : String
  (match op
    [(compiler_ir_types.CompilerIrBinOp.Add)
      (object_target.compiler-backend-object-bytes-from-hex "4c01c0")]
    [(compiler_ir_types.CompilerIrBinOp.Sub)
      (object_target.compiler-backend-object-bytes-from-hex "4c29c0")]
    [(compiler_ir_types.CompilerIrBinOp.Mul)
      (object_target.compiler-backend-object-bytes-from-hex "490fafc0")]
    [(compiler_ir_types.CompilerIrBinOp.Div)
      (compiler-backend-object-divmod-bytes
        (compiler-backend-type-signed? ty)
        false)]
    [(compiler_ir_types.CompilerIrBinOp.Mod)
      (compiler-backend-object-divmod-bytes
        (compiler-backend-type-signed? ty)
        true)]
    [(compiler_ir_types.CompilerIrBinOp.Eq)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f94c0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.Ne)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f95c0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.Lt)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f9cc0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.Le)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f9ec0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.Gt)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f9fc0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.Ge)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c39c00f9dc0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.BitTestEq)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c85c00f94c0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.BitTestNe)
      (object_target.compiler-backend-object-bytes-from-hex
        "4c85c00f95c0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.And)
      (object_target.compiler-backend-object-bytes-from-hex "4c21c0")]
    [(compiler_ir_types.CompilerIrBinOp.Or)
      (object_target.compiler-backend-object-bytes-from-hex "4c09c0")]
    [(compiler_ir_types.CompilerIrBinOp.BitAnd)
      (object_target.compiler-backend-object-bytes-from-hex "4c21c0")]
    [(compiler_ir_types.CompilerIrBinOp.BitOr)
      (object_target.compiler-backend-object-bytes-from-hex "4c09c0")]
    [(compiler_ir_types.CompilerIrBinOp.BitXor)
      (object_target.compiler-backend-object-bytes-from-hex "4c31c0")]
    [_ ""]))

(define (compiler-backend-object-zero-compare-bytes
  [op : compiler_ir_types.CompilerIrBinOp]) : String
  (match op
    [(compiler_ir_types.CompilerIrBinOp.Eq)
      (object_target.compiler-backend-object-bytes-from-hex
        "4885c00f94c0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.Ne)
      (object_target.compiler-backend-object-bytes-from-hex
        "4885c00f95c0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.Lt)
      (object_target.compiler-backend-object-bytes-from-hex
        "4885c00f9cc0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.Le)
      (object_target.compiler-backend-object-bytes-from-hex
        "4885c00f9ec0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.Gt)
      (object_target.compiler-backend-object-bytes-from-hex
        "4885c00f9fc0480fb6c0")]
    [(compiler_ir_types.CompilerIrBinOp.Ge)
      (object_target.compiler-backend-object-bytes-from-hex
        "4885c00f9dc0480fb6c0")]
    [_ ""]))

(define (compiler-backend-object-binop
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs : compiler_ir_types.CompilerIrValue]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (let
    [op-bytes : String
      (if (match rhs
        [(compiler_ir_types.CompilerIrValue.I64 value)
          (and (= value 0) (compiler-backend-compare-uses-zero-test? op))]
        [_ false])
        (compiler-backend-object-zero-compare-bytes op)
        (compiler-backend-object-binop-bytes op ty))]
    (if (or
      (= (string.string-length op-bytes) 0)
      (compiler-backend-float-type? ty))
      (compiler-backend-object-value-ref-with-type
        (compiler-backend-object-value-ref-with-type
          parts
          site
          lhs
          ty
          program-index)
        site
        rhs
        ty
        program-index)
      (compiler-backend-object-store-reg-to-var
        (compiler-backend-object-add-nonempty-bytes
          (compiler-backend-object-load-value-to-reg
            (compiler-backend-object-load-value-to-reg
              parts
              site
              rhs
              "%r8"
              program-index)
            site
            lhs
            "%rax"
            program-index)
          op-bytes)
        dst
        "%rax"))))

(define (compiler-backend-object-scalar-select
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [dst : i64]
  [condition : compiler_ir_types.CompilerIrValue]
  [on-true : compiler_ir_types.CompilerIrValue]
  [on-false : compiler_ir_types.CompilerIrValue]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  ;; Object emission keeps scalar vars in frame homes, so fixed temporaries are
  ;; safe here: false -> rax, true -> r8, condition -> r11, then cmovne.
  (compiler-backend-object-store-reg-to-var
    (compiler-backend-object-add-nonempty-bytes
      (compiler-backend-object-load-value-to-reg
        (compiler-backend-object-load-value-to-reg
          (compiler-backend-object-load-value-to-reg
            parts
            site
            on-false
            "%rax"
            program-index)
          site
          on-true
          "%r8"
          program-index)
        site
        condition
        "%r11"
        program-index)
      (object_target.compiler-backend-object-bytes-from-hex "4d85db490f45c0"))
    dst
    "%rax"))

(define (compiler-backend-object-call-arg-reg
  [target : CompilerBackendTarget]
  [index : i64]) : String
  (match (compiler-backend-target-arg-reg target index)
    [(ResultBackendReg.Ok reg) reg]
    [(ResultBackendReg.Err _) "%rax"]))

(define (compiler-backend-object-call-reg-count
  [target : CompilerBackendTarget]) : i64
  (compiler-backend-call-register-count target))

(define (compiler-backend-object-call-stack-word-count
  [target : CompilerBackendTarget]
  [args : compiler_ir_types.CompilerIrCallArgs]) : i64
  (let
    [count : i64 (compiler-backend-call-args-count args)]
    [regs : i64 (compiler-backend-object-call-reg-count target)]
    (if (> count regs)
      (- count regs)
      0)))

(define (compiler-backend-object-call-space
  [target : CompilerBackendTarget]
  [args : compiler_ir_types.CompilerIrCallArgs]) : i64
  (match target
    [(CompilerBackendTarget.Linux) 0]
    [(CompilerBackendTarget.Windows)
      (compiler-backend-round-up-16
        (+
          (compiler-backend-outgoing-shadow-space target)
          (* 8 (compiler-backend-object-call-stack-word-count target args))))]))

(define (compiler-backend-object-call-stack-arg
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [site : String]
  [value : compiler_ir_types.CompilerIrValue]
  [stack-index : i64]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (compiler-backend-object-add-nonempty-bytes
    (compiler-backend-object-load-value-to-reg
      parts
      site
      value
      "%rax"
      program-index)
    (compiler-backend-object-store-rax-rsp-bytes
      (compiler-backend-outgoing-stack-arg-offset target stack-index))))

(define (compiler-backend-object-call-arg-moves
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [site : String]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [index : i64]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index (compiler-backend-call-args-count args))
    parts
    (if (>= index (compiler-backend-object-call-reg-count target))
      (match target
        [(CompilerBackendTarget.Linux) parts]
        [(CompilerBackendTarget.Windows)
          (compiler-backend-object-call-arg-moves
            (compiler-backend-object-call-stack-arg
              parts
              target
              site
              (compiler-backend-call-arg-at args index)
              (- index (compiler-backend-object-call-reg-count target))
              program-index)
            target
            site
            args
            (+ index 1)
            program-index)])
      (compiler-backend-object-call-arg-moves
        (compiler-backend-object-load-value-to-reg
          parts
          site
          (compiler-backend-call-arg-at args index)
          (compiler-backend-object-call-arg-reg target index)
          program-index)
        target
        site
        args
        (+ index 1)
        program-index))))

(define (compiler-backend-object-direct-call
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [site : String]
  [symbol : String]
  [args : compiler_ir_types.CompilerIrCallArgs]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (let
    [space : i64 (compiler-backend-object-call-space target args)]
    (compiler-backend-object-add-nonempty-bytes
      (object_target.compiler-backend-object-add-text
        (object_target.compiler-backend-object-add-text-relocation
          (compiler-backend-object-call-arg-moves
            (compiler-backend-object-add-nonempty-bytes
              parts
              (compiler-backend-object-sub-rsp-bytes space))
            target
            site
            args
            0
            program-index)
          site
          (cobj.CompilerObjectRelocationKind.Call)
          symbol)
        (cobj.CompilerObjectX64Instr.Call symbol))
      (compiler-backend-object-add-rsp-bytes space))))

(define (compiler-backend-object-param-spills
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [params : compiler_ir_types.CompilerIrParamList]
  [int-index : i64]) : object_target.CompilerBackendObjectTargetParts
  (match (compiler_ir_types.compiler-ir-param-list-force-cons params)
    [(compiler_ir_types.CompilerIrParamList.Nil) parts]
    [(compiler_ir_types.CompilerIrParamList.Array seq)
      (compiler-backend-object-param-spills
        parts
        target
        (compiler_ir_types.compiler-ir-param-seq-to-list seq)
        int-index)]
    [(compiler_ir_types.CompilerIrParamList.Cons param rest)
      (match param
        [(compiler_ir_types.CompilerIrParam.Param _ ty var-id)
          (if (compiler-backend-float-type? ty)
            (compiler-backend-object-param-spills
              parts
              target
              (__tl-box-place rest)
              int-index)
            (if (>= int-index (compiler-backend-object-call-reg-count target))
              (compiler-backend-object-param-spills
                (match target
                  [(CompilerBackendTarget.Linux) parts]
                  [(CompilerBackendTarget.Windows)
                    (compiler-backend-object-store-reg-to-var
                      (compiler-backend-object-add-nonempty-bytes
                        parts
                        (compiler-backend-object-load-rbp-disp-bytes
                          (compiler-backend-incoming-stack-arg-offset
                            target
                            (-
                              int-index
                              (compiler-backend-object-call-reg-count target)))
                          "%rax"))
                      var-id
                      "%rax")])
                target
                (__tl-box-place rest)
                (+ int-index 1))
              (compiler-backend-object-param-spills
                (compiler-backend-object-store-reg-to-var
                  parts
                  var-id
                  (compiler-backend-object-call-arg-reg target int-index))
                target
                (__tl-box-place rest)
                (+ int-index 1))))])]))

;; --- object-image phi edge copies --------------------------------------------
;;
;; The object emitter assigns every IR var its own rbp slot, so a phi whose
;; destination differs from an input needs a real copy on each incoming edge;
;; materializing the inputs and dropping the destination (the historical Phi
;; case) silently reads an uninitialized slot at the merge. Jump and Branch
;; terminators targeting a block with leading phis emit these copies before
;; transferring control; conditional edges are split into tiny edge blocks so
;; each edge's copies run only when that edge is taken. Copies are staged
;; through the stack (sources first, destinations after) so parallel-copy
;; cycles like a<-b, b<-a cannot clobber a pending source. Aggregate
;; (copy-group) phis keep the previous materialize-only behavior; the tlci
;; image path never lowers those.
(define (compiler-backend-object-phi-copy-list-count
  [copies : CompilerBackendPhiCopySeq]) : i64
  copies.len)

(define (compiler-backend-object-phi-copy-list-nil?
  [copies : CompilerBackendPhiCopySeq]) : bool
  (= copies.len 0))

;; Collected in instruction order; the stage/store walkers read it back to front
;; (compiler-backend-phi-copy-seq-rev-ref) to keep the old prepend order.
(define (compiler-backend-object-edge-phi-copies-scan
  [type-segment-bases : i64]
  [instrs : compiler_ir_types.CompilerIrInstrSeq]
  [program-index : CompilerBackendProgramIndex]
  [from-label : i64]
  [index : i64]) : CompilerBackendPhiCopySeq
  (let
    [out : CompilerBackendPhiCopySeq
      (compiler-backend-phi-copy-seq-with-capacity 0)]
    [i : i64 index]
    [n : i64 (compiler_ir_types.compiler-ir-instr-seq-count instrs)]
    (begin
      (while (< i n)
        (match (compiler_ir_types.compiler-ir-instr-seq-ref instrs i)
          [(compiler_ir_types.CompilerIrInstr.Phi dst inputs ty)
            (begin
              (match (compiler-backend-phi-input-value inputs from-label)
                [(ResultBackendValue.Ok value)
                  (if (compiler-backend-copy-group?
                    type-segment-bases
                    program-index
                    ty
                    dst
                    value)
                    unit
                    (compiler-backend-phi-copy-push!
                      (&mut out)
                      (CompilerBackendPhiCopy.Copy
                        dst
                        (CompilerBackendPhiSource.Value value)
                        ty)))]
                [(ResultBackendValue.Err _) unit])
              (set! i (+ i 1)))]
          [_ (set! i n)]))
      out)))

(define (compiler-backend-object-edge-phi-copies-seq
  [type-segment-bases : i64]
  [blocks : compiler_ir_types.CompilerIrBlockSeq]
  [program-index : CompilerBackendProgramIndex]
  [target-label : i64]
  [from-label : i64]
  [index : i64]) : CompilerBackendPhiCopySeq
  (if (>= index (compiler_ir_types.compiler-ir-block-seq-count blocks))
    (compiler-backend-phi-copy-seq-with-capacity 0)
    (match (compiler_ir_types.compiler-ir-block-seq-ref blocks index)
      [(compiler_ir_types.CompilerIrBlock.Block label instrs)
        (if (= label target-label)
          (compiler-backend-object-edge-phi-copies-scan
            type-segment-bases
            instrs
            program-index
            from-label
            0)
          (compiler-backend-object-edge-phi-copies-seq
            type-segment-bases
            blocks
            program-index
            target-label
            from-label
            (+ index 1)))])))

(define (compiler-backend-object-edge-phi-copies
  [type-segment-bases : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [program-index : CompilerBackendProgramIndex]
  [target-label : i64]
  [from-label : i64]) : CompilerBackendPhiCopySeq
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Nil)
      (compiler-backend-phi-copy-seq-with-capacity 0)]
    [(compiler_ir_types.CompilerIrBlockList.Cons block rest)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block label instrs)
          (if (= label target-label)
            (compiler-backend-object-edge-phi-copies-scan
              type-segment-bases
              instrs
              program-index
              from-label
              0)
            (compiler-backend-object-edge-phi-copies
              type-segment-bases
              (__tl-box-place rest)
              program-index
              target-label
              from-label))])]
    [(compiler_ir_types.CompilerIrBlockList.Array seq)
      (compiler-backend-object-edge-phi-copies-seq
        type-segment-bases
        seq
        program-index
        target-label
        from-label
        0)]))

(define (compiler-backend-object-emit-phi-copies-stage
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [copies : CompilerBackendPhiCopySeq]
  [index : i64]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index copies.len)
    parts
    (match (compiler-backend-phi-copy-seq-rev-ref copies index)
      [(CompilerBackendPhiCopy.Copy _ source ty)
        (match source
          [(CompilerBackendPhiSource.Value value)
            (compiler-backend-object-emit-phi-copies-stage
              (compiler-backend-object-add-nonempty-bytes
                (compiler-backend-object-load-value-to-reg-with-type
                  parts
                  site
                  value
                  ty
                  "%rax"
                  program-index)
                (compiler-backend-object-store-rax-rsp-bytes (* index 8)))
              site
              copies
              (+ index 1)
              program-index)]
          [(CompilerBackendPhiSource.Temp _)
            (compiler-backend-object-emit-phi-copies-stage
              parts
              site
              copies
              (+ index 1)
              program-index)])])))

(define (compiler-backend-object-emit-phi-copies-store
  [parts : object_target.CompilerBackendObjectTargetParts]
  [copies : CompilerBackendPhiCopySeq]
  [index : i64]) : object_target.CompilerBackendObjectTargetParts
  (if (>= index copies.len)
    parts
    (match (compiler-backend-phi-copy-seq-rev-ref copies index)
      [(CompilerBackendPhiCopy.Copy dst _ _)
        (compiler-backend-object-emit-phi-copies-store
          (compiler-backend-object-store-reg-to-var
            (compiler-backend-object-add-nonempty-bytes
              parts
              (compiler-backend-object-load-rax-rsp-bytes (* index 8)))
            dst
            "%rax")
          copies
          (+ index 1))])))

(define (compiler-backend-object-emit-phi-copies
  [parts : object_target.CompilerBackendObjectTargetParts]
  [site : String]
  [copies : CompilerBackendPhiCopySeq]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (let
    [count : i64 (compiler-backend-object-phi-copy-list-count copies)]
    (if (= count 0)
      parts
      (compiler-backend-object-add-nonempty-bytes
        (compiler-backend-object-emit-phi-copies-store
          (compiler-backend-object-emit-phi-copies-stage
            (compiler-backend-object-add-nonempty-bytes
              parts
              (compiler-backend-object-sub-rsp-bytes (* count 8)))
            site
            copies
            0
            program-index)
          copies
          0)
        (compiler-backend-object-add-rsp-bytes (* count 8))))))

(define (compiler-backend-object-instr
  [type-segment-bases : i64]
  [parts : object_target.CompilerBackendObjectTargetParts]
  [target : CompilerBackendTarget]
  [function : String]
  [label-scope : String]
  [current-label : i64]
  [blocks : compiler_ir_types.CompilerIrBlockList]
  [instr : compiler_ir_types.CompilerIrInstr]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]) : object_target.CompilerBackendObjectTargetParts
  (match instr
    [(compiler_ir_types.CompilerIrInstr.Mov dst src ty)
      (if (compiler-backend-copy-group?
        type-segment-bases
        program-index
        ty
        dst
        src)
        (compiler-backend-object-move-group-value-to-var
          parts
          function
          dst
          src
          program-index)
        (compiler-backend-object-move-value-to-var
          parts
          function
          dst
          src
          ty
          program-index))]
    [(compiler_ir_types.CompilerIrInstr.BinOp dst op lhs rhs ty)
      (compiler-backend-object-binop
        parts
        function
        dst
        op
        lhs
        rhs
        ty
        program-index)]
    [(compiler_ir_types.CompilerIrInstr.UnOp dst op src ty)
      (let
        [with-src : object_target.CompilerBackendObjectTargetParts
          (compiler-backend-object-value-ref-with-type
            parts
            function
            src
            ty
            program-index)]
        (if (and
          (compiler-backend-f64-type? ty)
          (match op
            [(compiler_ir_types.CompilerIrUnOp.Neg) true]
            [_ false]))
          (compiler-backend-object-store-reg-to-var
            (object_target.compiler-backend-object-add-rip-instr
              with-src
              function
              (cobj.CompilerObjectRelocationKind.RipValue)
              (compiler-backend-f64-sign-bit-label)
              (cobj.CompilerObjectX64Instr.XorpdRip
                (compiler-backend-f64-sign-bit-label)))
            dst
            "%rax")
          (compiler-backend-object-store-reg-to-var
            (compiler-backend-object-add-nonempty-bytes
              with-src
              (compiler-backend-object-unop-rax-bytes op))
            dst
            "%rax")))]
    [(compiler_ir_types.CompilerIrInstr.Call dst name args _)
      (let
        [call-target : String
          (compiler-backend-call-symbol-index name plan program-index)]
        (compiler-backend-object-store-reg-to-var
          (compiler-backend-object-direct-call
            parts
            target
            function
            call-target
            args
            program-index)
          dst
          "%rax"))]
    [(compiler_ir_types.CompilerIrInstr.CallIndirect _ callee args _)
      (compiler-backend-object-call-args
        (compiler-backend-object-value-ref parts function callee program-index)
        function
        args
        0
        program-index)]
    [(compiler_ir_types.CompilerIrInstr.CallIndirectC dst callee args _)
      ;; Mirror object-direct-call, with the callee loaded into %r11 after
      ;; the argument moves (load-value-to-reg scratches through %rax, and
      ;; %r11 survives the C argument registers), an indirect call, and the
      ;; result stored from %rax.
      (let
        [space : i64 (compiler-backend-object-call-space target args)]
        (compiler-backend-object-store-reg-to-var
          (compiler-backend-object-add-nonempty-bytes
            (object_target.compiler-backend-object-add-text
              (compiler-backend-object-load-value-to-reg
                (compiler-backend-object-call-arg-moves
                  (compiler-backend-object-add-nonempty-bytes
                    parts
                    (compiler-backend-object-sub-rsp-bytes space))
                  target
                  function
                  args
                  0
                  program-index)
                function
                callee
                "%r11"
                program-index)
              (cobj.CompilerObjectX64Instr.Bytes
                (compiler-backend-object-call-r11-bytes)))
            (compiler-backend-object-add-rsp-bytes space))
          dst
          "%rax"))]
    [(compiler_ir_types.CompilerIrInstr.CallCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [name (__tl-project-field (__tl-box-place payload-box) name)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        [call-target : String
          (compiler-backend-call-symbol-index name plan program-index)]
        (compiler-backend-object-direct-call
          (compiler-backend-object-value-ref parts function base program-index)
          target
          function
          call-target
          args
          program-index))]
    [(compiler_ir_types.CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (let
        [base (__tl-project-field (__tl-box-place payload-box) base)]
        [callee (__tl-project-field (__tl-box-place payload-box) callee)]
        [args (__tl-project-field (__tl-box-place payload-box) args)]
        (compiler-backend-object-call-args
          (compiler-backend-object-value-ref
            (compiler-backend-object-value-ref
              parts
              function
              base
              program-index)
            function
            callee
            program-index)
          function
          args
          0
          program-index))]
    [(compiler_ir_types.CompilerIrInstr.TailCall name args _)
      (let
        [call-target : String
          (compiler-backend-call-symbol-index name plan program-index)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            (compiler-backend-object-add-nonempty-bytes
              (compiler-backend-object-call-arg-moves
                parts
                target
                function
                args
                0
                program-index)
              (compiler-backend-object-leave-bytes))
            function
            (cobj.CompilerObjectRelocationKind.TailCall)
            call-target)
          (cobj.CompilerObjectX64Instr.TailCall call-target)))]
    [(compiler_ir_types.CompilerIrInstr.Store name value ty)
      (let
        [symbol : String
          (compiler-backend-state-user-symbol-id
            program-index.backend-state
            name)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            (compiler-backend-object-load-value-to-reg-with-type
              parts
              function
              value
              ty
              "%rax"
              program-index)
            function
            (cobj.CompilerObjectRelocationKind.RipAddress)
            symbol)
          (cobj.CompilerObjectX64Instr.StoreRip symbol)))]
    [(compiler_ir_types.CompilerIrInstr.Jump target)
      (let
        [symbol : String (compiler-backend-asm-label label-scope target)]
        (object_target.compiler-backend-object-add-text
          (object_target.compiler-backend-object-add-text-relocation
            (compiler-backend-object-emit-phi-copies
              parts
              function
              (compiler-backend-object-edge-phi-copies
                type-segment-bases
                blocks
                program-index
                target
                current-label)
              program-index)
            function
            (cobj.CompilerObjectRelocationKind.Branch)
            symbol)
          (cobj.CompilerObjectX64Instr.Jump symbol)))]
    [(compiler_ir_types.CompilerIrInstr.Branch cond true-label false-label)
      (let
        [true-symbol : String
          (compiler-backend-asm-label label-scope true-label)]
        [false-symbol : String
          (compiler-backend-asm-label label-scope false-label)]
        [true-copies : CompilerBackendPhiCopySeq
          (compiler-backend-object-edge-phi-copies
            type-segment-bases
            blocks
            program-index
            true-label
            current-label)]
        [false-copies : CompilerBackendPhiCopySeq
          (compiler-backend-object-edge-phi-copies
            type-segment-bases
            blocks
            program-index
            false-label
            current-label)]
        (if (and
          (compiler-backend-object-phi-copy-list-nil? true-copies)
          (compiler-backend-object-phi-copy-list-nil? false-copies))
          (object_target.compiler-backend-object-add-text
            (object_target.compiler-backend-object-add-text-relocation
              (object_target.compiler-backend-object-add-text-relocation
                (compiler-backend-object-load-value-to-reg
                  parts
                  function
                  cond
                  "%rax"
                  program-index)
                function
                (cobj.CompilerObjectRelocationKind.Branch)
                true-symbol)
              function
              (cobj.CompilerObjectRelocationKind.Branch)
              false-symbol)
            (cobj.CompilerObjectX64Instr.Branch true-symbol false-symbol))
          (let
            [true-edge : String
              (compiler-backend-asm-label
                label-scope
                (compiler_ir_types.compiler-ir-label
                  (str_cat.str-cat
                    (compiler_ir_types.compiler-ir-label-text current-label)
                    ".phit")))]
            [false-edge : String
              (compiler-backend-asm-label
                label-scope
                (compiler_ir_types.compiler-ir-label
                  (str_cat.str-cat
                    (compiler_ir_types.compiler-ir-label-text current-label)
                    ".phif")))]
            (object_target.compiler-backend-object-add-text
              (object_target.compiler-backend-object-add-text-relocation
                (compiler-backend-object-emit-phi-copies
                  (object_target.compiler-backend-object-add-text
                    (object_target.compiler-backend-object-symbol-local-section
                      (object_target.compiler-backend-object-add-text
                        (object_target.compiler-backend-object-add-text-relocation
                          (compiler-backend-object-emit-phi-copies
                            (object_target.compiler-backend-object-add-text
                              (object_target.compiler-backend-object-symbol-local-section
                                (object_target.compiler-backend-object-add-text
                                  (object_target.compiler-backend-object-add-text-relocation
                                    (object_target.compiler-backend-object-add-text-relocation
                                      (compiler-backend-object-load-value-to-reg
                                        parts
                                        function
                                        cond
                                        "%rax"
                                        program-index)
                                      function
                                      (cobj.CompilerObjectRelocationKind.Branch)
                                      true-edge)
                                    function
                                    (cobj.CompilerObjectRelocationKind.Branch)
                                    false-edge)
                                  (cobj.CompilerObjectX64Instr.Branch
                                    true-edge
                                    false-edge))
                                true-edge
                                (cobj.CompilerObjectSectionKind.Text)
                                (cobj.CompilerObjectSymbolKind.Function))
                              (cobj.CompilerObjectX64Instr.Label true-edge))
                            function
                            true-copies
                            program-index)
                          function
                          (cobj.CompilerObjectRelocationKind.Branch)
                          true-symbol)
                        (cobj.CompilerObjectX64Instr.Jump true-symbol))
                      false-edge
                      (cobj.CompilerObjectSectionKind.Text)
                      (cobj.CompilerObjectSymbolKind.Function))
                    (cobj.CompilerObjectX64Instr.Label false-edge))
                  function
                  false-copies
                  program-index)
                function
                (cobj.CompilerObjectRelocationKind.Branch)
                false-symbol)
              (cobj.CompilerObjectX64Instr.Jump false-symbol)))))]
    [(compiler_ir_types.CompilerIrInstr.TotalEnumBranch
        cond
        true-label
        false-label)
      (compiler-backend-object-instr
        type-segment-bases
        parts
        target
        function
        label-scope
        current-label
        blocks
        (compiler_ir_types.CompilerIrInstr.Branch cond true-label false-label)
        plan
        program-index)]
    [(compiler_ir_types.CompilerIrInstr.Return value)
      (compiler-backend-object-add-nonempty-bytes
        (match value
          [(compiler_ir_types.CompilerIrMaybeValue.No)
            (if (string.eq function "main")
              (compiler-backend-object-add-nonempty-bytes
                parts
                (compiler-backend-object-zero-eax-bytes))
              parts)]
          [(compiler_ir_types.CompilerIrMaybeValue.Some inner)
            (compiler-backend-object-load-value-to-reg
              parts
              function
              inner
              "%rax"
              program-index)])
        (compiler-backend-object-leave-ret-bytes))]
