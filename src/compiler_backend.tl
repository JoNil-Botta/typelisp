;; The backend already has one complete, allocation-free instruction operand
;; walk for use counts. Reuse that walk when emission only needs the register
;; homes mentioned by one instruction instead of compiling a second giant
;; CompilerIrInstr match into the compiler. A zero-length count array selects
;; mask-only mode; ordinary use-count walks keep their existing behavior.
(define compiler-backend-use-home-mask-active : bool
  false)
(define compiler-backend-use-home-mask-value : i64
  0)
(define compiler-backend-use-home-mask-empty-counts : (Array i64)
  (make-array i64 0))

(define (compiler-backend-use-count-inc [counts : (Array i64)] [var : i64]) : unit
  (if (< var 0)
    unit
    (begin
      (if compiler-backend-use-home-mask-active
        (set!
          compiler-backend-use-home-mask-value
          (bit-or
            compiler-backend-use-home-mask-value
            (compiler-backend-scavenge-reg-bit
              (compiler-backend-var-register-home-index
                compiler-backend-scavenge-ctx-assignment-index
                var))))
        unit)
      (if (>= var (array-length counts))
        unit
        (begin
          (array-set! counts var (+ (array-ref counts var) 1))
          unit)))))

(define (compiler-backend-count-value-use
  [counts : (Array i64)]
  [value : CompilerIrValue]) : unit
  (match value
    [(CompilerIrValue.Var id) (compiler-backend-use-count-inc counts id)]
    [_ unit]))

(define (compiler-backend-count-value-list-uses
  [counts : (Array i64)]
  [values : CompilerIrValueList]) : unit
  (match values
    [(CompilerIrValueList.Nil) unit]
    [(CompilerIrValueList.Array seq)
      (compiler-backend-count-value-list-uses
        counts
        (compiler-ir-value-seq-to-list seq))]
    [(CompilerIrValueList.Cons value rest)
      (begin
        (compiler-backend-count-value-use counts value)
        (compiler-backend-count-value-list-uses counts (box-get rest)))]))

(define (compiler-backend-count-call-args-array-uses
  [counts : (Array i64)]
  [values : (Array CompilerIrValue)]
  [index : i64]) : unit
  (if (>= index (array-length values))
    unit
    (begin
      (compiler-backend-count-value-use counts (array-ref values index))
      (compiler-backend-count-call-args-array-uses counts values (+ index 1)))))

(define (compiler-backend-count-call-args-uses
  [counts : (Array i64)]
  [args : CompilerIrCallArgs]) : unit
  (match args
    [(CompilerIrCallArgs.Nil) unit]
    [(CompilerIrCallArgs.One value)
      (compiler-backend-count-value-use counts value)]
    [(CompilerIrCallArgs.Two a b)
      (begin
        (compiler-backend-count-value-use counts a)
        (compiler-backend-count-value-use counts b))]
    [(CompilerIrCallArgs.Array values)
      (compiler-backend-count-call-args-array-uses counts values 0)]))

(define (compiler-backend-count-spmd-call-args-uses
  [counts : (Array i64)]
  [args : CompilerIrSpmdCallArgList]) : unit
  (match args
    [(CompilerIrSpmdCallArgList.Nil) unit]
    [(CompilerIrSpmdCallArgList.Cons arg rest)
      (match arg
        [(CompilerIrSpmdCallArg.Arg _ value _)
          (begin
            (compiler-backend-count-value-use counts value)
            (compiler-backend-count-spmd-call-args-uses counts (box-get rest)))])]
    [(CompilerIrSpmdCallArgList.Array seq)
      (let
        [i : i64 0]
        [count : i64 (struct-get seq len)]
        [slots : (Array CompilerIrSpmdCallArg) (struct-get seq slots)]
        (while (< i count)
          (begin
            (match (array-ref slots i)
              [(CompilerIrSpmdCallArg.Arg _ value _)
                (compiler-backend-count-value-use counts value)])
            (set! i (+ i 1)))))]))

(define (compiler-backend-count-phi-input-uses
  [counts : (Array i64)]
  [inputs : CompilerIrPhiInputList]) : unit
  (match (compiler-ir-phi-input-list-force-cons inputs)
    [(CompilerIrPhiInputList.Nil) unit]
    [(CompilerIrPhiInputList.Array seq)
      (compiler-backend-count-phi-input-uses
        counts
        (compiler-ir-phi-input-seq-to-list seq))]
    [(CompilerIrPhiInputList.Cons value _ rest)
      (begin
        (compiler-backend-count-value-use counts value)
        (compiler-backend-count-phi-input-uses counts (box-get rest)))]))

(define (compiler-backend-count-instr-uses
  [counts : (Array i64)]
  [instr : CompilerIrInstr]) : unit
  (match instr
    [(CompilerIrInstr.Mov _ src _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.AddrOf _ src) (compiler-backend-use-count-inc counts src)]
    [(CompilerIrInstr.Gep _ base offset _)
      (begin
        (compiler-backend-count-value-use counts base)
        (compiler-backend-count-value-use counts offset))]
    [(CompilerIrInstr.Load _ src _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.StorePtr dst src _)
      (begin
        (compiler-backend-count-value-use counts dst)
        (compiler-backend-count-value-use counts src))]
    [(CompilerIrInstr.CopyBytes dst src _)
      (begin
        (compiler-backend-count-value-use counts dst)
        (compiler-backend-count-value-use counts src))]
    [(CompilerIrInstr.BoundsCheck index length _)
      (begin
        (compiler-backend-count-value-use counts index)
        (compiler-backend-count-value-use counts length))]
    [(CompilerIrInstr.Cast _ src _ _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.Bitcast _ src _ _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.BinOp _ _ lhs rhs _)
      (begin
        (compiler-backend-count-value-use counts lhs)
        (compiler-backend-count-value-use counts rhs))]
    [(CompilerIrInstr.UnOp _ _ src _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.Splat _ value _ _)
      (compiler-backend-count-value-use counts value)]
    [(CompilerIrInstr.VectorBinOp payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorBinOpPayload.Payload _ _ lhs rhs _ _)
          (begin
            (compiler-backend-count-value-use counts lhs)
            (compiler-backend-count-value-use counts rhs))])]
    [(CompilerIrInstr.VectorPrefix payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorPrefixPayload.Payload _ _ src carry _ _)
          (begin
            (compiler-backend-count-value-use counts src)
            (compiler-backend-count-value-use counts carry))])]
    [(CompilerIrInstr.VectorReduce _ _ src _ _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.VectorCompare payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorComparePayload.Payload _ _ lhs rhs _ _)
          (begin
            (compiler-backend-count-value-use counts lhs)
            (compiler-backend-count-value-use counts rhs))])]
    [(CompilerIrInstr.MaskBinOp _ _ lhs rhs _)
      (begin
        (compiler-backend-count-value-use counts lhs)
        (compiler-backend-count-value-use counts rhs))]
    [(CompilerIrInstr.MaskNot _ src _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.MaskReduce _ _ src _)
      (compiler-backend-count-value-use counts src)]
    [(CompilerIrInstr.Select payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSelectPayload.Payload _ mask on-true on-false _ _)
          (begin
            (compiler-backend-count-value-use counts mask)
            (compiler-backend-count-value-use counts on-true)
            (compiler-backend-count-value-use counts on-false))])]
    [(CompilerIrInstr.VectorLoad _ base index _ _)
      (begin
        (compiler-backend-count-value-use counts base)
        (compiler-backend-count-value-use counts index))]
    [(CompilerIrInstr.VectorStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorStorePayload.Payload base index value _ _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-value-use counts index)
            (compiler-backend-count-value-use counts value))])]
    [(CompilerIrInstr.PredicatedStore payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedStorePayload.Payload
            base
            index
            value
            mask
            _
            _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-value-use counts index)
            (compiler-backend-count-value-use counts value)
            (compiler-backend-count-value-use counts mask))])]
    [(CompilerIrInstr.PredicatedLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrPredicatedLoadPayload.Payload _ base index mask _ _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-value-use counts index)
            (compiler-backend-count-value-use counts mask))])]
    [(CompilerIrInstr.GatherLoad payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrGatherLoadPayload.Payload
            _
            base
            index-base
            index
            _
            _
            _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-value-use counts index-base)
            (compiler-backend-count-value-use counts index))])]
    [(CompilerIrInstr.VectorShuffle payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrVectorShufflePayload.Payload
            _
            source
            selector-low
            selector-high
            active-lanes
            _
            _)
          (begin
            (compiler-backend-count-value-use counts source)
            (compiler-backend-count-value-use counts selector-low)
            (match selector-high
              [(CompilerIrMaybeValue.Some value)
                (compiler-backend-count-value-use counts value)]
              [(CompilerIrMaybeValue.No) unit])
            (compiler-backend-count-value-use counts active-lanes))])]
    [(CompilerIrInstr.TailMask _ index length _)
      (begin
        (compiler-backend-count-value-use counts index)
        (compiler-backend-count-value-use counts length))]
    [(CompilerIrInstr.EntryArgc _) unit]
    [(CompilerIrInstr.EntryArgv _) unit]
    [(CompilerIrInstr.EntryEnvp _) unit]
    [(CompilerIrInstr.CpuId _ leaf subleaf _)
      (begin
        (compiler-backend-count-value-use counts leaf)
        (compiler-backend-count-value-use counts subleaf))]
    [(CompilerIrInstr.Xgetbv _ index)
      (compiler-backend-count-value-use counts index)]
    [(CompilerIrInstr.Syscall _ args)
      (compiler-backend-count-call-args-uses counts args)]
    [(CompilerIrInstr.Call _ _ args _)
      (compiler-backend-count-call-args-uses counts args)]
    [(CompilerIrInstr.CallIndirect _ callee args _)
      (begin
        (compiler-backend-count-value-use counts callee)
        (compiler-backend-count-call-args-uses counts args))]
    [(CompilerIrInstr.CallIndirectC _ callee args _)
      (begin
        (compiler-backend-count-value-use counts callee)
        (compiler-backend-count-call-args-uses counts args))]
    [(CompilerIrInstr.CallCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallCAbiStoreResultPayload.Payload base _ args _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-call-args-uses counts args))])]
    [(CompilerIrInstr.CallIndirectCAbiStoreResult payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrCallIndirectCAbiStoreResultPayload.Payload
            base
            callee
            args
            _)
          (begin
            (compiler-backend-count-value-use counts base)
            (compiler-backend-count-value-use counts callee)
            (compiler-backend-count-call-args-uses counts args))])]
    [(CompilerIrInstr.SpmdCall payload-box)
      (match (box-get payload-box)
        [(CompilerIrInstrSpmdCallPayload.Payload _ _ _ active-mask args _)
          (begin
            (compiler-backend-count-value-use counts active-mask)
            (compiler-backend-count-spmd-call-args-uses counts args))])]
    [(CompilerIrInstr.TailCall _ args _)
      (compiler-backend-count-call-args-uses counts args)]
    [(CompilerIrInstr.TailCallIndirect callee args _)
      (begin
        (compiler-backend-count-value-use counts callee)
        (compiler-backend-count-call-args-uses counts args))]
    [(CompilerIrInstr.Store _ value _)
      (compiler-backend-count-value-use counts value)]
    [(CompilerIrInstr.Branch cond _ _)
      (compiler-backend-count-value-use counts cond)]
    [(CompilerIrInstr.Return maybe)
      (match maybe
        [(CompilerIrMaybeValue.No) unit]
        [(CompilerIrMaybeValue.Some value)
          (compiler-backend-count-value-use counts value)])]
    [(CompilerIrInstr.Phi _ inputs _)
      (compiler-backend-count-phi-input-uses counts inputs)]
    ;; Register-group instrs: count their operand uses so the
    ;; single-use fusion peepholes cannot elide the home store of a var a
    ;; Pack/Word still reads (-O2 copy-prop substitutes vars directly into
    ;; Pack/Word operands).
    [(CompilerIrInstr.Pack _ words _)
      (compiler-backend-count-value-list-uses counts words)]
    [(CompilerIrInstr.Word _ src _ _)
      (compiler-backend-count-value-use counts src)]
    ;; Operand-free IR instructions intentionally add no value uses.
    [(CompilerIrInstr.Alloc _ _) unit]
    [(CompilerIrInstr.LaneId _ _ _) unit]
    [(CompilerIrInstr.EntryArgc _) unit]
    [(CompilerIrInstr.EntryArgv _) unit]
    [(CompilerIrInstr.EntryEnvp _) unit]
    [(CompilerIrInstr.Jump _) unit]
    [(CompilerIrInstr.Switch index _ _ _)
      (compiler-backend-count-value-use counts index)]))

(define (compiler-backend-count-instr-seq-uses
  [counts : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-backend-count-instr-uses counts (array-ref slots index))
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-count-block-uses
  [counts : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-backend-count-instr-seq-uses counts instrs)
            (compiler-backend-count-block-uses counts (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-count-block-seq-uses counts seq)]))

(define (compiler-backend-count-block-seq-uses
  [counts : (Array i64)]
  [blocks : CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-block-seq-count blocks)]
    (begin
      (while (< index count)
        (begin
          (match (compiler-ir-block-seq-ref blocks index)
            [(CompilerIrBlock.Block _ instrs)
              (compiler-backend-count-instr-seq-uses counts instrs)])
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-function-use-counts
  [vars : i64]
  [blocks : CompilerIrBlockList]) : (Array i64)
  (let
    [counts : (Array i64) (array.make-array i64 vars)]
    (begin
      (compiler-backend-count-block-uses counts blocks)
      counts)))

(define (compiler-backend-var-single-use? [counts : (Array i64)] [var : i64]) : bool
  (if (< var 0)
    false
    (if (>= var (array-length counts))
      false
      (= (array-ref counts var) 1))))

;; Dead result-store elision: true when `var` is read by NO instruction in the
;; final emitted IR (use count 0 over emit-blocks-list, the post-rewrite
;; post-coloring blocks the emitter walks). Every operand read counts as a use,
;; including IrInstrAddrOf's raw var id (compiler-backend-count-instr-uses), so
;; a never-used var's frame slot is unobservable: no reload, no address-taken
;; alias, no Pack/Word read. The runtime has no GC/stack-root walk and the
;; backend emits no per-slot unwind metadata, so skipping the slot store of such
;; a var (a call result whose value is ignored -- DCE cannot drop the call) is
;; behavior-preserving. Reads the per-function array installed by
;; compiler-backend-fuse-need-enable!; conservatively false when unset.
(define (compiler-backend-var-never-used? [var : i64]) : bool
  (cond
    [(not compiler-backend-fuse-need-ready) false]
    [(< var 0) false]
    [(>= var (array-length compiler-backend-fuse-use-counts)) false]
    [else (= (array-ref compiler-backend-fuse-use-counts var) 0)]))

;; True when every use of `var` is a branch fed by its own adjacent compare, so
;; the boolean is never needed as a materialized value and a compare->branch on
;; it may fuse. Holds when the var's total use count equals its free-branch
;; count. Reads the per-function arrays installed by
;; compiler-backend-fuse-need-enable!; conservatively false when unset.
(define (compiler-backend-var-fuse-safe? [var : i64]) : bool
  (cond
    [(not compiler-backend-fuse-need-ready) false]
    [(< var 0) false]
    [(>= var (array-length compiler-backend-fuse-free-counts)) false]
    [(>= var (array-length compiler-backend-fuse-use-counts)) false]
    [else
      (=
        (array-ref compiler-backend-fuse-use-counts var)
        (array-ref compiler-backend-fuse-free-counts var))]))

;; The branch condition var at slot `j` when that branch is fed by the
;; immediately preceding compare or boolean negation (a "free branch" whose
;; result need not be materialized); otherwise -1.
(define (compiler-backend-fuse-free-branch-var
  [slots : (Array CompilerIrInstr)]
  [j : i64]) : i64
  (if (<= j 0)
    (- 0 1)
    (match (array-ref slots j)
      [(CompilerIrInstr.Branch cond _ _)
        (match cond
          [(CompilerIrValue.Var v)
            (match (array-ref slots (- j 1))
              [(CompilerIrInstr.BinOp dst op _ _ _)
                (if (and (compiler-backend-compare-op? op) (= dst v))
                  v
                  (- 0 1))]
              [(CompilerIrInstr.UnOp dst (CompilerIrUnOp.Not) _ (AstType.Bool))
                (if (= dst v)
                  v
                  (- 0 1))]
              [_ (- 0 1)])]
          [_ (- 0 1)])]
      [_ (- 0 1)])))

(define (compiler-backend-count-instr-seq-use-facts
  [counts : (Array i64)]
  [free : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [n : i64 (struct-get instrs len)]
    [j : i64 0]
    (while (< j n)
      (begin
        (compiler-backend-count-instr-uses counts (array-ref slots j))
        (let
          [v : i64 (compiler-backend-fuse-free-branch-var slots j)]
          (if (and (>= v 0) (< v (array-length free)))
            (array-set! free v (+ (array-ref free v) 1))
            unit))
        (set! j (+ j 1))))))

(define (compiler-backend-count-block-use-facts
  [counts : (Array i64)]
  [free : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (begin
        (match block
          [(CompilerIrBlock.Block _ instrs)
            (compiler-backend-count-instr-seq-use-facts counts free instrs)])
        (compiler-backend-count-block-use-facts counts free (box-get rest)))]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-count-block-seq-use-facts counts free seq)]))

(define (compiler-backend-count-block-seq-use-facts
  [counts : (Array i64)]
  [free : (Array i64)]
  [blocks : CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-block-seq-count blocks)]
    (begin
      (while (< index count)
        (begin
          (match (compiler-ir-block-seq-ref blocks index)
            [(CompilerIrBlock.Block _ instrs)
              (compiler-backend-count-instr-seq-use-facts counts free instrs)])
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-fuse-need-enable!
  [use-counts : (Array i64)]
  [free-counts : (Array i64)]) : unit
  (begin
    (set! compiler-backend-fuse-use-counts use-counts)
    (set! compiler-backend-fuse-free-counts free-counts)
    (set! compiler-backend-fuse-need-ready true)))

(define (compiler-backend-fuse-need-disable!) : unit
  (begin
    (set! compiler-backend-fuse-need-ready false)
    (set! compiler-backend-fuse-use-counts (array.make-array i64 0))
    (set! compiler-backend-fuse-free-counts (array.make-array i64 0))))

(define (compiler-backend-addr-of-forwarding-fill!
  [items : (Array i64)]
  [index : i64]) : unit
  (if (>= index (array-length items))
    unit
    (begin
      (array-set! items index (- 0 1))
      (compiler-backend-addr-of-forwarding-fill! items (+ index 1)))))

(define (compiler-backend-addr-of-forwarding-record!
  [items : (Array i64)]
  [use-counts : (Array i64)]
  [instr : CompilerIrInstr]) : unit
  (match instr
    [(CompilerIrInstr.AddrOf dst src)
      (if (and
        (>= dst 0)
        (< dst (array-length items))
        (compiler-backend-var-single-use? use-counts dst))
        (array-set! items dst src)
        unit)]
    [(CompilerIrInstr.Mov dst src _)
      (match src
        [(CompilerIrValue.Var src-var)
          (let
            [forward-src : i64
              (if (and (>= src-var 0) (< src-var (array-length items)))
                (array-ref items src-var)
                (- 0 1))]
            (if (and
              (>= forward-src 0)
              (>= dst 0)
              (< dst (array-length items))
              (compiler-backend-var-single-use? use-counts dst))
              (array-set! items dst forward-src)
              unit))]
        [_ unit])]
    [_ unit]))

(define (compiler-backend-addr-of-forwarding-record-seq!
  [items : (Array i64)]
  [use-counts : (Array i64)]
  [instrs : CompilerIrInstrSeq]) : unit
  (let
    [slots : (Array CompilerIrInstr) (struct-get instrs slots)]
    [count : i64 (struct-get instrs len)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (compiler-backend-addr-of-forwarding-record!
            items
            use-counts
            (array-ref slots index))
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-addr-of-forwarding-record-blocks!
  [items : (Array i64)]
  [use-counts : (Array i64)]
  [blocks : CompilerIrBlockList]) : unit
  (match blocks
    [(CompilerIrBlockList.Nil) unit]
    [(CompilerIrBlockList.Cons block rest)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (begin
            (compiler-backend-addr-of-forwarding-record-seq!
              items
              use-counts
              instrs)
            (compiler-backend-addr-of-forwarding-record-blocks!
              items
              use-counts
              (box-get rest)))])]
    [(CompilerIrBlockList.Array seq)
      (compiler-backend-addr-of-forwarding-record-block-seq!
        items
        use-counts
        seq)]))

(define (compiler-backend-addr-of-forwarding-record-block-seq!
  [items : (Array i64)]
  [use-counts : (Array i64)]
  [blocks : CompilerIrBlockSeq]) : unit
  (let
    [index : i64 0]
    [count : i64 (compiler-ir-block-seq-count blocks)]
    (begin
      (while (< index count)
        (begin
          (match (compiler-ir-block-seq-ref blocks index)
            [(CompilerIrBlock.Block _ instrs)
              (compiler-backend-addr-of-forwarding-record-seq!
                items
                use-counts
                instrs)])
          (set! index (+ index 1))))
      unit)))

(define (compiler-backend-addr-of-forwarding-enable!
  [vars : i64]
  [blocks : CompilerIrBlockList]
  [use-counts : (Array i64)]) : unit
  (let
    [items : (Array i64) (array.make-array i64 vars)]
    (begin
      (compiler-backend-addr-of-forwarding-fill! items 0)
      (compiler-backend-addr-of-forwarding-record-blocks!
        items
        use-counts
        blocks)
      (set! compiler-backend-addr-of-forwarding-src items)
      (set! compiler-backend-addr-of-forwarding-enabled true))))

(define (compiler-backend-addr-of-forwarding-disable!) : unit
  (begin
    (set! compiler-backend-addr-of-forwarding-enabled false)
    (set! compiler-backend-addr-of-forwarding-src (array.make-array i64 0))))

(define (compiler-backend-branch-uses-var? [cond : CompilerIrValue] [var : i64]) : bool
  (match cond
    [(CompilerIrValue.Var id) (= id var)]
    [_ false]))

(define (compiler-backend-rest-starts-load-compare-branch?
  [rest : CompilerIrInstrList]
  [load-dst : i64]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [use-counts : (Array i64)]) : bool
  (match rest
    [(CompilerIrInstrList.Cons maybe-cmp after-cmp)
      (match maybe-cmp
        [(CompilerIrInstr.BinOp cmp-dst op lhs rhs cmp-ty)
          (if (and
            (compiler-backend-compare-op? op)
            (compiler-backend-branch-uses-var? lhs load-dst)
            (compiler-backend-var-single-use? use-counts cmp-dst)
            (not
              (compiler-backend-binop-f64? types global-types lhs rhs cmp-ty)))
            (match (box-get after-cmp)
              [(CompilerIrInstrList.Cons branch _)
                (match branch
                  [(CompilerIrInstr.Branch cond _ _)
                    (compiler-backend-branch-uses-var? cond cmp-dst)]
                  [_ false])]
              [_ false])
            false)]
        [_ false])]
    [_ false]))

(define (compiler-backend-fused-compare-fallthrough
  [rest : CompilerIrInstrList]
  [fallthrough : CompilerBackendMaybeLabel]) : CompilerBackendMaybeLabel
  (match rest
    [(CompilerIrInstrList.Nil) fallthrough]
    [_ (CompilerBackendMaybeLabel.No)]))

;; A block-terminator fusion (mov/call/binop directly into a return) emits the
;; whole tail of the block and does not recurse, so it appends the terminator's
;; asm after the instructions already emitted into the body buffer.
(define (compiler-backend-emit-terminator-into
  [result : ResultCompilerBackend]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match result
    [(ResultCompilerBackend.Ok asm)
      (begin
        (compiler-backend-emergency-append out asm)
        (ResultCompilerBackend.Ok ""))]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-instr-with-call-rax
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [rax-var : i64]
  [rax-ty : AstType]) : ResultCompilerBackend
  (let
    [arg-assignments : CompilerRegAssignmentList
      (compiler-backend-rax-call-arg-assignments
        ctx.type-segment-bases
        ctx.assignments
        ctx.program-index
        rax-var
        rax-ty)]
    ;; Mirror of the guard inside compiler-backend-rax-call-arg-assignments:
    ;; the var whose home the insert pins to %rax, or -1 when arg-assignments
    ;; is the unmodified list. Published to the dense-index override only for
    ;; the dynamic extent of a call that actually consumes arg-assignments.
    [rax-forward-pending : i64
      (if (and
        (>= rax-var 0)
        (compiler-backend-rax-call-arg-eligible?
          ctx.type-segment-bases
          ctx.program-index
          rax-ty))
        rax-var
        -1)]
    [instr-diag : CompilerDiagnostic
      (compiler-backend-instr-diagnostic
        ctx.spans
        ctx.source-function
        instr
        ctx.func-diag
        "")]
    ;; Sound-scavenger: reserve this instruction's operand + result homes so the
    ;; scavenge can never hand one back as scratch (LLVM RegScavenger model).
    [_reserved-mask : i64
      (begin
        (set!
          compiler-backend-current-instr-reserved-mask
          (compiler-backend-instr-reserved-home-mask instr))
        compiler-backend-current-instr-reserved-mask)]
    (match instr
      [(CompilerIrInstr.Call dst name args ty)
        (if (compiler-backend-call-leading-arg-uses-var? args rax-var)
          (let
            [rax-forward-result : ResultCompilerBackend
              (begin
                (set!
                  compiler-backend-rax-forward-pending-var
                  rax-forward-pending)
                (compiler-backend-emit-direct-call-with-arg-assignments
                  ctx.type-segment-bases
                  ctx.target
                  ctx.function
                  ctx.current-label
                  dst
                  name
                  args
                  ty
                  ctx.assignments
                  arg-assignments
                  (compiler-backend-scratch-plan-register-here
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0)
                  ctx.types
                  ctx.global-types
                  ctx.plan
                  ctx.externs
                  ctx.program-index
                  ctx.vars
                  instr-diag))]
            (begin
              (set! compiler-backend-rax-forward-pending-var -1)
              rax-forward-result))
          (compiler-backend-emit-instr ctx fallthrough instr))]
      [(CompilerIrInstr.CallIndirect dst func args ty)
        (if (compiler-backend-call-leading-arg-uses-var? args rax-var)
          (let
            [rax-forward-result : ResultCompilerBackend
              (begin
                (set!
                  compiler-backend-rax-forward-pending-var
                  rax-forward-pending)
                (compiler-backend-emit-indirect-call-with-arg-assignments
                  ctx.type-segment-bases
                  ctx.target
                  dst
                  func
                  args
                  ty
                  ctx.assignments
                  arg-assignments
                  (compiler-backend-scratch-plan-register-here
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0)
                  (compiler-backend-scratch-plan-register-here
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1)
                  ctx.types
                  ctx.functions
                  ctx.externs
                  ctx.program-index
                  ctx.vars
                  instr-diag))]
            (begin
              (set! compiler-backend-rax-forward-pending-var -1)
              rax-forward-result))
          (compiler-backend-emit-instr ctx fallthrough instr))]
      [_ (compiler-backend-emit-instr ctx fallthrough instr)])))

(define (compiler-backend-call-rax-forwardable-instr?
  [type-segment-bases : i64]
  [instr : CompilerIrInstr]
  [program-index : CompilerBackendProgramIndex]
  [rax-var : i64]
  [rax-ty : AstType]) : bool
  (and
    (compiler-backend-rax-call-arg-eligible?
      type-segment-bases
      program-index
      rax-ty)
    (match instr
      [(CompilerIrInstr.Call _ _ args _)
        (compiler-backend-call-leading-arg-uses-var? args rax-var)]
      [(CompilerIrInstr.CallIndirect _ _ args _)
        (compiler-backend-call-leading-arg-uses-var? args rax-var)]
      [_ false])))

(define (compiler-backend-append-located-instr
  [buf : text_buf.TextBuf]
  [location : String]
  [head : String]) : text_buf.TextBuf
  ;; A .loc/.cv_loc directive is metadata, not an instruction. Keep the
  ;; emergency save/restore pending until the executable head is appended.
  (text_buf.append
    (text_buf.append buf location)
    (compiler-backend-emergency-wrap head)))

(define (compiler-backend-emit-instrs-after-emitted
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [rest : CompilerIrInstrList]
  [head : String]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (begin
    ;; A .loc/.cv_loc directive is metadata, not an instruction. Append it
    ;; plainly and keep the emergency save/restore pending until the
    ;; executable head goes in (mirrors compiler-backend-append-located-instr
    ;; for the buffer spine).
    (let
      [location : String (compiler-backend-debug-instr-location ctx instr)]
      (if (> (string.string-length location) 0)
        (compiler-backend-asm-append out location)
        unit))
    (compiler-backend-emergency-append out head)
    (match instr
      [(CompilerIrInstr.Call dst _ _ ty)
        (compiler-backend-emit-instrs-with-call-rax
          ctx
          fallthrough
          dst
          ty
          rest
          out)]
      [(CompilerIrInstr.CallIndirect dst _ _ ty)
        (compiler-backend-emit-instrs-with-call-rax
          ctx
          fallthrough
          dst
          ty
          rest
          out)]
      [(CompilerIrInstr.CallIndirectC dst _ _ ty)
        (compiler-backend-emit-instrs-with-call-rax
          ctx
          fallthrough
          dst
          ty
          rest
          out)]
      [_ (compiler-backend-emit-instrs ctx fallthrough rest out)])))

(define (compiler-backend-emit-instrs-normal
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [instr : CompilerIrInstr]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (compiler-backend-emit-instr
    ctx
    (match rest
      [(CompilerIrInstrList.Nil) fallthrough]
      [_ (CompilerBackendMaybeLabel.No)])
    instr)
    [(ResultCompilerBackend.Ok head)
      (compiler-backend-emit-instrs-after-emitted
        ctx
        fallthrough
        instr
        rest
        head
        out)]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-fused-result-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [result : ResultCompilerBackend]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match result
    [(ResultCompilerBackend.Ok head)
      (begin
        (compiler-backend-asm-append out (compiler-backend-emergency-wrap head))
        (compiler-backend-emit-instrs ctx fallthrough rest out))]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-rax-forwardable-consumer?
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [assignments : CompilerRegAssignmentList]
  [rax-var : i64]
  [instr : CompilerIrInstr]) : bool
  (match instr
    [(CompilerIrInstr.BinOp _ op lhs rhs ty)
      (and
        (compiler-backend-rax-forwardable-binop?
          types
          global-types
          assignments
          op
          lhs
          rhs
          ty)
        (or
          (compiler-backend-branch-uses-var? lhs rax-var)
          (and
            (compiler-backend-branch-uses-var? rhs rax-var)
            (compiler-backend-commutative-binop? op))))]
    [(CompilerIrInstr.Mov _ src _)
      (compiler-backend-branch-uses-var? src rax-var)]
    [(CompilerIrInstr.Return maybe)
      (match maybe
        [(CompilerIrMaybeValue.Some value)
          (compiler-backend-branch-uses-var? value rax-var)]
        [(CompilerIrMaybeValue.No) false])]
    [_ false]))

(define (compiler-backend-rest-starts-rax-forwardable-consumer?
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [assignments : CompilerRegAssignmentList]
  [rax-var : i64]
  [rest : CompilerIrInstrList]) : bool
  (match rest
    [(CompilerIrInstrList.Cons instr _)
      (compiler-backend-rax-forwardable-consumer?
        types
        global-types
        assignments
        rax-var
        instr)]
    [(CompilerIrInstrList.Nil) false]))

(define (compiler-backend-emit-instrs-materialize-rax
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : AstType]
  [instrs : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (begin
    (compiler-backend-emit-store-typed-var-with-plan-into
      out
      ctx.assignments
      rax-var
      "%rax"
      rax-ty)
    (compiler-backend-emit-instrs ctx fallthrough instrs out)))

(define (compiler-backend-emit-instrs-with-rax-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : AstType]
  [instrs : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match instrs
    [(CompilerIrInstrList.Nil)
      (begin
        (compiler-backend-emit-store-typed-var-with-plan-into
          out
          ctx.assignments
          rax-var
          "%rax"
          rax-ty)
        (ResultCompilerBackend.Ok ""))]
    [(CompilerIrInstrList.Cons instr rest)
      (match instr
        [(CompilerIrInstr.BinOp dst op lhs rhs ty)
          (if (compiler-backend-rax-forwardable-consumer?
            ctx.types
            ctx.global-types
            ctx.assignments
            rax-var
            instr)
            (let
              [keep-live : bool
                (compiler-backend-var-single-use? ctx.use-counts dst)]
              (match (compiler-backend-emit-binop-with-rax-value
                ctx.type-segment-bases
                ctx.types
                ctx.global-types
                ctx.assignments
                rax-var
                dst
                op
                lhs
                rhs
                ty
                (not keep-live)
                (compiler-backend-scratch-plan-register-ahead
                  (compiler-backend-runtime-plan-scratch ctx.plan)
                  0
                  0)
                (compiler-backend-scratch-plan-register-ahead
                  (compiler-backend-runtime-plan-scratch ctx.plan)
                  0
                  1)
                (compiler-backend-scratch-plan-register-ahead
                  (compiler-backend-runtime-plan-scratch ctx.plan)
                  0
                  2)
                (compiler-backend-scratch-plan-register-ahead
                  (compiler-backend-runtime-plan-scratch ctx.plan)
                  0
                  3)
                (compiler-backend-scratch-plan-register-ahead
                  (compiler-backend-runtime-plan-scratch ctx.plan)
                  0
                  4))
                [(ResultCompilerBackend.Ok head)
                  (begin
                    (compiler-backend-asm-append
                      out
                      (compiler-backend-emergency-wrap head))
                    (if keep-live
                      (compiler-backend-emit-instrs-with-rax
                        ctx
                        fallthrough
                        dst
                        ty
                        (box-get rest)
                        out)
                      (compiler-backend-emit-instrs
                        ctx
                        fallthrough
                        (box-get rest)
                        out)))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)]))
            (compiler-backend-emit-instrs-materialize-rax
              ctx
              fallthrough
              rax-var
              rax-ty
              instrs
              out))]
        [(CompilerIrInstr.Mov dst src ty)
          (if (compiler-backend-branch-uses-var? src rax-var)
            (if (compiler-backend-var-single-use? ctx.use-counts dst)
              (compiler-backend-emit-instrs-with-rax
                ctx
                fallthrough
                dst
                ty
                (box-get rest)
                out)
              (begin
                (compiler-backend-emit-store-typed-var-with-plan-into
                  out
                  ctx.assignments
                  dst
                  "%rax"
                  ty)
                (compiler-backend-emit-instrs
                  ctx
                  fallthrough
                  (box-get rest)
                  out)))
            (compiler-backend-emit-instrs-materialize-rax
              ctx
              fallthrough
              rax-var
              rax-ty
              instrs
              out))]
        [(CompilerIrInstr.Return maybe)
          (match maybe
            [(CompilerIrMaybeValue.Some value)
              (if (and
                (compiler-backend-branch-uses-var? value rax-var)
                (match (box-get rest)
                  [(CompilerIrInstrList.Nil) true]
                  [_ false]))
                (begin
                  (compiler-backend-asm-append
                    out
                    (compiler-backend-return-tail
                      ctx.source-function
                      ctx.assignments
                      ctx.vars
                      ctx.blocks))
                  (ResultCompilerBackend.Ok ""))
                (compiler-backend-emit-instrs-materialize-rax
                  ctx
                  fallthrough
                  rax-var
                  rax-ty
                  instrs
                  out))]
            [(CompilerIrMaybeValue.No)
              (compiler-backend-emit-instrs-materialize-rax
                ctx
                fallthrough
                rax-var
                rax-ty
                instrs
                out)])]
        [_
          (compiler-backend-emit-instrs-materialize-rax
            ctx
            fallthrough
            rax-var
            rax-ty
            instrs
            out)])]))

(define (compiler-backend-emit-instrs-with-call-rax-step
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [rax-var : i64]
  [rax-ty : AstType]
  [instrs : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match instrs
    [(CompilerIrInstrList.Nil) (ResultCompilerBackend.Ok "")]
    [(CompilerIrInstrList.Cons instr rest)
      (if (compiler-backend-call-rax-forwardable-instr?
        ctx.type-segment-bases
        instr
        ctx.program-index
        rax-var
        rax-ty)
        (match (compiler-backend-emit-instr-with-call-rax
          ctx
          (match (box-get rest)
            [(CompilerIrInstrList.Nil) fallthrough]
            [_ (CompilerBackendMaybeLabel.No)])
          instr
          rax-var
          rax-ty)
          [(ResultCompilerBackend.Ok head)
            (compiler-backend-emit-instrs-after-emitted
              ctx
              fallthrough
              instr
              (box-get rest)
              head
              out)]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)])
        (compiler-backend-emit-instrs ctx fallthrough instrs out))]))

(define (compiler-backend-emit-fused-compare-branch-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : i64]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]
  [true-label : i64]
  [false-label : i64]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (compiler-backend-emit-compare-branch-with-phi-copies-with-plan
    ctx.type-segment-bases
    ctx.assignments
    ctx.function
    ctx.blocks
    ctx.current-label
    op
    lhs
    rhs
    (compiler-backend-binop-operand-ty ctx.types ctx.global-types op lhs rhs ty)
    true-label
    false-label
    (compiler-backend-fused-compare-fallthrough rest fallthrough)
    ctx.program-index
    ctx.vars
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      0
      0)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      0
      1)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      1
      1)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      1
      2))
    [(ResultCompilerBackend.Ok head)
      (begin
        (compiler-backend-asm-append out (compiler-backend-emergency-wrap head))
        (compiler-backend-emit-instrs ctx fallthrough rest out))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              ctx.spans
              ctx.source-function
              (CompilerIrInstr.BinOp dst op lhs rhs ty)
              ctx.func-diag
              ""))))]))

(define (compiler-backend-emit-fused-load-compare-branch-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [load-dst : i64]
  [ptr : CompilerIrValue]
  [load-ty : AstType]
  [_cmp-dst : i64]
  [op : CompilerIrBinOp]
  [rhs : CompilerIrValue]
  [_cmp-ty : AstType]
  [true-label : i64]
  [false-label : i64]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (compiler-backend-emit-load-compare-branch-with-phi-copies-with-plan
    ctx.type-segment-bases
    ctx.assignments
    ctx.function
    ctx.blocks
    ctx.current-label
    ptr
    op
    rhs
    load-ty
    true-label
    false-label
    (compiler-backend-fused-compare-fallthrough rest fallthrough)
    ctx.program-index
    ctx.vars
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      1
      0)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      1
      1)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      2
      1)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      2
      2))
    [(ResultCompilerBackend.Ok head)
      (begin
        (compiler-backend-asm-append out (compiler-backend-emergency-wrap head))
        (compiler-backend-emit-instrs ctx fallthrough rest out))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              ctx.spans
              ctx.source-function
              (CompilerIrInstr.Load load-dst ptr load-ty)
              ctx.func-diag
              ""))))]))

(define (compiler-backend-emit-fused-not-branch-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]
  [true-label : i64]
  [false-label : i64]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  ;; `not src` branches to its false successor when src is true. Emit the
  ;; source branch directly with reversed successors, including the matching
  ;; phi-edge copies, instead of materializing the inverted boolean.
  (match (compiler-backend-emit-branch-with-phi-copies-with-plan
    ctx.type-segment-bases
    ctx.assignments
    ctx.function
    ctx.blocks
    ctx.current-label
    src
    false-label
    true-label
    (compiler-backend-fused-compare-fallthrough rest fallthrough)
    ctx.program-index
    ctx.vars
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      1
      0)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      1
      1)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      1
      2))
    [(ResultCompilerBackend.Ok head)
      (begin
        (compiler-backend-asm-append out (compiler-backend-emergency-wrap head))
        (compiler-backend-emit-instrs ctx fallthrough rest out))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              ctx.spans
              ctx.source-function
              (CompilerIrInstr.UnOp dst (CompilerIrUnOp.Not) src ty)
              ctx.func-diag
              ""))))]))

(define (compiler-backend-emit-fused-gep-load-compare-branch-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-dst : i64]
  ;; GAP9: the fused compare consumes this gep's ordinal at the dispatch
  ;; site; the path is const-offset-only so the displacement is always 0.
  [_gep-fold-disp : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [_load-dst : i64]
  [load-ty : AstType]
  [_cmp-dst : i64]
  [op : CompilerIrBinOp]
  [rhs : CompilerIrValue]
  [_cmp-ty : AstType]
  [true-label : i64]
  [false-label : i64]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (compiler-backend-emit-gep-load-compare-branch-with-phi-copies-with-plan
    ctx.type-segment-bases
    ctx.assignments
    ctx.function
    ctx.blocks
    ctx.current-label
    base
    offset
    elem-ty
    op
    rhs
    load-ty
    true-label
    false-label
    (compiler-backend-fused-compare-fallthrough rest fallthrough)
    ctx.program-index
    ctx.vars
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      2
      0)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      2
      1)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      3
      1)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      3
      2))
    [(ResultCompilerBackend.Ok head)
      (begin
        (compiler-backend-asm-append out (compiler-backend-emergency-wrap head))
        (compiler-backend-emit-instrs ctx fallthrough rest out))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              ctx.spans
              ctx.source-function
              (CompilerIrInstr.Gep gep-dst base offset elem-ty)
              ctx.func-diag
              ""))))]))

;; GAP8: fold a single-use fused-load result straight into the consuming ALU
;; op's memory operand -- `movq (b,i,8), %t; addq %t, %acc` becomes
;; `addq (b,i,8), %acc` -- one instruction and one register shorter, exactly
;; clang's selection for reduction loops. The probe is PURE (no scavenges, so
;; a rejected fold leaks no emergency-pending registers -- the M-D lesson);
;; the emitter mirrors emit-load-from-gep's two addressing arms and appends
;; the ALU line instead of the load. The non-loaded operand lands in the ALU
;; dst's home FIRST, so the probe rejects any dst-home that aliases an
;; address operand home, and every scavenge excludes dst-home.
(defenum CompilerBackendGepLoadAluFold
  (No)
  (Some String i64 CompilerIrValue (Box CompilerIrInstrList)))

;; Two adjacent fused loads followed by a commutative ALU op can use the same
;; two-instruction shape as clang: load one memory operand straight into the
;; result home, then consume the other as the ALU memory operand. Keep this
;; direct-only (all address components and the result already register-homed),
;; so rejecting the fold has no scavenge or emergency-save side effects.
(defenum CompilerBackendGepLoadPairAluFold
  (No)
  (Some String i64 String String (Box CompilerIrInstrList)))

(define (compiler-backend-gep-load-pair-alu-mnemonic [op : CompilerIrBinOp]) : String
  (match op
    [(CompilerIrBinOp.Add) "add"]
    [(CompilerIrBinOp.Mul) "imul"]
    [(CompilerIrBinOp.BitAnd) "and"]
    [(CompilerIrBinOp.BitOr) "or"]
    [(CompilerIrBinOp.BitXor) "xor"]
    [_ ""]))

(define (compiler-backend-gep-load-pair-alu-probe
  [type-segment-bases : i64]
  [assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [use-counts : (Array i64)]
  [base : CompilerIrValue]
  [offset0 : CompilerIrValue]
  [elem-ty0 : AstType]
  [gep-disp0 : i64]
  [load-dst0 : i64]
  [load-ty0 : AstType]
  [offset1 : CompilerIrValue]
  [elem-ty1 : AstType]
  [gep-disp1 : i64]
  [load-dst1 : i64]
  [load-ty1 : AstType]
  [rest : CompilerIrInstrList]) : CompilerBackendGepLoadPairAluFold
  (match rest
    [(CompilerIrInstrList.Cons maybe-binop after-binop)
      (match maybe-binop
        [(CompilerIrInstr.BinOp dst op lhs rhs ty)
          (let
            [mnem : String (compiler-backend-gep-load-pair-alu-mnemonic op)]
            [dst-home : String
              (compiler-backend-var-register-home assignments dst)]
            [base-home : String
              (compiler-backend-address-base-filter
                (compiler-backend-value-scalar-register assignments base))]
            [index0-home : String
              (compiler-backend-value-scalar-register assignments offset0)]
            [index1-home : String
              (compiler-backend-value-scalar-register assignments offset1)]
            [scale0 : i64
              (compiler-backend-type-size type-segment-bases elem-ty0)]
            [scale1 : i64
              (compiler-backend-type-size type-segment-bases elem-ty1)]
            [addr0 : String
              (if (and
                (not (string.eq base-home ""))
                (not (string.eq index0-home "")))
                (compiler-backend-gep-index-address-disp
                  gep-disp0
                  base-home
                  scale0
                  index0-home)
                "")]
            [addr1 : String
              (if (and
                (not (string.eq base-home ""))
                (not (string.eq index1-home "")))
                (compiler-backend-gep-index-address-disp
                  gep-disp1
                  base-home
                  scale1
                  index1-home)
                "")]
            (if (and
              (not (string.eq mnem ""))
              (= (compiler-backend-type-size type-segment-bases load-ty0) 8)
              (= (compiler-backend-type-size type-segment-bases load-ty1) 8)
              (= (compiler-backend-type-size type-segment-bases ty) 8)
              (not (compiler-backend-float-type? load-ty0))
              (not (compiler-backend-float-type? load-ty1))
              (not (compiler-backend-binop-f64? types global-types lhs rhs ty))
              (compiler-backend-var-single-use? use-counts load-dst0)
              (compiler-backend-var-single-use? use-counts load-dst1)
              (or
                (and
                  (compiler-backend-branch-uses-var? lhs load-dst0)
                  (compiler-backend-branch-uses-var? rhs load-dst1))
                (and
                  (compiler-backend-branch-uses-var? lhs load-dst1)
                  (compiler-backend-branch-uses-var? rhs load-dst0)))
              (not (string.eq dst-home ""))
              (not (string.eq addr0 ""))
              (not (string.eq addr1 ""))
              (not (string.eq dst-home base-home))
              (not (string.eq dst-home index0-home))
              (not (string.eq dst-home index1-home)))
              (CompilerBackendGepLoadPairAluFold.Some
                mnem
                dst
                addr0
                addr1
                (box after-binop))
              (CompilerBackendGepLoadPairAluFold.No)))]
        [_ (CompilerBackendGepLoadPairAluFold.No)])]
    [_ (CompilerBackendGepLoadPairAluFold.No)]))

(define (compiler-backend-emit-gep-load-pair-alu
  [assignments : CompilerRegAssignmentList]
  [mnem : String]
  [dst : i64]
  [addr0 : String]
  [addr1 : String]) : ResultCompilerBackend
  (let
    [dst-home : String (compiler-backend-var-register-home assignments dst)]
    (ResultCompilerBackend.Ok
      (str_cat.str-cat
        "    movq "
        addr0
        ", "
        dst-home
        "\n    "
        mnem
        "q "
        addr1
        ", "
        dst-home
        "\n"))))

(defenum CompilerBackendMaybeGepLoadPairAluDivmodEmission
  (No)
  (Some ResultCompilerBackend))

(defenum CompilerBackendMaybeGepLoadPairAluDivmodStore
  (No)
  (Some
    i64
    CompilerIrValue
    CompilerIrValue
    AstType
    CompilerIrValue
    AstType
    (Box CompilerIrInstrList)))

(define (compiler-backend-gep-load-pair-alu-divmod-store-probe
  [ctx : CompilerBackendEmissionContext]
  [div-dst : i64]
  [src : String]
  [magic : String]
  [after-div : CompilerIrInstrList]) : CompilerBackendMaybeGepLoadPairAluDivmodStore
  (if (compiler-backend-var-single-use? ctx.use-counts div-dst)
    (match after-div
      [(CompilerIrInstrList.Cons maybe-gep after-gep)
        (match maybe-gep
          [(CompilerIrInstr.Gep gep-dst base offset elem-ty)
            (if (compiler-backend-var-single-use? ctx.use-counts gep-dst)
              (match (box-get after-gep)
                [(CompilerIrInstrList.Cons maybe-store after-store)
                  (match maybe-store
                    [(CompilerIrInstr.StorePtr store-ptr store-value store-ty)
                      (if (and
                        (compiler-backend-divmod-direct-gep-store?
                          ctx.type-segment-bases
                          ctx.assignments
                          div-dst
                          gep-dst
                          base
                          offset
                          elem-ty
                          store-ptr
                          store-value)
                        (compiler-backend-divmod-direct-gep-store-clobber-safe?
                          ctx.assignments
                          src
                          magic
                          base
                          offset))
                        (CompilerBackendMaybeGepLoadPairAluDivmodStore.Some
                          gep-dst
                          base
                          offset
                          elem-ty
                          store-value
                          store-ty
                          (box after-store))
                        (CompilerBackendMaybeGepLoadPairAluDivmodStore.No))]
                    [_ (CompilerBackendMaybeGepLoadPairAluDivmodStore.No)])]
                [_ (CompilerBackendMaybeGepLoadPairAluDivmodStore.No)])
              (CompilerBackendMaybeGepLoadPairAluDivmodStore.No))]
          [_ (CompilerBackendMaybeGepLoadPairAluDivmodStore.No)])]
      [_ (CompilerBackendMaybeGepLoadPairAluDivmodStore.No)])
    (CompilerBackendMaybeGepLoadPairAluDivmodStore.No)))

(define (compiler-backend-emit-gep-load-pair-alu-divmod-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [mnem : String]
  [alu-dst : i64]
  [addr0 : String]
  [addr1 : String]
  [base : CompilerIrValue]
  [offset0 : CompilerIrValue]
  [offset1 : CompilerIrValue]
  [after-binop : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepLoadPairAluDivmodEmission
  ;; Divmod polish normally retargets a one-use arithmetic producer into the
  ;; preserved-dividend register. A load-pair fold consumes that producer
  ;; first, so retain the same steering here instead of reintroducing a hot
  ;; producer-home -> dividend-home copy before the magic-mod sequence.
  (match after-binop
    [(CompilerIrInstrList.Cons div-instr after-div)
      (match div-instr
        [(CompilerIrInstr.BinOp div-dst div-op div-lhs div-rhs div-ty)
          (let
            [planned-magic : String
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                5
                2)]
            [planned-src : String
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                5
                3)]
            [magic : String
              (compiler-backend-divmod-polish-magic-ahead
                ctx
                div-instr
                div-dst
                div-op
                div-rhs
                div-ty
                5
                planned-magic)]
            [hoist-reg : String
              (compiler-backend-divmod-polish-hoist-reg-ahead div-instr 5)]
            [src : String
              (compiler-backend-divmod-polish-src
                ctx
                div-dst
                div-lhs
                magic
                hoist-reg
                planned-src
                false
                (compiler-backend-binop-wants-remainder? div-op)
                alu-dst)]
            [div-dst-home : String
              (compiler-backend-var-register-home ctx.assignments div-dst)]
            [direct-store : CompilerBackendMaybeGepLoadPairAluDivmodStore
              (compiler-backend-gep-load-pair-alu-divmod-store-probe
                ctx
                div-dst
                src
                magic
                (box-get after-div))]
            [base-home : String
              (compiler-backend-value-scalar-register ctx.assignments base)]
            [index0-home : String
              (compiler-backend-value-scalar-register ctx.assignments offset0)]
            [index1-home : String
              (compiler-backend-value-scalar-register ctx.assignments offset1)]
            (if (and
              (compiler-backend-var-single-use? ctx.use-counts alu-dst)
              (compiler-backend-branch-uses-var? div-lhs alu-dst)
              (compiler-backend-signed-literal-divmod-src-shape?
                ctx.type-segment-bases
                div-op
                div-rhs
                div-ty)
              (compiler-backend-divmod-src-register? src)
              (or
                (not (string.eq div-dst-home ""))
                (match direct-store
                  [(CompilerBackendMaybeGepLoadPairAluDivmodStore.Some
                      _
                      _
                      _
                      _
                      _
                      _
                      _)
                    true]
                  [(CompilerBackendMaybeGepLoadPairAluDivmodStore.No) false]))
              (not (string.eq src base-home))
              (not (string.eq src index0-home))
              (not (string.eq src index1-home)))
              (let
                [saved-count : i64 compiler-backend-emit-current-count]
                [saved-reserved : i64
                  compiler-backend-current-instr-reserved-mask]
                [saved0-var : i64 compiler-backend-emit-home-override0-var]
                [saved0-reg : String compiler-backend-emit-home-override0-reg]
                [saved1-var : i64 compiler-backend-emit-home-override1-var]
                [saved1-reg : String compiler-backend-emit-home-override1-reg]
                [continuation : CompilerIrInstrList (box-get after-div)]
                [emitted : ResultCompilerBackend
                  (begin
                    (compiler-backend-divmod-overrides-install!
                      alu-dst
                      src
                      (match direct-store
                        [(CompilerBackendMaybeGepLoadPairAluDivmodStore.Some
                            _
                            _
                            _
                            _
                            _
                            _
                            _)
                          div-dst]
                        [(CompilerBackendMaybeGepLoadPairAluDivmodStore.No) -1])
                      (match direct-store
                        [(CompilerBackendMaybeGepLoadPairAluDivmodStore.Some
                            _
                            _
                            _
                            _
                            _
                            _
                            _)
                          src]
                        [(CompilerBackendMaybeGepLoadPairAluDivmodStore.No) ""]))
                    ;; The fused bundle starts at Gep0; div-instr is five IR
                    ;; instructions later (Load0, Gep1, Load1, producer).
                    (set! compiler-backend-emit-current-count (- saved-count 5))
                    (set!
                      compiler-backend-current-instr-reserved-mask
                      (compiler-backend-instr-reserved-home-mask div-instr))
                    (match (compiler-backend-emit-gep-load-pair-alu
                      ctx.assignments
                      mnem
                      alu-dst
                      addr0
                      addr1)
                      [(ResultCompilerBackend.Ok pair-asm)
                        (match (compiler-backend-emit-instr
                          ctx
                          (CompilerBackendMaybeLabel.No)
                          div-instr)
                          [(ResultCompilerBackend.Ok div-asm)
                            (match direct-store
                              [(CompilerBackendMaybeGepLoadPairAluDivmodStore.Some
                                  gep-dst
                                  store-base
                                  store-offset
                                  store-elem-ty
                                  store-value
                                  store-ty
                                  after-store)
                                (begin
                                  (set!
                                    compiler-backend-emit-current-count
                                    (- saved-count 6))
                                  (match (compiler-backend-emit-divmod-direct-gep-store
                                    ctx
                                    gep-dst
                                    store-base
                                    store-offset
                                    store-elem-ty
                                    store-value
                                    store-ty)
                                    [(ResultCompilerBackend.Ok store-asm)
                                      (begin
                                        (set!
                                          continuation
                                          (box-get after-store))
                                        (ResultCompilerBackend.Ok
                                          (string.append
                                            pair-asm
                                            (string.append div-asm store-asm))))]
                                    [(ResultCompilerBackend.Err message)
                                      (ResultCompilerBackend.Err message)]))]
                              [(CompilerBackendMaybeGepLoadPairAluDivmodStore.No)
                                (ResultCompilerBackend.Ok
                                  (string.append pair-asm div-asm))])]
                          [(ResultCompilerBackend.Err message)
                            (ResultCompilerBackend.Err message)])]
                      [(ResultCompilerBackend.Err message)
                        (ResultCompilerBackend.Err message)]))]
                [_restore : unit
                  (begin
                    (set! compiler-backend-emit-current-count saved-count)
                    (set!
                      compiler-backend-current-instr-reserved-mask
                      saved-reserved)
                    (compiler-backend-divmod-overrides-install!
                      saved0-var
                      saved0-reg
                      saved1-var
                      saved1-reg))]
                (CompilerBackendMaybeGepLoadPairAluDivmodEmission.Some
                  (compiler-backend-emit-fused-result-rest
                    ctx
                    fallthrough
                    emitted
                    continuation
                    out)))
              (CompilerBackendMaybeGepLoadPairAluDivmodEmission.No)))]
        [_ (CompilerBackendMaybeGepLoadPairAluDivmodEmission.No)])]
    [_ (CompilerBackendMaybeGepLoadPairAluDivmodEmission.No)]))

(defenum CompilerBackendMaybeGepLoadPairAluEmission
  (No)
  (Some ResultCompilerBackend))

(define (compiler-backend-emit-dynamic-gep-load-pair-alu-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-fold-disp : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [load-dst : i64]
  [load-ty : AstType]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : CompilerBackendMaybeGepLoadPairAluEmission
  ;; The existing general pair path owns constant field offsets. This narrow
  ;; sibling admits only two dynamic indexed loads followed immediately by the
  ;; commutative ALU consumer, the stack-binary-op shape in vm-run.
  (match (compiler-backend-value-as-i64 offset)
    [(option_i64.Some _) (CompilerBackendMaybeGepLoadPairAluEmission.No)]
    [(option_i64.None)
      (match rest
        [(CompilerIrInstrList.Cons maybe-gep after-gep)
          (match maybe-gep
            [(CompilerIrInstr.Gep gep-dst2 base2 offset2 elem-ty2)
              (if (and
                (compiler-backend-var-single-use? ctx.use-counts gep-dst2)
                (opt-value-eq base2 base))
                (match (compiler-backend-value-as-i64 offset2)
                  [(option_i64.Some _)
                    (CompilerBackendMaybeGepLoadPairAluEmission.No)]
                  [(option_i64.None)
                    (match (box-get after-gep)
                      [(CompilerIrInstrList.Cons maybe-load after-load2)
                        (match maybe-load
                          [(CompilerIrInstr.Load load-dst2 src2 load-ty2)
                            (if (compiler-backend-branch-uses-var?
                              src2
                              gep-dst2)
                              ;; Probe with zero before mutating the GAP9 cursor.
                              ;; A displacement changes only the spelling of an
                              ;; already-valid SIB operand, never admission.
                              (match (compiler-backend-gep-load-pair-alu-probe
                                ctx.type-segment-bases
                                ctx.assignments
                                ctx.types
                                ctx.global-types
                                ctx.use-counts
                                base
                                offset
                                elem-ty
                                gep-fold-disp
                                load-dst
                                load-ty
                                offset2
                                elem-ty2
                                0
                                load-dst2
                                load-ty2
                                (box-get after-load2))
                                [(CompilerBackendGepLoadPairAluFold.Some
                                    _
                                    _
                                    _
                                    _
                                    _)
                                  (let
                                    [gep-fold-disp2 : i64
                                      (compiler-backend-gep-fold-next!
                                        ctx.type-segment-bases
                                        offset2
                                        elem-ty2)]
                                    (match (compiler-backend-gep-load-pair-alu-probe
                                      ctx.type-segment-bases
                                      ctx.assignments
                                      ctx.types
                                      ctx.global-types
                                      ctx.use-counts
                                      base
                                      offset
                                      elem-ty
                                      gep-fold-disp
                                      load-dst
                                      load-ty
                                      offset2
                                      elem-ty2
                                      gep-fold-disp2
                                      load-dst2
                                      load-ty2
                                      (box-get after-load2))
                                      [(CompilerBackendGepLoadPairAluFold.Some
                                          mnem
                                          alu-dst
                                          addr0
                                          addr1
                                          after-binop)
                                        (match (compiler-backend-emit-gep-load-pair-alu-divmod-rest
                                          ctx
                                          fallthrough
                                          mnem
                                          alu-dst
                                          addr0
                                          addr1
                                          base
                                          offset
                                          offset2
                                          (box-get after-binop)
                                          out)
                                          [(CompilerBackendMaybeGepLoadPairAluDivmodEmission.Some
                                              result)
                                            (CompilerBackendMaybeGepLoadPairAluEmission.Some
                                              result)]
                                          [(CompilerBackendMaybeGepLoadPairAluDivmodEmission.No)
                                            (CompilerBackendMaybeGepLoadPairAluEmission.Some
                                              (compiler-backend-emit-fused-result-rest
                                                ctx
                                                fallthrough
                                                (compiler-backend-emit-gep-load-pair-alu
                                                  ctx.assignments
                                                  mnem
                                                  alu-dst
                                                  addr0
                                                  addr1)
                                                (box-get after-binop)
                                                out))])]
                                      [(CompilerBackendGepLoadPairAluFold.No)
                                        ;; The zero-displacement probe above
                                        ;; admitted this exact shape.
                                        (CompilerBackendMaybeGepLoadPairAluEmission.No)]))]
                                [(CompilerBackendGepLoadPairAluFold.No)
                                  (CompilerBackendMaybeGepLoadPairAluEmission.No)])
                              (CompilerBackendMaybeGepLoadPairAluEmission.No))]
                          [_ (CompilerBackendMaybeGepLoadPairAluEmission.No)])]
                      [_ (CompilerBackendMaybeGepLoadPairAluEmission.No)])])
                (CompilerBackendMaybeGepLoadPairAluEmission.No))]
            [_ (CompilerBackendMaybeGepLoadPairAluEmission.No)])]
        [_ (CompilerBackendMaybeGepLoadPairAluEmission.No)])]))

;; Two-operand memory-form mnemonics only; Mul is excluded (imul mem needs
;; the two-operand register form and folds worse than the fused load).
(define (compiler-backend-gep-load-alu-mnemonic [op : CompilerIrBinOp]) : String
  (match op
    [(CompilerIrBinOp.Add) "add"]
    [(CompilerIrBinOp.Sub) "sub"]
    [(CompilerIrBinOp.BitAnd) "and"]
    [(CompilerIrBinOp.BitOr) "or"]
    [(CompilerIrBinOp.BitXor) "xor"]
    [_ ""]))

(define (compiler-backend-gep-load-alu-probe
  [type-segment-bases : i64]
  [assignments : CompilerRegAssignmentList]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [use-counts : (Array i64)]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [load-dst : i64]
  [load-ty : AstType]
  [rest : CompilerIrInstrList]) : CompilerBackendGepLoadAluFold
  (if (or
    (compiler-backend-float-type? load-ty)
    (not (= (compiler-backend-type-size type-segment-bases load-ty) 8))
    (not (compiler-backend-var-single-use? use-counts load-dst)))
    (CompilerBackendGepLoadAluFold.No)
    (match rest
      [(CompilerIrInstrList.Cons maybe-binop after-binop)
        (match maybe-binop
          [(CompilerIrInstr.BinOp dst op lhs rhs ty)
            (let
              [mnem : String (compiler-backend-gep-load-alu-mnemonic op)]
              [dst-home : String
                (compiler-backend-var-register-home assignments dst)]
              [base-home : String
                (compiler-backend-value-scalar-register assignments base)]
              [offset-home : String
                (compiler-backend-value-scalar-register assignments offset)]
              (if (and
                (not (string.eq mnem ""))
                (compiler-backend-branch-uses-var? rhs load-dst)
                (not (compiler-backend-branch-uses-var? lhs load-dst))
                (not
                  (compiler-backend-binop-f64? types global-types lhs rhs ty))
                (=
                  (compiler-backend-type-size
                    type-segment-bases
                    (compiler-backend-binop-operand-ty
                      types
                      global-types
                      op
                      lhs
                      rhs
                      ty))
                  8)
                (not (string.eq dst-home ""))
                (not (string.eq dst-home base-home))
                (not (string.eq dst-home offset-home)))
                (CompilerBackendGepLoadAluFold.Some
                  mnem
                  dst
                  lhs
                  (box after-binop))
                (CompilerBackendGepLoadAluFold.No)))]
          [_ (CompilerBackendGepLoadAluFold.No)])]
      [_ (CompilerBackendGepLoadAluFold.No)])))

;; The dynamic-index register pool mirror of scavenge-exclude-regs2, extended
;; with the ALU destination home.
(define (compiler-backend-gep-load-alu-index-exclude
  [base-reg : String]
  [offset-home : String]
  [dst-home : String]) : (Array String)
  (make-array
    "%rax"
    "%rdx"
    "%rcx"
    base-reg
    (if (string.eq offset-home "")
      base-reg
      offset-home)
    dst-home))

(define (compiler-backend-emit-gep-load-alu
  [type-segment-bases : i64]
  [assignments : CompilerRegAssignmentList]
  [mnem : String]
  [alu-dst : i64]
  [x : CompilerIrValue]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [gep-disp : i64]) : ResultCompilerBackend
  (let
    [dst-home : String (compiler-backend-var-register-home assignments alu-dst)]
    (match (compiler-backend-value-as-i64 offset)
      [(option_i64.Some n)
        (let
          ;; gep-disp is 0 here in practice (only Var-index geps carry a
          ;; folded displacement); merged for totality.
          [disp : i64
            (+
              (* n (compiler-backend-type-size type-segment-bases elem-ty))
              gep-disp)]
          [base-home : String
            (compiler-backend-address-base-filter-direct
              (compiler-backend-value-scalar-register assignments base))]
          [base-reg : String
            (if (string.eq base-home "")
              (compiler-backend-scavenge-reg
                alu-dst
                (compiler-backend-one-exclude dst-home)
                1
                "%r10")
              base-home)]
          [addr : String (compiler-backend-base-address disp base-reg)]
          (match (compiler-backend-emit-load-value-with-plan
            assignments
            base
            base-reg)
            [(ResultCompilerBackend.Ok base-asm)
              (match (compiler-backend-emit-load-value-with-plan
                assignments
                x
                dst-home)
                [(ResultCompilerBackend.Ok x-asm)
                  (ResultCompilerBackend.Ok
                    (string.append
                      base-asm
                      (string.append
                        x-asm
                        (str_cat.str-cat
                          "    "
                          mnem
                          "q "
                          addr
                          ", "
                          dst-home
                          "\n"))))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)])]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)]))]
      [(option_i64.None)
        (let
          [scale : i64 (compiler-backend-type-size type-segment-bases elem-ty)]
          [sib-scale? : bool (compiler-backend-gep-sib-scale? scale)]
          [base-home : String
            (compiler-backend-address-base-filter
              (compiler-backend-value-scalar-register assignments base))]
          [offset-home : String
            (compiler-backend-value-scalar-register assignments offset)]
          [use-base-home? : bool
            (and sib-scale? (not (string.eq base-home "")))]
          [base-reg : String
            (if use-base-home?
              base-home
              (compiler-backend-scavenge-reg
                alu-dst
                (compiler-backend-two-exclude offset-home dst-home)
                2
                "%r10"))]
          [use-offset-home? : bool
            (and
              sib-scale?
              (not (string.eq offset-home ""))
              (not (string.eq offset-home base-reg)))]
          [index-reg : String
            (if use-offset-home?
              offset-home
              (compiler-backend-scavenge-reg
                alu-dst
                (compiler-backend-gep-load-alu-index-exclude
                  base-reg
                  offset-home
                  dst-home)
                6
                "%r8"))]
          [addr : String
            (compiler-backend-gep-index-address-disp
              gep-disp
              base-reg
              scale
              index-reg)]
          [addr-asm : String
            (if (string.eq addr "")
              (compiler-backend-gep-index-base-asm-disp
                gep-disp
                base-reg
                scale
                index-reg)
              "")]
          [load-addr : String
            (if (string.eq addr "")
              (str_cat.str-cat "(" base-reg ")" "")
              addr)]
          (match (if use-base-home?
            (ResultCompilerBackend.Ok "")
            (compiler-backend-emit-load-value-with-plan
              assignments
              base
              base-reg))
            [(ResultCompilerBackend.Ok base-asm)
              (match (if use-offset-home?
                (ResultCompilerBackend.Ok "")
                (compiler-backend-emit-load-value-with-plan
                  assignments
                  offset
                  index-reg))
                [(ResultCompilerBackend.Ok offset-asm)
                  (match (compiler-backend-emit-load-value-with-plan
                    assignments
                    x
                    dst-home)
                    [(ResultCompilerBackend.Ok x-asm)
                      (ResultCompilerBackend.Ok
                        (string.append
                          base-asm
                          (string.append
                            offset-asm
                            (string.append
                              addr-asm
                              (string.append
                                x-asm
                                (str_cat.str-cat
                                  "    "
                                  mnem
                                  "q "
                                  load-addr
                                  ", "
                                  dst-home
                                  "\n"))))))]
                    [(ResultCompilerBackend.Err message)
                      (ResultCompilerBackend.Err message)])]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)])]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err message)]))])))

(define (compiler-backend-emit-fused-gep-load-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [gep-fold-disp : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [load-dst : i64]
  [load-ty : AstType]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  ;; GAP8 ALU fold first: the probe is side-effect-free, so a rejection costs
  ;; nothing and falls through to the existing single/pair load fusion.
  (match (compiler-backend-gep-load-alu-probe
    ctx.type-segment-bases
    ctx.assignments
    ctx.types
    ctx.global-types
    ctx.use-counts
    base
    offset
    load-dst
    load-ty
    rest)
    [(CompilerBackendGepLoadAluFold.Some mnem alu-dst x after-binop)
      (compiler-backend-emit-fused-result-rest
        ctx
        fallthrough
        (compiler-backend-emit-gep-load-alu
          ctx.type-segment-bases
          ctx.assignments
          mnem
          alu-dst
          x
          base
          offset
          elem-ty
          gep-fold-disp)
        (box-get after-binop)
        out)]
    [(CompilerBackendGepLoadAluFold.No)
      (match (compiler-backend-emit-dynamic-gep-load-pair-alu-rest
        ctx
        fallthrough
        gep-fold-disp
        base
        offset
        elem-ty
        load-dst
        load-ty
        rest
        out)
        [(CompilerBackendMaybeGepLoadPairAluEmission.Some result) result]
        [(CompilerBackendMaybeGepLoadPairAluEmission.No)
          (compiler-backend-emit-fused-gep-load-plain-rest
            ctx
            fallthrough
            _gep-dst
            gep-fold-disp
            base
            offset
            elem-ty
            load-dst
            load-ty
            rest
            out)])]))

(define (compiler-backend-emit-fused-gep-load-plain-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [_gep-dst : i64]
  [gep-fold-disp : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [load-dst : i64]
  [load-ty : AstType]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  ;; M-D emergency-leak fix: the single gep+load emission is inlined at each
  ;; fallthrough site instead of being computed SPECULATIVELY up front.
  ;; emit-load-from-gep scavenges a base register; under full occupancy that
  ;; scavenge EMERGENCY-adds the picked register to the global pending set as
  ;; a side effect. The speculative single asm was discarded on the PAIR path,
  ;; but its pending registers leaked into the pair wrap, whose stray trailing
  ;; restore overwrote the pair's second loaded result (lex-parse-based-int:
  ;; string len in %r9 restored-over before its bounds compare -> false OOB
  ;; abort on every mid-band self-host build).
  (match (compiler-backend-value-as-i64 offset)
    [(option_i64.Some _)
      (match rest
        [(CompilerIrInstrList.Cons maybe-gep after-gep)
          (match maybe-gep
            [(CompilerIrInstr.Gep gep-dst2 base2 offset2 elem-ty2)
              (if (and
                (compiler-backend-var-single-use? ctx.use-counts gep-dst2)
                (opt-value-eq base2 base))
                (match (compiler-backend-value-as-i64 offset2)
                  [(option_i64.Some _)
                    (match (box-get after-gep)
                      [(CompilerIrInstrList.Cons maybe-load after-load2)
                        (match maybe-load
                          [(CompilerIrInstr.Load load-dst2 src2 load-ty2)
                            (if (and
                              (compiler-backend-branch-uses-var? src2 gep-dst2)
                              (not
                                (and
                                  (compiler-backend-load-compare-type?
                                    ctx.type-segment-bases
                                    load-ty2)
                                  (compiler-backend-var-single-use?
                                    ctx.use-counts
                                    load-dst2)
                                  (compiler-backend-rest-starts-load-compare-branch?
                                    (box-get after-load2)
                                    load-dst2
                                    ctx.types
                                    ctx.global-types
                                    ctx.use-counts))))
                              (let
                                ;; GAP9: the pair consumes a SECOND gep;
                                ;; advance its ordinal before either pair path.
                                [gep-fold-disp2 : i64
                                  (compiler-backend-gep-fold-next!
                                    ctx.type-segment-bases
                                    offset2
                                    elem-ty2)]
                                (match (compiler-backend-gep-load-pair-alu-probe
                                  ctx.type-segment-bases
                                  ctx.assignments
                                  ctx.types
                                  ctx.global-types
                                  ctx.use-counts
                                  base
                                  offset
                                  elem-ty
                                  gep-fold-disp
                                  load-dst
                                  load-ty
                                  offset2
                                  elem-ty2
                                  gep-fold-disp2
                                  load-dst2
                                  load-ty2
                                  (box-get after-load2))
                                  [(CompilerBackendGepLoadPairAluFold.Some
                                      mnem
                                      alu-dst
                                      addr0
                                      addr1
                                      after-binop)
                                    (compiler-backend-emit-fused-result-rest
                                      ctx
                                      fallthrough
                                      (compiler-backend-emit-gep-load-pair-alu
                                        ctx.assignments
                                        mnem
                                        alu-dst
                                        addr0
                                        addr1)
                                      (box-get after-binop)
                                      out)]
                                  [(CompilerBackendGepLoadPairAluFold.No)
                                    (compiler-backend-emit-fused-result-rest
                                      ctx
                                      fallthrough
                                      (compiler-backend-emit-load-from-gep-pair-planned
                                        ctx.type-segment-bases
                                        ctx.assignments
                                        base
                                        offset
                                        elem-ty
                                        load-dst
                                        load-ty
                                        offset2
                                        elem-ty2
                                        load-dst2
                                        load-ty2
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          0
                                          0)
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          0
                                          1)
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          1
                                          1)
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          2
                                          0)
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          2
                                          1)
                                        (compiler-backend-scratch-plan-register-ahead
                                          (compiler-backend-runtime-plan-scratch
                                            ctx.plan)
                                          3
                                          1))
                                      (box-get after-load2)
                                      out)]))
                              (compiler-backend-emit-fused-result-rest
                                ctx
                                fallthrough
                                (compiler-backend-emit-load-from-gep
                                  ctx.type-segment-bases
                                  ctx.assignments
                                  load-dst
                                  base
                                  offset
                                  elem-ty
                                  load-ty
                                  ""
                                  gep-fold-disp
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    0
                                    0)
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    0
                                    1)
                                  (compiler-backend-scratch-plan-register-ahead
                                    (compiler-backend-runtime-plan-scratch
                                      ctx.plan)
                                    1
                                    1))
                                rest
                                out))]
                          [_
                            (compiler-backend-emit-fused-result-rest
                              ctx
                              fallthrough
                              (compiler-backend-emit-load-from-gep
                                ctx.type-segment-bases
                                ctx.assignments
                                load-dst
                                base
                                offset
                                elem-ty
                                load-ty
                                ""
                                gep-fold-disp
                                (compiler-backend-scratch-plan-register-ahead
                                  (compiler-backend-runtime-plan-scratch
                                    ctx.plan)
                                  0
                                  0)
                                (compiler-backend-scratch-plan-register-ahead
                                  (compiler-backend-runtime-plan-scratch
                                    ctx.plan)
                                  0
                                  1)
                                (compiler-backend-scratch-plan-register-ahead
                                  (compiler-backend-runtime-plan-scratch
                                    ctx.plan)
                                  1
                                  1))
                              rest
                              out)])]
                      [_
                        (compiler-backend-emit-fused-result-rest
                          ctx
                          fallthrough
                          (compiler-backend-emit-load-from-gep
                            ctx.type-segment-bases
                            ctx.assignments
                            load-dst
                            base
                            offset
                            elem-ty
                            load-ty
                            ""
                            gep-fold-disp
                            (compiler-backend-scratch-plan-register-ahead
                              (compiler-backend-runtime-plan-scratch ctx.plan)
                              0
                              0)
                            (compiler-backend-scratch-plan-register-ahead
                              (compiler-backend-runtime-plan-scratch ctx.plan)
                              0
                              1)
                            (compiler-backend-scratch-plan-register-ahead
                              (compiler-backend-runtime-plan-scratch ctx.plan)
                              1
                              1))
                          rest
                          out)])]
                  [(option_i64.None)
                    (compiler-backend-emit-fused-result-rest
                      ctx
                      fallthrough
                      (compiler-backend-emit-load-from-gep
                        ctx.type-segment-bases
                        ctx.assignments
                        load-dst
                        base
                        offset
                        elem-ty
                        load-ty
                        ""
                        gep-fold-disp
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          0)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          0
                          1)
                        (compiler-backend-scratch-plan-register-ahead
                          (compiler-backend-runtime-plan-scratch ctx.plan)
                          1
                          1))
                      rest
                      out)])
                (compiler-backend-emit-fused-result-rest
                  ctx
                  fallthrough
                  (compiler-backend-emit-load-from-gep
                    ctx.type-segment-bases
                    ctx.assignments
                    load-dst
                    base
                    offset
                    elem-ty
                    load-ty
                    ""
                    gep-fold-disp
                    (compiler-backend-scratch-plan-register-ahead
                      (compiler-backend-runtime-plan-scratch ctx.plan)
                      0
                      0)
                    (compiler-backend-scratch-plan-register-ahead
                      (compiler-backend-runtime-plan-scratch ctx.plan)
                      0
                      1)
                    (compiler-backend-scratch-plan-register-ahead
                      (compiler-backend-runtime-plan-scratch ctx.plan)
                      1
                      1))
                  rest
                  out))]
            [_
              (compiler-backend-emit-fused-result-rest
                ctx
                fallthrough
                (compiler-backend-emit-load-from-gep
                  ctx.type-segment-bases
                  ctx.assignments
                  load-dst
                  base
                  offset
                  elem-ty
                  load-ty
                  ""
                  gep-fold-disp
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0
                    0)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    0
                    1)
                  (compiler-backend-scratch-plan-register-ahead
                    (compiler-backend-runtime-plan-scratch ctx.plan)
                    1
                    1))
                rest
                out)])]
        [_
          (compiler-backend-emit-fused-result-rest
            ctx
            fallthrough
            (compiler-backend-emit-load-from-gep
              ctx.type-segment-bases
              ctx.assignments
              load-dst
              base
              offset
              elem-ty
              load-ty
              ""
              gep-fold-disp
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                0
                0)
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                0
                1)
              (compiler-backend-scratch-plan-register-ahead
                (compiler-backend-runtime-plan-scratch ctx.plan)
                1
                1))
            rest
            out)])]
    [(option_i64.None)
      (compiler-backend-emit-fused-result-rest
        ctx
        fallthrough
        (compiler-backend-emit-load-from-gep
          ctx.type-segment-bases
          ctx.assignments
          load-dst
          base
          offset
          elem-ty
          load-ty
          ""
          gep-fold-disp
          (compiler-backend-scratch-plan-register-ahead
            (compiler-backend-runtime-plan-scratch ctx.plan)
            0
            0)
          (compiler-backend-scratch-plan-register-ahead
            (compiler-backend-runtime-plan-scratch ctx.plan)
            0
            1)
          (compiler-backend-scratch-plan-register-ahead
            (compiler-backend-runtime-plan-scratch ctx.plan)
            1
            1))
        rest
        out)]))

(define (compiler-backend-emit-fused-gep-store-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [gep-dst : i64]
  [gep-fold-disp : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [value : CompilerIrValue]
  [store-ty : AstType]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (compiler-backend-emit-store-to-gep
    ctx.type-segment-bases
    ctx.assignments
    base
    offset
    elem-ty
    value
    store-ty
    ctx.program-index
    gep-fold-disp
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      0
      0)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      0
      1)
    (compiler-backend-scratch-plan-register-ahead
      (compiler-backend-runtime-plan-scratch ctx.plan)
      1
      1))
    [(ResultCompilerBackend.Ok head)
      (begin
        (compiler-backend-asm-append out (compiler-backend-emergency-wrap head))
        (compiler-backend-emit-instrs ctx fallthrough rest out))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              ctx.spans
              ctx.source-function
              (CompilerIrInstr.Gep gep-dst base offset elem-ty)
              ctx.func-diag
              ""))))]))

(define (compiler-backend-emit-fused-mov-trivial-phi-return-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [dst : i64]
  [src : CompilerIrValue]
  [ty : AstType]
  [target-label : i64]
  [after-jump : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match (compiler-backend-emit-mov-trivial-phi-return-edge
    ctx.type-segment-bases
    ctx.source-function
    ctx.blocks
    target-label
    ctx.current-label
    ctx.assignments
    ctx.vars
    ctx.ret-ty
    dst
    src
    ctx.program-index)
    [(ResultCompilerBackend.Ok direct-return)
      (if (string.eq direct-return "")
        (if (compiler-backend-var-single-use? ctx.use-counts dst)
          (match (compiler-backend-emit-mov-phi-copy-edge
            ctx.type-segment-bases
            ctx.assignments
            ctx.blocks
            target-label
            ctx.current-label
            dst
            src
            ctx.program-index
            ctx.vars
            (compiler-backend-scratch-plan-register-ahead
              (compiler-backend-runtime-plan-scratch ctx.plan)
              1
              0)
            (compiler-backend-scratch-plan-register-ahead
              (compiler-backend-runtime-plan-scratch ctx.plan)
              1
              1))
            [(ResultCompilerBackend.Ok fused-copies)
              (if (string.eq fused-copies "")
                (compiler-backend-emit-instrs-normal
                  ctx
                  fallthrough
                  (CompilerIrInstr.Mov dst src ty)
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Jump target-label)
                    after-jump)
                  out)
                (match (compiler-backend-emit-trivial-phi-return-edge
                  ctx.type-segment-bases
                  ctx.source-function
                  ctx.blocks
                  target-label
                  ctx.current-label
                  ctx.assignments
                  ctx.vars
                  ctx.ret-ty
                  ctx.program-index)
                  [(ResultCompilerBackend.Ok plain-direct-return)
                    (begin
                      (compiler-backend-asm-append
                        out
                        (if (string.eq plain-direct-return "")
                          (str_cat.str-cat
                            fused-copies
                            (if (compiler-backend-jump-target-is-fallthrough?
                              target-label
                              fallthrough)
                              ""
                              (compiler-backend-jump-label
                                ctx.function
                                target-label)))
                          plain-direct-return))
                      (compiler-backend-emit-instrs
                        ctx
                        fallthrough
                        after-jump
                        out))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err
                      (box
                        (compiler-backend-apply-instr-diagnostic
                          (box-get message)
                          (compiler-backend-instr-diagnostic
                            ctx.spans
                            ctx.source-function
                            (CompilerIrInstr.Mov dst src ty)
                            ctx.func-diag
                            ""))))]))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler-backend-apply-instr-diagnostic
                    (box-get message)
                    (compiler-backend-instr-diagnostic
                      ctx.spans
                      ctx.source-function
                      (CompilerIrInstr.Mov dst src ty)
                      ctx.func-diag
                      ""))))])
          (compiler-backend-emit-instrs-normal
            ctx
            fallthrough
            (CompilerIrInstr.Mov dst src ty)
            (compiler-ir-instr-cons
              (CompilerIrInstr.Jump target-label)
              after-jump)
            out))
        (begin
          (compiler-backend-emergency-append out direct-return)
          (compiler-backend-emit-instrs ctx fallthrough after-jump out)))]
    [(ResultCompilerBackend.Err message)
      (ResultCompilerBackend.Err
        (box
          (compiler-backend-apply-instr-diagnostic
            (box-get message)
            (compiler-backend-instr-diagnostic
              ctx.spans
              ctx.source-function
              (CompilerIrInstr.Mov dst src ty)
              ctx.func-diag
              ""))))]))

(define (compiler-backend-emit-call-return
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [source-function : i64]
  [blocks : CompilerIrBlockList]
  [name : i64]
  [args : CompilerIrCallArgs]
  [assignments : CompilerRegAssignmentList]
  [planned-stage : String]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [vars : i64]
  [plan : CompilerBackendRuntimePlan]
  [_functions : CompilerIrFunctionList]
  [_externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [call-symbol : String
      (compiler-backend-call-symbol-index name plan program-index)]
    [inline-memory-name : String
      (compiler-backend-inline-memory-call-target
        (compiler-ir-symbol-text name)
        call-symbol)]
    [extern-call-info : i64
      (compiler-backend-index-extern-call-info program-index name)]
    [param-types : AstTypeList
      (compiler-backend-call-param-types-for-call
        type-segment-bases
        name
        args
        types
        global-types
        extern-call-info
        program-index)]
    [c-abi? : bool
      (compiler-backend-extern-call-info-aggregate-params? extern-call-info)]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        c-abi?
        program-index)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      args
      param-types
      c-abi?
      0
      0
      0
      0
      0
      planned-stage
      instr-diag
      program-index
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (if (and
          (compiler-backend-tls-current-arena-call-id? name)
          (not (compiler-backend-index-function-defines? program-index name)))
          (match (compiler-backend-tls-current-arena-inline-asm
            target
            name
            instr-diag)
            [(ResultCompilerBackend.Ok inline-asm)
              (ResultCompilerBackend.Ok
                (string.append
                  (compiler-backend-emit-call-space-sub call-space)
                  (string.append
                    args-asm
                    (string.append
                      inline-asm
                      (string.append
                        (compiler-backend-emit-call-space-add call-space)
                        (compiler-backend-return-tail
                          source-function
                          assignments
                          vars
                          blocks))))))]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler-backend-apply-instr-diagnostic
                    (box-get message)
                    instr-diag)))])
          (if (compiler-backend-inline-memory-call-name? inline-memory-name)
            (ResultCompilerBackend.Ok
              (string.append
                (compiler-backend-emit-call-space-sub call-space)
                (string.append
                  args-asm
                  (string.append
                    (compiler-backend-inline-memory-call-asm
                      target
                      inline-memory-name)
                    (string.append
                      (compiler-backend-emit-call-space-add call-space)
                      (compiler-backend-return-tail
                        source-function
                        assignments
                        vars
                        blocks))))))
            (ResultCompilerBackend.Ok
              (string.append
                (compiler-backend-emit-call-space-sub call-space)
                (string.append
                  args-asm
                  (string.append
                    (compiler-backend-varargs-pre-call
                      type-segment-bases
                      target
                      extern-call-info
                      param-types)
                    (str_cat.str-cat
                      "    call "
                      call-symbol
                      "\n"
                      (string.append
                        (compiler-backend-emit-call-space-add call-space)
                        (compiler-backend-return-tail
                          source-function
                          assignments
                          vars
                          blocks))
                      "")))))))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-indirect-call-param-types
  [types : CompilerRegVarTypeList]
  [func : CompilerIrValue]
  [_functions : CompilerIrFunctionList]
  [_externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]) : AstTypeList
  (match func
    [(CompilerIrValue.Function name)
      (match (compiler-backend-index-signature program-index name)
        [(CompilerBackendMaybeSignature.Some param-types _) param-types]
        [(CompilerBackendMaybeSignature.No) (ast-type-list-new)])]
    [_
      (match (compiler-backend-value-type
        types
        (CompilerBackendGlobalTypeList.Nil)
        func)
        [(CompilerRegMaybeType.Some ty)
          (match ty
            [(AstType.Func param-types _) (box-get param-types)]
            [_ (ast-type-list-new)])]
        [(CompilerRegMaybeType.No) (ast-type-list-new)])]))

(define (compiler-backend-indirect-tail-call-register-only?
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [args : CompilerIrCallArgs]
  [types : AstTypeList]
  [program-index : CompilerBackendProgramIndex]) : bool
  (=
    (compiler-backend-call-stack-arg-count
      type-segment-bases
      target
      args
      types
      false
      0
      1
      0
      1
      0
      program-index)
    0))

(define (compiler-backend-scavenge-tail-call-target-reg [planned : String]) : String
  ;; Tail jumps restore callee-saved homes before the final jmp. Keep the closure
  ;; pointer in a pooled caller-saved non-arg candidate instead.
  (if (string.eq planned "")
    (compiler-backend-scavenge-reg-here
      (compiler-backend-c-abi-stage-exclude-with "%r11")
      compiler-backend-c-abi-stage-exclude-count
      "%r10")
    planned))

(define (compiler-backend-emit-indirect-call-with-arg-assignments
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [dst : i64]
  [func : CompilerIrValue]
  [args : CompilerIrCallArgs]
  [ty : AstType]
  [assignments : CompilerRegAssignmentList]
  [arg-assignments : CompilerRegAssignmentList]
  [planned-target : String]
  [planned-stage : String]
  [types : CompilerRegVarTypeList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [param-types : AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    [effective-arg-assignments : CompilerRegAssignmentList
      (if (compiler-backend-declared-first-call-arg-accepts-rax-forward?
        type-segment-bases
        program-index
        param-types)
        arg-assignments
        assignments)]
    ;; Dense-index override mirroring effective-arg-assignments: the
    ;; rax-forward insert reaches the arg emitters exactly when the declared
    ;; first arg accepts the forward.
    [effective-arg-override : i64
      (if (compiler-backend-declared-first-call-arg-accepts-rax-forward?
        type-segment-bases
        program-index
        param-types)
        compiler-backend-rax-forward-pending-var
        -1)]
    [call-space : i64
      (compiler-backend-closure-call-arg-space
        target
        args
        param-types
        program-index)]
    (match (compiler-backend-emit-call-args-with-override
      type-segment-bases
      effective-arg-override
      target
      effective-arg-assignments
      args
      param-types
      false
      0
      1
      0
      1
      0
      planned-stage
      instr-diag
      program-index
      ;; vars must be the real frame var count: group-word1 slots live at
      ;; -(8*(vars+var+1))(%rbp), so 0 here made a stack-homed group arg read
      ;; its word0 slot for BOTH words (closure-arg miscompile).
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-target-arg-reg target 0)
          [(ResultBackendReg.Ok env-reg)
            (match (compiler-backend-emit-call-result-store
              type-segment-bases
              assignments
              dst
              ty
              vars
              program-index)
              [(ResultCompilerBackend.Ok result-store)
                (match func
                  [(CompilerIrValue.Function name)
                    (ResultCompilerBackend.Ok
                      (string.append
                        (compiler-backend-emit-call-space-sub call-space)
                        (string.append
                          args-asm
                          (string.append
                            (compiler-backend-emit-load-i64-immediate 0 env-reg)
                            (str_cat.str-cat
                              "    call "
                              (compiler-backend-closure-entry-label
                                (compiler-ir-symbol-text name))
                              "\n"
                              (string.append
                                (compiler-backend-emit-call-space-add
                                  call-space)
                                result-store)
                              "")))))]
                  [_
                    ;; Active-scavenge the closure pointer after arg marshalling.
                    ;; It must dodge in-flight arg registers, but it can use the
                    ;; pooled caller-saved non-arg target register.
                    (let
                      [scav-clo : String
                        (compiler-backend-scavenge-call-target-reg
                          planned-target)]
                      (match (compiler-backend-emit-load-value-with-plan
                        assignments
                        func
                        scav-clo)
                        [(ResultCompilerBackend.Ok func-asm)
                          (ResultCompilerBackend.Ok
                            (string.append
                              (compiler-backend-emit-call-space-sub call-space)
                              (string.append
                                args-asm
                                (string.append
                                  func-asm
                                  (str_cat.str-cat
                                    "    movq 8("
                                    scav-clo
                                    "), "
                                    env-reg
                                    "\n    call *("
                                    scav-clo
                                    ")\n"
                                    (string.append
                                      (compiler-backend-emit-call-space-add
                                        call-space)
                                      result-store)
                                    "")))))]
                        [(ResultCompilerBackend.Err message)
                          (ResultCompilerBackend.Err
                            (box
                              (compiler-backend-apply-instr-diagnostic
                                (box-get message)
                                instr-diag)))]))])]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err
                  (box
                    (compiler-backend-apply-instr-diagnostic
                      (box-get message)
                      instr-diag)))])]
          [(ResultBackendReg.Err message)
            (ResultCompilerBackend.Err
              (box (compiler-diagnostic-with-message instr-diag message)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-emit-indirect-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [dst : i64]
  [func : CompilerIrValue]
  [args : CompilerIrCallArgs]
  [ty : AstType]
  [assignments : CompilerRegAssignmentList]
  [planned-target : String]
  [planned-stage : String]
  [types : CompilerRegVarTypeList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (compiler-backend-emit-indirect-call-with-arg-assignments
    type-segment-bases
    target
    dst
    func
    args
    ty
    assignments
    assignments
    planned-target
    planned-stage
    types
    functions
    externs
    program-index
    vars
    instr-diag))

(define (compiler-backend-emit-tail-indirect-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [source-function : i64]
  [blocks : CompilerIrBlockList]
  [func : CompilerIrValue]
  [args : CompilerIrCallArgs]
  [ty : AstType]
  [assignments : CompilerRegAssignmentList]
  [planned-target : String]
  [planned-stage : String]
  [types : CompilerRegVarTypeList]
  [vars : i64]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [param-types : AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    [call-space : i64
      (compiler-backend-closure-call-arg-space
        target
        args
        param-types
        program-index)]
    [register-only : bool
      (compiler-backend-indirect-tail-call-register-only?
        type-segment-bases
        target
        args
        param-types
        program-index)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      args
      param-types
      false
      0
      1
      0
      1
      0
      planned-stage
      instr-diag
      program-index
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (let
          [clo-reg : String
            (compiler-backend-scavenge-tail-call-target-reg planned-target)]
          (match (compiler-backend-emit-load-value-with-plan
            assignments
            func
            clo-reg)
            [(ResultCompilerBackend.Ok func-asm)
              (match (compiler-backend-target-arg-reg target 0)
                [(ResultBackendReg.Ok env-reg)
                  (let
                    [target-addr : String
                      (str_cat.str-cat "*(" clo-reg ")" "" "")]
                    [descriptor-asm : String
                      (str_cat.str-cat
                        func-asm
                        "    movq 8("
                        clo-reg
                        "), "
                        env-reg
                        "\n"
                        "")]
                    (if register-only
                      (ResultCompilerBackend.Ok
                        (string.append
                          args-asm
                          (string.append
                            descriptor-asm
                            (compiler-backend-tail-jump-tail
                              assignments
                              vars
                              target-addr))))
                      (ResultCompilerBackend.Ok
                        (string.append
                          (compiler-backend-emit-call-space-sub call-space)
                          (string.append
                            args-asm
                            (string.append
                              descriptor-asm
                              (str_cat.str-cat
                                "    call "
                                target-addr
                                "\n"
                                (compiler-backend-emit-call-space-add
                                  call-space)
                                (string.append
                                  (compiler-backend-tail-call-return-normalize
                                    type-segment-bases
                                    ty)
                                  (compiler-backend-return-tail
                                    source-function
                                    assignments
                                    vars
                                    blocks))
                                ""
                                "")))))))]
                [(ResultBackendReg.Err message)
                  (ResultCompilerBackend.Err
                    (box (compiler-diagnostic-with-message instr-diag message)))])]
            [(ResultCompilerBackend.Err message)
              (ResultCompilerBackend.Err
                (box
                  (compiler-backend-apply-instr-diagnostic
                    (box-get message)
                    instr-diag)))]))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-indirect-c-call-direct-home?
  [_target : CompilerBackendTarget]
  [home : String]) : bool
  ;; Use the callee-saved homes common to SysV and Win64. Win64 also preserves
  ;; rdi/rsi, but those stay on the fallback path for this conservative pass.
  (or
    (string.eq home "%rbx")
    (string.eq home "%r12")
    (string.eq home "%r13")
    (string.eq home "%r14")
    (string.eq home "%r15")))

(define (compiler-backend-indirect-c-call-direct-home
  [target : CompilerBackendTarget]
  [assignments : CompilerRegAssignmentList]
  [func : CompilerIrValue]) : String
  (let
    [home : String (compiler-backend-value-register-home assignments func)]
    (if (compiler-backend-indirect-c-call-direct-home? target home)
      home
      "")))

(define (compiler-backend-scavenge-call-target-reg [planned : String]) : String
  ;; Indirect call targets are materialized after argument marshalling. Do not
  ;; reuse pooled caller-arg candidates that may already hold in-flight args, and
  ;; keep %r11 available for ABI/runtime clobber semantics instead of staging.
  (if (string.eq planned "")
    (compiler-backend-scavenge-reg-here
      (compiler-backend-c-abi-stage-exclude-with "%r11")
      compiler-backend-c-abi-stage-exclude-count
      "%r10")
    planned))

(define (compiler-backend-emit-indirect-c-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [dst : i64]
  [func : CompilerIrValue]
  [args : CompilerIrCallArgs]
  [ty : AstType]
  [assignments : CompilerRegAssignmentList]
  [planned-target : String]
  [planned-stage : String]
  [types : CompilerRegVarTypeList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [declared-param-types : AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    [param-types : AstTypeList
      (if (compiler-backend-type-list-has-aggregate?
        type-segment-bases
        declared-param-types)
        (compiler-backend-call-c-abi-param-types
          type-segment-bases
          types
          (CompilerBackendGlobalTypeList.Nil)
          args
          declared-param-types
          program-index)
        (if (=
          (compiler-backend-call-args-count args)
          (compiler-backend-type-list-count declared-param-types))
          declared-param-types
          (compiler-backend-call-actual-param-types
            type-segment-bases
            types
            (CompilerBackendGlobalTypeList.Nil)
            args)))]
    [call-space : i64
      (compiler-backend-call-arg-space
        target
        args
        param-types
        true
        program-index)]
    [direct-home : String
      (compiler-backend-indirect-c-call-direct-home target assignments func)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      args
      param-types
      true
      0
      0
      0
      0
      0
      planned-stage
      instr-diag
      program-index
      ;; Real frame var count for group-word1 slot addressing (see
      ;; emit-indirect-call): latent today because C-ABI lowering never passes
      ;; 16-byte aggregates by value, but keep it correct.
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (if (string.eq direct-home "")
          (let
            [call-reg : String
              (compiler-backend-scavenge-call-target-reg planned-target)]
            (match (compiler-backend-emit-load-value-with-plan
              assignments
              func
              call-reg)
              [(ResultCompilerBackend.Ok func-asm)
                (ResultCompilerBackend.Ok
                  (string.append
                    (compiler-backend-emit-call-space-sub call-space)
                    (string.append
                      args-asm
                      (string.append
                        func-asm
                        (str_cat.str-cat
                          "    call *"
                          call-reg
                          "\n"
                          (compiler-backend-emit-call-space-add call-space)
                          (compiler-backend-emit-c-abi-call-result-store-reg
                            assignments
                            dst
                            (if (compiler-backend-float-type? ty)
                              "%xmm0"
                              "%rax")
                            ty)
                          ""
                          "")))))]
              [(ResultCompilerBackend.Err message)
                (ResultCompilerBackend.Err
                  (box
                    (compiler-backend-apply-instr-diagnostic
                      (box-get message)
                      instr-diag)))]))
          (ResultCompilerBackend.Ok
            (string.append
              (compiler-backend-emit-call-space-sub call-space)
              (string.append
                args-asm
                (str_cat.str-cat
                  "    call *"
                  direct-home
                  "\n"
                  (compiler-backend-emit-call-space-add call-space)
                  (compiler-backend-emit-c-abi-call-result-store-reg
                    assignments
                    dst
                    (if (compiler-backend-float-type? ty)
                      "%xmm0"
                      "%rax")
                    ty)
                  ""
                  "")))))]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-emit-c-abi-store-result-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [base : CompilerIrValue]
  [name : i64]
  [args : CompilerIrCallArgs]
  [slots : CompilerIrCAbiReturnSlotList]
  [assignments : CompilerRegAssignmentList]
  [planned-target : String]
  [planned-stage : String]
  [types : CompilerRegVarTypeList]
  [global-types : CompilerBackendGlobalTypeList]
  [plan : CompilerBackendRuntimePlan]
  [_externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [extern-call-info : i64
      (compiler-backend-index-extern-call-info program-index name)]
    [param-types : AstTypeList
      (compiler-backend-call-param-types-for-call
        type-segment-bases
        name
        args
        types
        global-types
        extern-call-info
        program-index)]
    [c-abi? : bool
      (compiler-backend-extern-call-info-aggregate-params? extern-call-info)]
    [call-space : i64
      (compiler-backend-call-stack-arg-layout-space
        type-segment-bases
        target
        args
        param-types
        c-abi?
        program-index)]
    ;; The args + 16-byte base-save region are reserved in the prologue frame
    ;; (instr-outgoing-stack-space), so no per-call %rsp dip is needed.
    [dip : i64 0]
    [call-symbol : String
      (compiler-backend-call-symbol-index name plan program-index)]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      args
      param-types
      c-abi?
      0
      0
      0
      0
      0
      planned-stage
      instr-diag
      program-index
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-emit-c-abi-return-base-save
          assignments
          base
          call-space
          planned-target)
          [(ResultCompilerBackend.Ok base-save)
            (ResultCompilerBackend.Ok
              (string.append
                (compiler-backend-emit-call-space-sub dip)
                (string.append
                  args-asm
                  (string.append
                    base-save
                    (string.append
                      (compiler-backend-varargs-pre-call
                        type-segment-bases
                        target
                        extern-call-info
                        param-types)
                      (str_cat.str-cat
                        "    call "
                        call-symbol
                        "\n"
                        (string.append
                          (compiler-backend-emit-c-abi-return-stores
                            type-segment-bases
                            call-space
                            slots
                            planned-target)
                          (compiler-backend-emit-call-space-add dip))
                        ""))))))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (box-get message)
                  instr-diag)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

(define (compiler-backend-emit-indirect-c-abi-store-result-call
  [type-segment-bases : i64]
  [target : CompilerBackendTarget]
  [base : CompilerIrValue]
  [func : CompilerIrValue]
  [args : CompilerIrCallArgs]
  [slots : CompilerIrCAbiReturnSlotList]
  [assignments : CompilerRegAssignmentList]
  [planned-target : String]
  [planned-stage : String]
  [types : CompilerRegVarTypeList]
  [functions : CompilerIrFunctionList]
  [externs : CompilerIrExternList]
  [program-index : CompilerBackendProgramIndex]
  [vars : i64]
  [instr-diag : CompilerDiagnostic]) : ResultCompilerBackend
  (let
    [declared-param-types : AstTypeList
      (compiler-backend-indirect-call-param-types
        types
        func
        functions
        externs
        program-index)]
    [param-types : AstTypeList
      (if (compiler-backend-type-list-has-aggregate?
        type-segment-bases
        declared-param-types)
        (compiler-backend-call-c-abi-param-types
          type-segment-bases
          types
          (CompilerBackendGlobalTypeList.Nil)
          args
          declared-param-types
          program-index)
        (if (=
          (compiler-backend-call-args-count args)
          (compiler-backend-type-list-count declared-param-types))
          declared-param-types
          (compiler-backend-call-actual-param-types
            type-segment-bases
            types
            (CompilerBackendGlobalTypeList.Nil)
            args)))]
    [call-space : i64
      (compiler-backend-call-stack-arg-layout-space
        type-segment-bases
        target
        args
        param-types
        true
        program-index)]
    ;; Mirrors the direct C-ABI store-result path: the frame reserves this region
    ;; and the call does not move %rsp.
    [dip : i64 0]
    (match (compiler-backend-emit-call-args
      type-segment-bases
      target
      assignments
      args
      param-types
      true
      0
      0
      0
      0
      0
      planned-stage
      instr-diag
      program-index
      vars)
      [(ResultCompilerBackend.Ok args-asm)
        (match (compiler-backend-emit-c-abi-return-base-save
          assignments
          base
          call-space
          planned-target)
          [(ResultCompilerBackend.Ok base-save)
            (let
              [call-reg : String
                (compiler-backend-scavenge-call-target-reg planned-target)]
              (match (compiler-backend-emit-load-value-with-plan
                assignments
                func
                call-reg)
                [(ResultCompilerBackend.Ok func-asm)
                  (ResultCompilerBackend.Ok
                    (string.append
                      (compiler-backend-emit-call-space-sub dip)
                      (string.append
                        args-asm
                        (string.append
                          base-save
                          (string.append
                            func-asm
                            (str_cat.str-cat
                              "    call *"
                              call-reg
                              "\n"
                              (string.append
                                (compiler-backend-emit-c-abi-return-stores
                                  type-segment-bases
                                  call-space
                                  slots
                                  planned-target)
                                (compiler-backend-emit-call-space-add dip))
                              ""
                              ""
                              ""))))))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err
                    (box
                      (compiler-backend-apply-instr-diagnostic
                        (box-get message)
                        instr-diag)))]))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err
              (box
                (compiler-backend-apply-instr-diagnostic
                  (box-get message)
                  instr-diag)))])]
      [(ResultCompilerBackend.Err message)
        (ResultCompilerBackend.Err
          (box
            (compiler-backend-apply-instr-diagnostic
              (box-get message)
              instr-diag)))])))

;; ---------------------------------------------------------------------------
;; Constant-divmod adjacent value forwarding.
;;
;; The signed literal expansion owns one non-fixed SRC register.  When its
;; dividend is the single-use result of the immediately preceding scalar op,
;; steer that producer into SRC instead of first defining a fixed %rax/%rdx
;; home.  Independently, when the divmod result has one use in the direct
;; Gep+StorePtr shape, leave the result in SRC and let the store read it there.
;; The home overrides below exist only while the fused IR bundle is emitted;
;; allocator assignments, liveness, and the IR itself remain unchanged.
(defenum CompilerBackendMaybeDivmodPolish
  (No)
  (Some ResultCompilerBackend))

(define (compiler-backend-divmod-producer-op? [op : CompilerIrBinOp]) : bool
  (match op
    [(CompilerIrBinOp.Add) true]
    [(CompilerIrBinOp.Mul) true]
    [(CompilerIrBinOp.BitXor) true]
    [_ false]))

(define (compiler-backend-divmod-fixed-home? [home : String]) : bool
  (or (string.eq home "%rax") (string.eq home "%rdx")))

;; Conservative retargetability gate for the producer forms this fold owns.
;; A register LHS plus a direct register/immediate RHS makes Add/Mul/BitXor a
;; no-extra-scratch destination-targetable instruction (LEA/two-address
;; add/imul/xor).  Wider fallback shapes keep their ordinary home.
(define (compiler-backend-divmod-producer-retargetable?
  [type-segment-bases : i64]
  [assignments : CompilerRegAssignmentList]
  [dst : i64]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [ty : AstType]) : bool
  (and
    (compiler-backend-divmod-producer-op? op)
    (match ty
      [(AstType.I64) true]
      [_ false])
    (compiler-backend-divmod-fixed-home?
      (compiler-backend-var-register-home assignments dst))
    (not
      (string.eq (compiler-backend-value-scalar-register assignments lhs) ""))
    (match (compiler-backend-immediate-operand rhs)
      [(CompilerBackendMaybeImmediate.Some _)
        (and
          (compiler-backend-binop-direct-width-ok? type-segment-bases op ty)
          (compiler-backend-binop-direct-immediate-ok?
            type-segment-bases
            (compiler-backend-binop-direct-mnemonic op)
            op
            rhs
            ty))]
      [(CompilerBackendMaybeImmediate.No)
        (let
          [lhs-reg : String
            (compiler-backend-value-scalar-register assignments lhs)]
          [rhs-reg : String
            (compiler-backend-value-scalar-register assignments rhs)]
          (and
            (not (string.eq rhs-reg ""))
            ;; %rbp cannot be a SIB index.  The only direct Add form with both
            ;; operands there therefore stays on the ordinary emitter.
            (not
              (and
                (match op
                  [(CompilerIrBinOp.Add) true]
                  [_ false])
                (string.eq lhs-reg "%rbp")
                (string.eq rhs-reg "%rbp")))))])))

;; Emit exactly the direct producer forms admitted above.  This avoids the
;; ordinary binop emitter's eagerly-computed fallback scavenge: after changing
;; the destination home to SRC that unused probe can otherwise manufacture an
;; emergency save/restore even though the selected LEA/IMUL/XOR needs no
;; scratch at all.
(define (compiler-backend-emit-divmod-producer-to-src
  [assignments : CompilerRegAssignmentList]
  [op : CompilerIrBinOp]
  [lhs : CompilerIrValue]
  [rhs : CompilerIrValue]
  [src : String]) : ResultCompilerBackend
  (let
    [lhs-reg : String (compiler-backend-value-scalar-register assignments lhs)]
    (match (compiler-backend-immediate-operand rhs)
      [(CompilerBackendMaybeImmediate.Some imm)
        (match op
          [(CompilerIrBinOp.Add)
            (ResultCompilerBackend.Ok
              (string.append
                (str_cat.str-cat
                  "    leaq "
                  (substring imm 1 (- (string-length imm) 1))
                  "("
                  lhs-reg)
                (str_cat.str-cat "), " src "\n")))]
          [(CompilerIrBinOp.Mul)
            (ResultCompilerBackend.Ok
              (string.append
                (str_cat.str-cat "    imulq " imm ", " lhs-reg)
                (str_cat.str-cat ", " src "\n")))]
          [(CompilerIrBinOp.BitXor)
            (ResultCompilerBackend.Ok
              (string.append
                (compiler-backend-divmod-result-move lhs-reg src)
                (str_cat.str-cat "    xorq " imm ", " src "\n")))]
          [_
            (ResultCompilerBackend.Err
              (box
                (compiler-diagnostic-at-start
                  ""
                  "backend: non-retargetable divmod producer")))])]
      [(CompilerBackendMaybeImmediate.No)
        (let
          [rhs-reg : String
            (compiler-backend-value-scalar-register assignments rhs)]
          (match op
            [(CompilerIrBinOp.Add)
              (ResultCompilerBackend.Ok
                (string.append
                  (str_cat.str-cat
                    "    leaq ("
                    (if (string.eq lhs-reg "%rbp")
                      rhs-reg
                      lhs-reg)
                    ","
                    (if (string.eq lhs-reg "%rbp")
                      lhs-reg
                      rhs-reg))
                  (str_cat.str-cat "), " src "\n")))]
            [(CompilerIrBinOp.Mul)
              (ResultCompilerBackend.Ok
                (if (string.eq src lhs-reg)
                  (str_cat.str-cat "    imulq " rhs-reg ", " src "\n")
                  (if (string.eq src rhs-reg)
                    (str_cat.str-cat "    imulq " lhs-reg ", " src "\n")
                    (string.append
                      (compiler-backend-divmod-result-move lhs-reg src)
                      (str_cat.str-cat "    imulq " rhs-reg ", " src "\n")))))]
            [(CompilerIrBinOp.BitXor)
              (ResultCompilerBackend.Ok
                (if (string.eq src lhs-reg)
                  (str_cat.str-cat "    xorq " rhs-reg ", " src "\n")
                  (if (string.eq src rhs-reg)
                    (str_cat.str-cat "    xorq " lhs-reg ", " src "\n")
                    (string.append
                      (compiler-backend-divmod-result-move lhs-reg src)
                      (str_cat.str-cat "    xorq " rhs-reg ", " src "\n")))))]
            [_
              (ResultCompilerBackend.Err
                (box
                  (compiler-diagnostic-at-start
                    ""
                    "backend: non-retargetable divmod producer")))]))])))

(define (compiler-backend-divmod-producer-feeds?
  [ctx : CompilerBackendEmissionContext]
  [producer-dst : i64]
  [producer-op : CompilerIrBinOp]
  [producer-lhs : CompilerIrValue]
  [producer-rhs : CompilerIrValue]
  [producer-ty : AstType]
  [div-op : CompilerIrBinOp]
  [div-lhs : CompilerIrValue]
  [div-rhs : CompilerIrValue]
  [div-ty : AstType]) : bool
  (and
    (compiler-backend-var-single-use? ctx.use-counts producer-dst)
    (compiler-backend-divmod-producer-retargetable?
      ctx.type-segment-bases
      ctx.assignments
      producer-dst
      producer-op
      producer-lhs
      producer-rhs
      producer-ty)
    (compiler-backend-branch-uses-var? div-lhs producer-dst)
    (compiler-backend-signed-literal-divmod-src-shape?
      ctx.type-segment-bases
      div-op
      div-rhs
      div-ty)))

;; The existing Gep+StorePtr fusion accepts the stored scalar in any GP
;; register when its address is already directly encodable.  Requiring that
;; direct address shape keeps SRC out of all later planned address scratches.
(define (compiler-backend-divmod-direct-gep-store?
  [type-segment-bases : i64]
  [assignments : CompilerRegAssignmentList]
  [result-dst : i64]
  [gep-dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [store-ptr : CompilerIrValue]
  [store-value : CompilerIrValue]) : bool
  (and
    (compiler-backend-branch-uses-var? store-ptr gep-dst)
    (compiler-backend-branch-uses-var? store-value result-dst)
    (match (compiler-backend-value-as-i64 offset)
      [(option_i64.Some _)
        (not
          (string.eq (compiler-backend-value-register-home assignments base) ""))]
      [(option_i64.None)
        (let
          [base-home : String
            (compiler-backend-address-base-filter
              (compiler-backend-value-scalar-register assignments base))]
          [offset-home : String
            (compiler-backend-value-scalar-register assignments offset)]
          (and
            (not (string.eq base-home ""))
            (not (string.eq offset-home ""))
            (not
              (string.eq
                (compiler-backend-gep-index-address-disp
                  0
                  base-home
                  (compiler-backend-type-size type-segment-bases elem-ty)
                  offset-home)
                ""))))])))

;; A direct Gep+StorePtr remains inside the divmod emergency-save region, so
;; every address input must survive the complete expansion.  Compare physical
;; register homes against the expansion's full write set: fixed %rax/%rdx, the
;; selected dividend/result SRC, and the materialised magic/mask register (when
;; one is needed).  A rejected store resumes at Gep after the emergency restores.
(define (compiler-backend-divmod-direct-gep-store-clobber-safe?
  [assignments : CompilerRegAssignmentList]
  [src : String]
  [magic : String]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]) : bool
  (let
    [base-home : String
      (match (compiler-backend-value-as-i64 offset)
        [(option_i64.Some _)
          (compiler-backend-value-register-home assignments base)]
        [(option_i64.None)
          (compiler-backend-address-base-filter
            (compiler-backend-value-scalar-register assignments base))])]
    [offset-home : String
      (match (compiler-backend-value-as-i64 offset)
        [(option_i64.Some _) ""]
        [(option_i64.None)
          (compiler-backend-value-scalar-register assignments offset)])]
    [address-mask : i64
      (bit-or
        (compiler-backend-scavenge-reg-bit base-home)
        (compiler-backend-scavenge-reg-bit offset-home))]
    [clobber-mask : i64
      (bit-or
        (bit-or
          (compiler-backend-scavenge-reg-bit "%rax")
          (compiler-backend-scavenge-reg-bit "%rdx"))
        (bit-or
          (compiler-backend-scavenge-reg-bit src)
          (compiler-backend-scavenge-reg-bit magic)))]
    (= (bit-and address-mask clobber-mask) 0)))

;; The divmod emitter can discover an emergency scratch after the polish SRC
;; has been selected.  Restore any borrowed address input before the fused
;; store reads it; other borrowed registers (including SRC) remain protected
;; until the bundle's ordinary trailing restore.
(define (compiler-backend-divmod-address-emergency-restore-asm
  [assignments : CompilerRegAssignmentList]
  [src : String]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [index : i64]) : String
  (if (>= index compiler-backend-emergency-pending-count)
    ""
    (let
      [reg : String (array-ref compiler-backend-emergency-regs index)]
      [base-home : String
        (compiler-backend-value-scalar-register assignments base)]
      [offset-home : String
        (match (compiler-backend-value-as-i64 offset)
          [(option_i64.Some _) ""]
          [(option_i64.None)
            (compiler-backend-value-scalar-register assignments offset)])]
      (str_cat.str-cat
        (if (and
          (not (string.eq reg src))
          (or (string.eq reg base-home) (string.eq reg offset-home)))
          (compiler-backend-emergency-reg-restore-asm
            reg
            (compiler-backend-emergency-reg-offset index))
          "")
        (compiler-backend-divmod-address-emergency-restore-asm
          assignments
          src
          base
          offset
          (+ index 1))))))

;; Select the same SRC class as the ordinary divmod emitter.  At a divmod site
;; a dead non-fixed dividend home wins; otherwise a suitable result home wins,
;; then the planned SRC.  The producer fold calls with allow-own=false because
;; its dividend is still being defined at the current point.  The final
;; scavenger fallback queries a forward occupancy window, so an emergency pick
;; is preserved around the complete fused bundle below.
(define (compiler-backend-divmod-polish-src
  [ctx : CompilerBackendEmissionContext]
  [dst : i64]
  [lhs : CompilerIrValue]
  [magic : String]
  [hoist-reg : String]
  [planned-src : String]
  [allow-own : bool]
  [want-remainder? : bool]
  [scavenge-dst : i64]) : String
  (let
    [lhs-home : String
      (compiler-backend-value-scalar-register ctx.assignments lhs)]
    [dst-home : String (compiler-backend-var-register-home ctx.assignments dst)]
    [own-src? : bool
      (and
        allow-own
        (compiler-backend-divmod-src-register? lhs-home)
        (not (string.eq lhs-home magic))
        (not (string.eq lhs-home hoist-reg))
        (not (compiler-backend-value-live-after-here? lhs))
        (compiler-backend-divmod-src-home-safe?
          want-remainder?
          lhs-home
          dst-home))]
    [dst-src? : bool
      (and
        (not own-src?)
        (compiler-backend-divmod-src-register? dst-home)
        (not (string.eq dst-home magic))
        (not (string.eq dst-home hoist-reg))
        (not (string.eq dst-home lhs-home)))]
    [src-exclude : (Array String)
      (compiler-backend-divmod-dividend-exclude magic)]
    (cond
      [own-src? lhs-home]
      [dst-src? dst-home]
      [(compiler-backend-divmod-src-register? planned-src) planned-src]
      [else
        (compiler-backend-scavenge-divmod-src-reg
          scavenge-dst
          (if (string.eq hoist-reg "")
            src-exclude
            (compiler-backend-scavenge-exclude-append src-exclude 5 hoist-reg))
          (if (string.eq hoist-reg "")
            5
            6))])))

;; Resolve the materialisation register with the same point, exclusions, and
;; fallback as emit-signed-literal-divmod-dst-with-plan, but without reserving an
;; emergency slot.  Admission needs the exact physical write set before deciding
;; whether a following direct store can remain inside the divmod save region.
(define (compiler-backend-divmod-polish-magic-here
  [_ctx : CompilerBackendEmissionContext]
  [dst : i64]
  [op : CompilerIrBinOp]
  [rhs : CompilerIrValue]
  [ty : AstType]
  [planned-magic : String]) : String
  (let
    [hoist : CompilerBackendConstHoistHome (compiler-backend-const-hoist-here)]
    [hoist-reg : String (compiler-backend-magic-home-reg-name hoist)]
    (if (compiler-backend-signed-literal-divmod-needs-material-reg?
      rhs
      ty
      (compiler-backend-binop-wants-remainder? op)
      hoist)
      (if (string.eq planned-magic "")
        (compiler-backend-scavenge-reg-peek
          dst
          (if (string.eq hoist-reg "")
            (compiler-backend-binop-scavenge-exclude-for-op op)
            (compiler-backend-scavenge-exclude-append
              (compiler-backend-binop-scavenge-exclude-for-op op)
              5
              hoist-reg))
          (if (string.eq hoist-reg "")
            5
            6)
          "%r8")
        planned-magic)
      "")))

(define (compiler-backend-divmod-polish-magic-ahead
  [ctx : CompilerBackendEmissionContext]
  [div-instr : CompilerIrInstr]
  [dst : i64]
  [op : CompilerIrBinOp]
  [rhs : CompilerIrValue]
  [ty : AstType]
  [instruction-offset : i64]
  [planned-magic : String]) : String
  (let
    [saved-count : i64 compiler-backend-emit-current-count]
    [saved-reserved : i64 compiler-backend-current-instr-reserved-mask]
    [_position : unit
      (begin
        (set!
          compiler-backend-emit-current-count
          (- saved-count instruction-offset))
        (set!
          compiler-backend-current-instr-reserved-mask
          (compiler-backend-instr-reserved-home-mask div-instr)))]
    [magic : String
      (compiler-backend-divmod-polish-magic-here
        ctx
        dst
        op
        rhs
        ty
        planned-magic)]
    [_restore : unit
      (begin
        (set! compiler-backend-emit-current-count saved-count)
        (set! compiler-backend-current-instr-reserved-mask saved-reserved))]
    magic))

;; The resident loop-hoisted magic is a read-only input rather than a clobber,
;; but SRC must still avoid it exactly as the ordinary divmod emitter does.
;; Resolve it at the divmod instruction rather than the earlier fused producer.
(define (compiler-backend-divmod-polish-hoist-reg-ahead
  [div-instr : CompilerIrInstr]
  [instruction-offset : i64]) : String
  (let
    [saved-count : i64 compiler-backend-emit-current-count]
    [saved-reserved : i64 compiler-backend-current-instr-reserved-mask]
    [_position : unit
      (begin
        (set!
          compiler-backend-emit-current-count
          (- saved-count instruction-offset))
        (set!
          compiler-backend-current-instr-reserved-mask
          (compiler-backend-instr-reserved-home-mask div-instr)))]
    [hoist-reg : String
      (compiler-backend-magic-home-reg-name (compiler-backend-const-hoist-here))]
    [_restore : unit
      (begin
        (set! compiler-backend-emit-current-count saved-count)
        (set! compiler-backend-current-instr-reserved-mask saved-reserved))]
    hoist-reg))

(define (compiler-backend-divmod-overrides-install!
  [first-var : i64]
  [first-reg : String]
  [second-var : i64]
  [second-reg : String]) : unit
  (begin
    (set! compiler-backend-emit-home-override0-var first-var)
    (set! compiler-backend-emit-home-override0-reg first-reg)
    (set! compiler-backend-emit-home-override1-var second-var)
    (set! compiler-backend-emit-home-override1-reg second-reg)))

;; Emit a Gep+StorePtr as the already-existing direct fused store, but return
;; only its assembly so the surrounding divmod bundle can own one emergency
;; save/restore region.
(define (compiler-backend-emit-divmod-direct-gep-store
  [ctx : CompilerBackendEmissionContext]
  [gep-dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [value : CompilerIrValue]
  [store-ty : AstType]) : ResultCompilerBackend
  (let
    [_reserved : unit
      (set!
        compiler-backend-current-instr-reserved-mask
        (compiler-backend-instr-reserved-home-mask
          (CompilerIrInstr.Gep gep-dst base offset elem-ty)))]
    [gep-disp : i64
      (compiler-backend-gep-fold-next! ctx.type-segment-bases offset elem-ty)]
    (compiler-backend-emit-store-to-gep
      ctx.type-segment-bases
      ctx.assignments
      base
      offset
      elem-ty
      value
      store-ty
      ctx.program-index
      gep-disp
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        0)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        0
        1)
      (compiler-backend-scratch-plan-register-ahead
        (compiler-backend-runtime-plan-scratch ctx.plan)
        1
        1))))

(define (compiler-backend-emit-divmod-polish-continue
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [result : ResultCompilerBackend]
  [rest : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (match result
    [(ResultCompilerBackend.Ok asm)
      (begin
        (compiler-backend-asm-append out (compiler-backend-emergency-wrap asm))
        (compiler-backend-emit-instrs ctx fallthrough rest out))]
    [(ResultCompilerBackend.Err message) (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-divmod-result-gep-store-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [div-instr : CompilerIrInstr]
  [div-dst : i64]
  [src : String]
  [gep-dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [store-value : CompilerIrValue]
  [store-ty : AstType]
  [after-store : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [saved-count : i64 compiler-backend-emit-current-count]
    [saved-reserved : i64 compiler-backend-current-instr-reserved-mask]
    [saved0-var : i64 compiler-backend-emit-home-override0-var]
    [saved0-reg : String compiler-backend-emit-home-override0-reg]
    [saved1-var : i64 compiler-backend-emit-home-override1-var]
    [saved1-reg : String compiler-backend-emit-home-override1-reg]
    [result : ResultCompilerBackend
      (begin
        (compiler-backend-divmod-overrides-install! div-dst src -1 "")
        (match (compiler-backend-emit-instr
          ctx
          (CompilerBackendMaybeLabel.No)
          div-instr)
          [(ResultCompilerBackend.Ok div-asm)
            (begin
              (set! compiler-backend-emit-current-count (- saved-count 1))
              (let
                [address-restore : String
                  (compiler-backend-divmod-address-emergency-restore-asm
                    ctx.assignments
                    src
                    base
                    offset
                    0)]
                (match (compiler-backend-emit-divmod-direct-gep-store
                  ctx
                  gep-dst
                  base
                  offset
                  elem-ty
                  store-value
                  store-ty)
                  [(ResultCompilerBackend.Ok store-asm)
                    (ResultCompilerBackend.Ok
                      (string.append
                        div-asm
                        (string.append address-restore store-asm)))]
                  [(ResultCompilerBackend.Err message)
                    (ResultCompilerBackend.Err message)])))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)]))]
    [_restore : unit
      (begin
        (set! compiler-backend-emit-current-count saved-count)
        (set! compiler-backend-current-instr-reserved-mask saved-reserved)
        (compiler-backend-divmod-overrides-install!
          saved0-var
          saved0-reg
          saved1-var
          saved1-reg))]
    (compiler-backend-emit-divmod-polish-continue
      ctx
      fallthrough
      result
      after-store
      out)))

(define (compiler-backend-emit-steered-producer-divmod-plain-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [producer-instr : CompilerIrInstr]
  [producer-dst : i64]
  [div-instr : CompilerIrInstr]
  [src : String]
  [after-div : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [saved-count : i64 compiler-backend-emit-current-count]
    [saved-reserved : i64 compiler-backend-current-instr-reserved-mask]
    [saved0-var : i64 compiler-backend-emit-home-override0-var]
    [saved0-reg : String compiler-backend-emit-home-override0-reg]
    [saved1-var : i64 compiler-backend-emit-home-override1-var]
    [saved1-reg : String compiler-backend-emit-home-override1-reg]
    [result : ResultCompilerBackend
      (begin
        (compiler-backend-divmod-overrides-install! producer-dst src -1 "")
        (match (match producer-instr
          [(CompilerIrInstr.BinOp _ op lhs rhs _)
            (compiler-backend-emit-divmod-producer-to-src
              ctx.assignments
              op
              lhs
              rhs
              src)]
          [_
            (ResultCompilerBackend.Err
              (box
                (compiler-diagnostic-at-start
                  ""
                  "backend: non-retargetable divmod producer")))])
          [(ResultCompilerBackend.Ok producer-asm)
            (begin
              (set! compiler-backend-emit-current-count (- saved-count 1))
              (match (compiler-backend-emit-instr
                ctx
                (CompilerBackendMaybeLabel.No)
                div-instr)
                [(ResultCompilerBackend.Ok div-asm)
                  (ResultCompilerBackend.Ok
                    (string.append producer-asm div-asm))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)]))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)]))]
    [_restore : unit
      (begin
        (set! compiler-backend-emit-current-count saved-count)
        (set! compiler-backend-current-instr-reserved-mask saved-reserved)
        (compiler-backend-divmod-overrides-install!
          saved0-var
          saved0-reg
          saved1-var
          saved1-reg))]
    (compiler-backend-emit-divmod-polish-continue
      ctx
      fallthrough
      result
      after-div
      out)))

(define (compiler-backend-emit-steered-producer-divmod-gep-store-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [producer-instr : CompilerIrInstr]
  [producer-dst : i64]
  [div-instr : CompilerIrInstr]
  [div-dst : i64]
  [src : String]
  [gep-dst : i64]
  [base : CompilerIrValue]
  [offset : CompilerIrValue]
  [elem-ty : AstType]
  [store-value : CompilerIrValue]
  [store-ty : AstType]
  [after-store : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (let
    [saved-count : i64 compiler-backend-emit-current-count]
    [saved-reserved : i64 compiler-backend-current-instr-reserved-mask]
    [saved0-var : i64 compiler-backend-emit-home-override0-var]
    [saved0-reg : String compiler-backend-emit-home-override0-reg]
    [saved1-var : i64 compiler-backend-emit-home-override1-var]
    [saved1-reg : String compiler-backend-emit-home-override1-reg]
    [result : ResultCompilerBackend
      (begin
        (compiler-backend-divmod-overrides-install!
          producer-dst
          src
          div-dst
          src)
        (match (match producer-instr
          [(CompilerIrInstr.BinOp _ op lhs rhs _)
            (compiler-backend-emit-divmod-producer-to-src
              ctx.assignments
              op
              lhs
              rhs
              src)]
          [_
            (ResultCompilerBackend.Err
              (box
                (compiler-diagnostic-at-start
                  ""
                  "backend: non-retargetable divmod producer")))])
          [(ResultCompilerBackend.Ok producer-asm)
            (begin
              (set! compiler-backend-emit-current-count (- saved-count 1))
              (match (compiler-backend-emit-instr
                ctx
                (CompilerBackendMaybeLabel.No)
                div-instr)
                [(ResultCompilerBackend.Ok div-asm)
                  (begin
                    (set! compiler-backend-emit-current-count (- saved-count 2))
                    (let
                      [address-restore : String
                        (compiler-backend-divmod-address-emergency-restore-asm
                          ctx.assignments
                          src
                          base
                          offset
                          0)]
                      (match (compiler-backend-emit-divmod-direct-gep-store
                        ctx
                        gep-dst
                        base
                        offset
                        elem-ty
                        store-value
                        store-ty)
                        [(ResultCompilerBackend.Ok store-asm)
                          (ResultCompilerBackend.Ok
                            (string.append
                              producer-asm
                              (string.append
                                div-asm
                                (string.append address-restore store-asm))))]
                        [(ResultCompilerBackend.Err message)
                          (ResultCompilerBackend.Err message)])))]
                [(ResultCompilerBackend.Err message)
                  (ResultCompilerBackend.Err message)]))]
          [(ResultCompilerBackend.Err message)
            (ResultCompilerBackend.Err message)]))]
    [_restore : unit
      (begin
        (set! compiler-backend-emit-current-count saved-count)
        (set! compiler-backend-current-instr-reserved-mask saved-reserved)
        (compiler-backend-divmod-overrides-install!
          saved0-var
          saved0-reg
          saved1-var
          saved1-reg))]
    (compiler-backend-emit-divmod-polish-continue
      ctx
      fallthrough
      result
      after-store
      out)))

(define (compiler-backend-emit-steered-producer-divmod-rest
  [ctx : CompilerBackendEmissionContext]
  [fallthrough : CompilerBackendMaybeLabel]
  [producer-instr : CompilerIrInstr]
  [producer-dst : i64]
  [div-instr : CompilerIrInstr]
  [div-dst : i64]
  [src : String]
  [magic : String]
  [after-div : CompilerIrInstrList]
  [out : (&mut out CompilerBackendAsmBuf)]) : ResultCompilerBackend
  (if (compiler-backend-var-single-use? ctx.use-counts div-dst)
    (match after-div
      [(CompilerIrInstrList.Cons maybe-gep after-gep)
        (match maybe-gep
          [(CompilerIrInstr.Gep gep-dst base offset elem-ty)
            (if (compiler-backend-var-single-use? ctx.use-counts gep-dst)
              (match (box-get after-gep)
                [(CompilerIrInstrList.Cons maybe-store after-store)
                  (match maybe-store
                    [(CompilerIrInstr.StorePtr store-ptr store-value store-ty)
                      (if (and
                        (compiler-backend-divmod-direct-gep-store?
                          ctx.type-segment-bases
                          ctx.assignments
                          div-dst
