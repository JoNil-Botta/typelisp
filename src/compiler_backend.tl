(defstruct CompilerBackendProgramIndex
  (functions hashmap.I64I64Map)
  (function-names (Array String))
  (function-signatures (Array CompilerBackendMaybeSignature))
  (extern-signatures hashmap.I64I64Map)
  (extern-names (Array String))
  (extern-signature-values (Array CompilerBackendMaybeSignature))
  (extern-references hashmap.I64I64Map)
  (extern-link-symbols (Array String))
  (extern-provided (Array bool))
  ;; #2386: aggregate type name -> machine-word count, for every register-group
  ;; type constructed anywhere in the program (whole-program compile). Drives the
  ;; backend/regalloc 2-word-vs-handle decision that the type name alone cannot.
  (group-word-counts hashmap.StringI64Map)
  ;; #2601: aggregate type name -> bit mask of SSE-class words. Bit 0 marks
  ;; word0, bit 1 marks word1. A missing/zero mask means all INTEGER words.
  (group-word-class-masks hashmap.StringI64Map))

(defstruct CompilerBackendSourceSpanIndex
  (entries hashmap.StringI64Map)
  (values (Array CompilerMaybeSourceSpan)))

(define (compiler-backend-runtime-tail-profile?
  [tail : CompilerBackendRuntimeTailPlan]) : bool
  (struct-get tail profile))

(define (compiler-backend-runtime-tail-hash-string?
  [tail : CompilerBackendRuntimeTailPlan]) : bool
  (struct-get tail hash-string))

;; Backend code-generation target (#646). Linux/System V and Windows x64 are
;; both modeled here; target-specific runtime helpers are emitted below.
(defenum CompilerBackendTarget
  (Linux)
  (Windows))

(define (compiler-backend-regalloc-abi [target : CompilerBackendTarget]) : CompilerRegTargetAbi
  (match target
    [(CompilerBackendTarget.Linux) CompilerRegTargetAbi.Linux]
    [(CompilerBackendTarget.Windows) CompilerRegTargetAbi.Windows]))

(defenum CompilerBackendMode
  (Scalar)
  (Avx2)
  (Avx512))

(define (compiler-backend-mode-scalar? [mode : CompilerBackendMode]) : bool
  (match mode
    [(CompilerBackendMode.Scalar) true]
    [_ false]))

;; Whether scalar functions get full register allocation (#perf). Register
;; allocation makes the EMITTED binary faster but its planning + register-aware
;; emission cost more compile time than it saves on a single self-compile, so it
;; is reserved for opt level 2 Ã¢â‚¬â€ the high-quality path whose extra cost the
;; benchmark's 2x budget accommodates. opt levels 0-2 stay on the cheap
;; stack-only homing. The driver sets this from the opt level before emitting;
;; it is set deterministically per compile so a given opt level always produces
;; identical assembly (the stage2==stage3 fixpoint holds within each level). SIMD
;; (Avx2/Avx512) functions always use register allocation regardless.
(define compiler-backend-scalar-registers-enabled : bool
  false)

(define (compiler-backend-set-scalar-registers! [enabled : bool]) : unit
  (set! compiler-backend-scalar-registers-enabled enabled))

(define compiler-backend-current-fn-win64 : bool
  false)

(define (compiler-backend-set-current-fn-abi! [abi : CompilerRegTargetAbi]) : unit
  (set!
    compiler-backend-current-fn-win64
    (match abi
      [(CompilerRegTargetAbi.Windows) true]
      [_ false])))

(define (compiler-backend-set-current-fn-linux!) : unit
  (set! compiler-backend-current-fn-win64 false))

(define (compiler-backend-set-current-fn-win64!) : unit
  (set! compiler-backend-current-fn-win64 true))

(define (compiler-backend-current-fn-win64?) : bool
  compiler-backend-current-fn-win64)

;; Per-emission cache for interned user-symbol mangling. The generation guard
;; keeps direct helper calls safe across intern-reset! reuse of numeric ids.
(define compiler-backend-user-symbol-cache-values : (Array String)
  (array.make-array String 262144))
(define compiler-backend-user-symbol-cache-epochs : (Array i64)
  (array.make-array i64 262144))
(define compiler-backend-user-symbol-cache-epoch : i64
  1)
(define compiler-backend-user-symbol-cache-count-value : i64
  0)
(define compiler-backend-user-symbol-cache-generation : i64
  -1)

(define (compiler-backend-user-symbol-cache-reset!) : unit
  (begin
    (set! compiler-backend-user-symbol-cache-count-value 0)
    (set!
      compiler-backend-user-symbol-cache-epoch
      (+ compiler-backend-user-symbol-cache-epoch 1))
    (set! compiler-backend-user-symbol-cache-generation (ci.intern-generation))))

(define (compiler-backend-user-symbol-cache-ensure-current!) : unit
  (if (= compiler-backend-user-symbol-cache-generation (ci.intern-generation))
    unit
    (compiler-backend-user-symbol-cache-reset!)))

(define (compiler-backend-user-symbol-cache-count) : i64
  compiler-backend-user-symbol-cache-count-value)

(define compiler-backend-addr-of-forwarding-enabled : bool
  false)
(define compiler-backend-addr-of-forwarding-src : (Array i64)
  (array.make-array i64 0))

;; Compare->branch fusion state. A comparison result may be fused to `cmp`/`jcc`
;; (never materialized as a boolean) when EVERY use of it is a branch fed by its
;; own adjacent compare. Equivalently: its total use count equals its count of
;; such "free branch" uses. This is strictly more permissive than a global
;; single-use gate: opt2 loop rotation duplicates a guard into an entry check
;; and a latch check that share one var id (two defs, two adjacent-branch uses),
;; which the single-use gate rejected even though each pair is locally fusable.
;;
;; To stay nearly free at compile time, this reuses the use-count array the
;; backend already computes (held by reference, not copied) and only adds a
;; cheap per-instruction scan that tallies free-branch uses.
(define compiler-backend-fuse-need-ready : bool
  false)
(define compiler-backend-fuse-use-counts : (Array i64)
  (array.make-array i64 0))
(define compiler-backend-fuse-free-counts : (Array i64)
  (array.make-array i64 0))

(defenum CompilerBackendEmitInstrsMode
  (Normal)
  (Rax i64 AstType)
  (CallRax i64 AstType))

(define compiler-backend-emit-instrs-loop-active : bool
  false)
(define compiler-backend-emit-instrs-continue-pending : bool
  false)
(define compiler-backend-emit-instrs-next-mode : CompilerBackendEmitInstrsMode
  (CompilerBackendEmitInstrsMode.Normal))

(define (compiler-backend-empty-instr-list) : CompilerIrInstrList
  CompilerIrInstrList.Nil)

(define compiler-backend-emit-instrs-next-instrs : CompilerIrInstrList
  (compiler-backend-empty-instr-list))
(define compiler-backend-emit-instrs-next-buf : text_buf.TextBuf
  (text_buf.empty))

(define (compiler-backend-emit-instrs-set-continue!
  [mode : CompilerBackendEmitInstrsMode]
  [instrs : CompilerIrInstrList]
  [buf : text_buf.TextBuf]) : ResultCompilerBackend
  (begin
    (set! compiler-backend-emit-instrs-continue-pending true)
    (set! compiler-backend-emit-instrs-next-mode mode)
    (set! compiler-backend-emit-instrs-next-instrs instrs)
    (set! compiler-backend-emit-instrs-next-buf buf)
    (ResultCompilerBackend.Ok "")))

