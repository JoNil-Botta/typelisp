          ".L_tl_argv")
        (cobj.CompilerObjectX64Instr.MovRdxRip ".L_tl_argv"))]
    [with-main-call : CompilerBackendObjectParts
      (compiler-backend-object-add-text
        (compiler-backend-object-add-text-relocation
          with-argv
          entry
          (cobj.CompilerObjectRelocationKind.Call)
          "main")
        (cobj.CompilerObjectX64Instr.Call "main"))]
    [with-move-exit-code : CompilerBackendObjectParts
      (compiler-backend-object-add-text
        with-main-call
        (cobj.CompilerObjectX64Instr.MovRcxRax))]
    [with-exit-call : CompilerBackendObjectParts
      (compiler-backend-object-add-text
        (compiler-backend-object-add-text-relocation
          with-move-exit-code
          entry
          (cobj.CompilerObjectRelocationKind.Call)
          "ExitProcess")
        (cobj.CompilerObjectX64Instr.Call "ExitProcess"))]
    (compiler-backend-object-add-text
      with-exit-call
      (cobj.CompilerObjectX64Instr.Label entry-end))))

(define (compiler-backend-object-add-windows-entry-unwind
  [parts : CompilerBackendObjectParts]) : CompilerBackendObjectParts
  (let
    [xdata-label : String ".L_tl_start_xdata"]
    [pdata-begin : String ".L_tl_start_pdata_begin"]
    [pdata-end : String ".L_tl_start_pdata_end"]
    [pdata-unwind : String ".L_tl_start_pdata_unwind"]
    [with-xdata-symbol : CompilerBackendObjectParts
      (compiler-backend-object-symbol-local-section
        parts
        xdata-label
        (cobj.CompilerObjectSectionKind.Xdata)
        (cobj.CompilerObjectSymbolKind.Data))]
    [with-xdata : CompilerBackendObjectParts
      (compiler-backend-object-add-xdata
        (compiler-backend-object-add-xdata
          with-xdata-symbol
          (cobj.CompilerObjectDataRecord.Label xdata-label))
        (cobj.CompilerObjectDataRecord.Bytes
          (compiler-backend-object-windows-entry-xdata-bytes)))]
    [with-pdata-begin : CompilerBackendObjectParts
      (compiler-backend-object-add-pdata
        (compiler-backend-object-add-pdata-relocation
          (compiler-backend-object-add-pdata
            with-xdata
            (cobj.CompilerObjectDataRecord.Label pdata-begin))
          pdata-begin
          (cobj.CompilerObjectRelocationKind.Addr32Nb)
          "_tl_start")
        (cobj.CompilerObjectDataRecord.SymbolRva32 "_tl_start"))]
    [with-pdata-end : CompilerBackendObjectParts
      (compiler-backend-object-add-pdata
        (compiler-backend-object-add-pdata-relocation
          (compiler-backend-object-add-pdata
            with-pdata-begin
            (cobj.CompilerObjectDataRecord.Label pdata-end))
          pdata-end
          (cobj.CompilerObjectRelocationKind.Addr32Nb)
          ".L_tl_start_end")
        (cobj.CompilerObjectDataRecord.SymbolRva32 ".L_tl_start_end"))]
    (compiler-backend-object-add-pdata
      (compiler-backend-object-add-pdata-relocation
        (compiler-backend-object-add-pdata
          with-pdata-end
          (cobj.CompilerObjectDataRecord.Label pdata-unwind))
        pdata-unwind
        (cobj.CompilerObjectRelocationKind.Addr32Nb)
        xdata-label)
      (cobj.CompilerObjectDataRecord.SymbolRva32 xdata-label))))

(define (compiler-backend-object-add-windows-entry
  [parts : CompilerBackendObjectParts]) : CompilerBackendObjectParts
  (compiler-backend-object-add-windows-entry-unwind
    (compiler-backend-object-add-windows-entry-text
      (compiler-backend-object-add-windows-runtime-text
        (compiler-backend-object-add-windows-entry-data parts)))))

(define (compiler-backend-object-entry-symbols
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [emit-entry : bool]
  [crt-entry : bool]) : CompilerBackendObjectParts
  (if emit-entry
    (match target
      [(CompilerBackendTarget.Linux)
        (if crt-entry
          parts
          (compiler-backend-object-add-linux-entry parts))]
      [(CompilerBackendTarget.Windows)
        (if crt-entry
          parts
          (compiler-backend-object-add-windows-entry parts))])
    parts))

(define (compiler-backend-object-image-sections
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [emit-entry : bool]
  [crt-entry : bool]) : cobj.CompilerObjectSectionList
  (let
    [empty-data : cobj.CompilerObjectDataRecordList
      (cobj.compiler-object-data-record-builder-finish
        (cobj.compiler-object-data-record-builder-with-capacity 1))]
    [empty-instrs : cobj.CompilerObjectX64InstrList
      (cobj.compiler-object-instr-builder-finish
        (cobj.compiler-object-instr-builder-with-capacity 1))]
    [text-instrs : cobj.CompilerObjectX64InstrList
      (cobj.compiler-object-instr-builder-finish (struct-get parts text))]
    [data-records : cobj.CompilerObjectDataRecordList
      (cobj.compiler-object-data-record-builder-finish (struct-get parts data))]
    [rodata-records : cobj.CompilerObjectDataRecordList
      (cobj.compiler-object-data-record-builder-finish
        (struct-get parts rodata))]
    [bss-records : cobj.CompilerObjectDataRecordList
      (cobj.compiler-object-data-record-builder-finish (struct-get parts bss))]
    [pdata-records : cobj.CompilerObjectDataRecordList
      (cobj.compiler-object-data-record-builder-finish (struct-get parts pdata))]
    [xdata-records : cobj.CompilerObjectDataRecordList
      (cobj.compiler-object-data-record-builder-finish (struct-get parts xdata))]
    [sections0 : cobj.CompilerObjectSectionBuilder
      (cobj.compiler-object-section-builder-with-capacity 7)]
    [sections1 : cobj.CompilerObjectSectionBuilder
      (cobj.compiler-object-section-builder-push
        sections0
        (cobj.CompilerObjectSection.Section
          (cobj.CompilerObjectSectionKind.Text)
          empty-data
          text-instrs))]
    [sections2 : cobj.CompilerObjectSectionBuilder
      (cobj.compiler-object-section-builder-push
        sections1
        (cobj.CompilerObjectSection.Section
          (cobj.CompilerObjectSectionKind.Data)
          data-records
          empty-instrs))]
    [sections3 : cobj.CompilerObjectSectionBuilder
      (cobj.compiler-object-section-builder-push
        sections2
        (cobj.CompilerObjectSection.Section
          (cobj.CompilerObjectSectionKind.Rodata)
          rodata-records
          empty-instrs))]
    [sections4 : cobj.CompilerObjectSectionBuilder
      (cobj.compiler-object-section-builder-push
        sections3
        (cobj.CompilerObjectSection.Section
          (cobj.CompilerObjectSectionKind.Bss)
          bss-records
          empty-instrs))]
    (match target
      [(CompilerBackendTarget.Linux)
        (cobj.compiler-object-section-builder-finish sections4)]
      [(CompilerBackendTarget.Windows)
        (let
          [sections5 : cobj.CompilerObjectSectionBuilder
            (cobj.compiler-object-section-builder-push
              sections4
              (cobj.CompilerObjectSection.Section
                (cobj.CompilerObjectSectionKind.Pdata)
                pdata-records
                empty-instrs))]
          [sections6 : cobj.CompilerObjectSectionBuilder
            (cobj.compiler-object-section-builder-push
              sections5
              (cobj.CompilerObjectSection.Section
                (cobj.CompilerObjectSectionKind.Xdata)
                xdata-records
                empty-instrs))]
          [sections7 : cobj.CompilerObjectSectionBuilder
            (cobj.compiler-object-section-builder-push
              sections6
              (cobj.CompilerObjectSection.Section
                (cobj.CompilerObjectSectionKind.Rsrc)
                (if (and emit-entry (not crt-entry))
                  (compiler-backend-object-windows-manifest-resource-records)
                  empty-data)
                empty-instrs))]
          (cobj.compiler-object-section-builder-finish sections7))])))

(define (compiler-backend-object-image-symbols
  [parts : CompilerBackendObjectParts]
  [emit-manifest-resource : bool]) : cobj.CompilerObjectSymbolList
  (cobj.compiler-object-symbol-builder-finish
    (if emit-manifest-resource
      (cobj.compiler-object-symbol-builder-push
        (struct-get parts symbols)
        (cobj.CompilerObjectSymbol.Symbol
          compiler-backend-object-windows-manifest-label
          (cobj.CompilerObjectSymbolBinding.Local)
          (cobj.CompilerObjectSymbolKind.Data)
          (cobj.CompilerObjectMaybeSection.Some
            (cobj.CompilerObjectSectionKind.Rsrc))))
      (struct-get parts symbols))))

(define (compiler-backend-object-image-relocations
  [parts : CompilerBackendObjectParts]
  [emit-manifest-resource : bool]) : cobj.CompilerObjectRelocationList
  (cobj.compiler-object-relocation-builder-finish
    (if emit-manifest-resource
      (cobj.compiler-object-relocation-builder-push
        (struct-get parts relocations)
        (cobj.CompilerObjectRelocation.Relocation
          (cobj.CompilerObjectSectionKind.Rsrc)
          compiler-backend-object-windows-rsrc-data-label
          (cobj.CompilerObjectRelocationKind.Addr32Nb)
          compiler-backend-object-windows-manifest-label))
      (struct-get parts relocations))))

(define (compiler-backend-object-image-from-parts
  [parts : CompilerBackendObjectParts]
  [target : CompilerBackendTarget]
  [emit-entry : bool]
  [crt-entry : bool]) : cobj.CompilerObjectImage
  (let
    [emit-manifest-resource : bool
      (and emit-entry (not crt-entry) (compiler-backend-target-windows? target))]
    (cobj.CompilerObjectImage
      (compiler-backend-object-image-sections parts target emit-entry crt-entry)
      (compiler-backend-object-image-symbols parts emit-manifest-resource)
      (compiler-backend-object-image-relocations parts emit-manifest-resource))))

(define (compiler-backend-object-image-after-index
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [_mode : CompilerBackendMode]
  [entry-functions : CompilerIrFunctionList]
  [globals : CompilerIrGlobalList]
  [externs : CompilerIrExternList]
  [plan : CompilerBackendRuntimePlan]
  [program-index : CompilerBackendProgramIndex]
  [emit-entry : bool]
  [crt-entry : bool]) : cobj.CompilerObjectImage
  (let
    [collections : CompilerBackendProgramCollections
      (compiler-backend-collect-program-collections program)]
    [closure-names : BackendStringList
      (compiler-backend-program-collections-functions collections)]
    [strings : BackendStringList
      (compiler-backend-program-collections-strings collections)]
    [bytes : BackendStringList
      (compiler-backend-program-collections-bytes collections)]
    [floats : BackendFloatList
      (compiler-backend-program-collections-floats collections)]
    [uses-f64-neg : bool
      (compiler-backend-program-collections-uses-f64-neg? collections)]
    [runtime-index : CompilerBackendRuntimeIndex
      (compiler-backend-runtime-index entry-functions externs)]
    [seed : CompilerBackendObjectParts
      (compiler-backend-object-entry-symbols
        (compiler-backend-object-add-tlci-entry-runtime-text
          (compiler-backend-object-runtime-symbols
            (compiler-backend-object-externs
              (compiler-backend-object-f64-sign-bit
                (compiler-backend-object-floats
                  (compiler-backend-object-bytes
                    (compiler-backend-object-strings
                      (compiler-backend-object-closure-descriptors
                        (compiler-backend-object-globals
                          (compiler-backend-object-functions
                            (compiler-backend-object-parts-empty)
                            target
                            entry-functions
                            plan
                            program-index)
                          target
                          globals)
                        closure-names
                        program-index)
                      strings)
                    bytes)
                  floats)
                uses-f64-neg)
              externs
              plan
              runtime-index
              closure-names)
            plan
            (compiler-backend-object-runtime-symbols-list))
          target
          (compiler-backend-runtime-tail-tlci-macro-entry?
            (compiler-backend-runtime-plan-tail plan)))
        target
        emit-entry
        crt-entry)]
    (compiler-backend-object-image-from-parts
      (compiler-backend-object-add-bss
        seed
        (cobj.CompilerObjectDataRecord.Zero 0))
      target
      emit-entry
      crt-entry)))

(define (compiler-backend-emit-program-object-image-target-with-mode-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [_spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendObject
  (begin
    (compiler-backend-user-symbol-cache-reset!)
    (match (compiler-backend-runtime-plan program)
      [(ResultBackendRuntimePlan.Ok plan)
        (if (compiler-backend-target-runtime-ok? target plan)
          (match program
            [(CompilerIrProgram.Program globals functions externs)
              (let
                [entry-functions : CompilerIrFunctionList
                  (compiler-backend-functions-with-implicit-main
                    functions
                    emit-entry)]
                [program-index : CompilerBackendProgramIndex
                  (compiler-backend-program-index-build entry-functions externs)]
                (match (compiler-backend-validate-function-symbols
                  globals
                  entry-functions
                  externs
                  plan
                  program-index)
                  [(ResultCompilerBackendSymbolValidation.Ok _)
                    (match (compiler-backend-switch-validate-functions
                      entry-functions)
                      [(CompilerBackendSwitchValidation.Ok)
                        (ResultCompilerBackendObject.Ok
                          (compiler-backend-object-image-after-index
                            program
                            target
                            mode
                            entry-functions
                            globals
                            externs
                            plan
                            program-index
                            emit-entry
                            crt-entry))]
                      [(CompilerBackendSwitchValidation.Err message)
                        (ResultCompilerBackendObject.Err
                          (box (compiler-diagnostic-at-start "" message)))])]
                  [(ResultCompilerBackendSymbolValidation.Err message)
                    (ResultCompilerBackendObject.Err message)]))])
          (ResultCompilerBackendObject.Err
            (box
              (compiler-diagnostic-at-start
                ""
                "backend: internal target runtime rejection"))))]
      [(ResultBackendRuntimePlan.Err message)
        (ResultCompilerBackendObject.Err
          (box (compiler-diagnostic-at-start "" message)))])))

(define (compiler-backend-emit-program-object-image-target-with-mode
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackendObject
  (compiler-backend-emit-program-object-image-target-with-mode-and-crt
    program
    target
    mode
    spans
    emit-entry
    false))

(define (compiler-backend-emit-program-object-image-target
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackendObject
  (compiler-backend-emit-program-object-image-target-with-mode
    program
    target
    (CompilerBackendMode.Scalar)
    spans
    emit-entry))

(define (compiler-backend-emit-program-object-image-linux
  [program : CompilerIrProgram]
  [spans : CompilerSourceSpans]) : ResultCompilerBackendObject
  (compiler-backend-emit-program-object-image-target
    program
    (CompilerBackendTarget.Linux)
    spans
    true))

(define (compiler-backend-peephole-byte-at [data : (Ptr u8)] [index : i64]) : i64
  (cast
    (unsafe
      (ptr-read (ptr-offset data index)))
    : i64))

(cfg
  feature-tl-memchr
  (define (compiler-backend-peephole-line-end
    [asm-data : (Ptr u8)]
    [start : i64]
    [n : i64]) : i64
    (let
      [offset : i64
        (if (< start n)
          (unsafe
            (compiler-backend-runtime-index-of-byte
              (ptr-offset asm-data start)
              (- n start)
              (cast 10 : u8)))
          -1)]
      (if (< offset 0)
        n
        (+ start offset)))))

(cfg
  (not feature-tl-memchr)
  (define (compiler-backend-peephole-line-end
    [asm-data : (Ptr u8)]
    [start : i64]
    [n : i64]) : i64
    (let
      [i : i64 start]
      [done : bool false]
      (begin
        (while (and (not done) (< i n))
          (if (= (compiler-backend-peephole-byte-at asm-data i) 10)
            (set! done true)
            (set! i (+ i 1))))
        i))))

(define (compiler-backend-peephole-append-line
  [buf : (text_buf_borrowed.TextBufBorrowed asm)]
  [line : String]
  [newline : bool]) : (text_buf_borrowed.TextBufBorrowed asm)
  (if newline
    (text_buf_borrowed.append-char
      (text_buf_borrowed.append-owned buf line)
      '\n')
    (text_buf_borrowed.append-owned buf line)))

(define (compiler-backend-peephole-append-line-range
  [buf : (text_buf_borrowed.TextBufBorrowed asm)]
  [asm : String]
  [start : i64]
  [end : i64]
  [newline : bool]) : (text_buf_borrowed.TextBufBorrowed asm)
  (let
    [slice-end : i64
      (if newline
        (+ end 1)
        end)]
    (if (> slice-end start)
      (text_buf_borrowed.append-slice buf (& asm) start (- slice-end start))
      buf)))

(define (compiler-backend-peephole-line-append-owned?
  [line : CompilerBackendPeepholeLine]) : bool
  (struct-get line owned))

(define (compiler-backend-peephole-append-parsed-line
  [buf : (text_buf_borrowed.TextBufBorrowed asm)]
  [asm : String]
  [line : CompilerBackendPeepholeLine]) : (text_buf_borrowed.TextBufBorrowed
    asm)
  (if (compiler-backend-peephole-line-append-owned? line)
    (compiler-backend-peephole-append-line
      buf
      (struct-get line src)
      (struct-get line newline))
    (compiler-backend-peephole-append-line-range
      buf
      asm
      (struct-get line start)
      (struct-get line end)
      (struct-get line newline))))

(define (compiler-backend-peephole-append-pending-line
  [buf : (text_buf_borrowed.TextBufBorrowed asm)]
  [asm : String]
  [start : i64]
  [end : i64]
  [owned-line : String]
  [owned? : bool]
  [newline : bool]) : (text_buf_borrowed.TextBufBorrowed asm)
  (if owned?
    (compiler-backend-peephole-append-line buf owned-line newline)
    (compiler-backend-peephole-append-line-range buf asm start end newline)))

(define (compiler-backend-peephole-find-comma-space
  [line : String]
  [start : i64]) : i64
  (let
    [n : i64 (string.string-length line)]
    [i : i64 start]
    [found : i64 -1]
    [done : bool false]
    (begin
      (while (not done)
        (if (< (+ i 1) n)
          (if (and
            (= (string.string-ref line i) ',')
            (= (string.string-ref line (+ i 1)) ' '))
            (begin
              (set! found i)
              (set! done true))
            (set! i (+ i 1)))
          (set! done true)))
      found)))

(define (compiler-backend-peephole-movq [line : String]) : CompilerBackendPeepholeMove
  (let
    [prefix : String "    movq "]
    [prefix-len : i64 (string.string-length prefix)]
    [n : i64 (string.string-length line)]
    (if (compiler-backend-string-prefix-at? line prefix 0)
      (let
        [comma : i64
          (compiler-backend-peephole-find-comma-space line prefix-len)]
        (if (and (> comma prefix-len) (< (+ comma 2) n))
          (CompilerBackendPeepholeMove.Move
            (string.substring line prefix-len (- comma prefix-len))
            (string.substring line (+ comma 2) (- n (+ comma 2))))
          (CompilerBackendPeepholeMove.NoMove)))
      (CompilerBackendPeepholeMove.NoMove))))

(define (compiler-backend-peephole-movq-prefix-len) : i64
  9)

(define (compiler-backend-peephole-movq-prefix-at-range?
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (if (> (+ start (compiler-backend-peephole-movq-prefix-len)) end)
    false
    (and
      (= (compiler-backend-peephole-byte-at asm-data start) 32)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 1)) 32)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 2)) 32)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 3)) 32)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 4)) 109)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 5)) 111)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 6)) 118)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 7)) 113)
      (= (compiler-backend-peephole-byte-at asm-data (+ start 8)) 32))))

(define (compiler-backend-peephole-find-comma-space-range
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [i : i64 start]
    [found : i64 -1]
    [done : bool false]
    (begin
      (while (not done)
        (if (< (+ i 1) end)
          (if (and
            (= (compiler-backend-peephole-byte-at asm-data i) 44)
            (= (compiler-backend-peephole-byte-at asm-data (+ i 1)) 32))
            (begin
              (set! found i)
              (set! done true))
            (set! i (+ i 1)))
          (set! done true)))
      found)))

(define (compiler-backend-peephole-movq-range
  [asm : String]
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]) : CompilerBackendPeepholeMove
  (let
    [prefix-len : i64 (compiler-backend-peephole-movq-prefix-len)]
    [operand-start : i64 (+ start prefix-len)]
    (if (compiler-backend-peephole-movq-prefix-at-range? asm-data start end)
      (let
        [comma : i64
          (compiler-backend-peephole-find-comma-space-range
            asm-data
            operand-start
            end)]
        (if (and (> comma operand-start) (< (+ comma 2) end))
          (CompilerBackendPeepholeMove.Move
            (string.substring asm operand-start (- comma operand-start))
            (string.substring asm (+ comma 2) (- end (+ comma 2))))
          (CompilerBackendPeepholeMove.NoMove)))
      (CompilerBackendPeepholeMove.NoMove))))

(define (compiler-backend-peephole-line-movq
  [asm : String]
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [owned-line : String]
  [owned? : bool]) : CompilerBackendPeepholeMove
  (if owned?
    (compiler-backend-peephole-movq owned-line)
    (compiler-backend-peephole-movq-range asm asm-data start end)))

(define (compiler-backend-peephole-register-operand? [operand : String]) : bool
  (and
    (> (string.string-length operand) 0)
    (= (string.string-ref operand 0) '%')))

;; M-G3 stage 1: frame slots are emitted rsp-relative (`N(%rsp)`); rbp forms
;; survive in needs-rbp functions and at positive incoming-stack-arg offsets.
;; Recognizing `(%rsp)` operands as slots is sound with the same argument as
;; rbp: every %rsp-mutating line (pushq/popq/subq/addq/leave/leaq-to-rsp/
;; movq-to-rsp/ret) is a non-movq/movq-to-untracked line that clears the whole
;; owner map; a returned call restores %rsp and keeps only callee-saved
;; stack-slot owners. Within any owner-map lifetime %rsp is therefore constant
;; for a tracked owner, and equal operand strings imply equal addresses (and
;; distinct strings, distinct addresses). Indexed forms contain "(%rsp," /
;; "(%rbp," and stay excluded.
(define (compiler-backend-peephole-stack-slot-operand? [operand : String]) : bool
  (or
    (compiler-backend-string-contains? operand "(%rbp)")
    (compiler-backend-string-contains? operand "(%rsp)")))

;; SCAV2: true iff `operand` is a RIP-relative global reference `SYM(%rip)` -- a
;; load of a module-level global's contents. Its address is a fixed symbol, so
;; the operand string uniquely identifies the memory location (equal strings =>
;; equal addresses, distinct strings => distinct addresses), exactly like a stack
;; slot. Indexed rip forms do not exist on x86-64, so a trailing "(%rip)" is
;; unambiguous. Distinct from stack slots (which spell "(%rbp)"/"(%rsp)").
(define (compiler-backend-peephole-global-rip-operand? [operand : String]) : bool
  (let
    [len : i64 (string.string-length operand)]
    (and (>= len 6) (string.eq (string.substring operand (- len 6) 6) "(%rip)"))))

;; SCAV2: memory operands the owner map may track with structured identity:
;; rbp/rsp stack slots AND SYM(%rip) globals. Both are stable addresses whose contents
;; change only via a store to that exact operand: a store to a slot clears just
;; that slot's mirrors (movq-owners-transfer stack-slot arm); a store to a global
;; or through any pointer clears the whole map (the else arm /
;; line-clobber-owners). Calls clear all global mirrors and caller-saved stack
;; mirrors, while preserving only callee-saved stack-slot mirrors. Since a stack
;; store cannot alias a global and vice versa, keeping a global mirror across a
;; stack store (and a slot mirror across a global store's whole-map clear is
;; moot) is sound.
(define (compiler-backend-peephole-trackable-mem-operand? [operand : String]) : bool
  (or
    (compiler-backend-peephole-stack-slot-operand? operand)
    (compiler-backend-peephole-global-rip-operand? operand)))

(define (compiler-backend-peephole-owner-key-unknown) : i64
  0)

(define (compiler-backend-peephole-owner-key-known? [key : i64]) : bool
  (not (= key 0)))

(define (compiler-backend-peephole-owner-key-stack? [key : i64]) : bool
  (> key 0))

(define (compiler-backend-peephole-owner-key-eq? [left : i64] [right : i64]) : bool
  (= left right))

(define compiler-backend-peephole-owner-global-capacity : i64
  16384)
(define compiler-backend-peephole-owner-global-bytes-capacity : i64
  1048576)
(define compiler-backend-peephole-owner-global-offsets : (Array i64)
  (array.make-array i64 16384))
(define compiler-backend-peephole-owner-global-lengths : (Array i64)
  (array.make-array i64 16384))
(define compiler-backend-peephole-owner-global-bytes : (Array u8)
  (array.make-array u8 1048576))
(define compiler-backend-peephole-owner-global-bytes-count : i64
  0)

(define (compiler-backend-peephole-owner-global-reset!) : unit
  (let
    [cap : i64 compiler-backend-peephole-owner-global-capacity]
    [i : i64 0]
    (begin
      (while (< i cap)
        (begin
          (array-set! compiler-backend-peephole-owner-global-offsets i -1)
          (set! i (+ i 1))))
      (set! compiler-backend-peephole-owner-global-bytes-count 0)
      unit)))

(define (compiler-backend-peephole-owner-global-bytes-eq?
  [off : i64]
  [len : i64]
  [data : (Ptr u8)]
  [data-start : i64]
  [klen : i64]) : bool
  (if (not (= len klen))
    false
    (let
      [j : i64 0]
      [ok : bool true]
      (begin
        (while (and ok (< j len))
          (begin
            (if (=
              (cast
                (array-ref
                  compiler-backend-peephole-owner-global-bytes
                  (+ off j))
                : i64)
              (compiler-backend-peephole-byte-at data (+ data-start j)))
              unit
              (set! ok false))
            (set! j (+ j 1))))
        ok))))

(define (compiler-backend-peephole-owner-global-key-range
  [operand : String]
  [data : (Ptr u8)]
  [operand-start : i64]
  [symbol-len : i64]) : i64
  (let
    [hash : i64 (intern-hash-slice operand operand-start symbol-len)]
    [cap : i64 compiler-backend-peephole-owner-global-capacity]
    [slot : i64 (bit-and hash (- cap 1))]
    [walked : i64 0]
    (begin
      (while (< walked cap)
        (let
          [off : i64
            (array-ref compiler-backend-peephole-owner-global-offsets slot)]
          (if (< off 0)
            (let
              [start : i64 compiler-backend-peephole-owner-global-bytes-count]
              (if (<=
                (+ start symbol-len)
                compiler-backend-peephole-owner-global-bytes-capacity)
                (let
                  [j : i64 0]
                  (begin
                    (while (< j symbol-len)
                      (begin
                        (array-set!
                          compiler-backend-peephole-owner-global-bytes
                          (+ start j)
                          (cast
                            (compiler-backend-peephole-byte-at
                              data
                              (+ operand-start j))
                            : u8))
                        (set! j (+ j 1))))
                    (array-set!
                      compiler-backend-peephole-owner-global-offsets
                      slot
                      start)
                    (array-set!
                      compiler-backend-peephole-owner-global-lengths
                      slot
                      symbol-len)
                    (set!
                      compiler-backend-peephole-owner-global-bytes-count
                      (+ start symbol-len))
                    (return (- 0 (+ slot 1)))))
                (return (compiler-backend-peephole-owner-key-unknown))))
            (if (compiler-backend-peephole-owner-global-bytes-eq?
              off
              (array-ref compiler-backend-peephole-owner-global-lengths slot)
              data
              operand-start
              symbol-len)
              (return (- 0 (+ slot 1)))
              (begin
                (set!
                  slot
                  (if (>= (+ slot 1) cap)
                    0
                    (+ slot 1)))
                (set! walked (+ walked 1)))))))
      (compiler-backend-peephole-owner-key-unknown))))

(define (compiler-backend-peephole-owner-global-key
  [operand : String]
  [symbol-len : i64]) : i64
  (compiler-backend-peephole-owner-global-key-range
    operand
    (unsafe
      (string-data operand))
    0
    symbol-len))

(define (compiler-backend-peephole-string-suffix-eq?
  [text : String]
  [suffix : String]) : bool
  (let
    [n : i64 (string.string-length text)]
    [sn : i64 (string.string-length suffix)]
    (if (< n sn)
      false
      (let
        [start : i64 (- n sn)]
        [i : i64 0]
        [ok : bool true]
        (begin
          (while (and ok (< i sn))
            (begin
              (if (=
                (string.string-ref text (+ start i))
                (string.string-ref suffix i))
                unit
                (set! ok false))
              (set! i (+ i 1))))
          ok)))))

(define (compiler-backend-peephole-decimal-prefix-valid?
  [text : String]
  [end : i64]) : bool
  (let
    [i : i64 0]
    [ok : bool true]
    (begin
      (if (<= end 0)
        (set! ok false)
        unit)
      (if (and ok (= (cast (string.string-ref text 0) : i64) 45))
        (begin
          (set! i 1)
          (if (= end 1)
            (set! ok false)
            unit))
        unit)
      (while (and ok (< i end))
        (let
          [b : i64 (cast (string.string-ref text i) : i64)]
          (begin
            (if (and (>= b 48) (<= b 57))
              unit
              (set! ok false))
            (set! i (+ i 1)))))
      ok)))

(define (compiler-backend-peephole-decimal-prefix-value
  [text : String]
  [end : i64]) : i64
  (let
    [neg : bool (and (> end 0) (= (cast (string.string-ref text 0) : i64) 45))]
    [i : i64
      (if neg
        1
        0)]
    [value : i64 0]
    (begin
      (while (< i end)
        (let
          [b : i64 (cast (string.string-ref text i) : i64)]
          (begin
            (set! value (+ (* value 10) (- b 48)))
            (set! i (+ i 1)))))
      (if neg
        (- 0 value)
        value))))

(define (compiler-backend-peephole-stack-owner-key-from-parts
  [base : i64]
  [offset : i64]
  [explicit : bool]) : i64
  (let
    [bias : i64 compiler-backend-peephole-owner-key-stack-bias]
    (if (or (< offset (- 0 bias)) (> offset bias))
      (compiler-backend-peephole-owner-key-unknown)
      (+
        1
        (+
          (* 4 (+ offset bias))
          (+
            (* base 2)
            (if explicit
              1
              0)))))))

(define (compiler-backend-peephole-stack-owner-key
  [operand : String]
  [suffix : String]
  [base : i64]) : i64
  (let
    [len : i64 (string.string-length operand)]
    [suffix-len : i64 (string.string-length suffix)]
    (if (not (compiler-backend-peephole-string-suffix-eq? operand suffix))
      (compiler-backend-peephole-owner-key-unknown)
      (let
        [prefix-len : i64 (- len suffix-len)]
        (cond
          [(= prefix-len 0)
            (compiler-backend-peephole-stack-owner-key-from-parts base 0 false)]
          [(compiler-backend-peephole-decimal-prefix-valid? operand prefix-len)
            (compiler-backend-peephole-stack-owner-key-from-parts
              base
              (compiler-backend-peephole-decimal-prefix-value
                operand
                prefix-len)
              true)]
          [else (compiler-backend-peephole-owner-key-unknown)])))))

(define (compiler-backend-peephole-owner-key-from-operand [operand : String]) : i64
  (let
    [rbp : i64 (compiler-backend-peephole-stack-owner-key operand "(%rbp)" 0)]
    (if (compiler-backend-peephole-owner-key-known? rbp)
      rbp
      (let
        [rsp : i64
          (compiler-backend-peephole-stack-owner-key operand "(%rsp)" 1)]
        (if (compiler-backend-peephole-owner-key-known? rsp)
          rsp
          (let
            [len : i64 (string.string-length operand)]
            [suffix-len : i64 6]
            (if (and
              (> len suffix-len)
              (compiler-backend-peephole-string-suffix-eq? operand "(%rip)"))
              (compiler-backend-peephole-owner-global-key
                operand
                (- len suffix-len))
              (compiler-backend-peephole-owner-key-unknown))))))))

;; Range forms used by the streaming descriptor path. They preserve operand
;; identity without allocating a substring for each side of every movq.
(define (compiler-backend-peephole-decimal-range-valid?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [i : i64 start]
    [ok : bool (< start end)]
    (begin
      (if (and ok (= (compiler-backend-peephole-byte-at data i) 45))
        (begin
          (set! i (+ i 1))
          (if (= i end)
            (set! ok false)
            unit))
        unit)
      (while (and ok (< i end))
        (let
          [b : i64 (compiler-backend-peephole-byte-at data i)]
          (begin
            (if (and (>= b 48) (<= b 57))
              unit
              (set! ok false))
            (set! i (+ i 1)))))
      ok)))

(define (compiler-backend-peephole-decimal-range-value
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [neg : bool (= (compiler-backend-peephole-byte-at data start) 45)]
    [i : i64
      (if neg
        (+ start 1)
        start)]
    [value : i64 0]
    (begin
      (while (< i end)
        (begin
          (set!
            value
            (+ (* value 10) (- (compiler-backend-peephole-byte-at data i) 48)))
          (set! i (+ i 1))))
      (if neg
        (- 0 value)
        value))))

(define compiler-backend-peephole-memory-base-none : i64
  0)
(define compiler-backend-peephole-memory-base-rbp : i64
  1)
(define compiler-backend-peephole-memory-base-rsp : i64
  2)
(define compiler-backend-peephole-memory-base-rip : i64
  3)
(define compiler-backend-peephole-memory-base-r10 : i64
  4)

;; Fixed memory bases emitted by the backend all have a six-byte suffix. Parse
;; that suffix once per movq operand, then share the compact result between
;; owner-key construction and the operand flags instead of independently
;; comparing or searching the same bytes for rbp, rsp, rip, and r10.
(define (compiler-backend-peephole-memory-base-range
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (if (< (- end start) 6)
    compiler-backend-peephole-memory-base-none
    (let
      [s : i64 (- end 6)]
      (if (and
        (= (compiler-backend-peephole-byte-at data s) 40)
        (= (compiler-backend-peephole-byte-at data (+ s 1)) 37)
        (= (compiler-backend-peephole-byte-at data (+ s 2)) 114)
        (= (compiler-backend-peephole-byte-at data (+ s 5)) 41))
        (let
          [b3 : i64 (compiler-backend-peephole-byte-at data (+ s 3))]
          [b4 : i64 (compiler-backend-peephole-byte-at data (+ s 4))]
          (if (= b4 112)
            (cond
              [(= b3 98) compiler-backend-peephole-memory-base-rbp]
              [(= b3 115) compiler-backend-peephole-memory-base-rsp]
              [(= b3 105) compiler-backend-peephole-memory-base-rip]
              [else compiler-backend-peephole-memory-base-none])
            (if (and (= b3 49) (= b4 48))
              compiler-backend-peephole-memory-base-r10
              compiler-backend-peephole-memory-base-none)))
        compiler-backend-peephole-memory-base-none))))

(define (compiler-backend-peephole-owner-key-from-range
  [operand : String]
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [memory-base : i64]) : i64
  (let
    [prefix-end : i64 (- end 6)]
    (cond
      [(or
          (= memory-base compiler-backend-peephole-memory-base-rbp)
          (= memory-base compiler-backend-peephole-memory-base-rsp))
        (let
          [base : i64
            (if (= memory-base compiler-backend-peephole-memory-base-rbp)
              0
              1)]
          (cond
            [(= prefix-end start)
              (compiler-backend-peephole-stack-owner-key-from-parts
                base
                0
                false)]
            [(compiler-backend-peephole-decimal-range-valid?
                data
                start
                prefix-end)
              (compiler-backend-peephole-stack-owner-key-from-parts
                base
                (compiler-backend-peephole-decimal-range-value
                  data
                  start
                  prefix-end)
                true)]
            [else (compiler-backend-peephole-owner-key-unknown)]))]
      [(and
          (= memory-base compiler-backend-peephole-memory-base-rip)
          (> prefix-end start))
        (compiler-backend-peephole-owner-global-key-range
          operand
          data
          start
          (- prefix-end start))]
      [else (compiler-backend-peephole-owner-key-unknown)])))

;; Local frame slots: every rsp-form slot (the rebased local frame; incoming
;; stack args stay on rbp in stage 1), plus the pre-rebase rbp spelling at
;; NEGATIVE offsets (needs-rbp functions), mirroring the historical exclusion
;; of the positive incoming-arg region.
(define (compiler-backend-peephole-local-frame-slot-operand? [operand : String]) : bool
  (or
    (compiler-backend-string-contains? operand "(%rsp)")
    (and
      (> (string.string-length operand) 0)
      (= (string.string-ref operand 0) '-')
      (compiler-backend-string-contains? operand "(%rbp)"))))

(define (compiler-backend-peephole-local-move-operand? [operand : String]) : bool
  (or
    (compiler-backend-peephole-register-operand? operand)
    (compiler-backend-peephole-stack-slot-operand? operand)))

(define (compiler-backend-peephole-self-move-operands?
  [src : String]
  [dst : String]) : bool
  (and (string.eq src dst) (compiler-backend-peephole-local-move-operand? src)))

(define (compiler-backend-peephole-redundant-move-operands?
  [src : String]
  [dst : String]
  [next-src : String]
  [next-dst : String]) : bool
  (and
    (compiler-backend-peephole-local-move-operand? src)
    (compiler-backend-peephole-local-move-operand? dst)
    (compiler-backend-peephole-local-move-operand? next-src)
    (compiler-backend-peephole-local-move-operand? next-dst)
    (or
      (and (string.eq src next-src) (string.eq dst next-dst))
      (and (string.eq src next-dst) (string.eq dst next-src)))))

(define (compiler-backend-peephole-overwritten-frame-store-operands?
  [src : String]
  [dst : String]
  [next-src : String]
  [next-dst : String]) : bool
  (and
    (compiler-backend-peephole-register-operand? src)
    (compiler-backend-peephole-local-frame-slot-operand? dst)
    (compiler-backend-peephole-register-operand? next-src)
    (compiler-backend-peephole-local-frame-slot-operand? next-dst)
    (string.eq dst next-dst)))

(define (compiler-backend-peephole-forward-frame-load-operands?
  [src : String]
  [dst : String]
  [next-src : String]
  [next-dst : String]) : bool
  (and
    (compiler-backend-peephole-register-operand? src)
    (compiler-backend-peephole-local-frame-slot-operand? dst)
    (compiler-backend-peephole-local-frame-slot-operand? next-src)
    (compiler-backend-peephole-register-operand? next-dst)
    (string.eq dst next-src)))

(define (compiler-backend-peephole-forward-frame-load-line
  [pending : String]
  [next : String]) : String
  (match (compiler-backend-peephole-movq pending)
    [(CompilerBackendPeepholeMove.Move src dst)
      (match (compiler-backend-peephole-movq next)
        [(CompilerBackendPeepholeMove.Move next-src next-dst)
          (if (compiler-backend-peephole-forward-frame-load-operands?
            src
            dst
            next-src
            next-dst)
            (str_cat.str-cat "    movq " src ", " next-dst)
            next)]
        [(CompilerBackendPeepholeMove.NoMove) next])]
    [(CompilerBackendPeepholeMove.NoMove) next]))

;; ---- Fold `movq SRC,%r10 ; movq DISP(%r10),DST` -> `movq DISP(SRC),DST` ----
;; SRC must be a register (not %r10); the deref source must be a base-only %r10
;; memory operand DISP(%r10) (no index). Sound iff %r10 is dead after the deref:
;; either DST==%r10 (the staged value is immediately overwritten by the load), or
;; the forward scan proves %r10's next textual touch is a clean re-write with only
;; non-%r10 movq lines in between (conservative: any non-movq / control flow stops
;; the scan as "not provably dead").
(define (compiler-backend-peephole-mem-base-r10? [operand : String]) : bool
  (let
    [len : i64 (string.string-length operand)]
    (and (>= len 6) (string.eq (string.substring operand (- len 6) 6) "(%r10)"))))

(define (compiler-backend-peephole-r10-base-rewrite
  [operand : String]
  [base : String]) : String
  (let
    [len : i64 (string.string-length operand)]
    (str_cat.str-cat (string.substring operand 0 (- len 6)) "(" base ")")))

(define (compiler-backend-peephole-r10-base-fold-operands?
  [src : String]
  [dst : String]
  [next-src : String]
  [next-dst : String]) : bool
  (and
    (compiler-backend-peephole-register-operand? src)
    (not (string.eq src "%r10"))
    ;; #rbp-base (M-G3 stage 2): never fold a %rbp base into a memory operand.
    ;; In FPO functions %rbp is a pool value register and the emitters stage
    ;; rbp-based derefs through a scratch precisely so that "(%rbp" only ever
    ;; spells a frame reference; folding would recreate `DISP(%rbp)` which the
    ;; slot recognizers above treat as a frame slot (rbp-write invalidation is
    ;; not modeled for slot keys).
    (not (string.eq src "%rbp"))
    (string.eq dst "%r10")
    (compiler-backend-peephole-mem-base-r10? next-src)
    (compiler-backend-peephole-register-operand? next-dst)))

(define (compiler-backend-peephole-range-mentions-r10?
  [asm : String]
  [start : i64]
  [end : i64]) : bool
  (if (>= start end)
    false
    (compiler-backend-peephole-range-mentions-r10-data?
      (unsafe
        (string-data asm))
      start
      end)))

(define (compiler-backend-peephole-line-clean-writes-r10?
  [asm : String]
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (match (compiler-backend-peephole-movq-range asm asm-data start end)
    [(CompilerBackendPeepholeMove.Move src dst)
      (and
        (string.eq dst "%r10")
        (not (compiler-backend-string-contains? src "%r10")))]
    [(CompilerBackendPeepholeMove.NoMove) false]))

;; Is %r10 dead after `start`? Conservative movq-only scan: the first line that
;; touches %r10 must be a clean write; the scan passes only over non-%r10 movq
;; lines; any other line (ALU / call / jmp / label / ret / directive) stops the
;; scan as "not provably dead". Returns true only on a definite clean re-write.
(define compiler-backend-peephole-r10-dead-scan-line-cap : i64
  128)

(define (compiler-backend-peephole-r10-dead-after?
  [asm : String]
  [asm-data : (Ptr u8)]
  [start : i64]
  [n : i64]) : bool
  (let
    [i : i64 start]
    [k : i64 0]
    [result : i64 -1]
    (begin
      (while (and
        (< i n)
        (< result 0)
        (< k compiler-backend-peephole-r10-dead-scan-line-cap))
        (let
          [end : i64 (compiler-backend-peephole-line-end asm-data i n)]
          (begin
            (if (compiler-backend-peephole-range-mentions-r10? asm i end)
              (if (compiler-backend-peephole-line-clean-writes-r10?
                asm
                asm-data
                i
                end)
                (set! result 1)
                (set! result 0))
              (if (compiler-backend-peephole-movq-prefix-at-range?
                asm-data
                i
                end)
                unit
                (set! result 0)))
            (set!
              i
              (if (< end n)
                (+ end 1)
                end))
            (set! k (+ k 1)))))
      (if (and (< result 0) (< i n))
        (set!
          compiler-backend-peephole-r10-dead-scan-cap-hits
          (+ compiler-backend-peephole-r10-dead-scan-cap-hits 1))
        unit)
      (= result 1))))

(define (compiler-backend-peephole-r10-base-fold-line-range
  [asm : String]
  [asm-data : (Ptr u8)]
  [pending-start : i64]
  [pending-end : i64]
  [pending-line : String]
  [pending-owned? : bool]
  [next-start : i64]
  [next-end : i64]) : String
  (match (compiler-backend-peephole-line-movq
    asm
    asm-data
    pending-start
    pending-end
    pending-line
    pending-owned?)
    [(CompilerBackendPeepholeMove.Move src dst)
      (match (compiler-backend-peephole-movq-range
        asm
        asm-data
        next-start
        next-end)
        [(CompilerBackendPeepholeMove.Move next-src next-dst)
          (str_cat.str-cat
            "    movq "
            (compiler-backend-peephole-r10-base-rewrite next-src src)
            ", "
            next-dst)]
        [(CompilerBackendPeepholeMove.NoMove)
          (string.substring asm next-start (- next-end next-start))])]
    [(CompilerBackendPeepholeMove.NoMove)
      (string.substring asm next-start (- next-end next-start))]))

(define (compiler-backend-peephole-line-self-move?
  [asm : String]
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [owned-line : String]
  [owned? : bool]) : bool
  (match (compiler-backend-peephole-line-movq
    asm
    asm-data
    start
    end
    owned-line
    owned?)
    [(CompilerBackendPeepholeMove.Move src dst)
      (compiler-backend-peephole-self-move-operands? src dst)]
    [(CompilerBackendPeepholeMove.NoMove) false]))

;; Zext dedup: the 64-bit destination register of a `movzbq`/`movzbl` line over
;; [start,end), or "" when the line is not a byte zero-extend into a tracked GP
;; register. Both forms leave the full 64-bit destination holding a value in
;; [0,255] (32-bit writes zero the upper half), so a following
;; `movzbq %<dst-low-byte>, %<dst>` re-extend is an identity.
(define (compiler-backend-peephole-zext-line-dst
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : String
  (let
    [ms : i64 start]
    (begin
      (while (and (< ms end) (= (compiler-backend-peephole-byte-at data ms) 32))
        (set! ms (+ ms 1)))
      (let
        [me : i64 ms]
        (begin
          (while (and
            (< me end)
            (let
              [b : i64 (compiler-backend-peephole-byte-at data me)]
              (and (>= b 97) (<= b 122))))
            (set! me (+ me 1)))
          (if (or
            (compiler-backend-peephole-range-eq? data ms me "movzbq")
            (compiler-backend-peephole-range-eq? data ms me "movzbl"))
            (compiler-backend-peephole-last-operand-reg data ms end)
            ""))))))

;; True when the line [ns,ne) is exactly `movzbq %B, R` with %B the low-byte
;; sub-register of R. Paired with a pending byte zero-extend into R, this
;; re-extend is an identity and is dropped (pair-action 2). The source token
;; must be a byte register ('l'/'b' suffix); 16/32-bit sub-register tokens and
;; memory operands never match.
(define (compiler-backend-peephole-redundant-zext-next?
  [data : (Ptr u8)]
  [ns : i64]
  [ne : i64]
  [reg : String]) : bool
  (let
    [ms : i64 ns]
    (begin
      (while (and (< ms ne) (= (compiler-backend-peephole-byte-at data ms) 32))
        (set! ms (+ ms 1)))
      (let
        [me : i64 ms]
        (begin
          (while (and
            (< me ne)
            (let
              [b : i64 (compiler-backend-peephole-byte-at data me)]
              (and (>= b 97) (<= b 122))))
            (set! me (+ me 1)))
          (if (not (compiler-backend-peephole-range-eq? data ms me "movzbq"))
            false
            (let
              [ts : i64 me]
              (begin
                (while (and
                  (< ts ne)
                  (= (compiler-backend-peephole-byte-at data ts) 32))
                  (set! ts (+ ts 1)))
                (let
                  [te : i64 ts]
                  (begin
                    (while (and
                      (< te ne)
                      (let
                        [b : i64 (compiler-backend-peephole-byte-at data te)]
                        (or
                          (= b 37)
                          (and (>= b 97) (<= b 122))
                          (and (>= b 48) (<= b 57)))))
                      (set! te (+ te 1)))
                    (if (or
                      (= ts te)
                      (not (= (compiler-backend-peephole-byte-at data ts) 37)))
                      false
                      (let
                        [last : i64
                          (compiler-backend-peephole-byte-at data (- te 1))]
                        (if (not (or (= last 108) (= last 98)))
                          false
                          (and
                            (string.eq
                              (compiler-backend-peephole-subreg-to-reg
                                data
                                ts
                                te)
                              reg)
                            (string.eq
                              (compiler-backend-peephole-last-operand-reg
                                data
                                ms
                                ne)
                              reg)))))))))))))))

;; True when pending is a byte zero-extend into register R and next is the
;; identity re-extend `movzbq %<R-low-byte>, R`.
(define (compiler-backend-peephole-redundant-zext-pair?
  [asm-data : (Ptr u8)]
  [pending-start : i64]
  [pending-end : i64]
  [pending-line : String]
  [pending-owned? : bool]
  [next-start : i64]
  [next-end : i64]) : bool
  (let
    [dst : String
      (if pending-owned?
        (let
          [pdata : (Ptr u8)
            (unsafe
              (string-data pending-line))]
          (compiler-backend-peephole-zext-line-dst
            pdata
            0
            (string.string-length pending-line)))
        (compiler-backend-peephole-zext-line-dst
          asm-data
          pending-start
          pending-end))]
    (if (string.eq dst "")
      false
      (compiler-backend-peephole-redundant-zext-next?
        asm-data
        next-start
        next-end
        dst))))

(define (compiler-backend-peephole-pair-action-range
  [asm : String]
  [asm-data : (Ptr u8)]
  [pending-start : i64]
  [pending-end : i64]
  [pending-line : String]
  [pending-owned? : bool]
  [next-start : i64]
  [next-end : i64]) : i64
  (if (compiler-backend-peephole-redundant-zext-pair?
    asm-data
    pending-start
    pending-end
    pending-line
    pending-owned?
    next-start
    next-end)
    2
    (compiler-backend-peephole-pair-action-range-movq
      asm
      asm-data
      pending-start
      pending-end
      pending-line
      pending-owned?
      next-start
      next-end)))

(define (compiler-backend-peephole-pair-action-range-movq
  [asm : String]
  [asm-data : (Ptr u8)]
  [pending-start : i64]
  [pending-end : i64]
  [pending-line : String]
  [pending-owned? : bool]
  [next-start : i64]
  [next-end : i64]) : i64
  (match (compiler-backend-peephole-line-movq
    asm
    asm-data
    pending-start
    pending-end
    pending-line
    pending-owned?)
    [(CompilerBackendPeepholeMove.Move src dst)
      (if (compiler-backend-peephole-self-move-operands? src dst)
        1
        (match (compiler-backend-peephole-movq-range
          asm
          asm-data
          next-start
          next-end)
          [(CompilerBackendPeepholeMove.Move next-src next-dst)
            (cond
              [(compiler-backend-peephole-overwritten-frame-store-operands?
                  src
                  dst
                  next-src
                  next-dst)
                1]
              [(compiler-backend-peephole-redundant-move-operands?
                  src
                  dst
                  next-src
                  next-dst)
                2]
              [(compiler-backend-peephole-forward-frame-load-operands?
                  src
                  dst
                  next-src
                  next-dst)
                3]
              [(and
                  (compiler-backend-peephole-r10-base-fold-operands?
                    src
                    dst
                    next-src
                    next-dst)
                  (or
                    (string.eq next-dst "%r10")
                    (compiler-backend-peephole-r10-dead-after?
                      asm
                      asm-data
                      (if (< next-end (string.string-length asm))
                        (+ next-end 1)
                        next-end)
                      (string.string-length asm))))
                4]
              [else 0])]
          [(CompilerBackendPeepholeMove.NoMove) 0]))]
    [(CompilerBackendPeepholeMove.NoMove) 0]))

(define (compiler-backend-peephole-forward-frame-load-line-range
  [asm : String]
  [asm-data : (Ptr u8)]
  [pending-start : i64]
  [pending-end : i64]
  [pending-line : String]
  [pending-owned? : bool]
  [next-start : i64]
  [next-end : i64]) : String
  (match (compiler-backend-peephole-line-movq
    asm
    asm-data
    pending-start
    pending-end
    pending-line
    pending-owned?)
    [(CompilerBackendPeepholeMove.Move src dst)
      (match (compiler-backend-peephole-movq-range
        asm
        asm-data
        next-start
        next-end)
        [(CompilerBackendPeepholeMove.Move next-src next-dst)
          (if (compiler-backend-peephole-forward-frame-load-operands?
            src
            dst
            next-src
            next-dst)
            (str_cat.str-cat "    movq " src ", " next-dst)
            (string.substring asm next-start (- next-end next-start)))]
        [(CompilerBackendPeepholeMove.NoMove)
          (string.substring asm next-start (- next-end next-start))])]
    [(CompilerBackendPeepholeMove.NoMove)
      (string.substring asm next-start (- next-end next-start))]))

;; All-unknown owner map: every tracked register mirrors no known location.
(define (compiler-backend-peephole-owners-empty) : CompilerBackendPeepholeOwners
  (CompilerBackendPeepholeOwners
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)))

;; Dense index 0..13 for the 14 general-purpose registers owned by the register
;; allocator, or -1 for anything else (immediates, stack slots, %rbp/%rsp/%rip,
;; xmm/untracked registers). Register operands are a fixed tiny set, so classify
;; them by their bytes in a single pass instead of up to 14 sequential
;; `string.eq` calls: this is the hot dispatch behind the peephole owner map and
;; the byte scan short-circuits the overwhelmingly common non-register operand on
;; the first one or two bytes. The mapping is exact (same accept set, same
;; ordering as the string-compare chains it replaces), so owner-map decisions --
;; and therefore emitted assembly -- stay byte-identical.
(define (compiler-backend-peephole-reg-index-range
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [n : i64 (- end start)]
    (if (or (< n 3) (> n 4))
      -1
      (let
        [b0 : i64 (compiler-backend-peephole-byte-at data start)]
        [b1 : i64 (compiler-backend-peephole-byte-at data (+ start 1))]
        [b2 : i64 (compiler-backend-peephole-byte-at data (+ start 2))]
        (if (or (not (= b0 37)) (not (= b1 114)))
          -1
          (if (= n 3)
            (cond [(= b2 56) 6] [(= b2 57) 7] [else -1])
            (let
              [b3 : i64 (compiler-backend-peephole-byte-at data (+ start 3))]
              (cond
                [(= b2 97)
                  (if (= b3 120)
                    0
                    -1)]
                [(= b2 99)
                  (if (= b3 120)
                    1
                    -1)]
                [(= b2 100) (cond [(= b3 120) 2] [(= b3 105) 5] [else -1])]
                [(= b2 98)
                  (if (= b3 120)
                    3
                    -1)]
                [(= b2 115)
                  (if (= b3 105)
                    4
                    -1)]
                [(= b2 49)
                  (cond
                    [(= b3 48) 8]
                    [(= b3 49) 9]
                    [(= b3 50) 10]
                    [(= b3 51) 11]
                    [(= b3 52) 12]
                    [(= b3 53) 13]
                    [else -1])]
                [else -1]))))))))

(define (compiler-backend-peephole-reg-index [reg : String]) : i64
  (let
    [n : i64 (string.string-length reg)]
    (if (if (< n 3)
      true
      (> n 4))
      -1
      (let
        [data : (Ptr u8)
          (unsafe
            (string-data reg))]
        [b0 : i64 (compiler-backend-peephole-byte-at data 0)]
        [b1 : i64 (compiler-backend-peephole-byte-at data 1)]
        [b2 : i64 (compiler-backend-peephole-byte-at data 2)]
        ;; every tracked register is "%r..": bail on the first mismatched byte.
        (if (if (not (= b0 37))
          true
          (not (= b1 114)))
          -1
          (if (= n 3)
            ;; "%r8" / "%r9"
            (cond [(= b2 56) 6] [(= b2 57) 7] [else -1])
            ;; n == 4: third byte selects the register family, fourth disambiguates.
            (let
              [b3 : i64 (compiler-backend-peephole-byte-at data 3)]
              (cond
                [(= b2 97)
                  (if (= b3 120)
                    0
                    -1)]
                [(= b2 99)
                  (if (= b3 120)
                    1
                    -1)]
                [(= b2 100) (cond [(= b3 120) 2] [(= b3 105) 5] [else -1])]
                [(= b2 98)
                  (if (= b3 120)
                    3
                    -1)]
                [(= b2 115)
                  (if (= b3 105)
                    4
                    -1)]
                [(= b2 49)
                  (cond
                    [(= b3 48) 8]
                    [(= b3 49) 9]
                    [(= b3 50) 10]
                    [(= b3 51) 11]
                    [(= b3 52) 12]
                    [(= b3 53) 13]
                    [else -1])]
                [else -1]))))))))

;; True iff `operand` is exactly one of the 14 general-purpose registers owned
;; by the register allocator. %rbp and %rsp are deliberately excluded.
(define (compiler-backend-peephole-owner-reg? [operand : String]) : bool
  (>= (compiler-backend-peephole-reg-index operand) 0))

;; Location currently mirrored by `reg`, or Unknown if unknown / `reg` is not tracked.
(define (compiler-backend-peephole-owners-get-index
  [owners : CompilerBackendPeepholeOwners]
  [idx : i64]) : i64
  (cond
    [(= idx 0) (struct-get owners rax)]
    [(= idx 1) (struct-get owners rcx)]
    [(= idx 2) (struct-get owners rdx)]
    [(= idx 3) (struct-get owners rbx)]
    [(= idx 4) (struct-get owners rsi)]
    [(= idx 5) (struct-get owners rdi)]
    [(= idx 6) (struct-get owners r8)]
    [(= idx 7) (struct-get owners r9)]
    [(= idx 8) (struct-get owners r10)]
    [(= idx 9) (struct-get owners r11)]
    [(= idx 10) (struct-get owners r12)]
    [(= idx 11) (struct-get owners r13)]
    [(= idx 12) (struct-get owners r14)]
    [(= idx 13) (struct-get owners r15)]
    [else (compiler-backend-peephole-owner-key-unknown)]))

(define (compiler-backend-peephole-owners-get
  [owners : CompilerBackendPeepholeOwners]
  [reg : String]) : i64
  (compiler-backend-peephole-owners-get-index
    owners
    (compiler-backend-peephole-reg-index reg)))

;; The first tracked GP register whose mirrored location equals `slot`, other than
;; `exclude`, or "" if none. Drives cross-register reload reuse: a redundant
;; `movq SLOT, exclude` becomes `movq <found>, exclude` (reg-reg, cheaper) when
;; another register already holds SLOT's value. The per-location owner-clear
;; invariant guarantees `found` still holds SLOT (not written since it loaded it,
;; and SLOT not written since -- a location write clears every mirror). Unknown
;; matches nothing (a reg with unknown owner must never be "reused").
(define (compiler-backend-peephole-owners-find-reg-for-slot-index
  [owners : CompilerBackendPeepholeOwners]
  [slot : i64]
  [exclude : i64]) : String
  (if (not (compiler-backend-peephole-owner-key-known? slot))
    ""
    (let
      [ex : i64 exclude]
      (cond
        [(and
            (not (= ex 0))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rax)
              slot))
          "%rax"]
        [(and
            (not (= ex 1))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rcx)
              slot))
          "%rcx"]
        [(and
            (not (= ex 2))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rdx)
              slot))
          "%rdx"]
        [(and
            (not (= ex 3))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rbx)
              slot))
          "%rbx"]
        [(and
            (not (= ex 4))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rsi)
              slot))
          "%rsi"]
        [(and
            (not (= ex 5))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners rdi)
              slot))
          "%rdi"]
        [(and
            (not (= ex 6))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r8)
              slot))
          "%r8"]
        [(and
            (not (= ex 7))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r9)
              slot))
          "%r9"]
        [(and
            (not (= ex 8))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r10)
              slot))
          "%r10"]
        [(and
            (not (= ex 9))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r11)
              slot))
          "%r11"]
        [(and
            (not (= ex 10))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r12)
              slot))
          "%r12"]
        [(and
            (not (= ex 11))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r13)
              slot))
          "%r13"]
        [(and
            (not (= ex 12))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r14)
              slot))
          "%r14"]
        [(and
            (not (= ex 13))
            (compiler-backend-peephole-owner-key-eq?
              (struct-get owners r15)
              slot))
          "%r15"]
        [else ""]))))

(define (compiler-backend-peephole-owners-find-reg-for-slot
  [owners : CompilerBackendPeepholeOwners]
  [slot : i64]
  [exclude : String]) : String
  (compiler-backend-peephole-owners-find-reg-for-slot-index
    owners
    slot
    (compiler-backend-peephole-reg-index exclude)))

;; Owner map with `reg`'s owner set to `slot` (Unknown clears it). No-op when `reg`
;; is not a tracked register (e.g. an immediate or untracked register source).
(define (compiler-backend-peephole-owners-set-reg-index
  [owners : CompilerBackendPeepholeOwners]
  [idx : i64]
  [slot : i64]) : CompilerBackendPeepholeOwners
  (CompilerBackendPeepholeOwners
    (if (= idx 0)
      slot
      (struct-get owners rax))
    (if (= idx 1)
      slot
      (struct-get owners rcx))
    (if (= idx 2)
      slot
      (struct-get owners rdx))
    (if (= idx 3)
      slot
      (struct-get owners rbx))
    (if (= idx 4)
      slot
      (struct-get owners rsi))
    (if (= idx 5)
      slot
      (struct-get owners rdi))
    (if (= idx 6)
      slot
      (struct-get owners r8))
    (if (= idx 7)
      slot
      (struct-get owners r9))
    (if (= idx 8)
      slot
      (struct-get owners r10))
    (if (= idx 9)
      slot
      (struct-get owners r11))
    (if (= idx 10)
      slot
      (struct-get owners r12))
    (if (= idx 11)
      slot
      (struct-get owners r13))
    (if (= idx 12)
      slot
      (struct-get owners r14))
    (if (= idx 13)
      slot
      (struct-get owners r15))))

(define (compiler-backend-peephole-owners-set-reg
  [owners : CompilerBackendPeepholeOwners]
  [reg : String]
  [slot : i64]) : CompilerBackendPeepholeOwners
  (compiler-backend-peephole-owners-set-reg-index
    owners
    (compiler-backend-peephole-reg-index reg)
    slot))

;; Owner map with every register that mirrored `slot` reset to unknown. Used
;; when `slot` is written (its memory value changed) so stale mirrors are dropped.
(define (compiler-backend-peephole-owners-clear-slot
  [owners : CompilerBackendPeepholeOwners]
  [slot : i64]) : CompilerBackendPeepholeOwners
  (CompilerBackendPeepholeOwners
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rax) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rax))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rcx) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rcx))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rdx) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rdx))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rbx) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rbx))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rsi) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rsi))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners rdi) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners rdi))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r8) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r8))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r9) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r9))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r10) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r10))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r11) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r11))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r12) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r12))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r13) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r13))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r14) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r14))
    (if (compiler-backend-peephole-owner-key-eq? (struct-get owners r15) slot)
      (compiler-backend-peephole-owner-key-unknown)
      (struct-get owners r15))))

;; Owner key that can survive a normal call. Calls may mutate globals, so a
;; callee-saved register keeps only stack-slot ownership across the boundary.
(define (compiler-backend-peephole-call-preserved-owner [owner : i64]) : i64
  (if (compiler-backend-peephole-owner-key-stack? owner)
    owner
    (compiler-backend-peephole-owner-key-unknown)))

;; Owner map after a normal call returns. Preserve only stack-slot owners in the
;; tracked registers whose values are guaranteed across both SysV and Win64
;; calls; Win64 also preserves %rsi/%rdi, but SysV does not, and %rbp is
;; intentionally untracked.
(define (compiler-backend-peephole-owners-clear-call-clobbers
  [owners : CompilerBackendPeepholeOwners]) : CompilerBackendPeepholeOwners
  (CompilerBackendPeepholeOwners
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-call-preserved-owner (struct-get owners rbx))
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-owner-key-unknown)
    (compiler-backend-peephole-call-preserved-owner (struct-get owners r12))
    (compiler-backend-peephole-call-preserved-owner (struct-get owners r13))
    (compiler-backend-peephole-call-preserved-owner (struct-get owners r14))
    (compiler-backend-peephole-call-preserved-owner (struct-get owners r15))))

;; Owner-map transfer for a recognized `movq SRC, DST` line.
;;  * DST is a clean stack slot (a store): SRC's value is written to
;;    the slot. Every OTHER register that mirrored the slot becomes stale and is
;;    dropped (`owners-clear-slot`, which also drops SRC's entry when it happened
;;    to mirror this slot). SRC's value itself is unchanged, so any slot SRC
;;    already mirrors is preserved; only when SRC is a tracked register with no
;;    known location do we record that it now mirrors DST (a sound store-to-reload
;;    forward). Preserving an existing SRC owner is required: it keeps reloads of
;;    a *different* slot still resident in SRC eligible for elision.
;;  * DST is a tracked GP register (a load or reg-reg move): DST is overwritten,
;;    so it mirrors SRC when SRC is a known stack/global key, otherwise becomes unknown.
;;  * anything else for DST (%rbp/%rsp, an xmm/untracked register, or any memory
;;    operand that is not a clean stack slot -- indexed, pointer, rip-relative,
;;    or segment relative) may change the frame base or alias an unknown slot, so
;;    conservatively clear the whole map.
(define (compiler-backend-peephole-movq-owners-transfer-keyed-index
  [owners : CompilerBackendPeepholeOwners]
  [src-reg : i64]
  [dst-reg : i64]
  [src-key : i64]
  [dst-key : i64]) : CompilerBackendPeepholeOwners
  (cond
    [(compiler-backend-peephole-owner-key-stack? dst-key)
      (let
        [cleared : CompilerBackendPeepholeOwners
          (compiler-backend-peephole-owners-clear-slot owners dst-key)]
        (if (and
          (>= src-reg 0)
          (not
            (compiler-backend-peephole-owner-key-known?
              (compiler-backend-peephole-owners-get-index cleared src-reg))))
          (compiler-backend-peephole-owners-set-reg-index
            cleared
            src-reg
            dst-key)
          cleared))]
    [(>= dst-reg 0)
      ;; DST is a load/reg-reg dest: it mirrors a clean stack slot OR a SYM(%rip)
      ;; global load (SCAV2); otherwise its contents become unknown.
      (compiler-backend-peephole-owners-set-reg-index owners dst-reg src-key)]
    [else (compiler-backend-peephole-owners-empty)]))

(define (compiler-backend-peephole-movq-owners-transfer-keyed
  [owners : CompilerBackendPeepholeOwners]
  [src : String]
  [dst : String]
  [src-key : i64]
  [dst-key : i64]) : CompilerBackendPeepholeOwners
  (compiler-backend-peephole-movq-owners-transfer-keyed-index
    owners
    (compiler-backend-peephole-reg-index src)
    (compiler-backend-peephole-reg-index dst)
    src-key
    dst-key))

(define (compiler-backend-peephole-movq-owners-transfer
  [owners : CompilerBackendPeepholeOwners]
  [src : String]
  [dst : String]) : CompilerBackendPeepholeOwners
  (compiler-backend-peephole-movq-owners-transfer-keyed
    owners
    src
    dst
    (compiler-backend-peephole-owner-key-from-operand src)
    (compiler-backend-peephole-owner-key-from-operand dst)))

;; Length of the leading non-space token (the mnemonic) starting at `i`.
(define (compiler-backend-peephole-token-len
  [data : (Ptr u8)]
  [i : i64]
  [end : i64]) : i64
  (let
    [j : i64 i]
    (begin
      (while (and
        (< j end)
        (not (= (compiler-backend-peephole-byte-at data j) 32)))
        (set! j (+ j 1)))
      (- j i))))

;; True iff byte `b` is a movq-style size suffix: q, l, w, or b.
(define (compiler-backend-peephole-size-suffix-byte? [b : i64]) : bool
  (or (= b 113) (= b 108) (= b 119) (= b 98)))

;; True iff the mnemonic token at `i` is exactly a cmp/test compare (cmp, cmpq,
;; cmpl, cmpw, cmpb, test, testq, testl, testw, testb). These write only the
;; flags, never a GP register or memory, so they need no owner invalidation.
;; cmpxchg, cmps, and similar (which DO write registers/memory) are excluded by
;; the strict token-length / suffix check.
(define (compiler-backend-peephole-cmp-or-test-token?
  [data : (Ptr u8)]
  [i : i64]
  [tlen : i64]) : bool
  (or
    (and
      (>= tlen 3)
      (= (compiler-backend-peephole-byte-at data i) 99)
      (= (compiler-backend-peephole-byte-at data (+ i 1)) 109)
      (= (compiler-backend-peephole-byte-at data (+ i 2)) 112)
      (or
        (= tlen 3)
        (and
          (= tlen 4)
          (compiler-backend-peephole-size-suffix-byte?
            (compiler-backend-peephole-byte-at data (+ i 3))))))
    (and
      (>= tlen 4)
      (= (compiler-backend-peephole-byte-at data i) 116)
      (= (compiler-backend-peephole-byte-at data (+ i 1)) 101)
      (= (compiler-backend-peephole-byte-at data (+ i 2)) 115)
      (= (compiler-backend-peephole-byte-at data (+ i 3)) 116)
      (or
        (= tlen 4)
        (and
          (= tlen 5)
          (compiler-backend-peephole-size-suffix-byte?
            (compiler-backend-peephole-byte-at data (+ i 4))))))))

(define (compiler-backend-peephole-cmp-or-test?
  [data : (Ptr u8)]
  [i : i64]
  [end : i64]) : bool
  (compiler-backend-peephole-cmp-or-test-token?
    data
    i
    (compiler-backend-peephole-token-len data i end)))

;; SCAV2: true iff line [start,end) is `call <F>` where F is a runtime NORETURN
;; abort helper (tl_oob_abort / tl_shift_abort / tl_div_abort / tl_region_abort /
;; tl_oom_abort). A noreturn call never returns, so the textual fall-through into
;; the next line is DEAD: the owner map is carried unchanged across it, so the
;; guard-ok continuation label immediately after it (reached ONLY via the guard's
;; own conditional jump, across which the register map is identical) sees the
;; live map from the guard test -- see line-clobber-owners' label arm.
(define (compiler-backend-peephole-line-noreturn-abort?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [i : i64 start]
    (begin
      (while (and (< i end) (= (compiler-backend-peephole-byte-at data i) 32))
        (set! i (+ i 1)))
      (let
        [e : i64 end]
        (begin
          (while (and
            (> e i)
            (= (compiler-backend-peephole-byte-at data (- e 1)) 32))
            (set! e (- e 1)))
          (or
            (compiler-backend-peephole-range-eq? data i e "call tl_oob_abort")
            (compiler-backend-peephole-range-eq? data i e "call tl_shift_abort")
            (compiler-backend-peephole-range-eq? data i e "call tl_div_abort")
            (compiler-backend-peephole-range-eq?
              data
              i
              e
              "call tl_region_abort")
            (compiler-backend-peephole-range-eq? data i e "call tl_oom_abort")))))))

;; True iff the byte range [start,end) of `data` contains `needle` as a substring.
(define (compiler-backend-peephole-range-contains-substr?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [needle : String]) : bool
  (let
    [nlen : i64 (string.string-length needle)]
    [nd : (Ptr u8)
      (unsafe
        (string-data needle))]
    [i : i64 start]
    [found : bool false]
    (begin
      (while (and (not found) (<= (+ i nlen) end))
        (let
          [k : i64 0]
          [ok : bool true]
          (begin
            (while (and ok (< k nlen))
              (begin
                (if (=
                  (compiler-backend-peephole-byte-at data (+ i k))
                  (compiler-backend-peephole-byte-at nd k))
                  unit
                  (set! ok false))
                (set! k (+ k 1))))
            (if ok
              (set! found true)
              (set! i (+ i 1))))))
      found)))

;; SCAV2: true iff label line [start,end) is a guard-check CONTINUATION label --
;; its name contains "_ok" (`..._bounds_ok.N`, `..._str_bounds_ok.N`,
;; `..._make_array_len_ok.N`, ...) and does NOT contain "_fail". Such labels are
;; backend-emitted per guard and targeted ONLY by that guard's own conditional
;; jump (single live predecessor), so when the map was carried across a preceding
;; noreturn abort it is valid here. Excluding any "_fail" is essential: inlined
;; compound labels like `..._make_array_len_ok.2.8.array_push_fail.4:` are FAIL
;; handlers (last component wins) that happen to carry an "_ok" inline-context
;; prefix; carrying across them would be unsound. Numeric `1:` labels lack "_ok".
;; Only consulted when prev-abort? holds.
(define (compiler-backend-peephole-label-guard-ok?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (and
    (compiler-backend-peephole-range-contains-substr? data start end "_ok")
    (not
      (compiler-backend-peephole-range-contains-substr? data start end "_fail"))))

;; Owner-map transfer for a non-movq line (everything `line-movq` does not parse
;; as a clean two-operand movq). `line-clears-owners?` returns true when the line
;; needs conservative owner invalidation. The line is classified from its raw
;; bytes:
;;  * blank / whitespace-only -> no effect.
;;  * a label (ends in ':') -> a control-flow merge target; arbitrary predecessors
;;    can reach it with different register contents -> clear all.
;;  * an assembler directive (first non-space byte '.') -> no register/memory
;;    effect -> no clear.
;;  * a jump ('j...': jmp/jcc/jrcxz/jecxz) -> writes no register; the fall-through
;;    keeps the current state and every branch target is itself a label that
;;    clears -> no clear.
;;  * cmp / test -> flags only -> no clear.
;;  * everything else (call, ret, leave, syscall, every arithmetic/vector op, any
;;    store through a pointer/index/segment, and any unrecognized mnemonic) may
;;    write a GP register or alias a frame slot -> invalidate conservatively.
(define (compiler-backend-peephole-line-clears-owners?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [i : i64 start]
    (begin
      (while (and (< i end) (= (compiler-backend-peephole-byte-at data i) 32))
        (set! i (+ i 1)))
      (cond
        [(>= i end) false]
        [(= (compiler-backend-peephole-byte-at data (- end 1)) 58) true]
        [(= (compiler-backend-peephole-byte-at data i) 46) false]
        [(= (compiler-backend-peephole-byte-at data i) 106) false]
        [(compiler-backend-peephole-cmp-or-test? data i end) false]
        [else true]))))

;; True iff the mnemonic token is a call instruction (`call` or `callq`).
(define (compiler-backend-peephole-mnemonic-call?
  [data : (Ptr u8)]
  [i : i64]
  [mlen : i64]) : bool
  (and
    (or (= mlen 4) (= mlen 5))
    (= (compiler-backend-peephole-byte-at data i) 99)
    (= (compiler-backend-peephole-byte-at data (+ i 1)) 97)
    (= (compiler-backend-peephole-byte-at data (+ i 2)) 108)
    (= (compiler-backend-peephole-byte-at data (+ i 3)) 108)
    (or (= mlen 4) (= (compiler-backend-peephole-byte-at data (+ i 4)) 113))))

;; True iff the byte range [s,e) of `data` equals the literal `lit` exactly.
(define (compiler-backend-peephole-range-eq?
  [data : (Ptr u8)]
  [s : i64]
  [e : i64]
  [lit : String]) : bool
  (let
    [ln : i64 (string.string-length lit)]
    (if (not (= (- e s) ln))
      false
      (let
        [ld : (Ptr u8)
          (unsafe
            (string-data lit))]
        [k : i64 0]
        [ok : bool true]
        (begin
          (while (and ok (< k ln))
            (begin
              (if (=
                (compiler-backend-peephole-byte-at data (+ s k))
                (compiler-backend-peephole-byte-at ld k))
                unit
                (set! ok false))
              (set! k (+ k 1))))
          ok)))))

(define (compiler-backend-peephole-ranges-eq?
  [left : (Ptr u8)]
  [ls : i64]
  [le : i64]
  [right : (Ptr u8)]
  [rs : i64]
  [re : i64]) : bool
  (let
    [len : i64 (- le ls)]
    (if (not (= len (- re rs)))
      false
      (let
        [i : i64 0]
        [same : bool true]
        (begin
          (while (and same (< i len))
            (begin
              (if (=
                (compiler-backend-peephole-byte-at left (+ ls i))
                (compiler-backend-peephole-byte-at right (+ rs i)))
                unit
                (set! same false))
              (set! i (+ i 1))))
          same)))))

(define (compiler-backend-peephole-range-contains?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [needle : String]) : bool
  (let
    [len : i64 (string.string-length needle)]
    [i : i64 start]
    [found : bool false]
    (begin
      (while (and (not found) (<= (+ i len) end))
        (if (compiler-backend-peephole-range-eq? data i (+ i len) needle)
          (set! found true)
          (set! i (+ i 1))))
      found)))

(define (compiler-backend-peephole-register-range?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (and (< start end) (= (compiler-backend-peephole-byte-at data start) 37)))

(define (compiler-backend-peephole-stack-slot-range?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (or
    (compiler-backend-peephole-range-contains? data start end "(%rbp)")
    (compiler-backend-peephole-range-contains? data start end "(%rsp)")))

(define (compiler-backend-peephole-local-frame-slot-range?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (or
    (compiler-backend-peephole-range-contains? data start end "(%rsp)")
    (and
      (< start end)
      (= (compiler-backend-peephole-byte-at data start) 45)
      (compiler-backend-peephole-range-contains? data start end "(%rbp)"))))

(define (compiler-backend-peephole-local-move-range?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (or
    (compiler-backend-peephole-register-range? data start end)
    (compiler-backend-peephole-stack-slot-range? data start end)))

(define compiler-backend-peephole-op-register-flag : i64
  1)
(define compiler-backend-peephole-op-stack-flag : i64
  2)
(define compiler-backend-peephole-op-local-frame-flag : i64
  4)
(define compiler-backend-peephole-op-r10-base-flag : i64
  8)

(define (compiler-backend-peephole-operand-flags
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [key : i64]
  [memory-base : i64]) : i64
  (let
    [register? : bool
      (compiler-backend-peephole-register-range? data start end)]
    [packed-stack? : bool (compiler-backend-peephole-owner-key-stack? key)]
    [stack? : bool
      (or
        packed-stack?
        (= memory-base compiler-backend-peephole-memory-base-rbp)
        (= memory-base compiler-backend-peephole-memory-base-rsp)
        (and
          (>= (- end start) 6)
          (compiler-backend-peephole-stack-slot-range? data start end)))]
    [local-frame? : bool
      (if packed-stack?
        (or
          (not (= (bit-and (- key 1) 2) 0))
          (and
            (< start end)
            (= (compiler-backend-peephole-byte-at data start) 45)))
        (cond
          [(= memory-base compiler-backend-peephole-memory-base-rsp) true]
          [(= memory-base compiler-backend-peephole-memory-base-rbp)
            (or
              (and
                (< start end)
                (= (compiler-backend-peephole-byte-at data start) 45))
              (compiler-backend-peephole-range-contains?
                data
                start
                end
                "(%rsp)"))]
          [else
            (and
              stack?
              (compiler-backend-peephole-local-frame-slot-range? data start end))]))]
    [r10-base? : bool (= memory-base compiler-backend-peephole-memory-base-r10)]
    (+
      (if register?
        compiler-backend-peephole-op-register-flag
        0)
      (+
        (if stack?
          compiler-backend-peephole-op-stack-flag
          0)
        (+
          (if local-frame?
            compiler-backend-peephole-op-local-frame-flag
            0)
          (if r10-base?
            compiler-backend-peephole-op-r10-base-flag
            0))))))

(define (compiler-backend-peephole-op-flag? [flags : i64] [flag : i64]) : bool
  (not (= (bit-and flags flag) 0)))

;; SCAV3: the 64-bit parent of a 32/16/8-bit sub-register token [ts,te), or ""
;; if it is not a sub-register of one of the 14 owner-tracked GP registers. A
;; write to a sub-register (movl/xorl/movb/setcc dest) changes the full parent
;; register's value (32-bit forms zero-extend; 8/16-bit forms overwrite low
;; bytes), so the parent's slot mirror must be dropped -- returning the parent
;; here lets `last-operand-reg` clear exactly that register instead of forcing a
;; whole-map clear. %rbp/%rsp sub-registers (%ebp/%esp/%bp/%sp/%bpl/%spl) are
;; DELIBERATELY unmapped -> "" -> whole-map clear, preserving the frame/stack
;; pointer invalidation invariant (owner-reg? already excludes %rbp/%rsp).
(define (compiler-backend-peephole-subreg-to-reg
  [data : (Ptr u8)]
  [ts : i64]
  [te : i64]) : String
  (if (>= (compiler-backend-peephole-reg-index-range data ts te) 0)
    ""
    (compiler-backend-peephole-reg-name-from-index
      (compiler-backend-peephole-token-reg-index-range data ts te))))

;; Dense owner-register index for a full or partial GP register token. The
;; token grammar is a fixed set, so classify its 3--5 bytes once instead of
;; walking 56 literal comparisons. Partial-register writes map to their 64-bit
;; owner; rbp/rsp and their partial forms remain deliberately untracked.
(define (compiler-backend-peephole-token-reg-index-range
  [data : (Ptr u8)]
  [ts : i64]
  [te : i64]) : i64
  (let
    [n : i64 (- te ts)]
    (if (or
      (< n 3)
      (> n 5)
      (not (= (compiler-backend-peephole-byte-at data ts) 37)))
      -1
      (let
        [b1 : i64 (compiler-backend-peephole-byte-at data (+ ts 1))]
        [b2 : i64 (compiler-backend-peephole-byte-at data (+ ts 2))]
        (cond
          [(= n 3)
            (cond
              [(= b1 114) (cond [(= b2 56) 6] [(= b2 57) 7] [else -1])]
              [(= b1 97)
                (if (or (= b2 120) (= b2 108))
                  0
                  -1)]
              [(= b1 99)
                (if (or (= b2 120) (= b2 108))
                  1
                  -1)]
              [(= b1 100)
                (cond [(or (= b2 120) (= b2 108)) 2] [(= b2 105) 5] [else -1])]
              [(= b1 98)
                (if (or (= b2 120) (= b2 108))
                  3
                  -1)]
              [(= b1 115)
                (if (= b2 105)
                  4
                  -1)]
              [else -1])]
          [(= n 4)
            (let
              [b3 : i64 (compiler-backend-peephole-byte-at data (+ ts 3))]
              (cond
                [(= b1 114)
                  (cond
                    [(= b2 97)
                      (if (= b3 120)
                        0
                        -1)]
                    [(= b2 99)
                      (if (= b3 120)
                        1
                        -1)]
                    [(= b2 100) (cond [(= b3 120) 2] [(= b3 105) 5] [else -1])]
                    [(= b2 98)
                      (if (= b3 120)
                        3
                        -1)]
                    [(= b2 115)
                      (if (= b3 105)
                        4
                        -1)]
                    [(= b2 56)
                      (if (or (= b3 100) (= b3 119) (= b3 98))
                        6
                        -1)]
                    [(= b2 57)
                      (if (or (= b3 100) (= b3 119) (= b3 98))
                        7
                        -1)]
                    [(= b2 49)
                      (cond
                        [(= b3 48) 8]
                        [(= b3 49) 9]
                        [(= b3 50) 10]
                        [(= b3 51) 11]
                        [(= b3 52) 12]
                        [(= b3 53) 13]
                        [else -1])]
                    [else -1])]
                [(= b1 101)
                  (cond
                    [(= b2 97)
                      (if (= b3 120)
                        0
                        -1)]
                    [(= b2 99)
                      (if (= b3 120)
                        1
                        -1)]
                    [(= b2 100) (cond [(= b3 120) 2] [(= b3 105) 5] [else -1])]
                    [(= b2 98)
                      (if (= b3 120)
                        3
                        -1)]
                    [(= b2 115)
                      (if (= b3 105)
                        4
                        -1)]
                    [else -1])]
                [(and (= b1 115) (= b2 105) (= b3 108)) 4]
                [(and (= b1 100) (= b2 105) (= b3 108)) 5]
                [else -1]))]
          [else
            (let
              [b3 : i64 (compiler-backend-peephole-byte-at data (+ ts 3))]
              [b4 : i64 (compiler-backend-peephole-byte-at data (+ ts 4))]
              (if (and
                (= b1 114)
                (= b2 49)
                (or (= b4 100) (= b4 119) (= b4 98)))
                (cond
                  [(= b3 48) 8]
                  [(= b3 49) 9]
                  [(= b3 50) 10]
                  [(= b3 51) 11]
                  [(= b3 52) 12]
                  [(= b3 53) 13]
                  [else -1])
                -1))])))))

(define (compiler-backend-peephole-reg-name-from-index [index : i64]) : String
  (cond
    [(= index 0) "%rax"]
    [(= index 1) "%rcx"]
    [(= index 2) "%rdx"]
    [(= index 3) "%rbx"]
    [(= index 4) "%rsi"]
    [(= index 5) "%rdi"]
    [(= index 6) "%r8"]
    [(= index 7) "%r9"]
    [(= index 8) "%r10"]
    [(= index 9) "%r11"]
    [(= index 10) "%r12"]
    [(= index 11) "%r13"]
    [(= index 12) "%r14"]
    [(= index 13) "%r15"]
    [else ""]))

;; The single tracked GP register that is the LAST operand of the line [start,end),
;; or "" if the last operand is not a simple tracked register (memory, immediate,
;; xmm, or an untracked reg). Used to invalidate exactly the register a single-dest
;; instruction writes. A memory last operand ends in ')' so the backward reg-token
;; scan yields an empty token -> "".
(define (compiler-backend-peephole-last-operand-reg-index
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : i64
  (let
    [te : i64 end]
    (begin
      (while (and
        (> te start)
        (= (compiler-backend-peephole-byte-at data (- te 1)) 32))
        (set! te (- te 1)))
      (let
        [ts : i64 te]
        (begin
          (while (and
            (> ts start)
            (let
              [b : i64 (compiler-backend-peephole-byte-at data (- ts 1))]
              (or (= b 37) (and (>= b 97) (<= b 122)) (and (>= b 48) (<= b 57)))))
            (set! ts (- ts 1)))
          (if (and
            (< ts te)
            (= (compiler-backend-peephole-byte-at data ts) 37)
            (or
              (= ts start)
              (let
                [pb : i64 (compiler-backend-peephole-byte-at data (- ts 1))]
                (or (= pb 32) (= pb 44) (= pb 9)))))
            (compiler-backend-peephole-token-reg-index-range data ts te)
            -1))))))

(define (compiler-backend-peephole-last-operand-reg
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : String
  (compiler-backend-peephole-reg-name-from-index
    (compiler-backend-peephole-last-operand-reg-index data start end)))

;; True iff the mnemonic token [i,i+mlen) is an instruction whose ONLY written GP
;; register is its last operand (so invalidating just that register is sound):
;; the fixed q/l/w/b base set, the movabsq imm->reg load, any set<cc> (8-bit
;; dest), or one of the five widening moves. Classify the token from its length
;; and bytes once: this runs for every non-movq assembly line, and the former
;; chain re-entered the generic range/string comparator up to twenty times.
;; Excludes multi-writers (imul/mul/div/cqo/call/xchg); plain movq remains on the
;; dedicated move-transfer path and is deliberately not classified here.
(define (compiler-backend-peephole-mnemonic-single-dest?
  [data : (Ptr u8)]
  [i : i64]
  [mlen : i64]) : bool
  (if (< mlen 3)
    false
    (let
      [b0 : i64 (compiler-backend-peephole-byte-at data i)]
      [b1 : i64 (compiler-backend-peephole-byte-at data (+ i 1))]
      [b2 : i64 (compiler-backend-peephole-byte-at data (+ i 2))]
      [base3 : i64 (+ b0 (+ (* b1 256) (* b2 65536)))]
      (cond
        ;; set<cc>: preserve the existing prefix classification.
        [(and (= b0 115) (= b1 101) (= b2 116)) true]
        ;; movabsq
        [(= mlen 7)
          (and
            (= base3 7761773)
            (= (compiler-backend-peephole-byte-at data (+ i 3)) 97)
            (= (compiler-backend-peephole-byte-at data (+ i 4)) 98)
            (= (compiler-backend-peephole-byte-at data (+ i 5)) 115)
            (= (compiler-backend-peephole-byte-at data (+ i 6)) 113))]
        ;; movzbq, movzwq, movsbq, movswq, movslq
        [(= mlen 6)
          (let
            [kind : i64 (compiler-backend-peephole-byte-at data (+ i 3))]
            [width : i64 (compiler-backend-peephole-byte-at data (+ i 4))]
            (and
              (= base3 7761773)
              (= (compiler-backend-peephole-byte-at data (+ i 5)) 113)
              (or
                (and (= kind 122) (or (= width 98) (= width 119)))
                (and (= kind 115) (or (= width 98) (= width 119) (= width 108))))))]
        [else
          (let
            [suffix : i64
              (compiler-backend-peephole-byte-at data (+ i (- mlen 1)))]
            [width-suffix? : bool
              (or (= suffix 113) (= suffix 108) (= suffix 119) (= suffix 98))]
            (and
              width-suffix?
              (or
                ;; or{q,l,w,b}
                (and (= mlen 3) (= b0 111) (= b1 114))
                (and
                  (= mlen 4)
                  ;; mov{l,w,b}; movq stays on the dedicated move path.
                  (or
                    (and (not (= suffix 113)) (= base3 7761773))
                    (= base3 6579297)
                    (= base3 6452595)
                    (= base3 6581857)
                    (= base3 7499640)
                    (= base3 7104627)
                    (= base3 7497843)
                    (= base3 7496051)
                    (= base3 7102835)
                    (= base3 6776174)
                    (= base3 7630702)
                    (= base3 6516329)
                    (= base3 6514020)
                    (= base3 6382956))))))]))))

(define (compiler-backend-peephole-range-mentions-r10-data?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [i : i64 start]
    [found : bool false]
    (begin
      (while (and (not found) (<= (+ i 4) end))
        (if (and
          (= (compiler-backend-peephole-byte-at data i) 37)
          (= (compiler-backend-peephole-byte-at data (+ i 1)) 114)
          (= (compiler-backend-peephole-byte-at data (+ i 2)) 49)
          (= (compiler-backend-peephole-byte-at data (+ i 3)) 48))
          (set! found true)
          (set! i (+ i 1))))
      found)))

(define (compiler-backend-peephole-line-mnemonic-eq?
  [line : CompilerBackendPeepholeLine]
  [name : String]) : bool
  (compiler-backend-peephole-range-eq?
    (struct-get line data)
    (struct-get line mnemonic-start)
    (+ (struct-get line mnemonic-start) (struct-get line mnemonic-len))
    name))

(define (compiler-backend-peephole-line-text
  [line : CompilerBackendPeepholeLine]) : String
  (string.substring
    (struct-get line src)
    (struct-get line start)
    (- (struct-get line end) (struct-get line start))))

(define (compiler-backend-peephole-line-op-src-text
  [line : CompilerBackendPeepholeLine]) : String
  (string.substring
    (struct-get line src)
    (struct-get line op-src-start)
    (- (struct-get line op-src-end) (struct-get line op-src-start))))

(define (compiler-backend-peephole-line-op-dst-text
  [line : CompilerBackendPeepholeLine]) : String
  (string.substring
    (struct-get line src)
    (struct-get line op-dst-start)
    (- (struct-get line op-dst-end) (struct-get line op-dst-start))))

(define (compiler-backend-peephole-line-append
  [buf : (text_buf_borrowed.TextBufBorrowed asm)]
  [asm : String]
  [line : CompilerBackendPeepholeLine]) : (text_buf_borrowed.TextBufBorrowed
    asm)
  (compiler-backend-peephole-append-parsed-line buf asm line))

(define (compiler-backend-peephole-mnemonic-zext?
  [data : (Ptr u8)]
  [i : i64]
  [mlen : i64]) : bool
  (and
    (= mlen 6)
    (= (compiler-backend-peephole-byte-at data i) 109)
    (= (compiler-backend-peephole-byte-at data (+ i 1)) 111)
    (= (compiler-backend-peephole-byte-at data (+ i 2)) 118)
    (= (compiler-backend-peephole-byte-at data (+ i 3)) 122)
    (= (compiler-backend-peephole-byte-at data (+ i 4)) 98)
    (let
      [suffix : i64 (compiler-backend-peephole-byte-at data (+ i 5))]
      (or (= suffix 113) (= suffix 108)))))

(define (compiler-backend-peephole-parse-line
  [src : String]
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [newline : bool]
  [owned : bool]) : CompilerBackendPeepholeLine
  (let
    [ms : i64 start]
    (begin
      (while (and (< ms end) (= (compiler-backend-peephole-byte-at data ms) 32))
        (set! ms (+ ms 1)))
      (let
        [mlen : i64 (compiler-backend-peephole-token-len data ms end)]
        [operand-start : i64 (+ ms mlen)]
        [has-operands : bool false]
        [comma : i64 -1]
        [movq-prefix? : bool
          (compiler-backend-peephole-movq-prefix-at-range? data start end)]
        [zext? : bool (compiler-backend-peephole-mnemonic-zext? data ms mlen)]
        (begin
          ;; Only move/zext pair rules consume split operands. Most assembly
          ;; lines need just their mnemonic classification, so do not rescan
          ;; their full text looking for a comma that no rule will read.
          (if (or movq-prefix? zext?)
            (begin
              (while (and
                (< operand-start end)
                (= (compiler-backend-peephole-byte-at data operand-start) 32))
                (set! operand-start (+ operand-start 1)))
              (set!
                comma
                (compiler-backend-peephole-find-comma-space-range
                  data
                  operand-start
                  end))
              (if (and (> comma operand-start) (< (+ comma 2) end))
                (set! has-operands true)
                unit))
            unit)
          (let
            [is-movq : bool (and has-operands movq-prefix?)]
            [op-src-start : i64 operand-start]
            [op-src-end : i64
              (if has-operands
                comma
                operand-start)]
            [op-dst-start : i64
              (if has-operands
                (+ comma 2)
                end)]
            [op-dst-end : i64 end]
            [is-label : bool
              (and
                (< ms end)
                (= (compiler-backend-peephole-byte-at data (- end 1)) 58))]
            [cmp-or-test? : bool
              (compiler-backend-peephole-cmp-or-test-token? data ms mlen)]
            [clears : bool
              (cond
                [(>= ms end) false]
                [is-label true]
                [(= (compiler-backend-peephole-byte-at data ms) 46) false]
                [(= (compiler-backend-peephole-byte-at data ms) 106) false]
                [cmp-or-test? false]
                [else true])]
            [call? : bool
              (compiler-backend-peephole-mnemonic-call? data ms mlen)]
            [single-dest?
              : bool
              ;; The clobber transfer handles moves, labels, non-clobbering
              ;; directives/branches, and calls before consulting this field.
              (and
                (not is-movq)
                (not is-label)
                clears
                (not call?)
                (compiler-backend-peephole-mnemonic-single-dest? data ms mlen))]
            [last-reg : i64
              (if (or single-dest? zext?)
                (compiler-backend-peephole-last-operand-reg-index
                  data
                  start
                  end)
                -1)]
            [src-memory-base : i64
              (if is-movq
                (compiler-backend-peephole-memory-base-range
                  data
                  op-src-start
                  op-src-end)
                compiler-backend-peephole-memory-base-none)]
            [dst-memory-base : i64
              (if is-movq
                (compiler-backend-peephole-memory-base-range
                  data
                  op-dst-start
                  op-dst-end)
                compiler-backend-peephole-memory-base-none)]
            [src-key : i64
              (if is-movq
                (compiler-backend-peephole-owner-key-from-range
                  src
                  data
                  op-src-start
                  op-src-end
                  src-memory-base)
                (compiler-backend-peephole-owner-key-unknown))]
            [dst-key : i64
              (if is-movq
                (compiler-backend-peephole-owner-key-from-range
                  src
                  data
                  op-dst-start
                  op-dst-end
                  dst-memory-base)
                (compiler-backend-peephole-owner-key-unknown))]
            [src-reg : i64
              (if is-movq
                (compiler-backend-peephole-reg-index-range
                  data
                  op-src-start
                  op-src-end)
                -1)]
            [dst-reg : i64
              (if is-movq
                (compiler-backend-peephole-reg-index-range
                  data
                  op-dst-start
                  op-dst-end)
                -1)]
            [src-flags : i64
              (if is-movq
                (compiler-backend-peephole-operand-flags
                  data
                  op-src-start
                  op-src-end
                  src-key
                  src-memory-base)
                0)]
            [dst-flags : i64
              (if is-movq
                (compiler-backend-peephole-operand-flags
                  data
                  op-dst-start
                  op-dst-end
                  dst-key
                  dst-memory-base)
                0)]
            (CompilerBackendPeepholeLine
              src
              data
              start
              end
              newline
              owned
              ms
              mlen
              has-operands
              op-src-start
              op-src-end
              op-dst-start
              op-dst-end
              src-reg
              dst-reg
              src-flags
              dst-flags
              src-key
              dst-key
              is-movq
              is-label
              (if call?
                (compiler-backend-peephole-line-noreturn-abort? data start end)
                false)
              clears
              call?
              single-dest?
              last-reg
              (if zext?
                last-reg
                -1))))))))

(define (compiler-backend-peephole-owned-line [line : String] [newline : bool]) : CompilerBackendPeepholeLine
  (compiler-backend-peephole-parse-line
    line
    (unsafe
      (string-data line))
    0
    (string.string-length line)
    newline
    true))

(define (compiler-backend-peephole-empty-line) : CompilerBackendPeepholeLine
  (compiler-backend-peephole-owned-line "" false))

(define (compiler-backend-peephole-line-copy
  [line : CompilerBackendPeepholeLine]) : CompilerBackendPeepholeLine
  (CompilerBackendPeepholeLine
    (struct-get line src)
    (struct-get line data)
    (struct-get line start)
    (struct-get line end)
    (struct-get line newline)
    (struct-get line owned)
    (struct-get line mnemonic-start)
    (struct-get line mnemonic-len)
    (struct-get line has-operands)
    (struct-get line op-src-start)
    (struct-get line op-src-end)
    (struct-get line op-dst-start)
    (struct-get line op-dst-end)
    (struct-get line op-src-reg)
    (struct-get line op-dst-reg)
    (struct-get line op-src-flags)
    (struct-get line op-dst-flags)
    (struct-get line op-src-key)
    (struct-get line op-dst-key)
    (struct-get line movq)
    (struct-get line label)
    (struct-get line noreturn-abort)
    (struct-get line clears-owners)
    (struct-get line call)
    (struct-get line single-dest)
    (struct-get line last-reg)
    (struct-get line zext-dst)))

;; True iff the line [start,end) is a label (non-blank after leading spaces and
;; ends in ':'). Mirrors the label arm of line-clears-owners?.
(define (compiler-backend-peephole-line-is-label?
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [i : i64 start]
    (begin
      (while (and (< i end) (= (compiler-backend-peephole-byte-at data i) 32))
        (set! i (+ i 1)))
      (and (< i end) (= (compiler-backend-peephole-byte-at data (- end 1)) 58)))))

;; True iff the label on line [start,end) (its name = first-non-space..':') is in
;; the backend-collected carry-safe set -- i.e. a block reached only by
;; fall-through from its single layout-adjacent predecessor, so the running owner
;; map may be CARRIED across it. Any label absent from the set (every merge /
;; branch / switch / jump-table target, every synthetic non-block label, and the
;; function entry) is NOT carry-safe and must reset. `src` is the String the
;; byte offsets index into (the asm buffer or a rewritten pending line). The
;; label name is interned and looked up in the i64-id carry-safe set.
(define (compiler-backend-peephole-label-carry-safe?
  [src : String]
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]) : bool
  (let
    [i : i64 start]
    (begin
      (while (and (< i end) (= (compiler-backend-peephole-byte-at data i) 32))
        (set! i (+ i 1)))
      (if (>= i (- end 1))
        false
        (let
          [klen : i64 (- (- end 1) i)]
          (compiler-backend-peephole-carry-safe-contains-bytes?
            data
            i
            klen
            (intern-hash-slice src i klen)))))))

;; Per-destination owner invalidation for a non-movq line.
;;  * A NORETURN abort call (SCAV2): keep the map unchanged -- the fall-through is
;;    dead, so nothing observes it until the guard-ok label below.
;;  * A LABEL: reset the whole map UNLESS the label is carry-safe (a provably
;;    single-pred fall-through block), OR (SCAV2) it is a guard-ok continuation
;;    label reached immediately after a noreturn abort (`prev-abort?`): its only
;;    live predecessor is the guard's conditional jump, across which the register
;;    map is identical to the map carried through the abort, so the map is valid.
;;  * A normal call: preserve callee-saved register owners, clear caller-saved
;;    owners.
;;  * A whitelisted single-GP-dest q-op whose last operand is a tracked register:
;;    clear only that register's owner (everything else's reg<->slot mirror
;;    survives).
;;  * Otherwise fall back to the conservative whole-map clear.
(define (compiler-backend-peephole-line-clobber-owners
  [owners : CompilerBackendPeepholeOwners]
  [src : String]
  [data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [prev-abort? : bool]) : CompilerBackendPeepholeOwners
  (cond
    [(compiler-backend-peephole-line-noreturn-abort? data start end) owners]
    [(compiler-backend-peephole-line-is-label? data start end)
      (if (or
        (compiler-backend-peephole-label-carry-safe? src data start end)
        (and
          prev-abort?
          (compiler-backend-peephole-label-guard-ok? data start end)))
        owners
        (compiler-backend-peephole-owners-empty))]
    [(not (compiler-backend-peephole-line-clears-owners? data start end))
      owners]
    [else
      (let
        [i : i64 start]
        (begin
          (while (and
            (< i end)
            (= (compiler-backend-peephole-byte-at data i) 32))
            (set! i (+ i 1)))
          (let
            [mlen : i64 (compiler-backend-peephole-token-len data i end)]
            (cond
              [(compiler-backend-peephole-mnemonic-call? data i mlen)
                (compiler-backend-peephole-owners-clear-call-clobbers owners)]
              [(compiler-backend-peephole-mnemonic-single-dest? data i mlen)
                (let
                  [dreg : i64
                    (compiler-backend-peephole-last-operand-reg-index
                      data
                      start
                      end)]
                  (if (< dreg 0)
                    (compiler-backend-peephole-owners-empty)
                    (compiler-backend-peephole-owners-set-reg-index
                      owners
                      dreg
                      (compiler-backend-peephole-owner-key-unknown))))]
              [else (compiler-backend-peephole-owners-empty)]))))]))

(define (compiler-backend-peephole-line-clobber-owners-desc
  [owners : CompilerBackendPeepholeOwners]
  [line : CompilerBackendPeepholeLine]
  [prev-abort? : bool]) : CompilerBackendPeepholeOwners
  (cond
    [(struct-get line noreturn-abort) owners]
    [(struct-get line label)
      (if (or
        (compiler-backend-peephole-label-carry-safe?
          (struct-get line src)
          (struct-get line data)
          (struct-get line start)
          (struct-get line end))
        (and
          prev-abort?
          (compiler-backend-peephole-label-guard-ok?
            (struct-get line data)
            (struct-get line start)
            (struct-get line end))))
        owners
        (compiler-backend-peephole-owners-empty))]
    [(not (struct-get line clears-owners)) owners]
    [(struct-get line call)
      (compiler-backend-peephole-owners-clear-call-clobbers owners)]
    [(struct-get line single-dest)
      (let
        [dreg : i64 (struct-get line last-reg)]
        (if (< dreg 0)
          (compiler-backend-peephole-owners-empty)
          (compiler-backend-peephole-owners-set-reg-index
            owners
            dreg
            (compiler-backend-peephole-owner-key-unknown))))]
    [else (compiler-backend-peephole-owners-empty)]))

(define (compiler-backend-peephole-line-self-move-desc?
  [line : CompilerBackendPeepholeLine]) : bool
  (and
    (struct-get line movq)
    (not (= (bit-and (struct-get line op-src-flags) 3) 0))
    (compiler-backend-peephole-ranges-eq?
      (struct-get line data)
      (struct-get line op-src-start)
      (struct-get line op-src-end)
      (struct-get line data)
      (struct-get line op-dst-start)
      (struct-get line op-dst-end))))

(define (compiler-backend-peephole-redundant-zext-next-desc?
  [next : CompilerBackendPeepholeLine]
  [reg : i64]) : bool
  (if (or
    (not (struct-get next has-operands))
    (not (compiler-backend-peephole-line-mnemonic-eq? next "movzbq")))
    false
    (let
      [data : (Ptr u8) (struct-get next data)]
      [src-start : i64 (struct-get next op-src-start)]
      [src-end : i64 (struct-get next op-src-end)]
      [src-len : i64 (- src-end src-start)]
      (if (or
        (= src-len 0)
        (not (= (compiler-backend-peephole-byte-at data src-start) 37)))
        false
        (let
          [last : i64 (compiler-backend-peephole-byte-at data (- src-end 1))]
          (if (not (or (= last 108) (= last 98)))
            false
            (and
              (=
                (compiler-backend-peephole-token-reg-index-range
                  data
                  src-start
                  src-end)
                reg)
              (= (struct-get next last-reg) reg))))))))

(define (compiler-backend-peephole-redundant-zext-pair-desc?
  [pending : CompilerBackendPeepholeLine]
  [next : CompilerBackendPeepholeLine]) : bool
  (let
    [dst : i64 (struct-get pending zext-dst)]
    (if (< dst 0)
      false
      (compiler-backend-peephole-redundant-zext-next-desc? next dst))))

(define (compiler-backend-peephole-r10-dead-after-desc?
  [asm : String]
  [asm-data : (Ptr u8)]
  [start : i64]
  [n : i64]) : bool
  (let
    [i : i64 start]
    [k : i64 0]
    [result : i64 -1]
    (begin
      (while (and
        (< i n)
        (< result 0)
        (< k compiler-backend-peephole-r10-dead-scan-line-cap))
        (let
          [end : i64 (compiler-backend-peephole-line-end asm-data i n)]
          [next-start : i64
            (if (< end n)
              (+ end 1)
              end)]
          [line : CompilerBackendPeepholeLine
            (compiler-backend-peephole-parse-line
              asm
              asm-data
              i
              end
              (< end n)
              false)]
          [mentions-r10 : bool
            (compiler-backend-peephole-range-mentions-r10-data? asm-data i end)]
          [clean-writes-r10 : bool
            (and
              (struct-get line movq)
              (= (struct-get line op-dst-reg) 8)
              (not
                (compiler-backend-peephole-range-mentions-r10-data?
                  (struct-get line data)
                  (struct-get line op-src-start)
                  (struct-get line op-src-end))))]
          (begin
            (if mentions-r10
              (if clean-writes-r10
                (set! result 1)
                (set! result 0))
              (if (struct-get line movq)
                unit
                (set! result 0)))
            (set! i next-start)
            (set! k (+ k 1)))))
      (if (and (< result 0) (< i n))
        (set!
          compiler-backend-peephole-r10-dead-scan-cap-hits
          (+ compiler-backend-peephole-r10-dead-scan-cap-hits 1))
        unit)
      (= result 1))))

(define (compiler-backend-peephole-pair-action-desc
  [asm : String]
  [asm-data : (Ptr u8)]
  [pending : CompilerBackendPeepholeLine]
  [next : CompilerBackendPeepholeLine]) : i64
  (if (compiler-backend-peephole-redundant-zext-pair-desc? pending next)
    2
    (if (struct-get pending movq)
      (if (compiler-backend-peephole-line-self-move-desc? pending)
        1
        (if (struct-get next movq)
          (let
            [pd : (Ptr u8) (struct-get pending data)]
            [nd : (Ptr u8) (struct-get next data)]
            [pss : i64 (struct-get pending op-src-start)]
            [pse : i64 (struct-get pending op-src-end)]
            [pds : i64 (struct-get pending op-dst-start)]
            [pde : i64 (struct-get pending op-dst-end)]
            [nss : i64 (struct-get next op-src-start)]
            [nse : i64 (struct-get next op-src-end)]
            [nds : i64 (struct-get next op-dst-start)]
            [nde : i64 (struct-get next op-dst-end)]
            [psf : i64 (struct-get pending op-src-flags)]
            [pdf : i64 (struct-get pending op-dst-flags)]
            [nsf : i64 (struct-get next op-src-flags)]
            [ndf : i64 (struct-get next op-dst-flags)]
            (cond
              [(and
                  (compiler-backend-peephole-op-flag?
                    psf
                    compiler-backend-peephole-op-register-flag)
                  (compiler-backend-peephole-op-flag?
                    pdf
                    compiler-backend-peephole-op-local-frame-flag)
                  (compiler-backend-peephole-op-flag?
                    nsf
                    compiler-backend-peephole-op-register-flag)
                  (compiler-backend-peephole-op-flag?
                    ndf
                    compiler-backend-peephole-op-local-frame-flag)
                  (compiler-backend-peephole-ranges-eq? pd pds pde nd nds nde))
                1]
              [(and
                  (not (= (bit-and psf 3) 0))
                  (not (= (bit-and pdf 3) 0))
                  (not (= (bit-and nsf 3) 0))
                  (not (= (bit-and ndf 3) 0))
                  (or
                    (and
                      (compiler-backend-peephole-ranges-eq?
                        pd
                        pss
                        pse
                        nd
                        nss
                        nse)
                      (compiler-backend-peephole-ranges-eq?
                        pd
                        pds
                        pde
                        nd
                        nds
                        nde))
                    (and
                      (compiler-backend-peephole-ranges-eq?
                        pd
                        pds
                        pde
                        nd
                        nss
                        nse)
                      (compiler-backend-peephole-ranges-eq?
                        pd
                        pss
                        pse
                        nd
                        nds
                        nde))))
                2]
              [(and
                  (compiler-backend-peephole-op-flag?
                    psf
                    compiler-backend-peephole-op-register-flag)
                  (compiler-backend-peephole-op-flag?
                    pdf
                    compiler-backend-peephole-op-local-frame-flag)
                  (compiler-backend-peephole-op-flag?
                    nsf
                    compiler-backend-peephole-op-local-frame-flag)
                  (compiler-backend-peephole-op-flag?
                    ndf
                    compiler-backend-peephole-op-register-flag)
                  (compiler-backend-peephole-ranges-eq? pd pds pde nd nss nse))
                3]
              [(and
                  (compiler-backend-peephole-op-flag?
                    psf
                    compiler-backend-peephole-op-register-flag)
                  (not (compiler-backend-peephole-range-eq? pd pss pse "%r10"))
                  (not (compiler-backend-peephole-range-eq? pd pss pse "%rbp"))
                  (= (struct-get pending op-dst-reg) 8)
                  (compiler-backend-peephole-op-flag?
                    nsf
                    compiler-backend-peephole-op-r10-base-flag)
                  (compiler-backend-peephole-op-flag?
                    ndf
                    compiler-backend-peephole-op-register-flag)
                  (or
                    (= (struct-get next op-dst-reg) 8)
                    (compiler-backend-peephole-r10-dead-after-desc?
                      asm
                      asm-data
                      (if (< (struct-get next end) (string.string-length asm))
                        (+ (struct-get next end) 1)
                        (struct-get next end))
                      (string.string-length asm))))
                4]
              [else 0]))
          0))
      0)))

(define (compiler-backend-peephole-forward-frame-load-line-desc
  [pending : CompilerBackendPeepholeLine]
  [next : CompilerBackendPeepholeLine]) : String
  (if (and (struct-get pending movq) (struct-get next movq))
    (str_cat.str-cat
      "    movq "
      (compiler-backend-peephole-line-op-src-text pending)
      ", "
      (compiler-backend-peephole-line-op-dst-text next))
    (compiler-backend-peephole-line-text next)))

(define (compiler-backend-peephole-r10-base-fold-line-desc
  [pending : CompilerBackendPeepholeLine]
  [next : CompilerBackendPeepholeLine]) : String
  (if (and (struct-get pending movq) (struct-get next movq))
    (str_cat.str-cat
      "    movq "
      (compiler-backend-peephole-r10-base-rewrite
        (compiler-backend-peephole-line-op-src-text next)
        (compiler-backend-peephole-line-op-src-text pending))
      ", "
      (compiler-backend-peephole-line-op-dst-text next))
    (compiler-backend-peephole-line-text next)))

(define (compiler-backend-peephole-emit-line-desc
  [out : (text_buf_borrowed.TextBufBorrowed asm)]
  [asm : String]
  [line : CompilerBackendPeepholeLine]
  [owners : CompilerBackendPeepholeOwners]
  [prev-abort? : bool]) : (CompilerBackendPeepholeEmitResult asm)
  (if (struct-get line movq)
    (let
      [src-reg : i64 (struct-get line op-src-reg)]
      [dst-reg : i64 (struct-get line op-dst-reg)]
      [src-key : i64 (struct-get line op-src-key)]
      [dst-key : i64 (struct-get line op-dst-key)]
      [is-slot : bool (compiler-backend-peephole-owner-key-known? src-key)]
      [dst-owns : bool
        (and
          is-slot
          (compiler-backend-peephole-owner-key-eq?
            (compiler-backend-peephole-owners-get-index owners dst-reg)
            src-key))]
      [ry : String
        (if (and is-slot (not dst-owns) (>= dst-reg 0))
          (compiler-backend-peephole-owners-find-reg-for-slot-index
            owners
            src-key
            dst-reg)
          "")]
      [next-out : (text_buf_borrowed.TextBufBorrowed asm)
        (cond
          [dst-owns out]
          [(not (string.eq ry ""))
            (let
              [b1 : (text_buf_borrowed.TextBufBorrowed asm)
                (text_buf_borrowed.append-owned out "    movq ")]
              [b2 : (text_buf_borrowed.TextBufBorrowed asm)
                (text_buf_borrowed.append-owned b1 ry)]
              [b3 : (text_buf_borrowed.TextBufBorrowed asm)
                (text_buf_borrowed.append-owned b2 ", ")]
              [b4 : (text_buf_borrowed.TextBufBorrowed asm)
                (if (struct-get line owned)
                  (text_buf_borrowed.append-owned
                    b3
                    (compiler-backend-peephole-line-op-dst-text line))
                  (text_buf_borrowed.append-slice
                    b3
                    (& asm)
                    (struct-get line op-dst-start)
                    (-
                      (struct-get line op-dst-end)
                      (struct-get line op-dst-start))))]
              (if (struct-get line newline)
                (text_buf_borrowed.append-char b4 '\n')
                b4))]
          [else (compiler-backend-peephole-line-append out asm line)])]
      [next-owners : CompilerBackendPeepholeOwners
        (compiler-backend-peephole-movq-owners-transfer-keyed-index
          owners
          src-reg
          dst-reg
          src-key
          dst-key)]
      (CompilerBackendPeepholeEmitResult next-out next-owners))
    (CompilerBackendPeepholeEmitResult
      (compiler-backend-peephole-line-append out asm line)
      (compiler-backend-peephole-line-clobber-owners-desc
        owners
        line
        prev-abort?))))

(define (compiler-backend-peephole-emit-pending-line
  [out : (text_buf_borrowed.TextBufBorrowed asm)]
  [asm : String]
  [asm-data : (Ptr u8)]
  [pending-start : i64]
  [pending-end : i64]
  [pending-line : String]
  [pending-owned? : bool]
  [pending-newline : bool]
  [owners : CompilerBackendPeepholeOwners]
  [prev-abort? : bool]) : (CompilerBackendPeepholeEmitResult asm)
  (match (compiler-backend-peephole-line-movq
    asm
    asm-data
    pending-start
    pending-end
    pending-line
    pending-owned?)
    [(CompilerBackendPeepholeMove.Move src dst)
      (let
        ;; SCAV2: `src` is a trackable memory operand -- a stack slot OR a
        ;; SYM(%rip) global load -- so the same reload-elision machinery CSEs
        ;; repeated global-handle loads (drop, or reg-reg reuse).
        [src-key : i64 (compiler-backend-peephole-owner-key-from-operand src)]
        [dst-key : i64 (compiler-backend-peephole-owner-key-from-operand dst)]
        [is-slot : bool (compiler-backend-peephole-owner-key-known? src-key)]
        ;; same-register elision: dst already mirrors this slot/global -> drop.
        [dst-owns : bool
          (and
            is-slot
            (compiler-backend-peephole-owner-key-eq?
              (compiler-backend-peephole-owners-get owners dst)
              src-key))]
        ;; cross-register reuse: another GP reg already holds this slot -> rewrite
        ;; the memory reload `movq SLOT, dst` as the cheaper `movq <ry>, dst`.
        [ry : String
          (if (and
            is-slot
            (not dst-owns)
            (compiler-backend-peephole-owner-reg? dst))
            (compiler-backend-peephole-owners-find-reg-for-slot
              owners
              src-key
              dst)
            "")]
        [next-out : (text_buf_borrowed.TextBufBorrowed asm)
          (cond
            [dst-owns out]
            [(not (string.eq ry ""))
              (let
                [b1 : (text_buf_borrowed.TextBufBorrowed asm)
                  (text_buf_borrowed.append-owned out "    movq ")]
                [b2 : (text_buf_borrowed.TextBufBorrowed asm)
                  (text_buf_borrowed.append-owned b1 ry)]
                [b3 : (text_buf_borrowed.TextBufBorrowed asm)
                  (text_buf_borrowed.append-owned b2 ", ")]
                [b4 : (text_buf_borrowed.TextBufBorrowed asm)
                  (text_buf_borrowed.append-owned b3 dst)]
                (if pending-newline
                  (text_buf_borrowed.append-char b4 '\n')
                  b4))]
            [else
              (compiler-backend-peephole-append-pending-line
                out
                asm
                pending-start
                pending-end
                pending-line
                pending-owned?
                pending-newline)])]
        ;; The owner transfer is keyed on the ORIGINAL move (SLOT -> dst): dst now
        ;; mirrors SLOT regardless of whether the line was emitted as the reload or
        ;; the reg-reg rewrite (both leave dst holding SLOT's value).
        [next-owners : CompilerBackendPeepholeOwners
          (compiler-backend-peephole-movq-owners-transfer-keyed
            owners
            src
            dst
            src-key
            dst-key)]
        (CompilerBackendPeepholeEmitResult next-out next-owners))]
    [(CompilerBackendPeepholeMove.NoMove)
      (let
        [next-owners : CompilerBackendPeepholeOwners
          (if pending-owned?
            (compiler-backend-peephole-line-clobber-owners
              owners
              pending-line
              (unsafe
                (string-data pending-line))
              0
              (string.string-length pending-line)
              prev-abort?)
            (compiler-backend-peephole-line-clobber-owners
              owners
              asm
              asm-data
              pending-start
              pending-end
              prev-abort?))]
        (CompilerBackendPeepholeEmitResult
          (compiler-backend-peephole-append-pending-line
            out
            asm
            pending-start
            pending-end
            pending-line
            pending-owned?
            pending-newline)
          next-owners))]))

;; SCAV2: true iff the pending line (owned String or asm byte range) is a
;; noreturn abort call. Threaded as `prev-abort?` so the guard-ok label emitted
;; immediately after it carries the owner map (line-clobber-owners label arm).
(define (compiler-backend-peephole-pending-noreturn-abort?
  ;; lint-allow: unused-variable
  [asm : String]
  [asm-data : (Ptr u8)]
  [start : i64]
  [end : i64]
  [line : String]
  [owned? : bool]) : bool
  (if owned?
    (compiler-backend-peephole-line-noreturn-abort?
      (unsafe
        (string-data line))
      0
      (string.string-length line))
    (compiler-backend-peephole-line-noreturn-abort? asm-data start end)))

;; User-function chunks begin with `.globl`; processing either side separately
;; preserves the legacy pass because that directive/function-entry boundary
;; clears pending pair and owner state.  Chunks that split a function remain in
;; the same group and are rendered together.
(define (compiler-backend-peephole-chunk-starts-global? [chunk : String]) : bool
  (let
    [data : (Ptr u8)
      (unsafe
        (string-data chunk))]
    [n : i64 (string.string-length chunk)]
    [i : i64 0]
    (begin
      (while (and
        (< i n)
        (or
          (= (compiler-backend-peephole-byte-at data i) 32)
          (= (compiler-backend-peephole-byte-at data i) 9)
          (= (compiler-backend-peephole-byte-at data i) 10)
          (= (compiler-backend-peephole-byte-at data i) 13)))
        (set! i (+ i 1)))
      (and
        (<= (+ i 6) n)
        (compiler-backend-peephole-range-eq? data i (+ i 6) ".globl")))))

;; Render and optimize only the accumulated function group.  The raw rendered
;; String is scoped to its own arena; the complete peephole result is allocated
;; in the caller arena before that raw arena is released.
(define (compiler-backend-peephole-chunk-state-flush
  [state : CompilerBackendPeepholeChunkState]) : CompilerBackendPeepholeChunkState
  (if (text_buf.empty? (struct-get state group))
    state
    (let
      [output-arena : arena.Arena (arena.current)]
      [render-arena : arena.Arena (arena.make)]
      (begin
        (unsafe
          (arena.set! render-arena))
        (let
          [raw-asm : String (text_buf.render (struct-get state group))]
          (begin
            (unsafe
              (arena.set! output-arena))
            (let
              [peepholed-asm : String
                (compiler-backend-peephole-asm-once raw-asm)]
              (begin
                (unsafe
                  (arena.destroy render-arena))
                (CompilerBackendPeepholeChunkState
                  (text_buf.append (struct-get state out) peepholed-asm)
                  (text_buf.empty))))))))))

(define (compiler-backend-peephole-text-buf-once-in-arena
  [buf : text_buf.TextBuf]
  [group-arena : arena.Arena]) : text_buf.TextBuf
  (let
    [chunks : text_buf.TextBufChunkList (struct-get buf chunks)]
    [chunk-count : i64 (text_buf.chunk-count chunks 0)]
    [items : (Array String) (array.make-array String chunk-count)]
    [initial : CompilerBackendPeepholeChunkState
      (CompilerBackendPeepholeChunkState (text_buf.empty) (text_buf.empty))]
    (begin
      (text_buf.chunks-fill-array-rev chunks items (- chunk-count 1))
      (let
        [state : CompilerBackendPeepholeChunkState initial]
        [i : i64 0]
        (begin
          (while (< i chunk-count)
            (let
              [chunk : String (array-ref items i)]
              [at-boundary : CompilerBackendPeepholeChunkState
                (if (and
                  (compiler-backend-peephole-chunk-starts-global? chunk)
                  (not (text_buf.empty? (struct-get state group))))
                  (compiler-backend-peephole-chunk-state-flush state)
                  state)]
              [group : text_buf.TextBuf
                (in-arena
                  group-arena
                  (text_buf.append (struct-get at-boundary group) chunk))]
              (begin
                (set!
                  state
                  (CompilerBackendPeepholeChunkState
                    (struct-get at-boundary out)
                    group))
                (set! i (+ i 1)))))
          (let
            [flushed : CompilerBackendPeepholeChunkState
              (compiler-backend-peephole-chunk-state-flush state)]
            (struct-get flushed out)))))))

(define (compiler-backend-peephole-text-buf-once [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (compiler-backend-peephole-text-buf-once-in-arena buf (arena.current)))

;; Flush one raw function group through both text passes. `scratch` is active
;; on entry and rewound before return; only the final copied group string
;; escapes into `home`. This keeps neither a whole raw assembly String nor a
;; whole peepholed String alive beside the retained output.
(define (compiler-backend-peephole-sweep-chunk-state-flush
  [state : CompilerBackendPeepholeSweepChunkState]
  [scratch-mark : arena.ArenaMark]
  [home-arena : arena.Arena]) : CompilerBackendPeepholeSweepChunkState
  (if (text_buf.empty? (struct-get state group))
    state
    (let
      [raw-asm : String (text_buf.render (struct-get state group))]
      [peepholed-asm : String (compiler-backend-peephole-asm-once raw-asm)]
      [swept : CompilerBackendDeadstoreSweepChunkResult
        (compiler-backend-deadstore-sweep-buffer-from-cursor
          peepholed-asm
          (struct-get state sweep-cursor))]
      [swept-asm : String (text_buf.render (struct-get swept buf))]
      [finished : CompilerBackendPeepholeSweepChunkState
        (in-arena
          home-arena
          (let
            [kept : String
              (string.substring swept-asm 0 (string.string-length swept-asm))]
            (CompilerBackendPeepholeSweepChunkState
              (text_buf.append (struct-get state out) kept)
              (text_buf.empty)
              (struct-get swept cursor))))]
      (begin
        (unsafe
          (arena.rewind scratch-mark))
        finished))))

(define (compiler-backend-assembly-stream-active?) : bool
  compiler-backend-assembly-stream-active)

(define (compiler-backend-assembly-stream-start!
  [raw-arena : arena.Arena]
  [raw-mark : arena.ArenaMark]
  [peephole-arena : arena.Arena]
  [peephole-mark : arena.ArenaMark]
  [home-arena : arena.Arena]) : unit
  (let
    [batch : text_buf.TextBuf (in-arena raw-arena (text_buf.empty))]
    (begin
      (set! compiler-backend-assembly-stream-raw-arena raw-arena)
      (set! compiler-backend-assembly-stream-raw-mark raw-mark)
      (set! compiler-backend-assembly-stream-peephole-arena peephole-arena)
      (set! compiler-backend-assembly-stream-peephole-mark peephole-mark)
      (set!
        compiler-backend-assembly-stream-out
        (in-arena home-arena (text_buf.empty)))
      (set! compiler-backend-assembly-stream-home-arena home-arena)
      (set! compiler-backend-assembly-stream-sweep-cursor 0)
      (set! compiler-backend-assembly-stream-batch batch)
      (set! compiler-backend-assembly-stream-batch-count 0)
      (set! compiler-backend-assembly-stream-raw-ready false)
      (set! compiler-backend-assembly-stream-active true))))

(define (compiler-backend-assembly-stream-begin-raw!) : unit
  (when
    compiler-backend-assembly-stream-active
    (begin
      (unsafe
        (arena.set! compiler-backend-assembly-stream-raw-arena))
      (unless
        compiler-backend-assembly-stream-raw-ready
        (begin
          (unsafe
            (arena.rewind compiler-backend-assembly-stream-raw-mark))
          (compiler-backend-clear-function-emit-state!)
          (set! compiler-backend-assembly-stream-raw-ready true))))))

(define (compiler-backend-assembly-stream-rewind-raw!) : unit
  ;; Raw function text stays until a bounded batch has passed peephole/sweep.
  unit)

;; Flush the current bounded raw batch, then reclaim its arena before the next
;; batch. The emitted output and sweep cursor are copied into the home-owned
;; stream state, so no references into the rewound raw arena remain.
(define (compiler-backend-assembly-stream-flush-batch!) : unit
  (unless
    (or
      (not compiler-backend-assembly-stream-active)
      (text_buf.empty? compiler-backend-assembly-stream-batch))
    (let
      [source-arena : arena.Arena (arena.current)]
      [state : CompilerBackendPeepholeSweepChunkState
        (CompilerBackendPeepholeSweepChunkState
          compiler-backend-assembly-stream-out
          compiler-backend-assembly-stream-batch
          compiler-backend-assembly-stream-sweep-cursor)]
      (begin
        (unsafe
          (arena.set! compiler-backend-assembly-stream-peephole-arena))
        (let
          [flushed : CompilerBackendPeepholeSweepChunkState
            (compiler-backend-peephole-sweep-chunk-state-flush
              state
              compiler-backend-assembly-stream-peephole-mark
              compiler-backend-assembly-stream-home-arena)]
          (begin
            (set! compiler-backend-assembly-stream-out (struct-get flushed out))
            (set!
              compiler-backend-assembly-stream-sweep-cursor
              (struct-get flushed sweep-cursor))
            (set! compiler-backend-assembly-stream-batch-count 0)
            (unsafe
              (arena.set! compiler-backend-assembly-stream-raw-arena))
            (unsafe
              (arena.rewind compiler-backend-assembly-stream-raw-mark))
            (set! compiler-backend-assembly-stream-batch (text_buf.empty))
            (compiler-backend-clear-function-emit-state!)
            (set! compiler-backend-assembly-stream-raw-ready true)
            (unsafe
              (arena.set! source-arena))))))))

;; Append one function/adapter emission. A batch boundary is also a `.globl`
;; boundary, so flushing it preserves the legacy whole-stream peephole output.
(define (compiler-backend-assembly-stream-process-string! [raw-asm : String]) : unit
  (when
    compiler-backend-assembly-stream-active
    (begin
      (set!
        compiler-backend-assembly-stream-batch
        (text_buf.append compiler-backend-assembly-stream-batch raw-asm))
      (set!
        compiler-backend-assembly-stream-batch-count
        (+ compiler-backend-assembly-stream-batch-count 1))
      (when
        (>=
          compiler-backend-assembly-stream-batch-count
          compiler-backend-assembly-stream-batch-function-limit)
        (compiler-backend-assembly-stream-flush-batch!)))))

(define (compiler-backend-assembly-stream-process-buffer!
  [raw : text_buf.TextBuf]) : unit
  (unless
    (or (not compiler-backend-assembly-stream-active) (text_buf.empty? raw))
    (begin
      (compiler-backend-assembly-stream-flush-batch!)
      (compiler-backend-assembly-stream-process-string! (text_buf.render raw))
      (compiler-backend-assembly-stream-flush-batch!))))

(define (compiler-backend-assembly-stream-output) : text_buf.TextBuf
  (if compiler-backend-assembly-stream-active
    compiler-backend-assembly-stream-out
    (text_buf.empty)))

(define (compiler-backend-assembly-stream-finish!) : text_buf.TextBuf
  (begin
    (compiler-backend-assembly-stream-flush-batch!)
    (let
      [out : text_buf.TextBuf (compiler-backend-assembly-stream-output)]
      (begin
        (set! compiler-backend-assembly-stream-active false)
        out))))

(define (compiler-backend-assembly-stream-abort!) : unit
  (set! compiler-backend-assembly-stream-active false))

(define (compiler-backend-peephole-asm-once [asm : String]) : String
  (let
    [n : i64 (string.string-length asm)]
    [asm-data : (Ptr u8)
      (unsafe
        (string-data asm))]
    [i : i64 0]
    [out : (text_buf_borrowed.TextBufBorrowed asm)
      (text_buf_borrowed.empty-like (& asm))]
    [has-pending : bool false]
    [pending : CompilerBackendPeepholeLine
      (compiler-backend-peephole-empty-line)]
    ;; SCAV2: was the last EMITTED line a noreturn abort call?
    [prev-abort? : bool false]
    [owners : CompilerBackendPeepholeOwners
      (compiler-backend-peephole-owners-empty)]
    (begin
      (compiler-backend-peephole-owner-global-reset!)
      (while (< i n)
        (let
          [end : i64 (compiler-backend-peephole-line-end asm-data i n)]
          [next-start : i64
            (if (< end n)
              (+ end 1)
              end)]
          [line-newline : bool (< end n)]
          (begin
            (if has-pending
              (let
                [line : CompilerBackendPeepholeLine
                  (compiler-backend-peephole-parse-line
                    asm
                    asm-data
                    i
                    end
                    line-newline
                    false)]
                [action : i64
                  (compiler-backend-peephole-pair-action-desc
                    asm
                    asm-data
                    pending
                    line)]
                (cond
                  [(= action 1)
                    (set! pending (compiler-backend-peephole-line-copy line))]
                  [(= action 2) unit]
                  [(= action 3)
                    (let
                      [forwarded-line : String
                        (compiler-backend-peephole-forward-frame-load-line-desc
                          pending
                          line)]
                      (begin
                        (let
                          [emit : (CompilerBackendPeepholeEmitResult asm)
                            (compiler-backend-peephole-emit-line-desc
                              out
                              asm
                              pending
                              owners
                              prev-abort?)]
                          (begin
                            (set! out (struct-get emit buf))
                            (set! owners (struct-get emit owners))))
                        (set! prev-abort? (struct-get pending noreturn-abort))
                        (set!
                          pending
                          (compiler-backend-peephole-owned-line
                            forwarded-line
                            line-newline))))]
                  [(= action 4)
                    (let
                      [folded-line : String
                        (compiler-backend-peephole-r10-base-fold-line-desc
                          pending
                          line)]
                      (set!
                        pending
                        (compiler-backend-peephole-owned-line
                          folded-line
                          line-newline)))]
                  [else
                    (begin
                      (let
                        [emit : (CompilerBackendPeepholeEmitResult asm)
                          (compiler-backend-peephole-emit-line-desc
                            out
                            asm
                            pending
                            owners
                            prev-abort?)]
                        (begin
                          (set! out (struct-get emit buf))
                          (set! owners (struct-get emit owners))))
                      (set! prev-abort? (struct-get pending noreturn-abort))
                      (set! pending (compiler-backend-peephole-line-copy line)))]))
              (begin
                (set! has-pending true)
                (set!
                  pending
                  (compiler-backend-peephole-line-copy
                    (compiler-backend-peephole-parse-line
                      asm
                      asm-data
                      i
                      end
                      line-newline
                      false)))))
            (set! i next-start))))
      (if (and
        has-pending
        (not (compiler-backend-peephole-line-self-move-desc? pending)))
        (let
          [emit : (CompilerBackendPeepholeEmitResult asm)
            (compiler-backend-peephole-emit-line-desc
              out
              asm
              pending
              owners
              prev-abort?)]
          (begin
            (set! out (struct-get emit buf))
            (set! owners (struct-get emit owners))))
        unit)
      (text_buf_borrowed.render out))))

(define (compiler-backend-peephole-asm-buffer [asm : String]) : text_buf.TextBuf
  ;; The streaming pass runs the complete rule set while each line pair and its
  ;; owner state are hot. Re-running it used to parse and copy the whole ~40MB
  ;; self-compile assembly again to remove only ~1% as many bytes as the first
  ;; pass (~10KB after ~910KB). Keep that marginal reapplication out of the
  ;; compile path; the missed cascades are optional code-size rewrites.
  ;; GAP5 then sweeps never-read local frame stores recorded during emission.
  (compiler-backend-deadstore-sweep-buffer
    (compiler-backend-peephole-asm-once asm)))

(define (compiler-backend-peephole-asm [asm : String]) : String
  (text_buf.render (compiler-backend-peephole-asm-buffer asm)))

(define (compiler-backend-peephole-text-buf [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (compiler-backend-peephole-asm-buffer (text_buf.render buf)))

(define (compiler-backend-emit-program-target-with-mode-raw-asm-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackend
  ;; Keep this helper arena-neutral: backend emission records global metadata
  ;; that the peephole consumes, so raw emission state must stay alive until the
  ;; peephole finishes. The caller scopes both raw output and peephole
  ;; intermediates together.
  (match (if crt-entry
    (compiler-backend-emit-program-target-with-mode-buffer-and-crt
      program
      target
      mode
      spans
      emit-entry
      crt-entry)
    (compiler-backend-emit-program-target-with-mode-buffer
      program
      target
      mode
      spans
      emit-entry))
    [(ResultCompilerBackendBuffer.Ok buf)
      (ResultCompilerBackend.Ok (text_buf.render buf))]
    [(ResultCompilerBackendBuffer.Err message)
      (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-program-target-with-mode-final-buffer-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendBuffer
  ;; Stream prefix/function/adapter/tail emission through peephole and sweep.
  ;; Each function's raw arena is rewound as soon as its final output chunk is
  ;; copied home, so the backend never retains the program's raw function text.
  (let
    [home-arena : arena.Arena (arena.current)]
    [emit-arena : arena.Arena (arena.make)]
    [raw-arena : arena.Arena (arena.make)]
    [peephole-arena : arena.Arena (arena.make)]
    (begin
      (unsafe
        (arena.set! raw-arena))
      (let
        [raw-mark : arena.ArenaMark (arena.mark)]
        (begin
          (unsafe
            (arena.set! peephole-arena))
          (let
            [peephole-mark : arena.ArenaMark (arena.mark)]
            (begin
              (unsafe
                (arena.set! emit-arena))
              (compiler-backend-assembly-stream-start!
                raw-arena
                raw-mark
                peephole-arena
                peephole-mark
                home-arena)
              (let
                [emitted : ResultCompilerBackendBuffer
                  (if crt-entry
                    (compiler-backend-emit-program-target-with-mode-buffer-and-crt
                      program
                      target
                      mode
                      spans
                      emit-entry
                      crt-entry)
                    (compiler-backend-emit-program-target-with-mode-buffer
                      program
                      target
                      mode
                      spans
                      emit-entry))]
                (match emitted
                  [(ResultCompilerBackendBuffer.Ok _)
                    (let
                      [final : text_buf.TextBuf
                        (compiler-backend-assembly-stream-finish!)]
                      (begin
                        (unsafe
                          (arena.destroy emit-arena))
                        (unsafe
                          (arena.destroy raw-arena))
                        (unsafe
                          (arena.set! home-arena))
                        (compiler-backend-deadstore-sweep-report-and-reset!)
                        (unsafe
                          (arena.destroy peephole-arena))
                        (compiler-backend-clear-scratch-escaped-emit-state!)
                        (ResultCompilerBackendBuffer.Ok final)))]
                  [(ResultCompilerBackendBuffer.Err message)
                    (begin
                      ;; Preserve arenas that may own the diagnostic, matching
                      ;; the legacy error lifetime contract.
                      (compiler-backend-assembly-stream-abort!)
                      (unsafe
                        (arena.set! home-arena))
                      (unsafe
                        (arena.destroy peephole-arena))
                      (compiler-backend-clear-scratch-escaped-emit-state!)
                      (ResultCompilerBackendBuffer.Err message))])))))))))

(define (compiler-backend-emit-program-target-with-mode-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackend
  (match (compiler-backend-emit-program-target-with-mode-final-buffer-and-crt
    program
    target
    mode
    spans
    emit-entry
    crt-entry)
    [(ResultCompilerBackendBuffer.Ok buf)
      (ResultCompilerBackend.Ok (text_buf.render buf))]
    [(ResultCompilerBackendBuffer.Err message)
      (ResultCompilerBackend.Err message)]))

(define (compiler-backend-emit-program-target-with-mode
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackend
  (compiler-backend-emit-program-target-with-mode-and-crt
    program
    target
    mode
    spans
    emit-entry
    false))

(define (compiler-backend-target-cfgs [target : CompilerBackendTarget]) : sym_i64_env.SymI64Env
  (match target
    [(CompilerBackendTarget.Linux)
      (compiler-cfg-enable
        (compiler-cfg-enable
          (compiler-cfg-enable
            (compiler-cfg-enable (compiler-cfg-empty) "linux")
            "unix")
          "target-linux")
        "os-linux")]
    [(CompilerBackendTarget.Windows)
      (compiler-cfg-enable
        (compiler-cfg-enable
          (compiler-cfg-enable (compiler-cfg-empty) "windows")
          "target-windows")
        "os-windows")]))

(define (compiler-backend-lower-mode-for-target
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]) : CompilerLowerMode
  (match mode
    [(CompilerBackendMode.Avx2)
      (match target
        [(CompilerBackendTarget.Linux) (CompilerLowerMode.LinuxAvx2)]
        [(CompilerBackendTarget.Windows) (CompilerLowerMode.WindowsAvx2)])]
    [(CompilerBackendMode.Avx512)
      (match target
        [(CompilerBackendTarget.Linux) (CompilerLowerMode.LinuxAvx512)]
        [(CompilerBackendTarget.Windows) (CompilerLowerMode.WindowsAvx512)])]
    [_
      (match target
        [(CompilerBackendTarget.Linux) (CompilerLowerMode.LinuxScalar)]
        [(CompilerBackendTarget.Windows) (CompilerLowerMode.WindowsScalar)])]))

(define (compiler-backend-lower-source-for-target
  [src : String]
  [target : CompilerBackendTarget]) : ResultCompilerLower
  (begin
    (ci.intern-reset!)
    (lower-reset-intern-owned-state!)
    (cbi.compiler-builtin-reset!)
    (match (parse-ast-source-diagnostic-with-cfg
      "<source>"
      src
      (compiler-backend-target-cfgs target))
      [(ResultAstProgramDiagnostic.Ok program)
        (lower-compiler-program-with-path-mode
          "<source>"
          program
          (compiler-backend-lower-mode-for-target
            target
            (CompilerBackendMode.Scalar)))]
      [(ResultAstProgramDiagnostic.Err diag) (ResultCompilerLower.Err diag)])))

(define (compiler-backend-emit-source [src : String]) : ResultCompilerBackend
  (match (lower-compiler-source src)
    [(ResultCompilerLower.Ok program spans)
      (compiler-backend-emit-program-linux-with-spans program spans)]
    [(ResultCompilerLower.Err diag) (ResultCompilerBackend.Err diag)]))

(define (compiler-backend-emit-source-for-target
  [src : String]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (match (compiler-backend-lower-source-for-target src target)
    [(ResultCompilerLower.Ok program spans)
      (compiler-backend-emit-program-with-spans-for-target program spans target)]
    [(ResultCompilerLower.Err diag) (ResultCompilerBackend.Err diag)]))

;; Inline-by-value aggregates are the always-on default lowering, so
;; emitting "in inline-aggregates mode" is just the ordinary target emit. The
;; explicit name is retained for the backend self-tests.
(define (compiler-backend-emit-source-inline-aggregates-for-target
  [src : String]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (compiler-backend-emit-source-for-target src target))

(define (compiler-backend-emit-source-object-image [src : String]) : ResultCompilerBackendObject
  (match (lower-compiler-source src)
    [(ResultCompilerLower.Ok program spans)
      (compiler-backend-emit-program-object-image-linux program spans)]
    [(ResultCompilerLower.Err diag) (ResultCompilerBackendObject.Err diag)]))

(define (compiler-backend-emit-source-object-image-for-target
  [src : String]
  [target : CompilerBackendTarget]) : ResultCompilerBackendObject
  (match (compiler-backend-lower-source-for-target src target)
    [(ResultCompilerLower.Ok program spans)
      (compiler-backend-emit-program-object-image-target
        program
        target
        spans
        true)]
    [(ResultCompilerLower.Err diag) (ResultCompilerBackendObject.Err diag)]))

(define (compiler-backend-string-prefix-at?
  [text : String]
  [prefix : String]
  [start : i64]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< start 0)
      false
      (if (> (+ start prefix-len) text-len)
        false
        (let
          [i : i64 0]
          [ok : bool true]
          (begin
            (while ok
              (if (< i prefix-len)
                (if (=
                  (string.string-ref text (+ start i))
                  (string.string-ref prefix i))
                  (set! i (+ i 1))
                  (set! ok false))
                (set! ok false)))
            (= i prefix-len)))))))

(define (compiler-backend-string-contains? [text : String] [needle : String]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      true
      (let
        [i : i64 0]
        [found : bool false]
        [done : bool false]
        (begin
          (while (not done)
            (if (<= (+ i needle-len) text-len)
              (if (compiler-backend-string-prefix-at? text needle i)
                (begin
                  (set! found true)
                  (set! done true))
                (set! i (+ i 1)))
              (set! done true)))
          found)))))

(define (compiler-backend-string-count [text : String] [needle : String]) : i64
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      0
      (let
        [i : i64 0]
        [count : i64 0]
        (begin
          (while (<= (+ i needle-len) text-len)
            (if (compiler-backend-string-prefix-at? text needle i)
              (begin
                (set! count (+ count 1))
                (set! i (+ i needle-len)))
              (set! i (+ i 1))))
          count)))))

(define compiler-backend-pic-image-base-label : String
  ".L_tl_pic_image_base")

(define (compiler-backend-string-find-from
  [text : String]
  [needle : String]
  [start : i64]) : i64
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      start
      (if (= needle-len 1)
        (string.index-of-byte
          (& text)
          start
          (cast (string.string-ref needle 0) : u8))
        (let
          [i : i64 start]
          [found : i64 -1]
          [done : bool false]
          (begin
            (while (not done)
              (if (<= (+ i needle-len) text-len)
                (if (compiler-backend-string-prefix-at? text needle i)
                  (begin
                    (set! found i)
                    (set! done true))
                  (set! i (+ i 1)))
                (set! done true)))
            found))))))

(define (compiler-backend-string-replace-all
  [text : String]
  [needle : String]
  [replacement : String]) : String
  (let
    [text-len : i64 (string.string-length text)]
    [needle-len : i64 (string.string-length needle)]
    (if (= needle-len 0)
      text
      (let
        [i : i64 0]
        [out : text_buf.TextBuf (text_buf.empty)]
        [done : bool false]
        (begin
          (while (not done)
            (let
              [pos : i64 (compiler-backend-string-find-from text needle i)]
              (if (< pos 0)
                (begin
                  (if (< i text-len)
                    (set!
                      out
                      (text_buf.append
                        out
                        (string.substring text i (- text-len i))))
                    unit)
                  (set! done true))
                (begin
                  (if (> pos i)
                    (set!
                      out
                      (text_buf.append out (string.substring text i (- pos i))))
                    unit)
                  (set! out (text_buf.append out replacement))
                  (set! i (+ pos needle-len))))))
          (text_buf.render out))))))

(define (compiler-backend-pic-quad-pattern [target : String]) : String
  (str_cat.str-cat "    .quad " target "\n"))

(define (compiler-backend-pic-quad-replacement [_target : String]) : String
  "    .quad 0\n")

(define (compiler-backend-pic-rewrite-target [asm : String] [target : String]) : String
  (compiler-backend-string-replace-all
    asm
    (compiler-backend-pic-quad-pattern target)
    (compiler-backend-pic-quad-replacement target)))

(define (compiler-backend-pic-rewrite-relocs
  [asm : String]
  [relocs : cobj.CompilerObjectRelocationList]) : String
  (let
    [count : i64 (cobj.compiler-object-relocation-list-count relocs)]
    [index : i64 0]
    [out : String asm]
    (begin
      (while (< index count)
        (begin
          (match (cobj.compiler-object-relocation-list-ref relocs index)
            [(cobj.CompilerObjectRelocation.Relocation _ _ kind target)
              (match kind
                [(cobj.CompilerObjectRelocationKind.Abs64)
                  (set! out (compiler-backend-pic-rewrite-target out target))]
                [_ unit])])
          (set! index (+ index 1))))
      out)))

(define (compiler-backend-pic-align-offset [offset : i64] [align : i64]) : i64
  (if (<= align 1)
    offset
    (let
      [rem : i64 (% offset align)]
      (if (= rem 0)
        offset
        (+ offset (- align rem))))))

(define (compiler-backend-pic-data-record-end-offset
  [record : cobj.CompilerObjectDataRecord]
  [offset : i64]) : i64
  (match record
    [(cobj.CompilerObjectDataRecord.Label _) offset]
    [(cobj.CompilerObjectDataRecord.Align align)
      (compiler-backend-pic-align-offset offset align)]
    [(cobj.CompilerObjectDataRecord.Bytes bytes)
      (+ offset (string.string-length bytes))]
    [(cobj.CompilerObjectDataRecord.String text)
      (+ offset (+ (string.string-length text) 1))]
    [(cobj.CompilerObjectDataRecord.F64 _) (+ offset 8)]
    [(cobj.CompilerObjectDataRecord.F32 _) (+ offset 4)]
    [(cobj.CompilerObjectDataRecord.I64 _) (+ offset 8)]
    [(cobj.CompilerObjectDataRecord.Zero count) (+ offset count)]
    [(cobj.CompilerObjectDataRecord.SymbolAddress _) (+ offset 8)]
    [(cobj.CompilerObjectDataRecord.SymbolRva32 _) (+ offset 4)]))

(define (compiler-backend-pic-data-label-offset-from
  [records : cobj.CompilerObjectDataRecordList]
  [label : String]
  [offset : i64]) : i64
  (let
    [count : i64 (cobj.compiler-object-data-record-list-count records)]
    [index : i64 0]
    [cur-offset : i64 offset]
    [result : i64 -1]
    [done : bool false]
    (begin
      (while (and (not done) (< index count))
        (let
          [record : cobj.CompilerObjectDataRecord
            (cobj.compiler-object-data-record-list-ref records index)]
          (match record
            [(cobj.CompilerObjectDataRecord.Label found)
              (if (string.eq found label)
                (begin
                  (set! result cur-offset)
                  (set! done true))
                (set! index (+ index 1)))]
            [_
              (begin
                (set!
                  cur-offset
                  (compiler-backend-pic-data-record-end-offset
                    record
                    cur-offset))
                (set! index (+ index 1)))])))
      result)))

(define (compiler-backend-pic-section-label-offset
  [image : cobj.CompilerObjectImage]
  [kind : cobj.CompilerObjectSectionKind]
  [label : String]) : i64
  (match (cobj.compiler-object-section-list-find
    (struct-get image sections)
    kind)
    [(cobj.CompilerObjectSection.Section _ data _)
      (match kind
        [(cobj.CompilerObjectSectionKind.Text) -1]
        [_ (compiler-backend-pic-data-label-offset-from data label 0)])]))

(define (compiler-backend-pic-section-name
  [kind : cobj.CompilerObjectSectionKind]) : String
  (match kind
    [(cobj.CompilerObjectSectionKind.Text) "text"]
    [(cobj.CompilerObjectSectionKind.Data) "data"]
    [(cobj.CompilerObjectSectionKind.Rodata) "rodata"]
    [(cobj.CompilerObjectSectionKind.Bss) "bss"]
    [(cobj.CompilerObjectSectionKind.Pdata) "pdata"]
    [(cobj.CompilerObjectSectionKind.Xdata) "xdata"]
    [(cobj.CompilerObjectSectionKind.Rsrc) "rsrc"]))

(define (compiler-backend-pic-fixup-line
  [section : cobj.CompilerObjectSectionKind]
  [offset : i64]
  [site : String]
  [target : String]) : String
  (string.append
    (str_cat.str-cat
      (compiler-backend-pic-section-name section)
      " "
      (string.int->string offset)
      " "
      site)
    (string.append " " (string.append target "\n"))))

(define (compiler-backend-pic-fixup-table-relocs
  [image : cobj.CompilerObjectImage]
  [relocs : cobj.CompilerObjectRelocationList]
  [buf : text_buf.TextBuf]) : text_buf.TextBuf
  (let
    [count : i64 (cobj.compiler-object-relocation-list-count relocs)]
    [index : i64 0]
    [out : text_buf.TextBuf buf]
    (begin
      (while (< index count)
        (begin
          (match (cobj.compiler-object-relocation-list-ref relocs index)
            [(cobj.CompilerObjectRelocation.Relocation section site kind target)
              (match kind
                [(cobj.CompilerObjectRelocationKind.Abs64)
                  (let
                    [offset : i64
                      (compiler-backend-pic-section-label-offset
                        image
                        section
                        site)]
                    (if (>= offset 0)
                      (set!
                        out
                        (text_buf.append
                          out
                          (compiler-backend-pic-fixup-line
                            section
                            offset
                            site
                            target)))
                      unit))]
                [_ unit])])
          (set! index (+ index 1))))
      out)))

(define (compiler-backend-pic-fixup-table [image : cobj.CompilerObjectImage]) : String
  (text_buf.render
    (compiler-backend-pic-fixup-table-relocs
      image
      (struct-get image relocations)
      (text_buf.append (text_buf.empty) "typelisp-pic-fixups v1\n"))))

(define (compiler-backend-pic-symbols-have-extern?
  [symbols : cobj.CompilerObjectSymbolList]) : bool
  (let
    [count : i64 (cobj.compiler-object-symbol-list-count symbols)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (cobj.compiler-object-symbol-list-ref symbols index)
          [(cobj.CompilerObjectSymbol.Symbol _ binding _ _)
            (match binding
              [(cobj.CompilerObjectSymbolBinding.Extern) (set! found true)]
              [_ (set! index (+ index 1))])]))
      found)))

(define (compiler-backend-pic-target-symbol-internal?
  [symbols : cobj.CompilerObjectSymbolList]
  [target : String]) : bool
  (let
    [count : i64 (cobj.compiler-object-symbol-list-count symbols)]
    [index : i64 0]
    [result : bool false]
    [done : bool false]
    (begin
      (while (and (not done) (< index count))
        (match (cobj.compiler-object-symbol-list-ref symbols index)
          [(cobj.CompilerObjectSymbol.Symbol name binding _ section)
            (if (string.eq name target)
              (begin
                (set!
                  result
                  (match binding
                    [(cobj.CompilerObjectSymbolBinding.Extern) false]
                    [_
                      (match section
                        [(cobj.CompilerObjectMaybeSection.No) false]
                        [_ true])]))
                (set! done true))
              (set! index (+ index 1)))]))
      result)))

(define (compiler-backend-pic-reloc-site-valid?
  [image : cobj.CompilerObjectImage]
  [reloc : cobj.CompilerObjectRelocation]) : bool
  (match reloc
    [(cobj.CompilerObjectRelocation.Relocation section site kind target)
      (match kind
        [(cobj.CompilerObjectRelocationKind.Abs64)
          (and
            (compiler-backend-pic-target-symbol-internal?
              (struct-get image symbols)
              target)
            (match section
              [(cobj.CompilerObjectSectionKind.Data)
                (let
                  [offset : i64
                    (compiler-backend-pic-section-label-offset
                      image
                      section
                      site)]
                  (and (>= offset 0) (= (% offset 8) 0)))]
              [(cobj.CompilerObjectSectionKind.Rodata)
                (let
                  [offset : i64
                    (compiler-backend-pic-section-label-offset
                      image
                      section
                      site)]
                  (and (>= offset 0) (= (% offset 8) 0)))]
              [_ false]))]
        [_ true])]))

(define (compiler-backend-pic-relocs-valid?
  [image : cobj.CompilerObjectImage]
  [relocs : cobj.CompilerObjectRelocationList]) : bool
  (let
    [count : i64 (cobj.compiler-object-relocation-list-count relocs)]
    [index : i64 0]
    [ok : bool true]
    (begin
      (while (and ok (< index count))
        (if (compiler-backend-pic-reloc-site-valid?
          image
          (cobj.compiler-object-relocation-list-ref relocs index))
          (set! index (+ index 1))
          (set! ok false)))
      ok)))

(define (compiler-backend-pic-asm
  [asm : String]
  [image : cobj.CompilerObjectImage]) : String
  (string.append
    (str_cat.str-cat ".text\n" compiler-backend-pic-image-base-label ":\n")
    (compiler-backend-pic-rewrite-relocs asm (struct-get image relocations))))

(define (compiler-backend-emit-program-pic-target-with-mode-and-crt
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]
  [crt-entry : bool]) : ResultCompilerBackendPic
  (match (compiler-backend-emit-program-target-with-mode-buffer-and-crt
    program
    target
    mode
    spans
    emit-entry
    crt-entry)
    [(ResultCompilerBackendBuffer.Ok buf)
      (match (compiler-backend-emit-program-object-image-target-with-mode-and-crt
        program
        target
        mode
        spans
        emit-entry
        crt-entry)
        [(ResultCompilerBackendObject.Ok image)
          (if (compiler-backend-pic-symbols-have-extern?
            (struct-get image symbols))
            (ResultCompilerBackendPic.Err
              (box
                (compiler-diagnostic-at-start
                  ""
                  "backend: --pic supports only internal references; extern symbols are not supported")))
            (if (compiler-backend-pic-relocs-valid?
              image
              (struct-get image relocations))
              (ResultCompilerBackendPic.Ok
                (CompilerBackendPicOutput
                  (compiler-backend-pic-asm
                    (compiler-backend-peephole-asm (text_buf.render buf))
                    image)
                  (compiler-backend-pic-fixup-table image)))
              (ResultCompilerBackendPic.Err
                (box
                  (compiler-diagnostic-at-start
                    ""
                    "backend: --pic could not map every absolute pointer fixup to an 8-byte data slot")))))]
        [(ResultCompilerBackendObject.Err diag)
          (ResultCompilerBackendPic.Err diag)])]
    [(ResultCompilerBackendBuffer.Err diag) (ResultCompilerBackendPic.Err diag)]))

(define (compiler-backend-emit-program-pic-target-with-mode
  [program : CompilerIrProgram]
  [target : CompilerBackendTarget]
  [mode : CompilerBackendMode]
  [spans : CompilerSourceSpans]
  [emit-entry : bool]) : ResultCompilerBackendPic
  (compiler-backend-emit-program-pic-target-with-mode-and-crt
    program
    target
    mode
    spans
    emit-entry
    false))

(define (compiler-backend-emit-source-pic-for-target
  [src : String]
  [target : CompilerBackendTarget]) : ResultCompilerBackendPic
  (match (compiler-backend-lower-source-for-target src target)
    [(ResultCompilerLower.Ok program spans)
      (compiler-backend-emit-program-pic-target-with-mode
        program
        target
        (CompilerBackendMode.Scalar)
        spans
        true)]
    [(ResultCompilerLower.Err diag) (ResultCompilerBackendPic.Err diag)]))

(define (compiler-backend-emit-source-pic-linux [src : String]) : ResultCompilerBackendPic
  (compiler-backend-emit-source-pic-for-target
    src
    (CompilerBackendTarget.Linux)))

(define (compiler-backend-runtime-helper-externs) : CompilerIrExternList
  (compiler-ir-extern-cons
    (compiler-ir-extern-default "tl_alloc" (AstType.I64))
    (compiler-ir-extern-cons
      (compiler-ir-extern-default "tl_substring" (AstType.I64))
      (compiler-ir-extern-cons
        (compiler-ir-extern-default "tl_string_concat" (AstType.I64))
        (compiler-ir-extern-cons
          (compiler-ir-extern-default "tl_int_to_string" (AstType.String))
          CompilerIrExternList.Nil)))))

(define (compiler-backend-runtime-helper-program) : CompilerIrProgram
  (CompilerIrProgram.Program
    CompilerIrGlobalList.Nil
    (compiler-ir-function-cons
      (CompilerIrFunction.Function
        "main"
        CompilerIrParamList.Nil
        (AstType.I64)
        4
        (compiler-ir-block-cons
          (compiler-ir-block
            "entry"
            (compiler-ir-instr-cons
              (CompilerIrInstr.Call
                0
                "tl_alloc"
                (CompilerIrCallArgs.One (CompilerIrValue.I64 8))
                (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.Call
                  1
                  "tl_substring"
                  (compiler-ir-call-args-from-list
                    (compiler-ir-value-cons
                      (CompilerIrValue.I64 0)
                      (compiler-ir-value-cons
                        (CompilerIrValue.I64 0)
                        (compiler-ir-value-cons
                          (CompilerIrValue.I64 0)
                          CompilerIrValueList.Nil))))
                  (AstType.I64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Call
                    2
                    "tl_string_concat"
                    (compiler-ir-call-args-from-list
                      (compiler-ir-value-cons
                        (CompilerIrValue.I64 0)
