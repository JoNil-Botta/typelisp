;; compiler_backend.tl - Selfhost CompilerIrProgram -> x86_64 .s emitter.
(cfg (any compile-profile regalloc-census scavenge-census) (import stdlib.io))
(cfg compile-profile (import stdlib.profile))
(cfg compile-profile-summary (import compiler_profile_summary as cps))
(import "compiler_lower.tl")
(import compiler_builtin_ids as cbi)
(import "compiler_diagnostic.tl")
(import "compiler_optimize.tl")
(import "compiler_abi.tl")
(import "compiler_regalloc.tl")
(import compiler_parallel_move as pmove)
(import stdlib.text_buf)
(import stdlib.text_buf_borrowed)
(import compiler_object as cobj)
(import compiler_intern as ci)
(import sym_i64_env)
(import stdlib.array)
(import stdlib.arena)
(import stdlib.hash)
(import stdlib.hashmap)
(import (hashmap String i64) as backend_string_i64_map)
(import (hashmap i64 i64) as backend_i64_i64_map)
(import stdlib.string)
(import stdlib.byte_buf_core)
(import stdlib.str_cat_runtime as str_cat)
(import stdlib.option)
(import (option i64) as option_i64)

(cfg
  feature-tl-memchr
  (unsafe
    (extern (compiler-backend-runtime-index-of-byte
      [ptr : (Ptr u8)]
      [len : i64]
      [byte : u8]) : i64 (:symbol "tl_memchr"))))

(cfg
  compile-profile
  (define compiler-backend-profile-start-ms : i64
    0))
(cfg
  compile-profile
  (define compiler-backend-profile-start-total : i64
    0))
(cfg
  compile-profile
  (define compiler-backend-profile-start-live : i64
    0))
(cfg
  compile-profile
  (define compiler-backend-profile-detail-start-ms : i64
    0))

(cfg
  compile-profile-summary
  (define (compiler-backend-profile-summary-reset!) : unit
    unit))

(cfg
  compile-profile-summary
  (define (compiler-backend-profile-summary-emit) : unit
    (begin
      (cps.compiler-profile-summary-emit
        cps.compiler-profile-summary-backend-function
        "backend"
        "function")
      (cps.compiler-profile-summary-emit
        cps.compiler-profile-summary-backend-module
        "backend"
        "module"))))

(cfg
  compile-profile
  (define (compiler-backend-profile-field [value : i64]) : String
    (string.append "|" (string.int->string value))))

(cfg
  compile-profile
  (define (compiler-backend-profile-start) : unit
    (begin
      (set! compiler-backend-profile-start-ms (profile.now-ms))
      (set! compiler-backend-profile-start-total (profile.alloc-total))
      (set! compiler-backend-profile-start-live (profile.alloc-live))
      (profile.alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-backend-profile-finish [phase : String]) : unit
    (let
      [end-ms : i64 (profile.now-ms)]
      [end-total : i64 (profile.alloc-total)]
      [end-live : i64 (profile.alloc-live)]
      [peak-delta : i64
        (- (profile.alloc-peak) compiler-backend-profile-start-live)]
      (io.print-error
        (string.append
          "compile-profile|backend."
          (string.append
            phase
            (string.append
              (compiler-backend-profile-field
                (- end-ms compiler-backend-profile-start-ms))
              (string.append
                (compiler-backend-profile-field
                  (- end-total compiler-backend-profile-start-total))
                (string.append
                  (compiler-backend-profile-field
                    (- end-live compiler-backend-profile-start-live))
                  (string.append
                    (compiler-backend-profile-field peak-delta)
                    "\n"))))))))))

(cfg
  compile-profile
  (define (compiler-backend-profile-detail-start) : unit
    (set! compiler-backend-profile-detail-start-ms (profile.now-ms))))

(cfg
  compile-profile
  (define (compiler-backend-profile-detail-finish
    [phase : String]
    [name : String]) : unit
    (let
      [elapsed : i64
        (- (profile.now-ms) compiler-backend-profile-detail-start-ms)]
      (cfg
        compile-profile-summary
        (if (string.eq phase "function")
          (begin
            (cps.compiler-profile-summary-note!
              cps.compiler-profile-summary-backend-function
              name
              elapsed)
            (cps.compiler-profile-summary-note-module!
              cps.compiler-profile-summary-backend-module
              name
              elapsed))
          unit)
        (if (>= elapsed 1)
          (io.print-error
            (string.append
              "compile-profile-detail|backend."
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string elapsed)
                    (string.append "|" (string.append name "\n")))))))
          unit)))))

(cfg
  compile-profile
  (define (compiler-backend-profile-function-name [func : CompilerIrFunction]) : String
    (match func
      [(CompilerIrFunction.Function name _ _ _ _) name])))

(defenum ResultBackendReg
