    cmpq 24(%r8), %r10
    ja .L_tl_alloc_new_arena_entry
    cmpq 64(%r8), %r10
    ja .L_tl_alloc_commit_arena_entry
    movq %r10, 16(%r8)
"
      fast-profile
      "    ret
.L_tl_alloc_win_atomic:
    movq 56(%r9), %r8
    movq 16(%r8), %rax
