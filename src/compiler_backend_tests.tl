(define (compiler-backend-test-reg-assignment-list-from
  [regs : (Array i64)]
  [index : i64]) : compiler_regalloc.CompilerRegAssignmentList
  (if (>= index (array-length regs))
    compiler_regalloc.CompilerRegAssignmentList.Nil
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        index
        (compiler_regalloc.CompilerRegLocation.Register (array-ref regs index)))
      (compiler-backend-test-reg-assignment-list-from regs (+ index 1)))))

(define (compiler-backend-test-fill-live-range!
  [starts : (Array i64)]
  [ends : (Array i64)]
  [count : i64]
  [start : i64]
  [end : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! starts i start)
          (array-set! ends i end)
          (set! i (+ i 1))))
      unit)))

(define (compiler-backend-scavenge-special-reg-bit-map-ok?) : bool
  (let
    [rax : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%rax")]
    [rsi : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%rsi")]
    [rdi : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%rdi")]
    (and
      (not (= rax 0))
      (not (= rsi 0))
      (not (= rdi 0))
      (not (= rax rsi))
      (not (= rax rdi))
      (not (= rsi rdi))
      (=
        (compiler_backend.compiler-backend-scavenge-reg-bit "%xmm2")
        (compiler_backend.compiler-backend-scavenge-reg-bit "%vec2"))
      (=
        (compiler_backend.compiler-backend-scavenge-reg-bit "%xmm3")
        (compiler_backend.compiler-backend-scavenge-reg-bit "%ymm3"))
      (=
        (compiler_backend.compiler-backend-scavenge-reg-bit "%xmm4")
        (compiler_backend.compiler-backend-scavenge-reg-bit "%zmm4"))
      (= (compiler_backend.compiler-backend-scavenge-reg-bit-by-index 15) rax)
      (= (compiler_backend.compiler-backend-scavenge-reg-bit-by-index 16) rsi)
      (= (compiler_backend.compiler-backend-scavenge-reg-bit-by-index 17) rdi))))

(define (compiler-backend-emergency-vector-width-ok?) : bool
  (let
    [prev-mode : compiler_backend.CompilerBackendMode
      (compiler_backend.compiler-backend-test-get-compiler-backend-current-mode)]
    [prev-pending : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-pending)]
    [prev-reg : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-reg)]
    [prev-used : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-used)]
    [prev-pending-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-pending-count)]
    [prev-used-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-used-count)]
    [prev-reg0 : i64
      (array-ref
        (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-regs)
        0)]
    [prev-slot : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-slot-offset)]
    [prev-suppressed : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-restore-suppressed)]
    [_init : unit
      (begin
        (compiler_backend.compiler-backend-set-current-mode!
          (compiler_backend.CompilerBackendMode.Avx2))
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending!
          false)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used!
          false)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending-count!
          0)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used-count!
          0)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-slot-offset!
          -512)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-restore-suppressed!
          false)
        (compiler_backend.compiler-backend-emergency-add! "%xmm2"))]
    [avx2 : String
      (compiler_backend.compiler-backend-emergency-wrap "    nop\n")]
    [_avx512-init : unit
      (begin
        (compiler_backend.compiler-backend-set-current-mode!
          (compiler_backend.CompilerBackendMode.Avx512))
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending!
          false)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending-count!
          0)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-restore-suppressed!
          false)
        (compiler_backend.compiler-backend-emergency-add! "%xmm3"))]
    [avx512 : String
      (compiler_backend.compiler-backend-emergency-wrap "    nop\n")]
    [ok : bool
      (and
        (= (compiler_backend.compiler-backend-emergency-frame-extra 2) 128)
        (= (compiler_backend.compiler-backend-emergency-reg-offset 1) -576)
        (compiler_backend.compiler-backend-string-contains?
          avx2
          "    vmovdqu %ymm2, -512(%rbp)\n")
        (compiler_backend.compiler-backend-string-contains?
          avx2
          "    vmovdqu -512(%rbp), %ymm2\n")
        (compiler_backend.compiler-backend-string-contains?
          avx512
          "    vmovdqu64 %zmm3, -512(%rbp)\n")
        (compiler_backend.compiler-backend-string-contains?
          avx512
          "    vmovdqu64 -512(%rbp), %zmm3\n"))]
    [_restore : unit
      (begin
        (compiler_backend.compiler-backend-set-current-mode! prev-mode)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending!
          prev-pending)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-reg!
          prev-reg)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used!
          prev-used)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending-count!
          prev-pending-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used-count!
          prev-used-count)
        (array-set!
          (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-regs)
          0
          prev-reg0)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-slot-offset!
          prev-slot)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-restore-suppressed!
          prev-suppressed))]
    ok))

(define (compiler-backend-scavenge-widened-pool-picks-rsi-ok?) : bool
  (let
    [prev-win64 : bool (compiler_backend.compiler-backend-current-fn-win64?)]
    [regs : (Array i64) (make-array i64 13)]
    [starts : (Array i64) (make-array i64 13)]
    [ends : (Array i64) (make-array i64 13)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      compiler_regalloc.CompilerRegAssignmentList.Nil]
    [picked : String ""]
    [ok : bool false]
    (begin
      (array-set! regs 0 compiler_abi.compiler-reg-id-r9)
      (array-set! regs 1 compiler_abi.compiler-reg-id-rcx)
      (array-set! regs 2 compiler_abi.compiler-reg-id-rdx)
      (array-set! regs 3 compiler_abi.compiler-reg-id-r10)
      (array-set! regs 4 compiler_abi.compiler-reg-id-r11)
      (array-set! regs 5 compiler_abi.compiler-reg-id-r8)
      (array-set! regs 6 compiler_abi.compiler-reg-id-r12)
      (array-set! regs 7 compiler_abi.compiler-reg-id-r13)
      (array-set! regs 8 compiler_abi.compiler-reg-id-r14)
      (array-set! regs 9 compiler_abi.compiler-reg-id-r15)
      (array-set! regs 10 compiler_abi.compiler-reg-id-rbx)
      (array-set! regs 11 compiler_abi.compiler-reg-id-rdi)
      (array-set! regs 12 compiler_abi.compiler-reg-id-rax)
      (compiler-backend-test-fill-live-range! starts ends 13 0 10)
      (set! assignments (compiler-backend-test-reg-assignment-list-from regs 0))
      (compiler_backend.compiler-backend-set-current-fn-linux!)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending!
        false)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used!
        false)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending-count!
        0)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used-count!
        0)
      (set!
        picked
        (compiler-backend-scavenge-pick
          starts
          ends
          (compiler_regalloc.compiler-reg-assignment-index-build assignments 13)
          13
          4
          (array.make-array String 0)
          0
          "%r8"))
      (set!
        ok
        (and
          (string.eq picked "%rsi")
          (not
            (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-pending))
          (not
            (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-used))
          (=
            (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-pending-count)
            0)
          (=
            (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-used-count)
            0)))
      (if prev-win64
        (compiler_backend.compiler-backend-set-current-fn-win64!)
        (compiler_backend.compiler-backend-set-current-fn-linux!))
      ok)))

(define (compiler-backend-scavenge-win64-rsi-rdi-plan-mask-ok?) : bool
  (let
    [prev-win64 : bool (compiler_backend.compiler-backend-current-fn-win64?)]
    [rsi-bit : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%rsi")]
    [rdi-bit : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%rdi")]
    [linux-ok : bool false]
    [win64-ok : bool false]
    (begin
      (compiler_backend.compiler-backend-set-current-fn-linux!)
      (set!
        linux-ok
        (and
          (compiler_backend.compiler-backend-scavenge-candidate-ok?
            0
            0
            0
            compiler_abi.compiler-reg-id-rsi)
          (compiler_backend.compiler-backend-scavenge-candidate-ok?
            0
            0
            0
            compiler_abi.compiler-reg-id-rdi)))
      (compiler_backend.compiler-backend-set-current-fn-win64!)
      (set!
        win64-ok
        (and
          (not
            (compiler_backend.compiler-backend-scavenge-candidate-ok?
              0
              0
              0
              compiler_abi.compiler-reg-id-rsi))
          (not
            (compiler_backend.compiler-backend-scavenge-candidate-ok?
              0
              0
              0
              compiler_abi.compiler-reg-id-rdi))
          (compiler_backend.compiler-backend-scavenge-candidate-ok?
            0
            0
            rsi-bit
            compiler_abi.compiler-reg-id-rsi)
          (compiler_backend.compiler-backend-scavenge-candidate-ok?
            0
            0
            rdi-bit
            compiler_abi.compiler-reg-id-rdi)))
      (if prev-win64
        (compiler_backend.compiler-backend-set-current-fn-win64!)
        (compiler_backend.compiler-backend-set-current-fn-linux!))
      (and linux-ok win64-ok))))

(define (compiler-backend-scratch-vreg-call-target-test-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.compiler-ir-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.CallIndirectC
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrCallArgs.Nil)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          ;; Give the pre-existing %r12 home a real, non-overlapping interval.
          ;; Interval-less assignments conservatively interfere with every
          ;; scratch request and would make this forcing fixture test fallback.
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 7)
            (compiler_ast_types.AstType.I64))
          compiler_ir_types.CompilerIrInstrList.Nil)))
    compiler_ir_types.CompilerIrBlockList.Nil))

