(define (compiler-backend-vector-shuffle-ok?) : bool
  (and
    (compiler-backend-shuffle-asm-contains?
      "(define (f [xs : (Array i64)] [out : (Array i64)] [n : i64]) : unit (foreach ([i : i64 0 n]) (array-set! out i (spmd-shuffle (array-ref xs i) (program-index)))))"
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "    vpermd "
      "    shll $1, ")
    (compiler-backend-shuffle-asm-contains?
      "(define (f [xs : (Array i32)] [out : (Array i32)] [n : i64]) : unit (foreach ([i : i64 0 n]) (array-set! out i (spmd-shuffle (array-ref xs i) (program-index)))))"
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "    vpermd "
      "%rsp), %ymm0, %ymm")
    (compiler-backend-shuffle-asm-contains?
      "(define (f [xs : (Array f64)] [out : (Array f64)] [n : i64]) : unit (foreach ([i : i64 0 n]) (array-set! out i (spmd-shuffle (array-ref xs i) (program-index)))))"
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      "    vpermq "
      "%zmm")
    (compiler-backend-shuffle-asm-contains?
      "(define (f [xs : (Array f32)] [out : (Array f32)] [n : i64]) : unit (foreach ([i : i64 0 n]) (array-set! out i (spmd-shuffle (array-ref xs i) (program-index)))))"
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      "    vpermd "
      "%zmm")))

(define (compiler-backend-avx2-vector-reduce-ok?) : bool
  (and
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64]) : i64 (spmd-reduce sum ([i : i64 0 n]) 0 (array-ref xs i)))"
      "    vpaddq "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i32)] [n : i64]) : i32 (spmd-reduce sum ([i : i64 0 n]) (cast 0 : i32) (array-ref xs i)))"
      "    vpaddd "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i32)] [n : i64] [seed : i32]) : i32 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpminsd "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i32)] [n : i64] [seed : i32]) : i32 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpmaxsd "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array f64)] [n : i64]) : f64 (spmd-reduce sum ([i : i64 0 n]) 0.0 (array-ref xs i)))"
      "    vaddpd "
      "    vextractf128 $1, "
      "    vaddsd "
      "    movsd %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array f32)] [n : i64]) : f32 (spmd-reduce sum ([i : i64 0 n]) (cast 0.0 : f32) (array-ref xs i)))"
      "    vaddps "
      "    vextractf128 $1, "
      "    vaddss "
      "    movss %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpcmpgtq "
      "    vextracti128 $1, "
      "    vpblendvb "
      "    vmovq %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpcmpgtq "
      "    vextracti128 $1, "
      "    vpblendvb "
      "    vmovq %xmm2, ")
    (compiler-backend-bool-reduce-asm-contains?
      "(define (f [xs : (Array bool)] [n : i64]) : bool (spmd-reduce all ([i : i64 0 n]) true (array-ref xs i)))"
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "    vpmovmskb "
      "    sete %al\n"
      "%ymm")
    (compiler-backend-bool-reduce-asm-contains?
      "(define (f [xs : (Array bool)] [n : i64]) : bool (spmd-reduce any ([i : i64 0 n]) false (array-ref xs i)))"
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "    vpmovmskb "
      "    setne %al\n"
      "%ymm")))

(define (compiler-backend-avx512-reduce-asm-contains?
  [src : String]
  [op : String]
  [extract : String]
  [horizontal : String]
  [store : String]) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    src
    (compiler_lower.CompilerLowerMode.Avx512))
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        (compiler_backend.CompilerBackendMode.Avx512)
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.backend-and8
              (compiler_backend.compiler-backend-string-contains? asm extract)
              (compiler_backend.compiler-backend-string-contains?
                asm
                horizontal)
              (compiler_backend.compiler-backend-string-contains? asm op)
              (compiler_backend.compiler-backend-string-contains? asm store)
              (compiler_backend.compiler-backend-string-contains? asm "%zmm")
              (compiler_backend.compiler-backend-string-contains? asm "%ymm")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "spmd_reduce_avx2")
              true)
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "vector/mask IR emission is not implemented")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-avx512-vector-reduce-i64-minmax-ok?) : bool
  (and
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpminsq "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpmaxsq "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")))

(define (compiler-backend-avx512-vector-reduce-ok?) : bool
  (and
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64]) : i64 (spmd-reduce sum ([i : i64 0 n]) 0 (array-ref xs i)))"
      "    vpaddq "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
