    true
    true))

(define (compiler-backend-scalar-div-mod-source) : String
  "(define (div64 [a : i64] [b : i64]) : i64 (/ a b))
(define (mod64 [a : i64] [b : i64]) : i64 (% a b))
(define (main) : i64
  (+ (div64 42 6) (mod64 22 7)))")

(define (compiler-backend-scalar-div-mod-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-scalar-div-mod-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and8
        (compiler-backend-string-contains?
          asm
          "    testq %r8, %r8\n    jne 1f\n    call tl_div_abort\n1:\n")
        (compiler-backend-string-contains?
          asm
          "    cmpq %r10, %rax\n    jne 1f\n")
        (compiler-backend-string-contains?
          asm
          "    cmpq %r9, %r8\n    jne 1f\n    call tl_div_abort\n1:\n")
        (compiler-backend-string-contains? asm "    cqto\n")
        (compiler-backend-string-contains? asm "    idivq %r8\n")
        (compiler-backend-string-contains? asm "    movq %rdx, %rax\n")
        (not (compiler-backend-string-contains? asm ".globl tl_div_abort\n"))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-constant-divisor-strength-source) : String
  "(define (sdiv3 [a : i64]) : i64 (/ a 3))
(define (smod-prime [a : i64]) : i64 (% a 1000000007))
(define (udiv3 [a : u64]) : u64 (/ a (cast 3 : u64)))
(define (umod8 [a : u64]) : u64 (% a (cast 8 : u64)))
(define (udiv-high [a : u64]) : u64 (/ a (cast -2 : u64)))
(define (main) : i64
  (+ (sdiv3 -10)
    (+ (smod-prime -10)
      (+ (cast (udiv3 (cast 42 : u64)) : i64)
        (+ (cast (umod8 (cast 42 : u64)) : i64)
          (cast (udiv-high (cast -1 : u64)) : i64))))))")

(define (compiler-backend-constant-divisor-strength-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-constant-divisor-strength-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and8
        (compiler-backend-string-contains?
          asm
          "    movabsq $6148914691236517206, %r8\n    imulq %r8\n")
        (compiler-backend-string-contains?
          asm
          "    movabsq $-8543223828751151131, %r8\n    imulq %r8\n")
        (compiler-backend-string-contains?
          asm
          "    movabsq $-6148914691236517205, %r8\n    mulq %r8\n")
        ;; M-F folds the power-of-2 modulo mask into an immediate `andq`
        ;; (was `movabsq $7, %r8; andq %r8, %rax`).
        (compiler-backend-string-contains? asm "    andq $7, %rax\n")
        (not (compiler-backend-string-contains? asm "    idivq %r8\n"))
        (not (compiler-backend-string-contains? asm "    divq %r8\n"))
        (not (compiler-backend-string-contains? asm "    call tl_div_abort\n"))
        (and
          (not (compiler-backend-string-contains? asm ".extern tl_div_abort\n"))
          (not (compiler-backend-string-contains? asm ".globl tl_div_abort\n"))
          (not
            (compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker)))))]
    [(ResultCompilerBackend.Err _) false]))

;; Signed i64 magic div/mod must keep the pre-shift quotient sign in %rax and
;; retain the dividend in one non-fixed SRC register. This exact remainder
;; expansion is the nine-instruction Clang shape used by the VM hot arm.
(define (compiler-backend-signed-constant-divisor-clang-shape-ok?) : bool
  (let
    [magic : i64 -8543223828751151131]
    [reg-asm : String
      (compiler-backend-signed-magic-divmod-src-asm
        1000000007
        false
        true
        "%r8"
        "%r10"
        "%r10"
        (CompilerBackendConstHoistHomeReg "%r8" magic false))]
    [frame-asm : String
      (compiler-backend-signed-magic-divmod-src-asm
        1000000007
        false
        true
        "%r8"
        "%r10"
        "%r10"
        (CompilerBackendConstHoistHomeFrame "-40(%rbp)" magic))]
    (and
      (string.eq
        reg-asm
        "    movq %r10, %rax\n    imulq %r8\n    addq %r10, %rdx\n    movq %rdx, %rax\n    shrq $63, %rax\n    sarq $29, %rdx\n    addq %rax, %rdx\n    imulq $1000000007, %rdx, %rax\n    subq %rax, %r10\n")
      (string.eq
        frame-asm
        "    movq %r10, %rax\n    imulq -40(%rbp)\n    addq %r10, %rdx\n    movq %rdx, %rax\n    shrq $63, %rax\n    sarq $29, %rdx\n    addq %rax, %rdx\n    imulq $1000000007, %rdx, %rax\n    subq %rax, %r10\n")
      (not (compiler-backend-string-contains? reg-asm "sarq $63"))
      (not (compiler-backend-string-contains? reg-asm "subq %r9, %rdx")))))

;; Exercise the adjacent producer/result forwarding at the IR emission layer,
;; where fixed allocator homes can make both otherwise-redundant copies
;; deterministic.  The local context wrapper keeps the scratch/liveness and
;; Gep-fold globals hermetic: this predicate is also run after tests that seed
;; those tables deliberately.
(define (compiler-backend-divmod-polish-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r13"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%rdx"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            3
            (CompilerRegLocation.Register "%rax"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              4
              (CompilerRegLocation.Register "%rdi"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                5
                (CompilerRegLocation.Register "%rsi"))
              (compiler-reg-assignment-cons
                (CompilerRegAssignment.Assignment
                  6
                  (CompilerRegLocation.Register "%r10"))
                (compiler-reg-assignment-cons
                  (CompilerRegAssignment.Assignment
                    7
                    (CompilerRegLocation.Register "%r14"))
                  CompilerRegAssignmentList.Nil)))))))))

(define (compiler-backend-divmod-polish-instrs
  [multi-use-result : bool]
  [multi-use-producer : bool]) : CompilerIrInstrList
  (let
    [after-store : CompilerIrInstrList
      (if multi-use-result
        (compiler-ir-instr-cons
          (CompilerIrInstr.Mov 7 (CompilerIrValue.Var 3) (AstType.I64))
          CompilerIrInstrList.Nil)
        (if multi-use-producer
          (compiler-ir-instr-cons
            (CompilerIrInstr.Mov 7 (CompilerIrValue.Var 2) (AstType.I64))
            CompilerIrInstrList.Nil)
          CompilerIrInstrList.Nil))]
    (compiler-ir-instr-cons
      (CompilerIrInstr.BinOp
        2
        (CompilerIrBinOp.Add)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.BinOp
          3
          (CompilerIrBinOp.SafeMod)
          (CompilerIrValue.Var 2)
          (CompilerIrValue.I64 1000000007)
          (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Gep
            6
            (CompilerIrValue.Var 4)
            (CompilerIrValue.Var 5)
            (AstType.I64))
          (compiler-ir-instr-cons
            (CompilerIrInstr.StorePtr
              (CompilerIrValue.Var 6)
              (CompilerIrValue.Var 3)
              (AstType.I64))
            after-store))))))

(define (compiler-backend-divmod-polish-asm
  [multi-use-result : bool]
  [multi-use-producer : bool]) : ResultCompilerBackend
  (let
    [prev-starts : (Array i64) compiler-backend-scavenge-ctx-starts]
    [prev-ends : (Array i64) compiler-backend-scavenge-ctx-ends]
    [prev-assignment-index : CompilerRegAssignmentIndex
      compiler-backend-scavenge-ctx-assignment-index]
    [prev-plan-mask : i64 compiler-backend-scavenge-ctx-plan-reg-mask]
    [prev-occupied-masks : (Array i64)
      compiler-backend-scavenge-ctx-occupied-masks]
    [prev-vars : i64 compiler-backend-scavenge-ctx-vars]
    [prev-post-base : i64 compiler-backend-emit-instr-post-base]
    [prev-current-count : i64 compiler-backend-emit-current-count]
    [prev-win64 : bool (compiler-backend-current-fn-win64?)]
    [prev-gep-ready : bool compiler-backend-gep-fold-ready]
    [prev-gep-disp : (Array i64) compiler-backend-gep-fold-disp-table]
    [prev-gep-kind : (Array i64) compiler-backend-gep-fold-kind-table]
    [prev-gep-scale : (Array i64) compiler-backend-gep-fold-scale-table]
    [prev-gep-cursor : i64 compiler-backend-gep-fold-cursor]
    [prev-gep-drift : bool compiler-backend-gep-fold-drift]
    [prev0-var : i64 compiler-backend-emit-home-override0-var]
    [prev0-reg : String compiler-backend-emit-home-override0-reg]
    [prev1-var : i64 compiler-backend-emit-home-override1-var]
    [prev1-reg : String compiler-backend-emit-home-override1-reg]
    [assignments : CompilerRegAssignmentList
      (compiler-backend-divmod-polish-assignments)]
    [instrs : CompilerIrInstrList
      (compiler-backend-divmod-polish-instrs
        multi-use-result
        multi-use-producer)]
    [count : i64 (compiler-ir-instr-list-count instrs)]
    [blocks : CompilerIrBlockList
      (compiler-ir-block-cons
        (compiler-ir-block "entry" instrs)
        CompilerIrBlockList.Nil)]
    [_ctx : unit
      (begin
        (compiler-backend-set-current-fn-linux!)
        (compiler-backend-gep-fold-disable!)
        (compiler-backend-emit-home-overrides-disable!)
        (compiler-backend-test-scavenge-install-ctx!
          "divmod_polish"
          CompilerIrParamList.Nil
          (AstType.I64)
          8
          blocks
          assignments)
        (set! compiler-backend-emit-instr-post-base count)
        (set! compiler-backend-emit-current-count count))]
    [result : ResultCompilerBackend
      (compiler-backend-emit-test-instrs instrs assignments 8)]
    [_restore : unit
      (begin
        (compiler-backend-set-scavenge-ctx-ready!
          prev-starts
          prev-ends
          prev-assignment-index
          prev-plan-mask
          prev-occupied-masks
          prev-vars)
        (set! compiler-backend-emit-instr-post-base prev-post-base)
        (set! compiler-backend-emit-current-count prev-current-count)
        (if prev-win64
          (compiler-backend-set-current-fn-win64!)
          (compiler-backend-set-current-fn-linux!))
        (set! compiler-backend-gep-fold-ready prev-gep-ready)
        (set! compiler-backend-gep-fold-disp-table prev-gep-disp)
        (set! compiler-backend-gep-fold-kind-table prev-gep-kind)
        (set! compiler-backend-gep-fold-scale-table prev-gep-scale)
        (set! compiler-backend-gep-fold-cursor prev-gep-cursor)
        (set! compiler-backend-gep-fold-drift prev-gep-drift)
        (compiler-backend-divmod-overrides-install!
          prev0-var
          prev0-reg
          prev1-var
          prev1-reg))]
    result))

(define (compiler-backend-divmod-producer-result-forwarding-ok?) : bool
  (match (compiler-backend-divmod-polish-asm false false)
    [(ResultCompilerBackend.Ok forwarded)
      (match (compiler-backend-divmod-polish-asm true false)
        [(ResultCompilerBackend.Ok multi-result)
          (match (compiler-backend-divmod-polish-asm false true)
            [(ResultCompilerBackend.Ok multi-producer)
              (and
                ;; Positive: producer lands in SRC and the single-use result is
                ;; stored from SRC after the exact nine-instruction expansion.
                (compiler-backend-string-contains?
                  forwarded
                  "    leaq (%r12,%r13), %r9\n    movq %r9, %rax\n")
                (compiler-backend-string-contains?
                  forwarded
                  "    subq %rax, %r9\n    movq %r9, (%rdi,%rsi,8)\n")
                (not
                  (compiler-backend-string-contains?
                    forwarded
                    "    movq %rdx, %r9\n"))
                (not
                  (compiler-backend-string-contains?
                    forwarded
                    "    movq %r9, %rax\n    movq %rax, (%rdi,%rsi,8)\n"))
                ;; Negative: a multi-use divmod result returns to its canonical
                ;; %rax home before both consumers read it.
                (compiler-backend-string-contains?
                  multi-result
                  "    leaq (%r12,%r13), %r9\n    movq %r9, %rax\n")
                (compiler-backend-string-contains?
                  multi-result
                  "    subq %rax, %r9\n    movq %r9, %rax\n")
                (compiler-backend-string-contains?
                  multi-result
                  "    movq %rax, (%rdi,%rsi,8)\n")
                ;; Negative: another use of the producer keeps its fixed %rdx
                ;; home, so the divmod performs the ordinary SRC copy.
                (compiler-backend-string-contains?
                  multi-producer
                  "    leaq (%r12,%r13), %rdx\n    movq %rdx, %r9\n")
                (not
                  (compiler-backend-string-contains?
                    multi-producer
                    "    leaq (%r12,%r13), %r9\n")))]
            [(ResultCompilerBackend.Err _) false])]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerBackend.Err _) false]))

;; C22 regression: Gep/Load pairs feed an ALU, then constant modulo, then a
;; same-array store.  The explicit homes reproduce the saturated Win64 choice:
;; %r9 carries the magic and divmod SRC must emergency-borrow the live array base
;; in %rcx.  The direct store must reject that address/clobber intersection so
;; %rcx is restored before the ordinary Gep+StorePtr reads it.
(define (compiler-backend-c22-divmod-store-collision-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%rcx"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r8"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          4
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            7
            (CompilerRegLocation.Register "%rdx"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              8
              (CompilerRegLocation.Register "%rax"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                10
                (CompilerRegLocation.Register "%r10"))
              (compiler-reg-assignment-cons
                (CompilerRegAssignment.Assignment
                  11
                  (CompilerRegLocation.Register "%r11"))
                CompilerRegAssignmentList.Nil))))))))

(define (compiler-backend-c22-divmod-store-collision-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (CompilerIrInstr.Gep
      2
      (CompilerIrValue.Var 0)
      (CompilerIrValue.Var 1)
      (AstType.I64))
    (compiler-ir-instr-cons
      (CompilerIrInstr.Load 3 (CompilerIrValue.Var 2) (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Gep
          5
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 4)
          (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Load 6 (CompilerIrValue.Var 5) (AstType.I64))
          (compiler-ir-instr-cons
            (CompilerIrInstr.BinOp
              7
              (CompilerIrBinOp.Add)
              (CompilerIrValue.Var 3)
              (CompilerIrValue.Var 6)
              (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                8
                (CompilerIrBinOp.SafeMod)
                (CompilerIrValue.Var 7)
                (CompilerIrValue.I64 1000000007)
                (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.Gep
                  9
                  (CompilerIrValue.Var 0)
                  (CompilerIrValue.Var 4)
                  (AstType.I64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.StorePtr
                    (CompilerIrValue.Var 9)
                    (CompilerIrValue.Var 8)
                    (AstType.I64))
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Mov
                      12
                      (CompilerIrValue.Var 1)
                      (AstType.I64))
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Mov
                        13
                        (CompilerIrValue.Var 10)
                        (AstType.I64))
                      (compiler-ir-instr-cons
                        (CompilerIrInstr.Mov
                          14
                          (CompilerIrValue.Var 11)
                          (AstType.I64))
                        CompilerIrInstrList.Nil))))))))))))

(define (compiler-backend-c22-divmod-store-collision-asm) : ResultCompilerBackend
  (let
    [prev-starts : (Array i64) compiler-backend-scavenge-ctx-starts]
    [prev-ends : (Array i64) compiler-backend-scavenge-ctx-ends]
    [prev-assignment-index : CompilerRegAssignmentIndex
      compiler-backend-scavenge-ctx-assignment-index]
    [prev-plan-mask : i64 compiler-backend-scavenge-ctx-plan-reg-mask]
    [prev-occupied-masks : (Array i64)
      compiler-backend-scavenge-ctx-occupied-masks]
    [prev-vars : i64 compiler-backend-scavenge-ctx-vars]
    [prev-post-base : i64 compiler-backend-emit-instr-post-base]
    [prev-current-count : i64 compiler-backend-emit-current-count]
    [prev-win64 : bool (compiler-backend-current-fn-win64?)]
    [prev-gep-ready : bool compiler-backend-gep-fold-ready]
    [prev-gep-disp : (Array i64) compiler-backend-gep-fold-disp-table]
    [prev-gep-kind : (Array i64) compiler-backend-gep-fold-kind-table]
    [prev-gep-scale : (Array i64) compiler-backend-gep-fold-scale-table]
    [prev-gep-cursor : i64 compiler-backend-gep-fold-cursor]
    [prev-gep-drift : bool compiler-backend-gep-fold-drift]
    [prev0-var : i64 compiler-backend-emit-home-override0-var]
    [prev0-reg : String compiler-backend-emit-home-override0-reg]
    [prev1-var : i64 compiler-backend-emit-home-override1-var]
    [prev1-reg : String compiler-backend-emit-home-override1-reg]
    [prev-emergency-slot-offset : i64 compiler-backend-emergency-slot-offset]
    [assignments : CompilerRegAssignmentList
      (compiler-backend-c22-divmod-store-collision-assignments)]
    [instrs : CompilerIrInstrList
      (compiler-backend-c22-divmod-store-collision-instrs)]
    [count : i64 (compiler-ir-instr-list-count instrs)]
    [blocks : CompilerIrBlockList
      (compiler-ir-block-cons
        (compiler-ir-block "entry" instrs)
        CompilerIrBlockList.Nil)]
    [_ctx : unit
      (begin
        (compiler-backend-set-current-fn-win64!)
        (compiler-backend-gep-fold-disable!)
        (compiler-backend-emit-home-overrides-disable!)
        (compiler-backend-test-scavenge-install-ctx!
          "c22_divmod_store_collision"
          CompilerIrParamList.Nil
          (AstType.I64)
          15
          blocks
          assignments)
        (set! compiler-backend-emit-instr-post-base count)
        (set! compiler-backend-emit-current-count count)
        (set! compiler-backend-emergency-slot-offset -512))]
    [result : ResultCompilerBackend
      (compiler-backend-emit-test-instrs instrs assignments 15)]
    [_restore : unit
      (begin
        (compiler-backend-set-scavenge-ctx-ready!
          prev-starts
          prev-ends
          prev-assignment-index
          prev-plan-mask
          prev-occupied-masks
          prev-vars)
        (set! compiler-backend-emit-instr-post-base prev-post-base)
        (set! compiler-backend-emit-current-count prev-current-count)
        (if prev-win64
          (compiler-backend-set-current-fn-win64!)
          (compiler-backend-set-current-fn-linux!))
        (set! compiler-backend-gep-fold-ready prev-gep-ready)
        (set! compiler-backend-gep-fold-disp-table prev-gep-disp)
        (set! compiler-backend-gep-fold-kind-table prev-gep-kind)
        (set! compiler-backend-gep-fold-scale-table prev-gep-scale)
        (set! compiler-backend-gep-fold-cursor prev-gep-cursor)
        (set! compiler-backend-gep-fold-drift prev-gep-drift)
        (compiler-backend-divmod-overrides-install!
          prev0-var
          prev0-reg
          prev1-var
          prev1-reg)
        (set! compiler-backend-emergency-slot-offset prev-emergency-slot-offset))]
    result))

(define (compiler-backend-c22-divmod-store-clobber-rejected-ok?) : bool
  (match (compiler-backend-c22-divmod-store-collision-asm)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          "    movq (%rcx,%r8,8), %rdx\n    addq (%rcx,%r12,8), %rdx\n")
        (compiler-backend-string-contains?
          asm
          "    movabsq $-8543223828751151131, %r9\n")
        (compiler-backend-string-contains?
          asm
          "    movq -512(%rbp), %rcx\n    movq %rax, (%rcx,%r12,8)\n")
        (not
          (compiler-backend-string-contains?
            asm
            "    subq %rax, %rcx\n    movq %rcx, %r9\n    movq %r9, (%rcx,%r12,8)\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-divrem-binop-types [ty : AstType]) : CompilerRegVarTypeList
  (compiler-reg-var-type-cons
    (CompilerRegVarType.Type 0 ty)
    (compiler-reg-var-type-cons
      (CompilerRegVarType.Type 1 ty)
      (compiler-reg-var-type-cons
        (CompilerRegVarType.Type 2 ty)
        CompilerRegVarTypeList.Nil))))

(define (compiler-backend-divrem-binop-asm
  [op : CompilerIrBinOp]
  [rhs : CompilerIrValue]
  [ty : AstType]) : ResultCompilerBackend
  (compiler-backend-emit-binop
    (compiler-backend-divrem-binop-types ty)
    (CompilerBackendGlobalTypeList.Nil)
    CompilerRegAssignmentList.Nil
    2
    op
    (CompilerIrValue.Var 0)
    rhs
    ty))

(define (compiler-backend-divrem-binop-guard-shape?
  [op : CompilerIrBinOp]
  [rhs : CompilerIrValue]
  [ty : AstType]
  [want-guard? : bool]
  [want-remainder? : bool]) : bool
  (match (compiler-backend-divrem-binop-asm op rhs ty)
    [(ResultCompilerBackend.Ok asm)
      (and
        (if want-guard?
          (compiler-backend-string-contains? asm "    call tl_div_abort\n")
          (not
            (compiler-backend-string-contains? asm "    call tl_div_abort\n")))
        (compiler-backend-string-contains? asm "    idivq %r8\n")
        (if want-remainder?
          (compiler-backend-string-contains? asm "    movq %rdx, %rax\n")
          true)
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-divrem-rax-rhs-preserved-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%rax"))
          CompilerRegAssignmentList.Nil))]
    (match (compiler-backend-emit-binop
      (compiler-backend-divrem-binop-types (AstType.I64))
      (CompilerBackendGlobalTypeList.Nil)
      assignments
      2
      (CompilerIrBinOp.Div)
      (CompilerIrValue.Var 0)
      (CompilerIrValue.Var 1)
      (AstType.I64))
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains?
            asm
            "    movq %rax, %r8\n    movq %r12, %rax\n")
          (compiler-backend-string-contains? asm "    idivq %r8\n")
          (not
            (compiler-backend-string-contains?
              asm
              "    movq %r12, %rax\n    movq %rax, %r8\n"))
          (not
            (compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-safe-divrem-guard-elision-ok?) : bool
  (and
    (backend-and4
      (compiler-backend-divrem-binop-guard-shape?
        (CompilerIrBinOp.Div)
        (CompilerIrValue.Var 1)
        (AstType.I64)
        true
        false)
      (compiler-backend-divrem-binop-guard-shape?
        (CompilerIrBinOp.SafeDiv)
        (CompilerIrValue.Var 1)
        (AstType.I64)
        false
        false)
      (compiler-backend-divrem-binop-guard-shape?
        (CompilerIrBinOp.SafeMod)
        (CompilerIrValue.Var 1)
        (AstType.I64)
        false
        true)
      (compiler-backend-divrem-binop-guard-shape?
        (CompilerIrBinOp.SafeDiv)
        (CompilerIrValue.I64 (- 0 1))
        (AstType.I64)
        false
        false))
    (not
      (compiler-backend-binop-needs-div-abort?
        (CompilerIrBinOp.SafeDiv)
        (CompilerIrValue.Var 1)
        (AstType.I64)))))

(define (compiler-backend-shift-guard-source) : String
  "(define (main) : i64 (shl 1 -1))")

(define (compiler-backend-shift-guard-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-shift-guard-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and8
        (compiler-backend-string-contains? asm "    movq $-1,")
        (compiler-backend-string-contains?
          asm
          "    testq %r8, %r8\n    jge 1f\n    call tl_shift_abort\n1:\n")
        (compiler-backend-string-contains?
          asm
          "    cmpq $64, %r8\n    jb 1f\n    call tl_shift_abort\n1:\n")
        (compiler-backend-string-contains? asm "    call tl_shift_abort\n")
        (not (compiler-backend-string-contains? asm ".globl tl_shift_abort\n"))
        (not (compiler-backend-string-contains? asm ".L_tl_shift_msg:"))
        (not (compiler-backend-string-contains? asm "    shlq $-1, %rax\n"))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-checked-trap-entry-block) : CompilerIrBlock
  (compiler-ir-block
    "entry"
    (compiler-ir-instr-cons
      (CompilerIrInstr.BinOp
        0
        (CompilerIrBinOp.Eq)
        (CompilerIrValue.I64 0)
        (CompilerIrValue.I64 0)
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Branch (CompilerIrValue.Var 0) "div_trap" "div_ok")
        CompilerIrInstrList.Nil))))

