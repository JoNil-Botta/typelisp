;; Backend-owned replacement for representative aggregate storage emit-shape
;; checks from the legacy backend suite.
(define (compiler-backend-aggregate-return-source) : String
  "(defenum Shape (Circle i64) (Square i64) (Nothing))
(defstruct Point (x i64) (y i64))
(define (mk-shape) : Shape (Circle 7))
(define (mk-point) : Point (Point 1 2))
(define (mk-string) : String \"hi\")
(define (main) : i64
  (let [point : Point (mk-point)]
    (+ (match (mk-shape) [(Circle r) r] [(Square s) s] [Nothing 0])
      (+ point.y (__tl_string_length (mk-string))))))")

(define (compiler-backend-aggregate-return-shape-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-aggregate-return-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          ;; sret ABI: struct/enum returns write the result through the
          ;; caller-provided sret slot -- no per-return arena allocation.
          (= (compiler-backend-alloc-call-count asm) 0)
          (not (compiler-backend-string-contains-alloc-size? asm 16))
          (compiler_backend.compiler-backend-string-contains? asm "movq $7,")
          (compiler_backend.compiler-backend-string-contains? asm "movq $1,")
          (compiler_backend.compiler-backend-string-contains? asm "movq $2,")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_str_data_l2_13861_13991:")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad 2\n")
          true)
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-aggregate-global-init-source) : String
  "(defenum LocalMaybe (Some i64) (None))
(defstruct Pair (x i64) (y i64))
(defstruct Nested (label String) (choice LocalMaybe))
(define (string.concat [left : String] [right : String]) : String
  left)

(define greeting : String (string.concat \"he\" \"llo\"))
(define choice : LocalMaybe (Some 8))
(define pair : Pair (Pair 10 11))
(define cells : (Array i64) (__tl_make-array i64 3))
(define nested : Nested (Nested (string.concat \"o\" \"k\") (Some 3)))

(define (main) : i64
  (+ (+ (+ (__tl_string_length greeting) (length cells))
        (+ pair.x pair.y))
     (+ (match choice [(Some n) n] [None 0])
        (+ (__tl_string_length nested.label)
           (match nested.choice [(Some n) n] [None 0])))))")

(define (compiler-backend-runtime-global-shape-ok?
  [asm : String]
  [name : String]) : bool
  (let
    [symbol : String (str_cat.str-cat "_tl_" name)]
    [init-symbol : String (str_cat.str-cat "_tl___global_init_" name)]
    (and
      (compiler_backend.backend-and4
        ;; A register-group global (e.g. `pair`) reserves 16 inline bytes;
        ;; an 8-byte handle/scalar global reserves 8. Accept either.
        (or
          (compiler_backend.compiler-backend-string-contains?
            asm
            (str_cat.str-cat "    .comm " symbol ", 8, 8\n"))
          (compiler_backend.compiler-backend-string-contains?
            asm
            (str_cat.str-cat "    .comm " symbol ", 16, 8\n")))
        (compiler_backend.compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    call " init-symbol "\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    movq %rax, " symbol "(%rip)\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          (str_cat.str-cat init-symbol ":\n" "")))
      (or
        (compiler_backend.compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    movq " symbol "(%rip), %rax\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    movq " symbol "(%rip), %r10\n"))
        ;; A register-group global is read via its address.
        (compiler_backend.compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    leaq " symbol "(%rip), %r10\n"))))))

(define (compiler-backend-aggregate-global-init-shape-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-aggregate-global-init-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler-backend-runtime-global-shape-ok? asm "greeting")
          (compiler-backend-runtime-global-shape-ok? asm "choice")
          (compiler-backend-runtime-global-shape-ok? asm "pair")
          (compiler-backend-runtime-global-shape-ok? asm "cells")
          (compiler-backend-runtime-global-shape-ok? asm "nested")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "_tl_start:\n")
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    js .L_tl_main_stack_abort\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".ascii \"typelisp runtime: 1 GiB main-stack mmap failed\\n\"\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".L_tl_main_stack_abort:\n    movq $1, %rax\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))
        true)]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-aggregate-storage-shape-ok?) : bool
  (and
    (compiler-backend-pack-scavenged-word-shape-ok?)
    (compiler-backend-aggregate-return-shape-ok?)
    (compiler-backend-aggregate-global-init-shape-ok?)))

;; Backend-owned replacement for closure/lambda emit-shape checks.
;; The source uses synthetic lambda lowered names because AstExpr.Lambda lowering
;; is tracked separately; this pins the backend descriptor, adapter, and
;; indirect-call shape produced by the same IR names.
(define (compiler-backend-closure-literal-source) : String
  "(define (__tl_lambda_main_0 [x : i64]) : i64 (+ x 1))
(define (main) : i64
  (let [f : (-> i64 i64) __tl_lambda_main_0]
    (f 41)))")

(define (compiler-backend-closure-inferred-source) : String
  "(define (__tl_lambda_main_0 [x : i64]) : i64
  (let [y : i64 (+ x 1)]
    y))
(define (main) : i64
  (let [f : (-> i64 i64) __tl_lambda_main_0]
    (f 41)))")

(define (compiler-backend-closure-aggregate-return-source) : String
  "(defenum Box (BoxI i64))
(defstruct Pair (x i64) (y i64))

(define (__tl_lambda_main_0) : String \"hello\")
(define (__tl_lambda_main_1) : Box (BoxI 11))
(define (__tl_lambda_main_2) : (Array i64) (__tl_make-array i64 13))
(define (__tl_lambda_main_3) : Pair (Pair 1 13))

(define (main) : i64
  (let [mk-string : (-> String) __tl_lambda_main_0]
        [mk-enum : (-> Box) __tl_lambda_main_1]
        [mk-array : (-> (Array i64)) __tl_lambda_main_2]
        [mk-struct : (-> Pair) __tl_lambda_main_3]
        [pair : Pair (mk-struct)]
    (+ (__tl_string_length (mk-string))
      (+ (match (mk-enum) [(BoxI n) n])
        (+ (array-length (mk-array)) pair.y)))))")

(define (compiler-backend-closure-literal-shape-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-closure-literal-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains? asm "_tl_f")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_fn_desc___tl_lambda_main_0:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad .L_tl_fn_entry___tl_lambda_main_0\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_fn_entry___tl_lambda_main_0:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call _tl_f")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    leaq .L_tl_fn_desc___tl_lambda_main_0(%rip), ")
          (compiler-backend-call-or-jmp-ok? asm "*(%r10)")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq (%r10), %rax\n")))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq 8(%r10), %rdi\n")
        (not (compiler-backend-call-or-jmp-ok? asm "*(%r11)"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-closure-inferred-shape-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-closure-inferred-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and4
        (compiler_backend.compiler-backend-string-contains? asm "_tl_f")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    call _tl_f")
        (compiler-backend-call-or-jmp-ok? asm "*(%r10)")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-closure-aggregate-return-shape-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-closure-aggregate-return-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (>=
            (compiler_backend.compiler-backend-string-count asm ".globl _tl_f")
            4)
          (compiler_backend.compiler-backend-string-contains? asm "_tl_f")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call _tl_f")
          (compiler_backend.compiler-backend-string-contains? asm "main:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_fn_desc___tl_lambda_main_0:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_fn_desc___tl_lambda_main_1:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_fn_desc___tl_lambda_main_2:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_fn_desc___tl_lambda_main_3:\n"))
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_fn_entry___tl_lambda_main_0:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_fn_entry___tl_lambda_main_1:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_fn_entry___tl_lambda_main_2:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_fn_entry___tl_lambda_main_3:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad .L_tl_fn_entry___tl_lambda_main_0\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad .L_tl_fn_entry___tl_lambda_main_1\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad .L_tl_fn_entry___tl_lambda_main_2\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad .L_tl_fn_entry___tl_lambda_main_3\n"))
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains? asm "tl_alloc:\n")
          ;; sret ABI: only the heap-backed (Array) closure return
          ;; still allocates; Box/Pair/String returns use sret/static data.
          (>= (compiler-backend-alloc-call-count asm) 1)
          (>=
            (+
              (compiler_backend.compiler-backend-string-count
                asm
                "    call *(%r10)\n")
              (compiler_backend.compiler-backend-string-count
                asm
                "    jmp *(%r10)\n"))
            4)
          (and
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq (%r10), %rax\n"))
            (=
              (+
                (compiler_backend.compiler-backend-string-count
                  asm
                  "    call *(%r11)\n")
                (compiler_backend.compiler-backend-string-count
                  asm
                  "    jmp *(%r11)\n"))
              0))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker)))
          true
          true
          true)
        true)]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-closure-debug-cfi-balanced-ok?) : bool
  (let
    [previous : bool (compiler_ir_types.compiler-debug-info-enabled?)]
    [result : compiler_backend.ResultCompilerBackend
      (begin
        (compiler_ir_types.compiler-debug-info-set-enabled! true)
        (compiler_backend.compiler-backend-emit-source
          (compiler-backend-closure-literal-source)))]
    (begin
      (compiler_ir_types.compiler-debug-info-set-enabled! previous)
      (match result
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (>
              (compiler_backend.compiler-backend-string-count
                asm
                ".cfi_startproc")
              1)
            (=
              (compiler_backend.compiler-backend-string-count
                asm
                ".cfi_startproc")
              (compiler_backend.compiler-backend-string-count
                asm
                ".cfi_endproc")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-closure-emit-shape-ok?) : bool
  (and
    (compiler-backend-closure-literal-shape-ok?)
    (compiler-backend-closure-inferred-shape-ok?)
    (compiler-backend-closure-aggregate-return-shape-ok?)
    (compiler-backend-closure-debug-cfi-balanced-ok?)))

(define (compiler-backend-enum-match-ok?) : bool
  ;; `Maybe (None) (Some i64)` is a 16-byte register-resident enum, so the
  ;; tag is matched on a register-held word (no `cmpq $0, (%r10)` heap deref) and
  ;; the payload is read from word1 rather than `8(%r10)`. Those memory-shape
  ;; assertions are obsolete; what remains representation-agnostic is that the
  ;; match lowers to comparison arms and neither variant is built via a runtime
  ;; constructor call (None is an immediate tag, Some is an CompilerIrInstr.Pack).
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-enum-match-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and4
        (or
          (compiler_backend.compiler-backend-string-contains? asm "_tl_score")
          (compiler_backend.compiler-backend-string-contains? asm "_tl_f"))
        (compiler_backend.compiler-backend-string-contains? asm "_match_arm.")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call _tl_None\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call _tl_Some\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-never-branch-register-group-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-never-branch-register-group-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains? asm "main:\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "register-group")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Scalar backend emission intentionally uses the stack-only plan by default for
;; cold compile speed; allocator behavior is still covered in compiler_regalloc.tl
;; and by AVX/vector backend smoke paths.
(define (compiler-backend-regalloc-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-regalloc-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and8
        (or
          (compiler_backend.compiler-backend-string-contains? asm "_tl_calc")
          (compiler_backend.compiler-backend-string-contains? asm "_tl_f"))
        ;; FPO (M-G3 stage 2) makes frame refs rsp-relative; params spill
        ;; to rsp slots and the spilled sum is reloaded into its modeled
        ;; scratch (%rsi with scratch-vreg, legacy %r8 otherwise),
        ;; leaving the product in %rax.
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq %rdi, 56(%rsp)\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq %rsi, 48(%rsp)\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          (cfg
            scratch-vreg
            "    movq 32(%rsp), %rsi\n"
            "    movq 32(%rsp), %r8\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          (cfg scratch-vreg "    imulq %rsi, %rax\n" "    imulq %r8, %rax\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r12, -"))
        true
        true)]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-regalloc-f64-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-regalloc-f64-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and8
        ;; FPO (M-G3 stage 2) rsp-relative frame slots (a=32, b=16, sum=8).
        (compiler_backend.compiler-backend-string-contains? asm "main:\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          (cfg
            scratch-vreg
            "    movsd 32(%rsp), %xmm0\n"
            "    movsd 32(%rsp), %xmm2\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          (cfg
            scratch-vreg
            "    addsd 16(%rsp), %xmm0\n"
            "    addsd 16(%rsp), %xmm2\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          (cfg
            scratch-vreg
            "    movsd %xmm0, 8(%rsp)\n"
            "    movsd %xmm2, 8(%rsp)\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movsd 8(%rsp), %xmm0\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    addsd %xmm1, %xmm0\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (cfg
              scratch-vreg
              "    movsd 32(%rsp), %xmm2\n"
              "    movsd 32(%rsp), %xmm0\n")))
        (not (compiler_backend.compiler-backend-string-contains? asm "%xmm3")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-test-global-builder-push!
  [builder : (&mut builder compiler_ir_types.CompilerIrGlobalBuilder)]
  [name : String]
  [ty : compiler_ast_types.AstType]
  [value : compiler_ir_types.CompilerIrValue]) : unit
  (compiler_ir_types.compiler-ir-global-builder-push!
    builder
    (compiler_ir_types.CompilerIrGlobal.Global (ci.intern name) ty value)))

(define (compiler-backend-test-global-seq-single
  [name : String]
  [ty : compiler_ast_types.AstType]
  [value : compiler_ir_types.CompilerIrValue]) : compiler_ir_types.CompilerIrGlobalSeq
  (let
    [builder : compiler_ir_types.CompilerIrGlobalBuilder
      (compiler_ir_types.compiler-ir-global-builder-with-capacity 1)]
    (begin
      (compiler-backend-test-global-builder-push! (&mut builder) name ty value)
      (compiler_ir_types.compiler-ir-global-builder-to-seq builder))))

(define (compiler-backend-test-two-i64-globals
  [first-name : String]
  [first-value : i64]
  [second-name : String]
  [second-value : i64]) : compiler_ir_types.CompilerIrGlobalSeq
  (let
    [builder : compiler_ir_types.CompilerIrGlobalBuilder
      (compiler_ir_types.compiler-ir-global-builder-with-capacity 2)]
    (begin
      (compiler-backend-test-global-builder-push!
        (&mut builder)
        first-name
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 first-value))
      (compiler-backend-test-global-builder-push!
        (&mut builder)
        second-name
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 second-value))
      (compiler_ir_types.compiler-ir-global-builder-to-seq builder))))

(define (compiler-backend-call-save-test-globals) : compiler_ir_types.CompilerIrGlobalSeq
  (let
    [globals : compiler_ir_types.CompilerIrGlobalBuilder
      (compiler_ir_types.compiler-ir-global-builder-with-capacity 9)]
    (begin
      (compiler-backend-test-global-builder-push!
        (&mut globals)
        "g0"
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler-backend-test-global-builder-push!
        (&mut globals)
        "g1"
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler-backend-test-global-builder-push!
        (&mut globals)
        "g2"
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler-backend-test-global-builder-push!
        (&mut globals)
        "g3"
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler-backend-test-global-builder-push!
        (&mut globals)
        "g4"
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler-backend-test-global-builder-push!
        (&mut globals)
        "g5"
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler-backend-test-global-builder-push!
        (&mut globals)
        "g6"
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler-backend-test-global-builder-push!
        (&mut globals)
        "g5b"
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler-backend-test-global-builder-push!
        (&mut globals)
        "g5c"
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler_ir_types.compiler-ir-global-builder-to-seq globals))))

(define (compiler-backend-call-save-main-instrs) : compiler_ir_types.CompilerIrInstrList
  (let
    [instrs : compiler_ir_types.CompilerIrInstrList
      compiler_ir_types.CompilerIrInstrList.Nil]
    (begin
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Return
            (compiler_ir_types.CompilerIrMaybeValue.Some
              (compiler_ir_types.CompilerIrValue.I64 0)))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Store
            (ci.intern "g5c")
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Store
            (ci.intern "g5b")
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Store
            (ci.intern "g6")
            (compiler_ir_types.CompilerIrValue.Var 6)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Store
            (ci.intern "g5")
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Store
            (ci.intern "g4")
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Store
            (ci.intern "g3")
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Store
            (ci.intern "g2")
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Store
            (ci.intern "g1")
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Store
            (ci.intern "g0")
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Call
            7
            (ci.intern "side_effect")
            (compiler_ir_types.CompilerIrCallArgs.Nil)
            (compiler_ast_types.AstType.Unit))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            6
            (compiler_ir_types.CompilerIrValue.I64 6)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            5
            (compiler_ir_types.CompilerIrValue.I64 5)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            4
            (compiler_ir_types.CompilerIrValue.I64 4)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            3
            (compiler_ir_types.CompilerIrValue.I64 3)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            2
            (compiler_ir_types.CompilerIrValue.I64 2)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          instrs))
      (set!
        instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            0
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          instrs))
      instrs)))

(define (compiler-backend-call-save-program) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler-backend-call-save-test-globals)
    (compiler_ir_types.compiler-ir-function-cons
      (compiler_ir_types.CompilerIrFunction.Function
        (ci.intern "side_effect")
        compiler_ir_types.CompilerIrParamList.Nil
        (compiler_ast_types.AstType.Unit)
        0
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-block
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Return
                compiler_ir_types.CompilerIrMaybeValue.No)
              compiler_ir_types.CompilerIrInstrList.Nil))
          compiler_ir_types.CompilerIrBlockList.Nil))
      (compiler_ir_types.compiler-ir-function-cons
        (compiler_ir_types.CompilerIrFunction.Function
          (ci.intern "main")
          compiler_ir_types.CompilerIrParamList.Nil
          (compiler_ast_types.AstType.I64)
          8
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.compiler-ir-block
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler-backend-call-save-main-instrs))
            compiler_ir_types.CompilerIrBlockList.Nil))
        compiler_ir_types.CompilerIrFunctionList.Nil))
    compiler_ir_types.CompilerIrExternList.Nil))

(define (compiler-backend-call-save-r9-wrap-ok?) : bool
  (let
    ;; Construct the fixture (and intern every symbol it uses) before taking
    ;; the two exact job capabilities.  The A/B/A/B sequence below must not
    ;; rely on the active compatibility table or a process-global option.
    [program : compiler_ir_types.CompilerIrProgram
      (compiler-backend-call-save-program)]
    [intern-state : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [state-a : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new intern-state)]
    [state-b : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new intern-state)]
    [_set-a : unit
      (compiler_backend.compiler-backend-state-set-scalar-registers-enabled!
        state-a
        true)]
    [_set-b : unit
      (compiler_backend.compiler-backend-state-set-scalar-registers-enabled!
        state-b
        false)]
    [spans : compiler_ir_types.CompilerSourceSpans
      (compiler_ir_types.compiler-source-spans-empty)]
    [a1-result : compiler_backend.ResultCompilerBackend
      (compiler-backend-test-emit-program-with-state
        state-a
        (compiler_backend.CompilerBackendTarget.Linux)
        program
        spans
        true)]
    [b1-result : compiler_backend.ResultCompilerBackend
      (compiler-backend-test-emit-program-with-state
        state-b
        (compiler_backend.CompilerBackendTarget.Linux)
        program
        spans
        true)]
    [a2-result : compiler_backend.ResultCompilerBackend
      (compiler-backend-test-emit-program-with-state
        state-a
        (compiler_backend.CompilerBackendTarget.Linux)
        program
        spans
        true)]
    [b2-result : compiler_backend.ResultCompilerBackend
      (compiler-backend-test-emit-program-with-state
        state-b
        (compiler_backend.CompilerBackendTarget.Linux)
        program
        spans
        true)]
    [a1 : String
      (match a1-result
        [(compiler_backend.ResultCompilerBackend.Ok asm) asm]
        [(compiler_backend.ResultCompilerBackend.Err _) ""])]
    [b1 : String
      (match b1-result
        [(compiler_backend.ResultCompilerBackend.Ok asm) asm]
        [(compiler_backend.ResultCompilerBackend.Err _) ""])]
    [a2 : String
      (match a2-result
        [(compiler_backend.ResultCompilerBackend.Ok asm) asm]
        [(compiler_backend.ResultCompilerBackend.Err _) ""])]
    [b2 : String
      (match b2-result
        [(compiler_backend.ResultCompilerBackend.Ok asm) asm]
        [(compiler_backend.ResultCompilerBackend.Err _) ""])]
    [a-shape-ok : bool
      (and
        (compiler_backend.compiler-backend-string-contains?
          a1
          "    call _tl_side_effect\n")
        ;; The unified greedy keeps the call-spanning value in a callee-saved
        ;; register and rematerialises the cold immediates after the call, so
        ;; there should be no caller-saved %r9 save/restore wrapper around it.
        (not
          (compiler_backend.compiler-backend-string-contains?
            a1
            "    movq %r9, %rax\n    movq %rax, -"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            a1
            "(%rbp), %r9\n"))
        (compiler_backend.compiler-backend-string-contains?
          a1
          "    movq %r12, _tl_g5(%rip)\n")
        (compiler_backend.compiler-backend-string-contains?
          a1
          "    movq %r12, _tl_g5b(%rip)\n")
        ;; %rbp is now the 6th callee-saved register (M-G3 stage 2), so the
        ;; call-spanning var 4 is homed in %rbp; var 6 remains rematerialised
        ;; in caller-saved %r9d after the call.
        (compiler_backend.compiler-backend-string-contains?
          a1
          "    movl $4, %ebp\n")
        (compiler_backend.compiler-backend-string-contains?
          a1
          "    movl $6, %r9d\n"))]
    (and
      (match a1-result
        [(compiler_backend.ResultCompilerBackend.Ok _) true]
        [(compiler_backend.ResultCompilerBackend.Err _) false])
      (match b1-result
        [(compiler_backend.ResultCompilerBackend.Ok _) true]
        [(compiler_backend.ResultCompilerBackend.Err _) false])
      (match a2-result
        [(compiler_backend.ResultCompilerBackend.Ok _) true]
        [(compiler_backend.ResultCompilerBackend.Err _) false])
      (match b2-result
        [(compiler_backend.ResultCompilerBackend.Ok _) true]
        [(compiler_backend.ResultCompilerBackend.Err _) false])
      (string.eq a1 a2)
      (string.eq b1 b2)
      (not (string.eq a1 b1))
      (compiler_backend.compiler-backend-state-scalar-registers-enabled?
        state-a)
      (not
        (compiler_backend.compiler-backend-state-scalar-registers-enabled?
          state-b))
      a-shape-ok)))

;; #4720: an outlined shifted loop bound becomes `0 < word-count` after loop
;; rotation. On Win64, word-count may be homed in %r9; materialising the
;; immediate LHS into that same register silently changed the pre-test into a
;; self-compare. Keep the function address-taken so opt2 cannot inline away the
;; allocation shape, then emit the full lower -> opt2 -> scalar-regalloc path.
(define compiler-backend-shifted-loop-bound-source : String
  "(define (array-zero-count [buf : (MutPtr u8)] [byte-count : i64]) : i64
  (let
    [word-count : i64 (shr byte-count 3)]
    [tail-start : i64 (* word-count 8)]
    [slots : (MutPtr u64) (unsafe (ptr-cast buf : (MutPtr u64)))]
    [w : i64 0]
    [i : i64 tail-start]
    (begin
      (while (< w word-count)
        (begin
          (unsafe (ptr-write! (ptr-offset slots w) (cast 0 : u64)))
          (set! w (+ w 1))))
      (while (< i byte-count)
        (begin
          (unsafe (ptr-write! (ptr-offset buf i) (cast 0 : u8)))
          (set! i (+ i 1))))
      w)))
(define (keep [f : (-> (MutPtr u8) i64 i64)]) : i64 0)
(define (main) : i64 (keep array-zero-count))")

(define (compiler-backend-emit-source-opt2-for-target
  [source : String]
  [target : compiler_backend.CompilerBackendTarget]) : compiler_backend.ResultCompilerBackend
  (match (compiler_backend.compiler-backend-lower-source-for-target
    source
    target)
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_optimize.optimize-program-with-spans-and-level
        program
        spans
        2)
        [(compiler_optimize.CompilerOptimizedProgram.Program
            optimized
            optimized-spans)
          (let
            [backend-state : compiler_backend.CompilerBackendState
              (compiler_backend.compiler-backend-state-new
                (ci.intern-compat-state-capture-active))]
            (begin
              (compiler_backend.compiler-backend-state-set-scalar-registers-enabled!
                backend-state
                true)
              (compiler-backend-test-emit-program-with-state
                backend-state
                target
                optimized
                optimized-spans
                true)))])]
    [(compiler_lower.ResultCompilerLower.Err diag)
      (compiler_backend.ResultCompilerBackend.Err diag)]))

(define (compiler-backend-compare-self-operand? [body : String] [reg : String]) : bool
  (compiler_backend.compiler-backend-string-contains?
    body
    (str_cat.str-cat "    cmpq " reg ", " reg "\n")))

(define (compiler-backend-immediate-lhs-r9-compare-win64-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_win : unit
      (compiler_backend.compiler-backend-set-current-fn-win64! backend-state)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r9))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [ok : bool
      (match (compiler_backend.compiler-backend-emit-compare-branch
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        assignments
        "cmp"
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.I64 0)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.compiler-ir-label "then")
        (compiler_ir_types.compiler-ir-label "else")
        (compiler_backend.CompilerBackendMaybeLabel.No)
        backend-state)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            ;; `0 < %r9` is emitted as `%r9 > 0`; the zero compare now uses
            ;; the register self-test form and needs no scratch at all.
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    testq %r9, %r9\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    cmpq $0, %r9\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    cmpq %r9, %r9\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [_linux : unit
      (compiler_backend.compiler-backend-set-current-fn-linux! backend-state)]
    ok))

;; Tail-call dispatcher shape. A multi-arm dispatch whose every arm is a TAIL
;; CALL contains no instruction control ever returns from, so no value in it has
;; to survive anything: the four parameters must keep their incoming argument
;; registers and the function must save NO callee-saved register at all. Before
;; tail calls were removed from the allocator's clobber-point set (kind 6,
;; compiler-reg-clobber-instr-kind?) each parameter's coarse interval hull
;; covered the sibling arms' tail calls, so all four were homed in %r12-%r15 and
;; every invocation paid four pushes, four entry copies and four pops.
;;
;; Arm 1 marshals (k, y, x): %rdi keeps k while %rsi and %rdx must SWAP. That is
;; a true 2-cycle for the argument parallel move
;; (compiler-backend-emit-arg-move-list), which only exists once the parameters
;; live in argument registers -- so this fixture is also the cycle-break
;; regression test. `keep4` takes the dispatcher as a value so the optimizer
;; cannot inline the whole thing away.
(define compiler-backend-tail-dispatch-source : String
  "(define (tc-arm-a [a : i64] [b : i64] [c : i64]) : i64
  (+ (* a 3) (+ (* b 5) (* c 7))))
(define (tc-arm-b [a : i64] [b : i64] [c : i64]) : i64
  (- (* a 11) (+ (* b 13) (* c 17))))
(define (tc-arm-c [a : i64] [b : i64] [c : i64]) : i64
  (+ (* a 19) (- (* b 23) (* c 29))))
(define (tc-dispatch [k : i64] [x : i64] [y : i64] [z : i64]) : i64
  (if (= k 0)
    (tc-arm-a x y z)
    (if (= k 1)
      (tc-arm-b k y x)
      (if (= k 2)
        (tc-arm-c z x y)
        (tc-arm-a z y x)))))
(define (keep4 [f : (-> i64 i64 i64 i64 i64)]) : i64 0)
(define (main) : i64 (keep4 tc-dispatch))")

;; A classifier chain inside a loop, spelled with nested `if`s because the raw
;; source path lowers without the prelude that defines `or`. Its constants span
;; a window whose 64-bit mask -- bits {0,4,9,10,12,14,33} above base 33, i.e.
;; 8589956625 -- lands outside imm32, so no instruction operand can encode it.
;;
;; The bit_test rewrite converts the chain, the mask is loop-invariant, LICM
;; hoists its `Mov` into the preheader, and the wide-literal operand rule
;; (opt-global-copy-keep-wide-left) keeps it there instead of folding the
;; literal back into the shift. Emitted, that is a `movq $imm` once in the
;; preheader plus a bare `btq` per iteration, and NO `movabsq` of the mask
;; anywhere -- `movabsq` is the emitter's operand-materialization spelling
;; (compiler-backend-emit-load-i64-absolute), so its absence is a precise
;; witness that the constant is not being rebuilt at the test. The eighth
;; constant (70) stays outside the window as the chain's tail compare, leaving
;; the seven that the profitability floor needs.
(define compiler-backend-wide-bit-test-mask-source : String
  "(define (wbt-classify [c : i64]) : bool
  (if (= c 33)
    true
    (if (= c 37)
      true
      (if (= c 42)
        true
        (if (= c 43)
          true
          (if (= c 45)
            true
            (if (= c 47)
              true
              (if (= c 66)
                true
                (= c 70)))))))))
(define (wbt-count [n : i64] [seed : i64]) : i64
  (let
    [i : i64 0]
    [c : i64 seed]
    [hits : i64 0]
    (begin
      (while (< i n)
        (begin
          (if (wbt-classify c)
            (set! hits (+ hits 1))
            unit)
          (set! c (+ c 1))
          (set! i (+ i 1))))
      hits)))
(define (keep2 [f : (-> i64 i64 i64)]) : i64 0)
(define (main) : i64 (keep2 wbt-count))")

(define (compiler-backend-wide-bit-test-mask-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-wide-bit-test-mask-source))
    (compiler_backend.CompilerBackendTarget.Linux))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        ;; The chain became one bit test.
        (compiler_backend.compiler-backend-string-contains? asm "    btq ")
        ;; The mask reaches the emitter as its own `Mov`, spelled with the plain
        ;; `movq $imm` form -- it is materialized once where that Mov landed.
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq $8589956625")
        ;; ...and never as an operand materialization at the test itself, which
        ;; is what folding the literal into the shift used to emit per entry.
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "movabsq $8589956625")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-tail-dispatch-no-csr-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-tail-dispatch-source))
    (compiler_backend.CompilerBackendTarget.Linux))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (let
        [body : String
          (compiler-backend-asm-function-body asm "_tl_tc_dispatch")]
        (and
          (not (string.eq body ""))
          ;; No callee-saved register is saved OR restored: the plan's CSR set is
          ;; empty, so the tail-jump tail (compiler-backend-tail-jump-tail, which
          ;; derives its restores from that same plan) emits none either.
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "    pushq "))
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "    popq "))
          ;; The parameters are read straight out of their incoming ABI registers
          ;; instead of being copied to callee-saved homes in the prologue.
          (compiler_backend.compiler-backend-string-contains?
            body
            "    testq %rdi, %rdi\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "    movq %rdi, %r12\n"))
          ;; Arm 1's %rsi/%rdx 2-cycle is broken through a scratch register
          ;; instead of being emitted as two moves that overwrite a source
          ;; before it is read: %rdx is staged into %r9, %rsi lands in %rdx, and
          ;; the staged copy lands in %rsi.
          (compiler_backend.compiler-backend-string-contains?
            body
            "    movq %rdx, %r9\n")
          (compiler_backend.compiler-backend-string-contains?
            body
            "    movq %rsi, %rdx\n")
          (compiler_backend.compiler-backend-string-contains?
            body
            "    movq %r9, %rsi\n")
          ;; Every arm still leaves through a jmp, not a call/ret pair.
          (compiler_backend.compiler-backend-string-contains?
            body
            "    jmp _tl_tc_arm_a\n")
          (compiler_backend.compiler-backend-string-contains?
            body
            "    jmp _tl_tc_arm_b\n")
          (compiler_backend.compiler-backend-string-contains?
            body
            "    jmp _tl_tc_arm_c\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; M9: both `if`s test the same comparison, so GVN leaves ONE compare with two
;; branch readers. The backend fuses a compare into `cmp`/`jcc` only when every
;; reader is a branch fed by its own adjacent compare, so the shared boolean
;; used to be materialised (`cmp`/`setl`/`movzbq`) and tested at each site --
;; seven instructions where two fused pairs cost four. The late duplication pass
;; gives each branch its own copy. Address-taking the function keeps opt2 from
;; inlining the shape away.
(define compiler-backend-shared-compare-source : String
  "(define (cd-two-branch [a : i64] [b : i64] [c : i64]) : i64
  (let
    [t : i64 0]
    (begin
      (if (< a b)
        (set! t 1)
        (set! t 2))
      (if (< a b)
        (set! t (+ t (* c 3)))
        (set! t (+ t (* c 5))))
      t)))
(define (cd-keep [f : (-> i64 i64 i64 i64)]) : i64 0)
(define (main) : i64 (cd-keep cd-two-branch))")

(define (compiler-backend-shared-compare-duplication-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-shared-compare-source))
    (compiler_backend.CompilerBackendTarget.Linux))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (let
        [body : String
          (compiler-backend-asm-function-body asm "_tl_cd_two_branch")]
        (and
          (not (string.eq body ""))
          ;; Each branch owns a compare, and each of those fuses.
          (>=
            (compiler_backend.compiler-backend-string-count body "    cmpq ")
            2)
          ;; The boolean is never materialised, so neither half of the
          ;; `setcc`/`movzbq` pair survives and no site spends a `test`.
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "    setl "))
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "    movzbq "))
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "    testq "))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Flags reuse. Every `flag` below is stored to a global as well as branched on,
;; so the boolean MUST be materialised: `compiler-backend-var-fuse-safe?` sees a
;; non-branch reader and refuses the fusion, and the late compare duplication
;; refuses the copy for the same reason. `setcc` and `movzb` read EFLAGS and
;; write none, so the comparison's own flags survive the materialisation and the
;; adjacent branch takes its `jcc` directly instead of spending a `test` to
;; recompute what it already has. Address-taking the function keeps opt2 from
;; inlining the shape away; each case is its own program so every assertion
;; reads the same `_tl_fr_lt` body.
;;
;; Signed `<` with the false edge falling through to the then-block: the branch
;; jumps on the INVERSE of the boolean's own condition.
(define compiler-backend-flags-reuse-lt-source : String
  "(define fr-sink : bool false)
(define (fr-lt [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if flag (set! t (* a 3)) (set! t (+ b 7)))
      (set! fr-sink flag)
      t)))
(define (fr-keep [f : (-> i64 i64 i64)]) : i64 0)
(define (main) : i64 (fr-keep fr-lt))")

;; Unsigned `<` takes the unsigned condition on both halves.
(define compiler-backend-flags-reuse-ult-source : String
  "(define fr-sink : bool false)
(define (fr-lt [a : u64] [b : u64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if flag (set! t 3) (set! t 9))
      (set! fr-sink flag)
      t)))
(define (fr-keep [f : (-> u64 u64 i64)]) : i64 0)
(define (main) : i64 (fr-keep fr-lt))")

;; A negated condition only exchanges the successors, so the reused `jcc` is the
;; comparison's own with the labels swapped.
(define compiler-backend-flags-reuse-neg-source : String
  "(define fr-sink : bool false)
(define (fr-lt [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if (not flag) (set! t (* a 5)) (set! t (+ b 11)))
      (set! fr-sink flag)
      t)))
(define (fr-keep [f : (-> i64 i64 i64)]) : i64 0)
(define (main) : i64 (fr-keep fr-lt))")

;; Float comparisons are excluded, as they are from every other fusion here.
(define compiler-backend-flags-reuse-f64-source : String
  "(define fr-sink : bool false)
(define (fr-lt [a : f64] [b : f64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if flag (set! t 13) (set! t 19))
      (set! fr-sink flag)
      t)))
(define (fr-keep [f : (-> f64 f64 i64)]) : i64 0)
(define (main) : i64 (fr-keep fr-lt))")

;; The window is closed at zero instructions: storing the boolean BEFORE the
;; branch puts something between the materialisation and the jump -- here a
;; flag-preserving `movb`, and it is refused all the same -- so the `test` stays.
(define compiler-backend-flags-reuse-gap-source : String
  "(define fr-sink : bool false)
(define (fr-lt [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (set! fr-sink flag)
      (if flag (set! t (* a 3)) (set! t (+ b 7)))
      t)))
(define (fr-keep [f : (-> i64 i64 i64)]) : i64 0)
(define (main) : i64 (fr-keep fr-lt))")

;; The boolean materialises in every case (`setcc` and `movzb` both survive).
;; `reused?` says whether the branch then reads the comparison's own flags with
;; `jcc` and spends no `test`, or falls back to re-deriving them.
(define (compiler-backend-flags-reuse-body-ok?
  [source : String]
  [setcc : String]
  [jcc : String]
  [reused? : bool]) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    source
    (compiler_backend.CompilerBackendTarget.Linux))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_fr_lt")]
        (and
          (not (string.eq body ""))
          (compiler_backend.compiler-backend-string-contains? body setcc)
          (compiler_backend.compiler-backend-string-contains?
            body
            "    movzbq ")
          (if reused?
            (and
              (compiler_backend.compiler-backend-string-contains? body jcc)
              (not
                (compiler_backend.compiler-backend-string-contains?
                  body
                  "    testq ")))
            (compiler_backend.compiler-backend-string-contains?
              body
              "    testq "))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-flags-reuse-branch-ok?) : bool
  (and
    (compiler-backend-flags-reuse-body-ok?
      (string.copy (& compiler-backend-flags-reuse-lt-source))
      "    setl "
      "    jge "
      true)
    (compiler-backend-flags-reuse-body-ok?
      (string.copy (& compiler-backend-flags-reuse-ult-source))
      "    setb "
      "    jae "
      true)
    (compiler-backend-flags-reuse-body-ok?
      (string.copy (& compiler-backend-flags-reuse-neg-source))
      "    setl "
      "    jl "
      true)
    (compiler-backend-flags-reuse-body-ok?
      (string.copy (& compiler-backend-flags-reuse-f64-source))
      "    setb "
      ""
      false)
    (compiler-backend-flags-reuse-body-ok?
      (string.copy (& compiler-backend-flags-reuse-gap-source))
      "    setl "
      ""
      false)))

;; Runtime parity for the same peephole, in the compiler's own binary rather
;; than in inspected text: `compiler-backend-flags-reuse-arg` is mutable, so
;; these calls cannot fold away and the rewritten shape actually EXECUTES here.
;; The guard case is the sharp one -- it divides only on the taken edge, so a
;; mis-derived condition would trap on the zero divisor instead of returning 0.
(define compiler-backend-flags-reuse-arg : i64
  1)
(define compiler-backend-flags-reuse-flag : bool
  false)

(define (compiler-backend-flags-reuse-lt [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if flag
        (set! t (* a 3))
        (set! t (+ b 7)))
      (set! compiler-backend-flags-reuse-flag flag)
      t)))

(define (compiler-backend-flags-reuse-neg [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if (not flag)
        (set! t (* a 5))
        (set! t (+ b 11)))
      (set! compiler-backend-flags-reuse-flag flag)
      t)))

(define (compiler-backend-flags-reuse-guard [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if flag
        (set! t (/ 100 a))
        (set! t 0))
      (set! compiler-backend-flags-reuse-flag flag)
      t)))

(define (compiler-backend-flags-reuse-runtime-ok?) : bool
  (let
    [one : i64 compiler-backend-flags-reuse-arg]
    (and
      (= (compiler-backend-flags-reuse-lt one (+ one 1)) 3)
      compiler-backend-flags-reuse-flag
      (= (compiler-backend-flags-reuse-lt (+ one 4) (+ one 1)) 9)
      (not compiler-backend-flags-reuse-flag)
      (= (compiler-backend-flags-reuse-neg one (+ one 1)) 13)
      compiler-backend-flags-reuse-flag
      (= (compiler-backend-flags-reuse-neg (+ one 4) (+ one 1)) 25)
      (not compiler-backend-flags-reuse-flag)
      (= (compiler-backend-flags-reuse-guard (+ one 4) (+ one 8)) 20)
      (= (compiler-backend-flags-reuse-guard (- one 1) (- one 2)) 0))))

(define (compiler-backend-shifted-loop-bound-win64-ok?) : bool
  (let
    [ok : bool
      (match (compiler-backend-emit-source-opt2-for-target
        (string.copy (& compiler-backend-shifted-loop-bound-source))
        (compiler_backend.CompilerBackendTarget.Windows))
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (let
            [body : String
              (compiler-backend-asm-function-body asm "_tl_array_zero_count")]
            (and
              (not (string.eq body ""))
              (compiler_backend.compiler-backend-string-contains?
                body
                "    sarq $3,")
              ;; The full regalloc path may spill either compare operand, so
              ;; its exact register choice is intentionally not asserted
              ;; here. No emitted compare may instead test a register against
              ;; itself, which was the original zero-trip-loop corruption.
              (not (compiler-backend-compare-self-operand? body "%rax"))
              (not (compiler-backend-compare-self-operand? body "%rcx"))
              (not (compiler-backend-compare-self-operand? body "%rdx"))
              (not (compiler-backend-compare-self-operand? body "%r8"))
              (not (compiler-backend-compare-self-operand? body "%r9"))
              (not (compiler-backend-compare-self-operand? body "%r10"))
              (not (compiler-backend-compare-self-operand? body "%r11"))
              (compiler-backend-immediate-lhs-r9-compare-win64-ok?)))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    ok))

;; Three loops over four shared global arrays. LICM hoists a data pointer and a
;; length per array, so the descriptors are live across every loop and the
;; register pool is exhausted at the unrolled clear loop -- exactly the shape
;; that makes the allocator spill the clear loop's single-use address temps.
;; Slot coloring then used to merge all of those spilled temps onto ONE id whose
;; use count (recomputed on the remapped blocks) is in the dozens, which turned
;; off `compiler-backend-var-single-use?` and dropped every store onto the
;; generic staged emitter: two scratch registers saved to and restored from
;; their homes around a leaq, plus a home round-trip for the address, eleven
;; instructions where one indexed move does the job.
(define compiler-backend-fusion-pin-pressure-source : String
  "(define g-seed : (Array i64)
  (__tl_make-array i64 4))
(define g-reachable : (Array i64)
  (__tl_make-array i64 1))
(define g-postorder : (Array i64)
  (__tl_make-array i64 1))
(define g-rpo : (Array i64)
  (__tl_make-array i64 1))
(define g-rpo-num : (Array i64)
  (__tl_make-array i64 1))
(define g-blocks : i64
  0)
(define g-reach-count : i64
  0)

(define (kernel) : i64
  (let
    [count : i64 g-blocks]
    [i : i64 0]
    [post : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref g-reachable i) 0)
          (set! (array-ref g-postorder i) -1)
          (set! (array-ref g-rpo i) -1)
          (set! (array-ref g-rpo-num i) -1)
          (set! i (+ i 1))))
      (set! post g-reach-count)
      (set! i 0)
      (while (< i post)
        (begin
          (set! (array-ref g-rpo i) (array-ref g-postorder (- (- post 1) i)))
          (set! i (+ i 1))))
      (set! i 0)
      (while (< i post)
        (begin
          (set! (array-ref g-rpo-num (array-ref g-rpo i)) i)
          (set! i (+ i 1))))
      post)))

(define (main) : i64
  (let
    [n : i64 (array-ref g-seed 0)]
    (begin
      (set! g-blocks n)
      (set! g-reachable (__tl_make-array i64 (+ n 1)))
      (set! g-postorder (__tl_make-array i64 (+ n 1)))
      (set! g-rpo (__tl_make-array i64 (+ n 1)))
      (set! g-rpo-num (__tl_make-array i64 (+ n 1)))
      (kernel))))")

;; Slice one emitted basic block: labels start a line, every instruction is
;; indented, so the block runs from its label to the next line-initial dot.
(define (compiler-backend-asm-label-block [body : String] [label : String]) : String
  (let
    [marker : String (str_cat.str-cat label ":\n")]
    [start : i64
      (compiler_backend.compiler-backend-string-find-from body marker 0)]
    (if (< start 0)
      ""
      (let
        [block-start : i64 (+ start (string.string-length marker))]
        [next : i64
          (compiler_backend.compiler-backend-string-find-from
            body
            "\n."
            block-start)]
        [block-end : i64
          (if (< next 0)
            (string.string-length body)
            next)]
        (string.substring body block-start (- block-end block-start))))))

(define (compiler-backend-fusion-pin-unroll-body [asm : String]) : String
  (let
    [body : String (compiler-backend-asm-function-body asm "_tl_kernel")]
    [marker : i64
      (compiler_backend.compiler-backend-string-find-from
        body
        "__unroll_body:\n"
        0)]
    (if (< marker 0)
      ""
      (compiler-backend-asm-label-block
        (string.substring body marker (- (string.string-length body) marker))
        "__unroll_body"))))

(define (compiler-backend-fusion-pin-store-fusion-ok?) : bool
  (let
    [ok : bool
      (match (compiler-backend-emit-source-opt2-for-target
        (string.copy (& compiler-backend-fusion-pin-pressure-source))
        (compiler_backend.CompilerBackendTarget.Linux))
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (let
            [block : String (compiler-backend-fusion-pin-unroll-body asm)]
            (and
              (not (string.eq block ""))
              ;; Every unrolled clear store folds its address into an indexed
              ;; addressing mode: one instruction, no address temp at all.
              (>=
                (compiler_backend.compiler-backend-string-count block ",8)\n")
                64)
              ;; No address is materialised, and no scratch register or gep
              ;; result takes the round trip through a frame slot.
              (=
                (compiler_backend.compiler-backend-string-count block "leaq")
                0)
              (=
                (compiler_backend.compiler-backend-string-count block "(%rsp)")
                0)))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    ok))

(define (compiler-backend-peephole-assignments) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r12))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          (compiler_abi.compiler-abi-xmm-register-id 2)))
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          2
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r13))
        (compiler_regalloc.compiler-reg-assignment-table-empty)))))

(define (compiler-backend-expanded-scalar-assignments) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r8))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r9))
      (compiler_regalloc.compiler-reg-assignment-table-empty))))

(define (compiler-backend-expanded-scalar-regs-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-expanded-scalar-assignments)]
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (and
      (string.eq
        (compiler-backend-test-emit-load-var-with-plan assignments 0 "%rax")
        "    movq %r8, %rax\n")
      (string.eq
        (compiler_backend.compiler-backend-emit-store-var-with-plan
          assignments
          1
          "%rax"
          backend-state)
        "    movq %rax, %r9\n")
      (string.eq
        (compiler_backend.compiler-backend-emit-load-register
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          "%r8"
          (compiler_ast_types.AstType.U32))
        "    movl %r8d, %eax\n")
      (not
        (compiler_backend.compiler-backend-plan-uses-callee-regs?
          assignments
          backend-state))
      (=
        (compiler_backend.compiler-backend-frame-slots
          2
          assignments
          backend-state)
        2))))

(define (compiler-backend-callee-save-assignments1) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r12))
    (compiler_regalloc.compiler-reg-assignment-table-empty)))

(define (compiler-backend-callee-save-assignments2) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r12))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r13))
      (compiler_regalloc.compiler-reg-assignment-table-empty))))

(define (compiler-backend-callee-save-assignments3) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r12))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r13))
      (compiler_regalloc.compiler-reg-assignments-prepend
