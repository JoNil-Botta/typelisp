              (compiler-reg-assignment-cons
                (CompilerRegAssignment.Assignment
                  4
                  (CompilerRegLocation.Register "%r8"))
                CompilerRegAssignmentList.Nil)))))]
    (begin
      (array-set! starts 0 0)
      (array-set! starts 1 0)
      (array-set! starts 2 0)
      (array-set! starts 3 0)
      (array-set! starts 4 0)
      (array-set! ends 0 10)
      (array-set! ends 1 10)
      (array-set! ends 2 10)
      (array-set! ends 3 10)
      (array-set! ends 4 10)
      (and
        (string.eq
          (compiler-backend-scavenge-pick
            starts
            ends
            (compiler-reg-assignment-index-build r10-free 5)
            5
            5
            (compiler-backend-scavenge-exclude-with "%r13")
            6
            "%r8")
          "%r10")
        (string.eq
          (compiler-backend-scavenge-pick
            starts
            ends
            (compiler-reg-assignment-index-build r11-free 5)
            5
            5
            (compiler-backend-scavenge-exclude-with "%r13")
            6
            "%r8")
          "%r11")))))

(define (compiler-backend-scavenge-operand-excludes-keep-pooled-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 7)]
    [ends : (Array i64) (make-array i64 7)]
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r9"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%rcx"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.Register "%rdx"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                3
                (CompilerRegLocation.Register "%r8"))
              (compiler-reg-assignment-cons
                (CompilerRegAssignment.Assignment
                  5
                  (CompilerRegLocation.Register "%r13"))
                (compiler-reg-assignment-cons
                  (CompilerRegAssignment.Assignment
                    6
                    (CompilerRegLocation.Register "%r14"))
                  CompilerRegAssignmentList.Nil))))))]
    (begin
      (array-set! starts 0 0)
      (array-set! starts 1 0)
      (array-set! starts 2 0)
      (array-set! starts 3 0)
      (array-set! starts 4 0)
      (array-set! starts 5 0)
      (array-set! starts 6 0)
      (array-set! ends 0 10)
      (array-set! ends 1 10)
      (array-set! ends 2 10)
      (array-set! ends 3 10)
      (array-set! ends 4 10)
      (array-set! ends 5 10)
      (array-set! ends 6 10)
      (and
        (string.eq
          (compiler-backend-scavenge-pick
            starts
            ends
            (compiler-reg-assignment-index-build assignments 7)
            7
            5
            (compiler-backend-scavenge-exclude-regs2 "%r13" "%r14")
            7
            "%r8")
          "%r10")
        (string.eq
          (compiler-backend-scavenge-pick
            starts
            ends
            (compiler-reg-assignment-index-build assignments 7)
            7
            5
            (compiler-backend-scavenge-exclude-ops2
              assignments
              (CompilerIrValue.Var 5)
              (CompilerIrValue.Var 6))
            7
            "%r8")
          "%r10")))))

(define (compiler-backend-divmod-excludes-keep-scratch-fallbacks-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 1)]
    [ends : (Array i64) (make-array i64 1)]
    (and
      (string.eq
        (compiler-backend-scavenge-pick
          starts
          ends
          (compiler-reg-assignment-index-build CompilerRegAssignmentList.Nil 1)
          0
          0
          (compiler-backend-divmod-dividend-exclude "%r8")
          5
          "%r10")
        "%r10")
      (string.eq
        (compiler-backend-scavenge-pick
          starts
          ends
          (compiler-reg-assignment-index-build CompilerRegAssignmentList.Nil 1)
          0
          0
          (compiler-backend-divmod-mask-exclude "%r8" "%r10")
          6
          "%r9")
        "%r9"))))

(define (compiler-backend-test-reg-assignment-list-from
  [regs : (Array String)]
  [index : i64]) : CompilerRegAssignmentList
  (if (>= index (array-length regs))
    CompilerRegAssignmentList.Nil
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        index
        (CompilerRegLocation.Register (array-ref regs index)))
      (compiler-backend-test-reg-assignment-list-from regs (+ index 1)))))

(define (compiler-backend-test-fill-live-range!
  [starts : (Array i64)]
  [ends : (Array i64)]
  [count : i64]
  [start : i64]
  [end : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (array-set! starts i start)
          (array-set! ends i end)
          (set! i (+ i 1))))
      unit)))

(define (compiler-backend-scavenge-special-reg-bit-map-ok?) : bool
  (let
    [rax : i64 (compiler-backend-scavenge-reg-bit "%rax")]
    [rsi : i64 (compiler-backend-scavenge-reg-bit "%rsi")]
    [rdi : i64 (compiler-backend-scavenge-reg-bit "%rdi")]
    (and
      (not (= rax 0))
      (not (= rsi 0))
      (not (= rdi 0))
      (not (= rax rsi))
      (not (= rax rdi))
      (not (= rsi rdi))
      (=
        (compiler-backend-scavenge-reg-bit "%xmm2")
        (compiler-backend-scavenge-reg-bit "%vec2"))
      (=
        (compiler-backend-scavenge-reg-bit "%xmm3")
        (compiler-backend-scavenge-reg-bit "%ymm3"))
      (=
        (compiler-backend-scavenge-reg-bit "%xmm4")
        (compiler-backend-scavenge-reg-bit "%zmm4"))
      (= (compiler-backend-scavenge-reg-bit-by-index 15) rax)
      (= (compiler-backend-scavenge-reg-bit-by-index 16) rsi)
      (= (compiler-backend-scavenge-reg-bit-by-index 17) rdi))))

(define (compiler-backend-emergency-vector-width-ok?) : bool
  (let
    [prev-mode : CompilerBackendMode compiler-backend-current-mode]
    [prev-pending : bool compiler-backend-emergency-pending]
    [prev-reg : String compiler-backend-emergency-reg]
    [prev-used : bool compiler-backend-emergency-used]
    [prev-pending-count : i64 compiler-backend-emergency-pending-count]
    [prev-used-count : i64 compiler-backend-emergency-used-count]
    [prev-reg0 : String (array-ref compiler-backend-emergency-regs 0)]
    [prev-slot : i64 compiler-backend-emergency-slot-offset]
    [prev-suppressed : bool compiler-backend-emergency-restore-suppressed]
    [_init : unit
      (begin
        (compiler-backend-set-current-mode! (CompilerBackendMode.Avx2))
        (set! compiler-backend-emergency-pending false)
        (set! compiler-backend-emergency-used false)
        (set! compiler-backend-emergency-pending-count 0)
        (set! compiler-backend-emergency-used-count 0)
        (set! compiler-backend-emergency-slot-offset -512)
        (set! compiler-backend-emergency-restore-suppressed false)
        (compiler-backend-emergency-add! "%xmm2"))]
    [avx2 : String (compiler-backend-emergency-wrap "    nop\n")]
    [_avx512-init : unit
      (begin
        (compiler-backend-set-current-mode! (CompilerBackendMode.Avx512))
        (set! compiler-backend-emergency-pending false)
        (set! compiler-backend-emergency-pending-count 0)
        (set! compiler-backend-emergency-restore-suppressed false)
        (compiler-backend-emergency-add! "%xmm3"))]
    [avx512 : String (compiler-backend-emergency-wrap "    nop\n")]
    [ok : bool
      (and
        (= (compiler-backend-emergency-frame-extra 2) 128)
        (= (compiler-backend-emergency-reg-offset 1) -576)
        (compiler-backend-string-contains?
          avx2
          "    vmovdqu %ymm2, -512(%rbp)\n")
        (compiler-backend-string-contains?
          avx2
          "    vmovdqu -512(%rbp), %ymm2\n")
        (compiler-backend-string-contains?
          avx512
          "    vmovdqu64 %zmm3, -512(%rbp)\n")
        (compiler-backend-string-contains?
          avx512
          "    vmovdqu64 -512(%rbp), %zmm3\n"))]
    [_restore : unit
      (begin
        (compiler-backend-set-current-mode! prev-mode)
        (set! compiler-backend-emergency-pending prev-pending)
        (set! compiler-backend-emergency-reg prev-reg)
        (set! compiler-backend-emergency-used prev-used)
        (set! compiler-backend-emergency-pending-count prev-pending-count)
        (set! compiler-backend-emergency-used-count prev-used-count)
        (array-set! compiler-backend-emergency-regs 0 prev-reg0)
        (set! compiler-backend-emergency-slot-offset prev-slot)
        (set! compiler-backend-emergency-restore-suppressed prev-suppressed))]
    ok))

(define (compiler-backend-scavenge-widened-pool-picks-rsi-ok?) : bool
  (let
    [prev-win64 : bool (compiler-backend-current-fn-win64?)]
    [regs : (Array String) (make-array String 13)]
    [starts : (Array i64) (make-array i64 13)]
    [ends : (Array i64) (make-array i64 13)]
    [assignments : CompilerRegAssignmentList CompilerRegAssignmentList.Nil]
    [picked : String ""]
    [ok : bool false]
    (begin
      (array-set! regs 0 "%r9")
      (array-set! regs 1 "%rcx")
      (array-set! regs 2 "%rdx")
      (array-set! regs 3 "%r10")
      (array-set! regs 4 "%r11")
      (array-set! regs 5 "%r8")
      (array-set! regs 6 "%r12")
      (array-set! regs 7 "%r13")
      (array-set! regs 8 "%r14")
      (array-set! regs 9 "%r15")
      (array-set! regs 10 "%rbx")
      (array-set! regs 11 "%rdi")
      (array-set! regs 12 "%rax")
      (compiler-backend-test-fill-live-range! starts ends 13 0 10)
      (set! assignments (compiler-backend-test-reg-assignment-list-from regs 0))
      (compiler-backend-set-current-fn-linux!)
      (set! compiler-backend-emergency-pending false)
      (set! compiler-backend-emergency-used false)
      (set! compiler-backend-emergency-pending-count 0)
      (set! compiler-backend-emergency-used-count 0)
      (set!
        picked
        (compiler-backend-scavenge-pick
          starts
          ends
          (compiler-reg-assignment-index-build assignments 13)
          13
          4
          (array.make-array String 0)
          0
          "%r8"))
      (set!
        ok
        (and
          (string.eq picked "%rsi")
          (not compiler-backend-emergency-pending)
          (not compiler-backend-emergency-used)
          (= compiler-backend-emergency-pending-count 0)
          (= compiler-backend-emergency-used-count 0)))
      (if prev-win64
        (compiler-backend-set-current-fn-win64!)
        (compiler-backend-set-current-fn-linux!))
      ok)))

(define (compiler-backend-scavenge-win64-rsi-rdi-plan-mask-ok?) : bool
  (let
    [prev-win64 : bool (compiler-backend-current-fn-win64?)]
    [rsi-bit : i64 (compiler-backend-scavenge-reg-bit "%rsi")]
    [rdi-bit : i64 (compiler-backend-scavenge-reg-bit "%rdi")]
    [linux-ok : bool false]
    [win64-ok : bool false]
    (begin
      (compiler-backend-set-current-fn-linux!)
      (set!
        linux-ok
        (and
          (compiler-backend-scavenge-candidate-ok? 0 0 0 "%rsi")
          (compiler-backend-scavenge-candidate-ok? 0 0 0 "%rdi")))
      (compiler-backend-set-current-fn-win64!)
      (set!
        win64-ok
        (and
          (not (compiler-backend-scavenge-candidate-ok? 0 0 0 "%rsi"))
          (not (compiler-backend-scavenge-candidate-ok? 0 0 0 "%rdi"))
          (compiler-backend-scavenge-candidate-ok? 0 0 rsi-bit "%rsi")
          (compiler-backend-scavenge-candidate-ok? 0 0 rdi-bit "%rdi")))
      (if prev-win64
        (compiler-backend-set-current-fn-win64!)
        (compiler-backend-set-current-fn-linux!))
      (and linux-ok win64-ok))))

(define (compiler-backend-scratch-vreg-call-target-test-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.CallIndirectC
          2
          (CompilerIrValue.Var 1)
          (CompilerIrCallArgs.Nil)
          (AstType.I64))
        (compiler-ir-instr-cons
          ;; Give the pre-existing %r12 home a real, non-overlapping interval.
          ;; Interval-less assignments conservatively interfere with every
          ;; scratch request and would make this forcing fixture test fallback.
          (CompilerIrInstr.Mov 0 (CompilerIrValue.I64 7) (AstType.I64))
          CompilerIrInstrList.Nil)))
    CompilerIrBlockList.Nil))

(define (compiler-backend-scratch-vreg-call-target-test-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r10"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%r13"))
        CompilerRegAssignmentList.Nil))))

