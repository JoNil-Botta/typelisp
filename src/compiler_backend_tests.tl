        [(compiler_backend.ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-descriptor-pair-object-main) : compiler_ir_types.CompilerIrFunction
  (let
    [kind : compiler_ir_types.CompilerIrDescriptorPairKind
      (compiler_ir_types.CompilerIrDescriptorPairKind.OwnedString)]
    (compiler_ir_types.CompilerIrFunction.Function
      (ci.intern "main")
      compiler_ir_types.CompilerIrParamList.Nil
      (compiler_ast_types.AstType.I64)
      4
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "entry")
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.ir-instr-descriptor-pair-pack
              0
              (compiler_ir_types.CompilerIrValue.I64 123)
              (compiler_ir_types.CompilerIrValue.I64 42)
              kind)
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Mov
                1
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ast_types.AstType.String))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.ir-instr-descriptor-pair-data
                  2
                  (compiler_ir_types.CompilerIrValue.Var 1))
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.ir-instr-descriptor-pair-length
                    3
                    (compiler_ir_types.CompilerIrValue.Var 1))
                  (compiler_ir_types.compiler-ir-instr-cons
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Var 3)))
                    compiler_ir_types.CompilerIrInstrList.Nil))))))
        compiler_ir_types.CompilerIrBlockList.Nil))))

(define (compiler-backend-descriptor-pair-object-program) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler_ir_types.compiler-ir-global-seq-empty)
    (compiler_ir_types.compiler-ir-function-cons
      (compiler-backend-descriptor-pair-object-main)
      compiler_ir_types.CompilerIrFunctionList.Nil)
    compiler_ir_types.CompilerIrExternList.Nil))

(define (compiler-backend-descriptor-pair-object-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-program-object-image-target
    (compiler-backend-descriptor-pair-object-program)
    target
    (compiler_ir_types.compiler-source-spans-empty)
    true)
    [(compiler_backend.ResultCompilerBackendObject.Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList image.sections]
        [renders : bool
          (match target
            [(compiler_backend.CompilerBackendTarget.Linux)
              (match (elf.compiler-object-elf-render image)
                [(elf.ResultCompilerObjectElf.Ok _) true]
                [(elf.ResultCompilerObjectElf.Err _) false])]
            [(compiler_backend.CompilerBackendTarget.Windows)
              (match (coff.compiler-object-coff-render image)
                [(coff.ResultCompilerObjectCoff.Ok _) true]
                [(coff.ResultCompilerObjectCoff.Err _) false])])]
        (and
          renders
          ;; Four scalar vars plus a four-slot word1 region.
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler_backend.compiler-backend-object-prologue-bytes
              (compiler_backend.CompilerBackendTarget.Linux)
              (compiler_backend.compiler-backend-frame-size 8)))
          ;; Pack word1, copy it to the next pair, then extract it.
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler_backend.compiler-backend-object-store-slot-bytes 4 "%rdx"))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler_backend.compiler-backend-object-load-rbp-disp-bytes
              (compiler_backend.compiler-backend-object-slot-disp 4)
              "%rdx"))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler_backend.compiler-backend-object-store-slot-bytes 5 "%rdx"))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler_backend.compiler-backend-object-load-rbp-disp-bytes
              (compiler_backend.compiler-backend-object-slot-disp 5)
              "%rax"))))]
    [(compiler_backend.ResultCompilerBackendObject.Err _) false]))

(define (compiler-backend-descriptor-pair-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (let
    [program : compiler_ir_types.CompilerIrProgram
      (compiler-backend-descriptor-pair-program)]
    [program-index : compiler_backend.CompilerBackendProgramIndex
      (match program
        [(compiler_ir_types.CompilerIrProgram.Program _ functions externs)
          (compiler_backend.compiler-backend-program-index-build
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            functions
            externs)])]
    (and
      ;; The materialized String still consumes one ordinary ABI slot.
      (=
        (compiler_backend.compiler-backend-group-word-count
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          program-index
          (compiler_ast_types.AstType.String))
        1)
      (not
        (compiler_backend.compiler-backend-group-type?
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          program-index
          (compiler_ast_types.AstType.String)))
      (match (compiler_backend.compiler-backend-emit-program-for-target
        program
        target)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call _tl_f1\n")]
        [(compiler_backend.ResultCompilerBackend.Err _) false])
      (match (compiler_backend.compiler-backend-emit-program-object-image-target
        program
        target
        (compiler_ir_types.compiler-source-spans-empty)
        true)
        [(compiler_backend.ResultCompilerBackendObject.Ok _) true]
        [(compiler_backend.ResultCompilerBackendObject.Err _) false])
      (compiler-backend-descriptor-pair-object-target-ok? target))))

(define (compiler-backend-descriptor-pair-ok?) : bool
  (and
    (compiler-backend-descriptor-pair-spill-order-ok?)
    (compiler-backend-descriptor-pair-register-order-ok?)
    (compiler-backend-descriptor-pair-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-descriptor-pair-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

(define (compiler-backend-object-windows-stack-probe-ok?) : bool
  (let
    [linux : String
      (compiler_backend.compiler-backend-object-prologue-bytes
        (compiler_backend.CompilerBackendTarget.Linux)
        8192)]
    [windows : String
      (compiler_backend.compiler-backend-object-prologue-bytes
        (compiler_backend.CompilerBackendTarget.Windows)
        8192)]
    [direct : String
      (object_target.compiler-backend-object-bytes-from-hex
        "554889e54881ec00200000")]
    [probed : String
      (object_target.compiler-backend-object-bytes-from-hex
        "554889e54881ec00100000830c24004881ec00100000")]
    (and (string.eq linux direct) (string.eq windows probed))))

(define (compiler-backend-object-runtime-state-encoding-ok?) : bool
  (and
    ;; C7 /0 is compact but sign-extends imm32. The direct-object path must use
    ;; B8+r for wider values; native TLCI literal callbacks depend on all 64
    ;; bits surviving into their mapped entry.
    (string.eq
      (compiler_backend.compiler-backend-object-mov-i64-reg-bytes 42 "%rdx")
      (object_target.compiler-backend-object-bytes-from-hex "48c7c22a000000"))
    (string.eq
      (compiler_backend.compiler-backend-object-mov-i64-reg-bytes
        6364136223846793005
        "%rax")
      (object_target.compiler-backend-object-bytes-from-hex
        "48b82d7f954c2df45158"))
    (string.eq
      (compiler_backend.compiler-backend-object-mov-i64-reg-bytes
        -2147483649
        "%r9")
      (object_target.compiler-backend-object-bytes-from-hex
        "49b9ffffff7fffffffff"))
    (string.eq
      (compiler_backend.compiler-backend-object-lea-rbp-disp-bytes -64 "%rax")
      (object_target.compiler-backend-object-bytes-from-hex "488d45c0"))
    (string.eq
      (compiler_backend.compiler-backend-object-zero-compare-bytes
        (compiler_ir_types.CompilerIrBinOp.Eq))
      (object_target.compiler-backend-object-bytes-from-hex
        "4885c00f94c0480fb6c0"))
    (string.eq
      (compiler_backend.compiler-backend-object-divmod-bytes false false)
      (object_target.compiler-backend-object-bytes-from-hex "31d249f7f0"))
    (string.eq
      (compiler_backend.compiler-backend-object-divmod-bytes false true)
      (object_target.compiler-backend-object-bytes-from-hex "31d249f7f04889d0"))
    (string.eq
      (compiler_backend.compiler-backend-object-divmod-bytes true false)
      (object_target.compiler-backend-object-bytes-from-hex "489949f7f8"))
    (string.eq
      (compiler_backend.compiler-backend-object-divmod-bytes true true)
      (object_target.compiler-backend-object-bytes-from-hex "489949f7f84889d0"))))

(define (compiler-backend-reg-part-entry-ok?
  [reg : String]
  [reg32 : String]
  [reg16 : String]
  [reg8 : String]) : bool
  (and
    (string.eq
      (compiler_backend.compiler-backend-reg-part (string.copy reg) 8)
      reg)
    (string.eq
      (compiler_backend.compiler-backend-reg-part (string.copy reg) 4)
      reg32)
    (string.eq
      (compiler_backend.compiler-backend-reg-part (string.copy reg) 2)
      reg16)
    (string.eq
      (compiler_backend.compiler-backend-reg-part (string.copy reg) 1)
      reg8)))

(define (compiler-backend-reg-part-known-entry-ok? [reg : String]) : bool
  (cond
    [(string.eq reg "%rax")
      (compiler-backend-reg-part-entry-ok? reg "%eax" "%ax" "%al")]
    [(string.eq reg "%rbx")
      (compiler-backend-reg-part-entry-ok? reg "%ebx" "%bx" "%bl")]
    [(string.eq reg "%rcx")
      (compiler-backend-reg-part-entry-ok? reg "%ecx" "%cx" "%cl")]
    [(string.eq reg "%rdx")
      (compiler-backend-reg-part-entry-ok? reg "%edx" "%dx" "%dl")]
    [(string.eq reg "%rdi")
      (compiler-backend-reg-part-entry-ok? reg "%edi" "%di" "%dil")]
    [(string.eq reg "%rsi")
      (compiler-backend-reg-part-entry-ok? reg "%esi" "%si" "%sil")]
    [(string.eq reg "%r8")
      (compiler-backend-reg-part-entry-ok? reg "%r8d" "%r8w" "%r8b")]
    [(string.eq reg "%r9")
      (compiler-backend-reg-part-entry-ok? reg "%r9d" "%r9w" "%r9b")]
    [(string.eq reg "%r10")
      (compiler-backend-reg-part-entry-ok? reg "%r10d" "%r10w" "%r10b")]
    [(string.eq reg "%r11")
      (compiler-backend-reg-part-entry-ok? reg "%r11d" "%r11w" "%r11b")]
    [(string.eq reg "%r12")
      (compiler-backend-reg-part-entry-ok? reg "%r12d" "%r12w" "%r12b")]
    [(string.eq reg "%r13")
      (compiler-backend-reg-part-entry-ok? reg "%r13d" "%r13w" "%r13b")]
    [(string.eq reg "%r14")
      (compiler-backend-reg-part-entry-ok? reg "%r14d" "%r14w" "%r14b")]
    [(string.eq reg "%r15")
      (compiler-backend-reg-part-entry-ok? reg "%r15d" "%r15w" "%r15b")]
    [(string.eq reg "%rbp")
      (compiler-backend-reg-part-entry-ok? reg "%ebp" "%bp" "%bpl")]
    [else false]))

(define (compiler-backend-reg-part-seq-ok?
  [regs : compiler_regalloc.CompilerRegIdSeq]) : bool
  (let
    [index : i64 0]
    [ok : bool true]
    (begin
      (while (and
        (< index (compiler_regalloc.compiler-reg-id-seq-count regs))
        ok)
        (begin
          (if (compiler-backend-reg-part-known-entry-ok?
            (compiler_abi.compiler-abi-register-spelling
              (compiler_regalloc.compiler-reg-id-seq-ref regs index)))
            unit
            (set! ok false))
          (set! index (+ index 1))))
      ok)))

(define (compiler-backend-reg-part-pools-ok?) : bool
  (and
    (compiler-backend-reg-part-seq-ok?
      (compiler_regalloc.compiler-reg-sysv-integer-registers-with-rbp))
    (compiler-backend-reg-part-seq-ok?
      (compiler_regalloc.compiler-reg-zero-call-caller-saved-integer-registers))
    (compiler-backend-reg-part-seq-ok?
      (compiler_regalloc.compiler-reg-sysv-caller-saved-integer-registers))
    (compiler-backend-reg-part-seq-ok?
      (compiler_regalloc.compiler-reg-sysv-callee-saved-integer-registers))
    (compiler-backend-reg-part-seq-ok?
      (compiler_regalloc.compiler-reg-win64-caller-saved-integer-registers))
    (compiler-backend-reg-part-seq-ok?
      (compiler_regalloc.compiler-reg-win64-callee-saved-integer-registers))
    (compiler-backend-reg-part-seq-ok?
      (compiler_regalloc.compiler-reg-greedy-div-clobber-registers))))

(define (compiler-backend-scavenge-emergency-reg-support-ok?) : bool
  (and
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%rax")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%rcx")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%rdx")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%r8")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%r9")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%r10")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%r11")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%r12")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%r13")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%r14")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%r15")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%rbx")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%rsi")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported? "%rdi")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported?
      "%xmm2")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported?
      "%xmm3")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported?
      "%xmm4")
    (compiler_backend.compiler-backend-scavenge-emergency-reg-supported?
      "%xmm5")
    (not
      (compiler_backend.compiler-backend-scavenge-emergency-reg-supported?
        "%r16"))))

(define (compiler-backend-debug-location-preserves-emergency-wrap-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [previous-offset : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-slot-offset
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    (begin
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        false)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        false)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending-count!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        0)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used-count!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        0)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        -64)
      (compiler_backend.compiler-backend-emergency-add!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        "%r9")
      (let
        [rendered : String
          (text_buf.render
            (compiler_backend.compiler-backend-append-located-instr
              (text_buf.empty)
              "    .loc 1 2 3\n"
              "    shlq %cl, %r10\n"
              backend-state))]
        [ok : bool
          (string.eq
            rendered
            "    .loc 1 2 3\n    movq %r9, -64(%rbp)\n    shlq %cl, %r10\n    movq -64(%rbp), %r9\n")]
        (begin
          (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending!
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            false)
          (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used!
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            false)
          (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending-count!
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            0)
          (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used-count!
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            0)
          (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            previous-offset)
          ok)))))

(define (compiler-backend-ir-walker-call-use-counts-ok?) : bool
  (let
    [counts : (__tl_dyn-array i64) (array.make-array i64 12)]
    (begin
      (compiler_backend.compiler-backend-count-instr-uses
        counts
        (compiler_ir_types.CompilerIrInstr.CallIndirect
          0
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrCallArgs.Two
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.Var 3))
          (compiler_ast_types.AstType.I64)))
      (compiler_backend.compiler-backend-count-instr-uses
        counts
        (compiler_ir_types.CompilerIrInstr.CallIndirectC
          4
          (compiler_ir_types.CompilerIrValue.Var 4)
          (compiler_ir_types.CompilerIrCallArgs.One
            (compiler_ir_types.CompilerIrValue.Var 5))
          (compiler_ast_types.AstType.I64)))
      (compiler_backend.compiler-backend-count-instr-uses
        counts
        (compiler_ir_types.CompilerIrInstr.TailCall
          (ci.intern "tail")
          (compiler_ir_types.CompilerIrCallArgs.Two
            (compiler_ir_types.CompilerIrValue.Var 6)
            (compiler_ir_types.CompilerIrValue.Var 7))
          (compiler_ast_types.AstType.I64)))
      (compiler_backend.compiler-backend-count-instr-uses
        counts
        (compiler_ir_types.CompilerIrInstr.TailCallIndirect
          (compiler_ir_types.CompilerIrValue.Var 8)
          (compiler_ir_types.CompilerIrCallArgs.Two
            (compiler_ir_types.CompilerIrValue.Var 9)
            (compiler_ir_types.CompilerIrValue.Var 10))
          (compiler_ast_types.AstType.I64)))
      (and
        (compiler_backend.backend-and8
          (= (array-ref counts 1) 1)
          (= (array-ref counts 2) 1)
          (= (array-ref counts 3) 1)
          (= (array-ref counts 4) 1)
          (= (array-ref counts 5) 1)
          (= (array-ref counts 6) 1)
          (= (array-ref counts 7) 1)
          (= (array-ref counts 8) 1))
        (= (array-ref counts 9) 1)
        (= (array-ref counts 10) 1)))))

(define (compiler-backend-ir-walker-collections-ok?) : bool
  (let
    [ty : compiler_ast_types.AstType
      (compiler-backend-register-group-test-type)]
    [values : compiler_ir_types.CompilerIrValueList
      (compiler_ir_types.compiler-ir-value-cons
        (compiler_ir_types.CompilerIrValue.Function (ci.intern "walked_fn"))
        (compiler_ir_types.compiler-ir-value-cons
          (compiler_ir_types.CompilerIrValue.String "walked-string")
          (compiler_ir_types.compiler-ir-value-cons
            (compiler_ir_types.CompilerIrValue.F64
              (compiler-backend-test-f64-bits "2.5"))
            compiler_ir_types.CompilerIrValueList.Nil)))]
    [packed : compiler_backend.CompilerBackendProgramCollections
      (compiler_backend.compiler-backend-collect-instr-collections
        (compiler_backend.compiler-backend-program-collections-new)
        (compiler_ir_types.CompilerIrInstr.Pack 0 values ty))]
    [worded : compiler_backend.CompilerBackendProgramCollections
      (compiler_backend.compiler-backend-collect-instr-collections
        packed
        (compiler_ir_types.CompilerIrInstr.Word
          1
          (compiler_ir_types.CompilerIrValue.String "word-string")
          0
          ty))]
    (and
      (compiler_backend.compiler-backend-symbol-list-contains-id?
        (compiler_backend.compiler-backend-program-collections-functions worded)
        (ci.intern "walked_fn"))
      (compiler_backend.compiler-backend-string-list-contains?
        (compiler_backend.compiler-backend-program-collections-strings worded)
        "walked-string")
      (compiler_backend.compiler-backend-string-list-contains?
        (compiler_backend.compiler-backend-program-collections-strings worded)
        "word-string")
      (compiler-backend-test-float-seq-contains?
        (compiler_backend.compiler-backend-program-collections-floats worded)
        (compiler_ast_types.AstType.F64)
        (compiler-backend-test-f64-bits "2.5")))))

(define (compiler-backend-ir-walker-program-collections-ok?) : bool
  (let
    [call-array : (__tl_dyn-array compiler_ir_types.CompilerIrValue)
      (array.make-array compiler_ir_types.CompilerIrValue 2)]
    (begin
      (set!
        (array-ref call-array 0)
        (compiler_ir_types.CompilerIrValue.F64
          (compiler-backend-test-f64-bits "8.5")))
      (set!
        (array-ref call-array 1)
        (compiler_ir_types.CompilerIrValue.Bytes "arg-bytes"))
      (let
        [instrs : compiler_ir_types.CompilerIrInstrSeq
          (compiler_ir_types.compiler-ir-instr-seq-from-list
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Call
                0
                (ci.intern "direct")
                (compiler_ir_types.CompilerIrCallArgs.Two
                  (compiler_ir_types.CompilerIrValue.Function
                    (ci.intern "call_fn"))
                  (compiler_ir_types.CompilerIrValue.String "call-string"))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.CallIndirect
                  1
                  (compiler_ir_types.CompilerIrValue.Function
                    (ci.intern "indirect_fn"))
                  (compiler_ir_types.CompilerIrCallArgs.Array call-array)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.Phi
                    2
                    (compiler_ir_types.compiler-ir-phi-input-cons
                      (compiler_ir_types.CompilerIrValue.String "phi-string")
                      (compiler_ir_types.compiler-ir-label "entry")
                      compiler_ir_types.CompilerIrPhiInputList.Nil)
                    (compiler_ast_types.AstType.String))
                  (compiler_ir_types.compiler-ir-instr-cons
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.Bytes "return-bytes")))
                    compiler_ir_types.CompilerIrInstrList.Nil)))))]
        [blocks : compiler_ir_types.CompilerIrBlockList
          (compiler_ir_types.CompilerIrBlockList.Array
            (compiler_ir_types.compiler-ir-block-seq-from-list
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.CompilerIrBlock.Block
                  (compiler_ir_types.compiler-ir-label "entry")
                  instrs)
                compiler_ir_types.CompilerIrBlockList.Nil)))]
        [functions : compiler_ir_types.CompilerIrFunctionList
          (compiler_ir_types.CompilerIrFunctionList.Array
            (compiler_ir_types.compiler-ir-function-seq-from-list
              (compiler_ir_types.compiler-ir-function-cons
                (compiler_ir_types.CompilerIrFunction.Function
                  (ci.intern "main")
                  compiler_ir_types.CompilerIrParamList.Nil
                  (compiler_ast_types.AstType.I64)
                  3
                  blocks)
                compiler_ir_types.CompilerIrFunctionList.Nil)))]
        [globals : compiler_ir_types.CompilerIrGlobalSeq
          (compiler-backend-test-global-seq-single
            "global_text"
            (compiler_ast_types.AstType.String)
            (compiler_ir_types.CompilerIrValue.String "global-string"))]
        [collections : compiler_backend.CompilerBackendProgramCollections
          (compiler_backend.compiler-backend-collect-program-collections
            (compiler_ir_types.CompilerIrProgram.Program
              globals
              functions
              compiler_ir_types.CompilerIrExternList.Nil))]
        (and
          (compiler_backend.compiler-backend-symbol-list-contains-id?
            (compiler_backend.compiler-backend-program-collections-functions
              collections)
            (ci.intern "call_fn"))
          (compiler_backend.compiler-backend-symbol-list-contains-id?
            (compiler_backend.compiler-backend-program-collections-functions
              collections)
            (ci.intern "indirect_fn"))
          (compiler_backend.compiler-backend-string-list-contains?
            (compiler_backend.compiler-backend-program-collections-strings
              collections)
            "global-string")
          (compiler_backend.compiler-backend-string-list-contains?
            (compiler_backend.compiler-backend-program-collections-strings
              collections)
            "call-string")
          (compiler_backend.compiler-backend-string-list-contains?
            (compiler_backend.compiler-backend-program-collections-strings
              collections)
            "phi-string")
          (compiler-backend-test-float-seq-contains?
            (compiler_backend.compiler-backend-program-collections-floats
              collections)
            (compiler_ast_types.AstType.F64)
            (compiler-backend-test-f64-bits "8.5"))
          (compiler_backend.compiler-backend-string-list-contains?
            (compiler_backend.compiler-backend-program-collections-bytes
              collections)
            "arg-bytes")
          (compiler_backend.compiler-backend-string-list-contains?
            (compiler_backend.compiler-backend-program-collections-bytes
              collections)
            "return-bytes"))))))

(define (compiler-backend-ir-walker-group-metadata-array-ok?) : bool
  (let
    [plain-id : i64 (ci.intern "Issue5838Rooted")]
    [root-qualified-id : i64 (ci.intern "/Issue5838Rooted")]
    [qualified-id : i64 (ci.intern "issue5838/Collision")]
    [opaque-id : i64 (ci.intern-generated-canonical-name "issue5838/Collision")]
    [plain-key : i64 (compiler_ast_types.ast-nominal-name-id-key plain-id)]
    [root-key : i64
      (compiler_ast_types.ast-nominal-name-id-key root-qualified-id)]
    [qualified-key : i64
      (compiler_ast_types.ast-nominal-name-id-key qualified-id)]
    [opaque-key : i64 (compiler_ast_types.ast-nominal-name-id-key opaque-id)]
    [lifetimes : compiler_ast_types.AstLifetimeList
      (compiler_ast_types.ast-lifetime-list-new)]
    [struct-plain : compiler_ast_types.AstType
      (compiler_ast_types.AstType.Struct plain-id)]
    [struct-args-root : compiler_ast_types.AstType
      (compiler_ast_types.AstType.StructArgs root-qualified-id (box lifetimes))]
    [enum-qualified : compiler_ast_types.AstType
      (compiler_ast_types.AstType.Enum qualified-id)]
    [enum-args-qualified : compiler_ast_types.AstType
      (compiler_ast_types.AstType.EnumArgs qualified-id (box lifetimes))]
    [opaque-struct : compiler_ast_types.AstType
      (compiler_ast_types.AstType.Struct opaque-id)]
    [qualified-type-id : i64
      (compiler_ast_types.ast-node-pool-reader-type-push enum-qualified)]
    [region-qualified : compiler_ast_types.AstType
      (compiler_ast_types.AstType.Region
        (ci.intern "issue5838-region")
        qualified-type-id)]
    [bases : i64 (compiler_ast_types.ast-node-pool-reader-type-segment-bases)]
    [words-mask2 : compiler_ir_types.CompilerIrValueList
      (compiler_ir_types.compiler-ir-value-cons
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ir_types.compiler-ir-value-cons
          (compiler_ir_types.CompilerIrValue.F64
            (compiler-backend-test-f64-bits "3.5"))
          compiler_ir_types.CompilerIrValueList.Nil))]
    [words-opaque : compiler_ir_types.CompilerIrValueList
      (compiler_ir_types.compiler-ir-value-cons
        (compiler_ir_types.CompilerIrValue.F64
          (compiler-backend-test-f64-bits "5.5"))
        compiler_ir_types.CompilerIrValueList.Nil)]
    [instrs : compiler_ir_types.CompilerIrInstrSeq
      (compiler_ir_types.compiler-ir-instr-seq-from-list
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Pack 0 words-mask2 struct-plain)
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Pack
              1
              words-mask2
              struct-args-root)
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Pack
                2
                words-mask2
                enum-qualified)
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Pack
                  3
                  words-mask2
                  enum-args-qualified)
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.Pack
                    4
                    words-opaque
                    opaque-struct)
                  compiler_ir_types.CompilerIrInstrList.Nil))))))]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.CompilerIrBlockList.Array
        (compiler_ir_types.compiler-ir-block-seq-from-list
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.CompilerIrBlock.Block
              (compiler_ir_types.compiler-ir-label "entry")
              instrs)
            compiler_ir_types.CompilerIrBlockList.Nil)))]
    [functions : compiler_ir_types.CompilerIrFunctionList
      (compiler_ir_types.CompilerIrFunctionList.Array
        (compiler_ir_types.compiler-ir-function-seq-from-list
          (compiler_ir_types.compiler-ir-function-cons
            (compiler_ir_types.CompilerIrFunction.Function
              (ci.intern "main")
              compiler_ir_types.CompilerIrParamList.Nil
              (compiler_ast_types.AstType.I64)
              5
              blocks)
            compiler_ir_types.CompilerIrFunctionList.Nil)))]
    [index : compiler_backend.CompilerBackendProgramIndex
      (compiler_backend.compiler-backend-program-index-build
        bases
        functions
        compiler_ir_types.CompilerIrExternList.Nil)]
    (and
      (= plain-key root-key)
      (not (= qualified-key opaque-key))
      (string.eq
        (compiler_backend.compiler-backend-aggregate-type-name
          bases
          enum-qualified)
        (compiler_backend.compiler-backend-aggregate-type-name
          bases
          opaque-struct))
      (match (compiler_ast_types.ast-aggregate-type-key bases struct-plain)
        [(compiler_ast_types.AstMaybeNominalKey.Some key) (= key plain-key)]
        [(compiler_ast_types.AstMaybeNominalKey.None) false])
      (match (compiler_ast_types.ast-aggregate-type-key bases struct-args-root)
        [(compiler_ast_types.AstMaybeNominalKey.Some key) (= key plain-key)]
        [(compiler_ast_types.AstMaybeNominalKey.None) false])
      (match (compiler_ast_types.ast-aggregate-type-key bases enum-qualified)
        [(compiler_ast_types.AstMaybeNominalKey.Some key) (= key qualified-key)]
        [(compiler_ast_types.AstMaybeNominalKey.None) false])
      (match (compiler_ast_types.ast-aggregate-type-key
        bases
        enum-args-qualified)
        [(compiler_ast_types.AstMaybeNominalKey.Some key) (= key qualified-key)]
        [(compiler_ast_types.AstMaybeNominalKey.None) false])
      (match (compiler_ast_types.ast-aggregate-type-key bases region-qualified)
        [(compiler_ast_types.AstMaybeNominalKey.Some key) (= key qualified-key)]
        [(compiler_ast_types.AstMaybeNominalKey.None) false])
      (match (compiler_ast_types.ast-aggregate-type-key
        bases
        (compiler_ast_types.AstType.I64))
        [(compiler_ast_types.AstMaybeNominalKey.Some _) false]
        [(compiler_ast_types.AstMaybeNominalKey.None) true])
      (match (compiler_ir_types.compiler-ir-representation-index-kind-for-key
        index.representations
        plain-key)
        [(compiler_ir_types.CompilerIrRepresentationKind.RegisterGroup
            count
            mask)
          (and (= count 2) (= mask 2))]
        [_ false])
      (match (compiler_ir_types.compiler-ir-representation-index-kind-for-key
        index.representations
        qualified-key)
        [(compiler_ir_types.CompilerIrRepresentationKind.RegisterGroup
            count
            mask)
          (and (= count 2) (= mask 2))]
        [_ false])
      (match (compiler_ir_types.compiler-ir-representation-index-kind-for-key
        index.representations
        opaque-key)
        [(compiler_ir_types.CompilerIrRepresentationKind.Unknown) true]
        [_ false])
      (=
        (compiler_backend.compiler-backend-group-word-count
          bases
          index
          struct-plain)
        2)
      (=
        (compiler_backend.compiler-backend-group-word-count
          bases
          index
          struct-args-root)
        2)
      (=
        (compiler_backend.compiler-backend-group-word-count
          bases
          index
          enum-qualified)
        2)
      (=
        (compiler_backend.compiler-backend-group-word-count
          bases
          index
          enum-args-qualified)
        2)
      (=
        (compiler_backend.compiler-backend-group-word-count
          bases
          index
          region-qualified)
        2)
      (=
        (compiler_backend.compiler-backend-group-word-count
          bases
          index
          opaque-struct)
        1)
      (=
        (compiler_backend.compiler-backend-group-word-count
          bases
          index
          (compiler_ast_types.AstType.I64))
        1)
      (=
        (compiler_backend.compiler-backend-group-word-class-mask
          bases
          index
          struct-plain)
        2)
      (=
        (compiler_backend.compiler-backend-group-word-class-mask
          bases
          index
          struct-args-root)
        2)
      (=
        (compiler_backend.compiler-backend-group-word-class-mask
          bases
          index
          enum-qualified)
        2)
      (=
        (compiler_backend.compiler-backend-group-word-class-mask
          bases
          index
          enum-args-qualified)
        2)
      (=
        (compiler_backend.compiler-backend-group-word-class-mask
          bases
          index
          region-qualified)
        2)
      (=
        (compiler_backend.compiler-backend-group-word-class-mask
          bases
          index
          opaque-struct)
        0)
      (compiler_regalloc.compiler-reg-type-register-group?
        bases
        index.representations
        struct-plain)
      (compiler_regalloc.compiler-reg-type-register-group?
        bases
        index.representations
        struct-args-root)
      (compiler_regalloc.compiler-reg-type-register-group?
        bases
        index.representations
        enum-qualified)
      (compiler_regalloc.compiler-reg-type-register-group?
        bases
        index.representations
        enum-args-qualified)
      (compiler_regalloc.compiler-reg-type-register-group?
        bases
        index.representations
        region-qualified)
      (not
        (compiler_regalloc.compiler-reg-type-register-group?
          bases
          index.representations
          opaque-struct))
      (compiler_regalloc.compiler-reg-type-register-group-word-sse?
        bases
        index.representations
        struct-plain
        1)
      (compiler_regalloc.compiler-reg-type-register-group-word-sse?
        bases
        index.representations
        struct-args-root
        1)
      (compiler_regalloc.compiler-reg-type-register-group-word-sse?
        bases
        index.representations
        enum-qualified
        1)
      (not
        (compiler_regalloc.compiler-reg-type-register-group-word-sse?
          bases
          index.representations
          enum-qualified
          0))
      (not
        (compiler_regalloc.compiler-reg-type-register-group-word-sse?
          bases
          index.representations
          opaque-struct
          0))
      (not
        (compiler_regalloc.compiler-reg-type-register-group-word-sse?
          bases
          index.representations
          opaque-struct
          1)))))

(define (compiler-backend-ir-walker-object-refs-with-plan
  [plan : compiler_backend.CompilerBackendRuntimePlan]) : bool
  (let
    [ty : compiler_ast_types.AstType
      (compiler-backend-register-group-test-type)]
    [word-target-id : i64 (ci.intern "word_target")]
    [index : compiler_backend.CompilerBackendProgramIndex
      (compiler_backend.compiler-backend-program-index-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil)]
    [values : compiler_ir_types.CompilerIrValueList
      (compiler_ir_types.compiler-ir-value-cons
        (compiler_ir_types.CompilerIrValue.String "object-walked")
        (compiler_ir_types.compiler-ir-value-cons
          (compiler_ir_types.CompilerIrValue.F64
            (compiler-backend-test-f64-bits "6.25"))
          compiler_ir_types.CompilerIrValueList.Nil))]
    [packed : object_target.CompilerBackendObjectTargetParts
      (compiler_backend.compiler-backend-object-instr
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (object_target.compiler-backend-object-parts-empty)
        (compiler_backend.CompilerBackendTarget.Linux)
        "main"
        "main"
        (compiler_ir_types.compiler-ir-label "entry")
        compiler_ir_types.CompilerIrBlockList.Nil
        (compiler_ir_types.CompilerIrInstr.Pack 0 values ty)
        plan
        index)]
    [worded : object_target.CompilerBackendObjectTargetParts
      (compiler_backend.compiler-backend-object-instr
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        packed
        (compiler_backend.CompilerBackendTarget.Linux)
        "main"
        "main"
        (compiler_ir_types.compiler-ir-label "entry")
        compiler_ir_types.CompilerIrBlockList.Nil
        (compiler_ir_types.CompilerIrInstr.Word
          1
          (compiler_ir_types.CompilerIrValue.Function word-target-id)
          0
          ty)
        plan
        index)]
    [relocs : cobj.CompilerObjectRelocationList
      (cobj.compiler-object-relocation-builder-finish worded.relocations)]
    (and
      (cobj.compiler-object-relocation-list-contains?
        relocs
        (cobj.CompilerObjectRelocationKind.RipAddress)
        (compiler_backend.compiler-backend-string-fat-label "object-walked"))
      (cobj.compiler-object-relocation-list-contains?
        relocs
        (cobj.CompilerObjectRelocationKind.RipValue)
        (compiler_backend.compiler-backend-f64-label
          (compiler-backend-test-f64-bits "6.25")))
      (cobj.compiler-object-relocation-list-contains?
        relocs
        (cobj.CompilerObjectRelocationKind.RipAddress)
        (compiler_backend.compiler-backend-closure-descriptor-label
          "word_target")))))

(define (compiler-backend-ir-walker-object-refs-ok?) : bool
  (match (compiler_backend.compiler-backend-runtime-plan
    (compiler_ir_types.CompilerIrProgram.Program
      (compiler_ir_types.compiler-ir-global-seq-empty)
      compiler_ir_types.CompilerIrFunctionList.Nil
      compiler_ir_types.CompilerIrExternList.Nil))
    [(compiler_backend.ResultBackendRuntimePlan.Ok plan)
      (compiler-backend-ir-walker-object-refs-with-plan plan)]
    [(compiler_backend.ResultBackendRuntimePlan.Err _) false]))

(define (compiler-backend-ir-walkers-fail-closed-ok?) : bool
  (and
    (compiler-backend-ir-walker-call-use-counts-ok?)
    (compiler-backend-ir-walker-collections-ok?)
    (compiler-backend-ir-walker-program-collections-ok?)
    (compiler-backend-ir-walker-group-metadata-array-ok?)
    (compiler-backend-ir-walker-object-refs-ok?)))

(define (compiler-backend-peephole-asm-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-peephole-assignments)]
    (match (compiler_backend.compiler-backend-emit-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_regalloc.compiler-reg-var-types-empty)
      (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
      assignments
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 5)
      (compiler_ast_types.AstType.I64)
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(compiler_backend.ResultCompilerBackend.Ok add-asm)
        (match (compiler_backend.compiler-backend-emit-binop
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler_regalloc.compiler-reg-var-types-empty)
          (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
          assignments
          2
          (compiler_ir_types.CompilerIrBinOp.Mul)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ast_types.AstType.I64)
          (compiler_backend.compiler-backend-state-new
            (ci.intern-compat-state-capture-active)))
          [(compiler_backend.ResultCompilerBackend.Ok mul-asm)
            (match (compiler_backend.compiler-backend-emit-binop
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              (compiler_regalloc.compiler-reg-var-types-empty)
              (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
              assignments
              2
              (compiler_ir_types.CompilerIrBinOp.Shl
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.I64 2)
              (compiler_ast_types.AstType.I64)
              (compiler_backend.compiler-backend-state-new
                (ci.intern-compat-state-capture-active)))
              [(compiler_backend.ResultCompilerBackend.Ok shl-asm)
                (match (compiler_backend.compiler-backend-emit-binop
                  (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                  (compiler_regalloc.compiler-reg-var-types-empty)
                  (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
                  assignments
                  2
                  (compiler_ir_types.CompilerIrBinOp.Lt)
                  (compiler_ir_types.CompilerIrValue.Var 0)
                  (compiler_ir_types.CompilerIrValue.I64 10)
                  (compiler_ast_types.AstType.I64)
                  (compiler_backend.compiler-backend-state-new
                    (ci.intern-compat-state-capture-active)))
                  [(compiler_backend.ResultCompilerBackend.Ok cmp-asm)
                    (match (compiler_backend.compiler-backend-emit-branch
                      assignments
                      "peephole"
                      (compiler_ir_types.CompilerIrValue.Var 0)
                      (compiler_ir_types.compiler-ir-label "then")
                      (compiler_ir_types.compiler-ir-label "else")
                      (compiler_backend.CompilerBackendMaybeLabel.No)
                      (compiler_backend.compiler-backend-state-new
                        (ci.intern-compat-state-capture-active)))
                      [(compiler_backend.ResultCompilerBackend.Ok branch-asm)
                        (and
                          (compiler_backend.compiler-backend-string-contains?
                            add-asm
                            "    leaq 5(%r12), %r13\n")
                          (not
                            (compiler_backend.compiler-backend-string-contains?
                              add-asm
                              "    addq $5, %rax\n"))
                          (compiler_backend.compiler-backend-string-contains?
                            mul-asm
                            "    imulq $3, %r12, %r13\n")
                          (not
                            (compiler_backend.compiler-backend-string-contains?
                              mul-asm
                              "    imulq $3, %rax\n"))
                          (compiler_backend.compiler-backend-string-contains?
                            shl-asm
                            "    shlq $2, %r13\n")
                          (not
                            (compiler_backend.compiler-backend-string-contains?
                              shl-asm
                              "    movq $2, %r8\n"))
                          (compiler_backend.compiler-backend-string-contains?
                            cmp-asm
                            "    cmpq $10, %r13\n    setl %r13b\n")
                          (compiler_backend.compiler-backend-string-contains?
                            branch-asm
                            "    testq %r12, %r12\n    jne ")
                          (not
                            (compiler_backend.compiler-backend-string-contains?
                              branch-asm
                              "    movq %r12, %rax\n"))
                          (not
                            (compiler_backend.compiler-backend-string-contains?
                              branch-asm
                              "    cmpq $0, %rax\n    jne ")))]
                      [(compiler_backend.ResultCompilerBackend.Err _) false])]
                  [(compiler_backend.ResultCompilerBackend.Err _) false])]
              [(compiler_backend.ResultCompilerBackend.Err _) false])]
          [(compiler_backend.ResultCompilerBackend.Err _) false])]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

;; The `movq $7, %rax` line exists to CLOBBER %rax so the reload that follows it
;; is not elided. P22-A2 (a movq that fully redefines a register immediately
;; after another movq into it drops the first) would delete that clobber and
;; Explicit peephole session used by stateful carry/sweep tests. Production
;; wrappers create the same pair per standalone call; these tests keep it only
;; when they intentionally seed metadata before running the pass.
(defstruct CompilerBackendPeepholeTestSession
  (backend-state compiler_backend.CompilerBackendState)
  (stream compiler_backend.CompilerBackendStreamState))

(define (compiler-backend-peephole-test-session-new) : CompilerBackendPeepholeTestSession
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (CompilerBackendPeepholeTestSession
      backend-state
      (compiler_backend.compiler-backend-state-stream-state backend-state))))

(define (compiler-backend-peephole-test-session-reset!
  [session : CompilerBackendPeepholeTestSession]) : unit
  (begin
    (compiler_backend.compiler-backend-peephole-carry-safe-reset-with-backend-state!
      session.backend-state
      session.stream)
    (compiler_backend.compiler-backend-sweep-reset! session.stream)))

(define (compiler-backend-peephole-test-session-asm
  [session : CompilerBackendPeepholeTestSession]
  [asm : String]) : String
  (text_buf.render
    (compiler_backend.compiler-backend-peephole-asm-buffer-with-state
      session.backend-state
      session.stream
      asm
      false)))

(define (compiler-backend-peephole-test-session-win64!
  [session : CompilerBackendPeepholeTestSession]
  [symbol : String]
  [frame : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]) : unit
  (compiler_backend.compiler-backend-sweep-record-win64!
    session.backend-state
    session.stream
    symbol
    frame
    slot-vars
    em-slot-offset
    em-used-count
    outgoing))

(define (compiler-backend-peephole-test-win64-asm
  [symbol : String]
  [frame : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]
  [asm : String]) : String
  (let
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    (begin
      (compiler-backend-peephole-test-session-reset! session)
      (compiler-backend-peephole-test-session-win64!
        session
        symbol
        frame
        slot-vars
        em-slot-offset
        em-used-count
        outgoing)
      (compiler-backend-peephole-test-session-asm session asm))))

(define (compiler-backend-peephole-test-fpo-asm
  [symbol : String]
  [frame : i64]
  [push-count : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]
  [asm : String]) : String
  (let
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    (begin
      (compiler-backend-peephole-test-session-reset! session)
      (compiler_backend.compiler-backend-sweep-record-fpo!
        session.stream
        symbol
        frame
        push-count
        slot-vars
        em-slot-offset
        em-used-count
        outgoing
        session.backend-state)
      (compiler-backend-peephole-test-session-asm session asm))))

;; then the reload with it, so the clobbered value is consumed by
;; `movq %rax, -104(%rbp)` -- the owner-invalidation coverage is unchanged and
;; the pair stays out of A2's reach.
(define (compiler-backend-post-regalloc-peephole-ok?) : bool
  (let
    [input : String
      "label:
    movq %rax, %rax
    movq %rax, %r12
    movq %r12, %rax
    movq %rax, %r12
    movq %rax, -16(%rbp)
    movq -16(%rbp), %rax
    movq %r8, -24(%rbp)
    movq -24(%rbp), %r10
    movq %r8, -24(%rbp)
    movq %r9, -24(%rbp)
    movq %rax, -32(%rbp)
    movq %r8, -40(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -64(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -72(%rbp)
    movq $7, %rax
    movq %rax, -104(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -80(%rbp)
    movq %rax, 16(%rbp)
    movq %r8, 16(%rbp)
    movq -88(%rbp), %r12
    call _tl_side
    movq -88(%rbp), %rax
    movq -96(%rbp), %r8
    call _tl_side
    movq -96(%rbp), %r10
    movq -8(%rbp), %r8
    addq %r8, %rax
    movq $0, %r8
    movq %rax, %r9
    movq %r9, %r10
"]
    [want : String
      "label:
    movq %rax, %r12
    movq %rax, -16(%rbp)
    movq %r8, -24(%rbp)
    movq %r8, %r10
    movq %r9, -24(%rbp)
    movq %rax, -32(%rbp)
    movq %r8, -40(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -64(%rbp)
    movq %rax, -72(%rbp)
    movq $7, %rax
    movq %rax, -104(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -80(%rbp)
    movq %rax, 16(%rbp)
    movq %r8, 16(%rbp)
    movq -88(%rbp), %r12
    call _tl_side
    movq %r12, %rax
    movq -96(%rbp), %r8
    call _tl_side
    movq -96(%rbp), %r10
    movq -8(%rbp), %r8
    addq %r8, %rax
    movq $0, %r8
    movq %rax, %r9
    movq %r9, %r10
"]
    [direct : String
      (compiler_backend.compiler-backend-peephole-forward-frame-load-line
        "    movq %r8, -24(%rbp)"
        "    movq -24(%rbp), %r10")]
    [got : String (compiler_backend.compiler-backend-peephole-asm input)]
    (and (string.eq direct "    movq %r8, %r10") (string.eq got want))))

(define (compiler-backend-peephole-vector-gp-owners-ok?) : bool
  (let
    [input : String
      "    movq 16(%rsp), %r9
    vmovdqu (%r13,%r9,8), %ymm7
    movq 16(%rsp), %r9
    vpaddq (%r15,%r9,8), %ymm7, %ymm7
    movq 16(%rsp), %r9
    vmovdqu %ymm7, (%rbx,%r9,8)
    movq 16(%rsp), %r9
    vpmovmskb %ymm7, %r9
    movq 16(%rsp), %r9
"]
    [want : String
      "    movq 16(%rsp), %r9
    vmovdqu (%r13,%r9,8), %ymm7
    vpaddq (%r15,%r9,8), %ymm7, %ymm7
    vmovdqu %ymm7, (%rbx,%r9,8)
    movq 16(%rsp), %r9
    vpmovmskb %ymm7, %r9
    movq 16(%rsp), %r9
"]
    [got : String (compiler_backend.compiler-backend-peephole-asm input)]
    (string.eq got want)))

;; An action-2 pair drops the current line and keeps pending. Two consecutive
;; drops therefore reuse the current parser result slot while the pending
;; descriptor must remain backed by the other slot.
(define (compiler-backend-peephole-pending-parse-slot-ok?) : bool
  (let
    [input : String
      "    movq %rax, %r12
    movq %rax, %r12
    movq %rax, %r12
    addq $1, %r13
"]
    [want : String "    movq %rax, %r12
    addq $1, %r13
"]
    (string.eq (compiler_backend.compiler-backend-peephole-asm input) want)))

;; P22-A1: a spill store whose source register already mirrors the destination
;; slot writes back the value the slot holds and is dropped. The three positive
;; shapes are separated from the load by material the ADJACENT pair rules cannot
;; see through -- an unrelated single-dest op, and a carry-safe block label,
;; which is the emergency-scavenge `restore ; label ; resave` shape the emitter
;; actually produces. The negatives pin the invalidation: clobbering the register
;; and clobbering the slot each keep the store.
(define (compiler-backend-peephole-dead-mirror-store-ok?) : bool
  (let
    [gap-input : String
      "    movq 72(%rsp), %r9
    addq $1, %rax
    movq %r9, 72(%rsp)
"]
    [gap-want : String "    movq 72(%rsp), %r9
    addq $1, %rax
"]
    [label-input : String
      "    movq 72(%rsp), %r9
.Lf7_carry:
    movq %r9, 72(%rsp)
    addq $1, %r9
"]
    [label-want : String "    movq 72(%rsp), %r9
.Lf7_carry:
    addq $1, %r9
"]
    [store-first-input : String
      "    movq %r9, 72(%rsp)
    addq $1, %rax
    movq %r9, 72(%rsp)
"]
    [store-first-want : String "    movq %r9, 72(%rsp)
    addq $1, %rax
"]
    [reg-clobbered-input : String
      "    movq 72(%rsp), %r9
    addq $1, %r9
    movq %r9, 72(%rsp)
"]
    [slot-clobbered-input : String
      "    movq 72(%rsp), %r9
    movq %rax, 72(%rsp)
    addq $1, %rax
    movq %r9, 72(%rsp)
"]
    [unsafe-label-input : String
      "    movq 72(%rsp), %r9
.Lf7_merge:
    movq %r9, 72(%rsp)
    addq $1, %r9
"]
    [gap-got : String
      (compiler_backend.compiler-backend-peephole-asm gap-input)]
    [store-first-got : String
      (compiler_backend.compiler-backend-peephole-asm store-first-input)]
    [reg-clobbered-got : String
      (compiler_backend.compiler-backend-peephole-asm reg-clobbered-input)]
    [slot-clobbered-got : String
      (compiler_backend.compiler-backend-peephole-asm slot-clobbered-input)]
    [unsafe-label-got : String
      (compiler_backend.compiler-backend-peephole-asm unsafe-label-input)]
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    [_session-reset : unit
      (compiler-backend-peephole-test-session-reset! session)]
    [_carry-safe : unit
      (compiler_backend.compiler-backend-peephole-carry-safe-insert!
        session.backend-state
        session.stream
        ".Lf7_carry")]
    [label-got : String
      (compiler-backend-peephole-test-session-asm session label-input)]
    (and
      (string.eq gap-got gap-want)
      (string.eq label-got label-want)
      (string.eq store-first-got store-first-want)
      (string.eq reg-clobbered-got reg-clobbered-input)
      (string.eq slot-clobbered-got slot-clobbered-input)
      (string.eq unsafe-label-got unsafe-label-input))))

;; P22-A2: `movq SRC, %rX` immediately followed by a movq that rewrites the whole
;; of %rX without reading it drops the first line. The negatives pin the two
;; guards: a source that reads the register (bare or as a memory base/index) and
;; an untracked destination (%rbp) both keep the pair.
(define (compiler-backend-peephole-dead-reg-def-ok?) : bool
  (let
    [input : String
      "    movq 72(%rsp), %r9
    movq %rax, %r9
    movq %r9, 8(%rsp)
"]
    [want : String "    movq %rax, %r9
    movq %r9, 8(%rsp)
"]
    [read-input : String
      "    movq 72(%rsp), %r9
    movq (%r9), %r9
    movq %r9, 8(%rsp)
"]
    [index-input : String
      "    movq 72(%rsp), %r9
    movq 16(%rbx,%r9,8), %r9
    movq %r9, 8(%rsp)
"]
    [untracked-input : String
      "    movq 72(%rsp), %rbp
    movq %rax, %rbp
    movq %rbp, 8(%rsp)
"]
    [got : String (compiler_backend.compiler-backend-peephole-asm input)]
    [read-got : String
      (compiler_backend.compiler-backend-peephole-asm read-input)]
    [index-got : String
      (compiler_backend.compiler-backend-peephole-asm index-input)]
    [untracked-got : String
      (compiler_backend.compiler-backend-peephole-asm untracked-input)]
    (and
      (string.eq got want)
      (string.eq read-got read-input)
      (string.eq index-got index-input)
      (string.eq untracked-got untracked-input))))

(define (compiler-backend-peephole-detailed-abort-guard-ok?) : bool
  (let
    [input : String
      "    movq -8(%rbp), %r10
    cmpq $5, 16(%rbp)
    ja .Lf0_bounds_ok.1
    pushq 16(%rbp)
    pushq $5
    leaq .L_tl_abort_site_1_bounds(%rip), %rdi
    popq %rsi
    popq %rdx
    call tl_oob_abort_at
    jmp .L_tl_abort_site_1_bounds_end
    .balign 8
.L_tl_abort_site_1_bounds:
    .quad .L_tl_str_data
    .quad 18
    .quad 4
    .quad 9
.L_tl_abort_site_1_bounds_end:
.Lf0_bounds_ok.1:
    movq -8(%rbp), %r10
    movq (%r10), %rax
"]
    [want : String
      "    movq -8(%rbp), %r10
    cmpq $5, 16(%rbp)
    ja .Lf0_bounds_ok.1
    pushq 16(%rbp)
    pushq $5
    leaq .L_tl_abort_site_1_bounds(%rip), %rdi
    popq %rsi
    popq %rdx
    call tl_oob_abort_at
    jmp .L_tl_abort_site_1_bounds_end
    .balign 8
.L_tl_abort_site_1_bounds:
    .quad .L_tl_str_data
    .quad 18
    .quad 4
    .quad 9
.L_tl_abort_site_1_bounds_end:
.Lf0_bounds_ok.1:
    movq (%r10), %rax
"]
    [got : String (compiler_backend.compiler-backend-peephole-asm input)]
    (string.eq got want)))

;; The folded fallthrough-`jmp` deletion: a candidate whose target is reached
;; across label definitions only is excised; anything else keeps it.
(define (compiler-backend-peephole-drop-fallthrough-chain-ok?) : bool
  (let
    [chain-input : String
      "    movq $1, %rax
    jmp .Lmerge
.Lelse:
.Lmerge:
    movq %rax, -8(%rbp)
"]
    [chain-want : String
      "    movq $1, %rax
.Lelse:
.Lmerge:
    movq %rax, -8(%rbp)
"]
    [kept-input : String
      "    movq $1, %rax
    jmp .Lmerge
.Lelse:
    movq $2, %rax
.Lmerge:
    movq %rax, -8(%rbp)
"]
    [end-input : String "    movq $1, %rax
    jmp .Lmerge
"]
    [backward-input : String ".Lloop:
    movq $1, %rax
    jmp .Lloop
"]
    [chain-got : String
      (compiler_backend.compiler-backend-peephole-asm-drop-fallthrough
        chain-input)]
    [kept-got : String
      (compiler_backend.compiler-backend-peephole-asm-drop-fallthrough
        kept-input)]
    [end-got : String
      (compiler_backend.compiler-backend-peephole-asm-drop-fallthrough
        end-input)]
    [backward-got : String
      (compiler_backend.compiler-backend-peephole-asm-drop-fallthrough
        backward-input)]
    (and
      (string.eq chain-got chain-want)
      (string.eq kept-got kept-input)
      (string.eq end-got end-input)
      (string.eq backward-got backward-input))))

;; Sharpest edge of the folded deletion: with the `jmp` suppressed the guard-ok
;; label must still see prev-abort? = true, so the owner map carries and the
;; reload after the label is elided.
(define (compiler-backend-peephole-drop-fallthrough-abort-guard-ok?) : bool
  (let
    [input : String
      "    movq -8(%rbp), %r10
    cmpq $5, 16(%rbp)
    ja .Lf0_bounds_ok.1
    pushq 16(%rbp)
    pushq $5
    leaq .L_tl_abort_site_1_bounds(%rip), %rdi
    popq %rsi
    popq %rdx
    call tl_oob_abort_at
    jmp .Lf0_bounds_ok.1
.Lf0_bounds_ok.1:
    movq -8(%rbp), %r10
    movq (%r10), %rax
"]
    [want : String
      "    movq -8(%rbp), %r10
    cmpq $5, 16(%rbp)
    ja .Lf0_bounds_ok.1
    pushq 16(%rbp)
    pushq $5
    leaq .L_tl_abort_site_1_bounds(%rip), %rdi
    popq %rsi
    popq %rdx
    call tl_oob_abort_at
.Lf0_bounds_ok.1:
    movq (%r10), %rax
"]
    [got : String
      (compiler_backend.compiler-backend-peephole-asm-drop-fallthrough input)]
    (string.eq got want)))

(define (compiler-backend-deadstore-sweep-win64-rbp-frame-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    .seh_pushreg %rbp
    movq %rsp, %rbp
    .seh_setframe %rbp, 0
    subq $48, %rsp
    .seh_stackalloc 48
    .seh_endprologue
    movq %r9, 40(%rsp)
    leave
    ret
    .seh_endproc
"]
    [want : String
      "main:
    pushq %rbp
    .seh_pushreg %rbp
    movq %rsp, %rbp
    .seh_setframe %rbp, 0
    subq $48, %rsp
    .seh_stackalloc 48
    .seh_endprologue
    leave
    ret
    .seh_endproc
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 1 0 0 0 input)]
    (string.eq got want)))

(define (compiler-backend-deadstore-sweep-win64-csr-stays-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r12, 32(%rsp)
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 1 0 0 0 input)]
    (string.eq got input)))

(define (compiler-backend-deadstore-sweep-win64-address-stays-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leaq 40(%rsp), %rax
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 1 0 0 0 input)]
    (string.eq got input)))

(define (compiler-backend-deadstore-sweep-win64-pop-tail-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leaq 24(%rsp), %rsp
    popq %r13
    popq %r12
    leave
    ret
"]
    [want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    leaq 24(%rsp), %rsp
    popq %r13
    popq %r12
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 1 0 0 0 input)]
    (string.eq got want)))

(define (compiler-backend-deadstore-sweep-linux-leave-poisons-ok?) : bool
  (let
    [input : String
      "main:
    subq $56, %rsp
    movq %r9, 40(%rsp)
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-fpo-asm "main" 48 0 1 0 0 0 input)]
    (string.eq got input)))

(define (compiler-backend-deadstore-sweep-metadata-consumed-ok?) : bool
  (let
    [first : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leave
    ret
"]
    [first-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    leave
    ret
"]
    [second : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leave
    ret
"]
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    [_reset : unit (compiler-backend-peephole-test-session-reset! session)]
    [_record : unit
      (compiler-backend-peephole-test-session-win64! session "main" 48 1 0 0 0)]
    [first-got : String
      (compiler-backend-peephole-test-session-asm session first)]
    [second-got : String
      (compiler-backend-peephole-test-session-asm session second)]
    (and (string.eq first-got first-want) (string.eq second-got second))))

;; Pass 2's coverage bitmap serves the many-read tail: 50 live store+read
;; pairs and 50 dead stores interleaved, so the dead stores are swept and the
;; live ones kept, with the reads landing both before and after the stores.
(define (compiler-backend-deadstore-sweep-coverage-many-reads-ok?) : bool
  (let
    [input-buf : text_buf.TextBuf (text_buf.empty)]
    [want-buf : text_buf.TextBuf (text_buf.empty)]
    [k : i64 0]
    (begin
      (set!
        input-buf
        (text_buf.append
          input-buf
          "main:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $808, %rsp\n"))
      (set!
        want-buf
        (text_buf.append
          want-buf
          "main:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $808, %rsp\n"))
      (while (< k 50)
        (let
          [a : i64 (+ 8 (* 16 k))]
          [b : i64 (+ 16 (* 16 k))]
          [reg : String
            (if (= (% k 3) 0)
              "%r10"
              (if (= (% k 3) 1)
                "%r11"
                "%rax"))]
          (begin
            (set!
              input-buf
              (text_buf.append
                input-buf
                (str_cat.str-cat
                  "    movq $"
                  (string.int->string k)
                  ", "
                  (string.int->string a)
                  "(%rsp)\n    movq $"
                  (string.int->string k)
                  ", "
                  (string.int->string b)
                  "(%rsp)\n    movq "
                  (string.int->string a)
                  "(%rsp), "
                  reg
                  "\n")))
            (set!
              want-buf
              (text_buf.append
                want-buf
                (str_cat.str-cat
                  "    movq $"
                  (string.int->string k)
                  ", "
                  (string.int->string a)
                  "(%rsp)\n    movq "
                  (string.int->string a)
                  "(%rsp), "
                  reg
                  "\n")))
            (set! k (+ k 1)))))
      (let
        [input : String
          (text_buf.render (text_buf.append input-buf "    leave\n    ret\n"))]
        [want : String
          (text_buf.render (text_buf.append want-buf "    leave\n    ret\n"))]
        [got : String
          (compiler-backend-peephole-test-win64-asm "main" 808 100 0 0 0 input)]
        (string.eq got want)))))

;; Byte-granular coverage: unaligned and wide reads overlap exactly by byte
;; range, not by slot.
(define (compiler-backend-deadstore-sweep-coverage-unaligned-ok?) : bool
  (let
    [head : String
      "main:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $48, %rsp\n"]
    [tail : String "    leave\n    ret\n"]
    [no-overlap-input : String
      (str_cat.str-cat
        head
        "    movq $1, 8(%rsp)\n    movdqa 16(%rsp), %xmm0\n"
        tail)]
    [wide-overlap-input : String
      (str_cat.str-cat
        head
        "    movq $1, 8(%rsp)\n    movdqa 12(%rsp), %xmm0\n"
        tail)]
    [narrow-overlap-input : String
      (str_cat.str-cat
        head
        "    movq $1, 16(%rsp)\n    movq 20(%rsp), %rax\n"
        tail)]
    [no-overlap-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        no-overlap-input)]
    [wide-overlap-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        wide-overlap-input)]
    [narrow-overlap-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        narrow-overlap-input)]
    (and
      (string.eq
        no-overlap-got
        (str_cat.str-cat head "    movdqa 16(%rsp), %xmm0\n" tail))
      (string.eq wide-overlap-got wide-overlap-input)
      (string.eq narrow-overlap-got narrow-overlap-input))))

;; A candidate at exactly c == hi: an adjacent read ending at hi does not
;; cover [hi, hi+8), so the store is swept; a read of the slot keeps it.
(define (compiler-backend-deadstore-sweep-coverage-hi-edge-ok?) : bool
  (let
    [head : String
      "main:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $48, %rsp\n"]
    [tail : String "    leave\n    ret\n"]
    [adjacent-input : String
      (str_cat.str-cat
        head
        "    movq $1, 40(%rsp)\n    movq 32(%rsp), %rax\n"
        tail)]
    [covered-input : String
      (str_cat.str-cat
        head
        "    movq $1, 40(%rsp)\n    movq 40(%rsp), %rax\n"
        tail)]
    [adjacent-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        adjacent-input)]
    [covered-got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 5 0 0 0 covered-input)]
    (and
      (string.eq
        adjacent-got
        (str_cat.str-cat head "    movq 32(%rsp), %rax\n" tail))
      (string.eq covered-got covered-input))))

;; Both sides of the coverage-word cap produce the same decisions: the
;; under-cap frame uses the bitmap, the over-cap frame falls back to the
;; exact per-candidate scan.
(define (compiler-backend-deadstore-sweep-coverage-cap-ok?) : bool
  (let
    [under-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $262192, %rsp
    movq $1, 262184(%rsp)
    movq $2, 48(%rsp)
    movq 48(%rsp), %rax
    leave
    ret
"]
    [under-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $262192, %rsp
    movq $2, 48(%rsp)
    movq 48(%rsp), %rax
    leave
    ret
"]
    [over-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $262200, %rsp
    movq $1, 262192(%rsp)
    movq $2, 48(%rsp)
    movq 48(%rsp), %rax
    leave
    ret
"]
    [over-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $262200, %rsp
    movq $2, 48(%rsp)
    movq 48(%rsp), %rax
    leave
    ret
"]
    [under-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        262192
        32768
        0
        0
        0
        under-input)]
    [over-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        262200
        32769
        0
        0
        0
        over-input)]
    (and (string.eq under-got under-want) (string.eq over-got over-want))))

;; A leaq watermark poisons upward: candidates at or above the leaq's offset
;; stay even when no read names them; candidates below it are still swept.
(define (compiler-backend-deadstore-sweep-leaq-watermark-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 32(%rsp)
    movq $2, 16(%rsp)
    leaq 24(%rsp), %rax
    leave
    ret
"]
    [want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 32(%rsp)
    leaq 24(%rsp), %rax
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 5 0 0 0 input)]
    (string.eq got want)))

;; The reads set is region-wide: a read before the store keeps it just as a
;; read after it does.
(define (compiler-backend-deadstore-sweep-read-before-store-ok?) : bool
  (let
    [head : String
      "main:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $48, %rsp\n"]
    [tail : String "    leave\n    ret\n"]
    [before-input : String
      (str_cat.str-cat
        head
        "    movq 40(%rsp), %rax\n    movq $1, 40(%rsp)\n"
        tail)]
    [after-input : String
      (str_cat.str-cat
        head
        "    movq $1, 40(%rsp)\n    movq 40(%rsp), %rax\n"
        tail)]
    [before-got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 5 0 0 0 before-input)]
    [after-got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 5 0 0 0 after-input)]
    (and (string.eq before-got before-input) (string.eq after-got after-input))))

;; The coverage window spans both eligibility windows: emergency-slot
;; candidates are swept or kept by the same bitmap when the em window is
;; non-empty (em-slot-offset -512, 2 slots -> em window [-528, -408]).
(define (compiler-backend-deadstore-sweep-coverage-em-window-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, -520(%rsp)
    movq $2, -512(%rsp)
    movq -512(%rsp), %rax
    leave
    ret
"]
    [want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $2, -512(%rsp)
    movq -512(%rsp), %rax
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 5 -512 2 0 input)]
    (string.eq got want)))

;; Pass-1 fast paths: an inert record following a candidate must still poison
;; a Win64 epilogue tail, so nothing in the region is swept.
(define (compiler-backend-deadstore-sweep-win64-inert-tail-poison-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 40(%rsp)
    leaq 24(%rsp), %rsp
    movq %rax, %rbx
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 1 0 0 0 input)]
    (string.eq got input)))

;; Pass-1 fast paths: a candidate as the region's last record is swept by the
;; candidate hoist, and a candidate inside a Win64 epilogue tail still poisons
;; the region through that same hoist.
(define (compiler-backend-deadstore-sweep-candidate-last-ok?) : bool
  (let
    [last-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 40(%rsp)
"]
    [last-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
"]
    [tail-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 40(%rsp)
    leaq 24(%rsp), %rsp
    movq $2, 40(%rsp)
"]
    [last-got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 1 0 0 0 last-input)]
    [tail-got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 1 0 0 0 tail-input)]
    (and (string.eq last-got last-want) (string.eq tail-got tail-input))))

;; The candidate verifier's comma hint: a one-space `movq src, N(%rsp)` store
;; uses the descriptor's comma position (same decision as the scan), while a
;; two-space operand line takes the scan path and is not a candidate, both
;; exactly as before.
(define (compiler-backend-deadstore-sweep-candidate-comma-hint-ok?) : bool
  (let
    [hint-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 40(%rsp)
    movq $2, 32(%rsp)
    movq 40(%rsp), %rax
    leave
    ret
"]
    [hint-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 40(%rsp)
    movq 40(%rsp), %rax
    leave
    ret
"]
    [two-space-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq  $1, 40(%rsp)
    leave
    ret
"]
    [hint-got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 2 0 0 0 hint-input)]
    [two-space-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        2
        0
        0
        0
        two-space-input)]
    (and
      (string.eq hint-got hint-want)
      (string.eq two-space-got two-space-input))))

(define (compiler-backend-deadstore-sweep-win64-ok?) : bool
  (and
    (compiler-backend-deadstore-sweep-win64-rbp-frame-ok?)
    (compiler-backend-deadstore-sweep-win64-csr-stays-ok?)
    (compiler-backend-deadstore-sweep-win64-address-stays-ok?)
    (compiler-backend-deadstore-sweep-win64-pop-tail-ok?)
    (compiler-backend-deadstore-sweep-linux-leave-poisons-ok?)
    (compiler-backend-deadstore-sweep-metadata-consumed-ok?)
    (compiler-backend-deadstore-sweep-coverage-many-reads-ok?)
    (compiler-backend-deadstore-sweep-coverage-unaligned-ok?)
    (compiler-backend-deadstore-sweep-coverage-hi-edge-ok?)
    (compiler-backend-deadstore-sweep-coverage-cap-ok?)
    (compiler-backend-deadstore-sweep-leaq-watermark-ok?)
    (compiler-backend-deadstore-sweep-read-before-store-ok?)
    (compiler-backend-deadstore-sweep-coverage-em-window-ok?)
    (compiler-backend-deadstore-sweep-win64-inert-tail-poison-ok?)
    (compiler-backend-deadstore-sweep-candidate-last-ok?)
    (compiler-backend-deadstore-sweep-candidate-comma-hint-ok?)))

(define (compiler-backend-r10-dead-scan-long-gap-ok?) : bool
  (let
    [asm : String
      "    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rcx, %r10
"]
    [data : (Ptr u8)
      (unsafe
        (string-data asm))]
    (compiler_backend.compiler-backend-peephole-r10-dead-after?
      asm
      data
      0
      (string.string-length asm))))

;; The grouped TextBuf path must preserve pairs that cross arbitrary physical
;; chunks, while splitting safely at the following function's `.globl` chunk.
(define (compiler-backend-chunked-peephole-equivalent?) : bool
  (let
    [chunks : text_buf.TextBuf
      (text_buf.append
        (text_buf.append
          (text_buf.append
            (text_buf.append
              (text_buf.empty)
              ".text\n.globl first\nfirst:\n    movq %rax, %r")
            "10\n    movq 8(%r10), %r8\n")
          ".globl second\nsecond:\n    movq %rax, -8(%rbp)\n")
        "    movq -8(%rbp), %r9\n")]
    [input : String (text_buf.render chunks)]
    [legacy : String
      (compiler_backend.compiler-backend-peephole-asm-once input)]
    [chunked : String
      (text_buf.render
        (compiler_backend.compiler-backend-peephole-text-buf-once chunks))]
    (string.eq legacy chunked)))

;; Compare the final streaming path against the former raw-buffer -> whole
;; peephole -> sweep sequence on the same lowered program. Re-lowering resets
;; the recorded FPO sweep metadata before the streaming run.
(define (compiler-backend-streamed-final-output-equivalent-source?
  [src : String]) : bool
  (match (compiler_lower.lower-compiler-source src)
    [(compiler_lower.ResultCompilerLower.Ok first-program first-spans)
      (let
        [legacy-state : compiler_backend.CompilerBackendState
          (compiler_backend.compiler-backend-state-new
            (ci.intern-compat-state-capture-active))]
        [legacy-stream : compiler_backend.CompilerBackendStreamState
          (compiler_backend.compiler-backend-state-stream-state legacy-state)]
        (match (compiler_backend.compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
          legacy-state
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          first-program
          (compiler_backend.CompilerBackendTarget.Linux)
          (compiler_backend.CompilerBackendMode.Scalar)
          first-spans
          true
          false
          false
          (profile_state.compiler-profile-state-new))
          [(compiler_backend.ResultCompilerBackendBuffer.Ok raw)
            (let
              [legacy : String
                (text_buf.render
                  (compiler_backend.compiler-backend-peephole-asm-buffer-with-state
                    legacy-state
                    legacy-stream
                    (text_buf.render raw)
                    true))]
              (match (compiler_lower.lower-compiler-source src)
                [(compiler_lower.ResultCompilerLower.Ok
                    second-program
                    second-spans)
                  (match (compiler_backend.compiler-backend-emit-program-target-with-mode-final-buffer-and-crt
                    second-program
                    (compiler_backend.CompilerBackendTarget.Linux)
                    (compiler_backend.CompilerBackendMode.Scalar)
                    second-spans
                    true
                    false)
                    [(compiler_backend.ResultCompilerBackendBuffer.Ok streamed)
                      (string.eq legacy (text_buf.render streamed))]
                    [(compiler_backend.ResultCompilerBackendBuffer.Err _) false])]
                [(compiler_lower.ResultCompilerLower.Err _) false]))]
          [(compiler_backend.ResultCompilerBackendBuffer.Err _) false]))]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-streamed-final-output-equivalent?) : bool
  (compiler-backend-streamed-final-output-equivalent-source?
    (compiler-backend-smoke-source)))

;; 65 functions crosses the production 64-function raw batch boundary.
(define (compiler-backend-streamed-final-batch-equivalent?) : bool
  (let
    [buf : text_buf.TextBuf (text_buf.empty)]
    [i : i64 0]
    (begin
      (while (< i 65)
        (begin
          (set!
            buf
            (text_buf.append
              buf
              (str_cat.str-cat
                "(define (f"
                (string.int->string i)
                ") : i64 "
                (string.int->string i)
                ")\n")))
          (set! i (+ i 1))))
      (compiler-backend-streamed-final-output-equivalent-source?
        (text_buf.render
          (text_buf.append buf "(define (main) : i64 (+ (f0) (f64)))\n"))))))

