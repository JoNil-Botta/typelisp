(define (compiler-backend-float-to-u64-cast-shape-ok?
  [result : be_state.ResultCompilerBackend]
  [load : String]
  [op : String]
  [convert : String]
  [store : String]) : bool
  (match result
    [(Ok asm)
      (and
        (asm-has? asm load)
        (let
          [needle (str_cat.str-cat "    ucomi" (string.copy (& op)) " .L_tl_f")]
          (asm-has? asm needle))
        (let
          [needle (str_cat.str-cat "    sub" op " .L_tl_f")]
          (asm-has? asm needle))
        (asm-has? asm "    jae .Ltest_cast_cast_float_u64_entry_v1_high\n")
        (= (backend.compiler-backend-string-count asm convert) 2)
        (asm-has? asm "    btsq $63, " store)
        (asm-lacks? asm "%rax" "%xmm0"))]
    [(Err _) false]))

(define (compiler-backend-float-to-u64-cast-homes-ok?) : bool
  (and
    (compiler-backend-float-to-u64-cast-shape-ok?
      (compiler-backend-direct-float-to-u64-cast-asm (F64))
      "    movsd %xmm2, %xmm3\n"
      "sd"
      "    cvttsd2siq %xmm3, %r12\n"
      "")
    (compiler-backend-float-to-u64-cast-shape-ok?
      (compiler-backend-direct-float-to-u64-cast-asm (F32))
      "    movss %xmm2, %xmm3\n"
      "ss"
      "    cvttss2siq %xmm3, %r12\n"
      "")
    (compiler-backend-float-to-u64-cast-shape-ok?
      (compiler-backend-spill-dst-float-to-u64-cast-asm (F64))
      "    movsd %xmm3, %xmm2\n"
      "sd"
      "    cvttsd2siq %xmm2, %r8\n"
      "    movq %r8, -16(%rbp)\n")
    (compiler-backend-float-to-u64-cast-shape-ok?
      (compiler-backend-spill-dst-float-to-u64-cast-asm (F32))
      "    movss %xmm3, %xmm2\n"
      "ss"
      "    cvttss2siq %xmm2, %r8\n"
      "    movq %r8, -16(%rbp)\n")
    (compiler-backend-float-to-u64-cast-shape-ok?
      (compiler-backend-spill-src-float-to-u64-cast-asm (F64))
      "    movsd -8(%rbp), %xmm2\n"
      "sd"
      "    cvttsd2siq %xmm2, %r12\n"
      "")
    (compiler-backend-float-to-u64-cast-shape-ok?
      (compiler-backend-spill-src-float-to-u64-cast-asm (F32))
      "    movss -8(%rbp), %xmm2\n"
      "ss"
      "    cvttss2siq %xmm2, %r12\n"
      "")))

(define (compiler-backend-float-to-u64-threshold-collection-ok?) : bool
  (let
    [f64 : be_state.CompilerBackendProgramCollections
      (be_facts.compiler-backend-collect-instr-collections
        (compiler-backend-program-collections-new)
        (irt.instr "%1 = cast %0 : f64 to u64"))]
    [both : be_state.CompilerBackendProgramCollections
      (be_facts.compiler-backend-collect-instr-collections
        f64
        (irt.instr "%2 = cast %0 : f32 to u64"))]
    [floats : be_state.BackendFloatSeq
      (be_data.compiler-backend-program-collections-floats both)]
    (and
      (= floats.len 2)
      (match (__tl-project-field
        (owned_view.compiler-owned-element-view floats.slots 0)
        ty)
        [(F64) true]
        [_ false])
      (=
        (__tl-project-field (array-ref floats.slots 0) bits)
        4890909195324358656)
      (match (__tl-project-field
        (owned_view.compiler-owned-element-view floats.slots 1)
        ty)
        [(F32) true]
        [_ false])
      (= (__tl-project-field (array-ref floats.slots 1) bits) 1593835520))))

