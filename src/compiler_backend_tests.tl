(define (compiler-backend-total-switch-source) : String
  "(defenum TotalSwitchValue
  (Zero)
  (One)
  (Two)
  (Three)
  (Four)
  (Five))
(define (total-switch-score [value : TotalSwitchValue]) : i64
  (match value
    [(TotalSwitchValue.Zero) 1]
    [(TotalSwitchValue.One) 2]
    [(TotalSwitchValue.Two) 3]
    [(TotalSwitchValue.Three) 4]
    [(TotalSwitchValue.Four) 5]
    [(TotalSwitchValue.Five) 6]))
(define (keep-total-switch [f : (-> TotalSwitchValue i64)]) : i64 0)
(define (main) : i64 (keep-total-switch total-switch-score))")

(define (compiler-backend-total-switch-lowered-opt2-asm-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (compiler-backend-total-switch-source)
    (compiler_backend.CompilerBackendTarget.Linux))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains? asm "_switch_table")
        (not
          (compiler_backend.compiler-backend-string-contains? asm "    cmpq $5"))
        (not (compiler_backend.compiler-backend-string-contains? asm "    ja "))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "match_total_trap(%rip)")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-total-switch-asm-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-linux
    (compiler-backend-total-switch-test-program))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "main")]
        (and
          (compiler_backend.compiler-backend-string-contains?
            body
            (cfg
              scratch-vreg
              "    jmp *.Lf0_entry_switch_table(,%rax,8)\n"
              "    jmp *.Lf0_entry_switch_table(,%r8,8)\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "    cmpq $5"))
          (not
            (compiler_backend.compiler-backend-string-contains? body "    ja "))
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "leaq .Lf0_match_total_trap"))
          (=
            (compiler_backend.compiler-backend-string-count
              asm
              "    .quad .Lf0_")
            6)
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad .Lf0_zero\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad .Lf0_five\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-forwarded-total-switch-asm-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-linux
    (compiler-backend-forwarded-total-switch-test-program))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "main")]
        (and
          (compiler_backend.compiler-backend-string-contains?
            body
            (cfg
              scratch-vreg
              "    jmp *.Lf0_entry_switch_table(,%rax,8)\n"
              "    jmp *.Lf0_entry_switch_table(,%r8,8)\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "    cmpq $5"))
          (not
            (compiler_backend.compiler-backend-string-contains? body "    ja "))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-total-switch-pic-asm-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-pic-target-with-mode
    (compiler-backend-total-switch-test-program)
    (compiler_backend.CompilerBackendTarget.Linux)
    (compiler_backend.CompilerBackendMode.Scalar)
    (compiler_ir_types.compiler-source-spans-empty)
    true)
    [(compiler_backend.ResultCompilerBackendPic.Ok output)
      (let
        [asm : String output.asm]
        [body : String (compiler-backend-asm-function-body asm "main")]
        (and
          (compiler_backend.compiler-backend-string-contains?
            body
            "    leaq .Lf0_entry_switch_table(%rip), ")
          (compiler_backend.compiler-backend-string-contains? body "    jmp *(")
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "    cmpq $5"))
          (not
            (compiler_backend.compiler-backend-string-contains? body "    ja "))
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "leaq .Lf0_match_total_trap"))))]
    [(compiler_backend.ResultCompilerBackendPic.Err _) false]))

(define (compiler-backend-total-switch-object-image-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-object-image-linux
    (compiler-backend-total-switch-test-program)
    (compiler_ir_types.compiler-source-spans-empty))
    [(compiler_backend.ResultCompilerBackendObject.Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList image.sections]
        [relocs : cobj.CompilerObjectRelocationList image.relocations]
        (and
          (not
            (cobj.compiler-object-section-contains-bytes?
              sections
              (compiler_backend.compiler-backend-object-cmp-imm32-rax-bytes 5)))
          (cobj.compiler-object-section-contains-label?
            sections
            (cobj.CompilerObjectSectionKind.Rodata)
            ".Lf0_entry_switch_table_entry_5")
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (cobj.CompilerObjectRelocationKind.Abs64)
            ".Lf0_five")
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler_backend.compiler-backend-object-switch-indirect-jump-bytes))))]
    [(compiler_backend.ResultCompilerBackendObject.Err _) false]))

(define (compiler-backend-spoofed-total-switch-stays-checked?) : bool
  (and
    (match (compiler_backend.compiler-backend-emit-program-linux
      (compiler-backend-spoofed-total-switch-test-program))
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains? asm "    cmpq $5")
          (compiler_backend.compiler-backend-string-contains? asm "    ja "))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    (match (compiler_backend.compiler-backend-emit-program-object-image-linux
      (compiler-backend-spoofed-total-switch-test-program)
      (compiler_ir_types.compiler-source-spans-empty))
      [(compiler_backend.ResultCompilerBackendObject.Ok image)
        (cobj.compiler-object-section-contains-bytes?
          image.sections
          (compiler_backend.compiler-backend-object-cmp-imm32-rax-bytes 5))]
      [(compiler_backend.ResultCompilerBackendObject.Err _) false])))

(define (compiler-backend-switch-asm-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-linux
    (compiler-backend-switch-test-program))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        ;; FPO makes the switch scrutinee load rsp-relative (8(%rsp)).
        (compiler_backend.compiler-backend-string-contains?
          asm
          (cfg
            scratch-vreg
            "    movq 8(%rsp), %rax\n"
            "    movq 8(%rsp), %r8\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          (cfg scratch-vreg "    cmpq $2, %rax\n" "    cmpq $2, %r8\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    ja .Lf0_other\n")
        ;; Non-PIC Linux emits the absolute indexed dispatch (no table reg).
        (compiler_backend.compiler-backend-string-contains?
          asm
          (cfg
            scratch-vreg
            "    jmp *.Lf0_entry_switch_table(,%rax,8)\n"
            "    jmp *.Lf0_entry_switch_table(,%r8,8)\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    jmp *(%r11,%rax,8)\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    .section .rodata\n    .balign 8\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          ".Lf0_entry_switch_table:\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    .quad .Lf0_zero\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    .quad .Lf0_one\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    .quad .Lf0_two\n")
        (compiler_backend.compiler-backend-string-contains? asm ".text\n"))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-switch-base-test-program) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler_ir_types.compiler-ir-global-seq-empty)
    (compiler_ir_types.compiler-ir-function-cons
      (compiler_ir_types.CompilerIrFunction.Function
        (ci.intern "main")
        compiler_ir_types.CompilerIrParamList.Nil
        (compiler_ast_types.AstType.I64)
        1
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-block
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Switch
                (compiler_ir_types.CompilerIrValue.Var 0)
                4
                (compiler_ir_types.compiler-ir-switch-case-cons
                  4
                  (compiler_ir_types.compiler-ir-label "four")
                  (compiler_ir_types.compiler-ir-switch-case-cons
                    5
                    (compiler_ir_types.compiler-ir-label "five")
                    compiler_ir_types.CompilerIrSwitchCaseList.Nil))
                (compiler_ir_types.compiler-ir-label "other"))
              compiler_ir_types.CompilerIrInstrList.Nil))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.compiler-ir-block
              (compiler_ir_types.compiler-ir-label "four")
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.I64 4)))
                compiler_ir_types.CompilerIrInstrList.Nil))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.compiler-ir-block
                (compiler_ir_types.compiler-ir-label "five")
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.I64 5)))
                  compiler_ir_types.CompilerIrInstrList.Nil))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.compiler-ir-block
                  (compiler_ir_types.compiler-ir-label "other")
                  (compiler_ir_types.compiler-ir-instr-cons
                    (compiler_ir_types.CompilerIrInstr.Return
                      (compiler_ir_types.CompilerIrMaybeValue.Some
                        (compiler_ir_types.CompilerIrValue.I64 0)))
                    compiler_ir_types.CompilerIrInstrList.Nil))
                compiler_ir_types.CompilerIrBlockList.Nil)))))
      compiler_ir_types.CompilerIrFunctionList.Nil)
    compiler_ir_types.CompilerIrExternList.Nil))

(define (compiler-backend-switch-base-asm-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-linux
    (compiler-backend-switch-base-test-program))
