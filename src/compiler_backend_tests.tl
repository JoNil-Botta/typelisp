(define (compiler-backend-instr-diagnostics-ok?) : bool
  (and
    (compiler-backend-instr-diagnostic-case-ok?
      (Mov 0 (F64 (compiler-backend-test-f64-bits "1.0")) (I64))
      "backend: f64 values are not supported yet"
      21
      7)
    (compiler-backend-instr-diagnostic-case-ok?
      (BinOp
        1
        (Mod)
        (F64 (compiler-backend-test-f64-bits "1.0"))
        (F64 (compiler-backend-test-f64-bits "2.0"))
        (F64))
      "backend: unsupported float binary op"
      34
      9)
    ;; An unsupported f64 unary op is rejected. Neg and Sqrt have f64 lowering.
    (compiler-backend-instr-diagnostic-case-ok?
      (UnOp 2 (Not) (F64 (compiler-backend-test-f64-bits "1.0")) (F64))
      "backend: unsupported f64 unary op"
      40
      11)
    (compiler-backend-switch-asm-ok?)
    (compiler-backend-total-switch-asm-ok?)
    (compiler-backend-forwarded-total-switch-asm-ok?)
    (compiler-backend-total-switch-pic-asm-ok?)
    (compiler-backend-total-switch-object-image-ok?)
    (compiler-backend-spoofed-total-switch-stays-checked?)
    (compiler-backend-total-switch-lowered-opt2-asm-ok?)
    (compiler-backend-switch-base-asm-ok?)
    (compiler-backend-switch-shape-diagnostic-ok?)
    (compiler-backend-switch-phi-edge-copy-ok?)
    (compiler-backend-switch-negative-case-label-ok?)
    (compiler-backend-switch-object-image-ok?)
    (compiler-backend-switch-base-object-image-ok?)
    (compiler-backend-switch-object-shape-diagnostic-ok?)
    (compiler-backend-switch-object-phi-diagnostic-ok?)
    (compiler-backend-instr-diagnostic-case-ok?
      (ir.ir-instr-vector-bin-op 3 (Mod) (Var 0) (Var 1) 8 (I64))
      "backend: unsupported AVX-512 vector binary op"
      44
      13)))

(define (compiler-backend-avx2-map-source [elem : String]) : String
  (str_cat.str-cat
    "(define (main) : i64 0)
(define (fill [a : (__tl_dyn-array "
    elem
    ")] [b : (__tl_dyn-array "
    elem
    ")] [out : (__tl_dyn-array "
    elem
    ")] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (+ (array-ref a i) (array-ref b i)))))"))

(define (compiler-backend-uniform-map-source [elem : String]) : String
  (str_cat.str-cat
    "(define (main) : i64 0)
(define (fill [a : (__tl_dyn-array "
    elem
    ")] [b : (__tl_dyn-array "
    elem
    ")] [out : (__tl_dyn-array "
    elem
    ")] [n : i64] [r : "
    elem
    "]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (+ (+ (array-ref a i) (array-ref b i)) r))))"))

(define (compiler-backend-uniform-zip-source) : String
  "(define (main) : i64 0)
(define (fill [a : (__tl_dyn-array i64)] [b : (__tl_dyn-array i64)] [c : (__tl_dyn-array i64)] [out : (__tl_dyn-array i64)] [n : i64] [r : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (+ (+ (* (array-ref a i) (array-ref b i)) (array-ref c i)) r))))")

(define (compiler-backend-lane-id-rodata-source) : String
  "(define (main) : i64 0)
(define (fill [out : (__tl_dyn-array i64)] [other : (__tl_dyn-array i64)] [n : i64]) : unit
  (begin
    (foreach
      ([i : i64 0 n])
      (set! (array-ref out i) (program-index)))
    (foreach
      ([j : i64 0 n])
      (set! (array-ref other j) (program-index)))))")

(define (compiler-backend-lane-id-rodata-shape-ok?
  [lower-mode : lower.CompilerLowerMode]
  [backend-mode : be_state.CompilerBackendMode]
  [label : String]
  [align : String]
  [load : String]) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-lane-id-rodata-source)
    lower-mode)
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            backend-mode
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and4
                  (let
                    [needle
                      (str_cat.str-cat
                        "    .section .rodata\n"
                        align
                        label
                        ":\n")]
                    (asm-has? asm needle))
                  (=
                    (let
                      [needle (str_cat.str-cat label ":\n")]
                      (backend.compiler-backend-string-count asm needle))
                    1)
                  (>=
                    (let
                      [needle (str_cat.str-cat load " " label "(%rip), ")]
                      (backend.compiler-backend-string-count asm needle))
                    2)
                  (not
                    (let
                      [needle (str_cat.str-cat label ":\n" load)]
                      (asm-has? asm needle))))
                (asm-lacks? asm "vector/mask IR emission is not implemented"))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-lane-id-rodata-ok?) : bool
  (and
    (compiler-backend-lane-id-rodata-shape-ok?
      (lower.CompilerLowerMode.Avx2)
      (Avx2)
      (be_facts.compiler-backend-avx2-i64-lane-id-label)
      "    .balign 32\n"
      "    vmovdqa")
    (compiler-backend-lane-id-rodata-shape-ok?
      (lower.CompilerLowerMode.Avx512)
      (Avx512)
      (be_facts.compiler-backend-avx512-i64-lane-id-label)
      "    .balign 64\n"
      "    vmovdqa64")
    (match (lower.lower-compiler-source-with-mode
      (compiler-backend-lane-id-rodata-source)
      (lower.CompilerLowerMode.Avx2))
      [(Ok program spans lower-owner)
        (let
          [ok : bool
            (match (backend.compiler-backend-emit-program-target-with-mode
              program
              (be_state.CompilerBackendTarget.Linux)
              (Avx2)
              spans
              true)
              [(Ok asm)
                (let
                  [body : String
                    (compiler-backend-asm-function-body asm "_tl_fill")]
                  [loop : String (compiler-backend-avx2-loop-body body)]
                  (and
                    (not (string.eq loop ""))
                    (=
                      (let
                        [needle
                          (be_facts.compiler-backend-avx2-i64-lane-id-label)]
                        (backend.compiler-backend-string-count loop needle))
                      0)))]
              [(Err _) false])]
          (lower.compiler-lower-arena-state-release!
            (lower.compiler-lower-state-arenas lower-owner))
          ok)]
      [(Err _) false])))

(define (compiler-backend-avx2-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-avx2-map-source elem)
    (lower.CompilerLowerMode.Avx2))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx2)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and4
                  (asm-has? asm "    vzeroupper\n")
                  (asm-has? asm move)
                  (asm-has? asm op)
                  (asm-has? asm "%ymm"))
                (asm-lacks? asm "vector/mask IR emission is not implemented"))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-avx2-vector-map-ok?) : bool
  (and
    (compiler-backend-avx2-map-asm-contains? "i64" "    vmovdqu " "    vpaddq ")
    (compiler-backend-avx2-map-asm-contains? "i32" "    vmovdqu " "    vpaddd ")
    (compiler-backend-avx2-map-asm-contains? "i16" "    vmovdqu " "    vpaddw ")
    (compiler-backend-avx2-map-asm-contains? "u16" "    vmovdqu " "    vpaddw ")
    (compiler-backend-avx2-map-asm-contains? "f64" "    vmovupd " "    vaddpd ")
    (compiler-backend-avx2-map-asm-contains? "f32" "    vmovups " "    vaddps ")
    (compiler-backend-avx2-map-asm-contains? "i8" "    vmovdqu " "    vpaddb ")
    (compiler-backend-avx2-map-asm-contains? "u8" "    vmovdqu " "    vpaddb ")))

(define (compiler-backend-avx2-uniform-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]
  [broadcast : String]) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-uniform-map-source elem)
    (lower.CompilerLowerMode.Avx2))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx2)
            spans
            true)
            [(Ok asm)
              (let
                [body : String
                  (compiler-backend-asm-function-body asm "_tl_fill")]
                [loop : String (compiler-backend-avx2-loop-body body)]
                (and
                  (be_state.backend-and8
                    (asm-has? asm "    vzeroupper\n")
                    (asm-has? asm move)
                    (asm-has? asm op)
                    (asm-has? asm broadcast)
                    (asm-has? asm "%ymm")
                    (asm-lacks?
                      asm
                      "vector/mask IR emission is not implemented")
                    (= (backend.compiler-backend-string-count loop broadcast) 0)
                    true)
                  true))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-avx2-uniform-zip-ok?) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-uniform-zip-source)
    (lower.CompilerLowerMode.Avx2))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx2)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and8
                  (asm-has? asm "    vpbroadcastq ")
                  (asm-has? asm "    vpmuludq ")
                  (asm-has? asm "    vpsllq $32, ")
                  (asm-has? asm "    vpaddq ")
                  (asm-has? asm "    vmovdqu ")
                  (asm-has? asm "%ymm")
                  (asm-lacks? asm "vector/mask IR emission is not implemented")
                  true)
                true)]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

;; The uniform value may move when preheader caches change register pressure;
;; these checks care that its broadcast is emitted, not which spill owns it.
(define (compiler-backend-avx2-uniform-vector-map-ok?) : bool
  (and
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i64"
      "    vmovdqu "
      "    vpaddq "
      "    vpbroadcastq ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i32"
      "    vmovdqu "
      "    vpaddd "
      "    vpbroadcastd ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i16"
      "    vmovdqu "
      "    vpaddw "
      "    vpbroadcastw ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "u16"
      "    vmovdqu "
      "    vpaddw "
      "    vpbroadcastw ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "f64"
      "    vmovupd "
      "    vaddpd "
      "    vbroadcastsd ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "f32"
      "    vmovups "
      "    vaddps "
      "    vbroadcastss ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i8"
      "    vmovdqu "
      "    vpaddb "
      "    vpbroadcastb ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "u8"
      "    vmovdqu "
      "    vpaddb "
      "    vpbroadcastb ")
    (compiler-backend-avx2-uniform-zip-ok?)))

(define (compiler-backend-stack-splat-dst-only-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%vec6"))

(define (compiler-backend-stack-splat-spill-assignments [offset : i64]) : regalloc.CompilerRegAssignmentTable
  (regalloc.compiler-reg-assignments-prepend
    (&
      (regalloc.CompilerRegAssignment
        0
        (Register (cabi.compiler-abi-vector-register-id 6))))
    (regalloc.compiler-reg-assignments-prepend
      (& (regalloc.CompilerRegAssignment 1 (Spill offset)))
      (regalloc.compiler-reg-assignment-table-empty))))

(define (compiler-backend-stack-splat-register-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%vec6 %1=%r12"))

(define (compiler-backend-stack-splat-float-register-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%vec6 %1=%xmm3"))

(define (compiler-backend-stack-memory-operand-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (and
      (match (be_simd.compiler-backend-stack-memory-operand
        (compiler-backend-stack-splat-dst-only-assignments)
        (Var 1)
        backend-state)
        [(Some operand) (string.eq operand "-16(%rbp)")]
        [(No) false])
      (match (be_simd.compiler-backend-stack-memory-operand
        (compiler-backend-stack-splat-spill-assignments -40)
        (Var 1)
        backend-state)
        [(Some operand) (string.eq operand "-40(%rbp)")]
        [(No) false])
      (match (be_simd.compiler-backend-stack-memory-operand
        (compiler-backend-stack-splat-register-assignments)
        (Var 1)
        backend-state)
        [(Some _) false]
        [(No) true])
      (match (be_simd.compiler-backend-stack-memory-operand
        (compiler-backend-stack-splat-dst-only-assignments)
        (I64 7)
        backend-state)
        [(Some _) false]
        [(No) true]))))

(define (compiler-backend-avx2-stack-splat-i64-ok?) : bool
  (match (be_simd.compiler-backend-emit-vector-splat
    (Avx2)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-stack-splat-dst-only-assignments)
    0
    (Var 1)
    4
    (I64)
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (and
        (string.eq asm "    vpbroadcastq -16(%rbp), %ymm6\n")
        (asm-lacks? asm "%rax" "%xmm0"))]
    [(Err _) false]))

(define (compiler-backend-avx2-stack-splat-f64-spill-ok?) : bool
  (match (be_simd.compiler-backend-emit-vector-splat
    (Avx2)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-stack-splat-spill-assignments -40)
    0
    (Var 1)
    4
    (F64)
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (and
        (string.eq asm "    vbroadcastsd -40(%rbp), %ymm6\n")
        (asm-lacks? asm "%xmm0"))]
    [(Err _) false]))

(define (compiler-backend-avx512-stack-splat-i64-ok?) : bool
  (match (be_simd.compiler-backend-emit-vector-splat
    (Avx512)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-stack-splat-dst-only-assignments)
    0
    (Var 1)
    8
    (I64)
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (and
        (string.eq asm "    vpbroadcastq -16(%rbp), %zmm6\n")
        (asm-lacks? asm "%rax" "%xmm0"))]
    [(Err _) false]))

(define (compiler-backend-avx512-stack-splat-f64-spill-ok?) : bool
  (match (be_simd.compiler-backend-emit-vector-splat
    (Avx512)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-stack-splat-spill-assignments -40)
    0
    (Var 1)
    8
    (F64)
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (and
        (string.eq asm "    vbroadcastsd -40(%rbp), %zmm6\n")
        (asm-lacks? asm "%xmm0"))]
    [(Err _) false]))

(define (compiler-backend-register-splat-fallback-ok?) : bool
  (and
    (match (be_simd.compiler-backend-emit-vector-splat
      (Avx2)
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-stack-splat-register-assignments)
      0
      (Var 1)
      4
      (I64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(Ok asm)
        (and
          (string.eq
            asm
            "    movq %r12, %r8\n    vmovq %r8, %xmm2\n    vpbroadcastq %xmm2, %ymm6\n")
          (asm-lacks? asm "%rax" "%xmm0"))]
      [(Err _) false])
    (match (be_simd.compiler-backend-emit-vector-splat
      (Avx2)
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-stack-splat-float-register-assignments)
      0
      (Var 1)
      4
      (F64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(Ok asm)
        (and
          (string.eq
            asm
            "    movsd %xmm3, %xmm2\n    vbroadcastsd %xmm2, %ymm6\n")
          (asm-lacks? asm "%xmm0"))]
      [(Err _) false])
    (match (be_simd.compiler-backend-emit-vector-splat
      (Avx512)
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-stack-splat-register-assignments)
      0
      (Var 1)
      8
      (I64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(Ok asm)
        (and
          (string.eq asm "    movq %r12, %r8\n    vpbroadcastq %r8, %zmm6\n")
          (asm-lacks? asm "%rax"))]
      [(Err _) false])
    (match (be_simd.compiler-backend-emit-vector-splat
      (Avx512)
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-stack-splat-float-register-assignments)
      0
      (Var 1)
      8
      (F64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(Ok asm)
        (and
          (string.eq
            asm
            "    movsd %xmm3, %xmm2\n    vbroadcastsd %xmm2, %zmm6\n")
          (asm-lacks? asm "%xmm0"))]
      [(Err _) false])))

(define (compiler-backend-stack-splat-broadcast-ok?) : bool
  (and
    (compiler-backend-stack-memory-operand-ok?)
    (compiler-backend-avx2-stack-splat-i64-ok?)
    (compiler-backend-avx2-stack-splat-f64-spill-ok?)
    (compiler-backend-avx512-stack-splat-i64-ok?)
    (compiler-backend-avx512-stack-splat-f64-spill-ok?)
    (compiler-backend-register-splat-fallback-ok?)))

(define (compiler-backend-vector-spill-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%rdi %1=%r12 %2=%vec6 %3=spill:-64 %4=%k1"))

(define (compiler-backend-avx2-native-mask-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%rdi %1=%r12 %2=%vec6 %3=spill:-64 %4=%vec7 %5=%vec8"))

(define (compiler-backend-avx2-native-mask-emission-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-avx2-native-mask-assignments)]
    [diag : cdiag.CompilerDiagnostic (cdiag.compiler-diagnostic-at-start "" "")]
    (and
      (string.eq
        (let
          [elem-ty (ast.AstType.I32)]
          (be_operand.compiler-backend-avx2-masked-move-mnemonic elem-ty))
        "vpmaskmovd")
      (string.eq
        (let
          [elem-ty (ast.AstType.U32)]
          (be_operand.compiler-backend-avx2-masked-move-mnemonic elem-ty))
        "vpmaskmovd")
      (string.eq
        (let
          [elem-ty (ast.AstType.I64)]
          (be_operand.compiler-backend-avx2-masked-move-mnemonic elem-ty))
        "vpmaskmovq")
      (string.eq
        (let
          [elem-ty (ast.AstType.U64)]
          (be_operand.compiler-backend-avx2-masked-move-mnemonic elem-ty))
        "vpmaskmovq")
      (string.eq
        (let
          [elem-ty (ast.AstType.F32)]
          (be_operand.compiler-backend-avx2-masked-move-mnemonic elem-ty))
        "vmaskmovps")
      (string.eq
        (let
          [elem-ty (ast.AstType.F64)]
          (be_operand.compiler-backend-avx2-masked-move-mnemonic elem-ty))
        "vmaskmovpd")
      (string.eq
        (let
          [elem-ty (ast.AstType.I16)]
          (be_operand.compiler-backend-avx2-masked-move-mnemonic elem-ty))
        "")
      (match (be_simd.compiler-backend-emit-avx2-predicated-load
        (ast.ast-node-pool-reader-type-segment-bases)
        "native_mask"
        (ir.compiler-ir-label "entry")
        assignments
        3
        (Var 0)
        (I64 0)
        (Var 4)
        4
        (I64)
        (owned_view.compiler-owned-shared-view diag)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm)
          (string.eq
            asm
            "    vpmaskmovq (%rdi), %ymm7, %ymm14\n    vmovdqu %ymm14, -64(%rbp)\n")]
        [(Err _) false])
      (match (be_simd.compiler-backend-emit-avx2-predicated-store
        (ast.ast-node-pool-reader-type-segment-bases)
        "native_mask"
        (ir.compiler-ir-label "entry")
        assignments
        (Var 0)
        (I64 0)
        (Var 2)
        (Var 4)
        4
        (I64)
        (owned_view.compiler-owned-shared-view diag)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm) (string.eq asm "    vpmaskmovq %ymm6, %ymm7, (%rdi)\n")]
        [(Err _) false])
      (match (be_simd.compiler-backend-emit-avx2-select
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        3
        (Var 4)
        (Var 2)
        (Var 5)
        4
        (I64)
        (owned_view.compiler-owned-shared-view diag)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm)
          (string.eq
            asm
            "    vpblendvb %ymm7, %ymm6, %ymm8, %ymm14\n    vmovdqu %ymm14, -64(%rbp)\n")]
        [(Err _) false])
      (asm-ok?
        (be_simd.compiler-backend-emit-avx2-predicated-load
          (ast.ast-node-pool-reader-type-segment-bases)
          "narrow_mask"
          (ir.compiler-ir-label "entry")
          assignments
          3
          (Var 0)
          (I64 0)
          (Var 4)
          16
          (I16)
          (owned_view.compiler-owned-shared-view diag)
          (compiler-backend-simd-staging-state 32))
        (has
          "    vpmovmskb %ymm7, %r11d\n"
          "_load_skip_15"
          "    vmovdqu %ymm0, -224(%rbp)\n"
          "    vmovdqu -224(%rbp), %ymm14\n")
        (lacks "vpmaskmov" "%rsp"))
      (asm-ok?
        (be_simd.compiler-backend-emit-avx2-predicated-store
          (ast.ast-node-pool-reader-type-segment-bases)
          "narrow_mask"
          (ir.compiler-ir-label "entry")
          assignments
          (Var 0)
          (I64 0)
          (Var 2)
          (Var 4)
          16
          (I16)
          diag
          (compiler-backend-simd-staging-state 32))
        (has
          "    vpmovmskb %ymm7, %r11d\n"
          "_store_skip_15"
          "    vmovdqu %ymm6, -224(%rbp)\n"
          "    movw -194(%rbp), %r10w\n")
        (lacks "vpmaskmov" "%rsp")))))

(define (compiler-backend-avx2-vector-load-spill-dst-ok?) : bool
  (match (be_simd.compiler-backend-emit-vector-load
    (Avx2)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-spill-assignments)
    3
    (Var 0)
    (I64 0)
    4
    (I64)
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (string.eq
        asm
        "    vmovdqu (%rdi), %ymm14\n    vmovdqu %ymm14, -64(%rbp)\n")]
    [(Err _) false]))

(define (compiler-backend-avx2-vector-binop-spill-ok?) : bool
  (match (be_simd.compiler-backend-emit-vector-binop
    (Avx2)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-spill-assignments)
    3
    (Add)
    (Var 3)
    (Var 2)
    4
    (I64)
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (string.eq
        asm
        "    vmovdqu -64(%rbp), %ymm14\n    vpaddq %ymm6, %ymm14, %ymm14\n    vmovdqu %ymm14, -64(%rbp)\n")]
    [(Err _) false]))

(define (compiler-backend-prefix-test-state
  [mode : be_state.CompilerBackendMode]) : be_state.CompilerBackendState
  (let
    [state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (be_state.compiler-backend-set-current-mode!
      (be_state.compiler-backend-state-function-state state)
      mode)
    state))

(define (compiler-backend-vector-prefix-spill-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%vec6 %1=%vec7 %2=spill:-64"))

(define (compiler-backend-vector-prefix-source-carry-spill-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=spill:-64 %1=spill:-96 %2=%vec7"))

(define (compiler-backend-avx2-vector-prefix-i64-spill-ok?) : bool
  (asm-ok?
    (be_simd.compiler-backend-emit-vector-prefix
      (compiler-backend-vector-prefix-spill-assignments)
      2
      (Min)
      (Var 0)
      (Var 1)
      4
      (I64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (compiler-backend-prefix-test-state (Avx2)))
    (has
      "    vmovdqu %ymm6, %ymm15\n"
      "    vpslldq $8, %ymm15, %ymm0\n"
      "    vperm2i128 $0, %ymm15, %ymm15, %ymm0\n"
      "    vpcmpgtq "
      "    vpandn "
      "    vpermq $255, %ymm7, %ymm14\n"
      "    vmovdqu %ymm15, -64(%rbp)\n")))

(define (compiler-backend-avx2-vector-prefix-source-carry-spill-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-vector-prefix-source-carry-spill-assignments)]
    (and
      (asm-ok?
        (be_simd.compiler-backend-emit-vector-prefix
          assignments
          2
          (Sum)
          (Var 0)
          (Var 1)
          4
          (I64)
          (cdiag.compiler-diagnostic-at-start "" "")
          (compiler-backend-prefix-test-state (Avx2)))
        (has
          "    vmovdqu -64(%rbp), %ymm7\n"
          "    vmovdqu -96(%rbp), %ymm14\n"
          "    vpermq $255, %ymm14, %ymm14\n")
        (lacks "    vmovdqu %ymm7, -64(%rbp)\n"))
      (asm-ok?
        (be_simd.compiler-backend-emit-vector-prefix
          assignments
          2
          (Any)
          (Var 0)
          (Var 1)
          32
          (Bool)
          (cdiag.compiler-diagnostic-at-start "" "")
          (compiler-backend-prefix-test-state (Avx2)))
        (has
          "    vmovdqu -64(%rbp), %ymm7\n"
          "    vmovdqu -96(%rbp), %ymm14\n"
          "    vextracti128 $1, %ymm14, %xmm14\n"
          "    vpbroadcastb %xmm14, %ymm14\n")))))

(define (compiler-backend-avx2-vector-prefix-bool-spill-ok?) : bool
  (asm-ok?
    (be_simd.compiler-backend-emit-vector-prefix
      (compiler-backend-vector-prefix-spill-assignments)
      2
      (All)
      (Var 0)
      (Var 1)
      32
      (Bool)
      (cdiag.compiler-diagnostic-at-start "" "")
      (compiler-backend-prefix-test-state (Avx2)))
    (has
      "    vpslldq $1, %ymm15, %ymm0\n"
      "    vpslldq $8, %ymm15, %ymm0\n"
      "    vextracti128 $1, %ymm7, %xmm14\n"
      "    vpbroadcastb %xmm14, %ymm14\n"
      "    vpand %ymm14, %ymm15, %ymm15\n")
    (lacks "%al")
    (has "    vmovdqu %ymm15, -64(%rbp)\n")))

(define (compiler-backend-avx512-vector-prefix-numeric-spill-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-vector-prefix-spill-assignments)]
    (and
      (asm-ok?
        (be_simd.compiler-backend-emit-vector-prefix
          assignments
          2
          (Min)
          (Var 0)
          (Var 1)
          8
          (I64)
          (cdiag.compiler-diagnostic-at-start "" "")
          (compiler-backend-prefix-test-state (Avx512)))
        (has
          "    vmovdqu64 %zmm6, %zmm15\n"
          "    valignq $7, %zmm1, %zmm15, %zmm0\n"
          "    kshiftlw $4, %k7, %k7\n"
          "    vpminsq %zmm0, %zmm15, %zmm15{%k7}\n"
          "    vpbroadcastq %xmm14, %zmm14\n"
          "    vmovdqu64 %zmm15, -64(%rbp)\n"))
      (asm-ok?
        (be_simd.compiler-backend-emit-vector-prefix
          assignments
          2
          (Max)
          (Var 0)
          (Var 1)
          16
          (I32)
          (cdiag.compiler-diagnostic-at-start "" "")
          (compiler-backend-prefix-test-state (Avx512)))
        (has
          "    valignd $15, %zmm1, %zmm15, %zmm0\n"
          "    valignd $8, %zmm1, %zmm15, %zmm0\n"
          "    vpmaxsd %zmm0, %zmm15, %zmm15{%k7}\n"
          "    vpbroadcastd %xmm14, %zmm14\n")))))

(define (compiler-backend-avx512-vector-prefix-bool-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%k2 %1=%k3 %2=spill:-64"))

(define (compiler-backend-avx512-vector-prefix-bool-source-spill-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=spill:-64 %1=spill:-8 %2=%k3"))

(define (compiler-backend-avx512-vector-prefix-bool-spill-ok?) : bool
  (let
    [diag : cdiag.CompilerDiagnostic (cdiag.compiler-diagnostic-at-start "" "")]
    (and
      (asm-ok?
        (be_simd.compiler-backend-emit-vector-prefix
          (compiler-backend-avx512-vector-prefix-bool-assignments)
          2
          (All)
          (Var 0)
          (Var 1)
          64
          (Bool)
          (owned_view.compiler-owned-shared-view diag)
          (compiler-backend-prefix-test-state (Avx512)))
        (has
          "    kmovq %k2, %r11\n"
          "    notq %r11\n"
          "    shlq $32, %r10\n"
          "    kmovq %k3, %r10\n"
          "    sarq $63, %r10\n"
          "    andq %r10, %r11\n"
          "    kmovq %r11, %k7\n"
          "    kmovq %k7, -64(%rbp)\n")
        (lacks "    kmovq %k2, %rax\n" "%zmm"))
      (asm-ok?
        (be_simd.compiler-backend-emit-vector-prefix
          (compiler-backend-avx512-vector-prefix-bool-source-spill-assignments)
          2
          (Any)
          (Var 0)
          (Var 1)
          64
          (Bool)
          diag
          (compiler-backend-prefix-test-state (Avx512)))
        (has
          "    kmovq -64(%rbp), %k7\n"
          "    kmovq %k7, %r11\n"
          "    kmovq -8(%rbp), %k7\n"
          "    kmovq %k7, %r10\n"
          "    sarq $63, %r10\n"
          "    orq %r10, %r11\n"
          "    kmovq %r11, %k3\n")
        (lacks "%rax")))))

(define (compiler-backend-avx512-predicated-load-spill-dst-ok?) : bool
  (match (be_simd.compiler-backend-emit-avx512-predicated-load
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-spill-assignments)
    3
    (Var 0)
    (I64 0)
    (Var 4)
    8
    (I64)
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (string.eq
        asm
        "    vmovdqu64 (%rdi), %zmm14{%k1}{z}\n    vmovdqu64 %zmm14, -64(%rbp)\n")]
    [(Err _) false]))

(define (compiler-backend-avx512-select-spill-ok?) : bool
  (match (be_simd.compiler-backend-emit-avx512-select
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-spill-assignments)
    3
    (Var 4)
    (Var 2)
    (Var 3)
    8
    (I64)
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (string.eq
        asm
        "    vmovdqu64 -64(%rbp), %zmm14\n    vmovdqu64 %zmm6, %zmm14{%k1}\n    vmovdqu64 %zmm14, -64(%rbp)\n")]
    [(Err _) false]))

(define (compiler-backend-avx2-vector-reduce-spill-source-ok?) : bool
  (asm-ok?
    (be_operand.compiler-backend-emit-avx2-vector-reduce
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-spill-assignments)
      5
      (Sum)
      (Var 3)
      4
      (I64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has
      "    vmovdqu -64(%rbp), %ymm14\n"
      "    vextracti128 $1, %ymm14, "
      "    vmovq ")))

(define (compiler-backend-avx512-vector-reduce-spill-source-ok?) : bool
  (asm-ok?
    (be_operand.compiler-backend-emit-avx512-vector-reduce
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-spill-assignments)
      5
      (Sum)
      (Var 3)
      8
      (I64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has
      "    vmovdqu64 -64(%rbp), %zmm14\n"
      "    vextracti64x4 $1, %zmm14, "
