(define (compiler-backend-vector-home-program
  [func : compiler_ir_types.CompilerIrFunction]) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    compiler_ir_types.CompilerIrGlobalList.Nil
    (compiler_ir_types.compiler-ir-function-cons
      func
      compiler_ir_types.CompilerIrFunctionList.Nil)
    compiler_ir_types.CompilerIrExternList.Nil))

(define (compiler-backend-vector-call-lifetime-function) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (ci.intern "vector_call_lifetime")
    compiler_ir_types.CompilerIrParamList.Nil
    (compiler_ast_types.AstType.Unit)
    3
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.compiler-ir-block
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.VectorLoad
            0
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ir_types.CompilerIrValue.I64 0)
            4
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Call
              1
              (ci.intern "side_effect")
              (compiler_ir_types.CompilerIrCallArgs.Nil)
              (compiler_ast_types.AstType.Unit))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.ir-instr-vector-bin-op
                2
                (compiler_ir_types.CompilerIrBinOp.Add)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.CompilerIrValue.Var 0)
                4
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Return
                  compiler_ir_types.CompilerIrMaybeValue.No)
                compiler_ir_types.CompilerIrInstrList.Nil)))))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (compiler-backend-avx2-vector-homes-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-target-with-mode
    (compiler-backend-vector-home-program
      (compiler_regalloc.compiler-reg-vector-home-function))
    (compiler_backend.CompilerBackendTarget.Linux)
    (compiler_backend.CompilerBackendMode.Avx2)
    (compiler_ir_types.compiler-source-spans-empty)
    true)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains? asm "    vmovdqu ")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vpaddq 32(%r8), %ymm6, %ymm7\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vpaddq %ymm7, %ymm6, %ymm6\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    vpaddq 32(%rax), %ymm6, %ymm7\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "register home unavailable")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-xmm-family-conversion-ok?) : bool
  (and
    (string.eq
      (compiler_backend.compiler-backend-vector-home-to-reg
        (compiler_abi.compiler-abi-vector-register-id 6)
        "xmm")
      "%xmm6")
    (string.eq
      (compiler_backend.compiler-backend-vector-home-to-reg
        (compiler_abi.compiler-abi-vector-register-id 6)
        "ymm")
      "%ymm6")
    (string.eq
      (compiler_backend.compiler-backend-vector-home-to-reg
        (compiler_abi.compiler-abi-vector-register-id 6)
        "zmm")
      "%zmm6")
    (string.eq
      (compiler_backend.compiler-backend-vector-home-to-reg
        (compiler_abi.compiler-abi-vector-register-id 7)
        "zmm")
      "%zmm7")
    (string.eq
      (compiler_backend.compiler-backend-vector-reg-lower-xmm "%zmm14")
      "%xmm14")
    (string.eq
      (compiler_backend.compiler-backend-vector-reg-lower-ymm "%zmm15")
      "%ymm15")
    (string.eq (compiler_backend.compiler-backend-xmm-to-ymm "%xmm3") "%ymm3")
    (compiler_backend.compiler-backend-vector-home-valid?
      (compiler_abi.compiler-abi-xmm-register-id 2))
    (compiler_backend.compiler-backend-vector-home-valid?
      (compiler_abi.compiler-abi-vector-register-id 6))
    (compiler_backend.compiler-backend-vector-home-valid?
      (compiler_abi.compiler-abi-vector-register-id 13))
    (compiler_backend.compiler-backend-vector-home-valid?
      (compiler_abi.compiler-abi-vector-register-id 14))
    (compiler_backend.compiler-backend-vector-home-valid?
      (compiler_abi.compiler-abi-vector-register-id 15))
    (not
      (compiler_backend.compiler-backend-vector-home-valid?
        (compiler_abi.compiler-abi-xmm-register-id 1)))
    (string.eq
      (compiler_backend.compiler-backend-vector-home-to-reg
        (compiler_abi.compiler-abi-mask-register-id 1)
        "zmm")
      "")))

