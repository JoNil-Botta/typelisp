(define (compiler-backend-store-ptr-pair-shape-ok?) : bool
  (match (compiler-backend-emit-test-instrs
    (irt.instrs
      "store_ptr %0, 1 : i64
       %2 = gep %0, 1 : u64
       store_ptr %2, 2 : i64")
    (regalloc.compiler-reg-assignment-table-empty)
    4)
    [(Ok asm)
      (and
        (=
          (backend.compiler-backend-string-count
            asm
            "    movq -8(%rbp), %r10\n")
          1)
        (asm-has? asm "    movq $1, (%r10)\n" "    movq $2, 8(%r10)\n")
        (asm-lacks?
          asm
          "    movq %rax, -24(%rbp)\n"
          "    movq -24(%rbp), %r10\n"))]
    [(Err _) false]))

;; StorePtr consumes the same fused Gep address forms as Load: zero and
;; nonzero displacements, plus a register-homed scaled index, emit directly in
;; the store memory operand. A second non-memory use keeps the Gep materialized.
(define (compiler-backend-gep-store-fold-test-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%rsi %1=%rax %2=%rdi %3=%rcx %4=%r8"))

(define (compiler-backend-gep-store-fold-positive-ok?
  [offset : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [expected : String]) : bool
  (asm-ok?
    (compiler-backend-emit-test-instrs
      (compiler-backend-test-instr-seq-prepend
        (Gep 3 (Var 0) offset elem-ty)
        (irt.instrs "store_ptr %3, %1 : i64"))
      (compiler-backend-gep-store-fold-test-assignments)
      5)
    (has expected)
    (lacks "    leaq ")))

(define (compiler-backend-gep-store-fold-shapes-ok?) : bool
  (and
    (compiler-backend-gep-store-fold-positive-ok?
      (I64 0)
      (U8)
      "    movq %rax, (%rsi)\n")
    (compiler-backend-gep-store-fold-positive-ok?
      (I64 8)
      (U8)
      "    movq %rax, 8(%rsi)\n")
    (compiler-backend-gep-store-fold-positive-ok?
      (Var 2)
      (I64)
      "    movq %rax, (%rsi,%rdi,8)\n")
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs
          "%3 = gep %0, 8 : u8
           store_ptr %3, %1 : i64
           %4 = add %3, 1 : i64")
        (compiler-backend-gep-store-fold-test-assignments)
        5)
      (has "    leaq 8(%rsi), %rcx\n" "    movq %rax, (%rcx)\n"))))

(define (compiler-backend-store-value-scratch-shape-ok?) : bool
  (and
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "store_ptr %0, %1 : i64")
        (reg-homes "%1=%r12")
        3)
      (has "    movq %r12, (%r10)\n")
      (lacks "    movq %r12, %rax\n"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "store_ptr %0, %1 : i64")
        (regalloc.compiler-reg-assignment-table-empty)
        3)
      (has "    movq -16(%rbp), %r8\n" "    movq %r8, (%r10)\n")
      (lacks "%rax"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "store_ptr %0, %1 : f64")
        (regalloc.compiler-reg-assignment-table-empty)
        3)
      (has "    movsd -16(%rbp), %xmm2\n" "    movsd %xmm2, (%r10)\n")
      (lacks "%xmm0"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%3 = gep %0, %2 : u64
           store_ptr %3, %1 : i64")
        (regalloc.compiler-reg-assignment-table-empty)
        5)
      (has
        "    movq -8(%rbp), %r10\n"
        "    movq -24(%rbp), %r8\n"
        "    movq -16(%rbp), %r9\n"
        "    movq %r9, (%r10,%r8,8)\n")
      (lacks "    movq -16(%rbp), %rax\n"))))

(define (compiler-backend-gep-store-index-home-preserved-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%2=%r9")]
    (match (compiler-backend-emit-test-instrs
      (irt.instrs "%3 = gep %0, %2 : u64
         store_ptr %3, 0 : i64")
      assignments
      4)
      [(Ok asm)
        ;; SCR-1: a register-homed index with a SIB-encodable scale is read
        ;; from its home; only the spilled base is staged. The base scratch is
        ;; whichever register the scavenger finds free -- that depends on the
        ;; occupancy the preceding fixtures left behind, so the shape is
        ;; asserted without naming it: a base reload into some register, the
        ;; store indexed by %r9 itself, no staging copy out of %r9, and the
        ;; base never reloaded over the index home.
        (and
          (asm-has? asm "    movq -8(%rbp), %r" ",%r9,8)\n")
          (asm-lacks? asm "    movq %r9, %r" "    movq -8(%rbp), %r9\n"))]
      [(Err _) false])))

(define (compiler-backend-store-address-source-home-preserved-ok?) : bool
  (let
    [src-r9 : regalloc.CompilerRegAssignmentTable (reg-homes "%1=%r9")]
    [pair-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%2=%r8")]
    [plain-ok : bool
      (match (compiler-backend-emit-test-instrs
        (irt.instrs "store_ptr %0, %1 : i64")
        src-r9
        3)
        [(Ok asm)
          (string.eq asm "    movq -8(%rbp), %r10\n    movq %r9, (%r10)\n")]
        [(Err _) false])]
    [gep-ok : bool
      (match (compiler-backend-emit-test-instrs
        (irt.instrs "%2 = gep %0, 1 : u64
           store_ptr %2, %1 : i64")
        src-r9
        3)
        [(Ok asm)
          (string.eq asm "    movq -8(%rbp), %r10\n    movq %r9, 8(%r10)\n")]
        [(Err _) false])]
    ;; The pair case leaves var 1 unassigned. The modeled plan gives the base and
    ;; spilled source independent homes, while var 2's %r8 home stays untouched.
    [pair-ok : bool
      (asm-ok?
        (compiler-backend-emit-test-instrs
          (irt.instrs
            "store_ptr %0, %1 : i64
             %3 = gep %0, 1 : u64
             store_ptr %3, %2 : i64")
          pair-assignments
          4)
        (has
          "    movq -8(%rbp), %r10\n"
          "    movq -16(%rbp), "
          "    movq %r8, 8(%r10)\n")
        (lacks "    movq -8(%rbp), %r8\n"))]
    (be_state.backend-and4 plain-ok gep-ok pair-ok true)))

(define (compiler-backend-store-home-base-shape-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r12")]
    [r11-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r11")]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    (and
      (match (be_scalar.compiler-backend-emit-store-ptr
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        (Var 0)
        (I64 7)
        (I64)
        index
        index.backend-state)
        [(Ok asm)
          (and (string.eq asm "    movq $7, (%r12)\n") (asm-lacks? asm "%r10"))]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-store-to-gep
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        (Var 0)
        (I64 1)
        (U64)
        (& (I64 9))
        (& (I64))
        index
        0
        index.backend-state)
        [(Ok asm)
          (and (string.eq asm "    movq $9, 8(%r12)\n") (asm-lacks? asm "%r10"))]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-store-ptr
        (ast.ast-node-pool-reader-type-segment-bases)
        r11-assignments
        (Var 0)
        (I64 11)
        (I64)
        index
        index.backend-state)
        [(Ok asm)
          (and
            (string.eq asm "    movq $11, (%r11)\n")
            (asm-lacks? asm "    movq %r11, %r10\n"))]
        [(Err _) false]))))

(define (compiler-backend-gep-load-store-order-shape-ok?) : bool
  (match (compiler-backend-emit-test-instrs
    (irt.instrs
      "%4 = gep %0, %3 : u8
       %5 = gep %1, %2 : u8
       %6 = load %5 : u8
       store_ptr %4, %6 : u8")
    (regalloc.compiler-reg-assignment-table-empty)
    8)
    [(Ok asm)
      (let
        [load-pos : i64
          (backend.compiler-backend-string-find-from asm "    movzbl " 0)]
        [dst-base-pos : i64
          (backend.compiler-backend-string-find-from asm "    movq -8(%rbp)" 0)]
        [bad-rcx-pos : i64
          (backend.compiler-backend-string-find-from
            asm
            "    movq %rcx, %r8\n    movb %cl, (%r12,%r8,1)"
            0)]
        [bad-r8-pos : i64
          (backend.compiler-backend-string-find-from
            asm
            "    movq %r8, %r9\n    movb %r8b, (%r12,%r9,1)"
            0)]
        (be_state.backend-and8
          (>= load-pos 0)
          (>= dst-base-pos 0)
          (< dst-base-pos load-pos)
          (asm-has? asm "    movb ")
          (< bad-rcx-pos 0)
          (< bad-r8-pos 0)
          (not
            (let
              [needle (compiler-backend-todo-marker)]
              (asm-has? asm needle)))
          true))]
    [(Err _) false]))

(define (compiler-backend-gep-load-register-homes-shape-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%r8 %3=%rcx %4=%r9")]
    (match (compiler-backend-emit-test-instrs
      (irt.instrs
        "%2 = gep %0, %1 : u8
         %3 = load %2 : u8
         %5 = mov %4 : i64")
      assignments
      6)
      [(Ok asm)
        (and
          (asm-has? asm "    movzbl (%r12,%r8,1), %ecx\n")
          (asm-lacks? asm "    movq %r8, %r9\n" "    movq %r12, %r10\n")
          (not
            (let
              [needle (compiler-backend-todo-marker)]
              (asm-has? asm needle))))]
      [(Err _) false])))

(define (compiler-backend-gep-load-live-through-home-asm) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [saved : EmitterScratch (emitter-scratch-save backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%1=%r9 %4=%rcx %5=%r10")]
    [instrs : ir.CompilerIrInstrSeq
      (irt.instrs
        "%1 = mov 5 : i64
         %5 = mov 7 : i64
         %3 = gep %0, 24 : u64
         %4 = load %3 : i64
         store_ptr %2, %1 : i64
         %6 = mov %5 : i64")]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (owned_view.compiler-owned-shared-view instrs)))]
    [_ctx : unit
      (begin
        (compiler-backend-test-scavenge-install-ctx!
          "gep_load_live_through"
          (ir.compiler-ir-param-seq-empty)
          (I64)
          8
          blocks
          assignments
          backend-state)
        (set-state-emit-instr-post-base! backend-state 6)
        (set-state-emit-current-count! backend-state 6))]
    [result : be_state.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        8
        (be_state.CompilerBackendTarget.Linux)
        backend-state)]
    [_restore : unit (emitter-scratch-restore! backend-state saved)]
    result))

(define (compiler-backend-gep-load-live-through-home-preserved-ok?) : bool
  (asm-ok?
    (compiler-backend-gep-load-live-through-home-asm)
    (has "    movl $5, %r9d\n" "    movq %r9, (")
    (lacks
      "    movq -8(%rbp), %r9\n"
      "    movq -8(%rbp), %r10\n"
      "    movq 192(%r9), %rcx\n"
      "    movq 192(%r10), %rcx\n")))

(define (compiler-backend-gep-load-multi-emergency-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes
    "%1=%r9 %2=%rcx %3=%rdx %4=%r10 %5=%r11 %6=%r8 %7=%rsi %8=%rdi %9=%rax"))

(define (compiler-backend-gep-load-multi-emergency-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%1 = mov 1 : i64
     %2 = mov 2 : i64
     %3 = mov 3 : i64
     %4 = mov 4 : i64
     %5 = mov 5 : i64
     %7 = mov 7 : i64
     %8 = mov 8 : i64
     %9 = mov 9 : i64
     %6 = mov 6 : i64
     %20 = gep %0, 24 : u64
     %21 = load %20 : i64
     %30 = mov %1 : i64
     %31 = mov %2 : i64
     %32 = mov %3 : i64
     %33 = mov %4 : i64
     %34 = mov %5 : i64
     %35 = mov %6 : i64
     %36 = mov %7 : i64
     %37 = mov %8 : i64
     %38 = mov %9 : i64"))

(define (compiler-backend-gep-load-multi-emergency-asm) : be_state.ResultCompilerBackend
  (compiler-backend-emergency-ctx-asm
    "gep_load_multi_emergency"
    (compiler-backend-gep-load-multi-emergency-instrs)
    (ir.compiler-ir-blocks)
    (compiler-backend-gep-load-multi-emergency-assignments)
    40
    14))

;; Emit `instrs` under a real scavenge context built from the liveness of an
;; entry block holding them followed by `tail` (successors that only keep
;; values live), with every instruction starting at `post-base` and the
;; emergency frame region at -512(%rbp), so a site whose pool is fully occupied
;; takes the emergency save/park path exactly as a whole function would.
(define (compiler-backend-emergency-ctx-asm
  [name : String]
  [instrs : ir.CompilerIrInstrSeq]
  [tail : ir.CompilerIrBlockList]
  [assignments : regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [post-base : i64]) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [saved : EmitterScratch (emitter-scratch-save backend-state)]
    [prev-emergency-slot-offset : i64
      (scratch-emergency-slot-offset
        (be_state.compiler-backend-state-function-state backend-state))]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks-with-tail
        tail
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (owned_view.compiler-owned-shared-view instrs)))]
    [_ctx : unit
      (begin
        (compiler-backend-test-scavenge-install-ctx!
          name
          (ir.compiler-ir-param-seq-empty)
          (I64)
          vars
          blocks
          assignments
          backend-state)
        (set-state-emit-instr-post-base! backend-state post-base)
        (set-state-emit-current-count! backend-state post-base)
        (set-scratch-emergency-slot-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          -512))]
    [result : be_state.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        vars
        (be_state.CompilerBackendTarget.Linux)
        backend-state)]
    [_restore : unit
      (begin
        (emitter-scratch-restore! backend-state saved)
        (set-scratch-emergency-slot-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-emergency-slot-offset))]
    result))

(define (compiler-backend-gep-load-multi-emergency-preserved-ok?) : bool
  (match (compiler-backend-gep-load-multi-emergency-asm)
    [(Ok asm)
      (be_state.backend-and8
        (asm-has? asm "    movq %r9, %xmm4\n")
        (asm-has? asm "    movq %xmm4, %r9\n")
        (asm-has? asm "    movq %rcx, %xmm5\n")
        (asm-has? asm "    movq %xmm5, %rcx\n")
        (asm-lacks? asm "-512(%rbp)")
        (asm-lacks? asm "-576(%rbp)")
        true
        true)]
    [(Err _) false]))

;; T1-6 (e): the %r10-preferred global/address scratch site takes a
;; SCAVENGED register when one is free, and when the occupancy leaves none free
;; the borrowed register is parked in a free XMM register instead of the
;; 64-byte emergency FRAME slot. Naming a frame slot is what forces a call-free
;; leaf to carry a frame at all (gvn's facts_remove paid `subq $144, %rsp` on
;; every call for one `movq %r9, (%rsp)` pair), so this pins the frame-free
;; form on the emitted text.
(define (compiler-backend-scratch-save-scavenged-not-framed-ok?) : bool
  (match (compiler-backend-gep-load-multi-emergency-asm)
    [(Ok asm)
      (be_state.backend-and8
        ;; The base is materialised into a SCAVENGED register (%r9 here --
        ;; the preferred %r10 is occupied at this point), never a fixed one.
        (asm-has? asm "    movq -8(%rbp), %r9\n")
        (asm-has? asm "    movq 192(%r9), %rcx\n")
        ;; Both borrowed registers are parked in free XMM registers ...
        (asm-has? asm "    movq %r9, %xmm4\n")
        (asm-has? asm "    movq %xmm4, %r9\n")
        (asm-has? asm "    movq %rcx, %xmm5\n")
        (asm-has? asm "    movq %xmm5, %rcx\n")
        ;; ... and neither one is stored into the emergency frame region.
        (asm-lacks? asm "    movq %r9, -512(%rbp)\n")
        (asm-lacks? asm "    movq %rcx, -576(%rbp)\n"))]
    [(Err _) false]))

;; #9976: a GAP8 gep-load ALU fold whose base is spilled and whose every pool
;; register is occupied borrows an emergency scratch for the base. The
;; non-loaded operand %1 (in %r9) is read into the ALU home %r12 AFTER the
;; base is staged, so the borrowed scratch must never be %1's home: the old
;; exclude set held only the index and destination homes, picked %r9, and
;; emitted `movq -8(%rbp), %r9 ; movq %r9, %r12 ; addq (%r9,%rax,8), %r12` --
;; the base pointer, not %1, was summed.
(define (compiler-backend-gep-load-alu-emergency-asm [dynamic-index? : bool]) : be_state.ResultCompilerBackend
  (compiler-backend-emergency-ctx-asm
    "gep_load_alu_emergency"
    (irt.instrs
      (str_cat.str-cat
        "%1 = mov 1 : i64
         %2 = mov 2 : i64
         %3 = mov 3 : i64
         %4 = mov 4 : i64
         %5 = mov 5 : i64
         %6 = mov 6 : i64
         %7 = mov 7 : i64
         %8 = mov 8 : i64
         %9 = mov 9 : i64
         "
        (if dynamic-index?
          "%20 = gep %0, %9 : i64"
          "%20 = gep %0, 3 : i64")
        "
         %21 = load %20 : i64
         %22 = add %1, %21 : i64
         %30 = mov %2 : i64
         %31 = mov %3 : i64
         %32 = mov %4 : i64
         %33 = mov %5 : i64
         %34 = mov %6 : i64
         %35 = mov %7 : i64
         %36 = mov %8 : i64
         %37 = mov %9 : i64
         %38 = mov %22 : i64"))
    (ir.compiler-ir-blocks)
    (reg-homes
      "%1=%r9 %2=%rcx %3=%rdx %4=%r10 %5=%r11 %6=%r8 %7=%rsi %8=%rdi %9=%rax %22=%r12")
    40
    14))

(define (compiler-backend-gep-load-alu-emergency-preserved-ok?
  [dynamic-index? : bool]) : bool
  (asm-ok?
    (compiler-backend-gep-load-alu-emergency-asm dynamic-index?)
    (has
      "    movq %r9, %r12\n"
      (if dynamic-index?
        ",%rax,8), %r12\n"
        "    addq 24(%"))
    (lacks
      "    movq -8(%rbp), %r9\n"
      "    addq (%r9,%rax,8), %r12\n"
      "    addq 24(%r9), %r12\n")))

(test
  backend-gep-load-alu-emergency-scratch-preserves-operand
  (test.assert-true
    (and
      (compiler-backend-gep-load-alu-emergency-preserved-ok? true)
      (compiler-backend-gep-load-alu-emergency-preserved-ok? false))
    "a GAP8 fold's emergency base scratch clobbered the non-loaded operand"))

;; #9976 sibling: the GAP9 const-offset gep-load compare+branch stages a
;; spilled base and then compares it against the register-homed rhs %1 (in
;; %r9) in place, so the base scratch must not be %1's home either -- the old
;; empty exclude set let the full-occupancy emergency pick borrow %r9 and the
;; compare read the base pointer as its rhs.
(define (compiler-backend-gep-load-cmp-branch-emergency-asm) : be_state.ResultCompilerBackend
  (compiler-backend-emergency-ctx-asm
    "gep_load_cmp_branch_emergency"
    (irt.instrs
      "%1 = mov 1 : i64
       %2 = mov 2 : i64
       %3 = mov 3 : i64
       %4 = mov 4 : i64
       %5 = mov 5 : i64
       %6 = mov 6 : i64
       %7 = mov 7 : i64
       %8 = mov 8 : i64
       %9 = mov 9 : i64
       %20 = gep %0, 3 : i64
       %21 = load %20 : i64
       %22 = lt %21, %1 : i64
       branch %22, lo, hi")
    (irt.blocks
      "lo:
         %30 = mov %1 : i64
         %31 = mov %2 : i64
         %32 = mov %3 : i64
         %33 = mov %4 : i64
         %34 = mov %5 : i64
         %35 = mov %6 : i64
         %36 = mov %7 : i64
         %37 = mov %8 : i64
         %38 = mov %9 : i64
         return
       hi:
         return")
    (reg-homes
      "%1=%r9 %2=%rcx %3=%rdx %4=%r10 %5=%r11 %6=%r8 %7=%rsi %8=%rdi %9=%rax")
    40
    14))

(define (compiler-backend-gep-load-cmp-branch-emergency-preserved-ok?) : bool
  (asm-ok?
    (compiler-backend-gep-load-cmp-branch-emergency-asm)
    (has "    cmpq %r9, 24(%")
    (lacks "    movq -8(%rbp), %r9\n" "    cmpq %r9, 24(%r9)\n")))

(test
  backend-gep-load-cmp-branch-emergency-scratch-preserves-operand
  (test.assert-true
    (compiler-backend-gep-load-cmp-branch-emergency-preserved-ok?)
    "a GAP9 compare's emergency base scratch clobbered the register rhs"))

(define (compiler-backend-copy-bytes-direct-home-shape-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%r13")]
    (match (compiler-backend-emit-test-instrs
      (irt.instrs "copy_bytes %0, %1, 24")
      assignments
      3)
      [(Ok asm)
        (and
          (be_state.backend-and4
            (asm-has? asm "    movups (%r13), %xmm2\n")
            (asm-has? asm "    movups %xmm2, (%r12)\n")
            (asm-has? asm "    movq 16(%r13), %r8\n")
            (asm-has? asm "    movq %r8, 16(%r12)\n"))
          (asm-lacks?
            asm
            "    movq %r12, %r10\n"
            "    movq %r13, %r11\n"
            "%xmm15"))]
      [(Err _) false])))

(define (compiler-backend-copy-bytes-live-through-asm) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [saved : EmitterScratch (emitter-scratch-save backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%2=%r9 %4=%r12 %5=%r13")]
    [instrs : ir.CompilerIrInstrSeq
      (irt.instrs "copy_bytes %0, %1, 24
         %3 = mov %2 : i64")]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (owned_view.compiler-owned-shared-view instrs)))]
    [_ctx : unit
      (begin
        (compiler-backend-test-scavenge-install-ctx!
          "copy_bytes_live_through"
          (ir.compiler-ir-param-seq-empty)
          (I64)
          6
          blocks
          assignments
          backend-state)
        (set-state-emit-instr-post-base! backend-state 2)
        (set-state-emit-current-count! backend-state 2))]
    [result : be_state.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        6
        (be_state.CompilerBackendTarget.Linux)
        backend-state)]
    [_restore : unit (emitter-scratch-restore! backend-state saved)]
    result))

(define (compiler-backend-copy-bytes-live-through-shape-ok?) : bool
  (match (compiler-backend-copy-bytes-live-through-asm)
    [(Ok asm)
      (and
        ;; The property is that %r9 still holds the value after the CopyBytes:
        ;; the copy's scratch avoided it, and no emergency save/restore was
        ;; needed. P7b makes the store that reads it ONE register-to-slot movq
        ;; in either cfg -- there is no scratch left to stage it through, so
        ;; neither staging spelling may appear.
        (asm-has? asm "    movq %r9, -32(%rbp)\n")
        (asm-lacks? asm "    movq %r9, %rax\n")
        (asm-lacks? asm "    movq %r9, %r8\n")
        (asm-lacks? asm "    movq -8(%rbp), %r9\n")
        (asm-lacks? asm "    movq -16(%rbp), %r9\n")
        (asm-lacks? asm "%xmm15"))]
    [(Err _) false]))

(define (compiler-backend-copy-bytes-run-protect-asm) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [saved : EmitterScratch (emitter-scratch-save backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%5=%r9 %8=%r12 %9=%r13")]
    [instrs : ir.CompilerIrInstrSeq
      (irt.instrs
        "copy_bytes %0, %1, 24
         %6 = gep %0, 3 : u64
         copy_bytes %6, %3, 24
         %7 = gep %0, 6 : u64
         copy_bytes %7, %5, 24")]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (owned_view.compiler-owned-shared-view instrs)))]
    [_ctx : unit
      (begin
        (compiler-backend-test-scavenge-install-ctx!
          "copy_bytes_run_protect"
          (ir.compiler-ir-param-seq-empty)
          (I64)
          10
          blocks
          assignments
          backend-state)
        (set-state-emit-instr-post-base! backend-state 5)
        (set-state-emit-current-count! backend-state 5))]
    [result : be_state.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        10
        (be_state.CompilerBackendTarget.Linux)
        backend-state)]
    [_restore : unit (emitter-scratch-restore! backend-state saved)]
    result))

(define (compiler-backend-copy-bytes-run-protect-shape-ok?) : bool
  (asm-ok?
    (compiler-backend-copy-bytes-run-protect-asm)
    (has "%r9")
    (lacks
      "    movq -8(%rbp), %r9\n"
      "    movq -16(%rbp), %r9\n"
      "    movq -24(%rbp), %r9\n"
      "    movq -32(%rbp), %r9\n"
      "    movq -40(%rbp), %r9\n"
      "    movq -48(%rbp), %r9\n"
      "    movq -56(%rbp), %r9\n"
      "    movq -64(%rbp), %r9\n"
      "%xmm15")))

(define (compiler-backend-widening-cast-direct-home-shape-ok?) : bool
  (let
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [reg-src : regalloc.CompilerRegAssignmentTable
      (reg-homes "%5=%r12 %6=%rbx")]
    [stack-src : regalloc.CompilerRegAssignmentTable (reg-homes "%6=%rbx")]
    (and
      (match (be_scalar.compiler-backend-emit-cast
        (ast.ast-node-pool-reader-type-segment-bases)
        "_tl_test"
        (ir.compiler-ir-label "entry")
        reg-src
        6
        (Var 5)
        (I8)
        (I64)
        index
        index.backend-state)
        [(Ok asm) (string.eq asm "    movsbq %r12b, %rbx\n")]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-cast
        (ast.ast-node-pool-reader-type-segment-bases)
        "_tl_test"
        (ir.compiler-ir-label "entry")
        stack-src
        6
        (Var 5)
        (U8)
        (U64)
        index
        index.backend-state)
        [(Ok asm) (string.eq asm "    movzbl -48(%rbp), %ebx\n")]
        [(Err _) false]))))

(define (compiler-backend-global-store-direct-home-shape-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r12")]
    (and
      (asm-ok?
        (compiler-backend-emit-test-instrs
          (compiler-backend-test-instr-seq-prepend
            (Store (ci.intern "g") (Var 0) (I32))
            (ir.compiler-ir-instr-seq-empty))
          assignments
          2)
        (has "    movl %r12d, _tl_g(%rip)\n")
        (lacks "    movq %r12, %rax\n" "    movq %rax, _tl_g(%rip)\n"))
      (asm-ok?
        (compiler-backend-emit-test-instrs
          (compiler-backend-test-instr-seq-prepend
            (Store (ci.intern "g") (Var 0) (I64))
            (ir.compiler-ir-instr-seq-empty))
          (regalloc.compiler-reg-assignment-table-empty)
          2)
        (has "    movq -8(%rbp), %r8\n" "    movq %r8, _tl_g(%rip)\n")
        (lacks "%rax"))
      (asm-ok?
        (compiler-backend-emit-test-instrs
          (compiler-backend-test-instr-seq-prepend
            (Store (ci.intern "g") (Var 0) (F64))
            (ir.compiler-ir-instr-seq-empty))
          (regalloc.compiler-reg-assignment-table-empty)
          2)
        (has "    movsd -8(%rbp), %xmm2\n" "    movsd %xmm2, _tl_g(%rip)\n")
        (lacks "%xmm0")))))

(define (compiler-backend-pack-direct-home-shape-ok?) : bool
  (let
    [ty : ast.AstType (compiler-backend-register-group-test-type)]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-register-group-test-index)]
    [words : ir.CompilerIrValueSeq
      (ir.compiler-ir-value-seq-prepend
        (& (Var 0))
        (&
          (ir.compiler-ir-value-seq-prepend
            (& (Var 1))
            (& (ir.compiler-ir-value-seq-empty)))))]
    [direct-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%rbx %2=%r14/%r15")]
    [noop-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r14 %1=%r15 %2=%r14/%r15")]
    [diag : cdiag.CompilerDiagnostic (cdiag.compiler-diagnostic-at-start "" "")]
    (and
      (match (be_scalar.compiler-backend-emit-pack
        (ast.ast-node-pool-reader-type-segment-bases)
        direct-assignments
        2
        (owned_view.compiler-owned-shared-view words)
        (owned_view.compiler-owned-shared-view ty)
        4
        index
        (owned_view.compiler-owned-shared-view diag)
        index.backend-state)
        [(Ok asm) (string.eq asm "    movq %r12, %r14\n    movq %rbx, %r15\n")]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-pack
        (ast.ast-node-pool-reader-type-segment-bases)
        noop-assignments
        2
        words
        ty
        4
        index
        diag
        index.backend-state)
        [(Ok asm) (string.eq asm "")]
        [(Err _) false]))))

(define (compiler-backend-copy-thunk-test-run
  [ir-text : String]
  [homes-spec : String]
  [vars : i64]
  [loop-block? : bool]
  [optimize-for-size? : bool]
  [site-count : i64]
  [size : i64]) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [saved : EmitterScratch (emitter-scratch-save backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes homes-spec)]
    [instrs : ir.CompilerIrInstrSeq (irt.instrs (string.copy (& ir-text)))]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (irt.instrs ir-text)))]
    [fn-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state backend-state)]
    [target : be_state.CompilerBackendTarget
      (be_state.compiler-backend-state-emission-target-policy backend-state).target]
    [_setup : unit
      (begin
        (backend.compiler-backend-copy-thunks-reset! backend-state)
        (be_state.compiler-backend-state-set-optimize-for-size!
          backend-state
          optimize-for-size?)
        (be_state.compiler-backend-function-state-set-bool!
          fn-state
          be_state.compiler-backend-function-bool-has-returning-call
          true)
        (be_state.compiler-backend-function-state-set-i64!
          fn-state
          be_state.compiler-backend-function-i64-current-block-label
          (ir.compiler-ir-label "entry"))
        (when loop-block? (compiler-backend-test-mark-entry-loop! fn-state))
        (let
          [data : (MutPtr be_state.CompilerBackendStateData)
            (be_state.compiler-backend-state-ptr backend-state)]
          [bucket : i64
            (be_scalar.compiler-backend-copy-thunk-size-bucket size)]
          (unsafe
            (let
              [counts : (__tl_dyn-array i64)
                (deref data).copy-thunk-size-counts]
              (when
                (and (>= bucket 0) (< bucket (array-length counts)))
                (set! (array-ref counts bucket) site-count)))))
        (compiler-backend-test-scavenge-install-ctx!
          "copy_thunk_test"
          (ir.compiler-ir-param-seq-empty)
          (I64)
          vars
          blocks
          assignments
          backend-state)
        (set-state-emit-instr-post-base! backend-state count)
        (set-state-emit-current-count! backend-state count))]
    [result : be_state.ResultCompilerBackend
      (match (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        vars
        target
        backend-state)
        [(Ok asm)
          (let
            [index : be_state.CompilerBackendProgramIndex
              (be_facts.compiler-backend-program-index-build-with-backend-state-and-profile-state
                backend-state
                (ast.ast-node-pool-reader-type-segment-bases)
                (ir.compiler-ir-function-seq-empty)
                (ir.compiler-ir-extern-seq-empty)
                (profile_state.compiler-profile-state-new))]
            (be_state.ResultCompilerBackend.Ok
              (str_cat.str-cat
                asm
                (be_scalar.compiler-backend-copy-thunk-text index))))]
        [(Err e) (be_state.ResultCompilerBackend.Err e)])]
    [_restore : unit (emitter-scratch-restore! backend-state saved)]
    result))

(define (compiler-backend-canonical-copy-thunks-ok?) : bool
  (and
    ;; Non-loop 56 B copy with %rbp source base uses canonical (%rax,%rcx,%xmm2)
    ;; thunk with movsd 8-B tail and zero GP scratch.
    (asm-ok?
      (compiler-backend-copy-thunk-test-run
        "copy_bytes %0, %1, 56"
        "%0=%r12 %1=%rbp"
        3
        false
        false
        8
        56)
      (has
        "    movq %rbp, %rax\n"
        "    movq %r12, %rcx\n"
        "    call tl_copy_chunks_0\n"
        "tl_copy_chunks_0:\n"
        "    movsd 48(%rax), %xmm2\n"
        "    movsd %xmm2, 48(%rcx)\n")
      (lacks "%r8" "    movq 48("))
    ;; Live-out %rax forces (%r10,%r11) fallback so %rax is never clobbered.
    (asm-ok?
      (compiler-backend-copy-thunk-test-run
        "copy_bytes %0, %1, 56
         %3 = mov %2 : i64"
        "%0=%r12 %1=%r13 %2=%rax"
        4
        false
        false
        8
        56)
      (has
        "    movq %r13, %r10\n"
        "    movq %r12, %r11\n"
        "    call tl_copy_chunks_0\n"
        "    movups (%r10), %xmm2\n")
      (lacks "    movq %r13, %rax\n" "    movq %r12, %rax\n"))
    ;; Live-out %rax already equals src with offset 0: stays in %rax untouched.
    (asm-ok?
      (compiler-backend-copy-thunk-test-run
        "copy_bytes %0, %1, 56
         %2 = mov %1 : i64"
        "%0=%r12 %1=%rax"
        3
        false
        false
        8
        56)
      (has "    movq %r12, %rcx\n" "    call tl_copy_chunks_0\n")
      (lacks "    movq %rax, %rax\n" "    movq %r12, %rax\n"))
    ;; bytes % 4 != 0 stays inline (canonical thunk never writes GP regs).
    (asm-ok?
      (compiler-backend-copy-thunk-test-run
        "copy_bytes %0, %1, 58"
        "%0=%r12 %1=%r13"
        3
        false
        false
        8
        58)
      (has "    movups (%r13), %xmm2\n")
      (lacks "call tl_copy_chunks_"))
    ;; Loop block keeps 56 B inline at -O2; -Os 32 B thunks with >=3 sites;
    ;; single-use 56 B stays inline.
    (asm-ok?
      (compiler-backend-copy-thunk-test-run
        "copy_bytes %0, %1, 56"
        "%0=%r12 %1=%r13"
        3
        true
        false
        8
        56)
      (has "    movups (%r13), %xmm2\n")
      (lacks "call tl_copy_chunks_"))
    (asm-ok?
      (compiler-backend-copy-thunk-test-run
        "copy_bytes %0, %1, 32"
        "%0=%r12 %1=%r13"
        3
        false
        true
        3
        32)
      (has "    call tl_copy_chunks_0\n")
      (lacks "    movups (%r13), %xmm2\n"))
    (asm-ok?
      (compiler-backend-copy-thunk-test-run
        "copy_bytes %0, %1, 56"
        "%0=%r12 %1=%r13"
        3
        false
        true
        1
        56)
      (has "    movups (%r13), %xmm2\n")
      (lacks "call tl_copy_chunks_"))
    ;; Enum-payload dst-disp == 8 direct pair (%rax, 8(%r12)) uses zero setup
    ;; and bakes the +8 destination bias into the canonical thunk body.
    (asm-ok?
      (compiler-backend-copy-thunk-test-run
        "%2 = gep %0, 1 : u64
         copy_bytes %2, %1, 56"
        "%0=%r12 %1=%rax"
        3
        false
        false
        300
        56)
      (has
        "    call tl_copy_chunks_0\n"
        "tl_copy_chunks_0:\n"
        "    movups (%rax), %xmm2\n"
        "    movups %xmm2, 8(%r12)\n"
        "    movsd 48(%rax), %xmm2\n"
        "    movsd %xmm2, 56(%r12)\n")
      (lacks "    leaq 8(%r12)"))
    ;; Hot 48 B direct read-only pair (%r13, %r12) uses zero setup and thunks.
    (asm-ok?
      (compiler-backend-copy-thunk-test-run
        "copy_bytes %0, %1, 48"
        "%0=%r12 %1=%r13"
        3
        false
        false
        200
        48)
      (has
        "    call tl_copy_chunks_0\n"
        "tl_copy_chunks_0:\n"
        "    movups (%r13), %xmm2\n"
        "    movups %xmm2, (%r12)\n")
      (lacks "    movq %r13, " "    movq %r12, "))
    ;; Non-loop 48 B stays inline at -O2 when setup-cost > 0.
    (asm-ok?
      (compiler-backend-copy-thunk-test-run
        "copy_bytes %0, %1, 48"
        "%0=%r14 %1=%r15"
        3
        false
        false
        200
        48)
      (has "    movups (%r15), %xmm2\n")
      (lacks "call tl_copy_chunks_"))))

(define (compiler-backend-scratch-staging-direct-home-shape-ok?) : bool
  (and
    (compiler-backend-copy-bytes-direct-home-shape-ok?)
    (compiler-backend-copy-bytes-live-through-shape-ok?)
    (compiler-backend-copy-bytes-run-protect-shape-ok?)
    (compiler-backend-canonical-copy-thunks-ok?)
    (be_state.backend-and4
      (compiler-backend-widening-cast-direct-home-shape-ok?)
      (compiler-backend-global-store-direct-home-shape-ok?)
      (compiler-backend-pack-direct-home-shape-ok?)
      true)))

(define (compiler-backend-address-mode-fusion-ok?) : bool
  (and
    (compiler-backend-forwarded-addr-of-register-home-refused-ok?)
    (compiler-backend-addr-of-forwarding-typed-load-shape-ok?)
    (be_state.backend-and8
      (compiler-backend-addr-of-forwarding-shape-ok?)
      (compiler-backend-addr-of-register-home-shape-ok?)
      (compiler-backend-addr-of-spill-scratch-shape-ok?)
      (compiler-backend-gep-copy-bytes-const-shape-ok?)
      (compiler-backend-gep-copy-bytes-index-shape-ok?)
      (compiler-backend-gep-load-r10-reuse-shape-ok?)
      (compiler-backend-gep-float-load-r10-reuse-shape-ok?)
      (compiler-backend-load-load-pointer-chase-shape-ok?))
    (be_state.backend-and4
      (compiler-backend-load-load-float-pointer-chase-shape-ok?)
      (compiler-backend-store-ptr-pair-shape-ok?)
      (compiler-backend-store-value-scratch-shape-ok?)
      (compiler-backend-store-home-base-shape-ok?))
    (be_state.backend-and4
      (compiler-backend-gep-load-compare-priority-shape-ok?)
      (compiler-backend-gep-load-store-order-shape-ok?)
      (compiler-backend-gep-load-register-homes-shape-ok?)
      (compiler-backend-gep-load-live-through-home-preserved-ok?))
    (compiler-backend-scratch-save-scavenged-not-framed-ok?)
    (be_state.backend-and4
      (compiler-backend-gep-load-multi-emergency-preserved-ok?)
      (compiler-backend-gep-store-index-home-preserved-ok?)
      (compiler-backend-store-address-source-home-preserved-ok?)
      (compiler-backend-win64-gep-offset-rax-home-ok?))
    (be_state.backend-and4
      (compiler-backend-gep-load-alu-fold-shape-ok?)
      (compiler-backend-gep-load-alu-fold-rejects-narrow-ok?)
      (compiler-backend-mul-pow2-lea-shape-ok?)
      (compiler-backend-mul-pow2-shl-shape-ok?))
    (be_state.backend-and4
      (compiler-backend-mul-non-pow2-imul-shape-ok?)
      (compiler-backend-gep-fold-disp-shape-ok?)
      (compiler-backend-gep-fold-multi-use-keeps-add-ok?)
      (compiler-backend-gep-fold-builders-ok?))
    (compiler-backend-mul-scale-add-shapes-ok?)
    (compiler-backend-lea-pair-shapes-ok?)
    (be_state.backend-and4
      (compiler-backend-gep-fold-sub-shape-ok?)
      (compiler-backend-gep-fold-zero-shape-ok?)
      (compiler-backend-gep-fold-address-taken-keeps-add-ok?)
      (compiler-backend-gep-fold-drift-detected-ok?))
    (compiler-backend-scavenge-narrow-window-ok?)
    (compiler-backend-chained-gep-same-home-ok?)
    (compiler-backend-cmp-mem-fold-shapes-ok?)
    (compiler-backend-gep-store-fold-shapes-ok?)))

;; When a variable-index Gep and its constant-offset consumer share the same
;; register, the first Gep can still write that home directly. The second Gep's
;; load then folds to a displacement from the just-computed address.
(define (compiler-backend-chained-gep-same-home-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r13 %1=%rax %2=%rax %3=%rax %4=%rax")]
    [instrs : ir.CompilerIrInstrSeq
      (irt.instrs
        "%2 = gep %0, %1 : u8
         %3 = gep %2, 8 : u8
         %4 = load %3 : i64")]
    (asm-ok?
      (compiler-backend-emit-test-instrs instrs assignments 5)
      (has "    leaq (%r13,%rax,1), %rax\n" "    movq 8(%rax), %rax\n")
      (lacks "(%rbp)"))))

;; GAP8: `Gep; Load(single-use, 8-byte); BinOp Add x v` folds the load into
;; the ALU memory operand: `addq (base,idx,8), dst` with no separate movq.
(define (compiler-backend-gep-load-alu-fold-shape-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%r8 %4=%r14 %5=%r14")]
    (match (compiler-backend-emit-test-instrs
      (irt.instrs
        "%2 = gep %0, %1 : i64
         %3 = load %2 : i64
         %5 = add %4, %3 : i64
         %6 = mov %5 : i64")
      assignments
      7)
      [(Ok asm)
        (and
          (asm-has? asm "    addq (%r12,%r8,8), %r14\n")
          (asm-lacks? asm "    movq (%r12,%r8,8)")
          (not
            (let
              [needle (compiler-backend-todo-marker)]
              (asm-has? asm needle))))]
      [(Err _) false])))

;; GAP8-B: the mirrored operand order. A COMMUTATIVE op whose LEFT operand is
;; the single-use fused load folds the same way -- `dst = MEM op x` is
;; `dst = x op MEM` -- so the memory operand still lands in the ALU's source
;; slot. `mem-on-lhs?` selects which side the load occupies; both must produce
;; the identical one-instruction shape.
(define (compiler-backend-gep-load-alu-commuted-asm
  [op : ir.CompilerIrBinOp]
  [mem-on-lhs? : bool]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-backend-test-instr-seq-prepend
      (irt.instr "%2 = gep %0, %1 : i64")
      (compiler-backend-test-instr-seq-prepend
        (Load 3 (Var 2) (I64))
        (compiler-backend-test-instr-seq-prepend
          (BinOp
            5
            op
            (if mem-on-lhs?
              (Var 3)
              (Var 4))
            (if mem-on-lhs?
              (Var 4)
              (Var 3))
            (I64))
          (irt.instrs "%6 = mov %5 : i64"))))
    (reg-homes "%0=%r12 %1=%r8 %4=%r14 %5=%r14")
    7))

(define (compiler-backend-gep-load-alu-commuted-shape-ok?
  [op : ir.CompilerIrBinOp]
  [mnem : String]
  [mem-on-lhs? : bool]) : bool
  (match (compiler-backend-gep-load-alu-commuted-asm op mem-on-lhs?)
    [(Ok asm)
      (and
        (let
          [needle (str_cat.str-cat "    " mnem "q (%r12,%r8,8), %r14\n")]
          (asm-has? asm needle))
        (asm-lacks? asm "    movq (%r12,%r8,8)")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

;; Sub is NOT commutative: `MEM - x` is not `x - MEM`, so the mirrored order
;; keeps the load and the register-form subtract.
(define (compiler-backend-gep-load-alu-commuted-rejects-sub-ok?) : bool
  (asm-ok?
    (compiler-backend-gep-load-alu-commuted-asm (Sub) true)
    (has "    movq (%r12,%r8,8)")
    (lacks "    subq (%r12,%r8,8), %r14\n")))

(define (compiler-backend-gep-load-alu-commuted-shapes-ok?) : bool
  (and
    (be_state.backend-and4
      (compiler-backend-gep-load-alu-commuted-shape-ok? (BitAnd) "and" true)
      (compiler-backend-gep-load-alu-commuted-shape-ok? (BitOr) "or" true)
      (compiler-backend-gep-load-alu-commuted-shape-ok? (BitXor) "xor" true)
      (compiler-backend-gep-load-alu-commuted-shape-ok? (Add) "add" true))
    (be_state.backend-and4
      (compiler-backend-gep-load-alu-commuted-shape-ok? (BitAnd) "and" false)
      (compiler-backend-gep-load-alu-commuted-shape-ok? (BitOr) "or" false)
      (compiler-backend-gep-load-alu-commuted-shape-ok? (BitXor) "xor" false)
      (compiler-backend-gep-load-alu-commuted-rejects-sub-ok?))))

;; GAP9: an offset add feeding only a same-block gep index folds into the
;; addressing displacement -- the add vanishes, the load reads
;; `disp(base,counter,scale)` -- exercised through the pre-pass plus the
;; fused load emission (ordinal consumption included).
(define (compiler-backend-gep-fold-test-blocks [second-use : bool]) : ir.CompilerIrBlockList
  (compiler-backend-gep-fold-test-blocks-with second-use (Add) 1))

;; GAP9-SUB: the same shape with the offset written as `sub j, 1` (folds as
;; displacement -8) and as `add j, 0` (folds as displacement 0 and retires
;; the copy the add cost).
(define (compiler-backend-gep-fold-test-blocks-with
  [second-use : bool]
  [op : ir.CompilerIrBinOp]
  [k : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (compiler-backend-test-instr-seq-prepend
        (BinOp 2 op (Var 1) (I64 k) (I64))
        (compiler-backend-test-instr-seq-prepend
          (irt.instr "%3 = gep %0, %2 : i64")
          (compiler-backend-test-instr-seq-prepend
            (irt.instr "%4 = load %3 : i64")
            (compiler-backend-test-instr-seq-prepend
              (irt.instr "%5 = mov %4 : i64")
              (if second-use
                (irt.instrs "%6 = mov %2 : i64")
                (ir.compiler-ir-instr-seq-empty)))))))))

;; An address-taken base must keep the offset add: a store or a call through
;; `addr_of` the base redefines it without a direct def, so the gep cannot
;; re-read the base for its displacement (#9420 GAP9).
(define (compiler-backend-gep-fold-test-blocks-addr-taken) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (compiler-backend-test-instr-seq-prepend
        (AddrOf 6 1 0)
        (compiler-backend-gep-fold-test-entry-instrs
          (compiler-backend-gep-fold-test-blocks false))))))

(define (compiler-backend-gep-fold-test-entry-instrs
  [blocks : ir.CompilerIrBlockList]) : ir.CompilerIrInstrSeq
  (match (ir.compiler-ir-block-list-view blocks)
    [(slice block & _)
      (match (owned_view.compiler-owned-reference-shared-view block)
        [(Block _ instrs) instrs])]
    [_ (ir.compiler-ir-instr-seq-empty)]))

(define (compiler-backend-gep-fold-test-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r8 %4=%r14 %5=%r13"))

(define (compiler-backend-gep-fold-disp-shape-ok?) : bool
  (compiler-backend-gep-fold-disp-shape-with-ok?
    (Add)
    1
    "8(%r12,%r8,8)"
    "addq $1"
    "leaq 1("))

;; GAP9-SUB: `sub j, 1` folds as `-8(base,j,8)` and nothing computes j - 1.
;; R4-C: the narrow staging window is admitted for R4-B's scalar compute
;; family, and for any instruction outside the sibling-reordering load
;; families; inside one of those families (the pair-emission flag) only the
;; R4-B admission opens it.
(define (compiler-backend-scavenge-narrow-window-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [function-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state backend-state)]
    (be_state.compiler-backend-function-scratch-set-bool!
      function-state
      be_state.compiler-backend-scratch-bool-instr-staging-narrow-ok
      false)
    (be_state.compiler-backend-function-scratch-set-bool!
      function-state
      be_state.compiler-backend-scratch-bool-pair-emission
      false)
    (be_state.backend-and4
      ;; a lone load/gep/store outside any pair: narrow
      (be_operand.compiler-backend-scavenge-narrow-window? function-state)
      ;; inside a sibling-reordering family: wide
      (begin
        (be_state.compiler-backend-function-scratch-set-bool!
          function-state
          be_state.compiler-backend-scratch-bool-pair-emission
          true)
        (not
          (be_operand.compiler-backend-scavenge-narrow-window? function-state)))
      ;; R4-B's scalar admission still opens it there
      (begin
        (be_state.compiler-backend-function-scratch-set-bool!
          function-state
          be_state.compiler-backend-scratch-bool-instr-staging-narrow-ok
          true)
        (be_operand.compiler-backend-scavenge-narrow-window? function-state))
      ;; and the flag cleared again restores the lone-instruction answer
      (begin
        (be_state.compiler-backend-function-scratch-set-bool!
          function-state
          be_state.compiler-backend-scratch-bool-instr-staging-narrow-ok
          false)
        (be_state.compiler-backend-function-scratch-set-bool!
          function-state
          be_state.compiler-backend-scratch-bool-pair-emission
          false)
        (be_operand.compiler-backend-scavenge-narrow-window? function-state)))))

(define (compiler-backend-gep-fold-sub-shape-ok?) : bool
  (compiler-backend-gep-fold-disp-shape-with-ok?
    (Sub)
    1
    "-8(%r12,%r8,8)"
    "subq $1"
    "leaq -1("))

;; GAP9-SUB: `add j, 0` folds as `(base,j,8)` and the add's copy is gone.
(define (compiler-backend-gep-fold-zero-shape-ok?) : bool
  (compiler-backend-gep-fold-disp-shape-with-ok?
    (Add)
    0
    "(%r12,%r8,8)"
    "addq $0"
    "movq %r8,"))

(define (compiler-backend-gep-fold-disp-shape-with-ok?
  [op : ir.CompilerIrBinOp]
  [k : i64]
  [want : String]
  [forbid-a : String]
  [forbid-b : String]) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [folded : ir.CompilerIrBlockList
      (backend.compiler-backend-gep-fold-blocks
        (be_state.compiler-backend-state-function-state backend-state)
        (ast.ast-node-pool-reader-type-segment-bases)
        8
        (compiler-backend-gep-fold-test-blocks-with false op k))]
    [result : bool
      (if (not (state-gep-fold-ready backend-state))
        false
        (match (compiler-backend-emit-test-instrs-target-with-backend-state
          (compiler-backend-gep-fold-test-entry-instrs folded)
          (compiler-backend-gep-fold-test-assignments)
          8
          (be_state.CompilerBackendTarget.Linux)
          backend-state)
          [(Ok asm)
            (and
              (asm-has? asm want)
              (asm-lacks? asm forbid-a forbid-b)
              (not
                (backend.compiler-backend-gep-fold-drift?
                  (be_state.compiler-backend-state-function-state backend-state))))]
          [(Err _) false]))]
    (backend.compiler-backend-gep-fold-disable!
      (be_state.compiler-backend-state-function-state backend-state))
    result))

;; An address-taken base keeps the add and the plain zero-displacement
;; addressing; the fold must not re-read the base at the access.
(define (compiler-backend-gep-fold-address-taken-keeps-add-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [folded : ir.CompilerIrBlockList
      (backend.compiler-backend-gep-fold-blocks
        (be_state.compiler-backend-state-function-state backend-state)
        (ast.ast-node-pool-reader-type-segment-bases)
        8
        (compiler-backend-gep-fold-test-blocks-addr-taken))]
    [result : bool
      (if (state-gep-fold-ready backend-state)
        false
        (asm-ok?
          (compiler-backend-emit-test-instrs-target-with-backend-state
            (compiler-backend-gep-fold-test-entry-instrs folded)
            (compiler-backend-gep-fold-test-assignments)
            8
            (be_state.CompilerBackendTarget.Linux)
            backend-state)
          (has "    movq (%r12,%r8,8), %r14\n")
          (lacks "8(%r12,%r8,8)")))]
    (backend.compiler-backend-gep-fold-disable!
      (be_state.compiler-backend-state-function-state backend-state))
    result))

;; A second (non-gep) use of the offset var keeps the add and the plain
;; zero-displacement addressing.
(define (compiler-backend-gep-fold-multi-use-keeps-add-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [folded : ir.CompilerIrBlockList
      (backend.compiler-backend-gep-fold-blocks
        (be_state.compiler-backend-state-function-state backend-state)
        (ast.ast-node-pool-reader-type-segment-bases)
        8
        (compiler-backend-gep-fold-test-blocks true))]
    [result : bool
      (if (state-gep-fold-ready backend-state)
        false
        (asm-ok?
          (compiler-backend-emit-test-instrs-target-with-backend-state
            (compiler-backend-gep-fold-test-entry-instrs folded)
            (compiler-backend-gep-fold-test-assignments)
            8
            (be_state.CompilerBackendTarget.Linux)
            backend-state)
          (has "(%r12,")
          (lacks "8(%r12,")))]
    (backend.compiler-backend-gep-fold-disable!
      (be_state.compiler-backend-state-function-state backend-state))
    result))

;; The disp-aware address builders.
(define (compiler-backend-gep-fold-builders-ok?) : bool
  (and
    (string.eq
      (be_scalar.compiler-backend-gep-index-address-disp 8 "%rax" 8 "%rcx")
      "8(%rax,%rcx,8)")
    (string.eq
      (be_scalar.compiler-backend-gep-index-address-disp 0 "%rax" 8 "%rcx")
      "(%rax,%rcx,8)")
    (string.eq
      (be_scalar.compiler-backend-gep-index-address-disp 8 "%rax" 32 "%rcx")
      "")
    (let
      [text
        (be_scalar.compiler-backend-gep-index-base-asm-disp 24 "%rax" 32 "%rcx")]
      (asm-has? text "    addq $24, %rax\n"))))

;; Consuming an ordinal with the wrong shape poisons the function (the
;; emit-function gate turns this into a hard backend error).
(define (compiler-backend-gep-fold-drift-detected-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_folded : ir.CompilerIrBlockList
      (backend.compiler-backend-gep-fold-blocks
        (be_state.compiler-backend-state-function-state backend-state)
        (ast.ast-node-pool-reader-type-segment-bases)
        8
        (compiler-backend-gep-fold-test-blocks false))]
    [result : bool
      (if (not (state-gep-fold-ready backend-state))
        false
        (begin
          ;; wrong scale: recorded scale is 8 (i64), consume with u8.
          (let
            [function-state
              (be_state.compiler-backend-state-function-state backend-state)]
            [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
            [offset (ir.CompilerIrValue.Var 1)]
            [elem-ty (ast.AstType.U8)]
            (backend.compiler-backend-gep-fold-next!
              function-state
              type-segment-bases
              offset
              elem-ty))
          (backend.compiler-backend-gep-fold-drift?
            (be_state.compiler-backend-state-function-state backend-state))))]
    (backend.compiler-backend-gep-fold-disable!
      (be_state.compiler-backend-state-function-state backend-state))
    result))

;; A narrow (u8) load must NOT fold: the memory operand width would not match
;; the 64-bit ALU op. The fused movzbq load stays.
(define (compiler-backend-gep-load-alu-fold-rejects-narrow-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%r8 %3=%rcx %4=%r14 %5=%r14")]
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs
          "%2 = gep %0, %1 : u8
           %3 = load %2 : u8
           %5 = add %4, %3 : i64
           %6 = mov %5 : i64")
        assignments
        7)
      (has "    movzbl (%r12,%r8,1), %ecx\n")
      (lacks "    addq (%r12"))))

;; M6: folding a single-use load into the comparing instruction's memory
;; operand. Shared homes for the fixtures below: base %r12, gep index %r8, the
;; loaded value %r13, the compare's other operand %r14, a width-preserving cast
;; of that other operand %r14 again (so the cast is a self-move the walk may
;; step over), the widening cast result %r9 and the compare result %r15.
(define (compiler-backend-cmp-mem-fold-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r8 %3=%r13 %4=%r14 %5=%r15 %6=%r9 %7=%r14"))

;; `gep(elem, base + index) ; load ; cast to i64 ; compare with a literal ;
;; branch` -- the M6-C narrow shape.
(define (compiler-backend-cmp-mem-narrow-asm
  [elem-ty : ast.AstType]
  [load-ty : ast.AstType]
  [op : ir.CompilerIrBinOp]
  [literal : i64]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-backend-test-instr-seq-prepend
      (Gep 2 (Var 0) (Var 1) elem-ty)
      (compiler-backend-test-instr-seq-prepend
        (Load 3 (Var 2) (owned_view.compiler-owned-shared-view load-ty))
        (compiler-backend-test-instr-seq-prepend
          (Cast 6 (Var 3) load-ty (I64))
          (compiler-backend-test-instr-seq-prepend
            (BinOp 5 op (Var 6) (I64 literal) (I64))
            (irt.instrs "branch %5, hit, miss")))))
    (compiler-backend-cmp-mem-fold-assignments)
    8))

;; A zero-extending byte load whose literal is inside `0 .. 255` folds to a
;; BYTE compare: `movzbq (mem), %r ; cmpq $10, %r` becomes `cmpb $10, (mem)`.
(define (compiler-backend-cmp-mem-byte-fold-shape-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-narrow-asm (U8) (U8) (Eq) 10)
    (has "    cmpb $10, (%r12,%r8,1)\n")
    (lacks "    movzbq " "    movzbl ")))

;; The same at WORD width, and with a literal above the byte range so the width
;; is load-bearing rather than incidental.
(define (compiler-backend-cmp-mem-word-fold-shape-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-narrow-asm (U16) (U16) (Eq) 300)
    (has "    cmpw $300, (%r12,%r8,2)\n")
    (lacks "    movzwq " "    movzwl ")))

;; Signedness/width refusal: a SIGN-extending byte load cannot produce 200, so
;; `ext(mem) == 200` is constant-false while `cmpb $200, (mem)` would be true
;; for the byte 0xC8. The fold declines and the widening load stays.
(define (compiler-backend-cmp-mem-narrow-rejects-signed-literal-ok?) : bool
  (match (compiler-backend-cmp-mem-narrow-asm (I8) (I8) (Eq) 200)
    [(Ok asm)
      (and
        ;; The narrow compare fold is refused, so the load survives -- and M6-G
        ;; then claims the pair the refusal leaves behind, giving the load the
        ;; WIDENING CAST's home (%r9) instead of the loaded value's own (%r13)
        ;; and retiring the separate re-extension. Both halves are asserted.
        (asm-has? asm "    movsbq (%r12,%r8,1), %r9\n")
        (asm-lacks? asm "    movsbq %r13b, ")
        (asm-lacks? asm "    cmpb "))]
    [(Err _) false]))

;; Ordered narrow comparisons are refused outright: a zero-extended byte
;; compared with `jl` at 64 bits is a comparison of a non-negative value, which
;; an 8-bit SIGNED compare does not reproduce.
(define (compiler-backend-cmp-mem-narrow-rejects-ordered-ok?) : bool
  (match (compiler-backend-cmp-mem-narrow-asm (U8) (U8) (Lt) 10)
    [(Ok asm)
      (and
        ;; Same division of labour as the signed-literal refusal above: M6-C
        ;; declines the ordered narrow compare, M6-G folds the re-extension the
        ;; refusal leaves behind, so the surviving load writes the widening
        ;; cast's home %r9 and no separate zero-extension follows it.
        (asm-has? asm "    movzbl (%r12,%r8,1), %r9d\n")
        (asm-lacks? asm "    movzbq %r13b, " "    movzbl %r13b, ")
        (asm-lacks? asm "    cmpb "))]
    [(Err _) false]))

;; M6-J: `gep ; load ; compare AT THE LOAD'S OWN WIDTH ; branch` -- no widening
;; cast, the shape a `char`/`u8` scanner has. Var 3 is the loaded value and Var 4
;; the register-homed (%r14) other operand, as in the M6-C fixture.
(define (compiler-backend-cmp-mem-direct-asm
  [ty : ast.AstType]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-backend-test-instr-seq-prepend
      (Gep 2 (Var 0) (Var 1) (owned_view.compiler-owned-shared-view ty))
      (compiler-backend-test-instr-seq-prepend
        (Load 3 (Var 2) (owned_view.compiler-owned-shared-view ty))
        (compiler-backend-test-instr-seq-prepend
          (BinOp 5 op lhs rhs ty)
          (irt.instrs "branch %5, hit, miss"))))
    (compiler-backend-cmp-mem-fold-assignments)
    8))

(define (compiler-backend-cmp-mem-direct-has?
  [asm : (& asm str)]
  [want : String]) : bool
  (asm-has? asm want))

;; A `char` compared with a char literal reads the byte in place:
;; `movzbq (mem), %r13 ; cmpb $47, %r13b` becomes `cmpb $47, (mem)`.
(define (compiler-backend-cmp-mem-direct-char-fold-ok?) : bool
  (match (compiler-backend-cmp-mem-direct-asm (Char) (Ne) (Var 3) (Char '/'))
    [(Ok asm)
      (and
        (compiler-backend-cmp-mem-direct-has?
          asm
          "    cmpb $47, (%r12,%r8,1)\n")
        (asm-lacks? asm "    movzbq " "    movzbl "))]
    [(Err _) false]))

;; Unlike M6-C, an ORDERED compare folds too: the compare already runs at the
;; byte width and its own (unsigned) jcc, so only the operand source changes.
(define (compiler-backend-cmp-mem-direct-ordered-fold-ok?) : bool
  (match (compiler-backend-cmp-mem-direct-asm (U8) (Lt) (Var 3) (I64 10))
    [(Ok asm)
      (and
        (compiler-backend-cmp-mem-direct-has?
          asm
          "    cmpb $10, (%r12,%r8,1)\n")
        (or
          (compiler-backend-cmp-mem-direct-has? asm "    jb ")
          (compiler-backend-cmp-mem-direct-has? asm "    jae "))
        (asm-lacks? asm "    movzbq " "    movzbl "))]
    [(Err _) false]))

;; A register other operand is spelled at the byte width, on whichever side
;; the IR compare put it: `cmpb %r14b, (mem)` for `mem != r`, and
;; `cmpb (mem), %r14b` for the ordered `r < mem`.
(define (compiler-backend-cmp-mem-direct-register-fold-ok?) : bool
  (and
    (match (compiler-backend-cmp-mem-direct-asm (U8) (Ne) (Var 3) (Var 4))
      [(Ok asm)
        (and
          (compiler-backend-cmp-mem-direct-has?
            asm
            "    cmpb %r14b, (%r12,%r8,1)\n")
          (asm-lacks? asm "    movzbq " "    movzbl "))]
      [(Err _) false])
    (match (compiler-backend-cmp-mem-direct-asm (U8) (Lt) (Var 4) (Var 3))
      [(Ok asm)
        (and
          (compiler-backend-cmp-mem-direct-has?
            asm
            "    cmpb (%r12,%r8,1), %r14b\n")
          (asm-lacks? asm "    movzbq " "    movzbl "))]
      [(Err _) false])))

;; Refusals: an ordered compare with the literal on the LEFT (the memory operand
;; would have to be the source and a literal cannot be the destination), and a
;; literal the signed byte cannot hold. Both keep the load.
(define (compiler-backend-cmp-mem-direct-refusals-ok?) : bool
  (and
    (match (compiler-backend-cmp-mem-direct-asm (U8) (Lt) (I64 10) (Var 3))
      [(Ok asm)
        (and
          (compiler-backend-cmp-mem-direct-has? asm "    movzbl (%r12,%r8,1), ")
          (not (compiler-backend-cmp-mem-direct-has? asm ", (%r12,%r8,1)\n")))]
      [(Err _) false])
    (match (compiler-backend-cmp-mem-direct-asm (I8) (Eq) (Var 3) (I64 200))
      [(Ok asm)
        (and
          (compiler-backend-cmp-mem-direct-has? asm "    movsbq (%r12,%r8,1), ")
          (not
            (compiler-backend-cmp-mem-direct-has?
              asm
              "    cmpb $200, (%r12,%r8,1)")))]
      [(Err _) false])))

;; M6-A: `gep(i64, base + 1) ; load ; bounds_check(index, load)`. `tail` lets a
;; fixture add a SECOND use of the loaded value behind the check.
(define (compiler-backend-cmp-mem-bounds-asm [tail : ir.CompilerIrInstrSeq]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-backend-test-instr-seq-prepend
      (irt.instr "%2 = gep %0, 1 : i64")
      (compiler-backend-test-instr-seq-prepend
        (Load 3 (Var 2) (I64))
        (compiler-backend-test-instr-seq-prepend
          (irt.instr "bounds_check %4, %3 message \"ok\"")
          tail)))
    (compiler-backend-cmp-mem-fold-assignments)
    8))

(define (compiler-backend-cmp-mem-bounds-fold-shape-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-bounds-asm (ir.compiler-ir-instr-seq-empty))
    (has "    cmpq 8(%r12), %r14\n")
    (lacks "    movq 8(%r12)")))

;; A second use of the loaded length keeps the load: the home register is read
;; again, so it must actually be written.
(define (compiler-backend-cmp-mem-bounds-second-use-refused-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-bounds-asm (irt.instrs "%7 = mov %3 : i64"))
    (has "    movq 8(%r12), %r13\n")
    (lacks "    cmpq 8(%r12)")))

;; The `(& str)` spelling puts two width-preserving casts between the `.len`
;; load and its bounds check (`i64 -> u64` for the length and for the index).
;; Both emit nothing -- the index cast's operands share a home -- so the walk
;; steps over them and the fold still fires.
(define (compiler-backend-cmp-mem-bounds-cast-fold-ok?) : bool
  (asm-ok?
    (compiler-backend-emit-test-instrs
      (irt.instrs
        "%2 = gep %0, 1 : i64
         %3 = load %2 : i64
         %7 = cast %4 : i64 to u64
         %6 = cast %3 : i64 to u64
         bounds_check %7, %6 message \"ok\"")
      (compiler-backend-cmp-mem-fold-assignments)
      8)
    (has "    cmpq 8(%r12), %r14\n")
    (lacks "    movq 8(%r12)")))

;; M6-B tail: `compare ; branch`. `mem-on-rhs?` puts the loaded value on the
;; compare's RIGHT so the address takes the AT&T SOURCE slot instead of the
;; destination one.
(define (compiler-backend-cmp-mem-wide-tail [mem-on-rhs? : bool]) : ir.CompilerIrInstrSeq
  (compiler-backend-test-instr-seq-prepend
    (BinOp
      5
      (Lt)
      (if mem-on-rhs?
        (Var 4)
        (Var 3))
      (if mem-on-rhs?
        (Var 3)
        (Var 4))
      (I64))
    (irt.instrs "branch %5, lt, ge")))

;; `gep(i64, base + index) ; load ; <rest>`, where `rest` is a wide tail with
;; any refusal instruction the fixture wants in front of it.
(define (compiler-backend-cmp-mem-wide-asm [rest : ir.CompilerIrInstrSeq]) : be_state.ResultCompilerBackend
  (compiler-backend-cmp-mem-wide-asm-with
    rest
    (compiler-backend-cmp-mem-fold-assignments)))

(define (compiler-backend-cmp-mem-wide-asm-with
  [rest : ir.CompilerIrInstrSeq]
  [assignments : regalloc.CompilerRegAssignmentTable]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-backend-test-instr-seq-prepend
      (irt.instr "%2 = gep %0, %1 : i64")
      (compiler-backend-test-instr-seq-prepend (Load 3 (Var 2) (I64)) rest))
    assignments
    8))

;; M6-D fixtures: the same shape with one address component SPILLED. Everything
;; else keeps the shared homes, so the fold's staging register is the load
;; destination's own home %r13.
(define (compiler-backend-cmp-mem-staged-assignments
  [base-spilled? : bool]
  [index-spilled? : bool]) : regalloc.CompilerRegAssignmentTable
  (regalloc.compiler-reg-assignments-prepend
    (&
      (regalloc.CompilerRegAssignment
        0
        (if base-spilled?
          (Spill 16)
          (Register cabi.compiler-reg-id-r12))))
    (regalloc.compiler-reg-assignments-prepend
      (&
        (regalloc.CompilerRegAssignment
          1
          (if index-spilled?
            (Spill 24)
            (Register cabi.compiler-reg-id-r8))))
      (reg-homes "%3=%r13 %4=%r14 %5=%r15"))))

;; A spilled BASE stages into the load destination's home and the compare reads
;; `(%r13,%r8,8)` -- two instructions where the unfolded path emitted three.
(define (compiler-backend-cmp-mem-staged-base-fold-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm-with
    (compiler-backend-cmp-mem-wide-tail false)
    (compiler-backend-cmp-mem-staged-assignments true false))
    [(Ok asm)
      (and
        (asm-has? asm "    cmpq %r14, (%r13,%r8,8)\n")
        (asm-lacks? asm "    movq (%r13,%r8,8)")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

;; The mirror: a spilled INDEX stages into the same home and the register-homed
;; base keeps the SIB base slot.
(define (compiler-backend-cmp-mem-staged-index-fold-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm-with
    (compiler-backend-cmp-mem-wide-tail false)
    (compiler-backend-cmp-mem-staged-assignments false true))
    [(Ok asm)
      (and
        (asm-has? asm "    cmpq %r14, (%r12,%r13,8)\n")
        (asm-lacks? asm "    movq (%r12,%r13,8)")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

;; Both components spilled would need two staging registers; the fold owns one,
;; so it declines and the ordinary load path emits the compare's operand.
(define (compiler-backend-cmp-mem-staged-both-refused-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-wide-asm-with
      (compiler-backend-cmp-mem-wide-tail false)
      (compiler-backend-cmp-mem-staged-assignments true true))
    (has "    cmpq %r14, %r13\n")
    (lacks "    cmpq %r14, (")))

;; A SECOND use of the loaded value keeps it in its home: the fold would drop
;; the only definition the later use reads.
(define (compiler-backend-cmp-mem-staged-second-use-refused-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-wide-asm-with
      (irt.instrs
        "%5 = lt %3, %4 : i64
         %6 = mov %3 : i64
         branch %5, lt, ge")
      (compiler-backend-cmp-mem-staged-assignments true false))
    (lacks "    cmpq %r14, (%r13,%r8,8)\n")))

(define (compiler-backend-cmp-mem-wide-rhs-fold-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-wide-asm
      (compiler-backend-cmp-mem-wide-tail true))
    (has "    cmpq (%r12,%r8,8), %r14\n")
    (lacks "    movq (%r12,%r8,8)")))

;; A memory write between the load and the compare stops the walk: the folded
;; operand would be read after the store instead of before it.
(define (compiler-backend-cmp-mem-store-between-refused-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-wide-asm
      (irt.instrs
        "store_ptr %0, 7 : i64
         %5 = lt %3, %4 : i64
         branch %5, lt, ge"))
    (has "    movq (%r12,%r8,8), %r13\n")
    (lacks "    cmpq (%r12,%r8,8)")))

;; So does a flag writer: the compare must be the instruction that sets the
;; flags the branch reads.
(define (compiler-backend-cmp-mem-flags-between-refused-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-wide-asm
      (irt.instrs
        "%6 = sub %4, 1 : i64
         %5 = lt %3, %4 : i64
         branch %5, lt, ge"))
    (has "    movq (%r12,%r8,8), %r13\n")
    (lacks "    cmpq (%r12,%r8,8)")))

;; M6-F: a SPILLED compare operand on the side that takes the AT&T SOURCE slot
;; is a legal memory operand as long as the other side is a register, so the
;; reload the staging path emitted is dropped. Var 4 (the compare's other
;; operand) is spilled here; var 3, the loaded value, keeps its register home
;; and occupies the destination slot.
(define (compiler-backend-cmp-mem-spilled-rhs-fold-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm-with
    (compiler-backend-cmp-mem-wide-tail false)
    (reg-homes "%0=%r12 %1=%r8 %3=%r13 %4=spill:32 %5=%r15"))
    [(Ok asm)
      ;; The loaded value keeps its register home (the memory-operand compare
      ;; cannot take BOTH sides), and the spilled other operand is spelled
      ;; straight into the compare's source slot instead of being reloaded --
      ;; exactly one memory operand, which is all x86 allows.
      (and
        (asm-has?
          asm
          "    movq (%r12,%r8,8), %r13\n"
          "    cmpq 32(%rbp), %r13\n")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

;; M6-E must read scratch registers from the Branch's real plan slot when the
;; narrow fold consumes a widening Cast. The merge value forces a phi-edge copy
;; (`xorl %esi, %esi` on the false edge); without the +4 lookup M6-C declines
;; and leaves a separate `movzbq` plus `cmpq`.
(define compiler-backend-cmp-mem-narrow-phi-copy-source : String
  "(define (probe [p : (Ptr u8)] [i : i64]) : i64
  (let
    [value : i64
      (if
        (=
          (cast (unsafe (ptr-read (ptr-offset p i))) : i64)
          10)
        i
        0)]
    (+ value 1)))
(define (main) : i64
  (probe (ptr-null : (Ptr u8)) 0))")

(define (compiler-backend-cmp-mem-narrow-phi-copy-fold-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-cmp-mem-narrow-phi-copy-source))
    (be_state.CompilerBackendTarget.Linux))
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_probe")]
        (be_state.backend-and4
          (asm-has? body "    cmpb $10, (")
          (asm-has? body "    xorl %esi, %esi\n")
          (asm-lacks? body "    movzbq " "    movzbl ")
          (asm-lacks? body "    cmpq ")))]
    [(Err _) false]))

;; M6-I: a scalar GLOBAL read (`Mov dst @g`, rendered `movq g(%rip), %r`)
;; whose only reader is the compare behind it folds into that compare's
;; rip-relative memory operand. The fixtures share the M6 homes above, so the
;; moved value is %r13, the compare's other operand %r14 and its result %r15.
(define (compiler-backend-cmp-mem-global-asm-target
  [rest : ir.CompilerIrInstrSeq]
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs-target
    (compiler-backend-test-instr-seq-prepend
      (Mov 3 (Global (ci.intern "m6i_gen")) (I64))
      rest)
    (compiler-backend-cmp-mem-fold-assignments)
    8
    target))

(define (compiler-backend-cmp-mem-global-asm [rest : ir.CompilerIrInstrSeq]) : be_state.ResultCompilerBackend
  (compiler-backend-cmp-mem-global-asm-target
    rest
    (be_state.CompilerBackendTarget.Linux)))

;; `compare-with-a-literal ; branch`, with the global read on either side. An
;; immediate can only reach the compare's DESTINATION slot by exchanging the
;; operands, which only an equality-shaped compare permits.
(define (compiler-backend-cmp-mem-global-imm-tail
  [op : ir.CompilerIrBinOp]
  [mem-on-rhs? : bool]) : ir.CompilerIrInstrSeq
  (ir.compiler-ir-instr-seq2
    (BinOp
      5
      op
      (if mem-on-rhs?
        (I64 7)
        (Var 3))
      (if mem-on-rhs?
        (Var 3)
        (I64 7))
      (I64))
    (irt.instr "branch %5, hit, miss")))

;; The global read is the compare's LEFT operand, which is the AT&T
;; DESTINATION slot: `movq g(%rip), %r13 ; cmpq %r14, %r13` becomes one line.
(define (compiler-backend-cmp-mem-global-lhs-fold-ok?) : bool
  (match (compiler-backend-cmp-mem-global-asm
    (compiler-backend-cmp-mem-wide-tail false))
    [(Ok asm)
      (and
        (asm-has? asm "    cmpq %r14, _tl_m6i_gen(%rip)\n" "    jl ")
        (asm-lacks? asm "    movq _tl_m6i_gen(%rip)")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

;; The mirror: the read is the compare's RIGHT operand, so the rip-relative
;; operand takes the SOURCE slot and the register operand the destination one.
;; The jcc is unchanged, because the AT&T operand order flipped with it.
(define (compiler-backend-cmp-mem-global-rhs-fold-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-global-asm
      (compiler-backend-cmp-mem-wide-tail true))
    (has "    cmpq _tl_m6i_gen(%rip), %r14\n" "    jl ")
    (lacks "    movq _tl_m6i_gen(%rip)")))

;; An equality compare against a literal folds from either side: the operands
;; may be exchanged, so the literal reaches the source slot and the cell the
;; destination one.
(define (compiler-backend-cmp-mem-global-imm-fold-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-global-asm
      (compiler-backend-cmp-mem-global-imm-tail (Eq) true))
    (has "    cmpq $7, _tl_m6i_gen(%rip)\n")
    (lacks "    movq _tl_m6i_gen(%rip)")))

;; An ORDERED compare with the literal on the side the memory operand does not
;; occupy cannot be exchanged, so the fold declines and the read survives.
(define (compiler-backend-cmp-mem-global-imm-ordered-refused-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-global-asm
      (compiler-backend-cmp-mem-global-imm-tail (Lt) true))
    (has "    movq _tl_m6i_gen(%rip), %r13\n")
    (lacks "    cmpq $7, _tl_m6i_gen(%rip)\n")))

;; A SECOND use of the moved value keeps the read: the fold would drop the only
;; definition that use reads. The extra use sits behind the branch so the
;; compare/branch run itself is untouched and the single-use gate is the only
;; thing that can refuse.
(define (compiler-backend-cmp-mem-global-second-use-refused-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-global-asm
      (ir.compiler-ir-instr-seq3
        (irt.instr "%5 = lt %3, %4 : i64")
        (irt.instr "branch %5, lt, ge")
        (Mov 6 (Var 3) (I64))))
    (has "    movq _tl_m6i_gen(%rip), %r13\n")
    (lacks "    cmpq %r14, _tl_m6i_gen(%rip)\n")))

;; A memory write between the read and the compare ends the fold walk at
;; itself, so the probe finds no compare there and declines: the folded operand
;; would otherwise be read AFTER the store instead of before it.
(define (compiler-backend-cmp-mem-global-store-between-refused-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-global-asm
      (irt.instrs
        "store_ptr %0, 7 : i64
         %5 = lt %3, %4 : i64
         branch %5, lt, ge"))
    (has "    movq _tl_m6i_gen(%rip), %r13\n")
    (lacks "    cmpq %r14, _tl_m6i_gen(%rip)\n")))

;; A store to the CELL ITSELF between the read and the compare is refused for
;; the same reason: the fold walk admits only size-preserving casts, so the
;; store ends it and the probe finds no compare there. Folding across it would
;; read the cell AFTER the write instead of before it.
(define (compiler-backend-cmp-mem-global-self-store-refused-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-global-asm
      (compiler-backend-test-instr-seq-prepend
        (Store (ci.intern "m6i_gen") (I64 7) (I64))
        (compiler-backend-cmp-mem-wide-tail false)))
    (has "    movq _tl_m6i_gen(%rip), %r13\n" "_tl_m6i_gen(%rip)\n")
    (lacks "    cmpq %r14, _tl_m6i_gen(%rip)\n")))

;; Win64 spells a global read `g(%rip)` exactly as SysV does, so the fold is
;; target-independent and the Windows body must carry the same folded compare.
(define (compiler-backend-cmp-mem-global-windows-fold-ok?) : bool
  (asm-ok?
    (compiler-backend-cmp-mem-global-asm-target
      (compiler-backend-cmp-mem-wide-tail false)
      (be_state.CompilerBackendTarget.Windows))
    (has "    cmpq %r14, _tl_m6i_gen(%rip)\n")
    (lacks "    movq _tl_m6i_gen(%rip)")))

(define (compiler-backend-cmp-mem-global-fold-shapes-ok?) : bool
  (and
    (be_state.backend-and4
      (compiler-backend-cmp-mem-global-lhs-fold-ok?)
      (compiler-backend-cmp-mem-global-rhs-fold-ok?)
      (compiler-backend-cmp-mem-global-imm-fold-ok?)
      (compiler-backend-cmp-mem-global-imm-ordered-refused-ok?))
    (compiler-backend-cmp-mem-global-second-use-refused-ok?)
    (compiler-backend-cmp-mem-global-store-between-refused-ok?)
    (compiler-backend-cmp-mem-global-self-store-refused-ok?)
    (compiler-backend-cmp-mem-global-windows-fold-ok?)))

(define (compiler-backend-cmp-mem-fold-shapes-ok?) : bool
  (and
    (be_state.backend-and4
      (compiler-backend-cmp-mem-byte-fold-shape-ok?)
      (compiler-backend-cmp-mem-word-fold-shape-ok?)
      (compiler-backend-cmp-mem-narrow-rejects-signed-literal-ok?)
      (compiler-backend-cmp-mem-narrow-rejects-ordered-ok?))
    (be_state.backend-and4
      (compiler-backend-cmp-mem-bounds-fold-shape-ok?)
      (compiler-backend-cmp-mem-bounds-cast-fold-ok?)
      (compiler-backend-cmp-mem-bounds-second-use-refused-ok?)
      (compiler-backend-cmp-mem-wide-rhs-fold-ok?))
    (be_state.backend-and4
      (compiler-backend-cmp-mem-staged-base-fold-ok?)
      (compiler-backend-cmp-mem-staged-index-fold-ok?)
      (compiler-backend-cmp-mem-staged-both-refused-ok?)
      (compiler-backend-cmp-mem-staged-second-use-refused-ok?))
    (compiler-backend-cmp-mem-spilled-rhs-fold-ok?)
    (compiler-backend-cmp-mem-narrow-phi-copy-fold-ok?)
    (be_state.backend-and4
      (compiler-backend-cmp-mem-direct-char-fold-ok?)
      (compiler-backend-cmp-mem-direct-ordered-fold-ok?)
      (compiler-backend-cmp-mem-direct-register-fold-ok?)
      (compiler-backend-cmp-mem-direct-refusals-ok?))
    (compiler-backend-gep-load-alu-commuted-shapes-ok?)
    (compiler-backend-cmp-mem-store-between-refused-ok?)
    (compiler-backend-cmp-mem-flags-between-refused-ok?)
    (compiler-backend-cmp-mem-global-fold-shapes-ok?)))

;; GAP8: three-operand constant multiply strength reduction shapes.
(define (compiler-backend-mul-pow2-test-asm [factor : i64] [dst-reg : i64]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-backend-test-instr-seq-prepend
      (BinOp 1 (Mul) (Var 0) (I64 factor) (I64))
      (irt.instrs "%2 = mov %1 : i64"))
    (regalloc.compiler-reg-assignments-prepend
      (& (regalloc.CompilerRegAssignment 0 (Register cabi.compiler-reg-id-r12)))
      (regalloc.compiler-reg-assignments-prepend
        (& (regalloc.CompilerRegAssignment 1 (Register dst-reg)))
        (regalloc.compiler-reg-assignment-table-empty)))
    3))

(define (compiler-backend-mul-pow2-lea-shape-ok?) : bool
  (asm-ok?
    (compiler-backend-mul-pow2-test-asm 8 cabi.compiler-reg-id-rcx)
    (has "    leaq (,%r12,8), %rcx\n")
    (lacks "imulq")))

(define (compiler-backend-mul-pow2-shl-shape-ok?) : bool
  (asm-ok?
    (compiler-backend-mul-pow2-test-asm 32 cabi.compiler-reg-id-r12)
    (has "    shlq $5, %r12\n")
    (lacks "imulq")))

(define (compiler-backend-mul-scale-add-shape-ok?
  [factor : i64]
  [dst-reg : i64]
  [expected : String]) : bool
  (asm-ok?
    (compiler-backend-mul-pow2-test-asm factor dst-reg)
    (has expected)
    (lacks "imulq")))

;; LEA selection across a sole-use pair: `%1` is read only by the next
;; instruction, so the pair is one `leaq` into `%2`'s home and `%1` is never
;; written. `tail` follows the pair.
(define (compiler-backend-lea-pair-test-asm
  [first : ir.CompilerIrInstr]
  [second : ir.CompilerIrInstr]
  [tail : ir.CompilerIrInstrSeq]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-backend-test-instr-seq-prepend
      first
      (compiler-backend-test-instr-seq-prepend second tail))
    (regalloc.compiler-reg-assignments-prepend
      (& (regalloc.CompilerRegAssignment 0 (Register cabi.compiler-reg-id-r12)))
      (regalloc.compiler-reg-assignments-prepend
        (&
          (regalloc.CompilerRegAssignment 1 (Register cabi.compiler-reg-id-rdx)))
        (regalloc.compiler-reg-assignments-prepend
          (&
            (regalloc.CompilerRegAssignment
              2
              (Register cabi.compiler-reg-id-rcx)))
          (regalloc.compiler-reg-assignments-prepend
            (&
              (regalloc.CompilerRegAssignment
                4
                (Register cabi.compiler-reg-id-rbx)))
            (regalloc.compiler-reg-assignment-table-empty)))))
    6))

(define (compiler-backend-lea-pair-shapes-ok?) : bool
  (and
    ;; x*3 + 2: the product and the displacement in one SIB form.
    (asm-ok?
      (compiler-backend-lea-pair-test-asm
        (BinOp 1 (Mul) (Var 0) (I64 3) (I64))
        (BinOp 2 (Add) (Var 1) (I64 2) (I64))
        (irt.instrs "%3 = mov %2 : i64"))
      (has "    leaq 2(%r12,%r12,2), %rcx\n")
      (lacks "addq" "%rdx"))
    ;; y + (x - 48): the immediate add's index plus the other operand.
    (asm-ok?
      (compiler-backend-lea-pair-test-asm
        (BinOp 1 (Sub) (Var 0) (I64 48) (I64))
        (BinOp 2 (Add) (Var 4) (Var 1) (I64))
        (irt.instrs "%3 = mov %2 : i64"))
      (has "    leaq -48(%rbx,%r12), %rcx\n")
      (lacks "addq" "%rdx"))
    ;; y + x*4: a 2/4/8 product leaves the base slot free.
    (asm-ok?
      (compiler-backend-lea-pair-test-asm
        (BinOp 1 (Mul) (Var 0) (I64 4) (I64))
        (BinOp 2 (Add) (Var 1) (Var 4) (I64))
        (irt.instrs "%3 = mov %2 : i64"))
      (has "    leaq (%rbx,%r12,4), %rcx\n")
      (lacks "%rdx"))
    ;; The next instruction compares the sum: its flags are read after the
    ;; add (the `testq` drop), so the pair stays two instructions.
    (asm-ok?
      (compiler-backend-lea-pair-test-asm
        (BinOp 1 (Mul) (Var 0) (I64 3) (I64))
        (BinOp 2 (Add) (Var 1) (I64 2) (I64))
        (irt.instrs
          "%5 = eq %2, 0 : i64
                     %3 = mov %5 : bool"))
      (has "%rdx")
      (lacks "leaq 2(%r12"))
    ;; x*3 + y: a 3/5/9 product fills both SIB roles, so nothing fuses.
    (asm-ok?
      (compiler-backend-lea-pair-test-asm
        (BinOp 1 (Mul) (Var 0) (I64 3) (I64))
        (BinOp 2 (Add) (Var 1) (Var 4) (I64))
        (irt.instrs "%3 = mov %2 : i64"))
      (has "    leaq (%r12,%r12,2), %rdx\n"))
    ;; y + x*8 with `y` a forwarded addr-of: its allocator home never receives
    ;; the address, so the pair stays two instructions and the add reads the
    ;; materialized frame address.
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs
          "%5 = addr_of %3
           %1 = mul %0, 8 : i64
           %2 = add %1, %5 : i64
           %4 = mov %2 : i64")
        (reg-homes "%0=%r12 %1=%rdx %2=%rcx %5=%rbx")
        6)
      (has "(%rbp), ")
      (lacks "(%rbx,%r12,8)" "%rbx"))))

(define (compiler-backend-mul-scale-add-shapes-ok?) : bool
  (and
    (compiler-backend-mul-scale-add-shape-ok?
      3
      cabi.compiler-reg-id-rcx
      "    leaq (%r12,%r12,2), %rcx\n")
    (compiler-backend-mul-scale-add-shape-ok?
      5
      cabi.compiler-reg-id-rcx
      "    leaq (%r12,%r12,4), %rcx\n")
    (compiler-backend-mul-scale-add-shape-ok?
      9
      cabi.compiler-reg-id-rcx
      "    leaq (%r12,%r12,8), %rcx\n")
    (compiler-backend-mul-scale-add-shape-ok?
      5
      cabi.compiler-reg-id-r12
      "    leaq (%r12,%r12,4), %r12\n")
    (string.eq
      (be_scalar.compiler-backend-mul-immediate-direct-asm
        "%rbp"
        "%rcx"
        "$3"
        (I64 3)
        false)
      "    imulq $3, %rbp, %rcx\n")
    (string.eq
      (be_scalar.compiler-backend-mul-immediate-direct-asm
        "%rbp"
        "%rbp"
        "$9"
        (I64 9)
        false)
      "    imulq $9, %rbp, %rbp\n")))

(define (compiler-backend-mul-non-pow2-imul-shape-ok?) : bool
  (asm-ok?
    (compiler-backend-mul-pow2-test-asm 24 cabi.compiler-reg-id-rcx)
    (has "    imulq $24, %r12, %rcx\n")))

(define (compiler-backend-full-syscall-instr) : ir.CompilerIrInstr
  (irt.instr "%0 = syscall(231, 1, 2, 3, 4, 5, 6)"))

(define (compiler-backend-full-syscall-registers-ok?) : bool
  (let
    [instr : ir.CompilerIrInstr (compiler-backend-full-syscall-instr)]
    (and
      (be_state.backend-and8
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    movl $231, %eax\n")
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    movl $1, %edi\n")
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    movl $2, %esi\n")
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    movl $3, %edx\n")
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    movl $4, %r10d\n")
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    movl $5, %r8d\n")
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    movl $6, %r9d\n")
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    syscall\n"))
      (not
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    pushq %rax\n"))
      (not (compiler-backend-instr-contains? instr "    popq ")))))

(define (compiler-backend-entry-load-register-homes-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%r13 %2=%r14")]
    [instrs : ir.CompilerIrInstrSeq
      (irt.instrs
        "%0 = entry_argc
         %1 = entry_argv
         %2 = entry_envp")]
    (match (compiler-backend-emit-test-instrs instrs assignments 3)
      [(Ok asm)
        (and
          (be_state.backend-and4
            (asm-has? asm "    movq .L_tl_argc(%rip), %r12\n")
            (asm-has? asm "    movq .L_tl_argv(%rip), %r13\n")
            (asm-has? asm "    movq .L_tl_envp(%rip), %r14\n")
            (asm-lacks? asm "    movq .L_tl_argc(%rip), %rax\n"))
          (be_state.backend-and4
            (asm-lacks? asm "    movq .L_tl_argv(%rip), %rax\n")
            (asm-lacks? asm "    movq .L_tl_envp(%rip), %rax\n")
            (asm-lacks? asm "    movq %rax, %r12\n")
            (asm-lacks? asm "    movq %rax, %r13\n"))
          (asm-lacks? asm "    movq %rax, %r14\n"))]
      [(Err _) false])))

(define (compiler-backend-entry-load-fallbacks-ok?) : bool
  (let
    [spill-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=spill:-16")]
    [pair-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12/%r13")]
    [r11-occupied-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=spill:-16 %1=%r11")]
    [no-location-ok? : bool
      (asm-ok?
        (compiler-backend-emit-test-instrs
          (irt.instrs "%0 = entry_argc")
          (regalloc.compiler-reg-assignment-table-empty)
          1)
        (has "    movq .L_tl_argc(%rip), %r11\n" "    movq %r11, -8(%rbp)\n")
        (lacks "    movq .L_tl_argc(%rip), %rax\n"))]
    [spill-ok? : bool
      (asm-ok?
        (compiler-backend-emit-test-instrs
          (irt.instrs "%0 = entry_argv")
          spill-assignments
          1)
        (has "    movq .L_tl_argv(%rip), %r11\n" "    movq %r11, -16(%rbp)\n")
        (lacks "    movq .L_tl_argv(%rip), %rax\n"))]
    [pair-ok? : bool
      (asm-ok?
        (compiler-backend-emit-test-instrs
          (irt.instrs "%0 = entry_envp")
          pair-assignments
          1)
        (has "    movq .L_tl_envp(%rip), %r11\n" "    movq %r11, %r12\n")
        (lacks
          "    movq .L_tl_envp(%rip), %r12\n"
          "    movq .L_tl_envp(%rip), %rax\n"))]
    [r11-occupied-ok? : bool
      (asm-ok?
        (compiler-backend-emit-test-instrs
          (irt.instrs "%0 = entry_argc
             return %1")
          r11-occupied-assignments
          2)
        (has "    movq .L_tl_argc(%rip), %r9\n" "    movq %r9, -16(%rbp)\n")
        (lacks
          "    movq .L_tl_argc(%rip), %r11\n"
          "    movq .L_tl_argc(%rip), %rax\n"))]
    (and no-location-ok? spill-ok? pair-ok? r11-occupied-ok?)))

(define (compiler-backend-cpuid-eax-direct-ok?) : bool
  (let
    [instr : ir.CompilerIrInstr (irt.instr "%0 = cpuid 7, 0 word 0")]
    (be_state.backend-and8
      (compiler-backend-instr-contains?
        (owned_view.compiler-owned-shared-view instr)
        "    xorl %ecx, %ecx\n")
      (compiler-backend-instr-contains?
        (owned_view.compiler-owned-shared-view instr)
        "    movl $7, %eax\n")
      ;; cpuid clobbers %rbx; the campaign preserves the caller's %rbx in a
      ;; modeled free reg instead of pushq/popq %rbx (the no-stack-staging goal).
      (compiler-backend-instr-contains?
        (owned_view.compiler-owned-shared-view instr)
        "    movq %rbx, %r8\n")
      (compiler-backend-instr-contains?
        (owned_view.compiler-owned-shared-view instr)
        "    cpuid\n")
      (compiler-backend-instr-contains?
        (owned_view.compiler-owned-shared-view instr)
        "    movq %r8, %rbx\n")
      (not
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    movl %eax, %eax\n"))
      (not
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    movl %r11d, %ecx\n"))
      (not (compiler-backend-instr-contains? instr "%r11")))))

(define (compiler-backend-cpuid-direct-subleaf-ok?) : bool
  (let
    [instr : ir.CompilerIrInstr (irt.instr "%0 = cpuid 7, 3 word 0")]
    (be_state.backend-and4
      (compiler-backend-instr-contains?
        (owned_view.compiler-owned-shared-view instr)
        "    movl $3, %ecx\n")
      (compiler-backend-instr-contains?
        (owned_view.compiler-owned-shared-view instr)
        "    movl $7, %eax\n")
      (not
        (compiler-backend-instr-contains?
          (owned_view.compiler-owned-shared-view instr)
          "    movl %r11d, %ecx\n"))
      (not (compiler-backend-instr-contains? instr "%r11")))))

(define (compiler-backend-xgetbv-zero-index-ok?) : bool
  (let
    [instr : ir.CompilerIrInstr (Xgetbv 0 (I64 0))]
    (be_state.backend-and4
      (compiler-backend-instr-contains?
        (owned_view.compiler-owned-shared-view instr)
        "    xorl %ecx, %ecx\n")
      (compiler-backend-instr-contains?
        (owned_view.compiler-owned-shared-view instr)
        "    xgetbv\n")
      (compiler-backend-instr-contains? instr "    orq %rdx, %rax\n")
      true)))

;; #7927: the cpuid operand registers are allocator-pooled. A leaf homed in
;; %rcx -- the first Win64 argument register, so every non-inlined wrapper --
;; must reach %rax BEFORE the subleaf is moved into %rcx; a subleaf-first pair
;; of independent loads would run such a cpuid with the subleaf as its leaf. A
;; conflict-free pair keeps the subleaf-first order.
(define (compiler-backend-cpuid-operand-asm
  [leaf-home : i64]
  [subleaf-home : i64]) : String
  (compiler-backend-cpuid-operand-asm-for
    leaf-home
    subleaf-home
    (Var 0)
    (Var 1)))

(define (compiler-backend-cpuid-operand-asm-for
  [leaf-home : i64]
  [subleaf-home : i64]
  [leaf : ir.CompilerIrValue]
  [subleaf : ir.CompilerIrValue]) : String
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (regalloc.compiler-reg-assignments-prepend
        (& (regalloc.CompilerRegAssignment 0 (Register leaf-home)))
        (regalloc.compiler-reg-assignments-prepend
          (& (regalloc.CompilerRegAssignment 1 (Register subleaf-home)))
          (reg-homes "%2=%r12")))]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (match (be_calls.compiler-backend-emit-cpuid
      assignments
      2
      leaf
      subleaf
      1
      backend-state)
      [(Ok asm) asm]
      [(Err _) ""])))

(define (compiler-backend-cpuid-operand-moves-ok?) : bool
  (let
    [win64-wrapper : String
      (compiler-backend-cpuid-operand-asm
        cabi.compiler-reg-id-rcx
        cabi.compiler-reg-id-rdx)]
    [sysv-wrapper : String
      (compiler-backend-cpuid-operand-asm
        cabi.compiler-reg-id-rdi
        cabi.compiler-reg-id-rsi)]
    (and
      (asm-has?
        win64-wrapper
        "    movq %rcx, %rax\n    movq %rdx, %rcx\n    movq %rbx, %r8\n    cpuid\n")
      (asm-lacks? win64-wrapper "    movq %rdx, %rcx\n    movq %rcx, %rax\n")
      (asm-has?
        sysv-wrapper
        "    movq %rsi, %rcx\n    movq %rdi, %rax\n    movq %rbx, %r8\n    cpuid\n")
      (compiler-backend-cpuid-operand-boundaries-ok?))))

;; The remaining operand-home shapes of #7927. A leaf in %rcx with the subleaf in
;; %rax is a true cycle: it must go through a scratch register that is neither
;; operand register. Operands
;; already in place emit no move at all. A subleaf homed in %rax has to leave
;; before the leaf lands there. The shape every `stdlib.cpu` wrapper has on
;; Win64 -- a literal subleaf with the leaf in %rcx -- must read the leaf before
;; the literal overwrites it.
(define (compiler-backend-cpuid-operand-boundaries-ok?) : bool
  (let
    [swap : String
      (compiler-backend-cpuid-operand-asm
        cabi.compiler-reg-id-rcx
        cabi.compiler-reg-id-rax)]
    [in-place : String
      (compiler-backend-cpuid-operand-asm
        cabi.compiler-reg-id-rax
        cabi.compiler-reg-id-rcx)]
    [subleaf-in-rax : String
      (compiler-backend-cpuid-operand-asm
        cabi.compiler-reg-id-rdx
        cabi.compiler-reg-id-rax)]
    [literal-subleaf : String
      (compiler-backend-cpuid-operand-asm-for
        cabi.compiler-reg-id-rcx
        cabi.compiler-reg-id-rdx
        (Var 0)
        (I64 0))]
    [literal-leaf : String
      (compiler-backend-cpuid-operand-asm-for
        cabi.compiler-reg-id-rdx
        cabi.compiler-reg-id-rax
        (I64 7)
        (Var 1))]
    (and
      (asm-has?
        swap
        "    movq %rax, %r9\n    movq %rcx, %rax\n    movq %r9, %rcx\n    movq %rbx, %r8\n    cpuid\n")
      (asm-lacks? in-place ", %rcx\n" "    movq %rcx, %rax\n")
      (asm-has? in-place "    movq %rbx, %r8\n    cpuid\n")
      (asm-has?
        subleaf-in-rax
        "    movq %rax, %rcx\n    movq %rdx, %rax\n    movq %rbx, %r8\n    cpuid\n")
      (asm-has?
        literal-subleaf
        "    movq %rcx, %rax\n    xorl %ecx, %ecx\n    movq %rbx, %r8\n    cpuid\n")
      (asm-has?
        literal-leaf
        "    movq %rax, %rcx\n    movl $7, %eax\n    movq %rbx, %r8\n    cpuid\n"))))

(define (compiler-backend-low-level-instr-ok?) : bool
  (and
    (be_state.backend-and8
      (compiler-backend-instr-contains? (EntryArgc 0) ".L_tl_argc(%rip)")
      (compiler-backend-instr-contains? (EntryArgv 0) ".L_tl_argv(%rip)")
      (compiler-backend-instr-contains? (EntryEnvp 0) ".L_tl_envp(%rip)")
      (compiler-backend-cpuid-eax-direct-ok?)
      (compiler-backend-instr-contains?
        (irt.instr "%0 = cpuid 7, 0 word 1")
        "    movl %ebx, %eax\n")
      (compiler-backend-instr-contains?
        (irt.instr "%0 = cpuid 7, 0 word 2")
        "    movl %ecx, %eax\n")
      (compiler-backend-instr-contains?
        (irt.instr "%0 = cpuid 7, 0 word 3")
        "    movl %edx, %eax\n")
      (compiler-backend-xgetbv-zero-index-ok?))
    (compiler-backend-cpuid-direct-subleaf-ok?)
    (compiler-backend-cpuid-operand-moves-ok?)
    (be_state.backend-and8
      ;; A one-operand syscall loads the number into %rax and issues `syscall`.
      (compiler-backend-instr-contains?
        (irt.instr "%0 = syscall(231)")
        "    movl $231, %eax\n")
      (compiler-backend-instr-contains?
        (irt.instr "%0 = syscall(231)")
        "    syscall\n")
      (not
        (compiler-backend-instr-contains?
          (irt.instr "%0 = syscall(231)")
          "    pushq %rax\n"))
      (not
        (compiler-backend-instr-contains?
          (irt.instr "%0 = syscall(231)")
          "    popq "))
      ;; A two-operand syscall additionally loads argument 0 into %rdi.
      (compiler-backend-instr-contains?
        (irt.instr "%0 = syscall(231, 42)")
        "    movl $42, %edi\n")
      (compiler-backend-instr-contains?
        (irt.instr "%0 = syscall(231, 42)")
        "    movl $231, %eax\n")
      (compiler-backend-instr-contains?
        (irt.instr "%0 = syscall(231, 0)")
        "    xorl %edi, %edi\n")
      (compiler-backend-full-syscall-registers-ok?))
    (compiler-backend-entry-load-register-homes-ok?)
    (compiler-backend-entry-load-fallbacks-ok?)))

(define (compiler-backend-numeric-cast-shape-ok?) : bool
  (be_state.backend-and8
    (compiler-backend-instr-contains?
      (irt.instr "%6 = cast %5 : i64 to f64")
      "    cvtsi2sdq %r8, %xmm2\n")
    (compiler-backend-instr-contains?
      (irt.instr "%6 = cast %5 : i64 to f32")
      "    cvtsi2ssq %r8, %xmm2\n")
    (compiler-backend-instr-contains?
      (irt.instr "%6 = cast %5 : u8 to f64")
      "    cvtsi2sdq %r8, %xmm2\n")
    (compiler-backend-instr-contains?
      (irt.instr "%6 = cast %5 : u64 to f64")
      "    js .L_tl_test_cast_u64_float_entry_v6_high\n")
    (compiler-backend-instr-contains?
      (irt.instr "%6 = cast %5 : u64 to f32")
      "    addss %xmm2, %xmm2\n")
    (compiler-backend-instr-contains?
      (irt.instr "%6 = cast %5 : f64 to i64")
      "    cvttsd2siq %xmm2, %r8\n")
    (compiler-backend-instr-contains?
      (irt.instr "%6 = cast %5 : f64 to f32")
      "    cvtsd2ss %xmm2, %xmm2\n")
    (compiler-backend-instr-contains?
      (irt.instr "%6 = cast %5 : f32 to f64")
      "    cvtss2sd %xmm2, %xmm2\n")))

(define (compiler-backend-direct-float-precision-cast-asm
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]) : be_state.ResultCompilerBackend
  (be_scalar.compiler-backend-emit-cast
    (ast.ast-node-pool-reader-type-segment-bases)
    "test_cast"
    (ir.compiler-ir-label "entry")
    (reg-homes "%0=%xmm2 %1=%xmm3")
    1
    (Var 0)
    from-ty
    to-ty
    (compiler-backend-program-index-build
      (ast.ast-node-pool-reader-type-segment-bases)
      (ir.compiler-ir-function-seq-empty)
      (ir.compiler-ir-extern-seq-empty))
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active))))

(define (compiler-backend-direct-float-precision-cast-home-ok?) : bool
  (match (compiler-backend-direct-float-precision-cast-asm (F64) (F32))
    [(Ok narrow-asm)
      (match (compiler-backend-direct-float-precision-cast-asm (F32) (F64))
        [(Ok widen-asm)
          (and
            (asm-has?
              narrow-asm
              "    movsd %xmm2, %xmm3\n"
              "    cvtsd2ss %xmm3, %xmm3\n")
            (asm-has?
              widen-asm
              "    movss %xmm2, %xmm3\n"
              "    cvtss2sd %xmm3, %xmm3\n")
            (asm-lacks? narrow-asm "%xmm0")
            (asm-lacks? widen-asm "%xmm0"))]
        [(Err _) false])]
    [(Err _) false]))

