        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    testq %r8, %r8\n    jne 1f\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_div_abort_at\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpq %r10, %rax\n    jne 1f\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpq %r9, %r8\n    jne 1f\n")
          (compiler_backend.compiler-backend-string-contains? asm "    cqto\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    idivq %r8\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rdx, %rax\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad 46\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_div_abort\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".globl tl_div_abort\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-constant-divisor-strength-source) : String
  "(define (sdiv3 [a : i64]) : i64 (/ a 3))
(define (smod-prime [a : i64]) : i64 (% a 1000000007))
(define (udiv3 [a : u64]) : u64 (/ a (cast 3 : u64)))
(define (umod8 [a : u64]) : u64 (% a (cast 8 : u64)))
(define (udiv-high [a : u64]) : u64 (/ a (cast -2 : u64)))
(define (main) : i64
  (+ (sdiv3 -10)
    (+ (smod-prime -10)
      (+ (cast (udiv3 (cast 42 : u64)) : i64)
        (+ (cast (umod8 (cast 42 : u64)) : i64)
          (cast (udiv-high (cast -1 : u64)) : i64))))))")

(define (compiler-backend-constant-divisor-strength-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-constant-divisor-strength-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and8
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movabsq $6148914691236517206, %r8\n    imulq %r8\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movabsq $-8543223828751151131, %r8\n    imulq %r8\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movabsq $-6148914691236517205, %r8\n    mulq %r8\n")
        ;; M-F folds the power-of-2 modulo mask into an immediate `andq`
        ;; (was `movabsq $7, %r8; andq %r8, %rax`).
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    andq $7, %rax\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    idivq %r8\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    divq %r8\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_div_abort\n"))
        (and
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".extern tl_div_abort\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl tl_div_abort\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker)))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Signed i64 magic div/mod must keep the pre-shift quotient sign in %rax and
;; retain the dividend in one non-fixed SRC register. This exact remainder
;; expansion is the nine-instruction Clang shape used by the VM hot arm.
(define (compiler-backend-signed-constant-divisor-clang-shape-ok?) : bool
  (let
    [magic : i64 -8543223828751151131]
    [reg-asm : String
      (compiler_backend.compiler-backend-signed-magic-divmod-src-asm
        1000000007
        false
        true
        "%r8"
        "%r10"
        "%r10"
        (CompilerBackendConstHoistHomeReg
          compiler_abi.compiler-reg-id-r8
          magic
          false))]
    [frame-asm : String
      (compiler_backend.compiler-backend-signed-magic-divmod-src-asm
        1000000007
        false
        true
        "%r8"
        "%r10"
        "%r10"
        (CompilerBackendConstHoistHomeFrame "-40(%rbp)" magic))]
    (and
      (string.eq
        reg-asm
        "    movq %r10, %rax\n    imulq %r8\n    addq %r10, %rdx\n    movq %rdx, %rax\n    shrq $63, %rax\n    sarq $29, %rdx\n    addq %rax, %rdx\n    imulq $1000000007, %rdx, %rax\n    subq %rax, %r10\n")
      (string.eq
        frame-asm
        "    movq %r10, %rax\n    imulq -40(%rbp)\n    addq %r10, %rdx\n    movq %rdx, %rax\n    shrq $63, %rax\n    sarq $29, %rdx\n    addq %rax, %rdx\n    imulq $1000000007, %rdx, %rax\n    subq %rax, %r10\n")
      (not
        (compiler_backend.compiler-backend-string-contains? reg-asm "sarq $63"))
      (not
        (compiler_backend.compiler-backend-string-contains?
          reg-asm
          "subq %r9, %rdx")))))

;; Exercise the adjacent producer/result forwarding at the IR emission layer,
;; where fixed allocator homes can make both otherwise-redundant copies
;; deterministic.  The local context wrapper keeps the scratch/liveness and
;; Gep-fold globals hermetic: this predicate is also run after tests that seed
;; those tables deliberately.
(define (compiler-backend-divmod-polish-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r12))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r13))
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          2
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-rdx))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            3
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-rax))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              4
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-rdi))
            (compiler_regalloc.compiler-reg-assignment-cons
              (compiler_regalloc.CompilerRegAssignment
                5
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-rsi))
              (compiler_regalloc.compiler-reg-assignment-cons
                (compiler_regalloc.CompilerRegAssignment
                  6
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-r10))
                (compiler_regalloc.compiler-reg-assignment-cons
                  (compiler_regalloc.CompilerRegAssignment
                    7
                    (compiler_regalloc.CompilerRegLocation.Register
                      compiler_abi.compiler-reg-id-r14))
                  compiler_regalloc.CompilerRegAssignmentList.Nil)))))))))

(define (compiler-backend-divmod-polish-instrs
  [multi-use-result : bool]
  [multi-use-producer : bool]) : compiler_ir_types.CompilerIrInstrList
  (let
    [after-store : compiler_ir_types.CompilerIrInstrList
      (if multi-use-result
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            7
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ast_types.AstType.I64))
          compiler_ir_types.CompilerIrInstrList.Nil)
        (if multi-use-producer
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Mov
              7
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ast_types.AstType.I64))
            compiler_ir_types.CompilerIrInstrList.Nil)
          compiler_ir_types.CompilerIrInstrList.Nil))]
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.BinOp
        2
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.BinOp
          3
          (compiler_ir_types.CompilerIrBinOp.SafeMod)
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ir_types.CompilerIrValue.I64 1000000007)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Gep
            6
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.StorePtr
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64))
            after-store))))))

(define (compiler-backend-divmod-polish-asm
  [multi-use-result : bool]
  [multi-use-producer : bool]) : compiler_backend.ResultCompilerBackend
  (let
    [prev-starts : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-starts)]
    [prev-ends : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-ends)]
    [prev-assignment-index : compiler_regalloc.CompilerRegAssignmentIndex
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-assignment-index)]
    [prev-plan-mask : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-plan-reg-mask)]
    [prev-occupied-masks : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-occupied-masks)]
    [prev-vars : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-vars)]
    [prev-post-base : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-instr-post-base)]
    [prev-current-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-current-count)]
    [prev-win64 : bool (compiler_backend.compiler-backend-current-fn-win64?)]
    [prev-gep-ready : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-ready)]
    [prev-gep-disp : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-disp-table)]
    [prev-gep-kind : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-kind-table)]
    [prev-gep-scale : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-scale-table)]
    [prev-gep-cursor : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-cursor)]
    [prev-gep-drift : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-drift)]
    [prev0-var : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-home-override0-var)]
    [prev0-reg : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-home-override0-reg)]
    [prev1-var : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-home-override1-var)]
    [prev1-reg : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-home-override1-reg)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-divmod-polish-assignments)]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler-backend-divmod-polish-instrs
        multi-use-result
        multi-use-producer)]
    [count : i64 (compiler_ir_types.compiler-ir-instr-list-count instrs)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "entry")
          instrs)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [_ctx : unit
      (begin
        (compiler_backend.compiler-backend-set-current-fn-linux!)
        (compiler_backend.compiler-backend-gep-fold-disable!)
        (compiler_backend.compiler-backend-emit-home-overrides-disable!)
        (compiler-backend-test-scavenge-install-ctx!
          "divmod_polish"
          compiler_ir_types.CompilerIrParamList.Nil
          (compiler_ast_types.AstType.I64)
          8
          blocks
          assignments)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          count))]
    [result : compiler_backend.ResultCompilerBackend
      (compiler-backend-emit-test-instrs instrs assignments 8)]
    [_restore : unit
      (begin
        (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
          prev-starts
          prev-ends
          prev-assignment-index
          prev-plan-mask
          prev-occupied-masks
          prev-vars)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          prev-post-base)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          prev-current-count)
        (if prev-win64
          (compiler_backend.compiler-backend-set-current-fn-win64!)
          (compiler_backend.compiler-backend-set-current-fn-linux!))
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-ready!
          prev-gep-ready)
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-disp-table!
          prev-gep-disp)
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-kind-table!
          prev-gep-kind)
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-scale-table!
          prev-gep-scale)
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-cursor!
          prev-gep-cursor)
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-drift!
          prev-gep-drift)
        (compiler_backend.compiler-backend-divmod-overrides-install!
          prev0-var
          prev0-reg
          prev1-var
          prev1-reg))]
    result))

(define (compiler-backend-divmod-producer-result-forwarding-ok?) : bool
  (match (compiler-backend-divmod-polish-asm false false)
    [(compiler_backend.ResultCompilerBackend.Ok forwarded)
      (match (compiler-backend-divmod-polish-asm true false)
        [(compiler_backend.ResultCompilerBackend.Ok multi-result)
          (match (compiler-backend-divmod-polish-asm false true)
            [(compiler_backend.ResultCompilerBackend.Ok multi-producer)
              (and
                ;; Positive: producer lands in SRC and the single-use result is
                ;; stored from SRC after the exact nine-instruction expansion.
                (compiler_backend.compiler-backend-string-contains?
                  forwarded
                  "    leaq (%r12,%r13), %r9\n    movq %r9, %rax\n")
                (compiler_backend.compiler-backend-string-contains?
                  forwarded
                  "    subq %rax, %r9\n    movq %r9, (%rdi,%rsi,8)\n")
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    forwarded
                    "    movq %rdx, %r9\n"))
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    forwarded
                    "    movq %r9, %rax\n    movq %rax, (%rdi,%rsi,8)\n"))
                ;; Negative: a multi-use divmod result returns to its canonical
                ;; %rax home before both consumers read it.
                (compiler_backend.compiler-backend-string-contains?
                  multi-result
                  "    leaq (%r12,%r13), %r9\n    movq %r9, %rax\n")
                (compiler_backend.compiler-backend-string-contains?
                  multi-result
                  "    subq %rax, %r9\n    movq %r9, %rax\n")
                (compiler_backend.compiler-backend-string-contains?
                  multi-result
                  "    movq %rax, (%rdi,%rsi,8)\n")
                ;; Negative: another use of the producer keeps its fixed %rdx
                ;; home, so the divmod performs the ordinary SRC copy.
                (compiler_backend.compiler-backend-string-contains?
                  multi-producer
                  "    leaq (%r12,%r13), %rdx\n    movq %rdx, %r9\n")
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    multi-producer
                    "    leaq (%r12,%r13), %r9\n")))]
            [(compiler_backend.ResultCompilerBackend.Err _) false])]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; C22 regression: Gep/Load pairs feed an ALU, then constant modulo, then a
;; same-array store.  The explicit homes reproduce the saturated Win64 choice:
;; %r9 carries the magic and divmod SRC must emergency-borrow the live array base
;; in %rcx.  The direct store must reject that address/clobber intersection so
;; %rcx is restored before the ordinary Gep+StorePtr reads it.
(define (compiler-backend-c22-divmod-store-collision-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-rcx))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r8))
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          4
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            7
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-rdx))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              8
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-rax))
            (compiler_regalloc.compiler-reg-assignment-cons
              (compiler_regalloc.CompilerRegAssignment
                10
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-r10))
              (compiler_regalloc.compiler-reg-assignment-cons
                (compiler_regalloc.CompilerRegAssignment
                  11
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-r11))
                compiler_regalloc.CompilerRegAssignmentList.Nil))))))))

(define (compiler-backend-c22-divmod-store-collision-instrs) : compiler_ir_types.CompilerIrInstrList
  (compiler_ir_types.compiler-ir-instr-cons
    (compiler_ir_types.CompilerIrInstr.Gep
      2
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Load
        3
        (compiler_ir_types.CompilerIrValue.Var 2)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Gep
          5
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 4)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Load
            6
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.BinOp
              7
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.BinOp
                8
                (compiler_ir_types.CompilerIrBinOp.SafeMod)
                (compiler_ir_types.CompilerIrValue.Var 7)
                (compiler_ir_types.CompilerIrValue.I64 1000000007)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Gep
                  9
                  (compiler_ir_types.CompilerIrValue.Var 0)
                  (compiler_ir_types.CompilerIrValue.Var 4)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.StorePtr
                    (compiler_ir_types.CompilerIrValue.Var 9)
                    (compiler_ir_types.CompilerIrValue.Var 8)
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.compiler-ir-instr-cons
                    (compiler_ir_types.CompilerIrInstr.Mov
                      12
                      (compiler_ir_types.CompilerIrValue.Var 1)
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.compiler-ir-instr-cons
                      (compiler_ir_types.CompilerIrInstr.Mov
                        13
                        (compiler_ir_types.CompilerIrValue.Var 10)
                        (compiler_ast_types.AstType.I64))
                      (compiler_ir_types.compiler-ir-instr-cons
                        (compiler_ir_types.CompilerIrInstr.Mov
                          14
                          (compiler_ir_types.CompilerIrValue.Var 11)
                          (compiler_ast_types.AstType.I64))
                        compiler_ir_types.CompilerIrInstrList.Nil))))))))))))

(define (compiler-backend-c22-divmod-store-collision-asm) : compiler_backend.ResultCompilerBackend
  (let
    [prev-starts : (Array i64)
