    [handle : i64 (io.file-open-status \"input.txt\" 0)]
    (+ handle (io.file-close-status handle))))")
    (lacks ".L_tl_file_open_status:\n" ".L_tl_file_close_status:\n")
    (has
      "    call tl_file_open_status\n"
