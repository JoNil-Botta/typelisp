        (compiler_backend.compiler-backend-string-contains?
          asm
          ".Lf0_entry_switch_default:\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    jmp .Lf0_join\n"))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; --- negative dense-switch case keys (#6570) ---------------------------------
;;
;; A dense switch is built from whatever integers its arms carry, so its lowest
;; case may be below zero; the emitted dispatch then subtracts a negative base.
;; The per-case edge blocks a phi target needs spell the case VALUE into their
;; label, and `-` is an operator in the assembler's expression grammar, not a
;; symbol character: `.Lf0_entry_switch_case_-1:` is not read as a label at all.
;; GNU as sees a line starting with `.` and reports `unknown pseudo-op`, which
;; is how this first surfaced -- as a stage2 assembly failure once the inliner
;; formed such a table in src/main.tl.
;;
;; Base -1 with cases -1, 0, and 1 puts every relevant spelling in one
;; emission: the negative key must appear as `m1`, zero as `0`, and the
;; same-magnitude positive key as `1` so the signed mapping stays injective.
(define (compiler-backend-switch-negative-case-program) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler_ir_types.compiler-ir-global-seq-empty)
    (compiler_ir_types.compiler-ir-function-cons
      (compiler_ir_types.CompilerIrFunction.Function
        (ci.intern "main")
        compiler_ir_types.CompilerIrParamList.Nil
        (compiler_ast_types.AstType.I64)
        2
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-block
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Switch
                (compiler_ir_types.CompilerIrValue.Var 0)
                (- 0 1)
                (compiler_ir_types.compiler-ir-switch-case-cons
                  (- 0 1)
                  (compiler_ir_types.compiler-ir-label "join")
                  (compiler_ir_types.compiler-ir-switch-case-cons
                    0
                    (compiler_ir_types.compiler-ir-label "join")
                    (compiler_ir_types.compiler-ir-switch-case-cons
                      1
                      (compiler_ir_types.compiler-ir-label "join")
                      compiler_ir_types.CompilerIrSwitchCaseList.Nil)))
                (compiler_ir_types.compiler-ir-label "join"))
              compiler_ir_types.CompilerIrInstrList.Nil))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.compiler-ir-block
              (compiler_ir_types.compiler-ir-label "join")
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Phi
                  1
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.I64 1)
                    (compiler_ir_types.compiler-ir-label "entry")
                    compiler_ir_types.CompilerIrPhiInputList.Nil)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.Var 1)))
                  compiler_ir_types.CompilerIrInstrList.Nil)))
            compiler_ir_types.CompilerIrBlockList.Nil)))
      compiler_ir_types.CompilerIrFunctionList.Nil)
    compiler_ir_types.CompilerIrExternList.Nil))

(define (compiler-backend-switch-negative-case-label-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-linux
    (compiler-backend-switch-negative-case-program))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          ".Lf0_entry_switch_table:\n")
        ;; The negative key spells with `m`, in the table and at the block.
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    .quad .Lf0_entry_switch_case_m1\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          ".Lf0_entry_switch_case_m1:\n")
        ;; A non-negative key is spelled exactly as it always was.
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    .quad .Lf0_entry_switch_case_0\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          ".Lf0_entry_switch_case_0:\n")
        ;; Equal-magnitude signed keys remain distinct.
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    .quad .Lf0_entry_switch_case_1\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          ".Lf0_entry_switch_case_1:\n")
        ;; No `-` reaches a symbol name anywhere in the emission.
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "switch_case_-"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    jmp .Lf0_join\n"))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-switch-object-image-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-object-image-linux
    (compiler-backend-switch-test-program)
    (compiler_ir_types.compiler-source-spans-empty))
    [(compiler_backend.ResultCompilerBackendObject.Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList image.sections]
        [symbols : cobj.CompilerObjectSymbolList image.symbols]
        [relocs : cobj.CompilerObjectRelocationList image.relocations]
        [table-label : String ".Lf0_entry_switch_table"]
        (and
          (elf.compiler-object-elf-image-supported? image)
          (coff.compiler-object-coff-image-supported? image)
          (cobj.compiler-object-symbol-list-contains?
            symbols
            table-label
            (cobj.CompilerObjectSymbolBinding.Local)
            (cobj.CompilerObjectSymbolKind.Data))
          (cobj.compiler-object-section-contains-label?
            sections
            (cobj.CompilerObjectSectionKind.Rodata)
            table-label)
          (cobj.compiler-object-section-contains-align?
            sections
            (cobj.CompilerObjectSectionKind.Rodata)
            8)
          (cobj.compiler-object-section-contains-label?
            sections
            (cobj.CompilerObjectSectionKind.Rodata)
            ".Lf0_entry_switch_table_entry_0")
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (cobj.CompilerObjectRelocationKind.RipAddress)
            table-label)
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (cobj.CompilerObjectRelocationKind.Branch)
            ".Lf0_other")
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (cobj.CompilerObjectRelocationKind.Abs64)
            ".Lf0_zero")
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (cobj.CompilerObjectRelocationKind.Abs64)
            ".Lf0_one")
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (cobj.CompilerObjectRelocationKind.Abs64)
            ".Lf0_two")
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler_backend.compiler-backend-object-cmp-imm32-rax-bytes 2))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler_backend.compiler-backend-object-switch-indirect-jump-bytes))))]
    [(compiler_backend.ResultCompilerBackendObject.Err diag) false]))

(define (compiler-backend-switch-base-object-image-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-object-image-linux
    (compiler-backend-switch-base-test-program)
    (compiler_ir_types.compiler-source-spans-empty))
    [(compiler_backend.ResultCompilerBackendObject.Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList image.sections]
        (and
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler_backend.compiler-backend-object-sub-imm32-rax-bytes 4))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler_backend.compiler-backend-object-cmp-imm32-rax-bytes 1))))]
    [(compiler_backend.ResultCompilerBackendObject.Err _) false]))

(define (compiler-backend-switch-object-shape-diagnostic-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-object-image-linux
    (compiler-backend-switch-bad-shape-program)
    (compiler_ir_types.compiler-source-spans-empty))
    [(compiler_backend.ResultCompilerBackendObject.Err diag)
      (string.eq
        (compiler_diagnostic.compiler-diagnostic-message (__tl-box-place diag))
        (compiler_backend.compiler-backend-switch-shape-message))]
    [(compiler_backend.ResultCompilerBackendObject.Ok _) false]))

(define (compiler-backend-switch-object-phi-diagnostic-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-object-image-linux
    (compiler-backend-switch-phi-program)
    (compiler_ir_types.compiler-source-spans-empty))
    [(compiler_backend.ResultCompilerBackendObject.Err diag)
      (string.eq
        (compiler_diagnostic.compiler-diagnostic-message (__tl-box-place diag))
        (compiler_backend.compiler-backend-switch-phi-target-message))]
    [(compiler_backend.ResultCompilerBackendObject.Ok _) false]))

(define (compiler-backend-instr-diagnostics-ok?) : bool
  (and
    (compiler-backend-instr-diagnostic-case-ok?
      (compiler_ir_types.CompilerIrInstr.Mov
        0
        (compiler_ir_types.CompilerIrValue.F64
          (compiler-backend-test-f64-bits "1.0"))
        (compiler_ast_types.AstType.I64))
      "backend: f64 values are not supported yet"
      21
      7)
    (compiler-backend-instr-diagnostic-case-ok?
      (compiler_ir_types.CompilerIrInstr.BinOp
        1
        (compiler_ir_types.CompilerIrBinOp.Mod)
        (compiler_ir_types.CompilerIrValue.F64
          (compiler-backend-test-f64-bits "1.0"))
        (compiler_ir_types.CompilerIrValue.F64
          (compiler-backend-test-f64-bits "2.0"))
        (compiler_ast_types.AstType.F64))
      "backend: unsupported float binary op"
      34
      9)
    ;; An unsupported f64 unary op is rejected. Neg and Sqrt have f64 lowering.
    (compiler-backend-instr-diagnostic-case-ok?
      (compiler_ir_types.CompilerIrInstr.UnOp
        2
        (compiler_ir_types.CompilerIrUnOp.Not)
        (compiler_ir_types.CompilerIrValue.F64
          (compiler-backend-test-f64-bits "1.0"))
        (compiler_ast_types.AstType.F64))
      "backend: unsupported f64 unary op"
      40
      11)
    (compiler-backend-switch-asm-ok?)
    (compiler-backend-total-switch-asm-ok?)
    (compiler-backend-forwarded-total-switch-asm-ok?)
    (compiler-backend-total-switch-pic-asm-ok?)
    (compiler-backend-total-switch-object-image-ok?)
    (compiler-backend-spoofed-total-switch-stays-checked?)
    (compiler-backend-total-switch-lowered-opt2-asm-ok?)
    (compiler-backend-switch-base-asm-ok?)
    (compiler-backend-switch-shape-diagnostic-ok?)
    (compiler-backend-switch-phi-edge-copy-ok?)
    (compiler-backend-switch-negative-case-label-ok?)
    (compiler-backend-switch-object-image-ok?)
    (compiler-backend-switch-base-object-image-ok?)
    (compiler-backend-switch-object-shape-diagnostic-ok?)
    (compiler-backend-switch-object-phi-diagnostic-ok?)
    (compiler-backend-instr-diagnostic-case-ok?
      (compiler_ir_types.ir-instr-vector-bin-op
        3
        (compiler_ir_types.CompilerIrBinOp.Mod)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        8
        (compiler_ast_types.AstType.I64))
      "backend: unsupported AVX-512 vector binary op"
      44
      13)))

(define (compiler-backend-avx2-map-source [elem : String]) : String
  (str_cat.str-cat
    "(define (fill [a : (Array "
    elem
    ")] [b : (Array "
    elem
    ")] [out : (Array "
    elem
    ")] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (+ (array-ref a i) (array-ref b i)))))"))

(define (compiler-backend-uniform-map-source [elem : String]) : String
  (str_cat.str-cat
    "(define (fill [a : (Array "
    elem
    ")] [b : (Array "
    elem
    ")] [out : (Array "
    elem
    ")] [n : i64] [r : "
    elem
    "]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (+ (+ (array-ref a i) (array-ref b i)) r))))"))

(define (compiler-backend-uniform-zip-source) : String
  "(define (fill [a : (Array i64)] [b : (Array i64)] [c : (Array i64)] [out : (Array i64)] [n : i64] [r : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (+ (+ (* (array-ref a i) (array-ref b i)) (array-ref c i)) r))))")

(define (compiler-backend-lane-id-rodata-source) : String
  "(define (fill [out : (Array i64)] [other : (Array i64)] [n : i64]) : unit
  (begin
    (foreach
      ([i : i64 0 n])
      (set! (array-ref out i) (program-index)))
    (foreach
      ([j : i64 0 n])
      (set! (array-ref other j) (program-index)))))")

(define (compiler-backend-lane-id-rodata-shape-ok?
  [lower-mode : compiler_lower.CompilerLowerMode]
  [backend-mode : compiler_backend.CompilerBackendMode]
  [label : String]
  [align : String]
  [load : String]) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    (compiler-backend-lane-id-rodata-source)
    lower-mode)
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        backend-mode
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.backend-and4
              (compiler_backend.compiler-backend-string-contains?
                asm
                (str_cat.str-cat "    .section .rodata\n" align label ":\n"))
              (=
                (compiler_backend.compiler-backend-string-count
                  asm
                  (str_cat.str-cat label ":\n"))
                1)
              (>=
                (compiler_backend.compiler-backend-string-count
                  asm
                  (str_cat.str-cat load " " label "(%rip), "))
                2)
              (not
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  (str_cat.str-cat label ":\n" load))))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "vector/mask IR emission is not implemented")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-lane-id-rodata-ok?) : bool
  (and
    (compiler-backend-lane-id-rodata-shape-ok?
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      (compiler_backend.compiler-backend-avx2-i64-lane-id-label)
      "    .balign 32\n"
      "    vmovdqa")
    (compiler-backend-lane-id-rodata-shape-ok?
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      (compiler_backend.compiler-backend-avx512-i64-lane-id-label)
      "    .balign 64\n"
      "    vmovdqa64")
    (match (compiler_lower.lower-compiler-source-with-mode
      (compiler-backend-lane-id-rodata-source)
      (compiler_lower.CompilerLowerMode.Avx2))
      [(compiler_lower.ResultCompilerLower.Ok program spans)
        (match (compiler_backend.compiler-backend-emit-program-target-with-mode
          program
          (compiler_backend.CompilerBackendTarget.Linux)
          (compiler_backend.CompilerBackendMode.Avx2)
          spans
          true)
          [(compiler_backend.ResultCompilerBackend.Ok asm)
            (let
              [body : String
                (compiler-backend-asm-function-body asm "_tl_fill")]
              [loop : String (compiler-backend-avx2-loop-body body)]
              (and
                (not (string.eq loop ""))
                (=
                  (compiler_backend.compiler-backend-string-count
                    loop
                    (compiler_backend.compiler-backend-avx2-i64-lane-id-label))
                  0)))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])]
      [(compiler_lower.ResultCompilerLower.Err _) false])))

(define (compiler-backend-avx2-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    (compiler-backend-avx2-map-source elem)
    (compiler_lower.CompilerLowerMode.Avx2))
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        (compiler_backend.CompilerBackendMode.Avx2)
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.backend-and4
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vzeroupper\n")
              (compiler_backend.compiler-backend-string-contains? asm move)
              (compiler_backend.compiler-backend-string-contains? asm op)
              (compiler_backend.compiler-backend-string-contains? asm "%ymm"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "vector/mask IR emission is not implemented")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-avx2-vector-map-ok?) : bool
  (and
    (compiler-backend-avx2-map-asm-contains? "i64" "    vmovdqu " "    vpaddq ")
    (compiler-backend-avx2-map-asm-contains? "i32" "    vmovdqu " "    vpaddd ")
    (compiler-backend-avx2-map-asm-contains? "i16" "    vmovdqu " "    vpaddw ")
    (compiler-backend-avx2-map-asm-contains? "u16" "    vmovdqu " "    vpaddw ")
    (compiler-backend-avx2-map-asm-contains? "f64" "    vmovupd " "    vaddpd ")
    (compiler-backend-avx2-map-asm-contains? "f32" "    vmovups " "    vaddps ")
    (compiler-backend-avx2-map-asm-contains? "i8" "    vmovdqu " "    vpaddb ")
    (compiler-backend-avx2-map-asm-contains? "u8" "    vmovdqu " "    vpaddb ")))

(define (compiler-backend-avx2-uniform-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]
  [broadcast : String]) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    (compiler-backend-uniform-map-source elem)
    (compiler_lower.CompilerLowerMode.Avx2))
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        (compiler_backend.CompilerBackendMode.Avx2)
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (let
            [body : String (compiler-backend-asm-function-body asm "_tl_fill")]
            [loop : String (compiler-backend-avx2-loop-body body)]
            (and
              (compiler_backend.backend-and8
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  "    vzeroupper\n")
                (compiler_backend.compiler-backend-string-contains? asm move)
                (compiler_backend.compiler-backend-string-contains? asm op)
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  broadcast)
                (compiler_backend.compiler-backend-string-contains? asm "%ymm")
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    asm
                    "vector/mask IR emission is not implemented"))
                (=
                  (compiler_backend.compiler-backend-string-count
                    loop
                    broadcast)
                  0)
                true)
              true))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-avx2-uniform-zip-ok?) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    (compiler-backend-uniform-zip-source)
    (compiler_lower.CompilerLowerMode.Avx2))
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        (compiler_backend.CompilerBackendMode.Avx2)
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.backend-and8
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vpbroadcastq ")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vpmuludq ")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vpsllq $32, ")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vpaddq ")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vmovdqu ")
              (compiler_backend.compiler-backend-string-contains? asm "%ymm")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  "vector/mask IR emission is not implemented"))
              true)
            true)]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

;; The uniform value may move when preheader caches change register pressure;
;; these checks care that its broadcast is emitted, not which spill owns it.
(define (compiler-backend-avx2-uniform-vector-map-ok?) : bool
  (and
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i64"
      "    vmovdqu "
      "    vpaddq "
      "    vpbroadcastq ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i32"
      "    vmovdqu "
      "    vpaddd "
      "    vpbroadcastd ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i16"
      "    vmovdqu "
      "    vpaddw "
      "    vpbroadcastw ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "u16"
      "    vmovdqu "
      "    vpaddw "
      "    vpbroadcastw ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "f64"
      "    vmovupd "
      "    vaddpd "
      "    vbroadcastsd ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "f32"
      "    vmovups "
      "    vaddps "
      "    vbroadcastss ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i8"
      "    vmovdqu "
      "    vpaddb "
      "    vpbroadcastb ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "u8"
      "    vmovdqu "
      "    vpaddb "
      "    vpbroadcastb ")
    (compiler-backend-avx2-uniform-zip-ok?)))

(define (compiler-backend-stack-splat-dst-only-assignments) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 6)))
    (compiler_regalloc.compiler-reg-assignment-table-empty)))

(define (compiler-backend-stack-splat-spill-assignments [offset : i64]) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 6)))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Spill offset))
      (compiler_regalloc.compiler-reg-assignment-table-empty))))

(define (compiler-backend-stack-splat-register-assignments) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 6)))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r12))
      (compiler_regalloc.compiler-reg-assignment-table-empty))))

(define (compiler-backend-stack-splat-float-register-assignments) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 6)))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          (compiler_abi.compiler-abi-xmm-register-id 3)))
      (compiler_regalloc.compiler-reg-assignment-table-empty))))

(define (compiler-backend-stack-memory-operand-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (and
      (match (compiler_backend.compiler-backend-stack-memory-operand
        (compiler-backend-stack-splat-dst-only-assignments)
        (compiler_ir_types.CompilerIrValue.Var 1)
        backend-state)
        [(compiler_backend.CompilerBackendMaybeStackOperand.Some operand)
          (string.eq operand "-16(%rbp)")]
        [(compiler_backend.CompilerBackendMaybeStackOperand.No) false])
      (match (compiler_backend.compiler-backend-stack-memory-operand
        (compiler-backend-stack-splat-spill-assignments -40)
        (compiler_ir_types.CompilerIrValue.Var 1)
        backend-state)
        [(compiler_backend.CompilerBackendMaybeStackOperand.Some operand)
          (string.eq operand "-40(%rbp)")]
        [(compiler_backend.CompilerBackendMaybeStackOperand.No) false])
      (match (compiler_backend.compiler-backend-stack-memory-operand
        (compiler-backend-stack-splat-register-assignments)
        (compiler_ir_types.CompilerIrValue.Var 1)
        backend-state)
        [(compiler_backend.CompilerBackendMaybeStackOperand.Some _) false]
        [(compiler_backend.CompilerBackendMaybeStackOperand.No) true])
      (match (compiler_backend.compiler-backend-stack-memory-operand
        (compiler-backend-stack-splat-dst-only-assignments)
        (compiler_ir_types.CompilerIrValue.I64 7)
        backend-state)
        [(compiler_backend.CompilerBackendMaybeStackOperand.Some _) false]
        [(compiler_backend.CompilerBackendMaybeStackOperand.No) true]))))

(define (compiler-backend-avx2-stack-splat-i64-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-avx2-splat
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-stack-splat-dst-only-assignments)
    0
    (compiler_ir_types.CompilerIrValue.Var 1)
    4
    (compiler_ast_types.AstType.I64)
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" "")
    (compiler_backend.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (string.eq asm "    vpbroadcastq -16(%rbp), %ymm6\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "%rax"))
        (not (compiler_backend.compiler-backend-string-contains? asm "%xmm0")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx2-stack-splat-f64-spill-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-avx2-splat
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-stack-splat-spill-assignments -40)
    0
    (compiler_ir_types.CompilerIrValue.Var 1)
    4
    (compiler_ast_types.AstType.F64)
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" "")
    (compiler_backend.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (string.eq asm "    vbroadcastsd -40(%rbp), %ymm6\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "%xmm0")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-stack-splat-i64-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-avx512-splat
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-stack-splat-dst-only-assignments)
    0
    (compiler_ir_types.CompilerIrValue.Var 1)
    8
    (compiler_ast_types.AstType.I64)
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" "")
    (compiler_backend.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (string.eq asm "    vpbroadcastq -16(%rbp), %zmm6\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "%rax"))
        (not (compiler_backend.compiler-backend-string-contains? asm "%xmm0")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-stack-splat-f64-spill-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-avx512-splat
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-stack-splat-spill-assignments -40)
    0
    (compiler_ir_types.CompilerIrValue.Var 1)
    8
    (compiler_ast_types.AstType.F64)
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" "")
    (compiler_backend.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (string.eq asm "    vbroadcastsd -40(%rbp), %zmm6\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "%xmm0")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-register-splat-fallback-ok?) : bool
  (and
    (match (compiler_backend.compiler-backend-emit-avx2-splat
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-stack-splat-register-assignments)
      0
      (compiler_ir_types.CompilerIrValue.Var 1)
      4
      (compiler_ast_types.AstType.I64)
      ""
      ""
      (compiler_diagnostic.compiler-diagnostic-at-start "" "")
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (string.eq
            asm
            "    movq %r12, %r8\n    vmovq %r8, %xmm2\n    vpbroadcastq %xmm2, %ymm6\n")
          (not (compiler_backend.compiler-backend-string-contains? asm "%rax"))
          (not (compiler_backend.compiler-backend-string-contains? asm "%xmm0")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    (match (compiler_backend.compiler-backend-emit-avx2-splat
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-stack-splat-float-register-assignments)
      0
      (compiler_ir_types.CompilerIrValue.Var 1)
      4
      (compiler_ast_types.AstType.F64)
      ""
      ""
      (compiler_diagnostic.compiler-diagnostic-at-start "" "")
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (string.eq
            asm
            "    movsd %xmm3, %xmm2\n    vbroadcastsd %xmm2, %ymm6\n")
          (not (compiler_backend.compiler-backend-string-contains? asm "%xmm0")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    (match (compiler_backend.compiler-backend-emit-avx512-splat
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-stack-splat-register-assignments)
      0
      (compiler_ir_types.CompilerIrValue.Var 1)
      8
      (compiler_ast_types.AstType.I64)
      ""
      ""
      (compiler_diagnostic.compiler-diagnostic-at-start "" "")
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (string.eq asm "    movq %r12, %r8\n    vpbroadcastq %r8, %zmm6\n")
          (not (compiler_backend.compiler-backend-string-contains? asm "%rax")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    (match (compiler_backend.compiler-backend-emit-avx512-splat
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-stack-splat-float-register-assignments)
      0
      (compiler_ir_types.CompilerIrValue.Var 1)
      8
      (compiler_ast_types.AstType.F64)
      ""
      ""
      (compiler_diagnostic.compiler-diagnostic-at-start "" "")
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (string.eq
            asm
            "    movsd %xmm3, %xmm2\n    vbroadcastsd %xmm2, %zmm6\n")
          (not (compiler_backend.compiler-backend-string-contains? asm "%xmm0")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-stack-splat-broadcast-ok?) : bool
  (and
    (compiler-backend-stack-memory-operand-ok?)
    (compiler-backend-avx2-stack-splat-i64-ok?)
    (compiler-backend-avx2-stack-splat-f64-spill-ok?)
    (compiler-backend-avx512-stack-splat-i64-ok?)
    (compiler-backend-avx512-stack-splat-f64-spill-ok?)
    (compiler-backend-register-splat-fallback-ok?)))

(define (compiler-backend-vector-spill-assignments) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-rdi))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r12))
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          2
          (compiler_regalloc.CompilerRegLocation.Register
            (compiler_abi.compiler-abi-vector-register-id 6)))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            3
            (compiler_regalloc.CompilerRegLocation.Spill -64))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              4
              (compiler_regalloc.CompilerRegLocation.Register
                (compiler_abi.compiler-abi-mask-register-id 1)))
            (compiler_regalloc.compiler-reg-assignment-table-empty)))))))

