(define (compiler-backend-checked-trap-shift-ok-block) : CompilerIrBlock
  (compiler-ir-block
    "shift_ok"
    (compiler-ir-instr-cons
      (CompilerIrInstr.BinOp
        6
        (CompilerIrBinOp.Shl)
        (CompilerIrValue.I64 1)
        (CompilerIrValue.I64 2)
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Return
          (CompilerIrMaybeValue.Some (CompilerIrValue.Var 6)))
        CompilerIrInstrList.Nil))))

(define (compiler-backend-checked-trap-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-backend-checked-trap-entry-block)
    (compiler-ir-block-cons
      (compiler-backend-checked-trap-div-block)
      (compiler-ir-block-cons
        (compiler-backend-checked-trap-div-ok-block)
        (compiler-ir-block-cons
          (compiler-backend-checked-trap-shift-block)
          (compiler-ir-block-cons
            (compiler-backend-checked-trap-shift-ok-block)
            CompilerIrBlockList.Nil))))))

(define (compiler-backend-checked-trap-program) : CompilerIrProgram
  (CompilerIrProgram.Program
    CompilerIrGlobalList.Nil
    (compiler-ir-function-cons
      (CompilerIrFunction.Function
        (ci.intern "main")
        CompilerIrParamList.Nil
        (AstType.I64)
        8
        (compiler-backend-checked-trap-blocks))
      CompilerIrFunctionList.Nil)
    CompilerIrExternList.Nil))

(define (compiler-backend-checked-trap-asm-shape-ok? [asm : String]) : bool
  (let
    [trap-branches : bool
      (backend-and4
        (compiler-backend-string-contains? asm ".Lf0_div_trap:\n")
        (compiler-backend-string-contains? asm ".Lf0_shift_trap:\n")
        (compiler-backend-string-contains? asm "    call tl_div_abort\n")
        (compiler-backend-string-contains? asm "    call tl_shift_abort\n"))]
    [helper-shapes : bool
      (backend-and8
        (not (compiler-backend-string-contains? asm ".globl tl_div_abort\n"))
        (not (compiler-backend-string-contains? asm "tl_div_abort:\n"))
        (not (compiler-backend-string-contains? asm ".L_tl_div_msg:"))
        (not (compiler-backend-string-contains? asm "movq $135, %rdi\n"))
        (not (compiler-backend-string-contains? asm ".globl tl_shift_abort\n"))
        (not (compiler-backend-string-contains? asm "tl_shift_abort:\n"))
        (not (compiler-backend-string-contains? asm ".L_tl_shift_msg:"))
        (not (compiler-backend-string-contains? asm "movq $129, %rdi\n")))]
    [op-shapes : bool
      (backend-and4
        (compiler-backend-string-contains? asm "    idivq %r8\n")
        (compiler-backend-string-contains? asm "    movq %rdx, %rax\n")
        (compiler-backend-string-contains? asm "    shlq $2, %rax\n")
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [no-externs : bool
      (backend-and4
        (not (compiler-backend-string-contains? asm ".extern tl_div_abort\n"))
        (not (compiler-backend-string-contains? asm ".extern tl_shift_abort\n"))
        (not (compiler-backend-string-contains? asm "_tl_tl_div_abort"))
        (not (compiler-backend-string-contains? asm "_tl_tl_shift_abort")))]
    (and trap-branches helper-shapes op-shapes no-externs)))

(define (compiler-backend-narrow-binop-types
  [lhs-ty : AstType]
  [rhs-ty : AstType]) : CompilerRegVarTypeList
  (compiler-reg-var-type-cons
    (CompilerRegVarType.Type 0 lhs-ty)
    (compiler-reg-var-type-cons
      (CompilerRegVarType.Type 1 rhs-ty)
      CompilerRegVarTypeList.Nil)))

(define (compiler-backend-narrow-binop-shape?
  [op : CompilerIrBinOp]
  [lhs-ty : AstType]
  [rhs-ty : AstType]
  [result-ty : AstType]
  [needle : String]
  [bad : String]) : bool
  (match (compiler-backend-emit-binop
    (compiler-backend-narrow-binop-types lhs-ty rhs-ty)
    (CompilerBackendGlobalTypeList.Nil)
    CompilerRegAssignmentList.Nil
    2
    op
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    result-ty)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm needle)
        (if (string.eq bad "")
          true
          (not (compiler-backend-string-contains? asm bad)))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

;; Backend-owned narrow integer instruction selection coverage. These
;; checks pin the operand width and signedness-sensitive forms that source-level
;; execution tests do not distinguish.
(define (compiler-backend-narrow-scalar-instr-ok?) : bool
  (and
    (backend-and8
      (compiler-backend-narrow-binop-shape?
        (CompilerIrBinOp.Add)
        (AstType.I32)
        (AstType.I32)
        (AstType.I32)
        "    addl -16(%rbp), %r8d\n"
        "%rax")
      (compiler-backend-narrow-binop-shape?
        (CompilerIrBinOp.Mul)
        (AstType.I32)
        (AstType.I32)
        (AstType.I32)
        "    imull -16(%rbp), %r8d\n"
        "%rax")
      (compiler-backend-narrow-binop-shape?
        (CompilerIrBinOp.Div)
        (AstType.I32)
        (AstType.I32)
        (AstType.I32)
        "    cdq\n    idivl %r8d\n"
        "    idivq %r8\n")
      (compiler-backend-narrow-binop-shape?
        (CompilerIrBinOp.Add)
        (AstType.I8)
        (AstType.I8)
        (AstType.I8)
        "    addb -16(%rbp), %r8b\n"
        "%rax")
      (compiler-backend-narrow-binop-shape?
        (CompilerIrBinOp.Sub)
        (AstType.I8)
        (AstType.I8)
        (AstType.I8)
        "    subb -16(%rbp), %r8b\n"
        "%rax")
      (compiler-backend-narrow-binop-shape?
        (CompilerIrBinOp.Lt)
        (AstType.I8)
        (AstType.I8)
        (AstType.Bool)
        "    cmpb -16(%rbp), %r8b\n    setl %r8b\n"
        "%rax")
      (compiler-backend-narrow-binop-shape?
        (CompilerIrBinOp.Mod)
        (AstType.I8)
        (AstType.I8)
        (AstType.I8)
        "    cbw\n    idivb %r8b\n    movb %ah, %al\n"
        "    idivq %r8\n")
      (compiler-backend-narrow-binop-shape?
        (CompilerIrBinOp.BitAnd)
        (AstType.I16)
        (AstType.I16)
        (AstType.I16)
        "    andw -16(%rbp), %r8w\n"
        "%rax"))
    (backend-and4
      (compiler-backend-narrow-binop-shape?
        (CompilerIrBinOp.Div)
        (AstType.I16)
        (AstType.I16)
        (AstType.I16)
        "    cwd\n    idivw %r8w\n"
        "    idivq %r8\n")
      (compiler-backend-narrow-binop-shape?
        (CompilerIrBinOp.Mod)
        (AstType.U8)
        (AstType.U8)
        (AstType.U8)
        "    andw $0x00ff, %ax\n    divb %r8b\n    movb %ah, %al\n"
        "    idivq %r8\n")
      (and
        (compiler-backend-narrow-binop-shape?
          (CompilerIrBinOp.Shr)
          (AstType.I8)
          (AstType.U8)
          (AstType.I8)
          "    movq %r8, %rcx\n    sarb %cl, %r9b\n"
          "%rax")
        (compiler-backend-narrow-binop-shape?
          (CompilerIrBinOp.Shr)
          (AstType.U8)
          (AstType.U8)
          (AstType.U8)
          "    movq %r8, %rcx\n    shrb %cl, %r9b\n"
          "%rax"))
      (and
        (compiler-backend-narrow-binop-shape?
          (CompilerIrBinOp.Shl)
          (AstType.U8)
          (AstType.U8)
          (AstType.U8)
          "    movq %r8, %rcx\n    shlb %cl, %r9b\n"
          "%rax")
        (compiler-backend-narrow-binop-shape?
          (CompilerIrBinOp.Lt)
          (AstType.U8)
          (AstType.U8)
          (AstType.Bool)
          "    cmpb -16(%rbp), %r8b\n    setb %r8b\n"
          "%rax")))))

(define (compiler-backend-global-compare-types) : CompilerBackendGlobalTypeList
  (CompilerBackendGlobalTypeList.Cons
    (ci.intern "g_next")
    (AstType.I64)
    (box
      (CompilerBackendGlobalTypeList.Cons
        (ci.intern "g_cap")
        (AstType.I64)
        (box CompilerBackendGlobalTypeList.Nil)))))

(define (compiler-backend-global-compare-binop-ok?) : bool
  (match (compiler-backend-emit-binop
    (CompilerRegVarTypeList.Nil)
    (compiler-backend-global-compare-types)
    CompilerRegAssignmentList.Nil
    0
    (CompilerIrBinOp.Ge)
    (CompilerIrValue.Global (ci.intern "g_next"))
    (CompilerIrValue.Global (ci.intern "g_cap"))
    (AstType.Bool))
    [(ResultCompilerBackend.Ok asm)
      (and
        ;; The 64-bit global compare now materialises in %r9 (scratch reg
        ;; choice changed); the load-bearing check is the width (cmpq, not cmpb).
        (compiler-backend-string-contains? asm "    cmpq %r8, %r9\n")
        (not (compiler-backend-string-contains? asm "    cmpb %r8b, %al\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-global-compare-program) : CompilerIrProgram
  (CompilerIrProgram.Program
    (compiler-ir-global-cons
      (CompilerIrGlobal.Global
        (ci.intern "g_next")
        (AstType.I64)
        (CompilerIrValue.I64 1))
      (compiler-ir-global-cons
        (CompilerIrGlobal.Global
          (ci.intern "g_cap")
          (AstType.I64)
          (CompilerIrValue.I64 1024))
        CompilerIrGlobalList.Nil))
    (compiler-ir-function-cons
      (CompilerIrFunction.Function
        (ci.intern "main")
        CompilerIrParamList.Nil
        (AstType.I64)
        1
        (compiler-ir-block-cons
          (compiler-ir-block
            "entry"
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                0
                (CompilerIrBinOp.Ge)
                (CompilerIrValue.Global (ci.intern "g_next"))
                (CompilerIrValue.Global (ci.intern "g_cap"))
                (AstType.Bool))
              (compiler-ir-instr-cons
                (CompilerIrInstr.Branch (CompilerIrValue.Var 0) "full" "ok")
                CompilerIrInstrList.Nil)))
          (compiler-ir-block-cons
            (compiler-ir-block
              "full"
              (compiler-ir-instr-cons
                (CompilerIrInstr.Return
                  (CompilerIrMaybeValue.Some (CompilerIrValue.I64 1)))
                CompilerIrInstrList.Nil))
            (compiler-ir-block-cons
              (compiler-ir-block
                "ok"
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Return
                    (CompilerIrMaybeValue.Some (CompilerIrValue.I64 42)))
                  CompilerIrInstrList.Nil))
              CompilerIrBlockList.Nil))))
      CompilerIrFunctionList.Nil)
    CompilerIrExternList.Nil))

(define (compiler-backend-global-compare-branch-ok?) : bool
  (match (compiler-backend-emit-program-linux
    (compiler-backend-global-compare-program))
    [(ResultCompilerBackend.Ok asm)
      (and
        ;; The 64-bit global compare now materialises in %r9 (scratch reg
        ;; choice changed); the load-bearing check is the width (cmpq, not cmpb).
        (compiler-backend-string-contains? asm "    cmpq %r8, %r9\n")
        (not (compiler-backend-string-contains? asm "    cmpb %r8b, %al\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-missing-var-compare-width-ok?) : bool
  (let
    [rhs-spill : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
        CompilerRegAssignmentList.Nil)]
    (match (compiler-backend-emit-binop
      (CompilerRegVarTypeList.Nil)
      (CompilerBackendGlobalTypeList.Nil)
      rhs-spill
      2
      (CompilerIrBinOp.Lt)
      (CompilerIrValue.Var 0)
      (CompilerIrValue.Var 1)
      (AstType.Bool))
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains?
            asm
            "    cmpq -16(%rbp), %r8\n    setl %r8b\n")
          (not
            (compiler-backend-string-contains? asm "    cmpb -16(%rbp), %al\n"))
          (not
            (compiler-backend-string-contains?
              asm
              "    cmpq -16(%rbp), %rax\n    setl %al\n")))]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-global-compare-width-ok?) : bool
  (and
    (compiler-backend-global-compare-binop-ok?)
    (compiler-backend-global-compare-branch-ok?)
    (compiler-backend-missing-var-compare-width-ok?)))

(define (compiler-backend-f64-abi-source) : String
  "(define (half [x : f64]) : f64 (/ x 2.0))
(define (callhalf [x : f64]) : f64 (half x))
(define (second [n : i64] [x : f64]) : f64 x)")

(define (compiler-backend-f64-abi-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-f64-abi-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and8
        ;; FPO rsp-relative frame slots (second's n at 8(%rsp); half's x
        ;; f64 param spills from %xmm0 to 24(%rsp), divisor 2.0 at 16(%rsp)).
        (compiler-backend-string-contains? asm "    movq %rdi, 8(%rsp)\n")
        (compiler-backend-string-contains? asm "    movsd %xmm0, 24(%rsp)\n")
        (not
          (compiler-backend-string-contains? asm "    movsd %xmm1, 24(%rsp)\n"))
        (compiler-backend-string-contains? asm "    divsd 16(%rsp), %xmm2\n")
        (or
          (compiler-backend-call-or-jmp-ok? asm "_tl_half")
          (compiler-backend-call-or-jmp-ok? asm "_tl_callhalf")
          (compiler-backend-call-or-jmp-ok? asm "_tl_f"))
        (compiler-backend-string-contains? asm "    movsd %xmm0, ")
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker)))
        (not (compiler-backend-string-contains? asm "    divsd %xmm1, %xmm0\n")))]
    [(ResultCompilerBackend.Err _) false]))

;; Windows f64 ABI emit-shape coverage: the first four positional
;; f64 args use xmm0..xmm3, the fifth is stacked after the 32-byte shadow
;; space, and f64 returns remain in xmm0.
(define (compiler-backend-win64-f64-abi-source) : String
  "(define (sum5
  [a : f64]
  [b : f64]
  [c : f64]
  [d : f64]
  [e : f64]) : f64
  (+ (+ (+ (+ a b) c) d) e))

(define (call5 [x : f64]) : f64
  (+ 0.0 (sum5 x 2.0 3.0 4.0 5.0)))

(define (main) : i64
  (if (< (call5 1.0) 16.0) 42 0))")

(define (compiler-backend-win64-f64-abi-ok?) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-win64-f64-abi-source)
    (CompilerBackendTarget.Windows))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          ;; Win64 FPO rebases local slots and the positive incoming fifth
          ;; argument against the constant post-prologue %rsp.
          (compiler-backend-string-contains? asm "    movsd %xmm0, 72(%rsp)\n")
          (compiler-backend-string-contains? asm "    movsd %xmm1, 64(%rsp)\n")
          (compiler-backend-string-contains? asm "    movsd %xmm2, 56(%rsp)\n")
          (compiler-backend-string-contains? asm "    movsd %xmm3, 48(%rsp)\n")
          (compiler-backend-string-contains? asm "    subq $120, %rsp\n")
          (compiler-backend-string-contains? asm "    movq 64(%rsp), %r10\n")
          (compiler-backend-string-contains? asm "    movq %r10, 32(%rsp)\n")
          (compiler-backend-string-contains? asm "    movsd 128(%rsp), %xmm2\n"))
        (or
          (compiler-backend-string-contains? asm "    call _tl_f")
          (compiler-backend-string-contains? asm "    call _tl_sum5")
          (compiler-backend-string-contains? asm "    call _tl_call5"))
        ;; The f64 call result (kept in %xmm0) spills to rsp slot 56(%rsp).
        (compiler-backend-string-contains? asm "    movsd %xmm0, 56(%rsp)\n")
        (not (compiler-backend-string-contains? asm "too many call args"))
        (not (compiler-backend-string-contains? asm "    syscall"))
        (not
          (compiler-backend-string-contains? asm "    movsd 48(%rbp), %xmm0\n"))
        (not
          (compiler-backend-string-contains? asm "    movq %r11, 32(%rsp)\n"))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-register-f64-aggregate-source) : String
  "(defstruct PairF64 (x f64) (y f64))
(defstruct MixIF (i i64) (f f64))
(define global-pair : PairF64 (PairF64 1.0 2.0))
(define (make-pair [x : f64] [y : f64]) : PairF64
  (PairF64 x y))
(define (sum-pair [p : PairF64]) : f64
  (+ (struct-get p x) (struct-get p y)))
(define (mixed [m : MixIF]) : f64
  (struct-get m f))
(define (main) : i64
  (begin
    (set! global-pair (make-pair 3.0 4.0))
    (if (= (+ (sum-pair global-pair) (mixed (MixIF 5 6.0))) 13.0)
      42
      0)))")

(define (compiler-backend-register-f64-aggregate-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-register-f64-aggregate-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (compiler-backend-string-contains? asm "    movsd ")
          (compiler-backend-string-contains? asm "%xmm0")
          (compiler-backend-string-contains? asm "%xmm1")
          (compiler-backend-string-contains? asm "    call ")
          (not (compiler-backend-string-contains? asm "    movsd %rax"))
          (not (compiler-backend-string-contains? asm "    movsd %rdx"))
          (not (compiler-backend-string-contains? asm ", %rax\n    movsd"))
          (not (compiler-backend-string-contains? asm ", %rdx\n    movsd")))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-register-f64-aggregate-ok?) : bool
  (and
    (compiler-backend-register-f64-aggregate-target-ok?
      (CompilerBackendTarget.Linux))
    (compiler-backend-register-f64-aggregate-target-ok?
      (CompilerBackendTarget.Windows))))

(define (compiler-backend-register-f32-aggregate-source) : String
  "(defstruct Vec2F32 (x f32) (y f32))
(defstruct MixUF (tag u32) (value f32))
(define global-vec : Vec2F32 (Vec2F32 1.0 2.0))
(define (make-vec [x : f32] [y : f32]) : Vec2F32
  (Vec2F32 x y))
(define (sum-vec [v : Vec2F32]) : f32
  (+ (struct-get v x) (struct-get v y)))
(define (choose-vec [take-left : bool]) : Vec2F32
  (if take-left
    (Vec2F32 1.25 2.75)
    (Vec2F32 9.0 10.0)))
(define (mixed [m : MixUF]) : f32
  (struct-get m value))
(define (main) : i64
  (begin
    (set! global-vec (make-vec 3.5 4.5))
    (if (= (+ (sum-vec global-vec) (sum-vec (choose-vec true))) 12.0)
      (cast (mixed (MixUF (cast 5 : u32) 6.0)) : i64)
      0)))")

(define (compiler-backend-register-f32-aggregate-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-register-f32-aggregate-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (compiler-backend-string-contains? asm "    movd %xmm2, %r8d\n")
          (compiler-backend-string-contains? asm "    movd %r8d, %xmm2\n")
          (compiler-backend-string-contains? asm "    movsd ")
          (compiler-backend-string-contains? asm "%xmm0")
          (compiler-backend-string-contains? asm "    call ")
          (compiler-backend-string-contains? asm "    movss 4(%r10), %xmm2\n")
          (not (compiler-backend-string-contains? asm "unsupported bitcast"))
          (not
            (compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))
        (not (compiler-backend-string-contains? asm "    movsd %rax"))
        (not (compiler-backend-string-contains? asm "    movsd %rdx"))
        (not (compiler-backend-string-contains? asm "    movd %xmm0, %eax\n"))
        (not (compiler-backend-string-contains? asm "    movd %eax, %xmm0\n"))
        (not
          (compiler-backend-string-contains? asm "    movss 4(%r10), %xmm0\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-register-f32-aggregate-ok?) : bool
  (and
    (compiler-backend-register-f32-aggregate-target-ok?
      (CompilerBackendTarget.Linux))
    (compiler-backend-register-f32-aggregate-target-ok?
      (CompilerBackendTarget.Windows))))

;; A SysV call with seven integer args no longer rejects as "too many
;; call args". Source-level numeric literals are lowered into locals before
;; call-arg emission, so the 7th and 8th args still exercise the variable
;; stack-store path while `add8` reads them back from 16(%rbp)/24(%rbp).
(define (compiler-backend-stack-add-call-ok? [asm : String]) : bool
  (or
    (compiler-backend-string-contains? asm "    call _tl_add8")
    (compiler-backend-string-contains? asm "    call _tl_f")))

(define (compiler-backend-stack-mix-call-ok? [asm : String]) : bool
  (or
    (compiler-backend-string-contains? asm "    call _tl_mix")
    (compiler-backend-string-contains? asm "    call _tl_f")))

(define (compiler-backend-stack-int-args-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-stack-int-args-source))
    [(ResultCompilerBackend.Ok asm)
      ;; Under FPO the outgoing stack-arg area is reserved once in the
      ;; prologue (no per-call `subq $16`/`addq $16`); both stack args are
      ;; stored to 0(%rsp)/8(%rsp), and the callee reads the incoming stack args
      ;; rsp-relative (96/104(%rsp)) instead of positive 16/24(%rbp). The
      ;; incoming-arg checks are scoped to the _tl_add8 body: with everything now
      ;; positive-rsp, `main` also uses those same numeric slots for its own
      ;; locals (e.g. `movq 104(%rsp), %rax`), so a whole-program `not` check
      ;; would spuriously trip.
      (let
        [callee : String (compiler-backend-asm-function-body asm "_tl_add8")]
        (and
          (not (compiler-backend-string-contains? asm "too many call args"))
          (compiler-backend-string-contains? asm "    movq %r10, 0(%rsp)\n")
          (compiler-backend-string-contains? asm "    movq %r10, 8(%rsp)\n")
          (compiler-backend-stack-add-call-ok? asm)
          (compiler-backend-string-contains? callee "    movq 96(%rsp), %r8\n")
          (compiler-backend-string-contains? callee "    movq 104(%rsp), %r8\n")
          (not
            (compiler-backend-string-contains?
              callee
              "    movq 96(%rsp), %rax\n"))
          (not
            (compiler-backend-string-contains?
              callee
              "    movq 104(%rsp), %rax\n"))))]
    [(ResultCompilerBackend.Err _) false]))

;; A SysV call with ten f64 args uses xmm0..xmm7 then spills two on the
;; stack through a scavenged GP bit-copy; the callee reads them back via movsd
;; from the incoming stack slots.
(define (compiler-backend-stack-f64-args-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-stack-f64-args-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (not (compiler-backend-string-contains? asm "too many call args"))
        ;; FPO reserves the outgoing stack-arg area in the prologue (no
        ;; per-call `subq $16`); the two spilled f64 args go to 0/8(%rsp) via GP
        ;; bit-copies and the callee reads incoming f64 stack args rsp-relative
        ;; (112/120(%rsp)) instead of positive 16/24(%rbp).
        (compiler-backend-string-contains? asm "    movq %r10, 0(%rsp)\n")
        (compiler-backend-string-contains? asm "    movq %r10, 8(%rsp)\n")
        (compiler-backend-string-contains? asm "    movsd 112(%rsp), %xmm2\n")
        (compiler-backend-string-contains? asm "    movsd 120(%rsp), %xmm2\n")
        (not
          (compiler-backend-string-contains? asm "    movsd 112(%rsp), %xmm0\n"))
        (not
          (compiler-backend-string-contains? asm "    movsd 120(%rsp), %xmm0\n")))]
    [(ResultCompilerBackend.Err _) false]))

;; A mixed call spilling one int and one f64 keeps the integer and float
;; register banks independent and uses the right scratch register for each
;; spilled arg.
(define (compiler-backend-stack-mixed-args-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-stack-mixed-args-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (not (compiler-backend-string-contains? asm "too many call args"))
        (compiler-backend-string-contains? asm "    movq %r10, 0(%rsp)\n")
        (compiler-backend-string-contains? asm "    movq %r10, 8(%rsp)\n")
        (compiler-backend-stack-mix-call-ok? asm))]
    [(ResultCompilerBackend.Err _) false]))

;; The Windows positional ABI still reserves 32-byte shadow space, stacks
;; args after the first four, and stores them after the shadow space.
(define (compiler-backend-stack-windows-args-ok?) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-stack-int-args-source)
    (CompilerBackendTarget.Windows))
    [(ResultCompilerBackend.Ok asm)
      (and
        (not (compiler-backend-string-contains? asm "too many call args"))
        (compiler-backend-string-contains? asm "    call _tl_add8\n")
        (compiler-backend-string-contains? asm "    movq %r10, 32(%rsp)\n")
        (compiler-backend-string-contains? asm "    movq %r10, 56(%rsp)\n")
        (compiler-backend-string-contains? asm "    movq 128(%rsp), %r8\n")
        (not
          (compiler-backend-string-contains? asm "    movq 128(%rsp), %rax\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-i64-type-list8) : AstTypeList
  (let
    [out : AstTypeList (ast-type-list-with-capacity 8)]
    [i : i64 0]
    (begin
      (while (< i 8)
        (begin
          (ast-type-list-push
            (&mut out)
            (ast-node-pool-reader-type-push (AstType.I64)))
          (set! i (+ i 1))))
      out)))

(define (compiler-backend-i64-immediate-call-args8) : CompilerIrCallArgs
  (compiler-ir-call-args-from-list
    (compiler-ir-value-cons
      (CompilerIrValue.I64 1)
      (compiler-ir-value-cons
        (CompilerIrValue.I64 2)
        (compiler-ir-value-cons
          (CompilerIrValue.I64 3)
          (compiler-ir-value-cons
            (CompilerIrValue.I64 4)
            (compiler-ir-value-cons
              (CompilerIrValue.I64 5)
              (compiler-ir-value-cons
                (CompilerIrValue.I64 6)
                (compiler-ir-value-cons
                  (CompilerIrValue.I64 7)
                  (compiler-ir-value-cons
                    (CompilerIrValue.I64 8)
                    CompilerIrValueList.Nil))))))))))

(define (compiler-backend-immediate-stack-call-args-ok?) : bool
  (match (compiler-backend-emit-call-args
    (CompilerBackendTarget.Linux)
    CompilerRegAssignmentList.Nil
    (compiler-backend-i64-immediate-call-args8)
    (compiler-backend-i64-type-list8)
    false
    0
    0
    0
    0
    0
    ""
    (compiler-diagnostic-at-start "" "")
    (compiler-backend-program-index-build
      CompilerIrFunctionList.Nil
      CompilerIrExternList.Nil)
    0)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    movq $7, 0(%rsp)\n")
        (compiler-backend-string-contains? asm "    movq $8, 8(%rsp)\n")
        (not (compiler-backend-string-contains? asm "    movq %r11, 0(%rsp)\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-stack-f32-arg-bits-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%xmm3"))
        CompilerRegAssignmentList.Nil)]
    (match (compiler-backend-emit-scalar-stack-call-arg
      (CompilerBackendTarget.Linux)
      assignments
      (CompilerIrValue.Var 0)
      (AstType.F32)
      true
      0
      "")
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains? asm "    movd %xmm3, %r10d\n")
          (compiler-backend-string-contains? asm "    movl %r10d, 0(%rsp)\n")
          (not (compiler-backend-string-contains? asm "%xmm15")))]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-group-stack-f64-arg-bits-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.RegisterPair "%xmm3" "%xmm4"))
        CompilerRegAssignmentList.Nil)]
    [ty : AstType (compiler-backend-register-group-f64-test-type)]
    (match (compiler-backend-emit-group-stack-arg
      (CompilerBackendTarget.Linux)
      assignments
      (CompilerIrValue.Var 0)
      0
      2
      ""
      ty
      (compiler-backend-register-group-f64-test-index))
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains? asm "    movq %xmm3, %r10\n")
          (compiler-backend-string-contains? asm "    movq %r10, 0(%rsp)\n")
          (compiler-backend-string-contains? asm "    movq %xmm4, %r10\n")
          (compiler-backend-string-contains? asm "    movq %r10, 8(%rsp)\n")
          (not (compiler-backend-string-contains? asm "%xmm15")))]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-group-stack-param-no-return-stage-ok?) : bool
  (let
    [ty : AstType (compiler-backend-register-group-test-type)]
    [index : CompilerBackendProgramIndex
      (compiler-backend-register-group-test-index)]
    [params : CompilerIrParamList
      (compiler-ir-param-cons
        (CompilerIrParam.Param "pair" ty 0)
        CompilerIrParamList.Nil)]
    [reg-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.RegisterPair "%r12" "%r13"))
        CompilerRegAssignmentList.Nil)]
    (and
      (match (compiler-backend-emit-param-spills
        (CompilerBackendTarget.Linux)
        reg-assignments
        params
        6
        0
        6
        0
        index
        1)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains? asm "    movq 16(%rbp), %r12\n")
            (compiler-backend-string-contains? asm "    movq 24(%rbp), %r13\n")
            (not
              (compiler-backend-string-contains?
                asm
                "    movq 16(%rbp), %rax\n"))
            (not
              (compiler-backend-string-contains?
                asm
                "    movq 24(%rbp), %rdx\n")))]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-param-spills
        (CompilerBackendTarget.Linux)
        CompilerRegAssignmentList.Nil
        params
        6
        0
        6
        0
        index
        1)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    movq 16(%rbp), %r8\n    movq %r8, -8(%rbp)\n")
            (compiler-backend-string-contains?
              asm
              "    movq 24(%rbp), %r8\n    movq %r8, -16(%rbp)\n")
            (not
              (compiler-backend-string-contains?
                asm
                "    movq 16(%rbp), %rax\n"))
            (not
              (compiler-backend-string-contains?
                asm
                "    movq 24(%rbp), %rdx\n")))]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-stack-args-ok?) : bool
  (and
    (compiler-backend-stack-int-args-ok?)
    (compiler-backend-stack-f64-args-ok?)
    (compiler-backend-stack-mixed-args-ok?)
    (compiler-backend-stack-windows-args-ok?)
    (compiler-backend-stack-f32-arg-bits-ok?)
    (compiler-backend-group-stack-f64-arg-bits-ok?)
    (compiler-backend-group-stack-param-no-return-stage-ok?)
    (compiler-backend-immediate-stack-call-args-ok?)))

(define (compiler-backend-asm-function-body [asm : String] [symbol : String]) : String
  (let
    [label : String (str_cat.str-cat symbol ":\n")]
    [start : i64 (compiler-backend-string-find-from asm label 0)]
    (if (< start 0)
      ""
      (let
        [body-start : i64 (+ start (string.string-length label))]
        [plain-next : i64
          (compiler-backend-string-find-from asm "\n.globl " body-start)]
        [indented-next : i64
          (compiler-backend-string-find-from asm "\n    .globl " body-start)]
        [next : i64
          (if (< plain-next 0)
            indented-next
            (if (and (>= indented-next 0) (< indented-next plain-next))
              indented-next
              plain-next))]
        [body-end : i64
          (if (< next 0)
            (string.string-length asm)
            next)]
        (string.substring asm body-start (- body-end body-start))))))

(define (compiler-backend-direct-tail-call-reg0
  [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    "%rcx"
    "%rdi"))

(define (compiler-backend-direct-tail-call-reg1
  [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    "%rdx"
    "%rsi"))

(define (compiler-backend-direct-tail-call-param-store
  [reg : String]
  [slot : String]) : String
  (str_cat.str-cat "    movq " reg ", " slot "\n"))

(define (compiler-backend-direct-tail-call-param-load
  [slot : String]
  [reg : String]) : String
  (str_cat.str-cat "    movq " slot ", " reg "\n"))

(define (compiler-backend-direct-tail-call-identity-elided?
  [target : CompilerBackendTarget]
  [asm : String]) : bool
  (let
    [body : String (compiler-backend-asm-function-body asm "_tl_step")]
    [reg0 : String (compiler-backend-direct-tail-call-reg0 target)]
    [reg1 : String (compiler-backend-direct-tail-call-reg1 target)]
    (and
      (compiler-backend-string-contains? body "    jmp _tl_finish\n")
      (not (compiler-backend-string-contains? body "    call _tl_finish\n"))
      (not
        (compiler-backend-string-contains?
          body
          (compiler-backend-direct-tail-call-param-store reg0 "-8(%rbp)")))
      (not
        (compiler-backend-string-contains?
          body
          (compiler-backend-direct-tail-call-param-store reg1 "-16(%rbp)")))
      (not
        (compiler-backend-string-contains?
          body
          (compiler-backend-direct-tail-call-param-load "-8(%rbp)" reg0)))
      (not
        (compiler-backend-string-contains?
          body
          (compiler-backend-direct-tail-call-param-load "-16(%rbp)" reg1))))))

(define (compiler-backend-direct-tail-call-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    jmp _tl_finish\n")
        (not (compiler-backend-string-contains? asm "    call _tl_finish\n"))
        (compiler-backend-direct-tail-call-identity-elided? target asm))]
    [(ResultCompilerBackend.Err _) false]))

;; Under FPO the source params spill to rsp-relative slots whose offsets
;; depend on each fixture's frame size (and target), so slot0/slot1 are passed
;; per call site instead of the old fixed -8/-16(%rbp). A "" slot1 means the
;; second param is not spilled (correctly optimised away — e.g. the `finish x x`
;; duplicated fixture, where the dead y param is never stored).
(define (compiler-backend-direct-tail-call-i64-keeps-spills?
  [source : String]
  [target : CompilerBackendTarget]
  [slot0 : String]
  [slot1 : String]) : bool
  (match (compiler-backend-emit-source-for-target source target)
    [(ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_step")]
        [reg0 : String (compiler-backend-direct-tail-call-reg0 target)]
        [reg1 : String (compiler-backend-direct-tail-call-reg1 target)]
        (and
          (compiler-backend-string-contains? body "    jmp _tl_finish\n")
          (compiler-backend-string-contains?
            body
            (compiler-backend-direct-tail-call-param-store reg0 slot0))
          (if (string.eq slot1 "")
            true
            (compiler-backend-string-contains?
              body
              (compiler-backend-direct-tail-call-param-store reg1 slot1)))))]
    [(ResultCompilerBackend.Err _) false]))

;; Under FPO the f64 params spill to rsp-relative slots (offsets differ by
;; target), passed per call site instead of the old fixed -8/-16(%rbp).
(define (compiler-backend-direct-tail-call-f64-keeps-spills?
  [target : CompilerBackendTarget]
  [slot0 : String]
  [slot1 : String]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-f64-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_stepf")]
        (and
          (compiler-backend-string-contains? body "    jmp _tl_finishf\n")
          (compiler-backend-string-contains?
            body
            (str_cat.str-cat "    movsd %xmm0, " (str_cat.str-cat slot0 "\n")))
          (compiler-backend-string-contains?
            body
            (str_cat.str-cat "    movsd %xmm1, " (str_cat.str-cat slot1 "\n")))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-direct-tail-call-stack-slot
  [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    ;; Win64 FPO rebases the outgoing tail stack-arg store.
    "    movq %r10, 200(%rsp)\n"
    ;; FPO makes the Linux outgoing tail stack-arg store rsp-relative.
    "    movq %r10, 104(%rsp)\n"))

(define (compiler-backend-direct-tail-call-stack-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-stack-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    jmp _tl_finishstack\n")
        (not
          (compiler-backend-string-contains? asm "    call _tl_finishstack\n"))
        (not (compiler-backend-string-contains? asm "    pushq %r11\n"))
        (compiler-backend-string-contains?
          asm
          (compiler-backend-direct-tail-call-stack-slot target)))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-direct-tail-immediate-stack-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-direct-tail-call-args
    target
    CompilerRegAssignmentList.Nil
    (compiler-backend-i64-immediate-call-args8)
    (compiler-backend-i64-type-list8)
    ""
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (if (compiler-backend-target-windows? target)
        (and
          (compiler-backend-string-contains? asm "    movq $5, 48(%rbp)\n")
          (compiler-backend-string-contains? asm "    movq $8, 72(%rbp)\n")
          (not (compiler-backend-string-contains? asm "    pushq %r11\n")))
        (and
          (compiler-backend-string-contains? asm "    movq $7, 16(%rbp)\n")
          (compiler-backend-string-contains? asm "    movq $8, 24(%rbp)\n")
          (not (compiler-backend-string-contains? asm "    pushq %r11\n"))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-direct-tail-call-mixed-slot
  [target : CompilerBackendTarget]) : String
  (if (compiler-backend-target-windows? target)
    ;; Win64 FPO rebases the outgoing mixed tail stack-arg store.
    "    movq %r10, 392(%rsp)\n"
    ;; FPO makes the Linux outgoing tail stack-arg store rsp-relative.
    "    movq %r10, 168(%rsp)\n"))

(define (compiler-backend-direct-tail-call-mixed-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-mixed-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_stepmixed")]
        (and
          (compiler-backend-string-contains? body "    jmp _tl_finishmixed\n")
          (not
            (compiler-backend-string-contains?
              body
              "    call _tl_finishmixed\n"))
          (not (compiler-backend-string-contains? body "    subq $8, %rsp\n"))
          (compiler-backend-string-contains?
            body
            (compiler-backend-direct-tail-call-mixed-slot target))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-direct-tail-call-ok?) : bool
  (and
    (backend-and8
      (compiler-backend-direct-tail-call-target-ok?
        (CompilerBackendTarget.Linux))
      (compiler-backend-direct-tail-call-target-ok?
        (CompilerBackendTarget.Windows))
      (compiler-backend-direct-tail-call-stack-target-ok?
        (CompilerBackendTarget.Linux))
      (compiler-backend-direct-tail-call-stack-target-ok?
        (CompilerBackendTarget.Windows))
      (compiler-backend-direct-tail-immediate-stack-target-ok?
        (CompilerBackendTarget.Linux))
      (compiler-backend-direct-tail-immediate-stack-target-ok?
        (CompilerBackendTarget.Windows))
      (compiler-backend-direct-tail-call-mixed-target-ok?
        (CompilerBackendTarget.Linux))
      (compiler-backend-direct-tail-call-mixed-target-ok?
        (CompilerBackendTarget.Windows)))
    (backend-and8
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-reordered-source)
        (CompilerBackendTarget.Linux)
        "8(%rsp)"
        "0(%rsp)")
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-reordered-source)
        (CompilerBackendTarget.Windows)
        "40(%rsp)"
        "32(%rsp)")
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-duplicated-source)
        (CompilerBackendTarget.Linux)
        "8(%rsp)"
        "")
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-duplicated-source)
        (CompilerBackendTarget.Windows)
        "40(%rsp)"
        "")
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-nontrivial-source)
        (CompilerBackendTarget.Linux)
        "40(%rsp)"
        "32(%rsp)")
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-nontrivial-source)
        (CompilerBackendTarget.Windows)
        "72(%rsp)"
        "64(%rsp)")
      (compiler-backend-direct-tail-call-f64-keeps-spills?
        (CompilerBackendTarget.Linux)
        "8(%rsp)"
        "0(%rsp)")
      (compiler-backend-direct-tail-call-f64-keeps-spills?
        (CompilerBackendTarget.Windows)
        "40(%rsp)"
        "32(%rsp)"))))

(define (compiler-backend-indirect-tail-call-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-indirect-tail-call-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_step")]
        (and
          (compiler-backend-string-contains? body "    jmp *(%r10)\n")
          (not (compiler-backend-string-contains? body "    jmp *%rax\n"))
          (not (compiler-backend-string-contains? body "    jmp *(%r11)\n"))
          (not
            (compiler-backend-string-contains? body "    movq (%r10), %rax\n"))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-indirect-tail-call-stack-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-indirect-tail-call-stack-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_step6")]
        (and
          (compiler-backend-string-contains? body "    call *(%r10)\n")
          (not (compiler-backend-string-contains? body "    jmp *(%r10)\n"))
          (not (compiler-backend-string-contains? body "    call *%rax\n"))
          (not (compiler-backend-string-contains? body "    call *(%r11)\n"))
          (not
            (compiler-backend-string-contains? body "    movq (%r10), %rax\n"))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-indirect-tail-call-r11-callee-asm
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (let
    [prev-starts : (Array i64) compiler-backend-scavenge-ctx-starts]
    [prev-ends : (Array i64) compiler-backend-scavenge-ctx-ends]
    [prev-assignment-index : CompilerRegAssignmentIndex
      compiler-backend-scavenge-ctx-assignment-index]
    [prev-plan-mask : i64 compiler-backend-scavenge-ctx-plan-reg-mask]
    [prev-occupied-masks : (Array i64)
      compiler-backend-scavenge-ctx-occupied-masks]
    [prev-vars : i64 compiler-backend-scavenge-ctx-vars]
    [prev-post-base : i64 compiler-backend-emit-instr-post-base]
    [prev-current-count : i64 compiler-backend-emit-current-count]
    [callee-ty : AstType (ast-ty-func (ast-type-list-new) (AstType.I64))]
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r11"))
        CompilerRegAssignmentList.Nil)]
    [types : CompilerRegVarTypeList
      (compiler-reg-var-type-cons
        (CompilerRegVarType.Type 0 callee-ty)
        CompilerRegVarTypeList.Nil)]
    [instrs : CompilerIrInstrList
      (compiler-ir-instr-cons
        (CompilerIrInstr.TailCallIndirect
          (CompilerIrValue.Var 0)
          (CompilerIrCallArgs.Nil)
          (AstType.I64))
        CompilerIrInstrList.Nil)]
    [blocks : CompilerIrBlockList
      (compiler-ir-block-cons
        (compiler-ir-block "entry" instrs)
        CompilerIrBlockList.Nil)]
    [_ctx : unit
      (begin
        (compiler-backend-test-scavenge-install-ctx!
          "indirect_tail_call_r11_callee_shape"
          CompilerIrParamList.Nil
          (AstType.I64)
          1
          blocks
          assignments)
        (set! compiler-backend-emit-instr-post-base 1)
        (set! compiler-backend-emit-current-count 1))]
    [result : ResultCompilerBackend
      (compiler-backend-emit-tail-indirect-call
        target
        (ci.intern "indirect_tail_call_r11_callee_shape")
        blocks
        (CompilerIrValue.Var 0)
        (CompilerIrCallArgs.Nil)
        (AstType.I64)
        assignments
        ""
        ""
        types
        1
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)
        (compiler-diagnostic-at-start "" ""))]
    [_restore : unit
      (begin
        (compiler-backend-set-scavenge-ctx-ready!
          prev-starts
          prev-ends
          prev-assignment-index
          prev-plan-mask
          prev-occupied-masks
          prev-vars)
        (set! compiler-backend-emit-instr-post-base prev-post-base)
        (set! compiler-backend-emit-current-count prev-current-count))]
    result))

(define (compiler-backend-indirect-tail-call-r11-callee-target-ok?
  [target : CompilerBackendTarget]) : bool
