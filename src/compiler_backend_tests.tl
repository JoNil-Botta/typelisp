    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-shuffle-asm-function-body
  [src : String]
  [lower-mode : compiler_lower.CompilerLowerMode]
  [backend-mode : compiler_backend.CompilerBackendMode]) : String
  (match (compiler_lower.lower-compiler-source-with-mode src lower-mode)
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        backend-mode
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (compiler-backend-asm-function-body asm "_tl_f")]
        [(compiler_backend.ResultCompilerBackend.Err _) ""])]
    [(compiler_lower.ResultCompilerLower.Err _) ""]))

(define (compiler-backend-identity-shuffle-eliminated?
  [src : String]
  [lower-mode : compiler_lower.CompilerLowerMode]
  [backend-mode : compiler_backend.CompilerBackendMode]
  [loop-label : String]) : bool
  (let
    [body : String
      (compiler-backend-shuffle-asm-function-body src lower-mode backend-mode)]
    (and
      (compiler_backend.compiler-backend-string-contains? body loop-label)
      (not
        (compiler_backend.compiler-backend-string-contains?
          body
          "vector_shuffle_"))
      (not (compiler_backend.compiler-backend-string-contains? body "vpermd"))
      (not (compiler_backend.compiler-backend-string-contains? body "vpermq")))))

(define (compiler-backend-varying-shuffle-vector-check?
  [src : String]
  [lower-mode : compiler_lower.CompilerLowerMode]
  [backend-mode : compiler_backend.CompilerBackendMode]
  [opcode : String]
  [compare-op : String]
  [reduce-op : String]
  [extra : String]) : bool
  (let
    [body : String
      (compiler-backend-shuffle-asm-function-body src lower-mode backend-mode)]
    (compiler_backend.backend-and8
      (compiler_backend.compiler-backend-string-contains? body opcode)
      (compiler_backend.compiler-backend-string-contains? body compare-op)
      (compiler_backend.compiler-backend-string-contains? body reduce-op)
      (compiler_backend.compiler-backend-string-contains? body extra)
      (compiler_backend.compiler-backend-string-contains?
        body
        "    call tl_oob_abort")
      (compiler_backend.compiler-backend-string-contains?
        body
        "vector_shuffle_")
      (not (compiler_backend.compiler-backend-string-contains? body "_skip_"))
      (> (string.string-length body) 0))))

(define (compiler-backend-shuffle-vector-check-reduction-ok?) : bool
  (let
    [avx2 : String
      (compiler_backend.compiler-backend-shuffle-vector-check-asm
        false
        2
        32
        "%r10"
        "%r11"
        ".L_abort")]
    [avx512 : String
      (compiler_backend.compiler-backend-shuffle-vector-check-asm
        true
        2
        64
        "%r10"
        "%r11"
        ".L_abort")]
    (and
      (compiler_backend.backend-and8
        (= (compiler_backend.compiler-backend-string-count avx2 "vpcmpgtq") 2)
        (= (compiler_backend.compiler-backend-string-count avx2 "vpmovmskb") 4)
        (=
          (compiler_backend.compiler-backend-string-count
            avx2
            "    jne .L_abort\n")
          1)
        (= (compiler_backend.compiler-backend-string-count avx2 "    testl ") 1)
        (not
          (compiler_backend.compiler-backend-string-contains? avx2 "    cmpq "))
        (=
          (compiler_backend.compiler-backend-string-count avx512 "vpcmpuq $6")
          2)
        (= (compiler_backend.compiler-backend-string-count avx512 "kmovw") 2)
        (=
          (compiler_backend.compiler-backend-string-count
            avx512
            "    jne .L_abort\n")
          1))
      (= (compiler_backend.compiler-backend-string-count avx512 "    testl ") 1))))

(define (compiler-backend-vector-shuffle-ok?) : bool
  (and
    (compiler-backend-identity-shuffle-eliminated?
      "(define (f [xs : (Array i64)] [out : (Array i64)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (program-index)))))"
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "foreach_avx2_body")
    (compiler-backend-identity-shuffle-eliminated?
      "(define (f [xs : (Array i32)] [out : (Array i32)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (program-index)))))"
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "foreach_avx2_body")
    (compiler-backend-identity-shuffle-eliminated?
      "(define (f [xs : (Array f64)] [out : (Array f64)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (program-index)))))"
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      "foreach_avx2_body")
    (compiler-backend-identity-shuffle-eliminated?
      "(define (f [xs : (Array f32)] [out : (Array f32)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (program-index)))))"
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      "foreach_avx2_body")
    (compiler-backend-varying-shuffle-vector-check?
      "(define (f [xs : (Array i64)] [selectors : (Array i64)] [out : (Array i64)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (array-ref selectors i)))))"
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "    vpermd "
      "    vpcmpgtq "
      "    vpmovmskb "
      "    shll $1, ")
    (compiler-backend-varying-shuffle-vector-check?
      "(define (f [xs : (Array i32)] [selectors : (Array i64)] [out : (Array i32)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (array-ref selectors i)))))"
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "    vpermd "
      "    vpcmpgtq "
      "    vpmovmskb "
      "%rsp), %ymm0, %ymm")
    (compiler-backend-varying-shuffle-vector-check?
      "(define (f [xs : (Array f64)] [selectors : (Array i64)] [out : (Array f64)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (array-ref selectors i)))))"
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      "    vpermq "
      "    vpcmpuq $6, "
      "    kmovw "
      "%zmm")
    (compiler-backend-varying-shuffle-vector-check?
      "(define (f [xs : (Array f32)] [selectors : (Array i64)] [out : (Array f32)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (array-ref selectors i)))))"
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      "    vpermd "
      "    vpcmpuq $6, "
      "    kmovw "
      "%zmm")
    (compiler-backend-shuffle-vector-check-reduction-ok?)))

(define (compiler-backend-avx2-vector-reduce-ok?) : bool
  (and
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64]) : i64 (spmd-reduce sum ([i : i64 0 n]) 0 (array-ref xs i)))"
      "    vpaddq "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i32)] [n : i64]) : i32 (spmd-reduce sum ([i : i64 0 n]) (cast 0 : i32) (array-ref xs i)))"
      "    vpaddd "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i32)] [n : i64] [seed : i32]) : i32 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpminsd "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i32)] [n : i64] [seed : i32]) : i32 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpmaxsd "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array f64)] [n : i64]) : f64 (spmd-reduce sum ([i : i64 0 n]) 0.0 (array-ref xs i)))"
      "    vaddpd "
      "    vextractf128 $1, "
      "    vaddsd "
      "    movsd %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array f32)] [n : i64]) : f32 (spmd-reduce sum ([i : i64 0 n]) (cast 0.0 : f32) (array-ref xs i)))"
      "    vaddps "
      "    vextractf128 $1, "
      "    vaddss "
      "    movss %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpcmpgtq "
      "    vextracti128 $1, "
      "    vpblendvb "
      "    vmovq %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpcmpgtq "
      "    vextracti128 $1, "
      "    vpblendvb "
      "    vmovq %xmm2, ")
    (compiler-backend-bool-reduce-asm-contains?
      "(define (f [xs : (Array bool)] [n : i64]) : bool (spmd-reduce all ([i : i64 0 n]) true (array-ref xs i)))"
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "    vpmovmskb "
      "    sete %al\n"
      "%ymm")
    (compiler-backend-bool-reduce-asm-contains?
      "(define (f [xs : (Array bool)] [n : i64]) : bool (spmd-reduce any ([i : i64 0 n]) false (array-ref xs i)))"
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "    vpmovmskb "
      "    setne %al\n"
      "%ymm")))

(define (compiler-backend-avx512-reduce-asm-contains?
  [src : String]
  [op : String]
  [extract : String]
  [horizontal : String]
  [store : String]) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    src
    (compiler_lower.CompilerLowerMode.Avx512))
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        (compiler_backend.CompilerBackendMode.Avx512)
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.backend-and8
              (compiler_backend.compiler-backend-string-contains? asm extract)
              (compiler_backend.compiler-backend-string-contains?
                asm
                horizontal)
              (compiler_backend.compiler-backend-string-contains? asm op)
              (compiler_backend.compiler-backend-string-contains? asm store)
              (compiler_backend.compiler-backend-string-contains? asm "%zmm")
              (compiler_backend.compiler-backend-string-contains? asm "%ymm")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "spmd_reduce_avx2")
              true)
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "vector/mask IR emission is not implemented")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-avx512-vector-reduce-i64-minmax-ok?) : bool
  (and
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpminsq "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpmaxsq "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")))

(define (compiler-backend-avx512-vector-reduce-ok?) : bool
  (and
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array i64)] [n : i64]) : i64 (spmd-reduce sum ([i : i64 0 n]) 0 (array-ref xs i)))"
      "    vpaddq "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array i32)] [n : i64]) : i32 (spmd-reduce sum ([i : i64 0 n]) (cast 0 : i32) (array-ref xs i)))"
      "    vpaddd "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array i32)] [n : i64] [seed : i32]) : i32 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpminsd "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array i32)] [n : i64] [seed : i32]) : i32 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpmaxsd "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array f64)] [n : i64]) : f64 (spmd-reduce sum ([i : i64 0 n]) 0.0 (array-ref xs i)))"
      "    vaddpd "
      "    vextractf64x4 $1, "
      "    vaddsd "
      "    movsd %xmm2, ")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (f [xs : (Array f32)] [n : i64]) : f32 (spmd-reduce sum ([i : i64 0 n]) (cast 0.0 : f32) (array-ref xs i)))"
      "    vaddps "
      "    vextractf32x8 $1, "
      "    vaddss "
      "    movss %xmm2, ")
    (compiler-backend-avx512-vector-reduce-i64-minmax-ok?)))

(define (compiler-backend-avx512-bool-vector-reduce-ok?) : bool
  (and
    (compiler-backend-bool-reduce-asm-contains?
      "(define (f [xs : (Array bool)] [n : i64]) : bool (spmd-reduce all ([i : i64 0 n]) true (array-ref xs i)))"
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      "    kortestq "
      "    setc %al\n"
      "%k")
    (compiler-backend-bool-reduce-asm-contains?
      "(define (f [xs : (Array bool)] [n : i64]) : bool (spmd-reduce any ([i : i64 0 n]) false (array-ref xs i)))"
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      "    kortestq "
      "    setne %al\n"
      "%k")))

(define (compiler-backend-vector-reduce-direct-assignments
  [dst-location : compiler_regalloc.CompilerRegLocation]) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 6)))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment 1 dst-location)
      (compiler_regalloc.compiler-reg-assignment-table-empty))))

(define (compiler-backend-avx512-vector-reduce-narrow-case-ok?
  [elem-ty : compiler_ast_types.AstType]
  [lanes : i64]
  [mnemonic : String]
  [last-shift : String]) : bool
  (match (compiler_backend.compiler-backend-emit-avx512-vector-reduce
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-reduce-direct-assignments
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r10))
    1
    (compiler_ir_types.CompilerIrVectorReduceOp.Min)
    (compiler_ir_types.CompilerIrValue.Var 0)
    lanes
    elem-ty
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" "")
    (compiler_backend.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vextracti64x4 $1, %zmm6, %ymm2\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vextracti128 $1, %ymm2, %xmm3\n")
        (compiler_backend.compiler-backend-string-contains? asm mnemonic)
        (compiler_backend.compiler-backend-string-contains? asm last-shift)
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vmovq %xmm2, ")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "unsupported AVX-512 vector reduction")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-vector-reduce-narrow-ok?) : bool
  (and
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (compiler_ast_types.AstType.I16)
      32
      "    vpminsw "
      "    vpsrldq $2, ")
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (compiler_ast_types.AstType.U16)
      32
      "    vpminuw "
      "    vpsrldq $2, ")
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (compiler_ast_types.AstType.I8)
      64
      "    vpminsb "
      "    vpsrldq $1, ")
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (compiler_ast_types.AstType.U8)
      64
      "    vpminub "
      "    vpsrldq $1, ")))

(define (compiler-backend-avx2-vector-reduce-direct-stack-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-avx2-vector-reduce
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-reduce-direct-assignments
      (compiler_regalloc.CompilerRegLocation.Spill -40))
    1
    (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
    (compiler_ir_types.CompilerIrValue.Var 0)
    4
    (compiler_ast_types.AstType.I64)
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" "")
    (compiler_backend.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vextracti128 $1, %ymm6, %xmm2\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vmovq %xmm2, -40(%rbp)\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "%xmm0"))
        (not (compiler_backend.compiler-backend-string-contains? asm "%xmm1"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    vmovq %xmm0, %rax\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rax, -40(%rbp)\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx2-vector-reduce-direct-register-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-avx2-vector-reduce
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-reduce-direct-assignments
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r12))
    1
    (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
    (compiler_ir_types.CompilerIrValue.Var 0)
    4
    (compiler_ast_types.AstType.I64)
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" "")
    (compiler_backend.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vextracti128 $1, %ymm6, %xmm2\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vmovq %xmm2, %r12\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "%xmm0"))
        (not (compiler_backend.compiler-backend-string-contains? asm "%xmm1"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    vmovq %xmm0, %rax\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
