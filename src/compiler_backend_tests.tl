        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has "    movslq %r12d, %r8\n" "    movq %r8, -16(%rbp)\n")
    (lacks "%rax")))

(define (compiler-backend-bitcast-shape-ok?) : bool
  (and
    (be_state.backend-and4
      (compiler-backend-instr-contains?
        (irt.instr "%6 = bitcast %5 : f32 to u64")
        "    movd %xmm2, %r8d\n")
      (compiler-backend-instr-contains?
        (irt.instr "%6 = bitcast %5 : u64 to f32")
        "    movd %r8d, %xmm2\n")
      (compiler-backend-instr-contains?
        (irt.instr "%6 = bitcast %5 : f64 to u64")
        "    movq %xmm2, %r8\n")
      (compiler-backend-instr-contains?
        (irt.instr "%6 = bitcast %5 : u64 to f64")
        "    movq %r8, %xmm2\n"))
    (not
      (compiler-backend-instr-contains?
        (irt.instr "%6 = bitcast %5 : f64 to f32")
        "unsupported bitcast"))))

(define (compiler-backend-direct-bitcast-asm
  [from-ty : ast.AstType]
  [to-ty : ast.AstType]
  [src-home : i64]
  [dst-home : i64]) : be_state.ResultCompilerBackend
  (be_scalar.compiler-backend-emit-bitcast
    (ast.ast-node-pool-reader-type-segment-bases)
    (regalloc.compiler-reg-assignments-prepend
      (& (regalloc.CompilerRegAssignment 0 (Register src-home)))
      (regalloc.compiler-reg-assignments-prepend
        (& (regalloc.CompilerRegAssignment 1 (Register dst-home)))
        (regalloc.compiler-reg-assignment-table-empty)))
    1
    (Var 0)
    from-ty
    to-ty
    (compiler-backend-program-index-build
      (ast.ast-node-pool-reader-type-segment-bases)
      (ir.compiler-ir-function-seq-empty)
      (ir.compiler-ir-extern-seq-empty))
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active))))

(define (compiler-backend-direct-bitcast-home-ok?) : bool
  (match (compiler-backend-direct-bitcast-asm
    (F32)
    (U64)
    (cabi.compiler-abi-xmm-register-id 2)
    cabi.compiler-reg-id-r12)
    [(Ok f32-to-int)
      (match (compiler-backend-direct-bitcast-asm
        (F64)
        (U64)
        (cabi.compiler-abi-xmm-register-id 2)
        cabi.compiler-reg-id-r12)
        [(Ok f64-to-int)
          (match (compiler-backend-direct-bitcast-asm
            (U64)
            (F32)
            cabi.compiler-reg-id-r12
            (cabi.compiler-abi-xmm-register-id 2))
            [(Ok int-to-f32)
              (match (compiler-backend-direct-bitcast-asm
                (U64)
                (F64)
                cabi.compiler-reg-id-r12
                (cabi.compiler-abi-xmm-register-id 2))
                [(Ok int-to-f64)
                  (and
                    (be_state.backend-and4
                      (asm-has? f32-to-int "    movd %xmm2, %r12d\n")
                      (asm-has? f64-to-int "    movq %xmm2, %r12\n")
                      (asm-has? int-to-f32 "    movd %r12d, %xmm2\n")
                      (asm-has? int-to-f64 "    movq %r12, %xmm2\n"))
                    (asm-lacks? f32-to-int "%rax")
                    (asm-lacks? f64-to-int "%rax")
                    (asm-lacks? int-to-f32 "%rax")
                    (asm-lacks? int-to-f64 "%rax")
                    (asm-lacks? f32-to-int "%xmm0")
                    (asm-lacks? f64-to-int "%xmm0")
                    (asm-lacks? int-to-f32 "%xmm0")
                    (asm-lacks? int-to-f64 "%xmm0"))]
                [(Err _) false])]
            [(Err _) false])]
        [(Err _) false])]
    [(Err _) false]))

