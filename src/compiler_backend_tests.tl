(define (compiler-backend-program-argv-entry-capture-source) : String
  "(extern (fixture-strlen [arg0 : (Ptr u8)]) : i64 (:symbol \"strlen\"))
(define (main) : i64
  (let
    [argv : (Ptr (Ptr u8)) (unsafe (program-argv))]
    [raw : (Ptr u8) (unsafe (ptr-read (ptr-offset argv 1)))]
    (fixture-strlen raw)))")

(define (compiler-backend-program-argv-entry-capture-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-program-argv-entry-capture-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (asm-has? asm "_tl_start:\n")
          (asm-has? asm "    movq (%rsp), %rax\n")
          (asm-has? asm "    movq %rax, .L_tl_argc(%rip)\n")
          (asm-has? asm "    leaq 8(%rsp), %rax\n")
          (asm-has? asm "    movq %rax, .L_tl_argv(%rip)\n")
          (asm-has? asm "    call strlen\n")
          (asm-lacks? asm ".L_tl_arg_count:\n")
          (asm-lacks? asm ".L_tl_arg:\n"))
        (asm-has?
          asm
          "    movq %rax, .L_tl_argc(%rip)\n    leaq 16(%rsp,%rax,8), %rax\n"))]
    [(Err _) false]))

(define (compiler-backend-arg-runtime-source) : String
  "(extern (runtime-arg [arg0 : i64]) : String (:symbol \".L_tl_arg\"))
(define (io.arg [index : i64]) : String
  (runtime-arg index))
(define (main) : i64
  (__tl_string_length (io.arg 0)))")

(define (compiler-backend-arg-runtime-abort-ok?) : bool
  (and
    (match (backend.compiler-backend-emit-source-for-target
      (compiler-backend-arg-runtime-source)
      (be_state.CompilerBackendTarget.Linux))
      [(Ok asm)
        (and
          (be_state.backend-and8
            (asm-has? asm ".extern _u2eL_tl_arg\n")
            (asm-has? asm "    call _u2eL_tl_arg\n")
            (asm-lacks? asm ".L_tl_arg:\n")
            (asm-lacks? asm ".L_tl_abort:\n")
            (asm-lacks? asm ".L_tl_arg_oob_msg:\n")
            (asm-lacks? asm "    call .L_tl_abort\n")
            (asm-lacks? asm "tl_alloc:\n")
            (asm-has? asm ".L_tl_argc:\n"))
          (asm-has? asm ".L_tl_argv:\n")
          (asm-lacks? asm ".extern .L_tl_abort\n"))]
      [(Err _) false])
    (match (backend.compiler-backend-emit-source-for-target
      (compiler-backend-arg-runtime-source)
      (be_state.CompilerBackendTarget.Windows))
      [(Ok asm)
        (be_state.backend-and8
          (asm-has? asm ".extern _u2eL_tl_arg\n")
          (asm-has? asm "    call _u2eL_tl_arg\n")
          (asm-lacks? asm ".L_tl_arg:\n")
          (asm-lacks? asm ".L_tl_abort:\n")
          (asm-lacks? asm ".L_tl_arg_oob_msg:\n")
          (asm-lacks? asm "    call .L_tl_abort\n")
          (asm-lacks? asm "    .extern _write\n")
          (asm-lacks? asm ".extern .L_tl_abort\n"))]
      [(Err _) false])))

;; Backend-owned replacement for the Rust `string.string-ref` emit-shape checks:
;; source-level string indexing should keep literal string data, use an
;; unsigned bounds check, call the out-of-bounds helper, and zero-extend the
;; selected byte into the char result.
(define (compiler-backend-string-ref-source) : String
  "(define sample : String \"az\")
(define (pick [i : i64]) : char (__tl_string_ref sample i))
(define (main) : i64 0)")

(define (compiler-backend-string-ref-shape-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-string-ref-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (asm-has? asm ".L_tl_str_data_l2_12961_16211:")
          (asm-lacks? asm ".L_tl_str_l2_12961_16211:")
          (asm-has? asm "    .ascii \"az\"\n")
          (asm-has? asm "    .quad .L_tl_str_data_l2_12961_16211\n")
          (asm-lacks? asm "    cmpq %r11, %rax\n")
          ;; COLD-1: the passing check falls through; the abort stub is
          ;; out of line at the end of the function.
          (asm-has?
            asm
            "    jae .Lf0_str_bounds_ok.0.cold\n.Lf0_str_bounds_ok.0:\n")
          (asm-has? asm "    call .L_tl_abort_tl_oob_abort_at\n")
          (asm-lacks? asm "tl_oob_abort:\n"))
        (be_state.backend-and4
          (asm-has? asm "    .quad 2\n")
          (asm-has? asm "movzbl")
          (asm-lacks? asm "movsbq (%r10)")
          true)
        (asm-lacks? asm "    movq 8(%r10), %rax\n" "    jge .Lf0_str_bounds_ok")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-aggregate-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-aggregate-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          ;; sret ABI: aggregate returns write the caller's sret slot
          ;; instead of arena-allocating a 16-byte object.
          (not (compiler-backend-string-contains-alloc-size? asm 16))
          (and
            (asm-has? asm "_tl___enum_obj_Shape_Nothing:\n")
            (asm-lacks? asm ".globl _tl___enum_obj_Shape_Nothing\n"))
          (asm-has? asm "    movq $1, (%r10)\n")
          (asm-has? asm "    movq $2, (%r10)\n")
          (asm-lacks? asm "    call _tl_Point\n")
          (asm-lacks? asm "    call _tl_Nothing\n")
          (asm-lacks? asm "    call _tl_Circle\n")
          (asm-lacks? asm "    call _tl_Pair\n"))
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-pack-immediate-word-shape-ok?) : bool
  (match (be_scalar.compiler-backend-emit-pack-words
    (ast.ast-node-pool-reader-type-segment-bases)
    (regalloc.compiler-reg-assignment-table-empty)
    (& (I64 7))
    (& (Bool true))
    "-16(%rbp)"
    "-24(%rbp)"
    false
    false
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok stack-asm)
      (match (be_scalar.compiler-backend-emit-pack-words
        (ast.ast-node-pool-reader-type-segment-bases)
        (regalloc.compiler-reg-assignment-table-empty)
        (& (I64 9))
        (& (Char 'A'))
        "%r12"
        "%r13"
        false
        false
        (cdiag.compiler-diagnostic-at-start "" "")
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok reg-asm)
          (and
            (asm-has?
              stack-asm
              "    movq $7, -16(%rbp)\n"
              "    movq $1, -24(%rbp)\n")
            (asm-has? reg-asm "    movl $9, %r12d\n" "    movl $65, %r13d\n")
            (asm-lacks? stack-asm "%rax" "%rdx")
            (asm-lacks? reg-asm "%rax" "%rdx"))]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-pack-word-shape-ok?
  [assignments : regalloc.CompilerRegAssignmentTable]
  [dst0 : String]
  [sse? : bool]
  [expected : String]) : bool
  (match (be_scalar.compiler-backend-emit-pack-words
    (ast.ast-node-pool-reader-type-segment-bases)
    assignments
    (& (Var 0))
    (& (Var 1))
    dst0
    "-24(%rbp)"
    sse?
    sse?
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm) (string.eq asm expected)]
    [(Err _) false]))

(define (compiler-backend-pack-scavenged-word-shape-ok?) : bool
  (let
    [gp-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%r13")]
    [xmm-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%xmm3 %1=%xmm4")]
    (and
      (compiler-backend-pack-word-shape-ok?
        gp-assignments
        "-16(%rbp)"
        false
        "    movq %r12, %r8\n    movq %r8, -16(%rbp)\n    movq %r13, -24(%rbp)\n")
      (compiler-backend-pack-word-shape-ok?
        xmm-assignments
        "-16(%rbp)"
        true
        "    movsd %xmm3, %xmm2\n    movsd %xmm2, -16(%rbp)\n    movsd %xmm4, -24(%rbp)\n")
      ;; Stage word one before word zero overwrites its source register.
      (compiler-backend-pack-word-shape-ok?
        gp-assignments
        "%r13"
        false
        "    movq %r12, %r8\n    movq %r13, %r9\n    movq %r8, %r13\n    movq %r9, -24(%rbp)\n")
      (compiler-backend-pack-word-shape-ok?
        xmm-assignments
        "%xmm4"
        true
        "    movsd %xmm3, %xmm2\n    movsd %xmm4, %xmm3\n    movsd %xmm2, %xmm4\n    movsd %xmm3, -24(%rbp)\n"))))

;; Backend-owned replacement for representative aggregate storage emit-shape
;; checks from the legacy backend suite.
(define (compiler-backend-aggregate-return-source) : String
  "(defenum Shape (Circle i64) (Square i64) (Nothing))
(defstruct Point (x i64) (y i64))
(define (mk-shape) : Shape (Circle 7))
(define (mk-point) : Point (Point 1 2))
(define (mk-string) : String \"hi\")
(define (main) : i64
  (let [point : Point (mk-point)]
    (+ (match (mk-shape) [(Circle r) r] [(Square s) s] [Nothing 0])
      (+ point.y (__tl_string_length (mk-string))))))")

(define (compiler-backend-aggregate-return-shape-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-aggregate-return-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          ;; sret ABI: struct/enum returns write the result through the
          ;; caller-provided sret slot -- no per-return arena allocation.
          (= (compiler-backend-alloc-call-count asm) 0)
          (not (compiler-backend-string-contains-alloc-size? asm 16))
          (asm-has? asm "movq $7,")
          (asm-has? asm "movq $1,")
          (asm-has? asm "movq $2,")
          (asm-has? asm ".L_tl_str_data_l2_13861_13991:")
          true
          true)
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-aggregate-global-init-source) : String
  "(defenum LocalMaybe (Some i64) (None))
(defstruct Pair (x i64) (y i64))
(defstruct Nested (label String) (choice LocalMaybe))
(define (string.concat [left : String] [right : String]) : String
  left)

(define greeting : String (string.concat \"he\" \"llo\"))
(define choice : LocalMaybe (Some 8))
(define pair : Pair (Pair 10 11))
(define cells : (__tl_dyn-array i64) (__tl_make-array i64 3))
(define nested : Nested (Nested (string.concat \"o\" \"k\") (Some 3)))

(define (main) : i64
  (+ (+ (+ (__tl_string_length greeting) (length cells))
        (+ pair.x pair.y))
     (+ (match choice [(Some n) n] [None 0])
        (+ (__tl_string_length nested.label)
           (match nested.choice [(Some n) n] [None 0])))))")

(define (compiler-backend-runtime-global-shape-ok?
  [asm : (& asm str)]
  [name : String]) : bool
  (let
    [symbol : String (str_cat.str-cat "_tl_" name)]
    [init-symbol : String (str_cat.str-cat "_tl___global_init_" name)]
    (and
      (be_state.backend-and4
        ;; A register-group global (e.g. `pair`) reserves 16 inline bytes; an
        ;; inline aggregate global (e.g. `nested`) reserves its own byte size;
        ;; an 8-byte handle/scalar global reserves 8. Accept any of them.
        (or
          (let
            [needle (str_cat.str-cat "    .comm " symbol ", 8, 8\n")]
            (asm-has? asm needle))
          (let
            [needle (str_cat.str-cat "    .comm " symbol ", 16, 8\n")]
            (asm-has? asm needle))
          (let
            [needle (str_cat.str-cat "    .comm " symbol ", 24, 8\n")]
            (asm-has? asm needle))
          (let
            [needle (str_cat.str-cat "    .comm " symbol ", 32, 8\n")]
            (asm-has? asm needle)))
        (let
          [needle (str_cat.str-cat "    call " init-symbol "\n")]
          (asm-has? asm needle))
        ;; The startup sequence installs the initializer result: a word store
        ;; for a word cell, or the inline cell passed as the hidden result
        ;; pointer for an inline aggregate.
        (or
          (let
            [needle (str_cat.str-cat "    movq %rax, " symbol "(%rip)\n")]
            (asm-has? asm needle))
          (let
            [needle
              (str_cat.str-cat
                "    leaq "
                symbol
                "(%rip), %rdi\n    call "
                init-symbol
                "\n")]
            (asm-has? asm needle)))
        (let
          [needle (str_cat.str-cat init-symbol ":\n" "")]
          (asm-has? asm needle)))
      (or
        (let
          [needle (str_cat.str-cat "    movq " symbol "(%rip), %rax\n")]
          (asm-has? asm needle))
        (let
          [needle (str_cat.str-cat "    movq " symbol "(%rip), %r10\n")]
          (asm-has? asm needle))
        ;; A register-group or inline aggregate global is read via its
        ;; address, or one field at a constant offset from it.
        (let
          [needle (str_cat.str-cat "    leaq " symbol "(%rip), %r" "")]
          (asm-has? asm needle))
        (let
          [needle (str_cat.str-cat "    movq " symbol "+" "")]
          (asm-has? asm needle))))))

(define (compiler-backend-aggregate-global-init-shape-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-aggregate-global-init-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (compiler-backend-runtime-global-shape-ok? asm "greeting")
          (compiler-backend-runtime-global-shape-ok? asm "choice")
          (compiler-backend-runtime-global-shape-ok? asm "pair")
          (compiler-backend-runtime-global-shape-ok? asm "cells")
          (compiler-backend-runtime-global-shape-ok? asm "nested")
          (asm-has? asm "_tl_start:\n")
          (asm-has?
            asm
            "    js .L_tl_main_stack_abort\n"
            ".ascii \"tl: main-stack reservation failed\\n\"\n"
            ".L_tl_main_stack_abort:\n    movq $1, %rax\n")
          (not
            (let
              [needle (compiler-backend-todo-marker)]
              (asm-has? asm needle))))
        true)]
    [(Err _) false]))

(define (compiler-backend-aggregate-storage-shape-ok?) : bool
  (and
    (compiler-backend-pack-scavenged-word-shape-ok?)
    (compiler-backend-aggregate-return-shape-ok?)
    (compiler-backend-aggregate-global-init-shape-ok?)))

;; Backend-owned replacement for closure/lambda emit-shape checks.
;; The source uses synthetic lambda lowered names because AstExpr.Lambda lowering
;; is tracked separately; this pins the backend descriptor, adapter, and
;; indirect-call shape produced by the same IR names.
(define (compiler-backend-closure-literal-source) : String
  "(define (__tl_lambda_main_0 [x : i64]) : i64 (+ x 1))
(define (main) : i64
  (let [f : (-> i64 i64) __tl_lambda_main_0]
    (f 41)))")

(define (compiler-backend-closure-inferred-source) : String
  "(define (__tl_lambda_main_0 [x : i64]) : i64
  (let [y : i64 (+ x 1)]
    y))
(define (main) : i64
  (let [f : (-> i64 i64) __tl_lambda_main_0]
    (f 41)))")

(define (compiler-backend-closure-aggregate-return-source) : String
  "(defenum Box (BoxI i64))
(defstruct Pair (x i64) (y i64))

(define (__tl_lambda_main_0) : String \"hello\")
(define (__tl_lambda_main_1) : Box (BoxI 11))
(define (__tl_lambda_main_2) : (__tl_dyn-array i64) (__tl_make-array i64 13))
(define (__tl_lambda_main_3) : Pair (Pair 1 13))

(define (main) : i64
  (let [mk-string : (-> String) __tl_lambda_main_0]
        [mk-enum : (-> Box) __tl_lambda_main_1]
        [mk-array : (-> (__tl_dyn-array i64)) __tl_lambda_main_2]
        [mk-struct : (-> Pair) __tl_lambda_main_3]
        [pair : Pair (mk-struct)]
    (+ (__tl_string_length (mk-string))
      (+ (match (mk-enum) [(BoxI n) n])
        (+ (array-length (mk-array)) pair.y)))))")

(define (compiler-backend-closure-literal-shape-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-closure-literal-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (asm-has? asm "_tl_f")
          (asm-has? asm ".L_tl_fn_desc___tl_lambda_main_0:\n")
          (asm-has? asm "    .quad .L_tl_fn_entry___tl_lambda_main_0\n")
          (asm-has? asm ".L_tl_fn_entry___tl_lambda_main_0:\n")
          (asm-has? asm "    call _tl_f")
          (asm-has? asm "    leaq .L_tl_fn_desc___tl_lambda_main_0(%rip), ")
          (compiler-backend-call-or-jmp-ok? asm "*(%r10)")
          (asm-lacks? asm "    movq (%r10), %rax\n"))
        (asm-has? asm "    movq 8(%r10), %rdi\n")
        (not (compiler-backend-call-or-jmp-ok? asm "*(%r11)"))
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-closure-inferred-shape-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-closure-inferred-source))
    [(Ok asm)
      (be_state.backend-and4
        (asm-has? asm "_tl_f")
        (asm-has? asm "    call _tl_f")
        (compiler-backend-call-or-jmp-ok? asm "*(%r10)")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-closure-aggregate-return-shape-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-closure-aggregate-return-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (>= (backend.compiler-backend-string-count asm ".globl _tl_f") 4)
          (asm-has? asm "_tl_f")
          (asm-has? asm "    call _tl_f")
          (asm-has? asm "main:\n")
          (asm-has? asm ".L_tl_fn_desc___tl_lambda_main_0:\n")
          (asm-has? asm ".L_tl_fn_desc___tl_lambda_main_1:\n")
          (asm-has? asm ".L_tl_fn_desc___tl_lambda_main_2:\n")
          (asm-has? asm ".L_tl_fn_desc___tl_lambda_main_3:\n"))
        (be_state.backend-and8
          (asm-has? asm ".L_tl_fn_entry___tl_lambda_main_0:\n")
          (asm-has? asm ".L_tl_fn_entry___tl_lambda_main_1:\n")
          (asm-has? asm ".L_tl_fn_entry___tl_lambda_main_2:\n")
          (asm-has? asm ".L_tl_fn_entry___tl_lambda_main_3:\n")
          (asm-has? asm "    .quad .L_tl_fn_entry___tl_lambda_main_0\n")
          (asm-has? asm "    .quad .L_tl_fn_entry___tl_lambda_main_1\n")
          (asm-has? asm "    .quad .L_tl_fn_entry___tl_lambda_main_2\n")
          (asm-has? asm "    .quad .L_tl_fn_entry___tl_lambda_main_3\n"))
        (be_state.backend-and8
          (asm-has? asm "tl_alloc:\n")
          ;; sret ABI: only the heap-backed (Array) closure return
          ;; still allocates; Box/Pair/String returns use sret/static data.
          (>= (compiler-backend-alloc-call-count asm) 1)
          (>=
            (+
              (backend.compiler-backend-string-count asm "    call *(%r10)\n")
              (backend.compiler-backend-string-count asm "    jmp *(%r10)\n"))
            4)
          (and
            (asm-lacks? asm "    movq (%r10), %rax\n")
            (=
              (+
                (backend.compiler-backend-string-count asm "    call *(%r11)\n")
                (backend.compiler-backend-string-count asm "    jmp *(%r11)\n"))
              0))
          (not
            (let
              [needle (compiler-backend-todo-marker)]
              (asm-has? asm needle)))
          true
          true
          true)
        true)]
    [(Err _) false]))

(define (compiler-backend-closure-debug-cfi-balanced-ok?) : bool
  (let
    [previous : bool (ir.compiler-debug-info-enabled?)]
    [result : be_state.ResultCompilerBackend
      (begin
        (ir.compiler-debug-info-set-enabled! true)
        (backend.compiler-backend-emit-source
          (compiler-backend-closure-literal-source)))]
    (ir.compiler-debug-info-set-enabled! previous)
    (match result
      [(Ok asm)
        (and
          (> (backend.compiler-backend-string-count asm ".cfi_startproc") 1)
          (=
            (backend.compiler-backend-string-count asm ".cfi_startproc")
            (backend.compiler-backend-string-count asm ".cfi_endproc")))]
      [(Err _) false])))

(define (compiler-backend-closure-emit-shape-ok?) : bool
  (and
    (compiler-backend-closure-literal-shape-ok?)
    (compiler-backend-closure-inferred-shape-ok?)
    (compiler-backend-closure-aggregate-return-shape-ok?)
    (compiler-backend-closure-debug-cfi-balanced-ok?)))

(define (compiler-backend-enum-match-ok?) : bool
  ;; `Maybe (None) (Some i64)` is a 16-byte register-resident enum, so the
  ;; tag is matched on a register-held word (no `cmpq $0, (%r10)` heap deref) and
  ;; the payload is read from word1 rather than `8(%r10)`. Those memory-shape
  ;; assertions are obsolete; what remains representation-agnostic is that the
  ;; match lowers to comparison arms and neither variant is built via a runtime
  ;; constructor call (None is an immediate tag, Some is an CompilerIrInstr.Pack).
  (match (backend.compiler-backend-emit-source
    (compiler-backend-enum-match-source))
    [(Ok asm)
      (be_state.backend-and4
        (or (asm-has? asm "_tl_score") (asm-has? asm "_tl_f"))
        (asm-has? asm "_match_arm.")
        (asm-lacks? asm "    call _tl_None\n")
        (asm-lacks? asm "    call _tl_Some\n"))]
    [(Err _) false]))

(define (compiler-backend-never-branch-register-group-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-source
      (compiler-backend-never-branch-register-group-source))
    (has "main:\n")
    (lacks "register-group")))

;; Scalar backend emission intentionally uses the stack-only plan by default for
;; cold compile speed; allocator behavior is still covered in compiler_regalloc.tl
;; and by AVX/vector backend smoke paths.
(define (compiler-backend-regalloc-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-regalloc-source))
    [(Ok asm)
      (be_state.backend-and8
        (or (asm-has? asm "_tl_calc") (asm-has? asm "_tl_f"))
        ;; FPO (M-G3 stage 2) makes frame refs rsp-relative; T1-6 (a) puts
        ;; this call-free leaf's frame in the red zone. Parameter identities
        ;; stay pinned at -8/-16; expression snapshots may change the colored
        ;; temporary offsets and whether multiplication folds a memory operand.
        (asm-has? asm "    movq %rdi, -8(%rsp)\n")
        (asm-has? asm "    movq %rsi, -16(%rsp)\n")
        (asm-has? asm "    movq %r8, -24(%rsp)\n")
        (asm-has? asm "    imulq ")
        (asm-lacks? asm "    movq %r12, -")
        true
        true)]
    [(Err _) false]))

(define (compiler-backend-regalloc-f64-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-regalloc-f64-source))
    [(Ok asm)
      (be_state.backend-and8
        ;; T1-6 (a) red-zone frame slots. Without scalar-register web
        ;; coalescing, the stack-only path keeps the two copied operands at
        ;; -16/-24. The left operand needs no snapshot (the right operand
        ;; cannot write it), so the sum reads -16 directly into -8.
        (asm-has? asm "main:\n")
        (asm-has? asm "    movsd -16(%rsp), %xmm2\n")
        (asm-has? asm "    addsd -24(%rsp), %xmm2\n")
        (asm-has? asm "    movsd %xmm2, -8(%rsp)\n")
        (asm-has? asm "    movsd -8(%rsp), %xmm0\n")
        (asm-lacks? asm "    addsd %xmm1, %xmm0\n")
        (asm-lacks? asm "    movsd -16(%rsp), %xmm0\n")
        (not
          (let
            [text (compiler-backend-asm-function-body asm "main")]
            (asm-has? text "%xmm3"))))]
    [(Err _) false]))

(define (compiler-backend-test-global-builder-push!
  [builder : (&mut builder ir.CompilerIrGlobalBuilder)]
  [name : String]
  [ty : ast.AstType]
  [value : ir.CompilerIrValue]) : unit
  (ir.compiler-ir-global-builder-push!
    builder
    (ir.CompilerIrGlobal.Global
      (ci.intern name)
      ty
      value
      (ir.CompilerIrGlobalStorage.Word))))

(define (compiler-backend-test-global-seq-single
  [name : String]
  [ty : ast.AstType]
  [value : ir.CompilerIrValue]) : ir.CompilerIrGlobalSeq
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 1)]
    (compiler-backend-test-global-builder-push! (&mut builder) name ty value)
    (ir.compiler-ir-global-builder-to-seq builder)))

(define (compiler-backend-test-two-i64-globals
  [first-name : String]
  [first-value : i64]
  [second-name : String]
  [second-value : i64]) : ir.CompilerIrGlobalSeq
  (let
    [builder : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 2)]
    (compiler-backend-test-global-builder-push!
      (&mut builder)
      first-name
      (I64)
      (I64 first-value))
    (compiler-backend-test-global-builder-push!
      (&mut builder)
      second-name
      (I64)
      (I64 second-value))
    (ir.compiler-ir-global-builder-to-seq builder)))

(define (compiler-backend-call-save-test-globals) : ir.CompilerIrGlobalSeq
  (let
    [globals : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-with-capacity 9)]
    (compiler-backend-test-global-builder-push!
      (&mut globals)
      "g0"
      (I64)
      (I64 0))
    (compiler-backend-test-global-builder-push!
      (&mut globals)
      "g1"
      (I64)
      (I64 0))
    (compiler-backend-test-global-builder-push!
      (&mut globals)
      "g2"
      (I64)
      (I64 0))
    (compiler-backend-test-global-builder-push!
      (&mut globals)
      "g3"
      (I64)
      (I64 0))
    (compiler-backend-test-global-builder-push!
      (&mut globals)
      "g4"
      (I64)
      (I64 0))
    (compiler-backend-test-global-builder-push!
      (&mut globals)
      "g5"
      (I64)
      (I64 0))
    (compiler-backend-test-global-builder-push!
      (&mut globals)
      "g6"
      (I64)
      (I64 0))
    (compiler-backend-test-global-builder-push!
      (&mut globals)
      "g5b"
      (I64)
      (I64 0))
    (compiler-backend-test-global-builder-push!
      (&mut globals)
      "g5c"
      (I64)
      (I64 0))
    (ir.compiler-ir-global-builder-to-seq globals)))

(define (compiler-backend-call-save-main-instrs) : ir.CompilerIrInstrSeq
  (let
    [instrs : ir.CompilerIrInstrSeq (ir.compiler-ir-instr-seq-empty)]
    (set!
      instrs
      (compiler-backend-test-instr-seq-prepend (irt.instr "return 0") instrs))
    (set!
      instrs
      (compiler-backend-test-instr-seq-prepend
        (Store (ci.intern "g5c") (Var 5) (I64))
        instrs))
    (set!
      instrs
      (compiler-backend-test-instr-seq-prepend
        (Store (ci.intern "g5b") (Var 5) (I64))
        instrs))
    (set!
      instrs
      (compiler-backend-test-instr-seq-prepend
        (Store (ci.intern "g6") (Var 6) (I64))
        instrs))
    (set!
      instrs
      (compiler-backend-test-instr-seq-prepend
        (Store (ci.intern "g5") (Var 5) (I64))
        instrs))
    (set!
      instrs
      (compiler-backend-test-instr-seq-prepend
        (Store (ci.intern "g4") (Var 4) (I64))
        instrs))
    (set!
      instrs
      (compiler-backend-test-instr-seq-prepend
        (Store (ci.intern "g3") (Var 3) (I64))
        instrs))
    (set!
      instrs
