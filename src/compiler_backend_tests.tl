    1
    (Var 0)
    lanes
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm) (string.eq asm want)]
    [(Err _) false]))

(define (compiler-backend-avx512-mask-not-shortens-ok?) : bool
  (and
    (compiler-backend-avx512-mask-not-emits?
      8
      "    movl $255, %eax\n    kmovw %eax, %k7\n    kandnw %k7, %k1, %k2\n")
    (compiler-backend-avx512-mask-not-emits? 16 "    knotw %k1, %k2\n")
    (compiler-backend-avx512-mask-not-emits? 32 "    knotd %k1, %k2\n")
    (compiler-backend-avx512-mask-not-emits? 64 "    knotq %k1, %k2\n")))

(define (compiler-backend-avx512-mask-binop-same-dst-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%k1"))

(define (compiler-backend-avx512-mask-binop-copy-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%k1 %1=%k2"))

(define (compiler-backend-avx512-mask-binop-emits?
  [assignments : regalloc.CompilerRegAssignmentTable]
  [dst : i64]
  [op : ir.CompilerIrMaskBinOp]
  [want : String]) : bool
  (match (be_simd.compiler-backend-emit-avx512-mask-binop
    (ast.ast-node-pool-reader-type-segment-bases)
    assignments
    dst
    op
    (Var 0)
    (Var 0)
    8
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm) (string.eq asm want)]
    [(Err _) false]))

(define (compiler-backend-avx512-mask-binop-same-registers-ok?) : bool
  (and
    (compiler-backend-avx512-mask-binop-emits?
      (compiler-backend-avx512-mask-binop-same-dst-assignments)
      0
      (And)
      "")
    (compiler-backend-avx512-mask-binop-emits?
      (compiler-backend-avx512-mask-binop-same-dst-assignments)
      0
      (Or)
      "")
    (compiler-backend-avx512-mask-binop-emits?
      (compiler-backend-avx512-mask-binop-copy-assignments)
      1
      (And)
      "    kmovw %k1, %k2\n")
    (compiler-backend-avx512-mask-binop-emits?
      (compiler-backend-avx512-mask-binop-copy-assignments)
      1
      (Or)
      "    kmovw %k1, %k2\n")))

(define (compiler-backend-avx512-mask-reduce-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%k1 %1=%r12"))

(define (compiler-backend-avx512-mask-reduce-emits?
  [op : ir.CompilerIrMaskReduceOp]
  [lanes : i64]
  [want : String]) : bool
