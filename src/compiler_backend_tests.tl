    [prev-emergency-slot-offset : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-slot-offset)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-c22-divmod-store-collision-assignments)]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler-backend-c22-divmod-store-collision-instrs)]
    [count : i64 (compiler_ir_types.compiler-ir-instr-list-count instrs)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "entry")
          instrs)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [_ctx : unit
      (begin
        (compiler_backend.compiler-backend-set-current-fn-win64!)
        (compiler_backend.compiler-backend-gep-fold-disable!)
        (compiler_backend.compiler-backend-emit-home-overrides-disable!)
        (compiler-backend-test-scavenge-install-ctx!
          "c22_divmod_store_collision"
          compiler_ir_types.CompilerIrParamList.Nil
          (compiler_ast_types.AstType.I64)
          15
          blocks
          assignments)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-slot-offset!
          -512))]
    [result : compiler_backend.ResultCompilerBackend
      (compiler-backend-emit-test-instrs instrs assignments 15)]
    [_restore : unit
      (begin
        (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
          prev-starts
          prev-ends
          prev-assignment-index
          prev-plan-mask
          prev-occupied-masks
          prev-vars)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          prev-post-base)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          prev-current-count)
        (if prev-win64
          (compiler_backend.compiler-backend-set-current-fn-win64!)
          (compiler_backend.compiler-backend-set-current-fn-linux!))
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-ready!
          prev-gep-ready)
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-disp-table!
          prev-gep-disp)
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-kind-table!
          prev-gep-kind)
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-scale-table!
          prev-gep-scale)
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-cursor!
          prev-gep-cursor)
        (compiler_backend.compiler-backend-test-set-compiler-backend-gep-fold-drift!
          prev-gep-drift)
        (compiler_backend.compiler-backend-divmod-overrides-install!
          prev0-var
          prev0-reg
          prev1-var
          prev1-reg)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-slot-offset!
          prev-emergency-slot-offset))]
    result))

(define (compiler-backend-c22-divmod-store-clobber-rejected-ok?) : bool
  (match (compiler-backend-c22-divmod-store-collision-asm)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq (%rcx,%r8,8), %rdx\n    addq (%rcx,%r12,8), %rdx\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movabsq $-8543223828751151131, %r9\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq -512(%rbp), %rcx\n    movq %rax, (%rcx,%r12,8)\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    subq %rax, %rcx\n    movq %rcx, %r9\n    movq %r9, (%rcx,%r12,8)\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-divrem-binop-types [ty : compiler_ast_types.AstType]) : compiler_regalloc.CompilerRegVarTypes
  (compiler_regalloc.compiler-reg-var-types-insert
    (compiler_regalloc.compiler-reg-var-types-insert
      (compiler_regalloc.compiler-reg-var-types-insert
        (compiler_regalloc.compiler-reg-var-types-empty)
        2
        ty)
      1
      ty)
    0
    ty))

(define (compiler-backend-divrem-binop-asm
  [op : compiler_ir_types.CompilerIrBinOp]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]) : compiler_backend.ResultCompilerBackend
  (compiler_backend.compiler-backend-emit-binop
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-divrem-binop-types ty)
    (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
    compiler_regalloc.CompilerRegAssignmentList.Nil
    2
    op
    (compiler_ir_types.CompilerIrValue.Var 0)
    rhs
    ty))

(define (compiler-backend-divrem-binop-guard-shape?
  [op : compiler_ir_types.CompilerIrBinOp]
  [rhs : compiler_ir_types.CompilerIrValue]
  [ty : compiler_ast_types.AstType]
  [want-guard? : bool]
  [want-remainder? : bool]) : bool
  (match (compiler-backend-divrem-binop-asm op rhs ty)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (if want-guard?
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_div_abort\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    call tl_div_abort\n")))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    idivq %r8\n")
        (if want-remainder?
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rdx, %rax\n")
          true)
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-divrem-rax-rhs-preserved-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-rax))
          compiler_regalloc.CompilerRegAssignmentList.Nil))]
    (match (compiler_backend.compiler-backend-emit-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-divrem-binop-types (compiler_ast_types.AstType.I64))
      (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
      assignments
      2
      (compiler_ir_types.CompilerIrBinOp.Div)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rax, %r8\n    movq %r12, %rax\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    idivq %r8\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %r12, %rax\n    movq %rax, %r8\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-safe-divrem-guard-elision-ok?) : bool
  (compiler_backend.backend-and4
    (compiler-backend-divrem-binop-guard-shape?
      (compiler_ir_types.CompilerIrBinOp.Div)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64)
      true
      false)
    (compiler-backend-divrem-binop-guard-shape?
      (compiler_ir_types.CompilerIrBinOp.SafeDiv)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64)
      false
      false)
    (compiler-backend-divrem-binop-guard-shape?
      (compiler_ir_types.CompilerIrBinOp.SafeMod)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64)
      false
      true)
    (compiler-backend-divrem-binop-guard-shape?
      (compiler_ir_types.CompilerIrBinOp.SafeDiv)
      (compiler_ir_types.CompilerIrValue.I64 (- 0 1))
      (compiler_ast_types.AstType.I64)
      false
      false)))

(define (compiler-backend-shift-guard-source) : String
  "(define (main) : i64 (shl 1 -1))")

;; Keep every scalar shift in this fixture parameterized so backend emission
;; cannot fold away the count guards.  The result/lhs widths deliberately
;; match the count width; this makes the sized test/cmp instructions and the
;; narrow diagnostic normalization observable in each function body.
(define (compiler-backend-scalar-shift-matrix-source) : String
  "(extern (shift_matrix_count) : u64 (:symbol \"tl_arg_count\"))
(define (shift_u64_lit [count : u64]) : u64
  (let
    [seed : u64 (cast 1 : u64)]
    [copy : u64 seed]
    (shr copy count)))
(define (shift_si8 [value : i8] [count : i8]) : i8
  (shr value count))
(define (shift_ui8 [value : u8] [count : u8]) : u8
  (shr value count))
(define (shift_si16 [value : i16] [count : i16]) : i16
  (shr value count))
(define (shift_ui16 [value : u16] [count : u16]) : u16
  (shr value count))
(define (shift_si32 [value : i32] [count : i32]) : i32
  (shr value count))
(define (shift_ui32 [value : u32] [count : u32]) : u32
  (shr value count))
(define (shift_si64 [value : i64] [count : i64]) : i64
  (shr value count))
(define (shift_ui64 [value : u64] [count : u64]) : u64
  (shr value count))
(define (main) : i64
  (let
    [a : i64 (cast (shift_si8 (cast 1 : i8) (cast 0 : i8)) : i64)]
    [b : i64 (cast (shift_ui8 (cast 1 : u8) (cast 0 : u8)) : i64)]
    [c : i64 (cast (shift_si16 (cast 1 : i16) (cast 0 : i16)) : i64)]
    [d : i64 (cast (shift_ui16 (cast 1 : u16) (cast 0 : u16)) : i64)]
    [e : i64 (cast (shift_si32 (cast 1 : i32) (cast 0 : i32)) : i64)]
    [f : i64 (cast (shift_ui32 (cast 1 : u32) (cast 0 : u32)) : i64)]
    [g : i64 (shift_si64 (cast 1 : i64) (cast 0 : i64))]
    [h : i64 (cast (shift_ui64 (cast 1 : u64) (cast 0 : u64)) : i64)]
    [i : i64 (cast (shift_u64_lit (shift_matrix_count)) : i64)]
    (+ a (+ b (+ c (+ d (+ e (+ f (+ g (+ h i))))))))))")

(define (compiler-backend-shift-count-reg [suffix : String]) : String
  (cond
    [(string.eq suffix "b") "%r8b"]
    [(string.eq suffix "w") "%r8w"]
    [(string.eq suffix "l") "%r8d"]
    [else "%r8"]))

(define (compiler-backend-shift-count-push-reg [suffix : String]) : String
  (if (string.eq suffix "q")
    "%r8"
    "%r11"))

(define (compiler-backend-shift-guard-body-ok?
  [body : String]
  [suffix : String]
  [width : String]
  [signed? : bool]
  [extension : String]
  [flag-reg : String]) : bool
  (let
    [reg : String (compiler-backend-shift-count-reg suffix)]
    [test : String
      (str_cat.str-cat "    test" suffix " " reg ", " reg "\n    jge 1f\n")]
    [cmp : String
      (str_cat.str-cat "    cmp" suffix " $" width ", " reg "\n    jb 1f\n")]
    [count-push : String
      (str_cat.str-cat
        "    pushq "
        (compiler-backend-shift-count-push-reg suffix)
        "\n")]
    [normalized-push : String
      (if (string.eq extension "")
        count-push
        (str_cat.str-cat extension "\n    pushq %r11\n"))]
    [zero-flag : String (str_cat.str-cat "    movq $0, " flag-reg "\n")]
    [one-flag : String (str_cat.str-cat "    movq $1, " flag-reg "\n")]
    (and
      (> (string.string-length body) 0)
      (compiler_backend.compiler-backend-string-contains? body cmp)
      (compiler_backend.compiler-backend-string-contains? body normalized-push)
      (if signed?
        (and
          (compiler_backend.compiler-backend-string-contains? body test)
          (compiler_backend.compiler-backend-string-contains? body zero-flag)
          (not
            (compiler_backend.compiler-backend-string-contains? body one-flag)))
        (and
          (not (compiler_backend.compiler-backend-string-contains? body test))
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "    jge 1f\n"))
          (compiler_backend.compiler-backend-string-contains? body one-flag)
          (not
            (compiler_backend.compiler-backend-string-contains? body zero-flag)))))))

(define (compiler-backend-scalar-shift-matrix-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-scalar-shift-matrix-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (let
        [literal : String
          (compiler-backend-asm-function-body asm "_tl_shift_u64_lit")]
        [si8 : String (compiler-backend-asm-function-body asm "_tl_shift_si8")]
        [ui8 : String (compiler-backend-asm-function-body asm "_tl_shift_ui8")]
        [si16 : String
          (compiler-backend-asm-function-body asm "_tl_shift_si16")]
        [ui16 : String
          (compiler-backend-asm-function-body asm "_tl_shift_ui16")]
        [si32 : String
          (compiler-backend-asm-function-body asm "_tl_shift_si32")]
        [ui32 : String
          (compiler-backend-asm-function-body asm "_tl_shift_ui32")]
        [si64 : String
          (compiler-backend-asm-function-body asm "_tl_shift_si64")]
        [ui64 : String
          (compiler-backend-asm-function-body asm "_tl_shift_ui64")]
        [flag-reg : String
          (if (compiler_backend.compiler-backend-target-windows? target)
            "%r9"
            "%rcx")]
        (and
          ;; All helpers stay on stable direct user symbols so body extraction
          ;; is independent of compact-name slot assignment.
          (compiler_backend.backend-and8
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl _tl_shift_u64_lit\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl _tl_shift_si8\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl _tl_shift_ui8\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl _tl_shift_si16\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl _tl_shift_ui16\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl _tl_shift_si32\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl _tl_shift_ui32\n")
            (and
              (compiler_backend.compiler-backend-string-contains?
                asm
                ".globl _tl_shift_si64\n")
              (compiler_backend.compiler-backend-string-contains?
                asm
                ".globl _tl_shift_ui64\n")))
          ;; A U64 literal/copy must select the logical right-shift mnemonic.
          (compiler_backend.compiler-backend-string-contains?
            literal
            "    shrq %cl, %rax\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              literal
              "    sarq %cl, %rax\n"))
          (compiler-backend-shift-guard-body-ok?
            si8
            "b"
            "8"
            true
            "    movsbq %r8b, %r11"
            flag-reg)
          (compiler-backend-shift-guard-body-ok?
            ui8
            "b"
            "8"
            false
            "    movzbq %r8b, %r11"
            flag-reg)
          (compiler-backend-shift-guard-body-ok?
            si16
            "w"
            "16"
            true
            "    movswq %r8w, %r11"
            flag-reg)
          (compiler-backend-shift-guard-body-ok?
            ui16
            "w"
            "16"
            false
            "    movzwq %r8w, %r11"
            flag-reg)
          (compiler-backend-shift-guard-body-ok?
            si32
            "l"
            "32"
            true
            "    movslq %r8d, %r11"
            flag-reg)
          (compiler-backend-shift-guard-body-ok?
            ui32
            "l"
            "32"
            false
            "    movl %r8d, %r11d"
            flag-reg)
          (compiler-backend-shift-guard-body-ok? si64 "q" "64" true "" flag-reg)
          (compiler-backend-shift-guard-body-ok?
            ui64
            "q"
            "64"
            false
            ""
            flag-reg)))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-scalar-shift-matrix-ok?) : bool
  (and
    (compiler-backend-scalar-shift-matrix-target-ok?
      compiler_backend.CompilerBackendTarget.Linux)
    (compiler-backend-scalar-shift-matrix-target-ok?
      compiler_backend.CompilerBackendTarget.Windows)))

(define (compiler-backend-shift-guard-ok?) : bool
  ;; `main` returns the shift, so contextual typing keeps this literal shift
  ;; at i64/width64 (the discarded-expression integration fixture is width32).
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-shift-guard-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and8
        (compiler_backend.compiler-backend-string-contains? asm "    movq $-1,")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    testq %r8, %r8\n    jge 1f\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq $64, %r8\n    jb 1f\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    call tl_shift_abort_at\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".globl tl_shift_abort\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_shift_msg:"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    shlq $-1, %rax\n"))
        (and
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    call tl_shift_abort\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker)))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-narrow-binop-types
  [lhs-ty : compiler_ast_types.AstType]
  [rhs-ty : compiler_ast_types.AstType]) : compiler_regalloc.CompilerRegVarTypes
  (compiler_regalloc.compiler-reg-var-types-insert
    (compiler_regalloc.compiler-reg-var-types-insert
      (compiler_regalloc.compiler-reg-var-types-empty)
      1
      rhs-ty)
    0
    lhs-ty))

(define (compiler-backend-narrow-binop-shape?
  [op : compiler_ir_types.CompilerIrBinOp]
  [lhs-ty : compiler_ast_types.AstType]
  [rhs-ty : compiler_ast_types.AstType]
  [result-ty : compiler_ast_types.AstType]
  [needle : String]
  [bad : String]) : bool
  (match (compiler_backend.compiler-backend-emit-binop
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-narrow-binop-types lhs-ty rhs-ty)
    (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
    compiler_regalloc.CompilerRegAssignmentList.Nil
    2
    op
    (compiler_ir_types.CompilerIrValue.Var 0)
    (compiler_ir_types.CompilerIrValue.Var 1)
    result-ty)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains? asm needle)
        (if (string.eq bad "")
          true
          (not (compiler_backend.compiler-backend-string-contains? asm bad)))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Backend-owned narrow integer instruction selection coverage. These
;; checks pin the operand width and signedness-sensitive forms that source-level
;; execution tests do not distinguish.
(define (compiler-backend-narrow-scalar-instr-ok?) : bool
  (and
    (compiler_backend.backend-and8
      (compiler-backend-narrow-binop-shape?
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ast_types.AstType.I32)
        (compiler_ast_types.AstType.I32)
        (compiler_ast_types.AstType.I32)
        "    addl -16(%rbp), %r8d\n"
        "%rax")
      (compiler-backend-narrow-binop-shape?
        (compiler_ir_types.CompilerIrBinOp.Mul)
        (compiler_ast_types.AstType.I32)
        (compiler_ast_types.AstType.I32)
        (compiler_ast_types.AstType.I32)
        "    imull -16(%rbp), %r8d\n"
        "%rax")
      (compiler-backend-narrow-binop-shape?
        (compiler_ir_types.CompilerIrBinOp.Div)
        (compiler_ast_types.AstType.I32)
        (compiler_ast_types.AstType.I32)
        (compiler_ast_types.AstType.I32)
        "    cdq\n    idivl %r8d\n"
        "    idivq %r8\n")
      (compiler-backend-narrow-binop-shape?
        (compiler_ir_types.CompilerIrBinOp.Add)
        (compiler_ast_types.AstType.I8)
        (compiler_ast_types.AstType.I8)
        (compiler_ast_types.AstType.I8)
        "    addb -16(%rbp), %r8b\n"
        "%rax")
      (compiler-backend-narrow-binop-shape?
        (compiler_ir_types.CompilerIrBinOp.Sub)
        (compiler_ast_types.AstType.I8)
        (compiler_ast_types.AstType.I8)
        (compiler_ast_types.AstType.I8)
        "    subb -16(%rbp), %r8b\n"
        "%rax")
      (compiler-backend-narrow-binop-shape?
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ast_types.AstType.I8)
        (compiler_ast_types.AstType.I8)
        (compiler_ast_types.AstType.Bool)
        "    cmpb -16(%rbp), %r8b\n    setl %r8b\n"
        "%rax")
      (compiler-backend-narrow-binop-shape?
        (compiler_ir_types.CompilerIrBinOp.Mod)
        (compiler_ast_types.AstType.I8)
        (compiler_ast_types.AstType.I8)
        (compiler_ast_types.AstType.I8)
        "    cbw\n    idivb %r8b\n    movb %ah, %al\n"
        "    idivq %r8\n")
      (compiler-backend-narrow-binop-shape?
        (compiler_ir_types.CompilerIrBinOp.BitAnd)
        (compiler_ast_types.AstType.I16)
        (compiler_ast_types.AstType.I16)
        (compiler_ast_types.AstType.I16)
        "    andw -16(%rbp), %r8w\n"
        "%rax"))
    (compiler_backend.backend-and4
      (compiler-backend-narrow-binop-shape?
        (compiler_ir_types.CompilerIrBinOp.Div)
        (compiler_ast_types.AstType.I16)
        (compiler_ast_types.AstType.I16)
        (compiler_ast_types.AstType.I16)
        "    cwd\n    idivw %r8w\n"
        "    idivq %r8\n")
      (compiler-backend-narrow-binop-shape?
        (compiler_ir_types.CompilerIrBinOp.Mod)
        (compiler_ast_types.AstType.U8)
        (compiler_ast_types.AstType.U8)
        (compiler_ast_types.AstType.U8)
        "    andw $0x00ff, %ax\n    divb %r8b\n    movb %ah, %al\n"
        "    idivq %r8\n")
      (and
        (compiler-backend-narrow-binop-shape?
          (compiler_ir_types.CompilerIrBinOp.Shr
            (compiler_ast_types.AstType.U8))
          (compiler_ast_types.AstType.I8)
          (compiler_ast_types.AstType.U8)
          (compiler_ast_types.AstType.I8)
          "    movq %r8, %rcx\n    sarb %cl, %r9b\n"
          "%rax")
        (compiler-backend-narrow-binop-shape?
          (compiler_ir_types.CompilerIrBinOp.Shr
            (compiler_ast_types.AstType.U8))
          (compiler_ast_types.AstType.U8)
          (compiler_ast_types.AstType.U8)
          (compiler_ast_types.AstType.U8)
          "    movq %r8, %rcx\n    shrb %cl, %r9b\n"
          "%rax"))
      (and
        (compiler-backend-narrow-binop-shape?
          (compiler_ir_types.CompilerIrBinOp.Shl
            (compiler_ast_types.AstType.U8))
          (compiler_ast_types.AstType.U8)
          (compiler_ast_types.AstType.U8)
          (compiler_ast_types.AstType.U8)
          "    movq %r8, %rcx\n    shlb %cl, %r9b\n"
          "%rax")
        (compiler-backend-narrow-binop-shape?
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ast_types.AstType.U8)
          (compiler_ast_types.AstType.U8)
          (compiler_ast_types.AstType.Bool)
          "    cmpb -16(%rbp), %r8b\n    setb %r8b\n"
          "%rax")))))

(define (compiler-backend-global-compare-types) : compiler_backend.CompilerBackendGlobalTypeTable
  (compiler_backend.compiler-backend-global-types
    (compiler_ir_types.compiler-ir-global-cons
      (compiler_ir_types.CompilerIrGlobal.Global
        (ci.intern "g_next")
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 0))
      (compiler_ir_types.compiler-ir-global-cons
        (compiler_ir_types.CompilerIrGlobal.Global
          (ci.intern "g_cap")
          (compiler_ast_types.AstType.I64)
          (compiler_ir_types.CompilerIrValue.I64 0))
        compiler_ir_types.CompilerIrGlobalList.Nil))))

(define (compiler-backend-global-compare-binop-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-binop
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler_regalloc.compiler-reg-var-types-empty)
    (compiler-backend-global-compare-types)
    compiler_regalloc.CompilerRegAssignmentList.Nil
    0
    (compiler_ir_types.CompilerIrBinOp.Ge)
    (compiler_ir_types.CompilerIrValue.Global (ci.intern "g_next"))
    (compiler_ir_types.CompilerIrValue.Global (ci.intern "g_cap"))
    (compiler_ast_types.AstType.Bool))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        ;; The 64-bit global compare now materialises in %r9 (scratch reg
        ;; choice changed); the load-bearing check is the width (cmpq, not cmpb).
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq %r8, %r9\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpb %r8b, %al\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-global-compare-program) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler_ir_types.compiler-ir-global-cons
      (compiler_ir_types.CompilerIrGlobal.Global
        (ci.intern "g_next")
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.CompilerIrValue.I64 1))
      (compiler_ir_types.compiler-ir-global-cons
        (compiler_ir_types.CompilerIrGlobal.Global
          (ci.intern "g_cap")
          (compiler_ast_types.AstType.I64)
          (compiler_ir_types.CompilerIrValue.I64 1024))
        compiler_ir_types.CompilerIrGlobalList.Nil))
    (compiler_ir_types.compiler-ir-function-cons
      (compiler_ir_types.CompilerIrFunction.Function
        (ci.intern "main")
        compiler_ir_types.CompilerIrParamList.Nil
        (compiler_ast_types.AstType.I64)
        1
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-block
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.BinOp
                0
                (compiler_ir_types.CompilerIrBinOp.Ge)
                (compiler_ir_types.CompilerIrValue.Global (ci.intern "g_next"))
                (compiler_ir_types.CompilerIrValue.Global (ci.intern "g_cap"))
                (compiler_ast_types.AstType.Bool))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Branch
                  (compiler_ir_types.CompilerIrValue.Var 0)
                  (compiler_ir_types.compiler-ir-label "full")
                  (compiler_ir_types.compiler-ir-label "ok"))
                compiler_ir_types.CompilerIrInstrList.Nil)))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.compiler-ir-block
              (compiler_ir_types.compiler-ir-label "full")
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.I64 1)))
                compiler_ir_types.CompilerIrInstrList.Nil))
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.compiler-ir-block
                (compiler_ir_types.compiler-ir-label "ok")
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.Return
                    (compiler_ir_types.CompilerIrMaybeValue.Some
                      (compiler_ir_types.CompilerIrValue.I64 42)))
                  compiler_ir_types.CompilerIrInstrList.Nil))
              compiler_ir_types.CompilerIrBlockList.Nil))))
      compiler_ir_types.CompilerIrFunctionList.Nil)
    compiler_ir_types.CompilerIrExternList.Nil))

(define (compiler-backend-global-compare-branch-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-linux
    (compiler-backend-global-compare-program))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        ;; The 64-bit global compare now materialises in %r9 (scratch reg
        ;; choice changed); the load-bearing check is the width (cmpq, not cmpb).
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq %r8, %r9\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpb %r8b, %al\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-missing-var-compare-width-ok?) : bool
  (let
    [rhs-spill : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Spill -16))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    (match (compiler_backend.compiler-backend-emit-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_regalloc.compiler-reg-var-types-empty)
      (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
      rhs-spill
      2
      (compiler_ir_types.CompilerIrBinOp.Lt)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.Bool))
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpq -16(%rbp), %r8\n    setl %r8b\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    cmpb -16(%rbp), %al\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    cmpq -16(%rbp), %rax\n    setl %al\n")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-global-compare-width-ok?) : bool
  (and
    (compiler-backend-global-compare-binop-ok?)
    (compiler-backend-global-compare-branch-ok?)
    (compiler-backend-missing-var-compare-width-ok?)))

(define (compiler-backend-f64-abi-source) : String
  "(define (half [x : f64]) : f64 (/ x 2.0))
(define (callhalf [x : f64]) : f64 (half x))
(define (second [n : i64] [x : f64]) : f64 x)")

(define (compiler-backend-f64-abi-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-f64-abi-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and8
        ;; FPO rsp-relative frame slots (second's n at 8(%rsp); half's x
        ;; f64 param spills from %xmm0 to 24(%rsp), divisor 2.0 at 16(%rsp)).
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq %rdi, 8(%rsp)\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movsd %xmm0, 24(%rsp)\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd %xmm1, 24(%rsp)\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    divsd 16(%rsp), %xmm2\n")
        (or
          (compiler-backend-call-or-jmp-ok? asm "_tl_half")
          (compiler-backend-call-or-jmp-ok? asm "_tl_callhalf")
          (compiler-backend-call-or-jmp-ok? asm "_tl_f"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movsd %xmm0, ")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker)))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    divsd %xmm1, %xmm0\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Windows f64 ABI emit-shape coverage: the first four positional
;; f64 args use xmm0..xmm3, the fifth is stacked after the 32-byte shadow
;; space, and f64 returns remain in xmm0.
(define (compiler-backend-win64-f64-abi-source) : String
  "(define (sum5
  [a : f64]
  [b : f64]
  [c : f64]
  [d : f64]
  [e : f64]) : f64
  (+ (+ (+ (+ a b) c) d) e))

(define (call5 [x : f64]) : f64
  (+ 0.0 (sum5 x 2.0 3.0 4.0 5.0)))

(define (main) : i64
  (if (< (call5 1.0) 16.0) 42 0))")

(define (compiler-backend-win64-f64-abi-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-win64-f64-abi-source)
    (compiler_backend.CompilerBackendTarget.Windows))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          ;; Win64 FPO rebases local slots and the positive incoming fifth
          ;; argument against the constant post-prologue %rsp.
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd %xmm0, 72(%rsp)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd %xmm1, 64(%rsp)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd %xmm2, 56(%rsp)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd %xmm3, 48(%rsp)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    subq $120, %rsp\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 64(%rsp), %r10\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r10, 32(%rsp)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd 128(%rsp), %xmm2\n"))
        (or
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call _tl_f")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call _tl_sum5")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call _tl_call5"))
        ;; The f64 call result (kept in %xmm0) spills to rsp slot 56(%rsp).
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movsd %xmm0, 56(%rsp)\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "too many call args"))
        (not
          (compiler_backend.compiler-backend-string-contains? asm "    syscall"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd 48(%rbp), %xmm0\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r11, 32(%rsp)\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-register-f64-aggregate-source) : String
  "(defstruct PairF64 (x f64) (y f64))
(defstruct MixIF (i i64) (f f64))
(define global-pair : PairF64 (PairF64 1.0 2.0))
(define (make-pair [x : f64] [y : f64]) : PairF64
  (PairF64 x y))
(define (sum-pair [p : PairF64]) : f64
  (+ (struct-get p x) (struct-get p y)))
(define (mixed [m : MixIF]) : f64
  (struct-get m f))
(define (main) : i64
  (begin
    (set! global-pair (make-pair 3.0 4.0))
    (if (= (+ (sum-pair global-pair) (mixed (MixIF 5 6.0))) 13.0)
      42
      0)))")

(define (compiler-backend-register-f64-aggregate-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-register-f64-aggregate-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains? asm "    movsd ")
          (compiler_backend.compiler-backend-string-contains? asm "%xmm0")
          (compiler_backend.compiler-backend-string-contains? asm "%xmm1")
          (compiler_backend.compiler-backend-string-contains? asm "    call ")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movsd %rax"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movsd %rdx"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              ", %rax\n    movsd"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              ", %rdx\n    movsd")))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-register-f64-aggregate-ok?) : bool
  (and
    (compiler-backend-register-f64-aggregate-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-register-f64-aggregate-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

(define (compiler-backend-register-f32-aggregate-source) : String
  "(defstruct Vec2F32 (x f32) (y f32))
(defstruct MixUF (tag u32) (value f32))
(define global-vec : Vec2F32 (Vec2F32 1.0 2.0))
(define (make-vec [x : f32] [y : f32]) : Vec2F32
  (Vec2F32 x y))
(define (sum-vec [v : Vec2F32]) : f32
  (+ (struct-get v x) (struct-get v y)))
(define (choose-vec [take-left : bool]) : Vec2F32
  (if take-left
    (Vec2F32 1.25 2.75)
    (Vec2F32 9.0 10.0)))
(define (mixed [m : MixUF]) : f32
  (struct-get m value))
(define (main) : i64
  (begin
    (set! global-vec (make-vec 3.5 4.5))
    (if (= (+ (sum-vec global-vec) (sum-vec (choose-vec true))) 12.0)
      (cast (mixed (MixUF (cast 5 : u32) 6.0)) : i64)
      0)))")

(define (compiler-backend-register-f32-aggregate-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-register-f32-aggregate-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movd %xmm2, %r8d\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movd %r8d, %xmm2\n")
          (compiler_backend.compiler-backend-string-contains? asm "    movsd ")
          (compiler_backend.compiler-backend-string-contains? asm "%xmm0")
          (compiler_backend.compiler-backend-string-contains? asm "    call ")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movss 4(%r10), %xmm2\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "unsupported bitcast"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd %rax"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd %rdx"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movd %xmm0, %eax\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movd %eax, %xmm0\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movss 4(%r10), %xmm0\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-register-f32-aggregate-ok?) : bool
  (and
    (compiler-backend-register-f32-aggregate-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-register-f32-aggregate-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

;; A SysV call with seven integer args no longer rejects as "too many
;; call args". Source-level numeric literals are lowered into locals before
;; call-arg emission, so the 7th and 8th args still exercise the variable
;; stack-store path while `add8` reads them back from 16(%rbp)/24(%rbp).
(define (compiler-backend-stack-add-call-ok? [asm : String]) : bool
  (or
    (compiler_backend.compiler-backend-string-contains? asm "    call _tl_add8")
    (compiler_backend.compiler-backend-string-contains? asm "    call _tl_f")))

(define (compiler-backend-stack-mix-call-ok? [asm : String]) : bool
  (or
    (compiler_backend.compiler-backend-string-contains? asm "    call _tl_mix")
    (compiler_backend.compiler-backend-string-contains? asm "    call _tl_f")))

(define (compiler-backend-stack-int-args-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-stack-int-args-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      ;; Under FPO the outgoing stack-arg area is reserved once in the
      ;; prologue (no per-call `subq $16`/`addq $16`); both stack args are
      ;; stored to 0(%rsp)/8(%rsp), and the callee reads the incoming stack args
      ;; rsp-relative (96/104(%rsp)) instead of positive 16/24(%rbp). The
      ;; incoming-arg checks are scoped to the _tl_add8 body: with everything now
      ;; positive-rsp, `main` also uses those same numeric slots for its own
      ;; locals (e.g. `movq 104(%rsp), %rax`), so a whole-program `not` check
      ;; would spuriously trip.
      (let
        [callee : String (compiler-backend-asm-function-body asm "_tl_add8")]
        (and
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "too many call args"))
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r10, 0(%rsp)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r10, 8(%rsp)\n")
          (compiler-backend-stack-add-call-ok? asm)
          (compiler_backend.compiler-backend-string-contains?
            callee
            "    movq 96(%rsp), %r8\n")
          (compiler_backend.compiler-backend-string-contains?
            callee
            "    movq 104(%rsp), %r8\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              callee
              "    movq 96(%rsp), %rax\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              callee
              "    movq 104(%rsp), %rax\n"))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; A SysV call with ten f64 args uses xmm0..xmm7 then spills two on the
;; stack through a scavenged GP bit-copy; the callee reads them back via movsd
;; from the incoming stack slots.
(define (compiler-backend-stack-f64-args-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-stack-f64-args-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "too many call args"))
        ;; FPO reserves the outgoing stack-arg area in the prologue (no
        ;; per-call `subq $16`); the two spilled f64 args go to 0/8(%rsp) via GP
        ;; bit-copies and the callee reads incoming f64 stack args rsp-relative
        ;; (112/120(%rsp)) instead of positive 16/24(%rbp).
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq %r10, 0(%rsp)\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq %r10, 8(%rsp)\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movsd 112(%rsp), %xmm2\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movsd 120(%rsp), %xmm2\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd 112(%rsp), %xmm0\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd 120(%rsp), %xmm0\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; A mixed call spilling one int and one f64 keeps the integer and float
;; register banks independent and uses the right scratch register for each
;; spilled arg.
(define (compiler-backend-stack-mixed-args-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-stack-mixed-args-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "too many call args"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq %r10, 0(%rsp)\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq %r10, 8(%rsp)\n")
        (compiler-backend-stack-mix-call-ok? asm))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; The Windows positional ABI still reserves 32-byte shadow space, stacks
;; args after the first four, and stores them after the shadow space.
(define (compiler-backend-stack-windows-args-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-stack-int-args-source)
    (compiler_backend.CompilerBackendTarget.Windows))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "too many call args"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    call _tl_add8\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq %r10, 32(%rsp)\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq %r10, 56(%rsp)\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq 128(%rsp), %r8\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 128(%rsp), %rax\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-i64-type-list8) : compiler_ast_types.AstTypeList
  (let
    [out : compiler_ast_types.AstTypeList
      (compiler_ast_types.ast-type-list-with-capacity 8)]
    [i : i64 0]
    (begin
      (while (< i 8)
        (begin
          (compiler_ast_types.ast-type-list-push
            (&mut out)
            (compiler_ast_types.ast-node-pool-reader-type-push
              (compiler_ast_types.AstType.I64)))
          (set! i (+ i 1))))
      out)))

(define (compiler-backend-i64-immediate-call-args8) : compiler_ir_types.CompilerIrCallArgs
  (compiler_ir_types.compiler-ir-call-args-from-list
    (compiler_ir_types.compiler-ir-value-cons
