(define (compiler-backend-c-abi-sret-aggregate-source) : String
  "(defstruct Wide
  (:repr c)
  (a u64)
  (b u64))
(extern (wide-make [a : u32] [b : u32] [c : u32] [d : u32] [tag : u64]) : Wide (:symbol \"tl_cabi_wide_make\"))
(extern wide-maker (:symbol \"tl_cabi_wide_make_ptr\") : (CFunc non-null (-> u32 u32 u32 u32 u64 Wide)))
(define (wide-score [value : Wide]) : i64
  (+ (cast value.a : i64) (cast value.b : i64)))
(define (main) : i64
  (let
    [direct : Wide
      (wide-make
        (cast 1 : u32)
        (cast 2 : u32)
        (cast 3 : u32)
        (cast 4 : u32)
        (cast 10 : u64))]
    [via-ptr : Wide
      (wide-maker
        (cast 5 : u32)
        (cast 6 : u32)
        (cast 7 : u32)
        (cast 8 : u32)
        (cast 2 : u64))]
    (if (= (wide-score direct) 120)
      (if (= (wide-score via-ptr) 52) 42 2)
      1)))")

(define (compiler-backend-register-indirect-call? [asm : (& asm str)]) : bool
  (asm-has? asm "    call *%"))

;; The Win64 sret aggregate-RETURN path: returning a 9-16B register-group from
;; a C function reserves a caller sret buffer in the frame (passed as a
;; scalar-pointer hidden first arg; #7990) and materializes the result back
;; into the 2-word register group (see lower-c-abi-finish-call-result). Assert
;; the sret codegen IS emitted -- both the direct call and the indirect
;; register call site -- that neither buffer allocates, and that nothing is
;; rejected as unsupported.
(define (compiler-backend-c-abi-sret-aggregate-windows-ok?) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-c-abi-sret-aggregate-source)
    (be_state.CompilerBackendTarget.Windows))
    [(Ok asm)
      (be_state.backend-and4
        (be_state.backend-and4
          (asm-has? asm ".extern tl_cabi_wide_make\n")
          (asm-has? asm ".extern tl_cabi_wide_make_ptr\n")
          (asm-has? asm "    call tl_cabi_wide_make\n")
          (compiler-backend-register-indirect-call? asm))
        (asm-lacks? asm "unsupported windows-x86_64 C aggregate ABI")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle)))
        (and
          (= (compiler-backend-alloc-call-count asm) 0)
          (not (compiler-backend-string-contains-alloc-size? asm 16))))]
    [(Err _) false]))

(define (compiler-backend-c-abi-byref-aggregate-arg-source) : String
  "(defstruct WideArg
  (:repr c)
  (a u64)
  (b f64))
(extern (wide-arg-score [arg : WideArg] [tag : u64]) : i64 (:symbol \"tl_cabi_wide_arg_score\"))
(extern wide-arg-scorer (:symbol \"tl_cabi_wide_arg_score_ptr\") : (CFunc non-null (-> WideArg u64 i64)))
(define (main) : i64
  (let
    [direct-arg : WideArg (WideArg (cast 10 : u64) 1.5)]
    [ptr-arg : WideArg (WideArg (cast 20 : u64) 2.5)]
    [direct : i64 (wide-arg-score direct-arg (cast 7 : u64))]
    [via-ptr : i64 (wide-arg-scorer ptr-arg (cast 5 : u64))]
    (if (= direct 32)
      (if (= via-ptr 75) 42 2)
      1)))")

(define (compiler-backend-c-abi-byref-aggregate-arg-windows-ok?) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-c-abi-byref-aggregate-arg-source)
    (be_state.CompilerBackendTarget.Windows))
    [(Ok asm)
      (be_state.backend-and8
        (asm-has? asm ".extern tl_cabi_wide_arg_score\n")
        (asm-has? asm ".extern tl_cabi_wide_arg_score_ptr\n")
        (asm-has? asm "    call tl_cabi_wide_arg_score\n")
        (compiler-backend-register-indirect-call? asm)
        ;; A WideArg construction is built in inline storage, and the
        ;; by-reference copy the Win64 ABI requires at each of the two call
        ;; sites is a frame temporary (#7885), so nothing here allocates: no
        ;; allocator call and no inline 16-byte arena bump.
        (= (compiler-backend-alloc-call-count asm) 0)
        (not (compiler-backend-string-contains-alloc-size? asm 16))
        (asm-lacks? asm "lower: unsupported windows-x86_64 C aggregate ABI")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-c-abi-win64-enum-aggregate-source) : String
  "(defenum Status (Ready) (Done) (Failed))
(defenum SmallChoice (None) (Some i64))
(defenum WideChoice (None) (Some u64 f64))
(defenum ReturnChoice (None) (Pair u64 u64))
(extern (status-pick [arg0 : Status] [arg1 : Status] [choose-second : i64]) : Status (:symbol \"tl_win64_status_pick\"))
(extern status-pick-ptr (:symbol \"tl_win64_status_pick_ptr\") : (CFunc non-null (->
  Status
  Status
  i64
  Status)))
(extern (small-score [arg : SmallChoice] [bias : i64]) : i64 (:symbol \"tl_win64_small_score\"))
(extern small-scorer (:symbol \"tl_win64_small_score_ptr\") : (CFunc non-null (->
  SmallChoice
  i64
  i64)))
(extern (wide-score [arg : WideChoice] [tag : u64]) : i64 (:symbol \"tl_win64_wide_score\"))
(extern wide-scorer (:symbol \"tl_win64_wide_score_ptr\") : (CFunc non-null (->
  WideChoice
  u64
  i64)))
(extern (return-choice-make [a : u32] [b : u32] [tag : u64]) : ReturnChoice (:symbol \"tl_win64_return_choice_make\"))
(extern return-choice-maker (:symbol \"tl_win64_return_choice_make_ptr\") : (CFunc non-null (->
  u32
  u32
  u64
  ReturnChoice)))
(define (return-score [r : ReturnChoice]) : i64
  (match r
    [ReturnChoice.None 0]
    [(ReturnChoice.Pair lo hi) (+ (cast lo : i64) (cast hi : i64))]))
(define (main) : i64
  (let
    [status-copy : (CFunc non-null (-> Status Status i64 Status)) status-pick-ptr]
    [small-copy : (CFunc non-null (-> SmallChoice i64 i64)) small-scorer]
    [wide-copy : (CFunc non-null (-> WideChoice u64 i64)) wide-scorer]
    [return-copy : (CFunc non-null (-> u32 u32 u64 ReturnChoice)) return-choice-maker]
    [picked : Status (status-pick (Ready) (Done) 1)]
    [picked-via-ptr : Status (status-copy (Ready) (Failed) 1)]
    [small-direct : i64 (small-score (SmallChoice.Some 11) 5)]
    [small-via-ptr : i64 (small-copy SmallChoice.None 7)]
    [wide-direct : i64 (wide-score (WideChoice.Some (cast 20 : u64) 2.5) (cast 3 : u64))]
    [wide-via-ptr : i64 (wide-copy WideChoice.None (cast 4 : u64))]
    [made : ReturnChoice
      (return-choice-make (cast 3 : u32) (cast 4 : u32) (cast 10 : u64))]
    [made-via-ptr : ReturnChoice
      (return-copy (cast 5 : u32) (cast 6 : u32) (cast 2 : u64))]
    (+ small-direct
      (+ small-via-ptr
        (+ wide-direct
          (+ wide-via-ptr
            (+ (return-score made) (return-score made-via-ptr))))))))")

(define (compiler-backend-c-abi-win64-enum-aggregate-ok?) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-c-abi-win64-enum-aggregate-source)
    (be_state.CompilerBackendTarget.Windows))
    [(Ok asm)
      (be_state.backend-and8
        (asm-has? asm ".extern tl_win64_status_pick\n")
        (asm-has? asm ".extern tl_win64_small_score\n")
        (asm-has? asm ".extern tl_win64_wide_score\n")
        (asm-has? asm ".extern tl_win64_return_choice_make\n")
        (asm-has? asm "    call tl_win64_status_pick\n")
        (asm-has? asm "    call tl_win64_small_score\n")
        (be_state.backend-and8
          (asm-has? asm "    call tl_win64_wide_score\n")
          (asm-has? asm "    call tl_win64_return_choice_make\n")
          (compiler-backend-register-indirect-call? asm)
          ;; The by-reference `SmallChoice` (16 bytes) and `WideChoice` (24
          ;; bytes) arguments are frame temporaries (#7885), and so are the
          ;; 24-byte hidden-sret buffers for the `ReturnChoice` results
          ;; (#7990): nothing allocates.
          (not (compiler-backend-string-contains-alloc-size? asm 16))
          (not (compiler-backend-string-contains-alloc-size? asm 24))
          (asm-lacks? asm "unsupported windows-x86_64 C aggregate ABI")
          (not
            (let
              [needle (compiler-backend-todo-marker)]
              (asm-has? asm needle)))
          (= (compiler-backend-alloc-call-count asm) 0))
        true)]
    [(Err _) false]))

(define (compiler-backend-c-abi-sysv-register-aggregate-arg-source) : String
  "(defstruct Inner (lo i64))
(defstruct Outer (inner Inner) (hi i64))
(defstruct Mixed (tag u64) (value f64))
(defstruct Vec2 (x f32) (y f32))
(extern (outer-use [arg0 : Outer]) : i64 (:symbol \"tl_cabi_outer_use\"))
(extern (mixed-use [arg0 : Mixed]) : i64 (:symbol \"tl_cabi_mixed_use\"))
(extern (vec2-use [arg0 : Vec2]) : i64 (:symbol \"tl_cabi_vec2_use\"))
(extern (vec2-make [seed : i64]) : Vec2 (:symbol \"tl_cabi_vec2_make\"))
(define (main) : i64
  (let
    [outer : Outer (Outer (Inner 10) 20)]
    [mixed : Mixed (Mixed (cast 7 : u64) 2.5)]
    [vec : Vec2 (Vec2 1.5 2.25)]
    [made : Vec2 (vec2-make 5)]
    (+ (outer-use outer)
       (+ (mixed-use mixed)
          (+ (vec2-use vec) (cast made.x : i64))))))")

(define (compiler-backend-c-abi-sysv-register-aggregate-arg-linux-ok?) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-c-abi-sysv-register-aggregate-arg-source)
    (be_state.CompilerBackendTarget.Linux))
    [(Ok asm)
      (be_state.backend-and8
        (asm-has? asm ".extern tl_cabi_outer_use\n")
        (asm-has? asm ".extern tl_cabi_mixed_use\n")
        (asm-has? asm ".extern tl_cabi_vec2_use\n")
        (asm-has? asm ".extern tl_cabi_vec2_make\n")
        (asm-has? asm "    call tl_cabi_outer_use\n")
        (asm-has? asm "    call tl_cabi_mixed_use\n")
        (asm-has? asm "    call tl_cabi_vec2_use\n")
        (be_state.backend-and4
          (asm-has? asm "    call tl_cabi_vec2_make\n")
          (asm-has? asm "%xmm")
          (asm-lacks? asm "unsupported linux-x86_64 C aggregate ABI")
          (and
            (asm-lacks? asm "two-register aggregate return ABI")
            (not
              (let
                [needle (compiler-backend-todo-marker)]
                (asm-has? asm needle))))))]
    [(Err _) false]))

(define (compiler-backend-c-abi-sysv-memory-aggregate-source) : String
  "(defstruct WideMem
  (:repr c)
  (a u64)
  (b u64)
  (c u64))
(defstruct InnerMem
  (:repr c)
  (lo u64)
  (hi u64))
(defstruct NestedMem
  (:repr c)
  (inner InnerMem)
  (tail u64))
(extern (wide-mem-score [arg0 : WideMem] [salt : u64]) : i64 (:symbol \"tl_cabi_wide_mem_score\"))
(extern wide-mem-scorer (:symbol \"tl_cabi_wide_mem_score_ptr\") : (CFunc non-null (->
  WideMem
  u64
  i64)))
(extern (wide-mem-make [seed : u64]) : WideMem (:symbol \"tl_cabi_wide_mem_make\"))
(extern (nested-mem-score [arg0 : NestedMem]) : i64 (:symbol \"tl_cabi_nested_mem_score\"))
(define (main) : i64
  (let
    [wide : WideMem
      (WideMem (cast 1 : u64) (cast 2 : u64) (cast 3 : u64))]
    [nested : NestedMem
      (NestedMem
        (InnerMem (cast 4 : u64) (cast 5 : u64))
        (cast 6 : u64))]
    [score-copy : (CFunc non-null (-> WideMem u64 i64)) wide-mem-scorer]
    [direct : i64 (wide-mem-score wide (cast 7 : u64))]
    [via-ptr : i64 (score-copy wide (cast 8 : u64))]
    [made : WideMem (wide-mem-make (cast 9 : u64))]
    (+ direct
      (+ via-ptr
        (+ (nested-mem-score nested) (cast made.a : i64))))))")

(define (compiler-backend-c-abi-sysv-memory-aggregate-arg-linux-ok?) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-c-abi-sysv-memory-aggregate-source)
    (be_state.CompilerBackendTarget.Linux))
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "main")]
        (be_state.backend-and8
          (asm-has? asm ".extern tl_cabi_wide_mem_score\n")
          (asm-has? asm ".extern tl_cabi_wide_mem_score_ptr\n")
          (asm-has? asm ".extern tl_cabi_wide_mem_make\n")
          (asm-has? asm ".extern tl_cabi_nested_mem_score\n")
          (asm-has? asm "    call tl_cabi_wide_mem_score\n")
          (compiler-backend-register-indirect-call? asm)
          (asm-has? asm "    call tl_cabi_wide_mem_make\n")
          (be_state.backend-and8
            (asm-has? asm "    call tl_cabi_nested_mem_score\n")
            (asm-has? body "    movups (%r10), %xmm2\n")
            (asm-has? body "    movups %xmm2, 0(%rsp)\n")
            (asm-has? body "    movq 16(%r10), %xmm2\n")
            (asm-has? body "    movq %xmm2, 16(%rsp)\n")
            (asm-lacks?
              body
              "    leaq 0(%rsp), %r10\n"
              "16(%r11)"
              "    subq $32, %rsp\n"
              "    addq $32, %rsp\n")
            (asm-lacks? asm "unsupported linux-x86_64 C aggregate ABI")
            (not
              (let
                [needle (compiler-backend-todo-marker)]
                (asm-has? asm needle))))))]
    [(Err _) false]))

(define (compiler-backend-c-abi-memory-outgoing-size-ok?
  [target : be_state.CompilerBackendTarget]
  [size : i64]) : bool
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [name : i64 (ir.compiler-ir-test-symbol "c-memory-outgoing-fixture")]
    [signature : ast.AstType
      (ast.ast-ty-func
        (ast.ast-type-cons
          (& (ast.AstType.I64))
          (&
            (ast.ast-type-cons
              (& (ast.AstType.I64))
              (&
                (ast.ast-type-cons
                  (& (ast.AstType.I64))
                  (&
                    (ast.ast-type-cons
                      (& (ast.AstType.I64))
                      (&
                        (ast.ast-type-cons
                          (&
                            (ast.AstType.Struct
                              (ci.intern "OutgoingMemoryPayload")))
                          (&
                            (ast.ast-type-cons
                              (& (ast.AstType.I64))
                              (& (ast.ast-type-list-new)))))))))))))
        (& (ast.AstType.I64)))]
    [externs : ir.CompilerIrExternSeq
      (ir.compiler-ir-extern-seq1
        (ir.CompilerIrExtern.Extern
          name
          name
          "c-memory-outgoing-fixture"
          (owned_view.compiler-owned-shared-view signature)
          (ast.AstExternAbi.C)
          name
          (ast.ast-extern-link-input-list-new)
          false
          (ir.CompilerIrReturnStorage.None)
          false
          (ir.CompilerIrGlobalStorage.Word)))]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        bases
        (ir.compiler-ir-function-seq-empty)
        externs)]
    [types : regalloc.CompilerRegVarTypes
      (regalloc.compiler-reg-var-types-insert
        (regalloc.compiler-reg-var-types-empty)
        1
        signature)]
    [args : String
      (match target
        [(be_state.CompilerBackendTarget.Linux)
          (str_cat.str-cat
            "1, 2, 3, 4, %0, "
            (string.int->string size)
            ", unit, 9")]
        [(be_state.CompilerBackendTarget.Windows) "1, 2, 3, 4, %0, 9"])]
    [calls : (__tl_dyn-array ir.CompilerIrInstr)
      (__tl_make-array
        (irt.instr
          (str_cat.str-cat
            "%2 = call c-memory-outgoing-fixture("
            args
            ") : i64"))
        (irt.instr
          (str_cat.str-cat "tailcall c-memory-outgoing-fixture(" args ") : i64"))
        (irt.instr (str_cat.str-cat "%2 = call_c* %1(" args ") : i64"))
        (irt.instr
          (str_cat.str-cat
            "call_c_store c-memory-outgoing-fixture("
            args
            ") -> %3 []"))
        (irt.instr (str_cat.str-cat "call_c_store* %1(" args ") -> %3 []")))]
    [position : i64 0]
    [ok : bool true]
    ;; SysV puts the complete payload on the stack. Its five scalar arguments
    ;; still fit registers. Win64 passes the aggregate by address and spills
    ;; it and the final scalar after four register arguments, using two words.
    ;; Shadow space is separate; result-store forms add their result-base save.
    (while (< position 5)
      (set!
        ok
        (and
          ok
          (=
            (be_calls.compiler-backend-instr-outgoing-stack-space
              bases
              target
              (owned_view.compiler-owned-array-element-shared-view
                calls
                position)
              types
              (be_state.CompilerBackendGlobalTypeTable.Empty)
              index)
            (+
              (match target
                [(be_state.CompilerBackendTarget.Linux)
                  (* (/ (+ size 15) 16) 16)]
                [(be_state.CompilerBackendTarget.Windows) 16])
              (if (>= position 3)
                16
                0)))))
      (set! position (+ position 1)))
    ok))

(define (compiler-backend-c-abi-memory-outgoing-ok?) : bool
  (and
    (compiler-backend-c-abi-memory-outgoing-size-ok?
      be_state.CompilerBackendTarget.Linux
      24)
    ;; This exceeds the former argument-count bound for an indirect call.
    (compiler-backend-c-abi-memory-outgoing-size-ok?
      be_state.CompilerBackendTarget.Linux
      200)
    (compiler-backend-c-abi-memory-outgoing-size-ok?
      be_state.CompilerBackendTarget.Windows
      24)
    (compiler-backend-c-abi-memory-outgoing-size-ok?
      be_state.CompilerBackendTarget.Windows
      200)))

(define (compiler-backend-c-abi-sysv-two-register-return-source) : String
  "(defstruct PairI64 (:repr c) (lo i64) (hi i64))
(defstruct MixIF (:repr c) (tag u64) (value f64))
(defstruct PairF64 (:repr c) (x f64) (y f64))
(extern (pair-i64-make [seed : i64]) : PairI64 (:symbol \"tl_cabi_pair_i64_make\"))
(extern pair-i64-maker (:symbol \"tl_cabi_pair_i64_make_ptr\") : (CFunc non-null (-> i64 PairI64)))
(extern (mix-if-make [seed : i64]) : MixIF (:symbol \"tl_cabi_mix_if_make\"))
(extern (pair-f64-make [seed : i64]) : PairF64 (:symbol \"tl_cabi_pair_f64_make\"))
(define (main) : i64
  (let
    [pair : PairI64 (pair-i64-make 1)]
    [pair2 : PairI64 (pair-i64-maker 4)]
    [mixed : MixIF (mix-if-make 2)]
    [floats : PairF64 (pair-f64-make 3)]
    (+ pair.lo
      (+ pair.hi
        (+ pair2.lo
          (+ pair2.hi
            (+ (cast mixed.tag : i64)
              (+ (cast mixed.value : i64)
                (+ (cast floats.x : i64)
                   (cast floats.y : i64))))))))))")

(define (compiler-backend-c-abi-sysv-two-register-return-linux-ok?) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-c-abi-sysv-two-register-return-source)
    (be_state.CompilerBackendTarget.Linux))
    [(Ok asm)
      (be_state.backend-and8
        (asm-has? asm ".extern tl_cabi_pair_i64_make\n")
        (asm-has? asm ".extern tl_cabi_pair_i64_make_ptr\n")
        (asm-has? asm ".extern tl_cabi_mix_if_make\n")
        (asm-has? asm ".extern tl_cabi_pair_f64_make\n")
        (asm-has? asm "    call tl_cabi_pair_i64_make\n")
        (compiler-backend-register-indirect-call? asm)
        (be_state.backend-and8
          (asm-has? asm "    movq %rdx, 8(%r11)\n")
          (asm-has? asm "    movsd %xmm0, 8(%r11)\n")
          (asm-has? asm "    movsd %xmm1, 8(%r11)\n")
          (asm-lacks? asm "two-register aggregate return ABI")
          (not
            (let
              [needle (compiler-backend-todo-marker)]
              (asm-has? asm needle)))
          true
          true
          true)
        true)]
    [(Err _) false]))

