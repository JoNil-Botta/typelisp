(define (compiler-backend-total-switch-source) : String
  "(defenum TotalSwitchValue
  (Zero)
  (One)
  (Two)
  (Three)
  (Four)
  (Five))
(define (total-switch-score [value : TotalSwitchValue]) : i64
  (match value
    [(TotalSwitchValue.Zero) 1]
    [(TotalSwitchValue.One) 2]
    [(TotalSwitchValue.Two) 3]
    [(TotalSwitchValue.Three) 4]
    [(TotalSwitchValue.Four) 5]
    [(TotalSwitchValue.Five) 6]))
(define keep-total-switch : (-> TotalSwitchValue i64) total-switch-score)
(define (main) : i64 0)")

(define (compiler-backend-total-switch-lowered-opt2-asm-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (compiler-backend-total-switch-source)
    (be_state.CompilerBackendTarget.Linux))
    [(Ok asm)
      ;; Inspect the dispatch function: unrelated runtime helpers can have
      ;; unsigned range checks of their own.
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_f0")]
        (and
          (asm-has? body "_switch_table")
          (asm-lacks? body "    cmpq $5" "    ja " "match_total_trap(%rip)")))]
    [(Err _) false]))

(define (compiler-backend-total-switch-asm-ok?) : bool
  (match (backend.compiler-backend-emit-program-linux
    (compiler-backend-total-switch-test-program))
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "main")]
        (and
          ;; A non-PIC image reads the case address itself out of the table and
          ;; transfers through the register it landed in.
          (asm-has? body "    movl .Lf0_entry_switch_table(,%r" ",4), %r")
          (asm-has? body "    jmp *%r")
          (asm-lacks? body "    cmpq $5" "    ja " "leaq .Lf0_match_total_trap")
          (asm-lacks? body "    movslq (")
          (= (backend.compiler-backend-string-count asm "    .long .Lf0_") 6)
          (asm-has?
            asm
            "    .section .rodata\n    .balign 4\n.Lf0_entry_switch_table:\n"
            "    .long .Lf0_zero\n"
            "    .long .Lf0_five\n")))]
    [(Err _) false]))

(define (compiler-backend-forwarded-total-switch-asm-ok?) : bool
  (match (backend.compiler-backend-emit-program-linux
    (compiler-backend-forwarded-total-switch-test-program))
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "main")]
        (and
          (asm-has? body "    movl .Lf0_entry_switch_table(,%r" ",4), %r")
          (asm-has? body "    jmp *%r")
          (asm-lacks? body "    cmpq $5" "    ja ")))]
    [(Err _) false]))

(define (compiler-backend-total-switch-pic-asm-ok?) : bool
  (match (backend.compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt-and-profile-state-backend-state
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active))
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-total-switch-test-program)
    (be_state.CompilerBackendTarget.Linux)
    (Scalar)
    (ir.compiler-source-spans-empty)
    true
    false
    (profile_state.compiler-profile-state-new))
    [(Ok output)
      (let
        [asm : String output.asm]
        [body : String (compiler-backend-asm-function-body asm "main")]
        (and
          (asm-has?
            body
            "    leaq .Lf0_entry_switch_table(%rip), "
            "    movslq ("
            "    addq ")
          (asm-lacks? body "    cmpq $5" "    ja " "leaq .Lf0_match_total_trap")
          (asm-has?
            asm
            "    .text\n"
            "    .long .Lf0_zero - .Lf0_entry_switch_table\n")))]
    [(Err _) false]))

(define (compiler-backend-total-switch-compact-os-asm-ok?) : bool
  (cbi.compiler-builtin-initialize-for-parse!)
  (let
    [program : ir.CompilerIrProgram
      (compiler-backend-total-switch-test-program)]
    [state-nonpic : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [state-pic : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (be_state.compiler-backend-state-set-optimize-for-size! state-nonpic true)
    (be_state.compiler-backend-state-set-optimize-for-size! state-pic true)
    (let
      [nonpic-ok : bool
        (match (backend.compiler-backend-emit-program-target-with-mode-with-pools-and-crt-and-profile-state-backend-state
          state-nonpic
          (ast.ast-node-pool-context-capture-active)
          program
          (be_state.CompilerBackendTarget.Linux)
          (Scalar)
          (ir.compiler-source-spans-empty)
          true
          false
          (profile_state.compiler-profile-state-new))
          [(Ok asm)
            (let
              [body : String (compiler-backend-asm-function-body asm "main")]
              (and
                (asm-has?
                  body
                  "    movswq .Lf0_entry_switch_table(,%r"
                  ",2), %r")
                (asm-has?
                  body
                  ".Lf0_entry_switch_base:\n    leaq .Lf0_entry_switch_base(%rip), "
                  "    addq "
                  "    jmp *%r")
                (=
                  (backend.compiler-backend-string-count asm "    .word .Lf0_")
                  6)
                (asm-has?
                  asm
                  "    .section .rodata\n    .balign 2\n.Lf0_entry_switch_table:\n"
                  "    .word .Lf0_zero - .Lf0_entry_switch_base\n"
                  "    .word .Lf0_five - .Lf0_entry_switch_base\n")))]
          [(Err _) false])]
      [pic-ok : bool
        (match (backend.compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt-and-profile-state-backend-state
          state-pic
          (ast.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-total-switch-test-program)
          (be_state.CompilerBackendTarget.Linux)
          (Scalar)
          (ir.compiler-source-spans-empty)
          true
          false
          (profile_state.compiler-profile-state-new))
          [(Ok output)
            (let
              [asm : String output.asm]
              [body : String (compiler-backend-asm-function-body asm "main")]
              (and
                (asm-has?
                  body
                  "    leaq .Lf0_entry_switch_table(%rip), "
                  "    movswq ("
                  ".Lf0_entry_switch_base:\n    leaq .Lf0_entry_switch_base(%rip), "
                  "    addq ")
                (=
                  (backend.compiler-backend-string-count asm "    .word .Lf0_")
                  6)
                (asm-has?
                  asm
                  "    .section .rodata\n    .balign 2\n.Lf0_entry_switch_table:\n"
                  "    .word .Lf0_zero - .Lf0_entry_switch_base\n")))]
          [(Err _) false])]
      (and nonpic-ok pic-ok))))

(test
  backend-total-switch-compact-os
  (test.assert-true
    (compiler-backend-total-switch-compact-os-asm-ok?)
    "-Os emits 2-byte intra-function relative switch tables for small functions"))

(define (compiler-backend-compact-os-large-copy-fallback-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (ci.intern "main")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          4
          (ir.compiler-ir-blocks-with-tail
            (compiler-backend-total-switch-return-block
              (ir.compiler-ir-label "one")
              1
              (compiler-backend-total-switch-return-block
                (ir.compiler-ir-label "two")
                2
                (compiler-backend-total-switch-return-block
                  (ir.compiler-ir-label "three")
                  3
                  (compiler-backend-total-switch-return-block
                    (ir.compiler-ir-label "four")
                    4
                    (compiler-backend-total-switch-return-block
                      (ir.compiler-ir-label "five")
                      5
                      (ir.compiler-ir-blocks
                        (ir.CompilerIrBlock.Block
                          (ir.compiler-ir-label "zero")
                          (compiler-backend-test-instr-seq-prepend
                            (CopyBytes (Var 1) (Var 2) 8192)
                            (compiler-backend-test-instr-seq-prepend
                              (Return (Some (I64 0)))
                              (ir.compiler-ir-instr-seq-empty))))
                        (compiler-backend-total-switch-trap-test-block)))))))
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "entry")
              (compiler-backend-test-instr-seq-prepend
                (TotalEnumSwitch
                  (Var 0)
                  0
                  (compiler-backend-total-switch-test-cases)
                  (ir.compiler-ir-label "match_total_trap")
                  (ir.compiler-ir-label "match_total_trap"))
                (ir.compiler-ir-instr-seq-empty))))
          Ordinary))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-compact-os-switch-phi-fallback-program) : ir.CompilerIrProgram
  (let
    [case-builder : ir.CompilerIrSwitchCaseBuilder
      (ir.compiler-ir-switch-case-builder-with-capacity 50)]
    [join-label : i64 (ir.compiler-ir-label "join")]
    [entry-label : i64 (ir.compiler-ir-label "entry")]
    (for [i (iterator.range 0 50)]
      (ir.compiler-ir-switch-case-builder-push!
        (&mut case-builder)
        (ir.CompilerIrSwitchCase.Case i join-label)))
    (let
      [join-instrs : ir.CompilerIrInstrSeq
        (compiler-backend-test-instr-seq-prepend
          (Return (Some (Var 1)))
          (ir.compiler-ir-instr-seq-empty))]
      (for [i (iterator.range 0 20)]
        (set!
          join-instrs
          (compiler-backend-test-instr-seq-prepend
            (Phi
              (+ i 1)
              (ir.compiler-ir-phi-input-seq-prepend
                (I64 (+ i 1))
                entry-label
                (& (ir.compiler-ir-phi-input-seq-empty)))
              (I64))
            join-instrs)))
      (Program
        (ir.compiler-ir-global-seq-empty)
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              (ci.intern "main")
              (ir.compiler-ir-param-seq-empty)
              (I64)
              22
              (ir.compiler-ir-blocks
                (ir.CompilerIrBlock.Block
                  entry-label
                  (compiler-backend-test-instr-seq-prepend
                    (Switch
                      (Var 0)
                      0
                      (ir.compiler-ir-switch-case-builder-to-seq case-builder)
                      join-label)
                    (ir.compiler-ir-instr-seq-empty)))
                (ir.CompilerIrBlock.Block join-label join-instrs))
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))
        (ir.compiler-ir-extern-seq-empty)
        (ir.CompilerIrReturnStorageAuthority.None)))))

(define (compiler-backend-total-switch-compact-os-fallback-asm-ok?) : bool
  (cbi.compiler-builtin-initialize-for-parse!)
  (let
    [state-copy : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [state-phi : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (be_state.compiler-backend-state-set-optimize-for-size! state-copy true)
    (be_state.compiler-backend-state-set-optimize-for-size! state-phi true)
    (let
      [copy-ok : bool
        (match (backend.compiler-backend-emit-program-target-with-mode-with-pools-and-crt-and-profile-state-backend-state
          state-copy
          (ast.ast-node-pool-context-capture-active)
          (compiler-backend-compact-os-large-copy-fallback-program)
          (be_state.CompilerBackendTarget.Linux)
          (Scalar)
          (ir.compiler-source-spans-empty)
          true
          false
          (profile_state.compiler-profile-state-new))
          [(Ok asm)
            (and
              (=
                (backend.compiler-backend-string-count asm "    .long .Lf0_")
                6)
              (=
                (backend.compiler-backend-string-count asm "    .word .Lf0_")
                0)
              (asm-has?
                asm
                "    .section .rodata\n    .balign 4\n.Lf0_entry_switch_table:\n")
              (asm-lacks? asm "_switch_base"))]
          [(Err _) false])]
      [phi-ok : bool
        (match (backend.compiler-backend-emit-program-target-with-mode-with-pools-and-crt-and-profile-state-backend-state
          state-phi
          (ast.ast-node-pool-context-capture-active)
          (compiler-backend-compact-os-switch-phi-fallback-program)
          (be_state.CompilerBackendTarget.Linux)
          (Scalar)
          (ir.compiler-source-spans-empty)
          true
          false
          (profile_state.compiler-profile-state-new))
          [(Ok asm)
            (and
              (=
                (backend.compiler-backend-string-count
                  asm
                  "    .long .Lf0_entry_switch_case_")
                50)
              (=
                (backend.compiler-backend-string-count asm "    .word .Lf0_")
                0)
              (asm-has?
                asm
                "    .section .rodata\n    .balign 4\n.Lf0_entry_switch_table:\n")
              (asm-lacks? asm "_switch_base"))]
          [(Err _) false])]
      (and copy-ok phi-ok))))

(test
  backend-total-switch-compact-os-fallback
  (test.assert-true
    (compiler-backend-total-switch-compact-os-fallback-asm-ok?)
    "-Os falls back to 4-byte switch tables when CopyBytes or switch+phi worst-case byte bound exceeds 16-bit headroom"))

(define (compiler-backend-total-switch-object-image-ok?) : bool
  (match (be_object.compiler-backend-emit-program-object-image-linux
    (compiler-backend-total-switch-test-program)
    (ir.compiler-source-spans-empty))
    [(Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList
          (owned_view.compiler-owned-shared-view image.sections)]
        [relocs : cobj.CompilerObjectRelocationList
          (owned_view.compiler-owned-shared-view image.relocations)]
        (and
          (not
            (cobj.compiler-object-section-contains-bytes?
              sections
              (& (be_object.compiler-backend-object-cmp-imm32-rax-bytes 5))))
          (cobj.compiler-object-section-contains-label?
            sections
            cobj.rodata-id
            ".Lf0_entry_switch_table_entry_5")
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (Abs64)
            ".Lf0_five")
          (cobj.compiler-object-section-contains-bytes?
            sections
            (& (be_object.compiler-backend-object-switch-indirect-jump-bytes)))))]
    [(Err _) false]))

(define (compiler-backend-spoofed-total-switch-stays-checked?) : bool
  (and
    (asm-ok?
      (backend.compiler-backend-emit-program-linux
        (compiler-backend-spoofed-total-switch-test-program))
      (has "    cmpq $5" "    ja "))
    (match (be_object.compiler-backend-emit-program-object-image-linux
      (compiler-backend-spoofed-total-switch-test-program)
      (ir.compiler-source-spans-empty))
      [(Ok image)
        (cobj.compiler-object-section-contains-bytes?
          image.sections
          (& (be_object.compiler-backend-object-cmp-imm32-rax-bytes 5)))]
      [(Err _) false])))

(define (compiler-backend-switch-asm-ok?) : bool
  (match (backend.compiler-backend-emit-program-linux
    (compiler-backend-switch-test-program))
    [(Ok asm)
      (and
        ;; T1-6 (a): `main` is a call-free leaf, so the switch scrutinee
        ;; loads from a red-zone slot (-8(%rsp)).
        (asm-has? asm "    movq -8(%rsp), %r8\n")
        (asm-has? asm "    cmpq $2, %r8\n")
        (asm-has? asm "    ja .Lf0_other\n")
        ;; Non-PIC Linux reads the case address itself out of a 4-byte-entry
        ;; table and transfers through the register it landed in.
        (asm-has? asm "    movl .Lf0_entry_switch_table(,%r" ",4), %r")
        (asm-has? asm "    jmp *%r")
        (asm-lacks? asm "    movslq (")
        ;; The table is read-only, 4-byte aligned, and holds 32-bit absolute
        ;; case addresses, not 64-bit pointers or differences.
        (asm-has?
          asm
          "    .section .rodata\n    .balign 4\n.Lf0_entry_switch_table:\n")
        (asm-has? asm "    .long .Lf0_zero\n")
        (asm-has? asm "    .long .Lf0_one\n")
        (asm-has? asm "    .long .Lf0_two\n")
        (asm-lacks? asm "    .quad .Lf0_")
        (asm-lacks? asm "    .long .Lf0_zero - .Lf0_entry_switch_table\n"))]
    [(Err _) false]))

(define (compiler-backend-switch-base-test-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (ci.intern "main")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          1
          (ir.compiler-ir-blocks
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "entry")
              (compiler-backend-test-instr-seq-prepend
                (Switch
                  (Var 0)
                  4
                  (ir.compiler-ir-switch-case-seq2
                    (Case 4 (ir.compiler-ir-label "four"))
                    (Case 5 (ir.compiler-ir-label "five")))
                  (ir.compiler-ir-label "other"))
                (ir.compiler-ir-instr-seq-empty)))
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "four")
              (compiler-backend-test-instr-seq-prepend
                (Return (Some (I64 4)))
                (ir.compiler-ir-instr-seq-empty)))
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "five")
              (compiler-backend-test-instr-seq-prepend
                (Return (Some (I64 5)))
                (ir.compiler-ir-instr-seq-empty)))
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "other")
              (compiler-backend-test-instr-seq-prepend
                (Return (Some (I64 0)))
                (ir.compiler-ir-instr-seq-empty))))
          Ordinary))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-switch-base-asm-ok?) : bool
  (match (backend.compiler-backend-emit-program-linux
    (compiler-backend-switch-base-test-program))
    [(Ok asm)
      (and
        ;; T1-6 (a): `main` is a call-free leaf, so the switch scrutinee
        ;; loads from a red-zone slot (-8(%rsp)).
        (asm-has? asm "    movq -8(%rsp), %r8\n")
        (asm-has? asm "    subq $4, %r8\n")
        (asm-has? asm "    cmpq $1, %r8\n")
        (asm-has? asm "    ja .Lf0_other\n")
        ;; The base subtraction leaves the entry index, and the dispatch reads
        ;; the 4-byte absolute case address out of the table.
        (asm-has? asm "    movl .Lf0_entry_switch_table(,%r" ",4), %r")
        (asm-has? asm "    jmp *%r"))]
    [(Err _) false]))

(define (compiler-backend-switch-bad-shape-program) : ir.CompilerIrProgram
