(define (compiler-backend-scratch-vreg-select-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.compiler-ir-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.ir-instr-select
          3
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.Var 2)
          0
          (compiler_ast_types.AstType.I64))
        compiler_ir_types.CompilerIrInstrList.Nil))
    compiler_ir_types.CompilerIrBlockList.Nil))

;; The select result may reuse the dying true operand's ordinary home. In that
;; shape emission must stage the result in a planned scratch register distinct
;; from every select home; otherwise loading the false value destroys the true
;; value before cmovne reads it.
(define (compiler-backend-scratch-vreg-select-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-rdi))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-rax))
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          2
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            3
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-rax))
          compiler_regalloc.CompilerRegAssignmentList.Nil)))))

(define (compiler-backend-scratch-vreg-select-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-select-assignments)]
      (match (compiler-backend-scratch-test-result
        "scratch_vreg_select"
        (compiler-backend-scratch-vreg-select-blocks)
        4
        assignments)
        [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
          (let
            [result : String
              (compiler_regalloc.compiler-reg-scratch-plan-register plan 0 0)]
            [value : String
              (compiler_regalloc.compiler-reg-scratch-plan-register plan 0 1)]
            [test : String
              (compiler_regalloc.compiler-reg-scratch-plan-register plan 0 2)]
            (match (compiler_backend.compiler-backend-emit-scalar-select
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              assignments
              3
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ast_types.AstType.I64)
              result
              value
              test
              (compiler_diagnostic.compiler-diagnostic-at-start "" ""))
              [(compiler_backend.ResultCompilerBackend.Ok asm)
                (and
                  (= (compiler_regalloc.compiler-reg-scratch-plan-count plan) 3)
                  (not (string.eq result ""))
                  (not (string.eq value ""))
                  (not (string.eq test ""))
                  (not (string.eq result value))
                  (not (string.eq result test))
                  (not (string.eq value test))
                  (not (string.eq result "%rax"))
                  (not (string.eq result "%rdi"))
                  (not (string.eq result "%r12"))
                  (compiler_backend.compiler-backend-string-contains?
                    asm
                    (str_cat.str-cat
                      "    cmovne %rax, "
                      (str_cat.str-cat result "\n")))
                  (not
                    (compiler_backend.compiler-backend-string-contains?
                      asm
                      "    cmovne %rax, %rax\n")))]
              [(compiler_backend.ResultCompilerBackend.Err _) false]))]))
    true))

(define (compiler-backend-scratch-vreg-result-contains?
  [result : compiler_backend.ResultCompilerBackend]
  [needle : String]) : bool
  (match result
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.compiler-backend-string-contains? asm needle)]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-scratch-vreg-scalar-spill-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Spill -8))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Spill -16))
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          2
          (compiler_regalloc.CompilerRegLocation.Spill -24))
        compiler_regalloc.CompilerRegAssignmentList.Nil))))

(define (compiler-backend-scratch-vreg-scalar-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-scalar-spill-assignments)]
      [shift-register-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            0
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r12))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              1
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-r13))
            (compiler_regalloc.compiler-reg-assignment-cons
              (compiler_regalloc.CompilerRegAssignment
                2
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-rcx))
              compiler_regalloc.CompilerRegAssignmentList.Nil)))]
      [fallthrough : compiler_backend.CompilerBackendMaybeLabel
        (compiler_backend.CompilerBackendMaybeLabel.No)]
      [div-guard : String
        (compiler_backend.compiler-backend-div-overflow-guard-asm-with-plan
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler_ast_types.AstType.I64)
          "%r8"
          "%r12"
          "%r13")]
      [literal-ok : bool
        (match (compiler_backend.compiler-backend-binop-literal-divmod-asm-here-with-plan
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler_ir_types.CompilerIrBinOp.Mod)
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ast_types.AstType.I64)
          "%r12"
          "%r13"
          "%r14")
          [(compiler_backend.CompilerBackendMaybeAsm.Some asm)
            (and
              (compiler_backend.compiler-backend-string-contains? asm "%r12")
              (compiler_backend.compiler-backend-string-contains? asm "%r13")
              ;; Signed literal divmod consumes magic + one SRC copy; the old
              ;; quotient-sign mask/tertiary scratch is deliberately unused.
              (not
                (compiler_backend.compiler-backend-string-contains? asm "%r14")))]
          [(compiler_backend.CompilerBackendMaybeAsm.No) false])]
      (and
        (not
          (string.eq
            (compiler_backend.compiler-backend-scavenge-binop-return-rhs-reg
              assignments
              (compiler_ir_types.CompilerIrBinOp.Eq)
              (compiler_ir_types.CompilerIrValue.Var 1)
              "%rax")
            "%rax"))
        (compiler_backend.compiler-backend-string-contains? div-guard "%r12")
        (compiler_backend.compiler-backend-string-contains? div-guard "%r13")
        literal-ok
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-binop-spill-direct-shift
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            assignments
            2
            (compiler_ir_types.CompilerIrBinOp.Shl
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64)
            (compiler_ast_types.AstType.I64)
            "%rcx"
            "%r14")
          "    movq -16(%rbp), %rcx\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-binop-spill-direct-shift
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            assignments
            2
            (compiler_ir_types.CompilerIrBinOp.Shl
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64)
            (compiler_ast_types.AstType.I64)
            "%rcx"
            "%r14")
          "    shlq %cl, %r14\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-binop-spill-direct-shift
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            shift-register-assignments
            2
            (compiler_ir_types.CompilerIrBinOp.Shl
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64)
            (compiler_ast_types.AstType.I64)
            "%rcx"
            "%r14")
          "    movq %r14, %rcx\n")
        (not
          (compiler-backend-scratch-vreg-result-contains?
            (compiler_backend.compiler-backend-emit-binop-spill-direct-shift
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              shift-register-assignments
              2
              (compiler_ir_types.CompilerIrBinOp.Shl
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64)
              (compiler_ast_types.AstType.I64)
              "%rcx"
              "%r14")
            "    shlq %cl, %rcx\n"))
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-branch-with-plan
            assignments
            "scratch_control"
            (compiler_ir_types.CompilerIrValue.Global
              (ci.intern "scratch_condition"))
            (compiler_ir_types.compiler-ir-label "yes")
            (compiler_ir_types.compiler-ir-label "no")
            fallthrough
            "%r14")
          "    testq %r14, %r14\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-compare-branch-with-plan
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            assignments
            "scratch_compare"
            (compiler_ir_types.CompilerIrBinOp.Eq)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64)
            (compiler_ir_types.compiler-ir-label "yes")
            (compiler_ir_types.compiler-ir-label "no")
            fallthrough
            "%r14"
            "%r15")
          "    movq -16(%rbp), %r15\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-compare-branch-with-plan
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            assignments
            "scratch_compare_collision"
            (compiler_ir_types.CompilerIrBinOp.Eq)
            (compiler_ir_types.CompilerIrValue.Global (ci.intern "scratch_lhs"))
            (compiler_ir_types.CompilerIrValue.Global (ci.intern "scratch_rhs"))
            (compiler_ast_types.AstType.I64)
            (compiler_ir_types.compiler-ir-label "yes")
            (compiler_ir_types.compiler-ir-label "no")
            fallthrough
            "%r14"
            "%r14")
          "    cmpq ")
        (not
          (compiler-backend-scratch-vreg-result-contains?
            (compiler_backend.compiler-backend-emit-compare-branch-with-plan
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              assignments
              "scratch_compare_collision"
              (compiler_ir_types.CompilerIrBinOp.Eq)
              (compiler_ir_types.CompilerIrValue.Global
                (ci.intern "scratch_lhs"))
              (compiler_ir_types.CompilerIrValue.Global
                (ci.intern "scratch_rhs"))
              (compiler_ast_types.AstType.I64)
              (compiler_ir_types.compiler-ir-label "yes")
              (compiler_ir_types.compiler-ir-label "no")
              fallthrough
              "%r14"
              "%r14")
            "    cmpq %r14, %r14\n"))
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-binop-direct-compare
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            assignments
            2
            "%r14"
            (compiler_ir_types.CompilerIrBinOp.Eq)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64)
            "%r14")
          "    cmpq ")
        (not
          (compiler-backend-scratch-vreg-result-contains?
            (compiler_backend.compiler-backend-emit-binop-direct-compare
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              assignments
              2
              "%r14"
              (compiler_ir_types.CompilerIrBinOp.Eq)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64)
              "%r14")
            "    cmpq %r14, %r14\n"))
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-load-compare-branch-with-plan
            assignments
            "scratch_load_compare"
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrBinOp.Eq)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64)
            (compiler_ir_types.compiler-ir-label "yes")
            (compiler_ir_types.compiler-ir-label "no")
            fallthrough
            "%r14"
            "%r15")
          "    cmpq %r15, (%r14)\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-gep-load-compare-branch-with-plan
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            assignments
            "scratch_gep_compare"
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 2)
            (compiler_ast_types.AstType.I64)
            (compiler_ir_types.CompilerIrBinOp.Eq)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64)
            (compiler_ir_types.compiler-ir-label "yes")
            (compiler_ir_types.compiler-ir-label "no")
            fallthrough
            "%r14"
            "%r15")
          "    cmpq %r15, 16(%r14)\n")
        ;; #6250: a fused gep+load bit test must emit testq (bit semantics),
        ;; never cmpq (equality semantics).
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-gep-load-compare-branch-with-plan
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            assignments
            "scratch_gep_compare"
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 2)
            (compiler_ast_types.AstType.I64)
            (compiler_ir_types.CompilerIrBinOp.BitTestEq)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64)
            (compiler_ir_types.compiler-ir-label "yes")
            (compiler_ir_types.compiler-ir-label "no")
            fallthrough
            "%r14"
            "%r15")
          "    testq %r15, 16(%r14)\n")
        (not
          (compiler-backend-scratch-vreg-result-contains?
            (compiler_backend.compiler-backend-emit-gep-load-compare-branch-with-plan
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              assignments
              "scratch_gep_compare"
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.I64 2)
              (compiler_ast_types.AstType.I64)
              (compiler_ir_types.CompilerIrBinOp.BitTestEq)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64)
              (compiler_ir_types.compiler-ir-label "yes")
              (compiler_ir_types.compiler-ir-label "no")
              fallthrough
              "%r14"
              "%r15")
            "    cmpq %r15, 16(%r14)\n"))
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-load-compare-branch-with-plan
            assignments
            "scratch_load_compare"
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrBinOp.BitTestNe)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64)
            (compiler_ir_types.compiler-ir-label "yes")
            (compiler_ir_types.compiler-ir-label "no")
            fallthrough
            "%r14"
            "%r15")
          "    testq %r15, (%r14)\n")
        (not
          (compiler-backend-scratch-vreg-result-contains?
            (compiler_backend.compiler-backend-emit-load-compare-branch-with-plan
              assignments
              "scratch_load_compare"
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrBinOp.BitTestNe)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64)
              (compiler_ir_types.compiler-ir-label "yes")
              (compiler_ir_types.compiler-ir-label "no")
              fallthrough
              "%r14"
              "%r15")
            "    cmpq %r15, (%r14)\n"))
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-unop-with-plan
            assignments
            2
            (compiler_ir_types.CompilerIrUnOp.Neg)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.I64)
            "%r14")
          "    negq %r14\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler_backend.compiler-backend-emit-cpuid
            assignments
            2
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            1
            "%r14")
          "    movq %rbx, %r14\n    cpuid\n")))
    true))

(define (compiler-backend-stream-home-carries-grown-head-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [previous-stream-home : arena.Arena
      (compiler_backend.compiler-backend-test-get-compiler-backend-assembly-stream-home-arena)]
    [home : arena.Arena (arena.make)]
    [scratch : arena.Arena (arena.make)]
    [_set-home : unit
      (unsafe
        (arena.set! home))]
    ;; Leave eight bytes in the Linux root segment. Appending even this
    ;; one-byte retained chunk must advance the home chain without touching
    ;; 64 MiB of pages, making the stale-handle regression cheap to exercise.
    [_fill-home : i64 (compiler-backend-test-runtime-alloc 67108792)]
    [home-before-copy : arena.Arena (arena.current)]
    [_set-scratch : unit
      (unsafe
        (arena.set! scratch))]
    [copied : text_buf.TextBuf
      (in-arena home-before-copy (text_buf.append (text_buf.empty) "x"))]
    [_carry-home : unit
      (compiler_backend.compiler-backend-assembly-stream-carry-home-current!
        home-before-copy)]
    [carried-home : arena.Arena
      (compiler_backend.compiler-backend-test-get-compiler-backend-assembly-stream-home-arena)]
    [ok : bool
      (and
        (arena.eq? (arena.current) scratch)
        (not (text_buf.empty? copied))
        (not (arena.eq? carried-home home-before-copy)))]
    (begin
      (compiler_backend.compiler-backend-test-set-compiler-backend-assembly-stream-home-arena!
        previous-stream-home)
      (unsafe
        (arena.set! caller))
      (unsafe
        (arena.destroy scratch))
      (unsafe
        (arena.destroy carried-home))
      ok)))

(define (compiler-backend-self-test) : i64
  (if (and
    (compiler-backend-lazy-table-storage-ok?)
    (compiler_backend.backend-and8
      (and
        (compiler_backend.compiler-backend-global-type-table-ok?)
        (compiler-backend-target-model-ok? (compiler-backend-smoke-source)))
      (compiler-backend-array-access-asm-ok?)
      (compiler-backend-make-array-ok?)
      (compiler-backend-source-ok? (compiler-backend-smoke-source))
      (and
        (compiler-backend-object-image-shape-ok?)
        (compiler-backend-object-tlci-macro-entry-gate-ok?)
        (compiler-backend-object-phi-edge-copy-ok?)
        (compiler-backend-coff-renders-real-text-ok?)
        (compiler-backend-windows-object-entry-unwind-ok?)
        (compiler-backend-windows-object-unit-main-zero-ok?)
        (compiler-backend-windows-object-load-stores-dst-ok?)
        (compiler-backend-windows-object-stack-param-spill-ok?)
        (compiler-backend-elf-renders-real-text-ok?)
        (compiler-backend-pic-ok?)
        (compiler-backend-deterministic-ok? (compiler-backend-smoke-source)))
      (compiler-backend-string-ok?)
      (and
        (compiler-backend-memory-op-ok?)
        (compiler-backend-scalar-load-scratch-ok?)
        (compiler-backend-float-load-scratch-ok?)
        (compiler-backend-gep-float-load-scratch-ok?)
        (compiler-backend-address-mode-fusion-ok?)
        (compiler-backend-scratch-staging-direct-home-shape-ok?)
        (compiler-backend-scavenge-pooled-r10-r11-ok?)
        (compiler-backend-binop-exclude-keeps-pooled-r10-r11-ok?)
        (compiler-backend-scavenge-exclude-with-keeps-pooled-r10-r11-ok?)
        (compiler-backend-scavenge-operand-excludes-keep-pooled-ok?)
        (compiler-backend-divmod-excludes-keep-scratch-fallbacks-ok?)
        (compiler-backend-scavenge-special-reg-bit-map-ok?)
        (compiler-backend-emergency-vector-width-ok?)
        (compiler-backend-scavenge-widened-pool-picks-rsi-ok?)
        (compiler-backend-scavenge-win64-rsi-rdi-plan-mask-ok?)
        (compiler-backend-scratch-vreg-call-target-plan-ok?)
        (compiler-backend-scratch-vreg-switch-plan-ok?)
        (compiler-backend-scratch-vreg-aggregate-plan-ok?)
        (compiler-backend-scratch-vreg-phi-plan-ok?)
        (compiler-backend-scratch-vreg-emission-uses-plan-ok?)
        (compiler-backend-scratch-vreg-memory-emission-uses-plan-ok?)
        (compiler-backend-scratch-vreg-aggregate-copy-c-emission-uses-plan-ok?)
        (compiler-backend-scratch-vreg-future-window-ok?)
        (compiler-backend-scratch-vreg-c-abi-return-plan-ok?)
        (compiler-backend-scratch-vreg-bounds-plan-ok?)
        (compiler-backend-scratch-vreg-fused-sibling-plan-ok?)
        (compiler-backend-scratch-vreg-memory-plan-ok?)
        (compiler-backend-scratch-vreg-copy-xmm-plan-ok?)
        (compiler-backend-scratch-vreg-c-memory-plan-ok?)
        (compiler-backend-scratch-vreg-float-memory-plan-ok?)
        (compiler-backend-scratch-vreg-float-memory-emission-uses-plan-ok?)
        (compiler-backend-scratch-vreg-float-compute-plan-ok?)
        (compiler-backend-scratch-vreg-float-compute-emission-uses-plan-ok?)
        (compiler-backend-scratch-vreg-tail-target-avoids-callee-saved-ok?)
        (compiler-backend-scratch-vreg-simd-plan-ok?)
        (compiler-backend-scratch-vreg-indexed-simd-plan-ok?)
        (compiler-backend-scratch-vreg-simd-emission-uses-plan-ok?)
        (compiler-backend-scratch-vreg-conversion-plan-ok?)
        (compiler-backend-scratch-vreg-conversion-emission-uses-plan-ok?)
        (compiler-backend-scratch-vreg-scalar-plan-ok?)
        (compiler-backend-scratch-vreg-scalar-shift-plan-ok?)
        (compiler-backend-scratch-vreg-scalar-return-plan-ok?)
        (compiler-backend-scratch-vreg-scalar-control-plan-ok?)
        (compiler-backend-scratch-vreg-select-plan-ok?)
        (compiler-backend-scratch-vreg-scalar-emission-uses-plan-ok?)
        (compiler-backend-scratch-vreg-incomplete-group-fallback-ok?)
        (compiler-backend-scratch-vreg-constraint-shapes-ok?)
        (compiler-backend-scavenge-emergency-respects-exclude-ok?)
