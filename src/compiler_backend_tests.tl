          (compiler-backend-avx512-mask-spill-reduces
            0
            (compiler-backend-avx512-mask-spill-sums))))
      CompilerIrBlockList.Nil)))

(define (compiler-backend-maybe-location-mask-stack?
  [location : CompilerRegMaybeLocation]) : bool
  (match location
    [(CompilerRegMaybeLocation.Some found)
      (match found
        [(CompilerRegLocation.Spill _) true]
        [_ false])]
    [(CompilerRegMaybeLocation.No) true]))

(define (compiler-backend-avx512-mask-spill-assignment?
  [assignments : CompilerRegAssignmentList]
  [var : i64]) : bool
  (if (> var 6)
    false
    (or
      (compiler-backend-maybe-location-mask-stack?
        (compiler-reg-assignment-lookup assignments var))
      (compiler-backend-avx512-mask-spill-assignment? assignments (+ var 1)))))

(define (compiler-backend-avx512-mask-spill-plan-ok?) : bool
  (match (compiler-reg-plan-function
    (compiler-backend-avx512-mask-spill-function))
    [(CompilerRegPlan.Plan assignments _ _ _ _ _)
      (compiler-backend-avx512-mask-spill-assignment? assignments 0)]))

(define (compiler-backend-avx512-mask-spill-compile-ok?) : bool
  (match (compiler-backend-emit-program-target-with-mode
    (compiler-backend-vector-home-program
      (compiler-backend-avx512-mask-spill-function))
    (CompilerBackendTarget.Linux)
    (CompilerBackendMode.Avx512)
    (compiler-source-spans-empty)
    true)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-avx512-mask-spill-plan-ok?)
        (compiler-backend-string-contains? asm "kmovw")
        (not
          (compiler-backend-string-contains?
            asm
            "mask spills are not implemented")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-mask-spill-ok?) : bool
  (and
    (compiler-backend-avx512-mask-spill-direct-ok?)
    (compiler-backend-avx512-mask-spill-plan-ok?)
    (compiler-backend-avx512-mask-spill-compile-ok?)))

(define (compiler-backend-vector-call-lifetime-spill-ok?) : bool
  (match (compiler-backend-emit-program-target-with-mode
    (compiler-backend-vector-home-program
      (compiler-backend-vector-call-lifetime-function))
    (CompilerBackendTarget.Linux)
    (CompilerBackendMode.Avx2)
    (compiler-source-spans-empty)
    true)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    call _tl_side_effect\n")
        (compiler-backend-string-contains? asm "    vmovdqu %ymm14, 16(%rsp)\n")
        (compiler-backend-string-contains? asm "    vmovdqu 16(%rsp), %ymm14\n")
        (compiler-backend-string-contains?
          asm
          "    vpaddq 16(%rsp), %ymm14, %ymm6\n"))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-vector-load-binop-fold-function
  [name : String]
  [op : CompilerIrBinOp]
  [load-on-lhs : bool]) : CompilerIrFunction
  (let
    [lhs : CompilerIrValue
      (if load-on-lhs
        (CompilerIrValue.Var 1)
        (CompilerIrValue.Var 0))]
    [rhs : CompilerIrValue
      (if load-on-lhs
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1))]
    (CompilerIrFunction.Function
      (ci.intern name)
      CompilerIrParamList.Nil
      (AstType.Unit)
      3
      (compiler-ir-block-cons
        (compiler-ir-block
          "entry"
          (compiler-ir-instr-cons
            (CompilerIrInstr.Splat 0 (CompilerIrValue.I64 7) 4 (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.VectorLoad
                1
                (CompilerIrValue.I64 0)
                (CompilerIrValue.I64 0)
                4
                (AstType.I64))
              (compiler-ir-instr-cons
                (ir-instr-vector-bin-op 2 op lhs rhs 4 (AstType.I64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Return CompilerIrMaybeValue.No)
                  CompilerIrInstrList.Nil)))))
        CompilerIrBlockList.Nil))))

(define (compiler-backend-vector-load-binop-fold-program
  [op : CompilerIrBinOp]
  [load-on-lhs : bool]) : CompilerIrProgram
  (compiler-backend-vector-home-program
    (compiler-backend-vector-load-binop-fold-function
      "vector_load_binop_fold"
      op
      load-on-lhs)))

(define (compiler-backend-vector-load-binop-folds?
  [op : CompilerIrBinOp]
  [load-on-lhs : bool]
  [mnemonic : String]) : bool
  (match (compiler-backend-emit-program-target-with-mode
    (compiler-backend-vector-load-binop-fold-program op load-on-lhs)
    (CompilerBackendTarget.Linux)
    (CompilerBackendMode.Avx2)
    (compiler-source-spans-empty)
    true)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    " mnemonic " (%r8), "))
        (not (compiler-backend-string-contains? asm "    vmovdqu (%r8), "))
        (not
          (compiler-backend-string-contains?
            asm
            (str_cat.str-cat "    " mnemonic " (%rax), "))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-vector-load-binop-does-not-fold?
  [op : CompilerIrBinOp]
  [load-on-lhs : bool]
  [mnemonic : String]) : bool
  (match (compiler-backend-emit-program-target-with-mode
    (compiler-backend-vector-load-binop-fold-program op load-on-lhs)
    (CompilerBackendTarget.Linux)
    (CompilerBackendMode.Avx2)
    (compiler-source-spans-empty)
    true)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    vmovdqu (%r8), ")
        (not
          (compiler-backend-string-contains?
            asm
            (str_cat.str-cat "    " mnemonic " (%r8), ")))
        (not (compiler-backend-string-contains? asm "    vmovdqu (%rax), ")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-vector-load-binop-folding-ok?) : bool
  (and
    (compiler-backend-vector-load-binop-folds?
      (CompilerIrBinOp.Add)
      true
      "vpaddq")
    (compiler-backend-vector-load-binop-folds?
      (CompilerIrBinOp.Sub)
      false
      "vpsubq")
    (compiler-backend-vector-load-binop-does-not-fold?
      (CompilerIrBinOp.Sub)
      true
      "vpsubq")))

(define (compiler-backend-vector-binop-test-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%vec6"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        1
        (CompilerRegLocation.Register "%vec7"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%vec8"))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-avx2-vector-binop-emits?
  [op : CompilerIrBinOp]
  [elem-ty : AstType]
  [lanes : i64]
  [want : String]) : bool
  (match (compiler-backend-emit-avx2-vector-binop
    (compiler-backend-vector-binop-test-assignments)
    2
    op
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    lanes
    elem-ty
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm) (string.eq asm want)]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-vector-binop-emits?
  [op : CompilerIrBinOp]
  [elem-ty : AstType]
  [lanes : i64]
  [want : String]) : bool
  (match (compiler-backend-emit-avx512-vector-binop
    (compiler-backend-vector-binop-test-assignments)
    2
    op
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    lanes
    elem-ty
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm) (string.eq asm want)]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx2-vector-binop-diagnostic?
  [op : CompilerIrBinOp]
  [elem-ty : AstType]
  [lanes : i64]
  [want : String]) : bool
  (match (compiler-backend-emit-avx2-vector-binop
    (compiler-backend-vector-binop-test-assignments)
    2
    op
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    lanes
    elem-ty
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Err diag)
      (string.eq (compiler-diagnostic-message (box-get diag)) want)]
    [(ResultCompilerBackend.Ok _) false]))

(define (compiler-backend-avx512-vector-binop-diagnostic?
  [op : CompilerIrBinOp]
  [elem-ty : AstType]
  [lanes : i64]
  [want : String]) : bool
  (match (compiler-backend-emit-avx512-vector-binop
    (compiler-backend-vector-binop-test-assignments)
    2
    op
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    lanes
    elem-ty
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Err diag)
      (string.eq (compiler-diagnostic-message (box-get diag)) want)]
    [(ResultCompilerBackend.Ok _) false]))

(define (compiler-backend-vector-bitwise-binop-ok?) : bool
  (and
    (backend-and8
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.Sub)
        (AstType.F32)
        8
        "    vsubps %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.BitAnd)
        (AstType.I64)
        4
        "    vpand %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.BitAnd)
        (AstType.U8)
        32
        "    vpand %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.BitOr)
        (AstType.I32)
        8
        "    vpor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.BitOr)
        (AstType.I16)
        16
        "    vpor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.BitXor)
        (AstType.U64)
        4
        "    vpxor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.BitXor)
        (AstType.I8)
        32
        "    vpxor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-diagnostic?
        (CompilerIrBinOp.BitAnd)
        (AstType.F64)
        4
        "backend: unsupported AVX2 vector binary op"))
    (backend-and8
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.Sub)
        (AstType.F32)
        16
        "    vsubps %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.BitAnd)
        (AstType.I64)
        8
        "    vpandq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.BitAnd)
        (AstType.U8)
        64
        "    vpandd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.BitOr)
        (AstType.U64)
        8
        "    vporq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.BitOr)
        (AstType.I16)
        32
        "    vpord %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.BitXor)
        (AstType.I64)
        8
        "    vpxorq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.BitXor)
        (AstType.I8)
        64
        "    vpxord %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-diagnostic?
        (CompilerIrBinOp.BitOr)
        (AstType.F64)
        8
        "backend: unsupported AVX-512 vector binary op"))))

(define (compiler-backend-vector-shift-binop-ok?) : bool
  (and
    (backend-and8
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.Shl)
        (AstType.I32)
        8
        "    vpsllvd %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.Shr)
        (AstType.I32)
        8
        "    vpsravd %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.Shr)
        (AstType.U32)
        8
        "    vpsrlvd %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.Shl)
        (AstType.I64)
        4
        "    vpsllvq %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.Shr)
        (AstType.U64)
        4
        "    vpsrlvq %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (CompilerIrBinOp.Shr)
        (AstType.I64)
        4
        "    vpxor %ymm1, %ymm1, %ymm1\n    vpcmpgtq %ymm6, %ymm1, %ymm0\n    vpcmpeqd %ymm1, %ymm1, %ymm1\n    vpsllq $63, %ymm1, %ymm1\n    vpsrlq $57, %ymm1, %ymm1\n    vpsubq %ymm7, %ymm1, %ymm1\n    vpsllvq %ymm1, %ymm0, %ymm0\n    vpsrlvq %ymm7, %ymm6, %ymm8\n    vpor %ymm0, %ymm8, %ymm8\n")
      (compiler-backend-avx2-vector-binop-diagnostic?
        (CompilerIrBinOp.Shl)
        (AstType.I16)
        16
        "backend: unsupported AVX2 vector binary op")
      (compiler-backend-avx2-vector-binop-diagnostic?
        (CompilerIrBinOp.Shr)
        (AstType.U8)
        32
        "backend: unsupported AVX2 vector binary op"))
    (backend-and8
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.Shl)
        (AstType.U32)
        16
        "    vpsllvd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.Shr)
        (AstType.I32)
        16
        "    vpsravd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.Shr)
        (AstType.U32)
        16
        "    vpsrlvd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.Shl)
        (AstType.U64)
        8
        "    vpsllvq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.Shr)
        (AstType.I64)
        8
        "    vpsravq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (CompilerIrBinOp.Shr)
        (AstType.U64)
        8
        "    vpsrlvq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-diagnostic?
        (CompilerIrBinOp.Shl)
        (AstType.U16)
        32
        "backend: unsupported AVX-512 vector binary op")
      (compiler-backend-avx512-vector-binop-diagnostic?
        (CompilerIrBinOp.Shr)
        (AstType.I8)
        64
        "backend: unsupported AVX-512 vector binary op"))))

(define (compiler-backend-avx2-unsigned-compare-alias-ok?) : bool
  ;; Preserve the RHS before writing the destination: the allocator may assign
  ;; both to the same vector register.
  (string.eq
    (compiler-backend-avx2-emit-unsigned-int-compare-asm
      (CompilerIrBinOp.Ge)
      "%ymm14"
      "%ymm7"
      "%ymm7"
      (AstType.U32))
    "    vpcmpeqd %ymm0, %ymm0, %ymm0\n    vpslld $31, %ymm0, %ymm0\n    vpxor %ymm0, %ymm7, %ymm1\n    vpxor %ymm0, %ymm14, %ymm7\n    vpcmpgtd %ymm7, %ymm1, %ymm7\n    vpcmpeqd %ymm0, %ymm0, %ymm0\n    vpxor %ymm0, %ymm7, %ymm7\n"))

(define (compiler-backend-avx2-data-pointer-cse-source) : String
  "(define (fill [a : (Array i64)] [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i (+ (array-ref a i) (array-ref a i)))))")

(define (compiler-backend-avx2-loop-body [body : String]) : String
  (let
    [start : i64 (compiler-backend-string-find-from body "foreach_avx2_body" 0)]
    (if (< start 0)
      ""
      (let
        [tail : i64
          (compiler-backend-string-find-from body "foreach_tail" start)]
        (if (< tail 0)
          (string.substring body start (- (string.string-length body) start))
          (string.substring body start (- tail start)))))))

(define (compiler-backend-avx2-data-pointer-cse-ok?) : bool
  (match (lower-compiler-source-with-mode
    (compiler-backend-avx2-data-pointer-cse-source)
    (CompilerLowerMode.Avx2))
    [(ResultCompilerLower.Ok program spans)
      (match (optimize-program-with-spans program spans)
        [(CompilerOptimizedProgram.Program optimized optimized-spans)
          (match (compiler-backend-emit-program-target-with-mode
            optimized
            (CompilerBackendTarget.Linux)
            (CompilerBackendMode.Avx2)
            optimized-spans
            true)
            [(ResultCompilerBackend.Ok asm)
              (let
                [body : String
                  (compiler-backend-asm-function-body asm "_tl_fill")]
                [loop : String (compiler-backend-avx2-loop-body body)]
                (and
                  (backend-and8
                    (= (compiler-backend-string-count loop "    movq 0(") 0)
                    (= (compiler-backend-string-count loop "    movq (%") 0)
                    (= (compiler-backend-string-count loop "    vmovdqu (") 1)
                    (= (compiler-backend-string-count loop "    vpaddq (") 0)
                    (=
                      (compiler-backend-string-count loop "    vmovdqu %ymm6")
                      1)
                    (compiler-backend-string-contains? body "foreach_avx2_body")
                    (compiler-backend-string-contains? body "foreach_tail")
                    (=
                      (compiler-backend-string-count
                        loop
                        "    vpaddq %ymm6, %ymm6, %ymm6")
                      1))
                  (not
                    (compiler-backend-string-contains?
                      loop
                      "vector/mask IR emission is not implemented"))))]
            [(ResultCompilerBackend.Err _) false])])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-backend-simd-vector-ok?) : bool
  (and
    (compiler-backend-avx2-vector-map-ok?)
    (compiler-backend-avx512-vector-map-ok?)
    (compiler-backend-lane-id-rodata-ok?)
    (compiler-backend-avx2-uniform-vector-map-ok?)
    (compiler-backend-avx512-uniform-vector-map-ok?)
    (compiler-backend-avx512-masked-if-ok?)
    (compiler-backend-avx2-vector-reduce-ok?)
    (compiler-backend-avx512-vector-reduce-ok?)
    (compiler-backend-vector-shuffle-ok?)
    (compiler-backend-vector-reduce-direct-store-ok?)
    (compiler-backend-xmm-family-conversion-ok?)
    (compiler-backend-avx2-vector-homes-ok?)
    (compiler-backend-avx512-mask-homes-ok?)
    (compiler-backend-avx512-mask-load-temp-ok?)
    (compiler-backend-avx512-mask-store-temp-ok?)
    (compiler-backend-avx512-tail-mask-ok?)
    (compiler-backend-avx512-mask-not-shortens-ok?)
    (compiler-backend-avx512-mask-binop-same-registers-ok?)
    (compiler-backend-avx512-mask-reduce-ok?)
    (compiler-backend-avx512-mask-spill-ok?)
    (compiler-backend-vector-load-binop-folding-ok?)
    (compiler-backend-avx2-data-pointer-cse-ok?)
    (compiler-backend-simd-indexed-address-ok?)
    (compiler-backend-simd-indexed-address-users-ok?)
    (compiler-backend-stack-splat-broadcast-ok?)
    (compiler-backend-vector-spill-reload-ok?)
    (compiler-backend-vector-spill-pressure-ok?)
    (compiler-backend-vector-bitwise-binop-ok?)
    (compiler-backend-vector-shift-binop-ok?)
    (compiler-backend-avx2-unsigned-compare-alias-ok?)
    (compiler-backend-vector-call-lifetime-spill-ok?)))

(define (compiler-backend-optimizer-rewrite-diagnostic-ok?) : bool
  (let
    [phi : CompilerIrInstr
      (CompilerIrInstr.Phi
        0
        (compiler-ir-phi-input-cons
          (CompilerIrValue.F64 (compiler-backend-test-f64-bits "1.0"))
          "entry"
          CompilerIrPhiInputList.Nil)
        (AstType.I64))]
    [program : CompilerIrProgram
      (CompilerIrProgram.Program
        CompilerIrGlobalList.Nil
        (compiler-ir-function-cons
          (CompilerIrFunction.Function
            (ci.intern "main")
            CompilerIrParamList.Nil
            (AstType.I64)
            4
            (compiler-ir-block-cons
              (compiler-ir-block
                "entry"
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Jump "join")
                  CompilerIrInstrList.Nil))
              (compiler-ir-block-cons
                (compiler-ir-block
                  "join"
                  (compiler-ir-instr-cons
                    phi
                    (compiler-ir-instr-cons
                      (CompilerIrInstr.Return
                        (CompilerIrMaybeValue.Some (CompilerIrValue.Var 0)))
                      CompilerIrInstrList.Nil)))
                CompilerIrBlockList.Nil)))
          CompilerIrFunctionList.Nil)
        CompilerIrExternList.Nil)]
    [spans : CompilerSourceSpans
      (compiler-source-spans-insert-instr
        (compiler-source-spans-insert
          (compiler-source-spans-empty)
          "main"
          (compiler-backend-test-span 10 2))
        (ci.intern "main")
        phi
        (compiler-backend-test-span 55 13))]
    (match (optimize-program-with-spans program spans)
      [(CompilerOptimizedProgram.Program optimized optimized-spans)
        (match (compiler-backend-emit-program-linux-with-spans
          optimized
          optimized-spans)
          [(ResultCompilerBackend.Err diag)
            (and
              (string.eq
                (compiler-diagnostic-message (box-get diag))
                "backend: f64 values are not supported yet")
              (= (compiler-diagnostic-line (box-get diag)) 55)
              (= (compiler-diagnostic-col (box-get diag)) 13))]
          [(ResultCompilerBackend.Ok _) false])])))

(define (compiler-backend-instr-contains?
  [instr : CompilerIrInstr]
  [needle : String]) : bool
  (let
    [prev-starts : (Array i64) compiler-backend-scavenge-ctx-starts]
    [prev-ends : (Array i64) compiler-backend-scavenge-ctx-ends]
    [prev-assignment-index : CompilerRegAssignmentIndex
      compiler-backend-scavenge-ctx-assignment-index]
    [prev-plan-mask : i64 compiler-backend-scavenge-ctx-plan-reg-mask]
    [prev-occupied-masks : (Array i64)
      compiler-backend-scavenge-ctx-occupied-masks]
    [prev-vars : i64 compiler-backend-scavenge-ctx-vars]
    [prev-post-base : i64 compiler-backend-emit-instr-post-base]
    [prev-current-count : i64 compiler-backend-emit-current-count]
    [prev-addr-forward-enabled : bool
      compiler-backend-addr-of-forwarding-enabled]
    [prev-addr-forward-src : (Array i64)
      compiler-backend-addr-of-forwarding-src]
    [prev-fuse-ready : bool compiler-backend-fuse-need-ready]
    [prev-fuse-use-counts : (Array i64) compiler-backend-fuse-use-counts]
    [prev-fuse-free-counts : (Array i64) compiler-backend-fuse-free-counts]
    [prev-loop-active : bool compiler-backend-emit-instrs-loop-active]
    [prev-continue-pending : bool compiler-backend-emit-instrs-continue-pending]
    [prev-identity-tail : bool compiler-backend-identity-tail-forwarder-active]
    [vars : i64 8]
    [starts : (Array i64) (make-array i64 vars)]
    [ends : (Array i64) (make-array i64 vars)]
    [_ctx : unit
      (begin
        (compiler-reg-fill-i64-array starts -1)
        (compiler-reg-fill-i64-array ends -1)
        (compiler-backend-set-scavenge-ctx!
          starts
          ends
          CompilerRegAssignmentList.Nil
          vars)
        (set! compiler-backend-emit-instr-post-base 1)
        (set! compiler-backend-emit-current-count 1)
        (compiler-backend-addr-of-forwarding-disable!)
        (compiler-backend-fuse-need-disable!)
        (set! compiler-backend-emit-instrs-loop-active false)
        (set! compiler-backend-emit-instrs-continue-pending false)
        (set! compiler-backend-identity-tail-forwarder-active false))]
    (match (compiler-backend-emit-instr
      (CompilerBackendEmissionContext
        (CompilerBackendTarget.Linux)
        "_tl_test"
        (ci.intern "test")
        CompilerIrBlockList.Nil
        "entry"
        CompilerRegAssignmentList.Nil
        vars
        CompilerRegVarTypeList.Nil
        (CompilerBackendGlobalTypeList.Nil)
        (AstType.I64)
        (CompilerBackendRuntimePlan.Plan
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          false
          (CompilerBackendRuntimeTailPlan false false false))
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)
        (compiler-source-spans-empty)
        (compiler-diagnostic-at-start "" "")
        (array.make-array i64 0))
      (CompilerBackendMaybeLabel.No)
      instr)
      [(ResultCompilerBackend.Ok asm)
        (let
          [hit : bool (compiler-backend-string-contains? asm needle)]
          [_restore : unit
            (begin
              (compiler-backend-set-scavenge-ctx-ready!
                prev-starts
                prev-ends
                prev-assignment-index
                prev-plan-mask
                prev-occupied-masks
                prev-vars)
              (set! compiler-backend-emit-instr-post-base prev-post-base)
              (set! compiler-backend-emit-current-count prev-current-count)
              (set!
                compiler-backend-addr-of-forwarding-enabled
                prev-addr-forward-enabled)
              (set!
                compiler-backend-addr-of-forwarding-src
                prev-addr-forward-src)
              (set! compiler-backend-fuse-need-ready prev-fuse-ready)
              (set! compiler-backend-fuse-use-counts prev-fuse-use-counts)
              (set! compiler-backend-fuse-free-counts prev-fuse-free-counts)
              (set! compiler-backend-emit-instrs-loop-active prev-loop-active)
              (set!
                compiler-backend-emit-instrs-continue-pending
                prev-continue-pending)
              (set!
                compiler-backend-identity-tail-forwarder-active
                prev-identity-tail))]
          hit)]
      [(ResultCompilerBackend.Err _)
        (let
          [_restore : unit
            (begin
              (compiler-backend-set-scavenge-ctx-ready!
                prev-starts
                prev-ends
                prev-assignment-index
                prev-plan-mask
                prev-occupied-masks
                prev-vars)
              (set! compiler-backend-emit-instr-post-base prev-post-base)
              (set! compiler-backend-emit-current-count prev-current-count)
              (set!
                compiler-backend-addr-of-forwarding-enabled
                prev-addr-forward-enabled)
              (set!
                compiler-backend-addr-of-forwarding-src
                prev-addr-forward-src)
              (set! compiler-backend-fuse-need-ready prev-fuse-ready)
              (set! compiler-backend-fuse-use-counts prev-fuse-use-counts)
              (set! compiler-backend-fuse-free-counts prev-fuse-free-counts)
              (set! compiler-backend-emit-instrs-loop-active prev-loop-active)
              (set!
                compiler-backend-emit-instrs-continue-pending
                prev-continue-pending)
              (set!
                compiler-backend-identity-tail-forwarder-active
                prev-identity-tail))]
          false)])))

(define (compiler-backend-emit-test-instrs
  [instrs : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]) : ResultCompilerBackend
  (let
    [prev-starts : (Array i64) compiler-backend-scavenge-ctx-starts]
    [prev-ends : (Array i64) compiler-backend-scavenge-ctx-ends]
    [prev-assignment-index : CompilerRegAssignmentIndex
      compiler-backend-scavenge-ctx-assignment-index]
    [prev-plan-mask : i64 compiler-backend-scavenge-ctx-plan-reg-mask]
    [prev-occupied-masks : (Array i64)
      compiler-backend-scavenge-ctx-occupied-masks]
    [prev-vars : i64 compiler-backend-scavenge-ctx-vars]
    [prev-post-base : i64 compiler-backend-emit-instr-post-base]
    [prev-current-count : i64 compiler-backend-emit-current-count]
    [prev-addr-forward-enabled : bool
      compiler-backend-addr-of-forwarding-enabled]
    [prev-addr-forward-src : (Array i64)
      compiler-backend-addr-of-forwarding-src]
    [prev-fuse-ready : bool compiler-backend-fuse-need-ready]
    [prev-fuse-use-counts : (Array i64) compiler-backend-fuse-use-counts]
    [prev-fuse-free-counts : (Array i64) compiler-backend-fuse-free-counts]
    [prev-loop-active : bool compiler-backend-emit-instrs-loop-active]
    [prev-continue-pending : bool compiler-backend-emit-instrs-continue-pending]
    [prev-identity-tail : bool compiler-backend-identity-tail-forwarder-active]
    [prev-emergency-pending : bool compiler-backend-emergency-pending]
    [prev-emergency-reg : String compiler-backend-emergency-reg]
    [prev-emergency-used : bool compiler-backend-emergency-used]
    [prev-emergency-pending-count : i64
      compiler-backend-emergency-pending-count]
    [prev-emergency-used-count : i64 compiler-backend-emergency-used-count]
    [prev-emergency-slot-offset : i64 compiler-backend-emergency-slot-offset]
    [prev-cycle-temp-used-count : i64 compiler-backend-cycle-temp-used-count]
    [prev-cycle-temp-base-offset : i64 compiler-backend-cycle-temp-base-offset]
    [prev-emergency-restore-suppressed : bool
      compiler-backend-emergency-restore-suppressed]
    [blocks : CompilerIrBlockList
      (compiler-ir-block-cons
        (compiler-ir-block "entry" instrs)
        CompilerIrBlockList.Nil)]
    [use-counts : (Array i64)
      (compiler-backend-function-use-counts vars blocks)]
    [_addr-forward : unit
      (compiler-backend-addr-of-forwarding-enable! vars blocks use-counts)]
    (match (compiler-backend-emit-instrs
      (CompilerBackendEmissionContext
        (CompilerBackendTarget.Linux)
        "_tl_test"
        (ci.intern "test")
        blocks
        "entry"
        assignments
        vars
        CompilerRegVarTypeList.Nil
        (CompilerBackendGlobalTypeList.Nil)
        (AstType.I64)
        (compiler-backend-runtime-helper-full-plan)
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)
        (compiler-source-spans-empty)
        (compiler-diagnostic-at-start "" "")
        use-counts)
      (CompilerBackendMaybeLabel.No)
      instrs
      (text_buf.empty))
      [(ResultCompilerBackend.Ok asm)
        (let
          [_restore : unit
            (begin
              (compiler-backend-set-scavenge-ctx-ready!
                prev-starts
                prev-ends
                prev-assignment-index
                prev-plan-mask
                prev-occupied-masks
                prev-vars)
              (set! compiler-backend-emit-instr-post-base prev-post-base)
              (set! compiler-backend-emit-current-count prev-current-count)
              (set!
                compiler-backend-addr-of-forwarding-enabled
                prev-addr-forward-enabled)
              (set!
                compiler-backend-addr-of-forwarding-src
                prev-addr-forward-src)
              (set! compiler-backend-fuse-need-ready prev-fuse-ready)
              (set! compiler-backend-fuse-use-counts prev-fuse-use-counts)
              (set! compiler-backend-fuse-free-counts prev-fuse-free-counts)
              (set! compiler-backend-emit-instrs-loop-active prev-loop-active)
              (set!
                compiler-backend-emit-instrs-continue-pending
                prev-continue-pending)
              (set!
                compiler-backend-identity-tail-forwarder-active
                prev-identity-tail)
              (set! compiler-backend-emergency-pending prev-emergency-pending)
              (set! compiler-backend-emergency-reg prev-emergency-reg)
              (set! compiler-backend-emergency-used prev-emergency-used)
              (set!
                compiler-backend-emergency-pending-count
                prev-emergency-pending-count)
              (set!
                compiler-backend-emergency-used-count
                prev-emergency-used-count)
              (set!
                compiler-backend-emergency-slot-offset
                prev-emergency-slot-offset)
              (set!
                compiler-backend-cycle-temp-used-count
                prev-cycle-temp-used-count)
              (set!
                compiler-backend-cycle-temp-base-offset
                prev-cycle-temp-base-offset)
              (set!
                compiler-backend-emergency-restore-suppressed
                prev-emergency-restore-suppressed))]
          (ResultCompilerBackend.Ok asm))]
      [(ResultCompilerBackend.Err message)
        (let
          [_restore : unit
            (begin
              (compiler-backend-set-scavenge-ctx-ready!
                prev-starts
                prev-ends
                prev-assignment-index
                prev-plan-mask
                prev-occupied-masks
                prev-vars)
              (set! compiler-backend-emit-instr-post-base prev-post-base)
              (set! compiler-backend-emit-current-count prev-current-count)
              (set!
                compiler-backend-addr-of-forwarding-enabled
                prev-addr-forward-enabled)
              (set!
                compiler-backend-addr-of-forwarding-src
                prev-addr-forward-src)
              (set! compiler-backend-fuse-need-ready prev-fuse-ready)
              (set! compiler-backend-fuse-use-counts prev-fuse-use-counts)
              (set! compiler-backend-fuse-free-counts prev-fuse-free-counts)
              (set! compiler-backend-emit-instrs-loop-active prev-loop-active)
              (set!
                compiler-backend-emit-instrs-continue-pending
                prev-continue-pending)
              (set!
                compiler-backend-identity-tail-forwarder-active
                prev-identity-tail)
              (set! compiler-backend-emergency-pending prev-emergency-pending)
              (set! compiler-backend-emergency-reg prev-emergency-reg)
              (set! compiler-backend-emergency-used prev-emergency-used)
              (set!
                compiler-backend-emergency-pending-count
                prev-emergency-pending-count)
              (set!
                compiler-backend-emergency-used-count
                prev-emergency-used-count)
              (set!
                compiler-backend-emergency-slot-offset
                prev-emergency-slot-offset)
              (set!
                compiler-backend-cycle-temp-used-count
                prev-cycle-temp-used-count)
              (set!
                compiler-backend-cycle-temp-base-offset
                prev-cycle-temp-base-offset)
              (set!
                compiler-backend-emergency-restore-suppressed
                prev-emergency-restore-suppressed))]
          (ResultCompilerBackend.Err message))])))

(define (compiler-backend-runtime-helper-full-plan) : CompilerBackendRuntimePlan
  (CompilerBackendRuntimePlan.Plan
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    true
    (CompilerBackendRuntimeTailPlan true true true)))

;; Test fixtures start from readable spellings, then exercise only the backend's
;; ID-native runtime inventory. Production never performs this conversion.
(define (compiler-backend-test-runtime-name-id [name : String]) : i64
  (ci.intern name))

(define (compiler-backend-test-runtime-helper-owner [name : String]) : CompilerBackendRuntimeHelperOwner
  (cond
    [(string.eq name "tl_memcpy") (CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "tl_memchr") (CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "tl_tlci_call_image_entry")
      (CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "tl_tlci_call_macro_entry")
      (CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "__chkstk") (CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "tl_setup_argv") (CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "_tl_start") (CompilerBackendRuntimeHelperOwner.Core)]
    [else
      (compiler-backend-runtime-helper-owner-id
        (compiler-backend-test-runtime-name-id name))]))

(define (compiler-backend-test-runtime-helper-known? [name : String]) : bool
  (match (compiler-backend-test-runtime-helper-owner name)
    [(CompilerBackendRuntimeHelperOwner.Unknown) false]
    [_ true]))

(define (compiler-backend-test-plan-provides?
  [plan : CompilerBackendRuntimePlan]
  [name : String]) : bool
  (if (string.eq name "tl_tlci_call_macro_entry")
    (compiler-backend-runtime-tail-tlci-macro-entry?
      (compiler-backend-runtime-plan-tail plan))
    (compiler-backend-plan-provides-id?
      plan
      (compiler-backend-test-runtime-name-id name))))

(define (compiler-backend-runtime-helper-inventory-symbol-ok?
  [plan : CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-test-runtime-helper-known? name)
    (compiler-backend-test-plan-provides? plan name)))

(define (compiler-backend-runtime-helper-owner-core-ok? [name : String]) : bool
  (match (compiler-backend-test-runtime-helper-owner name)
    [(CompilerBackendRuntimeHelperOwner.Core) true]
    [_ false]))

(define (compiler-backend-runtime-helper-inventory-core-symbol-ok?
  [plan : CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-symbol-ok? plan name)
    (compiler-backend-runtime-helper-owner-core-ok? name)))

(define (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
  [plan : CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-symbol-ok? plan name)
    (match (compiler-backend-test-runtime-helper-owner name)
      [(CompilerBackendRuntimeHelperOwner.StdlibFfi) true]
      [_ false])))

(define (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
  [plan : CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-symbol-ok? plan name)
    (match (compiler-backend-test-runtime-helper-owner name)
      [(CompilerBackendRuntimeHelperOwner.StdlibTypeLisp) true]
      [_ false])))

(define (compiler-backend-runtime-helper-inventory-compat-alias-ok?
  [plan : CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-test-plan-provides? plan name)
    (match (compiler-backend-test-runtime-helper-owner name)
      [(CompilerBackendRuntimeHelperOwner.CompatibilityAlias) true]
      [_ false])))

(define (compiler-backend-runtime-helper-inventory-core-ok?
  [plan : CompilerBackendRuntimePlan]) : bool
  (and
    (backend-and8
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_alloc")
      (not (compiler-backend-test-runtime-helper-known? "tl_oob_abort"))
      (not (compiler-backend-test-runtime-helper-known? "tl_div_abort"))
      (not (compiler-backend-test-runtime-helper-known? "tl_shift_abort"))
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_abort")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_region_mark")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_region_reset")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_make"))
    (backend-and4
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_current")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_set")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_destroy")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_make_atomic"))
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_arena_poison_enable")
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_thread_init")
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_thread_entry_ptr")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_memcpy")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_memchr")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_tlci_call_image_entry")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_tlci_call_macro_entry")
    (compiler-backend-runtime-helper-owner-core-ok? "__chkstk")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_setup_argv")
    (compiler-backend-runtime-helper-owner-core-ok? "_tl_start")))

(define (compiler-backend-runtime-helper-inventory-stdlib-ffi-ok?
  [plan : CompilerBackendRuntimePlan]) : bool
  (backend-and4
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_total")
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_live")
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_peak")
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_reset_peak")))

(define (compiler-backend-runtime-helper-inventory-stdlib-string-ok?
  [plan : CompilerBackendRuntimePlan]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_substring")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat3")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat4")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat5")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_int_to_string")))

(define (compiler-backend-runtime-helper-inventory-stdlib-atomic-ok?
  [plan : CompilerBackendRuntimePlan]) : bool
  (and
    (backend-and8
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_load_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_store_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_add_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_fetch_add_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_cas_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i32_load_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i32_store_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i32_add_ptr"))
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_atomic_i32_fetch_add_ptr")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_atomic_i32_cas_ptr")))

(define (compiler-backend-runtime-helper-inventory-retired-string-ok?
  [plan : CompilerBackendRuntimePlan]) : bool
  (backend-and4
    (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
      plan
      "tl_string_eq")
    (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
      plan
      "tl_string_to_int")
    (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
      plan
      "tl_hash_string")
    true))

(define (compiler-backend-runtime-helper-inventory-env-compat-ok?
  [plan : CompilerBackendRuntimePlan]) : bool
  (backend-and4
    (compiler-backend-runtime-helper-inventory-compat-alias-ok?
      plan
      "tl_env_var_exists")
    (compiler-backend-runtime-helper-inventory-compat-alias-ok?
      plan
      "tl_env_var_value")
    (compiler-backend-test-plan-provides? plan "path-separator")
    true))

(define (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
  [plan : CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (not (compiler-backend-test-runtime-helper-known? name))
    (not (compiler-backend-test-plan-provides? plan name))))

(define (compiler-backend-runtime-helper-inventory-retired-file-ok?
  [plan : CompilerBackendRuntimePlan]) : bool
  (and
    (backend-and8
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_read_file")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_write_file")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_exists")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_read_file_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_write_file_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_append_file_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_exists_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_open_status"))
    (backend-and8
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_close_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_read_chunk_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_write_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_flush_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_read_chunk_bytes")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_read_chunk_eof")
      true
      true)))

(define (compiler-backend-runtime-helper-inventory-retired-process-ok?
  [plan : CompilerBackendRuntimePlan]) : bool
  (backend-and4
    (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
      plan
      "tl_process_output")
    (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
      plan
      "tl_process_start")
    (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
      plan
      "tl_process_wait")
    true))

(define (compiler-backend-runtime-helper-inventory-retired-fs-metadata-ok?
