            compiler_ir_types.CompilerIrInstrList.Nil))
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [_group-enable : unit
      (begin
        (compiler_backend.compiler-backend-current-slot-vars-set! 2)
        (compiler_backend.compiler-backend-group-vars-enable!
          (compiler_liveness.compiler-live-set-insert
            (compiler_liveness.compiler-live-set1 0)
            1)
          (compiler_liveness.compiler-live-set-empty)))]
    [copied : compiler_backend.ResultCompilerBackend
      (compiler_backend.compiler-backend-emit-phi-edge-copies
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        compiler_regalloc.CompilerRegAssignmentList.Nil
        blocks
        (compiler_ir_types.compiler-ir-label "join")
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler-backend-register-group-test-index)
        2
        ""
        ""
        "")]
    [_group-disable : unit
      (compiler_backend.compiler-backend-group-vars-disable!)]
    (match copied
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (= (compiler_backend.compiler-backend-string-count asm "%rax") 2)
          (= (compiler_backend.compiler-backend-string-count asm "%rdx") 2))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-phi-float-cycle-copy-ok?) : bool
  (let
    [prev-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-cycle-temp-used-count)]
    [prev-base : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-cycle-temp-base-offset)]
    [prev-register-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-phi-xmm-cycle-register-count)]
    [prev-fallback-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-phi-xmm-cycle-fallback-count)]
    [_set : unit
      (begin
        (compiler_backend.compiler-backend-test-set-compiler-backend-cycle-temp-used-count!
          0)
        (compiler_backend.compiler-backend-test-set-compiler-backend-cycle-temp-base-offset!
          -512)
        (compiler_backend.compiler-backend-test-set-compiler-backend-phi-xmm-cycle-register-count!
          0)
        (compiler_backend.compiler-backend-test-set-compiler-backend-phi-xmm-cycle-fallback-count!
          0))]
    [ok : bool
      (and
        (match (compiler_backend.compiler-backend-emit-phi-edge-copies
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-phi-f64-cycle-assignments)
          (compiler-backend-phi-f64-cycle-blocks)
          (compiler_ir_types.compiler-ir-label "join")
          (compiler_ir_types.compiler-ir-label "back")
          (compiler_backend.compiler-backend-program-index-build
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            compiler_ir_types.CompilerIrFunctionList.Nil
            compiler_ir_types.CompilerIrExternList.Nil)
          2
          ""
          ""
          "%xmm4")
          [(compiler_backend.ResultCompilerBackend.Ok cycle)
            (and
              (compiler_backend.compiler-backend-string-contains?
                cycle
                "    movsd %xmm2, %xmm4\n")
              (compiler_backend.compiler-backend-string-contains?
                cycle
                "    movsd %xmm4, %xmm3\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "-512(%rbp)"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "%rsp"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "%xmm0"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "%xmm14"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "%xmm15")))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])
        (match (compiler_backend.compiler-backend-emit-phi-edge-copies
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-phi-f64-cycle-assignments)
          (compiler-backend-phi-f64-cycle-blocks)
          (compiler_ir_types.compiler-ir-label "join")
          (compiler_ir_types.compiler-ir-label "back")
          (compiler_backend.compiler-backend-program-index-build
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            compiler_ir_types.CompilerIrFunctionList.Nil
            compiler_ir_types.CompilerIrExternList.Nil)
          2
          ""
          ""
          "")
          [(compiler_backend.ResultCompilerBackend.Ok fallback)
            (and
              (compiler_backend.compiler-backend-string-contains?
                fallback
                "    movsd %xmm2, -512(%rbp)\n")
              (compiler_backend.compiler-backend-string-contains?
                fallback
                "    movsd -512(%rbp), %xmm3\n"))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])
        (match (compiler_backend.compiler-backend-emit-phi-edge-copies
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-phi-f32-three-cycle-assignments)
          (compiler-backend-phi-f32-three-cycle-blocks)
          (compiler_ir_types.compiler-ir-label "join")
          (compiler_ir_types.compiler-ir-label "back")
          (compiler_backend.compiler-backend-program-index-build
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            compiler_ir_types.CompilerIrFunctionList.Nil
            compiler_ir_types.CompilerIrExternList.Nil)
          3
          ""
          ""
          "%xmm4")
          [(compiler_backend.ResultCompilerBackend.Ok cycle)
            (and
              (compiler_backend.compiler-backend-string-contains?
                cycle
                "    movss %xmm2, %xmm4\n")
              (compiler_backend.compiler-backend-string-contains? cycle "%xmm4")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "-512(%rbp)"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "movsd")))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])
        (match (compiler_backend.compiler-backend-emit-phi-edge-copies
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-phi-f64-spill-cycle-assignments)
          (compiler-backend-phi-f64-cycle-blocks)
          (compiler_ir_types.compiler-ir-label "join")
          (compiler_ir_types.compiler-ir-label "back")
          (compiler_backend.compiler-backend-program-index-build
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            compiler_ir_types.CompilerIrFunctionList.Nil
            compiler_ir_types.CompilerIrExternList.Nil)
          2
          ""
          ""
          "%xmm4")
          [(compiler_backend.ResultCompilerBackend.Ok cycle)
            (and
              (compiler_backend.compiler-backend-string-contains?
                cycle
                "-512(%rbp)")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "    movsd -16(%rbp), %xmm4\n")))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])
        (match (compiler_backend.compiler-backend-emit-phi-edge-copies
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-phi-group-f64-cycle-assignments)
          (compiler-backend-phi-group-f64-cycle-blocks)
          (compiler_ir_types.compiler-ir-label "join")
          (compiler_ir_types.compiler-ir-label "back")
          (compiler-backend-register-group-f64-test-index)
          4
          ""
          ""
          "")
          [(compiler_backend.ResultCompilerBackend.Ok cycle)
            (and
              (compiler_backend.compiler-backend-string-contains?
                cycle
                "    movq %xmm2, -512(%rbp)\n")
              (compiler_backend.compiler-backend-string-contains?
                cycle
                "    movq %xmm3, -520(%rbp)\n")
              (compiler_backend.compiler-backend-string-contains?
                cycle
                "    movq -520(%rbp), %xmm5\n")
              (compiler_backend.compiler-backend-string-contains?
                cycle
                "    movq -512(%rbp), %xmm4\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "%rsp"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "%xmm14"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "%xmm15")))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])
        (cfg
          regalloc-census
          (and
            (=
              (compiler_backend.compiler-backend-test-get-compiler-backend-phi-xmm-cycle-register-count)
              2)
            (=
              (compiler_backend.compiler-backend-test-get-compiler-backend-phi-xmm-cycle-fallback-count)
              1))
          true))]
    [_restore : unit
      (begin
        (compiler_backend.compiler-backend-test-set-compiler-backend-cycle-temp-used-count!
          prev-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-cycle-temp-base-offset!
          prev-base)
        (compiler_backend.compiler-backend-test-set-compiler-backend-phi-xmm-cycle-register-count!
          prev-register-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-phi-xmm-cycle-fallback-count!
          prev-fallback-count))]
    ok))

(define (compiler-backend-arg-cycle-temp-slot-ok?) : bool
  (let
    [prev-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-cycle-temp-used-count)]
    [prev-base : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-cycle-temp-base-offset)]
    [_set : unit
      (begin
        (compiler_backend.compiler-backend-test-set-compiler-backend-cycle-temp-used-count!
          0)
        (compiler_backend.compiler-backend-test-set-compiler-backend-cycle-temp-base-offset!
          -512))]
    [restore : compiler_backend.ResultCompilerBackend
      (compiler_backend.compiler-backend-emit-arg-move
        compiler_regalloc.CompilerRegAssignmentList.Nil
        (BackendArgMove compiler_abi.compiler-reg-id-rsi BackendArgMoveStackPop))]
    [ok : bool
      (match restore
        [(compiler_backend.ResultCompilerBackend.Ok restore-asm)
          (let
            [save-asm : String
              (compiler_backend.compiler-backend-emit-arg-cycle-temp-save
                compiler_abi.compiler-reg-id-rdi)]
            [asm : String (string.append save-asm restore-asm)]
            (and
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq %rdi, -512(%rbp)\n")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq -512(%rbp), %rsi\n")
              (not
                (compiler_backend.compiler-backend-string-contains? asm "pushq"))
              (not
                (compiler_backend.compiler-backend-string-contains? asm "popq"))
              (not
                (compiler_backend.compiler-backend-string-contains? asm "%rsp"))))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [_restore : unit
      (begin
        (compiler_backend.compiler-backend-test-set-compiler-backend-cycle-temp-used-count!
          prev-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-cycle-temp-base-offset!
          prev-base))]
    ok))

