;; The cycle fixture's "back" -> "join" edge is a BACK edge: "join" is the first
;; (and only) block, so its P22-B target point is 0, and `emit-instr-post-base`
;; is pinned above it here so the edge classifies as backward however the
;; preceding tests left that global. A back edge keeps the pushq/popq staging
;; bracket; the forward case is pinned by
;; `compiler-backend-phi-forward-edge-unbracket-ok?` below.
(define (compiler-backend-phi-parallel-copy-ok?) : bool
  (let
    [program-index : compiler_backend.CompilerBackendProgramIndex
      (compiler_backend.compiler-backend-program-index-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil)]
    [backend-state : compiler_backend.CompilerBackendState
      program-index.backend-state]
    [prev-count : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-cycle-temp-used-count
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-base : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-cycle-temp-base-offset
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-post-base : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-instr-post-base
        backend-state)]
    [_set : unit
      (begin
        (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-used-count!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          0)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-base-offset!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          -512)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          backend-state
          8))]
    [ok : bool
      (match (compiler_backend.compiler-backend-emit-phi-edge-copies
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler-backend-phi-same-home-assignments)
        (compiler-backend-phi-same-home-blocks)
        (compiler_ir_types.compiler-ir-label "join")
        (compiler_ir_types.compiler-ir-label "entry")
        program-index
        0
        ""
        ""
        "")
        [(compiler_backend.ResultCompilerBackend.Ok same-home)
          (match (compiler_backend.compiler-backend-emit-phi-edge-copies
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_regalloc.compiler-reg-assignment-table-empty)
            (compiler-backend-phi-cycle-blocks)
            (compiler_ir_types.compiler-ir-label "join")
            (compiler_ir_types.compiler-ir-label "back")
            program-index
            0
            ""
            ""
            "")
            [(compiler_backend.ResultCompilerBackend.Ok cycle)
              (and
                (string.eq same-home "")
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "    movq -8(%rbp), %r10\n")
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "    movq %r10, -512(%rbp)\n")
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "    movq -512(%rbp), %r10\n")
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "    movq %r10, -16(%rbp)\n")
                ;; The spilled mem->mem copy of the break stages through the
                ;; scavenged GP register. It used to carry a pushq/popq bracket
                ;; around the staging register; #phi-staged-copy proves the
                ;; register free per edge (no register homes exist in this
                ;; assignment table, and no copy dst homes one), so the bracket is
                ;; gone and the pair itself is what the shape asserts.
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "    movq -16(%rbp), %r8\n")
                (compiler_backend.compiler-backend-string-contains?
                  cycle
                  "    movq %r8, -8(%rbp)\n")
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    cycle
                    "    pushq %r8\n"))
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    cycle
                    "%rax")))]
            [(compiler_backend.ResultCompilerBackend.Err _) false])]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [_restore : unit
      (begin
        (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-used-count!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-count)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-base-offset!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-base)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          backend-state
          prev-post-base))]
    ok))

;; P22-B: the same cycle fixture emitted across a FORWARD edge drops the
;; pushq/popq staging bracket. "join" is the only block, so its target point is
;; 0; pinning `emit-instr-post-base` to 0 makes the edge run forward (target at
;; or past the end of the block being emitted), which is the case where every
;; var live at the target's entry already reads OCCUPIED in the point-local
;; scavenge query. The four marshalling movq lines must be unchanged -- only the
;; two bracket instructions go.
(define (compiler-backend-phi-forward-edge-unbracket-ok?) : bool
  (let
    [program-index : compiler_backend.CompilerBackendProgramIndex
      (compiler_backend.compiler-backend-program-index-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil)]
    [backend-state : compiler_backend.CompilerBackendState
      program-index.backend-state]
    [prev-count : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-cycle-temp-used-count
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-base : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-cycle-temp-base-offset
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-post-base : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-instr-post-base
        backend-state)]
    [_set : unit
      (begin
        (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-used-count!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          0)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-base-offset!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          -512)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          backend-state
          0))]
    [ok : bool
      (match (compiler_backend.compiler-backend-emit-phi-edge-copies
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_regalloc.compiler-reg-assignment-table-empty)
        (compiler-backend-phi-cycle-blocks)
        (compiler_ir_types.compiler-ir-label "join")
        (compiler_ir_types.compiler-ir-label "back")
        program-index
        0
        ""
        ""
        "")
        [(compiler_backend.ResultCompilerBackend.Ok cycle)
          (and
            (compiler_backend.compiler-backend-string-contains?
              cycle
              "    movq -8(%rbp), %r10\n")
            (compiler_backend.compiler-backend-string-contains?
              cycle
              "    movq %r10, -512(%rbp)\n")
            (compiler_backend.compiler-backend-string-contains?
              cycle
              "    movq -512(%rbp), %r10\n")
            (compiler_backend.compiler-backend-string-contains?
              cycle
              "    movq %r10, -16(%rbp)\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                cycle
                "    pushq %r8\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                cycle
                "    popq %r8\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [_restore : unit
      (begin
        (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-used-count!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-count)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-base-offset!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-base)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          backend-state
          prev-post-base))]
    ok))

;; A planned phi stage may borrow an unrelated register value that remains live
;; through the terminator. That is the planner's regular preservation class,
;; but a Jump has no reachable post-instruction restore. Keep the save/restore
;; around the exact memory-memory phi copy even when the forward-edge proof
;; would otherwise permit an unbracketed stage.
(define (compiler-backend-phi-planned-live-through-preserved-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [items : (__tl_dyn-array compiler_regalloc.CompilerRegScratchAssignment)
        (array.make-array compiler_regalloc.CompilerRegScratchAssignment 1)]
      [firsts : (__tl_dyn-array i64) (array.make-array i64 1)]
      [slots : (__tl_dyn-array i64) (array.make-array i64 1)]
      [_plan-init : unit
        (begin
          (set!
            (array-ref items 0)
            (compiler_regalloc.CompilerRegScratchAssignment
              (compiler_regalloc.CompilerRegScratchRequirement
                0
                0
                (compiler_regalloc.CompilerRegScratchRole.PhiStage)
                (compiler_regalloc.CompilerRegScratchConstraint
                  (compiler_regalloc.CompilerRegScratchClass.Gp)
                  (compiler_regalloc.compiler-reg-id-seq-empty)
                  (compiler_regalloc.compiler-reg-id-seq-empty)
                  compiler_abi.compiler-reg-id-invalid)
                0
                1
                1)
              true
              false
              compiler_abi.compiler-reg-id-rsi))
          (set! (array-ref firsts 0) 0)
          (set! (array-ref slots 0) 1))]
      [plan : compiler_regalloc.CompilerRegScratchPlan
        (compiler_regalloc.CompilerRegScratchPlan items firsts slots)]
      [program-index : compiler_backend.CompilerBackendProgramIndex
        (compiler_backend.compiler-backend-program-index-build
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          compiler_ir_types.CompilerIrFunctionList.Nil
          compiler_ir_types.CompilerIrExternList.Nil)]
      [backend-state : compiler_backend.CompilerBackendState
        program-index.backend-state]
      [assignments : compiler_regalloc.CompilerRegAssignmentTable
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            0
            (compiler_regalloc.CompilerRegLocation.Spill -16))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              1
              (compiler_regalloc.CompilerRegLocation.Spill -8))
            (compiler_regalloc.compiler-reg-assignment-table-empty)))]
      [function-state : compiler_backend.CompilerBackendFunctionState
        (compiler_backend.compiler-backend-state-function-state backend-state)]
      [_slot : unit
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
          function-state
          -64)]
      [planned : String
        (compiler_backend.compiler-backend-scratch-plan-register-here
          plan
          0
          backend-state)]
      (match (compiler_backend.compiler-backend-emit-phi-edge-copies
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        assignments
        (compiler-backend-phi-same-home-blocks)
        (compiler_ir_types.compiler-ir-label "join")
        (compiler_ir_types.compiler-ir-label "entry")
        program-index
        2
        ""
        planned
        "")
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (string.eq planned "%rsi")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %rsi, -64(%rbp)\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq -16(%rbp), %rsi\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %rsi, -8(%rbp)\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq -64(%rbp), %rsi\n")
            (not
              (compiler_backend.compiler-backend-string-contains? asm "pushq")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false]))
    true))

(define (compiler-backend-phi-group-cycle-copy-ok?) : bool
