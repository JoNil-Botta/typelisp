;; Backend-owned replacement for the Rust bool logic codegen checks:
;; `and`/`or` arrive from the lowerer as branches, not eager bytewise ops, and
;; bool equality still uses the comparison/setcc path.
(define (compiler-backend-bool-and-source) : String
  "(define (main) : i64 0)
(defmacro (and [args : bool ...]) : bool
  `(and-from (__and-args ,@args) 0))
(defmacro (and-from [carrier : Expr] [idx : Expr]) : bool
  (match idx
    [(Expr.Int i)
      (match carrier
        [(Expr.Call _ elems)
          (if (>= i (expr-list-length elems))
            (expr-bool true)
            `(if ,(expr-list-nth elems i)
               (and-from ,carrier ,(expr-int (+ i 1)))
               false))]
        [_ (expr-bool true)])]
    [_ (expr-bool true)]))
(define (f [a : bool] [b : bool]) : bool (and a b))")

(define (compiler-backend-bool-or-source) : String
  "(define (main) : i64 0)
(defmacro (or [args : bool ...]) : bool
  `(or-from (__or-args ,@args) 0))
(defmacro (or-from [carrier : Expr] [idx : Expr]) : bool
  (match idx
    [(Expr.Int i)
      (match carrier
        [(Expr.Call _ elems)
          (if (>= i (expr-list-length elems))
            (expr-bool false)
            `(if ,(expr-list-nth elems i)
               true
               (or-from ,carrier ,(expr-int (+ i 1)))))]
        [_ (expr-bool false)])]
    [_ (expr-bool false)]))
(define (f [a : bool] [b : bool]) : bool (or a b))")

(define (compiler-backend-bool-eq-source) : String
  "(define (main) : i64 0)
(define (f [a : bool] [b : bool]) : bool (= a b))")

(define (compiler-backend-bool-not-source) : String
  "(define (main) : i64 0)
(define (f [a : bool]) : bool (not a))")

(define (compiler-backend-negated-compare-branch-source) : String
  "(define (main) : i64 0)
(define (f [a : i64] [b : i64]) : i64
  (if (not (= a b)) 1 2))")

(define (compiler-backend-not-branch-source) : String
  "(define (main) : i64 0)
(define (f [a : bool]) : i64
  (if (not a) 1 2))")

(define (compiler-backend-multi-not-branch-source) : String
  "(define (contains [items : (__tl_dyn-array i64)] [needle : i64]) : bool
  (if (< needle 0)
    (contains items (+ needle 1))
    (let
      [index : i64 0]
      [found : bool false]
      (begin
        (while (not found)
          (if (>= index (array-length items))
            (return false)
            (begin
              (if (= (array-ref items index) needle)
                (set! found true)
                unit)
              (set! index (+ index 1)))))
        true))))")

(define (compiler-backend-negated-compare-branch-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-negated-compare-branch-source))
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_f")]
        (and
          (not (string.eq body ""))
          (asm-has? body "    cmpq ")
          (or (asm-has? body "    je ") (asm-has? body "    jne "))
          (asm-lacks?
            body
            "    sete "
            "    setne "
            "    xorq $1, "
            "    testq ")))]
    [(Err _) false]))

(define (compiler-backend-not-branch-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-not-branch-source))
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_f")]
        (and
          (not (string.eq body ""))
          (or (asm-has? body "    cmpq $0, ") (asm-has? body "    testq "))
          (or (asm-has? body "    je ") (asm-has? body "    jne "))
          (asm-lacks? body "    xorq $1, ")))]
    [(Err _) false]))

;; The optimizer drops functions a `main` cannot reach, so this mainless
;; fixture emits as library code (#7071).
(define (compiler-backend-multi-not-branch-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target-and-entry
    (compiler-backend-multi-not-branch-source)
    (be_state.CompilerBackendTarget.Linux)
    false)
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_contains")]
        (and
          (not (string.eq body ""))
          (or (asm-has? body "    cmpq $0, ") (asm-has? body "    testq "))
          (asm-lacks? body "    xorq $1, ")))]
    [(Err _) false]))

(define (compiler-backend-direct-condition-branch-ok?) : bool
  (match (be_scalar.compiler-backend-emit-branch
    (reg-homes "%0=%r12")
    "bool_branch"
    (Var 0)
    (ir.compiler-ir-label "yes")
    (ir.compiler-ir-label "no")
    (No)
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok reg-asm)
      (match (be_scalar.compiler-backend-emit-branch
        (reg-homes "%0=spill:-24")
        "bool_branch"
        (Var 0)
        (ir.compiler-ir-label "yes")
        (ir.compiler-ir-label "no")
        (No)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok spill-asm)
          (and
            (asm-has? reg-asm "    testq %r12, %r12\n")
            (asm-lacks? reg-asm "    movq %r12, %rax\n")
            (asm-has? spill-asm "    cmpq $0, -24(%rbp)\n")
            (asm-lacks? spill-asm "    movq -24(%rbp), %rax\n"))]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-direct-compare-branch-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r13 %2=spill:-16"))

(define (compiler-backend-direct-compare-branch-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-direct-compare-branch-assignments)]
    (match (be_scalar.compiler-backend-emit-compare-branch
      (ast.ast-node-pool-reader-type-segment-bases)
      assignments
      "cmp_branch"
      (Lt)
      (Var 0)
      (I64 10)
      (I64)
      (ir.compiler-ir-label "yes")
      (ir.compiler-ir-label "no")
      (No)
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(Ok reg-asm)
        (match (be_scalar.compiler-backend-emit-compare-branch
          (ast.ast-node-pool-reader-type-segment-bases)
          assignments
          "cmp_branch"
          (Ne)
          (Var 2)
          (Var 1)
          (I64)
          (ir.compiler-ir-label "yes")
          (ir.compiler-ir-label "no")
          (No)
          (be_state.compiler-backend-state-new
            (ci.intern-compat-state-capture-active)))
          [(Ok stack-asm)
            (and
              (asm-has? reg-asm "    cmpq $10, %r12\n")
              (asm-lacks? reg-asm "    movq %r12, %rax\n" "%rax")
              (asm-has? stack-asm "    cmpq %r13, -16(%rbp)\n")
              (asm-lacks? stack-asm "    movq -16(%rbp), %rax\n" "%rax"))]
          [(Err _) false])]
      [(Err _) false])))

(define (compiler-backend-todo-marker) : String
  (str_cat.str-cat "# " "TODO"))

(define (compiler-backend-bool-control-flow-ok?) : bool
  (and
    (be_state.backend-and8
      (compiler-backend-source-contains?
        (compiler-backend-bool-and-source)
        "    je ")
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-and-source)
        "    andb ")
      (compiler-backend-source-contains?
        (compiler-backend-bool-or-source)
        "    je ")
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-or-source)
        "    orb ")
      (compiler-backend-source-contains?
        (compiler-backend-bool-eq-source)
        "    sete %al\n")
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-and-source)
        (compiler-backend-todo-marker))
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-or-source)
        (compiler-backend-todo-marker))
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-eq-source)
        (compiler-backend-todo-marker)))
    (be_state.backend-and4
      (compiler-backend-source-contains?
        (compiler-backend-bool-not-source)
        "    xorq $1, %r8\n")
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-not-source)
        "    xorq $1, %rax\n")
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-not-source)
        "    testq %rax, %rax\n    sete %al\n    movzbl %al, %eax\n")
      (and
        (compiler-backend-source-not-contains?
          (compiler-backend-bool-not-source)
          (compiler-backend-todo-marker))
        (compiler-backend-direct-condition-branch-ok?)
        (compiler-backend-direct-compare-branch-ok?)
        (compiler-backend-negated-compare-branch-ok?)
        (compiler-backend-not-branch-ok?)
        (compiler-backend-multi-not-branch-ok?)))))

;; Backend-owned scalar instruction emit-shape coverage for stable wide integer
;; forms.
(define (compiler-backend-scalar-wide-source) : String
  "(define (main) : i64 0)
(define (xor64 [a : i64] [b : i64]) : i64 (bit-xor a b))
(define (shl64 [a : i64] [b : i64]) : i64 (shl a b))
(define (shr64 [a : i64] [b : i64]) : i64 (shr a b))")

(define (compiler-backend-scalar-wide-ops-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-scalar-wide-source))
    [(Ok asm)
      (be_state.backend-and8
        (or
          (asm-has? asm "    xorq %r8, %rax\n")
          (asm-has? asm "    xorq %rcx, %rax\n"))
        (asm-has? asm "    shlq %cl, %rax\n")
        (asm-has? asm "    sarq %cl, %rax\n")
        (asm-lacks? asm "    orq ")
        (asm-lacks? asm "    addq %r8, %rax\n")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle)))
        true
        true)]
    [(Err _) false]))

(define (compiler-backend-bit-and-low-mask-immediate-ok?) : bool
  (and
    (be_state.backend-and4
      (match (be_scalar.compiler-backend-binop-immediate-asm
        (ast.ast-node-pool-reader-type-segment-bases)
        (BitAnd)
        "$255"
        (I64)
        "%rax"
        "%rax"
        false)
        [(Some asm) (string.eq asm "    movzbl %al, %eax\n")]
        [(No) false])
      (match (be_scalar.compiler-backend-binop-immediate-asm
        (ast.ast-node-pool-reader-type-segment-bases)
        (BitAnd)
        "$65535"
        (I64)
        "%rax"
        "%rax"
        false)
        [(Some asm) (string.eq asm "    movzwl %ax, %eax\n")]
        [(No) false])
      (match (be_scalar.compiler-backend-binop-immediate-asm
        (ast.ast-node-pool-reader-type-segment-bases)
        (BitAnd)
        "$255"
        (U32)
        "%rax"
        "%rax"
        false)
        [(Some asm) (string.eq asm "    movzbl %al, %eax\n")]
        [(No) false])
      (match (be_scalar.compiler-backend-binop-immediate-asm
        (ast.ast-node-pool-reader-type-segment-bases)
        (BitAnd)
        "$65535"
        (U32)
        "%rax"
        "%rax"
        false)
        [(Some asm) (string.eq asm "    movzwl %ax, %eax\n")]
        [(No) false]))
    (be_state.backend-and4
      (match (be_scalar.compiler-backend-binop-immediate-asm
        (ast.ast-node-pool-reader-type-segment-bases)
        (BitAnd)
        "$254"
        (I64)
        "%rax"
        "%rax"
        false)
        [(Some asm) (string.eq asm "    andl $254, %eax\n")]
        [(No) false])
      (match (be_scalar.compiler-backend-binop-immediate-asm
        (ast.ast-node-pool-reader-type-segment-bases)
        (BitAnd)
        "$256"
        (I64)
        "%rax"
        "%rax"
        false)
        [(Some asm) (string.eq asm "    andl $256, %eax\n")]
        [(No) false])
      (match (be_scalar.compiler-backend-binop-immediate-asm
        (ast.ast-node-pool-reader-type-segment-bases)
        (BitAnd)
        "$65280"
        (I64)
        "%rax"
        "%rax"
        false)
        [(Some asm) (string.eq asm "    andl $65280, %eax\n")]
        [(No) false])
      (match (be_scalar.compiler-backend-binop-immediate-asm
        (ast.ast-node-pool-reader-type-segment-bases)
        (BitOr)
        "$255"
        (I64)
        "%rax"
        "%rax"
        false)
        [(Some asm) (string.eq asm "    orq $255, %rax\n")]
        [(No) false]))))

(define (compiler-backend-bit-and-low-mask-direct-asm
  [rhs : ir.CompilerIrValue]) : be_state.ResultCompilerBackend
  (be_scalar.compiler-backend-emit-binop
    (ast.ast-node-pool-reader-type-segment-bases)
    (regalloc.compiler-reg-var-types-insert
      (regalloc.compiler-reg-var-types-empty)
      0
      (I64))
    (Empty)
    (reg-homes "%0=%r15 %1=%r12")
    1
    (BitAnd)
    (Var 0)
    rhs
    (I64)
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active))))

(define (compiler-backend-bit-and-low-mask-direct-ok?) : bool
  (match (compiler-backend-bit-and-low-mask-direct-asm (I64 255))
    [(Ok byte-asm)
      (match (compiler-backend-bit-and-low-mask-direct-asm (I64 65535))
        [(Ok word-asm)
          (match (compiler-backend-bit-and-low-mask-direct-asm (I64 254))
            [(Ok negative-asm)
              (and
                (be_state.backend-and4
                  (asm-has? byte-asm "    movzbl %r12b, %r12d\n")
                  (asm-lacks?
                    byte-asm
                    "    andq $255, %r12\n"
                    "    andl $255, %r12d\n")
                  (asm-has? word-asm "    movzwl %r12w, %r12d\n")
                  (asm-lacks?
                    word-asm
                    "    andq $65535, %r12\n"
                    "    andl $65535, %r12d\n"))
                (asm-has? negative-asm "    andl $254, %r12d\n"))]
            [(Err _) false])]
        [(Err _) false])]
    [(Err _) false]))

