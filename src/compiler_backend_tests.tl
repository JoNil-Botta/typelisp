(define (compiler-backend-avx2-tail-mask-ok?) : bool
  (and
    (match (compiler-backend-avx2-tail-mask-emits 4)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.backend-and4
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    vpbroadcastq %xmm0, %ymm0\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              (str_cat.str-cat
                "    vpaddq "
                (compiler_backend.compiler-backend-avx2-i64-lane-id-label)
                "(%rip), %ymm0, %ymm0\n"))
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    vpcmpgtq %ymm0, %ymm1, %ymm6\n")
            (not
              (compiler_backend.compiler-backend-string-contains? asm "(%rsp)")))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "_tail_skip_")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    (match (compiler-backend-avx2-tail-mask-emits 8)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.backend-and4
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    subq $32, %rsp\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "_tail_skip_0")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movl $-1, ")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                (compiler_backend.compiler-backend-avx2-i64-lane-id-label))))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    vpcmpgtq ")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    (let
      [qword : compiler_backend.CompilerBackendProgramCollections
        (compiler_backend.compiler-backend-collect-instr-collections
          (compiler_backend.compiler-backend-program-collections-new)
          (compiler_ir_types.CompilerIrInstr.TailMask
            0
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            4))]
      [dword : compiler_backend.CompilerBackendProgramCollections
        (compiler_backend.compiler-backend-collect-instr-collections
          (compiler_backend.compiler-backend-program-collections-new)
          (compiler_ir_types.CompilerIrInstr.TailMask
            0
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            8))]
      (and
        (compiler_backend.compiler-backend-program-collections-uses-avx2-i64-lane-id?
          qword)
        (not
          (compiler_backend.compiler-backend-program-collections-uses-avx2-i64-lane-id?
            dword))))))

