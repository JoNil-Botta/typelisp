(define (compiler-backend-program-argv-entry-capture-source) : String
  "(extern (fixture-strlen [arg0 : (Ptr u8)]) : i64 (:symbol \"strlen\"))
(define (main) : i64
  (let
    [argv : (Ptr (Ptr u8)) (unsafe (program-argv))]
    [raw : (Ptr u8) (unsafe (ptr-read (ptr-offset argv 1)))]
    (fixture-strlen raw)))")

(define (compiler-backend-program-argv-entry-capture-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-program-argv-entry-capture-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and8
        (compiler-backend-string-contains? asm "_tl_start:\n")
        (compiler-backend-string-contains? asm "    movq (%rsp), %rax\n")
        (compiler-backend-string-contains?
          asm
          "    movq %rax, .L_tl_argc(%rip)\n")
        (compiler-backend-string-contains? asm "    leaq 8(%rsp), %rax\n")
        (compiler-backend-string-contains?
          asm
          "    movq %rax, .L_tl_argv(%rip)\n")
        (compiler-backend-string-contains? asm "    call strlen\n")
        (not (compiler-backend-string-contains? asm ".L_tl_arg_count:\n"))
        (not (compiler-backend-string-contains? asm ".L_tl_arg:\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-arg-runtime-source) : String
  "(extern (runtime-arg [arg0 : i64]) : String (:symbol \".L_tl_arg\"))
(define (io.arg [index : i64]) : String
  (runtime-arg index))
(define (main) : i64
  (__tl_string_length (io.arg 0)))")

(define (compiler-backend-arg-runtime-abort-ok?) : bool
  (and
    (match (compiler-backend-emit-source-for-target
      (compiler-backend-arg-runtime-source)
      (CompilerBackendTarget.Linux))
      [(ResultCompilerBackend.Ok asm)
        (and
          (backend-and8
            (compiler-backend-string-contains? asm ".extern _u2eL_tl_arg\n")
            (compiler-backend-string-contains? asm "    call _u2eL_tl_arg\n")
            (not (compiler-backend-string-contains? asm ".L_tl_arg:\n"))
            (not (compiler-backend-string-contains? asm ".L_tl_abort:\n"))
            (not (compiler-backend-string-contains? asm ".L_tl_arg_oob_msg:\n"))
            (not
              (compiler-backend-string-contains? asm "    call .L_tl_abort\n"))
            (not (compiler-backend-string-contains? asm "tl_alloc:\n"))
            (compiler-backend-string-contains? asm ".L_tl_argc:\n"))
          (compiler-backend-string-contains? asm ".L_tl_argv:\n")
          (not (compiler-backend-string-contains? asm ".extern .L_tl_abort\n")))]
      [(ResultCompilerBackend.Err _) false])
    (match (compiler-backend-emit-source-for-target
      (compiler-backend-arg-runtime-source)
      (CompilerBackendTarget.Windows))
      [(ResultCompilerBackend.Ok asm)
        (backend-and8
          (compiler-backend-string-contains? asm ".extern _u2eL_tl_arg\n")
          (compiler-backend-string-contains? asm "    call _u2eL_tl_arg\n")
          (not (compiler-backend-string-contains? asm ".L_tl_arg:\n"))
          (not (compiler-backend-string-contains? asm ".L_tl_abort:\n"))
          (not (compiler-backend-string-contains? asm ".L_tl_arg_oob_msg:\n"))
          (not (compiler-backend-string-contains? asm "    call .L_tl_abort\n"))
          (not (compiler-backend-string-contains? asm "    .extern _write\n"))
          (not (compiler-backend-string-contains? asm ".extern .L_tl_abort\n")))]
      [(ResultCompilerBackend.Err _) false])))

;; Backend-owned replacement for the Rust `string.string-ref` emit-shape checks:
;; source-level string indexing should keep literal string data, use an
;; unsigned bounds check, call the out-of-bounds helper, and zero-extend the
;; selected byte into the char result.
(define (compiler-backend-string-ref-source) : String
  "(define sample : String \"az\")
(define (pick [i : i64]) : char (__tl_string_ref sample i))
(define (main) : i64 0)")

(define (compiler-backend-string-ref-shape-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-string-ref-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (compiler-backend-string-contains?
            asm
            ".L_tl_str_data_l2_12961_16211:")
          (compiler-backend-string-contains? asm ".L_tl_str_l2_12961_16211:")
          (compiler-backend-string-contains? asm "    .string \"az\"\n")
          (compiler-backend-string-contains?
            asm
            "    .quad .L_tl_str_data_l2_12961_16211\n")
          (not (compiler-backend-string-contains? asm "    cmpq %r11, %rax\n"))
          (compiler-backend-string-contains? asm "    jb .Lf0_str_bounds_ok")
          (compiler-backend-string-contains? asm "    call tl_oob_abort")
          (not (compiler-backend-string-contains? asm "tl_oob_abort:\n")))
        (backend-and4
          (compiler-backend-string-contains? asm "    movq 8(%r10), %r8\n")
          (compiler-backend-string-contains? asm "(%r10)")
          (compiler-backend-string-contains? asm "movzbq")
          (not (compiler-backend-string-contains? asm "movsbq (%r10)")))
        (not (compiler-backend-string-contains? asm "    movq 8(%r10), %rax\n"))
        (not
          (compiler-backend-string-contains? asm "    jl .Lf0_str_bounds_ok"))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-aggregate-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-aggregate-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          ;; sret ABI: aggregate returns write the caller's sret slot
          ;; instead of arena-allocating a 16-byte object.
          (not (compiler-backend-string-contains-alloc-size? asm 16))
          (compiler-backend-string-contains?
            asm
            ".globl _tl___enum_obj_Shape_Nothing\n")
          (compiler-backend-string-contains? asm "    movq $1, (%r10)\n")
          (compiler-backend-string-contains? asm "    movq $2, (%r10)\n")
          (not (compiler-backend-string-contains? asm "    call _tl_Point\n"))
          (not (compiler-backend-string-contains? asm "    call _tl_Nothing\n"))
          (not (compiler-backend-string-contains? asm "    call _tl_Circle\n"))
          (not (compiler-backend-string-contains? asm "    call _tl_Pair\n")))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-pack-immediate-word-shape-ok?) : bool
  (match (compiler-backend-emit-pack-words
    CompilerRegAssignmentList.Nil
    (CompilerIrValue.I64 7)
    (CompilerIrValue.Bool true)
    "-16(%rbp)"
    "-24(%rbp)"
    false
    false
    ""
    ""
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok stack-asm)
      (match (compiler-backend-emit-pack-words
        CompilerRegAssignmentList.Nil
        (CompilerIrValue.I64 9)
        (CompilerIrValue.Char 'A')
        "%r12"
        "%r13"
        false
        false
        ""
        ""
        (compiler-diagnostic-at-start "" ""))
        [(ResultCompilerBackend.Ok reg-asm)
          (and
            (compiler-backend-string-contains?
              stack-asm
              "    movq $7, -16(%rbp)\n")
            (compiler-backend-string-contains?
              stack-asm
              "    movq $1, -24(%rbp)\n")
            (compiler-backend-string-contains? reg-asm "    movl $9, %r12d\n")
            (compiler-backend-string-contains? reg-asm "    movl $65, %r13d\n")
            (not (compiler-backend-string-contains? stack-asm "%rax"))
            (not (compiler-backend-string-contains? stack-asm "%rdx"))
            (not (compiler-backend-string-contains? reg-asm "%rax"))
            (not (compiler-backend-string-contains? reg-asm "%rdx")))]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-pack-scavenged-word-shape-ok?) : bool
  (let
    [gp-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%r13"))
          CompilerRegAssignmentList.Nil))]
    [xmm-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%xmm3"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%xmm4"))
          CompilerRegAssignmentList.Nil))]
    (match (compiler-backend-emit-pack-words
      gp-assignments
      (CompilerIrValue.Var 0)
      (CompilerIrValue.Var 1)
      "-16(%rbp)"
      "-24(%rbp)"
      false
      false
      ""
      ""
      (compiler-diagnostic-at-start "" ""))
      [(ResultCompilerBackend.Ok gp-asm)
        (match (compiler-backend-emit-pack-words
          xmm-assignments
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          "-16(%rbp)"
          "-24(%rbp)"
          true
          true
          ""
          ""
          (compiler-diagnostic-at-start "" ""))
          [(ResultCompilerBackend.Ok xmm-asm)
            (and
              (backend-and8
                (compiler-backend-string-contains?
                  gp-asm
                  "    movq %r12, %r8\n")
                (compiler-backend-string-contains?
                  gp-asm
                  "    movq %r13, %r9\n")
                (compiler-backend-string-contains?
                  gp-asm
                  "    movq %r8, -16(%rbp)\n")
                (compiler-backend-string-contains?
                  gp-asm
                  "    movq %r9, -24(%rbp)\n")
                (compiler-backend-string-contains?
                  xmm-asm
                  "    movsd %xmm3, %xmm2\n")
                (compiler-backend-string-contains?
                  xmm-asm
                  "    movsd %xmm4, %xmm3\n")
                (compiler-backend-string-contains?
                  xmm-asm
                  "    movsd %xmm2, -16(%rbp)\n")
                (compiler-backend-string-contains?
                  xmm-asm
                  "    movsd %xmm3, -24(%rbp)\n"))
              (not (compiler-backend-string-contains? gp-asm "%rax"))
              (not (compiler-backend-string-contains? gp-asm "%rdx"))
              (not (compiler-backend-string-contains? xmm-asm "%xmm0"))
              (not (compiler-backend-string-contains? xmm-asm "%xmm1")))]
          [(ResultCompilerBackend.Err _) false])]
      [(ResultCompilerBackend.Err _) false])))

;; Backend-owned replacement for representative aggregate storage emit-shape
;; checks from the legacy backend suite.
(define (compiler-backend-aggregate-return-source) : String
  "(defenum Shape (Circle i64) (Square i64) (Nothing))
(defstruct Point (x i64) (y i64))
(define (mk-shape) : Shape (Circle 7))
(define (mk-point) : Point (Point 1 2))
(define (mk-string) : String \"hi\")
(define (main) : i64
  (+ (match (mk-shape) [(Circle r) r] [(Square s) s] [Nothing 0])
     (+ (struct-get (mk-point) y) (__tl_string_length (mk-string)))))")

(define (compiler-backend-aggregate-return-shape-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-aggregate-return-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          ;; sret ABI: struct/enum returns write the result through the
          ;; caller-provided sret slot -- no per-return arena allocation.
          (= (compiler-backend-alloc-call-count asm) 0)
          (not (compiler-backend-string-contains-alloc-size? asm 16))
          (compiler-backend-string-contains? asm "movq $7,")
          (compiler-backend-string-contains? asm "movq $1,")
          (compiler-backend-string-contains? asm "movq $2,")
          (compiler-backend-string-contains?
            asm
            ".L_tl_str_data_l2_13861_13991:")
          (compiler-backend-string-contains? asm "    .quad 2\n")
          true)
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-aggregate-global-init-source) : String
  "(defenum LocalMaybe (Some i64) (None))
(defstruct Pair (x i64) (y i64))
(defstruct Nested (label String) (choice LocalMaybe))
(define (string.concat [left : String] [right : String]) : String
  left)

(define greeting : String (string.concat \"he\" \"llo\"))
(define choice : LocalMaybe (Some 8))
(define pair : Pair (Pair 10 11))
(define cells : (Array i64) (make-array i64 3))
(define nested : Nested (Nested (string.concat \"o\" \"k\") (Some 3)))

(define (main) : i64
  (+ (+ (+ (__tl_string_length greeting) (length cells))
        (+ (struct-get pair x) (struct-get pair y)))
     (+ (match choice [(Some n) n] [None 0])
        (+ (__tl_string_length (struct-get nested label))
           (match (struct-get nested choice) [(Some n) n] [None 0])))))")

(define (compiler-backend-runtime-global-shape-ok?
  [asm : String]
  [name : String]) : bool
  (let
    [symbol : String (string.append "_tl_" name)]
    [init-symbol : String (string.append "_tl___global_init_" name)]
    (and
      (backend-and4
        ;; A register-group global (e.g. `pair`) reserves 16 inline bytes;
        ;; an 8-byte handle/scalar global reserves 8. Accept either.
        (or
          (compiler-backend-string-contains?
            asm
            (str_cat.str-cat "    .comm " symbol ", 8, 8\n"))
          (compiler-backend-string-contains?
            asm
            (str_cat.str-cat "    .comm " symbol ", 16, 8\n")))
        (compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    call " init-symbol "\n"))
        (compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    movq %rax, " symbol "(%rip)\n"))
        (compiler-backend-string-contains?
          asm
          (str_cat.str-cat init-symbol ":\n" "")))
      (or
        (compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    movq " symbol "(%rip), %rax\n"))
        (compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    movq " symbol "(%rip), %r10\n"))
        ;; A register-group global is read via its address.
        (compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    leaq " symbol "(%rip), %r10\n"))))))

(define (compiler-backend-aggregate-global-init-shape-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-aggregate-global-init-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (compiler-backend-runtime-global-shape-ok? asm "greeting")
          (compiler-backend-runtime-global-shape-ok? asm "choice")
          (compiler-backend-runtime-global-shape-ok? asm "pair")
          (compiler-backend-runtime-global-shape-ok? asm "cells")
          (compiler-backend-runtime-global-shape-ok? asm "nested")
          (compiler-backend-string-contains? asm "_tl_start:\n")
          (compiler-backend-string-contains?
            asm
            ".L_tl_main_keep_stack:\n    call main\n")
          (not
            (compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))
        true)]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-aggregate-storage-shape-ok?) : bool
  (and
    (compiler-backend-pack-scavenged-word-shape-ok?)
    (compiler-backend-aggregate-return-shape-ok?)
    (compiler-backend-aggregate-global-init-shape-ok?)))

;; Backend-owned replacement for closure/lambda emit-shape checks.
;; The source uses synthetic lambda lowered names because AstExpr.Lambda lowering
;; is tracked separately; this pins the backend descriptor, adapter, and
;; indirect-call shape produced by the same IR names.
(define (compiler-backend-closure-literal-source) : String
  "(define (__tl_lambda_main_0 [x : i64]) : i64 (+ x 1))
(define (main) : i64
  (let [f : (-> i64 i64) __tl_lambda_main_0]
    (f 41)))")

(define (compiler-backend-closure-inferred-source) : String
  "(define (__tl_lambda_main_0 [x : i64]) : i64
  (let [y : i64 (+ x 1)]
    y))
(define (main) : i64
  (let [f : (-> i64 i64) __tl_lambda_main_0]
    (f 41)))")

(define (compiler-backend-closure-aggregate-return-source) : String
  "(defenum Box (BoxI i64))
(defstruct Pair (x i64) (y i64))

(define (__tl_lambda_main_0) : String \"hello\")
(define (__tl_lambda_main_1) : Box (BoxI 11))
(define (__tl_lambda_main_2) : (Array i64) (make-array i64 13))
(define (__tl_lambda_main_3) : Pair (Pair 1 13))

(define (main) : i64
  (let [mk-string : (-> String) __tl_lambda_main_0]
        [mk-enum : (-> Box) __tl_lambda_main_1]
        [mk-array : (-> (Array i64)) __tl_lambda_main_2]
        [mk-struct : (-> Pair) __tl_lambda_main_3]
    (+ (__tl_string_length (mk-string))
       (+ (match (mk-enum) [(BoxI n) n])
          (+ (array-length (mk-array))
             (struct-get (mk-struct) y))))))")

(define (compiler-backend-closure-literal-shape-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-closure-literal-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (compiler-backend-string-contains? asm "_tl_f")
          (compiler-backend-string-contains?
            asm
            ".L_tl_fn_desc___tl_lambda_main_0:\n")
          (compiler-backend-string-contains?
            asm
            "    .quad .L_tl_fn_entry___tl_lambda_main_0\n")
          (compiler-backend-string-contains?
            asm
            ".L_tl_fn_entry___tl_lambda_main_0:\n")
          (compiler-backend-string-contains? asm "    call _tl_f")
          (compiler-backend-string-contains?
            asm
            "    leaq .L_tl_fn_desc___tl_lambda_main_0(%rip), ")
          (compiler-backend-call-or-jmp-ok? asm "*(%r10)")
          (not
            (compiler-backend-string-contains? asm "    movq (%r10), %rax\n")))
        (compiler-backend-string-contains? asm "    movq 8(%r10), %rdi\n")
        (not (compiler-backend-call-or-jmp-ok? asm "*(%r11)"))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-closure-inferred-shape-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-closure-inferred-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and4
        (compiler-backend-string-contains? asm "_tl_f")
        (compiler-backend-string-contains? asm "    call _tl_f")
        (compiler-backend-call-or-jmp-ok? asm "*(%r10)")
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-closure-aggregate-return-shape-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-closure-aggregate-return-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (>= (compiler-backend-string-count asm ".globl _tl_f") 4)
          (compiler-backend-string-contains? asm "_tl_f")
          (compiler-backend-string-contains? asm "    call _tl_f")
          (compiler-backend-string-contains? asm "main:\n")
          (compiler-backend-string-contains?
            asm
            ".L_tl_fn_desc___tl_lambda_main_0:\n")
          (compiler-backend-string-contains?
            asm
            ".L_tl_fn_desc___tl_lambda_main_1:\n")
          (compiler-backend-string-contains?
            asm
            ".L_tl_fn_desc___tl_lambda_main_2:\n")
          (compiler-backend-string-contains?
            asm
            ".L_tl_fn_desc___tl_lambda_main_3:\n"))
        (backend-and8
          (compiler-backend-string-contains?
            asm
            ".L_tl_fn_entry___tl_lambda_main_0:\n")
          (compiler-backend-string-contains?
            asm
            ".L_tl_fn_entry___tl_lambda_main_1:\n")
          (compiler-backend-string-contains?
            asm
            ".L_tl_fn_entry___tl_lambda_main_2:\n")
          (compiler-backend-string-contains?
            asm
            ".L_tl_fn_entry___tl_lambda_main_3:\n")
          (compiler-backend-string-contains?
            asm
            "    .quad .L_tl_fn_entry___tl_lambda_main_0\n")
          (compiler-backend-string-contains?
            asm
            "    .quad .L_tl_fn_entry___tl_lambda_main_1\n")
          (compiler-backend-string-contains?
            asm
            "    .quad .L_tl_fn_entry___tl_lambda_main_2\n")
          (compiler-backend-string-contains?
            asm
            "    .quad .L_tl_fn_entry___tl_lambda_main_3\n"))
        (backend-and8
          (compiler-backend-string-contains? asm "tl_alloc:\n")
          ;; sret ABI: only the heap-backed (Array) closure return
          ;; still allocates; Box/Pair/String returns use sret/static data.
          (>= (compiler-backend-alloc-call-count asm) 1)
          (>=
            (+
              (compiler-backend-string-count asm "    call *(%r10)\n")
              (compiler-backend-string-count asm "    jmp *(%r10)\n"))
            4)
          (and
            (not
              (compiler-backend-string-contains? asm "    movq (%r10), %rax\n"))
            (=
              (+
                (compiler-backend-string-count asm "    call *(%r11)\n")
                (compiler-backend-string-count asm "    jmp *(%r11)\n"))
              0))
          (not
            (compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker)))
          true
          true
          true)
        true)]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-closure-emit-shape-ok?) : bool
  (and
    (compiler-backend-closure-literal-shape-ok?)
    (compiler-backend-closure-inferred-shape-ok?)
    (compiler-backend-closure-aggregate-return-shape-ok?)))

(define (compiler-backend-enum-match-ok?) : bool
  ;; `Maybe (None) (Some i64)` is a 16-byte register-resident enum, so the
  ;; tag is matched on a register-held word (no `cmpq $0, (%r10)` heap deref) and
  ;; the payload is read from word1 rather than `8(%r10)`. Those memory-shape
  ;; assertions are obsolete; what remains representation-agnostic is that the
  ;; match lowers to comparison arms and neither variant is built via a runtime
  ;; constructor call (None is an immediate tag, Some is an CompilerIrInstr.Pack).
  (match (compiler-backend-emit-source (compiler-backend-enum-match-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and4
        (or
          (compiler-backend-string-contains? asm "_tl_score")
          (compiler-backend-string-contains? asm "_tl_f"))
        (compiler-backend-string-contains? asm "_match_arm.")
        (not (compiler-backend-string-contains? asm "    call _tl_None\n"))
        (not (compiler-backend-string-contains? asm "    call _tl_Some\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-never-branch-register-group-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-never-branch-register-group-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "main:\n")
        (not (compiler-backend-string-contains? asm "register-group")))]
    [(ResultCompilerBackend.Err _) false]))

;; Scalar backend emission intentionally uses the stack-only plan by default for
;; cold compile speed; allocator behavior is still covered in compiler_regalloc.tl
;; and by AVX/vector backend smoke paths.
(define (compiler-backend-regalloc-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-regalloc-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and8
        (or
          (compiler-backend-string-contains? asm "_tl_calc")
          (compiler-backend-string-contains? asm "_tl_f"))
        ;; FPO (M-G3 stage 2) makes frame refs rsp-relative; params spill
        ;; to rsp slots and the spilled sum is reloaded into a scratch (%r8),
        ;; leaving the product in %rax.
        (compiler-backend-string-contains? asm "    movq %rdi, 56(%rsp)\n")
        (compiler-backend-string-contains? asm "    movq %rsi, 48(%rsp)\n")
        (compiler-backend-string-contains? asm "    movq 32(%rsp), %r8\n")
        (compiler-backend-string-contains? asm "    imulq %r8, %rax\n")
        (not (compiler-backend-string-contains? asm "    movq %r12, -"))
        true
        true)]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-regalloc-f64-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-regalloc-f64-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and8
        ;; FPO (M-G3 stage 2) rsp-relative frame slots (a=32, b=16, sum=8).
        (compiler-backend-string-contains? asm "main:\n")
        (compiler-backend-string-contains? asm "    movsd 32(%rsp), %xmm2\n")
        (compiler-backend-string-contains? asm "    addsd 16(%rsp), %xmm2\n")
        (compiler-backend-string-contains? asm "    movsd %xmm2, 8(%rsp)\n")
        (compiler-backend-string-contains? asm "    movsd 8(%rsp), %xmm0\n")
        (not (compiler-backend-string-contains? asm "    addsd %xmm1, %xmm0\n"))
        (not
          (compiler-backend-string-contains? asm "    movsd 32(%rsp), %xmm0\n"))
        (not (compiler-backend-string-contains? asm "%xmm3")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-call-save-test-globals) : CompilerIrGlobalList
  (let
    [globals : CompilerIrGlobalList CompilerIrGlobalList.Nil]
    (begin
      (set!
        globals
        (compiler-ir-global-cons
          (CompilerIrGlobal.Global
            (ci.intern "g5c")
            (AstType.I64)
            (CompilerIrValue.I64 0))
          globals))
      (set!
        globals
        (compiler-ir-global-cons
          (CompilerIrGlobal.Global
            (ci.intern "g5b")
            (AstType.I64)
            (CompilerIrValue.I64 0))
          globals))
      (set!
        globals
        (compiler-ir-global-cons
          (CompilerIrGlobal.Global
            (ci.intern "g6")
            (AstType.I64)
            (CompilerIrValue.I64 0))
          globals))
      (set!
        globals
        (compiler-ir-global-cons
          (CompilerIrGlobal.Global
            (ci.intern "g5")
            (AstType.I64)
            (CompilerIrValue.I64 0))
          globals))
      (set!
        globals
        (compiler-ir-global-cons
          (CompilerIrGlobal.Global
            (ci.intern "g4")
            (AstType.I64)
            (CompilerIrValue.I64 0))
          globals))
      (set!
        globals
        (compiler-ir-global-cons
          (CompilerIrGlobal.Global
            (ci.intern "g3")
            (AstType.I64)
            (CompilerIrValue.I64 0))
          globals))
      (set!
        globals
        (compiler-ir-global-cons
          (CompilerIrGlobal.Global
            (ci.intern "g2")
            (AstType.I64)
            (CompilerIrValue.I64 0))
          globals))
      (set!
        globals
        (compiler-ir-global-cons
          (CompilerIrGlobal.Global
            (ci.intern "g1")
            (AstType.I64)
            (CompilerIrValue.I64 0))
          globals))
      (set!
        globals
        (compiler-ir-global-cons
          (CompilerIrGlobal.Global
            (ci.intern "g0")
            (AstType.I64)
            (CompilerIrValue.I64 0))
          globals))
      globals)))

(define (compiler-backend-call-save-main-instrs) : CompilerIrInstrList
  (let
    [instrs : CompilerIrInstrList CompilerIrInstrList.Nil]
    (begin
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Return
            (CompilerIrMaybeValue.Some (CompilerIrValue.I64 0)))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g5c")
            (CompilerIrValue.Var 5)
            (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g5b")
            (CompilerIrValue.Var 5)
            (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g6")
            (CompilerIrValue.Var 6)
            (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g5")
            (CompilerIrValue.Var 5)
            (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g4")
            (CompilerIrValue.Var 4)
            (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g3")
            (CompilerIrValue.Var 3)
            (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g2")
            (CompilerIrValue.Var 2)
            (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g1")
            (CompilerIrValue.Var 1)
            (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g0")
            (CompilerIrValue.Var 0)
            (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Call
            7
            (ci.intern "side_effect")
            (CompilerIrCallArgs.Nil)
            (AstType.Unit))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Mov 6 (CompilerIrValue.I64 6) (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Mov 5 (CompilerIrValue.I64 5) (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Mov 4 (CompilerIrValue.I64 4) (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Mov 3 (CompilerIrValue.I64 3) (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Mov 2 (CompilerIrValue.I64 2) (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Mov 1 (CompilerIrValue.I64 1) (AstType.I64))
          instrs))
      (set!
        instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Mov 0 (CompilerIrValue.I64 0) (AstType.I64))
          instrs))
      instrs)))

(define (compiler-backend-call-save-program) : CompilerIrProgram
  (CompilerIrProgram.Program
    (compiler-backend-call-save-test-globals)
    (compiler-ir-function-cons
      (CompilerIrFunction.Function
        (ci.intern "side_effect")
        CompilerIrParamList.Nil
        (AstType.Unit)
        0
        (compiler-ir-block-cons
          (compiler-ir-block
            "entry"
            (compiler-ir-instr-cons
              (CompilerIrInstr.Return CompilerIrMaybeValue.No)
              CompilerIrInstrList.Nil))
          CompilerIrBlockList.Nil))
      (compiler-ir-function-cons
        (CompilerIrFunction.Function
          (ci.intern "main")
          CompilerIrParamList.Nil
          (AstType.I64)
          8
          (compiler-ir-block-cons
            (compiler-ir-block "entry" (compiler-backend-call-save-main-instrs))
            CompilerIrBlockList.Nil))
        CompilerIrFunctionList.Nil))
    CompilerIrExternList.Nil))

(define (compiler-backend-call-save-r9-wrap-ok?) : bool
  (begin
    (compiler-backend-set-scalar-registers! true)
    (match (compiler-backend-emit-program-linux
      (compiler-backend-call-save-program))
      [(ResultCompilerBackend.Ok asm)
        (let
          [ok : bool
            (and
              (compiler-backend-string-contains?
                asm
                "    call _tl_side_effect\n")
              ;; The unified greedy keeps the call-spanning value in a
              ;; callee-saved register and rematerialises the cold immediates
              ;; after the call, so there should be no caller-saved %r9
              ;; save/restore wrapper around the call.
              (not
                (compiler-backend-string-contains?
                  asm
                  "    movq %r9, %rax\n    movq %rax, -"))
              (not (compiler-backend-string-contains? asm "(%rbp), %r9\n"))
              (compiler-backend-string-contains?
                asm
                "    movq %r12, _tl_g5(%rip)\n")
              (compiler-backend-string-contains?
                asm
                "    movq %r12, _tl_g5b(%rip)\n")
              ;; %rbp is now the 6th callee-saved register (M-G3 stage 2),
              ;; so the call-spanning var 4 is homed in %rbp instead of being
              ;; rematerialised into caller-saved %r9d after the call; var 6
              ;; (the 7th, coldest) is still the rematerialised one in %r9d.
              (compiler-backend-string-contains? asm "    movl $4, %ebp\n")
              (compiler-backend-string-contains? asm "    movl $6, %r9d\n"))]
          (begin
            (compiler-backend-set-scalar-registers! false)
            ok))]
      [(ResultCompilerBackend.Err _)
        (begin
          (compiler-backend-set-scalar-registers! false)
          false)])))

;; #4720: an outlined shifted loop bound becomes `0 < word-count` after loop
;; rotation. On Win64, word-count may be homed in %r9; materialising the
;; immediate LHS into that same register silently changed the pre-test into a
;; self-compare. Keep the function address-taken so opt2 cannot inline away the
;; allocation shape, then emit the full lower -> opt2 -> scalar-regalloc path.
(define compiler-backend-shifted-loop-bound-source : String
  "(define (array-zero-count [buf : (MutPtr u8)] [byte-count : i64]) : i64
  (let
    [word-count : i64 (shr byte-count 3)]
    [tail-start : i64 (* word-count 8)]
    [slots : (MutPtr u64) (unsafe (ptr-cast buf : (MutPtr u64)))]
    [w : i64 0]
    [i : i64 tail-start]
    (begin
      (while (< w word-count)
        (begin
          (unsafe (ptr-write! (ptr-offset slots w) (cast 0 : u64)))
          (set! w (+ w 1))))
      (while (< i byte-count)
        (begin
          (unsafe (ptr-write! (ptr-offset buf i) (cast 0 : u8)))
          (set! i (+ i 1))))
      w)))
(define (keep [f : (-> (MutPtr u8) i64 i64)]) : i64 0)
(define (main) : i64 (keep array-zero-count))")

(define (compiler-backend-emit-source-opt2-for-target
  [source : String]
  [target : CompilerBackendTarget]) : ResultCompilerBackend
  (match (compiler-backend-lower-source-for-target source target)
    [(ResultCompilerLower.Ok program spans)
      (match (optimize-program-with-spans-and-level program spans 2)
        [(CompilerOptimizedProgram.Program optimized optimized-spans)
          (compiler-backend-emit-program-with-spans-for-target
            optimized
            optimized-spans
            target)])]
    [(ResultCompilerLower.Err diag) (ResultCompilerBackend.Err diag)]))

(define (compiler-backend-compare-self-operand? [body : String] [reg : String]) : bool
  (compiler-backend-string-contains?
    body
    (string.append
      "    cmpq "
      (string.append reg (string.append ", " (string.append reg "\n"))))))

(define (compiler-backend-immediate-lhs-r9-compare-win64-ok?) : bool
  (let
    [_win : unit (compiler-backend-set-current-fn-win64!)]
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r9"))
        CompilerRegAssignmentList.Nil)]
    [ok : bool
      (match (compiler-backend-emit-compare-branch
        assignments
        "cmp"
        (CompilerIrBinOp.Lt)
        (CompilerIrValue.I64 0)
        (CompilerIrValue.Var 0)
        (AstType.I64)
        "then"
        "else"
        (CompilerBackendMaybeLabel.No))
        [(ResultCompilerBackend.Ok asm)
          (and
            ;; `0 < %r9` is emitted as `%r9 > 0`; no scratch can alias the
            ;; RHS between its definition and this compare.
            (compiler-backend-string-contains? asm "    cmpq $0, %r9\n")
            (not (compiler-backend-string-contains? asm "    cmpq %r9, %r9\n")))]
        [(ResultCompilerBackend.Err _) false])]
    [_linux : unit (compiler-backend-set-current-fn-linux!)]
    ok))

(define (compiler-backend-shifted-loop-bound-win64-ok?) : bool
  (begin
    (compiler-backend-set-scalar-registers! true)
    (let
      [ok : bool
        (match (compiler-backend-emit-source-opt2-for-target
          compiler-backend-shifted-loop-bound-source
          (CompilerBackendTarget.Windows))
          [(ResultCompilerBackend.Ok asm)
            (let
              [body : String
                (compiler-backend-asm-function-body asm "_tl_array_zero_count")]
              (and
                (not (string.eq body ""))
                (compiler-backend-string-contains? body "    sarq $3,")
                ;; The full regalloc path may spill either compare operand, so
                ;; its exact register choice is intentionally not asserted
                ;; here. No emitted compare may instead test a register against
                ;; itself, which was the original zero-trip-loop corruption.
                (not (compiler-backend-compare-self-operand? body "%rax"))
                (not (compiler-backend-compare-self-operand? body "%rcx"))
                (not (compiler-backend-compare-self-operand? body "%rdx"))
                (not (compiler-backend-compare-self-operand? body "%r8"))
                (not (compiler-backend-compare-self-operand? body "%r9"))
                (not (compiler-backend-compare-self-operand? body "%r10"))
                (not (compiler-backend-compare-self-operand? body "%r11"))
                (compiler-backend-immediate-lhs-r9-compare-win64-ok?)))]
          [(ResultCompilerBackend.Err _) false])]
      (begin
        (compiler-backend-set-scalar-registers! false)
        (compiler-backend-set-current-fn-linux!)
        ok))))

(define (compiler-backend-peephole-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        1
        (CompilerRegLocation.Register "%xmm2"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%r13"))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-expanded-scalar-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r8"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r9"))
      CompilerRegAssignmentList.Nil)))

(define (compiler-backend-expanded-scalar-regs-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-backend-expanded-scalar-assignments)]
    (and
      (string.eq
        (compiler-backend-emit-load-var-with-plan assignments 0 "%rax")
        "    movq %r8, %rax\n")
      (string.eq
        (compiler-backend-emit-store-var-with-plan assignments 1 "%rax")
        "    movq %rax, %r9\n")
      (string.eq
        (compiler-backend-emit-load-register "%r8" (AstType.U32))
        "    movl %r8d, %eax\n")
      (not (compiler-backend-plan-uses-callee-regs? assignments))
      (= (compiler-backend-frame-slots 2 assignments) 2))))

(define (compiler-backend-callee-save-assignments1) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    CompilerRegAssignmentList.Nil))

(define (compiler-backend-callee-save-assignments2) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r13"))
      CompilerRegAssignmentList.Nil)))

(define (compiler-backend-callee-save-assignments3) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r13"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%r14"))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-callee-save-assignments4) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r13"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%r14"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            3
            (CompilerRegLocation.Register "%r15"))
          CompilerRegAssignmentList.Nil)))))

(define (compiler-backend-callee-save-assignments5) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r13"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%r14"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            3
            (CompilerRegLocation.Register "%r15"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              4
              (CompilerRegLocation.Register "%rbx"))
            CompilerRegAssignmentList.Nil))))))

(define (compiler-backend-win64-callee-save-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%rsi"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%rdi"))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-win64-callee-save-full-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 5 (CompilerRegLocation.Register "%rsi"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 6 (CompilerRegLocation.Register "%rdi"))
      (compiler-backend-callee-save-assignments5))))

(define (compiler-backend-win64-callee-save-rbp-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 7 (CompilerRegLocation.Register "%rbp"))
    (compiler-backend-win64-callee-save-full-assignments)))

(define (compiler-backend-win64-xmm-full-assignments-at [idx : i64]) : CompilerRegAssignmentList
  (if (>= idx 10)
    CompilerRegAssignmentList.Nil
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        idx
        (CompilerRegLocation.Register
          (string.append "%xmm" (string.int->string (+ idx 6)))))
      (compiler-backend-win64-xmm-full-assignments-at (+ idx 1)))))

(define (compiler-backend-win64-xmm-full-assignments) : CompilerRegAssignmentList
  (compiler-backend-win64-xmm-full-assignments-at 0))

(define (compiler-backend-win64-xmm-sparse-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      ;; The canonical ownership lookup must recognize vector-width aliases.
      (CompilerRegAssignment.Assignment
        1
        (CompilerRegLocation.Register "%vec6"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%zmm15"))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-win64-xmm15-only-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%xmm15"))
    CompilerRegAssignmentList.Nil))

(define (compiler-backend-callee-save-double-return-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.Return CompilerIrMaybeValue.No)
        CompilerIrInstrList.Nil))
    (compiler-ir-block-cons
      (compiler-ir-block
        "alt"
        (compiler-ir-instr-cons
          (CompilerIrInstr.Return CompilerIrMaybeValue.No)
          CompilerIrInstrList.Nil))
      CompilerIrBlockList.Nil)))

(define (compiler-backend-callee-save-pop-epilogue-ok?) : bool
  (let
    [_abi : unit (compiler-backend-set-current-fn-linux!)]
    [one : CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments1)]
    [two : CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments2)]
    [three : CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments3)]
    [four : CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments4)]
    [five : CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments5)]
    [shared : String
      (compiler-backend-return-epilogue
        (ci.intern "pop_shared")
        five
        1
        (compiler-backend-callee-save-double-return-blocks))]
    (and
      (backend-and8
        (string.eq
          (compiler-backend-emit-restore-callee-regs one 3)
          "    movq -32(%rbp), %r12\n")
        (string.eq
          (compiler-backend-emit-restore-callee-regs two 3)
          "    leaq -40(%rbp), %rsp\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler-backend-emit-restore-callee-regs three 2)
          "    leaq -40(%rbp), %rsp\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler-backend-emit-restore-callee-regs four 2)
          "    leaq -48(%rbp), %rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler-backend-emit-restore-callee-regs five 1)
          "    leaq -48(%rbp), %rsp\n    popq %rbx\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler-backend-inline-return-tail two 3)
          "    leaq -40(%rbp), %rsp\n    popq %r13\n    popq %r12\n    leave\n    ret\n")
        (string.eq
          (compiler-backend-tail-jump-tail four 2 "_tl_next")
          "    leaq -48(%rbp), %rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    leave\n    jmp _tl_next\n")
        (compiler-backend-string-contains? shared "    popq %rbx\n"))
      (compiler-backend-string-contains? shared "    leave\n    ret\n")
      (not (string.eq shared "")))))

(define (compiler-backend-callee-save-push-prologue-rebase-ok?) : bool
  (let
    [_abi : unit (compiler-backend-set-current-fn-linux!)]
    [assignments : CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments3)]
    [push-regs : (Array String) (compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (compiler-backend-fill-push-csr-regs! assignments push-regs)]
    [prologue : String
      (compiler-backend-emit-function-entry-fpo-push
        "_tl_gap1_push_unit"
        64
        push-regs
        push-count)]
    [post-prologue : String
      "    movq %r12, -32(%rbp)
    movq %r13, -40(%rbp)
    movq %r14, -48(%rbp)
    movq -8(%rbp), %rax
    leaq -48(%rbp), %rsp
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
"]
    [rebased : String
      (compiler-backend-rsp-rebase-full
        post-prologue
        64
        true
        push-regs
        push-count
        3)]
    (and
      (= push-count 3)
      (string.eq
        prologue
        "_tl_gap1_push_unit:
    pushq %r12
    pushq %r13
    pushq %r14
    subq $64, %rsp
")
      compiler-backend-rsp-rebase-last-ok
      (string.eq
        rebased
        "    movq 56(%rsp), %rax
    addq $64, %rsp
    popq %r14
    popq %r13
    popq %r12
    ret
")
      (not (compiler-backend-string-contains? rebased "-32(%rbp)"))
      (not (compiler-backend-string-contains? rebased "-40(%rbp)"))
      (not (compiler-backend-string-contains? rebased "-48(%rbp)"))
      (not (compiler-backend-string-contains? rebased "    leave\n")))))

(define (compiler-backend-win64-callee-save-homes-ok?) : bool
  (let
    [_win : unit (compiler-backend-set-current-fn-win64!)]
    [assignments : CompilerRegAssignmentList
      (compiler-backend-win64-callee-save-assignments)]
    [full : CompilerRegAssignmentList
      (compiler-backend-win64-callee-save-full-assignments)]
    [save : String (compiler-backend-emit-save-callee-regs assignments 3)]
    [restore : String (compiler-backend-emit-restore-callee-regs assignments 3)]
    [full-restore : String (compiler-backend-emit-restore-callee-regs full 1)]
    [ok : bool
      (and
        (compiler-backend-plan-uses-callee-regs? assignments)
        (= (compiler-backend-frame-slots 3 assignments) 10)
        (= (compiler-backend-frame-slots 1 full) 8)
        (string.eq
          save
          "    movq %r12, -32(%rbp)\n    movq %rsi, -72(%rbp)\n    movq %rdi, -80(%rbp)\n")
        (string.eq
          restore
          "    movq -80(%rbp), %rdi\n    movq -72(%rbp), %rsi\n    movq -32(%rbp), %r12\n")
        (not (compiler-backend-string-contains? restore "popq"))
        (not (compiler-backend-string-contains? full-restore "popq"))
        (compiler-backend-string-contains?
          full-restore
          "    movq -64(%rbp), %rdi\n")
        (compiler-backend-string-contains?
          full-restore
          "    movq -56(%rbp), %rsi\n")
        (compiler-backend-string-contains?
          full-restore
          "    movq -48(%rbp), %rbx\n"))]
    [_linux : unit (compiler-backend-set-current-fn-linux!)]
    ok))

(define (compiler-backend-win64-fpo-seh-prologue-ok?) : bool
  (let
    [_win : unit (compiler-backend-set-current-fn-win64!)]
    [assignments : CompilerRegAssignmentList
      (compiler-backend-win64-callee-save-rbp-assignments)]
    [push-regs : (Array String) (compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (compiler-backend-fill-push-csr-regs! assignments push-regs)]
    [frame : i64
      (compiler-backend-frame-size (compiler-backend-frame-slots 1 assignments))]
    [prologue : String
      (compiler-backend-emit-function-entry-fpo-windows
        "_tl_win64_fpo"
        frame
        assignments
        1
        push-regs
        push-count)]
    [safe-body : String
      "    movq %r12, -16(%rbp)
    movq -8(%rbp), %rax
    leaq -72(%rbp), %rsp
    popq %rbp
    popq %rdi
    popq %rsi
    popq %rbx
    popq %r15
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
"]
    [safe-rebased : String
      (compiler-backend-rsp-rebase-full
        safe-body
        frame
        true
        push-regs
        push-count
        1)]
    [safe-ok : bool compiler-backend-rsp-rebase-last-ok]
    [_unsafe : String
      (compiler-backend-rsp-rebase-full
        "    pushq %rax
    popq %rax
    leave
    ret
"
        32
        true
        compiler-backend-rsp-rebase-no-push
        0
        1)]
    [unsafe-rejected : bool (not compiler-backend-rsp-rebase-last-ok)]
    [ok : bool
      (and
        (= push-count 8)
        (= (compiler-backend-frame-slots 1 assignments) 9)
        (compiler-backend-string-contains?
          (compiler-backend-emit-save-callee-regs assignments 1)
          "    movq %rbp, -72(%rbp)\n")
        (= (compiler-backend-string-count prologue "    pushq %") 8)
        (= (compiler-backend-string-count prologue "    .seh_pushreg %") 8)
        (compiler-backend-string-contains? prologue "    pushq %rbp\n")
        (compiler-backend-string-contains? prologue "    .seh_pushreg %rbp\n")
        (compiler-backend-string-contains? prologue "    .seh_stackalloc 88\n")
        (compiler-backend-string-contains? prologue "    .seh_endprologue\n")
        (not (compiler-backend-string-contains? prologue ".seh_setframe"))
        (not (compiler-backend-string-contains? prologue "movq %rsp, %rbp"))
        safe-ok
        (not (compiler-backend-string-contains? safe-rebased "(%rbp)"))
        (compiler-backend-string-contains? safe-rebased "    popq %rbp\n")
        unsafe-rejected)]
    [_linux : unit (compiler-backend-set-current-fn-linux!)]
    ok))

(define (compiler-backend-win64-xmm-callee-save-homes-ok?) : bool
  (let
    [_win : unit (compiler-backend-set-current-fn-win64!)]
    [sparse : CompilerRegAssignmentList
      (compiler-backend-win64-xmm-sparse-assignments)]
    [full : CompilerRegAssignmentList
      (compiler-backend-win64-xmm-full-assignments)]
    [xmm15 : CompilerRegAssignmentList
      (compiler-backend-win64-xmm15-only-assignments)]
    [planned : CompilerRegAssignmentList
      (compiler-reg-plan-assignments
        (compiler-reg-plan-function-scalar-for-abi
          CompilerRegTargetAbi.Windows
          (compiler-reg-f64-call-live-function)))]
    [planned-frame : i64
      (compiler-backend-frame-size (compiler-backend-frame-slots 3 planned))]
    [planned-save : String
      (compiler-backend-emit-save-win64-xmm-callee-regs
        (CompilerBackendTarget.Windows)
        planned
        3
        planned-frame)]
    [frame : i64
      (compiler-backend-frame-size (compiler-backend-frame-slots 3 sparse))]
    [save : String
      (compiler-backend-emit-save-win64-xmm-callee-regs
        (CompilerBackendTarget.Windows)
        sparse
        3
        frame)]
    [restore : String (compiler-backend-emit-restore-callee-regs sparse 3)]
    [entry : String
      (compiler-backend-emit-function-entry
        (CompilerBackendTarget.Windows)
        "_tl_xmm_sparse"
        frame
        sparse
        3)]
    [large-frame : i64
      (compiler-backend-frame-size (compiler-backend-frame-slots 600 xmm15))]
    [large-entry : String
      (compiler-backend-emit-function-entry
        (CompilerBackendTarget.Windows)
        "_tl_xmm_large"
        large-frame
        xmm15
        600)]
    [full-frame : i64
      (compiler-backend-frame-size (compiler-backend-frame-slots 1 full))]
    [full-save : String
      (compiler-backend-emit-save-win64-xmm-callee-regs
        (CompilerBackendTarget.Windows)
        full
        1
        full-frame)]
    [full-restore : String
      (compiler-backend-emit-restore-win64-xmm-callee-regs full 1)]
    [empty-entry : String
      (compiler-backend-emit-function-entry
        (CompilerBackendTarget.Windows)
        "_tl_xmm_empty"
        32
        CompilerRegAssignmentList.Nil
        3)]
    [inline-tail : String (compiler-backend-inline-return-tail sparse 3)]
    [jump-tail : String
      (compiler-backend-tail-jump-tail sparse 3 "_tl_xmm_target")]
    [shared-tail : String
      (compiler-backend-return-epilogue
        (ci.intern "xmm_shared")
        sparse
        3
        (compiler-backend-callee-save-double-return-blocks))]
    [ok : bool
      (and
        (compiler-reg-location-register?
          (compiler-reg-assignment-lookup planned 0)
          "%xmm6")
        (compiler-backend-string-contains? planned-save "    movdqu %xmm6, ")
        (not (compiler-backend-string-contains? planned-save "%xmm7"))
        (compiler-backend-plan-uses-callee-regs? sparse)
        (= frame 240)
        (= (compiler-backend-frame-slots 3 sparse) 30)
        (= (compiler-backend-frame-slots-with-groups 3 sparse true) 36)
        (= (compiler-backend-frame-slots-emergency-max 3 true) 38)
        (= (compiler-backend-win64-xmm-callee-slot-offset sparse 3 0) -96)
        (= (compiler-backend-win64-xmm-callee-slot-offset sparse 3 9) -240)
        (= (compiler-backend-group-word0-slot 0 3 sparse) -256)
        (= (compiler-backend-group-word1-slot 0 3 sparse) -248)
        (string.eq
          save
          "    movdqu %xmm6, -96(%rbp)\n    .seh_savexmm %xmm6, 144\n    movdqu %xmm15, -240(%rbp)\n    .seh_savexmm %xmm15, 0\n")
        (string.eq
          restore
          "    movdqu -240(%rbp), %xmm15\n    movdqu -96(%rbp), %xmm6\n    movq -32(%rbp), %r12\n")
        (compiler-backend-string-contains? entry "    subq $240, %rsp\n")
        (compiler-backend-string-contains? entry save)
        (compiler-backend-string-contains?
          entry
          "    .seh_savexmm %xmm15, 0\n    .seh_endprologue\n")
        (= full-frame 224)
        (= (compiler-backend-string-count full-save "    movdqu %xmm") 10)
        (= (compiler-backend-string-count full-save "    .seh_savexmm %xmm") 10)
        (= (compiler-backend-string-count full-restore "    movdqu ") 10)
        (= (compiler-backend-frame-slots 3 CompilerRegAssignmentList.Nil) 3)
        (not (compiler-backend-string-contains? empty-entry "movdqu"))
        (not (compiler-backend-string-contains? empty-entry ".seh_savexmm"))
        (= large-frame 5024)
        (compiler-backend-string-contains? large-entry "    callq __chkstk\n")
        (compiler-backend-string-contains?
          large-entry
          "    movdqu %xmm15, -5024(%rbp)\n    .seh_savexmm %xmm15, 0\n")
        (=
          (compiler-backend-string-count
            inline-tail
            "movdqu -240(%rbp), %xmm15")
          1)
        (compiler-backend-string-contains? inline-tail "    leave\n    ret\n")
        (=
          (compiler-backend-string-count jump-tail "movdqu -240(%rbp), %xmm15")
          1)
        (compiler-backend-string-contains?
          jump-tail
          "    leave\n    jmp _tl_xmm_target\n")
        (=
          (compiler-backend-string-count
            shared-tail
            "movdqu -240(%rbp), %xmm15")
          1)
        (compiler-backend-string-contains?
          shared-tail
          ".L_tl_xmm_shared_return:"))]
    [_linux : unit (compiler-backend-set-current-fn-linux!)]
    (and
      ok
      (= (compiler-backend-win64-xmm-callee-highest sparse) -1)
      (= (compiler-backend-frame-slots 3 sparse) 7)
      (string.eq
        (compiler-backend-emit-save-win64-xmm-callee-regs
          (CompilerBackendTarget.Linux)
          sparse
          3
          64)
        "")
      (string.eq
        (compiler-backend-emit-restore-callee-regs sparse 3)
        "    movq -32(%rbp), %r12\n"))))

(define (compiler-backend-peephole-register-moves-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-backend-peephole-assignments)]
    [coalesced : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            2
            (CompilerRegLocation.Register "%r12"))
          CompilerRegAssignmentList.Nil))]
    [casted : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            2
            (CompilerRegLocation.Register "%r13"))
          CompilerRegAssignmentList.Nil))]
    (and
      (string.eq
        (compiler-backend-emit-load-var-with-plan assignments 0 "%r12")
        "")
      (string.eq
        (compiler-backend-emit-store-var-with-plan assignments 0 "%r12")
        "")
      (string.eq
        (compiler-backend-emit-load-f64-var-with-plan assignments 1 "%xmm0")
        "    movsd %xmm2, %xmm0\n")
      (string.eq
        (compiler-backend-emit-store-f64-var-with-plan assignments 1 "%xmm0")
        "    movsd %xmm0, %xmm2\n")
      (match (compiler-backend-emit-mov
        coalesced
        2
        (CompilerIrValue.Var 0)
        (AstType.I64)
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)
        8
        "")
        [(ResultCompilerBackend.Ok asm) (string.eq asm "")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-cast
        "_tl_test"
        "entry"
        coalesced
        2
        (CompilerIrValue.Var 0)
        (AstType.I64)
        (AstType.I64)
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)
        ""
        ""
        "")
        [(ResultCompilerBackend.Ok asm) (string.eq asm "")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-cast
        "_tl_test"
        "entry"
        casted
        2
        (CompilerIrValue.Var 0)
        (AstType.I64)
        (AstType.U64)
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)
        ""
        ""
        "")
        [(ResultCompilerBackend.Ok asm) (string.eq asm "    movq %r12, %r13\n")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-cast
        "_tl_test"
        "entry"
        casted
        2
        (CompilerIrValue.Var 0)
        (AstType.I32)
        (AstType.I64)
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)
        ""
        ""
        "")
        [(ResultCompilerBackend.Ok asm)
          (and
            (string.eq asm "    movslq %r12d, %r13\n")
            (not (compiler-backend-string-contains? asm "%rax")))]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-direct-immediate-mov-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        CompilerRegAssignmentList.Nil)]
    [index : CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil)]
    (and
      (match (compiler-backend-emit-mov
        assignments
        0
        (CompilerIrValue.I64 0)
        (AstType.I64)
        index
        8
        "")
        [(ResultCompilerBackend.Ok asm)
          (string.eq asm "    xorl %r12d, %r12d\n")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-mov
        CompilerRegAssignmentList.Nil
        1
        (CompilerIrValue.I64 7)
        (AstType.I64)
        index
        8
        "")
        [(ResultCompilerBackend.Ok asm)
          (string.eq asm "    movq $7, -16(%rbp)\n")]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-mov-scratch-staging-ok?) : bool
  (let
    [index : CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil)]
    [int-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        CompilerRegAssignmentList.Nil)]
    [float-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%xmm3"))
        CompilerRegAssignmentList.Nil)]
    (and
      (match (compiler-backend-emit-mov
        int-assignments
        1
        (CompilerIrValue.Var 0)
        (AstType.I64)
        index
        2
        "")
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains? asm "    movq %r12, %r8\n")
            (compiler-backend-string-contains? asm "    movq %r8, -16(%rbp)\n")
            (not (compiler-backend-string-contains? asm "%rax")))]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-mov
        float-assignments
        1
        (CompilerIrValue.Var 0)
        (AstType.F64)
        index
        2
        "")
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains? asm "    movsd %xmm3, %xmm2\n")
            (compiler-backend-string-contains?
              asm
              "    movsd %xmm2, -16(%rbp)\n")
            (not (compiler-backend-string-contains? asm "%xmm0")))]
        [(ResultCompilerBackend.Err _) false]))))

