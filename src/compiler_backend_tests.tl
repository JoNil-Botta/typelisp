(define (compiler-backend-store-address-source-home-preserved-ok?) : bool
  (let
    [src-r9 : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r9))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [pair-assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          2
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r8))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [plain-ok : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.StorePtr
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          compiler_ir_types.CompilerIrInstrList.Nil)
        src-r9
        3)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (string.eq
            asm
            (cfg
              scratch-vreg
              "    movq -8(%rbp), %rax\n    movq %r9, (%rax)\n"
              "    movq -8(%rbp), %r10\n    movq %r9, (%r10)\n"))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [gep-ok : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Gep
            2
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.U64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.StorePtr
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            compiler_ir_types.CompilerIrInstrList.Nil))
        src-r9
        3)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (string.eq
            asm
            (cfg
              scratch-vreg
              "    movq -8(%rbp), %rax\n    movq %r9, 8(%rax)\n"
              "    movq -8(%rbp), %r10\n    movq %r9, 8(%r10)\n"))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    ;; The pair case leaves var 1 unassigned. The modeled plan gives the base and
    ;; spilled source independent homes, while var 2's %r8 home stays untouched.
    [pair-ok : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.StorePtr
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Gep
              3
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.U64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.StorePtr
                (compiler_ir_types.CompilerIrValue.Var 3)
                (compiler_ir_types.CompilerIrValue.Var 2)
                (compiler_ast_types.AstType.I64))
              compiler_ir_types.CompilerIrInstrList.Nil)))
        pair-assignments
        4)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              (cfg
                scratch-vreg
                "    movq -8(%rbp), %rdi\n"
                "    movq -8(%rbp), %r10\n"))
            (compiler_backend.compiler-backend-string-contains?
              asm
              (cfg
                scratch-vreg
                "    movq -16(%rbp), %rsi\n"
                "    movq -16(%rbp), "))
            (compiler_backend.compiler-backend-string-contains?
              asm
              (cfg
                scratch-vreg
                "    movq %r8, 8(%rdi)\n"
                "    movq %r8, 8(%r10)\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq -8(%rbp), %r8\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    (compiler_backend.backend-and4 plain-ok gep-ok pair-ok true)))

