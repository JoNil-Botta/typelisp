(define (compiler-backend-scratch-vreg-scalar-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [result : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_scalar_div"
          (compiler-backend-scratch-vreg-scalar-div-blocks)
          3
          (compiler-backend-scratch-vreg-scalar-assignments))]
      (match result
        [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
          (let
            [items : (Array compiler_regalloc.CompilerRegScratchAssignment)
              (struct-get plan items)]
            [rax : String
              (compiler_regalloc.compiler-reg-scratch-plan-register plan 0 0)]
            [rdx : String
              (compiler_regalloc.compiler-reg-scratch-plan-register plan 0 1)]
            [temp0 : String
              (compiler_regalloc.compiler-reg-scratch-plan-register plan 0 2)]
            [temp1 : String
              (compiler_regalloc.compiler-reg-scratch-plan-register plan 0 3)]
            [temp2 : String
              (compiler_regalloc.compiler-reg-scratch-plan-register plan 0 4)]
            (and
              (= (compiler_regalloc.compiler-reg-scratch-plan-count plan) 5)
              (string.eq rax "%rax")
              (string.eq rdx "%rdx")
              (not (string.eq temp0 ""))
              (not (string.eq temp1 ""))
              (not (string.eq temp2 ""))
              (not (string.eq temp0 temp1))
              (not (string.eq temp0 temp2))
              (not (string.eq temp1 temp2))
              (not (string.eq temp0 "%rax"))
              (not (string.eq temp0 "%rdx"))
              (not (string.eq temp0 "%r12"))
              (not (string.eq temp0 "%r13"))
              (match (struct-get
                (struct-get (array-ref items 0) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.FixedRax) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref items 1) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.FixedRdx) true]
                [_ false])
              (string.eq
                (struct-get
                  (struct-get
                    (struct-get (array-ref items 0) requirement)
                    constraint)
                  fixed)
                "%rax")
              (string.eq
                (struct-get
                  (struct-get
                    (struct-get (array-ref items 1) requirement)
                    constraint)
                  fixed)
                "%rdx")))]))
    true))

