(define (compiler-backend-direct-f64-neg-home-ok?) : bool
  (asm-ok?
    (be_scalar.compiler-backend-emit-unop
      (ast.ast-node-pool-reader-type-segment-bases)
      (reg-homes "%0=%xmm2 %1=%xmm3")
      1
      (Neg)
      (Var 0)
      (F64)
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has
      "    movsd %xmm2, %xmm3\n"
      "    xorpd .L_tl_f64_sign_bit(%rip), %xmm3\n")
    (lacks "%xmm0")))

(define (compiler-backend-spill-f64-neg-home-ok?) : bool
  (asm-ok?
    (be_scalar.compiler-backend-emit-unop
      (ast.ast-node-pool-reader-type-segment-bases)
      (reg-homes "%0=%xmm3 %1=spill:-16")
      1
      (Neg)
      (Var 0)
      (F64)
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has
      "    movsd %xmm3, %xmm2\n"
      "    xorpd .L_tl_f64_sign_bit(%rip), %xmm2\n"
      "    movsd %xmm2, -16(%rbp)\n")
    (lacks "%xmm0")))

(define (compiler-backend-float-sqrt-home-ok?) : bool
  (let
    [direct : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%xmm2 %1=%xmm3")]
    [spill : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%xmm3 %1=spill:-16")]
    (and
      (match (be_scalar.compiler-backend-emit-unop
        (ast.ast-node-pool-reader-type-segment-bases)
        direct
        1
        (Sqrt)
        (Var 0)
        (F64)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm)
          (string.eq asm "    movsd %xmm2, %xmm3\n    sqrtsd %xmm3, %xmm3\n")]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-unop
        (ast.ast-node-pool-reader-type-segment-bases)
        direct
        1
        (Sqrt)
        (Var 0)
        (F32)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm)
          (string.eq asm "    movss %xmm2, %xmm3\n    sqrtss %xmm3, %xmm3\n")]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-unop
        (ast.ast-node-pool-reader-type-segment-bases)
        spill
        1
        (Sqrt)
        (Var 0)
        (F64)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm)
          (string.eq
            asm
            "    movsd %xmm3, %xmm2\n    sqrtsd %xmm2, %xmm2\n    movsd %xmm2, -16(%rbp)\n")]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-unop
        (ast.ast-node-pool-reader-type-segment-bases)
        spill
        1
        (Sqrt)
        (Var 0)
        (F32)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm)
          (string.eq
            asm
            "    movss %xmm3, %xmm2\n    sqrtss %xmm2, %xmm2\n    movss %xmm2, -16(%rbp)\n")]
        [(Err _) false]))))

(define (compiler-backend-float-sqrt-source) : String
  "(define (sqrt64 [value : f64]) : f64 (__tl_float_sqrt value))
(define (sqrt32 [value : f32]) : f32 (__tl_float_sqrt value))
(define (main) : i64
  (if (= (sqrt64 4.0) 2.0)
    (if (= (sqrt32 (cast 9.0 : f32)) (cast 3.0 : f32)) 0 1)
    1))")

(define (compiler-backend-float-sqrt-source-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (asm-ok?
    (backend.compiler-backend-emit-source-for-target
      (compiler-backend-float-sqrt-source)
      target)
    (has "    sqrtsd " "    sqrtss ")
    (lacks "__tl_float_sqrt")))

(define (compiler-backend-float-sqrt-source-ok?) : bool
  (and
    (compiler-backend-float-sqrt-source-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-float-sqrt-source-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-float-bitcast-source) : String
  "(define (f64-bits [value : f64]) : u64 (__tl_float_to_bits value))
(define (f32-bits [value : f32]) : u32 (__tl_float_to_bits value))
(define (f64-from [bits : u64]) : f64 (__tl_float_from_bits bits))
(define (f32-from [bits : u32]) : f32 (__tl_float_from_bits bits))
(define (main) : i64
  (if (= (f64-bits (f64-from (cast 0x3ff0000000000000 : u64)))
         (cast 0x3ff0000000000000 : u64))
    (if (= (f32-bits (f32-from (cast 0x3f800000 : u32)))
           (cast 0x3f800000 : u32))
      42
      1)
    1))")

(define (compiler-backend-float-bitcast-source-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (asm-ok?
    (backend.compiler-backend-emit-source-for-target
      (compiler-backend-float-bitcast-source)
      target)
    (has "    movq " "    movd ")
    (lacks "__tl_float_to_bits" "__tl_float_from_bits" "tl_alloc")))

(define (compiler-backend-float-bitcast-source-ok?) : bool
  (and
    (compiler-backend-float-bitcast-source-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-float-bitcast-source-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-literal-float-to-bits-source) : String
  "(module stdlib.math)
(define (f64-to-bits [value : f64]) : u64 (__tl_float_to_bits value))
(define (f32-to-bits [value : f32]) : u32 (__tl_float_to_bits value))
(defstruct FloatBitsRow
  (tail-bits u64)
  (head-bits u64)
  (scale-bits u32)
  (offset-bits u32))
(define (float-bits-row [index : i64]) : FloatBitsRow
  (if (= index 0)
    (FloatBitsRow
      (stdlib.math.f64-to-bits 0.1)
      (stdlib.math.f64-to-bits 0.)
      (stdlib.math.f32-to-bits -0.0)
      (stdlib.math.f32-to-bits
        0.000000000000000000000000000000000000000000001))
    (FloatBitsRow
      (stdlib.math.f64-to-bits -0.1)
      (stdlib.math.f64-to-bits -0.)
      (stdlib.math.f32-to-bits 0.1)
      (stdlib.math.f32-to-bits
        -0.000000000000000000000000000000000000000000001))))
(define (main) : i64
  (let
    [first : FloatBitsRow (float-bits-row 0)]
    [second : FloatBitsRow (float-bits-row 1)]
    (if (= first.tail-bits 0x3fb999999999999a)
      (if (= first.head-bits 0x0000000000000001)
        (if (= first.scale-bits 0x80000000)
          (if (= first.offset-bits 0x00000001)
            (if (= second.tail-bits 0xbfb999999999999a)
              (if (= second.head-bits 0x8000000000000001)
                (if (= second.scale-bits 0x3dcccccd)
                  (if (= second.offset-bits 0x80000001) 42 1)
                  1)
                1)
              1)
            1)
          1)
        1)
      1)))")

(define (compiler-backend-integer-float-bits-source) : String
  "(module stdlib.math)
(define (f64-to-bits [value : f64]) : u64 (__tl_float_to_bits value))
(define (f32-to-bits [value : f32]) : u32 (__tl_float_to_bits value))
(defstruct FloatBitsRow
  (tail-bits u64)
  (head-bits u64)
  (scale-bits u32)
  (offset-bits u32))
(define (float-bits-row [index : i64]) : FloatBitsRow
  (if (= index 0)
    (FloatBitsRow
      0x3fb999999999999a
      0x0000000000000001
      0x80000000
      0x00000001)
    (FloatBitsRow
      0xbfb999999999999a
      0x8000000000000001
      0x3dcccccd
      0x80000001)))
(define (main) : i64
  (let
    [first : FloatBitsRow (float-bits-row 0)]
    [second : FloatBitsRow (float-bits-row 1)]
    (if (= first.tail-bits 0x3fb999999999999a)
      (if (= first.head-bits 0x0000000000000001)
        (if (= first.scale-bits 0x80000000)
          (if (= first.offset-bits 0x00000001)
            (if (= second.tail-bits 0xbfb999999999999a)
              (if (= second.head-bits 0x8000000000000001)
                (if (= second.scale-bits 0x3dcccccd)
                  (if (= second.offset-bits 0x80000001) 42 1)
                  1)
                1)
              1)
            1)
          1)
        1)
      1)))")

(define (compiler-backend-literal-float-to-bits-asm-ok?
  [literal : be_state.ResultCompilerBackend]
  [integer : be_state.ResultCompilerBackend]) : bool
  (match literal
    [(Ok literal-asm)
      (match integer
        [(Ok integer-asm)
          (and
            (string.eq literal-asm integer-asm)
            (asm-lacks? literal-asm ".L_tl_f64_" ".L_tl_f32_"))]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-literal-float-to-bits-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (and
    (compiler-backend-literal-float-to-bits-asm-ok?
      (compiler-backend-emit-library-source-for-target
        (compiler-backend-literal-float-to-bits-source)
        target)
      (compiler-backend-emit-library-source-for-target
        (compiler-backend-integer-float-bits-source)
        target))
    (compiler-backend-literal-float-to-bits-asm-ok?
      (compiler-backend-emit-source-opt2-for-target-and-entry
        (compiler-backend-literal-float-to-bits-source)
        target
        false)
      (compiler-backend-emit-source-opt2-for-target-and-entry
        (compiler-backend-integer-float-bits-source)
        target
        false))))

(define (compiler-backend-literal-float-to-bits-ok?) : bool
  (and
    (compiler-backend-literal-float-to-bits-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-literal-float-to-bits-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-f32-literal-binop-source) : String
  "(define (main) : i64
  (let
    [b : f32 12.0]
    [x : i64 (if (< 11.0 b) 1 0)]
    [y : i64 (if (< b 13.0) 2 0)]
    [z : i64 (if (< (+ 1.0 b) 13.5) 4 0)]
    (+ x (+ y z))))")

(define (compiler-backend-f32-literal-binop-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-f32-literal-binop-source))
    [(Ok asm)
      (and
        (let
          [needle
            (be_data.compiler-backend-float-bits-directive
              (F32)
              (compiler-backend-test-f32-bits "11.0"))]
          (asm-has? asm needle))
        (asm-lacks? asm "    .float ")
        ;; FPO red-zone frame slot: lifetime coloring compacts b:f32 from its
        ;; old positive 176(%rsp) identity slot to -64; literal temporaries
        ;; independently reuse -8.
        (asm-has? asm "    ucomiss -64(%rsp), %xmm2\n    jbe .L")
        (asm-has? asm "    addss -64(%rsp), %xmm2\n")
        (asm-lacks? asm "    setb ")
        (asm-lacks? asm "    ucomiss %xmm1, %xmm0\n")
        (asm-lacks? asm "    addss %xmm1, %xmm0\n")
        (asm-lacks? asm "    cvtsd2ss ")
        (asm-lacks? asm "    ucomisd"))]
    [(Err _) false]))

(define (compiler-backend-direct-float-binop-asm
  [op : ir.CompilerIrBinOp]
  [ty : ast.AstType]) : be_state.ResultCompilerBackend
  (be_scalar.compiler-backend-emit-binop
    (ast.ast-node-pool-reader-type-segment-bases)
    (regalloc.compiler-reg-var-types-insert
      (regalloc.compiler-reg-var-types-insert
        (regalloc.compiler-reg-var-types-insert
          (regalloc.compiler-reg-var-types-empty)
          2
          (owned_view.compiler-owned-shared-view ty))
        1
        (owned_view.compiler-owned-shared-view ty))
      0
      (owned_view.compiler-owned-shared-view ty))
    (Empty)
    (reg-homes "%0=%xmm2 %1=%xmm3 %2=%xmm4")
    2
    op
    (Var 0)
    (Var 1)
    ty
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active))))

(define (compiler-backend-direct-float-arith-home-ok?) : bool
  (match (compiler-backend-direct-float-binop-asm (Add) (F64))
    [(Ok f64-asm)
      (match (compiler-backend-direct-float-binop-asm (Add) (F32))
        [(Ok f32-asm)
          (and
            (be_state.backend-and4
              (asm-has? f64-asm "    movapd %xmm2, %xmm4\n")
              (asm-has? f64-asm "    addsd %xmm3, %xmm4\n")
              (asm-has? f32-asm "    movaps %xmm2, %xmm4\n")
              (asm-has? f32-asm "    addss %xmm3, %xmm4\n"))
            (asm-lacks? f64-asm "%xmm0" "%xmm1")
            (asm-lacks? f32-asm "%xmm0" "%xmm1"))]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-spill-float-arith-asm
  [ty : ast.AstType]
  [occupied : i64]) : be_state.ResultCompilerBackend
  (let
    [state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (set-scratch-scavenge-ctx-occupied-masks!
      (be_state.compiler-backend-state-function-state state)
      (__tl_make-array 0 occupied))
    (set-state-emit-instr-post-base! state 1)
    (set-state-emit-current-count! state 0)
    (be_scalar.compiler-backend-emit-binop
      (ast.ast-node-pool-reader-type-segment-bases)
      (regalloc.compiler-reg-var-types-insert
        (regalloc.compiler-reg-var-types-insert
          (regalloc.compiler-reg-var-types-insert
            (regalloc.compiler-reg-var-types-empty)
            2
            (owned_view.compiler-owned-shared-view ty))
          1
          (owned_view.compiler-owned-shared-view ty))
        0
        (owned_view.compiler-owned-shared-view ty))
      (Empty)
      (reg-homes "%0=%xmm3 %1=%xmm4 %2=spill:-16")
      2
      (Add)
      (Var 0)
      (Var 1)
      ty
      state)))

(define (compiler-backend-spill-float-arith-home-ok?) : bool
  (match (compiler-backend-spill-float-arith-asm (F64) 0)
    [(Ok f64-asm)
      (match (compiler-backend-spill-float-arith-asm (F32) 0)
        [(Ok f32-asm)
          (and
            (be_state.backend-and4
              (asm-has? f64-asm "    movapd %xmm3, %xmm2\n")
              (asm-has? f64-asm "    addsd %xmm4, %xmm2\n")
              (asm-has? f32-asm "    movaps %xmm3, %xmm2\n")
              (asm-has? f32-asm "    addss %xmm4, %xmm2\n"))
            (asm-has? f64-asm "    movsd %xmm2, -16(%rbp)\n")
            (asm-has? f32-asm "    movss %xmm2, -16(%rbp)\n")
            (asm-lacks? f64-asm "%xmm0" "%xmm1")
            (asm-lacks? f32-asm "%xmm0" "%xmm1"))]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-pressured-float-arith-home-ok?) : bool
  (let
    [homes
      (__tl_make-array
        "%xmm0"
        "%xmm1"
        "%xmm2"
        "%xmm3"
        "%xmm4"
        "%xmm5"
        "%xmm6"
        "%xmm7"
        "%xmm8"
        "%xmm9"
        "%xmm10")]
    [occupied : i64
      (be_operand.compiler-backend-scavenge-exclude-mask (& homes) 11)]
    (asm-ok?
      (compiler-backend-spill-float-arith-asm (F64) occupied)
      (has
        "    movapd %xmm3, %xmm11\n    addsd %xmm4, %xmm11\n"
        "    movsd %xmm11, -16(%rbp)\n"))))

;; Exact whole sequences prove PF handling and absence of unplanned clobbers.
(define (compiler-backend-float-unordered-sequence-ok?
  [op : ir.CompilerIrBinOp]
  [tail : String]) : bool
  (and
    (string.eq
      (be_scalar.compiler-backend-float-compare-reg-asm
        (owned_view.compiler-owned-shared-view op)
        (F64)
        "%xmm2"
        "%xmm3"
        "%r12")
      (str_cat.str-cat "    ucomisd %xmm3, %xmm2\n" tail))
    (string.eq
      (be_scalar.compiler-backend-float-compare-reg-asm
        op
        (F32)
        "%xmm2"
        "-24(%rbp)"
        "%r12")
      (str_cat.str-cat "    ucomiss -24(%rbp), %xmm2\n" tail))))

(define (compiler-backend-float-unordered-sequences-ok?) : bool
  (and
    (compiler-backend-float-unordered-sequence-ok?
      (Eq)
      "    movl $0, %r12d\n    jp 1f\n    sete %r12b\n1:\n")
    (compiler-backend-float-unordered-sequence-ok?
      (Ne)
      "    movl $1, %r12d\n    jp 1f\n    setne %r12b\n1:\n")
    (compiler-backend-float-unordered-sequence-ok?
      (Lt)
      "    movl $0, %r12d\n    jp 1f\n    setb %r12b\n1:\n")
    (compiler-backend-float-unordered-sequence-ok?
      (Le)
      "    movl $0, %r12d\n    jp 1f\n    setbe %r12b\n1:\n")
    (compiler-backend-float-unordered-sequence-ok?
      (Gt)
      "    seta %r12b\n    movzbl %r12b, %r12d\n")
    (compiler-backend-float-unordered-sequence-ok?
      (Ge)
      "    setae %r12b\n    movzbl %r12b, %r12d\n")))

(define (compiler-backend-direct-float-compare-asm [ty : ast.AstType]) : be_state.ResultCompilerBackend
  (be_scalar.compiler-backend-emit-binop
    (ast.ast-node-pool-reader-type-segment-bases)
    (regalloc.compiler-reg-var-types-insert
      (regalloc.compiler-reg-var-types-insert
        (regalloc.compiler-reg-var-types-insert
          (regalloc.compiler-reg-var-types-empty)
          2
          (Bool))
        1
        (owned_view.compiler-owned-shared-view ty))
      0
      ty)
    (Empty)
    (reg-homes "%0=%xmm2 %1=%xmm3 %2=%r12")
    2
    (Lt)
    (Var 0)
    (Var 1)
    (Bool)
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active))))

(define (compiler-backend-direct-float-compare-home-ok?) : bool
  (match (compiler-backend-direct-float-compare-asm (F64))
    [(Ok f64-asm)
      (match (compiler-backend-direct-float-compare-asm (F32))
        [(Ok f32-asm)
          (and
            (be_state.backend-and8
              (asm-has? f64-asm "    ucomisd %xmm3, %xmm2\n")
              (asm-has? f64-asm "    setb %r12b\n")
              (asm-has?
                f64-asm
                "    movl $0, %r12d\n    jp 1f\n    setb %r12b\n1:\n")
              (asm-has? f32-asm "    ucomiss %xmm3, %xmm2\n")
              (asm-has? f32-asm "    setb %r12b\n")
              (asm-has?
                f32-asm
                "    movl $0, %r12d\n    jp 1f\n    setb %r12b\n1:\n")
              (asm-lacks? f64-asm "%rax")
              (asm-lacks? f32-asm "%rax"))
            (asm-lacks? f64-asm "%xmm0" "%xmm1")
            (asm-lacks? f32-asm "%xmm0" "%xmm1"))]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-spill-float-compare-asm [ty : ast.AstType]) : be_state.ResultCompilerBackend
