(define (compiler-backend-c-abi-sysv-two-register-return-source) : String
  "(defstruct PairI64 (:repr c) (lo i64) (hi i64))
(defstruct MixIF (:repr c) (tag u64) (value f64))
(defstruct PairF64 (:repr c) (x f64) (y f64))
