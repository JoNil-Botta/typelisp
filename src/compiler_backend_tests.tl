;; Backend-owned replacement for the Rust `string.string-ref` emit-shape checks:
;; source-level string indexing should keep literal string data, use an
;; unsigned bounds check, call the out-of-bounds helper, and zero-extend the
;; selected byte into the char result.
(define (compiler-backend-string-ref-source) : String
  "(define sample : String \"az\")
(define (pick [i : i64]) : char (__tl_string_ref sample i))
(define (main) : i64 0)")

(define (compiler-backend-string-ref-shape-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-string-ref-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_str_data_l2_12961_16211:")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_str_l2_12961_16211:")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .string \"az\"\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad .L_tl_str_data_l2_12961_16211\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    cmpq %r11, %rax\n"))
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    jb .Lf0_str_bounds_ok")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_oob_abort")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "tl_oob_abort:\n")))
        (compiler_backend.backend-and4
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 8(%r10), %r8\n")
          (compiler_backend.compiler-backend-string-contains? asm "(%r10)")
          (compiler_backend.compiler-backend-string-contains? asm "movzbq")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "movsbq (%r10)")))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 8(%r10), %rax\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    jl .Lf0_str_bounds_ok"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

