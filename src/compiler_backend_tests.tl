        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-emergency-restore-suppressed : bool
      (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-restore-suppressed
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "entry")
          instrs)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [instr-count : i64 (compiler_ir_types.compiler-ir-instr-list-count instrs)]
    [scratch-result : compiler_regalloc.CompilerRegScratchPlanResult
      (compiler-backend-scratch-test-result-for-abi
        (compiler_backend.compiler-backend-target-abi target)
        "test_instr_sequence_emission"
        blocks
        vars
        assignments)]
    [scratch : compiler_regalloc.CompilerRegScratchPlan
      (match scratch-result
        [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan) plan])]
    [runtime-plan : compiler_backend.CompilerBackendRuntimePlan
      (cfg
        scratch-vreg
        (compiler_backend.CompilerBackendRuntimePlan.WithScratch
          (box (compiler-backend-runtime-helper-full-plan))
          scratch)
        (compiler-backend-runtime-helper-full-plan))]
    [_scratch-position : unit
      (begin
        (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-starts
          prev-ends
          prev-assignment-index
          (bit-or
            (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-plan-reg-mask
              (compiler_backend.compiler-backend-state-function-state
                backend-state))
            (compiler_regalloc.compiler-reg-scratch-plan-register-mask scratch))
          prev-occupied-masks
          prev-vars)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          backend-state
          instr-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          backend-state
          instr-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-site!
          backend-state
          0))]
    [use-counts : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-use-counts vars blocks)]
    [test-id : i64 (ci.intern "test")]
    [_addr-forward : unit
      (compiler_backend.compiler-backend-addr-of-forwarding-enable!
        backend-state
        vars
        blocks
        use-counts)]
    (match (compiler-backend-test-emit-instrs-text
      (compiler_backend.CompilerBackendEmissionContext
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        target
        "_tl_test"
        test-id
        blocks
        (compiler_ir_types.compiler-ir-label "entry")
        assignments
        vars
        (compiler_regalloc.compiler-reg-var-types-empty)
        (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
        (compiler_ast_types.AstType.I64)
        runtime-plan
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil
        program-index
        (compiler_ir_types.compiler-source-spans-empty)
        (compiler_backend.compiler-backend-source-span-index-build-with-backend-state
          backend-state
          (compiler_ir_types.compiler-source-spans-empty))
        (compiler_diagnostic.compiler-diagnostic-at-start "" "")
        use-counts
        backend-state
        (compiler_backend.compiler-backend-state-function-state backend-state))
      (compiler_backend.CompilerBackendMaybeLabel.No)
      instrs)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (let
          [_restore : unit
            (begin
              (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-starts
                prev-ends
                prev-assignment-index
                prev-plan-mask
                prev-occupied-masks
                prev-vars)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
                backend-state
                prev-post-base)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
                backend-state
                prev-current-count)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-site!
                backend-state
                prev-current-site)
              (compiler_backend.compiler-backend-test-set-compiler-backend-addr-of-forwarding-enabled!
                backend-state
                prev-addr-forward-enabled)
              (compiler_backend.compiler-backend-test-set-compiler-backend-addr-of-forwarding-src!
                backend-state
                prev-addr-forward-src)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-need-ready!
                backend-state
                prev-fuse-ready)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-use-counts!
                backend-state
                prev-fuse-use-counts)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-free-counts!
                backend-state
                prev-fuse-free-counts)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instrs-loop-active!
                backend-state
                prev-loop-active)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instrs-continue-pending!
                backend-state
                prev-continue-pending)
              (compiler_backend.compiler-backend-test-set-compiler-backend-identity-tail-forwarder-active!
                backend-state
                prev-identity-tail)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-pending)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-reg!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-reg)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-used)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending-count!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-pending-count)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used-count!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-used-count)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-slot-offset)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-used-count!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-cycle-temp-used-count)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-base-offset!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-cycle-temp-base-offset)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-restore-suppressed!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-restore-suppressed))]
          (compiler_backend.ResultCompilerBackend.Ok asm))]
      [(compiler_backend.ResultCompilerBackend.Err message)
        (let
          [_restore : unit
            (begin
              (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-starts
                prev-ends
                prev-assignment-index
                prev-plan-mask
                prev-occupied-masks
                prev-vars)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
                backend-state
                prev-post-base)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
                backend-state
                prev-current-count)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-site!
                backend-state
                prev-current-site)
              (compiler_backend.compiler-backend-test-set-compiler-backend-addr-of-forwarding-enabled!
                backend-state
                prev-addr-forward-enabled)
              (compiler_backend.compiler-backend-test-set-compiler-backend-addr-of-forwarding-src!
                backend-state
                prev-addr-forward-src)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-need-ready!
                backend-state
                prev-fuse-ready)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-use-counts!
                backend-state
                prev-fuse-use-counts)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-free-counts!
                backend-state
                prev-fuse-free-counts)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instrs-loop-active!
                backend-state
                prev-loop-active)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instrs-continue-pending!
                backend-state
                prev-continue-pending)
              (compiler_backend.compiler-backend-test-set-compiler-backend-identity-tail-forwarder-active!
                backend-state
                prev-identity-tail)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-pending)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-reg!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-reg)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-used)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending-count!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-pending-count)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used-count!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-used-count)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-slot-offset)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-used-count!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-cycle-temp-used-count)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-cycle-temp-base-offset!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-cycle-temp-base-offset)
              (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-restore-suppressed!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-emergency-restore-suppressed))]
          (compiler_backend.ResultCompilerBackend.Err message))])))

(define (compiler-backend-runtime-helper-full-plan) : compiler_backend.CompilerBackendRuntimePlan
  (compiler_backend.CompilerBackendRuntimePlan.Plan
    true
    true
    true
    true
    true
    true
    true
    (compiler_backend.CompilerBackendRuntimeTailPlan true true false true)))

;; Test fixtures start from readable spellings, then exercise only the backend's
;; ID-native runtime inventory. Production never performs this conversion.
(define (compiler-backend-test-runtime-name-id [name : String]) : i64
  (ci.intern name))

(define (compiler-backend-test-runtime-helper-owner [name : String]) : compiler_backend.CompilerBackendRuntimeHelperOwner
  (cond
    [(string.eq name "tl_memcpy")
      (compiler_backend.CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "tl_memcpy_fresh")
      (compiler_backend.CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "tl_memchr")
      (compiler_backend.CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "tl_tlci_call_image_entry")
      (compiler_backend.CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "tl_tlci_call_macro_entry")
      (compiler_backend.CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "__chkstk")
      (compiler_backend.CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "tl_setup_argv")
      (compiler_backend.CompilerBackendRuntimeHelperOwner.Core)]
    [(string.eq name "_tl_start")
      (compiler_backend.CompilerBackendRuntimeHelperOwner.Core)]
    [else
      (compiler_backend.compiler-backend-runtime-helper-owner-id
        (compiler-backend-test-runtime-name-id name))]))

(define (compiler-backend-test-runtime-helper-known? [name : String]) : bool
  (match (compiler-backend-test-runtime-helper-owner name)
    [(compiler_backend.CompilerBackendRuntimeHelperOwner.Unknown) false]
    [_ true]))

(define (compiler-backend-test-plan-provides?
  [plan : compiler_backend.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (if (string.eq name "tl_tlci_call_macro_entry")
    (compiler_backend.compiler-backend-runtime-tail-tlci-macro-entry?
      (compiler_backend.compiler-backend-runtime-plan-tail plan))
    (compiler_backend.compiler-backend-plan-provides-id?
      plan
      (compiler-backend-test-runtime-name-id name))))

(define (compiler-backend-runtime-helper-inventory-symbol-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-test-runtime-helper-known? name)
    (compiler-backend-test-plan-provides? plan name)))

(define (compiler-backend-runtime-helper-owner-core-ok? [name : String]) : bool
  (match (compiler-backend-test-runtime-helper-owner name)
    [(compiler_backend.CompilerBackendRuntimeHelperOwner.Core) true]
    [_ false]))

(define (compiler-backend-runtime-helper-inventory-core-symbol-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-symbol-ok? plan name)
    (compiler-backend-runtime-helper-owner-core-ok? name)))

(define (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-symbol-ok? plan name)
    (match (compiler-backend-test-runtime-helper-owner name)
      [(compiler_backend.CompilerBackendRuntimeHelperOwner.StdlibFfi) true]
      [_ false])))

(define (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-symbol-ok? plan name)
    (match (compiler-backend-test-runtime-helper-owner name)
      [(compiler_backend.CompilerBackendRuntimeHelperOwner.StdlibTypeLisp) true]
      [_ false])))

(define (compiler-backend-runtime-helper-inventory-core-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]) : bool
  (and
    (compiler_backend.backend-and8
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_alloc")
      (not (compiler-backend-test-runtime-helper-known? "tl_oob_abort"))
      (not (compiler-backend-test-runtime-helper-known? "tl_div_abort"))
      (not (compiler-backend-test-runtime-helper-known? "tl_shift_abort"))
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_abort")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_region_mark")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_region_reset")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_make"))
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_arena_make_small")
    (compiler_backend.backend-and4
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_current")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_set")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_destroy")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_make_atomic"))
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_arena_poison_enable")
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_thread_init")
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_thread_entry_ptr")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_memcpy")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_memcpy_fresh")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_memchr")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_tlci_call_image_entry")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_tlci_call_macro_entry")
    (compiler-backend-runtime-helper-owner-core-ok? "__chkstk")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_setup_argv")
    (compiler-backend-runtime-helper-owner-core-ok? "_tl_start")))

(define (compiler-backend-runtime-helper-inventory-stdlib-ffi-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]) : bool
  (compiler_backend.backend-and4
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_total")
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_live")
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_peak")
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_reset_peak")))

(define (compiler-backend-runtime-helper-inventory-stdlib-string-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_substring")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat3")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat4")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat5")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_int_to_string")))

(define (compiler-backend-runtime-helper-inventory-stdlib-atomic-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]) : bool
  (and
    (compiler_backend.backend-and8
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_load_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_store_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_add_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_fetch_add_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_cas_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i32_load_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i32_store_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i32_add_ptr"))
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_atomic_i32_fetch_add_ptr")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_atomic_i32_cas_ptr")))

(define (compiler-backend-runtime-helper-inventory-retired-string-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]) : bool
  (compiler_backend.backend-and4
    (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
      plan
      "tl_string_eq")
    (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
      plan
      "tl_string_to_int")
    (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
      plan
      "tl_hash_string")
    true))

(define (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (not (compiler-backend-test-runtime-helper-known? name))
    (not (compiler-backend-test-plan-provides? plan name))))

(define (compiler-backend-runtime-helper-inventory-retired-file-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]) : bool
  (and
    (compiler_backend.backend-and8
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_read_file")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_write_file")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_exists")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_read_file_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_write_file_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_append_file_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_exists_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_open_status"))
    (compiler_backend.backend-and8
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_close_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_read_chunk_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_write_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_flush_status")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_read_chunk_bytes")
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_file_read_chunk_eof")
      true
      true)))

(define (compiler-backend-runtime-helper-inventory-retired-process-ok?
  [plan : compiler_backend.CompilerBackendRuntimePlan]) : bool
  (compiler_backend.backend-and4
    (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
