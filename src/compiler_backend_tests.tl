(define (compiler-backend-descriptor-pair-spill-order-ok?) : bool
  (let
    [kind : CompilerIrDescriptorPairKind
      (CompilerIrDescriptorPairKind.OwnedString)]
    [ty : AstType (compiler-ir-descriptor-pair-handle-type kind)]
    [program : CompilerIrProgram (compiler-backend-descriptor-pair-program)]
    [index : CompilerBackendProgramIndex
      (match program
        [(CompilerIrProgram.Program _ functions externs)
          (compiler-backend-program-index-build functions externs)])]
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -8))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%r12"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.Register "%r13"))
            CompilerRegAssignmentList.Nil)))]
    [_group-enable : unit
      (begin
        (compiler-backend-current-slot-vars-set! 3)
        (compiler-backend-group-vars-enable!
          (compiler-live-set1 0)
          (compiler-live-set-empty)))]
    [packed : ResultCompilerBackend
      (compiler-backend-emit-pack
        assignments
        0
        (compiler-ir-value-cons
          (CompilerIrValue.I64 123)
          (compiler-ir-value-cons
            (CompilerIrValue.I64 42)
            CompilerIrValueList.Nil))
        ty
        3
        index
        ""
        ""
        (compiler-diagnostic-at-start "" ""))]
    [data : ResultCompilerBackend
      (compiler-backend-emit-word
        assignments
        1
        (CompilerIrValue.Var 0)
        0
        (AstType.U64)
        3
        ""
        (compiler-diagnostic-at-start "" ""))]
    [length : ResultCompilerBackend
      (compiler-backend-emit-word
        assignments
        2
        (CompilerIrValue.Var 0)
        1
        (AstType.I64)
        3
        ""
        (compiler-diagnostic-at-start "" ""))]
    [_group-disable : unit (compiler-backend-group-vars-disable!)]
    (and
      (match packed
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains? asm "$123, -8(%rbp)")
            (compiler-backend-string-contains? asm "$42, -16(%rbp)"))]
        [(ResultCompilerBackend.Err _) false])
      (match data
        [(ResultCompilerBackend.Ok asm)
          (compiler-backend-string-contains? asm "-8(%rbp), %r12")]
        [(ResultCompilerBackend.Err _) false])
      (match length
        [(ResultCompilerBackend.Ok asm)
          (compiler-backend-string-contains? asm "-16(%rbp), %r13")]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-descriptor-pair-register-order-ok?) : bool
  (let
    [kind : CompilerIrDescriptorPairKind
      (CompilerIrDescriptorPairKind.OwnedString)]
    [ty : AstType (compiler-ir-descriptor-pair-handle-type kind)]
    [program : CompilerIrProgram (compiler-backend-descriptor-pair-program)]
    [index : CompilerBackendProgramIndex
      (match program
        [(CompilerIrProgram.Program _ functions externs)
          (compiler-backend-program-index-build functions externs)])]
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.RegisterPair "%r12" "%r13"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%rbx"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.Register "%rsi"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                3
                (CompilerRegLocation.RegisterPair "%r14" "%r15"))
              CompilerRegAssignmentList.Nil))))]
    [_group-enable : unit
      (begin
        (compiler-backend-current-slot-vars-set! 4)
        (compiler-backend-group-vars-enable!
          (compiler-live-set-insert (compiler-live-set1 0) 3)
          (compiler-live-set-empty)))]
    [packed : ResultCompilerBackend
      (compiler-backend-emit-pack
        assignments
        0
        (compiler-ir-value-cons
          (CompilerIrValue.I64 123)
          (compiler-ir-value-cons
            (CompilerIrValue.I64 42)
            CompilerIrValueList.Nil))
        ty
        4
        index
        ""
        ""
        (compiler-diagnostic-at-start "" ""))]
    [data : ResultCompilerBackend
      (compiler-backend-emit-word
        assignments
        1
        (CompilerIrValue.Var 0)
        0
        (AstType.U64)
        4
        ""
        (compiler-diagnostic-at-start "" ""))]
    [length : ResultCompilerBackend
      (compiler-backend-emit-word
        assignments
        2
        (CompilerIrValue.Var 0)
        1
        (AstType.I64)
        4
        ""
        (compiler-diagnostic-at-start "" ""))]
    [copied : ResultCompilerBackend
      (compiler-backend-emit-mov
        assignments
        3
        (CompilerIrValue.Var 0)
        ty
        index
        4
        "")]
    [_group-disable : unit (compiler-backend-group-vars-disable!)]
    (and
      (match packed
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains? asm "$123, %r12")
            (compiler-backend-string-contains? asm "$42, %r13"))]
        [(ResultCompilerBackend.Err _) false])
      (match data
        [(ResultCompilerBackend.Ok asm)
          (compiler-backend-string-contains? asm "%r12, %rbx")]
        [(ResultCompilerBackend.Err _) false])
      (match length
        [(ResultCompilerBackend.Ok asm)
          (compiler-backend-string-contains? asm "%r13, %rsi")]
        [(ResultCompilerBackend.Err _) false])
      (match copied
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains? asm "%r12, %rax")
            (compiler-backend-string-contains? asm "%rax, %r14")
            (compiler-backend-string-contains? asm "%r13, %rdx")
            (compiler-backend-string-contains? asm "%rdx, %r15"))]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-descriptor-pair-object-main) : CompilerIrFunction
  (let
    [kind : CompilerIrDescriptorPairKind
      (CompilerIrDescriptorPairKind.OwnedString)]
    (CompilerIrFunction.Function
      (ci.intern "main")
      CompilerIrParamList.Nil
      (AstType.I64)
      4
      (compiler-ir-block-cons
        (compiler-ir-block
          "entry"
          (compiler-ir-instr-cons
            (ir-instr-descriptor-pair-pack
              0
              (CompilerIrValue.I64 123)
              (CompilerIrValue.I64 42)
              kind)
            (compiler-ir-instr-cons
              (CompilerIrInstr.Mov 1 (CompilerIrValue.Var 0) (AstType.String))
              (compiler-ir-instr-cons
                (ir-instr-descriptor-pair-data 2 (CompilerIrValue.Var 1))
                (compiler-ir-instr-cons
                  (ir-instr-descriptor-pair-length 3 (CompilerIrValue.Var 1))
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Return
                      (CompilerIrMaybeValue.Some (CompilerIrValue.Var 3)))
                    CompilerIrInstrList.Nil))))))
        CompilerIrBlockList.Nil))))

(define (compiler-backend-descriptor-pair-object-program) : CompilerIrProgram
  (CompilerIrProgram.Program
    CompilerIrGlobalList.Nil
    (compiler-ir-function-cons
      (compiler-backend-descriptor-pair-object-main)
      CompilerIrFunctionList.Nil)
    CompilerIrExternList.Nil))

(define (compiler-backend-descriptor-pair-object-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-program-object-image-target
    (compiler-backend-descriptor-pair-object-program)
    target
    (compiler-source-spans-empty)
    true)
    [(ResultCompilerBackendObject.Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList (struct-get image sections)]
        [renders : bool
          (match target
            [(CompilerBackendTarget.Linux)
              (match (elf.compiler-object-elf-render image)
                [(elf.ResultCompilerObjectElf.Ok _) true]
                [(elf.ResultCompilerObjectElf.Err _) false])]
            [(CompilerBackendTarget.Windows)
              (match (coff.compiler-object-coff-render image)
                [(coff.ResultCompilerObjectCoff.Ok _) true]
                [(coff.ResultCompilerObjectCoff.Err _) false])])]
        (and
          renders
          ;; Four scalar vars plus a four-slot word1 region.
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler-backend-object-prologue-bytes
              (compiler-backend-frame-size 8)))
          ;; Pack word1, copy it to the next pair, then extract it.
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler-backend-object-store-slot-bytes 4 "%rdx"))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler-backend-object-load-rbp-disp-bytes
              (compiler-backend-object-slot-disp 4)
              "%rdx"))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler-backend-object-store-slot-bytes 5 "%rdx"))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (compiler-backend-object-load-rbp-disp-bytes
              (compiler-backend-object-slot-disp 5)
              "%rax"))))]
    [(ResultCompilerBackendObject.Err _) false]))

(define (compiler-backend-descriptor-pair-target-ok?
  [target : CompilerBackendTarget]) : bool
  (let
    [program : CompilerIrProgram (compiler-backend-descriptor-pair-program)]
    [program-index : CompilerBackendProgramIndex
      (match program
        [(CompilerIrProgram.Program _ functions externs)
          (compiler-backend-program-index-build functions externs)])]
    (and
      ;; The materialized String still consumes one ordinary ABI slot.
      (= (compiler-backend-group-word-count program-index (AstType.String)) 1)
      (not (compiler-backend-group-type? program-index (AstType.String)))
      (match (compiler-backend-emit-program-for-target program target)
        [(ResultCompilerBackend.Ok asm)
          (compiler-backend-string-contains? asm "    call _tl_f1\n")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-program-object-image-target
        program
        target
        (compiler-source-spans-empty)
        true)
        [(ResultCompilerBackendObject.Ok _) true]
        [(ResultCompilerBackendObject.Err _) false])
      (compiler-backend-descriptor-pair-object-target-ok? target))))

(define (compiler-backend-descriptor-pair-ok?) : bool
  (and
    (compiler-backend-descriptor-pair-spill-order-ok?)
    (compiler-backend-descriptor-pair-register-order-ok?)
    (compiler-backend-descriptor-pair-target-ok? (CompilerBackendTarget.Linux))
    (compiler-backend-descriptor-pair-target-ok?
      (CompilerBackendTarget.Windows))))

(define (compiler-backend-reg-part-entry-ok?
  [reg : String]
  [reg32 : String]
  [reg16 : String]
  [reg8 : String]) : bool
  (and
    (string.eq (compiler-backend-reg-part (string.copy reg) 8) reg)
    (string.eq (compiler-backend-reg-part (string.copy reg) 4) reg32)
    (string.eq (compiler-backend-reg-part (string.copy reg) 2) reg16)
    (string.eq (compiler-backend-reg-part (string.copy reg) 1) reg8)))

(define (compiler-backend-reg-part-known-entry-ok? [reg : String]) : bool
  (cond
    [(string.eq reg "%rax")
      (compiler-backend-reg-part-entry-ok? reg "%eax" "%ax" "%al")]
    [(string.eq reg "%rbx")
      (compiler-backend-reg-part-entry-ok? reg "%ebx" "%bx" "%bl")]
    [(string.eq reg "%rcx")
      (compiler-backend-reg-part-entry-ok? reg "%ecx" "%cx" "%cl")]
    [(string.eq reg "%rdx")
      (compiler-backend-reg-part-entry-ok? reg "%edx" "%dx" "%dl")]
    [(string.eq reg "%rdi")
      (compiler-backend-reg-part-entry-ok? reg "%edi" "%di" "%dil")]
    [(string.eq reg "%rsi")
      (compiler-backend-reg-part-entry-ok? reg "%esi" "%si" "%sil")]
    [(string.eq reg "%r8")
      (compiler-backend-reg-part-entry-ok? reg "%r8d" "%r8w" "%r8b")]
    [(string.eq reg "%r9")
      (compiler-backend-reg-part-entry-ok? reg "%r9d" "%r9w" "%r9b")]
    [(string.eq reg "%r10")
      (compiler-backend-reg-part-entry-ok? reg "%r10d" "%r10w" "%r10b")]
    [(string.eq reg "%r11")
      (compiler-backend-reg-part-entry-ok? reg "%r11d" "%r11w" "%r11b")]
    [(string.eq reg "%r12")
      (compiler-backend-reg-part-entry-ok? reg "%r12d" "%r12w" "%r12b")]
    [(string.eq reg "%r13")
      (compiler-backend-reg-part-entry-ok? reg "%r13d" "%r13w" "%r13b")]
    [(string.eq reg "%r14")
      (compiler-backend-reg-part-entry-ok? reg "%r14d" "%r14w" "%r14b")]
    [(string.eq reg "%r15")
      (compiler-backend-reg-part-entry-ok? reg "%r15d" "%r15w" "%r15b")]
    [(string.eq reg "%rbp")
      (compiler-backend-reg-part-entry-ok? reg "%ebp" "%bp" "%bpl")]
    [else false]))

(define (compiler-backend-reg-part-list-ok? [regs : CompilerRegStringList]) : bool
  (match regs
    [(CompilerRegStringList.Nil) true]
    [(CompilerRegStringList.Cons reg rest)
      (and
        (compiler-backend-reg-part-known-entry-ok? reg)
        (compiler-backend-reg-part-list-ok? (box-get rest)))]))

(define (compiler-backend-reg-part-pools-ok?) : bool
  (and
    (compiler-backend-reg-part-list-ok?
      (compiler-reg-sysv-integer-registers-with-rbp))
    (compiler-backend-reg-part-list-ok?
      (compiler-reg-zero-call-caller-saved-integer-registers))
    (compiler-backend-reg-part-list-ok?
      (compiler-reg-sysv-caller-saved-integer-registers))
    (compiler-backend-reg-part-list-ok?
      (compiler-reg-sysv-callee-saved-integer-registers))
    (compiler-backend-reg-part-list-ok?
      (compiler-reg-win64-caller-saved-integer-registers))
    (compiler-backend-reg-part-list-ok?
      (compiler-reg-win64-callee-saved-integer-registers))
    (compiler-backend-reg-part-list-ok?
      (compiler-reg-greedy-div-clobber-registers))))

(define (compiler-backend-scavenge-emergency-reg-support-ok?) : bool
  (and
    (compiler-backend-scavenge-emergency-reg-supported? "%rax")
    (compiler-backend-scavenge-emergency-reg-supported? "%rcx")
    (compiler-backend-scavenge-emergency-reg-supported? "%rdx")
    (compiler-backend-scavenge-emergency-reg-supported? "%r8")
    (compiler-backend-scavenge-emergency-reg-supported? "%r9")
    (compiler-backend-scavenge-emergency-reg-supported? "%r10")
    (compiler-backend-scavenge-emergency-reg-supported? "%r11")
    (compiler-backend-scavenge-emergency-reg-supported? "%r12")
    (compiler-backend-scavenge-emergency-reg-supported? "%r13")
    (compiler-backend-scavenge-emergency-reg-supported? "%r14")
    (compiler-backend-scavenge-emergency-reg-supported? "%r15")
    (compiler-backend-scavenge-emergency-reg-supported? "%rbx")
    (compiler-backend-scavenge-emergency-reg-supported? "%rsi")
    (compiler-backend-scavenge-emergency-reg-supported? "%rdi")
    (compiler-backend-scavenge-emergency-reg-supported? "%xmm2")
    (compiler-backend-scavenge-emergency-reg-supported? "%xmm3")
    (compiler-backend-scavenge-emergency-reg-supported? "%xmm4")
    (compiler-backend-scavenge-emergency-reg-supported? "%xmm5")
    (not (compiler-backend-scavenge-emergency-reg-supported? "%r16"))))

(define (compiler-backend-ir-walker-call-use-counts-ok?) : bool
  (let
    [counts : (Array i64) (array.make-array i64 12)]
    (begin
      (compiler-backend-count-instr-uses
        counts
        (CompilerIrInstr.CallIndirect
          0
          (CompilerIrValue.Var 1)
          (CompilerIrCallArgs.Two
            (CompilerIrValue.Var 2)
            (CompilerIrValue.Var 3))
          (AstType.I64)))
      (compiler-backend-count-instr-uses
        counts
        (CompilerIrInstr.CallIndirectC
          4
          (CompilerIrValue.Var 4)
          (CompilerIrCallArgs.One (CompilerIrValue.Var 5))
          (AstType.I64)))
      (compiler-backend-count-instr-uses
        counts
        (CompilerIrInstr.TailCall
          (ci.intern "tail")
          (CompilerIrCallArgs.Two
            (CompilerIrValue.Var 6)
            (CompilerIrValue.Var 7))
          (AstType.I64)))
      (compiler-backend-count-instr-uses
        counts
        (CompilerIrInstr.TailCallIndirect
          (CompilerIrValue.Var 8)
          (CompilerIrCallArgs.Two
            (CompilerIrValue.Var 9)
            (CompilerIrValue.Var 10))
          (AstType.I64)))
      (and
        (backend-and8
          (= (array-ref counts 1) 1)
          (= (array-ref counts 2) 1)
          (= (array-ref counts 3) 1)
          (= (array-ref counts 4) 1)
          (= (array-ref counts 5) 1)
          (= (array-ref counts 6) 1)
          (= (array-ref counts 7) 1)
          (= (array-ref counts 8) 1))
        (= (array-ref counts 9) 1)
        (= (array-ref counts 10) 1)))))

(define (compiler-backend-ir-walker-collections-ok?) : bool
  (let
    [ty : AstType (compiler-backend-register-group-test-type)]
    [values : CompilerIrValueList
      (compiler-ir-value-cons
        (CompilerIrValue.Function (ci.intern "walked_fn"))
        (compiler-ir-value-cons
          (CompilerIrValue.String "walked-string")
          (compiler-ir-value-cons
            (CompilerIrValue.F64 (compiler-backend-test-f64-bits "2.5"))
            CompilerIrValueList.Nil)))]
    [packed : CompilerBackendProgramCollections
      (compiler-backend-collect-instr-collections
        (compiler-backend-program-collections-new)
        (CompilerIrInstr.Pack 0 values ty))]
    [worded : CompilerBackendProgramCollections
      (compiler-backend-collect-instr-collections
        packed
        (CompilerIrInstr.Word 1 (CompilerIrValue.String "word-string") 0 ty))]
    (and
      (compiler-backend-symbol-list-contains-id?
        (compiler-backend-program-collections-functions worded)
        (ci.intern "walked_fn"))
      (compiler-backend-string-list-contains?
        (compiler-backend-program-collections-strings worded)
        "walked-string")
      (compiler-backend-string-list-contains?
        (compiler-backend-program-collections-strings worded)
        "word-string")
      (compiler-backend-test-float-list-contains?
        (compiler-backend-program-collections-floats worded)
        (AstType.F64)
        (compiler-backend-test-f64-bits "2.5")))))

(define (compiler-backend-ir-walker-program-collections-ok?) : bool
  (let
    [call-array : (Array CompilerIrValue) (array.make-array CompilerIrValue 2)]
    (begin
      (array-set!
        call-array
        0
        (CompilerIrValue.F64 (compiler-backend-test-f64-bits "8.5")))
      (array-set! call-array 1 (CompilerIrValue.Bytes "arg-bytes"))
      (let
        [instrs : CompilerIrInstrSeq
          (compiler-ir-instr-seq-from-list
            (compiler-ir-instr-cons
              (CompilerIrInstr.Call
                0
                (ci.intern "direct")
                (CompilerIrCallArgs.Two
                  (CompilerIrValue.Function (ci.intern "call_fn"))
                  (CompilerIrValue.String "call-string"))
                (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.CallIndirect
                  1
                  (CompilerIrValue.Function (ci.intern "indirect_fn"))
                  (CompilerIrCallArgs.Array call-array)
                  (AstType.I64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Phi
                    2
                    (compiler-ir-phi-input-cons
                      (CompilerIrValue.String "phi-string")
                      "entry"
                      CompilerIrPhiInputList.Nil)
                    (AstType.String))
                  (compiler-ir-instr-cons
                    (CompilerIrInstr.Return
                      (CompilerIrMaybeValue.Some
                        (CompilerIrValue.Bytes "return-bytes")))
                    CompilerIrInstrList.Nil)))))]
        [blocks : CompilerIrBlockList
          (CompilerIrBlockList.Array
            (compiler-ir-block-seq-from-list
              (compiler-ir-block-cons
                (CompilerIrBlock.Block "entry" instrs)
                CompilerIrBlockList.Nil)))]
        [functions : CompilerIrFunctionList
          (CompilerIrFunctionList.Array
            (compiler-ir-function-seq-from-list
              (compiler-ir-function-cons
                (CompilerIrFunction.Function
                  (ci.intern "main")
                  CompilerIrParamList.Nil
                  (AstType.I64)
                  3
                  blocks)
                CompilerIrFunctionList.Nil)))]
        [globals : CompilerIrGlobalList
          (compiler-ir-global-cons
            (CompilerIrGlobal.Global
              (ci.intern "global_text")
              (AstType.String)
              (CompilerIrValue.String "global-string"))
            CompilerIrGlobalList.Nil)]
        [collections : CompilerBackendProgramCollections
          (compiler-backend-collect-program-collections
            (CompilerIrProgram.Program
              globals
              functions
              CompilerIrExternList.Nil))]
        (and
          (compiler-backend-symbol-list-contains-id?
            (compiler-backend-program-collections-functions collections)
            (ci.intern "call_fn"))
          (compiler-backend-symbol-list-contains-id?
            (compiler-backend-program-collections-functions collections)
            (ci.intern "indirect_fn"))
          (compiler-backend-string-list-contains?
            (compiler-backend-program-collections-strings collections)
            "global-string")
          (compiler-backend-string-list-contains?
            (compiler-backend-program-collections-strings collections)
            "call-string")
          (compiler-backend-string-list-contains?
            (compiler-backend-program-collections-strings collections)
            "phi-string")
          (compiler-backend-test-float-list-contains?
            (compiler-backend-program-collections-floats collections)
            (AstType.F64)
            (compiler-backend-test-f64-bits "8.5"))
          (compiler-backend-string-list-contains?
            (compiler-backend-program-collections-bytes collections)
            "arg-bytes")
          (compiler-backend-string-list-contains?
            (compiler-backend-program-collections-bytes collections)
            "return-bytes"))))))

(define (compiler-backend-ir-walker-group-metadata-array-ok?) : bool
  (let
    [ty : AstType (compiler-backend-register-group-test-type)]
    [name : String (compiler-backend-aggregate-type-name ty)]
    [words : CompilerIrValueList
      (compiler-ir-value-cons
        (CompilerIrValue.I64 1)
        (compiler-ir-value-cons
          (CompilerIrValue.F64 (compiler-backend-test-f64-bits "3.5"))
          CompilerIrValueList.Nil))]
    [instrs : CompilerIrInstrSeq
      (compiler-ir-instr-seq-from-list
        (compiler-ir-instr-cons
          (CompilerIrInstr.Pack 0 words ty)
          CompilerIrInstrList.Nil))]
    [blocks : CompilerIrBlockList
      (CompilerIrBlockList.Array
        (compiler-ir-block-seq-from-list
          (compiler-ir-block-cons
            (CompilerIrBlock.Block "entry" instrs)
            CompilerIrBlockList.Nil)))]
    [functions : CompilerIrFunctionList
      (CompilerIrFunctionList.Array
        (compiler-ir-function-seq-from-list
          (compiler-ir-function-cons
            (CompilerIrFunction.Function
              (ci.intern "main")
              CompilerIrParamList.Nil
              (AstType.I64)
              1
              blocks)
            CompilerIrFunctionList.Nil)))]
    [counts : backend_test_string_i64_map.Map
      (compiler-backend-collect-group-counts-functions
        (backend_test_string_i64_map.with-capacity 4)
        functions)]
    [masks : backend_test_string_i64_map.Map
      (compiler-backend-collect-group-class-masks-functions
        (backend_test_string_i64_map.with-capacity 4)
        functions)]
    (and
      (match (backend_test_string_i64_map.get (& counts) name)
        [(backend_test_string_i64_map.LookupFound count) (= count 2)]
        [(backend_test_string_i64_map.LookupMissing) false])
      (match (backend_test_string_i64_map.get (& masks) name)
        [(backend_test_string_i64_map.LookupFound mask) (= mask 2)]
        [(backend_test_string_i64_map.LookupMissing) false]))))

(define (compiler-backend-ir-walker-object-refs-with-plan
  [plan : CompilerBackendRuntimePlan]) : bool
  (let
    [ty : AstType (compiler-backend-register-group-test-type)]
    [index : CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil)]
    [values : CompilerIrValueList
      (compiler-ir-value-cons
        (CompilerIrValue.String "object-walked")
        (compiler-ir-value-cons
          (CompilerIrValue.F64 (compiler-backend-test-f64-bits "6.25"))
          CompilerIrValueList.Nil))]
    [packed : CompilerBackendObjectParts
      (compiler-backend-object-instr
        (compiler-backend-object-parts-empty)
        (CompilerBackendTarget.Linux)
        "main"
        "main"
        "entry"
        (CompilerIrInstr.Pack 0 values ty)
        plan
        index)]
    [worded : CompilerBackendObjectParts
      (compiler-backend-object-instr
        packed
        (CompilerBackendTarget.Linux)
        "main"
        "main"
        "entry"
        (CompilerIrInstr.Word
          1
          (CompilerIrValue.Function (ci.intern "word_target"))
          0
          ty)
        plan
        index)]
    [relocs : cobj.CompilerObjectRelocationList
      (cobj.compiler-object-relocation-builder-finish
        (struct-get worded relocations))]
    (and
      (cobj.compiler-object-relocation-list-contains?
        relocs
        (cobj.CompilerObjectRelocationKind.RipAddress)
        (compiler-backend-string-fat-label "object-walked"))
      (cobj.compiler-object-relocation-list-contains?
        relocs
        (cobj.CompilerObjectRelocationKind.RipValue)
        (compiler-backend-f64-label (compiler-backend-test-f64-bits "6.25")))
      (cobj.compiler-object-relocation-list-contains?
        relocs
        (cobj.CompilerObjectRelocationKind.RipAddress)
        (compiler-backend-closure-descriptor-label "word_target")))))

(define (compiler-backend-ir-walker-object-refs-ok?) : bool
  (match (compiler-backend-runtime-plan
    (CompilerIrProgram.Program
      CompilerIrGlobalList.Nil
      CompilerIrFunctionList.Nil
      CompilerIrExternList.Nil))
    [(ResultBackendRuntimePlan.Ok plan)
      (compiler-backend-ir-walker-object-refs-with-plan plan)]
    [(ResultBackendRuntimePlan.Err _) false]))

(define (compiler-backend-ir-walkers-fail-closed-ok?) : bool
  (and
    (compiler-backend-ir-walker-call-use-counts-ok?)
    (compiler-backend-ir-walker-collections-ok?)
    (compiler-backend-ir-walker-program-collections-ok?)
    (compiler-backend-ir-walker-group-metadata-array-ok?)
    (compiler-backend-ir-walker-object-refs-ok?)))

(define (compiler-backend-peephole-asm-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-backend-peephole-assignments)]
    (match (compiler-backend-emit-binop
      (CompilerRegVarTypeList.Nil)
      (CompilerBackendGlobalTypeList.Nil)
      assignments
      2
      (CompilerIrBinOp.Add)
      (CompilerIrValue.Var 0)
      (CompilerIrValue.I64 5)
      (AstType.I64))
      [(ResultCompilerBackend.Ok add-asm)
        (match (compiler-backend-emit-binop
          (CompilerRegVarTypeList.Nil)
          (CompilerBackendGlobalTypeList.Nil)
          assignments
          2
          (CompilerIrBinOp.Mul)
          (CompilerIrValue.Var 0)
          (CompilerIrValue.I64 3)
          (AstType.I64))
          [(ResultCompilerBackend.Ok mul-asm)
            (match (compiler-backend-emit-binop
              (CompilerRegVarTypeList.Nil)
              (CompilerBackendGlobalTypeList.Nil)
              assignments
              2
              (CompilerIrBinOp.Shl)
              (CompilerIrValue.Var 0)
              (CompilerIrValue.I64 2)
              (AstType.I64))
              [(ResultCompilerBackend.Ok shl-asm)
                (match (compiler-backend-emit-binop
                  (CompilerRegVarTypeList.Nil)
                  (CompilerBackendGlobalTypeList.Nil)
                  assignments
                  2
                  (CompilerIrBinOp.Lt)
                  (CompilerIrValue.Var 0)
                  (CompilerIrValue.I64 10)
                  (AstType.I64))
                  [(ResultCompilerBackend.Ok cmp-asm)
                    (match (compiler-backend-emit-branch
                      assignments
                      "peephole"
                      (CompilerIrValue.Var 0)
                      "then"
                      "else"
                      (CompilerBackendMaybeLabel.No))
                      [(ResultCompilerBackend.Ok branch-asm)
                        (and
                          (compiler-backend-string-contains?
                            add-asm
                            "    leaq 5(%r12), %r13\n")
                          (not
                            (compiler-backend-string-contains?
                              add-asm
                              "    addq $5, %rax\n"))
                          (compiler-backend-string-contains?
                            mul-asm
                            "    imulq $3, %r12, %r13\n")
                          (not
                            (compiler-backend-string-contains?
                              mul-asm
                              "    imulq $3, %rax\n"))
                          (compiler-backend-string-contains?
                            shl-asm
                            "    shlq $2, %r13\n")
                          (not
                            (compiler-backend-string-contains?
                              shl-asm
                              "    movq $2, %r8\n"))
                          (compiler-backend-string-contains?
                            cmp-asm
                            "    cmpq $10, %r13\n    setl %r13b\n")
                          (compiler-backend-string-contains?
                            branch-asm
                            "    testq %r12, %r12\n    jne ")
                          (not
                            (compiler-backend-string-contains?
                              branch-asm
                              "    movq %r12, %rax\n"))
                          (not
                            (compiler-backend-string-contains?
                              branch-asm
                              "    cmpq $0, %rax\n    jne ")))]
                      [(ResultCompilerBackend.Err _) false])]
                  [(ResultCompilerBackend.Err _) false])]
              [(ResultCompilerBackend.Err _) false])]
          [(ResultCompilerBackend.Err _) false])]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-post-regalloc-peephole-ok?) : bool
  (let
    [input : String
      "label:
    movq %rax, %rax
    movq %rax, %r12
    movq %r12, %rax
    movq %rax, %r12
    movq %rax, -16(%rbp)
    movq -16(%rbp), %rax
    movq %r8, -24(%rbp)
    movq -24(%rbp), %r10
    movq %r8, -24(%rbp)
    movq %r9, -24(%rbp)
    movq %rax, -32(%rbp)
    movq %r8, -40(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -64(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -72(%rbp)
    movq $7, %rax
    movq -56(%rbp), %rax
    movq %rax, -80(%rbp)
    movq %rax, 16(%rbp)
    movq %r8, 16(%rbp)
    movq -88(%rbp), %r12
    call _tl_side
    movq -88(%rbp), %rax
    movq -96(%rbp), %r8
    call _tl_side
    movq -96(%rbp), %r10
    movq -8(%rbp), %r8
    addq %r8, %rax
    movq $0, %r8
    movq %rax, %r9
    movq %r9, %r10
"]
    [want : String
      "label:
    movq %rax, %r12
    movq %rax, -16(%rbp)
    movq %r8, -24(%rbp)
    movq %r8, %r10
    movq %r9, -24(%rbp)
    movq %rax, -32(%rbp)
    movq %r8, -40(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -64(%rbp)
    movq %rax, -72(%rbp)
    movq $7, %rax
    movq -56(%rbp), %rax
    movq %rax, -80(%rbp)
    movq %rax, 16(%rbp)
    movq %r8, 16(%rbp)
    movq -88(%rbp), %r12
    call _tl_side
    movq %r12, %rax
    movq -96(%rbp), %r8
    call _tl_side
    movq -96(%rbp), %r10
    movq -8(%rbp), %r8
    addq %r8, %rax
    movq $0, %r8
    movq %rax, %r9
    movq %r9, %r10
"]
    [direct : String
      (compiler-backend-peephole-forward-frame-load-line
        "    movq %r8, -24(%rbp)"
        "    movq -24(%rbp), %r10")]
    [_carry-safe-reset : unit (compiler-backend-peephole-carry-safe-reset!)]
    [got : String (compiler-backend-peephole-asm input)]
    (and (string.eq direct "    movq %r8, %r10") (string.eq got want))))

(define (compiler-backend-peephole-vector-gp-owners-ok?) : bool
  (let
    [input : String
      "    movq 16(%rsp), %r9
    vmovdqu (%r13,%r9,8), %ymm7
    movq 16(%rsp), %r9
    vpaddq (%r15,%r9,8), %ymm7, %ymm7
    movq 16(%rsp), %r9
    vmovdqu %ymm7, (%rbx,%r9,8)
    movq 16(%rsp), %r9
    vpmovmskb %ymm7, %r9
    movq 16(%rsp), %r9
"]
    [want : String
      "    movq 16(%rsp), %r9
    vmovdqu (%r13,%r9,8), %ymm7
    vpaddq (%r15,%r9,8), %ymm7, %ymm7
    vmovdqu %ymm7, (%rbx,%r9,8)
    movq 16(%rsp), %r9
    vpmovmskb %ymm7, %r9
    movq 16(%rsp), %r9
"]
    [_carry-safe-reset : unit (compiler-backend-peephole-carry-safe-reset!)]
    [got : String (compiler-backend-peephole-asm input)]
    (string.eq got want)))

(define (compiler-backend-deadstore-sweep-win64-rbp-frame-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    .seh_pushreg %rbp
    movq %rsp, %rbp
    .seh_setframe %rbp, 0
    subq $48, %rsp
    .seh_stackalloc 48
    .seh_endprologue
    movq %r9, 40(%rsp)
    leave
    ret
    .seh_endproc
"]
    [want : String
      "main:
    pushq %rbp
    .seh_pushreg %rbp
    movq %rsp, %rbp
    .seh_setframe %rbp, 0
    subq $48, %rsp
    .seh_stackalloc 48
    .seh_endprologue
    leave
    ret
    .seh_endproc
"]
    [_reset : unit (compiler-backend-sweep-reset!)]
    [_record : unit (compiler-backend-sweep-record-win64! "main" 48 1 0 0 0)]
    [got : String (compiler-backend-peephole-asm input)]
    [_reset-after : unit (compiler-backend-sweep-reset!)]
    (string.eq got want)))

(define (compiler-backend-deadstore-sweep-win64-csr-stays-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r12, 32(%rsp)
    leave
    ret
"]
    [_reset : unit (compiler-backend-sweep-reset!)]
    [_record : unit (compiler-backend-sweep-record-win64! "main" 48 1 0 0 0)]
    [got : String (compiler-backend-peephole-asm input)]
    [_reset-after : unit (compiler-backend-sweep-reset!)]
    (string.eq got input)))

(define (compiler-backend-deadstore-sweep-win64-address-stays-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leaq 40(%rsp), %rax
    leave
    ret
"]
    [_reset : unit (compiler-backend-sweep-reset!)]
    [_record : unit (compiler-backend-sweep-record-win64! "main" 48 1 0 0 0)]
    [got : String (compiler-backend-peephole-asm input)]
    [_reset-after : unit (compiler-backend-sweep-reset!)]
    (string.eq got input)))

(define (compiler-backend-deadstore-sweep-win64-pop-tail-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leaq 24(%rsp), %rsp
    popq %r13
    popq %r12
    leave
    ret
"]
    [want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    leaq 24(%rsp), %rsp
    popq %r13
    popq %r12
    leave
    ret
"]
    [_reset : unit (compiler-backend-sweep-reset!)]
    [_record : unit (compiler-backend-sweep-record-win64! "main" 48 1 0 0 0)]
    [got : String (compiler-backend-peephole-asm input)]
    [_reset-after : unit (compiler-backend-sweep-reset!)]
    (string.eq got want)))

(define (compiler-backend-deadstore-sweep-linux-leave-poisons-ok?) : bool
  (let
    [input : String
      "main:
    subq $56, %rsp
    movq %r9, 40(%rsp)
    leave
    ret
"]
    [_reset : unit (compiler-backend-sweep-reset!)]
    [_record : unit (compiler-backend-sweep-record-fpo! "main" 48 0 1 0 0 0)]
    [got : String (compiler-backend-peephole-asm input)]
    [_reset-after : unit (compiler-backend-sweep-reset!)]
    (string.eq got input)))

(define (compiler-backend-deadstore-sweep-metadata-consumed-ok?) : bool
  (let
    [first : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leave
    ret
"]
    [first-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    leave
    ret
"]
    [second : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leave
    ret
"]
    [_reset : unit (compiler-backend-sweep-reset!)]
    [_record : unit (compiler-backend-sweep-record-win64! "main" 48 1 0 0 0)]
    [first-got : String (compiler-backend-peephole-asm first)]
    [second-got : String (compiler-backend-peephole-asm second)]
    [_reset-after : unit (compiler-backend-sweep-reset!)]
    (and (string.eq first-got first-want) (string.eq second-got second))))

(define (compiler-backend-deadstore-sweep-win64-ok?) : bool
  (and
    (compiler-backend-deadstore-sweep-win64-rbp-frame-ok?)
    (compiler-backend-deadstore-sweep-win64-csr-stays-ok?)
    (compiler-backend-deadstore-sweep-win64-address-stays-ok?)
    (compiler-backend-deadstore-sweep-win64-pop-tail-ok?)
    (compiler-backend-deadstore-sweep-linux-leave-poisons-ok?)
    (compiler-backend-deadstore-sweep-metadata-consumed-ok?)))

(define (compiler-backend-r10-dead-scan-long-gap-ok?) : bool
  (let
    [asm : String
      "    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rcx, %r10
"]
    [data : (Ptr u8)
      (unsafe
        (string-data asm))]
    (compiler-backend-peephole-r10-dead-after?
      asm
      data
      0
      (string.string-length asm))))

;; The grouped TextBuf path must preserve pairs that cross arbitrary physical
;; chunks, while splitting safely at the following function's `.globl` chunk.
(define (compiler-backend-chunked-peephole-equivalent?) : bool
  (let
    [chunks : text_buf.TextBuf
      (text_buf.append
        (text_buf.append
          (text_buf.append
            (text_buf.append
              (text_buf.empty)
              ".text\n.globl first\nfirst:\n    movq %rax, %r")
            "10\n    movq 8(%r10), %r8\n")
          ".globl second\nsecond:\n    movq %rax, -8(%rbp)\n")
        "    movq -8(%rbp), %r9\n")]
    [input : String (text_buf.render chunks)]
    [legacy : String (compiler-backend-peephole-asm-once input)]
    [chunked : String
      (text_buf.render (compiler-backend-peephole-text-buf-once chunks))]
    (string.eq legacy chunked)))

;; Compare the final streaming path against the former raw-buffer -> whole
;; peephole -> sweep sequence on the same lowered program. Re-lowering resets
;; the recorded FPO sweep metadata before the streaming run.
(define (compiler-backend-streamed-final-output-equivalent-source?
  [src : String]) : bool
  (match (lower-compiler-source src)
    [(ResultCompilerLower.Ok first-program first-spans)
      (match (compiler-backend-emit-program-target-with-mode-buffer
        first-program
        (CompilerBackendTarget.Linux)
        (CompilerBackendMode.Scalar)
        first-spans
        true)
        [(ResultCompilerBackendBuffer.Ok raw)
          (let
            [legacy : String
              (compiler-backend-peephole-asm (text_buf.render raw))]
            (match (lower-compiler-source src)
              [(ResultCompilerLower.Ok second-program second-spans)
                (match (compiler-backend-emit-program-target-with-mode-final-buffer-and-crt
                  second-program
                  (CompilerBackendTarget.Linux)
                  (CompilerBackendMode.Scalar)
                  second-spans
                  true
                  false)
                  [(ResultCompilerBackendBuffer.Ok streamed)
                    (string.eq legacy (text_buf.render streamed))]
                  [(ResultCompilerBackendBuffer.Err _) false])]
              [(ResultCompilerLower.Err _) false]))]
        [(ResultCompilerBackendBuffer.Err _) false])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-backend-streamed-final-output-equivalent?) : bool
  (compiler-backend-streamed-final-output-equivalent-source?
    (compiler-backend-smoke-source)))

;; 65 functions crosses the production 64-function raw batch boundary.
(define (compiler-backend-streamed-final-batch-equivalent?) : bool
  (let
    [buf : text_buf.TextBuf (text_buf.empty)]
    [i : i64 0]
    (begin
      (while (< i 65)
        (begin
          (set!
            buf
            (text_buf.append
              buf
              (string.append
                "(define (f"
                (string.append
                  (string.int->string i)
                  (string.append
                    ") : i64 "
                    (string.append (string.int->string i) ")\n"))))))
          (set! i (+ i 1))))
      (compiler-backend-streamed-final-output-equivalent-source?
        (text_buf.render
          (text_buf.append buf "(define (main) : i64 (+ (f0) (f64)))\n"))))))

(define (compiler-backend-rax-forward-chain-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (CompilerIrInstr.BinOp
      0
      (CompilerIrBinOp.Mul)
      (CompilerIrValue.I64 2)
      (CompilerIrValue.I64 3)
      (AstType.I64))
    (compiler-ir-instr-cons
      (CompilerIrInstr.BinOp
        1
        (CompilerIrBinOp.Add)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.I64 7)
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.BinOp
          2
          (CompilerIrBinOp.Add)
          (CompilerIrValue.I64 11)
          (CompilerIrValue.Var 1)
          (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Return
            (CompilerIrMaybeValue.Some (CompilerIrValue.Var 2)))
          CompilerIrInstrList.Nil)))))

(define (compiler-backend-rax-forward-multiple-use-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (CompilerIrInstr.BinOp
      0
      (CompilerIrBinOp.Add)
      (CompilerIrValue.I64 1)
      (CompilerIrValue.I64 2)
      (AstType.I64))
    (compiler-ir-instr-cons
      (CompilerIrInstr.BinOp
        1
        (CompilerIrBinOp.Add)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.I64 3)
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.BinOp
          2
          (CompilerIrBinOp.Add)
          (CompilerIrValue.Var 0)
          (CompilerIrValue.I64 4)
          (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Return
            (CompilerIrMaybeValue.Some (CompilerIrValue.Var 2)))
          CompilerIrInstrList.Nil)))))

(define (compiler-backend-call-arg-rax-forward-direct-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (CompilerIrInstr.Call
      0
      (ci.intern "producer")
      (CompilerIrCallArgs.Nil)
      (AstType.I64))
    (compiler-ir-instr-cons
      (CompilerIrInstr.Call
        1
        (ci.intern "consume")
        (CompilerIrCallArgs.One (CompilerIrValue.Var 0))
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Return
          (CompilerIrMaybeValue.Some (CompilerIrValue.Var 1)))
        CompilerIrInstrList.Nil))))

(define (compiler-backend-call-arg-rax-forward-indirect-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (CompilerIrInstr.Call
      0
      (ci.intern "producer")
      (CompilerIrCallArgs.Nil)
      (AstType.I64))
    (compiler-ir-instr-cons
      (CompilerIrInstr.CallIndirect
        1
        (CompilerIrValue.Function (ci.intern "consume"))
        (CompilerIrCallArgs.One (CompilerIrValue.Var 0))
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Return
          (CompilerIrMaybeValue.Some (CompilerIrValue.Var 1)))
        CompilerIrInstrList.Nil))))

(define (compiler-backend-call-arg-rax-nonleading-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (CompilerIrInstr.Call
      0
      (ci.intern "producer")
      (CompilerIrCallArgs.Nil)
      (AstType.I64))
    (compiler-ir-instr-cons
      (CompilerIrInstr.Call
        1
        (ci.intern "consume2")
        (CompilerIrCallArgs.Two (CompilerIrValue.I64 7) (CompilerIrValue.Var 0))
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Return
          (CompilerIrMaybeValue.Some (CompilerIrValue.Var 1)))
        CompilerIrInstrList.Nil))))

(define (compiler-backend-call-arg-rax-group-consumer-instrs) : CompilerIrInstrList
  (compiler-ir-instr-cons
    (CompilerIrInstr.Call
      0
      (ci.intern "producer")
      (CompilerIrCallArgs.Nil)
      (AstType.I64))
    (compiler-ir-instr-cons
      (CompilerIrInstr.Call
        1
        (ci.intern "consume_group")
        (CompilerIrCallArgs.One (CompilerIrValue.Var 0))
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Return
          (CompilerIrMaybeValue.Some (CompilerIrValue.Var 1)))
        CompilerIrInstrList.Nil))))

(define (compiler-backend-call-arg-rax-group-consumer-index) : CompilerBackendProgramIndex
  (let
    [ty : AstType (compiler-backend-register-group-test-type)]
    (compiler-backend-program-index-build
      (compiler-ir-function-cons
        (CompilerIrFunction.Function
          (ci.intern "group_seed")
          CompilerIrParamList.Nil
          (AstType.Unit)
          3
          (compiler-ir-block-cons
            (compiler-ir-block
              "entry"
              (compiler-ir-instr-cons
                (CompilerIrInstr.Pack
                  2
                  (compiler-ir-value-cons
                    (CompilerIrValue.I64 1)
                    (compiler-ir-value-cons
                      (CompilerIrValue.I64 2)
                      CompilerIrValueList.Nil))
                  ty)
                CompilerIrInstrList.Nil))
            CompilerIrBlockList.Nil))
        (compiler-ir-function-cons
          (CompilerIrFunction.Function
            (ci.intern "consume_group")
            (compiler-ir-param-cons
              (CompilerIrParam.Param "value" ty 0)
              CompilerIrParamList.Nil)
            (AstType.I64)
            1
            CompilerIrBlockList.Nil)
          CompilerIrFunctionList.Nil))
      CompilerIrExternList.Nil)))

(define (compiler-backend-call-arg-rax-group-consumer-not-forwardable?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs-with-index
    (compiler-backend-call-arg-rax-group-consumer-instrs)
    2
    (compiler-backend-call-arg-rax-group-consumer-index))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    call _tl_consume_group\n")
        (not (compiler-backend-string-contains? asm "    movq %rax, %rdi\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-emit-rax-forward-test-instrs-with-index
  [instrs : CompilerIrInstrList]
  [vars : i64]
  [program-index : CompilerBackendProgramIndex]) : ResultCompilerBackend
  (let
    [blocks : CompilerIrBlockList
      (compiler-ir-block-cons
        (compiler-ir-block "entry" instrs)
        CompilerIrBlockList.Nil)]
    [use-counts : (Array i64)
      (compiler-backend-function-use-counts vars blocks)]
    (compiler-backend-emit-instrs
      (CompilerBackendEmissionContext
        (CompilerBackendTarget.Linux)
        "_tl_test"
        (ci.intern "test")
        blocks
        "entry"
        CompilerRegAssignmentList.Nil
        vars
        CompilerRegVarTypeList.Nil
        (CompilerBackendGlobalTypeList.Nil)
        (AstType.I64)
        (compiler-backend-runtime-helper-full-plan)
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil
        program-index
        (compiler-source-spans-empty)
        (compiler-diagnostic-at-start "" "")
        use-counts)
      (CompilerBackendMaybeLabel.No)
      instrs
      (text_buf.empty))))

(define (compiler-backend-emit-rax-forward-test-instrs
  [instrs : CompilerIrInstrList]
  [vars : i64]) : ResultCompilerBackend
  (compiler-backend-emit-rax-forward-test-instrs-with-index
    instrs
    vars
    (compiler-backend-program-index-build
      CompilerIrFunctionList.Nil
      CompilerIrExternList.Nil)))

(define (compiler-backend-rax-forwarding-ok?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs
    (compiler-backend-rax-forward-chain-instrs)
    3)
    [(ResultCompilerBackend.Ok chain-asm)
      (match (compiler-backend-emit-rax-forward-test-instrs
        (compiler-backend-rax-forward-multiple-use-instrs)
        3)
        [(ResultCompilerBackend.Ok multi-use-asm)
          (and
            (compiler-backend-string-contains? chain-asm "    imulq $3, %rax\n")
            (compiler-backend-string-contains? chain-asm "    addq $7, %rax\n")
            (compiler-backend-string-contains? chain-asm "    addq $11, %rax\n")
            (not
              (compiler-backend-string-contains?
                chain-asm
                "    movq %rax, -8(%rbp)\n"))
            (not
              (compiler-backend-string-contains?
                chain-asm
                "    movq %rax, -16(%rbp)\n"))
            (not
              (compiler-backend-string-contains?
                chain-asm
                "    movq %rax, -24(%rbp)\n"))
            (compiler-backend-string-contains?
              multi-use-asm
              "    movq %r8, -8(%rbp)\n"))]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-call-arg-rax-forwarding-ok?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs
    (compiler-backend-call-arg-rax-forward-direct-instrs)
    2)
    [(ResultCompilerBackend.Ok direct-asm)
      (match (compiler-backend-emit-rax-forward-test-instrs
        (compiler-backend-call-arg-rax-forward-indirect-instrs)
        2)
        [(ResultCompilerBackend.Ok indirect-asm)
          (match (compiler-backend-emit-rax-forward-test-instrs
            (compiler-backend-call-arg-rax-nonleading-instrs)
            2)
            [(ResultCompilerBackend.Ok nonleading-asm)
              (and
                (compiler-backend-string-contains?
                  direct-asm
                  "    call _tl_producer\n")
                (compiler-backend-string-contains?
                  direct-asm
                  "    movq %rax, -8(%rbp)\n")
                (compiler-backend-string-contains?
                  direct-asm
                  "    movq %rax, %rdi\n")
                (not
                  (compiler-backend-string-contains?
                    direct-asm
                    "    movq -8(%rbp), %rdi\n"))
                (compiler-backend-string-contains?
                  indirect-asm
                  "    movq %rax, %rsi\n")
                (not
                  (compiler-backend-string-contains?
                    indirect-asm
                    "    movq -8(%rbp), %rsi\n"))
                (compiler-backend-string-contains?
                  nonleading-asm
                  "    movq -8(%rbp), %rsi\n")
                (compiler-backend-call-arg-rax-group-consumer-not-forwardable?)
                (not
                  (compiler-backend-string-contains?
                    nonleading-asm
                    "    movq %rax, %rsi\n")))]
            [(ResultCompilerBackend.Err _) false])]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerBackend.Err _) false]))

(define compiler-backend-long-block-instr-count : i64
  4096)

(define (compiler-backend-long-normal-block-seq) : CompilerIrInstrSeq
  (let
    [count : i64 compiler-backend-long-block-instr-count]
    [total : i64 (+ count 1)]
    [slots : (Array CompilerIrInstr) (array.make-array CompilerIrInstr total)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set!
            slots
            index
            (CompilerIrInstr.Mov
              index
              (CompilerIrValue.I64 index)
              (AstType.I64)))
          (set! index (+ index 1))))
      (array-set!
        slots
        count
        (CompilerIrInstr.Return
          (CompilerIrMaybeValue.Some (CompilerIrValue.Var (- count 1)))))
      (CompilerIrInstrSeq slots total))))

(define (compiler-backend-long-normal-block-ok?) : bool
  (let
    [seq : CompilerIrInstrSeq (compiler-backend-long-normal-block-seq)]
    [instrs : CompilerIrInstrList (compiler-ir-instr-seq-to-list seq)]
    [blocks : CompilerIrBlockList
      (compiler-ir-block-cons
        (CompilerIrBlock.Block "entry" seq)
        CompilerIrBlockList.Nil)]
    [use-counts : (Array i64)
      (compiler-backend-function-use-counts
        compiler-backend-long-block-instr-count
        blocks)]
    (match (compiler-backend-emit-instrs
      (CompilerBackendEmissionContext
        (CompilerBackendTarget.Linux)
        "_tl_test"
        (ci.intern "test")
        blocks
        "entry"
        CompilerRegAssignmentList.Nil
        compiler-backend-long-block-instr-count
        CompilerRegVarTypeList.Nil
        (CompilerBackendGlobalTypeList.Nil)
        (AstType.I64)
        (compiler-backend-runtime-helper-full-plan)
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)
        (compiler-source-spans-empty)
        (compiler-diagnostic-at-start "" "")
        use-counts)
      (CompilerBackendMaybeLabel.No)
      instrs
      (text_buf.empty))
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains? asm "    movl $4095, %eax\n")
          (compiler-backend-string-contains? asm "    ret\n"))]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-binop-operand-folding-ok?) : bool
  (let
    [rhs-spill : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
        CompilerRegAssignmentList.Nil)]
    [cmp-types : CompilerRegVarTypeList
      (compiler-reg-var-type-cons
        (CompilerRegVarType.Type 0 (AstType.I64))
        (compiler-reg-var-type-cons
          (CompilerRegVarType.Type 1 (AstType.I64))
          CompilerRegVarTypeList.Nil))]
    (match (compiler-backend-emit-binop
      (CompilerRegVarTypeList.Nil)
      (CompilerBackendGlobalTypeList.Nil)
      rhs-spill
      2
      (CompilerIrBinOp.Add)
      (CompilerIrValue.Var 0)
      (CompilerIrValue.Var 1)
      (AstType.I64))
      [(ResultCompilerBackend.Ok add-asm)
        (match (compiler-backend-emit-binop
          cmp-types
          (CompilerBackendGlobalTypeList.Nil)
          rhs-spill
          2
          (CompilerIrBinOp.Lt)
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          (AstType.Bool))
          [(ResultCompilerBackend.Ok cmp-asm)
            (and
              (compiler-backend-string-contains?
                add-asm
                "    addq -16(%rbp), %r8\n")
              (not
                (compiler-backend-string-contains?
                  add-asm
                  "    movq -16(%rbp), %r9\n"))
              (compiler-backend-string-contains?
                cmp-asm
                "    cmpq -16(%rbp), %r8\n    setl %r8b\n")
              (not
                (compiler-backend-string-contains?
                  cmp-asm
                  "    movq -16(%rbp), %r9\n"))
              (string.eq
                (compiler-backend-binop-direct-mnemonic (CompilerIrBinOp.And))
                "and")
              (string.eq
                (compiler-backend-binop-direct-mnemonic (CompilerIrBinOp.Or))
                "or"))]
          [(ResultCompilerBackend.Err _) false])]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-bounds-operand-folding-ok?) : bool
  (let
    [index-reg : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        CompilerRegAssignmentList.Nil)]
    [index-reg-length-spill : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
          CompilerRegAssignmentList.Nil))]
    (match (compiler-backend-emit-test-instrs
      (compiler-ir-instr-cons
        (CompilerIrInstr.BoundsCheck
          (CompilerIrValue.Var 0)
          (CompilerIrValue.I64 3)
          "bounds_ok")
        CompilerIrInstrList.Nil)
      index-reg
      2)
      [(ResultCompilerBackend.Ok imm-asm)
        (match (compiler-backend-emit-test-instrs
          (compiler-ir-instr-cons
            (CompilerIrInstr.BoundsCheck
              (CompilerIrValue.Var 0)
              (CompilerIrValue.Var 1)
              "bounds_ok")
            CompilerIrInstrList.Nil)
          index-reg-length-spill
          3)
          [(ResultCompilerBackend.Ok spill-asm)
            (and
              (compiler-backend-string-contains? imm-asm "    cmpq $3, %r12\n")
              (not
                (compiler-backend-string-contains?
                  imm-asm
                  "    movq %r12, %rax\n"))
              (not
                (compiler-backend-string-contains?
                  imm-asm
                  "    movl $3, %r11d\n"))
              (compiler-backend-string-contains?
                spill-asm
                "    cmpq -16(%rbp), %r12\n")
              (not
                (compiler-backend-string-contains?
                  spill-asm
                  "    movq %r12, %rax\n"))
              (not
                (compiler-backend-string-contains?
                  spill-asm
                  "    movq -16(%rbp), %r11\n")))]
          [(ResultCompilerBackend.Err _) false])]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-bounds-direct-pressure-tail
  [index : i64]
  [count : i64]) : CompilerIrInstrList
  (if (>= index count)
    (compiler-ir-instr-cons
      (CompilerIrInstr.Return CompilerIrMaybeValue.No)
      CompilerIrInstrList.Nil)
    (compiler-ir-instr-cons
      (CompilerIrInstr.StorePtr
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var index)
        (AstType.I64))
      (compiler-backend-bounds-direct-pressure-tail (+ index 1) count))))

;; A direct register/memory length operand needs no scratch. Under full register
;; pressure an eager, unused scavenge would otherwise add an emergency stack
;; save at the bounds check even though the compare already has both operands.
(define (compiler-backend-bounds-direct-pressure-asm) : ResultCompilerBackend
  (let
    [previous-slot : i64 compiler-backend-emergency-slot-offset]
    [_slot : unit (set! compiler-backend-emergency-slot-offset -512)]
    [regs : (Array String) (compiler-backend-scavenge-candidates)]
    [count : i64 (array-length regs)]
    [assignments : CompilerRegAssignmentList
      (compiler-backend-test-reg-assignment-list-from regs 0)]
    [instrs : CompilerIrInstrList
      (compiler-ir-instr-cons
        (CompilerIrInstr.BoundsCheck
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          "bounds_ok")
        (compiler-backend-bounds-direct-pressure-tail 1 count))]
    [result : ResultCompilerBackend
      (compiler-backend-emit-test-instrs instrs assignments count)]
    [_restore : unit
      (set! compiler-backend-emergency-slot-offset previous-slot)]
    result))

(define (compiler-backend-bounds-direct-pressure-ok?) : bool
  (match (compiler-backend-bounds-direct-pressure-asm)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    cmpq %rcx, %r9\n")
        (not (compiler-backend-string-contains? asm "-512(%rbp)")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-win64-bounds-index-scratch-ok?) : bool
  (let
    [_win : unit (compiler-backend-set-current-fn-win64!)]
    [length-rax : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          1
          (CompilerRegLocation.Register "%rax"))
        CompilerRegAssignmentList.Nil)]
    [ok : bool
      (match (compiler-backend-emit-test-instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.BoundsCheck
            (CompilerIrValue.I64 0)
            (CompilerIrValue.Var 1)
            "bounds_ok")
          CompilerIrInstrList.Nil)
        length-rax
        2)
        [(ResultCompilerBackend.Ok asm)
          ;; The merged emitter folds the constant index 0 directly into the
          ;; bounds compare (`cmpq $0, %rax`) instead of materializing it in a
          ;; scratch register. The Win64 safety invariant is unchanged: the
          ;; length (in %rax) is never clobbered, so no degenerate
          ;; `cmpq %rax, %rax` self-compare is emitted.
          (and
            (compiler-backend-string-contains? asm "    cmpq $0, %rax\n")
            (not
              (compiler-backend-string-contains? asm "    cmpq %rax, %rax\n")))]
        [(ResultCompilerBackend.Err _) false])]
    [_linux : unit (compiler-backend-set-current-fn-linux!)]
    ok))

(define (compiler-backend-win64-compare-rhs-rax-ok?) : bool
  (let
    [_win : unit (compiler-backend-set-current-fn-win64!)]
    [rhs-rax : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          1
          (CompilerRegLocation.Register "%rax"))
        CompilerRegAssignmentList.Nil)]
    [ok : bool
      (match (compiler-backend-emit-compare-branch
        rhs-rax
        "cmp"
        (CompilerIrBinOp.Lt)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        (AstType.I64)
        "then"
        "else"
        (CompilerBackendMaybeLabel.No))
        [(ResultCompilerBackend.Ok asm)
          ;; The merged emitter folds the spilled LHS (var0 at -8(%rbp)) directly
          ;; into the compare as a memory operand (`cmpq %rax, -8(%rbp)`) instead
          ;; of loading it into a scratch register first. The Win64 safety
          ;; invariant is unchanged: the RHS in %rax is never clobbered, so no
          ;; degenerate `cmpq %rax, %rax` self-compare is emitted.
          (and
            (compiler-backend-string-contains? asm "    cmpq %rax, -8(%rbp)\n")
            (not
              (compiler-backend-string-contains? asm "    cmpq %rax, %rax\n")))]
        [(ResultCompilerBackend.Err _) false])]
    [_linux : unit (compiler-backend-set-current-fn-linux!)]
    ok))

(define (compiler-backend-peephole-single-dest-mnemonic? [name : String]) : bool
  (compiler-backend-peephole-mnemonic-single-dest?
    (unsafe
      (string-data name))
    0
    (string.string-length name)))

(define (compiler-backend-test-peephole-reg-index [name : String]) : i64
  (compiler-backend-peephole-token-reg-index-range
    (unsafe
      (string-data name))
    0
    (string.string-length name)))

(define (compiler-backend-test-peephole-memory-base [operand : String]) : i64
  (compiler-backend-peephole-memory-base-range
    (unsafe
      (string-data operand))
    0
    (string.string-length operand)))

(define (compiler-backend-peephole-operand-classifiers-ok?) : bool
  (and
    (= (compiler-backend-test-peephole-reg-index "%rax") 0)
    (= (compiler-backend-test-peephole-reg-index "%rcx") 1)
    (= (compiler-backend-test-peephole-reg-index "%rdx") 2)
    (= (compiler-backend-test-peephole-reg-index "%rbx") 3)
    (= (compiler-backend-test-peephole-reg-index "%rsi") 4)
    (= (compiler-backend-test-peephole-reg-index "%rdi") 5)
    (= (compiler-backend-test-peephole-reg-index "%r8") 6)
    (= (compiler-backend-test-peephole-reg-index "%r9") 7)
    (= (compiler-backend-test-peephole-reg-index "%r10") 8)
    (= (compiler-backend-test-peephole-reg-index "%r11") 9)
    (= (compiler-backend-test-peephole-reg-index "%r12") 10)
    (= (compiler-backend-test-peephole-reg-index "%r13") 11)
    (= (compiler-backend-test-peephole-reg-index "%r14") 12)
    (= (compiler-backend-test-peephole-reg-index "%r15") 13)
    (= (compiler-backend-test-peephole-reg-index "%eax") 0)
    (= (compiler-backend-test-peephole-reg-index "%ax") 0)
    (= (compiler-backend-test-peephole-reg-index "%al") 0)
    (= (compiler-backend-test-peephole-reg-index "%ecx") 1)
    (= (compiler-backend-test-peephole-reg-index "%cx") 1)
    (= (compiler-backend-test-peephole-reg-index "%cl") 1)
    (= (compiler-backend-test-peephole-reg-index "%edx") 2)
    (= (compiler-backend-test-peephole-reg-index "%dx") 2)
    (= (compiler-backend-test-peephole-reg-index "%dl") 2)
    (= (compiler-backend-test-peephole-reg-index "%ebx") 3)
    (= (compiler-backend-test-peephole-reg-index "%bx") 3)
    (= (compiler-backend-test-peephole-reg-index "%bl") 3)
    (= (compiler-backend-test-peephole-reg-index "%esi") 4)
    (= (compiler-backend-test-peephole-reg-index "%si") 4)
    (= (compiler-backend-test-peephole-reg-index "%sil") 4)
    (= (compiler-backend-test-peephole-reg-index "%edi") 5)
    (= (compiler-backend-test-peephole-reg-index "%di") 5)
    (= (compiler-backend-test-peephole-reg-index "%dil") 5)
    (= (compiler-backend-test-peephole-reg-index "%r8d") 6)
    (= (compiler-backend-test-peephole-reg-index "%r8w") 6)
    (= (compiler-backend-test-peephole-reg-index "%r8b") 6)
    (= (compiler-backend-test-peephole-reg-index "%r15d") 13)
    (= (compiler-backend-test-peephole-reg-index "%r15w") 13)
    (= (compiler-backend-test-peephole-reg-index "%r15b") 13)
    (= (compiler-backend-test-peephole-reg-index "%rbp") -1)
    (= (compiler-backend-test-peephole-reg-index "%rsp") -1)
    (= (compiler-backend-test-peephole-reg-index "%rip") -1)
    (= (compiler-backend-test-peephole-reg-index "%ah") -1)
    (= (compiler-backend-test-peephole-reg-index "%xmm0") -1)
    (= (compiler-backend-test-peephole-reg-index "%r16") -1)
    (=
      (compiler-backend-test-peephole-memory-base "-8(%rbp)")
      compiler-backend-peephole-memory-base-rbp)
    (=
      (compiler-backend-test-peephole-memory-base "(%rsp)")
      compiler-backend-peephole-memory-base-rsp)
    (=
      (compiler-backend-test-peephole-memory-base "symbol(%rip)")
      compiler-backend-peephole-memory-base-rip)
    (=
      (compiler-backend-test-peephole-memory-base "24(%r10)")
      compiler-backend-peephole-memory-base-r10)
    (=
      (compiler-backend-test-peephole-memory-base "24(%r11)")
      compiler-backend-peephole-memory-base-none)
    (=
      (compiler-backend-test-peephole-memory-base "%rax")
      compiler-backend-peephole-memory-base-none)))

(define (compiler-backend-test-control-mnemonic-kind [name : String]) : i64
  (compiler-backend-control-mnemonic-kind
    (unsafe
      (string-data name))
    0
    (string.string-length name)))

(define (compiler-backend-control-mnemonic-classifier-ok?) : bool
  (and
    (=
      (compiler-backend-test-control-mnemonic-kind "movq")
      compiler-backend-control-mnemonic-movq)
    (=
      (compiler-backend-test-control-mnemonic-kind "leaq")
      compiler-backend-control-mnemonic-leaq)
    (=
      (compiler-backend-test-control-mnemonic-kind "push")
      compiler-backend-control-mnemonic-push)
    (=
      (compiler-backend-test-control-mnemonic-kind "pushq")
      compiler-backend-control-mnemonic-push)
    (=
      (compiler-backend-test-control-mnemonic-kind "pop")
      compiler-backend-control-mnemonic-pop)
    (=
      (compiler-backend-test-control-mnemonic-kind "popq")
      compiler-backend-control-mnemonic-pop)
    (=
      (compiler-backend-test-control-mnemonic-kind "leave")
      compiler-backend-control-mnemonic-leave)
    (=
      (compiler-backend-test-control-mnemonic-kind "ret")
      compiler-backend-control-mnemonic-ret)
    (=
      (compiler-backend-test-control-mnemonic-kind "jmp")
      compiler-backend-control-mnemonic-jmp)
    (=
      (compiler-backend-test-control-mnemonic-kind "subq")
      compiler-backend-control-mnemonic-subq)
    (=
      (compiler-backend-test-control-mnemonic-kind "addq")
      compiler-backend-control-mnemonic-addq)
    (=
      (compiler-backend-test-control-mnemonic-kind "syscall")
      compiler-backend-control-mnemonic-syscall)
    (=
      (compiler-backend-test-control-mnemonic-kind "")
      compiler-backend-control-mnemonic-none)
    (=
      (compiler-backend-test-control-mnemonic-kind "movl")
      compiler-backend-control-mnemonic-none)
    (=
      (compiler-backend-test-control-mnemonic-kind "retq")
      compiler-backend-control-mnemonic-none)
    (=
      (compiler-backend-test-control-mnemonic-kind "pushqq")
      compiler-backend-control-mnemonic-none)
    (=
      (compiler-backend-test-control-mnemonic-kind "syscalx")
      compiler-backend-control-mnemonic-none)))

(define (compiler-backend-peephole-single-dest-classifier-ok?) : bool
  (and
    (compiler-backend-peephole-single-dest-mnemonic? "movabsq")
    (compiler-backend-peephole-single-dest-mnemonic? "setae")
    (compiler-backend-peephole-single-dest-mnemonic? "movl")
    (compiler-backend-peephole-single-dest-mnemonic? "movw")
    (compiler-backend-peephole-single-dest-mnemonic? "movb")
    (compiler-backend-peephole-single-dest-mnemonic? "addq")
    (compiler-backend-peephole-single-dest-mnemonic? "subl")
    (compiler-backend-peephole-single-dest-mnemonic? "andw")
    (compiler-backend-peephole-single-dest-mnemonic? "orb")
    (compiler-backend-peephole-single-dest-mnemonic? "xorq")
    (compiler-backend-peephole-single-dest-mnemonic? "leal")
    (compiler-backend-peephole-single-dest-mnemonic? "shlw")
    (compiler-backend-peephole-single-dest-mnemonic? "shrb")
    (compiler-backend-peephole-single-dest-mnemonic? "sarq")
    (compiler-backend-peephole-single-dest-mnemonic? "sall")
    (compiler-backend-peephole-single-dest-mnemonic? "negb")
    (compiler-backend-peephole-single-dest-mnemonic? "notw")
    (compiler-backend-peephole-single-dest-mnemonic? "incl")
    (compiler-backend-peephole-single-dest-mnemonic? "decq")
    (compiler-backend-peephole-single-dest-mnemonic? "movzbq")
    (compiler-backend-peephole-single-dest-mnemonic? "movzwq")
    (compiler-backend-peephole-single-dest-mnemonic? "movsbq")
    (compiler-backend-peephole-single-dest-mnemonic? "movswq")
    (compiler-backend-peephole-single-dest-mnemonic? "movslq")
    (not (compiler-backend-peephole-single-dest-mnemonic? "movq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "movzbl"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "movsd"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "imulq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "mulq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "divq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "idivq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "callq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "xchgq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "testq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "cmpq"))))

(define (compiler-backend-peephole-ok?) : bool
  (and
    (compiler-backend-control-mnemonic-classifier-ok?)
    (compiler-backend-peephole-operand-classifiers-ok?)
    (compiler-backend-peephole-single-dest-classifier-ok?)
    (compiler-backend-peephole-register-moves-ok?)
    (compiler-backend-direct-immediate-mov-ok?)
    (compiler-backend-mov-scratch-staging-ok?)
    (compiler-backend-peephole-asm-ok?)
    (compiler-backend-binop-operand-folding-ok?)
    (compiler-backend-bounds-operand-folding-ok?)
    (compiler-backend-bounds-direct-pressure-ok?)
    (compiler-backend-win64-bounds-index-scratch-ok?)
    (compiler-backend-win64-compare-rhs-rax-ok?)
    (compiler-backend-post-regalloc-peephole-ok?)
    (compiler-backend-peephole-vector-gp-owners-ok?)
    (compiler-backend-deadstore-sweep-win64-ok?)
    (compiler-backend-r10-dead-scan-long-gap-ok?)
    (compiler-backend-chunked-peephole-equivalent?)
    (compiler-backend-streamed-final-output-equivalent?)
    (compiler-backend-streamed-final-batch-equivalent?)
    (compiler-backend-rax-forwarding-ok?)
    (compiler-backend-call-arg-rax-forwarding-ok?)
    (compiler-backend-long-normal-block-ok?)
    (compiler-backend-fallthrough-jump-ok?)
    (compiler-backend-branch-fallthrough-ok?)
    (compiler-backend-zero-load-ok?)
    (compiler-backend-zero-compare-ok?)
    (compiler-backend-call-return-ok?)
    (compiler-backend-global-immediate-store-ok?)
    (compiler-backend-scratch-staging-direct-shapes-ok?)))

(define (compiler-backend-fallthrough-program) : CompilerIrProgram
  (CompilerIrProgram.Program
    CompilerIrGlobalList.Nil
    (compiler-ir-function-cons
      (CompilerIrFunction.Function
        (ci.intern "main")
        CompilerIrParamList.Nil
        (AstType.I64)
        0
        (compiler-ir-block-cons
          (compiler-ir-block
            "entry"
            (compiler-ir-instr-cons
              (CompilerIrInstr.Jump "done")
              CompilerIrInstrList.Nil))
          (compiler-ir-block-cons
            (compiler-ir-block
              "done"
              (compiler-ir-instr-cons
                (CompilerIrInstr.Return
                  (CompilerIrMaybeValue.Some (CompilerIrValue.I64 7)))
                CompilerIrInstrList.Nil))
            CompilerIrBlockList.Nil)))
      CompilerIrFunctionList.Nil)
    CompilerIrExternList.Nil))

(define (compiler-backend-fallthrough-jump-ok?) : bool
  (match (compiler-backend-emit-program-linux
    (compiler-backend-fallthrough-program))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm ".Lf0_done:\n")
        (not (compiler-backend-string-contains? asm "    jmp .Lf0_done\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-branch-fallthrough-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-backend-peephole-assignments)]
    (match (compiler-backend-emit-branch
      assignments
      "branch"
      (CompilerIrValue.Var 0)
      "then"
      "else"
      (CompilerBackendMaybeLabel.Some "else"))
      [(ResultCompilerBackend.Ok false-fallthrough)
        (match (compiler-backend-emit-branch
          assignments
          "branch"
          (CompilerIrValue.Var 0)
          "then"
          "else"
          (CompilerBackendMaybeLabel.Some "then"))
          [(ResultCompilerBackend.Ok true-fallthrough)
            (and
              (compiler-backend-string-contains?
                false-fallthrough
                "    jne .Lbranch_then\n")
              (not
                (compiler-backend-string-contains?
                  false-fallthrough
                  "    jmp .Lbranch_else\n"))
              (compiler-backend-string-contains?
                true-fallthrough
                "    je .Lbranch_else\n")
              (not
                (compiler-backend-string-contains?
                  true-fallthrough
                  "    jmp .Lbranch_then\n")))]
          [(ResultCompilerBackend.Err _) false])]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-zero-load-ok?) : bool
  (match (compiler-backend-emit-load-value-with-plan
    CompilerRegAssignmentList.Nil
    (CompilerIrValue.I64 0)
    "%rax")
    [(ResultCompilerBackend.Ok asm) (string.eq asm "    xorl %eax, %eax\n")]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-zero-compare-ok?) : bool
  (match (compiler-backend-emit-binop
    (CompilerRegVarTypeList.Nil)
    (CompilerBackendGlobalTypeList.Nil)
    (compiler-backend-peephole-assignments)
    2
    (CompilerIrBinOp.Eq)
    (CompilerIrValue.Var 0)
    (CompilerIrValue.I64 0)
    (AstType.I64))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          "    testq %r13, %r13\n    sete %r13b\n")
        (not (compiler-backend-string-contains? asm "    cmpq $0, %rax\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-global-immediate-store-ok?) : bool
  (compiler-backend-instr-contains?
    (CompilerIrInstr.Store
      (ci.intern "g")
      (CompilerIrValue.I64 7)
      (AstType.I64))
    "    movq $7, _tl_g(%rip)\n"))

(define (compiler-backend-word-scratch-staging-ok?) : bool
  (and
    (match (compiler-backend-emit-test-instrs
      (compiler-ir-instr-cons
        (CompilerIrInstr.Word 1 (CompilerIrValue.Var 2) 0 (AstType.I64))
        CompilerIrInstrList.Nil)
      CompilerRegAssignmentList.Nil
      4)
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains? asm "    movq -24(%rbp), %r8\n")
          (compiler-backend-string-contains? asm "    movq %r8, -16(%rbp)\n")
          (not (compiler-backend-string-contains? asm "%rax")))]
      [(ResultCompilerBackend.Err _) false])
    (match (compiler-backend-emit-test-instrs
      (compiler-ir-instr-cons
        (CompilerIrInstr.Word 1 (CompilerIrValue.Var 2) 0 (AstType.F64))
        CompilerIrInstrList.Nil)
      CompilerRegAssignmentList.Nil
      4)
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains? asm "    movsd -24(%rbp), %xmm2\n")
          (compiler-backend-string-contains? asm "    movsd %xmm2, -16(%rbp)\n")
          (not (compiler-backend-string-contains? asm "%xmm0")))]
      [(ResultCompilerBackend.Err _) false])
    (match (compiler-backend-emit-test-instrs
      (compiler-ir-instr-cons
        (CompilerIrInstr.Word 1 (CompilerIrValue.Var 2) 0 (AstType.F64))
        CompilerIrInstrList.Nil)
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          1
          (CompilerRegLocation.Register "%xmm3"))
        CompilerRegAssignmentList.Nil)
      4)
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains? asm "    movsd -24(%rbp), %xmm3\n")
          (not (compiler-backend-string-contains? asm "%xmm0")))]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-scratch-staging-direct-shapes-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%r13"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.RegisterPair "%r12" "%r13"))
            CompilerRegAssignmentList.Nil)))]
    [_r8-tie-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%r8"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.Register "%r8"))
            CompilerRegAssignmentList.Nil)))]
    [diag : CompilerDiagnostic (compiler-diagnostic-at-start "" "")]
    (and
      (match (compiler-backend-emit-word
        assignments
        1
        (CompilerIrValue.Var 2)
        0
        (AstType.I64)
        8
        ""
        diag)
        [(ResultCompilerBackend.Ok asm) (string.eq asm "    movq %r12, %r13\n")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-unop
        assignments
        1
        (CompilerIrUnOp.Neg)
        (CompilerIrValue.Var 0)
        (AstType.I64))
        [(ResultCompilerBackend.Ok asm)
          (string.eq asm "    movq %r12, %r13\n    negq %r13\n")]
        [(ResultCompilerBackend.Err _) false])
      (compiler-backend-word-scratch-staging-ok?))))

(define (compiler-backend-call-return-program) : CompilerIrProgram
  (CompilerIrProgram.Program
    CompilerIrGlobalList.Nil
    (compiler-ir-function-cons
      (CompilerIrFunction.Function
        (ci.intern "callee")
        CompilerIrParamList.Nil
        (AstType.I64)
        0
        (compiler-ir-block-cons
          (compiler-ir-block
            "entry"
            (compiler-ir-instr-cons
              (CompilerIrInstr.Return
                (CompilerIrMaybeValue.Some (CompilerIrValue.I64 7)))
              CompilerIrInstrList.Nil))
          CompilerIrBlockList.Nil))
      (compiler-ir-function-cons
        (CompilerIrFunction.Function
          (ci.intern "main")
          CompilerIrParamList.Nil
          (AstType.I64)
          1
          (compiler-ir-block-cons
            (compiler-ir-block
              "entry"
              (compiler-ir-instr-cons
                (CompilerIrInstr.Call
                  0
                  (ci.intern "callee")
                  (CompilerIrCallArgs.Nil)
                  (AstType.I64))
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Return
                    (CompilerIrMaybeValue.Some (CompilerIrValue.Var 0)))
                  CompilerIrInstrList.Nil)))
            CompilerIrBlockList.Nil))
        CompilerIrFunctionList.Nil))
    CompilerIrExternList.Nil))

(define (compiler-backend-call-return-ok?) : bool
  (match (compiler-backend-emit-program-linux
    (compiler-backend-call-return-program))
    [(ResultCompilerBackend.Ok asm)
      (and
        (or
          (compiler-backend-string-contains? asm "    call _tl_callee")
          (compiler-backend-string-contains? asm "    call _tl_f"))
        (not
          (or
            (compiler-backend-string-contains?
              asm
              "    call _tl_callee\n    movq %rax,")
            (compiler-backend-string-contains?
              asm
              "    call _tl_f\n    movq %rax,"))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-phi-same-home-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r12"))
      CompilerRegAssignmentList.Nil)))

(define (compiler-backend-phi-same-home-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "join"
      (compiler-ir-instr-cons
        (CompilerIrInstr.Phi
          1
          (compiler-ir-phi-input-cons
            (CompilerIrValue.Var 0)
            "entry"
            CompilerIrPhiInputList.Nil)
          (AstType.I64))
        CompilerIrInstrList.Nil))
    CompilerIrBlockList.Nil))

(define (compiler-backend-phi-cycle-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "join"
      (compiler-ir-instr-cons
        (CompilerIrInstr.Phi
          0
          (compiler-ir-phi-input-cons
            (CompilerIrValue.Var 1)
            "back"
            CompilerIrPhiInputList.Nil)
          (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Phi
            1
            (compiler-ir-phi-input-cons
              (CompilerIrValue.Var 0)
              "back"
              CompilerIrPhiInputList.Nil)
            (AstType.I64))
          CompilerIrInstrList.Nil)))
    CompilerIrBlockList.Nil))

(define (compiler-backend-phi-group-cycle-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment
      0
      (CompilerRegLocation.RegisterPair "%r12" "%r13"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        1
        (CompilerRegLocation.RegisterPair "%r14" "%r15"))
      CompilerRegAssignmentList.Nil)))

(define (compiler-backend-phi-group-cycle-blocks) : CompilerIrBlockList
  (let
    [ty : AstType (compiler-backend-register-group-test-type)]
    (compiler-ir-block-cons
      (compiler-ir-block
        "join"
        (compiler-ir-instr-cons
          (CompilerIrInstr.Phi
            0
            (compiler-ir-phi-input-cons
              (CompilerIrValue.Var 1)
              "back"
              CompilerIrPhiInputList.Nil)
            ty)
          (compiler-ir-instr-cons
            (CompilerIrInstr.Phi
              1
              (compiler-ir-phi-input-cons
                (CompilerIrValue.Var 0)
                "back"
                CompilerIrPhiInputList.Nil)
              ty)
            CompilerIrInstrList.Nil)))
      CompilerIrBlockList.Nil)))

(define (compiler-backend-phi-f64-cycle-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%xmm2"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        1
        (CompilerRegLocation.Register "%xmm3"))
      CompilerRegAssignmentList.Nil)))

(define (compiler-backend-phi-f64-cycle-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "join"
      (compiler-ir-instr-cons
        (CompilerIrInstr.Phi
          0
          (compiler-ir-phi-input-cons
            (CompilerIrValue.Var 1)
            "back"
            CompilerIrPhiInputList.Nil)
          (AstType.F64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Phi
            1
            (compiler-ir-phi-input-cons
              (CompilerIrValue.Var 0)
              "back"
              CompilerIrPhiInputList.Nil)
            (AstType.F64))
          CompilerIrInstrList.Nil)))
    CompilerIrBlockList.Nil))

(define (compiler-backend-phi-group-f64-cycle-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment
      0
      (CompilerRegLocation.RegisterPair "%xmm2" "%xmm3"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        1
        (CompilerRegLocation.RegisterPair "%xmm4" "%xmm5"))
      CompilerRegAssignmentList.Nil)))

(define (compiler-backend-phi-group-f64-cycle-blocks) : CompilerIrBlockList
  (let
    [ty : AstType (compiler-backend-register-group-f64-test-type)]
    (compiler-ir-block-cons
      (compiler-ir-block
        "join"
        (compiler-ir-instr-cons
          (CompilerIrInstr.Phi
            0
            (compiler-ir-phi-input-cons
              (CompilerIrValue.Var 1)
              "back"
              CompilerIrPhiInputList.Nil)
            ty)
          (compiler-ir-instr-cons
            (CompilerIrInstr.Phi
              1
              (compiler-ir-phi-input-cons
                (CompilerIrValue.Var 0)
                "back"
                CompilerIrPhiInputList.Nil)
              ty)
            CompilerIrInstrList.Nil)))
      CompilerIrBlockList.Nil)))

(define (compiler-backend-branch-phi-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "body"
      (compiler-ir-instr-cons
        (CompilerIrInstr.Phi
          0
          (compiler-ir-phi-input-cons
            (CompilerIrValue.I64 1)
            "entry"
            (compiler-ir-phi-input-cons
              (CompilerIrValue.Var 1)
              "body"
              CompilerIrPhiInputList.Nil))
          (AstType.I64))
        CompilerIrInstrList.Nil))
    (compiler-ir-block-cons
      (compiler-ir-block "exit" CompilerIrInstrList.Nil)
      CompilerIrBlockList.Nil)))

(define (compiler-backend-branch-phi-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r13"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%r14"))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-branch-phi-edge-copy-ok?) : bool
  (begin
    (set!
      compiler-backend-current-phi-targets
      (compiler-backend-phi-target-labels-for-blocks
        (compiler-backend-branch-phi-blocks)))
    (match (compiler-backend-emit-compare-branch-with-phi-copies
      (compiler-backend-branch-phi-assignments)
      "phi_edge"
      (compiler-backend-branch-phi-blocks)
      "entry"
      (CompilerIrBinOp.Lt)
      (CompilerIrValue.I64 1)
      (CompilerIrValue.Var 2)
      (AstType.I64)
      "body"
      "exit"
      (CompilerBackendMaybeLabel.No)
      (compiler-backend-program-index-build
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil)
      4
      ""
      "")
      [(ResultCompilerBackend.Ok asm)
        (and
          ;; `1 < %r14` is emitted as `%r14 > 1`, so the false edge uses
          ;; the reversed predicate (`jle`) while retaining the phi-copy edge.
          (compiler-backend-string-contains? asm "    jle .Lphi_edge_exit\n")
          (not
            (compiler-backend-string-contains?
              asm
              "    jl .Lphi_edge_entry_branch_true\n"))
          (compiler-backend-string-contains?
            asm
            ".Lphi_edge_entry_branch_true:\n")
          (compiler-backend-string-contains? asm "    movl $1, %r12d\n")
          (not (compiler-backend-string-contains? asm "    movq %rax, %r12\n"))
          (not
            (compiler-backend-string-contains?
              asm
              ".Lphi_edge_entry_branch_false:\n"))
          (compiler-backend-string-contains? asm "    jmp .Lphi_edge_body\n"))]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-phi-immediate-stack-copy-ok?) : bool
  (match (compiler-backend-emit-phi-edge-copies
    CompilerRegAssignmentList.Nil
    (compiler-backend-branch-phi-blocks)
    "body"
    "entry"
    (compiler-backend-program-index-build
      CompilerIrFunctionList.Nil
      CompilerIrExternList.Nil)
    4
    ""
    "")
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    movq $1, -8(%rbp)\n")
        (not (compiler-backend-string-contains? asm "    movl $1, %eax\n"))
        (not
          (compiler-backend-string-contains? asm "    movq %rax, -8(%rbp)\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-phi-direct-scalar-copy-ok?) : bool
  (match (compiler-backend-emit-phi-edge-copies
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          1
          (CompilerRegLocation.Register "%r13"))
        CompilerRegAssignmentList.Nil))
    (compiler-backend-branch-phi-blocks)
    "body"
    "body"
    (compiler-backend-program-index-build
      CompilerIrFunctionList.Nil
      CompilerIrExternList.Nil)
    4
    ""
    "")
    [(ResultCompilerBackend.Ok reg-reg)
      (match (compiler-backend-emit-phi-edge-copies
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            0
            (CompilerRegLocation.Register "%r12"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
            CompilerRegAssignmentList.Nil))
        (compiler-backend-branch-phi-blocks)
        "body"
        "body"
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)
        4
        ""
        "")
        [(ResultCompilerBackend.Ok spill-reg)
          (match (compiler-backend-emit-phi-edge-copies
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                0
                (CompilerRegLocation.Spill -8))
              (compiler-reg-assignment-cons
                (CompilerRegAssignment.Assignment
                  1
                  (CompilerRegLocation.Register "%r13"))
                CompilerRegAssignmentList.Nil))
            (compiler-backend-branch-phi-blocks)
            "body"
            "body"
            (compiler-backend-program-index-build
              CompilerIrFunctionList.Nil
              CompilerIrExternList.Nil)
            4
            ""
            "")
            [(ResultCompilerBackend.Ok reg-spill)
              (and
                (compiler-backend-string-contains?
                  reg-reg
                  "    movq %r13, %r12\n")
                (not
                  (compiler-backend-string-contains?
                    reg-reg
                    "    movq %r13, %rax\n"))
                (compiler-backend-string-contains?
                  spill-reg
                  "    movq -16(%rbp), %r12\n")
                (not
                  (compiler-backend-string-contains?
                    spill-reg
                    "    movq -16(%rbp), %rax\n"))
                (compiler-backend-string-contains?
                  reg-spill
                  "    movq %r13, -8(%rbp)\n")
                (not
                  (compiler-backend-string-contains?
                    reg-spill
                    "    movq %r13, %rax\n")))]
            [(ResultCompilerBackend.Err _) false])]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-phi-return-entry-asm
  [blocks : CompilerIrBlockList]
  [entry-instrs : CompilerIrInstrList]
  [assignments : CompilerRegAssignmentList]
  [vars : i64]) : ResultCompilerBackend
  (let
    [use-counts : (Array i64)
      (compiler-backend-function-use-counts vars blocks)]
    (compiler-backend-emit-instrs
      (CompilerBackendEmissionContext
        (CompilerBackendTarget.Linux)
        "_tl_test"
        (ci.intern "test")
        blocks
        "entry"
        assignments
        vars
        CompilerRegVarTypeList.Nil
        (CompilerBackendGlobalTypeList.Nil)
        (AstType.I64)
        (compiler-backend-runtime-helper-full-plan)
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)
        (compiler-source-spans-empty)
        (compiler-diagnostic-at-start "" "")
        use-counts)
      (CompilerBackendMaybeLabel.No)
      entry-instrs
      (text_buf.empty))))

