(define (compiler-backend-test-reg-assignment-table-from
  [regs : (__tl_dyn-array i64)]
  [index : i64]) : regalloc.CompilerRegAssignmentTable
  (if (>= index (array-length regs))
    (regalloc.compiler-reg-assignment-table-empty)
    (regalloc.compiler-reg-assignments-prepend
      (&
        (regalloc.CompilerRegAssignment index (Register (array-ref regs index))))
      (compiler-backend-test-reg-assignment-table-from regs (+ index 1)))))

(define (compiler-backend-test-fill-live-range!
  [starts : (&mut starts (__tl_dyn-array i64))]
  [ends : (&mut ends (__tl_dyn-array i64))]
  [count : i64]
  [start : i64]
  [end : i64]) : unit
  (for [i (iterator.range 0 count)]
    (set! (array-ref starts i) start)
    (set! (array-ref ends i) end))
  unit)

(define (compiler-backend-any-arity-stack-arg-shape-ok?) : bool
  (and
    (=
      (be_calls.compiler-backend-call-args-gp-register-prefix
        (be_state.CompilerBackendTarget.Linux)
        (Platform)
        9
        0
        0)
      6)
    (=
      (be_calls.compiler-backend-call-args-gp-register-prefix
        (be_state.CompilerBackendTarget.Linux)
        (Platform)
        9
        1
        1)
      5)
    (=
      (be_calls.compiler-backend-call-args-gp-register-prefix
        (be_state.CompilerBackendTarget.Linux)
        (Platform)
        4
        0
        0)
      4)
    (=
      (be_calls.compiler-backend-call-args-gp-register-prefix
        (be_state.CompilerBackendTarget.Windows)
        (Platform)
        9
        0
        0)
      4)
    (=
      (be_facts.compiler-backend-outgoing-stack-arg-offset
        (be_state.CompilerBackendTarget.Linux)
        (Platform)
        0)
      0)
    (=
      (be_facts.compiler-backend-outgoing-stack-arg-offset
        (be_state.CompilerBackendTarget.Linux)
        (Platform)
        2)
      16)
    (=
      (be_facts.compiler-backend-outgoing-stack-arg-offset
        (be_state.CompilerBackendTarget.Windows)
        (Platform)
        0)
      32)
    (=
      (be_facts.compiler-backend-outgoing-stack-arg-offset
        (be_state.CompilerBackendTarget.Windows)
        (Internal)
        0)
      0)
    (=
      (be_facts.compiler-backend-outgoing-stack-arg-offset
        (be_state.CompilerBackendTarget.Windows)
        (Internal)
        1)
      8)
    (=
      (be_facts.compiler-backend-incoming-stack-arg-offset
        (be_state.CompilerBackendTarget.Windows)
        0)
      16)
    ;; A store-marked owner key compares equal to the plain one it was made
    ;; from -- every rule inside a call-free run reads it as the same mirror --
    ;; and only the call boundary tells them apart.
    (compiler-backend-owner-key-store-mark-ok?)))

(define (compiler-backend-scavenge-special-reg-bit-map-ok?) : bool
  (let
    [rax : i64 (be_operand.compiler-backend-scavenge-reg-bit "%rax")]
    [rsi : i64 (be_operand.compiler-backend-scavenge-reg-bit "%rsi")]
    [rdi : i64 (be_operand.compiler-backend-scavenge-reg-bit "%rdi")]
    (and
      (not (= rax 0))
      (not (= rsi 0))
      (not (= rdi 0))
      (not (= rax rsi))
      (not (= rax rdi))
      (not (= rsi rdi))
      (=
        (be_operand.compiler-backend-scavenge-reg-bit "%xmm2")
        (be_operand.compiler-backend-scavenge-reg-bit "%vec2"))
      (=
        (be_operand.compiler-backend-scavenge-reg-bit "%xmm3")
        (be_operand.compiler-backend-scavenge-reg-bit "%ymm3"))
      (=
        (be_operand.compiler-backend-scavenge-reg-bit "%xmm4")
        (be_operand.compiler-backend-scavenge-reg-bit "%zmm4"))
      (= (shl (cast 1 : i64) 15) rax)
      (= (shl (cast 1 : i64) 16) rsi)
      (= (shl (cast 1 : i64) 17) rdi))))

(define (compiler-backend-emergency-vector-width-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_init : unit
      (begin
        (be_state.compiler-backend-set-current-mode!
          (be_state.compiler-backend-state-function-state backend-state)
          (Avx2))
        (set-scratch-emergency-slot-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          -512)
        (be_operand.compiler-backend-emergency-add!
          (be_state.compiler-backend-state-function-state backend-state)
          "%xmm2"))]
    [avx2 : String
      (be_scalar.compiler-backend-emergency-wrap "    nop\n" backend-state)]
    [_avx512-init : unit
      (begin
        (be_state.compiler-backend-set-current-mode!
          (be_state.compiler-backend-state-function-state backend-state)
          (Avx512))
        (be_operand.compiler-backend-emergency-add!
          (be_state.compiler-backend-state-function-state backend-state)
          "%xmm3"))]
    [avx512 : String
      (be_scalar.compiler-backend-emergency-wrap "    nop\n" backend-state)]
    [ok : bool
      (and
        (= (be_scalar.compiler-backend-emergency-frame-extra 2) 128)
        (=
          (be_scalar.compiler-backend-emergency-reg-offset
            (be_state.compiler-backend-state-function-state backend-state)
            1)
          -576)
        (asm-has?
          avx2
          "    vmovdqu %ymm2, -512(%rbp)\n"
          "    vmovdqu -512(%rbp), %ymm2\n")
        (asm-has?
          avx512
          "    vmovdqu64 %zmm3, -512(%rbp)\n"
          "    vmovdqu64 -512(%rbp), %zmm3\n"))]
    ok))

(define (compiler-backend-scavenge-widened-pool-picks-rsi-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [regs : (__tl_dyn-array i64) (__tl_make-array i64 13)]
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 13)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 13)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (regalloc.compiler-reg-assignment-table-empty)]
    [picked : String ""]
    [ok : bool false]
    (set! (array-ref regs 0) cabi.compiler-reg-id-r9)
    (set! (array-ref regs 1) cabi.compiler-reg-id-rcx)
    (set! (array-ref regs 2) cabi.compiler-reg-id-rdx)
    (set! (array-ref regs 3) cabi.compiler-reg-id-r10)
    (set! (array-ref regs 4) cabi.compiler-reg-id-r11)
    (set! (array-ref regs 5) cabi.compiler-reg-id-r8)
    (set! (array-ref regs 6) cabi.compiler-reg-id-r12)
    (set! (array-ref regs 7) cabi.compiler-reg-id-r13)
    (set! (array-ref regs 8) cabi.compiler-reg-id-r14)
    (set! (array-ref regs 9) cabi.compiler-reg-id-r15)
    (set! (array-ref regs 10) cabi.compiler-reg-id-rbx)
    (set! (array-ref regs 11) cabi.compiler-reg-id-rdi)
    (set! (array-ref regs 12) cabi.compiler-reg-id-rax)
    (compiler-backend-test-fill-live-range! (&mut starts) (&mut ends) 13 0 10)
    (set! assignments (compiler-backend-test-reg-assignment-table-from regs 0))
    (set-scratch-emergency-pending!
      (be_state.compiler-backend-state-function-state backend-state)
      false)
    (set-scratch-emergency-used!
      (be_state.compiler-backend-state-function-state backend-state)
      false)
    (set-scratch-emergency-pending-count!
      (be_state.compiler-backend-state-function-state backend-state)
      0)
    (set-scratch-emergency-used-count!
      (be_state.compiler-backend-state-function-state backend-state)
      0)
    (set!
      picked
      (compiler-backend-scavenge-pick
        backend-state
        starts
        ends
        (regalloc.compiler-reg-assignment-table-with-min-capacity
          assignments
          13)
        13
        4
        (__tl_make-array String 0)
        0
        "%r8"))
    (set!
      ok
      (and
        (string.eq picked "%rsi")
        (not
          (scratch-emergency-pending
            (be_state.compiler-backend-state-function-state backend-state)))
        (not
          (scratch-emergency-used
            (be_state.compiler-backend-state-function-state backend-state)))
        (=
          (scratch-emergency-pending-count
            (be_state.compiler-backend-state-function-state backend-state))
          0)
        (=
          (scratch-emergency-used-count
            (be_state.compiler-backend-state-function-state backend-state))
          0)))
    ok))

(define (compiler-backend-scavenge-internal-rsi-rdi-plan-mask-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [rsi-bit : i64 (be_operand.compiler-backend-scavenge-reg-bit "%rsi")]
    [rdi-bit : i64 (be_operand.compiler-backend-scavenge-reg-bit "%rdi")]
    [linux-ok : bool false]
    [win64-ok : bool false]
    (set!
      linux-ok
      (and
        (be_operand.compiler-backend-scavenge-candidate-ok?
          (be_state.compiler-backend-state-function-state backend-state)
          0
          0
          0
          cabi.compiler-reg-id-rsi)
        (be_operand.compiler-backend-scavenge-candidate-ok?
          (be_state.compiler-backend-state-function-state backend-state)
          0
          0
          0
          cabi.compiler-reg-id-rdi)))
    (compiler-backend-set-current-fn-win64! backend-state)
    (set!
      win64-ok
      (and
        (be_operand.compiler-backend-scavenge-candidate-ok?
          (be_state.compiler-backend-state-function-state backend-state)
          0
          0
          0
          cabi.compiler-reg-id-rsi)
        (be_operand.compiler-backend-scavenge-candidate-ok?
          (be_state.compiler-backend-state-function-state backend-state)
          0
          0
          0
          cabi.compiler-reg-id-rdi)
        (not
          (be_operand.compiler-backend-scavenge-candidate-ok?
            (be_state.compiler-backend-state-function-state backend-state)
            rsi-bit
            0
            0
            cabi.compiler-reg-id-rsi))
        (not
          (be_operand.compiler-backend-scavenge-candidate-ok?
            (be_state.compiler-backend-state-function-state backend-state)
            rdi-bit
            0
            0
            cabi.compiler-reg-id-rdi))))
    (and linux-ok win64-ok)))

(define (compiler-backend-scratch-test-types-from [var : i64] [vars : i64]) : regalloc.CompilerRegVarTypes
  (if (>= var vars)
    (regalloc.compiler-reg-var-types-empty)
    (regalloc.compiler-reg-var-types-insert
      (compiler-backend-scratch-test-types-from (+ var 1) vars)
      var
      (I64))))

(define (compiler-backend-scavenge-emergency-respects-exclude-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r12")]
    [exclude : (__tl_dyn-array String)
      (compiler-backend-scavenge-emergency-exclude-fallback)]
    (set! (array-ref starts 0) 0)
    (set! (array-ref ends 0) 10)
    (set-scratch-emergency-pending!
      (be_state.compiler-backend-state-function-state backend-state)
      false)
    (set-scratch-emergency-used!
      (be_state.compiler-backend-state-function-state backend-state)
      false)
    (set-scratch-emergency-pending-count!
      (be_state.compiler-backend-state-function-state backend-state)
      0)
    (set-scratch-emergency-used-count!
      (be_state.compiler-backend-state-function-state backend-state)
      0)
    (let
      [reg : String
        (compiler-backend-scavenge-pick
          backend-state
          starts
          ends
          (regalloc.compiler-reg-assignment-table-with-min-capacity
            assignments
            1)
          1
          5
          exclude
          9
          "%r8")]
      [ok : bool
        (and
          (string.eq reg "%r12")
          (scratch-emergency-pending
            (be_state.compiler-backend-state-function-state backend-state))
          (=
            (scratch-emergency-reg
              (be_state.compiler-backend-state-function-state backend-state))
            cabi.compiler-reg-id-r12)
          (=
            (scratch-emergency-pending-count
              (be_state.compiler-backend-state-function-state backend-state))
            1)
          ;; T1-6 (b): the pick only ENQUEUES the borrowed register; where
          ;; it is saved (a free XMM register or a frame slot) is decided
          ;; when the bracketed text is known, so nothing is charged to the
          ;; frame yet.
          (=
            (scratch-emergency-used-count
              (be_state.compiler-backend-state-function-state backend-state))
            0)
          (not
            (scratch-emergency-used
              (be_state.compiler-backend-state-function-state backend-state)))
          ;; Forcing the slot form (what every inline-restore path does)
          ;; charges exactly one emergency slot.
          (begin
            (be_scalar.compiler-backend-emergency-commit-slot-form!
              (be_state.compiler-backend-state-function-state backend-state))
            (and
              (scratch-emergency-used
                (be_state.compiler-backend-state-function-state backend-state))
              (=
                (scratch-emergency-used-count
                  (be_state.compiler-backend-state-function-state backend-state))
                1))))]
      (set-scratch-emergency-pending!
        (be_state.compiler-backend-state-function-state backend-state)
        false)
      (set-scratch-emergency-used!
        (be_state.compiler-backend-state-function-state backend-state)
        false)
      (set-scratch-emergency-pending-count!
        (be_state.compiler-backend-state-function-state backend-state)
        0)
      (set-scratch-emergency-used-count!
        (be_state.compiler-backend-state-function-state backend-state)
        0)
      ok)))

(define (compiler-backend-scavenge-occupancy-cache-point-ok?
  [masks : (& masks (__tl_dyn-array i64))]
  [starts : (& starts (__tl_dyn-array i64))]
  [ends : (& ends (__tl_dyn-array i64))]
  [assignment-index : regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [point : i64]) : bool
  (let
    [idx : i64 (/ point 2)]
    [cached : i64
      (if (and (>= idx 0) (< idx (array-length masks)))
        (array-ref masks idx)
        0)]
    [scanned : i64
      (compiler-backend-scavenge-occupied-mask-for-instr
        starts
        ends
        assignment-index
        vars
        point)]
    (= cached scanned)))

(define (compiler-backend-emit-current-count-gate-ok?) : bool
  (and
    (not (backend.compiler-backend-emit-needs-current-count? 0 0 (Scalar)))
    (not (backend.compiler-backend-emit-needs-current-count? 0 0 (Avx512)))
    (backend.compiler-backend-emit-needs-current-count? 1 0 (Scalar))
    (backend.compiler-backend-emit-needs-current-count? 0 1 (Scalar))
    ;; AVX2 predicated-store labels are position-keyed even without register
    ;; homes or const-hoist sites.
    (backend.compiler-backend-emit-needs-current-count? 0 0 (Avx2))))

;; Reduced from integration_spmd_gather_read/fill-lane-offset-gather at opt2:
;; the entry compares two incoming parameters, the saving frontier is a
;; non-phi preheader, and the loop phi carries the guard's start parameter.
(define (compiler-backend-shrinkwrap-param-phi-fixture) : ir.CompilerIrFunction
  (irt.func
    "function @early_exit_param_phi(start=%0:i64, end=%1:i64) -> unit vars 6 {
     entry:
       %2 = lt %0, %1 : i64
       branch %2, preheader, exit
     preheader:
       jump loop
     loop:
       %3 = phi [%0, preheader], [%4, loop] : i64
       %4 = add %3, 1 : i64
       %5 = lt %4, %1 : i64
       branch %5, loop, exit
     exit:
       return
     }"))

;; A region's free candidate registers go to the constants with the most static
;; sites, because each hoisted site drops one in-region constant load. The
;; forcing case is a leaf loop holding a single-site wide literal and a
;; multi-site divmod magic: program order would hand the only free register to
;; the literal, so the magic would reload its `movabsq` at every site on every
;; iteration. `values`/`wide` carry six entries -- literal L (one site, written
;; FIRST), magic M (three sites), magic N (two sites) -- so the award sequence
;; must be M, N, L even though L occurs first.
(define (compiler-backend-const-hoist-award-weight-ok?) : bool
  (let
    [values : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [wide : (__tl_dyn-array bool) (__tl_make-array bool 6)]
    [order : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [tally : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [_fill : unit
      (begin
        ;; index 0: wide literal L, one site
        (set! (array-ref values 0) 4242)
        (set! (array-ref wide 0) true)
        ;; indices 1,3,5: magic M, three sites
        (set! (array-ref values 1) 777)
        (set! (array-ref wide 1) false)
        (set! (array-ref values 3) 777)
        (set! (array-ref wide 3) false)
        (set! (array-ref values 5) 777)
        (set! (array-ref wide 5) false)
        ;; indices 2,4: magic N, two sites
        (set! (array-ref values 2) 999)
        (set! (array-ref wide 2) false)
        (set! (array-ref values 4) 999)
        (set! (array-ref wide 4) false))]
    [awards : i64
      (be_scalar.compiler-backend-const-hoist-award-order!
        values
        wide
        6
        (&mut order)
        (&mut tally))]
    (and
      ;; three distinct (value, wide?) keys, not six entries
      (= awards 3)
      ;; heaviest first: M (3 sites) then N (2) then L (1)
      (= (array-ref order 0) 1)
      (= (array-ref tally 0) 3)
      (= (array-ref order 1) 2)
      (= (array-ref tally 1) 2)
      (= (array-ref order 2) 0)
      (= (array-ref tally 2) 1))))

;; The dedup key is (value, wide?), so the same literal counts separately as a
;; wide-binop constant and as a divmod magic; and equal site counts award in
;; program order, which keeps the emitted plan a total order with no dependence
;; on any map's iteration order. Entries: value 5 as WIDE at 0 and 3, value 5 as
;; NON-wide at 1 and 4, value 6 as non-wide at 2 and 5 -- three keys, two sites
;; each, so the result must be exactly their first-occurrence order 0, 1, 2.
(define (compiler-backend-const-hoist-award-tie-ok?) : bool
  (let
    [values : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [wide : (__tl_dyn-array bool) (__tl_make-array bool 6)]
    [order : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [tally : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [_fill : unit
      (begin
        (set! (array-ref values 0) 5)
        (set! (array-ref wide 0) true)
        (set! (array-ref values 3) 5)
        (set! (array-ref wide 3) true)
        (set! (array-ref values 1) 5)
        (set! (array-ref wide 1) false)
        (set! (array-ref values 4) 5)
        (set! (array-ref wide 4) false)
        (set! (array-ref values 2) 6)
        (set! (array-ref wide 2) false)
        (set! (array-ref values 5) 6)
        (set! (array-ref wide 5) false))]
    [awards : i64
      (be_scalar.compiler-backend-const-hoist-award-order!
        values
        wide
        6
        (&mut order)
        (&mut tally))]
    (and
      (= awards 3)
      (= (array-ref order 0) 0)
      (= (array-ref order 1) 1)
      (= (array-ref order 2) 2)
      (= (array-ref tally 0) 2)
      (= (array-ref tally 1) 2)
      (= (array-ref tally 2) 2)
      ;; An empty region awards nothing and reads no scratch entry.
      (=
        (be_scalar.compiler-backend-const-hoist-award-order!
          values
          wide
          0
          (&mut order)
          (&mut tally))
        0)
      ;; A single site is one key of weight one.
      (=
        (be_scalar.compiler-backend-const-hoist-award-order!
          values
          wide
          1
          (&mut order)
          (&mut tally))
        1)
      (= (array-ref tally 0) 1))))

;; Both Internal conventions admit the same volatile RSI/RDI/R8/R9 subset
;; and the RBX frame-home fallback.
(define (compiler-backend-const-hoist-candidates-abi-ok?) : bool
  (and
    (=
      (regalloc.compiler-reg-id-seq-count
        (be_scalar.compiler-backend-const-hoist-candidate-regs
          (be_state.CompilerBackendTarget.Linux)))
      5)
    (regalloc.compiler-reg-id-seq-contains?
      (be_scalar.compiler-backend-const-hoist-candidate-regs
        (be_state.CompilerBackendTarget.Linux))
      cabi.compiler-reg-id-rsi)
    (regalloc.compiler-reg-id-seq-contains?
      (be_scalar.compiler-backend-const-hoist-candidate-regs
        (be_state.CompilerBackendTarget.Linux))
      cabi.compiler-reg-id-rdi)
    (regalloc.compiler-reg-id-seq-contains?
      (be_scalar.compiler-backend-const-hoist-candidate-regs
        (be_state.CompilerBackendTarget.Linux))
      cabi.compiler-reg-id-r8)
    (regalloc.compiler-reg-id-seq-contains?
      (be_scalar.compiler-backend-const-hoist-candidate-regs
        (be_state.CompilerBackendTarget.Linux))
      cabi.compiler-reg-id-r9)
    (regalloc.compiler-reg-id-seq-contains?
      (be_scalar.compiler-backend-const-hoist-candidate-regs
        (be_state.CompilerBackendTarget.Linux))
      cabi.compiler-reg-id-rbx)
    (=
      (regalloc.compiler-reg-id-seq-count
        (be_scalar.compiler-backend-const-hoist-candidate-regs
          (be_state.CompilerBackendTarget.Windows)))
      5)
    (regalloc.compiler-reg-id-seq-contains?
      (be_scalar.compiler-backend-const-hoist-candidate-regs
        (be_state.CompilerBackendTarget.Windows))
      cabi.compiler-reg-id-r8)
    (regalloc.compiler-reg-id-seq-contains?
      (be_scalar.compiler-backend-const-hoist-candidate-regs
        (be_state.CompilerBackendTarget.Windows))
      cabi.compiler-reg-id-r9)
    (regalloc.compiler-reg-id-seq-contains?
      (be_scalar.compiler-backend-const-hoist-candidate-regs
        (be_state.CompilerBackendTarget.Windows))
      cabi.compiler-reg-id-rbx)
    (regalloc.compiler-reg-id-seq-contains?
      (be_scalar.compiler-backend-const-hoist-candidate-regs
        (be_state.CompilerBackendTarget.Windows))
      cabi.compiler-reg-id-rsi)
    (regalloc.compiler-reg-id-seq-contains?
      (be_scalar.compiler-backend-const-hoist-candidate-regs
        (be_state.CompilerBackendTarget.Windows))
      cabi.compiler-reg-id-rdi)))

;; Regression for the opt1-built compiler crash exposed by
;; integration_spmd_gather_read/fill-lane-offset-gather. The reduced IR keeps
;; its entry guard -> non-phi preheader -> parameter-fed loop phi shape. A
;; previous scratch-arena function may leave a nonzero const-hoist count backed
;; by retired storage; shrink-wrap admission must reject that state until the
;; per-function preparation has established an empty table.
(define (compiler-backend-shrinkwrap-admission-state-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [stale-regs : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    (set-scratch-const-hoist-site-count!
      (be_state.compiler-backend-state-function-state backend-state)
      1)
    (set-scratch-const-hoist-site-regs!
      (be_state.compiler-backend-state-function-state backend-state)
      stale-regs)
    (set-scratch-const-hoist-inject-count!
      (be_state.compiler-backend-state-function-state backend-state)
      1)
    (set-scratch-const-hoist-frame-rbx!
      (be_state.compiler-backend-state-function-state backend-state)
      true)
    (set-scratch-const-hoist-frame-count!
      (be_state.compiler-backend-state-function-state backend-state)
      1)
    (let
      [dirty-rejected? : bool
        (not
          (be_scalar.compiler-backend-shrinkwrap-admission-state-clean?
            (be_state.compiler-backend-state-function-state backend-state)))]
      [prepared? : bool
        (be_scalar.compiler-backend-prepare-shrinkwrap-admission!
          (be_state.compiler-backend-state-function-state backend-state))]
      [rewritten : ir.CompilerIrFunction
        (regalloc.compiler-reg-early-exit-shrinkwrap-function
          (compiler-backend-shrinkwrap-param-phi-fixture))]
      (and
        dirty-rejected?
        prepared?
        (be_scalar.compiler-backend-shrinkwrap-admission-state-clean?
          (be_state.compiler-backend-state-function-state backend-state))
        (not
          (be_operand.compiler-backend-callee-needs-save?
            backend-state
            (regalloc.compiler-reg-assignment-table-empty)
            cabi.compiler-reg-id-rbx))
        (= regalloc.compiler-reg-early-exit-prefix-count 2)
        (match rewritten
          [(Function _ _ _ _ blocks _)
            (let
              [seq : ir.CompilerIrBlockSeq
                (compiler_liveness.compiler-live-ir-block-list-to-seq
                  (& blocks))]
              (and
                (= (ir.compiler-ir-block-seq-count seq) 6)
                (match (ir.compiler-ir-block-seq-borrow seq 0)
                  [(Block _ instrs)
                    (match (ir.compiler-ir-instr-seq-borrow instrs 1)
                      [(Branch _ yes no)
                        (and
                          (=
                            yes
                            (ir.compiler-ir-label "entry__shrinkwrap_save"))
                          (=
                            no
                            (ir.compiler-ir-label "entry__shrinkwrap_bare0")))]
                      [_ false])])
                (match (ir.compiler-ir-block-seq-borrow seq 4)
                  [(Block label instrs)
                    (and
                      (= label (ir.compiler-ir-label "loop"))
                      (match (ir.compiler-ir-instr-seq-ref instrs 0)
                        [(Phi _ inputs _)
                          (let
                            [phi-inputs-at-49077-29 : ir.CompilerIrPhiInputSeq
                              inputs]
                            (if (<= phi-inputs-at-49077-29.len 0)
                              false
                              (let
                                [phi-input-at-49077-29
                                  (ir.compiler-ir-phi-input-seq-borrow
                                    phi-inputs-at-49077-29
                                    0)]
                                [value : ir.CompilerIrValue
                                  phi-input-at-49077-29.value]
                                [input-label : i64 phi-input-at-49077-29.label]
                                (and
                                  (=
                                    input-label
                                    (ir.compiler-ir-label "preheader"))
                                  (match value
                                    [(Var id) (= id 0)]
                                    [_ false])))))]
                        [_ false]))])))])))))

;; Win64 passes the third integer argument in %r8. A non-imm32 guard that
;; scavenged %r8 before the prologue would return that clobbered register on
;; the bare path, so scratch-requiring prefixes must fail closed to the ordinary
;; always-framed function until prefix emission has a dedicated live-in-aware
;; scratch plan.
(define compiler-backend-shrinkwrap-large-guard-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define (guard-large [x : i64] [unused : i64] [bare-result : i64]) : i64
  (if (= x 4294967296)
    bare-result
    (guard-large (opaque x) unused bare-result)))
(define (main) : i64 (guard-large (opaque 1) 7 42))")

(define (compiler-backend-shrinkwrap-large-guard-win64-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-shrinkwrap-large-guard-source))
    (be_state.CompilerBackendTarget.Windows))
    [(Ok asm)
      (let
        [body : String
          (compiler-backend-asm-function-body asm "_tl_guard_large")]
        (and
          (not (string.eq body ""))
          (asm-has? body "4294967296")
          (asm-lacks? body "__shrinkwrap")))]
    [(Err _) false]))

;; C40 early-return guard flip. At -O2 on Linux each form (a) guard falls
;; through to the next guard or the saving block, and the bare-return clones
;; move after the function's last block. -Os and Win64 keep the bare clones
;; inline ahead of the saving block, and so does a guard whose early return
;; the opcode heuristic predicts taken.
(define compiler-backend-shrinkwrap-flip-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define (flip-guards [a : i64] [b : i64] [c : i64] [d : i64]) : i64
  (if (>= a b)
    1
    (if (< c d)
      (+ (opaque a) (opaque (opaque c)))
      0)))
(define (main) : i64 (flip-guards (opaque 1) 2 3 4))")

;; `x > 0` predicts its TRUE arm, here the early return.
(define compiler-backend-shrinkwrap-flip-veto-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define (flip-veto [x : i64] [y : i64]) : i64
  (if (> x 0)
    y
    (+ (opaque x) (opaque (opaque y)))))
(define (main) : i64 (flip-veto (opaque 1) 2))")

(define (compiler-backend-shrinkwrap-flip-body
  [source : (& source str)]
  [target : be_state.CompilerBackendTarget]
  [size? : bool]
  [symbol : String]) : String
  (match (compiler-backend-emit-source-opt2-sized
    (string.copy source)
    target
    true
    size?)
    [(Ok asm) (compiler-backend-asm-function-body asm symbol)]
    [(Err _) ""]))

;; Flipped: the bare clones come after the saving block, which no guard jumps
;; to. Otherwise every bare clone comes before it.
(define (compiler-backend-shrinkwrap-flip-shape?
  [body : String]
  [flipped? : bool]) : bool
  (let
    [save : i64
      (backend.compiler-backend-string-find-from body "__shrinkwrap_save:\n" 0)]
    [first-bare : i64
      (backend.compiler-backend-string-find-from body "__shrinkwrap_bare0:\n" 0)]
    [after-save : i64
      (if (< save 0)
        -1
        (backend.compiler-backend-string-find-from
          body
          "__shrinkwrap_bare"
          save))]
    (and
      (>= save 0)
      (>= first-bare 0)
      (if flipped?
        (and (> first-bare save) (asm-lacks? body "__shrinkwrap_save\n"))
        (and (< first-bare save) (< after-save 0))))))

(define (compiler-backend-shrinkwrap-flip-ok?) : bool
  (let
    [linux : String
      (compiler-backend-shrinkwrap-flip-body
        (& compiler-backend-shrinkwrap-flip-source)
        (be_state.CompilerBackendTarget.Linux)
        false
        "_tl_flip_guards")]
    [veto : String
      (compiler-backend-shrinkwrap-flip-body
        (& compiler-backend-shrinkwrap-flip-veto-source)
        (be_state.CompilerBackendTarget.Linux)
        false
        "_tl_flip_veto")]
    [win64 : String
      (compiler-backend-shrinkwrap-flip-body
        (& compiler-backend-shrinkwrap-flip-source)
        (be_state.CompilerBackendTarget.Windows)
        false
        "_tl_flip_guards")]
    [size : String
      (compiler-backend-shrinkwrap-flip-body
        (& compiler-backend-shrinkwrap-flip-source)
        (be_state.CompilerBackendTarget.Linux)
        true
        "_tl_flip_guards")]
    (and
      (compiler-backend-shrinkwrap-flip-shape? linux true)
      (compiler-backend-shrinkwrap-flip-shape? veto false)
      (compiler-backend-shrinkwrap-flip-shape? win64 false)
      (compiler-backend-shrinkwrap-flip-shape? size false))))

;; ---------------------------------------------------------------------------
;; SW-1: general shrink-wrapping.  The placement is decided on the FINAL emitted
;; text, so every one of these reads the emitted function body.
;;
;; "Sunk" is spelled as a structural property of that body rather than as a line
;; match: an entry-placed prologue is the first thing after the function symbol,
;; so the body starts with `pushq`/`subq`; a shrink-wrapped one starts with the
;; entry BLOCK label, the prologue appears later, and some `ret` returns
;; without it.
(define (compiler-backend-swb-find [body : (& body str)] [needle : String]) : i64
  (backend.compiler-backend-string-find-from body needle 0))

;; The first prologue instruction: a callee-saved push, or the frame's own
;; `%rsp` adjust.  Any later `, %rsp` line is the matching epilogue, so the
;; minimum of the two is the prologue.
(define (compiler-backend-swb-prologue-index [body : (& body str)]) : i64
  (let
    [push : i64 (compiler-backend-swb-find body "    pushq %")]
    [rsp : i64 (compiler-backend-swb-find body ", %rsp\n")]
    (cond [(< push 0) rsp] [(< rsp 0) push] [(< push rsp) push] [else rsp])))

;; A `ret` no epilogue precedes -- neither a callee-saved `popq`, the frame's
;; own `%rsp` adjust, nor a framed `leave` -- returns from a path that never
;; built the frame.
(define (compiler-backend-swb-count-bare-ret [body : (& body str)]) : i64
  (let
    [i : i64 0]
    [seen : i64 0]
    [done : bool false]
    (while (not done)
      (let
        [at : i64
          (backend.compiler-backend-string-find-from body "    ret\n" i)]
        (if (< at 0)
          (set! done true)
          (begin
            (unless
              (or
                (and
                  (>= at 7)
                  (be_operand.compiler-backend-string-prefix-at?
                    body
                    ", %rsp\n"
                    (- at 7)))
                (and
                  (>= at 14)
                  (be_operand.compiler-backend-string-prefix-at?
                    body
                    "    popq %"
                    (- at 14)))
                (and
                  (>= at 10)
                  (be_operand.compiler-backend-string-prefix-at?
                    body
                    "    leave\n"
                    (- at 10))))
              (+= seen 1))
            (set! i (+ at 1))))))
    seen))

;; The prologue sank: the body opens with a block label (not the prologue), the
;; prologue follows, and at least one `ret` returns without it. Where that bare
;; exit is laid out is the block layout's business: a cold one sinks below the
;; body, so its `ret` need not come before the prologue in the text.
(define (compiler-backend-swb-sunk? [body : (& body str)]) : bool
  (let
    [prologue : i64 (compiler-backend-swb-prologue-index body)]
    (and
      (not (string.eq body ""))
      (be_operand.compiler-backend-string-prefix-at? body ".L" 0)
      (>= prologue 0)
      (> (compiler-backend-swb-count-bare-ret body) 0))))

(define (compiler-backend-swb-entry-placed? [body : (& body str)]) : bool
  (and
    (not (string.eq body ""))
    (not (be_operand.compiler-backend-string-prefix-at? body ".L" 0))))

(define (compiler-backend-swb-body-for
  [source : String]
  [target : be_state.CompilerBackendTarget]
  [symbol : String]) : String
  (match (compiler-backend-emit-source-opt2-for-target source target)
    [(Ok asm) (compiler-backend-asm-function-body asm symbol)]
    [(Err _) ""]))

;; (1) The `table_invalidate_var` shape: the early exit is guarded by a GLOBAL
;; load, so form (a) -- which admits only compares on parameters and constants --
;; cannot fire.  The general placement must: the entry block returns bare and
;; the prologue sits in the calling block.
(define compiler-backend-swb-global-guard-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define swb-table-len : i64 0)
(define (swb-invalidate [var : i64]) : i64
  (if (= swb-table-len 0)
    0
    (+ (opaque 1) (opaque 2))))
(define keep-invalidate : (-> i64 i64) swb-invalidate)
(define (main) : i64
  (begin
    (set! swb-table-len (opaque 7))
    (swb-invalidate 3)))")

(define (compiler-backend-swb-global-guard-ok?) : bool
  (let
    [body : String
      (compiler-backend-swb-body-for
        (string.copy (& compiler-backend-swb-global-guard-source))
        (be_state.CompilerBackendTarget.Linux)
        "_tl_swb_invalidate")]
    (and
      (compiler-backend-swb-sunk? body)
      ;; Form (a) is not what fired: its rewrite renames the bypass blocks.
      (asm-lacks? body "__shrinkwrap"))))

;; (2) The `kinds_remove` shape: a parameter compare (form (a)'s only shape)
;; followed by a second early exit that compares against a loaded global.  Form
;; (a) fires on the first exit; the general form must sink the prologue past the
;; second, so both exits return without it.
(define compiler-backend-swb-two-exit-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define swb-limit : i64 0)
(define (swb-remove [k : i64]) : i64
  (if (< k 0)
    0
    (if (>= k swb-limit)
      0
      (+ (opaque 1) (opaque 2)))))
(define keep-remove : (-> i64 i64) swb-remove)
(define (main) : i64
  (begin
    (set! swb-limit (opaque 7))
    (swb-remove 3)))")

(define (compiler-backend-swb-two-exit-ok?) : bool
  (let
    [body : String
      (compiler-backend-swb-body-for
        (string.copy (& compiler-backend-swb-two-exit-source))
        (be_state.CompilerBackendTarget.Linux)
        "_tl_swb_remove")]
    (and
      (compiler-backend-swb-sunk? body)
      (>= (compiler-backend-swb-count-bare-ret body) 2))))

;; (3) The `dispatch` shape: two tail-call arms that need no frame and one arm
;; that calls.  The arms are SIBLINGS, so the nearest common dominator of the
;; frame's uses is the entry itself and no single Save/Restore pair can serve
;; them (the same limitation LLVM's ShrinkWrap has: one pair per function).
;; Entry placement is the correct, documented answer -- the alternative would
;; be a region split.
(define compiler-backend-swb-dispatch-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define (swb-step-a [x : i64]) : i64 (opaque (+ x 1)))
(define (swb-step-b [x : i64]) : i64 (opaque (+ x 2)))
(define keep-a : (-> i64 i64) swb-step-a)
(define keep-b : (-> i64 i64) swb-step-b)
(define (swb-dispatch [k : i64] [x : i64]) : i64
  (if (= k 0)
    (swb-step-a x)
    (if (= k 1)
      (swb-step-b x)
      (+ (opaque x) (opaque 9)))))
(define keep-dispatch : (-> i64 i64 i64) swb-dispatch)
(define (main) : i64 (swb-dispatch (opaque 0) 1))")

(define (compiler-backend-swb-dispatch-ok?) : bool
  (compiler-backend-swb-entry-placed?
    (compiler-backend-swb-body-for
      (string.copy (& compiler-backend-swb-dispatch-source))
      (be_state.CompilerBackendTarget.Linux)
      "_tl_swb_dispatch")))

;; (4) A frame slot referenced in the entry block. The fourteen entry-computed
;; values outlive the calls in the second arm, so the allocator spills several
;; and the entry block STORES them. Those stores are frame references, the entry
;; is in U, and the placement must stay at entry.
(define compiler-backend-swb-entry-slot-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define swb-flag : i64 0)
(define (swb-entry-slot [x : i64]) : i64
  (let
    [t0 : i64 (* x 3)]
    [t1 : i64 (* x 5)]
    [t2 : i64 (* x 7)]
    [t3 : i64 (* x 11)]
    [t4 : i64 (* x 13)]
    [t5 : i64 (* x 17)]
    [t6 : i64 (* x 19)]
    [t7 : i64 (* x 23)]
    [t8 : i64 (* x 29)]
    [t9 : i64 (* x 31)]
    [ta : i64 (* x 37)]
    [tb : i64 (* x 41)]
    [tc : i64 (* x 43)]
    [td : i64 (* x 47)]
    (if (= swb-flag 0)
      (+ t0 (+ t1 (+ t2 (+ t3 (+ t4 (+ t5 (+ t6 t7)))))))
      (+
        (opaque t0)
        (+
          (opaque t1)
          (+
            (opaque t2)
            (+
              (opaque t3)
              (+
                (opaque t4)
                (+
                  (opaque t5)
                  (+
                    (opaque t6)
                    (+
                      (opaque t7)
                      (+
                        (opaque t8)
                        (+
                          (opaque t9)
                          (+
                            (opaque ta)
                            (+ (opaque tb) (+ (opaque tc) (opaque td)))))))))))))))))
(define keep-entry-slot : (-> i64 i64) swb-entry-slot)
(define (main) : i64
  (begin
    (set! swb-flag (opaque 7))
    (swb-entry-slot 3)))")

(define (compiler-backend-swb-entry-slot-ok?) : bool
  (let
    [body : String
      (compiler-backend-swb-body-for
        (string.copy (& compiler-backend-swb-entry-slot-source))
        (be_state.CompilerBackendTarget.Linux)
        "_tl_swb_entry_slot")]
    (and
      (compiler-backend-swb-entry-placed? body)
      ;; The premise of the test: the entry really does name the frame.
      (asm-has? body "(%rsp)"))))

;; (5) The only call is inside a loop. Save must land on the loop's depth-0
;; dominator -- the preheader the guard branches to -- and never on the loop
;; header, which would re-run the prologue on every iteration.
(define compiler-backend-swb-loop-call-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define swb-n : i64 0)
(define (swb-loop [x : i64]) : i64
  (if (= swb-n 0)
    0
    (let
      [i : i64 0]
      [acc : i64 0]
      (begin
        (while (< i 4)
          (begin
            (set! acc (+ acc (opaque i)))
            (set! i (+ i 1))))
        acc))))
(define keep-loop : (-> i64 i64) swb-loop)
(define (main) : i64
  (begin
    (set! swb-n (opaque 7))
    (swb-loop 3)))")

(define (compiler-backend-swb-loop-call-ok?) : bool
  (let
    [body : String
      (compiler-backend-swb-body-for
        (string.copy (& compiler-backend-swb-loop-call-source))
        (be_state.CompilerBackendTarget.Linux)
        "_tl_swb_loop")]
    [prologue : i64 (compiler-backend-swb-prologue-index body)]
    [loop-label : i64 (compiler-backend-swb-find body "_while_")]
    (and
      (compiler-backend-swb-sunk? body)
      (>= loop-label 0)
      (< prologue loop-label))))

;; The duplicated tail is the LAST block of the body, so everything after its
;; label is the clone.  It has to return, and it may not carry any part of the
;; epilogue: on the bypass there is no prologue to undo.
(define (compiler-backend-swb-clone-before-prologue? [body : (& body str)]) : bool
  (let
    [prologue : i64 (compiler-backend-swb-prologue-index body)]
    [guard : i64 (compiler-backend-swb-find body "__swb_tail\n")]
    (and
      (not (string.eq body ""))
      (be_operand.compiler-backend-string-prefix-at? body ".L" 0)
      (>= guard 0)
      (>= prologue 0)
      (< guard prologue))))

(define (compiler-backend-swb-clone-bare? [body : String]) : bool
  (let
    [at : i64 (compiler-backend-swb-find body "__swb_tail:\n")]
    (if (< at 0)
      false
      (let
        [clone : String
          (string.substring body at (- (string.string-length body) at))]
        (and
          (asm-has? clone "    ret\n")
          (asm-lacks? clone ", %rsp\n" "    popq "))))))

;; (6) TD-1. A bypass path and a framed path MERGE before the return, so the
;; return tail has a predecessor the Save does not dominate.  Before TD-1 that
;; was a refusal (the region would not be single-entry); now the bypass edge is
;; retargeted to its own copy of the tail and the placement is well formed.
;;
;; This is also the answer to "what happens when the outside predecessor needs
;; a phi value": it DUPLICATES, and duplicates correctly.  By the time SW-1
;; reads the text the phi is already resolved into a register the predecessors
;; write, so the copy of `(+ r 5)` is exact; a tail that instead named the frame
;; or a callee-saved register carries the frame flag and is refused by
;; `compiler-backend-swb-dup-candidate?` before it is ever copied.
(define compiler-backend-swb-merge-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define swb-m : i64 0)
(define (swb-merge [x : i64]) : i64
  (let
    [r : i64 0]
    (begin
      (if (= swb-m 0)
        (set! r 1)
        (set! r (+ (opaque 1) (opaque 2))))
      (+ r 5))))
(define keep-merge : (-> i64 i64) swb-merge)
(define (main) : i64
  (begin
    (set! swb-m (opaque 7))
    (swb-merge 3)))")

(define (compiler-backend-swb-merge-ok?) : bool
  (let
    [body : String
      (compiler-backend-swb-body-for
        (string.copy (& compiler-backend-swb-merge-source))
        (be_state.CompilerBackendTarget.Linux)
        "_tl_swb_merge")]
    (and
      ;; A duplicated tail's bypass returns through the clone, which sits at the
      ;; END of the body -- so the placement is witnessed by the guard reaching
      ;; the clone before the prologue, not by a `ret` before it.
      (compiler-backend-swb-clone-before-prologue? body)
      ;; The tail's own computation is reproduced in the clone ...
      (asm-has? body "__swb_tail:\n    addq $5, %rax\n    ret\n")
      ;; ... and a framed return still tears the frame down.
      (asm-has? body ", %rsp\n    ret\n")
      (compiler-backend-swb-clone-bare? body))))

;; (6c) The duplication's bound, tested on the copier directly.  A tail whose
;; body is data plus the trailing jump to the shared epilogue is reproduced with
;; a bare `ret`; a tail carrying any OTHER branch is refused, because copying it
;; would send the bypass into code the prologue never ran for.
(define (compiler-backend-swb-dup-tail-body-for
  [text : String]
  [return-label : String]
  [ok : (&mut ok (__tl_dyn-array i64))]) : String
  (let
    [data : (Ptr u8)
      (unsafe
        (string-data text))]
    (backend.compiler-backend-swb-dup-tail-body
      text
      data
      0
      (string.string-length text)
      return-label
      ok)))

(define (compiler-backend-swb-dup-tail-bound-ok?) : bool
  (let
    [good : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [bad : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [plain : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [_init : unit
      (begin
        (set! (array-ref good 0) 1)
        (set! (array-ref bad 0) 1)
        (set! (array-ref plain 0) 1))]
    [good-text : String
      (compiler-backend-swb-dup-tail-body-for
        "    movq $7, %rax\n    jmp .Lret\n"
        ".Lret"
        (&mut good))]
    [_bad-text : String
      (compiler-backend-swb-dup-tail-body-for
        "    movq $7, %rax\n    jne .Lelsewhere\n    jmp .Lret\n"
        ".Lret"
        (&mut bad))]
    [plain-text : String
      (compiler-backend-swb-dup-tail-body-for
        "    movq $7, %rax\n    addq $8, %rsp\n    ret\n"
        ".Lret"
        (&mut plain))]
    (and
      ;; The trailing jump to the shared epilogue is dropped, the data kept.
      (= (array-ref good 0) 1)
      (string.eq good-text "    movq $7, %rax\n")
      ;; A branch that is not that jump refuses the whole duplication.
      (= (array-ref bad 0) 0)
      ;; An inline epilogue is stripped: only the pre-epilogue body is copied.
      (= (array-ref plain 0) 1)
      (string.eq plain-text "    movq $7, %rax\n"))))

;; (6d) The splice itself: each recorded offset gets the clone's label suffix,
;; and the clone is appended once, after everything else.
(define (compiler-backend-swb-apply-dup-ok?) : bool
  (let
    [sites : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [text : String ".Le:\n    jl .Lt\n.Lt:\n    jmp .Lt\n"]
    [_sites : unit
      (begin
        (set! (array-ref sites 0) 15)
        (set! (array-ref sites 1) 32))]
    [out : String
      (backend.compiler-backend-swb-apply-dup
        text
        sites
        2
        ".Lt__swb_tail:\n    ret\n")]
    (string.eq
      out
      ".Le:\n    jl .Lt__swb_tail\n.Lt:\n    jmp .Lt__swb_tail\n.Lt__swb_tail:\n    ret\n")))

;; ---------------------------------------------------------------------------
;; SWB-FIX-1: the general placement may never sit above form (a)'s frontier.
;;
;; Form (a) mints `<entry>__shrinkwrap_bare<N>` return clones that the backend
;; renders as an UNCONDITIONAL bare `ret`, and a `<entry>__shrinkwrap_save`
;; block that is the single entry of its framed body.  A form (a) guard that
;; compares an incoming argument register whose parameter has a callee-saved
;; home names a register the saving prologue reads, so the guard joins U and
;; the general form's S can land ON that guard -- strictly above form (a)'s
;; frontier.  Every bare clone at or below S then pops nothing.
;;
;; These fixtures drive `compiler-backend-swb-plan-for` on emitted text
;; directly, so the refusal is pinned independently of any allocator decision
;; that happens to hide the shape today.
(define compiler-backend-swb-fix-prologue-source : String
  "    pushq %r12\n    movq %r8, %r12\n")

(define (compiler-backend-swb-fix-prologue-mask) : i64
  (let
    [text (string.copy (& compiler-backend-swb-fix-prologue-source))]
    (backend.compiler-backend-swb-text-reg-mask text)))

(define (compiler-backend-swb-fix-block-list [labels : (__tl_dyn-array i64)]) : ir.CompilerIrBlockList
  (let
    [out : ir.CompilerIrBlockList (ir.compiler-ir-block-list-empty)]
    [i : i64 (array-length labels)]
    (while (> i 0)
      (-= i 1)
      (set!
        out
        (ir.compiler-ir-blocks-with-tail
          out
          (ir.CompilerIrBlock.Block
            (array-ref labels i)
            (ir.compiler-ir-instr-seq-empty)))))
    out))

;; The four-label variant-(ii) shape and the five-label variant-(i) shape share
;; this driver: build the IR block list whose labels are the text's, in text
;; order, and ask for a plan under the given form (a) saving label.
(define (compiler-backend-swb-fix-plan-for
  [text : String]
  [scope : String]
  [return-label : String]
  [labels : (__tl_dyn-array i64)]
  [form-a-saving-label : i64]) : backend.CompilerBackendSwbPlan
  (backend.compiler-backend-swb-plan-for
    text
    scope
    return-label
    (compiler-backend-swb-fix-prologue-mask)
    form-a-saving-label
    (compiler-backend-swb-fix-block-list labels)))

;; A bare return and an edge to the shared epilogue both read ABI result
;; registers implicitly.  The entry guard deliberately names none of the
;; prologue registers, so only that implicit use can keep the parameter-home
;; move before the early return.  An unrelated home still permits placement.
(define (compiler-backend-swb-implicit-return-plan
  [shared : bool]
  [prologue-mask : i64]) : backend.CompilerBackendSwbPlan
  (backend.compiler-backend-swb-plan-for
    (if shared
      ".Lswbimplicit_entry:\n    cmpq 8(%rsi), %rcx\n    jge .Lswbimplicit_early\n.Lswbimplicit_body:\n    callq _tl_swbfix_opaque\n    jmp .Lswbimplicit_ret\n.Lswbimplicit_early:\n    jmp .Lswbimplicit_ret\n"
      ".Lswbimplicit_entry:\n    cmpq 8(%rsi), %rcx\n    jge .Lswbimplicit_early\n.Lswbimplicit_body:\n    callq _tl_swbfix_opaque\n    jmp .Lswbimplicit_ret\n.Lswbimplicit_early:\n    ret\n")
    "swbimplicit"
    ".Lswbimplicit_ret"
    prologue-mask
    (ir.compiler-ir-label-none)
    (compiler-backend-swb-fix-block-list
      (__tl_make-array
        (ir.compiler-ir-label "entry")
        (ir.compiler-ir-label "body")
        (ir.compiler-ir-label "early")))))

(define (compiler-backend-swb-implicit-return-kind-ok? [shared : bool]) : bool
  (let
    [rax (compiler-backend-swb-implicit-return-plan shared 1)]
    [rdx (compiler-backend-swb-implicit-return-plan shared 4)]
    [vector (compiler-backend-swb-implicit-return-plan shared 65536)]
    [unrelated (compiler-backend-swb-implicit-return-plan shared 256)]
    (and
      (not (ir.compiler-ir-label-some? rax.label))
      (not (ir.compiler-ir-label-some? rdx.label))
      (not (ir.compiler-ir-label-some? vector.label))
      (= unrelated.label (ir.compiler-ir-label "body")))))

(define (compiler-backend-swb-implicit-return-ok?) : bool
  (and
    (compiler-backend-swb-implicit-return-kind-ok? false)
    (compiler-backend-swb-implicit-return-kind-ok? true)))

;; (8a) Variant (i): the form (a) bare clone lies INSIDE the would-be framed
;; region.  No duplication is involved -- the region is single-entry -- so only
;; the frontier rule can refuse it.  `.Lswbfixa_if_then.0` names the incoming
;; `%r8` the prologue reads, which is what puts it in U.
(define compiler-backend-swb-fix-inside-text : String
  ".Lswbfixa_entry:\n    cmpq %rdx, %rsi\n    jge .Lswbfixa_entry__shrinkwrap_bare0\n.Lswbfixa_if_then.0:\n    cmpq %r9, %r8\n    jl .Lswbfixa_entry__shrinkwrap_save\n.Lswbfixa_entry__shrinkwrap_bare1:\n    xorl %eax, %eax\n    ret\n.Lswbfixa_entry__shrinkwrap_save:\n    callq _tl_swbfix_opaque\n    jmp .Lswbfixa_ret\n.Lswbfixa_entry__shrinkwrap_bare0:\n    movl $1, %eax\n    ret\n")

(define (compiler-backend-swb-fix-inside-labels) : (__tl_dyn-array i64)
  (__tl_make-array
    (ir.compiler-ir-label "entry")
    (ir.compiler-ir-label "if_then.0")
    (ir.compiler-ir-label "entry__shrinkwrap_bare1")
    (ir.compiler-ir-label "entry__shrinkwrap_save")
    (ir.compiler-ir-label "entry__shrinkwrap_bare0")))

(define (compiler-backend-swb-fix-inside-refused-ok?) : bool
  (let
    [refused : backend.CompilerBackendSwbPlan
      (compiler-backend-swb-fix-plan-for
        (string.copy (& compiler-backend-swb-fix-inside-text))
        "swbfixa"
        ".Lswbfixa_ret"
        (compiler-backend-swb-fix-inside-labels)
        (ir.compiler-ir-label "entry__shrinkwrap_save"))]
    [unguarded : backend.CompilerBackendSwbPlan
      (compiler-backend-swb-fix-plan-for
        (string.copy (& compiler-backend-swb-fix-inside-text))
        "swbfixa"
        ".Lswbfixa_ret"
        (compiler-backend-swb-fix-inside-labels)
        (ir.compiler-ir-label-none))]
    (and
      ;; With form (a) active the guard block is above its frontier: refused.
      (not (ir.compiler-ir-label-some? refused.label))
      ;; The refusal is the frontier rule and nothing else: the very same text
      ;; still places when no form (a) frontier is declared.
      (ir.compiler-ir-label-some? unguarded.label)
      (= unguarded.label (ir.compiler-ir-label "if_then.0")))))

;; (8b) Variant (ii), the observed `fmt-diff-line-eq?` shape: the bare clone is
;; reachable from the guard AND from the entry, so TD-1 sees a single
;; well-formedness violator and would duplicate it -- keeping the bare clone as
;; "the framed original".  Refused twice over: by the frontier rule, and by the
;; dup-candidate rule that never lets a bare clone be that original.
(define compiler-backend-swb-fix-shared-text : String
  ".Lswbfixb_entry:\n    cmpq %rdx, %rsi\n    jge .Lswbfixb_entry__shrinkwrap_bare0\n.Lswbfixb_if_then.0:\n    cmpq %r9, %r8\n    jl .Lswbfixb_entry__shrinkwrap_save\n.Lswbfixb_entry__shrinkwrap_bare0:\n    xorl %eax, %eax\n    ret\n.Lswbfixb_entry__shrinkwrap_save:\n    callq _tl_swbfix_opaque\n    jmp .Lswbfixb_ret\n")

(define (compiler-backend-swb-fix-shared-labels) : (__tl_dyn-array i64)
  (__tl_make-array
    (ir.compiler-ir-label "entry")
    (ir.compiler-ir-label "if_then.0")
    (ir.compiler-ir-label "entry__shrinkwrap_bare0")
    (ir.compiler-ir-label "entry__shrinkwrap_save")))

;; The same shape with ordinary block names: no form (a) label anywhere, so the
;; tail IS duplicable and the placement lands on the guard.  This is the control
;; that proves (8b) is refused for the bare-clone reason alone.
(define compiler-backend-swb-fix-plain-text : String
  ".Lswbfixd_entry:\n    cmpq %rdx, %rsi\n    jge .Lswbfixd_join.0\n.Lswbfixd_if_then.0:\n    cmpq %r9, %r8\n    jl .Lswbfixd_body.0\n.Lswbfixd_join.0:\n    xorl %eax, %eax\n    ret\n.Lswbfixd_body.0:\n    callq _tl_swbfix_opaque\n    jmp .Lswbfixd_ret\n")

(define (compiler-backend-swb-fix-plain-labels) : (__tl_dyn-array i64)
  (__tl_make-array
    (ir.compiler-ir-label "entry")
    (ir.compiler-ir-label "if_then.0")
    (ir.compiler-ir-label "join.0")
    (ir.compiler-ir-label "body.0")))

(define (compiler-backend-swb-fix-shared-refused-ok?) : bool
  (let
    [refused : backend.CompilerBackendSwbPlan
      (compiler-backend-swb-fix-plan-for
        (string.copy (& compiler-backend-swb-fix-shared-text))
        "swbfixb"
        ".Lswbfixb_ret"
        (compiler-backend-swb-fix-shared-labels)
        (ir.compiler-ir-label "entry__shrinkwrap_save"))]
    [dup-refused : backend.CompilerBackendSwbPlan
      (compiler-backend-swb-fix-plan-for
        (string.copy (& compiler-backend-swb-fix-shared-text))
        "swbfixb"
        ".Lswbfixb_ret"
        (compiler-backend-swb-fix-shared-labels)
        (ir.compiler-ir-label-none))]
    [plain : backend.CompilerBackendSwbPlan
      (compiler-backend-swb-fix-plan-for
        (string.copy (& compiler-backend-swb-fix-plain-text))
        "swbfixd"
        ".Lswbfixd_ret"
        (compiler-backend-swb-fix-plain-labels)
        (ir.compiler-ir-label-none))]
    (and
      ;; The frontier rule refuses it ...
      (not (ir.compiler-ir-label-some? refused.label))
      ;; ... and so does the dup-candidate rule on its own.
      (not (ir.compiler-ir-label-some? dup-refused.label))
      ;; The identical shape with ordinary names still places, with the tail
      ;; duplicated -- so the two refusals above are about the labels, not
      ;; about the shape being inadmissible.
      (ir.compiler-ir-label-some? plain.label)
      (= plain.label (ir.compiler-ir-label "if_then.0"))
      (> plain.dup-site-count 0))))

;; (8c) The positive control: S IS form (a)'s saving block.  The refusal is
;; precise, not blanket -- the general form is still allowed to confirm form
;; (a)'s own frontier.
(define compiler-backend-swb-fix-frontier-text : String
  ".Lswbfixc_entry:\n    cmpq %rdx, %rsi\n    jge .Lswbfixc_entry__shrinkwrap_bare0\n.Lswbfixc_entry__shrinkwrap_save:\n    callq _tl_swbfix_opaque\n    jmp .Lswbfixc_ret\n.Lswbfixc_entry__shrinkwrap_bare0:\n    xorl %eax, %eax\n    ret\n")

(define (compiler-backend-swb-fix-frontier-labels) : (__tl_dyn-array i64)
  (__tl_make-array
    (ir.compiler-ir-label "entry")
    (ir.compiler-ir-label "entry__shrinkwrap_save")
    (ir.compiler-ir-label "entry__shrinkwrap_bare0")))

(define (compiler-backend-swb-fix-frontier-placed-ok?) : bool
  (let
    [plan : backend.CompilerBackendSwbPlan
      (compiler-backend-swb-fix-plan-for
        (string.copy (& compiler-backend-swb-fix-frontier-text))
        "swbfixc"
        ".Lswbfixc_ret"
        (compiler-backend-swb-fix-frontier-labels)
        (ir.compiler-ir-label "entry__shrinkwrap_save"))]
    [missing : backend.CompilerBackendSwbPlan
      (compiler-backend-swb-fix-plan-for
        (string.copy (& compiler-backend-swb-fix-frontier-text))
        "swbfixc"
        ".Lswbfixc_ret"
        (compiler-backend-swb-fix-frontier-labels)
        (ir.compiler-ir-label "entry__shrinkwrap_absent"))]
    (and
      (ir.compiler-ir-label-some? plan.label)
      (= plan.label (ir.compiler-ir-label "entry__shrinkwrap_save"))
      ;; Fail closed: form (a) active but its saving block does not resolve to
      ;; a node of the analysed text.
      (not (ir.compiler-ir-label-some? missing.label)))))

;; (8d) The dup-candidate refusal on its own, plus the label classifier it is
;; built from.  A bare clone is never the framed original; the same node with
;; an ordinary name is.
(define (compiler-backend-swb-fix-label-clone? [label : String]) : bool
  (let
    [data : (Ptr u8)
      (unsafe
        (string-data label))]
    (backend.compiler-backend-swb-bare-clone-label?
      data
      0
      (string.string-length label))))

(define (compiler-backend-swb-fix-dup-candidate-ok?) : bool
  (let
    [flags : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [succ-count : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [block-start : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [clone : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [plain : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [_init : unit
      (begin
        (set! (array-ref flags 1) backend.compiler-backend-swb-flag-return)
        (set! (array-ref succ-count 1) 0)
        (set! (array-ref block-start 1) 1)
        (set! (array-ref clone 1) 1)
        (set! (array-ref plain 1) 0))]
    (and
      ;; A tail whose label is a form (a) bare clone is never duplicable ...
      (not
        (backend.compiler-backend-swb-dup-candidate?
          flags
          succ-count
          block-start
          clone
          1
          0))
      ;; ... while the identical node with an ordinary label still is.
      (backend.compiler-backend-swb-dup-candidate?
        flags
        succ-count
        block-start
        plain
        1
        0)
      ;; The classifier: prefix plus at least one digit, nothing else.
      (compiler-backend-swb-fix-label-clone? ".Lf17263_entry__shrinkwrap_bare0")
      (compiler-backend-swb-fix-label-clone? ".Lf1_e__shrinkwrap_bare12")
      (not (compiler-backend-swb-fix-label-clone? ".Lf1_e__shrinkwrap_bare"))
      (not (compiler-backend-swb-fix-label-clone? ".Lf1_e__shrinkwrap_save"))
      (not (compiler-backend-swb-fix-label-clone? ".Lf1_if_then.0"))
      (not (compiler-backend-swb-fix-label-clone? ".Lf1_e__shrinkwrap_bar0"))
      ;; The span is what is tested, so a truncated span cannot match either.
      (not (compiler-backend-swb-fix-label-clone? "_bare0")))))

;; (7) Windows is unchanged. Its unwind program describes a prologue at the
;; function symbol and the `.seh_*` opcodes may not follow an interior label, so
;; the same source that shrink-wraps on Linux keeps entry placement here. The
;; target-parity gate accepts that divergence explicitly.
(define (compiler-backend-swb-windows-unchanged-ok?) : bool
  (compiler-backend-swb-entry-placed?
    (compiler-backend-swb-body-for
      (string.copy (& compiler-backend-swb-global-guard-source))
      (be_state.CompilerBackendTarget.Windows)
      "_tl_swb_invalidate")))

(define (compiler-backend-scavenge-occupancy-cache-ok?) : bool
  (let
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r9 %1=%r10 %2=%r11/%xmm2 %3=spill:0 %4=%r9")]
    [assignment-index : regalloc.CompilerRegAssignmentTable
      (regalloc.compiler-reg-assignment-table-with-min-capacity assignments 5)]
    (set! (array-ref starts 0) 0)
    (set! (array-ref ends 0) 2)
    (set! (array-ref starts 1) 3)
    (set! (array-ref ends 1) 5)
    (set! (array-ref starts 2) 4)
    (set! (array-ref ends 2) 7)
    (set! (array-ref starts 3) 0)
    (set! (array-ref ends 3) 8)
    (set! (array-ref starts 4) 2)
    (set! (array-ref ends 4) 6)
    (let
      [masks : (__tl_dyn-array i64)
        (backend.compiler-backend-scavenge-occupancy-build
          starts
          ends
          assignment-index
          (__tl_make-array regalloc.CompilerRegIntervalSeq 0)
          5)]
      (and
        (= (array-length masks) 5)
        (compiler-backend-scavenge-occupancy-cache-point-ok?
          masks
          starts
          ends
          assignment-index
          5
          0)
        (compiler-backend-scavenge-occupancy-cache-point-ok?
          masks
          starts
          ends
          assignment-index
          5
          2)
        (compiler-backend-scavenge-occupancy-cache-point-ok?
          masks
          starts
          ends
          assignment-index
          5
          4)
        (compiler-backend-scavenge-occupancy-cache-point-ok?
          masks
          starts
          ends
          assignment-index
          5
          6)
        (compiler-backend-scavenge-occupancy-cache-point-ok?
          masks
          starts
          ends
          assignment-index
          5
          8)
        (=
          (array-ref masks 0)
          (be_operand.compiler-backend-scavenge-reg-bit "%r9"))
        (not
          (=
            (bit-and
              (array-ref masks 2)
              (be_operand.compiler-backend-scavenge-reg-bit "%r9"))
            0))
        (=
          (array-ref masks 3)
          (bit-or
            (be_operand.compiler-backend-scavenge-reg-bit "%r9")
            (bit-or
              (be_operand.compiler-backend-scavenge-reg-bit "%r11")
              (be_operand.compiler-backend-scavenge-reg-bit "%xmm2"))))))))

;; --- P3d: the occupancy table honours liveness HOLES ------------------------
;; Two values legitimately share one register when their SEGMENTS are disjoint
;; (that is the interference rule the allocator itself uses). Asked through the
;; coarse hulls, that register then reads occupied across the hole between them,
;; and in a merged body every register reads occupied everywhere -- so every
;; scratch demand, including a spilled array base's reload, degrades to the
;; emergency save/reload/restore tier. These pin the three properties the fix
;; rests on: the hole is reported free, the live segments are still reported
;; occupied, and a var with NO segment row keeps its hull.
(define (compiler-backend-scavenge-segment-assignments) : regalloc.CompilerRegAssignmentTable
  (regalloc.compiler-reg-assignment-table-with-min-capacity
    (reg-homes "%0=%r10 %1=%r11")
    2))

;; var 0: hull [0,16] made of segments [0,4] and [12,16] -- dead over 6..10.
;; var 1: hull [0,16] with no segment row at all, the shape the const-hoist and
;; scratch-plan pseudo-vars have once they are appended past the emitted
;; function's own var count.
(define (compiler-backend-scavenge-segment-masks [rows : i64]) : (__tl_dyn-array
    i64)
  (let
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [segments : (__tl_dyn-array regalloc.CompilerRegIntervalSeq)
      (__tl_make-array regalloc.CompilerRegIntervalSeq rows)]
    (set! (array-ref starts 0) 0)
    (set! (array-ref ends 0) 16)
    (set! (array-ref starts 1) 0)
    (set! (array-ref ends 1) 16)
    (if (> rows 0)
      (set!
        (array-ref segments 0)
        (regalloc.compiler-reg-interval-seq-prepend
          (regalloc.CompilerRegInterval 0 0 4)
          (&
            (regalloc.compiler-reg-interval-seq-prepend
              (regalloc.CompilerRegInterval 0 12 16)
              (& (regalloc.compiler-reg-interval-seq-empty))))))
      unit)
    (backend.compiler-backend-scavenge-occupancy-build
      starts
      ends
      (compiler-backend-scavenge-segment-assignments)
      segments
      2)))

(define (compiler-backend-scavenge-segment-subset-ok?
  [hull : (__tl_dyn-array i64)]
  [segmented : (__tl_dyn-array i64)]) : bool
  (for [index (iterator.range 0 (array-length hull))]
    (unless
      (=
        (bit-and
          (array-ref segmented index)
          (bit-xor (array-ref hull index) -1))
        0)
      (return false))
    unit)
  true)

(define (compiler-backend-scavenge-segment-occupancy-ok?) : bool
  (let
    [hull : (__tl_dyn-array i64) (compiler-backend-scavenge-segment-masks 0)]
    [segmented : (__tl_dyn-array i64)
      (compiler-backend-scavenge-segment-masks 2)]
    [r10 : i64 (be_operand.compiler-backend-scavenge-reg-bit "%r10")]
    [r11 : i64 (be_operand.compiler-backend-scavenge-reg-bit "%r11")]
    (and
      (= (array-length hull) 9)
      (= (array-length segmented) 9)
      ;; hull: %r10 busy right across the hole (instruction index 4 = point 8)
      (not (= (bit-and (array-ref hull 4) r10) 0))
      ;; segments: the hole reads free ...
      (= (bit-and (array-ref segmented 4) r10) 0)
      ;; ... while both live segments still read busy
      (not (= (bit-and (array-ref segmented 0) r10) 0))
      (not (= (bit-and (array-ref segmented 2) r10) 0))
      (not (= (bit-and (array-ref segmented 6) r10) 0))
      (not (= (bit-and (array-ref segmented 8) r10) 0))
      ;; var 1 has no segment row: its hull answer is retained everywhere
      (not (= (bit-and (array-ref segmented 4) r11) 0))
      (not (= (bit-and (array-ref hull 4) r11) 0))
      ;; monotone: the table can only LOSE bits, never gain one
      (compiler-backend-scavenge-segment-subset-ok? hull segmented))))

;; The consequence at the pick. With every candidate reading occupied the picker
;; runs off the end of the pool and returns its emergency fallback with a pending
;; save (the emitter then brackets the reload with a save and a restore). With
;; the hole exposed it returns the free register outright and nothing is pending,
;; so the reload is a plain `mov`.
(define (compiler-backend-scavenge-segment-pick-busy-mask) : i64
  (bit-or
    (be_operand.compiler-backend-scavenge-reg-bit "%r9")
    (bit-or
      (be_operand.compiler-backend-scavenge-reg-bit "%r8")
      (bit-or
        (be_operand.compiler-backend-scavenge-reg-bit "%r12")
        (bit-or
          (be_operand.compiler-backend-scavenge-reg-bit "%r13")
          (bit-or
            (be_operand.compiler-backend-scavenge-reg-bit "%r14")
            (bit-or
              (be_operand.compiler-backend-scavenge-reg-bit "%r15")
              (bit-or
                (be_operand.compiler-backend-scavenge-reg-bit "%rbx")
                (bit-or
                  (be_operand.compiler-backend-scavenge-reg-bit "%rsi")
                  (be_operand.compiler-backend-scavenge-reg-bit "%rdi"))))))))))

(define (compiler-backend-scavenge-segment-pick-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [function-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state backend-state)]
    ;; %rax/%rdx/%rcx are the fixed-register exclude every arithmetic site uses.
    [exclude : (__tl_dyn-array String)
      (be_scalar.compiler-backend-binop-scavenge-exclude-build)]
    [hull : (__tl_dyn-array i64) (compiler-backend-scavenge-segment-masks 0)]
    [segmented : (__tl_dyn-array i64)
      (compiler-backend-scavenge-segment-masks 2)]
    [busy : i64
      (bit-or
        (array-ref hull 4)
        (compiler-backend-scavenge-segment-pick-busy-mask))]
    [narrow : i64
      (bit-or
        (array-ref segmented 4)
        (compiler-backend-scavenge-segment-pick-busy-mask))]
    [hull-pick : String
      (be_operand.compiler-backend-scavenge-pick-with-mask
        function-state
        true
        busy
        busy
        (owned_view.compiler-owned-shared-view exclude)
        5
        "%r8")]
    [hull-pending? : bool
      (be_state.compiler-backend-function-scratch-bool?
        function-state
        be_state.compiler-backend-scratch-bool-emergency-pending)]
    ;; R4-B: the same all-busy wide mask, but with the emit-point mask offered
    ;; as the narrow retry. The last-resort tier finds %r10 free there and hands
    ;; it back with nothing pending, instead of borrowing an occupied register
    ;; and wrapping the step in a save/restore pair.
    [_reset : unit
      (be_state.compiler-backend-function-scratch-set-bool!
        function-state
        be_state.compiler-backend-scratch-bool-emergency-pending
        false)]
    [narrow-pick : String
      (be_operand.compiler-backend-scavenge-pick-with-mask
        function-state
        true
        busy
        narrow
        (owned_view.compiler-owned-shared-view exclude)
        5
        "%r8")]
    [narrow-pending? : bool
      (be_state.compiler-backend-function-scratch-bool?
        function-state
        be_state.compiler-backend-scratch-bool-emergency-pending)]
    [segment-pick : String
      (be_operand.compiler-backend-scavenge-pick-with-mask
        function-state
        true
        narrow
        narrow
        exclude
        5
        "%r8")]
    (and
      ;; Everything reads occupied, so no candidate is usable and the picker
      ;; drops into the emergency tier: it returns the first NON-EXCLUDED pool
      ;; candidate (%r9, itself occupied) and marks it pending, which is what
      ;; makes the emitter bracket the reload with a save and a restore.
      (string.eq hull-pick "%r9")
      hull-pending?
      ;; R4-B narrow last-resort tier: free at the emit point, no wrap.
      (string.eq narrow-pick "%r10")
      (not narrow-pending?)
      ;; The hole frees %r10, so the picker hands it back directly -- the reload
      ;; is a plain `mov` with nothing to preserve.
      (string.eq segment-pick "%r10"))))

(define (compiler-backend-scavenge-loop-live-through-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %0 = mov 8 : i64
       %1 = mov 0 : i64
       %5 = mov 0 : i64
       jump header
     header:
       %2 = lt %1, %0 : bool
       branch %2, body, exit
     body:
       %3 = gep %5, %1 : i64
       %4 = load %3 : i64
       jump header
     exit:
       %6 = mul %0, 8 : i64
       return %6"))

(define (compiler-backend-scavenge-loop-live-through-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [prev-starts : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-starts
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-ends : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-ends
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-assignment-index : regalloc.CompilerRegAssignmentTable
      (scratch-scavenge-ctx-assignments
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-plan-mask : i64
      (scratch-scavenge-ctx-plan-reg-mask
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-occupied-masks : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-occupied-masks
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-vars : i64
      (scratch-scavenge-ctx-vars
        (be_state.compiler-backend-state-function-state backend-state))]
    [blocks : ir.CompilerIrBlockList
      (compiler-backend-scavenge-loop-live-through-blocks)]
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r8")]
    (compiler-backend-test-scavenge-install-ctx!
      "scavenge_loop_live_through"
      (ir.compiler-ir-param-seq-empty)
      (I64)
      7
      blocks
      assignments
      backend-state)
    (let
      [mask : i64
        (be_operand.compiler-backend-scavenge-occupied-mask-at-point
          (be_state.compiler-backend-state-function-state backend-state)
          12)]
      [ok : bool
        (and
          (not
            (=
              (bit-and
                mask
                (be_operand.compiler-backend-scavenge-reg-bit "%r8"))
              0))
          (not
            (string.eq
              (be_operand.compiler-backend-scavenge-pick-with-mask
                (be_state.compiler-backend-state-function-state backend-state)
                true
                mask
                mask
                (be_operand.compiler-backend-one-exclude "%rax")
                1
                "%r8")
              "%r8")))]
      (backend.compiler-backend-set-scavenge-ctx-ready!
        (be_state.compiler-backend-state-function-state backend-state)
        prev-starts
        prev-ends
        prev-assignment-index
        prev-plan-mask
        prev-occupied-masks
        prev-vars)
      ok)))

;; #phi-staged-copy under a ROTATED loop. The blocks below are already in the
;; order a block layout pass emits when it rotates: the preheader jumps forward
;; into the header, and the LATCH (`lat`) sits ABOVE it, so the genuine back
;; edge `lat -> head` runs FORWARD in emission order. The obligation the staged
;; copy has to discharge on that edge -- "the staging register is free at the
;; TARGET block's entry" -- is asked on every edge. An emission-order test
;; (`target <= point`) reads this back edge as a forward edge, and a register
;; holding a value live into the header would lose its pushq/popq bracket.
;;
;; `v4` opens at the header's first instruction and is homed in %r8, so %r8 is
;; FREE across the staging window at the latch's edge point and OCCUPIED at the
;; header's entry point: exactly the split an emission-point comparison gets
;; wrong.
(define (compiler-backend-phi-rotated-back-edge-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %0 = mov 8 : i64
       %1 = mov 0 : i64
       jump head
     lat:
       %3 = add %1, 1 : i64
       jump head
     sunk:
       %5 = mov 1 : i64
       %6 = mov 1 : i64
       %7 = mov 1 : i64
       %8 = mov 1 : i64
       %9 = mov 1 : i64
       %10 = mov 1 : i64
       %11 = mov 1 : i64
       jump exit
     head:
       %4 = mul %0, 2 : i64
       %2 = lt %4, %0 : bool
       branch %2, lat, sunk
     exit:
       return %3"))

;; Model the occupancy gap of a rotated back edge directly: the %xmm2 family is
;; free at the latch emission point and occupied at the header entry even though
;; layout placed the semantic back edge forward in emitted order. A missing
;; target point is independently conservative.
(define (compiler-backend-phi-xmm-back-edge-gap-preserved-ok?) : bool
  (let
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=spill:-16 %1=spill:-24 %2=%xmm2")]
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [edge-point : i64 8]
    [target-point : i64 26]
    (regalloc.compiler-reg-fill-i64-array (&mut starts) -1)
    (regalloc.compiler-reg-fill-i64-array (&mut ends) -1)
    (set! (array-ref starts 2) target-point)
    (set! (array-ref ends 2) target-point)
    (match (backend.compiler-backend-scavenge-assignments-build assignments 3)
      [(backend.CompilerBackendScavengeAssignments assignment-index plan-mask)
        (backend.compiler-backend-set-scavenge-ctx-ready!
          (be_state.compiler-backend-state-function-state backend-state)
          (owned_view.compiler-owned-shared-view starts)
          (owned_view.compiler-owned-shared-view ends)
          assignment-index
          plan-mask
          (backend.compiler-backend-scavenge-occupancy-build
            starts
            ends
            assignment-index
            (__tl_make-array regalloc.CompilerRegIntervalSeq 0)
            3)
          3)])
    (set-state-emit-instr-post-base! backend-state 4)
    (be_calls.compiler-backend-function-state-set-current-phi-target-point!
      backend-state
      target-point)
    (be_calls.compiler-backend-function-state-set-current-phi-dst-home-mask!
      backend-state
      0)
    (set-scratch-emergency-slot-offset!
      (be_state.compiler-backend-state-function-state backend-state)
      -128)
    (match (be_calls.compiler-backend-emit-phi-source-load-store
      (ast.ast-node-pool-reader-type-segment-bases)
      assignments
      0
      (Var 1)
      (F64)
      program-index
      backend-state)
      [(Ok back-edge)
        (let
          [back-edge-proven? : bool
            (be_calls.compiler-backend-phi-staged-copy-proven?
              backend-state
              "%xmm2")]
          (be_calls.compiler-backend-function-state-set-current-phi-target-point!
            backend-state
            -1)
          (match (be_calls.compiler-backend-emit-phi-source-load-store
            (ast.ast-node-pool-reader-type-segment-bases)
            assignments
            0
            (Var 1)
            (F64)
            program-index
            backend-state)
            [(Ok unknown-edge)
              (and
                (=
                  (be_state.compiler-backend-function-state-emission-point
                    (be_state.compiler-backend-state-function-state
                      backend-state))
                  edge-point)
                (not back-edge-proven?)
                (not
                  (be_calls.compiler-backend-phi-staged-copy-proven?
                    backend-state
                    "%xmm2"))
                (compiler-backend-phi-xmm-stage-bracket-shape?
                  back-edge
                  "    movdqu %xmm2, -128(%rbp)\n"
                  "    movdqu -128(%rbp), %xmm2\n")
                (compiler-backend-phi-xmm-stage-bracket-shape?
                  unknown-edge
                  "    movdqu %xmm2, -128(%rbp)\n"
                  "    movdqu -128(%rbp), %xmm2\n"))]
            [(Err _) false]))]
      [(Err _) false])))

;; #phi-staged-copy obligation (3) under edge-precise scavenge occupancy: a phi
;; input is live only to the end of its predecessor, so the target-entry query
;; no longer sees its register and the edge home mask has to. Every
;; register-homed input on every edge is in the mask next to every
;; register-homed destination; a spilled one and an immediate add nothing.
(define (compiler-backend-phi-leading-mask-covers-inputs-ok?) : bool
  (let
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r8 %1=%r9 %2=%rsi %3=spill:-16 %4=%rdi %5=spill:-24")]
    [instrs : ir.CompilerIrInstrSeq
      (irt.instrs
        "%2 = phi [%0, entry], [%1, latch] : i64
         %3 = phi [5, entry], [%4, latch] : i64
         %6 = add %5, 1 : i64
         jump body")]
    [mask : i64
      (be_calls.compiler-backend-phi-leading-dst-home-mask-seq
        backend-state
        assignments
        instrs)]
    (=
      mask
      (bit-or
        (bit-or
          (be_operand.compiler-backend-scavenge-reg-bit "%r8")
          (be_operand.compiler-backend-scavenge-reg-bit "%r9"))
        (bit-or
          (be_operand.compiler-backend-scavenge-reg-bit "%rsi")
          (be_operand.compiler-backend-scavenge-reg-bit "%rdi"))))))

(define (compiler-backend-phi-rotated-back-edge-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [prev-starts : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-starts
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-ends : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-ends
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-assignment-index : regalloc.CompilerRegAssignmentTable
      (scratch-scavenge-ctx-assignments
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-plan-mask : i64
      (scratch-scavenge-ctx-plan-reg-mask
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-occupied-masks : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-occupied-masks
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-vars : i64
      (scratch-scavenge-ctx-vars
        (be_state.compiler-backend-state-function-state backend-state))]
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%4=%r8")]
    ;; entry is 3 instructions (0,1,2), `lat` is 2 (3,4), `sunk` is 8 (5..12)
    ;; and `head` opens at 13. So the latch's edge is emitted at instruction 4
    ;; -- point 8 -- and the header's entry is point 26: the back edge runs
    ;; FORWARD, and it runs forward by more than the staging window, which is
    ;; what leaves the point-local query alone with the question.
    [edge-point : i64 8]
    [target-point : i64 26]
    (compiler-backend-test-scavenge-install-ctx!
      "phi_rotated_back_edge"
      (ir.compiler-ir-param-seq-empty)
      (I64)
      12
      (compiler-backend-phi-rotated-back-edge-blocks)
      assignments
      backend-state)
    (set-state-emit-instr-post-base! backend-state 4)
    (be_calls.compiler-backend-function-state-set-current-phi-target-point!
      backend-state
      target-point)
    (be_calls.compiler-backend-function-state-set-current-phi-dst-home-mask!
      backend-state
      0)
    (let
      [function-state : be_state.CompilerBackendFunctionState
        (be_state.compiler-backend-state-function-state backend-state)]
      [r8 : i64 (be_operand.compiler-backend-scavenge-reg-bit "%r8")]
      [r10 : i64 (be_operand.compiler-backend-scavenge-reg-bit "%r10")]
      [ok : bool
        (and
          ;; the fixture really is the hazard shape ...
          (=
            (be_state.compiler-backend-function-state-emission-point
              function-state)
            edge-point)
          (> target-point edge-point)
          (=
            (bit-and
              (be_operand.compiler-backend-scavenge-occupied-mask-over-range
                function-state
                edge-point
                (+
                  edge-point
                  be_operand.compiler-backend-scavenge-staging-window))
              r8)
            0)
          (not
            (=
              (bit-and
                (be_operand.compiler-backend-scavenge-occupied-mask-at-point
                  function-state
                  target-point)
                r8)
              0))
          ;; ... and the bracket is KEPT on it, because the target-entry
          ;; obligation is asked on every edge and not just on the ones the
          ;; emitted order happens to run backwards.
          (not
            (be_calls.compiler-backend-phi-staged-copy-proven?
              backend-state
              "%r8"))
          ;; A register free at both ends still un-brackets, so this is a
          ;; sharper test than "the predicate says no".
          (=
            (bit-and
              (be_operand.compiler-backend-scavenge-occupied-mask-at-point
                function-state
                target-point)
              r10)
            0)
          (be_calls.compiler-backend-phi-staged-copy-proven?
            backend-state
            "%r10"))]
      (backend.compiler-backend-set-scavenge-ctx-ready!
        function-state
        prev-starts
        prev-ends
        prev-assignment-index
        prev-plan-mask
        prev-occupied-masks
        prev-vars)
      ok)))

;; #5982. The constant-remainder expansion ends `subq product, SRC`, so electing
;; the dividend's own home as SRC needs the REGISTER free afterwards, not just
;; the VALUE dead. Model the miscompiled shape at point 10 with three vars
;; sharing %r13: the dividend definition dying exactly at 10, the loop-carried
;; home shared with the header phi spanning the loop, and this instruction's own
;; result opening at 11. The phi must veto own-SRC; the instruction's own output
;; must not.
(define (compiler-backend-divmod-live-dividend-ctx!
  [backend-state : be_state.CompilerBackendState]
  [carried? : bool]) : unit
  (let
    [vars : i64 3]
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (regalloc.compiler-reg-assignments-prepend
        (&
          (regalloc.CompilerRegAssignment 0 (Register cabi.compiler-reg-id-r13)))
        (regalloc.compiler-reg-assignments-prepend
          (&
            (regalloc.CompilerRegAssignment
              1
              (Register
                (if carried?
                  cabi.compiler-reg-id-r13
                  cabi.compiler-reg-id-r14))))
          (reg-homes "%2=%r13")))]
    ;; var 0: the dividend definition -- dead after point 10
    (set! (array-ref starts 0) 9)
    (set! (array-ref ends 0) 10)
    ;; var 1: the loop-carried home (phi-shared) -- spans the whole region
    (set! (array-ref starts 1) 2)
    (set! (array-ref ends 1) 30)
    ;; var 2: this instruction's own result -- opens on the def half-step
    (set! (array-ref starts 2) 11)
    (set! (array-ref ends 2) 20)
    (backend.compiler-backend-set-scavenge-ctx-index!
      (be_state.compiler-backend-state-function-state backend-state)
      starts
      ends
      (regalloc.compiler-reg-assignment-table-with-min-capacity
        assignments
        vars)
      (__tl_make-array regalloc.CompilerRegIntervalSeq 0)
      0
      vars)))

(define (compiler-backend-divmod-live-dividend-src-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [prev-starts : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-starts
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-ends : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-ends
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-assignment-index : regalloc.CompilerRegAssignmentTable
      (scratch-scavenge-ctx-assignments
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-plan-mask : i64
      (scratch-scavenge-ctx-plan-reg-mask
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-occupied-masks : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-occupied-masks
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-vars : i64
      (scratch-scavenge-ctx-vars
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-post-base : i64 (state-emit-instr-post-base backend-state)]
    [prev-count : i64 (state-emit-current-count backend-state)]
    ;; place the emission point at 10: 2 * (post-base - count)
    [_point : unit
      (begin
        (set-state-emit-instr-post-base! backend-state 5)
        (set-state-emit-current-count! backend-state 0))]
    [_carried-ctx : unit
      (compiler-backend-divmod-live-dividend-ctx! backend-state true)]
    [carried : bool
      (be_scalar.compiler-backend-divmod-home-carried-after?
        (be_state.compiler-backend-state-function-state backend-state)
        "%r13"
        10)]
    ;; the value fact alone still reports the dividend dead here
    [value-dead : bool
      (not
        (be_scalar.compiler-backend-value-live-after-here?
          backend-state
          (Var 0)))]
    ;; a remainder must refuse the home the phi still carries ...
    [remainder-refused : bool
      (not
        (be_scalar.compiler-backend-divmod-src-home-safe?
          backend-state
          true
          "%r13"
          ""))]
    ;; ... a quotient never writes SRC, so it is unaffected ...
    [quotient-allowed : bool
      (be_scalar.compiler-backend-divmod-src-home-safe?
        backend-state
        false
        "%r13"
        "")]
    ;; ... and a destination living in that same register is the result's own
    ;; home, so it stays eligible.
    [dst-home-allowed : bool
      (be_scalar.compiler-backend-divmod-src-home-safe?
        backend-state
        true
        "%r13"
        "%r13")]
    ;; a register nothing is homed in is never carried
    [free-reg : bool
      (not
        (be_scalar.compiler-backend-divmod-home-carried-after?
          (be_state.compiler-backend-state-function-state backend-state)
          "%r15"
          10))]
    [_plain-ctx : unit
      (compiler-backend-divmod-live-dividend-ctx! backend-state false)]
    ;; without the phi only this instruction's own result remains, and a var
    ;; opening on the def half-step is what the expansion is producing
    [own-output-ok : bool
      (and
        (not
          (be_scalar.compiler-backend-divmod-home-carried-after?
            (be_state.compiler-backend-state-function-state backend-state)
            "%r13"
            10))
        (be_scalar.compiler-backend-divmod-src-home-safe?
          backend-state
          true
          "%r13"
          ""))]
    (backend.compiler-backend-set-scavenge-ctx-ready!
      (be_state.compiler-backend-state-function-state backend-state)
      prev-starts
      prev-ends
      prev-assignment-index
      prev-plan-mask
      prev-occupied-masks
      prev-vars)
    (set-state-emit-instr-post-base! backend-state prev-post-base)
    (set-state-emit-current-count! backend-state prev-count)
    (and
      carried
      value-dead
      remainder-refused
      quotient-allowed
      dst-home-allowed
      free-reg
      own-output-ok)))

(define (compiler-backend-param-spill-stack-scratch-preserves-home-ok?) : bool
  (let
    [params : ir.CompilerIrParamSeq
      (irt.params
        "a=%0:u64, b=%1:u64, c=%2:u64, d=%3:u64, e=%4:u64, f=%5:u64, g=%6:bool")]
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%3=%r9")]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState index.backend-state]
    (asm-ok?
      (backend.compiler-backend-emit-param-spills
        (ast.ast-node-pool-reader-type-segment-bases)
        (be_state.CompilerBackendTarget.Windows)
        assignments
        params
        0
        0
        0
        0
        index
        7
        backend-state)
      (has "    movzbl 16(%rbp), ")
      (lacks "    movzbq 16(%rbp), %r9\n" "    movzbl 16(%rbp), %r9d\n"))))

;; #8894: the stale body cursor the float parameter copies used to consult.
;; Its occupancy reports every register free, although the pinned parameters
;; still hold their incoming registers.
(define (compiler-backend-param-entry-stale-free-cursor!
  [backend-state : be_state.CompilerBackendState]) : unit
  (set-scratch-scavenge-ctx-occupied-masks!
    (be_state.compiler-backend-state-function-state backend-state)
    (__tl_make-array 0 0))
  (set-state-emit-instr-post-base! backend-state 1)
  (set-state-emit-current-count! backend-state 0))

;; The issue's opt2 System V plan: c..h are pinned to their incoming %xmm2-%xmm7
;; and the stack-passed i and j live in frame slots. Their copies run first,
;; through %xmm8, and nothing writes a pinned parameter's register.
(define (compiler-backend-param-entry-float-copy-linux-ok?) : bool
  (let
    [params : ir.CompilerIrParamSeq
      (irt.params
        "a=%0:f64, b=%1:f64, c=%2:f64, d=%3:f64, e=%4:f64, f=%5:f64, g=%6:f64, h=%7:f64, i=%8:f64, j=%9:f64")]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes
        "%0=spill:-8 %1=spill:-16 %2=%xmm2 %3=%xmm3 %4=%xmm4 %5=%xmm5 %6=%xmm6 %7=%xmm7 %8=spill:-24 %9=spill:-32")]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState index.backend-state]
    (compiler-backend-param-entry-stale-free-cursor! backend-state)
    (asm-ok?
      (backend.compiler-backend-emit-param-spills
        (ast.ast-node-pool-reader-type-segment-bases)
        (be_state.CompilerBackendTarget.Linux)
        assignments
        params
        0
        0
        0
        0
        index
        10
        backend-state)
      (has
        "    movsd 16(%rbp), %xmm8\n    movsd %xmm8, -24(%rbp)\n    movsd 24(%rbp), %xmm8\n    movsd %xmm8, -32(%rbp)\n    movsd %xmm0, -8(%rbp)\n")
      (lacks
        ", %xmm2\n"
        ", %xmm3\n"
        ", %xmm4\n"
        ", %xmm5\n"
        ", %xmm6\n"
        ", %xmm7\n"))))

;; Windows Internal pins a..f to XMM0-5 and passes g..j on the stack. h and j
;; copy through volatile RAX before g/i enter their XMM6/7 homes. No entry copy
;; may overwrite an unread input or add an undescribed nonvolatile XMM use.
(define (compiler-backend-param-entry-float-copy-windows-ok?) : bool
  (let
    [params : ir.CompilerIrParamSeq
      (irt.params
        "a=%0:f64, b=%1:f64, c=%2:f64, d=%3:f64, e=%4:f64, f=%5:f64, g=%6:f64, h=%7:f64, i=%8:f64, j=%9:f64")]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes
        "%0=%xmm0 %1=%xmm1 %2=%xmm2 %3=%xmm3 %4=%xmm4 %5=%xmm5 %6=%xmm6 %7=spill:-8 %8=%xmm7 %9=spill:-16")]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState index.backend-state]
    (compiler-backend-param-entry-stale-free-cursor! backend-state)
    (asm-ok?
      (backend.compiler-backend-emit-param-spills
        (ast.ast-node-pool-reader-type-segment-bases)
        (be_state.CompilerBackendTarget.Windows)
        assignments
        params
        0
        0
        0
        0
        index
        10
        backend-state)
      (has
        "    movq 24(%rbp), %rax\n    movq %rax, -8(%rbp)\n    movq 40(%rbp), %rax\n    movq %rax, -16(%rbp)\n    movsd 16(%rbp), %xmm6\n    movsd 32(%rbp), %xmm7\n")
      (lacks
        ", %xmm0\n"
        ", %xmm1\n"
        ", %xmm2\n"
        ", %xmm3\n"
        ", %xmm4\n"
        ", %xmm5\n"))))

;; A System V register group whose two SSE words do not fit the one float
;; argument register left after g arrives on the stack. With c..g pinned to
;; %xmm2-%xmm6 the scavenger's XMM pool had no free register and fell back to
;; the pinned %xmm2 under an emergency save nothing restored. The words now
;; copy first, through %xmm8, and arm no emergency save.
(define (compiler-backend-param-entry-group-copy-linux-ok?) : bool
  (let
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-register-group-f64-test-index)]
    [params : ir.CompilerIrParamSeq
      (irt.params
        "a=%0:f64, b=%1:f64, c=%2:f64, d=%3:f64, e=%4:f64, f=%5:f64, g=%6:f64, p=%7:BackendGroupF64Test")]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes
        "%0=spill:-8 %1=spill:-16 %2=%xmm2 %3=%xmm3 %4=%xmm4 %5=%xmm5 %6=%xmm6")]
    [backend-state : be_state.CompilerBackendState index.backend-state]
    [function-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state backend-state)]
    [_cursor : unit
      (compiler-backend-param-entry-stale-free-cursor! backend-state)]
    [pending-before : i64 (scratch-emergency-pending-count function-state)]
    [result : be_state.ResultCompilerBackend
      (backend.compiler-backend-emit-param-spills
        (ast.ast-node-pool-reader-type-segment-bases)
        (be_state.CompilerBackendTarget.Linux)
        assignments
        params
        0
        0
        0
        0
        index
        8
        backend-state)]
    [pending-after : i64 (scratch-emergency-pending-count function-state)]
    (and
      (= pending-before pending-after)
      (match result
        [(Ok text)
          (let
            [word1 : i64
              (backend.compiler-backend-string-find-from
                text
                "    movsd 24(%rbp), %xmm8\n"
                0)]
            [first-home : i64
              (backend.compiler-backend-string-find-from
                text
                "    movsd %xmm0, -8(%rbp)\n"
                0)]
            (and
              (string.is-string-prefix-at text "    movsd 16(%rbp), %xmm8\n" 0)
              (>= word1 0)
              (> first-home word1)
              (asm-lacks?
                text
                ", %xmm2\n"
                ", %xmm3\n"
                ", %xmm4\n"
                ", %xmm5\n"
                ", %xmm6\n")))]
        [(Err _) false]))))

;; #9302: a private SPMD helper's parameter spills for `params` and `homes`,
;; in backend `mode`, under the stale all-free cursor.
(define (compiler-backend-spmd-entry-copy-spills
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]
  [params : String]
  [homes : String]
  [vars : i64]) : be_state.ResultCompilerBackend
  (let
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState index.backend-state]
    (be_state.compiler-backend-set-current-mode!
      (be_state.compiler-backend-state-function-state backend-state)
      mode)
    (compiler-backend-param-entry-stale-free-cursor! backend-state)
    (backend.compiler-backend-emit-spmd-private-param-spills
      (ast.ast-node-pool-reader-type-segment-bases)
      target
      (reg-homes homes)
      (irt.params params)
      vars
      backend-state)))

(define (compiler-backend-spmd-spilled-varying-entry-ok?) : bool
  (for [host (iterator.range 0 2)]
    (for [explicit (iterator.range 0 2)]
      (unless
        (asm-ok?
          (compiler-backend-spmd-entry-copy-spills
            (if (= host 0)
              (be_state.CompilerBackendTarget.Linux)
              (be_state.CompilerBackendTarget.Windows))
            (Avx512)
            "__tl_spmd_varying_arg_a=%7:f64, __tl_spmd_varying_arg_b=%15:f32"
            (if (= explicit 0)
              "%0=%r12"
              "%7=spill:-64 %15=spill:-128")
            16)
          (has
            "    vmovupd %zmm17, -64(%rbp)\n"
            "    vmovups %zmm18, -128(%rbp)\n"))
        (return false))))
  true)

(test
  backend-spmd-spilled-varying-entry-initialized
  (test.assert-true
    (compiler-backend-spmd-spilled-varying-entry-ok?)
    "AVX-512 varying frame homes must be initialized from incoming full-width registers"))

;; System V AVX2: the uniforms a..h fill %xmm0-%xmm7, so the f64 i and the f32
;; j arrive on the stack, and the varying x is loaded into %ymm2 -- the old
;; staging register. Both copies run through %xmm8 before the first
;; special-parameter load and before any register homing.
(define (compiler-backend-spmd-entry-copy-linux-avx2-ok?) : bool
  (match (compiler-backend-spmd-entry-copy-spills
    (be_state.CompilerBackendTarget.Linux)
    (Avx2)
    "__tl_spmd_active_mask_avx2=%0:bool, a=%1:f64, b=%2:f64, c=%3:f64, d=%4:f64, e=%5:f64, f=%6:f64, g=%7:f64, h=%8:f64, __tl_spmd_varying_arg_avx2_x=%9:f64, i=%10:f64, j=%11:f32"
    "%1=spill:-208 %2=spill:-216 %3=spill:-224 %4=spill:-232 %5=spill:-240 %6=spill:-248 %7=spill:-256 %8=spill:-264 %9=%ymm2 %10=spill:-272 %11=spill:-280"
    12)
    [(Ok text)
      (and
        (string.is-string-prefix-at
          text
          "    movsd 16(%rbp), %xmm8\n    movsd %xmm8, -272(%rbp)\n    movss 24(%rbp), %xmm8\n    movss %xmm8, -280(%rbp)\n"
          0)
        (asm-has? text "    vmovdqu 32(%r10), %ymm2\n")
        (asm-lacks? text ", %xmm2\n"))]
    [(Err _) false]))

;; Windows Internal AVX2: a..f fill the six positional registers. The frame-homed
;; f64 g and f32 h copy through RAX/EAX before varying inputs and register homes.
;; i, whose home is a register, still loads straight into that home.
(define (compiler-backend-spmd-entry-copy-windows-avx2-ok?) : bool
  (match (compiler-backend-spmd-entry-copy-spills
    (be_state.CompilerBackendTarget.Windows)
    (Avx2)
    "__tl_spmd_active_mask_avx2=%0:bool, a=%1:f64, b=%2:f64, c=%3:f64, d=%4:f64, __tl_spmd_varying_arg_avx2_x=%5:f64, e=%6:f64, f=%7:f64, g=%8:f64, h=%9:f32, i=%10:f64"
    "%1=spill:-208 %2=spill:-216 %3=spill:-224 %4=spill:-232 %5=%ymm2 %6=spill:-240 %7=spill:-248 %8=spill:-256 %9=spill:-264 %10=%xmm7"
    11)
    [(Ok text)
      (and
        (string.is-string-prefix-at
          text
          "    movq 16(%rbp), %rax\n    movq %rax, -256(%rbp)\n    movl 24(%rbp), %eax\n    movl %eax, -264(%rbp)\n"
          0)
        (asm-has?
          text
          "    vmovdqu 32(%r10), %ymm2\n"
          "    movsd 32(%rbp), %xmm7\n")
        (asm-lacks? text ", %xmm2\n"))]
    [(Err _) false]))

;; System V AVX-512: the varying x arrives in %zmm17 and moves to %zmm2. The
;; entry copies run before the opmask entry plan and that move.
(define (compiler-backend-spmd-entry-copy-linux-avx512-ok?) : bool
  (match (compiler-backend-spmd-entry-copy-spills
    (be_state.CompilerBackendTarget.Linux)
    (Avx512)
    "__tl_spmd_active_mask_avx512=%0:bool, a=%1:f64, b=%2:f64, c=%3:f64, d=%4:f64, e=%5:f64, f=%6:f64, g=%7:f64, h=%8:f64, __tl_spmd_varying_arg_avx512_x=%9:f64, i=%10:f64, j=%11:f32"
    "%1=spill:-208 %2=spill:-216 %3=spill:-224 %4=spill:-232 %5=spill:-240 %6=spill:-248 %7=spill:-256 %8=spill:-264 %9=%zmm2 %10=spill:-272 %11=spill:-280"
    12)
    [(Ok text)
      (let
        [mask : i64
          (backend.compiler-backend-string-find-from text "    kmovq %k1, " 0)]
        [varying : i64
          (backend.compiler-backend-string-find-from
            text
            "    vmovupd %zmm17, %zmm2\n"
            0)]
        (and
          (string.is-string-prefix-at
            text
            "    movsd 16(%rbp), %xmm8\n    movsd %xmm8, -272(%rbp)\n    movss 24(%rbp), %xmm8\n    movss %xmm8, -280(%rbp)\n"
            0)
          (> mask 0)
          (> varying mask)
          (asm-lacks? text ", %xmm2\n")))]
    [(Err _) false]))

;; Every incoming operand must be read before any write to it, including the
;; XMM/YMM/ZMM aliases of a physical vector register. These fixtures contain
;; only moves; checking the emitted operands also covers frame and block inputs.
(define (compiler-backend-entry-preserves-inputs?
  [text : (& text str)]
  [sources : (& sources (__tl_dyn-array String))]) : bool
  (for [index (iterator.range 0 (array-length sources))]
    (let
      [source : String (string.copy (& (array-ref sources index)))]
      [read : i64
        (backend.compiler-backend-string-find-from
          text
          (str_cat.str-cat " " (string.copy (& source)) ", ")
          0)]
      [family : i64
        (cabi.compiler-abi-register-vector-family-index
          (cabi.compiler-abi-register-id-from-spelling (string.copy (& source))))]
      [aliases : (__tl_dyn-array String)
        (if (< family 0)
          (__tl_make-array source)
          (__tl_make-array
            (str_cat.str-cat "%xmm" (string.int->string family))
            (str_cat.str-cat "%ymm" (string.int->string family))
            (str_cat.str-cat "%zmm" (string.int->string family))))]
      (when (< read 0) (return false))
      (for [alias-index (iterator.range 0 (array-length aliases))]
        (let
          [write : i64
            (backend.compiler-backend-string-find-from
              text
              (str_cat.str-cat
                ", "
                (string.copy (& (array-ref aliases alias-index)))
                "\n")
              0)]
          (when (and (>= write 0) (< write read)) (return false))))))
  true)

(define (compiler-backend-entry-preservation-oracle-ok?) : bool
  (let
    [sources : (__tl_dyn-array String) (__tl_make-array "%xmm2" "%k1")]
    (and
      (compiler-backend-entry-preserves-inputs?
        "    movss %xmm2, -8(%rbp)\n    kmovq %k1, %k2\n    vmovdqu 32(%r10), %ymm2\n"
        (& sources))
      (not
        (compiler-backend-entry-preserves-inputs?
          "    vmovdqu 32(%r10), %ymm2\n    movss %xmm2, -8(%rbp)\n    kmovq %k1, %k2\n"
          (& sources)))
      (not
        (compiler-backend-entry-preserves-inputs?
          "    vmovupd %zmm17, %zmm2\n    movsd %xmm2, -8(%rbp)\n    kmovq %k1, %k2\n"
          (& sources)))
      (not
        (compiler-backend-entry-preserves-inputs?
          "    movss %xmm0, %xmm2\n    movss %xmm2, -8(%rbp)\n    kmovq %k1, %k2\n"
          (& sources)))
      (not
        (compiler-backend-entry-preserves-inputs?
          "    movss %xmm2, -8(%rbp)\n    kmovq %k2, %k1\n    kmovq %k1, %k3\n"
          (& sources)))
      (not (compiler-backend-entry-preserves-inputs? "" (& sources))))))

;; #9301: special parameters precede and interleave the uniforms. Both float
;; widths have register and frame destinations; the varying homes alias later
;; incoming XMM2/XMM6. AVX2 also has a frame-homed varying value. AVX-512 keeps
;; its active/bool mask swap as one graph. WIN1 remains unchanged.
(define (compiler-backend-spmd-entry-preservation-case?
  [windows? : bool]
  [avx512? : bool]
  [f64? : bool]) : bool
  (let
    [sources : (__tl_dyn-array String)
      (if windows?
        (__tl_make-array
          "%xmm0"
          "%xmm1"
          "%xmm2"
          "%r9"
          "%xmm4"
          "%xmm5"
          "16(%rbp)"
          "24(%rbp)"
          "32(%rbp)"
          "40(%rbp)"
          "48(%rbp)")
        (__tl_make-array
          "%xmm0"
          "%xmm1"
          "%xmm2"
          "%rdi"
          "%xmm3"
          "%xmm4"
          "%xmm5"
          "%xmm6"
          "%xmm7"
          "16(%rbp)"
          "24(%rbp)"))]
    [special-sources : (__tl_dyn-array String)
      (if avx512?
        (__tl_make-array "%k1" "%zmm17" "%k2" "%zmm18")
        (__tl_make-array "0(%r10)" "32(%r10)" "64(%r10)" "96(%r10)"))]
    [first-ty : String
      (if f64?
        "f64"
        "f32")]
    [second-ty : String
      (if f64?
        "f32"
        "f64")]
    [result
      (compiler-backend-spmd-entry-copy-spills
        (if windows?
          (be_state.CompilerBackendTarget.Windows)
          (be_state.CompilerBackendTarget.Linux))
        (if avx512?
          (Avx512)
          (Avx2))
        (str_cat.str-cat
          "__tl_spmd_active_mask=%0:bool, __tl_spmd_varying_arg_x=%1:"
          (string.copy (& first-ty))
          ", a=%2:"
          (string.copy (& first-ty))
          ", __tl_spmd_mask_arg_b=%3:bool, b=%4:"
          (string.copy (& second-ty))
          ", __tl_spmd_varying_arg_y=%5:i64, c=%6:"
          (string.copy (& first-ty))
          ", d=%7:i64, e=%8:"
          (string.copy (& second-ty))
          ", f=%9:"
          (string.copy (& first-ty))
          ", g=%10:"
          (string.copy (& second-ty))
          ", h=%11:"
          (string.copy (& first-ty))
          ", i=%12:"
          (string.copy (& second-ty))
          ", j=%13:"
          first-ty
          ", k=%14:"
          second-ty)
        (str_cat.str-cat
          (if avx512?
            "%0=%k2 %1=%zmm2 %3=%k1 %5=%zmm6 "
            "%0=spill:-32 %1=%ymm2 %3=%ymm6 %5=spill:-96 ")
          "%2=spill:-104 %4=%xmm12 %6=spill:-112 %7=%r12 %8=%xmm11 %9=spill:-120 %10=%xmm10 %11=spill:-128 %12=%xmm9 %13=spill:-136 %14=spill:-144")
        15)]
    (match result
      [(Ok text)
        (and
          (compiler-backend-entry-preserves-inputs? text (& sources))
          (compiler-backend-entry-preserves-inputs? text (& special-sources))
          (asm-lacks? text ", %r10\n")
          (if avx512?
            (asm-has?
              text
              "    kmovq %k1, %k7\n    kmovq %k2, %k1\n    kmovq %k7, %k2\n")
            (asm-has? text "    vmovdqu %ymm14, -96(%rbp)\n")))]
      [(Err _) false])))

(define (compiler-backend-spmd-entry-preservation-ok?) : bool
  (unless (compiler-backend-entry-preservation-oracle-ok?) (return false))
  (for [abi (iterator.range 0 2)]
    (for [mode (iterator.range 0 2)]
      (for [width (iterator.range 0 2)]
        (unless
          (compiler-backend-spmd-entry-preservation-case?
            (= abi 1)
            (= mode 1)
            (= width 1))
          (return false)))))
  true)

(test
  backend-spmd-entry-preserves-every-unread-input
  (test.assert-true
    (compiler-backend-spmd-entry-preservation-ok?)
    "private entry preserves every unread argument and its physical aliases"))

(test
  backend-param-entry-copies-use-volatile-registers
  (test.assert-true
    (and
      (compiler-backend-param-entry-float-copy-linux-ok?)
      (compiler-backend-param-entry-float-copy-windows-ok?)
      (compiler-backend-spmd-entry-copy-linux-avx2-ok?)
      (compiler-backend-spmd-entry-copy-windows-avx2-ok?))
    "entry copies preserve unread inputs and do not borrow nonvolatile XMM6"))

(define (compiler-backend-sse2-select-spilled-mask-case
  [polarity : i64]
  [homes : String]) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (be_state.compiler-backend-set-current-mode!
      (be_state.compiler-backend-state-function-state backend-state)
      (Sse2))
    (be_simd.compiler-backend-emit-avx2-blend
      (ast.ast-node-pool-reader-type-segment-bases)
      (reg-homes homes)
      0
      false
      polarity
      (Var 1)
      (Var 2)
      (Var 3)
      2
      (I64)
      (cdiag.compiler-diagnostic-at-start "" "")
      backend-state)))

(test
  backend-sse2-select-spilled-mask-dst-aliases-sel-true
  ;; When the SSE2 Select mask spills into %xmm0 and dst aliases sel-true,
  ;; copying %xmm0 into dst before `pand sel-true, %xmm0` would clobber
  ;; sel-true. Both normal polarity (sel-true = true-reg) and swapped polarity
  ;; (sel-true = false-reg) must stage the mask in %xmm1 instead.
  (test.assert-true
    (asm-ok?
      (compiler-backend-sse2-select-spilled-mask-case
        0
        "%0=%vec6 %1=spill:-32 %2=%vec6 %3=%vec7")
      (has
        "    movdqu -32(%rbp), %xmm0\n    movdqa %xmm0, %xmm1\n    pand %xmm6, %xmm0\n    pandn %xmm7, %xmm1\n    por %xmm1, %xmm0\n    movdqa %xmm0, %xmm6\n")
      (lacks "    movdqa %xmm0, %xmm6\n    pand %xmm6, %xmm0\n"))
    "SSE2 Select with spilled mask and dst == sel-true stages mask in %xmm1")
  (test.assert-true
    (asm-ok?
      (compiler-backend-sse2-select-spilled-mask-case
        2
        "%0=%vec7 %1=spill:-32 %2=%vec6 %3=%vec7")
      (has
        "    movdqu -32(%rbp), %xmm0\n    movdqa %xmm0, %xmm1\n    pand %xmm7, %xmm0\n    pandn %xmm6, %xmm1\n    por %xmm1, %xmm0\n    movdqa %xmm0, %xmm7\n")
      (lacks "    movdqa %xmm0, %xmm7\n    pand %xmm7, %xmm0\n"))
    "SSE2 Select with swapped polarity, spilled mask, and dst == sel-true stages mask in %xmm1")
  (test.assert-true
    (asm-ok?
      (compiler-backend-sse2-select-spilled-mask-case
        0
        "%0=%vec8 %1=spill:-32 %2=%vec6 %3=%vec7")
      (has
        "    movdqu -32(%rbp), %xmm0\n    movdqa %xmm0, %xmm8\n    pand %xmm6, %xmm0\n    pandn %xmm7, %xmm8\n    por %xmm0, %xmm8\n")
      (lacks "%xmm1"))
    "SSE2 Select with spilled mask and distinct dst keeps the direct path"))

(test
  backend-spmd-sse2-win64-private-param-spill-uses-xmm0
  ;; Private SPMD parameter spills run in the prologue before emergency-save
  ;; setup, so Win64 SSE2 spills must use caller-saved %xmm0 (after uniform
  ;; float args have been homed) and never touch unsaved callee-saved %xmm14.
  (let
    [sources : (__tl_dyn-array String) (__tl_make-array "%xmm0")]
    (match (compiler-backend-spmd-entry-copy-spills
      (be_state.CompilerBackendTarget.Windows)
      (Sse2)
      "__tl_spmd_active_mask=%0:bool, __tl_spmd_varying_arg_x=%1:i64, a=%2:f64, __tl_spmd_varying_arg_y=%3:f64"
      "%0=spill:-32 %1=spill:-48 %2=%xmm7 %3=%xmm2"
      4)
      [(Ok text)
        (test.assert-true
          (and
            (compiler-backend-entry-preserves-inputs? text (& sources))
            (asm-has?
              text
              "    movsd %xmm0, %xmm7\n"
              "    movdqu 0(%r10), %xmm0\n    movdqu %xmm0, -32(%rbp)\n"
              "    movdqu 16(%r10), %xmm0\n    movdqu %xmm0, -48(%rbp)\n"
              "    movdqu 32(%r10), %xmm2\n")
            (asm-lacks? text "%xmm14" "%xmm15"))
          (str_cat.str-cat
            "Win64 SSE2 private SPMD param spill must use %xmm0, not %xmm14: "
            text))]
      [(Err _)
        (test.assert-true
          false
          "Win64 SSE2 private SPMD param spill emission succeeded")])))

(define (compiler-backend-stream-home-keeps-stable-root-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [stream : be_state.CompilerBackendStreamState
      (be_state.compiler-backend-state-stream-state backend-state)]
    [home : arena.Arena (arena.make)]
    [scratch : arena.Arena (arena.make)]
    [_set-home : unit
      (unsafe
        (arena.set! home))]
    ;; Leave eight bytes in the Linux root segment. The first retained chunk
    ;; stays Inline; appending the second chunk forces dense-store materialization
    ;; and grows the home chain without touching 64 MiB of pages. The public
    ;; handle must remain the stable owner root throughout.
    [_fill-home : i64 (compiler-backend-test-runtime-alloc 67108792)]
    [home-before-copy : arena.Arena (arena.current)]
    [_set-scratch : unit
      (unsafe
        (arena.set! scratch))]
    [copied : text_buf.TextBuf
      (in-arena
        home-before-copy
        (text_buf.append (text_buf.append (text_buf.empty) "x") "y"))]
    [_carry-home : unit
      (backend.compiler-backend-assembly-stream-carry-home-current!
        stream
        home-before-copy)]
    [carried-home : arena.Arena (state-assembly-stream-home-arena stream)]
    [ok : bool
      (and
        (arena.eq? (arena.current) scratch)
        (string.eq (text_buf.render copied) "xy")
        (arena.eq? carried-home home-before-copy))]
    (unsafe
      (arena.set! caller))
    (unsafe
      (arena.destroy scratch))
    (unsafe
      (arena.destroy carried-home))
    ok))

(define (compiler-backend-stream-state-interleaving-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [intern-state : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [backend-a : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-state))]
    [backend-b : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [stream-a : be_state.CompilerBackendStreamState
      (be_state.compiler-backend-state-stream-state backend-a)]
    [stream-b : be_state.CompilerBackendStreamState
      (be_state.compiler-backend-state-stream-state backend-b)]
    [home-a : arena.Arena (arena.make)]
    [raw-a : arena.Arena (arena.make)]
    [peephole-a : arena.Arena (arena.make)]
    [home-b : arena.Arena (arena.make)]
    [raw-b : arena.Arena (arena.make)]
    [peephole-b : arena.Arena (arena.make)]
    [raw-mark-a : arena.ArenaMark
      (begin
        (unsafe
          (arena.set! raw-a))
        (arena.mark))]
    [peephole-mark-a : arena.ArenaMark
      (begin
        (unsafe
          (arena.set! peephole-a))
        (arena.mark))]
    [raw-mark-b : arena.ArenaMark
      (begin
        (unsafe
          (arena.set! raw-b))
        (arena.mark))]
    [peephole-mark-b : arena.ArenaMark
      (begin
        (unsafe
          (arena.set! peephole-b))
        (arena.mark))]
    [_set-caller : unit
      (unsafe
        (arena.set! caller))]
    [_reset-a : unit
      (be_state.compiler-backend-peephole-carry-safe-reset-with-backend-state!
        backend-a
        stream-a)]
    [_reset-b : unit
      (be_state.compiler-backend-peephole-carry-safe-reset-with-backend-state!
        backend-b
        stream-b)]
    [_carry-a : unit
      (be_state.compiler-backend-peephole-carry-safe-insert!
        backend-a
        stream-a
        ".Lshared_carry")]
    [_start-a : unit
      (backend.compiler-backend-assembly-stream-start!
        stream-a
        raw-a
        raw-mark-a
        peephole-a
        peephole-mark-a
        home-a)]
    [_start-b : unit
      (backend.compiler-backend-assembly-stream-start!
        stream-b
        raw-b
        raw-mark-b
        peephole-b
        peephole-mark-b
        home-b)]
    [head-a : String ".globl a\na:\n    movq 72(%rsp), %r9\n.Lshared_carry:\n"]
    [head-b : String ".globl b\nb:\n    movq 72(%rsp), %r9\n.Lshared_carry:\n"]
    [tail : String "    movq %r9, 72(%rsp)\n    ret\n"]
    [_a1 : unit
      (backend.compiler-backend-assembly-stream-process-string!
        (owned_view.compiler-owned-shared-view head-a)
        backend-a
        stream-a)]
    [_b1 : unit
      (backend.compiler-backend-assembly-stream-process-string!
        (owned_view.compiler-owned-shared-view head-b)
        backend-b
        stream-b)]
    [_a2 : unit
      (backend.compiler-backend-assembly-stream-process-string!
        (owned_view.compiler-owned-shared-view tail)
        backend-a
        stream-a)]
    [_b2 : unit
      (backend.compiler-backend-assembly-stream-process-string!
        (owned_view.compiler-owned-shared-view tail)
        backend-b
        stream-b)]
    [out-a : text_buf.TextBuf
      (backend.compiler-backend-assembly-stream-finish! backend-a stream-a)]
    [out-b : text_buf.TextBuf
      (backend.compiler-backend-assembly-stream-finish! backend-b stream-b)]
    [got-a : String (text_buf.render out-a)]
    [got-b : String (text_buf.render out-b)]
    [want-a : String (str_cat.str-cat head-a "    ret\n")]
    [want-b : String (str_cat.str-cat head-b tail)]
    [ok : bool
      (and
        (string.eq got-a want-a)
        (string.eq got-b want-b)
        (not (be_facts.compiler-backend-assembly-stream-active? stream-a))
        (not (be_facts.compiler-backend-assembly-stream-active? stream-b)))]
    (backend.compiler-backend-assembly-stream-abort! stream-a)
    (backend.compiler-backend-assembly-stream-abort! stream-b)
    (unsafe
      (arena.set! caller))
    ;; Flushing deliberately clears the backend's legacy function scratch
    ;; sentinels while the raw arena is active. Retire those scratch-backed
    ;; handles in the caller arena before reclaiming either raw stream.
    (backend.compiler-backend-clear-scratch-escaped-emit-state! backend-a)
    (backend.compiler-backend-clear-scratch-escaped-emit-state! backend-b)
    (unsafe
      (arena.destroy raw-a))
    (unsafe
      (arena.destroy peephole-a))
    (unsafe
      (arena.destroy home-a))
    (unsafe
      (arena.destroy raw-b))
    (unsafe
      (arena.destroy peephole-b))
    (unsafe
      (arena.destroy home-b))
    ok))

;; Manual assembly-stream fixture.  Its process operation mirrors production:
;; raw storage is active while a function chunk is appended, then the caller
;; arena is restored so another stream may make progress before this one does.
(defstruct CompilerBackendAssemblyStreamTestSession
  (caller arena.Arena)
  (backend-state be_state.CompilerBackendState)
  (stream be_state.CompilerBackendStreamState)
  (home arena.Arena)
  (raw arena.Arena)
  (raw-mark arena.ArenaMark)
  (peephole arena.Arena)
  (peephole-mark arena.ArenaMark))

(define (compiler-backend-assembly-stream-test-session-new) : CompilerBackendAssemblyStreamTestSession
  (let
    [caller : arena.Arena (arena.current)]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [stream : be_state.CompilerBackendStreamState
      (be_state.compiler-backend-state-stream-state backend-state)]
    [home : arena.Arena (arena.make)]
    [raw : arena.Arena (arena.make)]
    [peephole : arena.Arena (arena.make)]
    [raw-mark : arena.ArenaMark
      (begin
        (unsafe
          (arena.set! raw))
        (arena.mark))]
    [peephole-mark : arena.ArenaMark
      (begin
        (unsafe
          (arena.set! peephole))
        (arena.mark))]
    [_restore : unit
      (unsafe
        (arena.set! caller))]
    [_carry-reset : unit
      (be_state.compiler-backend-peephole-carry-safe-reset-with-backend-state!
        backend-state
        stream)]
    [_sweep-reset : unit
      (backend.compiler-backend-sweep-reset! backend-state stream)]
    [_start : unit
      (backend.compiler-backend-assembly-stream-start!
        stream
        raw
        raw-mark
        peephole
        peephole-mark
        home)]
    (CompilerBackendAssemblyStreamTestSession
      caller
      backend-state
      stream
      home
      raw
      raw-mark
      peephole
      peephole-mark)))

(define (compiler-backend-assembly-stream-test-session-process!
  [session : CompilerBackendAssemblyStreamTestSession]
  [chunk : String]) : unit
  (backend.compiler-backend-assembly-stream-begin-raw!
    session.backend-state
    session.stream)
  (backend.compiler-backend-assembly-stream-process-string!
    chunk
    session.backend-state
    session.stream)
  (unsafe
    (arena.set! session.caller)))

(define (compiler-backend-assembly-stream-test-session-finish-copy
  [session : CompilerBackendAssemblyStreamTestSession]) : String
  (let
    [out : text_buf.TextBuf
      (backend.compiler-backend-assembly-stream-finish!
        session.backend-state
        session.stream)]
    [rendered : String (text_buf.render out)]
    (string.copy rendered)))

(define (compiler-backend-assembly-stream-test-session-destroy!
  [session : CompilerBackendAssemblyStreamTestSession]) : unit
  (backend.compiler-backend-assembly-stream-abort! session.stream)
  (unsafe
    (arena.set! session.caller))
  (backend.compiler-backend-clear-scratch-escaped-emit-state!
    session.backend-state)
  (unsafe
    (arena.destroy session.raw))
  (unsafe
    (arena.destroy session.peephole))
  (unsafe
    (arena.destroy session.home)))

(define (compiler-backend-assembly-stream-test-seed-a!
  [session : CompilerBackendAssemblyStreamTestSession]) : unit
  ;; Model a Linux scalar job and give only A the safe continuation label.
  (be_state.compiler-backend-state-set-scalar-registers-enabled!
    session.backend-state
    true)
  (be_state.compiler-backend-peephole-carry-safe-insert!
    session.backend-state
    session.stream
    ".Lshared_carry")
  ;; The first A group is an audited Linux FPO function.  Its dead slot store
  ;; is swept; B deliberately has the same shape without sweep metadata.
  (backend.compiler-backend-sweep-record-fpo!
    session.stream
    "a_sweep"
    48
    0
    5
    0
    0
    0
    session.backend-state))

(define (compiler-backend-assembly-stream-test-seed-b!
  [session : CompilerBackendAssemblyStreamTestSession]) : unit
  ;; Model a Windows vector job.  These job-local policy bits must survive
  ;; alternating calls through A's differently configured backend state.
  (be_state.compiler-backend-state-set-scalar-registers-enabled!
    session.backend-state
    false))

(define (compiler-backend-assembly-stream-test-chunks [a? : bool]) : (__tl_dyn-array
    String)
  (let
    [chunks : (__tl_dyn-array String) (__tl_make-array String 65)]
    [prefix : String
      (if a?
        "a_fill_"
        "b_fill_")]
    [first : String
      (if a?
        ".globl a_sweep
a_sweep:
    subq $56, %rsp
    movq $1, 40(%rsp)
    movq _tl_stream_global(%rip), %r9
    addq $1, %rax
    movq _tl_stream_global(%rip), %r10
    movq 72(%rsp), %r11
.Lshared_carry:
    movq %r11, 72(%rsp)
    addq $56, %rsp
    ret
"
        ".globl b_keep
b_keep:
    subq $56, %rsp
    movq $1, 40(%rsp)
    movq _tl_stream_global(%rip), %r9
    addq $1, %rax
    movq _tl_stream_global(%rip), %r10
    movq 72(%rsp), %r11
.Lshared_carry:
    movq %r11, 72(%rsp)
    addq $56, %rsp
    ret
")]
    (set! (array-ref chunks 0) first)
    (for [i (iterator.range 1 65)]
      (let
        [suffix : String (string.int->string i)]
        [symbol : String (str_cat.str-cat prefix suffix)]
        (set!
          (array-ref chunks i)
          (str_cat.str-cat
            ".globl "
            symbol
            "\n"
            symbol
            ":\n    movq $"
            suffix
            ", %rax\n    ret\n"))))
    chunks))

(define (compiler-backend-assembly-stream-test-run-serial
  [chunks : (__tl_dyn-array String)]
  [a? : bool]) : String
  (let
    [session : CompilerBackendAssemblyStreamTestSession
      (compiler-backend-assembly-stream-test-session-new)]
    (if a?
      (compiler-backend-assembly-stream-test-seed-a! session)
      (compiler-backend-assembly-stream-test-seed-b! session))
    (for [i (iterator.range 0 (array-length chunks))]
      (compiler-backend-assembly-stream-test-session-process!
        session
        (ir.compiler-ir-array-shared-view chunks i)))
    (let
      [out : String
        (compiler-backend-assembly-stream-test-session-finish-copy session)]
      (compiler-backend-assembly-stream-test-session-destroy! session)
      out)))

;; Cross the production 64-function batch boundary while A and B alternate.
;; Abort B after seven pending chunks, keep A live, and replay B in a new stream.
;; Both final byte streams must equal their serial executions.  The first groups
;; additionally prove that carry labels, stack/global owners and ordered sweep
;; metadata cannot leak between the two differently configured backend jobs.
(define (compiler-backend-stream-state-bounded-interleaving-ok?) : bool
  (let
    [chunks-a : (__tl_dyn-array String)
      (compiler-backend-assembly-stream-test-chunks true)]
    [chunks-b : (__tl_dyn-array String)
      (compiler-backend-assembly-stream-test-chunks false)]
    [serial-a : String
      (compiler-backend-assembly-stream-test-run-serial
        (owned_view.compiler-owned-shared-view chunks-a)
        true)]
    [serial-b : String
      (compiler-backend-assembly-stream-test-run-serial
        (owned_view.compiler-owned-shared-view chunks-b)
        false)]
    [session-a : CompilerBackendAssemblyStreamTestSession
      (compiler-backend-assembly-stream-test-session-new)]
    [failed-b : CompilerBackendAssemblyStreamTestSession
      (compiler-backend-assembly-stream-test-session-new)]
    [_seed-a : unit (compiler-backend-assembly-stream-test-seed-a! session-a)]
    [_seed-failed-b : unit
      (compiler-backend-assembly-stream-test-seed-b! failed-b)]
    [i : i64 0]
    (while (< i 7)
      (compiler-backend-assembly-stream-test-session-process!
        session-a
        (ir.compiler-ir-array-shared-view chunks-a i))
      (compiler-backend-assembly-stream-test-session-process!
        failed-b
        (ir.compiler-ir-array-shared-view chunks-b i))
      (+= i 1))
    (compiler-backend-assembly-stream-test-session-destroy! failed-b)
    (let
      [session-b : CompilerBackendAssemblyStreamTestSession
        (compiler-backend-assembly-stream-test-session-new)]
      [_seed-b : unit (compiler-backend-assembly-stream-test-seed-b! session-b)]
      (for [replay (iterator.range 0 7)]
        (compiler-backend-assembly-stream-test-session-process!
          session-b
          (ir.compiler-ir-array-shared-view chunks-b replay)))
      (while (< i 65)
        (compiler-backend-assembly-stream-test-session-process!
          session-a
          (ir.compiler-ir-array-shared-view chunks-a i))
        (compiler-backend-assembly-stream-test-session-process!
          session-b
          (ir.compiler-ir-array-shared-view chunks-b i))
        (+= i 1))
      (let
        [out-a : String
          (compiler-backend-assembly-stream-test-session-finish-copy session-a)]
        [out-b : String
          (compiler-backend-assembly-stream-test-session-finish-copy session-b)]
        [ok : bool
          (and
            (string.eq out-a serial-a)
            (string.eq out-b serial-b)
            (asm-lacks? out-a "    movq $1, 40(%rsp)\n")
            (asm-has? out-b "    movq $1, 40(%rsp)\n")
            (asm-lacks? out-a "    movq %r11, 72(%rsp)\n")
            (asm-has? out-b "    movq %r11, 72(%rsp)\n")
            (asm-has? out-a "    movq %r9, %r10\n")
            (asm-has? out-b "    movq %r9, %r10\n")
            (be_state.compiler-backend-state-scalar-registers-enabled?
              session-a.backend-state)
            (not
              (be_state.compiler-backend-state-scalar-registers-enabled?
                session-b.backend-state)))]
        (compiler-backend-assembly-stream-test-session-destroy! session-a)
        (compiler-backend-assembly-stream-test-session-destroy! session-b)
        ok))))

;; A nested batch flush may grow peephole-owned storage.  The assembly stream
;; must preserve the nested pass's newly published handles/counts when it then
;; publishes its own output cursor.  More than 1 KiB of distinct global keys
;; exercises the owner-byte growth that caught the stale aggregate write.
(define (compiler-backend-stream-flush-preserves-grown-state-ok?) : bool
  (let
    [session : CompilerBackendAssemblyStreamTestSession
      (compiler-backend-assembly-stream-test-session-new)]
    [body : text_buf.TextBuf
      (text_buf.append
        (text_buf.empty)
        ".globl stream_growth\nstream_growth:\n")]
    (for [i (iterator.range 0 128)]
      (set!
        body
        (text_buf.append
          body
          (str_cat.str-cat
            "    movq very_long_stream_owner_global_symbol_"
            (string.int->string i)
            "(%rip), %rax\n"))))
    (set! body (text_buf.append body "    ret\n"))
    (compiler-backend-assembly-stream-test-session-process!
      session
      (text_buf.render body))
    (let
      [out : String
        (compiler-backend-assembly-stream-test-session-finish-copy session)]
      [ok : bool
        (and
          (>= (compiler-backend-stream-state-owner-capacity session.stream) 128)
          (>=
            (compiler-backend-stream-state-owner-bytes-capacity session.stream)
            4096)
          (asm-has? out "very_long_stream_owner_global_symbol_127(%rip)"))]
      (compiler-backend-assembly-stream-test-session-destroy! session)
      ok)))

(define (compiler-backend-stream-state-growth-ok?) : bool
  (let
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    [backend-state : be_state.CompilerBackendState session.backend-state]
    [stream : be_state.CompilerBackendStreamState session.stream]
    [idle? : bool
      (= (compiler-backend-stream-state-retained-table-bytes stream) 0)]
    [_reset : unit (compiler-backend-peephole-test-session-reset! session)]
    (for [i (iterator.range 0 600)]
      (be_state.compiler-backend-peephole-carry-safe-insert!
        backend-state
        stream
        (str_cat.str-cat ".Lcarry_growth_" (string.int->string i))))
    (let
      [last : String ".Lcarry_growth_599"]
      [carry-grew? : bool
        (and
          (>= (compiler-backend-stream-state-carry-capacity stream) 1024)
          (>= (compiler-backend-stream-state-carry-bytes-capacity stream) 16384)
          (compiler-backend-peephole-carry-safe-contains-bytes?
            stream
            (unsafe
              (string-data last))
            0
            (string.string-length last)
            (ci.intern-hash last)))]
      [owner-input : text_buf.TextBuf (text_buf.empty)]
      (for [i (iterator.range 0 128)]
        (set!
          owner-input
          (text_buf.append
            owner-input
            (str_cat.str-cat
              "    movq very_long_owner_global_symbol_"
              (string.int->string i)
              "(%rip), %rax\n"))))
      (let
        [_owner-output : String
          (compiler-backend-peephole-test-session-asm
            session
            (text_buf.render owner-input))]
        [owner-grew? : bool
          (and
            (>= (compiler-backend-stream-state-owner-capacity stream) 128)
            (>=
              (compiler-backend-stream-state-owner-bytes-capacity stream)
              4096))]
        (backend.compiler-backend-sweep-reset! backend-state stream)
        (for [i (iterator.range 0 200)]
          (backend.compiler-backend-sweep-record-win64!
            backend-state
            stream
            (str_cat.str-cat
              "very_long_sweep_function_symbol_"
              (string.int->string i))
            48
            1
            0
            0
            0))
        (let
          [sweep-grew? : bool
            (and
              (>= (compiler-backend-stream-state-sweep-capacity stream) 256)
              (>=
                (compiler-backend-stream-state-sweep-bytes-capacity stream)
                8192))]
          [_coverage-reset : unit
            (backend.compiler-backend-sweep-reset! backend-state stream)]
          [_coverage-record : unit
            (compiler-backend-peephole-test-session-win64!
              session
              "coverage"
              8192
              1024
              0
              0
              0)]
          [_coverage-output : String
            (compiler-backend-peephole-test-session-asm
              session
              "coverage:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $8192, %rsp\n    movq $1, 8184(%rsp)\n    leave\n    ret\n")]
          [coverage-grew? : bool
            (>= (compiler-backend-stream-state-coverage-capacity stream) 128)]
          (and
            idle?
            carry-grew?
            owner-grew?
            sweep-grew?
            coverage-grew?
            (= (compiler-backend-stream-state-record-capacity stream) 0)))))))

;; The byte-derived record estimate deliberately targets normal generated
;; assembly. Blank lines force the geometric fallback several times; their
;; byte-exact output must survive and the stream must retire the grown arrays
;; before its peephole arena is rewound.
(define (compiler-backend-stream-record-growth-ok?) : bool
  (let
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    [input : text_buf.TextBuf (text_buf.empty)]
    (for [i (iterator.range 0 128)]
      (set! input (text_buf.append input "\n")))
    (let
      [expected : String (text_buf.render input)]
      [actual : String
        (compiler-backend-peephole-test-session-asm
          session
          (owned_view.compiler-owned-shared-view expected))]
      [retired? : bool
        (= (compiler-backend-stream-state-record-capacity session.stream) 0)]
      (and retired? (string.eq actual expected)))))

;; A reusable backend owner may be retargeted between emissions, while two
;; independently prepared owners retain isolated ABI and mode decisions.
;; ABT-1: the located runtime-abort tail's two `pushq`es are a dip on a path
;; that ends in a call which never returns to this function, so the local slots
;; they reach are dead there and compiler-backend-red-zone-decide! must not
;; charge the guard for them. Every OTHER dip -- a c-ABI window, a phi
;; cycle-break push, a real `subq` -- still counts in full, and so does a
;; staging marker whose continuation turns out to return.
(define (compiler-backend-abort-tail-dip-body [tail : String]) : String
  (str_cat.str-cat
    "    cmpq %rsi, %rax\n"
    "    jb .Lprobe_ok.0\n"
    tail
    ".Lprobe_ok.0:\n"
    "    movq -8(%rsp), %rax\n"
    "    ret\n"))

(define (compiler-backend-abort-tail-dip-located-tail [call-line : String]) : String
  (str_cat.str-cat
    "    pushq %rsi\n"
    "    pushq %rax\n"
    "    # tl_abort_operand_stage\n"
    "    popq %rsi\n"
    "    popq %rdx\n"
    call-line
    ".L_tl_abort_site_1_bounds:\n"
    "    .tl_abort_row .L_tl_abort_site_1_bounds, .L_tl_str_fat_probe, 34, 56, tl_oob_abort_at\n"))

(define (compiler-backend-abort-tail-dip-red-zone?
  [text : (& text str)]
  [frame : i64]) : bool
  (let
    [intern-state : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [linux : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-target-policy-new
        be_state.CompilerBackendTarget.Linux)]
    [_install : unit
      (begin
        (be_state.compiler-backend-state-set-emission-target-policy!
          state
          linux)
        (be_state.compiler-backend-set-current-fn-abi! state linux.abi)
        (be_peephole.compiler-backend-red-zone-decide!
          state
          text
          true
          frame
          0
          false))]
    (be_operand.compiler-backend-red-zone? state)))

(define (compiler-backend-red-zone-abort-tail-dip-ok?) : bool
  (let
    ;; The whole body's only stack motion is one located bounds abort tail.
    [abort-only : String
      (compiler-backend-abort-tail-dip-body
        (compiler-backend-abort-tail-dip-located-tail
          "    call .L_tl_abort_tl_oob_abort_at\n"))]
    ;; The same shape whose continuation RETURNS: not a never-returning path,
    ;; so its dip is owed in full.
    [returning : String
      (compiler-backend-abort-tail-dip-body
        (compiler-backend-abort-tail-dip-located-tail
          "    call _tl_probe_helper\n"))]
    ;; An ordinary c-ABI dip window: two pushes around a call that returns.
    [window : String
      (compiler-backend-abort-tail-dip-body
        (str_cat.str-cat
          "    pushq %rsi\n"
          "    pushq %rax\n"
          "    call _tl_probe_helper\n"
          "    popq %rax\n"
          "    popq %rsi\n"))]
    ;; A real 8-byte window that CLOSES before the abort tail opens: the tail's
    ;; own 16 bytes drop out, the window's 8 do not.
    [window-then-abort : String
      (compiler-backend-abort-tail-dip-body
        (str_cat.str-cat
          "    pushq %rcx\n"
          "    call _tl_probe_helper\n"
          "    popq %rcx\n"
          (compiler-backend-abort-tail-dip-located-tail
            "    call .L_tl_abort_tl_oob_abort_at\n")))]
    ;; ...and one that is still OPEN when the tail opens: the third push
    ;; displaces it out of the pending window before the marker can hold it.
    [open-window-then-abort : String
      (compiler-backend-abort-tail-dip-body
        (str_cat.str-cat
          "    pushq %rcx\n"
          (compiler-backend-abort-tail-dip-located-tail
            "    call .L_tl_abort_tl_oob_abort_at\n")))]
    ;; A bare (unlocated) abort pushes nothing, so an unrelated open window in
    ;; front of it must still be counted: no staging marker, nothing held.
    [bare-abort : String
      (compiler-backend-abort-tail-dip-body
        (str_cat.str-cat
          "    pushq %rcx\n"
          "    pushq %rdx\n"
          "    call tl_oob_abort\n"))]
    (and
      ;; The dips themselves.
      (= (be_peephole.compiler-backend-text-max-rsp-dip abort-only) 0)
      (= (be_peephole.compiler-backend-text-max-rsp-dip returning) 16)
      (= (be_peephole.compiler-backend-text-max-rsp-dip window) 16)
      (= (be_peephole.compiler-backend-text-max-rsp-dip window-then-abort) 8)
      (=
        (be_peephole.compiler-backend-text-max-rsp-dip open-window-then-abort)
        8)
      (= (be_peephole.compiler-backend-text-max-rsp-dip bare-abort) 16)
      ;; ...and the decision they feed, at a frame that fits the 128-byte red
      ;; zone on its own and cannot afford a 16-byte guard on top.
      (compiler-backend-abort-tail-dip-red-zone? abort-only 120)
      (compiler-backend-abort-tail-dip-red-zone? abort-only 128)
      (not (compiler-backend-abort-tail-dip-red-zone? returning 120))
      (not (compiler-backend-abort-tail-dip-red-zone? window 120))
      (not (compiler-backend-abort-tail-dip-red-zone? window-then-abort 120))
      (not (compiler-backend-abort-tail-dip-red-zone? bare-abort 120))
      ;; A body with no stack motion at all is unaffected either way.
      (compiler-backend-abort-tail-dip-red-zone? window 96))))

(define (compiler-backend-target-policy-isolation-ok?) : bool
  (let
    [intern-state : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [state-a : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-state))]
    [state-b : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [linux : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-target-policy-new
        be_state.CompilerBackendTarget.Linux)]
    [windows : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-target-policy-new
        be_state.CompilerBackendTarget.Windows)]
    [_install : unit
      (begin
        (be_state.compiler-backend-state-set-emission-target-policy!
          state-a
          linux)
        (be_state.compiler-backend-state-set-emission-target-policy!
          state-b
          windows)
        (be_state.compiler-backend-set-current-mode!
          (be_state.compiler-backend-state-function-state state-a)
          Scalar)
        (be_state.compiler-backend-set-current-mode!
          (be_state.compiler-backend-state-function-state state-b)
          Avx2)
        (be_state.compiler-backend-set-current-fn-abi! state-a linux.abi)
        (be_state.compiler-backend-set-current-fn-abi! state-b windows.abi))]
    [a-before : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-state-emission-target-policy state-a)]
    [b-before : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-state-emission-target-policy state-b)]
    [a-win64-before : bool (state-current-fn-win64 state-a)]
    [a-mode-before : be_state.CompilerBackendMode (state-current-mode state-a)]
    [b-mode-before : be_state.CompilerBackendMode (state-current-mode state-b)]
    [a-entry-before : String
      (be_scalar.compiler-backend-emit-function-entry
        a-before
        "_tl_policy_a"
        4800
        (regalloc.compiler-reg-assignment-table-empty)
        0
        false
        state-a)]
    [b-entry-before : String
      (be_scalar.compiler-backend-emit-function-entry
        b-before
        "_tl_policy_b"
        4800
        (regalloc.compiler-reg-assignment-table-empty)
        0
        false
        state-b)]
    [_retarget-a : unit
      (begin
        (be_state.compiler-backend-state-set-emission-target-policy!
          state-a
          windows)
        (be_state.compiler-backend-set-current-mode!
          (be_state.compiler-backend-state-function-state state-a)
          Avx512)
        (be_state.compiler-backend-set-current-fn-abi! state-a windows.abi))]
    [a-after : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-state-emission-target-policy state-a)]
    [b-after : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-state-emission-target-policy state-b)]
    [a-entry-after : String
      (be_scalar.compiler-backend-emit-function-entry
        a-after
        "_tl_policy_a"
        4800
        (regalloc.compiler-reg-assignment-table-empty)
        0
        false
        state-a)]
    [b-entry-after : String
      (be_scalar.compiler-backend-emit-function-entry
        b-after
        "_tl_policy_b"
        4800
        (regalloc.compiler-reg-assignment-table-empty)
        0
        false
        state-b)]
    (and
      a-before.linux
      (not a-before.windows)
      a-before.red-zone
      a-before.linux-syscall
      (not a-before.stack-probe)
      (not a-win64-before)
      (cabi.compiler-abi-linux? a-before.abi)
      (= a-before.gp-arg-register-count 6)
      (= a-before.float-arg-register-count 8)
      (= a-before.outgoing-shadow-space 0)
      (match a-before.object-format
        [(Elf) true]
        [_ false])
      (match a-mode-before
        [(Scalar) true]
        [_ false])
      (asm-lacks? a-entry-before ".seh_proc" "__chkstk")
      b-before.windows
      (not b-before.linux)
      b-before.seh-unwind
      b-before.stack-probe
      (not b-before.red-zone)
      (cabi.compiler-abi-windows? b-before.abi)
      (= b-before.gp-arg-register-count 4)
      (= b-before.float-arg-register-count 4)
      (= b-before.outgoing-shadow-space 32)
      (match b-before.object-format
        [(Coff) true]
        [_ false])
      (match b-mode-before
        [(Avx2) true]
        [_ false])
      (asm-has? b-entry-before ".seh_proc _tl_policy_b" "callq __chkstk")
      a-after.windows
      (state-current-fn-win64 state-a)
      b-after.windows
      (string.eq b-entry-before b-entry-after)
      (asm-has? a-entry-after ".seh_proc _tl_policy_a" "callq __chkstk")
      (state-current-fn-win64 state-b)
      (be_state.compiler-backend-mode-avx2? (state-current-mode state-b))
      (not (be_state.compiler-backend-mode-avx2? (state-current-mode state-a))))))

(define (compiler-backend-test-register-mask [regs : (__tl_dyn-array i64)]) : i64
  (let
    [mask : i64 0]
    (for [index (iterator.range 0 (array-length regs))]
      (set!
        mask
        (bit-or
          mask
          (be_operand.compiler-backend-scavenge-reg-id-bit
            (array-ref regs index)))))
    mask))

;; Function-local traversal state must follow the backend job, even when two
;; jobs reuse the same numeric ids and are interleaved. Resetting a failed job
;; must likewise leave the other job's continuation state intact.
(define (compiler-backend-function-state-isolation-ok?) : bool
  (let
    [intern-state : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [state-a : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-state))]
    [state-b : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-state))]
    [failure-state-a : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-state))]
    [plan-state-a : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-state))]
    [plan-state-b : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [function-a : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state state-a)]
    [function-b : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state state-b)]
    [plan-function-a : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state plan-state-a)]
    [forward-a : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [forward-b : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [uses-a : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [uses-b : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [free-a : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [free-b : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [labels-a : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [labels-b : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [scratch-occupied-a : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [scratch-inject-labels-b : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [scratch-inject-texts-b : (__tl_dyn-array String)
      (__tl_make-array String 1)]
    [scratch-inject-pres-b : (__tl_dyn-array bool) (__tl_make-array bool 1)]
    [b-instrs : ir.CompilerIrInstrSeq
      (compiler-backend-inline-fast-alloc-reused-vreg-instrs)]
    [_configure : unit
      (begin
        (compiler-backend-test-mark-entry-loop! function-b)
        (set! (array-ref forward-a 4) 17)
        (set! (array-ref forward-b 4) 29)
        (set! (array-ref uses-a 4) 31)
        (set! (array-ref uses-b 4) 37)
        (set! (array-ref free-a 4) 41)
        (set! (array-ref free-b 4) 43)
        (set! (array-ref labels-a 0) 4)
        (set! (array-ref labels-b 0) 9)
        (be_state.compiler-backend-set-current-mode! function-a (Avx2))
        (be_state.compiler-backend-set-current-mode! function-b (Scalar))
        (compiler-backend-set-current-fn-win64! state-a)
        (compiler-backend-set-current-fn-linux! state-b)
        (be_facts.compiler-backend-current-slot-vars-set! state-a 17)
        (be_facts.compiler-backend-current-slot-vars-set! state-b 23)
        (be_facts.compiler-backend-group-vars-enable!
          state-a
          (compiler_liveness.compiler-live-set1 4)
          (compiler_liveness.compiler-live-set-empty))
        (be_facts.compiler-backend-group-vars-enable!
          state-b
          (compiler_liveness.compiler-live-set-empty)
          (compiler_liveness.compiler-live-set-empty))
        (set-state-addr-of-forwarding-enabled! state-a true)
        (set-state-addr-of-forwarding-enabled! state-b false)
        (set-state-addr-of-forwarding-src! state-a forward-a)
        (set-state-addr-of-forwarding-src! state-b forward-b)
        (set-state-fuse-need-ready! state-a true)
        (set-state-fuse-need-ready! state-b false)
        (set-state-fuse-use-counts! state-a uses-a)
        (set-state-fuse-use-counts! state-b uses-b)
        (set-state-fuse-free-counts! state-a free-a)
        (set-state-fuse-free-counts! state-b free-b)
        (set-state-emit-instr-post-base! state-a 19)
        (set-state-emit-instr-post-base! state-b 31)
        (set-state-emit-current-count! state-a 7)
        (set-state-emit-current-count! state-b 11)
        (set-state-emit-current-site! state-a 4)
        (set-state-emit-current-site! state-b 4)
        (set-state-emit-instrs-loop-active! state-a true)
        (set-state-emit-instrs-loop-active! state-b false)
        (set-state-emit-instrs-continue-pending! state-a false)
        (set-state-emit-instrs-continue-pending! state-b true)
        (set-state-identity-tail-forwarder-active! state-a true)
        (set-state-identity-tail-forwarder-active! state-b false)
        (set-state-current-phi-targets!
          state-a
          (be_state.BackendSymbolSeq labels-a 1))
        (set-state-current-phi-targets!
          state-b
          (be_state.BackendSymbolSeq labels-b 1))
        ;; Use the same metric ids in both owners with deliberately different
        ;; observations. These setters target the phi metric slots, not a
        ;; functional backend-state field.
        (cfg
          test
          (begin
            (set-state-phi-xmm-cycle-register-count! state-a 11)
            (set-state-phi-xmm-cycle-register-count! state-b 29)
            (set-state-phi-xmm-cycle-fallback-count! state-a 41)
            (set-state-phi-xmm-cycle-fallback-count! state-b 43))
          unit))]
    [plan-gep-before-reset : bool
      (compiler-backend-test-register-plan-gep-isolation-stage!
        plan-state-a
        plan-state-b)]
    [_reset-plan-a : unit
      (be_state.compiler-backend-function-state-reset! plan-function-a)]
    [plan-gep-after-reset : bool
      (compiler-backend-test-register-plan-gep-isolation-reset-ok?
        plan-state-a
        plan-state-b)]
    [metrics-before-reset : bool
      (cfg
        test
        (and
          (= (state-phi-xmm-cycle-register-count state-a) 11)
          (= (state-phi-xmm-cycle-register-count state-b) 29)
          (= (state-phi-xmm-cycle-fallback-count state-a) 41)
          (= (state-phi-xmm-cycle-fallback-count state-b) 43))
        true)]
    [_reset-metrics-a : unit
      (cfg
        test
        (begin
          (set-state-phi-xmm-cycle-register-count! state-a 0)
          (set-state-phi-xmm-cycle-fallback-count! state-a 0))
        unit)]
    [rsp-push-regs : (__tl_dyn-array String)
      (be_peephole.compiler-backend-rsp-rebase-make-push-regs)]
    [rsp-success-b : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        "    leave\n    ret\n"
        0
        true
        (owned_view.compiler-owned-shared-view rsp-push-regs)
        0
        0
        state-b)]
    [rsp-failure-a : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        "    syscall\n    leave\n    ret\n"
        0
        true
        rsp-push-regs
        0
        0
        state-a)]
    [metrics-after-failure : bool
      (and
        rsp-success-b.ok
        (not rsp-failure-a.ok)
        (cfg
          test
          (and
            (= (state-phi-xmm-cycle-register-count state-a) 0)
            (= (state-phi-xmm-cycle-fallback-count state-a) 0)
            (= (state-phi-xmm-cycle-register-count state-b) 29)
            (= (state-phi-xmm-cycle-fallback-count state-b) 43)
            (not (state-rsp-rebase-last-ok state-a))
            (state-rsp-rebase-last-ok state-b))
          true))]
    [before-reset : bool
      (and
        (be_state.compiler-backend-mode-avx2? (state-current-mode state-a))
        (be_state.compiler-backend-mode-scalar? (state-current-mode state-b))
        (state-current-fn-win64 state-a)
        (not (state-current-fn-win64 state-b))
        (= (state-current-slot-vars state-a) 17)
        (= (state-current-slot-vars state-b) 23)
        (let
          [test-get-compiler-backend-group-vars (state-group-vars state-a)]
          (compiler_liveness.compiler-live-set-contains?
            test-get-compiler-backend-group-vars
            4))
        (not
          (let
            [test-get-compiler-backend-group-vars (state-group-vars state-b)]
            (compiler_liveness.compiler-live-set-contains?
              test-get-compiler-backend-group-vars
              4)))
        (state-addr-of-forwarding-enabled state-a)
        (not (state-addr-of-forwarding-enabled state-b))
        (= (array-ref (state-addr-of-forwarding-src state-a) 4) 17)
        (= (array-ref (state-addr-of-forwarding-src state-b) 4) 29)
        (state-fuse-need-ready state-a)
        (not (state-fuse-need-ready state-b))
        (= (array-ref (state-fuse-use-counts state-a) 4) 31)
        (= (array-ref (state-fuse-use-counts state-b) 4) 37)
        (= (array-ref (state-fuse-free-counts state-a) 4) 41)
        (= (array-ref (state-fuse-free-counts state-b) 4) 43)
        (= (state-emit-instr-post-base state-a) 19)
        (= (state-emit-instr-post-base state-b) 31)
        (= (state-emit-current-count state-a) 7)
        (= (state-emit-current-count state-b) 11)
        (state-emit-instrs-loop-active state-a)
        (not (state-emit-instrs-loop-active state-b))
        (not (state-emit-instrs-continue-pending state-a))
        (state-emit-instrs-continue-pending state-b)
        (state-identity-tail-forwarder-active state-a)
        (not (state-identity-tail-forwarder-active state-b))
        (= (__tl-project-field (state-current-phi-targets state-a) len) 1)
        (=
          (array-ref
            (__tl-project-field (state-current-phi-targets state-b) slots)
            0)
          9))]
    [b-before : be_state.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        (owned_view.compiler-owned-shared-view b-instrs)
        (regalloc.compiler-reg-assignment-table-empty)
        5
        (be_state.CompilerBackendTarget.Linux)
        state-b)]
    [scratch-all-mask-a : i64
      (bit-or
        (compiler-backend-test-register-mask
          (be_operand.compiler-backend-scavenge-candidates))
        (compiler-backend-test-register-mask
          (be_operand.compiler-backend-scavenge-xmm-candidates)))]
    [_scratch-configure : unit
      (begin
        (set! (array-ref scratch-occupied-a 0) scratch-all-mask-a)
        (set! (array-ref scratch-occupied-a 1) scratch-all-mask-a)
        (set! (array-ref scratch-inject-labels-b 0) 73)
        (set! (array-ref scratch-inject-texts-b 0) "B_CONST\n")
        (set! (array-ref scratch-inject-pres-b 0) false)
        (be_state.compiler-backend-function-state-set-emit-instr-post-base!
          function-a
          0)
        (be_state.compiler-backend-function-state-set-emit-current-count!
          function-a
          0)
        (be_state.compiler-backend-set-current-mode! function-a (Avx2))
        (backend.compiler-backend-set-scavenge-ctx-ready!
          function-a
          (__tl_make-array i64 0)
          (__tl_make-array i64 0)
          (regalloc.compiler-reg-assignment-table-empty)
          0
          scratch-occupied-a
          0)
        (be_state.compiler-backend-function-scratch-set-i64!
          function-a
          be_state.compiler-backend-scratch-i64-emergency-slot-offset
          -1024)
        (be_state.compiler-backend-function-scratch-set-i64!
          function-b
          be_state.compiler-backend-scratch-i64-scavenge-plan-reg-mask
          291)
        (be_state.compiler-backend-function-scratch-set-i64!
          function-b
          be_state.compiler-backend-scratch-i64-current-instr-reserved-mask
          1110)
        (be_state.compiler-backend-function-scratch-set-i64!
          function-b
          be_state.compiler-backend-scratch-i64-emergency-used-count
          3)
        (be_state.compiler-backend-function-scratch-set-i64!
          function-b
          be_state.compiler-backend-scratch-i64-cycle-temp-used-count
          2)
        (be_state.compiler-backend-function-scratch-set-i64!
          function-b
          be_state.compiler-backend-scratch-i64-const-hoist-inject-count
          1)
        (be_state.compiler-backend-function-scratch-set-i64-array!
          function-b
          be_state.compiler-backend-scratch-i64-array-const-hoist-inject-labels
          scratch-inject-labels-b)
        (be_state.compiler-backend-function-scratch-set-string-array!
          function-b
          be_state.compiler-backend-scratch-string-array-const-hoist-inject-texts
          scratch-inject-texts-b)
        (be_state.compiler-backend-function-scratch-set-bool-array!
          function-b
          be_state.compiler-backend-scratch-bool-array-const-hoist-inject-pres
          scratch-inject-pres-b))]
    [fixed-excludes : (__tl_dyn-array String)
      (__tl_make-array "%rcx" "%rax" "%rdx")]
    [scratch-gp-a : String
      (be_operand.compiler-backend-scavenge-reg-here
        fixed-excludes
        3
        "%r8"
        state-a)]
    [scratch-xmm-a : String
      (be_operand.compiler-backend-scavenge-xmm-reg
        -1
        (__tl_make-array String 0)
        0
        "%xmm2"
        state-a)]
    ;; T1-6 (b) drops a save/restore pair whose bracketed text provably never
    ;; touches the borrowed register, so name the scavenged GP scratch in it.
    [scratch-wrap-a : String
      (be_scalar.compiler-backend-emergency-wrap
        (str_cat.str-cat "A_BODY " scratch-gp-a "\n")
        state-a)]
    [scratch-cycle-a0 : String
      (be_scalar.compiler-backend-cycle-temp-slot-with-backend-state state-a 0)]
    [scratch-cycle-a1 : String
      (be_scalar.compiler-backend-cycle-temp-slot-with-backend-state state-a 1)]
    [scratch-b-output-before : String
      (be_scalar.compiler-backend-const-hoist-injection-for function-b 73 false)]
    [scratch-before-reset : bool
      (and
        (not (string.eq scratch-gp-a "%rcx"))
        (not (string.eq scratch-gp-a "%rax"))
        (not (string.eq scratch-gp-a "%rdx"))
        (not (string.eq scratch-xmm-a ""))
        (asm-has? scratch-wrap-a "movq" "vmovdqu")
        (not (string.eq scratch-cycle-a0 scratch-cycle-a1))
        (=
          (be_state.compiler-backend-function-scratch-i64
            function-a
            be_state.compiler-backend-scratch-i64-emergency-used-count)
          2)
        (=
          (be_state.compiler-backend-function-scratch-i64
            function-a
            be_state.compiler-backend-scratch-i64-cycle-temp-used-count)
          2)
        (string.eq scratch-b-output-before "B_CONST\n"))]
    [_reset-failed-a : unit
      (be_state.compiler-backend-function-state-reset! function-a)]
    [failure-result : be_state.ResultCompilerBackendBuffer
      (backend.compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
        failure-state-a
        (ast.ast-node-pool-reader-type-segment-bases)
        (compiler-backend-switch-bad-shape-program)
        (be_state.CompilerBackendTarget.Windows)
        (Avx2)
        (ir.compiler-source-spans-empty)
        false
        false
        false
        (profile_state.compiler-profile-state-new))]
    [failure-ok : bool
      (match failure-result
        [(Err diag)
          (string.eq
            (cdiag.compiler-diagnostic-message (__tl-box-place diag))
            (be_facts.compiler-backend-switch-shape-message))]
        [(Ok _) false])]
    [failure-retired : bool
      (not
        (be_state.compiler-backend-state-function-state-active? failure-state-a))]
    [_clear-retired : unit
      (backend.compiler-backend-clear-function-emit-state! failure-state-a)]
    [retired-stays-retired : bool
      (not
        (be_state.compiler-backend-state-function-state-active? failure-state-a))]
    [scratch-b-output-after : String
      (be_scalar.compiler-backend-const-hoist-injection-for function-b 73 false)]
    [scratch-after-failure : bool
      (and
        (=
          (be_state.compiler-backend-function-scratch-i64
            function-b
            be_state.compiler-backend-scratch-i64-scavenge-plan-reg-mask)
          291)
        (=
          (be_state.compiler-backend-function-scratch-i64
            function-b
            be_state.compiler-backend-scratch-i64-current-instr-reserved-mask)
          1110)
        (=
          (be_state.compiler-backend-function-scratch-i64
            function-b
            be_state.compiler-backend-scratch-i64-emergency-used-count)
          3)
        (=
          (be_state.compiler-backend-function-scratch-i64
            function-b
            be_state.compiler-backend-scratch-i64-cycle-temp-used-count)
          2)
        (string.eq scratch-b-output-after scratch-b-output-before))]
    [b-after : be_state.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        b-instrs
        (regalloc.compiler-reg-assignment-table-empty)
        5
        (be_state.CompilerBackendTarget.Linux)
        state-b)]
    [b-bytes-stable : bool
      (match b-before
        [(Ok before-asm)
          (match b-after
            [(Ok after-asm)
              (and
                (string.eq before-asm after-asm)
                (asm-has?
                  after-asm
                  "_allocentry_i0_v0_slow"
                  "_allocentry_i1_v0_slow"))]
            [(Err _) false])]
        [(Err _) false])]
    (and
      before-reset
      plan-gep-before-reset
      plan-gep-after-reset
      metrics-before-reset
      metrics-after-failure
      failure-ok
      failure-retired
      retired-stays-retired
      scratch-before-reset
      scratch-after-failure
      b-bytes-stable
      (be_state.compiler-backend-mode-scalar? (state-current-mode state-a))
      (= (state-emit-instr-post-base state-a) 0)
      (= (__tl-project-field (state-current-phi-targets state-a) len) 0)
      (be_state.compiler-backend-mode-scalar? (state-current-mode state-b))
      (= (state-emit-instr-post-base state-b) 31)
      (= (array-ref (state-fuse-use-counts state-b) 4) 37)
      (state-emit-instrs-continue-pending state-b))))

;; ---------------------------------------------------------------------------
;; #block-placement fixtures.
;;
;; The layout decision is read straight out of
;; `compiler-backend-placement-order-for-blocks`, which runs the production
;; planner over a hand-built block sequence and hands back the chosen order as
;; indices into it. Every fixture below is the SAME five-block `while` CFG with
;; one thing changed, so a check that passes for the wrong reason is visible as
;; two fixtures agreeing when they should not.
(define (compiler-backend-placement-test-block
  [name : String]
  [instrs : ir.CompilerIrInstrSeq]) : ir.CompilerIrBlock
  (Block (ir.compiler-ir-label (& name)) instrs))

(define (compiler-backend-placement-test-order-eq?
  [order : (__tl_dyn-array i64)]
  [expected : (__tl_dyn-array i64)]) : bool
  (let
    [n : i64 (array-length expected)]
    [i : i64 0]
    [same : bool (= (array-length order) n)]
    (while (and same (< i n))
      (if (= (array-ref order i) (array-ref expected i))
        unit
        (set! same false))
      (+= i 1))
    same))

(define (compiler-backend-placement-test-expected
  [a : i64]
  [b : i64]
  [c : i64]
  [d : i64]
  [e : i64]) : (__tl_dyn-array i64)
  (__tl_make-array a b c d e))

;; Derived IR symbols live above the compact and CFG symbol domains. The
;; placement pass must treat those raw identities as keys, never as array
;; indices: this four-destination loop should need exactly four stamp slots.
(define (compiler-backend-placement-high-symbol-blocks
  [entry-var : i64]
  [phi-var : i64]
  [cond-var : i64]
  [step-var : i64]
  [bound-var : i64]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (compiler-backend-placement-test-block
      "entry"
      (ir.compiler-ir-instr-seq2
        (Mov entry-var (I64 0) (I64))
        (Jump (ir.compiler-ir-label "header"))))
    (compiler-backend-placement-test-block
      "header"
      (ir.compiler-ir-instr-seq3
        (Phi
          phi-var
          (ir.compiler-ir-phi-input-seq-prepend
            (Var entry-var)
            (ir.compiler-ir-label "entry")
            (&
              (ir.compiler-ir-phi-input-seq-prepend
                (Var step-var)
                (ir.compiler-ir-label "latch")
                (& (ir.compiler-ir-phi-input-seq-empty)))))
          (I64))
        (BinOp cond-var (Lt) (Var phi-var) (Var bound-var) (I64))
        (Branch
          (Var cond-var)
          (ir.compiler-ir-label "latch")
          (ir.compiler-ir-label "exit"))))
    (compiler-backend-placement-test-block
      "latch"
      (ir.compiler-ir-instr-seq2
        (BinOp step-var (Add) (Var phi-var) (I64 1) (I64))
        (Jump (ir.compiler-ir-label "header"))))
    (compiler-backend-placement-test-block
      "exit"
      (ir.compiler-ir-instr-seq1 (Return (Some (Var phi-var)))))))

(define (compiler-backend-placement-high-symbol-slots-ok?) : bool
  (let
    [entry-var : i64 (ir.compiler-ir-symbol "placement/high/entry")]
    [phi-var : i64 (ir.compiler-ir-symbol "placement/high/phi")]
    [cond-var : i64 (ir.compiler-ir-symbol "placement/high/condition")]
    [step-var : i64 (ir.compiler-ir-symbol "placement/high/step")]
    [bound-var : i64 (ir.compiler-ir-symbol "placement/high/bound")]
    [blocks : ir.CompilerIrBlockList
      (compiler-backend-placement-high-symbol-blocks
        entry-var
        phi-var
        cond-var
        step-var
        bound-var)]
    [order : (__tl_dyn-array i64)
      (compiler-backend-placement-order-for-blocks
        (be_state.compiler-backend-global-shared-view blocks))]
    (and
      (ir.compiler-ir-symbol-owned? entry-var)
      (ir.compiler-ir-symbol-owned? phi-var)
      (ir.compiler-ir-symbol-owned? cond-var)
      (ir.compiler-ir-symbol-owned? step-var)
      (ir.compiler-ir-symbol-owned? bound-var)
      (= (compiler-backend-placement-variable-slot-count-for-blocks blocks) 4)
      (= (array-length order) 4)
      (= (array-ref order 0) 0)
      (= (array-ref order 1) 2)
      (= (array-ref order 2) 1)
      (= (array-ref order 3) 3))))

;; `%1 = phi [%0 from entry], [%3 from latch]` in the loop header.
(define (compiler-backend-placement-test-carry-phi) : ir.CompilerIrInstr
  (irt.instr "%1 = phi [%0, entry], [%3, latch] : i64"))

;; entry: %0 = 0 ; jump header
(define (compiler-backend-placement-test-entry-block) : ir.CompilerIrBlock
  (irt.block "entry:
       %0 = mov 0 : i64
       jump header"))

;; header: %1 = phi ... ; %2 = lt %1, %9 ; branch %2, body, exit
;; Variable 9 is defined nowhere, so it is the loop-invariant bound.
(define (compiler-backend-placement-test-header-block) : ir.CompilerIrBlock
  (irt.block
    "header:
       %1 = phi [%0, entry], [%3, latch] : i64
       %2 = lt %1, %9 : i64
       branch %2, body, exit"))

;; body: %4 = %1 ; jump latch  (or, with `terminated?` false, no jump at all)
(define (compiler-backend-placement-test-body-block [terminated? : bool]) : ir.CompilerIrBlock
  (compiler-backend-placement-test-block
    "body"
    (if terminated?
      (ir.compiler-ir-instr-seq2
        (Mov 4 (Var 1) (I64))
        (Jump (ir.compiler-ir-label "latch")))
      (ir.compiler-ir-instr-seq1 (Mov 4 (Var 1) (I64))))))

;; latch: %3 = <step> ; jump header. `counting?` picks the step: `%1 + 1` makes
;; %1 an induction variable and the loop a counting one, while `load %1` is the
;; `n = next[n]` bucket walk the admission has to refuse.
(define (compiler-backend-placement-test-latch-block [counting? : bool]) : ir.CompilerIrBlock
  (compiler-backend-placement-test-block
    "latch"
    (ir.compiler-ir-instr-seq2
      (if counting?
        (irt.instr "%3 = add %1, 1 : i64")
        (Load 3 (Var 1) (I64)))
      (Jump (ir.compiler-ir-label "header")))))

(define (compiler-backend-placement-test-exit-block) : ir.CompilerIrBlock
  (irt.block "exit:
       return %1"))

;; entry / header / body / latch / exit, in that order.
(define (compiler-backend-placement-test-while-blocks
  [counting? : bool]
  [terminated? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (compiler-backend-placement-test-entry-block)
    (compiler-backend-placement-test-header-block)
    (compiler-backend-placement-test-body-block terminated?)
    (compiler-backend-placement-test-latch-block counting?)
    (compiler-backend-placement-test-exit-block)))

;; A top-tested counting loop rotates: the exiting block (the header, the only
;; block with one successor inside the loop and one outside) lands last, so the
;; latch falls through into the exit test and the back edge is the header's own
;; conditional jump. entry / body / latch / header / exit.
(define (compiler-backend-placement-rotation-ok?) : bool
  (compiler-backend-placement-test-order-eq?
    (compiler-backend-placement-order-for-blocks
      (compiler-backend-placement-test-while-blocks true true))
    (compiler-backend-placement-test-expected 0 2 3 1 4)))

;; The same CFG whose carried value is reloaded rather than stepped is a search
;; loop, which exits on its first test far more often than not: rotation would
;; buy one jump per iteration and pay one per entry, so the admission refuses
;; and the order is untouched.
(define (compiler-backend-placement-search-loop-declines-ok?) : bool
  (compiler-backend-placement-test-order-eq?
    (compiler-backend-placement-order-for-blocks
      (compiler-backend-placement-test-while-blocks false true))
    (compiler-backend-placement-test-expected 0 1 2 3 4)))

;; A block with no terminator falls through to whatever the list puts next, so
;; membership is available, but the layout stays in source order.
(define (compiler-backend-placement-open-block-declines-ok?) : bool
  (compiler-backend-placement-test-order-eq?
    (compiler-backend-placement-order-for-blocks
      (compiler-backend-placement-test-while-blocks true false))
    (compiler-backend-placement-test-expected 0 1 2 3 4)))

;; entry / header(=body) / latch / exit, with the counting test at the BOTTOM:
;; the header already has a fall-through predecessor and the bottom already
;; exits, which is LLVM's ViableTopFallthrough decline -- the loop is rotated
;; already and moving it would only relocate its jumps.
(define (compiler-backend-placement-bottom-tested-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (compiler-backend-placement-test-entry-block)
    (compiler-backend-placement-test-block
      "header"
      (ir.compiler-ir-instr-seq2
        (compiler-backend-placement-test-carry-phi)
        (Jump (ir.compiler-ir-label "latch"))))
    (irt.block
      "latch:
                 %3 = add %1, 1 : i64
                 %2 = lt %3, %9 : i64
                 branch %2, header, exit")
    (compiler-backend-placement-test-exit-block)))

(define (compiler-backend-placement-viable-top-declines-ok?) : bool
  (let
    [order : (__tl_dyn-array i64)
      (compiler-backend-placement-order-for-blocks
        (compiler-backend-placement-bottom-tested-blocks))]
    (and
      (= (array-length order) 4)
      (= (array-ref order 0) 0)
      (= (array-ref order 1) 1)
      (= (array-ref order 2) 2)
      (= (array-ref order 3) 3))))

;; A loop the ENTRY block heads is never rotated: the prologue, the Windows SEH
;; directives that describe it and the shrink-wrap splice all anchor on the
;; first block of the function.
(define (compiler-backend-placement-entry-loop-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block
      "entry:
             %1 = phi [0, entry], [%3, body] : i64
             %2 = lt %1, %9 : i64
             branch %2, body, exit")
    (irt.block
      "body:
               %3 = add %1, 1 : i64
               jump entry")
    (compiler-backend-placement-test-exit-block)))

(define (compiler-backend-placement-entry-stays-first-ok?) : bool
  (let
    [order : (__tl_dyn-array i64)
      (compiler-backend-placement-order-for-blocks
        (compiler-backend-placement-entry-loop-blocks))]
    (and
      (= (array-length order) 3)
      (= (array-ref order 0) 0)
      (= (array-ref order 1) 1)
      (= (array-ref order 2) 2))))

;; EXIT SINKING. A search loop whose two exits -- the bound test's `done` and
;; the hit's `found` -- the front end laid out inside its run:
;;
;;   entry / header / done / body / found / latch
;;
;; Both exits return, so both leave every loop and have no successor in this
;; one; each sits between the two arms of the branch that leaves through it.
;; They move right behind the loop, keeping their order, and each exit test
;; then falls into its in-loop arm. `counting?` picks the latch step as in the
;; `while` fixtures: the search loop keeps its top test, the counting one also
;; rotates once its run is contiguous.
(define (compiler-backend-placement-search-exit-blocks [counting? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (compiler-backend-placement-test-entry-block)
    (irt.block
      "header:
         %1 = phi [%0, entry], [%3, latch] : i64
         %2 = ge %1, %9 : i64
         branch %2, done, body")
    (irt.block "done:
         return 0")
    (irt.block
      "body:
         %4 = load %1 : i64
         %5 = eq %4, 1 : i64
         branch %5, found, latch")
    (irt.block "found:
         return 1")
    (compiler-backend-placement-test-latch-block counting?)))

;; entry / header / body / latch / done / found: one taken branch per trip,
;; the latch's jump.
(define (compiler-backend-placement-exit-sinking-ok?) : bool
  (compiler-backend-placement-test-order-eq?
    (compiler-backend-placement-order-for-blocks
      (compiler-backend-placement-search-exit-blocks false))
    (__tl_make-array 0 1 3 5 2 4)))

;; The counting version sinks the same way but is NOT rotated: its run is
;; contiguous only because exit sinking made it so, and a search loop that
;; also counts -- a bounded hash probe -- usually exits on its first trip, which
;; rotation would charge an entry jump. Same order as the search version.
(define (compiler-backend-placement-exit-sinking-keeps-top-test-ok?) : bool
  (compiler-backend-placement-test-order-eq?
    (compiler-backend-placement-order-for-blocks
      (compiler-backend-placement-search-exit-blocks true))
    (__tl_make-array 0 1 3 5 2 4)))

;; A second way INTO the loop laid out inside its run -- `side` jumps to the
;; header from outside -- is not an exit, and moving it would cost its own path
;; a jump: the order is untouched.
(define (compiler-backend-placement-entry-path-stays-ok?) : bool
  (compiler-backend-placement-test-order-eq?
    (compiler-backend-placement-order-for-blocks
      (ir.compiler-ir-blocks
        (irt.block
          "entry:
             %0 = mov 0 : i64
             %8 = lt %0, %9 : i64
             branch %8, header, side")
        (irt.block
          "header:
             %1 = phi [%0, entry], [%0, side], [%3, latch] : i64
             %2 = lt %1, %9 : i64
             branch %2, body, exit")
        (irt.block "side:
             jump header")
        (compiler-backend-placement-test-body-block true)
        (compiler-backend-placement-test-latch-block false)
        (compiler-backend-placement-test-exit-block)))
    (__tl_make-array 0 1 2 3 4 5)))

;; The layout of `blocks` for a function whose returns share an epilogue
;; (`keep-tail?`), or a zero-length array when it declines.
(define (compiler-backend-placement-keep-tail-order
  [blocks : ir.CompilerIrBlockList]) : (__tl_dyn-array i64)
  (match blocks
    [(Array seq)
      (match (backend.compiler-backend-placement-plan-for-seq seq true 0 true)
        [(Some st) st.order]
        [(No) (__tl_make-array i64 0)])]))

;; With a shared epilogue, the sink point sits before the trailing
;; fall-through chain, and that chain can start inside a loop's run. Here the
;; loop's bottom block `tail` falls into the return `exit`, so the chain is
;; tail / exit and the point is `tail` itself: `found` has nowhere outside the
;; run to go and the order stays as it is (the loop keeps its top test).
(define (compiler-backend-placement-tail-loop-keeps-exit-ok?) : bool
  (compiler-backend-placement-test-order-eq?
    (compiler-backend-placement-keep-tail-order
      (irt.blocks
        "entry:
           %0 = mov 0 : i64
           jump header
         header:
           %1 = phi [%0, entry], [%3, step], [%8, tail] : i64
           %2 = ge %1, %9 : i64
           branch %2, tail, body
         body:
           %4 = load %1 : i64
           %5 = eq %4, 1 : i64
           branch %5, found, step
         found:
           return 1
         step:
           %3 = add %1, 1 : i64
           jump header
         tail:
           %8 = load %1 : i64
           %6 = lt %8, %9 : i64
           branch %6, header, exit
         exit:
           return %8"))
    (__tl_make-array 0 1 2 3 4 5 6)))

;; The chain may also start inside a LATER loop: `second`'s bottom block falls
;; into `exit`, which puts the sink point between `skip` and `again`. The first
;; loop's exit `found` must not land there; it moves out of its own run to the
;; nearest point outside every run, before `second`.
(define (compiler-backend-placement-tail-loop-skips-run-ok?) : bool
  (compiler-backend-placement-test-order-eq?
    (compiler-backend-placement-keep-tail-order
      (irt.blocks
        "entry:
           %0 = mov 0 : i64
           jump first
         first:
           %1 = phi [%0, entry], [%3, latch] : i64
           %2 = ge %1, %9 : i64
           branch %2, second, body
         body:
           %4 = load %1 : i64
           %5 = eq %4, 1 : i64
           branch %5, found, latch
         found:
           return 1
         latch:
           %3 = add %1, 1 : i64
           %6 = lt %3, %9 : i64
           branch %6, first, second
         second:
           %10 = phi [%1, first], [%3, latch], [%13, skip], [%18, again] : i64
           %12 = ge %10, %9 : i64
           branch %12, again, skip
         skip:
           %13 = add %10, 1 : i64
           jump second
         again:
           %18 = load %10 : i64
           %16 = lt %18, %9 : i64
           branch %16, second, exit
         exit:
           return %18"))
    (__tl_make-array 0 1 2 4 3 5 6 7 8)))

;; RETURN-ARM SINKING. entry / early / rest, where `early` is a guard's return
;; arm and `rest` the guard's other arm. `test` is the guard's compare.
(define (compiler-backend-placement-guard-blocks [test : String]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (irt.block
      (str_cat.str-cat
        "entry:
           %1 = "
        test
        " : i64
           branch %1, early, rest"))
    (irt.block "early:
         return 0")
    (irt.block "rest:
         %2 = add %0, 1 : i64
         return %2")))

;; `x < 0` is predicted false, so the return arm is cold and moves to the end:
;; entry / rest / early.
(define (compiler-backend-placement-return-arm-sinks-ok?) : bool
  (compiler-backend-placement-test-order-eq?
    (compiler-backend-placement-order-for-blocks
      (compiler-backend-placement-guard-blocks "lt %0, 0"))
    (__tl_make-array 0 2 1)))

;; `x != 0` is predicted TRUE, which is the return arm: the opcode heuristic
;; keeps it as the fall-through and the function keeps its order (no plan).
(define (compiler-backend-placement-return-arm-veto-ok?) : bool
  (=
    (array-length
      (compiler-backend-placement-order-for-blocks
        (compiler-backend-placement-guard-blocks "ne %0, 0")))
    0))

;; With the opcode heuristic silent -- two variables compared -- only the return
;; heuristic speaks, and only when exactly one arm leaves the function. Both of
;; the guard's arms return, so nothing moves; once `rest` continues to a block
;; of its own, `early` is the one return arm and sinks: entry / rest / tail /
;; early.
(define (compiler-backend-placement-return-heuristic-ok?) : bool
  (and
    (=
      (array-length
        (compiler-backend-placement-order-for-blocks
          (compiler-backend-placement-guard-blocks "lt %0, %3")))
      0)
    (compiler-backend-placement-test-order-eq?
      (compiler-backend-placement-order-for-blocks
        (ir.compiler-ir-blocks
          (irt.block
            "entry:
               %1 = lt %0, %3 : i64
               branch %1, early, rest")
          (irt.block "early:
               return 0")
          (irt.block
            "rest:
               %2 = add %0, 1 : i64
               jump tail")
          (irt.block "tail:
               return %2")))
      (__tl_make-array 0 2 3 1))))

;; Size-optimized and non-full builds pass `sink?` false, and a block in the
;; pinned prefix -- the early-exit shrink-wrap's, rendered by index -- never
;; moves. Nor does a return arm in a function whose returns share an epilogue
;; (`keep-tail?`, a function that restores callee-saved registers). All three
;; leave the same guard alone.
(define (compiler-backend-placement-return-arm-gates-ok?) : bool
  (and
    (match (compiler-backend-placement-guard-blocks "lt %0, 0")
      [(Array seq)
        (match (backend.compiler-backend-placement-plan-for-seq
          seq
          false
          0
          false)
          [(Some _) false]
          [(No) true])])
    (match (compiler-backend-placement-guard-blocks "lt %0, 0")
      [(Array seq)
        (match (backend.compiler-backend-placement-plan-for-seq
          seq
          true
          2
          false)
          [(Some _) false]
          [(No) true])])
    (match (compiler-backend-placement-guard-blocks "lt %0, 0")
      [(Array seq)
        (match (backend.compiler-backend-placement-plan-for-seq seq true 0 true)
          [(Some _) false]
          [(No) true])])))

;; The Windows end of the pass, built at the IR level so no source-level
;; transform (the unroller renames this exact loop) can move the shape out from
;; under the check. One counting loop over a parameter bound, emitted for the
;; SEH target:
;;
;;   entry:  %1 = 0            ; jump header
;;   header: %2 = phi(%1, %4)  ; %3 = lt %2, %0 ; branch %3, body, exit
;;   body:   %5 = %2           ; jump latch
;;   latch:  %4 = %2 + 1       ; jump header
;;   exit:   return %2
(define (compiler-backend-placement-seh-function) : ir.CompilerIrFunction
  (Function
    (ci.intern "placement_loop")
    (irt.params "n=%0:i64")
    (I64)
    6
    (irt.blocks
      "entry:
             %1 = mov 0 : i64
             jump header
           header:
             %2 = phi [%1, entry], [%4, latch] : i64
             %3 = lt %2, %0 : i64
             branch %3, body, exit
           body:
             %5 = mov %2 : i64
             jump latch
           latch:
             %4 = add %2, 1 : i64
             jump header
           exit:
             return %2")
    Ordinary))

(define (compiler-backend-placement-seh-main) : ir.CompilerIrFunction
  (Function
    (ci.intern "main")
    (ir.compiler-ir-param-seq-empty)
    (I64)
    1
    (ir.compiler-ir-blocks
      (compiler-backend-placement-test-block
        "entry"
        (ir.compiler-ir-instr-seq2
          (Call 0 (ci.intern "placement_loop") (One (I64 4)) (I64))
          (Return (Some (Var 0))))))
    Ordinary))

;; This fixture reaches emission without lowering a source first, so nothing
;; upstream has installed builtin ids for whatever intern table the checks
;; before it left active -- the same install the smoke driver performs before
;; the suite, and the one `compiler-builtin-refresh!` fails closed on.
(define (compiler-backend-placement-seh-program) : ir.CompilerIrProgram
  (cbi.compiler-builtin-initialize-for-parse!)
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (& (compiler-backend-placement-seh-function))
      (&
        (ir.compiler-ir-function-seq-prepend
          (& (compiler-backend-placement-seh-main))
          (& (ir.compiler-ir-function-seq-empty)))))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

;; Rotation moves whole blocks, and on Windows the unwind description is
;; positional: the prologue notes describe the entry instructions and nothing
;; else may sit between them and the end of the prologue. The entry-first rule
;; is what guarantees that, and this is the check that it holds while a loop
;; below it is rotated. The unwind lowering only accepts that shape: any other
;; line in the prologue, or a note in the body, keeps the `.seh_` directives.
(define (compiler-backend-placement-windows-seh-shape-ok?) : bool
  (match (backend.compiler-backend-emit-program-for-target
    (compiler-backend-placement-seh-program)
    (be_state.CompilerBackendTarget.Windows))
    [(Ok asm)
      (let
        [entry : i64
          (backend.compiler-backend-string-find-from
            asm
            "_tl_placement_loop:\n"
            0)]
        ;; the loop test's own label, and the first place anything JUMPS to it
        ;; (a jump operand ends the line, a label definition ends in a colon)
        [label : i64
          (backend.compiler-backend-string-find-from asm "_header:\n" 0)]
        [operand : i64
          (backend.compiler-backend-string-find-from asm "_header\n" 0)]
        [end : i64
          (if (< entry 0)
            -1
            (backend.compiler-backend-string-find-from
              asm
              ".L_tl_seh_end_"
              entry))]
        (and
          (>= entry 0)
          (< entry operand)
          ;; rotation put the test below the body, so the function reaches it by
          ;; a jump before ever defining the label ...
          (< operand label)
          (< label end)
          ;; ... the lowering accepted the function: no `.seh_` note is left in
          ;; it ...
          (let
            [note : i64
              (backend.compiler-backend-string-find-from asm "    .seh_" entry)]
            (or (< note 0) (> note end)))
          ;; ... and its record's 4-byte prologue is the entry `subq` alone
          (compiler-backend-win64-row-describes?
            (& asm)
            "_tl_placement_loop"
            "    .byte 1, 4, 1, 0\n    .byte 4, 98    # UWOP_ALLOC_SMALL 56\n    .byte 0, 0\n")))]
    [(Err _) false]))

(define (compiler-backend-placement-ok?) : bool
  (and
    (compiler-backend-placement-high-symbol-slots-ok?)
    (compiler-backend-placement-rotation-ok?)
    (compiler-backend-placement-search-loop-declines-ok?)
    (compiler-backend-placement-open-block-declines-ok?)
    (compiler-backend-placement-viable-top-declines-ok?)
    (compiler-backend-placement-entry-stays-first-ok?)
    (compiler-backend-placement-exit-sinking-ok?)
    (compiler-backend-placement-exit-sinking-keeps-top-test-ok?)
    (compiler-backend-placement-entry-path-stays-ok?)
    (compiler-backend-placement-tail-loop-keeps-exit-ok?)
    (compiler-backend-placement-tail-loop-skips-run-ok?)
    (compiler-backend-placement-return-arm-sinks-ok?)
    (compiler-backend-placement-return-arm-veto-ok?)
    (compiler-backend-placement-return-heuristic-ok?)
    (compiler-backend-placement-return-arm-gates-ok?)
    (compiler-backend-placement-windows-seh-shape-ok?)))

;; ---------------------------------------------------------------------------
;; Inline storage for runtime-initialised aggregate globals (#7905).
;; ---------------------------------------------------------------------------
;; Every memory-class aggregate global is its own inline cell: `cell` is a
;; 16-byte memory aggregate and `triple` a 24-byte one.
(define (compiler-backend-inline-aggregate-global-source) : String
  "(defstruct Cell (slots (__tl_dyn-array i64)) (len i64))
(defstruct Triple (a i64) (b i64) (c i64))
(define cell : Cell (Cell (__tl_make-array i64 4) 4))
(define triple : Triple (Triple 1 2 3))
(define (install! [n : i64]) : unit
  (set! cell (Cell (__tl_make-array i64 n) n)))
(define (install3! [n : i64]) : unit
  (set! triple (Triple n n n)))
(define (peek [c : (& Cell)]) : i64 c.len)
(define (read-len) : i64 (+ (peek (& cell)) (+ cell.len triple.c)))
(define (main) : i64 (begin (install! 3) (install3! 4) (read-len)))")

;; The t2 shape: `observe` holds a reference to `cell` (a safe borrow, or a raw
;; pointer) across a call that rebinds it. The safe form is rejected with E0222
;; before reaching the backend (#7904). The raw form shares the inline-home
;; assertions: the rebind copies into the global's one home, so the alias reads
;; the new value.
(define (compiler-backend-inline-aggregate-global-escape-source
  [raw-alias : bool]) : String
  (str_cat.str-cat
    "(defstruct Cell (slots (__tl_dyn-array i64)) (len i64))
(define cell : Cell (Cell (__tl_make-array i64 4) 4))
(define (install! [n : i64]) : unit
  (set! cell (Cell (__tl_make-array i64 n) n)))
"
    (if raw-alias
      "(define (observe [c : (MutPtr Cell)]) : i64
  (begin (install! 9) (unsafe (deref c).len)))
(define (main) : i64 (unsafe (observe (ptr-addr-of cell))))"
      "(define (observe [c : (& Cell)]) : i64 (begin (install! 9) c.len))
(define (main) : i64 (observe (& cell)))")))

;; `through` reads `cell` and calls through a function VALUE, so its callee set
;; is not enumerable; the global still has its one inline home.
(define (compiler-backend-inline-aggregate-global-indirect-source) : String
  "(defstruct Cell (slots (__tl_dyn-array i64)) (len i64))
(define cell : Cell (Cell (__tl_make-array i64 4) 4))
(define (install! [n : i64]) : unit
  (set! cell (Cell (__tl_make-array i64 n) n)))
(define (through [f : (-> i64 i64)] [n : i64]) : i64 (+ (f n) cell.len))
(define (twice [n : i64]) : i64 (* n 2))
(define (main) : i64 (begin (install! 3) (through twice 4)))")

(define (compiler-backend-inline-aggregate-global-shape-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-inline-aggregate-global-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          ;; (i) the cell reserves the aggregate itself, not a box pointer.
          (asm-has? asm "    .comm _tl_cell, 24, 8\n")
          (asm-has? asm "    .comm _tl_triple, 24, 8\n")
          ;; (i) `CompilerIrValue.Global` materialises as the symbol's address.
          (asm-has? asm "    leaq _tl_cell(%rip), %rdi\n")
          ;; (ii) a constant-offset field read folds to ONE rip-relative load.
          (asm-has? asm "    movq _tl_cell+16(%rip), %r8\n")
          (asm-has? asm "    movq _tl_triple+16(%rip), %r8\n")
          ;; ... and the cell is never read as a pointer any more.
          (asm-lacks? asm "    movq _tl_cell(%rip), %")
          (asm-lacks? asm "    movq _tl_triple(%rip), %")
          ;; (iii) the startup initializer writes the cell through its
          ;; leading sret pointer; nothing is copied after the call.
          (asm-has?
            asm
            "    leaq _tl_cell(%rip), %rdi\n    call _tl___global_init_cell\n"))
        (be_state.backend-and4
          (and
            (asm-has?
              asm
              "    leaq _tl_triple(%rip), %rdi\n    call _tl___global_init_triple\n")
            (asm-lacks? asm "    movups %xmm0, _tl_cell(%rip)\n")
            (asm-lacks? asm "    movq %r10, _tl_triple+16(%rip)\n"))
          ;; (iii) and `(set! g v)` copies the complete right-hand value once
          ;; into the same home: the home address, then 16 and 24 bytes.
          (and
            (asm-has? asm "    leaq _tl_cell(%rip), %r10\n")
            (asm-has? asm "    leaq _tl_triple(%rip), %r10\n"))
          (asm-has?
            asm
            "    movups %xmm2, (%r10)\n    movq 16(%r9), %r8\n    movq %r8, 16(%r10)\n")
          (asm-lacks? asm "    movq %rax, _tl_cell(%rip)\n")))]
    [(Err _) false]))

;; (iv) Windows keeps its own `.comm` alignment convention; every other inline
;; aggregate shape is target-independent.
(define (compiler-backend-inline-aggregate-global-windows-shape-ok?) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-inline-aggregate-global-source)
    (be_state.CompilerBackendTarget.Windows))
    [(Ok asm)
      (be_state.backend-and8
        (asm-has? asm "    .comm _tl_cell, 24, 3\n")
        (asm-has? asm "    .comm _tl_triple, 24, 3\n")
        (asm-has? asm "    leaq _tl_cell(%rip), %rcx\n")
        (asm-has? asm "    movq _tl_cell+16(%rip), %r8\n")
        (asm-has? asm "    movq _tl_triple+16(%rip), %r8\n")
        (asm-has?
          asm
          "    leaq _tl_cell(%rip), %rcx\n    call _tl___global_init_cell\n")
        (asm-has?
          asm
          "    leaq _tl_triple(%rip), %rcx\n    call _tl___global_init_triple\n")
        (asm-lacks? asm "    movq _tl_cell(%rip), %"))]
    [(Err _) false]))

;; (v) SPEC 4.x: an initialized aggregate global is one storage home whose
;; assignment keeps that home. Globals a reader's call graph can rebind, or
;; that are read through an unenumerable indirect callee, therefore use the
;; same inline home as any other: a whole-aggregate reservation, the home's
;; address for a read, and a byte copy (never a box-pointer store) for the
;; rebind. The escape program's safe borrow held across such a rebind is
;; rejected (E0222, #7904); its raw-pointer form reads the updated home at
;; every optimization level.
(define (compiler-backend-inline-aggregate-global-excluded-shape-ok?
  [src : String]) : bool
  (match (backend.compiler-backend-emit-source src)
    [(Ok asm)
      (and
        (be_state.backend-and4
          (asm-has? asm "    .comm _tl_cell, 24, 8\n")
          (asm-has?
            asm
            "    leaq _tl_cell(%rip), %rdi\n    call _tl___global_init_cell\n")
          (asm-lacks? asm "    movq %rax, _tl_cell(%rip)\n")
          (asm-lacks? asm "    .comm _tl_cell, 8, 8\n"))
        (be_state.backend-and4
          (asm-has? asm "    leaq _tl_cell(%rip), ")
          (asm-lacks? asm "    movq _tl_cell(%rip), ")
          true
          (not
            (let
              [needle (compiler-backend-todo-marker)]
              (asm-has? asm needle)))))]
    [(Err _) false]))

(define (compiler-backend-inline-aggregate-global-safety-ok?) : bool
  (and
    (match (backend.compiler-backend-emit-source
      (compiler-backend-inline-aggregate-global-escape-source false))
      [(Err diagnostic)
        (string.eq
          (cdiag.compiler-diagnostic-code-or-empty (__tl-box-place diagnostic))
          "E0222")]
      [(Ok _) false])
    (compiler-backend-inline-aggregate-global-excluded-shape-ok?
      (compiler-backend-inline-aggregate-global-escape-source true))
    (compiler-backend-inline-aggregate-global-excluded-shape-ok?
      (compiler-backend-inline-aggregate-global-indirect-source))))

;; The object image mirrors the text backend: a `.bss` reservation of the whole
;; aggregate, the symbol's ADDRESS for a `Global` read, and a byte copy for the
;; rebind rather than a pointer store.
(define (compiler-backend-inline-aggregate-global-object-shape-ok?) : bool
  (match (compiler-backend-emit-source-object-image
    (compiler-backend-inline-aggregate-global-source))
    [(Ok image)
      (and
        (be_state.backend-and4
          ;; The rebind's byte copy, and the cell address it copies into.
          (cobj.compiler-object-section-contains-bytes?
            image.sections
            (&
              (be_object.compiler-backend-object-inline-aggregate-copy-bytes 24)))
          (cobj.compiler-object-section-contains-bytes?
            image.sections
            (&
              (be_object.compiler-backend-object-inline-aggregate-copy-bytes 24)))
          (cobj.compiler-object-relocation-list-contains?
            image.relocations
            (RipAddress)
            "_tl_cell")
          (cobj.compiler-object-section-contains-label?
            image.sections
            cobj.bss-id
            "_tl_cell"))
        (match (object_asm.compiler-object-asm-render image)
          [(Ok text)
            (be_state.backend-and4
              ;; The .bss reservation is the aggregate, not a box pointer.
              (asm-has? text "_tl_cell:\n    .zero 24\n")
              (asm-has? text "_tl_triple:\n    .zero 24\n")
              ;; A `Global` read materialises the symbol's ADDRESS.
              (asm-has? text "    leaq _tl_cell(%rip), %rax\n")
              (asm-lacks? text "    movq _tl_cell(%rip), %rax\n"))]
          [(Err _) false]))]
    [(Err _) false]))

(define (compiler-backend-signed-div-guard-shape-ok?
  [ty : ast.AstType]
  [suffix : String]
  [lhs : String]
  [rhs : String]) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [asm : String
      (be_scalar.compiler-backend-div-overflow-guard-asm
        (ast.ast-node-pool-reader-type-segment-bases)
        ty
        "%r8"
        "%r12"
        "%r13"
        backend-state)]
    (string.eq
      asm
      (str_cat.str-cat
        "    cmp"
        suffix
        " $1, "
        lhs
        "\n    jno 1f\n    cmp"
        suffix
        " $-1, "
        rhs
        "\n    jne 1f\n    call tl_div_abort\n1:\n"))))

(define (compiler-backend-signed-div-guard-shapes-ok?) : bool
  (and
    (compiler-backend-signed-div-guard-shape-ok? (I8) "b" "%al" "%r8b")
    (compiler-backend-signed-div-guard-shape-ok? (I16) "w" "%ax" "%r8w")
    (compiler-backend-signed-div-guard-shape-ok? (I32) "l" "%eax" "%r8d")
    (compiler-backend-signed-div-guard-shape-ok? (I64) "q" "%rax" "%r8")
    (string.eq
      (be_scalar.compiler-backend-div-overflow-guard-asm
        (ast.ast-node-pool-reader-type-segment-bases)
        (U64)
        "%r8"
        "%r12"
        "%r13"
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
      "")))

;; Shift counts proven in range (compiler-backend-shift-count-bounds): a var
;; whose every definition is a `bit_and` with a literal c >= 0 is bounded by the
;; largest such c (stored plus one); a parameter, any other definition, a
;; negative literal or an `addr_of` of the var leaves it unbounded (-1).
(define (compiler-backend-shift-count-bounds-ok?) : bool
  (let
    [bounds : (__tl_dyn-array i64)
      (be_scalar.compiler-backend-shift-count-bounds
        9
        (irt.params "x=%0:i64")
        (irt.blocks
          "entry:
             %1 = bit_and %0, 63 : i64
             %2 = bit_and 7, %0 : i64
             %3 = bit_and %0, 31 : i64
             %3 = mov %0 : i64
             %4 = bit_and %0, -1 : i64
             %5 = bit_and %0, 15 : i64
             %6 = addr_of %5
             %7 = bit_and %1, 40 : i64
             %7 = bit_and %2, 9 : i64"))]
    (and
      (= (array-ref bounds 0) -1)
      (= (array-ref bounds 1) 64)
      (= (array-ref bounds 2) 8)
      (= (array-ref bounds 3) -1)
      (= (array-ref bounds 4) -1)
      (= (array-ref bounds 5) -1)
      (= (array-ref bounds 6) -1)
      (= (array-ref bounds 7) 41)
      (= (array-ref bounds 8) 0))))

(test
  backend-extern-data-object-symbols
  (for [mode (iterator.range 0 6)]
    (let
      [target : be_state.CompilerBackendTarget
        (if (< mode 3)
          (Linux)
          (Windows))]
      [source : String
        "(extern foreign-data (:symbol \"foreign-exact\") : i64)
(extern plain : i64)
(extern (touch) : i64)
(define saved : (MutPtr i64) (unsafe (ptr-addr-of foreign-data)))
(define local : i64 7)
(define (main) : i64
  (begin
    (set! foreign-data 40)
    (set! plain 2)
    (set! local 9)
    (touch)
    (+ (unsafe (ptr-read saved)) (+ foreign-data (+ plain local)))))"]
      [emitted : be_state.ResultCompilerBackendObject
        (match (backend.compiler-backend-lower-source-for-target source target)
          [(Err diag) (Err diag)]
          [(Ok program spans lower-owner)
            (let
              [result : be_state.ResultCompilerBackendObject
                (match (opt.optimize-program-with-spans-and-level
                  (& program)
                  spans
                  (% mode 3))
                  [(Program optimized optimized-spans)
                    (be_object.compiler-backend-emit-program-object-image-target-with-mode-and-crt
                      optimized
                      target
                      (Scalar)
                      optimized-spans
                      true
                      false)])]
              (lower.compiler-lower-arena-state-release!
                (lower.compiler-lower-state-arenas lower-owner))
              result)])]
      (match emitted
        [(Ok image)
          (test.assert-true
            (and
              (cobj.compiler-object-relocation-list-contains?
                image.relocations
                (RipValue)
                "foreign_exact")
              (cobj.compiler-object-relocation-list-contains?
                image.relocations
                (RipAddress)
                "foreign_exact")
              (cobj.compiler-object-relocation-list-contains?
                image.relocations
                (RipValue)
                "plain")
              (cobj.compiler-object-relocation-list-contains?
                image.relocations
                (RipAddress)
                "plain")
              (cobj.compiler-object-relocation-list-contains?
                image.relocations
                (RipAddress)
                "_tl_local"))
            "direct object reads, stores and addresses share external symbols")
          (test.assert-true
            (match target
              [(Linux)
                (match (elf.compiler-object-elf-render image)
                  [(Ok _) true]
                  [(Err _) false])]
              [(Windows)
                (match (coff.compiler-object-coff-render image)
                  [(Ok _) true]
                  [(Err _) false])])
            "both object formats resolve all external data relocations")
          (match (object_asm.compiler-object-asm-render image)
            [(Ok text)
              (test.assert-true
                (asm-lacks? text "_tl_foreign_data" "_tl_plain")
                "direct object emission must not invent internal extern symbols")]
            [(Err _)
              (test.assert-true false "object assembly rendering failed")])]
        [(Err _)
          (test.assert-true false "external data object emission failed")]))))

(test
  backend-global-symbol-emission-owner
  (let
    [name : i64 (ci.intern "shared-data")]
    [alpha : i64 (ci.intern "foreign-alpha?")]
    [beta : i64 (ci.intern "foreign_beta")]
    [state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [other : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [profile : profile_state.CompilerProfileState
      (profile_state.compiler-profile-state-new)]
    (for [mode (iterator.range 0 4)]
      (let
        [link : String
          (if (= mode 0)
            "foreign_alpha_question"
            "foreign_beta")]
        [index : be_state.CompilerBackendProgramIndex
          (be_facts.compiler-backend-program-index-build-with-backend-state-and-profile-state
            state
            bases
            (ir.compiler-ir-function-seq-empty)
            (if (= mode 2)
              (ir.compiler-ir-extern-seq-empty)
              (ir.compiler-ir-extern-seq1
                (ir.CompilerIrExtern.Extern
                  name
                  name
                  "shared-data"
                  ast.AstType.I64
                  ast.AstExternAbi.C
                  (if (= mode 0)
                    alpha
                    beta)
                  (ast.ast-extern-link-input-list-new)
                  false
                  (ir.CompilerIrReturnStorage.None)
                  false
                  (ir.CompilerIrGlobalStorage.Word))))
            profile)]
        [expected : String
          (if (= mode 2)
            "_tl_shared_data(%rip)"
            (str_cat.str-cat (string.copy (& link)) "(%rip)"))]
        (test.assert-true
          (asm-ok?
            (be_operand.compiler-backend-emit-load-value
              (regalloc.compiler-reg-assignment-table-empty)
              (& (ir.CompilerIrValue.GlobalAddr name))
              "%rax"
              state)
            (has expected))
          "untyped address emission uses the current program's link symbol")
        (test.assert-owned-string-eq
          (be_facts.compiler-backend-function-or-global-addr-symbol index name)
          (if (= mode 2)
            "_tl_shared_data"
            (string.copy (& link)))
          "typed address emission shares the same symbol authority")
        (test.assert-true
          (asm-ok?
            (be_data.compiler-backend-global-value-asm
              bases
              ast.AstType.I64
              (ir.CompilerIrValue.GlobalAddr name)
              index)
            (has
              (if (= mode 2)
                "_tl_shared_data"
                (string.copy (& link)))))
          "static address initializers resolve external data")
        (let
          [parts : object_target.CompilerBackendObjectTargetParts
            (be_object.compiler-backend-object-global-value
              (object_target.compiler-backend-object-parts-empty)
              "saved"
              (& (ast.AstType.I64))
              (& (ir.CompilerIrValue.GlobalAddr name))
              index)]
          [relocs : cobj.CompilerObjectRelocationList
            (cobj.compiler-object-relocation-builder-finish parts.relocations)]
          (test.assert-true
            (cobj.compiler-object-relocation-list-contains?
              relocs
              (Abs64)
              (if (= mode 2)
                "_tl_shared_data"
                (string.copy (& link))))
            "static object address relocations use the current link symbol"))
        (test.assert-owned-string-eq
          (be_scalar.compiler-backend-value-global-memory-operand
            state
            bases
            (ir.CompilerIrValue.Global name)
            ast.AstType.I64)
          (string.copy (& expected))
          "compare folds use the current program's link symbol")
        (be_state.compiler-backend-state-user-symbol-cache-reset! state)
        (test.assert-owned-string-eq
          (be_operand.compiler-backend-remat-global-cell-operand
            state
            (ir.CompilerIrValue.Global name))
          (string.copy (& expected))
          "function cache reset keeps program symbol authority")
        (test.assert-owned-string-eq
          (be_scalar.compiler-backend-float-value-memory-operand
            (regalloc.compiler-reg-assignment-table-empty)
            (ir.CompilerIrValue.Global name)
            (& (ast.AstType.F32))
            state)
          expected
          "float folds use the same global cell")
        (test.assert-owned-string-eq
          (be_operand.compiler-backend-state-global-symbol-id other name)
          "_tl_shared_data"
          "another backend job does not inherit extern aliases")
        (when
          (= mode 1)
          (be_state.compiler-backend-state-clear-emission-arena! state)
          (test.assert-owned-string-eq
            (be_operand.compiler-backend-state-global-symbol-id state name)
            "_tl_shared_data"
            "returning from emission unpublishes symbols"))))
    (backend.compiler-backend-state-release-final-arenas! state)
    (test.assert-owned-string-eq
      (be_operand.compiler-backend-state-global-symbol-id state name)
      "_tl_shared_data"
      "retiring the backend unpublishes program symbol authority")))

(define (compiler-backend-self-test) : i64
  (unless
    (compiler-backend-spmd-spilled-varying-entry-ok?)
    (io.panic "backend: private varying entry initialization failed"))
  (if (and
    (compiler-backend-packed-literal-records-ok?)
    (compiler-backend-signed-div-guard-shapes-ok?)
    (compiler-backend-shift-count-bounds-ok?)
    (compiler-backend-avx2-i64-reduce-source-ok?)
    (compiler-backend-avx2-i64-reduce-spilled-source-ok?)
    (compiler-backend-i64-reduce-call-ok?)
    (compiler-backend-lazy-table-storage-ok?)
    (compiler-backend-resetting-entry-live-session-guard-ok?)
    (source_tests.self-test)
    (compiler-backend-inline-aggregate-global-shape-ok?)
    (compiler-backend-inline-aggregate-global-windows-shape-ok?)
    (compiler-backend-inline-aggregate-global-safety-ok?)
    (compiler-backend-inline-aggregate-global-object-shape-ok?)
    (be_state.backend-and8
      (and
        (compiler-backend-global-type-table-ok?)
        (compiler-backend-target-model-ok? (compiler-backend-smoke-source)))
      (compiler-backend-array-access-asm-ok?)
      (compiler-backend-make-array-ok?)
      (compiler-backend-source-ok? (compiler-backend-smoke-source))
      (and
        (compiler-backend-object-image-shape-ok?)
        (compiler-backend-object-tlci-macro-entry-gate-ok?)
        (compiler-backend-object-phi-edge-copy-ok?)
        (compiler-backend-object-branch-flags-ok?)
        (compiler-backend-object-flags-isolation-ok?)
        (compiler-backend-object-terminal-labels-ok?)
        (compiler-backend-coff-renders-real-text-ok?)
        (compiler-backend-windows-object-entry-unwind-ok?)
        (compiler-backend-windows-object-unit-main-zero-ok?)
        (compiler-backend-windows-object-load-stores-dst-ok?)
        (compiler-backend-windows-object-stack-param-spill-ok?)
        (compiler-backend-elf-renders-real-text-ok?)
        (compiler-backend-pic-ok?)
        (compiler-backend-deterministic-ok? (compiler-backend-smoke-source))
        (compiler-backend-explicit-state-routes-serial-parity-ok?)
        (compiler-backend-explicit-state-target-pic-policy-ok?)
        (compiler-backend-target-policy-isolation-ok?)
        (compiler-backend-red-zone-abort-tail-dip-ok?)
        (compiler-backend-function-state-isolation-ok?)
        (compiler-backend-abort-counter-failure-reset-ok?))
      (compiler-backend-string-ok?)
      (and
        (compiler-backend-memory-op-ok?)
        (compiler-backend-scalar-load-scratch-ok?)
        (compiler-backend-float-load-scratch-ok?)
        (compiler-backend-gep-float-load-scratch-ok?)
        (compiler-backend-address-mode-fusion-ok?)
        (compiler-backend-scratch-staging-direct-home-shape-ok?)
        (compiler-backend-scavenge-pooled-r10-r11-ok?)
        (compiler-backend-binop-exclude-keeps-pooled-r10-r11-ok?)
        (compiler-backend-scavenge-exclude-with-keeps-pooled-r10-r11-ok?)
        (compiler-backend-scavenge-operand-excludes-keep-pooled-ok?)
        (compiler-backend-divmod-excludes-keep-scratch-fallbacks-ok?)
        (compiler-backend-scavenge-special-reg-bit-map-ok?)
        (compiler-backend-any-arity-stack-arg-shape-ok?)
        (compiler-backend-emergency-vector-width-ok?)
        (compiler-backend-scavenge-widened-pool-picks-rsi-ok?)
        (compiler-backend-scavenge-internal-rsi-rdi-plan-mask-ok?)
        (compiler-backend-scavenge-emergency-respects-exclude-ok?)
        (compiler-backend-emit-current-count-gate-ok?)
        (compiler-backend-const-hoist-candidates-abi-ok?)
        (compiler-backend-const-hoist-award-weight-ok?)
        (compiler-backend-const-hoist-award-tie-ok?)
        (compiler-backend-callful-preheader-wide-literal-ok?)
        (compiler-backend-spmd-call-loop-divmod-ok?)
        (compiler-backend-shrinkwrap-admission-state-ok?)
        (compiler-backend-shrinkwrap-large-guard-win64-ok?)
