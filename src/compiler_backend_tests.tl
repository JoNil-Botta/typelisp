(define (compiler-backend-call-arg-rax-group-consumer-index) : compiler_backend.CompilerBackendProgramIndex
  (let
    [ty : compiler_ast_types.AstType
      (compiler-backend-register-group-test-type)]
    (compiler_backend.compiler-backend-program-index-build
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_ir_types.compiler-ir-function-cons
        (compiler_ir_types.CompilerIrFunction.Function
          (ci.intern "group_seed")
          compiler_ir_types.CompilerIrParamList.Nil
          (compiler_ast_types.AstType.Unit)
          3
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.compiler-ir-block
              (compiler_ir_types.compiler-ir-label "entry")
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Pack
                  2
                  (compiler_ir_types.compiler-ir-value-cons
                    (compiler_ir_types.CompilerIrValue.I64 1)
                    (compiler_ir_types.compiler-ir-value-cons
                      (compiler_ir_types.CompilerIrValue.I64 2)
                      compiler_ir_types.CompilerIrValueList.Nil))
                  ty)
                compiler_ir_types.CompilerIrInstrList.Nil))
            compiler_ir_types.CompilerIrBlockList.Nil))
        (compiler_ir_types.compiler-ir-function-cons
          (compiler_ir_types.CompilerIrFunction.Function
            (ci.intern "consume_group")
            (compiler_ir_types.compiler-ir-param-cons
              (compiler_ir_types.CompilerIrParam.Param "value" ty 0)
              compiler_ir_types.CompilerIrParamList.Nil)
            (compiler_ast_types.AstType.I64)
            1
            compiler_ir_types.CompilerIrBlockList.Nil)
          compiler_ir_types.CompilerIrFunctionList.Nil))
      compiler_ir_types.CompilerIrExternList.Nil)))

(define (compiler-backend-call-arg-rax-group-consumer-not-forwardable?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs-with-index
    (compiler-backend-call-arg-rax-group-consumer-instrs)
    2
    (compiler-backend-call-arg-rax-group-consumer-index))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    call _tl_consume_group\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rax, %rdi\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-emit-rax-forward-test-instrs-with-index
  [instrs : compiler_ir_types.CompilerIrInstrList]
  [vars : i64]
  [program-index : compiler_backend.CompilerBackendProgramIndex]) : compiler_backend.ResultCompilerBackend
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "entry")
          instrs)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [use-counts : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-use-counts vars blocks)]
    [instr-count : i64 (compiler_ir_types.compiler-ir-instr-list-count instrs)]
    [scratch-result : compiler_regalloc.CompilerRegScratchPlanResult
      (compiler-backend-scratch-test-result
        "rax_forward_test"
        blocks
        vars
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [_scratch : compiler_regalloc.CompilerRegScratchPlan
      (match scratch-result
        [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan) plan])]
    [runtime-plan : compiler_backend.CompilerBackendRuntimePlan
      (cfg
        scratch-vreg
        (compiler_backend.CompilerBackendRuntimePlan.WithScratch
          (box (compiler-backend-runtime-helper-full-plan))
          _scratch)
        (compiler-backend-runtime-helper-full-plan))]
    [_scratch-position : unit
      (begin
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          program-index.backend-state
          instr-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          program-index.backend-state
          instr-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-site!
          program-index.backend-state
          0))]
    (compiler-backend-test-emit-instrs-text
      (compiler_backend.CompilerBackendEmissionContext
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_backend.CompilerBackendTarget.Linux)
        "_tl_test"
        (ci.intern "test")
        blocks
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_regalloc.compiler-reg-assignment-table-empty)
        vars
        (compiler_regalloc.compiler-reg-var-types-empty)
        (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
        (compiler_ast_types.AstType.I64)
        runtime-plan
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil
        program-index
        (compiler_ir_types.compiler-source-spans-empty)
        (compiler_backend.compiler-backend-source-span-index-build
          (compiler_ir_types.compiler-source-spans-empty))
        (compiler_diagnostic.compiler-diagnostic-at-start "" "")
        use-counts
        program-index.backend-state
        (compiler_backend.compiler-backend-state-function-state
          program-index.backend-state))
      (compiler_backend.CompilerBackendMaybeLabel.No)
      instrs)))

(define (compiler-backend-emit-rax-forward-test-instrs
  [instrs : compiler_ir_types.CompilerIrInstrList]
  [vars : i64]) : compiler_backend.ResultCompilerBackend
  (compiler-backend-emit-rax-forward-test-instrs-with-index
    instrs
    vars
    (compiler_backend.compiler-backend-program-index-build
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      compiler_ir_types.CompilerIrFunctionList.Nil
      compiler_ir_types.CompilerIrExternList.Nil)))

(define (compiler-backend-rax-forwarding-ok?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs
    (compiler-backend-rax-forward-chain-instrs)
    3)
    [(compiler_backend.ResultCompilerBackend.Ok chain-asm)
      (match (compiler-backend-emit-rax-forward-test-instrs
        (compiler-backend-rax-forward-multiple-use-instrs)
        3)
        [(compiler_backend.ResultCompilerBackend.Ok multi-use-asm)
          (match (compiler-backend-emit-rax-forward-test-instrs
            (compiler-backend-rax-forward-variable-shift-instrs)
            2)
            [(compiler_backend.ResultCompilerBackend.Ok shift-asm)
              (and
                (compiler_backend.compiler-backend-string-contains?
                  chain-asm
                  "    imulq $3, %rax\n")
                (compiler_backend.compiler-backend-string-contains?
                  chain-asm
                  "    addq $7, %rax\n")
                (compiler_backend.compiler-backend-string-contains?
                  chain-asm
                  "    addq $11, %rax\n")
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    chain-asm
                    "    movq %rax, -8(%rbp)\n"))
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    chain-asm
                    "    movq %rax, -16(%rbp)\n"))
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    chain-asm
                    "    movq %rax, -24(%rbp)\n"))
                (compiler_backend.compiler-backend-string-contains?
                  multi-use-asm
                  (cfg
                    scratch-vreg
                    "    movq %rax, -8(%rbp)\n"
                    "    movq %r8, -8(%rbp)\n"))
                (cfg
                  scratch-vreg
                  (and
                    (compiler_backend.compiler-backend-string-contains?
                      shift-asm
                      "    movl $1, %eax\n")
                    (compiler_backend.compiler-backend-string-contains?
                      shift-asm
                      "    movq -16(%rbp), %rcx\n")
                    (not
                      (compiler_backend.compiler-backend-string-contains?
                        shift-asm
                        "    movq -16(%rbp), %rax\n")))
                  true))]
            [(compiler_backend.ResultCompilerBackend.Err _) false])]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-call-arg-rax-forwarding-ok?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs
    (compiler-backend-call-arg-rax-forward-direct-instrs)
    2)
    [(compiler_backend.ResultCompilerBackend.Ok direct-asm)
      (match (compiler-backend-emit-rax-forward-test-instrs
        (compiler-backend-call-arg-rax-forward-indirect-instrs)
        2)
        [(compiler_backend.ResultCompilerBackend.Ok indirect-asm)
          (match (compiler-backend-emit-rax-forward-test-instrs
            (compiler-backend-call-arg-rax-nonleading-instrs)
            2)
            [(compiler_backend.ResultCompilerBackend.Ok nonleading-asm)
              (and
                (compiler_backend.compiler-backend-string-contains?
                  direct-asm
                  "    call _tl_producer\n")
                (compiler_backend.compiler-backend-string-contains?
                  direct-asm
                  "    movq %rax, -8(%rbp)\n")
                (compiler_backend.compiler-backend-string-contains?
                  direct-asm
                  "    movq %rax, %rdi\n")
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    direct-asm
                    "    movq -8(%rbp), %rdi\n"))
                (compiler_backend.compiler-backend-string-contains?
                  indirect-asm
                  "    movq %rax, %rsi\n")
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    indirect-asm
                    "    movq -8(%rbp), %rsi\n"))
                (compiler_backend.compiler-backend-string-contains?
                  nonleading-asm
                  "    movq -8(%rbp), %rsi\n")
                (compiler-backend-call-arg-rax-group-consumer-not-forwardable?)
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    nonleading-asm
                    "    movq %rax, %rsi\n")))]
            [(compiler_backend.ResultCompilerBackend.Err _) false])]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define compiler-backend-long-block-instr-count : i64
  4096)

(define (compiler-backend-long-normal-block-seq) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [count : i64 compiler-backend-long-block-instr-count]
    [total : i64 (+ count 1)]
    [slots : (__tl_dyn-array compiler_ir_types.CompilerIrInstr)
      (array.make-array compiler_ir_types.CompilerIrInstr total)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (set!
            (array-ref slots index)
            (compiler_ir_types.CompilerIrInstr.Mov
              index
              (compiler_ir_types.CompilerIrValue.I64 index)
              (compiler_ast_types.AstType.I64)))
          (set! index (+ index 1))))
      (set!
        (array-ref slots count)
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var (- count 1)))))
      (compiler_ir_types.CompilerIrInstrSeq slots total))))

(define (compiler-backend-long-normal-block-ok?) : bool
  (let
    [seq : compiler_ir_types.CompilerIrInstrSeq
      (compiler-backend-long-normal-block-seq)]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler_ir_types.compiler-ir-instr-seq-to-list seq)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          seq)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [use-counts : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-use-counts
        compiler-backend-long-block-instr-count
        blocks)]
    [test-id : i64 (ci.intern "test")]
    [program-index : compiler_backend.CompilerBackendProgramIndex
      (compiler_backend.compiler-backend-program-index-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil)]
    [backend-state : compiler_backend.CompilerBackendState
      program-index.backend-state]
    (match (compiler-backend-test-emit-instrs-text
      (compiler_backend.CompilerBackendEmissionContext
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_backend.CompilerBackendTarget.Linux)
        "_tl_test"
        test-id
        blocks
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_regalloc.compiler-reg-assignment-table-empty)
        compiler-backend-long-block-instr-count
        (compiler_regalloc.compiler-reg-var-types-empty)
        (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
        (compiler_ast_types.AstType.I64)
        (compiler-backend-runtime-helper-full-plan)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil
        program-index
        (compiler_ir_types.compiler-source-spans-empty)
        (compiler_backend.compiler-backend-source-span-index-build-with-backend-state
          backend-state
          (compiler_ir_types.compiler-source-spans-empty))
        (compiler_diagnostic.compiler-diagnostic-at-start "" "")
        use-counts
        backend-state
        (compiler_backend.compiler-backend-state-function-state backend-state))
      (compiler_backend.CompilerBackendMaybeLabel.No)
      instrs)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movl $4095, %eax\n")
          (compiler_backend.compiler-backend-string-contains? asm "    ret\n"))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-binop-operand-folding-ok?) : bool
  (let
    [rhs-spill : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Spill -16))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [cmp-types : compiler_regalloc.CompilerRegVarTypes
      (compiler_regalloc.compiler-reg-var-types-insert
        (compiler_regalloc.compiler-reg-var-types-insert
          (compiler_regalloc.compiler-reg-var-types-empty)
          1
          (compiler_ast_types.AstType.I64))
        0
        (compiler_ast_types.AstType.I64))]
    (match (compiler_backend.compiler-backend-emit-binop-with-plan
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_regalloc.compiler-reg-var-types-empty)
      (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
      rhs-spill
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64)
      "%r8"
      ""
      ""
      ""
      ""
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(compiler_backend.ResultCompilerBackend.Ok add-asm)
        (match (compiler_backend.compiler-backend-emit-binop-with-plan
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          cmp-types
          (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
          rhs-spill
          2
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.Bool)
          "%r8"
          ""
          ""
          ""
          ""
          (compiler_backend.compiler-backend-state-new
            (ci.intern-compat-state-capture-active)))
          [(compiler_backend.ResultCompilerBackend.Ok cmp-asm)
            (and
              (compiler_backend.compiler-backend-string-contains?
                add-asm
                "    addq -16(%rbp), %r8\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  add-asm
                  "    movq -16(%rbp), %r9\n"))
              (compiler_backend.compiler-backend-string-contains?
                cmp-asm
                "    cmpq -16(%rbp), %r8\n    setl %r8b\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cmp-asm
                  "    movq -16(%rbp), %r9\n"))
              (string.eq
                (compiler_backend.compiler-backend-binop-direct-mnemonic
                  (compiler_ir_types.CompilerIrBinOp.And))
                "and")
              (string.eq
                (compiler_backend.compiler-backend-binop-direct-mnemonic
                  (compiler_ir_types.CompilerIrBinOp.Or))
                "or"))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-bounds-operand-folding-ok?) : bool
  (let
    [index-reg : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [index-reg-length-spill : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Spill -16))
          (compiler_regalloc.compiler-reg-assignment-table-empty)))]
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ir_types.compiler-ir-label "bounds_ok"))
        compiler_ir_types.CompilerIrInstrList.Nil)
      index-reg
      2)
      [(compiler_backend.ResultCompilerBackend.Ok imm-asm)
        (match (compiler-backend-emit-test-instrs
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "bounds_ok"))
            compiler_ir_types.CompilerIrInstrList.Nil)
          index-reg-length-spill
          3)
          [(compiler_backend.ResultCompilerBackend.Ok spill-asm)
            (and
              (compiler_backend.compiler-backend-string-contains?
                imm-asm
                "    cmpq $3, %r12\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  imm-asm
                  "    movq %r12, %rax\n"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  imm-asm
                  "    movl $3, %r11d\n"))
              (compiler_backend.compiler-backend-string-contains?
                spill-asm
                "    cmpq -16(%rbp), %r12\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  spill-asm
                  "    movq %r12, %rax\n"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  spill-asm
                  "    movq -16(%rbp), %r11\n")))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-bounds-direct-pressure-tail
  [index : i64]
  [count : i64]) : compiler_ir_types.CompilerIrInstrList
  (if (>= index count)
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Return
        compiler_ir_types.CompilerIrMaybeValue.No)
      compiler_ir_types.CompilerIrInstrList.Nil)
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.StorePtr
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var index)
        (compiler_ast_types.AstType.I64))
      (compiler-backend-bounds-direct-pressure-tail (+ index 1) count))))

;; A direct register/memory length operand needs no scratch. Under full register
;; pressure an eager, unused scavenge would otherwise add an emergency stack
;; save at the bounds check even though the compare already has both operands.
(define (compiler-backend-bounds-direct-pressure-asm) : compiler_backend.ResultCompilerBackend
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_slot : unit
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        -512)]
    [regs : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-scavenge-candidates)]
    [count : i64 (array-length regs)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-test-reg-assignment-table-from regs 0)]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "bounds_ok"))
        (compiler-backend-bounds-direct-pressure-tail 1 count))]
    [result : compiler_backend.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        count
        (compiler_backend.CompilerBackendTarget.Linux)
        backend-state)]
    result))

(define (compiler-backend-bounds-direct-pressure-ok?) : bool
  (match (compiler-backend-bounds-direct-pressure-asm)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq %rcx, %r9\n")
        (not
          (compiler_backend.compiler-backend-string-contains? asm "-512(%rbp)")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Direct register binops need no scratch. Keep every scavenger candidate live
;; across the instruction so an eager fallback selection is observable as an
;; emergency-slot save even though LEA and the direct-source XOR do not consume
;; the selected register.
(define (compiler-backend-binop-direct-pressure-asm
  [op : compiler_ir_types.CompilerIrBinOp]) : compiler_backend.ResultCompilerBackend
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_slot : unit
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        -512)]
    [regs : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-scavenge-candidates)]
    [count : i64 (array-length regs)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-test-reg-assignment-table-from regs 0)]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          op
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler-backend-bounds-direct-pressure-tail 1 count))]
    [result : compiler_backend.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        count
        (compiler_backend.CompilerBackendTarget.Linux)
        backend-state)]
    result))

(define (compiler-backend-binop-direct-pressure-ok?) : bool
  (match (compiler-backend-binop-direct-pressure-asm
    (compiler_ir_types.CompilerIrBinOp.Add))
    [(compiler_backend.ResultCompilerBackend.Ok add-asm)
      (match (compiler-backend-binop-direct-pressure-asm
        (compiler_ir_types.CompilerIrBinOp.BitXor))
        [(compiler_backend.ResultCompilerBackend.Ok xor-asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              add-asm
              "    leaq (%r9,%rcx), %rdx\n")
            (compiler_backend.compiler-backend-string-contains?
              xor-asm
              "    movq %r9, %rdx\n    xorq %rcx, %rdx\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                add-asm
                "-512(%rbp)"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                xor-asm
                "-512(%rbp)")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-win64-bounds-index-scratch-ok?) : bool
  (let
    [length-rax : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-rax))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [ok : bool
      (match (compiler-backend-emit-test-instrs-target
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "bounds_ok"))
          compiler_ir_types.CompilerIrInstrList.Nil)
        length-rax
        2
        (compiler_backend.CompilerBackendTarget.Windows))
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          ;; The merged emitter folds the constant index 0 directly into the
          ;; bounds compare (`cmpq $0, %rax`) instead of materializing it in a
          ;; scratch register. The Win64 safety invariant is unchanged: the
          ;; length (in %rax) is never clobbered, so no degenerate
          ;; `cmpq %rax, %rax` self-compare is emitted.
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    cmpq $0, %rax\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    cmpq %rax, %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    ok))

(define (compiler-backend-win64-compare-rhs-rax-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_win : unit
      (compiler_backend.compiler-backend-set-current-fn-win64! backend-state)]
    [rhs-rax : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-rax))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [ok : bool
      (match (compiler_backend.compiler-backend-emit-compare-branch
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        rhs-rax
        "cmp"
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.compiler-ir-label "then")
        (compiler_ir_types.compiler-ir-label "else")
        (compiler_backend.CompilerBackendMaybeLabel.No)
        backend-state)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          ;; The merged emitter folds the spilled LHS (var0 at -8(%rbp)) directly
          ;; into the compare as a memory operand (`cmpq %rax, -8(%rbp)`) instead
          ;; of loading it into a scratch register first. The Win64 safety
          ;; invariant is unchanged: the RHS in %rax is never clobbered, so no
          ;; degenerate `cmpq %rax, %rax` self-compare is emitted.
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    cmpq %rax, -8(%rbp)\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    cmpq %rax, %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [_linux : unit
      (compiler_backend.compiler-backend-set-current-fn-linux! backend-state)]
    ok))

(define (compiler-backend-peephole-single-dest-mnemonic? [name : String]) : bool
  (compiler_backend.compiler-backend-peephole-mnemonic-single-dest?
    (unsafe
      (string-data name))
    0
    (string.string-length name)))

(define (compiler-backend-test-peephole-reg-index [name : String]) : i64
  (compiler_backend.compiler-backend-peephole-token-reg-index-range
    (unsafe
      (string-data name))
    0
    (string.string-length name)))

(define (compiler-backend-test-peephole-memory-base [operand : String]) : i64
  (compiler_backend.compiler-backend-peephole-memory-base-range
    (unsafe
      (string-data operand))
    0
    (string.string-length operand)))

(define (compiler-backend-peephole-operand-classifiers-ok?) : bool
  (and
    (= (compiler-backend-test-peephole-reg-index "%rax") 0)
    (= (compiler-backend-test-peephole-reg-index "%rcx") 1)
    (= (compiler-backend-test-peephole-reg-index "%rdx") 2)
    (= (compiler-backend-test-peephole-reg-index "%rbx") 3)
    (= (compiler-backend-test-peephole-reg-index "%rsi") 4)
    (= (compiler-backend-test-peephole-reg-index "%rdi") 5)
    (= (compiler-backend-test-peephole-reg-index "%r8") 6)
    (= (compiler-backend-test-peephole-reg-index "%r9") 7)
    (= (compiler-backend-test-peephole-reg-index "%r10") 8)
    (= (compiler-backend-test-peephole-reg-index "%r11") 9)
    (= (compiler-backend-test-peephole-reg-index "%r12") 10)
    (= (compiler-backend-test-peephole-reg-index "%r13") 11)
    (= (compiler-backend-test-peephole-reg-index "%r14") 12)
    (= (compiler-backend-test-peephole-reg-index "%r15") 13)
    (= (compiler-backend-test-peephole-reg-index "%eax") 0)
    (= (compiler-backend-test-peephole-reg-index "%ax") 0)
    (= (compiler-backend-test-peephole-reg-index "%al") 0)
    (= (compiler-backend-test-peephole-reg-index "%ecx") 1)
    (= (compiler-backend-test-peephole-reg-index "%cx") 1)
    (= (compiler-backend-test-peephole-reg-index "%cl") 1)
    (= (compiler-backend-test-peephole-reg-index "%edx") 2)
    (= (compiler-backend-test-peephole-reg-index "%dx") 2)
    (= (compiler-backend-test-peephole-reg-index "%dl") 2)
    (= (compiler-backend-test-peephole-reg-index "%ebx") 3)
    (= (compiler-backend-test-peephole-reg-index "%bx") 3)
    (= (compiler-backend-test-peephole-reg-index "%bl") 3)
    (= (compiler-backend-test-peephole-reg-index "%esi") 4)
    (= (compiler-backend-test-peephole-reg-index "%si") 4)
    (= (compiler-backend-test-peephole-reg-index "%sil") 4)
    (= (compiler-backend-test-peephole-reg-index "%edi") 5)
    (= (compiler-backend-test-peephole-reg-index "%di") 5)
    (= (compiler-backend-test-peephole-reg-index "%dil") 5)
    (= (compiler-backend-test-peephole-reg-index "%r8d") 6)
    (= (compiler-backend-test-peephole-reg-index "%r8w") 6)
    (= (compiler-backend-test-peephole-reg-index "%r8b") 6)
    (= (compiler-backend-test-peephole-reg-index "%r15d") 13)
    (= (compiler-backend-test-peephole-reg-index "%r15w") 13)
    (= (compiler-backend-test-peephole-reg-index "%r15b") 13)
    (= (compiler-backend-test-peephole-reg-index "%rbp") -1)
    (= (compiler-backend-test-peephole-reg-index "%rsp") -1)
    (= (compiler-backend-test-peephole-reg-index "%rip") -1)
    (= (compiler-backend-test-peephole-reg-index "%ah") -1)
    (= (compiler-backend-test-peephole-reg-index "%xmm0") -1)
    (= (compiler-backend-test-peephole-reg-index "%r16") -1)
    (=
      (compiler-backend-test-peephole-memory-base "-8(%rbp)")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-rbp))
    (=
      (compiler-backend-test-peephole-memory-base "(%rsp)")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-rsp))
    (=
      (compiler-backend-test-peephole-memory-base "symbol(%rip)")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-rip))
    (=
      (compiler-backend-test-peephole-memory-base "24(%r10)")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-r10))
    (=
      (compiler-backend-test-peephole-memory-base "24(%r11)")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-none))
    (=
      (compiler-backend-test-peephole-memory-base "%rax")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-none))))

(define (compiler-backend-test-control-mnemonic-kind [name : String]) : i64
  (compiler_backend.compiler-backend-control-mnemonic-kind
    (unsafe
      (string-data name))
    0
    (string.string-length name)))

(define (compiler-backend-control-mnemonic-classifier-ok?) : bool
  (and
    (=
      (compiler-backend-test-control-mnemonic-kind "movq")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-movq))
    (=
      (compiler-backend-test-control-mnemonic-kind "leaq")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-leaq))
    (=
      (compiler-backend-test-control-mnemonic-kind "push")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-push))
    (=
      (compiler-backend-test-control-mnemonic-kind "pushq")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-push))
    (=
      (compiler-backend-test-control-mnemonic-kind "pop")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-pop))
    (=
      (compiler-backend-test-control-mnemonic-kind "popq")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-pop))
    (=
      (compiler-backend-test-control-mnemonic-kind "leave")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-leave))
    (=
      (compiler-backend-test-control-mnemonic-kind "ret")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-ret))
    (=
      (compiler-backend-test-control-mnemonic-kind "jmp")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-jmp))
    (=
      (compiler-backend-test-control-mnemonic-kind "subq")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-subq))
    (=
      (compiler-backend-test-control-mnemonic-kind "addq")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-addq))
    (=
      (compiler-backend-test-control-mnemonic-kind "syscall")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-syscall))
    (=
      (compiler-backend-test-control-mnemonic-kind "")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-none))
    (=
      (compiler-backend-test-control-mnemonic-kind "movl")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-none))
    (=
      (compiler-backend-test-control-mnemonic-kind "retq")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-none))
    (=
      (compiler-backend-test-control-mnemonic-kind "pushqq")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-none))
    (=
      (compiler-backend-test-control-mnemonic-kind "syscalx")
      (compiler_backend.compiler-backend-test-get-compiler-backend-control-mnemonic-none))))

(define (compiler-backend-peephole-single-dest-classifier-ok?) : bool
  (and
    (compiler-backend-peephole-single-dest-mnemonic? "movabsq")
    (compiler-backend-peephole-single-dest-mnemonic? "setae")
    (compiler-backend-peephole-single-dest-mnemonic? "movl")
    (compiler-backend-peephole-single-dest-mnemonic? "movw")
    (compiler-backend-peephole-single-dest-mnemonic? "movb")
    (compiler-backend-peephole-single-dest-mnemonic? "addq")
    (compiler-backend-peephole-single-dest-mnemonic? "subl")
    (compiler-backend-peephole-single-dest-mnemonic? "andw")
    (compiler-backend-peephole-single-dest-mnemonic? "orb")
    (compiler-backend-peephole-single-dest-mnemonic? "xorq")
    (compiler-backend-peephole-single-dest-mnemonic? "leal")
    (compiler-backend-peephole-single-dest-mnemonic? "shlw")
    (compiler-backend-peephole-single-dest-mnemonic? "shrb")
    (compiler-backend-peephole-single-dest-mnemonic? "sarq")
    (compiler-backend-peephole-single-dest-mnemonic? "sall")
    (compiler-backend-peephole-single-dest-mnemonic? "negb")
    (compiler-backend-peephole-single-dest-mnemonic? "notw")
    (compiler-backend-peephole-single-dest-mnemonic? "incl")
    (compiler-backend-peephole-single-dest-mnemonic? "decq")
    (compiler-backend-peephole-single-dest-mnemonic? "movzbq")
    (compiler-backend-peephole-single-dest-mnemonic? "movzwq")
    (compiler-backend-peephole-single-dest-mnemonic? "movsbq")
    (compiler-backend-peephole-single-dest-mnemonic? "movswq")
    (compiler-backend-peephole-single-dest-mnemonic? "movslq")
    (not (compiler-backend-peephole-single-dest-mnemonic? "movq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "movzbl"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "movsd"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "imulq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "mulq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "divq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "idivq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "callq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "xchgq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "testq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "cmpq"))))

(define (compiler-backend-peephole-ok?) : bool
  (and
    true
    (compiler-backend-control-mnemonic-classifier-ok?)
    (compiler-backend-peephole-operand-classifiers-ok?)
    (compiler-backend-peephole-single-dest-classifier-ok?)
    (compiler-backend-peephole-register-moves-ok?)
    (compiler-backend-direct-immediate-mov-ok?)
    true
    (compiler-backend-mov-scratch-staging-ok?)
    (compiler-backend-peephole-asm-ok?)
    (compiler-backend-binop-operand-folding-ok?)
    (compiler-backend-bounds-operand-folding-ok?)
    (compiler-backend-bounds-direct-pressure-ok?)
    true
    (compiler-backend-binop-direct-pressure-ok?)
    (compiler-backend-win64-bounds-index-scratch-ok?)
    (compiler-backend-win64-compare-rhs-rax-ok?)
    (compiler-backend-post-regalloc-peephole-ok?)
    (compiler-backend-peephole-vector-gp-owners-ok?)
    (compiler-backend-peephole-pending-parse-slot-ok?)
    true
    (compiler-backend-peephole-dead-mirror-store-ok?)
    (compiler-backend-peephole-dead-reg-def-ok?)
    (compiler-backend-peephole-detailed-abort-guard-ok?)
    (compiler-backend-peephole-drop-fallthrough-chain-ok?)
    (compiler-backend-peephole-drop-fallthrough-abort-guard-ok?)
    true
    (compiler-backend-deadstore-sweep-win64-ok?)
    (compiler-backend-r10-dead-scan-long-gap-ok?)
    (compiler-backend-chunked-peephole-equivalent?)
    (compiler-backend-streamed-final-output-equivalent?)
    (compiler-backend-streamed-final-batch-equivalent?)
    true
    (compiler-backend-rax-forwarding-ok?)
    (compiler-backend-call-arg-rax-forwarding-ok?)
    (compiler-backend-long-normal-block-ok?)
    (compiler-backend-fallthrough-jump-ok?)
    (compiler-backend-branch-fallthrough-ok?)
    true
    (compiler-backend-zero-load-ok?)
    (compiler-backend-zero-compare-ok?)
    (compiler-backend-scalar-select-ok?)
    (compiler-backend-call-return-ok?)
    (compiler-backend-global-immediate-store-ok?)
    (compiler-backend-scratch-staging-direct-shapes-ok?)))

(define (compiler-backend-fallthrough-program) : compiler_ir_types.CompilerIrProgram
  (compiler_ir_types.CompilerIrProgram.Program
    (compiler_ir_types.compiler-ir-global-seq-empty)
    (compiler_ir_types.compiler-ir-function-cons
      (compiler_ir_types.CompilerIrFunction.Function
        (ci.intern "main")
        compiler_ir_types.CompilerIrParamList.Nil
        (compiler_ast_types.AstType.I64)
        0
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-block
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "done"))
              compiler_ir_types.CompilerIrInstrList.Nil))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.compiler-ir-block
              (compiler_ir_types.compiler-ir-label "done")
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.I64 7)))
                compiler_ir_types.CompilerIrInstrList.Nil))
            compiler_ir_types.CompilerIrBlockList.Nil)))
      compiler_ir_types.CompilerIrFunctionList.Nil)
    compiler_ir_types.CompilerIrExternList.Nil))

(define (compiler-backend-fallthrough-jump-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-linux
    (compiler-backend-fallthrough-program))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains? asm ".Lf0_done:\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    jmp .Lf0_done\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-branch-fallthrough-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-peephole-assignments)]
    (match (compiler_backend.compiler-backend-emit-branch
      assignments
      "branch"
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.compiler-ir-label "then")
      (compiler_ir_types.compiler-ir-label "else")
      (compiler_backend.CompilerBackendMaybeLabel.Some
        (compiler_ir_types.compiler-ir-label "else"))
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(compiler_backend.ResultCompilerBackend.Ok false-fallthrough)
        (match (compiler_backend.compiler-backend-emit-branch
          assignments
          "branch"
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.compiler-ir-label "then")
          (compiler_ir_types.compiler-ir-label "else")
          (compiler_backend.CompilerBackendMaybeLabel.Some
            (compiler_ir_types.compiler-ir-label "then"))
          (compiler_backend.compiler-backend-state-new
            (ci.intern-compat-state-capture-active)))
          [(compiler_backend.ResultCompilerBackend.Ok true-fallthrough)
            (and
              (compiler_backend.compiler-backend-string-contains?
                false-fallthrough
                "    jne .Lbranch_then\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  false-fallthrough
                  "    jmp .Lbranch_else\n"))
              (compiler_backend.compiler-backend-string-contains?
                true-fallthrough
                "    je .Lbranch_else\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  true-fallthrough
                  "    jmp .Lbranch_then\n")))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-zero-load-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-load-value-with-plan
    (compiler_regalloc.compiler-reg-assignment-table-empty)
    (compiler_ir_types.CompilerIrValue.I64 0)
    "%rax"
    (compiler_backend.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (string.eq asm "    xorl %eax, %eax\n")]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-zero-compare-ok?) : bool
  (and
    (match (compiler_backend.compiler-backend-emit-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_regalloc.compiler-reg-var-types-empty)
      (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
      (compiler-backend-peephole-assignments)
      2
      (compiler_ir_types.CompilerIrBinOp.Eq)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64)
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    testq %r13, %r13\n    sete %r13b\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    cmpq $0")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    (match (compiler_backend.compiler-backend-emit-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_regalloc.compiler-reg-var-types-empty)
      (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
      (compiler-backend-peephole-assignments)
      2
      (compiler_ir_types.CompilerIrBinOp.Gt)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64)
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    testq %r13, %r13\n    setg %r13b\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    cmpq $0")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    (match (compiler_backend.compiler-backend-emit-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_regalloc.compiler-reg-var-types-empty)
      (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
      (compiler-backend-peephole-assignments)
      2
      (compiler_ir_types.CompilerIrBinOp.BitTestNe)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.I64 1)
      (compiler_ast_types.AstType.I64)
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    testq $1, %r13\n    setne %r13b\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    andq $1")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-scalar-select-ok?) : bool
  (and
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.ir-instr-select
          2
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 9)
          0
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.CompilerIrInstrList.Nil))
      (compiler-backend-peephole-assignments)
      3)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    testq %r12, %r12\n")
          (compiler_backend.compiler-backend-string-contains? asm "    cmovne ")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    cmove ")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    ;; x86 has no byte cmov: Bool still uses a target-independent qword cmovne.
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.ir-instr-select
          2
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Bool true)
          (compiler_ir_types.CompilerIrValue.Bool false)
          0
          (compiler_ast_types.AstType.Bool))
        (compiler_ir_types.CompilerIrInstrList.Nil))
      (compiler-backend-peephole-assignments)
      3)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            (cfg
              scratch-vreg
              "    cmovne %rsi, %r13\n"
              "    cmovne %r8, %r13\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (cfg scratch-vreg "cmovne %sil" "cmovne %r8b"))))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-global-immediate-store-ok?) : bool
  (compiler-backend-instr-contains?
    (compiler_ir_types.CompilerIrInstr.Store
      (ci.intern "g")
      (compiler_ir_types.CompilerIrValue.I64 7)
      (compiler_ast_types.AstType.I64))
    "    movq $7, _tl_g(%rip)\n"))

(define (compiler-backend-word-scratch-staging-ok?) : bool
  (and
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Word
          1
          (compiler_ir_types.CompilerIrValue.Var 2)
          0
          (compiler_ast_types.AstType.I64))
        compiler_ir_types.CompilerIrInstrList.Nil)
      (compiler_regalloc.compiler-reg-assignment-table-empty)
      4)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq -24(%rbp), %r8\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r8, -16(%rbp)\n")
          (not (compiler_backend.compiler-backend-string-contains? asm "%rax")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Word
          1
          (compiler_ir_types.CompilerIrValue.Var 2)
          0
          (compiler_ast_types.AstType.F64))
        compiler_ir_types.CompilerIrInstrList.Nil)
      (compiler_regalloc.compiler-reg-assignment-table-empty)
      4)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            (cfg
              scratch-vreg
              "    movsd -24(%rbp), %xmm0\n"
              "    movsd -24(%rbp), %xmm2\n"))
          (compiler_backend.compiler-backend-string-contains?
            asm
            (cfg
              scratch-vreg
              "    movsd %xmm0, -16(%rbp)\n"
              "    movsd %xmm2, -16(%rbp)\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (cfg scratch-vreg "%xmm2" "%xmm0"))))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Word
          1
          (compiler_ir_types.CompilerIrValue.Var 2)
          0
          (compiler_ast_types.AstType.F64))
        compiler_ir_types.CompilerIrInstrList.Nil)
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register
            (compiler_abi.compiler-abi-xmm-register-id 3)))
        (compiler_regalloc.compiler-reg-assignment-table-empty))
      4)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsd -24(%rbp), %xmm3\n")
          (not (compiler_backend.compiler-backend-string-contains? asm "%xmm0")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-scratch-staging-direct-shapes-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r13))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.RegisterPair
                compiler_abi.compiler-reg-id-r12
                compiler_abi.compiler-reg-id-r13))
            (compiler_regalloc.compiler-reg-assignment-table-empty))))]
    [_r8-tie-assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
