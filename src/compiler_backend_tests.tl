  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.CopyBytes
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          16)
        CompilerIrInstrList.Nil))
    CompilerIrBlockList.Nil))

(define (compiler-backend-scratch-vreg-c-memory-test-blocks [name : i64]) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.Call
          1
          name
          (CompilerIrCallArgs.Array
            (make-array
              (CompilerIrValue.Var 0)
              (CompilerIrValue.I64 24)
              (CompilerIrValue.Unit)))
          (AstType.Unit))
        CompilerIrInstrList.Nil))
    CompilerIrBlockList.Nil))

(define (compiler-backend-scratch-vreg-c-memory-indirect-test-blocks
  [with-marker : bool]) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.CallIndirectC
          1
          (CompilerIrValue.Var 2)
          (if with-marker
            (CompilerIrCallArgs.Array
              (make-array
                (CompilerIrValue.Var 0)
                (CompilerIrValue.I64 24)
                (CompilerIrValue.Unit)))
            (CompilerIrCallArgs.One (CompilerIrValue.Var 0)))
          (AstType.Unit))
        CompilerIrInstrList.Nil))
    CompilerIrBlockList.Nil))

(define (compiler-backend-scratch-vreg-phi-test-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.Jump "join")
        CompilerIrInstrList.Nil))
    (compiler-ir-block-cons
      (compiler-ir-block
        "join"
        (compiler-ir-instr-cons
          (CompilerIrInstr.Phi
            0
            (compiler-ir-phi-input-cons
              (CompilerIrValue.Var 1)
              "entry"
              CompilerIrPhiInputList.Nil)
            (AstType.I64))
          (compiler-ir-instr-cons
            (CompilerIrInstr.Phi
              1
              (compiler-ir-phi-input-cons
                (CompilerIrValue.Var 0)
                "entry"
                CompilerIrPhiInputList.Nil)
              (AstType.I64))
            CompilerIrInstrList.Nil)))
      CompilerIrBlockList.Nil)))

(define (compiler-backend-scratch-vreg-phi-test-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r13"))
      CompilerRegAssignmentList.Nil)))

(define (compiler-backend-scratch-test-types-from [var : i64] [vars : i64]) : CompilerRegVarTypeList
  (if (>= var vars)
    CompilerRegVarTypeList.Nil
    (compiler-reg-var-type-cons
      (CompilerRegVarType.Type var (AstType.I64))
      (compiler-backend-scratch-test-types-from (+ var 1) vars))))

(define (compiler-backend-scratch-test-base-plan
  [vars : i64]
  [assignments : CompilerRegAssignmentList]) : CompilerRegPlan
  (CompilerRegPlan.Plan
    assignments
    (compiler-live-set-empty)
    CompilerRegIntervalList.Nil
    (compiler-backend-scratch-test-types-from 0 vars)
    (compiler-reg-call-split-empty)
    (compiler-reg-split-plan-empty)))

(define (compiler-backend-scratch-test-base-plan-with-types
  [types : CompilerRegVarTypeList]
  [assignments : CompilerRegAssignmentList]) : CompilerRegPlan
  (CompilerRegPlan.Plan
    assignments
    (compiler-live-set-empty)
    CompilerRegIntervalList.Nil
    types
    (compiler-reg-call-split-empty)
    (compiler-reg-split-plan-empty)))

(define (compiler-backend-scratch-test-result-for-abi-with-types
  [abi : CompilerRegTargetAbi]
  [name : String]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [types : CompilerRegVarTypeList]
  [assignments : CompilerRegAssignmentList]) : CompilerRegScratchPlanResult
  (compiler-reg-plan-with-scratch-vreg-result
    abi
    (CompilerIrFunction.Function
      (ci.intern name)
      CompilerIrParamList.Nil
      (AstType.I64)
      vars
      blocks)
    (compiler-backend-scratch-test-base-plan-with-types types assignments)
    vars))

(define (compiler-backend-scratch-test-result-for-abi
  [abi : CompilerRegTargetAbi]
  [name : String]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [assignments : CompilerRegAssignmentList]) : CompilerRegScratchPlanResult
  (compiler-reg-plan-with-scratch-vreg-result
    abi
    (CompilerIrFunction.Function
      (ci.intern name)
      CompilerIrParamList.Nil
      (AstType.I64)
      vars
      blocks)
    (compiler-backend-scratch-test-base-plan vars assignments)
    vars))

(define (compiler-backend-scratch-test-result
  [name : String]
  [blocks : CompilerIrBlockList]
  [vars : i64]
  [assignments : CompilerRegAssignmentList]) : CompilerRegScratchPlanResult
  (compiler-backend-scratch-test-result-for-abi
    (CompilerRegTargetAbi.Linux)
    name
    blocks
    vars
    assignments))

(define (compiler-backend-scratch-float-types
  [result : AstType]
  [operand : AstType]
  [vars : i64]) : CompilerRegVarTypeList
  (if (= vars 0)
    CompilerRegVarTypeList.Nil
    (compiler-reg-var-type-cons
      (CompilerRegVarType.Type 0 result)
      (compiler-reg-var-type-cons
        (CompilerRegVarType.Type 1 operand)
        (if (> vars 2)
          (compiler-reg-var-type-cons
            (CompilerRegVarType.Type 2 operand)
            CompilerRegVarTypeList.Nil)
          CompilerRegVarTypeList.Nil)))))

(define (compiler-backend-scratch-test-register
  [result : CompilerRegScratchPlanResult]
  [ordinal : i64]) : String
  (match result
    [(CompilerRegScratchPlanResult.Result _ plan)
      (compiler-reg-scratch-plan-register plan 0 ordinal)]))

(define (compiler-backend-scratch-test-success-count
  [result : CompilerRegScratchPlanResult]) : i64
  (match result
    [(CompilerRegScratchPlanResult.Result _ plan)
      (compiler-backend-scratch-plan-success-count plan)]))

(define (compiler-backend-scratch-test-plan-count
  [result : CompilerRegScratchPlanResult]) : i64
  (match result
    [(CompilerRegScratchPlanResult.Result _ plan)
      (compiler-reg-scratch-plan-count plan)]))

(define (compiler-backend-scratch-vreg-call-target-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [blocks : CompilerIrBlockList
        (compiler-backend-scratch-vreg-call-target-test-blocks)]
      [assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-call-target-test-assignments)]
      [listed : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_call_target"
          blocks
          3
          assignments)]
      [dense : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_call_target_dense"
          (compiler-ir-block-list-compact blocks)
          3
          assignments)]
      [reg : String (compiler-backend-scratch-test-register listed 0)]
      [dense-reg : String (compiler-backend-scratch-test-register dense 0)]
      (and
        (= (compiler-backend-scratch-test-plan-count listed) 2)
        (= (compiler-backend-scratch-test-success-count listed) 1)
        (string.eq reg "%r12")
        (string.eq dense-reg reg)
        (match listed
          [(CompilerRegScratchPlanResult.Result out-plan scratch)
            (and
              (= (compiler-reg-plan-var-count out-plan 3) 4)
              (match (array-ref (struct-get scratch items) 0)
                [(CompilerRegScratchAssignment requirement assigned)
                  (and
                    (string.eq assigned reg)
                    (= (struct-get requirement point) 0)
                    (= (struct-get requirement ordinal) 0)
                    (= (struct-get requirement lo) 0)
                    (= (struct-get requirement hi) 1)
                    (match (struct-get requirement role)
                      [(CompilerRegScratchRole.CallTarget) true]
                      [_ false])
                    (match (struct-get
                      (struct-get requirement constraint)
                      register-class)
                      [(CompilerRegScratchClass.Gp) true]
                      [_ false]))]))])
        ;; Wrapping is per-function: the base runtime plan still exposes the
        ;; immutable empty scratch plan after a function-specific view exists.
        (match listed
          [(CompilerRegScratchPlanResult.Result _ scratch)
            (let
              [base : CompilerBackendRuntimePlan
                (compiler-backend-runtime-helper-full-plan)]
              [wrapped : CompilerBackendRuntimePlan
                (CompilerBackendRuntimePlan.WithScratch (box base) scratch)]
              (and
                (=
                  (compiler-reg-scratch-plan-count
                    (compiler-backend-runtime-plan-scratch wrapped))
                  2)
                (=
                  (compiler-reg-scratch-plan-count
                    (compiler-backend-runtime-plan-scratch base))
                  0)))])))
    true))

(define (compiler-backend-scratch-vreg-switch-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [blocks : CompilerIrBlockList
        (compiler-backend-scratch-vreg-switch-test-blocks)]
      [assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            0
            (CompilerRegLocation.Register "%r8"))
          CompilerRegAssignmentList.Nil)]
      [listed : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_switch"
          blocks
          1
          assignments)]
      [dense : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_switch_dense"
          (compiler-ir-block-list-compact blocks)
          1
          assignments)]
      [index-reg : String (compiler-backend-scratch-test-register listed 0)]
      [table-reg : String (compiler-backend-scratch-test-register listed 1)]
      (and
        (= (compiler-backend-scratch-test-plan-count listed) 2)
        (= (compiler-backend-scratch-test-success-count listed) 2)
        (not (string.eq index-reg ""))
        (not (string.eq table-reg ""))
        (not (string.eq index-reg table-reg))
        (not (string.eq index-reg "%r8"))
        (not (string.eq table-reg "%r8"))
        (string.eq index-reg (compiler-backend-scratch-test-register dense 0))
        (string.eq table-reg (compiler-backend-scratch-test-register dense 1))
        (match listed
          [(CompilerRegScratchPlanResult.Result _ plan)
            (and
              (compiler-reg-string-list-contains?
                (struct-get
                  (struct-get
                    (struct-get
                      (array-ref (struct-get plan items) 0)
                      requirement)
                    constraint)
                  excluded)
                "%r8")
              (compiler-reg-string-list-contains?
                (struct-get
                  (struct-get
                    (struct-get
                      (array-ref (struct-get plan items) 1)
                      requirement)
                    constraint)
                  excluded)
                "%r8"))])))
    true))

(define (compiler-backend-scratch-vreg-aggregate-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [index : CompilerBackendProgramIndex
        (compiler-backend-scratch-vreg-aggregate-test-index)]
      [_counts : unit
        (compiler-reg-set-group-counts! (struct-get index group-word-counts))]
      [_masks : unit
        (compiler-reg-set-group-class-masks!
          (struct-get index group-word-class-masks))]
      [result : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_aggregate"
          (compiler-backend-scratch-vreg-aggregate-test-blocks)
          3
          (compiler-backend-scratch-vreg-aggregate-test-assignments))]
      [gp-result : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_aggregate_gp"
          (compiler-backend-scratch-vreg-aggregate-gp-test-blocks)
          3
          (compiler-backend-scratch-vreg-aggregate-test-assignments))]
      [reg0 : String (compiler-backend-scratch-test-register result 0)]
      [reg1 : String (compiler-backend-scratch-test-register result 1)]
      [gp0 : String (compiler-backend-scratch-test-register gp-result 0)]
      [gp1 : String (compiler-backend-scratch-test-register gp-result 1)]
      (and
        (= (compiler-backend-scratch-test-plan-count result) 2)
        (= (compiler-backend-scratch-test-success-count result) 2)
        (compiler-backend-string-prefix-at? reg0 "%xmm" 0)
        (not (string.eq reg1 ""))
        (not (string.eq reg0 reg1))
        (not (string.eq reg0 "%r8"))
        (not (string.eq reg0 "%xmm4"))
        (not (string.eq reg0 "%xmm6"))
        (not (string.eq reg1 "%r8"))
        (not (string.eq reg1 "%r10"))
        (not (string.eq reg1 "%r11"))
        (not (string.eq reg1 "%r13"))
        (= (compiler-backend-scratch-test-plan-count gp-result) 2)
        (= (compiler-backend-scratch-test-success-count gp-result) 2)
        (not (string.eq gp0 ""))
        (not (string.eq gp1 ""))
        (not (string.eq gp0 gp1))
        (not (compiler-backend-string-prefix-at? gp0 "%xmm" 0))
        (not (compiler-backend-string-prefix-at? gp1 "%xmm" 0))
        (match result
          [(CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(CompilerRegScratchRole.AggregateWord) true]
                [_ false])
              (match (struct-get
                (struct-get
                  (struct-get (array-ref (struct-get plan items) 0) requirement)
                  constraint)
                register-class)
                [(CompilerRegScratchClass.Xmm) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(CompilerRegScratchRole.AggregateWord) true]
                [_ false])
              (match (struct-get
                (struct-get
                  (struct-get (array-ref (struct-get plan items) 1) requirement)
                  constraint)
                register-class)
                [(CompilerRegScratchClass.Gp) true]
                [_ false]))])))
    true))

(define (compiler-backend-scratch-vreg-phi-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [result : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_phi"
          (compiler-backend-scratch-vreg-phi-test-blocks)
          2
          (compiler-backend-scratch-vreg-phi-test-assignments))]
      [cycle : String (compiler-backend-scratch-test-register result 0)]
      [stage : String (compiler-backend-scratch-test-register result 1)]
      (and
        (= (compiler-backend-scratch-test-plan-count result) 2)
        (= (compiler-backend-scratch-test-success-count result) 2)
        (not (string.eq cycle ""))
        (not (string.eq stage ""))
        (not (string.eq cycle stage))
        (not (string.eq cycle "%r12"))
        (not (string.eq cycle "%r13"))
        (not (string.eq stage "%r12"))
        (not (string.eq stage "%r13"))
        (match result
          [(CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(CompilerRegScratchRole.PhiCycle) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(CompilerRegScratchRole.PhiStage) true]
                [_ false]))])))
    true))

(define (compiler-backend-scratch-vreg-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [scalar-assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -16))
          CompilerRegAssignmentList.Nil)]
      [phi-stage-assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -16))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -8))
            CompilerRegAssignmentList.Nil))]
      [cycle-assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            0
            (CompilerRegLocation.Register "%r12"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              1
              (CompilerRegLocation.Register "%r13"))
            CompilerRegAssignmentList.Nil))]
      [index : CompilerBackendProgramIndex
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)]
      (match (compiler-backend-emit-pack-words
        cycle-assignments
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        "-24(%rbp)"
        "-32(%rbp)"
        false
        false
        "%r14"
        "%r15"
        (compiler-diagnostic-at-start "" ""))
        [(ResultCompilerBackend.Ok aggregate)
          (match (compiler-backend-emit-scalar-stack-call-arg
            (CompilerBackendTarget.Linux)
            scalar-assignments
            (CompilerIrValue.Var 0)
            (AstType.I64)
            false
            0
            "%r14")
            [(ResultCompilerBackend.Ok call-stage)
              (match (compiler-backend-emit-phi-edge-copies
                phi-stage-assignments
                (compiler-backend-phi-same-home-blocks)
                "join"
                "entry"
                index
                2
                "%r15"
                "%r14")
                [(ResultCompilerBackend.Ok phi-stage)
                  (match (compiler-backend-emit-phi-edge-copies
                    cycle-assignments
                    (compiler-backend-phi-cycle-blocks)
                    "join"
                    "back"
                    index
                    2
                    "%r14"
                    "%r15")
                    [(ResultCompilerBackend.Ok phi-cycle)
                      (and
                        (string.eq
                          (compiler-backend-phi-planned-avoiding-value-home
                            cycle-assignments
                            (CompilerIrValue.Var 0)
                            "%r12")
                          "")
                        (string.eq
                          (compiler-backend-phi-planned-avoiding-value-home
                            cycle-assignments
                            (CompilerIrValue.Var 0)
                            "%r14")
                          "%r14")
                        (compiler-backend-string-contains?
                          aggregate
                          "    movq %r12, %r14\n")
                        (compiler-backend-string-contains?
                          aggregate
                          "    movq %r13, %r15\n")
                        (compiler-backend-string-contains?
                          call-stage
                          "    movq -16(%rbp), %r14\n")
                        (compiler-backend-string-contains?
                          call-stage
                          "    movq %r14, 0(%rsp)\n")
                        (compiler-backend-string-contains?
                          phi-stage
                          "    movq -16(%rbp), %r14\n")
                        (compiler-backend-string-contains?
                          phi-stage
                          "    movq %r14, -8(%rbp)\n")
                        (not
                          (compiler-backend-string-contains? phi-stage "pushq"))
                        (not
                          (compiler-backend-string-contains? phi-stage "popq"))
                        (compiler-backend-string-contains?
                          phi-cycle
                          "    movq %r12, %r14\n")
                        (compiler-backend-string-contains?
                          phi-cycle
                          "    movq %r14, %r13\n")
                        (not
                          (compiler-backend-string-contains?
                            phi-cycle
                            (compiler-backend-cycle-temp-slot 0))))]
                    [(ResultCompilerBackend.Err _) false])]
                [(ResultCompilerBackend.Err _) false])]
            [(ResultCompilerBackend.Err _) false])]
        [(ResultCompilerBackend.Err _) false]))
    true))

(define (compiler-backend-scratch-vreg-memory-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -16))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -8))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                2
                (CompilerRegLocation.Spill -24))
              CompilerRegAssignmentList.Nil)))]
      [index : CompilerBackendProgramIndex
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)]
      (match (compiler-backend-emit-addr-of assignments 2 0 "%r14")
        [(ResultCompilerBackend.Ok addr-of)
          (match (compiler-backend-emit-gep
            assignments
            2
            (CompilerIrValue.Var 0)
            (CompilerIrValue.Var 1)
            (AstType.U64)
            0
            "%r14"
            "%r15")
            [(ResultCompilerBackend.Ok gep)
              (match (compiler-backend-emit-load-instr
                assignments
                1
                (CompilerIrValue.Var 0)
                (AstType.I64)
                "%r14"
                "%r15")
                [(ResultCompilerBackend.Ok load)
                  (match (compiler-backend-emit-store-ptr
                    assignments
                    (CompilerIrValue.Var 0)
                    (CompilerIrValue.Var 1)
                    (AstType.I64)
                    index
                    "%r14"
                    "%r15")
                    [(ResultCompilerBackend.Ok store)
                      (match (compiler-backend-emit-copy-bytes
                        assignments
                        (CompilerIrValue.Var 0)
                        (CompilerIrValue.Var 1)
                        7
                        "%r12"
                        "%r13"
                        "%r14"
                        "")
                        [(ResultCompilerBackend.Ok copy)
                          (match (compiler-backend-emit-bounds-check
                            (CompilerBackendTarget.Linux)
                            "scratch_memory"
                            assignments
                            "%r14"
                            "%r15"
                            (CompilerIrValue.Var 0)
                            (CompilerIrValue.Global
                              (ci.intern "scratch_length"))
                            "ok"
                            (compiler-backend-runtime-helper-full-plan)
                            CompilerIrFunctionList.Nil
                            CompilerIrExternList.Nil
                            index)
                            [(ResultCompilerBackend.Ok bounds)
                              (and
                                (compiler-backend-string-contains?
                                  addr-of
                                  "%r14")
                                (compiler-backend-string-contains? gep "%r14")
                                (compiler-backend-string-contains? gep "%r15")
                                (compiler-backend-string-contains? load "%r14")
                                (compiler-backend-string-contains? load "%r15")
                                (compiler-backend-string-contains? store "%r14")
                                (compiler-backend-string-contains? store "%r15")
                                (compiler-backend-string-contains? copy "%r12")
                                (compiler-backend-string-contains? copy "%r13")
                                (compiler-backend-string-contains? copy "%r14")
                                (compiler-backend-string-contains?
                                  bounds
                                  "%r15")
                                (compiler-backend-string-contains?
                                  bounds
                                  "%r14"))]
                            [(ResultCompilerBackend.Err _) false])]
                        [(ResultCompilerBackend.Err _) false])]
                    [(ResultCompilerBackend.Err _) false])]
                [(ResultCompilerBackend.Err _) false])]
            [(ResultCompilerBackend.Err _) false])]
        [(ResultCompilerBackend.Err _) false]))
    true))

(define (compiler-backend-scratch-vreg-aggregate-copy-c-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -8))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                2
                (CompilerRegLocation.Spill -24))
              CompilerRegAssignmentList.Nil)))]
      [diag : CompilerDiagnostic (compiler-diagnostic-at-start "" "")]
      [pack : ResultCompilerBackend
        (compiler-backend-emit-pack-words
          assignments
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          "-24(%rbp)"
          "-32(%rbp)"
          true
          false
          "%xmm14"
          "%r15"
          diag)]
      [_group-enable : unit
        (compiler-backend-group-vars-enable!
          (compiler-live-set1 0)
          (compiler-live-set-empty))]
      [word : ResultCompilerBackend
        (compiler-backend-emit-word
          assignments
          2
          (CompilerIrValue.Var 0)
          0
          (AstType.F64)
          3
          "%xmm13"
          diag)]
      [_group-disable : unit (compiler-backend-group-vars-disable!)]
      [copy : ResultCompilerBackend
        (compiler-backend-emit-copy-bytes
          assignments
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          24
          "%r12"
          "%r13"
          "%r14"
          "%xmm12")]
      [c-memory : ResultCompilerBackend
        (begin
          (set! compiler-backend-current-c-memory-planned-xmm "%xmm11")
          (compiler-backend-emit-c-memory-stack-arg
            (CompilerBackendTarget.Linux)
            assignments
            (CompilerIrValue.Var 0)
            0
            24
            "%r14"))]
      [_reset-c-memory : unit
        (set! compiler-backend-current-c-memory-planned-xmm "")]
      (and
        (compiler-backend-scratch-vreg-result-contains?
          pack
          "    movsd -8(%rbp), %xmm14\n")
        (compiler-backend-scratch-vreg-result-contains?
          pack
          "    movq -16(%rbp), %r15\n")
        (compiler-backend-scratch-vreg-result-contains?
          word
          "    movsd -8(%rbp), %xmm13\n")
        (compiler-backend-scratch-vreg-result-contains?
          word
          "    movsd %xmm13, -24(%rbp)\n")
        (compiler-backend-scratch-vreg-result-contains?
          copy
          "    movups (%r13), %xmm12\n")
        (compiler-backend-scratch-vreg-result-contains?
          copy
          "    movups %xmm12, (%r12)\n")
        (compiler-backend-scratch-vreg-result-contains?
          c-memory
          "    movups (%r14), %xmm11\n")
        (compiler-backend-scratch-vreg-result-contains?
          c-memory
          "    movups %xmm11, 0(%rsp)\n")))
    true))

(define (compiler-backend-scratch-vreg-future-window-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [previous-occupied : (Array i64)
        compiler-backend-scavenge-ctx-occupied-masks]
      [previous-scratch : (Array i64)
        compiler-backend-scavenge-ctx-scratch-masks]
      [occupied : (Array i64) (array.make-array i64 2)]
      [scratch : (Array i64) (array.make-array i64 2)]
      [r8 : i64 (compiler-backend-scavenge-reg-bit "%r8")]
      [r10 : i64 (compiler-backend-scavenge-reg-bit "%r10")]
      [ok : bool false]
      (begin
        (array-set! occupied 0 r8)
        (array-set! occupied 1 (bit-or r8 r10))
        (array-set! scratch 0 0)
        (array-set! scratch 1 r10)
        (set! compiler-backend-scavenge-ctx-occupied-masks occupied)
        (set! compiler-backend-scavenge-ctx-scratch-masks scratch)
        (set!
          ok
          (and
            ;; A future planned temporary does not lengthen an unrelated
            ;; legacy staging window backwards into this instruction.
            (= (compiler-backend-scavenge-occupied-mask-over-range 0 2) r8)
            ;; At its own point it remains occupied, so simultaneous legacy
            ;; scratch cannot select the planned home.
            (=
              (compiler-backend-scavenge-occupied-mask-over-range 2 2)
              (bit-or r8 r10))))
        (set! compiler-backend-scavenge-ctx-occupied-masks previous-occupied)
        (set! compiler-backend-scavenge-ctx-scratch-masks previous-scratch)
        ok))
    true))

(define (compiler-backend-scratch-vreg-c-abi-return-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [result : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_c_abi_return"
          (compiler-backend-scratch-vreg-c-abi-return-test-blocks)
          2
          (compiler-backend-scratch-vreg-c-abi-return-test-assignments))]
      [planned : String (compiler-backend-scratch-test-register result 0)]
      (and
        (= (compiler-backend-scratch-test-plan-count result) 2)
        (= (compiler-backend-scratch-test-success-count result) 1)
        (string.eq planned "%r12")
        (string.eq
          (compiler-backend-scavenge-c-abi-return-base-save-reg planned)
          planned)
        (string.eq
          (compiler-backend-scavenge-c-abi-return-store-base-reg planned)
          planned)))
    true))

(define (compiler-backend-scratch-vreg-bounds-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            0
            (CompilerRegLocation.Register "%r10"))
          CompilerRegAssignmentList.Nil)]
      [result : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_bounds"
          (compiler-backend-scratch-vreg-bounds-test-blocks)
          2
          assignments)]
      [planned-len : String (compiler-backend-scratch-test-register result 0)]
      [planned-index : String (compiler-backend-scratch-test-register result 1)]
      (and
        (= (compiler-backend-scratch-test-plan-count result) 2)
        (= (compiler-backend-scratch-test-success-count result) 2)
        (not (string.eq planned-len ""))
        (not (string.eq planned-index ""))
        (not (string.eq planned-len planned-index))
        (not (string.eq planned-len "%r10"))
        (not (string.eq planned-index "%r10"))))
    true))

(define (compiler-backend-scratch-items-registers-differ-from?
  [items : (Array CompilerRegScratchAssignment)]
  [index : i64]
  [reg : String]) : bool
  (if (>= index (array-length items))
    true
    (and
      (not (string.eq reg (struct-get (array-ref items index) register)))
      (compiler-backend-scratch-items-registers-differ-from?
        items
        (+ index 1)
        reg))))

(define (compiler-backend-scratch-items-registers-unique-from?
  [items : (Array CompilerRegScratchAssignment)]
  [index : i64]) : bool
  (if (>= index (array-length items))
    true
    (let
      [reg : String (struct-get (array-ref items index) register)]
      (and
        (not (string.eq reg ""))
        (compiler-backend-scratch-items-registers-differ-from?
          items
          (+ index 1)
          reg)
        (compiler-backend-scratch-items-registers-unique-from?
          items
          (+ index 1))))))

(define (compiler-backend-scratch-fused-items-shape-from?
  [items : (Array CompilerRegScratchAssignment)]
  [dense-items : (Array CompilerRegScratchAssignment)]
  [index : i64]) : bool
  (if (>= index (array-length items))
    (= (array-length items) (array-length dense-items))
    (let
      [item : CompilerRegScratchAssignment (array-ref items index)]
      [requirement : CompilerRegScratchRequirement
        (struct-get item requirement)]
      [excluded : CompilerRegStringList
        (struct-get (struct-get requirement constraint) excluded)]
      (and
        (< index (array-length dense-items))
        (= (struct-get requirement lo) 0)
        (= (struct-get requirement hi) 7)
        (compiler-reg-string-list-contains? excluded "%r8")
        (compiler-reg-string-list-contains? excluded "%r9")
        (not (string.eq (struct-get item register) "%r8"))
        (not (string.eq (struct-get item register) "%r9"))
        (string.eq
          (struct-get item register)
          (struct-get (array-ref dense-items index) register))
        (compiler-backend-scratch-fused-items-shape-from?
          items
          dense-items
          (+ index 1))))))

(define (compiler-backend-scratch-vreg-fused-sibling-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [blocks : CompilerIrBlockList
        (compiler-backend-scratch-vreg-fused-sibling-test-blocks)]
      [assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-fused-sibling-test-assignments)]
      [listed : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_fused_sibling"
          blocks
          6
          assignments)]
      [dense : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_fused_sibling_dense"
          (compiler-ir-block-list-compact blocks)
          6
          assignments)]
      (match listed
        [(CompilerRegScratchPlanResult.Result _ plan)
          (match dense
            [(CompilerRegScratchPlanResult.Result _ dense-plan)
              (let
                [items : (Array CompilerRegScratchAssignment)
                  (struct-get plan items)]
                [dense-items : (Array CompilerRegScratchAssignment)
                  (struct-get dense-plan items)]
                (and
                  (= (array-length items) 7)
                  (= (compiler-backend-scratch-test-success-count listed) 7)
                  (= (compiler-backend-scratch-test-success-count dense) 7)
                  (compiler-backend-scratch-items-registers-unique-from?
                    items
                    0)
                  (compiler-backend-scratch-fused-items-shape-from?
                    items
                    dense-items
                    0)))])]))
    true))

(define (compiler-backend-scratch-vreg-memory-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [result : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_memory"
          (compiler-backend-scratch-vreg-memory-test-blocks)
          2
          (compiler-backend-scratch-vreg-memory-test-assignments))]
      [dst : String (compiler-backend-scratch-test-register result 0)]
      [src : String (compiler-backend-scratch-test-register result 1)]
      [value : String (compiler-backend-scratch-test-register result 2)]
      (and
        (= (compiler-backend-scratch-test-plan-count result) 3)
        (= (compiler-backend-scratch-test-success-count result) 3)
        (not (string.eq dst ""))
        (not (string.eq src ""))
        (not (string.eq value ""))
        (not (string.eq dst src))
        (not (string.eq dst value))
        (not (string.eq src value))
        (not (string.eq dst "%r9"))
        (not (string.eq dst "%r10"))
        (not (string.eq src "%r9"))
        (not (string.eq src "%r10"))
        (not (string.eq value "%r9"))
        (not (string.eq value "%r10"))))
    true))

(define (compiler-backend-scratch-vreg-copy-xmm-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-memory-test-assignments)]
      [linux : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi
          (CompilerRegTargetAbi.Linux)
          "scratch_vreg_copy_xmm_linux"
          (compiler-backend-scratch-vreg-copy-xmm-test-blocks)
          2
          assignments)]
      [windows : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi
          (CompilerRegTargetAbi.Windows)
          "scratch_vreg_copy_xmm_windows"
          (compiler-backend-scratch-vreg-copy-xmm-test-blocks)
          2
          assignments)]
      [exact : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_copy_xmm_exact"
          (compiler-backend-scratch-vreg-copy-xmm-exact-test-blocks)
          2
          assignments)]
      (and
        (= (compiler-backend-scratch-test-plan-count linux) 4)
        (= (compiler-backend-scratch-test-success-count linux) 4)
        (= (compiler-backend-scratch-test-plan-count windows) 4)
        (= (compiler-backend-scratch-test-success-count windows) 4)
        (= (compiler-backend-scratch-test-plan-count exact) 3)
        (= (compiler-backend-scratch-test-success-count exact) 3)
        (compiler-backend-string-prefix-at?
          (compiler-backend-scratch-test-register linux 2)
          "%xmm"
          0)
        (compiler-backend-string-prefix-at?
          (compiler-backend-scratch-test-register windows 2)
          "%xmm"
          0)
        (compiler-backend-string-prefix-at?
          (compiler-backend-scratch-test-register exact 2)
          "%xmm"
          0)
        (match linux
          [(CompilerRegScratchPlanResult.Result _ plan)
            (let
              [requirement : CompilerRegScratchRequirement
                (struct-get (array-ref (struct-get plan items) 2) requirement)]
              (and
                (match (struct-get requirement role)
                  [(CompilerRegScratchRole.CopyValueXmm) true]
                  [_ false])
                (match (struct-get
                  (struct-get requirement constraint)
                  register-class)
                  [(CompilerRegScratchClass.Xmm) true]
                  [_ false])))])))
    true))

(define (compiler-backend-scratch-vreg-c-memory-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [name : i64 (ci.intern "scratch_c_memory_arg")]
      [aggregate-ty : AstType
        (AstType.Struct (ci.intern "ScratchCMemoryAggregate"))]
      [externs : CompilerIrExternList
        (compiler-ir-extern-cons
          (compiler-backend-non-direct-tail-call-extern
            name
            "scratch_c_memory_arg"
            name
            (ast-type-cons aggregate-ty (ast-type-list-new))
            (AstType.Unit)
            (AstExternAbi.C))
          CompilerIrExternList.Nil)]
      [_index : CompilerBackendProgramIndex
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          externs)]
      [assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -8))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.Register "%r11"))
            CompilerRegAssignmentList.Nil))]
      [blocks : CompilerIrBlockList
        (compiler-backend-scratch-vreg-c-memory-test-blocks name)]
      [linux : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi
          (CompilerRegTargetAbi.Linux)
          "scratch_c_memory_linux"
          blocks
          3
          assignments)]
      [windows : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi
          (CompilerRegTargetAbi.Windows)
          "scratch_c_memory_windows"
          blocks
          3
          assignments)]
      [indirect-linux : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi
          (CompilerRegTargetAbi.Linux)
          "scratch_c_memory_indirect_linux"
          (compiler-backend-scratch-vreg-c-memory-indirect-test-blocks true)
          3
          assignments)]
      [indirect-windows : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi
          (CompilerRegTargetAbi.Windows)
          "scratch_c_memory_indirect_windows"
          (compiler-backend-scratch-vreg-c-memory-indirect-test-blocks true)
          3
          assignments)]
      [indirect-no-marker : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi
          (CompilerRegTargetAbi.Linux)
          "scratch_c_memory_indirect_no_marker"
          (compiler-backend-scratch-vreg-c-memory-indirect-test-blocks false)
          3
          assignments)]
      (and
        (= (compiler-backend-scratch-test-plan-count linux) 2)
        (= (compiler-backend-scratch-test-success-count linux) 2)
        (= (compiler-backend-scratch-test-plan-count windows) 1)
        (= (compiler-backend-scratch-test-success-count windows) 1)
        (= (compiler-backend-scratch-test-plan-count indirect-linux) 3)
        (= (compiler-backend-scratch-test-success-count indirect-linux) 2)
        (= (compiler-backend-scratch-test-plan-count indirect-windows) 2)
        (= (compiler-backend-scratch-test-success-count indirect-windows) 1)
        (= (compiler-backend-scratch-test-plan-count indirect-no-marker) 2)
        (= (compiler-backend-scratch-test-success-count indirect-no-marker) 1)
        ;; The call target claims the only call-allowed GP scratch register. The
        ;; simultaneous call-stage requirement intentionally uses the fallback.
        (string.eq (compiler-backend-scratch-test-register indirect-linux 1) "")
        (string.eq
          (compiler-backend-scratch-test-register indirect-windows 1)
          "")
        (string.eq
          (compiler-backend-scratch-test-register indirect-no-marker 1)
          "")
        (compiler-backend-string-prefix-at?
          (compiler-backend-scratch-test-register linux 1)
          "%xmm"
          0)
        (compiler-backend-string-prefix-at?
          (compiler-backend-scratch-test-register indirect-linux 2)
          "%xmm"
          0)
        (match linux
          [(CompilerRegScratchPlanResult.Result _ plan)
            (let
              [requirement : CompilerRegScratchRequirement
                (struct-get (array-ref (struct-get plan items) 1) requirement)]
              (and
                (match (struct-get requirement role)
                  [(CompilerRegScratchRole.CallMemoryXmm) true]
                  [_ false])
                (match (struct-get
                  (struct-get requirement constraint)
                  register-class)
                  [(CompilerRegScratchClass.Xmm) true]
                  [_ false])))])))
    true))

(define (compiler-backend-scratch-vreg-float-memory-result-ok?
  [result : CompilerRegScratchPlanResult]
  [expected : i64]
  [value-ordinal : i64]) : bool
  (match result
    [(CompilerRegScratchPlanResult.Result _ plan)
      (let
        [value-reg : String
          (compiler-reg-scratch-plan-register plan 0 value-ordinal)]
        [items : (Array CompilerRegScratchAssignment) (struct-get plan items)]
        [value-item : CompilerRegScratchAssignment
          (array-ref items value-ordinal)]
        [requirement : CompilerRegScratchRequirement
          (struct-get value-item requirement)]
        (and
          (= (compiler-backend-scratch-test-plan-count result) expected)
          (= (compiler-backend-scratch-test-success-count result) expected)
          (compiler-backend-string-prefix-at? value-reg "%xmm" 0)
          (match (struct-get requirement role)
            [(CompilerRegScratchRole.FloatMemoryValueXmm) true]
            [_ false])
          (match (struct-get (struct-get requirement constraint) register-class)
            [(CompilerRegScratchClass.Xmm) true]
            [_ false])))]))

