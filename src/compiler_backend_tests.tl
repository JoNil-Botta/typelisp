              1
              (compiler_regalloc.CompilerRegLocation.Register
                (compiler_abi.compiler-abi-xmm-register-id 6)))
            compiler_regalloc.CompilerRegAssignmentList.Nil))]
      [direct-compare-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            0
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r12))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              1
              (compiler_regalloc.CompilerRegLocation.Register
                (compiler_abi.compiler-abi-xmm-register-id 6)))
            compiler_regalloc.CompilerRegAssignmentList.Nil))]
      [arith : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (compiler_abi.CompilerRegTargetAbi.Linux)
          "scratch_float_arith"
          (compiler-backend-scratch-vreg-float-arith-test-blocks)
          2
          f64-types
          (compiler-backend-scratch-vreg-float-arith-test-assignments))]
      [arith-windows : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (compiler_abi.CompilerRegTargetAbi.Windows)
          "scratch_float_arith_windows"
          (compiler-backend-scratch-vreg-float-arith-test-blocks)
          2
          f64-types
          (compiler-backend-scratch-vreg-float-arith-test-assignments))]
      [compare : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (compiler_abi.CompilerRegTargetAbi.Linux)
          "scratch_float_compare"
          (compiler-backend-scratch-vreg-float-compare-test-blocks)
          3
          f32-compare-types
          (compiler-backend-scratch-vreg-float-compare-test-assignments))]
      [compare-windows : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (compiler_abi.CompilerRegTargetAbi.Windows)
          "scratch_float_compare_windows"
          (compiler-backend-scratch-vreg-float-compare-test-blocks)
          3
          f32-compare-types
          (compiler-backend-scratch-vreg-float-compare-test-assignments))]
      [unop : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (compiler_abi.CompilerRegTargetAbi.Linux)
          "scratch_float_unop"
          (compiler-backend-scratch-vreg-float-unop-test-blocks)
          2
          f64-types
          (compiler-backend-scratch-vreg-float-unop-test-assignments))]
      [arith-return : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (compiler_abi.CompilerRegTargetAbi.Linux)
          "scratch_float_arith_return"
          (compiler-backend-scratch-vreg-float-arith-return-test-blocks)
          3
          f64-types
          (compiler-backend-scratch-vreg-float-arith-return-test-assignments))]
      [arith-return-windows : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (compiler_abi.CompilerRegTargetAbi.Windows)
          "scratch_float_arith_return_windows"
          (compiler-backend-scratch-vreg-float-arith-return-test-blocks)
          3
          f64-types
          (compiler-backend-scratch-vreg-float-arith-return-test-assignments))]
      [compare-return : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (compiler_abi.CompilerRegTargetAbi.Linux)
          "scratch_float_compare_return"
          (compiler-backend-scratch-vreg-float-compare-return-test-blocks)
          3
          f64-compare-types
          (compiler-backend-scratch-vreg-float-compare-return-test-assignments))]
      [compare-return-windows : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (compiler_abi.CompilerRegTargetAbi.Windows)
          "scratch_float_compare_return_windows"
          (compiler-backend-scratch-vreg-float-compare-return-test-blocks)
          3
          f64-compare-types
          (compiler-backend-scratch-vreg-float-compare-return-test-assignments))]
      [arith-reg : String (compiler-backend-scratch-test-register arith 0)]
      [compare-xmm : String (compiler-backend-scratch-test-register compare 0)]
      [compare-gp : String (compiler-backend-scratch-test-register compare 1)]
      [return-rhs : String
        (compiler-backend-scratch-test-register arith-return 1)]
      (and
        (= (compiler-backend-scratch-test-plan-count arith) 1)
        (= (compiler-backend-scratch-test-success-count arith) 1)
        (= (compiler-backend-scratch-test-plan-count arith-windows) 1)
        (= (compiler-backend-scratch-test-success-count arith-windows) 1)
        (>= (compiler_regalloc.compiler-reg-xmm-family-index arith-reg) 0)
        (not (= (compiler_regalloc.compiler-reg-xmm-family-index arith-reg) 6))
        (= (compiler-backend-scratch-test-plan-count compare) 2)
        (= (compiler-backend-scratch-test-success-count compare) 2)
        (= (compiler-backend-scratch-test-plan-count compare-windows) 2)
        (= (compiler-backend-scratch-test-success-count compare-windows) 2)
        (>= (compiler_regalloc.compiler-reg-xmm-family-index compare-xmm) 0)
        (< (compiler_regalloc.compiler-reg-xmm-family-index compare-gp) 0)
        (not
          (= (compiler_regalloc.compiler-reg-xmm-family-index compare-xmm) 7))
        (= (compiler-backend-scratch-test-plan-count unop) 1)
        (= (compiler-backend-scratch-test-success-count unop) 1)
        (= (compiler-backend-scratch-test-plan-count arith-return) 2)
        (= (compiler-backend-scratch-test-success-count arith-return) 2)
        (= (compiler-backend-scratch-test-plan-count arith-return-windows) 2)
        (= (compiler-backend-scratch-test-success-count arith-return-windows) 2)
        (string.eq
          (compiler-backend-scratch-test-register arith-return 0)
          "%xmm0")
        (not (string.eq return-rhs "%xmm0"))
        (= (compiler-backend-scratch-test-plan-count compare-return) 2)
        (= (compiler-backend-scratch-test-success-count compare-return) 2)
        (= (compiler-backend-scratch-test-plan-count compare-return-windows) 2)
        (=
          (compiler-backend-scratch-test-success-count compare-return-windows)
          2)
        (string.eq
          (compiler-backend-scratch-test-register compare-return 0)
          "%rax")
        (>=
          (compiler_regalloc.compiler-reg-xmm-family-index
            (compiler-backend-scratch-test-register compare-return 1))
          0)
        (=
          (compiler_regalloc.compiler-reg-scratch-vreg-slots
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_abi.CompilerRegTargetAbi.Linux)
            direct-arith-assignments
            f64-types
            (compiler_ir_types.CompilerIrInstr.BinOp
              0
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Global
                (ci.intern "scratch_float_global"))
              (compiler_ast_types.AstType.F64))
            (compiler_regalloc.compiler-reg-label-seq-empty)
            (compiler_regalloc.compiler-reg-label-seq-empty)
            false)
          0)
        (=
          (compiler_regalloc.compiler-reg-scratch-vreg-slots
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_abi.CompilerRegTargetAbi.Windows)
            direct-compare-assignments
            f64-compare-types
            (compiler_ir_types.CompilerIrInstr.BinOp
              0
              (compiler_ir_types.CompilerIrBinOp.Ne)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.CompilerIrValue.Global
                (ci.intern "scratch_float_global"))
              (compiler_ast_types.AstType.Bool))
            (compiler_regalloc.compiler-reg-label-seq-empty)
            (compiler_regalloc.compiler-reg-label-seq-empty)
            false)
          0)
        (compiler_regalloc.compiler-reg-scratch-compare-op?
          (compiler_ir_types.CompilerIrBinOp.Eq))
        (compiler_regalloc.compiler-reg-scratch-compare-op?
          (compiler_ir_types.CompilerIrBinOp.Ne))
        (compiler_regalloc.compiler-reg-scratch-compare-op?
          (compiler_ir_types.CompilerIrBinOp.Lt))
        (compiler_regalloc.compiler-reg-scratch-compare-op?
          (compiler_ir_types.CompilerIrBinOp.Le))
        (compiler_regalloc.compiler-reg-scratch-compare-op?
          (compiler_ir_types.CompilerIrBinOp.Gt))
        (compiler_regalloc.compiler-reg-scratch-compare-op?
          (compiler_ir_types.CompilerIrBinOp.Ge))
        (match arith-return
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (let
              [requirement : compiler_regalloc.CompilerRegScratchRequirement
                (struct-get (array-ref (struct-get plan items) 0) requirement)]
              (and
                (match (struct-get requirement role)
                  [(compiler_regalloc.CompilerRegScratchRole.FloatReturnResultXmm)
                    true]
                  [_ false])
                (string.eq
                  (struct-get (struct-get requirement constraint) fixed)
                  "%xmm0")
                (match (struct-get
                  (struct-get requirement constraint)
                  register-class)
                  [(compiler_regalloc.CompilerRegScratchClass.Xmm) true]
                  [_ false])))])
        (match compare-return
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (let
              [requirement : compiler_regalloc.CompilerRegScratchRequirement
                (struct-get (array-ref (struct-get plan items) 0) requirement)]
              (and
                (match (struct-get requirement role)
                  [(compiler_regalloc.CompilerRegScratchRole.FloatReturnResultGp)
                    true]
                  [_ false])
                (string.eq
                  (struct-get (struct-get requirement constraint) fixed)
                  "%rax")
                (match (struct-get
                  (struct-get requirement constraint)
                  register-class)
                  [(compiler_regalloc.CompilerRegScratchClass.Gp) true]
                  [_ false])))])
        (match arith
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (match (struct-get
              (struct-get (array-ref (struct-get plan items) 0) requirement)
              role)
              [(compiler_regalloc.CompilerRegScratchRole.FloatArithmeticResultXmm)
                true]
              [_ false])])
        (match compare
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.FloatCompareLhsXmm)
                  true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.FloatCompareResultGp)
                  true]
                [_ false]))])
        (match unop
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (match (struct-get
              (struct-get (array-ref (struct-get plan items) 0) requirement)
              role)
              [(compiler_regalloc.CompilerRegScratchRole.FloatUnaryResultXmm)
                true]
              [_ false])])))
    true))

(define (compiler-backend-scratch-vreg-float-compute-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [arith-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-float-arith-test-assignments)]
      [compare-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-float-compare-test-assignments)]
      [return-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-float-arith-return-test-assignments)]
      (match (compiler_backend.compiler-backend-emit-float-binop-spill-direct
        arith-assignments
        0
        (compiler_ir_types.CompilerIrBinOp.Sub)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ir_types.CompilerIrValue.F64 0x4000000000000000)
        (compiler_ast_types.AstType.F64)
        "%xmm14")
        [(compiler_backend.ResultCompilerBackend.Ok arith)
          (match (compiler_backend.compiler-backend-emit-binop-with-plan
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler-backend-scratch-float-types
              (compiler_ast_types.AstType.Bool)
              (compiler_ast_types.AstType.F32)
              3)
            (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
            compare-assignments
            0
            (compiler_ir_types.CompilerIrBinOp.Ge)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.Bool)
            "%xmm13"
            "%r14"
            ""
            ""
            "")
            [(compiler_backend.ResultCompilerBackend.Ok compare)
              (match (compiler_backend.compiler-backend-emit-unop-with-plan
                (compiler-backend-scratch-vreg-float-unop-test-assignments)
                0
                (compiler_ir_types.CompilerIrUnOp.Neg)
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ast_types.AstType.F64)
                "%xmm15")
                [(compiler_backend.ResultCompilerBackend.Ok unop)
                  (match (compiler_backend.compiler-backend-emit-float-arith-return
                    return-assignments
                    (compiler_ir_types.CompilerIrBinOp.Sub)
                    (compiler_ir_types.CompilerIrValue.Var 1)
                    (compiler_ir_types.CompilerIrValue.Var 2)
                    (compiler_ast_types.AstType.F64)
                    "%xmm0"
                    "%xmm14"
                    "    ret\n")
                    [(compiler_backend.ResultCompilerBackend.Ok arith-return)
                      (match (compiler_backend.compiler-backend-emit-float-compare-return
                        (compiler-backend-scratch-vreg-float-compare-return-test-assignments)
                        (compiler_ir_types.CompilerIrBinOp.Lt)
                        (compiler_ir_types.CompilerIrValue.Var 1)
                        (compiler_ir_types.CompilerIrValue.Var 2)
                        (compiler_ast_types.AstType.F64)
                        "%rax"
                        "%xmm14"
                        "%xmm15"
                        "    ret\n")
                        [(compiler_backend.ResultCompilerBackend.Ok
                            compare-return)
                          (and
                            (compiler_backend.compiler-backend-string-contains?
                              arith
                              "%xmm14")
                            (compiler_backend.compiler-backend-string-contains?
                              compare
                              "%xmm13")
                            (compiler_backend.compiler-backend-string-contains?
                              compare
                              "%r14")
                            (compiler_backend.compiler-backend-string-contains?
                              unop
                              "%xmm15")
                            (compiler_backend.compiler-backend-string-contains?
                              arith-return
                              "%xmm14")
                            (compiler_backend.compiler-backend-string-contains?
                              arith-return
                              "%xmm0")
                            (compiler_backend.compiler-backend-string-contains?
                              compare-return
                              "%xmm14")
                            (compiler_backend.compiler-backend-string-contains?
                              compare-return
                              "%rax"))]
                        [(compiler_backend.ResultCompilerBackend.Err _) false])]
                    [(compiler_backend.ResultCompilerBackend.Err _) false])]
                [(compiler_backend.ResultCompilerBackend.Err _) false])]
            [(compiler_backend.ResultCompilerBackend.Err _) false])]
        [(compiler_backend.ResultCompilerBackend.Err _) false]))
    true))

(define (compiler-backend-scratch-vreg-tail-target-avoids-callee-saved-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [result : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_tail_target"
          (compiler-backend-scratch-vreg-tail-target-test-blocks)
          3
          (compiler-backend-scratch-vreg-tail-target-test-assignments))]
      (and
        ;; The stable slot remains present but has an explicit empty assignment,
        ;; so emission falls back instead of using a restored callee-saved home.
        (= (compiler-backend-scratch-test-plan-count result) 2)
        (= (compiler-backend-scratch-test-success-count result) 0)
        (string.eq (compiler-backend-scratch-test-register result 0) "")))
    true))

(define (compiler-backend-scratch-vreg-simd-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [splat-blocks : compiler_ir_types.CompilerIrBlockList
        (compiler-backend-scratch-vreg-splat-test-blocks)]
      [splat : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_splat"
          splat-blocks
          2
          (compiler-backend-scratch-vreg-splat-test-assignments))]
      [splat-dense : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_splat_dense"
          (compiler_ir_types.compiler-ir-block-list-compact splat-blocks)
          2
          (compiler-backend-scratch-vreg-splat-test-assignments))]
      [reduce-blocks : compiler_ir_types.CompilerIrBlockList
        (compiler-backend-scratch-vreg-reduce-test-blocks)]
      [reduce : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_reduce"
          reduce-blocks
          2
          (compiler-backend-scratch-vreg-reduce-test-assignments))]
      [reduce-dense : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_reduce_dense"
          (compiler_ir_types.compiler-ir-block-list-compact reduce-blocks)
          2
          (compiler-backend-scratch-vreg-reduce-test-assignments))]
      [prefix-blocks : compiler_ir_types.CompilerIrBlockList
        (compiler-backend-scratch-vreg-prefix-test-blocks)]
      [prefix : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_prefix"
          prefix-blocks
          3
          (compiler-backend-scratch-vreg-prefix-test-assignments))]
      [prefix-dense : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_prefix_dense"
          (compiler_ir_types.compiler-ir-block-list-compact prefix-blocks)
          3
          (compiler-backend-scratch-vreg-prefix-test-assignments))]
      [splat-gp : String (compiler-backend-scratch-test-register splat 0)]
      [splat-xmm : String (compiler-backend-scratch-test-register splat 1)]
      [reduce-acc : String (compiler-backend-scratch-test-register reduce 0)]
      [reduce-temp : String (compiler-backend-scratch-test-register reduce 1)]
      [prefix-gp : String (compiler-backend-scratch-test-register prefix 0)]
      [prefix-xmm : String (compiler-backend-scratch-test-register prefix 1)]
      [prefix-work0 : String (compiler-backend-scratch-test-register prefix 2)]
      [prefix-work1 : String (compiler-backend-scratch-test-register prefix 3)]
      (and
        (= (compiler-backend-scratch-test-plan-count splat) 2)
        (= (compiler-backend-scratch-test-success-count splat) 2)
        (not (string.eq splat-gp ""))
        (not (string.eq splat-xmm ""))
        (not (string.eq splat-gp "%r8"))
        (not (= (compiler_regalloc.compiler-reg-xmm-family-index splat-xmm) 6))
        (string.eq
          splat-gp
          (compiler-backend-scratch-test-register splat-dense 0))
        (string.eq
          splat-xmm
          (compiler-backend-scratch-test-register splat-dense 1))
        (= (compiler-backend-scratch-test-plan-count reduce) 2)
        (= (compiler-backend-scratch-test-success-count reduce) 2)
        (not (string.eq reduce-acc ""))
        (not (string.eq reduce-temp ""))
        (not (string.eq reduce-acc reduce-temp))
        (not (= (compiler_regalloc.compiler-reg-xmm-family-index reduce-acc) 2))
        (not (= (compiler_regalloc.compiler-reg-xmm-family-index reduce-acc) 6))
        (not
          (= (compiler_regalloc.compiler-reg-xmm-family-index reduce-temp) 2))
        (not
          (= (compiler_regalloc.compiler-reg-xmm-family-index reduce-temp) 6))
        (string.eq
          reduce-acc
          (compiler-backend-scratch-test-register reduce-dense 0))
        (string.eq
          reduce-temp
          (compiler-backend-scratch-test-register reduce-dense 1))
        (= (compiler-backend-scratch-test-plan-count prefix) 4)
        (= (compiler-backend-scratch-test-success-count prefix) 4)
        (not (string.eq prefix-gp ""))
        (not (string.eq prefix-xmm ""))
        (not (string.eq prefix-work0 ""))
        (not (string.eq prefix-work1 ""))
        (not (string.eq prefix-gp "%r8"))
        (not (= (compiler_regalloc.compiler-reg-xmm-family-index prefix-xmm) 6))
        (not
          (= (compiler_regalloc.compiler-reg-xmm-family-index prefix-work0) 6))
        (not
          (= (compiler_regalloc.compiler-reg-xmm-family-index prefix-work1) 6))
        (not
          (compiler_regalloc.compiler-reg-registers-overlap?
            prefix-xmm
            prefix-work0))
        (not
          (compiler_regalloc.compiler-reg-registers-overlap?
            prefix-xmm
            prefix-work1))
        (not
          (compiler_regalloc.compiler-reg-registers-overlap?
            prefix-work0
            prefix-work1))
        (string.eq
          prefix-gp
          (compiler-backend-scratch-test-register prefix-dense 0))
        (string.eq
          prefix-xmm
          (compiler-backend-scratch-test-register prefix-dense 1))
        (string.eq
          prefix-work0
          (compiler-backend-scratch-test-register prefix-dense 2))
        (string.eq
          prefix-work1
          (compiler-backend-scratch-test-register prefix-dense 3))
        (match splat
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.SplatValueGp) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.SplatValueXmm) true]
                [_ false]))])
        (match reduce
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.VectorReduceAccumulator)
                  true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.VectorReduceScratch)
                  true]
                [_ false]))])
        (match prefix
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.VectorPrefixCarry)
                  true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.VectorPrefixValue)
                  true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 2) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.VectorPrefixWork0)
                  true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 3) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.VectorPrefixWork1)
                  true]
                [_ false]))])))
    true))

(define (compiler-backend-scratch-vreg-indexed-simd-points-ok?
  [plan : compiler_regalloc.CompilerRegScratchPlan]
  [dense-plan : compiler_regalloc.CompilerRegScratchPlan]
  [point : i64]) : bool
  (if (>= point 16)
    true
    (let
      [base : i64
        (compiler_regalloc.compiler-reg-scratch-plan-register plan point 0)]
      [index : i64
        (compiler_regalloc.compiler-reg-scratch-plan-register plan point 1)]
      (and
        (not (= base compiler_abi.compiler-reg-id-invalid))
        (not (= index compiler_abi.compiler-reg-id-invalid))
        (not (compiler_regalloc.compiler-reg-registers-overlap? base index))
        (=
          base
          (compiler_regalloc.compiler-reg-scratch-plan-register
            dense-plan
            point
            0))
        (=
          index
          (compiler_regalloc.compiler-reg-scratch-plan-register
            dense-plan
            point
            1))
        (if (>= point 12)
          (and
            (not (= base compiler_abi.compiler-reg-id-r12))
            (not (= index compiler_abi.compiler-reg-id-r12)))
          true)
        (compiler-backend-scratch-vreg-indexed-simd-points-ok?
          plan
          dense-plan
          (+ point 2))))))

(define (compiler-backend-scratch-vreg-indexed-simd-role?
  [plan : compiler_regalloc.CompilerRegScratchPlan]
  [index : i64]
  [base? : bool]) : bool
  (let
    [requirement : compiler_regalloc.CompilerRegScratchRequirement
      (struct-get (array-ref (struct-get plan items) index) requirement)]
    (match (struct-get requirement role)
      [(compiler_regalloc.CompilerRegScratchRole.SimdAddressBase) base?]
      [(compiler_regalloc.CompilerRegScratchRole.SimdAddressIndex) (not base?)]
      [_ false])))

(define (compiler-backend-scratch-vreg-indexed-simd-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [blocks : compiler_ir_types.CompilerIrBlockList
        (compiler-backend-scratch-vreg-indexed-simd-test-blocks)]
      [assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-indexed-simd-test-assignments)]
      [listed : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_indexed_simd"
          blocks
          12
          assignments)]
      [dense : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_indexed_simd_dense"
          (compiler_ir_types.compiler-ir-block-list-compact blocks)
          12
          assignments)]
      [fused-blocks : compiler_ir_types.CompilerIrBlockList
        (compiler-backend-scratch-vreg-indexed-simd-fused-blocks)]
      [fused : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_indexed_simd_fused"
          fused-blocks
          5
          (compiler-backend-scratch-vreg-indexed-simd-fused-assignments))]
      [fused-dense : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_indexed_simd_fused_dense"
          (compiler_ir_types.compiler-ir-block-list-compact fused-blocks)
          5
          (compiler-backend-scratch-vreg-indexed-simd-fused-assignments))]
      (match listed
        [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
          (match dense
            [(compiler_regalloc.CompilerRegScratchPlanResult.Result
                _
                dense-plan)
              (match fused
                [(compiler_regalloc.CompilerRegScratchPlanResult.Result
                    _
                    fused-plan)
                  (match fused-dense
                    [(compiler_regalloc.CompilerRegScratchPlanResult.Result
                        _
                        fused-dense-plan)
                      (let
                        [constant-base : i64
                          (compiler_regalloc.compiler-reg-scratch-plan-register
                            plan
                            16
                            0)]
                        [vector-constant-base : i64
                          (compiler_regalloc.compiler-reg-scratch-plan-register
                            plan
                            18
                            0)]
                        [fused-base : compiler_regalloc.CompilerRegScratchRequirement
                          (struct-get
                            (array-ref (struct-get fused-plan items) 0)
                            requirement)]
                        [fused-index : compiler_regalloc.CompilerRegScratchRequirement
                          (struct-get
                            (array-ref (struct-get fused-plan items) 1)
                            requirement)]
                        (and
                          (=
                            (compiler_regalloc.compiler-reg-scratch-plan-count
                              plan)
                            18)
                          (=
                            (compiler_backend.compiler-backend-scratch-plan-success-count
                              plan)
                            18)
                          (=
                            (compiler_regalloc.compiler-reg-scratch-plan-count
                              dense-plan)
                            18)
                          (compiler-backend-scratch-vreg-indexed-simd-points-ok?
                            plan
                            dense-plan
                            0)
                          (not
                            (=
                              constant-base
                              compiler_abi.compiler-reg-id-invalid))
                          (=
                            constant-base
                            (compiler_regalloc.compiler-reg-scratch-plan-register
                              dense-plan
                              16
                              0))
                          (=
                            (compiler_regalloc.compiler-reg-scratch-plan-register
                              plan
                              16
                              1)
                            compiler_abi.compiler-reg-id-invalid)
                          (not
                            (=
                              vector-constant-base
                              compiler_abi.compiler-reg-id-invalid))
                          (=
                            vector-constant-base
                            (compiler_regalloc.compiler-reg-scratch-plan-register
                              dense-plan
                              18
                              0))
                          (=
                            (compiler_regalloc.compiler-reg-scratch-plan-register
                              plan
                              18
                              1)
                            compiler_abi.compiler-reg-id-invalid)
                          (not
                            (= constant-base compiler_abi.compiler-reg-id-r12))
                          (compiler-backend-scratch-vreg-indexed-simd-role?
                            plan
                            0
                            true)
                          (compiler-backend-scratch-vreg-indexed-simd-role?
                            plan
                            1
                            false)
                          (compiler-backend-scratch-vreg-indexed-simd-role?
                            plan
                            16
                            true)
                          (compiler-backend-scratch-vreg-indexed-simd-role?
                            plan
                            17
                            true)
                          (=
                            (compiler_regalloc.compiler-reg-scratch-plan-count
                              fused-plan)
                            2)
                          (=
                            (compiler_backend.compiler-backend-scratch-plan-success-count
                              fused-plan)
                            2)
                          (= (struct-get fused-base lo) 0)
                          (= (struct-get fused-base hi) 3)
                          (= (struct-get fused-index lo) 0)
                          (= (struct-get fused-index hi) 3)
                          (=
                            (compiler_regalloc.compiler-reg-scratch-plan-register
                              fused-plan
                              0
                              0)
                            (compiler_regalloc.compiler-reg-scratch-plan-register
                              fused-dense-plan
                              0
                              0))
                          (=
                            (compiler_regalloc.compiler-reg-scratch-plan-register
                              fused-plan
                              0
                              1)
                            (compiler_regalloc.compiler-reg-scratch-plan-register
                              fused-dense-plan
                              0
                              1))))])])])]))
    true))

(define (compiler-backend-scratch-vreg-simd-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [splat-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            0
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r12))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              1
              (compiler_regalloc.CompilerRegLocation.Register
                (compiler_abi.compiler-abi-vector-register-id 6)))
            compiler_regalloc.CompilerRegAssignmentList.Nil))]
      [reduce-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            0
            (compiler_regalloc.CompilerRegLocation.Register
              (compiler_abi.compiler-abi-vector-register-id 6)))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              1
              (compiler_regalloc.CompilerRegLocation.Spill -16))
            compiler_regalloc.CompilerRegAssignmentList.Nil))]
      [diag : compiler_diagnostic.CompilerDiagnostic
        (compiler_diagnostic.compiler-diagnostic-at-start "" "")]
      (match (compiler_backend.compiler-backend-emit-vector-splat
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        splat-assignments
        1
        (compiler_ir_types.CompilerIrValue.Var 0)
        4
        (compiler_ast_types.AstType.I64)
        "%r14"
        "%xmm14"
        diag)
        [(compiler_backend.ResultCompilerBackend.Ok splat)
          (match (compiler_backend.compiler-backend-emit-vector-reduce
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            reduce-assignments
            1
            (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
            (compiler_ir_types.CompilerIrValue.Var 0)
            4
            (compiler_ast_types.AstType.I64)
            "%xmm14"
            "%xmm15"
            diag)
            [(compiler_backend.ResultCompilerBackend.Ok avx2)
              (match (compiler_backend.compiler-backend-emit-vector-reduce
                (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                reduce-assignments
                1
                (compiler_ir_types.CompilerIrVectorReduceOp.Sum)
                (compiler_ir_types.CompilerIrValue.Var 0)
                8
                (compiler_ast_types.AstType.I64)
                "%xmm14"
                "%xmm15"
                diag)
                [(compiler_backend.ResultCompilerBackend.Ok avx512)
                  (and
                    (compiler_backend.compiler-backend-string-contains?
                      splat
                      "%r14")
                    (compiler_backend.compiler-backend-string-contains?
                      splat
                      "%xmm14")
                    (compiler_backend.compiler-backend-string-contains?
                      avx2
                      "%xmm14")
                    (compiler_backend.compiler-backend-string-contains?
                      avx2
                      "%xmm15")
                    (compiler_backend.compiler-backend-string-contains?
                      avx512
                      "%xmm14")
                    (compiler_backend.compiler-backend-string-contains?
                      avx512
                      "%xmm15"))]
                [(compiler_backend.ResultCompilerBackend.Err _) false])]
            [(compiler_backend.ResultCompilerBackend.Err _) false])]
        [(compiler_backend.ResultCompilerBackend.Err _) false]))
    true))

(define (compiler-backend-scratch-vreg-conversion-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [cast-blocks : compiler_ir_types.CompilerIrBlockList
        (compiler-backend-scratch-vreg-cast-test-blocks)]
      [cast : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_cast"
          cast-blocks
          2
          (compiler-backend-scratch-vreg-cast-test-assignments))]
      [cast-dense : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_cast_dense"
          (compiler_ir_types.compiler-ir-block-list-compact cast-blocks)
          2
          (compiler-backend-scratch-vreg-cast-test-assignments))]
      [cast-windows : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi
          (compiler_abi.CompilerRegTargetAbi.Windows)
          "scratch_vreg_float_cast_windows"
          cast-blocks
          2
          (compiler-backend-scratch-vreg-cast-test-assignments))]
      [gp-only : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_cast_gp_only"
          (compiler-backend-scratch-vreg-cast-gp-only-test-blocks)
          2
          (compiler-backend-scratch-vreg-cast-gp-only-test-assignments))]
      [bitcast-blocks : compiler_ir_types.CompilerIrBlockList
        (compiler-backend-scratch-vreg-bitcast-test-blocks)]
      [bitcast : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_bitcast"
          bitcast-blocks
          2
          (compiler-backend-scratch-vreg-bitcast-test-assignments))]
      [bitcast-dense : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_bitcast_dense"
          (compiler_ir_types.compiler-ir-block-list-compact bitcast-blocks)
          2
          (compiler-backend-scratch-vreg-bitcast-test-assignments))]
      [mov : compiler_regalloc.CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_mov"
          (compiler-backend-scratch-vreg-float-mov-test-blocks)
          2
          (compiler-backend-scratch-vreg-float-mov-test-assignments))]
      [cast-xmm : String (compiler-backend-scratch-test-register cast 0)]
      [cast-gp0 : String (compiler-backend-scratch-test-register cast 1)]
      [cast-gp1 : String (compiler-backend-scratch-test-register cast 2)]
      [cast-win-xmm : String
        (compiler-backend-scratch-test-register cast-windows 0)]
      [cast-win-gp0 : String
        (compiler-backend-scratch-test-register cast-windows 1)]
      [cast-win-gp1 : String
        (compiler-backend-scratch-test-register cast-windows 2)]
      [gp-only-reg : String (compiler-backend-scratch-test-register gp-only 0)]
      [bitcast-xmm : String (compiler-backend-scratch-test-register bitcast 0)]
      [bitcast-gp : String (compiler-backend-scratch-test-register bitcast 1)]
      [mov-xmm : String (compiler-backend-scratch-test-register mov 0)]
      [same-home : compiler_regalloc.CompilerRegAssignmentList
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            0
            (compiler_regalloc.CompilerRegLocation.Spill -8))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              1
              (compiler_regalloc.CompilerRegLocation.Spill -8))
            compiler_regalloc.CompilerRegAssignmentList.Nil))]
      (and
        (= (compiler-backend-scratch-test-plan-count cast) 3)
        (= (compiler-backend-scratch-test-success-count cast) 3)
        (>= (compiler_regalloc.compiler-reg-xmm-family-index cast-xmm) 0)
        (not (string.eq cast-gp0 ""))
        (not (string.eq cast-gp1 ""))
        (not (string.eq cast-gp0 cast-gp1))
        (not (string.eq cast-gp0 "%r12"))
        (not (string.eq cast-gp1 "%r12"))
        (string.eq
          cast-xmm
          (compiler-backend-scratch-test-register cast-dense 0))
        (string.eq
          cast-gp0
          (compiler-backend-scratch-test-register cast-dense 1))
        (string.eq
          cast-gp1
          (compiler-backend-scratch-test-register cast-dense 2))
        (= (compiler-backend-scratch-test-plan-count cast-windows) 3)
        (= (compiler-backend-scratch-test-success-count cast-windows) 3)
        (>= (compiler_regalloc.compiler-reg-xmm-family-index cast-win-xmm) 0)
        (not (string.eq cast-win-gp0 ""))
        (not (string.eq cast-win-gp1 ""))
        (not (string.eq cast-win-gp0 cast-win-gp1))
        (not (string.eq cast-win-gp0 "%r12"))
        (not (string.eq cast-win-gp1 "%r12"))
        (= (compiler-backend-scratch-test-plan-count gp-only) 1)
        (= (compiler-backend-scratch-test-success-count gp-only) 1)
        (not (string.eq gp-only-reg ""))
        (< (compiler_regalloc.compiler-reg-xmm-family-index gp-only-reg) 0)
        (= (compiler-backend-scratch-test-plan-count bitcast) 2)
        (= (compiler-backend-scratch-test-success-count bitcast) 2)
        (>= (compiler_regalloc.compiler-reg-xmm-family-index bitcast-xmm) 0)
        (not (string.eq bitcast-gp ""))
        (< (compiler_regalloc.compiler-reg-xmm-family-index bitcast-gp) 0)
        (string.eq
          bitcast-xmm
          (compiler-backend-scratch-test-register bitcast-dense 0))
        (string.eq
          bitcast-gp
          (compiler-backend-scratch-test-register bitcast-dense 1))
        (= (compiler-backend-scratch-test-plan-count mov) 1)
        (= (compiler-backend-scratch-test-success-count mov) 1)
        (>= (compiler_regalloc.compiler-reg-xmm-family-index mov-xmm) 0)
        (not (= (compiler_regalloc.compiler-reg-xmm-family-index mov-xmm) 6))
        (=
          (compiler_regalloc.compiler-reg-scratch-cast-slot-count
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            same-home
            1
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.F64)
            (compiler_ast_types.AstType.F64))
          0)
        (=
          (compiler_regalloc.compiler-reg-scratch-vreg-slots
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_abi.CompilerRegTargetAbi.Linux)
            same-home
            (compiler_regalloc.compiler-reg-var-types-empty)
            (compiler_ir_types.CompilerIrInstr.Mov
              1
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ast_types.AstType.F64))
            (compiler_regalloc.compiler-reg-label-seq-empty)
            (compiler_regalloc.compiler-reg-label-seq-empty)
            false)
          0)
        (match cast
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.FloatCastValueXmm)
                  true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.FloatCastValueGp)
                  true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 2) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.FloatCastScratchGp)
                  true]
                [_ false]))])
        (match gp-only
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (match (struct-get
              (struct-get (array-ref (struct-get plan items) 0) requirement)
              role)
              [(compiler_regalloc.CompilerRegScratchRole.FloatCastValueGp) true]
              [_ false])])
        (match bitcast
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.FloatBitcastValueXmm)
                  true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(compiler_regalloc.CompilerRegScratchRole.FloatBitcastValueGp)
                  true]
                [_ false]))])
        (match mov
          [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ plan)
            (match (struct-get
              (struct-get (array-ref (struct-get plan items) 0) requirement)
              role)
              [(compiler_regalloc.CompilerRegScratchRole.FloatMoveValueXmm)
                true]
              [_ false])])))
    true))

(define (compiler-backend-scratch-vreg-conversion-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [index : compiler_backend.CompilerBackendProgramIndex
        (compiler_backend.compiler-backend-program-index-build
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          compiler_ir_types.CompilerIrFunctionList.Nil
          compiler_ir_types.CompilerIrExternList.Nil)]
      [cast-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-cast-test-assignments)]
      [gp-only-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-cast-gp-only-test-assignments)]
      [bitcast-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-bitcast-test-assignments)]
      [mov-assignments : compiler_regalloc.CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-float-mov-test-assignments)]
      (match (compiler_backend.compiler-backend-emit-cast
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        "test_cast"
        (compiler_ir_types.compiler-ir-label "entry")
        cast-assignments
        1
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ast_types.AstType.U64)
        (compiler_ast_types.AstType.F64)
        index
        "%xmm14"
        "%r14"
        "%r15")
        [(compiler_backend.ResultCompilerBackend.Ok cast-asm)
          (match (compiler_backend.compiler-backend-emit-cast
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            "test_cast_gp"
            (compiler_ir_types.compiler-ir-label "entry")
            gp-only-assignments
            1
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.I64)
            (compiler_ast_types.AstType.F64)
            index
            "%r14"
            ""
            "")
            [(compiler_backend.ResultCompilerBackend.Ok gp-only-asm)
              (match (compiler_backend.compiler-backend-emit-bitcast
                (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                bitcast-assignments
                1
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ast_types.AstType.F64)
                (compiler_ast_types.AstType.U64)
                index
                "%xmm14"
                "%r14")
                [(compiler_backend.ResultCompilerBackend.Ok bitcast-asm)
                  (match (compiler_backend.compiler-backend-emit-mov
                    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                    mov-assignments
                    1
                    (compiler_ir_types.CompilerIrValue.Var 0)
                    (compiler_ast_types.AstType.F64)
                    index
                    2
                    "%xmm14")
                    [(compiler_backend.ResultCompilerBackend.Ok mov-asm)
                      (and
                        (compiler_backend.compiler-backend-string-contains?
                          cast-asm
                          "%xmm14")
                        (compiler_backend.compiler-backend-string-contains?
                          cast-asm
                          "%r14")
                        (compiler_backend.compiler-backend-string-contains?
                          cast-asm
                          "%r15")
                        (compiler_backend.compiler-backend-string-contains?
                          gp-only-asm
                          "%r14")
                        (compiler_backend.compiler-backend-string-contains?
                          gp-only-asm
                          "%xmm6")
                        (not
                          (compiler_backend.compiler-backend-string-contains?
                            gp-only-asm
                            "%xmm14"))
                        (compiler_backend.compiler-backend-string-contains?
                          bitcast-asm
                          "%xmm14")
                        (compiler_backend.compiler-backend-string-contains?
                          bitcast-asm
                          "%r14")
                        (compiler_backend.compiler-backend-string-contains?
                          mov-asm
                          "%xmm14"))]
                    [(compiler_backend.ResultCompilerBackend.Err _) false])]
                [(compiler_backend.ResultCompilerBackend.Err _) false])]
            [(compiler_backend.ResultCompilerBackend.Err _) false])]
        [(compiler_backend.ResultCompilerBackend.Err _) false]))
    true))

(define (compiler-backend-scratch-vreg-incomplete-group-fallback-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [items : (Array compiler_regalloc.CompilerRegScratchAssignment)
        (array.make-array compiler_regalloc.CompilerRegScratchAssignment 2)]
      [starts : (Array i64) (array.make-array i64 2)]
      [ends : (Array i64) (array.make-array i64 2)]
      [segments : (Array compiler_regalloc.CompilerRegIntervalSeq)
        (array.make-array compiler_regalloc.CompilerRegIntervalSeq 2)]
      [present : (Array i64) (array.make-array i64 2)]
      [types : (Array compiler_ast_types.AstType)
        (array.make-array compiler_ast_types.AstType 2)]
      [assignments : compiler_regalloc.CompilerRegAssignmentTable
        (compiler_regalloc.compiler-reg-assignment-table-make 2)]
      [registers : (Array i64)
        (compiler_regalloc.compiler-reg-scratch-register-array
          (compiler_abi.CompilerRegTargetAbi.Linux))]
      [occupancy : compiler_regalloc.CompilerRegGreedyOccupancy
        (compiler_regalloc.compiler-reg-greedy-occupancy-make
          assignments
          registers
          (array-length registers))]
      [ref-counts : (Array i64) (array.make-array i64 2)]
      [fixed-rcx : compiler_regalloc.CompilerRegScratchConstraint
        (compiler_regalloc.CompilerRegScratchConstraint
          (compiler_regalloc.CompilerRegScratchClass.Gp)
          (compiler_regalloc.compiler-reg-id-seq-empty)
          (compiler_regalloc.compiler-reg-id-seq-empty)
          compiler_abi.compiler-reg-id-rcx)]
      (begin
        (compiler_regalloc.compiler-reg-fill-i64-array starts -1)
        (compiler_regalloc.compiler-reg-fill-i64-array ends -1)
        (compiler_regalloc.compiler-reg-fill-i64-array present 0)
        (compiler_regalloc.compiler-reg-fill-i64-array ref-counts 0)
        (compiler_regalloc.compiler-reg-fill-interval-seq-array! segments 0)
        (array-set!
          items
          0
          (compiler_regalloc.CompilerRegScratchAssignment
            (compiler_regalloc.CompilerRegScratchRequirement
              0
              0
              (compiler_regalloc.CompilerRegScratchRole.MemoryAddress)
              fixed-rcx
              0
              3
              0)
            compiler_abi.compiler-reg-id-invalid))
        (array-set!
          items
          1
          (compiler_regalloc.CompilerRegScratchAssignment
            (compiler_regalloc.CompilerRegScratchRequirement
              2
              0
              (compiler_regalloc.CompilerRegScratchRole.MemoryAddress)
              fixed-rcx
              0
              3
              1)
            compiler_abi.compiler-reg-id-invalid))
        (compiler_regalloc.compiler-reg-scratch-mark-requirement!
          starts
          ends
          segments
          present
          types
          (struct-get (array-ref items 0) requirement))
        (compiler_regalloc.compiler-reg-scratch-mark-requirement!
          starts
          ends
          segments
          present
          types
          (struct-get (array-ref items 1) requirement))
        (compiler_regalloc.compiler-reg-scratch-assign-items!
          (compiler_abi.CompilerRegTargetAbi.Linux)
          items
          0
          assignments
          occupancy
          (compiler_regalloc.CompilerRegIntervalIndex starts ends segments)
          ref-counts
          registers
          (array-length registers)
          2)
        (let
          [partial? : bool
            (and
              (=
                (struct-get (array-ref items 0) register)
                compiler_abi.compiler-reg-id-rcx)
              (=
                (struct-get (array-ref items 1) register)
                compiler_abi.compiler-reg-id-invalid))]
          (begin
            (compiler_regalloc.compiler-reg-scratch-clear-incomplete-groups!
              items
              0)
            (and
              partial?
              (=
                (struct-get (array-ref items 0) register)
                compiler_abi.compiler-reg-id-invalid)
              (=
                (struct-get (array-ref items 1) register)
                compiler_abi.compiler-reg-id-invalid))))))
    true))

(define (compiler-backend-scratch-vreg-constraint-shapes-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [items : (Array compiler_regalloc.CompilerRegScratchAssignment)
        (array.make-array compiler_regalloc.CompilerRegScratchAssignment 5)]
      [starts : (Array i64) (array.make-array i64 5)]
      [ends : (Array i64) (array.make-array i64 5)]
      [segments : (Array compiler_regalloc.CompilerRegIntervalSeq)
        (array.make-array compiler_regalloc.CompilerRegIntervalSeq 5)]
      [present : (Array i64) (array.make-array i64 5)]
      [types : (Array compiler_ast_types.AstType)
        (array.make-array compiler_ast_types.AstType 5)]
      [assignments : compiler_regalloc.CompilerRegAssignmentTable
        (compiler_regalloc.compiler-reg-assignment-table-make 5)]
      [registers : (Array i64)
        (compiler_regalloc.compiler-reg-scratch-register-array
          (compiler_abi.CompilerRegTargetAbi.Linux))]
      [occupancy : compiler_regalloc.CompilerRegGreedyOccupancy
        (compiler_regalloc.compiler-reg-greedy-occupancy-make
          assignments
          registers
          (array-length registers))]
      [ref-counts : (Array i64) (array.make-array i64 5)]
      [gp-fixed-rcx : compiler_regalloc.CompilerRegScratchConstraint
        (compiler_regalloc.CompilerRegScratchConstraint
          (compiler_regalloc.CompilerRegScratchClass.Gp)
          (compiler_regalloc.compiler-reg-id-seq-empty)
          (compiler_regalloc.compiler-reg-id-seq-empty)
          compiler_abi.compiler-reg-id-rcx)]
      [gp-r10-not-rcx : compiler_regalloc.CompilerRegScratchConstraint
        (compiler_regalloc.CompilerRegScratchConstraint
          (compiler_regalloc.CompilerRegScratchClass.Gp)
          (compiler_regalloc.compiler-reg-id-seq-prepend
            compiler_abi.compiler-reg-id-rcx
            (compiler_regalloc.compiler-reg-id-seq-prepend
              compiler_abi.compiler-reg-id-r10
              (compiler_regalloc.compiler-reg-id-seq-empty)))
          (compiler_regalloc.compiler-reg-id-seq-prepend
            compiler_abi.compiler-reg-id-rcx
            (compiler_regalloc.compiler-reg-id-seq-empty))
          compiler_abi.compiler-reg-id-invalid)]
      [gp-r10 : compiler_regalloc.CompilerRegScratchConstraint
        (compiler_regalloc.CompilerRegScratchConstraint
          (compiler_regalloc.CompilerRegScratchClass.Gp)
          (compiler_regalloc.compiler-reg-id-seq-prepend
            compiler_abi.compiler-reg-id-r10
            (compiler_regalloc.compiler-reg-id-seq-empty))
          (compiler_regalloc.compiler-reg-id-seq-empty)
          compiler_abi.compiler-reg-id-invalid)]
      [xmm-any : compiler_regalloc.CompilerRegScratchConstraint
        (compiler_regalloc.CompilerRegScratchConstraint
          (compiler_regalloc.CompilerRegScratchClass.Xmm)
          (compiler_regalloc.compiler-reg-id-seq-empty)
          (compiler_regalloc.compiler-reg-id-seq-empty)
          compiler_abi.compiler-reg-id-invalid)]
      (begin
        (compiler_regalloc.compiler-reg-fill-i64-array starts -1)
        (compiler_regalloc.compiler-reg-fill-i64-array ends -1)
        (compiler_regalloc.compiler-reg-fill-i64-array present 0)
        (compiler_regalloc.compiler-reg-fill-i64-array ref-counts 0)
        (compiler_regalloc.compiler-reg-fill-interval-seq-array! segments 0)
        ;; Fixed RCX lives across the complete region.
        (array-set!
          items
          0
          (compiler_regalloc.CompilerRegScratchAssignment
            (compiler_regalloc.CompilerRegScratchRequirement
              0
              0
              (compiler_regalloc.CompilerRegScratchRole.CallTarget)
              gp-fixed-rcx
              0
              4
              0)
            compiler_abi.compiler-reg-id-invalid))
        ;; Allowed {rcx,r10}, excluded {rcx}: selects r10.
        (array-set!
          items
          1
          (compiler_regalloc.CompilerRegScratchAssignment
            (compiler_regalloc.CompilerRegScratchRequirement
              0
              1
              (compiler_regalloc.CompilerRegScratchRole.SwitchIndex)
              gp-r10-not-rcx
              0
              2
              1)
            compiler_abi.compiler-reg-id-invalid))
        ;; The same solver supports the XMM register file.
        (array-set!
          items
          2
          (compiler_regalloc.CompilerRegScratchAssignment
            (compiler_regalloc.CompilerRegScratchRequirement
              0
              2
              (compiler_regalloc.CompilerRegScratchRole.SwitchTable)
              xmm-any
              0
              2
              2)
            compiler_abi.compiler-reg-id-invalid))
        ;; A simultaneous fixed-RCX request fails explicitly.
        (array-set!
          items
          3
          (compiler_regalloc.CompilerRegScratchAssignment
            (compiler_regalloc.CompilerRegScratchRequirement
              2
              0
              (compiler_regalloc.CompilerRegScratchRole.BoundsLength)
              gp-fixed-rcx
              2
              3
              3)
            compiler_abi.compiler-reg-id-invalid))
        ;; A later non-overlapping slot can reuse r10.
        (array-set!
          items
          4
          (compiler_regalloc.CompilerRegScratchAssignment
            (compiler_regalloc.CompilerRegScratchRequirement
              3
              0
              (compiler_regalloc.CompilerRegScratchRole.BoundsLength)
              gp-r10
              3
              4
              4)
            compiler_abi.compiler-reg-id-invalid))
        (let
          [i : i64 0]
          (while (< i 5)
            (begin
              (compiler_regalloc.compiler-reg-scratch-mark-requirement!
                starts
                ends
                segments
                present
                types
                (struct-get (array-ref items i) requirement))
              (set! i (+ i 1)))))
        (compiler_regalloc.compiler-reg-scratch-assign-items!
          (compiler_abi.CompilerRegTargetAbi.Linux)
          items
          0
          assignments
          occupancy
          (compiler_regalloc.CompilerRegIntervalIndex starts ends segments)
          ref-counts
          registers
          (array-length registers)
          5)
        (and
          (=
            (struct-get (array-ref items 0) register)
            compiler_abi.compiler-reg-id-rcx)
          (=
            (struct-get (array-ref items 1) register)
            compiler_abi.compiler-reg-id-r10)
          (=
            (struct-get (array-ref items 2) register)
            (compiler_abi.compiler-abi-xmm-register-id 2))
          (=
            (struct-get (array-ref items 3) register)
            compiler_abi.compiler-reg-id-invalid)
          (=
            (struct-get (array-ref items 4) register)
            compiler_abi.compiler-reg-id-r10))))
    true))

(define (compiler-backend-scavenge-emergency-respects-exclude-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 1)]
    [ends : (Array i64) (make-array i64 1)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    [exclude : (Array String)
      (compiler-backend-scavenge-emergency-exclude-fallback)]
    (begin
      (array-set! starts 0 0)
      (array-set! ends 0 10)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending!
        false)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used!
        false)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending-count!
        0)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used-count!
        0)
      (let
        [reg : String
          (compiler-backend-scavenge-pick
            starts
            ends
            (compiler_regalloc.compiler-reg-assignment-index-build
              assignments
              1)
            1
            5
            exclude
            9
            "%r8")]
        [ok : bool
          (and
            (string.eq reg "%r12")
            (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-pending)
            (=
              (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-reg)
              compiler_abi.compiler-reg-id-r12)
            (=
              (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-pending-count)
              1)
            (=
              (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-used-count)
              1))]
        (begin
          (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending!
            false)
          (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used!
            false)
          (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending-count!
            0)
          (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used-count!
            0)
          ok)))))

(define (compiler-backend-scavenge-occupancy-cache-point-ok?
  [masks : (Array i64)]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [assignment-index : compiler_regalloc.CompilerRegAssignmentIndex]
  [vars : i64]
  [point : i64]) : bool
  (let
    [idx : i64 (/ point 2)]
    [cached : i64
      (if (and (>= idx 0) (< idx (array-length masks)))
        (array-ref masks idx)
        0)]
    [scanned : i64
      (compiler-backend-scavenge-occupied-mask-for-instr
        starts
        ends
        assignment-index
        vars
        point)]
    (= cached scanned)))

(define (compiler-backend-emit-current-count-gate-ok?) : bool
  (and
    (not
      (compiler_backend.compiler-backend-emit-needs-current-count?
        0
        0
        (compiler_backend.CompilerBackendMode.Scalar)))
    (not
      (compiler_backend.compiler-backend-emit-needs-current-count?
        0
        0
        (compiler_backend.CompilerBackendMode.Avx512)))
    (compiler_backend.compiler-backend-emit-needs-current-count?
      1
      0
      (compiler_backend.CompilerBackendMode.Scalar))
    (compiler_backend.compiler-backend-emit-needs-current-count?
      0
      1
      (compiler_backend.CompilerBackendMode.Scalar))
    ;; AVX2 predicated-store labels are position-keyed even without register
    ;; homes or const-hoist sites.
    (compiler_backend.compiler-backend-emit-needs-current-count?
      0
      0
      (compiler_backend.CompilerBackendMode.Avx2))))

;; Reduced from integration_spmd_gather_read/fill-lane-offset-gather at opt2:
;; the entry compares two incoming parameters, the saving frontier is a
;; non-phi preheader, and the loop phi carries the guard's start parameter.
(define (compiler-backend-shrinkwrap-param-phi-fixture) : compiler_ir_types.CompilerIrFunction
  (compiler_ir_types.CompilerIrFunction.Function
    (compiler_ir_types.compiler-ir-test-symbol "early_exit_param_phi")
    (compiler_ir_types.compiler-ir-param-cons
      (compiler_ir_types.CompilerIrParam.Param
        "start"
        (compiler_ast_types.AstType.I64)
        0)
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "end"
          (compiler_ast_types.AstType.I64)
          1)
        compiler_ir_types.CompilerIrParamList.Nil))
    (compiler_ast_types.AstType.Unit)
    6
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.compiler-ir-block
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.BinOp
            2
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.compiler-ir-label "preheader")
              (compiler_ir_types.compiler-ir-label "exit"))
            compiler_ir_types.CompilerIrInstrList.Nil)))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "preheader")
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "loop"))
            compiler_ir_types.CompilerIrInstrList.Nil))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-block
            (compiler_ir_types.compiler-ir-label "loop")
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Phi
                3
                (compiler_ir_types.compiler-ir-phi-input-cons
                  (compiler_ir_types.CompilerIrValue.Var 0)
                  (compiler_ir_types.compiler-ir-label "preheader")
                  (compiler_ir_types.compiler-ir-phi-input-cons
                    (compiler_ir_types.CompilerIrValue.Var 4)
                    (compiler_ir_types.compiler-ir-label "loop")
                    compiler_ir_types.CompilerIrPhiInputList.Nil))
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.BinOp
                  4
                  (compiler_ir_types.CompilerIrBinOp.Add)
                  (compiler_ir_types.CompilerIrValue.Var 3)
                  (compiler_ir_types.CompilerIrValue.I64 1)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.BinOp
                    5
                    (compiler_ir_types.CompilerIrBinOp.Lt)
                    (compiler_ir_types.CompilerIrValue.Var 4)
                    (compiler_ir_types.CompilerIrValue.Var 1)
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.compiler-ir-instr-cons
                    (compiler_ir_types.CompilerIrInstr.Branch
                      (compiler_ir_types.CompilerIrValue.Var 5)
                      (compiler_ir_types.compiler-ir-label "loop")
                      (compiler_ir_types.compiler-ir-label "exit"))
                    compiler_ir_types.CompilerIrInstrList.Nil)))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.compiler-ir-block
              (compiler_ir_types.compiler-ir-label "exit")
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.No))
                compiler_ir_types.CompilerIrInstrList.Nil))
            compiler_ir_types.CompilerIrBlockList.Nil))))))

;; A region's free candidate registers go to the constants with the most static
;; sites, because each hoisted site drops one in-region constant load. The
;; measured forcing case is a leaf loop holding a single-site wide literal and a
;; multi-site divmod magic: program order handed the only free register to the
;; literal, so the magic reloaded its `movabsq` at every site on every
;; iteration. `values`/`wide` carry six entries -- literal L (one site, written
;; FIRST), magic M (three sites), magic N (two sites) -- so the award sequence
;; must be M, N, L even though L occurs first.
(define (compiler-backend-const-hoist-award-weight-ok?) : bool
  (let
    [values : (Array i64) (make-array i64 6)]
    [wide : (Array bool) (make-array bool 6)]
    [order : (Array i64) (make-array i64 6)]
    [tally : (Array i64) (make-array i64 6)]
    [_fill : unit
      (begin
        ;; index 0: wide literal L, one site
        (array-set! values 0 4242)
        (array-set! wide 0 true)
        ;; indices 1,3,5: magic M, three sites
        (array-set! values 1 777)
        (array-set! wide 1 false)
        (array-set! values 3 777)
        (array-set! wide 3 false)
        (array-set! values 5 777)
        (array-set! wide 5 false)
        ;; indices 2,4: magic N, two sites
        (array-set! values 2 999)
        (array-set! wide 2 false)
        (array-set! values 4 999)
        (array-set! wide 4 false))]
    [awards : i64
      (compiler_backend.compiler-backend-const-hoist-award-order!
        values
        wide
        6
        order
        tally)]
    (and
      ;; three distinct (value, wide?) keys, not six entries
      (= awards 3)
      ;; heaviest first: M (3 sites) then N (2) then L (1)
      (= (array-ref order 0) 1)
      (= (array-ref tally 0) 3)
      (= (array-ref order 1) 2)
      (= (array-ref tally 1) 2)
      (= (array-ref order 2) 0)
      (= (array-ref tally 2) 1))))

;; The dedup key is (value, wide?), so the same literal counts separately as a
;; wide-binop constant and as a divmod magic; and equal site counts award in
;; program order, which keeps the emitted plan a total order with no dependence
;; on any map's iteration order. Entries: value 5 as WIDE at 0 and 3, value 5 as
;; NON-wide at 1 and 4, value 6 as non-wide at 2 and 5 -- three keys, two sites
;; each, so the result must be exactly their first-occurrence order 0, 1, 2.
(define (compiler-backend-const-hoist-award-tie-ok?) : bool
  (let
    [values : (Array i64) (make-array i64 6)]
    [wide : (Array bool) (make-array bool 6)]
    [order : (Array i64) (make-array i64 6)]
    [tally : (Array i64) (make-array i64 6)]
    [_fill : unit
      (begin
        (array-set! values 0 5)
        (array-set! wide 0 true)
        (array-set! values 3 5)
        (array-set! wide 3 true)
        (array-set! values 1 5)
        (array-set! wide 1 false)
        (array-set! values 4 5)
        (array-set! wide 4 false)
        (array-set! values 2 6)
        (array-set! wide 2 false)
        (array-set! values 5 6)
        (array-set! wide 5 false))]
    [awards : i64
      (compiler_backend.compiler-backend-const-hoist-award-order!
        values
        wide
        6
        order
        tally)]
    (and
      (= awards 3)
      (= (array-ref order 0) 0)
      (= (array-ref order 1) 1)
      (= (array-ref order 2) 2)
      (= (array-ref tally 0) 2)
      (= (array-ref tally 1) 2)
      (= (array-ref tally 2) 2)
      ;; An empty region awards nothing and reads no scratch entry.
      (=
        (compiler_backend.compiler-backend-const-hoist-award-order!
          values
          wide
          0
          order
          tally)
        0)
      ;; A single site is one key of weight one.
      (=
        (compiler_backend.compiler-backend-const-hoist-award-order!
          values
          wide
          1
          order
          tally)
        1)
      (= (array-ref tally 0) 1))))

;; Const-hoist candidates must reflect ABI volatility. Win64 keeps %rsi/%rdi
;; out of the plan while retaining the caller-saved %r8/%r9 and the
;; ABI-neutral %rbx frame-home fallback.
(define (compiler-backend-const-hoist-candidates-abi-ok?) : bool
  (and
    (=
      (compiler_regalloc.compiler-reg-id-seq-count
        (compiler_backend.compiler-backend-const-hoist-candidate-regs
          (compiler_backend.CompilerBackendTarget.Linux)))
      5)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Linux))
      compiler_abi.compiler-reg-id-rsi)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Linux))
      compiler_abi.compiler-reg-id-rdi)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Linux))
      compiler_abi.compiler-reg-id-r8)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Linux))
      compiler_abi.compiler-reg-id-r9)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Linux))
      compiler_abi.compiler-reg-id-rbx)
    (=
      (compiler_regalloc.compiler-reg-id-seq-count
        (compiler_backend.compiler-backend-const-hoist-candidate-regs
          (compiler_backend.CompilerBackendTarget.Windows)))
      3)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Windows))
      compiler_abi.compiler-reg-id-r8)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Windows))
      compiler_abi.compiler-reg-id-r9)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Windows))
      compiler_abi.compiler-reg-id-rbx)
    (not
      (compiler_regalloc.compiler-reg-id-seq-contains?
        (compiler_backend.compiler-backend-const-hoist-candidate-regs
          (compiler_backend.CompilerBackendTarget.Windows))
        compiler_abi.compiler-reg-id-rsi))
    (not
      (compiler_regalloc.compiler-reg-id-seq-contains?
        (compiler_backend.compiler-backend-const-hoist-candidate-regs
          (compiler_backend.CompilerBackendTarget.Windows))
        compiler_abi.compiler-reg-id-rdi))))

;; The scratch-vreg result publishes caller-saved homes only through its
;; per-instruction plan. Const-hoist admission extends that plan into synthetic
;; assignments + intervals, so an overlapping %r9 scratch cannot also carry a
;; loop's magic constant. This is the reduced form of the Win64 self-host
;; corruption in string.int->string.
(define (compiler-backend-const-hoist-respects-scratch-plan-ok?) : bool
  (let
    [items : (Array compiler_regalloc.CompilerRegScratchAssignment)
      (make-array compiler_regalloc.CompilerRegScratchAssignment 1)]
    [first : (Array i64) (make-array i64 1)]
    [slots : (Array i64) (make-array i64 1)]
    [_item : unit
      (array-set!
        items
        0
        (compiler_regalloc.CompilerRegScratchAssignment
          (compiler_regalloc.CompilerRegScratchRequirement
            4
            0
            (compiler_regalloc.CompilerRegScratchRole.ScalarPrimary)
            (compiler_regalloc.CompilerRegScratchConstraint
              (compiler_regalloc.CompilerRegScratchClass.Gp)
              (compiler_regalloc.compiler-reg-id-seq-empty)
              (compiler_regalloc.compiler-reg-id-seq-empty)
              compiler_abi.compiler-reg-id-invalid)
            4
            8
            1)
          compiler_abi.compiler-reg-id-r9))]
    [scratch : compiler_regalloc.CompilerRegScratchPlan
      (compiler_regalloc.CompilerRegScratchPlan items first slots)]
    [base-assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r8))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    [base-intervals : compiler_regalloc.CompilerRegIntervalSeq
      (compiler_regalloc.compiler-reg-interval-seq-prepend
        (compiler_regalloc.CompilerRegInterval 0 0 10)
        (compiler_regalloc.compiler-reg-interval-seq-empty))]
    [vars : i64
      (compiler_backend.compiler-backend-scratch-plan-extend-vars scratch 1)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_backend.compiler-backend-scratch-plan-extend-assignments
        scratch
        1
        base-assignments)]
    [intervals : compiler_regalloc.CompilerRegIntervalSeq
      (compiler_backend.compiler-backend-scratch-plan-extend-intervals
        scratch
        1
        base-intervals)]
    (match (compiler_regalloc.compiler-reg-loop-split-first-register
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Windows))
      assignments
      (compiler_regalloc.compiler-reg-interval-index-build intervals vars)
      (compiler_regalloc.compiler-reg-loop-split-region-interval -1 4 8)
      -1)
      [(compiler_regalloc.CompilerRegMaybeId.Some reg)
        (= reg compiler_abi.compiler-reg-id-rbx)]
      [(compiler_regalloc.CompilerRegMaybeId.No) false])))

;; Regression for the opt1-built compiler crash exposed by
;; integration_spmd_gather_read/fill-lane-offset-gather. The reduced IR keeps
;; its entry guard -> non-phi preheader -> parameter-fed loop phi shape. A
;; previous scratch-arena function may leave a nonzero const-hoist count backed
;; by retired storage; shrink-wrap admission must reject that state until the
;; per-function preparation has established an empty table.
(define (compiler-backend-shrinkwrap-admission-state-ok?) : bool
  (let
    [stale-regs : (Array i64) (make-array i64 1)]
    (begin
      (compiler_backend.compiler-backend-test-set-compiler-backend-const-hoist-site-count!
        1)
      (compiler_backend.compiler-backend-test-set-compiler-backend-const-hoist-site-regs!
        stale-regs)
      (compiler_backend.compiler-backend-test-set-compiler-backend-const-hoist-inject-count!
        1)
      (compiler_backend.compiler-backend-test-set-compiler-backend-const-hoist-frame-rbx!
        true)
      (compiler_backend.compiler-backend-test-set-compiler-backend-const-hoist-frame-count!
        1)
      (let
        [dirty-rejected? : bool
          (not
            (compiler_backend.compiler-backend-shrinkwrap-admission-state-clean?))]
        [prepared? : bool
          (compiler_backend.compiler-backend-prepare-shrinkwrap-admission!)]
        [rewritten : compiler_ir_types.CompilerIrFunction
          (compiler_regalloc.compiler-reg-early-exit-shrinkwrap-function
            (compiler-backend-shrinkwrap-param-phi-fixture))]
        (and
          dirty-rejected?
          prepared?
          (compiler_backend.compiler-backend-shrinkwrap-admission-state-clean?)
          (not
            (compiler_backend.compiler-backend-callee-needs-save?
              compiler_regalloc.CompilerRegAssignmentList.Nil
              compiler_abi.compiler-reg-id-rbx))
          (= compiler_regalloc.compiler-reg-early-exit-prefix-count 2)
          (match rewritten
            [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ blocks)
              (let
                [seq : compiler_ir_types.CompilerIrBlockSeq
                  (compiler_liveness.compiler-live-ir-block-list-to-seq blocks)]
                (and
                  (= (compiler_ir_types.compiler-ir-block-seq-count seq) 6)
                  (match (compiler_ir_types.compiler-ir-block-seq-ref seq 0)
                    [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
                      (match (compiler_ir_types.compiler-ir-instr-seq-ref
                        instrs
                        1)
                        [(compiler_ir_types.CompilerIrInstr.Branch _ yes no)
                          (and
                            (=
                              yes
                              (compiler_ir_types.compiler-ir-label
                                "entry__shrinkwrap_save"))
                            (=
                              no
                              (compiler_ir_types.compiler-ir-label
                                "entry__shrinkwrap_bare0")))]
                        [_ false])])
                  (match (compiler_ir_types.compiler-ir-block-seq-ref seq 4)
                    [(compiler_ir_types.CompilerIrBlock.Block label instrs)
                      (and
                        (= label (compiler_ir_types.compiler-ir-label "loop"))
                        (match (compiler_ir_types.compiler-ir-instr-seq-ref
                          instrs
                          0)
                          [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
                            (match (compiler_ir_types.compiler-ir-phi-input-list-force-cons
                              inputs)
                              [(compiler_ir_types.CompilerIrPhiInputList.Cons
                                  value
                                  input-label
                                  _)
                                (and
                                  (=
                                    input-label
                                    (compiler_ir_types.compiler-ir-label
                                      "preheader"))
                                  (match value
                                    [(compiler_ir_types.CompilerIrValue.Var id)
                                      (= id 0)]
                                    [_ false]))]
                              [(compiler_ir_types.CompilerIrPhiInputList.Array
                                  seq)
                                (compiler_ir_types.compiler-ir-phi-input-seq-entry-var-label?
                                  seq
                                  0
                                  0
                                  "preheader")]
                              [_ false])]
                          [_ false]))])))]))))))

;; Win64 passes the third integer argument in %r8. A non-imm32 guard used to
;; scavenge %r8 before the prologue and then return that clobbered register on
;; the bare path. Scratch-requiring prefixes must fail closed to the ordinary
;; always-framed function until prefix emission has a dedicated live-in-aware
;; scratch plan.
(define compiler-backend-shrinkwrap-large-guard-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define (guard-large [x : i64] [unused : i64] [bare-result : i64]) : i64
  (if (= x 4294967296)
    bare-result
    (guard-large (opaque x) unused bare-result)))
(define (main) : i64 (guard-large (opaque 1) 7 42))")

(define (compiler-backend-shrinkwrap-large-guard-win64-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    compiler-backend-shrinkwrap-large-guard-source
    (compiler_backend.CompilerBackendTarget.Windows))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (let
        [body : String
          (compiler-backend-asm-function-body asm "_tl_guard_large")]
        (and
          (not (string.eq body ""))
          (compiler_backend.compiler-backend-string-contains? body "4294967296")
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "__shrinkwrap"))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-scavenge-occupancy-cache-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 5)]
    [ends : (Array i64) (make-array i64 5)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r9))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r10))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.RegisterPair
                compiler_abi.compiler-reg-id-r11
                (compiler_abi.compiler-abi-xmm-register-id 2)))
            (compiler_regalloc.compiler-reg-assignment-cons
              (compiler_regalloc.CompilerRegAssignment
                3
                (compiler_regalloc.CompilerRegLocation.Spill 0))
              (compiler_regalloc.compiler-reg-assignment-cons
                (compiler_regalloc.CompilerRegAssignment
                  4
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-r9))
                compiler_regalloc.CompilerRegAssignmentList.Nil)))))]
    [assignment-index : compiler_regalloc.CompilerRegAssignmentIndex
      (compiler_regalloc.compiler-reg-assignment-index-build assignments 5)]
    (begin
      (array-set! starts 0 0)
      (array-set! ends 0 2)
      (array-set! starts 1 3)
      (array-set! ends 1 5)
      (array-set! starts 2 4)
      (array-set! ends 2 7)
      (array-set! starts 3 0)
      (array-set! ends 3 8)
      (array-set! starts 4 2)
      (array-set! ends 4 6)
      (let
        [masks : (Array i64)
          (compiler_backend.compiler-backend-scavenge-occupancy-build
            starts
            ends
            assignment-index
            5)]
        (and
          (= (array-length masks) 5)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            0)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            2)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            4)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            6)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            8)
          (=
            (array-ref masks 0)
            (compiler_backend.compiler-backend-scavenge-reg-bit "%r9"))
          (not
            (=
              (bit-and
                (array-ref masks 2)
                (compiler_backend.compiler-backend-scavenge-reg-bit "%r9"))
              0))
          (=
            (array-ref masks 3)
            (bit-or
              (compiler_backend.compiler-backend-scavenge-reg-bit "%r9")
              (bit-or
                (compiler_backend.compiler-backend-scavenge-reg-bit "%r11")
                (compiler_backend.compiler-backend-scavenge-reg-bit "%xmm2")))))))))

(define (compiler-backend-scavenge-loop-live-through-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.compiler-ir-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.I64 8)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Mov
              5
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "header"))
              compiler_ir_types.CompilerIrInstrList.Nil)))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.compiler-ir-block
        (compiler_ir_types.compiler-ir-label "header")
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.BinOp
            2
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.compiler-ir-label "body")
              (compiler_ir_types.compiler-ir-label "exit"))
            compiler_ir_types.CompilerIrInstrList.Nil)))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "body")
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Gep
              3
              (compiler_ir_types.CompilerIrValue.Var 5)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Load
                4
                (compiler_ir_types.CompilerIrValue.Var 3)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "header"))
                compiler_ir_types.CompilerIrInstrList.Nil))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-block
            (compiler_ir_types.compiler-ir-label "exit")
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.BinOp
                6
                (compiler_ir_types.CompilerIrBinOp.Mul)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.CompilerIrValue.I64 8)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 6)))
                compiler_ir_types.CompilerIrInstrList.Nil)))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (compiler-backend-scavenge-loop-live-through-ok?) : bool
  (let
    [prev-starts : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-starts)]
    [prev-ends : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-ends)]
    [prev-assignment-index : compiler_regalloc.CompilerRegAssignmentIndex
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-assignment-index)]
    [prev-plan-mask : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-plan-reg-mask)]
    [prev-occupied-masks : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-occupied-masks)]
    [prev-vars : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-vars)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler-backend-scavenge-loop-live-through-blocks)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r8))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    (begin
      (compiler-backend-test-scavenge-install-ctx!
        "scavenge_loop_live_through"
        compiler_ir_types.CompilerIrParamList.Nil
        (compiler_ast_types.AstType.I64)
        7
        blocks
        assignments)
      (let
        [mask : i64
          (compiler_backend.compiler-backend-scavenge-occupied-mask-at-point 12)]
        [ok : bool
          (and
            (not
              (=
                (bit-and
                  mask
                  (compiler_backend.compiler-backend-scavenge-reg-bit "%r8"))
                0))
            (not
              (string.eq
                (compiler_backend.compiler-backend-scavenge-pick-with-mask
                  mask
                  (compiler_backend.compiler-backend-one-exclude "%rax")
                  1
                  "%r8")
                "%r8")))]
        (begin
          (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
            prev-starts
            prev-ends
            prev-assignment-index
            prev-plan-mask
            prev-occupied-masks
            prev-vars)
          ok)))))

;; #5982. The constant-remainder expansion ends `subq product, SRC`, so electing
;; the dividend's own home as SRC needs the REGISTER free afterwards, not just
;; the VALUE dead. Model the miscompiled shape at point 10 with three vars
;; sharing %r13: the dividend definition dying exactly at 10, the loop-carried
;; home shared with the header phi spanning the loop, and this instruction's own
;; result opening at 11. The phi must veto own-SRC; the instruction's own output
;; must not.
(define (compiler-backend-divmod-live-dividend-ctx! [carried? : bool]) : unit
  (let
    [vars : i64 3]
    [starts : (Array i64) (make-array i64 vars)]
    [ends : (Array i64) (make-array i64 vars)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r13))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              (if carried?
                compiler_abi.compiler-reg-id-r13
                compiler_abi.compiler-reg-id-r14)))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-r13))
            compiler_regalloc.CompilerRegAssignmentList.Nil)))]
    (begin
      ;; var 0: the dividend definition -- dead after point 10
      (array-set! starts 0 9)
      (array-set! ends 0 10)
      ;; var 1: the loop-carried home (phi-shared) -- spans the whole region
      (array-set! starts 1 2)
      (array-set! ends 1 30)
      ;; var 2: this instruction's own result -- opens on the def half-step
      (array-set! starts 2 11)
      (array-set! ends 2 20)
      (compiler_backend.compiler-backend-set-scavenge-ctx-index!
        starts
        ends
        (compiler_regalloc.compiler-reg-assignment-index-build assignments vars)
        0
        vars))))

(define (compiler-backend-divmod-live-dividend-src-ok?) : bool
  (let
    [prev-starts : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-starts)]
    [prev-ends : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-ends)]
    [prev-assignment-index : compiler_regalloc.CompilerRegAssignmentIndex
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-assignment-index)]
    [prev-plan-mask : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-plan-reg-mask)]
    [prev-occupied-masks : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-occupied-masks)]
    [prev-vars : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-vars)]
    [prev-post-base : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-instr-post-base)]
    [prev-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-current-count)]
    ;; place the emission point at 10: 2 * (post-base - count)
    [_point : unit
      (begin
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          5)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          0))]
    [_carried-ctx : unit (compiler-backend-divmod-live-dividend-ctx! true)]
    [carried : bool
      (compiler_backend.compiler-backend-divmod-home-carried-after? "%r13" 10)]
    ;; the value fact alone still reports the dividend dead here
    [value-dead : bool
      (not
        (compiler_backend.compiler-backend-value-live-after-here?
          (compiler_ir_types.CompilerIrValue.Var 0)))]
    ;; a remainder must refuse the home the phi still carries ...
    [remainder-refused : bool
      (not
        (compiler_backend.compiler-backend-divmod-src-home-safe? true "%r13" ""))]
    ;; ... a quotient never writes SRC, so it is unaffected ...
    [quotient-allowed : bool
      (compiler_backend.compiler-backend-divmod-src-home-safe? false "%r13" "")]
    ;; ... and a destination living in that same register is the result's own
    ;; home, so it stays eligible.
    [dst-home-allowed : bool
      (compiler_backend.compiler-backend-divmod-src-home-safe?
        true
        "%r13"
        "%r13")]
    ;; a register nothing is homed in is never carried
    [free-reg : bool
      (not
        (compiler_backend.compiler-backend-divmod-home-carried-after? "%r15" 10))]
    [_plain-ctx : unit (compiler-backend-divmod-live-dividend-ctx! false)]
    ;; without the phi only this instruction's own result remains, and a var
    ;; opening on the def half-step is what the expansion is producing
    [own-output-ok : bool
      (and
        (not
          (compiler_backend.compiler-backend-divmod-home-carried-after?
            "%r13"
            10))
        (compiler_backend.compiler-backend-divmod-src-home-safe? true "%r13" ""))]
    (begin
      (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
        prev-starts
        prev-ends
        prev-assignment-index
        prev-plan-mask
        prev-occupied-masks
        prev-vars)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
        prev-post-base)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
        prev-count)
      (and
        carried
        value-dead
        remainder-refused
        quotient-allowed
        dst-home-allowed
        free-reg
        own-output-ok))))

(define (compiler-backend-param-spill-stack-scratch-preserves-home-ok?) : bool
  (let
    [params : compiler_ir_types.CompilerIrParamList
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "a"
          (compiler_ast_types.AstType.U64)
          0)
        (compiler_ir_types.compiler-ir-param-cons
          (compiler_ir_types.CompilerIrParam.Param
            "b"
            (compiler_ast_types.AstType.U64)
            1)
          (compiler_ir_types.compiler-ir-param-cons
            (compiler_ir_types.CompilerIrParam.Param
              "c"
              (compiler_ast_types.AstType.U64)
              2)
            (compiler_ir_types.compiler-ir-param-cons
              (compiler_ir_types.CompilerIrParam.Param
                "d"
                (compiler_ast_types.AstType.U64)
                3)
              (compiler_ir_types.compiler-ir-param-cons
                (compiler_ir_types.CompilerIrParam.Param
                  "e"
                  (compiler_ast_types.AstType.Bool)
                  4)
                compiler_ir_types.CompilerIrParamList.Nil)))))]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          3
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r9))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    (match (compiler_backend.compiler-backend-emit-param-spills
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_backend.CompilerBackendTarget.Windows)
      assignments
      params
      0
      0
      0
      0
      (compiler_backend.compiler-backend-program-index-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil)
      5)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movzbq 48(%rbp), ")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movzbq 48(%rbp), %r9\n")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

