(define (compiler-backend-peephole-single-dest-classifier-ok?) : bool
  (and
    (compiler-backend-peephole-single-dest-mnemonic? "movabsq")
    (compiler-backend-peephole-single-dest-mnemonic? "setae")
    (compiler-backend-peephole-single-dest-mnemonic? "movl")
    (compiler-backend-peephole-single-dest-mnemonic? "movw")
    (compiler-backend-peephole-single-dest-mnemonic? "movb")
    (compiler-backend-peephole-single-dest-mnemonic? "addq")
    (compiler-backend-peephole-single-dest-mnemonic? "subl")
    (compiler-backend-peephole-single-dest-mnemonic? "andw")
    (compiler-backend-peephole-single-dest-mnemonic? "orb")
    (compiler-backend-peephole-single-dest-mnemonic? "xorq")
    (compiler-backend-peephole-single-dest-mnemonic? "leal")
    (compiler-backend-peephole-single-dest-mnemonic? "shlw")
    (compiler-backend-peephole-single-dest-mnemonic? "shrb")
    (compiler-backend-peephole-single-dest-mnemonic? "sarq")
    (compiler-backend-peephole-single-dest-mnemonic? "sall")
    (compiler-backend-peephole-single-dest-mnemonic? "negb")
    (compiler-backend-peephole-single-dest-mnemonic? "notw")
    (compiler-backend-peephole-single-dest-mnemonic? "incl")
    (compiler-backend-peephole-single-dest-mnemonic? "decq")
    (compiler-backend-peephole-single-dest-mnemonic? "movzbq")
    (compiler-backend-peephole-single-dest-mnemonic? "movzwq")
    (compiler-backend-peephole-single-dest-mnemonic? "movzbl")
    (compiler-backend-peephole-single-dest-mnemonic? "movzwl")
    (compiler-backend-peephole-single-dest-mnemonic? "movsbq")
    (compiler-backend-peephole-single-dest-mnemonic? "movswq")
    (compiler-backend-peephole-single-dest-mnemonic? "movslq")
    (not (compiler-backend-peephole-single-dest-mnemonic? "movq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "movsd"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "imulq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "mulq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "divq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "idivq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "callq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "xchgq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "testq"))
    (not (compiler-backend-peephole-single-dest-mnemonic? "cmpq"))))

;; #block-layout: the two post-emission layout rewrites, over assembly text.
;; Each case names the rule it pins; `mode` selects the mechanism so a case can
;; never pass by accident through the other one.
(define (compiler-backend-layout-case?
  [mode : i64]
  [input : String]
  [want : String]) : bool
  (string.eq (compiler-backend-layout-asm-with-mode input mode) want))

(define (compiler-backend-layout-unchanged? [mode : i64] [input : String]) : bool
  (compiler-backend-layout-case?
    mode
    (owned_view.compiler-owned-shared-view input)
    input))

;; TAIL DUPLICATION. The straight-line run at the target -- across the label
;; that splits it in two, up to the unconditional jump that ends it -- replaces
;; the `jmp`, and the block it came from stays put for its other predecessors.
(define (compiler-backend-layout-tail-duplication-ok?) : bool
  (and
    (compiler-backend-layout-case?
      be_peephole.compiler-backend-layout-mode-dup
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    xorl %r9d, %r9d
    jmp .Lf0_join
.Lf0_body:
    addq $1, %r9
.Lf0_join:
    cmpq %rdx, %r9
    jl .Lf0_body
.Lf0_tail:
    xorl %edi, %edi
    jmp .Lf0_exit
.Lf0_exit:
    ret
    .size f, . - f
"
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    xorl %r9d, %r9d
    cmpq %rdx, %r9
    jl .Lf0_body
    xorl %edi, %edi
    jmp .Lf0_exit
.Lf0_body:
    addq $1, %r9
.Lf0_join:
    cmpq %rdx, %r9
    jl .Lf0_body
.Lf0_tail:
    xorl %edi, %edi
    jmp .Lf0_exit
.Lf0_exit:
    ret
    .size f, . - f
")
    ;; REFUSED under -Os: the copy would carry more than its `jmp`.
    (compiler-backend-layout-unchanged?
      (bit-or
        be_peephole.compiler-backend-layout-mode-dup
        be_peephole.compiler-backend-layout-mode-size)
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    xorl %r9d, %r9d
    jmp .Lf0_join
.Lf0_body:
    addq $1, %r9
.Lf0_join:
    cmpq %rdx, %r9
    jl .Lf0_body
.Lf0_tail:
    xorl %edi, %edi
    jmp .Lf0_exit
.Lf0_exit:
    ret
    .size f, . - f
")
    ;; REFUSED above the run cap: one more instruction than the budget.
    (compiler-backend-layout-unchanged?
      be_peephole.compiler-backend-layout-mode-dup
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    xorl %r9d, %r9d
    jmp .Lf0_join
.Lf0_body:
    addq $1, %r9
.Lf0_join:
    cmpq %rdx, %r9
    jl .Lf0_body
.Lf0_tail:
    xorl %edi, %edi
    addq $2, %rdi
    jmp .Lf0_exit
.Lf0_exit:
    ret
    .size f, . - f
")
    ;; REFUSED for a run that carries a directive: an alignment or data blob
    ;; belongs to the block that defines it and may not be emitted twice.
    (compiler-backend-layout-unchanged?
      be_peephole.compiler-backend-layout-mode-dup
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    xorl %r9d, %r9d
    jmp .Lf0_join
.Lf0_body:
    addq $1, %r9
.Lf0_join:
    cmpq %rdx, %r9
    jl .Lf0_body
    .balign 8
.Lf0_tail:
    xorl %edi, %edi
    jmp .Lf0_exit
.Lf0_exit:
    ret
    .size f, . - f
")
    ;; REFUSED for a run that touches the stack: a second epilogue copy would
    ;; need its own unwind description.
    (compiler-backend-layout-unchanged?
      be_peephole.compiler-backend-layout-mode-dup
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    xorl %r9d, %r9d
    jmp .Lf0_join
.Lf0_body:
    addq $1, %r9
.Lf0_join:
    cmpq %rdx, %r9
    jl .Lf0_body
.Lf0_tail:
    popq %r12
    jmp .Lf0_exit
.Lf0_exit:
    ret
    .size f, . - f
")
    ;; REFUSED behind a noreturn abort call: that `jmp` is dead text.
    (compiler-backend-layout-unchanged?
      be_peephole.compiler-backend-layout-mode-dup
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    cmpq %rdx, %r9
    jb .Lf0_ok
    call .L_tl_abort_tl_oob_abort_at
    jmp .Lf0_join
.Lf0_ok:
    addq $1, %r9
.Lf0_join:
    cmpq %rdx, %r9
    jl .Lf0_entry
.Lf0_tail:
    xorl %edi, %edi
    jmp .Lf0_exit
.Lf0_exit:
    ret
    .size f, . - f
")
    ;; REFUSED when the target is where execution arrives anyway: the assembled
    ;; peephole deletes that `jmp` for free.
    (compiler-backend-layout-unchanged?
      be_peephole.compiler-backend-layout-mode-dup
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    xorl %r9d, %r9d
    jmp .Lf0_join
.Lf0_alias:
.Lf0_join:
    cmpq %rdx, %r9
    jl .Lf0_alias
.Lf0_tail:
    xorl %edi, %edi
    jmp .Lf0_exit
.Lf0_exit:
    ret
    .size f, . - f
")
    ;; PHI EDGE COPIES: the copies this edge owes its target are emitted before
    ;; the `jmp` today, and the duplicated run lands behind them unchanged.
    (compiler-backend-layout-case?
      be_peephole.compiler-backend-layout-mode-dup
      ".globl f
    .type f,@function
f:
.Lf0_entry_branch_true:
    movq %rax, %rbx
    movq %rcx, %r8
    jmp .Lf0_join
.Lf0_body:
    addq $1, %r9
.Lf0_join:
    cmpq %rdx, %r9
    jl .Lf0_body
.Lf0_tail:
    xorl %edi, %edi
    jmp .Lf0_exit
.Lf0_exit:
    ret
    .size f, . - f
"
      ".globl f
    .type f,@function
f:
.Lf0_entry_branch_true:
    movq %rax, %rbx
    movq %rcx, %r8
    cmpq %rdx, %r9
    jl .Lf0_body
    xorl %edi, %edi
    jmp .Lf0_exit
.Lf0_body:
    addq $1, %r9
.Lf0_join:
    cmpq %rdx, %r9
    jl .Lf0_body
.Lf0_tail:
    xorl %edi, %edi
    jmp .Lf0_exit
.Lf0_exit:
    ret
    .size f, . - f
")))

(test
  backend-layout-classifies-bare-ret
  (let
    [source : String "    ret\nret\n    retq\n    ret $8\n    retry\n je ret\n"]
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 7)]
    [flags : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    (unsafe
      (let
        [data : (Ptr u8) (string-data source)]
        [lines : i64
          (be_peephole.compiler-backend-layout-split-lines
            data
            (string.string-length (& source))
            6
            (__tl_array-data starts))]
        (be_peephole.compiler-backend-layout-classify-lines!
          data
          lines
          (__tl_array-data starts)
          (__tl_array-data flags))))
    (test.assert-true
      (and
        (= (array-ref flags 0) be_peephole.compiler-backend-layout-flag-ret)
        (= (array-ref flags 1) be_peephole.compiler-backend-layout-flag-ret)
        (= (array-ref flags 2) be_peephole.compiler-backend-layout-flag-ret)
        (= (array-ref flags 3) be_peephole.compiler-backend-layout-flag-ret)
        (= (array-ref flags 4) 0)
        (=
          (array-ref flags 5)
          (bit-or
            be_peephole.compiler-backend-layout-flag-jcc
            (shl 4 be_peephole.compiler-backend-layout-flag-ops-shift))))
      "identify returns by mnemonic and preserve a branch to a symbol named ret")))

;; PREDICTED-COLD ARM OUT-OF-LINING, one case per prediction rule.
(define (compiler-backend-layout-cold-arm-ok?) : bool
  (and
    ;; RANGE CHECK: `i < 0` predicted false, and the `i >= n` clause bailing to
    ;; the same arm inherits that prediction. The arm moves behind the body and
    ;; the hot arm falls into the join.
    (compiler-backend-layout-case?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl g
    .type g,@function
g:
.Lf1_entry:
    testq %rdi, %rdi
    jl .Lf1_if_else.7
.Lf1_if_then.0:
    cmpq %r9, %rdi
    jge .Lf1_if_else.7
.Lf1_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
    jmp .Lf1_cont
.Lf1_if_else.7:
    movq $-1, %rcx
    addq $3, %rcx
    subq $1, %rcx
.Lf1_cont:
    cmpq $40, %rcx
    ret
    .size g, . - g
"
      ".globl g
    .type g,@function
g:
.Lf1_entry:
    testq %rdi, %rdi
    jl .Lf1_if_else.7
.Lf1_if_then.0:
    cmpq %r9, %rdi
    jge .Lf1_if_else.7
.Lf1_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
.Lf1_cont:
    cmpq $40, %rcx
    ret
.Lf1_if_else.7:
    movq $-1, %rcx
    addq $3, %rcx
    subq $1, %rcx
    jmp .Lf1_cont
    .size g, . - g
")
    ;; SENTINEL ARM: one lone `i >= n` says nothing on its own, but an arm that
    ;; is nothing except a literal is the failure arm of a checked read.
    (compiler-backend-layout-case?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    cmpq %r9, %rdi
    jge .Lf0_if_else.7
.Lf0_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
    jmp .Lf0_cont
.Lf0_if_else.7:
    movq $-1, %rcx
.Lf0_cont:
    cmpq $40, %rcx
    ret
    .size f, . - f
"
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    cmpq %r9, %rdi
    jge .Lf0_if_else.7
.Lf0_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
.Lf0_cont:
    cmpq $40, %rcx
    ret
.Lf0_if_else.7:
    movq $-1, %rcx
    jmp .Lf0_cont
    .size f, . - f
")
    ;; EQUALITY WITH A CONSTANT predicted false, twice over: the guard shape the
    ;; opcode heuristics are trusted in.
    (compiler-backend-layout-case?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl h
    .type h,@function
h:
.Lf2_entry:
    cmpq $40, %rcx
    je .Lf2_else
.Lf2_a:
    cmpq $41, %rcx
    je .Lf2_else
.Lf2_then:
    movq %rdx, %rax
    imulq %rsi, %rax
    jmp .Lf2_cont
.Lf2_else:
    subq %rdx, %rax
    addq %rsi, %rax
.Lf2_cont:
    ret
    .size h, . - h
"
      ".globl h
    .type h,@function
h:
.Lf2_entry:
    cmpq $40, %rcx
    je .Lf2_else
.Lf2_a:
    cmpq $41, %rcx
    je .Lf2_else
.Lf2_then:
    movq %rdx, %rax
    imulq %rsi, %rax
.Lf2_cont:
    ret
.Lf2_else:
    subq %rdx, %rax
    addq %rsi, %rax
    jmp .Lf2_cont
    .size h, . - h
")
    ;; `x != c` is predicted TRUE, so the arm it names is the HOT one and stays.
    (compiler-backend-layout-unchanged?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl h
    .type h,@function
h:
.Lf2_entry:
    cmpq $40, %rcx
    jne .Lf2_else
.Lf2_a:
    cmpq $41, %rcx
    jne .Lf2_else
.Lf2_then:
    movq %rdx, %rax
    imulq %rsi, %rax
    jmp .Lf2_cont
.Lf2_else:
    subq %rdx, %rax
    addq %rsi, %rax
.Lf2_cont:
    ret
    .size h, . - h
")
    ;; ONE opcode-predicted clause is not the guard shape: a lone `x < 0` over a
    ;; real arm is a coin flip, and paying a jump on a coin flip is not a win.
    (compiler-backend-layout-unchanged?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl h
    .type h,@function
h:
.Lf2_entry:
    testq %rax, %rax
    jl .Lf2_else
.Lf2_then:
    movq %rdx, %rcx
    imulq %rsi, %rcx
    jmp .Lf2_cont
.Lf2_else:
    subq %rdx, %rcx
    addq %rsi, %rcx
.Lf2_cont:
    ret
    .size h, . - h
")
    ;; NO PREDICTION AT ALL: two register operands the opcode set says nothing
    ;; about. IR order is kept.
    (compiler-backend-layout-unchanged?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl h
    .type h,@function
h:
.Lf2_entry:
    cmpq %r9, %rdi
    jge .Lf2_if_else.7
.Lf2_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
    jmp .Lf2_cont
.Lf2_if_else.7:
    subq %rdx, %rcx
    imulq %rsi, %rcx
.Lf2_cont:
    cmpq $40, %rcx
    ret
    .size h, . - h
")
    ;; An unconditional jump into the arm is an entry no heuristic predicted:
    ;; the arm keeps its place.
    (compiler-backend-layout-unchanged?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl g
    .type g,@function
g:
.Lf1_entry:
    testq %rdi, %rdi
    jl .Lf1_if_else.7
.Lf1_if_then.0:
    cmpq %r9, %rdi
    jge .Lf1_if_else.7
.Lf1_if_then.5:
    testq %rsi, %rsi
    jne .Lf1_if_then.6
.Lf1_if_then.5b:
    jmp .Lf1_if_else.7
.Lf1_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
    jmp .Lf1_cont
.Lf1_if_else.7:
    movq $-1, %rcx
    addq $3, %rcx
.Lf1_cont:
    cmpq $40, %rcx
    ret
    .size g, . - g
")
    ;; An arm whose last line is a LABEL still needs the jump behind it: those
    ;; labels are entry points of their own and fell straight into the join.
    ;; Two lines long, the arm takes the island behind the first `ret`.
    (compiler-backend-layout-case?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl g
    .type g,@function
g:
.Lf1_entry:
    testq %rax, %rax
    jl .Lf1_else
.Lf1_a:
    cmpq %rsi, %rax
    jge .Lf1_else
.Lf1_then:
    movq %rdx, %rcx
    jmp .Lf1_join
.Lf1_else:
    xorl %ecx, %ecx
    jmp .Lf1_other
.Lf1_alias:
.Lf1_join:
    movq %rcx, %rax
    ret
.Lf1_other:
    movq $7, %rax
    ret
    .size g, . - g
"
      ".globl g
    .type g,@function
g:
.Lf1_entry:
    testq %rax, %rax
    jl .Lf1_else
.Lf1_a:
    cmpq %rsi, %rax
    jge .Lf1_else
.Lf1_then:
    movq %rdx, %rcx
.Lf1_join:
    movq %rcx, %rax
    ret
.Lf1_else:
    xorl %ecx, %ecx
    jmp .Lf1_other
.Lf1_alias:
    jmp .Lf1_join
.Lf1_other:
    movq $7, %rax
    ret
    .size g, . - g
")))

;; RMW-2: the adjacent `movq M,%rX / op src,%rX / movq %rX,M` triple folds to
;; one memory-operand ALU instruction when %rX is dead after the store. Every
;; allowed op is covered in both operand forms and both memory shapes, and the
;; four ways a path can END while proving death -- a full overwrite, a `ret`
;; that cannot carry the register, a call that cannot read it, and a two-way
;; branch whose arms both overwrite it -- each have a row.
(define (compiler-backend-peephole-rmw-fold-ok?) : bool
  (let
    ;; rip-relative global, immediate source, death by full overwrite.
    [global-imm-input : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rcx
    movq %rcx, _tl_g(%rip)
    movq $0, %rcx
"]
    [global-imm-want : String "    addq $1, _tl_g(%rip)
    movq $0, %rcx
"]
    ;; %rsp frame slot, register source, death by full overwrite.
    [slot-reg-input : String
      "    movq 24(%rsp), %r8
    subq %r9, %r8
    movq %r8, 24(%rsp)
    movq $0, %r8
"]
    [slot-reg-want : String "    subq %r9, 24(%rsp)
    movq $0, %r8
"]
    ;; %rbp frame slot, immediate source, death at a `ret` the register cannot
    ;; return through (%rbx is neither of the two integer return registers).
    [rbp-slot-input : String
      "    movq -16(%rbp), %rbx
    andq $7, %rbx
    movq %rbx, -16(%rbp)
    ret
"]
    [rbp-slot-want : String "    andq $7, -16(%rbp)
    ret
"]
    ;; The remaining three ops, back to back. Each triple's death is proven by
    ;; the NEXT triple's load, which the next fold then deletes -- the cascade
    ;; the pass's FOLD ORDER note describes, and the reason the rows are written
    ;; as one chain rather than four independent blocks.
    [chain-input : String
      "    movq _tl_a(%rip), %rsi
    orq $8, %rsi
    movq %rsi, _tl_a(%rip)
    movq _tl_b(%rip), %rsi
    xorq %rdi, %rsi
    movq %rsi, _tl_b(%rip)
    movq _tl_c(%rip), %rsi
    negq %rsi
    movq %rsi, _tl_c(%rip)
    movq _tl_d(%rip), %rsi
    notq %rsi
    movq %rsi, _tl_d(%rip)
    ret
"]
    [chain-want : String
      "    orq $8, _tl_a(%rip)
    xorq %rdi, _tl_b(%rip)
    negq _tl_c(%rip)
    notq _tl_d(%rip)
    ret
"]
    ;; The three non-`movq` kills. `leaq` and `movabsq` write the full 64-bit
    ;; destination, `movl` writes 32 and x86-64 zero-extends the rest, and
    ;; `xorl %eX, %eX` names the register twice without reading either copy.
    ;; The first row is the shape the fixture's `bit-or` counter actually
    ;; produces: its register dies into a `leaq`, not a `movq`.
    [kill-shapes-input : String
      "    movq _tl_a(%rip), %r9
    orq %rax, %r9
    movq %r9, _tl_a(%rip)
    leaq 1024(%rax), %r9
    movq _tl_b(%rip), %r10
    addq %rax, %r10
    movq %r10, _tl_b(%rip)
    movl $7, %r10d
    movq _tl_c(%rip), %rcx
    andq %rax, %rcx
    movq %rcx, _tl_c(%rip)
    xorl %ecx, %ecx
    movq _tl_d(%rip), %rsi
    xorq %rax, %rsi
    movq %rsi, _tl_d(%rip)
    movabsq $4294967296, %rsi
    ret
"]
    [kill-shapes-want : String
      "    orq %rax, _tl_a(%rip)
    leaq 1024(%rax), %r9
    addq %rax, _tl_b(%rip)
    movl $7, %r10d
    andq %rax, _tl_c(%rip)
    xorl %ecx, %ecx
    xorq %rax, _tl_d(%rip)
    movabsq $4294967296, %rsi
    ret
"]
    ;; A call cannot read a register that is callee-saved under BOTH supported
    ;; ABIs, so the scan walks through it.
    [call-input : String
      "    movq _tl_g(%rip), %r12
    addq $1, %r12
    movq %r12, _tl_g(%rip)
    call _tl_side
    ret
"]
    [call-want : String "    addq $1, _tl_g(%rip)
    call _tl_side
    ret
"]
    (and
      (string.eq
        (compiler-backend-peephole-asm global-imm-input)
        global-imm-want)
      (string.eq (compiler-backend-peephole-asm slot-reg-input) slot-reg-want)
      (string.eq (compiler-backend-peephole-asm rbp-slot-input) rbp-slot-want)
      (string.eq (compiler-backend-peephole-asm chain-input) chain-want)
      (string.eq
        (compiler-backend-peephole-asm kill-shapes-input)
        kill-shapes-want)
      (string.eq (compiler-backend-peephole-asm call-input) call-want))))

;; RMW-2 refusals. Each input is returned UNCHANGED, and each pins one clause of
;; the admission list or one arm of the death scan's default-refuse.
(define (compiler-backend-peephole-rmw-refuse-ok?) : bool
  (let
    ;; Load and store name different addresses.
    [other-address : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rcx
    movq %rcx, _tl_h(%rip)
    ret
"]
    ;; A label definition between the op and the store: the three lines are no
    ;; longer the adjacent triple, and the store has a second predecessor.
    [label-between : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rcx
.Lf1_mid:
    movq %rcx, _tl_g(%rip)
    ret
"]
    ;; A branch between the op and the store.
    [branch-between : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rcx
    jne .Lf1_out
    movq %rcx, _tl_g(%rip)
    ret
.Lf1_out:
    ret
"]
    ;; An op outside the fold set. `imulq $3, m` has no memory-destination
    ;; encoding at all, which is why the set stops where LLVM's does.
    [other-op : String
      "    movq _tl_g(%rip), %rcx
    imulq $3, %rcx
    movq %rcx, _tl_g(%rip)
    ret
"]
    ;; Source register == destination register: `addq %rcx, %rcx` doubles the
    ;; LOADED value, which `addq %rcx, M` would not reproduce.
    [same-reg : String
      "    movq _tl_g(%rip), %rcx
    addq %rcx, %rcx
    movq %rcx, _tl_g(%rip)
    ret
"]
    ;; An indexed memory operand is not one of the two stable-address shapes.
    [indexed : String
      "    movq (%rax,%rcx,8), %rsi
    addq $1, %rsi
    movq %rsi, (%rax,%rcx,8)
    ret
"]
    [other-address-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view other-address))]
    [label-between-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view label-between))]
    [branch-between-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view branch-between))]
    [other-op-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view other-op))]
    [same-reg-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view same-reg))]
    [indexed-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view indexed))]
    (and
      (string.eq other-address-got other-address)
      (string.eq label-between-got label-between)
      (string.eq branch-between-got branch-between)
      (string.eq other-op-got other-op)
      (string.eq same-reg-got same-reg)
      (string.eq indexed-got indexed))))

;; RMW-3. A triple whose register is still read after the store -- or whose
;; death the bounded scan cannot prove -- folds all the same, and the store's
;; line becomes the load's: `op src, M ; movq M, %rX` is two instructions for
;; the three, reads back exactly the word the folded op wrote, and leaves %rX
;; and EFLAGS as the triple did. Each row here was a refusal of RMW-2's death
;; scan: a later read of the register, %rax at `ret`, a caller-saved register
;; reaching a call, a mnemonic whose reads the scan cannot see, and a branch
;; whose target is not in the group.
(define (compiler-backend-peephole-rmw-live-fold-ok?) : bool
  (let
    [reused-input : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rcx
    movq %rcx, _tl_g(%rip)
    movq %rcx, %rdx
    ret
"]
    [reused-want : String
      "    addq $1, _tl_g(%rip)
    movq _tl_g(%rip), %rcx
    movq %rcx, %rdx
    ret
"]
    [return-reg-input : String
      "    movq _tl_g(%rip), %rax
    addq $1, %rax
    movq %rax, _tl_g(%rip)
    ret
"]
    [return-reg-want : String
      "    addq $1, _tl_g(%rip)
    movq _tl_g(%rip), %rax
    ret
"]
    [call-live-input : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rcx
    movq %rcx, _tl_g(%rip)
    call _tl_side
    ret
"]
    [call-live-want : String
      "    addq $1, _tl_g(%rip)
    movq _tl_g(%rip), %rcx
    call _tl_side
    ret
"]
    [opaque-mnemonic-input : String
      "    movq _tl_g(%rip), %rsi
    addq $1, %rsi
    movq %rsi, _tl_g(%rip)
    cqto
    ret
"]
    [opaque-mnemonic-want : String
      "    addq $1, _tl_g(%rip)
    movq _tl_g(%rip), %rsi
    cqto
    ret
"]
    [unknown-target-input : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rcx
    movq %rcx, _tl_g(%rip)
    jmp .Lf1_elsewhere
"]
    [unknown-target-want : String
      "    addq $1, _tl_g(%rip)
    movq _tl_g(%rip), %rcx
    jmp .Lf1_elsewhere
"]
    ;; A register source and a frame slot, the same way.
    [slot-reg-input : String
      "    movq 24(%rsp), %r8
    subq %r9, %r8
    movq %r8, 24(%rsp)
    movq %r8, %rax
    ret
"]
    [slot-reg-want : String
      "    subq %r9, 24(%rsp)
    movq 24(%rsp), %r8
    movq %r8, %rax
    ret
"]
    (and
      (string.eq (compiler-backend-peephole-asm reused-input) reused-want)
      (string.eq
        (compiler-backend-peephole-asm return-reg-input)
        return-reg-want)
      (string.eq (compiler-backend-peephole-asm call-live-input) call-live-want)
      (string.eq
        (compiler-backend-peephole-asm opaque-mnemonic-input)
        opaque-mnemonic-want)
      (string.eq
        (compiler-backend-peephole-asm unknown-target-input)
        unknown-target-want)
      (string.eq (compiler-backend-peephole-asm slot-reg-input) slot-reg-want))))

;; RMW-2 FLAGS CONSUMER. A `jcc` immediately after the store reads the flags the
;; ALU op wrote -- the intervening `movq` writes none -- and the folded
;; instruction writes exactly those flags from exactly those operand values. The
;; fold is therefore admitted, not refused, and the branch keeps its meaning. (A
;; `jcc` reading the LOAD's flags cannot exist: `movq` sets none.) Death is
;; proven through BOTH arms of that branch.
(define (compiler-backend-peephole-rmw-flags-consumer-ok?) : bool
  (let
    [flags-input : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rcx
    movq %rcx, _tl_g(%rip)
    je .Lf1_zero
    movq $0, %rcx
    ret
.Lf1_zero:
    movq $1, %rcx
    ret
"]
    [flags-want : String
      "    addq $1, _tl_g(%rip)
    je .Lf1_zero
    movq $0, %rcx
    ret
.Lf1_zero:
    movq $1, %rcx
    ret
"]
    ;; The same shape, but the taken arm READS the register: one live path is
    ;; enough to keep it, and RMW-3 then folds the triple with its reload. The
    ;; reload sits between the op and the `jcc` and writes no flags, so the
    ;; branch still reads the op's.
    [flags-live-input : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rcx
    movq %rcx, _tl_g(%rip)
    je .Lf1_zero
    movq $0, %rcx
    ret
.Lf1_zero:
    movq %rcx, %rdx
    ret
"]
    [flags-live-want : String
      "    addq $1, _tl_g(%rip)
    movq _tl_g(%rip), %rcx
    je .Lf1_zero
    movq $0, %rcx
    ret
.Lf1_zero:
    movq %rcx, %rdx
    ret
"]
    [flags-live-got : String (compiler-backend-peephole-asm flags-live-input)]
    (and
      (string.eq (compiler-backend-peephole-asm flags-input) flags-want)
      (string.eq flags-live-got flags-live-want))))

;; RMW-2 RELOAD REUSE -- the read that decides where this pass may run. The
;; walk's owner map rewrites a later reload of the same slot into a copy out of
;; the register that mirrors it. That copy is a genuine read of the triple's
;; register and exists ONLY in the emitted text, so a fold placed inside the
;; walk would delete the register the walk is about to read. Because the fold
;; runs on the final record stream, the death scan sees the minted read: the
;; register is live, so RMW-3 folds the triple WITH its reload (the copy then
;; reads the reloaded register), and the rewritten copy is kept.
(define (compiler-backend-peephole-rmw-owner-reload-live-fold-ok?) : bool
  (let
    [reload-input : String
      "    movq 24(%rsp), %r8
    addq $1, %r8
    movq %r8, 24(%rsp)
    movq 24(%rsp), %r9
    ret
"]
    ;; RMW-3: the owner map's rewrite is a read of %r8 after the store, so the
    ;; register is live and the triple folds with the reload.
    [reload-want : String
      "    addq $1, 24(%rsp)
    movq 24(%rsp), %r8
    movq %r8, %r9
    ret
"]
    (string.eq (compiler-backend-peephole-asm reload-input) reload-want)))

;; RMW-2 COST. Recognition rides the walk, so the question a unit test can ask
;; of it is whether a stream it must NOT touch comes back byte-identical. Each
;; row is one way the rolling window fails to close: the ALU names a different
;; register than the load and the store, a line sits between the op and the
;; store, and a run of ALU lines has no load or store around it at all.
(define (compiler-backend-peephole-rmw-no-candidate-ok?) : bool
  (let
    [other-reg-input : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rdx
    movq %rdx, _tl_g(%rip)
    ret
"]
    [split-window-input : String
      "    movq _tl_g(%rip), %rcx
    addq $1, %rcx
    movq $0, %rsi
    movq %rcx, _tl_g(%rip)
    ret
"]
    [alu-only-input : String "    addq $1, %rcx
    subq $2, %rcx
    ret
"]
    [other-reg-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view other-reg-input))]
    [split-window-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view split-window-input))]
    [alu-only-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view alu-only-input))]
    (and
      (string.eq other-reg-got other-reg-input)
      (string.eq split-window-got split-window-input)
      (string.eq alu-only-got alu-only-input))))

;; ISLAND PLACEMENT: a sunk arm of at most two emitted lines goes in front of
;; the first label after its join that control cannot fall into, so its
;; branches stay short; anything else keeps the function end.
(define (compiler-backend-layout-island-ok?) : bool
  (and
    ;; The sentinel arm lands behind the `jmp .Lf0_exit` that ends the next
    ;; block, in front of `.Lf0_other`.
    (compiler-backend-layout-case?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    cmpq %r9, %rdi
    jge .Lf0_if_else.7
.Lf0_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
    jmp .Lf0_cont
.Lf0_if_else.7:
    movq $-1, %rcx
.Lf0_cont:
    cmpq $40, %rcx
    jne .Lf0_other
    addq $1, %rcx
    jmp .Lf0_exit
.Lf0_other:
    subq $1, %rcx
.Lf0_exit:
    ret
    .size f, . - f
"
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    cmpq %r9, %rdi
    jge .Lf0_if_else.7
.Lf0_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
.Lf0_cont:
    cmpq $40, %rcx
    jne .Lf0_other
    addq $1, %rcx
    jmp .Lf0_exit
.Lf0_if_else.7:
    movq $-1, %rcx
    jmp .Lf0_cont
.Lf0_other:
    subq $1, %rcx
.Lf0_exit:
    ret
    .size f, . - f
")
    ;; A `jmp` into the label run right behind it is a fallthrough the
    ;; peephole deletes, not an island: the arm keeps the function end.
    (compiler-backend-layout-case?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    cmpq %r9, %rdi
    jge .Lf0_if_else.7
.Lf0_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
    jmp .Lf0_cont
.Lf0_if_else.7:
    movq $-1, %rcx
.Lf0_cont:
    addq $1, %rcx
    jmp .Lf0_next
.Lf0_alias:
.Lf0_next:
    ret
    .size f, . - f
"
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    cmpq %r9, %rdi
    jge .Lf0_if_else.7
.Lf0_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
.Lf0_cont:
    addq $1, %rcx
    jmp .Lf0_next
.Lf0_alias:
.Lf0_next:
    ret
.Lf0_if_else.7:
    movq $-1, %rcx
    jmp .Lf0_cont
    .size f, . - f
")
    ;; A three-line arm keeps the function end even with an island in reach,
    ;; so a longer cold region never lengthens the hot branches across it.
    (compiler-backend-layout-case?
      be_peephole.compiler-backend-layout-mode-sink
      ".globl g
    .type g,@function
g:
.Lf1_entry:
    testq %rdi, %rdi
    jl .Lf1_if_else.7
.Lf1_if_then.0:
    cmpq %r9, %rdi
    jge .Lf1_if_else.7
.Lf1_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
    jmp .Lf1_cont
.Lf1_if_else.7:
    movq $-1, %rcx
    addq $3, %rcx
    subq $1, %rcx
.Lf1_cont:
    cmpq $40, %rcx
    jne .Lf1_other
    jmp .Lf1_exit
.Lf1_other:
    subq $1, %rcx
.Lf1_exit:
    ret
    .size g, . - g
"
      ".globl g
    .type g,@function
g:
.Lf1_entry:
    testq %rdi, %rdi
    jl .Lf1_if_else.7
.Lf1_if_then.0:
    cmpq %r9, %rdi
    jge .Lf1_if_else.7
.Lf1_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
.Lf1_cont:
    cmpq $40, %rcx
    jne .Lf1_other
    jmp .Lf1_exit
.Lf1_other:
    subq $1, %rcx
.Lf1_exit:
    ret
.Lf1_if_else.7:
    movq $-1, %rcx
    addq $3, %rcx
    subq $1, %rcx
    jmp .Lf1_cont
    .size g, . - g
")
    ;; With both mechanisms, `jmp .Lf0_park` is a duplication site whose copied
    ;; run ends in `jmp .Lf0_exit`, the label right behind it. That is no island,
    ;; so the arm takes the next one, after `ret`.
    (compiler-backend-layout-case?
      be_peephole.compiler-backend-layout-mode
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    cmpq %r9, %rdi
    jge .Lf0_if_else.7
.Lf0_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
    jmp .Lf0_cont
.Lf0_if_else.7:
    movq $-1, %rcx
.Lf0_cont:
    cmpq $40, %rcx
    jmp .Lf0_park
.Lf0_exit:
    ret
.Lf0_park:
    movq %rax, %rdi
    jmp .Lf0_exit
    .size f, . - f
"
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    cmpq %r9, %rdi
    jge .Lf0_if_else.7
.Lf0_if_then.6:
    movzbq (%rax,%rdi,1), %rcx
.Lf0_cont:
    cmpq $40, %rcx
    movq %rax, %rdi
    jmp .Lf0_exit
.Lf0_exit:
    ret
.Lf0_if_else.7:
    movq $-1, %rcx
    jmp .Lf0_cont
.Lf0_park:
    movq %rax, %rdi
    jmp .Lf0_exit
    .size f, . - f
")))

(define (compiler-backend-layout-debug-end-case? [closing : String]) : bool
  (compiler-backend-layout-case?
    be_peephole.compiler-backend-layout-mode-sink
    (str_cat.str-cat
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    testq %rdi, %rdi
    jl .Lf0_else
.Lf0_check:
    cmpq %r9, %rdi
    jge .Lf0_else
.Lf0_then:
    movzbq (%rax,%rdi,1), %rcx
    jmp .Lf0_cont
.Lf0_else:
    movq $-1, %rcx
    addq $3, %rcx
    subq $1, %rcx
.Lf0_cont:
    cmpq $40, %rcx
    ret
"
      closing
      "    .size f, . - f\n")
    (str_cat.str-cat
      ".globl f
    .type f,@function
f:
.Lf0_entry:
    testq %rdi, %rdi
    jl .Lf0_else
.Lf0_check:
    cmpq %r9, %rdi
    jge .Lf0_else
.Lf0_then:
    movzbq (%rax,%rdi,1), %rcx
.Lf0_cont:
    cmpq $40, %rcx
    ret
.Lf0_else:
    movq $-1, %rcx
    addq $3, %rcx
    subq $1, %rcx
    jmp .Lf0_cont
"
      closing
      "    .size f, . - f\n")))

(define (compiler-backend-layout-debug-ends-ok?) : bool
  (and
    (compiler-backend-layout-debug-end-case? "    .cfi_endproc\n")
    (compiler-backend-layout-debug-end-case?
      ".L_tl_backtrace_function_end_0:\n")
    (compiler-backend-layout-debug-end-case?
      ".L_tl_backtrace_function_end_0:\n    .cfi_endproc\n")
    (compiler-backend-layout-debug-end-case?
      ".Lcv_func_end_0:\n.L_tl_backtrace_function_end_0:\n    .seh_endproc\n")))

(test
  backend-layout-keeps-debug-ends-after-cold-blocks
  (unless
    (compiler-backend-layout-debug-ends-ok?)
    (io.panic "cold layout moved instructions beyond a debug function end")))

(define (compiler-backend-layout-ok?) : bool
  (and
    (compiler-backend-layout-tail-duplication-ok?)
    (compiler-backend-layout-cold-arm-ok?)
    (compiler-backend-layout-debug-ends-ok?)
    (compiler-backend-layout-island-ok?)))

(define (compiler-backend-peephole-ok?) : bool
  (and
    true
    (compiler-backend-control-mnemonic-classifier-ok?)
    (compiler-backend-peephole-operand-classifiers-ok?)
    (compiler-backend-peephole-single-dest-classifier-ok?)
    (compiler-backend-peephole-register-moves-ok?)
    (compiler-backend-direct-immediate-mov-ok?)
    true
    (compiler-backend-mov-scratch-staging-ok?)
    (compiler-backend-mov-register-to-slot-ok?)
    (compiler-backend-peephole-asm-ok?)
    (compiler-backend-binop-operand-folding-ok?)
    (compiler-backend-bounds-operand-folding-ok?)
    (compiler-backend-bounds-direct-pressure-ok?)
    true
    (compiler-backend-binop-direct-pressure-ok?)
    (compiler-backend-win64-bounds-index-scratch-ok?)
    (compiler-backend-win64-compare-rhs-rax-ok?)
    (compiler-backend-post-regalloc-peephole-ok?)
    (compiler-backend-peephole-vector-gp-owners-ok?)
    (compiler-backend-peephole-pending-parse-slot-ok?)
    true
    (compiler-backend-peephole-dead-mirror-store-ok?)
    (compiler-backend-peephole-dead-reg-def-ok?)
    (compiler-backend-peephole-rmw-fold-ok?)
    (compiler-backend-peephole-rmw-refuse-ok?)
    (compiler-backend-peephole-rmw-live-fold-ok?)
    (compiler-backend-peephole-rmw-flags-consumer-ok?)
    (compiler-backend-peephole-rmw-owner-reload-live-fold-ok?)
    (compiler-backend-peephole-rmw-no-candidate-ok?)
    (compiler-backend-peephole-detailed-abort-guard-ok?)
    (compiler-backend-peephole-drop-fallthrough-chain-ok?)
    (compiler-backend-peephole-drop-fallthrough-abort-guard-ok?)
    (compiler-backend-layout-ok?)
    true
    (compiler-backend-deadstore-sweep-win64-ok?)
    (compiler-backend-r10-dead-scan-long-gap-ok?)
    (compiler-backend-chunked-peephole-equivalent?)
    (compiler-backend-cold-split-ok?)
    (compiler-backend-cold-share-ok?)
    (compiler-backend-cold-edge-ok?)
    (compiler-backend-cold-edge-align-ok?)
    (compiler-backend-cold-edge-shape2-ok?)
    (compiler-backend-peephole-redundant-zext-imm-ok?)
    (compiler-backend-load-register-bool-self-elide-ok?)
    (compiler-backend-peephole-flags-branch-ok?)
    (compiler-backend-streamed-final-output-equivalent?)
    (compiler-backend-streamed-final-batch-equivalent?)
    true
    (compiler-backend-rax-forwarding-ok?)
    (compiler-backend-call-arg-rax-forwarding-ok?)
    (compiler-backend-long-normal-block-ok?)
    (compiler-backend-fallthrough-jump-ok?)
    (compiler-backend-branch-fallthrough-ok?)
    true
    (compiler-backend-zero-load-ok?)
    (compiler-backend-zero-compare-ok?)
    (compiler-backend-scalar-select-ok?)
    (compiler-backend-select-on-flags-ok?)
    (compiler-backend-select-false-home-result-ok?)
    (compiler-backend-gep-direct-index-ok?)
    (compiler-backend-gep-rbp-base-scale-one-ok?)
    (compiler-backend-call-return-ok?)
    (compiler-backend-global-immediate-store-ok?)
    (compiler-backend-scratch-staging-direct-shapes-ok?)))

(define (compiler-backend-fallthrough-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (ci.intern "main")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          0
          (ir.compiler-ir-blocks
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "entry")
              (compiler-backend-test-instr-seq-prepend
                (Jump (ir.compiler-ir-label "done"))
                (ir.compiler-ir-instr-seq-empty)))
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "done")
              (compiler-backend-test-instr-seq-prepend
                (Return (Some (I64 7)))
                (ir.compiler-ir-instr-seq-empty))))
          Ordinary))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-fallthrough-jump-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-program-linux
      (compiler-backend-fallthrough-program))
    (has ".Lf0_done:\n")
    (lacks "    jmp .Lf0_done\n")))

(define (compiler-backend-branch-fallthrough-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-peephole-assignments)]
    (match (be_scalar.compiler-backend-emit-branch
      assignments
      "branch"
      (Var 0)
      (ir.compiler-ir-label "then")
      (ir.compiler-ir-label "else")
      (Some (ir.compiler-ir-label "else"))
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(Ok false-fallthrough)
        (match (be_scalar.compiler-backend-emit-branch
          assignments
          "branch"
          (Var 0)
          (ir.compiler-ir-label "then")
          (ir.compiler-ir-label "else")
          (Some (ir.compiler-ir-label "then"))
          (be_state.compiler-backend-state-new
            (ci.intern-compat-state-capture-active)))
          [(Ok true-fallthrough)
            (and
              (asm-has? false-fallthrough "    jne .Lbranch_then\n")
              (asm-lacks? false-fallthrough "    jmp .Lbranch_else\n")
              (asm-has? true-fallthrough "    je .Lbranch_else\n")
              (asm-lacks? true-fallthrough "    jmp .Lbranch_then\n"))]
          [(Err _) false])]
      [(Err _) false])))

(define (compiler-backend-zero-load-ok?) : bool
  (match (be_operand.compiler-backend-emit-load-value
    (regalloc.compiler-reg-assignment-table-empty)
    (& (I64 0))
    "%rax"
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm) (string.eq asm "    xorl %eax, %eax\n")]
    [(Err _) false]))

(define (compiler-backend-zero-compare-ok?) : bool
  (and
    (asm-ok?
      (be_scalar.compiler-backend-emit-binop
        (ast.ast-node-pool-reader-type-segment-bases)
        (regalloc.compiler-reg-var-types-empty)
        (Empty)
        (compiler-backend-peephole-assignments)
        2
        (Eq)
        (Var 0)
        (I64 0)
        (I64)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
      (has "    testq %r13, %r13\n    sete %r13b\n")
      (lacks "    cmpq $0"))
    (asm-ok?
      (be_scalar.compiler-backend-emit-binop
        (ast.ast-node-pool-reader-type-segment-bases)
        (regalloc.compiler-reg-var-types-empty)
        (Empty)
        (compiler-backend-peephole-assignments)
        2
        (Gt)
        (Var 0)
        (I64 0)
        (I64)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
      (has "    testq %r13, %r13\n    setg %r13b\n")
      (lacks "    cmpq $0"))
    (asm-ok?
      (be_scalar.compiler-backend-emit-binop
        (ast.ast-node-pool-reader-type-segment-bases)
        (regalloc.compiler-reg-var-types-empty)
        (Empty)
        (compiler-backend-peephole-assignments)
        2
        (BitTestNe)
        (Var 0)
        (I64 1)
        (I64)
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
      (has "    testb $1, %r13b\n    setne %r13b\n")
      (lacks "    andq $1" "    andl $1"))))

(define (compiler-backend-scalar-select-ok?) : bool
  (and
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (compiler-backend-test-instr-seq-prepend
          (ir.ir-instr-select 2 (Var 0) (I64 7) (I64 9) 0 (I64))
          (ir.compiler-ir-instr-seq-empty))
        (compiler-backend-peephole-assignments)
        3)
      (has "    testq %r12, %r12\n" "    cmovne ")
      (lacks "    cmove "))
    ;; x86 has no byte cmov: Bool still uses a target-independent qword cmovne.
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (compiler-backend-test-instr-seq-prepend
          (ir.ir-instr-select 2 (Var 0) (Bool true) (Bool false) 0 (Bool))
          (ir.compiler-ir-instr-seq-empty))
        (compiler-backend-peephole-assignments)
        3)
      (has "    cmovne %r8, %r13\n")
      (lacks "cmovne %r8b"))))

;; SS-P5 fixtures. Var 1 is a SPILLED gep base (which is what routes the gep to
;; the staged path at all), var 2 the index, var 3 the gep result.
(define (compiler-backend-gep-direct-index-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%1=spill:40 %2=%r13 %3=%r12"))

;; BE-1: the same gep with the index homed in %rbp.
(define (compiler-backend-gep-rbp-index-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%1=spill:40 %2=%rbp %3=%r12"))

(define (compiler-backend-gep-spilled-index-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%1=spill:40 %2=spill:48 %3=%r12"))

(define (compiler-backend-gep-staged-asm
  [assignments : regalloc.CompilerRegAssignmentTable]
  [elem-ty : ast.AstType]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-backend-test-instr-seq-prepend
      (Gep 3 (Var 1) (Var 2) elem-ty)
      (ir.compiler-ir-instr-seq-empty))
    assignments
    4))

;; BE-2. A %rbp-homed BASE at scale 1 is spelled with the SIB slots swapped,
;; `(index,%rbp,1)`, and read straight from its home; at any other scale it
;; cannot be spelled and the emitters stage it as before. The pins are the
;; formatter, the scale-aware filter, and a fused byte load end to end: base in
;; %rbp, index in %r13, gep result in %rax, load destination %rsi.
(define (compiler-backend-gep-rbp-base-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%1=%rbp %2=%r13 %3=%rax %4=%rsi"))

(define (compiler-backend-gep-rbp-base-load-asm [elem-ty : ast.AstType]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-backend-test-instr-seq-prepend
      (Gep
        3
        (Var 1)
        (Var 2)
        (be_state.compiler-backend-global-shared-view elem-ty))
      (compiler-backend-test-instr-seq-prepend
        (Load 4 (Var 3) elem-ty)
        (ir.compiler-ir-instr-seq-empty)))
    (compiler-backend-gep-rbp-base-assignments)
    5))

(define (compiler-backend-gep-rbp-base-scale-one-ok?) : bool
  (and
    ;; the formatter: swapped at scale 1, spelled outright at every other
    ;; scale (BE-4), and a %rbp INDEX (BE-1) unchanged
    (string.eq
      (be_scalar.compiler-backend-gep-index-address "%rbp" 1 "%r13")
      "(%r13,%rbp,1)")
    (string.eq
      (be_scalar.compiler-backend-gep-index-address "%rbp" 8 "%r13")
      "(%rbp,%r13,8)")
    (string.eq
      (be_scalar.compiler-backend-gep-index-address "%rbp" 1 "%rbp")
      "")
    (string.eq
      (be_scalar.compiler-backend-gep-index-address "%r12" 1 "%rbp")
      "(%r12,%rbp,1)")
    (string.eq
      (be_scalar.compiler-backend-gep-index-address-disp 16 "%rbp" 1 "%r13")
      "16(%r13,%rbp,1)")
    ;; the filter: %rbp admitted at every SIB scale (BE-4), declined at none
    (string.eq
      (be_scalar.compiler-backend-address-base-filter-sib "%rbp" 1)
      "%rbp")
    (string.eq
      (be_scalar.compiler-backend-address-base-filter-sib "%rbp" 8)
      "%rbp")
    (string.eq (be_scalar.compiler-backend-address-base-filter-sib "%rbp" 3) "")
    (string.eq
      (be_scalar.compiler-backend-address-base-filter-sib "%r12" 8)
      "%r12")
    ;; end to end: a byte load off a %rbp base reads its home in place
    (asm-ok?
      (compiler-backend-gep-rbp-base-load-asm (U8))
      (has "(%r13,%rbp,1)")
      (lacks "    movq %rbp, "))
    ;; ...and a word load reads it in place too (BE-4): `(%rbp,idx,8)` is a
    ;; pool base with an index, which the rsp-rebase audit steps over in an
    ;; rbp-planned function, so nothing stages the base first
    (asm-ok?
      (compiler-backend-gep-rbp-base-load-asm (I64))
      (has "(%rbp,%r13,8)")
      (lacks "    movq %rbp, "))))

;; SS-P5(a). A register-homed index is READ by the composing instruction --
;; `addq idx, base` at scale 1, `leaq (base,idx,s), base` at 2/4/8 -- so the
;; staged path needs no copy of it into a scratch. A spilled index has no home
;; to read and keeps the staging load. The displacement folds into the SIB
;; form's own field, so a displaced gep is still ONE instruction.
(define (compiler-backend-gep-direct-index-ok?) : bool
  (and
    ;; scale 1 -> addq, with no `movq %r13, <scratch>` staging copy left.
    (asm-ok?
      (compiler-backend-gep-staged-asm
        (compiler-backend-gep-direct-index-assignments)
        (U8))
      (has "    addq %r13, %r12\n")
      (lacks "    movq %r13, "))
    ;; scale 8 -> one leaq straight off the index home.
    (asm-ok?
      (compiler-backend-gep-staged-asm
        (compiler-backend-gep-direct-index-assignments)
        (I64))
      (has "    leaq (%r12,%r13,8), %r12\n")
      (lacks "    movq %r13, "))
    ;; scale 4 -> the same SIB form at the narrower stride.
    (asm-ok?
      (compiler-backend-gep-staged-asm
        (compiler-backend-gep-direct-index-assignments)
        (I32))
      (has "    leaq (%r12,%r13,4), %r12\n"))
    ;; scale 2 -> likewise.
    (asm-ok?
      (compiler-backend-gep-staged-asm
        (compiler-backend-gep-direct-index-assignments)
        (I16))
      (has "    leaq (%r12,%r13,2), %r12\n"))
    ;; BE-1: an index homed in %rbp is read from the SIB index slot and the
    ;; add operand like any other register -- `(base,%rbp,s)` is not the frame
    ;; spelling `off(%rbp)` the rebase pass and the peephole recognise -- so it
    ;; stages no copy either.
    (asm-ok?
      (compiler-backend-gep-staged-asm
        (compiler-backend-gep-rbp-index-assignments)
        (I64))
      (has "    leaq (%r12,%rbp,8), %r12\n")
      (lacks "    movq %rbp, "))
    (asm-ok?
      (compiler-backend-gep-staged-asm
        (compiler-backend-gep-rbp-index-assignments)
        (U8))
      (has "    addq %rbp, %r12\n")
      (lacks "    movq %rbp, "))
    ;; A spilled index still stages: the slot is reloaded, and the composing
    ;; instruction reads the staging register rather than a home.
    (asm-ok?
      (compiler-backend-gep-staged-asm
        (compiler-backend-gep-spilled-index-assignments)
        (U8))
      (has "48(%rbp), " ", %r12\n"))
    ;; The displacement is the SIB form's own field at every spellable scale,
    ;; and only there: a non-SIB stride keeps the separate `addq $D`.
    (string.eq
      (be_scalar.compiler-backend-gep-index-base-asm-disp 16 "%r12" 8 "%r13")
      "    leaq 16(%r12,%r13,8), %r12\n")
    (string.eq
      (be_scalar.compiler-backend-gep-index-base-asm-disp 24 "%r12" 1 "%r13")
      "    leaq 24(%r12,%r13,1), %r12\n")
    (string.eq
      (be_scalar.compiler-backend-gep-index-base-asm-disp 0 "%r12" 1 "%r13")
      "    addq %r13, %r12\n")
    (let
      [text
        (be_scalar.compiler-backend-gep-index-base-asm-disp 16 "%r12" 24 "%r13")]
      (asm-has? text "    addq $16, %r12\n"))))

;; SS-P5(b)/(c) fixtures. var 0 and var 1 are the comparison's operands (and,
;; in the `min` shape, the select's two arms); var 3 is the mask; var 4 is the
;; select result.
(define (compiler-backend-select-flags-assignments [result-reg : i64]) : regalloc.CompilerRegAssignmentTable
  (regalloc.compiler-reg-assignments-prepend
    (& (regalloc.CompilerRegAssignment 0 (Register cabi.compiler-reg-id-r13)))
    (regalloc.compiler-reg-assignments-prepend
      (& (regalloc.CompilerRegAssignment 1 (Register cabi.compiler-reg-id-rcx)))
      (regalloc.compiler-reg-assignments-prepend
        (&
          (regalloc.CompilerRegAssignment 3 (Register cabi.compiler-reg-id-rax)))
        (regalloc.compiler-reg-assignments-prepend
          (& (regalloc.CompilerRegAssignment 4 (Register result-reg)))
          (regalloc.compiler-reg-assignment-table-empty))))))

;; `%3 = lt %0, %1 ; %4 = select %3, %0, %1` -- the `min` shape, with `tail`
;; appended so a second use of the mask can be added.
(define (compiler-backend-select-flags-instrs
  [ty : ast.AstType]
  [tail : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (compiler-backend-test-instr-seq-prepend
    (BinOp
      3
      (Lt)
      (Var 0)
      (Var 1)
      (be_state.compiler-backend-global-shared-view ty))
    (compiler-backend-test-instr-seq-prepend
      (ir.ir-instr-select 4 (Var 3) (Var 0) (Var 1) 0 ty)
      tail)))

(define (compiler-backend-select-flags-asm
  [ty : ast.AstType]
  [result-reg : i64]
  [tail : ir.CompilerIrInstrSeq]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-backend-select-flags-instrs ty tail)
    (compiler-backend-select-flags-assignments result-reg)
    6))

;; SS-P5(b). A select whose mask is the comparison right in front of it and
;; whose mask has no other reader spends `cmp` plus one `cmov<cc>`; the
;; condition code is the branch table's, so the signed/unsigned split is the
;; one the equivalent `jcc` would have used. A second reader of the mask puts
;; the materialising form back.
(define (compiler-backend-select-on-flags-ok?) : bool
  (and
    ;; unsigned lt -> cmovb, and no boolean is materialised at all.
    (asm-ok?
      (compiler-backend-select-flags-asm
        (U64)
        cabi.compiler-reg-id-r15
        (ir.compiler-ir-instr-seq-empty))
      (has "    movq %rcx, %r15\n    cmpq %rcx, %r13\n    cmovb %r13, %r15\n")
      (lacks "setb" "movzbq" "movzbl" "    testq "))
    ;; signed lt -> cmovl off the same operands.
    (asm-ok?
      (compiler-backend-select-flags-asm
        (I64)
        cabi.compiler-reg-id-r15
        (ir.compiler-ir-instr-seq-empty))
      (has "    cmpq %rcx, %r13\n    cmovl %r13, %r15\n")
      (lacks "    cmovb "))
    ;; A second use of the mask forces it to materialise, and the select falls
    ;; back to the test-and-cmovne form.
    (asm-ok?
      (compiler-backend-select-flags-asm
        (U64)
        cabi.compiler-reg-id-r15
        (irt.instrs "%5 = mov %3 : bool"))
      (has "    setb " "    testq " "    cmovne ")
      (lacks "    cmovb "))))

;; SS-P5(c). When the allocator homed the select result where the false operand
;; already lives, the `cmov`'s destination is loaded by construction and the
;; base copy is dropped -- on the flags path and on the materialising one
;; alike. The `%r15` fixture above is the control: there the copy is required
;; and emitted.
(define (compiler-backend-select-false-home-result-ok?) : bool
  (and
    (asm-ok?
      (compiler-backend-select-flags-asm
        (U64)
        cabi.compiler-reg-id-rcx
        (ir.compiler-ir-instr-seq-empty))
      (has "    cmpq %rcx, %r13\n    cmovb %r13, %rcx\n")
      (lacks "    movq %rcx, %rcx\n"))
    ;; The same rule on the materialising path: an isolated select whose result
    ;; home is the false operand's home copies nothing.
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (compiler-backend-test-instr-seq-prepend
          (ir.ir-instr-select 4 (Var 3) (Var 0) (Var 1) 0 (U64))
          (ir.compiler-ir-instr-seq-empty))
        (compiler-backend-select-flags-assignments cabi.compiler-reg-id-rcx)
        6)
      (has "    cmovne %r13, %rcx\n")
      (lacks "    movq %rcx, %rcx\n"))))

(define (compiler-backend-global-immediate-store-ok?) : bool
  (compiler-backend-instr-contains?
    (Store (ci.intern "g") (I64 7) (I64))
    "    movq $7, _tl_g(%rip)\n"))

(define (compiler-backend-word-scratch-staging-ok?) : bool
  (and
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%1 = word %2, 0 : i64")
        (regalloc.compiler-reg-assignment-table-empty)
        4)
      (has "    movq -24(%rbp), %r8\n" "    movq %r8, -16(%rbp)\n")
      (lacks "%rax"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%1 = word %2, 0 : f64")
        (regalloc.compiler-reg-assignment-table-empty)
        4)
      (has "    movsd -24(%rbp), %xmm2\n" "    movsd %xmm2, -16(%rbp)\n")
      (lacks "%xmm0"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%1 = word %2, 0 : f64")
        (reg-homes "%1=%xmm3")
        4)
      (has "    movsd -24(%rbp), %xmm3\n")
      (lacks "%xmm0"))))

(define (compiler-backend-scratch-staging-direct-shapes-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%r13 %2=%r12/%r13")]
    [_r8-tie-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%r8 %2=%r8")]
    [diag : cdiag.CompilerDiagnostic (cdiag.compiler-diagnostic-at-start "" "")]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (and
      (match (be_scalar.compiler-backend-emit-word
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        1
        (Var 2)
        0
        (I64)
        8
        diag
        backend-state)
        [(Ok asm) (string.eq asm "    movq %r12, %r13\n")]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-unop
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        1
        (Neg)
        (Var 0)
        (I64)
        backend-state)
        [(Ok asm) (string.eq asm "    movq %r12, %r13\n    negq %r13\n")]
        [(Err _) false])
      (compiler-backend-word-scratch-staging-ok?))))

;; BITLEN: `bit_length` is `bsr` + 1 in place, 0 for a value with no
;; significant bit (<= 0 signed, 0 unsigned), with no scratch register.
(define (compiler-backend-bit-length-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (and
      (string.eq
        (be_scalar.compiler-backend-bit-length-reg-asm true "%rax")
        "    testq %rax, %rax\n    jle 1f\n    bsrq %rax, %rax\n    addq $1, %rax\n    jmp 2f\n1:\n    xorq %rax, %rax\n2:\n")
      (string.eq
        (be_scalar.compiler-backend-bit-length-reg-asm false "%r9")
        "    testq %r9, %r9\n    je 1f\n    bsrq %r9, %r9\n    addq $1, %r9\n    jmp 2f\n1:\n    xorq %r9, %r9\n2:\n")
      (asm-ok?
        (be_scalar.compiler-backend-emit-unop
          (ast.ast-node-pool-reader-type-segment-bases)
          (regalloc.compiler-reg-assignment-table-empty)
          1
          (BitLength)
          (Var 0)
          (I64)
          backend-state)
        (has "    jle 1f\n    bsrq " "\n2:\n"))
      (asm-ok?
        (be_scalar.compiler-backend-emit-unop
          (ast.ast-node-pool-reader-type-segment-bases)
          (regalloc.compiler-reg-assignment-table-empty)
          1
          (BitLength)
          (Var 0)
          (U64)
          backend-state)
        (has "    je 1f\n    bsrq ")))))

(define (compiler-backend-tail-stack-forward-program) : ir.CompilerIrProgram
  (irt.program
    "function @leaf(a=%0:i64, b=%1:i64, c=%2:i64, d=%3:i64, e=%4:i64, f=%5:i64, g=%6:i64) -> i64 vars 7 {
     entry:
       return %6
     }
     function @tail(a=%0:i64, b=%1:i64, c=%2:i64, d=%3:i64, e=%4:i64, f=%5:i64) -> i64 vars 6 {
     entry:
       tailcall leaf(%0, %1, %2, %3, %4, %5, %0) : i64
     }
     function @jumper(a=%0:i64, b=%1:i64, c=%2:i64, d=%3:i64, e=%4:i64, f=%5:i64, g=%6:i64) -> i64 vars 7 {
     entry:
       tailcall leaf(%1, %0, %3, %2, %5, %4, %0) : i64
     }
     function @plain(a=%0:i64, b=%1:i64, c=%2:i64, d=%3:i64, e=%4:i64, f=%5:i64) -> i64 vars 7 {
     entry:
       %6 = call leaf(%0, %1, %2, %3, %4, %5, %0) : i64
       return %6
     }"))

(test
  backend-tail-stack-forward-registers
  (for [abi (iterator.range 0 2)]
    (let
      [state
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active))]
      [program (compiler-backend-tail-stack-forward-program)]
      [spans (ir.compiler-source-spans-empty)]
      [target : be_state.CompilerBackendTarget
        (if (= abi 0)
          (Linux)
          (Windows))]
      (be_state.compiler-backend-state-set-scalar-registers-enabled! state true)
      (test.assert-true
        (match (compiler-backend-test-emit-program-with-state
          state
          target
          (& program)
          (& spans)
          false)
          [(Ok asm)
            (let
              [tail (compiler-backend-asm-function-body asm "_tl_tail")]
              [plain (compiler-backend-asm-function-body asm "_tl_plain")]
              [jumper (compiler-backend-asm-function-body asm "_tl_jumper")]
              (and
                (not (string.eq tail ""))
                (not (string.eq plain ""))
                (asm-has? tail "    call _tl_leaf\n")
                (asm-has? jumper "    jmp _tl_leaf\n")
                (asm-lacks? jumper "    call ")
                (<=
                  (backend.compiler-backend-string-count tail "    movq ")
                  (backend.compiler-backend-string-count plain "    movq "))))]
          [(Err _) false])
        "a stack tail fallback needs no more argument moves than an ordinary call"))))

(define (compiler-backend-call-return-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (ci.intern "callee")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          0
          (ir.compiler-ir-blocks
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "entry")
              (compiler-backend-test-instr-seq-prepend
                (Return (Some (I64 7)))
                (ir.compiler-ir-instr-seq-empty))))
          Ordinary))
      (&
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              (ci.intern "main")
              (ir.compiler-ir-param-seq-empty)
              (I64)
              1
              (ir.compiler-ir-blocks
                (ir.CompilerIrBlock.Block
                  (ir.compiler-ir-label "entry")
                  (compiler-backend-test-instr-seq-prepend
                    (Call 0 (ci.intern "callee") (Nil) (I64))
                    (compiler-backend-test-instr-seq-prepend
                      (Return (Some (Var 0)))
                      (ir.compiler-ir-instr-seq-empty)))))
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-call-return-ok?) : bool
  (match (backend.compiler-backend-emit-program-linux
    (compiler-backend-call-return-program))
    [(Ok asm)
      (and
        (or
          (asm-has? asm "    call _tl_callee")
          (asm-has? asm "    call _tl_f"))
        (not
          (or
            (asm-has? asm "    call _tl_callee\n    movq %rax,")
            (asm-has? asm "    call _tl_f\n    movq %rax,"))))]
    [(Err _) false]))

(define (compiler-backend-phi-same-home-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r12"))

(define (compiler-backend-phi-same-home-blocks) : ir.CompilerIrBlockList
  (irt.blocks "join:
       %1 = phi [%0, entry] : i64"))

(define (compiler-backend-phi-cycle-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "join:
       %0 = phi [%1, back] : i64
       %1 = phi [%0, back] : i64"))

;; #6306. A same-home float Phi is filtered from the parallel-copy list, but
;; its %xmm2 family already contains the final incoming value. The following
;; spilled copy prefers %xmm2 as its scalar staging register; the edge's
;; phi-edge mask refuses it, so the copy stages through a free %xmm3 and the
;; placed family is never written. Under pressure -- every XMM staging candidate
;; holds a placed Phi -- the pick falls back to %xmm2 and the copy must preserve
;; the whole aliased physical family around that load/store pair.
(define (compiler-backend-phi-xmm-stage-same-home-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%xmm2 %1=%xmm2 %2=spill:-24 %3=spill:-16"))

;; The pressure variant: %xmm3..%xmm5, the rest of the XMM staging pool, also
;; hold same-home placed Phis.
(define (compiler-backend-phi-xmm-stage-pressure-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes
    "%0=%xmm2 %1=%xmm2 %2=spill:-24 %3=spill:-16 %4=%xmm3 %5=%xmm3 %6=%xmm4 %7=%xmm4 %8=%xmm5 %9=%xmm5"))

(define (compiler-backend-phi-xmm-stage-pressure-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump join
     join:
       %1 = phi [%0, entry] : f64
       %5 = phi [%4, entry] : f64
       %7 = phi [%6, entry] : f64
       %9 = phi [%8, entry] : f64
       %3 = phi [%2, entry] : f64"))

(define (compiler-backend-phi-xmm-stage-same-home-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks
      "join:
         %1 = phi [%0, entry] : f64
         %3 = phi [%2, entry] : f64")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (compiler-backend-test-instr-seq-prepend
        (Mov 0 (F64 (compiler-backend-test-f64-bits "1.0")) (F64))
        (compiler-backend-test-instr-seq-prepend
          (Mov 2 (F64 (compiler-backend-test-f64-bits "2.0")) (F64))
          (irt.instrs "jump join"))))))

;; An emitted destination variant: the literal Phi places its value in %xmm2
;; before the spilled copy stages. This catches protection based only on the
;; remaining (drained) copy list.
(define (compiler-backend-phi-xmm-stage-placed-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%xmm2 %1=spill:-16 %2=spill:-24"))

(define (compiler-backend-phi-xmm-stage-placed-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (compiler-backend-test-instr-seq-prepend
        (Mov 2 (F64 (compiler-backend-test-f64-bits "2.0")) (F64))
        (irt.instrs "jump join")))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "join")
      (compiler-backend-test-instr-seq-prepend
        (Phi
          0
          (ir.compiler-ir-phi-input-seq-prepend
            (F64 (compiler-backend-test-f64-bits "1.0"))
            (ir.compiler-ir-label "entry")
            (& (ir.compiler-ir-phi-input-seq-empty)))
          (F64))
        (irt.instrs "%1 = phi [%2, entry] : f64")))))

(define (compiler-backend-phi-xmm-stage-safe-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=spill:-24 %1=spill:-16"))

(define (compiler-backend-phi-xmm-stage-safe-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (irt.blocks "join:
         %1 = phi [%0, entry] : f64")
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (compiler-backend-test-instr-seq-prepend
        (Mov 0 (F64 (compiler-backend-test-f64-bits "2.0")) (F64))
        (irt.instrs "jump join")))))

(define (compiler-backend-phi-xmm-stage-fused-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%xmm2 %1=%xmm2 %2=spill:-24 %3=spill:-16 %4=spill:-32"))

(define (compiler-backend-phi-xmm-stage-fused-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       jump join
     join:
       %1 = phi [%0, entry] : f64
       %3 = phi [%2, entry] : f64"))

(define (compiler-backend-phi-xmm-stage-edge-asm
  [assignments : regalloc.CompilerRegAssignmentTable]
  [blocks : ir.CompilerIrBlockList]
  [vars : i64]
  [mode : be_state.CompilerBackendMode]) : be_state.ResultCompilerBackend
  (let
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    (be_state.compiler-backend-set-current-mode!
      (be_state.compiler-backend-state-function-state backend-state)
      mode)
    (set-scratch-emergency-slot-offset!
      (be_state.compiler-backend-state-function-state backend-state)
      -128)
    (set-scratch-cycle-temp-base-offset!
      (be_state.compiler-backend-state-function-state backend-state)
      -512)
    (be_calls.compiler-backend-emit-phi-edge-copies
      (ast.ast-node-pool-reader-type-segment-bases)
      assignments
      blocks
      (ir.compiler-ir-label "join")
      (ir.compiler-ir-label "entry")
      program-index
      vars)))

(define (compiler-backend-phi-xmm-stage-bracket-shape?
  [asm : String]
  [save : String]
  [restore : String]) : bool
  (and
    (asm-has?
      asm
      save
      "    movsd -24(%rbp), %xmm2\n"
      "    movsd %xmm2, -16(%rbp)\n"
      restore)
    (= (backend.compiler-backend-string-count asm "-128(%rbp)") 2)
    (asm-lacks? asm "-512(%rbp)")))

(define (compiler-backend-phi-xmm-stage-free-shape? [asm : String]) : bool
  (and
    (asm-has? asm "    movsd -24(%rbp), %xmm3\n    movsd %xmm3, -16(%rbp)\n")
    (asm-lacks? asm "%xmm2" "%ymm2" "%zmm2" "-128(%rbp)" "-512(%rbp)")))

(define (compiler-backend-phi-xmm-stage-mode-asm
  [pressure? : bool]
  [mode : be_state.CompilerBackendMode]) : be_state.ResultCompilerBackend
  (if pressure?
    (compiler-backend-phi-xmm-stage-edge-asm
      (compiler-backend-phi-xmm-stage-pressure-assignments)
      (compiler-backend-phi-xmm-stage-pressure-blocks)
      10
      mode)
    (compiler-backend-phi-xmm-stage-edge-asm
      (compiler-backend-phi-xmm-stage-same-home-assignments)
      (compiler-backend-phi-xmm-stage-same-home-blocks)
      4
      mode)))

(define (compiler-backend-phi-xmm-stage-preserved-modes-ok? [pressure? : bool]) : bool
  (match (compiler-backend-phi-xmm-stage-mode-asm pressure? (Scalar))
    [(Ok scalar)
      (match (compiler-backend-phi-xmm-stage-mode-asm pressure? (Avx2))
        [(Ok avx2)
          (match (compiler-backend-phi-xmm-stage-mode-asm pressure? (Avx512))
            [(Ok avx512)
              (if pressure?
                (and
                  (compiler-backend-phi-xmm-stage-bracket-shape?
                    scalar
                    "    movdqu %xmm2, -128(%rbp)\n"
                    "    movdqu -128(%rbp), %xmm2\n")
                  (compiler-backend-phi-xmm-stage-bracket-shape?
                    avx2
                    "    vmovdqu %ymm2, -128(%rbp)\n"
                    "    vmovdqu -128(%rbp), %ymm2\n")
                  (compiler-backend-phi-xmm-stage-bracket-shape?
                    avx512
                    "    vmovdqu64 %zmm2, -128(%rbp)\n"
                    "    vmovdqu64 -128(%rbp), %zmm2\n"))
                (and
                  (compiler-backend-phi-xmm-stage-free-shape? scalar)
                  (compiler-backend-phi-xmm-stage-free-shape? avx2)
                  (compiler-backend-phi-xmm-stage-free-shape? avx512)))]
            [(Err _) false])]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-phi-xmm-stage-preserved-ok?) : bool
  (and
    (compiler-backend-phi-xmm-stage-preserved-modes-ok? false)
    (compiler-backend-phi-xmm-stage-preserved-modes-ok? true)
    (match (compiler-backend-phi-xmm-stage-edge-asm
      (compiler-backend-phi-xmm-stage-placed-assignments)
      (compiler-backend-phi-xmm-stage-placed-blocks)
      3
      (Scalar))
      [(Ok placed)
        ;; The literal's own load is the only write of %xmm2.
        (and
          (asm-has? placed "    movsd .L_tl_f64_")
          (= (backend.compiler-backend-string-count placed "%xmm2") 1)
          (asm-has?
            placed
            "    movsd -24(%rbp), %xmm3\n    movsd %xmm3, -16(%rbp)\n")
          (asm-lacks? placed "-128(%rbp)" "-512(%rbp)"))]
      [(Err _) false])
    (match (compiler-backend-phi-xmm-stage-edge-asm
      (compiler-backend-phi-xmm-stage-safe-assignments)
      (compiler-backend-phi-xmm-stage-safe-blocks)
      2
      (Scalar))
      [(Ok safe)
        (and
          (asm-has?
            safe
            "    movsd -24(%rbp), %xmm2\n    movsd %xmm2, -16(%rbp)\n")
          (asm-lacks? safe "movdqu"))]
      [(Err _) false])))

;; Mov+Jump fusion substitutes var4 for the pre-fusion var2 source, then runs
;; the dense target scan. The raw same-home Phi must still protect %xmm2: the
;; copy stages through %xmm3 and never writes it.
(define (compiler-backend-phi-xmm-fused-stage-preserved-ok?) : bool
  (let
    [blocks : ir.CompilerIrBlockList
      (compiler-backend-phi-xmm-stage-fused-blocks)]
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    (set-scratch-emergency-slot-offset!
      (be_state.compiler-backend-state-function-state backend-state)
      -128)
    (asm-ok?
      (be_calls.compiler-backend-emit-mov-phi-copy-edge
        (ast.ast-node-pool-reader-type-segment-bases)
        (compiler-backend-phi-xmm-stage-fused-assignments)
        blocks
        (ir.compiler-ir-label "join")
        (ir.compiler-ir-label "entry")
        2
        (Var 4)
        program-index
        5)
      (has "    movsd -32(%rbp), %xmm3\n" "    movsd %xmm3, -16(%rbp)\n")
      (lacks "%xmm2" "-128(%rbp)"))))

(define (compiler-backend-phi-group-cycle-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12/%r13 %1=%r14/%r15"))

(define (compiler-backend-phi-group-cycle-blocks) : ir.CompilerIrBlockList
  (let
    [ty : ast.AstType (compiler-backend-register-group-test-type)]
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "join")
        (compiler-backend-test-instr-seq-prepend
          (Phi
            0
            (ir.compiler-ir-phi-input-seq-prepend
              (Var 1)
              (ir.compiler-ir-label "back")
              (& (ir.compiler-ir-phi-input-seq-empty)))
            (owned_view.compiler-owned-shared-view ty))
          (irt.instrs "%1 = phi [%0, back] : BackendGroupTest"))))))

(define (compiler-backend-phi-f64-cycle-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%xmm2 %1=%xmm3"))

(define (compiler-backend-phi-f64-spill-cycle-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=spill:-16 %1=%xmm3"))

(define (compiler-backend-phi-f64-cycle-blocks) : ir.CompilerIrBlockList
