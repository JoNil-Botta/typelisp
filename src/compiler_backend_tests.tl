        target))
    (compiler-backend-literal-float-to-bits-asm-ok?
      (compiler-backend-emit-source-opt2-for-target
        (compiler-backend-literal-float-to-bits-source)
        target)
      (compiler-backend-emit-source-opt2-for-target
