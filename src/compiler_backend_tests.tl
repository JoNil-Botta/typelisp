        (compiler_backend.compiler-backend-string-contains? asm "    .quad 2\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "_tl_greeting:\n    .quad .L_tl_str_l2_13861_13991\n")
        (compiler_backend.compiler-backend-string-contains?
