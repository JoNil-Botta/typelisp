    "join:
       %0 = phi [%1, back] : f64
       %1 = phi [%0, back] : f64"))

(define (compiler-backend-phi-f32-three-cycle-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%xmm2 %1=%xmm3 %2=%xmm5"))

(define (compiler-backend-phi-f32-three-cycle-blocks) : ir.CompilerIrBlockList
