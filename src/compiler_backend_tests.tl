    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-simd-address-assignments)
    (compiler_ir_types.CompilerIrValue.Var 0)
    (compiler_ir_types.CompilerIrValue.Var 1)
    (compiler_ir_types.CompilerIrValue.Var 4)
    4
    (compiler_ast_types.AstType.I64)
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" ""))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (string.eq asm "    vmovdqu %ymm7, (%rdi,%r12,8)\n")]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-predicated-load-address-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-avx512-predicated-load
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-simd-address-assignments)
    3
    (compiler_ir_types.CompilerIrValue.Var 0)
    (compiler_ir_types.CompilerIrValue.I64 4)
    (compiler_ir_types.CompilerIrValue.Var 5)
    8
    (compiler_ast_types.AstType.I64)
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" ""))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (string.eq asm "    vmovdqu64 32(%rdi), %zmm6{%k1}{z}\n")]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-simd-indexed-address-users-ok?) : bool
  (and
    (compiler-backend-simd-indexed-address-planned-spills-ok?)
    (compiler-backend-avx2-vector-load-address-ok?)
    (compiler-backend-avx2-vector-store-address-ok?)
    (compiler-backend-avx512-predicated-load-address-ok?)))

(define (compiler-backend-avx512-masked-if-source) : String
  "(define (fill [xs : (Array i64)] [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< (array-ref xs i) 0)
      (array-set! out i 0)
      (array-set! out i (+ (array-ref xs i) 1)))))")

(define (compiler-backend-avx512-masked-if-offset-source) : String
  "(define (fill [xs : (Array i64)] [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< (array-ref xs (+ i 1)) 0)
      (array-set! out (+ i 1) 0)
      (array-set! out (+ i 1) (+ (array-ref xs (+ i 1)) 1)))))")

(define (compiler-backend-avx512-masked-if-index-value-source) : String
  "(define (fill [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< i 6)
      (array-set! out i i)
      (array-set! out i (+ i 1)))))")

(define (compiler-backend-avx512-masked-if-index-mod-source) : String
  "(define (fill [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (= (% i 2) 0)
      (array-set! out i (+ i 10))
      (array-set! out i (+ i 100)))))")

(define (compiler-backend-avx512-masked-if-value-source) : String
  "(define (fill [xs : (Array i64)] [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i
      (if (< (array-ref xs i) 0)
        0
        (+ (array-ref xs i) 1)))))")

(define (compiler-backend-avx512-select-alias-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 6)))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          (compiler_abi.compiler-abi-mask-register-id 1)))
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          2
          (compiler_regalloc.CompilerRegLocation.Register
            (compiler_abi.compiler-abi-vector-register-id 6)))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            3
            (compiler_regalloc.CompilerRegLocation.Register
              (compiler_abi.compiler-abi-vector-register-id 7)))
          compiler_regalloc.CompilerRegAssignmentList.Nil)))))

(define (compiler-backend-avx512-select-false-alias-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 7)))
    (compiler_regalloc.compiler-reg-assignment-cons
