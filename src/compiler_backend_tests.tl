(define (compiler-backend-runtime-atomic-wrapper-source) : String
  "(module stdlib.runtime)

(define (atomic-i64-load-ptr [ptr : (Ptr i64)])
  : i64
  (unsafe (atomic-load ptr)))

(define (atomic-i64-store-ptr! [ptr : (MutPtr i64)] [value : i64])
  : unit
  (unsafe (atomic-store! ptr value)))

(define (atomic-i64-add-ptr! [ptr : (MutPtr i64)] [delta : i64])
  : unit
  (unsafe (atomic-add! ptr delta)))

(define (atomic-i64-fetch-add-ptr!
  [ptr : (MutPtr i64)]
  [delta : i64])
  : i64
  (unsafe (atomic-fetch-add! ptr delta)))

(define (atomic-i64-cas-ptr!
  [ptr : (MutPtr i64)]
  [expected : i64]
  [new-value : i64])
  : i64
  (unsafe (atomic-cas! ptr expected new-value)))

(define (atomic-i32-load-ptr [ptr : (Ptr i32)])
  : i32
  (unsafe (atomic-load ptr)))

(define (atomic-i32-store-ptr! [ptr : (MutPtr i32)] [value : i32])
  : unit
  (unsafe (atomic-store! ptr value)))

(define (atomic-i32-add-ptr! [ptr : (MutPtr i32)] [delta : i32])
  : unit
  (unsafe (atomic-add! ptr delta)))

(define (atomic-i32-fetch-add-ptr!
  [ptr : (MutPtr i32)]
  [delta : i32])
  : i32
  (unsafe (atomic-fetch-add! ptr delta)))

(define (atomic-i32-cas-ptr!
  [ptr : (MutPtr i32)]
  [expected : i32]
  [new-value : i32])
  : i32
  (unsafe (atomic-cas! ptr expected new-value)))

(define (atomic-wrapper-root
  [p64 : (MutPtr i64)]
  [p32 : (MutPtr i32)])
  : i64
  (begin
    (atomic-i64-load-ptr (unsafe (ptr-cast p64 : (Ptr i64))))
    (atomic-i64-store-ptr! p64 0)
    (atomic-i64-add-ptr! p64 1)
    (atomic-i64-fetch-add-ptr! p64 1)
    (atomic-i64-cas-ptr! p64 1 2)
    (atomic-i32-load-ptr (unsafe (ptr-cast p32 : (Ptr i32))))
    (atomic-i32-store-ptr! p32 (cast 0 : i32))
    (atomic-i32-add-ptr! p32 (cast 1 : i32))
    (atomic-i32-fetch-add-ptr! p32 (cast 1 : i32))
    (atomic-i32-cas-ptr! p32 (cast 1 : i32) (cast 2 : i32))
    42))

(define (main) : i64
  (let
    [items64 : (Array i64) (__tl_make-array i64 1)]
    [items32 : (Array i32) (__tl_make-array i32 1)]
    (atomic-wrapper-root
      (unsafe (array-data items64))
      (unsafe (array-data items32)))))")

(define (compiler-backend-emit-runtime-atomic-wrapper-source
  [target : compiler_backend.CompilerBackendTarget]) : compiler_backend.ResultCompilerBackend
  (match (compiler_lower.lower-compiler-source-with-path-mode
    "stdlib/runtime.tl"
    (compiler-backend-runtime-atomic-wrapper-source)
    (compiler_backend.compiler-backend-lower-mode-for-target
      target
      (compiler_backend.CompilerBackendMode.Scalar)))
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (compiler_backend.compiler-backend-emit-program-with-spans-for-target
        program
        spans
        target)]
    [(compiler_lower.ResultCompilerLower.Err diag)
      (compiler_backend.ResultCompilerBackend.Err diag)]))

(define (compiler-backend-runtime-atomic-linux-wrapper-asm-ok? [asm : String]) : bool
  (and
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i64_load_ptr:\n    movq (%rdi), %rax\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i64_store_ptr:\n    xchgq %rsi, (%rdi)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i64_add_ptr:\n    lock addq %rsi, (%rdi)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i64_fetch_add_ptr:\n    movq %rsi, %rax\n    lock xaddq %rax, (%rdi)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i64_cas_ptr:\n    movq %rsi, %rax\n    lock cmpxchgq %rdx, (%rdi)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i32_load_ptr:\n    movl (%rdi), %eax\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i32_store_ptr:\n    xchgl %esi, (%rdi)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i32_add_ptr:\n    lock addl %esi, (%rdi)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i32_fetch_add_ptr:\n    movl %esi, %eax\n    lock xaddl %eax, (%rdi)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i32_cas_ptr:\n    movl %esi, %eax\n    lock cmpxchgl %edx, (%rdi)\n    ret\n")))

(define (compiler-backend-runtime-atomic-windows-wrapper-asm-ok? [asm : String]) : bool
  (and
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i64_load_ptr:\n    movq (%rcx), %rax\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i64_store_ptr:\n    xchgq %rdx, (%rcx)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i64_add_ptr:\n    lock addq %rdx, (%rcx)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i64_fetch_add_ptr:\n    movq %rdx, %rax\n    lock xaddq %rax, (%rcx)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i64_cas_ptr:\n    movq %rdx, %rax\n    lock cmpxchgq %r8, (%rcx)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i32_load_ptr:\n    movl (%rcx), %eax\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i32_store_ptr:\n    xchgl %edx, (%rcx)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i32_add_ptr:\n    lock addl %edx, (%rcx)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i32_fetch_add_ptr:\n    movl %edx, %eax\n    lock xaddl %eax, (%rcx)\n    ret\n")
    (compiler_backend.compiler-backend-string-contains?
      asm
      "tl_atomic_i32_cas_ptr:\n    movl %edx, %eax\n    lock cmpxchgl %r8d, (%rcx)\n    ret\n")))

(define (compiler-backend-runtime-atomic-wrapper-asm-ok?) : bool
  (match (compiler-backend-emit-runtime-atomic-wrapper-source
    (compiler_backend.CompilerBackendTarget.Linux))
    [(compiler_backend.ResultCompilerBackend.Ok linux-asm)
      (match (compiler-backend-emit-runtime-atomic-wrapper-source
        (compiler_backend.CompilerBackendTarget.Windows))
        [(compiler_backend.ResultCompilerBackend.Ok windows-asm)
          (and
            (compiler-backend-runtime-atomic-linux-wrapper-asm-ok? linux-asm)
            (compiler-backend-runtime-atomic-windows-wrapper-asm-ok?
              windows-asm))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-runtime-tls-wrapper-source) : String
  "(define (runtime-tls-current-arena) : i64
  (tls-current-arena))

(unsafe
  (define (runtime-tls-current-arena-set! [arena : i64]) : unit
    (unsafe
      (tls-current-arena-set! arena))))

(define (main) : i64
  (let
    [home : i64 (runtime-tls-current-arena)]
    (begin
      (unsafe (runtime-tls-current-arena-set! home))
      home)))")

(define (compiler-backend-emit-runtime-tls-wrapper-source
  [target : compiler_backend.CompilerBackendTarget]) : compiler_backend.ResultCompilerBackend
