      CompilerIrFunctionList.Nil)
    CompilerIrExternList.Nil))

(define (compiler-backend-total-switch-test-cases) : CompilerIrSwitchCaseList
  (compiler-ir-switch-case-cons
    0
    "zero"
    (compiler-ir-switch-case-cons
      1
      "one"
      (compiler-ir-switch-case-cons
        2
        "two"
        (compiler-ir-switch-case-cons
