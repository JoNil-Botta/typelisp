          prev-assignment-index
          prev-plan-mask
          prev-occupied-masks
          prev-vars)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          prev-post-base)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          prev-current-count)
        (if prev-win64
          (compiler_backend.compiler-backend-set-current-fn-win64!)
          (compiler_backend.compiler-backend-set-current-fn-linux!))
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending!
          prev-emergency-pending)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-reg!
          prev-emergency-reg)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used!
          prev-emergency-used)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-pending-count!
          prev-emergency-pending-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-used-count!
          prev-emergency-used-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-slot-offset!
          prev-emergency-slot-offset)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-restore-suppressed!
          prev-emergency-restore-suppressed))]
    result))

(define (compiler-backend-inline-fast-alloc-emergency-preserved-ok?) : bool
  (match (compiler-backend-inline-fast-alloc-emergency-asm)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r9, -512(%rbp)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq -512(%rbp), %r9\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rcx, -576(%rbp)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq -576(%rbp), %rcx\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %fs:tl_current_arena@tpoff, %r9\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    leaq 8(%rax), %rcx\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rcx, 16(%r9)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call .L_tl_alloc8\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq tl_profile_alloc_live_bytes(%rip), %rcx\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq tl_profile_alloc_peak_bytes(%rip), %rcx\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "tl_profile_alloc_live_bytes(%rip), %r10"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "%r10, tl_profile_alloc_peak_bytes(%rip)"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %fs:tl_current_arena@tpoff, %r8\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    leaq 8(%rax), %r8\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    leaq 8(%rax), %rax\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Backend emit-shape coverage for local tuple construction/ref.
;; `(tuple true 42)` allocates the tuple payload, materializes/stores the bool
;; byte and i64 at their offsets, and `(tuple-ref t 1)` loads the i64 slot back.
(define (compiler-backend-tuple-source) : String
  "(define (main) : i64
  (let
    [t : (Tuple bool i64) (tuple true 42)]
    (tuple-ref t 1)))")

(define (compiler-backend-tuple-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-tuple-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler-backend-string-contains-alloc-size? asm 16)
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq $1,")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movb %r8b, (%r10)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq $42,")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r8, 8(%r10)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 8(%r10), %r8\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movb %al, (%r10)\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %rax, 8(%r10)\n")))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-struct-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler_lower_tests.compiler-lower-inline-struct-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and4
        (=
          (compiler_backend.compiler-backend-string-count
            asm
            "    call tl_alloc\n")
          0)
        (compiler_backend.compiler-backend-string-contains? asm "    leaq -")
        (compiler_backend.compiler-backend-string-contains? asm "main:\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-enum-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler_lower_tests.compiler-lower-inline-enum-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and4
        (=
          (compiler_backend.compiler-backend-string-count
            asm
            "    call tl_alloc\n")
          0)
        (compiler_backend.compiler-backend-string-contains? asm "    leaq -")
        (compiler_backend.compiler-backend-string-contains?
          asm
          ".Lf0_match_arm.")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-boxed-recursive-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler_lower_tests.compiler-lower-inline-boxed-recursive-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and4
        (= (compiler-backend-alloc-call-count asm) 2)
        ;; Both boxed leaves heap-allocate a full inline Tree value: tag (8)
        ;; plus the largest variant payload Branch((Box Tree), (Box Tree)) =
        ;; 16, so 24 bytes. With default-inline aggregates each box holds the
        ;; inline value, not an 8-byte handle.
        (compiler-backend-string-contains-alloc-size? asm 24)
        (compiler_backend.compiler-backend-string-contains? asm "    leaq -")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-hot-loop-struct-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler_lower_tests.compiler-lower-inline-hot-loop-struct-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      ;; The loop's 16-byte `Pair` is now a register-resident group (built
      ;; and read in registers), so the loop body neither heap-allocates nor needs
      ;; a stack-slot address for it.
      (compiler_backend.backend-and4
        (=
          (compiler_backend.compiler-backend-string-count
            asm
            "    call tl_alloc\n")
          0)
        (compiler_backend.compiler-backend-string-contains? asm "main:\n")
        true
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-aggregate-call-source) : String
  "(defstruct Color (r u8) (g u8) (b u8) (a u8))
(defenum Swatch (Empty) (Paint Color))
(define (make-color) : Color
  (Color (cast 5 : u8) (cast 7 : u8) (cast 11 : u8) (cast 13 : u8)))
(define (id-color [c : Color]) : Color c)
(define (use-color [c : Color]) : i64
  (+
    (cast (struct-get c r) : i64)
    (+
      (cast (struct-get c g) : i64)
      (+ (cast (struct-get c b) : i64) (cast (struct-get c a) : i64)))))
(define (id-swatch [s : Swatch]) : Swatch s)
(define (score-swatch [s : Swatch]) : i64
  (match s
    [Empty 0]
    [(Paint c) (use-color c)]))
(define (main) : i64
  (let
    [c : Color (id-color (make-color))]
    [s : Swatch (id-swatch (Paint c))]
    (if (= (use-color c) 36)
      (if (= (score-swatch s) 36) 42 2)
      1)))")

(define (compiler-backend-inline-aggregate-call-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-inline-aggregate-call-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and4
        (compiler_backend.compiler-backend-string-contains? asm "main:\n")
        (>= (compiler_backend.compiler-backend-string-count asm "    call ") 6)
        ;; sret ABI: aggregate args/returns pass by caller slot pointer
        ;; and inline construction is stack storage -- no arena allocation.
        (= (compiler-backend-alloc-call-count asm) 0)
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-aggregate-call-ok?) : bool
  (and
    (compiler-backend-inline-aggregate-call-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-inline-aggregate-call-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

(define (compiler-backend-inline-aggregate-copy-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-inline-aggregates-for-target
    (compiler_lower_tests.compiler-lower-inline-aggregate-copy-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      ;; `Pair` is a 16-byte all-integer struct, so it is register-resident
      ;; -- `id-pair` is a register-pair passthrough that carries both words in
      ;; registers end-to-end. The function is still emitted, but it does NOT do
      ;; the old pointer-load / pointer-store byte-copy ("(%r11), %rax" then
      ;; "%rax, (%r10)") that a memory aggregate required.
      (compiler_backend.backend-and4
        (compiler_backend.compiler-backend-string-contains? asm "id_pair")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "(%r11), %rax"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "%rax, (%r10)"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-aggregate-copy-ok?) : bool
  (and
    (compiler-backend-inline-aggregate-copy-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-inline-aggregate-copy-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

(define (compiler-backend-inline-aggregate-storage-ok?) : bool
  (and
    (compiler-backend-inline-struct-ok?)
    (compiler-backend-inline-enum-ok?)
    (compiler-backend-inline-boxed-recursive-ok?)
    (compiler-backend-inline-aggregate-call-ok?)
    (compiler-backend-inline-aggregate-copy-ok?)
    (compiler-backend-inline-hot-loop-struct-ok?)))

(define (compiler-backend-test-mode-scalar?
  [mode : compiler_backend.CompilerBackendMode]) : bool
  (match mode
    [(compiler_backend.CompilerBackendMode.Scalar) true]
    [_ false]))

(define (compiler-backend-test-mode-avx2?
  [mode : compiler_backend.CompilerBackendMode]) : bool
  (match mode
    [(compiler_backend.CompilerBackendMode.Avx2) true]
    [_ false]))

(define (compiler-backend-test-mode-avx512?
  [mode : compiler_backend.CompilerBackendMode]) : bool
  (match mode
    [(compiler_backend.CompilerBackendMode.Avx512) true]
    [_ false]))

(define (compiler-backend-defdispatch-source) : String
  "(define (dot-scalar [x : i64]) : i64 x)
(define (dot-avx2 [x : i64]) : i64 (+ x 2))
(define (dot-avx512 [x : i64]) : i64 (+ x 5))
(defdispatch dot (scalar dot-scalar) (avx2 dot-avx2) (avx512 dot-avx512))
(define (main) : i64 (dot 40))")

(define (compiler-backend-defdispatch-thunk-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-defdispatch-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            "__tl_dispatch_cache_dot")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "__tl_dispatch_variant_avx2")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "__tl_dispatch_variant_avx512")
          (compiler_backend.compiler-backend-string-contains? asm "    cpuid\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    xgetbv\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call *(%r10)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    vzeroupper\n")
          (compiler_backend.compiler-backend-string-contains? asm "main:\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-dispatch-variant-mode-ok?) : bool
  (and
    (compiler_backend.backend-and4
      (compiler-backend-test-mode-avx2?
        (compiler_backend.compiler-backend-effective-mode-for-function-name
          (compiler_backend.CompilerBackendMode.Scalar)
          "__tl_dispatch_variant_avx2_dot__dot-avx2"))
      (compiler-backend-test-mode-avx512?
        (compiler_backend.compiler-backend-effective-mode-for-function-name
          (compiler_backend.CompilerBackendMode.Scalar)
          "__tl_dispatch_variant_avx512_dot__dot-avx512"))
      (compiler-backend-test-mode-scalar?
        (compiler_backend.compiler-backend-effective-mode-for-function-name
          (compiler_backend.CompilerBackendMode.Scalar)
          "__tl_dispatch_variant_scalar_dot__dot-scalar"))
      (compiler-backend-test-mode-avx2?
        (compiler_backend.compiler-backend-effective-mode-for-function-name
          (compiler_backend.CompilerBackendMode.Avx2)
          "ordinary")))
    (compiler-backend-defdispatch-thunk-ok?)))

(define (compiler-backend-signature-i64-to-i64?
  [sig : compiler_backend.CompilerBackendMaybeSignature]) : bool
  (match sig
    [(compiler_backend.CompilerBackendMaybeSignature.Some args ret-ty)
      (match ret-ty
        [(compiler_ast_types.AstType.I64)
          (and
            (= (compiler_ast_types.ast-type-list-len (& args)) 1)
            (match (compiler_ast_types.ast-node-pool-reader-type-get
              (compiler_ast_types.ast-type-list-get
                (& args)
                0
                (compiler_ast_types.ast-type-id-fallback)))
              [(compiler_ast_types.AstType.I64) true]
              [_ false]))]
        [_ false])]
    [(compiler_backend.CompilerBackendMaybeSignature.No) false]))

(define (compiler-backend-signature-unit-to-i64?
  [sig : compiler_backend.CompilerBackendMaybeSignature]) : bool
  (match sig
    [(compiler_backend.CompilerBackendMaybeSignature.Some args ret-ty)
      (and
        (compiler_ast_types.ast-type-list-empty? (& args))
        (match ret-ty
          [(compiler_ast_types.AstType.I64) true]
          [_ false]))]
    [(compiler_backend.CompilerBackendMaybeSignature.No) false]))

(define (compiler-backend-program-index-test-functions) : compiler_ir_types.CompilerIrFunctionList
  (compiler_ir_types.compiler-ir-function-cons
    (compiler_ir_types.CompilerIrFunction.Function
      (ci.intern "pkg/really-long-backend-index-function")
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "x"
          (compiler_ast_types.AstType.I64)
          0)
        compiler_ir_types.CompilerIrParamList.Nil)
      (compiler_ast_types.AstType.I64)
      1
      compiler_ir_types.CompilerIrBlockList.Nil)
    (compiler_ir_types.compiler-ir-function-cons
      (compiler_ir_types.CompilerIrFunction.Function
        (ci.intern "short_fn")
        compiler_ir_types.CompilerIrParamList.Nil
        (compiler_ast_types.AstType.Unit)
        0
        compiler_ir_types.CompilerIrBlockList.Nil)
      compiler_ir_types.CompilerIrFunctionList.Nil)))

(define (compiler-backend-program-index-test-externs
  [provided-id : i64]
  [provided-link-id : i64]
  [referenced-id : i64]
  [referenced-link-id : i64]) : compiler_ir_types.CompilerIrExternList
  (compiler_ir_types.compiler-ir-extern-cons
    (compiler_ir_types.CompilerIrExtern.Extern
      provided-id
      provided-id
      "provided_decl"
      (compiler_ast_types.ast-ty-func
        (compiler_ast_types.ast-type-list-new)
        (compiler_ast_types.AstType.I64))
      (compiler_ast_types.AstExternAbi.C)
      provided-link-id
      (compiler_ast_types.ast-extern-link-input-list-new)
      true)
    (compiler_ir_types.compiler-ir-extern-cons
      (compiler_ir_types.CompilerIrExtern.Extern
        referenced-id
        referenced-id
        "referenced_decl"
        (compiler_ast_types.ast-ty-func
          (compiler_ast_types.ast-type-cons
            (compiler_ast_types.AstType.I64)
            (compiler_ast_types.ast-type-list-new))
          (compiler_ast_types.AstType.I64))
        (compiler_ast_types.AstExternAbi.C)
        referenced-link-id
        (compiler_ast_types.ast-extern-link-input-list-new)
        false)
      compiler_ir_types.CompilerIrExternList.Nil)))

(define (compiler-backend-user-symbol-cache-ok?) : bool
  (begin
    (ci.intern-reset!)
    (compiler_backend.compiler-backend-user-symbol-cache-reset!)
    (let
      [path-name : String "pkg/nested/module.tl::some-value"]
      [path-id : i64 (ci.intern path-name)]
      [path-symbol-first : String
        (compiler_backend.compiler-backend-user-symbol-id path-id)]
      [count-after-path-first : i64
        (compiler_backend.compiler-backend-user-symbol-cache-count)]
      [path-symbol-second : String
        (compiler_backend.compiler-backend-user-symbol-id path-id)]
      [count-after-path-second : i64
        (compiler_backend.compiler-backend-user-symbol-cache-count)]
      [main-id : i64 (ci.intern "main")]
      [main-symbol-first : String
        (compiler_backend.compiler-backend-user-symbol-id main-id)]
      [count-after-main-first : i64
        (compiler_backend.compiler-backend-user-symbol-cache-count)]
      [main-symbol-second : String
        (compiler_backend.compiler-backend-user-symbol-id main-id)]
      [count-after-main-second : i64
        (compiler_backend.compiler-backend-user-symbol-cache-count)]
      [third-symbol : String
        (compiler_backend.compiler-backend-user-symbol-id path-id)]
      [count-after-third : i64
        (compiler_backend.compiler-backend-user-symbol-cache-count)]
      (compiler_backend.backend-and8
        (string.eq path-symbol-first "_tl_pkg_nested_module_some_value")
        (string.eq path-symbol-second path-symbol-first)
        (= count-after-path-first 1)
        (= count-after-path-second count-after-path-first)
        (string.eq main-symbol-first "main")
        (string.eq main-symbol-second "main")
        (= count-after-main-second count-after-main-first)
        (and
          (string.eq third-symbol path-symbol-first)
          (= count-after-third count-after-main-second))))))

(define (compiler-backend-user-symbol-cache-compat-state-ok?) : bool
  (let
    [state-a : ci.InternCompatState (ci.intern-compat-state-new)]
    [state-b : ci.InternCompatState (ci.intern-compat-state-new)]
    [id-a : i64
      (begin
        (ci.intern-compat-state-install! state-a)
        (ci.intern-reset!)
        (ci.intern "first-state-name"))]
    [symbol-a : String
      (begin
        (ci.intern-compat-state-capture-from-globals! state-a)
        (compiler_backend.compiler-backend-user-symbol-id id-a))]
    [id-b : i64
      (begin
        (ci.intern-compat-state-install! state-b)
        (ci.intern-reset!)
        (ci.intern "second-state-name"))]
    [symbol-b : String
      (begin
        (ci.intern-compat-state-capture-from-globals! state-b)
        (compiler_backend.compiler-backend-user-symbol-id id-b))]
    (and
      (= id-a id-b)
      (not
        (=
          (ci.intern-compat-state-generation state-a)
          (ci.intern-compat-state-generation state-b)))
      (not
        (=
          (ci.intern-compat-state-table-id state-a)
          (ci.intern-compat-state-table-id state-b)))
      (string.eq symbol-a "_tl_first_state_name")
      (string.eq symbol-b "_tl_second_state_name"))))

(define (compiler-backend-user-symbol-cache-scratch-source) : String
  "(define (shared [x : i64]) : i64 (+ x 1))
(define (first [x : i64]) : i64 (shared x))
(define (second [x : i64]) : i64 (shared x))
(define (main) : i64 (+ (first 1) (second 2)))")

(define (compiler-backend-user-symbol-cache-scratch-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-user-symbol-cache-scratch-source))
    [(compiler_backend.ResultCompilerBackend.Ok _) true]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-runtime-leaf-user-symbol-ok?) : bool
  (let
    [fn-name : String "pkg/substring"]
    [fn-id : i64 (ci.intern fn-name)]
    [index : compiler_backend.CompilerBackendProgramIndex
      (compiler_backend.compiler-backend-program-index-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_ir_types.compiler-ir-function-cons
          (compiler_ir_types.CompilerIrFunction.Function
            fn-id
            compiler_ir_types.CompilerIrParamList.Nil
            (compiler_ast_types.AstType.I64)
            0
            compiler_ir_types.CompilerIrBlockList.Nil)
          compiler_ir_types.CompilerIrFunctionList.Nil)
        compiler_ir_types.CompilerIrExternList.Nil)]
    (and
      (string.eq
        (compiler_backend.compiler-backend-runtime-prelude-string-helper-symbol
          fn-name)
        "")
      (string.eq
        (compiler_backend.compiler-backend-function-symbol-index index fn-id)
        "_tl_pkg_substring"))))

(define (compiler-backend-program-index-id-maps-ok?) : bool
  (let
    [fn-name : String "pkg/really-long-backend-index-function"]
    [fn-id : i64 (ci.intern fn-name)]
    [short-fn-id : i64 (ci.intern "short_fn")]
    [provided-name : String "provided_decl"]
    [provided-id : i64 (ci.intern provided-name)]
    [provided-link-id : i64 (ci.intern "provided_link")]
    [referenced-name : String "referenced_decl"]
    [referenced-id : i64 (ci.intern referenced-name)]
    [referenced-link : String "referenced_link"]
    [referenced-link-id : i64 (ci.intern referenced-link)]
    [missing-id : i64 (ci.intern "missing_backend_index_name")]
    [index : compiler_backend.CompilerBackendProgramIndex
      (compiler_backend.compiler-backend-program-index-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler-backend-program-index-test-functions)
        (compiler-backend-program-index-test-externs
          provided-id
          provided-link-id
          referenced-id
          referenced-link-id))]
    (and
      (compiler_backend.compiler-backend-index-function-defines-id?
        index
        short-fn-id)
      (compiler_backend.backend-and8
        (compiler_backend.compiler-backend-index-function-defines-id?
          index
          fn-id)
        (compiler_backend.compiler-backend-index-function-defines? index fn-id)
        (not
          (compiler_backend.compiler-backend-index-function-defines-id?
            index
            missing-id))
        (compiler-backend-signature-i64-to-i64?
          (compiler_backend.compiler-backend-index-function-signature-id
            index
            fn-id))
        (compiler-backend-signature-i64-to-i64?
          (compiler_backend.compiler-backend-index-function-signature
            index
            fn-id))
        (string.eq
          (compiler_backend.compiler-backend-function-symbol-index index fn-id)
          "_tl_f0")
        (string.eq
          (compiler_backend.compiler-backend-function-label-scope index fn-id)
          "f0")
        (compiler-backend-signature-unit-to-i64?
          (compiler_backend.compiler-backend-index-extern-signature-id
            index
            provided-id)))
      (compiler_backend.backend-and8
        (compiler_backend.compiler-backend-index-extern-provided-id?
          index
          provided-id)
        (compiler_backend.compiler-backend-index-extern-provided?
          index
          provided-id)
        (not
          (compiler_backend.compiler-backend-index-extern-provided-id?
            index
            provided-link-id))
        (compiler_backend.compiler-backend-index-extern-references-id?
          index
          referenced-id)
        (not
          (compiler_backend.compiler-backend-index-extern-references-id?
            index
            referenced-link-id))
        (=
          (compiler_backend.compiler-backend-index-extern-link-symbol-id
            index
            referenced-id)
          referenced-link-id)
        (=
          (compiler_backend.compiler-backend-index-extern-link-symbol-id
            index
            referenced-link-id)
          referenced-link-id)
        (=
          (compiler_backend.compiler-backend-index-extern-link-symbol-id
            index
            missing-id)
          missing-id))
      (compiler_backend.backend-and4
        (string.eq
          (compiler_backend.compiler-backend-function-symbol-map-comment
            index
            fn-id)
          "#t _tl_f0 _tl_really_long_backend_index_function\n")
        (string.eq
          (compiler_backend.compiler-backend-function-symbol-index
            index
            provided-id)
          "provided_link")
        (compiler_backend.compiler-backend-index-extern-references?
          index
          referenced-link-id)
        (string.eq
          (compiler_backend.compiler-backend-index-extern-link-symbol
            index
            referenced-link-id)
          referenced-link)))))

(define (compiler-backend-program-index-explicit-extern-ids-ok?) : bool
  (begin
    (ci.intern-reset!)
    (let
      [fn-name : String "late_backend_index_fn"]
      [fn-id : i64 (ci.intern fn-name)]
      [extern-name : String "late_backend_index_ext"]
      [extern-id : i64 (ci.intern-generated-name extern-name)]
      [same-name-id : i64 (ci.intern-generated-name extern-name)]
      [extern-link : String "late_backend_index_link"]
      [extern-link-id : i64 (ci.intern-generated-name extern-link)]
      [same-name-link : String "late_backend_index_link_2"]
      [same-name-link-id : i64 (ci.intern-generated-name same-name-link)]
      [source-count-before : i64 (ci.intern-pool-len)]
      [index : compiler_backend.CompilerBackendProgramIndex
        (compiler_backend.compiler-backend-program-index-build
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler_ir_types.compiler-ir-function-cons
            (compiler_ir_types.CompilerIrFunction.Function
              fn-id
              compiler_ir_types.CompilerIrParamList.Nil
              (compiler_ast_types.AstType.Unit)
              0
              compiler_ir_types.CompilerIrBlockList.Nil)
            compiler_ir_types.CompilerIrFunctionList.Nil)
          (compiler_ir_types.compiler-ir-extern-cons
            (compiler_ir_types.CompilerIrExtern.Extern
              extern-id
              extern-id
              extern-name
              (compiler_ast_types.ast-ty-func
                (compiler_ast_types.ast-type-list-new)
                (compiler_ast_types.AstType.I64))
              (compiler_ast_types.AstExternAbi.C)
              extern-link-id
              (compiler_ast_types.ast-extern-link-input-list-new)
              false)
            (compiler_ir_types.compiler-ir-extern-cons
              (compiler_ir_types.CompilerIrExtern.Extern
                same-name-id
                same-name-id
                extern-name
                (compiler_ast_types.ast-ty-func
                  (compiler_ast_types.ast-type-cons
                    (compiler_ast_types.AstType.I64)
                    (compiler_ast_types.ast-type-list-new))
                  (compiler_ast_types.AstType.I64))
                (compiler_ast_types.AstExternAbi.C)
                same-name-link-id
                (compiler_ast_types.ast-extern-link-input-list-new)
                false)
              compiler_ir_types.CompilerIrExternList.Nil)))]
      (and
        (= source-count-before (ci.intern-pool-len))
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-index-function-defines-id?
            index
            fn-id)
          (compiler_backend.compiler-backend-index-function-defines?
            index
            fn-id)
          (compiler-backend-signature-unit-to-i64?
            (compiler_backend.compiler-backend-index-extern-signature-id
              index
              extern-id))
          (compiler-backend-signature-i64-to-i64?
            (compiler_backend.compiler-backend-index-extern-signature-id
              index
              same-name-id))
          (compiler_backend.compiler-backend-index-extern-references-id?
            index
            extern-id)
          (compiler_backend.compiler-backend-index-extern-references-id?
            index
            same-name-id)
          (=
            (compiler_backend.compiler-backend-index-extern-link-symbol-id
              index
              extern-id)
            extern-link-id)
          (=
            (compiler_backend.compiler-backend-index-extern-link-symbol-id
              index
              same-name-id)
            same-name-link-id))
        (compiler_backend.backend-and4
          (compiler_backend.compiler-backend-index-extern-references?
            index
            extern-link-id)
          (compiler_backend.compiler-backend-index-extern-references?
            index
            same-name-link-id)
          (match (ci.intern-lookup extern-name)
            [(InternLookupFound _) false]
            [(InternLookupMissing) true])
          (not (= extern-id same-name-id)))))))

(define (compiler-backend-profile-runtime-source) : String
  "(extern (tl_profile_alloc_total) : i64)
(define (main) : i64 (tl_profile_alloc_total))")

(define (compiler-backend-profile-runtime-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-profile-runtime-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".globl tl_profile_alloc_total\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "tl_profile_alloc_total:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "tl_profile_alloc_live:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "tl_profile_alloc_peak:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "tl_profile_alloc_reset_peak:\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl tl_profile_now_ms\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "tl_profile_now_ms:\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "QueryPerformanceCounter")))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "QueryPerformanceFrequency")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-profile-runtime-split-ok?) : bool
  (and
    (compiler-backend-profile-runtime-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-profile-runtime-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

(define (compiler-backend-scavenge-exclude-before-r10) : (Array String)
  (make-array "%rax" "%r8" "%r9" "%rcx" "%rdx"))

(define (compiler-backend-scavenge-exclude-before-r11) : (Array String)
  (make-array "%rax" "%r8" "%r9" "%rcx" "%rdx" "%r10"))

(define (compiler-backend-scavenge-emergency-exclude-fallback) : (Array String)
  (make-array "%r9" "%rcx" "%rdx" "%r10" "%r11" "%r8" "%rsi" "%rdi" "%rax"))

(define (compiler-backend-scavenge-pooled-r10-r11-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 1)]
    [ends : (Array i64) (make-array i64 1)]
    (and
      (string.eq
        (compiler-backend-scavenge-pick
          starts
          ends
          (compiler_regalloc.compiler-reg-assignment-index-build
            compiler_regalloc.CompilerRegAssignmentList.Nil
            1)
          0
          0
          (compiler-backend-scavenge-exclude-before-r10)
          5
          "%rax")
        "%r10")
      (string.eq
        (compiler-backend-scavenge-pick
          starts
          ends
          (compiler_regalloc.compiler-reg-assignment-index-build
            compiler_regalloc.CompilerRegAssignmentList.Nil
            1)
          0
          0
          (compiler-backend-scavenge-exclude-before-r11)
          6
          "%rax")
        "%r11"))))

(define (compiler-backend-binop-exclude-keeps-pooled-r10-r11-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 5)]
    [ends : (Array i64) (make-array i64 5)]
    [r10-free : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r9))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-rcx))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-rdx))
            (compiler_regalloc.compiler-reg-assignment-cons
              (compiler_regalloc.CompilerRegAssignment
                4
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-r8))
              compiler_regalloc.CompilerRegAssignmentList.Nil))))]
    [r11-free : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r9))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-rcx))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-rdx))
            (compiler_regalloc.compiler-reg-assignment-cons
              (compiler_regalloc.CompilerRegAssignment
                3
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-r10))
              (compiler_regalloc.compiler-reg-assignment-cons
                (compiler_regalloc.CompilerRegAssignment
                  4
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-r8))
                compiler_regalloc.CompilerRegAssignmentList.Nil)))))]
    (begin
      (array-set! starts 0 0)
      (array-set! starts 1 0)
      (array-set! starts 2 0)
      (array-set! starts 3 0)
      (array-set! starts 4 0)
      (array-set! ends 0 10)
      (array-set! ends 1 10)
      (array-set! ends 2 10)
      (array-set! ends 3 10)
      (array-set! ends 4 10)
      (and
        (string.eq
          (compiler-backend-scavenge-pick
            starts
            ends
            (compiler_regalloc.compiler-reg-assignment-index-build r10-free 5)
            5
            5
            (compiler_backend.compiler-backend-binop-scavenge-exclude-build)
            5
            "%r8")
