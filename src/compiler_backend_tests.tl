(define (compiler-backend-non-direct-tail-call-varargs-params) : ast.AstTypeList
  (ast.ast-type-cons
    (& (ast.ast-ty-mut-ptr (& (U8))))
    (&
      (ast.ast-type-cons
        (& (I64))
        (&
          (ast.ast-type-cons
            (& (ast.ast-ty-ptr (& (U8))))
            (& (ast.ast-type-list-new))))))))

(define (compiler-backend-non-direct-tail-call-varargs-args) : ir.CompilerIrCallArgs
  (ir.compiler-ir-call-args-from-seq
    (&
      (ir.compiler-ir-value-seq-prepend
        (& (I64 0))
        (&
          (ir.compiler-ir-value-seq-prepend
            (& (I64 64))
            (&
              (ir.compiler-ir-value-seq-prepend
                (& (I64 0))
                (&
                  (ir.compiler-ir-value-seq-prepend
                    (& (F64 (compiler-backend-test-f64-bits "1.5")))
                    (& (ir.compiler-ir-value-seq-empty))))))))))))

(define (compiler-backend-non-direct-tail-call-varargs-emit
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (compiler-backend-non-direct-tail-call-emit
    target
    "tail_varargs_target"
    "tl_tail_varargs_target"
    (compiler-backend-non-direct-tail-call-varargs-params)
    (I32)
    (CVarargsTyped (F64))
    (compiler-backend-non-direct-tail-call-varargs-args)))

(define (compiler-backend-non-direct-tail-call-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (compiler-backend-non-direct-tail-call-i64-emit target)
    [(Ok asm)
      (if (be_facts.compiler-backend-target-windows? target)
        ;; On Windows an Internal caller has no shadow space, so a Platform C
        ;; extern tail call falls back to call+ret instead of tail-jumping.
        (be_state.backend-and4
          (asm-has? asm "    call tl_tail_target\n")
          (asm-lacks? asm "    leave\n    jmp tl_tail_target\n")
          (asm-has? asm "    ret\n")
          true)
        (be_state.backend-and4
          (asm-has? asm "    leave\n    jmp tl_tail_target\n")
          (asm-lacks? asm "    call tl_tail_target\n")
          (asm-lacks? asm "    ret\n")
          true))]
    [(Err _) false]))

(define (compiler-backend-non-direct-tail-call-unit-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (compiler-backend-non-direct-tail-call-unit-emit target)
    [(Ok asm)
      (be_state.backend-and4
        (asm-has? asm "    call tl_tail_unit_target\n")
        (asm-has? asm "    movl $0, %eax\n")
        (asm-lacks? asm "    leave\n    jmp tl_tail_unit_target\n")
        true)]
    [(Err _) false]))

(define (compiler-backend-non-direct-tail-call-stack-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (compiler-backend-non-direct-tail-call-stack-emit target)
    [(Ok asm)
      (be_state.backend-and4
        (asm-has? asm "    call tl_tail_stack_target\n")
        (asm-lacks? asm "    leave\n    jmp tl_tail_stack_target\n")
        (asm-has? asm "    ret\n")
        true)]
    [(Err _) false]))

(define (compiler-backend-non-direct-tail-call-varargs-pre-call?
  [target : be_state.CompilerBackendTarget]
  [asm : (& asm str)]) : bool
  (if (be_facts.compiler-backend-target-windows? target)
    (asm-has? asm "    movq %xmm3, %r9\n")
    (asm-has? asm "    movb $1, %al\n")))

(define (compiler-backend-non-direct-tail-call-varargs-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (compiler-backend-non-direct-tail-call-varargs-emit target)
    [(Ok asm)
      (if (be_facts.compiler-backend-target-windows? target)
        (be_state.backend-and4
          (compiler-backend-non-direct-tail-call-varargs-pre-call? target asm)
          (asm-has? asm "    call tl_tail_varargs_target\n")
          (asm-lacks? asm "    leave\n    jmp tl_tail_varargs_target\n")
          (asm-has? asm "    ret\n"))
        (be_state.backend-and4
          (compiler-backend-non-direct-tail-call-varargs-pre-call? target asm)
          (asm-has? asm "    leave\n    jmp tl_tail_varargs_target\n")
          (asm-lacks? asm "    call tl_tail_varargs_target\n")
          (asm-lacks? asm "    ret\n")))]
    [(Err _) false]))

(define (compiler-backend-indirect-tail-call-ok?) : bool
  (and
    (compiler-backend-indirect-tail-call-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-indirect-tail-call-target-ok?
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-indirect-tail-call-stack-target-ok?
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-indirect-tail-call-r11-callee-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-indirect-tail-call-r11-callee-target-ok?
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-non-direct-tail-call-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-non-direct-tail-call-target-ok?
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-non-direct-tail-call-unit-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-non-direct-tail-call-unit-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-non-direct-tail-call-unit-target-ok?
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-non-direct-tail-call-stack-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-non-direct-tail-call-stack-target-ok?
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-non-direct-tail-call-varargs-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-non-direct-tail-call-varargs-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-known-function-call-functions) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (Function
        (ci.intern "known_target")
        (ir.compiler-ir-param-seq-prepend
          (Param "x" (I64) 0)
          (ir.compiler-ir-param-seq-empty))
        (I64)
        1
        (ir.compiler-ir-block-list-empty)
        Ordinary))
    (& (ir.compiler-ir-function-seq-empty))))

(define (compiler-backend-known-function-call-index) : be_state.CompilerBackendProgramIndex
  (compiler-backend-program-index-build
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-known-function-call-functions)
    (ir.compiler-ir-extern-seq-empty)))

(define (compiler-backend-known-function-call-env-zero
  [target : be_state.CompilerBackendTarget]) : String
  (match (be_facts.compiler-backend-target-arg-reg target (Platform) 0)
    [(Ok reg) (be_scalar.compiler-backend-emit-load-i64-immediate 0 reg)]
    [(Err _) ""]))

(define (compiler-backend-known-function-indirect-call-emit
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (let
    [functions : ir.CompilerIrFunctionSeq
      (compiler-backend-known-function-call-functions)]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-known-function-call-index)]
    [backend-state : be_state.CompilerBackendState index.backend-state]
    (backend.compiler-backend-emit-indirect-call
      (ast.ast-node-pool-reader-type-segment-bases)
      target
      0
      (Function (ci.intern "known_target"))
      (One (I64 41))
      (I64)
      (regalloc.compiler-reg-assignment-table-empty)
      (regalloc.compiler-reg-var-types-empty)
      functions
      (ir.compiler-ir-extern-seq-empty)
      index
      2
      (cdiag.compiler-diagnostic-at-start "" "")
      backend-state)))

(define (compiler-backend-dynamic-indirect-call-emit
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (let
    [functions : ir.CompilerIrFunctionSeq
      (compiler-backend-known-function-call-functions)]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-known-function-call-index)]
    [backend-state : be_state.CompilerBackendState index.backend-state]
    (backend.compiler-backend-emit-indirect-call
      (ast.ast-node-pool-reader-type-segment-bases)
      target
      0
      (Var 1)
      Nil
      (I64)
      (regalloc.compiler-reg-assignment-table-empty)
      (regalloc.compiler-reg-var-types-empty)
      functions
      (ir.compiler-ir-extern-seq-empty)
      index
      2
      (cdiag.compiler-diagnostic-at-start "" "")
      backend-state)))

(define (compiler-backend-known-function-indirect-call-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (compiler-backend-known-function-indirect-call-emit target)
    [(Ok asm)
      (and
        (be_state.backend-and4
          (let
            [needle (compiler-backend-known-function-call-env-zero target)]
            (asm-has? asm needle))
          (let
            [needle
              (str_cat.str-cat
                "    call "
                (be_facts.compiler-backend-closure-entry-label "known_target")
                "\n")]
            (asm-has? asm needle))
          (asm-lacks? asm "    call *(%r11)\n")
          (not
            (let
              [needle
                (be_operand.compiler-backend-closure-descriptor-label
                  "known_target")]
              (asm-has? asm needle))))
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-dynamic-indirect-call-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (compiler-backend-dynamic-indirect-call-emit target)
    [(Ok asm)
      (and
        (let
          [needle
            (str_cat.str-cat
              "    movq 8(%r10), "
              (match (be_facts.compiler-backend-target-arg-reg
                target
                (Platform)
                0)
                [(Ok reg) reg]
                [(Err _) ""])
              "\n")]
          (asm-has? asm needle))
        (asm-has? asm "    call *(%r10)\n")
        (asm-lacks? asm "    call *(%r11)\n"))]
    [(Err _) false]))

(define (compiler-backend-overlapping-indirect-call-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (be_facts.compiler-backend-target-arg-reg target (Platform) 1)
    [(Ok arg-reg)
      (let
        [functions : ir.CompilerIrFunctionSeq
          (compiler-backend-known-function-call-functions)]
        [index : be_state.CompilerBackendProgramIndex
          (compiler-backend-known-function-call-index)]
        [assignments : regalloc.CompilerRegAssignmentTable
          (regalloc.compiler-reg-assignments-prepend
            (&
              (regalloc.CompilerRegAssignment
                1
                (Register
                  (cabi.compiler-abi-register-id-from-spelling
                    (owned_view.compiler-owned-shared-view arg-reg)))))
            (regalloc.compiler-reg-assignment-table-empty))]
        [result : be_state.ResultCompilerBackend
          (backend.compiler-backend-emit-indirect-call
            (ast.ast-node-pool-reader-type-segment-bases)
            target
            0
            (Var 1)
            (One (I64 3))
            (I64)
            assignments
            (regalloc.compiler-reg-var-types-empty)
            functions
            (ir.compiler-ir-extern-seq-empty)
            index
            2
            (cdiag.compiler-diagnostic-at-start "" "")
            index.backend-state)]
        [slot : String
          (be_scalar.compiler-backend-cycle-temp-slot-with-backend-state
            index.backend-state
            1)]
        (match result
          [(Ok asm)
            (let
              [callee-load : i64
                (let
                  [needle (str_cat.str-cat "    movq " arg-reg ", %r10\n")]
                  (backend.compiler-backend-string-find-from asm needle 0))]
              [save : i64
                (let
                  [needle (str_cat.str-cat "    movq %r10, " slot "\n")]
                  (backend.compiler-backend-string-find-from asm needle 0))]
              [arg-load : i64
                (let
                  [needle
                    (be_scalar.compiler-backend-emit-load-i64-immediate
                      3
                      arg-reg)]
                  (backend.compiler-backend-string-find-from asm needle 0))]
              [restore : i64
                (let
                  [needle (str_cat.str-cat "    movq " slot ", %r10\n")]
                  (backend.compiler-backend-string-find-from asm needle 0))]
              [call : i64
                (backend.compiler-backend-string-find-from
                  asm
                  "    call *(%r10)\n"
                  0)]
              ;; The callee can share the first explicit argument register.
              ;; Preserve it in a frame temp before staging that argument, then
              ;; reload it into the call-target scratch only after all args.
              (and
                (>= callee-load 0)
                (> save callee-load)
                (> arg-load save)
                (> restore arg-load)
                (> call restore)))]
          [(Err _) false]))]
    [(Err _) false]))

(define (compiler-backend-spilled-indirect-call-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (be_facts.compiler-backend-target-arg-reg target (Platform) 1)
    [(Ok arg-reg)
      (let
        [functions : ir.CompilerIrFunctionSeq
          (compiler-backend-known-function-call-functions)]
        [index : be_state.CompilerBackendProgramIndex
          (compiler-backend-known-function-call-index)]
        [assignments : regalloc.CompilerRegAssignmentTable
          (reg-homes "%1=spill:-16")]
        (match (backend.compiler-backend-emit-indirect-call
          (ast.ast-node-pool-reader-type-segment-bases)
          target
          0
          (Var 1)
          (One (I64 3))
          (I64)
          assignments
          (regalloc.compiler-reg-var-types-empty)
          functions
          (ir.compiler-ir-extern-seq-empty)
          index
          2
          (cdiag.compiler-diagnostic-at-start "" "")
          index.backend-state)
          [(Ok asm)
            (let
              [arg-load : i64
                (let
                  [needle
                    (be_scalar.compiler-backend-emit-load-i64-immediate
                      3
                      arg-reg)]
                  (backend.compiler-backend-string-find-from asm needle 0))]
              [callee-load : i64
                (backend.compiler-backend-string-find-from
                  asm
                  "    movq -16(%rbp), %r10\n"
                  0)]
              [call : i64
                (backend.compiler-backend-string-find-from
                  asm
                  "    call *(%r10)\n"
                  0)]
              (and
                (>= arg-load 0)
                (> callee-load arg-load)
                (> call callee-load)))]
          [(Err _) false]))]
    [(Err _) false]))

(define (compiler-backend-known-function-indirect-call-ok?) : bool
  (and
    (compiler-backend-known-function-indirect-call-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-known-function-indirect-call-target-ok?
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-dynamic-indirect-call-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-dynamic-indirect-call-target-ok?
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-overlapping-indirect-call-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-overlapping-indirect-call-target-ok?
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-spilled-indirect-call-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-spilled-indirect-call-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-export-symbol-source) : String
  "(define (exported [x : i64]) (:export-symbol \"tl_exported_value\") : i64
  (+ x 1))
(define (main) : i64
  (exported 41))")

(define (compiler-backend-export-symbol-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-export-symbol-source))
    [(Ok asm)
      (be_state.backend-and8
        (asm-has? asm ".globl tl_exported_value\n")
        (asm-has? asm "tl_exported_value:\n")
        (compiler-backend-call-or-jmp-ok? asm "tl_exported_value")
        (asm-lacks? asm ".extern tl_exported_value\n")
        (asm-lacks? asm ".globl _tl_exported\n")
        (asm-lacks? asm "_tl_exported:\n")
        (asm-has? asm "main:\n")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-export-symbol-fixed-fault-source) : String
  "(extern (tl_oob_abort) : never)
(define (oob-abort) (:export-symbol \"tl_oob_abort\") : never
  (tl_oob_abort))
(define (main) : i64 0)")

(define (compiler-backend-export-symbol-fixed-fault-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-source
      (compiler-backend-export-symbol-fixed-fault-source))
    (has ".globl tl_oob_abort\n" "tl_oob_abort:\n")
    (lacks ".extern tl_oob_abort\n")))

(define (compiler-backend-export-symbol-abort-string-source) : String
  "(extern (runtime-abort [message : String]) : never (:symbol \"tl_abort_string\"))
(define (abort-string [message : String]) (:export-symbol \"tl_abort_string\") : never
  (runtime-abort message))
(define (main) : i64 0)")

(define (compiler-backend-export-symbol-abort-string-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-source
      (compiler-backend-export-symbol-abort-string-source))
    (has ".globl tl_abort_string\n" "tl_abort_string:\n")
    (lacks ".extern tl_abort_string\n")))

(define (compiler-backend-duplicate-export-symbol-source) : String
  "(define (a) (:export-symbol \"dup_export\") : i64 1)
(define (b) (:export-symbol \"dup_export\") : i64 2)
(define (main) : i64 (+ (a) (b)))")

(define (compiler-backend-export-symbol-function-collision-source) : String
  "(define (normal) : i64 1)
(define (other) (:export-symbol \"_tl_normal\") : i64 2)
(define (main) : i64 (+ (normal) (other)))")

(define (compiler-backend-export-symbol-global-collision-source) : String
  "(define normal : i64 1)
(define (other) (:export-symbol \"_tl_normal\") : i64 2)
(define (main) : i64 (+ normal (other)))")

(define (compiler-backend-export-symbol-runtime-collision-source) : String
  "(define (own-alloc) (:export-symbol \"tl_alloc\") : i64 1)
(define (main) : i64 (own-alloc))")

(define (compiler-backend-export-symbol-stdlib-runtime-collision-source) : String
  "(define (own-int-to-string) (:export-symbol \"tl_int_to_string\") : String \"0\")
(define (main) : i64 (__tl_string_length (own-int-to-string)))")

(define (compiler-backend-export-symbol-main-source) : String
  "(define (main) (:export-symbol \"tl_not_main\") : i64 0)")

(define (compiler-backend-export-symbol-invalid-source) : String
  "(define (bad) (:export-symbol \"bad symbol\") : i64 1)
(define (main) : i64 (bad))")

(define (compiler-backend-export-symbol-extern-collision-source) : String
  "(extern (imported) : i64 (:symbol \"dup_link\"))
(define (exported) (:export-symbol \"dup_link\") : i64 42)
(define (main) : i64 (imported))")

(define (compiler-backend-export-symbol-diagnostics-ok?) : bool
  (and
    (be_state.backend-and4
      (compiler-backend-error-ok?
        (compiler-backend-duplicate-export-symbol-source)
        "backend: duplicate emitted function symbol dup_export")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-function-collision-source)
        "backend: duplicate emitted function symbol _tl_normal")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-global-collision-source)
        "backend: duplicate emitted function symbol _tl_normal")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-runtime-collision-source)
        "backend: exported function symbol collides with runtime symbol tl_alloc"))
    (be_state.backend-and4
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-main-source)
        "backend: main cannot use :export-symbol")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-invalid-source)
        "backend: invalid exported function symbol bad symbol")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-extern-collision-source)
        "backend: extern symbol collides with emitted symbol dup_link")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-stdlib-runtime-collision-source)
        "backend: exported function symbol collides with runtime symbol tl_int_to_string"))))

(define (compiler-backend-export-symbol-tests-ok?) : bool
  (and
    (compiler-backend-export-symbol-ok?)
    (compiler-backend-export-symbol-fixed-fault-ok?)
    (compiler-backend-export-symbol-abort-string-ok?)
    (compiler-backend-export-symbol-diagnostics-ok?)))

;; An executable program built directly in IR defines its own trivial `main`,
;; as a source fixture would: the backend synthesizes none (#7071).
(define (compiler-backend-test-main-function) : ir.CompilerIrFunction
  (Function
    (ci.intern "main")
    (ir.compiler-ir-param-seq-empty)
    (I64)
    0
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (compiler-backend-test-instr-seq-prepend
          (Return (Some (I64 0)))
          (ir.compiler-ir-instr-seq-empty))))
    Ordinary))

(define (compiler-backend-clean-module-symbol-collision-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (& (compiler-backend-test-main-function))
      (&
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              (ci.intern "pkg/a.tl::helper")
              (ir.compiler-ir-param-seq-empty)
              (I64)
              0
              (ir.compiler-ir-blocks
                (ir.CompilerIrBlock.Block
                  (ir.compiler-ir-label "entry")
                  (compiler-backend-test-instr-seq-prepend
                    (Return (Some (I64 1)))
                    (ir.compiler-ir-instr-seq-empty))))
              Ordinary))
          (&
            (ir.compiler-ir-function-seq-prepend
              (&
                (Function
                  (ci.intern "pkg_a.tl::helper")
                  (ir.compiler-ir-param-seq-empty)
                  (I64)
                  0
                  (ir.compiler-ir-blocks
                    (ir.CompilerIrBlock.Block
                      (ir.compiler-ir-label "entry")
                      (compiler-backend-test-instr-seq-prepend
                        (Return (Some (I64 2)))
                        (ir.compiler-ir-instr-seq-empty))))
                  Ordinary))
              (& (ir.compiler-ir-function-seq-empty)))))))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-clean-module-symbol-collision-ok?) : bool
  (match (backend.compiler-backend-emit-program-linux
    (compiler-backend-clean-module-symbol-collision-program))
    [(Err diag)
      (string.eq
        (cdiag.compiler-diagnostic-message (__tl-box-place diag))
        "backend: duplicate emitted function symbol _tl_pkg_a_helper")]
    [(Ok _) false]))

(define (compiler-backend-raw-pointer-fixture-shape-ok?) : bool
  (match (compiler-backend-raw-pointer-fixture-emit
    (be_state.CompilerBackendTarget.Linux))
    [(Ok asm)
      (be_state.backend-and8
        (or
          (>= (backend.compiler-backend-string-count asm ".globl _tl_f") 2)
          (asm-has? asm ".globl _tl_write_i64" ".globl _tl_read_i64"))
        (or (asm-has? asm "_tl_write_i64") (asm-has? asm "_tl_f"))
        (or
          (>= (backend.compiler-backend-string-count asm "    call _tl_f") 2)
          (asm-has? asm "    call _tl_write_i64" "    call _tl_read_i64"))
        (asm-has? asm "main:\n")
        (asm-has? asm "    call tl_alloc\n")
        (asm-has? asm "tl_alloc:")
        (asm-has? asm "    movq (%r10,%r8,8), %r9\n")
        (and
          (not
            (let
              [needle (compiler-backend-todo-marker)]
              (asm-has? asm needle)))
          (asm-lacks? asm "    movq (%r10), %rax\n")))]
    [(Err _) false]))

;; Backend emit-shape coverage for arena-owned boxes. `(box 42)`
;; allocates `size-of(i64)` = 8 bytes via `tl_alloc` and stores the boxed value
;; into that storage; a BoxGet AST node loads the value through the box pointer.
;; Boxes reuse the existing `tl_alloc` / pointer store/load paths (no new IR or
;; runtime), so this locks down that the allocation, store, and load shapes are
;; emitted with no `# TODO` placeholder.
(define (compiler-backend-box-source) : String
  "(define (main) : i64
  (let
    [b : (Box i64) (box 42)]
    (deref b)))")

(define (compiler-backend-box-ok?) : bool
  (match (backend.compiler-backend-emit-source (compiler-backend-box-source))
    [(Ok asm)
      (and
        (be_state.backend-and4
          ;; (box 42): allocate size-of(i64)=8 bytes for the box storage,
          (compiler-backend-string-contains-alloc-size? asm 8)
          ;; Store the boxed value through allocator-owned pointer/value homes.
          (asm-has? asm "    movq %r8, (%r10)\n")
          ;; BoxGet b: load the boxed value back through the box pointer.
          (asm-has? asm "    movq (%r10), %r8\n")
          (not
            (let
              [needle (compiler-backend-todo-marker)]
              (asm-has? asm needle))))
        (asm-lacks? asm "    movq %rax, (%r10)\n" "    movq (%r10), %rax\n"))]
    [(Err _) false]))

(define (compiler-backend-fast-alloc-next-load-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-source (compiler-backend-box-source))
    (has
      "    call .L_tl_alloc8\n"
      "    movq 16(%r9), %rax\n    leaq 8(%rax), %rcx\n")
    (lacks
      ".L_tl_alloc8:\n    movq %fs:tl_current_arena@tpoff, %r8\n    testq %r8, %r8\n    jz .L_tl_alloc8_slow\n    movq 40(%r8), %r9\n"
      "    movq %rax, %rcx\n    addq $8, %rcx\n")))

(define (compiler-backend-loop-alloc-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq1
      (&
        (Function
          cbi.compiler-builtin-id-fix-main
          (ir.compiler-ir-param-seq-empty)
          (I64)
          4
          (ir.compiler-ir-blocks
            ;; IR text assigns user symbol IDs. Bind these two allocator calls
            ;; to the actual runtime builtin.
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "entry")
              (ir.compiler-ir-instr-seq2
                (Call 0 cbi.compiler-builtin-id-tl-alloc (One (I64 16)) (U64))
                (irt.instr "jump header")))
            (irt.block
              "header:
               %1 = phi [0, entry], [%3, body] : i64
               branch %1, exit, body")
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "body")
              (compiler-backend-test-instr-seq-prepend
                (Call 2 cbi.compiler-builtin-id-tl-alloc (One (I64 24)) (U64))
                (irt.instrs
                  "%3 = add %1, 1 : i64
                         jump header")))
            (irt.block "exit:
               return %1"))
          Ordinary)))
    (ir.compiler-ir-extern-seq1
      (ir.compiler-ir-extern-default-id
        cbi.compiler-builtin-id-tl-alloc
        "tl_alloc"
        (U64)))
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-loop-alloc-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (backend.compiler-backend-emit-program-for-target
    (compiler-backend-loop-alloc-program)
    target)
    [(Ok asm)
      (and
        (compiler-backend-string-contains-inline-alloc-size? asm 24)
        (asm-has? asm "    call .L_tl_alloc16\n")
        (asm-lacks? asm "_slow:\n    call .L_tl_alloc16\n")
        (=
          (backend.compiler-backend-string-count asm "    call .L_tl_alloc24\n")
          1))]
    [(Err _) false]))

(define (compiler-backend-inline-fast-alloc-result-ok?) : bool
  (asm-ok?
    (compiler-backend-emit-alloc-instrs-for-target
      (ir.compiler-ir-instr-seq1
        (Call 0 cbi.compiler-builtin-id-tl-alloc (One (I64 16)) (U64)))
      (be_state.CompilerBackendTarget.Windows)
      true
      false)
    (has
      "    testb $1, 48(%r8)\n    jnz .L_tl_test_allocentry_i0_v0_slow\n    movq 56(%r8), %r9\n"
      "    movq 56(%r8), %r9\n    movq 16(%r9), %rax\n    leaq 16(%rax), %r8\n"
      "    cmpq 64(%r9), %r8\n    ja .L_tl_test_allocentry_i0_v0_slow\n    movq %r8, 16(%r9)\n")
    (lacks
      "    movq 16(%r8), %r10\n    addq $16, %r10\n"
      "    movq %rax, %r10\n    addq $16, %r10\n"
      "    movq %r8, 16(%r8)\n")))

(define (compiler-backend-inline-global-alloc-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (let
    [bound : String
      (match target
        [(Linux) "    cmpq 24(%r9), %r8\n"]
        [(Windows) "    cmpq 64(%r9), %r8\n"])]
    [slow : String
      (match target
        [(Linux) "_slow:\n    movl $16, %edi\n    call tl_alloc_global\n"]
        [(Windows) "_slow:\n    movl $16, %ecx\n    call tl_alloc_global\n"])]
    ;; An inline aggregate global keeps its static home (SPEC 5.10), so no
    ;; source store reaches the global allocator; its call is built directly.
    (asm-ok?
      (compiler-backend-emit-alloc-instrs-for-target
        (compiler-backend-test-instr-seq-prepend
          (Call 0 (ci.intern "tl_alloc_global") (One (I64 16)) (U64))
          (ir.compiler-ir-instr-seq-empty))
        target
        false
        false)
      (has
        "    movq .L_tl_global_aggregate_arena+56(%rip), %r9\n    movq 16(%r9), %rax\n"
        "_retry:\n    leaq 16(%rax), %r8\n"
        bound
        "    lock cmpxchgq %r8, 16(%r9)\n    jne "
        slow)
      (lacks "_slow:\n    call .L_tl_alloc16\n"))))

(define (compiler-backend-size-optimized-alloc-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (asm-ok?
    (compiler-backend-emit-alloc-instrs-for-target
      (ir.compiler-ir-instr-seq2
        (Call 0 cbi.compiler-builtin-id-tl-alloc (One (I64 16)) (U64))
        (Call 0 cbi.compiler-builtin-id-tl-alloc-global (One (I64 24)) (U64)))
      target
      true
      true)
    (has "    call .L_tl_alloc16\n" "    call tl_alloc_global\n")
    (lacks "    call .L_tl_alloc24\n" "_slow:\n" "    lock cmpxchgq")))

(define (compiler-backend-test-fixed-size-alloc
  [target : be_state.CompilerBackendTarget]) : unit
  (unless
    (compiler-backend-loop-alloc-target-ok? target)
    (io.panic "fixed-size allocations inline only in loop blocks"))
  (unless
    (compiler-backend-inline-global-alloc-target-ok? target)
    (io.panic
      "global container allocation must reserve atomically and grow through its private root"))
  (unless
    (compiler-backend-size-optimized-alloc-target-ok? target)
    (io.panic
      "size optimization must outline loop allocations and call the global allocator directly")))

(test
  backend-fixed-size-alloc
  (cbi.compiler-builtin-initialize-for-parse!)
  (compiler-backend-test-fixed-size-alloc
    (be_state.CompilerBackendTarget.Linux))
  (compiler-backend-test-fixed-size-alloc
    (be_state.CompilerBackendTarget.Windows)))

(define (compiler-backend-fast-alloc-gate-ok?) : bool
  (and
    (= (be_calls.compiler-backend-fast-alloc-size (One (I64 1))) 8)
    (= (be_calls.compiler-backend-fast-alloc-size (One (I64 8))) 8)
    (= (be_calls.compiler-backend-fast-alloc-size (One (I64 9))) 16)
    (= (be_calls.compiler-backend-fast-alloc-size (One (I64 64))) 64)
    (= (be_calls.compiler-backend-fast-alloc-size (One (I64 65))) 0)
    (= (be_calls.compiler-backend-fast-alloc-size (One (I64 0))) 0)
    (= (be_calls.compiler-backend-fast-alloc-size (One (Var 0))) 0)
    (be_calls.compiler-backend-fast-alloc-supported-size? 8)
    (be_calls.compiler-backend-fast-alloc-supported-size? 24)
    (be_calls.compiler-backend-fast-alloc-supported-size? 40)
    (be_calls.compiler-backend-fast-alloc-supported-size? 64)
    (not (be_calls.compiler-backend-fast-alloc-supported-size? 0))
    (not (be_calls.compiler-backend-fast-alloc-supported-size? 10))
    (not (be_calls.compiler-backend-fast-alloc-supported-size? 72))))

(define (compiler-backend-inline-fast-alloc-reused-vreg-instrs) : ir.CompilerIrInstrSeq
  (compiler-backend-test-instr-seq-prepend
    (Call 0 (ci.intern "tl_alloc") (One (I64 8)) (U64))
    (compiler-backend-test-instr-seq-prepend
      (Call 0 (ci.intern "tl_alloc") (One (I64 8)) (U64))
      (ir.compiler-ir-instr-seq-empty))))

;; Optimizer cloning may retain a destination vreg. Exercise that shape
;; directly so the regression stays two instructions instead of depending on
;; the source size that happened to expose it in compiler_backend_tests.tl.
(define (compiler-backend-inline-fast-alloc-reused-vreg-labels-ok?) : bool
  (match (compiler-backend-emit-alloc-instrs-for-target
    (compiler-backend-inline-fast-alloc-reused-vreg-instrs)
    (be_state.CompilerBackendTarget.Linux)
    true
    false)
    [(Ok asm)
      (be_state.backend-and4
        (asm-has? asm ".L_tl_test_allocentry_i0_v0_slow:\n")
        (asm-has? asm ".L_tl_test_allocentry_i1_v0_slow:\n")
        (asm-has? asm ".L_tl_test_allocentry_i0_v0_done:\n")
        (asm-has? asm ".L_tl_test_allocentry_i1_v0_done:\n"))]
    [(Err _) false]))

;; Single-instruction emission fixtures bypass placement. Seed the same
;; membership that placement would record for their loop block.
(define (compiler-backend-test-mark-entry-loop!
  [state : be_state.CompilerBackendFunctionState]) : unit
  (let
    [labels : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    (set! (array-ref labels 0) (ir.compiler-ir-label "entry"))
    (be_state.compiler-backend-function-scratch-set-i64-array!
      state
      be_state.compiler-backend-scratch-i64-array-loop-block-labels
      labels)
    (be_state.compiler-backend-function-scratch-set-i64!
      state
      be_state.compiler-backend-scratch-i64-loop-block-count
      1)))

;; Emits `instrs` as the one block of a test function returning u64.
(define (compiler-backend-emit-alloc-instrs-for-target
  [instrs : ir.CompilerIrInstrSeq]
  [target : be_state.CompilerBackendTarget]
  [loop-block? : bool]
  [optimize-for-size? : bool]) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [saved : EmitterScratch (emitter-scratch-save backend-state)]
    [prev-current-site : i64 (state-emit-current-site backend-state)]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (owned_view.compiler-owned-shared-view instrs)))]
    [_position : unit
      (begin
        (be_state.compiler-backend-state-set-optimize-for-size!
          backend-state
          optimize-for-size?)
        (when
          loop-block?
          (compiler-backend-test-mark-entry-loop!
            (be_state.compiler-backend-state-function-state backend-state)))
        (compiler-backend-test-scavenge-install-ctx!
          "_tl_test"
          (ir.compiler-ir-param-seq-empty)
          (U64)
          1
          blocks
          (regalloc.compiler-reg-assignment-table-empty)
          backend-state)
        (set-state-emit-instr-post-base! backend-state count)
        (set-state-emit-current-count! backend-state count)
        (set-state-emit-current-site! backend-state 0))]
    [result : be_state.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        (regalloc.compiler-reg-assignment-table-empty)
        1
        target
        backend-state)]
    (emitter-scratch-restore! backend-state saved)
    (set-state-emit-current-site! backend-state prev-current-site)
    result))

(define (compiler-backend-outlined-fast-alloc-multi-size-source) : String
  "(define (make3 [x : i64]) : (Box (Tuple i64 i64 i64))
  (box (tuple x (+ x 1) (+ x 2))))

(define (make5 [x : i64]) : (Box (Tuple i64 i64 i64 i64 i64))
  (box (tuple x (+ x 1) (+ x 2) (+ x 3) (+ x 4))))

(define (main) : i64
  (let
    [a : (Box (Tuple i64 i64 i64)) (make3 10)]
    [b : (Box (Tuple i64 i64 i64 i64 i64)) (make5 20)]
    (+ (tuple-ref (deref a) 2) (tuple-ref (deref b) 4))))")

(define (compiler-backend-outlined-fast-alloc-multi-size-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-outlined-fast-alloc-multi-size-source)
    target)
    [(Ok asm)
      (and
        (asm-has? asm "    call .L_tl_alloc24\n" "    call .L_tl_alloc40\n")
        (asm-lacks? asm "_slow:\n    call .L_tl_alloc" "    call tl_alloc\n"))]
    [(Err _) false]))

(define (compiler-backend-outlined-fast-alloc-multi-size-ok?) : bool
  (and
    (compiler-backend-outlined-fast-alloc-multi-size-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-outlined-fast-alloc-multi-size-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-outlined-alloc-alias-case-ok?
  [target : be_state.CompilerBackendTarget]
  [result-type : String]
  [symbol : String]
  [abi : String]
  [size : i64]
  [expected : i64]) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (str_cat.str-cat
      "(extern (tl_alloc [bytes : i64]) : u64)\n(extern (reserve [bytes : i64]) : "
      result-type
      abi
      (str_cat.str-cat
        " (:symbol \""
        symbol
        "\"))\n(define (main) : i64 (begin (tl_alloc 128) (reserve "
        (str_cat.str-cat (string.int->string size) ") 42))")))
    target)
    [(Ok asm)
      (if (> expected 0)
        (asm-has? asm (compiler-backend-alloc-fixed-call-text expected))
        (=
          (compiler-backend-alloc-call-count asm)
          (backend.compiler-backend-string-count asm "    call tl_alloc\n")))]
    [(Err _) false]))

(define (compiler-backend-outlined-alloc-alias-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (and
    (compiler-backend-outlined-alloc-alias-case-ok?
      target
      "(MutPtr u8)"
      "tl_alloc"
      ""
      1
      8)
    (compiler-backend-outlined-alloc-alias-case-ok?
      target
      "(MutPtr i64)"
      "tl_alloc"
      ""
      24
      24)
    (compiler-backend-outlined-alloc-alias-case-ok?
      target
      "(MutPtr u8)"
      "tl_alloc"
      " (:abi c)"
      63
      64)
    (compiler-backend-outlined-alloc-alias-case-ok?
      target
      "(MutPtr u8)"
      "tl_alloc"
      ""
      0
      0)
    (compiler-backend-outlined-alloc-alias-case-ok?
      target
      "(MutPtr u8)"
      "tl_alloc"
      ""
      65
      0)
    (compiler-backend-outlined-alloc-alias-case-ok?
      target
      "(MutPtr u8)"
      "unrelated_allocator"
      ""
      24
      0)
    (compiler-backend-outlined-alloc-alias-case-ok?
      target
      "u64"
      "tl_alloc"
      ""
      24
      0)
    (compiler-backend-outlined-alloc-alias-case-ok?
      target
      "f64"
      "tl_alloc"
      " (:abi c)"
      24
      0)))

(define (compiler-backend-outlined-alloc-alias-ok?) : bool
  (and
    (compiler-backend-outlined-alloc-alias-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-outlined-alloc-alias-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define compiler-backend-inline-fast-alloc-emergency-live-count : i64
  13)

(define (compiler-backend-inline-fast-alloc-emergency-regs) : (__tl_dyn-array
    i64)
  (let
    [regs : (__tl_dyn-array i64)
      (__tl_make-array
        i64
        compiler-backend-inline-fast-alloc-emergency-live-count)]
    (set! (array-ref regs 0) cabi.compiler-reg-id-r9)
    (set! (array-ref regs 1) cabi.compiler-reg-id-rcx)
    (set! (array-ref regs 2) cabi.compiler-reg-id-rdx)
    (set! (array-ref regs 3) cabi.compiler-reg-id-r10)
    (set! (array-ref regs 4) cabi.compiler-reg-id-r11)
    (set! (array-ref regs 5) cabi.compiler-reg-id-r8)
    (set! (array-ref regs 6) cabi.compiler-reg-id-r12)
    (set! (array-ref regs 7) cabi.compiler-reg-id-r13)
    (set! (array-ref regs 8) cabi.compiler-reg-id-r14)
    (set! (array-ref regs 9) cabi.compiler-reg-id-r15)
    (set! (array-ref regs 10) cabi.compiler-reg-id-rbx)
    (set! (array-ref regs 11) cabi.compiler-reg-id-rsi)
    (set! (array-ref regs 12) cabi.compiler-reg-id-rdi)
    regs))

(define (compiler-backend-inline-fast-alloc-emergency-assignments-from
  [regs : (__tl_dyn-array i64)]
  [index : i64]) : regalloc.CompilerRegAssignmentTable
  (if (>= index (array-length regs))
    (regalloc.compiler-reg-assignment-table-empty)
    (regalloc.compiler-reg-assignments-prepend
      (&
        (regalloc.CompilerRegAssignment index (Register (array-ref regs index))))
      (compiler-backend-inline-fast-alloc-emergency-assignments-from
        regs
        (+ index 1)))))

(define (compiler-backend-inline-fast-alloc-emergency-assignments) : regalloc.CompilerRegAssignmentTable
  (compiler-backend-inline-fast-alloc-emergency-assignments-from
    (compiler-backend-inline-fast-alloc-emergency-regs)
    0))

(define (compiler-backend-inline-fast-alloc-emergency-instrs) : ir.CompilerIrInstrSeq
  (let
    [instrs : ir.CompilerIrInstrSeq (ir.compiler-ir-instr-seq-empty)]
    [v : i64 (- compiler-backend-inline-fast-alloc-emergency-live-count 1)]
    (while (>= v 0)
      (set!
        instrs
        (compiler-backend-test-instr-seq-prepend
          (Mov (+ 30 v) (Var v) (I64))
          instrs))
      (-= v 1))
    (compiler-backend-test-instr-seq-prepend
      (Call 20 (ci.intern "tl_alloc") (One (I64 8)) (U64))
      instrs)))

(define (compiler-backend-inline-fast-alloc-emergency-asm) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [saved : EmitterScratch (emitter-scratch-save backend-state)]
    [prev-emergency-pending : bool
      (scratch-emergency-pending
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-reg : i64
      (scratch-emergency-reg
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-used : bool
      (scratch-emergency-used
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-pending-count : i64
      (scratch-emergency-pending-count
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-used-count : i64
      (scratch-emergency-used-count
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-slot-offset : i64
      (scratch-emergency-slot-offset
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-restore-suppressed : bool
      (scratch-emergency-restore-suppressed
        (be_state.compiler-backend-state-function-state backend-state))]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-inline-fast-alloc-emergency-assignments)]
    [instrs : ir.CompilerIrInstrSeq
      (compiler-backend-inline-fast-alloc-emergency-instrs)]
    [count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (owned_view.compiler-owned-shared-view instrs)))]
    [_ctx : unit
      (begin
        (compiler-backend-test-mark-entry-loop!
          (be_state.compiler-backend-state-function-state backend-state))
        (compiler-backend-test-scavenge-install-ctx!
          "inline_fast_alloc_emergency"
          (ir.compiler-ir-param-seq-empty)
          (I64)
          50
          blocks
          assignments
          backend-state)
        (set-state-emit-instr-post-base! backend-state count)
        (set-state-emit-current-count! backend-state count)
        (set-scratch-emergency-pending!
          (be_state.compiler-backend-state-function-state backend-state)
          false)
        (set-scratch-emergency-reg!
          (be_state.compiler-backend-state-function-state backend-state)
          cabi.compiler-reg-id-invalid)
        (set-scratch-emergency-used!
          (be_state.compiler-backend-state-function-state backend-state)
          false)
        (set-scratch-emergency-pending-count!
          (be_state.compiler-backend-state-function-state backend-state)
          0)
        (set-scratch-emergency-used-count!
          (be_state.compiler-backend-state-function-state backend-state)
          0)
        (set-scratch-emergency-slot-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          -512)
        (set-scratch-emergency-restore-suppressed!
          (be_state.compiler-backend-state-function-state backend-state)
          false))]
    [result : be_state.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        50
        (be_state.CompilerBackendTarget.Linux)
        backend-state)]
    [_restore : unit
      (begin
        (emitter-scratch-restore! backend-state saved)
        (set-scratch-emergency-pending!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-emergency-pending)
        (set-scratch-emergency-reg!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-emergency-reg)
        (set-scratch-emergency-used!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-emergency-used)
        (set-scratch-emergency-pending-count!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-emergency-pending-count)
        (set-scratch-emergency-used-count!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-emergency-used-count)
        (set-scratch-emergency-slot-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-emergency-slot-offset)
        (set-scratch-emergency-restore-suppressed!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-emergency-restore-suppressed))]
    result))

(define (compiler-backend-inline-fast-alloc-emergency-preserved-ok?) : bool
  (match (compiler-backend-inline-fast-alloc-emergency-asm)
    [(Ok asm)
      (and
        (be_state.backend-and8
          (asm-has? asm "    movq %r9, -512(%rbp)\n")
          (asm-has? asm "    movq -512(%rbp), %r9\n")
          (asm-has? asm "    movq %rcx, -576(%rbp)\n")
          (asm-has? asm "    movq -576(%rbp), %rcx\n")
          (asm-lacks? asm "    movq %rdx, -640(%rbp)\n")
          (asm-has?
            asm
            "    movq %fs:tl_current_arena@tpoff, %r9\n    testb $1, 48(%r9)\n    jnz .L_tl_test_allocentry_i0_v20_slow\n    movq 56(%r9), %rcx\n")
          (asm-has? asm "    movq 16(%rcx), %rax\n    leaq 8(%rax), %r9\n")
          (asm-has?
            asm
            "    cmpq 24(%rcx), %r9\n    ja .L_tl_test_allocentry_i0_v20_slow\n    movq %r9, 16(%rcx)\n"))
        (be_state.backend-and8
          (asm-has? asm "    call .L_tl_alloc8\n")
          (asm-has? asm "    movq tl_profile_alloc_live_bytes(%rip), %r9\n")
          (asm-has? asm "    cmpq tl_profile_alloc_peak_bytes(%rip), %r9\n")
          (asm-lacks? asm "tl_profile_alloc_live_bytes(%rip), %rcx")
          (asm-lacks? asm "%rcx, tl_profile_alloc_peak_bytes(%rip)")
          (asm-lacks? asm "    movq %fs:tl_current_arena@tpoff, %r8\n")
          (asm-lacks? asm "    leaq 8(%rax), %r8\n")
          (asm-lacks? asm "    leaq 8(%rax), %rax\n"))
        (asm-lacks?
          asm
          "    testq %r9, %r9\n    jz .L_tl_test_allocentry_i0_v20_slow\n"))]
    [(Err _) false]))

;; Backend emit-shape coverage for local tuple construction/ref.
;; `(tuple true 42)` reserves inline frame storage without allocating (#7070),
;; materializes/stores the bool byte and i64 at their offsets, and
;; `(tuple-ref t 1)` loads the i64 slot back.
(define (compiler-backend-tuple-source) : String
  "(define (main) : i64
  (let
    [t : (Tuple bool i64) (tuple true 42)]
    (tuple-ref t 1)))")

(define (compiler-backend-tuple-ok?) : bool
  (match (backend.compiler-backend-emit-source (compiler-backend-tuple-source))
    [(Ok asm)
      (and
        (= (compiler-backend-alloc-call-count asm) 0)
        (asm-lacks? asm "_allocentry_")
        (be_state.backend-and8
          (asm-has? asm "(%rsp), %r8\n    movq %r8, ")
          (asm-has? asm "    movq $1,")
          (asm-has? asm "    movb %r8b, (%r10)\n")
          (asm-has? asm "    movq $42,")
          (asm-has? asm "    movq %r8, 8(%r10)\n")
          (asm-has? asm "    movq 8(%r10), %r8\n")
          (asm-lacks? asm "    movb %al, (%r10)\n")
          (asm-lacks? asm "    movq %rax, 8(%r10)\n"))
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-inline-struct-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (lower_tests.compiler-lower-inline-struct-source))
    [(Ok asm)
      (be_state.backend-and4
        (= (backend.compiler-backend-string-count asm "    call tl_alloc\n") 0)
        (asm-has? asm "    leaq -")
        (asm-has? asm "main:\n")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-inline-enum-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (lower_tests.compiler-lower-inline-enum-source))
    [(Ok asm)
      (be_state.backend-and4
        (= (backend.compiler-backend-string-count asm "    call tl_alloc\n") 0)
        (asm-has? asm "    leaq -")
        (asm-has? asm ".Lf0_match_arm.")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-inline-boxed-recursive-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (lower_tests.compiler-lower-inline-boxed-recursive-source))
    [(Ok asm)
      (be_state.backend-and4
        (= (compiler-backend-alloc-call-count asm) 2)
        ;; Both boxed leaves heap-allocate a full inline Tree value: tag (8)
        ;; plus the largest variant payload Branch((Box Tree), (Box Tree)) =
        ;; 16, so 24 bytes. With default-inline aggregates each box holds the
        ;; inline value, not an 8-byte handle.
        (compiler-backend-string-contains-alloc-size? asm 24)
        (asm-has? asm "    leaq -")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-inline-hot-loop-struct-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (lower_tests.compiler-lower-inline-hot-loop-struct-source))
    [(Ok asm)
      ;; The loop's 16-byte `Pair` is now a register-resident group (built
      ;; and read in registers), so the loop body neither heap-allocates nor needs
      ;; a stack-slot address for it.
      (be_state.backend-and4
        (= (backend.compiler-backend-string-count asm "    call tl_alloc\n") 0)
        (asm-has? asm "main:\n")
        true
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-inline-aggregate-call-source) : String
  "(defstruct Color (r u8) (g u8) (b u8) (a u8))
(defenum Swatch (Empty) (Paint Color))
(define (make-color) : Color
  (Color (cast 5 : u8) (cast 7 : u8) (cast 11 : u8) (cast 13 : u8)))
(define (id-color [c : Color]) : Color c)
(define (use-color [c : Color]) : i64
  (+
    (cast c.r : i64)
    (+
      (cast c.g : i64)
      (+ (cast c.b : i64) (cast c.a : i64)))))
(define (id-swatch [s : Swatch]) : Swatch s)
(define (score-swatch [s : Swatch]) : i64
  (match s
    [Empty 0]
    [(Paint c) (use-color c)]))
(define (main) : i64
  (let
    [c : Color (id-color (make-color))]
    [s : Swatch (id-swatch (Paint c))]
    (if (= (use-color c) 36)
      (if (= (score-swatch s) 36) 42 2)
      1)))")

(define (compiler-backend-inline-aggregate-call-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-inline-aggregate-call-source)
    target)
    [(Ok asm)
      (be_state.backend-and4
        (asm-has? asm "main:\n")
        (>= (backend.compiler-backend-string-count asm "    call ") 6)
        ;; sret ABI: aggregate args/returns pass by caller slot pointer
        ;; and inline construction is stack storage -- no arena allocation.
        (= (compiler-backend-alloc-call-count asm) 0)
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-inline-aggregate-call-ok?) : bool
  (and
    (compiler-backend-inline-aggregate-call-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-inline-aggregate-call-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-inline-aggregate-copy-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-inline-aggregates-for-target
    (lower_tests.compiler-lower-inline-aggregate-copy-source)
    target)
    [(Ok asm)
      ;; `Pair` is a 16-byte all-integer struct, so it is register-resident
      ;; -- `id-pair` is a register-pair passthrough that carries both words in
      ;; registers end-to-end. The function is still emitted, but it does NOT do
      ;; the pointer-load / pointer-store byte-copy ("(%r11), %rax" then
      ;; "%rax, (%r10)") that a memory aggregate required.
      (be_state.backend-and4
        (asm-has? asm "id_pair")
        (asm-lacks? asm "(%r11), %rax")
        (asm-lacks? asm "%rax, (%r10)")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-inline-aggregate-copy-ok?) : bool
  (and
    (compiler-backend-inline-aggregate-copy-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-inline-aggregate-copy-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-inline-aggregate-storage-ok?) : bool
  (and
    (compiler-backend-inline-struct-ok?)
    (compiler-backend-inline-enum-ok?)
    (compiler-backend-inline-boxed-recursive-ok?)
    (compiler-backend-inline-aggregate-call-ok?)
    (compiler-backend-inline-aggregate-copy-ok?)
    (compiler-backend-inline-hot-loop-struct-ok?)))

(define (compiler-backend-test-mode-scalar?
  [mode : be_state.CompilerBackendMode]) : bool
  (match mode
    [(Scalar) true]
    [_ false]))

(define (compiler-backend-test-mode-avx2? [mode : be_state.CompilerBackendMode]) : bool
  (match mode
    [(Avx2) true]
    [_ false]))

(define (compiler-backend-test-mode-avx512?
  [mode : be_state.CompilerBackendMode]) : bool
  (match mode
    [(Avx512) true]
    [_ false]))

(define (compiler-backend-defdispatch-source) : String
  "(define (dot-scalar [x : i64]) : i64 x)
(define (dot-avx2 [x : i64]) : i64 (+ x 2))
(define (dot-avx512 [x : i64]) : i64 (+ x 5))
(defdispatch dot (scalar dot-scalar) (avx2 dot-avx2) (avx512 dot-avx512))
(define (main) : i64 (dot 40))")

(define (compiler-backend-defdispatch-thunk-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-defdispatch-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (asm-has? asm "__tl_dispatch_cache_dot")
          (asm-has? asm "__tl_dispatch_variant_avx2")
          (asm-has? asm "__tl_dispatch_variant_avx512")
          (asm-has? asm "    cpuid\n")
          (asm-has? asm "    xgetbv\n")
          (asm-has? asm "    call *(%r10)\n")
          (asm-has? asm "    vzeroupper\n")
          (asm-has? asm "main:\n"))
        (asm-has?
          asm
          "    lock cmpxchgq "
          "    .comm _tl___tl_dispatch_cache_dot, 8, 8\n")
        (not
          (let
            [needle (compiler-backend-todo-marker)]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-dispatch-variant-mode-ok?) : bool
  (and
    (be_state.backend-and4
      (compiler-backend-test-mode-avx2?
        (be_simd.compiler-backend-effective-mode-for-function-name
          (Scalar)
          "__tl_dispatch_variant_avx2_dot__dot-avx2"))
      (compiler-backend-test-mode-avx512?
        (be_simd.compiler-backend-effective-mode-for-function-name
          (Scalar)
          "__tl_dispatch_variant_avx512_dot__dot-avx512"))
      (compiler-backend-test-mode-scalar?
        (be_simd.compiler-backend-effective-mode-for-function-name
          (Scalar)
          "__tl_dispatch_variant_scalar_dot__dot-scalar"))
      (compiler-backend-test-mode-avx2?
        (be_simd.compiler-backend-effective-mode-for-function-name
          (Avx2)
          "ordinary")))
    (compiler-backend-defdispatch-thunk-ok?)))

(define (compiler-backend-signature-i64-to-i64?
  [sig : be_state.CompilerBackendMaybeSignature]) : bool
  (match sig
    [(Some args ret-ty)
      (match ret-ty
        [(I64)
          (and
            (= (ast.ast-type-list-len (& args)) 1)
            (match (ast.ast-node-pool-reader-type-get
              (ast.ast-type-list-get (& args) 0 (ast.ast-type-id-fallback)))
              [(I64) true]
              [_ false]))]
        [_ false])]
    [(No) false]))

(define (compiler-backend-signature-unit-to-i64?
  [sig : be_state.CompilerBackendMaybeSignature]) : bool
  (match sig
    [(Some args ret-ty)
      (and
        (ast.ast-type-list-empty? (& args))
        (match ret-ty
          [(I64) true]
          [_ false]))]
    [(No) false]))

(define (compiler-backend-program-index-test-functions) : ir.CompilerIrFunctionSeq
  (ir.compiler-ir-function-seq-prepend
    (&
      (Function
        (ci.intern "pkg/really-long-backend-index-function")
        (ir.compiler-ir-param-seq-prepend
          (Param "x" (I64) 0)
          (ir.compiler-ir-param-seq-empty))
        (I64)
        1
        (ir.compiler-ir-block-list-empty)
        Ordinary))
    (&
      (ir.compiler-ir-function-seq-prepend
        (&
          (Function
            (ci.intern "short_fn")
            (ir.compiler-ir-param-seq-empty)
            (Unit)
            0
            (ir.compiler-ir-block-list-empty)
            Ordinary))
        (& (ir.compiler-ir-function-seq-empty))))))

(define (compiler-backend-program-index-test-externs
  [provided-id : i64]
  [provided-link-id : i64]
  [referenced-id : i64]
  [referenced-link-id : i64]) : ir.CompilerIrExternSeq
  (ir.compiler-ir-extern-seq2
    (Extern
      provided-id
      provided-id
      "provided_decl"
      (ast.ast-ty-func (ast.ast-type-list-new) (& (I64)))
      (C)
      provided-link-id
      (ast.ast-extern-link-input-list-new)
      true
      (ir.CompilerIrReturnStorage.None)
      false
      (ir.CompilerIrGlobalStorage.Word))
    (Extern
      referenced-id
      referenced-id
      "referenced_decl"
      (ast.ast-ty-func
        (ast.ast-type-cons (& (I64)) (& (ast.ast-type-list-new)))
        (& (I64)))
      (C)
      referenced-link-id
      (ast.ast-extern-link-input-list-new)
      false
      (ir.CompilerIrReturnStorage.None)
      false
      (ir.CompilerIrGlobalStorage.Word))))

;; A backend job owns one exact intern capability and one cache arena.  Keep a
;; compact one-word smoke here so the state boundary itself is exercised before
;; any larger program-index fixture runs.
(define (compiler-backend-state-render-cache-storage-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [intern-a : ci.InternCompatState (ci.intern-compat-state-new)]
    [intern-b : ci.InternCompatState (ci.intern-compat-state-new)]
    [state-a : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-a)]
    [state-b : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-b)]
    [fresh-a : bool
      (and
        (= (be_state.compiler-backend-state-lazy-table-arena state-a) 0)
        (= (be_state.compiler-backend-state-slot-cache-capacity state-a) 0)
        (=
          (be_state.compiler-backend-state-frame-offset-cache-capacity state-a)
          0)
        (= (be_state.compiler-backend-state-immediate-cache-capacity state-a) 0)
        (=
          (be_state.compiler-backend-state-operand-cache-retained-bytes state-a)
          0)
        (= (compiler-backend-state-slot-cache-epoch state-a) 1))]
    [fresh-b : bool
      (and
        (= (be_state.compiler-backend-state-lazy-table-arena state-b) 0)
        (= (be_state.compiler-backend-state-slot-cache-capacity state-b) 0)
        (=
          (be_state.compiler-backend-state-frame-offset-cache-capacity state-b)
          0)
        (= (be_state.compiler-backend-state-immediate-cache-capacity state-b) 0)
        (=
          (be_state.compiler-backend-state-operand-cache-retained-bytes state-b)
          0)
        (= (compiler-backend-state-slot-cache-epoch state-b) 1))]
    [scratch : arena.Arena (arena.make)]
    [_set-scratch : unit
      (unsafe
        (arena.set! scratch))]
    [_reset-a : unit
      (be_facts.compiler-backend-state-slot-cache-reset! state-a)]
    [_reset-b : unit
      (be_facts.compiler-backend-state-slot-cache-reset! state-b)]
    [reset-empty : bool
      (and
        (= (be_state.compiler-backend-state-slot-cache-capacity state-a) 0)
        (=
          (be_state.compiler-backend-state-frame-offset-cache-capacity state-a)
          0)
        (= (be_state.compiler-backend-state-immediate-cache-capacity state-a) 0)
        (= (be_state.compiler-backend-state-slot-cache-capacity state-b) 0)
        (=
          (be_state.compiler-backend-state-frame-offset-cache-capacity state-b)
          0)
        (= (be_state.compiler-backend-state-immediate-cache-capacity state-b) 0))]
    [a-slot : String
      (be_operand.compiler-backend-slot-with-backend-state state-a 3)]
    [a-frame : String
      (be_operand.compiler-backend-frame-offset-with-backend-state state-a -40)]
    [b-immediate : String
      (be_operand.compiler-backend-state-immediate-render state-b 7)]
    [a-lazy : i64 (be_state.compiler-backend-state-lazy-table-arena state-a)]
    [b-lazy : i64 (be_state.compiler-backend-state-lazy-table-arena state-b)]
    [b-epoch-before-a-reset : i64
      (compiler-backend-state-slot-cache-epoch state-b)]
    [after-render : bool
      (and
        (string.eq a-slot "-32(%rbp)")
        (string.eq a-frame "-40(%rbp)")
        (string.eq b-immediate "$7")
        (= (be_state.compiler-backend-state-slot-cache-capacity state-a) 16384)
        (=
          (be_state.compiler-backend-state-frame-offset-cache-capacity state-a)
          16384)
        (= (be_state.compiler-backend-state-immediate-cache-capacity state-a) 0)
        (=
          (be_state.compiler-backend-state-operand-cache-retained-bytes state-a)
          524288)
        (= (be_state.compiler-backend-state-slot-cache-capacity state-b) 0)
        (=
          (be_state.compiler-backend-state-frame-offset-cache-capacity state-b)
          0)
        (=
          (be_state.compiler-backend-state-immediate-cache-capacity state-b)
          8192)
        (=
          (be_state.compiler-backend-state-operand-cache-retained-bytes state-b)
          131072)
        (> a-lazy 0)
        (> b-lazy 0)
        (not (= a-lazy b-lazy)))]
    [_reset-a-again : unit
      (be_facts.compiler-backend-state-slot-cache-reset! state-a)]
    [a-epoch-after-reset : i64
      (compiler-backend-state-slot-cache-epoch state-a)]
    [b-immediate-again : String
      (be_operand.compiler-backend-state-immediate-render state-b 7)]
    [b-unchanged : bool
      (and
        (=
          (compiler-backend-state-slot-cache-epoch state-b)
          b-epoch-before-a-reset)
        (= (be_state.compiler-backend-state-slot-cache-capacity state-b) 0)
        (=
          (be_state.compiler-backend-state-frame-offset-cache-capacity state-b)
          0)
        (=
          (be_state.compiler-backend-state-immediate-cache-capacity state-b)
          8192)
        (=
          (be_state.compiler-backend-state-operand-cache-retained-bytes state-b)
          131072))]
    [_restore-caller : unit
      (unsafe
        (arena.set! caller))]
    [_destroy-scratch : unit
      (unsafe
        (arena.destroy scratch))]
    [active-after : arena.Arena (arena.current)]
    (and
      fresh-a
      fresh-b
      reset-empty
      after-render
      (= a-epoch-after-reset 3)
      b-unchanged
      (string.eq a-slot "-32(%rbp)")
      (string.eq a-frame "-40(%rbp)")
      (string.eq b-immediate "$7")
      (string.eq b-immediate-again b-immediate)
      (arena.eq? active-after caller))))

(define (compiler-backend-state-one-word-ok?) : bool
  (let
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [name-id : i64
      (ci.intern-compat-state-intern (&mut intern-state) "one_word_state")]
    [pool-len : i64 (ci.intern-compat-state-pool-len intern-state)]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-state))]
    [before-capacity : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    [before-bytes : i64
      (be_state.compiler-backend-state-user-symbol-cache-retained-bytes
        backend-state)]
    [before-emission-arena : i64
      (be_state.compiler-backend-state-emission-arena backend-state)]
    [state-size : i64 (be_state.compiler-backend-state-size)]
    [symbol : String
      (be_state.compiler-backend-state-user-symbol-id backend-state name-id)]
    (and
      (= pool-len 1)
      (= before-capacity 0)
      (= before-bytes 0)
      (= before-emission-arena 0)
      (= state-size 8)
      (not
        (be_state.compiler-backend-state-scalar-registers-enabled?
          backend-state))
      (string.eq symbol "_tl_one_word_state")
      (=
        (be_state.compiler-backend-state-user-symbol-cache-count backend-state)
        1)
      (=
        (be_state.compiler-backend-state-user-symbol-cache-capacity
          backend-state)
        16)
      (=
        (be_state.compiler-backend-state-user-symbol-cache-retained-bytes
          backend-state)
        512)
      (> (be_state.compiler-backend-state-owner-arena backend-state) 0)
      (=
        (be_state.compiler-backend-state-intern-table-id backend-state)
        (ci.intern-compat-state-table-id intern-state)))))

;; Twelve inserts fill the initial 16-slot cache below its 75% threshold;
;; the thirteenth forces a 16 -> 32 rehash.  Keep the same state for all
;; lookups so this also checks that rehash preserves old and newest entries.
(define (compiler-backend-user-symbol-cache-growth-ok?) : bool
  (let
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [id-a : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_a")]
    [id-b : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_b")]
    [id-c : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_c")]
    [id-d : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_d")]
    [id-e : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_e")]
    [id-f : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_f")]
    [id-g : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_g")]
    [id-h : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_h")]
    [id-i : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_i")]
    [id-j : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_j")]
    [id-k : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_k")]
    [id-l : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_l")]
    [id-m : i64 (ci.intern-compat-state-intern (&mut intern-state) "growth_m")]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [before-capacity : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    [before-bytes : i64
      (be_state.compiler-backend-state-user-symbol-cache-retained-bytes
        backend-state)]
    [before-count : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [symbol-a : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-a)]
    [_symbol-b : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-b)]
    [_symbol-c : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-c)]
    [_symbol-d : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-d)]
    [_symbol-e : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-e)]
    [_symbol-f : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-f)]
    [_symbol-g : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-g)]
    [_symbol-h : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-h)]
    [_symbol-i : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-i)]
    [_symbol-j : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-j)]
    [_symbol-k : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-k)]
    [_symbol-l : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-l)]
    [after-twelve-count : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [after-twelve-capacity : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    [after-twelve-bytes : i64
      (be_state.compiler-backend-state-user-symbol-cache-retained-bytes
        backend-state)]
    [symbol-m : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-m)]
    [after-thirteen-count : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [after-thirteen-capacity : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    [after-thirteen-bytes : i64
      (be_state.compiler-backend-state-user-symbol-cache-retained-bytes
        backend-state)]
    [symbol-a-again : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-a)]
    [symbol-m-again : String
      (be_state.compiler-backend-state-user-symbol-id backend-state id-m)]
    [final-count : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [final-capacity : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    (and
      (= before-capacity 0)
      (= before-bytes 0)
      (= before-count 0)
      (= after-twelve-count 12)
      (= after-twelve-capacity 16)
      (= after-twelve-bytes 512)
      (= after-thirteen-count 13)
      (= after-thirteen-capacity 32)
      (= after-thirteen-bytes 1024)
      (= final-count 13)
      (= final-capacity 32)
      (string.eq symbol-a "_tl_growth_a")
      (string.eq symbol-m "_tl_growth_m")
      (string.eq symbol-a-again symbol-a)
      (string.eq symbol-m-again symbol-m))))

;; Equal numeric IDs from different intern tables must remain isolated even
;; while the compatibility globals point at the other table.  The A/B states
;; are persistent across all four lookups, so a stale global-table cache hit is
;; observable immediately in the returned spelling.
(define (compiler-backend-user-symbol-cache-persistent-equal-id-ok?) : bool
  (let
    [active-before : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [intern-a : ci.InternCompatState (ci.intern-compat-state-new)]
    [intern-b : ci.InternCompatState (ci.intern-compat-state-new)]
    [id-a : i64 (ci.intern-compat-state-intern (&mut intern-a) "persistent/a")]
    [id-b : i64 (ci.intern-compat-state-intern (&mut intern-b) "persistent/b")]
    [state-a : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-a))]
    [state-b : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-b))]
    [symbol-a1 : String
      (begin
        (ci.intern-compat-state-install! intern-b)
        (be_state.compiler-backend-state-user-symbol-id state-a id-a))]
    [symbol-b1 : String
      (begin
        (ci.intern-compat-state-install! intern-a)
        (be_state.compiler-backend-state-user-symbol-id state-b id-b))]
    [symbol-a2 : String
      (begin
        (ci.intern-compat-state-install! intern-b)
        (be_state.compiler-backend-state-user-symbol-id state-a id-a))]
    [symbol-b2 : String
      (begin
        (ci.intern-compat-state-install! intern-a)
        (be_state.compiler-backend-state-user-symbol-id state-b id-b))]
    [count-a : i64
      (be_state.compiler-backend-state-user-symbol-cache-count state-a)]
    [count-b : i64
      (be_state.compiler-backend-state-user-symbol-cache-count state-b)]
    [_restore : unit (ci.intern-compat-state-install! active-before)]
    (and
      (= id-a id-b)
      (string.eq symbol-a1 "_tl_persistent_a")
      (string.eq symbol-a2 symbol-a1)
      (string.eq symbol-b1 "_tl_persistent_b")
      (string.eq symbol-b2 symbol-b1)
      (= count-a 1)
      (= count-b 1)
      (not (string.eq symbol-a1 symbol-b1)))))

;; Generated IDs live in the high end of the intern pool.  The user-symbol
;; cache must accept a valid generated ID without allocating a capacity-sized
;; table, while invalid IDs return empty and do not allocate or grow anything.
(define (compiler-backend-user-symbol-cache-generated-bound-ok?) : bool
  (let
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [generated-id : i64
      (ci.intern-compat-state-generated-name
        (&mut intern-state)
        "generated/high")]
    [pool-len : i64 (ci.intern-compat-state-pool-len intern-state)]
    [generated-active : bool
      (ci.intern-compat-state-generated-id-active? intern-state generated-id)]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [before-capacity : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    [generated-symbol : String
      (be_state.compiler-backend-state-user-symbol-id
        backend-state
        generated-id)]
    [after-generated-capacity : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    [after-generated-count : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [invalid-symbol : String
      (be_state.compiler-backend-state-user-symbol-id backend-state (- 0 1))]
    [after-invalid-capacity : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    [after-invalid-count : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    (and
      (= before-capacity 0)
      (> generated-id pool-len)
      generated-active
      (string.eq generated-symbol "_tl_generated_high")
      (= after-generated-capacity 16)
      (= after-generated-count 1)
      (string.eq invalid-symbol "")
      (= after-invalid-capacity after-generated-capacity)
      (= after-invalid-count after-generated-count))))

;; IR-owned derived symbols live far above the intern pool's numeric window.
;; They must use the same state-owned sparse cache as ordinary/generated ids,
;; rather than allocating a table indexed by their high numeric value.
(define (compiler-backend-user-symbol-cache-derived-ir-ok?) : bool
  (let
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [spelling : String "backend_cache_ir_owned_6274_unique_symbol"]
    [derived-id : i64
      (ir.compiler-ir-symbol (owned_view.compiler-owned-shared-view spelling))]
    [before-capacity : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    [text : String
      (be_state.compiler-backend-symbol-text-state backend-state derived-id)]
    [symbol-first : String
      (be_state.compiler-backend-state-user-symbol-id backend-state derived-id)]
    [count-first : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [capacity-first : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    [bytes-first : i64
      (be_state.compiler-backend-state-user-symbol-cache-retained-bytes
        backend-state)]
    [symbol-second : String
      (be_state.compiler-backend-state-user-symbol-id backend-state derived-id)]
    [count-second : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    (and
      (ir.compiler-ir-symbol-owned? derived-id)
      (string.eq text spelling)
      (= before-capacity 0)
      (string.eq symbol-first "_tl_backend_cache_ir_owned_6274_unique_symbol")
      (string.eq symbol-second symbol-first)
      (= count-first 1)
      (= count-second 1)
      (= capacity-first 16)
      (= bytes-first 512))))

(define (compiler-backend-user-symbol-cache-ok?) : bool
  (ci.intern-reset!)
  (let
    [path-name : String "pkg/nested/module.tl::some-value"]
    [path-id : i64 (ci.intern path-name)]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [backend-intern : ci.InternCompatState
      (be_state.compiler-backend-state-intern backend-state)]
    [_capture-path : unit
      (ci.intern-compat-state-capture-from-globals! (&mut backend-intern))]
    [_reset : unit
      (be_state.compiler-backend-state-user-symbol-cache-reset! backend-state)]
    [path-symbol-first : String
      (be_state.compiler-backend-state-user-symbol-id backend-state path-id)]
    [count-after-path-first : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [path-symbol-second : String
      (be_state.compiler-backend-state-user-symbol-id backend-state path-id)]
    [count-after-path-second : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [main-id : i64 (ci.intern "main")]
    [_capture-main : unit
      (ci.intern-compat-state-capture-from-globals! (&mut backend-intern))]
    [main-symbol-first : String
      (be_state.compiler-backend-state-user-symbol-id backend-state main-id)]
    [count-after-main-first : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [main-symbol-second : String
      (be_state.compiler-backend-state-user-symbol-id backend-state main-id)]
    [count-after-main-second : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [third-symbol : String
      (be_state.compiler-backend-state-user-symbol-id backend-state path-id)]
    [count-after-third : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    (be_state.backend-and8
      (string.eq path-symbol-first "_tl_pkg_nested_module_some_value")
      (string.eq path-symbol-second path-symbol-first)
      (= count-after-path-first 1)
      (= count-after-path-second count-after-path-first)
      (string.eq main-symbol-first "main")
      (string.eq main-symbol-second "main")
      (= count-after-main-second count-after-main-first)
      (and
        (string.eq third-symbol path-symbol-first)
        (= count-after-third count-after-main-second)))))

(define (compiler-backend-user-symbol-cache-compat-state-ok?) : bool
  (let
    [state-a : ci.InternCompatState (ci.intern-compat-state-new)]
    [state-b : ci.InternCompatState (ci.intern-compat-state-new)]
    [id-a : i64
      (begin
        (ci.intern-compat-state-install! state-a)
        (ci.intern-reset!)
        (ci.intern "first-state-name"))]
    [symbol-a : String
      (begin
        (ci.intern-compat-state-capture-from-globals! (&mut state-a))
        (be_state.compiler-backend-state-user-symbol-id
          (be_state.compiler-backend-state-new
            (ci.intern-global-shared-view state-a))
          id-a))]
    [id-b : i64
      (begin
        (ci.intern-compat-state-install! state-b)
        (ci.intern-reset!)
        (ci.intern "second-state-name"))]
    [symbol-b : String
      (begin
        (ci.intern-compat-state-capture-from-globals! (&mut state-b))
        (be_state.compiler-backend-state-user-symbol-id
          (be_state.compiler-backend-state-new
            (ci.intern-global-shared-view state-b))
          id-b))]
    (and
      (= id-a id-b)
      (not
        (=
          (ci.intern-compat-state-generation state-a)
          (ci.intern-compat-state-generation state-b)))
      (not
        (=
          (ci.intern-compat-state-table-id state-a)
          (ci.intern-compat-state-table-id state-b)))
      (string.eq symbol-a "_tl_first_state_name")
      (string.eq symbol-b "_tl_second_state_name"))))

(define (compiler-backend-user-symbol-cache-scratch-source) : String
  "(define (shared [x : i64]) : i64 (+ x 1))
(define (first [x : i64]) : i64 (shared x))
(define (second [x : i64]) : i64 (shared x))
(define (main) : i64 (+ (first 1) (second 2)))")

(define (compiler-backend-user-symbol-cache-scratch-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-user-symbol-cache-scratch-source))
    [(Ok _) true]
    [(Err _) false]))

