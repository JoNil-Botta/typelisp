(define (compiler-backend-byte-vector-shift-shape?
  [avx512 : bool]
  [op : compiler_ir_types.CompilerIrBinOp]
  [elem-ty : compiler_ast_types.AstType]
  [lanes : i64]
  [widen : String]
  [shift : String]
  [stack-bytes : i64]) : bool
  (match (if avx512
    (compiler_backend.compiler-backend-emit-avx512-vector-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-binop-test-assignments)
      2
      op
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      lanes
      elem-ty
      (compiler_diagnostic.compiler-diagnostic-at-start "" "")
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (compiler_backend.compiler-backend-emit-avx2-vector-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-binop-test-assignments)
      2
      op
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      lanes
      elem-ty
      (compiler_diagnostic.compiler-diagnostic-at-start "" "")
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (=
            (compiler_backend.compiler-backend-string-count asm widen)
            (match elem-ty
              [(compiler_ast_types.AstType.U8) 9]
              [_ 8]))
          (= (compiler_backend.compiler-backend-string-count asm shift) 4)
          (= (compiler_backend.compiler-backend-string-count asm "vpackusdw") 2)
          (= (compiler_backend.compiler-backend-string-count asm "vpackuswb") 1)
          (= (compiler_backend.compiler-backend-string-count asm "vpermd") 1)
          (compiler_backend.compiler-backend-string-contains?
            asm
            (str_cat.str-cat
              "    subq $"
              (string.int->string stack-bytes)
              ", %rsp\n"))
          (compiler_backend.compiler-backend-string-contains?
            asm
            (str_cat.str-cat
              "    addq $"
              (string.int->string stack-bytes)
              ", %rsp\n"))
          (=
            (compiler_backend.compiler-backend-string-count asm "vpsrld $24")
            1))
        (=
          (compiler_backend.compiler-backend-string-count asm "movl $50462976")
          1)
        (=
          (compiler_backend.compiler-backend-string-count asm "movl $117835012")
          1)
        (if avx512
          (and
            (=
              (compiler_backend.compiler-backend-string-count
                asm
                "movl $185207048")
              1)
            (=
              (compiler_backend.compiler-backend-string-count
                asm
                "movl $252579084")
              1)
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    vpsrld $2, %zmm0, %zmm0\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    vpslld $30, %zmm8, %zmm8\n"))
          (and
            (=
              (compiler_backend.compiler-backend-string-count
                asm
                "movl $185207048")
              0)
            (=
              (compiler_backend.compiler-backend-string-count
                asm
                "movl $252579084")
              0)
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    vpsrld $1, %ymm0, %ymm0\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    vpslld $31, %ymm8, %ymm8\n"))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-byte-vector-shift-spill-assignments) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Spill -64))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Spill -128))
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          2
          (compiler_regalloc.CompilerRegLocation.Spill -192))
        (compiler_regalloc.compiler-reg-assignment-table-empty)))))

(define (compiler-backend-byte-vector-shift-spill-ok? [avx512 : bool]) : bool
  (match (if avx512
    (compiler_backend.compiler-backend-emit-avx512-vector-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-byte-vector-shift-spill-assignments)
      2
      (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.I8))
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      64
      (compiler_ast_types.AstType.I8)
      (compiler_diagnostic.compiler-diagnostic-at-start "" "")
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (compiler_backend.compiler-backend-emit-avx2-vector-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-byte-vector-shift-spill-assignments)
      2
      (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.I8))
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      32
      (compiler_ast_types.AstType.I8)
      (compiler_diagnostic.compiler-diagnostic-at-start "" "")
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (if avx512
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    vmovdqu8 -64(%rbp), %zmm14\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    vmovdqu8 -128(%rbp), %zmm15\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    addq $448, %rsp\n    vmovdqu8 %zmm14, -192(%rbp)\n"))
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    vmovdqu -64(%rbp), %ymm14\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    vmovdqu -128(%rbp), %ymm15\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    addq $224, %rsp\n    vmovdqu %ymm14, -192(%rbp)\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-vector-bitwise-binop-ok?) : bool
  (and
    (compiler_backend.backend-and8
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Sub)
        (compiler_ast_types.AstType.F32)
        8
        "    vsubps %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitAnd)
        (compiler_ast_types.AstType.I64)
        4
        "    vpand %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitAnd)
        (compiler_ast_types.AstType.U8)
        32
        "    vpand %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (compiler_ast_types.AstType.I32)
        8
        "    vpor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (compiler_ast_types.AstType.I16)
        16
        "    vpor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitXor)
        (compiler_ast_types.AstType.U64)
        4
        "    vpxor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitXor)
        (compiler_ast_types.AstType.I8)
        32
        "    vpxor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-diagnostic?
        (compiler_ir_types.CompilerIrBinOp.BitAnd)
        (compiler_ast_types.AstType.F64)
        4
        "backend: unsupported AVX2 vector binary op"))
    (compiler_backend.backend-and8
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Sub)
        (compiler_ast_types.AstType.F32)
        16
        "    vsubps %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitAnd)
        (compiler_ast_types.AstType.I64)
        8
        "    vpandq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitAnd)
        (compiler_ast_types.AstType.U8)
        64
        "    vpandd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (compiler_ast_types.AstType.U64)
        8
        "    vporq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (compiler_ast_types.AstType.I16)
        32
        "    vpord %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitXor)
        (compiler_ast_types.AstType.I64)
        8
        "    vpxorq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.BitXor)
        (compiler_ast_types.AstType.I8)
        64
        "    vpxord %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-diagnostic?
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        (compiler_ast_types.AstType.F64)
        8
        "backend: unsupported AVX-512 vector binary op"))))

(define (compiler-backend-vector-shift-binop-ok?) : bool
  (and
    (compiler_backend.backend-and8
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.I32))
        (compiler_ast_types.AstType.I32)
        8
        "    vpsllvd %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shr (compiler_ast_types.AstType.I32))
        (compiler_ast_types.AstType.I32)
        8
        "    vpsravd %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shr (compiler_ast_types.AstType.U32))
        (compiler_ast_types.AstType.U32)
        8
        "    vpsrlvd %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.I64))
        (compiler_ast_types.AstType.I64)
        4
        "    vpsllvq %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shr (compiler_ast_types.AstType.U64))
        (compiler_ast_types.AstType.U64)
        4
        "    vpsrlvq %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shr (compiler_ast_types.AstType.I64))
        (compiler_ast_types.AstType.I64)
        4
        "    vpxor %ymm1, %ymm1, %ymm1\n    vpcmpgtq %ymm6, %ymm1, %ymm0\n    vpcmpeqd %ymm1, %ymm1, %ymm1\n    vpsllq $63, %ymm1, %ymm1\n    vpsrlq $57, %ymm1, %ymm1\n    vpsubq %ymm7, %ymm1, %ymm1\n    vpsllvq %ymm1, %ymm0, %ymm0\n    vpsrlvq %ymm7, %ymm6, %ymm8\n    vpor %ymm0, %ymm8, %ymm8\n")
      (compiler-backend-avx2-vector-binop-diagnostic?
        (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.I16))
        (compiler_ast_types.AstType.I16)
        16
        "backend: unsupported AVX2 vector binary op")
      (and
        (compiler-backend-byte-vector-shift-shape?
          false
          (compiler_ir_types.CompilerIrBinOp.Shl
            (compiler_ast_types.AstType.I8))
          (compiler_ast_types.AstType.I8)
          32
          "vpmovsxbd"
          "vpsllvd"
          224)
        (compiler-backend-byte-vector-shift-shape?
          false
          (compiler_ir_types.CompilerIrBinOp.Shr
            (compiler_ast_types.AstType.U8))
          (compiler_ast_types.AstType.U8)
          32
          "vpmovzxbd"
          "vpsrlvd"
          224)))
    (compiler_backend.backend-and8
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.U32))
        (compiler_ast_types.AstType.U32)
        16
        "    vpsllvd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shr (compiler_ast_types.AstType.I32))
        (compiler_ast_types.AstType.I32)
        16
        "    vpsravd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shr (compiler_ast_types.AstType.U32))
        (compiler_ast_types.AstType.U32)
        16
        "    vpsrlvd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.U64))
        (compiler_ast_types.AstType.U64)
        8
        "    vpsllvq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shr (compiler_ast_types.AstType.I64))
        (compiler_ast_types.AstType.I64)
        8
        "    vpsravq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (compiler_ir_types.CompilerIrBinOp.Shr (compiler_ast_types.AstType.U64))
        (compiler_ast_types.AstType.U64)
        8
        "    vpsrlvq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-diagnostic?
        (compiler_ir_types.CompilerIrBinOp.Shl (compiler_ast_types.AstType.U16))
        (compiler_ast_types.AstType.U16)
        32
        "backend: unsupported AVX-512 vector binary op")
      (and
        (compiler-backend-byte-vector-shift-shape?
          true
          (compiler_ir_types.CompilerIrBinOp.Shl
            (compiler_ast_types.AstType.U8))
          (compiler_ast_types.AstType.U8)
          64
          "vpmovzxbd"
          "vpsllvd"
          448)
        (compiler-backend-byte-vector-shift-shape?
          true
          (compiler_ir_types.CompilerIrBinOp.Shr
            (compiler_ast_types.AstType.I8))
          (compiler_ast_types.AstType.I8)
          64
          "vpmovsxbd"
          "vpsravd"
          448)))))

(define (compiler-backend-avx2-unsigned-compare-alias-ok?) : bool
  ;; Preserve the RHS before writing the destination: the allocator may assign
  ;; both to the same vector register.
  (and
    (string.eq
      (compiler_backend.compiler-backend-avx2-emit-unsigned-int-compare-asm
        (compiler_ir_types.CompilerIrBinOp.Ge)
        "%ymm14"
        "%ymm7"
        "%ymm7"
        (compiler_ast_types.AstType.U32))
      "    vpcmpeqd %ymm0, %ymm0, %ymm0\n    vpslld $31, %ymm0, %ymm0\n    vpxor %ymm0, %ymm7, %ymm1\n    vpxor %ymm0, %ymm14, %ymm7\n    vpcmpgtd %ymm7, %ymm1, %ymm7\n    vpcmpeqd %ymm0, %ymm0, %ymm0\n    vpxor %ymm0, %ymm7, %ymm7\n")
    (string.eq
      (compiler_backend.compiler-backend-avx2-emit-unsigned-int-compare-asm
        (compiler_ir_types.CompilerIrBinOp.Ge)
        "%ymm14"
        "%ymm7"
        "%ymm7"
        (compiler_ast_types.AstType.U8))
      "    vpcmpeqd %ymm0, %ymm0, %ymm0\n    vpsrlw $15, %ymm0, %ymm0\n    vpsllw $7, %ymm0, %ymm0\n    vpackuswb %ymm0, %ymm0, %ymm0\n    vpxor %ymm0, %ymm7, %ymm1\n    vpxor %ymm0, %ymm14, %ymm7\n    vpcmpgtb %ymm7, %ymm1, %ymm7\n    vpcmpeqd %ymm0, %ymm0, %ymm0\n    vpxor %ymm0, %ymm7, %ymm7\n")))

(define (compiler-backend-avx2-data-pointer-cse-source) : String
  "(define (fill [a : (Array i64)] [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (+ (array-ref a i) (array-ref a i)))))")

(define (compiler-backend-avx2-loop-body [body : String]) : String
  (let
    [start : i64
      (compiler_backend.compiler-backend-string-find-from
        body
        "foreach_avx2_body"
        0)]
    (if (< start 0)
      ""
      (let
        [tail : i64
          (compiler_backend.compiler-backend-string-find-from
            body
            "foreach_tail"
            start)]
        (if (< tail 0)
          (string.substring body start (- (string.string-length body) start))
          (string.substring body start (- tail start)))))))

(define (compiler-backend-avx2-data-pointer-cse-ok?) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    (compiler-backend-avx2-data-pointer-cse-source)
    (compiler_lower.CompilerLowerMode.Avx2))
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_optimize.optimize-program-with-spans program spans)
        [(compiler_optimize.CompilerOptimizedProgram.Program
            optimized
            optimized-spans)
          (match (compiler_backend.compiler-backend-emit-program-target-with-mode
            optimized
            (compiler_backend.CompilerBackendTarget.Linux)
            (compiler_backend.CompilerBackendMode.Avx2)
            optimized-spans
            true)
            [(compiler_backend.ResultCompilerBackend.Ok asm)
              (let
                [body : String
                  (compiler-backend-asm-function-body asm "_tl_fill")]
                [loop : String (compiler-backend-avx2-loop-body body)]
                (and
                  (compiler_backend.backend-and8
                    (=
                      (compiler_backend.compiler-backend-string-count
                        loop
                        "    movq 0(")
                      0)
                    (=
                      (compiler_backend.compiler-backend-string-count
                        loop
                        "    movq (%")
                      0)
                    (=
                      (compiler_backend.compiler-backend-string-count
                        loop
                        "    vmovdqu (")
                      1)
                    (=
                      (compiler_backend.compiler-backend-string-count
                        loop
                        "    vpaddq (")
                      0)
                    (=
                      (compiler_backend.compiler-backend-string-count
                        loop
                        "    vmovdqu %ymm6")
                      1)
                    (compiler_backend.compiler-backend-string-contains?
                      body
                      "foreach_avx2_body")
                    (compiler_backend.compiler-backend-string-contains?
                      body
                      "foreach_tail")
                    (=
                      (compiler_backend.compiler-backend-string-count
                        loop
                        "    vpaddq %ymm6, %ymm6, %ymm6")
                      1))
                  (not
                    (compiler_backend.compiler-backend-string-contains?
                      loop
                      "vector/mask IR emission is not implemented"))))]
            [(compiler_backend.ResultCompilerBackend.Err _) false])])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-simd-vector-ok?) : bool
  (and
    (compiler-backend-avx2-vector-map-ok?)
    (compiler-backend-avx512-vector-map-ok?)
    (compiler-backend-lane-id-rodata-ok?)
    (compiler-backend-avx2-uniform-vector-map-ok?)
    (compiler-backend-avx512-uniform-vector-map-ok?)
    (compiler-backend-avx512-masked-if-ok?)
    (compiler-backend-avx2-vector-reduce-ok?)
    (compiler-backend-avx512-vector-reduce-ok?)
    (compiler-backend-avx512-bool-vector-reduce-ok?)
    (compiler-backend-vector-shuffle-ok?)
    (compiler-backend-vector-reduce-direct-store-ok?)
    (compiler-backend-xmm-family-conversion-ok?)
    (compiler-backend-avx2-vector-homes-ok?)
    (compiler-backend-avx512-mask-homes-ok?)
    (compiler-backend-avx512-mask-load-temp-ok?)
    (compiler-backend-avx512-mask-store-temp-ok?)
    (compiler-backend-avx2-tail-mask-ok?)
    (compiler-backend-avx512-tail-mask-ok?)
    (compiler-backend-avx512-mask-not-shortens-ok?)
    (compiler-backend-avx512-mask-binop-same-registers-ok?)
    (compiler-backend-avx512-mask-reduce-ok?)
    (compiler-backend-avx512-mask-spill-ok?)
    (compiler-backend-vector-load-binop-folding-ok?)
    (compiler-backend-avx2-data-pointer-cse-ok?)
    (compiler-backend-avx2-native-mask-emission-ok?)
    (compiler-backend-simd-indexed-address-ok?)
    (compiler-backend-simd-indexed-address-users-ok?)
    (compiler-backend-stack-splat-broadcast-ok?)
    (compiler-backend-vector-spill-reload-ok?)
    (compiler-backend-vector-spill-pressure-ok?)
    (compiler-backend-vector-bitwise-binop-ok?)
    (compiler-backend-vector-shift-binop-ok?)
    (compiler-backend-byte-vector-shift-spill-ok? false)
    (compiler-backend-byte-vector-shift-spill-ok? true)
    (compiler-backend-avx2-unsigned-compare-alias-ok?)
    (compiler-backend-vector-call-lifetime-spill-ok?)))

(define (compiler-backend-optimizer-rewrite-diagnostic-ok?) : bool
  (let
    [phi : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Phi
        0
        (compiler_ir_types.compiler-ir-phi-input-cons
          (compiler_ir_types.CompilerIrValue.F64
            (compiler-backend-test-f64-bits "1.0"))
          (compiler_ir_types.compiler-ir-label "entry")
          compiler_ir_types.CompilerIrPhiInputList.Nil)
        (compiler_ast_types.AstType.I64))]
    [program : compiler_ir_types.CompilerIrProgram
      (compiler_ir_types.CompilerIrProgram.Program
        (compiler_ir_types.compiler-ir-global-seq-empty)
        (compiler_ir_types.compiler-ir-function-cons
          (compiler_ir_types.CompilerIrFunction.Function
            (ci.intern "main")
            compiler_ir_types.CompilerIrParamList.Nil
            (compiler_ast_types.AstType.I64)
            4
            (compiler_ir_types.compiler-ir-block-cons
              (compiler_ir_types.compiler-ir-block
                (compiler_ir_types.compiler-ir-label "entry")
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.Jump
                    (compiler_ir_types.compiler-ir-label "join"))
                  compiler_ir_types.CompilerIrInstrList.Nil))
              (compiler_ir_types.compiler-ir-block-cons
                (compiler_ir_types.compiler-ir-block
                  (compiler_ir_types.compiler-ir-label "join")
                  (compiler_ir_types.compiler-ir-instr-cons
                    phi
                    (compiler_ir_types.compiler-ir-instr-cons
                      (compiler_ir_types.CompilerIrInstr.Return
                        (compiler_ir_types.CompilerIrMaybeValue.Some
                          (compiler_ir_types.CompilerIrValue.Var 0)))
                      compiler_ir_types.CompilerIrInstrList.Nil)))
                compiler_ir_types.CompilerIrBlockList.Nil)))
          compiler_ir_types.CompilerIrFunctionList.Nil)
        compiler_ir_types.CompilerIrExternList.Nil)]
    [spans : compiler_ir_types.CompilerSourceSpans
      (compiler_ir_types.compiler-source-spans-insert-instr
        (compiler_ir_types.compiler-source-spans-insert
          (compiler_ir_types.compiler-source-spans-empty)
          (compiler_ir_types.compiler-ir-symbol-typed-id (ci.intern "main"))
          (compiler-backend-test-span 10 2))
        (ci.intern "main")
        phi
        (compiler-backend-test-span 55 13))]
    [previous-debug : bool (compiler_ir_types.compiler-debug-info-enabled?)]
    [ok : bool
      (begin
        ;; Non-abort instruction spans are intentionally a debug-only cost.
        (compiler_ir_types.compiler-debug-info-set-enabled! true)
        (match (compiler_optimize.optimize-program-with-spans program spans)
          [(compiler_optimize.CompilerOptimizedProgram.Program
              optimized
              optimized-spans)
            (match (compiler_backend.compiler-backend-emit-program-linux-with-spans
              optimized
              optimized-spans)
              [(compiler_backend.ResultCompilerBackend.Err diag)
                (and
                  (string.eq
                    (compiler_diagnostic.compiler-diagnostic-message
                      (__tl-box-place diag))
                    "backend: f64 values are not supported yet")
                  (=
                    (compiler_diagnostic.compiler-diagnostic-line
                      (__tl-box-place diag))
                    55)
                  (=
                    (compiler_diagnostic.compiler-diagnostic-col
                      (__tl-box-place diag))
                    13))]
              [(compiler_backend.ResultCompilerBackend.Ok _) false])]))]
    (begin
      (compiler_ir_types.compiler-debug-info-set-enabled! previous-debug)
      ok)))

(define (compiler-backend-test-runtime-plan-for-instr
  [_instr : compiler_ir_types.CompilerIrInstr]
  [_vars : i64]) : compiler_backend.CompilerBackendRuntimePlan
  (let
    [base : compiler_backend.CompilerBackendRuntimePlan
      (compiler_backend.CompilerBackendRuntimePlan.Plan
        false
        false
        false
        false
        false
        false
        false
        (compiler_backend.CompilerBackendRuntimeTailPlan
          false
          false
          false
          false))]
    (cfg
      scratch-vreg
      (match (compiler-backend-scratch-test-result
        "single_instr_emission"
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-block
            (compiler_ir_types.compiler-ir-label "entry")
            (compiler_ir_types.compiler-ir-instr-cons
              _instr
              compiler_ir_types.CompilerIrInstrList.Nil))
          compiler_ir_types.CompilerIrBlockList.Nil)
        _vars
        (compiler_regalloc.compiler-reg-assignment-table-empty))
        [(compiler_regalloc.CompilerRegScratchPlanResult.Result _ scratch)
          (compiler_backend.CompilerBackendRuntimePlan.WithScratch
            (box base)
            scratch)])
      base)))

(define (compiler-backend-instr-contains?
  [instr : compiler_ir_types.CompilerIrInstr]
  [needle : String]) : bool
  (let
    [program-index : compiler_backend.CompilerBackendProgramIndex
      (compiler_backend.compiler-backend-program-index-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil)]
    [backend-state : compiler_backend.CompilerBackendState
      program-index.backend-state]
    [prev-starts : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-starts
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-ends : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-ends
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-assignment-index : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-assignments
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-plan-mask : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-plan-reg-mask
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-occupied-masks : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-occupied-masks
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-vars : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-vars
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-post-base : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-instr-post-base
        backend-state)]
    [prev-current-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-current-count
        backend-state)]
    [prev-current-site : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-current-site
        backend-state)]
    [prev-addr-forward-enabled : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-addr-of-forwarding-enabled
        backend-state)]
    [prev-addr-forward-src : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-addr-of-forwarding-src
        backend-state)]
    [prev-fuse-ready : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-fuse-need-ready
        backend-state)]
    [prev-fuse-use-counts : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-fuse-use-counts
        backend-state)]
    [prev-fuse-free-counts : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-fuse-free-counts
        backend-state)]
    [prev-loop-active : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-instrs-loop-active
        backend-state)]
    [prev-continue-pending : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-instrs-continue-pending
        backend-state)]
    [prev-identity-tail : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-identity-tail-forwarder-active
        backend-state)]
    [vars : i64 8]
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    [test-id : i64 (ci.intern "test")]
    [_ctx : unit
      (begin
        (compiler_regalloc.compiler-reg-fill-i64-array starts -1)
        (compiler_regalloc.compiler-reg-fill-i64-array ends -1)
        (compiler_backend.compiler-backend-set-scavenge-ctx!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          starts
          ends
          (compiler_regalloc.compiler-reg-assignment-table-empty)
          vars)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          backend-state
          1)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          backend-state
          1)
        (compiler_backend.compiler-backend-addr-of-forwarding-disable!
          backend-state)
        (compiler_backend.compiler-backend-fuse-need-disable! backend-state)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instrs-loop-active!
          backend-state
          false)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instrs-continue-pending!
          backend-state
          false)
        (compiler_backend.compiler-backend-test-set-compiler-backend-identity-tail-forwarder-active!
          backend-state
          false))]
    (match (compiler_backend.compiler-backend-emit-instr
      (compiler_backend.CompilerBackendEmissionContext
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_backend.CompilerBackendTarget.Linux)
        "_tl_test"
        test-id
        compiler_ir_types.CompilerIrBlockList.Nil
        (compiler_ir_types.compiler-ir-label "entry")
        (compiler_regalloc.compiler-reg-assignment-table-empty)
        vars
        (compiler_regalloc.compiler-reg-var-types-empty)
        (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
        (compiler_ast_types.AstType.I64)
        (compiler-backend-test-runtime-plan-for-instr instr vars)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil
        program-index
        (compiler_ir_types.compiler-source-spans-empty)
        (compiler_backend.compiler-backend-source-span-index-build-with-backend-state
          backend-state
          (compiler_ir_types.compiler-source-spans-empty))
        (compiler_diagnostic.compiler-diagnostic-at-start "" "")
        (array.make-array i64 0)
        backend-state
        (compiler_backend.compiler-backend-state-function-state backend-state))
      (compiler_backend.CompilerBackendMaybeLabel.No)
      instr)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (let
          [hit : bool
            (compiler_backend.compiler-backend-string-contains? asm needle)]
          [_restore : unit
            (begin
              (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-starts
                prev-ends
                prev-assignment-index
                prev-plan-mask
                prev-occupied-masks
                prev-vars)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
                backend-state
                prev-post-base)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
                backend-state
                prev-current-count)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-site!
                backend-state
                prev-current-site)
              (compiler_backend.compiler-backend-test-set-compiler-backend-addr-of-forwarding-enabled!
                backend-state
                prev-addr-forward-enabled)
              (compiler_backend.compiler-backend-test-set-compiler-backend-addr-of-forwarding-src!
                backend-state
                prev-addr-forward-src)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-need-ready!
                backend-state
                prev-fuse-ready)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-use-counts!
                backend-state
                prev-fuse-use-counts)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-free-counts!
                backend-state
                prev-fuse-free-counts)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instrs-loop-active!
                backend-state
                prev-loop-active)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instrs-continue-pending!
                backend-state
                prev-continue-pending)
              (compiler_backend.compiler-backend-test-set-compiler-backend-identity-tail-forwarder-active!
                backend-state
                prev-identity-tail))]
          hit)]
      [(compiler_backend.ResultCompilerBackend.Err _)
        (let
          [_restore : unit
            (begin
              (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
                (compiler_backend.compiler-backend-state-function-state
                  backend-state)
                prev-starts
                prev-ends
                prev-assignment-index
                prev-plan-mask
                prev-occupied-masks
                prev-vars)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
                backend-state
                prev-post-base)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
                backend-state
                prev-current-count)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-site!
                backend-state
                prev-current-site)
              (compiler_backend.compiler-backend-test-set-compiler-backend-addr-of-forwarding-enabled!
                backend-state
                prev-addr-forward-enabled)
              (compiler_backend.compiler-backend-test-set-compiler-backend-addr-of-forwarding-src!
                backend-state
                prev-addr-forward-src)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-need-ready!
                backend-state
                prev-fuse-ready)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-use-counts!
                backend-state
                prev-fuse-use-counts)
              (compiler_backend.compiler-backend-test-set-compiler-backend-fuse-free-counts!
                backend-state
                prev-fuse-free-counts)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instrs-loop-active!
                backend-state
                prev-loop-active)
              (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instrs-continue-pending!
                backend-state
                prev-continue-pending)
              (compiler_backend.compiler-backend-test-set-compiler-backend-identity-tail-forwarder-active!
                backend-state
                prev-identity-tail))]
          false)])))

