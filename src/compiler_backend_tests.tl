(define (compiler-backend-test-reg-assignment-table-from
  [regs : (__tl_dyn-array i64)]
  [index : i64]) : compiler_regalloc.CompilerRegAssignmentTable
  (if (>= index (array-length regs))
    (compiler_regalloc.compiler-reg-assignment-table-empty)
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        index
        (compiler_regalloc.CompilerRegLocation.Register (array-ref regs index)))
      (compiler-backend-test-reg-assignment-table-from regs (+ index 1)))))

(define (compiler-backend-test-fill-live-range!
  [starts : (__tl_dyn-array i64)]
  [ends : (__tl_dyn-array i64)]
  [count : i64]
  [start : i64]
  [end : i64]) : unit
  (let
    [i : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref starts i) start)
          (set! (array-ref ends i) end)
          (set! i (+ i 1))))
      unit)))

(define (compiler-backend-scavenge-special-reg-bit-map-ok?) : bool
  (let
    [rax : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%rax")]
    [rsi : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%rsi")]
    [rdi : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%rdi")]
    (and
      (not (= rax 0))
      (not (= rsi 0))
      (not (= rdi 0))
      (not (= rax rsi))
      (not (= rax rdi))
      (not (= rsi rdi))
      (=
        (compiler_backend.compiler-backend-scavenge-reg-bit "%xmm2")
        (compiler_backend.compiler-backend-scavenge-reg-bit "%vec2"))
      (=
        (compiler_backend.compiler-backend-scavenge-reg-bit "%xmm3")
        (compiler_backend.compiler-backend-scavenge-reg-bit "%ymm3"))
      (=
        (compiler_backend.compiler-backend-scavenge-reg-bit "%xmm4")
        (compiler_backend.compiler-backend-scavenge-reg-bit "%zmm4"))
      (= (compiler_backend.compiler-backend-scavenge-reg-bit-by-index 15) rax)
      (= (compiler_backend.compiler-backend-scavenge-reg-bit-by-index 16) rsi)
      (= (compiler_backend.compiler-backend-scavenge-reg-bit-by-index 17) rdi))))

(define (compiler-backend-emergency-vector-width-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_init : unit
      (begin
        (compiler_backend.compiler-backend-set-current-mode!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          (compiler_backend.CompilerBackendMode.Avx2))
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          -512)
        (compiler_backend.compiler-backend-emergency-add!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          "%xmm2"))]
    [avx2 : String
      (compiler_backend.compiler-backend-emergency-wrap
        "    nop\n"
        backend-state)]
    [_avx512-init : unit
      (begin
        (compiler_backend.compiler-backend-set-current-mode!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          (compiler_backend.CompilerBackendMode.Avx512))
        (compiler_backend.compiler-backend-emergency-add!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          "%xmm3"))]
    [avx512 : String
      (compiler_backend.compiler-backend-emergency-wrap
        "    nop\n"
        backend-state)]
    [ok : bool
      (and
        (= (compiler_backend.compiler-backend-emergency-frame-extra 2) 128)
        (=
          (compiler_backend.compiler-backend-emergency-reg-offset
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            1)
          -576)
        (compiler_backend.compiler-backend-string-contains?
          avx2
          "    vmovdqu %ymm2, -512(%rbp)\n")
        (compiler_backend.compiler-backend-string-contains?
          avx2
          "    vmovdqu -512(%rbp), %ymm2\n")
        (compiler_backend.compiler-backend-string-contains?
          avx512
          "    vmovdqu64 %zmm3, -512(%rbp)\n")
        (compiler_backend.compiler-backend-string-contains?
          avx512
          "    vmovdqu64 -512(%rbp), %zmm3\n"))]
    ok))

(define (compiler-backend-scavenge-widened-pool-picks-rsi-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [regs : (__tl_dyn-array i64) (__tl_make-array i64 13)]
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 13)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 13)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignment-table-empty)]
    [picked : String ""]
    [ok : bool false]
    (begin
      (set! (array-ref regs 0) compiler_abi.compiler-reg-id-r9)
      (set! (array-ref regs 1) compiler_abi.compiler-reg-id-rcx)
      (set! (array-ref regs 2) compiler_abi.compiler-reg-id-rdx)
      (set! (array-ref regs 3) compiler_abi.compiler-reg-id-r10)
      (set! (array-ref regs 4) compiler_abi.compiler-reg-id-r11)
      (set! (array-ref regs 5) compiler_abi.compiler-reg-id-r8)
      (set! (array-ref regs 6) compiler_abi.compiler-reg-id-r12)
      (set! (array-ref regs 7) compiler_abi.compiler-reg-id-r13)
      (set! (array-ref regs 8) compiler_abi.compiler-reg-id-r14)
      (set! (array-ref regs 9) compiler_abi.compiler-reg-id-r15)
      (set! (array-ref regs 10) compiler_abi.compiler-reg-id-rbx)
      (set! (array-ref regs 11) compiler_abi.compiler-reg-id-rdi)
      (set! (array-ref regs 12) compiler_abi.compiler-reg-id-rax)
      (compiler-backend-test-fill-live-range! starts ends 13 0 10)
      (set!
        assignments
        (compiler-backend-test-reg-assignment-table-from regs 0))
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        false)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        false)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending-count!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        0)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used-count!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        0)
      (set!
        picked
        (compiler-backend-scavenge-pick
          backend-state
          starts
          ends
          (compiler_regalloc.compiler-reg-assignment-table-with-min-capacity
            assignments
            13)
          13
          4
          (array.make-array String 0)
          0
          "%r8"))
      (set!
        ok
        (and
          (string.eq picked "%rsi")
          (not
            (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-pending
              (compiler_backend.compiler-backend-state-function-state
                backend-state)))
          (not
            (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-used
              (compiler_backend.compiler-backend-state-function-state
                backend-state)))
          (=
            (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-pending-count
              (compiler_backend.compiler-backend-state-function-state
                backend-state))
            0)
          (=
            (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-used-count
              (compiler_backend.compiler-backend-state-function-state
                backend-state))
            0)))
      ok)))

(define (compiler-backend-scavenge-win64-rsi-rdi-plan-mask-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [rsi-bit : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%rsi")]
    [rdi-bit : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%rdi")]
    [win64-bit : i64 compiler_backend.compiler-backend-scavenge-plan-win64-bit]
    [linux-ok : bool false]
    [win64-ok : bool false]
    (begin
      (set!
        linux-ok
        (and
          (compiler_backend.compiler-backend-scavenge-candidate-ok?
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            0
            0
            0
            compiler_abi.compiler-reg-id-rsi)
          (compiler_backend.compiler-backend-scavenge-candidate-ok?
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            0
            0
            0
            compiler_abi.compiler-reg-id-rdi)))
      (set!
        win64-ok
        (and
          (not
            (compiler_backend.compiler-backend-scavenge-candidate-ok?
              (compiler_backend.compiler-backend-state-function-state
                backend-state)
              0
              0
              win64-bit
              compiler_abi.compiler-reg-id-rsi))
          (not
            (compiler_backend.compiler-backend-scavenge-candidate-ok?
              (compiler_backend.compiler-backend-state-function-state
                backend-state)
              0
              0
              win64-bit
              compiler_abi.compiler-reg-id-rdi))
          (compiler_backend.compiler-backend-scavenge-candidate-ok?
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            0
            0
            (bit-or win64-bit rsi-bit)
            compiler_abi.compiler-reg-id-rsi)
          (compiler_backend.compiler-backend-scavenge-candidate-ok?
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            0
            0
            (bit-or win64-bit rdi-bit)
            compiler_abi.compiler-reg-id-rdi)))
      (and linux-ok win64-ok))))

(define (compiler-backend-scratch-vreg-call-target-test-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.compiler-ir-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.CallIndirectC
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrCallArgs.Nil)
          (compiler_ast_types.AstType.I64))
