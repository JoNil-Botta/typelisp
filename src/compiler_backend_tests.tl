  "(define (make3 [x : i64]) : (Tuple i64 i64 i64)
  (tuple x (+ x 1) (+ x 2)))

(define (make5 [x : i64]) : (Tuple i64 i64 i64 i64 i64)
  (tuple x (+ x 1) (+ x 2) (+ x 3) (+ x 4)))

(define (main) : i64
  (let
    [a : (Tuple i64 i64 i64) (make3 10)]
    [b : (Tuple i64 i64 i64 i64 i64) (make5 20)]
    (+ (tuple-ref a 2) (tuple-ref b 4))))")

(define (compiler-backend-inline-fast-alloc-multi-size-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-inline-fast-alloc-multi-size-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains-inline-alloc-size? asm 24)
        (compiler-backend-string-contains-inline-alloc-size? asm 40)
        (compiler_backend.compiler-backend-string-contains?
          asm
          "_slow:\n    call .L_tl_alloc24\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "_slow:\n    call .L_tl_alloc40\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_alloc\n"))
        (compiler_backend.compiler-backend-string-contains? asm "    jb ")
        (compiler_backend.compiler-backend-string-contains? asm "    ja "))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-fast-alloc-multi-size-ok?) : bool
  (and
    (compiler-backend-inline-fast-alloc-multi-size-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-inline-fast-alloc-multi-size-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

(define compiler-backend-inline-fast-alloc-emergency-live-count : i64
  13)

(define (compiler-backend-inline-fast-alloc-emergency-regs) : (__tl_dyn-array
    i64)
  (let
    [regs : (__tl_dyn-array i64)
      (__tl_make-array
        i64
        compiler-backend-inline-fast-alloc-emergency-live-count)]
    (begin
      (set! (array-ref regs 0) compiler_abi.compiler-reg-id-r9)
      (set! (array-ref regs 1) compiler_abi.compiler-reg-id-rcx)
      (set! (array-ref regs 2) compiler_abi.compiler-reg-id-rdx)
      (set! (array-ref regs 3) compiler_abi.compiler-reg-id-r10)
      (set! (array-ref regs 4) compiler_abi.compiler-reg-id-r11)
      (set! (array-ref regs 5) compiler_abi.compiler-reg-id-r8)
      (set! (array-ref regs 6) compiler_abi.compiler-reg-id-r12)
      (set! (array-ref regs 7) compiler_abi.compiler-reg-id-r13)
      (set! (array-ref regs 8) compiler_abi.compiler-reg-id-r14)
      (set! (array-ref regs 9) compiler_abi.compiler-reg-id-r15)
      (set! (array-ref regs 10) compiler_abi.compiler-reg-id-rbx)
      (set! (array-ref regs 11) compiler_abi.compiler-reg-id-rsi)
      (set! (array-ref regs 12) compiler_abi.compiler-reg-id-rdi)
      regs)))

(define (compiler-backend-inline-fast-alloc-emergency-assignments-from
  [regs : (__tl_dyn-array i64)]
  [index : i64]) : compiler_regalloc.CompilerRegAssignmentTable
  (if (>= index (array-length regs))
    (compiler_regalloc.compiler-reg-assignment-table-empty)
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        index
        (compiler_regalloc.CompilerRegLocation.Register (array-ref regs index)))
      (compiler-backend-inline-fast-alloc-emergency-assignments-from
        regs
        (+ index 1)))))

(define (compiler-backend-inline-fast-alloc-emergency-assignments) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler-backend-inline-fast-alloc-emergency-assignments-from
    (compiler-backend-inline-fast-alloc-emergency-regs)
    0))

(define (compiler-backend-inline-fast-alloc-emergency-instrs) : compiler_ir_types.CompilerIrInstrList
  (let
    [instrs : compiler_ir_types.CompilerIrInstrList
      compiler_ir_types.CompilerIrInstrList.Nil]
    [v : i64 (- compiler-backend-inline-fast-alloc-emergency-live-count 1)]
    (begin
      (while (>= v 0)
        (begin
          (set!
            instrs
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Mov
                (+ 30 v)
                (compiler_ir_types.CompilerIrValue.Var v)
                (compiler_ast_types.AstType.I64))
              instrs))
          (set! v (- v 1))))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Call
          20
          (ci.intern "tl_alloc")
          (compiler_ir_types.CompilerIrCallArgs.One
            (compiler_ir_types.CompilerIrValue.I64 8))
          (compiler_ast_types.AstType.U64))
        instrs))))

(define (compiler-backend-inline-fast-alloc-emergency-asm) : compiler_backend.ResultCompilerBackend
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [prev-starts : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-starts
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-ends : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-ends
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-assignment-index : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-assignments
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-plan-mask : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-plan-reg-mask
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-occupied-masks : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-occupied-masks
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-vars : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-vars
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-post-base : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-instr-post-base
        backend-state)]
    [prev-current-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-current-count
        backend-state)]
    [prev-emergency-pending : bool
      (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-pending
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-emergency-reg : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-reg
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-emergency-used : bool
      (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-used
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-emergency-pending-count : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-pending-count
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-emergency-used-count : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-used-count
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-emergency-slot-offset : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-slot-offset
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-emergency-restore-suppressed : bool
      (compiler_backend.compiler-backend-function-scratch-fixture-get-emergency-restore-suppressed
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-inline-fast-alloc-emergency-assignments)]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler-backend-inline-fast-alloc-emergency-instrs)]
    [count : i64 (compiler_ir_types.compiler-ir-instr-list-count instrs)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "entry")
          instrs)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [_ctx : unit
      (begin
        (compiler-backend-test-scavenge-install-ctx!
          "inline_fast_alloc_emergency"
          compiler_ir_types.CompilerIrParamList.Nil
          (compiler_ast_types.AstType.I64)
          50
          blocks
          assignments
          backend-state)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          backend-state
          count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          backend-state
          count)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          false)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-reg!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          compiler_abi.compiler-reg-id-invalid)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          false)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending-count!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          0)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used-count!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          0)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          -512)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-restore-suppressed!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          false))]
    [result : compiler_backend.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        50
        (compiler_backend.CompilerBackendTarget.Linux)
        backend-state)]
    [_restore : unit
      (begin
        (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-starts
          prev-ends
          prev-assignment-index
          prev-plan-mask
          prev-occupied-masks
          prev-vars)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          backend-state
          prev-post-base)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          backend-state
          prev-current-count)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-emergency-pending)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-reg!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-emergency-reg)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-emergency-used)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-pending-count!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-emergency-pending-count)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-used-count!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-emergency-used-count)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-emergency-slot-offset)
        (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-restore-suppressed!
          (compiler_backend.compiler-backend-state-function-state backend-state)
          prev-emergency-restore-suppressed))]
    result))

(define (compiler-backend-inline-fast-alloc-emergency-preserved-ok?) : bool
  (match (compiler-backend-inline-fast-alloc-emergency-asm)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r9, -512(%rbp)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq -512(%rbp), %r9\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rcx, -576(%rbp)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq -576(%rbp), %rcx\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %rdx, -640(%rbp)\n"))
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %fs:tl_current_arena@tpoff, %r9\n    testq %r9, %r9\n    jz .L_tl_test_allocentry_i0_v20_slow\n    testq $1, 48(%r9)\n    jnz .L_tl_test_allocentry_i0_v20_slow\n    movq 56(%r9), %rcx\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 16(%rcx), %rax\n    leaq 8(%rax), %r9\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpq 24(%rcx), %r9\n    ja .L_tl_test_allocentry_i0_v20_slow\n    movq %r9, 16(%rcx)\n"))
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call .L_tl_alloc8\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq tl_profile_alloc_live_bytes(%rip), %r9\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpq tl_profile_alloc_peak_bytes(%rip), %r9\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "tl_profile_alloc_live_bytes(%rip), %rcx"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "%rcx, tl_profile_alloc_peak_bytes(%rip)"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %fs:tl_current_arena@tpoff, %r8\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    leaq 8(%rax), %r8\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    leaq 8(%rax), %rax\n"))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Backend emit-shape coverage for local tuple construction/ref.
;; `(tuple true 42)` allocates the tuple payload, materializes/stores the bool
;; byte and i64 at their offsets, and `(tuple-ref t 1)` loads the i64 slot back.
(define (compiler-backend-tuple-source) : String
  "(define (main) : i64
  (let
    [t : (Tuple bool i64) (tuple true 42)]
    (tuple-ref t 1)))")

(define (compiler-backend-tuple-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-tuple-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler-backend-string-contains-alloc-size? asm 16)
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq $1,")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movb %r8b, (%r10)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq $42,")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r8, 8(%r10)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 8(%r10), %r8\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movb %al, (%r10)\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %rax, 8(%r10)\n")))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-struct-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler_lower_tests.compiler-lower-inline-struct-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and4
        (=
          (compiler_backend.compiler-backend-string-count
            asm
            "    call tl_alloc\n")
          0)
        (compiler_backend.compiler-backend-string-contains? asm "    leaq -")
        (compiler_backend.compiler-backend-string-contains? asm "main:\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-enum-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler_lower_tests.compiler-lower-inline-enum-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and4
        (=
          (compiler_backend.compiler-backend-string-count
            asm
            "    call tl_alloc\n")
          0)
        (compiler_backend.compiler-backend-string-contains? asm "    leaq -")
        (compiler_backend.compiler-backend-string-contains?
          asm
          ".Lf0_match_arm.")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-boxed-recursive-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler_lower_tests.compiler-lower-inline-boxed-recursive-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and4
        (= (compiler-backend-alloc-call-count asm) 2)
        ;; Both boxed leaves heap-allocate a full inline Tree value: tag (8)
        ;; plus the largest variant payload Branch((Box Tree), (Box Tree)) =
        ;; 16, so 24 bytes. With default-inline aggregates each box holds the
        ;; inline value, not an 8-byte handle.
        (compiler-backend-string-contains-alloc-size? asm 24)
        (compiler_backend.compiler-backend-string-contains? asm "    leaq -")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-hot-loop-struct-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler_lower_tests.compiler-lower-inline-hot-loop-struct-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      ;; The loop's 16-byte `Pair` is now a register-resident group (built
      ;; and read in registers), so the loop body neither heap-allocates nor needs
      ;; a stack-slot address for it.
      (compiler_backend.backend-and4
        (=
          (compiler_backend.compiler-backend-string-count
            asm
            "    call tl_alloc\n")
          0)
        (compiler_backend.compiler-backend-string-contains? asm "main:\n")
        true
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-aggregate-call-source) : String
  "(defstruct Color (r u8) (g u8) (b u8) (a u8))
(defenum Swatch (Empty) (Paint Color))
(define (make-color) : Color
  (Color (cast 5 : u8) (cast 7 : u8) (cast 11 : u8) (cast 13 : u8)))
(define (id-color [c : Color]) : Color c)
(define (use-color [c : Color]) : i64
  (+
    (cast c.r : i64)
    (+
      (cast c.g : i64)
      (+ (cast c.b : i64) (cast c.a : i64)))))
(define (id-swatch [s : Swatch]) : Swatch s)
(define (score-swatch [s : Swatch]) : i64
  (match s
    [Empty 0]
    [(Paint c) (use-color c)]))
(define (main) : i64
  (let
    [c : Color (id-color (make-color))]
    [s : Swatch (id-swatch (Paint c))]
    (if (= (use-color c) 36)
      (if (= (score-swatch s) 36) 42 2)
      1)))")

(define (compiler-backend-inline-aggregate-call-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-inline-aggregate-call-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and4
        (compiler_backend.compiler-backend-string-contains? asm "main:\n")
        (>= (compiler_backend.compiler-backend-string-count asm "    call ") 6)
        ;; sret ABI: aggregate args/returns pass by caller slot pointer
        ;; and inline construction is stack storage -- no arena allocation.
        (= (compiler-backend-alloc-call-count asm) 0)
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-aggregate-call-ok?) : bool
  (and
    (compiler-backend-inline-aggregate-call-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-inline-aggregate-call-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

(define (compiler-backend-inline-aggregate-copy-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-inline-aggregates-for-target
    (compiler_lower_tests.compiler-lower-inline-aggregate-copy-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      ;; `Pair` is a 16-byte all-integer struct, so it is register-resident
      ;; -- `id-pair` is a register-pair passthrough that carries both words in
      ;; registers end-to-end. The function is still emitted, but it does NOT do
      ;; the old pointer-load / pointer-store byte-copy ("(%r11), %rax" then
      ;; "%rax, (%r10)") that a memory aggregate required.
      (compiler_backend.backend-and4
        (compiler_backend.compiler-backend-string-contains? asm "id_pair")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "(%r11), %rax"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "%rax, (%r10)"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-aggregate-copy-ok?) : bool
  (and
    (compiler-backend-inline-aggregate-copy-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-inline-aggregate-copy-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

(define (compiler-backend-inline-aggregate-storage-ok?) : bool
  (and
    (compiler-backend-inline-struct-ok?)
    (compiler-backend-inline-enum-ok?)
    (compiler-backend-inline-boxed-recursive-ok?)
    (compiler-backend-inline-aggregate-call-ok?)
    (compiler-backend-inline-aggregate-copy-ok?)
    (compiler-backend-inline-hot-loop-struct-ok?)))

(define (compiler-backend-test-mode-scalar?
  [mode : compiler_backend.CompilerBackendMode]) : bool
  (match mode
    [(compiler_backend.CompilerBackendMode.Scalar) true]
    [_ false]))

(define (compiler-backend-test-mode-avx2?
  [mode : compiler_backend.CompilerBackendMode]) : bool
  (match mode
    [(compiler_backend.CompilerBackendMode.Avx2) true]
    [_ false]))

(define (compiler-backend-test-mode-avx512?
  [mode : compiler_backend.CompilerBackendMode]) : bool
  (match mode
    [(compiler_backend.CompilerBackendMode.Avx512) true]
    [_ false]))

(define (compiler-backend-defdispatch-source) : String
  "(define (dot-scalar [x : i64]) : i64 x)
(define (dot-avx2 [x : i64]) : i64 (+ x 2))
(define (dot-avx512 [x : i64]) : i64 (+ x 5))
(defdispatch dot (scalar dot-scalar) (avx2 dot-avx2) (avx512 dot-avx512))
(define (main) : i64 (dot 40))")

(define (compiler-backend-defdispatch-thunk-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-defdispatch-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            "__tl_dispatch_cache_dot")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "__tl_dispatch_variant_avx2")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "__tl_dispatch_variant_avx512")
          (compiler_backend.compiler-backend-string-contains? asm "    cpuid\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    xgetbv\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call *(%r10)\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    vzeroupper\n")
          (compiler_backend.compiler-backend-string-contains? asm "main:\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-dispatch-variant-mode-ok?) : bool
  (and
    (compiler_backend.backend-and4
      (compiler-backend-test-mode-avx2?
        (compiler_backend.compiler-backend-effective-mode-for-function-name
          (compiler_backend.CompilerBackendMode.Scalar)
          "__tl_dispatch_variant_avx2_dot__dot-avx2"))
      (compiler-backend-test-mode-avx512?
        (compiler_backend.compiler-backend-effective-mode-for-function-name
          (compiler_backend.CompilerBackendMode.Scalar)
          "__tl_dispatch_variant_avx512_dot__dot-avx512"))
      (compiler-backend-test-mode-scalar?
        (compiler_backend.compiler-backend-effective-mode-for-function-name
          (compiler_backend.CompilerBackendMode.Scalar)
          "__tl_dispatch_variant_scalar_dot__dot-scalar"))
      (compiler-backend-test-mode-avx2?
        (compiler_backend.compiler-backend-effective-mode-for-function-name
          (compiler_backend.CompilerBackendMode.Avx2)
          "ordinary")))
    (compiler-backend-defdispatch-thunk-ok?)))

(define (compiler-backend-signature-i64-to-i64?
  [sig : compiler_backend.CompilerBackendMaybeSignature]) : bool
  (match sig
    [(compiler_backend.CompilerBackendMaybeSignature.Some args ret-ty)
      (match ret-ty
        [(compiler_ast_types.AstType.I64)
          (and
            (= (compiler_ast_types.ast-type-list-len (& args)) 1)
            (match (compiler_ast_types.ast-node-pool-reader-type-get
              (compiler_ast_types.ast-type-list-get
                (& args)
                0
                (compiler_ast_types.ast-type-id-fallback)))
              [(compiler_ast_types.AstType.I64) true]
              [_ false]))]
        [_ false])]
    [(compiler_backend.CompilerBackendMaybeSignature.No) false]))

(define (compiler-backend-signature-unit-to-i64?
  [sig : compiler_backend.CompilerBackendMaybeSignature]) : bool
  (match sig
    [(compiler_backend.CompilerBackendMaybeSignature.Some args ret-ty)
      (and
        (compiler_ast_types.ast-type-list-empty? (& args))
        (match ret-ty
          [(compiler_ast_types.AstType.I64) true]
          [_ false]))]
    [(compiler_backend.CompilerBackendMaybeSignature.No) false]))

(define (compiler-backend-program-index-test-functions) : compiler_ir_types.CompilerIrFunctionList
  (compiler_ir_types.compiler-ir-function-cons
    (compiler_ir_types.CompilerIrFunction.Function
      (ci.intern "pkg/really-long-backend-index-function")
      (compiler_ir_types.compiler-ir-param-cons
        (compiler_ir_types.CompilerIrParam.Param
          "x"
          (compiler_ast_types.AstType.I64)
          0)
        compiler_ir_types.CompilerIrParamList.Nil)
      (compiler_ast_types.AstType.I64)
      1
      compiler_ir_types.CompilerIrBlockList.Nil)
    (compiler_ir_types.compiler-ir-function-cons
      (compiler_ir_types.CompilerIrFunction.Function
        (ci.intern "short_fn")
        compiler_ir_types.CompilerIrParamList.Nil
        (compiler_ast_types.AstType.Unit)
        0
        compiler_ir_types.CompilerIrBlockList.Nil)
      compiler_ir_types.CompilerIrFunctionList.Nil)))

(define (compiler-backend-program-index-test-externs
  [provided-id : i64]
  [provided-link-id : i64]
  [referenced-id : i64]
  [referenced-link-id : i64]) : compiler_ir_types.CompilerIrExternList
  (compiler_ir_types.compiler-ir-extern-cons
    (compiler_ir_types.CompilerIrExtern.Extern
      provided-id
      provided-id
      "provided_decl"
      (compiler_ast_types.ast-ty-func
        (compiler_ast_types.ast-type-list-new)
        (compiler_ast_types.AstType.I64))
      (compiler_ast_types.AstExternAbi.C)
      provided-link-id
      (compiler_ast_types.ast-extern-link-input-list-new)
      true)
    (compiler_ir_types.compiler-ir-extern-cons
      (compiler_ir_types.CompilerIrExtern.Extern
        referenced-id
        referenced-id
        "referenced_decl"
        (compiler_ast_types.ast-ty-func
          (compiler_ast_types.ast-type-cons
            (compiler_ast_types.AstType.I64)
            (compiler_ast_types.ast-type-list-new))
          (compiler_ast_types.AstType.I64))
        (compiler_ast_types.AstExternAbi.C)
        referenced-link-id
        (compiler_ast_types.ast-extern-link-input-list-new)
        false)
      compiler_ir_types.CompilerIrExternList.Nil)))

;; A backend job owns one exact intern capability and one cache arena.  Keep a
;; compact one-word smoke here so the state boundary itself is exercised before
;; any larger program-index fixture runs.
(define (compiler-backend-state-render-cache-storage-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [intern-a : ci.InternCompatState (ci.intern-compat-state-new)]
    [intern-b : ci.InternCompatState (ci.intern-compat-state-new)]
    [state-a : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new intern-a)]
    [state-b : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new intern-b)]
    [fresh-a : bool
      (and
        (= (compiler_backend.compiler-backend-state-lazy-table-arena state-a) 0)
        (=
          (compiler_backend.compiler-backend-state-slot-cache-capacity state-a)
          0)
        (=
          (compiler_backend.compiler-backend-state-frame-offset-cache-capacity
            state-a)
          0)
        (=
          (compiler_backend.compiler-backend-state-immediate-cache-capacity
            state-a)
          0)
        (=
          (compiler_backend.compiler-backend-state-operand-cache-retained-bytes
            state-a)
          0)
        (= (compiler_backend.compiler-backend-state-slot-cache-epoch state-a) 1))]
    [fresh-b : bool
      (and
        (= (compiler_backend.compiler-backend-state-lazy-table-arena state-b) 0)
        (=
          (compiler_backend.compiler-backend-state-slot-cache-capacity state-b)
          0)
        (=
          (compiler_backend.compiler-backend-state-frame-offset-cache-capacity
            state-b)
          0)
        (=
          (compiler_backend.compiler-backend-state-immediate-cache-capacity
            state-b)
          0)
        (=
          (compiler_backend.compiler-backend-state-operand-cache-retained-bytes
            state-b)
          0)
        (= (compiler_backend.compiler-backend-state-slot-cache-epoch state-b) 1))]
    [scratch : arena.Arena (arena.make)]
    [_set-scratch : unit
      (unsafe
        (arena.set! scratch))]
    [_reset-a : unit
      (compiler_backend.compiler-backend-state-slot-cache-reset! state-a)]
    [_reset-b : unit
      (compiler_backend.compiler-backend-state-slot-cache-reset! state-b)]
    [reset-empty : bool
      (and
        (=
          (compiler_backend.compiler-backend-state-slot-cache-capacity state-a)
          0)
        (=
          (compiler_backend.compiler-backend-state-frame-offset-cache-capacity
            state-a)
          0)
        (=
          (compiler_backend.compiler-backend-state-immediate-cache-capacity
            state-a)
          0)
        (=
          (compiler_backend.compiler-backend-state-slot-cache-capacity state-b)
          0)
        (=
          (compiler_backend.compiler-backend-state-frame-offset-cache-capacity
            state-b)
          0)
        (=
          (compiler_backend.compiler-backend-state-immediate-cache-capacity
            state-b)
          0))]
    [a-slot : String
      (compiler_backend.compiler-backend-slot-with-backend-state state-a 3)]
    [a-frame : String
      (compiler_backend.compiler-backend-frame-offset-with-backend-state
        state-a
        -40)]
    [b-immediate : String
      (compiler_backend.compiler-backend-state-immediate-render state-b 7)]
    [a-lazy : i64
      (compiler_backend.compiler-backend-state-lazy-table-arena state-a)]
    [b-lazy : i64
      (compiler_backend.compiler-backend-state-lazy-table-arena state-b)]
    [b-epoch-before-a-reset : i64
      (compiler_backend.compiler-backend-state-slot-cache-epoch state-b)]
    [after-render : bool
      (and
        (string.eq a-slot "-32(%rbp)")
        (string.eq a-frame "-40(%rbp)")
        (string.eq b-immediate "$7")
        (=
          (compiler_backend.compiler-backend-state-slot-cache-capacity state-a)
          16384)
        (=
          (compiler_backend.compiler-backend-state-frame-offset-cache-capacity
            state-a)
          16384)
        (=
          (compiler_backend.compiler-backend-state-immediate-cache-capacity
            state-a)
          0)
        (=
          (compiler_backend.compiler-backend-state-operand-cache-retained-bytes
            state-a)
          524288)
        (=
          (compiler_backend.compiler-backend-state-slot-cache-capacity state-b)
          0)
        (=
          (compiler_backend.compiler-backend-state-frame-offset-cache-capacity
            state-b)
          0)
        (=
          (compiler_backend.compiler-backend-state-immediate-cache-capacity
            state-b)
          8192)
        (=
          (compiler_backend.compiler-backend-state-operand-cache-retained-bytes
            state-b)
          131072)
        (> a-lazy 0)
        (> b-lazy 0)
        (not (= a-lazy b-lazy)))]
    [_reset-a-again : unit
      (compiler_backend.compiler-backend-state-slot-cache-reset! state-a)]
    [a-epoch-after-reset : i64
      (compiler_backend.compiler-backend-state-slot-cache-epoch state-a)]
    [b-immediate-again : String
      (compiler_backend.compiler-backend-state-immediate-render state-b 7)]
    [b-unchanged : bool
      (and
        (=
          (compiler_backend.compiler-backend-state-slot-cache-epoch state-b)
          b-epoch-before-a-reset)
        (=
          (compiler_backend.compiler-backend-state-slot-cache-capacity state-b)
          0)
        (=
          (compiler_backend.compiler-backend-state-frame-offset-cache-capacity
            state-b)
          0)
        (=
          (compiler_backend.compiler-backend-state-immediate-cache-capacity
            state-b)
          8192)
        (=
          (compiler_backend.compiler-backend-state-operand-cache-retained-bytes
            state-b)
          131072))]
    [_restore-caller : unit
      (unsafe
        (arena.set! caller))]
    [_destroy-scratch : unit
      (unsafe
        (arena.destroy scratch))]
    [active-after : arena.Arena (arena.current)]
    (and
      fresh-a
      fresh-b
      reset-empty
      after-render
      (= a-epoch-after-reset 3)
      b-unchanged
      (string.eq a-slot "-32(%rbp)")
      (string.eq a-frame "-40(%rbp)")
      (string.eq b-immediate "$7")
      (string.eq b-immediate-again b-immediate)
      (arena.eq? active-after caller))))

(define (compiler-backend-state-one-word-ok?) : bool
  (let
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new intern-state)]
    [name-id : i64
      (ci.intern-compat-state-intern intern-state "one_word_state")]
    [before-capacity : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
        backend-state)]
    [before-bytes : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-retained-bytes
        backend-state)]
    [before-emission-arena : i64
      (compiler_backend.compiler-backend-state-emission-arena backend-state)]
    [state-size : i64 (compiler_backend.compiler-backend-state-size)]
    [symbol : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        name-id)]
    (and
      (= (ci.intern-compat-state-pool-len intern-state) 1)
      (= before-capacity 0)
      (= before-bytes 0)
      (= before-emission-arena 0)
      (= state-size 8)
      (not
        (compiler_backend.compiler-backend-state-scalar-registers-enabled?
          backend-state))
      (string.eq symbol "_tl_one_word_state")
      (=
        (compiler_backend.compiler-backend-state-user-symbol-cache-count
          backend-state)
        1)
      (=
        (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
          backend-state)
        16)
      (=
        (compiler_backend.compiler-backend-state-user-symbol-cache-retained-bytes
          backend-state)
        512)
      (> (compiler_backend.compiler-backend-state-owner-arena backend-state) 0)
      (=
        (compiler_backend.compiler-backend-state-intern-table-id backend-state)
        (ci.intern-compat-state-table-id intern-state)))))

;; Twelve inserts fill the initial 16-slot cache below its 75% threshold;
;; the thirteenth forces a 16 -> 32 rehash.  Keep the same state for all
;; lookups so this also checks that rehash preserves old and newest entries.
(define (compiler-backend-user-symbol-cache-growth-ok?) : bool
  (let
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new intern-state)]
    [before-capacity : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
        backend-state)]
    [before-bytes : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-retained-bytes
        backend-state)]
    [before-count : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-count
        backend-state)]
    [id-a : i64 (ci.intern-compat-state-intern intern-state "growth_a")]
    [id-b : i64 (ci.intern-compat-state-intern intern-state "growth_b")]
    [id-c : i64 (ci.intern-compat-state-intern intern-state "growth_c")]
    [id-d : i64 (ci.intern-compat-state-intern intern-state "growth_d")]
    [id-e : i64 (ci.intern-compat-state-intern intern-state "growth_e")]
    [id-f : i64 (ci.intern-compat-state-intern intern-state "growth_f")]
    [id-g : i64 (ci.intern-compat-state-intern intern-state "growth_g")]
    [id-h : i64 (ci.intern-compat-state-intern intern-state "growth_h")]
    [id-i : i64 (ci.intern-compat-state-intern intern-state "growth_i")]
    [id-j : i64 (ci.intern-compat-state-intern intern-state "growth_j")]
    [id-k : i64 (ci.intern-compat-state-intern intern-state "growth_k")]
    [id-l : i64 (ci.intern-compat-state-intern intern-state "growth_l")]
    [id-m : i64 (ci.intern-compat-state-intern intern-state "growth_m")]
    [symbol-a : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-a)]
    [_symbol-b : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-b)]
    [_symbol-c : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-c)]
    [_symbol-d : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-d)]
    [_symbol-e : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-e)]
    [_symbol-f : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-f)]
    [_symbol-g : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-g)]
    [_symbol-h : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-h)]
    [_symbol-i : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-i)]
    [_symbol-j : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-j)]
    [_symbol-k : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-k)]
    [_symbol-l : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-l)]
    [after-twelve-count : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-count
        backend-state)]
    [after-twelve-capacity : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
        backend-state)]
    [after-twelve-bytes : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-retained-bytes
        backend-state)]
    [symbol-m : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-m)]
    [after-thirteen-count : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-count
        backend-state)]
    [after-thirteen-capacity : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
        backend-state)]
    [after-thirteen-bytes : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-retained-bytes
        backend-state)]
    [symbol-a-again : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-a)]
    [symbol-m-again : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        id-m)]
    [final-count : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-count
        backend-state)]
    [final-capacity : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
        backend-state)]
    (and
      (= before-capacity 0)
      (= before-bytes 0)
      (= before-count 0)
      (= after-twelve-count 12)
      (= after-twelve-capacity 16)
      (= after-twelve-bytes 512)
      (= after-thirteen-count 13)
      (= after-thirteen-capacity 32)
      (= after-thirteen-bytes 1024)
      (= final-count 13)
      (= final-capacity 32)
      (string.eq symbol-a "_tl_growth_a")
      (string.eq symbol-m "_tl_growth_m")
      (string.eq symbol-a-again symbol-a)
      (string.eq symbol-m-again symbol-m))))

;; Equal numeric IDs from different intern tables must remain isolated even
;; while the compatibility globals point at the other table.  The A/B states
;; are persistent across all four lookups, so a stale global-table cache hit is
;; observable immediately in the returned spelling.
(define (compiler-backend-user-symbol-cache-persistent-equal-id-ok?) : bool
  (let
    [active-before : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [intern-a : ci.InternCompatState (ci.intern-compat-state-new)]
    [intern-b : ci.InternCompatState (ci.intern-compat-state-new)]
    [id-a : i64 (ci.intern-compat-state-intern intern-a "persistent/a")]
    [id-b : i64 (ci.intern-compat-state-intern intern-b "persistent/b")]
    [state-a : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new intern-a)]
    [state-b : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new intern-b)]
    [symbol-a1 : String
      (begin
        (ci.intern-compat-state-install! intern-b)
        (compiler_backend.compiler-backend-state-user-symbol-id state-a id-a))]
    [symbol-b1 : String
      (begin
        (ci.intern-compat-state-install! intern-a)
        (compiler_backend.compiler-backend-state-user-symbol-id state-b id-b))]
    [symbol-a2 : String
      (begin
        (ci.intern-compat-state-install! intern-b)
        (compiler_backend.compiler-backend-state-user-symbol-id state-a id-a))]
    [symbol-b2 : String
      (begin
        (ci.intern-compat-state-install! intern-a)
        (compiler_backend.compiler-backend-state-user-symbol-id state-b id-b))]
    [count-a : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-count state-a)]
    [count-b : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-count state-b)]
    [_restore : unit (ci.intern-compat-state-install! active-before)]
    (and
      (= id-a id-b)
      (string.eq symbol-a1 "_tl_persistent_a")
      (string.eq symbol-a2 symbol-a1)
      (string.eq symbol-b1 "_tl_persistent_b")
      (string.eq symbol-b2 symbol-b1)
      (= count-a 1)
      (= count-b 1)
      (not (string.eq symbol-a1 symbol-b1)))))

;; Generated IDs live in the high end of the intern pool.  The user-symbol
;; cache must accept a valid generated ID without allocating a capacity-sized
;; table, while invalid IDs return empty and do not allocate or grow anything.
(define (compiler-backend-user-symbol-cache-generated-bound-ok?) : bool
  (let
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new intern-state)]
    [before-capacity : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
        backend-state)]
    [generated-id : i64
      (ci.intern-compat-state-generated-name intern-state "generated/high")]
    [generated-symbol : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        generated-id)]
    [after-generated-capacity : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
        backend-state)]
    [after-generated-count : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-count
        backend-state)]
    [invalid-symbol : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        (- 0 1))]
    [after-invalid-capacity : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
        backend-state)]
    [after-invalid-count : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-count
        backend-state)]
    (and
      (= before-capacity 0)
      (> generated-id (ci.intern-compat-state-pool-len intern-state))
      (ci.intern-compat-state-generated-id-active? intern-state generated-id)
      (string.eq generated-symbol "_tl_generated_high")
      (= after-generated-capacity 16)
      (= after-generated-count 1)
      (string.eq invalid-symbol "")
      (= after-invalid-capacity after-generated-capacity)
      (= after-invalid-count after-generated-count))))

;; IR-owned derived symbols live far above the intern pool's numeric window.
;; They must use the same state-owned sparse cache as ordinary/generated ids,
;; rather than allocating a table indexed by their high numeric value.
(define (compiler-backend-user-symbol-cache-derived-ir-ok?) : bool
  (let
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new intern-state)]
    [spelling : String "backend_cache_ir_owned_6274_unique_symbol"]
    [derived-id : i64 (compiler_ir_types.compiler-ir-symbol spelling)]
    [before-capacity : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
        backend-state)]
    [text : String
      (compiler_backend.compiler-backend-symbol-text-state
        backend-state
        derived-id)]
    [symbol-first : String
      (compiler_backend.compiler-backend-state-user-symbol-id
        backend-state
        derived-id)]
    [count-first : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-count
        backend-state)]
    [capacity-first : i64
      (compiler_backend.compiler-backend-state-user-symbol-cache-capacity
        backend-state)]
    [bytes-first : i64
