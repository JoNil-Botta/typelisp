(define (compiler-backend-scratch-vreg-fused-sibling-test-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
