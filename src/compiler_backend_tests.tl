(define (compiler-backend-avx512-mask-homes-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-program-target-with-mode
    (compiler-backend-vector-home-program
      (compiler_regalloc.compiler-reg-mask-home-function))
    (compiler_backend.CompilerBackendTarget.Linux)
    (compiler_backend.CompilerBackendMode.Avx512)
    (compiler_ir_types.compiler-source-spans-empty)
    true)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    kandw %k2, %k1, %k1\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    kandnw %k7, %k1, %k1\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    knotw %k1, %k1\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "register home unavailable")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-tail-mask-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-mask-register-id 1)))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r12))
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          2
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r13))
        compiler_regalloc.CompilerRegAssignmentList.Nil))))

(define (compiler-backend-avx512-tail-mask-emits?
  [index : compiler_ir_types.CompilerIrValue]
  [end-value : compiler_ir_types.CompilerIrValue]
  [lanes : i64]
  [want : String]) : bool
  (match (compiler_backend.compiler-backend-emit-avx512-tail-mask
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    "_tl_tail"
    (compiler_ir_types.compiler-ir-label "entry")
    (compiler-backend-avx512-tail-mask-assignments)
    0
    index
    end-value
    lanes
    (compiler_diagnostic.compiler-diagnostic-at-start "" ""))
    [(compiler_backend.ResultCompilerBackend.Ok asm) (string.eq asm want)]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-tail-mask-dynamic-zero-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-avx512-tail-mask
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    "_tl_tail"
    (compiler_ir_types.compiler-ir-label "entry")
    (compiler-backend-avx512-tail-mask-assignments)
    0
    (compiler_ir_types.CompilerIrValue.Var 1)
    (compiler_ir_types.CompilerIrValue.Var 2)
    8
    (compiler_diagnostic.compiler-diagnostic-at-start "" ""))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq %r13, %rcx\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    subq %r12, %rcx\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movl $1, %r9d\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    shll %cl, %r9d\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    kmovw %r9d, %k1\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    kxorw %k1, %k1, %k1\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "%rax"))
        (not (compiler_backend.compiler-backend-string-contains? asm "%eax"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    xorl %eax, %eax\n    kmovw %eax, %k1\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-tail-mask-ok?) : bool
  (and
    (compiler-backend-avx512-tail-mask-emits?
      (compiler_ir_types.CompilerIrValue.I64 8)
      (compiler_ir_types.CompilerIrValue.I64 8)
      8
      "    kxorw %k1, %k1, %k1\n")
    (compiler-backend-avx512-tail-mask-emits?
      (compiler_ir_types.CompilerIrValue.I64 10)
      (compiler_ir_types.CompilerIrValue.I64 13)
      8
      "    movl $7, %eax\n    kmovw %eax, %k1\n")
    (compiler-backend-avx512-tail-mask-emits?
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.CompilerIrValue.I64 8)
      8
      "    movl $255, %eax\n    kmovw %eax, %k1\n")
    (compiler-backend-avx512-tail-mask-emits?
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ir_types.CompilerIrValue.I64 3)
      64
      "    movq $7, %rax\n    kmovq %rax, %k1\n")
    (compiler-backend-avx512-tail-mask-dynamic-zero-ok?)))

