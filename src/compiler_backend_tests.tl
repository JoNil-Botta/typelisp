(define (compiler-parallel-move-edge-seq-empty) : pmove.CompilerParallelMoveEdgeSeq
  (pmove.CompilerParallelMoveEdgeSeq
    (__tl_make-array pmove.CompilerParallelMoveEdge 0)
    0))

(define (compiler-parallel-move-test-edge
  [id : i64]
  [dest : i64]
  [source : i64]) : pmove.CompilerParallelMoveEdge
  (ParallelMoveEdge id dest 0 source 0))

(define (compiler-parallel-move-test-seq-two
  [first : pmove.CompilerParallelMoveEdge]
  [second : pmove.CompilerParallelMoveEdge]) : pmove.CompilerParallelMoveEdgeSeq
  (let
    [edges : pmove.CompilerParallelMoveEdgeSeq
      (pmove.compiler-parallel-move-edge-seq-with-capacity 2)]
    (pmove.compiler-parallel-move-edge-push! (&mut edges) first)
    (pmove.compiler-parallel-move-edge-push! (&mut edges) second)
    edges))

(define (compiler-parallel-move-self-test?) : bool
  (let
    [empty : pmove.CompilerParallelMoveEdgeSeq
      (compiler-parallel-move-edge-seq-empty)]
    [chain : pmove.CompilerParallelMoveEdgeSeq
      (compiler-parallel-move-test-seq-two
        (compiler-parallel-move-test-edge 1 10 20)
        (compiler-parallel-move-test-edge 2 20 0))]
    [cycle : pmove.CompilerParallelMoveEdgeSeq
      (compiler-parallel-move-test-seq-two
        (compiler-parallel-move-test-edge 1 10 20)
        (compiler-parallel-move-test-edge 2 20 10))]
    [pair : pmove.CompilerParallelMoveEdgeSeq
      (compiler-parallel-move-test-seq-two
        (ParallelMoveEdge 3 12 13 14 15)
        (compiler-parallel-move-test-edge 4 8 13))]
    ;; A scalar destination must not clobber either half of a pair source
    ;; before the pair is copied. This is the reverse of `pair` above and is
    ;; the phi-carried group case: emit edge 5 first, then edge 6 may write
    ;; resource 12.
    [pair-source : pmove.CompilerParallelMoveEdgeSeq
      (compiler-parallel-move-test-seq-two
        (ParallelMoveEdge 5 8 0 12 13)
        (compiler-parallel-move-test-edge 6 12 20))]
    (and
      (match (pmove.compiler-parallel-move-decision empty empty)
        [(CompilerParallelMoveDone) true]
        [_ false])
      (match (pmove.compiler-parallel-move-decision chain chain)
        [(CompilerParallelMoveUnblocked id) (= id 1)]
        [_ false])
      (match (pmove.compiler-parallel-move-decision cycle cycle)
        [(CompilerParallelMoveCycle id) (= id 1)]
        [_ false])
      (match (pmove.compiler-parallel-move-decision pair pair)
        [(CompilerParallelMoveUnblocked id) (= id 4)]
        [_ false])
      (pmove.compiler-parallel-move-seq-has-blocked?
        (pmove.compiler-parallel-move-shared-view pair)
        pair)
      (match (pmove.compiler-parallel-move-decision pair-source pair-source)
        [(CompilerParallelMoveUnblocked id) (= id 5)]
        [_ false])
      (pmove.compiler-parallel-move-seq-has-blocked?
        (pmove.compiler-parallel-move-shared-view pair-source)
        pair-source))))

(define (compiler-object-image-dense? [_image : cobj.CompilerObjectImage]) : bool
  true)

(define (compiler-object-section-data-count
  [sections : (& sections cobj.CompilerObjectSectionList)]
  [kind : cobj.CompilerObjectSectionId]) : i64
  (match (cobj.compiler-object-section-list-find sections kind)
    [(Section _ data _) (cobj.compiler-object-data-record-list-count data)]))

(define (compiler-object-section-instr-count
  [sections : (& sections cobj.CompilerObjectSectionList)]
  [kind : cobj.CompilerObjectSectionId]) : i64
  (match (cobj.compiler-object-section-list-find sections kind)
    [(Section _ _ instrs) (cobj.compiler-object-instr-list-count instrs)]))

;; String literals and byte data both carry unterminated `Bytes`, and an empty
;; literal has no payload record at all.
(define (compiler-object-data-record-list-contains-payload?
  [records : cobj.CompilerObjectDataRecordList]
  [text : String]) : bool
  (let
    [count : i64 (cobj.compiler-object-data-record-list-count records)]
    [index : i64 0]
    [found : bool (= (string.string-length (& text)) 0)]
    (while (and (not found) (< index count))
      (if (match (cobj.compiler-object-data-record-list-ref records index)
        [(String value) (string.eq value text)]
        [(Bytes value) (string.eq value text)]
        [_ false])
        (set! found true)
        (+= index 1)))
    found))

(define (compiler-object-data-record-list-contains-f64?
  [records : cobj.CompilerObjectDataRecordList]
  [bits : u64]) : bool
  (let
    [count : i64 (cobj.compiler-object-data-record-list-count records)]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (cobj.compiler-object-data-record-list-ref records index)
        [(F64 value)
          (if (= value bits)
            (set! found true)
            (+= index 1))]
        [_ (+= index 1)]))
    found))

(define (compiler-object-data-record-list-contains-f32?
  [records : cobj.CompilerObjectDataRecordList]
  [bits : u64]) : bool
  (let
    [count : i64 (cobj.compiler-object-data-record-list-count records)]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (cobj.compiler-object-data-record-list-ref records index)
        [(F32 value)
          (if (= value bits)
            (set! found true)
            (+= index 1))]
        [_ (+= index 1)]))
    found))

(define (compiler-object-data-record-list-contains-align?
  [records : cobj.CompilerObjectDataRecordList]
  [align : i64]) : bool
  (let
    [count : i64 (cobj.compiler-object-data-record-list-count records)]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (cobj.compiler-object-data-record-list-ref records index)
        [(Align value)
          (if (= value align)
            (set! found true)
            (+= index 1))]
        [_ (+= index 1)]))
    found))

(define (compiler-object-data-record-list-contains-i64?
  [records : cobj.CompilerObjectDataRecordList]
  [value : i64]) : bool
  (let
    [count : i64 (cobj.compiler-object-data-record-list-count records)]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (cobj.compiler-object-data-record-list-ref records index)
        [(I64 found-value)
          (if (= found-value value)
            (set! found true)
            (+= index 1))]
        [_ (+= index 1)]))
    found))

(define (compiler-object-data-record-list-label-has-i64-pair?
  [records : cobj.CompilerObjectDataRecordList]
  [label : (& label str)]
  [first : i64]
  [second : i64]) : bool
  (let
    [count : i64 (cobj.compiler-object-data-record-list-count records)]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (cobj.compiler-object-data-record-list-ref records index)
        [(Label value)
          (if (and (string.eq value label) (< (+ index 2) count))
            (match (cobj.compiler-object-data-record-list-ref
              records
              (+ index 1))
              [(I64 first-found)
                (if (= first-found first)
                  (match (cobj.compiler-object-data-record-list-ref
                    records
                    (+ index 2))
                    [(I64 second-found)
                      (if (= second-found second)
                        (set! found true)
                        (+= index 1))]
                    [_ (+= index 1)])
                  (+= index 1))]
              [_ (+= index 1)])
            (+= index 1))]
        [_ (+= index 1)]))
    found))

(define (compiler-object-section-contains-string?
  [sections : (& sections cobj.CompilerObjectSectionList)]
  [kind : cobj.CompilerObjectSectionId]
  [text : String]) : bool
  (match (cobj.compiler-object-section-list-find sections kind)
    [(Section _ data _)
      (compiler-object-data-record-list-contains-payload? data text)]))

(define (compiler-object-section-contains-f64?
  [sections : (& sections cobj.CompilerObjectSectionList)]
  [kind : cobj.CompilerObjectSectionId]
  [bits : u64]) : bool
  (match (cobj.compiler-object-section-list-find sections kind)
    [(Section _ data _)
      (compiler-object-data-record-list-contains-f64? data bits)]))

(define (compiler-object-section-contains-f32?
  [sections : (& sections cobj.CompilerObjectSectionList)]
  [kind : cobj.CompilerObjectSectionId]
  [bits : u64]) : bool
  (match (cobj.compiler-object-section-list-find sections kind)
    [(Section _ data _)
      (compiler-object-data-record-list-contains-f32? data bits)]))

(define (compiler-object-section-contains-align?
  [sections : (& sections cobj.CompilerObjectSectionList)]
  [kind : cobj.CompilerObjectSectionId]
  [align : i64]) : bool
  (match (cobj.compiler-object-section-list-find sections kind)
    [(Section _ data _)
      (compiler-object-data-record-list-contains-align? data align)]))

(define (compiler-object-section-contains-i64?
  [sections : (& sections cobj.CompilerObjectSectionList)]
  [kind : cobj.CompilerObjectSectionId]
  [value : i64]) : bool
  (match (cobj.compiler-object-section-list-find sections kind)
    [(Section _ data _)
      (compiler-object-data-record-list-contains-i64? data value)]))

(define (compiler-object-section-label-has-i64-pair?
  [sections : (& sections cobj.CompilerObjectSectionList)]
  [kind : cobj.CompilerObjectSectionId]
  [label : (& label str)]
  [first : i64]
  [second : i64]) : bool
  (match (cobj.compiler-object-section-list-find sections kind)
    [(Section _ data _)
      (compiler-object-data-record-list-label-has-i64-pair?
        data
        label
        first
        second)]))

(define (compiler-object-instr-list-contains-call?
  [instrs : cobj.CompilerObjectX64InstrList]
  [target : String]) : bool
  (let
    [count : i64 (cobj.compiler-object-instr-list-count instrs)]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (cobj.compiler-object-instr-list-ref instrs index)
        [(Call value)
          (if (string.eq value target)
            (set! found true)
            (+= index 1))]
        [_ (+= index 1)]))
    found))

(define (compiler-object-section-contains-call?
  [sections : (& sections cobj.CompilerObjectSectionList)]
  [target : String]) : bool
  (match (cobj.compiler-object-section-list-find sections cobj.text-id)
    [(Section _ _ instrs)
      (compiler-object-instr-list-contains-call? instrs target)]))

(define (compiler-object-instr-list-contains-xorpd-rip?
  [instrs : cobj.CompilerObjectX64InstrList]
  [target : (& target str)]) : bool
  (let
    [count : i64 (cobj.compiler-object-instr-list-count instrs)]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (cobj.compiler-object-instr-list-ref instrs index)
        [(XorpdRip value)
          (if (string.eq value target)
            (set! found true)
            (+= index 1))]
        [_ (+= index 1)]))
    found))

(define (compiler-object-section-contains-xorpd-rip?
  [sections : cobj.CompilerObjectSectionList]
  [target : (& target str)]) : bool
  (match (cobj.compiler-object-section-list-find sections cobj.text-id)
    [(Section _ _ instrs)
      (compiler-object-instr-list-contains-xorpd-rip? instrs target)]))

(define (compiler-backend-collect-program-collections
  [program : ir.CompilerIrProgram]) : be_state.CompilerBackendProgramCollections
