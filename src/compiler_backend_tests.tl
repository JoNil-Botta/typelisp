(define (compiler-backend-callee-save-pop-epilogue-ok?) : bool
  (let
    [_abi : unit (compiler_backend.compiler-backend-set-current-fn-linux!)]
    [one : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments1)]
    [two : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments2)]
    [three : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments3)]
    [four : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments4)]
    [five : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments5)]
    [shared : String
      (compiler_backend.compiler-backend-return-epilogue
        (ci.intern "pop_shared")
        five
        1
        (compiler-backend-callee-save-double-return-blocks))]
    (and
      (compiler_backend.backend-and8
        (string.eq
          (compiler_backend.compiler-backend-emit-restore-callee-regs one 3)
          "    movq -32(%rbp), %r12\n")
        (string.eq
          (compiler_backend.compiler-backend-emit-restore-callee-regs two 3)
          "    leaq -40(%rbp), %rsp\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler_backend.compiler-backend-emit-restore-callee-regs three 2)
          "    leaq -40(%rbp), %rsp\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler_backend.compiler-backend-emit-restore-callee-regs four 2)
          "    leaq -48(%rbp), %rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler_backend.compiler-backend-emit-restore-callee-regs five 1)
          "    leaq -48(%rbp), %rsp\n    popq %rbx\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler_backend.compiler-backend-inline-return-tail two 3)
          "    leaq -40(%rbp), %rsp\n    popq %r13\n    popq %r12\n    leave\n    ret\n")
        (string.eq
          (compiler_backend.compiler-backend-tail-jump-tail four 2 "_tl_next")
          "    leaq -48(%rbp), %rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    leave\n    jmp _tl_next\n")
        (compiler_backend.compiler-backend-string-contains?
          shared
          "    popq %rbx\n"))
      (compiler_backend.compiler-backend-string-contains?
        shared
        "    leave\n    ret\n")
      (not (string.eq shared "")))))

(define (compiler-backend-callee-save-push-prologue-rebase-ok?) : bool
  (let
    [_abi : unit (compiler_backend.compiler-backend-set-current-fn-linux!)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-callee-save-assignments3)]
    [push-regs : (Array String)
      (compiler_backend.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (compiler_backend.compiler-backend-fill-push-csr-regs!
        assignments
        push-regs)]
    [prologue : String
      (compiler_backend.compiler-backend-emit-function-entry-fpo-push
        "_tl_gap1_push_unit"
        64
        push-regs
        push-count)]
    [post-prologue : String
      "    movq %r12, -32(%rbp)
    movq %r13, -40(%rbp)
    movq %r14, -48(%rbp)
    movq -8(%rbp), %rax
    leaq -48(%rbp), %rsp
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
"]
    [rebased : String
      (compiler_backend.compiler-backend-rsp-rebase-full
        post-prologue
        64
        true
        push-regs
        push-count
        3)]
    (and
      (= push-count 3)
      (string.eq
        prologue
        "_tl_gap1_push_unit:
    pushq %r12
    pushq %r13
    pushq %r14
    subq $64, %rsp
")
      (compiler_backend.compiler-backend-test-get-compiler-backend-rsp-rebase-last-ok)
      (string.eq
        rebased
        "    movq 56(%rsp), %rax
    addq $64, %rsp
    popq %r14
    popq %r13
    popq %r12
    ret
")
      (not
        (compiler_backend.compiler-backend-string-contains? rebased "-32(%rbp)"))
      (not
        (compiler_backend.compiler-backend-string-contains? rebased "-40(%rbp)"))
      (not
        (compiler_backend.compiler-backend-string-contains? rebased "-48(%rbp)"))
      (not
        (compiler_backend.compiler-backend-string-contains?
          rebased
          "    leave\n")))))

(define (compiler-backend-win64-callee-save-homes-ok?) : bool
  (let
    [_win : unit (compiler_backend.compiler-backend-set-current-fn-win64!)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-win64-callee-save-assignments)]
    [full : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-win64-callee-save-full-assignments)]
    [save : String
      (compiler_backend.compiler-backend-emit-save-callee-regs assignments 3)]
    [restore : String
      (compiler_backend.compiler-backend-emit-restore-callee-regs assignments 3)]
    [full-restore : String
      (compiler_backend.compiler-backend-emit-restore-callee-regs full 1)]
    [ok : bool
      (and
        (compiler_backend.compiler-backend-plan-uses-callee-regs? assignments)
        (= (compiler_backend.compiler-backend-frame-slots 3 assignments) 10)
        (= (compiler_backend.compiler-backend-frame-slots 1 full) 8)
        (string.eq
          save
          "    movq %r12, -32(%rbp)\n    movq %rsi, -72(%rbp)\n    movq %rdi, -80(%rbp)\n")
        (string.eq
          restore
          "    movq -80(%rbp), %rdi\n    movq -72(%rbp), %rsi\n    movq -32(%rbp), %r12\n")
        (not
          (compiler_backend.compiler-backend-string-contains? restore "popq"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            full-restore
            "popq"))
        (compiler_backend.compiler-backend-string-contains?
          full-restore
          "    movq -64(%rbp), %rdi\n")
        (compiler_backend.compiler-backend-string-contains?
          full-restore
          "    movq -56(%rbp), %rsi\n")
        (compiler_backend.compiler-backend-string-contains?
          full-restore
          "    movq -48(%rbp), %rbx\n"))]
    [_linux : unit (compiler_backend.compiler-backend-set-current-fn-linux!)]
    ok))

(define (compiler-backend-win64-fpo-seh-prologue-ok?) : bool
  (let
    [_win : unit (compiler_backend.compiler-backend-set-current-fn-win64!)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-win64-callee-save-rbp-assignments)]
    [push-regs : (Array String)
      (compiler_backend.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (compiler_backend.compiler-backend-fill-push-csr-regs!
        assignments
        push-regs)]
    [frame : i64
      (compiler_backend.compiler-backend-frame-size
        (compiler_backend.compiler-backend-frame-slots 1 assignments))]
    [prologue : String
      (compiler_backend.compiler-backend-emit-function-entry-fpo-windows
        "_tl_win64_fpo"
        frame
        assignments
        1
        push-regs
        push-count)]
    [safe-body : String
      "    movq %r12, -16(%rbp)
    movq -8(%rbp), %rax
    leaq -72(%rbp), %rsp
    popq %rbp
    popq %rdi
    popq %rsi
    popq %rbx
    popq %r15
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
"]
    [safe-rebased : String
      (compiler_backend.compiler-backend-rsp-rebase-full
        safe-body
        frame
        true
        push-regs
        push-count
        1)]
    [safe-ok : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-rsp-rebase-last-ok)]
    [_unsafe : String
      (compiler_backend.compiler-backend-rsp-rebase-full
        "    pushq %rax
    popq %rax
    leave
    ret
"
        32
        true
        (compiler_backend.compiler-backend-test-get-compiler-backend-rsp-rebase-no-push)
        0
        1)]
    [unsafe-rejected : bool
      (not
        (compiler_backend.compiler-backend-test-get-compiler-backend-rsp-rebase-last-ok))]
    [ok : bool
      (and
        (= push-count 8)
        (= (compiler_backend.compiler-backend-frame-slots 1 assignments) 9)
        (compiler_backend.compiler-backend-string-contains?
          (compiler_backend.compiler-backend-emit-save-callee-regs
            assignments
            1)
          "    movq %rbp, -72(%rbp)\n")
        (=
          (compiler_backend.compiler-backend-string-count
            prologue
            "    pushq %")
          8)
        (=
          (compiler_backend.compiler-backend-string-count
            prologue
            "    .seh_pushreg %")
          8)
        (compiler_backend.compiler-backend-string-contains?
          prologue
          "    pushq %rbp\n")
        (compiler_backend.compiler-backend-string-contains?
          prologue
          "    .seh_pushreg %rbp\n")
        (compiler_backend.compiler-backend-string-contains?
          prologue
          "    .seh_stackalloc 88\n")
        (compiler_backend.compiler-backend-string-contains?
          prologue
          "    .seh_endprologue\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            prologue
            ".seh_setframe"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            prologue
            "movq %rsp, %rbp"))
        safe-ok
        (not
          (compiler_backend.compiler-backend-string-contains?
            safe-rebased
            "(%rbp)"))
        (compiler_backend.compiler-backend-string-contains?
          safe-rebased
          "    popq %rbp\n")
        unsafe-rejected)]
    [_linux : unit (compiler_backend.compiler-backend-set-current-fn-linux!)]
    ok))

(define (compiler-backend-win64-xmm-callee-save-homes-ok?) : bool
  (let
    [_win : unit (compiler_backend.compiler-backend-set-current-fn-win64!)]
    [sparse : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-win64-xmm-sparse-assignments)]
    [full : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-win64-xmm-full-assignments)]
    [xmm15 : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-win64-xmm15-only-assignments)]
    [planned : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-plan-assignments
        (compiler_regalloc.compiler-reg-plan-function-scalar-for-abi
          compiler_abi.CompilerRegTargetAbi.Windows
          (compiler_regalloc.compiler-reg-f64-call-live-function)))]
