        bases
        target
        exhausted-assignments
        (ir.compiler-ir-param-seq-prepend
          (Param "mixed" (owned_view.compiler-owned-shared-view mixed-group) 0)
          (irt.params "tail=%1:f64"))
        6
        0
        6
        0
        index
        2
        index.backend-state)]
    [exhausted-param : String
      (match exhausted-param-result
        [(Ok text) text]
        [(Err _) ""])]
    (and
      (not
        (be_calls.compiler-backend-linux-group-register-banks-fit?
          bases
          target
          (Platform)
          index
          int-group
          5
          0
          5))
      (be_calls.compiler-backend-linux-group-register-banks-fit?
        bases
        target
        (Platform)
        index
        (owned_view.compiler-owned-shared-view mixed-group)
        0
        0
        0)
      (not
        (be_calls.compiler-backend-linux-group-register-banks-fit?
          bases
          target
          (Platform)
          index
          (owned_view.compiler-owned-shared-view mixed-group)
          6
          0
          6))
      (not
        (be_calls.compiler-backend-linux-group-register-banks-fit?
          bases
          target
          (Platform)
          index
          mixed-group
          0
          8
          8))
      (=
        (be_calls.compiler-backend-call-stack-arg-count
          bases
          target
          (Platform)
          pressure-args
          pressure-types
          false
          0
          0
          0
          0
          0
          index)
        2)
      (=
        (be_calls.compiler-backend-type-list-stack-arg-count
          bases
          target
          (Platform)
          pressure-types
          0
          0
          0
          0
          index)
        2)
      (asm-has?
        pressure-call
        "    movl $11, %edi\n"
        "    movl $12, %esi\n"
        "    movl $13, %edx\n"
        "    movl $14, %ecx\n"
        "    movl $15, %r8d\n"
        "    movq %r12, %r10\n    movq %r10, 0(%rsp)\n"
        "    movq %r13, %r10\n    movq %r10, 8(%rsp)\n"
        "    movl $16, %r9d\n")
      (asm-lacks? pressure-call "    movq %r12, %r9\n" "    movq %r13, %r9\n")
      (asm-has?
        pressure-param
        "    movq 16(%rbp), %r12\n"
        "    movq 24(%rbp), %r13\n"
        "    movq %r9, %r15\n")
      (asm-lacks? pressure-param "    movq %r9, %r12\n" "    movq %r9, %r13\n")
      (asm-has? memory-param "    movq %r9, %r15\n")
      (<
        (backend.compiler-backend-string-find-from
          memory-param
          "    movq %r9, %r15\n"
          0)
        (backend.compiler-backend-string-find-from
          memory-param
          "    movq 16(%rbp), "
          0))
      (asm-has?
        memory-param
        "    movq 16(%rbp), %r9\n    movq %r9, -8(%rbp)\n"
        "    movq 24(%rbp), %r9\n    movq %r9, -16(%rbp)\n")
      (asm-lacks?
        memory-param
        "    movq 16(%rbp), %rdi\n"
        "    movq 16(%rbp), %rsi\n"
        "    movq 16(%rbp), %rdx\n"
        "    movq 16(%rbp), %rcx\n"
        "    movq 16(%rbp), %r8\n"
        "    movq 16(%rbp), %r15\n"
        "    movq 24(%rbp), %rdi\n"
        "    movq 24(%rbp), %rsi\n"
        "    movq 24(%rbp), %rdx\n"
        "    movq 24(%rbp), %rcx\n"
        "    movq 24(%rbp), %r8\n"
        "    movq 24(%rbp), %r15\n")
      (=
        (be_calls.compiler-backend-call-stack-arg-count
          bases
          target
          (Platform)
          mixed-args
          mixed-types
          false
          0
          0
          0
          0
          0
          index)
        0)
      (asm-has? mixed-call "    movq %r12, %rdi\n" "    movsd %xmm3, %xmm0\n")
      (asm-lacks? mixed-call "(%rsp)")
      (asm-has? mixed-param "    movq %rdi, %r12\n" "    movsd %xmm0, %xmm3\n")
      (=
        (be_calls.compiler-backend-call-stack-arg-count
          bases
          target
          (Platform)
          exhausted-args
          exhausted-types
          false
          0
          6
          0
          6
          0
          index)
        2)
      (=
        (be_calls.compiler-backend-type-list-stack-arg-count
          bases
          target
          (Platform)
          exhausted-types
          6
          0
          6
          0
          index)
        2)
      (asm-has?
        exhausted-call
        "    movq %r12, %r10\n    movq %r10, 0(%rsp)\n"
        "    movq %xmm3, %r10\n    movq %r10, 8(%rsp)\n"
        "    movsd %xmm4, %xmm0\n")
      (asm-lacks? exhausted-call "    movsd %xmm3, %xmm0\n")
      (asm-has?
        exhausted-param
        "    movq 16(%rbp), %r12\n"
        "    movsd 24(%rbp), %xmm3\n"
        "    movsd %xmm0, %xmm4\n")
      (asm-lacks? exhausted-param "    movsd %xmm0, %xmm3\n"))))

;; Refs #7820. Exhaust every address-exposure mask for eight live groups.
;; Compare the actual operand route used by copies/calls, so a legacy second
;; word cannot alias either word of a different address-exposed pair.
(define (compiler-backend-mixed-group-stack-homes-ok?) : bool
  (let
    [state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [groups : compiler_liveness.CompilerLiveI64Set
      (compiler_liveness.compiler-live-set-empty)]
    [slots : (__tl_dyn-array String) (__tl_make-array String 16)]
    (for [index (iterator.range 0 8)]
      (set! groups (compiler_liveness.compiler-live-set-insert groups index)))
    (for [mask (iterator.range 0 256)]
      (let
        [addressable : compiler_liveness.CompilerLiveI64Set
          (compiler_liveness.compiler-live-set-empty)]
        (for [index (iterator.range 0 8)]
          (when
            (not (= (bit-and mask (shl 1 index)) 0))
            (set!
              addressable
              (compiler_liveness.compiler-live-set-insert addressable index))))
        (be_facts.compiler-backend-group-vars-enable!
          state
          (owned_view.compiler-owned-shared-view groups)
          addressable)
        (for [index (iterator.range 0 16)]
          (match (be_scalar.compiler-backend-group-word-operand-with-backend-state
            (regalloc.compiler-reg-assignment-table-empty)
            (/ index 2)
            (% index 2)
            8
            state)
            [(Ok operand)
              (for [previous (iterator.range 0 index)]
                (when
                  (string.eq operand (array-ref slots previous))
                  (return false)))
              (set! (array-ref slots index) operand)]
            [(Err _) (return false)]))))
    true))

(define (compiler-backend-stack-args-ok?) : bool
  (and
    (compiler-backend-mixed-group-stack-homes-ok?)
    (compiler-backend-stack-int-args-ok?)
    (compiler-backend-stack-f64-args-ok?)
    (compiler-backend-stack-mixed-args-ok?)
    (compiler-backend-stack-windows-args-ok?)
    (compiler-backend-stack-f32-arg-bits-ok?)
    (compiler-backend-group-stack-f64-arg-bits-ok?)
    (compiler-backend-group-stack-param-no-return-stage-ok?)
    (compiler-backend-group-stack-param-prebody-pressure-ok?)
    (compiler-backend-linux-atomic-group-allocation-ok?)
    (compiler-backend-immediate-stack-call-args-ok?)))

(define (compiler-backend-asm-function-body
  [asm : (& asm str)]
  [symbol : String]) : String
  (let
    [label : String (str_cat.str-cat symbol ":\n")]
    [start : i64 (backend.compiler-backend-string-find-from asm label 0)]
    (if (< start 0)
      ""
      (let
        [body-start : i64 (+ start (string.string-length label))]
        [plain-next : i64
          (backend.compiler-backend-string-find-from asm "\n.globl " body-start)]
        [indented-next : i64
          (backend.compiler-backend-string-find-from
            asm
            "\n    .globl "
            body-start)]
        [next : i64
          (if (< plain-next 0)
            indented-next
            (if (and (>= indented-next 0) (< indented-next plain-next))
              indented-next
              plain-next))]
        [body-end : i64
          (if (< next 0)
            (string.string-length asm)
            next)]
        (string.substring asm body-start (- body-end body-start))))))

(define (compiler-backend-direct-tail-call-reg0
  [target : be_state.CompilerBackendTarget]) : String
  (if (be_facts.compiler-backend-target-windows? target)
    "%rcx"
    "%rdi"))

(define (compiler-backend-direct-tail-call-reg1
  [target : be_state.CompilerBackendTarget]) : String
  (if (be_facts.compiler-backend-target-windows? target)
    "%rdx"
    "%rsi"))

(define (compiler-backend-direct-tail-call-param-store
  [reg : (& reg str)]
  [slot : String]) : String
  (str_cat.str-cat "    movq " reg ", " slot "\n"))

(define (compiler-backend-direct-tail-call-param-load
  [slot : String]
  [reg : String]) : String
  (str_cat.str-cat "    movq " slot ", " reg "\n"))

(define (compiler-backend-direct-tail-call-identity-elided?
  [target : be_state.CompilerBackendTarget]
  [asm : String]) : bool
  (let
    [body : String (compiler-backend-asm-function-body asm "_tl_step")]
    [reg0 : String (compiler-backend-direct-tail-call-reg0 target)]
    [reg1 : String (compiler-backend-direct-tail-call-reg1 target)]
    (and
      (asm-has? body "    jmp _tl_finish\n")
      (asm-lacks? body "    call _tl_finish\n")
      (asm-lacks? body (str_cat.str-cat "    movq " reg0 ", "))
      (asm-lacks? body (str_cat.str-cat "    movq " reg1 ", "))
      (not
        (let
          [needle
            (compiler-backend-direct-tail-call-param-store reg0 "-8(%rbp)")]
          (asm-has? body needle)))
      (not
        (let
          [needle
            (compiler-backend-direct-tail-call-param-store reg1 "-16(%rbp)")]
          (asm-has? body needle)))
      (not
        (let
          [needle
            (compiler-backend-direct-tail-call-param-load "-8(%rbp)" reg0)]
          (asm-has? body needle)))
      (not
        (let
          [needle
            (compiler-backend-direct-tail-call-param-load "-16(%rbp)" reg1)]
          (asm-has? body needle))))))

(define (compiler-backend-direct-tail-call-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-source)
    target)
    [(Ok asm)
      (and
        (asm-has? asm "    jmp _tl_finish\n")
        (asm-lacks? asm "    call _tl_finish\n")
        (compiler-backend-direct-tail-call-identity-elided? target asm))]
    [(Err _) false]))

;; Under FPO the source params spill to rsp-relative slots whose offsets
;; depend on each fixture's frame size (and target), so slot0/slot1 are passed
;; per call site. On Linux these forwarders are call-free (a tail `jmp` is not
;; a call), so T1-6 (a) puts their slots in the RED ZONE and the offsets are
;; negative; Win64 has no red zone and keeps its positive frame. A "" slot1
;; means the second param is not spilled (correctly optimised away — e.g. the
;; `finish x x` duplicated fixture, where the dead y param is never stored).
(define (compiler-backend-direct-tail-call-i64-keeps-spills?
  [source : String]
  [target : be_state.CompilerBackendTarget]
  [slot0 : String]
  [slot1 : String]) : bool
  (match (backend.compiler-backend-emit-source-for-target source target)
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_step")]
        [reg0 : String (compiler-backend-direct-tail-call-reg0 target)]
        [reg1 : String (compiler-backend-direct-tail-call-reg1 target)]
        (and
          (asm-has? body "    jmp _tl_finish\n")
          (let
            [needle (compiler-backend-direct-tail-call-param-store reg0 slot0)]
            (asm-has? body needle))
          (if (string.eq slot1 "")
            true
            (let
              [needle
                (compiler-backend-direct-tail-call-param-store reg1 slot1)]
              (asm-has? body needle)))))]
    [(Err _) false]))

;; Under FPO the f64 params spill to rsp-relative slots (offsets differ by
;; target), passed per call site.
(define (compiler-backend-direct-tail-call-f64-keeps-spills?
  [target : be_state.CompilerBackendTarget]
  [slot0 : String]
  [slot1 : String]) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-f64-source)
    target)
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_stepf")]
        (and
          (asm-has? body "    jmp _tl_finishf\n")
          (let
            [needle
              (str_cat.str-cat "    movsd %xmm0, " (str_cat.str-cat slot0 "\n"))]
            (asm-has? body needle))
          (let
            [needle
              (str_cat.str-cat "    movsd %xmm1, " (str_cat.str-cat slot1 "\n"))]
            (asm-has? body needle))))]
    [(Err _) false]))

(define (compiler-backend-direct-tail-call-stack-slot
  [target : be_state.CompilerBackendTarget]) : String
  (if (be_facts.compiler-backend-target-windows? target)
    ;; Win64 FPO rebases the outgoing tail stack-arg store (no Internal shadow).
    "    movq %r10, 96(%rsp)\n"
    ;; FPO makes the Linux outgoing tail stack-arg store rsp-relative.
    "    movq %r10, 96(%rsp)\n"))

(define (compiler-backend-direct-tail-call-stack-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-stack-source)
    target)
    [(Ok asm)
      (and
        (asm-has? asm "    jmp _tl_finishstack\n")
        (asm-lacks? asm "    call _tl_finishstack\n" "    pushq %r11\n")
        (let
          [needle (compiler-backend-direct-tail-call-stack-slot target)]
          (asm-has? asm needle)))]
    [(Err _) false]))

(define (compiler-backend-direct-tail-immediate-stack-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (be_calls.compiler-backend-emit-direct-tail-call-args
    (ast.ast-node-pool-reader-type-segment-bases)
    target
    (Platform)
    (regalloc.compiler-reg-assignment-table-empty)
    (compiler-backend-i64-immediate-call-args8)
    (compiler-backend-i64-type-list8)
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (if (be_facts.compiler-backend-target-windows? target)
        (and
          (asm-has? asm "    movq $5, 16(%rbp)\n" "    movq $8, 40(%rbp)\n")
          (asm-lacks? asm "    pushq %r11\n"))
        (and
          (asm-has? asm "    movq $7, 16(%rbp)\n" "    movq $8, 24(%rbp)\n")
          (asm-lacks? asm "    pushq %r11\n")))]
    [(Err _) false]))

(define (compiler-backend-direct-tail-call-mixed-slot
  [target : be_state.CompilerBackendTarget]) : String
  (if (be_facts.compiler-backend-target-windows? target)
    ;; Win64 FPO rebases the outgoing mixed tail stack-arg store (no shadow).
    "    movq %r10, 296(%rsp)\n"
    ;; FPO makes the Linux outgoing tail stack-arg store rsp-relative.
    "    movq %r10, 160(%rsp)\n"))

(define (compiler-backend-direct-tail-call-mixed-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-mixed-source)
    target)
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_stepmixed")]
        (and
          (asm-has? body "    jmp _tl_finishmixed\n")
          (asm-lacks? body "    call _tl_finishmixed\n" "    subq $8, %rsp\n")
          (let
            [needle (compiler-backend-direct-tail-call-mixed-slot target)]
            (asm-has? body needle))))]
    [(Err _) false]))

;; A typed snapshot of an unchanged parameter can preserve identity forwarding.
;; Mutated parameters, duplicate destinations, narrowing and unknown operands
;; must retain ordinary emission and parameter homes.
(define (compiler-backend-identity-snapshot-admitted?
  [prefix : ir.CompilerIrInstrSeq]
  [arg : i64]) : bool
  (let
    [params : ir.CompilerIrParamSeq
      (ir.compiler-ir-param-seq-prepend
        (ir.CompilerIrParam.Param "x" (ast.AstType.I64) 0)
        (ir.compiler-ir-param-seq-empty))]
    [body : ir.CompilerIrInstrBuilder (ir.compiler-ir-instr-builder-new)]
    [_body : unit
      (begin
        (ir.compiler-ir-instr-builder-append-seq-range!
          (&mut body)
          prefix
          0
          prefix.len)
        (ir.compiler-ir-instr-builder-push!
          (&mut body)
          (ir.CompilerIrInstr.TailCall
            (ci.intern "known_target")
            (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var arg))
            (ast.AstType.I64))))]
    [block : ir.CompilerIrBlock
      (ir.CompilerIrBlock.Block
        (ci.intern "entry")
        (ir.compiler-ir-instr-builder-to-seq body))]
    (be_calls.compiler-backend-identity-tail-forwarder-block?
      (ast.ast-node-pool-reader-type-segment-bases)
      (be_state.CompilerBackendTarget.Linux)
      (ci.intern "snapshot_forwarder")
      params
      (& block)
      (compiler-backend-known-function-call-index))))

(define (compiler-backend-identity-snapshot-proof-ok?) : bool
  (and
    (compiler-backend-identity-snapshot-admitted?
      (ir.compiler-ir-instr-seq-empty)
      0)
    (compiler-backend-identity-snapshot-admitted?
      (irt.instrs "%1 = mov %0 : i64")
      1)
    (not
      (compiler-backend-identity-snapshot-admitted?
        (irt.instrs "%0 = mov %0 : i64")
        0))
    (not
      (compiler-backend-identity-snapshot-admitted?
        (irt.instrs "%1 = mov %0 : i64
                   %1 = mov %0 : i64")
        1))
    (not
      (compiler-backend-identity-snapshot-admitted?
        (irt.instrs "%1 = mov 99 : i64")
        1))
    (not
      (compiler-backend-identity-snapshot-admitted?
        (irt.instrs "%1 = mov %0 : i32")
        1))
    (not
      (compiler-backend-identity-snapshot-admitted?
        (irt.instrs "%1 = mov %7 : i64")
        1))
    (not
      (compiler-backend-identity-snapshot-admitted?
        (irt.instrs "%1 = addr_of %0")
        1))
    (not
      (compiler-backend-identity-snapshot-admitted?
        (irt.instrs "%1 = mov %0 : i64")
        2))))

;; Authored IR bypasses the lowering tail-call guard. Frame-address provenance
;; must also protect every backend jump path, including register-only arguments.
(define (compiler-backend-frame-tail-program [route : i64]) : ir.CompilerIrProgram
  (let
    [reader-id : i64 (ci.intern "frame_reader")]
    [pointer-type : ast.AstType (ast.ast-ty-ptr (& (ast.AstType.I64)))]
    [reader-types : ast.AstTypeList
      (ast.ast-type-cons (& pointer-type) (& (ast.ast-type-list-new)))]
    [callee-type : ast.AstType
      (ast.ast-ty-func
        (owned_view.compiler-owned-shared-view reader-types)
        (& (ast.AstType.I64)))]
    [tail : ir.CompilerIrInstr
      (if (= route 2)
        (ir.CompilerIrInstr.TailCallIndirect
          (ir.CompilerIrValue.Var 0)
          (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var 4))
          (ast.AstType.I64))
        (ir.CompilerIrInstr.TailCall
          reader-id
          (ir.CompilerIrCallArgs.One (ir.CompilerIrValue.Var 4))
          (ast.AstType.I64)))]
    [prefix : ir.CompilerIrInstrSeq
      (irt.instrs
        "%1 = mov 42 : i64
                   %2 = addr_of %1
                   %3 = cast %2 : u64 to u64
                   %4 = gep %3, 0 : u8")]
    [body : ir.CompilerIrInstrBuilder (ir.compiler-ir-instr-builder-new)]
    [_body : unit
      (begin
        (ir.compiler-ir-instr-builder-append-seq-range! (&mut body) prefix 0 4)
        (ir.compiler-ir-instr-builder-push! (&mut body) tail))]
    [caller : ir.CompilerIrFunction
      (ir.CompilerIrFunction.Function
        (ci.intern "frame_tail")
        (ir.compiler-ir-param-seq-prepend
          (ir.CompilerIrParam.Param "callback" callee-type 0)
          (ir.compiler-ir-param-seq-empty))
        (ast.AstType.I64)
        5
        (let
          [cons-builder (ir.compiler-ir-block-builder-new)]
          (ir.compiler-ir-block-builder-push!
            (&mut cons-builder)
            (ir.CompilerIrBlock.Block
              (ci.intern "entry")
              (ir.compiler-ir-instr-builder-to-seq body)))
          (ir.compiler-ir-block-builder-append-list!
            (&mut cons-builder)
            (ir.compiler-ir-block-list-empty))
          (ir.compiler-ir-block-builder-to-list cons-builder))
        ir.CompilerIrFunctionAbi.Ordinary)]
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        caller
        (&
          (ir.compiler-ir-function-seq1
            (&
              (ir.CompilerIrFunction.Function
                (ci.intern "main")
                (ir.compiler-ir-param-seq-empty)
                (ast.AstType.I64)
                0
                (irt.blocks "entry:
               return 42")
                ir.CompilerIrFunctionAbi.Ordinary)))))]
    [externs : ir.CompilerIrExternSeq (ir.compiler-ir-extern-seq-empty)]
    (if (= route 1)
      (set!
        externs
        (ir.compiler-ir-extern-seq1
          (compiler-backend-non-direct-tail-call-extern
            reader-id
            "frame_reader"
            (ci.intern "tl_frame_reader")
            reader-types
            (ast.AstType.I64)
            (ast.AstExternAbi.C))))
      (set!
        functions
        (ir.compiler-ir-function-seq-prepend
          (&
            (ir.CompilerIrFunction.Function
              reader-id
              (ir.compiler-ir-param-seq-prepend
                (ir.CompilerIrParam.Param "value" pointer-type 0)
                (ir.compiler-ir-param-seq-empty))
              (ast.AstType.I64)
              2
              (irt.blocks
                "entry:
                 %1 = load %0 : i64
                 return %1")
              ir.CompilerIrFunctionAbi.Ordinary))
          functions)))
    (ir.CompilerIrProgram.Program
      (ir.compiler-ir-global-seq-empty)
      functions
      externs
      (ir.CompilerIrReturnStorageAuthority.None))))

(define (compiler-backend-frame-tail-target-ok?
  [target : be_state.CompilerBackendTarget]
  [route : i64]) : bool
  (match (backend.compiler-backend-emit-program-for-target
    (compiler-backend-frame-tail-program route)
    target)
    [(be_state.ResultCompilerBackend.Ok asm)
      (let
        [body : String
          (compiler-backend-asm-function-body asm "_tl_frame_tail")]
        (if (= route 2)
          (and
            (asm-has? body "    call *(%r10)\n")
            (asm-lacks? body "    jmp *(%r10)\n"))
          (let
            [callee : String
              (if (= route 1)
                "tl_frame_reader"
                "_tl_frame_reader")]
            (and
              (asm-has? body (str_cat.str-cat "    call " callee "\n"))
              (asm-lacks? body (str_cat.str-cat "    jmp " callee "\n"))))))]
    [(be_state.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-frame-tail-ok?) : bool
  (let
    [route : i64 0]
    (while (< route 3)
      (unless
        (and
          (compiler-backend-frame-tail-target-ok?
            (be_state.CompilerBackendTarget.Linux)
            route)
          (compiler-backend-frame-tail-target-ok?
            (be_state.CompilerBackendTarget.Windows)
            route))
        (return false))
      (set! route (+ route 1)))
    true))

(define (compiler-backend-direct-tail-call-ok?) : bool
  (and
    (be_state.backend-and8
      (compiler-backend-direct-tail-call-target-ok?
        (be_state.CompilerBackendTarget.Linux))
      (compiler-backend-direct-tail-call-target-ok?
        (be_state.CompilerBackendTarget.Windows))
      (compiler-backend-direct-tail-call-stack-target-ok?
        (be_state.CompilerBackendTarget.Linux))
      (compiler-backend-direct-tail-call-stack-target-ok?
        (be_state.CompilerBackendTarget.Windows))
      (compiler-backend-direct-tail-immediate-stack-target-ok?
        (be_state.CompilerBackendTarget.Linux))
      (compiler-backend-direct-tail-immediate-stack-target-ok?
        (be_state.CompilerBackendTarget.Windows))
      (compiler-backend-direct-tail-call-mixed-target-ok?
        (be_state.CompilerBackendTarget.Linux))
      (compiler-backend-direct-tail-call-mixed-target-ok?
        (be_state.CompilerBackendTarget.Windows)))
    (be_state.backend-and8
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-reordered-source)
        (be_state.CompilerBackendTarget.Linux)
        "-8(%rsp)"
        "-16(%rsp)")
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-reordered-source)
        (be_state.CompilerBackendTarget.Windows)
        "8(%rsp)"
        "0(%rsp)")
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-duplicated-source)
        (be_state.CompilerBackendTarget.Linux)
        "-8(%rsp)"
        "")
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-duplicated-source)
        (be_state.CompilerBackendTarget.Windows)
        "8(%rsp)"
        "")
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-nontrivial-source)
        (be_state.CompilerBackendTarget.Linux)
        "-8(%rsp)"
        "-16(%rsp)")
      (compiler-backend-direct-tail-call-i64-keeps-spills?
        (compiler-backend-direct-tail-call-nontrivial-source)
        (be_state.CompilerBackendTarget.Windows)
        "24(%rsp)"
        "16(%rsp)")
      (compiler-backend-direct-tail-call-f64-keeps-spills?
        (be_state.CompilerBackendTarget.Linux)
        "-8(%rsp)"
        "-16(%rsp)")
      (compiler-backend-direct-tail-call-f64-keeps-spills?
        (be_state.CompilerBackendTarget.Windows)
        "8(%rsp)"
        "0(%rsp)"))))

(define (compiler-backend-indirect-tail-call-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-indirect-tail-call-source)
    target)
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_step")]
        (and
          (asm-has? body "    jmp *(%r10)\n")
          (asm-lacks?
            body
            "    jmp *%rax\n"
            "    jmp *(%r11)\n"
            "    movq (%r10), %rax\n")))]
    [(Err _) false]))

(define (compiler-backend-indirect-tail-call-stack-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-indirect-tail-call-stack-source)
    target)
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_step6")]
        (and
          (asm-has? body "    call *(%r10)\n")
          (asm-lacks?
            body
            "    jmp *(%r10)\n"
            "    call *%rax\n"
            "    call *(%r11)\n"
            "    movq (%r10), %rax\n")))]
    [(Err _) false]))

(define (compiler-backend-indirect-tail-call-r11-callee-asm
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (let
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [_abi : unit
      (be_state.compiler-backend-set-current-fn-abi!
        backend-state
        (be_state.compiler-backend-target-abi target))]
    [saved : EmitterScratch (emitter-scratch-save backend-state)]
    [callee-ty : ast.AstType
      (ast.ast-ty-func (ast.ast-type-list-new) (& (I64)))]
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r11")]
    [types : regalloc.CompilerRegVarTypes
      (regalloc.compiler-reg-var-types-insert
        (regalloc.compiler-reg-var-types-empty)
        0
        callee-ty)]
    [blocks : ir.CompilerIrBlockList
      (irt.blocks "entry:
           tailcall* %0() : i64")]
    [callee-id : i64 (ci.intern "indirect_tail_call_r11_callee_shape")]
    [_ctx : unit
      (begin
        (compiler-backend-test-scavenge-install-ctx!
          "indirect_tail_call_r11_callee_shape"
          (ir.compiler-ir-param-seq-empty)
          (I64)
          1
          (owned_view.compiler-owned-shared-view blocks)
          assignments
          backend-state)
        (set-state-emit-instr-post-base! backend-state 1)
        (set-state-emit-current-count! backend-state 1))]
    [result : be_state.ResultCompilerBackend
      (backend.compiler-backend-emit-tail-indirect-call
        (ast.ast-node-pool-reader-type-segment-bases)
        target
        callee-id
        blocks
        (ir.compiler-ir-label "entry")
        (Var 0)
        (Nil)
        (I64)
        assignments
        types
        1
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty)
        program-index
        (cdiag.compiler-diagnostic-at-start "" "")
        backend-state)]
    [_restore : unit (emitter-scratch-restore! backend-state saved)]
    result))

(define (compiler-backend-indirect-tail-call-r11-callee-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (compiler-backend-indirect-tail-call-r11-callee-asm target)
    [(Ok asm)
      (and
        (asm-has? asm "    movq %r11, %r10\n")
        (let
          [needle
            (str_cat.str-cat
              "    movq 8(%r10), "
              (match (be_facts.compiler-backend-target-arg-reg
                target
                (Platform)
                0)
                [(Ok reg) reg]
                [(Err _) ""])
              "\n")]
          (asm-has? asm needle))
        (asm-has? asm "    jmp *(%r10)\n")
        (asm-lacks? asm "    jmp *(%r11)\n"))]
    [(Err _) false]))

(define (compiler-backend-non-direct-tail-call-extern
  [name-id : i64]
  [name : String]
  [symbol-id : i64]
  [params : ast.AstTypeList]
  [ret : ast.AstType]
  [abi : ast.AstExternAbi]) : ir.CompilerIrExtern
  (Extern
    name-id
    name-id
    name
    (ast.ast-ty-func params (& ret))
    abi
    symbol-id
    (ast.ast-extern-link-input-list-new)
    false
    (ir.CompilerIrReturnStorage.None)
    false
    (ir.CompilerIrGlobalStorage.Word)))

(define (compiler-backend-non-direct-tail-call-emit
  [target : be_state.CompilerBackendTarget]
  [name : String]
  [symbol : String]
  [params : ast.AstTypeList]
  [ret : ast.AstType]
  [abi : ast.AstExternAbi]
  [args : ir.CompilerIrCallArgs]) : be_state.ResultCompilerBackend
  (let
    [name-id : i64 (ci.intern (owned_view.compiler-owned-shared-view name))]
    [caller-id : i64 (ci.intern "caller")]
    [externs : ir.CompilerIrExternSeq
      (ir.compiler-ir-extern-seq1
        (compiler-backend-non-direct-tail-call-extern
          name-id
          name
          (ci.intern symbol)
          params
          (owned_view.compiler-owned-shared-view ret)
          abi))]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (be_state.compiler-backend-global-shared-view externs))]
    (match (compiler-backend-runtime-plan-for
      (ir.compiler-ir-function-seq-empty)
      (be_state.compiler-backend-global-shared-view externs))
      [(Ok plan)
        (be_calls.compiler-backend-emit-tail-call
          (ast.ast-node-pool-reader-type-segment-bases)
          target
          caller-id
          (ir.compiler-ir-block-list-empty)
          (ir.compiler-ir-label "entry")
          name-id
          args
          ret
          (regalloc.compiler-reg-assignment-table-empty)
          (regalloc.compiler-reg-var-types-empty)
          (Empty)
          0
          plan
          (ir.compiler-ir-function-seq-empty)
          externs
          index
          (cdiag.compiler-diagnostic-at-start "" "")
          index.backend-state)]
      [(Err message)
        (Err (box (cdiag.compiler-diagnostic-at-start "" message)))])))

(define (compiler-backend-non-direct-tail-call-i64-emit
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (compiler-backend-non-direct-tail-call-emit
    target
    "tail_target"
    "tl_tail_target"
    (ast.ast-type-cons (& (I64)) (& (ast.ast-type-list-new)))
    (I64)
    (C)
    (One (I64 42))))

(define (compiler-backend-non-direct-tail-call-unit-emit
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (compiler-backend-non-direct-tail-call-emit
