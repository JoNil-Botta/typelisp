    "shift_trap"
    (compiler-ir-instr-cons
      (CompilerIrInstr.Call
        5
        (ci.intern "tl_shift_abort")
        (CompilerIrCallArgs.Nil)
        (AstType.Unit))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Jump "shift_ok")
