(define (compiler-backend-spill-immediate-binop-home-ok?) : bool
  (match (compiler-backend-spill-immediate-binop-asm (Add) 7 (I64))
    [(Ok add-asm)
      (match (compiler-backend-spill-immediate-binop-asm (Lt) 7 (Bool))
        [(Ok cmp-asm)
          (and
            (be_state.backend-and4
              (asm-has? add-asm "    leaq 7(%r12), %r8\n")
              (asm-lacks? add-asm "    addq $7, %r8\n")
              (asm-has? cmp-asm "    cmpq $7, %r8\n")
              (asm-has? cmp-asm "    setl %r8b\n"))
            (asm-has? add-asm "    movq %r8, -16(%rbp)\n")
            (asm-has? cmp-asm "    movq %r8, -16(%rbp)\n")
            (asm-lacks? add-asm "%rax")
            (asm-lacks? cmp-asm "%rax"))]
        [(Err _) false])]
    [(Err _) false]))

;; #6288: in Linux FPO mode `%rbp` is both the historical frame-address
;; spelling and an admissible value home. Force the value home directly so a
;; harmless allocator-order change cannot make this regression disappear.
;; Exercise both destination plans through save/restore emission and the final
;; rsp rebase: the accepted text must retain `n + 31` in the structurally
;; distinct no-base SIB spelling, while the spilled result's real frame store
;; is still rebased normally.
(define (compiler-backend-rbp-immediate-add-assignments [spill-dst? : bool]) : regalloc.CompilerRegAssignmentTable
  (regalloc.compiler-reg-assignments-prepend
    (& (regalloc.CompilerRegAssignment 0 (Register cabi.compiler-reg-id-rbp)))
    (regalloc.compiler-reg-assignments-prepend
      (&
        (regalloc.CompilerRegAssignment
          1
          (if spill-dst?
            (Spill -16)
            (Register cabi.compiler-reg-id-r12))))
      (regalloc.compiler-reg-assignment-table-empty))))

(define (compiler-backend-rbp-immediate-add-final-asm
  [spill-dst? : bool]
  [backend-state : be_state.CompilerBackendState]) : be_peephole.CompilerBackendRspRebaseResult
  (let
    [_linux : unit (compiler-backend-set-current-fn-linux! backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-rbp-immediate-add-assignments spill-dst?)]
    [slot-vars : i64 2]
    [frame : i64
      (be_facts.compiler-backend-frame-size
        (be_operand.compiler-backend-frame-slots
          slot-vars
          assignments
          backend-state))]
    [push-regs : (__tl_dyn-array String)
      (be_peephole.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (backend.compiler-backend-fill-push-csr-regs!
        assignments
        (&mut push-regs)
        backend-state)]
    [vars : regalloc.CompilerRegVarTypes
      (regalloc.compiler-reg-var-types-insert
        (regalloc.compiler-reg-var-types-insert
          (regalloc.compiler-reg-var-types-empty)
          1
          (I64))
        0
        (I64))]
    (match (be_scalar.compiler-backend-emit-binop
      (ast.ast-node-pool-reader-type-segment-bases)
      vars
      (Empty)
      assignments
      1
      (Add)
      (Var 0)
      (I64 31)
      (I64)
      backend-state)
      [(Ok binop-asm)
        (let
          [result : be_peephole.CompilerBackendRspRebaseResult
            (be_peephole.compiler-backend-rsp-rebase-full-result
              (str_cat.str-cat
                (be_scalar.compiler-backend-emit-save-callee-regs
                  assignments
                  slot-vars
                  backend-state)
                binop-asm
                (be_scalar.compiler-backend-emit-restore-callee-regs
                  assignments
                  slot-vars
                  backend-state)
                "    leave\n    ret\n")
              frame
              true
              push-regs
              push-count
              slot-vars
              backend-state)]
          (be_peephole.CompilerBackendRspRebaseResult
            (compiler-backend-peephole-asm result.text)
            result.ok
            result.csr-ref-mask))]
      [(Err _) (be_peephole.CompilerBackendRspRebaseResult "" false 0)])))

(define (compiler-backend-rbp-immediate-add-final-ok?) : bool
  (let
    [direct-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [spilled-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [direct-result : be_peephole.CompilerBackendRspRebaseResult
      (compiler-backend-rbp-immediate-add-final-asm false direct-state)]
    [direct : String direct-result.text]
    [spilled-result : be_peephole.CompilerBackendRspRebaseResult
      (compiler-backend-rbp-immediate-add-final-asm true spilled-state)]
    [spilled : String spilled-result.text]
    (and
      direct-result.ok
      spilled-result.ok
      (asm-has? direct "    leaq 31( %rbp), %r12\n")
      (asm-has? spilled "    leaq 31( %rbp), %r8\n")
      (asm-lacks? direct "31(%rsp)")
      (asm-lacks? spilled "31(%rsp)")
      (asm-lacks? direct "    addq $31")
      (asm-lacks? spilled "    addq $31")
      ;; The spilled destination remains a genuine rebased frame write.
      (asm-has? spilled "    movq %r8, 48(%rsp)\n")
      (asm-has? direct "    popq %rbp\n")
      (asm-has? spilled "    popq %rbp\n"))))

(define (compiler-backend-direct-immediate-zero-asm [op : ir.CompilerIrBinOp]) : be_state.ResultCompilerBackend
  (be_scalar.compiler-backend-emit-binop
    (ast.ast-node-pool-reader-type-segment-bases)
    (regalloc.compiler-reg-var-types-insert
      (regalloc.compiler-reg-var-types-insert
        (regalloc.compiler-reg-var-types-empty)
        1
        (I64))
      0
      (I64))
    (Empty)
    (reg-homes "%0=%r12 %1=%r13")
    1
    op
    (Var 0)
    (I64 0)
    (I64)
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active))))

(define (compiler-backend-immediate-zero-compaction-ok?) : bool
  (match (compiler-backend-spill-immediate-binop-asm (Add) 0 (I64))
    [(Ok spill-add)
      (match (compiler-backend-spill-immediate-binop-asm (Sub) 0 (I64))
        [(Ok spill-sub)
          (match (compiler-backend-direct-immediate-zero-asm (Add))
            [(Ok direct-add)
              (match (compiler-backend-direct-immediate-zero-asm (Sub))
                [(Ok direct-sub)
                  (and
                    (asm-has?
                      spill-add
                      "    movq %r12, %r8\n    movq %r8, -16(%rbp)\n")
                    (string.eq spill-add spill-sub)
                    (asm-has? direct-add "    movq %r12, %r13\n")
                    (string.eq direct-add direct-sub)
                    (asm-lacks? spill-add "$0")
                    (asm-lacks? direct-add "$0"))]
                [(Err _) false])]
            [(Err _) false])]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-spill-source-binop-asm
  [op : ir.CompilerIrBinOp]
  [result-ty : ast.AstType]) : be_state.ResultCompilerBackend
  (be_scalar.compiler-backend-emit-binop
