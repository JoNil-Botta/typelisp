(define (compiler-backend-call-arg-rax-group-consumer-not-forwardable?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs-with-index
    (compiler-backend-call-arg-rax-group-consumer-instrs)
    2
    (compiler-backend-call-arg-rax-group-consumer-index))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    call _tl_consume_group\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rax, %rdi\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-emit-rax-forward-test-instrs-with-index
  [instrs : compiler_ir_types.CompilerIrInstrList]
  [vars : i64]
  [program-index : compiler_backend.CompilerBackendProgramIndex]) : compiler_backend.ResultCompilerBackend
  (let
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "entry")
          instrs)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [use-counts : (Array i64)
      (compiler_backend.compiler-backend-function-use-counts vars blocks)]
    (compiler-backend-test-emit-instrs-text
      (compiler_backend.CompilerBackendEmissionContext
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_backend.CompilerBackendTarget.Linux)
        "_tl_test"
        (ci.intern "test")
        blocks
        (compiler_ir_types.compiler-ir-label "entry")
        compiler_regalloc.CompilerRegAssignmentList.Nil
        vars
        (compiler_regalloc.compiler-reg-var-types-empty)
        (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
        (compiler_ast_types.AstType.I64)
        (compiler-backend-runtime-helper-full-plan)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil
        program-index
        (compiler_ir_types.compiler-source-spans-empty)
        (compiler_backend.compiler-backend-source-span-index-build
          (compiler_ir_types.compiler-source-spans-empty))
        (compiler_diagnostic.compiler-diagnostic-at-start "" "")
        use-counts)
      (compiler_backend.CompilerBackendMaybeLabel.No)
      instrs)))

(define (compiler-backend-emit-rax-forward-test-instrs
  [instrs : compiler_ir_types.CompilerIrInstrList]
  [vars : i64]) : compiler_backend.ResultCompilerBackend
  (compiler-backend-emit-rax-forward-test-instrs-with-index
    instrs
    vars
    (compiler_backend.compiler-backend-program-index-build
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      compiler_ir_types.CompilerIrFunctionList.Nil
      compiler_ir_types.CompilerIrExternList.Nil)))

(define (compiler-backend-rax-forwarding-ok?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs
    (compiler-backend-rax-forward-chain-instrs)
    3)
    [(compiler_backend.ResultCompilerBackend.Ok chain-asm)
      (match (compiler-backend-emit-rax-forward-test-instrs
        (compiler-backend-rax-forward-multiple-use-instrs)
        3)
        [(compiler_backend.ResultCompilerBackend.Ok multi-use-asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              chain-asm
              "    imulq $3, %rax\n")
            (compiler_backend.compiler-backend-string-contains?
              chain-asm
              "    addq $7, %rax\n")
            (compiler_backend.compiler-backend-string-contains?
              chain-asm
              "    addq $11, %rax\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                chain-asm
                "    movq %rax, -8(%rbp)\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                chain-asm
                "    movq %rax, -16(%rbp)\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                chain-asm
                "    movq %rax, -24(%rbp)\n"))
            (compiler_backend.compiler-backend-string-contains?
              multi-use-asm
              "    movq %r8, -8(%rbp)\n"))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-call-arg-rax-forwarding-ok?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs
    (compiler-backend-call-arg-rax-forward-direct-instrs)
    2)
    [(compiler_backend.ResultCompilerBackend.Ok direct-asm)
      (match (compiler-backend-emit-rax-forward-test-instrs
        (compiler-backend-call-arg-rax-forward-indirect-instrs)
        2)
        [(compiler_backend.ResultCompilerBackend.Ok indirect-asm)
          (match (compiler-backend-emit-rax-forward-test-instrs
            (compiler-backend-call-arg-rax-nonleading-instrs)
            2)
            [(compiler_backend.ResultCompilerBackend.Ok nonleading-asm)
              (and
                (compiler_backend.compiler-backend-string-contains?
                  direct-asm
                  "    call _tl_producer\n")
                (compiler_backend.compiler-backend-string-contains?
                  direct-asm
                  "    movq %rax, -8(%rbp)\n")
                (compiler_backend.compiler-backend-string-contains?
                  direct-asm
                  "    movq %rax, %rdi\n")
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    direct-asm
                    "    movq -8(%rbp), %rdi\n"))
                (compiler_backend.compiler-backend-string-contains?
                  indirect-asm
                  "    movq %rax, %rsi\n")
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    indirect-asm
                    "    movq -8(%rbp), %rsi\n"))
                (compiler_backend.compiler-backend-string-contains?
                  nonleading-asm
                  "    movq -8(%rbp), %rsi\n")
                (compiler-backend-call-arg-rax-group-consumer-not-forwardable?)
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    nonleading-asm
                    "    movq %rax, %rsi\n")))]
            [(compiler_backend.ResultCompilerBackend.Err _) false])]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define compiler-backend-long-block-instr-count : i64
  4096)

(define (compiler-backend-long-normal-block-seq) : compiler_ir_types.CompilerIrInstrSeq
  (let
    [count : i64 compiler-backend-long-block-instr-count]
    [total : i64 (+ count 1)]
    [slots : (Array compiler_ir_types.CompilerIrInstr)
      (array.make-array compiler_ir_types.CompilerIrInstr total)]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set!
            slots
            index
            (compiler_ir_types.CompilerIrInstr.Mov
              index
              (compiler_ir_types.CompilerIrValue.I64 index)
              (compiler_ast_types.AstType.I64)))
          (set! index (+ index 1))))
      (array-set!
        slots
        count
        (compiler_ir_types.CompilerIrInstr.Return
          (compiler_ir_types.CompilerIrMaybeValue.Some
            (compiler_ir_types.CompilerIrValue.Var (- count 1)))))
      (compiler_ir_types.CompilerIrInstrSeq slots total))))

(define (compiler-backend-long-normal-block-ok?) : bool
  (let
    [seq : compiler_ir_types.CompilerIrInstrSeq
      (compiler-backend-long-normal-block-seq)]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler_ir_types.compiler-ir-instr-seq-to-list seq)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.CompilerIrBlock.Block
          (compiler_ir_types.compiler-ir-label "entry")
          seq)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [use-counts : (Array i64)
      (compiler_backend.compiler-backend-function-use-counts
        compiler-backend-long-block-instr-count
        blocks)]
    (match (compiler-backend-test-emit-instrs-text
      (compiler_backend.CompilerBackendEmissionContext
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        (compiler_backend.CompilerBackendTarget.Linux)
        "_tl_test"
        (ci.intern "test")
        blocks
        (compiler_ir_types.compiler-ir-label "entry")
        compiler_regalloc.CompilerRegAssignmentList.Nil
        compiler-backend-long-block-instr-count
        (compiler_regalloc.compiler-reg-var-types-empty)
        (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
        (compiler_ast_types.AstType.I64)
        (compiler-backend-runtime-helper-full-plan)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil
        (compiler_backend.compiler-backend-program-index-build
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          compiler_ir_types.CompilerIrFunctionList.Nil
          compiler_ir_types.CompilerIrExternList.Nil)
        (compiler_ir_types.compiler-source-spans-empty)
        (compiler_backend.compiler-backend-source-span-index-build
          (compiler_ir_types.compiler-source-spans-empty))
        (compiler_diagnostic.compiler-diagnostic-at-start "" "")
        use-counts)
      (compiler_backend.CompilerBackendMaybeLabel.No)
      instrs)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movl $4095, %eax\n")
          (compiler_backend.compiler-backend-string-contains? asm "    ret\n"))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-binop-operand-folding-ok?) : bool
  (let
    [rhs-spill : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Spill -16))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    [cmp-types : compiler_regalloc.CompilerRegVarTypes
      (compiler_regalloc.compiler-reg-var-types-insert
        (compiler_regalloc.compiler-reg-var-types-insert
          (compiler_regalloc.compiler-reg-var-types-empty)
          1
          (compiler_ast_types.AstType.I64))
        0
        (compiler_ast_types.AstType.I64))]
    (match (compiler_backend.compiler-backend-emit-binop
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler_regalloc.compiler-reg-var-types-empty)
      (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
      rhs-spill
      2
      (compiler_ir_types.CompilerIrBinOp.Add)
      (compiler_ir_types.CompilerIrValue.Var 0)
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I64))
      [(compiler_backend.ResultCompilerBackend.Ok add-asm)
        (match (compiler_backend.compiler-backend-emit-binop
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          cmp-types
          (compiler_backend.CompilerBackendGlobalTypeTable.Empty)
          rhs-spill
          2
          (compiler_ir_types.CompilerIrBinOp.Lt)
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.Bool))
          [(compiler_backend.ResultCompilerBackend.Ok cmp-asm)
            (and
              (compiler_backend.compiler-backend-string-contains?
                add-asm
                "    addq -16(%rbp), %r8\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  add-asm
                  "    movq -16(%rbp), %r9\n"))
              (compiler_backend.compiler-backend-string-contains?
                cmp-asm
                "    cmpq -16(%rbp), %r8\n    setl %r8b\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  cmp-asm
                  "    movq -16(%rbp), %r9\n"))
              (string.eq
                (compiler_backend.compiler-backend-binop-direct-mnemonic
                  (compiler_ir_types.CompilerIrBinOp.And))
                "and")
              (string.eq
                (compiler_backend.compiler-backend-binop-direct-mnemonic
                  (compiler_ir_types.CompilerIrBinOp.Or))
                "or"))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-bounds-operand-folding-ok?) : bool
  (let
    [index-reg : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    [index-reg-length-spill : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Spill -16))
          compiler_regalloc.CompilerRegAssignmentList.Nil))]
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.I64 3)
          (compiler_ir_types.compiler-ir-label "bounds_ok"))
        compiler_ir_types.CompilerIrInstrList.Nil)
      index-reg
      2)
      [(compiler_backend.ResultCompilerBackend.Ok imm-asm)
        (match (compiler-backend-emit-test-instrs
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ir_types.compiler-ir-label "bounds_ok"))
            compiler_ir_types.CompilerIrInstrList.Nil)
          index-reg-length-spill
          3)
          [(compiler_backend.ResultCompilerBackend.Ok spill-asm)
            (and
              (compiler_backend.compiler-backend-string-contains?
                imm-asm
                "    cmpq $3, %r12\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  imm-asm
                  "    movq %r12, %rax\n"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  imm-asm
                  "    movl $3, %r11d\n"))
              (compiler_backend.compiler-backend-string-contains?
                spill-asm
                "    cmpq -16(%rbp), %r12\n")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  spill-asm
                  "    movq %r12, %rax\n"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  spill-asm
                  "    movq -16(%rbp), %r11\n")))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-bounds-direct-pressure-tail
  [index : i64]
  [count : i64]) : compiler_ir_types.CompilerIrInstrList
  (if (>= index count)
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Return
        compiler_ir_types.CompilerIrMaybeValue.No)
      compiler_ir_types.CompilerIrInstrList.Nil)
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.StorePtr
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var index)
        (compiler_ast_types.AstType.I64))
      (compiler-backend-bounds-direct-pressure-tail (+ index 1) count))))

;; A direct register/memory length operand needs no scratch. Under full register
;; pressure an eager, unused scavenge would otherwise add an emergency stack
;; save at the bounds check even though the compare already has both operands.
(define (compiler-backend-bounds-direct-pressure-asm) : compiler_backend.ResultCompilerBackend
  (let
    [previous-slot : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-slot-offset)]
    [_slot : unit
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-slot-offset!
        -512)]
    [regs : (Array i64) (compiler_backend.compiler-backend-scavenge-candidates)]
    [count : i64 (array-length regs)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-test-reg-assignment-list-from regs 0)]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.BoundsCheck
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.compiler-ir-label "bounds_ok"))
        (compiler-backend-bounds-direct-pressure-tail 1 count))]
    [result : compiler_backend.ResultCompilerBackend
      (compiler-backend-emit-test-instrs instrs assignments count)]
    [_restore : unit
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-slot-offset!
        previous-slot)]
    result))

(define (compiler-backend-bounds-direct-pressure-ok?) : bool
  (match (compiler-backend-bounds-direct-pressure-asm)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq %rcx, %r9\n")
        (not
          (compiler_backend.compiler-backend-string-contains? asm "-512(%rbp)")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Direct register binops need no scratch. Keep every scavenger candidate live
;; across the instruction so an eager fallback selection is observable as an
;; emergency-slot save even though LEA and the direct-source XOR do not consume
;; the selected register.
(define (compiler-backend-binop-direct-pressure-asm
  [op : compiler_ir_types.CompilerIrBinOp]) : compiler_backend.ResultCompilerBackend
  (let
    [previous-slot : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-slot-offset)]
    [_slot : unit
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-slot-offset!
        -512)]
    [regs : (Array i64) (compiler_backend.compiler-backend-scavenge-candidates)]
    [count : i64 (array-length regs)]
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler-backend-test-reg-assignment-list-from regs 0)]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          op
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler-backend-bounds-direct-pressure-tail 1 count))]
    [result : compiler_backend.ResultCompilerBackend
      (compiler-backend-emit-test-instrs instrs assignments count)]
    [_restore : unit
      (compiler_backend.compiler-backend-test-set-compiler-backend-emergency-slot-offset!
        previous-slot)]
    result))

(define (compiler-backend-binop-direct-pressure-ok?) : bool
  (match (compiler-backend-binop-direct-pressure-asm
    (compiler_ir_types.CompilerIrBinOp.Add))
    [(compiler_backend.ResultCompilerBackend.Ok add-asm)
      (match (compiler-backend-binop-direct-pressure-asm
        (compiler_ir_types.CompilerIrBinOp.BitXor))
        [(compiler_backend.ResultCompilerBackend.Ok xor-asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              add-asm
              "    leaq (%r9,%rcx), %rdx\n")
            (compiler_backend.compiler-backend-string-contains?
              xor-asm
              "    movq %r9, %rdx\n    xorq %rcx, %rdx\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                add-asm
                "-512(%rbp)"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                xor-asm
                "-512(%rbp)")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-win64-bounds-index-scratch-ok?) : bool
  (let
    [_win : unit (compiler_backend.compiler-backend-set-current-fn-win64!)]
    [length-rax : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-rax))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    [ok : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.compiler-ir-label "bounds_ok"))
          compiler_ir_types.CompilerIrInstrList.Nil)
        length-rax
        2)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          ;; The merged emitter folds the constant index 0 directly into the
          ;; bounds compare (`cmpq $0, %rax`) instead of materializing it in a
          ;; scratch register. The Win64 safety invariant is unchanged: the
          ;; length (in %rax) is never clobbered, so no degenerate
          ;; `cmpq %rax, %rax` self-compare is emitted.
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    cmpq $0, %rax\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    cmpq %rax, %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [_linux : unit (compiler_backend.compiler-backend-set-current-fn-linux!)]
    ok))

(define (compiler-backend-win64-compare-rhs-rax-ok?) : bool
  (let
    [_win : unit (compiler_backend.compiler-backend-set-current-fn-win64!)]
    [rhs-rax : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-rax))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    [ok : bool
      (match (compiler_backend.compiler-backend-emit-compare-branch
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        rhs-rax
        "cmp"
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.I64)
        (compiler_ir_types.compiler-ir-label "then")
        (compiler_ir_types.compiler-ir-label "else")
        (compiler_backend.CompilerBackendMaybeLabel.No))
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          ;; The merged emitter folds the spilled LHS (var0 at -8(%rbp)) directly
          ;; into the compare as a memory operand (`cmpq %rax, -8(%rbp)`) instead
          ;; of loading it into a scratch register first. The Win64 safety
          ;; invariant is unchanged: the RHS in %rax is never clobbered, so no
          ;; degenerate `cmpq %rax, %rax` self-compare is emitted.
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    cmpq %rax, -8(%rbp)\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    cmpq %rax, %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [_linux : unit (compiler_backend.compiler-backend-set-current-fn-linux!)]
    ok))

(define (compiler-backend-peephole-single-dest-mnemonic? [name : String]) : bool
  (compiler_backend.compiler-backend-peephole-mnemonic-single-dest?
    (unsafe
      (string-data name))
    0
    (string.string-length name)))

(define (compiler-backend-test-peephole-reg-index [name : String]) : i64
  (compiler_backend.compiler-backend-peephole-token-reg-index-range
    (unsafe
      (string-data name))
    0
    (string.string-length name)))

(define (compiler-backend-test-peephole-memory-base [operand : String]) : i64
  (compiler_backend.compiler-backend-peephole-memory-base-range
    (unsafe
      (string-data operand))
    0
    (string.string-length operand)))

(define (compiler-backend-peephole-operand-classifiers-ok?) : bool
  (and
    (= (compiler-backend-test-peephole-reg-index "%rax") 0)
    (= (compiler-backend-test-peephole-reg-index "%rcx") 1)
    (= (compiler-backend-test-peephole-reg-index "%rdx") 2)
    (= (compiler-backend-test-peephole-reg-index "%rbx") 3)
    (= (compiler-backend-test-peephole-reg-index "%rsi") 4)
    (= (compiler-backend-test-peephole-reg-index "%rdi") 5)
    (= (compiler-backend-test-peephole-reg-index "%r8") 6)
    (= (compiler-backend-test-peephole-reg-index "%r9") 7)
    (= (compiler-backend-test-peephole-reg-index "%r10") 8)
    (= (compiler-backend-test-peephole-reg-index "%r11") 9)
    (= (compiler-backend-test-peephole-reg-index "%r12") 10)
    (= (compiler-backend-test-peephole-reg-index "%r13") 11)
    (= (compiler-backend-test-peephole-reg-index "%r14") 12)
    (= (compiler-backend-test-peephole-reg-index "%r15") 13)
    (= (compiler-backend-test-peephole-reg-index "%eax") 0)
    (= (compiler-backend-test-peephole-reg-index "%ax") 0)
    (= (compiler-backend-test-peephole-reg-index "%al") 0)
    (= (compiler-backend-test-peephole-reg-index "%ecx") 1)
    (= (compiler-backend-test-peephole-reg-index "%cx") 1)
    (= (compiler-backend-test-peephole-reg-index "%cl") 1)
    (= (compiler-backend-test-peephole-reg-index "%edx") 2)
    (= (compiler-backend-test-peephole-reg-index "%dx") 2)
    (= (compiler-backend-test-peephole-reg-index "%dl") 2)
    (= (compiler-backend-test-peephole-reg-index "%ebx") 3)
    (= (compiler-backend-test-peephole-reg-index "%bx") 3)
    (= (compiler-backend-test-peephole-reg-index "%bl") 3)
    (= (compiler-backend-test-peephole-reg-index "%esi") 4)
    (= (compiler-backend-test-peephole-reg-index "%si") 4)
    (= (compiler-backend-test-peephole-reg-index "%sil") 4)
    (= (compiler-backend-test-peephole-reg-index "%edi") 5)
    (= (compiler-backend-test-peephole-reg-index "%di") 5)
    (= (compiler-backend-test-peephole-reg-index "%dil") 5)
    (= (compiler-backend-test-peephole-reg-index "%r8d") 6)
    (= (compiler-backend-test-peephole-reg-index "%r8w") 6)
    (= (compiler-backend-test-peephole-reg-index "%r8b") 6)
    (= (compiler-backend-test-peephole-reg-index "%r15d") 13)
    (= (compiler-backend-test-peephole-reg-index "%r15w") 13)
    (= (compiler-backend-test-peephole-reg-index "%r15b") 13)
    (= (compiler-backend-test-peephole-reg-index "%rbp") -1)
    (= (compiler-backend-test-peephole-reg-index "%rsp") -1)
    (= (compiler-backend-test-peephole-reg-index "%rip") -1)
    (= (compiler-backend-test-peephole-reg-index "%ah") -1)
    (= (compiler-backend-test-peephole-reg-index "%xmm0") -1)
    (= (compiler-backend-test-peephole-reg-index "%r16") -1)
    (=
      (compiler-backend-test-peephole-memory-base "-8(%rbp)")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-rbp))
    (=
      (compiler-backend-test-peephole-memory-base "(%rsp)")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-rsp))
    (=
      (compiler-backend-test-peephole-memory-base "symbol(%rip)")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-rip))
    (=
      (compiler-backend-test-peephole-memory-base "24(%r10)")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-r10))
    (=
      (compiler-backend-test-peephole-memory-base "24(%r11)")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-none))
    (=
      (compiler-backend-test-peephole-memory-base "%rax")
      (compiler_backend.compiler-backend-test-get-compiler-backend-peephole-memory-base-none))))

(define (compiler-backend-test-control-mnemonic-kind [name : String]) : i64
