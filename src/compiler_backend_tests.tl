      "    vmovdqu8 %zmm7, %zmm6{%k1}\n"
      "    vmovdqu8 %zmm6, (%r12){%k2}\n")
    (lacks "%edx" "%zmm14" "%zmm15" "%rsp")))

(define (compiler-backend-avx512-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]
  [mask-move : String]
  [mask-shift : String]) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-avx2-map-source elem)
    (lower.CompilerLowerMode.Avx512))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx512)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and8
                  (asm-has? asm move)
                  (asm-has? asm op)
                  (asm-has? asm "%zmm")
                  (asm-has? asm "%k")
                  (asm-has? asm "tail_mask_")
                  (asm-has? asm "}{z}")
                  (asm-has? asm mask-move)
                  (asm-has? asm mask-shift))
                (asm-lacks? asm "vector/mask IR emission is not implemented"))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-avx512-masked-if-source-ok? [src : String]) : bool
  (match (lower.lower-compiler-source-with-mode
    src
    (lower.CompilerLowerMode.Avx512))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx512)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and8
                  (asm-has? asm "    vpcmpq $1,")
                  (asm-has? asm "    kandw ")
                  (asm-has? asm "    kandnw ")
                  (asm-has? asm "    vpbroadcastq ")
                  (asm-has? asm "}{z}")
                  (asm-has? asm "tail_mask_")
                  (asm-has? asm "%k")
                  (asm-has? asm "    vmovdqu64 "))
                (asm-lacks? asm "vector/mask IR emission is not implemented"))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-avx512-masked-if-index-value-ok?) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-avx512-masked-if-index-value-source)
    (lower.CompilerLowerMode.Avx512))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx512)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and8
                  (asm-has? asm "    vpcmpq $1,")
                  (asm-has? asm "    kandw ")
                  (asm-has? asm "    kandnw ")
                  (asm-has? asm "    vpbroadcastq ")
                  (asm-has? asm "tail_mask_")
                  (asm-has? asm "lane_id_")
                  (asm-has? asm "    vpaddq ")
                  (let
                    [needle
                      (str_cat.str-cat
                        "    vmovdqa64 "
                        (be_facts.compiler-backend-avx512-i64-lane-id-label)
                        "(%rip), ")]
                    (asm-has? asm needle)))
                (asm-lacks? asm "vector/mask IR emission is not implemented"))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-avx512-masked-if-index-mod-ok?) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-avx512-masked-if-index-mod-source)
    (lower.CompilerLowerMode.Avx512))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx512)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and8
                  (asm-has? asm "    vpcmpq $0,")
                  (asm-has? asm "    kandw ")
                  (asm-has? asm "    kandnw ")
                  (asm-has? asm "    vpbroadcastq ")
                  (asm-has? asm "tail_mask_")
                  (asm-has? asm "lane_id_")
                  (asm-has? asm "    vpandq ")
                  (let
                    [needle
                      (str_cat.str-cat
                        "    vmovdqa64 "
                        (be_facts.compiler-backend-avx512-i64-lane-id-label)
                        "(%rip), ")]
                    (asm-has? asm needle)))
                (asm-lacks? asm "vector/mask IR emission is not implemented"))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-avx512-masked-if-value-ok?) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-avx512-masked-if-value-source)
    (lower.CompilerLowerMode.Avx512))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx512)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and8
                  (asm-has? asm "    vpcmpq $1,")
                  (asm-has? asm "    kandw ")
                  (asm-has? asm "    kandnw ")
                  (asm-has? asm "    vpbroadcastq ")
                  (asm-has? asm "    vmovdqu64 %zmm")
                  (asm-has? asm "{%k")
                  (asm-has? asm "tail_mask_")
                  (asm-has? asm "%k"))
                (asm-lacks? asm "vector/mask IR emission is not implemented"))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-avx512-masked-if-ok?) : bool
  (and
    (compiler-backend-avx512-masked-if-source-ok?
      (compiler-backend-avx512-masked-if-source))
    (compiler-backend-avx512-masked-if-source-ok?
      (compiler-backend-avx512-masked-if-offset-source))
    (compiler-backend-avx512-masked-if-index-value-ok?)
    (compiler-backend-avx512-masked-if-index-mod-ok?)
    (compiler-backend-avx512-masked-if-value-ok?)
    (compiler-backend-avx512-select-true-alias-ok?)
    (compiler-backend-avx512-select-false-alias-ok?)
    (compiler-backend-avx512-select-false-home-asm-ok?)))

(define (compiler-backend-avx512-vector-map-ok?) : bool
  (and
    (compiler-backend-avx512-map-asm-contains?
      "i64"
      "    vmovdqu64 "
      "    vpaddq "
      "kmovw"
      "shll %cl, %r")
    (compiler-backend-avx512-map-asm-contains?
      "i32"
      "    vmovdqu32 "
      "    vpaddd "
      "kmovw"
      "shll %cl, %r")
    (compiler-backend-avx512-map-asm-contains?
      "i16"
      "    vmovdqu16 "
      "    vpaddw "
      "kmovd"
      "shll %cl, %r")
    (compiler-backend-avx512-map-asm-contains?
      "u16"
      "    vmovdqu16 "
      "    vpaddw "
      "kmovd"
      "shll %cl, %r")
    (compiler-backend-avx512-map-asm-contains?
      "f64"
      "    vmovupd "
      "    vaddpd "
      "kmovw"
      "shll %cl, %r")
    (compiler-backend-avx512-map-asm-contains?
      "f32"
      "    vmovups "
      "    vaddps "
      "kmovw"
      "shll %cl, %r")
    (compiler-backend-avx512-map-asm-contains?
      "i8"
      "    vmovdqu8 "
      "    vpaddb "
      "kmovq"
      "shlq %cl, %r")
    (compiler-backend-avx512-map-asm-contains?
      "u8"
      "    vmovdqu8 "
      "    vpaddb "
      "kmovq"
      "shlq %cl, %r")))

(define (compiler-backend-avx512-uniform-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]
  [broadcast : String]) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-uniform-map-source elem)
    (lower.CompilerLowerMode.Avx512))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx512)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and8
                  (asm-has? asm move)
                  (asm-has? asm op)
                  (asm-has? asm broadcast)
                  (asm-has? asm "%zmm")
                  (asm-has? asm "%k")
                  (asm-has? asm "tail_mask_")
                  (asm-has? asm "}{z}")
                  (asm-lacks? asm "vector/mask IR emission is not implemented"))
                true)]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-avx512-uniform-zip-ok?) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-uniform-zip-source)
    (lower.CompilerLowerMode.Avx512))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx512)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and8
                  (asm-has? asm "    vpbroadcastq ")
                  (asm-has? asm "    vpmullq ")
                  (asm-has? asm "    vpaddq ")
                  (asm-has? asm "    vmovdqu64 ")
                  (asm-has? asm "%zmm")
                  (asm-has? asm "%k")
                  (asm-lacks? asm "vector/mask IR emission is not implemented")
                  true)
                true)]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-avx512-uniform-vector-map-ok?) : bool
  (and
    (compiler-backend-avx512-uniform-map-asm-contains?
      "i64"
      "    vmovdqu64 "
      "    vpaddq "
      "    vpbroadcastq ")
    (compiler-backend-avx512-uniform-map-asm-contains?
      "i32"
      "    vmovdqu32 "
      "    vpaddd "
      "    vpbroadcastd ")
    (compiler-backend-avx512-uniform-map-asm-contains?
      "i16"
      "    vmovdqu16 "
      "    vpaddw "
      "    vpbroadcastw ")
    (compiler-backend-avx512-uniform-map-asm-contains?
      "u16"
      "    vmovdqu16 "
      "    vpaddw "
      "    vpbroadcastw ")
    (compiler-backend-avx512-uniform-map-asm-contains?
      "f64"
      "    vmovupd "
      "    vaddpd "
      "    vbroadcastsd ")
    (compiler-backend-avx512-uniform-map-asm-contains?
      "f32"
      "    vmovups "
      "    vaddps "
      "    vbroadcastss ")
    (compiler-backend-avx512-uniform-map-asm-contains?
      "i8"
      "    vmovdqu8 "
      "    vpaddb "
      "    vpbroadcastb ")
    (compiler-backend-avx512-uniform-map-asm-contains?
      "u8"
      "    vmovdqu8 "
      "    vpaddb "
      "    vpbroadcastb ")
    (compiler-backend-avx512-uniform-zip-ok?)))

(define (compiler-backend-avx2-reduce-asm-contains?
  [src : String]
  [op : String]
  [extract : String]
  [horizontal : String]
  [store : String]) : bool
  (match (lower.lower-compiler-source-with-mode
    src
    (lower.CompilerLowerMode.Avx2))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx2)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and8
                  (asm-has? asm "    vzeroupper\n")
                  (asm-has? asm extract)
                  (asm-has? asm horizontal)
                  (asm-has? asm op)
                  (asm-has? asm store)
                  (asm-has? asm "%ymm")
                  (asm-has? asm "spmd_reduce_avx2")
                  (asm-has? asm "spmd_reduce_tail"))
                (asm-lacks? asm "vector/mask IR emission is not implemented"))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-bool-reduce-asm-contains?
  [src : String]
  [lower-mode : lower.CompilerLowerMode]
  [backend-mode : be_state.CompilerBackendMode]
  [reduce-op : String]
  [result-op : String]
  [register : String]) : bool
  (match (lower.lower-compiler-source-with-mode src lower-mode)
    [(Ok program spans lower-owner)
      (let
        [result : bool
          (asm-ok?
            (backend.compiler-backend-emit-program-target-with-mode
              program
              (be_state.CompilerBackendTarget.Linux)
              backend-mode
              spans
              true)
            (has
              "spmd_reduce_avx2_body"
              reduce-op
              result-op
              register
              "spmd_reduce_tail"))]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        result)]
    [(Err _) false]))

(define (compiler-backend-shuffle-asm-function-body
  [src : String]
  [lower-mode : lower.CompilerLowerMode]
  [backend-mode : be_state.CompilerBackendMode]) : String
  (match (lower.lower-compiler-source-with-mode src lower-mode)
    [(Ok program spans lower-owner)
      (let
        [result : String
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            backend-mode
            spans
            true)
            [(Ok asm) (compiler-backend-asm-function-body asm "_tl_f")]
            [(Err _) ""])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        result)]
    [(Err _) ""]))

(define (compiler-backend-identity-shuffle-eliminated?
  [src : String]
  [lower-mode : lower.CompilerLowerMode]
  [backend-mode : be_state.CompilerBackendMode]
  [loop-label : String]) : bool
  (let
    [body : String
      (compiler-backend-shuffle-asm-function-body src lower-mode backend-mode)]
    (and
      (asm-has? body loop-label)
      (asm-lacks? body "vector_shuffle_" "vpermd" "vpermq"))))

(define (compiler-backend-varying-shuffle-vector-check?
  [src : String]
  [lower-mode : lower.CompilerLowerMode]
  [backend-mode : be_state.CompilerBackendMode]
  [opcode : String]
  [compare-op : String]
  [reduce-op : String]
  [extra : String]) : bool
  (let
    [body : String
      (compiler-backend-shuffle-asm-function-body src lower-mode backend-mode)]
    (be_state.backend-and8
      (asm-has? body opcode)
      (asm-has? body compare-op)
      (asm-has? body reduce-op)
      (asm-has? body extra)
      (asm-has? body "    call tl_oob_abort")
      (asm-has? body "vector_shuffle_")
      (asm-lacks? body "_skip_")
      (> (string.string-length body) 0))))

(define (compiler-backend-shuffle-vector-check-reduction-ok?) : bool
  (let
    [avx2 : String
      (be_simd.compiler-backend-shuffle-vector-check-asm
        false
        2
        "-96(%rbp)"
        "-64(%rbp)"
        "%r10"
        "%r11"
        ".L_abort")]
    [avx512 : String
      (be_simd.compiler-backend-shuffle-vector-check-asm
        true
        2
        "-192(%rbp)"
        "-128(%rbp)"
        "%r10"
        "%r11"
        ".L_abort")]
    (and
      (be_state.backend-and8
        (= (backend.compiler-backend-string-count avx2 "vpcmpgtq") 2)
        (= (backend.compiler-backend-string-count avx2 "vpmovmskb") 4)
        (= (backend.compiler-backend-string-count avx2 "    jne .L_abort\n") 1)
        (= (backend.compiler-backend-string-count avx2 "    testl ") 1)
        (asm-lacks? avx2 "    cmpq ")
        (= (backend.compiler-backend-string-count avx512 "vpcmpuq $6") 2)
        (= (backend.compiler-backend-string-count avx512 "kmovw") 2)
        (=
          (backend.compiler-backend-string-count avx512 "    jne .L_abort\n")
          1))
      (= (backend.compiler-backend-string-count avx512 "    testl ") 1))))

(define (compiler-backend-vector-shuffle-ok?) : bool
  (and
    (compiler-backend-identity-shuffle-eliminated?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i64)] [out : (__tl_dyn-array i64)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (program-index)))))"
      (lower.CompilerLowerMode.Avx2)
      (Avx2)
      "foreach_avx2_body")
    (compiler-backend-identity-shuffle-eliminated?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i32)] [out : (__tl_dyn-array i32)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (program-index)))))"
      (lower.CompilerLowerMode.Avx2)
      (Avx2)
      "foreach_avx2_body")
    (compiler-backend-identity-shuffle-eliminated?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array f64)] [out : (__tl_dyn-array f64)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (program-index)))))"
      (lower.CompilerLowerMode.Avx512)
      (Avx512)
      "foreach_avx2_body")
    (compiler-backend-identity-shuffle-eliminated?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array f32)] [out : (__tl_dyn-array f32)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (program-index)))))"
      (lower.CompilerLowerMode.Avx512)
      (Avx512)
      "foreach_avx2_body")
    (compiler-backend-varying-shuffle-vector-check?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i64)] [selectors : (__tl_dyn-array i64)] [out : (__tl_dyn-array i64)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (array-ref selectors i)))))"
      (lower.CompilerLowerMode.Avx2)
      (Avx2)
      "    vpermd "
      "    vpcmpgtq "
      "    vpmovmskb "
      "    shll $1, ")
    (compiler-backend-varying-shuffle-vector-check?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i32)] [selectors : (__tl_dyn-array i64)] [out : (__tl_dyn-array i32)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (array-ref selectors i)))))"
      (lower.CompilerLowerMode.Avx2)
      (Avx2)
      "    vpermd "
      "    vpcmpgtq "
      "    vpmovmskb "
      "%rsp), %ymm0, %ymm")
    (compiler-backend-varying-shuffle-vector-check?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array f64)] [selectors : (__tl_dyn-array i64)] [out : (__tl_dyn-array f64)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (array-ref selectors i)))))"
      (lower.CompilerLowerMode.Avx512)
      (Avx512)
      "    vpermq "
      "    vpcmpuq $6, "
      "    kmovw "
      "%zmm")
    (compiler-backend-varying-shuffle-vector-check?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array f32)] [selectors : (__tl_dyn-array i64)] [out : (__tl_dyn-array f32)] [n : i64]) : unit (foreach ([i : i64 0 n]) (set! (array-ref out i) (spmd-shuffle (array-ref xs i) (array-ref selectors i)))))"
      (lower.CompilerLowerMode.Avx512)
      (Avx512)
      "    vpermd "
      "    vpcmpuq $6, "
      "    kmovw "
      "%zmm")
    (compiler-backend-shuffle-vector-check-reduction-ok?)))

;; The reduction result alone cannot detect a write through the source alias.
;; Keep the full source family read-only.
(define (compiler-backend-avx2-i64-reduce-source-case-ok?
  [op : ir.CompilerIrVectorReduceOp]
  [spilled : bool]
  [compare : String]) : bool
  (match (be_operand.compiler-backend-emit-avx2-vector-reduce
    (ast.ast-node-pool-reader-type-segment-bases)
    (if spilled
      (regalloc.compiler-reg-assignments-prepend
        (& (regalloc.CompilerRegAssignment 0 (Spill -64)))
        (compiler-backend-vector-reduce-direct-assignments
          (Register cabi.compiler-reg-id-r12)))
      (compiler-backend-vector-reduce-direct-assignments
        (Register cabi.compiler-reg-id-r12)))
    1
    op
    (Var 0)
    4
    (I64)
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (and
        (asm-has? asm compare)
        (asm-lacks? asm ", %xmm6\n" ", %ymm6\n")
        (if spilled
          (and
            (asm-has? asm "    vmovdqu -64(%rbp), %ymm14\n")
            (asm-lacks? asm ", -64(%rbp)\n"))
          true)
        (asm-has? asm "    vmovq %xmm2, %r12\n"))]
    [_ false]))

(define (compiler-backend-avx2-i64-reduce-storage-cases-ok? [spilled : bool]) : bool
  (and
    (compiler-backend-avx2-i64-reduce-source-case-ok?
      (Min)
      spilled
      "    vpcmpgtq %xmm3, %xmm2, %xmm4\n    vpblendvb %xmm4, %xmm3, %xmm2, %xmm2\n")
    (compiler-backend-avx2-i64-reduce-source-case-ok?
      (Max)
      spilled
      "    vpcmpgtq %xmm2, %xmm3, %xmm4\n    vpblendvb %xmm4, %xmm3, %xmm2, %xmm2\n")))

(define (compiler-backend-avx2-i64-reduce-source-ok?) : bool
  (compiler-backend-avx2-i64-reduce-storage-cases-ok? false))

(define (compiler-backend-avx2-i64-reduce-spilled-source-ok?) : bool
  (compiler-backend-avx2-i64-reduce-storage-cases-ok? true))

(define (compiler-backend-i64-reduce-call-instrs
  [op : ir.CompilerIrVectorReduceOp]) : ir.CompilerIrInstrSeq
  (compiler-backend-test-instr-seq-prepend
    (Call 3 (ci.intern "side_effect") Nil (I64))
    (compiler-backend-test-instr-seq-prepend
      (VectorReduce 1 op (Var 0) 4 (I64))
      (compiler-backend-test-instr-seq-prepend
        (Call 4 (ci.intern "side_effect") Nil (I64))
        (compiler-backend-test-instr-seq-prepend
          (VectorReduce 2 (Sum) (Var 0) 4 (I64))
          (ir.compiler-ir-instr-seq-empty))))))

(define (compiler-backend-i64-reduce-call-assignments [index : i64]) : regalloc.CompilerRegAssignmentTable
  (if (= index 5)
    (regalloc.compiler-reg-assignment-table-empty)
    (regalloc.compiler-reg-assignments-prepend
      (&
        (regalloc.CompilerRegAssignment
          index
          (cond
            [(= index 0) (Spill -64)]
            [(= index 1) (Register cabi.compiler-reg-id-r12)]
            [else (Spill (* -8 index))])))
      (compiler-backend-i64-reduce-call-assignments (+ index 1)))))

(define (compiler-backend-i64-reduce-call-case-ok?
  [target : be_state.CompilerBackendTarget]
  [op : ir.CompilerIrVectorReduceOp]) : bool
  (match (compiler-backend-emit-test-instrs-target-with-backend-state
    (compiler-backend-i64-reduce-call-instrs op)
    (compiler-backend-i64-reduce-call-assignments 0)
    5
    target
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (and
        (= (backend.compiler-backend-string-count asm "call _tl_side_effect") 2)
        (=
          (backend.compiler-backend-string-count
            asm
            "    vmovdqu -64(%rbp), %ymm14\n")
          2)
        (asm-lacks? asm ", -64(%rbp)\n"))]
    [_ false]))

(define (compiler-backend-i64-reduce-call-ok?) : bool
  (and
    (compiler-backend-i64-reduce-call-case-ok?
      (be_state.CompilerBackendTarget.Linux)
      (Min))
    (compiler-backend-i64-reduce-call-case-ok?
      (be_state.CompilerBackendTarget.Linux)
      (Max))
    (compiler-backend-i64-reduce-call-case-ok?
      (be_state.CompilerBackendTarget.Windows)
      (Min))
    (compiler-backend-i64-reduce-call-case-ok?
      (be_state.CompilerBackendTarget.Windows)
      (Max))))

(define (compiler-backend-avx2-vector-reduce-ok?) : bool
  (and
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i64)] [n : i64]) : i64 (spmd-reduce sum ([i : i64 0 n]) 0 (array-ref xs i)))"
      "    vpaddq "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i32)] [n : i64]) : i32 (spmd-reduce sum ([i : i64 0 n]) (cast 0 : i32) (array-ref xs i)))"
      "    vpaddd "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i32)] [n : i64] [seed : i32]) : i32 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpminsd "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i32)] [n : i64] [seed : i32]) : i32 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpmaxsd "
      "    vextracti128 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array f64)] [n : i64]) : f64 (spmd-reduce sum ([i : i64 0 n]) 0.0 (array-ref xs i)))"
      "    vaddpd "
      "    vextractf128 $1, "
      "    vaddsd "
      "    movsd %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array f32)] [n : i64]) : f32 (spmd-reduce sum ([i : i64 0 n]) (cast 0.0 : f32) (array-ref xs i)))"
      "    vaddps "
      "    vextractf128 $1, "
      "    vaddss "
      "    movss %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpcmpgtq "
      "    vextracti128 $1, "
      "    vpblendvb "
      "    vmovq %xmm2, ")
    (compiler-backend-avx2-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpcmpgtq "
      "    vextracti128 $1, "
      "    vpblendvb "
      "    vmovq %xmm2, ")
    (compiler-backend-bool-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array bool)] [n : i64]) : bool (spmd-reduce all ([i : i64 0 n]) true (array-ref xs i)))"
      (lower.CompilerLowerMode.Avx2)
      (Avx2)
      "    vpmovmskb "
      "    sete %al\n"
      "%ymm")
    (compiler-backend-bool-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array bool)] [n : i64]) : bool (spmd-reduce any ([i : i64 0 n]) false (array-ref xs i)))"
      (lower.CompilerLowerMode.Avx2)
      (Avx2)
      "    vpmovmskb "
      "    setne %al\n"
      "%ymm")))

(define (compiler-backend-avx512-reduce-asm-contains?
  [src : String]
  [op : String]
  [extract : String]
  [horizontal : String]
  [store : String]) : bool
  (match (lower.lower-compiler-source-with-mode
    src
    (lower.CompilerLowerMode.Avx512))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode
            program
            (be_state.CompilerBackendTarget.Linux)
            (Avx512)
            spans
            true)
            [(Ok asm)
              (and
                (be_state.backend-and8
                  (asm-has? asm extract)
                  (asm-has? asm horizontal)
                  (asm-has? asm op)
                  (asm-has? asm store)
                  (asm-has? asm "%zmm")
                  (asm-has? asm "%ymm")
                  (asm-has? asm "spmd_reduce_avx2")
                  true)
                (asm-lacks? asm "vector/mask IR emission is not implemented"))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-avx512-vector-reduce-i64-minmax-ok?) : bool
  (and
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpminsq "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i64)] [n : i64] [seed : i64]) : i64 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpmaxsq "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")))

(define (compiler-backend-avx512-vector-reduce-ok?) : bool
  (and
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i64)] [n : i64]) : i64 (spmd-reduce sum ([i : i64 0 n]) 0 (array-ref xs i)))"
      "    vpaddq "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovq %xmm2, ")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i32)] [n : i64]) : i32 (spmd-reduce sum ([i : i64 0 n]) (cast 0 : i32) (array-ref xs i)))"
      "    vpaddd "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i32)] [n : i64] [seed : i32]) : i32 (spmd-reduce min ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpminsd "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array i32)] [n : i64] [seed : i32]) : i32 (spmd-reduce max ([i : i64 0 n]) seed (array-ref xs i)))"
      "    vpmaxsd "
      "    vextracti64x4 $1, "
      "    vpsrldq $8, "
      "    vmovd %xmm2, %r8d\n")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array f64)] [n : i64]) : f64 (spmd-reduce sum ([i : i64 0 n]) 0.0 (array-ref xs i)))"
      "    vaddpd "
      "    vextractf64x4 $1, "
      "    vaddsd "
      "    movsd %xmm2, ")
    (compiler-backend-avx512-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array f32)] [n : i64]) : f32 (spmd-reduce sum ([i : i64 0 n]) (cast 0.0 : f32) (array-ref xs i)))"
      "    vaddps "
      "    vextractf32x8 $1, "
      "    vaddss "
      "    movss %xmm2, ")
    (compiler-backend-avx512-vector-reduce-i64-minmax-ok?)))

(define (compiler-backend-avx512-bool-vector-reduce-ok?) : bool
  (and
    (compiler-backend-bool-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array bool)] [n : i64]) : bool (spmd-reduce all ([i : i64 0 n]) true (array-ref xs i)))"
      (lower.CompilerLowerMode.Avx512)
      (Avx512)
      "    kortestq "
      "    setc %al\n"
      "%k")
    (compiler-backend-bool-reduce-asm-contains?
      "(define (main) : i64 0)
(define (f [xs : (__tl_dyn-array bool)] [n : i64]) : bool (spmd-reduce any ([i : i64 0 n]) false (array-ref xs i)))"
      (lower.CompilerLowerMode.Avx512)
      (Avx512)
      "    kortestq "
      "    setne %al\n"
      "%k")))

(define (compiler-backend-vector-reduce-direct-assignments
  [dst-location : regalloc.CompilerRegLocation]) : regalloc.CompilerRegAssignmentTable
  (regalloc.compiler-reg-assignments-prepend
    (&
      (regalloc.CompilerRegAssignment
        0
        (Register (cabi.compiler-abi-vector-register-id 6))))
    (regalloc.compiler-reg-assignments-prepend
      (& (regalloc.CompilerRegAssignment 1 dst-location))
      (regalloc.compiler-reg-assignment-table-empty))))

(define (compiler-backend-avx512-vector-reduce-narrow-case-ok?
  [elem-ty : ast.AstType]
  [lanes : i64]
  [mnemonic : String]
  [last-shift : String]) : bool
  (asm-ok?
    (be_operand.compiler-backend-emit-avx512-vector-reduce
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-reduce-direct-assignments
        (Register cabi.compiler-reg-id-r10))
      1
      (Min)
      (Var 0)
      lanes
      elem-ty
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has
      "    vextracti64x4 $1, %zmm6, %ymm2\n"
      "    vextracti128 $1, %ymm2, %xmm3\n"
      mnemonic
      last-shift
      "    vmovq %xmm2, ")
    (lacks "unsupported AVX-512 vector reduction")))

(define (compiler-backend-avx512-vector-reduce-narrow-ok?) : bool
  (and
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (I16)
      32
      "    vpminsw "
      "    vpsrldq $2, ")
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (U16)
      32
      "    vpminuw "
      "    vpsrldq $2, ")
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (I8)
      64
      "    vpminsb "
      "    vpsrldq $1, ")
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (U8)
      64
      "    vpminub "
      "    vpsrldq $1, ")))

(define (compiler-backend-avx2-vector-reduce-direct-stack-ok?) : bool
  (asm-ok?
    (be_operand.compiler-backend-emit-avx2-vector-reduce
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-reduce-direct-assignments (Spill -40))
      1
      (Sum)
      (Var 0)
      4
      (I64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has "    vextracti128 $1, %ymm6, %xmm2\n" "    vmovq %xmm2, -40(%rbp)\n")
    (lacks
      "%xmm0"
      "%xmm1"
      "    vmovq %xmm0, %rax\n"
      "    movq %rax, -40(%rbp)\n")))

(define (compiler-backend-avx2-vector-reduce-direct-register-ok?) : bool
  (asm-ok?
    (be_operand.compiler-backend-emit-avx2-vector-reduce
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-reduce-direct-assignments
        (Register cabi.compiler-reg-id-r12))
      1
      (Sum)
      (Var 0)
      4
      (I64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has "    vextracti128 $1, %ymm6, %xmm2\n" "    vmovq %xmm2, %r12\n")
    (lacks "%xmm0" "%xmm1" "    vmovq %xmm0, %rax\n" "    movq %rax, %r12\n")))

(define (compiler-backend-avx512-vector-reduce-direct-stack-ok?) : bool
  (asm-ok?
    (be_operand.compiler-backend-emit-avx512-vector-reduce
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-reduce-direct-assignments (Spill -40))
      1
      (Sum)
      (Var 0)
      8
      (I64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has "    vextracti64x4 $1, %zmm6, %ymm2\n" "    vmovq %xmm2, -40(%rbp)\n")
    (lacks
      "%xmm0"
      "%xmm1"
      "%ymm0"
      "    vmovq %xmm0, %rax\n"
      "    movq %rax, -40(%rbp)\n")))

(define (compiler-backend-avx512-vector-reduce-direct-register-ok?) : bool
  (asm-ok?
    (be_operand.compiler-backend-emit-avx512-vector-reduce
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-reduce-direct-assignments
        (Register cabi.compiler-reg-id-r12))
      1
      (Sum)
      (Var 0)
      8
      (I64)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has "    vextracti64x4 $1, %zmm6, %ymm2\n" "    vmovq %xmm2, %r12\n")
    (lacks
      "%xmm0"
      "%xmm1"
      "%ymm0"
      "    vmovq %xmm0, %rax\n"
      "    movq %rax, %r12\n")))

(define (compiler-backend-vector-reduce-direct-store-ok?) : bool
  (and
    (compiler-backend-avx2-vector-reduce-direct-stack-ok?)
    (compiler-backend-avx2-vector-reduce-direct-register-ok?)
    (compiler-backend-avx512-vector-reduce-direct-stack-ok?)
    (compiler-backend-avx512-vector-reduce-direct-register-ok?)
    (compiler-backend-avx512-vector-reduce-narrow-ok?)))

(define (compiler-backend-vector-home-program [func : ir.CompilerIrFunction]) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (& (compiler-backend-test-main-function))
      (&
        (ir.compiler-ir-function-seq-prepend
          (& func)
          (& (ir.compiler-ir-function-seq-empty)))))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-empty-private-param-homes-ok?
  [target : be_state.CompilerBackendTarget]
  [debug? : bool]) : bool
  (let
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [_debug : unit (ir.compiler-debug-info-set-enabled! debug?)]
    [result : be_state.ResultCompilerBackend
      (backend.compiler-backend-emit-program-target-with-mode
        (irt.program
          "typelisp-ir v1
function @__tl_spmd_ret_varying_empty_private(__tl_spmd_active_mask_avx2=%0:bool, __tl_spmd_varying_arg_avx2_0=%1:i64) -> unit vars 2 {
entry:
  return
}")
        target
        (Avx2)
        (ir.compiler-source-spans-empty)
        false)]
    [_restore : unit (ir.compiler-debug-info-set-enabled! previous-debug)]
    (match result
      [(Ok asm)
        (and
          (asm-has? asm "    vmovdqu 0(%r10), %ymm14\n")
          (asm-has? asm "    vmovdqu 32(%r10), %ymm14\n")
          (match target
            [(Linux)
              (if debug?
                ;; Debug CFI retains RBP; both homes fit below its saved value.
                (asm-has?
                  asm
                  "    subq $64, %rsp\n"
                  "    vmovdqu %ymm14, 32(%rsp)\n"
                  "    vmovdqu %ymm14, 0(%rsp)\n"
                  "    .cfi_def_cfa_register %rbp\n")
                ;; Two disjoint 32-byte homes fit in the leaf's red zone.
                (and
                  (asm-has? asm "    vmovdqu %ymm14, -32(%rsp)\n")
                  (asm-has? asm "    vmovdqu %ymm14, -64(%rsp)\n")
                  (asm-lacks? asm "    subq $")))]
            [(Windows)
              ;; The upper store ends at byte 64, below the return slot at 72.
              (and
                (asm-has? asm "    subq $72, %rsp\n")
                (asm-has? asm "    vmovdqu %ymm14, 32(%rsp)\n")
                (asm-has? asm "    vmovdqu %ymm14, 0(%rsp)\n")
                (asm-has? asm "    addq $72, %rsp\n"))]))]
      [(Err _) false])))

(define (compiler-backend-debug-private-param-provenance-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (let
    [_initialize : unit (cbi.compiler-builtin-initialize-for-parse!)]
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [_enable : unit (ir.compiler-debug-info-set-enabled! true)]
    [name : ir.CompilerIrSymbolId
      (ir.compiler-ir-symbol-typed-id
        (ir.compiler-ir-test-symbol "__tl_spmd_ret_varying_debug_private"))]
    [path : i64 (ci.intern "debug_private.tl")]
    ;; Instruction locations must follow their destination IDs through remapping.
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr-located
        (ir.compiler-source-spans-insert-instr-located
          (ir.compiler-source-spans-insert-located
            (ir.compiler-source-spans-empty)
            name
            path
            (compiler-backend-test-span 11 1))
          name
          (& (irt.instr "%2 = add 1, 2 : i64"))
          path
          (compiler-backend-test-span 37 3))
        name
        (& (irt.instr "%3 = add 3, 4 : i64"))
        path
        (compiler-backend-test-span 53 5))]
    [result : be_state.ResultCompilerBackend
      (backend.compiler-backend-emit-program-target-with-mode
        (irt.program
          "typelisp-ir v1
function @__tl_spmd_ret_varying_debug_private(__tl_spmd_active_mask_avx2=%0:bool, __tl_spmd_varying_arg_avx2_0=%1:i64) -> unit vars 4 {
entry:
  %2 = add 1, 2 : i64
  %3 = add 3, 4 : i64
  return
}")
        target
        (Avx2)
        spans
        false)]
    [_restore : unit (ir.compiler-debug-info-set-enabled! previous-debug)]
    (match result
      [(Ok asm)
        (match target
          [(Linux) (asm-has? asm "    .loc 1 37 3\n" "    .loc 1 53 5\n")]
          [(Windows)
            (asm-has? asm "    .cv_loc 0 1 37 3\n" "    .cv_loc 0 1 53 5\n")])]
      [(Err _) false])))

(define (compiler-backend-private-param-homes-and-provenance-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (and
    ;; Run provenance first so the fixture also covers fresh-process setup.
    (compiler-backend-debug-private-param-provenance-ok? target)
    (compiler-backend-empty-private-param-homes-ok? target false)
    (compiler-backend-empty-private-param-homes-ok? target true)))

(test
  backend-empty-private-body-keeps-entry-stores-inside-frame
  (unless
    (and
      (compiler-backend-private-param-homes-and-provenance-ok?
        (be_state.CompilerBackendTarget.Linux))
      (compiler-backend-private-param-homes-and-provenance-ok?
        (be_state.CompilerBackendTarget.Windows)))
    (io.panic "prologue-only AVX2 parameter stores escaped their frame")))

(define (compiler-backend-debug-caller-provenance-ok?
  [target : be_state.CompilerBackendTarget]
  [mode : be_state.CompilerBackendMode]) : bool
  (let
    [_initialize : unit (cbi.compiler-builtin-initialize-for-parse!)]
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [_enable : unit (ir.compiler-debug-info-set-enabled! true)]
    [name : ir.CompilerIrSymbolId
      (ir.compiler-ir-symbol-typed-id
        (ir.compiler-ir-test-symbol "debug_caller"))]
    [other : ir.CompilerIrSymbolId
      (ir.compiler-ir-symbol-typed-id
        (ir.compiler-ir-test-symbol "debug_other"))]
    [path : i64 (ci.intern "debug_caller.tl")]
    [first : ir.CompilerIrInstr (irt.instr "%0 = add 1, 2 : i64")]
    [second : ir.CompilerIrInstr (irt.instr "%1 = add 3, 4 : i64")]
    [bounds : ir.CompilerIrInstr
      (irt.instr "bounds_check %0, 10 message \"debug_ok\"")]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr-located
        (ir.compiler-source-spans-insert-instr-located
          (ir.compiler-source-spans-insert-instr-located
            (ir.compiler-source-spans-insert-instr-located
              (ir.compiler-source-spans-empty)
              name
              (& first)
              path
              (compiler-backend-test-span 17 1))
            other
            (& first)
            path
            (compiler-backend-test-span 71 7))
          name
          (& second)
          path
          (compiler-backend-test-span 53 5))
        name
        (& first)
        path
        (compiler-backend-test-span 37 3))]
    ;; Interleaved functions and a duplicate key must keep newest-entry wins.
    [located : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr-located
        spans
        name
        (& bounds)
        path
        (compiler-backend-test-span 61 6))]
    ;; Bounds keys remain unchanged while value keys follow coloring.
    [result : be_state.ResultCompilerBackend
      (backend.compiler-backend-emit-program-target-with-mode
        (irt.program
          "typelisp-ir v1
function @debug_caller() -> i64 vars 2 {
entry:
  %0 = add 1, 2 : i64
  %1 = add 3, 4 : i64
  bounds_check %0, 10 message \"debug_ok\"
  return %1
}
function @debug_other() -> i64 vars 1 {
entry:
  %0 = add 1, 2 : i64
  return %0
}")
        target
        mode
        located
        false)]
    [_restore : unit (ir.compiler-debug-info-set-enabled! previous-debug)]
    (match result
      [(Ok asm)
        (match target
          [(Linux)
            (and
              (asm-has?
                asm
                "    .loc 1 37 3\n"
                "    .loc 1 53 5\n"
                "    .loc 1 61 6\n"
                "    .loc 1 71 7\n")
              (asm-lacks? asm "    .loc 1 17 1\n"))]
          [(Windows)
            (and
              (asm-has?
                asm
                "    .cv_loc 0 1 37 3\n"
                "    .cv_loc 0 1 53 5\n"
                "    .cv_loc 0 1 61 6\n"
                "    .cv_loc 1 1 71 7\n")
              (asm-lacks? asm "    .cv_loc 0 1 17 1\n"))])]
      [(Err _) false])))

(define (compiler-backend-debug-caller-provenance-targets-ok?) : bool
  (and
    (compiler-backend-debug-caller-provenance-ok?
      be_state.CompilerBackendTarget.Linux
      (Avx2))
    (compiler-backend-debug-caller-provenance-ok?
      be_state.CompilerBackendTarget.Windows
      (Avx2))
    (compiler-backend-debug-caller-provenance-ok?
      be_state.CompilerBackendTarget.Linux
      (Avx512))
    (compiler-backend-debug-caller-provenance-ok?
      be_state.CompilerBackendTarget.Windows
      (Avx512))))

(test
  backend-debug-simd-caller-provenance
  (unless
    (compiler-backend-debug-caller-provenance-targets-ok?)
    (io.panic
      "debug SIMD caller locations lost function ownership or remapping")))

(define (compiler-backend-vector-call-lifetime-function) : ir.CompilerIrFunction
  (Function
    (ci.intern "vector_call_lifetime")
    (ir.compiler-ir-param-seq-empty)
    (Unit)
    3
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (compiler-backend-test-instr-seq-prepend
          (irt.instr "%0 = vector_load 0, 0 lanes 4 : i64")
          (compiler-backend-test-instr-seq-prepend
            (Call 1 (ci.intern "side_effect") (Nil) (Unit))
            (compiler-backend-test-instr-seq-prepend
              (ir.ir-instr-vector-bin-op 2 (Add) (Var 0) (Var 0) 4 (I64))
              (irt.instrs "return"))))))
    Ordinary))

(define (compiler-backend-avx2-vector-homes-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-program-target-with-mode
      (compiler-backend-vector-home-program
        (reg_tests.compiler-reg-vector-home-function))
      (be_state.CompilerBackendTarget.Linux)
      (Avx2)
      (ir.compiler-source-spans-empty)
      true)
    (has
      "    vmovdqu "
      "    vpaddq 32(%r8), %ymm6, %ymm7\n"
      "    vpaddq %ymm7, %ymm6, %ymm6\n")
    (lacks "    vpaddq 32(%rax), %ymm6, %ymm7\n" "register home unavailable")))

(define (compiler-backend-xmm-family-conversion-ok?) : bool
  (and
    (string.eq
      (be_operand.compiler-backend-vector-home-to-reg
        (cabi.compiler-abi-vector-register-id 6)
        "xmm")
      "%xmm6")
    (string.eq
      (be_operand.compiler-backend-vector-home-to-reg
        (cabi.compiler-abi-vector-register-id 6)
        "ymm")
      "%ymm6")
    (string.eq
      (be_operand.compiler-backend-vector-home-to-reg
        (cabi.compiler-abi-vector-register-id 6)
        "zmm")
      "%zmm6")
    (string.eq
      (be_operand.compiler-backend-vector-home-to-reg
        (cabi.compiler-abi-vector-register-id 7)
        "zmm")
      "%zmm7")
    (string.eq
      (be_operand.compiler-backend-vector-reg-lower-xmm "%zmm14")
      "%xmm14")
    (string.eq
      (be_operand.compiler-backend-vector-reg-lower-ymm "%zmm15")
      "%ymm15")
    (string.eq (be_operand.compiler-backend-xmm-to-ymm "%xmm3") "%ymm3")
    (be_operand.compiler-backend-vector-home-valid?
      (cabi.compiler-abi-xmm-register-id 2))
    (be_operand.compiler-backend-vector-home-valid?
      (cabi.compiler-abi-vector-register-id 6))
    (be_operand.compiler-backend-vector-home-valid?
      (cabi.compiler-abi-vector-register-id 13))
    (be_operand.compiler-backend-vector-home-valid?
      (cabi.compiler-abi-vector-register-id 14))
    (be_operand.compiler-backend-vector-home-valid?
      (cabi.compiler-abi-vector-register-id 15))
    (not
      (be_operand.compiler-backend-vector-home-valid?
        (cabi.compiler-abi-xmm-register-id 1)))
    (string.eq
      (be_operand.compiler-backend-vector-home-to-reg
        (cabi.compiler-abi-mask-register-id 1)
        "zmm")
      "")))

(define (compiler-backend-avx512-select-false-home-asm-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-program-target-with-mode
      (compiler-backend-vector-home-program
        (reg_tests.compiler-reg-vector-select-false-home-function))
      (be_state.CompilerBackendTarget.Linux)
      (Avx512)
      (ir.compiler-source-spans-empty)
      true)
    (has "    vmovdqu64 %zmm8, %zmm7{%k1}\n")
    (lacks "    vmovdqu64 %zmm7, %zmm7\n" "register home unavailable")))

(define (compiler-backend-avx512-mask-homes-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-program-target-with-mode
      (compiler-backend-vector-home-program
        (reg_tests.compiler-reg-mask-home-function))
      (be_state.CompilerBackendTarget.Linux)
      (Avx512)
      (ir.compiler-source-spans-empty)
      true)
    (has "    kandw %k2, %k1, %k1\n" "    kandnw %k7, %k1, %k1\n")
    (lacks "    knotw %k1, %k1\n" "register home unavailable")))

(define (compiler-backend-avx512-tail-mask-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%k1 %1=%r12 %2=%r13"))

(define (compiler-backend-avx512-tail-mask-emits?
  [index : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [lanes : i64]
  [want : String]) : bool
  (match (be_simd.compiler-backend-emit-avx512-tail-mask
    (ast.ast-node-pool-reader-type-segment-bases)
    "_tl_tail"
    (ir.compiler-ir-label "entry")
    (compiler-backend-avx512-tail-mask-assignments)
    0
    index
    end-value
    lanes
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm) (string.eq asm want)]
    [(Err _) false]))

(define (compiler-backend-avx512-tail-mask-dynamic-zero-ok?) : bool
  (asm-ok?
    (be_simd.compiler-backend-emit-avx512-tail-mask
      (ast.ast-node-pool-reader-type-segment-bases)
      "_tl_tail"
      (ir.compiler-ir-label "entry")
      (compiler-backend-avx512-tail-mask-assignments)
      0
      (Var 1)
      (Var 2)
      8
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has
      "    movq %r13, %rcx\n"
      "    subq %r12, %rcx\n"
      "    movl $1, %r9d\n"
      "    shll %cl, %r9d\n"
      "    kmovw %r9d, %k1\n"
      "    kxorw %k1, %k1, %k1\n")
    (lacks "%rax" "%eax" "    xorl %eax, %eax\n    kmovw %eax, %k1\n")))

(define (compiler-backend-avx512-tail-mask-ok?) : bool
  (and
    (compiler-backend-avx512-tail-mask-emits?
      (I64 8)
      (I64 8)
      8
      "    kxorw %k1, %k1, %k1\n")
    (compiler-backend-avx512-tail-mask-emits?
      (I64 10)
      (I64 13)
      8
      "    movl $7, %eax\n    kmovw %eax, %k1\n")
    (compiler-backend-avx512-tail-mask-emits?
      (I64 0)
      (I64 8)
      8
      "    movl $255, %eax\n    kmovw %eax, %k1\n")
    (compiler-backend-avx512-tail-mask-emits?
      (I64 0)
      (I64 3)
      64
      "    movq $7, %rax\n    kmovq %rax, %k1\n")
    (compiler-backend-avx512-tail-mask-dynamic-zero-ok?)))

(define (compiler-backend-avx2-tail-mask-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%vec6 %1=%r12 %2=%r13"))

(define (compiler-backend-avx2-tail-mask-emits [lanes : i64]) : be_state.ResultCompilerBackend
  (be_simd.compiler-backend-emit-avx2-tail-mask
    (ast.ast-node-pool-reader-type-segment-bases)
    "_tl_tail"
    (ir.compiler-ir-label "entry")
    (compiler-backend-avx2-tail-mask-assignments)
    0
    (Var 1)
    (Var 2)
    lanes
    (cdiag.compiler-diagnostic-at-start "" "")
    (compiler-backend-simd-staging-state 32)))

(define (compiler-backend-avx2-tail-mask-ok?) : bool
  (and
    (match (compiler-backend-avx2-tail-mask-emits 4)
      [(Ok asm)
        (and
          (be_state.backend-and4
            (asm-has? asm "    vpbroadcastq %xmm0, %ymm0\n")
            (let
              [needle
                (str_cat.str-cat
                  "    vpaddq "
                  (be_facts.compiler-backend-avx2-i64-lane-id-label)
                  "(%rip), %ymm0, %ymm0\n")]
              (asm-has? asm needle))
            (asm-has? asm "    vpcmpgtq %ymm0, %ymm1, %ymm6\n")
            (asm-lacks? asm "(%rsp)"))
          (asm-lacks? asm "_tail_skip_"))]
      [(Err _) false])
    (match (compiler-backend-avx2-tail-mask-emits 8)
      [(Ok asm)
        (and
          (be_state.backend-and4
            (asm-has?
              asm
              "    vmovdqu %ymm0, -224(%rbp)\n"
              "    movl $-1, -220(%rbp)\n"
              "    vmovdqu -224(%rbp), %ymm6\n")
            (asm-has? asm "_tail_skip_0")
            (asm-lacks? asm "%rsp")
            (not
              (let
                [needle (be_facts.compiler-backend-avx2-i64-lane-id-label)]
                (asm-has? asm needle))))
          (asm-lacks? asm "    vpcmpgtq "))]
      [(Err _) false])
    (let
      [qword : be_state.CompilerBackendProgramCollections
        (be_facts.compiler-backend-collect-instr-collections
          (compiler-backend-program-collections-new)
          (irt.instr "%0 = tail_mask %1, %2 lanes 4"))]
      [dword : be_state.CompilerBackendProgramCollections
        (be_facts.compiler-backend-collect-instr-collections
          (compiler-backend-program-collections-new)
          (irt.instr "%0 = tail_mask %1, %2 lanes 8"))]
      (and
        (be_data.compiler-backend-program-collections-uses-avx2-i64-lane-id?
          qword)
        (not
          (be_data.compiler-backend-program-collections-uses-avx2-i64-lane-id?
            dword))))))

(define (compiler-backend-avx512-mask-not-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%k1 %1=%k2"))

(define (compiler-backend-avx512-mask-not-emits? [lanes : i64] [want : String]) : bool
  (match (be_simd.compiler-backend-emit-avx512-mask-not
    (ast.ast-node-pool-reader-type-segment-bases)
