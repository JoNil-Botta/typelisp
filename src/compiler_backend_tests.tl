(define (compiler-backend-windows-private-fs-no-crt? [asm : String]) : bool
  (and
    (backend-and4
      (not (compiler-backend-string-contains? asm "_findfirst32"))
      (not (compiler-backend-string-contains? asm "_findnext32"))
      (not (compiler-backend-string-contains? asm "_findclose"))
      (not (compiler-backend-string-contains? asm "_stat64")))
    (not (compiler-backend-string-contains? asm "    .extern _errno\n"))
    (not (compiler-backend-string-contains? asm "    call _errno\n"))))

(define (compiler-backend-fs-current-dir-source) : String
  "(extern (tl_fs_current_dir_status) : i64)
(extern (tl_fs_current_dir) : String)
(define (current-dir-status) : i64
  (tl_fs_current_dir_status))
(define (current-dir) : String
  (tl_fs_current_dir))
(define (main) : i64
  (+ (current-dir-status) (__tl_string_length (current-dir))))")

(define (compiler-backend-fs-current-dir-extern-source) : String
  "(extern (tl_fs_current_dir_status) : i64)
(extern (tl_fs_current_dir) : String)
(define (main) : i64
  (+ (tl_fs_current_dir_status) (__tl_string_length (tl_fs_current_dir))))")

(define (compiler-backend-fs-current-dir-extern-only-source-ok?
  [source : String]) : bool
  (match (compiler-backend-emit-source source)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          ".extern tl_fs_current_dir_status\n")
        (compiler-backend-string-contains? asm ".extern tl_fs_current_dir\n")
        (compiler-backend-string-contains?
          asm
          "    call tl_fs_current_dir_status\n")
        (backend-and4
          (compiler-backend-no-public-runtime-symbol?
            asm
            "tl_fs_current_dir_status")
          (compiler-backend-no-public-runtime-symbol? asm "tl_fs_current_dir")
          (not (compiler-backend-string-contains? asm "getcwd:\n"))
          (not
            (compiler-backend-string-contains? asm ".L_tl_fs_mkdir_status:\n"))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-fs-current-dir-extern-only-ok?) : bool
  (and
    (compiler-backend-fs-current-dir-extern-only-source-ok?
      (compiler-backend-fs-current-dir-source))
    (compiler-backend-fs-current-dir-extern-only-source-ok?
      (compiler-backend-fs-current-dir-extern-source))))

(define (compiler-backend-windows-fs-current-dir-extern-only-source-ok?
  [source : String]) : bool
  (match (compiler-backend-emit-source-for-target
    source
    (CompilerBackendTarget.Windows))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          ".extern tl_fs_current_dir_status\n")
        (compiler-backend-string-contains? asm ".extern tl_fs_current_dir\n")
        (compiler-backend-no-public-runtime-symbol?
          asm
          "tl_fs_current_dir_status")
        (backend-and4
          (compiler-backend-no-public-runtime-symbol? asm "tl_fs_current_dir")
          (not (compiler-backend-string-contains? asm "    movq $38, %rax\n"))
          (not (compiler-backend-string-contains? asm "    syscall"))
          (not
            (compiler-backend-string-contains? asm ".L_tl_fs_mkdir_status:\n"))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-windows-fs-current-dir-extern-only-ok?) : bool
  (and
    (compiler-backend-windows-fs-current-dir-extern-only-source-ok?
      (compiler-backend-fs-current-dir-source))
    (compiler-backend-windows-fs-current-dir-extern-only-source-ok?
      (compiler-backend-fs-current-dir-extern-source))))

;; A refutable literal payload match lowers to a payload comparison that
;; branches to the next arm; confirm the resulting CFG reaches valid assembly.
(define (compiler-backend-literal-payload-source) : String
  "(defenum Maybe (None) (Some i64))
(define (classify [m : Maybe]) : i64
  (match m
    [(Some 0) 100]
    [(Some n) n]
    [None 5]))
(define (main) : i64 (classify (Some 0)))")

;; Confirm the refutable literal payload reaches valid assembly: the
;; function compiles and emits a `payload_ok` block (the in-bounds branch of the
;; payload comparison). `compiler-backend-asm-ok?` is smoke-source specific, so
;; check source-specific markers instead.
(define (compiler-backend-literal-payload-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-literal-payload-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (or
          (compiler-backend-string-contains? asm "_tl_classify")
          (compiler-backend-string-contains? asm "_tl_f"))
        (compiler-backend-string-contains? asm "_payload_ok"))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-f64-source) : String
  "(define (addf [a : f64] [b : f64]) : f64
  (+ a b))
(define (subf [a : f64] [b : f64]) : f64
  (- a b))
(define (ltf [a : f64] [b : f64]) : bool
  (< a b))
(define (main) : i64
  (if (ltf (subf (addf 1.5 2.5) 1.0) 4.5) 7 9))")

(define (compiler-backend-f64-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-f64-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          (compiler-backend-float-bits-directive
            (AstType.F64)
            (compiler-backend-test-f64-bits "1.5")))
        (not (compiler-backend-string-contains? asm "    .double "))
        (compiler-backend-string-contains? asm "    movsd %xmm0, ")
        (compiler-backend-string-contains? asm "    movsd %xmm1, ")
        ;; FPO rsp-relative frame slot (the y param spills to 16(%rsp)).
        (compiler-backend-string-contains? asm "    addsd 16(%rsp), %xmm2\n")
        (compiler-backend-string-contains? asm "    subsd 16(%rsp), %xmm2\n")
        (compiler-backend-string-contains? asm "    ucomisd 16(%rsp), %xmm2\n")
        (compiler-backend-string-contains? asm "    setb %r8b\n")
        (not (compiler-backend-string-contains? asm "    setb %al\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-f64-neg-source) : String
  "(define (negf [x : f64]) : f64
  (neg x))
(define (main) : i64
  (if (< (negf 1.5) 0.0) 0 1))")

(define (compiler-backend-f64-neg-object-source) : String
  "(define (negf [x : f64]) : f64
  (neg x))
(define (main) : i64 0)")

(define (compiler-backend-f64-neg-sign-mask-asm-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-f64-neg-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (compiler-backend-string-contains?
            asm
            "    xorpd .L_tl_f64_sign_bit(%rip), %xmm2\n")
          (= (compiler-backend-string-count asm ".L_tl_f64_sign_bit:\n") 1)
          (compiler-backend-string-contains? asm "    .balign 16\n")
          (compiler-backend-string-contains?
            asm
            "    .quad 0x8000000000000000\n")
          (compiler-backend-string-contains? asm "    .quad 0\n")
          (not
            (compiler-backend-string-contains?
              asm
              "    movabsq $0x8000000000000000, %rax\n"))
          (not (compiler-backend-string-contains? asm "    movq %rax, %xmm1\n"))
          true)
        (not (compiler-backend-string-contains? asm "    xorpd %xmm1, %xmm0\n"))
        (not
          (compiler-backend-string-contains?
            asm
            "    xorpd .L_tl_f64_sign_bit(%rip), %xmm0\n"))
        (match (compiler-backend-emit-source (compiler-backend-f64-source))
          [(ResultCompilerBackend.Ok no-neg-asm)
            (not
              (compiler-backend-string-contains?
                no-neg-asm
                ".L_tl_f64_sign_bit"))]
          [(ResultCompilerBackend.Err _) false]))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-f64-neg-sign-mask-object-render-ok?
  [image : cobj.CompilerObjectImage]
  [target : CompilerBackendTarget]) : bool
  (match target
    [(CompilerBackendTarget.Linux)
      (match (elf.compiler-object-elf-render image)
        [(elf.ResultCompilerObjectElf.Ok _) true]
        [(elf.ResultCompilerObjectElf.Err _) false])]
    [(CompilerBackendTarget.Windows)
      (match (coff.compiler-object-coff-render image)
        [(coff.ResultCompilerObjectCoff.Ok _) true]
        [(coff.ResultCompilerObjectCoff.Err _) false])]))

(define (compiler-backend-f64-neg-sign-mask-object-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-object-image-for-target
    (compiler-backend-f64-neg-object-source)
    target)
    [(ResultCompilerBackendObject.Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList (struct-get image sections)]
        [symbols : cobj.CompilerObjectSymbolList (struct-get image symbols)]
        [relocs : cobj.CompilerObjectRelocationList
          (struct-get image relocations)]
        [label : String (compiler-backend-f64-sign-bit-label)]
        (and
          (backend-and8
            (cobj.compiler-object-symbol-list-contains?
              symbols
              label
              (cobj.CompilerObjectSymbolBinding.Local)
              (cobj.CompilerObjectSymbolKind.Data))
            (cobj.compiler-object-section-contains-label?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              label)
            (cobj.compiler-object-section-contains-align?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              16)
            (cobj.compiler-object-section-label-has-i64-pair?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              label
              -9223372036854775808
              0)
            (cobj.compiler-object-section-contains-xorpd-rip? sections label)
            (cobj.compiler-object-relocation-list-contains?
              relocs
              (cobj.CompilerObjectRelocationKind.RipValue)
              label)
            true
            true)
          (compiler-backend-f64-neg-sign-mask-object-render-ok? image target)))]
    [(ResultCompilerBackendObject.Err _) false]))

(define (compiler-backend-f64-neg-sign-mask-object-ok?) : bool
  (and
    (compiler-backend-f64-neg-sign-mask-object-target-ok?
      (CompilerBackendTarget.Linux))
    (compiler-backend-f64-neg-sign-mask-object-target-ok?
      (CompilerBackendTarget.Windows))))

(define (compiler-backend-f64-neg-sign-mask-ok?) : bool
  (and
    (compiler-backend-f64-neg-sign-mask-asm-ok?)
    (compiler-backend-f64-neg-sign-mask-object-ok?)))

(define (compiler-backend-direct-f64-neg-home-ok?) : bool
  (match (compiler-backend-emit-unop
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        0
        (CompilerRegLocation.Register "%xmm2"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          1
          (CompilerRegLocation.Register "%xmm3"))
        CompilerRegAssignmentList.Nil))
    1
    (CompilerIrUnOp.Neg)
    (CompilerIrValue.Var 0)
    (AstType.F64))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    movsd %xmm2, %xmm3\n")
        (compiler-backend-string-contains?
          asm
          "    xorpd .L_tl_f64_sign_bit(%rip), %xmm3\n")
        (not (compiler-backend-string-contains? asm "%xmm0")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-spill-f64-neg-home-ok?) : bool
  (match (compiler-backend-emit-unop
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        0
        (CompilerRegLocation.Register "%xmm3"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
        CompilerRegAssignmentList.Nil))
    1
    (CompilerIrUnOp.Neg)
    (CompilerIrValue.Var 0)
    (AstType.F64))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    movsd %xmm3, %xmm2\n")
        (compiler-backend-string-contains?
          asm
          "    xorpd .L_tl_f64_sign_bit(%rip), %xmm2\n")
        (compiler-backend-string-contains? asm "    movsd %xmm2, -16(%rbp)\n")
        (not (compiler-backend-string-contains? asm "%xmm0")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-float-sqrt-home-ok?) : bool
  (let
    [direct : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%xmm2"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%xmm3"))
          CompilerRegAssignmentList.Nil))]
    [spill : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%xmm3"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
          CompilerRegAssignmentList.Nil))]
    (and
      (match (compiler-backend-emit-unop
        direct
        1
        (CompilerIrUnOp.Sqrt)
        (CompilerIrValue.Var 0)
        (AstType.F64))
        [(ResultCompilerBackend.Ok asm)
          (string.eq asm "    movsd %xmm2, %xmm3\n    sqrtsd %xmm3, %xmm3\n")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-unop
        direct
        1
        (CompilerIrUnOp.Sqrt)
        (CompilerIrValue.Var 0)
        (AstType.F32))
        [(ResultCompilerBackend.Ok asm)
          (string.eq asm "    movss %xmm2, %xmm3\n    sqrtss %xmm3, %xmm3\n")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-unop
        spill
        1
        (CompilerIrUnOp.Sqrt)
        (CompilerIrValue.Var 0)
        (AstType.F64))
        [(ResultCompilerBackend.Ok asm)
          (string.eq
            asm
            "    movsd %xmm3, %xmm2\n    sqrtsd %xmm2, %xmm2\n    movsd %xmm2, -16(%rbp)\n")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-unop
        spill
        1
        (CompilerIrUnOp.Sqrt)
        (CompilerIrValue.Var 0)
        (AstType.F32))
        [(ResultCompilerBackend.Ok asm)
          (string.eq
            asm
            "    movss %xmm3, %xmm2\n    sqrtss %xmm2, %xmm2\n    movss %xmm2, -16(%rbp)\n")]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-float-sqrt-source) : String
  "(define (sqrt64 [value : f64]) : f64 (__tl_float_sqrt value))
(define (sqrt32 [value : f32]) : f32 (__tl_float_sqrt value))
(define (main) : i64
  (if (= (sqrt64 4.0) 2.0)
    (if (= (sqrt32 (cast 9.0 : f32)) (cast 3.0 : f32)) 0 1)
    1))")

(define (compiler-backend-float-sqrt-source-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-float-sqrt-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    sqrtsd ")
        (compiler-backend-string-contains? asm "    sqrtss ")
        (not (compiler-backend-string-contains? asm "__tl_float_sqrt")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-float-sqrt-source-ok?) : bool
  (and
    (compiler-backend-float-sqrt-source-target-ok?
      (CompilerBackendTarget.Linux))
    (compiler-backend-float-sqrt-source-target-ok?
      (CompilerBackendTarget.Windows))))

(define (compiler-backend-float-bitcast-source) : String
  "(define (f64-bits [value : f64]) : u64 (__tl_float_to_bits value))
(define (f32-bits [value : f32]) : u32 (__tl_float_to_bits value))
(define (f64-from [bits : u64]) : f64 (__tl_float_from_bits bits))
(define (f32-from [bits : u32]) : f32 (__tl_float_from_bits bits))
(define (main) : i64
  (if (= (f64-bits (f64-from (cast 0x3ff0000000000000 : u64)))
         (cast 0x3ff0000000000000 : u64))
    (if (= (f32-bits (f32-from (cast 0x3f800000 : u32)))
           (cast 0x3f800000 : u32))
      42
      1)
    1))")

(define (compiler-backend-float-bitcast-source-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-float-bitcast-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    movq ")
        (compiler-backend-string-contains? asm "    movd ")
        (not (compiler-backend-string-contains? asm "__tl_float_to_bits"))
        (not (compiler-backend-string-contains? asm "__tl_float_from_bits"))
        (not (compiler-backend-string-contains? asm "tl_alloc")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-float-bitcast-source-ok?) : bool
  (and
    (compiler-backend-float-bitcast-source-target-ok?
      (CompilerBackendTarget.Linux))
    (compiler-backend-float-bitcast-source-target-ok?
      (CompilerBackendTarget.Windows))))

(define (compiler-backend-f32-literal-binop-source) : String
  "(define (main) : i64
  (let
    [b : f32 12.0]
    [x : i64 (if (< 11.0 b) 1 0)]
    [y : i64 (if (< b 13.0) 2 0)]
    [z : i64 (if (< (+ 1.0 b) 13.5) 4 0)]
    (+ x (+ y z))))")

(define (compiler-backend-f32-literal-binop-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-f32-literal-binop-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          (compiler-backend-float-bits-directive
            (AstType.F32)
            (compiler-backend-test-f32-bits "11.0")))
        (not (compiler-backend-string-contains? asm "    .float "))
        ;; FPO rsp-relative frame slot (the b:f32 local spills to 176(%rsp)).
        (compiler-backend-string-contains? asm "    ucomiss 176(%rsp), %xmm2\n")
        (compiler-backend-string-contains? asm "    addss 176(%rsp), %xmm2\n")
        (compiler-backend-string-contains? asm "    setb %r8b\n")
        (not
          (compiler-backend-string-contains? asm "    ucomiss %xmm1, %xmm0\n"))
        (not (compiler-backend-string-contains? asm "    addss %xmm1, %xmm0\n"))
        (not (compiler-backend-string-contains? asm "    cvtsd2ss "))
        (not (compiler-backend-string-contains? asm "    ucomisd")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-direct-float-binop-asm
  [op : CompilerIrBinOp]
  [ty : AstType]) : ResultCompilerBackend
  (compiler-backend-emit-binop
    (compiler-reg-var-type-cons
      (CompilerRegVarType.Type 0 ty)
      (compiler-reg-var-type-cons
        (CompilerRegVarType.Type 1 ty)
        (compiler-reg-var-type-cons
          (CompilerRegVarType.Type 2 ty)
          CompilerRegVarTypeList.Nil)))
    (CompilerBackendGlobalTypeList.Nil)
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        0
        (CompilerRegLocation.Register "%xmm2"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          1
          (CompilerRegLocation.Register "%xmm3"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            2
            (CompilerRegLocation.Register "%xmm4"))
          CompilerRegAssignmentList.Nil)))
    2
    op
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    ty))

(define (compiler-backend-direct-float-arith-home-ok?) : bool
  (match (compiler-backend-direct-float-binop-asm
    (CompilerIrBinOp.Add)
    (AstType.F64))
    [(ResultCompilerBackend.Ok f64-asm)
      (match (compiler-backend-direct-float-binop-asm
        (CompilerIrBinOp.Add)
        (AstType.F32))
        [(ResultCompilerBackend.Ok f32-asm)
          (and
            (backend-and4
              (compiler-backend-string-contains?
                f64-asm
                "    movsd %xmm2, %xmm4\n")
              (compiler-backend-string-contains?
                f64-asm
                "    addsd %xmm3, %xmm4\n")
              (compiler-backend-string-contains?
                f32-asm
                "    movss %xmm2, %xmm4\n")
              (compiler-backend-string-contains?
                f32-asm
                "    addss %xmm3, %xmm4\n"))
            (not (compiler-backend-string-contains? f64-asm "%xmm0"))
            (not (compiler-backend-string-contains? f64-asm "%xmm1"))
            (not (compiler-backend-string-contains? f32-asm "%xmm0"))
            (not (compiler-backend-string-contains? f32-asm "%xmm1")))]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-spill-float-arith-asm [ty : AstType]) : ResultCompilerBackend
  (compiler-backend-emit-binop
    (compiler-reg-var-type-cons
      (CompilerRegVarType.Type 0 ty)
      (compiler-reg-var-type-cons
        (CompilerRegVarType.Type 1 ty)
        (compiler-reg-var-type-cons
          (CompilerRegVarType.Type 2 ty)
          CompilerRegVarTypeList.Nil)))
    (CompilerBackendGlobalTypeList.Nil)
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        0
        (CompilerRegLocation.Register "%xmm3"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          1
          (CompilerRegLocation.Register "%xmm4"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 2 (CompilerRegLocation.Spill -16))
          CompilerRegAssignmentList.Nil)))
    2
    (CompilerIrBinOp.Add)
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    ty))

(define (compiler-backend-spill-float-arith-home-ok?) : bool
  (match (compiler-backend-spill-float-arith-asm (AstType.F64))
    [(ResultCompilerBackend.Ok f64-asm)
      (match (compiler-backend-spill-float-arith-asm (AstType.F32))
        [(ResultCompilerBackend.Ok f32-asm)
          (and
            (backend-and4
              (compiler-backend-string-contains?
                f64-asm
                "    movsd %xmm3, %xmm2\n")
              (compiler-backend-string-contains?
                f64-asm
                "    addsd %xmm4, %xmm2\n")
              (compiler-backend-string-contains?
                f32-asm
                "    movss %xmm3, %xmm2\n")
              (compiler-backend-string-contains?
                f32-asm
                "    addss %xmm4, %xmm2\n"))
            (compiler-backend-string-contains?
              f64-asm
              "    movsd %xmm2, -16(%rbp)\n")
            (compiler-backend-string-contains?
              f32-asm
              "    movss %xmm2, -16(%rbp)\n")
            (not (compiler-backend-string-contains? f64-asm "%xmm0"))
            (not (compiler-backend-string-contains? f64-asm "%xmm1"))
