;; Nothing synthesizes `main` (#7071): an executable entry emission of a
;; program without one is rejected, while no-entry (library) emission of the
;; same program still succeeds and exports no entry symbol.
(define (compiler-backend-missing-main-source) : String
  "(define token-value : i64 7)")

(define (compiler-backend-missing-main-rejected?
  [result : be_state.ResultCompilerBackend]) : bool
  (match result
    [(Ok _) false]
    [(Err diag)
      (string.contains
        (cdiag.compiler-diagnostic-message (__tl-box-place diag))
        "executable has no `main`")]))

(define (compiler-backend-missing-main-ok?) : bool
  (match (lower.lower-compiler-source (compiler-backend-missing-main-source))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (and
            (compiler-backend-missing-main-rejected?
              (compiler-backend-emit-program-with-spans-for-target-and-entry
                (owned_view.compiler-owned-shared-view program)
                (owned_view.compiler-owned-shared-view spans)
                (be_state.CompilerBackendTarget.Linux)
                true))
            (compiler-backend-missing-main-rejected?
              (compiler-backend-emit-program-with-spans-for-target-and-entry
                (owned_view.compiler-owned-shared-view program)
                (owned_view.compiler-owned-shared-view spans)
                (be_state.CompilerBackendTarget.Windows)
                true))
            (match (compiler-backend-emit-program-with-spans-for-target-and-entry
              program
              spans
              (be_state.CompilerBackendTarget.Linux)
              false)
              [(Ok asm)
                (and
                  (asm-has? asm ".text\n")
                  (asm-lacks? asm ".globl _tl_start\n" "_tl_start:\n" "main:\n"))]
              [(Err _) false]))]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-string-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-source (compiler-backend-string-source))
    (has
      ".L_tl_str_data_l2_13861_13991:"
      "    .ascii \"hi\"\n"
      "_tl_greeting:\n    .quad .L_tl_str_data_l2_13861_13991\n    .quad 2\n"
      "    leaq .L_tl_str_data_l2_13861_13991(%rip),")))

;; Backend-owned replacement for the string runtime helper emission tests:
;; non-allocating string parsing/equality still use backend
;; runtime helpers, while migrated allocating public helpers stay as ordinary
;; source-level calls instead of pulling in legacy helper bodies.
(define (compiler-backend-string-runtime-source) : String
  "(define (string.int->string [value : i64]) : String
  \"42\")
(define (string.substring [s : (& s str)] [start : i64] [len : i64]) : String
  (let
    [probe : char (__tl_string_ref s start)]
    \"x\"))
(define (string.concat [left : (& left str)] [right : (& right str)]) : String
  \"x\")
(define (io.emit-string [text : (& text str)]) : unit
  unit)
(define (io.emit-str [text : (& text str)]) : unit
  (io.emit-string text))
(define (parse-and-render [s : (& s str)]) : i64
  (+
    (if (__tl_string_eq s \"42\") 1 0)
    (+
      (__tl_string_to_int s)
      (+
        (__tl_string_length (string.int->string 42))
        (+
          (__tl_string_length (string.substring s 0 1))
          (__tl_string_length (string.concat s \"!\")))))))
(define (emit-stdout [s : (& s str)]) : unit
  (begin
    (io.emit-string s)
    (io.emit-str s)))
(define (main) : i64
  (begin
    (emit-stdout \"42\")
    (parse-and-render \"42\")))")

(define (compiler-backend-string-runtime-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-string-runtime-source))
    [(Ok asm)
      (let
        [ok : bool true]
        (if (asm-has? asm ".globl tl_string_eq\n")
          (set! ok false)
          unit)
        (if (asm-has? asm "    call tl_string_eq\n")
          (set! ok false)
          unit)
        (if (asm-has? asm ".extern tl_string_eq\n")
          (set! ok false)
          unit)
        (if (asm-has? asm ".globl tl_string_to_int\n")
          (set! ok false)
          unit)
        (if (asm-has? asm "tl_string_to_int:\n")
          (set! ok false)
          unit)
        (if (asm-has? asm "    call tl_string_to_int\n")
          (set! ok false)
          unit)
        (if (asm-has? asm ".extern tl_string_to_int\n")
          (set! ok false)
          unit)
        (if (asm-has? asm ".globl tl_int_to_string\n")
          (set! ok false)
          unit)
        (if (asm-has? asm "    call tl_int_to_string\n")
          (set! ok false)
          unit)
        (if (asm-has? asm ".extern tl_int_to_string\n")
          (set! ok false)
          unit)
        (if (asm-has? asm ".globl tl_substring\n")
          (set! ok false)
          unit)
        (if (asm-has? asm "    call tl_substring\n")
          (set! ok false)
          unit)
        (if (asm-has? asm ".extern tl_substring\n")
          (set! ok false)
          unit)
        (if (asm-has? asm ".globl tl_string_concat\n")
          (set! ok false)
          unit)
        (if (asm-has? asm "    call tl_string_concat\n")
          (set! ok false)
          unit)
        (if (asm-has? asm ".extern tl_string_concat\n")
          (set! ok false)
          unit)
        (if (let
          [needle (compiler-backend-todo-marker)]
          (asm-has? asm needle))
          (set! ok false)
          unit)
        ok)]
    [(Err _) false]))

(define (compiler-backend-shadowed-string-helpers-source) : String
  "(define (string.char-eq [a : char] [b : char]) : bool
  (= (cast a : i64) (cast b : i64)))
(define (string.eq [left : String] [right : String]) : bool
  (let
    [left-len : i64 (__tl_string_length left)]
    [right-len : i64 (__tl_string_length right)]
    (if (not (= left-len right-len))
      false
      (let
        [i : i64 0]
        [same : bool true]
        (begin
          (while (if same (< i left-len) false)
            (if (string.char-eq (__tl_string_ref left i) (__tl_string_ref right i))
              (set! i (+ i 1))
              (set! same false)))
          same)))))
(define (string.string=? [left : String] [right : String]) : bool
  (string.eq left right))
(define (string.append [left : String] [right : String]) : String
  left)
(define (string.>int [text : String]) : i64
  (let
    [n : i64 (__tl_string_length text)]
    [i : i64 0]
    [negative : bool false]
    [value : i64 0]
    (begin
      (if (if (> n 0) (string.char-eq (__tl_string_ref text 0) '-') false)
        (begin
          (set! negative true)
          (set! i 1))
        unit)
      (while (< i n)
        (begin
          (set!
            value
            (+ (* value 10) (- (cast (__tl_string_ref text i) : i64) 48)))
          (set! i (+ i 1))))
      (if negative
        (- 0 value)
        value))))
(define (main) : i64
  (if (if
    (string.eq \"same\" (string.append \"sa\" \"me\"))
    (if
      (not (string.string=? \"same\" \"different\"))
      (= (string.>int \"-42\") -42)
      false)
    false)
    42
    0))")

(define (compiler-backend-shadowed-string-helpers-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-shadowed-string-helpers-source))
    [(Ok asm)
