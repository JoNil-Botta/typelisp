    [(ResultCompilerBackendObject.Ok _) false]))

(define (compiler-backend-switch-object-phi-diagnostic-ok?) : bool
  (match (compiler-backend-emit-program-object-image-linux
    (compiler-backend-switch-phi-program)
    (compiler-source-spans-empty))
    [(ResultCompilerBackendObject.Err diag)
      (string.eq
        (compiler-diagnostic-message (box-get diag))
        (compiler-backend-switch-phi-target-message))]
    [(ResultCompilerBackendObject.Ok _) false]))

(define (compiler-backend-instr-diagnostics-ok?) : bool
  (and
    (compiler-backend-instr-diagnostic-case-ok?
      (CompilerIrInstr.Mov
        0
        (CompilerIrValue.F64 (compiler-backend-test-f64-bits "1.0"))
        (AstType.I64))
      "backend: f64 values are not supported yet"
      21
      7)
    (compiler-backend-instr-diagnostic-case-ok?
      (CompilerIrInstr.BinOp
        1
        (CompilerIrBinOp.Mod)
        (CompilerIrValue.F64 (compiler-backend-test-f64-bits "1.0"))
        (CompilerIrValue.F64 (compiler-backend-test-f64-bits "2.0"))
        (AstType.F64))
      "backend: unsupported float binary op"
      34
      9)
    ;; An unsupported f64 unary op is rejected. Neg and Sqrt have f64 lowering.
    (compiler-backend-instr-diagnostic-case-ok?
      (CompilerIrInstr.UnOp
        2
        (CompilerIrUnOp.Not)
        (CompilerIrValue.F64 (compiler-backend-test-f64-bits "1.0"))
        (AstType.F64))
      "backend: unsupported f64 unary op"
      40
      11)
    (compiler-backend-switch-asm-ok?)
    (compiler-backend-total-switch-asm-ok?)
    (compiler-backend-total-switch-pic-asm-ok?)
    (compiler-backend-total-switch-object-image-ok?)
    (compiler-backend-total-switch-lowered-opt2-asm-ok?)
    (compiler-backend-switch-base-asm-ok?)
    (compiler-backend-switch-shape-diagnostic-ok?)
    (compiler-backend-switch-phi-edge-copy-ok?)
    (compiler-backend-switch-object-image-ok?)
    (compiler-backend-switch-base-object-image-ok?)
    (compiler-backend-switch-object-shape-diagnostic-ok?)
    (compiler-backend-switch-object-phi-diagnostic-ok?)
    (compiler-backend-instr-diagnostic-case-ok?
      (ir-instr-vector-bin-op
        3
        (CompilerIrBinOp.Mod)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        8
        (AstType.I64))
      "backend: unsupported AVX-512 vector binary op"
      44
      13)))

(define (compiler-backend-avx2-map-source [elem : String]) : String
  (str_cat.str-cat
    "(define (fill [a : (Array "
    elem
    ")] [b : (Array "
    elem
    ")] [out : (Array "
    elem
    ")] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i (+ (array-ref a i) (array-ref b i)))))"))

(define (compiler-backend-uniform-map-source [elem : String]) : String
  (str_cat.str-cat
    "(define (fill [a : (Array "
    elem
    ")] [b : (Array "
    elem
    ")] [out : (Array "
    elem
    ")] [n : i64] [r : "
    elem
    "]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i (+ (+ (array-ref a i) (array-ref b i)) r))))"))

(define (compiler-backend-uniform-zip-source) : String
  "(define (fill [a : (Array i64)] [b : (Array i64)] [c : (Array i64)] [out : (Array i64)] [n : i64] [r : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i (+ (+ (* (array-ref a i) (array-ref b i)) (array-ref c i)) r))))")

(define (compiler-backend-lane-id-rodata-source) : String
  "(define (fill [out : (Array i64)] [other : (Array i64)] [n : i64]) : unit
  (begin
    (foreach
      ([i : i64 0 n])
      (array-set! out i (program-index)))
    (foreach
      ([j : i64 0 n])
      (array-set! other j (program-index)))))")

(define (compiler-backend-lane-id-rodata-shape-ok?
  [lower-mode : CompilerLowerMode]
  [backend-mode : CompilerBackendMode]
  [label : String]
  [align : String]
  [load : String]) : bool
  (match (lower-compiler-source-with-mode
    (compiler-backend-lane-id-rodata-source)
    lower-mode)
    [(ResultCompilerLower.Ok program spans)
      (match (compiler-backend-emit-program-target-with-mode
        program
        (CompilerBackendTarget.Linux)
        backend-mode
        spans
        true)
        [(ResultCompilerBackend.Ok asm)
          (and
            (backend-and4
              (compiler-backend-string-contains?
                asm
                (str_cat.str-cat "    .section .rodata\n" align label ":\n"))
              (=
                (compiler-backend-string-count
                  asm
                  (str_cat.str-cat label ":\n"))
                1)
              (>=
                (compiler-backend-string-count
                  asm
                  (str_cat.str-cat load " " label "(%rip), "))
                2)
              (not
                (compiler-backend-string-contains?
                  asm
                  (str_cat.str-cat label ":\n" load))))
            (not
              (compiler-backend-string-contains?
                asm
                "vector/mask IR emission is not implemented")))]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-backend-lane-id-rodata-ok?) : bool
  (and
    (compiler-backend-lane-id-rodata-shape-ok?
      (CompilerLowerMode.Avx2)
      (CompilerBackendMode.Avx2)
      (compiler-backend-avx2-i64-lane-id-label)
      "    .balign 32\n"
      "    vmovdqa")
    (compiler-backend-lane-id-rodata-shape-ok?
      (CompilerLowerMode.Avx512)
      (CompilerBackendMode.Avx512)
      (compiler-backend-avx512-i64-lane-id-label)
      "    .balign 64\n"
      "    vmovdqa64")
    (match (lower-compiler-source-with-mode
      (compiler-backend-lane-id-rodata-source)
      (CompilerLowerMode.Avx2))
      [(ResultCompilerLower.Ok program spans)
        (match (compiler-backend-emit-program-target-with-mode
          program
          (CompilerBackendTarget.Linux)
          (CompilerBackendMode.Avx2)
          spans
          true)
          [(ResultCompilerBackend.Ok asm)
            (let
              [body : String
                (compiler-backend-asm-function-body asm "_tl_fill")]
              [loop : String (compiler-backend-avx2-loop-body body)]
              (and
                (not (string.eq loop ""))
                (=
                  (compiler-backend-string-count
                    loop
                    (compiler-backend-avx2-i64-lane-id-label))
                  0)))]
          [(ResultCompilerBackend.Err _) false])]
      [(ResultCompilerLower.Err _) false])))

(define (compiler-backend-avx2-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]) : bool
  (match (lower-compiler-source-with-mode
    (compiler-backend-avx2-map-source elem)
    (CompilerLowerMode.Avx2))
    [(ResultCompilerLower.Ok program spans)
      (match (compiler-backend-emit-program-target-with-mode
        program
        (CompilerBackendTarget.Linux)
        (CompilerBackendMode.Avx2)
        spans
        true)
        [(ResultCompilerBackend.Ok asm)
          (and
            (backend-and4
              (compiler-backend-string-contains? asm "    vzeroupper\n")
              (compiler-backend-string-contains? asm move)
              (compiler-backend-string-contains? asm op)
              (compiler-backend-string-contains? asm "%ymm"))
            (not
              (compiler-backend-string-contains?
                asm
                "vector/mask IR emission is not implemented")))]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-backend-avx2-vector-map-ok?) : bool
  (and
    (compiler-backend-avx2-map-asm-contains? "i64" "    vmovdqu " "    vpaddq ")
    (compiler-backend-avx2-map-asm-contains? "i32" "    vmovdqu " "    vpaddd ")
    (compiler-backend-avx2-map-asm-contains? "i16" "    vmovdqu " "    vpaddw ")
    (compiler-backend-avx2-map-asm-contains? "u16" "    vmovdqu " "    vpaddw ")
    (compiler-backend-avx2-map-asm-contains? "f64" "    vmovupd " "    vaddpd ")
    (compiler-backend-avx2-map-asm-contains? "f32" "    vmovups " "    vaddps ")
    (compiler-backend-avx2-map-asm-contains? "i8" "    vmovdqu " "    vpaddb ")
    (compiler-backend-avx2-map-asm-contains? "u8" "    vmovdqu " "    vpaddb ")))

(define (compiler-backend-avx2-uniform-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]
  [broadcast : String]) : bool
  (match (lower-compiler-source-with-mode
    (compiler-backend-uniform-map-source elem)
    (CompilerLowerMode.Avx2))
    [(ResultCompilerLower.Ok program spans)
      (match (compiler-backend-emit-program-target-with-mode
        program
        (CompilerBackendTarget.Linux)
        (CompilerBackendMode.Avx2)
        spans
        true)
        [(ResultCompilerBackend.Ok asm)
          (let
            [body : String (compiler-backend-asm-function-body asm "_tl_fill")]
            [loop : String (compiler-backend-avx2-loop-body body)]
            (and
              (backend-and8
                (compiler-backend-string-contains? asm "    vzeroupper\n")
                (compiler-backend-string-contains? asm move)
                (compiler-backend-string-contains? asm op)
                (compiler-backend-string-contains? asm broadcast)
                (compiler-backend-string-contains? asm "%ymm")
                (not
                  (compiler-backend-string-contains?
                    asm
                    "vector/mask IR emission is not implemented"))
                (= (compiler-backend-string-count loop broadcast) 0)
                true)
              true))]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-backend-avx2-uniform-zip-ok?) : bool
  (match (lower-compiler-source-with-mode
    (compiler-backend-uniform-zip-source)
    (CompilerLowerMode.Avx2))
    [(ResultCompilerLower.Ok program spans)
      (match (compiler-backend-emit-program-target-with-mode
        program
        (CompilerBackendTarget.Linux)
        (CompilerBackendMode.Avx2)
        spans
        true)
        [(ResultCompilerBackend.Ok asm)
          (and
            (backend-and8
              (compiler-backend-string-contains? asm "    vpbroadcastq ")
              (compiler-backend-string-contains? asm "    vpmuludq ")
              (compiler-backend-string-contains? asm "    vpsllq $32, ")
              (compiler-backend-string-contains? asm "    vpaddq ")
              (compiler-backend-string-contains? asm "    vmovdqu ")
              (compiler-backend-string-contains? asm "%ymm")
              (not
                (compiler-backend-string-contains?
                  asm
                  "vector/mask IR emission is not implemented"))
              true)
            true)]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerLower.Err _) false]))

;; The uniform value may move when preheader caches change register pressure;
;; these checks care that its broadcast is emitted, not which spill owns it.
(define (compiler-backend-avx2-uniform-vector-map-ok?) : bool
  (and
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i64"
      "    vmovdqu "
      "    vpaddq "
      "    vpbroadcastq ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i32"
      "    vmovdqu "
      "    vpaddd "
      "    vpbroadcastd ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i16"
      "    vmovdqu "
      "    vpaddw "
      "    vpbroadcastw ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "u16"
      "    vmovdqu "
      "    vpaddw "
      "    vpbroadcastw ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "f64"
      "    vmovupd "
      "    vaddpd "
      "    vbroadcastsd ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "f32"
      "    vmovups "
      "    vaddps "
      "    vbroadcastss ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i8"
      "    vmovdqu "
      "    vpaddb "
      "    vpbroadcastb ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "u8"
      "    vmovdqu "
      "    vpaddb "
      "    vpbroadcastb ")
    (compiler-backend-avx2-uniform-zip-ok?)))

(define (compiler-backend-stack-splat-dst-only-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%vec6"))
    CompilerRegAssignmentList.Nil))

(define (compiler-backend-stack-splat-spill-assignments [offset : i64]) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%vec6"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill offset))
      CompilerRegAssignmentList.Nil)))

(define (compiler-backend-stack-splat-register-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%vec6"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r12"))
      CompilerRegAssignmentList.Nil)))

(define (compiler-backend-stack-splat-float-register-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%vec6"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        1
        (CompilerRegLocation.Register "%xmm3"))
      CompilerRegAssignmentList.Nil)))

(define (compiler-backend-stack-memory-operand-ok?) : bool
  (and
    (match (compiler-backend-stack-memory-operand
      (compiler-backend-stack-splat-dst-only-assignments)
      (CompilerIrValue.Var 1))
      [(CompilerBackendMaybeStackOperand.Some operand)
        (string.eq operand "-16(%rbp)")]
      [(CompilerBackendMaybeStackOperand.No) false])
    (match (compiler-backend-stack-memory-operand
      (compiler-backend-stack-splat-spill-assignments -40)
      (CompilerIrValue.Var 1))
      [(CompilerBackendMaybeStackOperand.Some operand)
        (string.eq operand "-40(%rbp)")]
      [(CompilerBackendMaybeStackOperand.No) false])
    (match (compiler-backend-stack-memory-operand
      (compiler-backend-stack-splat-register-assignments)
      (CompilerIrValue.Var 1))
      [(CompilerBackendMaybeStackOperand.Some _) false]
      [(CompilerBackendMaybeStackOperand.No) true])
    (match (compiler-backend-stack-memory-operand
      (compiler-backend-stack-splat-dst-only-assignments)
      (CompilerIrValue.I64 7))
      [(CompilerBackendMaybeStackOperand.Some _) false]
      [(CompilerBackendMaybeStackOperand.No) true])))

(define (compiler-backend-avx2-stack-splat-i64-ok?) : bool
  (match (compiler-backend-emit-avx2-splat
    (compiler-backend-stack-splat-dst-only-assignments)
    0
    (CompilerIrValue.Var 1)
    4
    (AstType.I64)
    ""
    ""
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (string.eq asm "    vpbroadcastq -16(%rbp), %ymm6\n")
        (not (compiler-backend-string-contains? asm "%rax"))
        (not (compiler-backend-string-contains? asm "%xmm0")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx2-stack-splat-f64-spill-ok?) : bool
  (match (compiler-backend-emit-avx2-splat
    (compiler-backend-stack-splat-spill-assignments -40)
    0
    (CompilerIrValue.Var 1)
    4
    (AstType.F64)
    ""
    ""
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (string.eq asm "    vbroadcastsd -40(%rbp), %ymm6\n")
        (not (compiler-backend-string-contains? asm "%xmm0")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-stack-splat-i64-ok?) : bool
  (match (compiler-backend-emit-avx512-splat
    (compiler-backend-stack-splat-dst-only-assignments)
    0
    (CompilerIrValue.Var 1)
    8
    (AstType.I64)
    ""
    ""
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (string.eq asm "    vpbroadcastq -16(%rbp), %zmm6\n")
        (not (compiler-backend-string-contains? asm "%rax"))
        (not (compiler-backend-string-contains? asm "%xmm0")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-stack-splat-f64-spill-ok?) : bool
  (match (compiler-backend-emit-avx512-splat
    (compiler-backend-stack-splat-spill-assignments -40)
    0
    (CompilerIrValue.Var 1)
    8
    (AstType.F64)
    ""
    ""
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (string.eq asm "    vbroadcastsd -40(%rbp), %zmm6\n")
        (not (compiler-backend-string-contains? asm "%xmm0")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-register-splat-fallback-ok?) : bool
  (and
    (match (compiler-backend-emit-avx2-splat
      (compiler-backend-stack-splat-register-assignments)
      0
      (CompilerIrValue.Var 1)
      4
      (AstType.I64)
      ""
      ""
      (compiler-diagnostic-at-start "" ""))
      [(ResultCompilerBackend.Ok asm)
        (and
          (string.eq
            asm
            "    movq %r12, %r8\n    vmovq %r8, %xmm2\n    vpbroadcastq %xmm2, %ymm6\n")
          (not (compiler-backend-string-contains? asm "%rax"))
          (not (compiler-backend-string-contains? asm "%xmm0")))]
      [(ResultCompilerBackend.Err _) false])
    (match (compiler-backend-emit-avx2-splat
      (compiler-backend-stack-splat-float-register-assignments)
      0
      (CompilerIrValue.Var 1)
      4
      (AstType.F64)
      ""
      ""
      (compiler-diagnostic-at-start "" ""))
      [(ResultCompilerBackend.Ok asm)
        (and
          (string.eq
            asm
            "    movsd %xmm3, %xmm2\n    vbroadcastsd %xmm2, %ymm6\n")
          (not (compiler-backend-string-contains? asm "%xmm0")))]
      [(ResultCompilerBackend.Err _) false])
    (match (compiler-backend-emit-avx512-splat
      (compiler-backend-stack-splat-register-assignments)
      0
      (CompilerIrValue.Var 1)
      8
      (AstType.I64)
      ""
      ""
      (compiler-diagnostic-at-start "" ""))
      [(ResultCompilerBackend.Ok asm)
        (and
          (string.eq asm "    movq %r12, %r8\n    vpbroadcastq %r8, %zmm6\n")
          (not (compiler-backend-string-contains? asm "%rax")))]
      [(ResultCompilerBackend.Err _) false])
    (match (compiler-backend-emit-avx512-splat
      (compiler-backend-stack-splat-float-register-assignments)
      0
      (CompilerIrValue.Var 1)
      8
      (AstType.F64)
      ""
      ""
      (compiler-diagnostic-at-start "" ""))
      [(ResultCompilerBackend.Ok asm)
        (and
          (string.eq
            asm
            "    movsd %xmm3, %xmm2\n    vbroadcastsd %xmm2, %zmm6\n")
          (not (compiler-backend-string-contains? asm "%xmm0")))]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-stack-splat-broadcast-ok?) : bool
  (and
    (compiler-backend-stack-memory-operand-ok?)
    (compiler-backend-avx2-stack-splat-i64-ok?)
    (compiler-backend-avx2-stack-splat-f64-spill-ok?)
    (compiler-backend-avx512-stack-splat-i64-ok?)
    (compiler-backend-avx512-stack-splat-f64-spill-ok?)
    (compiler-backend-register-splat-fallback-ok?)))

(define (compiler-backend-vector-spill-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%rdi"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r12"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%vec6"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 3 (CompilerRegLocation.Spill -64))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              4
              (CompilerRegLocation.Register "%k1"))
            CompilerRegAssignmentList.Nil))))))

(define (compiler-backend-avx2-vector-load-spill-dst-ok?) : bool
  (match (compiler-backend-emit-avx2-vector-load
    (compiler-backend-vector-spill-assignments)
    3
    (CompilerIrValue.Var 0)
    (CompilerIrValue.I64 0)
    4
    (AstType.I64)
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (string.eq
        asm
        "    vmovdqu (%rdi), %ymm14\n    vmovdqu %ymm14, -64(%rbp)\n")]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx2-vector-binop-spill-ok?) : bool
  (match (compiler-backend-emit-avx2-vector-binop
    (compiler-backend-vector-spill-assignments)
    3
    (CompilerIrBinOp.Add)
    (CompilerIrValue.Var 3)
    (CompilerIrValue.Var 2)
    4
    (AstType.I64)
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (string.eq
        asm
        "    vmovdqu -64(%rbp), %ymm14\n    vpaddq %ymm6, %ymm14, %ymm14\n    vmovdqu %ymm14, -64(%rbp)\n")]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-vector-prefix-spill-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%vec6"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r12"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 2 (CompilerRegLocation.Spill -64))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-vector-prefix-source-carry-spill-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -64))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -8))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%vec7"))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-avx2-vector-prefix-i64-spill-ok?) : bool
  (match (compiler-backend-emit-avx2-vector-prefix
    (compiler-backend-vector-prefix-spill-assignments)
    2
    (CompilerIrVectorPrefixOp.Min)
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    4
    (AstType.I64)
    "%r14"
    "%xmm14"
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    vmovdqu %ymm6, %ymm14\n")
        (compiler-backend-string-contains?
          asm
          "    vpslldq $8, %ymm14, %ymm0\n")
        (compiler-backend-string-contains?
          asm
          "    vperm2i128 $0, %ymm14, %ymm14, %ymm0\n")
        (compiler-backend-string-contains? asm "    vpcmpgtq ")
        (compiler-backend-string-contains? asm "    vpandn ")
        (compiler-backend-string-contains? asm "    vmovq %r14, %xmm0\n")
        (compiler-backend-string-contains?
          asm
          "    vmovdqu %ymm14, -64(%rbp)\n"))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx2-vector-prefix-source-carry-spill-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-backend-vector-prefix-source-carry-spill-assignments)]
    (and
      (match (compiler-backend-emit-avx2-vector-prefix
        assignments
        2
        (CompilerIrVectorPrefixOp.Sum)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        4
        (AstType.I64)
        "%r14"
        "%xmm14"
        (compiler-diagnostic-at-start "" ""))
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    vmovdqu -64(%rbp), %ymm7\n")
            (compiler-backend-string-contains?
              asm
              "    vpbroadcastq -8(%rbp), %ymm0\n")
            (not
              (compiler-backend-string-contains?
                asm
                "    vmovdqu %ymm7, -64(%rbp)\n")))]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-avx2-vector-prefix
        assignments
        2
        (CompilerIrVectorPrefixOp.Any)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        32
        (AstType.Bool)
        "%r14"
        "%xmm14"
        (compiler-diagnostic-at-start "" ""))
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    vmovdqu -64(%rbp), %ymm7\n")
            (compiler-backend-string-contains? asm "    movq -8(%rbp), %r14\n")
            (compiler-backend-string-contains? asm "    setne %r14b\n")
            (compiler-backend-string-contains?
              asm
              "    vpbroadcastb %xmm0, %ymm0\n"))]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-avx2-vector-prefix-bool-spill-ok?) : bool
  (match (compiler-backend-emit-avx2-vector-prefix
    (compiler-backend-vector-prefix-spill-assignments)
    2
    (CompilerIrVectorPrefixOp.All)
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    32
    (AstType.Bool)
    "%r14"
    "%xmm14"
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          "    vpslldq $1, %ymm14, %ymm0\n")
        (compiler-backend-string-contains?
          asm
          "    vpslldq $8, %ymm14, %ymm0\n")
        (compiler-backend-string-contains?
          asm
          "    vpbroadcastb %xmm0, %ymm0\n")
        (compiler-backend-string-contains? asm "    setne %r14b\n")
        (compiler-backend-string-contains?
          asm
          "    vpand %ymm0, %ymm14, %ymm14\n")
        (not (compiler-backend-string-contains? asm "%al"))
        (compiler-backend-string-contains?
          asm
          "    vmovdqu %ymm14, -64(%rbp)\n"))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-vector-prefix-numeric-spill-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-backend-vector-prefix-spill-assignments)]
    (and
      (match (compiler-backend-emit-avx512-vector-prefix
        assignments
        2
        (CompilerIrVectorPrefixOp.Min)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        8
        (AstType.I64)
        "%r14"
        "%xmm14"
        (compiler-diagnostic-at-start "" ""))
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    vmovdqu64 %zmm6, %zmm14\n")
            (compiler-backend-string-contains?
              asm
              "    valignq $7, %zmm1, %zmm14, %zmm0\n")
            (compiler-backend-string-contains?
              asm
              "    kshiftlw $4, %k7, %k7\n")
            (compiler-backend-string-contains?
              asm
              "    vpminsq %zmm0, %zmm14, %zmm14{%k7}\n")
            (compiler-backend-string-contains?
              asm
              "    vpbroadcastq %r14, %zmm0\n")
            (compiler-backend-string-contains?
              asm
              "    vmovdqu64 %zmm14, -64(%rbp)\n"))]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-avx512-vector-prefix
        assignments
        2
        (CompilerIrVectorPrefixOp.Max)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        16
        (AstType.I32)
        "%r14"
        "%xmm14"
        (compiler-diagnostic-at-start "" ""))
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    valignd $15, %zmm1, %zmm14, %zmm0\n")
            (compiler-backend-string-contains?
              asm
              "    valignd $8, %zmm1, %zmm14, %zmm0\n")
            (compiler-backend-string-contains?
              asm
              "    vpmaxsd %zmm0, %zmm14, %zmm14{%k7}\n")
            (compiler-backend-string-contains?
              asm
              "    vpbroadcastd %r14d, %zmm0\n"))]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-avx512-vector-prefix-bool-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%k2"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%rax"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 2 (CompilerRegLocation.Spill -64))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-avx512-vector-prefix-bool-source-spill-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -64))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -8))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%k3"))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-avx512-vector-prefix-bool-scratch-requirement
  [ordinal : i64]
  [var : i64]) : CompilerRegScratchRequirement
  (compiler-reg-scratch-requirement-local
    (CompilerRegTargetAbi.Linux)
    (compiler-reg-scratch-policy
      (CompilerRegTargetAbi.Linux)
      CompilerRegAssignmentList.Nil
      CompilerRegStringList.Nil)
    CompilerRegAssignmentList.Nil
    CompilerRegVarTypeList.Nil
    (ir-instr-vector-prefix
      2
      (CompilerIrVectorPrefixOp.Any)
      (CompilerIrValue.Var 0)
      (CompilerIrValue.Var 1)
      64
      (AstType.Bool))
    0
    ordinal
    var
    false))

(define (compiler-backend-avx512-vector-prefix-bool-scratch-classes-ok?) : bool
  (let
    [carry : CompilerRegScratchRequirement
      (compiler-backend-avx512-vector-prefix-bool-scratch-requirement 0 3)]
    [bits : CompilerRegScratchRequirement
      (compiler-backend-avx512-vector-prefix-bool-scratch-requirement 1 4)]
    (and
      (match (struct-get carry role)
        [(CompilerRegScratchRole.VectorPrefixCarry) true]
        [_ false])
      (match (struct-get bits role)
        [(CompilerRegScratchRole.VectorPrefixBits) true]
        [_ false])
      (match (struct-get (struct-get carry constraint) register-class)
        [(CompilerRegScratchClass.Gp) true]
        [_ false])
      (match (struct-get (struct-get bits constraint) register-class)
        [(CompilerRegScratchClass.Gp) true]
        [_ false]))))

(define (compiler-backend-avx512-vector-prefix-bool-spill-ok?) : bool
  (let
    [diag : CompilerDiagnostic (compiler-diagnostic-at-start "" "")]
    (and
      (match (compiler-backend-emit-avx512-vector-prefix
        (compiler-backend-avx512-vector-prefix-bool-assignments)
        2
        (CompilerIrVectorPrefixOp.All)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        64
        (AstType.Bool)
        "%r14"
        "%r13"
        diag)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains? asm "    kmovq %k2, %r13\n")
            (compiler-backend-string-contains? asm "    notq %r13\n")
            (compiler-backend-string-contains? asm "    shlq $32, %r14\n")
            (compiler-backend-string-contains? asm "    movq %rax, %r14\n")
            (compiler-backend-string-contains? asm "    setne %r14b\n")
            (compiler-backend-string-contains? asm "    andq %r14, %r13\n")
            (compiler-backend-string-contains? asm "    kmovq %r13, %k7\n")
            (compiler-backend-string-contains? asm "    kmovq %k7, -64(%rbp)\n")
            (not
              (compiler-backend-string-contains? asm "    kmovq %k2, %rax\n"))
            (not (compiler-backend-string-contains? asm "%zmm")))]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-avx512-vector-prefix
        (compiler-backend-avx512-vector-prefix-bool-source-spill-assignments)
        2
        (CompilerIrVectorPrefixOp.Any)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.Var 1)
        64
        (AstType.Bool)
        "%r14"
        "%r13"
        diag)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains? asm "    kmovq -64(%rbp), %k7\n")
            (compiler-backend-string-contains? asm "    kmovq %k7, %r13\n")
            (compiler-backend-string-contains? asm "    movq -8(%rbp), %r14\n")
            (compiler-backend-string-contains? asm "    orq %r14, %r13\n")
            (compiler-backend-string-contains? asm "    kmovq %r13, %k3\n")
            (not (compiler-backend-string-contains? asm "%rax")))]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-avx512-predicated-load-spill-dst-ok?) : bool
  (match (compiler-backend-emit-avx512-predicated-load
    (compiler-backend-vector-spill-assignments)
    3
    (CompilerIrValue.Var 0)
    (CompilerIrValue.I64 0)
    (CompilerIrValue.Var 4)
    8
    (AstType.I64)
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (string.eq
        asm
        "    vmovdqu64 (%rdi), %zmm14{%k1}{z}\n    vmovdqu64 %zmm14, -64(%rbp)\n")]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-select-spill-ok?) : bool
  (match (compiler-backend-emit-avx512-select
    (compiler-backend-vector-spill-assignments)
    3
    (CompilerIrValue.Var 4)
    (CompilerIrValue.Var 2)
    (CompilerIrValue.Var 3)
    8
    (AstType.I64)
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (string.eq
        asm
        "    vmovdqu64 -64(%rbp), %zmm14\n    vmovdqu64 %zmm6, %zmm14{%k1}\n    vmovdqu64 %zmm14, -64(%rbp)\n")]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx2-vector-reduce-spill-source-ok?) : bool
  (match (compiler-backend-emit-avx2-vector-reduce
    (compiler-backend-vector-spill-assignments)
    5
    (CompilerIrVectorReduceOp.Sum)
    (CompilerIrValue.Var 3)
    4
    (AstType.I64)
    ""
    ""
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          "    vmovdqu -64(%rbp), %ymm14\n")
        (compiler-backend-string-contains? asm "    vextracti128 $1, %ymm14, ")
        (compiler-backend-string-contains? asm "    vmovq "))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-vector-reduce-spill-source-ok?) : bool
  (match (compiler-backend-emit-avx512-vector-reduce
    (compiler-backend-vector-spill-assignments)
    5
    (CompilerIrVectorReduceOp.Sum)
    (CompilerIrValue.Var 3)
    8
    (AstType.I64)
    ""
    ""
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          "    vmovdqu64 -64(%rbp), %zmm14\n")
        (compiler-backend-string-contains? asm "    vextracti64x4 $1, %zmm14, ")
        (compiler-backend-string-contains? asm "    vmovq "))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-vector-spill-reload-ok?) : bool
  (and
    (compiler-backend-avx2-vector-load-spill-dst-ok?)
    (compiler-backend-avx2-vector-binop-spill-ok?)
    (compiler-backend-avx2-vector-prefix-i64-spill-ok?)
    (compiler-backend-avx2-vector-prefix-source-carry-spill-ok?)
    (compiler-backend-avx2-vector-prefix-bool-spill-ok?)
    (compiler-backend-avx512-vector-prefix-numeric-spill-ok?)
    (compiler-backend-avx512-vector-prefix-bool-scratch-classes-ok?)
    (compiler-backend-avx512-vector-prefix-bool-spill-ok?)
    (compiler-backend-avx512-predicated-load-spill-dst-ok?)
    (compiler-backend-avx512-select-spill-ok?)
    (compiler-backend-avx2-vector-reduce-spill-source-ok?)
    (compiler-backend-avx512-vector-reduce-spill-source-ok?)))

(define (compiler-backend-vector-spill-pressure-source) : String
  "(define (fill
  [a0 : (Array i64)]
  [a1 : (Array i64)]
  [a2 : (Array i64)]
  [a3 : (Array i64)]
  [a4 : (Array i64)]
  [a5 : (Array i64)]
  [a6 : (Array i64)]
  [a7 : (Array i64)]
  [a8 : (Array i64)]
  [a9 : (Array i64)]
  [a10 : (Array i64)]
  [a11 : (Array i64)]
  [a12 : (Array i64)]
  [a13 : (Array i64)]
  [a14 : (Array i64)]
  [a15 : (Array i64)]
  [out : (Array i64)]
  [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i
      (+ (array-ref a0 i)
        (+ (array-ref a1 i)
          (+ (array-ref a2 i)
            (+ (array-ref a3 i)
              (+ (array-ref a4 i)
                (+ (array-ref a5 i)
                  (+ (array-ref a6 i)
                    (+ (array-ref a7 i)
                      (+ (array-ref a8 i)
                        (+ (array-ref a9 i)
                          (+ (array-ref a10 i)
                            (+ (array-ref a11 i)
                              (+ (array-ref a12 i)
                                (+ (array-ref a13 i)
                                  (+ (array-ref a14 i)
                                    (array-ref a15 i)))))))))))))))))))")

(define (compiler-backend-vector-spill-pressure-mode-ok?
  [lower-mode : CompilerLowerMode]
  [backend-mode : CompilerBackendMode]
  [scratch : String]) : bool
  (match (lower-compiler-source-with-mode
    (compiler-backend-vector-spill-pressure-source)
    lower-mode)
    [(ResultCompilerLower.Ok program spans)
      (match (compiler-backend-emit-program-target-with-mode
        program
        (CompilerBackendTarget.Linux)
        backend-mode
        spans
        true)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains? asm scratch)
            (not
              (compiler-backend-string-contains?
                asm
                "vector spills are not implemented"))
            (not
              (compiler-backend-string-contains?
                asm
                "vector register home unavailable")))]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerLower.Err _) false]))

(define (compiler-backend-vector-spill-pressure-ok?) : bool
  (and
    (compiler-backend-vector-spill-pressure-mode-ok?
      (CompilerLowerMode.Avx2)
      (CompilerBackendMode.Avx2)
      "%ymm14")
    (compiler-backend-vector-spill-pressure-mode-ok?
      (CompilerLowerMode.Avx512)
      (CompilerBackendMode.Avx512)
      "%zmm14")))

(define (compiler-backend-simd-address-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%rdi"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r12"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%rax"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            3
            (CompilerRegLocation.Register "%vec6"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              4
              (CompilerRegLocation.Register "%vec7"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                5
                (CompilerRegLocation.Register "%k1"))
              (compiler-reg-assignment-cons
                (CompilerRegAssignment.Assignment
                  6
                  (CompilerRegLocation.Register "%rcx"))
                CompilerRegAssignmentList.Nil))))))))

(define (compiler-backend-simd-indexed-address-with-base-emits?
  [base : CompilerIrValue]
  [index : CompilerIrValue]
  [elem-ty : AstType]
  [want-asm : String]
  [want-addr : String]) : bool
  (match (compiler-backend-emit-simd-indexed-address
    (compiler-backend-simd-address-assignments)
    base
    index
    elem-ty)
    [(ResultCompilerBackendSimdIndexedAddress.Ok addr-plan)
      (and
        (string.eq (struct-get addr-plan asm) want-asm)
        (string.eq (struct-get addr-plan addr) want-addr))]
    [(ResultCompilerBackendSimdIndexedAddress.Err _) false]))

(define (compiler-backend-simd-indexed-address-emits?
  [index : CompilerIrValue]
  [elem-ty : AstType]
  [want-asm : String]
  [want-addr : String]) : bool
  (compiler-backend-simd-indexed-address-with-base-emits?
    (CompilerIrValue.Var 0)
    index
    elem-ty
    want-asm
    want-addr))

(define (compiler-backend-simd-indexed-address-ok?) : bool
  (and
    (compiler-backend-simd-indexed-address-emits?
      (CompilerIrValue.I64 0)
      (AstType.I64)
      ""
      "(%rdi)")
    (compiler-backend-simd-indexed-address-emits?
      (CompilerIrValue.I64 4)
      (AstType.I64)
      ""
      "32(%rdi)")
    (compiler-backend-simd-indexed-address-emits?
      (CompilerIrValue.Var 1)
      (AstType.I32)
      ""
      "(%rdi,%r12,4)")
    (compiler-backend-simd-indexed-address-emits?
      (CompilerIrValue.Var 2)
      (AstType.I64)
      ""
      "(%rdi,%rax,8)")
    (compiler-backend-simd-indexed-address-with-base-emits?
      (CompilerIrValue.Var 6)
      (CompilerIrValue.Var 2)
      (AstType.I64)
      ""
      "(%rcx,%rax,8)")
    (compiler-backend-simd-indexed-address-emits?
      (CompilerIrValue.Var 7)
      (AstType.I64)
      "    movq -64(%rbp), %r9\n"
      "(%rdi,%r9,8)")))

(define (compiler-backend-avx2-vector-load-address-ok?) : bool
  (match (compiler-backend-emit-avx2-vector-load
    (compiler-backend-simd-address-assignments)
    3
    (CompilerIrValue.Var 0)
    (CompilerIrValue.I64 4)
    4
    (AstType.I64)
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (string.eq asm "    vmovdqu 32(%rdi), %ymm6\n")]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx2-vector-store-address-ok?) : bool
  (match (compiler-backend-emit-avx2-vector-store
    (compiler-backend-simd-address-assignments)
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    (CompilerIrValue.Var 4)
    4
    (AstType.I64)
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (string.eq asm "    vmovdqu %ymm7, (%rdi,%r12,8)\n")]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-predicated-load-address-ok?) : bool
  (match (compiler-backend-emit-avx512-predicated-load
    (compiler-backend-simd-address-assignments)
    3
    (CompilerIrValue.Var 0)
    (CompilerIrValue.I64 4)
    (CompilerIrValue.Var 5)
    8
    (AstType.I64)
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (string.eq asm "    vmovdqu64 32(%rdi), %zmm6{%k1}{z}\n")]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-simd-indexed-address-users-ok?) : bool
  (and
    (compiler-backend-avx2-vector-load-address-ok?)
    (compiler-backend-avx2-vector-store-address-ok?)
    (compiler-backend-avx512-predicated-load-address-ok?)))

(define (compiler-backend-avx512-masked-if-source) : String
  "(define (fill [xs : (Array i64)] [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< (array-ref xs i) 0)
      (array-set! out i 0)
      (array-set! out i (+ (array-ref xs i) 1)))))")

(define (compiler-backend-avx512-masked-if-offset-source) : String
  "(define (fill [xs : (Array i64)] [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< (array-ref xs (+ i 1)) 0)
      (array-set! out (+ i 1) 0)
      (array-set! out (+ i 1) (+ (array-ref xs (+ i 1)) 1)))))")

(define (compiler-backend-avx512-masked-if-index-value-source) : String
  "(define (fill [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< i 6)
      (array-set! out i i)
      (array-set! out i (+ i 1)))))")

(define (compiler-backend-avx512-masked-if-index-mod-source) : String
  "(define (fill [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (= (% i 2) 0)
      (array-set! out i (+ i 10))
      (array-set! out i (+ i 100)))))")

(define (compiler-backend-avx512-masked-if-value-source) : String
  "(define (fill [xs : (Array i64)] [out : (Array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i
      (if (< (array-ref xs i) 0)
        0
        (+ (array-ref xs i) 1)))))")

(define (compiler-backend-avx512-select-alias-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%vec6"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%k1"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%vec6"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            3
            (CompilerRegLocation.Register "%vec7"))
          CompilerRegAssignmentList.Nil)))))

(define (compiler-backend-avx512-select-false-alias-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%vec7"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%k1"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%vec6"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            3
            (CompilerRegLocation.Register "%vec7"))
          CompilerRegAssignmentList.Nil)))))

(define (compiler-backend-avx512-select-true-alias-ok?) : bool
  (match (compiler-backend-emit-avx512-select
    (compiler-backend-avx512-select-alias-assignments)
    0
    (CompilerIrValue.Var 1)
    (CompilerIrValue.Var 2)
    (CompilerIrValue.Var 3)
    8
    (AstType.I64)
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    vmovdqu64 %zmm6, %zmm8\n")
        (compiler-backend-string-contains? asm "    vmovdqu64 %zmm7, %zmm6\n")
        (compiler-backend-string-contains?
          asm
          "    vmovdqu64 %zmm8, %zmm6{%k1}\n")
        (not (compiler-backend-string-contains? asm "%zmm15")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-select-false-alias-ok?) : bool
  (match (compiler-backend-emit-avx512-select
    (compiler-backend-avx512-select-false-alias-assignments)
    0
    (CompilerIrValue.Var 1)
    (CompilerIrValue.Var 2)
    (CompilerIrValue.Var 3)
    8
    (AstType.I64)
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (string.eq asm "    vmovdqu64 %zmm6, %zmm7{%k1}\n")]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-mask-load-temp-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%k1"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%k2"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%r12"))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-avx512-mask-load-temp-ok?) : bool
  (match (compiler-backend-emit-avx512-mask-load
    (compiler-backend-avx512-mask-load-temp-assignments)
    0
    (CompilerIrValue.Var 2)
    (CompilerIrValue.I64 0)
    (CompilerIrValue.Var 1)
    8
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          "    vmovdqu8 (%r12), %zmm6{%k2}{z}\n")
        (compiler-backend-string-contains?
          asm
          "    vpxord %zmm7, %zmm7, %zmm7\n")
        (compiler-backend-string-contains?
          asm
          "    vpcmpub $4, %zmm7, %zmm6, %k1\n")
        (not (compiler-backend-string-contains? asm "%zmm14"))
        (not (compiler-backend-string-contains? asm "%zmm15")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-mask-store-temp-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%k1"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%k2"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          2
          (CompilerRegLocation.Register "%r12"))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-avx512-mask-store-temp-ok?) : bool
  (match (compiler-backend-emit-avx512-mask-store
    (compiler-backend-avx512-mask-store-temp-assignments)
    (CompilerIrValue.Var 2)
    (CompilerIrValue.I64 0)
    (CompilerIrValue.Var 0)
    (CompilerIrValue.Var 1)
    8
    (compiler-diagnostic-at-start "" ""))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          "    vpxord %zmm6, %zmm6, %zmm6\n")
        (compiler-backend-string-contains? asm "    pushq $1\n")
        (compiler-backend-string-contains?
          asm
          "    vpbroadcastb (%rsp), %zmm7\n")
        (compiler-backend-string-contains? asm "    addq $8, %rsp\n")
        (compiler-backend-string-contains?
          asm
          "    vmovdqu8 %zmm7, %zmm6{%k1}\n")
        (compiler-backend-string-contains?
          asm
          "    vmovdqu8 %zmm6, (%r12){%k2}\n")
        (not (compiler-backend-string-contains? asm "%edx"))
        (not (compiler-backend-string-contains? asm "%zmm14"))
        (not (compiler-backend-string-contains? asm "%zmm15")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]
  [mask-move : String]
  [mask-shift : String]) : bool
  (match (lower-compiler-source-with-mode
    (compiler-backend-avx2-map-source elem)
    (CompilerLowerMode.Avx512))
    [(ResultCompilerLower.Ok program spans)
      (match (compiler-backend-emit-program-target-with-mode
        program
        (CompilerBackendTarget.Linux)
        (CompilerBackendMode.Avx512)
        spans
        true)
        [(ResultCompilerBackend.Ok asm)
          (and
            (backend-and8
              (compiler-backend-string-contains? asm move)
              (compiler-backend-string-contains? asm op)
              (compiler-backend-string-contains? asm "%zmm")
              (compiler-backend-string-contains? asm "%k")
              (compiler-backend-string-contains? asm "tail_mask_")
              (compiler-backend-string-contains? asm "}{z}")
