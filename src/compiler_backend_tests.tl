;; When a variable-index Gep and its constant-offset consumer share the same
;; register, the first Gep can still write that home directly. The second Gep's
;; load then folds to a displacement from the just-computed address.
(define (compiler-backend-chained-gep-same-home-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r13))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-rax))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-rax))
            (compiler_regalloc.compiler-reg-assignments-prepend
              (compiler_regalloc.CompilerRegAssignment
                3
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-rax))
              (compiler_regalloc.compiler-reg-assignments-prepend
                (compiler_regalloc.CompilerRegAssignment
                  4
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-rax))
                (compiler_regalloc.compiler-reg-assignment-table-empty))))))]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Gep
          2
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Gep
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Load
              4
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64))
            compiler_ir_types.CompilerIrInstrList.Nil)))]
    (match (compiler-backend-emit-test-instrs instrs assignments 5)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    leaq (%r13,%rax,1), %rax\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 8(%rax), %rax\n")
          (not
            (compiler_backend.compiler-backend-string-contains? asm "(%rbp)")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

;; GAP8: `Gep; Load(single-use, 8-byte); BinOp Add x v` folds the load into
;; the ALU memory operand: `addq (base,idx,8), dst` with no separate movq.
(define (compiler-backend-gep-load-alu-fold-shape-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r8))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              4
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-r14))
            (compiler_regalloc.compiler-reg-assignments-prepend
              (compiler_regalloc.CompilerRegAssignment
                5
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-r14))
              (compiler_regalloc.compiler-reg-assignment-table-empty)))))]
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Gep
          2
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Load
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.BinOp
              5
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Mov
                6
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ast_types.AstType.I64))
              compiler_ir_types.CompilerIrInstrList.Nil))))
      assignments
      7)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    addq (%r12,%r8,8), %r14\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq (%r12,%r8,8)"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

;; GAP8-B: the mirrored operand order. A COMMUTATIVE op whose LEFT operand is
;; the single-use fused load folds the same way -- `dst = MEM op x` is
;; `dst = x op MEM` -- so the memory operand still lands in the ALU's source
;; slot. `mem-on-lhs?` selects which side the load occupies; both must produce
;; the identical one-instruction shape.
(define (compiler-backend-gep-load-alu-commuted-asm
  [op : compiler_ir_types.CompilerIrBinOp]
  [mem-on-lhs? : bool]) : compiler_backend.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Gep
        2
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Load
          3
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.BinOp
            5
            op
            (if mem-on-lhs?
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ir_types.CompilerIrValue.Var 4))
            (if mem-on-lhs?
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.CompilerIrValue.Var 3))
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Mov
              6
              (compiler_ir_types.CompilerIrValue.Var 5)
              (compiler_ast_types.AstType.I64))
            compiler_ir_types.CompilerIrInstrList.Nil))))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        0
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r12))
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r8))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            4
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r14))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              5
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-r14))
            (compiler_regalloc.compiler-reg-assignment-table-empty)))))
    7))

(define (compiler-backend-gep-load-alu-commuted-shape-ok?
  [op : compiler_ir_types.CompilerIrBinOp]
  [mnem : String]
  [mem-on-lhs? : bool]) : bool
  (match (compiler-backend-gep-load-alu-commuted-asm op mem-on-lhs?)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          (str_cat.str-cat "    " mnem "q (%r12,%r8,8), %r14\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq (%r12,%r8,8)"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Sub is NOT commutative: `MEM - x` is not `x - MEM`, so the mirrored order
;; keeps the load and the register-form subtract.
(define (compiler-backend-gep-load-alu-commuted-rejects-sub-ok?) : bool
  (match (compiler-backend-gep-load-alu-commuted-asm
    (compiler_ir_types.CompilerIrBinOp.Sub)
    true)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq (%r12,%r8,8)")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    subq (%r12,%r8,8), %r14\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-gep-load-alu-commuted-shapes-ok?) : bool
  (and
    (compiler_backend.backend-and4
      (compiler-backend-gep-load-alu-commuted-shape-ok?
        (compiler_ir_types.CompilerIrBinOp.BitAnd)
        "and"
        true)
      (compiler-backend-gep-load-alu-commuted-shape-ok?
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        "or"
        true)
      (compiler-backend-gep-load-alu-commuted-shape-ok?
        (compiler_ir_types.CompilerIrBinOp.BitXor)
        "xor"
        true)
      (compiler-backend-gep-load-alu-commuted-shape-ok?
        (compiler_ir_types.CompilerIrBinOp.Add)
        "add"
        true))
    (compiler_backend.backend-and4
      (compiler-backend-gep-load-alu-commuted-shape-ok?
        (compiler_ir_types.CompilerIrBinOp.BitAnd)
        "and"
        false)
      (compiler-backend-gep-load-alu-commuted-shape-ok?
        (compiler_ir_types.CompilerIrBinOp.BitOr)
        "or"
        false)
      (compiler-backend-gep-load-alu-commuted-shape-ok?
        (compiler_ir_types.CompilerIrBinOp.BitXor)
        "xor"
        false)
      (compiler-backend-gep-load-alu-commuted-rejects-sub-ok?))))

;; GAP9: an offset add feeding only a same-block gep index folds into the
;; addressing displacement -- the add vanishes, the load reads
;; `disp(base,counter,scale)` -- exercised through the pre-pass plus the
;; fused load emission (ordinal consumption included).
(define (compiler-backend-gep-fold-test-blocks [second-use : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.compiler-ir-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Gep
            3
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Load
              4
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Mov
                5
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ast_types.AstType.I64))
              (if second-use
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.Mov
                    6
                    (compiler_ir_types.CompilerIrValue.Var 2)
                    (compiler_ast_types.AstType.I64))
                  compiler_ir_types.CompilerIrInstrList.Nil)
                compiler_ir_types.CompilerIrInstrList.Nil))))))
    compiler_ir_types.CompilerIrBlockList.Nil))

(define (compiler-backend-gep-fold-test-entry-instrs
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrInstrList
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Cons block _)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (compiler_ir_types.compiler-ir-instr-seq-to-list instrs)])]
    [_ compiler_ir_types.CompilerIrInstrList.Nil]))

(define (compiler-backend-gep-fold-test-assignments) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r12))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r8))
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          4
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r14))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            5
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r13))
          (compiler_regalloc.compiler-reg-assignment-table-empty))))))

(define (compiler-backend-gep-fold-disp-shape-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [folded : compiler_ir_types.CompilerIrBlockList
      (compiler_backend.compiler-backend-gep-fold-blocks
        (compiler_backend.compiler-backend-state-function-state backend-state)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        8
        (compiler-backend-gep-fold-test-blocks false))]
    [result : bool
      (if (not
        (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-ready
          backend-state))
        false
        (match (compiler-backend-emit-test-instrs-target-with-backend-state
          (compiler-backend-gep-fold-test-entry-instrs folded)
          (compiler-backend-gep-fold-test-assignments)
          8
          (compiler_backend.CompilerBackendTarget.Linux)
          backend-state)
          [(compiler_backend.ResultCompilerBackend.Ok asm)
            (and
              (compiler_backend.compiler-backend-string-contains?
                asm
                "8(%r12,%r8,8)")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  "addq $1"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  "leaq 1("))
              (not
                (compiler_backend.compiler-backend-gep-fold-drift?
                  (compiler_backend.compiler-backend-state-function-state
                    backend-state))))]
          [(compiler_backend.ResultCompilerBackend.Err _) false]))]
    (begin
      (compiler_backend.compiler-backend-gep-fold-disable!
        (compiler_backend.compiler-backend-state-function-state backend-state))
      result)))

;; A second (non-gep) use of the offset var keeps the add and the plain
;; zero-displacement addressing.
(define (compiler-backend-gep-fold-multi-use-keeps-add-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [folded : compiler_ir_types.CompilerIrBlockList
      (compiler_backend.compiler-backend-gep-fold-blocks
        (compiler_backend.compiler-backend-state-function-state backend-state)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        8
        (compiler-backend-gep-fold-test-blocks true))]
    [result : bool
      (if (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-ready
        backend-state)
        false
        (match (compiler-backend-emit-test-instrs-target-with-backend-state
          (compiler-backend-gep-fold-test-entry-instrs folded)
          (compiler-backend-gep-fold-test-assignments)
          8
          (compiler_backend.CompilerBackendTarget.Linux)
          backend-state)
          [(compiler_backend.ResultCompilerBackend.Ok asm)
            (and
              (compiler_backend.compiler-backend-string-contains? asm "(%r12,")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  "8(%r12,")))]
          [(compiler_backend.ResultCompilerBackend.Err _) false]))]
    (begin
      (compiler_backend.compiler-backend-gep-fold-disable!
        (compiler_backend.compiler-backend-state-function-state backend-state))
      result)))

;; The disp-aware address builders.
(define (compiler-backend-gep-fold-builders-ok?) : bool
  (and
    (string.eq
      (compiler_backend.compiler-backend-gep-index-address-disp
        8
        "%rax"
        8
        "%rcx")
      "8(%rax,%rcx,8)")
    (string.eq
      (compiler_backend.compiler-backend-gep-index-address-disp
        0
        "%rax"
        8
        "%rcx")
      "(%rax,%rcx,8)")
    (string.eq
      (compiler_backend.compiler-backend-gep-index-address-disp
        8
        "%rax"
        32
        "%rcx")
      "")
    (compiler_backend.compiler-backend-string-contains?
      (compiler_backend.compiler-backend-gep-index-base-asm-disp
        24
        "%rax"
        32
        "%rcx")
      "    addq $24, %rax\n")))

;; Consuming an ordinal with the wrong shape poisons the function (the
;; emit-function gate turns this into a hard backend error).
(define (compiler-backend-gep-fold-drift-detected-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_folded : compiler_ir_types.CompilerIrBlockList
      (compiler_backend.compiler-backend-gep-fold-blocks
        (compiler_backend.compiler-backend-state-function-state backend-state)
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        8
        (compiler-backend-gep-fold-test-blocks false))]
    [result : bool
      (if (not
        (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-ready
          backend-state))
        false
        (begin
          ;; wrong scale: recorded scale is 8 (i64), consume with u8.
          (compiler_backend.compiler-backend-gep-fold-next!
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.U8))
          (compiler_backend.compiler-backend-gep-fold-drift?
            (compiler_backend.compiler-backend-state-function-state
              backend-state))))]
    (begin
      (compiler_backend.compiler-backend-gep-fold-disable!
        (compiler_backend.compiler-backend-state-function-state backend-state))
      result)))

;; A narrow (u8) load must NOT fold: the memory operand width would not match
;; the 64-bit ALU op. The fused movzbq load stays.
(define (compiler-backend-gep-load-alu-fold-rejects-narrow-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r8))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              3
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-rcx))
            (compiler_regalloc.compiler-reg-assignments-prepend
              (compiler_regalloc.CompilerRegAssignment
                4
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-r14))
              (compiler_regalloc.compiler-reg-assignments-prepend
                (compiler_regalloc.CompilerRegAssignment
                  5
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-r14))
                (compiler_regalloc.compiler-reg-assignment-table-empty))))))]
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Gep
          2
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Load
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.BinOp
              5
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Mov
                6
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ast_types.AstType.I64))
              compiler_ir_types.CompilerIrInstrList.Nil))))
      assignments
      7)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movzbq (%r12,%r8,1), %rcx\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    addq (%r12")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

;; M6: folding a single-use load into the comparing instruction's memory
;; operand. Shared homes for the fixtures below: base %r12, gep index %r8, the
;; loaded value %r13, the compare's other operand %r14, a width-preserving cast
;; of that other operand %r14 again (so the cast is a self-move the walk may
;; step over), the widening cast result %r9 and the compare result %r15.
(define (compiler-backend-cmp-mem-fold-assignments) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r12))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r8))
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          3
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r13))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            4
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r14))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              5
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-r15))
            (compiler_regalloc.compiler-reg-assignments-prepend
              (compiler_regalloc.CompilerRegAssignment
                6
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-r9))
              (compiler_regalloc.compiler-reg-assignments-prepend
                (compiler_regalloc.CompilerRegAssignment
                  7
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-r14))
                (compiler_regalloc.compiler-reg-assignment-table-empty)))))))))

;; `gep(elem, base + index) ; load ; cast to i64 ; compare with a literal ;
;; branch` -- the M6-C narrow shape.
(define (compiler-backend-cmp-mem-narrow-asm
  [elem-ty : compiler_ast_types.AstType]
  [load-ty : compiler_ast_types.AstType]
  [op : compiler_ir_types.CompilerIrBinOp]
  [literal : i64]) : compiler_backend.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Gep
        2
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        elem-ty)
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Load
          3
          (compiler_ir_types.CompilerIrValue.Var 2)
          load-ty)
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Cast
            6
            (compiler_ir_types.CompilerIrValue.Var 3)
            load-ty
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.BinOp
              5
              op
              (compiler_ir_types.CompilerIrValue.Var 6)
              (compiler_ir_types.CompilerIrValue.I64 literal)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Branch
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ir_types.compiler-ir-label "hit")
                (compiler_ir_types.compiler-ir-label "miss"))
              compiler_ir_types.CompilerIrInstrList.Nil)))))
    (compiler-backend-cmp-mem-fold-assignments)
    8))

;; A zero-extending byte load whose literal is inside `0 .. 255` folds to a
;; BYTE compare: `movzbq (mem), %r ; cmpq $10, %r` becomes `cmpb $10, (mem)`.
(define (compiler-backend-cmp-mem-byte-fold-shape-ok?) : bool
  (match (compiler-backend-cmp-mem-narrow-asm
    (compiler_ast_types.AstType.U8)
    (compiler_ast_types.AstType.U8)
    (compiler_ir_types.CompilerIrBinOp.Eq)
    10)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpb $10, (%r12,%r8,1)\n")
        (not
          (compiler_backend.compiler-backend-string-contains? asm "    movzbq ")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; The same at WORD width, and with a literal above the byte range so the width
;; is load-bearing rather than incidental.
(define (compiler-backend-cmp-mem-word-fold-shape-ok?) : bool
  (match (compiler-backend-cmp-mem-narrow-asm
    (compiler_ast_types.AstType.U16)
    (compiler_ast_types.AstType.U16)
    (compiler_ir_types.CompilerIrBinOp.Eq)
    300)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpw $300, (%r12,%r8,2)\n")
        (not
          (compiler_backend.compiler-backend-string-contains? asm "    movzwq ")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Signedness/width refusal: a SIGN-extending byte load cannot produce 200, so
;; `ext(mem) == 200` is constant-false while `cmpb $200, (mem)` would be true
;; for the byte 0xC8. The fold declines and the widening load stays.
(define (compiler-backend-cmp-mem-narrow-rejects-signed-literal-ok?) : bool
  (match (compiler-backend-cmp-mem-narrow-asm
    (compiler_ast_types.AstType.I8)
    (compiler_ast_types.AstType.I8)
    (compiler_ir_types.CompilerIrBinOp.Eq)
    200)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        ;; The narrow compare fold is refused, so the load survives -- and M6-G
        ;; then claims the pair the refusal leaves behind, giving the load the
        ;; WIDENING CAST's home (%r9) instead of the loaded value's own (%r13)
        ;; and retiring the separate re-extension. Both halves are asserted.
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movsbq (%r12,%r8,1), %r9\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movsbq %r13b, "))
        (not
          (compiler_backend.compiler-backend-string-contains? asm "    cmpb ")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Ordered narrow comparisons are refused outright: a zero-extended byte
;; compared with `jl` at 64 bits is a comparison of a non-negative value, which
;; an 8-bit SIGNED compare does not reproduce.
(define (compiler-backend-cmp-mem-narrow-rejects-ordered-ok?) : bool
  (match (compiler-backend-cmp-mem-narrow-asm
    (compiler_ast_types.AstType.U8)
    (compiler_ast_types.AstType.U8)
    (compiler_ir_types.CompilerIrBinOp.Lt)
    10)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        ;; Same division of labour as the signed-literal refusal above: M6-C
        ;; declines the ordered narrow compare, M6-G folds the re-extension the
        ;; refusal leaves behind, so the surviving load writes the widening
        ;; cast's home %r9 and no `movzbq %r13b, %r9` follows it.
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movzbq (%r12,%r8,1), %r9\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movzbq %r13b, "))
        (not
          (compiler_backend.compiler-backend-string-contains? asm "    cmpb ")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; M6-A: `gep(i64, base + 1) ; load ; bounds_check(index, load)`. `tail` lets a
;; fixture add a SECOND use of the loaded value behind the check.
(define (compiler-backend-cmp-mem-bounds-asm
  [tail : compiler_ir_types.CompilerIrInstrList]) : compiler_backend.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Gep
        2
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Load
          3
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.BoundsCheck
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ir_types.CompilerIrValue.Var 3)
            (compiler_ir_types.compiler-ir-label "ok"))
          tail)))
    (compiler-backend-cmp-mem-fold-assignments)
    8))

(define (compiler-backend-cmp-mem-bounds-fold-shape-ok?) : bool
  (match (compiler-backend-cmp-mem-bounds-asm
    compiler_ir_types.CompilerIrInstrList.Nil)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq 8(%r12), %r14\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 8(%r12)")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; A second use of the loaded length keeps the load: the home register is read
;; again, so it must actually be written.
(define (compiler-backend-cmp-mem-bounds-second-use-refused-ok?) : bool
  (match (compiler-backend-cmp-mem-bounds-asm
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Mov
        7
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ast_types.AstType.I64))
      compiler_ir_types.CompilerIrInstrList.Nil))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq 8(%r12), %r13\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpq 8(%r12)")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; The `(& str)` spelling puts two width-preserving casts between the `.len`
;; load and its bounds check (`i64 -> u64` for the length and for the index).
;; Both emit nothing -- the index cast's operands share a home -- so the walk
;; steps over them and the fold still fires.
(define (compiler-backend-cmp-mem-bounds-cast-fold-ok?) : bool
  (match (compiler-backend-emit-test-instrs
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Gep
        2
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Load
          3
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Cast
            7
            (compiler_ir_types.CompilerIrValue.Var 4)
            (compiler_ast_types.AstType.I64)
            (compiler_ast_types.AstType.U64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Cast
              6
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64)
              (compiler_ast_types.AstType.U64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.BoundsCheck
                (compiler_ir_types.CompilerIrValue.Var 7)
                (compiler_ir_types.CompilerIrValue.Var 6)
                (compiler_ir_types.compiler-ir-label "ok"))
              compiler_ir_types.CompilerIrInstrList.Nil)))))
    (compiler-backend-cmp-mem-fold-assignments)
    8)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq 8(%r12), %r14\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 8(%r12)")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; M6-B tail: `compare ; branch`. `mem-on-rhs?` puts the loaded value on the
;; compare's RIGHT so the address takes the AT&T SOURCE slot instead of the
;; destination one.
(define (compiler-backend-cmp-mem-wide-tail [mem-on-rhs? : bool]) : compiler_ir_types.CompilerIrInstrList
  (compiler_ir_types.compiler-ir-instr-cons
    (compiler_ir_types.CompilerIrInstr.BinOp
      5
      (compiler_ir_types.CompilerIrBinOp.Lt)
      (if mem-on-rhs?
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.Var 3))
      (if mem-on-rhs?
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.Var 4))
      (compiler_ast_types.AstType.I64))
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Branch
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ir_types.compiler-ir-label "lt")
        (compiler_ir_types.compiler-ir-label "ge"))
      compiler_ir_types.CompilerIrInstrList.Nil)))

;; `gep(i64, base + index) ; load ; <rest>`, where `rest` is a wide tail with
;; any refusal instruction the fixture wants in front of it.
(define (compiler-backend-cmp-mem-wide-asm
  [rest : compiler_ir_types.CompilerIrInstrList]) : compiler_backend.ResultCompilerBackend
  (compiler-backend-cmp-mem-wide-asm-with
    rest
    (compiler-backend-cmp-mem-fold-assignments)))

(define (compiler-backend-cmp-mem-wide-asm-with
  [rest : compiler_ir_types.CompilerIrInstrList]
  [assignments : compiler_regalloc.CompilerRegAssignmentTable]) : compiler_backend.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Gep
        2
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Load
          3
          (compiler_ir_types.CompilerIrValue.Var 2)
          (compiler_ast_types.AstType.I64))
        rest))
    assignments
    8))

;; M6-D fixtures: the same shape with one address component SPILLED. Everything
;; else keeps the shared homes, so the fold's staging register is the load
;; destination's own home %r13.
(define (compiler-backend-cmp-mem-staged-assignments
  [base-spilled? : bool]
  [index-spilled? : bool]) : compiler_regalloc.CompilerRegAssignmentTable
  (compiler_regalloc.compiler-reg-assignments-prepend
    (compiler_regalloc.CompilerRegAssignment
      0
      (if base-spilled?
        (compiler_regalloc.CompilerRegLocation.Spill 16)
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r12)))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        1
        (if index-spilled?
          (compiler_regalloc.CompilerRegLocation.Spill 24)
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r8)))
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          3
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r13))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            4
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r14))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              5
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-r15))
            (compiler_regalloc.compiler-reg-assignment-table-empty)))))))

;; A spilled BASE stages into the load destination's home and the compare reads
;; `(%r13,%r8,8)` -- two instructions where the unfolded path emitted three.
(define (compiler-backend-cmp-mem-staged-base-fold-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm-with
    (compiler-backend-cmp-mem-wide-tail false)
    (compiler-backend-cmp-mem-staged-assignments true false))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq %r14, (%r13,%r8,8)\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq (%r13,%r8,8)"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; The mirror: a spilled INDEX stages into the same home and the register-homed
;; base keeps the SIB base slot.
(define (compiler-backend-cmp-mem-staged-index-fold-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm-with
    (compiler-backend-cmp-mem-wide-tail false)
    (compiler-backend-cmp-mem-staged-assignments false true))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq %r14, (%r12,%r13,8)\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq (%r12,%r13,8)"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Both components spilled would need two staging registers; the fold owns one,
;; so it declines and the ordinary load path emits the compare's operand.
(define (compiler-backend-cmp-mem-staged-both-refused-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm-with
    (compiler-backend-cmp-mem-wide-tail false)
    (compiler-backend-cmp-mem-staged-assignments true true))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq %r14, %r13\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpq %r14, (")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; A SECOND use of the loaded value keeps it in its home: the fold would drop
;; the only definition the later use reads.
(define (compiler-backend-cmp-mem-staged-second-use-refused-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm-with
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.BinOp
        5
        (compiler_ir_types.CompilerIrBinOp.Lt)
        (compiler_ir_types.CompilerIrValue.Var 3)
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Mov
          6
          (compiler_ir_types.CompilerIrValue.Var 3)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Branch
            (compiler_ir_types.CompilerIrValue.Var 5)
            (compiler_ir_types.compiler-ir-label "lt")
            (compiler_ir_types.compiler-ir-label "ge"))
          compiler_ir_types.CompilerIrInstrList.Nil)))
    (compiler-backend-cmp-mem-staged-assignments true false))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (not
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq %r14, (%r13,%r8,8)\n"))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-cmp-mem-wide-rhs-fold-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm
    (compiler-backend-cmp-mem-wide-tail true))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq (%r12,%r8,8), %r14\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq (%r12,%r8,8)")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; A memory write between the load and the compare stops the walk: the folded
;; operand would be read after the store instead of before it.
(define (compiler-backend-cmp-mem-store-between-refused-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.StorePtr
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 7)
        (compiler_ast_types.AstType.I64))
      (compiler-backend-cmp-mem-wide-tail false)))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq (%r12,%r8,8), %r13\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpq (%r12,%r8,8)")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; So does a flag writer: the compare must be the instruction that sets the
;; flags the branch reads.
(define (compiler-backend-cmp-mem-flags-between-refused-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.BinOp
        6
        (compiler_ir_types.CompilerIrBinOp.Sub)
        (compiler_ir_types.CompilerIrValue.Var 4)
        (compiler_ir_types.CompilerIrValue.I64 1)
        (compiler_ast_types.AstType.I64))
      (compiler-backend-cmp-mem-wide-tail false)))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq (%r12,%r8,8), %r13\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    cmpq (%r12,%r8,8)")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; M6-F: a SPILLED compare operand on the side that takes the AT&T SOURCE slot
;; is a legal memory operand as long as the other side is a register, so the
;; reload the staging path emitted is dropped. Var 4 (the compare's other
;; operand) is spilled here; var 3, the loaded value, keeps its register home
;; and occupies the destination slot.
(define (compiler-backend-cmp-mem-spilled-rhs-fold-ok?) : bool
  (match (compiler-backend-cmp-mem-wide-asm-with
    (compiler-backend-cmp-mem-wide-tail false)
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        0
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r12))
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r8))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            3
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r13))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              4
              (compiler_regalloc.CompilerRegLocation.Spill 32))
            (compiler_regalloc.compiler-reg-assignments-prepend
              (compiler_regalloc.CompilerRegAssignment
                5
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-r15))
              (compiler_regalloc.compiler-reg-assignment-table-empty)))))))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      ;; The loaded value keeps its register home (the memory-operand compare
      ;; cannot take BOTH sides), and the spilled other operand is spelled
      ;; straight into the compare's source slot instead of being reloaded --
      ;; exactly one memory operand, which is all x86 allows.
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq (%r12,%r8,8), %r13\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    cmpq 32(%rbp), %r13\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            (compiler-backend-todo-marker))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-cmp-mem-fold-shapes-ok?) : bool
  (and
    (compiler_backend.backend-and4
      (compiler-backend-cmp-mem-byte-fold-shape-ok?)
      (compiler-backend-cmp-mem-word-fold-shape-ok?)
      (compiler-backend-cmp-mem-narrow-rejects-signed-literal-ok?)
      (compiler-backend-cmp-mem-narrow-rejects-ordered-ok?))
    (compiler_backend.backend-and4
      (compiler-backend-cmp-mem-bounds-fold-shape-ok?)
      (compiler-backend-cmp-mem-bounds-cast-fold-ok?)
      (compiler-backend-cmp-mem-bounds-second-use-refused-ok?)
      (compiler-backend-cmp-mem-wide-rhs-fold-ok?))
    (compiler_backend.backend-and4
      (compiler-backend-cmp-mem-staged-base-fold-ok?)
      (compiler-backend-cmp-mem-staged-index-fold-ok?)
      (compiler-backend-cmp-mem-staged-both-refused-ok?)
      (compiler-backend-cmp-mem-staged-second-use-refused-ok?))
    (compiler-backend-cmp-mem-spilled-rhs-fold-ok?)
    (compiler-backend-gep-load-alu-commuted-shapes-ok?)
    (compiler-backend-cmp-mem-store-between-refused-ok?)
    (compiler-backend-cmp-mem-flags-between-refused-ok?)))

;; GAP8: three-operand constant multiply strength reduction shapes.
(define (compiler-backend-mul-pow2-test-asm [factor : i64] [dst-reg : i64]) : compiler_backend.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.BinOp
        1
        (compiler_ir_types.CompilerIrBinOp.Mul)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 factor)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        compiler_ir_types.CompilerIrInstrList.Nil))
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        0
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r12))
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register dst-reg))
        (compiler_regalloc.compiler-reg-assignment-table-empty)))
    3))

(define (compiler-backend-mul-pow2-lea-shape-ok?) : bool
  (match (compiler-backend-mul-pow2-test-asm 8 compiler_abi.compiler-reg-id-rcx)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    leaq (,%r12,8), %rcx\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "imulq")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-mul-pow2-shl-shape-ok?) : bool
  (match (compiler-backend-mul-pow2-test-asm
    32
    compiler_abi.compiler-reg-id-r12)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    shlq $5, %r12\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "imulq")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-mul-non-pow2-imul-shape-ok?) : bool
  (match (compiler-backend-mul-pow2-test-asm
    24
    compiler_abi.compiler-reg-id-rcx)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.compiler-backend-string-contains?
        asm
        "    imulq $24, %r12, %rcx\n")]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-full-syscall-instr) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Syscall
    0
    (compiler_ir_types.compiler-ir-call-args-from-list
      (compiler_ir_types.compiler-ir-value-cons
        (compiler_ir_types.CompilerIrValue.I64 231)
        (compiler_ir_types.compiler-ir-value-cons
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ir_types.compiler-ir-value-cons
            (compiler_ir_types.CompilerIrValue.I64 2)
            (compiler_ir_types.compiler-ir-value-cons
              (compiler_ir_types.CompilerIrValue.I64 3)
              (compiler_ir_types.compiler-ir-value-cons
                (compiler_ir_types.CompilerIrValue.I64 4)
                (compiler_ir_types.compiler-ir-value-cons
                  (compiler_ir_types.CompilerIrValue.I64 5)
                  (compiler_ir_types.compiler-ir-value-cons
                    (compiler_ir_types.CompilerIrValue.I64 6)
                    compiler_ir_types.CompilerIrValueList.Nil))))))))))

(define (compiler-backend-full-syscall-registers-ok?) : bool
  (let
    [instr : compiler_ir_types.CompilerIrInstr
      (compiler-backend-full-syscall-instr)]
    (and
      (compiler_backend.backend-and8
        (compiler-backend-instr-contains? instr "    movl $231, %eax\n")
        (compiler-backend-instr-contains? instr "    movl $1, %edi\n")
        (compiler-backend-instr-contains? instr "    movl $2, %esi\n")
        (compiler-backend-instr-contains? instr "    movl $3, %edx\n")
        (compiler-backend-instr-contains? instr "    movl $4, %r10d\n")
        (compiler-backend-instr-contains? instr "    movl $5, %r8d\n")
        (compiler-backend-instr-contains? instr "    movl $6, %r9d\n")
        (compiler-backend-instr-contains? instr "    syscall\n"))
      (not (compiler-backend-instr-contains? instr "    pushq %rax\n"))
      (not (compiler-backend-instr-contains? instr "    popq ")))))

(define (compiler-backend-entry-load-register-homes-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r13))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-r14))
            (compiler_regalloc.compiler-reg-assignment-table-empty))))]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.EntryArgc 0)
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.EntryArgv 1)
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.EntryEnvp 2)
            compiler_ir_types.CompilerIrInstrList.Nil)))]
    (match (compiler-backend-emit-test-instrs instrs assignments 3)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.backend-and4
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_argc(%rip), %r12\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_argv(%rip), %r13\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_envp(%rip), %r14\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %rax\n")))
          (compiler_backend.backend-and4
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argv(%rip), %rax\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_envp(%rip), %rax\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq %rax, %r12\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq %rax, %r13\n")))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %rax, %r14\n")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-entry-load-fallbacks-ok?) : bool
  (let
    [spill-assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Spill -16))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [pair-assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.RegisterPair
            compiler_abi.compiler-reg-id-r12
            compiler_abi.compiler-reg-id-r13))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [r11-occupied-assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Spill -16))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r11))
          (compiler_regalloc.compiler-reg-assignment-table-empty)))]
    [no-location-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.EntryArgc 0)
          compiler_ir_types.CompilerIrInstrList.Nil)
        (compiler_regalloc.compiler-reg-assignment-table-empty)
        1)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_argc(%rip), %r11\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %r11, -8(%rbp)\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [spill-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.EntryArgv 0)
          compiler_ir_types.CompilerIrInstrList.Nil)
        spill-assignments
        1)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_argv(%rip), %r11\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %r11, -16(%rbp)\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argv(%rip), %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [pair-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.EntryEnvp 0)
          compiler_ir_types.CompilerIrInstrList.Nil)
        pair-assignments
        1)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_envp(%rip), %r11\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %r11, %r12\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_envp(%rip), %r12\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_envp(%rip), %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [r11-occupied-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.EntryArgc 0)
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1)))
            compiler_ir_types.CompilerIrInstrList.Nil))
        r11-occupied-assignments
        2)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_argc(%rip), %r9\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %r9, -16(%rbp)\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %r11\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    (and no-location-ok? spill-ok? pair-ok? r11-occupied-ok?)))

(define (compiler-backend-cpuid-eax-direct-ok?) : bool
  (let
    [instr : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.CpuId
        0
        (compiler_ir_types.CompilerIrValue.I64 7)
        (compiler_ir_types.CompilerIrValue.I64 0)
        0)]
    (compiler_backend.backend-and8
      (compiler-backend-instr-contains? instr "    xorl %ecx, %ecx\n")
      (compiler-backend-instr-contains? instr "    movl $7, %eax\n")
      ;; cpuid clobbers %rbx; the campaign preserves the caller's %rbx in a
      ;; modeled free reg instead of pushq/popq %rbx (the no-stack-staging goal).
      (compiler-backend-instr-contains?
        instr
        (cfg scratch-vreg "    movq %rbx, %rsi\n" "    movq %rbx, %r8\n"))
      (compiler-backend-instr-contains? instr "    cpuid\n")
      (compiler-backend-instr-contains?
        instr
        (cfg scratch-vreg "    movq %rsi, %rbx\n" "    movq %r8, %rbx\n"))
      (not (compiler-backend-instr-contains? instr "    movl %eax, %eax\n"))
      (not (compiler-backend-instr-contains? instr "    movl %r11d, %ecx\n"))
      (not (compiler-backend-instr-contains? instr "%r11")))))

(define (compiler-backend-cpuid-direct-subleaf-ok?) : bool
  (let
    [instr : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.CpuId
        0
        (compiler_ir_types.CompilerIrValue.I64 7)
        (compiler_ir_types.CompilerIrValue.I64 3)
        0)]
    (compiler_backend.backend-and4
      (compiler-backend-instr-contains? instr "    movl $3, %ecx\n")
      (compiler-backend-instr-contains? instr "    movl $7, %eax\n")
      (not (compiler-backend-instr-contains? instr "    movl %r11d, %ecx\n"))
      (not (compiler-backend-instr-contains? instr "%r11")))))

(define (compiler-backend-xgetbv-zero-index-ok?) : bool
  (let
    [instr : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Xgetbv
        0
        (compiler_ir_types.CompilerIrValue.I64 0))]
    (compiler_backend.backend-and4
      (compiler-backend-instr-contains? instr "    xorl %ecx, %ecx\n")
      (compiler-backend-instr-contains? instr "    xgetbv\n")
      (compiler-backend-instr-contains? instr "    orq %rdx, %rax\n")
      true)))

(define (compiler-backend-low-level-instr-ok?) : bool
  (and
    (compiler_backend.backend-and8
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.EntryArgc 0)
        ".L_tl_argc(%rip)")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.EntryArgv 0)
        ".L_tl_argv(%rip)")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.EntryEnvp 0)
        ".L_tl_envp(%rip)")
      (compiler-backend-cpuid-eax-direct-ok?)
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.CpuId
          0
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 0)
          1)
        "    movl %ebx, %eax\n")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.CpuId
          0
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 0)
          2)
        "    movl %ecx, %eax\n")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.CpuId
          0
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 0)
          3)
        "    movl %edx, %eax\n")
      (compiler-backend-xgetbv-zero-index-ok?))
    (compiler-backend-cpuid-direct-subleaf-ok?)
    (compiler_backend.backend-and8
      ;; A one-operand syscall loads the number into %rax and issues `syscall`.
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.Syscall
          0
          (compiler_ir_types.CompilerIrCallArgs.One
            (compiler_ir_types.CompilerIrValue.I64 231)))
        "    movl $231, %eax\n")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.Syscall
          0
          (compiler_ir_types.CompilerIrCallArgs.One
            (compiler_ir_types.CompilerIrValue.I64 231)))
        "    syscall\n")
      (not
        (compiler-backend-instr-contains?
          (compiler_ir_types.CompilerIrInstr.Syscall
            0
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.I64 231)))
          "    pushq %rax\n"))
      (not
        (compiler-backend-instr-contains?
          (compiler_ir_types.CompilerIrInstr.Syscall
            0
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.I64 231)))
          "    popq "))
      ;; A two-operand syscall additionally loads argument 0 into %rdi.
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.Syscall
          0
          (compiler_ir_types.CompilerIrCallArgs.Two
            (compiler_ir_types.CompilerIrValue.I64 231)
            (compiler_ir_types.CompilerIrValue.I64 42)))
        "    movl $42, %edi\n")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.Syscall
          0
          (compiler_ir_types.CompilerIrCallArgs.Two
            (compiler_ir_types.CompilerIrValue.I64 231)
            (compiler_ir_types.CompilerIrValue.I64 42)))
        "    movl $231, %eax\n")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.Syscall
          0
          (compiler_ir_types.CompilerIrCallArgs.Two
            (compiler_ir_types.CompilerIrValue.I64 231)
            (compiler_ir_types.CompilerIrValue.I64 0)))
        "    xorl %edi, %edi\n")
      (compiler-backend-full-syscall-registers-ok?))
    (compiler-backend-entry-load-register-homes-ok?)
    (compiler-backend-entry-load-fallbacks-ok?)))

(define (compiler-backend-numeric-cast-shape-ok?) : bool
  (compiler_backend.backend-and8
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.I64)
        (compiler_ast_types.AstType.F64))
      (cfg
        scratch-vreg
        "    cvtsi2sdq %rax, %xmm0\n"
        "    cvtsi2sdq %r8, %xmm2\n"))
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.I64)
        (compiler_ast_types.AstType.F32))
      (cfg
        scratch-vreg
        "    cvtsi2ssq %rax, %xmm0\n"
        "    cvtsi2ssq %r8, %xmm2\n"))
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.U8)
        (compiler_ast_types.AstType.F64))
      (cfg
        scratch-vreg
        "    cvtsi2sdq %rax, %xmm0\n"
        "    cvtsi2sdq %r8, %xmm2\n"))
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.U64)
        (compiler_ast_types.AstType.F64))
      "    js .L_tl_test_cast_u64_float_entry_v6_high\n")
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.U64)
        (compiler_ast_types.AstType.F32))
      (cfg scratch-vreg "    addss %xmm0, %xmm0\n" "    addss %xmm2, %xmm2\n"))
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.F64)
        (compiler_ast_types.AstType.I64))
      (cfg
        scratch-vreg
        "    cvttsd2siq %xmm0, %rax\n"
        "    cvttsd2siq %xmm2, %r8\n"))
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.F64)
        (compiler_ast_types.AstType.F32))
      (cfg
        scratch-vreg
        "    cvtsd2ss %xmm0, %xmm0\n"
        "    cvtsd2ss %xmm2, %xmm2\n"))
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.F32)
        (compiler_ast_types.AstType.F64))
      (cfg
        scratch-vreg
        "    cvtss2sd %xmm0, %xmm0\n"
        "    cvtss2sd %xmm2, %xmm2\n"))))

(define (compiler-backend-direct-float-precision-cast-asm
  [from-ty : compiler_ast_types.AstType]
  [to-ty : compiler_ast_types.AstType]) : compiler_backend.ResultCompilerBackend
  (compiler_backend.compiler-backend-emit-cast
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    "test_cast"
    (compiler_ir_types.compiler-ir-label "entry")
    (compiler_regalloc.compiler-reg-assignments-prepend
      (compiler_regalloc.CompilerRegAssignment
        0
        (compiler_regalloc.CompilerRegLocation.Register
          (compiler_abi.compiler-abi-xmm-register-id 2)))
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register
            (compiler_abi.compiler-abi-xmm-register-id 3)))
        (compiler_regalloc.compiler-reg-assignment-table-empty)))
    1
    (compiler_ir_types.CompilerIrValue.Var 0)
    from-ty
    to-ty
    (compiler_backend.compiler-backend-program-index-build
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      compiler_ir_types.CompilerIrFunctionList.Nil
      compiler_ir_types.CompilerIrExternList.Nil)
    ""
    ""
    ""
    (compiler_backend.compiler-backend-state-new
      (ci.intern-compat-state-capture-active))))

(define (compiler-backend-direct-float-precision-cast-home-ok?) : bool
  (match (compiler-backend-direct-float-precision-cast-asm
    (compiler_ast_types.AstType.F64)
    (compiler_ast_types.AstType.F32))
    [(compiler_backend.ResultCompilerBackend.Ok narrow-asm)
      (match (compiler-backend-direct-float-precision-cast-asm
        (compiler_ast_types.AstType.F32)
        (compiler_ast_types.AstType.F64))
        [(compiler_backend.ResultCompilerBackend.Ok widen-asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              narrow-asm
              "    movsd %xmm2, %xmm3\n")
            (compiler_backend.compiler-backend-string-contains?
              narrow-asm
              "    cvtsd2ss %xmm3, %xmm3\n")
            (compiler_backend.compiler-backend-string-contains?
              widen-asm
              "    movss %xmm2, %xmm3\n")
            (compiler_backend.compiler-backend-string-contains?
              widen-asm
              "    cvtss2sd %xmm3, %xmm3\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                narrow-asm
                "%xmm0"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                widen-asm
                "%xmm0")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

