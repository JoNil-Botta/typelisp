        (irt.instr "%1 = mov 1 : i64")
        instrs))
    (set!
      instrs
      (compiler-backend-test-instr-seq-prepend
        (irt.instr "%0 = mov 0 : i64")
        instrs))
    instrs))

(define (compiler-backend-call-save-program) : ir.CompilerIrProgram
  (Program
    (compiler-backend-call-save-test-globals)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (ci.intern "side_effect")
          (ir.compiler-ir-param-seq-empty)
          (Unit)
          0
          (ir.compiler-ir-blocks
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "entry")
              (compiler-backend-test-instr-seq-prepend
                (Return No)
                (ir.compiler-ir-instr-seq-empty))))
          Ordinary))
      (&
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              (ci.intern "main")
              (ir.compiler-ir-param-seq-empty)
              (I64)
              8
              (ir.compiler-ir-blocks
                (ir.CompilerIrBlock.Block
                  (ir.compiler-ir-label "entry")
                  (compiler-backend-call-save-main-instrs)))
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-call-save-r9-wrap-ok?) : bool
  (let
    ;; Construct the fixture (and intern every symbol it uses) before taking
    ;; the two exact job capabilities.  The A/B/A/B sequence below must not
    ;; rely on the active compatibility table or a process-global option.
    [program : ir.CompilerIrProgram (compiler-backend-call-save-program)]
    [intern-state : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [state-a : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-state))]
    [state-b : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [_set-a : unit
      (be_state.compiler-backend-state-set-scalar-registers-enabled!
        state-a
        true)]
    [_set-b : unit
      (be_state.compiler-backend-state-set-scalar-registers-enabled!
        state-b
        false)]
    [spans : ir.CompilerSourceSpans (ir.compiler-source-spans-empty)]
    [a1-result : be_state.ResultCompilerBackend
      (compiler-backend-test-emit-program-with-state
        state-a
        (be_state.CompilerBackendTarget.Linux)
        program
        spans
        true)]
    [b1-result : be_state.ResultCompilerBackend
      (compiler-backend-test-emit-program-with-state
        state-b
        (be_state.CompilerBackendTarget.Linux)
        program
        spans
        true)]
    [a2-result : be_state.ResultCompilerBackend
      (compiler-backend-test-emit-program-with-state
        state-a
        (be_state.CompilerBackendTarget.Linux)
        program
        spans
        true)]
    [b2-result : be_state.ResultCompilerBackend
      (compiler-backend-test-emit-program-with-state
        state-b
        (be_state.CompilerBackendTarget.Linux)
        program
        spans
        true)]
    [a1 : String
      (match (owned_view.compiler-owned-shared-view a1-result)
        [(Ok asm) asm]
        [(Err _) ""])]
    [b1 : String
      (match (owned_view.compiler-owned-shared-view b1-result)
        [(Ok asm) asm]
        [(Err _) ""])]
    [a2 : String
      (match (owned_view.compiler-owned-shared-view a2-result)
        [(Ok asm) asm]
        [(Err _) ""])]
    [b2 : String
      (match (owned_view.compiler-owned-shared-view b2-result)
        [(Ok asm) asm]
        [(Err _) ""])]
    [a-shape-ok : bool
      (and
        (asm-has? a1 "    call _tl_side_effect\n")
        ;; The unified greedy keeps the call-spanning value in a callee-saved
        ;; register and rematerialises the cold immediates after the call, so
        ;; there should be no caller-saved %r9 save/restore wrapper around it.
        (asm-lacks? a1 "    movq %r9, %rax\n    movq %rax, -")
        (asm-lacks? a1 "(%rbp), %r9\n")
        (asm-has? a1 "    movq %r12, _tl_g5(%rip)\n")
        (asm-has? a1 "    movq %r12, _tl_g5b(%rip)\n")
        ;; %rbp is now the 6th callee-saved register (M-G3 stage 2), so the
        ;; call-spanning var 4 is homed in %rbp; var 6 remains rematerialised
        ;; after the call. W3 step (a): the literal recompute is now decided
        ;; in the ASSIGNMENT table, so the backend materialises it straight
        ;; into the register the use scavenges (%r8d) instead of the fixed
        ;; %r9 the use-site rewrite pipeline reserved. Same two instructions,
        ;; one fewer constraint on the scavenger.
        (asm-has? a1 "    movl $4, %ebp\n")
        (asm-has? a1 "    movl $6, %r8d\n"))]
    (and
      (match a1-result
        [(Ok _) true]
        [(Err _) false])
      (match b1-result
        [(Ok _) true]
        [(Err _) false])
      (match a2-result
        [(Ok _) true]
        [(Err _) false])
      (match b2-result
        [(Ok _) true]
        [(Err _) false])
      (string.eq a1 a2)
      (string.eq b1 b2)
      (not (string.eq a1 b1))
      (be_state.compiler-backend-state-scalar-registers-enabled? state-a)
      (not (be_state.compiler-backend-state-scalar-registers-enabled? state-b))
      a-shape-ok)))

;; #4720: an outlined shifted loop bound becomes `0 < word-count` after loop
;; rotation. On Win64, word-count may be homed in %r9; materialising the
;; immediate LHS into that same register would silently turn the pre-test into
;; a self-compare. Keep the function address-taken so opt2 cannot inline away the
;; allocation shape, then emit the full lower -> opt2 -> scalar-regalloc path.
;;
;; The address-take is a GLOBAL initialised with the function, and every fixture
;; below that needs one spells it the same way. A wrapper such as
;; `(define (keep [f : T]) : i64 0)` called from `main` does not hold anything:
;; a wrapper whose body ignores its parameter is inlined at its site (a tail
;; call site included, via opt-inline-try-with-spans's TailCall arm), the
;; argument goes with it, and the subject is then unreferenced and pruned
;; before it is ever emitted. A global holding the address is not a call at
;; all, so nothing can dissolve it: the census reads it as address-taken (so the
;; subject is never inlined) and the pruner reads it as a root (so the subject
;; is always emitted).
(define compiler-backend-shifted-loop-bound-source : String
  "(define (array-zero-count [buf : (MutPtr u8)] [byte-count : i64]) : i64
  (let
    [word-count : i64 (shr byte-count 3)]
    [tail-start : i64 (* word-count 8)]
    [slots : (MutPtr u64) (unsafe (ptr-cast buf : (MutPtr u64)))]
    [w : i64 0]
    [i : i64 tail-start]
    (begin
      (while (< w word-count)
        (begin
          (unsafe (ptr-write! (ptr-offset slots w) (cast 0 : u64)))
          (set! w (+ w 1))))
      (while (< i byte-count)
        (begin
          (unsafe (ptr-write! (ptr-offset buf i) (cast 0 : u8)))
          (set! i (+ i 1))))
      w)))
(define keep : (-> (MutPtr u8) i64 i64) array-zero-count)
(define (main) : i64 0)")

(define (compiler-backend-emit-source-opt2-for-target
  [source : String]
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-source-opt2-for-target-and-entry source target true))

(define (compiler-backend-emit-source-opt2-for-target-and-entry
  [source : String]
  [target : be_state.CompilerBackendTarget]
  [emit-entry : bool]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-source-opt2-sized source target emit-entry false))

;; The opt2 IR emitted as `-O2` or, with `size?`, as `-Os`.
(define (compiler-backend-emit-source-opt2-sized
  [source : String]
  [target : be_state.CompilerBackendTarget]
  [emit-entry : bool]
  [size? : bool]) : be_state.ResultCompilerBackend
  (match (backend.compiler-backend-lower-source-for-target source target)
    [(Ok program spans lower-owner)
      (let
        [result : be_state.ResultCompilerBackend
          (match (opt.optimize-program-with-spans-and-level (& program) spans 2)
            [(Program optimized optimized-spans)
              (let
                [backend-state : be_state.CompilerBackendState
                  (be_state.compiler-backend-state-new
                    (ci.intern-compat-state-capture-active))]
                (be_state.compiler-backend-state-set-scalar-registers-enabled!
                  backend-state
                  true)
                (be_state.compiler-backend-state-set-optimize-for-size!
                  backend-state
                  size?)
                (compiler-backend-test-emit-program-with-state
                  backend-state
                  target
                  optimized
                  optimized-spans
                  emit-entry))])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        result)]
    [(Err diag) (Err diag)]))

;; A `stdlib.*` module fixture is library code: its module-qualified `main` is
;; an ordinary function, not the program entry, so it emits without an entry
;; point (#7071).
(define (compiler-backend-emit-library-source-for-target
  [source : String]
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (match (backend.compiler-backend-lower-source-for-target source target)
    [(Ok program spans lower-owner)
      (let
        [result : be_state.ResultCompilerBackend
          (compiler-backend-emit-program-with-spans-for-target-and-entry
            program
            spans
            target
            false)]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        result)]
    [(Err diag) (Err diag)]))

;; Emit the scalar stack-only path used by opt0/opt1. Keeping this helper
;; separate from the opt2 helper above makes the no-register-allocation policy
;; explicit at the test boundary.
(define (compiler-backend-emit-source-stack-only-for-target-and-level
  [source : String]
  [target : be_state.CompilerBackendTarget]
  [level : i64]) : be_state.ResultCompilerBackend
  (match (backend.compiler-backend-lower-source-for-target source target)
    [(Ok program spans lower-owner)
      (let
        [result : be_state.ResultCompilerBackend
          (match (opt.optimize-program-with-spans-and-level
            (& program)
            spans
            level)
            [(Program optimized optimized-spans)
              (let
                [backend-state : be_state.CompilerBackendState
                  (be_state.compiler-backend-state-new
                    (ci.intern-compat-state-capture-active))]
                (be_state.compiler-backend-state-set-scalar-registers-enabled!
                  backend-state
                  false)
                (compiler-backend-test-emit-program-with-state
                  backend-state
                  target
                  optimized
                  optimized-spans
                  true))])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        result)]
    [(Err diag) (Err diag)]))

(define compiler-backend-stack-only-frame-color-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define (stack-only-branch-storage [condition : bool]) : i64
  (if condition
    (let
      [items : (Array i64 8) (array 1 2 3 4 5 6 7 8)]
      (opaque (array-ref items 7)))
    (let
      [items : (Array i64 8) (array 11 12 13 14 15 16 17 18)]
      (opaque (array-ref items 6)))))
(define keep-stack-only-branch-storage : (-> bool i64)
  stack-only-branch-storage)
(define (main) : i64
  (stack-only-branch-storage (= (opaque 0) 0)))")

(define (compiler-backend-stack-only-frame-color-target-level-ok?
  [target : be_state.CompilerBackendTarget]
  [level : i64]) : bool
  (match (compiler-backend-emit-source-stack-only-for-target-and-level
    (string.copy (& compiler-backend-stack-only-frame-color-source))
    target
    level)
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_f0")]
        [windows? : bool (be_facts.compiler-backend-target-windows? target)]
        [frame : String
          (if windows?
            (if (= level 0)
              "    subq $304, %rsp\n"
              "    subq $288, %rsp\n")
            (if (= level 0)
              "    subq $280, %rsp\n"
              "    subq $264, %rsp\n"))]
        [uncolored-frame : String
          (if windows?
            "    subq $544, %rsp\n"
            "    subq $520, %rsp\n")]
        (and
          (asm-has? asm "#t _tl_f0 _tl_stack_only_branch_storage\n")
          ;; Each branch's `let` adopts its literal's storage as its only home
          ;; at every level. The exact frame pins that the two branches share
          ;; one colored slot; the opt1 uncolored size (measured with branch
          ;; coloring disabled) must not appear.
          (asm-has? body frame)
          (or (= level 0) (asm-lacks? body uncolored-frame))
          ;; The stack-only policy is unchanged: compaction must not smuggle
          ;; scalar allocation or callee-saved homes into opt0/opt1.
          (asm-lacks? body "%r12")
          (asm-lacks? body "%r13")))]
    [(Err _) false]))

(define (compiler-backend-stack-only-frame-color-ok?) : bool
  (and
    (compiler-backend-stack-only-frame-color-target-level-ok?
      (be_state.CompilerBackendTarget.Linux)
      0)
    (compiler-backend-stack-only-frame-color-target-level-ok?
      (be_state.CompilerBackendTarget.Linux)
      1)
    (compiler-backend-stack-only-frame-color-target-level-ok?
      (be_state.CompilerBackendTarget.Windows)
      0)
    (compiler-backend-stack-only-frame-color-target-level-ok?
      (be_state.CompilerBackendTarget.Windows)
      1)))

(define (compiler-backend-compare-self-operand?
  [body : (& body str)]
  [reg : String]) : bool
  (let
    [needle (str_cat.str-cat "    cmpq " reg ", " reg "\n")]
    (asm-has? body needle)))

(define (compiler-backend-immediate-lhs-r9-compare-win64-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_win : unit (compiler-backend-set-current-fn-win64! backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r9")]
    [ok : bool
      (match (be_scalar.compiler-backend-emit-compare-branch
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        "cmp"
        (Lt)
        (I64 0)
        (Var 0)
        (I64)
        (ir.compiler-ir-label "then")
        (ir.compiler-ir-label "else")
        (No)
        backend-state)
        [(Ok asm)
          (and
            ;; `0 < %r9` is emitted as `%r9 > 0`; the zero compare now uses
            ;; the register self-test form and needs no scratch at all.
            (asm-has? asm "    testq %r9, %r9\n")
            (asm-lacks? asm "    cmpq $0, %r9\n")
            (asm-lacks? asm "    cmpq %r9, %r9\n"))]
        [(Err _) false])]
    [_linux : unit (compiler-backend-set-current-fn-linux! backend-state)]
    ok))

;; Tail-call dispatcher shape. A multi-arm dispatch whose every arm is a TAIL
;; CALL contains no instruction control ever returns from, so no value in it has
;; to survive anything: the four parameters must keep their incoming argument
;; registers and the function must save NO callee-saved register at all. Tail
;; calls stay out of the allocator's clobber-point set (kind 6,
;; compiler-reg-clobber-instr-kind?); otherwise each parameter's coarse interval
;; hull would cover the sibling arms' tail calls and home all four in
;; callee-saved registers, with a push, an entry copy and a pop per invocation.
;;
;; Arm 1 marshals (k, y, x): %rdi keeps k while %rsi and %rdx must SWAP. That is
;; a true 2-cycle for the argument parallel move
;; (compiler-backend-emit-arg-move-list), which only exists once the parameters
;; live in argument registers -- so this fixture is also the cycle-break
;; regression test. `keep4` is the address-taking global described above; it
;; holds the dispatcher as a value so the optimizer cannot inline the whole
;; thing away.
;; The arms carry a guard so each one is more than a single block. Without it
;; they are exactly the shape the single-block inliner takes at a tail-call site
;; (opt-inline-try-with-spans's TailCall arm), the dispatcher's three `jmp`s
;; become three spliced bodies, and the tail-jump tail this fixture exists to
;; check is not emitted at all. The guard costs the fixture nothing that it
;; measures: every assertion below reads `_tl_tc_dispatch`, whose own shape --
;; the empty CSR set, the incoming argument registers, the 2-cycle break and the
;; three tail jumps -- is unchanged by what the arms contain.
(define compiler-backend-tail-dispatch-source : String
  "(define (tc-arm-a [a : i64] [b : i64] [c : i64]) : i64
  (if (< a 0)
    (- 0 a)
    (+ (* a 3) (+ (* b 5) (* c 7)))))
(define (tc-arm-b [a : i64] [b : i64] [c : i64]) : i64
  (if (< b 0)
    (- 0 b)
    (- (* a 11) (+ (* b 13) (* c 17)))))
(define (tc-arm-c [a : i64] [b : i64] [c : i64]) : i64
  (if (< c 0)
    (- 0 c)
    (+ (* a 19) (- (* b 23) (* c 29)))))
(define (tc-dispatch [k : i64] [x : i64] [y : i64] [z : i64]) : i64
  (if (= k 0)
    (tc-arm-a x y z)
    (if (= k 1)
      (tc-arm-b k y x)
      (if (= k 2)
        (tc-arm-c z x y)
        (tc-arm-a z y x)))))
(define keep4 : (-> i64 i64 i64 i64 i64) tc-dispatch)
(define (main) : i64 0)")

;; A classifier chain inside a loop, spelled with nested `if`s because the raw
;; source path lowers without the prelude that defines `or`. Its constants span
;; a window whose 64-bit mask -- bits {0,4,9,10,12,14,33,37} above base 33,
;; i.e. 146028910097 -- lands outside imm32, so no instruction operand can
;; encode it.
;;
;; The bit_test rewrite converts the chain, the mask is loop-invariant, LICM
;; hoists its `Mov` into the preheader, and the wide-literal operand rule
;; (opt-global-copy-keep-wide-left) keeps it there instead of folding the
;; literal back into the shift. Emitted, that is a `movq $imm` once in the
;; preheader plus a bare `btq` per iteration, and NO `movabsq` of the mask
;; anywhere -- `movabsq` is the emitter's operand-materialization spelling
;; (compiler-backend-emit-load-i64-absolute), so its absence is a precise
;; witness that the constant is not being rebuilt at the test.
(define compiler-backend-wide-bit-test-mask-source : String
  "(define (wbt-classify [c : i64]) : bool
  (if (= c 33)
    true
    (if (= c 37)
      true
      (if (= c 42)
        true
        (if (= c 43)
          true
          (if (= c 45)
            true
            (if (= c 47)
              true
              (if (= c 66)
                true
                (= c 70)))))))))
(define (wbt-count [n : i64] [seed : i64]) : i64
  (let
    [i : i64 0]
    [c : i64 seed]
    [hits : i64 0]
    (begin
      (while (< i n)
        (begin
          (if (wbt-classify c)
            (set! hits (+ hits 1))
            unit)
          (set! c (+ c 1))
          (set! i (+ i 1))))
      hits)))
(define keep2 : (-> i64 i64 i64) wbt-count)
(define (main) : i64 0)")

(define (compiler-backend-wide-bit-test-mask-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-wide-bit-test-mask-source))
    (be_state.CompilerBackendTarget.Linux))
    [(Ok asm)
      (and
        ;; The chain became one bit test.
        (asm-has? asm "    btq ")
        ;; The mask reaches the emitter as its own `Mov`, spelled with the plain
        ;; `movq $imm` form -- it is materialized once where that Mov landed.
        (asm-has? asm "    movq $146028910097")
        ;; ...and never as an operand materialization at the test itself, which
        ;; is what folding the literal into the shift would emit per entry.
        (asm-lacks? asm "movabsq $146028910097"))]
    [(Err _) false]))

;; A loop-wide literal home is injected just after its resolved preheader label.
;; The array allocation below makes that preheader callful: injecting the
;; 2^32 literal there puts it in a caller-saved register before `tl_alloc` and
;; `tl_array_zero`, and the subtraction loop later observes the clobbered home.
;; This is the reduced `stdlib.format/bn-sub` failure from #6875. The callful
;; refusal is also tested directly below (`compiler-backend-const-hoist-test-
;; inject`), independently of this source's register and loop plan.
(define compiler-backend-callful-preheader-wide-literal-source : String
  "(defstruct BigNum
  (limbs (__tl_dyn-array u64))
  (len i64))
(define (bn-norm-len [limbs : (& (__tl_dyn-array u64))] [len : i64]) : i64
  (let
    [out : i64 len]
    [done : bool false]
    (begin
      (while (not done)
        (if (> out 0)
          (if (= (array-ref limbs (- out 1)) (cast 0 : u64))
            (set! out (- out 1))
            (set! done true))
          (set! done true)))
      out)))
(define (bn-sub [a : BigNum] [b : BigNum]) : BigNum
  (let
    [r : (__tl_dyn-array u64) (__tl_make-array u64 (array-length a.limbs))]
    [borrow : u64 (cast 0 : u64)]
    [i : i64 0]
    (begin
      (while (< i a.len)
        (let
          [av : u64 (array-ref a.limbs i)]
          [bv : u64
            (if (< i b.len)
              (array-ref b.limbs i)
              (cast 0 : u64))]
          [subtrahend : u64 (+ bv borrow)]
          (begin
            (if (>= av subtrahend)
              (begin
                (set! (array-ref r i) (- av subtrahend))
                (set! borrow (cast 0 : u64)))
              (begin
                (set!
                  (array-ref r i)
                  (- (+ av (cast 0x100000000 : u64)) subtrahend))
                (set! borrow (cast 1 : u64))))
            (set! i (+ i 1)))))
      (let
        [norm-len : i64 (bn-norm-len (& r) a.len)]
        (BigNum r norm-len)))))
(define keep2 : (-> BigNum BigNum BigNum) bn-sub)
(define (main) : i64 0)")

(define (compiler-backend-callful-preheader-wide-literal-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-callful-preheader-wide-literal-source))
    target)
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_bn_sub")]
        (and
          (asm-has? body "    call tl_alloc\n" "    call tl_array_zero\n")
          ;; A declined hoist rematerializes at the loop use. The ordinary use
          ;; spelling is `movq`; `movabsq` is unique to the preheader injection.
          (asm-has? body "    movq $4294967296")
          (asm-lacks? body "    movabsq $4294967296")))]
    [(Err _) false]))

(define (compiler-backend-const-hoist-test-inject [prefix : String]) : i64
  (match (irt.func
    (str_cat.str-cat
      "function @callful_preheader(limit=%0:i64) -> i64 vars 5 {\nentry:\n"
      (str_cat.str-cat
        prefix
        "jump loop\nloop:\n%1 = phi [0, entry], [%2, loop] : i64\n%2 = add %1, 1 : i64\n%3 = lt %2, %0 : i64\nbranch %3, loop, exit\nexit:\nreturn %2\n}")))
    [(ir.CompilerIrFunction.Function _ _ _ _ blocks _)
      ;; Block lists are dense arrays (#8594).
      (let
        [ids : backend_i64_i64_map.Map
          (regalloc.compiler-reg-loop-depth-block-ids
            (& blocks)
            (& (backend_i64_i64_map.with-capacity 16))
            0)]
        (match blocks
          [(ir.CompilerIrBlockList.Array seq)
            (be_scalar.compiler-backend-const-hoist-resolve-inject
              seq.slots
              (& ids)
              1
              1)]))]))

(define (compiler-backend-callful-preheader-wide-literal-ok?) : bool
  (and
    (= (compiler-backend-const-hoist-test-inject "") 0)
    (=
      (compiler-backend-const-hoist-test-inject "%4 = call opaque() : i64\n")
      -1)
    (= (compiler-backend-const-hoist-test-inject "%4 = syscall(39)\n") -1)
    (compiler-backend-callful-preheader-wide-literal-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-callful-preheader-wide-literal-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

;; In scalar mode a `foreach` body that calls an out-of-line helper is a loop
;; around an `SpmdCall`. That call clobbers the caller-saved registers like any
;; other, so the loop is not a leaf region and the constant hoister must not
;; carry the `% 3` magic across it in %r8 (#8198). A declined hoist
;; rematerializes the magic at its use; `movabsq` then sits right before the
;; unsigned `mulq` (since `cvp_range` proves `i >= 0`), never at the preheader
;; label.
(define compiler-backend-spmd-call-loop-divmod-source : String
  "(define (store-flags
  [out : (&mut out (__tl_dyn-array i64))]
  [i : i64]
  [small : bool]
  [third : bool]) : unit
  (if small
    (set! (array-ref out i) (if third 1 2))
    (set! (array-ref out i) 3)))
(define (fill [out : (&mut out (__tl_dyn-array i64))] [n : i64]) : unit
  (foreach ([i : i64 0 n]) (store-flags out i (< i 7) (= (% i 3) 0))))
(define (main) : i64
  (let
    [out : (__tl_dyn-array i64) (__tl_make-array i64 13)]
    (begin
      (fill (&mut out) 13)
      (array-ref out 3))))")

(define (compiler-backend-spmd-call-loop-divmod-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-spmd-call-loop-divmod-source))
    target)
    [(Ok asm)
      (and
        (asm-has? asm "    call _tl_f0\n")
        (asm-has? asm "    movabsq $-6148914691236517205, %r8\n    mulq %r8\n")
        (asm-lacks? asm "__preheader:\n    movabsq $-6148914691236517205"))]
    [(Err _) false]))

(define (compiler-backend-spmd-call-loop-divmod-ok?) : bool
  (and
    (compiler-backend-spmd-call-loop-divmod-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-spmd-call-loop-divmod-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-tail-dispatch-no-csr-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-tail-dispatch-source))
    (be_state.CompilerBackendTarget.Linux))
    [(Ok asm)
      (let
        [body : String
          (compiler-backend-asm-function-body asm "_tl_tc_dispatch")]
        (and
          (not (string.eq body ""))
          ;; No callee-saved register is saved OR restored: the plan's CSR set is
          ;; empty, so the tail-jump tail (compiler-backend-tail-jump-tail, which
          ;; derives its restores from that same plan) emits none either.
          (asm-lacks? body "    pushq ")
          (asm-lacks? body "    popq ")
          ;; The parameters are read straight out of their incoming ABI registers
          ;; instead of being copied to callee-saved homes in the prologue.
          (asm-has? body "    testq %rdi, %rdi\n")
          (asm-lacks? body "    movq %rdi, %r12\n")
          ;; Arm 1's %rsi/%rdx 2-cycle is broken through a scratch register
          ;; instead of being emitted as two moves that overwrite a source
          ;; before it is read: %rdx is staged into %r9, %rsi lands in %rdx, and
          ;; the staged copy lands in %rsi.
          (asm-has? body "    movq %rdx, %r9\n")
          (asm-has? body "    movq %rsi, %rdx\n")
          (asm-has? body "    movq %r9, %rsi\n")
          ;; Every arm still leaves through a jmp, not a call/ret pair.
          (asm-has? body "    jmp _tl_tc_arm_a\n")
          (asm-has? body "    jmp _tl_tc_arm_b\n")
          (asm-has? body "    jmp _tl_tc_arm_c\n")))]
    [(Err _) false]))

;; M9: both `if`s test the same comparison, so GVN leaves ONE compare with two
;; branch readers. The backend fuses a compare into `cmp`/`jcc` only when every
;; reader is a branch fed by its own adjacent compare, so a shared boolean is
;; materialised (`cmp`/`setl`/`movzbq`) and tested at each site. The late
;; duplication pass gives each branch its own copy. The address-taking global
;; keeps opt2 from inlining the shape away.
(define compiler-backend-shared-compare-source : String
  "(define (cd-two-branch [a : i64] [b : i64] [c : i64]) : i64
  (let
    [t : i64 0]
    (begin
      (if (< a b)
        (set! t 1)
        (set! t 2))
      (if (< a b)
        (set! t (+ t (* c 3)))
        (set! t (+ t (* c 5))))
      t)))
(define cd-keep : (-> i64 i64 i64 i64) cd-two-branch)
(define (main) : i64 0)")

(define (compiler-backend-shared-compare-duplication-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-shared-compare-source))
    (be_state.CompilerBackendTarget.Linux))
    [(Ok asm)
      (let
        [body : String
          (compiler-backend-asm-function-body asm "_tl_cd_two_branch")]
        (and
          (not (string.eq body ""))
          ;; Each branch owns a compare, and each of those fuses.
          (>= (backend.compiler-backend-string-count body "    cmpq ") 2)
          ;; The boolean is never materialised, so neither half of the
          ;; `setcc`/`movzbq` pair survives and no site spends a `test`.
          (asm-lacks? body "    setl ")
          (asm-lacks? body "    movzbq " "    movzbl ")
          (asm-lacks? body "    testq ")))]
    [(Err _) false]))

;; Flags reuse. Every `flag` below is stored to a global as well as branched on,
;; so the boolean MUST be materialised: `compiler-backend-var-fuse-safe?` sees a
;; non-branch reader and refuses the fusion, and the late compare duplication
;; refuses the copy for the same reason. `setcc` and `movzb` read EFLAGS and
;; write none, so the comparison's own flags survive the materialisation and the
;; adjacent branch takes its `jcc` directly instead of spending a `test` to
;; recompute what it already has. The sink global keeps opt2 from inlining the
;; shape away, and the fixture's `main` READS it: a cell nothing reads is
;; provably unobservable inside the module, and opt2 drops its stores, which
;; would take the `movb` out of the measured window. Each case is its own
;; program so every assertion reads the same `_tl_fr_lt` body.
;;
;; Signed `<` with the false edge falling through to the then-block: the branch
;; jumps on the INVERSE of the boolean's own condition.
(define compiler-backend-flags-reuse-lt-source : String
  "(define fr-sink : bool false)
(define (fr-lt [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if flag (set! t (* a 3)) (set! t (+ b 7)))
      (set! fr-sink flag)
      t)))
(define fr-keep : (-> i64 i64 i64) fr-lt)
(define (main) : i64 (if fr-sink 1 0))")

;; Unsigned `<` takes the unsigned condition on both halves.
(define compiler-backend-flags-reuse-ult-source : String
  "(define fr-sink : bool false)
(define (fr-lt [a : u64] [b : u64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if flag (set! t 3) (set! t 9))
      (set! fr-sink flag)
      t)))
(define fr-keep : (-> u64 u64 i64) fr-lt)
(define (main) : i64 (if fr-sink 1 0))")

;; A negated condition only exchanges the successors, so the reused `jcc` is the
;; comparison's own with the labels swapped.
(define compiler-backend-flags-reuse-neg-source : String
  "(define fr-sink : bool false)
(define (fr-lt [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if (not flag) (set! t (* a 5)) (set! t (+ b 11)))
      (set! fr-sink flag)
      t)))
(define fr-keep : (-> i64 i64 i64) fr-lt)
(define (main) : i64 (if fr-sink 1 0))")

;; Float comparisons are excluded, as they are from every other fusion here.
(define compiler-backend-flags-reuse-f64-source : String
  "(define fr-sink : bool false)
(define (fr-lt [a : f64] [b : f64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (if flag (set! t 13) (set! t 19))
      (set! fr-sink flag)
      t)))
(define fr-keep : (-> f64 f64 i64) fr-lt)
(define (main) : i64 (if fr-sink 1 0))")

;; The window is closed at zero instructions: storing the boolean BEFORE the
;; branch puts something between the materialisation and the jump -- here a
;; flag-preserving `movb`, and it is refused all the same -- so the `test` stays.
(define compiler-backend-flags-reuse-gap-source : String
  "(define fr-sink : bool false)
(define (fr-lt [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (begin
      (set! fr-sink flag)
      (if flag (set! t (* a 3)) (set! t (+ b 7)))
      t)))
(define fr-keep : (-> i64 i64 i64) fr-lt)
(define (main) : i64 (if fr-sink 1 0))")

;; The boolean materialises in every case. Integers retain `movzb`; floats
;; initialize the result and guard `setcc` with their unordered parity branch.
;; `reused?` says whether the branch then reads the comparison's own flags with
;; `jcc` and spends no `test`, or falls back to re-deriving them.
(define (compiler-backend-flags-reuse-body-ok?
  [source : String]
  [setcc : String]
  [materialize : String]
  [jcc : String]
  [reused? : bool]) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    source
    (be_state.CompilerBackendTarget.Linux))
    [(Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_fr_lt")]
        (and
          (not (string.eq body ""))
          (asm-has? body setcc materialize)
          (if reused?
            (and (asm-has? body jcc) (asm-lacks? body "    testq "))
            (asm-has? body "    testq "))))]
    [(Err _) false]))

(define (compiler-backend-flags-reuse-branch-ok?) : bool
  (and
    (compiler-backend-flags-reuse-body-ok?
      (string.copy (& compiler-backend-flags-reuse-lt-source))
      "    setl "
      "    movzbl "
      "    jge "
      true)
    (compiler-backend-flags-reuse-body-ok?
      (string.copy (& compiler-backend-flags-reuse-ult-source))
      "    setb "
      "    movzbl "
      "    jae "
      true)
    (compiler-backend-flags-reuse-body-ok?
      (string.copy (& compiler-backend-flags-reuse-neg-source))
      "    setl "
      "    movzbl "
      "    jl "
      true)
    (compiler-backend-flags-reuse-body-ok?
      (string.copy (& compiler-backend-flags-reuse-f64-source))
      "    setb "
      "    jp 1f\n"
      ""
      false)
    (compiler-backend-flags-reuse-body-ok?
      (string.copy (& compiler-backend-flags-reuse-gap-source))
      "    setl "
      "    movzbl "
      ""
      false)))

;; Runtime parity for the same peephole, in the compiler's own binary rather
;; than in inspected text: `compiler-backend-flags-reuse-arg` is mutable, so
;; these calls cannot fold away and the rewritten shape actually EXECUTES here.
;; The guard case is the sharp one -- it divides only on the taken edge, so a
;; mis-derived condition would trap on the zero divisor instead of returning 0.
(define compiler-backend-flags-reuse-arg : i64
  1)
(define compiler-backend-flags-reuse-flag : bool
  false)

(define (compiler-backend-flags-reuse-lt [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (if flag
      (set! t (* a 3))
      (set! t (+ b 7)))
    (set! compiler-backend-flags-reuse-flag flag)
    t))

(define (compiler-backend-flags-reuse-neg [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (if (not flag)
      (set! t (* a 5))
      (set! t (+ b 11)))
    (set! compiler-backend-flags-reuse-flag flag)
    t))

(define (compiler-backend-flags-reuse-guard [a : i64] [b : i64]) : i64
  (let
    [flag : bool (< a b)]
    [t : i64 0]
    (if flag
      (set! t (/ 100 a))
      (set! t 0))
    (set! compiler-backend-flags-reuse-flag flag)
    t))

(define (compiler-backend-flags-reuse-runtime-ok?) : bool
  (let
    [one : i64 compiler-backend-flags-reuse-arg]
    (and
      (= (compiler-backend-flags-reuse-lt one (+ one 1)) 3)
      compiler-backend-flags-reuse-flag
      (= (compiler-backend-flags-reuse-lt (+ one 4) (+ one 1)) 9)
      (not compiler-backend-flags-reuse-flag)
      (= (compiler-backend-flags-reuse-neg one (+ one 1)) 13)
      compiler-backend-flags-reuse-flag
      (= (compiler-backend-flags-reuse-neg (+ one 4) (+ one 1)) 25)
      (not compiler-backend-flags-reuse-flag)
      (= (compiler-backend-flags-reuse-guard (+ one 4) (+ one 8)) 20)
      (= (compiler-backend-flags-reuse-guard (- one 1) (- one 2)) 0))))

;; Cross-edge flags reuse. The in-block tests above keep a materialized
;; comparison's flags alive across its own `setcc`/`movzb`; the carry below
;; crosses a block edge instead. A block that ENDS in a compare+branch fusion
;; leaves its compare's flags live (`jcc` and the `movq`-only emergency restore
;; write no EFLAGS), so a successor whose only predecessor is that block and
;; whose own FIRST instruction compares the same two vars at the same width
;; needs only its `jcc` -- with the condition inverted when the operands are
;; swapped. The fixtures are IR text so each case names its exact layout, its
;; predecessor count and its operand widths. `.Lf0_low:` is matched by its
;; `_low:` suffix because the label ids are process-global.
;;
;; Positive: `entry` ends in `gt a, b` and branches away, leaving `low` as the
;; fall-through successor; `low` opens with `eq a, b`.
(define compiler-backend-flags-reuse-edge-source : String
  "function @edge_flags(a=%0:i64, b=%1:i64) -> i64 vars 4 {
entry:
  %2 = gt %0, %1 : i64
  branch %2, high, low
low:
  %3 = eq %0, %1 : i64
  branch %3, same, less
same:
  return 2
less:
  return 3
high:
  return 1
}")

;; Swapped operands read the SAME flags with the inverted condition: `lt b, a`
;; is `gt a, b`, so the reused `jcc` is `jg` and a recomputed `jl` never appears.
(define compiler-backend-flags-reuse-edge-swapped-source : String
  "function @edge_flags(a=%0:i64, b=%1:i64) -> i64 vars 4 {
entry:
  %2 = gt %0, %1 : i64
  branch %2, high, low
low:
  %3 = lt %1, %0 : i64
  branch %3, less, same
same:
  return 2
less:
  return 3
high:
  return 1
}")

;; `low` is also the target of `alt`, so its label is a merge and another edge
;; reaches it with arbitrary flags: the carry must be refused.
(define compiler-backend-flags-reuse-edge-two-preds-source : String
  "function @edge_flags(a=%0:i64, b=%1:i64) -> i64 vars 4 {
entry:
  %2 = gt %0, %1 : i64
  branch %2, high, low
low:
  %3 = eq %0, %1 : i64
  branch %3, same, less
same:
  return 2
less:
  return 3
high:
  return 1
alt:
  jump low
}")

;; A flag-writing instruction ahead of the compare in `low` closes the window:
;; `shlq` overwrites the flags the edge carried, so the `cmp` must come back.
(define compiler-backend-flags-reuse-edge-flag-writer-source : String
  "function @edge_flags(a=%0:i64, b=%1:i64) -> i64 vars 5 {
entry:
  %2 = gt %0, %1 : i64
  branch %2, high, low
low:
  %3 = shl %0, 2 : i64
  %4 = eq %0, %1 : i64
  branch %4, same, less
same:
  return 2
less:
  return 3
high:
  return 1
}")

;; A bit-test's `test` flags are the AND of its operands, not a comparison, so
;; the carry must not spend them as if the successor's `cmp` had set them.
(define compiler-backend-flags-reuse-edge-bit-test-source : String
  "function @edge_flags(a=%0:i64, b=%1:i64) -> i64 vars 4 {
entry:
  %2 = bit_test_ne %0, %1 : i64
  branch %2, high, low
low:
  %3 = eq %0, %1 : i64
  branch %3, same, less
same:
  return 2
less:
  return 3
high:
  return 1
}")

;; #jump-forward retargets `other`'s branch onto `s` and `entry`'s jump onto the
;; same block, so `s` is reached with `other`'s flags as well; its IR
;; predecessor count stays 1 (only `join` names it), so only refusing a raw
;; label that is not `s` itself keeps the carry out of it.
(define compiler-backend-flags-reuse-edge-forwarded-source : String
  "function @edge_flags(a=%0:i64, b=%1:i64) -> i64 vars 8 {
entry:
  %2 = gt %0, %1 : i64
  branch %2, join, less
other:
  %3 = eq %1, %0 : i64
  branch %3, join, less
s:
  %4 = lt %0, %1 : i64
  branch %4, same, less2
same:
  %5 = add %0, 2 : i64
  return %5
less:
  %7 = mul %0, 3 : i64
  return %7
less2:
  %6 = sub %0, 2 : i64
  return %6
join:
  jump s
}")

;; The same vars compared at a different width set different flags: the carry
;; is refused and `low` recomputes with `cmpl`.
;; The same vars compared at a different width set different flags: the carry
;; is refused and `low` recomputes with `cmpl`.
(define compiler-backend-flags-reuse-edge-width-source : String
  "function @edge_flags(a=%0:i64, b=%1:i64) -> i64 vars 4 {
entry:
  %2 = gt %0, %1 : i64
  branch %2, high, low
low:
  %3 = eq %0, %1 : i32
  branch %3, same, less
same:
  return 2
less:
  return 3
high:
  return 1
}")

(define (compiler-backend-flags-reuse-edge-asm [source : String]) : String
  (let
    [state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (be_state.compiler-backend-state-set-scalar-registers-enabled! state true)
    (let
      [program : ir.CompilerIrProgram (irt.program source)]
      [spans : ir.CompilerSourceSpans (ir.compiler-source-spans-empty)]
      (match (compiler-backend-test-emit-program-with-state
        state
        (be_state.CompilerBackendTarget.Linux)
        (& program)
        (& spans)
        false)
        [(Ok asm) asm]
        [(Err _) ""]))))

;; `compare` is the compare mnemonic the fixture's width emits (and therefore
;; how many compares the emitted function spends), and `site` is what follows
;; the successor's label: the reused `jcc` when the carry applies, the
;; recomputed compare when it does not.
(define (compiler-backend-flags-reuse-edge-case?
  [source : String]
  [compare : String]
  [compare-count : i64]
  [site : String]) : bool
  (let
    [asm : String (compiler-backend-flags-reuse-edge-asm source)]
    (and
      (not (string.eq asm ""))
      (= (backend.compiler-backend-string-count asm compare) compare-count)
      (asm-has? asm (str_cat.str-cat "_low:\n    " site)))))

(define (compiler-backend-flags-reuse-edge-ok?) : bool
  (and
    (compiler-backend-flags-reuse-edge-case?
      (string.copy (& compiler-backend-flags-reuse-edge-source))
      "    cmpq "
      1
      "jne ")
    (compiler-backend-flags-reuse-edge-case?
      (string.copy (& compiler-backend-flags-reuse-edge-swapped-source))
      "    cmpq "
      1
      "jg ")
    (asm-lacks?
      (compiler-backend-flags-reuse-edge-asm
        (string.copy (& compiler-backend-flags-reuse-edge-swapped-source)))
      "    jl ")
    (compiler-backend-flags-reuse-edge-case?
      (string.copy (& compiler-backend-flags-reuse-edge-two-preds-source))
      "    cmpq "
      2
      "cmpq ")
    (compiler-backend-flags-reuse-edge-case?
      (string.copy (& compiler-backend-flags-reuse-edge-flag-writer-source))
      "    cmpq "
      2
      "movq ")
    (asm-has?
      (compiler-backend-flags-reuse-edge-asm
        (string.copy (& compiler-backend-flags-reuse-edge-flag-writer-source)))
      "    shlq $2, %rax\n    cmpq ")
    (compiler-backend-flags-reuse-edge-case?
      (string.copy (& compiler-backend-flags-reuse-edge-width-source))
      "    cmpl "
      1
      "cmpl ")
    ;; The bit-test keeps its `test`, and `low` starts with its own compare
    ;; rather than the reused `jcc`.
    (asm-has?
      (compiler-backend-flags-reuse-edge-asm
        (string.copy (& compiler-backend-flags-reuse-edge-bit-test-source)))
      "    testq "
      "_low:\n    cmpq ")
    (asm-lacks?
      (compiler-backend-flags-reuse-edge-asm
        (string.copy (& compiler-backend-flags-reuse-edge-bit-test-source)))
      "_low:\n    j")
    ;; `s` is entered from two places, so it keeps its own compare too.
    (asm-has?
      (compiler-backend-flags-reuse-edge-asm
        (string.copy (& compiler-backend-flags-reuse-edge-forwarded-source)))
      "_s:\n    cmpq ")
    (asm-lacks?
      (compiler-backend-flags-reuse-edge-asm
        (string.copy (& compiler-backend-flags-reuse-edge-forwarded-source)))
      "_s:\n    j")))

(define (compiler-backend-shifted-loop-bound-win64-ok?) : bool
  (let
    [ok : bool
      (match (compiler-backend-emit-source-opt2-for-target
        (string.copy (& compiler-backend-shifted-loop-bound-source))
        (be_state.CompilerBackendTarget.Windows))
        [(Ok asm)
          (let
            [body : String
              (compiler-backend-asm-function-body asm "_tl_array_zero_count")]
            (and
              (not (string.eq body ""))
              (asm-has? body "    sarq $3,")
              ;; The full regalloc path may spill either compare operand, so
              ;; its exact register choice is intentionally not asserted
              ;; here. No emitted compare may instead test a register against
              ;; itself, which was the original zero-trip-loop corruption.
              (not (compiler-backend-compare-self-operand? body "%rax"))
              (not (compiler-backend-compare-self-operand? body "%rcx"))
              (not (compiler-backend-compare-self-operand? body "%rdx"))
              (not (compiler-backend-compare-self-operand? body "%r8"))
              (not (compiler-backend-compare-self-operand? body "%r9"))
              (not (compiler-backend-compare-self-operand? body "%r10"))
              (not (compiler-backend-compare-self-operand? body "%r11"))
              (compiler-backend-immediate-lhs-r9-compare-win64-ok?)))]
        [(Err _) false])]
    ok))

;; Three loops over four shared global arrays. LICM hoists a data pointer and a
;; length per array, so the descriptors are live across every loop and the
;; register pool is exhausted at the unrolled clear loop -- exactly the shape
;; that makes the allocator spill the clear loop's single-use address temps.
;; Were slot coloring to merge all of those spilled temps onto ONE id, its use
;; count (recomputed on the remapped blocks) would be in the dozens, which turns
;; off `compiler-backend-var-single-use?` and drops every store onto the
;; generic staged emitter: two scratch registers saved to and restored from
;; their homes around a leaq, plus a home round-trip for the address, where one
;; indexed move does the job.
(define compiler-backend-fusion-pin-pressure-source : String
  "(define g-seed : (__tl_dyn-array i64)
  (__tl_make-array i64 4))
(define g-reachable : (__tl_dyn-array i64)
  (__tl_make-array i64 1))
(define g-postorder : (__tl_dyn-array i64)
  (__tl_make-array i64 1))
(define g-rpo : (__tl_dyn-array i64)
  (__tl_make-array i64 1))
(define g-rpo-num : (__tl_dyn-array i64)
  (__tl_make-array i64 1))
(define g-blocks : i64
  0)
(define g-reach-count : i64
  0)

(define (kernel) : i64
  (let
    [count : i64 g-blocks]
    [i : i64 0]
    [post : i64 0]
    (begin
      (while (< i count)
        (begin
          (set! (array-ref g-reachable i) 0)
          (set! (array-ref g-postorder i) -1)
          (set! (array-ref g-rpo i) -1)
          (set! (array-ref g-rpo-num i) -1)
          (set! i (+ i 1))))
      (set! post g-reach-count)
      (set! i 0)
      (while (< i post)
        (begin
          (set! (array-ref g-rpo i) (array-ref g-postorder (- (- post 1) i)))
          (set! i (+ i 1))))
      (set! i 0)
      (while (< i post)
        (begin
          (set! (array-ref g-rpo-num (array-ref g-rpo i)) i)
          (set! i (+ i 1))))
      post)))

(define (main) : i64
  (let
    [n : i64 (array-ref g-seed 0)]
    (begin
      (set! g-blocks n)
      (set! g-reachable (__tl_make-array i64 (+ n 1)))
      (set! g-postorder (__tl_make-array i64 (+ n 1)))
      (set! g-rpo (__tl_make-array i64 (+ n 1)))
      (set! g-rpo-num (__tl_make-array i64 (+ n 1)))
      (kernel))))")

;; Slice one emitted basic block: labels start a line, every instruction is
;; indented, so the block runs from its label to the next line-initial dot.
(define (compiler-backend-asm-label-block [body : String] [label : String]) : String
  (let
    [marker : String (str_cat.str-cat label ":\n")]
    [start : i64 (backend.compiler-backend-string-find-from body marker 0)]
    (if (< start 0)
      ""
      (let
        [block-start : i64 (+ start (string.string-length marker))]
        [next : i64
          (backend.compiler-backend-string-find-from body "\n." block-start)]
        [block-end : i64
          (if (< next 0)
            (string.string-length body)
            next)]
        (string.substring body block-start (- block-end block-start))))))

(define (compiler-backend-fusion-pin-unroll-body [asm : String]) : String
  (let
    [body : String (compiler-backend-asm-function-body asm "_tl_kernel")]
    [marker : i64
      (backend.compiler-backend-string-find-from body "__unroll_body:\n" 0)]
    (if (< marker 0)
      ""
      (compiler-backend-asm-label-block
        (string.substring body marker (- (string.string-length body) marker))
        "__unroll_body"))))

(define (compiler-backend-fusion-pin-store-fusion-ok?) : bool
  (let
    [ok : bool
      (match (compiler-backend-emit-source-opt2-for-target
        (string.copy (& compiler-backend-fusion-pin-pressure-source))
        (be_state.CompilerBackendTarget.Linux))
        [(Ok asm)
          (let
            [block : String (compiler-backend-fusion-pin-unroll-body asm)]
            (and
              (not (string.eq block ""))
              ;; Every unrolled clear store folds its address into an indexed
              ;; addressing mode: one instruction, no address temp at all.
              (>= (backend.compiler-backend-string-count block ",8)\n") 64)
              ;; No address is materialised, and no scratch register or gep
              ;; result takes the round trip through a frame slot.
              (= (backend.compiler-backend-string-count block "leaq") 0)
              (= (backend.compiler-backend-string-count block "(%rsp)") 0)))]
        [(Err _) false])]
    ok))

(define (compiler-backend-peephole-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%xmm2 %2=%r13"))

(define (compiler-backend-expanded-scalar-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r8 %1=%r9"))

(define (compiler-backend-expanded-scalar-regs-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-expanded-scalar-assignments)]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (and
      (string.eq
        (compiler-backend-test-emit-load-var assignments 0 "%rax")
        "    movq %r8, %rax\n")
      ;; An XMM home is MOVQ xmm, which is not a machine record.
      (string.eq
        (compiler-backend-test-emit-load-var
          (compiler-backend-peephole-assignments)
          1
          "%rax")
        "    movq %xmm2, %rax\n")
      (string.eq
        (be_operand.compiler-backend-emit-store-var
          assignments
          1
          "%rax"
          backend-state)
        "    movq %rax, %r9\n")
      (string.eq
        (compiler-backend-emit-load-register
          (ast.ast-node-pool-reader-type-segment-bases)
          "%r8"
          (U32))
        "    movl %r8d, %eax\n")
      (not
        (be_operand.compiler-backend-plan-uses-callee-regs?
          assignments
          backend-state))
      (=
        (be_operand.compiler-backend-frame-slots 2 assignments backend-state)
        2))))

(define (compiler-backend-callee-save-assignments1) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12"))

(define (compiler-backend-callee-save-assignments2) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r13"))

(define (compiler-backend-callee-save-assignments3) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r13 %2=%r14"))

(define (compiler-backend-callee-save-assignments4) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r13 %2=%r14 %3=%r15"))

(define (compiler-backend-callee-save-assignments5) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r13 %2=%r14 %3=%r15 %4=%rbx"))

(define (compiler-backend-win64-callee-save-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%rsi %2=%rdi"))

(define (compiler-backend-win64-callee-save-full-assignments) : regalloc.CompilerRegAssignmentTable
  (regalloc.compiler-reg-assignments-prepend
    (& (regalloc.CompilerRegAssignment 5 (Register cabi.compiler-reg-id-rsi)))
    (regalloc.compiler-reg-assignments-prepend
      (& (regalloc.CompilerRegAssignment 6 (Register cabi.compiler-reg-id-rdi)))
      (compiler-backend-callee-save-assignments5))))

(define (compiler-backend-win64-callee-save-rbp-assignments) : regalloc.CompilerRegAssignmentTable
  (regalloc.compiler-reg-assignments-prepend
    (& (regalloc.CompilerRegAssignment 7 (Register cabi.compiler-reg-id-rbp)))
    (compiler-backend-win64-callee-save-full-assignments)))

(define (compiler-backend-win64-xmm-full-assignments-at [idx : i64]) : regalloc.CompilerRegAssignmentTable
  (if (>= idx 10)
    (regalloc.compiler-reg-assignment-table-empty)
    (regalloc.compiler-reg-assignments-prepend
      (&
        (regalloc.CompilerRegAssignment
          idx
          (Register (cabi.compiler-abi-xmm-register-id (+ idx 6)))))
      (compiler-backend-win64-xmm-full-assignments-at (+ idx 1)))))

(define (compiler-backend-win64-xmm-full-assignments) : regalloc.CompilerRegAssignmentTable
  (compiler-backend-win64-xmm-full-assignments-at 0))

(define (compiler-backend-win64-xmm-sparse-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%vec6 %2=%vec15"))

(define (compiler-backend-win64-xmm15-only-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%xmm15"))

(define (compiler-backend-callee-save-double-return-blocks) : ir.CompilerIrBlockList
  (irt.blocks "entry:
       return
     alt:
       return"))

(define (compiler-backend-callee-save-pop-epilogue-ok?) : bool
  (let
    [shared-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_abi : unit (compiler-backend-set-current-fn-linux! shared-state)]
    [one : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments1)]
    [two : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments2)]
    [three : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments3)]
    [four : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments4)]
    [five : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments5)]
    [shared-name : i64 (ci.intern "pop_shared")]
    [shared : String
      (be_calls.compiler-backend-return-epilogue
        shared-state
        shared-name
        five
        1
        (compiler-backend-callee-save-double-return-blocks))]
    (and
      (be_state.backend-and8
        (string.eq
          (be_scalar.compiler-backend-emit-restore-callee-regs
            one
            3
            shared-state)
          "    movq -32(%rbp), %r12\n")
        (string.eq
          (be_scalar.compiler-backend-emit-restore-callee-regs
            two
            3
            shared-state)
          "    leaq -40(%rbp), %rsp\n    popq %r13\n    popq %r12\n")
        (string.eq
          (be_scalar.compiler-backend-emit-restore-callee-regs
            three
            2
            shared-state)
          "    leaq -40(%rbp), %rsp\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (be_scalar.compiler-backend-emit-restore-callee-regs
            four
            2
            shared-state)
          "    leaq -48(%rbp), %rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (be_scalar.compiler-backend-emit-restore-callee-regs
            five
            1
            shared-state)
          "    leaq -48(%rbp), %rsp\n    popq %rbx\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (be_scalar.compiler-backend-inline-return-tail two 3 shared-state)
          "    leaq -40(%rbp), %rsp\n    popq %r13\n    popq %r12\n    leave\n    ret\n")
        (string.eq
          (be_scalar.compiler-backend-tail-jump-tail
            four
            2
            "_tl_next"
            shared-state)
          "    leaq -48(%rbp), %rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    leave\n    jmp _tl_next\n")
        (asm-has? shared "    popq %rbx\n"))
      (asm-has? shared "    leave\n    ret\n")
      (not (string.eq shared "")))))

(define (compiler-backend-callee-save-push-prologue-rebase-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_abi : unit (compiler-backend-set-current-fn-linux! backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments3)]
    [push-regs : (__tl_dyn-array String)
      (be_peephole.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (backend.compiler-backend-fill-push-csr-regs!
        assignments
        (&mut push-regs)
        backend-state)]
    [prologue : String
      (be_scalar.compiler-backend-emit-function-entry-fpo-push
        backend-state
        "_tl_gap1_push_unit"
        64
        (owned_view.compiler-owned-shared-view push-regs)
        push-count)]
    [post-prologue : String
      "    movq %r12, -32(%rbp)
    movq %r13, -40(%rbp)
    movq %r14, -48(%rbp)
    movq -8(%rbp), %rax
    leaq -48(%rbp), %rsp
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
"]
    [rebase-result : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        post-prologue
        64
        true
        push-regs
        push-count
        3
        backend-state)]
    [rebased : String rebase-result.text]
    (and
      (= push-count 3)
      (string.eq
        prologue
        "_tl_gap1_push_unit:
    pushq %r12
    pushq %r13
    pushq %r14
    subq $64, %rsp
")
      rebase-result.ok
      (string.eq
        rebased
        "    movq 56(%rsp), %rax
    addq $64, %rsp
    popq %r14
    popq %r13
    popq %r12
    ret
")
      (asm-lacks? rebased "-32(%rbp)" "-40(%rbp)" "-48(%rbp)" "    leave\n"))))

;; BE-4: an INDEXED `(%rbp,idx,s)` operand is a pool base of an rbp-planned
;; function -- the emitter never spells a frame slot with an index -- so the
;; rsp-rebase audit steps over it and leaves it as it is while the frame slots
;; around it are rebased as before. Without the pool flag the same text is
;; refused, exactly as every other indexed form always was.
(define (compiler-backend-rsp-rebase-indexed-pool-base-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_abi : unit (compiler-backend-set-current-fn-linux! backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments3)]
    [push-regs : (__tl_dyn-array String)
      (be_peephole.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (backend.compiler-backend-fill-push-csr-regs!
        assignments
        (&mut push-regs)
        backend-state)]
    [body : String
      "    movq -8(%rbp), %rax
    movq (%rbp,%rcx,8), %rdx
    movq 16(%rbp,%rcx,8), %rsi
    movq %rsi, 8(%rbp,%rcx,4)
    leaq -48(%rbp), %rsp
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
"]
    [_pool-on : unit (regalloc.compiler-reg-set-rbp-pool-enabled! true)]
    [planned : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        (owned_view.compiler-owned-shared-view body)
        64
        true
        (owned_view.compiler-owned-shared-view push-regs)
        push-count
        3
        backend-state)]
    [_pool-off : unit (regalloc.compiler-reg-set-rbp-pool-enabled! false)]
    [framed : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        (owned_view.compiler-owned-shared-view body)
        64
        true
        push-regs
        push-count
        3
        backend-state)]
    (and
      (= push-count 3)
      planned.ok
      (string.eq
        planned.text
        "    movq 56(%rsp), %rax
    movq (%rbp,%rcx,8), %rdx
    movq 16(%rbp,%rcx,8), %rsi
    movq %rsi, 8(%rbp,%rcx,4)
    addq $64, %rsp
    popq %r14
    popq %r13
    popq %r12
    ret
")
      (not framed.ok)
      (string.eq framed.text body))))

;; GAP1 corollary: a function whose ONLY frame references were callee-save
;; slots reaches the push prologue with a DEAD slot region. `frame = 0` with an
;; odd push count makes the prologue subq vanish (S = frame + 0), and the
;; pop-run rebase line -- which points %rsp at the pushed area -- becomes
;; `addq $0`, i.e. nothing to do, so it vanishes too. The result is the shape
;; clang emits: pushes in, pops out, no stack adjustment either way.
;;
;; The paired neighbour is the SAME text with a live slot region (frame = 16):
;; both the prologue subq and the pop-run addq must come back, which is what
;; keeps the drop keyed on the amount being zero rather than on the shape.
;; ---------------------------------------------------------------------------
;; RG-1 fix B: a callee-saved register the body never names is not pushed.
;;
;; The body below saves r12/r13/r14 (slot-vars = 3, so the saved-CSR slots are
;; -32/-40/-48) and then names %r12 and %r14 and nothing else. %r13's push and
;; pop are pure cost: two instructions on every call of the function. The first
;; rebase reports what the body names; re-running it with %r13 out of the PUSH
;; set -- and the full set still classifying, so its save/restore movqs are
;; deleted exactly as before -- must drop its `popq` with its `pushq`.
(define (compiler-backend-csr-unused-save-body) : String
  "    movq %r12, -32(%rbp)
    movq %r13, -40(%rbp)
    movq %r14, -48(%rbp)
    movq -8(%rbp), %r12
    addq %r14, %r12
    movq %r12, %rax
    leaq -48(%rbp), %rsp
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
")

;; Push mode deletes every save into the callee-save band, so a squeezed
;; rebase drops 32 of its bytes: var slots move 32 bytes closer to %rsp,
;; while a bottom-of-frame slot below the band keeps its %rsp offset. With
;; slot-vars = 3 the squeezed band is -56..-32. A reference into the band
;; that is not a classified save fails the audit.
(define (compiler-backend-frame-squeeze-rebase
  [body : String]
  [frame : i64]
  [squeeze : i64]) : be_peephole.CompilerBackendRspRebaseResult
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_abi : unit (compiler-backend-set-current-fn-linux! backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments3)]
    [push-regs : (__tl_dyn-array String)
      (be_peephole.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (backend.compiler-backend-fill-push-csr-regs!
        assignments
        (&mut push-regs)
        backend-state)]
    (be_peephole.compiler-backend-rsp-rebase-full-result-squeezed
      body
      (- frame squeeze)
      true
      push-regs
      push-count
      3
      squeeze
      backend-state)))

(define (compiler-backend-frame-squeeze-body [extra : String]) : String
  (str_cat.str-cat
    "    movq %r12, -32(%rbp)
    movq %r13, -40(%rbp)
    movq %r14, -48(%rbp)
    movq -8(%rbp), %r12
    movq %r12, -72(%rbp)
"
    extra
    "    addq %r14, %r13
    movq -72(%rbp), %rax
    leaq -48(%rbp), %rsp
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
"))

(define (compiler-backend-frame-squeeze-rebase-ok?) : bool
  (let
    [plain : be_peephole.CompilerBackendRspRebaseResult
      (compiler-backend-frame-squeeze-rebase
        (compiler-backend-frame-squeeze-body "")
        96
        0)]
    [squeezed : be_peephole.CompilerBackendRspRebaseResult
      (compiler-backend-frame-squeeze-rebase
        (compiler-backend-frame-squeeze-body "")
        96
        32)]
    [band-ref : be_peephole.CompilerBackendRspRebaseResult
      (compiler-backend-frame-squeeze-rebase
        (compiler-backend-frame-squeeze-body "    movq -56(%rbp), %rax\n")
        96
        32)]
    [plain-text : String plain.text]
    [squeezed-text : String squeezed.text]
    (and
      plain.ok
      (asm-has? plain-text "    movq 88(%rsp), %r12\n")
      (asm-has? plain-text "    movq %r12, 24(%rsp)\n")
      (asm-has? plain-text "    addq $96, %rsp\n")
      squeezed.ok
      (asm-has? squeezed-text "    movq 56(%rsp), %r12\n")
      (asm-has? squeezed-text "    movq %r12, 24(%rsp)\n")
      (asm-has? squeezed-text "    movq 24(%rsp), %rax\n")
      (asm-has? squeezed-text "    addq $64, %rsp\n")
      (asm-lacks? squeezed-text "(%rbp)")
      (not band-ref.ok))))

;; The same body with %r13 named through its 32-bit spelling. A register named
;; at ANY width is used; reading only the 64-bit spellings makes this body look
;; empty of %r13 and trims a save the function needs.
(define (compiler-backend-csr-narrow-spelling-body) : String
  "    movq %r12, -32(%rbp)
    movq %r13, -40(%rbp)
    movq %r14, -48(%rbp)
    movq -8(%rbp), %r12
    addl %r13d, %r12d
    addq %r14, %r12
    movq %r12, %rax
    leaq -48(%rbp), %rsp
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
")

(define (compiler-backend-csr-trim-mask-of [body : String]) : i64
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_abi : unit (compiler-backend-set-current-fn-linux! backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments3)]
    [push-regs : (__tl_dyn-array String)
      (be_peephole.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (backend.compiler-backend-fill-push-csr-regs!
        assignments
        (&mut push-regs)
        backend-state)]
    [result : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        body
        64
        true
        push-regs
        push-count
        3
        backend-state)]
    (if result.ok
      result.csr-ref-mask
      0)))

(define (compiler-backend-csr-unused-save-trim-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_abi : unit (compiler-backend-set-current-fn-linux! backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments3)]
    [push-regs : (__tl_dyn-array String)
      (be_peephole.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (backend.compiler-backend-fill-push-csr-regs!
        assignments
        (&mut push-regs)
        backend-state)]
    [body : String (compiler-backend-csr-unused-save-body)]
    [untrimmed : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        (owned_view.compiler-owned-shared-view body)
        64
        true
        (owned_view.compiler-owned-shared-view push-regs)
        push-count
        3
        backend-state)]
    [trim-regs : (__tl_dyn-array String)
      (be_peephole.compiler-backend-csr-trimmed-push-regs
        (owned_view.compiler-owned-shared-view push-regs)
        untrimmed.csr-ref-mask
        backend-state)]
    [trim-count : i64
      (backend.compiler-backend-csr-push-reg-count
        (owned_view.compiler-owned-shared-view trim-regs))]
    [trimmed : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result-with-saves
        body
        64
        true
        (owned_view.compiler-owned-shared-view trim-regs)
        trim-count
        push-regs
        push-count
        3
        0
        backend-state)]
    [prologue : String
      (be_scalar.compiler-backend-emit-function-entry-fpo-push
        backend-state
        "_tl_rg1_trim_unit"
        64
        (owned_view.compiler-owned-shared-view trim-regs)
        trim-count)]
    [untrimmed-text : String untrimmed.text]
    [trimmed-text : String trimmed.text]
    [trimmed-slot1 : String
      (be_state.compiler-backend-global-array-element-shared-view trim-regs 1)]
    (and
      ;; The control: before the trim the pop run restores all three.
      (= push-count 3)
      untrimmed.ok
      (asm-has? untrimmed-text "    popq %r13\n")
      ;; The body names %r12 and %r14 and not %r13.
      (= trim-count 2)
      (string.eq trimmed-slot1 "")
      trimmed.ok
      ;; Neither half of the pair survives, and the register is named nowhere.
      (asm-lacks? trimmed-text "%r13")
      ;; The saves the classification set still deleted.
      (asm-lacks? trimmed-text "(%rbp)")
      (asm-has? trimmed-text "    popq %r14\n")
      (asm-has? trimmed-text "    popq %r12\n")
      ;; ALIGNMENT. The frame adjustment follows the push count: two pushes are
      ;; an even run, so the 8-byte pad comes back and the prologue's total
      ;; displacement D = 8*pushes + sub stays at D % 16 == 8 -- the offset a
      ;; returning call needs. (Three pushes paid the same 88 with sub = 64.)
      (string.eq
        prologue
        "_tl_rg1_trim_unit:
    pushq %r12
    pushq %r14
    subq $72, %rsp
")
      (= (bit-and (+ (* 8 trim-count) 72) 15) 8)
      (asm-has? trimmed-text "    addq $72, %rsp\n"))))

;; The negative: a register named only through a narrow spelling is USED, and
;; nothing is trimmed.
(define (compiler-backend-csr-narrow-spelling-keeps-save-ok?) : bool
  (let
    [wide : i64
      (compiler-backend-csr-trim-mask-of
        (compiler-backend-csr-unused-save-body))]
    [narrow : i64
      (compiler-backend-csr-trim-mask-of
        (compiler-backend-csr-narrow-spelling-body))]
    [r13-bit : i64
      (be_operand.compiler-backend-plan-reg-id-bit cabi.compiler-reg-id-r13)]
    [r12-bit : i64
      (be_operand.compiler-backend-plan-reg-id-bit cabi.compiler-reg-id-r12)]
    [r14-bit : i64
      (be_operand.compiler-backend-plan-reg-id-bit cabi.compiler-reg-id-r14)]
    (and
      (not (= (bit-and wide r12-bit) 0))
      (not (= (bit-and wide r14-bit) 0))
      (= (bit-and wide r13-bit) 0)
      (not (= (bit-and narrow r13-bit) 0)))))

(define (compiler-backend-dead-slot-region-push-body) : String
  "    movq %r12, -8(%rbp)
    movq %r13, -16(%rbp)
    movq %r14, -24(%rbp)
    movq %rdi, %rax
    leaq -24(%rbp), %rsp
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
")

(define (compiler-backend-dead-slot-region-push-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_abi : unit (compiler-backend-set-current-fn-linux! backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments3)]
    [push-regs : (__tl_dyn-array String)
      (be_peephole.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (backend.compiler-backend-fill-push-csr-regs!
        assignments
        (&mut push-regs)
        backend-state)]
    [dead-prologue : String
      (be_scalar.compiler-backend-emit-function-entry-fpo-push
        backend-state
        "_tl_qsc_dead_slots"
        0
        (owned_view.compiler-owned-shared-view push-regs)
        push-count)]
    [dead-result : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        (compiler-backend-dead-slot-region-push-body)
        0
        true
        (owned_view.compiler-owned-shared-view push-regs)
        push-count
        0
        backend-state)]
    [dead-rebased : String dead-result.text]
    [live-prologue : String
      (be_scalar.compiler-backend-emit-function-entry-fpo-push
        backend-state
        "_tl_qsc_live_slots"
        16
        (owned_view.compiler-owned-shared-view push-regs)
        push-count)]
    [live-result : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        (compiler-backend-dead-slot-region-push-body)
        16
        true
        push-regs
        push-count
        0
        backend-state)]
    [live-rebased : String live-result.text]
    (and
      (= push-count 3)
      dead-result.ok
      live-result.ok
      ;; ADMITTED: no stack adjustment in either direction.
      (string.eq
        dead-prologue
        "_tl_qsc_dead_slots:
    pushq %r12
    pushq %r13
    pushq %r14
")
      (string.eq
        dead-rebased
        "    movq %rdi, %rax
    popq %r14
    popq %r13
    popq %r12
    ret
")
      ;; REFUSED (live slot region): both adjustments stay.
      (string.eq
        live-prologue
        "_tl_qsc_live_slots:
    pushq %r12
    pushq %r13
    pushq %r14
    subq $16, %rsp
")
      (string.eq
        live-rebased
        "    movq %rdi, %rax
    addq $16, %rsp
    popq %r14
    popq %r13
    popq %r12
    ret
")
      (asm-lacks? dead-rebased "%rbp")
      (asm-lacks? dead-rebased "    leave\n"))))

(define (compiler-backend-win64-callee-save-homes-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_win : unit (compiler-backend-set-current-fn-win64! backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-win64-callee-save-assignments)]
    [full : regalloc.CompilerRegAssignmentTable
      (compiler-backend-win64-callee-save-full-assignments)]
    [save : String
      (be_scalar.compiler-backend-emit-save-callee-regs
        assignments
        3
        backend-state)]
    [restore : String
      (be_scalar.compiler-backend-emit-restore-callee-regs
        assignments
        3
        backend-state)]
    [full-restore : String
      (be_scalar.compiler-backend-emit-restore-callee-regs full 1 backend-state)]
    [ok : bool
      (and
        (be_operand.compiler-backend-plan-uses-callee-regs?
          assignments
          backend-state)
        (=
          (be_operand.compiler-backend-frame-slots 3 assignments backend-state)
          7)
        (= (be_operand.compiler-backend-frame-slots 1 full backend-state) 6)
        (string.eq save "    movq %r12, -32(%rbp)\n")
        (string.eq restore "    movq -32(%rbp), %r12\n")
        (asm-lacks? restore "popq")
        (asm-lacks? full-restore "%rsi" "%rdi")
        (string.eq
          full-restore
          "    leaq -48(%rbp), %rsp\n    popq %rbx\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n"))]
    [_linux : unit (compiler-backend-set-current-fn-linux! backend-state)]
    ok))

(define (compiler-backend-win64-fpo-seh-prologue-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_win : unit (compiler-backend-set-current-fn-win64! backend-state)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-win64-callee-save-rbp-assignments)]
    [push-regs : (__tl_dyn-array String)
      (be_peephole.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (backend.compiler-backend-fill-push-csr-regs!
        assignments
        (&mut push-regs)
        backend-state)]
    [frame : i64
      (be_facts.compiler-backend-frame-size
        (be_operand.compiler-backend-frame-slots 1 assignments backend-state))]
    [prologue : String
      (be_scalar.compiler-backend-emit-function-entry-fpo-windows
        (be_state.compiler-backend-target-policy-new
          be_state.CompilerBackendTarget.Windows)
        backend-state
        "_tl_win64_fpo"
        frame
        assignments
        1
        (owned_view.compiler-owned-shared-view push-regs)
        push-count)]
    [safe-body : String
      "    movq %r12, -16(%rbp)
    movq -8(%rbp), %rax
    leaq -56(%rbp), %rsp
    popq %rbp
    popq %rbx
    popq %r15
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
"]
    [safe-result : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        safe-body
        frame
        true
        push-regs
        push-count
        1
        backend-state)]
    [safe-rebased : String safe-result.text]
    [unsafe-result : be_peephole.CompilerBackendRspRebaseResult
      (be_peephole.compiler-backend-rsp-rebase-full-result
        "    pushq %rax
    popq %rax
    leave
    ret
"
        32
        true
        (backend.compiler-backend-test-get-compiler-backend-rsp-rebase-no-push)
        0
        1
        backend-state)]
    [unsafe-rejected : bool (not unsafe-result.ok)]
    [ok : bool
      (and
        (= push-count 6)
        (=
          (be_operand.compiler-backend-frame-slots 1 assignments backend-state)
          7)
        (let
          [text
            (be_scalar.compiler-backend-emit-save-callee-regs
              assignments
              1
              backend-state)]
          (asm-has? text "    movq %rbp, -56(%rbp)\n"))
        (= (backend.compiler-backend-string-count prologue "    pushq %") 6)
        (=
          (backend.compiler-backend-string-count prologue "    .seh_pushreg %")
          6)
        (asm-has?
          prologue
          "    pushq %rbp\n"
          "    .seh_pushreg %rbp\n"
          "    .seh_stackalloc 72\n"
          "    .seh_endprologue\n")
        (asm-lacks? prologue ".seh_setframe" "movq %rsp, %rbp" "%rsi" "%rdi")
        safe-result.ok
        (asm-lacks? safe-rebased "(%rbp)")
        (asm-has? safe-rebased "    popq %rbp\n")
        unsafe-rejected)]
    [_linux : unit (compiler-backend-set-current-fn-linux! backend-state)]
    ok))

(define (compiler-backend-win64-xmm-callee-save-homes-ok?) : bool
  (let
    [shared-name : i64 (ci.intern "xmm_shared")]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_win : unit (compiler-backend-set-current-fn-win64! backend-state)]
    ;; One group var (id 0 of three) with no exposed address: the compact
    ;; second-word map reserves one word, and the canonical pair formula for
    ;; the same id still starts at frame-slots+2. The dense rank of id 0 is 0,
    ;; the position the raw-id formula gave it.
    [_group-vars : unit
      (begin
        (be_facts.compiler-backend-current-slot-vars-set! backend-state 3)
        (be_facts.compiler-backend-group-vars-enable!
          backend-state
          (compiler_liveness.compiler-live-set1 0)
          (compiler_liveness.compiler-live-set-empty)))]
    [sparse : regalloc.CompilerRegAssignmentTable
      (compiler-backend-win64-xmm-sparse-assignments)]
    [full : regalloc.CompilerRegAssignmentTable
      (compiler-backend-win64-xmm-full-assignments)]
    [xmm15 : regalloc.CompilerRegAssignmentTable
      (compiler-backend-win64-xmm15-only-assignments)]
    [planned : regalloc.CompilerRegAssignmentTable
      (regalloc.compiler-reg-plan-assignments
        (&
          (regalloc.compiler-reg-plan-function-scalar-for-abi
            Windows
            (& (reg_tests.compiler-reg-f64-call-live-function)))))]
    [planned-frame : i64
      (be_facts.compiler-backend-frame-size
        (be_operand.compiler-backend-frame-slots 3 planned backend-state))]
    [planned-save : String
      (be_scalar.compiler-backend-emit-save-win64-xmm-callee-regs
        (be_state.CompilerBackendTarget.Windows)
        planned
        3
        planned-frame
        backend-state)]
    [frame : i64
      (be_facts.compiler-backend-frame-size
        (be_operand.compiler-backend-frame-slots 3 sparse backend-state))]
    [save : String
      (be_scalar.compiler-backend-emit-save-win64-xmm-callee-regs
        (be_state.CompilerBackendTarget.Windows)
        sparse
        3
        frame
        backend-state)]
    [restore : String
      (be_scalar.compiler-backend-emit-restore-callee-regs
        sparse
        3
        backend-state)]
    [entry : String
      (be_scalar.compiler-backend-emit-function-entry
        (be_state.compiler-backend-target-policy-new
          be_state.CompilerBackendTarget.Windows)
        "_tl_xmm_sparse"
        frame
        sparse
        3
        false
        backend-state)]
    [large-frame : i64
      (be_facts.compiler-backend-frame-size
        (be_operand.compiler-backend-frame-slots 600 xmm15 backend-state))]
    [large-entry : String
      (be_scalar.compiler-backend-emit-function-entry
        (be_state.compiler-backend-target-policy-new
          be_state.CompilerBackendTarget.Windows)
        "_tl_xmm_large"
        large-frame
        xmm15
        600
        false
        backend-state)]
    [full-frame : i64
      (be_facts.compiler-backend-frame-size
        (be_operand.compiler-backend-frame-slots 1 full backend-state))]
    [full-save : String
      (be_scalar.compiler-backend-emit-save-win64-xmm-callee-regs
        (be_state.CompilerBackendTarget.Windows)
        full
        1
        full-frame
        backend-state)]
    [full-restore : String
      (compiler-backend-emit-restore-win64-xmm-callee-regs full 1 backend-state)]
    [empty-entry : String
      (be_scalar.compiler-backend-emit-function-entry
        (be_state.compiler-backend-target-policy-new
          be_state.CompilerBackendTarget.Windows)
        "_tl_xmm_empty"
        32
        (regalloc.compiler-reg-assignment-table-empty)
        3
        false
        backend-state)]
    [inline-tail : String
      (be_scalar.compiler-backend-inline-return-tail sparse 3 backend-state)]
    [jump-tail : String
      (be_scalar.compiler-backend-tail-jump-tail
        sparse
        3
        "_tl_xmm_target"
        backend-state)]
    [shared-tail : String
      (be_calls.compiler-backend-return-epilogue
        backend-state
        shared-name
        sparse
        3
        (compiler-backend-callee-save-double-return-blocks))]
    [ok : bool
      (and
        (regalloc.compiler-reg-location-register?
          (& (regalloc.compiler-reg-assignment-lookup planned 0))
          (cabi.compiler-abi-xmm-register-id 6))
        (asm-has? planned-save "    movdqu %xmm6, ")
        (asm-lacks? planned-save "%xmm7")
        (be_operand.compiler-backend-plan-uses-callee-regs?
          sparse
          backend-state)
        (= frame 224)
        (= (be_operand.compiler-backend-frame-slots 3 sparse backend-state) 28)
        (=
          (be_scalar.compiler-backend-frame-slots-with-groups
            3
            sparse
            backend-state)
          29)
        (=
          (be_scalar.compiler-backend-frame-slots-emergency-max 3 backend-state)
          31)
        (=
          (be_scalar.compiler-backend-win64-xmm-callee-slot-offset
            backend-state
            sparse
            3
            0)
          -80)
        (=
          (be_scalar.compiler-backend-win64-xmm-callee-slot-offset
            backend-state
            sparse
            3
            9)
          -224)
        (=
          (be_operand.compiler-backend-group-word0-slot
            0
            3
            sparse
            backend-state)
          -240)
        (=
          (be_scalar.compiler-backend-group-word1-slot 0 3 sparse backend-state)
          -232)
        (string.eq
          save
          "    movdqu %xmm6, -80(%rbp)\n    .seh_savexmm %xmm6, 144\n    movdqu %xmm15, -224(%rbp)\n    .seh_savexmm %xmm15, 0\n")
        (string.eq
          restore
          "    movdqu -224(%rbp), %xmm15\n    movdqu -80(%rbp), %xmm6\n    movq -32(%rbp), %r12\n")
        (asm-has?
          entry
          "    subq $224, %rsp\n"
          save
          "    .seh_savexmm %xmm15, 0\n    .seh_endprologue\n")
        (= full-frame 208)
        (=
          (backend.compiler-backend-string-count full-save "    movdqu %xmm")
          10)
        (=
          (backend.compiler-backend-string-count
            full-save
            "    .seh_savexmm %xmm")
          10)
        (=
          (backend.compiler-backend-string-count full-restore "    movdqu ")
          10)
        (=
          (be_operand.compiler-backend-frame-slots
            3
            (regalloc.compiler-reg-assignment-table-empty)
            backend-state)
          3)
        (asm-lacks? empty-entry "movdqu" ".seh_savexmm")
        (= large-frame 5008)
        (asm-has?
          large-entry
          "    callq __chkstk\n"
          "    movdqu %xmm15, -5008(%rbp)\n    .seh_savexmm %xmm15, 0\n")
        (=
          (backend.compiler-backend-string-count
            inline-tail
            "movdqu -224(%rbp), %xmm15")
          1)
        (asm-has? inline-tail "    leave\n    ret\n")
        (=
          (backend.compiler-backend-string-count
            jump-tail
            "movdqu -224(%rbp), %xmm15")
          1)
        (asm-has? jump-tail "    leave\n    jmp _tl_xmm_target\n")
        (=
          (backend.compiler-backend-string-count
            shared-tail
            "movdqu -224(%rbp), %xmm15")
          1)
        (asm-has? shared-tail ".L_tl_xmm_shared_return:"))]
    [_linux : unit (compiler-backend-set-current-fn-linux! backend-state)]
    (and
      ok
      (=
        (be_operand.compiler-backend-win64-xmm-callee-highest
          sparse
          backend-state)
        -1)
      (= (be_operand.compiler-backend-frame-slots 3 sparse backend-state) 7)
      (string.eq
        (be_scalar.compiler-backend-emit-save-win64-xmm-callee-regs
          (be_state.CompilerBackendTarget.Linux)
          sparse
          3
          64
          backend-state)
        "")
      (string.eq
        (be_scalar.compiler-backend-emit-restore-callee-regs
          sparse
          3
          backend-state)
        "    movq -32(%rbp), %r12\n"))))

(define (compiler-backend-win64-seh-splice
  [body : String]
  [base : i64]
  [mode-prologue : String]
  [assignments : regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [frame : i64]
  [backend-state : be_state.CompilerBackendState]) : String
  (match (be_scalar.compiler-backend-windows-framed-save-splice
    body
    base
    mode-prologue
    assignments
    vars
    frame
    "_tl_seh_fixture"
    (cdiag.compiler-diagnostic-at-start "" "")
    backend-state)
    [(Ok text) text]
    [(Err _) "error"]))

;; A Windows rbp-framed prologue describes each fixed-slot GP save with
;; `.seh_savereg REG, FRAME+SLOT`, the offset from the post-allocation %rsp,
;; right after the save and before `.seh_endprologue`, and names no frame
;; register, so the unwinder measures the offset from that %rsp (#7564).
(define (compiler-backend-win64-framed-save-description-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_win : unit (compiler-backend-set-current-fn-win64! backend-state)]
    [windows : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-target-policy-new
        be_state.CompilerBackendTarget.Windows)]
    [full : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%r13 %2=%r14 %3=%r15 %4=%rbx %5=%rsi %6=%rdi")]
    [sparse : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r13 %1=%rbx")]
    [r12-only : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r12")]
    [mixed : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r12 %1=%vec6")]
    [xmm-only : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%vec6")]
    [full-frame : i64
      (be_facts.compiler-backend-frame-size
        (be_operand.compiler-backend-frame-slots 3 full backend-state))]
    [mixed-frame : i64
      (be_facts.compiler-backend-frame-size
        (be_operand.compiler-backend-frame-slots 3 mixed backend-state))]
    [large-frame : i64
      (be_facts.compiler-backend-frame-size
        (be_operand.compiler-backend-frame-slots 600 full backend-state))]
    [full-entry : String
      (be_scalar.compiler-backend-emit-function-entry
        windows
        "_tl_seh_full"
        full-frame
        full
        3
        true
        backend-state)]
    [framed-entry : String
      (be_scalar.compiler-backend-emit-function-entry
        windows
        "_tl_seh_framed"
        full-frame
        full
        3
        false
        backend-state)]
    [full-described : String
      (compiler-backend-win64-seh-splice
        (str_cat.str-cat
          (be_scalar.compiler-backend-emit-save-callee-regs
            full
            3
            backend-state)
          "    movq %rcx, %rax\n    call _tl_seh_probe\n")
        0
        ""
        full
        3
        full-frame
        backend-state)]
    [sparse-described : String
      (compiler-backend-win64-seh-splice
        "    movq %r13, 40(%rsp)\n    movq %rbx, 16(%rsp)\n    ret\n"
        0
        ""
        sparse
        3
        80
        backend-state)]
    [mode-described : String
      (compiler-backend-win64-seh-splice
        "    vzeroupper\n    movq %r13, 40(%rsp)\n    movq %rbx, 16(%rsp)\n    ret\n"
        0
        "    vzeroupper\n"
        sparse
        3
        80
        backend-state)]
    [xmm-only-described : String
      (compiler-backend-win64-seh-splice
        "    vzeroupper\n    ret\n"
        0
        "    vzeroupper\n"
        xmm-only
        3
        96
        backend-state)]
    [wrap-prefix : String
      ".L_bypass:\n    ret\n.seh_proc _tl_seh_wrap\n_tl_seh_wrap:\n    pushq %rbp\n"]
    [wrapped : String
      (compiler-backend-win64-seh-splice
        (str_cat.str-cat wrap-prefix "    movq %r12, 16(%rsp)\n    ret\n")
        (string.string-length wrap-prefix)
        ""
        r12-only
        3
        48
        backend-state)]
    [mixed-entry : String
      (be_scalar.compiler-backend-emit-function-entry
        windows
        "_tl_seh_mixed"
        mixed-frame
        mixed
        3
        true
        backend-state)]
    [mixed-described : String
      (compiler-backend-win64-seh-splice
        "    movq %r12, -32(%rbp)\n    ret\n"
        0
        ""
        mixed
        3
        mixed-frame
        backend-state)]
    [large-entry : String
      (be_scalar.compiler-backend-emit-function-entry
        windows
        "_tl_seh_large"
        large-frame
        full
        600
        true
        backend-state)]
    [large-described : String
      (compiler-backend-win64-seh-splice
        (be_scalar.compiler-backend-emit-save-callee-regs
          full
          600
          backend-state)
        0
        ""
        full
        600
        large-frame
        backend-state)]
    [far-described : String
      (compiler-backend-win64-seh-splice
        "    movq %r12, 599968(%rsp)\n"
        0
        ""
        r12-only
        3
        600000
        backend-state)]
    [ok : bool
      (and
        (= full-frame 64)
        (string.eq
          full-entry
          ".seh_proc _tl_seh_full\n_tl_seh_full:\n    pushq %rbp\n    .seh_pushreg %rbp\n    movq %rsp, %rbp\n    subq $64, %rsp\n    .seh_stackalloc 64\n")
        (asm-has?
          framed-entry
          "    .seh_setframe %rbp, 0\n"
          "    .seh_stackalloc 64\n    .seh_endprologue\n")
        (string.eq
          full-described
          "    movq %r12, -32(%rbp)\n    .seh_savereg %r12, 32\n    movq %r13, -40(%rbp)\n    .seh_savereg %r13, 24\n    movq %r14, -48(%rbp)\n    .seh_savereg %r14, 16\n    movq %r15, -56(%rbp)\n    .seh_savereg %r15, 8\n    movq %rbx, -64(%rbp)\n    .seh_savereg %rbx, 0\n    .seh_endprologue\n    movq %rcx, %rax\n    call _tl_seh_probe\n")
        (string.eq
          sparse-described
          "    movq %r13, 40(%rsp)\n    .seh_savereg %r13, 40\n    movq %rbx, 16(%rsp)\n    .seh_savereg %rbx, 16\n    .seh_endprologue\n    ret\n")
        (string.eq
          mode-described
          "    vzeroupper\n    movq %r13, 40(%rsp)\n    .seh_savereg %r13, 40\n    movq %rbx, 16(%rsp)\n    .seh_savereg %rbx, 16\n    .seh_endprologue\n    ret\n")
        (string.eq
          xmm-only-described
          "    .seh_endprologue\n    vzeroupper\n    ret\n")
        (string.eq
          wrapped
          (str_cat.str-cat
            wrap-prefix
            "    movq %r12, 16(%rsp)\n    .seh_savereg %r12, 16\n    .seh_endprologue\n    ret\n"))
        (= mixed-frame 80)
        (string.eq
          mixed-entry
          ".seh_proc _tl_seh_mixed\n_tl_seh_mixed:\n    pushq %rbp\n    .seh_pushreg %rbp\n    movq %rsp, %rbp\n    subq $80, %rsp\n    .seh_stackalloc 80\n    movdqu %xmm6, -80(%rbp)\n    .seh_savexmm %xmm6, 0\n")
        (string.eq
          mixed-described
          "    movq %r12, -32(%rbp)\n    .seh_savereg %r12, 48\n    .seh_endprologue\n    ret\n")
        (= large-frame 4848)
        (asm-has?
          large-entry
          "    movl $4848, %eax\n    callq __chkstk\n    subq %rax, %rsp\n    .seh_stackalloc 4848\n")
        (asm-lacks? large-entry ".seh_setframe" ".seh_endprologue")
        (asm-has?
          large-described
          "    movq %r12, -4808(%rbp)\n    .seh_savereg %r12, 40\n"
          "    movq %rbx, -4840(%rbp)\n    .seh_savereg %rbx, 8\n    .seh_endprologue\n")
        (string.eq
          far-described
          "    movq %r12, 599968(%rsp)\n    .seh_savereg %r12, 599968\n    .seh_endprologue\n")
        ;; Each save must be the next line, in order, at its own slot and
        ;; inside the allocation; XMM rows must stay 16-byte aligned.
        (string.eq
          (compiler-backend-win64-seh-splice
            "    movq %rbx, 16(%rsp)\n    movq %r13, 40(%rsp)\n"
            0
            ""
            sparse
            3
            80
            backend-state)
          "error")
        (string.eq
          (compiler-backend-win64-seh-splice
            "    movq %r12, -40(%rbp)\n"
            0
            ""
            r12-only
            3
            80
            backend-state)
          "error")
        (string.eq
          (compiler-backend-win64-seh-splice
            "    movq %r12, -32(%rbp)\n"
            0
            ""
            r12-only
            3
            16
            backend-state)
          "error")
        (string.eq
          (compiler-backend-win64-seh-splice
            "    movq %r12, 16(%rsp)\n"
            -1
            ""
            r12-only
            3
            48
            backend-state)
          "error")
        (string.eq
          (compiler-backend-win64-seh-splice
            "    ret\n"
            0
            ""
            xmm-only
            3
            104
            backend-state)
          "error")
        (<=
          (be_scalar.compiler-backend-windows-framed-prologue-bound 10 true 8)
          be_scalar.compiler-backend-windows-prologue-limit)
        ;; The description holds wherever %rsp is at its post-allocation value.
        (be_scalar.compiler-backend-windows-framed-rsp-exact?
          "    movq %rcx, %rax\n    call _tl_f\n    leave\n    ret\n")
        (be_scalar.compiler-backend-windows-framed-rsp-exact?
          "    pushq %r10\n    movq 720(%rsp), %r10\n    movq %r10, 416(%rsp)\n    popq %r10\n    call _tl_f\n")
        (be_scalar.compiler-backend-windows-framed-rsp-exact?
          "    leaq 416(%rsp), %rsp\n    popq %r13\n    popq %r12\n    leave\n    jmp _tl_f\n.L_next:\n    call _tl_f\n")
        (be_scalar.compiler-backend-windows-framed-rsp-exact?
          "    movq %rbp, %rsp\n    popq %rbp\n    ret\n")
        (not
          (be_scalar.compiler-backend-windows-framed-rsp-exact?
            "    pushq %r10\n    call _tl_f\n    popq %r10\n"))
        (not
          (be_scalar.compiler-backend-windows-framed-rsp-exact?
            "    pushq %r10\n    movq 8(%rax), %r10\n    popq %r10\n"))
        (not
          (be_scalar.compiler-backend-windows-framed-rsp-exact?
            "    subq $32, %rsp\n    call _tl_f\n    addq $32, %rsp\n"))
        (not
          (be_scalar.compiler-backend-windows-framed-rsp-exact?
            "    pushq %r10\n.L_x:\n    popq %r10\n"))
        (not
          (be_scalar.compiler-backend-windows-framed-rsp-exact?
            "    pushq %r10\n    jmp .L_x\n"))
        (not
          (be_scalar.compiler-backend-windows-framed-rsp-exact?
            "    andq $-16, %rsp\n"))
        (not
          (be_scalar.compiler-backend-windows-framed-rsp-exact?
            "    leave\n    call _tl_f\n")))]
    [_linux : unit (compiler-backend-set-current-fn-linux! backend-state)]
    ok))

(define (compiler-backend-peephole-register-moves-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-peephole-assignments)]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [coalesced : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %2=%r12")]
    [casted : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r12 %2=%r13")]
    (and
      (string.eq (compiler-backend-test-emit-load-var assignments 0 "%r12") "")
      (string.eq
        (be_operand.compiler-backend-emit-store-var
          assignments
          0
          "%r12"
          backend-state)
        "")
      (string.eq
        (compiler-backend-emit-load-f64-var assignments 1 "%xmm0" backend-state)
        "    movsd %xmm2, %xmm0\n")
      (string.eq
        (compiler-backend-emit-store-f64-var
          assignments
          1
          "%xmm0"
          backend-state)
        "    movsd %xmm0, %xmm2\n")
      (match (be_calls.compiler-backend-emit-mov
        (ast.ast-node-pool-reader-type-segment-bases)
        coalesced
        2
        (Var 0)
        (I64)
        (compiler-backend-program-index-build
          (ast.ast-node-pool-reader-type-segment-bases)
          (ir.compiler-ir-function-seq-empty)
          (ir.compiler-ir-extern-seq-empty))
        8
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm) (string.eq asm "")]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-cast
        (ast.ast-node-pool-reader-type-segment-bases)
        "_tl_test"
        (ir.compiler-ir-label "entry")
        coalesced
        2
        (Var 0)
        (I64)
        (I64)
        (compiler-backend-program-index-build
          (ast.ast-node-pool-reader-type-segment-bases)
          (ir.compiler-ir-function-seq-empty)
          (ir.compiler-ir-extern-seq-empty))
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm) (string.eq asm "")]
        [(Err _) false])
      ;; P22: a same-width signedness Cast is a value-identical copy, so a
      ;; coalesced pair (one home for both endpoints) must emit NOTHING. The
      ;; identical-type early return above cannot answer this one -- I64 and
      ;; U64 are different types -- so the elision has to come from the
      ;; same-width arm loading the source into its own home.
      (match (be_scalar.compiler-backend-emit-cast
        (ast.ast-node-pool-reader-type-segment-bases)
        "_tl_test"
        (ir.compiler-ir-label "entry")
        coalesced
        2
        (Var 0)
        (I64)
        (U64)
        (compiler-backend-program-index-build
          (ast.ast-node-pool-reader-type-segment-bases)
          (ir.compiler-ir-function-seq-empty)
          (ir.compiler-ir-extern-seq-empty))
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm) (string.eq asm "")]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-cast
        (ast.ast-node-pool-reader-type-segment-bases)
        "_tl_test"
        (ir.compiler-ir-label "entry")
        coalesced
        2
        (Var 0)
        (U64)
        (I64)
        (compiler-backend-program-index-build
          (ast.ast-node-pool-reader-type-segment-bases)
          (ir.compiler-ir-function-seq-empty)
          (ir.compiler-ir-extern-seq-empty))
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm) (string.eq asm "")]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-cast
        (ast.ast-node-pool-reader-type-segment-bases)
        "_tl_test"
        (ir.compiler-ir-label "entry")
        casted
        2
        (Var 0)
        (I64)
        (U64)
        (compiler-backend-program-index-build
          (ast.ast-node-pool-reader-type-segment-bases)
          (ir.compiler-ir-function-seq-empty)
          (ir.compiler-ir-extern-seq-empty))
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm) (string.eq asm "    movq %r12, %r13\n")]
        [(Err _) false])
      (match (be_scalar.compiler-backend-emit-cast
        (ast.ast-node-pool-reader-type-segment-bases)
        "_tl_test"
        (ir.compiler-ir-label "entry")
        casted
        2
        (Var 0)
        (I32)
        (I64)
        (compiler-backend-program-index-build
          (ast.ast-node-pool-reader-type-segment-bases)
          (ir.compiler-ir-function-seq-empty)
          (ir.compiler-ir-extern-seq-empty))
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok asm)
          (and
            (string.eq asm "    movslq %r12d, %r13\n")
            (asm-lacks? asm "%rax"))]
        [(Err _) false]))))

(define (compiler-backend-direct-immediate-mov-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r12")]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState index.backend-state]
    (and
      (match (be_calls.compiler-backend-emit-mov
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        0
        (I64 0)
        (I64)
        index
        8
        backend-state)
        [(Ok asm) (string.eq asm "    xorl %r12d, %r12d\n")]
        [(Err _) false])
      (match (be_calls.compiler-backend-emit-mov
        (ast.ast-node-pool-reader-type-segment-bases)
        (regalloc.compiler-reg-assignment-table-empty)
        1
        (I64 7)
        (I64)
        index
        8
        backend-state)
        [(Ok asm) (string.eq asm "    movq $7, -16(%rbp)\n")]
        [(Err _) false]))))

;; Staging through a scavenged scratch is what a MEMORY-to-memory move needs,
;; and it is all it is for: the source is spilled, so the value has to be in a
;; register before it can be stored, and that register comes from the scavenger
;; and is never %rax. A register-homed source does NOT take this path -- see
;; compiler-backend-mov-register-to-slot-ok?.
(define (compiler-backend-mov-scratch-staging-ok?) : bool
  (let
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [int-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=spill:-24")]
    [float-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%xmm3")]
    (and
      (asm-ok?
        (be_calls.compiler-backend-emit-mov
          (ast.ast-node-pool-reader-type-segment-bases)
          int-assignments
          1
          (Var 0)
          (I64)
          index
          2
          index.backend-state)
        (has "    movq -24(%rbp), %r8\n" "    movq %r8, -16(%rbp)\n")
        (lacks "%rax"))
      (asm-ok?
        (be_calls.compiler-backend-emit-mov
          (ast.ast-node-pool-reader-type-segment-bases)
          float-assignments
          1
          (Var 0)
          (F64)
          index
          2
          index.backend-state)
        (has "    movsd %xmm3, %xmm2\n" "    movsd %xmm2, -16(%rbp)\n")
        (lacks "%xmm0")))))

;; P7b: a Mov from a REGISTER-homed value to a MEMORY-homed one is a single
;; store. x86 stores a register into a frame slot in one instruction, so routing
;; the move through a scratch (`movq %r12, %r8 ; movq %r8, -16(%rbp)`) spends an
;; instruction to reach the same state. The P3/P7 call-hole carriers are made of
;; exactly this Mov -- the carrier is forced to a frame slot by construction --
;; so every crossing the rewrite inserts would pay for it.
;;
;; Both memory destinations are covered: a var the plan spilled, and a var it
;; never assigned at all (the bare slot). The narrow type pins the width claim
;; the register-destination fast path already relies on -- a var's register home
;; holds the normalized 64-bit value, so the copy needs no per-type narrowing.
;; No scratch appears in the output: this arm asks the scavenger for nothing.
(define (compiler-backend-mov-register-to-slot-ok?) : bool
  (let
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [slot-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12")]
    [spill-assignments : regalloc.CompilerRegAssignmentTable
      (regalloc.compiler-reg-assignments-prepend
        (& (regalloc.CompilerRegAssignment 1 (Spill -40)))
        slot-assignments)]
    (and
      ;; unassigned destination -> its bare slot, one store
      (match (be_calls.compiler-backend-emit-mov
        (ast.ast-node-pool-reader-type-segment-bases)
        slot-assignments
        1
        (Var 0)
        (I64)
        index
        2
        index.backend-state)
        [(Ok asm) (string.eq asm "    movq %r12, -16(%rbp)\n")]
        [(Err _) false])
      ;; spilled destination -> its frame offset, one store
      (match (be_calls.compiler-backend-emit-mov
        (ast.ast-node-pool-reader-type-segment-bases)
        spill-assignments
        1
        (Var 0)
        (I64)
        index
        2
        index.backend-state)
        [(Ok asm) (string.eq asm "    movq %r12, -40(%rbp)\n")]
        [(Err _) false])
      ;; a narrow type changes nothing: no narrowing, no scratch
      (match (be_calls.compiler-backend-emit-mov
        (ast.ast-node-pool-reader-type-segment-bases)
        spill-assignments
        1
        (Var 0)
        (I32)
        index
        2
        index.backend-state)
        [(Ok asm) (string.eq asm "    movq %r12, -40(%rbp)\n")]
        [(Err _) false]))))

(define (compiler-backend-register-group-test-type) : ast.AstType
  (Struct (ci.intern "BackendGroupTest")))

;; Packet-2 transport contracts: encoded names must be exact, signature-only
;; groups must seed their physical metadata, and private MEMORY calls/params
;; must copy bytes/address objects rather than loading word zero.
(define (compiler-backend-private-abi-decoding-ok?) : bool
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [group0 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m0__g0"))]
    [group1 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m1__g1"))]
    [group2 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m2__g2"))]
    [group3 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m3__g3"))]
    [bad-group : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m4__bad"))]
    [double-mask-group : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m01__bad"))]
    [empty-group-key : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m0__"))]
    [memory24 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_s24__m24"))]
    [memory9 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_s9__m9"))]
    [bad-memory : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_s0__bad"))]
    [overflow-memory : ast.AstType
      (Struct
        (ir.compiler-ir-symbol
          "__tl_internal_abi_mem_s9223372036854775808__overflow"))]
    [ordinary : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_s24_bad"))]
    [empty-memory-key : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_s24__"))]
    [nondigit-memory : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_sx__bad"))]
    [negative-memory : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_s-1__bad"))]
    [source-group-name : String "__tl_internal_abi_group_m2__source_collision"]
    [source-memory-name : String "__tl_internal_abi_mem_s24__source_collision"]
    [source-group : ast.AstType
      (Struct
        (ci.intern (owned_view.compiler-owned-shared-view source-group-name)))]
    [source-memory : ast.AstType
      (Struct
        (ci.intern (owned_view.compiler-owned-shared-view source-memory-name)))]
    (and
      (= (ir.compiler-ir-representation-abi-group-mask bases (& group0)) 0)
      (= (ir.compiler-ir-representation-abi-group-mask bases (& group1)) 1)
      (= (ir.compiler-ir-representation-abi-group-mask bases (& group2)) 2)
      (= (ir.compiler-ir-representation-abi-group-mask bases (& group3)) 3)
      (= (ir.compiler-ir-representation-abi-group-mask bases (& bad-group)) -1)
      (=
        (ir.compiler-ir-representation-abi-group-mask
          bases
          (& double-mask-group))
        -1)
      (=
        (ir.compiler-ir-representation-abi-group-mask bases (& empty-group-key))
        -1)
      (= (be_facts.compiler-backend-abi-memory-size bases memory24) 24)
      (= (be_facts.compiler-backend-abi-memory-size bases memory9) 9)
      (= (be_facts.compiler-backend-abi-memory-size bases bad-memory) 0)
      (= (be_facts.compiler-backend-abi-memory-size bases overflow-memory) 0)
      (= (be_facts.compiler-backend-abi-memory-size bases ordinary) 0)
      (= (be_facts.compiler-backend-abi-memory-size bases empty-memory-key) 0)
      (= (be_facts.compiler-backend-abi-memory-size bases nondigit-memory) 0)
      (= (be_facts.compiler-backend-abi-memory-size bases negative-memory) 0)
      (=
        (ir.compiler-ir-representation-abi-group-mask bases (& source-group))
        -1)
      (=
        (be_facts.compiler-backend-abi-memory-size
          bases
          (owned_view.compiler-owned-shared-view source-memory))
        0)
      (not
        (reg_tests.compiler-reg-private-memory-type?
          bases
          (owned_view.compiler-owned-shared-view source-memory)))
      (string.eq
        (be_facts.compiler-backend-aggregate-type-name bases source-group)
        source-group-name)
      (string.eq
        (be_facts.compiler-backend-aggregate-type-name bases source-memory)
        source-memory-name))))

(define (compiler-backend-ir-owned-private-abi-ok?) : bool
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [group0-name : String "__tl_internal_abi_group_m0__ir_owned_6219_group0"]
    [group2-name : String "__tl_internal_abi_group_m2__ir_owned_6219_group2"]
    [memory24-name : String "__tl_internal_abi_mem_s24__ir_owned_6219_memory24"]
    [group0-id : i64
      (ir.compiler-ir-symbol
        (owned_view.compiler-owned-shared-view group0-name))]
    [group2-id : i64
      (ir.compiler-ir-symbol
        (owned_view.compiler-owned-shared-view group2-name))]
    [memory24-id : i64
      (ir.compiler-ir-symbol
        (owned_view.compiler-owned-shared-view memory24-name))]
    [group0 : ast.AstType (Struct group0-id)]
    [group2 : ast.AstType (Struct group2-id)]
    [memory24 : ast.AstType (Struct memory24-id)]
    [ordinary-id : i64 (ci.intern "Issue6219OrdinaryFallback")]
    [composite-id : i64
      (ci.intern-composite-pair-id
        (ci.intern "Issue6219CompositeLeft")
        (ci.intern "Issue6219CompositeRight"))]
    [ordinary : ast.AstType (Struct ordinary-id)]
    [composite : ast.AstType (Struct composite-id)]
    [words0 : ir.CompilerIrValueSeq
      (ir.compiler-ir-value-seq-prepend
        (& (I64 1))
        (&
          (ir.compiler-ir-value-seq-prepend
            (& (I64 2))
            (& (ir.compiler-ir-value-seq-empty)))))]
    [words2 : ir.CompilerIrValueSeq
      (ir.compiler-ir-value-seq-prepend
        (& (I64 3))
        (&
          (ir.compiler-ir-value-seq-prepend
            (& (F64 (compiler-backend-test-f64-bits "2.5")))
            (& (ir.compiler-ir-value-seq-empty)))))]
    [instrs : ir.CompilerIrInstrSeq
      (compiler-backend-test-instr-seq-prepend
        (Pack 0 words0 (owned_view.compiler-owned-shared-view group0))
        (compiler-backend-test-instr-seq-prepend
          (Pack 1 words2 (owned_view.compiler-owned-shared-view group2))
          (ir.compiler-ir-instr-seq-empty)))]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") instrs))]
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (&
          (Function
            (ir.compiler-ir-symbol "__tl_internal_abi_ir_owned_6219_fixture")
            (ir.compiler-ir-param-seq-empty)
            (I64)
            2
            blocks
            Ordinary))
        (& (ir.compiler-ir-function-seq-empty)))]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        bases
        functions
        (ir.compiler-ir-extern-seq-empty))]
    (and
      (ir.compiler-ir-symbol-owned? group0-id)
      (ir.compiler-ir-symbol-owned? group2-id)
      (ir.compiler-ir-symbol-owned? memory24-id)
      (not (= group0-id group2-id))
      (string.eq
        (be_facts.compiler-backend-aggregate-type-name
          bases
          (owned_view.compiler-owned-shared-view group0))
        group0-name)
      (string.eq
        (be_facts.compiler-backend-aggregate-type-name
          bases
          (owned_view.compiler-owned-shared-view group2))
        group2-name)
      (string.eq
        (be_facts.compiler-backend-aggregate-type-name
          bases
          (owned_view.compiler-owned-shared-view memory24))
        memory24-name)
      (= (ir.compiler-ir-representation-abi-group-mask bases (& group0)) 0)
      (= (ir.compiler-ir-representation-abi-group-mask bases (& group2)) 2)
      (=
        (be_facts.compiler-backend-abi-memory-size
          bases
          (owned_view.compiler-owned-shared-view memory24))
        24)
      (be_facts.compiler-backend-group-type? bases index group0)
      (be_facts.compiler-backend-group-type? bases index group2)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view group0))
        2)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view group2))
        2)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view group0))
        0)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view group2))
        2)
      (reg_tests.compiler-reg-private-memory-type? bases memory24)
      (match (ast.ast-aggregate-type-key bases (& group0))
        [(Some key) (= key group0-id)]
        [(None) false])
      (match (ast.ast-aggregate-type-key bases (& group2))
        [(Some key) (= key group2-id)]
        [(None) false])
      (string.eq
        (be_facts.compiler-backend-aggregate-type-name bases ordinary)
        "Issue6219OrdinaryFallback")
      (string.eq
        (be_facts.compiler-backend-aggregate-type-name
          bases
          (owned_view.compiler-owned-shared-view composite))
        "Issue6219CompositeLeft/Issue6219CompositeRight")
      (match (ast.ast-aggregate-type-key bases (& composite))
        [(Some key) (= key composite-id)]
        [(None) false]))))

(define (compiler-backend-private-abi-signature-seeding-ok?) : bool
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [type0 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m0__sig0"))]
    [type1 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m1__sig1"))]
    [type2 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m2__sig2"))]
    [type3 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_group_m3__sig3"))]
    [params : ir.CompilerIrParamSeq
      (ir.compiler-ir-param-seq-prepend
        (Param "p0" (owned_view.compiler-owned-shared-view type0) 0)
        (ir.compiler-ir-param-seq-prepend
          (Param "p1" (owned_view.compiler-owned-shared-view type1) 1)
          (ir.compiler-ir-param-seq-prepend
            (Param "p2" (owned_view.compiler-owned-shared-view type2) 2)
            (ir.compiler-ir-param-seq-prepend
              (Param "p3" (owned_view.compiler-owned-shared-view type3) 3)
              (ir.compiler-ir-param-seq-empty)))))]
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (&
          (Function
            (ci.intern "private_group_signature")
            params
            (owned_view.compiler-owned-shared-view type3)
            4
            (ir.compiler-ir-block-list-empty)
            Ordinary))
        (& (ir.compiler-ir-function-seq-empty)))]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        bases
        functions
        (ir.compiler-ir-extern-seq-empty))]
    (and
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view type0))
        2)
      (= (be_facts.compiler-backend-group-word-class-mask bases index type0) 0)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view type1))
        1)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view type2))
        2)
      (= (be_facts.compiler-backend-group-word-class-mask bases index type3) 3)
      (be_facts.compiler-backend-group-word-sse? bases index type1 0)
      (not (be_facts.compiler-backend-group-word-sse? bases index type1 1))
      (not (be_facts.compiler-backend-group-word-sse? bases index type2 0))
      (be_facts.compiler-backend-group-word-sse? bases index type2 1))))

(define (compiler-backend-private-memory-transport-ok?) : bool
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [memory24 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_s24__transport"))]
    [memory9 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_s9__transport"))]
    [memory11 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_s11__transport"))]
    [types : ast.AstTypeList
      (ast.ast-type-cons (& memory24) (& (ast.ast-type-list-new)))]
    [types9 : ast.AstTypeList
      (ast.ast-type-cons (& memory9) (& (ast.ast-type-list-new)))]
    [types11 : ast.AstTypeList
      (ast.ast-type-cons (& memory11) (& (ast.ast-type-list-new)))]
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r12")]
    [diag : cdiag.CompilerDiagnostic (cdiag.compiler-diagnostic-at-start "" "")]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        bases
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [memory40 : ast.AstType
      (Struct (ir.compiler-ir-symbol "__tl_internal_abi_mem_s40__indirect"))]
    [source-array40 : ast.AstType (ast.ast-ty-array (& (U8)) 40)]
    [closure-type : ast.AstType
      (ast.ast-ty-func
        (ast.ast-type-cons (& source-array40) (& (ast.ast-type-list-new)))
        (& (I64)))]
    [dynamic-types : regalloc.CompilerRegVarTypes
      (regalloc.compiler-reg-var-types-insert
        (regalloc.compiler-reg-var-types-insert
          (regalloc.compiler-reg-var-types-empty)
          0
          memory40)
        2
        closure-type)]
    [dynamic-args : ir.CompilerIrCallArgs (One (Var 0))]
    [dynamic-instr : ir.CompilerIrInstr
      (CallIndirect
        3
        (Var 2)
        (owned_view.compiler-owned-shared-view dynamic-args)
        (I64))]
    [no-functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-empty)]
    [no-externs : ir.CompilerIrExternSeq (ir.compiler-ir-extern-seq-empty)]
    [effective-dynamic-types : ast.AstTypeList
      (backend.compiler-backend-effective-normal-indirect-param-types
        bases
        dynamic-types
        (Var 2)
        dynamic-args
        no-functions
        no-externs
        index)]
    [effective-dynamic-type : ast.AstType
      (ast.ast-type-segment-bases-get
        bases
        (ast.ast-type-list-get
          (& effective-dynamic-types)
          0
          (ast.ast-type-id-fallback)))]
    [dynamic-outgoing-space : i64
      (be_calls.compiler-backend-instr-outgoing-stack-space
        bases
        be_state.CompilerBackendTarget.Linux
        dynamic-instr
        dynamic-types
        (be_state.CompilerBackendGlobalTypeTable.Empty)
        index)]
    [stack-count : i64
      (be_calls.compiler-backend-call-stack-arg-count
        bases
        be_state.CompilerBackendTarget.Linux
        (Platform)
        (One (Var 0))
        types
        false
        0
        0
        0
        0
        0
        index)]
    [asm : be_state.ResultCompilerBackend
      (be_calls.compiler-backend-emit-call-args
        bases
        be_state.CompilerBackendTarget.Linux
        (Platform)
        assignments
        (One (Var 0))
        types
        false
        0
        0
        0
        0
        0
        diag
        index
        1
        index.backend-state)]
    [asm-text : String
      (match asm
        [(Ok text) text]
        [(Err _) ""])]
    [stack-count9 : i64
      (be_calls.compiler-backend-call-stack-arg-count
        bases
        be_state.CompilerBackendTarget.Linux
        (Platform)
        (One (Var 0))
        types9
        false
        0
        0
        0
        0
        0
        index)]
    [asm9 : be_state.ResultCompilerBackend
      (be_calls.compiler-backend-emit-call-args
        bases
        be_state.CompilerBackendTarget.Linux
        (Platform)
        assignments
        (One (Var 0))
        types9
        false
        0
        0
        0
        0
        0
        diag
        index
        1
        index.backend-state)]
    [asm9-text : String
      (match asm9
        [(Ok text) text]
        [(Err _) ""])]
    [stack-count11 : i64
      (be_calls.compiler-backend-call-stack-arg-count
        bases
        be_state.CompilerBackendTarget.Linux
        (Platform)
        (One (Var 0))
        types11
        false
        0
        0
        0
        0
        0
        index)]
    [asm11 : be_state.ResultCompilerBackend
      (be_calls.compiler-backend-emit-call-args
        bases
        be_state.CompilerBackendTarget.Linux
        (Platform)
        assignments
        (One (Var 0))
        types11
        false
        0
        0
        0
        0
        0
        diag
        index
        1
        index.backend-state)]
    [asm11-text : String
      (match asm11
        [(Ok text) text]
        [(Err _) ""])]
    [param-types : ir.CompilerIrParamSeq
      (ir.compiler-ir-param-seq-prepend
        (Param "mem" memory24 0)
        (ir.compiler-ir-param-seq-prepend
          (Param "scalar" (I64) 1)
          (ir.compiler-ir-param-seq-empty)))]
    [param-assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=%r13")]
    [params-asm : be_state.ResultCompilerBackend
      (backend.compiler-backend-emit-param-spills
        bases
        be_state.CompilerBackendTarget.Linux
        param-assignments
        param-types
        0
        0
        0
        0
        index
        2
        index.backend-state)]
    [param-text : String
      (match params-asm
        [(Ok text) text]
        [(Err _) ""])]
    (and
      (= (ast.ast-type-list-len (& effective-dynamic-types)) 1)
      (=
        (be_facts.compiler-backend-abi-memory-size
          bases
          (owned_view.compiler-owned-shared-view effective-dynamic-type))
        40)
      (string.eq
        (be_facts.compiler-backend-aggregate-type-name
          bases
          effective-dynamic-type)
        "__tl_internal_abi_mem_s40__indirect")
      (>= dynamic-outgoing-space 40)
      (= (% dynamic-outgoing-space 16) 0)
      (= stack-count 3)
      (= stack-count9 2)
      (= stack-count11 2)
      (asm-has?
        asm-text
        "    movq %r12, %r10\n"
        "    movups (%r10), %xmm2\n"
        "    movups %xmm2, 0(%rsp)\n"
        "    movq 16(%r10), %xmm2\n"
        "    movq %xmm2, 16(%rsp)\n")
      (asm-has?
        asm9-text
        "    movb 8(%r10), %r10b\n"
        "    movb %r10b, 8(%rsp)\n")
      (asm-lacks? asm9-text "    movd 8(%r10)," "    movd %xmm2, 8(%rsp)")
      (asm-has?
        asm11-text
        "    movq %r12, %r10\n"
        "    movw 8(%r10), %r10w\n"
        "    movw %r10w, 8(%rsp)\n"
        "    movq %r10, %xmm2\n"
        "    movq %xmm2, %r10\n"
        "    movb 10(%r10), %r10b\n"
        "    movb %r10b, 10(%rsp)\n")
      (asm-lacks? asm11-text "    movd 8(%r10)," "    movd 10(%r10),")
      (asm-has? param-text "    movq %rdi, %r13\n" "    leaq 16(%rbp), %r12\n")
      (asm-lacks? param-text "movq 16(%rbp),"))))

;; Region- and Invalidate-wrapped scalars keep their inner type's signedness
;; in every backend classifier (#9688). Source cannot spell an Invalidate
;; scalar (SPEC 3.3), so the private pool below builds both wrappers directly,
;; including a nested Region.
(define (compiler-backend-wrapped-scalar-signedness-ok?) : bool
  (let
    [pools : ast.AstNodePoolContext
      (ast.ast-node-pool-context-new-with-capacities 4 16)]
    [u8-id : i64 (ast.ast-node-pool-context-type-push pools (U8))]
    [u16-id : i64 (ast.ast-node-pool-context-type-push pools (U16))]
    [u32-id : i64 (ast.ast-node-pool-context-type-push pools (U32))]
    [u64-id : i64 (ast.ast-node-pool-context-type-push pools (U64))]
    [i8-id : i64 (ast.ast-node-pool-context-type-push pools (I8))]
    [i16-id : i64 (ast.ast-node-pool-context-type-push pools (I16))]
    [i64-id : i64 (ast.ast-node-pool-context-type-push pools (I64))]
    [region-u32-id : i64
      (ast.ast-node-pool-context-type-push pools (Region 3 u32-id))]
    [region-u64 : ast.AstType (Region 3 u64-id)]
    [region-region-u32 : ast.AstType (Region 4 region-u32-id)]
    [region-i64 : ast.AstType (Region 3 i64-id)]
    [region-i8 : ast.AstType (Region 3 i8-id)]
    [invalidate-u8 : ast.AstType (ast.ast-ty-invalidate-id 5 u8-id)]
    [invalidate-u16 : ast.AstType (ast.ast-ty-invalidate-id 5 u16-id)]
    [invalidate-i16 : ast.AstType (ast.ast-ty-invalidate-id 5 i16-id)]
    [invalidate-i8 : ast.AstType (ast.ast-ty-invalidate-id 5 i8-id)]
    [invalidate-u8-copy : ast.AstType (ast.ast-ty-invalidate-id 5 u8-id)]
    [bases : i64 (ast.ast-node-pool-context-type-segment-bases pools)]
    [lt-op-1 : ir.CompilerIrBinOp (ir.CompilerIrBinOp.Lt)]
    [gt-op-2 : ir.CompilerIrBinOp (ir.CompilerIrBinOp.Gt)]
    [lt-op-3 : ir.CompilerIrBinOp (ir.CompilerIrBinOp.Lt)]
    [ge-op-4 : ir.CompilerIrBinOp (ir.CompilerIrBinOp.Ge)]
    [le-op-5 : ir.CompilerIrBinOp (ir.CompilerIrBinOp.Le)]
    (and
      (be_operand.compiler-backend-unsigned-rel-ty? bases region-u64)
      (be_operand.compiler-backend-unsigned-rel-ty? bases region-region-u32)
      (be_operand.compiler-backend-unsigned-rel-ty? bases invalidate-u8)
      (not (be_operand.compiler-backend-unsigned-rel-ty? bases region-i64))
      (not (be_operand.compiler-backend-unsigned-rel-ty? bases invalidate-i16))
      (be_facts.compiler-backend-type-signed? bases region-i64)
      (be_facts.compiler-backend-type-signed? bases invalidate-i16)
      (not (be_facts.compiler-backend-type-signed? bases region-u64))
      (not (be_facts.compiler-backend-type-signed? bases invalidate-u8))
      (=
        (be_scalar.compiler-backend-normalized-signed-immediate
          bases
          255
          region-i8)
        -1)
      (=
        (be_scalar.compiler-backend-normalized-signed-immediate
          bases
          255
          invalidate-i8)
        -1)
      (=
        (be_scalar.compiler-backend-normalized-unsigned-immediate
          bases
          -1
          invalidate-u16)
        (cast 65535 : u64))
      (=
        (be_scalar.compiler-backend-normalized-unsigned-immediate
          bases
          -1
          invalidate-u8-copy)
        (cast 255 : u64))
      (string.eq
        (be_scalar.compiler-backend-compare-true-jcc
          bases
          lt-op-1
          invalidate-u8)
        "jb")
      (string.eq
        (be_scalar.compiler-backend-compare-false-jcc bases gt-op-2 region-u64)
        "jbe")
      (string.eq
        (be_scalar.compiler-backend-compare-true-jcc bases lt-op-3 region-i64)
        "jl")
      (string.eq
        (be_scalar.compiler-backend-compare-setcc
          bases
          ge-op-4
          (owned_view.compiler-owned-shared-view region-region-u32))
        "setae")
      (string.eq
        (be_operand.compiler-backend-compare-cmov
          bases
          le-op-5
          (owned_view.compiler-owned-shared-view invalidate-u16))
        "cmovbe")
      ;; The direct-object compare classifies through the same wrappers, and
      ;; compares at the wrapped width (#9713).
      (=
        (be_object.compiler-backend-object-compare-cc
          bases
          (& (ir.CompilerIrBinOp.Lt))
          invalidate-u8)
        0x2)
      (=
        (be_object.compiler-backend-object-compare-cc
          bases
          (& (ir.CompilerIrBinOp.Gt))
          region-u64)
        0x7)
      (=
        (be_object.compiler-backend-object-compare-cc
          bases
          (& (ir.CompilerIrBinOp.Lt))
          region-i64)
        0xc)
      (=
        (be_object.compiler-backend-object-compare-cc
          bases
          (& (ir.CompilerIrBinOp.Ge))
          region-region-u32)
        0x3)
      (string.eq
        (be_object.compiler-backend-object-binop-bytes
          bases
          (& (ir.CompilerIrBinOp.Lt))
          invalidate-u8)
        (object_target.compiler-backend-object-bytes-from-hex
          "4438c00f92c0480fb6c0"))
      (string.eq
        (be_object.compiler-backend-object-zero-compare-bytes
          bases
          (& (ir.CompilerIrBinOp.Le))
          invalidate-u16)
        (object_target.compiler-backend-object-bytes-from-hex
          "6685c00f96c0480fb6c0"))
      (string.eq
        (be_object.compiler-backend-object-binop-bytes
          bases
          (& (ir.CompilerIrBinOp.Gt))
          region-u64)
        (object_target.compiler-backend-object-bytes-from-hex
          "4c39c00f97c0480fb6c0"))
      (string.eq
        (be_object.compiler-backend-object-binop-bytes
          bases
          (& (ir.CompilerIrBinOp.Ge))
          region-region-u32)
        (object_target.compiler-backend-object-bytes-from-hex
          "4439c00f93c0480fb6c0")))))

(test
  backend-wrapped-scalars-keep-inner-signedness
  (unless
    (compiler-backend-wrapped-scalar-signedness-ok?)
    (io.panic "a Region/Invalidate-wrapped scalar lost its inner signedness")))

;; Structural borrowed-slice ABI classification must not depend on a nominal
;; aggregate map entry.  The private type pool below has no Pack-producing
;; function, so the empty program index exercises the structural short-circuit
;; in both the backend and register allocator classifiers.
(define (compiler-backend-slice-reference-abi-classifiers-ok?) : bool
  (let
    [pools : ast.AstNodePoolContext
      (ast.ast-node-pool-context-new-with-capacities 4 16)]
    [elem-id : i64 (ast.ast-node-pool-context-type-push pools (I64))]
    [slice-id : i64 (ast.ast-node-pool-context-type-push pools (Slice elem-id))]
    [region-slice-id : i64
      (ast.ast-node-pool-context-type-push pools (Region 9 slice-id))]
    [ordinary-id : i64 (ast.ast-node-pool-context-type-push pools (I64))]
    [ref : ast.AstType (Ref 1 slice-id)]
    [mut-ref : ast.AstType (MutRef 1 region-slice-id)]
    [ordinary-ref : ast.AstType (Ref 1 ordinary-id)]
    [bare-slice : ast.AstType (Slice elem-id)]
    [bases : i64 (ast.ast-node-pool-context-type-segment-bases pools)]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        bases
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    (and
      (= (be_operand.compiler-backend-type-size bases ref) 16)
      (= (be_operand.compiler-backend-type-size bases mut-ref) 16)
      (= (be_operand.compiler-backend-type-size bases ordinary-ref) 8)
      (= (be_operand.compiler-backend-type-size bases bare-slice) 0)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view ref))
        2)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view mut-ref))
        2)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view ordinary-ref))
        1)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view bare-slice))
        1)
      (be_facts.compiler-backend-group-type? bases index ref)
      (be_facts.compiler-backend-group-type? bases index mut-ref)
      (not (be_facts.compiler-backend-group-type? bases index ordinary-ref))
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view ref))
        0)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view mut-ref))
        0)
      (regalloc.compiler-reg-type-register-group?
        bases
        (& (be_state.compiler-backend-program-index-representations index))
        (& ref))
      (regalloc.compiler-reg-type-register-group?
        bases
        (& (be_state.compiler-backend-program-index-representations index))
        (& mut-ref))
      (not
        (regalloc.compiler-reg-type-register-group?
          bases
          (& (be_state.compiler-backend-program-index-representations index))
          (& ordinary-ref)))
      (not
        (regalloc.compiler-reg-type-register-group?
          bases
          (& (be_state.compiler-backend-program-index-representations index))
          (& bare-slice)))
      (not
        (regalloc.compiler-reg-type-register-group-has-sse?
          bases
          (& (be_state.compiler-backend-program-index-representations index))
          (& ref)))
      (not
        (reg_tests.compiler-reg-type-register-group-word-sse?
          bases
          (be_state.compiler-backend-program-index-representations index)
          (owned_view.compiler-owned-shared-view ref)
          0))
      (not
        (reg_tests.compiler-reg-type-register-group-word-sse?
          bases
          (be_state.compiler-backend-program-index-representations index)
          ref
          1)))))

;; Arena's optional checker brand is a phantom nominal argument. Pin the
;; backend's bare and branded nominal arms to the same one-word ABI.
(define (compiler-backend-branded-arena-abi-ok?) : bool
  (let
    [lifetimes : ast.AstLifetimeList (ast.ast-lifetime-list-new)]
    (ast.ast-lifetime-list-push
      (&mut lifetimes)
      (ci.intern-generated-canonical-name "arena-brand/test#1"))
    (and
      (=
        (let
          [ty (ast.AstType.Struct cbi.compiler-builtin-id-arena-type)]
          (be_operand.compiler-backend-type-size 0 ty))
        8)
      (=
        (let
          [ty
            (ast.AstType.StructArgs
              cbi.compiler-builtin-id-arena-type
              (box lifetimes))]
          (be_operand.compiler-backend-type-size 0 ty))
        8))))

;; Emitted-source witness for the internal borrowed-slice ABI.  A borrowed
;; Slice reference is two integer words (data pointer then signed length), so
;; the identity function must capture both incoming words and return both in
;; the target's integer return registers.  Keep this at opt0: the stable
;; spill/reload shape makes an accidental one-word ordinary-reference lowering
;; fail the check instead of merely matching a register name somewhere else.
(define (compiler-backend-slice-reference-abi-source) : String
  "(define (slice-abi-id [view : (& abi (Slice i64))]) : (& abi (Slice i64))
  view)
(define (main) : i64
  (let
    [items : (Array i64 3) (array 10 20 3)]
    (if (= (length (slice-abi-id (& items))) 3)
      42
      1)))")

(define (compiler-backend-slice-reference-abi-linux-body-ok? [body : String]) : bool
  (let
    [incoming0 : i64
      (backend.compiler-backend-string-find-from
        body
        "    movq %rdi, -8(%rsp)\n"
        0)]
    [incoming1 : i64
      (backend.compiler-backend-string-find-from
        body
        "    movq %rsi, -16(%rsp)\n"
        0)]
    [outgoing0 : i64
      (backend.compiler-backend-string-find-from
        body
        "    movq -8(%rsp), %rax\n"
        0)]
    [outgoing1 : i64
      (backend.compiler-backend-string-find-from
        body
        "    movq -16(%rsp), %rdx\n"
        0)]
    (and
      (> (string.string-length body) 0)
      (>= incoming0 0)
      (>= incoming1 0)
      (>= outgoing0 0)
      (>= outgoing1 0)
      (< incoming0 incoming1)
      (< incoming1 outgoing0)
      (< outgoing0 outgoing1))))

(define (compiler-backend-slice-reference-abi-windows-body-ok? [body : String]) : bool
  (let
    ;; The two home words sit at the bottom of the frame; the dense pair region
    ;; moved them from 16/24 to 0/8 of the 24-byte frame. Word order in the
    ;; source text, not the numeric offset, is what the checks below pin.
    [incoming0 : i64
      (backend.compiler-backend-string-find-from
        body
        "    movq %rcx, 8(%rsp)\n"
        0)]
    [incoming1 : i64
      (backend.compiler-backend-string-find-from
        body
        "    movq %rdx, 0(%rsp)\n"
        0)]
    [outgoing0 : i64
      (backend.compiler-backend-string-find-from
        body
        "    movq 8(%rsp), %rax\n"
        0)]
    [outgoing1 : i64
      (backend.compiler-backend-string-find-from
        body
        "    movq 0(%rsp), %rdx\n"
        0)]
    (and
      (> (string.string-length body) 0)
      (>= incoming0 0)
      (>= incoming1 0)
      (>= outgoing0 0)
      (>= outgoing1 0)
      (< incoming0 incoming1)
      (< incoming1 outgoing0)
      (< outgoing0 outgoing1))))

(define (compiler-backend-slice-reference-abi-registers-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-slice-reference-abi-source)
    target)
    [(Ok asm)
      (let
        [body : String
          (compiler-backend-asm-function-body asm "_tl_slice_abi_id")]
        (if (be_facts.compiler-backend-target-windows? target)
          (compiler-backend-slice-reference-abi-windows-body-ok? body)
          (compiler-backend-slice-reference-abi-linux-body-ok? body)))]
    [(Err _) false]))

(define (compiler-backend-slice-reference-abi-registers-ok?) : bool
  (and
    (compiler-backend-slice-reference-abi-registers-target-ok?
      be_state.CompilerBackendTarget.Linux)
    (compiler-backend-slice-reference-abi-registers-target-ok?
      be_state.CompilerBackendTarget.Windows)))

