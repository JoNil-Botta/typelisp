(define (compiler-backend-simd-indexed-address-users-ok?) : bool
  (and
    (compiler-backend-avx2-vector-load-address-ok?)
    (compiler-backend-avx2-vector-store-address-ok?)
    (compiler-backend-avx512-predicated-load-address-ok?)))

(define (compiler-backend-avx512-masked-if-source) : String
  "(define (main) : i64 0)
(define (fill [xs : (__tl_dyn-array i64)] [out : (__tl_dyn-array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< (array-ref xs i) 0)
      (set! (array-ref out i) 0)
      (set! (array-ref out i) (+ (array-ref xs i) 1)))))")

(define (compiler-backend-avx512-masked-if-offset-source) : String
  "(define (main) : i64 0)
(define (fill [xs : (__tl_dyn-array i64)] [out : (__tl_dyn-array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< (array-ref xs (+ i 1)) 0)
      (set! (array-ref out (+ i 1)) 0)
      (set! (array-ref out (+ i 1)) (+ (array-ref xs (+ i 1)) 1)))))")

(define (compiler-backend-avx512-masked-if-index-value-source) : String
  "(define (main) : i64 0)
(define (fill [out : (__tl_dyn-array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (< i 6)
      (set! (array-ref out i) i)
      (set! (array-ref out i) (+ i 1)))))")

(define (compiler-backend-avx512-masked-if-index-mod-source) : String
  "(define (main) : i64 0)
(define (fill [out : (__tl_dyn-array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (if (= (% i 2) 0)
      (set! (array-ref out i) (+ i 10))
      (set! (array-ref out i) (+ i 100)))))")

(define (compiler-backend-avx512-masked-if-value-source) : String
  "(define (main) : i64 0)
(define (fill [xs : (__tl_dyn-array i64)] [out : (__tl_dyn-array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (if (< (array-ref xs i) 0)
        0
        (+ (array-ref xs i) 1)))))")

(define (compiler-backend-avx512-select-alias-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%vec6 %1=%k1 %2=%vec6 %3=%vec7"))

(define (compiler-backend-avx512-select-false-alias-assignments) : regalloc.CompilerRegAssignmentTable
