    (compiler-backend-vector-home-valid? "%vec14")
    (compiler-backend-vector-home-valid? "%zmm15")
    (not (compiler-backend-vector-home-valid? "%xmm1"))
    (string.eq (compiler-backend-vector-home-to-reg "%k1" "zmm") "")))

