        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-rax))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-rax))
            (compiler_regalloc.compiler-reg-assignment-cons
              (compiler_regalloc.CompilerRegAssignment
                3
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-rax))
              (compiler_regalloc.compiler-reg-assignment-cons
                (compiler_regalloc.CompilerRegAssignment
                  4
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-rax))
                compiler_regalloc.CompilerRegAssignmentList.Nil)))))]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Gep
          2
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Gep
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ir_types.CompilerIrValue.I64 8)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Load
              4
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64))
            compiler_ir_types.CompilerIrInstrList.Nil)))]
    (match (compiler-backend-emit-test-instrs instrs assignments 5)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    leaq (%r13,%rax,1), %rax\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 8(%rax), %rax\n")
          (not
            (compiler_backend.compiler-backend-string-contains? asm "(%rbp)")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

;; GAP8: `Gep; Load(single-use, 8-byte); BinOp Add x v` folds the load into
;; the ALU memory operand: `addq (base,idx,8), dst` with no separate movq.
(define (compiler-backend-gep-load-alu-fold-shape-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r8))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              4
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-r14))
            (compiler_regalloc.compiler-reg-assignment-cons
              (compiler_regalloc.CompilerRegAssignment
                5
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-r14))
              compiler_regalloc.CompilerRegAssignmentList.Nil))))]
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Gep
          2
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Load
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.BinOp
              5
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Mov
                6
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ast_types.AstType.I64))
              compiler_ir_types.CompilerIrInstrList.Nil))))
      assignments
      7)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    addq (%r12,%r8,8), %r14\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq (%r12,%r8,8)"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

;; GAP9: an offset add feeding only a same-block gep index folds into the
;; addressing displacement -- the add vanishes, the load reads
;; `disp(base,counter,scale)` -- exercised through the pre-pass plus the
;; fused load emission (ordinal consumption included).
(define (compiler-backend-gep-fold-test-blocks [second-use : bool]) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.compiler-ir-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.BinOp
          2
          (compiler_ir_types.CompilerIrBinOp.Add)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Gep
            3
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Load
              4
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Mov
                5
                (compiler_ir_types.CompilerIrValue.Var 4)
                (compiler_ast_types.AstType.I64))
              (if second-use
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.Mov
                    6
                    (compiler_ir_types.CompilerIrValue.Var 2)
                    (compiler_ast_types.AstType.I64))
                  compiler_ir_types.CompilerIrInstrList.Nil)
                compiler_ir_types.CompilerIrInstrList.Nil))))))
    compiler_ir_types.CompilerIrBlockList.Nil))

(define (compiler-backend-gep-fold-test-entry-instrs
  [blocks : compiler_ir_types.CompilerIrBlockList]) : compiler_ir_types.CompilerIrInstrList
  (match blocks
    [(compiler_ir_types.CompilerIrBlockList.Cons block _)
      (match block
        [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
          (compiler_ir_types.compiler-ir-instr-seq-to-list instrs)])]
    [_ compiler_ir_types.CompilerIrInstrList.Nil]))

(define (compiler-backend-gep-fold-test-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r12))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r8))
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          4
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r14))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            5
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r13))
          compiler_regalloc.CompilerRegAssignmentList.Nil)))))

(define (compiler-backend-gep-fold-disp-shape-ok?) : bool
  (let
    [folded : compiler_ir_types.CompilerIrBlockList
      (compiler_backend.compiler-backend-gep-fold-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        8
        (compiler-backend-gep-fold-test-blocks false))]
    [result : bool
      (if (not
        (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-ready))
        false
        (match (compiler-backend-emit-test-instrs
          (compiler-backend-gep-fold-test-entry-instrs folded)
          (compiler-backend-gep-fold-test-assignments)
          8)
          [(compiler_backend.ResultCompilerBackend.Ok asm)
            (and
              (compiler_backend.compiler-backend-string-contains?
                asm
                "8(%r12,%r8,8)")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  "addq $1"))
              (not
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  "leaq 1("))
              (not (compiler_backend.compiler-backend-gep-fold-drift?)))]
          [(compiler_backend.ResultCompilerBackend.Err _) false]))]
    (begin
      (compiler_backend.compiler-backend-gep-fold-disable!)
      result)))

;; A second (non-gep) use of the offset var keeps the add and the plain
;; zero-displacement addressing.
(define (compiler-backend-gep-fold-multi-use-keeps-add-ok?) : bool
  (let
    [folded : compiler_ir_types.CompilerIrBlockList
      (compiler_backend.compiler-backend-gep-fold-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        8
        (compiler-backend-gep-fold-test-blocks true))]
    [result : bool
      (if (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-ready)
        false
        (match (compiler-backend-emit-test-instrs
          (compiler-backend-gep-fold-test-entry-instrs folded)
          (compiler-backend-gep-fold-test-assignments)
          8)
          [(compiler_backend.ResultCompilerBackend.Ok asm)
            (and
              (compiler_backend.compiler-backend-string-contains? asm "(%r12,")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  "8(%r12,")))]
          [(compiler_backend.ResultCompilerBackend.Err _) false]))]
    (begin
      (compiler_backend.compiler-backend-gep-fold-disable!)
      result)))

;; The disp-aware address builders.
(define (compiler-backend-gep-fold-builders-ok?) : bool
  (and
    (string.eq
      (compiler_backend.compiler-backend-gep-index-address-disp
        8
        "%rax"
        8
        "%rcx")
      "8(%rax,%rcx,8)")
    (string.eq
      (compiler_backend.compiler-backend-gep-index-address-disp
        0
        "%rax"
        8
        "%rcx")
      "(%rax,%rcx,8)")
    (string.eq
      (compiler_backend.compiler-backend-gep-index-address-disp
        8
        "%rax"
        32
        "%rcx")
      "")
    (compiler_backend.compiler-backend-string-contains?
      (compiler_backend.compiler-backend-gep-index-base-asm-disp
        24
        "%rax"
        32
        "%rcx")
      "    addq $24, %rax\n")))

;; Consuming an ordinal with the wrong shape poisons the function (the
;; emit-function gate turns this into a hard backend error).
(define (compiler-backend-gep-fold-drift-detected-ok?) : bool
  (let
    [_folded : compiler_ir_types.CompilerIrBlockList
      (compiler_backend.compiler-backend-gep-fold-blocks
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        8
        (compiler-backend-gep-fold-test-blocks false))]
    [result : bool
      (if (not
        (compiler_backend.compiler-backend-test-get-compiler-backend-gep-fold-ready))
        false
        (begin
          ;; wrong scale: recorded scale is 8 (i64), consume with u8.
          (compiler_backend.compiler-backend-gep-fold-next!
            (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ast_types.AstType.U8))
          (compiler_backend.compiler-backend-gep-fold-drift?)))]
    (begin
      (compiler_backend.compiler-backend-gep-fold-disable!)
      result)))

;; A narrow (u8) load must NOT fold: the memory operand width would not match
;; the 64-bit ALU op. The fused movzbq load stays.
(define (compiler-backend-gep-load-alu-fold-rejects-narrow-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r8))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              3
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-rcx))
            (compiler_regalloc.compiler-reg-assignment-cons
              (compiler_regalloc.CompilerRegAssignment
                4
                (compiler_regalloc.CompilerRegLocation.Register
                  compiler_abi.compiler-reg-id-r14))
              (compiler_regalloc.compiler-reg-assignment-cons
                (compiler_regalloc.CompilerRegAssignment
                  5
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-r14))
                compiler_regalloc.CompilerRegAssignmentList.Nil)))))]
    (match (compiler-backend-emit-test-instrs
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Gep
          2
          (compiler_ir_types.CompilerIrValue.Var 0)
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.U8))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Load
            3
            (compiler_ir_types.CompilerIrValue.Var 2)
            (compiler_ast_types.AstType.U8))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.BinOp
              5
              (compiler_ir_types.CompilerIrBinOp.Add)
              (compiler_ir_types.CompilerIrValue.Var 4)
              (compiler_ir_types.CompilerIrValue.Var 3)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Mov
                6
                (compiler_ir_types.CompilerIrValue.Var 5)
                (compiler_ast_types.AstType.I64))
              compiler_ir_types.CompilerIrInstrList.Nil))))
      assignments
      7)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movzbq (%r12,%r8,1), %rcx\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    addq (%r12")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

;; GAP8: three-operand constant multiply strength reduction shapes.
(define (compiler-backend-mul-pow2-test-asm [factor : i64] [dst-reg : i64]) : compiler_backend.ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.BinOp
        1
        (compiler_ir_types.CompilerIrBinOp.Mul)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.I64 factor)
        (compiler_ast_types.AstType.I64))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Mov
          2
          (compiler_ir_types.CompilerIrValue.Var 1)
          (compiler_ast_types.AstType.I64))
        compiler_ir_types.CompilerIrInstrList.Nil))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        0
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r12))
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          1
          (compiler_regalloc.CompilerRegLocation.Register dst-reg))
        compiler_regalloc.CompilerRegAssignmentList.Nil))
    3))

(define (compiler-backend-mul-pow2-lea-shape-ok?) : bool
  (match (compiler-backend-mul-pow2-test-asm 8 compiler_abi.compiler-reg-id-rcx)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    leaq (,%r12,8), %rcx\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "imulq")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-mul-pow2-shl-shape-ok?) : bool
  (match (compiler-backend-mul-pow2-test-asm
    32
    compiler_abi.compiler-reg-id-r12)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    shlq $5, %r12\n")
        (not (compiler_backend.compiler-backend-string-contains? asm "imulq")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-mul-non-pow2-imul-shape-ok?) : bool
  (match (compiler-backend-mul-pow2-test-asm
    24
    compiler_abi.compiler-reg-id-rcx)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.compiler-backend-string-contains?
        asm
        "    imulq $24, %r12, %rcx\n")]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-full-syscall-instr) : compiler_ir_types.CompilerIrInstr
  (compiler_ir_types.CompilerIrInstr.Syscall
    0
    (compiler_ir_types.compiler-ir-call-args-from-list
      (compiler_ir_types.compiler-ir-value-cons
        (compiler_ir_types.CompilerIrValue.I64 231)
        (compiler_ir_types.compiler-ir-value-cons
          (compiler_ir_types.CompilerIrValue.I64 1)
          (compiler_ir_types.compiler-ir-value-cons
            (compiler_ir_types.CompilerIrValue.I64 2)
            (compiler_ir_types.compiler-ir-value-cons
              (compiler_ir_types.CompilerIrValue.I64 3)
              (compiler_ir_types.compiler-ir-value-cons
                (compiler_ir_types.CompilerIrValue.I64 4)
                (compiler_ir_types.compiler-ir-value-cons
                  (compiler_ir_types.CompilerIrValue.I64 5)
                  (compiler_ir_types.compiler-ir-value-cons
                    (compiler_ir_types.CompilerIrValue.I64 6)
                    compiler_ir_types.CompilerIrValueList.Nil))))))))))

(define (compiler-backend-full-syscall-registers-ok?) : bool
  (let
    [instr : compiler_ir_types.CompilerIrInstr
      (compiler-backend-full-syscall-instr)]
    (and
      (compiler_backend.backend-and8
        (compiler-backend-instr-contains? instr "    movl $231, %eax\n")
        (compiler-backend-instr-contains? instr "    movl $1, %edi\n")
        (compiler-backend-instr-contains? instr "    movl $2, %esi\n")
        (compiler-backend-instr-contains? instr "    movl $3, %edx\n")
        (compiler-backend-instr-contains? instr "    movl $4, %r10d\n")
        (compiler-backend-instr-contains? instr "    movl $5, %r8d\n")
        (compiler-backend-instr-contains? instr "    movl $6, %r9d\n")
        (compiler-backend-instr-contains? instr "    syscall\n"))
      (not (compiler-backend-instr-contains? instr "    pushq %rax\n"))
      (not (compiler-backend-instr-contains? instr "    popq ")))))

(define (compiler-backend-entry-load-register-homes-ok?) : bool
  (let
    [assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r12))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r13))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-r14))
            compiler_regalloc.CompilerRegAssignmentList.Nil)))]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.EntryArgc 0)
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.EntryArgv 1)
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.EntryEnvp 2)
            compiler_ir_types.CompilerIrInstrList.Nil)))]
    (match (compiler-backend-emit-test-instrs instrs assignments 3)
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (and
          (compiler_backend.backend-and4
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_argc(%rip), %r12\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_argv(%rip), %r13\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_envp(%rip), %r14\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %rax\n")))
          (compiler_backend.backend-and4
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argv(%rip), %rax\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_envp(%rip), %rax\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq %rax, %r12\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq %rax, %r13\n")))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %rax, %r14\n")))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-entry-load-fallbacks-ok?) : bool
  (let
    [spill-assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Spill -16))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    [pair-assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.RegisterPair
            compiler_abi.compiler-reg-id-r12
            compiler_abi.compiler-reg-id-r13))
        compiler_regalloc.CompilerRegAssignmentList.Nil)]
    [r11-occupied-assignments : compiler_regalloc.CompilerRegAssignmentList
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Spill -16))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r11))
          compiler_regalloc.CompilerRegAssignmentList.Nil))]
    [no-location-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.EntryArgc 0)
          compiler_ir_types.CompilerIrInstrList.Nil)
        compiler_regalloc.CompilerRegAssignmentList.Nil
        1)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_argc(%rip), %r11\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %r11, -8(%rbp)\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [spill-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.EntryArgv 0)
          compiler_ir_types.CompilerIrInstrList.Nil)
        spill-assignments
        1)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_argv(%rip), %r11\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %r11, -16(%rbp)\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argv(%rip), %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [pair-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.EntryEnvp 0)
          compiler_ir_types.CompilerIrInstrList.Nil)
        pair-assignments
        1)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_envp(%rip), %r11\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %r11, %r12\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_envp(%rip), %r12\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_envp(%rip), %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [r11-occupied-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.EntryArgc 0)
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Return
              (compiler_ir_types.CompilerIrMaybeValue.Some
                (compiler_ir_types.CompilerIrValue.Var 1)))
            compiler_ir_types.CompilerIrInstrList.Nil))
        r11-occupied-assignments
        2)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq .L_tl_argc(%rip), %r9\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %r9, -16(%rbp)\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %r11\n"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %rax\n")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    (and no-location-ok? spill-ok? pair-ok? r11-occupied-ok?)))

(define (compiler-backend-cpuid-eax-direct-ok?) : bool
  (let
    [instr : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.CpuId
        0
        (compiler_ir_types.CompilerIrValue.I64 7)
        (compiler_ir_types.CompilerIrValue.I64 0)
        0)]
    (compiler_backend.backend-and8
      (compiler-backend-instr-contains? instr "    xorl %ecx, %ecx\n")
      (compiler-backend-instr-contains? instr "    movl $7, %eax\n")
      ;; cpuid clobbers %rbx; the campaign preserves the caller's %rbx in a
      ;; scavenged free reg (%r8 here, none of r8-r15 touched by cpuid) instead
      ;; of pushq/popq %rbx (the no-stack-staging goal).
      (compiler-backend-instr-contains? instr "    movq %rbx, %r8\n")
      (compiler-backend-instr-contains? instr "    cpuid\n")
      (compiler-backend-instr-contains? instr "    movq %r8, %rbx\n")
      (not (compiler-backend-instr-contains? instr "    movl %eax, %eax\n"))
      (not (compiler-backend-instr-contains? instr "    movl %r11d, %ecx\n"))
      (not (compiler-backend-instr-contains? instr "%r11")))))

(define (compiler-backend-cpuid-direct-subleaf-ok?) : bool
  (let
    [instr : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.CpuId
        0
        (compiler_ir_types.CompilerIrValue.I64 7)
        (compiler_ir_types.CompilerIrValue.I64 3)
        0)]
    (compiler_backend.backend-and4
      (compiler-backend-instr-contains? instr "    movl $3, %ecx\n")
      (compiler-backend-instr-contains? instr "    movl $7, %eax\n")
      (not (compiler-backend-instr-contains? instr "    movl %r11d, %ecx\n"))
      (not (compiler-backend-instr-contains? instr "%r11")))))

(define (compiler-backend-xgetbv-zero-index-ok?) : bool
  (let
    [instr : compiler_ir_types.CompilerIrInstr
      (compiler_ir_types.CompilerIrInstr.Xgetbv
        0
        (compiler_ir_types.CompilerIrValue.I64 0))]
    (compiler_backend.backend-and4
      (compiler-backend-instr-contains? instr "    xorl %ecx, %ecx\n")
      (compiler-backend-instr-contains? instr "    xgetbv\n")
      (compiler-backend-instr-contains? instr "    orq %rdx, %rax\n")
      true)))

(define (compiler-backend-low-level-instr-ok?) : bool
  (and
    (compiler_backend.backend-and8
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.EntryArgc 0)
        ".L_tl_argc(%rip)")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.EntryArgv 0)
        ".L_tl_argv(%rip)")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.EntryEnvp 0)
        ".L_tl_envp(%rip)")
      (compiler-backend-cpuid-eax-direct-ok?)
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.CpuId
          0
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 0)
          1)
        "    movl %ebx, %eax\n")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.CpuId
          0
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 0)
          2)
        "    movl %ecx, %eax\n")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.CpuId
          0
          (compiler_ir_types.CompilerIrValue.I64 7)
          (compiler_ir_types.CompilerIrValue.I64 0)
          3)
        "    movl %edx, %eax\n")
      (compiler-backend-xgetbv-zero-index-ok?))
    (compiler-backend-cpuid-direct-subleaf-ok?)
    (compiler_backend.backend-and8
      ;; A one-operand syscall loads the number into %rax and issues `syscall`.
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.Syscall
          0
          (compiler_ir_types.CompilerIrCallArgs.One
            (compiler_ir_types.CompilerIrValue.I64 231)))
        "    movl $231, %eax\n")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.Syscall
          0
          (compiler_ir_types.CompilerIrCallArgs.One
            (compiler_ir_types.CompilerIrValue.I64 231)))
        "    syscall\n")
      (not
        (compiler-backend-instr-contains?
          (compiler_ir_types.CompilerIrInstr.Syscall
            0
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.I64 231)))
          "    pushq %rax\n"))
      (not
        (compiler-backend-instr-contains?
          (compiler_ir_types.CompilerIrInstr.Syscall
            0
            (compiler_ir_types.CompilerIrCallArgs.One
              (compiler_ir_types.CompilerIrValue.I64 231)))
          "    popq "))
      ;; A two-operand syscall additionally loads argument 0 into %rdi.
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.Syscall
          0
          (compiler_ir_types.CompilerIrCallArgs.Two
            (compiler_ir_types.CompilerIrValue.I64 231)
            (compiler_ir_types.CompilerIrValue.I64 42)))
        "    movl $42, %edi\n")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.Syscall
          0
          (compiler_ir_types.CompilerIrCallArgs.Two
            (compiler_ir_types.CompilerIrValue.I64 231)
            (compiler_ir_types.CompilerIrValue.I64 42)))
        "    movl $231, %eax\n")
      (compiler-backend-instr-contains?
        (compiler_ir_types.CompilerIrInstr.Syscall
          0
          (compiler_ir_types.CompilerIrCallArgs.Two
            (compiler_ir_types.CompilerIrValue.I64 231)
            (compiler_ir_types.CompilerIrValue.I64 0)))
        "    xorl %edi, %edi\n")
      (compiler-backend-full-syscall-registers-ok?))
    (compiler-backend-entry-load-register-homes-ok?)
    (compiler-backend-entry-load-fallbacks-ok?)))

(define (compiler-backend-numeric-cast-shape-ok?) : bool
  (compiler_backend.backend-and8
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.I64)
        (compiler_ast_types.AstType.F64))
      "    cvtsi2sdq %r8, %xmm2\n")
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.I64)
        (compiler_ast_types.AstType.F32))
      "    cvtsi2ssq %r8, %xmm2\n")
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.U8)
        (compiler_ast_types.AstType.F64))
      "    cvtsi2sdq %r8, %xmm2\n")
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.U64)
        (compiler_ast_types.AstType.F64))
      "    js .L_tl_test_cast_u64_float_entry_v6_high\n")
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.U64)
        (compiler_ast_types.AstType.F32))
      "    addss %xmm2, %xmm2\n")
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.F64)
        (compiler_ast_types.AstType.I64))
      "    cvttsd2siq %xmm2, %r8\n")
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.F64)
        (compiler_ast_types.AstType.F32))
      "    cvtsd2ss %xmm2, %xmm2\n")
    (compiler-backend-instr-contains?
      (compiler_ir_types.CompilerIrInstr.Cast
        6
        (compiler_ir_types.CompilerIrValue.Var 5)
        (compiler_ast_types.AstType.F32)
        (compiler_ast_types.AstType.F64))
      "    cvtss2sd %xmm2, %xmm2\n")))

