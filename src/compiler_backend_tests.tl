(define (compiler-backend-callee-save-double-return-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.compiler-ir-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Return
          compiler_ir_types.CompilerIrMaybeValue.No)
        compiler_ir_types.CompilerIrInstrList.Nil))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.compiler-ir-block
        (compiler_ir_types.compiler-ir-label "alt")
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Return
            compiler_ir_types.CompilerIrMaybeValue.No)
          compiler_ir_types.CompilerIrInstrList.Nil))
      compiler_ir_types.CompilerIrBlockList.Nil)))

(define (compiler-backend-callee-save-pop-epilogue-ok?) : bool
  (let
    [shared-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_abi : unit
      (compiler_backend.compiler-backend-set-current-fn-linux! shared-state)]
    [one : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments1)]
    [two : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments2)]
    [three : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments3)]
    [four : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments4)]
    [five : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments5)]
    [shared-name : i64 (ci.intern "pop_shared")]
    [shared : String
      (compiler_backend.compiler-backend-return-epilogue
        shared-state
        shared-name
        five
        1
        (compiler-backend-callee-save-double-return-blocks))]
    (and
      (compiler_backend.backend-and8
        (string.eq
          (compiler_backend.compiler-backend-emit-restore-callee-regs
            one
            3
            shared-state)
          "    movq -32(%rbp), %r12\n")
        (string.eq
          (compiler_backend.compiler-backend-emit-restore-callee-regs
            two
            3
            shared-state)
          "    leaq -40(%rbp), %rsp\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler_backend.compiler-backend-emit-restore-callee-regs
            three
            2
            shared-state)
          "    leaq -40(%rbp), %rsp\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler_backend.compiler-backend-emit-restore-callee-regs
            four
            2
            shared-state)
          "    leaq -48(%rbp), %rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler_backend.compiler-backend-emit-restore-callee-regs
            five
            1
            shared-state)
          "    leaq -48(%rbp), %rsp\n    popq %rbx\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n")
        (string.eq
          (compiler_backend.compiler-backend-inline-return-tail
            two
            3
            shared-state)
          "    leaq -40(%rbp), %rsp\n    popq %r13\n    popq %r12\n    leave\n    ret\n")
        (string.eq
          (compiler_backend.compiler-backend-tail-jump-tail
            four
            2
            "_tl_next"
            shared-state)
          "    leaq -48(%rbp), %rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    leave\n    jmp _tl_next\n")
        (compiler_backend.compiler-backend-string-contains?
          shared
          "    popq %rbx\n"))
      (compiler_backend.compiler-backend-string-contains?
        shared
        "    leave\n    ret\n")
      (not (string.eq shared "")))))

(define (compiler-backend-callee-save-push-prologue-rebase-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_abi : unit
      (compiler_backend.compiler-backend-set-current-fn-linux! backend-state)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments3)]
    [push-regs : (__tl_dyn-array String)
      (compiler_backend.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (compiler_backend.compiler-backend-fill-push-csr-regs!
        assignments
        push-regs
        backend-state)]
    [prologue : String
      (compiler_backend.compiler-backend-emit-function-entry-fpo-push
        backend-state
        "_tl_gap1_push_unit"
        64
        push-regs
        push-count)]
    [post-prologue : String
      "    movq %r12, -32(%rbp)
    movq %r13, -40(%rbp)
    movq %r14, -48(%rbp)
    movq -8(%rbp), %rax
    leaq -48(%rbp), %rsp
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
"]
    [rebased : String
      (compiler_backend.compiler-backend-rsp-rebase-full
        post-prologue
        64
        true
        push-regs
        push-count
        3
        backend-state)]
    (and
      (= push-count 3)
      (string.eq
        prologue
        "_tl_gap1_push_unit:
    pushq %r12
    pushq %r13
    pushq %r14
    subq $64, %rsp
")
      (compiler_backend.compiler-backend-test-get-compiler-backend-rsp-rebase-last-ok)
      (string.eq
        rebased
        "    movq 56(%rsp), %rax
    addq $64, %rsp
    popq %r14
    popq %r13
    popq %r12
    ret
")
      (not
        (compiler_backend.compiler-backend-string-contains? rebased "-32(%rbp)"))
      (not
        (compiler_backend.compiler-backend-string-contains? rebased "-40(%rbp)"))
      (not
        (compiler_backend.compiler-backend-string-contains? rebased "-48(%rbp)"))
      (not
        (compiler_backend.compiler-backend-string-contains?
          rebased
          "    leave\n")))))

;; GAP1 corollary: a function whose ONLY frame references were callee-save
;; slots reaches the push prologue with a DEAD slot region. `frame = 0` with an
;; odd push count makes the prologue subq vanish (S = frame + 0), and the
;; pop-run rebase line -- which points %rsp at the pushed area -- becomes
;; `addq $0`, i.e. nothing to do, so it vanishes too. The result is the shape
;; clang emits: pushes in, pops out, no stack adjustment either way.
;;
;; The paired neighbour is the SAME text with a live slot region (frame = 16):
;; both the prologue subq and the pop-run addq must come back, which is what
;; keeps the drop keyed on the amount being zero rather than on the shape.
(define (compiler-backend-dead-slot-region-push-body) : String
  "    movq %r12, -8(%rbp)
    movq %r13, -16(%rbp)
    movq %r14, -24(%rbp)
    movq %rdi, %rax
    leaq -24(%rbp), %rsp
    popq %r14
    popq %r13
    popq %r12
    leave
    ret
")

(define (compiler-backend-dead-slot-region-push-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_abi : unit
      (compiler_backend.compiler-backend-set-current-fn-linux! backend-state)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-callee-save-assignments3)]
    [push-regs : (__tl_dyn-array String)
      (compiler_backend.compiler-backend-rsp-rebase-make-push-regs)]
    [push-count : i64
      (compiler_backend.compiler-backend-fill-push-csr-regs!
        assignments
        push-regs
        backend-state)]
    [dead-prologue : String
      (compiler_backend.compiler-backend-emit-function-entry-fpo-push
        backend-state
        "_tl_qsc_dead_slots"
        0
        push-regs
        push-count)]
    [dead-rebased : String
      (compiler_backend.compiler-backend-rsp-rebase-full
        (compiler-backend-dead-slot-region-push-body)
        0
        true
        push-regs
        push-count
        0
        backend-state)]
    [dead-ok : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-rsp-rebase-last-ok)]
    [live-prologue : String
      (compiler_backend.compiler-backend-emit-function-entry-fpo-push
        backend-state
        "_tl_qsc_live_slots"
        16
        push-regs
        push-count)]
    [live-rebased : String
      (compiler_backend.compiler-backend-rsp-rebase-full
        (compiler-backend-dead-slot-region-push-body)
        16
        true
        push-regs
        push-count
        0
        backend-state)]
    [live-ok : bool
      (compiler_backend.compiler-backend-test-get-compiler-backend-rsp-rebase-last-ok)]
    (and
      (= push-count 3)
      dead-ok
      live-ok
      ;; ADMITTED: no stack adjustment in either direction.
      (string.eq
        dead-prologue
        "_tl_qsc_dead_slots:
    pushq %r12
    pushq %r13
    pushq %r14
")
      (string.eq
        dead-rebased
        "    movq %rdi, %rax
    popq %r14
    popq %r13
    popq %r12
    ret
")
      ;; REFUSED (live slot region): both adjustments stay.
      (string.eq
        live-prologue
        "_tl_qsc_live_slots:
    pushq %r12
    pushq %r13
    pushq %r14
    subq $16, %rsp
")
      (string.eq
        live-rebased
        "    movq %rdi, %rax
    addq $16, %rsp
    popq %r14
    popq %r13
    popq %r12
    ret
")
      (not
        (compiler_backend.compiler-backend-string-contains? dead-rebased "%rbp"))
      (not
        (compiler_backend.compiler-backend-string-contains?
          dead-rebased
          "    leave\n")))))

(define (compiler-backend-win64-callee-save-homes-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_win : unit
      (compiler_backend.compiler-backend-set-current-fn-win64! backend-state)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-win64-callee-save-assignments)]
    [full : compiler_regalloc.CompilerRegAssignmentTable
      (compiler-backend-win64-callee-save-full-assignments)]
    [save : String
      (compiler_backend.compiler-backend-emit-save-callee-regs
        assignments
        3
        backend-state)]
    [restore : String
      (compiler_backend.compiler-backend-emit-restore-callee-regs
        assignments
        3
        backend-state)]
    [full-restore : String
      (compiler_backend.compiler-backend-emit-restore-callee-regs
        full
        1
        backend-state)]
    [ok : bool
      (and
        (compiler_backend.compiler-backend-plan-uses-callee-regs?
          assignments
          backend-state)
        (=
          (compiler_backend.compiler-backend-frame-slots
            3
            assignments
            backend-state)
          10)
        (=
          (compiler_backend.compiler-backend-frame-slots 1 full backend-state)
          8)
        (string.eq
          save
          "    movq %r12, -32(%rbp)\n    movq %rsi, -72(%rbp)\n    movq %rdi, -80(%rbp)\n")
        (string.eq
          restore
          "    movq -80(%rbp), %rdi\n    movq -72(%rbp), %rsi\n    movq -32(%rbp), %r12\n")
        (not
          (compiler_backend.compiler-backend-string-contains? restore "popq"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            full-restore
            "popq"))
        (compiler_backend.compiler-backend-string-contains?
          full-restore
          "    movq -64(%rbp), %rdi\n")
        (compiler_backend.compiler-backend-string-contains?
          full-restore
          "    movq -56(%rbp), %rsi\n")
        (compiler_backend.compiler-backend-string-contains?
          full-restore
          "    movq -48(%rbp), %rbx\n"))]
    [_linux : unit
      (compiler_backend.compiler-backend-set-current-fn-linux! backend-state)]
    ok))

(define (compiler-backend-win64-fpo-seh-prologue-ok?) : bool
