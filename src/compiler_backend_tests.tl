;; A refutable literal payload match lowers to a payload comparison that
;; branches to the next arm; confirm the resulting CFG reaches valid assembly.
(define (compiler-backend-literal-payload-source) : String
  "(defenum Maybe (None) (Some i64))
(define (classify [m : Maybe]) : i64
  (match m
    [(Some 0) 100]
    [(Some n) n]
    [None 5]))
(define (main) : i64 (classify (Some 0)))")

;; Confirm the refutable literal payload reaches valid assembly: the
;; function compiles and emits a `payload_ok` block (the in-bounds branch of the
;; payload comparison).
(define (compiler-backend-literal-payload-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-literal-payload-source))
    [(Ok asm)
      (and
        (or (asm-has? asm "_tl_classify") (asm-has? asm "_tl_f"))
        (asm-has? asm "_payload_ok"))]
    [(Err _) false]))

(define (compiler-backend-f64-source) : String
  "(define (addf [a : f64] [b : f64]) : f64
  (+ a b))
(define (subf [a : f64] [b : f64]) : f64
  (- a b))
(define (ltf [a : f64] [b : f64]) : bool
  (< a b))
(define (main) : i64
  (if (ltf (subf (addf 1.5 2.5) 1.0) 4.5) 7 9))")

(define (compiler-backend-f64-ok?) : bool
  (match (backend.compiler-backend-emit-source (compiler-backend-f64-source))
    [(Ok asm)
      (and
        (let
          [needle
            (be_data.compiler-backend-float-bits-directive
              (F64)
              (compiler-backend-test-f64-bits "1.5"))]
          (asm-has? asm needle))
        (asm-lacks? asm "    .double ")
        (asm-has? asm "    movsd %xmm0, ")
        (asm-has? asm "    movsd %xmm1, ")
        ;; T1-6 (a): these three leaves are call-free with a frame inside the
        ;; red zone, so the y param spills BELOW %rsp (-16(%rsp)) and the
        ;; prologue moves no stack pointer at all.
        (asm-has? asm "    addsd -16(%rsp), %xmm2\n")
        (asm-has? asm "    subsd -16(%rsp), %xmm2\n")
        (asm-has? asm "    ucomisd -16(%rsp), %xmm2\n")
        (asm-has? asm "    setb %r8b\n")
        (asm-lacks? asm "    setb %al\n"))]
    [(Err _) false]))

(define (compiler-backend-f64-neg-source) : String
  "(define (negf [x : f64]) : f64
  (neg x))
(define (main) : i64
  (if (< (negf 1.5) 0.0) 0 1))")

(define (compiler-backend-f64-neg-object-source) : String
  "(define (negf [x : f64]) : f64
  (neg x))
(define (main) : i64 0)")

(define (compiler-backend-f64-neg-sign-mask-asm-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-f64-neg-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (asm-has? asm "    xorpd .L_tl_f64_sign_bit(%rip), %xmm2\n")
          (=
            (backend.compiler-backend-string-count asm ".L_tl_f64_sign_bit:\n")
            1)
          (asm-has? asm "    .balign 16\n")
          (asm-has? asm "    .quad 0x8000000000000000\n")
          (asm-has? asm "    .quad 0\n")
          (asm-lacks? asm "    movabsq $0x8000000000000000, %rax\n")
          (asm-lacks? asm "    movq %rax, %xmm1\n")
          true)
        (asm-lacks?
          asm
          "    xorpd %xmm1, %xmm0\n"
          "    xorpd .L_tl_f64_sign_bit(%rip), %xmm0\n")
        (asm-ok?
          (backend.compiler-backend-emit-source (compiler-backend-f64-source))
          (lacks ".L_tl_f64_sign_bit")))]
    [(Err _) false]))

(define (compiler-backend-f64-neg-sign-mask-object-render-ok?
  [image : cobj.CompilerObjectImage]
  [target : be_state.CompilerBackendTarget]) : bool
  (match target
    [(be_state.CompilerBackendTarget.Linux)
      (match (elf.compiler-object-elf-render image)
        [(Ok _) true]
        [(Err _) false])]
    [(be_state.CompilerBackendTarget.Windows)
      (match (coff.compiler-object-coff-render image)
        [(Ok _) true]
        [(Err _) false])]))

(define (compiler-backend-f64-neg-sign-mask-object-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (backend.compiler-backend-emit-source-object-image-for-target
    (compiler-backend-f64-neg-object-source)
    target)
    [(Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList
          (owned_view.compiler-owned-shared-view image.sections)]
        [symbols : cobj.CompilerObjectSymbolList
          (owned_view.compiler-owned-shared-view image.symbols)]
        [relocs : cobj.CompilerObjectRelocationList
          (owned_view.compiler-owned-shared-view image.relocations)]
        [label : String (be_facts.compiler-backend-f64-sign-bit-label)]
        (and
          (be_state.backend-and8
            (cobj.compiler-object-symbol-list-contains?
              symbols
              label
              (Local)
              (Data))
            (cobj.compiler-object-section-contains-label?
              sections
              cobj.rodata-id
              label)
            (compiler-object-section-contains-align? sections cobj.rodata-id 16)
            (compiler-object-section-label-has-i64-pair?
              sections
              cobj.rodata-id
              label
              -9223372036854775808
              0)
            (compiler-object-section-contains-xorpd-rip? sections label)
            (cobj.compiler-object-relocation-list-contains?
              relocs
              (RipValue)
              label)
            true
            true)
          (compiler-backend-f64-neg-sign-mask-object-render-ok? image target)))]
    [(Err _) false]))

(define (compiler-backend-f64-neg-sign-mask-object-ok?) : bool
  (and
    (compiler-backend-f64-neg-sign-mask-object-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-f64-neg-sign-mask-object-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-f64-neg-sign-mask-ok?) : bool
  (and
    (compiler-backend-f64-neg-sign-mask-asm-ok?)
    (compiler-backend-f64-neg-sign-mask-object-ok?)))

