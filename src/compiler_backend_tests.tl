    "join:
       %0 = phi [%1, back] : f32
       %1 = phi [%2, back] : f32
       %2 = phi [%0, back] : f32"))

(define (compiler-backend-phi-group-f64-cycle-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%xmm2/%xmm3 %1=%xmm4/%xmm5"))

(define (compiler-backend-phi-group-f64-cycle-blocks) : ir.CompilerIrBlockList
  (let
    [ty : ast.AstType (compiler-backend-register-group-f64-test-type)]
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "join")
        (compiler-backend-test-instr-seq-prepend
          (Phi
            0
            (ir.compiler-ir-phi-input-seq-prepend
              (Var 1)
              (ir.compiler-ir-label "back")
              (& (ir.compiler-ir-phi-input-seq-empty)))
            (owned_view.compiler-owned-shared-view ty))
          (irt.instrs "%1 = phi [%0, back] : BackendGroupF64Test"))))))

(define (compiler-backend-branch-phi-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "body")
      (compiler-backend-test-instr-seq-prepend
        (Phi
          0
          (ir.compiler-ir-phi-input-seq-prepend
            (I64 1)
            (ir.compiler-ir-label "entry")
            (&
              (ir.compiler-ir-phi-input-seq-prepend
                (Var 1)
                (ir.compiler-ir-label "body")
                (& (ir.compiler-ir-phi-input-seq-empty)))))
          (I64))
        (ir.compiler-ir-instr-seq-empty)))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "exit")
      (ir.compiler-ir-instr-seq-empty))))

(define (compiler-backend-branch-phi-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r13 %2=%r14"))

(define (compiler-backend-branch-phi-edge-copy-ok?) : bool
  (let
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [_targets : unit
      (set-state-current-phi-targets!
        backend-state
        (be_facts.compiler-backend-phi-target-labels-for-blocks
          (compiler-backend-branch-phi-blocks)))]
    (match (be_calls.compiler-backend-emit-compare-branch-with-phi-copies
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-branch-phi-assignments)
      "phi_edge"
      (compiler-backend-branch-phi-blocks)
      (ir.compiler-ir-label "entry")
      (Lt)
      (I64 1)
      (Var 2)
      (I64)
      (ir.compiler-ir-label "body")
      (ir.compiler-ir-label "exit")
      (No)
      program-index
      4)
      [(Ok asm)
        (and
          ;; `1 < %r14` is emitted as `%r14 > 1`, so the false edge uses
          ;; the reversed predicate (`jle`) while retaining the phi-copy edge.
          (asm-has? asm "    jle .Lphi_edge_exit\n")
          (asm-lacks? asm "    jl .Lphi_edge_entry_branch_true\n")
          (asm-has? asm ".Lphi_edge_entry_branch_true:\n")
          (asm-has? asm "    movl $1, %r12d\n")
          (asm-lacks? asm "    movq %rax, %r12\n")
          (asm-lacks? asm ".Lphi_edge_entry_branch_false:\n")
          (asm-has? asm "    jmp .Lphi_edge_body\n"))]
      [(Err _) false])))

(define (compiler-backend-phi-immediate-stack-copy-ok?) : bool
  (asm-ok?
    (be_calls.compiler-backend-emit-phi-edge-copies
      (ast.ast-node-pool-reader-type-segment-bases)
      (regalloc.compiler-reg-assignment-table-empty)
      (compiler-backend-branch-phi-blocks)
      (ir.compiler-ir-label "body")
      (ir.compiler-ir-label "entry")
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))
      4)
    (has "    movq $1, -8(%rbp)\n")
    (lacks "    movl $1, %eax\n" "    movq %rax, -8(%rbp)\n")))

(define (compiler-backend-phi-direct-scalar-copy-ok?) : bool
  (match (be_calls.compiler-backend-emit-phi-edge-copies
    (ast.ast-node-pool-reader-type-segment-bases)
    (reg-homes "%0=%r12 %1=%r13")
    (compiler-backend-branch-phi-blocks)
    (ir.compiler-ir-label "body")
    (ir.compiler-ir-label "body")
    (compiler-backend-program-index-build
      (ast.ast-node-pool-reader-type-segment-bases)
      (ir.compiler-ir-function-seq-empty)
      (ir.compiler-ir-extern-seq-empty))
    4)
    [(Ok reg-reg)
      (match (be_calls.compiler-backend-emit-phi-edge-copies
        (ast.ast-node-pool-reader-type-segment-bases)
        (reg-homes "%0=%r12 %1=spill:-16")
        (compiler-backend-branch-phi-blocks)
        (ir.compiler-ir-label "body")
        (ir.compiler-ir-label "body")
        (compiler-backend-program-index-build
          (ast.ast-node-pool-reader-type-segment-bases)
          (ir.compiler-ir-function-seq-empty)
          (ir.compiler-ir-extern-seq-empty))
        4)
        [(Ok spill-reg)
          (match (be_calls.compiler-backend-emit-phi-edge-copies
            (ast.ast-node-pool-reader-type-segment-bases)
            (reg-homes "%0=spill:-8 %1=%r13")
            (compiler-backend-branch-phi-blocks)
            (ir.compiler-ir-label "body")
            (ir.compiler-ir-label "body")
            (compiler-backend-program-index-build
              (ast.ast-node-pool-reader-type-segment-bases)
              (ir.compiler-ir-function-seq-empty)
              (ir.compiler-ir-extern-seq-empty))
            4)
            [(Ok reg-spill)
              (and
                (asm-has? reg-reg "    movq %r13, %r12\n")
                (asm-lacks? reg-reg "    movq %r13, %rax\n")
                (asm-has? spill-reg "    movq -16(%rbp), %r12\n")
                (asm-lacks? spill-reg "    movq -16(%rbp), %rax\n")
                (asm-has? reg-spill "    movq %r13, -8(%rbp)\n")
                (asm-lacks? reg-spill "    movq %r13, %rax\n"))]
            [(Err _) false])]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-phi-return-entry-asm
  [blocks : ir.CompilerIrBlockList]
  [entry-instrs : ir.CompilerIrInstrSeq]
  [assignments : regalloc.CompilerRegAssignmentTable]
  [vars : i64]) : be_state.ResultCompilerBackend
  (let
    [use-counts : (__tl_dyn-array i64)
      (backend.compiler-backend-function-use-counts
        vars
        (owned_view.compiler-owned-shared-view blocks))]
    [test-id : i64 (ci.intern "test")]
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    (compiler-backend-test-emit-instrs-text
      (be_state.CompilerBackendEmissionContext
        (ast.ast-node-pool-reader-type-segment-bases)
        (be_state.compiler-backend-target-policy-new
          be_state.CompilerBackendTarget.Linux)
        "_tl_test"
        test-id
        blocks
        (ir.compiler-ir-label "entry")
        assignments
        vars
        (regalloc.compiler-reg-var-types-empty)
        (Empty)
        (I64)
        (compiler-backend-runtime-helper-full-plan)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty)
        program-index
        (ir.compiler-source-spans-empty)
        (be_state.compiler-backend-source-span-index-build-with-backend-state
          backend-state
          (ir.compiler-source-spans-empty))
        (cdiag.compiler-diagnostic-at-start "" "")
        use-counts
        backend-state
        (be_state.compiler-backend-state-function-state backend-state))
      (No)
      entry-instrs)))

(define (compiler-backend-single-phi-return-entry-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%1 = mov 7 : i64
     jump join"))

(define (compiler-backend-single-phi-return-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %1 = mov 7 : i64
       jump join
     join:
       %0 = phi [%1, entry] : i64
       return %0"))

(define (compiler-backend-single-phi-return-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r14"))

(define (compiler-backend-single-phi-return-shortcut-ok?) : bool
  (asm-ok?
    (compiler-backend-phi-return-entry-asm
      (compiler-backend-single-phi-return-blocks)
      (compiler-backend-single-phi-return-entry-instrs)
      (compiler-backend-single-phi-return-assignments)
      2)
    (has "    movl $7, %eax\n")
    (lacks
      "    movl $7, %r14d\n"
      "    movq %r14, %r12\n"
      "    jmp .L_tl_test_join\n")))

(define (compiler-backend-multi-phi-return-entry-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%2 = mov 7 : i64
     %3 = mov 11 : i64
     jump join"))

(define (compiler-backend-multi-phi-return-join-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = phi [%3, entry] : i64
     %1 = phi [%2, entry] : i64
     %4 = phi [99, entry] : i64
     return %1"))

(define (compiler-backend-multi-phi-return-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (compiler-backend-multi-phi-return-entry-instrs))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "join")
      (compiler-backend-multi-phi-return-join-instrs))))

(define (compiler-backend-multi-phi-return-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r13 %2=%r14 %3=%r15 %4=%rbx"))

(define (compiler-backend-multi-phi-return-shortcut-ok?) : bool
  (asm-ok?
    (compiler-backend-phi-return-entry-asm
      (compiler-backend-multi-phi-return-blocks)
      (compiler-backend-multi-phi-return-entry-instrs)
      (compiler-backend-multi-phi-return-assignments)
      5)
    (has "    movl $7, %r14d\n" "    movq %r14, %rax\n")
    (lacks
      "    movq %r14, %r13\n"
      "    movl $99, %ebx\n"
      "    jmp .L_tl_test_join\n")))

(define (compiler-backend-phi-return-work-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %1 = mov 7 : i64
       jump join
     join:
       %0 = phi [%1, entry] : i64
       %2 = mov 99 : i64
       return %0"))

(define (compiler-backend-phi-return-work-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r14 %2=%r15"))

(define (compiler-backend-phi-return-rejects-work-ok?) : bool
  (asm-ok?
    (compiler-backend-phi-return-entry-asm
      (compiler-backend-phi-return-work-blocks)
      (compiler-backend-single-phi-return-entry-instrs)
      (compiler-backend-phi-return-work-assignments)
      3)
    (has "    movl $7, %r12d\n" "    jmp .L_tl_test_join\n")
    (lacks "    movq %r14, %rax\n")))

(define (compiler-backend-mov-phi-copy-entry-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%2 = mov 7 : i64
     jump join"))

(define (compiler-backend-mov-phi-copy-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = mov 7 : i64
       jump join
     join:
       %0 = phi [%2, entry] : i64
       %1 = mov %0 : i64
       return %1"))

(define (compiler-backend-mov-phi-copy-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%r12 %1=%r13 %2=%r14"))

(define (compiler-backend-mov-phi-copy-fusion-ok?) : bool
  (let
    [blocks : ir.CompilerIrBlockList (compiler-backend-mov-phi-copy-blocks)]
    [use-counts : (__tl_dyn-array i64)
      (backend.compiler-backend-function-use-counts
        3
        (owned_view.compiler-owned-shared-view blocks))]
    [test-id : i64 (ci.intern "test")]
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    (asm-ok?
      (compiler-backend-test-emit-instrs-text
        (be_state.CompilerBackendEmissionContext
          (ast.ast-node-pool-reader-type-segment-bases)
          (be_state.compiler-backend-target-policy-new
            be_state.CompilerBackendTarget.Linux)
          "_tl_test"
          test-id
          blocks
          (ir.compiler-ir-label "entry")
          (compiler-backend-mov-phi-copy-assignments)
          3
          (regalloc.compiler-reg-var-types-empty)
          (Empty)
          (I64)
          (compiler-backend-runtime-helper-full-plan)
          (ir.compiler-ir-function-seq-empty)
          (ir.compiler-ir-extern-seq-empty)
          program-index
          (ir.compiler-source-spans-empty)
          (be_state.compiler-backend-source-span-index-build-with-backend-state
            backend-state
            (ir.compiler-source-spans-empty))
          (cdiag.compiler-diagnostic-at-start "" "")
          use-counts
          backend-state
          (be_state.compiler-backend-state-function-state backend-state))
        (No)
        (compiler-backend-mov-phi-copy-entry-instrs))
      (has "    movl $7, %r12d\n")
      (lacks "    movl $7, %r14d\n" "    movq %r14, %r12\n")
      (has "    jmp .L_tl_test_join\n"))))

;; The cycle fixture's "back" -> "join" edge is a BACK edge: "join" is the first
;; (and only) block, so its P22-B target point is 0, and `emit-instr-post-base`
;; is pinned above it here so the edge runs backward however the preceding
;; tests left that global. The forward case is pinned by
;; `compiler-backend-phi-forward-edge-unbracket-ok?` below.
(define (compiler-backend-phi-parallel-copy-ok?) : bool
  (let
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [prev-count : i64
      (scratch-cycle-temp-used-count
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-base : i64
      (scratch-cycle-temp-base-offset
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-post-base : i64 (state-emit-instr-post-base backend-state)]
    [_set : unit
      (begin
        (set-scratch-cycle-temp-used-count!
          (be_state.compiler-backend-state-function-state backend-state)
          0)
        (set-scratch-cycle-temp-base-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          -512)
        (set-state-emit-instr-post-base! backend-state 8))]
    [ok : bool
      (match (be_calls.compiler-backend-emit-phi-edge-copies
        (ast.ast-node-pool-reader-type-segment-bases)
        (compiler-backend-phi-same-home-assignments)
        (compiler-backend-phi-same-home-blocks)
        (ir.compiler-ir-label "join")
        (ir.compiler-ir-label "entry")
        program-index
        0)
        [(Ok same-home)
          (match (be_calls.compiler-backend-emit-phi-edge-copies
            (ast.ast-node-pool-reader-type-segment-bases)
            (regalloc.compiler-reg-assignment-table-empty)
            (compiler-backend-phi-cycle-blocks)
            (ir.compiler-ir-label "join")
            (ir.compiler-ir-label "back")
            program-index
            0)
            [(Ok cycle)
              (and
                (string.eq same-home "")
                (asm-has? cycle "    movq -8(%rbp), %r10\n")
                (asm-has? cycle "    movq %r10, -512(%rbp)\n")
                (asm-has? cycle "    movq -512(%rbp), %r10\n")
                (asm-has? cycle "    movq %r10, -16(%rbp)\n")
                ;; The spilled mem->mem copy of the break stages through the
                ;; scavenged GP register. #phi-staged-copy proves the register
                ;; free per edge (no register homes exist in this assignment
                ;; table, and no copy dst homes one), so there is no pushq/popq
                ;; bracket and the pair itself is what the shape asserts.
                (asm-has? cycle "    movq -16(%rbp), %r8\n")
                (asm-has? cycle "    movq %r8, -8(%rbp)\n")
                (asm-lacks? cycle "    pushq %r8\n")
                (asm-lacks? cycle "%rax"))]
            [(Err _) false])]
        [(Err _) false])]
    [_restore : unit
      (begin
        (set-scratch-cycle-temp-used-count!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-count)
        (set-scratch-cycle-temp-base-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-base)
        (set-state-emit-instr-post-base! backend-state prev-post-base))]
    ok))

;; P22-B: the same cycle fixture emitted across a FORWARD edge. "join" is the
;; only block, so its target point is 0; pinning `emit-instr-post-base` to 0
;; makes the edge run forward (target at or past the end of the block being
;; emitted). The target-entry query is asked on either kind of edge, so the
;; four marshalling movq lines are unchanged and no pushq/popq staging bracket
;; appears.
(define (compiler-backend-phi-forward-edge-unbracket-ok?) : bool
  (let
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [prev-count : i64
      (scratch-cycle-temp-used-count
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-base : i64
      (scratch-cycle-temp-base-offset
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-post-base : i64 (state-emit-instr-post-base backend-state)]
    [_set : unit
      (begin
        (set-scratch-cycle-temp-used-count!
          (be_state.compiler-backend-state-function-state backend-state)
          0)
        (set-scratch-cycle-temp-base-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          -512)
        (set-state-emit-instr-post-base! backend-state 0))]
    [ok : bool
      (asm-ok?
        (be_calls.compiler-backend-emit-phi-edge-copies
          (ast.ast-node-pool-reader-type-segment-bases)
          (regalloc.compiler-reg-assignment-table-empty)
          (compiler-backend-phi-cycle-blocks)
          (ir.compiler-ir-label "join")
          (ir.compiler-ir-label "back")
          program-index
          0)
        (has
          "    movq -8(%rbp), %r10\n"
          "    movq %r10, -512(%rbp)\n"
          "    movq -512(%rbp), %r10\n"
          "    movq %r10, -16(%rbp)\n")
        (lacks "    pushq %r8\n" "    popq %r8\n"))]
    [_restore : unit
      (begin
        (set-scratch-cycle-temp-used-count!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-count)
        (set-scratch-cycle-temp-base-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-base)
        (set-state-emit-instr-post-base! backend-state prev-post-base))]
    ok))

(define (compiler-backend-phi-group-cycle-copy-ok?) : bool
  (let
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-register-group-test-index)]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [prev-count : i64
      (scratch-cycle-temp-used-count
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-base : i64
      (scratch-cycle-temp-base-offset
        (be_state.compiler-backend-state-function-state backend-state))]
    [_set : unit
      (begin
        (set-scratch-cycle-temp-used-count!
          (be_state.compiler-backend-state-function-state backend-state)
          0)
        (set-scratch-cycle-temp-base-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          -512))]
    [ok : bool
      (asm-ok?
        (be_calls.compiler-backend-emit-phi-edge-copies
          (ast.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-phi-group-cycle-assignments)
          (compiler-backend-phi-group-cycle-blocks)
          (ir.compiler-ir-label "join")
          (ir.compiler-ir-label "back")
          program-index
          4)
        (has
          "    movq %r12, -512(%rbp)\n"
          "    movq %r13, -520(%rbp)\n"
          "    movq %r14, %r12\n"
          "    movq %r15, %r13\n"
          "    movq -520(%rbp), %r15\n"
          "    movq -512(%rbp), %r14\n")
        (lacks "pushq" "popq" "%rax" "%rdx"))]
    [_restore : unit
      (begin
        (set-scratch-cycle-temp-used-count!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-count)
        (set-scratch-cycle-temp-base-offset!
          (be_state.compiler-backend-state-function-state backend-state)
          prev-base))]
    ok))

(define (compiler-backend-phi-group-stack-copy-split-scratch-ok?) : bool
  (let
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-register-group-test-index)]
    [backend-state : be_state.CompilerBackendState index.backend-state]
    [blocks : ir.CompilerIrBlockList
      (irt.blocks "join:
           %1 = phi [%0, entry] : BackendGroupTest")]
    [_group-enable : unit
      (begin
        (be_facts.compiler-backend-current-slot-vars-set! backend-state 2)
        (be_facts.compiler-backend-group-vars-enable!
          backend-state
          (compiler_liveness.compiler-live-set-insert
            (compiler_liveness.compiler-live-set1 0)
            1)
          (compiler_liveness.compiler-live-set-empty)))]
    [copied : be_state.ResultCompilerBackend
      (be_calls.compiler-backend-emit-phi-edge-copies
        (ast.ast-node-pool-reader-type-segment-bases)
        (regalloc.compiler-reg-assignment-table-empty)
        blocks
        (ir.compiler-ir-label "join")
        (ir.compiler-ir-label "entry")
        index
        2)]
    [_group-disable : unit
      (be_facts.compiler-backend-group-vars-disable! backend-state)]
    (match copied
      [(Ok asm)
        (and
          (= (backend.compiler-backend-string-count asm "%rax") 2)
          (= (backend.compiler-backend-string-count asm "%rdx") 2))]
      [(Err _) false])))

;; #10009 review: edge-precise scavenge occupancy reads a register free once the
;; predecessor's last use of it is behind the edge, but phi marshalling may
;; already have placed a final value there -- a drained copy or, as in these
;; fixtures, a same-home Phi filtered out before marshalling (deterministic: it
;; holds its value before the first copy is emitted). Every scratch the edge
;; scavenges must refuse those homes. No scavenge context is installed, so the
;; occupancy model reads every register free, exactly the hazard.
(define (compiler-backend-phi-edge-placed-asm
  [index : be_state.CompilerBackendProgramIndex]
  [assignments : regalloc.CompilerRegAssignmentTable]
  [blocks : ir.CompilerIrBlockList]
  [group-vars : compiler_liveness.CompilerLiveI64Set]
  [vars : i64]) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState index.backend-state]
    [function-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state backend-state)]
    [prev-count : i64 (scratch-cycle-temp-used-count function-state)]
    [prev-base : i64 (scratch-cycle-temp-base-offset function-state)]
    [_set : unit
      (begin
        (set-scratch-cycle-temp-used-count! function-state 0)
        (set-scratch-cycle-temp-base-offset! function-state -512)
        (set-scratch-emergency-slot-offset! function-state -128)
        (be_facts.compiler-backend-current-slot-vars-set! backend-state vars)
        (be_facts.compiler-backend-group-vars-enable!
          backend-state
          group-vars
          (compiler_liveness.compiler-live-set-empty)))]
    [copied : be_state.ResultCompilerBackend
      (be_calls.compiler-backend-emit-phi-edge-copies
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        blocks
        (ir.compiler-ir-label "join")
        (ir.compiler-ir-label "entry")
        index
        vars)]
    [_restore : unit
      (begin
        (be_facts.compiler-backend-group-vars-disable! backend-state)
        (set-scratch-cycle-temp-used-count! function-state prev-count)
        (set-scratch-cycle-temp-base-offset! function-state prev-base))]
    ;; The mask is the marshalling's alone: once the edge is emitted it is back
    ;; to the conservative "no list installed" default.
    (if (=
      (be_calls.compiler-backend-function-state-current-phi-dst-home-mask
        backend-state)
      -1)
      copied
      (Err
        (box
          (cdiag.compiler-diagnostic-at-start
            ""
            "phi dst-home mask outlived its edge"))))))

(define (compiler-backend-phi-edge-group-pair-vars) : compiler_liveness.CompilerLiveI64Set
  (compiler_liveness.compiler-live-set-insert
    (compiler_liveness.compiler-live-set1 0)
    1))

;; (1) A group phi copy stages its words through %rax/%rdx (GP) or
;; %xmm0/%xmm1 (SSE) by default; here those registers hold placed scalar phis.
(define (compiler-backend-phi-group-copy-avoids-placed-ok?) : bool
  (and
    (asm-ok?
      (compiler-backend-phi-edge-placed-asm
        (compiler-backend-register-group-test-index)
        (reg-homes "%0=spill:-16 %1=spill:-32 %2=%rax %3=%rdx %4=%rax %5=%rdx")
        (irt.blocks
          "join:
             %2 = phi [%4, entry] : i64
             %3 = phi [%5, entry] : i64
             %1 = phi [%0, entry] : BackendGroupTest")
        (compiler-backend-phi-edge-group-pair-vars)
        6)
      (has "-16(%rbp)" "-24(%rbp)" "-32(%rbp)" "-40(%rbp)")
      (lacks "%rax" "%eax" "%rdx" "%edx"))
    (asm-ok?
      (compiler-backend-phi-edge-placed-asm
        (compiler-backend-register-group-f64-test-index)
        (reg-homes
          "%0=spill:-16 %1=spill:-32 %2=%xmm0 %3=%xmm1 %4=%xmm0 %5=%xmm1")
        (irt.blocks
          "join:
             %2 = phi [%4, entry] : f64
             %3 = phi [%5, entry] : f64
             %1 = phi [%0, entry] : BackendGroupF64Test")
        (compiler-backend-phi-edge-group-pair-vars)
        6)
      (has "-16(%rbp)" "-24(%rbp)" "-32(%rbp)" "-40(%rbp)")
      (lacks "%xmm0" "%xmm1"))))

;; (2) Spilled phi cycles break through a frame Temp staged in %r10 (GP) and
;; %xmm2 (float) by default; here those registers hold placed scalar phis.
(define (compiler-backend-phi-spill-cycle-temp-avoids-placed-ok?) : bool
  (asm-ok?
    (compiler-backend-phi-edge-placed-asm
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))
      (reg-homes
        "%0=spill:-8 %1=spill:-16 %2=spill:-24 %3=spill:-32 %4=%r10 %5=%xmm2 %6=%r10 %7=%xmm2")
      (irt.blocks
        "join:
           %4 = phi [%6, entry] : i64
           %5 = phi [%7, entry] : f64
           %0 = phi [%1, entry] : i64
           %1 = phi [%0, entry] : i64
           %2 = phi [%3, entry] : f64
           %3 = phi [%2, entry] : f64")
      (compiler_liveness.compiler-live-set-empty)
      8)
    (has "    movq %r9, -512(%rbp)\n" "    movsd %xmm3, -512(%rbp)\n")
    (lacks "%r10" "%xmm2")))

;; (3) A register cycle breaks through a scavenged Temp register. The pair
;; phi drained first into %rcx/%r9; its HIGH half %r9 is the first pool
;; candidate and must not become the Temp.
(define (compiler-backend-phi-reg-cycle-temp-avoids-pair-hi-ok?) : bool
  (asm-ok?
    (compiler-backend-phi-edge-placed-asm
      (compiler-backend-register-group-test-index)
      (reg-homes "%0=%rcx/%r9 %1=spill:-16 %2=%rdx %3=%r10")
      (irt.blocks
        "join:
           %0 = phi [%1, entry] : BackendGroupTest
           %2 = phi [%3, entry] : i64
           %3 = phi [%2, entry] : i64")
      (compiler-backend-phi-edge-group-pair-vars)
      4)
    (has ", %rcx\n" ", %r9\n")
    (lacks "    movq %r9, " "    movq %rdx, %r9\n" "    movq %r10, %r9\n")))

(test
  backend-phi-edge-scratch-avoids-placed-values
  (test.assert-true
    (compiler-backend-phi-group-copy-avoids-placed-ok?)
    "group phi copy scratch avoids placed phi destinations")
  (test.assert-true
    (compiler-backend-phi-spill-cycle-temp-avoids-placed-ok?)
    "spilled phi cycle Temp staging avoids placed phi destinations")
  (test.assert-true
    (compiler-backend-phi-reg-cycle-temp-avoids-pair-hi-ok?)
    "register phi cycle Temp avoids both halves of a placed pair"))

(define (compiler-backend-phi-float-cycle-copy-ok?) : bool
  (let
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    (and
      (asm-ok?
        (be_calls.compiler-backend-emit-phi-edge-copies
          (ast.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-phi-f64-cycle-assignments)
          (compiler-backend-phi-f64-cycle-blocks)
          (ir.compiler-ir-label "join")
          (ir.compiler-ir-label "back")
          index
          2)
        (has "    movsd %xmm2, -512(%rbp)\n" "    movsd -512(%rbp), %xmm3\n"))
      (asm-ok?
        (be_calls.compiler-backend-emit-phi-edge-copies
          (ast.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-phi-f32-three-cycle-assignments)
          (compiler-backend-phi-f32-three-cycle-blocks)
          (ir.compiler-ir-label "join")
          (ir.compiler-ir-label "back")
          index
          3)
        (has "    movss %xmm2, -512(%rbp)\n" "    movss -512(%rbp), %xmm5\n")
        (lacks "movsd"))
      (asm-ok?
        (be_calls.compiler-backend-emit-phi-edge-copies
          (ast.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-phi-f64-spill-cycle-assignments)
          (compiler-backend-phi-f64-cycle-blocks)
          (ir.compiler-ir-label "join")
          (ir.compiler-ir-label "back")
          index
          2)
        (has "-512(%rbp)")
        (lacks "    movsd -16(%rbp), %xmm4\n"))
      (asm-ok?
        (be_calls.compiler-backend-emit-phi-edge-copies
          (ast.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-phi-group-f64-cycle-assignments)
          (compiler-backend-phi-group-f64-cycle-blocks)
          (ir.compiler-ir-label "join")
          (ir.compiler-ir-label "back")
          (compiler-backend-register-group-f64-test-index)
          4)
        (has
          "    movq %xmm2, -512(%rbp)\n"
          "    movq %xmm3, -520(%rbp)\n"
          "    movq -520(%rbp), %xmm5\n"
          "    movq -512(%rbp), %xmm4\n")
        (lacks "%rsp" "%xmm14" "%xmm15")))))

(define (compiler-backend-arg-cycle-temp-slot-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [restore : be_state.ResultCompilerBackend
      (be_calls.compiler-backend-emit-arg-move
        (regalloc.compiler-reg-assignment-table-empty)
        (BackendArgMove cabi.compiler-reg-id-rsi BackendArgMoveStackPop)
        backend-state)]
    [ok : bool
      (match restore
        [(Ok restore-asm)
          (let
            [save-asm : String
              (be_calls.compiler-backend-emit-arg-cycle-temp-save
                cabi.compiler-reg-id-rdi
                backend-state)]
            [asm : String (str_cat.str-cat save-asm restore-asm)]
            (and
              (asm-has?
                asm
                "    movq %rdi, -512(%rbp)\n"
                "    movq -512(%rbp), %rsi\n")
              (asm-lacks? asm "pushq" "popq" "%rsp")))]
        [(Err _) false])]
    ok))

(define (compiler-backend-base1-arg-cycle-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%rdx %1=%rsi")]
    [args : ir.CompilerIrCallArgs (Two (Var 0) (Var 1))]
    (asm-ok?
      (let
        [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
        [target (be_state.CompilerBackendTarget.Linux)]
        [types (compiler-backend-i64-type-list8)]
        [func-diag (cdiag.compiler-diagnostic-at-start "" "")]
        (be_calls.compiler-backend-emit-call-args
          type-segment-bases
          target
          (Platform)
          assignments
          args
          types
          false
          0
          1
          0
          1
          0
          func-diag
          (compiler-backend-program-index-build
            (ast.ast-node-pool-reader-type-segment-bases)
            (ir.compiler-ir-function-seq-empty)
            (ir.compiler-ir-extern-seq-empty))
          2
          (be_state.compiler-backend-state-new
            (ci.intern-compat-state-capture-active))))
      (has ", %rsi\n" ", %rdx\n")
      (lacks "%rdi"))))

(define (compiler-backend-base1-arg-env-source-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%rdi %1=%rsi")]
    [args : ir.CompilerIrCallArgs (Two (Var 0) (Var 1))]
    (asm-ok?
      (let
        [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
        [target (be_state.CompilerBackendTarget.Linux)]
        [types (compiler-backend-i64-type-list8)]
        [func-diag (cdiag.compiler-diagnostic-at-start "" "")]
        (be_calls.compiler-backend-emit-call-args
          type-segment-bases
          target
          (Platform)
          assignments
          args
          types
          false
          0
          1
          0
          1
          0
          func-diag
          (compiler-backend-program-index-build
            (ast.ast-node-pool-reader-type-segment-bases)
            (ir.compiler-ir-function-seq-empty)
            (ir.compiler-ir-extern-seq-empty))
          2
          (be_state.compiler-backend-state-new
            (ci.intern-compat-state-capture-active))))
      (has "    movq %rsi, %rdx\n    movq %rdi, %rsi\n"))))

(define (compiler-backend-var-call-args [count : i64]) : ir.CompilerIrCallArgs
  (let
    [seq : ir.CompilerIrValueSeq (ir.compiler-ir-value-seq-empty)]
    [i : i64 count]
    (while (> i 0)
      (set! i (- i 1))
      (set! seq (ir.compiler-ir-value-seq-prepend (& (Var i)) (& seq))))
    (ir.compiler-ir-call-args-from-seq (& seq))))

;; One type per letter: `f` is f64, anything else i64.
(define (compiler-backend-type-list-of [classes : (& classes str)]) : ast.AstTypeList
  (let
    [count : i64 (string.string-length classes)]
    [out : ast.AstTypeList (ast.ast-type-list-with-capacity count)]
    [i : i64 0]
    (while (< i count)
      (ast.ast-type-list-push
        (&mut out)
        (ast.ast-node-pool-reader-type-push
          (&
            (if (= (string.index-of-byte classes i (cast 'f' : u8)) i)
              (F64)
              (I64)))))
      (set! i (+ i 1)))
    out))

;; A tail call whose arguments of both classes sit in each other's argument
;; registers: an XMM swap (%xmm0 <-> %xmm1) and a GP swap (%rdi <-> %rsi). The
;; parallel marshalling breaks the XMM cycle through the cycle-temp slot.
(define (compiler-backend-tail-parallel-two-class-cycle-ok?) : bool
  (asm-ok?
    (be_calls.compiler-backend-emit-direct-tail-call-args-parallel
      (ast.ast-node-pool-reader-type-segment-bases)
      (be_state.CompilerBackendTarget.Linux)
      (Platform)
      (reg-homes "%0=%xmm1 %1=%xmm0 %2=%rsi %3=%rdi")
      (& (compiler-backend-var-call-args 4))
      (& (compiler-backend-type-list-of "ffii"))
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has
      "    movsd %xmm"
      ", -512(%rbp)\n"
      "    movsd -512(%rbp), %xmm"
      ", %xmm0\n"
      ", %xmm1\n"
      ", %rdi\n"
      ", %rsi\n")
    (lacks "%rsp" "movq %xmm")))

;; A Win64 tail call whose fifth argument (a stack slot) is read out of %xmm0,
;; which the first argument overwrites: the stack store comes first.
(define (compiler-backend-tail-parallel-xmm-stack-store-first-ok?) : bool
  (match (be_calls.compiler-backend-emit-direct-tail-call-args-parallel
    (ast.ast-node-pool-reader-type-segment-bases)
    (be_state.CompilerBackendTarget.Windows)
    (Platform)
    (reg-homes "%4=%xmm0")
    (& (compiler-backend-var-call-args 5))
    (& (compiler-backend-type-list-of "ffiif"))
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm)
      (let
        [first : String "    movsd %xmm0, 16(%rbp)\n"]
        (and
          (>= (string.string-length asm) (string.string-length first))
          (string.eq
            ;; The length was checked above.
            (unsafe
              (string.substring-copy-checked asm 0 (string.string-length first)))
            first)
          (be_operand.compiler-backend-string-contains? asm ", %xmm0\n")))]
    [(Err _) false]))

(define (compiler-backend-c-abi-arg-cycle-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%rsi %1=%rdi")]
    [args : ir.CompilerIrCallArgs (Two (Var 0) (Var 1))]
    (asm-ok?
      (let
        [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
        [target (be_state.CompilerBackendTarget.Linux)]
        [types (compiler-backend-i64-type-list8)]
        [func-diag (cdiag.compiler-diagnostic-at-start "" "")]
        (be_calls.compiler-backend-emit-call-args
          type-segment-bases
          target
          (Platform)
          assignments
          args
          types
          true
          0
          0
          0
          0
          0
          func-diag
          (compiler-backend-program-index-build
            (ast.ast-node-pool-reader-type-segment-bases)
            (ir.compiler-ir-function-seq-empty)
            (ir.compiler-ir-extern-seq-empty))
          2
          (be_state.compiler-backend-state-new
            (ci.intern-compat-state-capture-active))))
      (has ", %rdi\n" ", %rsi\n")
      (lacks "    movq %rsi, %rdi\n    movq %rdi, %rsi\n"))))

(define (compiler-backend-reg-is?
  [r : be_state.ResultBackendReg]
  [name : String]) : bool
  (match r
    [(Ok reg) (string.eq reg name)]
    [(Err _) false]))

(define (compiler-backend-reg-err? [r : be_state.ResultBackendReg]) : bool
  (match r
    [(Ok _) false]
    [(Err _) true]))

;; The target model: per-target arg registers / shadow space /
;; entry symbol; the Linux path is byte-identical to the default emitter and the
;; Windows path emits ABI-shaped user-function assembly and runtime helpers
;; without Linux syscalls.
(define (compiler-backend-target-model-ok? [src : String]) : bool
  (and
    (compiler-backend-reg-is?
      (be_facts.compiler-backend-target-arg-reg
        (be_state.CompilerBackendTarget.Linux)
        (Platform)
        0)
      "%rdi")
    (compiler-backend-reg-is?
      (be_facts.compiler-backend-target-arg-reg
        (be_state.CompilerBackendTarget.Windows)
        (Platform)
        0)
      "%rcx")
    (compiler-backend-reg-is?
      (be_facts.compiler-backend-target-arg-reg
        (be_state.CompilerBackendTarget.Windows)
        (Platform)
        3)
      "%r9")
    (compiler-backend-reg-err?
      (be_facts.compiler-backend-target-arg-reg
        (be_state.CompilerBackendTarget.Windows)
        (Platform)
        4))
    (=
      (be_facts.compiler-backend-outgoing-shadow-space
        (be_state.CompilerBackendTarget.Linux)
        (Platform))
      0)
    (=
      (be_facts.compiler-backend-outgoing-shadow-space
        (be_state.CompilerBackendTarget.Windows)
        (Platform))
      32)
    (=
      (be_facts.compiler-backend-outgoing-shadow-space
        (be_state.CompilerBackendTarget.Windows)
        (Internal))
      0)
    (let
      [text
        (compiler-backend-target-entry-text
          (be_state.CompilerBackendTarget.Linux)
          true)]
      (asm-has? text "_tl_start"))
    (let
      [text
        (compiler-backend-target-entry-text
          (be_state.CompilerBackendTarget.Windows)
          true)]
      (asm-has? text ".globl main"))
    (compiler-backend-target-linux-no-entry-ok?
      (owned_view.compiler-owned-shared-view src))
    (compiler-backend-target-linux-crt-entry-ok?)
    (compiler-backend-target-linux-matches-default? src)
    (compiler-backend-target-windows-abi-ok?)
    (compiler-backend-target-windows-callee-save-ok?)
    (compiler-backend-target-windows-stack-probe-ok?)
    (compiler-backend-target-windows-runtime-ok?)))

(define (compiler-backend-target-linux-matches-default? [src : String]) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (owned_view.compiler-owned-shared-view src)
    (be_state.CompilerBackendTarget.Linux))
    [(Ok linux-asm)
      (match (backend.compiler-backend-emit-source src)
        [(Ok default-asm) (string.eq linux-asm default-asm)]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-target-linux-no-entry-ok? [src : String]) : bool
  (match (lower.lower-compiler-source src)
    [(Ok program spans lower-owner)
      (let
        [result : bool
          (asm-ok?
            (compiler-backend-emit-program-with-spans-for-target-and-entry
              program
              spans
              (be_state.CompilerBackendTarget.Linux)
              false)
            (has ".text\n" "main:\n")
            (lacks ".globl _tl_start\n" "_tl_start:\n"))]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        result)]
    [(Err _) false]))

(define (compiler-backend-target-linux-crt-entry-source) : String
  "(extern (arg-count) : i64 (:symbol \"tl_arg_count\"))
(define (seed) : i64 41)
(define value
  (seed))
(define (main) : i64
  (+ value (arg-count)))")

(define (compiler-backend-target-linux-crt-entry-ok?) : bool
  (match (lower.lower-compiler-source
    (compiler-backend-target-linux-crt-entry-source))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (backend.compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
            (be_state.compiler-backend-state-new
              (ci.intern-compat-state-capture-active))
            (ast.ast-node-pool-reader-type-segment-bases)
            program
            (be_state.CompilerBackendTarget.Linux)
            (Scalar)
            spans
            true
            true
            (profile_state.compiler-profile-state-new))
            [(Ok buf)
              (let
                [asm : String (text_buf.render buf)]
                (and
                  (let
                    [text
                      (be_data.compiler-backend-target-entry-text-with-crt
                        (be_state.CompilerBackendTarget.Linux)
                        true
                        true)]
                    (asm-has? text ".globl main"))
                  (asm-has?
                    asm
                    "main:\n"
                    "    movq %rdi, .L_tl_argc(%rip)\n"
                    "    call _tl___global_init_")
                  (asm-lacks? asm ".globl _tl_start\n" "_tl_start:\n")))]
            [(Err _) false])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-target-windows-stack-probe-ok?) : bool
  (let
    [win : String
      (be_scalar.compiler-backend-emit-stack-sub
        (be_state.compiler-backend-target-policy-new
          be_state.CompilerBackendTarget.Windows)
        4800)]
    [linux : String
      (be_scalar.compiler-backend-emit-stack-sub
        (be_state.compiler-backend-target-policy-new
          be_state.CompilerBackendTarget.Linux)
        4800)]
    (and
      (asm-has?
        win
        "    movl $4800, %eax\n"
        "    callq __chkstk\n"
        "    subq %rax, %rsp\n")
      (asm-lacks? win "    subq $4800, %rsp\n")
      (asm-has? linux "    subq $4800, %rsp\n")
      (asm-lacks? linux "__chkstk"))))

(test
  linux-stack-probe-final-decrements
  (let
    [policy
      (be_state.compiler-backend-target-policy-new
        (be_state.CompilerBackendTarget.Linux))]
    [sizes : (Array i64 15)
      (array
        0
        128
        4080
        4096
        4104
        8192
        8200
        32760
        32768
        32776
        65536
        262144
        1048576
        1073741808
        1073741824)]
    (for [index (iterator.range 0 15)]
      (let
        [size : i64 (array-ref sizes index)]
        [text : String
          (if (> size 32768)
            (be_operand.compiler-backend-emit-stack-probe size)
            (be_scalar.compiler-backend-emit-stack-sub policy size))]
        [object : String
          (be_object.compiler-backend-object-prologue-bytes
            (be_state.CompilerBackendTarget.Linux)
            size)]
        (if (<= size 32768)
          (test.assert-true
            (string.eq
              (if (> size 4096)
                (string.substring text 17 (- (string.string-length text) 17))
                text)
              (if (= size 0)
                ""
                (str_cat.str-cat
                  "    subq $"
                  (string.int->string size)
                  ", %rsp\n")))
            "subthreshold entry keeps its exact physical subtraction")
          (begin
            (test.assert-true
              (asm-has?
                text
                "    pushq %r11\n"
                "    testb $0, (%rsp)\n"
                (str_cat.str-cat
                  "    movq "
                  (string.int->string (- size 8))
                  "(%rsp), %r11\n"))
              "large allocation probes and restores a live R11")
            (test.assert-true
              (<= (string.string-length (& object)) 52)
              "object probe is constant-size through the 1 GiB boundary")))))))

(test
  linux-stack-probes-expand-after-record-passes
  (let
    [state
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [stream (be_state.compiler-backend-state-stream-state state)]
    [records
      (be_peephole.compiler-backend-peephole-asm-once-records
        state
        stream
        "    subq $8200, %rsp\n    movq %r11, (%rsp)\n    addq $8200, %rsp\n    subq $4096, %rsp\n"
        true)]
    (test.assert-true
      (= records.probe-cand-len 1)
      "only a surviving physical decrement above 4096 is recorded")
    (be_peephole.compiler-backend-expand-stack-probes! state (&mut records))
    (let
      [text : String
        (be_peephole.compiler-backend-peephole-records-render records true true)]
      (test.assert-true
        (asm-has?
          text
          "    pushq %r11\n"
          "    movq 8192(%rsp), %r11\n"
          "    movq %r11, (%rsp)\n"
          "    subq $4096, %rsp\n")
        "late expansion preserves a live indirect target and the small dip"))
    (backend.compiler-backend-state-release-final-arenas! state)))

(test
  win64-unwind-lowering-shares-records-and-drops-leaves
  (let
    [state
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [stream (be_state.compiler-backend-state-stream-state state)]
    [push-alloc : String
      "    pushq %r12\n    .seh_pushreg %r12\n    subq $128, %rsp\n    .seh_stackalloc 128\n    .seh_endprologue\n"]
    [text : String
      (str_cat.str-cat
        ".seh_proc f1\nf1:\n"
        push-alloc
        "    call g\n    addq $128, %rsp\n    popq %r12\n    ret\n    .seh_endproc\n\n.seh_proc f2\nf2:\n"
        push-alloc
        "    addq $128, %rsp\n    popq %r12\n    ret\n    .seh_endproc\n\n"
        ".seh_proc leaf\nleaf:\n    .seh_endprologue\n    movq %rcx, %rax\n    ret\n    .seh_endproc\n\n"
        ".seh_proc calls\ncalls:\n    .seh_endprologue\n    call g\n    ret\n    .seh_endproc\n\n"
        ".seh_proc big\nbig:\n    movl $8192, %eax\n    callq __chkstk\n    subq %rax, %rsp\n    .seh_stackalloc 8192\n    .seh_endprologue\n    ret\n    .seh_endproc\n\n"
        ".seh_proc huge\nhuge:\n    subq $1048576, %rsp\n    .seh_stackalloc 1048576\n    .seh_endprologue\n    ret\n    .seh_endproc\n\n"
        ".seh_proc framed\nframed:\n    pushq %rbp\n    .seh_pushreg %rbp\n    movq %rsp, %rbp\n    .seh_setframe %rbp, 0\n    .seh_endprologue\n    leave\n    ret\n    .seh_endproc\n")]
    [lowered : String
      (be_peephole.compiler-backend-win64-lower-unwind
        stream
        text
        (arena.current))]
    (test.assert-owned-string-eq
      lowered
      (str_cat.str-cat
        "f1:\n    pushq %r12\n    subq $128, %rsp\n    call g\n    addq $128, %rsp\n    popq %r12\n    ret\n"
        ".L_tl_seh_end_0:\n    .pushsection .xdata,\"dr\"\n    .p2align 2\n.L_tl_xdata_0:\n    .byte 1, 9, 2, 0\n    .byte 9, 242    # UWOP_ALLOC_SMALL 128\n    .byte 2, 192    # UWOP_PUSH_NONVOL %r12\n    .popsection\n"
        "    .pushsection .pdata,\"dr\"\n    .rva f1, .L_tl_seh_end_0, .L_tl_xdata_0\n    .popsection\n\n"
        "f2:\n    pushq %r12\n    subq $128, %rsp\n    addq $128, %rsp\n    popq %r12\n    ret\n"
        ".L_tl_seh_end_1:\n    .pushsection .pdata,\"dr\"\n    .rva f2, .L_tl_seh_end_1, .L_tl_xdata_0\n    .popsection\n\n"
        "leaf:\n    movq %rcx, %rax\n    ret\n\n"
        "calls:\n    call g\n    ret\n"
        ".L_tl_seh_end_2:\n    .pushsection .xdata,\"dr\"\n    .p2align 2\n.L_tl_xdata_1:\n    .byte 1, 0, 0, 0\n    .byte 0, 0, 0, 0\n    .popsection\n"
        "    .pushsection .pdata,\"dr\"\n    .rva calls, .L_tl_seh_end_2, .L_tl_xdata_1\n    .popsection\n\n"
        "big:\n    movl $8192, %eax\n    callq __chkstk\n    subq %rax, %rsp\n    ret\n"
        ".L_tl_seh_end_3:\n    .pushsection .xdata,\"dr\"\n    .p2align 2\n.L_tl_xdata_2:\n    .byte 1, 13, 2, 0\n    .byte 13, 1, 0, 4    # UWOP_ALLOC_LARGE 8192\n    .popsection\n"
        "    .pushsection .pdata,\"dr\"\n    .rva big, .L_tl_seh_end_3, .L_tl_xdata_2\n    .popsection\n\n"
        "huge:\n    subq $1048576, %rsp\n    ret\n"
        ".L_tl_seh_end_4:\n    .pushsection .xdata,\"dr\"\n    .p2align 2\n.L_tl_xdata_3:\n    .byte 1, 7, 3, 0\n    .byte 7, 17, 0, 0, 16, 0    # UWOP_ALLOC_LARGE 1048576\n    .byte 0, 0\n    .popsection\n"
        "    .pushsection .pdata,\"dr\"\n    .rva huge, .L_tl_seh_end_4, .L_tl_xdata_3\n    .popsection\n\n"
        ".seh_proc framed\nframed:\n    pushq %rbp\n    .seh_pushreg %rbp\n    movq %rsp, %rbp\n    .seh_setframe %rbp, 0\n    .seh_endprologue\n    leave\n    ret\n    .seh_endproc\n")
      "push/alloc/probe prologues share interned records, leaves drop, frames keep directives")
    (backend.compiler-backend-state-release-final-arenas! state)))

(test
  win64-unwind-lowering-associates-comdat-pdata
  (let
    [state
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [stream (be_state.compiler-backend-state-stream-state state)]
    [body : String
      "    subq $40, %rsp\n    .seh_stackalloc 40\n    .seh_endprologue\n    call g\n    addq $40, %rsp\n    ret\n    .seh_endproc\n"]
    [text : String
      (str_cat.str-cat
        ".section .text,\"xr\",one_only,a\n.globl a\n.seh_proc a\na:\n"
        body
        ".section .text,\"xr\",one_only,b\n.globl b\n.seh_proc b\nb:\n"
        body
        "    .text\n.seh_proc c\nc:\n"
        body)]
    [lowered : String
      (be_peephole.compiler-backend-win64-lower-unwind
        stream
        text
        (arena.current))]
    [plain-body : String
      "    subq $40, %rsp\n    call g\n    addq $40, %rsp\n    ret\n"]
    (test.assert-owned-string-eq
      lowered
      (str_cat.str-cat
        ".section .text,\"xr\",one_only,a\n.globl a\na:\n"
        plain-body
        ".L_tl_seh_end_0:\n    .pushsection .xdata,\"dr\"\n    .p2align 2\n.L_tl_xdata_0:\n    .byte 1, 4, 1, 0\n    .byte 4, 66    # UWOP_ALLOC_SMALL 40\n    .byte 0, 0\n    .popsection\n"
        "    .pushsection .pdata,\"dr\",associative,a\n    .rva a, .L_tl_seh_end_0, .L_tl_xdata_0\n    .popsection\n"
        ".section .text,\"xr\",one_only,b\n.globl b\nb:\n"
        plain-body
        ".L_tl_seh_end_1:\n    .pushsection .pdata,\"dr\",associative,b\n    .rva b, .L_tl_seh_end_1, .L_tl_xdata_0\n    .popsection\n"
        "    .text\nc:\n"
        plain-body
        ".L_tl_seh_end_2:\n    .pushsection .pdata,\"dr\"\n    .rva c, .L_tl_seh_end_2, .L_tl_xdata_0\n    .popsection\n")
      "COMDAT functions get associative .pdata rows; plain .text keeps a plain row")
    (backend.compiler-backend-state-release-final-arenas! state)))

(test
  win64-object-unwind-shares-identical-records
  (let
    [bytes : String
      (object_windows.compiler-backend-object-entry-range-unwind-bytes
        40
        4
        false)]
    [parts : object_target.CompilerBackendObjectTargetParts
      (object_windows.compiler-backend-object-add-unwind
        (object_windows.compiler-backend-object-add-unwind
          (object_target.compiler-backend-object-parts-empty)
          "a"
          "a$end"
          (string.copy (& bytes)))
        "b"
        "b$end"
        bytes)]
    (test.assert-i64-eq
      (array-ref parts.metadata 1).count
      3
      "identical unwind bytes keep one aligned, labeled record")
    (test.assert-true
      (and
        (cobj.compiler-object-relocation-builder-targets?
          (& parts.relocations)
          "a$unwind")
        (not
          (cobj.compiler-object-relocation-builder-targets?
            (& parts.relocations)
            "b$unwind")))
      "the second range's .pdata row names the first range's record")))

(test
  linux-stack-probes-whole-text-finalizer
  (let
    [linux : String
      (backend.compiler-backend-peephole-asm-drop-fallthrough-target
        "    subq $8200, %rsp\n    movq %r11, (%rsp)\n"
        (be_state.CompilerBackendTarget.Linux)
        true)]
    [windows : String
      (backend.compiler-backend-peephole-asm-drop-fallthrough-target
        "    subq $8200, %rsp\n    movq %r11, (%rsp)\n"
        (be_state.CompilerBackendTarget.Windows)
        true)]
    (test.assert-true
      (asm-has? linux "    pushq %r11\n" "    movq 8192(%rsp), %r11\n")
      "the PIC whole-text boundary expands Linux probes")
    (test.assert-true
      (string.eq windows "    subq $8200, %rsp\n    movq %r11, (%rsp)\n")
      "the whole-text boundary leaves Windows unchanged")))

(test
  linux-stack-entry-transient-classification
  (let
    [text : String
      (backend.compiler-backend-peephole-asm-drop-fallthrough-target
        "# tl-stack-entry\n    subq $32768, %rsp\n    subq $4096, %rsp\n    movq %r11, (%rsp)\n    addq $4096, %rsp\n# tl-stack-entry\n    subq $32776, %rsp\n    movq %r11, (%rsp)\n    addq $32776, %rsp\n    subq $4104, %rsp\n    movq %r11, (%rsp)\n"
        (be_state.CompilerBackendTarget.Linux)
        true)]
    (test.assert-true
      (asm-has? text "    subq $32768, %rsp\n    subq $4096, %rsp\n")
      "entry 32768 plus balanced transient 4096 remains unprobed")
    (test.assert-true
      (asm-has?
        text
        "    movq 32768(%rsp), %r11\n"
        "    movq 4096(%rsp), %r11\n")
      "entry 32776 and unclassified/transient 4104 are probed")
    (test.assert-true
      (asm-lacks? text "# tl-stack-entry")
      "producer markers are consumed before final rendering")))

(define (compiler-backend-target-windows-abi-source) : String
  "(extern (ext [arg0 : i64] [arg1 : i64] [arg2 : i64] [arg3 : i64] [arg4 : i64]) : i64)
(define (call5 [a : i64] [b : i64] [c : i64] [d : i64] [e : i64]) : i64
  (ext a b c d e))
(define (main) : i64
  (call5 1 2 3 4 5))")

(define (compiler-backend-target-windows-abi-ok?) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-target-windows-abi-source)
    (be_state.CompilerBackendTarget.Windows))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (asm-has? asm ".globl main\n")
          (asm-lacks? asm "\n_start:\n")
          (asm-lacks? asm "syscall\n")
          ;; The Internal entry captures its fifth word from RSI; forwarding
          ;; to the C extern still writes that word after the Win64 home area.
          (asm-has? asm "    movq %rcx, 88(%rsp)\n")
          (asm-has? asm "    movq %rdx, 80(%rsp)\n")
          (asm-has? asm "    movq %r8, 72(%rsp)\n")
          (asm-has? asm "    movq %r9, 64(%rsp)\n")
          (asm-has? asm "    movq %rsi, 56(%rsp)\n"))
        (asm-has? asm "    movq %r10, 32(%rsp)\n")
        (asm-lacks? asm "    movq %r11, 32(%rsp)\n")
        (asm-has? asm "    call ext\n"))]
    [(Err _) false]))

(define (compiler-backend-target-windows-callee-save-ok?) : bool
  (let
    [ok : bool
      (match (backend.compiler-backend-lower-source-for-target
        ;; Keep every value live across a call so this remains an allocated
        ;; frame/SEH control when six register arguments need no local slots.
        (str_cat.str-cat
          "(extern (callee-save-sink) : unit)\n"
          (string.replace
            (compiler-backend-callee-save-source)
            "[v5 : i64 (+ f 6)]"
            "[v5 : i64 (+ f 6)]\n    (callee-save-sink)"))
        (be_state.CompilerBackendTarget.Windows))
        [(Ok program spans lower-owner)
          (let
            [result : bool
              (let
                [backend-state : be_state.CompilerBackendState
                  (be_state.compiler-backend-state-new
                    (ci.intern-compat-state-capture-active))]
                (be_state.compiler-backend-state-set-scalar-registers-enabled!
                  backend-state
                  true)
                (match (compiler-backend-test-emit-program-with-state
                  backend-state
                  (be_state.CompilerBackendTarget.Windows)
                  program
                  spans
                  true)
                  [(Ok asm)
                    (let
                      [body : String
                        (compiler-backend-asm-function-body asm "_tl_heavy")]
                      (and
                        (not (string.eq body ""))
                        (asm-has? body ".seh_stackalloc " ".seh_endprologue\n")
                        (asm-lacks? body ".seh_setframe" "movq %rsp, %rbp")))]
                  [(Err _) false]))]
            (lower.compiler-lower-arena-state-release!
              (lower.compiler-lower-state-arenas lower-owner))
            result)]
        [(Err _) false])]
    ok))

(define (compiler-backend-target-windows-runtime-ok?) : bool
  (match (backend.compiler-backend-emit-program-for-target
    (backend.compiler-backend-runtime-helper-program)
    (be_state.CompilerBackendTarget.Windows))
    [(Ok asm)
      (let
        [kernel-io
          : bool
          ;; tl_alloc obtains memory via VirtualAlloc and, on exhaustion,
          ;; tail-jumps to the `tl_oom_abort` runtime-prelude handler —
          ;; it does not inline a kernel32 WriteFile for the OOM message.
          (be_state.backend-and4
            (asm-has? asm ".globl tl_alloc\n")
            (asm-has? asm "    call VirtualAlloc\n")
            (asm-has?
              asm
              ".L_tl_alloc_abort:\n    sub $32, %rsp\n    call tl_oom_abort\n")
            (asm-lacks? asm "    call _write\n"))]
        [no-process-runtime : bool
          (be_state.backend-and4
            (asm-lacks? asm "    call _lseeki64\n")
            (asm-lacks? asm "    call _read\n")
            (asm-lacks? asm "tl_process_output:\n")
            (asm-lacks? asm "tmpfile:\n"))]
        [string-runtime : bool
          (be_state.backend-and8
            (asm-has? asm "    call tl_substring\n")
            (asm-has? asm "    call tl_string_concat\n")
            (asm-lacks?
              asm
              "tl_substring:\n"
              "tl_string_concat:\n"
              "tl_int_to_string:\n")
            (asm-lacks? asm "tl_string_eq:\n" "tl_string_to_int:\n")
            (asm-lacks?
              asm
              ".extern tl_substring\n"
              ".extern tl_string_concat\n"
              ".extern tl_int_to_string\n")
            (asm-lacks? asm "tl_random_system_seed:\n")
            (asm-lacks? asm ".extern tl_random_system_seed\n")
            (compiler-backend-no-stdlib-forwarding-labels?
              (owned_view.compiler-owned-shared-view asm)))]
        [entry-shape : bool
          (be_state.backend-and4
            (asm-has? asm "    movq %rcx, .L_tl_argc(%rip)\n")
            (asm-has? asm "    .extern VirtualAlloc\n")
            (asm-lacks? asm "syscall\n")
            (asm-lacks? asm ".globl _start\n"))]
        [private-file-handles : bool
          (asm-lacks? asm ".L_tl_file_handle_next:\n")]
        [driver-runtime : bool
          (backend.compiler-backend-windows-driver-runtime-ok?)]
        [no-advapi-random : bool (asm-lacks? asm "SystemFunction036")]
        (be_state.backend-and8
          kernel-io
          true
          no-process-runtime
          string-runtime
          entry-shape
          private-file-handles
          driver-runtime
          no-advapi-random))]
    [(Err message) false]))

(define (compiler-backend-windows-runtime-guard-source) : String
  "(extern (tl_alloc [arg0 : u64]) : u64)
(extern (tl_region_reset [arg0 : u64]) : unit)
(define (main) : u64
  (begin
    (tl_region_reset (cast 0 : u64))
    (tl_alloc (cast 0 : u64))))")

(define (compiler-backend-windows-runtime-guard-ok?) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-windows-runtime-guard-source)
    (be_state.CompilerBackendTarget.Windows))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (asm-has? asm "tl_alloc:\n")
          (asm-has?
            asm
            "    testq %rcx, %rcx\n    jnz .L_tl_alloc_win_size_ready\n")
          (asm-lacks?
            asm
            "    testq %rcx, %rcx\n    jg .L_tl_alloc_win_size_ready\n")
          (asm-has? asm "    jc .L_tl_alloc_enter_abort\n")
          (asm-has?
            asm
            ".L_tl_region_reset_win_invalid:\n"
            "    sub $32, %rsp\n    call tl_region_abort\n")
          ;; The allocator still delegates to the `tl_oom_abort`
          ;; runtime-prelude handler. The direct GetStdHandle/WriteFile paths
          ;; left in the backend runtime report main-fiber reservation failure
          ;; before user code starts and an unhandled stack overflow.
          (be_state.backend-and4
            (asm-has?
              asm
              ".L_tl_alloc_abort:\n    sub $32, %rsp\n    call tl_oom_abort\n")
            (asm-lacks? asm ".L_tl_win_write_abort")
            (asm-has?
              asm
              ".L_tl_main_stack_reservation_failed:\n    movl $-12, %ecx\n    call GetStdHandle\n")
            (asm-has?
              asm
              "    call WriteFile\n    movl $134, %ecx\n    call ExitProcess\n"))
          (asm-has? asm "    push %r14\n    movq %rcx, %r12\n")
          (asm-lacks?
            asm
            "    push %r14\n    sub $8, %rsp\n    movq %rcx, %r12\n"))
        (asm-lacks? asm "syscall\n" "    .extern _write\n" "    .extern exit\n"))]
    [(Err _) false]))

(define (compiler-backend-syscall-source) : String
  "(define (ptr-i64 [p : (Ptr u8)]) : i64
  (cast (unsafe (ptr->int p)) : i64))

(define (main) : i64
  (let
    [message : String \"syscall-ok\\n\"]
    [addr : i64 (ptr-i64 (unsafe (string-data message)))]
    [wrote : i64 (unsafe (syscall 1 1 addr (__tl_string_length message)))]
    [bad-read : i64 (unsafe (syscall 0 -1 addr 1))]
    (if (if (= wrote (__tl_string_length message)) (= bad-read -9) false)
      (begin
        (unsafe (syscall 231 42))
        1)
      2)))")

(define (compiler-backend-syscall-source-linux-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-syscall-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (asm-has? asm "    syscall\n")
          (asm-has? asm ", %rax\n")
          (asm-has? asm ", %rdi\n")
          (asm-has? asm ", %rsi\n")
          (asm-has? asm ", %rdx\n")
          (asm-has? asm "    movq $231,")
          (asm-has? asm "    movq $42,")
          true)
        (asm-lacks?
          asm
          "    pushq %rax\n"
          "    popq %rax\n"
          ".extern syscall\n"))]
    [(Err _) false]))

(define (compiler-backend-syscall-source-windows-guard-ok?) : bool
  (match (backend.compiler-backend-emit-source-for-target
    (compiler-backend-syscall-source)
    (be_state.CompilerBackendTarget.Windows))
    [(Err diag)
      (string.eq
        (cdiag.compiler-diagnostic-message (__tl-box-place diag))
        "backend: syscall is only supported on the linux-x86_64 target")]
    [(Ok _) false]))

(define (compiler-backend-syscall-source-ok?) : bool
  (and
    (compiler-backend-syscall-source-linux-ok?)
    (compiler-backend-syscall-source-windows-guard-ok?)))

(define (compiler-backend-deterministic-ok? [src : String]) : bool
  (match (backend.compiler-backend-emit-source
    (owned_view.compiler-owned-shared-view src))
    [(Ok first)
      (match (backend.compiler-backend-emit-source src)
        [(Ok second) (string.eq first second)]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-error-ok? [src : String] [want : String]) : bool
  (match (backend.compiler-backend-emit-source src)
    [(Err message)
      (string.eq
        (cdiag.compiler-diagnostic-message (__tl-box-place message))
        want)]
    [(Ok _) false]))

(define (compiler-backend-source-contains? [src : String] [needle : String]) : bool
  (asm-ok? (backend.compiler-backend-emit-source src) (has needle)))

(define (compiler-backend-source-not-contains? [src : String] [needle : String]) : bool
  (asm-ok? (backend.compiler-backend-emit-source src) (lacks needle)))

(define (compiler-backend-test-span [line : i64] [col : i64]) : ast.AstSourceSpan
  (ast.ast-source-span line col line col))

(define (compiler-backend-spmd-source-site-retention-ok?) : bool
  (match (lower.lower-compiler-source-with-mode
    (lower_tests.compiler-lower-spmd-broadcast-source)
    (lower.CompilerLowerMode.LinuxAvx2))
    [(Ok _ spans lower-owner)
      (let
        [before : ir.CompilerSpmdDecisions
          (ir.compiler-spmd-decisions-escape
            (ir.compiler-source-spans-spmd (& spans)))]
        [first : ir.CompilerSpmdDecision (array-ref before.decisions.slots 0)]
        [remap : (__tl_dyn-array i64) (__tl_make-array i64 1)]
        [_remap : unit (set! (array-ref remap 0) 17)]
        [after : ir.CompilerSourceSpans
          (be_state.compiler-backend-remap-source-spans
            spans
            (ir.compiler-ir-symbol-id-value first.site.function)
            remap)]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        (and
          (= before.decisions.len 2)
          (lower_tests.compiler-lower-spmd-same-facts?
            (& before)
            (ir.compiler-source-spans-spmd (& after)))))]
    [(Err _) false]))

;; Span symbols are one-word handles, the instruction key remains three words,
;; and identical spellings from different provenance stay distinct. The
;; `size-of` checks live here rather than beside `CompilerIrSymbolId` because
;; `size-of` needs a `(type T)` literal, and a literal anywhere in a compiled
;; program forces the tens-of-MB CTFE reflection/layout metadata build for that
;; compile (#5872, #5875). This module is outside `main.tl`'s closure, so the
;; assertions cost the self-compile nothing.
(define (compiler-backend-source-span-symbol-provenance-ok?) : bool
  (let
    [symbol-id-bytes : i64 (ir.compiler-ir-symbol-id-size)]
    [instr-key-bytes : i64 (ir.compiler-source-spans-instr-key-size)]
    [source-name : ir.CompilerIrSymbolId
      (ir.compiler-ir-symbol-typed-id (ci.intern "same-span-name"))]
    [generated-name : ir.CompilerIrSymbolId
      (ir.compiler-ir-symbol-typed-id
        (ci.intern-generated-name "same-span-name"))]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert
        (ir.compiler-source-spans-insert
          (ir.compiler-source-spans-empty)
          source-name
          (compiler-backend-test-span 12 3))
        generated-name
        (compiler-backend-test-span 34 5))]
    [index : be_state.CompilerBackendSourceSpanIndex
      (compiler-backend-source-span-index-build spans)]
    (and
      (= symbol-id-bytes 8)
      (= instr-key-bytes 24)
      (not (ir.compiler-ir-symbol-id-eq? source-name generated-name))
      (string.eq
        (ir.compiler-ir-symbol-id-text source-name)
        (ir.compiler-ir-symbol-id-text generated-name))
      (match (be_state.compiler-backend-source-span-index-lookup
        index
        source-name)
        [(Some span)
          (and
            (= (ast.ast-source-span-start-line span) 12)
            (= (ast.ast-source-span-start-col span) 3))]
        [(No) false])
      (match (be_state.compiler-backend-source-span-index-lookup
        index
        generated-name)
        [(Some span)
          (and
            (= (ast.ast-source-span-start-line span) 34)
            (= (ast.ast-source-span-start-col span) 5))]
        [(No) false]))))

;; Debug file numbering is a sparse, state-owned path map.  Disabled debug
;; info must stay allocation-free (`No`), while enabled info preserves exact
;; source-span lookups and assigns deterministic one-based numbers even for a
;; high generated path ID.
(define (compiler-backend-debug-disabled-sparse-paths-ok?) : bool
  (let
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (owned_view.compiler-owned-shared-view intern-state))]
    [function-a : i64
      (ci.intern-compat-state-intern (&mut intern-state) "debug_sparse_a")]
    [function-b : i64
      (ci.intern-compat-state-intern (&mut intern-state) "debug_sparse_b")]
    [path-a : i64
      (ci.intern-compat-state-intern (&mut intern-state) "src/debug_a.tl")]
    [path-b : i64
      (ci.intern-compat-state-generated-name
        (&mut intern-state)
        "src/debug_high.tl")]
    [symbol-a : ir.CompilerIrSymbolId
      (ir.compiler-ir-symbol-typed-id function-a)]
    [symbol-b : ir.CompilerIrSymbolId
      (ir.compiler-ir-symbol-typed-id function-b)]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-located
        (ir.compiler-source-spans-insert-located
          (ir.compiler-source-spans-empty)
          symbol-a
          path-a
          (compiler-backend-test-span 12 3))
        symbol-b
        path-b
        (compiler-backend-test-span 34 5))]
    [_disable : unit (ir.compiler-debug-info-set-enabled! false)]
    [disabled-index : be_state.CompilerBackendSourceSpanIndex
      (be_state.compiler-backend-source-span-index-build-with-backend-state
        backend-state
        (owned_view.compiler-owned-shared-view spans))]
    [_enable : unit (ir.compiler-debug-info-set-enabled! true)]
    [enabled-index : be_state.CompilerBackendSourceSpanIndex
      (be_state.compiler-backend-source-span-index-build-with-backend-state
        backend-state
        spans)]
    [disabled-ok : bool
      (and
        (match disabled-index.debug-files
          [(No) true]
          [_ false])
        (=
          (be_state.compiler-backend-debug-file-number
            (owned_view.compiler-owned-shared-view disabled-index)
            path-a)
          0)
        (match (be_state.compiler-backend-source-span-index-lookup
          disabled-index
          symbol-b)
          [(Some span)
            (and
              (= (ast.ast-source-span-start-line span) 34)
              (= (ast.ast-source-span-start-col span) 5))]
          [(No) false]))]
    [enabled-ok : bool
      (and
        (match enabled-index.debug-files
          [(Files _ _ count) (= count 2)]
          [(No) false])
        (=
          (be_state.compiler-backend-debug-file-number
            (owned_view.compiler-owned-shared-view enabled-index)
            path-a)
          1)
        (=
          (be_state.compiler-backend-debug-file-number
            (owned_view.compiler-owned-shared-view enabled-index)
            path-b)
          2)
        (=
          (be_state.compiler-backend-debug-file-number
            (owned_view.compiler-owned-shared-view enabled-index)
            (- 0 99))
          0)
        (match (be_state.compiler-backend-source-span-index-lookup
          enabled-index
          symbol-a)
          [(Some span)
            (and
              (= (ast.ast-source-span-start-line span) 12)
              (= (ast.ast-source-span-start-col span) 3))]
          [(No) false]))]
    [_restore : unit (ir.compiler-debug-info-set-enabled! previous-debug)]
    (and disabled-ok enabled-ok)))

;; User-symbol cache lanes stay in the backend-state owner, but each epoch's
;; mangled String follows the explicit outer emission owner.  A nested emitter
;; arena may be rewound or destroyed while the cache hit remains valid.
(define (compiler-backend-user-symbol-cache-emission-arena-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [name-id : i64
      (ci.intern-compat-state-intern (&mut intern-state) "emission_arena_6274")]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [owner-symbol : String
      (be_state.compiler-backend-state-user-symbol-id backend-state name-id)]
    [_reset-owner-cache : unit
      (be_state.compiler-backend-state-user-symbol-cache-reset! backend-state)]
    [emission : arena.Arena (arena.make)]
    [nested : arena.Arena (arena.make)]
    [owner-mark-before : arena.ArenaMark (arena.mark)]
    [_set-emission : unit
      (be_state.compiler-backend-state-set-emission-arena!
        backend-state
        emission)]
    [_set-nested : unit
      (unsafe
        (arena.set! nested))]
    [emission-symbol-first : String
      (be_state.compiler-backend-state-user-symbol-id backend-state name-id)]
    [emission-count-first : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [first-ok : bool
      (and
        (string.eq emission-symbol-first "_tl_emission_arena_6274")
        (= emission-count-first 1))]
    [_restore-caller : unit
      (unsafe
        (arena.set! caller))]
    [_destroy-nested : unit
      (unsafe
        (arena.destroy nested))]
    [emission-symbol-hit : String
      (be_state.compiler-backend-state-user-symbol-id backend-state name-id)]
    [emission-count-hit : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [hit-ok : bool
      (and
        (string.eq emission-symbol-hit emission-symbol-first)
        (string.eq emission-symbol-hit "_tl_emission_arena_6274")
        (= emission-count-hit emission-count-first))]
    [_reset-emission-cache : unit
      (be_state.compiler-backend-state-user-symbol-cache-reset! backend-state)]
    [_clear-emission : unit
      (be_state.compiler-backend-state-clear-emission-arena! backend-state)]
    [owner-mark-after : arena.ArenaMark (arena.mark)]
    [owner-capacity : i64
      (be_state.compiler-backend-state-user-symbol-cache-capacity backend-state)]
    [owner-count : i64
      (be_state.compiler-backend-state-user-symbol-cache-count backend-state)]
    [_destroy-emission : unit
      (unsafe
        (arena.destroy emission))]
    (and
      (string.eq owner-symbol "_tl_emission_arena_6274")
      first-ok
      hit-ok
      (= owner-capacity 16)
      (= owner-count 0)
      (arena.mark-eq? owner-mark-before owner-mark-after)
      (arena.eq? (arena.current) caller))))

(define (compiler-backend-debug-path-remap-ok?) : bool
  (let
    [_clear : unit (ir.compiler-debug-path-remap-clear!)]
    [invalid-ok : bool
      (not (ir.compiler-debug-path-remap-set! "missing-equals"))]
    [configured : bool
      (ir.compiler-debug-path-remap-set! "/private/build=WORKSPACE")]
    [mapped : String
      (ir.compiler-debug-path-remap "/private/build/src/main.tl")]
    [unchanged : String (ir.compiler-debug-path-remap "/other/src/main.tl")]
    [_restore : unit (ir.compiler-debug-path-remap-clear!)]
    (and
      invalid-ok
      configured
      (string.eq mapped "WORKSPACE/src/main.tl")
      (string.eq unchanged "/other/src/main.tl")
      (not (ir.compiler-debug-path-remap-enabled?)))))

(define (compiler-backend-backtrace-metadata-shape-ok?) : bool
  (let
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [bridge-source : String
      "(define (small) (:export-symbol \"tl_bt_small\") : i64 1)
(define (six [a : i64] [b : i64] [c : i64] [d : i64] [e : i64] [f : i64])
  (:export-symbol \"tl_bt_six\") : i64 (+ a b c d e f))
(define (main) : i64 (small))"]
    [_disable : unit (ir.compiler-debug-info-set-enabled! false)]
    [disabled-ok : bool
      (asm-ok?
        (backend.compiler-backend-emit-source "(define (main) : i64 0)")
        (lacks "tl_backtrace_map_data_begin" "tl_backtrace_map_begin:"))]
    [bridge-disabled-ok : bool
      (asm-ok?
        (backend.compiler-backend-emit-source-for-target
          (string.copy (& bridge-source))
          (Windows))
        (lacks ".L_tl_c_entry_shared_end" ".L_tl_c_entry_end_tl_bt_six"))]
    [_enable : unit (ir.compiler-debug-info-set-enabled! true)]
    [linux-ok : bool
      (asm-ok?
        (backend.compiler-backend-emit-source "(define (main) : i64 0)")
        (has
          ".section .typelisp_backtrace,\"a\",@progbits"
          "tl_backtrace_string_data_begin:"
          "tl_backtrace_map_data_end:"
          ".quad main"))]
    [windows-ok : bool
      (asm-ok?
        (backend.compiler-backend-emit-source-for-target
          "(define (main) : i64 0)"
          (be_state.CompilerBackendTarget.Windows))
        (has
          ".section .rdata$TLBT,\"dr\""
          ".section .rdata$TLBS,\"dr\""
          "tl_backtrace_map_begin:"))]
    [bridge-ok : bool
      (asm-ok?
        (backend.compiler-backend-emit-source-for-target
          bridge-source
          (Windows))
        (has
          "    .quad __tl$c_entry\n    .quad .L_tl_c_entry_shared_end\n"
          "    .quad tl_bt_six\n    .quad .L_tl_c_entry_end_tl_bt_six\n"
          "    .quad tl_backtrace_string_data_begin\n    .quad 0\n    .quad tl_backtrace_string_data_begin\n    .quad 0\n    .quad 0\n    .quad 0\n"))]
    ;; A two-form body has no `begin` node of its own. Its row still names the
    ;; first form's location (line 2, column 3), not an empty path at 0:0, so
    ;; the frame renders with a location and the runtime-path filter can match
    ;; it (#8651).
    [multi-form-ok : bool
      (asm-ok?
        (backend.compiler-backend-emit-source
          "(define (two-forms [x : i64]) : i64\n  (+ x 1)\n  (+ x 2))\n(define (main) : i64 (two-forms 1))")
        (has
          "    .ascii \"two-forms\"\n.L_tl_backtrace_path_0:\n    .ascii \"<source>\"\n"
          "    .quad .L_tl_backtrace_path_0\n    .quad 8\n    .quad 2\n    .quad 3\n"))]
    [_restore : unit (ir.compiler-debug-info-set-enabled! previous-debug)]
    (and
      disabled-ok
      bridge-disabled-ok
      linux-ok
      windows-ok
      bridge-ok
      multi-form-ok)))

;; Representation facts are per compile entry even when the explicit backend
;; state is reused by a batch. Rebuilding them must rewind their dedicated
;; arena rather than extending the persistent state owner on every entry.
(define (compiler-backend-representation-arena-reuse-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new (ci.intern-compat-state-new))]
    [owner-mark-before : arena.ArenaMark (arena.mark)]
    [first-owner : arena.Arena
      (backend.compiler-backend-state-prepare-representation-arena!
        backend-state)]
    [first-index : ir.CompilerIrRepresentationIndex
      (in-arena first-owner (ir.compiler-ir-representation-index-empty))]
    [_install-first : unit
      (be_state.compiler-backend-state-set-representations!
        backend-state
        first-index)]
    [second-owner : arena.Arena
      (backend.compiler-backend-state-prepare-representation-arena!
        backend-state)]
    [second-index : ir.CompilerIrRepresentationIndex
      (in-arena second-owner (ir.compiler-ir-representation-index-empty))]
    [_install-second : unit
      (be_state.compiler-backend-state-set-representations!
        backend-state
        second-index)]
    [owner-mark-after : arena.ArenaMark (arena.mark)]
    (and
      (arena.eq? first-owner second-owner)
      (arena.mark-eq? owner-mark-before owner-mark-after)
      (arena.eq? (arena.current) caller))))

;; Debug file-index working storage is an emission result, not persistent
;; backend state.  Build it in the explicit emission owner while a nested arena
;; is active, then validate the retained index after that nested arena dies.
(define (compiler-backend-debug-file-index-emission-arena-ok?) : bool
  (let
    [caller : arena.Arena (arena.current)]
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [function-a : i64
      (ci.intern-compat-state-intern (&mut intern-state) "debug_owner_a")]
    [function-b : i64
      (ci.intern-compat-state-intern (&mut intern-state) "debug_owner_b")]
    [path-a : i64
      (ci.intern-compat-state-intern (&mut intern-state) "src/debug_owner_a.tl")]
    [path-b : i64
      (ci.intern-compat-state-generated-name
        (&mut intern-state)
        "src/debug_owner_high.tl")]
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [symbol-a : ir.CompilerIrSymbolId
      (ir.compiler-ir-symbol-typed-id function-a)]
    [symbol-b : ir.CompilerIrSymbolId
      (ir.compiler-ir-symbol-typed-id function-b)]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-located
        (ir.compiler-source-spans-insert-located
          (ir.compiler-source-spans-empty)
          symbol-a
          path-a
          (compiler-backend-test-span 17 2))
        symbol-b
        path-b
        (compiler-backend-test-span 29 4))]
    [emission : arena.Arena (arena.make)]
    [nested : arena.Arena (arena.make)]
    [owner-mark-before : arena.ArenaMark (arena.mark)]
    [_set-emission : unit
      (be_state.compiler-backend-state-set-emission-arena!
        backend-state
        emission)]
    [_enable-debug : unit (ir.compiler-debug-info-set-enabled! true)]
    [_set-nested : unit
      (unsafe
        (arena.set! nested))]
    [enabled-index : be_state.CompilerBackendSourceSpanIndex
      (be_state.compiler-backend-source-span-index-build-with-backend-state
        backend-state
        spans)]
    [_restore-caller : unit
      (unsafe
        (arena.set! caller))]
    [_destroy-nested : unit
      (unsafe
        (arena.destroy nested))]
    [debug-ok : bool
      (and
        (match enabled-index.debug-files
          [(Files _ _ count) (= count 2)]
          [(No) false])
        (=
          (be_state.compiler-backend-debug-file-number
            (owned_view.compiler-owned-shared-view enabled-index)
            path-a)
          1)
        (= (be_state.compiler-backend-debug-file-number enabled-index path-b) 2))]
    [_restore-debug : unit (ir.compiler-debug-info-set-enabled! previous-debug)]
    [_clear-emission : unit
      (be_state.compiler-backend-state-clear-emission-arena! backend-state)]
    [owner-mark-after : arena.ArenaMark (arena.mark)]
    [_destroy-emission : unit
      (unsafe
        (arena.destroy emission))]
    (and
      debug-ok
      (arena.mark-eq? owner-mark-before owner-mark-after)
      (arena.eq? (arena.current) caller))))

;; Build a tiny backend program directly from an exact intern-state id.  The
;; route-isolation checks below deliberately build two structurally identical
;; programs from different intern tables; both tables hand out the same
;; numeric id, but each id renders to a different user symbol.
(define (compiler-backend-explicit-state-minimal-program [name-id : i64]) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          name-id
          (ir.compiler-ir-param-seq-empty)
          (I64)
          0
          (ir.compiler-ir-blocks
            (ir.CompilerIrBlock.Block
              0
              (compiler-backend-test-instr-seq-prepend
                (Return (Some (I64 0)))
                (ir.compiler-ir-instr-seq-empty))))
          Ordinary))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-explicit-state-duplicate-function-program
  [name-id : i64]) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          name-id
          (ir.compiler-ir-param-seq-empty)
          (I64)
          0
          (ir.compiler-ir-blocks
            (ir.CompilerIrBlock.Block
              0
              (compiler-backend-test-instr-seq-prepend
                (Return (Some (I64 0)))
                (ir.compiler-ir-instr-seq-empty))))
          Ordinary))
      (&
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              name-id
              (ir.compiler-ir-param-seq-empty)
              (I64)
              0
              (ir.compiler-ir-blocks
                (ir.CompilerIrBlock.Block
                  0
                  (compiler-backend-test-instr-seq-prepend
                    (Return (Some (I64 0)))
                    (ir.compiler-ir-instr-seq-empty))))
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-explicit-state-buffer-result-ok?
  [result : (& result be_state.ResultCompilerBackendBuffer)]) : bool
  (match result
    [(Ok _) true]
    [(Err _) false]))

(define (compiler-backend-explicit-state-buffer-result-text
  [result : (& result be_state.ResultCompilerBackendBuffer)]) : String
  (let
    [result : be_state.ResultCompilerBackendBuffer
      (owned_view.compiler-owned-reference-shared-view result)]
    (match result
      [(Ok buf) (text_buf.render buf)]
      [(Err _) ""])))

(define (compiler-backend-explicit-state-object-result-text
  [result : be_state.ResultCompilerBackendObject]) : String
  (match result
    [(Ok image)
      (match (elf.compiler-object-elf-render image)
        [(Ok bytes) bytes]
        [(Err _) ""])]
    [(Err _) ""]))

(define (compiler-backend-explicit-state-object-result-ok?
  [result : (& result be_state.ResultCompilerBackendObject)]) : bool
  (let
    [result : be_state.ResultCompilerBackendObject
      (owned_view.compiler-owned-reference-shared-view result)]
    (match result
      [(Ok image)
        (match (elf.compiler-object-elf-render image)
          [(Ok _) true]
          [(Err _) false])]
      [(Err _) false])))

(define (compiler-backend-explicit-state-pic-result-ok?
  [result : (& result be_state.ResultCompilerBackendPic)]) : bool
  (match result
    [(Ok _) true]
    [(Err _) false]))

(define (compiler-backend-explicit-state-pic-result-text
  [result : be_state.ResultCompilerBackendPic]) : String
  (match result
    [(Ok output) (str_cat.str-cat output.asm output.fixups)]
    [(Err _) ""]))

(define (compiler-backend-explicit-state-own-symbols-ok?
  [text : String]
  [own : (& own str)]
  [other : (& other str)]) : bool
  (and (asm-has? text own) (asm-lacks? text other)))

(define (compiler-backend-explicit-state-install!
  [intern-state : (& intern-state ci.InternCompatState)]
  [builtin-state : (& builtin-state cbi.CompilerBuiltinIdsState)]) : unit
  (ci.intern-compat-state-install! intern-state)
  (cbi.state-install! builtin-state))

;; Every explicit route must use the intern capability carried by its backend
;; state, even when the process-global compatibility table is the other job's
;; table.  Repeat A after B for each route and compare only within that route;
;; streamed final output and PIC rewriting intentionally have different text.
(define (compiler-backend-explicit-state-routes-serial-parity-ok?) : bool
  (let
    [active-before : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [builtin-before : cbi.CompilerBuiltinIdsState (cbi.state-capture)]
    [intern-a : ci.InternCompatState (ci.intern-compat-state-new)]
    [_install-a : unit (ci.intern-compat-state-install! intern-a)]
    [_reset-a : unit (cbi.compiler-builtin-reset!)]
    [_init-a : unit (cbi.compiler-builtin-initialize-for-parse!)]
    [_capture-a : unit
      (ci.intern-compat-state-capture-from-globals! (&mut intern-a))]
    [name-a : i64 (ci.intern-compat-state-intern (&mut intern-a) "route_a")]
    [builtin-a : cbi.CompilerBuiltinIdsState (cbi.state-capture)]
    [intern-b : ci.InternCompatState (ci.intern-compat-state-new)]
    [_install-b : unit (ci.intern-compat-state-install! intern-b)]
    [_reset-b : unit (cbi.compiler-builtin-reset!)]
