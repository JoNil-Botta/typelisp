(define (compiler-backend-instr-diagnostics-ok?) : bool
  (and
    (compiler-backend-instr-diagnostic-case-ok?
      (compiler_ir_types.CompilerIrInstr.Mov
        0
        (compiler_ir_types.CompilerIrValue.F64
          (compiler-backend-test-f64-bits "1.0"))
        (compiler_ast_types.AstType.I64))
      "backend: f64 values are not supported yet"
      21
      7)
    (compiler-backend-instr-diagnostic-case-ok?
      (compiler_ir_types.CompilerIrInstr.BinOp
        1
        (compiler_ir_types.CompilerIrBinOp.Mod)
        (compiler_ir_types.CompilerIrValue.F64
          (compiler-backend-test-f64-bits "1.0"))
        (compiler_ir_types.CompilerIrValue.F64
          (compiler-backend-test-f64-bits "2.0"))
        (compiler_ast_types.AstType.F64))
      "backend: unsupported float binary op"
      34
      9)
    ;; An unsupported f64 unary op is rejected. Neg and Sqrt have f64 lowering.
    (compiler-backend-instr-diagnostic-case-ok?
      (compiler_ir_types.CompilerIrInstr.UnOp
        2
        (compiler_ir_types.CompilerIrUnOp.Not)
        (compiler_ir_types.CompilerIrValue.F64
          (compiler-backend-test-f64-bits "1.0"))
        (compiler_ast_types.AstType.F64))
      "backend: unsupported f64 unary op"
      40
      11)
    (compiler-backend-switch-asm-ok?)
    (compiler-backend-total-switch-asm-ok?)
    (compiler-backend-forwarded-total-switch-asm-ok?)
    (compiler-backend-total-switch-pic-asm-ok?)
    (compiler-backend-total-switch-object-image-ok?)
    (compiler-backend-spoofed-total-switch-stays-checked?)
    (compiler-backend-total-switch-lowered-opt2-asm-ok?)
    (compiler-backend-switch-base-asm-ok?)
    (compiler-backend-switch-shape-diagnostic-ok?)
    (compiler-backend-switch-phi-edge-copy-ok?)
    (compiler-backend-switch-object-image-ok?)
    (compiler-backend-switch-base-object-image-ok?)
    (compiler-backend-switch-object-shape-diagnostic-ok?)
    (compiler-backend-switch-object-phi-diagnostic-ok?)
    (compiler-backend-instr-diagnostic-case-ok?
      (compiler_ir_types.ir-instr-vector-bin-op
        3
        (compiler_ir_types.CompilerIrBinOp.Mod)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        8
        (compiler_ast_types.AstType.I64))
      "backend: unsupported AVX-512 vector binary op"
      44
      13)))

(define (compiler-backend-avx2-map-source [elem : String]) : String
  (str_cat.str-cat
    "(define (fill [a : (Array "
    elem
    ")] [b : (Array "
    elem
    ")] [out : (Array "
    elem
    ")] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i (+ (array-ref a i) (array-ref b i)))))"))

(define (compiler-backend-uniform-map-source [elem : String]) : String
  (str_cat.str-cat
    "(define (fill [a : (Array "
    elem
    ")] [b : (Array "
    elem
    ")] [out : (Array "
    elem
    ")] [n : i64] [r : "
    elem
    "]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i (+ (+ (array-ref a i) (array-ref b i)) r))))"))

(define (compiler-backend-uniform-zip-source) : String
  "(define (fill [a : (Array i64)] [b : (Array i64)] [c : (Array i64)] [out : (Array i64)] [n : i64] [r : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i (+ (+ (* (array-ref a i) (array-ref b i)) (array-ref c i)) r))))")

(define (compiler-backend-lane-id-rodata-source) : String
  "(define (fill [out : (Array i64)] [other : (Array i64)] [n : i64]) : unit
  (begin
    (foreach
      ([i : i64 0 n])
      (array-set! out i (program-index)))
    (foreach
      ([j : i64 0 n])
      (array-set! other j (program-index)))))")

(define (compiler-backend-lane-id-rodata-shape-ok?
  [lower-mode : compiler_lower.CompilerLowerMode]
  [backend-mode : compiler_backend.CompilerBackendMode]
  [label : String]
  [align : String]
  [load : String]) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    (compiler-backend-lane-id-rodata-source)
    lower-mode)
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        backend-mode
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.backend-and4
              (compiler_backend.compiler-backend-string-contains?
                asm
                (str_cat.str-cat "    .section .rodata\n" align label ":\n"))
              (=
                (compiler_backend.compiler-backend-string-count
                  asm
                  (str_cat.str-cat label ":\n"))
                1)
              (>=
                (compiler_backend.compiler-backend-string-count
                  asm
                  (str_cat.str-cat load " " label "(%rip), "))
                2)
              (not
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  (str_cat.str-cat label ":\n" load))))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "vector/mask IR emission is not implemented")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-lane-id-rodata-ok?) : bool
  (and
    (compiler-backend-lane-id-rodata-shape-ok?
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      (compiler_backend.compiler-backend-avx2-i64-lane-id-label)
      "    .balign 32\n"
      "    vmovdqa")
    (compiler-backend-lane-id-rodata-shape-ok?
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      (compiler_backend.compiler-backend-avx512-i64-lane-id-label)
      "    .balign 64\n"
      "    vmovdqa64")
    (match (compiler_lower.lower-compiler-source-with-mode
      (compiler-backend-lane-id-rodata-source)
      (compiler_lower.CompilerLowerMode.Avx2))
      [(compiler_lower.ResultCompilerLower.Ok program spans)
        (match (compiler_backend.compiler-backend-emit-program-target-with-mode
          program
          (compiler_backend.CompilerBackendTarget.Linux)
          (compiler_backend.CompilerBackendMode.Avx2)
          spans
          true)
          [(compiler_backend.ResultCompilerBackend.Ok asm)
            (let
              [body : String
                (compiler-backend-asm-function-body asm "_tl_fill")]
              [loop : String (compiler-backend-avx2-loop-body body)]
              (and
                (not (string.eq loop ""))
                (=
                  (compiler_backend.compiler-backend-string-count
                    loop
                    (compiler_backend.compiler-backend-avx2-i64-lane-id-label))
                  0)))]
          [(compiler_backend.ResultCompilerBackend.Err _) false])]
      [(compiler_lower.ResultCompilerLower.Err _) false])))

(define (compiler-backend-avx2-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    (compiler-backend-avx2-map-source elem)
    (compiler_lower.CompilerLowerMode.Avx2))
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        (compiler_backend.CompilerBackendMode.Avx2)
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.backend-and4
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vzeroupper\n")
              (compiler_backend.compiler-backend-string-contains? asm move)
              (compiler_backend.compiler-backend-string-contains? asm op)
              (compiler_backend.compiler-backend-string-contains? asm "%ymm"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "vector/mask IR emission is not implemented")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-avx2-vector-map-ok?) : bool
  (and
    (compiler-backend-avx2-map-asm-contains? "i64" "    vmovdqu " "    vpaddq ")
    (compiler-backend-avx2-map-asm-contains? "i32" "    vmovdqu " "    vpaddd ")
    (compiler-backend-avx2-map-asm-contains? "i16" "    vmovdqu " "    vpaddw ")
    (compiler-backend-avx2-map-asm-contains? "u16" "    vmovdqu " "    vpaddw ")
    (compiler-backend-avx2-map-asm-contains? "f64" "    vmovupd " "    vaddpd ")
    (compiler-backend-avx2-map-asm-contains? "f32" "    vmovups " "    vaddps ")
    (compiler-backend-avx2-map-asm-contains? "i8" "    vmovdqu " "    vpaddb ")
    (compiler-backend-avx2-map-asm-contains? "u8" "    vmovdqu " "    vpaddb ")))

(define (compiler-backend-avx2-uniform-map-asm-contains?
  [elem : String]
  [move : String]
  [op : String]
  [broadcast : String]) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    (compiler-backend-uniform-map-source elem)
    (compiler_lower.CompilerLowerMode.Avx2))
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        (compiler_backend.CompilerBackendMode.Avx2)
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (let
            [body : String (compiler-backend-asm-function-body asm "_tl_fill")]
            [loop : String (compiler-backend-avx2-loop-body body)]
            (and
              (compiler_backend.backend-and8
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  "    vzeroupper\n")
                (compiler_backend.compiler-backend-string-contains? asm move)
                (compiler_backend.compiler-backend-string-contains? asm op)
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  broadcast)
                (compiler_backend.compiler-backend-string-contains? asm "%ymm")
                (not
                  (compiler_backend.compiler-backend-string-contains?
                    asm
                    "vector/mask IR emission is not implemented"))
                (=
                  (compiler_backend.compiler-backend-string-count
                    loop
                    broadcast)
                  0)
                true)
              true))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-avx2-uniform-zip-ok?) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    (compiler-backend-uniform-zip-source)
    (compiler_lower.CompilerLowerMode.Avx2))
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        (compiler_backend.CompilerBackendMode.Avx2)
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.backend-and8
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vpbroadcastq ")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vpmuludq ")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vpsllq $32, ")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vpaddq ")
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    vmovdqu ")
              (compiler_backend.compiler-backend-string-contains? asm "%ymm")
              (not
                (compiler_backend.compiler-backend-string-contains?
                  asm
                  "vector/mask IR emission is not implemented"))
              true)
            true)]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

;; The uniform value may move when preheader caches change register pressure;
;; these checks care that its broadcast is emitted, not which spill owns it.
(define (compiler-backend-avx2-uniform-vector-map-ok?) : bool
  (and
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i64"
      "    vmovdqu "
      "    vpaddq "
      "    vpbroadcastq ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i32"
      "    vmovdqu "
      "    vpaddd "
      "    vpbroadcastd ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i16"
      "    vmovdqu "
      "    vpaddw "
      "    vpbroadcastw ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "u16"
      "    vmovdqu "
      "    vpaddw "
      "    vpbroadcastw ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "f64"
      "    vmovupd "
      "    vaddpd "
      "    vbroadcastsd ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "f32"
      "    vmovups "
      "    vaddps "
      "    vbroadcastss ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "i8"
      "    vmovdqu "
      "    vpaddb "
      "    vpbroadcastb ")
    (compiler-backend-avx2-uniform-map-asm-contains?
      "u8"
      "    vmovdqu "
      "    vpaddb "
      "    vpbroadcastb ")
    (compiler-backend-avx2-uniform-zip-ok?)))

(define (compiler-backend-stack-splat-dst-only-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 6)))
    compiler_regalloc.CompilerRegAssignmentList.Nil))

(define (compiler-backend-stack-splat-spill-assignments [offset : i64]) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 6)))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Spill offset))
      compiler_regalloc.CompilerRegAssignmentList.Nil)))

(define (compiler-backend-stack-splat-register-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 6)))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r12))
      compiler_regalloc.CompilerRegAssignmentList.Nil)))

(define (compiler-backend-stack-splat-float-register-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
