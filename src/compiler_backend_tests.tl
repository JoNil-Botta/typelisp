          (if (compiler_backend.compiler-backend-string-contains?
            asm
            ".globl tl_string_eq\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_string_eq\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            ".extern tl_string_eq\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            ".globl tl_string_to_int\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            "tl_string_to_int:\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_string_to_int\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            ".extern tl_string_to_int\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            ".globl tl_int_to_string\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_int_to_string\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            ".extern tl_int_to_string\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            ".globl tl_substring\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_substring\n")
            (set! ok false)
            unit)
          (if (compiler_backend.compiler-backend-string-contains?
