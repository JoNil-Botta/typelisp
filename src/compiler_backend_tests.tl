(define (compiler-backend-stack-args-ok?) : bool
  (and
    (compiler-backend-stack-int-args-ok?)
    (compiler-backend-stack-f64-args-ok?)
    (compiler-backend-stack-mixed-args-ok?)
    (compiler-backend-stack-windows-args-ok?)
    (compiler-backend-stack-f32-arg-bits-ok?)
    (compiler-backend-group-stack-f64-arg-bits-ok?)
    (compiler-backend-group-stack-param-no-return-stage-ok?)
    (compiler-backend-immediate-stack-call-args-ok?)))

(define (compiler-backend-asm-function-body [asm : String] [symbol : String]) : String
  (let
    [label : String (str_cat.str-cat symbol ":\n")]
    [start : i64
      (compiler_backend.compiler-backend-string-find-from asm label 0)]
    (if (< start 0)
      ""
      (let
        [body-start : i64 (+ start (string.string-length label))]
        [plain-next : i64
          (compiler_backend.compiler-backend-string-find-from
            asm
            "\n.globl "
            body-start)]
        [indented-next : i64
          (compiler_backend.compiler-backend-string-find-from
            asm
            "\n    .globl "
            body-start)]
        [next : i64
          (if (< plain-next 0)
            indented-next
            (if (and (>= indented-next 0) (< indented-next plain-next))
              indented-next
              plain-next))]
        [body-end : i64
          (if (< next 0)
            (string.string-length asm)
            next)]
        (string.substring asm body-start (- body-end body-start))))))

(define (compiler-backend-direct-tail-call-reg0
  [target : compiler_backend.CompilerBackendTarget]) : String
  (if (compiler_backend.compiler-backend-target-windows? target)
    "%rcx"
    "%rdi"))

(define (compiler-backend-direct-tail-call-reg1
  [target : compiler_backend.CompilerBackendTarget]) : String
  (if (compiler_backend.compiler-backend-target-windows? target)
    "%rdx"
    "%rsi"))

(define (compiler-backend-direct-tail-call-param-store
  [reg : String]
  [slot : String]) : String
  (str_cat.str-cat "    movq " reg ", " slot "\n"))

(define (compiler-backend-direct-tail-call-param-load
  [slot : String]
  [reg : String]) : String
  (str_cat.str-cat "    movq " slot ", " reg "\n"))

(define (compiler-backend-direct-tail-call-identity-elided?
  [target : compiler_backend.CompilerBackendTarget]
  [asm : String]) : bool
  (let
    [body : String (compiler-backend-asm-function-body asm "_tl_step")]
    [reg0 : String (compiler-backend-direct-tail-call-reg0 target)]
    [reg1 : String (compiler-backend-direct-tail-call-reg1 target)]
    (and
      (compiler_backend.compiler-backend-string-contains?
        body
        "    jmp _tl_finish\n")
      (not
        (compiler_backend.compiler-backend-string-contains?
          body
          "    call _tl_finish\n"))
      (not
        (compiler_backend.compiler-backend-string-contains?
          body
          (compiler-backend-direct-tail-call-param-store reg0 "-8(%rbp)")))
      (not
        (compiler_backend.compiler-backend-string-contains?
          body
          (compiler-backend-direct-tail-call-param-store reg1 "-16(%rbp)")))
      (not
        (compiler_backend.compiler-backend-string-contains?
          body
          (compiler-backend-direct-tail-call-param-load "-8(%rbp)" reg0)))
      (not
        (compiler_backend.compiler-backend-string-contains?
          body
          (compiler-backend-direct-tail-call-param-load "-16(%rbp)" reg1))))))

(define (compiler-backend-direct-tail-call-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    jmp _tl_finish\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call _tl_finish\n"))
        (compiler-backend-direct-tail-call-identity-elided? target asm))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Under FPO the source params spill to rsp-relative slots whose offsets
;; depend on each fixture's frame size (and target), so slot0/slot1 are passed
;; per call site instead of the old fixed -8/-16(%rbp). A "" slot1 means the
;; second param is not spilled (correctly optimised away — e.g. the `finish x x`
;; duplicated fixture, where the dead y param is never stored).
(define (compiler-backend-direct-tail-call-i64-keeps-spills?
  [source : String]
  [target : compiler_backend.CompilerBackendTarget]
  [slot0 : String]
  [slot1 : String]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    source
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_step")]
        [reg0 : String (compiler-backend-direct-tail-call-reg0 target)]
        [reg1 : String (compiler-backend-direct-tail-call-reg1 target)]
        (and
          (compiler_backend.compiler-backend-string-contains?
            body
            "    jmp _tl_finish\n")
          (compiler_backend.compiler-backend-string-contains?
            body
            (compiler-backend-direct-tail-call-param-store reg0 slot0))
          (if (string.eq slot1 "")
            true
            (compiler_backend.compiler-backend-string-contains?
              body
              (compiler-backend-direct-tail-call-param-store reg1 slot1)))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Under FPO the f64 params spill to rsp-relative slots (offsets differ by
;; target), passed per call site instead of the old fixed -8/-16(%rbp).
(define (compiler-backend-direct-tail-call-f64-keeps-spills?
  [target : compiler_backend.CompilerBackendTarget]
  [slot0 : String]
  [slot1 : String]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-f64-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_stepf")]
        (and
          (compiler_backend.compiler-backend-string-contains?
            body
            "    jmp _tl_finishf\n")
          (compiler_backend.compiler-backend-string-contains?
            body
            (str_cat.str-cat "    movsd %xmm0, " (str_cat.str-cat slot0 "\n")))
          (compiler_backend.compiler-backend-string-contains?
            body
            (str_cat.str-cat "    movsd %xmm1, " (str_cat.str-cat slot1 "\n")))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-direct-tail-call-stack-slot
  [target : compiler_backend.CompilerBackendTarget]) : String
  (if (compiler_backend.compiler-backend-target-windows? target)
    ;; Win64 FPO rebases the outgoing tail stack-arg store.
    "    movq %r10, 200(%rsp)\n"
    ;; FPO makes the Linux outgoing tail stack-arg store rsp-relative.
    "    movq %r10, 104(%rsp)\n"))

(define (compiler-backend-direct-tail-call-stack-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-direct-tail-call-stack-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    jmp _tl_finishstack\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call _tl_finishstack\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    pushq %r11\n"))
        (compiler_backend.compiler-backend-string-contains?
          asm
          (compiler-backend-direct-tail-call-stack-slot target)))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-direct-tail-immediate-stack-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-direct-tail-call-args
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    target
    compiler_regalloc.CompilerRegAssignmentList.Nil
    (compiler-backend-i64-immediate-call-args8)
