(define (compiler-backend-raw-pointer-fixture-shape-ok?) : bool
  (match (compiler-backend-raw-pointer-fixture-emit
    (compiler_backend.CompilerBackendTarget.Linux))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler_backend.backend-and8
        (or
          (>=
            (compiler_backend.compiler-backend-string-count asm ".globl _tl_f")
            2)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl _tl_write_i64")
            (compiler_backend.compiler-backend-string-contains?
              asm
              ".globl _tl_read_i64")))
        (or
          (compiler_backend.compiler-backend-string-contains?
            asm
            "_tl_write_i64")
          (compiler_backend.compiler-backend-string-contains? asm "_tl_f"))
        (or
          (>=
            (compiler_backend.compiler-backend-string-count
              asm
              "    call _tl_f")
            2)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    call _tl_write_i64")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    call _tl_read_i64")))
        (compiler_backend.compiler-backend-string-contains? asm "main:\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    call tl_alloc\n")
        (compiler_backend.compiler-backend-string-contains? asm "tl_alloc:")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq (%r10,%r8,8), %r9\n")
        (and
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker)))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq (%r10), %rax\n"))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

;; Backend emit-shape coverage for arena-owned boxes. `(box 42)`
;; allocates `size-of(i64)` = 8 bytes via `tl_alloc` and stores the boxed value
;; into that storage; `(box-get b)` loads the value back through the box pointer.
;; Boxes reuse the existing `tl_alloc` / pointer store/load paths (no new IR or
;; runtime), so this locks down that the allocation, store, and load shapes are
;; emitted with no `# TODO` placeholder.
(define (compiler-backend-box-source) : String
  "(define (main) : i64
  (let
    [b : (Box i64) (box 42)]
    (box-get b)))")

(define (compiler-backend-box-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-box-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and4
          ;; (box 42): allocate size-of(i64)=8 bytes for the box storage,
          (compiler-backend-string-contains-alloc-size? asm 8)
          ;; Store the boxed value through allocator-owned pointer/value homes.
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %r8, (%r10)\n")
          ;; (box-get b): load the boxed value back through the box pointer.
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq (%r10), %r8\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rax, (%r10)\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq (%r10), %rax\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-fast-alloc-next-load-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-box-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq 16(%r8), %rax\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    leaq 8(%rax), %rcx\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_alloc8:\n    movq %fs:tl_current_arena@tpoff, %r8\n    testq %r8, %r8\n    jz .L_tl_alloc8_slow\n    movq 40(%r8), %r9\n    testq $1, 48(%r9)\n    jnz .L_tl_alloc8_atomic\n    movq 16(%r8), %rcx\n    movq %rcx, %rax\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rax, %rcx\n    addq $8, %rcx\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-fast-alloc-source) : String
  "(define (main) : i64
  (let
    [t : (Tuple bool i64) (tuple true 42)]
    (tuple-ref t 1)))")

(define (compiler-backend-inline-fast-alloc-result-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-inline-fast-alloc-source)
    (compiler_backend.CompilerBackendTarget.Windows))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    testq $1, 48(%r8)\n    jnz .Lf0_allocentry_i0_v0_slow\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movq 16(%r8), %rax\n    leaq 16(%rax), %r10\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq 16(%r8), %r10\n    addq $16, %r10\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    movq %rax, %r10\n    addq $16, %r10\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-fast-alloc-gate-ok?) : bool
  (and
    (=
      (compiler_backend.compiler-backend-fast-alloc-size
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 1)))
      8)
    (=
      (compiler_backend.compiler-backend-fast-alloc-size
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 8)))
      8)
    (=
      (compiler_backend.compiler-backend-fast-alloc-size
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 9)))
      16)
    (=
      (compiler_backend.compiler-backend-fast-alloc-size
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 64)))
      64)
    (=
      (compiler_backend.compiler-backend-fast-alloc-size
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 65)))
      0)
    (=
      (compiler_backend.compiler-backend-fast-alloc-size
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 0)))
      0)
    (=
      (compiler_backend.compiler-backend-fast-alloc-size
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.Var 0)))
      0)
    (compiler_backend.compiler-backend-inline-fast-alloc? 8)
    (compiler_backend.compiler-backend-inline-fast-alloc? 24)
    (compiler_backend.compiler-backend-inline-fast-alloc? 40)
    (compiler_backend.compiler-backend-inline-fast-alloc? 64)
    (not (compiler_backend.compiler-backend-inline-fast-alloc? 0))
    (not (compiler_backend.compiler-backend-inline-fast-alloc? 10))
    (not (compiler_backend.compiler-backend-inline-fast-alloc? 72))))

(define (compiler-backend-inline-fast-alloc-reused-vreg-instrs) : compiler_ir_types.CompilerIrInstrList
  (compiler_ir_types.compiler-ir-instr-cons
    (compiler_ir_types.CompilerIrInstr.Call
      0
      (ci.intern "tl_alloc")
      (compiler_ir_types.CompilerIrCallArgs.One
        (compiler_ir_types.CompilerIrValue.I64 8))
      (compiler_ast_types.AstType.U64))
    (compiler_ir_types.compiler-ir-instr-cons
      (compiler_ir_types.CompilerIrInstr.Call
        0
        (ci.intern "tl_alloc")
        (compiler_ir_types.CompilerIrCallArgs.One
          (compiler_ir_types.CompilerIrValue.I64 8))
        (compiler_ast_types.AstType.U64))
      compiler_ir_types.CompilerIrInstrList.Nil)))

;; Optimizer cloning may retain a destination vreg. Exercise that shape
;; directly so the regression stays two instructions instead of depending on
;; the source size that happened to expose it in compiler_backend_tests.tl.
(define (compiler-backend-inline-fast-alloc-reused-vreg-labels-ok?) : bool
  (let
    [prev-starts : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-starts)]
    [prev-ends : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-ends)]
    [prev-assignment-index : compiler_regalloc.CompilerRegAssignmentIndex
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-assignment-index)]
    [prev-plan-mask : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-plan-reg-mask)]
    [prev-occupied-masks : (Array i64)
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-occupied-masks)]
    [prev-vars : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-scavenge-ctx-vars)]
    [prev-post-base : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-instr-post-base)]
    [prev-current-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-current-count)]
    [prev-current-site : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-current-site)]
    [instrs : compiler_ir_types.CompilerIrInstrList
      (compiler-backend-inline-fast-alloc-reused-vreg-instrs)]
    [count : i64 (compiler_ir_types.compiler-ir-instr-list-count instrs)]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "entry")
          instrs)
        compiler_ir_types.CompilerIrBlockList.Nil)]
    [_position : unit
      (begin
        (compiler-backend-test-scavenge-install-ctx!
          "_tl_test"
          compiler_ir_types.CompilerIrParamList.Nil
          (compiler_ast_types.AstType.U64)
          1
          blocks
          compiler_regalloc.CompilerRegAssignmentList.Nil)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-site!
          0))]
    [result : compiler_backend.ResultCompilerBackend
      (compiler-backend-emit-test-instrs
        instrs
        compiler_regalloc.CompilerRegAssignmentList.Nil
        1)]
    [_restore : unit
      (begin
        (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
          prev-starts
          prev-ends
          prev-assignment-index
          prev-plan-mask
          prev-occupied-masks
          prev-vars)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          prev-post-base)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          prev-current-count)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-site!
          prev-current-site))]
    (match result
      [(compiler_backend.ResultCompilerBackend.Ok asm)
        (compiler_backend.backend-and4
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_test_allocentry_i0_v0_slow:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_test_allocentry_i1_v0_slow:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_test_allocentry_i0_v0_done:\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            ".L_tl_test_allocentry_i1_v0_done:\n"))]
      [(compiler_backend.ResultCompilerBackend.Err _) false])))

(define (compiler-backend-inline-fast-alloc-multi-size-source) : String
  "(define (make3 [x : i64]) : (Tuple i64 i64 i64)
  (tuple x (+ x 1) (+ x 2)))

(define (make5 [x : i64]) : (Tuple i64 i64 i64 i64 i64)
  (tuple x (+ x 1) (+ x 2) (+ x 3) (+ x 4)))

(define (main) : i64
  (let
    [a : (Tuple i64 i64 i64) (make3 10)]
    [b : (Tuple i64 i64 i64 i64 i64) (make5 20)]
    (+ (tuple-ref a 2) (tuple-ref b 4))))")

(define (compiler-backend-inline-fast-alloc-multi-size-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-for-target
    (compiler-backend-inline-fast-alloc-multi-size-source)
    target)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains-inline-alloc-size? asm 24)
        (compiler-backend-string-contains-inline-alloc-size? asm 40)
        (compiler_backend.compiler-backend-string-contains?
          asm
          "_slow:\n    call .L_tl_alloc24\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "_slow:\n    call .L_tl_alloc40\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    call tl_alloc\n"))
        (compiler_backend.compiler-backend-string-contains? asm "    jb ")
        (compiler_backend.compiler-backend-string-contains? asm "    ja "))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-fast-alloc-multi-size-ok?) : bool
  (and
    (compiler-backend-inline-fast-alloc-multi-size-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-inline-fast-alloc-multi-size-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

(define compiler-backend-inline-fast-alloc-emergency-live-count : i64
  13)

(define (compiler-backend-inline-fast-alloc-emergency-regs) : (Array i64)
  (let
    [regs : (Array i64)
      (make-array i64 compiler-backend-inline-fast-alloc-emergency-live-count)]
    (begin
      (array-set! regs 0 compiler_abi.compiler-reg-id-r9)
      (array-set! regs 1 compiler_abi.compiler-reg-id-rcx)
      (array-set! regs 2 compiler_abi.compiler-reg-id-rdx)
      (array-set! regs 3 compiler_abi.compiler-reg-id-r10)
      (array-set! regs 4 compiler_abi.compiler-reg-id-r11)
      (array-set! regs 5 compiler_abi.compiler-reg-id-r8)
      (array-set! regs 6 compiler_abi.compiler-reg-id-r12)
      (array-set! regs 7 compiler_abi.compiler-reg-id-r13)
      (array-set! regs 8 compiler_abi.compiler-reg-id-r14)
      (array-set! regs 9 compiler_abi.compiler-reg-id-r15)
      (array-set! regs 10 compiler_abi.compiler-reg-id-rbx)
      (array-set! regs 11 compiler_abi.compiler-reg-id-rsi)
      (array-set! regs 12 compiler_abi.compiler-reg-id-rdi)
      regs)))

(define (compiler-backend-inline-fast-alloc-emergency-assignments-from
  [regs : (Array i64)]
  [index : i64]) : compiler_regalloc.CompilerRegAssignmentList
  (if (>= index (array-length regs))
    compiler_regalloc.CompilerRegAssignmentList.Nil
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        index
        (compiler_regalloc.CompilerRegLocation.Register (array-ref regs index)))
      (compiler-backend-inline-fast-alloc-emergency-assignments-from
        regs
        (+ index 1)))))

(define (compiler-backend-inline-fast-alloc-emergency-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler-backend-inline-fast-alloc-emergency-assignments-from
    (compiler-backend-inline-fast-alloc-emergency-regs)
    0))

(define (compiler-backend-inline-fast-alloc-emergency-instrs) : compiler_ir_types.CompilerIrInstrList
  (let
    [instrs : compiler_ir_types.CompilerIrInstrList
      compiler_ir_types.CompilerIrInstrList.Nil]
    [v : i64 (- compiler-backend-inline-fast-alloc-emergency-live-count 1)]
    (begin
      (while (>= v 0)
        (begin
          (set!
            instrs
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Mov
                (+ 30 v)
                (compiler_ir_types.CompilerIrValue.Var v)
                (compiler_ast_types.AstType.I64))
              instrs))
          (set! v (- v 1))))
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Call
          20
          (ci.intern "tl_alloc")
          (compiler_ir_types.CompilerIrCallArgs.One
            (compiler_ir_types.CompilerIrValue.I64 8))
          (compiler_ast_types.AstType.U64))
        instrs))))

