    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm) (string.eq asm want)]
    [(Err _) false]))

(define (compiler-backend-avx512-mask-reduce-ok?) : bool
  (and
    (compiler-backend-avx512-mask-reduce-emits?
      (Any)
      8
      "    kortestw %k1, %k1\n    setne %r12b\n    movzbl %r12b, %r12d\n")
    (compiler-backend-avx512-mask-reduce-emits?
      (All)
      16
      "    kortestw %k1, %k1\n    setc %r12b\n    movzbl %r12b, %r12d\n")
    (compiler-backend-avx512-mask-reduce-emits?
      (All)
      8
      "    kmovw %k1, %r12d\n    cmpl $255, %r12d\n    sete %r12b\n    movzbl %r12b, %r12d\n")))

(define (compiler-backend-avx512-mask-spill-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=spill:-8 %1=spill:-16 %2=spill:-24 %3=%r12"))

(define (compiler-backend-avx512-mask-spill-compare-assignments) : regalloc.CompilerRegAssignmentTable
  (regalloc.compiler-reg-assignments-prepend
    (&
      (regalloc.CompilerRegAssignment
        4
        (Register (cabi.compiler-abi-vector-register-id 6))))
    (regalloc.compiler-reg-assignments-prepend
      (&
        (regalloc.CompilerRegAssignment
          5
          (Register (cabi.compiler-abi-vector-register-id 7))))
      (compiler-backend-avx512-mask-spill-assignments))))

(define (compiler-backend-avx512-mask-spill-compare-emits-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_mode : unit
      (be_state.compiler-backend-set-current-mode!
        (be_state.compiler-backend-state-function-state backend-state)
        (Avx512))]
    [ok : bool
      (asm-ok?
        (be_simd.compiler-backend-emit-vector-compare
          (ast.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-avx512-mask-spill-compare-assignments)
          2
          (Eq)
          (Var 4)
          (Var 5)
          8
          (I64)
          (cdiag.compiler-diagnostic-at-start "" "")
          backend-state)
        (has "    vpcmpq $0, %zmm7, %zmm6, %k7\n" "    kmovw %k7, -24(%rbp)\n")
        (lacks "%ymm" "%k0"))]
    (be_state.compiler-backend-set-current-mode!
      (be_state.compiler-backend-state-function-state backend-state)
      (Scalar))
    ok))

(define (compiler-backend-avx512-mask-spill-binop-emits-ok?) : bool
  (asm-ok?
    (be_simd.compiler-backend-emit-avx512-mask-binop
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-avx512-mask-spill-assignments)
      2
      (And)
      (Var 0)
      (Var 1)
      8
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has
      "    kmovw -8(%rbp), %k7\n"
      "    kmovw %k7, %eax\n"
      "    kmovw -16(%rbp), %k7\n"
      "    kmovw %k7, %r10d\n"
      "    andl %r10d, %eax\n"
      "    kmovw %eax, %k7\n"
      "    kmovw %k7, -24(%rbp)\n")
    (lacks "%k0")))

(define (compiler-backend-avx512-mask-spill-not-emits-ok?) : bool
  (asm-ok?
    (be_simd.compiler-backend-emit-avx512-mask-not
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-avx512-mask-spill-assignments)
      2
      (Var 0)
      8
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has
      "    kmovw -8(%rbp), %k7\n"
      "    xorl $255, %eax\n"
      "    kmovw %eax, %k7\n"
      "    kmovw %k7, -24(%rbp)\n")
    (lacks "%k0")))

(define (compiler-backend-avx512-mask-spill-reduce-emits-ok?) : bool
  (asm-ok?
    (be_simd.compiler-backend-emit-avx512-mask-reduce
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-avx512-mask-spill-assignments)
      3
      (Any)
      (Var 0)
      8
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (has
      "    kmovw -8(%rbp), %k7\n"
      "    kortestw %k7, %k7\n"
      "    setne %r12b\n"
      "    movzbl %r12b, %r12d\n")))

(define (compiler-backend-avx512-mask-spill-load-store-emits-ok?) : bool
  (match (be_simd.compiler-backend-emit-avx512-mask-load
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-avx512-mask-spill-assignments)
    2
    (Var 3)
    (I64 0)
    (Var 1)
    8
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok load-asm)
      (match (be_simd.compiler-backend-emit-avx512-mask-store
        (ast.ast-node-pool-reader-type-segment-bases)
        (compiler-backend-avx512-mask-spill-assignments)
        (Var 3)
        (I64 0)
        (Var 0)
        (Var 1)
        8
        (cdiag.compiler-diagnostic-at-start "" "")
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active)))
        [(Ok store-asm)
          (and
            (asm-has?
              load-asm
              "    kmovw -16(%rbp), %k7\n"
              "    vpcmpub $4, "
              "    kmovw %k7, -24(%rbp)\n")
            (asm-has?
              store-asm
              "    kmovw -8(%rbp), %k7\n"
              "    kmovw -16(%rbp), %k7\n"
              "    vmovdqu8 %zmm"))]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-avx512-mask-spill-direct-ok?) : bool
  (and
    (compiler-backend-avx512-mask-spill-compare-emits-ok?)
    (compiler-backend-avx512-mask-spill-binop-emits-ok?)
    (compiler-backend-avx512-mask-spill-not-emits-ok?)
    (compiler-backend-avx512-mask-spill-reduce-emits-ok?)
    (compiler-backend-avx512-mask-spill-load-store-emits-ok?)))

(define (compiler-backend-avx512-mask-spill-sums) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%14 = add %7, %8 : i64
     %15 = add %14, %9 : i64
     %16 = add %15, %10 : i64
     %17 = add %16, %11 : i64
     %18 = add %17, %12 : i64
     %19 = add %18, %13 : i64
     return %19"))

(define (compiler-backend-avx512-mask-spill-reduces
  [i : i64]
  [rest : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (> i 6)
    rest
    (compiler-backend-test-instr-seq-prepend
      (MaskReduce (+ 7 i) (Any) (Var i) 8)
      (compiler-backend-avx512-mask-spill-reduces (+ i 1) rest))))

(define (compiler-backend-avx512-mask-spill-tails
  [i : i64]
  [rest : ir.CompilerIrInstrSeq]) : ir.CompilerIrInstrSeq
  (if (> i 6)
    rest
    (compiler-backend-test-instr-seq-prepend
      (TailMask i (I64 i) (I64 8) 8)
      (compiler-backend-avx512-mask-spill-tails (+ i 1) rest))))

(define (compiler-backend-avx512-mask-spill-function) : ir.CompilerIrFunction
  (Function
    (ci.intern "mask_spill")
    (ir.compiler-ir-param-seq-empty)
    (I64)
    20
    (ir.compiler-ir-blocks
      (ir.CompilerIrBlock.Block
        (ir.compiler-ir-label "entry")
        (compiler-backend-avx512-mask-spill-tails
          0
          (compiler-backend-avx512-mask-spill-reduces
            0
            (compiler-backend-avx512-mask-spill-sums)))))
    Ordinary))

(define (compiler-backend-maybe-location-mask-stack?
  [location : regalloc.CompilerRegMaybeLocation]) : bool
  (match location
    [(Some found)
      (match found
        [(Spill _) true]
        [_ false])]
    [(No) true]))

(define (compiler-backend-avx512-mask-spill-assignment?
  [assignments : regalloc.CompilerRegAssignmentTable]) : bool
  (for [var (iterator.range 0 (+ 6 1))]
    (when
      (compiler-backend-maybe-location-mask-stack?
        (regalloc.compiler-reg-assignment-lookup assignments var))
      (return true))
    unit)
  false)

(define (compiler-backend-avx512-mask-spill-plan-ok?) : bool
  (match (reg_tests.compiler-reg-plan-function
    (compiler-backend-avx512-mask-spill-function))
    [(Plan assignments _ _ _ _)
      (compiler-backend-avx512-mask-spill-assignment? assignments)]))

(define (compiler-backend-avx512-mask-spill-compile-ok?) : bool
  (match (backend.compiler-backend-emit-program-target-with-mode
    (compiler-backend-vector-home-program
      (compiler-backend-avx512-mask-spill-function))
    (be_state.CompilerBackendTarget.Linux)
    (Avx512)
    (ir.compiler-source-spans-empty)
    true)
    [(Ok asm)
      (and
        (compiler-backend-avx512-mask-spill-plan-ok?)
        (asm-has? asm "kmovw")
        (asm-lacks? asm "mask spills are not implemented"))]
    [(Err _) false]))

(define (compiler-backend-avx512-mask-spill-ok?) : bool
  (and
    (compiler-backend-avx512-mask-spill-direct-ok?)
    (compiler-backend-avx512-mask-spill-plan-ok?)
    (compiler-backend-avx512-mask-spill-compile-ok?)))

(define (compiler-backend-simd-copy-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes
    "%0=%vec6 %1=%vec7 %2=spill:-64 %3=%vec8 %4=spill:-128 %5=%k1 %6=%k2 %7=spill:-8 %8=%k3 %9=spill:-16"))

(define (compiler-backend-vector-copy-emits?
  [dst : i64]
  [src : i64]
  [width : String]
  [want : String]) : bool
  (match (be_simd.compiler-backend-emit-vector-copy
    (compiler-backend-simd-copy-assignments)
    dst
    (Var src)
    width
    (I64)
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm) (string.eq asm want)]
    [(Err _) false]))

(define (compiler-backend-vector-copy-line
  [move : (& move str)]
  [src : (& src str)]
  [dst : (& dst str)]) : String
  (str_cat.str-cat
    "    "
    (str_cat.str-cat
      move
      (str_cat.str-cat
        " "
        (str_cat.str-cat src (str_cat.str-cat ", " (str_cat.str-cat dst "\n")))))))

(define (compiler-backend-vector-copy-paths-ok? [width : String]) : bool
  (let
    [move : String
      (if (string.eq width "zmm")
        "vmovdqu64"
        "vmovdqu")]
    [r6 : String (str_cat.str-cat "%" (str_cat.str-cat width "6"))]
    [r7 : String (str_cat.str-cat "%" (str_cat.str-cat width "7"))]
    [r8 : String (str_cat.str-cat "%" (str_cat.str-cat width "8"))]
    [r14 : String (str_cat.str-cat "%" (str_cat.str-cat width "14"))]
    [r15 : String (str_cat.str-cat "%" (str_cat.str-cat width "15"))]
    (and
      (compiler-backend-vector-copy-emits?
        1
        0
        (owned_view.compiler-owned-shared-view width)
        (compiler-backend-vector-copy-line move r6 r7))
      (compiler-backend-vector-copy-emits?
        2
        0
        (owned_view.compiler-owned-shared-view width)
        (str_cat.str-cat
          (compiler-backend-vector-copy-line move r6 r15)
          (compiler-backend-vector-copy-line move r15 "-64(%rbp)")))
      (compiler-backend-vector-copy-emits?
        3
        2
        (owned_view.compiler-owned-shared-view width)
        (str_cat.str-cat
          (compiler-backend-vector-copy-line move "-64(%rbp)" r14)
          (compiler-backend-vector-copy-line move r14 r8)))
      (compiler-backend-vector-copy-emits?
        4
        2
        width
        (str_cat.str-cat
          (compiler-backend-vector-copy-line move "-64(%rbp)" r14)
          (str_cat.str-cat
            (compiler-backend-vector-copy-line move r14 r15)
            (compiler-backend-vector-copy-line move r15 "-128(%rbp)")))))))

(define (compiler-backend-mask-copy-emits?
  [dst : i64]
  [src : i64]
  [want : String]) : bool
  (match (be_simd.compiler-backend-emit-avx512-mask-copy
    (compiler-backend-simd-copy-assignments)
    dst
    (Var src)
    8
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm) (string.eq asm want)]
    [(Err _) false]))

(define (compiler-backend-mask-copy-paths-ok?) : bool
  (and
    (compiler-backend-mask-copy-emits? 6 5 "    kmovw %k1, %k2\n")
    (compiler-backend-mask-copy-emits?
      7
      5
      "    kmovw %k1, %k7\n    kmovw %k7, -8(%rbp)\n")
    (compiler-backend-mask-copy-emits?
      8
      7
      "    kmovw -8(%rbp), %k7\n    kmovw %k7, %k3\n")
    (compiler-backend-mask-copy-emits?
      9
      7
      "    kmovw -8(%rbp), %k7\n    kmovw %k7, -16(%rbp)\n")))

;; `kind` 0 is no shape, 1 a vector and 2 a mask of `lanes` lanes.
(define (compiler-backend-simd-copy-shape-is?
  [shape : be_simd.CompilerBackendSimdCopyShape]
  [kind : i64]
  [lanes : i64]) : bool
  (match shape
    [(No) (= kind 0)]
    [(Vector got _) (and (= kind 1) (= got lanes))]
    [(Mask got) (and (= kind 2) (= got lanes))]))

;; The query walks a cons block list and a block array separately, so every
;; graph is asked both ways.
(define (compiler-backend-simd-copy-shape-case-ok?
  [text : String]
  [dst : i64]
  [vars : i64]
  [kind : i64]
  [lanes : i64]) : bool
  (and
    (compiler-backend-simd-copy-shape-is?
      (be_simd.compiler-backend-simd-copy-shape
        (irt.blocks (owned_view.compiler-owned-shared-view text))
        dst
        vars)
      kind
      lanes)
    (compiler-backend-simd-copy-shape-is?
      (be_simd.compiler-backend-simd-copy-shape (irt.blocks text) dst vars)
      kind
      lanes)))

;; `%1 = mov %2` ... `%n = mov 0`, listed in each of two blocks: every variable
;; has two definitions and no chain reaches a vector, the shape loop-carried
;; copies take below opt2 (#8394). Re-exploring each definition's chain would
;; take 2^n steps; following each variable once takes n.
(define (compiler-backend-simd-copy-shape-branching-text [n : i64]) : String
  (let
    [body : String ""]
    (for [i (iterator.range 1 n)]
      (set!
        body
        (str_cat.str-cat
          body
          "  %"
          (string.int->string i)
          " = mov %"
          (string.int->string (+ i 1))
          " : i64\n")))
    (str_cat.str-cat
      "first:\n"
      body
      "  %"
      (string.int->string n)
      " = mov 0 : i64\n  jump second\nsecond:\n"
      body
      "  %"
      (string.int->string n)
      " = mov 0 : i64\n  return 0\n")))

(define (compiler-backend-simd-copy-shape-ok?) : bool
  (and
    ;; A mask reached through two copies.
    (compiler-backend-simd-copy-shape-case-ok?
      "entry:
         %3 = vector_compare_lt %1, %2 lanes 4 : i64
         %4 = mov %3 : i64
         %5 = mov %4 : i64
         return 0"
      5
      6
      2
      4)
    ;; Self-copies and copy cycles terminate without a shape.
    (compiler-backend-simd-copy-shape-case-ok?
      "entry:
         %1 = mov %1 : i64
         return 0"
      1
      2
      0
      0)
    (compiler-backend-simd-copy-shape-case-ok?
      "entry:
         %1 = mov %2 : i64
         jump back
       back:
         %2 = mov %1 : i64
         jump entry"
      1
      3
      0
      0)
    ;; Cutting the cycle back into %1 does not end %2's scan: its later
    ;; definition in the same block is a vector.
    (compiler-backend-simd-copy-shape-case-ok?
      "entry:
         %1 = mov %2 : i64
         jump back
       back:
         %2 = mov %1 : i64
         %2 = vector_add %3, %4 lanes 4 : i64
         jump entry"
      1
      5
      1
      4)
    ;; Neither does a scalar-sourced definition earlier in the block.
    (compiler-backend-simd-copy-shape-case-ok?
      "entry:
         %1 = mov 0 : i64
         %1 = vector_add %2, %3 lanes 8 : i64
         return 0"
      1
      4
      1
      8)
    (compiler-backend-simd-copy-shape-case-ok?
      (compiler-backend-simd-copy-shape-branching-text 40)
      1
      41
      0
      0)))

(define (compiler-backend-simd-copy-paths-ok?) : bool
  (and
    (compiler-backend-vector-copy-paths-ok? "ymm")
    (compiler-backend-vector-copy-paths-ok? "zmm")
    (compiler-backend-mask-copy-paths-ok?)
    (compiler-backend-simd-copy-shape-ok?)))

(define (compiler-backend-vector-call-lifetime-spill-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-program-target-with-mode
      (compiler-backend-vector-home-program
        (compiler-backend-vector-call-lifetime-function))
      (be_state.CompilerBackendTarget.Linux)
      (Avx2)
      (ir.compiler-source-spans-empty)
      true)
    (has
      "    call _tl_side_effect\n"
      "    vmovdqu %ymm14, 16(%rsp)\n"
      "    vmovdqu 16(%rsp), %ymm14\n"
      "    vpaddq 16(%rsp), %ymm14, %ymm6\n")))

(define (compiler-backend-colored-vector-extent-case?
  [lanes : i64]
  [target : be_state.CompilerBackendTarget]) : bool
  (let
    [body : text_buf.TextBuf
      (text_buf.append
        (text_buf.empty)
        "function @colored_vector_extent() -> f64 vars 10 {\nentry:\n")]
    ;; Nine independent full-width values remain live across an ordinary
    ;; call. Their final homes exceed the raw ten-variable ID domain.
    (for [index (iterator.range 0 9)]
      (set!
        body
        (text_buf.append
          body
          (str_cat.str-cat
            "%"
            (string.int->string index)
            " = vector_load 0, "
            (string.int->string index)
            " lanes "
            (string.int->string lanes)
            " : i64\n"))))
    (set! body (text_buf.append body "%9 = call side_effect() : f64\n"))
    (for [index (iterator.range 0 9)]
      (set!
        body
        (text_buf.append
          body
          (str_cat.str-cat
            "vector_store 0, "
            (string.int->string index)
            ", %"
            (string.int->string index)
            " lanes "
            (string.int->string lanes)
            " : i64\n"))))
    (set! body (text_buf.append body "return %9\n}"))
    (match (backend.compiler-backend-emit-program-target-with-mode
      (compiler-backend-vector-home-program (irt.func (text_buf.render body)))
      target
      (if (= lanes 4)
        (Avx2)
        (Avx512))
      (ir.compiler-source-spans-empty)
      false)
      [(Ok asm)
        (and
          (asm-has? asm "    call _tl_side_effect\n")
          (>=
            (backend.compiler-backend-string-count
              asm
              (if (= lanes 4)
                "vmovdqu "
                "vmovdqu64 "))
            18)
          (asm-lacks? asm "register home unavailable"))]
      [(Err _) false])))

(define (compiler-backend-colored-vector-extent-ok?) : bool
  (and
    (compiler-backend-colored-vector-extent-case?
      4
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-colored-vector-extent-case?
      8
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-colored-vector-extent-case?
      4
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-colored-vector-extent-case?
      8
      (be_state.CompilerBackendTarget.Windows))))

(test
  backend-colored-vector-id-extent
  (unless
    (compiler-backend-colored-vector-extent-ok?)
    (io.panic "wide homes beyond the raw ID count lost final emission facts")))

(define (compiler-backend-vector-load-binop-fold-function
  [name : String]
  [op : ir.CompilerIrBinOp]
  [load-on-lhs : bool]) : ir.CompilerIrFunction
  (let
    [lhs : ir.CompilerIrValue
      (if load-on-lhs
        (Var 1)
        (Var 0))]
    [rhs : ir.CompilerIrValue
      (if load-on-lhs
        (Var 0)
        (Var 1))]
    (Function
      (ci.intern name)
      (ir.compiler-ir-param-seq-empty)
      (Unit)
      3
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (compiler-backend-test-instr-seq-prepend
            (irt.instr "%0 = splat 7 lanes 4 : i64")
            (compiler-backend-test-instr-seq-prepend
              (irt.instr "%1 = vector_load 0, 0 lanes 4 : i64")
              (compiler-backend-test-instr-seq-prepend
                (ir.ir-instr-vector-bin-op 2 op lhs rhs 4 (I64))
                (irt.instrs "return"))))))
      Ordinary)))

(define (compiler-backend-vector-load-binop-fold-program
  [op : ir.CompilerIrBinOp]
  [load-on-lhs : bool]) : ir.CompilerIrProgram
  (compiler-backend-vector-home-program
    (compiler-backend-vector-load-binop-fold-function
      "vector_load_binop_fold"
      op
      load-on-lhs)))

(define (compiler-backend-vector-load-binop-folds?
  [op : ir.CompilerIrBinOp]
  [load-on-lhs : bool]
  [mnemonic : String]) : bool
  (match (backend.compiler-backend-emit-program-target-with-mode
    (compiler-backend-vector-load-binop-fold-program op load-on-lhs)
    (be_state.CompilerBackendTarget.Linux)
    (Avx2)
    (ir.compiler-source-spans-empty)
    true)
    [(Ok asm)
      (and
        (let
          [needle (str_cat.str-cat "    " mnemonic " (%r8), ")]
          (asm-has? asm needle))
        (asm-lacks? asm "    vmovdqu (%r8), ")
        (not
          (let
            [needle (str_cat.str-cat "    " mnemonic " (%rax), ")]
            (asm-has? asm needle))))]
    [(Err _) false]))

(define (compiler-backend-vector-load-binop-does-not-fold?
  [op : ir.CompilerIrBinOp]
  [load-on-lhs : bool]
  [mnemonic : String]) : bool
  (match (backend.compiler-backend-emit-program-target-with-mode
    (compiler-backend-vector-load-binop-fold-program op load-on-lhs)
    (be_state.CompilerBackendTarget.Linux)
    (Avx2)
    (ir.compiler-source-spans-empty)
    true)
    [(Ok asm)
      (and
        (asm-has? asm "    vmovdqu (%r8), ")
        (not
          (let
            [needle (str_cat.str-cat "    " mnemonic " (%r8), ")]
            (asm-has? asm needle)))
        (asm-lacks? asm "    vmovdqu (%rax), "))]
    [(Err _) false]))

(define (compiler-backend-vector-load-binop-folding-ok?) : bool
  (and
    (compiler-backend-vector-load-binop-folds? (Add) true "vpaddq")
    (compiler-backend-vector-load-binop-folds? (Sub) false "vpsubq")
    (compiler-backend-vector-load-binop-does-not-fold? (Sub) true "vpsubq")))

;; A fresh backend state whose function plans a SIMD staging region of BYTES
;; below a 192-byte frame base, as compiler-backend-emit-function does for a
;; body whose largest staged sequence needs BYTES (#7497).
(define (compiler-backend-simd-staging-state [bytes : i64]) : be_state.CompilerBackendState
  (let
    [state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (be_scalar.compiler-backend-simd-scratch-plan!
      (be_state.compiler-backend-state-function-state state)
      bytes
      192)
    state))

;; Byte OFFSET of that region, as the emitters spell it.
(define (compiler-backend-simd-staging-address [bytes : i64] [offset : i64]) : String
  (str_cat.str-cat (string.int->string (- offset (+ 192 bytes))) "(%rbp)"))

;; #7497 census fixtures: one instruction of each staged route, operands in
;; registers %0/%1/%3 and the result in %2.
(define (compiler-backend-simd-scratch-binop
  [op : ir.CompilerIrBinOp]
  [lanes : i64]
  [ty : ast.AstType]) : ir.CompilerIrInstr
  (ir.ir-instr-vector-bin-op 2 op (Var 0) (Var 1) lanes ty))

(define (compiler-backend-simd-scratch-load [lanes : i64] [ty : ast.AstType]) : ir.CompilerIrInstr
  (ir.ir-instr-predicated-load 2 (Var 0) (I64 0) (Var 1) lanes ty))

(define (compiler-backend-simd-scratch-store [lanes : i64] [ty : ast.AstType]) : ir.CompilerIrInstr
  (ir.ir-instr-predicated-store (Var 0) (I64 0) (Var 1) (Var 3) lanes ty))

(define (compiler-backend-simd-scratch-gather [lanes : i64] [ty : ast.AstType]) : ir.CompilerIrInstr
  (ir.ir-instr-gather-load 2 (Var 0) (Var 1) (I64 0) false lanes ty))

(define (compiler-backend-simd-scratch-shuffle [lanes : i64] [ty : ast.AstType]) : ir.CompilerIrInstr
  (ir.ir-instr-vector-shuffle 2 (Var 0) (Var 1) (Some (Var 3)) (I64 4) lanes ty))

(define (compiler-backend-simd-scratch-tail-mask [lanes : i64]) : ir.CompilerIrInstr
  (TailMask 2 (Var 0) (Var 1) lanes))

;; The census sizes each staged route the way its emitter claims it: the
;; largest request is the AVX-512 byte shift, and a route with a native masked
;; or register form requests nothing. A vector binop and a shuffle take their
;; ISA from their own shape; the predicated, gather and tail-mask routes from
;; the function's mode.
(define (compiler-backend-simd-scratch-requests-ok?) : bool
  (and
    (be_state.backend-and8
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-binop (Shl (I8)) 64 (I8))
          false)
        448)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-binop (Shr (U8)) 32 (U8))
          true)
        224)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-binop (Shl (I16)) 16 (I16))
          true)
        128)
      ;; AVX-512 has vpsllvw.
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-binop (Shl (I16)) 32 (I16))
          false)
        0)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-binop (Add) 32 (I8))
          true)
        0)
      ;; A shape neither ISA accepts is diagnosed, not staged.
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-binop (Shl (I8)) 7 (I8))
          true)
        0)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-load 16 (I16))
          true)
        32)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-load 32 (Bool))
          true)
        32))
    (be_state.backend-and8
      ;; vpmaskmovq, and AVX-512 masked moves.
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-load 4 (I64))
          true)
        0)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-load 32 (I16))
          false)
        0)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-store 32 (U8))
          true)
        32)
      ;; An AVX2 bool store tests mask bits in GPRs; AVX-512 builds its bytes
      ;; in registers.
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-store 32 (Bool))
          true)
        0)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-store 64 (Bool))
          false)
        0)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-store 8 (F32))
          true)
        0)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-gather 8 (I32))
          true)
        128)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-gather 4 (I64))
          true)
        32))
    (be_state.backend-and8
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-gather 16 (F32))
          false)
        128)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-gather 8 (F64))
          false)
        0)
      ;; An AVX2 dword gather is eight lanes.
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-gather 4 (I32))
          true)
        0)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-shuffle 4 (I64))
          true)
        96)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-shuffle 8 (I32))
          true)
        128)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-shuffle 8 (I64))
          true)
        192)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-shuffle 16 (F32))
          false)
        256)
      (=
        (be_scalar.compiler-backend-simd-scratch-request
          (compiler-backend-simd-scratch-tail-mask 8)
          true)
        32))
    (=
      (be_scalar.compiler-backend-simd-scratch-request
        (compiler-backend-simd-scratch-tail-mask 4)
        true)
      0)
    (=
      (be_scalar.compiler-backend-simd-scratch-request
        (compiler-backend-simd-scratch-tail-mask 16)
        false)
      0)))

;; A function plans its largest request once, across every block, and a body
;; that stages nothing plans no region.
(define (compiler-backend-simd-scratch-census-ok?) : bool
  (let
    [mixed : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (ir.compiler-ir-instr-seq3
            (compiler-backend-simd-scratch-tail-mask 8)
            (compiler-backend-simd-scratch-shuffle 4 (I64))
            (compiler-backend-simd-scratch-gather 4 (I64))))
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "next")
          (ir.compiler-ir-instr-seq2
            (compiler-backend-simd-scratch-load 16 (I16))
            (compiler-backend-simd-scratch-shuffle 8 (I32)))))]
    [widest : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (ir.compiler-ir-instr-seq2
            (compiler-backend-simd-scratch-shuffle 16 (I32))
            (compiler-backend-simd-scratch-binop (Shr (I8)) 64 (I8)))))]
    [native : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (ir.compiler-ir-instr-seq3
            (compiler-backend-simd-scratch-load 4 (I64))
            (compiler-backend-simd-scratch-tail-mask 4)
            (compiler-backend-simd-scratch-binop (Add) 32 (I8)))))]
    (and
      (= (be_scalar.compiler-backend-simd-scratch-census mixed (Avx2)) 128)
      (=
        (be_scalar.compiler-backend-simd-scratch-census
          (owned_view.compiler-owned-shared-view widest)
          (Avx512))
        448)
      (= (be_scalar.compiler-backend-simd-scratch-census native (Avx2)) 0)
      (=
        (be_scalar.compiler-backend-simd-scratch-census
          (ir.compiler-ir-block-list-empty)
          (Avx2))
        0)
      ;; A scalar-mode function is not walked.
      (= (be_scalar.compiler-backend-simd-scratch-census widest (Scalar)) 0))))

;; A claim beyond the plan fails at its instruction, naming both sizes. The
;; check after the body fails a plan no sequence claimed in full, passes once
;; the largest claim meets it, and fails again when a reference strays past
;; the plan without a claim.
(define (compiler-backend-simd-scratch-checks-ok?) : bool
  (let
    [over : be_state.ResultCompilerBackend
      (be_simd.compiler-backend-emit-vector-binop
        (Avx2)
        (ast.ast-node-pool-reader-type-segment-bases)
        (compiler-backend-vector-binop-test-assignments)
        2
        (Shl (I8))
        (Var 0)
        (Var 1)
        32
        (I8)
        (cdiag.compiler-diagnostic-at-start "" "")
        (compiler-backend-simd-staging-state 128))]
    [state : be_state.CompilerBackendState
      (compiler-backend-simd-staging-state 32)]
    [unclaimed : bool
      (be_scalar.compiler-backend-simd-scratch-drift?
        (be_state.compiler-backend-state-function-state state))]
    [partial : bool
      (match (be_operand.compiler-backend-simd-scratch-checked
        state
        (cdiag.compiler-diagnostic-at-start "" "")
        16
        (Ok ""))
        [(Ok _)
          (be_scalar.compiler-backend-simd-scratch-drift?
            (be_state.compiler-backend-state-function-state state))]
        [(Err _) false])]
    [full : bool
      (match (be_operand.compiler-backend-simd-scratch-checked
        state
        (cdiag.compiler-diagnostic-at-start "" "")
        32
        (Ok ""))
        [(Ok _)
          (not
            (be_scalar.compiler-backend-simd-scratch-drift?
              (be_state.compiler-backend-state-function-state state)))]
        [(Err _) false])]
    [in-plan : bool
      (begin
        (be_operand.compiler-backend-simd-scratch-address state 31)
        (not
          (be_scalar.compiler-backend-simd-scratch-drift?
            (be_state.compiler-backend-state-function-state state))))]
    [stray : bool
      (begin
        (be_operand.compiler-backend-simd-scratch-address state 32)
        (be_scalar.compiler-backend-simd-scratch-drift?
          (be_state.compiler-backend-state-function-state state)))]
    (and
      (match over
        [(Err diag)
          (string.eq
            (cdiag.compiler-diagnostic-message (__tl-box-place diag))
            "backend: SIMD staging needs 224 bytes but the function planned 128")]
        [(Ok _) false])
      unclaimed
      partial
      full
      in-plan
      stray)))

(define (compiler-backend-vector-binop-test-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%vec6 %1=%vec7 %2=%vec8"))

(define (compiler-backend-avx2-vector-binop-emits?
  [op : ir.CompilerIrBinOp]
  [elem-ty : ast.AstType]
  [lanes : i64]
  [want : String]) : bool
  (match (be_simd.compiler-backend-emit-vector-binop
    (Avx2)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-binop-test-assignments)
    2
    op
    (Var 0)
    (Var 1)
    lanes
    elem-ty
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm) (string.eq asm want)]
    [(Err _) false]))

(define (compiler-backend-avx512-vector-binop-emits?
  [op : ir.CompilerIrBinOp]
  [elem-ty : ast.AstType]
  [lanes : i64]
  [want : String]) : bool
  (match (be_simd.compiler-backend-emit-vector-binop
    (Avx512)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-binop-test-assignments)
    2
    op
    (Var 0)
    (Var 1)
    lanes
    elem-ty
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok asm) (string.eq asm want)]
    [(Err _) false]))

(define (compiler-backend-avx2-vector-binop-diagnostic?
  [op : ir.CompilerIrBinOp]
  [elem-ty : ast.AstType]
  [lanes : i64]
  [want : String]) : bool
  (match (be_simd.compiler-backend-emit-vector-binop
    (Avx2)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-binop-test-assignments)
    2
    op
    (Var 0)
    (Var 1)
    lanes
    elem-ty
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Err diag)
      (string.eq (cdiag.compiler-diagnostic-message (__tl-box-place diag)) want)]
    [(Ok _) false]))

(define (compiler-backend-avx512-vector-binop-diagnostic?
  [op : ir.CompilerIrBinOp]
  [elem-ty : ast.AstType]
  [lanes : i64]
  [want : String]) : bool
  (match (be_simd.compiler-backend-emit-vector-binop
    (Avx512)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-binop-test-assignments)
    2
    op
    (Var 0)
    (Var 1)
    lanes
    elem-ty
    (cdiag.compiler-diagnostic-at-start "" "")
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Err diag)
      (string.eq (cdiag.compiler-diagnostic-message (__tl-box-place diag)) want)]
    [(Ok _) false]))

(define (compiler-backend-byte-vector-shift-shape?
  [avx512 : bool]
  [op : ir.CompilerIrBinOp]
  [elem-ty : ast.AstType]
  [lanes : i64]
  [widen : String]
  [shift : String]
  [stack-bytes : i64]) : bool
  (match (if avx512
    (be_simd.compiler-backend-emit-vector-binop
      (Avx512)
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-binop-test-assignments)
      2
      op
      (Var 0)
      (Var 1)
      lanes
      (owned_view.compiler-owned-shared-view elem-ty)
      (cdiag.compiler-diagnostic-at-start "" "")
      (compiler-backend-simd-staging-state stack-bytes))
    (be_simd.compiler-backend-emit-vector-binop
      (Avx2)
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-vector-binop-test-assignments)
      2
      op
      (Var 0)
      (Var 1)
      lanes
      (owned_view.compiler-owned-shared-view elem-ty)
      (cdiag.compiler-diagnostic-at-start "" "")
      (compiler-backend-simd-staging-state stack-bytes)))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (=
            (backend.compiler-backend-string-count asm widen)
            (match elem-ty
              [(U8) 9]
              [_ 8]))
          (= (backend.compiler-backend-string-count asm shift) 4)
          (= (backend.compiler-backend-string-count asm "vpackusdw") 2)
          (= (backend.compiler-backend-string-count asm "vpackuswb") 1)
          (= (backend.compiler-backend-string-count asm "vpermd") 1)
          (let
            [lhs-store
              (str_cat.str-cat
                "mm6, "
                (compiler-backend-simd-staging-address stack-bytes 0)
                "\n")]
            [rhs-store
              (str_cat.str-cat
                "mm7, "
                (compiler-backend-simd-staging-address
                  stack-bytes
                  (/ stack-bytes 7))
                "\n")]
            (asm-has? asm lhs-store rhs-store))
          (asm-lacks? asm "%rsp")
          (= (backend.compiler-backend-string-count asm "vpsrld $24") 1))
        (= (backend.compiler-backend-string-count asm "movl $50462976") 1)
        (= (backend.compiler-backend-string-count asm "movl $117835012") 1)
        (if avx512
          (and
            (= (backend.compiler-backend-string-count asm "movl $185207048") 1)
            (= (backend.compiler-backend-string-count asm "movl $252579084") 1)
            (asm-has?
              asm
              "    vpsrld $2, %zmm0, %zmm0\n"
              "    vpslld $30, %zmm8, %zmm8\n"))
          (and
            (= (backend.compiler-backend-string-count asm "movl $185207048") 0)
            (= (backend.compiler-backend-string-count asm "movl $252579084") 0)
            (asm-has?
              asm
              "    vpsrld $1, %ymm0, %ymm0\n"
              "    vpslld $31, %ymm8, %ymm8\n"))))]
    [(Err _) false]))

(define (compiler-backend-byte-vector-shift-spill-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=spill:-64 %1=spill:-128 %2=spill:-192"))

(define (compiler-backend-byte-vector-shift-spill-ok? [avx512 : bool]) : bool
  (match (if avx512
    (be_simd.compiler-backend-emit-vector-binop
      (Avx512)
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-byte-vector-shift-spill-assignments)
      2
      (Shl (I8))
      (Var 0)
      (Var 1)
      64
      (I8)
      (cdiag.compiler-diagnostic-at-start "" "")
      (compiler-backend-simd-staging-state 448))
    (be_simd.compiler-backend-emit-vector-binop
      (Avx2)
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-byte-vector-shift-spill-assignments)
      2
      (Shl (I8))
      (Var 0)
      (Var 1)
      32
      (I8)
      (cdiag.compiler-diagnostic-at-start "" "")
      (compiler-backend-simd-staging-state 224)))
    [(Ok asm)
      (and
        (asm-lacks? asm "%rsp")
        (if avx512
          (asm-has?
            asm
            "    vmovdqu8 -64(%rbp), %zmm14\n"
            "    vmovdqu8 -128(%rbp), %zmm15\n"
            "    vmovdqu8 %zmm14, -640(%rbp)\n"
            "    vpermd %zmm1, %zmm0, %zmm14\n    vmovdqu8 %zmm14, -192(%rbp)\n")
          (asm-has?
            asm
            "    vmovdqu -64(%rbp), %ymm14\n"
            "    vmovdqu -128(%rbp), %ymm15\n"
            "    vmovdqu %ymm14, -416(%rbp)\n"
            "    vpermd %ymm1, %ymm0, %ymm14\n    vmovdqu %ymm14, -192(%rbp)\n")))]
    [(Err _) false]))

(define (compiler-backend-avx2-word-vector-shift-shape?
  [op : ir.CompilerIrBinOp]
  [elem-ty : ast.AstType]
  [widen : String]
  [shift : String]) : bool
  (match (be_simd.compiler-backend-emit-vector-binop
    (Avx2)
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-binop-test-assignments)
    2
    op
    (Var 0)
    (Var 1)
    16
    elem-ty
    (cdiag.compiler-diagnostic-at-start "" "")
    (compiler-backend-simd-staging-state 128))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (= (backend.compiler-backend-string-count asm widen) 4)
          (= (backend.compiler-backend-string-count asm shift) 2)
          (= (backend.compiler-backend-string-count asm "vpackusdw") 1)
          (= (backend.compiler-backend-string-count asm "vpermq") 1)
          (asm-has? asm "    vmovdqu %ymm7, -288(%rbp)\n")
          (asm-lacks? asm "%rsp")
          (asm-has? asm "    vpsrld $16, %ymm0, %ymm0\n")
          (asm-has? asm "    vpermq $216, %ymm1, %ymm8\n"))
        (let
          [needle (str_cat.str-cat "    " widen " -320(%rbp), %ymm0\n")]
          (asm-has? asm needle))
        (let
          [needle (str_cat.str-cat "    " widen " -304(%rbp), %ymm0\n")]
          (asm-has? asm needle)))]
    [(Err _) false]))

(define (compiler-backend-word-vector-shift-spill-ok? [avx512 : bool]) : bool
  (match (if avx512
    (be_simd.compiler-backend-emit-vector-binop
      (Avx512)
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-byte-vector-shift-spill-assignments)
      2
      (Shl (I16))
      (Var 0)
      (Var 1)
      32
      (I16)
      (cdiag.compiler-diagnostic-at-start "" "")
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
    (be_simd.compiler-backend-emit-vector-binop
      (Avx2)
      (ast.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-byte-vector-shift-spill-assignments)
      2
      (Shl (I16))
      (Var 0)
      (Var 1)
      16
      (I16)
      (cdiag.compiler-diagnostic-at-start "" "")
      (compiler-backend-simd-staging-state 128)))
    [(Ok asm)
      (if avx512
        (asm-has?
          asm
          "    vmovdqu16 -64(%rbp), %zmm14\n"
          "    vpsllvw -128(%rbp), %zmm14, %zmm14\n"
          "    vmovdqu16 %zmm14, -192(%rbp)\n")
        (asm-has?
          asm
          "    vmovdqu -64(%rbp), %ymm14\n"
          "    vmovdqu -128(%rbp), %ymm15\n"
          "    vpermq $216, %ymm1, %ymm14\n    vmovdqu %ymm14, -192(%rbp)\n"))]
    [(Err _) false]))

(define (compiler-backend-vector-bitwise-binop-ok?) : bool
  (and
    (be_state.backend-and8
      (compiler-backend-avx2-vector-binop-emits?
        (Sub)
        (F32)
        8
        "    vsubps %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (BitAnd)
        (I64)
        4
        "    vpand %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (BitAnd)
        (U8)
        32
        "    vpand %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (BitOr)
        (I32)
        8
        "    vpor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (BitOr)
        (I16)
        16
        "    vpor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (BitXor)
        (U64)
        4
        "    vpxor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (BitXor)
        (I8)
        32
        "    vpxor %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-diagnostic?
        (BitAnd)
        (F64)
        4
        "backend: unsupported AVX2 vector binary op"))
    (be_state.backend-and8
      (compiler-backend-avx512-vector-binop-emits?
        (Sub)
        (F32)
        16
        "    vsubps %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (BitAnd)
        (I64)
        8
        "    vpandq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (BitAnd)
        (U8)
        64
        "    vpandd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (BitOr)
        (U64)
        8
        "    vporq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (BitOr)
        (I16)
        32
        "    vpord %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (BitXor)
        (I64)
        8
        "    vpxorq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (BitXor)
        (I8)
        64
        "    vpxord %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-diagnostic?
        (BitOr)
        (F64)
        8
        "backend: unsupported AVX-512 vector binary op"))))

(define (compiler-backend-vector-shift-binop-ok?) : bool
  (and
    (be_state.backend-and8
      (compiler-backend-avx2-vector-binop-emits?
        (Shl (I32))
        (I32)
        8
        "    vpsllvd %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (Shr (I32))
        (I32)
        8
        "    vpsravd %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (Shr (U32))
        (U32)
        8
        "    vpsrlvd %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (Shl (I64))
        (I64)
        4
        "    vpsllvq %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (Shr (U64))
        (U64)
        4
        "    vpsrlvq %ymm7, %ymm6, %ymm8\n")
      (compiler-backend-avx2-vector-binop-emits?
        (Shr (I64))
        (I64)
        4
        "    vpxor %ymm1, %ymm1, %ymm1\n    vpcmpgtq %ymm6, %ymm1, %ymm0\n    vpcmpeqd %ymm1, %ymm1, %ymm1\n    vpsllq $63, %ymm1, %ymm1\n    vpsrlq $57, %ymm1, %ymm1\n    vpsubq %ymm7, %ymm1, %ymm1\n    vpsllvq %ymm1, %ymm0, %ymm0\n    vpsrlvq %ymm7, %ymm6, %ymm8\n    vpor %ymm0, %ymm8, %ymm8\n")
      (and
        (compiler-backend-avx2-word-vector-shift-shape?
          (Shl (I16))
          (I16)
          "vpmovsxwd"
          "vpsllvd")
        (compiler-backend-avx2-word-vector-shift-shape?
          (Shr (U16))
          (U16)
          "vpmovzxwd"
          "vpsrlvd"))
      (and
        (compiler-backend-byte-vector-shift-shape?
          false
          (Shl (I8))
          (I8)
          32
          "vpmovsxbd"
          "vpsllvd"
          224)
        (compiler-backend-byte-vector-shift-shape?
          false
          (Shr (U8))
          (U8)
          32
          "vpmovzxbd"
          "vpsrlvd"
          224)))
    (be_state.backend-and8
      (compiler-backend-avx512-vector-binop-emits?
        (Shl (U32))
        (U32)
        16
        "    vpsllvd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (Shr (I32))
        (I32)
        16
        "    vpsravd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (Shr (U32))
        (U32)
        16
        "    vpsrlvd %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (Shl (U64))
        (U64)
        8
        "    vpsllvq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (Shr (I64))
        (I64)
        8
        "    vpsravq %zmm7, %zmm6, %zmm8\n")
      (compiler-backend-avx512-vector-binop-emits?
        (Shr (U64))
        (U64)
        8
        "    vpsrlvq %zmm7, %zmm6, %zmm8\n")
      (and
        (compiler-backend-avx512-vector-binop-emits?
          (Shl (U16))
          (U16)
          32
          "    vpsllvw %zmm7, %zmm6, %zmm8\n")
        (compiler-backend-avx512-vector-binop-emits?
          (Shr (I16))
          (I16)
          32
          "    vpsravw %zmm7, %zmm6, %zmm8\n")
        (compiler-backend-avx512-vector-binop-emits?
          (Shr (U16))
          (U16)
          32
          "    vpsrlvw %zmm7, %zmm6, %zmm8\n"))
      (and
        (compiler-backend-byte-vector-shift-shape?
          true
          (Shl (U8))
          (U8)
          64
          "vpmovzxbd"
          "vpsllvd"
          448)
        (compiler-backend-byte-vector-shift-shape?
          true
          (Shr (I8))
          (I8)
          64
          "vpmovsxbd"
          "vpsravd"
          448)))))

(define (compiler-backend-avx2-unsigned-compare-alias-ok?) : bool
  ;; Preserve the RHS before writing the destination: the allocator may assign
  ;; both to the same vector register.
  (and
    (string.eq
      (be_simd.compiler-backend-avx2-emit-unsigned-int-compare-asm
        (Ge)
        "%ymm14"
        "%ymm7"
        "%ymm7"
        (U32))
      "    vpcmpeqd %ymm0, %ymm0, %ymm0\n    vpslld $31, %ymm0, %ymm0\n    vpxor %ymm0, %ymm7, %ymm1\n    vpxor %ymm0, %ymm14, %ymm7\n    vpcmpgtd %ymm7, %ymm1, %ymm7\n    vpcmpeqd %ymm0, %ymm0, %ymm0\n    vpxor %ymm0, %ymm7, %ymm7\n")
    (string.eq
      (be_simd.compiler-backend-avx2-emit-unsigned-int-compare-asm
        (Ge)
        "%ymm14"
        "%ymm7"
        "%ymm7"
        (U8))
      "    vpcmpeqd %ymm0, %ymm0, %ymm0\n    vpsrlw $15, %ymm0, %ymm0\n    vpsllw $7, %ymm0, %ymm0\n    vpackuswb %ymm0, %ymm0, %ymm0\n    vpxor %ymm0, %ymm7, %ymm1\n    vpxor %ymm0, %ymm14, %ymm7\n    vpcmpgtb %ymm7, %ymm1, %ymm7\n    vpcmpeqd %ymm0, %ymm0, %ymm0\n    vpxor %ymm0, %ymm7, %ymm7\n")))

(define (compiler-backend-avx2-data-pointer-cse-source) : String
  "(define (fill [a : (__tl_dyn-array i64)] [out : (__tl_dyn-array i64)] [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (+ (array-ref a i) (array-ref a i)))))")

(define (compiler-backend-avx2-loop-body [body : (& body str)]) : String
  (let
    [start : i64
      (backend.compiler-backend-string-find-from body "foreach_avx2_body" 0)]
    (if (< start 0)
      ""
      (let
        [tail : i64
          (backend.compiler-backend-string-find-from body "foreach_tail" start)]
        (if (< tail 0)
          (string.substring body start (- (string.string-length body) start))
          (string.substring body start (- tail start)))))))

;; The optimizer drops functions a `main` cannot reach, so this mainless
;; kernel emits as library code (#7071).
(define (compiler-backend-avx2-data-pointer-cse-ok?) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-avx2-data-pointer-cse-source)
    (lower.CompilerLowerMode.Avx2))
    [(Ok program spans lower-owner)
      (let
        [ok : bool
          (match (opt.optimize-program-with-spans-and-level
            (& program)
            spans
            (opt.compiler-optimize-default-level))
            [(Program optimized optimized-spans)
              (match (backend.compiler-backend-emit-program-target-with-mode
                optimized
                (be_state.CompilerBackendTarget.Linux)
                (Avx2)
                optimized-spans
                false)
                [(Ok asm)
                  (let
                    [body : String
                      (compiler-backend-asm-function-body asm "_tl_fill")]
                    [loop : String (compiler-backend-avx2-loop-body body)]
                    (and
                      (be_state.backend-and8
                        (=
                          (backend.compiler-backend-string-count
                            loop
                            "    movq 0(")
                          0)
                        (=
                          (backend.compiler-backend-string-count
                            loop
                            "    movq (%")
                          0)
                        (=
                          (backend.compiler-backend-string-count
                            loop
                            "    vmovdqu (")
                          1)
                        (=
                          (backend.compiler-backend-string-count
                            loop
                            "    vpaddq (")
                          0)
                        (=
                          (backend.compiler-backend-string-count
                            loop
                            "    vmovdqu %ymm6")
                          1)
                        (asm-has? body "foreach_avx2_body")
                        (asm-has? body "foreach_tail")
                        (=
                          (backend.compiler-backend-string-count
                            loop
                            "    vpaddq %ymm6, %ymm6, %ymm6")
                          1))
                      (asm-lacks?
                        loop
                        "vector/mask IR emission is not implemented")))]
                [(Err _) false])])]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        ok)]
    [(Err _) false]))

(define (compiler-backend-test-mask-reg [number : i64]) : i64
  (cabi.compiler-abi-mask-register-id number))

(define (compiler-backend-test-mask-entry-moves-empty [capacity : i64]) : backend.CompilerBackendSpmdMaskEntryMoveSeq
  (backend.compiler-backend-spmd-mask-entry-move-seq-with-capacity capacity))

(define (compiler-backend-test-mask-entry-move-push!
  [moves : (&mut moves backend.CompilerBackendSpmdMaskEntryMoveSeq)]
  [source : i64]
  [destination : i64]) : unit
  (backend.compiler-backend-spmd-mask-entry-move-seq-push!
    moves
    (SpmdMaskEntryMove source destination)))

(define (compiler-backend-test-mask-entry-moves-eq?
  [moves : backend.CompilerBackendSpmdMaskEntryMoveSeq]
  [expected : String]) : bool
  (match (backend.compiler-backend-emit-spmd-mask-entry-moves moves)
    [(Ok asm) (string.eq asm expected)]
    [(Err _) false]))

(define (compiler-backend-test-mask-entry-moves-error?
  [moves : backend.CompilerBackendSpmdMaskEntryMoveSeq]) : bool
  (match (backend.compiler-backend-emit-spmd-mask-entry-moves moves)
    [(Ok _) false]
    [(Err _) true]))

(define (compiler-backend-spmd-mask-entry-chain-ok? [reverse? : bool]) : bool
  (let
    [moves : backend.CompilerBackendSpmdMaskEntryMoveSeq
      (compiler-backend-test-mask-entry-moves-empty 2)]
    [k1 : i64 (compiler-backend-test-mask-reg 1)]
    [k2 : i64 (compiler-backend-test-mask-reg 2)]
    [k4 : i64 (compiler-backend-test-mask-reg 4)]
    (if reverse?
      (begin
        (compiler-backend-test-mask-entry-move-push! (&mut moves) k2 k4)
        (compiler-backend-test-mask-entry-move-push! (&mut moves) k1 k2))
      (begin
        (compiler-backend-test-mask-entry-move-push! (&mut moves) k1 k2)
        (compiler-backend-test-mask-entry-move-push! (&mut moves) k2 k4)))
    (compiler-backend-test-mask-entry-moves-eq?
      moves
      "    kmovq %k2, %k4\n    kmovq %k1, %k2\n")))

(define (compiler-backend-spmd-mask-entry-identity-subset-ok?) : bool
  (let
    [moves : backend.CompilerBackendSpmdMaskEntryMoveSeq
      (compiler-backend-test-mask-entry-moves-empty 2)]
    [k2 : i64 (compiler-backend-test-mask-reg 2)]
    [k4 : i64 (compiler-backend-test-mask-reg 4)]
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k2 k2)
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k2 k4)
    (compiler-backend-test-mask-entry-moves-eq? moves "    kmovq %k2, %k4\n")))

(define (compiler-backend-spmd-mask-entry-two-cycle-ok?) : bool
  (let
    [moves : backend.CompilerBackendSpmdMaskEntryMoveSeq
      (compiler-backend-test-mask-entry-moves-empty 2)]
    [k1 : i64 (compiler-backend-test-mask-reg 1)]
    [k2 : i64 (compiler-backend-test-mask-reg 2)]
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k1 k2)
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k2 k1)
    (compiler-backend-test-mask-entry-moves-eq?
      moves
      "    kmovq %k1, %k7\n    kmovq %k2, %k1\n    kmovq %k7, %k2\n")))

(define (compiler-backend-spmd-mask-entry-three-cycle-ok?) : bool
  (let
    [moves : backend.CompilerBackendSpmdMaskEntryMoveSeq
      (compiler-backend-test-mask-entry-moves-empty 3)]
    [k1 : i64 (compiler-backend-test-mask-reg 1)]
    [k2 : i64 (compiler-backend-test-mask-reg 2)]
    [k3 : i64 (compiler-backend-test-mask-reg 3)]
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k1 k2)
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k2 k3)
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k3 k1)
    (compiler-backend-test-mask-entry-moves-eq?
      moves
      "    kmovq %k1, %k7\n    kmovq %k3, %k1\n    kmovq %k2, %k3\n    kmovq %k7, %k2\n")))

(define (compiler-backend-spmd-mask-entry-six-cycle-ok?) : bool
  (let
    [moves : backend.CompilerBackendSpmdMaskEntryMoveSeq
      (compiler-backend-test-mask-entry-moves-empty 6)]
    [k1 : i64 (compiler-backend-test-mask-reg 1)]
    [k2 : i64 (compiler-backend-test-mask-reg 2)]
    [k3 : i64 (compiler-backend-test-mask-reg 3)]
    [k4 : i64 (compiler-backend-test-mask-reg 4)]
    [k5 : i64 (compiler-backend-test-mask-reg 5)]
    [k6 : i64 (compiler-backend-test-mask-reg 6)]
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k1 k2)
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k2 k3)
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k3 k4)
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k4 k5)
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k5 k6)
    (compiler-backend-test-mask-entry-move-push! (&mut moves) k6 k1)
    (compiler-backend-test-mask-entry-moves-eq?
      moves
      "    kmovq %k1, %k7\n    kmovq %k6, %k1\n    kmovq %k5, %k6\n    kmovq %k4, %k5\n    kmovq %k3, %k4\n    kmovq %k2, %k3\n    kmovq %k7, %k2\n")))

(define (compiler-backend-spmd-mask-entry-validation-ok?) : bool
  (let
    [duplicate : backend.CompilerBackendSpmdMaskEntryMoveSeq
      (compiler-backend-test-mask-entry-moves-empty 2)]
    [reserved : backend.CompilerBackendSpmdMaskEntryMoveSeq
      (compiler-backend-test-mask-entry-moves-empty 1)]
    [k1 : i64 (compiler-backend-test-mask-reg 1)]
    [k2 : i64 (compiler-backend-test-mask-reg 2)]
    [k3 : i64 (compiler-backend-test-mask-reg 3)]
    [k7 : i64 (compiler-backend-test-mask-reg 7)]
    (compiler-backend-test-mask-entry-move-push! (&mut duplicate) k1 k2)
    (compiler-backend-test-mask-entry-move-push! (&mut duplicate) k3 k2)
    (compiler-backend-test-mask-entry-move-push! (&mut reserved) k1 k7)
    (and
      (compiler-backend-test-mask-entry-moves-error? duplicate)
      (compiler-backend-test-mask-entry-moves-error? reserved))))

(define (compiler-backend-spmd-mask-entry-spill-first-ok?) : bool
  (let
    [plan : backend.CompilerBackendSpmdMaskEntryPlan
      (backend.compiler-backend-spmd-mask-entry-plan-empty)]
    [k1 : i64 (compiler-backend-test-mask-reg 1)]
    [k2 : i64 (compiler-backend-test-mask-reg 2)]
    (match (backend.compiler-backend-spmd-mask-entry-plan-add-spill!
      (&mut plan)
      k2
      (be_calls.compiler-backend-parallel-spill-resource -8)
      "-8(%rbp)")
      [(Ok _)
        (match (backend.compiler-backend-spmd-mask-entry-plan-add-register!
          (&mut plan)
          k1
          k2)
          [(Ok _)
            (match (backend.compiler-backend-emit-spmd-mask-entry-plan plan)
              [(Ok asm)
                (string.eq asm "    kmovq %k2, -8(%rbp)\n    kmovq %k1, %k2\n")]
              [(Err _) false])]
          [(Err _) false])]
      [(Err _) false])))

(define (compiler-backend-spmd-mask-entry-parallel-ok?) : bool
  (and
    (compiler-backend-spmd-mask-entry-chain-ok? false)
    (compiler-backend-spmd-mask-entry-chain-ok? true)
    (compiler-backend-spmd-mask-entry-identity-subset-ok?)
    (compiler-backend-spmd-mask-entry-two-cycle-ok?)
    (compiler-backend-spmd-mask-entry-three-cycle-ok?)
    (compiler-backend-spmd-mask-entry-six-cycle-ok?)
    (compiler-backend-spmd-mask-entry-validation-ok?)
    (compiler-backend-spmd-mask-entry-spill-first-ok?)))

;; The expected immediates are ISA fixtures, independent of the production
;; predicate selector. Both ABIs exercise the instruction spine with explicit
;; register and spill homes; integer predicates retain their original bytes.
(define (compiler-backend-vector-compare-predicate-case?
  [type-index : i64]
  [op-index : i64]
  [avx512 : bool]
  [spill : bool]
  [target : be_state.CompilerBackendTarget]) : bool
  (let
    [types : (Array String 10)
      (array "f32" "f64" "i8" "u8" "i16" "u16" "i32" "u32" "i64" "u64")]
    [ops : (Array String 6) (array "eq" "ne" "lt" "le" "gt" "ge")]
    [predicates : (Array i64 6) (array 0 4 1 2 6 5)]
    [bits : i64
      (cond
        [(= type-index 0) 32]
        [(= type-index 1) 64]
        [(< type-index 4) 8]
        [(< type-index 6) 16]
        [(< type-index 8) 32]
        [else 64])]
    [floating : bool (< type-index 2)]
    [lanes : i64
      (/
        (if avx512
          512
          256)
        bits)]
    [predicate : i64
      (+
        (array-ref predicates op-index)
        (if (and floating (>= op-index 4))
          8
          0))]
    [mnemonic : String
      (if floating
        (if (= bits 32)
          "vcmpps"
          "vcmppd")
        (str_cat.str-cat
          "vpcmp"
          (if (= (% type-index 2) 1)
            "u"
            "")
          (match bits
            [8 "b"]
            [16 "w"]
            [32 "d"]
            [_ "q"])))]
    [width : String
      (if avx512
        "zmm"
        "ymm")]
    [lhs : String
      (str_cat.str-cat
        "%"
        width
        (if spill
          "14"
          "6"))]
    [rhs : String
      (if (and avx512 spill)
        "-128(%rbp)"
        (str_cat.str-cat
          "%"
          width
          (if spill
            "15"
            "7")))]
    [dst : String
      (if avx512
        (if spill
          "%k7"
          "%k1")
        (if spill
          "%ymm14"
          "%ymm8"))]
    [state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_mode : unit
      (be_state.compiler-backend-set-current-mode!
        (be_state.compiler-backend-state-function-state state)
        (if avx512
          (Avx512)
          (Avx2)))]
    [instrs : ir.CompilerIrInstrSeq
      (irt.instrs
        (str_cat.str-cat
          "%2 = vector_compare_"
          (string.copy (array-ref ops op-index))
          " %0, %1 lanes "
          (string.int->string lanes)
          " : "
          (string.copy (array-ref types type-index))))]
    [homes : regalloc.CompilerRegAssignmentTable
      (reg-homes
        (if spill
          "%0=spill:-64 %1=spill:-128 %2=spill:-192"
          (if avx512
            "%0=%vec6 %1=%vec7 %2=%k1"
            "%0=%vec6 %1=%vec7 %2=%vec8")))]
    (match (compiler-backend-emit-test-instrs-target-with-backend-state
      instrs
      homes
      3
      target
      state)
      [(Ok asm)
        (let
          [expected : String
            (str_cat.str-cat
              "    "
              mnemonic
              " $"
              (string.int->string predicate)
              ", "
              rhs
              ", "
              lhs
              ", "
              dst
              "\n")]
          (and
            (asm-has? asm expected)
            (if spill
              (asm-has? asm "-64(%rbp)" "-128(%rbp)" "-192(%rbp)")
              (string.eq asm expected))))]
      [(Err _) false])))

(define (compiler-backend-vector-compare-invalid? [avx512 : bool]) : bool
  (let
    [state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_mode : unit
      (be_state.compiler-backend-set-current-mode!
        (be_state.compiler-backend-state-function-state state)
        (if avx512
          (Avx512)
          (Avx2)))]
    (match (compiler-backend-emit-test-instrs-target-with-backend-state
      (irt.instrs
        (if avx512
          "%2 = vector_compare_add %0, %1 lanes 8 : f64"
          "%2 = vector_compare_add %0, %1 lanes 4 : f64"))
      (reg-homes
        (if avx512
          "%0=%vec6 %1=%vec7 %2=%k1"
          "%0=%vec6 %1=%vec7 %2=%vec8"))
      3
      (be_state.CompilerBackendTarget.Linux)
      state)
      [(Err diag)
        (string.eq
          (cdiag.compiler-diagnostic-message (__tl-box-place diag))
          (if avx512
            "backend: unsupported AVX-512 vector compare"
            "backend: unsupported AVX2 vector compare"))]
      [(Ok _) false])))

(define (compiler-backend-vector-compare-predicates-ok?) : bool
  (let
    [host : i64 0]
    [ok : bool true]
    (while (< host 2)
      (let
        [mode : i64 0]
        (while (< mode 2)
          (let
            [type-index : i64 0]
            (while (<
              type-index
              (if (= mode 0)
                2
                10))
              (let
                [op : i64 0]
                (while (< op 6)
                  (let
                    [spill : i64 0]
                    (while (< spill 2)
                      (unless
                        (compiler-backend-vector-compare-predicate-case?
                          type-index
                          op
                          (= mode 1)
                          (= spill 1)
                          (if (= host 0)
                            (be_state.CompilerBackendTarget.Linux)
                            (be_state.CompilerBackendTarget.Windows)))
                        (set! ok false))
                      (set! spill (+ spill 1))))
                  (set! op (+ op 1))))
              (set! type-index (+ type-index 1))))
          (set! mode (+ mode 1))))
      (set! host (+ host 1)))
    (and
      ok
      (compiler-backend-vector-compare-invalid? false)
      (compiler-backend-vector-compare-invalid? true))))

(define (compiler-backend-simd-vector-ok?) : bool
  (and
    (compiler-backend-vector-compare-predicates-ok?)
    (compiler-backend-avx2-vector-map-ok?)
    (compiler-backend-avx512-vector-map-ok?)
    (compiler-backend-lane-id-rodata-ok?)
    (compiler-backend-avx2-uniform-vector-map-ok?)
    (compiler-backend-avx512-uniform-vector-map-ok?)
    (compiler-backend-avx512-masked-if-ok?)
    (compiler-backend-avx2-vector-reduce-ok?)
    (compiler-backend-avx512-vector-reduce-ok?)
    (compiler-backend-avx512-bool-vector-reduce-ok?)
    (compiler-backend-vector-shuffle-ok?)
    (compiler-backend-vector-reduce-direct-store-ok?)
    (compiler-backend-xmm-family-conversion-ok?)
    (compiler-backend-avx2-vector-homes-ok?)
    (compiler-backend-avx512-mask-homes-ok?)
    (compiler-backend-avx512-mask-load-temp-ok?)
    (compiler-backend-avx512-mask-store-temp-ok?)
    (compiler-backend-avx2-tail-mask-ok?)
    (compiler-backend-avx512-tail-mask-ok?)
    (compiler-backend-avx512-mask-not-shortens-ok?)
    (compiler-backend-avx512-mask-binop-same-registers-ok?)
    (compiler-backend-avx512-mask-reduce-ok?)
    (compiler-backend-avx512-mask-spill-ok?)
    (compiler-backend-spmd-mask-entry-parallel-ok?)
    (compiler-backend-simd-copy-paths-ok?)
    (compiler-backend-vector-load-binop-folding-ok?)
    (compiler-backend-avx2-data-pointer-cse-ok?)
    (compiler-backend-avx2-native-mask-emission-ok?)
    (compiler-backend-simd-indexed-address-ok?)
    (compiler-backend-simd-indexed-address-users-ok?)
    (compiler-backend-stack-splat-broadcast-ok?)
    (compiler-backend-vector-spill-reload-ok?)
    (compiler-backend-vector-spill-pressure-ok?)
    (compiler-backend-vector-bitwise-binop-ok?)
    (compiler-backend-vector-shift-binop-ok?)
    (compiler-backend-word-vector-shift-spill-ok? false)
    (compiler-backend-word-vector-shift-spill-ok? true)
    (compiler-backend-byte-vector-shift-spill-ok? false)
    (compiler-backend-byte-vector-shift-spill-ok? true)
    (compiler-backend-avx2-unsigned-compare-alias-ok?)
    (compiler-backend-private-param-homes-and-provenance-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-private-param-homes-and-provenance-ok?
      (be_state.CompilerBackendTarget.Windows))
    (compiler-backend-debug-caller-provenance-targets-ok?)
    (compiler-backend-vector-call-lifetime-spill-ok?)
    (compiler-backend-colored-vector-extent-ok?)
    (compiler-backend-simd-scratch-requests-ok?)
    (compiler-backend-simd-scratch-census-ok?)
    (compiler-backend-simd-scratch-checks-ok?)))

(define (compiler-backend-optimizer-rewrite-diagnostic-ok?) : bool
  (let
    [phi : ir.CompilerIrInstr
      (Phi
        0
        (ir.compiler-ir-phi-input-seq-prepend
          (F64 (compiler-backend-test-f64-bits "1.0"))
          (ir.compiler-ir-label "entry")
          (& (ir.compiler-ir-phi-input-seq-empty)))
        (I64))]
    [program : ir.CompilerIrProgram
      (Program
        (ir.compiler-ir-global-seq-empty)
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              (ci.intern "main")
              (ir.compiler-ir-param-seq-empty)
              (I64)
              4
              (ir.compiler-ir-blocks
                (irt.block "entry:
                   jump join")
                (ir.CompilerIrBlock.Block
                  (ir.compiler-ir-label "join")
                  (compiler-backend-test-instr-seq-prepend
                    (ir.compiler-ir-global-shared-view phi)
                    (irt.instrs "return %0"))))
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))
        (ir.compiler-ir-extern-seq-empty)
        (ir.CompilerIrReturnStorageAuthority.None))]
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (ir.compiler-source-spans-insert
          (ir.compiler-source-spans-empty)
          (ir.compiler-ir-symbol-typed-id (ci.intern "main"))
          (compiler-backend-test-span 10 2))
        (ir.compiler-ir-symbol-typed-id (ci.intern "main"))
        (& phi)
        (compiler-backend-test-span 55 13))]
    [previous-debug : bool (ir.compiler-debug-info-enabled?)]
    [ok : bool
      (begin
        ;; Non-abort instruction spans are intentionally a debug-only cost.
        (ir.compiler-debug-info-set-enabled! true)
        (match (opt.optimize-program-with-spans-and-level
          (& program)
          spans
          (opt.compiler-optimize-default-level))
          [(Program optimized optimized-spans)
            (match (backend.compiler-backend-emit-program-target-with-mode
              optimized
              (be_state.CompilerBackendTarget.Linux)
              (Scalar)
              optimized-spans
              true)
              [(Err diag)
                (and
                  (string.eq
                    (cdiag.compiler-diagnostic-message (__tl-box-place diag))
                    "backend: f64 values are not supported yet")
                  (= (cdiag.compiler-diagnostic-line (__tl-box-place diag)) 55)
                  (= (cdiag.compiler-diagnostic-col (__tl-box-place diag)) 13))]
              [(Ok _) false])]))]
    (ir.compiler-debug-info-set-enabled! previous-debug)
    ok))

(define (compiler-backend-test-runtime-plan-for-instr
  [_instr : (& _instr ir.CompilerIrInstr)]
  [_vars : i64]) : be_state.CompilerBackendRuntimePlan
  (let
    [base : be_state.CompilerBackendRuntimePlan
      (Plan
        false
        false
        false
        false
        false
        false
        false
        (be_state.CompilerBackendRuntimeTailPlan false false false false))]
    base))

(define (compiler-backend-instr-contains?
  [instr : ir.CompilerIrInstr]
  [needle : String]) : bool
  (let
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    [saved : EmitterScratch (emitter-scratch-save backend-state)]
    [prev-current-site : i64 (state-emit-current-site backend-state)]
    [prev-addr-forward-enabled : bool
      (state-addr-of-forwarding-enabled backend-state)]
    [prev-addr-forward-src : (__tl_dyn-array i64)
      (state-addr-of-forwarding-src backend-state)]
    [prev-fuse-ready : bool (state-fuse-need-ready backend-state)]
    [prev-fuse-use-counts : (__tl_dyn-array i64)
      (state-fuse-use-counts backend-state)]
    [prev-fuse-free-counts : (__tl_dyn-array i64)
      (state-fuse-free-counts backend-state)]
    [prev-loop-active : bool (state-emit-instrs-loop-active backend-state)]
    [prev-continue-pending : bool
      (state-emit-instrs-continue-pending backend-state)]
    [prev-identity-tail : bool
      (state-identity-tail-forwarder-active backend-state)]
    [vars : i64 8]
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    [test-id : i64 (ci.intern "test")]
    [_ctx : unit
      (begin
        (regalloc.compiler-reg-fill-i64-array (&mut starts) -1)
        (regalloc.compiler-reg-fill-i64-array (&mut ends) -1)
        (compiler-backend-set-scavenge-ctx!
          (be_state.compiler-backend-state-function-state backend-state)
          starts
          ends
          (regalloc.compiler-reg-assignment-table-empty)
          vars)
        (set-state-emit-instr-post-base! backend-state 1)
        (set-state-emit-current-count! backend-state 1)
        (backend.compiler-backend-addr-of-forwarding-disable! backend-state)
        (backend.compiler-backend-fuse-need-disable! backend-state)
        (set-state-emit-instrs-loop-active! backend-state false)
        (set-state-emit-instrs-continue-pending! backend-state false)
        (set-state-identity-tail-forwarder-active! backend-state false))]
    (match (backend.compiler-backend-emit-instr
      (be_state.CompilerBackendEmissionContext
        (ast.ast-node-pool-reader-type-segment-bases)
        (be_state.compiler-backend-target-policy-new
          be_state.CompilerBackendTarget.Linux)
        "_tl_test"
        test-id
        (ir.compiler-ir-block-list-empty)
        (ir.compiler-ir-label "entry")
        (regalloc.compiler-reg-assignment-table-empty)
        vars
        (regalloc.compiler-reg-var-types-empty)
        (Empty)
        (I64)
        (compiler-backend-test-runtime-plan-for-instr instr vars)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty)
        program-index
        (ir.compiler-source-spans-empty)
        (be_state.compiler-backend-source-span-index-build-with-backend-state
          backend-state
          (ir.compiler-source-spans-empty))
        (cdiag.compiler-diagnostic-at-start "" "")
        (__tl_make-array i64 0)
        backend-state
        (be_state.compiler-backend-state-function-state backend-state))
      (No)
      instr)
      [(Ok asm)
        (let
          [hit : bool (asm-has? asm needle)]
          [_restore : unit
            (begin
              (emitter-scratch-restore! backend-state saved)
              (set-state-emit-current-site! backend-state prev-current-site)
              (set-state-addr-of-forwarding-enabled!
                backend-state
                prev-addr-forward-enabled)
              (set-state-addr-of-forwarding-src!
                backend-state
                prev-addr-forward-src)
              (set-state-fuse-need-ready! backend-state prev-fuse-ready)
              (set-state-fuse-use-counts! backend-state prev-fuse-use-counts)
              (set-state-fuse-free-counts! backend-state prev-fuse-free-counts)
              (set-state-emit-instrs-loop-active!
                backend-state
                prev-loop-active)
              (set-state-emit-instrs-continue-pending!
                backend-state
                prev-continue-pending)
              (set-state-identity-tail-forwarder-active!
                backend-state
                prev-identity-tail))]
          hit)]
      [(Err _)
        (let
          [_restore : unit
            (begin
              (emitter-scratch-restore! backend-state saved)
              (set-state-emit-current-site! backend-state prev-current-site)
              (set-state-addr-of-forwarding-enabled!
                backend-state
                prev-addr-forward-enabled)
              (set-state-addr-of-forwarding-src!
                backend-state
                prev-addr-forward-src)
              (set-state-fuse-need-ready! backend-state prev-fuse-ready)
              (set-state-fuse-use-counts! backend-state prev-fuse-use-counts)
              (set-state-fuse-free-counts! backend-state prev-fuse-free-counts)
              (set-state-emit-instrs-loop-active!
                backend-state
                prev-loop-active)
              (set-state-emit-instrs-continue-pending!
                backend-state
                prev-continue-pending)
              (set-state-identity-tail-forwarder-active!
                backend-state
                prev-identity-tail))]
          false)])))

(define (compiler-backend-emit-test-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [assignments : regalloc.CompilerRegAssignmentTable]
  [vars : i64]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-test-instrs-target
    instrs
    assignments
    vars
    (be_state.CompilerBackendTarget.Linux)))

(define (compiler-backend-emit-test-instrs-target
  [instrs : ir.CompilerIrInstrSeq]
  [assignments : regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [target : be_state.CompilerBackendTarget]) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (compiler-backend-emit-test-instrs-target-with-backend-state
      instrs
      assignments
      vars
      target
      backend-state)))

(define (compiler-backend-emit-test-instrs-target-with-backend-state
  [instrs : ir.CompilerIrInstrSeq]
  [assignments : regalloc.CompilerRegAssignmentTable]
  [vars : i64]
  [target : be_state.CompilerBackendTarget]
  [backend-state : be_state.CompilerBackendState]) : be_state.ResultCompilerBackend
  (let
    [program-index : be_state.CompilerBackendProgramIndex
      (be_facts.compiler-backend-program-index-build-with-backend-state-and-profile-state
        backend-state
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty)
        (profile_state.compiler-profile-state-new))]
    [_abi : unit
      (be_state.compiler-backend-set-current-fn-abi!
        backend-state
        (be_state.compiler-backend-target-abi target))]
    [prev-starts : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-starts
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-ends : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-ends
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-assignment-index : regalloc.CompilerRegAssignmentTable
      (scratch-scavenge-ctx-assignments
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-plan-mask : i64
      (scratch-scavenge-ctx-plan-reg-mask
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-occupied-masks : (__tl_dyn-array i64)
      (scratch-scavenge-ctx-occupied-masks
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-vars : i64
      (scratch-scavenge-ctx-vars
        (be_state.compiler-backend-state-function-state backend-state))]
    [_scavenge-abi : unit
      (backend.compiler-backend-set-scavenge-ctx-ready!
        (be_state.compiler-backend-state-function-state backend-state)
        (owned_view.compiler-owned-shared-view prev-starts)
        (owned_view.compiler-owned-shared-view prev-ends)
        prev-assignment-index
        prev-plan-mask
        (owned_view.compiler-owned-shared-view prev-occupied-masks)
        prev-vars)]
    [prev-post-base : i64 (state-emit-instr-post-base backend-state)]
    [prev-current-count : i64 (state-emit-current-count backend-state)]
    [prev-current-site : i64 (state-emit-current-site backend-state)]
    [prev-addr-forward-enabled : bool
      (state-addr-of-forwarding-enabled backend-state)]
    [prev-addr-forward-src : (__tl_dyn-array i64)
      (state-addr-of-forwarding-src backend-state)]
    [prev-fuse-ready : bool (state-fuse-need-ready backend-state)]
    [prev-fuse-use-counts : (__tl_dyn-array i64)
      (state-fuse-use-counts backend-state)]
    [prev-fuse-free-counts : (__tl_dyn-array i64)
      (state-fuse-free-counts backend-state)]
    [prev-loop-active : bool (state-emit-instrs-loop-active backend-state)]
    [prev-continue-pending : bool
      (state-emit-instrs-continue-pending backend-state)]
    [prev-identity-tail : bool
      (state-identity-tail-forwarder-active backend-state)]
    [prev-emergency-pending : bool
      (scratch-emergency-pending
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-reg : i64
      (scratch-emergency-reg
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-used : bool
      (scratch-emergency-used
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-pending-count : i64
      (scratch-emergency-pending-count
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-used-count : i64
      (scratch-emergency-used-count
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-slot-offset : i64
      (scratch-emergency-slot-offset
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-cycle-temp-used-count : i64
      (scratch-cycle-temp-used-count
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-cycle-temp-base-offset : i64
      (scratch-cycle-temp-base-offset
        (be_state.compiler-backend-state-function-state backend-state))]
    [prev-emergency-restore-suppressed : bool
      (scratch-emergency-restore-suppressed
        (be_state.compiler-backend-state-function-state backend-state))]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (owned_view.compiler-owned-shared-view instrs)))]
    [instr-count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [runtime-plan : be_state.CompilerBackendRuntimePlan
      (compiler-backend-runtime-helper-full-plan)]
    [_scratch-position : unit
      (begin
        (backend.compiler-backend-set-scavenge-ctx-ready!
          (be_state.compiler-backend-state-function-state backend-state)
          (owned_view.compiler-owned-shared-view prev-starts)
          (owned_view.compiler-owned-shared-view prev-ends)
          prev-assignment-index
          (scratch-scavenge-ctx-plan-reg-mask
            (be_state.compiler-backend-state-function-state backend-state))
          (owned_view.compiler-owned-shared-view prev-occupied-masks)
          prev-vars)
        (set-state-emit-instr-post-base! backend-state instr-count)
        (set-state-emit-current-count! backend-state instr-count)
        (set-state-emit-current-site! backend-state 0))]
    [use-counts : (__tl_dyn-array i64)
      (backend.compiler-backend-function-use-counts
        vars
        (owned_view.compiler-owned-shared-view blocks))]
    [test-id : i64 (ci.intern "test")]
    [_addr-forward : unit
      (backend.compiler-backend-addr-of-forwarding-enable!
        backend-state
        vars
        (& (ir.compiler-ir-param-seq-empty))
        (owned_view.compiler-owned-shared-view blocks)
        (owned_view.compiler-owned-shared-view use-counts))]
    (match (compiler-backend-test-emit-instrs-text
      (be_state.CompilerBackendEmissionContext
        (ast.ast-node-pool-reader-type-segment-bases)
        (be_state.compiler-backend-target-policy-new target)
        "_tl_test"
        test-id
        blocks
        (ir.compiler-ir-label "entry")
        assignments
        vars
        (regalloc.compiler-reg-var-types-empty)
        (Empty)
        (I64)
        runtime-plan
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty)
        program-index
        (ir.compiler-source-spans-empty)
        (be_state.compiler-backend-source-span-index-build-with-backend-state
          backend-state
          (ir.compiler-source-spans-empty))
        (cdiag.compiler-diagnostic-at-start "" "")
        use-counts
        backend-state
        (be_state.compiler-backend-state-function-state backend-state))
      (No)
      instrs)
      [(Ok asm)
        (let
          [_restore : unit
            (begin
              (backend.compiler-backend-set-scavenge-ctx-ready!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-starts
                prev-ends
                prev-assignment-index
                prev-plan-mask
                prev-occupied-masks
                prev-vars)
              (set-state-emit-instr-post-base! backend-state prev-post-base)
              (set-state-emit-current-count! backend-state prev-current-count)
              (set-state-emit-current-site! backend-state prev-current-site)
              (set-state-addr-of-forwarding-enabled!
                backend-state
                prev-addr-forward-enabled)
              (set-state-addr-of-forwarding-src!
                backend-state
                prev-addr-forward-src)
              (set-state-fuse-need-ready! backend-state prev-fuse-ready)
              (set-state-fuse-use-counts! backend-state prev-fuse-use-counts)
              (set-state-fuse-free-counts! backend-state prev-fuse-free-counts)
              (set-state-emit-instrs-loop-active!
                backend-state
                prev-loop-active)
              (set-state-emit-instrs-continue-pending!
                backend-state
                prev-continue-pending)
              (set-state-identity-tail-forwarder-active!
                backend-state
                prev-identity-tail)
              (set-scratch-emergency-pending!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-pending)
              (set-scratch-emergency-reg!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-reg)
              (set-scratch-emergency-used!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-used)
              (set-scratch-emergency-pending-count!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-pending-count)
              (set-scratch-emergency-used-count!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-used-count)
              (set-scratch-emergency-slot-offset!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-slot-offset)
              (set-scratch-cycle-temp-used-count!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-cycle-temp-used-count)
              (set-scratch-cycle-temp-base-offset!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-cycle-temp-base-offset)
              (set-scratch-emergency-restore-suppressed!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-restore-suppressed))]
          (Ok asm))]
      [(Err message)
        (let
          [_restore : unit
            (begin
              (backend.compiler-backend-set-scavenge-ctx-ready!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-starts
                prev-ends
                prev-assignment-index
                prev-plan-mask
                prev-occupied-masks
                prev-vars)
              (set-state-emit-instr-post-base! backend-state prev-post-base)
              (set-state-emit-current-count! backend-state prev-current-count)
              (set-state-emit-current-site! backend-state prev-current-site)
              (set-state-addr-of-forwarding-enabled!
                backend-state
                prev-addr-forward-enabled)
              (set-state-addr-of-forwarding-src!
                backend-state
                prev-addr-forward-src)
              (set-state-fuse-need-ready! backend-state prev-fuse-ready)
              (set-state-fuse-use-counts! backend-state prev-fuse-use-counts)
              (set-state-fuse-free-counts! backend-state prev-fuse-free-counts)
              (set-state-emit-instrs-loop-active!
                backend-state
                prev-loop-active)
              (set-state-emit-instrs-continue-pending!
                backend-state
                prev-continue-pending)
              (set-state-identity-tail-forwarder-active!
                backend-state
                prev-identity-tail)
              (set-scratch-emergency-pending!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-pending)
              (set-scratch-emergency-reg!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-reg)
              (set-scratch-emergency-used!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-used)
              (set-scratch-emergency-pending-count!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-pending-count)
              (set-scratch-emergency-used-count!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-used-count)
              (set-scratch-emergency-slot-offset!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-slot-offset)
              (set-scratch-cycle-temp-used-count!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-cycle-temp-used-count)
              (set-scratch-cycle-temp-base-offset!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-cycle-temp-base-offset)
              (set-scratch-emergency-restore-suppressed!
                (be_state.compiler-backend-state-function-state backend-state)
                prev-emergency-restore-suppressed))]
          (Err message))])))

(define (compiler-backend-runtime-helper-full-plan) : be_state.CompilerBackendRuntimePlan
  (Plan
    true
    true
    true
    true
    true
    true
    true
    (be_state.CompilerBackendRuntimeTailPlan true true false true)))

;; Test fixtures start from readable spellings, then exercise only the backend's
;; ID-native runtime inventory. Production never performs this conversion.
(define (compiler-backend-test-runtime-name-id [name : String]) : i64
  (ci.intern name))

(define (compiler-backend-test-runtime-helper-owner [name : String]) : be_state.CompilerBackendRuntimeHelperOwner
  (cond
    [(string.eq name "tl_memcpy") (Core)]
    [(string.eq name "tl_memcpy_fresh") (Core)]
    [(string.eq name "tl_memchr") (Core)]
    [(string.eq name "tl_tlci_call_image_entry") (Core)]
    [(string.eq name "tl_tlci_call_macro_entry") (Core)]
    [(string.eq name "__chkstk") (Core)]
    [(string.eq name "tl_setup_argv") (Core)]
    [(string.eq name "_tl_start") (Core)]
    [else
      (be_facts.compiler-backend-runtime-helper-owner-id
        (compiler-backend-test-runtime-name-id name))]))

(define (compiler-backend-test-runtime-helper-known? [name : String]) : bool
  (match (compiler-backend-test-runtime-helper-owner name)
    [(Unknown) false]
    [_ true]))

(define (compiler-backend-test-plan-provides?
  [plan : be_state.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (if (string.eq name "tl_tlci_call_macro_entry")
    (be_state.compiler-backend-runtime-tail-tlci-macro-entry?
      (be_state.compiler-backend-runtime-plan-tail plan))
    (be_operand.compiler-backend-plan-provides-id?
      plan
      (compiler-backend-test-runtime-name-id name))))

(define (compiler-backend-runtime-helper-inventory-symbol-ok?
  [plan : be_state.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-test-runtime-helper-known?
      (owned_view.compiler-owned-shared-view name))
    (compiler-backend-test-plan-provides? plan name)))

(define (compiler-backend-runtime-helper-owner-core-ok? [name : String]) : bool
  (match (compiler-backend-test-runtime-helper-owner name)
    [(Core) true]
    [_ false]))

(define (compiler-backend-runtime-helper-inventory-core-symbol-ok?
  [plan : be_state.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-symbol-ok?
      plan
      (owned_view.compiler-owned-shared-view name))
    (compiler-backend-runtime-helper-owner-core-ok? name)))

(define (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
  [plan : be_state.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-symbol-ok?
      plan
      (owned_view.compiler-owned-shared-view name))
    (match (compiler-backend-test-runtime-helper-owner name)
      [(StdlibFfi) true]
      [_ false])))

(define (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
  [plan : be_state.CompilerBackendRuntimePlan]
  [name : String]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-symbol-ok?
      plan
      (owned_view.compiler-owned-shared-view name))
    (match (compiler-backend-test-runtime-helper-owner name)
      [(StdlibTypeLisp) true]
      [_ false])))

(define (compiler-backend-runtime-helper-inventory-core-ok?
  [plan : be_state.CompilerBackendRuntimePlan]) : bool
  (and
    (be_state.backend-and8
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_alloc")
      (not (compiler-backend-test-runtime-helper-known? "tl_oob_abort"))
      (not (compiler-backend-test-runtime-helper-known? "tl_div_abort"))
      (not (compiler-backend-test-runtime-helper-known? "tl_shift_abort"))
      (compiler-backend-runtime-helper-inventory-retired-symbol-ok?
        plan
        ".L_tl_abort")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_region_mark")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_region_reset")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_make"))
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_arena_make_small")
    (be_state.backend-and4
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_current")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_set")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_destroy")
      (compiler-backend-runtime-helper-inventory-core-symbol-ok?
        plan
        "tl_arena_make_atomic"))
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_arena_poison_enable")
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_alloc_aligned")
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_thread_init")
    (compiler-backend-runtime-helper-inventory-core-symbol-ok?
      plan
      "tl_thread_entry_ptr")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_memcpy")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_memcpy_fresh")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_memchr")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_tlci_call_image_entry")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_tlci_call_macro_entry")
    (compiler-backend-runtime-helper-owner-core-ok? "__chkstk")
    (compiler-backend-runtime-helper-owner-core-ok? "tl_setup_argv")
    (compiler-backend-runtime-helper-owner-core-ok? "_tl_start")))

(define (compiler-backend-runtime-helper-inventory-stdlib-ffi-ok?
  [plan : be_state.CompilerBackendRuntimePlan]) : bool
  (be_state.backend-and4
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_total")
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_live")
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_peak")
    (compiler-backend-runtime-helper-inventory-stdlib-ffi-symbol-ok?
      plan
      "tl_profile_alloc_reset_peak")))

(define (compiler-backend-runtime-helper-inventory-stdlib-string-ok?
  [plan : be_state.CompilerBackendRuntimePlan]) : bool
  (and
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_substring")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat3")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat4")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_string_concat5")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_int_to_string")))

(define (compiler-backend-runtime-helper-inventory-stdlib-atomic-ok?
  [plan : be_state.CompilerBackendRuntimePlan]) : bool
  (and
    (be_state.backend-and8
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_load_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_store_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_add_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_fetch_add_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i64_cas_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i32_load_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i32_store_ptr")
      (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
        plan
        "tl_atomic_i32_add_ptr"))
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_atomic_i32_fetch_add_ptr")
    (compiler-backend-runtime-helper-inventory-stdlib-type-lisp-symbol-ok?
      plan
      "tl_atomic_i32_cas_ptr")))

(define (compiler-backend-runtime-helper-inventory-retired-string-ok?
  [plan : be_state.CompilerBackendRuntimePlan]) : bool
  (be_state.backend-and4
