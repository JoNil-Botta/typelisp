(define (compiler-backend-alloc-runtime-arena-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-source
      (compiler-backend-runtime-helper-source))
    ;; The freestanding entry stores the null arena itself, so its arena word
    ;; needs no `.tdata` initial value.
    (has
      ".section .tbss,\"awT\",@nobits\n    .balign 8\n    .globl tl_current_arena\ntl_current_arena:\n    .zero 8\n"
      "    .section .bss\n    .balign 8\n    .globl __tl_null_arena\n__tl_null_arena:\n.L_tl_null_arena:\n    .zero 64\n"
      "_tl_start:\n    movb $17, .L_tl_null_arena+48(%rip)\n"
      "    leaq .L_tl_null_arena(%rip), %rsi\n    movq %rsi, %fs:tl_current_arena@tpoff\n    ret\n"
      "tl_thread_init:\n"
      "tl_arena_make_atomic:\n"
      "    movq %fs:tl_current_arena@tpoff, %r8\n"
      ".L_tl_alloc_new_arena:\n"
      "    movq $0x4000000, %rdx\n"
      "    addq $64, %rcx\n"
      "    movq $0, 32(%rax)\n"
      "    movq %r10, 0(%rax)\n"
      "    movq %r9, 40(%rax)\n"
      "    movq $0, 48(%rax)\n"
      "    movq %rax, 56(%r9)\n"
      "    leaq 64(%rax), %r8\n"
      "    movq %rax, 40(%rax)\n"
      "    movq $1, 48(%rax)\n"
      "    leaq 64(%rax), %rcx\n"
      "    movq %r9, %fs:tl_current_arena@tpoff\n")
    (lacks
      ".section .tdata"
      "    movq %rax, %fs:tl_current_arena@tpoff\n"
      ".L_tl_alloc_size_ready:\n")))

(define (compiler-backend-alloc-runtime-shape-ok?) : bool
  (match (backend.compiler-backend-emit-source
    (compiler-backend-runtime-helper-source))
    [(Ok asm)
      (and
        (be_state.backend-and8
          (asm-has? asm "    addq $7, %rdi\n")
          (asm-has? asm "    andq $-8, %rdi\n")
          (asm-has? asm "    movq 16(%r9), %rcx\n")
          (asm-has? asm "    movq %rcx, 16(%r9)\n")
          (asm-has? asm "    movq $9, %rax\n")
          (asm-has? asm "    movq $0x22, %r10\n")
          (asm-has? asm "    jc .L_tl_alloc_abort\n")
          (asm-has? asm "    js .L_tl_alloc_abort\n"))
        (be_state.backend-and4
          (asm-has? asm "    testq $1, 48(%r8)\n")
          (asm-has? asm "    lock cmpxchgq %rcx, 16(%r8)\n")
          (asm-has? asm "    lock cmpxchgq %rcx, 48(%r9)\n")
          (asm-has? asm "    movq %rax, 56(%r9)\n"))
        (asm-has? asm ".L_tl_alloc_abort:\n" "    jmp tl_oom_abort\n"))]
    [(Err _) false]))

(define (compiler-backend-user-helper-name-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (compiler-backend-test-symbol "tl_alloc")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          0
          (ir.compiler-ir-blocks
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "entry")
              (ir.compiler-ir-instr-seq1 (Return (Some (I64 7))))))
          Ordinary))
      (&
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              cbi.compiler-builtin-id-fix-main
              (ir.compiler-ir-param-seq-empty)
              (I64)
              1
              (ir.compiler-ir-blocks
                (ir.CompilerIrBlock.Block
                  (ir.compiler-ir-label "entry")
                  (ir.compiler-ir-instr-seq2
                    (Call
                      0
                      (compiler-backend-test-symbol "tl_alloc")
                      (Nil)
                      (I64))
                    (Return (Some (Var 0))))))
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-user-helper-name-ok?) : bool
  (match (backend.compiler-backend-emit-program-linux
    (compiler-backend-user-helper-name-program))
    [(Ok asm)
      (and
        (or (asm-has? asm ".globl _tl_tl_alloc") (asm-has? asm ".globl _tl_f"))
        (or
          (asm-has? asm "    call _tl_tl_alloc")
          (asm-has? asm "    call _tl_f"))
        (asm-lacks? asm ".L_tl_alloc_msg"))]
    [(Err _) false]))

(define (compiler-backend-runtime-coexist-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (irt.func
          "function @tl_alloc() -> i64 vars 0 {
         entry:
           return 7
         }"))
      (&
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              cbi.compiler-builtin-id-fix-main
              (ir.compiler-ir-param-seq-empty)
              (I64)
              2
              (ir.compiler-ir-blocks
                (ir.CompilerIrBlock.Block
                  (ir.compiler-ir-label "entry")
                  (ir.compiler-ir-instr-seq3
                    (Call
                      0
                      (compiler-backend-test-symbol "tl_alloc")
                      (Nil)
                      (I64))
                    (Call
                      1
                      cbi.compiler-builtin-id-tl-substring
                      (ir.compiler-ir-call-args-from-seq
                        (& (ir.compiler-ir-value-seq3 (I64 0) (I64 0) (I64 0))))
                      (I64))
                    (Return (Some (Var 0))))))
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))))
    (ir.compiler-ir-extern-seq1
      (ir.compiler-ir-extern-default-id
        cbi.compiler-builtin-id-tl-substring
        "tl_substring"
        (I64)))
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-runtime-coexist-ok?) : bool
  (match (backend.compiler-backend-emit-program-linux
    (compiler-backend-runtime-coexist-program))
    [(Ok asm)
      (and
        (or (asm-has? asm ".globl _tl_tl_alloc") (asm-has? asm ".globl _tl_f"))
        (asm-lacks?
          asm
          ".globl tl_alloc\n"
          ".globl tl_substring\n"
          "tl_substring:\n")
        (or
          (asm-has? asm "    call _tl_tl_alloc")
          (asm-has? asm "    call _tl_f"))
        (asm-has? asm "    call tl_substring\n")
        (asm-lacks? asm ".extern tl_substring\n"))]
    [(Err _) false]))

(define (compiler-backend-module-symbol-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (compiler-backend-test-symbol "lib.tl::helper")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          0
          (ir.compiler-ir-blocks
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "entry")
              (ir.compiler-ir-instr-seq1 (Return (Some (I64 7))))))
          Ordinary))
      (&
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              cbi.compiler-builtin-id-fix-main
              (ir.compiler-ir-param-seq-empty)
              (I64)
              1
              (ir.compiler-ir-blocks
                (ir.CompilerIrBlock.Block
                  (ir.compiler-ir-label "entry")
                  (ir.compiler-ir-instr-seq2
                    (Call
                      0
                      (compiler-backend-test-symbol "lib.tl::helper")
                      (Nil)
                      (I64))
                    (Return (Some (Var 0))))))
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-module-symbol-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-program-linux
      (compiler-backend-module-symbol-program))
    (has ".globl _tl_lib_helper" "    call _tl_lib_helper")
    (lacks "_u2e" "_colon" "_slash")))

;; Test-only dotted-import mutation boundary.
;; Production globals stay owned by this module; split test fixtures mutate
;; them only through these typed setters.
(define (compiler-backend-test-location-register?
  [maybe : regalloc.CompilerRegMaybeLocation]
  [expected : i64]) : bool
  (match maybe
    [(Some location)
      (match location
        [(Register actual) (= actual expected)]
        [_ false])]
    [_ false]))

(define (compiler-backend-test-location-spill?
  [maybe : regalloc.CompilerRegMaybeLocation]
  [expected : i64]) : bool
  (match maybe
    [(Some location)
      (match location
        [(Spill actual) (= actual expected)]
        [_ false])]
    [_ false]))

;; Exercise every register-plan / GEP field added to the function owner in one
;; interleaved A/B lifetime.  The ordinary focused tests below this boundary
;; force the corresponding assembly shapes; this bridge additionally makes
;; cross-owner contamination and reset regressions observable field by field.
(define (compiler-backend-test-register-plan-gep-isolation-stage!
  [state-a : be_state.CompilerBackendState]
  [state-b : be_state.CompilerBackendState]) : bool
  (let
    [function-a : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state state-a)]
    [function-b : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state state-b)]
    [assignments-a : regalloc.CompilerRegAssignmentTable
      (regalloc.compiler-reg-assignments-prepend
        (&
          (regalloc.CompilerRegAssignment 0 (Register cabi.compiler-reg-id-r12)))
        (regalloc.compiler-reg-assignments-prepend
          (& (regalloc.CompilerRegAssignment 1 (Spill 24)))
          (regalloc.compiler-reg-assignment-table-empty)))]
    [assignments-b : regalloc.CompilerRegAssignmentTable
      (regalloc.compiler-reg-assignments-prepend
        (&
          (regalloc.CompilerRegAssignment 0 (Register cabi.compiler-reg-id-r13)))
        (regalloc.compiler-reg-assignments-prepend
          (& (regalloc.CompilerRegAssignment 1 (Spill 40)))
          (regalloc.compiler-reg-assignment-table-empty)))]
    [disp-a : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [kind-a : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [scale-a : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [disp-b : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [kind-b : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [scale-b : (__tl_dyn-array i64) (__tl_make-array i64 2)]
    [_configure : unit
      (begin
        (be_state.compiler-backend-function-state-set-assignment-index!
          function-a
          (regalloc.compiler-reg-assignment-table-with-min-capacity
            assignments-a
            4))
        (be_state.compiler-backend-function-state-set-assignment-index!
          function-b
          (regalloc.compiler-reg-assignment-table-with-min-capacity
            assignments-b
            4))
        (be_state.compiler-backend-function-state-set-bool!
          function-a
          be_state.compiler-backend-function-bool-emit-assignment-index-active
          true)
        (be_state.compiler-backend-function-state-set-bool!
          function-b
          be_state.compiler-backend-function-bool-emit-assignment-index-active
          true)
        (be_state.compiler-backend-function-state-set-i64!
          function-a
          be_state.compiler-backend-function-i64-rax-override-var
          0)
        (be_state.compiler-backend-function-state-set-i64!
          function-b
          be_state.compiler-backend-function-i64-rax-override-var
          -1)
        (compiler-backend-function-state-set-rax-forward-pending-var!
          state-a
          30)
        (compiler-backend-function-state-set-rax-forward-pending-var!
          state-b
          40)
        (backend.compiler-backend-divmod-overrides-install!
          function-a
          2
          cabi.compiler-reg-id-rdx
          3
          cabi.compiler-reg-id-r10)
        (backend.compiler-backend-divmod-overrides-install!
          function-b
          2
          cabi.compiler-reg-id-rbx
          3
          cabi.compiler-reg-id-r11)
        (be_state.compiler-backend-function-state-set-bool!
          function-a
          be_state.compiler-backend-function-bool-frame-slot-referenced
          true)
        (be_state.compiler-backend-function-state-set-bool!
          function-b
          be_state.compiler-backend-function-bool-frame-slot-referenced
          false)
        (be_state.compiler-backend-function-state-set-bool!
          function-a
          be_state.compiler-backend-function-bool-fpo-bare-frame
          true)
        (be_state.compiler-backend-function-state-set-bool!
          function-b
          be_state.compiler-backend-function-bool-fpo-bare-frame
          false)
        (be_state.compiler-backend-function-state-set-bool!
          function-a
          be_state.compiler-backend-function-bool-identity-tail-forwarder-active
          true)
        (be_state.compiler-backend-function-state-set-bool!
          function-b
          be_state.compiler-backend-function-bool-identity-tail-forwarder-active
          false)
        (be_state.compiler-backend-function-state-set-i64!
          function-a
          be_state.compiler-backend-function-i64-red-zone-guard
          85)
        (be_state.compiler-backend-function-state-set-i64!
          function-b
          be_state.compiler-backend-function-i64-red-zone-guard
          170)
        (be_scalar.compiler-backend-set-emit-plan-reg-mask!
          state-a
          assignments-a)
        (be_scalar.compiler-backend-set-emit-plan-reg-mask!
          state-b
          assignments-b)
        (be_calls.compiler-backend-function-state-set-current-phi-target-point!
          state-a
          11)
        (be_calls.compiler-backend-function-state-set-current-phi-target-point!
          state-b
          22)
        (be_calls.compiler-backend-function-state-set-current-phi-dst-home-mask!
          state-a
          51)
        (be_calls.compiler-backend-function-state-set-current-phi-dst-home-mask!
          state-b
          102)
        (set! (array-ref disp-a 0) 16)
        (set! (array-ref kind-a 0) 1)
        (set! (array-ref scale-a 0) 8)
        (set! (array-ref disp-b 0) 24)
        (set! (array-ref disp-b 1) 0)
        (set! (array-ref kind-b 0) 1)
        (set! (array-ref kind-b 1) 1)
        (set! (array-ref scale-b 0) 8)
        (set! (array-ref scale-b 1) 8)
        (be_state.compiler-backend-function-state-set-i64-array!
          function-a
          be_state.compiler-backend-function-i64-array-gep-fold-disp-table
          disp-a)
        (be_state.compiler-backend-function-state-set-i64-array!
          function-a
          be_state.compiler-backend-function-i64-array-gep-fold-kind-table
          kind-a)
        (be_state.compiler-backend-function-state-set-i64-array!
          function-a
          be_state.compiler-backend-function-i64-array-gep-fold-scale-table
          scale-a)
        (be_state.compiler-backend-function-state-set-i64-array!
          function-b
          be_state.compiler-backend-function-i64-array-gep-fold-disp-table
          disp-b)
        (be_state.compiler-backend-function-state-set-i64-array!
          function-b
          be_state.compiler-backend-function-i64-array-gep-fold-kind-table
          kind-b)
        (be_state.compiler-backend-function-state-set-i64-array!
          function-b
          be_state.compiler-backend-function-i64-array-gep-fold-scale-table
          scale-b)
        (be_state.compiler-backend-function-state-set-bool!
          function-a
          be_state.compiler-backend-function-bool-gep-fold-ready
          true)
        (be_state.compiler-backend-function-state-set-bool!
          function-b
          be_state.compiler-backend-function-bool-gep-fold-ready
          true))]
    ;; Small functions use the context table directly. The emission-scoped rax
    ;; override must be just as authoritative there as it is in the dense view.
    [fallback-rax-override : bool
      (begin
        (be_state.compiler-backend-function-state-set-bool!
          function-b
          be_state.compiler-backend-function-bool-emit-assignment-index-active
          false)
        (be_state.compiler-backend-function-state-set-i64!
          function-b
          be_state.compiler-backend-function-i64-rax-override-var
          0)
        (let
          [ok : bool
            (compiler-backend-test-location-register?
              (be_operand.compiler-backend-emit-assignment-lookup
                state-b
                assignments-b
                0)
              cabi.compiler-reg-id-rax)]
          (be_state.compiler-backend-function-state-set-bool!
            function-b
            be_state.compiler-backend-function-bool-emit-assignment-index-active
            true)
          (be_state.compiler-backend-function-state-set-i64!
            function-b
            be_state.compiler-backend-function-i64-rax-override-var
            -1)
          ok))]
    [a-drift-result : i64
      (let
        [offset (ir.CompilerIrValue.I64 0)]
        [elem-ty (ast.AstType.I64)]
        (backend.compiler-backend-gep-fold-next! function-a 0 offset elem-ty))]
    [b-folded-result : i64
      (let
        [offset (ir.CompilerIrValue.Var 7)]
        [elem-ty (ast.AstType.I64)]
        (backend.compiler-backend-gep-fold-next! function-b 0 offset elem-ty))]
    [b-unfolded-result : i64
      (let
        [offset (ir.CompilerIrValue.Var 8)]
        [elem-ty (ast.AstType.I64)]
        (backend.compiler-backend-gep-fold-next! function-b 0 offset elem-ty))]
    (and
      fallback-rax-override
      (compiler-backend-test-location-register?
        (be_operand.compiler-backend-emit-assignment-lookup
          state-a
          assignments-a
          0)
        cabi.compiler-reg-id-rax)
      (compiler-backend-test-location-register?
        (be_operand.compiler-backend-emit-assignment-lookup
          state-b
          assignments-b
          0)
        cabi.compiler-reg-id-r13)
      (compiler-backend-test-location-spill?
        (be_operand.compiler-backend-emit-assignment-lookup
          state-a
          assignments-a
          1)
        24)
      (compiler-backend-test-location-spill?
        (be_operand.compiler-backend-emit-assignment-lookup
          state-b
          assignments-b
          1)
        40)
      (compiler-backend-test-location-register?
        (be_operand.compiler-backend-emit-assignment-lookup
          state-a
          assignments-a
          2)
        cabi.compiler-reg-id-rdx)
      (compiler-backend-test-location-register?
        (be_operand.compiler-backend-emit-assignment-lookup
          state-b
          assignments-b
          2)
        cabi.compiler-reg-id-rbx)
      (=
        (be_simd.compiler-backend-function-state-rax-forward-pending-var
          state-a)
        30)
      (=
        (be_simd.compiler-backend-function-state-rax-forward-pending-var
          state-b)
        40)
      (be_state.compiler-backend-function-state-bool?
        function-a
        be_state.compiler-backend-function-bool-frame-slot-referenced)
      (not
        (be_state.compiler-backend-function-state-bool?
          function-b
          be_state.compiler-backend-function-bool-frame-slot-referenced))
      (be_state.compiler-backend-function-state-bool?
        function-a
        be_state.compiler-backend-function-bool-fpo-bare-frame)
      (not
        (be_state.compiler-backend-function-state-bool?
          function-b
          be_state.compiler-backend-function-bool-fpo-bare-frame))
      (be_state.compiler-backend-function-state-bool?
        function-a
        be_state.compiler-backend-function-bool-identity-tail-forwarder-active)
      (not
        (be_state.compiler-backend-function-state-bool?
          function-b
          be_state.compiler-backend-function-bool-identity-tail-forwarder-active))
      (=
        (be_state.compiler-backend-function-state-i64
          function-a
          be_state.compiler-backend-function-i64-red-zone-guard)
        85)
      (=
        (be_state.compiler-backend-function-state-i64
          function-b
          be_state.compiler-backend-function-i64-red-zone-guard)
        170)
      (be_operand.compiler-backend-plan-uses-reg?
        state-a
        assignments-a
        cabi.compiler-reg-id-r12)
      (not
        (be_operand.compiler-backend-plan-uses-reg?
          state-a
          assignments-a
          cabi.compiler-reg-id-r13))
      (be_operand.compiler-backend-plan-uses-reg?
        state-b
        assignments-b
        cabi.compiler-reg-id-r13)
      (=
        (be_calls.compiler-backend-function-state-current-phi-target-point
          state-a)
        11)
      (=
        (be_calls.compiler-backend-function-state-current-phi-target-point
          state-b)
        22)
      (=
        (be_calls.compiler-backend-function-state-current-phi-dst-home-mask
          state-a)
        51)
      (=
        (be_calls.compiler-backend-function-state-current-phi-dst-home-mask
          state-b)
        102)
      (= a-drift-result 0)
      (backend.compiler-backend-gep-fold-drift? function-a)
      (= b-folded-result 24)
      (= b-unfolded-result 0)
      (not (backend.compiler-backend-gep-fold-drift? function-b))
      (=
        (be_state.compiler-backend-function-state-i64
          function-a
          be_state.compiler-backend-function-i64-gep-fold-cursor)
        1)
      (=
        (be_state.compiler-backend-function-state-i64
          function-b
          be_state.compiler-backend-function-i64-gep-fold-cursor)
        2))))

(define (compiler-backend-test-register-plan-gep-isolation-reset-ok?
  [state-a : be_state.CompilerBackendState]
  [state-b : be_state.CompilerBackendState]) : bool
  (let
    [function-a : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state state-a)]
    [function-b : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state state-b)]
    [index-a : regalloc.CompilerRegAssignmentTable
      (be_state.compiler-backend-function-state-assignment-index function-a)]
    [index-b : regalloc.CompilerRegAssignmentTable
      (be_state.compiler-backend-function-state-assignment-index function-b)]
    (and
      (=
        (array-length (regalloc.compiler-reg-assignment-table-present index-a))
        1)
      (=
        (array-length (regalloc.compiler-reg-assignment-table-present index-b))
        4)
      (not
        (be_state.compiler-backend-function-state-bool?
          function-a
          be_state.compiler-backend-function-bool-emit-assignment-index-active))
      (be_state.compiler-backend-function-state-bool?
        function-b
        be_state.compiler-backend-function-bool-emit-assignment-index-active)
      (=
        (be_state.compiler-backend-function-state-i64
          function-a
          be_state.compiler-backend-function-i64-rax-override-var)
        -1)
      (=
        (be_state.compiler-backend-function-state-i64
          function-b
          be_state.compiler-backend-function-i64-rax-override-var)
        -1)
      (=
        (be_simd.compiler-backend-function-state-rax-forward-pending-var
          state-a)
        -1)
      (=
        (be_simd.compiler-backend-function-state-rax-forward-pending-var
          state-b)
        40)
      (=
        (be_state.compiler-backend-function-state-i64
          function-a
          be_state.compiler-backend-function-i64-home-override0-var)
        -1)
      (=
        (be_state.compiler-backend-function-state-i64
          function-b
          be_state.compiler-backend-function-i64-home-override0-var)
        2)
      (not
        (be_state.compiler-backend-function-state-bool?
          function-a
          be_state.compiler-backend-function-bool-frame-slot-referenced))
      (not
        (be_state.compiler-backend-function-state-bool?
          function-a
          be_state.compiler-backend-function-bool-fpo-bare-frame))
      (not
        (be_state.compiler-backend-function-state-bool?
          function-a
          be_state.compiler-backend-function-bool-identity-tail-forwarder-active))
      (not
        (be_state.compiler-backend-function-state-bool?
          function-b
          be_state.compiler-backend-function-bool-identity-tail-forwarder-active))
      (=
        (be_state.compiler-backend-function-state-i64
          function-a
          be_state.compiler-backend-function-i64-red-zone-guard)
        0)
      (=
        (be_state.compiler-backend-function-state-i64
          function-b
          be_state.compiler-backend-function-i64-red-zone-guard)
        170)
      (not
        (be_state.compiler-backend-function-state-bool?
          function-a
          be_state.compiler-backend-function-bool-emit-plan-reg-mask-active))
      (be_state.compiler-backend-function-state-bool?
        function-b
        be_state.compiler-backend-function-bool-emit-plan-reg-mask-active)
      (=
        (be_state.compiler-backend-function-state-i64
          function-a
          be_state.compiler-backend-function-i64-emit-plan-reg-mask)
        0)
      (=
        (be_calls.compiler-backend-function-state-current-phi-target-point
          state-a)
        -1)
      (=
        (be_calls.compiler-backend-function-state-current-phi-target-point
          state-b)
        22)
      (=
        (be_calls.compiler-backend-function-state-current-phi-dst-home-mask
          state-a)
        -1)
      (=
        (be_calls.compiler-backend-function-state-current-phi-dst-home-mask
          state-b)
        102)
      (not
        (be_state.compiler-backend-function-state-bool?
          function-a
          be_state.compiler-backend-function-bool-gep-fold-ready))
      (be_state.compiler-backend-function-state-bool?
        function-b
        be_state.compiler-backend-function-bool-gep-fold-ready)
      (=
        (array-length
          (be_state.compiler-backend-function-state-i64-array
            function-a
            be_state.compiler-backend-function-i64-array-gep-fold-disp-table))
        0)
      (=
        (array-length
          (be_state.compiler-backend-function-state-i64-array
            function-b
            be_state.compiler-backend-function-i64-array-gep-fold-disp-table))
        2)
      (=
        (be_state.compiler-backend-function-state-i64
          function-a
          be_state.compiler-backend-function-i64-gep-fold-cursor)
        0)
      (=
        (be_state.compiler-backend-function-state-i64
          function-b
          be_state.compiler-backend-function-i64-gep-fold-cursor)
        2)
      (not
        (be_state.compiler-backend-function-state-bool?
          function-a
          be_state.compiler-backend-function-bool-gep-fold-drift))
      (not
        (be_state.compiler-backend-function-state-bool?
          function-b
          be_state.compiler-backend-function-bool-gep-fold-drift)))))

(define (set-state-addr-of-forwarding-enabled!
  [backend-state : be_state.CompilerBackendState]
  [value : bool]) : unit
  (be_state.compiler-backend-function-state-set-bool!
    (be_state.compiler-backend-state-function-state backend-state)
    be_state.compiler-backend-function-bool-addr-of-forwarding-enabled
    value))

(define (set-state-addr-of-forwarding-src!
  [backend-state : be_state.CompilerBackendState]
  [value : (__tl_dyn-array i64)]) : unit
  (be_state.compiler-backend-function-state-set-i64-array!
    (be_state.compiler-backend-state-function-state backend-state)
    be_state.compiler-backend-function-i64-array-addr-of-forwarding-src
    value))

(define (set-scratch-const-hoist-frame-count!
  [function-state : be_state.CompilerBackendFunctionState]
  [value : i64]) : unit
  (be_state.compiler-backend-function-scratch-set-i64!
    function-state
    be_state.compiler-backend-scratch-i64-const-hoist-frame-count
    value))

(define (set-scratch-const-hoist-frame-rbx!
  [function-state : be_state.CompilerBackendFunctionState]
  [value : bool]) : unit
  (be_state.compiler-backend-function-scratch-set-bool!
    function-state
