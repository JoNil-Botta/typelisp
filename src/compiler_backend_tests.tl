(define (compiler-backend-runtime-memchr-functions-ok?) : bool
  (let
    [linux : String (runtime_linux.compiler-backend-runtime-memchr-functions)]
    [windows : String
      (runtime_windows.compiler-backend-runtime-memchr-functions)]
    (and
      (be_state.backend-and4
        (asm-has? linux "    .globl tl_memchr\n")
        (asm-has? linux "tl_memchr:\n")
        (asm-has? linux "    cmpb %dl, (%rdi,%rax)\n")
        (asm-has? linux "    movq $-1, %rax\n"))
      (be_state.backend-and4
        (asm-has? windows "    .globl tl_memchr\n")
        (asm-has? windows "tl_memchr:\n")
        (asm-has? windows "    cmpb %r8b, (%rcx,%rax)\n")
        (asm-has? windows "    movq $-1, %rax\n")))))

(define (compiler-backend-runtime-global-symbol-ok?
  [asm : (& asm str)]
  [name : String]) : bool
  (let
    [needle (str_cat.str-cat "    .globl " name "\n")]
    (asm-has? asm needle)))

(define (compiler-backend-runtime-common-global-symbols-ok? [asm : (& asm str)]) : bool
  (and
    (be_state.backend-and8
      (compiler-backend-runtime-global-symbol-ok? asm "tl_memcpy")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_memchr")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_array_zero")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_arena_current")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_arena_set")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_arena_poison_enable")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_arena_make")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_arena_make_atomic"))
    (compiler-backend-runtime-global-symbol-ok? asm "tl_memcpy_fresh")
    (compiler-backend-runtime-global-symbol-ok? asm "tl_arena_make_small")
    (be_state.backend-and8
      (compiler-backend-runtime-global-symbol-ok? asm "tl_arena_destroy")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_profile_alloc_total")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_profile_alloc_live")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_profile_alloc_peak")
      (compiler-backend-runtime-global-symbol-ok?
        asm
        "tl_profile_alloc_reset_peak")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_alloc")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_region_mark")
      (compiler-backend-runtime-global-symbol-ok? asm "tl_region_reset"))
    (compiler-backend-runtime-global-symbol-ok? asm "tl_alloc_aligned")
    (compiler-backend-runtime-global-symbol-ok? asm "tl_mem_fill8")
    (compiler-backend-runtime-global-symbol-ok? asm "tl_mem_copy_fwd")
    (compiler-backend-runtime-global-symbol-ok? asm "tl_mem_copy8_fwd")
    (compiler-backend-runtime-global-symbol-ok? asm "tl_tlci_call_image_entry")
    (compiler-backend-runtime-global-symbol-ok? asm "tl_tlci_call_macro_entry")
    (compiler-backend-runtime-global-symbol-ok?
      asm
      "tl_startup_profile_process_entry_tick")))

(define (compiler-backend-runtime-linux-global-symbols-ok? [asm : String]) : bool
  (and
    (= (backend.compiler-backend-string-count asm "    .globl ") 27)
    (compiler-backend-runtime-common-global-symbols-ok? asm)
    (compiler-backend-runtime-global-symbol-ok? asm "tl_thread_init")
    (compiler-backend-runtime-global-symbol-ok? asm "tl_thread_local_word_addr")
    (not (compiler-backend-runtime-global-symbol-ok? asm "__chkstk"))
    (not (compiler-backend-runtime-global-symbol-ok? asm "tl_setup_argv"))
    (not (compiler-backend-runtime-global-symbol-ok? asm "_tl_start"))))

(define (compiler-backend-runtime-windows-global-symbols-ok? [asm : String]) : bool
  (and
    (= (backend.compiler-backend-string-count asm "    .globl ") 29)
    (compiler-backend-runtime-common-global-symbols-ok? asm)
    (compiler-backend-runtime-global-symbol-ok? asm "tl_thread_entry_ptr")
    (compiler-backend-runtime-global-symbol-ok? asm "__chkstk")
    (compiler-backend-runtime-global-symbol-ok? asm "tl_setup_argv")
    (compiler-backend-runtime-global-symbol-ok? asm "_tl_start")
    (not (compiler-backend-runtime-global-symbol-ok? asm "tl_thread_init"))))

(define (compiler-backend-runtime-sensitive-instrs-ok?
  [target : be_state.CompilerBackendTarget]
  [asm : (& asm str)]) : bool
  (and
    (= (backend.compiler-backend-string-count asm "    lock ") 14)
    (if (be_facts.compiler-backend-target-windows? target)
      (and
        ;; tl_array_zero reads the current arena once for its virgin-arena
        ;; zero-fill skip; the remaining reads are the allocator/region paths.
        (= (backend.compiler-backend-string-count asm "%gs:0x28") 23)
        (=
          (backend.compiler-backend-string-count
            asm
            "%fs:tl_current_arena@tpoff")
          0))
      (and
        (=
          (backend.compiler-backend-string-count
            asm
            "%fs:tl_current_arena@tpoff")
          22)
        (= (backend.compiler-backend-string-count asm "%gs:0x28") 0)))))

(define (compiler-backend-test-runtime-functions-for-target
  [target : be_state.CompilerBackendTarget]) : String
  (let
    [plan : be_state.CompilerBackendRuntimePlan
      (compiler-backend-runtime-helper-full-plan)]
    [features : runtime_common.CompilerBackendRuntimeFeatures
      (be_data.compiler-backend-runtime-features plan)]
    (be_data.compiler-backend-runtime-functions-for-target
      target
      features
      false
      false
      true)))

(define (compiler-backend-runtime-global-inventory-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (let
    [asm : String (compiler-backend-test-runtime-functions-for-target target)]
    (and
      (compiler-backend-runtime-sensitive-instrs-ok? target asm)
      (if (be_facts.compiler-backend-target-windows? target)
        (compiler-backend-runtime-windows-global-symbols-ok? asm)
        (compiler-backend-runtime-linux-global-symbols-ok? asm)))))

(define (compiler-backend-runtime-global-inventory-ok?) : bool
  (and
    (compiler-backend-runtime-global-inventory-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-runtime-global-inventory-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-runtime-page-call-inventory-linux-ok?) : bool
  (let
    [asm : String
      (compiler-backend-test-runtime-functions-for-target
        (be_state.CompilerBackendTarget.Linux))]
    (and
      (be_state.backend-and8
        (asm-has? asm "tl_alloc:\n")
        (asm-has? asm "tl_region_mark:\n")
        (asm-has? asm "tl_region_reset:\n")
        (asm-has? asm "tl_arena_make:\n")
        (asm-has? asm "tl_arena_current:\n")
        (asm-has? asm "tl_arena_set:\n")
        (asm-has? asm "tl_arena_destroy:\n")
        (asm-has? asm "tl_arena_poison_enable:\n"))
      (asm-has? asm "tl_alloc_aligned:\n" "tl_arena_make_atomic:\n")
      (be_state.backend-and4
        (=
          (backend.compiler-backend-string-count
            asm
            "    movq $9, %rax\n    syscall\n")
          7)
        (=
          (backend.compiler-backend-string-count
            asm
            "    movq $11, %rax\n    syscall\n")
          5)
        (= (backend.compiler-backend-string-count asm "    syscall\n") 16)
        (=
          (backend.compiler-backend-string-count
            asm
            "    movq $60, %rax\n    movq $134, %rdi\n    syscall\n")
          3))
      (asm-has? asm "    movq $158, %rax\n    syscall\n")
      (asm-lacks? asm "VirtualAlloc" "VirtualFree"))))

(define (compiler-backend-runtime-page-call-inventory-windows-ok?) : bool
  (let
    [asm : String
      (compiler-backend-test-runtime-functions-for-target
        (be_state.CompilerBackendTarget.Windows))]
    (and
      (be_state.backend-and8
        (asm-has? asm "tl_alloc:\n")
        (asm-has? asm "tl_region_mark:\n")
        (asm-has? asm "tl_region_reset:\n")
        (asm-has? asm "tl_arena_make:\n")
        (asm-has? asm "tl_arena_current:\n")
        (asm-has? asm "tl_arena_set:\n")
        (asm-has? asm "tl_arena_destroy:\n")
        (asm-has? asm "tl_arena_poison_enable:\n"))
      (asm-has? asm "tl_alloc_aligned:\n" "tl_arena_make_atomic:\n")
      (be_state.backend-and4
        (and
          (=
            (backend.compiler-backend-string-count
              asm
              "    call VirtualAlloc\n")
            13)
          (=
            (backend.compiler-backend-string-count
              asm
              "    call GetLastError\n")
            13))
        (and
          (=
            (backend.compiler-backend-string-count asm "    call VirtualFree\n")
            12)
          (=
            (backend.compiler-backend-string-count
              asm
              "    call tl_windows_allocation_abort\n")
            13))
        (asm-lacks? asm "    syscall\n")
        (and
          (=
            (backend.compiler-backend-string-count asm "    call WriteFile\n")
            2)
          (asm-lacks? asm "    ud2\n")))
      (asm-has?
        asm
        ".L_tl_alloc_win_commit_to:\n"
        "    movq $0x2000, %r8\n"
        "    movq $0x1000, %r8\n"
        "    movq $0x4000, %r8\n"
        "tl_arena_poison_enable:\n    movq $1, .L_tl_arena_poison_enabled(%rip)\n"
        "    cmpq 64(%r8), %r10\n"
        "    movq %gs:0x28, %r8\n")
      (asm-lacks? asm "    call _write\n" "SystemFunction036"))))

(define (compiler-backend-runtime-windows-allocation-provenance-ok?) : bool
  (let
    [windows : String
      (compiler-backend-test-runtime-functions-for-target
        (be_state.CompilerBackendTarget.Windows))]
    [linux : String
      (compiler-backend-test-runtime-functions-for-target
        (be_state.CompilerBackendTarget.Linux))]
    (and
      (be_state.backend-and8
        (asm-has?
          windows
          ".L_tl_arena_make_win_reserve_os_fail:\n    call GetLastError\n")
        (asm-has?
          windows
          ".L_tl_arena_make_win_initial_commit_os_fail:\n    call GetLastError\n")
        (asm-has?
          windows
          ".L_tl_arena_make_atomic_win_reserve_os_fail:\n    call GetLastError\n")
        (asm-has?
          windows
          ".L_tl_arena_make_atomic_win_initial_commit_os_fail:\n    call GetLastError\n")
        (asm-has?
          windows
          ".L_tl_alloc_win_commit_os_fail:\n    call GetLastError\n")
        (asm-has?
          windows
          ".L_tl_alloc_atomic_reserve_os_fail:\n    call GetLastError\n")
        (asm-has?
          windows
          ".L_tl_alloc_atomic_initial_commit_os_fail:\n    call GetLastError\n")
        (asm-has?
          windows
          ".L_tl_alloc_reserve_os_fail:\n    call GetLastError\n"
          ".L_tl_alloc_initial_commit_os_fail:\n    call GetLastError\n"))
      (be_state.backend-and4
        (and
          (=
            (backend.compiler-backend-string-count
              windows
              "    call VirtualFree\n    movq %rsi, 40(%rsp)\n")
            1)
          (=
            (backend.compiler-backend-string-count
              windows
              "    call VirtualFree\n    movq -48(%rbp), %rax\n    movq -40(%rbp), %r8\n    movq %rax, 40(%rsp)\n")
            2)
          (asm-has?
            windows
            ".L_tl_arena_make_win_initial_commit_os_fail:\n    call GetLastError\n    movl %eax, %eax\n    movq %rax, 40(%rsp)\n    movq %rbx, %rcx\n    xorq %rdx, %rdx\n    movq $0x8000, %r8\n    call VirtualFree\n    movq $0, 32(%rsp)\n    xorq %rcx, %rcx\n    movq $1, %rdx\n    movq $0x400000, %r8\n    movq %rsi, %r9\n    call tl_windows_allocation_abort\n"))
        (asm-has?
          windows
          ".L_tl_alloc_win_commit_os_fail:\n    call GetLastError\n    movl %eax, %eax\n    movq %rax, 40(%rsp)\n")
        (asm-has?
          windows
          "    movq $2, %rdx\n    call tl_windows_allocation_abort\n")
        (and
          (asm-lacks? windows "    ud2\n")
          (asm-lacks? linux "tl_windows_allocation_abort"))))))

(define (compiler-backend-runtime-page-call-inventory-ok?) : bool
  (and
    (compiler-backend-runtime-page-call-inventory-linux-ok?)
    (compiler-backend-runtime-page-call-inventory-windows-ok?)
    (compiler-backend-runtime-windows-allocation-provenance-ok?)))

(define (compiler-backend-runtime-arena-root-current-linux-ok?) : bool
  (let
    [asm : String
      (compiler-backend-test-runtime-functions-for-target
        (be_state.CompilerBackendTarget.Linux))]
    (and
      (asm-has?
        asm
        "    movq %r10, 0(%rax)\n    movq $0, 32(%rax)\n    movq %r9, 40(%rax)\n    movq $0, 48(%rax)\n    movq %rax, 56(%r9)\n    leaq 64(%rax), %r8\n"
        "    movq 56(%r12), %rbx\n    testq %rbx, %rbx\n    jnz .L_tl_arena_destroy_head_ready\n    movq %r12, %rbx\n.L_tl_arena_destroy_head_ready:\n.L_tl_arena_destroy_retired_ready:\n    movq 32(%r12), %r12\n"
        "    movq %rbx, 16(%r8)\n    movq %r8, 56(%r12)\n")
      (asm-lacks? asm "    movq %r8, %fs:tl_current_arena@tpoff\n")
      (asm-has?
        asm
        "    movq 56(%r10), %r8\n    testq %r8, %r8\n    jnz .L_tl_region_reset_all_head_ready\n    movq %r10, %r8\n.L_tl_region_reset_all_head_ready:\n.L_tl_region_reset_all_retired_ready:\n    movq 32(%r10), %rbx\n"))))

(define (compiler-backend-runtime-arena-root-current-windows-ok?) : bool
  (let
    [asm : String
      (compiler-backend-test-runtime-functions-for-target
        (be_state.CompilerBackendTarget.Windows))]
    (and
      (asm-has?
        asm
        "    movq %r10, 0(%rax)\n    movq %r8, 40(%rax)\n    movq $0, 48(%rax)\n    movq %rax, 56(%r8)\n    movq %r8, %gs:0x28\n    movq -40(%rbp), %rdx\n    addq %rax, %rdx\n    movq %rdx, 64(%rax)\n    movq 8(%rax), %r8\n"
        "    movq 56(%r12), %rsi\n    testq %rsi, %rsi\n    jnz .L_tl_arena_destroy_win_head_ready\n    movq %r12, %rsi\n.L_tl_arena_destroy_win_head_ready:\n.L_tl_arena_destroy_win_retired_ready:\n    movq 32(%r12), %r12\n"
        "    movq %r12, 16(%r13)\n    movq %r13, 56(%r11)\n")
      (asm-lacks? asm "    movq %r13, %gs:0x28\n")
      (asm-has?
        asm
        "    movq 56(%r12), %r14\n    testq %r14, %r14\n    jnz .L_tl_region_reset_win_all_head_ready\n    movq %r12, %r14\n.L_tl_region_reset_win_all_head_ready:\n.L_tl_region_reset_win_all_retired_ready:\n    movq 32(%r12), %r12\n"))))

(define (compiler-backend-runtime-small-arena-linux-ok?) : bool
  (let
    [asm : String
      (compiler-backend-test-runtime-functions-for-target
        (be_state.CompilerBackendTarget.Linux))]
    (asm-has?
      asm
      "tl_arena_make_small:\n    movq $0x1000000, %rsi\n.L_tl_arena_make_sized:\n"
      "    movq $0, 48(%rax)\n    movq %rax, 56(%rax)\n"
      "    movq %rax, %rcx\n    addq %rsi, %rcx\n    movq %rcx, 24(%rax)\n")))

(define (compiler-backend-runtime-small-arena-windows-ok?) : bool
  (let
    [asm : String
      (compiler-backend-test-runtime-functions-for-target
        (be_state.CompilerBackendTarget.Windows))]
    (asm-has?
      asm
      "tl_arena_make_small:\n    push %rbp\n    mov %rsp, %rbp\n    push %rbx\n    push %rsi\n    sub $48, %rsp\n    movq $0x1000000, %rsi\n"
      "    movq %rsi, 40(%rsp)\n    xorq %rcx, %rcx\n    movq %rsi, %rdx\n"
      "    movq %rbx, %rcx\n    addq 40(%rsp), %rcx\n    movq %rcx, 24(%rbx)\n")))

(define (compiler-backend-runtime-small-arena-ok?) : bool
  (and
    (compiler-backend-runtime-small-arena-linux-ok?)
    (compiler-backend-runtime-small-arena-windows-ok?)))

(define (compiler-backend-runtime-arena-root-current-ok?) : bool
  (and
    (compiler-backend-runtime-arena-root-current-linux-ok?)
    (compiler-backend-runtime-arena-root-current-windows-ok?)
    (compiler-backend-runtime-small-arena-ok?)))

(define (compiler-backend-memory-op-ok?) : bool
  (and
    (compiler-backend-instr-contains?
      (AddrOf 2 1 0)
      "    leaq -16(%rbp), %r8\n")
    (compiler-backend-instr-contains?
      (irt.instr "%3 = gep %1, 2 : i32")
      "    addq $8, %r10\n")
    (compiler-backend-instr-contains?
      (irt.instr "%3 = gep %1, %2 : i32")
      "    leaq (%r10,%r8,4), %r10\n")
    (compiler-backend-instr-contains?
      (Load 4 (Var 1) (U8))
      "    movzbl (%r10), %r8d\n")
    (compiler-backend-instr-contains?
      (irt.instr "store_ptr %1, 7 : i32")
      "    movl $7, (%r10)\n")
    (compiler-backend-instr-contains?
      (irt.instr "%6 = cast %5 : i8 to i64")
      "    movsbq -48(%rbp), %r8\n")
    (compiler-backend-instr-contains?
      (irt.instr "bounds_check %1, %2 message \"bounds_ok\"")
      "    jb .L_tl_test_bounds_ok\n")))

(define (compiler-backend-scalar-load-scratch-ok?) : bool
  (and
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%4 = load %1 : u64")
        (reg-homes "%4=%r12")
        5)
      (has "    movq (%r10), %r12\n")
      (lacks "%rax"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%4 = load %1 : u64")
        (regalloc.compiler-reg-assignment-table-empty)
        5)
      (has "    movq (%r10), %r8\n" "    movq %r8, -40(%rbp)\n")
      (lacks "%rax"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%2 = gep %0, 1 : u64
           %3 = load %2 : u64")
        (regalloc.compiler-reg-assignment-table-empty)
        4)
      (has "    movq 8(%r10), %r8\n" "    movq %r8, -32(%rbp)\n")
      (lacks "    movq 8(%r10), %rax\n"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%3 = gep %0, %2 : u64
           %4 = load %3 : u64")
        (regalloc.compiler-reg-assignment-table-empty)
        5)
      (has "    movq (%r10,%r8,8), %r9\n" "    movq %r9, -40(%rbp)\n")
      (lacks "    movq (%r10,%r8,8), %rax\n"))))

(define (compiler-backend-float-load-scratch-ok?) : bool
  (and
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%4 = load %1 : f64")
        (reg-homes "%4=%xmm3")
        5)
      (has "    movsd (%r10), %xmm3\n")
      (lacks "%xmm0"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%4 = load %1 : f64")
        (regalloc.compiler-reg-assignment-table-empty)
        5)
      (has "    movsd (%r10), %xmm2\n" "    movsd %xmm2, -40(%rbp)\n")
      (lacks "%xmm0"))))

(define (compiler-backend-gep-float-load-scratch-ok?) : bool
  (and
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%2 = gep %0, 1 : u64
           %3 = load %2 : f64")
        (reg-homes "%3=%xmm3")
        4)
      (has "    movsd 8(%r10), %xmm3\n")
      (lacks "%xmm0"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%2 = gep %0, 1 : u64
           %3 = load %2 : f64")
        (regalloc.compiler-reg-assignment-table-empty)
        4)
      (has "    movsd 8(%r10), %xmm2\n" "    movsd %xmm2, -32(%rbp)\n")
      (lacks "%xmm0"))
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%3 = gep %0, %2 : u64
           %4 = load %3 : f64")
        (reg-homes "%4=%xmm3")
        5)
      (has "    movsd (%r10,%r8,8), %xmm3\n")
      (lacks "%xmm0"))))

(define (compiler-backend-addr-of-forwarding-shape-ok?) : bool
  (asm-ok?
    (compiler-backend-emit-test-instrs
      (irt.instrs "%2 = addr_of %1
         store_ptr %2, 7 : i64")
      (reg-homes "%2=%r12")
      4)
    (has "    leaq -16(%rbp), %r10\n" "    movq $7, (%r10)\n")
    (lacks "%r12" "    movq %rax, -24(%rbp)\n" "    movq -24(%rbp), %r10\n")))

(define (compiler-backend-addr-of-forwarding-typed-load-shape-ok?) : bool
  (and
    ;; The forwarded AddrOf has one use, but its typed-copy destination has two.
    ;; The defining AddrOf is suppressed, so the Mov must materialize the local
    ;; address instead of reading the uninitialized allocator home for var 2.
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs
          "%2 = addr_of %1
           %3 = mov %2 : (MutPtr i32)
           store_ptr %3, 7 : i32
           %4 = load %3 : i32")
        (regalloc.compiler-reg-assignment-table-empty)
        5)
      (has "    leaq -16(%rbp), %r8\n" "    movq %r8, -32(%rbp)\n")
      (lacks "    movq -24(%rbp), %r8\n"))
    ;; The implicit typed return loader must honor the same forwarding map.
    (asm-ok?
      (compiler-backend-emit-test-instrs
        (irt.instrs "%2 = addr_of %1
           return %2")
        (regalloc.compiler-reg-assignment-table-empty)
        3)
      (has "    leaq -16(%rbp), %rax\n")
      (lacks "    movq -24(%rbp), %rax\n"))))

(test
  backend-forwarded-address-redefined-slot
  (for [abi (iterator.range 0 2)]
    (test.assert-true
      (asm-ok?
        (compiler-backend-emit-test-instrs-target
          (irt.instrs
            "%2 = addr_of %1
             %2 = gep %0, 0 : u8
             %3 = mov 0 : i64
             return %2")
          (regalloc.compiler-reg-assignment-table-empty)
          4
          (if (= abi 0)
            (Linux)
            (Windows)))
        (has "    movq -24(%rbp), %rax\n")
        (lacks "    leaq -16(%rbp), %rax\n"))
      "a reused slot has no function-wide address recipe")))

(test
  backend-forwarded-address-adjacent-definition
  (for [abi (iterator.range 0 2)]
    (test.assert-true
      (asm-ok?
        (compiler-backend-emit-test-instrs-target
          (irt.instrs
            "%2 = gep %0, 0 : u8
             %2 = addr_of %1
             return %2")
          (regalloc.compiler-reg-assignment-table-empty)
          4
          (if (= abi 0)
            (Linux)
            (Windows)))
        (has "    leaq -16(%rbp), %rax\n")
        (lacks "    movq -24(%rbp), %rax\n"))
      "the adjacent address definition reaches the only read despite an earlier definition")))

(test
  backend-forwarded-address-parameter-redefined
  (let
    [program-index
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [state program-index.backend-state]
    [params
      (ir.compiler-ir-param-seq-prepend
        (ir.CompilerIrParam.Param "p" (ast.AstType.I64) 2)
        (ir.compiler-ir-param-seq-empty))]
    [blocks
      (irt.blocks
        "entry:
           %3 = load %2 : i64
           %2 = addr_of %1")]
    [_forward : unit
      (backend.compiler-backend-addr-of-forwarding-enable!
        state
        4
        (& params)
        blocks
        (backend.compiler-backend-function-use-counts
          4
          (irt.blocks
            "entry:
               %3 = load %2 : i64
               %2 = addr_of %1")))]
    (test.assert-true
      (< (be_operand.compiler-backend-forwarded-addr-of-src state 2) 0)
      "a parameter use cannot become a later address definition")))

(test
  backend-forwarded-address-coalesced-copies
  (for [abi (iterator.range 0 2)]
    (let
      [target : be_state.CompilerBackendTarget
        (if (= abi 0)
          (Linux)
          (Windows))]
      (test.assert-true
        (asm-ok?
          (compiler-backend-emit-test-instrs-target
            (irt.instrs
              "%2 = addr_of %1
                         %3 = mov %2 : (MutPtr i64)
                         %4 = load %3 : i64
                         store_ptr %3, 7 : i64")
            (reg-homes "%2=%r12 %3=%r12")
            5
            target)
          (has "leaq -16(%rbp), %r12"))
        "a coalesced Mov materializes its forwarded address")
      (test.assert-true
        (asm-ok?
          (compiler-backend-emit-test-instrs-target
            (irt.instrs
              "%2 = addr_of %1
                         %3 = cast %2 : (MutPtr i64) to (MutPtr i64)
                         %4 = load %3 : i64
                         store_ptr %3, 7 : i64")
            (reg-homes "%2=%r12 %3=%r12")
            5
            target)
          (has "leaq -16(%rbp), %r12"))
        "a same-type cast materializes its forwarded address")
      (test.assert-true
        (asm-ok?
          (compiler-backend-emit-test-instrs-target
            (irt.instrs "%3 = mov %2 : i64")
            (reg-homes "%2=%r12 %3=%r12")
            4
            target)
          (lacks "mov" "lea"))
        "an initialized same-home copy remains empty"))))

(define (compiler-backend-test-forwarded-address-phi-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       %2 = addr_of %1
       jump join
     join:
       %3 = phi [%2, entry] : (MutPtr i64)
       %4 = phi [%5, entry] : (MutPtr i64)"))

(define (compiler-backend-test-clone-phi-copy-seq
  [copies : (& be_state.CompilerBackendPhiCopySeq)]) : be_state.CompilerBackendPhiCopySeq
  (let
    [slots : (__tl_dyn-array be_state.CompilerBackendPhiCopy)
      (__tl_make-array be_state.CompilerBackendPhiCopy copies.len)]
    (for [index (iterator.range 0 copies.len)]
      (set!
        (array-ref slots index)
        (match (& (array-ref copies.slots index))
          [(Copy dst source ty)
            (be_state.CompilerBackendPhiCopy.Copy
              dst
              (match source
                [(Value val)
                  (be_state.CompilerBackendPhiSource.Value
                    (ir.compiler-ir-clone-value val))]
                [(Temp slot) (be_state.CompilerBackendPhiSource.Temp slot)])
              (ast.clone-ast-type ty))])))
    (be_state.CompilerBackendPhiCopySeq slots copies.len)))

(test
  backend-forwarded-address-phi-resources
  (let
    [program-index
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [state program-index.backend-state]
    [blocks (compiler-backend-test-forwarded-address-phi-blocks)]
    [assignments (reg-homes "%2=%rax %3=%rbx %4=%rax %5=%rbx")]
    [_forward : unit
      (backend.compiler-backend-addr-of-forwarding-enable!
        state
        6
        (& (ir.compiler-ir-param-seq-empty))
        (compiler-backend-test-forwarded-address-phi-blocks)
        (backend.compiler-backend-function-use-counts
          6
          (compiler-backend-test-forwarded-address-phi-blocks)))]
    [copies
      (match (be_calls.compiler-backend-leading-phi-copies-seq
        state
        assignments
        (irt.instrs
          "%3 = phi [%2, entry] : (MutPtr i64)
                     %4 = phi [%5, entry] : (MutPtr i64)")
        (ir.compiler-ir-label "entry"))
        [(Ok copies) copies]
        [(Err _) (be_state.compiler-backend-phi-copy-seq-with-capacity 0)])]
    (test.assert-true
      (match (be_calls.compiler-backend-phi-copy-list-decision
        state
        assignments
        (compiler-backend-test-clone-phi-copy-seq (& copies)))
        [(CompilerParallelMoveUnblocked dst) (= dst 4)]
        [_ false])
      "materialization has no source register, so this is not a swap cycle")
    (test.assert-true
      (match (be_calls.compiler-backend-phi-source-replace-home
        state
        assignments
        (Value (Var 2))
        4
        cabi.compiler-reg-id-r10)
        [(Value (Var id)) (= id 2)]
        [_ false])
      "saving the nominal home must not replace an address with its contents")
    (test.assert-i64-eq
      (be_calls.compiler-backend-phi-copy-list-drop-same-home
        state
        (reg-homes "%2=%rax %3=%rax %4=%rcx %5=%rbx")
        (compiler-backend-test-clone-phi-copy-seq (& copies))).len
      2
      "same-home filtering retains the address materialization")
    (test.assert-true
      (asm-ok?
        (be_calls.compiler-backend-emit-phi-edge-copies
          (ast.ast-node-pool-reader-type-segment-bases)
          assignments
          blocks
          (ir.compiler-ir-label "join")
          (ir.compiler-ir-label "entry")
          program-index
          6)
        (has "movq %rbx, %rax" "leaq -16(%rbp), %rbx")
        (lacks "push" "pop"))
      "emit the real dependency before materializing the address")
    (backend.compiler-backend-addr-of-forwarding-disable! state)
    (test.assert-true
      (match (be_calls.compiler-backend-phi-copy-list-decision
        state
        assignments
        copies)
        [(CompilerParallelMoveCycle _) true]
        [_ false])
      "initialized homes still form an ordinary swap cycle")))

;; This is final optimizer IR: both branch loads produce 1 and the two phis
;; add them. The separate source-level stale-load issue does not affect its
;; expected value of 2.
(define (compiler-backend-forwarded-address-join-program) : ir.CompilerIrProgram
  (irt.program
    "function @join(flag=%0:bool) -> i64 vars 15 {
     entry:
       %2 = mov 1 : i64
       %3 = addr_of %2
       %4 = mov %3 : (MutPtr i64)
       branch %0, then, else
     then:
       %5 = load %4 : i64
       %6 = mov %5 : i64
       %2 = mov 3 : i64
       jump merge
     else:
       %8 = load %4 : i64
       %9 = mov %8 : i64
       %2 = mov 3 : i64
       jump merge
     merge:
       %10 = phi [%5, then], [%8, else] : i64
       %11 = phi [%6, then], [%9, else] : i64
       %14 = add %11, %10 : i64
       return %14
     }
     function @loop() -> i64 vars 9 {
     entry:
       %0 = mov 41 : i64
       %1 = mov 1 : i64
       %2 = addr_of %1
       jump header
     header:
       %3 = phi [%2, entry], [%4, body] : (MutPtr i64)
       %6 = phi [0, entry], [%7, body] : i64
       %8 = load %3 : i64
       %5 = lt %6, 1 : i64
       branch %5, body, exit
     body:
       %4 = addr_of %0
       %7 = add %6, 1 : i64
       jump header
     exit:
       return %8
     }
     function @main() -> i64 vars 6 {
     entry:
       %0 = call join(false) : i64
       %1 = call join(true) : i64
       %2 = eq %0, 2 : i64
       branch %2, check, fail
     check:
       %3 = eq %1, 2 : i64
       branch %3, loop_check, fail
     loop_check:
       %4 = call loop() : i64
       %5 = eq %4, 41 : i64
       branch %5, pass, fail
     pass:
       return 2
     fail:
       return 1
     }"))

(test
  backend-forwarded-address-join-storage
  (for [abi (iterator.range 0 2)]
    (let
      [state
        (be_state.compiler-backend-state-new
          (ci.intern-compat-state-capture-active))]
      [program (compiler-backend-forwarded-address-join-program)]
      [spans (ir.compiler-source-spans-empty)]
      [target : be_state.CompilerBackendTarget
        (if (= abi 0)
          (Linux)
          (Windows))]
      (be_state.compiler-backend-state-set-scalar-registers-enabled! state true)
      (test.assert-true
        (match (compiler-backend-test-emit-program-with-state
          state
          target
          (& program)
          (& spans)
          false)
          [(Ok asm)
            (let
              [join (compiler-backend-asm-function-body asm "_tl_join")]
              [loop (compiler-backend-asm-function-body asm "_tl_loop")]
              (and
                (asm-has? join "movq $1," "movq $3,")
                ;; One address formation and the final integer addition.
                (= (backend.compiler-backend-string-count join "    leaq ") 2)
                (asm-has? loop "movq $41," "movq $1,")
                ;; The entry and backedge each materialize their own address.
                (= (backend.compiler-backend-string-count loop "    leaq ") 2)))]
          [(Err _) false])
        "each function retains its backing storage and address setup"))))

(define (compiler-backend-addr-of-register-home-shape-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable (reg-homes "%2=%r12")]
    (match (backend.compiler-backend-emit-addr-of
      assignments
      2
      1
      1
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(Ok asm) (string.eq asm "    leaq -16(%rbp), %r12\n")]
      [(Err _) false])))

(define (compiler-backend-addr-of-spill-scratch-shape-ok?) : bool
  (asm-ok?
    (compiler-backend-emit-test-instrs
      (irt.instrs "%2 = addr_of %1")
      (regalloc.compiler-reg-assignment-table-empty)
      4)
    (has "    leaq -16(%rbp), %r8\n" "    movq %r8, -24(%rbp)\n")
    (lacks "%rax")))

(define (compiler-backend-gep-copy-bytes-const-shape-ok?) : bool
  (match (compiler-backend-emit-test-instrs
    (irt.instrs "%2 = gep %0, 1 : u64
       copy_bytes %2, %1, 24")
    (regalloc.compiler-reg-assignment-table-empty)
    5)
    [(Ok asm)
      (and
        (asm-has? asm "    movq -8(%rbp), %r10\n")
        ;; GAP2a folds the const gep displacement (+8) directly into every
        ;; CopyBytes chunk DST address, so explicit address staging disappears.
        (asm-has? asm "    movups %xmm2, 8(%r10)\n")
        (asm-has? asm "    movq -16(%rbp), %r9\n")
        (asm-has? asm "    movups (%r9), %xmm2\n")
        (asm-has? asm "    movq 16(%r9), %r8\n")
        (asm-lacks? asm "%xmm15")
        (asm-lacks? asm "    movq %rax, -24(%rbp)\n")
        (asm-lacks? asm "    movq -24(%rbp), %r10\n"))]
    [(Err _) false]))

(define (compiler-backend-gep-copy-bytes-index-shape-ok?) : bool
  (asm-ok?
    (compiler-backend-emit-test-instrs
      (irt.instrs "%3 = gep %0, %2 : u64
         copy_bytes %3, %1, 16")
      (regalloc.compiler-reg-assignment-table-empty)
      6)
    (has
      "    movq -8(%rbp), %r10\n"
      "    movq -24(%rbp), %r8\n"
      "    leaq (%r10,%r8,8), %r10\n"
      "    movq -16(%rbp), %r9\n"
      "    movups (%r9), %xmm2\n")
    (lacks "%xmm15" "    movq %rax, -32(%rbp)\n" "    movq -32(%rbp), %r10\n")))

(define (compiler-backend-win64-gep-offset-rax-home-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%rsi %1=%rax %2=%rax")]
    [ok : bool
      (match (compiler-backend-emit-test-instrs-target
        (irt.instrs "%2 = gep %0, %1 : u64")
        assignments
        3
        (be_state.CompilerBackendTarget.Windows))
        [(Ok asm)
          ;; The merged emitter fuses base + index*8 into a single scale-index
          ;; leaq that writes the result home directly (`leaq (%rsi,%rax,8),
          ;; %rax`) instead of staging base/index through scratch registers. The
          ;; Win64 safety invariant is unchanged: the base (%rsi) is never moved
          ;; into the shared index/result home %rax before the leaq consumes the
          ;; index, so no clobbering `movq %rsi, %rax` is emitted.
          (and
            (asm-has? asm "    leaq (%rsi,%rax,8), %rax\n")
            (asm-lacks? asm "    movq %rsi, %rax\n"))]
        [(Err _) false])]
    ok))

(define (compiler-backend-gep-load-r10-reuse-shape-ok?) : bool
  (match (compiler-backend-emit-test-instrs
    (irt.instrs
      "%2 = gep %0, 0 : u64
       %3 = load %2 : u64
       %4 = gep %0, 1 : u64
       %5 = load %4 : u64")
    (regalloc.compiler-reg-assignment-table-empty)
    7)
    [(Ok asm)
      (and
        (=
          (backend.compiler-backend-string-count
            asm
            "    movq -8(%rbp), %r10\n")
          1)
        (asm-has?
          asm
          "    movq (%r10), %r8\n"
          "    movq %r8, -32(%rbp)\n"
          "    movq 8(%r10), %r8\n"
          "    movq %r8, -48(%rbp)\n")
        (asm-lacks?
          asm
          "    movq (%r10), %rax\n"
          "    movq 8(%r10), %rax\n"
          "    movq -40(%rbp), %r10\n"))]
    [(Err _) false]))

(define (compiler-backend-gep-float-load-r10-reuse-shape-ok?) : bool
