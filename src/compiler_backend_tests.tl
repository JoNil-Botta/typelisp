        (CompilerRegAssignment.Assignment
          6
          (CompilerRegLocation.Register "%rbx"))
        CompilerRegAssignmentList.Nil)]
    (and
      (match (compiler-backend-emit-cast
        "_tl_test"
        "entry"
        reg-src
        6
        (CompilerIrValue.Var 5)
        (AstType.I8)
        (AstType.I64)
        index
        ""
        ""
        "")
        [(ResultCompilerBackend.Ok asm)
          (string.eq asm "    movsbq %r12b, %rbx\n")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-cast
        "_tl_test"
        "entry"
        stack-src
        6
        (CompilerIrValue.Var 5)
        (AstType.U8)
        (AstType.U64)
        index
        ""
        ""
        "")
        [(ResultCompilerBackend.Ok asm)
          (string.eq asm "    movzbq -48(%rbp), %rbx\n")]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-global-store-direct-home-shape-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        CompilerRegAssignmentList.Nil)]
    (and
      (match (compiler-backend-emit-test-instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g")
            (CompilerIrValue.Var 0)
            (AstType.I32))
          CompilerIrInstrList.Nil)
        assignments
        2)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    movl %r12d, _tl_g(%rip)\n")
            (not
              (compiler-backend-string-contains? asm "    movq %r12, %rax\n"))
            (not
              (compiler-backend-string-contains?
                asm
                "    movq %rax, _tl_g(%rip)\n")))]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-test-instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g")
            (CompilerIrValue.Var 0)
            (AstType.I64))
          CompilerIrInstrList.Nil)
        CompilerRegAssignmentList.Nil
        2)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains? asm "    movq -8(%rbp), %r8\n")
            (compiler-backend-string-contains?
              asm
              "    movq %r8, _tl_g(%rip)\n")
            (not (compiler-backend-string-contains? asm "%rax")))]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-test-instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.Store
            (ci.intern "g")
            (CompilerIrValue.Var 0)
            (AstType.F64))
          CompilerIrInstrList.Nil)
        CompilerRegAssignmentList.Nil
        2)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    movsd -8(%rbp), %xmm2\n")
            (compiler-backend-string-contains?
              asm
              "    movsd %xmm2, _tl_g(%rip)\n")
            (not (compiler-backend-string-contains? asm "%xmm0")))]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-pack-direct-home-shape-ok?) : bool
  (let
    [ty : AstType (compiler-backend-register-group-test-type)]
    [index : CompilerBackendProgramIndex
      (compiler-backend-register-group-test-index)]
    [words : CompilerIrValueList
      (compiler-ir-value-cons
        (CompilerIrValue.Var 0)
        (compiler-ir-value-cons (CompilerIrValue.Var 1) CompilerIrValueList.Nil))]
    [direct-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%rbx"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.RegisterPair "%r14" "%r15"))
            CompilerRegAssignmentList.Nil)))]
    [noop-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r14"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%r15"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.RegisterPair "%r14" "%r15"))
            CompilerRegAssignmentList.Nil)))]
    [diag : CompilerDiagnostic (compiler-diagnostic-at-start "" "")]
    (and
      (match (compiler-backend-emit-pack
        direct-assignments
        2
        words
        ty
        4
        index
        ""
        ""
        diag)
        [(ResultCompilerBackend.Ok asm)
          (string.eq asm "    movq %r12, %r14\n    movq %rbx, %r15\n")]
        [(ResultCompilerBackend.Err _) false])
      (match (compiler-backend-emit-pack
        noop-assignments
        2
        words
        ty
        4
        index
        ""
        ""
        diag)
        [(ResultCompilerBackend.Ok asm) (string.eq asm "")]
        [(ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-scratch-staging-direct-home-shape-ok?) : bool
  (and
    (compiler-backend-copy-bytes-direct-home-shape-ok?)
    (compiler-backend-copy-bytes-live-through-shape-ok?)
    (compiler-backend-copy-bytes-run-protect-shape-ok?)
    (backend-and4
      (compiler-backend-widening-cast-direct-home-shape-ok?)
      (compiler-backend-global-store-direct-home-shape-ok?)
      (compiler-backend-pack-direct-home-shape-ok?)
      true)))

(define (compiler-backend-address-mode-fusion-ok?) : bool
  (and
    (backend-and8
      (compiler-backend-addr-of-forwarding-shape-ok?)
      (compiler-backend-addr-of-register-home-shape-ok?)
      (compiler-backend-addr-of-spill-scratch-shape-ok?)
      (compiler-backend-gep-copy-bytes-const-shape-ok?)
      (compiler-backend-gep-copy-bytes-index-shape-ok?)
      (compiler-backend-gep-load-r10-reuse-shape-ok?)
      (compiler-backend-gep-float-load-r10-reuse-shape-ok?)
      (compiler-backend-load-load-pointer-chase-shape-ok?))
    (backend-and4
      (compiler-backend-load-load-float-pointer-chase-shape-ok?)
      (compiler-backend-store-ptr-pair-shape-ok?)
      (compiler-backend-store-value-scratch-shape-ok?)
      (compiler-backend-store-home-base-shape-ok?))
    (backend-and4
      (compiler-backend-gep-load-compare-priority-shape-ok?)
      (compiler-backend-gep-load-store-order-shape-ok?)
      (compiler-backend-gep-load-register-homes-shape-ok?)
      (compiler-backend-gep-load-live-through-home-preserved-ok?))
    (backend-and4
      (compiler-backend-gep-load-multi-emergency-preserved-ok?)
      (compiler-backend-gep-store-index-home-preserved-ok?)
      (compiler-backend-store-address-source-home-preserved-ok?)
      (compiler-backend-win64-gep-offset-rax-home-ok?))
    (backend-and4
      (compiler-backend-gep-load-alu-fold-shape-ok?)
      (compiler-backend-gep-load-alu-fold-rejects-narrow-ok?)
      (compiler-backend-mul-pow2-lea-shape-ok?)
      (compiler-backend-mul-pow2-shl-shape-ok?))
    (backend-and4
      (compiler-backend-mul-non-pow2-imul-shape-ok?)
      (compiler-backend-gep-fold-disp-shape-ok?)
      (compiler-backend-gep-fold-multi-use-keeps-add-ok?)
      (compiler-backend-gep-fold-builders-ok?))
    (compiler-backend-gep-fold-drift-detected-ok?)
    (compiler-backend-chained-gep-same-home-ok?)
    (compiler-backend-gep-store-fold-shapes-ok?)))

;; When a variable-index Gep and its constant-offset consumer share the same
;; register, the first Gep can still write that home directly. The second Gep's
;; load then folds to a displacement from the just-computed address.
(define (compiler-backend-chained-gep-same-home-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r13"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%rax"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.Register "%rax"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                3
                (CompilerRegLocation.Register "%rax"))
              (compiler-reg-assignment-cons
                (CompilerRegAssignment.Assignment
                  4
                  (CompilerRegLocation.Register "%rax"))
                CompilerRegAssignmentList.Nil)))))]
    [instrs : CompilerIrInstrList
      (compiler-ir-instr-cons
        (CompilerIrInstr.Gep
          2
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          (AstType.U8))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Gep
            3
            (CompilerIrValue.Var 2)
            (CompilerIrValue.I64 8)
            (AstType.U8))
          (compiler-ir-instr-cons
            (CompilerIrInstr.Load 4 (CompilerIrValue.Var 3) (AstType.I64))
            CompilerIrInstrList.Nil)))]
    (match (compiler-backend-emit-test-instrs instrs assignments 5)
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains?
            asm
            "    leaq (%r13,%rax,1), %rax\n")
          (compiler-backend-string-contains? asm "    movq 8(%rax), %rax\n")
          (not (compiler-backend-string-contains? asm "(%rbp)")))]
      [(ResultCompilerBackend.Err _) false])))

;; GAP8: `Gep; Load(single-use, 8-byte); BinOp Add x v` folds the load into
;; the ALU memory operand: `addq (base,idx,8), dst` with no separate movq.
(define (compiler-backend-gep-load-alu-fold-shape-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%r8"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              4
              (CompilerRegLocation.Register "%r14"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                5
                (CompilerRegLocation.Register "%r14"))
              CompilerRegAssignmentList.Nil))))]
    (match (compiler-backend-emit-test-instrs
      (compiler-ir-instr-cons
        (CompilerIrInstr.Gep
          2
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Load 3 (CompilerIrValue.Var 2) (AstType.I64))
          (compiler-ir-instr-cons
            (CompilerIrInstr.BinOp
              5
              (CompilerIrBinOp.Add)
              (CompilerIrValue.Var 4)
              (CompilerIrValue.Var 3)
              (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.Mov 6 (CompilerIrValue.Var 5) (AstType.I64))
              CompilerIrInstrList.Nil))))
      assignments
      7)
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains?
            asm
            "    addq (%r12,%r8,8), %r14\n")
          (not (compiler-backend-string-contains? asm "    movq (%r12,%r8,8)"))
          (not
            (compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))]
      [(ResultCompilerBackend.Err _) false])))

;; GAP9: an offset add feeding only a same-block gep index folds into the
;; addressing displacement -- the add vanishes, the load reads
;; `disp(base,counter,scale)` -- exercised through the pre-pass plus the
;; fused load emission (ordinal consumption included).
(define (compiler-backend-gep-fold-test-blocks [second-use : bool]) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.BinOp
          2
          (CompilerIrBinOp.Add)
          (CompilerIrValue.Var 1)
          (CompilerIrValue.I64 1)
          (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Gep
            3
            (CompilerIrValue.Var 0)
            (CompilerIrValue.Var 2)
            (AstType.I64))
          (compiler-ir-instr-cons
            (CompilerIrInstr.Load 4 (CompilerIrValue.Var 3) (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.Mov 5 (CompilerIrValue.Var 4) (AstType.I64))
              (if second-use
                (compiler-ir-instr-cons
                  (CompilerIrInstr.Mov 6 (CompilerIrValue.Var 2) (AstType.I64))
                  CompilerIrInstrList.Nil)
                CompilerIrInstrList.Nil))))))
    CompilerIrBlockList.Nil))

(define (compiler-backend-gep-fold-test-entry-instrs
  [blocks : CompilerIrBlockList]) : CompilerIrInstrList
  (match blocks
    [(CompilerIrBlockList.Cons block _)
      (match block
        [(CompilerIrBlock.Block _ instrs)
          (compiler-ir-instr-seq-to-list instrs)])]
    [_ CompilerIrInstrList.Nil]))

(define (compiler-backend-gep-fold-test-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r8"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          4
          (CompilerRegLocation.Register "%r14"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            5
            (CompilerRegLocation.Register "%r13"))
          CompilerRegAssignmentList.Nil)))))

(define (compiler-backend-gep-fold-disp-shape-ok?) : bool
  (let
    [folded : CompilerIrBlockList
      (compiler-backend-gep-fold-blocks
        8
        (compiler-backend-gep-fold-test-blocks false))]
    [result : bool
      (if (not compiler-backend-gep-fold-ready)
        false
        (match (compiler-backend-emit-test-instrs
          (compiler-backend-gep-fold-test-entry-instrs folded)
          (compiler-backend-gep-fold-test-assignments)
          8)
          [(ResultCompilerBackend.Ok asm)
            (and
              (compiler-backend-string-contains? asm "8(%r12,%r8,8)")
              (not (compiler-backend-string-contains? asm "addq $1"))
              (not (compiler-backend-string-contains? asm "leaq 1("))
              (not (compiler-backend-gep-fold-drift?)))]
          [(ResultCompilerBackend.Err _) false]))]
    (begin
      (compiler-backend-gep-fold-disable!)
      result)))

;; A second (non-gep) use of the offset var keeps the add and the plain
;; zero-displacement addressing.
(define (compiler-backend-gep-fold-multi-use-keeps-add-ok?) : bool
  (let
    [folded : CompilerIrBlockList
      (compiler-backend-gep-fold-blocks
        8
        (compiler-backend-gep-fold-test-blocks true))]
    [result : bool
      (if compiler-backend-gep-fold-ready
        false
        (match (compiler-backend-emit-test-instrs
          (compiler-backend-gep-fold-test-entry-instrs folded)
          (compiler-backend-gep-fold-test-assignments)
          8)
          [(ResultCompilerBackend.Ok asm)
            (and
              (compiler-backend-string-contains? asm "(%r12,")
              (not (compiler-backend-string-contains? asm "8(%r12,")))]
          [(ResultCompilerBackend.Err _) false]))]
    (begin
      (compiler-backend-gep-fold-disable!)
      result)))

;; The disp-aware address builders.
(define (compiler-backend-gep-fold-builders-ok?) : bool
  (and
    (string.eq
      (compiler-backend-gep-index-address-disp 8 "%rax" 8 "%rcx")
      "8(%rax,%rcx,8)")
    (string.eq
      (compiler-backend-gep-index-address-disp 0 "%rax" 8 "%rcx")
      "(%rax,%rcx,8)")
    (string.eq (compiler-backend-gep-index-address-disp 8 "%rax" 32 "%rcx") "")
    (compiler-backend-string-contains?
      (compiler-backend-gep-index-base-asm-disp 24 "%rax" 32 "%rcx")
      "    addq $24, %rax\n")))

;; Consuming an ordinal with the wrong shape poisons the function (the
;; emit-function gate turns this into a hard backend error).
(define (compiler-backend-gep-fold-drift-detected-ok?) : bool
  (let
    [_folded : CompilerIrBlockList
      (compiler-backend-gep-fold-blocks
        8
        (compiler-backend-gep-fold-test-blocks false))]
    [result : bool
      (if (not compiler-backend-gep-fold-ready)
        false
        (begin
          ;; wrong scale: recorded scale is 8 (i64), consume with u8.
          (compiler-backend-gep-fold-next! (CompilerIrValue.Var 1) (AstType.U8))
          (compiler-backend-gep-fold-drift?)))]
    (begin
      (compiler-backend-gep-fold-disable!)
      result)))

;; A narrow (u8) load must NOT fold: the memory operand width would not match
;; the 64-bit ALU op. The fused movzbq load stays.
(define (compiler-backend-gep-load-alu-fold-rejects-narrow-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%r8"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              3
              (CompilerRegLocation.Register "%rcx"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                4
                (CompilerRegLocation.Register "%r14"))
              (compiler-reg-assignment-cons
                (CompilerRegAssignment.Assignment
                  5
                  (CompilerRegLocation.Register "%r14"))
                CompilerRegAssignmentList.Nil)))))]
    (match (compiler-backend-emit-test-instrs
      (compiler-ir-instr-cons
        (CompilerIrInstr.Gep
          2
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          (AstType.U8))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Load 3 (CompilerIrValue.Var 2) (AstType.U8))
          (compiler-ir-instr-cons
            (CompilerIrInstr.BinOp
              5
              (CompilerIrBinOp.Add)
              (CompilerIrValue.Var 4)
              (CompilerIrValue.Var 3)
              (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.Mov 6 (CompilerIrValue.Var 5) (AstType.I64))
              CompilerIrInstrList.Nil))))
      assignments
      7)
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains?
            asm
            "    movzbq (%r12,%r8,1), %rcx\n")
          (not (compiler-backend-string-contains? asm "    addq (%r12")))]
      [(ResultCompilerBackend.Err _) false])))

;; GAP8: three-operand constant multiply strength reduction shapes.
(define (compiler-backend-mul-pow2-test-asm [factor : i64] [dst-reg : String]) : ResultCompilerBackend
  (compiler-backend-emit-test-instrs
    (compiler-ir-instr-cons
      (CompilerIrInstr.BinOp
        1
        (CompilerIrBinOp.Mul)
        (CompilerIrValue.Var 0)
        (CompilerIrValue.I64 factor)
        (AstType.I64))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Mov 2 (CompilerIrValue.Var 1) (AstType.I64))
        CompilerIrInstrList.Nil))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          1
          (CompilerRegLocation.Register dst-reg))
        CompilerRegAssignmentList.Nil))
    3))

(define (compiler-backend-mul-pow2-lea-shape-ok?) : bool
  (match (compiler-backend-mul-pow2-test-asm 8 "%rcx")
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    leaq (,%r12,8), %rcx\n")
        (not (compiler-backend-string-contains? asm "imulq")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-mul-pow2-shl-shape-ok?) : bool
  (match (compiler-backend-mul-pow2-test-asm 32 "%r12")
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    shlq $5, %r12\n")
        (not (compiler-backend-string-contains? asm "imulq")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-mul-non-pow2-imul-shape-ok?) : bool
  (match (compiler-backend-mul-pow2-test-asm 24 "%rcx")
    [(ResultCompilerBackend.Ok asm)
      (compiler-backend-string-contains? asm "    imulq $24, %r12, %rcx\n")]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-full-syscall-instr) : CompilerIrInstr
  (CompilerIrInstr.Syscall
    0
    (compiler-ir-call-args-from-list
      (compiler-ir-value-cons
        (CompilerIrValue.I64 231)
        (compiler-ir-value-cons
          (CompilerIrValue.I64 1)
          (compiler-ir-value-cons
            (CompilerIrValue.I64 2)
            (compiler-ir-value-cons
              (CompilerIrValue.I64 3)
              (compiler-ir-value-cons
                (CompilerIrValue.I64 4)
                (compiler-ir-value-cons
                  (CompilerIrValue.I64 5)
                  (compiler-ir-value-cons
                    (CompilerIrValue.I64 6)
                    CompilerIrValueList.Nil))))))))))

(define (compiler-backend-full-syscall-registers-ok?) : bool
  (let
    [instr : CompilerIrInstr (compiler-backend-full-syscall-instr)]
    (and
      (backend-and8
        (compiler-backend-instr-contains? instr "    movl $231, %eax\n")
        (compiler-backend-instr-contains? instr "    movl $1, %edi\n")
        (compiler-backend-instr-contains? instr "    movl $2, %esi\n")
        (compiler-backend-instr-contains? instr "    movl $3, %edx\n")
        (compiler-backend-instr-contains? instr "    movl $4, %r10d\n")
        (compiler-backend-instr-contains? instr "    movl $5, %r8d\n")
        (compiler-backend-instr-contains? instr "    movl $6, %r9d\n")
        (compiler-backend-instr-contains? instr "    syscall\n"))
      (not (compiler-backend-instr-contains? instr "    pushq %rax\n"))
      (not (compiler-backend-instr-contains? instr "    popq ")))))

(define (compiler-backend-entry-load-register-homes-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%r13"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.Register "%r14"))
            CompilerRegAssignmentList.Nil)))]
    [instrs : CompilerIrInstrList
      (compiler-ir-instr-cons
        (CompilerIrInstr.EntryArgc 0)
        (compiler-ir-instr-cons
          (CompilerIrInstr.EntryArgv 1)
          (compiler-ir-instr-cons
            (CompilerIrInstr.EntryEnvp 2)
            CompilerIrInstrList.Nil)))]
    (match (compiler-backend-emit-test-instrs instrs assignments 3)
      [(ResultCompilerBackend.Ok asm)
        (and
          (backend-and4
            (compiler-backend-string-contains?
              asm
              "    movq .L_tl_argc(%rip), %r12\n")
            (compiler-backend-string-contains?
              asm
              "    movq .L_tl_argv(%rip), %r13\n")
            (compiler-backend-string-contains?
              asm
              "    movq .L_tl_envp(%rip), %r14\n")
            (not
              (compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %rax\n")))
          (backend-and4
            (not
              (compiler-backend-string-contains?
                asm
                "    movq .L_tl_argv(%rip), %rax\n"))
            (not
              (compiler-backend-string-contains?
                asm
                "    movq .L_tl_envp(%rip), %rax\n"))
            (not
              (compiler-backend-string-contains? asm "    movq %rax, %r12\n"))
            (not
              (compiler-backend-string-contains? asm "    movq %rax, %r13\n")))
          (not (compiler-backend-string-contains? asm "    movq %rax, %r14\n")))]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-entry-load-fallbacks-ok?) : bool
  (let
    [spill-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -16))
        CompilerRegAssignmentList.Nil)]
    [pair-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.RegisterPair "%r12" "%r13"))
        CompilerRegAssignmentList.Nil)]
    [r11-occupied-assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -16))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%r11"))
          CompilerRegAssignmentList.Nil))]
    [no-location-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.EntryArgc 0)
          CompilerIrInstrList.Nil)
        CompilerRegAssignmentList.Nil
        1)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    movq .L_tl_argc(%rip), %r11\n")
            (compiler-backend-string-contains? asm "    movq %r11, -8(%rbp)\n")
            (not
              (compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %rax\n")))]
        [(ResultCompilerBackend.Err _) false])]
    [spill-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.EntryArgv 0)
          CompilerIrInstrList.Nil)
        spill-assignments
        1)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    movq .L_tl_argv(%rip), %r11\n")
            (compiler-backend-string-contains? asm "    movq %r11, -16(%rbp)\n")
            (not
              (compiler-backend-string-contains?
                asm
                "    movq .L_tl_argv(%rip), %rax\n")))]
        [(ResultCompilerBackend.Err _) false])]
    [pair-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.EntryEnvp 0)
          CompilerIrInstrList.Nil)
        pair-assignments
        1)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    movq .L_tl_envp(%rip), %r11\n")
            (compiler-backend-string-contains? asm "    movq %r11, %r12\n")
            (not
              (compiler-backend-string-contains?
                asm
                "    movq .L_tl_envp(%rip), %r12\n"))
            (not
              (compiler-backend-string-contains?
                asm
                "    movq .L_tl_envp(%rip), %rax\n")))]
        [(ResultCompilerBackend.Err _) false])]
    [r11-occupied-ok? : bool
      (match (compiler-backend-emit-test-instrs
        (compiler-ir-instr-cons
          (CompilerIrInstr.EntryArgc 0)
          (compiler-ir-instr-cons
            (CompilerIrInstr.Return
              (CompilerIrMaybeValue.Some (CompilerIrValue.Var 1)))
            CompilerIrInstrList.Nil))
        r11-occupied-assignments
        2)
        [(ResultCompilerBackend.Ok asm)
          (and
            (compiler-backend-string-contains?
              asm
              "    movq .L_tl_argc(%rip), %r9\n")
            (compiler-backend-string-contains? asm "    movq %r9, -16(%rbp)\n")
            (not
              (compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %r11\n"))
            (not
              (compiler-backend-string-contains?
                asm
                "    movq .L_tl_argc(%rip), %rax\n")))]
        [(ResultCompilerBackend.Err _) false])]
    (and no-location-ok? spill-ok? pair-ok? r11-occupied-ok?)))

(define (compiler-backend-cpuid-eax-direct-ok?) : bool
  (let
    [instr : CompilerIrInstr
      (CompilerIrInstr.CpuId
        0
        (CompilerIrValue.I64 7)
        (CompilerIrValue.I64 0)
        0)]
    (backend-and8
      (compiler-backend-instr-contains? instr "    xorl %ecx, %ecx\n")
      (compiler-backend-instr-contains? instr "    movl $7, %eax\n")
      ;; cpuid clobbers %rbx; the campaign preserves the caller's %rbx in a
      ;; scavenged free reg (%r8 here, none of r8-r15 touched by cpuid) instead
      ;; of pushq/popq %rbx (the no-stack-staging goal).
      (compiler-backend-instr-contains? instr "    movq %rbx, %r8\n")
      (compiler-backend-instr-contains? instr "    cpuid\n")
      (compiler-backend-instr-contains? instr "    movq %r8, %rbx\n")
      (not (compiler-backend-instr-contains? instr "    movl %eax, %eax\n"))
      (not (compiler-backend-instr-contains? instr "    movl %r11d, %ecx\n"))
      (not (compiler-backend-instr-contains? instr "%r11")))))

(define (compiler-backend-cpuid-direct-subleaf-ok?) : bool
  (let
    [instr : CompilerIrInstr
      (CompilerIrInstr.CpuId
        0
        (CompilerIrValue.I64 7)
        (CompilerIrValue.I64 3)
        0)]
    (backend-and4
      (compiler-backend-instr-contains? instr "    movl $3, %ecx\n")
      (compiler-backend-instr-contains? instr "    movl $7, %eax\n")
      (not (compiler-backend-instr-contains? instr "    movl %r11d, %ecx\n"))
      (not (compiler-backend-instr-contains? instr "%r11")))))

(define (compiler-backend-xgetbv-zero-index-ok?) : bool
  (let
    [instr : CompilerIrInstr (CompilerIrInstr.Xgetbv 0 (CompilerIrValue.I64 0))]
    (backend-and4
      (compiler-backend-instr-contains? instr "    xorl %ecx, %ecx\n")
      (compiler-backend-instr-contains? instr "    xgetbv\n")
      (compiler-backend-instr-contains? instr "    orq %rdx, %rax\n")
      true)))

(define (compiler-backend-low-level-instr-ok?) : bool
  (and
    (backend-and8
      (compiler-backend-instr-contains?
        (CompilerIrInstr.EntryArgc 0)
        ".L_tl_argc(%rip)")
      (compiler-backend-instr-contains?
        (CompilerIrInstr.EntryArgv 0)
        ".L_tl_argv(%rip)")
      (compiler-backend-instr-contains?
        (CompilerIrInstr.EntryEnvp 0)
        ".L_tl_envp(%rip)")
      (compiler-backend-cpuid-eax-direct-ok?)
      (compiler-backend-instr-contains?
        (CompilerIrInstr.CpuId
          0
          (CompilerIrValue.I64 7)
          (CompilerIrValue.I64 0)
          1)
        "    movl %ebx, %eax\n")
      (compiler-backend-instr-contains?
        (CompilerIrInstr.CpuId
          0
          (CompilerIrValue.I64 7)
          (CompilerIrValue.I64 0)
          2)
        "    movl %ecx, %eax\n")
      (compiler-backend-instr-contains?
        (CompilerIrInstr.CpuId
          0
          (CompilerIrValue.I64 7)
          (CompilerIrValue.I64 0)
          3)
        "    movl %edx, %eax\n")
      (compiler-backend-xgetbv-zero-index-ok?))
    (compiler-backend-cpuid-direct-subleaf-ok?)
    (backend-and8
      ;; A one-operand syscall loads the number into %rax and issues `syscall`.
      (compiler-backend-instr-contains?
        (CompilerIrInstr.Syscall
          0
          (CompilerIrCallArgs.One (CompilerIrValue.I64 231)))
        "    movl $231, %eax\n")
      (compiler-backend-instr-contains?
        (CompilerIrInstr.Syscall
          0
          (CompilerIrCallArgs.One (CompilerIrValue.I64 231)))
        "    syscall\n")
      (not
        (compiler-backend-instr-contains?
          (CompilerIrInstr.Syscall
            0
            (CompilerIrCallArgs.One (CompilerIrValue.I64 231)))
          "    pushq %rax\n"))
      (not
        (compiler-backend-instr-contains?
          (CompilerIrInstr.Syscall
            0
            (CompilerIrCallArgs.One (CompilerIrValue.I64 231)))
          "    popq "))
      ;; A two-operand syscall additionally loads argument 0 into %rdi.
      (compiler-backend-instr-contains?
        (CompilerIrInstr.Syscall
          0
          (CompilerIrCallArgs.Two
            (CompilerIrValue.I64 231)
            (CompilerIrValue.I64 42)))
        "    movl $42, %edi\n")
      (compiler-backend-instr-contains?
        (CompilerIrInstr.Syscall
          0
          (CompilerIrCallArgs.Two
            (CompilerIrValue.I64 231)
            (CompilerIrValue.I64 42)))
        "    movl $231, %eax\n")
      (compiler-backend-instr-contains?
        (CompilerIrInstr.Syscall
          0
          (CompilerIrCallArgs.Two
            (CompilerIrValue.I64 231)
            (CompilerIrValue.I64 0)))
        "    xorl %edi, %edi\n")
      (compiler-backend-full-syscall-registers-ok?))
    (compiler-backend-entry-load-register-homes-ok?)
    (compiler-backend-entry-load-fallbacks-ok?)))

(define (compiler-backend-numeric-cast-shape-ok?) : bool
  (backend-and8
    (compiler-backend-instr-contains?
      (CompilerIrInstr.Cast
        6
        (CompilerIrValue.Var 5)
        (AstType.I64)
        (AstType.F64))
      "    cvtsi2sdq %r8, %xmm2\n")
    (compiler-backend-instr-contains?
      (CompilerIrInstr.Cast
        6
        (CompilerIrValue.Var 5)
        (AstType.I64)
        (AstType.F32))
      "    cvtsi2ssq %r8, %xmm2\n")
    (compiler-backend-instr-contains?
      (CompilerIrInstr.Cast
        6
        (CompilerIrValue.Var 5)
        (AstType.U8)
        (AstType.F64))
      "    cvtsi2sdq %r8, %xmm2\n")
    (compiler-backend-instr-contains?
      (CompilerIrInstr.Cast
        6
        (CompilerIrValue.Var 5)
        (AstType.U64)
        (AstType.F64))
      "    js .L_tl_test_cast_u64_float_entry_v6_high\n")
    (compiler-backend-instr-contains?
      (CompilerIrInstr.Cast
        6
        (CompilerIrValue.Var 5)
        (AstType.U64)
        (AstType.F32))
      "    addss %xmm2, %xmm2\n")
    (compiler-backend-instr-contains?
      (CompilerIrInstr.Cast
        6
        (CompilerIrValue.Var 5)
        (AstType.F64)
        (AstType.I64))
      "    cvttsd2siq %xmm2, %r8\n")
    (compiler-backend-instr-contains?
      (CompilerIrInstr.Cast
        6
        (CompilerIrValue.Var 5)
        (AstType.F64)
        (AstType.F32))
      "    cvtsd2ss %xmm2, %xmm2\n")
    (compiler-backend-instr-contains?
      (CompilerIrInstr.Cast
        6
        (CompilerIrValue.Var 5)
        (AstType.F32)
        (AstType.F64))
      "    cvtss2sd %xmm2, %xmm2\n")))

(define (compiler-backend-direct-float-precision-cast-asm
  [from-ty : AstType]
  [to-ty : AstType]) : ResultCompilerBackend
  (compiler-backend-emit-cast
    "test_cast"
    "entry"
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        0
        (CompilerRegLocation.Register "%xmm2"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          1
          (CompilerRegLocation.Register "%xmm3"))
        CompilerRegAssignmentList.Nil))
    1
    (CompilerIrValue.Var 0)
    from-ty
    to-ty
    (compiler-backend-program-index-build
      CompilerIrFunctionList.Nil
      CompilerIrExternList.Nil)
    ""
    ""
    ""))

(define (compiler-backend-direct-float-precision-cast-home-ok?) : bool
  (match (compiler-backend-direct-float-precision-cast-asm
    (AstType.F64)
    (AstType.F32))
    [(ResultCompilerBackend.Ok narrow-asm)
      (match (compiler-backend-direct-float-precision-cast-asm
        (AstType.F32)
        (AstType.F64))
        [(ResultCompilerBackend.Ok widen-asm)
          (and
            (compiler-backend-string-contains?
              narrow-asm
              "    movsd %xmm2, %xmm3\n")
            (compiler-backend-string-contains?
              narrow-asm
              "    cvtsd2ss %xmm3, %xmm3\n")
            (compiler-backend-string-contains?
              widen-asm
              "    movss %xmm2, %xmm3\n")
            (compiler-backend-string-contains?
              widen-asm
              "    cvtss2sd %xmm3, %xmm3\n")
            (not (compiler-backend-string-contains? narrow-asm "%xmm0"))
            (not (compiler-backend-string-contains? widen-asm "%xmm0")))]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-spill-float-precision-cast-asm
  [from-ty : AstType]
  [to-ty : AstType]) : ResultCompilerBackend
  (compiler-backend-emit-cast
    "test_cast"
    "entry"
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        0
        (CompilerRegLocation.Register "%xmm3"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
        CompilerRegAssignmentList.Nil))
    1
    (CompilerIrValue.Var 0)
    from-ty
    to-ty
    (compiler-backend-program-index-build
      CompilerIrFunctionList.Nil
      CompilerIrExternList.Nil)
    ""
    ""
    ""))

(define (compiler-backend-spill-float-precision-cast-home-ok?) : bool
  (match (compiler-backend-spill-float-precision-cast-asm
    (AstType.F64)
    (AstType.F32))
    [(ResultCompilerBackend.Ok narrow-asm)
      (match (compiler-backend-spill-float-precision-cast-asm
        (AstType.F32)
        (AstType.F64))
        [(ResultCompilerBackend.Ok widen-asm)
          (and
            (compiler-backend-string-contains?
              narrow-asm
              "    movsd %xmm3, %xmm2\n")
            (compiler-backend-string-contains?
              narrow-asm
              "    cvtsd2ss %xmm2, %xmm2\n")
            (compiler-backend-string-contains?
              narrow-asm
              "    movss %xmm2, -16(%rbp)\n")
            (compiler-backend-string-contains?
              widen-asm
              "    movss %xmm3, %xmm2\n")
            (compiler-backend-string-contains?
              widen-asm
