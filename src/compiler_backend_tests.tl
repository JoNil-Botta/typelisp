        (compiler_ir_types.CompilerIrValue.Var 1)
        64
        (compiler_ast_types.AstType.Bool)
        "%r14"
        "%r13"
        "%xmm0"
        "%xmm1"
        diag)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    kmovq %k2, %r13\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    notq %r13\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    shlq $32, %r14\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %rax, %r14\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    setne %r14b\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    andq %r14, %r13\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    kmovq %r13, %k7\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    kmovq %k7, -64(%rbp)\n")
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "    kmovq %k2, %rax\n"))
            (not
              (compiler_backend.compiler-backend-string-contains? asm "%zmm")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])
      (match (compiler_backend.compiler-backend-emit-avx512-vector-prefix
        (compiler-backend-avx512-vector-prefix-bool-source-spill-assignments)
        2
        (compiler_ir_types.CompilerIrVectorPrefixOp.Any)
        (compiler_ir_types.CompilerIrValue.Var 0)
        (compiler_ir_types.CompilerIrValue.Var 1)
        64
        (compiler_ast_types.AstType.Bool)
        "%r14"
        "%r13"
        "%xmm0"
        "%xmm1"
        diag)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    kmovq -64(%rbp), %k7\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    kmovq %k7, %r13\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq -8(%rbp), %r14\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    orq %r14, %r13\n")
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    kmovq %r13, %k3\n")
            (not
              (compiler_backend.compiler-backend-string-contains? asm "%rax")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-avx512-predicated-load-spill-dst-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-avx512-predicated-load
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-spill-assignments)
    3
    (compiler_ir_types.CompilerIrValue.Var 0)
    (compiler_ir_types.CompilerIrValue.I64 0)
    (compiler_ir_types.CompilerIrValue.Var 4)
    8
    (compiler_ast_types.AstType.I64)
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" ""))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (string.eq
        asm
        "    vmovdqu64 (%rdi), %zmm14{%k1}{z}\n    vmovdqu64 %zmm14, -64(%rbp)\n")]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

