(define (compiler-backend-literal-float-to-bits-source) : String
  "(module stdlib.math)
(define (f64-to-bits [value : f64]) : u64 (__tl_float_to_bits value))
(define (f32-to-bits [value : f32]) : u32 (__tl_float_to_bits value))
(defstruct FloatBitsRow
  (tail-bits u64)
  (head-bits u64)
  (scale-bits u32)
  (offset-bits u32))
(define (float-bits-row [index : i64]) : FloatBitsRow
  (if (= index 0)
    (FloatBitsRow
      (stdlib.math.f64-to-bits 0.1)
      (stdlib.math.f64-to-bits 0.)
      (stdlib.math.f32-to-bits -0.0)
      (stdlib.math.f32-to-bits
        0.000000000000000000000000000000000000000000001))
    (FloatBitsRow
      (stdlib.math.f64-to-bits -0.1)
      (stdlib.math.f64-to-bits -0.)
      (stdlib.math.f32-to-bits 0.1)
      (stdlib.math.f32-to-bits
        -0.000000000000000000000000000000000000000000001))))
(define (main) : i64
  (let
    [first : FloatBitsRow (float-bits-row 0)]
    [second : FloatBitsRow (float-bits-row 1)]
    (if (= first.tail-bits 0x3fb999999999999a)
      (if (= first.head-bits 0x0000000000000001)
        (if (= first.scale-bits 0x80000000)
          (if (= first.offset-bits 0x00000001)
            (if (= second.tail-bits 0xbfb999999999999a)
              (if (= second.head-bits 0x8000000000000001)
                (if (= second.scale-bits 0x3dcccccd)
                  (if (= second.offset-bits 0x80000001) 42 1)
                  1)
                1)
              1)
            1)
          1)
        1)
      1)))")

(define (compiler-backend-integer-float-bits-source) : String
  "(module stdlib.math)
(define (f64-to-bits [value : f64]) : u64 (__tl_float_to_bits value))
(define (f32-to-bits [value : f32]) : u32 (__tl_float_to_bits value))
(defstruct FloatBitsRow
  (tail-bits u64)
  (head-bits u64)
  (scale-bits u32)
  (offset-bits u32))
(define (float-bits-row [index : i64]) : FloatBitsRow
  (if (= index 0)
    (FloatBitsRow
      0x3fb999999999999a
      0x0000000000000001
      0x80000000
      0x00000001)
    (FloatBitsRow
      0xbfb999999999999a
      0x8000000000000001
      0x3dcccccd
      0x80000001)))
(define (main) : i64
  (let
    [first : FloatBitsRow (float-bits-row 0)]
    [second : FloatBitsRow (float-bits-row 1)]
    (if (= first.tail-bits 0x3fb999999999999a)
      (if (= first.head-bits 0x0000000000000001)
        (if (= first.scale-bits 0x80000000)
          (if (= first.offset-bits 0x00000001)
            (if (= second.tail-bits 0xbfb999999999999a)
              (if (= second.head-bits 0x8000000000000001)
                (if (= second.scale-bits 0x3dcccccd)
                  (if (= second.offset-bits 0x80000001) 42 1)
                  1)
                1)
              1)
            1)
          1)
        1)
      1)))")

