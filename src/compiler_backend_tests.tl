      "%k")
    (compiler-backend-bool-reduce-asm-contains?
      "(define (f [xs : (Array bool)] [n : i64]) : bool (spmd-reduce any ([i : i64 0 n]) false (array-ref xs i)))"
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      "    kortestq "
      "    setne %al\n"
      "%k")))

(define (compiler-backend-vector-reduce-direct-assignments
  [dst-location : compiler_regalloc.CompilerRegLocation]) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        (compiler_abi.compiler-abi-vector-register-id 6)))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment 1 dst-location)
      compiler_regalloc.CompilerRegAssignmentList.Nil)))

(define (compiler-backend-avx512-vector-reduce-narrow-case-ok?
  [elem-ty : compiler_ast_types.AstType]
  [lanes : i64]
  [mnemonic : String]
  [last-shift : String]) : bool
  (match (compiler_backend.compiler-backend-emit-avx512-vector-reduce
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-vector-reduce-direct-assignments
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-r10))
    1
    (compiler_ir_types.CompilerIrVectorReduceOp.Min)
    (compiler_ir_types.CompilerIrValue.Var 0)
    lanes
    elem-ty
    ""
    ""
    (compiler_diagnostic.compiler-diagnostic-at-start "" ""))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vextracti64x4 $1, %zmm6, %ymm2\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vextracti128 $1, %ymm2, %xmm3\n")
        (compiler_backend.compiler-backend-string-contains? asm mnemonic)
        (compiler_backend.compiler-backend-string-contains? asm last-shift)
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    vmovq %xmm2, ")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "unsupported AVX-512 vector reduction")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-avx512-vector-reduce-narrow-ok?) : bool
  (and
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (compiler_ast_types.AstType.I16)
      32
      "    vpminsw "
      "    vpsrldq $2, ")
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (compiler_ast_types.AstType.U16)
      32
      "    vpminuw "
      "    vpsrldq $2, ")
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (compiler_ast_types.AstType.I8)
      64
      "    vpminsb "
      "    vpsrldq $1, ")
    (compiler-backend-avx512-vector-reduce-narrow-case-ok?
      (compiler_ast_types.AstType.U8)
      64
      "    vpminub "
      "    vpsrldq $1, ")))

