(define (compiler-backend-vector-spill-reload-ok?) : bool
  (and
    (compiler-backend-avx2-vector-load-spill-dst-ok?)
    (compiler-backend-avx2-vector-binop-spill-ok?)
    (compiler-backend-avx2-vector-prefix-i64-spill-ok?)
    (compiler-backend-avx2-vector-prefix-source-carry-spill-ok?)
    (compiler-backend-avx2-vector-prefix-bool-spill-ok?)
    (compiler-backend-avx512-vector-prefix-numeric-spill-ok?)
    (compiler-backend-avx512-vector-prefix-bool-spill-ok?)
    (compiler-backend-avx512-predicated-load-spill-dst-ok?)
    (compiler-backend-avx512-select-spill-ok?)
    (compiler-backend-avx2-vector-reduce-spill-source-ok?)
    (compiler-backend-avx512-vector-reduce-spill-source-ok?)))

(define (compiler-backend-vector-spill-pressure-source) : String
  "(define (main) : i64 0)
(define (fill
  [a0 : (__tl_dyn-array i64)]
  [a1 : (__tl_dyn-array i64)]
  [a2 : (__tl_dyn-array i64)]
  [a3 : (__tl_dyn-array i64)]
  [a4 : (__tl_dyn-array i64)]
  [a5 : (__tl_dyn-array i64)]
  [a6 : (__tl_dyn-array i64)]
  [a7 : (__tl_dyn-array i64)]
  [a8 : (__tl_dyn-array i64)]
  [a9 : (__tl_dyn-array i64)]
  [a10 : (__tl_dyn-array i64)]
  [a11 : (__tl_dyn-array i64)]
  [a12 : (__tl_dyn-array i64)]
  [a13 : (__tl_dyn-array i64)]
  [a14 : (__tl_dyn-array i64)]
  [a15 : (__tl_dyn-array i64)]
  [out : (__tl_dyn-array i64)]
  [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (set! (array-ref out i) (+ (array-ref a0 i)
        (+ (array-ref a1 i)
          (+ (array-ref a2 i)
            (+ (array-ref a3 i)
              (+ (array-ref a4 i)
                (+ (array-ref a5 i)
                  (+ (array-ref a6 i)
                    (+ (array-ref a7 i)
                      (+ (array-ref a8 i)
                        (+ (array-ref a9 i)
                          (+ (array-ref a10 i)
                            (+ (array-ref a11 i)
                              (+ (array-ref a12 i)
                                (+ (array-ref a13 i)
                                  (+ (array-ref a14 i)
                                    (array-ref a15 i)))))))))))))))))))")

(define (compiler-backend-vector-spill-pressure-mode-ok?
  [lower-mode : lower.CompilerLowerMode]
  [backend-mode : be_state.CompilerBackendMode]
  [scratch : String]) : bool
  (match (lower.lower-compiler-source-with-mode
    (compiler-backend-vector-spill-pressure-source)
    lower-mode)
    [(Ok program spans lower-owner)
      (let
        [result : bool
          (asm-ok?
            (backend.compiler-backend-emit-program-target-with-mode
              program
              (be_state.CompilerBackendTarget.Linux)
              backend-mode
              spans
              true)
            (has scratch)
            (lacks
              "vector spills are not implemented"
              "vector register home unavailable"))]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        result)]
    [(Err _) false]))

(define (compiler-backend-vector-spill-pressure-ok?) : bool
  (and
    (compiler-backend-vector-spill-pressure-mode-ok?
      (lower.CompilerLowerMode.Avx2)
      (Avx2)
      "%ymm14")
    (compiler-backend-vector-spill-pressure-mode-ok?
      (lower.CompilerLowerMode.Avx512)
      (Avx512)
      "%zmm14")))

(define (compiler-backend-simd-address-assignments) : regalloc.CompilerRegAssignmentTable
  (reg-homes "%0=%rdi %1=%r12 %2=%rax %3=%vec6 %4=%vec7 %5=%k1 %6=%rcx"))

(define (compiler-backend-simd-indexed-address-with-base-emits?
  [base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [want-asm : String]
  [want-addr : String]) : bool
  (match (be_simd.compiler-backend-emit-simd-indexed-address
    (ast.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-simd-address-assignments)
    base
    index
    elem-ty
    (be_state.compiler-backend-state-new
      (ci.intern-compat-state-capture-active)))
    [(Ok addr-plan)
      (and
        (string.eq addr-plan.asm want-asm)
        (string.eq addr-plan.addr want-addr))]
    [(Err _) false]))

(define (compiler-backend-simd-indexed-address-emits?
  [index : ir.CompilerIrValue]
  [elem-ty : ast.AstType]
  [want-asm : String]
  [want-addr : String]) : bool
  (compiler-backend-simd-indexed-address-with-base-emits?
    (Var 0)
    index
    elem-ty
    want-asm
    want-addr))

(define (compiler-backend-simd-indexed-address-ok?) : bool
  (and
    (compiler-backend-simd-indexed-address-emits? (I64 0) (I64) "" "(%rdi)")
    (compiler-backend-simd-indexed-address-emits? (I64 4) (I64) "" "32(%rdi)")
    (compiler-backend-simd-indexed-address-emits?
      (Var 1)
      (I32)
      ""
      "(%rdi,%r12,4)")
    (compiler-backend-simd-indexed-address-emits?
      (Var 2)
      (I64)
      ""
      "(%rdi,%rax,8)")
    (compiler-backend-simd-indexed-address-with-base-emits?
      (Var 6)
      (Var 2)
      (I64)
      ""
      "(%rcx,%rax,8)")
    (compiler-backend-simd-indexed-address-emits?
      (Var 7)
      (I64)
      "    movq -64(%rbp), %r9\n"
      "(%rdi,%r9,8)")))

(define (compiler-backend-avx2-vector-load-address-ok?) : bool
  (match (be_simd.compiler-backend-emit-vector-load
    (Avx2)
    (ast.ast-node-pool-reader-type-segment-bases)
