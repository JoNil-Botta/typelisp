          (compiler-backend-explicit-state-object-result-text
            (owned_view.compiler-owned-shared-view object-b1))
          symbol-b
          symbol-a)
        (string.eq
          (compiler-backend-explicit-state-object-result-text object-a1)
          (compiler-backend-explicit-state-object-result-text object-a2))
        (string.eq
          (compiler-backend-explicit-state-object-result-text object-b1)
          (compiler-backend-explicit-state-object-result-text object-b2))
        (compiler-backend-explicit-state-pic-result-ok? pic-a1)
        (compiler-backend-explicit-state-pic-result-ok? pic-b1)
        (compiler-backend-explicit-state-pic-result-ok? pic-a2)
        (compiler-backend-explicit-state-pic-result-ok? pic-b2)
        (compiler-backend-explicit-state-own-symbols-ok?
          (compiler-backend-explicit-state-pic-result-text
            (owned_view.compiler-owned-shared-view pic-a1))
          symbol-a
          symbol-b)
        (compiler-backend-explicit-state-own-symbols-ok?
          (compiler-backend-explicit-state-pic-result-text
            (owned_view.compiler-owned-shared-view pic-b1))
          symbol-b
          symbol-a)
        (string.eq
          (compiler-backend-explicit-state-pic-result-text pic-a1)
          (compiler-backend-explicit-state-pic-result-text pic-a2))
        (string.eq
          (compiler-backend-explicit-state-pic-result-text pic-b1)
          (compiler-backend-explicit-state-pic-result-text pic-b2)))]
    (ci.intern-compat-state-install! active-before)
    (cbi.state-install! builtin-before)
    ok))

(define (compiler-backend-explicit-state-target-pic-policy-ok?) : bool
  (let
    [program : ir.CompilerIrProgram (irt.program "")]
    [spans : ir.CompilerSourceSpans (ir.compiler-source-spans-empty)]
    [linux-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new (ci.intern-compat-state-new))]
    [windows-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new (ci.intern-compat-state-new))]
    [pic-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new (ci.intern-compat-state-new))]
    [_linux-result : be_state.ResultCompilerBackendBuffer
      (backend.compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
        linux-state
        0
        (owned_view.compiler-owned-shared-view program)
        (be_state.CompilerBackendTarget.Linux)
        (Scalar)
        (owned_view.compiler-owned-shared-view spans)
        false
        false
        false
        (profile_state.compiler-profile-state-new))]
    [_windows-result : be_state.ResultCompilerBackendBuffer
      (backend.compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
        windows-state
        0
        (owned_view.compiler-owned-shared-view program)
        (be_state.CompilerBackendTarget.Windows)
        (Avx2)
        (owned_view.compiler-owned-shared-view spans)
        false
        false
        false
        (profile_state.compiler-profile-state-new))]
    [_pic-result : be_state.ResultCompilerBackendPic
      (backend.compiler-backend-emit-program-pic-target-with-mode-with-type-segment-bases-and-crt-and-profile-state-backend-state
        pic-state
        0
        program
        (be_state.CompilerBackendTarget.Linux)
        (Avx512)
        spans
        false
        false
        (profile_state.compiler-profile-state-new))]
    [linux-policy : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-state-emission-target-policy linux-state)]
    [windows-policy : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-state-emission-target-policy windows-state)]
    [pic-policy : be_state.CompilerBackendTargetPolicy
      (be_state.compiler-backend-state-emission-target-policy pic-state)]
    (and
      linux-policy.linux
      (not linux-policy.windows)
      windows-policy.windows
      (not windows-policy.linux)
      pic-policy.linux
      (not pic-policy.windows)
      (be_state.compiler-backend-state-absolute-switch-ok? linux-state)
      (not (be_state.compiler-backend-state-absolute-switch-ok? windows-state))
      (not (be_state.compiler-backend-state-absolute-switch-ok? pic-state)))))

(define (compiler-backend-abort-counter-failure-reset-ok?) : bool
  (let
    [active-before : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [counter-a : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new (ci.intern-compat-state-new))]
    [counter-b : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new (ci.intern-compat-state-new))]
    [_set-a : unit
      (be_state.compiler-backend-state-set-abort-site-counter! counter-a 7)]
    [_set-b : unit
      (be_state.compiler-backend-state-set-abort-site-counter! counter-b 11)]
    [a1 : i64
      (be_state.compiler-backend-state-next-abort-site-counter! counter-a)]
    [b1 : i64
      (be_state.compiler-backend-state-next-abort-site-counter! counter-b)]
    [a2 : i64
      (be_state.compiler-backend-state-next-abort-site-counter! counter-a)]
    [interleave-ok : bool (and (= a1 8) (= b1 12) (= a2 9))]
    [failure-ok : bool
      (compiler-backend-abort-counter-duplicate-failure-reset-ok?)]
    (ci.intern-compat-state-install! active-before)
    (and
      interleave-ok
      failure-ok
      (= (be_state.compiler-backend-state-abort-site-counter counter-b) 12))))

(define (compiler-backend-abort-counter-duplicate-failure-reset-ok?) : bool
  (let
    [active-before : ci.InternCompatState
      (ci.intern-compat-state-capture-active)]
    [builtin-before : cbi.CompilerBuiltinIdsState (cbi.state-capture)]
    [intern-state : ci.InternCompatState (ci.intern-compat-state-new)]
    [_install-state : unit (ci.intern-compat-state-install! intern-state)]
    [_reset-state : unit (cbi.compiler-builtin-reset!)]
    [_init-state : unit (cbi.compiler-builtin-initialize-for-parse!)]
    [_capture-state : unit
      (ci.intern-compat-state-capture-from-globals! (&mut intern-state))]
    [name-id : i64
      (ci.intern-compat-state-intern (&mut intern-state) "dup_abort")]
    [_restore-active : unit
      (begin
        (ci.intern-compat-state-install! active-before)
        (cbi.state-install! builtin-before))]
    [failure-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new intern-state)]
    [untouched-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [spans : ir.CompilerSourceSpans (ir.compiler-source-spans-empty)]
    [_seed-failure : unit
      (be_state.compiler-backend-state-set-abort-site-counter! failure-state 77)]
    [_seed-untouched : unit
      (be_state.compiler-backend-state-set-abort-site-counter!
        untouched-state
        11)]
    [failure-stream : be_state.CompilerBackendStreamState
      (be_state.compiler-backend-state-stream-state failure-state)]
    [duplicate-result : be_state.ResultCompilerBackendBuffer
      (backend.compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
        failure-state
        0
        (compiler-backend-explicit-state-duplicate-function-program name-id)
        (be_state.CompilerBackendTarget.Linux)
        (Scalar)
        (owned_view.compiler-owned-shared-view spans)
        false
        false
        (profile_state.compiler-profile-state-new))]
    [duplicate-failed : bool
      (match duplicate-result
        [(Err diag)
          (let
            [text (cdiag.compiler-diagnostic-message (__tl-box-place diag))]
            (asm-has? text "duplicate emitted function symbol"))]
        [(Ok _) false])]
    [duplicate-stream-retired : bool
      (and
        (not (be_facts.compiler-backend-assembly-stream-active? failure-stream))
        (=
          (be_state.compiler-backend-assembly-stream-home-arena-handle-value
            failure-stream)
          0))]
    [valid-result : be_state.ResultCompilerBackendBuffer
      (backend.compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
        failure-state
        0
        (compiler-backend-explicit-state-minimal-program name-id)
        (be_state.CompilerBackendTarget.Linux)
        (Scalar)
        spans
        false
        false
        (profile_state.compiler-profile-state-new))]
    [valid-ok : bool
      (match valid-result
        [(Ok buf)
          (let
            [text (text_buf.render buf)]
            (asm-has? text "_tl_dup_abort"))]
        [(Err _) false])]
    (ci.intern-compat-state-install! active-before)
    (cbi.state-install! builtin-before)
    (and
      duplicate-failed
      duplicate-stream-retired
      (= (be_state.compiler-backend-state-abort-site-counter failure-state) 0)
      (=
        (be_state.compiler-backend-state-abort-site-counter untouched-state)
        11)
      valid-ok)))

(define (compiler-backend-instr-diagnostic-case-ok?
  [instr : ir.CompilerIrInstr]
  [want-message : String]
  [want-line : i64]
  [want-col : i64]) : bool
  (let
    [spans : ir.CompilerSourceSpans
      (ir.compiler-source-spans-insert-instr
        (ir.compiler-source-spans-insert
          (ir.compiler-source-spans-empty)
          (ir.compiler-ir-symbol-typed-id (ci.intern "main"))
          (compiler-backend-test-span 10 2))
        (ir.compiler-ir-symbol-typed-id (ci.intern "main"))
        (& instr)
        (compiler-backend-test-span want-line want-col))]
    [program : ir.CompilerIrProgram
      (Program
        (ir.compiler-ir-global-seq-empty)
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              (ci.intern "main")
              (ir.compiler-ir-param-seq-empty)
              (I64)
              4
              (ir.compiler-ir-blocks
                (ir.CompilerIrBlock.Block
                  (ir.compiler-ir-label "entry")
                  (compiler-backend-test-instr-seq-prepend
                    instr
                    (ir.compiler-ir-instr-seq-empty))))
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))
        (ir.compiler-ir-extern-seq-empty)
        (ir.CompilerIrReturnStorageAuthority.None))]
    (match (backend.compiler-backend-emit-program-target-with-mode
      program
      (be_state.CompilerBackendTarget.Linux)
      (Scalar)
      spans
      true)
      [(Err diag)
        (and
          (string.eq
            (cdiag.compiler-diagnostic-message (__tl-box-place diag))
            want-message)
          (= (cdiag.compiler-diagnostic-line (__tl-box-place diag)) want-line)
          (= (cdiag.compiler-diagnostic-col (__tl-box-place diag)) want-col))]
      [(Ok _) false])))

(define (compiler-backend-switch-test-blocks) : ir.CompilerIrBlockList
  (irt.blocks
    "entry:
       switch %0 base 0 [0:zero, 1:one, 2:two] default other
     zero:
       return 0
     one:
       return 1
     two:
       return 2
     other:
       return 42"))

(define (compiler-backend-switch-test-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (ci.intern "main")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          1
          (compiler-backend-switch-test-blocks)
          Ordinary))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-total-switch-test-cases) : ir.CompilerIrSwitchCaseSeq
  (let
    [builder : ir.CompilerIrSwitchCaseBuilder
      (ir.compiler-ir-switch-case-builder-with-capacity 6)]
    (ir.compiler-ir-switch-case-builder-push!
      (&mut builder)
      (ir.CompilerIrSwitchCase.Case 0 (ir.compiler-ir-label "zero")))
    (ir.compiler-ir-switch-case-builder-push!
      (&mut builder)
      (ir.CompilerIrSwitchCase.Case 1 (ir.compiler-ir-label "one")))
    (ir.compiler-ir-switch-case-builder-push!
      (&mut builder)
      (ir.CompilerIrSwitchCase.Case 2 (ir.compiler-ir-label "two")))
    (ir.compiler-ir-switch-case-builder-push!
      (&mut builder)
      (ir.CompilerIrSwitchCase.Case 3 (ir.compiler-ir-label "three")))
    (ir.compiler-ir-switch-case-builder-push!
      (&mut builder)
      (ir.CompilerIrSwitchCase.Case 4 (ir.compiler-ir-label "four")))
    (ir.compiler-ir-switch-case-builder-push!
      (&mut builder)
      (ir.CompilerIrSwitchCase.Case 5 (ir.compiler-ir-label "five")))
    (ir.compiler-ir-switch-case-builder-to-seq builder)))

(define (compiler-backend-total-switch-return-block
  [label : i64]
  [value : i64]
  [rest : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    rest
    (ir.CompilerIrBlock.Block
      label
      (compiler-backend-test-instr-seq-prepend
        (Return (Some (I64 value)))
        (ir.compiler-ir-instr-seq-empty)))))

(define (compiler-backend-total-switch-trap-test-block) : ir.CompilerIrBlock
  (Block
    (ir.compiler-ir-label "match_total_trap")
    (compiler-backend-test-instr-seq-prepend
      (Call 1 cbi.compiler-builtin-id-tl-oob-abort (Nil) (Unit))
      (compiler-backend-test-instr-seq-prepend
        (Jump (ir.compiler-ir-label "match_total_trap"))
        (ir.compiler-ir-instr-seq-empty)))))

(define (compiler-backend-total-switch-test-blocks [explicit-total? : bool]) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (compiler-backend-total-switch-return-block
      (ir.compiler-ir-label "zero")
      0
      (compiler-backend-total-switch-return-block
        (ir.compiler-ir-label "one")
        1
        (compiler-backend-total-switch-return-block
          (ir.compiler-ir-label "two")
          2
          (compiler-backend-total-switch-return-block
            (ir.compiler-ir-label "three")
            3
            (compiler-backend-total-switch-return-block
              (ir.compiler-ir-label "four")
              4
              (compiler-backend-total-switch-return-block
                (ir.compiler-ir-label "five")
                5
                (ir.compiler-ir-blocks
                  (compiler-backend-total-switch-trap-test-block))))))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (compiler-backend-test-instr-seq-prepend
        (if explicit-total?
          (TotalEnumSwitch
            (Var 0)
            0
            (compiler-backend-total-switch-test-cases)
            (ir.compiler-ir-label "match_total_trap")
            (ir.compiler-ir-label "match_total_trap"))
          ;; The old display spelling must not authorize unchecked dispatch.
          (irt.instr
            "switch %0 base 0 [0:zero, 1:one, 2:two, 3:three, 4:four, 5:five] default match_total_trap"))
        (ir.compiler-ir-instr-seq-empty)))))

(define (compiler-backend-total-switch-test-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (ci.intern "main")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          2
          (compiler-backend-total-switch-test-blocks true)
          Ordinary))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-forwarded-total-switch-test-blocks) : ir.CompilerIrBlockList
  (ir.compiler-ir-blocks-with-tail
    (compiler-backend-total-switch-return-block
      (ir.compiler-ir-label "zero")
      0
      (compiler-backend-total-switch-return-block
        (ir.compiler-ir-label "one")
        1
        (compiler-backend-total-switch-return-block
          (ir.compiler-ir-label "two")
          2
          (compiler-backend-total-switch-return-block
            (ir.compiler-ir-label "three")
            3
            (compiler-backend-total-switch-return-block
              (ir.compiler-ir-label "four")
              4
              (compiler-backend-total-switch-return-block
                (ir.compiler-ir-label "five")
                5
                (ir.compiler-ir-blocks
                  (ir.CompilerIrBlock.Block
                    (ir.compiler-ir-label "plain_preheader")
                    (compiler-backend-test-instr-seq-prepend
                      (Jump (ir.compiler-ir-label "plain_abort"))
                      (ir.compiler-ir-instr-seq-empty)))
                  (ir.CompilerIrBlock.Block
                    (ir.compiler-ir-label "plain_abort")
                    (compiler-backend-test-instr-seq-prepend
                      (Call 1 cbi.compiler-builtin-id-tl-oob-abort (Nil) (Unit))
                      (compiler-backend-test-instr-seq-prepend
                        (Jump (ir.compiler-ir-label "plain_abort"))
                        (ir.compiler-ir-instr-seq-empty)))))))))))
    (ir.CompilerIrBlock.Block
      (ir.compiler-ir-label "entry")
      (compiler-backend-test-instr-seq-prepend
        (TotalEnumSwitch
          (Var 0)
          0
          (compiler-backend-total-switch-test-cases)
          (ir.compiler-ir-label "plain_preheader")
          (ir.compiler-ir-label "plain_abort"))
        (ir.compiler-ir-instr-seq-empty)))))

(define (compiler-backend-forwarded-total-switch-test-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (ci.intern "main")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          2
          (compiler-backend-forwarded-total-switch-test-blocks)
          Ordinary))
      (& (ir.compiler-ir-function-seq-empty)))
