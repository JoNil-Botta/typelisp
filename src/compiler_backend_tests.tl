;; A region's free candidate registers go to the constants with the most static
;; sites, because each hoisted site drops one in-region constant load. The
;; measured forcing case is a leaf loop holding a single-site wide literal and a
;; multi-site divmod magic: program order handed the only free register to the
;; literal, so the magic reloaded its `movabsq` at every site on every
;; iteration. `values`/`wide` carry six entries -- literal L (one site, written
;; FIRST), magic M (three sites), magic N (two sites) -- so the award sequence
;; must be M, N, L even though L occurs first.
(define (compiler-backend-const-hoist-award-weight-ok?) : bool
  (let
    [values : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [wide : (__tl_dyn-array bool) (__tl_make-array bool 6)]
    [order : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [tally : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [_fill : unit
      (begin
        ;; index 0: wide literal L, one site
        (set! (array-ref values 0) 4242)
        (set! (array-ref wide 0) true)
        ;; indices 1,3,5: magic M, three sites
        (set! (array-ref values 1) 777)
        (set! (array-ref wide 1) false)
        (set! (array-ref values 3) 777)
        (set! (array-ref wide 3) false)
        (set! (array-ref values 5) 777)
        (set! (array-ref wide 5) false)
        ;; indices 2,4: magic N, two sites
        (set! (array-ref values 2) 999)
        (set! (array-ref wide 2) false)
        (set! (array-ref values 4) 999)
        (set! (array-ref wide 4) false))]
    [awards : i64
      (compiler_backend.compiler-backend-const-hoist-award-order!
        values
        wide
        6
        order
        tally)]
    (and
      ;; three distinct (value, wide?) keys, not six entries
      (= awards 3)
      ;; heaviest first: M (3 sites) then N (2) then L (1)
      (= (array-ref order 0) 1)
      (= (array-ref tally 0) 3)
      (= (array-ref order 1) 2)
      (= (array-ref tally 1) 2)
      (= (array-ref order 2) 0)
      (= (array-ref tally 2) 1))))

;; The dedup key is (value, wide?), so the same literal counts separately as a
;; wide-binop constant and as a divmod magic; and equal site counts award in
;; program order, which keeps the emitted plan a total order with no dependence
;; on any map's iteration order. Entries: value 5 as WIDE at 0 and 3, value 5 as
;; NON-wide at 1 and 4, value 6 as non-wide at 2 and 5 -- three keys, two sites
;; each, so the result must be exactly their first-occurrence order 0, 1, 2.
(define (compiler-backend-const-hoist-award-tie-ok?) : bool
  (let
    [values : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [wide : (__tl_dyn-array bool) (__tl_make-array bool 6)]
    [order : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [tally : (__tl_dyn-array i64) (__tl_make-array i64 6)]
    [_fill : unit
      (begin
        (set! (array-ref values 0) 5)
        (set! (array-ref wide 0) true)
        (set! (array-ref values 3) 5)
        (set! (array-ref wide 3) true)
        (set! (array-ref values 1) 5)
        (set! (array-ref wide 1) false)
        (set! (array-ref values 4) 5)
        (set! (array-ref wide 4) false)
        (set! (array-ref values 2) 6)
        (set! (array-ref wide 2) false)
        (set! (array-ref values 5) 6)
        (set! (array-ref wide 5) false))]
    [awards : i64
      (compiler_backend.compiler-backend-const-hoist-award-order!
        values
        wide
        6
        order
        tally)]
    (and
      (= awards 3)
      (= (array-ref order 0) 0)
      (= (array-ref order 1) 1)
      (= (array-ref order 2) 2)
      (= (array-ref tally 0) 2)
      (= (array-ref tally 1) 2)
      (= (array-ref tally 2) 2)
      ;; An empty region awards nothing and reads no scratch entry.
      (=
        (compiler_backend.compiler-backend-const-hoist-award-order!
          values
          wide
          0
          order
          tally)
        0)
      ;; A single site is one key of weight one.
      (=
        (compiler_backend.compiler-backend-const-hoist-award-order!
          values
          wide
          1
          order
          tally)
        1)
      (= (array-ref tally 0) 1))))

;; Const-hoist candidates must reflect ABI volatility. Win64 keeps %rsi/%rdi
;; out of the plan while retaining the caller-saved %r8/%r9 and the
;; ABI-neutral %rbx frame-home fallback.
(define (compiler-backend-const-hoist-candidates-abi-ok?) : bool
  (and
    (=
      (compiler_regalloc.compiler-reg-id-seq-count
        (compiler_backend.compiler-backend-const-hoist-candidate-regs
          (compiler_backend.CompilerBackendTarget.Linux)))
      5)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Linux))
      compiler_abi.compiler-reg-id-rsi)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Linux))
      compiler_abi.compiler-reg-id-rdi)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Linux))
      compiler_abi.compiler-reg-id-r8)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Linux))
      compiler_abi.compiler-reg-id-r9)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Linux))
      compiler_abi.compiler-reg-id-rbx)
    (=
      (compiler_regalloc.compiler-reg-id-seq-count
        (compiler_backend.compiler-backend-const-hoist-candidate-regs
          (compiler_backend.CompilerBackendTarget.Windows)))
      3)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Windows))
      compiler_abi.compiler-reg-id-r8)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Windows))
      compiler_abi.compiler-reg-id-r9)
    (compiler_regalloc.compiler-reg-id-seq-contains?
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Windows))
      compiler_abi.compiler-reg-id-rbx)
    (not
      (compiler_regalloc.compiler-reg-id-seq-contains?
        (compiler_backend.compiler-backend-const-hoist-candidate-regs
          (compiler_backend.CompilerBackendTarget.Windows))
        compiler_abi.compiler-reg-id-rsi))
    (not
      (compiler_regalloc.compiler-reg-id-seq-contains?
        (compiler_backend.compiler-backend-const-hoist-candidate-regs
          (compiler_backend.CompilerBackendTarget.Windows))
        compiler_abi.compiler-reg-id-rdi))))

;; The scratch-vreg result publishes caller-saved homes only through its
;; per-instruction plan. Const-hoist admission extends that plan into synthetic
;; assignments + intervals, so an overlapping %r9 scratch cannot also carry a
;; loop's magic constant. This is the reduced form of the Win64 self-host
;; corruption in string.int->string.
(define (compiler-backend-const-hoist-respects-scratch-plan-ok?) : bool
  (let
    [items : (__tl_dyn-array compiler_regalloc.CompilerRegScratchAssignment)
      (__tl_make-array compiler_regalloc.CompilerRegScratchAssignment 1)]
    [first : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [slots : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [_item : unit
      (set!
        (array-ref items 0)
        (compiler_regalloc.CompilerRegScratchAssignment
          (compiler_regalloc.CompilerRegScratchRequirement
            4
            0
            (compiler_regalloc.CompilerRegScratchRole.ScalarPrimary)
            (compiler_regalloc.CompilerRegScratchConstraint
              (compiler_regalloc.CompilerRegScratchClass.Gp)
              (compiler_regalloc.compiler-reg-id-seq-empty)
              (compiler_regalloc.compiler-reg-id-seq-empty)
              compiler_abi.compiler-reg-id-invalid)
            4
            8
            1)
          false
          false
          compiler_abi.compiler-reg-id-r9))]
    [scratch : compiler_regalloc.CompilerRegScratchPlan
      (compiler_regalloc.CompilerRegScratchPlan items first slots)]
    [base-assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r8))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    [base-intervals : compiler_regalloc.CompilerRegIntervalSeq
      (compiler_regalloc.compiler-reg-interval-seq-prepend
        (compiler_regalloc.CompilerRegInterval 0 0 10)
        (compiler_regalloc.compiler-reg-interval-seq-empty))]
    [vars : i64
      (compiler_backend.compiler-backend-scratch-plan-extend-vars scratch 1)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_backend.compiler-backend-scratch-plan-extend-assignments
        scratch
        1
        base-assignments)]
    [intervals : compiler_regalloc.CompilerRegIntervalSeq
      (compiler_backend.compiler-backend-scratch-plan-extend-intervals
        scratch
        1
        base-intervals)]
    (match (compiler_regalloc.compiler-reg-loop-split-first-register
      (compiler_backend.compiler-backend-const-hoist-candidate-regs
        (compiler_backend.CompilerBackendTarget.Windows))
      assignments
      (compiler_regalloc.compiler-reg-interval-index-build intervals vars)
      (compiler_regalloc.compiler-reg-loop-split-region-interval -1 4 8)
      -1)
      [(compiler_regalloc.CompilerRegMaybeId.Some reg)
        (= reg compiler_abi.compiler-reg-id-rbx)]
      [(compiler_regalloc.CompilerRegMaybeId.No) false])))

;; Regression for the opt1-built compiler crash exposed by
;; integration_spmd_gather_read/fill-lane-offset-gather. The reduced IR keeps
;; its entry guard -> non-phi preheader -> parameter-fed loop phi shape. A
;; previous scratch-arena function may leave a nonzero const-hoist count backed
;; by retired storage; shrink-wrap admission must reject that state until the
;; per-function preparation has established an empty table.
(define (compiler-backend-shrinkwrap-admission-state-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [stale-regs : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    (begin
      (compiler_backend.compiler-backend-function-scratch-fixture-set-const-hoist-site-count!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        1)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-const-hoist-site-regs!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        stale-regs)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-const-hoist-inject-count!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        1)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-const-hoist-frame-rbx!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        true)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-const-hoist-frame-count!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        1)
      (let
        [dirty-rejected? : bool
          (not
            (compiler_backend.compiler-backend-shrinkwrap-admission-state-clean?
              (compiler_backend.compiler-backend-state-function-state
                backend-state)))]
        [prepared? : bool
          (compiler_backend.compiler-backend-prepare-shrinkwrap-admission!
            (compiler_backend.compiler-backend-state-function-state
              backend-state))]
        [rewritten : compiler_ir_types.CompilerIrFunction
          (compiler_regalloc.compiler-reg-early-exit-shrinkwrap-function
            (compiler-backend-shrinkwrap-param-phi-fixture))]
        (and
          dirty-rejected?
          prepared?
          (compiler_backend.compiler-backend-shrinkwrap-admission-state-clean?
            (compiler_backend.compiler-backend-state-function-state
              backend-state))
          (not
            (compiler_backend.compiler-backend-callee-needs-save?
              backend-state
              (compiler_regalloc.compiler-reg-assignment-table-empty)
              compiler_abi.compiler-reg-id-rbx))
          (= compiler_regalloc.compiler-reg-early-exit-prefix-count 2)
          (match rewritten
            [(compiler_ir_types.CompilerIrFunction.Function _ _ _ _ blocks)
              (let
                [seq : compiler_ir_types.CompilerIrBlockSeq
                  (compiler_liveness.compiler-live-ir-block-list-to-seq blocks)]
                (and
                  (= (compiler_ir_types.compiler-ir-block-seq-count seq) 6)
                  (match (compiler_ir_types.compiler-ir-block-seq-ref seq 0)
                    [(compiler_ir_types.CompilerIrBlock.Block _ instrs)
                      (match (compiler_ir_types.compiler-ir-instr-seq-ref
                        instrs
                        1)
                        [(compiler_ir_types.CompilerIrInstr.Branch _ yes no)
                          (and
                            (=
                              yes
                              (compiler_ir_types.compiler-ir-label
                                "entry__shrinkwrap_save"))
                            (=
                              no
                              (compiler_ir_types.compiler-ir-label
                                "entry__shrinkwrap_bare0")))]
                        [_ false])])
                  (match (compiler_ir_types.compiler-ir-block-seq-ref seq 4)
                    [(compiler_ir_types.CompilerIrBlock.Block label instrs)
                      (and
                        (= label (compiler_ir_types.compiler-ir-label "loop"))
                        (match (compiler_ir_types.compiler-ir-instr-seq-ref
                          instrs
                          0)
                          [(compiler_ir_types.CompilerIrInstr.Phi _ inputs _)
                            (match (compiler_ir_types.compiler-ir-phi-input-list-force-cons
                              inputs)
                              [(compiler_ir_types.CompilerIrPhiInputList.Cons
                                  value
                                  input-label
                                  _)
                                (and
                                  (=
                                    input-label
                                    (compiler_ir_types.compiler-ir-label
                                      "preheader"))
                                  (match value
                                    [(compiler_ir_types.CompilerIrValue.Var id)
                                      (= id 0)]
                                    [_ false]))]
                              [(compiler_ir_types.CompilerIrPhiInputList.Array
                                  seq)
                                (compiler_ir_types.compiler-ir-phi-input-seq-entry-var-label?
                                  seq
                                  0
                                  0
                                  "preheader")]
                              [_ false])]
                          [_ false]))])))]))))))

;; Win64 passes the third integer argument in %r8. A non-imm32 guard used to
;; scavenge %r8 before the prologue and then return that clobbered register on
;; the bare path. Scratch-requiring prefixes must fail closed to the ordinary
;; always-framed function until prefix emission has a dedicated live-in-aware
;; scratch plan.
(define compiler-backend-shrinkwrap-large-guard-source : String
  "(extern (opaque [value : i64]) : i64 (:symbol \"opaque\"))
(define (guard-large [x : i64] [unused : i64] [bare-result : i64]) : i64
  (if (= x 4294967296)
    bare-result
    (guard-large (opaque x) unused bare-result)))
(define (main) : i64 (guard-large (opaque 1) 7 42))")

(define (compiler-backend-shrinkwrap-large-guard-win64-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (string.copy (& compiler-backend-shrinkwrap-large-guard-source))
    (compiler_backend.CompilerBackendTarget.Windows))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (let
        [body : String
          (compiler-backend-asm-function-body asm "_tl_guard_large")]
        (and
          (not (string.eq body ""))
          (compiler_backend.compiler-backend-string-contains? body "4294967296")
          (not
            (compiler_backend.compiler-backend-string-contains?
              body
              "__shrinkwrap"))))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-scavenge-occupancy-cache-ok?) : bool
  (let
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 5)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r9))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              compiler_abi.compiler-reg-id-r10))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.RegisterPair
                compiler_abi.compiler-reg-id-r11
                (compiler_abi.compiler-abi-xmm-register-id 2)))
            (compiler_regalloc.compiler-reg-assignments-prepend
              (compiler_regalloc.CompilerRegAssignment
                3
                (compiler_regalloc.CompilerRegLocation.Spill 0))
              (compiler_regalloc.compiler-reg-assignments-prepend
                (compiler_regalloc.CompilerRegAssignment
                  4
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-r9))
                (compiler_regalloc.compiler-reg-assignment-table-empty))))))]
    [assignment-index : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignment-table-with-min-capacity
        assignments
        5)]
    (begin
      (set! (array-ref starts 0) 0)
      (set! (array-ref ends 0) 2)
      (set! (array-ref starts 1) 3)
      (set! (array-ref ends 1) 5)
      (set! (array-ref starts 2) 4)
      (set! (array-ref ends 2) 7)
      (set! (array-ref starts 3) 0)
      (set! (array-ref ends 3) 8)
      (set! (array-ref starts 4) 2)
      (set! (array-ref ends 4) 6)
      (let
        [masks : (__tl_dyn-array i64)
          (compiler_backend.compiler-backend-scavenge-occupancy-build
            starts
            ends
            assignment-index
            5)]
        (and
          (= (array-length masks) 5)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            0)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            2)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            4)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            6)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            8)
          (=
            (array-ref masks 0)
            (compiler_backend.compiler-backend-scavenge-reg-bit "%r9"))
          (not
            (=
              (bit-and
                (array-ref masks 2)
                (compiler_backend.compiler-backend-scavenge-reg-bit "%r9"))
              0))
          (=
            (array-ref masks 3)
            (bit-or
              (compiler_backend.compiler-backend-scavenge-reg-bit "%r9")
              (bit-or
                (compiler_backend.compiler-backend-scavenge-reg-bit "%r11")
                (compiler_backend.compiler-backend-scavenge-reg-bit "%xmm2")))))))))

(define (compiler-backend-scavenge-loop-live-through-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.compiler-ir-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.I64 8)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Mov
              5
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Jump
                (compiler_ir_types.compiler-ir-label "header"))
              compiler_ir_types.CompilerIrInstrList.Nil)))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.compiler-ir-block
        (compiler_ir_types.compiler-ir-label "header")
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.BinOp
            2
            (compiler_ir_types.CompilerIrBinOp.Lt)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.Var 0)
            (compiler_ast_types.AstType.Bool))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.Var 2)
              (compiler_ir_types.compiler-ir-label "body")
              (compiler_ir_types.compiler-ir-label "exit"))
            compiler_ir_types.CompilerIrInstrList.Nil)))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "body")
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Gep
              3
              (compiler_ir_types.CompilerIrValue.Var 5)
              (compiler_ir_types.CompilerIrValue.Var 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Load
                4
                (compiler_ir_types.CompilerIrValue.Var 3)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Jump
                  (compiler_ir_types.compiler-ir-label "header"))
                compiler_ir_types.CompilerIrInstrList.Nil))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-block
            (compiler_ir_types.compiler-ir-label "exit")
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.BinOp
                6
                (compiler_ir_types.CompilerIrBinOp.Mul)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.CompilerIrValue.I64 8)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 6)))
                compiler_ir_types.CompilerIrInstrList.Nil)))
          compiler_ir_types.CompilerIrBlockList.Nil)))))

(define (compiler-backend-scavenge-loop-live-through-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [prev-starts : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-starts
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-ends : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-ends
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-assignment-index : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-assignments
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-plan-mask : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-plan-reg-mask
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-occupied-masks : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-occupied-masks
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-vars : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-vars
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [blocks : compiler_ir_types.CompilerIrBlockList
      (compiler-backend-scavenge-loop-live-through-blocks)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r8))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    (begin
      (compiler-backend-test-scavenge-install-ctx!
        "scavenge_loop_live_through"
        compiler_ir_types.CompilerIrParamList.Nil
        (compiler_ast_types.AstType.I64)
        7
        blocks
        assignments
        backend-state)
      (let
        [mask : i64
          (compiler_backend.compiler-backend-scavenge-occupied-mask-at-point
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            12)]
        [ok : bool
          (and
            (not
              (=
                (bit-and
                  mask
                  (compiler_backend.compiler-backend-scavenge-reg-bit "%r8"))
                0))
            (not
              (string.eq
                (compiler_backend.compiler-backend-scavenge-pick-with-mask
                  (compiler_backend.compiler-backend-state-function-state
                    backend-state)
                  mask
                  (compiler_backend.compiler-backend-one-exclude "%rax")
                  1
                  "%r8")
                "%r8")))]
        (begin
          (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            prev-starts
            prev-ends
            prev-assignment-index
            prev-plan-mask
            prev-occupied-masks
            prev-vars)
          ok)))))

;; #phi-staged-copy under a ROTATED loop. The blocks below are already in the
;; order a block layout pass emits when it rotates: the preheader jumps forward
;; into the header, and the LATCH (`lat`) sits ABOVE it, so the genuine back
;; edge `lat -> head` runs FORWARD in emission order. The obligation the staged
;; copy has to discharge on that edge -- "the staging register is free at the
;; TARGET block's entry" -- used to be asked only when `target <= point`, i.e.
;; only when the edge also ran backward in emission order. On this layout that
;; test reads the back edge as a forward edge, and a register holding a value
;; live into the header would lose its pushq/popq bracket.
;;
;; `v4` opens at the header's first instruction and is homed in %r8, so %r8 is
;; FREE across the staging window at the latch's edge point and OCCUPIED at the
;; header's entry point: exactly the split the emission-point comparison got
;; wrong.
(define (compiler-backend-phi-rotated-back-edge-blocks) : compiler_ir_types.CompilerIrBlockList
  (compiler_ir_types.compiler-ir-block-cons
    (compiler_ir_types.compiler-ir-block
      (compiler_ir_types.compiler-ir-label "entry")
      (compiler_ir_types.compiler-ir-instr-cons
        (compiler_ir_types.CompilerIrInstr.Mov
          0
          (compiler_ir_types.CompilerIrValue.I64 8)
          (compiler_ast_types.AstType.I64))
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.Mov
            1
            (compiler_ir_types.CompilerIrValue.I64 0)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "head"))
            compiler_ir_types.CompilerIrInstrList.Nil))))
    (compiler_ir_types.compiler-ir-block-cons
      (compiler_ir_types.compiler-ir-block
        (compiler_ir_types.compiler-ir-label "lat")
        (compiler_ir_types.compiler-ir-instr-cons
          (compiler_ir_types.CompilerIrInstr.BinOp
            3
            (compiler_ir_types.CompilerIrBinOp.Add)
            (compiler_ir_types.CompilerIrValue.Var 1)
            (compiler_ir_types.CompilerIrValue.I64 1)
            (compiler_ast_types.AstType.I64))
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Jump
              (compiler_ir_types.compiler-ir-label "head"))
            compiler_ir_types.CompilerIrInstrList.Nil)))
      (compiler_ir_types.compiler-ir-block-cons
        (compiler_ir_types.compiler-ir-block
          (compiler_ir_types.compiler-ir-label "sunk")
          (compiler_ir_types.compiler-ir-instr-cons
            (compiler_ir_types.CompilerIrInstr.Mov
              5
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.Mov
                6
                (compiler_ir_types.CompilerIrValue.I64 1)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Mov
                  7
                  (compiler_ir_types.CompilerIrValue.I64 1)
                  (compiler_ast_types.AstType.I64))
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.Mov
                    8
                    (compiler_ir_types.CompilerIrValue.I64 1)
                    (compiler_ast_types.AstType.I64))
                  (compiler_ir_types.compiler-ir-instr-cons
                    (compiler_ir_types.CompilerIrInstr.Mov
                      9
                      (compiler_ir_types.CompilerIrValue.I64 1)
                      (compiler_ast_types.AstType.I64))
                    (compiler_ir_types.compiler-ir-instr-cons
                      (compiler_ir_types.CompilerIrInstr.Mov
                        10
                        (compiler_ir_types.CompilerIrValue.I64 1)
                        (compiler_ast_types.AstType.I64))
                      (compiler_ir_types.compiler-ir-instr-cons
                        (compiler_ir_types.CompilerIrInstr.Mov
                          11
                          (compiler_ir_types.CompilerIrValue.I64 1)
                          (compiler_ast_types.AstType.I64))
                        (compiler_ir_types.compiler-ir-instr-cons
                          (compiler_ir_types.CompilerIrInstr.Jump
                            (compiler_ir_types.compiler-ir-label "exit"))
                          compiler_ir_types.CompilerIrInstrList.Nil)))))))))
        (compiler_ir_types.compiler-ir-block-cons
          (compiler_ir_types.compiler-ir-block
            (compiler_ir_types.compiler-ir-label "head")
            (compiler_ir_types.compiler-ir-instr-cons
              (compiler_ir_types.CompilerIrInstr.BinOp
                4
                (compiler_ir_types.CompilerIrBinOp.Mul)
                (compiler_ir_types.CompilerIrValue.Var 0)
                (compiler_ir_types.CompilerIrValue.I64 2)
                (compiler_ast_types.AstType.I64))
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.BinOp
                  2
                  (compiler_ir_types.CompilerIrBinOp.Lt)
                  (compiler_ir_types.CompilerIrValue.Var 4)
                  (compiler_ir_types.CompilerIrValue.Var 0)
                  (compiler_ast_types.AstType.Bool))
                (compiler_ir_types.compiler-ir-instr-cons
                  (compiler_ir_types.CompilerIrInstr.Branch
                    (compiler_ir_types.CompilerIrValue.Var 2)
                    (compiler_ir_types.compiler-ir-label "lat")
                    (compiler_ir_types.compiler-ir-label "sunk"))
                  compiler_ir_types.CompilerIrInstrList.Nil))))
          (compiler_ir_types.compiler-ir-block-cons
            (compiler_ir_types.compiler-ir-block
              (compiler_ir_types.compiler-ir-label "exit")
              (compiler_ir_types.compiler-ir-instr-cons
                (compiler_ir_types.CompilerIrInstr.Return
                  (compiler_ir_types.CompilerIrMaybeValue.Some
                    (compiler_ir_types.CompilerIrValue.Var 3)))
                compiler_ir_types.CompilerIrInstrList.Nil))
            compiler_ir_types.CompilerIrBlockList.Nil))))))

;; Model the occupancy gap of a rotated back edge directly: the %xmm2 family is
;; free at the latch emission point and occupied at the header entry even though
;; layout placed the semantic back edge forward in emitted order. A missing
;; target point is independently conservative.
(define (compiler-backend-phi-xmm-back-edge-gap-preserved-ok?) : bool
  (let
    [program-index : compiler_backend.CompilerBackendProgramIndex
      (compiler_backend.compiler-backend-program-index-build
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil)]
    [backend-state : compiler_backend.CompilerBackendState
      program-index.backend-state]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Spill -16))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Spill -24))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.Register
                (compiler_abi.compiler-abi-xmm-register-id 2)))
            (compiler_regalloc.compiler-reg-assignment-table-empty))))]
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 3)]
    [edge-point : i64 8]
    [target-point : i64 26]
    (begin
      (compiler_regalloc.compiler-reg-fill-i64-array starts -1)
      (compiler_regalloc.compiler-reg-fill-i64-array ends -1)
      (set! (array-ref starts 2) target-point)
      (set! (array-ref ends 2) target-point)
      (match (compiler_backend.compiler-backend-scavenge-assignments-build
        assignments
        3)
        [(compiler_backend.CompilerBackendScavengeAssignments
            assignment-index
            plan-mask)
          (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            starts
            ends
            assignment-index
            plan-mask
            (compiler_backend.compiler-backend-scavenge-occupancy-build
              starts
              ends
              assignment-index
              3)
            3)])
      (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
        backend-state
        4)
      (compiler_backend.compiler-backend-function-state-set-current-phi-target-point!
        backend-state
        target-point)
      (compiler_backend.compiler-backend-function-state-set-current-phi-dst-home-mask!
        backend-state
        0)
      (compiler_backend.compiler-backend-function-scratch-fixture-set-emergency-slot-offset!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        -128)
      (match (compiler_backend.compiler-backend-emit-phi-source-load-store
        (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
        assignments
        0
        (compiler_ir_types.CompilerIrValue.Var 1)
        (compiler_ast_types.AstType.F64)
        program-index
        backend-state)
        [(compiler_backend.ResultCompilerBackend.Ok back-edge)
          (let
            [back-edge-proven? : bool
              (compiler_backend.compiler-backend-phi-staged-copy-proven?
                backend-state
                "%xmm2")]
            (begin
              (compiler_backend.compiler-backend-function-state-set-current-phi-target-point!
                backend-state
                -1)
              (match (compiler_backend.compiler-backend-emit-phi-source-load-store
                (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
                assignments
                0
                (compiler_ir_types.CompilerIrValue.Var 1)
                (compiler_ast_types.AstType.F64)
                program-index
                backend-state)
                [(compiler_backend.ResultCompilerBackend.Ok unknown-edge)
                  (and
                    (=
                      (compiler_backend.compiler-backend-function-state-emission-point
                        (compiler_backend.compiler-backend-state-function-state
                          backend-state))
                      edge-point)
                    (not back-edge-proven?)
                    (not
                      (compiler_backend.compiler-backend-phi-staged-copy-proven?
                        backend-state
                        "%xmm2"))
                    (compiler-backend-phi-xmm-stage-bracket-shape?
                      back-edge
                      "    movdqu %xmm2, -128(%rbp)\n"
                      "    movdqu -128(%rbp), %xmm2\n")
                    (compiler-backend-phi-xmm-stage-bracket-shape?
                      unknown-edge
                      "    movdqu %xmm2, -128(%rbp)\n"
                      "    movdqu -128(%rbp), %xmm2\n"))]
                [(compiler_backend.ResultCompilerBackend.Err _) false])))]
        [(compiler_backend.ResultCompilerBackend.Err _) false]))))

(define (compiler-backend-phi-rotated-back-edge-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [prev-starts : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-starts
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-ends : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-ends
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-assignment-index : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-assignments
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-plan-mask : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-plan-reg-mask
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-occupied-masks : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-occupied-masks
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-vars : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-vars
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          4
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r8))
        (compiler_regalloc.compiler-reg-assignment-table-empty))]
    ;; entry is 3 instructions (0,1,2), `lat` is 2 (3,4), `sunk` is 8 (5..12)
    ;; and `head` opens at 13. So the latch's edge is emitted at instruction 4
    ;; -- point 8 -- and the header's entry is point 26: the back edge runs
    ;; FORWARD, and it runs forward by more than the staging window, which is
    ;; what leaves the point-local query alone with the question.
    [edge-point : i64 8]
    [target-point : i64 26]
    (begin
      (compiler-backend-test-scavenge-install-ctx!
        "phi_rotated_back_edge"
        compiler_ir_types.CompilerIrParamList.Nil
        (compiler_ast_types.AstType.I64)
        12
        (compiler-backend-phi-rotated-back-edge-blocks)
        assignments
        backend-state)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
        backend-state
        4)
      (compiler_backend.compiler-backend-function-state-set-current-phi-target-point!
        backend-state
        target-point)
      (compiler_backend.compiler-backend-function-state-set-current-phi-dst-home-mask!
        backend-state
        0)
      (let
        [function-state : compiler_backend.CompilerBackendFunctionState
          (compiler_backend.compiler-backend-state-function-state backend-state)]
        [r8 : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%r8")]
        [r10 : i64 (compiler_backend.compiler-backend-scavenge-reg-bit "%r10")]
        [ok : bool
          (and
            ;; the fixture really is the hazard shape ...
            (=
              (compiler_backend.compiler-backend-function-state-emission-point
                function-state)
              edge-point)
            (> target-point edge-point)
            (=
              (bit-and
                (compiler_backend.compiler-backend-scavenge-occupied-mask-over-range
                  function-state
                  edge-point
                  (+
                    edge-point
                    compiler_backend.compiler-backend-scavenge-staging-window))
                r8)
              0)
            (not
              (=
                (bit-and
                  (compiler_backend.compiler-backend-scavenge-occupied-mask-at-point
                    function-state
                    target-point)
                  r8)
                0))
            ;; ... and the bracket is KEPT on it, because the target-entry
            ;; obligation is asked on every edge and not just on the ones the
            ;; emitted order happens to run backwards.
            (not
              (compiler_backend.compiler-backend-phi-staged-copy-proven?
                backend-state
                "%r8"))
            ;; A register free at both ends still un-brackets, so this is a
            ;; sharper test than "the predicate says no".
            (=
              (bit-and
                (compiler_backend.compiler-backend-scavenge-occupied-mask-at-point
                  function-state
                  target-point)
                r10)
              0)
            (compiler_backend.compiler-backend-phi-staged-copy-proven?
              backend-state
              "%r10"))]
        (begin
          (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
            function-state
            prev-starts
            prev-ends
            prev-assignment-index
            prev-plan-mask
            prev-occupied-masks
            prev-vars)
          ok)))))

;; #5982. The constant-remainder expansion ends `subq product, SRC`, so electing
;; the dividend's own home as SRC needs the REGISTER free afterwards, not just
;; the VALUE dead. Model the miscompiled shape at point 10 with three vars
;; sharing %r13: the dividend definition dying exactly at 10, the loop-carried
;; home shared with the header phi spanning the loop, and this instruction's own
;; result opening at 11. The phi must veto own-SRC; the instruction's own output
;; must not.
(define (compiler-backend-divmod-live-dividend-ctx!
  [backend-state : compiler_backend.CompilerBackendState]
  [carried? : bool]) : unit
  (let
    [vars : i64 3]
    [starts : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    [ends : (__tl_dyn-array i64) (__tl_make-array i64 vars)]
    [assignments : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_regalloc.compiler-reg-assignments-prepend
        (compiler_regalloc.CompilerRegAssignment
          0
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-r13))
        (compiler_regalloc.compiler-reg-assignments-prepend
          (compiler_regalloc.CompilerRegAssignment
            1
            (compiler_regalloc.CompilerRegLocation.Register
              (if carried?
                compiler_abi.compiler-reg-id-r13
                compiler_abi.compiler-reg-id-r14)))
          (compiler_regalloc.compiler-reg-assignments-prepend
            (compiler_regalloc.CompilerRegAssignment
              2
              (compiler_regalloc.CompilerRegLocation.Register
                compiler_abi.compiler-reg-id-r13))
            (compiler_regalloc.compiler-reg-assignment-table-empty))))]
    (begin
      ;; var 0: the dividend definition -- dead after point 10
      (set! (array-ref starts 0) 9)
      (set! (array-ref ends 0) 10)
      ;; var 1: the loop-carried home (phi-shared) -- spans the whole region
      (set! (array-ref starts 1) 2)
      (set! (array-ref ends 1) 30)
      ;; var 2: this instruction's own result -- opens on the def half-step
      (set! (array-ref starts 2) 11)
      (set! (array-ref ends 2) 20)
      (compiler_backend.compiler-backend-set-scavenge-ctx-index!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        starts
        ends
        (compiler_regalloc.compiler-reg-assignment-table-with-min-capacity
          assignments
          vars)
        0
        vars))))

(define (compiler-backend-divmod-live-dividend-src-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [prev-starts : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-starts
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-ends : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-ends
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-assignment-index : compiler_regalloc.CompilerRegAssignmentTable
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-assignments
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-plan-mask : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-plan-reg-mask
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-occupied-masks : (__tl_dyn-array i64)
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-occupied-masks
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-vars : i64
      (compiler_backend.compiler-backend-function-scratch-fixture-get-scavenge-ctx-vars
        (compiler_backend.compiler-backend-state-function-state backend-state))]
    [prev-post-base : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-instr-post-base
        backend-state)]
    [prev-count : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emit-current-count
        backend-state)]
    ;; place the emission point at 10: 2 * (post-base - count)
    [_point : unit
      (begin
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
          backend-state
          5)
        (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
          backend-state
          0))]
    [_carried-ctx : unit
      (compiler-backend-divmod-live-dividend-ctx! backend-state true)]
    [carried : bool
      (compiler_backend.compiler-backend-divmod-home-carried-after?
        (compiler_backend.compiler-backend-state-function-state backend-state)
        "%r13"
        10)]
    ;; the value fact alone still reports the dividend dead here
    [value-dead : bool
      (not
        (compiler_backend.compiler-backend-value-live-after-here?
          backend-state
          (compiler_ir_types.CompilerIrValue.Var 0)))]
    ;; a remainder must refuse the home the phi still carries ...
    [remainder-refused : bool
      (not
        (compiler_backend.compiler-backend-divmod-src-home-safe?
          backend-state
          true
          "%r13"
          ""))]
    ;; ... a quotient never writes SRC, so it is unaffected ...
    [quotient-allowed : bool
      (compiler_backend.compiler-backend-divmod-src-home-safe?
        backend-state
        false
        "%r13"
        "")]
    ;; ... and a destination living in that same register is the result's own
    ;; home, so it stays eligible.
    [dst-home-allowed : bool
      (compiler_backend.compiler-backend-divmod-src-home-safe?
        backend-state
        true
        "%r13"
        "%r13")]
    ;; a register nothing is homed in is never carried
    [free-reg : bool
      (not
        (compiler_backend.compiler-backend-divmod-home-carried-after?
          (compiler_backend.compiler-backend-state-function-state backend-state)
          "%r15"
          10))]
    [_plain-ctx : unit
      (compiler-backend-divmod-live-dividend-ctx! backend-state false)]
    ;; without the phi only this instruction's own result remains, and a var
    ;; opening on the def half-step is what the expansion is producing
    [own-output-ok : bool
      (and
        (not
          (compiler_backend.compiler-backend-divmod-home-carried-after?
            (compiler_backend.compiler-backend-state-function-state
              backend-state)
            "%r13"
            10))
        (compiler_backend.compiler-backend-divmod-src-home-safe?
          backend-state
          true
          "%r13"
          ""))]
    (begin
      (compiler_backend.compiler-backend-set-scavenge-ctx-ready!
        (compiler_backend.compiler-backend-state-function-state backend-state)
        prev-starts
        prev-ends
        prev-assignment-index
        prev-plan-mask
        prev-occupied-masks
        prev-vars)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emit-instr-post-base!
        backend-state
        prev-post-base)
      (compiler_backend.compiler-backend-test-set-compiler-backend-emit-current-count!
        backend-state
        prev-count)
      (and
        carried
        value-dead
        remainder-refused
        quotient-allowed
        dst-home-allowed
        free-reg
        own-output-ok))))

(define (compiler-backend-param-spill-stack-scratch-preserves-home-ok?) : bool
  (let
    [params : compiler_ir_types.CompilerIrParamList
      (compiler_ir_types.compiler-ir-param-cons
