(define (compiler-backend-string-source) : String
  "(define greeting : String \"hi\")
(define (main) : String \"hi\")")

(define (compiler-backend-aggregate-source) : String
  "(defstruct Point (x i64) (y i64))
(defenum Shape (Nothing) (Circle i64) (Pair Point))
(define (make-point [x : i64] [y : i64]) : Point
  (Point x y))
(define (get-y [p : Point]) : i64
  p.y)
(define (make-none) : Shape
  Nothing)
(define (make-none-call) : Shape
  (Nothing))
(define (make-circle [r : i64]) : Shape
  (Circle r))
(define (make-pair [x : i64]) : Shape
  (Pair (Point x (+ x 1))))
(define (main) : i64
  (get-y (make-point 20 22)))")

(define (compiler-backend-enum-match-source) : String
  "(defenum Maybe (None) (Some i64))
(define (score [m : Maybe]) : i64
  (match m
    [None 0]
    [(Some v) v]))
(define (main) : i64
  (score (Some 42)))")

(define (compiler-backend-never-branch-register-group-source) : String
  "(extern (fail) : never)
(defenum Token (TInt i64) (TPlus) (TEnd))
(define (single [c : char]) : Token
  (if (= c '+')
    TPlus
    (begin
      (fail)
      TEnd)))
(define (main) : i64
  (match (single '+')
    [TPlus 42]
    [_ 0]))")

(define (compiler-backend-regalloc-source) : String
  "(define (calc [a : i64] [b : i64]) : i64
  (let
    [x : i64 (+ a b)]
    [y : i64 (* x 2)]
    (+ y x)))
(define (main) : i64
  (calc 10 5))")

(define (compiler-backend-callee-save-source) : String
  "(define (heavy
  [a : i64]
  [b : i64]
  [c : i64]
  [d : i64]
  [e : i64]
  [f : i64]) : i64
  (let
    [v0 : i64 (+ a 1)]
    [v1 : i64 (+ b 2)]
    [v2 : i64 (+ c 3)]
    [v3 : i64 (+ d 4)]
    [v4 : i64 (+ e 5)]
    [v5 : i64 (+ f 6)]
    (+ v0 (+ v1 (+ v2 (+ v3 (+ v4 v5)))))))
(define (main) : i64
  (heavy 1 2 3 4 5 6))")

(define (compiler-backend-regalloc-f64-source) : String
  "(define (main) : f64
  (let
    [a : f64 1.5]
    [b : f64 2.5]
    (+ a b)))")

(define (compiler-backend-smoke-function-symbol-ok? [asm : String]) : bool
  (or
    (compiler_backend.compiler-backend-string-contains? asm ".globl _tl_inc")
    (compiler_backend.compiler-backend-string-contains? asm ".globl _tl_f")))

(define (compiler-backend-smoke-function-call-ok? [asm : String]) : bool
  (or
    (compiler_backend.compiler-backend-string-contains? asm "    call _tl_inc")
    (compiler_backend.compiler-backend-string-contains? asm "    call _tl_f")))

(define (compiler-backend-call-or-jmp-ok? [asm : String] [symbol : String]) : bool
  (or
    (compiler_backend.compiler-backend-string-contains?
      asm
      (str_cat.str-cat "    call " symbol "\n"))
    (compiler_backend.compiler-backend-string-contains?
      asm
      (str_cat.str-cat "    jmp " symbol "\n"))))

(define (compiler-backend-asm-ok? [asm : String]) : bool
  (and
    (compiler_backend.backend-and8
      (compiler_backend.compiler-backend-string-contains? asm ".data\n")
      (compiler_backend.compiler-backend-string-contains? asm ".text\n")
      (compiler_backend.compiler-backend-string-contains?
        asm
        ".globl _tl_start\n")
      (compiler_backend.compiler-backend-string-contains? asm "_tl_start:\n")
      (compiler_backend.compiler-backend-string-contains? asm "main:\n")
      (compiler-backend-smoke-function-symbol-ok? asm)
      (or
        (compiler_backend.compiler-backend-string-contains? asm "_tl_inc")
        (compiler_backend.compiler-backend-string-contains? asm "_tl_f"))
      (compiler-backend-smoke-function-call-ok? asm))
    (compiler_backend.backend-and4
      (compiler_backend.compiler-backend-string-contains?
        asm
        "    jge .Lf1_while_exit.2\n")
      (compiler_backend.compiler-backend-string-contains?
        asm
        "    jle .Lf1_if_else.4\n")
      (compiler_backend.compiler-backend-string-contains?
        asm
        "    jmp .Lf1_while_header.0\n")
      true)))

(define (compiler-backend-alloc-generic-call-text [size : i64] [reg : String]) : String
  (str_cat.str-cat
    "    movq $"
    (string.int->string size)
    ", "
    reg
    "\n    call tl_alloc\n"
    ""))

(define (compiler-backend-alloc-fixed-call-text [size : i64]) : String
  (str_cat.str-cat "    call .L_tl_alloc" (string.int->string size) "\n"))

(define (compiler-backend-string-contains-inline-alloc-size?
  [asm : String]
  [size : i64]) : bool
  (if (compiler_backend.compiler-backend-fast-alloc-supported-size? size)
    (and
      (compiler_backend.compiler-backend-string-contains?
        asm
        (str_cat.str-cat "    leaq " (string.int->string size) "(%rax), "))
      (compiler_backend.compiler-backend-string-contains?
        asm
        (str_cat.str-cat
          "_slow:\n    call .L_tl_alloc"
          (string.int->string size)
          "\n")))
    false))

(define (compiler-backend-string-contains-alloc-size?
  [asm : String]
  [size : i64]) : bool
  (or
    (compiler_backend.compiler-backend-string-contains?
      asm
      (compiler-backend-alloc-generic-call-text size "%rdi"))
    (compiler_backend.compiler-backend-string-contains?
      asm
      (compiler-backend-alloc-generic-call-text size "%rcx"))
    (compiler_backend.compiler-backend-string-contains?
      asm
      (compiler-backend-alloc-fixed-call-text size))
    (compiler-backend-string-contains-inline-alloc-size? asm size)))

(define (compiler-backend-alloc-call-count [asm : String]) : i64
  (+
    (compiler_backend.compiler-backend-string-count asm "    call tl_alloc\n")
    (+
      (compiler_backend.compiler-backend-string-count
        asm
        "    call .L_tl_alloc8\n")
      (+
        (compiler_backend.compiler-backend-string-count
          asm
          "    call .L_tl_alloc16\n")
        (+
          (compiler_backend.compiler-backend-string-count
            asm
            "    call .L_tl_alloc24\n")
          (+
            (compiler_backend.compiler-backend-string-count
              asm
              "    call .L_tl_alloc32\n")
            (+
              (compiler_backend.compiler-backend-string-count
                asm
                "    call .L_tl_alloc40\n")
              (+
                (compiler_backend.compiler-backend-string-count
                  asm
                  "    call .L_tl_alloc48\n")
                (+
                  (compiler_backend.compiler-backend-string-count
                    asm
                    "    call .L_tl_alloc56\n")
                  (compiler_backend.compiler-backend-string-count
                    asm
                    "    call .L_tl_alloc64\n"))))))))))

(define (compiler-backend-source-ok? [src : String]) : bool
  (match (compiler_backend.compiler-backend-emit-source src)
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (compiler-backend-asm-ok? asm)]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-object-semantic-eligibility-ok?) : bool
  (let
    [backend-state : compiler_backend.CompilerBackendState
      (compiler_backend.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [empty-program : compiler_ir_types.CompilerIrProgram
      (compiler_ir_types.CompilerIrProgram.Program
        (compiler_ir_types.compiler-ir-global-seq-empty)
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil)]
    [runtime-globals : compiler_ir_types.CompilerIrGlobalSeq
      (let
        [builder : compiler_ir_types.CompilerIrGlobalBuilder
          (compiler_ir_types.compiler-ir-global-builder-with-capacity 1)]
        (begin
          (compiler_ir_types.compiler-ir-global-builder-push!
            (&mut builder)
            (compiler_ir_types.CompilerIrGlobal.Global
              1
              (compiler_ast_types.AstType.I64)
              (compiler_ir_types.CompilerIrValue.RuntimeGlobal 2)))
          (compiler_ir_types.compiler-ir-global-builder-to-seq builder)))]
    [runtime-global-program : compiler_ir_types.CompilerIrProgram
      (compiler_ir_types.CompilerIrProgram.Program
        runtime-globals
        compiler_ir_types.CompilerIrFunctionList.Nil
        compiler_ir_types.CompilerIrExternList.Nil)]
    (and
      (match (compiler_backend.compiler-backend-object-program-eligibility
        backend-state
        empty-program)
        [(compiler_backend.CompilerBackendObjectEligibility.Eligible) true]
        [(compiler_backend.CompilerBackendObjectEligibility.Unsupported _)
          false])
      (match (compiler_backend.compiler-backend-object-program-eligibility
        backend-state
        runtime-global-program)
        [(compiler_backend.CompilerBackendObjectEligibility.Eligible) false]
        [(compiler_backend.CompilerBackendObjectEligibility.Unsupported
            category)
          (string.eq
            category
            (compiler_backend.compiler-backend-object-unsupported-semantics-category))])
      (compiler_backend.backend-and8
        (compiler_backend.compiler-backend-object-semantic-value-supported?
          (compiler_ir_types.CompilerIrValue.I64 -2147483648))
        (compiler_backend.compiler-backend-object-semantic-value-supported?
          (compiler_ir_types.CompilerIrValue.I64 2147483647))
        (not
          (compiler_backend.compiler-backend-object-semantic-value-supported?
            (compiler_ir_types.CompilerIrValue.I64 2147483648)))
        (not
          (compiler_backend.compiler-backend-object-instr-semantically-supported?
            backend-state
            (compiler_ir_types.CompilerIrInstr.Branch
              (compiler_ir_types.CompilerIrValue.I64 0)
              1
              2)))
        (not
          (compiler_backend.compiler-backend-object-instr-semantically-supported?
            backend-state
            (compiler_ir_types.CompilerIrInstr.TailCall
              1
              compiler_ir_types.CompilerIrCallArgs.Nil
              (compiler_ast_types.AstType.I64))))
        (not
          (compiler_backend.compiler-backend-object-instr-semantically-supported?
            backend-state
            (compiler_ir_types.CompilerIrInstr.StorePtr
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.CompilerIrValue.I64 1)
              (compiler_ast_types.AstType.I64))))
        (not
          (compiler_backend.compiler-backend-object-instr-semantically-supported?
            backend-state
            (compiler_ir_types.CompilerIrInstr.CopyBytes
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.CompilerIrValue.I64 1)
              8)))
        (not
          (compiler_backend.compiler-backend-object-instr-semantically-supported?
            backend-state
            (compiler_ir_types.CompilerIrInstr.BoundsCheck
              (compiler_ir_types.CompilerIrValue.I64 0)
              (compiler_ir_types.CompilerIrValue.I64 1)
              0)))))))

(define (compiler-backend-object-image-source) : String
  "(extern (foreign-call [arg0 : i64]) : i64 (:abi c) (:symbol \"foreign_exact\"))
(extern (unused-foreign-call [arg0 : i64]) : i64 (:symbol \"unused_foreign_exact\"))
(extern unused-foreign-data (:symbol \"unused_foreign_data\") : i64)
(extern unused-foreign-fn (:symbol \"unused_foreign_fn\") : (-> i64 i64))
(extern foreign-data (:symbol \"foreign_data_exact\") : i64)
(extern foreign-fn (:symbol \"foreign_fn_exact\") : (-> i64 i64))
(define answer : i64 40)
(define greeting : String \"hi\")
(define pi : f64 3.5)
(define small : f32 2.5)
(define (inc [x : i64]) : i64 (+ x 1))
(define (float-ok) : i64
  (if (< pi 4.0) 1 0))
(define (float32-ok) : i64
  (if (< small 3.0) 1 0))
(define (main) : i64
  (let
    [items : (Array i64) (__tl_make-array i64 1)]
    (begin
      (set! (array-ref items 0) answer)
      (+
        foreign-data
        (+
          (foreign-fn 1)
          (+ (foreign-call (inc (array-ref items 0))) (+ (float-ok) (float32-ok))))))))")

(define (compiler-backend-coff-real-text-source) : String
  "(extern (foreign-call [arg0 : i64]) : i64 (:abi c) (:symbol \"foreign_exact\"))
(define answer : i64 40)
(define (inc [x : i64]) : i64 (+ x 1))
(define (main) : i64
  (+ (foreign-call (inc answer)) 1))")

(define (compiler-backend-object-image-shape-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source-object-image
    (compiler-backend-object-image-source))
    [(compiler_backend.ResultCompilerBackendObject.Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList image.sections]
        [symbols : cobj.CompilerObjectSymbolList image.symbols]
        [relocs : cobj.CompilerObjectRelocationList image.relocations]
        (and
          (cobj.compiler-object-image-dense? image)
          (compiler_backend.backend-and8
            (= (cobj.compiler-object-section-list-count sections) 4)
            (>
              (cobj.compiler-object-section-instr-count
                sections
                (cobj.CompilerObjectSectionKind.Text))
              0)
            (>
              (cobj.compiler-object-section-data-count
                sections
                (cobj.CompilerObjectSectionKind.Data))
              0)
            (>
              (cobj.compiler-object-section-data-count
                sections
                (cobj.CompilerObjectSectionKind.Rodata))
              0)
            (cobj.compiler-object-symbol-list-contains?
              symbols
              "_tl_start"
              (cobj.CompilerObjectSymbolBinding.Export)
              (cobj.CompilerObjectSymbolKind.Function))
            (cobj.compiler-object-symbol-list-contains?
              symbols
              "main"
              (cobj.CompilerObjectSymbolBinding.Export)
              (cobj.CompilerObjectSymbolKind.Function))
            (cobj.compiler-object-symbol-list-contains?
              symbols
              "_tl_inc"
              (cobj.CompilerObjectSymbolBinding.Export)
              (cobj.CompilerObjectSymbolKind.Function))
            (cobj.compiler-object-symbol-list-contains?
              symbols
              "foreign_exact"
              (cobj.CompilerObjectSymbolBinding.Extern)
              (cobj.CompilerObjectSymbolKind.Function)))
          (cobj.compiler-object-symbol-list-contains?
            symbols
            "foreign_data_exact"
            (cobj.CompilerObjectSymbolBinding.Extern)
            (cobj.CompilerObjectSymbolKind.Function))
          (cobj.compiler-object-symbol-list-contains?
            symbols
            "foreign_fn_exact"
            (cobj.CompilerObjectSymbolBinding.Extern)
            (cobj.CompilerObjectSymbolKind.Function))
          (cobj.compiler-object-symbol-list-contains?
            symbols
            "tl_alloc"
            (cobj.CompilerObjectSymbolBinding.Local)
            (cobj.CompilerObjectSymbolKind.Runtime))
          (cobj.compiler-object-symbol-list-contains?
            symbols
            "tl_tlci_call_image_entry"
            (cobj.CompilerObjectSymbolBinding.Local)
            (cobj.CompilerObjectSymbolKind.Runtime))
          (not
            (cobj.compiler-object-symbol-list-contains?
              symbols
              "tl_tlci_call_macro_entry"
              (cobj.CompilerObjectSymbolBinding.Local)
              (cobj.CompilerObjectSymbolKind.Runtime)))
          (not
            (cobj.compiler-object-symbol-list-contains?
              symbols
              "unused_foreign_exact"
              (cobj.CompilerObjectSymbolBinding.Extern)
              (cobj.CompilerObjectSymbolKind.Function)))
          (not
            (cobj.compiler-object-symbol-list-contains?
              symbols
              "unused_foreign_data"
              (cobj.CompilerObjectSymbolBinding.Extern)
              (cobj.CompilerObjectSymbolKind.Function)))
          (not
            (cobj.compiler-object-symbol-list-contains?
              symbols
              "unused_foreign_fn"
              (cobj.CompilerObjectSymbolBinding.Extern)
              (cobj.CompilerObjectSymbolKind.Function)))
          (compiler_backend.backend-and8
            (cobj.compiler-object-section-contains-label?
              sections
              (cobj.CompilerObjectSectionKind.Data)
              "_tl_answer")
            (cobj.compiler-object-section-contains-label?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              (compiler_backend.compiler-backend-string-data-label "hi"))
            (cobj.compiler-object-section-contains-label?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              (compiler_backend.compiler-backend-string-fat-label "hi"))
            (cobj.compiler-object-section-contains-string?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              "hi")
            (cobj.compiler-object-section-contains-align?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              8)
            (cobj.compiler-object-section-contains-i64?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              2)
            (cobj.compiler-object-section-contains-f64?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              (compiler-backend-test-f64-bits "4.0"))
            true)
          (cobj.compiler-object-section-contains-f32?
            sections
            (cobj.CompilerObjectSectionKind.Data)
            (compiler-backend-test-f32-bits "2.5"))
          (cobj.compiler-object-section-contains-f32?
            sections
            (cobj.CompilerObjectSectionKind.Rodata)
            (compiler-backend-test-f32-bits "3.0"))
          (compiler_backend.backend-and8
            (cobj.compiler-object-section-contains-call? sections "_tl_inc")
            (cobj.compiler-object-section-contains-call?
              sections
              "foreign_exact")
            (cobj.compiler-object-relocation-list-contains?
              relocs
              (cobj.CompilerObjectRelocationKind.Call)
              "_tl_inc")
            (cobj.compiler-object-relocation-list-contains?
              relocs
              (cobj.CompilerObjectRelocationKind.Call)
              "foreign_exact")
            (cobj.compiler-object-relocation-list-contains?
              relocs
              (cobj.CompilerObjectRelocationKind.Call)
              "tl_alloc")
            (cobj.compiler-object-section-contains-bytes?
              sections
              (object_target.compiler-backend-object-bytes-from-hex "554889e5"))
            (cobj.compiler-object-section-contains-bytes?
              sections
              (object_target.compiler-backend-object-bytes-from-hex "c9c3"))
            (cobj.compiler-object-section-contains-bytes?
              sections
              (object_linux.compiler-backend-object-exit-bytes)))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (object_linux.compiler-backend-object-tlci-entry-bytes))
          (not
            (cobj.compiler-object-section-contains-bytes?
              sections
              (object_linux.compiler-backend-object-tlci-macro-entry-bytes)))
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (cobj.CompilerObjectRelocationKind.Abs64)
            (compiler_backend.compiler-backend-string-data-label "hi"))
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (cobj.CompilerObjectRelocationKind.RipValue)
            "_tl_answer")
          (> (cobj.compiler-object-relocation-list-count relocs) 5)))]
    [(compiler_backend.ResultCompilerBackendObject.Err _) false]))

(define (compiler-backend-object-tlci-macro-entry-gate-ok?) : bool
  (let
    [expected : String
      (object_linux.compiler-backend-object-tlci-macro-entry-bytes)]
    [enabled : cobj.CompilerObjectX64InstrList
      (cobj.compiler-object-instr-builder-finish
        (__tl-project-field
          (object_target.compiler-backend-object-add-tlci-entry-runtime-text
            (object_target.compiler-backend-object-parts-empty)
            (object_linux.compiler-backend-object-tlci-entry-bytes)
            expected
            true)
          text))]
    [disabled : cobj.CompilerObjectX64InstrList
      (cobj.compiler-object-instr-builder-finish
        (__tl-project-field
          (object_target.compiler-backend-object-add-tlci-entry-runtime-text
            (object_target.compiler-backend-object-parts-empty)
            (object_linux.compiler-backend-object-tlci-entry-bytes)
            expected
            false)
          text))]
    (and
      (cobj.compiler-object-instr-list-contains-bytes? enabled expected)
      (not (cobj.compiler-object-instr-list-contains-bytes? disabled expected)))))

;; Let-bound if-merge whose phi destination differs from both inputs: the
;; object emitter must stage the edge values and copy them into the phi
;; destination slot before jumping to the merge (refs #5596; the tlci native
;; image path reads garbage otherwise). The call results keep the phi inputs
;; opaque so the merge is not folded away.
(define (compiler-backend-object-phi-edge-copy-source) : String
  "(extern (f [a : i64] [b : i64] [c : i64] [d : i64] [e : i64] [g : i64]) : i64 (:symbol \"f\"))
(define (chain [x : i64]) : i64
  (let [s0 : i64
    (let [q0 : i64 (f x 0 0 0 0 0)]
      (if (not (= q0 0)) q0 (f 0 0 0 0 0 0)))]
    (if (not (= s0 0)) s0 0)))
(define (main) : i64
  (chain 0))")

(define (compiler-backend-object-phi-edge-copy-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source-object-image-for-target
    (compiler-backend-object-phi-edge-copy-source)
    (compiler_backend.CompilerBackendTarget.Windows))
    [(compiler_backend.ResultCompilerBackendObject.Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList image.sections]
        (and
          (cobj.compiler-object-section-contains-bytes?
            sections
            (object_target.compiler-backend-object-bytes-from-hex "4883ec08"))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (object_target.compiler-backend-object-bytes-from-hex "4889442400"))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (object_target.compiler-backend-object-bytes-from-hex "488b442400"))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (object_target.compiler-backend-object-bytes-from-hex "4883c408"))))]
    [(compiler_backend.ResultCompilerBackendObject.Err _) false]))

(define (compiler-backend-pic-source) : String
  "(define greeting : String \"hi\")
(define (main) : i64
  (__tl_string_length greeting))")

(define (compiler-backend-pic-extern-source) : String
  "(extern (foreign-call [arg0 : i64]) : i64 (:abi c) (:symbol \"foreign_exact\"))
(define (main) : i64
  (foreign-call 1))")

(define (compiler-backend-pic-output-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source-pic-linux
    (compiler-backend-pic-source))
    [(compiler_backend.ResultCompilerBackendPic.Ok output)
      (let
        [asm : String output.asm]
        [fixups : String output.fixups]
        [data-label : String
          (compiler_backend.compiler-backend-string-data-label "hi")]
        [fat-label : String
          (compiler_backend.compiler-backend-string-fat-label "hi")]
        [base-label : String
          (string.copy
            (& compiler_backend.compiler-backend-pic-image-base-label))]
        (and
          (compiler_backend.backend-and8
            (compiler_backend.compiler-backend-string-contains?
              asm
              (str_cat.str-cat base-label ":\n" ""))
            (>=
              (compiler_backend.compiler-backend-string-count
                asm
                "    .quad 0\n")
              2)
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                (str_cat.str-cat " - " base-label "\n")))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                (compiler_backend.compiler-backend-pic-quad-pattern data-label)))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                (compiler_backend.compiler-backend-pic-quad-pattern fat-label)))
            (compiler_backend.compiler-backend-string-contains?
              fixups
              "typelisp-pic-fixups v1\n")
            (compiler_backend.compiler-backend-string-contains? fixups "data ")
            (compiler_backend.compiler-backend-string-contains?
              fixups
              "rodata "))
          (compiler_backend.compiler-backend-string-contains? fixups data-label)
          (compiler_backend.compiler-backend-string-contains? fixups fat-label)))]
    [(compiler_backend.ResultCompilerBackendPic.Err _) false]))

(define (compiler-backend-pic-extern-reject-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source-pic-linux
    (compiler-backend-pic-extern-source))
    [(compiler_backend.ResultCompilerBackendPic.Ok _) false]
    [(compiler_backend.ResultCompilerBackendPic.Err diag)
      (compiler_backend.compiler-backend-string-contains?
        (compiler_diagnostic.compiler-diagnostic-render (__tl-box-place diag))
        "backend: --pic supports only internal references")]))

(define (compiler-backend-pic-object-helper-ok?) : bool
  (and
    (=
      (compiler_backend.compiler-backend-pic-data-record-end-offset
        (cobj.CompilerObjectDataRecord.SymbolRva32 ".L_target")
        8)
      12)
    (string.eq
      (compiler_backend.compiler-backend-pic-section-name
        (cobj.CompilerObjectSectionKind.Pdata))
      "pdata")
    (string.eq
      (compiler_backend.compiler-backend-pic-section-name
        (cobj.CompilerObjectSectionKind.Xdata))
      "xdata")))

(define (compiler-backend-pic-ok?) : bool
  (and
    (compiler-backend-pic-output-ok?)
    (compiler-backend-pic-extern-reject-ok?)
    (compiler-backend-pic-object-helper-ok?)))

(define (compiler-backend-coff-renders-real-text-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source-object-image-for-target
    (compiler-backend-coff-real-text-source)
    (compiler_backend.CompilerBackendTarget.Windows))
    [(compiler_backend.ResultCompilerBackendObject.Ok image)
      (match (coff.compiler-object-coff-render image)
        [(coff.ResultCompilerObjectCoff.Ok obj)
          (let
            [text-header : i64
              (coff.compiler-object-coff-section-header-offset
                (cobj.CompilerObjectSectionKind.Text))]
            [text-size : i64
