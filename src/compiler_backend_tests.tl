(define (compiler-backend-switch-phi-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (ci.intern "main")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          2
          (ir.compiler-ir-blocks
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "entry")
              (compiler-backend-test-instr-seq-prepend
                (Switch
                  (Var 0)
                  0
                  (ir.compiler-ir-switch-case-seq2
                    (Case 0 (ir.compiler-ir-label "join"))
                    (Case 1 (ir.compiler-ir-label "join")))
                  (ir.compiler-ir-label "join"))
                (ir.compiler-ir-instr-seq-empty)))
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "join")
              (compiler-backend-test-instr-seq-prepend
                (Phi
                  1
                  (ir.compiler-ir-phi-input-seq-prepend
                    (I64 1)
                    (ir.compiler-ir-label "entry")
                    (& (ir.compiler-ir-phi-input-seq-empty)))
                  (I64))
                (compiler-backend-test-instr-seq-prepend
                  (Return (Some (Var 1)))
                  (ir.compiler-ir-instr-seq-empty)))))
          Ordinary))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-switch-phi-edge-copy-ok?) : bool
  (asm-ok?
    (backend.compiler-backend-emit-program-linux
      (compiler-backend-switch-phi-program))
    (has
      "    ja .Lf0_entry_switch_default\n"
      "    .balign 4\n.Lf0_entry_switch_table:\n"
      "    .long .Lf0_entry_switch_case_0\n"
      "    .long .Lf0_entry_switch_case_1\n"
      ".Lf0_entry_switch_case_0:\n"
      ".Lf0_entry_switch_case_1:\n"
      ".Lf0_entry_switch_default:\n"
      "    jmp .Lf0_join\n")))

;; --- negative dense-switch case keys (#6570) ---------------------------------
;;
;; A dense switch is built from whatever integers its arms carry, so its lowest
;; case may be below zero; the emitted dispatch then subtracts a negative base.
;; The per-case edge blocks a phi target needs spell the case VALUE into their
;; label, and `-` is an operator in the assembler's expression grammar, not a
;; symbol character: `.Lf0_entry_switch_case_-1:` is not read as a label at all.
;; GNU as sees a line starting with `.` and reports `unknown pseudo-op`.
;;
;; Base -1 with cases -1, 0, and 1 puts every relevant spelling in one
;; emission: the negative key must appear as `m1`, zero as `0`, and the
;; same-magnitude positive key as `1` so the signed mapping stays injective.
(define (compiler-backend-switch-negative-case-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (&
        (Function
          (ci.intern "main")
          (ir.compiler-ir-param-seq-empty)
          (I64)
          2
          (ir.compiler-ir-blocks
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "entry")
              (compiler-backend-test-instr-seq-prepend
                (Switch
                  (Var 0)
                  (- 0 1)
                  (ir.compiler-ir-switch-case-seq3
                    (Case (- 0 1) (ir.compiler-ir-label "join"))
                    (Case 0 (ir.compiler-ir-label "join"))
                    (Case 1 (ir.compiler-ir-label "join")))
                  (ir.compiler-ir-label "join"))
                (ir.compiler-ir-instr-seq-empty)))
            (ir.CompilerIrBlock.Block
              (ir.compiler-ir-label "join")
              (compiler-backend-test-instr-seq-prepend
                (Phi
                  1
                  (ir.compiler-ir-phi-input-seq-prepend
                    (I64 1)
                    (ir.compiler-ir-label "entry")
                    (& (ir.compiler-ir-phi-input-seq-empty)))
                  (I64))
                (compiler-backend-test-instr-seq-prepend
                  (Return (Some (Var 1)))
                  (ir.compiler-ir-instr-seq-empty)))))
          Ordinary))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-switch-negative-case-label-ok?) : bool
  (match (backend.compiler-backend-emit-program-linux
    (compiler-backend-switch-negative-case-program))
    [(Ok asm)
      (and
        (asm-has? asm ".Lf0_entry_switch_table:\n")
        ;; The negative key spells with `m`, in the table and at the block.
        (asm-has? asm "    .long .Lf0_entry_switch_case_m1\n")
        (asm-has? asm ".Lf0_entry_switch_case_m1:\n")
        ;; A non-negative key is spelled exactly as it always was.
        (asm-has? asm "    .long .Lf0_entry_switch_case_0\n")
        (asm-has? asm ".Lf0_entry_switch_case_0:\n")
        ;; Equal-magnitude signed keys remain distinct.
        (asm-has? asm "    .long .Lf0_entry_switch_case_1\n")
        (asm-has? asm ".Lf0_entry_switch_case_1:\n")
        ;; No `-` reaches a symbol name anywhere in the emission.
        (asm-lacks? asm "switch_case_-")
        (asm-has? asm "    jmp .Lf0_join\n"))]
    [(Err _) false]))

(define (compiler-backend-switch-object-image-ok?) : bool
  (match (be_object.compiler-backend-emit-program-object-image-linux
    (compiler-backend-switch-test-program)
    (ir.compiler-source-spans-empty))
    [(Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList
          (owned_view.compiler-owned-shared-view image.sections)]
        [symbols : cobj.CompilerObjectSymbolList
          (owned_view.compiler-owned-shared-view image.symbols)]
        [relocs : cobj.CompilerObjectRelocationList
          (owned_view.compiler-owned-shared-view image.relocations)]
        [table-label : String ".Lf0_entry_switch_table"]
        (and
          (elf.compiler-object-elf-image-supported? image)
          (not (coff.compiler-object-coff-image-supported? image))
          (match (be_object.compiler-backend-emit-program-object-image-target-with-mode-and-crt
            (compiler-backend-switch-test-program)
            (be_state.CompilerBackendTarget.Windows)
            (Scalar)
            (ir.compiler-source-spans-empty)
            true
            false)
            [(Ok windows-image)
              (coff.compiler-object-coff-image-supported? windows-image)]
            [(Err _) false])
          (cobj.compiler-object-symbol-list-contains?
            symbols
            table-label
            (Local)
            (Data))
          (cobj.compiler-object-section-contains-label?
            sections
            cobj.rodata-id
            table-label)
          (compiler-object-section-contains-align? sections cobj.rodata-id 8)
          (cobj.compiler-object-section-contains-label?
            sections
            cobj.rodata-id
            ".Lf0_entry_switch_table_entry_0")
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (RipAddress)
            table-label)
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (Branch)
            ".Lf0_other")
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (Abs64)
            ".Lf0_zero")
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (Abs64)
            ".Lf0_one")
          (cobj.compiler-object-relocation-list-contains?
            relocs
            (Abs64)
            ".Lf0_two")
          (cobj.compiler-object-section-contains-bytes?
            sections
            (& (be_object.compiler-backend-object-cmp-imm32-rax-bytes 2)))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (& (be_object.compiler-backend-object-switch-indirect-jump-bytes)))))]
    [(Err diag) false]))

(define (compiler-backend-switch-base-object-image-ok?) : bool
  (match (be_object.compiler-backend-emit-program-object-image-linux
    (compiler-backend-switch-base-test-program)
