(define (compiler-backend-int-return-binop-r8-live-asm) : ResultCompilerBackend
  (let
    [prev-starts : (Array i64) compiler-backend-scavenge-ctx-starts]
    [prev-ends : (Array i64) compiler-backend-scavenge-ctx-ends]
    [prev-assignment-index : CompilerRegAssignmentIndex
      compiler-backend-scavenge-ctx-assignment-index]
    [prev-plan-mask : i64 compiler-backend-scavenge-ctx-plan-reg-mask]
    [prev-occupied-masks : (Array i64)
      compiler-backend-scavenge-ctx-occupied-masks]
    [prev-vars : i64 compiler-backend-scavenge-ctx-vars]
    [prev-post-base : i64 compiler-backend-emit-instr-post-base]
    [prev-current-count : i64 compiler-backend-emit-current-count]
    [starts : (Array i64) (make-array i64 2)]
    [ends : (Array i64) (make-array i64 2)]
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r8"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
          CompilerRegAssignmentList.Nil))]
    [_ctx : unit
      (begin
        (array-set! starts 0 0)
        (array-set! starts 1 0)
        (array-set! ends 0 2)
        (array-set! ends 1 0)
        (compiler-backend-set-scavenge-ctx! starts ends assignments 2)
        (set! compiler-backend-emit-instr-post-base 1)
        (set! compiler-backend-emit-current-count 1))]
    [result : ResultCompilerBackend
      (compiler-backend-emit-binop-return
        (ci.intern "ret_int")
        CompilerIrBlockList.Nil
        CompilerRegVarTypeList.Nil
        (CompilerBackendGlobalTypeList.Nil)
        assignments
        2
        (CompilerIrBinOp.Add)
        (CompilerIrValue.I64 5)
        (CompilerIrValue.Var 1)
        (AstType.I64))]
    [_restore : unit
      (begin
        (compiler-backend-set-scavenge-ctx-ready!
          prev-starts
          prev-ends
          prev-assignment-index
          prev-plan-mask
          prev-occupied-masks
          prev-vars)
        (set! compiler-backend-emit-instr-post-base prev-post-base)
        (set! compiler-backend-emit-current-count prev-current-count))]
    result))

(define (compiler-backend-int-return-binop-r8-live-ok?) : bool
  (match (compiler-backend-int-return-binop-r8-live-asm)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    movq -16(%rbp), %r9\n")
        (compiler-backend-string-contains? asm "    addq %r9, %rax\n")
        (not (compiler-backend-string-contains? asm "%r8")))]
    [(ResultCompilerBackend.Err _) false]))

;; Backend-owned replacement for the Rust bool logic codegen checks:
;; `and`/`or` arrive from the lowerer as branches, not eager bytewise ops, and
;; bool equality still uses the comparison/setcc path.
(define (compiler-backend-bool-and-source) : String
  "(defmacro (and [args : bool ...]) : bool
  `(and-from (__and-args ,@args) 0))
(defmacro (and-from [carrier : Expr] [idx : Expr]) : bool
  (match idx
    [(ExprInt i)
      (match carrier
        [(ExprCall _ elems)
          (if (>= i (expr-list-length elems))
            (expr-bool true)
            `(if ,(expr-list-nth elems i)
               (and-from ,carrier ,(expr-int (+ i 1)))
               false))]
        [_ (expr-bool true)])]
    [_ (expr-bool true)]))
(define (f [a : bool] [b : bool]) : bool (and a b))")

(define (compiler-backend-bool-or-source) : String
  "(defmacro (or [args : bool ...]) : bool
  `(or-from (__or-args ,@args) 0))
(defmacro (or-from [carrier : Expr] [idx : Expr]) : bool
  (match idx
    [(ExprInt i)
      (match carrier
        [(ExprCall _ elems)
          (if (>= i (expr-list-length elems))
            (expr-bool false)
            `(if ,(expr-list-nth elems i)
               true
               (or-from ,carrier ,(expr-int (+ i 1)))))]
        [_ (expr-bool false)])]
    [_ (expr-bool false)]))
(define (f [a : bool] [b : bool]) : bool (or a b))")

(define (compiler-backend-bool-eq-source) : String
  "(define (f [a : bool] [b : bool]) : bool (= a b))")

(define (compiler-backend-bool-not-source) : String
  "(define (f [a : bool]) : bool (not a))")

(define (compiler-backend-negated-compare-branch-source) : String
  "(define (f [a : i64] [b : i64]) : i64
  (if (not (= a b)) 1 2))")

(define (compiler-backend-not-branch-source) : String
  "(define (f [a : bool]) : i64
  (if (not a) 1 2))")

(define (compiler-backend-multi-not-branch-source) : String
  "(defenum Items
  (Nil)
  (Cons i64 (Box Items)))
(define (contains [items : Items] [needle : i64]) : bool
  (if (< needle 0)
    (contains items (+ needle 1))
    (let
      [cursor : Items items]
      [found : bool false]
      (begin
        (while (not found)
          (match cursor
            [(Items.Nil) (return false)]
            [(Items.Cons head rest)
              (if (= head needle)
                (set! found true)
                (set! cursor (box-get rest)))]))
        true))))")

(define (compiler-backend-negated-compare-branch-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-negated-compare-branch-source))
    [(ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_f")]
        (and
          (not (string.eq body ""))
          (compiler-backend-string-contains? body "    cmpq ")
          (or
            (compiler-backend-string-contains? body "    je ")
            (compiler-backend-string-contains? body "    jne "))
          (not (compiler-backend-string-contains? body "    sete "))
          (not (compiler-backend-string-contains? body "    setne "))
          (not (compiler-backend-string-contains? body "    xorq $1, "))
          (not (compiler-backend-string-contains? body "    testq "))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-not-branch-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-not-branch-source))
    [(ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_f")]
        (and
          (not (string.eq body ""))
          (or
            (compiler-backend-string-contains? body "    cmpq $0, ")
            (compiler-backend-string-contains? body "    testq "))
          (or
            (compiler-backend-string-contains? body "    je ")
            (compiler-backend-string-contains? body "    jne "))
          (not (compiler-backend-string-contains? body "    xorq $1, "))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-multi-not-branch-ok?) : bool
  (match (compiler-backend-emit-source-opt2-for-target
    (compiler-backend-multi-not-branch-source)
    (CompilerBackendTarget.Linux))
    [(ResultCompilerBackend.Ok asm)
      (let
        [body : String (compiler-backend-asm-function-body asm "_tl_contains")]
        (and
          (not (string.eq body ""))
          (or
            (compiler-backend-string-contains? body "    cmpq $0, ")
            (compiler-backend-string-contains? body "    testq "))
          (not (compiler-backend-string-contains? body "    xorq $1, "))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-direct-condition-branch-ok?) : bool
  (match (compiler-backend-emit-branch
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
      CompilerRegAssignmentList.Nil)
    "bool_branch"
    (CompilerIrValue.Var 0)
    "yes"
    "no"
    (CompilerBackendMaybeLabel.No))
    [(ResultCompilerBackend.Ok reg-asm)
      (match (compiler-backend-emit-branch
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -24))
          CompilerRegAssignmentList.Nil)
        "bool_branch"
        (CompilerIrValue.Var 0)
        "yes"
        "no"
        (CompilerBackendMaybeLabel.No))
        [(ResultCompilerBackend.Ok spill-asm)
          (and
            (compiler-backend-string-contains? reg-asm "    testq %r12, %r12\n")
            (not
              (compiler-backend-string-contains?
                reg-asm
                "    movq %r12, %rax\n"))
            (compiler-backend-string-contains?
              spill-asm
              "    cmpq $0, -24(%rbp)\n")
            (not
              (compiler-backend-string-contains?
                spill-asm
                "    movq -24(%rbp), %rax\n")))]
        [(ResultCompilerBackend.Err _) false])]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-direct-compare-branch-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r13"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 2 (CompilerRegLocation.Spill -16))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-direct-compare-branch-ok?) : bool
  (let
    [assignments : CompilerRegAssignmentList
      (compiler-backend-direct-compare-branch-assignments)]
    (match (compiler-backend-emit-compare-branch
      assignments
      "cmp_branch"
      (CompilerIrBinOp.Lt)
      (CompilerIrValue.Var 0)
      (CompilerIrValue.I64 10)
      (AstType.I64)
      "yes"
      "no"
      (CompilerBackendMaybeLabel.No))
      [(ResultCompilerBackend.Ok reg-asm)
        (match (compiler-backend-emit-compare-branch
          assignments
          "cmp_branch"
          (CompilerIrBinOp.Ne)
          (CompilerIrValue.Var 2)
          (CompilerIrValue.Var 1)
          (AstType.I64)
          "yes"
          "no"
          (CompilerBackendMaybeLabel.No))
          [(ResultCompilerBackend.Ok stack-asm)
            (and
              (compiler-backend-string-contains? reg-asm "    cmpq $10, %r12\n")
              (not
                (compiler-backend-string-contains?
                  reg-asm
                  "    movq %r12, %rax\n"))
              (not (compiler-backend-string-contains? reg-asm "%rax"))
              (compiler-backend-string-contains?
                stack-asm
                "    cmpq %r13, -16(%rbp)\n")
              (not
                (compiler-backend-string-contains?
                  stack-asm
                  "    movq -16(%rbp), %rax\n"))
              (not (compiler-backend-string-contains? stack-asm "%rax")))]
          [(ResultCompilerBackend.Err _) false])]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-todo-marker) : String
  (string.append "# " "TODO"))

(define (compiler-backend-bool-control-flow-ok?) : bool
  (and
    (backend-and8
      (compiler-backend-source-contains?
        (compiler-backend-bool-and-source)
        "    je ")
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-and-source)
        "    andb ")
      (compiler-backend-source-contains?
        (compiler-backend-bool-or-source)
        "    je ")
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-or-source)
        "    orb ")
      (compiler-backend-source-contains?
        (compiler-backend-bool-eq-source)
        "    sete %al\n")
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-and-source)
        (compiler-backend-todo-marker))
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-or-source)
        (compiler-backend-todo-marker))
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-eq-source)
        (compiler-backend-todo-marker)))
    (backend-and4
      (compiler-backend-source-contains?
        (compiler-backend-bool-not-source)
        "    xorq $1, %r8\n")
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-not-source)
        "    xorq $1, %rax\n")
      (compiler-backend-source-not-contains?
        (compiler-backend-bool-not-source)
        "    testq %rax, %rax\n    sete %al\n    movzbl %al, %eax\n")
      (and
        (compiler-backend-source-not-contains?
          (compiler-backend-bool-not-source)
          (compiler-backend-todo-marker))
        (compiler-backend-direct-condition-branch-ok?)
        (compiler-backend-direct-compare-branch-ok?)
        (compiler-backend-negated-compare-branch-ok?)
        (compiler-backend-not-branch-ok?)
        (compiler-backend-multi-not-branch-ok?)))))

;; Backend-owned scalar instruction emit-shape coverage for stable wide integer
;; forms.
(define (compiler-backend-scalar-wide-source) : String
  "(define (xor64 [a : i64] [b : i64]) : i64 (bit-xor a b))
(define (shl64 [a : i64] [b : i64]) : i64 (shl a b))
(define (shr64 [a : i64] [b : i64]) : i64 (shr a b))")

(define (compiler-backend-scalar-wide-ops-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-scalar-wide-source))
    [(ResultCompilerBackend.Ok asm)
