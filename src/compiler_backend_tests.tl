      [compare-return : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (CompilerRegTargetAbi.Linux)
          "scratch_float_compare_return"
          (compiler-backend-scratch-vreg-float-compare-return-test-blocks)
          3
          f64-compare-types
          (compiler-backend-scratch-vreg-float-compare-return-test-assignments))]
      [compare-return-windows : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi-with-types
          (CompilerRegTargetAbi.Windows)
          "scratch_float_compare_return_windows"
          (compiler-backend-scratch-vreg-float-compare-return-test-blocks)
          3
          f64-compare-types
          (compiler-backend-scratch-vreg-float-compare-return-test-assignments))]
      [arith-reg : String (compiler-backend-scratch-test-register arith 0)]
      [compare-xmm : String (compiler-backend-scratch-test-register compare 0)]
      [compare-gp : String (compiler-backend-scratch-test-register compare 1)]
      [return-rhs : String
        (compiler-backend-scratch-test-register arith-return 1)]
      (and
        (= (compiler-backend-scratch-test-plan-count arith) 1)
        (= (compiler-backend-scratch-test-success-count arith) 1)
        (= (compiler-backend-scratch-test-plan-count arith-windows) 1)
        (= (compiler-backend-scratch-test-success-count arith-windows) 1)
        (>= (compiler-reg-xmm-family-index arith-reg) 0)
        (not (= (compiler-reg-xmm-family-index arith-reg) 6))
        (= (compiler-backend-scratch-test-plan-count compare) 2)
        (= (compiler-backend-scratch-test-success-count compare) 2)
        (= (compiler-backend-scratch-test-plan-count compare-windows) 2)
        (= (compiler-backend-scratch-test-success-count compare-windows) 2)
        (>= (compiler-reg-xmm-family-index compare-xmm) 0)
        (< (compiler-reg-xmm-family-index compare-gp) 0)
        (not (= (compiler-reg-xmm-family-index compare-xmm) 7))
        (= (compiler-backend-scratch-test-plan-count unop) 1)
        (= (compiler-backend-scratch-test-success-count unop) 1)
        (= (compiler-backend-scratch-test-plan-count arith-return) 2)
        (= (compiler-backend-scratch-test-success-count arith-return) 2)
        (= (compiler-backend-scratch-test-plan-count arith-return-windows) 2)
        (= (compiler-backend-scratch-test-success-count arith-return-windows) 2)
        (string.eq
          (compiler-backend-scratch-test-register arith-return 0)
          "%xmm0")
        (not (string.eq return-rhs "%xmm0"))
        (= (compiler-backend-scratch-test-plan-count compare-return) 2)
        (= (compiler-backend-scratch-test-success-count compare-return) 2)
        (= (compiler-backend-scratch-test-plan-count compare-return-windows) 2)
        (=
          (compiler-backend-scratch-test-success-count compare-return-windows)
          2)
        (string.eq
          (compiler-backend-scratch-test-register compare-return 0)
          "%rax")
        (>=
          (compiler-reg-xmm-family-index
            (compiler-backend-scratch-test-register compare-return 1))
          0)
        (=
          (compiler-reg-scratch-vreg-slots
            (CompilerRegTargetAbi.Linux)
            direct-arith-assignments
            f64-types
            (CompilerIrInstr.BinOp
              0
              (CompilerIrBinOp.Add)
              (CompilerIrValue.Var 1)
              (CompilerIrValue.Global (ci.intern "scratch_float_global"))
              (AstType.F64))
            CompilerRegStringList.Nil
            false)
          0)
        (=
          (compiler-reg-scratch-vreg-slots
            (CompilerRegTargetAbi.Windows)
            direct-compare-assignments
            f64-compare-types
            (CompilerIrInstr.BinOp
              0
              (CompilerIrBinOp.Ne)
              (CompilerIrValue.Var 1)
              (CompilerIrValue.Global (ci.intern "scratch_float_global"))
              (AstType.Bool))
            CompilerRegStringList.Nil
            false)
          0)
        (compiler-reg-scratch-compare-op? (CompilerIrBinOp.Eq))
        (compiler-reg-scratch-compare-op? (CompilerIrBinOp.Ne))
        (compiler-reg-scratch-compare-op? (CompilerIrBinOp.Lt))
        (compiler-reg-scratch-compare-op? (CompilerIrBinOp.Le))
        (compiler-reg-scratch-compare-op? (CompilerIrBinOp.Gt))
        (compiler-reg-scratch-compare-op? (CompilerIrBinOp.Ge))
        (match arith-return
          [(CompilerRegScratchPlanResult.Result _ plan)
            (let
              [requirement : CompilerRegScratchRequirement
                (struct-get (array-ref (struct-get plan items) 0) requirement)]
              (and
                (match (struct-get requirement role)
                  [(CompilerRegScratchRole.FloatReturnResultXmm) true]
                  [_ false])
                (string.eq
                  (struct-get (struct-get requirement constraint) fixed)
                  "%xmm0")
                (match (struct-get
                  (struct-get requirement constraint)
                  register-class)
                  [(CompilerRegScratchClass.Xmm) true]
                  [_ false])))])
        (match compare-return
          [(CompilerRegScratchPlanResult.Result _ plan)
            (let
              [requirement : CompilerRegScratchRequirement
                (struct-get (array-ref (struct-get plan items) 0) requirement)]
              (and
                (match (struct-get requirement role)
                  [(CompilerRegScratchRole.FloatReturnResultGp) true]
                  [_ false])
                (string.eq
                  (struct-get (struct-get requirement constraint) fixed)
                  "%rax")
                (match (struct-get
                  (struct-get requirement constraint)
                  register-class)
                  [(CompilerRegScratchClass.Gp) true]
                  [_ false])))])
        (match arith
          [(CompilerRegScratchPlanResult.Result _ plan)
            (match (struct-get
              (struct-get (array-ref (struct-get plan items) 0) requirement)
              role)
              [(CompilerRegScratchRole.FloatArithmeticResultXmm) true]
              [_ false])])
        (match compare
          [(CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(CompilerRegScratchRole.FloatCompareLhsXmm) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(CompilerRegScratchRole.FloatCompareResultGp) true]
                [_ false]))])
        (match unop
          [(CompilerRegScratchPlanResult.Result _ plan)
            (match (struct-get
              (struct-get (array-ref (struct-get plan items) 0) requirement)
              role)
              [(CompilerRegScratchRole.FloatUnaryResultXmm) true]
              [_ false])])))
    true))

(define (compiler-backend-scratch-vreg-float-compute-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [arith-assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-float-arith-test-assignments)]
      [compare-assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-float-compare-test-assignments)]
      [return-assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-float-arith-return-test-assignments)]
      (match (compiler-backend-emit-float-binop-spill-direct
        arith-assignments
        0
        (CompilerIrBinOp.Sub)
        (CompilerIrValue.Var 1)
        (CompilerIrValue.F64 0x4000000000000000)
        (AstType.F64)
        "%xmm14")
        [(ResultCompilerBackend.Ok arith)
          (match (compiler-backend-emit-binop-with-plan
            (compiler-backend-scratch-float-types
              (AstType.Bool)
              (AstType.F32)
              3)
            (CompilerBackendGlobalTypeList.Nil)
            compare-assignments
            0
            (CompilerIrBinOp.Ge)
            (CompilerIrValue.Var 1)
            (CompilerIrValue.Var 2)
            (AstType.Bool)
            "%xmm13"
            "%r14"
            ""
            ""
            "")
            [(ResultCompilerBackend.Ok compare)
              (match (compiler-backend-emit-unop-with-plan
                (compiler-backend-scratch-vreg-float-unop-test-assignments)
                0
                (CompilerIrUnOp.Neg)
                (CompilerIrValue.Var 1)
                (AstType.F64)
                "%xmm15")
                [(ResultCompilerBackend.Ok unop)
                  (match (compiler-backend-emit-float-arith-return
                    return-assignments
                    (CompilerIrBinOp.Sub)
                    (CompilerIrValue.Var 1)
                    (CompilerIrValue.Var 2)
                    (AstType.F64)
                    "%xmm0"
                    "%xmm14"
                    "    ret\n")
                    [(ResultCompilerBackend.Ok arith-return)
                      (match (compiler-backend-emit-float-compare-return
                        (compiler-backend-scratch-vreg-float-compare-return-test-assignments)
                        (CompilerIrBinOp.Lt)
                        (CompilerIrValue.Var 1)
                        (CompilerIrValue.Var 2)
                        (AstType.F64)
                        "%rax"
                        "%xmm14"
                        "%xmm15"
                        "    ret\n")
                        [(ResultCompilerBackend.Ok compare-return)
                          (and
                            (compiler-backend-string-contains? arith "%xmm14")
                            (compiler-backend-string-contains? compare "%xmm13")
                            (compiler-backend-string-contains? compare "%r14")
                            (compiler-backend-string-contains? unop "%xmm15")
                            (compiler-backend-string-contains?
                              arith-return
                              "%xmm14")
                            (compiler-backend-string-contains?
                              arith-return
                              "%xmm0")
                            (compiler-backend-string-contains?
                              compare-return
                              "%xmm14")
                            (compiler-backend-string-contains?
                              compare-return
                              "%rax"))]
                        [(ResultCompilerBackend.Err _) false])]
                    [(ResultCompilerBackend.Err _) false])]
                [(ResultCompilerBackend.Err _) false])]
            [(ResultCompilerBackend.Err _) false])]
        [(ResultCompilerBackend.Err _) false]))
    true))

(define (compiler-backend-scratch-vreg-tail-target-avoids-callee-saved-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [result : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_tail_target"
          (compiler-backend-scratch-vreg-tail-target-test-blocks)
          3
          (compiler-backend-scratch-vreg-tail-target-test-assignments))]
      (and
        ;; The stable slot remains present but has an explicit empty assignment,
        ;; so emission falls back instead of using a restored callee-saved home.
        (= (compiler-backend-scratch-test-plan-count result) 2)
        (= (compiler-backend-scratch-test-success-count result) 0)
        (string.eq (compiler-backend-scratch-test-register result 0) "")))
    true))

(define (compiler-backend-scratch-vreg-simd-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [splat-blocks : CompilerIrBlockList
        (compiler-backend-scratch-vreg-splat-test-blocks)]
      [splat : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_splat"
          splat-blocks
          2
          (compiler-backend-scratch-vreg-splat-test-assignments))]
      [splat-dense : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_splat_dense"
          (compiler-ir-block-list-compact splat-blocks)
          2
          (compiler-backend-scratch-vreg-splat-test-assignments))]
      [reduce-blocks : CompilerIrBlockList
        (compiler-backend-scratch-vreg-reduce-test-blocks)]
      [reduce : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_reduce"
          reduce-blocks
          2
          (compiler-backend-scratch-vreg-reduce-test-assignments))]
      [reduce-dense : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_reduce_dense"
          (compiler-ir-block-list-compact reduce-blocks)
          2
          (compiler-backend-scratch-vreg-reduce-test-assignments))]
      [prefix-blocks : CompilerIrBlockList
        (compiler-backend-scratch-vreg-prefix-test-blocks)]
      [prefix : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_prefix"
          prefix-blocks
          3
          (compiler-backend-scratch-vreg-prefix-test-assignments))]
      [prefix-dense : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_prefix_dense"
          (compiler-ir-block-list-compact prefix-blocks)
          3
          (compiler-backend-scratch-vreg-prefix-test-assignments))]
      [splat-gp : String (compiler-backend-scratch-test-register splat 0)]
      [splat-xmm : String (compiler-backend-scratch-test-register splat 1)]
      [reduce-acc : String (compiler-backend-scratch-test-register reduce 0)]
      [reduce-temp : String (compiler-backend-scratch-test-register reduce 1)]
      [prefix-gp : String (compiler-backend-scratch-test-register prefix 0)]
      [prefix-xmm : String (compiler-backend-scratch-test-register prefix 1)]
      (and
        (= (compiler-backend-scratch-test-plan-count splat) 2)
        (= (compiler-backend-scratch-test-success-count splat) 2)
        (not (string.eq splat-gp ""))
        (not (string.eq splat-xmm ""))
        (not (string.eq splat-gp "%r8"))
        (not (= (compiler-reg-xmm-family-index splat-xmm) 6))
        (string.eq
          splat-gp
          (compiler-backend-scratch-test-register splat-dense 0))
        (string.eq
          splat-xmm
          (compiler-backend-scratch-test-register splat-dense 1))
        (= (compiler-backend-scratch-test-plan-count reduce) 2)
        (= (compiler-backend-scratch-test-success-count reduce) 2)
        (not (string.eq reduce-acc ""))
        (not (string.eq reduce-temp ""))
        (not (string.eq reduce-acc reduce-temp))
        (not (= (compiler-reg-xmm-family-index reduce-acc) 2))
        (not (= (compiler-reg-xmm-family-index reduce-acc) 6))
        (not (= (compiler-reg-xmm-family-index reduce-temp) 2))
        (not (= (compiler-reg-xmm-family-index reduce-temp) 6))
        (string.eq
          reduce-acc
          (compiler-backend-scratch-test-register reduce-dense 0))
        (string.eq
          reduce-temp
          (compiler-backend-scratch-test-register reduce-dense 1))
        (= (compiler-backend-scratch-test-plan-count prefix) 2)
        (= (compiler-backend-scratch-test-success-count prefix) 2)
        (not (string.eq prefix-gp ""))
        (not (string.eq prefix-xmm ""))
        (not (string.eq prefix-gp "%r8"))
        (not (= (compiler-reg-xmm-family-index prefix-xmm) 6))
        (string.eq
          prefix-gp
          (compiler-backend-scratch-test-register prefix-dense 0))
        (string.eq
          prefix-xmm
          (compiler-backend-scratch-test-register prefix-dense 1))
        (match splat
          [(CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(CompilerRegScratchRole.SplatValueGp) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(CompilerRegScratchRole.SplatValueXmm) true]
                [_ false]))])
        (match reduce
          [(CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(CompilerRegScratchRole.VectorReduceAccumulator) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(CompilerRegScratchRole.VectorReduceScratch) true]
                [_ false]))])
        (match prefix
          [(CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(CompilerRegScratchRole.VectorPrefixCarry) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(CompilerRegScratchRole.VectorPrefixValue) true]
                [_ false]))])))
    true))

(define (compiler-backend-scratch-vreg-simd-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [splat-assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            0
            (CompilerRegLocation.Register "%r12"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              1
              (CompilerRegLocation.Register "%vec6"))
            CompilerRegAssignmentList.Nil))]
      [reduce-assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            0
            (CompilerRegLocation.Register "%vec6"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
            CompilerRegAssignmentList.Nil))]
      [diag : CompilerDiagnostic (compiler-diagnostic-at-start "" "")]
      (match (compiler-backend-emit-vector-splat
        splat-assignments
        1
        (CompilerIrValue.Var 0)
        4
        (AstType.I64)
        "%r14"
        "%xmm14"
        diag)
        [(ResultCompilerBackend.Ok splat)
          (match (compiler-backend-emit-vector-reduce
            reduce-assignments
            1
            (CompilerIrVectorReduceOp.Sum)
            (CompilerIrValue.Var 0)
            4
            (AstType.I64)
            "%xmm14"
            "%xmm15"
            diag)
            [(ResultCompilerBackend.Ok avx2)
              (match (compiler-backend-emit-vector-reduce
                reduce-assignments
                1
                (CompilerIrVectorReduceOp.Sum)
                (CompilerIrValue.Var 0)
                8
                (AstType.I64)
                "%xmm14"
                "%xmm15"
                diag)
                [(ResultCompilerBackend.Ok avx512)
                  (and
                    (compiler-backend-string-contains? splat "%r14")
                    (compiler-backend-string-contains? splat "%xmm14")
                    (compiler-backend-string-contains? avx2 "%xmm14")
                    (compiler-backend-string-contains? avx2 "%xmm15")
                    (compiler-backend-string-contains? avx512 "%xmm14")
                    (compiler-backend-string-contains? avx512 "%xmm15"))]
                [(ResultCompilerBackend.Err _) false])]
            [(ResultCompilerBackend.Err _) false])]
        [(ResultCompilerBackend.Err _) false]))
    true))

(define (compiler-backend-scratch-vreg-conversion-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [cast-blocks : CompilerIrBlockList
        (compiler-backend-scratch-vreg-cast-test-blocks)]
      [cast : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_cast"
          cast-blocks
          2
          (compiler-backend-scratch-vreg-cast-test-assignments))]
      [cast-dense : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_cast_dense"
          (compiler-ir-block-list-compact cast-blocks)
          2
          (compiler-backend-scratch-vreg-cast-test-assignments))]
      [cast-windows : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result-for-abi
          (CompilerRegTargetAbi.Windows)
          "scratch_vreg_float_cast_windows"
          cast-blocks
          2
          (compiler-backend-scratch-vreg-cast-test-assignments))]
      [gp-only : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_cast_gp_only"
          (compiler-backend-scratch-vreg-cast-gp-only-test-blocks)
          2
          (compiler-backend-scratch-vreg-cast-gp-only-test-assignments))]
      [bitcast-blocks : CompilerIrBlockList
        (compiler-backend-scratch-vreg-bitcast-test-blocks)]
      [bitcast : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_bitcast"
          bitcast-blocks
          2
          (compiler-backend-scratch-vreg-bitcast-test-assignments))]
      [bitcast-dense : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_bitcast_dense"
          (compiler-ir-block-list-compact bitcast-blocks)
          2
          (compiler-backend-scratch-vreg-bitcast-test-assignments))]
      [mov : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_float_mov"
          (compiler-backend-scratch-vreg-float-mov-test-blocks)
          2
          (compiler-backend-scratch-vreg-float-mov-test-assignments))]
      [cast-xmm : String (compiler-backend-scratch-test-register cast 0)]
      [cast-gp0 : String (compiler-backend-scratch-test-register cast 1)]
      [cast-gp1 : String (compiler-backend-scratch-test-register cast 2)]
      [cast-win-xmm : String
        (compiler-backend-scratch-test-register cast-windows 0)]
      [cast-win-gp0 : String
        (compiler-backend-scratch-test-register cast-windows 1)]
      [cast-win-gp1 : String
        (compiler-backend-scratch-test-register cast-windows 2)]
      [gp-only-reg : String (compiler-backend-scratch-test-register gp-only 0)]
      [bitcast-xmm : String (compiler-backend-scratch-test-register bitcast 0)]
      [bitcast-gp : String (compiler-backend-scratch-test-register bitcast 1)]
      [mov-xmm : String (compiler-backend-scratch-test-register mov 0)]
      [same-home : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -8))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -8))
            CompilerRegAssignmentList.Nil))]
      (and
        (= (compiler-backend-scratch-test-plan-count cast) 3)
        (= (compiler-backend-scratch-test-success-count cast) 3)
        (>= (compiler-reg-xmm-family-index cast-xmm) 0)
        (not (string.eq cast-gp0 ""))
        (not (string.eq cast-gp1 ""))
        (not (string.eq cast-gp0 cast-gp1))
        (not (string.eq cast-gp0 "%r12"))
        (not (string.eq cast-gp1 "%r12"))
        (string.eq
          cast-xmm
          (compiler-backend-scratch-test-register cast-dense 0))
        (string.eq
          cast-gp0
          (compiler-backend-scratch-test-register cast-dense 1))
        (string.eq
          cast-gp1
          (compiler-backend-scratch-test-register cast-dense 2))
        (= (compiler-backend-scratch-test-plan-count cast-windows) 3)
        (= (compiler-backend-scratch-test-success-count cast-windows) 3)
        (>= (compiler-reg-xmm-family-index cast-win-xmm) 0)
        (not (string.eq cast-win-gp0 ""))
        (not (string.eq cast-win-gp1 ""))
        (not (string.eq cast-win-gp0 cast-win-gp1))
        (not (string.eq cast-win-gp0 "%r12"))
        (not (string.eq cast-win-gp1 "%r12"))
        (= (compiler-backend-scratch-test-plan-count gp-only) 1)
        (= (compiler-backend-scratch-test-success-count gp-only) 1)
        (not (string.eq gp-only-reg ""))
        (< (compiler-reg-xmm-family-index gp-only-reg) 0)
        (= (compiler-backend-scratch-test-plan-count bitcast) 2)
        (= (compiler-backend-scratch-test-success-count bitcast) 2)
        (>= (compiler-reg-xmm-family-index bitcast-xmm) 0)
        (not (string.eq bitcast-gp ""))
        (< (compiler-reg-xmm-family-index bitcast-gp) 0)
        (string.eq
          bitcast-xmm
          (compiler-backend-scratch-test-register bitcast-dense 0))
        (string.eq
          bitcast-gp
          (compiler-backend-scratch-test-register bitcast-dense 1))
        (= (compiler-backend-scratch-test-plan-count mov) 1)
        (= (compiler-backend-scratch-test-success-count mov) 1)
        (>= (compiler-reg-xmm-family-index mov-xmm) 0)
        (not (= (compiler-reg-xmm-family-index mov-xmm) 6))
        (=
          (compiler-reg-scratch-cast-slot-count
            same-home
            1
            (CompilerIrValue.Var 0)
            (AstType.F64)
            (AstType.F64))
          0)
        (=
          (compiler-reg-scratch-vreg-slots
            (CompilerRegTargetAbi.Linux)
            same-home
            CompilerRegVarTypeList.Nil
            (CompilerIrInstr.Mov 1 (CompilerIrValue.Var 0) (AstType.F64))
            CompilerRegStringList.Nil
            false)
          0)
        (match cast
          [(CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(CompilerRegScratchRole.FloatCastValueXmm) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(CompilerRegScratchRole.FloatCastValueGp) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 2) requirement)
                role)
                [(CompilerRegScratchRole.FloatCastScratchGp) true]
                [_ false]))])
        (match gp-only
          [(CompilerRegScratchPlanResult.Result _ plan)
            (match (struct-get
              (struct-get (array-ref (struct-get plan items) 0) requirement)
              role)
              [(CompilerRegScratchRole.FloatCastValueGp) true]
              [_ false])])
        (match bitcast
          [(CompilerRegScratchPlanResult.Result _ plan)
            (and
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                role)
                [(CompilerRegScratchRole.FloatBitcastValueXmm) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref (struct-get plan items) 1) requirement)
                role)
                [(CompilerRegScratchRole.FloatBitcastValueGp) true]
                [_ false]))])
        (match mov
          [(CompilerRegScratchPlanResult.Result _ plan)
            (match (struct-get
              (struct-get (array-ref (struct-get plan items) 0) requirement)
              role)
              [(CompilerRegScratchRole.FloatMoveValueXmm) true]
              [_ false])])))
    true))

(define (compiler-backend-scratch-vreg-conversion-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [index : CompilerBackendProgramIndex
        (compiler-backend-program-index-build
          CompilerIrFunctionList.Nil
          CompilerIrExternList.Nil)]
      [cast-assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-cast-test-assignments)]
      [gp-only-assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-cast-gp-only-test-assignments)]
      [bitcast-assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-bitcast-test-assignments)]
      [mov-assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-float-mov-test-assignments)]
      (match (compiler-backend-emit-cast
        "test_cast"
        "entry"
        cast-assignments
        1
        (CompilerIrValue.Var 0)
        (AstType.U64)
        (AstType.F64)
        index
        "%xmm14"
        "%r14"
        "%r15")
        [(ResultCompilerBackend.Ok cast-asm)
          (match (compiler-backend-emit-cast
            "test_cast_gp"
            "entry"
            gp-only-assignments
            1
            (CompilerIrValue.Var 0)
            (AstType.I64)
            (AstType.F64)
            index
            "%r14"
            ""
            "")
            [(ResultCompilerBackend.Ok gp-only-asm)
              (match (compiler-backend-emit-bitcast
                bitcast-assignments
                1
                (CompilerIrValue.Var 0)
                (AstType.F64)
                (AstType.U64)
                index
                "%xmm14"
                "%r14")
                [(ResultCompilerBackend.Ok bitcast-asm)
                  (match (compiler-backend-emit-mov
                    mov-assignments
                    1
                    (CompilerIrValue.Var 0)
                    (AstType.F64)
                    index
                    2
                    "%xmm14")
                    [(ResultCompilerBackend.Ok mov-asm)
                      (and
                        (compiler-backend-string-contains? cast-asm "%xmm14")
                        (compiler-backend-string-contains? cast-asm "%r14")
                        (compiler-backend-string-contains? cast-asm "%r15")
                        (compiler-backend-string-contains? gp-only-asm "%r14")
                        (compiler-backend-string-contains? gp-only-asm "%xmm6")
                        (not
                          (compiler-backend-string-contains?
                            gp-only-asm
                            "%xmm14"))
                        (compiler-backend-string-contains? bitcast-asm "%xmm14")
                        (compiler-backend-string-contains? bitcast-asm "%r14")
                        (compiler-backend-string-contains? mov-asm "%xmm14"))]
                    [(ResultCompilerBackend.Err _) false])]
                [(ResultCompilerBackend.Err _) false])]
            [(ResultCompilerBackend.Err _) false])]
        [(ResultCompilerBackend.Err _) false]))
    true))

(define (compiler-backend-scratch-vreg-incomplete-group-fallback-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [items : (Array CompilerRegScratchAssignment)
        (array.make-array CompilerRegScratchAssignment 2)]
      [starts : (Array i64) (array.make-array i64 2)]
      [ends : (Array i64) (array.make-array i64 2)]
      [segments : (Array CompilerRegIntervalList)
        (array.make-array CompilerRegIntervalList 2)]
      [present : (Array i64) (array.make-array i64 2)]
      [types : (Array AstType) (array.make-array AstType 2)]
      [assignments : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-make 2)]
      [ref-counts : (Array i64) (array.make-array i64 2)]
      [fixed-rcx : CompilerRegScratchConstraint
        (CompilerRegScratchConstraint
          (CompilerRegScratchClass.Gp)
          CompilerRegStringList.Nil
          CompilerRegStringList.Nil
          "%rcx")]
      (begin
        (compiler-reg-fill-i64-array starts -1)
        (compiler-reg-fill-i64-array ends -1)
        (compiler-reg-fill-i64-array present 0)
        (compiler-reg-fill-i64-array ref-counts 0)
        (compiler-reg-fill-interval-list-array! segments 0)
        (array-set!
          items
          0
          (CompilerRegScratchAssignment
            (CompilerRegScratchRequirement
              0
              0
              (CompilerRegScratchRole.MemoryAddress)
              fixed-rcx
              0
              3
              0)
            ""))
        (array-set!
          items
          1
          (CompilerRegScratchAssignment
            (CompilerRegScratchRequirement
              2
              0
              (CompilerRegScratchRole.MemoryAddress)
              fixed-rcx
              0
              3
              1)
            ""))
        (compiler-reg-scratch-mark-requirement!
          starts
          ends
          segments
          present
          types
          (struct-get (array-ref items 0) requirement))
        (compiler-reg-scratch-mark-requirement!
          starts
          ends
          segments
          present
          types
          (struct-get (array-ref items 1) requirement))
        (compiler-reg-scratch-assign-items!
          (CompilerRegTargetAbi.Linux)
          items
          0
          assignments
          (CompilerRegIntervalIndex starts ends segments)
          ref-counts
          2)
        (let
          [partial? : bool
            (and
              (string.eq (struct-get (array-ref items 0) register) "%rcx")
              (string.eq (struct-get (array-ref items 1) register) ""))]
          (begin
            (compiler-reg-scratch-clear-incomplete-groups! items 0)
            (and
              partial?
              (string.eq (struct-get (array-ref items 0) register) "")
              (string.eq (struct-get (array-ref items 1) register) ""))))))
    true))

(define (compiler-backend-scratch-vreg-constraint-shapes-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [items : (Array CompilerRegScratchAssignment)
        (array.make-array CompilerRegScratchAssignment 5)]
      [starts : (Array i64) (array.make-array i64 5)]
      [ends : (Array i64) (array.make-array i64 5)]
      [segments : (Array CompilerRegIntervalList)
        (array.make-array CompilerRegIntervalList 5)]
      [present : (Array i64) (array.make-array i64 5)]
      [types : (Array AstType) (array.make-array AstType 5)]
      [assignments : CompilerRegAssignmentTable
        (compiler-reg-assignment-table-make 5)]
      [ref-counts : (Array i64) (array.make-array i64 5)]
      [gp-fixed-rcx : CompilerRegScratchConstraint
        (CompilerRegScratchConstraint
          (CompilerRegScratchClass.Gp)
          CompilerRegStringList.Nil
          CompilerRegStringList.Nil
          "%rcx")]
      [gp-r10-not-rcx : CompilerRegScratchConstraint
        (CompilerRegScratchConstraint
          (CompilerRegScratchClass.Gp)
          (compiler-reg-string-cons
            "%rcx"
            (compiler-reg-string-cons "%r10" CompilerRegStringList.Nil))
          (compiler-reg-string-cons "%rcx" CompilerRegStringList.Nil)
          "")]
      [gp-r10 : CompilerRegScratchConstraint
        (CompilerRegScratchConstraint
          (CompilerRegScratchClass.Gp)
          (compiler-reg-string-cons "%r10" CompilerRegStringList.Nil)
          CompilerRegStringList.Nil
          "")]
      [xmm-any : CompilerRegScratchConstraint
        (CompilerRegScratchConstraint
          (CompilerRegScratchClass.Xmm)
          CompilerRegStringList.Nil
          CompilerRegStringList.Nil
          "")]
      (begin
        (compiler-reg-fill-i64-array starts -1)
        (compiler-reg-fill-i64-array ends -1)
        (compiler-reg-fill-i64-array present 0)
        (compiler-reg-fill-i64-array ref-counts 0)
        (compiler-reg-fill-interval-list-array! segments 0)
        ;; Fixed RCX lives across the complete region.
        (array-set!
          items
          0
          (CompilerRegScratchAssignment
            (CompilerRegScratchRequirement
              0
              0
              (CompilerRegScratchRole.CallTarget)
              gp-fixed-rcx
              0
              4
              0)
            ""))
        ;; Allowed {rcx,r10}, excluded {rcx}: selects r10.
        (array-set!
          items
          1
          (CompilerRegScratchAssignment
            (CompilerRegScratchRequirement
              0
              1
              (CompilerRegScratchRole.SwitchIndex)
              gp-r10-not-rcx
              0
              2
              1)
            ""))
        ;; The same solver supports the XMM register file.
        (array-set!
          items
          2
          (CompilerRegScratchAssignment
            (CompilerRegScratchRequirement
              0
              2
              (CompilerRegScratchRole.SwitchTable)
              xmm-any
              0
              2
              2)
            ""))
        ;; A simultaneous fixed-RCX request fails explicitly.
        (array-set!
          items
          3
          (CompilerRegScratchAssignment
            (CompilerRegScratchRequirement
              2
              0
              (CompilerRegScratchRole.BoundsLength)
              gp-fixed-rcx
              2
              3
              3)
            ""))
        ;; A later non-overlapping slot can reuse r10.
        (array-set!
          items
          4
          (CompilerRegScratchAssignment
            (CompilerRegScratchRequirement
              3
              0
              (CompilerRegScratchRole.BoundsLength)
              gp-r10
              3
              4
              4)
            ""))
        (let
          [i : i64 0]
          (while (< i 5)
            (begin
              (compiler-reg-scratch-mark-requirement!
                starts
                ends
                segments
                present
                types
                (struct-get (array-ref items i) requirement))
              (set! i (+ i 1)))))
        (compiler-reg-scratch-assign-items!
          (CompilerRegTargetAbi.Linux)
          items
          0
          assignments
          (CompilerRegIntervalIndex starts ends segments)
          ref-counts
          5)
        (and
          (string.eq (struct-get (array-ref items 0) register) "%rcx")
          (string.eq (struct-get (array-ref items 1) register) "%r10")
          (string.eq (struct-get (array-ref items 2) register) "%xmm2")
          (string.eq (struct-get (array-ref items 3) register) "")
          (string.eq (struct-get (array-ref items 4) register) "%r10"))))
    true))

(define (compiler-backend-scavenge-emergency-respects-exclude-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 1)]
    [ends : (Array i64) (make-array i64 1)]
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r12"))
        CompilerRegAssignmentList.Nil)]
    [exclude : (Array String)
      (compiler-backend-scavenge-emergency-exclude-fallback)]
    (begin
      (array-set! starts 0 0)
      (array-set! ends 0 10)
      (set! compiler-backend-emergency-pending false)
      (set! compiler-backend-emergency-used false)
      (set! compiler-backend-emergency-pending-count 0)
      (set! compiler-backend-emergency-used-count 0)
      (let
        [reg : String
          (compiler-backend-scavenge-pick
            starts
            ends
            (compiler-reg-assignment-index-build assignments 1)
            1
            5
            exclude
            9
            "%r8")]
        [ok : bool
          (and
            (string.eq reg "%r12")
            compiler-backend-emergency-pending
            (string.eq compiler-backend-emergency-reg "%r12")
            (= compiler-backend-emergency-pending-count 1)
            (= compiler-backend-emergency-used-count 1))]
        (begin
          (set! compiler-backend-emergency-pending false)
          (set! compiler-backend-emergency-used false)
          (set! compiler-backend-emergency-pending-count 0)
          (set! compiler-backend-emergency-used-count 0)
          ok)))))

(define (compiler-backend-scavenge-occupancy-cache-point-ok?
  [masks : (Array i64)]
  [starts : (Array i64)]
  [ends : (Array i64)]
  [assignment-index : CompilerRegAssignmentIndex]
  [vars : i64]
  [point : i64]) : bool
  (let
    [idx : i64 (/ point 2)]
    [cached : i64
      (if (and (>= idx 0) (< idx (array-length masks)))
        (array-ref masks idx)
        0)]
    [scanned : i64
      (compiler-backend-scavenge-occupied-mask-for-instr
        starts
        ends
        assignment-index
        vars
        point)]
    (= cached scanned)))

(define (compiler-backend-emit-current-count-gate-ok?) : bool
  (and
    (not
      (compiler-backend-emit-needs-current-count?
        0
        0
        (CompilerBackendMode.Scalar)))
    (not
      (compiler-backend-emit-needs-current-count?
        0
        0
        (CompilerBackendMode.Avx512)))
    (compiler-backend-emit-needs-current-count?
      1
      0
      (CompilerBackendMode.Scalar))
    (compiler-backend-emit-needs-current-count?
      0
      1
      (CompilerBackendMode.Scalar))
    ;; AVX2 predicated-store labels are position-keyed even without register
    ;; homes or const-hoist sites.
    (compiler-backend-emit-needs-current-count? 0 0 (CompilerBackendMode.Avx2))))

(define (compiler-backend-scavenge-occupancy-cache-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 5)]
    [ends : (Array i64) (make-array i64 5)]
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r9"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%r10"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.RegisterPair "%r11" "%xmm2"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment 3 (CompilerRegLocation.Spill 0))
              (compiler-reg-assignment-cons
                (CompilerRegAssignment.Assignment
                  4
                  (CompilerRegLocation.Register "%r9"))
                CompilerRegAssignmentList.Nil)))))]
    [assignment-index : CompilerRegAssignmentIndex
      (compiler-reg-assignment-index-build assignments 5)]
    (begin
      (array-set! starts 0 0)
      (array-set! ends 0 2)
      (array-set! starts 1 3)
      (array-set! ends 1 5)
      (array-set! starts 2 4)
      (array-set! ends 2 7)
      (array-set! starts 3 0)
      (array-set! ends 3 8)
      (array-set! starts 4 2)
      (array-set! ends 4 6)
      (let
        [masks : (Array i64)
          (compiler-backend-scavenge-occupancy-build
            starts
            ends
            assignment-index
            5)]
        (and
          (= (array-length masks) 5)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            0)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            2)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            4)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            6)
          (compiler-backend-scavenge-occupancy-cache-point-ok?
            masks
            starts
            ends
            assignment-index
            5
            8)
          (= (array-ref masks 0) (compiler-backend-scavenge-reg-bit "%r9"))
          (not
            (=
              (bit-and
                (array-ref masks 2)
                (compiler-backend-scavenge-reg-bit "%r9"))
              0))
          (=
            (array-ref masks 3)
            (bit-or
              (compiler-backend-scavenge-reg-bit "%r9")
              (bit-or
                (compiler-backend-scavenge-reg-bit "%r11")
                (compiler-backend-scavenge-reg-bit "%xmm2")))))))))

(define (compiler-backend-scavenge-loop-live-through-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.Mov 0 (CompilerIrValue.I64 8) (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Mov 1 (CompilerIrValue.I64 0) (AstType.I64))
          (compiler-ir-instr-cons
            (CompilerIrInstr.Mov 5 (CompilerIrValue.I64 0) (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.Jump "header")
              CompilerIrInstrList.Nil)))))
    (compiler-ir-block-cons
      (compiler-ir-block
        "header"
        (compiler-ir-instr-cons
          (CompilerIrInstr.BinOp
            2
            (CompilerIrBinOp.Lt)
            (CompilerIrValue.Var 1)
            (CompilerIrValue.Var 0)
            (AstType.Bool))
          (compiler-ir-instr-cons
            (CompilerIrInstr.Branch (CompilerIrValue.Var 2) "body" "exit")
            CompilerIrInstrList.Nil)))
      (compiler-ir-block-cons
        (compiler-ir-block
          "body"
          (compiler-ir-instr-cons
            (CompilerIrInstr.Gep
              3
              (CompilerIrValue.Var 5)
              (CompilerIrValue.Var 1)
              (AstType.I64))
            (compiler-ir-instr-cons
              (CompilerIrInstr.Load 4 (CompilerIrValue.Var 3) (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.Jump "header")
                CompilerIrInstrList.Nil))))
        (compiler-ir-block-cons
          (compiler-ir-block
            "exit"
            (compiler-ir-instr-cons
              (CompilerIrInstr.BinOp
                6
                (CompilerIrBinOp.Mul)
                (CompilerIrValue.Var 0)
                (CompilerIrValue.I64 8)
                (AstType.I64))
              (compiler-ir-instr-cons
                (CompilerIrInstr.Return
                  (CompilerIrMaybeValue.Some (CompilerIrValue.Var 6)))
                CompilerIrInstrList.Nil)))
          CompilerIrBlockList.Nil)))))

(define (compiler-backend-scavenge-loop-live-through-ok?) : bool
  (let
    [prev-starts : (Array i64) compiler-backend-scavenge-ctx-starts]
    [prev-ends : (Array i64) compiler-backend-scavenge-ctx-ends]
    [prev-assignment-index : CompilerRegAssignmentIndex
      compiler-backend-scavenge-ctx-assignment-index]
    [prev-plan-mask : i64 compiler-backend-scavenge-ctx-plan-reg-mask]
    [prev-occupied-masks : (Array i64)
      compiler-backend-scavenge-ctx-occupied-masks]
    [prev-vars : i64 compiler-backend-scavenge-ctx-vars]
    [blocks : CompilerIrBlockList
      (compiler-backend-scavenge-loop-live-through-blocks)]
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r8"))
        CompilerRegAssignmentList.Nil)]
    (begin
      (compiler-backend-test-scavenge-install-ctx!
        "scavenge_loop_live_through"
        CompilerIrParamList.Nil
        (AstType.I64)
        7
        blocks
        assignments)
      (let
        [mask : i64 (compiler-backend-scavenge-occupied-mask-at-point 12)]
        [ok : bool
          (and
            (not (= (bit-and mask (compiler-backend-scavenge-reg-bit "%r8")) 0))
            (not
              (string.eq
                (compiler-backend-scavenge-pick-with-mask
                  mask
                  (compiler-backend-one-exclude "%rax")
                  1
                  "%r8")
                "%r8")))]
        (begin
          (compiler-backend-set-scavenge-ctx-ready!
            prev-starts
            prev-ends
            prev-assignment-index
            prev-plan-mask
            prev-occupied-masks
            prev-vars)
          ok)))))

(define (compiler-backend-param-spill-stack-scratch-preserves-home-ok?) : bool
  (let
    [params : CompilerIrParamList
      (compiler-ir-param-cons
        (CompilerIrParam.Param "a" (AstType.U64) 0)
        (compiler-ir-param-cons
          (CompilerIrParam.Param "b" (AstType.U64) 1)
          (compiler-ir-param-cons
            (CompilerIrParam.Param "c" (AstType.U64) 2)
            (compiler-ir-param-cons
              (CompilerIrParam.Param "d" (AstType.U64) 3)
              (compiler-ir-param-cons
                (CompilerIrParam.Param "e" (AstType.Bool) 4)
                CompilerIrParamList.Nil)))))]
    [assignments : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          3
          (CompilerRegLocation.Register "%r9"))
        CompilerRegAssignmentList.Nil)]
    (match (compiler-backend-emit-param-spills
      (CompilerBackendTarget.Windows)
      assignments
      params
      0
      0
      0
      0
      (compiler-backend-program-index-build
        CompilerIrFunctionList.Nil
        CompilerIrExternList.Nil)
      5)
      [(ResultCompilerBackend.Ok asm)
        (and
          (compiler-backend-string-contains? asm "    movzbq 48(%rbp), ")
          (not
            (compiler-backend-string-contains? asm "    movzbq 48(%rbp), %r9\n")))]
      [(ResultCompilerBackend.Err _) false])))

(define (compiler-backend-scratch-vreg-scalar-div-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.BinOp
          2
          (CompilerIrBinOp.Div)
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Return
            (CompilerIrMaybeValue.Some (CompilerIrValue.Var 2)))
          CompilerIrInstrList.Nil)))
    CompilerIrBlockList.Nil))

(define (compiler-backend-scratch-vreg-scalar-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Register "%r12"))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Register "%r13"))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 2 (CompilerRegLocation.Spill -24))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-scratch-vreg-scalar-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [result : CompilerRegScratchPlanResult
        (compiler-backend-scratch-test-result
          "scratch_vreg_scalar_div"
          (compiler-backend-scratch-vreg-scalar-div-blocks)
          3
          (compiler-backend-scratch-vreg-scalar-assignments))]
      (match result
        [(CompilerRegScratchPlanResult.Result _ plan)
          (let
            [items : (Array CompilerRegScratchAssignment)
              (struct-get plan items)]
            [rax : String (compiler-reg-scratch-plan-register plan 0 0)]
            [rdx : String (compiler-reg-scratch-plan-register plan 0 1)]
            [temp0 : String (compiler-reg-scratch-plan-register plan 0 2)]
            [temp1 : String (compiler-reg-scratch-plan-register plan 0 3)]
            [temp2 : String (compiler-reg-scratch-plan-register plan 0 4)]
            (and
              (= (compiler-reg-scratch-plan-count plan) 5)
              (string.eq rax "%rax")
              (string.eq rdx "%rdx")
              (not (string.eq temp0 ""))
              (not (string.eq temp1 ""))
              (not (string.eq temp2 ""))
              (not (string.eq temp0 temp1))
              (not (string.eq temp0 temp2))
              (not (string.eq temp1 temp2))
              (not (string.eq temp0 "%rax"))
              (not (string.eq temp0 "%rdx"))
              (not (string.eq temp0 "%r12"))
              (not (string.eq temp0 "%r13"))
              (match (struct-get
                (struct-get (array-ref items 0) requirement)
                role)
                [(CompilerRegScratchRole.FixedRax) true]
                [_ false])
              (match (struct-get
                (struct-get (array-ref items 1) requirement)
                role)
                [(CompilerRegScratchRole.FixedRdx) true]
                [_ false])
              (string.eq
                (struct-get
                  (struct-get
                    (struct-get (array-ref items 0) requirement)
                    constraint)
                  fixed)
                "%rax")
              (string.eq
                (struct-get
                  (struct-get
                    (struct-get (array-ref items 1) requirement)
                    constraint)
                  fixed)
                "%rdx")))]))
    true))

(define (compiler-backend-scratch-vreg-scalar-shift-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.BinOp
          2
          (CompilerIrBinOp.Shl)
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          (AstType.I64))
        CompilerIrInstrList.Nil))
    CompilerIrBlockList.Nil))

(define (compiler-backend-scratch-vreg-scalar-shift-plan-ok?) : bool
  (cfg
    scratch-vreg
    (match (compiler-backend-scratch-test-result
      "scratch_vreg_scalar_shift"
      (compiler-backend-scratch-vreg-scalar-shift-blocks)
      3
      (compiler-backend-scratch-vreg-scalar-assignments))
      [(CompilerRegScratchPlanResult.Result _ plan)
        (let
          [fixed : String (compiler-reg-scratch-plan-register plan 0 0)]
          [result : String (compiler-reg-scratch-plan-register plan 0 1)]
          (and
            (= (compiler-reg-scratch-plan-count plan) 2)
            (string.eq fixed "%rcx")
            (not (string.eq result ""))
            (not (string.eq result fixed))
            (match (struct-get
              (struct-get (array-ref (struct-get plan items) 0) requirement)
              role)
              [(CompilerRegScratchRole.FixedRcx) true]
              [_ false])))])
    true))

(define (compiler-backend-scratch-vreg-scalar-return-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.BinOp
          2
          (CompilerIrBinOp.Add)
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          (AstType.I64))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Return
            (CompilerIrMaybeValue.Some (CompilerIrValue.Var 2)))
          CompilerIrInstrList.Nil)))
    CompilerIrBlockList.Nil))

(define (compiler-backend-scratch-vreg-scalar-return-plan-ok?) : bool
  (cfg
    scratch-vreg
    (match (compiler-backend-scratch-test-result
      "scratch_vreg_scalar_return"
      (compiler-backend-scratch-vreg-scalar-return-blocks)
      3
      (compiler-backend-scratch-vreg-scalar-assignments))
      [(CompilerRegScratchPlanResult.Result _ plan)
        (and
          (= (compiler-reg-scratch-plan-count plan) 1)
          (not (string.eq (compiler-reg-scratch-plan-register plan 0 0) ""))
          (match (struct-get
            (struct-get (array-ref (struct-get plan items) 0) requirement)
            role)
            [(CompilerRegScratchRole.ScalarPrimary) true]
            [_ false]))])
    true))

(define (compiler-backend-scratch-vreg-scalar-control-blocks) : CompilerIrBlockList
  (compiler-ir-block-cons
    (compiler-ir-block
      "entry"
      (compiler-ir-instr-cons
        (CompilerIrInstr.BinOp
          2
          (CompilerIrBinOp.Eq)
          (CompilerIrValue.Var 0)
          (CompilerIrValue.Var 1)
          (AstType.Bool))
        (compiler-ir-instr-cons
          (CompilerIrInstr.Branch (CompilerIrValue.Var 2) "yes" "no")
          CompilerIrInstrList.Nil)))
    CompilerIrBlockList.Nil))

(define (compiler-backend-scratch-vreg-scalar-control-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -8))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 2 (CompilerRegLocation.Spill -24))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-scratch-vreg-scalar-control-plan-ok?) : bool
  (cfg
    scratch-vreg
    (match (compiler-backend-scratch-test-result
      "scratch_vreg_scalar_control"
      (compiler-backend-scratch-vreg-scalar-control-blocks)
      3
      (compiler-backend-scratch-vreg-scalar-control-assignments))
      [(CompilerRegScratchPlanResult.Result _ plan)
        (let
          [lhs : String (compiler-reg-scratch-plan-register plan 0 0)]
          [rhs : String (compiler-reg-scratch-plan-register plan 0 1)]
          [test : String (compiler-reg-scratch-plan-register plan 2 0)]
          (and
            (= (compiler-reg-scratch-plan-count plan) 3)
            (not (string.eq lhs ""))
            (not (string.eq rhs ""))
            (not (string.eq lhs rhs))
            (not (string.eq test ""))
            (=
              (struct-get
                (struct-get (array-ref (struct-get plan items) 0) requirement)
                hi)
              3)
            (match (struct-get
              (struct-get (array-ref (struct-get plan items) 2) requirement)
              role)
              [(CompilerRegScratchRole.BranchTest) true]
              [_ false])))])
    true))

(define (compiler-backend-scratch-vreg-result-contains?
  [result : ResultCompilerBackend]
  [needle : String]) : bool
  (match result
    [(ResultCompilerBackend.Ok asm)
      (compiler-backend-string-contains? asm needle)]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-scratch-vreg-scalar-spill-assignments) : CompilerRegAssignmentList
  (compiler-reg-assignment-cons
    (CompilerRegAssignment.Assignment 0 (CompilerRegLocation.Spill -8))
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment 1 (CompilerRegLocation.Spill -16))
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment 2 (CompilerRegLocation.Spill -24))
        CompilerRegAssignmentList.Nil))))

(define (compiler-backend-scratch-vreg-scalar-emission-uses-plan-ok?) : bool
  (cfg
    scratch-vreg
    (let
      [assignments : CompilerRegAssignmentList
        (compiler-backend-scratch-vreg-scalar-spill-assignments)]
      [shift-register-assignments : CompilerRegAssignmentList
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            0
            (CompilerRegLocation.Register "%r12"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              1
              (CompilerRegLocation.Register "%r13"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                2
                (CompilerRegLocation.Register "%rcx"))
              CompilerRegAssignmentList.Nil)))]
      [fallthrough : CompilerBackendMaybeLabel (CompilerBackendMaybeLabel.No)]
      [div-guard : String
        (compiler-backend-div-overflow-guard-asm-with-plan
          (AstType.I64)
          "%r8"
          "%r12"
          "%r13")]
      [literal-ok : bool
        (match (compiler-backend-binop-literal-divmod-asm-here-with-plan
          (CompilerIrBinOp.Mod)
          (CompilerIrValue.I64 7)
          (AstType.I64)
          "%r12"
          "%r13"
          "%r14")
          [(CompilerBackendMaybeAsm.Some asm)
            (and
              (compiler-backend-string-contains? asm "%r12")
              (compiler-backend-string-contains? asm "%r13")
              ;; Signed literal divmod consumes magic + one SRC copy; the old
              ;; quotient-sign mask/tertiary scratch is deliberately unused.
              (not (compiler-backend-string-contains? asm "%r14")))]
          [(CompilerBackendMaybeAsm.No) false])]
      (and
        (not
          (string.eq
            (compiler-backend-scavenge-binop-return-rhs-reg
              assignments
              (CompilerIrBinOp.Eq)
              (CompilerIrValue.Var 1)
              "%rax")
            "%rax"))
        (compiler-backend-string-contains? div-guard "%r12")
        (compiler-backend-string-contains? div-guard "%r13")
        literal-ok
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-binop-spill-direct-shift
            assignments
            2
            (CompilerIrBinOp.Shl)
            (CompilerIrValue.Var 0)
            (CompilerIrValue.Var 1)
            (AstType.I64)
            (AstType.I64)
            "%rcx"
            "%r14")
          "    movq -16(%rbp), %rcx\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-binop-spill-direct-shift
            assignments
            2
            (CompilerIrBinOp.Shl)
            (CompilerIrValue.Var 0)
            (CompilerIrValue.Var 1)
            (AstType.I64)
            (AstType.I64)
            "%rcx"
            "%r14")
          "    shlq %cl, %r14\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-binop-spill-direct-shift
            shift-register-assignments
            2
            (CompilerIrBinOp.Shl)
            (CompilerIrValue.Var 0)
            (CompilerIrValue.Var 1)
            (AstType.I64)
            (AstType.I64)
            "%rcx"
            "%r14")
          "    movq %r14, %rcx\n")
        (not
          (compiler-backend-scratch-vreg-result-contains?
            (compiler-backend-emit-binop-spill-direct-shift
              shift-register-assignments
              2
              (CompilerIrBinOp.Shl)
              (CompilerIrValue.Var 0)
              (CompilerIrValue.Var 1)
              (AstType.I64)
              (AstType.I64)
              "%rcx"
              "%r14")
            "    shlq %cl, %rcx\n"))
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-branch-with-plan
            assignments
            "scratch_control"
            (CompilerIrValue.Global (ci.intern "scratch_condition"))
            "yes"
            "no"
            fallthrough
            "%r14")
          "    testq %r14, %r14\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-compare-branch-with-plan
            assignments
            "scratch_compare"
            (CompilerIrBinOp.Eq)
            (CompilerIrValue.Var 0)
            (CompilerIrValue.Var 1)
            (AstType.I64)
            "yes"
            "no"
            fallthrough
            "%r14"
            "%r15")
          "    movq -16(%rbp), %r15\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-compare-branch-with-plan
            assignments
            "scratch_compare_collision"
            (CompilerIrBinOp.Eq)
            (CompilerIrValue.Global (ci.intern "scratch_lhs"))
            (CompilerIrValue.Global (ci.intern "scratch_rhs"))
            (AstType.I64)
            "yes"
            "no"
            fallthrough
            "%r14"
            "%r14")
          "    cmpq ")
        (not
          (compiler-backend-scratch-vreg-result-contains?
            (compiler-backend-emit-compare-branch-with-plan
              assignments
              "scratch_compare_collision"
              (CompilerIrBinOp.Eq)
              (CompilerIrValue.Global (ci.intern "scratch_lhs"))
              (CompilerIrValue.Global (ci.intern "scratch_rhs"))
              (AstType.I64)
              "yes"
              "no"
              fallthrough
              "%r14"
              "%r14")
            "    cmpq %r14, %r14\n"))
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-binop-direct-compare
            assignments
            2
            "%r14"
            (CompilerIrBinOp.Eq)
            (CompilerIrValue.Var 0)
            (CompilerIrValue.Var 1)
            (AstType.I64)
            "%r14")
          "    cmpq ")
        (not
          (compiler-backend-scratch-vreg-result-contains?
            (compiler-backend-emit-binop-direct-compare
              assignments
              2
              "%r14"
              (CompilerIrBinOp.Eq)
              (CompilerIrValue.Var 0)
              (CompilerIrValue.Var 1)
              (AstType.I64)
              "%r14")
            "    cmpq %r14, %r14\n"))
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-load-compare-branch-with-plan
            assignments
            "scratch_load_compare"
            (CompilerIrValue.Var 0)
            (CompilerIrBinOp.Eq)
            (CompilerIrValue.Var 1)
            (AstType.I64)
            "yes"
            "no"
            fallthrough
            "%r14"
            "%r15")
          "    cmpq %r15, (%r14)\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-gep-load-compare-branch-with-plan
            assignments
            "scratch_gep_compare"
            (CompilerIrValue.Var 0)
            (CompilerIrValue.I64 2)
            (AstType.I64)
            (CompilerIrBinOp.Eq)
            (CompilerIrValue.Var 1)
            (AstType.I64)
            "yes"
            "no"
            fallthrough
            "%r14"
            "%r15")
          "    cmpq %r15, 16(%r14)\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-unop-with-plan
            assignments
            2
            (CompilerIrUnOp.Neg)
            (CompilerIrValue.Var 0)
            (AstType.I64)
            "%r14")
          "    negq %r14\n")
        (compiler-backend-scratch-vreg-result-contains?
          (compiler-backend-emit-cpuid
            assignments
            2
            (CompilerIrValue.Var 0)
            (CompilerIrValue.Var 1)
            1
            "%r14")
          "    movq %rbx, %r14\n    cpuid\n")))
    true))

