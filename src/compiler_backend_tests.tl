;; A refutable literal payload match lowers to a payload comparison that
;; branches to the next arm; confirm the resulting CFG reaches valid assembly.
(define (compiler-backend-literal-payload-source) : String
  "(defenum Maybe (None) (Some i64))
(define (classify [m : Maybe]) : i64
  (match m
    [(Some 0) 100]
    [(Some n) n]
    [None 5]))
(define (main) : i64 (classify (Some 0)))")

;; Confirm the refutable literal payload reaches valid assembly: the
;; function compiles and emits a `payload_ok` block (the in-bounds branch of the
;; payload comparison). `compiler-backend-asm-ok?` is smoke-source specific, so
;; check source-specific markers instead.
(define (compiler-backend-literal-payload-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-literal-payload-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (or
          (compiler_backend.compiler-backend-string-contains?
            asm
            "_tl_classify")
          (compiler_backend.compiler-backend-string-contains? asm "_tl_f"))
        (compiler_backend.compiler-backend-string-contains? asm "_payload_ok"))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-f64-source) : String
  "(define (addf [a : f64] [b : f64]) : f64
  (+ a b))
(define (subf [a : f64] [b : f64]) : f64
  (- a b))
(define (ltf [a : f64] [b : f64]) : bool
  (< a b))
(define (main) : i64
  (if (ltf (subf (addf 1.5 2.5) 1.0) 4.5) 7 9))")

(define (compiler-backend-f64-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-f64-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.compiler-backend-string-contains?
          asm
          (compiler_backend.compiler-backend-float-bits-directive
            (compiler_ast_types.AstType.F64)
            (compiler-backend-test-f64-bits "1.5")))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .double "))
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movsd %xmm0, ")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    movsd %xmm1, ")
        ;; FPO rsp-relative frame slot (the y param spills to 16(%rsp)).
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    addsd 16(%rsp), %xmm2\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    subsd 16(%rsp), %xmm2\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    ucomisd 16(%rsp), %xmm2\n")
        (compiler_backend.compiler-backend-string-contains?
          asm
          "    setb %r8b\n")
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    setb %al\n")))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-f64-neg-source) : String
  "(define (negf [x : f64]) : f64
  (neg x))
(define (main) : i64
  (if (< (negf 1.5) 0.0) 0 1))")

(define (compiler-backend-f64-neg-object-source) : String
  "(define (negf [x : f64]) : f64
  (neg x))
(define (main) : i64 0)")

(define (compiler-backend-f64-neg-sign-mask-asm-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-source
    (compiler-backend-f64-neg-source))
    [(compiler_backend.ResultCompilerBackend.Ok asm)
      (and
        (compiler_backend.backend-and8
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    xorpd .L_tl_f64_sign_bit(%rip), %xmm2\n")
          (=
            (compiler_backend.compiler-backend-string-count
              asm
              ".L_tl_f64_sign_bit:\n")
            1)
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .balign 16\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad 0x8000000000000000\n")
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    .quad 0\n")
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movabsq $0x8000000000000000, %rax\n"))
          (not
            (compiler_backend.compiler-backend-string-contains?
              asm
              "    movq %rax, %xmm1\n"))
          true)
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    xorpd %xmm1, %xmm0\n"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            asm
            "    xorpd .L_tl_f64_sign_bit(%rip), %xmm0\n"))
        (match (compiler_backend.compiler-backend-emit-source
          (compiler-backend-f64-source))
          [(compiler_backend.ResultCompilerBackend.Ok no-neg-asm)
            (not
              (compiler_backend.compiler-backend-string-contains?
                no-neg-asm
                ".L_tl_f64_sign_bit"))]
          [(compiler_backend.ResultCompilerBackend.Err _) false]))]
    [(compiler_backend.ResultCompilerBackend.Err _) false]))

(define (compiler-backend-f64-neg-sign-mask-object-render-ok?
  [image : cobj.CompilerObjectImage]
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match target
    [(compiler_backend.CompilerBackendTarget.Linux)
      (match (elf.compiler-object-elf-render image)
        [(elf.ResultCompilerObjectElf.Ok _) true]
        [(elf.ResultCompilerObjectElf.Err _) false])]
    [(compiler_backend.CompilerBackendTarget.Windows)
      (match (coff.compiler-object-coff-render image)
        [(coff.ResultCompilerObjectCoff.Ok _) true]
        [(coff.ResultCompilerObjectCoff.Err _) false])]))

(define (compiler-backend-f64-neg-sign-mask-object-target-ok?
  [target : compiler_backend.CompilerBackendTarget]) : bool
  (match (compiler_backend.compiler-backend-emit-source-object-image-for-target
    (compiler-backend-f64-neg-object-source)
    target)
    [(compiler_backend.ResultCompilerBackendObject.Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList (struct-get image sections)]
        [symbols : cobj.CompilerObjectSymbolList (struct-get image symbols)]
        [relocs : cobj.CompilerObjectRelocationList
          (struct-get image relocations)]
        [label : String (compiler_backend.compiler-backend-f64-sign-bit-label)]
        (and
          (compiler_backend.backend-and8
            (cobj.compiler-object-symbol-list-contains?
              symbols
              label
              (cobj.CompilerObjectSymbolBinding.Local)
              (cobj.CompilerObjectSymbolKind.Data))
            (cobj.compiler-object-section-contains-label?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              label)
            (cobj.compiler-object-section-contains-align?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              16)
            (cobj.compiler-object-section-label-has-i64-pair?
              sections
              (cobj.CompilerObjectSectionKind.Rodata)
              label
              -9223372036854775808
              0)
            (cobj.compiler-object-section-contains-xorpd-rip? sections label)
            (cobj.compiler-object-relocation-list-contains?
              relocs
              (cobj.CompilerObjectRelocationKind.RipValue)
              label)
            true
            true)
          (compiler-backend-f64-neg-sign-mask-object-render-ok? image target)))]
    [(compiler_backend.ResultCompilerBackendObject.Err _) false]))

(define (compiler-backend-f64-neg-sign-mask-object-ok?) : bool
  (and
    (compiler-backend-f64-neg-sign-mask-object-target-ok?
      (compiler_backend.CompilerBackendTarget.Linux))
    (compiler-backend-f64-neg-sign-mask-object-target-ok?
      (compiler_backend.CompilerBackendTarget.Windows))))

(define (compiler-backend-f64-neg-sign-mask-ok?) : bool
  (and
    (compiler-backend-f64-neg-sign-mask-asm-ok?)
    (compiler-backend-f64-neg-sign-mask-object-ok?)))

(define (compiler-backend-direct-f64-neg-home-ok?) : bool
