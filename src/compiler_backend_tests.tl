        (compiler_backend.compiler-backend-frame-slots 1 full))]
    [full-save : String
      (compiler_backend.compiler-backend-emit-save-win64-xmm-callee-regs
        (compiler_backend.CompilerBackendTarget.Windows)
        full
        1
        full-frame)]
    [full-restore : String
      (compiler_backend.compiler-backend-emit-restore-win64-xmm-callee-regs
        full
        1)]
    [empty-entry : String
      (compiler_backend.compiler-backend-emit-function-entry
        (compiler_backend.CompilerBackendTarget.Windows)
        "_tl_xmm_empty"
        32
        compiler_regalloc.CompilerRegAssignmentList.Nil
        3)]
    [inline-tail : String
      (compiler_backend.compiler-backend-inline-return-tail sparse 3)]
    [jump-tail : String
      (compiler_backend.compiler-backend-tail-jump-tail
        sparse
        3
        "_tl_xmm_target")]
    [shared-tail : String
      (compiler_backend.compiler-backend-return-epilogue
        (ci.intern "xmm_shared")
        sparse
        3
        (compiler-backend-callee-save-double-return-blocks))]
    [ok : bool
      (and
        (compiler_regalloc.compiler-reg-location-register?
          (compiler_regalloc.compiler-reg-assignment-lookup planned 0)
          (compiler_abi.compiler-abi-xmm-register-id 6))
        (compiler_backend.compiler-backend-string-contains?
          planned-save
          "    movdqu %xmm6, ")
        (not
          (compiler_backend.compiler-backend-string-contains?
            planned-save
            "%xmm7"))
        (compiler_backend.compiler-backend-plan-uses-callee-regs? sparse)
        (= frame 240)
        (= (compiler_backend.compiler-backend-frame-slots 3 sparse) 30)
        (=
          (compiler_backend.compiler-backend-frame-slots-with-groups
            3
            sparse
            true)
          36)
        (=
          (compiler_backend.compiler-backend-frame-slots-emergency-max 3 true)
          38)
        (=
          (compiler_backend.compiler-backend-win64-xmm-callee-slot-offset
            sparse
            3
            0)
          -96)
        (=
          (compiler_backend.compiler-backend-win64-xmm-callee-slot-offset
            sparse
            3
            9)
          -240)
        (= (compiler_backend.compiler-backend-group-word0-slot 0 3 sparse) -256)
        (= (compiler_backend.compiler-backend-group-word1-slot 0 3 sparse) -248)
        (string.eq
          save
          "    movdqu %xmm6, -96(%rbp)\n    .seh_savexmm %xmm6, 144\n    movdqu %xmm15, -240(%rbp)\n    .seh_savexmm %xmm15, 0\n")
        (string.eq
          restore
          "    movdqu -240(%rbp), %xmm15\n    movdqu -96(%rbp), %xmm6\n    movq -32(%rbp), %r12\n")
        (compiler_backend.compiler-backend-string-contains?
          entry
          "    subq $240, %rsp\n")
        (compiler_backend.compiler-backend-string-contains? entry save)
        (compiler_backend.compiler-backend-string-contains?
          entry
          "    .seh_savexmm %xmm15, 0\n    .seh_endprologue\n")
        (= full-frame 224)
        (=
          (compiler_backend.compiler-backend-string-count
            full-save
            "    movdqu %xmm")
          10)
        (=
          (compiler_backend.compiler-backend-string-count
            full-save
            "    .seh_savexmm %xmm")
          10)
        (=
          (compiler_backend.compiler-backend-string-count
            full-restore
            "    movdqu ")
          10)
        (=
          (compiler_backend.compiler-backend-frame-slots
            3
            compiler_regalloc.CompilerRegAssignmentList.Nil)
          3)
        (not
          (compiler_backend.compiler-backend-string-contains?
            empty-entry
            "movdqu"))
        (not
          (compiler_backend.compiler-backend-string-contains?
            empty-entry
            ".seh_savexmm"))
        (= large-frame 5024)
        (compiler_backend.compiler-backend-string-contains?
          large-entry
          "    callq __chkstk\n")
        (compiler_backend.compiler-backend-string-contains?
          large-entry
          "    movdqu %xmm15, -5024(%rbp)\n    .seh_savexmm %xmm15, 0\n")
        (=
          (compiler_backend.compiler-backend-string-count
            inline-tail
            "movdqu -240(%rbp), %xmm15")
          1)
        (compiler_backend.compiler-backend-string-contains?
          inline-tail
          "    leave\n    ret\n")
        (=
          (compiler_backend.compiler-backend-string-count
            jump-tail
            "movdqu -240(%rbp), %xmm15")
          1)
        (compiler_backend.compiler-backend-string-contains?
          jump-tail
          "    leave\n    jmp _tl_xmm_target\n")
        (=
          (compiler_backend.compiler-backend-string-count
            shared-tail
            "movdqu -240(%rbp), %xmm15")
          1)
        (compiler_backend.compiler-backend-string-contains?
          shared-tail
          ".L_tl_xmm_shared_return:"))]
    [_linux : unit (compiler_backend.compiler-backend-set-current-fn-linux!)]
    (and
      ok
      (= (compiler_backend.compiler-backend-win64-xmm-callee-highest sparse) -1)
      (= (compiler_backend.compiler-backend-frame-slots 3 sparse) 7)
      (string.eq
        (compiler_backend.compiler-backend-emit-save-win64-xmm-callee-regs
          (compiler_backend.CompilerBackendTarget.Linux)
          sparse
          3
          64)
        "")
      (string.eq
        (compiler_backend.compiler-backend-emit-restore-callee-regs sparse 3)
        "    movq -32(%rbp), %r12\n"))))

(define (compiler-backend-peephole-register-moves-ok?) : bool
