(define (compiler-backend-export-symbol-source) : String
  "(define (exported [x : i64]) (:export-symbol \"tl_exported_value\") : i64
  (+ x 1))
(define (main) : i64
  (exported 41))")

(define (compiler-backend-export-symbol-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-export-symbol-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and8
        (compiler-backend-string-contains? asm ".globl tl_exported_value\n")
        (compiler-backend-string-contains? asm "tl_exported_value:\n")
        (compiler-backend-call-or-jmp-ok? asm "tl_exported_value")
        (not
          (compiler-backend-string-contains? asm ".extern tl_exported_value\n"))
        (not (compiler-backend-string-contains? asm ".globl _tl_exported\n"))
        (not (compiler-backend-string-contains? asm "_tl_exported:\n"))
        (compiler-backend-string-contains? asm "main:\n")
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-export-symbol-fixed-fault-source) : String
  "(extern (tl_oob_abort) : never)
(define (oob-abort) (:export-symbol \"tl_oob_abort\") : never
  (tl_oob_abort))
(define (main) : i64 0)")

(define (compiler-backend-export-symbol-fixed-fault-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-export-symbol-fixed-fault-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm ".globl tl_oob_abort\n")
        (compiler-backend-string-contains? asm "tl_oob_abort:\n")
        (not (compiler-backend-string-contains? asm ".extern tl_oob_abort\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-duplicate-export-symbol-source) : String
  "(define (a) (:export-symbol \"dup_export\") : i64 1)
(define (b) (:export-symbol \"dup_export\") : i64 2)
(define (main) : i64 (+ (a) (b)))")

(define (compiler-backend-export-symbol-function-collision-source) : String
  "(define (normal) : i64 1)
(define (other) (:export-symbol \"_tl_normal\") : i64 2)
(define (main) : i64 (+ (normal) (other)))")

(define (compiler-backend-export-symbol-global-collision-source) : String
  "(define normal : i64 1)
(define (other) (:export-symbol \"_tl_normal\") : i64 2)
(define (main) : i64 (+ normal (other)))")

(define (compiler-backend-export-symbol-runtime-collision-source) : String
  "(define (own-alloc) (:export-symbol \"tl_alloc\") : i64 1)
(define (main) : i64 (own-alloc))")

(define (compiler-backend-export-symbol-stdlib-runtime-collision-source) : String
  "(define (own-int-to-string) (:export-symbol \"tl_int_to_string\") : String \"0\")
(define (main) : i64 (__tl_string_length (own-int-to-string)))")

(define (compiler-backend-export-symbol-main-source) : String
  "(define (main) (:export-symbol \"tl_not_main\") : i64 0)")

(define (compiler-backend-export-symbol-invalid-source) : String
  "(define (bad) (:export-symbol \"bad symbol\") : i64 1)
(define (main) : i64 (bad))")

(define (compiler-backend-export-symbol-extern-collision-source) : String
  "(extern (imported) : i64 (:symbol \"dup_link\"))
(define (exported) (:export-symbol \"dup_link\") : i64 42)
(define (main) : i64 (imported))")

(define (compiler-backend-export-symbol-diagnostics-ok?) : bool
  (and
    (backend-and4
      (compiler-backend-error-ok?
        (compiler-backend-duplicate-export-symbol-source)
        "backend: duplicate emitted function symbol dup_export")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-function-collision-source)
        "backend: duplicate emitted function symbol _tl_normal")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-global-collision-source)
        "backend: duplicate emitted function symbol _tl_normal")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-runtime-collision-source)
        "backend: exported function symbol collides with runtime symbol tl_alloc"))
    (backend-and4
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-main-source)
        "backend: main cannot use :export-symbol")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-invalid-source)
        "backend: invalid exported function symbol bad symbol")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-extern-collision-source)
        "backend: extern symbol collides with emitted symbol dup_link")
      (compiler-backend-error-ok?
        (compiler-backend-export-symbol-stdlib-runtime-collision-source)
        "backend: exported function symbol collides with runtime symbol tl_int_to_string"))))

(define (compiler-backend-export-symbol-tests-ok?) : bool
  (and
    (compiler-backend-export-symbol-ok?)
    (compiler-backend-export-symbol-fixed-fault-ok?)
    (compiler-backend-export-symbol-diagnostics-ok?)))

(define (compiler-backend-clean-module-symbol-collision-program) : CompilerIrProgram
  (CompilerIrProgram.Program
    CompilerIrGlobalList.Nil
    (compiler-ir-function-cons
      (CompilerIrFunction.Function
        (ci.intern "pkg/a.tl::helper")
        CompilerIrParamList.Nil
        (AstType.I64)
        0
        (compiler-ir-block-cons
          (compiler-ir-block
            "entry"
            (compiler-ir-instr-cons
              (CompilerIrInstr.Return
                (CompilerIrMaybeValue.Some (CompilerIrValue.I64 1)))
              CompilerIrInstrList.Nil))
          CompilerIrBlockList.Nil))
      (compiler-ir-function-cons
        (CompilerIrFunction.Function
          (ci.intern "pkg_a.tl::helper")
          CompilerIrParamList.Nil
          (AstType.I64)
          0
          (compiler-ir-block-cons
            (compiler-ir-block
              "entry"
              (compiler-ir-instr-cons
                (CompilerIrInstr.Return
                  (CompilerIrMaybeValue.Some (CompilerIrValue.I64 2)))
                CompilerIrInstrList.Nil))
            CompilerIrBlockList.Nil))
        CompilerIrFunctionList.Nil))
    CompilerIrExternList.Nil))

(define (compiler-backend-clean-module-symbol-collision-ok?) : bool
  (match (compiler-backend-emit-program-linux
    (compiler-backend-clean-module-symbol-collision-program))
    [(ResultCompilerBackend.Err diag)
      (string.eq
        (compiler-diagnostic-message (box-get diag))
        "backend: duplicate emitted function symbol _tl_pkg_a_helper")]
    [(ResultCompilerBackend.Ok _) false]))

(define (compiler-backend-raw-pointer-fixture-shape-ok?) : bool
  (match (compiler-backend-raw-pointer-fixture-emit
    (CompilerBackendTarget.Linux))
    [(ResultCompilerBackend.Ok asm)
      (backend-and8
        (or
          (>= (compiler-backend-string-count asm ".globl _tl_f") 2)
          (and
            (compiler-backend-string-contains? asm ".globl _tl_write_i64")
            (compiler-backend-string-contains? asm ".globl _tl_read_i64")))
        (or
          (compiler-backend-string-contains? asm "_tl_write_i64")
          (compiler-backend-string-contains? asm "_tl_f"))
        (or
          (>= (compiler-backend-string-count asm "    call _tl_f") 2)
          (and
            (compiler-backend-string-contains? asm "    call _tl_write_i64")
            (compiler-backend-string-contains? asm "    call _tl_read_i64")))
        (compiler-backend-string-contains? asm "main:\n")
        (compiler-backend-string-contains? asm "    call tl_alloc\n")
        (compiler-backend-string-contains? asm "tl_alloc:")
        (compiler-backend-string-contains? asm "    movq (%r10,%r8,8), %r9\n")
        (and
          (not
            (compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker)))
          (not
            (compiler-backend-string-contains? asm "    movq (%r10), %rax\n"))))]
    [(ResultCompilerBackend.Err _) false]))

;; Backend emit-shape coverage for arena-owned boxes. `(box 42)`
;; allocates `size-of(i64)` = 8 bytes via `tl_alloc` and stores the boxed value
;; into that storage; `(box-get b)` loads the value back through the box pointer.
;; Boxes reuse the existing `tl_alloc` / pointer store/load paths (no new IR or
;; runtime), so this locks down that the allocation, store, and load shapes are
;; emitted with no `# TODO` placeholder.
(define (compiler-backend-box-source) : String
  "(define (main) : i64
  (let
    [b : (Box i64) (box 42)]
    (box-get b)))")

(define (compiler-backend-box-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-box-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and4
          ;; (box 42): allocate size-of(i64)=8 bytes for the box storage,
          (compiler-backend-string-contains-alloc-size? asm 8)
          ;; Store the boxed value through allocator-owned pointer/value homes.
          (compiler-backend-string-contains? asm "    movq %r8, (%r10)\n")
          ;; (box-get b): load the boxed value back through the box pointer.
          (compiler-backend-string-contains? asm "    movq (%r10), %r8\n")
          (not
            (compiler-backend-string-contains?
              asm
              (compiler-backend-todo-marker))))
        (not (compiler-backend-string-contains? asm "    movq %rax, (%r10)\n"))
        (not (compiler-backend-string-contains? asm "    movq (%r10), %rax\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-fast-alloc-next-load-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-box-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains? asm "    movq 16(%r8), %rax\n")
        (compiler-backend-string-contains? asm "    leaq 8(%rax), %rcx\n")
        (not
          (compiler-backend-string-contains?
            asm
            ".L_tl_alloc8:\n    movq %fs:tl_current_arena@tpoff, %r8\n    testq %r8, %r8\n    jz .L_tl_alloc8_slow\n    movq 40(%r8), %r9\n    testq $1, 48(%r9)\n    jnz .L_tl_alloc8_atomic\n    movq 16(%r8), %rcx\n    movq %rcx, %rax\n"))
        (not
          (compiler-backend-string-contains?
            asm
            "    movq %rax, %rcx\n    addq $8, %rcx\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-fast-alloc-source) : String
  "(define (main) : i64
  (let
    [t : (Tuple bool i64) (tuple true 42)]
    (tuple-ref t 1)))")

(define (compiler-backend-inline-fast-alloc-result-ok?) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-inline-fast-alloc-source)
    (CompilerBackendTarget.Windows))
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains?
          asm
          "    testq $1, 48(%r8)\n    jnz .Lf0_allocentry_v0_slow\n")
        (compiler-backend-string-contains?
          asm
          "    movq 16(%r8), %rax\n    leaq 16(%rax), %r10\n")
        (not
          (compiler-backend-string-contains?
            asm
            "    movq 16(%r8), %r10\n    addq $16, %r10\n"))
        (not
          (compiler-backend-string-contains?
            asm
            "    movq %rax, %r10\n    addq $16, %r10\n")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-fast-alloc-gate-ok?) : bool
  (and
    (=
      (compiler-backend-fast-alloc-size
        (CompilerIrCallArgs.One (CompilerIrValue.I64 1)))
      8)
    (=
      (compiler-backend-fast-alloc-size
        (CompilerIrCallArgs.One (CompilerIrValue.I64 8)))
      8)
    (=
      (compiler-backend-fast-alloc-size
        (CompilerIrCallArgs.One (CompilerIrValue.I64 9)))
      16)
    (=
      (compiler-backend-fast-alloc-size
        (CompilerIrCallArgs.One (CompilerIrValue.I64 64)))
      64)
    (=
      (compiler-backend-fast-alloc-size
        (CompilerIrCallArgs.One (CompilerIrValue.I64 65)))
      0)
    (=
      (compiler-backend-fast-alloc-size
        (CompilerIrCallArgs.One (CompilerIrValue.I64 0)))
      0)
    (=
      (compiler-backend-fast-alloc-size
        (CompilerIrCallArgs.One (CompilerIrValue.Var 0)))
      0)
    (compiler-backend-inline-fast-alloc? 8)
    (compiler-backend-inline-fast-alloc? 24)
    (compiler-backend-inline-fast-alloc? 40)
    (compiler-backend-inline-fast-alloc? 64)
    (not (compiler-backend-inline-fast-alloc? 0))
    (not (compiler-backend-inline-fast-alloc? 10))
    (not (compiler-backend-inline-fast-alloc? 72))))

(define (compiler-backend-inline-fast-alloc-multi-size-source) : String
  "(define (make3 [x : i64]) : (Tuple i64 i64 i64)
  (tuple x (+ x 1) (+ x 2)))

(define (make5 [x : i64]) : (Tuple i64 i64 i64 i64 i64)
  (tuple x (+ x 1) (+ x 2) (+ x 3) (+ x 4)))

(define (main) : i64
  (let
    [a : (Tuple i64 i64 i64) (make3 10)]
    [b : (Tuple i64 i64 i64 i64 i64) (make5 20)]
    (+ (tuple-ref a 2) (tuple-ref b 4))))")

(define (compiler-backend-inline-fast-alloc-multi-size-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-inline-fast-alloc-multi-size-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (and
        (compiler-backend-string-contains-inline-alloc-size? asm 24)
        (compiler-backend-string-contains-inline-alloc-size? asm 40)
        (compiler-backend-string-contains?
          asm
          "_slow:\n    call .L_tl_alloc24\n")
        (compiler-backend-string-contains?
          asm
          "_slow:\n    call .L_tl_alloc40\n")
        (not (compiler-backend-string-contains? asm "    call tl_alloc\n"))
        (compiler-backend-string-contains? asm "    jb ")
        (compiler-backend-string-contains? asm "    ja "))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-fast-alloc-multi-size-ok?) : bool
  (and
    (compiler-backend-inline-fast-alloc-multi-size-target-ok?
      (CompilerBackendTarget.Linux))
    (compiler-backend-inline-fast-alloc-multi-size-target-ok?
      (CompilerBackendTarget.Windows))))

(define compiler-backend-inline-fast-alloc-emergency-live-count : i64
  13)

(define (compiler-backend-inline-fast-alloc-emergency-regs) : (Array String)
  (let
    [regs : (Array String)
      (make-array
        String
        compiler-backend-inline-fast-alloc-emergency-live-count)]
    (begin
      (array-set! regs 0 "%r9")
      (array-set! regs 1 "%rcx")
      (array-set! regs 2 "%rdx")
      (array-set! regs 3 "%r10")
      (array-set! regs 4 "%r11")
      (array-set! regs 5 "%r8")
      (array-set! regs 6 "%r12")
      (array-set! regs 7 "%r13")
      (array-set! regs 8 "%r14")
      (array-set! regs 9 "%r15")
      (array-set! regs 10 "%rbx")
      (array-set! regs 11 "%rsi")
      (array-set! regs 12 "%rdi")
      regs)))

(define (compiler-backend-inline-fast-alloc-emergency-assignments-from
  [regs : (Array String)]
  [index : i64]) : CompilerRegAssignmentList
  (if (>= index (array-length regs))
    CompilerRegAssignmentList.Nil
    (compiler-reg-assignment-cons
      (CompilerRegAssignment.Assignment
        index
        (CompilerRegLocation.Register (array-ref regs index)))
      (compiler-backend-inline-fast-alloc-emergency-assignments-from
        regs
        (+ index 1)))))

(define (compiler-backend-inline-fast-alloc-emergency-assignments) : CompilerRegAssignmentList
  (compiler-backend-inline-fast-alloc-emergency-assignments-from
    (compiler-backend-inline-fast-alloc-emergency-regs)
    0))

(define (compiler-backend-inline-fast-alloc-emergency-instrs) : CompilerIrInstrList
  (let
    [instrs : CompilerIrInstrList CompilerIrInstrList.Nil]
    [v : i64 (- compiler-backend-inline-fast-alloc-emergency-live-count 1)]
    (begin
      (while (>= v 0)
        (begin
          (set!
            instrs
            (compiler-ir-instr-cons
              (CompilerIrInstr.Mov
                (+ 30 v)
                (CompilerIrValue.Var v)
                (AstType.I64))
              instrs))
          (set! v (- v 1))))
      (compiler-ir-instr-cons
        (CompilerIrInstr.Call
          20
          (ci.intern "tl_alloc")
          (CompilerIrCallArgs.One (CompilerIrValue.I64 8))
          (AstType.U64))
        instrs))))

(define (compiler-backend-inline-fast-alloc-emergency-asm) : ResultCompilerBackend
  (let
    [prev-starts : (Array i64) compiler-backend-scavenge-ctx-starts]
    [prev-ends : (Array i64) compiler-backend-scavenge-ctx-ends]
    [prev-assignment-index : CompilerRegAssignmentIndex
      compiler-backend-scavenge-ctx-assignment-index]
    [prev-plan-mask : i64 compiler-backend-scavenge-ctx-plan-reg-mask]
    [prev-occupied-masks : (Array i64)
      compiler-backend-scavenge-ctx-occupied-masks]
    [prev-vars : i64 compiler-backend-scavenge-ctx-vars]
    [prev-post-base : i64 compiler-backend-emit-instr-post-base]
    [prev-current-count : i64 compiler-backend-emit-current-count]
    [prev-win64 : bool (compiler-backend-current-fn-win64?)]
    [prev-emergency-pending : bool compiler-backend-emergency-pending]
    [prev-emergency-reg : String compiler-backend-emergency-reg]
    [prev-emergency-used : bool compiler-backend-emergency-used]
    [prev-emergency-pending-count : i64
      compiler-backend-emergency-pending-count]
    [prev-emergency-used-count : i64 compiler-backend-emergency-used-count]
    [prev-emergency-slot-offset : i64 compiler-backend-emergency-slot-offset]
    [prev-emergency-restore-suppressed : bool
      compiler-backend-emergency-restore-suppressed]
    [assignments : CompilerRegAssignmentList
      (compiler-backend-inline-fast-alloc-emergency-assignments)]
    [instrs : CompilerIrInstrList
      (compiler-backend-inline-fast-alloc-emergency-instrs)]
    [count : i64 (compiler-ir-instr-list-count instrs)]
    [blocks : CompilerIrBlockList
      (compiler-ir-block-cons
        (compiler-ir-block "entry" instrs)
        CompilerIrBlockList.Nil)]
    [_ctx : unit
      (begin
        (compiler-backend-set-current-fn-linux!)
        (compiler-backend-test-scavenge-install-ctx!
          "inline_fast_alloc_emergency"
          CompilerIrParamList.Nil
          (AstType.I64)
          50
          blocks
          assignments)
        (set! compiler-backend-emit-instr-post-base count)
        (set! compiler-backend-emit-current-count count)
        (set! compiler-backend-emergency-pending false)
        (set! compiler-backend-emergency-reg "")
        (set! compiler-backend-emergency-used false)
        (set! compiler-backend-emergency-pending-count 0)
        (set! compiler-backend-emergency-used-count 0)
        (set! compiler-backend-emergency-slot-offset -512)
        (set! compiler-backend-emergency-restore-suppressed false))]
    [result : ResultCompilerBackend
      (compiler-backend-emit-test-instrs instrs assignments 50)]
    [_restore : unit
      (begin
        (compiler-backend-set-scavenge-ctx-ready!
          prev-starts
          prev-ends
          prev-assignment-index
          prev-plan-mask
          prev-occupied-masks
          prev-vars)
        (set! compiler-backend-emit-instr-post-base prev-post-base)
        (set! compiler-backend-emit-current-count prev-current-count)
        (if prev-win64
          (compiler-backend-set-current-fn-win64!)
          (compiler-backend-set-current-fn-linux!))
        (set! compiler-backend-emergency-pending prev-emergency-pending)
        (set! compiler-backend-emergency-reg prev-emergency-reg)
        (set! compiler-backend-emergency-used prev-emergency-used)
        (set!
          compiler-backend-emergency-pending-count
          prev-emergency-pending-count)
        (set! compiler-backend-emergency-used-count prev-emergency-used-count)
        (set! compiler-backend-emergency-slot-offset prev-emergency-slot-offset)
        (set!
          compiler-backend-emergency-restore-suppressed
          prev-emergency-restore-suppressed))]
    result))

(define (compiler-backend-inline-fast-alloc-emergency-preserved-ok?) : bool
  (match (compiler-backend-inline-fast-alloc-emergency-asm)
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (compiler-backend-string-contains? asm "    movq %r9, -512(%rbp)\n")
          (compiler-backend-string-contains? asm "    movq -512(%rbp), %r9\n")
          (compiler-backend-string-contains? asm "    movq %rcx, -576(%rbp)\n")
          (compiler-backend-string-contains? asm "    movq -576(%rbp), %rcx\n")
          (compiler-backend-string-contains?
            asm
            "    movq %fs:tl_current_arena@tpoff, %r9\n")
          (compiler-backend-string-contains? asm "    leaq 8(%rax), %rcx\n")
          (compiler-backend-string-contains? asm "    movq %rcx, 16(%r9)\n")
          (compiler-backend-string-contains? asm "    call .L_tl_alloc8\n"))
        (compiler-backend-string-contains?
          asm
          "    movq tl_profile_alloc_live_bytes(%rip), %rcx\n")
        (compiler-backend-string-contains?
          asm
          "    cmpq tl_profile_alloc_peak_bytes(%rip), %rcx\n")
        (not
          (compiler-backend-string-contains?
            asm
            "tl_profile_alloc_live_bytes(%rip), %r10"))
        (not
          (compiler-backend-string-contains?
            asm
            "%r10, tl_profile_alloc_peak_bytes(%rip)"))
        (not
          (compiler-backend-string-contains?
            asm
            "    movq %fs:tl_current_arena@tpoff, %r8\n"))
        (not (compiler-backend-string-contains? asm "    leaq 8(%rax), %r8\n"))
        (not (compiler-backend-string-contains? asm "    leaq 8(%rax), %rax\n")))]
    [(ResultCompilerBackend.Err _) false]))

;; Backend emit-shape coverage for local tuple construction/ref.
;; `(tuple true 42)` allocates the tuple payload, materializes/stores the bool
;; byte and i64 at their offsets, and `(tuple-ref t 1)` loads the i64 slot back.
(define (compiler-backend-tuple-source) : String
  "(define (main) : i64
  (let
    [t : (Tuple bool i64) (tuple true 42)]
    (tuple-ref t 1)))")

(define (compiler-backend-tuple-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-tuple-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (compiler-backend-string-contains-alloc-size? asm 16)
          (compiler-backend-string-contains? asm "    movq $1,")
          (compiler-backend-string-contains? asm "    movb %r8b, (%r10)\n")
          (compiler-backend-string-contains? asm "    movq $42,")
          (compiler-backend-string-contains? asm "    movq %r8, 8(%r10)\n")
          (compiler-backend-string-contains? asm "    movq 8(%r10), %r8\n")
          (not (compiler-backend-string-contains? asm "    movb %al, (%r10)\n"))
          (not
            (compiler-backend-string-contains? asm "    movq %rax, 8(%r10)\n")))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-struct-ok?) : bool
  (match (compiler-backend-emit-source (compiler-lower-inline-struct-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and4
        (= (compiler-backend-string-count asm "    call tl_alloc\n") 0)
        (compiler-backend-string-contains? asm "    leaq -")
        (compiler-backend-string-contains? asm "main:\n")
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-enum-ok?) : bool
  (match (compiler-backend-emit-source (compiler-lower-inline-enum-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and4
        (= (compiler-backend-string-count asm "    call tl_alloc\n") 0)
        (compiler-backend-string-contains? asm "    leaq -")
        (compiler-backend-string-contains? asm ".Lf0_match_arm.")
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-boxed-recursive-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-lower-inline-boxed-recursive-source))
    [(ResultCompilerBackend.Ok asm)
      (backend-and4
        (= (compiler-backend-alloc-call-count asm) 1)
        ;; (box Nil) heap-allocates a full inline ListI64 value: tag (8) plus
        ;; the largest variant payload Cons(i64, (Box ListI64)) = 16, so 24
        ;; bytes. With default-inline aggregates the box holds the
        ;; inline value, not an 8-byte handle.
        (compiler-backend-string-contains-alloc-size? asm 24)
        (compiler-backend-string-contains? asm "    leaq -")
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-hot-loop-struct-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-lower-inline-hot-loop-struct-source))
    [(ResultCompilerBackend.Ok asm)
      ;; The loop's 16-byte `Pair` is now a register-resident group (built
      ;; and read in registers), so the loop body neither heap-allocates nor needs
      ;; a stack-slot address for it.
      (backend-and4
        (= (compiler-backend-string-count asm "    call tl_alloc\n") 0)
        (compiler-backend-string-contains? asm "main:\n")
        true
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-aggregate-call-source) : String
  "(defstruct Color (r u8) (g u8) (b u8) (a u8))
(defenum Swatch (Empty) (Paint Color))
(define (make-color) : Color
  (Color (cast 5 : u8) (cast 7 : u8) (cast 11 : u8) (cast 13 : u8)))
(define (id-color [c : Color]) : Color c)
(define (use-color [c : Color]) : i64
  (+
    (cast (struct-get c r) : i64)
    (+
      (cast (struct-get c g) : i64)
      (+ (cast (struct-get c b) : i64) (cast (struct-get c a) : i64)))))
(define (id-swatch [s : Swatch]) : Swatch s)
(define (score-swatch [s : Swatch]) : i64
  (match s
    [Empty 0]
    [(Paint c) (use-color c)]))
(define (main) : i64
  (let
    [c : Color (id-color (make-color))]
    [s : Swatch (id-swatch (Paint c))]
    (if (= (use-color c) 36)
      (if (= (score-swatch s) 36) 42 2)
      1)))")

(define (compiler-backend-inline-aggregate-call-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-inline-aggregate-call-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (backend-and4
        (compiler-backend-string-contains? asm "main:\n")
        (>= (compiler-backend-string-count asm "    call ") 6)
        ;; sret ABI: aggregate args/returns pass by caller slot pointer
        ;; and inline construction is stack storage -- no arena allocation.
        (= (compiler-backend-alloc-call-count asm) 0)
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-aggregate-call-ok?) : bool
  (and
    (compiler-backend-inline-aggregate-call-target-ok?
      (CompilerBackendTarget.Linux))
    (compiler-backend-inline-aggregate-call-target-ok?
      (CompilerBackendTarget.Windows))))

(define (compiler-backend-inline-aggregate-copy-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-inline-aggregates-for-target
    (compiler-lower-inline-aggregate-copy-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      ;; `Pair` is a 16-byte all-integer struct, so it is register-resident
      ;; -- `id-pair` is a register-pair passthrough that carries both words in
      ;; registers end-to-end. The function is still emitted, but it does NOT do
      ;; the old pointer-load / pointer-store byte-copy ("(%r11), %rax" then
      ;; "%rax, (%r10)") that a memory aggregate required.
      (backend-and4
        (compiler-backend-string-contains? asm "id_pair")
        (not (compiler-backend-string-contains? asm "(%r11), %rax"))
        (not (compiler-backend-string-contains? asm "%rax, (%r10)"))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-inline-aggregate-copy-ok?) : bool
  (and
    (compiler-backend-inline-aggregate-copy-target-ok?
      (CompilerBackendTarget.Linux))
    (compiler-backend-inline-aggregate-copy-target-ok?
      (CompilerBackendTarget.Windows))))

(define (compiler-backend-inline-aggregate-storage-ok?) : bool
  (and
    (compiler-backend-inline-struct-ok?)
    (compiler-backend-inline-enum-ok?)
    (compiler-backend-inline-boxed-recursive-ok?)
    (compiler-backend-inline-aggregate-call-ok?)
    (compiler-backend-inline-aggregate-copy-ok?)
    (compiler-backend-inline-hot-loop-struct-ok?)))

(define (compiler-backend-test-mode-scalar? [mode : CompilerBackendMode]) : bool
  (match mode
    [(CompilerBackendMode.Scalar) true]
    [_ false]))

(define (compiler-backend-test-mode-avx2? [mode : CompilerBackendMode]) : bool
  (match mode
    [(CompilerBackendMode.Avx2) true]
    [_ false]))

(define (compiler-backend-test-mode-avx512? [mode : CompilerBackendMode]) : bool
  (match mode
    [(CompilerBackendMode.Avx512) true]
    [_ false]))

(define (compiler-backend-defdispatch-source) : String
  "(define (dot-scalar [x : i64]) : i64 x)
(define (dot-avx2 [x : i64]) : i64 (+ x 2))
(define (dot-avx512 [x : i64]) : i64 (+ x 5))
(defdispatch dot (scalar dot-scalar) (avx2 dot-avx2) (avx512 dot-avx512))
(define (main) : i64 (dot 40))")

(define (compiler-backend-defdispatch-thunk-ok?) : bool
  (match (compiler-backend-emit-source (compiler-backend-defdispatch-source))
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (compiler-backend-string-contains? asm "__tl_dispatch_cache_dot")
          (compiler-backend-string-contains? asm "__tl_dispatch_variant_avx2")
          (compiler-backend-string-contains? asm "__tl_dispatch_variant_avx512")
          (compiler-backend-string-contains? asm "    cpuid\n")
          (compiler-backend-string-contains? asm "    xgetbv\n")
          (compiler-backend-string-contains? asm "    call *(%r10)\n")
          (compiler-backend-string-contains? asm "    vzeroupper\n")
          (compiler-backend-string-contains? asm "main:\n"))
        (not
          (compiler-backend-string-contains? asm (compiler-backend-todo-marker))))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-dispatch-variant-mode-ok?) : bool
  (and
    (backend-and4
      (compiler-backend-test-mode-avx2?
        (compiler-backend-effective-mode-for-function-name
          (CompilerBackendMode.Scalar)
          "__tl_dispatch_variant_avx2_dot__dot-avx2"))
      (compiler-backend-test-mode-avx512?
        (compiler-backend-effective-mode-for-function-name
          (CompilerBackendMode.Scalar)
          "__tl_dispatch_variant_avx512_dot__dot-avx512"))
      (compiler-backend-test-mode-scalar?
        (compiler-backend-effective-mode-for-function-name
          (CompilerBackendMode.Scalar)
          "__tl_dispatch_variant_scalar_dot__dot-scalar"))
      (compiler-backend-test-mode-avx2?
        (compiler-backend-effective-mode-for-function-name
          (CompilerBackendMode.Avx2)
          "ordinary")))
    (compiler-backend-defdispatch-thunk-ok?)))

(define (compiler-backend-signature-i64-to-i64?
  [sig : CompilerBackendMaybeSignature]) : bool
  (match sig
    [(CompilerBackendMaybeSignature.Some args ret-ty)
      (match ret-ty
        [(AstType.I64)
          (and
            (= (ast-type-list-len (& args)) 1)
            (match (ast-node-pool-reader-type-get
              (ast-type-list-get (& args) 0 (ast-type-id-fallback)))
              [(AstType.I64) true]
              [_ false]))]
        [_ false])]
    [(CompilerBackendMaybeSignature.No) false]))

(define (compiler-backend-signature-unit-to-i64?
  [sig : CompilerBackendMaybeSignature]) : bool
  (match sig
    [(CompilerBackendMaybeSignature.Some args ret-ty)
      (and
        (ast-type-list-empty? (& args))
        (match ret-ty
          [(AstType.I64) true]
          [_ false]))]
    [(CompilerBackendMaybeSignature.No) false]))

(define (compiler-backend-program-index-test-functions) : CompilerIrFunctionList
  (compiler-ir-function-cons
    (CompilerIrFunction.Function
      (ci.intern "pkg/really-long-backend-index-function")
      (compiler-ir-param-cons
        (CompilerIrParam.Param "x" (AstType.I64) 0)
        CompilerIrParamList.Nil)
      (AstType.I64)
      1
      CompilerIrBlockList.Nil)
    (compiler-ir-function-cons
      (CompilerIrFunction.Function
        (ci.intern "short_fn")
        CompilerIrParamList.Nil
        (AstType.Unit)
        0
        CompilerIrBlockList.Nil)
      CompilerIrFunctionList.Nil)))

(define (compiler-backend-program-index-test-externs
  [provided-id : i64]
  [provided-link-id : i64]
  [referenced-id : i64]
  [referenced-link-id : i64]) : CompilerIrExternList
  (compiler-ir-extern-cons
    (CompilerIrExtern.Extern
      provided-id
      provided-id
      "provided_decl"
      (ast-ty-func (ast-type-list-new) (AstType.I64))
      (AstExternAbi.C)
      provided-link-id
      (ast-extern-link-input-list-new)
      true)
    (compiler-ir-extern-cons
      (CompilerIrExtern.Extern
        referenced-id
        referenced-id
        "referenced_decl"
        (ast-ty-func
          (ast-type-cons (AstType.I64) (ast-type-list-new))
          (AstType.I64))
        (AstExternAbi.C)
        referenced-link-id
        (ast-extern-link-input-list-new)
        false)
      CompilerIrExternList.Nil)))

(define (compiler-backend-user-symbol-cache-ok?) : bool
  (begin
    (ci.intern-reset!)
    (compiler-backend-user-symbol-cache-reset!)
    (let
      [path-name : String "pkg/nested/module.tl::some-value"]
      [path-id : i64 (ci.intern path-name)]
      [path-symbol-first : String (compiler-backend-user-symbol-id path-id)]
      [count-after-path-first : i64 (compiler-backend-user-symbol-cache-count)]
      [path-symbol-second : String (compiler-backend-user-symbol-id path-id)]
      [count-after-path-second : i64 (compiler-backend-user-symbol-cache-count)]
      [main-id : i64 (ci.intern "main")]
      [main-symbol-first : String (compiler-backend-user-symbol-id main-id)]
      [count-after-main-first : i64 (compiler-backend-user-symbol-cache-count)]
      [main-symbol-second : String (compiler-backend-user-symbol-id main-id)]
      [count-after-main-second : i64 (compiler-backend-user-symbol-cache-count)]
      [third-symbol : String (compiler-backend-user-symbol-id path-id)]
      [count-after-third : i64 (compiler-backend-user-symbol-cache-count)]
      (backend-and8
        (string.eq path-symbol-first "_tl_pkg_nested_module_some_value")
        (string.eq path-symbol-second path-symbol-first)
        (= count-after-path-first 1)
        (= count-after-path-second count-after-path-first)
        (string.eq main-symbol-first "main")
        (string.eq main-symbol-second "main")
        (= count-after-main-second count-after-main-first)
        (and
          (string.eq third-symbol path-symbol-first)
          (= count-after-third count-after-main-second))))))

(define (compiler-backend-user-symbol-cache-compat-state-ok?) : bool
  (let
    [state-a : ci.InternCompatState (ci.intern-compat-state-new)]
    [state-b : ci.InternCompatState (ci.intern-compat-state-new)]
    [id-a : i64
      (begin
        (ci.intern-compat-state-install! state-a)
        (ci.intern-reset!)
        (ci.intern "first-state-name"))]
    [symbol-a : String
      (begin
        (ci.intern-compat-state-capture-from-globals! state-a)
        (compiler-backend-user-symbol-id id-a))]
    [id-b : i64
      (begin
        (ci.intern-compat-state-install! state-b)
        (ci.intern-reset!)
        (ci.intern "second-state-name"))]
    [symbol-b : String
      (begin
        (ci.intern-compat-state-capture-from-globals! state-b)
        (compiler-backend-user-symbol-id id-b))]
    (and
      (= id-a id-b)
      (not
        (=
          (ci.intern-compat-state-generation state-a)
          (ci.intern-compat-state-generation state-b)))
      (not
        (=
          (ci.intern-compat-state-table-id state-a)
          (ci.intern-compat-state-table-id state-b)))
      (string.eq symbol-a "_tl_first_state_name")
      (string.eq symbol-b "_tl_second_state_name"))))

(define (compiler-backend-user-symbol-cache-scratch-source) : String
  "(define (shared [x : i64]) : i64 (+ x 1))
(define (first [x : i64]) : i64 (shared x))
(define (second [x : i64]) : i64 (shared x))
(define (main) : i64 (+ (first 1) (second 2)))")

(define (compiler-backend-user-symbol-cache-scratch-ok?) : bool
  (match (compiler-backend-emit-source
    (compiler-backend-user-symbol-cache-scratch-source))
    [(ResultCompilerBackend.Ok _) true]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-runtime-leaf-user-symbol-ok?) : bool
  (let
    [fn-name : String "pkg/substring"]
    [fn-id : i64 (ci.intern fn-name)]
    [index : CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (compiler-ir-function-cons
          (CompilerIrFunction.Function
            fn-id
            CompilerIrParamList.Nil
            (AstType.I64)
            0
            CompilerIrBlockList.Nil)
          CompilerIrFunctionList.Nil)
        CompilerIrExternList.Nil)]
    (and
      (string.eq
        (compiler-backend-runtime-prelude-string-helper-symbol fn-name)
        "")
      (string.eq
        (compiler-backend-function-symbol-index index fn-id)
        "_tl_pkg_substring"))))

(define (compiler-backend-program-index-id-maps-ok?) : bool
  (let
    [fn-name : String "pkg/really-long-backend-index-function"]
    [fn-id : i64 (ci.intern fn-name)]
    [short-fn-id : i64 (ci.intern "short_fn")]
    [provided-name : String "provided_decl"]
    [provided-id : i64 (ci.intern provided-name)]
    [provided-link-id : i64 (ci.intern "provided_link")]
    [referenced-name : String "referenced_decl"]
    [referenced-id : i64 (ci.intern referenced-name)]
    [referenced-link : String "referenced_link"]
    [referenced-link-id : i64 (ci.intern referenced-link)]
    [missing-id : i64 (ci.intern "missing_backend_index_name")]
    [index : CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (compiler-backend-program-index-test-functions)
        (compiler-backend-program-index-test-externs
          provided-id
          provided-link-id
          referenced-id
          referenced-link-id))]
    (and
      (compiler-backend-index-function-defines-id? index short-fn-id)
      (backend-and8
        (compiler-backend-index-function-defines-id? index fn-id)
        (compiler-backend-index-function-defines? index fn-id)
        (not (compiler-backend-index-function-defines-id? index missing-id))
        (compiler-backend-signature-i64-to-i64?
          (compiler-backend-index-function-signature-id index fn-id))
        (compiler-backend-signature-i64-to-i64?
          (compiler-backend-index-function-signature index fn-id))
        (string.eq
          (compiler-backend-function-symbol-index index fn-id)
          "_tl_f0")
        (string.eq (compiler-backend-function-label-scope index fn-id) "f0")
        (compiler-backend-signature-unit-to-i64?
          (compiler-backend-index-extern-signature-id index provided-id)))
      (backend-and8
        (compiler-backend-index-extern-provided-id? index provided-id)
        (compiler-backend-index-extern-provided? index provided-id)
        (not
          (compiler-backend-index-extern-provided-id? index provided-link-id))
        (compiler-backend-index-extern-references-id? index referenced-id)
        (not
          (compiler-backend-index-extern-references-id?
            index
            referenced-link-id))
        (=
          (compiler-backend-index-extern-link-symbol-id index referenced-id)
          referenced-link-id)
        (=
          (compiler-backend-index-extern-link-symbol-id
            index
            referenced-link-id)
          referenced-link-id)
        (=
          (compiler-backend-index-extern-link-symbol-id index missing-id)
          missing-id))
      (backend-and4
        (string.eq
          (compiler-backend-function-symbol-map-comment index fn-id)
          "#t _tl_f0 _tl_really_long_backend_index_function\n")
        (string.eq
          (compiler-backend-function-symbol-index index provided-id)
          "provided_link")
        (compiler-backend-index-extern-references? index referenced-link-id)
        (string.eq
          (compiler-backend-index-extern-link-symbol index referenced-link-id)
          referenced-link)))))

(define (compiler-backend-program-index-explicit-extern-ids-ok?) : bool
  (begin
    (ci.intern-reset!)
    (let
      [fn-name : String "late_backend_index_fn"]
      [fn-id : i64 (ci.intern fn-name)]
      [extern-name : String "late_backend_index_ext"]
      [extern-id : i64 (ci.intern-generated-name extern-name)]
      [same-name-id : i64 (ci.intern-generated-name extern-name)]
      [extern-link : String "late_backend_index_link"]
      [extern-link-id : i64 (ci.intern-generated-name extern-link)]
      [same-name-link : String "late_backend_index_link_2"]
      [same-name-link-id : i64 (ci.intern-generated-name same-name-link)]
      [source-count-before : i64 (ci.intern-pool-len)]
      [index : CompilerBackendProgramIndex
        (compiler-backend-program-index-build
          (compiler-ir-function-cons
            (CompilerIrFunction.Function
              fn-id
              CompilerIrParamList.Nil
              (AstType.Unit)
              0
              CompilerIrBlockList.Nil)
            CompilerIrFunctionList.Nil)
          (compiler-ir-extern-cons
            (CompilerIrExtern.Extern
              extern-id
              extern-id
              extern-name
              (ast-ty-func (ast-type-list-new) (AstType.I64))
              (AstExternAbi.C)
              extern-link-id
              (ast-extern-link-input-list-new)
              false)
            (compiler-ir-extern-cons
              (CompilerIrExtern.Extern
                same-name-id
                same-name-id
                extern-name
                (ast-ty-func
                  (ast-type-cons (AstType.I64) (ast-type-list-new))
                  (AstType.I64))
                (AstExternAbi.C)
                same-name-link-id
                (ast-extern-link-input-list-new)
                false)
              CompilerIrExternList.Nil)))]
      (and
        (= source-count-before (ci.intern-pool-len))
        (backend-and8
          (compiler-backend-index-function-defines-id? index fn-id)
          (compiler-backend-index-function-defines? index fn-id)
          (compiler-backend-signature-unit-to-i64?
            (compiler-backend-index-extern-signature-id index extern-id))
          (compiler-backend-signature-i64-to-i64?
            (compiler-backend-index-extern-signature-id index same-name-id))
          (compiler-backend-index-extern-references-id? index extern-id)
          (compiler-backend-index-extern-references-id? index same-name-id)
          (=
            (compiler-backend-index-extern-link-symbol-id index extern-id)
            extern-link-id)
          (=
            (compiler-backend-index-extern-link-symbol-id index same-name-id)
            same-name-link-id))
        (backend-and4
          (compiler-backend-index-extern-references? index extern-link-id)
          (compiler-backend-index-extern-references? index same-name-link-id)
          (match (ci.intern-lookup extern-name)
            [(InternLookupFound _) false]
            [(InternLookupMissing) true])
          (not (= extern-id same-name-id)))))))

(define (compiler-backend-profile-runtime-source) : String
  "(extern (tl_profile_alloc_total) : i64)
(define (main) : i64 (tl_profile_alloc_total))")

(define (compiler-backend-profile-runtime-target-ok?
  [target : CompilerBackendTarget]) : bool
  (match (compiler-backend-emit-source-for-target
    (compiler-backend-profile-runtime-source)
    target)
    [(ResultCompilerBackend.Ok asm)
      (and
        (backend-and8
          (compiler-backend-string-contains?
            asm
            ".globl tl_profile_alloc_total\n")
          (compiler-backend-string-contains? asm "tl_profile_alloc_total:\n")
          (compiler-backend-string-contains? asm "tl_profile_alloc_live:\n")
          (compiler-backend-string-contains? asm "tl_profile_alloc_peak:\n")
          (compiler-backend-string-contains?
            asm
            "tl_profile_alloc_reset_peak:\n")
          (not
            (compiler-backend-string-contains? asm ".globl tl_profile_now_ms\n"))
          (not (compiler-backend-string-contains? asm "tl_profile_now_ms:\n"))
          (not
            (compiler-backend-string-contains? asm "QueryPerformanceCounter")))
        (not
          (compiler-backend-string-contains? asm "QueryPerformanceFrequency")))]
    [(ResultCompilerBackend.Err _) false]))

(define (compiler-backend-profile-runtime-split-ok?) : bool
  (and
    (compiler-backend-profile-runtime-target-ok? (CompilerBackendTarget.Linux))
    (compiler-backend-profile-runtime-target-ok?
      (CompilerBackendTarget.Windows))))

(define (compiler-backend-scavenge-exclude-before-r10) : (Array String)
  (make-array "%rax" "%r8" "%r9" "%rcx" "%rdx"))

(define (compiler-backend-scavenge-exclude-before-r11) : (Array String)
  (make-array "%rax" "%r8" "%r9" "%rcx" "%rdx" "%r10"))

(define (compiler-backend-scavenge-emergency-exclude-fallback) : (Array String)
  (make-array "%r9" "%rcx" "%rdx" "%r10" "%r11" "%r8" "%rsi" "%rdi" "%rax"))

(define (compiler-backend-scavenge-pooled-r10-r11-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 1)]
    [ends : (Array i64) (make-array i64 1)]
    (and
      (string.eq
        (compiler-backend-scavenge-pick
          starts
          ends
          (compiler-reg-assignment-index-build CompilerRegAssignmentList.Nil 1)
          0
          0
          (compiler-backend-scavenge-exclude-before-r10)
          5
          "%rax")
        "%r10")
      (string.eq
        (compiler-backend-scavenge-pick
          starts
          ends
          (compiler-reg-assignment-index-build CompilerRegAssignmentList.Nil 1)
          0
          0
          (compiler-backend-scavenge-exclude-before-r11)
          6
          "%rax")
        "%r11"))))

(define (compiler-backend-binop-exclude-keeps-pooled-r10-r11-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 5)]
    [ends : (Array i64) (make-array i64 5)]
    [r10-free : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r9"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%rcx"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.Register "%rdx"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                4
                (CompilerRegLocation.Register "%r8"))
              CompilerRegAssignmentList.Nil))))]
    [r11-free : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
        (CompilerRegAssignment.Assignment
          0
          (CompilerRegLocation.Register "%r9"))
        (compiler-reg-assignment-cons
          (CompilerRegAssignment.Assignment
            1
            (CompilerRegLocation.Register "%rcx"))
          (compiler-reg-assignment-cons
            (CompilerRegAssignment.Assignment
              2
              (CompilerRegLocation.Register "%rdx"))
            (compiler-reg-assignment-cons
              (CompilerRegAssignment.Assignment
                3
                (CompilerRegLocation.Register "%r10"))
              (compiler-reg-assignment-cons
                (CompilerRegAssignment.Assignment
                  4
                  (CompilerRegLocation.Register "%r8"))
                CompilerRegAssignmentList.Nil)))))]
    (begin
      (array-set! starts 0 0)
      (array-set! starts 1 0)
      (array-set! starts 2 0)
      (array-set! starts 3 0)
      (array-set! starts 4 0)
      (array-set! ends 0 10)
      (array-set! ends 1 10)
      (array-set! ends 2 10)
      (array-set! ends 3 10)
      (array-set! ends 4 10)
      (and
        (string.eq
          (compiler-backend-scavenge-pick
            starts
            ends
            (compiler-reg-assignment-index-build r10-free 5)
            5
            5
            (compiler-backend-binop-scavenge-exclude-build)
            5
            "%r8")
          "%r10")
        (string.eq
          (compiler-backend-scavenge-pick
            starts
            ends
            (compiler-reg-assignment-index-build r11-free 5)
            5
            5
            (compiler-backend-binop-scavenge-exclude-build)
            5
            "%r8")
          "%r11")))))

(define (compiler-backend-scavenge-exclude-with-keeps-pooled-r10-r11-ok?) : bool
  (let
    [starts : (Array i64) (make-array i64 5)]
    [ends : (Array i64) (make-array i64 5)]
    [r10-free : CompilerRegAssignmentList
      (compiler-reg-assignment-cons
