    (compiler-backend-avx2-vector-reduce-spill-source-ok?)
    (compiler-backend-avx512-vector-reduce-spill-source-ok?)))

(define (compiler-backend-vector-spill-pressure-source) : String
  "(define (fill
  [a0 : (Array i64)]
  [a1 : (Array i64)]
  [a2 : (Array i64)]
  [a3 : (Array i64)]
  [a4 : (Array i64)]
  [a5 : (Array i64)]
  [a6 : (Array i64)]
  [a7 : (Array i64)]
  [a8 : (Array i64)]
  [a9 : (Array i64)]
  [a10 : (Array i64)]
  [a11 : (Array i64)]
  [a12 : (Array i64)]
  [a13 : (Array i64)]
  [a14 : (Array i64)]
  [a15 : (Array i64)]
  [out : (Array i64)]
  [n : i64]) : unit
  (foreach
    ([i : i64 0 n])
    (array-set! out i
      (+ (array-ref a0 i)
        (+ (array-ref a1 i)
          (+ (array-ref a2 i)
            (+ (array-ref a3 i)
              (+ (array-ref a4 i)
                (+ (array-ref a5 i)
                  (+ (array-ref a6 i)
                    (+ (array-ref a7 i)
                      (+ (array-ref a8 i)
                        (+ (array-ref a9 i)
                          (+ (array-ref a10 i)
                            (+ (array-ref a11 i)
                              (+ (array-ref a12 i)
                                (+ (array-ref a13 i)
                                  (+ (array-ref a14 i)
                                    (array-ref a15 i)))))))))))))))))))")

(define (compiler-backend-vector-spill-pressure-mode-ok?
  [lower-mode : compiler_lower.CompilerLowerMode]
  [backend-mode : compiler_backend.CompilerBackendMode]
  [scratch : String]) : bool
  (match (compiler_lower.lower-compiler-source-with-mode
    (compiler-backend-vector-spill-pressure-source)
    lower-mode)
    [(compiler_lower.ResultCompilerLower.Ok program spans)
      (match (compiler_backend.compiler-backend-emit-program-target-with-mode
        program
        (compiler_backend.CompilerBackendTarget.Linux)
        backend-mode
        spans
        true)
        [(compiler_backend.ResultCompilerBackend.Ok asm)
          (and
            (compiler_backend.compiler-backend-string-contains? asm scratch)
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "vector spills are not implemented"))
            (not
              (compiler_backend.compiler-backend-string-contains?
                asm
                "vector register home unavailable")))]
        [(compiler_backend.ResultCompilerBackend.Err _) false])]
    [(compiler_lower.ResultCompilerLower.Err _) false]))

(define (compiler-backend-vector-spill-pressure-ok?) : bool
  (and
    (compiler-backend-vector-spill-pressure-mode-ok?
      (compiler_lower.CompilerLowerMode.Avx2)
      (compiler_backend.CompilerBackendMode.Avx2)
      "%ymm14")
    (compiler-backend-vector-spill-pressure-mode-ok?
      (compiler_lower.CompilerLowerMode.Avx512)
      (compiler_backend.CompilerBackendMode.Avx512)
      "%zmm14")))

(define (compiler-backend-simd-address-assignments) : compiler_regalloc.CompilerRegAssignmentList
  (compiler_regalloc.compiler-reg-assignment-cons
    (compiler_regalloc.CompilerRegAssignment
      0
      (compiler_regalloc.CompilerRegLocation.Register
        compiler_abi.compiler-reg-id-rdi))
    (compiler_regalloc.compiler-reg-assignment-cons
      (compiler_regalloc.CompilerRegAssignment
        1
        (compiler_regalloc.CompilerRegLocation.Register
          compiler_abi.compiler-reg-id-r12))
      (compiler_regalloc.compiler-reg-assignment-cons
        (compiler_regalloc.CompilerRegAssignment
          2
          (compiler_regalloc.CompilerRegLocation.Register
            compiler_abi.compiler-reg-id-rax))
        (compiler_regalloc.compiler-reg-assignment-cons
          (compiler_regalloc.CompilerRegAssignment
            3
            (compiler_regalloc.CompilerRegLocation.Register
              (compiler_abi.compiler-abi-vector-register-id 6)))
          (compiler_regalloc.compiler-reg-assignment-cons
            (compiler_regalloc.CompilerRegAssignment
              4
              (compiler_regalloc.CompilerRegLocation.Register
                (compiler_abi.compiler-abi-vector-register-id 7)))
            (compiler_regalloc.compiler-reg-assignment-cons
              (compiler_regalloc.CompilerRegAssignment
                5
                (compiler_regalloc.CompilerRegLocation.Register
                  (compiler_abi.compiler-abi-mask-register-id 1)))
              (compiler_regalloc.compiler-reg-assignment-cons
                (compiler_regalloc.CompilerRegAssignment
                  6
                  (compiler_regalloc.CompilerRegLocation.Register
                    compiler_abi.compiler-reg-id-rcx))
                compiler_regalloc.CompilerRegAssignmentList.Nil))))))))

(define (compiler-backend-simd-indexed-address-with-base-emits?
  [base : compiler_ir_types.CompilerIrValue]
  [index : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [want-asm : String]
  [want-addr : String]) : bool
  (match (compiler_backend.compiler-backend-emit-simd-indexed-address
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-simd-address-assignments)
    base
    index
    elem-ty
    ""
    "")
    [(compiler_backend.ResultCompilerBackendSimdIndexedAddress.Ok addr-plan)
      (and
        (string.eq (struct-get addr-plan asm) want-asm)
        (string.eq (struct-get addr-plan addr) want-addr))]
    [(compiler_backend.ResultCompilerBackendSimdIndexedAddress.Err _) false]))

(define (compiler-backend-simd-indexed-address-emits?
  [index : compiler_ir_types.CompilerIrValue]
  [elem-ty : compiler_ast_types.AstType]
  [want-asm : String]
  [want-addr : String]) : bool
  (compiler-backend-simd-indexed-address-with-base-emits?
    (compiler_ir_types.CompilerIrValue.Var 0)
    index
    elem-ty
    want-asm
    want-addr))

(define (compiler-backend-simd-indexed-address-ok?) : bool
  (and
    (compiler-backend-simd-indexed-address-emits?
      (compiler_ir_types.CompilerIrValue.I64 0)
      (compiler_ast_types.AstType.I64)
      ""
      "(%rdi)")
    (compiler-backend-simd-indexed-address-emits?
      (compiler_ir_types.CompilerIrValue.I64 4)
      (compiler_ast_types.AstType.I64)
      ""
      "32(%rdi)")
    (compiler-backend-simd-indexed-address-emits?
      (compiler_ir_types.CompilerIrValue.Var 1)
      (compiler_ast_types.AstType.I32)
      ""
      "(%rdi,%r12,4)")
    (compiler-backend-simd-indexed-address-emits?
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64)
      ""
      "(%rdi,%rax,8)")
    (compiler-backend-simd-indexed-address-with-base-emits?
      (compiler_ir_types.CompilerIrValue.Var 6)
      (compiler_ir_types.CompilerIrValue.Var 2)
      (compiler_ast_types.AstType.I64)
      ""
      "(%rcx,%rax,8)")
    (compiler-backend-simd-indexed-address-emits?
      (compiler_ir_types.CompilerIrValue.Var 7)
      (compiler_ast_types.AstType.I64)
      "    movq -64(%rbp), %r9\n"
      "(%rdi,%r9,8)")))

(define (compiler-backend-simd-indexed-address-planned-spills-ok?) : bool
  (let
    [before-pending : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-pending-count)]
    [before-used : i64
      (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-used-count)]
    (match (compiler_backend.compiler-backend-emit-simd-indexed-address
      (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
      (compiler-backend-simd-address-assignments)
      (compiler_ir_types.CompilerIrValue.Var 7)
      (compiler_ir_types.CompilerIrValue.Var 8)
      (compiler_ast_types.AstType.I64)
      "%r14"
      "%r13")
      [(compiler_backend.ResultCompilerBackendSimdIndexedAddress.Ok dynamic)
        (match (compiler_backend.compiler-backend-emit-simd-indexed-address
          (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
          (compiler-backend-simd-address-assignments)
          (compiler_ir_types.CompilerIrValue.Var 7)
          (compiler_ir_types.CompilerIrValue.I64 4)
          (compiler_ast_types.AstType.I64)
          "%r14"
          "%r13")
          [(compiler_backend.ResultCompilerBackendSimdIndexedAddress.Ok
              constant)
            (match (compiler_backend.compiler-backend-emit-simd-indexed-address
              (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
              (compiler-backend-simd-address-assignments)
              (compiler_ir_types.CompilerIrValue.Var 0)
              (compiler_ir_types.CompilerIrValue.I64 4)
              (compiler_ast_types.AstType.I64)
              "%r14"
              "%r13")
              [(compiler_backend.ResultCompilerBackendSimdIndexedAddress.Ok
                  homed)
                (and
                  (string.eq
                    (struct-get dynamic asm)
                    "    movq -64(%rbp), %r14\n    movq -72(%rbp), %r13\n")
                  (string.eq (struct-get dynamic addr) "(%r14,%r13,8)")
                  (string.eq
                    (struct-get constant asm)
                    "    movq -64(%rbp), %r14\n")
                  (string.eq (struct-get constant addr) "32(%r14)")
                  (not
                    (compiler_backend.compiler-backend-string-contains?
                      (struct-get constant asm)
                      "%r13"))
                  (string.eq (struct-get homed asm) "")
                  (string.eq (struct-get homed addr) "32(%rdi)")
                  (=
                    (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-pending-count)
                    before-pending)
                  (=
                    (compiler_backend.compiler-backend-test-get-compiler-backend-emergency-used-count)
                    before-used))]
              [(compiler_backend.ResultCompilerBackendSimdIndexedAddress.Err _)
                false])]
          [(compiler_backend.ResultCompilerBackendSimdIndexedAddress.Err _)
            false])]
      [(compiler_backend.ResultCompilerBackendSimdIndexedAddress.Err _) false])))

(define (compiler-backend-avx2-vector-load-address-ok?) : bool
  (match (compiler_backend.compiler-backend-emit-avx2-vector-load
    (compiler_ast_types.ast-node-pool-reader-type-segment-bases)
    (compiler-backend-simd-address-assignments)
    3
    (compiler_ir_types.CompilerIrValue.Var 0)
