(define (compiler-backend-descriptor-pair-spill-order-ok?) : bool
  (let
    [kind : ir.CompilerIrDescriptorPairKind (OwnedString)]
    [ty : ast.AstType (ir.compiler-ir-descriptor-pair-handle-type kind)]
    [program : ir.CompilerIrProgram (compiler-backend-descriptor-pair-program)]
    [index : be_state.CompilerBackendProgramIndex
      (match program
        [(Program _ functions externs _authority)
          (compiler-backend-program-index-build
            (ast.ast-node-pool-reader-type-segment-bases)
            functions
            externs)])]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=spill:-8 %1=%r12 %2=%r13")]
    [_group-enable : unit
      (begin
        (be_facts.compiler-backend-current-slot-vars-set! index.backend-state 3)
        (be_facts.compiler-backend-group-vars-enable!
          index.backend-state
          (compiler_liveness.compiler-live-set1 0)
          (compiler_liveness.compiler-live-set-empty)))]
    [packed : be_state.ResultCompilerBackend
      (be_scalar.compiler-backend-emit-pack
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        0
        (ir.compiler-ir-value-seq-prepend
          (& (I64 123))
          (&
            (ir.compiler-ir-value-seq-prepend
              (& (I64 42))
              (& (ir.compiler-ir-value-seq-empty)))))
        ty
        3
        index
        (cdiag.compiler-diagnostic-at-start "" "")
        index.backend-state)]
    [data : be_state.ResultCompilerBackend
      (be_scalar.compiler-backend-emit-word
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        1
        (Var 0)
        0
        (U64)
        3
        (cdiag.compiler-diagnostic-at-start "" "")
        index.backend-state)]
    [length : be_state.ResultCompilerBackend
      (be_scalar.compiler-backend-emit-word
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        2
        (Var 0)
        1
        (I64)
        3
        (cdiag.compiler-diagnostic-at-start "" "")
        index.backend-state)]
    [_group-disable : unit
      (be_facts.compiler-backend-group-vars-disable! index.backend-state)]
    (and
      (asm-ok? packed (has "$123, -8(%rbp)" "$42, -16(%rbp)"))
      (asm-ok? data (has "-8(%rbp), %r12"))
      (asm-ok? length (has "-16(%rbp), %r13")))))

(define (compiler-backend-descriptor-pair-register-order-ok?) : bool
  (let
    [kind : ir.CompilerIrDescriptorPairKind (OwnedString)]
    [ty : ast.AstType (ir.compiler-ir-descriptor-pair-handle-type kind)]
    [program : ir.CompilerIrProgram (compiler-backend-descriptor-pair-program)]
    [index : be_state.CompilerBackendProgramIndex
      (match program
        [(Program _ functions externs _authority)
          (compiler-backend-program-index-build
            (ast.ast-node-pool-reader-type-segment-bases)
            functions
            externs)])]
    [assignments : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12/%r13 %1=%rbx %2=%rsi %3=%r14/%r15")]
    [_group-enable : unit
      (begin
        (be_facts.compiler-backend-current-slot-vars-set! index.backend-state 4)
        (be_facts.compiler-backend-group-vars-enable!
          index.backend-state
          (compiler_liveness.compiler-live-set-insert
            (compiler_liveness.compiler-live-set1 0)
            3)
          (compiler_liveness.compiler-live-set-empty)))]
    [packed : be_state.ResultCompilerBackend
      (be_scalar.compiler-backend-emit-pack
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        0
        (ir.compiler-ir-value-seq-prepend
          (& (I64 123))
          (&
            (ir.compiler-ir-value-seq-prepend
              (& (I64 42))
              (& (ir.compiler-ir-value-seq-empty)))))
        (owned_view.compiler-owned-shared-view ty)
        4
        index
        (cdiag.compiler-diagnostic-at-start "" "")
        index.backend-state)]
    [data : be_state.ResultCompilerBackend
      (be_scalar.compiler-backend-emit-word
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        1
        (Var 0)
        0
        (U64)
        4
        (cdiag.compiler-diagnostic-at-start "" "")
        index.backend-state)]
    [length : be_state.ResultCompilerBackend
      (be_scalar.compiler-backend-emit-word
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        2
        (Var 0)
        1
        (I64)
        4
        (cdiag.compiler-diagnostic-at-start "" "")
        index.backend-state)]
    [copied : be_state.ResultCompilerBackend
      (be_calls.compiler-backend-emit-mov
        (ast.ast-node-pool-reader-type-segment-bases)
        assignments
        3
        (Var 0)
        ty
        index
        4
        index.backend-state)]
    [_group-disable : unit
      (be_facts.compiler-backend-group-vars-disable! index.backend-state)]
    (and
      (asm-ok? packed (has "$123, %r12" "$42, %r13"))
      (asm-ok? data (has "%r12, %rbx"))
      (asm-ok? length (has "%r13, %rsi"))
      (asm-ok? copied (has "%r12, %rax" "%rax, %r14" "%r13, %rdx" "%rdx, %r15")))))

(define (compiler-backend-descriptor-pair-object-main) : ir.CompilerIrFunction
  (let
    [kind : ir.CompilerIrDescriptorPairKind (OwnedString)]
    (Function
      (ci.intern "main")
      (ir.compiler-ir-param-seq-empty)
      (I64)
      4
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (compiler-backend-test-instr-seq-prepend
            (ir.ir-instr-descriptor-pair-pack 0 (& (I64 123)) (& (I64 42)) kind)
            (compiler-backend-test-instr-seq-prepend
              (irt.instr "%1 = mov %0 : String")
              (compiler-backend-test-instr-seq-prepend
                (ir.ir-instr-descriptor-pair-data 2 (Var 1))
                (compiler-backend-test-instr-seq-prepend
                  (ir.ir-instr-descriptor-pair-length 3 (Var 1))
                  (irt.instrs "return %3")))))))
      Ordinary)))

(define (compiler-backend-descriptor-pair-object-program) : ir.CompilerIrProgram
  (Program
    (ir.compiler-ir-global-seq-empty)
    (ir.compiler-ir-function-seq-prepend
      (& (compiler-backend-descriptor-pair-object-main))
      (& (ir.compiler-ir-function-seq-empty)))
    (ir.compiler-ir-extern-seq-empty)
    (ir.CompilerIrReturnStorageAuthority.None)))

(define (compiler-backend-descriptor-pair-object-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (match (be_object.compiler-backend-emit-program-object-image-target-with-mode-and-crt
    (compiler-backend-descriptor-pair-object-program)
    target
    (Scalar)
    (ir.compiler-source-spans-empty)
    true
    false)
    [(Ok image)
      (let
        [sections : cobj.CompilerObjectSectionList
          (owned_view.compiler-owned-shared-view image.sections)]
        [renders : bool
          (match target
            [(be_state.CompilerBackendTarget.Linux)
              (match (elf.compiler-object-elf-render image)
                [(Ok _) true]
                [(Err _) false])]
            [(be_state.CompilerBackendTarget.Windows)
              (match (coff.compiler-object-coff-render image)
                [(Ok _) true]
                [(Err _) false])])]
        (and
          renders
          ;; Four scalar vars plus two 2-word register-group vars (%0, %1).
          (cobj.compiler-object-section-contains-bytes?
            sections
            (&
              (be_object.compiler-backend-object-prologue-bytes
                (be_state.CompilerBackendTarget.Linux)
                (be_facts.compiler-backend-frame-size 8))))
          ;; Pack %0 word1 (slot 4), copy it to %1 word1 (slot 6), then extract it.
          (cobj.compiler-object-section-contains-bytes?
            sections
            (& (be_object.compiler-backend-object-store-slot-bytes 4 "%rdx")))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (&
              (be_object.compiler-backend-object-load-rbp-disp-bytes
                (be_object.compiler-backend-object-slot-disp 4)
                "%rdx")))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (& (be_object.compiler-backend-object-store-slot-bytes 6 "%rdx")))
          (cobj.compiler-object-section-contains-bytes?
            sections
            (&
              (be_object.compiler-backend-object-load-rbp-disp-bytes
                (be_object.compiler-backend-object-slot-disp 6)
                "%rax")))))]
    [(Err _) false]))

(define (compiler-backend-descriptor-pair-target-ok?
  [target : be_state.CompilerBackendTarget]) : bool
  (let
    [program : ir.CompilerIrProgram (compiler-backend-descriptor-pair-program)]
    [program-index : be_state.CompilerBackendProgramIndex
      (match (owned_view.compiler-owned-shared-view program)
        [(Program _ functions externs _authority)
          (compiler-backend-program-index-build
            (ast.ast-node-pool-reader-type-segment-bases)
            functions
            externs)])]
    (and
      ;; Owned String is an inline 2-word register-group descriptor pair.
      (=
        (be_facts.compiler-backend-group-word-count
          (ast.ast-node-pool-reader-type-segment-bases)
          program-index
          (String))
        2)
      (let
        [type-segment-bases (ast.ast-node-pool-reader-type-segment-bases)]
        [ty (ast.AstType.String)]
        (be_facts.compiler-backend-group-type?
          type-segment-bases
          program-index
          ty))
      (asm-ok?
        (backend.compiler-backend-emit-program-for-target
          (owned_view.compiler-owned-shared-view program)
          target)
        (has "    call _tl_f1\n"))
      (match (be_object.compiler-backend-emit-program-object-image-target-with-mode-and-crt
        program
        target
        (Scalar)
        (ir.compiler-source-spans-empty)
        true
        false)
        [(Ok _) true]
        [(Err _) false])
      (compiler-backend-descriptor-pair-object-target-ok? target))))

(define (compiler-backend-descriptor-pair-ok?) : bool
  (and
    (compiler-backend-descriptor-pair-spill-order-ok?)
    (compiler-backend-descriptor-pair-register-order-ok?)
    (compiler-backend-descriptor-pair-target-ok?
      (be_state.CompilerBackendTarget.Linux))
    (compiler-backend-descriptor-pair-target-ok?
      (be_state.CompilerBackendTarget.Windows))))

(define (compiler-backend-object-windows-stack-probe-ok?) : bool
  (let
    [linux : String
      (be_object.compiler-backend-object-prologue-bytes
        (be_state.CompilerBackendTarget.Linux)
        8192)]
    [windows : String
      (be_object.compiler-backend-object-prologue-bytes
        (be_state.CompilerBackendTarget.Windows)
        8192)]
    [direct : String
      (object_target.compiler-backend-object-bytes-from-hex
        "554889e54881ec00200000")]
    [probed : String
      (object_target.compiler-backend-object-bytes-from-hex
        "554889e54881ec00100000830c24004881ec00100000")]
    (and (string.eq linux direct) (string.eq windows probed))))

(define (compiler-backend-object-runtime-state-encoding-ok?) : bool
  (and
    ;; C7 /0 is compact but sign-extends imm32. The direct-object path must use
    ;; B8+r for wider values; native TLCI literal callbacks depend on all 64
    ;; bits surviving into their mapped entry. An imm32 value is a machine
    ;; record, whose encoding compiler_machine_x64_tests pins.
    (let
      [parts : object_target.CompilerBackendObjectTargetParts
        (be_object.compiler-backend-object-add-mov-i64
          (object_target.compiler-backend-object-parts-empty)
          42
          "%rdx")]
      [text : cobj.CompilerObjectX64InstrList
        (cobj.compiler-object-instr-builder-finish parts.text)]
      (match (cobj.compiler-object-instr-list-ref text 0)
        [(Machine (MovRI (W64) 2 42)) true]
        [_ false]))
    (string.eq
      (be_object.compiler-backend-object-mov-wide-reg-bytes
        6364136223846793005
        "%rax")
      (object_target.compiler-backend-object-bytes-from-hex
        "48b82d7f954c2df45158"))
    (string.eq
      (be_object.compiler-backend-object-mov-wide-reg-bytes -2147483649 "%r9")
      (object_target.compiler-backend-object-bytes-from-hex
        "49b9ffffff7fffffffff"))
    (string.eq
      (be_object.compiler-backend-object-lea-rbp-disp-bytes -64 "%rax")
      (object_target.compiler-backend-object-bytes-from-hex "488d45c0"))
    (compiler-backend-object-compare-zero-hex?
      (Eq)
      (I64)
      "4885c00f94c0480fb6c0")
    (string.eq
      (be_object.compiler-backend-object-divmod-bytes false false)
      (object_target.compiler-backend-object-bytes-from-hex "31d249f7f0"))
    (string.eq
      (be_object.compiler-backend-object-divmod-bytes false true)
      (object_target.compiler-backend-object-bytes-from-hex "31d249f7f04889d0"))
    (string.eq
      (be_object.compiler-backend-object-divmod-bytes true false)
      (object_target.compiler-backend-object-bytes-from-hex "489949f7f8"))
    (string.eq
      (be_object.compiler-backend-object-divmod-bytes true true)
      (object_target.compiler-backend-object-bytes-from-hex "489949f7f84889d0"))))

(define (compiler-backend-reg-part-entry-ok?
  [reg : String]
  [reg32 : String]
  [reg16 : String]
  [reg8 : String]) : bool
  (and
    (string.eq (be_operand.compiler-backend-reg-part (string.copy reg) 8) reg)
    (string.eq (be_operand.compiler-backend-reg-part (string.copy reg) 4) reg32)
    (string.eq (be_operand.compiler-backend-reg-part (string.copy reg) 2) reg16)
    (string.eq (be_operand.compiler-backend-reg-part (string.copy reg) 1) reg8)))

(define (compiler-backend-reg-part-known-entry-ok? [reg : String]) : bool
  (cond
    [(string.eq reg "%rax")
      (compiler-backend-reg-part-entry-ok? reg "%eax" "%ax" "%al")]
    [(string.eq reg "%rbx")
      (compiler-backend-reg-part-entry-ok? reg "%ebx" "%bx" "%bl")]
    [(string.eq reg "%rcx")
      (compiler-backend-reg-part-entry-ok? reg "%ecx" "%cx" "%cl")]
    [(string.eq reg "%rdx")
      (compiler-backend-reg-part-entry-ok? reg "%edx" "%dx" "%dl")]
    [(string.eq reg "%rdi")
      (compiler-backend-reg-part-entry-ok? reg "%edi" "%di" "%dil")]
    [(string.eq reg "%rsi")
      (compiler-backend-reg-part-entry-ok? reg "%esi" "%si" "%sil")]
    [(string.eq reg "%r8")
      (compiler-backend-reg-part-entry-ok? reg "%r8d" "%r8w" "%r8b")]
    [(string.eq reg "%r9")
      (compiler-backend-reg-part-entry-ok? reg "%r9d" "%r9w" "%r9b")]
    [(string.eq reg "%r10")
      (compiler-backend-reg-part-entry-ok? reg "%r10d" "%r10w" "%r10b")]
    [(string.eq reg "%r11")
      (compiler-backend-reg-part-entry-ok? reg "%r11d" "%r11w" "%r11b")]
    [(string.eq reg "%r12")
      (compiler-backend-reg-part-entry-ok? reg "%r12d" "%r12w" "%r12b")]
    [(string.eq reg "%r13")
      (compiler-backend-reg-part-entry-ok? reg "%r13d" "%r13w" "%r13b")]
    [(string.eq reg "%r14")
      (compiler-backend-reg-part-entry-ok? reg "%r14d" "%r14w" "%r14b")]
    [(string.eq reg "%r15")
      (compiler-backend-reg-part-entry-ok? reg "%r15d" "%r15w" "%r15b")]
    [(string.eq reg "%rbp")
      (compiler-backend-reg-part-entry-ok? reg "%ebp" "%bp" "%bpl")]
    [else false]))

(define (compiler-backend-reg-part-seq-ok? [regs : regalloc.CompilerRegIdSeq]) : bool
  (let
    [index : i64 0]
    [ok : bool true]
    (while (and (< index (regalloc.compiler-reg-id-seq-count regs)) ok)
      (if (compiler-backend-reg-part-known-entry-ok?
        (cabi.compiler-abi-register-spelling
          (regalloc.compiler-reg-id-seq-ref regs index)))
        unit
        (set! ok false))
      (+= index 1))
    ok))

(define (compiler-backend-reg-part-pools-ok?) : bool
  (and
    (compiler-backend-reg-part-seq-ok?
      (regalloc.compiler-reg-sysv-integer-registers-with-rbp))
    (compiler-backend-reg-part-seq-ok?
      (reg_tests.compiler-reg-zero-call-caller-saved-integer-registers))
    (compiler-backend-reg-part-seq-ok?
      (reg_tests.compiler-reg-sysv-caller-saved-integer-registers))
    (compiler-backend-reg-part-seq-ok?
      (reg_tests.compiler-reg-sysv-callee-saved-integer-registers))
    (compiler-backend-reg-part-seq-ok?
      (reg_tests.compiler-reg-win64-caller-saved-integer-registers))
    (compiler-backend-reg-part-seq-ok?
      (regalloc.compiler-reg-win64-callee-saved-integer-registers))
    (compiler-backend-reg-part-seq-ok?
      (regalloc.compiler-reg-greedy-div-clobber-registers))))

(define (compiler-backend-scavenge-emergency-reg-support-ok?) : bool
  (and
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%rax")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%rcx")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%rdx")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%r8")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%r9")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%r10")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%r11")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%r12")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%r13")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%r14")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%r15")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%rbx")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%rsi")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%rdi")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%xmm2")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%xmm3")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%xmm4")
    (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%xmm5")
    (not (be_operand.compiler-backend-scavenge-emergency-reg-supported? "%r16"))))

(define (compiler-backend-debug-location-preserves-emergency-wrap-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [previous-offset : i64
      (scratch-emergency-slot-offset
        (be_state.compiler-backend-state-function-state backend-state))]
    (set-scratch-emergency-pending!
      (be_state.compiler-backend-state-function-state backend-state)
      false)
    (set-scratch-emergency-used!
      (be_state.compiler-backend-state-function-state backend-state)
      false)
    (set-scratch-emergency-pending-count!
      (be_state.compiler-backend-state-function-state backend-state)
      0)
    (set-scratch-emergency-used-count!
      (be_state.compiler-backend-state-function-state backend-state)
      0)
    (set-scratch-emergency-slot-offset!
      (be_state.compiler-backend-state-function-state backend-state)
      -64)
    (be_operand.compiler-backend-emergency-add!
      (be_state.compiler-backend-state-function-state backend-state)
      "%r9")
    (let
      ;; T1-6 (b), bracket 1: the instruction provably never touches %r9
      ;; (%r8..%r15 have no implicit uses, and there is no `call`), so the
      ;; save/restore pair the scavenger enqueued is dropped outright.
      [rendered : String
        (text_buf.render
          (backend.compiler-backend-append-located-instr
            (text_buf.empty)
            "    .loc 1 2 3\n"
            "    shlq %cl, %r10\n"
            backend-state))]
      [_second : unit
        (be_operand.compiler-backend-emergency-add!
          (be_state.compiler-backend-state-function-state backend-state)
          "%r9")]
      ;; Bracket 2: the instruction DOES write %r9, and it is call-free, so
      ;; the value is parked in a free XMM register -- no frame slot.
      [rendered-park : String
        (text_buf.render
          (backend.compiler-backend-append-located-instr
            (text_buf.empty)
            "    .loc 1 2 3\n"
            "    shlq %cl, %r9\n"
            backend-state))]
      [_third : unit
        (be_operand.compiler-backend-emergency-add!
          (be_state.compiler-backend-state-function-state backend-state)
          "%r9")]
      ;; Bracket 3: a `call` hands every caller-saved XMM register to the
      ;; callee, so that bracket falls back to the emergency frame slot.
      [rendered-call : String
        (text_buf.render
          (backend.compiler-backend-append-located-instr
            (text_buf.empty)
            "    .loc 1 2 3\n"
            "    call _tl_sink\n"
            backend-state))]
      [ok : bool
        (and
          (string.eq rendered "    .loc 1 2 3\n    shlq %cl, %r10\n")
          (string.eq
            rendered-park
            "    .loc 1 2 3\n    movq %r9, %xmm4\n    shlq %cl, %r9\n    movq %xmm4, %r9\n")
          (string.eq
            rendered-call
            "    .loc 1 2 3\n    movq %r9, -64(%rbp)\n    call _tl_sink\n    movq -64(%rbp), %r9\n"))]
      (set-scratch-emergency-pending!
        (be_state.compiler-backend-state-function-state backend-state)
        false)
      (set-scratch-emergency-used!
        (be_state.compiler-backend-state-function-state backend-state)
        false)
      (set-scratch-emergency-pending-count!
        (be_state.compiler-backend-state-function-state backend-state)
        0)
      (set-scratch-emergency-used-count!
        (be_state.compiler-backend-state-function-state backend-state)
        0)
      (set-scratch-emergency-slot-offset!
        (be_state.compiler-backend-state-function-state backend-state)
        previous-offset)
      ok)))

;; A non-scalar branch condition (notably a Global) is materialized through the
;; generic load path. If that path emergency-borrows a live register, restore it
;; after `testq` but before the first jump so both successors observe the saved
;; value. The Var branch path already used the shared jump emitter; this pins the
;; generic path to the same rule.
(define (compiler-backend-global-branch-emergency-restore-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [function-state : be_state.CompilerBackendFunctionState
      (be_state.compiler-backend-state-function-state backend-state)]
    [_slot : unit (set-scratch-emergency-slot-offset! function-state -64)]
    [_pending : unit
      (be_operand.compiler-backend-emergency-add! function-state "%r9")]
    (match (be_scalar.compiler-backend-emit-branch
      (regalloc.compiler-reg-assignment-table-empty)
      "global_branch_restore"
      (Global (ci.intern "global_branch_restore_condition"))
      (ir.compiler-ir-label "yes")
      (ir.compiler-ir-label "no")
      (No)
      backend-state)
      [(Ok asm)
        (let
          [test-pos : i64
            (backend.compiler-backend-string-find-from
              asm
              "    testq %r9, %r9\n"
              0)]
          [restore-pos : i64
            (backend.compiler-backend-string-find-from
              asm
              "    movq -64(%rbp), %r9\n"
              0)]
          [jump-pos : i64
            (backend.compiler-backend-string-find-from asm "    jne " 0)]
          (and
            (>= test-pos 0)
            (> restore-pos test-pos)
            (> jump-pos restore-pos)
            (scratch-emergency-restore-suppressed function-state)))]
      [(Err _) false])))

(define (compiler-backend-ir-walker-call-use-counts-ok?) : bool
  (let
    [counts : (__tl_dyn-array i64) (__tl_make-array i64 12)]
    [ids : ir.CompilerIrIdList (ir.compiler-ir-id-list-new)]
    (backend.compiler-backend-count-instr-uses
      (&mut counts)
      (& (irt.instr "%0 = call* %1(%2, %3) : i64"))
      (&mut ids))
    (backend.compiler-backend-count-instr-uses
      (&mut counts)
      (& (irt.instr "%4 = call_c* %4(%5) : i64"))
      (&mut ids))
    (backend.compiler-backend-count-instr-uses
      (&mut counts)
      (&
        (ann
          (TailCall (ci.intern "tail") (Two (Var 6) (Var 7)) (I64))
          : ir.CompilerIrInstr))
      (&mut ids))
    (backend.compiler-backend-count-instr-uses
      (&mut counts)
      (& (irt.instr "tailcall* %8(%9, %10) : i64"))
      (&mut ids))
    (and
      (be_state.backend-and8
        (= (array-ref counts 1) 1)
        (= (array-ref counts 2) 1)
        (= (array-ref counts 3) 1)
        (= (array-ref counts 4) 1)
        (= (array-ref counts 5) 1)
        (= (array-ref counts 6) 1)
        (= (array-ref counts 7) 1)
        (= (array-ref counts 8) 1))
      (= (array-ref counts 9) 1)
      (= (array-ref counts 10) 1))))

(define (compiler-backend-ir-walker-collections-ok?) : bool
  (let
    [ty : ast.AstType (compiler-backend-register-group-test-type)]
    [values : ir.CompilerIrValueSeq
      (ir.compiler-ir-value-seq-prepend
        (& (Function (ci.intern "walked_fn")))
        (&
          (ir.compiler-ir-value-seq-prepend
            (& (String "walked-string"))
            (&
              (ir.compiler-ir-value-seq-prepend
                (& (F64 (compiler-backend-test-f64-bits "2.5")))
                (& (ir.compiler-ir-value-seq-empty)))))))]
    [packed : be_state.CompilerBackendProgramCollections
      (be_facts.compiler-backend-collect-instr-collections
        (compiler-backend-program-collections-new)
        (Pack 0 values (owned_view.compiler-owned-shared-view ty)))]
    [worded : be_state.CompilerBackendProgramCollections
      (be_facts.compiler-backend-collect-instr-collections
        packed
        (Word 1 (String "word-string") 0 ty))]
    (and
      (let
        [items
          (be_data.compiler-backend-program-collections-functions
            (owned_view.compiler-owned-shared-view worded))]
        (be_state.compiler-backend-symbol-list-contains-id?
          items
          (ci.intern "walked_fn")))
      (compiler-backend-string-list-contains?
        (be_data.compiler-backend-program-collections-strings
          (owned_view.compiler-owned-shared-view worded))
        "walked-string")
      (compiler-backend-string-list-contains?
        (be_data.compiler-backend-program-collections-strings
          (owned_view.compiler-owned-shared-view worded))
        "word-string")
      (compiler-backend-test-float-seq-contains?
        (be_data.compiler-backend-program-collections-floats worded)
        (F64)
        (compiler-backend-test-f64-bits "2.5")))))

(define (compiler-backend-ir-walker-program-collections-ok?) : bool
  (let
    [call-array : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue 2)]
    (set!
      (array-ref call-array 0)
      (ir.CompilerIrValue.F64 (compiler-backend-test-f64-bits "8.5")))
    (set! (array-ref call-array 1) (ir.CompilerIrValue.Bytes "arg-bytes"))
    (let
      [instrs : ir.CompilerIrInstrSeq
        (compiler-backend-test-instr-seq-prepend
          (Call
            0
            (ci.intern "direct")
            (Two (Function (ci.intern "call_fn")) (String "call-string"))
            (I64))
          (compiler-backend-test-instr-seq-prepend
            (CallIndirect
              1
              (Function (ci.intern "indirect_fn"))
              (Array call-array)
              (I64))
            (compiler-backend-test-instr-seq-prepend
              (Phi
                2
                (ir.compiler-ir-phi-input-seq-prepend
                  (String "phi-string")
                  (ir.compiler-ir-label "entry")
                  (& (ir.compiler-ir-phi-input-seq-empty)))
                (String))
              (compiler-backend-test-instr-seq-prepend
                (Return (Some (Bytes "return-bytes")))
                (ir.compiler-ir-instr-seq-empty)))))]
      [blocks : ir.CompilerIrBlockList
        (ir.compiler-ir-blocks
          (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") instrs))]
      [functions : ir.CompilerIrFunctionSeq
        (ir.compiler-ir-function-seq-prepend
          (&
            (Function
              (ci.intern "main")
              (ir.compiler-ir-param-seq-empty)
              (I64)
              3
              blocks
              Ordinary))
          (& (ir.compiler-ir-function-seq-empty)))]
      [globals : ir.CompilerIrGlobalSeq
        (compiler-backend-test-global-seq-single
          "global_text"
          (String)
          (String "global-string"))]
      [collections : be_state.CompilerBackendProgramCollections
        (compiler-backend-collect-program-collections
          (Program
            globals
            functions
            (ir.compiler-ir-extern-seq-empty)
            (ir.CompilerIrReturnStorageAuthority.None)))]
      (and
        (let
          [items
            (be_data.compiler-backend-program-collections-functions
              (owned_view.compiler-owned-shared-view collections))]
          (be_state.compiler-backend-symbol-list-contains-id?
            items
            (ci.intern "call_fn")))
        (let
          [items
            (be_data.compiler-backend-program-collections-functions
              (owned_view.compiler-owned-shared-view collections))]
          (be_state.compiler-backend-symbol-list-contains-id?
            items
            (ci.intern "indirect_fn")))
        (compiler-backend-string-list-contains?
          (be_data.compiler-backend-program-collections-strings
            (owned_view.compiler-owned-shared-view collections))
          "global-string")
        (compiler-backend-string-list-contains?
          (be_data.compiler-backend-program-collections-strings
            (owned_view.compiler-owned-shared-view collections))
          "call-string")
        (compiler-backend-string-list-contains?
          (be_data.compiler-backend-program-collections-strings
            (owned_view.compiler-owned-shared-view collections))
          "phi-string")
        (compiler-backend-test-float-seq-contains?
          (be_data.compiler-backend-program-collections-floats
            (owned_view.compiler-owned-shared-view collections))
          (F64)
          (compiler-backend-test-f64-bits "8.5"))
        (compiler-backend-string-list-contains?
          (be_data.compiler-backend-program-collections-bytes
            (owned_view.compiler-owned-shared-view collections))
          "arg-bytes")
        (compiler-backend-string-list-contains?
          (be_data.compiler-backend-program-collections-bytes collections)
          "return-bytes")))))

(define (compiler-backend-ir-walker-group-metadata-array-ok?) : bool
  (let
    [plain-id : i64 (ci.intern "Issue5838Rooted")]
    [root-qualified-id : i64 (ci.intern "/Issue5838Rooted")]
    [qualified-id : i64 (ci.intern "issue5838/Collision")]
    [opaque-id : i64 (ci.intern-generated-canonical-name "issue5838/Collision")]
    [plain-key : i64 (ast.ast-nominal-name-id-key plain-id)]
    [root-key : i64 (ast.ast-nominal-name-id-key root-qualified-id)]
    [qualified-key : i64 (ast.ast-nominal-name-id-key qualified-id)]
    [opaque-key : i64 (ast.ast-nominal-name-id-key opaque-id)]
    [lifetimes : ast.AstLifetimeList (ast.ast-lifetime-list-new)]
    [struct-plain : ast.AstType (Struct plain-id)]
    [struct-args-root : ast.AstType
      (StructArgs
        root-qualified-id
        (box (owned_view.compiler-owned-shared-view lifetimes)))]
    [enum-qualified : ast.AstType (Enum qualified-id)]
    [enum-args-qualified : ast.AstType (EnumArgs qualified-id (box lifetimes))]
    [opaque-struct : ast.AstType (Struct opaque-id)]
    [qualified-type-id : i64
      (ast.ast-node-pool-reader-type-push (& enum-qualified))]
    [region-qualified : ast.AstType
      (Region (ci.intern "issue5838-region") qualified-type-id)]
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    [words-mask2 : ir.CompilerIrValueSeq
      (ir.compiler-ir-value-seq-prepend
        (& (I64 1))
        (&
          (ir.compiler-ir-value-seq-prepend
            (& (F64 (compiler-backend-test-f64-bits "3.5")))
            (& (ir.compiler-ir-value-seq-empty)))))]
    [words-opaque : ir.CompilerIrValueSeq
      (ir.compiler-ir-value-seq-prepend
        (& (F64 (compiler-backend-test-f64-bits "5.5")))
        (& (ir.compiler-ir-value-seq-empty)))]
    [instrs : ir.CompilerIrInstrSeq
      (compiler-backend-test-instr-seq-prepend
        (Pack
          0
          (owned_view.compiler-owned-shared-view words-mask2)
          (owned_view.compiler-owned-shared-view struct-plain))
        (compiler-backend-test-instr-seq-prepend
          (Pack
            1
            (owned_view.compiler-owned-shared-view words-mask2)
            (owned_view.compiler-owned-shared-view struct-args-root))
          (compiler-backend-test-instr-seq-prepend
            (Pack
              2
              (owned_view.compiler-owned-shared-view words-mask2)
              (owned_view.compiler-owned-shared-view enum-qualified))
            (compiler-backend-test-instr-seq-prepend
              (Pack
                3
                words-mask2
                (owned_view.compiler-owned-shared-view enum-args-qualified))
              (compiler-backend-test-instr-seq-prepend
                (Pack
                  4
                  words-opaque
                  (owned_view.compiler-owned-shared-view opaque-struct))
                (ir.compiler-ir-instr-seq-empty))))))]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block (ir.compiler-ir-label "entry") instrs))]
    [functions : ir.CompilerIrFunctionSeq
      (ir.compiler-ir-function-seq-prepend
        (&
          (Function
            (ci.intern "main")
            (ir.compiler-ir-param-seq-empty)
            (I64)
            5
            blocks
            Ordinary))
        (& (ir.compiler-ir-function-seq-empty)))]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        bases
        functions
        (ir.compiler-ir-extern-seq-empty))]
    [representations : ir.CompilerIrRepresentationIndex
      (be_state.compiler-backend-program-index-representations index)]
    (and
      (= plain-key root-key)
      (not (= qualified-key opaque-key))
      (string.eq
        (be_facts.compiler-backend-aggregate-type-name
          bases
          (owned_view.compiler-owned-shared-view enum-qualified))
        (be_facts.compiler-backend-aggregate-type-name
          bases
          (owned_view.compiler-owned-shared-view opaque-struct)))
      (match (ast.ast-aggregate-type-key bases (& struct-plain))
        [(Some key) (= key plain-key)]
        [(None) false])
      (match (ast.ast-aggregate-type-key bases (& struct-args-root))
        [(Some key) (= key plain-key)]
        [(None) false])
      (match (ast.ast-aggregate-type-key bases (& enum-qualified))
        [(Some key) (= key qualified-key)]
        [(None) false])
      (match (ast.ast-aggregate-type-key bases (& enum-args-qualified))
        [(Some key) (= key qualified-key)]
        [(None) false])
      (match (ast.ast-aggregate-type-key bases (& region-qualified))
        [(Some key) (= key qualified-key)]
        [(None) false])
      (match (ast.ast-aggregate-type-key bases (& (I64)))
        [(Some _) false]
        [(None) true])
      (match (ir.compiler-ir-representation-index-kind-for-key
        representations
        plain-key)
        [(RegisterGroup count mask) (and (= count 2) (= mask 2))]
        [_ false])
      (match (ir.compiler-ir-representation-index-kind-for-key
        representations
        qualified-key)
        [(RegisterGroup count mask) (and (= count 2) (= mask 2))]
        [_ false])
      (match (ir.compiler-ir-representation-index-kind-for-key
        representations
        opaque-key)
        [(Unknown) true]
        [_ false])
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view struct-plain))
        2)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view struct-args-root))
        2)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view enum-qualified))
        2)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view enum-args-qualified))
        2)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view region-qualified))
        2)
      (=
        (be_facts.compiler-backend-group-word-count
          bases
          index
          (owned_view.compiler-owned-shared-view opaque-struct))
        1)
      (= (be_facts.compiler-backend-group-word-count bases index (I64)) 1)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view struct-plain))
        2)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view struct-args-root))
        2)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view enum-qualified))
        2)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view enum-args-qualified))
        2)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view region-qualified))
        2)
      (=
        (be_facts.compiler-backend-group-word-class-mask
          bases
          index
          (owned_view.compiler-owned-shared-view opaque-struct))
        0)
      (regalloc.compiler-reg-type-register-group?
        bases
        (& (be_state.compiler-backend-program-index-representations index))
        (& struct-plain))
      (regalloc.compiler-reg-type-register-group?
        bases
        (& (be_state.compiler-backend-program-index-representations index))
        (& struct-args-root))
      (regalloc.compiler-reg-type-register-group?
        bases
        (& (be_state.compiler-backend-program-index-representations index))
        (& enum-qualified))
      (regalloc.compiler-reg-type-register-group?
        bases
        (& (be_state.compiler-backend-program-index-representations index))
        (& enum-args-qualified))
      (regalloc.compiler-reg-type-register-group?
        bases
        (& (be_state.compiler-backend-program-index-representations index))
        (& region-qualified))
      (not
        (regalloc.compiler-reg-type-register-group?
          bases
          (& (be_state.compiler-backend-program-index-representations index))
          (& opaque-struct)))
      (reg_tests.compiler-reg-type-register-group-word-sse?
        bases
        (be_state.compiler-backend-program-index-representations index)
        struct-plain
        1)
      (reg_tests.compiler-reg-type-register-group-word-sse?
        bases
        (be_state.compiler-backend-program-index-representations index)
        struct-args-root
        1)
      (reg_tests.compiler-reg-type-register-group-word-sse?
        bases
        (be_state.compiler-backend-program-index-representations index)
        (owned_view.compiler-owned-shared-view enum-qualified)
        1)
      (not
        (reg_tests.compiler-reg-type-register-group-word-sse?
          bases
          (be_state.compiler-backend-program-index-representations index)
          enum-qualified
          0))
      (not
        (reg_tests.compiler-reg-type-register-group-word-sse?
          bases
          (be_state.compiler-backend-program-index-representations index)
          (owned_view.compiler-owned-shared-view opaque-struct)
          0))
      (not
        (reg_tests.compiler-reg-type-register-group-word-sse?
          bases
          (be_state.compiler-backend-program-index-representations index)
          opaque-struct
          1)))))

(define (compiler-backend-ir-walker-object-refs-with-plan
  [plan : be_state.CompilerBackendRuntimePlan]) : bool
  (let
    [ty : ast.AstType (compiler-backend-register-group-test-type)]
    [word-target-id : i64 (ci.intern "word_target")]
    [index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [values : ir.CompilerIrValueSeq
      (ir.compiler-ir-value-seq-prepend
        (& (String "object-walked"))
        (&
          (ir.compiler-ir-value-seq-prepend
            (& (F64 (compiler-backend-test-f64-bits "6.25")))
            (& (ir.compiler-ir-value-seq-empty)))))]
    [packed : object_target.CompilerBackendObjectTargetParts
      (be_object.compiler-backend-object-instr
        (ast.ast-node-pool-reader-type-segment-bases)
        (object_target.compiler-backend-object-parts-empty)
        (be_state.CompilerBackendTarget.Linux)
        "main"
        "main"
        (ir.compiler-ir-label "entry")
        (ir.compiler-ir-block-list-empty)
        (Pack 0 values (owned_view.compiler-owned-shared-view ty))
        plan
        index)]
    [worded : object_target.CompilerBackendObjectTargetParts
      (be_object.compiler-backend-object-instr
        (ast.ast-node-pool-reader-type-segment-bases)
        packed
        (be_state.CompilerBackendTarget.Linux)
        "main"
        "main"
        (ir.compiler-ir-label "entry")
        (ir.compiler-ir-block-list-empty)
        (Word 1 (Function word-target-id) 0 ty)
        plan
        index)]
    [relocs : cobj.CompilerObjectRelocationList
      (cobj.compiler-object-relocation-builder-finish worded.relocations)]
    (and
      (let
        [kind (cobj.CompilerObjectRelocationKind.RipAddress)]
        [target (be_operand.compiler-backend-string-data-label "object-walked")]
        (cobj.compiler-object-relocation-list-contains? relocs kind target))
      (let
        [kind (cobj.CompilerObjectRelocationKind.RipValue)]
        [target
          (be_facts.compiler-backend-f64-label
            (compiler-backend-test-f64-bits "6.25"))]
        (cobj.compiler-object-relocation-list-contains? relocs kind target))
      (let
        [kind (cobj.CompilerObjectRelocationKind.RipAddress)]
        [target
          (be_operand.compiler-backend-closure-descriptor-label "word_target")]
        (cobj.compiler-object-relocation-list-contains? relocs kind target)))))

(define (compiler-backend-ir-walker-object-refs-ok?) : bool
  (match (compiler-backend-runtime-plan (irt.program ""))
    [(Ok plan) (compiler-backend-ir-walker-object-refs-with-plan plan)]
    [(Err _) false]))

(define (compiler-backend-ir-walkers-fail-closed-ok?) : bool
  (and
    (compiler-backend-ir-walker-call-use-counts-ok?)
    (compiler-backend-ir-walker-collections-ok?)
    (compiler-backend-ir-walker-program-collections-ok?)
    (compiler-backend-ir-walker-group-metadata-array-ok?)
    (compiler-backend-ir-walker-object-refs-ok?)))

(define (compiler-backend-peephole-asm-ok?) : bool
  (let
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-peephole-assignments)]
    (match (be_scalar.compiler-backend-emit-binop
      (ast.ast-node-pool-reader-type-segment-bases)
      (regalloc.compiler-reg-var-types-empty)
      (Empty)
      assignments
      2
      (Add)
      (Var 0)
      (I64 5)
      (I64)
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(Ok add-asm)
        (match (be_scalar.compiler-backend-emit-binop
          (ast.ast-node-pool-reader-type-segment-bases)
          (regalloc.compiler-reg-var-types-empty)
          (Empty)
          assignments
          2
          (Mul)
          (Var 0)
          (I64 3)
          (I64)
          (be_state.compiler-backend-state-new
            (ci.intern-compat-state-capture-active)))
          [(Ok mul-asm)
            (match (be_scalar.compiler-backend-emit-binop
              (ast.ast-node-pool-reader-type-segment-bases)
              (regalloc.compiler-reg-var-types-empty)
              (Empty)
              assignments
              2
              (Shl (I64))
              (Var 0)
              (I64 2)
              (I64)
              (be_state.compiler-backend-state-new
                (ci.intern-compat-state-capture-active)))
              [(Ok shl-asm)
                (match (be_scalar.compiler-backend-emit-binop
                  (ast.ast-node-pool-reader-type-segment-bases)
                  (regalloc.compiler-reg-var-types-empty)
                  (Empty)
                  assignments
                  2
                  (Lt)
                  (Var 0)
                  (I64 10)
                  (I64)
                  (be_state.compiler-backend-state-new
                    (ci.intern-compat-state-capture-active)))
                  [(Ok cmp-asm)
                    (match (be_scalar.compiler-backend-emit-branch
                      assignments
                      "peephole"
                      (Var 0)
                      (ir.compiler-ir-label "then")
                      (ir.compiler-ir-label "else")
                      (No)
                      (be_state.compiler-backend-state-new
                        (ci.intern-compat-state-capture-active)))
                      [(Ok branch-asm)
                        (and
                          (asm-has? add-asm "    leaq 5(%r12), %r13\n")
                          (asm-lacks? add-asm "    addq $5, %rax\n")
                          (asm-has? mul-asm "    leaq (%r12,%r12,2), %r13\n")
                          (asm-lacks? mul-asm "    imulq $3, %rax\n")
                          (asm-has? shl-asm "    shlq $2, %r13\n")
                          (asm-lacks? shl-asm "    movq $2, %r8\n")
                          (asm-has?
                            cmp-asm
                            "    cmpq $10, %r13\n    setl %r13b\n")
                          (asm-has? branch-asm "    testq %r12, %r12\n    jne ")
                          (asm-lacks?
                            branch-asm
                            "    movq %r12, %rax\n"
                            "    cmpq $0, %rax\n    jne "))]
                      [(Err _) false])]
                  [(Err _) false])]
              [(Err _) false])]
          [(Err _) false])]
      [(Err _) false])))

;; The `movq $7, %rax` line exists to CLOBBER %rax so the reload that follows it
;; is not elided. P22-A2 (a movq that fully redefines a register immediately
;; after another movq into it drops the first) would delete that clobber and
;; Explicit peephole session used by stateful carry/sweep tests. Production
;; wrappers create the same pair per standalone call; these tests keep it only
;; when they intentionally seed metadata before running the pass.
(defstruct CompilerBackendPeepholeTestSession
  (backend-state be_state.CompilerBackendState)
  (stream be_state.CompilerBackendStreamState))

(define (compiler-backend-peephole-test-session-new) : CompilerBackendPeepholeTestSession
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    (CompilerBackendPeepholeTestSession
      backend-state
      (be_state.compiler-backend-state-stream-state backend-state))))

(define (compiler-backend-peephole-test-session-reset!
  [session : CompilerBackendPeepholeTestSession]) : unit
  (be_state.compiler-backend-peephole-carry-safe-reset-with-backend-state!
    session.backend-state
    session.stream)
  (backend.compiler-backend-sweep-reset! session.backend-state session.stream))

(define (compiler-backend-peephole-test-session-asm
  [session : CompilerBackendPeepholeTestSession]
  [asm : String]) : String
  (text_buf.render
    (backend.compiler-backend-peephole-asm-buffer-with-state
      session.backend-state
      session.stream
      asm
      false
      false)))

(define (compiler-backend-peephole-test-session-win64!
  [session : CompilerBackendPeepholeTestSession]
  [symbol : String]
  [frame : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]) : unit
  (backend.compiler-backend-sweep-record-win64!
    session.backend-state
    session.stream
    symbol
    frame
    slot-vars
    em-slot-offset
    em-used-count
    outgoing))

(define (compiler-backend-peephole-test-win64-asm
  [symbol : String]
  [frame : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]
  [asm : String]) : String
  (let
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    (compiler-backend-peephole-test-session-reset! session)
    (compiler-backend-peephole-test-session-win64!
      session
      symbol
      frame
      slot-vars
      em-slot-offset
      em-used-count
      outgoing)
    (compiler-backend-peephole-test-session-asm session asm)))

(define (compiler-backend-peephole-test-fpo-asm
  [symbol : String]
  [frame : i64]
  [push-count : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]
  [asm : String]) : String
  (let
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    (compiler-backend-peephole-test-session-reset! session)
    (backend.compiler-backend-sweep-record-fpo!
      session.stream
      symbol
      frame
      push-count
      slot-vars
      em-slot-offset
      em-used-count
      outgoing
      session.backend-state)
    (compiler-backend-peephole-test-session-asm session asm)))

(define (compiler-backend-peephole-test-fpo-asm-with-addr
  [symbol : String]
  [frame : i64]
  [push-count : i64]
  [slot-vars : i64]
  [em-slot-offset : i64]
  [em-used-count : i64]
  [outgoing : i64]
  [storage-words : i64]
  [asm : String]) : String
  (let
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    (compiler-backend-peephole-test-session-reset! session)
    ;; Drive the real emitter-side recorder: var 2 is slot -24 rbp, so a
    ;; two-word object records the canonical span [24, 40), which contains the
    ;; leaq at 24 and the later word's store at 32.
    (backend.compiler-backend-note-addr-of-extent!
      (regalloc.compiler-reg-assignment-table-empty)
      2
      storage-words
      session.backend-state)
    (backend.compiler-backend-sweep-record-fpo!
      session.stream
      symbol
      frame
      push-count
      slot-vars
      em-slot-offset
      em-used-count
      outgoing
      session.backend-state)
    (compiler-backend-peephole-test-session-asm session asm)))

;; then the reload with it, so the clobbered value is consumed by
;; `movq %rax, -104(%rbp)` -- the owner-invalidation coverage is unchanged and
;; the pair stays out of A2's reach.
(define (compiler-backend-post-regalloc-peephole-ok?) : bool
  (let
    [input : String
      "label:
    movq %rax, %rax
    movq %rax, %r12
    movq %r12, %rax
    movq %rax, %r12
    movq %rax, -16(%rbp)
    movq -16(%rbp), %rax
    movq %r8, -24(%rbp)
    movq -24(%rbp), %r10
    movq %r8, -24(%rbp)
    movq %r9, -24(%rbp)
    movq %rax, -32(%rbp)
    movq %r8, -40(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -64(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -72(%rbp)
    movq $7, %rax
    movq %rax, -104(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -80(%rbp)
    movq %rax, 16(%rbp)
    movq %r8, 16(%rbp)
    movq -88(%rbp), %r12
    call _tl_side
    movq -88(%rbp), %rax
    movq -96(%rbp), %r8
    call _tl_side
    movq -96(%rbp), %r10
    movq -8(%rbp), %r8
    addq %r8, %rax
    movq $0, %r8
    movq %rax, %r9
    movq %r9, %r10
"]
    [want : String
      "label:
    movq %rax, %r12
    movq %rax, -16(%rbp)
    movq %r8, -24(%rbp)
    movq %r8, %r10
    movq %r9, -24(%rbp)
    movq %rax, -32(%rbp)
    movq %r8, -40(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -64(%rbp)
    movq %rax, -72(%rbp)
    movq $7, %rax
    movq %rax, -104(%rbp)
    movq -56(%rbp), %rax
    movq %rax, -80(%rbp)
    movq %rax, 16(%rbp)
    movq %r8, 16(%rbp)
    movq -88(%rbp), %r12
    call _tl_side
    movq %r12, %rax
    movq -96(%rbp), %r8
    call _tl_side
    movq -96(%rbp), %r10
    movq -8(%rbp), %r8
    addq %r8, %rax
    movq $0, %r8
    movq %rax, %r9
    movq %r9, %r10
"]
    [direct : String
      (compiler-backend-peephole-forward-frame-load-line
        "    movq %r8, -24(%rbp)"
        "    movq -24(%rbp), %r10")]
    [got : String (compiler-backend-peephole-asm input)]
    (and (string.eq direct "    movq %r8, %r10") (string.eq got want))))

(define (compiler-backend-peephole-vector-gp-owners-ok?) : bool
  (let
    [input : String
      "    movq 16(%rsp), %r9
    vmovdqu (%r13,%r9,8), %ymm7
    movq 16(%rsp), %r9
    vpaddq (%r15,%r9,8), %ymm7, %ymm7
    movq 16(%rsp), %r9
    vmovdqu %ymm7, (%rbx,%r9,8)
    movq 16(%rsp), %r9
    vpmovmskb %ymm7, %r9
    movq 16(%rsp), %r9
"]
    [want : String
      "    movq 16(%rsp), %r9
    vmovdqu (%r13,%r9,8), %ymm7
    vpaddq (%r15,%r9,8), %ymm7, %ymm7
    vmovdqu %ymm7, (%rbx,%r9,8)
    movq 16(%rsp), %r9
    vpmovmskb %ymm7, %r9
    movq 16(%rsp), %r9
"]
    [got : String (compiler-backend-peephole-asm input)]
    (string.eq got want)))

;; An action-2 pair drops the current line and keeps pending. Two consecutive
;; drops therefore reuse the current parser result slot while the pending
;; descriptor must remain backed by the other slot.
(define (compiler-backend-peephole-pending-parse-slot-ok?) : bool
  (let
    [input : String
      "    movq %rax, %r12
    movq %rax, %r12
    movq %rax, %r12
    addq $1, %r13
"]
    [want : String "    movq %rax, %r12
    addq $1, %r13
"]
    (string.eq (compiler-backend-peephole-asm input) want)))

;; P22-A1: a spill store whose source register already mirrors the destination
;; slot writes back the value the slot holds and is dropped. The three positive
;; shapes are separated from the load by material the ADJACENT pair rules cannot
;; see through -- an unrelated single-dest op, and a carry-safe block label,
;; which is the emergency-scavenge `restore ; label ; resave` shape the emitter
;; actually produces. The negatives pin the invalidation: clobbering the register
;; and clobbering the slot each keep the store.
(define (compiler-backend-peephole-dead-mirror-store-ok?) : bool
  (let
    [gap-input : String
      "    movq 72(%rsp), %r9
    addq $1, %rax
    movq %r9, 72(%rsp)
"]
    [gap-want : String "    movq 72(%rsp), %r9
    addq $1, %rax
"]
    [label-input : String
      "    movq 72(%rsp), %r9
.Lf7_carry:
    movq %r9, 72(%rsp)
    addq $1, %r9
"]
    [label-want : String "    movq 72(%rsp), %r9
.Lf7_carry:
    addq $1, %r9
"]
    [store-first-input : String
      "    movq %r9, 72(%rsp)
    addq $1, %rax
    movq %r9, 72(%rsp)
"]
    [store-first-want : String "    movq %r9, 72(%rsp)
    addq $1, %rax
"]
    ;; RMW-3 folds this triple with its reload (nothing after the store kills
    ;; %r9, so the register counts as live); the slot's write survives in the
    ;; folded op, which is the claim the sweep must respect either way.
    [reg-clobbered-input : String
      "    movq 72(%rsp), %r9
    addq $1, %r9
    movq %r9, 72(%rsp)
"]
    [reg-clobbered-want : String
      "    addq $1, 72(%rsp)
    movq 72(%rsp), %r9
"]
    [slot-clobbered-input : String
      "    movq 72(%rsp), %r9
    movq %rax, 72(%rsp)
    addq $1, %rax
    movq %r9, 72(%rsp)
"]
    [unsafe-label-input : String
      "    movq 72(%rsp), %r9
.Lf7_merge:
    movq %r9, 72(%rsp)
    addq $1, %r9
"]
    [gap-got : String (compiler-backend-peephole-asm gap-input)]
    [store-first-got : String (compiler-backend-peephole-asm store-first-input)]
    [reg-clobbered-got : String
      (compiler-backend-peephole-asm reg-clobbered-input)]
    [slot-clobbered-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view slot-clobbered-input))]
    [unsafe-label-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view unsafe-label-input))]
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    [_session-reset : unit
      (compiler-backend-peephole-test-session-reset! session)]
    [_carry-safe : unit
      (be_state.compiler-backend-peephole-carry-safe-insert!
        session.backend-state
        session.stream
        ".Lf7_carry")]
    [label-got : String
      (compiler-backend-peephole-test-session-asm session label-input)]
    (and
      (string.eq gap-got gap-want)
      (string.eq label-got label-want)
      (string.eq store-first-got store-first-want)
      (string.eq reg-clobbered-got reg-clobbered-want)
      (string.eq slot-clobbered-got slot-clobbered-input)
      (string.eq unsafe-label-got unsafe-label-input))))

;; P22-A2: `movq SRC, %rX` immediately followed by a movq that rewrites the whole
;; of %rX without reading it drops the first line. The negatives pin the two
;; guards: a source that reads the register (bare or as a memory base/index) and
;; an untracked destination (%rbp) both keep the pair.
(define (compiler-backend-peephole-dead-reg-def-ok?) : bool
  (let
    [input : String
      "    movq 72(%rsp), %r9
    movq %rax, %r9
    movq %r9, 8(%rsp)
"]
    [want : String "    movq %rax, %r9
    movq %r9, 8(%rsp)
"]
    [read-input : String
      "    movq 72(%rsp), %r9
    movq (%r9), %r9
    movq %r9, 8(%rsp)
"]
    [index-input : String
      "    movq 72(%rsp), %r9
    movq 16(%rbx,%r9,8), %r9
    movq %r9, 8(%rsp)
"]
    [untracked-input : String
      "    movq 72(%rsp), %rbp
    movq %rax, %rbp
    movq %rbp, 8(%rsp)
"]
    [got : String (compiler-backend-peephole-asm input)]
    [read-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view read-input))]
    [index-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view index-input))]
    [untracked-got : String
      (compiler-backend-peephole-asm
        (owned_view.compiler-owned-shared-view untracked-input))]
    (and
      (string.eq got want)
      (string.eq read-got read-input)
      (string.eq index-got index-input)
      (string.eq untracked-got untracked-input))))

(define (compiler-backend-peephole-detailed-abort-guard-ok?) : bool
  (let
    [input : String
      "    movq -8(%rbp), %r10
    cmpq $5, 16(%rbp)
    ja .Lf0_bounds_ok.1
    pushq 16(%rbp)
    pushq $5
    # tl_abort_operand_stage
    popq %rsi
    popq %rdx
    call .L_tl_abort_tl_oob_abort_at
.L_tl_abort_site_1_bounds:
    .tl_abort_row .L_tl_abort_site_1_bounds, .L_tl_str_fat, 4, 9, tl_oob_abort_at
.Lf0_bounds_ok.1:
    movq -8(%rbp), %r10
    movq (%r10), %rax
"]
    [want : String
      "    movq -8(%rbp), %r10
    cmpq $5, 16(%rbp)
    ja .Lf0_bounds_ok.1
    pushq 16(%rbp)
    pushq $5
    # tl_abort_operand_stage
    popq %rsi
    popq %rdx
    call .L_tl_abort_tl_oob_abort_at
.L_tl_abort_site_1_bounds:
    .tl_abort_row .L_tl_abort_site_1_bounds, .L_tl_str_fat, 4, 9, tl_oob_abort_at
.Lf0_bounds_ok.1:
    movq (%r10), %rax
"]
    [got : String (compiler-backend-peephole-asm input)]
    (string.eq got want)))

;; The folded fallthrough-`jmp` deletion: a candidate whose target is reached
;; across label definitions only is excised; anything else keeps it.
(define (compiler-backend-peephole-drop-fallthrough-chain-ok?) : bool
  (let
    [chain-input : String
      "    movq $1, %rax
    jmp .Lmerge
.Lelse:
.Lmerge:
    movq %rax, -8(%rbp)
"]
    [chain-want : String
      "    movq $1, %rax
.Lelse:
.Lmerge:
    movq %rax, -8(%rbp)
"]
    [kept-input : String
      "    movq $1, %rax
    jmp .Lmerge
.Lelse:
    movq $2, %rax
.Lmerge:
    movq %rax, -8(%rbp)
"]
    [end-input : String "    movq $1, %rax
    jmp .Lmerge
"]
    [backward-input : String ".Lloop:
    movq $1, %rax
    jmp .Lloop
"]
    [chain-got : String
      (backend.compiler-backend-peephole-asm-drop-fallthrough chain-input)]
    [kept-got : String
      (backend.compiler-backend-peephole-asm-drop-fallthrough
        (owned_view.compiler-owned-shared-view kept-input))]
    [end-got : String
      (backend.compiler-backend-peephole-asm-drop-fallthrough
        (owned_view.compiler-owned-shared-view end-input))]
    [backward-got : String
      (backend.compiler-backend-peephole-asm-drop-fallthrough
        (owned_view.compiler-owned-shared-view backward-input))]
    (and
      (string.eq chain-got chain-want)
      (string.eq kept-got kept-input)
      (string.eq end-got end-input)
      (string.eq backward-got backward-input))))

;; Sharpest edge of the folded deletion: with the `jmp` suppressed the guard-ok
;; label must still see prev-abort? = true, so the owner map carries and the
;; reload after the label is elided.
(define (compiler-backend-peephole-drop-fallthrough-abort-guard-ok?) : bool
  (let
    [input : String
      "    movq -8(%rbp), %r10
    cmpq $5, 16(%rbp)
    ja .Lf0_bounds_ok.1
    pushq 16(%rbp)
    pushq $5
    # tl_abort_operand_stage
    popq %rsi
    popq %rdx
    call .L_tl_abort_tl_oob_abort_at
    jmp .Lf0_bounds_ok.1
.Lf0_bounds_ok.1:
    movq -8(%rbp), %r10
    movq (%r10), %rax
"]
    [want : String
      "    movq -8(%rbp), %r10
    cmpq $5, 16(%rbp)
    ja .Lf0_bounds_ok.1
    pushq 16(%rbp)
    pushq $5
    # tl_abort_operand_stage
    popq %rsi
    popq %rdx
    call .L_tl_abort_tl_oob_abort_at
.Lf0_bounds_ok.1:
    movq (%r10), %rax
"]
    [got : String
      (backend.compiler-backend-peephole-asm-drop-fallthrough input)]
    (string.eq got want)))

(define (compiler-backend-deadstore-sweep-win64-rbp-frame-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    .seh_pushreg %rbp
    movq %rsp, %rbp
    .seh_setframe %rbp, 0
    subq $48, %rsp
    .seh_stackalloc 48
    .seh_endprologue
    movq %r9, 40(%rsp)
    leave
    ret
    .seh_endproc
"]
    [want : String
      "main:
    pushq %rbp
    .seh_pushreg %rbp
    movq %rsp, %rbp
    .seh_setframe %rbp, 0
    subq $48, %rsp
    .seh_stackalloc 48
    .seh_endprologue
    leave
    ret
    .seh_endproc
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 1 0 0 0 input)]
    (string.eq got want)))

(define (compiler-backend-deadstore-sweep-win64-csr-stays-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r12, 32(%rsp)
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        1
        0
        0
        0
        (owned_view.compiler-owned-shared-view input))]
    (string.eq got input)))

(define (compiler-backend-deadstore-sweep-win64-address-stays-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leaq 40(%rsp), %rax
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        1
        0
        0
        0
        (owned_view.compiler-owned-shared-view input))]
    (string.eq got input)))

(define (compiler-backend-deadstore-sweep-win64-pop-tail-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leaq 24(%rsp), %rsp
    popq %r13
    popq %r12
    leave
    ret
"]
    [want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    leaq 24(%rsp), %rsp
    popq %r13
    popq %r12
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 1 0 0 0 input)]
    (string.eq got want)))

(define (compiler-backend-deadstore-sweep-linux-leave-poisons-ok?) : bool
  (let
    [input : String
      "main:
    subq $56, %rsp
    movq %r9, 40(%rsp)
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-fpo-asm
        "main"
        48
        0
        1
        0
        0
        0
        (owned_view.compiler-owned-shared-view input))]
    (string.eq got input)))

;; #7645: movq also transfers eight bytes between XMM and memory. Such stores
;; are ABI payload writes, not scalar spill candidates; the frame-store sweep
;; must never discard one merely because no later assembly line reads the slot.
(define (compiler-backend-deadstore-sweep-xmm-store-stays-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %xmm2, 40(%rsp)
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        1
        0
        0
        0
        (owned_view.compiler-owned-shared-view input))]
    (string.eq got input)))

(define (compiler-backend-deadstore-sweep-metadata-consumed-ok?) : bool
  (let
    [first : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leave
    ret
"]
    [first-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    leave
    ret
"]
    [second : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq %r9, 40(%rsp)
    leave
    ret
"]
    [session : CompilerBackendPeepholeTestSession
      (compiler-backend-peephole-test-session-new)]
    [_reset : unit (compiler-backend-peephole-test-session-reset! session)]
    [_record : unit
      (compiler-backend-peephole-test-session-win64! session "main" 48 1 0 0 0)]
    [first-got : String
      (compiler-backend-peephole-test-session-asm session first)]
    [second-got : String
      (compiler-backend-peephole-test-session-asm
        session
        (owned_view.compiler-owned-shared-view second))]
    (and (string.eq first-got first-want) (string.eq second-got second))))

;; Pass 2's coverage bitmap serves the many-read tail: 50 live store+read
;; pairs and 50 dead stores interleaved, so the dead stores are swept and the
;; live ones kept, with the reads landing both before and after the stores.
(define (compiler-backend-deadstore-sweep-coverage-many-reads-ok?) : bool
  (let
    [input-buf : text_buf.TextBuf (text_buf.empty)]
    [want-buf : text_buf.TextBuf (text_buf.empty)]
    (set!
      input-buf
      (text_buf.append
        input-buf
        "main:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $808, %rsp\n"))
    (set!
      want-buf
      (text_buf.append
        want-buf
        "main:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $808, %rsp\n"))
    (for [k (iterator.range 0 50)]
      (let
        [a : i64 (+ 8 (* 16 k))]
        [b : i64 (+ 16 (* 16 k))]
        [reg : String
          (if (= (% k 3) 0)
            "%r10"
            (if (= (% k 3) 1)
              "%r11"
              "%rax"))]
        (set!
          input-buf
          (text_buf.append
            input-buf
            (str_cat.str-cat
              "    movq $"
              (string.int->string k)
              ", "
              (string.int->string a)
              "(%rsp)\n    movq $"
              (string.int->string k)
              ", "
              (string.int->string b)
              "(%rsp)\n    movq "
              (string.int->string a)
              "(%rsp), "
              reg
              "\n")))
        (set!
          want-buf
          (text_buf.append
            want-buf
            (str_cat.str-cat
              "    movq $"
              (string.int->string k)
              ", "
              (string.int->string a)
              "(%rsp)\n    movq "
              (string.int->string a)
              "(%rsp), "
              reg
              "\n")))))
    (let
      [input : String
        (text_buf.render (text_buf.append input-buf "    leave\n    ret\n"))]
      [want : String
        (text_buf.render (text_buf.append want-buf "    leave\n    ret\n"))]
      [got : String
        (compiler-backend-peephole-test-win64-asm "main" 808 100 0 0 0 input)]
      (string.eq got want))))

;; Byte-granular coverage: unaligned and wide reads overlap exactly by byte
;; range, not by slot.
(define (compiler-backend-deadstore-sweep-coverage-unaligned-ok?) : bool
  (let
    [head : String
      "main:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $48, %rsp\n"]
    [tail : String "    leave\n    ret\n"]
    [no-overlap-input : String
      (str_cat.str-cat
        head
        "    movq $1, 8(%rsp)\n    movdqa 16(%rsp), %xmm0\n"
        tail)]
    [wide-overlap-input : String
      (str_cat.str-cat
        head
        "    movq $1, 8(%rsp)\n    movdqa 12(%rsp), %xmm0\n"
        tail)]
    [narrow-overlap-input : String
      (str_cat.str-cat
        head
        "    movq $1, 16(%rsp)\n    movq 20(%rsp), %rax\n"
        tail)]
    [no-overlap-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        no-overlap-input)]
    [wide-overlap-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        (owned_view.compiler-owned-shared-view wide-overlap-input))]
    [narrow-overlap-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        (owned_view.compiler-owned-shared-view narrow-overlap-input))]
    (and
      (string.eq
        no-overlap-got
        (str_cat.str-cat head "    movdqa 16(%rsp), %xmm0\n" tail))
      (string.eq wide-overlap-got wide-overlap-input)
      (string.eq narrow-overlap-got narrow-overlap-input))))

;; A candidate at exactly c == hi: an adjacent read ending at hi does not
;; cover [hi, hi+8), so the store is swept; a read of the slot keeps it.
(define (compiler-backend-deadstore-sweep-coverage-hi-edge-ok?) : bool
  (let
    [head : String
      "main:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $48, %rsp\n"]
    [tail : String "    leave\n    ret\n"]
    [adjacent-input : String
      (str_cat.str-cat
        head
        "    movq $1, 40(%rsp)\n    movq 32(%rsp), %rax\n"
        tail)]
    [covered-input : String
      (str_cat.str-cat
        head
        "    movq $1, 40(%rsp)\n    movq 40(%rsp), %rax\n"
        tail)]
    [adjacent-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        adjacent-input)]
    [covered-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        (owned_view.compiler-owned-shared-view covered-input))]
    (and
      (string.eq
        adjacent-got
        (str_cat.str-cat head "    movq 32(%rsp), %rax\n" tail))
      (string.eq covered-got covered-input))))

;; Both sides of the coverage-word cap produce the same decisions: the
;; under-cap frame uses the bitmap, the over-cap frame falls back to the
;; exact per-candidate scan.
(define (compiler-backend-deadstore-sweep-coverage-cap-ok?) : bool
  (let
    [under-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $262192, %rsp
    movq $1, 262184(%rsp)
    movq $2, 48(%rsp)
    movq 48(%rsp), %rax
    leave
    ret
"]
    [under-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $262192, %rsp
    movq $2, 48(%rsp)
    movq 48(%rsp), %rax
    leave
    ret
"]
    [over-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $262200, %rsp
    movq $1, 262192(%rsp)
    movq $2, 48(%rsp)
    movq 48(%rsp), %rax
    leave
    ret
"]
    [over-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $262200, %rsp
    movq $2, 48(%rsp)
    movq 48(%rsp), %rax
    leave
    ret
"]
    [under-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        262192
        32768
        0
        0
        0
        under-input)]
    [over-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        262200
        32769
        0
        0
        0
        over-input)]
    (and (string.eq under-got under-want) (string.eq over-got over-want))))

;; A leaq watermark poisons upward: candidates at or above the leaq's offset
;; stay even when no read names them; candidates below it are still swept.
(define (compiler-backend-deadstore-sweep-leaq-watermark-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 32(%rsp)
    movq $2, 16(%rsp)
    leaq 24(%rsp), %rax
    leave
    ret
"]
    [want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 32(%rsp)
    leaq 24(%rsp), %rax
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 5 0 0 0 input)]
    (string.eq got want)))

;; A recorded address extent, not a poison-everything watermark, bounds the
;; leaq: the leaq at 16 resolves to the object whose span contains it, so the
;; second word's store at 24 stays. Narrowing that object to one word leaves
;; the leaq inside it and makes the store at 24 sweepable, which is exactly
;; the under-protection the whole-object span prevents.
(define (compiler-backend-deadstore-sweep-extent-input) : String
  "main:
    subq $48, %rsp
    movq $1, 16(%rsp)
    movq $2, 24(%rsp)
    leaq 16(%rsp), %rax
    addq $48, %rsp
    ret
")

(define (compiler-backend-deadstore-sweep-extent-want) : String
  "main:
    subq $48, %rsp
    movq $1, 16(%rsp)
    leaq 16(%rsp), %rax
    addq $48, %rsp
    ret
")

;; A recorded address extent, not a poison-everything watermark, bounds the
;; leaq: the leaq at 24 resolves to the object whose span contains it, so the
;; later word's store at 32 stays. Narrowing that object to one word leaves
;; the leaq inside it and makes the store at 32 sweepable, which is exactly
;; the under-protection the whole-object span prevents.
(define (compiler-backend-deadstore-sweep-leaq-extent-ok?) : bool
  (let
    [wide : String
      (compiler-backend-peephole-test-fpo-asm-with-addr
        "main"
        48
        0
        4
        0
        0
        0
        2
        (compiler-backend-deadstore-sweep-extent-input))]
    [narrow : String
      (compiler-backend-peephole-test-fpo-asm-with-addr
        "main"
        48
        0
        4
        0
        0
        0
        1
        (compiler-backend-deadstore-sweep-extent-input))]
    (and
      (string.eq wide (compiler-backend-deadstore-sweep-extent-input))
      (string.eq narrow (compiler-backend-deadstore-sweep-extent-want)))))

(define (compiler-backend-deadstore-sweep-wide-frame-input) : String
  "main:
    subq $300008, %rsp
    movq $1, 200000(%rsp)
    leaq 200000(%rsp), %rax
    addq $300008, %rsp
    ret
")

;; A frame wider than the coverage bitmap window (4096 words = 256 KB) takes
;; the watermark path: the poison scan must not index the bitmap that path
;; never allocates. A 320,000-byte variable window is the smallest shape that
;; crosses it, and the leaq keeps the store below it.
(define (compiler-backend-deadstore-sweep-wide-frame-ok?) : bool
  (string.eq
    (compiler-backend-peephole-test-fpo-asm
      "main"
      300000
      0
      40000
      0
      0
      0
      (compiler-backend-deadstore-sweep-wide-frame-input))
    (compiler-backend-deadstore-sweep-wide-frame-input)))

;; The reads set is region-wide: a read before the store keeps it just as a
;; read after it does.
(define (compiler-backend-deadstore-sweep-read-before-store-ok?) : bool
  (let
    [head : String
      "main:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $48, %rsp\n"]
    [tail : String "    leave\n    ret\n"]
    [before-input : String
      (str_cat.str-cat
        head
        "    movq 40(%rsp), %rax\n    movq $1, 40(%rsp)\n"
        tail)]
    [after-input : String
      (str_cat.str-cat
        head
        "    movq $1, 40(%rsp)\n    movq 40(%rsp), %rax\n"
        tail)]
    [before-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        (owned_view.compiler-owned-shared-view before-input))]
    [after-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        5
        0
        0
        0
        (owned_view.compiler-owned-shared-view after-input))]
    (and (string.eq before-got before-input) (string.eq after-got after-input))))

;; The coverage window spans both eligibility windows: emergency-slot
;; candidates are swept or kept by the same bitmap when the em window is
;; non-empty (em-slot-offset -512, 2 slots -> em window [-528, -408]).
(define (compiler-backend-deadstore-sweep-coverage-em-window-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, -520(%rsp)
    movq $2, -512(%rsp)
    movq -512(%rsp), %rax
    leave
    ret
"]
    [want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $2, -512(%rsp)
    movq -512(%rsp), %rax
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 5 -512 2 0 input)]
    (string.eq got want)))

;; Pass-1 fast paths: an inert record following a candidate must still poison
;; a Win64 epilogue tail, so nothing in the region is swept.
(define (compiler-backend-deadstore-sweep-win64-inert-tail-poison-ok?) : bool
  (let
    [input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 40(%rsp)
    leaq 24(%rsp), %rsp
    movq %rax, %rbx
    leave
    ret
"]
    [got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        1
        0
        0
        0
        (owned_view.compiler-owned-shared-view input))]
    (string.eq got input)))

;; Pass-1 fast paths: a candidate as the region's last record is swept by the
;; candidate hoist, and a candidate inside a Win64 epilogue tail still poisons
;; the region through that same hoist.
(define (compiler-backend-deadstore-sweep-candidate-last-ok?) : bool
  (let
    [last-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 40(%rsp)
"]
    [last-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
"]
    [tail-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 40(%rsp)
    leaq 24(%rsp), %rsp
    movq $2, 40(%rsp)
"]
    [last-got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 1 0 0 0 last-input)]
    [tail-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        1
        0
        0
        0
        (owned_view.compiler-owned-shared-view tail-input))]
    (and (string.eq last-got last-want) (string.eq tail-got tail-input))))

;; The candidate verifier's comma hint: a one-space `movq src, N(%rsp)` store
;; uses the descriptor's comma position (same decision as the scan), while a
;; two-space operand line takes the scan path and is not a candidate, both
;; exactly as before.
(define (compiler-backend-deadstore-sweep-candidate-comma-hint-ok?) : bool
  (let
    [hint-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 40(%rsp)
    movq $2, 32(%rsp)
    movq 40(%rsp), %rax
    leave
    ret
"]
    [hint-want : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq $1, 40(%rsp)
    movq 40(%rsp), %rax
    leave
    ret
"]
    [two-space-input : String
      "main:
    pushq %rbp
    movq %rsp, %rbp
    subq $48, %rsp
    movq  $1, 40(%rsp)
    leave
    ret
"]
    [hint-got : String
      (compiler-backend-peephole-test-win64-asm "main" 48 2 0 0 0 hint-input)]
    [two-space-got : String
      (compiler-backend-peephole-test-win64-asm
        "main"
        48
        2
        0
        0
        0
        (owned_view.compiler-owned-shared-view two-space-input))]
    (and
      (string.eq hint-got hint-want)
      (string.eq two-space-got two-space-input))))

(define (compiler-backend-deadstore-sweep-win64-ok?) : bool
  (and
    (compiler-backend-deadstore-sweep-win64-rbp-frame-ok?)
    (compiler-backend-deadstore-sweep-win64-csr-stays-ok?)
    (compiler-backend-deadstore-sweep-win64-address-stays-ok?)
    (compiler-backend-deadstore-sweep-win64-pop-tail-ok?)
    (compiler-backend-deadstore-sweep-linux-leave-poisons-ok?)
    (compiler-backend-deadstore-sweep-xmm-store-stays-ok?)
    (compiler-backend-deadstore-sweep-metadata-consumed-ok?)
    (compiler-backend-deadstore-sweep-coverage-many-reads-ok?)
    (compiler-backend-deadstore-sweep-coverage-unaligned-ok?)
    (compiler-backend-deadstore-sweep-coverage-hi-edge-ok?)
    (compiler-backend-deadstore-sweep-coverage-cap-ok?)
    (compiler-backend-deadstore-sweep-leaq-watermark-ok?)
    (compiler-backend-deadstore-sweep-leaq-extent-ok?)
    (compiler-backend-deadstore-sweep-wide-frame-ok?)
    (compiler-backend-deadstore-sweep-read-before-store-ok?)
    (compiler-backend-deadstore-sweep-coverage-em-window-ok?)
    (compiler-backend-deadstore-sweep-win64-inert-tail-poison-ok?)
    (compiler-backend-deadstore-sweep-candidate-last-ok?)
    (compiler-backend-deadstore-sweep-candidate-comma-hint-ok?)))

(define (compiler-backend-r10-dead-scan-long-gap-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [asm : String
      "    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rax, %rax
    movq %rcx, %r10
"]
    [data : (Ptr u8)
      (unsafe
        (string-data asm))]
    [n : i64 (string.string-length asm)]
    (compiler-backend-peephole-r10-dead-after? backend-state asm data 0 n)))

;; FLAGS-1. `subq $1, %r` + `testq %r, %r` + `jge` is the counted-down loop
;; latch IV-AFF leaves; the arithmetic set ZF and SF from the value the `test`
;; reads, so the `test` goes and `jge` (SF = 0 once OF = 0) becomes `jns`; `jl`
;; becomes `js`; `je`/`jne` keep their spelling. A branch that reads OF or CF
;; (`jg`), a label between the writer and the `test`, or a `test` on another
;; register keep the `test`.
(define (compiler-backend-peephole-flags-branch-case [body : String]) : String
  (compiler-backend-peephole-asm-once
    (str_cat.str-cat ".text\n.globl f\nf:\n" body "    ret\n")))

(define (compiler-backend-peephole-flags-branch-ok?) : bool
  (let
    [ge : String
      (compiler-backend-peephole-flags-branch-case
        "    subq $1, %rsi\n    testq %rsi, %rsi\n    jge .La\n    movq %rsi, %rax\n.La:\n")]
    [lt : String
      (compiler-backend-peephole-flags-branch-case
        "    addq %rdx, %rcx\n    testq %rcx, %rcx\n    jl .Lb\n    movq %rcx, %rax\n.Lb:\n")]
    [eq : String
      (compiler-backend-peephole-flags-branch-case
        "    xorq %rdx, %r9\n    testq %r9, %r9\n    jne .Lc\n    movq %r9, %rax\n.Lc:\n")]
    [gt : String
      (compiler-backend-peephole-flags-branch-case
        "    subq $1, %rsi\n    testq %rsi, %rsi\n    jg .Ld\n    movq %rsi, %rax\n.Ld:\n")]
    [label : String
      (compiler-backend-peephole-flags-branch-case
        "    subq $1, %rsi\n.Lm:\n    testq %rsi, %rsi\n    jge .Le\n    movq %rsi, %rax\n.Le:\n")]
    [other : String
      (compiler-backend-peephole-flags-branch-case
        "    subq $1, %rsi\n    testq %rdi, %rdi\n    jge .Lf\n    movq %rsi, %rax\n.Lf:\n")]
    (and
      (asm-has? ge "    subq $1, %rsi\n    jns .La\n")
      (asm-lacks? ge "testq")
      (asm-has? lt "    addq %rdx, %rcx\n    js .Lb\n")
      (asm-has? eq "    xorq %rdx, %r9\n    jne .Lc\n")
      (asm-has? gt "    testq %rsi, %rsi\n    jg .Ld\n")
      (asm-has? label "    testq %rsi, %rsi\n    jge .Le\n")
      (asm-has? other "    testq %rdi, %rdi\n    jge .Lf\n"))))

;; The grouped TextBuf path must preserve pairs that cross arbitrary physical
;; chunks, while splitting safely at the following function's `.globl` chunk.
(define (compiler-backend-chunked-peephole-equivalent?) : bool
  (let
    [chunks : text_buf.TextBuf
      (text_buf.append
        (text_buf.append
          (text_buf.append
            (text_buf.append
              (text_buf.empty)
              ".text\n.globl first\nfirst:\n    movq %rax, %r")
            "10\n    movq 8(%r10), %r8\n")
          ".globl second\nsecond:\n    movq %rax, -8(%rbp)\n")
        "    movq -8(%rbp), %r9\n")]
    [input : String
      (text_buf.render (owned_view.compiler-owned-shared-view chunks))]
    [legacy : String (compiler-backend-peephole-asm-once input)]
    [chunked : String
      (text_buf.render (compiler-backend-peephole-text-buf-once chunks))]
    (string.eq legacy chunked)))

;; Exercise both final-record consumers. The fixtures omit layout and
;; fallthrough-jump deletion so the final pass sees the exact incoming edges.
(define (compiler-backend-tail-test-stream [asm : (& str)]) : String
  (text_buf.render
    (compiler-backend-peephole-text-buf-once
      (text_buf.append (text_buf.empty) (string.copy asm)))))

(define (compiler-backend-tail-test-buffer [asm : (& str)]) : String
  (compiler-backend-peephole-asm-once (string.copy asm)))

(define (compiler-backend-tail-test-whole-source
  [entry : (& str)]
  [data : (& str)]) : String
  (str_cat.str-cat
    "tail_test:\n"
    entry
    "    testl %eax, %eax\n    jne .L_tail_test_first\n    jmp .L_tail_test_second\n"
    ".L_tail_test_first:\n    movl $403, %r8d\n    jmp .L_tail_test_join\n"
    ".L_tail_test_second:\n    movl $403, %r8d\n    jmp .L_tail_test_join\n"
    data
    ".L_tail_test_join:\n    ret\n"))

(test
  peephole-tail-merges-identical-blocks
  (let
    [input : String (compiler-backend-tail-test-whole-source "" "")]
    [out : String (compiler-backend-tail-test-stream (& input))]
    (test.assert-true
      (and
        (string.eq (& out) (compiler-backend-tail-test-buffer (& input)))
        (asm-has?
          out
          "    jne .L_tail_test_first\n    jmp .L_tail_test_first\n"
          ".L_tail_test_first:\n    movl $403, %r8d\n    jmp .L_tail_test_join\n")
        (asm-lacks? out ".L_tail_test_second"))
      "both renderers redirect the duplicate's incoming branch and remove its body")))

(test
  peephole-tail-merges-identical-suffixes
  (let
    [input : String
      (str_cat.str-cat
        "tail_suffix:\n    testl %eax, %eax\n    jne .L_suffix_second\n"
        "    movl $301, %r10d\n    movq $401, %r8\n    movq %r8, (%rbx)\n"
        "    jmp .L_suffix_join\n"
        ".L_suffix_second:\n    movl $302, %r10d\n    movq $401, %r8\n"
        "    movq %r8, (%rbx)\n    jmp .L_suffix_join\n"
        ".L_suffix_join:\n    ret\n")]
    [out : String (compiler-backend-tail-test-stream (& input))]
    (test.assert-true
      (and
        (string.eq (& out) (compiler-backend-tail-test-buffer (& input)))
        (asm-has?
          out
          "    movl $301, %r10d\n    jmp .L_tail_tail_suffix."
          "    movl $302, %r10d\n.L_tail_tail_suffix."
          "    movq %r8, (%rbx)\n.L_suffix_join:\n")
        (asm-lacks? out "    jmp .L_suffix_join\n"))
      "branching to the longest shared fallthrough suffix takes one jump")))

(test
  peephole-tail-preserves-located-abort-sites
  (let
    [input : String
      (str_cat.str-cat
        "tail_abort:\n    testl %eax, %eax\n    jne .L_abort_second\n"
        "    movq $401, %r8\n    call .L_tl_abort_tl_oob_abort_at\n"
        ".L_tl_abort_site_1_bounds:\n"
        "    .tl_abort_row .L_tl_abort_site_1_bounds, .L_tl_str_fat, 4, 9, tl_oob_abort_at\n"
        ".L_abort_second:\n    movq $401, %r8\n"
        "    call .L_tl_abort_tl_oob_abort_at\n"
        ".L_tl_abort_site_2_bounds:\n"
        "    .tl_abort_row .L_tl_abort_site_2_bounds, .L_tl_str_fat, 5, 9, tl_oob_abort_at\n"
        "    ret\n    .size tail_abort, . - tail_abort\n")]
    [out : String (compiler-backend-tail-test-stream (& input))]
    [buf : String (compiler-backend-tail-test-buffer (& input))]
    [site-one : String
      "    call .L_tl_abort_tl_oob_abort_at\n.L_tl_abort_site_1_bounds:\n    .tl_abort_row .L_tl_abort_site_1_bounds, .L_tl_str_fat, 4, 9, tl_oob_abort_at\n"]
    [site-two : String
      "    call .L_tl_abort_tl_oob_abort_at\n.L_tl_abort_site_2_bounds:\n    .tl_abort_row .L_tl_abort_site_2_bounds, .L_tl_str_fat, 5, 9, tl_oob_abort_at\n"]
    (test.assert-true
      (and (asm-has? out site-one site-two) (asm-has? buf site-one site-two))
      "every located abort retains its own adjacent return-PC label and span row")))

(test
  peephole-tail-preserves-address-taken-and-jump-table-labels
  (let
    [address : String
      (compiler-backend-tail-test-whole-source
        "    leaq .L_tail_test_second(%rip), %rsi\n"
        "")]
    [table : String
      (compiler-backend-tail-test-whole-source
        ""
        ".L_tail_test_switch:\n    .long .L_tail_test_second - .L_tail_test_switch\n")]
    [split-table : String
      (str_cat.str-cat
        ".section .rodata\n.L_tail_external_table:\n    .long .L_tail_test_second\n"
        ".text\n.globl tail_test\n"
        (compiler-backend-tail-test-whole-source "" "    jmp *%r11\n"))]
    [split-out : String (compiler-backend-tail-test-stream (& split-table))]
    [address-out : String (compiler-backend-tail-test-stream (& address))]
    [table-out : String (compiler-backend-tail-test-stream (& table))]
    (test.assert-true
      (and
        (string.eq
          (& address-out)
          (compiler-backend-tail-test-buffer (& address)))
        (string.eq (& table-out) (compiler-backend-tail-test-buffer (& table)))
        (asm-has?
          address-out
          "leaq .L_tail_test_second(%rip), %rsi"
          ".L_tail_test_second:")
        (asm-has?
          table-out
          ".long .L_tail_test_second -"
          ".L_tail_test_second:")
        (asm-has?
          split-out
          "    .long .L_tail_test_second\n"
          ".L_tail_test_second:")
        (string.eq
          (& split-out)
          (compiler-backend-tail-test-buffer (& split-table))))
      "address and table operands pin the second definition in both renderers")))

(test
  peephole-tail-preserves-seh-and-ret
  (let
    [body : String
      (compiler-backend-tail-test-whole-source "    .seh_endprologue\n" "")]
    [seh : String
      (str_cat.str-cat ".seh_proc tail_test\n" body "    .seh_endproc\n")]
    [returns : String
      (str_cat.str-cat
        "tail_return:\n    testl %eax, %eax\n    jne .L_ret_second\n"
        "    movq $401, %r8\n    ret\n"
        ".L_ret_second:\n    movq $401, %r8\n    ret\n")]
    [seh-out : String (compiler-backend-tail-test-stream (& seh))]
    [ret-out : String (compiler-backend-tail-test-stream (& returns))]
    (test.assert-true
      (and
        (string.eq (& seh) (& seh-out))
        (string.eq (& seh-out) (compiler-backend-tail-test-buffer (& seh)))
        (string.eq (& returns) (& ret-out))
        (string.eq (& ret-out) (compiler-backend-tail-test-buffer (& returns))))
      "SEH functions and ret-ending blocks remain intact")))

;; COLD-1: the render moves each abort stub behind its function and inverts
;; the check's branch; a guard that is not a pure abort stub stays inline.
(define (compiler-backend-cold-split-source) : String
  (str_cat.str-cat
    ".text\n.globl f\n    .type f,@function\nf:\n"
    "    cmpq %r9, %rdi\n    jb .Lf0_bounds_ok.1\n"
    "    pushq %r9\n    pushq %rdi\n"
    "    # tl_abort_operand_stage\n"
    "    popq %rsi\n    popq %rdx\n    call .L_tl_abort_tl_oob_abort_at\n"
    ".L_tl_abort_site_1_bounds:\n"
    "    .tl_abort_row .L_tl_abort_site_1_bounds, .L_tl_str_fat, 4, 9, tl_oob_abort_at\n"
    ".Lf0_bounds_ok.1:\n"
    "    testq %r8, %r8\n    jne 1f\n    call tl_div_abort\n1:\n"
    "    cmpq $0, %rax\n    jb .Lf0_mixed\n    testq %rcx, %rcx\n"
    "    jne .Lf0_mixed\n    call tl_oob_abort\n.Lf0_mixed:\n"
    "    cmpq $5, %rax\n    jb .Lf0_calls\n    call helper\n"
    "    call tl_oob_abort\n.Lf0_calls:\n"
    "    cmpq $3, %rax\n    jne .Lf0_keep\n    movq $1, %rax\n"
    ".Lf0_keep:\n    ret\n    .size f, . - f\n"))

(define (compiler-backend-cold-split-ok?) : bool
  (let
    [out : String
      (text_buf.render
        (compiler-backend-peephole-text-buf-once
          (text_buf.append
            (text_buf.empty)
            (compiler-backend-cold-split-source))))]
    [ret-at : i64 (backend.compiler-backend-string-find-from out "    ret\n" 0)]
    [bounds-stub-at : i64
      (backend.compiler-backend-string-find-from
        out
        ".Lf0_bounds_ok.1.cold:\n    pushq %r9\n"
        0)]
    [div-stub-at : i64
      (backend.compiler-backend-string-find-from
        out
        ".Lf0_bounds_ok.1.stub1.cold:\n    call tl_div_abort\n.Lf0_mixed.cold:\n"
        0)]
    [size-at : i64
      (backend.compiler-backend-string-find-from out "    .size f, . - f\n" 0)]
    (and
      ;; Named continuation: the passing check falls through.
      (asm-has?
        out
        "    cmpq %r9, %rdi\n    jae .Lf0_bounds_ok.1.cold\n.Lf0_bounds_ok.1:\n    testq %r8, %r8\n")
      ;; Numeric `1:` without a site label: named after the closest preceding
      ;; label, with `1:` kept in place.
      (asm-has?
        out
        "    je .Lf0_bounds_ok.1.stub1.cold\n1:\n    cmpq $0, %rax\n")
      ;; A guard whose skipped text holds a conditional jump is no stub; the
      ;; inner guard it skips is one, and still moves. A returning call in the
      ;; skipped text disqualifies it, and an ordinary branch is no guard:
      ;; both stay exactly as emitted.
      (asm-has?
        out
        "    jb .Lf0_mixed\n    testq %rcx, %rcx\n    je .Lf0_mixed.cold\n.Lf0_mixed:\n")
      (asm-has?
        out
        "    jb .Lf0_calls\n    call helper\n    call tl_oob_abort\n.Lf0_calls:\n")
      (asm-has? out "    jne .Lf0_keep\n    movq $1, %rax\n")
      ;; The return label and its row stay with the cold call inside the
      ;; function range. The noreturn call needs no jump to the continuation.
      (asm-has?
        out
        "    call .L_tl_abort_tl_oob_abort_at\n.L_tl_abort_site_1_bounds:\n    .tl_abort_row .L_tl_abort_site_1_bounds, .L_tl_str_fat, 4, 9, tl_oob_abort_at\n.Lf0_bounds_ok.1.stub1.cold:\n")
      (asm-lacks? out "_bounds_end")
      (asm-lacks? out ".back")
      (> ret-at 0)
      (> bounds-stub-at ret-at)
      (> div-stub-at bounds-stub-at)
      (> size-at div-stub-at)
      (asm-lacks? out "    jb .Lf0_bounds_ok.1\n"))))

;; COLD-1 sharing: stubs of one function whose whole body is the same
;; argument-free abort call are emitted once, and every check jumps there. A
;; different abort keeps its own stub, and no stub is shared across functions.
(define (compiler-backend-cold-share-source) : String
  (str_cat.str-cat
    ".text\n.globl f\n    .type f,@function\nf:\n"
    "    cmpq %r9, %rdi\n    jb .Lf0_a\n    call tl_oob_abort\n.Lf0_a:\n"
    "    cmpq %r9, %rsi\n    jb .Lf0_b\n    call tl_oob_abort\n.Lf0_b:\n"
    "    testq %r8, %r8\n    jne .Lf0_c\n    call tl_div_abort\n.Lf0_c:\n"
    "    ret\n    .size f, . - f\n"
    ".globl g\n    .type g,@function\ng:\n"
    "    cmpq %r9, %rdi\n    jb .Lf1_a\n    call tl_oob_abort\n.Lf1_a:\n"
    "    ret\n    .size g, . - g\n"))

(define (compiler-backend-cold-share-ok?) : bool
  (let
    [out : String
      (text_buf.render
        (compiler-backend-peephole-text-buf-once
          (text_buf.append
            (text_buf.empty)
            (compiler-backend-cold-share-source))))]
    (and
      (asm-has?
        out
        "    cmpq %r9, %rdi\n    jae .Lf0_a.cold\n.Lf0_a:\n    cmpq %r9, %rsi\n    jae .Lf0_a.cold\n.Lf0_b:\n")
      (asm-has?
        out
        "    testq %r8, %r8\n    je .Lf0_c.cold\n.Lf0_c:\n    ret\n")
      (asm-has?
        out
        ".Lf0_a.cold:\n    call tl_oob_abort\n.Lf0_c.cold:\n    call tl_div_abort\n    .size f, . - f\n")
      (asm-lacks? out ".Lf0_b.cold")
      (asm-has?
        out
        "    jae .Lf1_a.cold\n.Lf1_a:\n    ret\n.Lf1_a.cold:\n    call tl_oob_abort\n    .size g, . - g\n"))))

;; COLD-EDGE: a jump over a cold edge block is inverted and the block moves to
;; the end of its function under its own label, so the in-loop side falls
;; through. `g`'s cold block makes a call, `h`'s jump does not land right
;; after it, and `k`'s edge block is not cold: all three stay where they are.
(define (compiler-backend-cold-edge-source) : String
  (str_cat.str-cat
    ".text\n.globl f\n    .type f,@function\nf:\n.Lf0_loop:\n"
    "    cmpb (%rdx,%rax,1), %sil\n    je .Lf0_merge\n"
    ".Lf0_loop_branch_cold_false:\n    xorl %eax, %eax\n    jmp .Lf0_exit\n"
    ".Lf0_merge:\n    addq $1, %rax\n    cmpq %r9, %rax\n    jl .Lf0_loop\n"
    "    movl $1, %eax\n.Lf0_exit:\n    ret\n    .size f, . - f\n"
    ".globl g\n    .type g,@function\ng:\n.Lf1_loop:\n"
    "    testq %rdi, %rdi\n    je .Lf1_merge\n"
    ".Lf1_loop_branch_cold_true:\n    call h\n    jmp .Lf1_exit\n"
    ".Lf1_merge:\n    jl .Lf1_loop\n.Lf1_exit:\n    ret\n    .size g, . - g\n"
    ".globl h\n    .type h,@function\nh:\n.Lf2_loop:\n"
    "    testq %rdi, %rdi\n    je .Lf2_exit\n"
    ".Lf2_loop_branch_cold_true:\n    movq %rsi, %rax\n    jmp .Lf2_exit\n"
    ".Lf2_merge:\n    jl .Lf2_loop\n.Lf2_exit:\n    ret\n    .size h, . - h\n"
    ".globl k\n    .type k,@function\nk:\n.Lf3_loop:\n"
    "    testq %rdi, %rdi\n    je .Lf3_merge\n"
    ".Lf3_loop_branch_true:\n    movq %rsi, %rax\n    jmp .Lf3_exit\n"
    ".Lf3_merge:\n    jl .Lf3_loop\n.Lf3_exit:\n    ret\n    .size k, . - k\n"))

(define (compiler-backend-cold-edge-ok?) : bool
  (let
    [out : String
      (text_buf.render
        (compiler-backend-peephole-text-buf-once
          (text_buf.append (text_buf.empty) (compiler-backend-cold-edge-source))))]
    (and
      (asm-has?
        out
        "    cmpb (%rdx,%rax,1), %sil\n    jne .Lf0_loop_branch_cold_false\n.Lf0_merge:\n")
      (asm-has?
        out
        "    ret\n.Lf0_loop_branch_cold_false:\n    xorl %eax, %eax\n    jmp .Lf0_exit\n    .size f, . - f\n")
      (asm-has?
        out
        "    je .Lf1_merge\n.Lf1_loop_branch_cold_true:\n    call h\n")
      (asm-has?
        out
        "    je .Lf2_exit\n.Lf2_loop_branch_cold_true:\n    movq %rsi, %rax\n")
      (asm-has?
        out
        "    je .Lf3_merge\n.Lf3_loop_branch_true:\n    movq %rsi, %rax\n"))))

;; Hot-loop alignment: a moved cold edge block's jump back to its exit target
;; is not a back edge, so `.Lf0_out` gets no padding. The same jump from an
;; ordinary edge block still makes `.Lf1_out` a loop top.
(define (compiler-backend-cold-edge-align-ok?) : bool
  (let
    [text : String
      (str_cat.str-cat
        "f:\n    jmp .Lf0_out\n.Lf0_out:\n    movl $1, %eax\n    jmp .Lf0_end\n"
        ".Lf0_end:\n    ret\n.Lf0_loop_branch_cold_false:\n    xorl %eax, %eax\n"
        "    jmp .Lf0_out\n"
        "g:\n    jmp .Lf1_out\n.Lf1_out:\n    movl $1, %eax\n    jmp .Lf1_end\n"
        ".Lf1_end:\n    ret\n.Lf1_loop_branch_false:\n    xorl %eax, %eax\n"
        "    jmp .Lf1_out\n")]
    [aligned : String
      (be_peephole.compiler-backend-loop-align-text text (arena.current))]
    (and
      (asm-lacks? aligned "    .p2align 4,,10\n.Lf0_out:\n")
      (asm-has? aligned "    .p2align 4,,10\n.Lf1_out:\n"))))

;; COLD-EDGE Shape 2: both guard edges carry copies, so the true edge ends in
;; `jmp O` right before `<guard>_branch_cold_false:` followed by `O:`. Moving
;; the cold false edge out of line turns `jmp O` into a fallthrough and drops
;; it, and loop alignment does not misclassify the moved edge's `jmp` as a loop
;; back-edge.
(define (compiler-backend-cold-edge-shape2-ok?) : bool
  (let
    [src : String
      (str_cat.str-cat
        ".text\n.globl f\n    .type f,@function\nf:\n"
        ".Lf0_while_body.1__unroll_guard:\n"
        "    testq %rdx, %rdx\n"
        "    jle .Lf0_while_body.1__unroll_guard_branch_cold_false\n"
        ".Lf0_while_body.1__unroll_guard_branch_true:\n"
        "    xorl %eax, %eax\n"
        "    jmp .Lf0_while_body.1__unroll_body\n"
        ".Lf0_while_body.1__unroll_guard_branch_cold_false:\n"
        "    xorl %eax, %eax\n"
        "    jmp .Lf0_while_body.1\n"
        ".Lf0_while_body.1__unroll_body:\n"
        "    addq $4, %rax\n"
        "    ret\n"
        ".Lf0_while_body.1:\n"
        "    addq $1, %rax\n"
        "    ret\n"
        "    .size f, . - f\n")]
    [out : String
      (text_buf.render
        (compiler-backend-peephole-text-buf-once
          (text_buf.append (text_buf.empty) src)))]
    [aligned : String
      (be_peephole.compiler-backend-loop-align-text
        (string.copy (& out))
        (arena.current))]
    (and
      (asm-has?
        out
        ".Lf0_while_body.1__unroll_guard_branch_true:\n    xorl %eax, %eax\n.Lf0_while_body.1__unroll_body:\n")
      (asm-lacks? out "    jmp .Lf0_while_body.1__unroll_body\n")
      (asm-has?
        out
        ".Lf0_while_body.1__unroll_guard_branch_cold_false:\n    xorl %eax, %eax\n    jmp .Lf0_while_body.1\n    .size f, . - f\n")
      (asm-lacks? aligned "    .p2align 4,,10\n.Lf0_while_body.1:\n"))))

;; Redundant `movzb{l,q}` elimination after `xorl %r32, %r32` and
;; `movl $K, %r32` (0 <= K <= 255) on the same register; out-of-range
;; immediates, negative immediates, cross-register xorl, and mismatched
;; registers stay intact.
(define (compiler-backend-peephole-redundant-zext-imm-ok?) : bool
  (let
    [src : String
      (str_cat.str-cat
        "f:\n"
        "    xorl %eax, %eax\n    movzbl %al, %eax\n"
        "    movl $1, %r8d\n    movzbq %r8b, %r8\n"
        "    movl $255, %edx\n    movzbl %dl, %edx\n"
        "    movl $256, %ecx\n    movzbl %cl, %ecx\n"
        "    movl $-1, %esi\n    movzbl %sil, %esi\n"
        "    xorl %eax, %edi\n    movzbl %dil, %edi\n"
        "    movl $1, %eax\n    movzbl %r9b, %r9d\n"
        "    ret\n")]
    [out : String
      (text_buf.render
        (compiler-backend-peephole-text-buf-once
          (text_buf.append (text_buf.empty) src)))]
    (be_state.backend-and4
      (asm-lacks?
        out
        "    movzbl %al, %eax\n"
        "    movzbq %r8b, %r8\n"
        "    movzbl %dl, %edx\n")
      (asm-has?
        out
        "    movl $256, %ecx\n    movzbl %cl, %ecx\n"
        "    movl $-1, %esi\n    movzbl %sil, %esi\n")
      (asm-has?
        out
        "    xorl %eax, %edi\n    movzbl %dil, %edi\n"
        "    movl $1, %eax\n    movzbl %r9b, %r9d\n")
      true)))

;; Self-register Bool reload elides `movzbl`; cross-register Bool and u8/i8
;; keep their widening moves.
(define (compiler-backend-load-register-bool-self-elide-ok?) : bool
  (let
    [bases : i64 (ast.ast-node-pool-reader-type-segment-bases)]
    (be_state.backend-and4
      (string.eq
        (be_scalar.compiler-backend-emit-load-register-to-reg
          bases
          "%rax"
          (& (Bool))
          "%rax")
        "")
      (string.eq
        (be_scalar.compiler-backend-emit-load-register-to-reg
          bases
          "%rdi"
          (& (Bool))
          "%rax")
        "    movzbl %dil, %eax\n")
      (string.eq
        (be_scalar.compiler-backend-emit-load-register-to-reg
          bases
          "%rax"
          (& (U8))
          "%rax")
        "    movzbl %al, %eax\n")
      (string.eq
        (be_scalar.compiler-backend-emit-load-register-to-reg
          bases
          "%rax"
          (& (I8))
          "%rax")
        "    movsbq %al, %rax\n"))))

;; Compare the final streaming path against the former raw-buffer -> whole
;; peephole -> sweep sequence on the same lowered program. Re-lowering resets
;; the recorded FPO sweep metadata before the streaming run.
(define (compiler-backend-streamed-final-output-equivalent-source?
  [src : String]) : bool
  (match (lower.lower-compiler-source
    (owned_view.compiler-owned-shared-view src))
    [(Ok first-program first-spans lower-owner)
      (let
        [result : bool
          (let
            [legacy-state : be_state.CompilerBackendState
              (be_state.compiler-backend-state-new
                (ci.intern-compat-state-capture-active))]
            [legacy-stream : be_state.CompilerBackendStreamState
              (be_state.compiler-backend-state-stream-state legacy-state)]
            (match (backend.compiler-backend-emit-program-target-with-mode-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
              legacy-state
              (ast.ast-node-pool-reader-type-segment-bases)
              first-program
              (be_state.CompilerBackendTarget.Linux)
              (Scalar)
              first-spans
              true
              false
              false
              (profile_state.compiler-profile-state-new))
              [(Ok raw)
                (let
                  [legacy : String
                    (text_buf.render
                      (backend.compiler-backend-peephole-asm-buffer-with-state
                        legacy-state
                        legacy-stream
                        (text_buf.render raw)
                        true
                        true))]
                  (match (lower.lower-compiler-source src)
                    [(Ok second-program second-spans lower-owner)
                      (let
                        [result : bool
                          (match (backend.compiler-backend-emit-program-target-with-mode-final-buffer-with-type-segment-bases-and-crt-and-profile-state-backend-state
                            (be_state.compiler-backend-state-new
                              (ci.intern-compat-state-capture-active))
                            (ast.ast-node-pool-reader-type-segment-bases)
                            second-program
                            (be_state.CompilerBackendTarget.Linux)
                            (Scalar)
                            second-spans
                            true
                            false
                            (profile_state.compiler-profile-state-new))
                            [(Ok streamed)
                              (string.eq legacy (text_buf.render streamed))]
                            [(Err _) false])]
                        (lower.compiler-lower-arena-state-release!
                          (lower.compiler-lower-state-arenas lower-owner))
                        result)]
                    [(Err _) false]))]
              [(Err _) false]))]
        (lower.compiler-lower-arena-state-release!
          (lower.compiler-lower-state-arenas lower-owner))
        result)]
    [(Err _) false]))

(define (compiler-backend-streamed-final-output-equivalent?) : bool
  (compiler-backend-streamed-final-output-equivalent-source?
    (compiler-backend-smoke-source)))

;; 65 functions crosses the production 64-function raw batch boundary.
(define (compiler-backend-streamed-final-batch-equivalent?) : bool
  (let
    [buf : text_buf.TextBuf (text_buf.empty)]
    (for [i (iterator.range 0 65)]
      (set!
        buf
        (text_buf.append
          buf
          (str_cat.str-cat
            "(define (f"
            (string.int->string i)
            ") : i64 "
            (string.int->string i)
            ")\n"))))
    (compiler-backend-streamed-final-output-equivalent-source?
      (text_buf.render
        (text_buf.append buf "(define (main) : i64 (+ (f0) (f64)))\n")))))

(define (compiler-backend-rax-forward-chain-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = mul 2, 3 : i64
     %1 = add %0, 7 : i64
     %2 = add 11, %1 : i64
     return %2"))

(define (compiler-backend-rax-forward-multiple-use-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs
    "%0 = add 1, 2 : i64
     %1 = add %0, 3 : i64
     %2 = add %0, 4 : i64
     return %2"))

(define (compiler-backend-rax-forward-variable-shift-instrs) : ir.CompilerIrInstrSeq
  (irt.instrs "%0 = shl 1, %1 : i64
     return %0"))

(define (compiler-backend-call-arg-rax-forward-direct-instrs) : ir.CompilerIrInstrSeq
  (compiler-backend-test-instr-seq-prepend
    (Call 0 (ci.intern "producer") (Nil) (I64))
    (compiler-backend-test-instr-seq-prepend
      (Call 1 (ci.intern "consume") (One (Var 0)) (I64))
      (compiler-backend-test-instr-seq-prepend
        (Return (Some (Var 1)))
        (ir.compiler-ir-instr-seq-empty)))))

(define (compiler-backend-call-arg-rax-forward-indirect-instrs) : ir.CompilerIrInstrSeq
  (compiler-backend-test-instr-seq-prepend
    (Call 0 (ci.intern "producer") (Nil) (I64))
    (compiler-backend-test-instr-seq-prepend
      (CallIndirect 1 (Function (ci.intern "consume")) (One (Var 0)) (I64))
      (compiler-backend-test-instr-seq-prepend
        (Return (Some (Var 1)))
        (ir.compiler-ir-instr-seq-empty)))))

(define (compiler-backend-call-arg-rax-nonleading-instrs) : ir.CompilerIrInstrSeq
  (compiler-backend-test-instr-seq-prepend
    (Call 0 (ci.intern "producer") (Nil) (I64))
    (compiler-backend-test-instr-seq-prepend
      (Call 1 (ci.intern "consume2") (Two (I64 7) (Var 0)) (I64))
      (compiler-backend-test-instr-seq-prepend
        (Return (Some (Var 1)))
        (ir.compiler-ir-instr-seq-empty)))))

(define (compiler-backend-call-arg-rax-group-consumer-instrs) : ir.CompilerIrInstrSeq
  (compiler-backend-test-instr-seq-prepend
    (Call 0 (ci.intern "producer") (Nil) (I64))
    (compiler-backend-test-instr-seq-prepend
      (Call 1 (ci.intern "consume_group") (One (Var 0)) (I64))
      (compiler-backend-test-instr-seq-prepend
        (Return (Some (Var 1)))
        (ir.compiler-ir-instr-seq-empty)))))

(define (compiler-backend-call-arg-rax-group-consumer-index) : be_state.CompilerBackendProgramIndex
  (let
    [ty : ast.AstType (compiler-backend-register-group-test-type)]
    (compiler-backend-program-index-build
      (ast.ast-node-pool-reader-type-segment-bases)
      (ir.compiler-ir-function-seq-prepend
        (&
          (Function
            (ci.intern "group_seed")
            (ir.compiler-ir-param-seq-empty)
            (Unit)
            3
            (ir.compiler-ir-blocks
              (ir.CompilerIrBlock.Block
                (ir.compiler-ir-label "entry")
                (compiler-backend-test-instr-seq-prepend
                  (Pack
                    2
                    (ir.compiler-ir-value-seq-prepend
                      (& (I64 1))
                      (&
                        (ir.compiler-ir-value-seq-prepend
                          (& (I64 2))
                          (& (ir.compiler-ir-value-seq-empty)))))
                    (owned_view.compiler-owned-shared-view ty))
                  (ir.compiler-ir-instr-seq-empty))))
            Ordinary))
        (&
          (ir.compiler-ir-function-seq-prepend
            (&
              (Function
                (ci.intern "consume_group")
                (ir.compiler-ir-param-seq-prepend
                  (Param "value" ty 0)
                  (ir.compiler-ir-param-seq-empty))
                (I64)
                1
                (ir.compiler-ir-block-list-empty)
                Ordinary))
            (& (ir.compiler-ir-function-seq-empty)))))
      (ir.compiler-ir-extern-seq-empty))))

(define (compiler-backend-call-arg-rax-group-consumer-not-forwardable?) : bool
  (asm-ok?
    (compiler-backend-emit-rax-forward-test-instrs-with-index
      (compiler-backend-call-arg-rax-group-consumer-instrs)
      2
      (compiler-backend-call-arg-rax-group-consumer-index))
    (has "    call _tl_consume_group\n")
    (lacks "    movq %rax, %rdi\n")))

(define (compiler-backend-emit-rax-forward-test-instrs-with-index
  [instrs : ir.CompilerIrInstrSeq]
  [vars : i64]
  [program-index : be_state.CompilerBackendProgramIndex]) : be_state.ResultCompilerBackend
  (let
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (owned_view.compiler-owned-shared-view instrs)))]
    [use-counts : (__tl_dyn-array i64)
      (backend.compiler-backend-function-use-counts
        vars
        (owned_view.compiler-owned-shared-view blocks))]
    [instr-count : i64 (ir.compiler-ir-instr-seq-count instrs)]
    [runtime-plan : be_state.CompilerBackendRuntimePlan
      (compiler-backend-runtime-helper-full-plan)]
    [_scratch-position : unit
      (begin
        (set-state-emit-instr-post-base!
          program-index.backend-state
          instr-count)
        (set-state-emit-current-count! program-index.backend-state instr-count)
        (set-state-emit-current-site! program-index.backend-state 0))]
    (compiler-backend-test-emit-instrs-text
      (be_state.CompilerBackendEmissionContext
        (ast.ast-node-pool-reader-type-segment-bases)
        (be_state.compiler-backend-target-policy-new
          be_state.CompilerBackendTarget.Linux)
        "_tl_test"
        (ci.intern "test")
        blocks
        (ir.compiler-ir-label "entry")
        (regalloc.compiler-reg-assignment-table-empty)
        vars
        (regalloc.compiler-reg-var-types-empty)
        (Empty)
        (I64)
        runtime-plan
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty)
        program-index
        (ir.compiler-source-spans-empty)
        (compiler-backend-source-span-index-build
          (ir.compiler-source-spans-empty))
        (cdiag.compiler-diagnostic-at-start "" "")
        use-counts
        program-index.backend-state
        (be_state.compiler-backend-state-function-state
          program-index.backend-state))
      (No)
      instrs)))

(define (compiler-backend-emit-rax-forward-test-instrs
  [instrs : ir.CompilerIrInstrSeq]
  [vars : i64]) : be_state.ResultCompilerBackend
  (compiler-backend-emit-rax-forward-test-instrs-with-index
    instrs
    vars
    (compiler-backend-program-index-build
      (ast.ast-node-pool-reader-type-segment-bases)
      (ir.compiler-ir-function-seq-empty)
      (ir.compiler-ir-extern-seq-empty))))

(define (compiler-backend-rax-forwarding-ok?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs
    (compiler-backend-rax-forward-chain-instrs)
    3)
    [(Ok chain-asm)
      (match (compiler-backend-emit-rax-forward-test-instrs
        (compiler-backend-rax-forward-multiple-use-instrs)
        3)
        [(Ok multi-use-asm)
          (match (compiler-backend-emit-rax-forward-test-instrs
            (compiler-backend-rax-forward-variable-shift-instrs)
            2)
            [(Ok shift-asm)
              (and
                (asm-has?
                  chain-asm
                  "    imulq $3, %rax\n"
                  "    addq $7, %rax\n"
                  "    addq $11, %rax\n")
                (asm-lacks?
                  chain-asm
                  "    movq %rax, -8(%rbp)\n"
                  "    movq %rax, -16(%rbp)\n"
                  "    movq %rax, -24(%rbp)\n")
                (asm-has? multi-use-asm "    movq %r8, -8(%rbp)\n"))]
            [(Err _) false])]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-call-arg-rax-forwarding-ok?) : bool
  (match (compiler-backend-emit-rax-forward-test-instrs
    (compiler-backend-call-arg-rax-forward-direct-instrs)
    2)
    [(Ok direct-asm)
      (match (compiler-backend-emit-rax-forward-test-instrs
        (compiler-backend-call-arg-rax-forward-indirect-instrs)
        2)
        [(Ok indirect-asm)
          (match (compiler-backend-emit-rax-forward-test-instrs
            (compiler-backend-call-arg-rax-nonleading-instrs)
            2)
            [(Ok nonleading-asm)
              (and
                (asm-has?
                  direct-asm
                  "    call _tl_producer\n"
                  "    movq %rax, -8(%rbp)\n"
                  "    movq %rax, %rdi\n")
                (asm-lacks? direct-asm "    movq -8(%rbp), %rdi\n")
                (asm-has? indirect-asm "    movq %rax, %rsi\n")
                (asm-lacks? indirect-asm "    movq -8(%rbp), %rsi\n")
                (asm-has? nonleading-asm "    movq -8(%rbp), %rsi\n")
                (compiler-backend-call-arg-rax-group-consumer-not-forwardable?)
                (asm-lacks? nonleading-asm "    movq %rax, %rsi\n"))]
            [(Err _) false])]
        [(Err _) false])]
    [(Err _) false]))

(define compiler-backend-long-block-instr-count : i64
  4096)

(define (compiler-backend-long-normal-block-seq) : ir.CompilerIrInstrSeq
  (let
    [count : i64 compiler-backend-long-block-instr-count]
    [total : i64 (+ count 1)]
    [slots : (__tl_dyn-array ir.CompilerIrInstr)
      (__tl_make-array ir.CompilerIrInstr total)]
    (for [index (iterator.range 0 count)]
      (set!
        (array-ref slots index)
        (ir.CompilerIrInstr.Mov index (I64 index) (I64))))
    (set!
      (array-ref slots count)
      (ir.CompilerIrInstr.Return (Some (Var (- count 1)))))
    (ir.CompilerIrInstrSeq slots total)))

(define (compiler-backend-long-normal-block-ok?) : bool
  (let
    [instrs : ir.CompilerIrInstrSeq (compiler-backend-long-normal-block-seq)]
    [blocks : ir.CompilerIrBlockList
      (ir.compiler-ir-blocks
        (ir.CompilerIrBlock.Block
          (ir.compiler-ir-label "entry")
          (compiler-backend-long-normal-block-seq)))]
    [use-counts : (__tl_dyn-array i64)
      (backend.compiler-backend-function-use-counts
        compiler-backend-long-block-instr-count
        (owned_view.compiler-owned-shared-view blocks))]
    [test-id : i64 (ci.intern "test")]
    [program-index : be_state.CompilerBackendProgramIndex
      (compiler-backend-program-index-build
        (ast.ast-node-pool-reader-type-segment-bases)
        (ir.compiler-ir-function-seq-empty)
        (ir.compiler-ir-extern-seq-empty))]
    [backend-state : be_state.CompilerBackendState program-index.backend-state]
    (asm-ok?
      (compiler-backend-test-emit-instrs-text
        (be_state.CompilerBackendEmissionContext
          (ast.ast-node-pool-reader-type-segment-bases)
          (be_state.compiler-backend-target-policy-new
            be_state.CompilerBackendTarget.Linux)
          "_tl_test"
          test-id
          blocks
          (ir.compiler-ir-label "entry")
          (regalloc.compiler-reg-assignment-table-empty)
          compiler-backend-long-block-instr-count
          (regalloc.compiler-reg-var-types-empty)
          (Empty)
          (I64)
          (compiler-backend-runtime-helper-full-plan)
          (ir.compiler-ir-function-seq-empty)
          (ir.compiler-ir-extern-seq-empty)
          program-index
          (ir.compiler-source-spans-empty)
          (be_state.compiler-backend-source-span-index-build-with-backend-state
            backend-state
            (ir.compiler-source-spans-empty))
          (cdiag.compiler-diagnostic-at-start "" "")
          use-counts
          backend-state
          (be_state.compiler-backend-state-function-state backend-state))
        (No)
        instrs)
      (has "    movl $4095, %eax\n" "    ret\n"))))

(define (compiler-backend-binop-operand-folding-ok?) : bool
  (let
    [rhs-spill : regalloc.CompilerRegAssignmentTable (reg-homes "%1=spill:-16")]
    [cmp-types : regalloc.CompilerRegVarTypes
      (regalloc.compiler-reg-var-types-insert
        (regalloc.compiler-reg-var-types-insert
          (regalloc.compiler-reg-var-types-empty)
          1
          (I64))
        0
        (I64))]
    (match (be_scalar.compiler-backend-emit-binop
      (ast.ast-node-pool-reader-type-segment-bases)
      (regalloc.compiler-reg-var-types-empty)
      (Empty)
      rhs-spill
      2
      (Add)
      (Var 0)
      (Var 1)
      (I64)
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active)))
      [(Ok add-asm)
        (match (be_scalar.compiler-backend-emit-binop
          (ast.ast-node-pool-reader-type-segment-bases)
          cmp-types
          (Empty)
          rhs-spill
          2
          (Lt)
          (Var 0)
          (Var 1)
          (Bool)
          (be_state.compiler-backend-state-new
            (ci.intern-compat-state-capture-active)))
          [(Ok cmp-asm)
            (and
              (asm-has? add-asm "    addq -16(%rbp), %r8\n")
              (asm-lacks? add-asm "    movq -16(%rbp), %r9\n")
              (asm-has? cmp-asm "    cmpq -16(%rbp), %r8\n    setl %r8b\n")
              (asm-lacks? cmp-asm "    movq -16(%rbp), %r9\n")
              (string.eq
                (let
                  [op (ir.CompilerIrBinOp.And)]
                  (be_scalar.compiler-backend-binop-direct-mnemonic op))
                "and")
              (string.eq
                (let
                  [op (ir.CompilerIrBinOp.Or)]
                  (be_scalar.compiler-backend-binop-direct-mnemonic op))
                "or"))]
          [(Err _) false])]
      [(Err _) false])))

(define (compiler-backend-bounds-operand-folding-ok?) : bool
  (let
    [index-reg : regalloc.CompilerRegAssignmentTable (reg-homes "%0=%r12")]
    [index-reg-length-spill : regalloc.CompilerRegAssignmentTable
      (reg-homes "%0=%r12 %1=spill:-16")]
    (match (compiler-backend-emit-test-instrs
      (irt.instrs "bounds_check %0, 3 message \"bounds_ok\"")
      index-reg
      2)
      [(Ok imm-asm)
        (match (compiler-backend-emit-test-instrs
          (irt.instrs "bounds_check %0, %1 message \"bounds_ok\"")
          index-reg-length-spill
          3)
          [(Ok spill-asm)
            (and
              (asm-has? imm-asm "    cmpq $3, %r12\n")
              (asm-lacks?
                imm-asm
                "    movq %r12, %rax\n"
                "    movl $3, %r11d\n")
              (asm-has? spill-asm "    cmpq -16(%rbp), %r12\n")
              (asm-lacks?
                spill-asm
                "    movq %r12, %rax\n"
                "    movq -16(%rbp), %r11\n"))]
          [(Err _) false])]
      [(Err _) false])))

(define (compiler-backend-bounds-direct-pressure-tail
  [index : i64]
  [count : i64]) : ir.CompilerIrInstrSeq
  (if (>= index count)
    (irt.instrs "return")
    (compiler-backend-test-instr-seq-prepend
      (StorePtr (Var 0) (Var index) (I64))
      (compiler-backend-bounds-direct-pressure-tail (+ index 1) count))))

;; A direct register/memory length operand needs no scratch. Under full register
;; pressure an eager, unused scavenge would otherwise add an emergency stack
;; save at the bounds check even though the compare already has both operands.
(define (compiler-backend-bounds-direct-pressure-asm) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_slot : unit
      (set-scratch-emergency-slot-offset!
        (be_state.compiler-backend-state-function-state backend-state)
        -512)]
    [regs : (__tl_dyn-array i64)
      (be_operand.compiler-backend-scavenge-candidates)]
    [count : i64 (array-length regs)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-test-reg-assignment-table-from regs 0)]
    [instrs : ir.CompilerIrInstrSeq
      (compiler-backend-test-instr-seq-prepend
        (irt.instr "bounds_check %0, %1 message \"bounds_ok\"")
        (compiler-backend-bounds-direct-pressure-tail 1 count))]
    [result : be_state.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        count
        (be_state.CompilerBackendTarget.Linux)
        backend-state)]
    result))

(define (compiler-backend-bounds-direct-pressure-ok?) : bool
  (asm-ok?
    (compiler-backend-bounds-direct-pressure-asm)
    (has "    cmpq %rcx, %r9\n")
    (lacks "-512(%rbp)")))

;; Direct register binops need no scratch. Keep every scavenger candidate live
;; across the instruction so an eager fallback selection is observable as an
;; emergency-slot save even though LEA and the direct-source XOR do not consume
;; the selected register.
(define (compiler-backend-binop-direct-pressure-asm [op : ir.CompilerIrBinOp]) : be_state.ResultCompilerBackend
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_slot : unit
      (set-scratch-emergency-slot-offset!
        (be_state.compiler-backend-state-function-state backend-state)
        -512)]
    [regs : (__tl_dyn-array i64)
      (be_operand.compiler-backend-scavenge-candidates)]
    [count : i64 (array-length regs)]
    [assignments : regalloc.CompilerRegAssignmentTable
      (compiler-backend-test-reg-assignment-table-from regs 0)]
    [instrs : ir.CompilerIrInstrSeq
      (compiler-backend-test-instr-seq-prepend
        (BinOp 2 op (Var 0) (Var 1) (I64))
        (compiler-backend-bounds-direct-pressure-tail 1 count))]
    [result : be_state.ResultCompilerBackend
      (compiler-backend-emit-test-instrs-target-with-backend-state
        instrs
        assignments
        count
        (be_state.CompilerBackendTarget.Linux)
        backend-state)]
    result))

(define (compiler-backend-binop-direct-pressure-ok?) : bool
  (match (compiler-backend-binop-direct-pressure-asm (Add))
    [(Ok add-asm)
      (match (compiler-backend-binop-direct-pressure-asm (BitXor))
        [(Ok xor-asm)
          (and
            (asm-has? add-asm "    leaq (%r9,%rcx), %rdx\n")
            (asm-has? xor-asm "    movq %r9, %rdx\n    xorq %rcx, %rdx\n")
            (asm-lacks? add-asm "-512(%rbp)")
            (asm-lacks? xor-asm "-512(%rbp)"))]
        [(Err _) false])]
    [(Err _) false]))

(define (compiler-backend-win64-bounds-index-scratch-ok?) : bool
  (let
    [length-rax : regalloc.CompilerRegAssignmentTable (reg-homes "%1=%rax")]
    [ok : bool
      (match (compiler-backend-emit-test-instrs-target
        (irt.instrs "bounds_check 0, %1 message \"bounds_ok\"")
        length-rax
        2
        (be_state.CompilerBackendTarget.Windows))
        [(Ok asm)
          ;; The merged emitter folds the constant index 0 directly into the
          ;; bounds check (`testq %rax, %rax`) instead of materializing it in a
          ;; scratch register. The Win64 safety invariant is unchanged: the
          ;; length (in %rax) is never clobbered, so no degenerate
          ;; `cmpq %rax, %rax` self-compare is emitted.
          (and
            (asm-has? asm "    testq %rax, %rax\n")
            (asm-lacks? asm "    cmpq %rax, %rax\n"))]
        [(Err _) false])]
    ok))

(define (compiler-backend-win64-compare-rhs-rax-ok?) : bool
  (let
    [backend-state : be_state.CompilerBackendState
      (be_state.compiler-backend-state-new
        (ci.intern-compat-state-capture-active))]
    [_win : unit (compiler-backend-set-current-fn-win64! backend-state)]
    [rhs-rax : regalloc.CompilerRegAssignmentTable (reg-homes "%1=%rax")]
    [ok : bool
      (match (be_scalar.compiler-backend-emit-compare-branch
        (ast.ast-node-pool-reader-type-segment-bases)
        rhs-rax
        "cmp"
        (Lt)
        (Var 0)
        (Var 1)
        (I64)
        (ir.compiler-ir-label "then")
        (ir.compiler-ir-label "else")
        (No)
        backend-state)
        [(Ok asm)
          ;; The merged emitter folds the spilled LHS (var0 at -8(%rbp)) directly
          ;; into the compare as a memory operand (`cmpq %rax, -8(%rbp)`) instead
          ;; of loading it into a scratch register first. The Win64 safety
          ;; invariant is unchanged: the RHS in %rax is never clobbered, so no
          ;; degenerate `cmpq %rax, %rax` self-compare is emitted.
          (and
            (asm-has? asm "    cmpq %rax, -8(%rbp)\n")
            (asm-lacks? asm "    cmpq %rax, %rax\n"))]
        [(Err _) false])]
    [_linux : unit (compiler-backend-set-current-fn-linux! backend-state)]
    ok))

(define (compiler-backend-peephole-single-dest-mnemonic? [name : String]) : bool
  (be_peephole.compiler-backend-peephole-mnemonic-single-dest?
    (unsafe
      (string-data name))
    0
    (string.string-length name)))

(define (compiler-backend-test-peephole-reg-index [name : String]) : i64
  (be_peephole.compiler-backend-peephole-token-reg-index-range
    (unsafe
      (string-data name))
    0
    (string.string-length name)))

(define (compiler-backend-test-peephole-memory-base [operand : String]) : i64
  (be_peephole.compiler-backend-peephole-memory-base-range
    (unsafe
      (string-data operand))
    0
    (string.string-length operand)))

(define (compiler-backend-peephole-operand-classifiers-ok?) : bool
  (and
    (= (compiler-backend-test-peephole-reg-index "%rax") 0)
    (= (compiler-backend-test-peephole-reg-index "%rcx") 1)
    (= (compiler-backend-test-peephole-reg-index "%rdx") 2)
    (= (compiler-backend-test-peephole-reg-index "%rbx") 3)
    (= (compiler-backend-test-peephole-reg-index "%rsi") 4)
    (= (compiler-backend-test-peephole-reg-index "%rdi") 5)
    (= (compiler-backend-test-peephole-reg-index "%r8") 6)
    (= (compiler-backend-test-peephole-reg-index "%r9") 7)
    (= (compiler-backend-test-peephole-reg-index "%r10") 8)
    (= (compiler-backend-test-peephole-reg-index "%r11") 9)
    (= (compiler-backend-test-peephole-reg-index "%r12") 10)
    (= (compiler-backend-test-peephole-reg-index "%r13") 11)
    (= (compiler-backend-test-peephole-reg-index "%r14") 12)
    (= (compiler-backend-test-peephole-reg-index "%r15") 13)
    (= (compiler-backend-test-peephole-reg-index "%eax") 0)
    (= (compiler-backend-test-peephole-reg-index "%ax") 0)
    (= (compiler-backend-test-peephole-reg-index "%al") 0)
    (= (compiler-backend-test-peephole-reg-index "%ecx") 1)
    (= (compiler-backend-test-peephole-reg-index "%cx") 1)
    (= (compiler-backend-test-peephole-reg-index "%cl") 1)
    (= (compiler-backend-test-peephole-reg-index "%edx") 2)
    (= (compiler-backend-test-peephole-reg-index "%dx") 2)
    (= (compiler-backend-test-peephole-reg-index "%dl") 2)
    (= (compiler-backend-test-peephole-reg-index "%ebx") 3)
    (= (compiler-backend-test-peephole-reg-index "%bx") 3)
    (= (compiler-backend-test-peephole-reg-index "%bl") 3)
    (= (compiler-backend-test-peephole-reg-index "%esi") 4)
    (= (compiler-backend-test-peephole-reg-index "%si") 4)
    (= (compiler-backend-test-peephole-reg-index "%sil") 4)
    (= (compiler-backend-test-peephole-reg-index "%edi") 5)
    (= (compiler-backend-test-peephole-reg-index "%di") 5)
    (= (compiler-backend-test-peephole-reg-index "%dil") 5)
    (= (compiler-backend-test-peephole-reg-index "%r8d") 6)
    (= (compiler-backend-test-peephole-reg-index "%r8w") 6)
    (= (compiler-backend-test-peephole-reg-index "%r8b") 6)
    (= (compiler-backend-test-peephole-reg-index "%r15d") 13)
    (= (compiler-backend-test-peephole-reg-index "%r15w") 13)
    (= (compiler-backend-test-peephole-reg-index "%r15b") 13)
    (= (compiler-backend-test-peephole-reg-index "%rbp") -1)
    (= (compiler-backend-test-peephole-reg-index "%rsp") -1)
    (= (compiler-backend-test-peephole-reg-index "%rip") -1)
    (= (compiler-backend-test-peephole-reg-index "%ah") -1)
    (= (compiler-backend-test-peephole-reg-index "%xmm0") -1)
    (= (compiler-backend-test-peephole-reg-index "%r16") -1)
    (=
      (compiler-backend-test-peephole-memory-base "-8(%rbp)")
      be_peephole.compiler-backend-peephole-memory-base-rbp)
    (=
      (compiler-backend-test-peephole-memory-base "(%rsp)")
      be_peephole.compiler-backend-peephole-memory-base-rsp)
    (=
      (compiler-backend-test-peephole-memory-base "symbol(%rip)")
      be_peephole.compiler-backend-peephole-memory-base-rip)
    (=
      (compiler-backend-test-peephole-memory-base "24(%r10)")
      be_peephole.compiler-backend-peephole-memory-base-r10)
    (=
      (compiler-backend-test-peephole-memory-base "24(%r11)")
      be_peephole.compiler-backend-peephole-memory-base-none)
    (=
      (compiler-backend-test-peephole-memory-base "%rax")
      be_peephole.compiler-backend-peephole-memory-base-none)))

(define (compiler-backend-test-control-mnemonic-kind [name : String]) : i64
  (be_operand.compiler-backend-control-mnemonic-kind
    (unsafe
