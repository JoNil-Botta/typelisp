  (define compiler-lower-profile-detail-start-ms : i64
    0))

;; Deep string concat lowering has a deliberately bounded fan-in. Keep these
;; counters in the compile-profile build so the regression fixture can prove
;; that a wide tree is flattened once and emitted as a small number of runtime
;; calls.
(cfg
  compile-profile
  (define compiler-lower-profile-string-concat-trees : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-string-concat-leaves : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-string-concat-runtime-calls : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-env-binds : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-env-lookups : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-env-lookup-steps : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-env-stores : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-env-store-grows : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-env-materializations : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-env-materialized-entries : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-cache-builds : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-cache-entries : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-cache-lookups : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-cache-local-hits : i64
    0))
(cfg
  compile-profile
  (define compiler-lower-profile-name-cache-local-misses : i64
    0))

;; Non-resetting stage snapshots inside lower.typecheck: the checked-program
;; build's retention decomposes across the walk / clone augmentation / context
;; extension stages. Detail rows carry absolute alloc-live and the running peak
;; so analysis can diff stages without perturbing the phase-level peak math.
;; Kept out of the shipped compiler: the compile-profile verifier gate rejects
;; unexpected detail rows, so these fire only in local measurement builds.
(cfg
  compile-profile
  (define (compiler-lower-profile-field [value : i64]) : String
    (string.append "|" (string.int->string value))))

(cfg
  compile-profile
  (define (compiler-lower-profile-start) : unit
    (begin
      (set! compiler-lower-profile-start-ms (profile.now-ms))
      (set! compiler-lower-profile-start-total (profile.alloc-total))
      (set! compiler-lower-profile-start-live (profile.alloc-live))
      (set!
        compiler-lower-profile-start-intern
        (ci.intern-profile-intern-value))
      (set!
        compiler-lower-profile-start-intern-slice
        (ci.intern-profile-slice-value))
      (set!
        compiler-lower-profile-start-intern-generated
        (ci.intern-profile-generated-value))
      (set!
        compiler-lower-profile-start-intern-render
        (ci.intern-profile-render-value))
      (profile.alloc-reset-peak))))

(cfg
  compile-profile
  (define (compiler-lower-profile-finish [phase : String]) : unit
    (let
      [end-ms : i64 (profile.now-ms)]
      [end-total : i64 (profile.alloc-total)]
      [end-live : i64 (profile.alloc-live)]
      [peak-delta : i64
        (- (profile.alloc-peak) compiler-lower-profile-start-live)]
      (begin
        (io.print-error
          (string.append
            "compile-profile|lower."
            (string.append
              phase
              (string.append
                (compiler-lower-profile-field
                  (- end-ms compiler-lower-profile-start-ms))
                (string.append
                  (compiler-lower-profile-field
                    (- end-total compiler-lower-profile-start-total))
                  (string.append
                    (compiler-lower-profile-field
                      (- end-live compiler-lower-profile-start-live))
                    (string.append
                      (compiler-lower-profile-field peak-delta)
                      "\n")))))))
        (cfg
          compile-profile-summary
          unit
          (io.print-error
            (string.append
              "compile-profile-detail|intern.lower_phase|"
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string
                      (-
                        (ci.intern-profile-intern-value)
                        compiler-lower-profile-start-intern))
                    "\n"))))))
        (cfg
          compile-profile-summary
          unit
          (io.print-error
            (string.append
              "compile-profile-detail|intern.lower_phase.slice|"
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string
                      (-
                        (ci.intern-profile-slice-value)
                        compiler-lower-profile-start-intern-slice))
                    "\n"))))))
        (cfg
          compile-profile-summary
          unit
          (io.print-error
            (string.append
              "compile-profile-detail|intern.lower_phase.render|"
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string
                      (-
                        (ci.intern-profile-render-value)
                        compiler-lower-profile-start-intern-render))
                    "\n"))))))
        (cfg
          compile-profile-summary
          unit
          (io.print-error
            (string.append
              "compile-profile-detail|intern.lower_phase.generated|"
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string
                      (-
                        (ci.intern-profile-generated-value)
                        compiler-lower-profile-start-intern-generated))
                    "\n"))))))))))

(cfg
  compile-profile
  (define (compiler-lower-profile-detail-start) : unit
    (set! compiler-lower-profile-detail-start-ms (profile.now-ms))))

(cfg
  compile-profile
  (define (compiler-lower-profile-detail-finish
    [phase : String]
    [name : String]) : unit
    (let
      [elapsed : i64
        (- (profile.now-ms) compiler-lower-profile-detail-start-ms)]
      (cfg
        compile-profile-summary
        unit
        (if (>= elapsed 1)
          (io.print-error
            (string.append
              "compile-profile-detail|lower."
              (string.append
                phase
                (string.append
                  "|"
                  (string.append
                    (string.int->string elapsed)
                    (string.append "|" (string.append name "\n")))))))
          unit)))))

(cfg
  compile-profile
  ;; Counter rows reuse the six-field phase schema so benchmark profile.tsv
  ;; extraction preserves them; the counter value lives in the live-delta slot.
  (define (compiler-lower-profile-counter [name : String] [value : i64]) : unit
    (io.print-error
      (string.append
        "compile-profile|lower."
        (string.append
          name
          (string.append
            "|0|0"
            (string.append (compiler-lower-profile-field value) "|0\n")))))))

(cfg
  compile-profile
  (define (compiler-lower-profile-specialization-counters) : unit
    (begin
      (compiler-lower-profile-counter
        "specialization.structural_keys.created"
        (spec.spec-profile-structural-key-created-value))
      (compiler-lower-profile-counter
        "specialization.structural_keys.reused"
        (spec.spec-profile-structural-key-reused-value))
      (compiler-lower-profile-counter
        "specialization.generated_text.materialized"
        (spec.spec-profile-generated-text-materialized-value))
      (compiler-lower-profile-counter
        "specialization.render.calls"
        (spec.spec-profile-name-render-calls-value))
      (compiler-lower-profile-counter
        "specialization.render.cache_hits"
        (spec.spec-profile-name-render-cache-hits-value))
      (compiler-lower-profile-counter
        "specialization.render.cache_misses"
        (spec.spec-profile-name-render-cache-misses-value)))))

(cfg
  compile-profile
  (define (compiler-lower-profile-string-concat-reset) : unit
    (begin
      (set! compiler-lower-profile-string-concat-trees 0)
      (set! compiler-lower-profile-string-concat-leaves 0)
      (set! compiler-lower-profile-string-concat-runtime-calls 0))))

(cfg
  compile-profile
  (define (compiler-lower-profile-string-concat-finish) : unit
    (begin
      (compiler-lower-profile-counter
        "string_concat.trees"
        compiler-lower-profile-string-concat-trees)
      (compiler-lower-profile-counter
        "string_concat.leaves"
        compiler-lower-profile-string-concat-leaves)
      (compiler-lower-profile-counter
        "string_concat.runtime_calls"
        compiler-lower-profile-string-concat-runtime-calls))))

(cfg
  compile-profile
  (define (compiler-lower-profile-name-reset) : unit
    (begin
      (set! compiler-lower-profile-name-env-binds 0)
      (set! compiler-lower-profile-name-env-lookups 0)
      (set! compiler-lower-profile-name-env-lookup-steps 0)
      (set! compiler-lower-profile-name-env-stores 0)
      (set! compiler-lower-profile-name-env-store-grows 0)
      (set! compiler-lower-profile-name-env-materializations 0)
      (set! compiler-lower-profile-name-env-materialized-entries 0)
      (set! compiler-lower-profile-name-cache-builds 0)
      (set! compiler-lower-profile-name-cache-entries 0)
      (set! compiler-lower-profile-name-cache-lookups 0)
      (set! compiler-lower-profile-name-cache-local-hits 0)
      (set! compiler-lower-profile-name-cache-local-misses 0))))

(cfg
  compile-profile
  (define (compiler-lower-profile-name-finish) : unit
    (begin
      (compiler-lower-profile-counter
        "name_env.binds"
        compiler-lower-profile-name-env-binds)
      (compiler-lower-profile-counter
        "name_env.lookups"
        compiler-lower-profile-name-env-lookups)
      (compiler-lower-profile-counter
        "name_env.lookup_steps"
        compiler-lower-profile-name-env-lookup-steps)
      (compiler-lower-profile-counter
        "name_env.stores"
        compiler-lower-profile-name-env-stores)
      (compiler-lower-profile-counter
        "name_env.store_grows"
        compiler-lower-profile-name-env-store-grows)
      (compiler-lower-profile-counter
        "name_env.materializations"
        compiler-lower-profile-name-env-materializations)
      (compiler-lower-profile-counter
        "name_env.materialized_entries"
        compiler-lower-profile-name-env-materialized-entries)
      (compiler-lower-profile-counter
        "name_cache.builds"
        compiler-lower-profile-name-cache-builds)
      (compiler-lower-profile-counter
        "name_cache.entries"
        compiler-lower-profile-name-cache-entries)
      (compiler-lower-profile-counter
        "name_cache.lookups"
        compiler-lower-profile-name-cache-lookups)
      (compiler-lower-profile-counter
        "name_cache.local_hits"
        compiler-lower-profile-name-cache-local-hits)
      (compiler-lower-profile-counter
        "name_cache.local_misses"
        compiler-lower-profile-name-cache-local-misses))))

(cfg
  compile-profile
  (define (compiler-lower-profile-name-cache-lookup [hit : bool]) : unit
    (begin
      (set!
        compiler-lower-profile-name-cache-lookups
        (+ compiler-lower-profile-name-cache-lookups 1))
      (if hit
        (set!
          compiler-lower-profile-name-cache-local-hits
          (+ compiler-lower-profile-name-cache-local-hits 1))
        (set!
          compiler-lower-profile-name-cache-local-misses
          (+ compiler-lower-profile-name-cache-local-misses 1))))))

(cfg
  compile-profile
  (define (compiler-lower-profile-pools
    [point : String]
    [pools : ast.AstNodePoolContext]) : unit
    (begin
      (compiler-lower-profile-counter
        (string.append "ast_expr_pool." (string.append point ".len"))
        (ast.ast-node-pool-context-expr-len pools))
      (compiler-lower-profile-counter
        (string.append "ast_expr_pool." (string.append point ".capacity"))
        (ast.ast-node-pool-context-expr-capacity pools))
      (compiler-lower-profile-counter
        (string.append "ast_expr_pool." (string.append point ".segments"))
        (ast.ast-node-pool-context-expr-segment-count pools))
      (compiler-lower-profile-counter
        (string.append "ast_expr_pool." (string.append point ".segment_bytes"))
        (ast.ast-node-pool-context-expr-segment-bytes pools))
      (compiler-lower-profile-counter
        (string.append "ast_type_pool." (string.append point ".len"))
        (ast.ast-node-pool-context-type-len pools))
      (compiler-lower-profile-counter
        (string.append "ast_type_pool." (string.append point ".capacity"))
        (ast.ast-node-pool-context-type-capacity pools))
      (compiler-lower-profile-counter
        (string.append "ast_type_pool." (string.append point ".segments"))
        (ast.ast-node-pool-context-type-segment-count pools))
      (compiler-lower-profile-counter
        (string.append "ast_type_pool." (string.append point ".segment_bytes"))
        (ast.ast-node-pool-context-type-segment-bytes pools)))))

(cfg
  compile-profile
  (define (compiler-lower-profile-decl-list-count [decls : ast.AstDeclList]) : i64
    (ast.ast-decl-list-len (& decls))))

(cfg
  compile-profile
  (define (compiler-lower-profile-program-counts
    [point : String]
    [program : ast.AstProgram]) : unit
    (match program
      [(ast.AstProgram.Program decls-box)
        (let
          [decls : ast.AstDeclList (box-get decls-box)]
          (begin
            (compiler-lower-profile-counter
              (string.append "checked_program." (string.append point ".decls"))
              (compiler-lower-profile-decl-list-count decls))
            (compiler-lower-profile-counter
              (string.append
                "checked_program."
                (string.append point ".functions"))
              (lower-function-decl-count decls))))])))

(cfg
  compile-profile
  (define (compiler-lower-profile-ir-shape
    [point : String]
    [program : ir.CompilerIrProgram]) : unit
    (match program
      [(ir.CompilerIrProgram.Program _ functions _)
        (begin
          (compiler-lower-profile-counter
            (string.append "ir." (string.append point ".functions"))
            (ir.compiler-ir-function-list-count functions))
          (compiler-lower-profile-counter
            (string.append "ir." (string.append point ".blocks"))
            (ir.compiler-ir-function-list-block-count functions))
          (compiler-lower-profile-counter
            (string.append "ir." (string.append point ".instructions"))
            (ir.compiler-ir-function-list-instruction-count functions)))])))

(cfg
  compile-profile
  (define (compiler-lower-profile-ir-arena [point : String]) : unit
    (compiler-lower-profile-counter
      (string.append "ir_arena." (string.append point ".active"))
      (if (= lower-ir-arena 0)
        0
        1))))

(define (lower-expr-id-span [expr-id : i64]) : ir.CompilerMaybeSourceSpan
  (lower-ast-expr-span (ast.ast-node-get expr-id)))

(define (lower-expr-id-first-span2 [first : i64] [second : i64]) : ir.CompilerMaybeSourceSpan
  (match (lower-expr-id-span first)
    [(ir.CompilerMaybeSourceSpan.Some span)
      (ir.CompilerMaybeSourceSpan.Some span)]
    [(ir.CompilerMaybeSourceSpan.No) (lower-expr-id-span second)]))

(define (lower-expr-id-first-span3 [first : i64] [second : i64] [third : i64]) : ir.CompilerMaybeSourceSpan
  (match (lower-expr-id-span first)
    [(ir.CompilerMaybeSourceSpan.Some span)
      (ir.CompilerMaybeSourceSpan.Some span)]
    [(ir.CompilerMaybeSourceSpan.No) (lower-expr-id-first-span2 second third)]))

(define (lower-expr-list-first-span-at
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : ir.CompilerMaybeSourceSpan
  (if (>= index (ast.ast-expr-list-len exprs))
    (ir.CompilerMaybeSourceSpan.No)
    (match (lower-expr-id-span (ast.ast-expr-list-get exprs index 0))
      [(ir.CompilerMaybeSourceSpan.Some span)
        (ir.CompilerMaybeSourceSpan.Some span)]
      [(ir.CompilerMaybeSourceSpan.No)
        (lower-expr-list-first-span-at exprs (+ index 1))])))

(define (lower-expr-list-first-span [exprs : ast.AstExprList]) : ir.CompilerMaybeSourceSpan
  (lower-expr-list-first-span-at (& exprs) 0))

(define (lower-expr-id-or-list-first-span
  [first : i64]
  [exprs : ast.AstExprList]) : ir.CompilerMaybeSourceSpan
  (match (lower-expr-id-span first)
    [(ir.CompilerMaybeSourceSpan.Some span)
      (ir.CompilerMaybeSourceSpan.Some span)]
    [(ir.CompilerMaybeSourceSpan.No) (lower-expr-list-first-span exprs)]))

(define (lower-let-binding-list-first-span-at
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : ir.CompilerMaybeSourceSpan
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (ir.CompilerMaybeSourceSpan.No)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ value)
        (match (lower-expr-id-span value)
          [(ir.CompilerMaybeSourceSpan.Some span)
            (ir.CompilerMaybeSourceSpan.Some span)]
          [(ir.CompilerMaybeSourceSpan.No)
            (lower-let-binding-list-first-span-at bindings (+ index 1))])])))

(define (lower-let-binding-list-first-span [bindings : ast.AstLetBindingList]) : ir.CompilerMaybeSourceSpan
  (lower-let-binding-list-first-span-at (& bindings) 0))

(define (lower-match-arm-list-first-span-at
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : ir.CompilerMaybeSourceSpan
  (if (>= index (ast.ast-match-arm-list-len arms))
    (ir.CompilerMaybeSourceSpan.No)
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm _ body)
        (match (lower-expr-id-span body)
          [(ir.CompilerMaybeSourceSpan.Some span)
            (ir.CompilerMaybeSourceSpan.Some span)]
          [(ir.CompilerMaybeSourceSpan.No)
            (lower-match-arm-list-first-span-at arms (+ index 1))])])))

(define (lower-match-arm-list-first-span [arms : ast.AstMatchArmList]) : ir.CompilerMaybeSourceSpan
  (lower-match-arm-list-first-span-at (& arms) 0))

(define (lower-resource-binding-list-first-span-at
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : ir.CompilerMaybeSourceSpan
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    (ir.CompilerMaybeSourceSpan.No)
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding _ init cleanup _)
        (match (lower-expr-id-first-span2 init cleanup)
          [(ir.CompilerMaybeSourceSpan.Some span)
            (ir.CompilerMaybeSourceSpan.Some span)]
          [(ir.CompilerMaybeSourceSpan.No)
            (lower-resource-binding-list-first-span-at bindings (+ index 1))])])))

(define (lower-resource-binding-list-first-span
  [bindings : ast.AstResourceBindingList]) : ir.CompilerMaybeSourceSpan
  (lower-resource-binding-list-first-span-at (& bindings) 0))

(define (lower-ast-expr-direct-span [expr : ast.AstExpr]) : ir.CompilerMaybeSourceSpan
  (match expr
    [(ast.AstExpr.Spanned _ span) (ir.CompilerMaybeSourceSpan.Some span)]
    [_ (ir.CompilerMaybeSourceSpan.No)]))

;; Best-available diagnostic source span for an expression. Prefer the parser's
;; outer `AstExpr.Spanned` wrapper, then fall back to the first source-carrying
;; child of common transformed/generated expression nodes.
(define (lower-ast-expr-span [expr : ast.AstExpr]) : ir.CompilerMaybeSourceSpan
  (match expr
    [(ast.AstExpr.Spanned _ span) (ir.CompilerMaybeSourceSpan.Some span)]
    [(ast.AstExpr.Binary _ left right) (lower-expr-id-first-span2 left right)]
    [(ast.AstExpr.Unary _ inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.Call callee args)
      (lower-expr-id-or-list-first-span callee args)]
    [(ast.AstExpr.If cond then-expr else-expr)
      (lower-expr-id-first-span3 cond then-expr else-expr)]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body)
          (match (lower-let-binding-list-first-span bindings)
            [(ir.CompilerMaybeSourceSpan.Some span)
              (ir.CompilerMaybeSourceSpan.Some span)]
            [(ir.CompilerMaybeSourceSpan.No) (lower-expr-id-span body)])])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(ast.AstLambda.Lambda _ _ body) (lower-expr-id-span body)])]
    [(ast.AstExpr.Tuple values) (lower-expr-list-first-span values)]
    [(ast.AstExpr.TupleRef target _) (lower-expr-id-span target)]
    [(ast.AstExpr.Array values) (lower-expr-list-first-span values)]
    [(ast.AstExpr.DynArray values) (lower-expr-list-first-span values)]
    [(ast.AstExpr.MakeArray _ size) (lower-expr-id-span size)]
    [(ast.AstExpr.ArrayRef target index)
      (lower-expr-id-first-span2 target index)]
    [(ast.AstExpr.ArraySet target index value)
      (lower-expr-id-first-span3 target index value)]
    [(ast.AstExpr.ArrayTake target live index)
      (lower-expr-id-first-span3 target live index)]
    [(ast.AstExpr.FixedArrayTake target index)
      (lower-expr-id-first-span2 target index)]
    [(ast.AstExpr.ArrayPush target value)
      (lower-expr-id-first-span2 target value)]
    [(ast.AstExpr.StringRef target index)
      (lower-expr-id-first-span2 target index)]
    [(ast.AstExpr.While cond body) (lower-expr-id-first-span2 cond body)]
    [(ast.AstExpr.Begin exprs) (lower-expr-list-first-span exprs)]
    [(ast.AstExpr.Unsafe exprs) (lower-expr-list-first-span exprs)]
    [(ast.AstExpr.Set _ value) (lower-expr-id-span value)]
    [(ast.AstExpr.Ann inner _) (lower-expr-id-span inner)]
    [(ast.AstExpr.Cast inner _) (lower-expr-id-span inner)]
    [(ast.AstExpr.Borrow _ _ inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee arms)
          (match (lower-expr-id-span scrutinee)
            [(ir.CompilerMaybeSourceSpan.Some span)
              (ir.CompilerMaybeSourceSpan.Some span)]
            [(ir.CompilerMaybeSourceSpan.No)
              (lower-match-arm-list-first-span arms)])])]
    [(ast.AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(ast.AstForeach.Foreach _ _ start end body)
          (lower-expr-id-first-span3 start end body)])]
    [(ast.AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(ast.AstSpmdReduce.Reduce _ _ _ start end init value)
          (match (lower-expr-id-first-span3 start end init)
            [(ir.CompilerMaybeSourceSpan.Some span)
              (ir.CompilerMaybeSourceSpan.Some span)]
            [(ir.CompilerMaybeSourceSpan.No) (lower-expr-id-span value)])])]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(ast.AstSpmdScan.Scan _ _ _ start end _ _ init value body)
          (match (lower-expr-id-first-span3 start end init)
            [(ir.CompilerMaybeSourceSpan.Some span)
              (ir.CompilerMaybeSourceSpan.Some span)]
            [(ir.CompilerMaybeSourceSpan.No)
              (lower-expr-id-first-span2 value body)])])]
    [(ast.AstExpr.SpmdBroadcast value lane)
      (lower-expr-id-first-span2 value lane)]
    [(ast.AstExpr.SpmdShuffle value lane)
      (lower-expr-id-first-span2 value lane)]
    [(ast.AstExpr.StructGet target _) (lower-expr-id-span target)]
    [(ast.AstExpr.StructSet target _ value)
      (lower-expr-id-first-span2 target value)]
    [(ast.AstExpr.WithRegion _ body) (lower-expr-list-first-span body)]
    [(ast.AstExpr.WithEscape escape body)
      (lower-expr-id-or-list-first-span escape body)]
    [(ast.AstExpr.WithScratch body) (lower-expr-list-first-span body)]
    [(ast.AstExpr.InArena arena body)
      (lower-expr-id-or-list-first-span arena body)]
    [(ast.AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (match (lower-resource-binding-list-first-span bindings)
            [(ir.CompilerMaybeSourceSpan.Some span)
              (ir.CompilerMaybeSourceSpan.Some span)]
            [(ir.CompilerMaybeSourceSpan.No) (lower-expr-list-first-span body)])])]
    [(ast.AstExpr.Box value) (lower-expr-id-span value)]
    [(ast.AstExpr.BoxGet value) (lower-expr-id-span value)]
    [(ast.AstExpr.BoxTake value) (lower-expr-id-span value)]
    [(ast.AstExpr.BoxSet target value) (lower-expr-id-first-span2 target value)]
    [(ast.AstExpr.Comptime inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.Quote inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.Quasiquote inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.Unquote inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.UnquoteSplicing inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.Try inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.Return inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.PtrNullCheck inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.PtrAddrOf inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.PtrRead inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.PtrWrite target value)
      (lower-expr-id-first-span2 target value)]
    [(ast.AstExpr.PtrOffset target offset)
      (lower-expr-id-first-span2 target offset)]
    [(ast.AstExpr.PtrCast inner _) (lower-expr-id-span inner)]
    [(ast.AstExpr.PtrToInt inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.IntToPtr inner _) (lower-expr-id-span inner)]
    [(ast.AstExpr.StringData inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.StringFromBytes data len)
      (lower-expr-id-first-span2 data len)]
    [(ast.AstExpr.ArrayData inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.CpuIdEax leaf subleaf)
      (lower-expr-id-first-span2 leaf subleaf)]
    [(ast.AstExpr.CpuIdEbx leaf subleaf)
      (lower-expr-id-first-span2 leaf subleaf)]
    [(ast.AstExpr.CpuIdEcx leaf subleaf)
      (lower-expr-id-first-span2 leaf subleaf)]
    [(ast.AstExpr.CpuIdEdx leaf subleaf)
      (lower-expr-id-first-span2 leaf subleaf)]
    [(ast.AstExpr.Xgetbv inner) (lower-expr-id-span inner)]
    [(ast.AstExpr.Syscall args) (lower-expr-list-first-span args)]
    [(ast.AstExpr.BracketClause items) (lower-expr-list-first-span items)]
    [_ (ir.CompilerMaybeSourceSpan.No)]))

(define (lower-diagnostic-at-expr [expr : ast.AstExpr] [message : String]) : cdiag.CompilerDiagnostic
  (match (lower-ast-expr-span expr)
    [(ir.CompilerMaybeSourceSpan.Some span)
      (cdiag.compiler-diagnostic-from-ast-span "" span message)]
    [(ir.CompilerMaybeSourceSpan.No) (lower-diagnostic message)]))

(define (lower-diagnostic-with-path
  [diag : cdiag.CompilerDiagnostic]
  [path : String]) : cdiag.CompilerDiagnostic
  (cdiag.compiler-diagnostic-with-path diag path))

(define (lower-resetting-entry-in-live-session?) : bool
  (load.compiler-load-active-session-live?))

(define (lower-resetting-entry-live-session-error
  [entry : String]
  [path : String]) : ResultCompilerLower
  (ResultCompilerLower.Err
    (box
      (lower-diagnostic-with-path
        (lower-diagnostic
          (str_cat.str-cat
            entry
            ": standalone resetting compiler entry cannot run inside an active compiler load session"))
        path))))

(define (lower-reference-support-message) : String
  "lower: reference-typed programs require borrow/reference lowering support")

(define (lower-bytes-view-from-parts-name? [name : String]) : bool
  (let
    [base : String
      (if (tc_core.tc-name-qualified? name)
        (tc_core.tc-qualified-name-base name)
        name)]
    (or
      (string.eq base "tl_bytes_view_from_str_parts")
      (string.eq base "tl_bytes_view_from_buf_parts")
      (string.eq base "tl_bytes_mut_view_from_buf_parts")
      (string.eq base "tl_bytes_view_from_bytes_parts")
      (string.eq base "tl_bytes_mut_view_from_bytes_parts"))))

(define (lower-atomic-buffer-extern-name? [name : String]) : bool
  (let
    [base : String
      (if (tc_core.tc-name-qualified? name)
        (tc_core.tc-qualified-name-base name)
        name)]
    (or
      (string.eq base "atomic-i64-load")
      (string.eq base "atomic-i64-store!")
      (string.eq base "atomic-i64-add!")
      (string.eq base "atomic-i64-fetch-add!")
      (string.eq base "atomic-i32-load")
      (string.eq base "atomic-i32-store!")
      (string.eq base "atomic-i32-add!")
      (string.eq base "atomic-i32-fetch-add!"))))

(define (lower-supported-reference-extern?
  [ctx : tc_core.TcContext]
  [name : i64]
  [ty : ast.AstType]) : bool
  (let
    [_ : tc_core.TcContext ctx]
    [_ty : ast.AstType ty]
    (or
      (cbi.compiler-builtin-backend-tl-str-view-id? name)
      (string.eq (tc_core.tc-env-key-name-text name) "tl_str_view")
      (lower-bytes-view-from-parts-name? (tc_core.tc-env-key-name-text name))
      (lower-atomic-buffer-extern-name? (tc_core.tc-env-key-name-text name)))))

(define (lower-name-env-lookup-symbol-id
  [names : LowerNameEnv]
  [source-id : i64]
  [fallback : i64]) : i64
  (begin
    (cfg
      compile-profile
      (set!
        compiler-lower-profile-name-env-lookups
        (+ compiler-lower-profile-name-env-lookups 1)))
    (if (< source-id 0)
      fallback
      (match names
        [(LowerNameEnv.Nil) fallback]
        [(LowerNameEnv.Inline bind-id _ symbol-id)
          (begin
            (cfg
              compile-profile
              (set!
                compiler-lower-profile-name-env-lookup-steps
                (+ compiler-lower-profile-name-env-lookup-steps 1)))
            (if (= bind-id source-id)
              symbol-id
              fallback))]
        [(LowerNameEnv.Dense store head _)
          (let
            [cursor : i64 head]
            (begin
              (while (>= cursor 0)
                (let
                  [binding : LowerNameBinding
                    (lower-name-store-binding-at (& (box-get store)) cursor)]
                  (begin
                    (cfg
                      compile-profile
                      (set!
                        compiler-lower-profile-name-env-lookup-steps
                        (+ compiler-lower-profile-name-env-lookup-steps 1)))
                    (if (= (struct-get binding source-id) source-id)
                      (return (struct-get binding symbol-id))
                      (set! cursor (struct-get binding parent))))))
              fallback))]))))

(define (lower-name-env-lookup-with-id [names : LowerNameEnv] [source-id : i64]) : tc_core.TcMaybeString
  (let
    [symbol-id : i64 (lower-name-env-lookup-symbol-id names source-id -1)]
    (if (>= symbol-id 0)
      (tc_core.TcMaybeString.Some (ir.compiler-ir-symbol-text symbol-id))
      (tc_core.TcMaybeString.No))))

(define (lower-name-env-count [names : LowerNameEnv]) : i64
  (match names
    [(LowerNameEnv.Nil) 0]
    [(LowerNameEnv.Inline _ _ _) 1]
    [(LowerNameEnv.Dense _ _ count) count]))

(define (lower-name-env-copy-chain-into!
  [names : LowerNameEnv]
  [target : (&mut target LowerNameStore)]
  [start : i64]) : unit
  (match names
    [(LowerNameEnv.Nil) unit]
    [(LowerNameEnv.Inline source-id logical-id symbol-id)
      (lower-name-store-write-index!
        target
        start
        (LowerNameBinding source-id logical-id symbol-id (- start 1)))]
    [(LowerNameEnv.Dense store head count)
      (let
        [cursor : i64 head]
        [write : i64 (+ start (- count 1))]
        (while (>= cursor 0)
          (let
            [binding : LowerNameBinding
              (lower-name-store-binding-at (& (box-get store)) cursor)]
            (begin
              (lower-name-store-write-index!
                target
                write
                (LowerNameBinding
                  (struct-get binding source-id)
                  (struct-get binding logical-id)
                  (struct-get binding symbol-id)
                  (- write 1)))
              (set! cursor (struct-get binding parent))
              (set! write (- write 1))))))]))

(define (lower-name-env-materialize-two
  [left : LowerNameEnv]
  [right : LowerNameEnv]) : LowerNameEnv
  (let
    [left-count : i64 (lower-name-env-count left)]
    [right-count : i64 (lower-name-env-count right)]
    [count : i64 (+ left-count right-count)]
    (if (< count 1)
      LowerNameEnv.Nil
      (let
        [_profile : unit
          (cfg
            compile-profile
            (begin
              (set!
                compiler-lower-profile-name-env-materializations
                (+ compiler-lower-profile-name-env-materializations 1))
              (set!
                compiler-lower-profile-name-env-materialized-entries
                (+ compiler-lower-profile-name-env-materialized-entries count))))]
        [last-index : i64
          (if (< count 1)
            0
            (- count 1))]
        [store : (Box LowerNameStore) (box (lower-name-store-new))]
        [_ensure : unit
          (lower-name-store-ensure-index! (&mut (box-get store)) last-index)]
        [_copy-right : unit
          (lower-name-env-copy-chain-into! right (&mut (box-get store)) 0)]
        [_copy-left : unit
          (lower-name-env-copy-chain-into!
            left
            (&mut (box-get store))
            right-count)]
        (begin
          (set! (struct-get (box-get store) len) count)
          (LowerNameEnv.Dense store (- count 1) count))))))

(define (lower-name-env-rebuild-over
  [left : LowerNameEnv]
  [right : LowerNameEnv]) : LowerNameEnv
  (let
    [count : i64 (lower-name-env-count left)]
    [cur : LowerNameEnv left]
    [bindings : (__tl_dyn-array LowerNameFlatBinding)
      (make-array LowerNameFlatBinding count)]
    [index : i64 0]
    [out : LowerNameEnv right]
    (begin
      (while (match cur
        [(LowerNameEnv.Nil) false]
        [_ true])
        (match (lower-name-env-view cur)
          [(LowerNameEnvView.Nil) unit]
          [(LowerNameEnvView.Bind source-id logical-id symbol-id rest)
            (begin
              (array-set!
                bindings
                index
                (LowerNameFlatBinding source-id logical-id symbol-id))
              (set! index (+ index 1))
              (set! cur rest))]))
      (set! index (- count 1))
      (while (>= index 0)
        (let
          [binding : LowerNameFlatBinding (array-ref bindings index)]
          (begin
            (set!
              out
              (lower-name-env-bind-ids-raw
                (struct-get binding source-id)
                (struct-get binding logical-id)
                (struct-get binding symbol-id)
                out))
            (set! index (- index 1)))))
      out)))

(define (lower-name-env-append [left : LowerNameEnv] [right : LowerNameEnv]) : LowerNameEnv
  (match left
    [(LowerNameEnv.Nil) right]
    [_
      (match right
        [(LowerNameEnv.Nil)
          (lower-name-env-materialize-two left LowerNameEnv.Nil)]
        [_ (lower-name-env-rebuild-over left right)])]))

(define (lower-name-cache-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (lower-logical-display-name-select
  [display : String]
  [logical-id : i64]
  [direct : bool]) : String
  (if direct
    (ci.intern-str logical-id)
    display))

;; A derived symbol is minted into the IR's own growable symbol table, not into
;; the fixed intern pool. These logical spellings are by far the largest
;; generated-name population -- about 50,000 of the ~51,500 generated names a
;; whole-program self-compile allocates -- and the pool's 131,072 slots cannot
;; hold them alongside the source lane (refs #6293). The table keys on the full
;; display string exactly as `intern-generated-canonical-name` did, so a
;; definition and every call to it still resolve to one id and one spelling.
(define (lower-derived-symbol-id [logical-name : String]) : i64
  (ir.compiler-ir-symbol logical-name))

(define (lower-logical-symbol-id-select
  [logical-name : String]
  [logical-id : i64]
  [direct : bool]) : i64
  (if direct
    logical-id
    (lower-derived-symbol-id logical-name)))

(define (lower-logical-symbol-id-direct? [logical-id : i64] [source-id : i64]) : bool
  (and (= logical-id source-id) (tc_core.tc-env-key-has-name-id? logical-id)))

(define (lower-name-cache-logical-module-id [logical-id : i64]) : i64
  (cond
    [(csym.compiler-composite-triple-key-id? logical-id)
      (csym.compiler-composite-triple-left-id logical-id)]
    [(csym.compiler-composite-pair-key-id? logical-id)
      (csym.compiler-composite-pair-left-id logical-id)]
    [else -1]))

(define (lower-module-path-index-add-logical-id!
  [index : (&mut index LowerModulePathIndex)]
  [logical-id : i64]) : unit
  (let
    [module-id : i64 (lower-name-cache-logical-module-id logical-id)]
    (if (or
      (< module-id 0)
      (>= module-id (ci.intern-capacity))
      (csym.compiler-symbol-root-module-id? module-id))
      unit
      (let
        [edges : lower_i64_i64_map.Map (struct-get index edges)]
        [terminals : lower_i64_i64_map.Map (struct-get index terminals)]
        [modules : lower_i64_i64_map.Map (struct-get index modules)]
        [next-node : i64 (struct-get index next-node)]
        (match (lower_i64_i64_map.get (& modules) module-id)
          [(lower_i64_i64_map.LookupFound _) unit]
          [(lower_i64_i64_map.LookupMissing)
            (let
              [current : i64 module-id]
              [node : i64 0]
              (begin
                (lower_i64_i64_map.insert-ref! (&mut modules) module-id 1)
                (while (>= current 0)
                  (let
                    [segment : i64
                      (if (ci.intern-dotted? current)
                        (ci.intern-leading-dot-id current)
                        current)]
                    [edge-key : i64
                      (csym.compiler-composite-pair-key-id node segment)]
                    [child : i64
                      (lower_i64_i64_map.get-value-or (& edges) edge-key -1)]
                    (begin
                      (if (< child 0)
                        (begin
                          (set! child next-node)
                          (set! next-node (+ next-node 1))
                          (lower_i64_i64_map.insert-ref!
                            (&mut edges)
                            edge-key
                            child))
                        unit)
                      (set! node child)
                      (set!
                        current
                        (if (ci.intern-dotted? current)
                          (ci.intern-dotted-tail-id current)
                          -1)))))
                (lower_i64_i64_map.insert-ref! (&mut terminals) node module-id)
                (set! (struct-get index edges) edges)
                (set! (struct-get index terminals) terminals)
                (set! (struct-get index modules) modules)
                (set! (struct-get index next-node) next-node)
                unit))])))))

(defenum LowerNameCacheMaybeId
  (No)
  (Some i64))

(define (lower-name-env-bind-logical-id
  [source-id : i64]
  [logical-name : String]
  [logical-id : i64]
  [rest : LowerNameEnv]) : LowerNameEnv
  (lower-name-env-bind-ids
    source-id
    logical-id
    (lower-derived-symbol-id logical-name)
    rest))

(define (lower-name-env-bind-logical-symbol-id
  [source-id : i64]
  [logical-id : i64]
  [symbol-id : i64]
  [rest : LowerNameEnv]) : LowerNameEnv
  (lower-name-env-bind-ids source-id logical-id symbol-id rest))

(define (lower-name-env-bind-cached-logical-id
  [source-id : i64]
  [logical-name : String]
  [logical-id : i64]
  [cache : LowerNameCache]
  [rest : LowerNameEnv]) : LowerNameEnv
  (lower-name-env-bind-logical-symbol-id
    source-id
    logical-id
    (lower-name-cache-lookup-symbol-id
      (& cache)
      logical-id
      (lower-derived-symbol-id logical-name))
    rest))

(define (lower-extern-logical-symbol-id
  [logical-id : i64]
  [logical-name : String]
  [source-id : i64]
  [metadata : ast.AstExternMetadata]) : i64
  (let
    [direct : bool (lower-logical-symbol-id-direct? logical-id source-id)]
    [link-id : i64 (ast.ast-extern-metadata-symbol-id metadata)]
    (if (and (ast.ast-extern-metadata-symbol-matches-source? metadata) direct)
      link-id
      (lower-logical-symbol-id-select logical-name logical-id direct))))

(define (lower-name-cache-add-id!
  [cache : (&mut cache LowerNameCache)]
  [source-id : i64]
  [logical-id : i64]
  [fallback-symbol-id : i64]) : unit
  (let
    [ids : lower_i64_i64_map.Map (struct-get cache ids)]
    [logical-ids : (__tl_dyn-array i64) (struct-get cache logical-ids)]
    [symbol-ids : (__tl_dyn-array i64) (struct-get cache symbol-ids)]
    [logical-symbols : lower_i64_i64_map.Map (struct-get cache logical-symbols)]
    [module-paths : LowerModulePathIndex (struct-get cache module-paths)]
    (if (< source-id 0)
      unit
      (match (lower_i64_i64_map.get (& ids) source-id)
        [(lower_i64_i64_map.LookupFound _) unit]
        [(lower_i64_i64_map.LookupMissing)
          (let
            [next : i64 (lower_i64_i64_map.len (& ids))]
            [logical-slot : i64
              (lower_i64_i64_map.get-value-or (& ids) logical-id -1)]
            [symbol-id : i64
              (if (>= logical-slot 0)
                (array-ref symbol-ids logical-slot)
                (let
                  [local-symbol-id : i64
                    (lower_i64_i64_map.get-value-or
                      (& logical-symbols)
                      logical-id
                      -1)]
                  (if (>= local-symbol-id 0)
                    local-symbol-id
                    (match (struct-get cache parent)
                      [(LowerNameParent.None) -1]
                      [(LowerNameParent.Global)
                        (lower-name-cache-lookup-symbol-id
                          (& lower-active-global-name-cache)
                          logical-id
                          -1)]))))]
            (begin
              (cfg
                compile-profile
                (set!
                  compiler-lower-profile-name-cache-entries
                  (+ compiler-lower-profile-name-cache-entries 1)))
              (when (< symbol-id 0) (set! symbol-id fallback-symbol-id))
              (array-set! logical-ids next logical-id)
              (array-set! symbol-ids next symbol-id)
              (lower_i64_i64_map.insert-ref! (&mut ids) source-id next)
              (when
                (and (< logical-slot 0) (not (= source-id logical-id)))
                (lower_i64_i64_map.insert-ref!
                  (&mut logical-symbols)
                  logical-id
                  symbol-id))
              (lower-module-path-index-add-logical-id!
                (&mut module-paths)
                logical-id)
              (set! (struct-get cache ids) ids)
              (set! (struct-get cache logical-ids) logical-ids)
              (set! (struct-get cache symbol-ids) symbol-ids)
              (set! (struct-get cache logical-symbols) logical-symbols)
              (set! (struct-get cache module-paths) module-paths)
              unit))]))))

(define (lower-name-cache-from-env-into
  [names : LowerNameEnv]
  [cache : LowerNameCache (:consume)]) : LowerNameCache
  (let
    [cur : LowerNameEnv names]
    [out : LowerNameCache cache]
    (begin
      (while (match cur
        [(LowerNameEnv.Nil) false]
        [_ true])
        (match (lower-name-env-view cur)
          [(LowerNameEnvView.Nil) unit]
          [(LowerNameEnvView.Bind source-id logical-id symbol-id rest)
            (begin
              (lower-name-cache-add-id!
                (&mut out)
                source-id
                logical-id
                symbol-id)
              (set! cur rest))]))
      out)))

(define (lower-name-cache-from-env [names : LowerNameEnv]) : LowerNameCache
  (begin
    (cfg
      compile-profile
      (set!
        compiler-lower-profile-name-cache-builds
        (+ compiler-lower-profile-name-cache-builds 1)))
    (let
      [count : i64 (lower-name-env-count names)]
      (lower-name-cache-from-env-into
        names
        (LowerNameCache
          (lower_i64_i64_map.with-capacity (lower-name-cache-capacity count))
          (make-array i64 count)
          (make-array i64 count)
          (lower_i64_i64_map.with-capacity 64)
          (lower-module-path-index-empty)
          (clone_support.CloneRootEntries.Empty)
          cbi.compiler-builtin-id-fix-empty
          (LowerNameParent.None))))))

;; Build a small overlay name cache from `names` (the module-local names
;; only). On a miss it falls through to the shared global cache
;; `lower-active-global-name-cache` (see lower-name-cache-resolve-logical-id).
(define (lower-name-cache-overlay [names : LowerNameEnv] [module-id : i64]) : LowerNameCache
  (begin
    (cfg
      compile-profile
      (set!
        compiler-lower-profile-name-cache-builds
        (+ compiler-lower-profile-name-cache-builds 1)))
    (let
      [count : i64 (lower-name-env-count names)]
      (lower-name-cache-from-env-into
        names
        (LowerNameCache
          (lower_i64_i64_map.with-capacity (lower-name-cache-capacity count))
          (make-array i64 count)
          (make-array i64 count)
          (lower_i64_i64_map.with-capacity 16)
          (lower-module-path-index-empty)
          (clone_support.CloneRootEntries.Empty)
          module-id
          (LowerNameParent.Global))))))

(define (lower-module-name-cache-list-lookup
  [entries : LowerModuleNameCacheList]
  [module-id : i64]) : LowerMaybeModuleNameCache
  (match entries
    [(LowerModuleNameCacheList.Nil) (LowerMaybeModuleNameCache.No)]
    [(LowerModuleNameCacheList.Cons entry-module-id cache rest)
      (if (= entry-module-id module-id)
        (LowerMaybeModuleNameCache.Some cache)
        (lower-module-name-cache-list-lookup (box-get rest) module-id))]))

(define (lower-active-module-name-cache-lookup [module-id : i64]) : LowerMaybeModuleNameCache
  (lower-module-name-cache-list-lookup
    (lower-global-shared-view lower-active-module-name-caches)
    module-id))

(define (lower-active-module-name-cache-insert!
  [module-id : i64]
  [cache : LowerNameCache]) : unit
  (set!
    lower-active-module-name-caches
    (LowerModuleNameCacheList.Cons
      module-id
      cache
      (box lower-active-module-name-caches))))

(define (lower-name-cache-with-module-id
  [cache : LowerNameCache]
  [module-id : i64]) : LowerNameCache
  (LowerNameCache
    (struct-get cache ids)
    (struct-get cache logical-ids)
    (struct-get cache symbol-ids)
    (struct-get cache logical-symbols)
    (struct-get cache module-paths)
    (struct-get cache clone-roots)
    module-id
    (struct-get cache parent)))

(define (lower-name-cache-with-clone-roots
  [cache : LowerNameCache]
  [roots : clone_support.CloneRootEntries]) : LowerNameCache
  (LowerNameCache
    (struct-get cache ids)
    (struct-get cache logical-ids)
    (struct-get cache symbol-ids)
    (struct-get cache logical-symbols)
    (struct-get cache module-paths)
    roots
    (struct-get cache module-id)
    (struct-get cache parent)))

(define (lower-name-cache-clone-helper-id
  [cache : LowerNameCache]
  [type-key-id : i64]) : i64
  (let
    [helper-id : i64
      (clone_support.clone-root-entries-helper-id-or
        (struct-get cache clone-roots)
        type-key-id
        -1)]
    (if (>= helper-id 0)
      helper-id
      (match (struct-get cache parent)
        [(LowerNameParent.None) -1]
        [(LowerNameParent.Global)
          (lower-name-cache-clone-helper-id
            (lower-global-shared-view lower-active-global-name-cache)
            type-key-id)]))))

(define (lower-name-cache-clone-key-id
  [cache : LowerNameCache]
  [type-key-id : i64]) : i64
  (if (>= (lower-name-cache-clone-helper-id cache type-key-id) 0)
    type-key-id
    (let
      [candidate : i64
        (clone_support.clone-root-entries-unique-key-for-base-id-or
          (struct-get cache clone-roots)
          (clone_support.clone-name-key-base-id type-key-id)
          -1)]
      (if (>= candidate 0)
        candidate
        (match (struct-get cache parent)
          [(LowerNameParent.None) -1]
          [(LowerNameParent.Global)
            (lower-name-cache-clone-key-id
              (lower-global-shared-view lower-active-global-name-cache)
              type-key-id)])))))

(define (lower-name-cache-lookup-id [cache : LowerNameCache] [source-id : i64]) : tc_core.TcMaybeString
  (let
    [index : i64
      (lower_i64_i64_map.get-value-or (& (struct-get cache ids)) source-id -1)]
    (begin
      (cfg
        compile-profile
        (compiler-lower-profile-name-cache-lookup (>= index 0)))
      (if (>= index 0)
        (tc_core.TcMaybeString.Some
          (ir.compiler-ir-symbol-text
            (array-ref (struct-get cache symbol-ids) index)))
        (match (struct-get cache parent)
          [(LowerNameParent.None) (tc_core.TcMaybeString.No)]
          [(LowerNameParent.Global)
            (lower-name-cache-lookup-id
              (lower-global-shared-view lower-active-global-name-cache)
              source-id)])))))

(define (lower-name-cache-lookup-logical-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [index : i64
      (lower_i64_i64_map.get-value-or (& (struct-get cache ids)) source-id -1)]
    (begin
      (cfg
        compile-profile
        (compiler-lower-profile-name-cache-lookup (>= index 0)))
      (if (>= index 0)
        (array-ref (struct-get cache logical-ids) index)
        (match (struct-get cache parent)
          [(LowerNameParent.None) fallback]
          [(LowerNameParent.Global)
            (lower-name-cache-lookup-logical-id
              (& lower-active-global-name-cache)
              source-id
              fallback)])))))

(define (lower-name-cache-lookup-symbol-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [index : i64
      (lower_i64_i64_map.get-value-or (& (struct-get cache ids)) source-id -1)]
    (begin
      (cfg
        compile-profile
        (compiler-lower-profile-name-cache-lookup (>= index 0)))
      (if (>= index 0)
        (array-ref (struct-get cache symbol-ids) index)
        (let
          [symbol-id : i64
            (lower_i64_i64_map.get-value-or
              (& (struct-get cache logical-symbols))
              source-id
              -1)]
          (if (>= symbol-id 0)
            symbol-id
            (match (struct-get cache parent)
              [(LowerNameParent.None) fallback]
              [(LowerNameParent.Global)
                (lower-name-cache-lookup-symbol-id
                  (& lower-active-global-name-cache)
                  source-id
                  fallback)])))))))

(define (lower-module-path-index-resolve-logical-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [paths : LowerModulePathIndex (struct-get cache module-paths)]
    [edges : lower_i64_i64_map.Map (struct-get paths edges)]
    [terminals : lower_i64_i64_map.Map (struct-get paths terminals)]
    [current : i64 source-id]
    [node : i64 0]
    [result : i64 fallback]
    [done : bool false]
    (begin
      (while (and (not done) (ci.intern-dotted? current))
        (let
          [segment : i64 (ci.intern-leading-dot-id current)]
          [remainder : i64 (ci.intern-dotted-tail-id current)]
          [edge-key : i64 (csym.compiler-composite-pair-key-id node segment)]
          [child : i64 (lower_i64_i64_map.get-value-or (& edges) edge-key -1)]
          (if (< child 0)
            (set! done true)
            (let
              [module-id : i64
                (lower_i64_i64_map.get-value-or (& terminals) child -1)]
              (begin
                (set! node child)
                (when
                  (and (>= module-id 0) (>= remainder 0))
                  (let
                    [raw-logical-id : i64
                      (lower-name-cache-lookup-logical-id
                        cache
                        (csym.compiler-symbol-module-key-id-by-id
                          module-id
                          remainder)
                        -1)]
                    (if (>= raw-logical-id 0)
                      (set! result raw-logical-id)
                      (when
                        (and
                          (ci.intern-dotted? remainder)
                          (not
                            (ci.intern-dotted?
                              (ci.intern-dotted-tail-id remainder))))
                        (let
                          [qualified-base-id : i64
                            (csym.compiler-composite-pair-key-id
                              (ci.intern-leading-dot-id remainder)
                              (ci.intern-dotted-tail-id remainder))]
                          [qualified-logical-id : i64
                            (lower-name-cache-lookup-logical-id
                              cache
                              (csym.compiler-symbol-module-key-id-by-id
                                module-id
                                qualified-base-id)
                              -1)]
                          (when
                            (>= qualified-logical-id 0)
                            (set! result qualified-logical-id)))))))
                (set! current remainder))))))
      (if (and
        (< result 0)
        (match (struct-get cache parent)
          [(LowerNameParent.Global) true]
          [(LowerNameParent.None) false]))
        (lower-module-path-index-resolve-logical-id
          (& lower-active-global-name-cache)
          source-id
          fallback)
        result))))

(define (lower-name-cache-resolve-logical-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [module-id : i64 (struct-get cache module-id)]
    [source-key-id : i64 (tc_core.tc-env-name-key-id source-id)]
    ;; Qualified macro-hygiene symbols carry the macro definition module as
    ;; their qualifier and the parsed source lookup ID as their base. A dotted
    ;; base therefore has all of the structural path information needed to
    ;; resolve the referenced declaration after a direct lookup misses.
    [path-source-id : i64
      (if (and
        (tc_core.tc-env-key-has-name-id? source-id)
        (ci.intern-qualified? source-id)
        (ci.intern-dotted? (ci.intern-qualified-base-id source-id)))
        (ci.intern-qualified-base-id source-id)
        source-id)]
    [module-local : i64
      (if (and
        (not (csym.compiler-symbol-root-module-id? module-id))
        (= source-key-id source-id)
        (tc_core.tc-env-key-has-name-id? source-id)
        (not (ci.intern-dotted? source-id)))
        (let
          [qualified-id : i64
            (csym.compiler-symbol-module-key-id-by-id module-id source-id)]
          [cached-logical-id
            : i64
            ;; Module overlays contain import aliases only. A canonical
            ;; current-module key cannot be present there, so avoid one
            ;; guaranteed local-map miss before consulting the shared cache.
            (match (struct-get cache parent)
              [(LowerNameParent.Global)
                (lower-name-cache-lookup-logical-id
                  (& lower-active-global-name-cache)
                  qualified-id
                  -1)]
              [(LowerNameParent.None)
                (lower-name-cache-lookup-logical-id cache qualified-id -1)])]
          (if (>= cached-logical-id 0)
            cached-logical-id
            ;; Unlocated compiler-source entry points have no owner path from
            ;; which to build canonical name rows. The typechecker registries
            ;; still prove whether this module owns the source declaration.
            (if (and
              lower-active-symbols-ready
              (csym.compiler-symbols-handle-found?
                (csym.compiler-symbols-lookup-value-in-module-id-or
                  (lower-global-shared-view lower-active-symbols)
                  module-id
                  source-id
                  (csym.compiler-symbols-missing-handle))))
              qualified-id
              -1)))
        -1)]
    (if (>= module-local 0)
      module-local
      (let
        [direct : i64
          (lower-name-cache-lookup-logical-id cache source-key-id -1)]
        (if (>= direct 0)
          direct
          (if (and
            (tc_core.tc-env-key-has-name-id? path-source-id)
            (ci.intern-dotted? path-source-id))
            (let
              [alias-logical-id : i64
                (lower-name-cache-lookup-logical-id
                  cache
                  (csym.compiler-symbol-module-key-id-by-id
                    (ci.intern-leading-dot-id path-source-id)
                    (ci.intern-dotted-tail-id path-source-id))
                  -1)]
              (if (>= alias-logical-id 0)
                alias-logical-id
                (let
                  [path-logical-id : i64
                    (lower-module-path-index-resolve-logical-id
                      cache
                      path-source-id
                      -1)]
                  (if (>= path-logical-id 0)
                    path-logical-id
                    fallback))))
            fallback))))))

(define (lower-name-cache-resolve-symbol-id
  [cache : (& cache LowerNameCache)]
  [source-id : i64]
  [fallback : i64]) : i64
  (let
    [logical-id : i64 (lower-name-cache-resolve-logical-id cache source-id -1)]
    (if (< logical-id 0)
      fallback
      (lower-name-cache-lookup-symbol-id cache logical-id fallback))))

(define (lower-name-cache-contains-local-id?
  [cache : LowerNameCache]
  [source-id : i64]) : bool
  (if (< source-id 0)
    false
    (>=
      (lower_i64_i64_map.get-value-or (& (struct-get cache ids)) source-id -1)
      0)))

(define (lower-name-cache-resolve-id-display
  [cache : LowerNameCache]
  [source-id : i64]) : tc_core.TcMaybeString
  (let
    [source-key-id : i64 (tc_core.tc-env-name-key-id source-id)]
    [logical-id : i64
      (lower-name-cache-resolve-logical-id (& cache) source-id -1)]
    (if (< logical-id 0)
      (tc_core.TcMaybeString.No)
      (if (= logical-id source-key-id)
        (lower-name-cache-lookup-id cache source-key-id)
        (match (lower-name-cache-lookup-id cache logical-id)
          [(tc_core.TcMaybeString.Some logical-name)
            (tc_core.TcMaybeString.Some logical-name)]
          [(tc_core.TcMaybeString.No)
            (tc_core.TcMaybeString.Some
              (tc_core.tc-env-key-name-text logical-id))])))))

(define (lower-type-env-count [env : tc_core.TcTypeEnv]) : i64
  (match (tc_core.tc-type-env-spine-step env)
    [(tc_core.TcTypeEnvSpineStep.Done) 0]
    [(tc_core.TcTypeEnvSpineStep.Cache rest-env)
      (lower-type-env-count rest-env)]
    [(tc_core.TcTypeEnvSpineStep.Bind _ _ rest-env)
      (+ 1 (lower-type-env-count rest-env))]))

(define (lower-type-env-contains-reference? [env : tc_core.TcTypeEnv]) : bool
  (match (tc_core.tc-type-env-spine-step env)
    [(tc_core.TcTypeEnvSpineStep.Done) false]
    [(tc_core.TcTypeEnvSpineStep.Cache rest-env)
      (lower-type-env-contains-reference? rest-env)]
    [(tc_core.TcTypeEnvSpineStep.Bind _ ty rest-env)
      (if (tc_core.tc-type-contains-reference? ty)
        true
        (lower-type-env-contains-reference? rest-env))]))

(define (lower-type-cache-capacity [count : i64]) : i64
  (if (< count 4)
    8
    (* count 2)))

(define (lower-type-cache-add
  [cache : LowerTypeCache (:consume)]
  [name-id : i64]
  [ty : ast.AstType]) : LowerTypeCache
  (match cache
    [(LowerTypeCache.No) cache]
    [(LowerTypeCache.Some ids values next parent)
      (match (lower_i64_i64_map.get (& ids) name-id)
        [(lower_i64_i64_map.LookupFound _) cache]
        [(lower_i64_i64_map.LookupMissing)
          (begin
            (array-set! values next ty)
            (lower_i64_i64_map.insert-ref! (&mut ids) name-id next)
            (LowerTypeCache.Some ids values (+ next 1) parent))])]))

(define (lower-type-cache-from-env-into
  [env : tc_core.TcTypeEnv]
  [cache : LowerTypeCache (:consume)]) : LowerTypeCache
  (match (tc_core.tc-type-env-spine-step env)
    [(tc_core.TcTypeEnvSpineStep.Done) cache]
    [(tc_core.TcTypeEnvSpineStep.Cache rest-env)
      (lower-type-cache-from-env-into rest-env cache)]
    [(tc_core.TcTypeEnvSpineStep.Bind name-id ty rest-env)
      (lower-type-cache-from-env-into
        rest-env
        (lower-type-cache-add cache name-id ty))]))

(define (lower-type-cache-from-env [env : tc_core.TcTypeEnv]) : LowerTypeCache
  (let
    [count : i64 (lower-type-env-count env)]
    (lower-type-cache-from-env-into
      env
      (LowerTypeCache.Some
        (lower_i64_i64_map.with-capacity (lower-type-cache-capacity count))
        (make-array ast.AstType count)
        0
        (LowerTypeParent.None)))))

;; Build a small overlay type cache from `env` (the module-local type
;; bindings only). On a miss it falls through to the shared global cache
;; `lower-decls-global-type-cache` (see lower-type-cache-lookup-id).
(define (lower-type-cache-overlay [env : tc_core.TcTypeEnv]) : LowerTypeCache
  (let
    [count : i64 (lower-type-env-count env)]
    (lower-type-cache-from-env-into
      env
      (LowerTypeCache.Some
        (lower_i64_i64_map.with-capacity (lower-type-cache-capacity count))
        (make-array ast.AstType count)
        0
        (LowerTypeParent.Global)))))

(define (lower-type-cache-lookup-id
  [cache : LowerTypeCache]
  [name-id : i64]
  [display-name : String]) : tc_core.ResultTcType
  (match cache
    [(LowerTypeCache.No)
      (tc_core.ResultTcType.Err
        (string.append "typecheck: unbound name " display-name))]
    [(LowerTypeCache.Some ids values _ parent)
      (let
        [index : i64 (lower_i64_i64_map.get-value-or (& ids) name-id -1)]
        (if (>= index 0)
          (tc_core.ResultTcType.Ok (array-ref values index))
          (match parent
            [(LowerTypeParent.None)
              (tc_core.ResultTcType.Err
                (string.append "typecheck: unbound name " display-name))]
            [(LowerTypeParent.Global)
              (lower-type-cache-lookup-id
                (lower-global-shared-view lower-decls-global-type-cache)
                name-id
                display-name)])))]))

(define (lower-hygiene-source-name [name : String]) : String
  (if (tc_core.tc-hygiene-global-name? name)
    (match (tc_core.tc-hygiene-global-decode name)
      [(tc_core.TcHygieneGlobalName.Legacy lookup-name) lookup-name]
      [(tc_core.TcHygieneGlobalName.Context module lookup-name)
        (if (tc_core.tc-name-qualified? lookup-name)
          lookup-name
          (csym.compiler-symbol-module-key module lookup-name))])
    name))

(define (lower-hygiene-fallback-source-name [name : String]) : tc_core.TcMaybeString
  (if (tc_core.tc-hygiene-global-name? name)
    (match (tc_core.tc-hygiene-global-decode name)
      [(tc_core.TcHygieneGlobalName.Legacy _) (tc_core.TcMaybeString.No)]
      [(tc_core.TcHygieneGlobalName.Context module lookup-name)
        (if (and
          (> (string.string-length module) 0)
          (not (tc_core.tc-name-qualified? lookup-name)))
          (tc_core.TcMaybeString.Some lookup-name)
          (tc_core.TcMaybeString.No))])
    (tc_core.TcMaybeString.No)))

(define (lower-hygiene-context-source-name-id
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [module : String]
  [module-id : i64]
  [lookup-name : String]
  [lookup-name-id : i64]) : String
  (if (tc_core.tc-name-qualified-id? lookup-name-id)
    lookup-name
    (if (and
      (>= lookup-name-id 0)
      (< lookup-name-id (ci.intern-capacity))
      (>= (tc_core.tc-name-first-dot-id lookup-name-id) 0))
      (match (tc_core.tc-source-name-lookup-key-with-field-check
        (tc_core.tc-context-with-module-id ctx module module-id)
        type-env
        lookup-name
        lookup-name-id
        true)
        [(tc_core.ResultTcString.Ok resolved-name) resolved-name]
        [(tc_core.ResultTcString.Err _)
          (csym.compiler-symbol-module-key module lookup-name)])
      (csym.compiler-symbol-module-key module lookup-name))))

(define (lower-hygiene-source-name-in-context-id
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : String
  (let
    [structural? : bool (tc_core.macro-hygiene-global-id? name-id)]
    [source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or name-id name-id)]
    [name : String (ci.intern-str source-id)]
    (if structural?
      (let
        [module-id : i64 (tc_core.macro-hygiene-global-module-id name-id)]
        (if (tc_core.macro-hygiene-global-legacy-id? name-id)
          name
          (lower-hygiene-context-source-name-id
            ctx
            type-env
            (if (csym.compiler-symbol-root-module-id? module-id)
              ""
              (ci.intern-str module-id))
            module-id
            name
            source-id)))
      (if (tc_core.tc-hygiene-global-name? name)
        (match (tc_core.tc-hygiene-global-decode name)
          [(tc_core.TcHygieneGlobalName.Legacy lookup-name) lookup-name]
          [(tc_core.TcHygieneGlobalName.Context module lookup-name)
            (let
              [lookup-name-id : i64
                (tc_core.macro-hygiene-global-source-name-id-or name-id -1)]
              [module-id : i64 (ci.intern-qualified-module-id name-id)]
              (if (and (>= lookup-name-id 0) (>= module-id 0))
                (lower-hygiene-context-source-name-id
                  ctx
                  type-env
                  module
                  module-id
                  lookup-name
                  lookup-name-id)
                (csym.compiler-symbol-module-key module lookup-name)))])
        name))))

(define (lower-type-cache-lookup-hygiene-id
  [cache : LowerTypeCache]
  [name : String]
  [generated-name-id : i64]) : tc_core.ResultTcType
  (let
    [source-name : String (lower-hygiene-source-name name)]
    [source-name-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or generated-name-id -1)]
    [source-key-id : i64 (tc_core.tc-env-name-key-id source-name-id)]
    [lookup-id : i64
      (if (>= source-name-id 0)
        (tc_core.tc-env-name-key-id generated-name-id)
        source-key-id)]
    (match (lower-type-cache-lookup-id cache lookup-id source-name)
      [(tc_core.ResultTcType.Ok ty) (tc_core.ResultTcType.Ok ty)]
      [(tc_core.ResultTcType.Err message)
        (match (lower-hygiene-fallback-source-name name)
          [(tc_core.TcMaybeString.Some fallback)
            (match (lower-type-cache-lookup-id
              cache
              (if (>= source-name-id 0)
                source-name-id
                source-key-id)
              fallback)
              [(tc_core.ResultTcType.Ok ty) (tc_core.ResultTcType.Ok ty)]
              [(tc_core.ResultTcType.Err _) (tc_core.ResultTcType.Err message)])]
          [(tc_core.TcMaybeString.No) (tc_core.ResultTcType.Err message)])])))

(define (lower-source-name-lookup-key-id
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [source-id : i64]) : tc_core.ResultTcString
  (let
    [source-name : String (ci.intern-str source-id)]
    (if (tc_core.tc-source-slash-qualified-id? source-name source-id)
      (tc_core.ResultTcString.Ok source-name)
      (tc_core.tc-source-name-lookup-key-with-field-check
        ctx
        type-env
        source-name
        source-id
        true))))

(define (lower-lookup-structural-hygiene-type-id
  [ctx : tc_core.TcContext]
  [type-cache : LowerTypeCache]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : tc_core.ResultTcType
  (let
    [source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or name-id -1)]
    [source-name : String (ci.intern-str source-id)]
    (if (tc_core.macro-hygiene-global-legacy-id? name-id)
      (lower-type-cache-lookup-id
        type-cache
        (tc_core.tc-env-name-key-id source-id)
        source-name)
      (let
        [module-id : i64 (tc_core.macro-hygiene-global-module-id name-id)]
        [definition-ctx : tc_core.TcContext
          (if (csym.compiler-symbol-root-module-id? module-id)
            (tc_core.tc-context-with-module-id
              ctx
              ""
              cbi.compiler-builtin-id-fix-empty)
            (tc_core.tc-context-with-module-id
              ctx
              (ci.intern-str module-id)
              module-id))]
        (if (>= (tc_core.tc-name-first-dot-id source-id) 0)
          (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
            definition-ctx
            type-env
            source-name
            source-id
            true)
            [(tc_core.TcNameLookup.Ok lookup-name lookup-id)
              (lower-type-cache-lookup-id
                type-cache
                (tc_core.tc-env-name-key-id lookup-id)
                lookup-name)]
            [(tc_core.TcNameLookup.Err message)
              (tc_core.ResultTcType.Err message)])
          (lower-type-cache-lookup-id
            type-cache
            (csym.compiler-symbol-module-key-id-by-id module-id source-id)
            source-name))))))

(define (lower-lookup-type-existing-id
  [ctx : tc_core.TcContext]
  [type-cache : LowerTypeCache]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [name-id : i64]) : tc_core.ResultTcType
  (cond
    [(tc_core.tc-dotted-local-field-name-id? type-env name-id)
      (match (tc_core.tc-dotted-local-field-expr-id-from-source-name-id name-id)
        [(tc_core.ResultTcExprId.Ok virtual-id)
          (tc_core.tc-expr ctx type-env (lower-context-expr-get ctx virtual-id))]
        [(tc_core.ResultTcExprId.Err message)
          (tc_core.ResultTcType.Err message)])]
    [(tc_core.tc-hygiene-global-name? name)
      (lower-type-cache-lookup-hygiene-id type-cache name name-id)]
    [(tc_core.tc-source-slash-qualified-id? name name-id)
      (let
        [lookup-key-id : i64 (tc_core.tc-env-name-key-id name-id)]
        (match (lower-type-cache-lookup-id type-cache lookup-key-id name)
          [(tc_core.ResultTcType.Ok ty) (tc_core.ResultTcType.Ok ty)]
          [(tc_core.ResultTcType.Err message)
            (match (tc_core.tc-lookup-id type-env lookup-key-id)
              [(tc_core.ResultTcType.Ok ty) (tc_core.ResultTcType.Ok ty)]
              [(tc_core.ResultTcType.Err _) (tc_core.ResultTcType.Err message)])]))]
    [else
      (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
        ctx
        type-env
        name
        name-id
        false)
        [(tc_core.TcNameLookup.Ok lookup-name lookup-id)
          (if (sym_i64_env.sym-i64-contains-id env lookup-id)
            (tc_core.tc-lookup-id type-env lookup-id)
            ;; `type-cache` is the complete global type environment plus the
            ;; current module overlay. Preserve raw generated-name hits, then
            ;; use the canonical module/base key only as the dotted-source
            ;; fallback, matching typechecking without conflating the two ID
            ;; domains.
            (match (lower-type-cache-lookup-id type-cache lookup-id lookup-name)
              [(tc_core.ResultTcType.Ok ty) (tc_core.ResultTcType.Ok ty)]
              [(tc_core.ResultTcType.Err message)
                (let
                  [lookup-key-id : i64 (tc_core.tc-env-name-key-id lookup-id)]
                  (if (= lookup-key-id lookup-id)
                    (tc_core.tc-variant-constructor-type-for-lookup-or-id
                      ctx
                      lookup-id
                      (tc_core.tc-source-unbound-display-message
                        ctx
                        name
                        name-id
                        lookup-name
                        message))
                    (match (tc_core.tc-lookup-id type-env lookup-key-id)
                      [(tc_core.ResultTcType.Ok ty)
                        (tc_core.ResultTcType.Ok ty)]
                      [(tc_core.ResultTcType.Err _)
                        (tc_core.tc-variant-constructor-type-for-lookup-or-id
                          ctx
                          lookup-id
                          (tc_core.tc-source-unbound-display-message
                            ctx
                            name
                            name-id
                            lookup-name
                            message))])))]))]
        [(tc_core.TcNameLookup.Err message) (tc_core.ResultTcType.Err message)])]))

(define (lower-lookup-type-id
  [ctx : tc_core.TcContext]
  [type-cache : LowerTypeCache]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name-id : i64]) : tc_core.ResultTcType
  (cond
    [(sym_i64_env.sym-i64-contains-id env name-id)
      (tc_core.tc-lookup-id type-env name-id)]
    [(tc_core.macro-hygiene-global-id? name-id)
      (lower-lookup-structural-hygiene-type-id ctx type-cache type-env name-id)]
    [(tc_core.tc-env-key-has-name-id? name-id)
      (let
        [name : String (tc_core.tc-env-key-name-text name-id)]
        (lower-lookup-type-existing-id ctx type-cache env type-env name name-id))]
    [else
      (lower-type-cache-lookup-id
        type-cache
        name-id
        (tc_core.tc-env-key-display name-id))]))

;; Growable membership set of the interned source-ids already bound into the
;; import-alias overlay currently being built by
;; lower-name-env-from-import-aliases-in-module-cache. That overlay starts empty
;; and is accumulated strictly linearly (single accumulator, no branching or
;; re-entrant overlay builds), so an O(1) hashmap presence check can stand in for
;; the O(n) LowerNameEnv scan previously run for every added alias -- formerly
;; O(aliases^2) per module. Only
;; presence matters here, so a bare generated i64 -> i64 map (which grows) is
;; used rather than a fixed-capacity LowerNameCache.
;;
;; `valid` guards the fast path. Every alias bound through this overlay carries
;; an interned (>=0) source id, so the set stays a complete mirror; but should a
;; <0 (never-interned) id ever appear -- the only case lower-name-env-lookup-with-id
;; resolves through its string-compare gate rather than the id gate -- we drop
;; back to the exact scan for the remainder of the overlay so the Some/No result
;; stays byte-identical to the pure linear scan.
(define lower-alias-overlay-ids : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 16))
(define lower-alias-overlay-valid : bool
  true)

(define (lower-alias-overlay-reset!) : unit
  (begin
    (set! lower-alias-overlay-ids (lower_i64_i64_map.with-capacity 16))
    (set! lower-alias-overlay-valid true)))

(define (lower-alias-overlay-contains? [source-id : i64]) : bool
  (match (lower_i64_i64_map.get (& lower-alias-overlay-ids) source-id)
    [(lower_i64_i64_map.LookupFound _) true]
    [(lower_i64_i64_map.LookupMissing) false]))

(define (lower-alias-overlay-logical-id-or [source-id : i64] [fallback : i64]) : i64
  (lower_i64_i64_map.get-value-or
    (& lower-alias-overlay-ids)
    source-id
    fallback))

(define (lower-alias-overlay-record! [source-id : i64] [logical-id : i64]) : unit
  (lower_i64_i64_map.insert-ref!
    (&mut lower-alias-overlay-ids)
    source-id
    logical-id))

;; Seed the overlay membership set from an existing base environment.
(define (lower-alias-overlay-seed-from-env! [names : LowerNameEnv]) : unit
  (begin
    (set! lower-alias-overlay-ids (lower_i64_i64_map.with-capacity 256))
    (set! lower-alias-overlay-valid true)
    (let
      [cur : LowerNameEnv names]
      (while (match cur
        [(LowerNameEnv.Nil) false]
        [_ true])
        (match (lower-name-env-view cur)
          [(LowerNameEnvView.Nil) unit]
          [(LowerNameEnvView.Bind bind-id logical-id _ rest)
            (begin
              (if (< bind-id 0)
                (set! lower-alias-overlay-valid false)
                (lower_i64_i64_map.insert-ref!
                  (&mut lower-alias-overlay-ids)
                  bind-id
                  logical-id))
              (set! cur rest))])))))

;; Per-declaration memo of the import-alias logical symbol ID, live for exactly
;; one lower-name-env-from-import-aliases pass.
;;
;; The rendered logical display name feeding lower-logical-symbol-id-select is a
;; function of the TARGET declaration alone -- entry path, the declaration's own
;; path, its owning module, and its name. The importing alias never appears in
;; it. The alias fanout, however, visits every declaration of a module once per
;; importing alias, so an opt1 self-compile rendered the same "<module>::<name>"
;; string 232337 times across at most 26609 distinct declarations. Those strings
;; are pure scratch -- only the interned ID they resolve to is retained -- yet
;; the lowering arena has no free, so all 51.5 MB of them stayed live through
;; the compile-wide peak, in each of the two name-env builds.
;;
;; Keying on the declaration's program-order position collapses that to one
;; render per declaration. The first visit still renders and interns in exactly
;; the original order, so the intern pool receives the same insertions with the
;; same IDs; later visits reuse the ID that intern-generated-canonical-name
;; would have returned from its existing slot anyway.
(define lower-alias-symbol-memo : (__tl_dyn-array i64)
  (make-array i64 0))

(define (lower-alias-symbol-memo-reset! [count : i64]) : unit
  (let
    [slots : (__tl_dyn-array i64)
      (make-array
        i64
        (if (< count 1)
          1
          count))]
    [index : i64 0]
    (begin
      (while (< index count)
        (begin
          (array-set! slots index -1)
          (set! index (+ index 1))))
      (set! lower-alias-symbol-memo slots))))

(define (lower-alias-symbol-memo-release!) : unit
  (set! lower-alias-symbol-memo (make-array i64 0)))

(define (lower-alias-symbol-memo-get [position : i64]) : i64
  (if (or (< position 0) (>= position (array-length lower-alias-symbol-memo)))
    -1
    (array-ref lower-alias-symbol-memo position)))

(define (lower-alias-symbol-memo-set! [position : i64] [symbol-id : i64]) : unit
  (if (or
    (< position 0)
    (< symbol-id 0)
    (>= position (array-length lower-alias-symbol-memo)))
    unit
    (array-set! lower-alias-symbol-memo position symbol-id)))

(define (lower-name-env-add-import-alias-binding-symbol-id
  [names : LowerNameEnv]
  [alias : String]
  [_ : String]
  [source-id : i64]
  [_ : String]
  [logical-id : i64]
  [symbol-id : i64]) : LowerNameEnv
  (begin
    (when (< source-id 0) (set! lower-alias-overlay-valid false))
    ;; Re-entering a flattened module can repeat the exact same aliased import.
    ;; Its source and logical IDs are identical, so another shadowing node cannot
    ;; change resolution. A later reuse of the alias for a different logical ID
    ;; still binds and replaces the tracked value.
    (when
      (not (string.eq alias ""))
      (when
        lower-alias-overlay-valid
        (when
          (= (lower-alias-overlay-logical-id-or source-id -1) logical-id)
          (return names))
        (lower-alias-overlay-record! source-id logical-id))
      (return
        (lower-name-env-bind-logical-symbol-id
          source-id
          logical-id
          symbol-id
          names)))
    ;; Empty alias, degraded set (a <0 id appeared): exact linear scan preserves
    ;; the Some/No decision byte-for-byte.
    (when
      (not lower-alias-overlay-valid)
      (return
        (match (lower-name-env-lookup-with-id names source-id)
          [(tc_core.TcMaybeString.Some _) names]
          [(tc_core.TcMaybeString.No)
            (lower-name-env-bind-logical-symbol-id
              source-id
              logical-id
              symbol-id
              names)])))
    ;; Fast path: O(1) membership check against the base-seeded overlay set,
    ;; same accept decision as scanning `names`.
    (when (lower-alias-overlay-contains? source-id) (return names))
    (lower-alias-overlay-record! source-id logical-id)
    (lower-name-env-bind-logical-symbol-id source-id logical-id symbol-id names)))

(define (lower-name-env-add-decl-import-alias-binding-base-id
  [names : LowerNameEnv]
  [position : i64]
  [entry-path : String]
  [decl-path : String]
  [alias : String]
  [alias-id : i64]
  [module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]
  [path-aware : bool]) : LowerNameEnv
  (let
    [logical-id : i64 (lower-module-name-key-id-by-id module-id source-id)]
    [memoized : i64 (lower-alias-symbol-memo-get position)]
    (if (>= memoized 0)
      ;; This declaration was already resolved earlier in the pass by another
      ;; importing alias. Re-rendering its display name would rebuild a string
      ;; whose every interned constituent is already present -- the composite
      ;; logical key above, and the canonical name itself -- so the render can
      ;; only reproduce `memoized`.
      (lower-name-env-add-import-alias-binding-base-symbol-id
        names
        alias
        alias-id
        source-name
        source-id
        logical-id
        ""
        memoized)
      ;; First sight of this declaration: render, derive, and intern in the
      ;; original order (logical key, display name, alias composite key, then
      ;; the canonical symbol) so intern ID assignment is unchanged.
      (let
        [logical-name : String
          (lower-alias-logical-name-id
            entry-path
            decl-path
            module
            module-id
            source-id
            source-name
            path-aware)]
        [direct : bool
          (lower-alias-logical-symbol-direct?
            entry-path
            decl-path
            logical-id
            source-id
            path-aware)]
        [source-key-id : i64
          (csym.compiler-symbol-module-key-id-by-id alias-id source-id)]
        [symbol-id : i64
          (lower-logical-symbol-id-select logical-name logical-id direct)]
        (begin
          (lower-alias-symbol-memo-set! position symbol-id)
          (lower-name-env-add-import-alias-binding-symbol-id
            names
            alias
            source-name
            source-key-id
            logical-name
            logical-id
            symbol-id))))))

(define (lower-name-env-add-import-alias-binding-base-symbol-id
  [names : LowerNameEnv]
  [alias : String]
  [alias-id : i64]
  [_ : String]
  [base-id : i64]
  [logical-id : i64]
  [logical-name : String]
  [symbol-id : i64]) : LowerNameEnv
  (lower-name-env-add-import-alias-binding-symbol-id
    names
    alias
    ;; As above: the callee ignores the rendered key (`[_ : String]`); only
    ;; the composite key ID is consumed.
    ""
    (csym.compiler-symbol-module-key-id-by-id alias-id base-id)
    logical-name
    logical-id
    symbol-id))

(define (lower-name-env-add-import-alias-binding-base-cache-symbol-id
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [dedup-base : bool]
  [alias : String]
  [alias-id : i64]
  [_ : String]
  [base-id : i64]
  [logical-id : i64]
  [_ : String]
  [symbol-id : i64]) : LowerNameEnv
  (let
    [source-id : i64
      (csym.compiler-symbol-module-key-id-by-id alias-id base-id)]
    (begin
      (when (< source-id 0) (set! lower-alias-overlay-valid false))
      ;; Identical aliased imports may recur when a flattened module is
      ;; re-entered. Skip only an identical source/logical pair; a different
      ;; logical target still shadows and updates the tracked value.
      (when
        (not (string.eq alias ""))
        (when
          lower-alias-overlay-valid
          (when
            (= (lower-alias-overlay-logical-id-or source-id -1) logical-id)
            (return names))
          (lower-alias-overlay-record! source-id logical-id))
        (return
          (lower-name-env-bind-logical-symbol-id
            source-id
            logical-id
            symbol-id
            names)))
      ;; Empty alias already provided by the base module: nothing to add.
      (when
        (and
          dedup-base
          (lower-name-cache-contains-local-id? base-cache source-id))
        (return names))
      ;; Degraded set (a <0 id appeared): exact linear scan preserves the
      ;; Some/No decision byte-for-byte.
      (when
        (not lower-alias-overlay-valid)
        (return
          (match (lower-name-env-lookup-with-id names source-id)
            [(tc_core.TcMaybeString.Some _) names]
            [(tc_core.TcMaybeString.No)
              (lower-name-env-bind-logical-symbol-id
                source-id
                logical-id
                symbol-id
                names)])))
      ;; Fast path: O(1) overlay dedup, same accept decision as scanning `names`.
      (when (lower-alias-overlay-contains? source-id) (return names))
      (lower-alias-overlay-record! source-id logical-id)
      (lower-name-env-bind-logical-symbol-id
        source-id
        logical-id
        symbol-id
        names))))

;; The module-local alias fanout resolves every (import, declaration) pair
;; through the base module's name cache. That cache holds the pair's symbol on
;; every visit of a whole-compiler input (measured 467,682 of 467,682 lookups),
;; so the display name rendered to derive the miss fallback -- and the fallback
;; itself -- were pure waste: the callee below ignores the rendered name (its
;; parameter is `_`), and the lookup never returned the derived id. Rendering
;; only on an actual miss keeps the same result while dropping ~32 MB of
;; throwaway module-key strings per compile. Presence is decided with the same
;; `>= 0` test the render helper itself uses on this API.
(define (lower-name-cache-alias-symbol-id-or-derived
  [base-cache : LowerNameCache]
  [logical-id : i64]
  [module : String]
  [source-name : String]
  [source-id : i64]) : i64
  (let
    [cached : i64
      (lower-name-cache-lookup-symbol-id (& base-cache) logical-id -1)]
    (if (>= cached 0)
      cached
      (lower-derived-symbol-id
        (lower-current-decl-logical-name-cache-id
          base-cache
          module
          source-name
          source-id)))))

(define (lower-name-env-add-import-alias-binding-base-cache-id
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [dedup-base : bool]
  [alias : String]
  [alias-id : i64]
  [base-name : String]
  [base-id : i64]
  [logical-id : i64]
  [module : String]
  [source-name : String]
  [source-id : i64]) : LowerNameEnv
  (lower-name-env-add-import-alias-binding-base-cache-symbol-id
    names
    base-cache
    dedup-base
    alias
    alias-id
    base-name
    base-id
    logical-id
    ;; The callee ignores this rendered name; only the symbol id is consumed.
    ""
    (lower-name-cache-alias-symbol-id-or-derived
      base-cache
      logical-id
      module
      source-name
      source-id)))

(define (lower-module-name-key-id-by-id [module-id : i64] [name-id : i64]) : i64
  (if (csym.compiler-symbol-root-module-id? module-id)
    name-id
    (csym.compiler-symbol-module-key-id-by-id module-id name-id)))

(define (lower-name-env-add-module-binding-id
  [names : LowerNameEnv]
  [_module : String]
  [module-id : i64]
  [_ : String]
  [source-id : i64]
  [logical-name : String]
  [logical-id : i64]
  [direct : bool]) : LowerNameEnv
  (let
    [symbol-id : i64
      (lower-logical-symbol-id-select
        logical-name
        (if direct
          source-id
          logical-id)
        direct)]
    (if (csym.compiler-symbol-root-module-id? module-id)
      (lower-name-env-bind-logical-symbol-id
        source-id
        logical-id
        symbol-id
        names)
      (lower-name-env-bind-logical-symbol-id
        logical-id
        logical-id
        symbol-id
        names))))

(define (lower-name-env-add-decl-module-binding-id
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]) : LowerNameEnv
  (let
    [logical-id : i64
      (lower-decl-logical-id
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name)]
    (lower-name-env-add-module-binding-id
      names
      module
      module-id
      source-name
      source-id
      (lower-decl-logical-name-id
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name)
      logical-id
      (lower-decl-logical-symbol-direct?
        entry-path
        decl-path
        logical-id
        source-id))))

(define (lower-name-env-add-module-extern-binding-id
  [names : LowerNameEnv]
  [_module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]
  [metadata : ast.AstExternMetadata]) : LowerNameEnv
  (let
    [logical-id : i64 (lower-module-name-key-id-by-id module-id source-id)]
    [symbol-id : i64
      (lower-extern-logical-symbol-id logical-id source-name source-id metadata)]
    (lower-name-env-bind-ids
      (if (csym.compiler-symbol-root-module-id? module-id)
        source-id
        logical-id)
      logical-id
      symbol-id
      names)))

(define (lower-name-env-add-struct-cleanup-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [cleanup : ast.AstStructCleanup]) : LowerNameEnv
  (match cleanup
    [(ast.AstStructCleanup.No) names]
    [(ast.AstStructCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
        (lower-name-env-add-decl-module-binding-id
          names
          entry-path
          decl-path
          module
          module-id
          cleanup-str
          cleanup-name))]))

(define (lower-name-env-add-enum-cleanup-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [cleanup : ast.AstEnumCleanup]) : LowerNameEnv
  (match cleanup
    [(ast.AstEnumCleanup.No) names]
    [(ast.AstEnumCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
        (lower-name-env-add-decl-module-binding-id
          names
          entry-path
          decl-path
          module
          module-id
          cleanup-str
          cleanup-name))]))

(define (lower-name-env-add-local-struct-cleanup
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [cleanup : ast.AstStructCleanup]) : LowerNameEnv
  (match cleanup
    [(ast.AstStructCleanup.No) names]
    [(ast.AstStructCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
        (lower-name-env-bind-cached-logical-id
          cleanup-name
          (lower-current-decl-logical-name-cache-id
            name-cache
            module
            cleanup-str
            cleanup-name)
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              cleanup-name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              cleanup-name))
          name-cache
          names))]))

(define (lower-name-env-add-local-enum-cleanup
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [cleanup : ast.AstEnumCleanup]) : LowerNameEnv
  (match cleanup
    [(ast.AstEnumCleanup.No) names]
    [(ast.AstEnumCleanup.Fn cleanup-name)
      (let
        [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
        (lower-name-env-bind-cached-logical-id
          cleanup-name
          (lower-current-decl-logical-name-cache-id
            name-cache
            module
            cleanup-str
            cleanup-name)
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              cleanup-name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              cleanup-name))
          name-cache
          names))]))

(define (lower-name-has-clone-prefix? [name : String]) : bool
  (let
    [source-name : String (tc_core.tc-hygiene-global-call-name name)]
    (if (>= (string.string-length source-name) 6)
      (string.eq (string.substring source-name 0 6) "clone$")
      false)))

(define (lower-resolve-name-id [state : LowerState] [source-id : i64]) : String
  (if (and (>= source-id 0) (< source-id (ci.intern-capacity)))
    (let
      [names : LowerNameCache (lower-state-names state)]
      (match (lower-name-cache-resolve-id-display names source-id)
        [(tc_core.TcMaybeString.Some logical-name) logical-name]
        [(tc_core.TcMaybeString.No) (ci.intern-str source-id)]))
    (match (lower-name-cache-lookup-id (lower-state-names state) source-id)
      [(tc_core.TcMaybeString.Some logical-name) logical-name]
      [(tc_core.TcMaybeString.No)
        (tc_core.tc-nominal-name-id-display source-id)])))

(define (lower-resolve-name-symbol-id [state : LowerState] [source-id : i64]) : i64
  (let
    [names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (lower-name-cache-resolve-logical-id (& names) source-id source-id)]
    [resolved-name : String (lower-resolve-name-id state source-id)]
    [symbol-id : i64
      (lower-name-cache-resolve-symbol-id (& names) source-id -1)]
    (if (>= symbol-id 0)
      symbol-id
      (lower-logical-symbol-id-select
        resolved-name
        logical-id
        (lower-logical-symbol-id-direct? logical-id source-id)))))

(define (lower-name-cache-ir-symbol
  [names : LowerNameCache]
  [logical-id : i64]
  [source-id : i64]
  [display-name : String]) : i64
  (lower-name-cache-lookup-symbol-id
    (& names)
    logical-id
    (lower-logical-symbol-id-select
      display-name
      logical-id
      (lower-logical-symbol-id-direct? logical-id source-id))))

(define (lower-decl-function-symbol-id
  [names : LowerNameCache]
  [logical-id : i64]
  [source-id : i64]
  [logical-name : String]) : i64
  (if (= logical-id cbi.compiler-builtin-id-fix-main)
    source-id
    (lower-name-cache-ir-symbol names logical-id source-id logical-name)))

(define (lower-tl-alloc-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-alloc))

(define (lower-tl-oob-abort-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-oob-abort))

(define (lower-tl-shift-abort-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-shift-abort))

(define (lower-tl-region-reset-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-region-reset))

(define (lower-tl-region-mark-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-region-mark))

(define (lower-tl-arena-set-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-arena-set))

(define (lower-tl-arena-current-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-arena-current))

(define (lower-tl-substring-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-substring))

(define (lower-tl-str-view-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-str-view))

(define (lower-tl-array-fill8-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-array-fill8))

(define (lower-tl-array-zero-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-array-zero))

(define (lower-tl-arena-make-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-arena-make))

(define (lower-tl-arena-destroy-symbol) : i64
  (begin
    (cbi.compiler-builtin-refresh!)
    cbi.compiler-builtin-id-tl-arena-destroy))

(define (lower-resolve-call-name-id
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]) : i64
  (let
    [local? : bool (sym_i64_env.sym-i64-contains-id env source-id)]
    [state-names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (if local?
        source-id
        (lower-name-cache-resolve-logical-id
          (& state-names)
          source-id
          source-id))]
    [source-name : String
      (if (and (>= source-id 0) (< source-id (ci.intern-capacity)))
        (ci.intern-str source-id)
        (tc_core.tc-nominal-name-id-display source-id))]
    [resolved-name : String
      (if local?
        source-name
        (if (and (>= source-id 0) (< source-id (ci.intern-capacity)))
          (lower-resolve-name-id state source-id)
          (match (lower-name-cache-lookup-id state-names source-id)
            [(tc_core.TcMaybeString.Some logical-name) logical-name]
            [(tc_core.TcMaybeString.No) source-name])))]
    [symbol-id : i64
      (if local?
        -1
        (lower-name-cache-resolve-symbol-id (& state-names) source-id -1))]
    (if (>= symbol-id 0)
      symbol-id
      (lower-logical-symbol-id-select
        resolved-name
        logical-id
        (lower-logical-symbol-id-direct? logical-id source-id)))))

(define (lower-resolve-call-name-id-with-display
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [source-id : i64]
  [display-name : String]) : i64
  (let
    [local? : bool (sym_i64_env.sym-i64-contains-id env source-id)]
    [state-names : LowerNameCache (lower-state-names state)]
    [logical-id : i64
      (if local?
        source-id
        (lower-name-cache-resolve-logical-id
          (& state-names)
          source-id
          source-id))]
    [logical-display : String
      (if local?
        display-name
        (match (lower-name-cache-resolve-id-display state-names source-id)
          [(tc_core.TcMaybeString.Some resolved-name) resolved-name]
          [(tc_core.TcMaybeString.No)
            (if (>= source-id (ci.intern-capacity))
              (tc_core.tc-env-key-display source-id)
              display-name)]))]
    [symbol-id : i64
      (if local?
        -1
        (lower-name-cache-resolve-symbol-id (& state-names) source-id -1))]
    (if (>= symbol-id 0)
      symbol-id
      (lower-logical-symbol-id-select
        logical-display
        logical-id
        (lower-logical-symbol-id-direct? logical-id source-id)))))

(define (lower-path-separator? [c : char]) : bool
  (or (= c '/') (= c '\\')))

(define (lower-path-drive-qualified? [path : String]) : bool
  (let
    [n : i64 (string.string-length path)]
    (and (> n 1) (= (cast (string.string-ref path 1) : i64) (cast ':' : i64)))))

(define (lower-dirname [path : String]) : String
  (let
    [n : i64 (string.string-length path)]
    [i : i64 0]
    [last : i64 -1]
    (begin
      (while (< i n)
        (begin
          (if (lower-path-separator? (string.string-ref path i))
            (set! last i)
            (set! last last))
          (set! i (+ i 1))))
      (if (< last 0)
        ""
        (string.substring path 0 (+ last 1))))))

;; Join segments with '/' in one linear text-buf build. The fold-with-append
;; version copied the whole accumulated prefix on every segment (quadratic in
;; rendered length) and ran once per normalized path, making it the largest
;; string.append caller in the lowering phase of a self-compile.
(define (lower-path-segment-vec-render [segments : svec.Vec]) : String
  (let
    [count : i64 (svec.len (& segments))]
    (if (<= count 1)
      (svec.get (& segments) 0 "")
      (let
        [buf : text_buf.TextBuf
          (text_buf.append (text_buf.empty) (svec.get (& segments) 0 ""))]
        [i : i64 1]
        (begin
          (while (< i count)
            (begin
              (set!
                buf
                (text_buf.append
                  (text_buf.append buf "/")
                  (svec.get (& segments) i "")))
              (set! i (+ i 1))))
          (text_buf.render buf))))))

(define (lower-path-normalize-segment
  [segment : String]
  [segments : (&mut segments svec.Vec)]
  [rooted : bool]) : unit
  (cond
    [(string.eq segment "") unit]
    [(string.eq segment ".") unit]
    [(not (string.eq segment "..")) (svec.push segments segment)]
    [(<= (svec.len (& segments)) 0)
      (if rooted
        unit
        (svec.push segments segment))]
    [else
      (let
        [top : String (svec.last (& segments) "")]
        (if (string.eq top "..")
          (svec.push segments segment)
          (match (svec.pop segments)
            [(svec.Pop.Ok _) unit]
            [svec.Pop.Empty unit])))]))

(define (lower-path-canonical? [path : String]) : bool
  (let
    [n : i64 (string.string-length path)]
    [i : i64 0]
    [segment-start : i64 0]
    [ok : bool (> n 0)]
    (begin
      (while (and ok (< i n))
        (let
          [c : char (string.string-ref path i)]
          (begin
            (cond
              [(= c '\\') (set! ok false)]
              [(= c '/')
                (let
                  [segment-len : i64 (- i segment-start)]
                  (begin
                    (if (and (= segment-len 0) (not (= i 0)))
                      (set! ok false)
                      unit)
                    (if (and
                      (= segment-len 1)
                      (= (string.string-ref path segment-start) '.'))
                      (set! ok false)
                      unit)
                    (if (and
                      (= segment-len 2)
                      (= (string.string-ref path segment-start) '.')
                      (= (string.string-ref path (+ segment-start 1)) '.'))
                      (set! ok false)
                      unit)
                    (set! segment-start (+ i 1))))]
              [else unit])
            (set! i (+ i 1)))))
      (if (not ok)
        false
        (let
          [segment-len : i64 (- n segment-start)]
          (cond
            [(= segment-len 0)
              (or (= n 1) (and (= n 3) (lower-path-drive-qualified? path)))]
            [(and
                (= segment-len 1)
                (= (string.string-ref path segment-start) '.'))
              false]
            [(and
                (= segment-len 2)
                (= (string.string-ref path segment-start) '.')
                (= (string.string-ref path (+ segment-start 1)) '.'))
              false]
            [else true]))))))

;; --- proven-canonical path memo ---------------------------------------
;; lower-normalize-path returns its argument unchanged when the path is
;; already canonical, and that is what every module path of a normal compile
;; is: an opt1 self-compile asked 676,802 times and took the rewriting branch
;; 35 times. The asks come one per declaration per lowering walk over the
;; program's ~150 distinct module paths, so lower-path-canonical? kept
;; re-reading the same strings byte by byte -- 693M Ir, 1.3% of the compile.
;; Remembering which path strings are already proven canonical answers the
;; repeats with a length compare instead of a scan.
;;
;; Two slots, because both decl-level callers (lower-decl-entry-path? and
;; lower-module-id) normalize the fixed entry path and the current decl path
;; back to back, and the pair only changes at a module boundary. A remembered
;; path is only ever used as a comparison key -- lower-normalize-path returns
;; the caller's own argument on a hit -- so nothing here extends a String's
;; lifetime past the call that supplied it, and lower-reset-file-state! drops
;; the keys with the rest of the per-file lowering state.
(define lower-canonical-path-count : i64
  0)
(define lower-canonical-path-recent : String
  "")
(define lower-canonical-path-prior : String
  "")

(define (lower-canonical-path-memo-reset!) : unit
  (begin
    (set! lower-canonical-path-count 0)
    (set! lower-canonical-path-recent "")
    (set! lower-canonical-path-prior "")))

(define (lower-canonical-path-remembered? [path : String]) : bool
  (if (and
    (>= lower-canonical-path-count 1)
    (string.eq lower-canonical-path-recent path))
    true
    (and
      (>= lower-canonical-path-count 2)
      (string.eq lower-canonical-path-prior path))))

(define (lower-canonical-path-remember! [path : String]) : unit
  (begin
    (set!
      lower-canonical-path-prior
      (lower-global-shared-view lower-canonical-path-recent))
    (set! lower-canonical-path-recent path)
    (if (< lower-canonical-path-count 2)
      (set! lower-canonical-path-count (+ lower-canonical-path-count 1))
      unit)))

(define (lower-path-known-canonical? [path : String]) : bool
  (if (lower-canonical-path-remembered? path)
    true
    (if (lower-path-canonical? path)
      (begin
        (lower-canonical-path-remember! path)
        true)
      false)))

(define (lower-normalize-path [path : String]) : String
  (if (lower-path-known-canonical? path)
    path
    (let
      [n : i64 (string.string-length path)]
      [drive-root : bool
        (if (> n 2)
          (if (lower-path-drive-qualified? path)
            (lower-path-separator? (string.string-ref path 2))
            false)
          false)]
      [rooted : bool
        (if drive-root
          true
          (if (> n 0)
            (lower-path-separator? (string.string-ref path 0))
            false))]
      [i : i64
        (if drive-root
          3
          (if rooted
            1
            0))]
      [segment-start : i64 i]
      [segments : svec.Vec (svec.new)]
      (begin
        (while (< i n)
          (begin
            (if (lower-path-separator? (string.string-ref path i))
              (begin
                (lower-path-normalize-segment
                  (string.substring path segment-start (- i segment-start))
                  (&mut segments)
                  rooted)
                (set! segment-start (+ i 1)))
              (set! segment-start segment-start))
            (set! i (+ i 1))))
        (lower-path-normalize-segment
          (string.substring path segment-start (- n segment-start))
          (&mut segments)
          rooted)
        (let
          [body : String (lower-path-segment-vec-render segments)]
          (cond
            [(if drive-root
                (= (string.string-length body) 0)
                false)
              (string.append (string.substring path 0 2) "/")]
            [drive-root
              (string.append
                (string.substring path 0 2)
                (string.append "/" body))]
            [(if rooted
                (= (string.string-length body) 0)
                false)
              "/"]
            [rooted (string.append "/" body)]
            [(= (string.string-length body) 0) "."]
            [else body]))))))

(define (lower-string-prefix-at?
  [text : String]
  [prefix : String]
  [start : i64]) : bool
  (let
    [text-len : i64 (string.string-length text)]
    [prefix-len : i64 (string.string-length prefix)]
    (if (< start 0)
      false
      (if (> (+ start prefix-len) text-len)
        false
        (let
          [i : i64 0]
          [ok : bool true]
          (begin
            (while ok
              (if (< i prefix-len)
                (if (=
                  (cast (string.string-ref text (+ start i)) : i64)
                  (cast (string.string-ref prefix i) : i64))
                  (set! i (+ i 1))
                  (set! ok false))
                (set! ok false)))
            (= i prefix-len)))))))

(define (lower-module-id [entry-path : String] [decl-path : String]) : String
  (let
    [entry-path : String (lower-normalize-path entry-path)]
    [decl-path : String (lower-normalize-path decl-path)]
    [base : String (lower-dirname entry-path)]
    [base-len : i64 (string.string-length base)]
    [decl-len : i64 (string.string-length decl-path)]
    (if (and (> base-len 0) (lower-string-prefix-at? decl-path base 0))
      (string.substring decl-path base-len (- decl-len base-len))
      decl-path)))

(define (lower-module-logical-name
  [entry-path : String]
  [decl-path : String]
  [source-name : String]) : String
  (if (and
    (string.eq source-name "main")
    (string.eq
      (lower-normalize-path decl-path)
      (lower-normalize-path entry-path)))
    "main"
    (string.append
      (string.append (lower-module-id entry-path decl-path) "::")
      source-name)))

(define lower-entry-main-module-active : bool
  false)
(define lower-entry-main-module : String
  "")
(define lower-entry-main-module-id : i64
  -1)

(define (lower-entry-main-module-active-current) : bool
  lower-entry-main-module-active)

(define (lower-entry-main-module-current) : String
  (string.copy (& lower-entry-main-module)))

(define (lower-entry-main-module-id-current) : i64
  lower-entry-main-module-id)

(define (lower-entry-main-module-match? [module : String]) : bool
  (if lower-entry-main-module-active
    (string.eq module lower-entry-main-module)
    (or (string.eq module "") (string.eq module "main"))))

(define (lower-decl-entry-main?
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [source-name : String]) : bool
  (and
    (string.eq source-name "main")
    (lower-entry-main-module-match? module)
    (string.eq
      (lower-normalize-path decl-path)
      (lower-normalize-path entry-path))))

(define (lower-decl-logical-id
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]) : i64
  (if (lower-decl-entry-main? entry-path decl-path module source-name)
    cbi.compiler-builtin-id-fix-main
    (lower-module-name-key-id-by-id module-id source-id)))

(define (lower-decl-entry-path? [entry-path : String] [decl-path : String]) : bool
  (or
    (string.eq entry-path decl-path)
    (string.eq
      (lower-normalize-path entry-path)
      (lower-normalize-path decl-path))))

(define (lower-decl-logical-symbol-direct?
  [_ : String]
  [_ : String]
  [logical-id : i64]
  [_ : i64]) : bool
  (= logical-id cbi.compiler-builtin-id-fix-main))

(define (lower-decl-owner-module-id
  [paths : (& paths ast.AstDeclPathList)]
  [index : i64]
  [entry-path : String]
  [decl-path : String]
  [source-module-id : i64]) : i64
  (if (or
    (not (csym.compiler-symbol-root-module-id? source-module-id))
    (lower-decl-entry-path? entry-path decl-path))
    source-module-id
    (ast.ast-decl-path-list-owner-id paths index source-module-id)))

(define (lower-decl-owner-module-name
  [source-module-id : i64]
  [owner-module-id : i64]) : String
  (if (and
    (not (= source-module-id owner-module-id))
    (ci.intern-generated-id-active? owner-module-id))
    ""
    (ci.intern-str owner-module-id)))

(define (lower-entry-main-decl? [decl : ast.AstDecl]) : bool
  (match decl
    [(ast.AstDecl.Def decl-meta name _ _)
      (= name cbi.compiler-builtin-id-fix-main)]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (= name cbi.compiler-builtin-id-fix-main)]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-entry-main-decl? inner))]
    [_ false]))

(define (lower-entry-main-scan-add
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [scan : LowerEntryMainScan]) : LowerEntryMainScan
  (match scan
    [(LowerEntryMainScan.Scan
        fallback-count
        fallback-module
        fallback-module-id
        preferred)
      (if (and
        (lower-entry-main-decl? decl)
        (string.eq
          (lower-normalize-path decl-path)
          (lower-normalize-path entry-path)))
        (if (or (string.eq module "") (string.eq module "main"))
          (LowerEntryMainScan.Scan
            fallback-count
            fallback-module
            fallback-module-id
            true)
          (LowerEntryMainScan.Scan
            (+ fallback-count 1)
            module
            module-id
            preferred))
        scan)]))

(define (lower-entry-main-scan-decls-in-module
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [scan : LowerEntryMainScan]
  [module : String]
  [module-id : i64]) : LowerEntryMainScan
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) scan]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons path _) path]
            [(ast.AstDeclPathListStep.Nil) entry-path])]
        [rest-paths : ast.AstDeclPathList
          (match (ast.ast-decl-path-list-step paths)
            [(ast.AstDeclPathListStep.Cons _ path-rest)
              (let
                [path-rest : ast.AstDeclPathList path-rest]
                path-rest)]
            [(ast.AstDeclPathListStep.Nil) (ast.ast-decl-path-list-new)])]
        (match decl
          [(ast.AstDecl.Module next-module)
            (lower-entry-main-scan-decls-in-module
              rest
              rest-paths
              entry-path
              scan
              (ci.intern-str next-module)
              next-module)]
          [_
            (lower-entry-main-scan-decls-in-module
              rest
              rest-paths
              entry-path
              (lower-entry-main-scan-add
                entry-path
                decl-path
                module
                module-id
                decl
                scan)
              module
              module-id)]))]))

(define (lower-entry-main-scan-selection [scan : LowerEntryMainScan]) : LowerMaybeEntryMainModule
  (match scan
    [(LowerEntryMainScan.Scan
        fallback-count
        fallback-module
        fallback-module-id
        preferred)
      (if preferred
        (LowerMaybeEntryMainModule.No)
        (if (= fallback-count 1)
          (LowerMaybeEntryMainModule.Some fallback-module fallback-module-id)
          (LowerMaybeEntryMainModule.No)))]))

(define (lower-entry-main-selection-for-program
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]) : LowerMaybeEntryMainModule
  (match program
    [(ast.AstProgram.Program decls-box)
      (let
        [decls : ast.AstDeclList (box-get decls-box)]
        (lower-entry-main-scan-selection
          (lower-entry-main-scan-decls-in-module
            decls
            paths
            entry-path
            (LowerEntryMainScan.Scan
              0
              ""
              cbi.compiler-builtin-id-fix-empty
              false)
            ""
            cbi.compiler-builtin-id-fix-empty)))]))

(define (lower-entry-main-selection-install!
  [selection : LowerMaybeEntryMainModule]) : unit
  (match selection
    [(LowerMaybeEntryMainModule.No)
      (begin
        (set! lower-entry-main-module-active false)
        (set! lower-entry-main-module "")
        (set! lower-entry-main-module-id cbi.compiler-builtin-id-fix-empty))]
    [(LowerMaybeEntryMainModule.Some module module-id)
      (begin
        (set! lower-entry-main-module-active true)
        (set! lower-entry-main-module module)
        (set! lower-entry-main-module-id module-id))]))

(define (lower-entry-main-selection-restore!
  [active : bool]
  [module : String]
  [module-id : i64]) : unit
  (begin
    (set! lower-entry-main-module-active active)
    (set! lower-entry-main-module module)
    (set! lower-entry-main-module-id module-id)))

(define (lower-entry-main-logical-id [all-functions : lower_i64_i64_map.Map]) : i64
  (if (lower_i64_i64_map.contains?
    (& all-functions)
    cbi.compiler-builtin-id-fix-main)
    cbi.compiler-builtin-id-fix-main
    -1))

(define (lower-decl-logical-name-display
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]) : String
  (let
    [logical-id : i64
      (lower-decl-logical-id
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name)]
    (if (= logical-id cbi.compiler-builtin-id-fix-main)
      "main"
      (if (string.eq module "")
        (lower-module-logical-name entry-path decl-path source-name)
        (lower-module-logical-name
          entry-path
          decl-path
          (csym.compiler-symbol-module-key module source-name))))))

(define (lower-decl-logical-name-id
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]) : String
  (let
    [logical-id : i64
      (lower-decl-logical-id
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name)]
    (lower-logical-display-name-select
      (lower-decl-logical-name-display
        entry-path
        decl-path
        module
        module-id
        source-id
        source-name)
      logical-id
      (lower-decl-logical-symbol-direct?
        entry-path
        decl-path
        logical-id
        source-id))))

(define (lower-current-decl-logical-name-id
  [names : LowerNameEnv]
  [module : String]
  [module-id : i64]
  [source-name : String]
  [source-id : i64]) : String
  (let
    [key-id : i64 (lower-module-name-key-id-by-id module-id source-id)]
    [symbol-id : i64 (lower-name-env-lookup-symbol-id names key-id -1)]
    ;; Same pure-render deferral as the cache-backed twin above.
    (if (>= symbol-id 0)
      (ir.compiler-ir-symbol-text symbol-id)
      (if (and (string.eq module "main") (string.eq source-name "main"))
        "main"
        (csym.compiler-symbol-module-key module source-name)))))

(define (lower-current-decl-logical-name-cache-id
  [names : LowerNameCache]
  [module : String]
  [source-name : String]
  [source-id : i64]) : String
  (let
    [key-id : i64
      (lower-module-name-key-id-by-id (struct-get names module-id) source-id)]
    [symbol-id : i64 (lower-name-cache-lookup-symbol-id (& names) key-id -1)]
    ;; `compiler-symbol-module-key` is a pure render (no interning), and the two
    ;; branches above it discard the result. Building it eagerly allocated a
    ;; module-key string for every cache hit; render only where it is returned.
    (if (>= symbol-id 0)
      (ir.compiler-ir-symbol-text symbol-id)
      (if (and (string.eq module "main") (string.eq source-name "main"))
        "main"
        (csym.compiler-symbol-module-key module source-name)))))

(define (lower-name-env-add-decl-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match decl
    [(ast.AstDecl.Def decl-meta name _ _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-add-decl-module-binding-id
          names
          entry-path
          decl-path
          module
          module-id
          name-str
          name))]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-add-decl-module-binding-id
          names
          entry-path
          decl-path
          module
          module-id
          name-str
          name))]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-add-decl-module-binding-id
          names
          entry-path
          decl-path
          module
          module-id
          name-str
          name))]
    [(ast.AstDecl.Extern decl-meta name _ metadata _)
      ;; Calls resolve through the local declaration name; backend metadata owns
      ;; the exact external linker symbol.
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-add-module-extern-binding-id
          names
          module
          module-id
          name-str
          name
          (box-get metadata)))]
    [(ast.AstDecl.DefEnum decl-meta _ cleanup _)
      (lower-name-env-add-enum-cleanup-in-module
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ cleanup _)
      (lower-name-env-add-enum-cleanup-in-module
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(ast.AstDecl.DefStruct decl-meta _ _ cleanup _)
      (lower-name-env-add-struct-cleanup-in-module
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup _)
      (lower-name-env-add-struct-cleanup-in-module
        names
        entry-path
        decl-path
        module
        module-id
        cleanup)]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-name-env-add-decl-in-module
          names
          entry-path
          decl-path
          module
          module-id
          inner))]
    [_ names]))

(define (lower-decl-lexical-binding-id [decl : ast.AstDecl]) : LowerNameCacheMaybeId
  (match decl
    [(ast.AstDecl.Def decl-meta name _ _) (LowerNameCacheMaybeId.Some name)]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (LowerNameCacheMaybeId.Some name)]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (LowerNameCacheMaybeId.Some name)]
    [(ast.AstDecl.Extern decl-meta name _ _ _)
      (LowerNameCacheMaybeId.Some name)]
    [(ast.AstDecl.DefEnum decl-meta _ cleanup _)
      (match cleanup
        [(ast.AstEnumCleanup.Fn name) (LowerNameCacheMaybeId.Some name)]
        [(ast.AstEnumCleanup.No) (LowerNameCacheMaybeId.No)])]
    [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ cleanup _)
      (match cleanup
        [(ast.AstEnumCleanup.Fn name) (LowerNameCacheMaybeId.Some name)]
        [(ast.AstEnumCleanup.No) (LowerNameCacheMaybeId.No)])]
    [(ast.AstDecl.DefStruct decl-meta _ _ cleanup _)
      (match cleanup
        [(ast.AstStructCleanup.Fn name) (LowerNameCacheMaybeId.Some name)]
        [(ast.AstStructCleanup.No) (LowerNameCacheMaybeId.No)])]
    [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup _)
      (match cleanup
        [(ast.AstStructCleanup.Fn name) (LowerNameCacheMaybeId.Some name)]
        [(ast.AstStructCleanup.No) (LowerNameCacheMaybeId.No)])]
    [(ast.AstDecl.Unsafe inner-box)
      (lower-decl-lexical-binding-id (box-get inner-box))]
    [_ (LowerNameCacheMaybeId.No)]))

;; A path-loaded file remains in the lexical root namespace even though its
;; emitted declarations use the file/module owner ID. Preserve both keys: the
;; parser ID resolves unqualified source references, while the owner pair is the
;; stable backend/reachability identity.
(define (lower-name-env-add-root-alias-from-latest
  [names : LowerNameEnv]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match (lower-decl-lexical-binding-id decl)
    [(LowerNameCacheMaybeId.No) names]
    [(LowerNameCacheMaybeId.Some source-id)
      (match (lower-name-env-view names)
        [(LowerNameEnvView.Bind _ logical-id symbol-id _)
          (lower-name-env-bind-ids source-id logical-id symbol-id names)]
        [(LowerNameEnvView.Nil) names])]))

(define (lower-name-env-from-decls
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]) : LowerNameEnv
  (let
    [base : LowerNameEnv
      (lower-name-env-from-decls-in-module
        decls
        paths
        entry-path
        names
        ""
        cbi.compiler-builtin-id-fix-empty)]
    (lower-name-env-with-import-aliases decls paths entry-path base true)))

(define (lower-name-env-from-decls-in-module
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [_module : String]
  [module-id : i64]) : LowerNameEnv
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 module-id]
    (begin
      (while (< index count)
        (let
          [decl : ast.AstDecl
            (array-ref
              (struct-get decls slots)
              (+ (struct-get decls offset) index))]
          [decl-path : String
            (ast.ast-decl-path-list-get (& paths) index entry-path)]
          [logical-module-id : i64
            (lower-decl-owner-module-id
              (& paths)
              index
              entry-path
              decl-path
              cur-module-id)]
          (begin
            (match decl
              [(ast.AstDecl.Def decl-meta _ _ _) unit]
              [_ unit])
            (match decl
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [_
                (let
                  [owner-names : LowerNameEnv
                    (lower-name-env-add-decl-in-module
                      cur-names
                      entry-path
                      decl-path
                      (lower-decl-owner-module-name
                        cur-module-id
                        logical-module-id)
                      logical-module-id
                      decl)]
                  (set!
                    cur-names
                    (if (and
                      (csym.compiler-symbol-root-module-id? cur-module-id)
                      (not
                        (csym.compiler-symbol-root-module-id? logical-module-id)))
                      (lower-name-env-add-root-alias-from-latest
                        owner-names
                        decl)
                      owner-names)))])
            (set! index (+ index 1)))))
      cur-names)))

(define (lower-name-env-add-clone-decl-in-module-inner
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match decl
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (if (lower-name-has-clone-prefix? name-str)
          (lower-name-env-add-decl-module-binding-id
            names
            entry-path
            decl-path
            module
            module-id
            name-str
            name)
          names))]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-name-env-add-clone-decl-in-module
          names
          entry-path
          decl-path
          module
          module-id
          inner))]
    [_ names]))

(define (lower-name-env-add-clone-decl-in-module
  [names : LowerNameEnv]
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match (ast.ast-decl-generated-meta decl)
    [(ast.AstGeneratedDeclMeta.Some generator item _ _)
      (if (string.eq generator "stdlib.clone/synthesize-helpers")
        (match (ast.ast-decl-unwrapped decl)
          [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
            (lower-name-env-add-decl-module-binding-id
              names
              entry-path
              decl-path
              module
              module-id
              item
              name)]
          [_ names])
        (lower-name-env-add-clone-decl-in-module-inner
          names
          entry-path
          decl-path
          module
          module-id
          decl))]
    [(ast.AstGeneratedDeclMeta.No)
      (lower-name-env-add-clone-decl-in-module-inner
        names
        entry-path
        decl-path
        module
        module-id
        decl)]))

(define (lower-name-env-add-clone-decls-in-module
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [initial-module-id : i64]) : LowerNameEnv
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 initial-module-id]
    ;; Match the backing slot rather than binding the row to a local first: the
    ;; local materialised a 104 B copy, while a projection match loads the tag
    ;; and hands the slot straight on (aggregate arguments pass by reference).
    [decl-slots : (__tl_dyn-array ast.AstDecl) (struct-get decls slots)]
    [decl-offset : i64 (struct-get decls offset)]
    (begin
      (while (< index count)
        (let
          [decl-path : String (ast.ast-decl-path-list-get (& paths) index "")]
          (begin
            (match (array-ref decl-slots (+ decl-offset index))
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [_
                (set!
                  cur-names
                  (lower-name-env-add-clone-decl-in-module
                    cur-names
                    entry-path
                    decl-path
                    (ci.intern-str cur-module-id)
                    cur-module-id
                    (array-ref decl-slots (+ decl-offset index))))])
            (set! index (+ index 1)))))
      cur-names)))

(define (lower-name-env-add-clone-decls
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]) : LowerNameEnv
  (lower-name-env-add-clone-decls-in-module
    decls
    paths
    entry-path
    names
    cbi.compiler-builtin-id-fix-empty))

(define (lower-alias-logical-name-id
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [source-id : i64]
  [source-name : String]
  [path-aware : bool]) : String
  (if path-aware
    (lower-decl-logical-name-id
      entry-path
      decl-path
      module
      module-id
      source-id
      source-name)
    (csym.compiler-symbol-module-key module source-name)))

(define (lower-alias-logical-symbol-direct?
  [entry-path : String]
  [decl-path : String]
  [logical-id : i64]
  [source-id : i64]
  [path-aware : bool]) : bool
  (if path-aware
    (lower-decl-logical-symbol-direct?
      entry-path
      decl-path
      logical-id
      source-id)
    (lower-logical-symbol-id-direct? logical-id source-id)))

(define (lower-import-alias-key-id [importer-module-id : i64] [alias-id : i64]) : i64
  (if (= alias-id cbi.compiler-builtin-id-fix-empty)
    importer-module-id
    alias-id))

(define (lower-name-env-add-decl-alias-in-module
  [names : LowerNameEnv]
  [position : i64]
  [entry-path : String]
  [decl-path : String]
  [alias : String]
  [alias-id : i64]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]
  [path-aware : bool]) : LowerNameEnv
  (match decl
    [(ast.AstDecl.Def decl-meta name _ _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-add-decl-import-alias-binding-base-id
          names
          position
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          name-str
          name
          path-aware))]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-add-decl-import-alias-binding-base-id
          names
          position
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          name-str
          name
          path-aware))]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-add-decl-import-alias-binding-base-id
          names
          position
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          name-str
          name
          path-aware))]
    [(ast.AstDecl.Extern decl-meta name _ metadata _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        [logical-id : i64 (lower-module-name-key-id-by-id module-id name)]
        (lower-name-env-add-import-alias-binding-base-symbol-id
          names
          alias
          alias-id
          name-str
          name
          logical-id
          name-str
          (lower-extern-logical-symbol-id
            logical-id
            name-str
            name
            (box-get metadata))))]
    [(ast.AstDecl.DefEnum decl-meta _ cleanup _)
      (match cleanup
        [(ast.AstEnumCleanup.No) names]
        [(ast.AstEnumCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              names
              position
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name
              path-aware))])]
    [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ cleanup _)
      (match cleanup
        [(ast.AstEnumCleanup.No) names]
        [(ast.AstEnumCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              names
              position
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name
              path-aware))])]
    [(ast.AstDecl.DefStruct decl-meta _ _ cleanup _)
      (match cleanup
        [(ast.AstStructCleanup.No) names]
        [(ast.AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              names
              position
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name
              path-aware))])]
    [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup _)
      (match cleanup
        [(ast.AstStructCleanup.No) names]
        [(ast.AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-decl-import-alias-binding-base-id
              names
              position
              entry-path
              decl-path
              alias
              alias-id
              module
              module-id
              cleanup-str
              cleanup-name
              path-aware))])]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-name-env-add-decl-alias-in-module
          names
          position
          entry-path
          decl-path
          alias
          alias-id
          module
          module-id
          inner
          path-aware))]
    [_ names]))

(define (lower-name-env-add-decl-alias-in-module-cache
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [dedup-base : bool]
  [alias : String]
  [alias-id : i64]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match decl
    [(ast.AstDecl.Def decl-meta name _ _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-add-import-alias-binding-base-cache-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          name-str
          name
          (lower-module-name-key-id-by-id module-id name)
          module
          name-str
          name))]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-add-import-alias-binding-base-cache-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          name-str
          name
          (lower-module-name-key-id-by-id module-id name)
          module
          name-str
          name))]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-add-import-alias-binding-base-cache-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          name-str
          name
          (lower-module-name-key-id-by-id module-id name)
          module
          name-str
          name))]
    [(ast.AstDecl.Extern decl-meta name _ metadata _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        [logical-id : i64 (lower-module-name-key-id-by-id module-id name)]
        (lower-name-env-add-import-alias-binding-base-cache-symbol-id
          names
          base-cache
          dedup-base
          alias
          alias-id
          name-str
          name
          logical-id
          name-str
          (lower-extern-logical-symbol-id
            logical-id
            name-str
            name
            (box-get metadata))))]
    [(ast.AstDecl.DefEnum decl-meta _ cleanup _)
      (match cleanup
        [(ast.AstEnumCleanup.No) names]
        [(ast.AstEnumCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              cleanup-str
              cleanup-name
              (lower-module-name-key-id-by-id module-id cleanup-name)
              module
              cleanup-str
              cleanup-name))])]
    [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ cleanup _)
      (match cleanup
        [(ast.AstEnumCleanup.No) names]
        [(ast.AstEnumCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              cleanup-str
              cleanup-name
              (lower-module-name-key-id-by-id module-id cleanup-name)
              module
              cleanup-str
              cleanup-name))])]
    [(ast.AstDecl.DefStruct decl-meta _ _ cleanup _)
      (match cleanup
        [(ast.AstStructCleanup.No) names]
        [(ast.AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              cleanup-str
              cleanup-name
              (lower-module-name-key-id-by-id module-id cleanup-name)
              module
              cleanup-str
              cleanup-name))])]
    [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup _)
      (match cleanup
        [(ast.AstStructCleanup.No) names]
        [(ast.AstStructCleanup.Fn cleanup-name)
          (let
            [cleanup-str : String (tc_core.tc-env-key-name-text cleanup-name)]
            (lower-name-env-add-import-alias-binding-base-cache-id
              names
              base-cache
              dedup-base
              alias
              alias-id
              cleanup-str
              cleanup-name
              (lower-module-name-key-id-by-id module-id cleanup-name)
              module
              cleanup-str
              cleanup-name))])]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-name-env-add-decl-alias-in-module-cache
          names
          base-cache
          dedup-base
          alias
          alias-id
          module
          module-id
          inner))]
    [_ names]))

(define (lower-name-env-add-module-aliases
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [target-module-id : i64]
  [alias-id : i64]
  [_module-id : i64]
  [path-aware : bool]) : LowerNameEnv
  (let
    [cur-names : LowerNameEnv names]
    [target-module : String (ci.intern-str target-module-id)]
    [alias : String (ci.intern-str alias-id)]
    [_ensure : unit (lower-module-decl-index-ensure! decls)]
    [slot : i64 (lower-module-decl-index-slot target-module-id)]
    (if (< slot 0)
      cur-names
      (let
        [index : i64 (array-ref lower-module-decl-index-starts slot)]
        [end : i64 (array-ref lower-module-decl-index-ends slot)]
        [decl-offset : i64 (struct-get decls offset)]
        [decl-slots : (__tl_dyn-array ast.AstDecl) (struct-get decls slots)]
        (begin
          (while (< index end)
            (let
              [position : i64
                (array-ref lower-module-decl-index-positions index)]
              [decl : ast.AstDecl
                (array-ref decl-slots (+ decl-offset position))]
              [decl-path : String
                (ast.ast-decl-path-list-get (& paths) position entry-path)]
              (begin
                (match decl
                  [(ast.AstDecl.Module _) unit]
                  [(ast.AstDecl.Import decl-meta _) unit]
                  [(ast.AstDecl.IncludeStr _ _) unit]
                  [(ast.AstDecl.IncludeStrComptime _ _) unit]
                  [(ast.AstDecl.IncludeStrLzss _ _) unit]
                  [(ast.AstDecl.IncludeBin _ _) unit]
                  [(ast.AstDecl.Test _ _ _) unit]
                  [_
                    (set!
                      cur-names
                      (lower-name-env-add-decl-alias-in-module
                        cur-names
                        position
                        entry-path
                        decl-path
                        alias
                        alias-id
                        target-module
                        target-module-id
                        decl
                        path-aware))])
                (set! index (+ index 1)))))
          cur-names)))))

;; --- per-program module -> decl-position index ------------------
;; Import-alias fanout, its cache-backed module-local variant, and
;; lower-module-local-envs-list all need to filter the whole-program decl list
;; down to one module. Scanning every declaration and tracking `(module NAME)`
;; markers for each target made a self-compile pay O(imports x program) work in
;; the initial name-env build, plus repeated module-local scans later. This
;; CSR-shaped index maps each module id to the program-order positions of its
;; declarations (module markers excluded) so all of those consumers touch only
;; the target module's rows. Built lazily per program over the checked decl list,
;; which is immutable for the whole lower run;
;; lower-reset-file-state! drops it between programs and the (len, offset)
;; stamp re-checks the list shape on every ensure.
(define lower-module-decl-index-ready : bool
  false)
(define lower-module-decl-index-decl-count : i64
  -1)
(define lower-module-decl-index-decl-offset : i64
  -1)
(define lower-module-decl-index-modules : lower_i64_i64_map.Map
  (lower_i64_i64_map.with-capacity 16))
(define lower-module-decl-index-starts : (__tl_dyn-array i64)
  (make-array i64 0))
(define lower-module-decl-index-ends : (__tl_dyn-array i64)
  (make-array i64 0))
(define lower-module-decl-index-positions : (__tl_dyn-array i64)
  (make-array i64 0))
(define lower-module-decl-index-arena : i64
  0)

(define (lower-module-decl-index-reset!) : unit
  (begin
    (set! lower-module-decl-index-ready false)
    (set! lower-module-decl-index-decl-count -1)
    (set! lower-module-decl-index-decl-offset -1)
    ;; The stale array/map globals are never read while ready is false (every
    ;; consumer goes through ensure!), so destroying their arena here is safe.
    (if (= lower-module-decl-index-arena 0)
      unit
      (begin
        (unsafe
          (arena.tl_arena_destroy lower-module-decl-index-arena))
        (set! lower-module-decl-index-arena 0)))))

(define (lower-module-decl-index-ensure! [decls : ast.AstDeclList]) : unit
  (if (and
    lower-module-decl-index-ready
    (= lower-module-decl-index-decl-count (struct-get decls len))
    (= lower-module-decl-index-decl-offset (struct-get decls offset)))
    unit
    (let
      [count : i64 (struct-get decls len)]
      [decl-offset : i64 (struct-get decls offset)]
      [decl-slots : (__tl_dyn-array ast.AstDecl) (struct-get decls slots)]
      [empty-module-id : i64 cbi.compiler-builtin-id-fix-empty]
      ;; The index outlives the transient scratch arenas active during
      ;; lowering, so its backing allocations live in a dedicated arena
      ;; (same idiom as tc-hygiene-module-env-cache-arena): allocating them
      ;; in whatever arena happens to be active would leave the globals
      ;; dangling when that scratch arena is destroyed.
      [prev-arena : i64 (arena.tl_arena_current)]
      [_make-arena : unit
        (if (= lower-module-decl-index-arena 0)
          (set! lower-module-decl-index-arena (arena.tl_arena_make_small))
          unit)]
      [_switch : unit
        (unsafe
          (arena.tl_arena_set lower-module-decl-index-arena))]
      [modules : lower_i64_i64_map.Map (lower_i64_i64_map.with-capacity 512)]
      [module-count : i64 0]
      [counts : (__tl_dyn-array i64) (make-array i64 (+ count 1))]
      [starts : (__tl_dyn-array i64) (make-array i64 (+ count 1))]
      [ends : (__tl_dyn-array i64) (make-array i64 (+ count 1))]
      [positions : (__tl_dyn-array i64) (make-array i64 (+ count 1))]
      [cur-module-id : i64 empty-module-id]
      [i : i64 0]
      [running : i64 0]
      (begin
        ;; Pass 1: assign a dense slot per module id and count its decls.
        (while (< i count)
          (begin
            (match (array-ref decl-slots (+ decl-offset i))
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [_
                (let
                  [slot : i64
                    (match (lower_i64_i64_map.get (& modules) cur-module-id)
                      [(lower_i64_i64_map.LookupFound found-slot) found-slot]
                      [(lower_i64_i64_map.LookupMissing)
                        (let
                          [new-slot : i64 module-count]
                          (begin
                            (lower_i64_i64_map.insert-ref!
                              (&mut modules)
                              cur-module-id
                              new-slot)
                            (set! module-count (+ module-count 1))
                            new-slot))])]
                  (array-set! counts slot (+ (array-ref counts slot) 1)))])
            (set! i (+ i 1))))
        ;; Prefix sums: starts fixed, ends double as fill cursors below.
        (set! i 0)
        (while (< i module-count)
          (begin
            (array-set! starts i running)
            (array-set! ends i running)
            (set! running (+ running (array-ref counts i)))
            (set! i (+ i 1))))
        ;; Pass 2: fill program-order positions per module slot.
        (set! cur-module-id empty-module-id)
        (set! i 0)
        (while (< i count)
          (begin
            (match (array-ref decl-slots (+ decl-offset i))
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [_
                (match (lower_i64_i64_map.get (& modules) cur-module-id)
                  [(lower_i64_i64_map.LookupFound slot)
                    (let
                      [cursor : i64 (array-ref ends slot)]
                      (begin
                        (array-set! positions cursor i)
                        (array-set! ends slot (+ cursor 1))))]
                  [(lower_i64_i64_map.LookupMissing) unit])])
            (set! i (+ i 1))))
        (set! lower-module-decl-index-modules modules)
        (set! lower-module-decl-index-starts starts)
        (set! lower-module-decl-index-ends ends)
        (set! lower-module-decl-index-positions positions)
        (set! lower-module-decl-index-decl-count count)
        (set! lower-module-decl-index-decl-offset decl-offset)
        ;; The arena head advances as it grows; re-capture it so reset!
        ;; destroys the whole chain, then restore the caller's arena.
        (set! lower-module-decl-index-arena (arena.tl_arena_current))
        (unsafe
          (arena.tl_arena_set prev-arena))
        (set! lower-module-decl-index-ready true)))))

;; Dense slot for a module id, or -1 when the module owns no declarations.
(define (lower-module-decl-index-slot [module-id : i64]) : i64
  (lower_i64_i64_map.get-value-or
    (& lower-module-decl-index-modules)
    module-id
    -1))

(define (lower-name-env-add-module-aliases-cache
  [decls : ast.AstDeclList]
  [base-cache : LowerNameCache]
  [dedup-base : bool]
  [names : LowerNameEnv]
  [target-module-id : i64]
  [alias-id : i64]
  [_module-id : i64]) : LowerNameEnv
  (let
    [cur-names : LowerNameEnv names]
    [_ensure : unit (lower-module-decl-index-ensure! decls)]
    [slot : i64 (lower-module-decl-index-slot target-module-id)]
    (if (< slot 0)
      cur-names
      (let
        [j : i64 (array-ref lower-module-decl-index-starts slot)]
        [end : i64 (array-ref lower-module-decl-index-ends slot)]
        [target-module : String (ci.intern-str target-module-id)]
        [alias : String (ci.intern-str alias-id)]
        (begin
          (while (< j end)
            (let
              [decl : ast.AstDecl
                (array-ref
                  (struct-get decls slots)
                  (+
                    (struct-get decls offset)
                    (array-ref lower-module-decl-index-positions j)))]
              (begin
                (match decl
                  [(ast.AstDecl.Module _) unit]
                  [(ast.AstDecl.Import decl-meta _) unit]
                  [(ast.AstDecl.IncludeStr _ _) unit]
                  [(ast.AstDecl.IncludeStrComptime _ _) unit]
                  [(ast.AstDecl.IncludeStrLzss _ _) unit]
                  [(ast.AstDecl.IncludeBin _ _) unit]
                  [(ast.AstDecl.Test _ _ _) unit]
                  [_
                    (set!
                      cur-names
                      (lower-name-env-add-decl-alias-in-module-cache
                        cur-names
                        base-cache
                        dedup-base
                        alias
                        alias-id
                        target-module
                        target-module-id
                        decl))])
                (set! j (+ j 1)))))
          cur-names)))))

(define (lower-name-env-from-import-aliases
  [all-decls : ast.AstDeclList]
  [all-paths : ast.AstDeclPathList]
  [decls : ast.AstDeclList]
  [_paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [initial-module-id : i64]
  [path-aware : bool]) : LowerNameEnv
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-names : LowerNameEnv names]
    [cur-module-id : i64 initial-module-id]
    (begin
      ;; Seed the overlay membership set from the base env so the per-alias
      ;; "already bound?" check below is O(1) instead of an O(base) linear scan.
      (lower-alias-overlay-seed-from-env! cur-names)
      ;; The fanout below revisits each imported declaration once per importing
      ;; alias; the memo is indexed by that declaration's position in
      ;; `all-decls` and is valid only while this pass' (decls, paths,
      ;; entry-path, path-aware) tuple is fixed.
      (lower-alias-symbol-memo-reset! (ast.ast-decl-list-len (& all-decls)))
      (while (< index count)
        (let
          [decl : ast.AstDecl
            (array-ref
              (struct-get decls slots)
              (+ (struct-get decls offset) index))]
          (begin
            (match decl
              [(ast.AstDecl.Import
                  decl-meta
                  (ast.AstImportSpec.Spec
                    _
                    _
                    (ast.AstMaybeModuleName.Some target-module)
                    (ast.AstMaybeImportAlias.Some alias)
                    _))
                (set!
                  cur-names
                  (lower-name-env-add-module-aliases
                    all-decls
                    all-paths
                    entry-path
                    cur-names
                    target-module
                    (lower-import-alias-key-id cur-module-id alias)
                    cbi.compiler-builtin-id-fix-empty
                    path-aware))]
              [_ unit])
            (match decl
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [_ unit])
            (set! index (+ index 1)))))
      (lower-alias-symbol-memo-release!)
      cur-names)))

(define (lower-name-env-with-import-aliases
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [path-aware : bool]) : LowerNameEnv
  (lower-name-env-from-import-aliases
    decls
    paths
    decls
    paths
    entry-path
    names
    cbi.compiler-builtin-id-fix-empty
    path-aware))

(define (lower-name-env-from-import-aliases-in-module-cache
  [all-decls : ast.AstDeclList]
  [decls : ast.AstDeclList]
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [dedup-base : bool]
  [target-current-module-id : i64]
  [_current-module-id : i64]) : LowerNameEnv
  (let
    [cur-names : LowerNameEnv names]
    [_ensure : unit (lower-module-decl-index-ensure! decls)]
    [slot : i64 (lower-module-decl-index-slot target-current-module-id)]
    (begin
      ;; `names` is always a fresh (empty) overlay here, so seed the overlay
      ;; membership set empty; it then mirrors every alias bound below.
      (lower-alias-overlay-reset!)
      (if (< slot 0)
        cur-names
        (let
          [j : i64 (array-ref lower-module-decl-index-starts slot)]
          [end : i64 (array-ref lower-module-decl-index-ends slot)]
          (begin
            (while (< j end)
              (let
                [decl : ast.AstDecl
                  (array-ref
                    (struct-get decls slots)
                    (+
                      (struct-get decls offset)
                      (array-ref lower-module-decl-index-positions j)))]
                (begin
                  (match decl
                    [(ast.AstDecl.Import
                        decl-meta
                        (ast.AstImportSpec.Spec
                          _
                          _
                          (ast.AstMaybeModuleName.Some target-module)
                          (ast.AstMaybeImportAlias.Some alias)
                          _))
                      (set!
                        cur-names
                        (lower-name-env-add-module-aliases-cache
                          all-decls
                          base-cache
                          dedup-base
                          cur-names
                          target-module
                          alias
                          cbi.compiler-builtin-id-fix-empty))]
                    [_ unit])
                  (set! j (+ j 1)))))
            cur-names))))))

(define (lower-name-env-with-import-aliases-in-module-cache
  [decls : ast.AstDeclList]
  [names : LowerNameEnv]
  [base-cache : LowerNameCache]
  [module-id : i64]) : LowerNameEnv
  ;; Build aliases into a fresh overlay so empty-alias duplicate checks do not
  ;; rescan the whole base env for every imported decl.
  (let
    [dedup-base : bool
      (match names
        [(LowerNameEnv.Nil) false]
        [_ true])]
    [overlay : LowerNameEnv
      (lower-name-env-from-import-aliases-in-module-cache
        decls
        decls
        LowerNameEnv.Nil
        base-cache
        dedup-base
        module-id
        cbi.compiler-builtin-id-fix-empty)]
    (match names
      [(LowerNameEnv.Nil) overlay]
      [_ (lower-name-env-append overlay names)])))

;; `names` is the env to bind onto; `resolve-env` is the env used to
;; resolve dispatch logical names (the only case that consults an env rather than
;; the name cache). For the normal full build the two are identical. The
;; module-local-only overlay build passes a fresh `names` base but the full env
;; as `resolve-env`, so dispatch names still resolve against all in-scope
;; bindings while only the module-local additions are accumulated.
(define (lower-name-env-add-local-decl-resolve
  [names : LowerNameEnv]
  [resolve-env : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [decl : ast.AstDecl]) : LowerNameEnv
  (match decl
    [(ast.AstDecl.Def decl-meta name _ _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-bind-cached-logical-id
          name
          (lower-current-decl-logical-name-cache-id
            name-cache
            module
            name-str
            name)
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name))
          name-cache
          names))]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-bind-cached-logical-id
          name
          (lower-current-decl-logical-name-cache-id
            name-cache
            module
            name-str
            name)
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name))
          name-cache
          names))]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        (lower-name-env-bind-cached-logical-id
          name
          (lower-current-decl-logical-name-id
            resolve-env
            module
            (struct-get name-cache module-id)
            name-str
            name)
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name))
          name-cache
          names))]
    [(ast.AstDecl.Extern decl-meta name _ metadata _)
      (let
        [name-str : String (tc_core.tc-env-key-name-text name)]
        [logical-id : i64
          (lower-name-cache-lookup-logical-id
            (& name-cache)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name)
            (lower-module-name-key-id-by-id
              (struct-get name-cache module-id)
              name))]
        [logical-name : String
          (csym.compiler-symbol-module-key module name-str)]
        (lower-name-env-bind-ids
          name
          logical-id
          (lower-derived-symbol-id logical-name)
          names))]
    [(ast.AstDecl.DefEnum decl-meta _ cleanup _)
      (lower-name-env-add-local-enum-cleanup names name-cache module cleanup)]
    [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ cleanup _)
      (lower-name-env-add-local-enum-cleanup names name-cache module cleanup)]
    [(ast.AstDecl.DefStruct decl-meta _ _ cleanup _)
      (lower-name-env-add-local-struct-cleanup names name-cache module cleanup)]
    [(ast.AstDecl.DefStructLifetimes decl-meta _ _ _ cleanup _)
      (lower-name-env-add-local-struct-cleanup names name-cache module cleanup)]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-name-env-add-local-decl-resolve
          names
          resolve-env
          name-cache
          module
          inner))]
    [_ names]))

(define (lower-module-local-type-envs-bind-qualified
  [top-env : tc_core.TcTypeEnv]
  [env : tc_core.TcTypeEnv]
  [local-env : tc_core.TcTypeEnv]
  [module : i64]
  [name-id : i64]) : ResultLowerModuleTypeEnvs
  (match (tc_core.tc-lookup-id
    top-env
    (csym.compiler-symbol-module-key-id-by-id module name-id))
    [(tc_core.ResultTcType.Ok ty)
      (ResultLowerModuleTypeEnvs.Ok
        (tc_core.tc-bind-id env name-id ty)
        (tc_core.tc-bind-id local-env name-id ty))]
    [(tc_core.ResultTcType.Err message) (ResultLowerModuleTypeEnvs.Err message)]))

(define (lower-module-local-type-envs-bind-qualified-id-if-free
  [top-env : tc_core.TcTypeEnv]
  [env : tc_core.TcTypeEnv]
  [local-env : tc_core.TcTypeEnv]
  [module : i64]
  [name-id : i64]) : ResultLowerModuleTypeEnvs
  (match (tc_core.tc-lookup-id
    top-env
    (csym.compiler-symbol-module-key-id-by-id module name-id))
    [(tc_core.ResultTcType.Ok ty)
      (ResultLowerModuleTypeEnvs.Ok
        (tc_core.tc-bind-alias-id-if-free env name-id ty)
        (tc_core.tc-bind-alias-id-if-free local-env name-id ty))]
    [(tc_core.ResultTcType.Err message) (ResultLowerModuleTypeEnvs.Err message)]))

(define (lower-module-local-type-envs-add-variants
  [top-env : tc_core.TcTypeEnv]
  [env : tc_core.TcTypeEnv]
  [local-env : tc_core.TcTypeEnv]
  [module : i64]
  [variants : ast.AstVariantDefList]) : ResultLowerModuleTypeEnvs
  (lower-module-local-type-envs-add-variants-at
    top-env
    env
    local-env
    module
    (& variants)
    0))

(define (lower-module-local-type-envs-add-variants-at
  [top-env : tc_core.TcTypeEnv]
  [env : tc_core.TcTypeEnv]
  [local-env : tc_core.TcTypeEnv]
  [module : i64]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]) : ResultLowerModuleTypeEnvs
  (if (>= index (struct-get variants len))
    (ResultLowerModuleTypeEnvs.Ok env local-env)
    (match (ast.ast-variant-def-list-get
      variants
      index
      (ast.ast-variant-def-fallback))
      [(ast.AstVariantDef.Def name _ _)
        (match (lower-module-local-type-envs-bind-qualified-id-if-free
          top-env
          env
          local-env
          module
          name)
          [(ResultLowerModuleTypeEnvs.Ok next-env next-local-env)
            (lower-module-local-type-envs-add-variants-at
              top-env
              next-env
              next-local-env
              module
              variants
              (+ index 1))]
          [(ResultLowerModuleTypeEnvs.Err message)
            (ResultLowerModuleTypeEnvs.Err message)])])))

(define (lower-module-local-type-envs-add-decl
  [top-env : tc_core.TcTypeEnv]
  [env : tc_core.TcTypeEnv]
  [local-env : tc_core.TcTypeEnv]
  [module : i64]
  [decl : ast.AstDecl]) : ResultLowerModuleTypeEnvs
  (match decl
    [(ast.AstDecl.Def decl-meta name _ _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(ast.AstDecl.DefDispatch decl-meta name _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(ast.AstDecl.Extern decl-meta name _ _ _)
      (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)]
    [(ast.AstDecl.DefEnum decl-meta _ cleanup variants)
      (match (lower-module-local-type-envs-add-variants
        top-env
        env
        local-env
        module
        variants)
        [(ResultLowerModuleTypeEnvs.Ok next-env next-local-env)
          (match cleanup
            [(ast.AstEnumCleanup.No)
              (ResultLowerModuleTypeEnvs.Ok next-env next-local-env)]
            [(ast.AstEnumCleanup.Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                cleanup-name)])]
        [(ResultLowerModuleTypeEnvs.Err message)
          (ResultLowerModuleTypeEnvs.Err message)])]
    [(ast.AstDecl.DefEnumLifetimes decl-meta _ _ cleanup variants)
      (match (lower-module-local-type-envs-add-variants
        top-env
        env
        local-env
        module
        variants)
        [(ResultLowerModuleTypeEnvs.Ok next-env next-local-env)
          (match cleanup
            [(ast.AstEnumCleanup.No)
              (ResultLowerModuleTypeEnvs.Ok next-env next-local-env)]
            [(ast.AstEnumCleanup.Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                cleanup-name)])]
        [(ResultLowerModuleTypeEnvs.Err message)
          (ResultLowerModuleTypeEnvs.Err message)])]
    [(ast.AstDecl.DefStruct decl-meta name _ cleanup _)
      (match (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)
        [(ResultLowerModuleTypeEnvs.Ok next-env next-local-env)
          (match cleanup
            [(ast.AstStructCleanup.No)
              (ResultLowerModuleTypeEnvs.Ok next-env next-local-env)]
            [(ast.AstStructCleanup.Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                cleanup-name)])]
        [(ResultLowerModuleTypeEnvs.Err message)
          (ResultLowerModuleTypeEnvs.Err message)])]
    [(ast.AstDecl.DefStructLifetimes decl-meta name _ _ cleanup _)
      (match (lower-module-local-type-envs-bind-qualified
        top-env
        env
        local-env
        module
        name)
        [(ResultLowerModuleTypeEnvs.Ok next-env next-local-env)
          (match cleanup
            [(ast.AstStructCleanup.No)
              (ResultLowerModuleTypeEnvs.Ok next-env next-local-env)]
            [(ast.AstStructCleanup.Fn cleanup-name)
              (lower-module-local-type-envs-bind-qualified
                top-env
                next-env
                next-local-env
                module
                cleanup-name)])]
        [(ResultLowerModuleTypeEnvs.Err message)
          (ResultLowerModuleTypeEnvs.Err message)])]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-module-local-type-envs-add-decl
          top-env
          env
          local-env
          module
          inner))]
    [_ (ResultLowerModuleTypeEnvs.Ok env local-env)]))

(define (lower-module-local-envs-list
  [top-env : tc_core.TcTypeEnv]
  [decls : ast.AstDeclList]
  [type-env : tc_core.TcTypeEnv]
  [local-type-env : tc_core.TcTypeEnv]
  [_resolve-names : LowerNameEnv]
  [local-names : LowerNameEnv]
  [_name-cache : LowerNameCache]
  [_target-module : String]
  [target-module-id : i64]) : ResultLowerModuleLocalEnv
  (let
    [cur-type-env : tc_core.TcTypeEnv type-env]
    [cur-local-type-env : tc_core.TcTypeEnv local-type-env]
    [cur-local-names : LowerNameEnv local-names]
    [_ensure : unit (lower-module-decl-index-ensure! decls)]
    [slot : i64 (lower-module-decl-index-slot target-module-id)]
    [index : i64
      (if (< slot 0)
        0
        (array-ref lower-module-decl-index-starts slot))]
    [count : i64
      (if (< slot 0)
        0
        (array-ref lower-module-decl-index-ends slot))]
    [decl-offset : i64 (struct-get decls offset)]
    [result : ResultLowerModuleLocalEnv
      (ResultLowerModuleLocalEnv.Err "lower: module local env walk")]
    [done : bool false]
    (begin
      (while (and (not done) (< index count))
        (let
          [decl : ast.AstDecl
            (array-ref
              (struct-get decls slots)
              (+
                decl-offset
                (array-ref lower-module-decl-index-positions index)))]
          (begin
            (match decl
              [(ast.AstDecl.Module _) unit]
              [_
                (match (lower-module-local-type-envs-add-decl
                  top-env
                  cur-type-env
                  cur-local-type-env
                  target-module-id
                  decl)
                  [(ResultLowerModuleTypeEnvs.Ok
                      next-type-env
                      next-local-type-env)
                    (begin
                      (set! cur-type-env next-type-env)
                      (set! cur-local-type-env next-local-type-env))]
                  [(ResultLowerModuleTypeEnvs.Err message)
                    (begin
                      (set! result (ResultLowerModuleLocalEnv.Err message))
                      (set! done true))])])
            (set! index (+ index 1)))))
      (if done
        result
        (ResultLowerModuleLocalEnv.Ok
          cur-type-env
          cur-local-type-env
          cur-local-names)))))

(define (lower-module-local-envs
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [module : String]
  [module-id : i64]) : ResultLowerModuleLocalEnv
  (if (string.eq module "")
    (ResultLowerModuleLocalEnv.Ok
      top-env
      (tc_core.tc-empty-env)
      (LowerNameEnv.Nil))
    (match (tc_core.tc-context-program ctx)
      [(ast.AstProgram.Program decls-box)
        (let
          [decls : ast.AstDeclList (box-get decls-box)]
          ;; The module's import aliases resolve against the global
          ;; name-cache (not the env base), so building them on an empty base
          ;; yields the module-local-only alias env used by the per-module
          ;; name-cache overlay. Unqualified declarations owned by this module
          ;; resolve through the shared cache's canonical module-qualified keys,
          ;; so copying every local declaration into the overlay is redundant.
          [local-alias-names : LowerNameEnv
            (lower-name-env-with-import-aliases-in-module-cache
              decls
              (LowerNameEnv.Nil)
              name-cache
              module-id)]
          (lower-module-local-envs-list
            top-env
            decls
            top-env
            (tc_core.tc-empty-env)
            names
            local-alias-names
            name-cache
            module
            module-id))])))

(define (lower-module-local-view-list-lookup
  [entries : LowerModuleLocalViewList]
  [module-id : i64]) : LowerMaybeModuleLocalView
  (match entries
    [(LowerModuleLocalViewList.Nil) (LowerMaybeModuleLocalView.No)]
    [(LowerModuleLocalViewList.Cons entry-module-id view rest)
      (if (= entry-module-id module-id)
        (LowerMaybeModuleLocalView.Some view)
        (lower-module-local-view-list-lookup (box-get rest) module-id))]))

(define (lower-active-module-local-view-insert!
  [module-id : i64]
  [view : LowerModuleLocalView]) : unit
  (set!
    lower-active-module-local-views
    (LowerModuleLocalViewList.Cons
      module-id
      view
      (box lower-active-module-local-views))))

(define (lower-module-local-view-cached
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [names : LowerNameEnv]
  [module : String]
  [module-id : i64]) : ResultLowerModuleLocalView
  (match (lower-module-local-view-list-lookup
    (lower-global-shared-view lower-active-module-local-views)
    module-id)
    [(LowerMaybeModuleLocalView.Some view) (ResultLowerModuleLocalView.Ok view)]
    [(LowerMaybeModuleLocalView.No)
      (match (lower-module-local-envs
        ctx
        top-env
        names
        (lower-global-shared-view lower-active-global-name-cache)
        module
        module-id)
        [(ResultLowerModuleLocalEnv.Ok
            local-top-env
            local-type-env
            local-name-only)
          (let
            [view : LowerModuleLocalView
              (LowerModuleLocalView
                local-top-env
                (lower-name-cache-overlay local-name-only module-id)
                (lower-type-cache-overlay local-type-env))]
            (begin
              (lower-active-module-local-view-insert! module-id view)
              (ResultLowerModuleLocalView.Ok view)))]
        [(ResultLowerModuleLocalEnv.Err message)
          (ResultLowerModuleLocalView.Err message)])]))

(define (lower-id-set-empty) : LowerIdSet
  (LowerIdSet (make-array i64 0) 0))

(define (lower-id-set-contains? [items : LowerIdSet] [name : i64]) : bool
  (let
    [index : i64 (struct-get items len)]
    [found : bool false]
    (begin
      (while (and (not found) (> index 0))
        (begin
          (set! index (- index 1))
          (if (= (array-ref (struct-get items slots) index) name)
            (set! found true)
            unit)))
      found)))

(define (lower-id-set-insert [items : LowerIdSet] [name : i64]) : LowerIdSet
  (if (lower-id-set-contains? items name)
    items
    (let
      [len : i64 (struct-get items len)]
      [slots : (__tl_dyn-array i64) (make-array i64 (+ len 1))]
      [index : i64 0]
      (begin
        (while (< index len)
          (begin
            (array-set! slots index (array-ref (struct-get items slots) index))
            (set! index (+ index 1))))
        (array-set! slots len name)
        (LowerIdSet slots (+ len 1))))))

;; Stack push for the reach worklist only: that state is threaded linearly, so
;; the backing array is reused instead of copied. Popping just shrinks `len`,
;; which is why the spare tail slot is overwritten in place when it exists.
(define (lower-id-set-push [items : LowerIdSet] [name : i64]) : LowerIdSet
  (let
    [slots : (__tl_dyn-array i64) (struct-get items slots)]
    [len : i64 (struct-get items len)]
    (begin
      (if (< len (array-length slots))
        (array-set! slots len name)
        (array-push! slots name))
      (LowerIdSet slots (+ len 1)))))

(define (lower-spmd-inline-empty-helper-stack) : LowerIdSet
  (lower-id-set-empty))

(define lower-spmd-inline-helper-stack : LowerIdSet
  (lower-spmd-inline-empty-helper-stack))
(define lower-spmd-inline-recursion-detected : bool
  false)
(define lower-spmd-inline-next-temp : i64
  0)
(define lower-spmd-scalar-call-context : LowerSpmdScalarCallContext
  (LowerSpmdScalarCallContext.No))

(define (lower-reset-file-state!) : unit
  (begin
    (lower-canonical-path-memo-reset!)
    (set! lower-entry-main-module-active false)
    (set! lower-entry-main-module "")
    (set! lower-entry-main-module-id cbi.compiler-builtin-id-fix-empty)
    (set! lower-spmd-inline-helper-stack (lower-spmd-inline-empty-helper-stack))
    (set! lower-spmd-inline-recursion-detected false)
    (set! lower-spmd-inline-next-temp 0)
    (set! lower-spmd-scalar-call-context (LowerSpmdScalarCallContext.No))
    (lower-reach-scratch-globals-reset!)
    (lower-module-decl-index-reset!)))

(define (lower-reset-intern-owned-state!) : unit
  (tc_core.compiler-typecheck-reset-intern-owned-state!))

(define (lower-context-expr-get [ctx : tc_core.TcContext] [id : i64]) : ast.AstExpr
  (tc_core.tc-context-expr-get ctx id))

(define (lower-context-expr-push [ctx : tc_core.TcContext] [expr : ast.AstExpr]) : i64
  (ast.ast-node-pool-context-expr-push (tc_core.tc-context-pools ctx) expr))

(define (lower-spmd-inline-recursive-message) : String
  "lower: recursive SPMD helper call is not supported")

(define (lower-spmd-inline-fresh-local-id [source-name-id : i64]) : i64
  (let
    [next : i64 lower-spmd-inline-next-temp]
    (begin
      (set! lower-spmd-inline-next-temp (+ lower-spmd-inline-next-temp 1))
      (ci.intern-structural-local-id
        next
        (tc_core.macro-hygiene-global-source-name-id-or
          source-name-id
          source-name-id)))))

(define (lower-spmd-inline-subst-empty) : LowerSpmdInlineSubst
  (LowerSpmdInlineSubst (make-array i64 0) (make-array ast.AstExpr 0) 0))

(define (lower-spmd-inline-subst-lookup
  [subs : LowerSpmdInlineSubst]
  [name : i64]) : LowerMaybeAstExpr
  (let
    [index : i64 (struct-get subs len)]
    [found : i64 -1]
    (begin
      (while (> index 0)
        (begin
          (set! index (- index 1))
          (if (= (array-ref (struct-get subs names) index) name)
            (begin
              (set! found index)
              (set! index 0))
            unit)))
      (if (< found 0)
        (LowerMaybeAstExpr.No)
        (LowerMaybeAstExpr.Some (array-ref (struct-get subs values) found))))))

(define (lower-spmd-inline-subst-remove
  [subs : LowerSpmdInlineSubst]
  [name : i64]) : LowerSpmdInlineSubst
  (let
    [len : i64 (struct-get subs len)]
    [names : (__tl_dyn-array i64) (make-array i64 len)]
    [values : (__tl_dyn-array ast.AstExpr) (make-array ast.AstExpr len)]
    [index : i64 0]
    [kept : i64 0]
    (begin
      (while (< index len)
        (begin
          (if (= (array-ref (struct-get subs names) index) name)
            unit
            (begin
              (array-set! names kept (array-ref (struct-get subs names) index))
              (array-set!
                values
                kept
                (array-ref (struct-get subs values) index))
              (set! kept (+ kept 1))))
          (set! index (+ index 1))))
      (LowerSpmdInlineSubst names values kept))))

(define (lower-spmd-inline-subst-cons
  [name : i64]
  [value : ast.AstExpr]
  [rest : LowerSpmdInlineSubst]) : LowerSpmdInlineSubst
  (let
    [len : i64 (struct-get rest len)]
    [names : (__tl_dyn-array i64) (make-array i64 (+ len 1))]
    [values : (__tl_dyn-array ast.AstExpr) (make-array ast.AstExpr (+ len 1))]
    [index : i64 0]
    (begin
      (while (< index len)
        (begin
          (array-set! names index (array-ref (struct-get rest names) index))
          (array-set! values index (array-ref (struct-get rest values) index))
          (set! index (+ index 1))))
      (array-set! names len name)
      (array-set! values len value)
      (LowerSpmdInlineSubst names values (+ len 1)))))

(define (lower-spmd-inline-helper-from-decl
  [ctx : tc_core.TcContext]
  [handle : i64]
  [decl : ast.AstDecl]) : ResultLowerSpmdInlineHelper
  (match decl
    [(ast.AstDecl.DefFn decl-meta _ params ret body-box _)
      (let
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (ResultLowerSpmdInlineHelper.Ok
          (LowerSpmdInlineHelper.Some handle params ret body)))]
    [(ast.AstDecl.Extern _ _ (ast.AstExternKind.Function) metadata ty)
      (match (ast.ast-extern-metadata-imported-spmd (box-get metadata))
        [(ast.AstImportedSpmdMetadata.No)
          (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))]
        [(ast.AstImportedSpmdMetadata.Package canonical-name callables)
          (ResultLowerSpmdInlineHelper.Ok
            (LowerSpmdInlineHelper.Imported canonical-name ty callables))])]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-spmd-inline-helper-from-decl ctx handle inner))]
    [_ (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))]))

(define (lower-spmd-inline-helper-lookup
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [shadowed : LowerIdSet]
  [func : ast.AstExpr]) : ResultLowerSpmdInlineHelper
  (lower-spmd-inline-helper-lookup-resolved
    ctx
    func
    (lower-spmd-inline-helper-name-id ctx env type-env shadowed func)))

(define (lower-spmd-inline-helper-name-id
  [ctx : tc_core.TcContext]
  [_env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [shadowed : LowerIdSet]
  [func : ast.AstExpr]) : tc_core.TcNameLookup
  (match (ast.ast-expr-unspan-with-pools (tc_core.tc-context-pools ctx) func)
    [(ast.AstExpr.Var raw-name)
      (let
        [source-id : i64
          (tc_core.macro-hygiene-global-source-name-id-or raw-name raw-name)]
        [raw-text : String (ci.intern-str source-id)]
        (cond
          [(lower-id-set-contains? shadowed raw-name)
            (tc_core.TcNameLookup.Err "")]
          [(tc_core.macro-hygiene-global-id? raw-name)
            (tc_core.TcNameLookup.Ok
              (lower-hygiene-source-name-in-context-id ctx type-env raw-name)
              source-id)]
          [(tc_core.tc-hygiene-global-name? raw-text)
            (tc_core.TcNameLookup.Ok
              (tc_core.tc-hygiene-global-call-name raw-text)
              source-id)]
          [(tc_core.tc-source-slash-qualified-id? raw-text source-id)
            (tc_core.TcNameLookup.Ok raw-text source-id)]
          [else
            (tc_core.tc-source-name-lookup-key-with-field-check-lookup
              ctx
              type-env
              raw-text
              source-id
              true)]))]
    [_ (tc_core.TcNameLookup.Err "")]))

(define (lower-spmd-inline-helper-lookup-resolved
  [ctx : tc_core.TcContext]
  [func : ast.AstExpr]
  [resolved : tc_core.TcNameLookup]) : ResultLowerSpmdInlineHelper
  (match resolved
    [(tc_core.TcNameLookup.Ok name lookup-id)
      (if (string.eq name "")
        (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))
        (let
          [handle : i64
            (csym.compiler-symbols-lookup-value-id-or
              (tc_core.tc-context-symbols ctx)
              lookup-id
              (csym.compiler-symbols-missing-handle))]
          (cond
            [(not (csym.compiler-symbols-handle-found? handle))
              (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))]
            [(and
                (=
                  (csym.compiler-symbol-handle-kind handle)
                  (csym.compiler-symbol-kind-function-define))
                (lower-id-set-contains?
                  (lower-global-shared-view lower-spmd-inline-helper-stack)
                  handle))
              (begin
                (set! lower-spmd-inline-recursion-detected true)
                (ResultLowerSpmdInlineHelper.Err
                  (box
                    (lower-diagnostic-at-expr
                      func
                      (lower-spmd-inline-recursive-message)))))]
            [(or
                (=
                  (csym.compiler-symbol-handle-kind handle)
                  (csym.compiler-symbol-kind-function-define))
                (=
                  (csym.compiler-symbol-handle-kind handle)
                  (csym.compiler-symbol-kind-extern)))
              (match (csym.compiler-symbols-decl-at-index
                (tc_core.tc-context-symbols ctx)
                (csym.compiler-symbol-handle-index handle))
                [(parser.ResultAstDecl.Ok decl)
                  (lower-spmd-inline-helper-from-decl ctx handle decl)]
                [(parser.ResultAstDecl.Err message)
                  (ResultLowerSpmdInlineHelper.Err
                    (box (lower-diagnostic message)))])]
            [else (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))])))]
    [(tc_core.TcNameLookup.Err message)
      (if (string.eq message "")
        (ResultLowerSpmdInlineHelper.Ok (LowerSpmdInlineHelper.No))
        (ResultLowerSpmdInlineHelper.Err
          (box (lower-diagnostic-at-expr func message))))]))

(define (lower-spmd-inline-build-subst
  [ctx : tc_core.TcContext]
  [params : ast.AstParamList]
  [args : ast.AstExprList]
  [subst : LowerSpmdInlineSubst]
  [origin : ast.AstExpr]) : ResultLowerSpmdInlineSubst
  (lower-spmd-inline-build-subst-at ctx (& params) (& args) 0 subst origin))

(define (lower-spmd-inline-build-subst-at
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]
  [index : i64]
  [subst : LowerSpmdInlineSubst]
  [origin : ast.AstExpr]) : ResultLowerSpmdInlineSubst
  (cond
    [(>= index (ast.ast-param-list-len params))
      (if (= index (struct-get args len))
        (ResultLowerSpmdInlineSubst.Ok subst)
        (ResultLowerSpmdInlineSubst.Err
          (box (lower-diagnostic-at-expr origin "lower: arity mismatch"))))]
    [(>= index (struct-get args len))
      (ResultLowerSpmdInlineSubst.Err
        (box (lower-diagnostic-at-expr origin "lower: arity mismatch")))]
    [else
      (let
        [arg-id : i64 (ast.ast-expr-list-get args index 0)]
        [arg : ast.AstExpr (lower-context-expr-get ctx arg-id)]
        (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
          [(ast.AstParam.Param param-name _ _ _)
            (lower-spmd-inline-build-subst-at
              ctx
              params
              args
              (+ index 1)
              (lower-spmd-inline-subst-cons param-name arg subst)
              origin)]))]))

(define (lower-spmd-inline-arg-subst
  [ctx : tc_core.TcContext]
  [params : ast.AstParamList]
  [args : ast.AstExprList]
  [origin : ast.AstExpr]) : ResultLowerSpmdInlineSubst
  (lower-spmd-inline-build-subst
    ctx
    params
    args
    (lower-spmd-inline-subst-empty)
    origin))

(define (lower-spmd-inline-expr-list
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]) : ResultLowerAstExprList
  (let
    [out : ast.AstExprList
      (ast.ast-expr-list-with-capacity (struct-get (& exprs) len))]
    (match (lower-spmd-inline-expr-list-into
      ctx
      env
      type-env
      (& exprs)
      0
      subst
      shadowed
      (&mut out))
      [(ResultLowerAstExprList.Ok _) (ResultLowerAstExprList.Ok out)]
      [(ResultLowerAstExprList.Err diag) (ResultLowerAstExprList.Err diag)])))

(define (lower-spmd-inline-expr-list-into
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]
  [out : (&mut out ast.AstExprList)]) : ResultLowerAstExprList
  (if (>= index (struct-get exprs len))
    (ResultLowerAstExprList.Ok (ast.ast-expr-list-new))
    (let
      [head-id : i64 (ast.ast-expr-list-get exprs index 0)]
      [head : ast.AstExpr (lower-context-expr-get ctx head-id)]
      (match (lower-spmd-inline-expr ctx env type-env head subst shadowed)
        [(ResultLowerAstExpr.Ok rewritten-head)
          (begin
            (ast.ast-expr-list-push
              out
              (lower-context-expr-push ctx rewritten-head))
            (lower-spmd-inline-expr-list-into
              ctx
              env
              type-env
              exprs
              (+ index 1)
              subst
              shadowed
              out))]
        [(ResultLowerAstExpr.Err diag) (ResultLowerAstExprList.Err diag)]))))

(define (lower-spmd-inline-let-bindings
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : ast.AstLetBindingList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]) : ResultLowerSpmdInlineLetBindings
  (let
    [out : ast.AstLetBindingList
      (ast.ast-let-binding-list-with-capacity
        (ast.ast-let-binding-list-len (& bindings)))]
    (match (lower-spmd-inline-let-bindings-into
      ctx
      env
      type-env
      (& bindings)
      subst
      shadowed
      0
      (&mut out))
      [(ResultLowerSpmdInlineLetBindingsBuild.Ok body-subst body-shadowed)
        (ResultLowerSpmdInlineLetBindings.Ok
          (LowerSpmdInlineLetBindings.Bindings out body-subst body-shadowed))]
      [(ResultLowerSpmdInlineLetBindingsBuild.Err diag)
        (ResultLowerSpmdInlineLetBindings.Err diag)])))

(define (lower-spmd-inline-let-bindings-into
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]
  [index : i64]
  [out : (&mut out ast.AstLetBindingList)]) : ResultLowerSpmdInlineLetBindingsBuild
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (ResultLowerSpmdInlineLetBindingsBuild.Ok subst shadowed)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [renamed : bool (> (struct-get subst len) 0)]
          [bind-id : i64
            (if renamed
              (lower-spmd-inline-fresh-local-id name)
              name)]
          (match (lower-spmd-inline-expr ctx env type-env init subst shadowed)
            [(ResultLowerAstExpr.Ok rewritten-init)
              (begin
                (ast.ast-let-binding-list-push
                  out
                  (ast.ast-let-binding-id
                    bind-id
                    maybe-ty
                    (lower-context-expr-push ctx rewritten-init)))
                (lower-spmd-inline-let-bindings-into
                  ctx
                  env
                  type-env
                  bindings
                  (if renamed
                    (lower-spmd-inline-subst-cons
                      name
                      (ast.AstExpr.Var bind-id)
                      (lower-spmd-inline-subst-remove subst name))
                    (lower-spmd-inline-subst-remove subst name))
                  (lower-id-set-insert shadowed name)
                  (+ index 1)
                  out))]
            [(ResultLowerAstExpr.Err diag)
              (ResultLowerSpmdInlineLetBindingsBuild.Err diag)]))])))

(define (lower-spmd-inline-helper-body
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [handle : i64]
  [params : ast.AstParamList]
  [args : ast.AstExprList]
  [body : ast.AstExpr]
  [origin : ast.AstExpr]) : ResultLowerAstExpr
  (match (lower-spmd-inline-arg-subst ctx params args origin)
    [(ResultLowerSpmdInlineSubst.Ok helper-subst)
      (let
        [previous : LowerIdSet
          (lower-global-shared-view lower-spmd-inline-helper-stack)]
        [result : ResultLowerAstExpr
          (ResultLowerAstExpr.Err
            (box
              (lower-diagnostic-at-expr
                origin
                (lower-spmd-inline-recursive-message))))]
        (begin
          (set!
            lower-spmd-inline-helper-stack
            (lower-id-set-insert previous handle))
          (set!
            result
            (lower-spmd-inline-expr
              ctx
              env
              type-env
              body
              helper-subst
              (lower-id-set-empty)))
          (set! lower-spmd-inline-helper-stack previous)
          result))]
    [(ResultLowerSpmdInlineSubst.Err diag) (ResultLowerAstExpr.Err diag)]))

;; Keep the established small-helper rewrite, but stop cloning larger helper
;; bodies into every vector call site. The limit is deliberately an internal
;; lowering choice: it does not add a source attribute or public varying type.
(define lower-spmd-inline-node-limit : i64
  12)

(define (lower-spmd-inline-expr-list-cost
  [ctx : tc_core.TcContext]
  [exprs : ast.AstExprList]) : i64
  (lower-spmd-inline-expr-list-cost-at ctx (& exprs) 0))

(define (lower-spmd-inline-expr-list-cost-at
  [ctx : tc_core.TcContext]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : i64
  (if (>= index (struct-get exprs len))
    0
    (+
      (lower-spmd-inline-expr-cost
        ctx
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      (lower-spmd-inline-expr-list-cost-at ctx exprs (+ index 1)))))

(define (lower-spmd-inline-let-cost
  [ctx : tc_core.TcContext]
  [bindings : ast.AstLetBindingList]) : i64
  (lower-spmd-inline-let-cost-at ctx (& bindings) 0))

(define (lower-spmd-inline-let-cost-at
  [ctx : tc_core.TcContext]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : i64
  (if (>= index (ast.ast-let-binding-list-len bindings))
    0
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ init-box)
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx init-box))
          (lower-spmd-inline-let-cost-at ctx bindings (+ index 1)))])))

(define (lower-spmd-inline-expr-cost
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Unary _ inner-box)
      (+
        1
        (lower-spmd-inline-expr-cost ctx (lower-context-expr-get ctx inner-box)))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx left-box))
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx right-box))))]
    [(ast.AstExpr.Call func-box args)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx func-box))
          (lower-spmd-inline-expr-list-cost ctx args)))]
    [(ast.AstExpr.If cond-box then-box else-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx cond-box))
          (+
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx then-box))
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx else-box)))))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (+
            1
            (+
              (lower-spmd-inline-let-cost ctx bindings)
              (lower-spmd-inline-expr-cost
                ctx
                (lower-context-expr-get ctx body-box))))])]
    [(ast.AstExpr.Begin exprs)
      (+ 1 (lower-spmd-inline-expr-list-cost ctx exprs))]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx array-box))
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx index-box))))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (+
        1
        (+
          (lower-spmd-inline-expr-cost
            ctx
            (lower-context-expr-get ctx array-box))
          (+
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx index-box))
            (lower-spmd-inline-expr-cost
              ctx
              (lower-context-expr-get ctx value-box)))))]
    [_ 1]))

(define (lower-spmd-helper-out-of-line?
  [ctx : tc_core.TcContext]
  [body : ast.AstExpr]) : bool
  (> (lower-spmd-inline-expr-cost ctx body) lower-spmd-inline-node-limit))

(define (lower-spmd-preserve-call
  [ctx : tc_core.TcContext]
  [func : ast.AstExpr]
  [rewritten-args : ast.AstExprList]) : ResultLowerAstExpr
  (ResultLowerAstExpr.Ok
    (lower-context-expr-get
      ctx
      (ast.ast-expr-call-with-pools
        (tc_core.tc-context-pools ctx)
        (lower-context-expr-push ctx func)
        rewritten-args))))

(define (lower-spmd-inline-call
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]
  [origin : ast.AstExpr]) : ResultLowerAstExpr
  (match (lower-spmd-inline-expr-list ctx env type-env args subst shadowed)
    [(ResultLowerAstExprList.Ok rewritten-args)
      (match (lower-spmd-inline-helper-lookup ctx env type-env shadowed func)
        [(ResultLowerSpmdInlineHelper.Ok helper)
          (match helper
            [(LowerSpmdInlineHelper.Some name params _ body)
              (if (lower-spmd-helper-out-of-line? ctx body)
                (lower-spmd-preserve-call ctx func rewritten-args)
                (lower-spmd-inline-helper-body
                  ctx
                  env
                  type-env
                  name
                  params
                  rewritten-args
                  body
                  origin))]
            [(LowerSpmdInlineHelper.Imported _ _ _)
              (lower-spmd-preserve-call ctx func rewritten-args)]
            [(LowerSpmdInlineHelper.No)
              (match (lower-spmd-inline-expr
                ctx
                env
                type-env
                func
                subst
                shadowed)
                [(ResultLowerAstExpr.Ok rewritten-func)
                  (ResultLowerAstExpr.Ok
                    (lower-context-expr-get
                      ctx
                      (ast.ast-expr-call-with-pools
                        (tc_core.tc-context-pools ctx)
                        (lower-context-expr-push ctx rewritten-func)
                        rewritten-args)))]
                [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])])]
        [(ResultLowerSpmdInlineHelper.Err diag) (ResultLowerAstExpr.Err diag)])]
    [(ResultLowerAstExprList.Err diag) (ResultLowerAstExpr.Err diag)]))

(define (lower-spmd-inline-expr
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [subst : LowerSpmdInlineSubst]
  [shadowed : LowerIdSet]) : ResultLowerAstExpr
  (match expr
    [(ast.AstExpr.Spanned inner-box span)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten)
            (ResultLowerAstExpr.Ok
              (lower-context-expr-get
                ctx
                (ast.ast-expr-spanned-with-pools
                  (tc_core.tc-context-pools ctx)
                  (lower-context-expr-push ctx rewritten)
                  span)))]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.Var name)
      (match (lower-spmd-inline-subst-lookup subst name)
        [(LowerMaybeAstExpr.Some value) (ResultLowerAstExpr.Ok value)]
        [(LowerMaybeAstExpr.No) (ResultLowerAstExpr.Ok expr)])]
    [(ast.AstExpr.Binary op left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (match (lower-spmd-inline-expr ctx env type-env left subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-left)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              right
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-right)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast.ast-expr-binary-with-pools
                      (tc_core.tc-context-pools ctx)
                      op
                      (lower-context-expr-push ctx rewritten-left)
                      (lower-context-expr-push ctx rewritten-right))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.Unary op inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten)
            (ResultLowerAstExpr.Ok
              (lower-context-expr-get
                ctx
                (ast.ast-expr-unary-with-pools
                  (tc_core.tc-context-pools ctx)
                  op
                  (lower-context-expr-push ctx rewritten))))]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (lower-spmd-inline-call ctx env type-env func args subst shadowed expr))]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (match (lower-spmd-inline-expr ctx env type-env cond subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-cond)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              then-branch
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-then)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  else-branch
                  subst
                  shadowed)
                  [(ResultLowerAstExpr.Ok rewritten-else)
                    (ResultLowerAstExpr.Ok
                      (lower-context-expr-get
                        ctx
                        (ast.ast-expr-if-with-pools
                          (tc_core.tc-context-pools ctx)
                          (lower-context-expr-push ctx rewritten-cond)
                          (lower-context-expr-push ctx rewritten-then)
                          (lower-context-expr-push ctx rewritten-else))))]
                  [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-spmd-inline-let-bindings
              ctx
              env
              type-env
              bindings
              subst
              shadowed)
              [(ResultLowerSpmdInlineLetBindings.Ok rewritten)
                (match rewritten
                  [(LowerSpmdInlineLetBindings.Bindings
                      rewritten-bindings
                      body-subst
                      body-shadowed)
                    (match (lower-spmd-inline-expr
                      ctx
                      env
                      type-env
                      body
                      body-subst
                      body-shadowed)
                      [(ResultLowerAstExpr.Ok rewritten-body)
                        (ResultLowerAstExpr.Ok
                          (lower-context-expr-get
                            ctx
                            (ast.ast-expr-let-with-pools
                              (tc_core.tc-context-pools ctx)
                              rewritten-bindings
                              (lower-context-expr-push ctx rewritten-body))))]
                      [(ResultLowerAstExpr.Err diag)
                        (ResultLowerAstExpr.Err diag)])])]
              [(ResultLowerSpmdInlineLetBindings.Err diag)
                (ResultLowerAstExpr.Err diag)]))])]
    [(ast.AstExpr.Begin exprs)
      (match (lower-spmd-inline-expr-list ctx env type-env exprs subst shadowed)
        [(ResultLowerAstExprList.Ok rewritten)
          (ResultLowerAstExpr.Ok (ast.AstExpr.Begin rewritten))]
        [(ResultLowerAstExprList.Err diag) (ResultLowerAstExpr.Err diag)])]
    [(ast.AstExpr.Ann inner-box ty-id)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten)
            (ResultLowerAstExpr.Ok
              (lower-context-expr-get
                ctx
                (ast.ast-expr-ann-with-pools-id
                  (tc_core.tc-context-pools ctx)
                  (lower-context-expr-push ctx rewritten)
                  ty-id)))]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.Cast inner-box ty-id)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (lower-spmd-inline-expr ctx env type-env inner subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten)
            (ResultLowerAstExpr.Ok
              (lower-context-expr-get
                ctx
                (ast.ast-expr-cast-with-pools-id
                  (tc_core.tc-context-pools ctx)
                  (lower-context-expr-push ctx rewritten)
                  ty-id)))]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr (lower-context-expr-get ctx array-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (match (lower-spmd-inline-expr ctx env type-env array subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-array)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              index
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-index)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast.ast-expr-array-ref-with-pools
                      (tc_core.tc-context-pools ctx)
                      (lower-context-expr-push ctx rewritten-array)
                      (lower-context-expr-push ctx rewritten-index))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr (lower-context-expr-get ctx array-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (match (lower-spmd-inline-expr ctx env type-env array subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-array)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              index
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-index)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  value
                  subst
                  shadowed)
                  [(ResultLowerAstExpr.Ok rewritten-value)
                    (ResultLowerAstExpr.Ok
                      (lower-context-expr-get
                        ctx
                        (ast.ast-expr-array-set-with-pools
                          (tc_core.tc-context-pools ctx)
                          (lower-context-expr-push ctx rewritten-array)
                          (lower-context-expr-push ctx rewritten-index)
                          (lower-context-expr-push ctx rewritten-value))))]
                  [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.ArrayTake array-box live-box index-box)
      (let
        [array : ast.AstExpr (lower-context-expr-get ctx array-box)]
        [live : ast.AstExpr (lower-context-expr-get ctx live-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (match (lower-spmd-inline-expr ctx env type-env array subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-array)
            (match (lower-spmd-inline-expr ctx env type-env live subst shadowed)
              [(ResultLowerAstExpr.Ok rewritten-live)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  index
                  subst
                  shadowed)
                  [(ResultLowerAstExpr.Ok rewritten-index)
                    (ResultLowerAstExpr.Ok
                      (lower-context-expr-get
                        ctx
                        (ast.ast-expr-array-take-with-pools
                          (tc_core.tc-context-pools ctx)
                          (lower-context-expr-push ctx rewritten-array)
                          (lower-context-expr-push ctx rewritten-live)
                          (lower-context-expr-push ctx rewritten-index))))]
                  [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.FixedArrayTake array-box index-box)
      (let
        [array : ast.AstExpr (lower-context-expr-get ctx array-box)]
        [index : ast.AstExpr (lower-context-expr-get ctx index-box)]
        (match (lower-spmd-inline-expr ctx env type-env array subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-array)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              index
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-index)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast.ast-expr-fixed-array-take-with-pools
                      (tc_core.tc-context-pools ctx)
                      (lower-context-expr-push ctx rewritten-array)
                      (lower-context-expr-push ctx rewritten-index))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.StructSet receiver-box field value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (match (lower-spmd-inline-expr ctx env type-env receiver subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-receiver)
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              value
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-value)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast.ast-expr-struct-set-id-with-pools
                      (tc_core.tc-context-pools ctx)
                      (lower-context-expr-push ctx rewritten-receiver)
                      field
                      (lower-context-expr-push ctx rewritten-value))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(ast.AstSpmdScan.Scan
            op
            index
            index-ty
            start-box
            end-box
            prefix
            prefix-ty
            init-box
            value-box
            body-box)
          (let
            [start : ast.AstExpr (lower-context-expr-get ctx start-box)]
            [end : ast.AstExpr (lower-context-expr-get ctx end-box)]
            [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
            [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-spmd-inline-expr
              ctx
              env
              type-env
              start
              subst
              shadowed)
              [(ResultLowerAstExpr.Ok rewritten-start)
                (match (lower-spmd-inline-expr
                  ctx
                  env
                  type-env
                  end
                  subst
                  shadowed)
                  [(ResultLowerAstExpr.Ok rewritten-end)
                    (match (lower-spmd-inline-expr
                      ctx
                      env
                      type-env
                      init
                      subst
                      shadowed)
                      [(ResultLowerAstExpr.Ok rewritten-init)
                        (match (lower-spmd-inline-expr
                          ctx
                          env
                          type-env
                          value
                          subst
                          shadowed)
                          [(ResultLowerAstExpr.Ok rewritten-value)
                            (match (lower-spmd-inline-expr
                              ctx
                              env
                              type-env
                              body
                              subst
                              shadowed)
                              [(ResultLowerAstExpr.Ok rewritten-body)
                                (ResultLowerAstExpr.Ok
                                  (ast.AstExpr.SpmdScan
                                    (box
                                      (ast.AstSpmdScan.Scan
                                        op
                                        index
                                        index-ty
                                        (lower-context-expr-push
                                          ctx
                                          rewritten-start)
                                        (lower-context-expr-push
                                          ctx
                                          rewritten-end)
                                        prefix
                                        prefix-ty
                                        (lower-context-expr-push
                                          ctx
                                          rewritten-init)
                                        (lower-context-expr-push
                                          ctx
                                          rewritten-value)
                                        (lower-context-expr-push
                                          ctx
                                          rewritten-body)))))]
                              [(ResultLowerAstExpr.Err diag)
                                (ResultLowerAstExpr.Err diag)])]
                          [(ResultLowerAstExpr.Err diag)
                            (ResultLowerAstExpr.Err diag)])]
                      [(ResultLowerAstExpr.Err diag)
                        (ResultLowerAstExpr.Err diag)])]
                  [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))])]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (match (lower-spmd-inline-expr ctx env type-env value subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-value)
            (match (lower-spmd-inline-expr ctx env type-env lane subst shadowed)
              [(ResultLowerAstExpr.Ok rewritten-lane)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast.ast-expr-spmd-broadcast-with-pools
                      (tc_core.tc-context-pools ctx)
                      (lower-context-expr-push ctx rewritten-value)
                      (lower-context-expr-push ctx rewritten-lane))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (match (lower-spmd-inline-expr ctx env type-env value subst shadowed)
          [(ResultLowerAstExpr.Ok rewritten-value)
            (match (lower-spmd-inline-expr ctx env type-env lane subst shadowed)
              [(ResultLowerAstExpr.Ok rewritten-lane)
                (ResultLowerAstExpr.Ok
                  (lower-context-expr-get
                    ctx
                    (ast.ast-expr-spmd-shuffle-with-pools
                      (tc_core.tc-context-pools ctx)
                      (lower-context-expr-push ctx rewritten-value)
                      (lower-context-expr-push ctx rewritten-lane))))]
              [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)])]
          [(ResultLowerAstExpr.Err diag) (ResultLowerAstExpr.Err diag)]))]
    [_ (ResultLowerAstExpr.Ok expr)]))

(define (lower-function-logical-id-from-decl
  [entry-path : String]
  [decl-path : String]
  [module : String]
  [module-id : i64]
  [decl : ast.AstDecl]) : LowerNameCacheMaybeId
  (match decl
    [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
      (LowerNameCacheMaybeId.Some
        (lower-decl-logical-id
          entry-path
          decl-path
          module
          module-id
          name
          (tc_core.tc-env-key-name-text name)))]
    [(ast.AstDecl.Unsafe inner-box)
      (lower-function-logical-id-from-decl
        entry-path
        decl-path
        module
        module-id
        (box-get inner-box))]
    [_ (LowerNameCacheMaybeId.No)]))

(define (lower-function-set-from-decls-in-module
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [_module : String]
  [module-id : i64]
  [out : lower_i64_i64_map.Map (:consume)]) : lower_i64_i64_map.Map
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [cur-out : lower_i64_i64_map.Map out]
    (begin
      (while (< index count)
        (let
          [decl : ast.AstDecl
            (array-ref
              (struct-get decls slots)
              (+ (struct-get decls offset) index))]
          [decl-path : String
            (ast.ast-decl-path-list-get (& paths) index entry-path)]
          [logical-module-id : i64
            (lower-decl-owner-module-id
              (& paths)
              index
              entry-path
              decl-path
              cur-module-id)]
          (begin
            (match decl
              [(ast.AstDecl.Module next-module)
                (set! cur-module-id next-module)]
              [_
                (match (lower-function-logical-id-from-decl
                  entry-path
                  decl-path
                  (lower-decl-owner-module-name cur-module-id logical-module-id)
                  logical-module-id
                  decl)
                  ;; Assign each distinct function name a dense slot
                  ;; (0..N-1, its insertion order) instead of a constant 1, so
                  ;; prune reachability `reachable` can key on that i64 slot.
                  ;; Skip names already present so the slot stays a bijection.
                  [(LowerNameCacheMaybeId.Some logical-id)
                    (if (lower_i64_i64_map.contains? (& cur-out) logical-id)
                      unit
                      (let
                        [slot : i64 (lower_i64_i64_map.len (& cur-out))]
                        (lower_i64_i64_map.insert-ref!
                          (&mut cur-out)
                          logical-id
                          slot)))]
                  [(LowerNameCacheMaybeId.No) unit])])
            (set! index (+ index 1)))))
      cur-out)))

(define (lower-function-set-from-decls
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]) : lower_i64_i64_map.Map
  (lower-function-set-from-decls-in-module
    decls
    paths
    entry-path
    ""
    cbi.compiler-builtin-id-fix-empty
    (lower_i64_i64_map.with-capacity 8192)))

(define (lower-reach-add-logical
  [all-functions : lower_i64_i64_map.Map]
  [state : LowerReachState (:consume)]
  [logical-id : i64]) : LowerReachState
  (match (lower_i64_i64_map.get (& all-functions) logical-id)
    [(lower_i64_i64_map.LookupMissing) state]
    [(lower_i64_i64_map.LookupFound slot)
      (match state
        [(LowerReachState.State reachable worklist)
          (if (lower_i64_i64_map.contains? (& reachable) slot)
            state
            (let
              [next-reachable : lower_i64_i64_map.Map reachable]
              (begin
                (lower_i64_i64_map.insert-ref! (&mut next-reachable) slot 1)
                (LowerReachState.State
                  next-reachable
                  (lower-id-set-push worklist logical-id)))))])]))

(define (lower-runtime-prelude-string-helper-id [source-id : i64]) : i64
  (let
    [raw-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or source-id source-id)]
    [base-id : i64 (tc_core.tc-qualified-name-base-id raw-id)]
    (cond
      [(= base-id cbi.compiler-builtin-id-tl-int-to-string)
        cbi.compiler-builtin-id-runtime-int-to-string]
      [(= base-id cbi.compiler-builtin-id-tl-substring)
        cbi.compiler-builtin-id-runtime-substring]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-str-view)
          (= base-id cbi.compiler-builtin-id-tl-bytes-view-from-str-parts)
          (= base-id cbi.compiler-builtin-id-tl-bytes-view-from-buf-parts)
          (= base-id cbi.compiler-builtin-id-tl-bytes-mut-view-from-buf-parts)
          (= base-id cbi.compiler-builtin-id-tl-bytes-view-from-bytes-parts)
          (= base-id cbi.compiler-builtin-id-tl-bytes-mut-view-from-bytes-parts))
        cbi.compiler-builtin-id-runtime-str-view]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat)
        cbi.compiler-builtin-id-string-concat]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat3)
        cbi.compiler-builtin-id-runtime-string-concat3]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat4)
        cbi.compiler-builtin-id-runtime-string-concat4]
      [(= base-id cbi.compiler-builtin-id-tl-string-concat5)
        cbi.compiler-builtin-id-runtime-string-concat5]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-load-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-load)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-load-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-load-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-store-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-store)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-store-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-store-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-fetch-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-fetch-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-fetch-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-fetch-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i64-cas-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i64-cas)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i64-cas-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i64-cas-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-load-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-load)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-load-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-load-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-store-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-store)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-store-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-store-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-fetch-add-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-fetch-add)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-fetch-add-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-fetch-add-ptr]
      [(or
          (= base-id cbi.compiler-builtin-id-tl-atomic-i32-cas-ptr)
          (= base-id cbi.compiler-builtin-id-atomic-i32-cas)
          (= base-id cbi.compiler-builtin-id-runtime-atomic-i32-cas-ptr))
        cbi.compiler-builtin-id-runtime-atomic-i32-cas-ptr]
      [else -1])))

(define (lower-runtime-prelude-selective-export-id?
  [module-id : i64]
  [symbol-id : i64]) : bool
  (and
    (= module-id cbi.compiler-builtin-id-runtime-module)
    (>= (lower-runtime-prelude-string-helper-id symbol-id) 0)))

(define (lower-reach-add-runtime-prelude-string-helper-id
  [all-functions : lower_i64_i64_map.Map]
  [state : LowerReachState (:consume)]
  [source-id : i64]) : LowerReachState
  (let
    [helper-id : i64 (lower-runtime-prelude-string-helper-id source-id)]
    (if (< helper-id 0)
      state
      (lower-reach-add-logical
        all-functions
        (lower-reach-add-logical all-functions state helper-id)
        (csym.compiler-symbol-module-key-id-by-id
          cbi.compiler-builtin-id-runtime-module
          helper-id)))))

(define (lower-reach-add-string-snapshot-runtime
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]) : LowerReachState
  ;; Clone-out/capture snapshot lowering copies owned String buffers through
  ;; the fixed `tl_substring` ABI helper, so keep its TypeLisp runtime body
  ;; when a reachable source form can synthesize that call after this prune
  ;; pass. Public stdlib string substring helpers are normal source functions;
  ;; explicit `tl_substring` extern references are rooted through the runtime
  ;; prelude helper path instead.
  (lower-reach-add-runtime-prelude-string-helper-resolved-id
    all-functions
    names
    state
    cbi.compiler-builtin-id-tl-substring))

(define (lower-reach-add-runtime-prelude-string-helper-resolved-id
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [source-id : i64]) : LowerReachState
  (let
    [helper-id : i64 (lower-runtime-prelude-string-helper-id source-id)]
    (if (< helper-id 0)
      state
      (let
        [module-helper-id : i64
          (csym.compiler-symbol-module-key-id-by-id
            cbi.compiler-builtin-id-runtime-module
            helper-id)]
        [helper-logical-id : i64
          (lower-name-cache-resolve-logical-id (& names) helper-id helper-id)]
        [module-helper-logical-id : i64
          (lower-name-cache-resolve-logical-id
            (& names)
            module-helper-id
            module-helper-id)]
        (lower-reach-add-logical
          all-functions
          (lower-reach-add-logical
            all-functions
            (lower-reach-add-runtime-prelude-string-helper-id
              all-functions
              state
              source-id)
            helper-logical-id)
          module-helper-logical-id)))))

;; `lower-string-concat` emits one of these fixed ABI calls after source
;; reachability has already completed. Root their TypeLisp runtime exports from
;; the source call so pruning cannot leave the generated call unresolved.
(define (lower-reach-add-string-concat-runtime
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]) : LowerReachState
  (lower-reach-add-runtime-prelude-string-helper-resolved-id
    all-functions
    names
    (lower-reach-add-runtime-prelude-string-helper-resolved-id
      all-functions
      names
      (lower-reach-add-runtime-prelude-string-helper-resolved-id
        all-functions
        names
        (lower-reach-add-runtime-prelude-string-helper-resolved-id
          all-functions
          names
          state
          cbi.compiler-builtin-id-tl-string-concat)
        cbi.compiler-builtin-id-tl-string-concat3)
      cbi.compiler-builtin-id-tl-string-concat4)
    cbi.compiler-builtin-id-tl-string-concat5))

(define (lower-reach-legacy-string-concat-source-id? [source-id : i64]) : bool
  (let
    [raw-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or source-id source-id)]
    ;; These legacy intrinsics have no source definition to resolve. A user
    ;; definition with the same spelling can retain unused runtime exports,
    ;; but it cannot change the source program's behavior.
    (or
      (= raw-id cbi.compiler-builtin-id-string-append)
      (= raw-id cbi.compiler-builtin-id-string-concat))))

(define (lower-reach-stdlib-string-concat-logical-id?
  [names : LowerNameCache]
  [logical-id : i64]) : bool
  ;; Alias spellings are no longer present once the reach worklist reaches the
  ;; public wrapper. Compare its resolved logical identity instead, so a
  ;; compiler-fused `string_mod.append` (or macro-generated alias) also keeps
  ;; the post-prune runtime ABI exports.
  (let
    [module-id : i64 cbi.compiler-builtin-id-fix-stdlib_dot_string]
    [append-id : i64
      (csym.compiler-symbol-module-key-id-by-id
        module-id
        cbi.compiler-builtin-id-fix-append)]
    [concat-id : i64
      (csym.compiler-symbol-module-key-id-by-id
        module-id
        cbi.compiler-builtin-id-fix-concat)]
    (or
      (=
        logical-id
        (lower-name-cache-resolve-logical-id (& names) append-id append-id))
      (=
        logical-id
        (lower-name-cache-resolve-logical-id (& names) concat-id concat-id)))))

(define (lower-reach-public-string-concat-source-id?
  [names : LowerNameCache]
  [source-id : i64]) : bool
  ;; Resolve aliases before deciding whether this source call can be fused. The
  ;; generated runtime calls need reachability roots only for a nested public
  ;; tree, not for every ordinary `string.append` wrapper call.
  (let
    [mapped-source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or source-id source-id)]
    [hygiene-key-id : i64 (tc_core.tc-env-name-key-id source-id)]
    [hygiene-logical-id : i64
      (if (= hygiene-key-id source-id)
        -1
        (lower-name-cache-lookup-logical-id (& names) hygiene-key-id -1))]
    [logical-id : i64
      (if (>= hygiene-logical-id 0)
        hygiene-logical-id
        (lower-name-cache-resolve-logical-id (& names) mapped-source-id -1))]
    (lower-reach-stdlib-string-concat-logical-id? names logical-id)))

(define (lower-reach-public-float-to-bits-source-id?
  [names : LowerNameCache]
  [source-id : i64]) : bool
  (let
    [mapped-source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or source-id source-id)]
    [hygiene-key-id : i64 (tc_core.tc-env-name-key-id source-id)]
    [hygiene-logical-id : i64
      (if (= hygiene-key-id source-id)
        -1
        (lower-name-cache-lookup-logical-id (& names) hygiene-key-id -1))]
    [logical-id : i64
      (if (>= hygiene-logical-id 0)
        hygiene-logical-id
        (lower-name-cache-resolve-logical-id (& names) mapped-source-id -1))]
    (if (< logical-id 0)
      false
      (match (lower-name-cache-lookup-id names logical-id)
        [(tc_core.TcMaybeString.Some name)
          (lower-float-to-bits-public-target? name)]
        [(tc_core.TcMaybeString.No) false]))))

(define (lower-reach-float-to-bits-literal-arg?
  [pools : ast.AstNodePoolContext]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-pools pools expr)
    [(ast.AstExpr.Literal lit)
      (match lit
        [(ast.AstLiteral.Float _) true]
        [_ false])]
    [(ast.AstExpr.Ann inner-box _)
      (match (ast.ast-expr-unspan-with-pools
        pools
        (ast.ast-node-pool-context-expr-get pools inner-box))
        [(ast.AstExpr.Literal lit)
          (match lit
            [(ast.AstLiteral.Float _) true]
            [_ false])]
        [_ false])]
    [(ast.AstExpr.Cast inner-box _)
      (match (ast.ast-expr-unspan-with-pools
        pools
        (ast.ast-node-pool-context-expr-get pools inner-box))
        [(ast.AstExpr.Literal lit)
          (match lit
            [(ast.AstLiteral.Float _) true]
            [_ false])]
        [_ false])]
    [_ false]))

(define (lower-reach-string-concat-call?
  [pools : ast.AstNodePoolContext]
  [names : LowerNameCache]
  [expr : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan-with-pools pools expr)
    [(ast.AstExpr.Call callee-box args)
      (let
        [callee : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools callee-box)]
        (match (ast.ast-expr-unspan-with-pools pools callee)
          [(ast.AstExpr.Var name)
            (and
              (= (struct-get (& args) len) 2)
              (or
                (lower-reach-legacy-string-concat-source-id? name)
                (lower-reach-public-string-concat-source-id? names name)))]
          [_ false]))]
    [_ false]))

(define (lower-reach-public-string-concat-tree?
  [pools : ast.AstNodePoolContext]
  [names : LowerNameCache]
  [callee : ast.AstExpr]
  [args : ast.AstExprList]) : bool
  (if (= (struct-get (& args) len) 2)
    (match (ast.ast-expr-unspan-with-pools pools callee)
      [(ast.AstExpr.Var name)
        (and
          (lower-reach-public-string-concat-source-id? names name)
          (let
            [left : ast.AstExpr
              (ast.ast-node-pool-context-expr-get
                pools
                (ast.ast-expr-list-get (& args) 0 0))]
            [right : ast.AstExpr
              (ast.ast-node-pool-context-expr-get
                pools
                (ast.ast-expr-list-get (& args) 1 0))]
            (or
              (lower-reach-string-concat-call? pools names left)
              (lower-reach-string-concat-call? pools names right))))]
      [_ false])
    false))

(define (lower-reach-string-snapshot-source-call? [name-id : i64]) : bool
  (cbi.compiler-builtin-lower-clone-id?
    (tc_core.macro-hygiene-global-source-name-id-or name-id name-id)))

(define (lower-reach-add-source-id
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [source-id : i64]) : LowerReachState
  (let
    [mapped-source-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or source-id source-id)]
    [hygiene-key-id : i64 (tc_core.tc-env-name-key-id source-id)]
    [hygiene-logical-id : i64
      (if (= hygiene-key-id source-id)
        -1
        (lower-name-cache-lookup-logical-id (& names) hygiene-key-id -1))]
    [logical-id : i64
      (if (>= hygiene-logical-id 0)
        hygiene-logical-id
        (lower-name-cache-resolve-logical-id (& names) mapped-source-id -1))]
    (lower-reach-add-runtime-prelude-string-helper-resolved-id
      all-functions
      names
      (lower-reach-add-stdlib-string-public-helper-id
        all-functions
        names
        (lower-reach-add-runtime-prelude-string-helper-id
          all-functions
          (lower-reach-add-logical all-functions state logical-id)
          source-id)
        source-id)
      source-id)))

(define (lower-reach-add-stdlib-string-public-helper-id
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [source-id : i64]) : LowerReachState
  (let
    [raw-id : i64
      (tc_core.macro-hygiene-global-source-name-id-or source-id source-id)]
    [base-id : i64 (tc_core.tc-qualified-name-base-id raw-id)]
    (if (or
      (= base-id cbi.compiler-builtin-id-string-length)
      (= base-id cbi.compiler-builtin-id-string-ref)
      (= base-id cbi.compiler-builtin-id-char-at)
      (= base-id cbi.compiler-builtin-id-string-eq)
      (= base-id cbi.compiler-builtin-id-string-eq-question)
      (= base-id cbi.compiler-builtin-id-string-to-int))
      (let
        [module-source-id : i64
          (csym.compiler-symbol-module-key-id-by-id
            cbi.compiler-builtin-id-fix-stdlib_dot_string
            base-id)]
        (lower-reach-add-logical
          all-functions
          state
          (lower-name-cache-resolve-logical-id
            (& names)
            module-source-id
            module-source-id)))
      state)))

(define (lower-reach-used-type-name-add-source! [name : i64]) : unit
  (if (or
    (tc_core.tc-name-qualified-id? name)
    (>= (tc_core.tc-name-first-dot-id name) 0))
    (set!
      lower-reach-active-body-used-types
      (lower-used-type-name-add
        (lower-global-shared-view lower-reach-active-body-used-types)
        ""
        name))
    unit))

(define (lower-reach-used-types-add-pattern-roots! [pattern : ast.AstPattern]) : unit
  (match pattern
    [(ast.AstPattern.Var _ _) unit]
    [(ast.AstPattern.Tuple patterns-box)
      (lower-reach-used-types-add-pattern-list-roots! (box-get patterns-box))]
    [(ast.AstPattern.Array patterns-box)
      (lower-reach-used-types-add-pattern-list-roots! (box-get patterns-box))]
    [(ast.AstPattern.Wildcard) unit]
    [(ast.AstPattern.Binding _) unit]
    [(ast.AstPattern.Variant name patterns-box)
      (begin
        (lower-reach-used-type-name-add-source! name)
        (lower-reach-used-types-add-pattern-list-roots! (box-get patterns-box)))]
    [(ast.AstPattern.Literal _) unit]))

(define (lower-reach-used-types-add-pattern-list-roots!
  [patterns : ast.AstPatternList]) : unit
  (lower-reach-used-types-add-pattern-list-roots-at! (& patterns) 0))

(define (lower-reach-used-types-add-pattern-list-roots-at!
  [patterns : (& patterns ast.AstPatternList)]
  [index : i64]) : unit
  (if (>= index (struct-get patterns len))
    unit
    (begin
      (lower-reach-used-types-add-pattern-roots!
        (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback)))
      (lower-reach-used-types-add-pattern-list-roots-at! patterns (+ index 1)))))

(define (lower-reach-expr-list
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [exprs : ast.AstExprList]) : LowerReachState
  (lower-reach-expr-list-at pools all-functions names state (& exprs) 0))

(define (lower-reach-expr-list-at
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : LowerReachState
  (if (>= index (struct-get exprs len))
    state
    (let
      [expr-id : i64 (ast.ast-expr-list-get exprs index 0)]
      [expr : ast.AstExpr (ast.ast-node-pool-context-expr-get pools expr-id)]
      (lower-reach-expr-list-at
        pools
        all-functions
        names
        (lower-reach-expr pools all-functions names state expr)
        exprs
        (+ index 1)))))

(define (lower-reach-let-bindings
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [bindings : ast.AstLetBindingList]) : LowerReachState
  (lower-reach-let-bindings-at pools all-functions names state (& bindings) 0))

(define (lower-reach-let-bindings-at
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : LowerReachState
  (if (>= index (ast.ast-let-binding-list-len bindings))
    state
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ value-box)
        (let
          [value : ast.AstExpr
            (ast.ast-node-pool-context-expr-get pools value-box)]
          (lower-reach-let-bindings-at
            pools
            all-functions
            names
            (lower-reach-expr pools all-functions names state value)
            bindings
            (+ index 1)))])))

(define (lower-reach-match-arms
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [arms : ast.AstMatchArmList]) : LowerReachState
  (lower-reach-match-arms-at pools all-functions names state (& arms) 0))

(define (lower-reach-match-arms-at
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : LowerReachState
  (if (>= index (struct-get arms len))
    state
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (let
          [body : ast.AstExpr
            (ast.ast-node-pool-context-expr-get pools body-box)]
          (begin
            (lower-reach-used-types-add-pattern-roots! pattern)
            (lower-reach-match-arms-at
              pools
              all-functions
              names
              (lower-reach-expr pools all-functions names state body)
              arms
              (+ index 1))))])))

(define (lower-reach-resource-bindings
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [bindings : ast.AstResourceBindingList]) : LowerReachState
  (lower-reach-resource-bindings-at
    pools
    all-functions
    names
    state
    (& bindings)
    0))

(define (lower-reach-resource-bindings-at
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [index : i64]) : LowerReachState
  (if (>= index (ast.ast-resource-binding-list-len bindings))
    state
    (match (ast.ast-resource-binding-list-get
      bindings
      index
      (ast.ast-resource-binding-fallback))
      [(ast.AstResourceBinding.Binding _ acquire-box cleanup-box _)
        (let
          [acquire : ast.AstExpr
            (ast.ast-node-pool-context-expr-get pools acquire-box)]
          [cleanup : ast.AstExpr
            (ast.ast-node-pool-context-expr-get pools cleanup-box)]
          (lower-reach-resource-bindings-at
            pools
            all-functions
            names
            (lower-reach-expr
              pools
              all-functions
              names
              (lower-reach-expr pools all-functions names state acquire)
              cleanup)
            bindings
            (+ index 1)))])))

(define (lower-clone-handoff-type-args
  [ctx : tc_core.TcContext]
  [pools : ast.AstNodePoolContext]
  [roots : clone_support.CloneRootEntries]) : ast.AstExprList
  (let
    [index : i64 (- (clone_support.clone-root-entries-len roots) 1)]
    [out : ast.AstExprList (ast.ast-expr-list-new)]
    (begin
      ;; Dense roots expose logical newest-first order; cons from the oldest
      ;; logical entry back to index 0 to preserve the old recursive output.
      (while (>= index 0)
        (let
          [root-key-id : i64
            (clone_support.clone-root-entries-key-id-at-or roots index -1)]
          [module-id : i64
            (if (clone_support.clone-name-key-qualified? root-key-id)
              (clone_support.clone-name-key-module-id root-key-id)
              cbi.compiler-builtin-id-fix-empty)]
          (begin
            (set!
              out
              (ast.ast-expr-cons
                (ast.ast-node-pool-context-expr-push
                  pools
                  (ast.AstExpr.Literal (ast.AstLiteral.String module-id)))
                (ast.ast-expr-cons
                  (ast.ast-node-pool-context-expr-push
                    pools
                    (ast.AstExpr.TypeLiteral
                      (ast.ast-node-pool-context-type-push
                        pools
                        (tc_core.tc-resolve-type
                          ctx
                          (ast.AstType.Var root-key-id)))))
                  out)))
            (set! index (- index 1)))))
      out)))

(define (lower-clone-handoff-request-decl
  [ctx : tc_core.TcContext]
  [pools : ast.AstNodePoolContext]
  [roots : clone_support.CloneRootEntries]) : ast.AstDecl
  (let
    [callee : i64
      (ast.ast-node-pool-context-expr-push
        pools
        (ast.AstExpr.Var
          (tc_core.macro-hygiene-global-id
            cbi.compiler-builtin-id-fix-stdlib_dot_clone
            cbi.compiler-builtin-id-fix-synthesize_helpers
            false)))]
    [call-id : i64
      (ast.ast-expr-call-with-pools
        pools
        callee
        (lower-clone-handoff-type-args ctx pools roots))]
    (ast.AstDecl.Import
      (ast.ast-decl-meta-runtime-shared-view)
      (ast.AstImportSpec.Spec
        (ast.AstImportKind.MacroDecls call-id ast.AstMaybeModuleName.No)
        ""
        ast.AstMaybeModuleName.No
        ast.AstMaybeImportAlias.No
        (box (ast.ast-decl-span-fallback))))))

(define (lower-clone-handoff-generated-origin-count-in-module
  [decls : ast.AstDeclList]
  [root-key-id : i64]
  [helper-name-id : i64]
  [module-id : i64]) : i64
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) 0]
    [(ast.AstDeclListStep.Cons decl rest)
      (match decl
        [(ast.AstDecl.Module next-module)
          (lower-clone-handoff-generated-origin-count-in-module
            rest
            root-key-id
            helper-name-id
            next-module)]
        [_
          (+
            (match (ast.ast-decl-generated-meta decl)
              [(ast.AstGeneratedDeclMeta.Some generator item _ key)
                (if (and
                  (string.eq generator "stdlib.clone/synthesize-helpers")
                  (string.eq item (ci.intern-str helper-name-id))
                  (tc_core.tc-string-prefix?
                    key
                    "decls:stdlib.clone:stdlib.clone/synthesize-helpers(")
                  (=
                    module-id
                    (if (clone_support.clone-name-key-qualified? root-key-id)
                      (clone_support.clone-name-key-module-id root-key-id)
                      cbi.compiler-builtin-id-fix-empty))
                  (=
                    (clone_support.clone-helper-decl-count
                      (ast.ast-decl-cons
                        (ast.ast-decl-module-id module-id)
                        (ast.ast-decl-cons decl (ast.ast-decl-list-new)))
                      root-key-id
                      helper-name-id)
                    1))
                  1
                  0)]
              [(ast.AstGeneratedDeclMeta.No) 0])
            (lower-clone-handoff-generated-origin-count-in-module
              rest
              root-key-id
              helper-name-id
              module-id))])]))

(define (lower-clone-handoff-generated-origin-count
  [decls : ast.AstDeclList]
  [root-key-id : i64]
  [helper-name-id : i64]) : i64
  (lower-clone-handoff-generated-origin-count-in-module
    decls
    root-key-id
    helper-name-id
    cbi.compiler-builtin-id-fix-empty))

;; Caches that may capture scratch-arena values produced by the handoff
;; expansion. Each is a pure memo rebuilt on demand; resetting them before the
;; scratch arena is destroyed mirrors the macro-walk boundary clears.
(define (lower-clone-handoff-expansion-cache-clear!
  [job-state : tc_core.TcJobState]) : unit
  (begin
    (tc_core.macro-generated-decls-memo-reset!)
    (tc_core.macro-generated-module-memo-reset!)
    (tc_core.tc-macro-helper-env-cache-reset!)
    (tc_core.tc-nominal-owner-cache-reset!)
    (tc_core.macro-alias-derived-cache-reset!)
    (tc_core.tc-job-state-reset-file-state! job-state)
    (ctfe.ctfe-module-macro-export-reset!)))

;; The handoff expansion runs the full macro/CTFE machinery for every clone
;; root in one shot. Its working set (CTFE values, env spines, memo entries) is
;; dead once the generated helper declarations exist, but unlike the main macro
;; walk it runs after macro_detach -- no later pool compaction retires that
;; garbage, and on a self-compile it retained ~745MB in the persistent base
;; arena for the rest of the compile. Run the expansion in a scratch arena and
;; copy only the returned declarations out (the mark/rewind/clone-out shape of
;; tc-check-fn-decl-scoped): node-pool growth and interned spellings already
;; live in their persistent owners, type-node payloads are persisted at push
;; time by ty-node-persist, and ast-program-copy-append-with-pools deep-copies
;; the decl shells and any scratch-resident expr payloads, remapping the
;; appended expr/type ids.
(define (lower-clone-handoff-expansion-copy-out
  [pools : ast.AstNodePoolContext]
  [raw : tc_core.ResultMacroDeclExpansion]) : tc_core.ResultMacroDeclExpansion
  (match raw
    [(tc_core.ResultMacroDeclExpansion.Ok generated generated-paths)
      (match (ast.ast-program-copy-append-with-pools
        pools
        pools
        (ast.ast-program generated))
        [(ast.AstProgramCompaction copied _)
          (match copied
            [(ast.AstProgram.Program decls-box)
              (tc_core.ResultMacroDeclExpansion.Ok
                (box-get decls-box)
                (lower-copy-paths-into-pools generated-paths pools))])])]
    [(tc_core.ResultMacroDeclExpansion.Err diag)
      (tc_core.ResultMacroDeclExpansion.Err
        (box (cdiag.compiler-diagnostic-copy (box-get diag))))]))

(define (lower-clone-handoff-expand-one
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [source-decls : ast.AstDeclList]
  [entry-path : String]
  [pools : ast.AstNodePoolContext]
  [roots : clone_support.CloneRootEntries]) : tc_core.ResultMacroDeclExpansion
  (let
    [request : ast.AstDecl (lower-clone-handoff-request-decl ctx pools roots)]
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (arena.tl_arena_make)]
    (begin
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [raw : tc_core.ResultMacroDeclExpansion
          (tc_core.macro-expand-decl-with-path
            (tc_core.tc-context-with-module-id
              ctx
              ""
              cbi.compiler-builtin-id-fix-empty)
            top-env
            top-env
            source-decls
            ""
            cbi.compiler-builtin-id-fix-empty
            request
            entry-path)]
        (begin
          (unsafe
            (arena.tl_arena_set enclosing))
          (ast.ast-node-pool-context-capture-active! pools)
          (let
            [escaped : tc_core.ResultMacroDeclExpansion
              (lower-clone-handoff-expansion-copy-out pools raw)]
            (begin
              (lower-clone-handoff-expansion-cache-clear!
                (tc_core.tc-context-job-state ctx))
              (unsafe
                (arena.tl_arena_destroy scratch))
              (ast.ast-node-pool-context-install! pools)
              escaped)))))))

(define (lower-clone-handoff-source-helper-root-id
  [name-id : i64]
  [module-id : i64]
  [roots : clone_support.CloneRootEntries]) : i64
  (let
    [index : i64 0]
    [count : i64 (clone_support.clone-root-entries-len roots)]
    [found : i64 -1]
    (begin
      (while (and (< index count) (< found 0))
        (let
          [root-key-id : i64
            (clone_support.clone-root-entries-key-id-at-or roots index -1)]
          [helper-name-id : i64
            (clone_support.clone-root-entries-helper-id-at-or roots index -1)]
          [root-module-id : i64
            (if (clone_support.clone-name-key-qualified? root-key-id)
              (clone_support.clone-name-key-module-id root-key-id)
              cbi.compiler-builtin-id-fix-empty)]
          (begin
            (if (and
              (= module-id root-module-id)
              (string.eq
                (tc_core.tc-env-key-name-text name-id)
                (ci.intern-str helper-name-id)))
              (set! found root-key-id)
              unit)
            (set! index (+ index 1)))))
      found)))

(define (lower-clone-handoff-source-conflict-in-module
  [source-decls : ast.AstDeclList]
  [roots : clone_support.CloneRootEntries]
  [module-id : i64]) : i64
  ;; Index cursor rather than `ast-decl-list-step`; the first non-negative root
  ;; key still stops the walk. The wrapper peel stays by value -- it needs owned
  ;; `Box` storage to walk an `AstDecl.Unsafe` chain -- but it now reads the
  ;; backing slot instead of a stepped-out 104 B copy.
  (let
    [count : i64 (ast.ast-decl-list-len (& source-decls))]
    [decl-slots : (__tl_dyn-array ast.AstDecl) (struct-get source-decls slots)]
    [decl-offset : i64 (struct-get source-decls offset)]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [found : i64 -1]
    (begin
      (while (and (< found 0) (< index count))
        (begin
          (match (ast.ast-decl-unwrapped
            (array-ref decl-slots (+ decl-offset index)))
            [(ast.AstDecl.Module next-module) (set! cur-module-id next-module)]
            [(ast.AstDecl.DefFn decl-meta name _ _ _ _)
              (let
                [root-key-id : i64
                  (lower-clone-handoff-source-helper-root-id
                    name
                    cur-module-id
                    roots)]
                (if (>= root-key-id 0)
                  (set! found root-key-id)
                  unit))]
            [_ unit])
          (set! index (+ index 1))))
      found)))

(define (lower-clone-handoff-source-conflict
  [source-decls : ast.AstDeclList]
  [roots : clone_support.CloneRootEntries]) : i64
  (lower-clone-handoff-source-conflict-in-module
    source-decls
    roots
    cbi.compiler-builtin-id-fix-empty))

(define (lower-clone-handoff-generated-roots-ok?
  [generated : ast.AstDeclList]
  [roots : clone_support.CloneRootEntries]) : bool
  (let
    [index : i64 0]
    [count : i64 (clone_support.clone-root-entries-len roots)]
    [ok : bool true]
    (begin
      (while (and (< index count) ok)
        (let
          [root-key-id : i64
            (clone_support.clone-root-entries-key-id-at-or roots index -1)]
          [helper-name-id : i64
            (clone_support.clone-root-entries-helper-id-at-or roots index -1)]
          (begin
            (if (and
              (=
                (clone_support.clone-helper-decl-count
                  generated
                  root-key-id
                  helper-name-id)
                1)
              (=
                (lower-clone-handoff-generated-origin-count
                  generated
                  root-key-id
                  helper-name-id)
                1))
              unit
              (set! ok false))
            (set! index (+ index 1)))))
      ok)))

;; Expand roots in bounded chunks: the one-shot expansion's macro/CTFE working
;; set scales with the whole root list (hundreds of MB of interpreter churn on
;; a self-compile), but only one chunk's worth needs to be live at a time.
;; Helpers are generated per type key, so chunking preserves the output union.
(define (lower-clone-handoff-expand-roots
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [source-decls : ast.AstDeclList]
  [entry-path : String]
  [pools : ast.AstNodePoolContext]
  [roots : clone_support.CloneRootEntries]
  [acc : ast.AstDeclList]) : tc_core.ResultMacroDecls
  (if (clone_support.clone-root-entries-empty? roots)
    (tc_core.ResultMacroDecls.Ok acc)
    (let
      [chunk : clone_support.CloneRootEntries
        (clone_support.clone-root-entries-take roots 16)]
      [rest : clone_support.CloneRootEntries
        (clone_support.clone-root-entries-drop roots 16)]
      [expanded : tc_core.ResultMacroDeclExpansion
        (lower-clone-handoff-expand-one
          ctx
          top-env
          source-decls
          entry-path
          pools
          chunk)]
      (match expanded
        [(tc_core.ResultMacroDeclExpansion.Ok generated _)
          (if (lower-clone-handoff-generated-roots-ok? generated chunk)
            (begin
              (ast.ast-node-pool-context-capture-active! pools)
              (lower-clone-handoff-expand-roots
                ctx
                top-env
                source-decls
                entry-path
                pools
                rest
                (clone_support.clone-decl-list-append acc generated)))
            (let
              [root-key-id : i64
                (clone_support.clone-root-entries-key-id-at-or chunk 0 -1)]
              [helper-name-id : i64
                (clone_support.clone-root-entries-helper-id-at-or chunk 0 -1)]
              [message : String
                (str_cat.str-cat
                  "clone: stdlib handoff produced an invalid or conflicting helper for "
                  (clone_support.clone-name-key-string root-key-id)
                  " (helper-count="
                  (string.int->string
                    (clone_support.clone-helper-decl-count
                      generated
                      root-key-id
                      helper-name-id))
                  ", origin-count="
                  (string.int->string
                    (lower-clone-handoff-generated-origin-count
                      generated
                      root-key-id
                      helper-name-id))
                  ")")]
              (tc_core.ResultMacroDecls.Err
                (box (tc_core.tc-diag-at-start message)))))]
        [(tc_core.ResultMacroDeclExpansion.Err diag)
          (tc_core.ResultMacroDecls.Err diag)]))))

(define (lower-clone-handoff-augment
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [entry-path : String]
  [program : ast.AstProgram]
  [able : clone_support.CloneNameSet]
  [roots : clone_support.CloneRootEntries]
  [pools : ast.AstNodePoolContext]) : ResultLowerCloneAugment
  (match program
    [(ast.AstProgram.Program decls-box)
      (let
        [source-decls : ast.AstDeclList (box-get decls-box)]
        [handoff-roots : clone_support.CloneRootEntries
          (clone_support.clone-stdlib-handoff-roots
            pools
            source-decls
            able
            roots)]
        [conflict : i64
          (lower-clone-handoff-source-conflict source-decls handoff-roots)]
        (if (>= conflict 0)
          (ResultLowerCloneAugment.Err
            (str_cat.str-cat
              "clone: conflicting helper producer for "
              (clone_support.clone-helper-name
                (clone_support.clone-name-key-string conflict))))
          (match (lower-clone-handoff-expand-roots
            ctx
            top-env
            source-decls
            entry-path
            pools
            handoff-roots
            (ast.ast-decl-list-new))
            [(tc_core.ResultMacroDecls.Ok handoff-decls)
              (let
                [augmented-decls : ast.AstDeclList
                  (clone_support.clone-decl-list-append
                    source-decls
                    handoff-decls)]
                (ResultLowerCloneAugment.Ok
                  (ast.ast-program augmented-decls)
                  handoff-decls))]
            [(tc_core.ResultMacroDecls.Err diag)
              (ResultLowerCloneAugment.Err
                (cdiag.compiler-diagnostic-message (box-get diag)))])))]))

(define (lower-extend-checked-context-with-clone-decls
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [source-decl-count : i64]
  [program : ast.AstProgram]) : ResultLowerCheckedContext
  (match program
    [(ast.AstProgram.Program decls-box)
      (let
        [decls : ast.AstDeclList (box-get decls-box)]
        [clone-decls : ast.AstDeclList
          (tc_core.tc-decl-list-drop decls source-decl-count)]
        [next-ctx : tc_core.TcContext
          (tc_core.tc-context-with-program ctx program)]
        (match (tc_core.env-extend-with-module next-ctx top-env clone-decls)
          [(tc_core.ResultTcEnv.Ok next-env)
            (begin
              (tc_core.tc-context-capture-active-pools! next-ctx)
              (tc_core.tc-hygiene-reset-active-top-env! next-env)
              (tc_core.tc-macro-helper-env-cache-reset!)
              (ResultLowerCheckedContext.Ok next-ctx next-env))]
          [(tc_core.ResultTcEnv.Err message)
            (ResultLowerCheckedContext.Err message)]))]))

(define (lower-reach-call-callee
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [callee : ast.AstExpr]
  [args : ast.AstExprList]) : LowerReachState
  (match (ast.ast-expr-unspan-with-pools pools callee)
    [(ast.AstExpr.Var name)
      ;; Literal public-wrapper calls disappear into integer constants during
      ;; lowering, so do not keep an otherwise-dead wrapper just for that call.
      (if (and
        (= (struct-get (& args) len) 1)
        (lower-reach-float-to-bits-literal-arg?
          pools
          (ast.ast-node-pool-context-expr-get
            pools
            (ast.ast-expr-list-get (& args) 0 0)))
        (lower-reach-public-float-to-bits-source-id? names name))
        state
        (lower-reach-add-source-id all-functions names state name))]
    [_ (lower-reach-expr pools all-functions names state callee)]))

(define (lower-reach-expr
  [pools : ast.AstNodePoolContext]
  [all-functions : lower_i64_i64_map.Map]
  [names : LowerNameCache]
  [state : LowerReachState (:consume)]
  [expr : ast.AstExpr]) : LowerReachState
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(ast.AstExpr.Literal _) state]
    [(ast.AstExpr.Var name)
      (lower-reach-add-source-id all-functions names state name)]
    [(ast.AstExpr.Binary _ lhs-box rhs-box)
      (let
        [lhs : ast.AstExpr (ast.ast-node-pool-context-expr-get pools lhs-box)]
        [rhs : ast.AstExpr (ast.ast-node-pool-context-expr-get pools rhs-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state lhs)
          rhs))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools inner-box)]
        (lower-reach-expr pools all-functions names state inner))]
    [(ast.AstExpr.Call callee-box args)
      (let
        [callee : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools callee-box)]
        [callee-state : LowerReachState
          (lower-reach-call-callee pools all-functions names state callee args)]
        [concat-state : LowerReachState
          (match (ast.ast-expr-unspan-with-pools pools callee)
            [(ast.AstExpr.Var name)
              (if (or
                (lower-reach-legacy-string-concat-source-id? name)
                (lower-reach-public-string-concat-tree? pools names callee args))
                (lower-reach-add-string-concat-runtime
                  all-functions
                  names
                  callee-state)
                callee-state)]
            [_ callee-state])]
        [runtime-state : LowerReachState
          (match (ast.ast-expr-unspan-with-pools pools callee)
            [(ast.AstExpr.Var name)
              (if (lower-reach-string-snapshot-source-call? name)
                (lower-reach-add-string-snapshot-runtime
                  all-functions
                  names
                  concat-state)
                concat-state)]
            [_ concat-state])]
        (lower-reach-expr-list pools all-functions names runtime-state args))]
    [(ast.AstExpr.If cond-box then-expr-box else-expr-box)
      (let
        [cond : ast.AstExpr (ast.ast-node-pool-context-expr-get pools cond-box)]
        [then-expr : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools then-expr-box)]
        [else-expr : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools else-expr-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr
            pools
            all-functions
            names
            (lower-reach-expr pools all-functions names state cond)
            then-expr)
          else-expr))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              names
              (lower-reach-let-bindings
                pools
                all-functions
                names
                state
                bindings)
              body))])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(ast.AstLambda.Lambda _ _ body-box)
          (let
            [body : ast.AstExpr
              (ast.ast-node-pool-context-expr-get pools body-box)]
            (lower-reach-expr
              pools
              all-functions
              names
              (lower-reach-add-string-snapshot-runtime
                all-functions
                names
                state)
              body))])]
    [(ast.AstExpr.Tuple values)
      (lower-reach-expr-list pools all-functions names state values)]
    [(ast.AstExpr.TupleRef value-box _)
      (let
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr pools all-functions names state value))]
    [(ast.AstExpr.Array values)
      (lower-reach-expr-list pools all-functions names state values)]
    [(ast.AstExpr.DynArray values)
      (lower-reach-expr-list pools all-functions names state values)]
    [(ast.AstExpr.MakeArray _ len-box)
      (let
        [len : ast.AstExpr (ast.ast-node-pool-context-expr-get pools len-box)]
        (lower-reach-expr pools all-functions names state len))]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (let
        [array : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools array-box)]
        [index : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools index-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr pools all-functions names state array)
          index))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (let
        [array : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools array-box)]
        [index : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools index-box)]
        [value : ast.AstExpr
          (ast.ast-node-pool-context-expr-get pools value-box)]
        (lower-reach-expr
          pools
          all-functions
          names
          (lower-reach-expr
            pools
            all-functions
            names
