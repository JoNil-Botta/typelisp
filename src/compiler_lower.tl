(define (compiler-lower-stdlib-comptime-runtime-dce-program) : AstProgram
  (ast-program
    (ast-decl-cons
      (ast-decl-module "stdlib.comptime")
      (ast-decl-cons
        (ast-decl-def-fn
          "ctfe-runtime-helper"
          AstParamList.Nil
          (AstType.I64)
          (ast-node-push (AstExpr.Literal (ast-lit-int 7))))
        (ast-decl-cons
          (ast-decl-module "main")
          (ast-decl-cons
            (ast-decl-def-fn
              "main"
