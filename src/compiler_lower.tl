(defenum CompilerLowerMode
  (Scalar)
  (LinuxScalar)
  (WindowsScalar)
  (Avx2)
  (LinuxAvx2)
  (WindowsAvx2)
  (Avx512)
  (LinuxAvx512)
  (WindowsAvx512))

;; CompilerLowerMode is the product of two independent axes: the C ABI the
;; program is lowered for (none, SysV Linux, Win64) and the SPMD vector width.
;; Lowering reads the mode only through these projections.
(defenum LowerModeAbi
  (None)
  (Linux)
  (Windows))

(defenum LowerModeSimd
  (Scalar)
  (Avx2)
  (Avx512))

(define (lower-mode-abi [mode : CompilerLowerMode]) : LowerModeAbi
  (match mode
    [(CompilerLowerMode.Scalar) (None)]
    [(CompilerLowerMode.Avx2) (None)]
    [(CompilerLowerMode.Avx512) (None)]
    [(CompilerLowerMode.LinuxScalar) (Linux)]
    [(CompilerLowerMode.LinuxAvx2) (Linux)]
    [(CompilerLowerMode.LinuxAvx512) (Linux)]
    [(CompilerLowerMode.WindowsScalar) (Windows)]
    [(CompilerLowerMode.WindowsAvx2) (Windows)]
    [(CompilerLowerMode.WindowsAvx512) (Windows)]))

(define (lower-mode-simd [mode : CompilerLowerMode]) : LowerModeSimd
  (match mode
    [(CompilerLowerMode.Scalar) (Scalar)]
    [(CompilerLowerMode.LinuxScalar) (Scalar)]
    [(CompilerLowerMode.WindowsScalar) (Scalar)]
    [(CompilerLowerMode.Avx2) (Avx2)]
    [(CompilerLowerMode.LinuxAvx2) (Avx2)]
    [(CompilerLowerMode.WindowsAvx2) (Avx2)]
    [(CompilerLowerMode.Avx512) (Avx512)]
    [(CompilerLowerMode.LinuxAvx512) (Avx512)]
    [(CompilerLowerMode.WindowsAvx512) (Avx512)]))

(define (lower-mode-of [abi : LowerModeAbi] [simd : LowerModeSimd]) : CompilerLowerMode
  (match abi
    [(None)
      (match simd
        [(Scalar) (CompilerLowerMode.Scalar)]
        [(Avx2) (CompilerLowerMode.Avx2)]
        [(Avx512) (CompilerLowerMode.Avx512)])]
    [(Linux)
      (match simd
        [(Scalar) (CompilerLowerMode.LinuxScalar)]
        [(Avx2) (CompilerLowerMode.LinuxAvx2)]
        [(Avx512) (CompilerLowerMode.LinuxAvx512)])]
    [(Windows)
      (match simd
        [(Scalar) (CompilerLowerMode.WindowsScalar)]
        [(Avx2) (CompilerLowerMode.WindowsAvx2)]
        [(Avx512) (CompilerLowerMode.WindowsAvx512)])]))

;; Width in bytes of one SPMD vector register: 0 in scalar mode.
(define (lower-simd-vector-bytes [mode : CompilerLowerMode]) : i64
  (match (lower-mode-simd mode)
    [(Scalar) 0]
    [(Avx2) 32]
    [(Avx512) 64]))

(defstruct LowerMaskedLoadCacheData
  (array-vars (__tl_dyn-array i64))
  (offsets (__tl_dyn-array i64))
  (masks (__tl_dyn-array i64))
  (values (__tl_dyn-array ir.CompilerIrValue))
  (count i64)
  (mask-vars (__tl_dyn-array i64))
  (mask-parents (__tl_dyn-array i64))
  (mask-count i64))

(defenum LowerMaybeMaskedLoadCache
  (No)
  (Some (Box LowerMaskedLoadCacheData)))

;; Values materialized before a recursive masked foreach. Uniform vectors are
;; keyed by both their scalar IR value and lane type: the masked path can carry
;; more than one scalar type even though every operation has the same lane
;; count. Array entries hold dynamic-sequence data pointers, not lane loads.
(defstruct LowerMaskedPreheaderCacheData
  (uniform-instrs ir.CompilerIrInstrBuilder)
  (uniform-values (__tl_dyn-array ir.CompilerIrValue))
  (uniform-types (__tl_dyn-array ast.AstType))
  (uniform-vectors (__tl_dyn-array ir.CompilerIrValue))
  (uniform-count i64)
  (array-vars (__tl_dyn-array i64))
  (array-data (__tl_dyn-array ir.CompilerIrValue))
  (array-count i64))

(defenum LowerMaybeMaskedPreheaderCache
  (No)
  (Some (Box LowerMaskedPreheaderCacheData)))

;; Lowering threads one state through every expression in a function. Keep the
;; public carrier to one word and mutate its function-owned cell in place:
;; returning the former wide value from every variable allocation, emission,
;; and label transition copied the complete state through `tl_memcpy` millions
;; of times. Builders were already shared mutable storage, so this preserves
;; the existing linear state semantics while making that ownership explicit.
(defstruct LowerStateData
  (next-var i64)
  (next-label i64)
  (next-lambda i64)
  (current-label i64)
  (current-instrs ir.CompilerIrInstrBuilder)
  (blocks ir.CompilerIrBlockBuilder)
  (functions ir.CompilerIrFunctionBuilder)
  ;; Exact interned IR function identity. Derive display text only where
  ;; needed; re-interning that text can select a different provenance ID.
  (function i64)
  (spans (Box ir.CompilerSourceSpans))
  (names LowerNameCache)
  (type-cache LowerTypeCache)
  (function-state CompilerLowerFunctionState)
  (mode CompilerLowerMode)
  (address-taken lower_i64_i64_map.Map)
  ;; Tail-call-safe current function parameter var range: [start, end).
  (tail-param-start i64)
  (tail-param-end i64)
  ;; Allocated only when this function enters masked SPMD lowering.
  (masked-load-cache LowerMaybeMaskedLoadCache)
  ;; Attached only while lowering one masked vector loop and its vector tail.
  (masked-preheader-cache LowerMaybeMaskedPreheaderCache)
  ;; Deferred Copy bindings (`lower-bind-payload-name`): var -> the var holding
  ;; the address its value is read from at each use.
  (deferred-copies lower_i64_i64_map.Map)
  ;; The body of the borrowed enum match arm whose payloads are being bound,
  ;; or -1; set only while `lower-bind-match-variant-payloads` runs.
  (deferred-arm-body i64))

;; The carrier is the cell's address, so it is Copy (the sym_i64_env idiom):
;; every holder already shared the one cell through the box, and the explicit
;; fork seams copy the cell itself (`lower-state-clone`).
(defstruct LowerState
  (address u64))

(define (lower-state-from-box [data : (Box LowerStateData)]) : LowerState
  (LowerState
    (unsafe
      (ptr-read (ptr-cast (ptr-addr-of data) : (Ptr u64))))))

;; The state's cell, as the box every accessor projects fields through.
(defmacro (lower-state-box [state : Expr]) : Expr
  `(let
    [handle : LowerState ,state]
    (unsafe
      (ptr-read (ptr-cast (ptr-addr-of handle) : (Ptr (Box LowerStateData)))))))

(define (lower-state-new
  [next-var : i64]
  [next-label : i64]
  [next-lambda : i64]
  [current-label : i64]
  [current-instrs : ir.CompilerIrInstrBuilder]
  [blocks : ir.CompilerIrBlockBuilder]
  [functions : ir.CompilerIrFunctionBuilder]
  [function : i64]
  [spans : (Box ir.CompilerSourceSpans)]
  [names : LowerNameCache]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [address-taken : lower_i64_i64_map.Map]
  [tail-param-start : i64]
  [tail-param-end : i64]) : LowerState
  (lower-state-from-box
    (box
      (LowerStateData
        next-var
        next-label
        next-lambda
        current-label
        current-instrs
        blocks
        functions
        function
        spans
        names
        type-cache
        function-state
        mode
        address-taken
        tail-param-start
        tail-param-end
        (No)
        (No)
        (lower_i64_i64_map.with-capacity 1)
        -1))))

;; Most lowering transitions consume their state linearly. A few control-flow
;; builders deliberately fork from a shared snapshot; clone only at those
;; explicit seams so the fork keeps the former by-value counter/builder heads.
(define (lower-state-clone [state : LowerState]) : LowerState
  (let
    [data : (Box LowerStateData) (lower-state-box state)]
    (lower-state-from-box (box (__tl-box-place data)))))

(defenum LowerMaybeArrayVar
  (No)
  (Some i64 ast.AstType))

(defenum LowerMaybeIrValue
  (No)
  (Some ir.CompilerIrValue))

(defenum LowerMaybeAstExpr
