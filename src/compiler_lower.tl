(define (lower-test-decl-list-count [decls : AstDeclList]) : i64
  (match decls
    [(AstDeclList.Nil) 0]
    [(AstDeclList.Cons _ rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (+ 1 (lower-test-decl-list-count rest)))]))

(define (lower-test-decl-list-defines? [decls : AstDeclList] [name : String]) : bool
  (match decls
    [(AstDeclList.Nil) false]
    [(AstDeclList.Cons decl rest)
      (let
        [rest : AstDeclList (box-get rest)]
        (match decl
          [(AstDecl.DefFn found _ _ _ _)
            (if (string.eq (intern-str found) name)
              true
              (lower-test-decl-list-defines? rest name))]
          [(AstDecl.DefEnum found _ _)
            (if (string.eq (intern-str found) name)
              true
              (lower-test-decl-list-defines? rest name))]
          [(AstDecl.DefEnumLifetimes found _ _ _)
            (if (string.eq (intern-str found) name)
              true
              (lower-test-decl-list-defines? rest name))]
          [(AstDecl.DefStruct found _ _ _)
            (if (string.eq (intern-str found) name)
              true
              (lower-test-decl-list-defines? rest name))]
          [(AstDecl.DefStructLifetimes found _ _ _ _)
            (if (string.eq (intern-str found) name)
              true
              (lower-test-decl-list-defines? rest name))]
          [(AstDecl.ComptimeDecl _ inner-box)
            (let
              [inner : AstDecl (box-get inner-box)]
              (if (lower-test-decl-list-defines?
                (ast-decl-cons inner AstDeclList.Nil)
                name)
                true
                (lower-test-decl-list-defines? rest name)))]
          [(AstDecl.Unsafe inner-box)
            (let
              [inner : AstDecl (box-get inner-box)]
              (if (lower-test-decl-list-defines?
                (ast-decl-cons inner AstDeclList.Nil)
                name)
                true
                (lower-test-decl-list-defines? rest name)))]
          [_ (lower-test-decl-list-defines? rest name)]))]))

(define (compiler-lower-ast-dce-program) : AstProgram
  (ast-program
    (ast-decl-cons
      (ast-decl-def
        "callback"
        AstMaybeType.No
        (ast-node-push (AstExpr.Var (intern "callback-target"))))
      (ast-decl-cons
        (ast-decl-def-fn
          "main"
          AstParamList.Nil
          (AstType.I64)
          (ast-expr-call
            (ast-node-push (AstExpr.Var (intern "helper")))
            AstExprList.Nil))
        (ast-decl-cons
          (ast-decl-def-fn
            "helper"
            AstParamList.Nil
            (AstType.I64)
            (ast-node-push (AstExpr.Literal (ast-lit-int 7))))
          (ast-decl-cons
            (ast-decl-def-fn
              "callback-target"
              AstParamList.Nil
              (AstType.I64)
              (ast-node-push (AstExpr.Literal (ast-lit-int 11))))
            (ast-decl-cons
              (ast-decl-def-fn
                "dead"
                AstParamList.Nil
                (AstType.I64)
                (ast-node-push (AstExpr.Literal (ast-lit-int 9))))
              AstDeclList.Nil)))))))

