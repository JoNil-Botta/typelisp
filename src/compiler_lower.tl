(cfg compile-profile (import stdlib.profile))
(import stdlib.io)
(import sym_i64_env)

(defstruct LowerNameBinding
  ;; Source/logical identities and the renderable logical symbol. Spellings are
  ;; owned once by the active interner and recovered only when emitted.
  (source-id i64)
  (logical-id i64)
  (symbol-id i64)
  (parent i64))

(defstruct LowerNameFlatBinding
  (source-id i64)
  (logical-id i64)
  (symbol-id i64))

;; Bindings are append-only in fixed segments. Parent indices span the segments;
;; growing the small segment directory never relocates a binding. A snapshot is
;; just a shared store plus an independent head/count pair, so extending a child
;; cannot change its parent.
(defstruct LowerNameStore
  (segments (__tl_dyn-array (__tl_dyn-array LowerNameBinding)))
  (segment-count i64)
  (len i64)
  (arena i64))

(defenum LowerNameEnv
  (Nil)
  (Inline i64 i64 i64)
  (Dense (Box LowerNameStore) i64 i64))

(defenum LowerNameEnvView
  (Nil)
  (Bind i64 i64 i64 LowerNameEnv))

(define (lower-name-store-new) : LowerNameStore
  (let
    [segments : (__tl_dyn-array (__tl_dyn-array LowerNameBinding))
      (__tl_make-array (__tl_dyn-array LowerNameBinding) 4)]
    [first : (__tl_dyn-array LowerNameBinding)
      (__tl_make-array LowerNameBinding 16)]
    [owner : i64 (arena.tl_arena_current)]
    (set! (array-ref segments 0) first)
    (LowerNameStore segments 1 0 owner)))

(define (lower-name-store-segments-copy-range!
  [dst : (&mut dst (__tl_dyn-array (__tl_dyn-array LowerNameBinding)))]
  [src : (& src (__tl_dyn-array (__tl_dyn-array LowerNameBinding)))]
  [count : i64]) : unit
  (let
    [index : i64 0]
    (while (< index count)
      (set! (array-ref dst index) (array-ref src index))
      (set! index (+ index 1)))))

(define (lower-name-store-add-segment! [store : (&mut store LowerNameStore)]) : unit
  (let
    [count : i64 store.segment-count]
    [capacity : i64 (array-length store.segments)]
    [owner : i64 store.arena]
    (in-arena
      (arena.Arena owner)
      (if (< count capacity)
        unit
        (let
          [bigger : (__tl_dyn-array (__tl_dyn-array LowerNameBinding))
            (__tl_make-array
              (__tl_dyn-array LowerNameBinding)
              (if (< capacity 1)
                4
                (* capacity 2)))]
          (lower-name-store-segments-copy-range!
            (&mut bigger)
            (& store.segments)
            count)
          (set! store.segments bigger)))
      (set!
        (array-ref store.segments count)
        (__tl_make-array LowerNameBinding 16))
      (set! store.segment-count (+ count 1)))))

(define (lower-name-store-ensure-index!
  [store : (&mut store LowerNameStore)]
  [index : i64]) : unit
  (let
    [segment-index : i64 (/ index 16)]
    (while (>= segment-index store.segment-count)
      (lower-name-store-add-segment! store))))

(define (lower-name-store-write-index!
  [store : (&mut store LowerNameStore)]
  [index : i64]
  [binding : LowerNameBinding]) : unit
  (let
    [segment-index : i64 (/ index 16)]
    [offset : i64 (- index (* segment-index 16))]
    [segment : (__tl_dyn-array LowerNameBinding)
      (lower-global-array-element-shared-view store.segments segment-index)]
    (set! (array-ref segment offset) binding)))

(define (lower-name-store-binding-at
  [store : (& store LowerNameStore)]
  [index : i64]) : LowerNameBinding
  ;; Every index comes from a successful push or a checked materialization.
  ;; The raw read avoids repeating a dynamic bounds check on each parent hop.
  (let
    [segment-index : i64 (/ index 16)]
    [offset : i64 (- index (* segment-index 16))]
    [segment : (__tl_dyn-array LowerNameBinding)
      (lower-global-array-element-shared-view store.segments segment-index)]
    (unsafe
      (ptr-read (ptr-offset (__tl_array-data segment) offset)))))

(define (lower-name-store-push!
  [store : (&mut store LowerNameStore)]
  [binding : LowerNameBinding]) : i64
  (let
    [index : i64 store.len]
    (lower-name-store-ensure-index! store index)
    (lower-name-store-write-index! store index binding)
    (set! store.len (+ index 1))
    index))

(define (lower-name-env-bind-ids-raw
  [source-id : i64]
  [logical-id : i64]
  [symbol-id : i64]
  [rest : LowerNameEnv]) : LowerNameEnv
  (match rest
    [(Nil) (Inline source-id logical-id symbol-id)]
    [(Inline parent-source-id parent-logical-id parent-symbol-id)
      (let
        [store : (Box LowerNameStore) (box (lower-name-store-new))]
        [parent : i64
          (lower-name-store-push!
            (&mut (__tl-box-place store))
            (LowerNameBinding
              parent-source-id
              parent-logical-id
              parent-symbol-id
              -1))]
        [head : i64
          (lower-name-store-push!
            (&mut (__tl-box-place store))
            (LowerNameBinding source-id logical-id symbol-id parent))]
        (Dense store head 2))]
    [(Dense store parent count)
      (let
        [head : i64
          (lower-name-store-push!
            (&mut (__tl-box-place store))
            (LowerNameBinding source-id logical-id symbol-id parent))]
        (Dense store head (+ count 1)))]))

(define (lower-name-env-bind-ids
  [source-id : i64]
  [logical-id : i64]
  [symbol-id : i64]
  [rest : LowerNameEnv]) : LowerNameEnv
  (lower-name-env-bind-ids-raw source-id logical-id symbol-id rest))

(define (lower-name-env-view [names : LowerNameEnv]) : LowerNameEnvView
  (match names
    [(Nil) Nil]
    [(Inline source-id logical-id symbol-id)
      (Bind source-id logical-id symbol-id Nil)]
    [(Dense store head count)
      (let
        [binding : LowerNameBinding
          (lower-name-store-binding-at (& (__tl-box-place store)) head)]
        [parent : i64 binding.parent]
        (Bind
          binding.source-id
          binding.logical-id
          binding.symbol-id
          (if (< parent 0)
            Nil
            (Dense store parent (- count 1)))))]))

;; Like LowerTypeCache, a LowerNameCache carries a `parent` marker.
;; `LowerNameParent.None` is a complete cache (a miss returns the source name
;; unchanged). `LowerNameParent.Global` marks a small per-module overlay that, on
;; a miss, falls through to its owner's whole-program lowering name cache.
;; Each lowering sub-phase that builds
;; per-module name caches (the prune body-index reachability pass and the decl
;; lowering loop) sets that global to its whole-program name cache once before
;; building module overlays; the phases never overlap, so they share the slot.
;; This makes each module's name cache a small overlay of just its module-local
;; names over the shared global cache instead of rebuilding the whole global name
;; set per module (was O(modules x global-names)). A marker plus the opaque owner
;; address lets every module overlay share that cache without copying it.
(defenum LowerNameParent
  (None)
  (Global))

(defstruct LowerModulePathIndex
  (edges lower_i64_i64_map.Map)
  (terminals lower_i64_i64_map.Map)
  (modules lower_i64_i64_map.Map)
  (next-node i64))

(define (lower-module-path-index-empty) : LowerModulePathIndex
  (LowerModulePathIndex
    (lower_i64_i64_map.with-capacity 8)
    (lower_i64_i64_map.with-capacity 8)
    (lower_i64_i64_map.with-capacity 8)
    1))

(defstruct LowerNameCache
  (ids lower_i64_i64_map.Map)
  (logical-ids (__tl_dyn-array i64))
  (symbol-ids (__tl_dyn-array i64))
  (logical-symbols lower_i64_i64_map.Map)
  (module-paths LowerModulePathIndex)
  (clone-roots clone_support.CloneRootEntries)
  (module-id i64)
  (parent LowerNameParent)
  ;; Opaque owner address for the per-program caches/selectors used by
  ;; `LowerNameParent.Global`. Keeping the capability in every cache makes the
  ;; state flow through the existing lowering context instead of installing a
  ;; process-global current-state selector.
  (owner-address i64))

(defmacro (lower-global-shared-view [place : Expr]) : Expr
  `(unsafe
    (ptr-read (ptr-addr-of ,place))))

(defmacro (lower-global-array-element-shared-view [items : Expr] [index : Expr]) : Expr
  `(unsafe
    (ptr-read (ptr-offset (__tl_array-data ,items) ,index))))

(defmacro (lower-box-shared-view [value : Expr]) : Expr
  `(owned_view.compiler-owned-box-shared-view ,value))

(defmacro (lower-box-field-shared-view [value : Expr] [field : Expr]) : Expr
  `(let
    [payload (lower-box-shared-view ,value)]
    (lower-global-shared-view (__tl-project-field payload ,field))))

(defmacro (lower-boxed-box-field-shared-view [value : Expr] [field : Expr]) : Expr
  `(let
    [field-box (lower-box-field-shared-view ,value ,field)]
    (lower-box-shared-view field-box)))

(defenum LowerSpmdPackageSymbolRegistration
  (New)
  (Existing)
  (Collision String))

(define (lower-empty-global-name-cache [owner-address : i64]) : LowerNameCache
  (LowerNameCache
    (lower_i64_i64_map.with-capacity 8)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (lower_i64_i64_map.with-capacity 8)
    (lower-module-path-index-empty)
    (Empty)
    cbi.compiler-builtin-id-fix-empty
    (None)
    owner-address))

;; LowerTypeCache.Some carries a `parent` marker. `LowerTypeParent.None`
;; is a complete cache (a miss = unbound). `LowerTypeParent.Global` marks a small
;; per-module overlay that, on a miss, falls through to the owner's shared
;; decl-lowering type cache (set once per
;; lower-decls run). This lets each module's type cache be a small overlay of
;; just the module-local type bindings over the shared global cache, instead of
;; rebuilding the whole global type set into a fresh cache at every module
;; boundary (was O(modules x global-types)). The marker's cache variant carries
;; the opaque owner address because move semantics forbid sharing an owned parent
;; value directly across every module overlay.
(defenum LowerTypeParent
  (None)
  (Global))

(defenum LowerTypeCache
  (No)
  (Some
    lower_i64_i64_map.Map
    (__tl_dyn-array ast.AstType)
    i64
    LowerTypeParent
    i64))

;; Flattened dotted imports emit a module marker when entering an imported file
;; and another when returning to its importer. Lowering can therefore revisit
;; one module many times even though its immutable local name/type view is
;; unchanged. Keep one phase-local entry per distinct module instead of
;; rebuilding the overlay at every marker.
(defenum LowerMaybeModuleNameCache
  (No)
  (Some LowerNameCache))

;; Module IDs are sparse logical intern IDs. Map each one to an append-only
;; dense slot rather than sizing storage by the largest process-wide ID.
;; Name caches and local views deliberately keep separate indexes: their phase
;; entry points reset independently before reach/body indexing and decl lowering.
(defstruct LowerModuleNameCacheStore
  (modules lower_i64_i64_map.Map)
  (values (__tl_dyn-array LowerNameCache))
  (len i64))

(defstruct LowerModuleLocalView
  (local-top-env tc_core.TcTypeEnv)
  (name-cache LowerNameCache)
  (type-cache LowerTypeCache))

(defenum ResultLowerModuleLocalView
  (Ok LowerModuleLocalView)
  (Err String))

(defenum LowerMaybeModuleLocalView
  (No)
  (Some LowerModuleLocalView))

(defstruct LowerModuleLocalViewStore
  (modules lower_i64_i64_map.Map)
  (values (__tl_dyn-array LowerModuleLocalView))
  (len i64))

(define (lower-module-name-cache-store-empty) : LowerModuleNameCacheStore
  (LowerModuleNameCacheStore
    (lower_i64_i64_map.with-capacity 16)
    (__tl_make-array LowerNameCache 8)
    0))

(define (lower-module-local-view-store-empty) : LowerModuleLocalViewStore
  (LowerModuleLocalViewStore
    (lower_i64_i64_map.with-capacity 16)
    (__tl_make-array LowerModuleLocalView 8)
    0))

;; Contiguous id set: `slots[0, len)` holds the members oldest first, so the old
;; head-first cons walk is the descending index walk. `lower-id-set-insert` is
;; persistent and copies into a right-sized array, because callers keep both a
;; set and an extension of it live at the same time. Only the reach worklist,
;; which threads one state linearly, uses the in-place push/pop pair.
(defstruct LowerIdSet
  (slots (__tl_dyn-array i64))
  (len i64))

(defenum LowerSpmdScalarCallContext
  (No)
  (Some String))

(defenum LowerVariantArmResolution
  (Missing String)
  (FieldsErr String)
  (Some String ast.AstType i64 ast.AstTypeList i64))

;; Parallel key/value arrays in cons order (oldest first). Lookup scans from the
;; tail so the most recent binding still shadows, and both `cons` and `remove`
;; build fresh arrays so every substitution value stays independent.
(defstruct LowerSpmdInlineSubst
  (names (__tl_dyn-array i64))
  (values (__tl_dyn-array ast.AstExpr))
  (len i64))

;; Function reachability is ID-native. `all-functions` maps the canonical
;; logical ID to a dense slot, `reachable` is slot-keyed, and the worklist/body
;; index carry the same logical ID. Display strings never participate in graph
;; identity.
(defenum LowerUsedTypePathSeed
  (Seed lower_i64_i64_map.Map bool))

(defenum LowerMaybeFunctionBody
  (No)
  (Some ast.AstExpr LowerNameCache i64))

;; Job-owned lowerer state. The public carrier is one machine word; mutable
;; storage lives in the driver's lifetime arena and is never selected through a
;; process-global "current lower state". The already-landed arena carrier is a
;; substate so one owner covers traversal/index state and lowerer arenas.
(defstruct CompilerLowerArenaState
  (scratch-arena (__tl_dyn-array i64))
  (ir-arena (__tl_dyn-array i64)))

;; The cache is one owner-private dense cell. Its 15 scalar entries replace the
;; former process globals without copying a wide aggregate on every call query.
(define lower-comptime-cache-size : i64
  15)
(define lower-comptime-cache-generation-index : i64
  0)
(define lower-comptime-cache-table-id-index : i64
  1)
(define lower-comptime-cache-id-index : i64
  2)
(define lower-comptime-cache-comptime-dot-id-index : i64
  3)
(define lower-comptime-cache-comptime-slash-id-index : i64
  4)
(define lower-comptime-cache-comptime-error-dot-id-index : i64
  5)
(define lower-comptime-cache-comptime-error-slash-id-index : i64
  6)
(define lower-comptime-cache-stdlib-dot-dot-id-index : i64
  7)
(define lower-comptime-cache-stdlib-dot-slash-id-index : i64
  8)
(define lower-comptime-cache-stdlib-slash-dot-id-index : i64
  9)
(define lower-comptime-cache-stdlib-slash-slash-id-index : i64
  10)
(define lower-comptime-cache-stdlib-error-dot-dot-id-index : i64
  11)
(define lower-comptime-cache-stdlib-error-dot-slash-id-index : i64
  12)
(define lower-comptime-cache-stdlib-error-slash-dot-id-index : i64
  13)
(define lower-comptime-cache-stdlib-error-slash-slash-id-index : i64
  14)

(define (lower-comptime-error-id-cache-empty) : (__tl_dyn-array i64)
  (let
    [cache : (__tl_dyn-array i64)
      (__tl_make-array i64 lower-comptime-cache-size)]
    (set! (array-ref cache lower-comptime-cache-generation-index) -1)
    (set! (array-ref cache lower-comptime-cache-table-id-index) -1)
    cache))

;; The owner points at a fixed directory of typed cell addresses. Keeping the
;; directory untyped avoids reflecting one giant aggregate (and recomputing its
;; layout at every accessor expansion) while every mutable value still has one
;; stable, owner-private cell.
(define active-global-name-cache : i64
  0)
(define decls-global-type-cache : i64
  1)
(define rvo-early-return-functions : i64
  2)
(define reach-active-runtime-paths : i64
  3)
(define reach-active-body-used-types : i64
  4)
(define current-source-path-id : i64
  5)
(define current-decl-generated : i64
  6)
(define active-symbols : i64
  7)
(define active-symbols-ready : i64
  8)
(define active-module-name-caches : i64
  9)
(define active-module-local-views : i64
  10)
(define active-loop-function : i64
  11)
(define active-loop-entry-var-limit : i64
  12)
(define alias-overlay-ids : i64
  13)
(define alias-overlay-valid : i64
  14)
(define alias-symbol-memo : i64
  15)
(define canonical-path-count : i64
  16)
(define canonical-path-recent : i64
  17)
(define canonical-path-prior : i64
  18)
(define entry-main-module-active : i64
  19)
(define entry-main-module : i64
  20)
(define entry-main-module-id : i64
  21)
(define module-decl-index-ready : i64
  22)
(define module-decl-index-decl-count : i64
  23)
(define module-decl-index-decl-offset : i64
  24)
(define module-decl-index-modules : i64
  25)
(define module-decl-index-starts : i64
  26)
(define module-decl-index-ends : i64
  27)
(define module-decl-index-positions : i64
  28)
(define module-decl-index-arena : i64
  29)
(define arenas : i64
  30)
(define intern-owner : i64
  31)
(define comptime-error-cache : i64
  32)
(define checked-pools : i64
  33)
(define spmd-package-state : i64
  34)
(define function-memo-storage : i64
  35)
(define structural-session-owner : i64
  36)
(define profile-owner : i64
  37)
(define advisory-sink-owner : i64
  (cfg (any compile-profile test) 38 37))
(define pointer-proof-request : i64
  (cfg (any compile-profile test) 39 38))
(define debug-types : i64
  (cfg (any compile-profile test) 40 39))

;; Package identity is job-owned. Function-local lowering keeps its four SPMD
;; traversal values and two memo generations in a separate one-word capability;
;; only the lazily allocated memo backing is retained by the job for reuse.
(defstruct CompilerLowerSpmdPackageState
  (arena i64)
  (name String)
  ;; Structural linker-spelling key -> structural SPMD identity handle. The
  ;; full ABI serialization is never retained as the equality key.
  (symbol-identities lower_i64_i64_map.Map)
  ;; Identity handle -> stable v1 hash. Hashing is an allowed ABI boundary;
  ;; cache it so repeated equal recipes do not serialize or hash again.
  (identity-stable-hashes lower_i64_i64_map.Map))

(defstruct CompilerLowerFunctionMemoStorage
  (arena i64)
  (rtf-generations (__tl_dyn-array i64))
  (rtf-ids (__tl_dyn-array i64))
  (rtf-types (__tl_dyn-array ast.AstType))
  (next-rtf-generation i64)
  (variant-stamps (__tl_dyn-array i64))
  (variant-keys (__tl_dyn-array i64))
  (variant-scrutinee-types (__tl_dyn-array ast.AstType))
  (variant-outcomes (__tl_dyn-array LowerVariantArmResolution))
  (next-variant-generation i64))

(defstruct CompilerLowerFunctionStateData
  (owner-address i64)
  (inline-helper-stack LowerIdSet)
  (inline-recursion-detected bool)
  (inline-next-temp i64)
  (scalar-call-context LowerSpmdScalarCallContext)
  (rtf-generation i64)
  (variant-generation i64))

(defstruct CompilerLowerFunctionState
  (address i64))

(define (compiler-lower-spmd-package-state-empty) : CompilerLowerSpmdPackageState
  (CompilerLowerSpmdPackageState
    0
    ""
    (lower_i64_i64_map.with-capacity 0)
    (lower_i64_i64_map.with-capacity 0)))

(define (compiler-lower-function-memo-storage-empty) : CompilerLowerFunctionMemoStorage
  (CompilerLowerFunctionMemoStorage
    (arena.tl_arena_current)
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array ast.AstType 0)
    0
    (__tl_make-array i64 0)
    (__tl_make-array i64 0)
    (__tl_make-array ast.AstType 0)
    (__tl_make-array LowerVariantArmResolution 0)
    0))

;; Checked-pool compaction crosses the typecheck/lower result boundary: source
;; storage can already be retired before lowering reports an error, while a
;; committed destination must remain available for the driver to adopt. Keep
;; the complete transition in one job-owned record. `NoContext` makes the
;; inactive state unable to expose a pool whose arena has already been retired.
(defenum CompilerLowerCheckedPoolsContext
  (NoContext)
  (Context ast.AstNodePoolContext))

(defstruct CompilerLowerCheckedPoolsState
  (active bool)
  (committed bool)
  (context CompilerLowerCheckedPoolsContext)
  (source-release-arena i64)
  (source-release-expr-storage-arena i64)
  (source-release-type-storage-arena i64)
  (frontend-release-arena i64)
  (frontend-released bool)
  (rolled-over bool)
  (deferred bool)
  (deferred-expr-capacity i64)
  (deferred-type-capacity i64))

(define (compiler-lower-checked-pools-state-empty) : CompilerLowerCheckedPoolsState
  (CompilerLowerCheckedPoolsState
    false
    false
    (NoContext)
    0
    0
    0
    0
    false
    false
    false
    0
    0))

(defstruct CompilerLowerState
  (address i64))

(defmacro (compiler-lower-state-read [state : Expr] [_T : type] [field : Expr]) : Expr
  `(unsafe
    (ptr-read
      (int->ptr
        (cast
          (unsafe
            (ptr-read
              (ptr-offset
                (int->ptr
                  (cast ,(comptime.expr-struct-get state "address") : u64)
                  : (Ptr i64))
                ,field)))
          : u64)
        : (Ptr ,_T)))))

(defmacro (compiler-lower-state-write!
  [state : Expr]
  [_T : type]
  [field : Expr]
  [value : Expr]) : Expr
  `(unsafe
    (ptr-write!
      (int->ptr
        (cast
          (unsafe
            (ptr-read
              (ptr-offset
                (int->ptr
                  (cast ,(comptime.expr-struct-get state "address") : u64)
                  : (Ptr i64))
                ,field)))
          : u64)
        : (MutPtr ,_T))
      ,value)))

(defmacro (compiler-lower-state-cell [_T : type] [value : Expr]) : Expr
  `(let
    [cell : (__tl_dyn-array ,_T) (__tl_make-array ,_T 1)]
    (set! (array-ref cell 0) ,value)
    (cast
      (unsafe
        (ptr->int (ptr-cast (__tl_array-data cell) : (Ptr ,_T))))
      : i64)))

(define (compiler-lower-state-from-address [address : i64]) : CompilerLowerState
  (CompilerLowerState address))

(define (compiler-lower-state-from-name-cache
  [cache : (& cache LowerNameCache)]) : CompilerLowerState
  (compiler-lower-state-from-address cache.owner-address))

(define (compiler-lower-state-new-with-intern-state-and-profile-state
  [intern-state : ci.InternCompatState]
  [_profile-state : profile_state.CompilerProfileState]) : CompilerLowerState
  (let
    [cells : (__tl_dyn-array i64)
      (__tl_make-array i64 (cfg (any compile-profile test) 41 40))]
    [address : i64
      (cast
        (unsafe
          (ptr->int (ptr-cast (__tl_array-data cells) : (Ptr i64))))
        : i64)]
    [state : CompilerLowerState (CompilerLowerState address)]
    (begin
      (set!
        (array-ref cells active-global-name-cache)
        (compiler-lower-state-cell
          LowerNameCache
          (lower-empty-global-name-cache address)))
      (set!
        (array-ref cells decls-global-type-cache)
        (compiler-lower-state-cell LowerTypeCache (LowerTypeCache.No)))
      (set!
        (array-ref cells rvo-early-return-functions)
        (compiler-lower-state-cell
          lower_i64_i64_map.Map
          (lower_i64_i64_map.with-capacity 8)))
      (set!
        (array-ref cells reach-active-runtime-paths)
        (compiler-lower-state-cell
          lower_i64_i64_map.Map
          (lower_i64_i64_map.with-capacity 8)))
      (set!
        (array-ref cells reach-active-body-used-types)
        (compiler-lower-state-cell
          lower_i64_i64_map.Map
          (lower_i64_i64_map.with-capacity 8)))
      (set!
        (array-ref cells current-source-path-id)
        (compiler-lower-state-cell i64 0))
      (set!
        (array-ref cells current-decl-generated)
        (compiler-lower-state-cell bool false))
      (set!
        (array-ref cells active-symbols)
        (compiler-lower-state-cell
          csym.CompilerSymbols
          (csym.compiler-symbols-empty)))
      (set!
        (array-ref cells active-symbols-ready)
        (compiler-lower-state-cell bool false))
      (set!
        (array-ref cells active-module-name-caches)
        (compiler-lower-state-cell
          LowerModuleNameCacheStore
          (lower-module-name-cache-store-empty)))
      (set!
        (array-ref cells active-module-local-views)
        (compiler-lower-state-cell
          LowerModuleLocalViewStore
          (lower-module-local-view-store-empty)))
      (set!
        (array-ref cells active-loop-function)
        (compiler-lower-state-cell i64 -1))
      (set!
        (array-ref cells active-loop-entry-var-limit)
        (compiler-lower-state-cell i64 -1))
      (set!
        (array-ref cells alias-overlay-ids)
        (compiler-lower-state-cell
          lower_i64_i64_map.Map
          (lower_i64_i64_map.with-capacity 16)))
      (set!
        (array-ref cells alias-overlay-valid)
        (compiler-lower-state-cell bool true))
      (set!
        (array-ref cells alias-symbol-memo)
        (compiler-lower-state-cell (__tl_dyn-array i64) (__tl_make-array i64 0)))
      (set!
        (array-ref cells canonical-path-count)
        (compiler-lower-state-cell i64 0))
      (set!
        (array-ref cells canonical-path-recent)
        (compiler-lower-state-cell String ""))
      (set!
        (array-ref cells canonical-path-prior)
        (compiler-lower-state-cell String ""))
      (set!
        (array-ref cells entry-main-module-active)
        (compiler-lower-state-cell bool false))
      (set!
        (array-ref cells entry-main-module)
        (compiler-lower-state-cell String ""))
      (set!
        (array-ref cells entry-main-module-id)
        (compiler-lower-state-cell i64 cbi.compiler-builtin-id-fix-empty))
      (set!
        (array-ref cells module-decl-index-ready)
        (compiler-lower-state-cell bool false))
      (set!
        (array-ref cells module-decl-index-decl-count)
        (compiler-lower-state-cell i64 -1))
      (set!
        (array-ref cells module-decl-index-decl-offset)
        (compiler-lower-state-cell i64 -1))
      (set!
        (array-ref cells module-decl-index-modules)
        (compiler-lower-state-cell
          lower_i64_i64_map.Map
          (lower_i64_i64_map.with-capacity 16)))
      (set!
        (array-ref cells module-decl-index-starts)
        (compiler-lower-state-cell (__tl_dyn-array i64) (__tl_make-array i64 0)))
      (set!
        (array-ref cells module-decl-index-ends)
        (compiler-lower-state-cell (__tl_dyn-array i64) (__tl_make-array i64 0)))
      (set!
        (array-ref cells module-decl-index-positions)
        (compiler-lower-state-cell (__tl_dyn-array i64) (__tl_make-array i64 0)))
      (set!
        (array-ref cells module-decl-index-arena)
        (compiler-lower-state-cell i64 0))
      (set!
        (array-ref cells arenas)
        (compiler-lower-state-cell
          CompilerLowerArenaState
          (compiler-lower-arena-state-new)))
      (set!
        (array-ref cells intern-owner)
        (compiler-lower-state-cell ci.InternCompatState intern-state))
      (set!
        (array-ref cells comptime-error-cache)
        (compiler-lower-state-cell
          (__tl_dyn-array i64)
          (lower-comptime-error-id-cache-empty)))
      (set!
        (array-ref cells checked-pools)
        (compiler-lower-state-cell
          CompilerLowerCheckedPoolsState
          (compiler-lower-checked-pools-state-empty)))
      (set!
        (array-ref cells spmd-package-state)
        (compiler-lower-state-cell
          CompilerLowerSpmdPackageState
          (compiler-lower-spmd-package-state-empty)))
      (set!
        (array-ref cells function-memo-storage)
        (compiler-lower-state-cell
          CompilerLowerFunctionMemoStorage
          (compiler-lower-function-memo-storage-empty)))
      (set!
        (array-ref cells structural-session-owner)
        (compiler-lower-state-cell
          cis.InternStructuralSessionHandle
          (cis.intern-structural-session-handle-from-source-names
            (ci.intern-source-name-session-handle-from-state intern-state))))
      (cfg
        (any compile-profile test)
        (set!
          (array-ref cells profile-owner)
          (compiler-lower-state-cell
            profile_state.CompilerProfileState
            _profile-state))
        unit)
      (set!
        (array-ref cells advisory-sink-owner)
        (compiler-lower-state-cell
          cdiag.CompilerAdvisorySink
          (cdiag.compiler-advisory-sink-new)))
      (set!
        (array-ref cells pointer-proof-request)
        (compiler-lower-state-cell
          pointer_proof.PointerProofRequest
          pointer_proof.PointerProofRequest.Disabled))
      (set!
        (array-ref cells debug-types)
        (compiler-lower-state-cell LowerDebugTypes (lower-debug-types-empty)))
      state)))

(define (compiler-lower-state-new-with-intern-state
  [intern-state : ci.InternCompatState]) : CompilerLowerState
  (compiler-lower-state-new-with-intern-state-and-profile-state
    intern-state
    (profile_state.compiler-profile-state-new)))

;; Serial/test compatibility adapter. Driver-owned jobs construct the lower
;; carrier with their explicit intern capability instead.
(define (compiler-lower-state-new) : CompilerLowerState
  (compiler-lower-state-new-with-intern-state
    (ci.intern-compat-state-capture-active)))

(define (compiler-lower-state-arenas [state : CompilerLowerState]) : CompilerLowerArenaState
  (compiler-lower-state-read state CompilerLowerArenaState arenas))

(define (compiler-lower-state-interns [state : CompilerLowerState]) : ci.InternCompatState
  (compiler-lower-state-read state ci.InternCompatState intern-owner))

(define (compiler-lower-state-use-advisory-sink!
  [state : CompilerLowerState]
  [sink : cdiag.CompilerAdvisorySink]) : unit
  (compiler-lower-state-write!
    state
    cdiag.CompilerAdvisorySink
    advisory-sink-owner
    sink))

(define (compiler-lower-state-intern-str
  [state : CompilerLowerState]
  [id : i64]) : String
  (ci.intern-compat-state-str (compiler-lower-state-interns state) id))

(define (compiler-lower-state-intern-id-str
  [state : CompilerLowerState]
  [id : ci.InternId]) : String
  (let
    [interns : ci.InternCompatState (compiler-lower-state-interns state)]
    (ci.intern-compat-state-id-str (& interns) id)))

(define (compiler-lower-state-structural-session [state : CompilerLowerState]) : cis.InternStructuralSessionHandle
  (compiler-lower-state-read
    state
    cis.InternStructuralSessionHandle
    structural-session-owner))

;; Render a mixed source/structural name through the compile job that owns it.
;; Macro expansion can leave table-backed hygiene identities in declaration
;; and module fields. Treating those identities as raw pool indexes turns an
;; otherwise useful lowering diagnostic into an unchecked out-of-bounds read.
(define (compiler-lower-state-name-text
  [state : CompilerLowerState]
  [name-id : i64]) : String
  (let
    [session : cis.InternStructuralSessionHandle
      (compiler-lower-state-structural-session state)]
    [source-names : ci.InternSourceNameSessionHandle
      (cis.intern-structural-session-handle-source-names session)]
    [source-id : i64
      (cis.intern-structural-session-syntax-source-name-id-or
        session
        name-id
        -1)]
    (if (>= source-id 0)
      (ci.intern-source-name-session-handle-str source-names source-id)
      (match (cis.intern-structural-session-record-for-raw session name-id)
        [(Some record)
          (cond
            [(= record.kind (ci.intern-structural-kind-pair))
              (str_cat.str-cat
                (compiler-lower-state-name-text state record.left-id)
                "/"
                (compiler-lower-state-name-text state record.right-id))]
            [(= record.kind (ci.intern-structural-kind-triple))
              (str_cat.str-cat
                (compiler-lower-state-name-text state record.left-id)
                "/"
                (compiler-lower-state-name-text state record.middle-id)
                "."
                (compiler-lower-state-name-text state record.right-id))]
            [else
              (str_cat.str-cat
                "<structural-id:"
                (string.int->string name-id)
                ">")])]
        [(No) (str_cat.str-cat "<id:" (string.int->string name-id) ">")]))))

(cfg
  (any compile-profile test)
  (define (compiler-lower-state-profile [state : CompilerLowerState]) : profile_state.CompilerProfileState
    (compiler-lower-state-read
      state
      profile_state.CompilerProfileState
      profile-owner)))

(define (compiler-lower-state-checked-pools [state : CompilerLowerState]) : CompilerLowerCheckedPoolsState
  (compiler-lower-state-read state CompilerLowerCheckedPoolsState checked-pools))

(define (compiler-lower-state-checked-pools-set!
  [state : CompilerLowerState]
  [handoff : CompilerLowerCheckedPoolsState]) : unit
  (compiler-lower-state-write!
    state
    CompilerLowerCheckedPoolsState
    checked-pools
    handoff))

(define (compiler-lower-state-use-intern-state!
  [state : CompilerLowerState]
  [intern-state : ci.InternCompatState]) : unit
  (let
    [source-names : ci.InternSourceNameSessionHandle
      (ci.intern-source-name-session-handle-from-state (& intern-state))]
    (compiler-lower-state-use-intern-state-and-source-names!
      state
      intern-state
      source-names)))

(define (compiler-lower-state-use-intern-state-and-source-names!
  [state : CompilerLowerState]
  [intern-state : ci.InternCompatState]
  [source-names : ci.InternSourceNameSessionHandle]) : unit
  (compiler-lower-state-write!
    state
    ci.InternCompatState
    intern-owner
    intern-state)
  (compiler-lower-state-write!
    state
    cis.InternStructuralSessionHandle
    structural-session-owner
    (cis.intern-structural-session-handle-from-source-names source-names)))

;; Scalar snapshot used by state-isolation tests. Each fingerprint covers the
;; complete inline representation stored in the field cell (including map
;; counts/backing identities) without following storage that a finished phase
;; may already have rewound.
(defstruct CompilerLowerStateObservation
  (active-global-name-cache i64)
  (decls-global-type-cache i64)
  (rvo-early-return-functions i64)
  (reach-active-runtime-paths i64)
  (reach-active-body-used-types i64)
  (current-source-path-id i64)
  (current-decl-generated i64)
  (active-symbols i64)
  (active-symbols-ready i64)
  (active-module-name-caches i64)
  (active-module-local-views i64)
  (active-loop-function i64)
  (active-loop-entry-var-limit i64)
  (alias-overlay-ids i64)
  (alias-overlay-valid i64)
  (alias-symbol-memo i64)
  (canonical-path-count i64)
  (canonical-path-recent i64)
  (canonical-path-prior i64)
  (entry-main-module-active i64)
  (entry-main-module i64)
  (entry-main-module-id i64)
  (module-decl-index-ready i64)
  (module-decl-index-decl-count i64)
  (module-decl-index-decl-offset i64)
  (module-decl-index-modules i64)
  (module-decl-index-starts i64)
  (module-decl-index-ends i64)
  (module-decl-index-positions i64)
  (module-decl-index-arena i64)
  (intern-owner i64)
  (comptime-error-cache i64)
  (checked-pools i64)
  (spmd-package-state i64)
  (function-memo-storage i64)
  (structural-session-owner i64))

(define (compiler-lower-state-size) : i64
  (comptime (size-of (type CompilerLowerState))))

(defmacro (compiler-lower-state-field-fingerprint
  [state : Expr]
  [_T : type]
  [field : Expr]) : Expr
  `(let
    [base : i64
      (unsafe
        (ptr-read
          (ptr-offset
            (int->ptr
              (cast ,(comptime.expr-struct-get state "address") : u64)
              : (Ptr i64))
            ,field)))]
    [word-count : i64 (comptime (/ (+ (size-of (type ,_T)) 7) 8))]
    [index : i64 0]
    [out : i64 0]
    (while (< index word-count)
      (set!
        out
        (hash.combine
          out
          (hash.i64
            (unsafe
              (ptr-read
                (int->ptr (cast (+ base (* index 8)) : u64) : (Ptr i64)))))))
      (set! index (+ index 1)))
    out))

(define (lower-comptime-error-id-cache-fingerprint [state : CompilerLowerState]) : i64
  (let
    [cache : (__tl_dyn-array i64)
      (compiler-lower-state-read
        state
        (__tl_dyn-array i64)
        comptime-error-cache)]
    [index : i64 0]
    [out : i64 0]
    (while (< index lower-comptime-cache-size)
      (set! out (hash.combine out (hash.i64 (array-ref cache index))))
      (set! index (+ index 1)))
    out))

(define (compiler-lower-checked-pools-state-fingerprint
  [state : CompilerLowerState]) : i64
  (let
    [handoff : CompilerLowerCheckedPoolsState
      (compiler-lower-state-checked-pools state)]
    [context-fingerprint : i64
      (match handoff.context
        [(NoContext) 0]
        [(Context pools)
          (hash.combine
            (ast.ast-node-pool-context-base-arena pools)
            (hash.combine
              (ast.ast-node-pool-context-expr-capacity pools)
              (ast.ast-node-pool-context-type-capacity pools)))])]
    (hash.combine
      (if handoff.active
        1
        0)
      (hash.combine
        (if handoff.committed
          1
          0)
        (hash.combine
          context-fingerprint
          (hash.combine
            handoff.source-release-arena
            (hash.combine
              handoff.source-release-expr-storage-arena
              (hash.combine
                handoff.source-release-type-storage-arena
                (hash.combine
                  handoff.frontend-release-arena
                  (hash.combine
                    (if handoff.frontend-released
                      1
                      0)
                    (hash.combine
                      (if handoff.rolled-over
                        1
                        0)
                      (hash.combine
                        (if handoff.deferred
                          1
                          0)
                        (hash.combine
                          handoff.deferred-expr-capacity
                          handoff.deferred-type-capacity)))))))))))))

(define (compiler-lower-structural-session-fingerprint
  [state : CompilerLowerState]) : i64
  (let
    [session : cis.InternStructuralSessionHandle
      (compiler-lower-state-structural-session state)]
    (hash.combine
      (cis.intern-structural-session-owner session)
      (cis.intern-structural-session-current-reset-generation session))))

(define (compiler-lower-state-observe [state : CompilerLowerState]) : CompilerLowerStateObservation
  (CompilerLowerStateObservation
    (compiler-lower-state-field-fingerprint
      state
      LowerNameCache
      active-global-name-cache)
    (compiler-lower-state-field-fingerprint
      state
      LowerTypeCache
      decls-global-type-cache)
    (compiler-lower-state-field-fingerprint
      state
      lower_i64_i64_map.Map
      rvo-early-return-functions)
    (compiler-lower-state-field-fingerprint
      state
      lower_i64_i64_map.Map
      reach-active-runtime-paths)
    (compiler-lower-state-field-fingerprint
      state
      lower_i64_i64_map.Map
      reach-active-body-used-types)
    (compiler-lower-state-field-fingerprint state i64 current-source-path-id)
    (compiler-lower-state-field-fingerprint state bool current-decl-generated)
    (compiler-lower-state-field-fingerprint
      state
      csym.CompilerSymbols
      active-symbols)
    (compiler-lower-state-field-fingerprint state bool active-symbols-ready)
    (compiler-lower-state-field-fingerprint
      state
      LowerModuleNameCacheStore
      active-module-name-caches)
    (compiler-lower-state-field-fingerprint
      state
      LowerModuleLocalViewStore
      active-module-local-views)
    (compiler-lower-state-field-fingerprint state i64 active-loop-function)
    (compiler-lower-state-field-fingerprint
      state
      i64
      active-loop-entry-var-limit)
    (compiler-lower-state-field-fingerprint
      state
      lower_i64_i64_map.Map
      alias-overlay-ids)
    (compiler-lower-state-field-fingerprint state bool alias-overlay-valid)
    (compiler-lower-state-field-fingerprint
      state
      (__tl_dyn-array i64)
      alias-symbol-memo)
    (compiler-lower-state-field-fingerprint state i64 canonical-path-count)
    (compiler-lower-state-field-fingerprint state String canonical-path-recent)
    (compiler-lower-state-field-fingerprint state String canonical-path-prior)
    (compiler-lower-state-field-fingerprint state bool entry-main-module-active)
    (compiler-lower-state-field-fingerprint state String entry-main-module)
    (compiler-lower-state-field-fingerprint state i64 entry-main-module-id)
    (compiler-lower-state-field-fingerprint state bool module-decl-index-ready)
    (compiler-lower-state-field-fingerprint
      state
      i64
      module-decl-index-decl-count)
    (compiler-lower-state-field-fingerprint
      state
      i64
      module-decl-index-decl-offset)
    (compiler-lower-state-field-fingerprint
      state
      lower_i64_i64_map.Map
      module-decl-index-modules)
    (compiler-lower-state-field-fingerprint
      state
      (__tl_dyn-array i64)
      module-decl-index-starts)
    (compiler-lower-state-field-fingerprint
      state
      (__tl_dyn-array i64)
      module-decl-index-ends)
    (compiler-lower-state-field-fingerprint
      state
      (__tl_dyn-array i64)
      module-decl-index-positions)
    (compiler-lower-state-field-fingerprint state i64 module-decl-index-arena)
    (compiler-lower-state-field-fingerprint
      state
      ci.InternCompatState
      intern-owner)
    (lower-comptime-error-id-cache-fingerprint state)
    (compiler-lower-checked-pools-state-fingerprint state)
    (compiler-lower-state-field-fingerprint
      state
      CompilerLowerSpmdPackageState
      spmd-package-state)
    (compiler-lower-state-field-fingerprint
      state
      CompilerLowerFunctionMemoStorage
      function-memo-storage)
    (compiler-lower-structural-session-fingerprint state)))

(define (compiler-lower-state-observation-eq?
  [left : CompilerLowerStateObservation]
  [right : CompilerLowerStateObservation]) : bool
  (and
    (= left.active-global-name-cache right.active-global-name-cache)
    (= left.decls-global-type-cache right.decls-global-type-cache)
    (= left.rvo-early-return-functions right.rvo-early-return-functions)
    (= left.reach-active-runtime-paths right.reach-active-runtime-paths)
    (= left.reach-active-body-used-types right.reach-active-body-used-types)
    (= left.current-source-path-id right.current-source-path-id)
    (= left.current-decl-generated right.current-decl-generated)
    (= left.active-symbols right.active-symbols)
    (= left.active-symbols-ready right.active-symbols-ready)
    (= left.active-module-name-caches right.active-module-name-caches)
    (= left.active-module-local-views right.active-module-local-views)
    (= left.active-loop-function right.active-loop-function)
    (= left.active-loop-entry-var-limit right.active-loop-entry-var-limit)
    (= left.alias-overlay-ids right.alias-overlay-ids)
    (= left.alias-overlay-valid right.alias-overlay-valid)
    (= left.alias-symbol-memo right.alias-symbol-memo)
    (= left.canonical-path-count right.canonical-path-count)
    (= left.canonical-path-recent right.canonical-path-recent)
    (= left.canonical-path-prior right.canonical-path-prior)
    (= left.entry-main-module-active right.entry-main-module-active)
    (= left.entry-main-module right.entry-main-module)
    (= left.entry-main-module-id right.entry-main-module-id)
    (= left.module-decl-index-ready right.module-decl-index-ready)
    (= left.module-decl-index-decl-count right.module-decl-index-decl-count)
    (= left.module-decl-index-decl-offset right.module-decl-index-decl-offset)
    (= left.module-decl-index-modules right.module-decl-index-modules)
    (= left.module-decl-index-starts right.module-decl-index-starts)
    (= left.module-decl-index-ends right.module-decl-index-ends)
    (= left.module-decl-index-positions right.module-decl-index-positions)
    (= left.module-decl-index-arena right.module-decl-index-arena)
    (= left.intern-owner right.intern-owner)
    (= left.comptime-error-cache right.comptime-error-cache)
    (= left.checked-pools right.checked-pools)
    (= left.spmd-package-state right.spmd-package-state)
    (= left.function-memo-storage right.function-memo-storage)
    (= left.structural-session-owner right.structural-session-owner)))

(define (lower-active-global-name-cache-current [state : CompilerLowerState]) : LowerNameCache
  (compiler-lower-state-read state LowerNameCache active-global-name-cache))

(define (lower-active-global-name-cache-set!
  [state : CompilerLowerState]
  [cache : LowerNameCache]) : unit
  (compiler-lower-state-write!
    state
    LowerNameCache
    active-global-name-cache
    cache))

;; IR vars allocated before an enclosing loop survive its backedge. Track the
;; active function too so lowering a nested lambda cannot mistake its fresh,
;; low-numbered vars for locals owned by the enclosing loop.
(define (lower-module-phase-caches-reset! [state : CompilerLowerState]) : unit
  (compiler-lower-state-write!
    state
    LowerModuleNameCacheStore
    active-module-name-caches
    (lower-module-name-cache-store-empty))
  (compiler-lower-state-write!
    state
    LowerModuleLocalViewStore
    active-module-local-views
    (lower-module-local-view-store-empty))
  (compiler-lower-state-write! state i64 active-loop-function -1)
  (compiler-lower-state-write! state i64 active-loop-entry-var-limit -1))

;; Reset once per prune reach walk; lower-reach-process records each reachable
;; function body's source path so type-decl DCE can keep local support types.
(define (lower-reach-scratch-state-reset! [state : CompilerLowerState]) : unit
  (lower-active-global-name-cache-set!
    state
    (lower-empty-global-name-cache state.address))
  (compiler-lower-state-write! state bool active-symbols-ready false)
  (lower-module-phase-caches-reset! state)
  (compiler-lower-state-write!
    state
    lower_i64_i64_map.Map
    reach-active-runtime-paths
    (lower_i64_i64_map.with-capacity 8))
  (compiler-lower-state-write!
    state
    lower_i64_i64_map.Map
    reach-active-body-used-types
    (lower_i64_i64_map.with-capacity 8)))

(defenum LowerReachState
  (State lower_i64_i64_map.Map LowerIdSet CompilerLowerState))

(defenum LowerSpmdInlineHelper
  (No)
  (Some i64 ast.AstParamList ast.AstType ast.AstExpr)
  (Imported
    String
    String
    ci.InternId
    ast.AstType
    (Box ast.AstImportedSpmdCallableList)))

(defstruct LowerFunctionBodyIndex
  (ids lower_i64_i64_map.Map)
  (bodies (__tl_dyn-array LowerMaybeFunctionBody))
  (next i64))

(defstruct LowerDeclKeepPlan
  (keep (__tl_dyn-array i64))
