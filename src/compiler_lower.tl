(define (lower-spmd-expr-has-out-of-line-call?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-spmd-expr-has-out-of-line-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-spmd-expr-has-out-of-line-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (lower-spmd-expr-has-out-of-line-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Unary _ inner-box)
      (lower-spmd-expr-has-out-of-line-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (or
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx left-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx right-box)))]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (or
          (match (lower-spmd-inline-helper-lookup
            ctx
            env
            type-env
            (lower-id-set-empty)
            func)
            [(ResultLowerSpmdInlineHelper.Ok helper)
              (match helper
                [(LowerSpmdInlineHelper.Some _ _ _ body)
                  (lower-spmd-helper-out-of-line? ctx body)]
                [(LowerSpmdInlineHelper.Imported _ _ _) true]
                [(LowerSpmdInlineHelper.No) false])]
            [(ResultLowerSpmdInlineHelper.Err _) false])
          (lower-spmd-expr-list-has-out-of-line-call? ctx env type-env args)))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (or
            (lower-spmd-let-has-out-of-line-call? ctx env type-env bindings)
            (lower-spmd-expr-has-out-of-line-call?
              ctx
              env
              type-env
              (lower-context-expr-get ctx body-box)))])]
    [(ast.AstExpr.If cond-box then-box else-box)
      (or
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx cond-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx then-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx else-box)))]
    [(ast.AstExpr.Begin exprs)
      (lower-spmd-expr-list-has-out-of-line-call? ctx env type-env exprs)]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (or
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx array-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx index-box)))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (or
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx array-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx index-box))
        (lower-spmd-expr-has-out-of-line-call?
          ctx
          env
          type-env
          (lower-context-expr-get ctx value-box)))]
    [_ false]))

(define (lower-masked-vector-map
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [body : ast.AstExpr]) : LowerMaybeMaskedVectorMap
  (let
    [varying-if : bool
      (lower-masked-vector-body-has-varying-if?
        ctx
        mode
        env
        type-env
        index
        body)]
    [varying-while : bool
      (lower-masked-vector-body-has-varying-while?
        ctx
        mode
        env
        type-env
        index
        body)]
    [varying-match : bool
      (lower-masked-vector-body-has-varying-match?
        ctx
        mode
        env
        type-env
        index
        body)]
    [varying-enum-match : bool
      (lower-masked-vector-body-has-varying-enum-match?
        ctx
        env
        type-env
        index
        body)]
    [bool-array-lane : bool
      (lower-masked-vector-body-has-bool-array-lane?
        ctx
        env
        type-env
        index
        body)]
    [out-of-line-call : bool
      (lower-spmd-expr-has-out-of-line-call? ctx env type-env body)]
    (if (or
      (and
        (lower-mode-avx512? mode)
        (or
          varying-if
          varying-while
          varying-match
          varying-enum-match
          bool-array-lane
          out-of-line-call))
      (and
        (lower-mode-avx2? mode)
        (or
          varying-if
          varying-while
          varying-match
          varying-enum-match
          bool-array-lane
          out-of-line-call)))
      (let
        [lanes : i64
          (lower-masked-vector-expr-lanes ctx mode env type-env index body)]
        (if (> lanes 0)
          (LowerMaybeMaskedVectorMap.Some lanes)
          (LowerMaybeMaskedVectorMap.No)))
      (LowerMaybeMaskedVectorMap.No))))

(define (lower-masked-vector-array-vars
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [expr : ast.AstExpr]) : LowerArrayVarSet
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars ctx env type-env index left)
          (lower-masked-vector-array-vars ctx env type-env index right)))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (lower-array-var-set-merge
              (lower-masked-vector-let-binding-array-vars
                ctx
                env
                type-env
                index
                bindings)
              (lower-masked-vector-array-vars ctx env type-env index body)))])]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars ctx env type-env index cond)
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars ctx env type-env index then-branch)
            (lower-masked-vector-array-vars ctx env type-env index else-branch))))]
    [(ast.AstExpr.While cond-box body-box)
      (lower-array-var-set-merge
        (lower-masked-vector-array-vars
          ctx
          env
          type-env
          index
          (lower-context-expr-get ctx cond-box))
        (lower-masked-vector-array-vars
          ctx
          env
          type-env
          index
          (lower-context-expr-get ctx body-box)))]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars
              ctx
              env
              type-env
              index
              (lower-context-expr-get ctx scrutinee-box))
            (lower-masked-vector-match-arms-array-vars
              ctx
              env
              type-env
              index
              arms))])]
    [(ast.AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-array-vars ctx env type-env index exprs)]
    [(ast.AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [idx-offset : i64 (lower-masked-vector-index-offset ctx index idx)]
        (if (>= idx-offset 0)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some var _)
              (lower-array-var-set-add
                (lower-array-var-set-empty)
                var
                idx-offset)]
            [(LowerMaybeArrayVar.No) (lower-array-var-set-empty)])
          (lower-array-var-set-empty)))]
    [(ast.AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [idx-offset : i64 (lower-masked-vector-index-offset ctx index idx)]
        (lower-array-var-set-merge
          (if (>= idx-offset 0)
            (match (lower-dynamic-array-var ctx env type-env arr)
              [(LowerMaybeArrayVar.Some var _)
                (lower-array-var-set-add
                  (lower-array-var-set-empty)
                  var
                  idx-offset)]
              [(LowerMaybeArrayVar.No) (lower-array-var-set-empty)])
            (lower-array-var-set-empty))
          (lower-masked-vector-array-vars ctx env type-env index value)))]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars ctx env type-env index receiver)
          (lower-masked-vector-array-vars ctx env type-env index value)))]
    [_ (lower-array-var-set-empty)]))

(define (lower-masked-vector-expr-list-array-vars
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [exprs : ast.AstExprList]) : LowerArrayVarSet
  (lower-masked-vector-expr-list-array-vars-at
    ctx
    env
    type-env
    index
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-array-vars-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : LowerArrayVarSet
  (if (>= expr-index (struct-get exprs len))
    (lower-array-var-set-empty)
    (lower-array-var-set-merge
      (lower-masked-vector-array-vars
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0)))
      (lower-masked-vector-expr-list-array-vars-at
        ctx
        env
        type-env
        index
        exprs
        (+ expr-index 1)))))

(define (lower-masked-vector-match-arms-array-vars
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [arms : ast.AstMatchArmList]) : LowerArrayVarSet
  (lower-masked-vector-match-arms-array-vars-at
    ctx
    env
    type-env
    index
    (& arms)
    0))

(define (lower-masked-vector-match-arms-array-vars-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [arms : (& arms ast.AstMatchArmList)]
  [arm-index : i64]) : LowerArrayVarSet
  (if (>= arm-index (struct-get arms len))
    (lower-array-var-set-empty)
    (match (ast.ast-match-arm-list-get
      arms
      arm-index
      (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm _ body-box)
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars
            ctx
            env
            type-env
            index
            (lower-context-expr-get ctx body-box))
          (lower-masked-vector-match-arms-array-vars-at
            ctx
            env
            type-env
            index
            arms
            (+ arm-index 1)))])))

(define (lower-masked-vector-let-binding-array-vars
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [bindings : ast.AstLetBindingList]) : LowerArrayVarSet
  (lower-masked-vector-let-binding-array-vars-at
    ctx
    env
    type-env
    index
    (& bindings)
    0))

(define (lower-masked-vector-let-binding-array-vars-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : LowerArrayVarSet
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    (lower-array-var-set-empty)
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars ctx env type-env index init)
            (lower-masked-vector-let-binding-array-vars-at
              ctx
              env
              type-env
              index
              bindings
              (+ binding-index 1))))])))

(define (lower-masked-vector-let-binding-names
  [bindings : ast.AstLetBindingList]
  [lane-locals : LowerIdSet]) : LowerIdSet
  (lower-masked-vector-let-binding-names-at (& bindings) lane-locals 0))

(define (lower-masked-vector-let-binding-names-at
  [bindings : (& bindings ast.AstLetBindingList)]
  [lane-locals : LowerIdSet]
  [binding-index : i64]) : LowerIdSet
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    lane-locals
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name _ _)
        (lower-masked-vector-let-binding-names-at
          bindings
          (lower-id-set-insert lane-locals name)
          (+ binding-index 1))])))

(define (lower-vector-body-has-array-read?
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-array-read? ctx inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-array-read? ctx inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-array-read? ctx inner))]
    [(ast.AstExpr.ArrayRef _ _) true]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-array-read? ctx inner))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (or
          (lower-vector-body-has-array-read? ctx left)
          (lower-vector-body-has-array-read? ctx right)))]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (or
          (lower-vector-body-has-array-read? ctx cond)
          (lower-vector-body-has-array-read? ctx then-branch)
          (lower-vector-body-has-array-read? ctx else-branch)))]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (or
            (lower-vector-body-has-array-read?
              ctx
              (lower-context-expr-get ctx scrutinee-box))
            (lower-match-arms-have-array-read? ctx arms))])]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (or
              (lower-vector-let-bindings-have-array-read? ctx bindings)
              (lower-vector-body-has-array-read? ctx body)))])]
    [(ast.AstExpr.Begin exprs)
      (lower-vector-expr-list-has-array-read? ctx exprs)]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (or
          (lower-vector-body-has-array-read? ctx func)
          (lower-vector-expr-list-has-array-read? ctx args)))]
    [(ast.AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-array-read? ctx arr)
          (lower-vector-body-has-array-read? ctx idx)
          (lower-vector-body-has-array-read? ctx value)))]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-array-read? ctx receiver)
          (lower-vector-body-has-array-read? ctx value)))]
    [_ false]))

(define (lower-match-arms-have-array-read?
  [ctx : tc_core.TcContext]
  [arms : ast.AstMatchArmList]) : bool
  (lower-match-arms-have-array-read-at? ctx (& arms) 0))

(define (lower-match-arms-have-array-read-at?
  [ctx : tc_core.TcContext]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm _ body-box)
        (or
          (lower-vector-body-has-array-read?
            ctx
            (lower-context-expr-get ctx body-box))
          (lower-match-arms-have-array-read-at? ctx arms (+ index 1)))])))

(define (lower-vector-expr-list-has-array-read?
  [ctx : tc_core.TcContext]
  [exprs : ast.AstExprList]) : bool
  (lower-vector-expr-list-has-array-read-at? ctx (& exprs) 0))

(define (lower-vector-expr-list-has-array-read-at?
  [ctx : tc_core.TcContext]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-vector-body-has-array-read?
        ctx
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      (lower-vector-expr-list-has-array-read-at? ctx exprs (+ index 1)))))

(define (lower-vector-let-bindings-have-array-read?
  [ctx : tc_core.TcContext]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-vector-let-bindings-have-array-read-at? ctx (& bindings) 0))

(define (lower-vector-let-bindings-have-array-read-at?
  [ctx : tc_core.TcContext]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          (or
            (lower-vector-body-has-array-read? ctx init)
            (lower-vector-let-bindings-have-array-read-at?
              ctx
              bindings
              (+ binding-index 1))))])))

(define (lower-vector-body-has-spmd-shuffle?
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-spmd-shuffle? ctx inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-spmd-shuffle? ctx inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-spmd-shuffle? ctx inner))]
    [(ast.AstExpr.SpmdShuffle _ _) true]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx value)
          (lower-vector-body-has-spmd-shuffle? ctx lane)))]
    [(ast.AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx arr)
          (lower-vector-body-has-spmd-shuffle? ctx idx)))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-spmd-shuffle? ctx inner))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx left)
          (lower-vector-body-has-spmd-shuffle? ctx right)))]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx cond)
          (lower-vector-body-has-spmd-shuffle? ctx then-branch)
          (lower-vector-body-has-spmd-shuffle? ctx else-branch)))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (or
              (lower-vector-let-bindings-have-spmd-shuffle? ctx bindings)
              (lower-vector-body-has-spmd-shuffle? ctx body)))])]
    [(ast.AstExpr.Begin exprs)
      (lower-vector-expr-list-has-spmd-shuffle? ctx exprs)]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx func)
          (lower-vector-expr-list-has-spmd-shuffle? ctx args)))]
    [(ast.AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx arr)
          (lower-vector-body-has-spmd-shuffle? ctx idx)
          (lower-vector-body-has-spmd-shuffle? ctx value)))]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-spmd-shuffle? ctx receiver)
          (lower-vector-body-has-spmd-shuffle? ctx value)))]
    [_ false]))

(define (lower-vector-expr-list-has-spmd-shuffle?
  [ctx : tc_core.TcContext]
  [exprs : ast.AstExprList]) : bool
  (lower-vector-expr-list-has-spmd-shuffle-at? ctx (& exprs) 0))

(define (lower-vector-expr-list-has-spmd-shuffle-at?
  [ctx : tc_core.TcContext]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-vector-body-has-spmd-shuffle?
        ctx
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      (lower-vector-expr-list-has-spmd-shuffle-at? ctx exprs (+ index 1)))))

(define (lower-vector-let-bindings-have-spmd-shuffle?
  [ctx : tc_core.TcContext]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-vector-let-bindings-have-spmd-shuffle-at? ctx (& bindings) 0))

(define (lower-vector-let-bindings-have-spmd-shuffle-at?
  [ctx : tc_core.TcContext]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          (or
            (lower-vector-body-has-spmd-shuffle? ctx init)
            (lower-vector-let-bindings-have-spmd-shuffle-at?
              ctx
              bindings
              (+ binding-index 1))))])))

(define (lower-vector-body-has-atomic-call?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-atomic-call? ctx env type-env inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-atomic-call? ctx env type-env inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-atomic-call? ctx env type-env inner))]
    [(ast.AstExpr.Unary _ inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-vector-body-has-atomic-call? ctx env type-env inner))]
    [(ast.AstExpr.Binary _ left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx env type-env left)
          (lower-vector-body-has-atomic-call? ctx env type-env right)))]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx env type-env cond)
          (lower-vector-body-has-atomic-call? ctx env type-env then-branch)
          (lower-vector-body-has-atomic-call? ctx env type-env else-branch)))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (or
              (lower-vector-let-bindings-have-atomic-call?
                ctx
                env
                type-env
                bindings)
              (lower-vector-body-has-atomic-call? ctx env type-env body)))])]
    [(ast.AstExpr.Begin exprs)
      (lower-vector-expr-list-has-atomic-call? ctx env type-env exprs)]
    [(ast.AstExpr.Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (or
          (>
            (string.string-length
              (lower-atomic-extern-symbol-for-func ctx type-env func))
            0)
          (lower-atomic-pointer-func? type-env func)
          (lower-vector-call-target-has-atomic? ctx env type-env func)
          (lower-vector-body-has-atomic-call? ctx env type-env func)
          (lower-vector-expr-list-has-atomic-call? ctx env type-env args)))]
    [(ast.AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx env type-env arr)
          (lower-vector-body-has-atomic-call? ctx env type-env idx)))]
    [(ast.AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx env type-env arr)
          (lower-vector-body-has-atomic-call? ctx env type-env idx)
          (lower-vector-body-has-atomic-call? ctx env type-env value)))]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-vector-body-has-atomic-call? ctx env type-env receiver)
          (lower-vector-body-has-atomic-call? ctx env type-env value)))]
    [_ false]))

(define (lower-vector-expr-list-has-atomic-call?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]) : bool
  (lower-vector-expr-list-has-atomic-call-at? ctx env type-env (& exprs) 0))

(define (lower-vector-expr-list-has-atomic-call-at?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-vector-body-has-atomic-call?
        ctx
        env
        type-env
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      (lower-vector-expr-list-has-atomic-call-at?
        ctx
        env
        type-env
        exprs
        (+ index 1)))))

(define (lower-vector-let-bindings-have-atomic-call?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-vector-let-bindings-have-atomic-call-at?
    ctx
    env
    type-env
    (& bindings)
    0))

(define (lower-vector-let-bindings-have-atomic-call-at?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding _ _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          (or
            (lower-vector-body-has-atomic-call? ctx env type-env init)
            (lower-vector-let-bindings-have-atomic-call-at?
              ctx
              env
              type-env
              bindings
              (+ binding-index 1))))])))

(define (lower-vector-call-target-has-atomic?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (match (lower-spmd-inline-helper-lookup
    ctx
    env
    type-env
    (lower-id-set-empty)
    func)
    [(ResultLowerSpmdInlineHelper.Ok helper)
      (match helper
        [(LowerSpmdInlineHelper.Some name _ _ body)
          (if (lower-id-set-contains?
            (lower-global-shared-view lower-spmd-inline-helper-stack)
            name)
            false
            (let
              [previous : LowerIdSet
                (lower-global-shared-view lower-spmd-inline-helper-stack)]
              [result : bool false]
              (begin
                (set!
                  lower-spmd-inline-helper-stack
                  (lower-id-set-insert previous name))
                (set!
                  result
                  (lower-vector-body-has-atomic-call? ctx env type-env body))
                (set! lower-spmd-inline-helper-stack previous)
                result)))]
        [(LowerSpmdInlineHelper.Imported _ _ _) false]
        [(LowerSpmdInlineHelper.No) false])]
    [(ResultLowerSpmdInlineHelper.Err _) false]))

(define (lower-simple-vector-map-binop-supported?
  [mode : CompilerLowerMode]
  [elem-ty : ast.AstType]
  [op : ast.AstBinOp]) : bool
  (match op
    [(ast.AstBinOp.Add) true]
    [(ast.AstBinOp.Sub) true]
    [(ast.AstBinOp.BitAnd) true]
    [(ast.AstBinOp.BitOr) true]
    [(ast.AstBinOp.BitXor) true]
    [(ast.AstBinOp.Shl) (lower-spmd-shift-lane-supported? elem-ty)]
    [(ast.AstBinOp.Shr) (lower-spmd-shift-lane-supported? elem-ty)]
    [(ast.AstBinOp.Mul)
      (and
        (> (lower-simd-lanes-for-elem mode elem-ty) 0)
        (not (lower-spmd-byte-lane-type? elem-ty)))]
    [_ false]))

(define (lower-spmd-shift-lane-supported? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [_ false]))

(define (lower-spmd-shift-width [ty : ast.AstType]) : i64
  (match (tc_core.tc-type-without-regions ty)
    [(ast.AstType.I32) 32]
    [(ast.AstType.U32) 32]
    [(ast.AstType.I64) 64]
    [(ast.AstType.U64) 64]
    [_ 0]))

(define (lower-spmd-byte-lane-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(ast.AstType.I8) true]
    [(ast.AstType.U8) true]
    [_ false]))

(define (lower-spmd-byte-mul-diagnostic) : String
  "lower: SPMD foreach SIMD lowering does not support 8-bit lane multiplication; use scalar or widen before multiplying")

(define (lower-spmd-map-shift-diagnostic
  [op-name : String]
  [lane-ty : ast.AstType]
  [mode : CompilerLowerMode]) : String
  (str_cat.str-cat
    "lower: SPMD foreach SIMD lowering does not support shift '"
    op-name
    "' for lane type "
    (tc_core.tc-type-render lane-ty)
    " in "
    (if (lower-mode-avx2? mode)
      "AVX2"
      "AVX-512")
    " backend mode; supported lane types are i32, u32, i64, and u64"))

(define (lower-spmd-expr-has-shift?
  [ctx : tc_core.TcContext]
  [want-left : bool]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-spmd-expr-has-shift?
        ctx
        want-left
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-spmd-expr-has-shift?
        ctx
        want-left
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (lower-spmd-expr-has-shift?
        ctx
        want-left
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Binary op lhs-box rhs-box)
      (let
        [matches : bool
          (match op
            [(ast.AstBinOp.Shl) want-left]
            [(ast.AstBinOp.Shr) (not want-left)]
            [_ false])]
        (or
          matches
          (lower-spmd-expr-has-shift?
            ctx
            want-left
            (lower-context-expr-get ctx lhs-box))
          (lower-spmd-expr-has-shift?
            ctx
            want-left
            (lower-context-expr-get ctx rhs-box))))]
    [(ast.AstExpr.ArraySet arr-box index-box value-box)
      (or
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx arr-box))
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx index-box))
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx value-box)))]
    [(ast.AstExpr.Begin exprs)
      (lower-spmd-expr-list-has-shift? ctx want-left exprs)]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (or
            (lower-spmd-let-bindings-have-shift? ctx want-left bindings)
            (lower-spmd-expr-has-shift?
              ctx
              want-left
              (lower-context-expr-get ctx body-box)))])]
    [(ast.AstExpr.If cond-box then-box else-box)
      (or
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx cond-box))
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx then-box))
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx else-box)))]
    [_ false]))

(define (lower-spmd-expr-list-has-shift?
  [ctx : tc_core.TcContext]
  [want-left : bool]
  [exprs : ast.AstExprList]) : bool
  (lower-spmd-expr-list-has-shift-at? ctx want-left (& exprs) 0))

(define (lower-spmd-expr-list-has-shift-at?
  [ctx : tc_core.TcContext]
  [want-left : bool]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-spmd-expr-has-shift?
        ctx
        want-left
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      (lower-spmd-expr-list-has-shift-at? ctx want-left exprs (+ index 1)))))

(define (lower-spmd-let-bindings-have-shift?
  [ctx : tc_core.TcContext]
  [want-left : bool]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-spmd-let-bindings-have-shift-at? ctx want-left (& bindings) 0))

(define (lower-spmd-let-bindings-have-shift-at?
  [ctx : tc_core.TcContext]
  [want-left : bool]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (or
      (match (ast.ast-let-binding-list-get
        bindings
        binding-index
        (ast.ast-let-binding-fallback))
        [(ast.AstLetBinding.Binding _ _ init-box)
          (lower-spmd-expr-has-shift?
            ctx
            want-left
            (lower-context-expr-get ctx init-box))])
      (lower-spmd-let-bindings-have-shift-at?
        ctx
        want-left
        bindings
        (+ binding-index 1)))))

(define (lower-spmd-expr-has-mul?
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-spmd-expr-has-mul? ctx inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-spmd-expr-has-mul? ctx inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-spmd-expr-has-mul? ctx inner))]
    [(ast.AstExpr.Binary op lhs-box rhs-box)
      (match op
        [(ast.AstBinOp.Mul) true]
        [_
          (or
            (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx lhs-box))
            (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx rhs-box)))])]
    [(ast.AstExpr.ArraySet arr-box index-box value-box)
      (or
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx arr-box))
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx index-box))
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx value-box)))]
    [(ast.AstExpr.Begin exprs) (lower-spmd-expr-list-has-mul? ctx exprs)]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (or
            (lower-spmd-let-bindings-have-mul? ctx bindings)
            (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx body-box)))])]
    [(ast.AstExpr.If cond-box then-box else-box)
      (or
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx cond-box))
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx then-box))
        (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx else-box)))]
    [_ false]))

(define (lower-spmd-expr-list-has-mul?
  [ctx : tc_core.TcContext]
  [exprs : ast.AstExprList]) : bool
  (lower-spmd-expr-list-has-mul-at? ctx (& exprs) 0))

(define (lower-spmd-expr-list-has-mul-at?
  [ctx : tc_core.TcContext]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-spmd-expr-has-mul?
        ctx
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      (lower-spmd-expr-list-has-mul-at? ctx exprs (+ index 1)))))

(define (lower-spmd-let-bindings-have-mul?
  [ctx : tc_core.TcContext]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-spmd-let-bindings-have-mul-at? ctx (& bindings) 0))

(define (lower-spmd-let-bindings-have-mul-at?
  [ctx : tc_core.TcContext]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (or
      (match (ast.ast-let-binding-list-get
        bindings
        binding-index
        (ast.ast-let-binding-fallback))
        [(ast.AstLetBinding.Binding _ _ init-box)
          (lower-spmd-expr-has-mul? ctx (lower-context-expr-get ctx init-box))])
      (lower-spmd-let-bindings-have-mul-at? ctx bindings (+ binding-index 1)))))

(define (lower-simple-vector-map-has-unsupported-byte-mul?
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [body : ast.AstExpr]) : bool
  (match body
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-has-unsupported-byte-mul?
          ctx
          mode
          env
          type-env
          index
          inner))]
    [(ast.AstExpr.ArraySet arr-box set-index-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [set-index : ast.AstExpr (lower-context-expr-get ctx set-index-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (if (lower-expr-is-var? ctx set-index index)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some _ dst-elem)
              (and
                (> (lower-simd-lanes-for-elem mode dst-elem) 0)
                (lower-spmd-byte-lane-type? dst-elem)
                (lower-spmd-expr-has-mul? ctx value))]
            [(LowerMaybeArrayVar.No) false])
          false))]
    [_ false]))

(define (lower-simple-vector-map-unsupported-shift-lane
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [want-left : bool]
  [body : ast.AstExpr]) : LowerMaybeAstType
  (match body
    [(ast.AstExpr.Spanned inner-box _)
      (lower-simple-vector-map-unsupported-shift-lane
        ctx
        mode
        env
        type-env
        index
        want-left
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-simple-vector-map-unsupported-shift-lane
        ctx
        mode
        env
        type-env
        index
        want-left
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Begin exprs)
      (lower-simple-vector-map-expr-list-unsupported-shift-lane-at
        ctx
        mode
        env
        type-env
        index
        want-left
        (& exprs)
        0)]
    [(ast.AstExpr.ArraySet arr-box set-index-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [set-index : ast.AstExpr (lower-context-expr-get ctx set-index-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (if (lower-expr-is-var? ctx set-index index)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some _ dst-elem)
              (if (and
                (> (lower-simd-lanes-for-elem mode dst-elem) 0)
                (not (lower-spmd-shift-lane-supported? dst-elem))
                (lower-spmd-expr-has-shift? ctx want-left value))
                (LowerMaybeAstType.Some dst-elem)
                (LowerMaybeAstType.No))]
            [(LowerMaybeArrayVar.No) (LowerMaybeAstType.No)])
          (LowerMaybeAstType.No)))]
    [_ (LowerMaybeAstType.No)]))

(define (lower-simple-vector-map-expr-list-unsupported-shift-lane-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [want-left : bool]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : LowerMaybeAstType
  (if (>= expr-index (struct-get exprs len))
    (LowerMaybeAstType.No)
    (match (lower-simple-vector-map-unsupported-shift-lane
      ctx
      mode
      env
      type-env
      index
      want-left
      (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0)))
      [(LowerMaybeAstType.Some lane-ty) (LowerMaybeAstType.Some lane-ty)]
      [(LowerMaybeAstType.No)
        (lower-simple-vector-map-expr-list-unsupported-shift-lane-at
          ctx
          mode
          env
          type-env
          index
          want-left
          exprs
          (+ expr-index 1))])))

(define (lower-simple-vector-map-casted-literal
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [target-ty : ast.AstType]
  [dst-elem : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeVectorMapValue
  (match value
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-casted-literal
          ctx
          mode
          target-ty
          dst-elem
          inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-casted-literal
          ctx
          mode
          target-ty
          dst-elem
          inner))]
    [(ast.AstExpr.Literal lit)
      (if (and
        (> (lower-simd-lanes-for-elem mode target-ty) 0)
        (tc_core.tc-type-eq target-ty dst-elem))
        (LowerMaybeVectorMapValue.Some
          (LowerVectorMapValue.Uniform
            (lower-literal-value-with-type lit target-ty)))
        (LowerMaybeVectorMapValue.No))]
    [_ (LowerMaybeVectorMapValue.No)]))

(define (lower-simple-vector-map-lane-array-value
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst-elem : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeVectorMapValue
  (match (lower-array-ref-var-for-program-index ctx env type-env value)
    [(LowerMaybeArrayVar.Some array-var array-elem)
      (if (tc_core.tc-type-eq array-elem dst-elem)
        (LowerMaybeVectorMapValue.Some
          (LowerVectorMapValue.LaneArray array-var))
        (LowerMaybeVectorMapValue.No))]
    [(LowerMaybeArrayVar.No) (LowerMaybeVectorMapValue.No)]))

(define (lower-simple-vector-map-gather-lane-offset-var
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [value : ast.AstExpr]) : LowerMaybeArrayVar
  (match value
    [(ast.AstExpr.Spanned inner-box _)
      (lower-simple-vector-map-gather-lane-offset-var
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-simple-vector-map-gather-lane-offset-var
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Binary (ast.AstBinOp.Add) lhs-box rhs-box)
      (let
        [lhs : ast.AstExpr (lower-context-expr-get ctx lhs-box)]
        [rhs : ast.AstExpr (lower-context-expr-get ctx rhs-box)]
        (if (lower-expr-is-var? ctx lhs index)
          (lower-array-ref-var-for-program-index ctx env type-env rhs)
          (if (lower-expr-is-var? ctx rhs index)
            (lower-array-ref-var-for-program-index ctx env type-env lhs)
            (LowerMaybeArrayVar.No))))]
    [_ (LowerMaybeArrayVar.No)]))

(define (lower-simple-vector-map-gather-value
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [dst-elem : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeVectorMapValue
  (match value
    [(ast.AstExpr.ArrayRef source-box indexes-box)
      (let
        [source : ast.AstExpr (lower-context-expr-get ctx source-box)]
        [indexes : ast.AstExpr (lower-context-expr-get ctx indexes-box)]
        (match (lower-dynamic-array-var ctx env type-env source)
          [(LowerMaybeArrayVar.Some source-var source-elem)
            (match (lower-array-ref-var-for-index
              ctx
              env
              type-env
              indexes
              index)
              [(LowerMaybeArrayVar.Some indexes-var indexes-elem)
                (if (and
                  (tc_core.tc-type-eq source-elem dst-elem)
                  (tc_core.tc-type-eq indexes-elem (ast.AstType.I64)))
                  (LowerMaybeVectorMapValue.Some
                    (LowerVectorMapValue.Gather source-var indexes-var))
                  (LowerMaybeVectorMapValue.No))]
              [(LowerMaybeArrayVar.No)
                (match (lower-simple-vector-map-gather-lane-offset-var
                  ctx
                  env
                  type-env
                  index
                  indexes)
                  [(LowerMaybeArrayVar.Some offsets-var offsets-elem)
                    (if (and
                      (tc_core.tc-type-eq source-elem dst-elem)
                      (tc_core.tc-type-eq offsets-elem (ast.AstType.I64)))
                      (LowerMaybeVectorMapValue.Some
                        (LowerVectorMapValue.GatherLaneOffset
                          source-var
                          offsets-var))
                      (LowerMaybeVectorMapValue.No))]
                  [(LowerMaybeArrayVar.No) (LowerMaybeVectorMapValue.No)])])]
          [(LowerMaybeArrayVar.No) (LowerMaybeVectorMapValue.No)]))]
    [_ (LowerMaybeVectorMapValue.No)]))

(define (lower-vector-shuffle-value-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.F32) true]
    [(ast.AstType.F64) true]
    [_ false]))

;; Keep shuffle operand evaluation to plans whose inactive lanes can be
;; suppressed by the existing predicated vector machinery. Gather and
;; broadcast plans need their own ordered gang-tail treatment and remain a
;; focused diagnostic instead of silently changing to one-lane semantics.
(define (lower-vector-shuffle-operand-plan? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(LowerVectorMapValue.Array _) true]
    [(LowerVectorMapValue.Uniform _) true]
    [(LowerVectorMapValue.LaneIndex) true]
    [(LowerVectorMapValue.LaneCount) true]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (and
        (lower-vector-shuffle-operand-plan? (box-get lhs))
        (lower-vector-shuffle-operand-plan? (box-get rhs)))]
    [_ false]))

(define (lower-vector-map-value-has-shuffle? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(LowerVectorMapValue.Shuffle _ _) true]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-has-shuffle? (box-get lhs))
        (lower-vector-map-value-has-shuffle? (box-get rhs)))]
    [_ false]))

(define (lower-simple-vector-map-value
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [dst-elem : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeVectorMapValue
  (match value
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-value
          ctx
          mode
          env
          type-env
          index
          dst-elem
          inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-value
          ctx
          mode
          env
          type-env
          index
          dst-elem
          inner))]
    [(ast.AstExpr.Cast inner-box cast-ty-id)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        [target-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-context-type-get ctx cast-ty-id))]
        (match (lower-simple-vector-map-casted-literal
          ctx
          mode
          target-ty
          dst-elem
          inner)
          [(LowerMaybeVectorMapValue.Some plan)
            (LowerMaybeVectorMapValue.Some plan)]
          [(LowerMaybeVectorMapValue.No)
            (lower-simple-vector-map-value
              ctx
              mode
              env
              type-env
              index
              dst-elem
              inner)]))]
    [(ast.AstExpr.ArrayRef _ _)
      (match (lower-array-ref-var-for-index ctx env type-env value index)
        [(LowerMaybeArrayVar.Some array-var array-elem)
          (if (tc_core.tc-type-eq array-elem dst-elem)
            (LowerMaybeVectorMapValue.Some
              (LowerVectorMapValue.Array array-var))
            (LowerMaybeVectorMapValue.No))]
        [(LowerMaybeArrayVar.No)
          (match (lower-simple-vector-map-gather-value
            ctx
            env
            type-env
            index
            dst-elem
            value)
            [(LowerMaybeVectorMapValue.Some plan)
              (LowerMaybeVectorMapValue.Some plan)]
            [(LowerMaybeVectorMapValue.No)
              (lower-simple-vector-map-lane-array-value
                ctx
                env
                type-env
                dst-elem
                value)])])]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (let
        [source : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [selector : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (if (and
          (lower-vector-shuffle-value-type? dst-elem)
          (> (lower-simd-lanes-for-elem mode dst-elem) 0))
          (match (lower-simple-vector-map-value
            ctx
            mode
            env
            type-env
            index
            dst-elem
            source)
            [(LowerMaybeVectorMapValue.Some source-plan)
              (match (lower-simple-vector-map-value
                ctx
                mode
                env
                type-env
                index
                (ast.AstType.I64)
                selector)
                [(LowerMaybeVectorMapValue.Some selector-plan)
                  (if (and
                    (lower-vector-shuffle-operand-plan? source-plan)
                    (lower-vector-shuffle-operand-plan? selector-plan))
                    (LowerMaybeVectorMapValue.Some
                      (LowerVectorMapValue.Shuffle
                        (box source-plan)
                        (box selector-plan)))
                    (LowerMaybeVectorMapValue.No))]
                [(LowerMaybeVectorMapValue.No) (LowerMaybeVectorMapValue.No)])]
            [(LowerMaybeVectorMapValue.No) (LowerMaybeVectorMapValue.No)])
          (LowerMaybeVectorMapValue.No)))]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (let
        [source : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (match (lower-simple-spmd-broadcast-lane ctx env type-env lane)
          [(LowerMaybeIrValue.Some lane-value)
            (match (lower-array-ref-var-for-index ctx env type-env source index)
              [(LowerMaybeArrayVar.Some array-var array-elem)
                (if (tc_core.tc-type-eq array-elem dst-elem)
                  (LowerMaybeVectorMapValue.Some
                    (LowerVectorMapValue.BroadcastArray array-var lane-value))
                  (LowerMaybeVectorMapValue.No))]
              [(LowerMaybeArrayVar.No)
                (lower-simple-vector-map-value
                  ctx
                  mode
                  env
                  type-env
                  index
                  dst-elem
                  source)])]
          [(LowerMaybeIrValue.No) (LowerMaybeVectorMapValue.No)]))]
    [(ast.AstExpr.SpmdProgramIndex)
      (if (and
        (> (lower-simd-lanes-for-elem mode dst-elem) 0)
        (tc_core.tc-type-eq dst-elem (ast.AstType.I64)))
        (LowerMaybeVectorMapValue.Some (LowerVectorMapValue.LaneIndex))
        (LowerMaybeVectorMapValue.No))]
    [(ast.AstExpr.SpmdProgramCount)
      (if (and
        (> (lower-simd-lanes-for-elem mode dst-elem) 0)
        (tc_core.tc-type-eq dst-elem (ast.AstType.I64)))
        (LowerMaybeVectorMapValue.Some (LowerVectorMapValue.LaneCount))
        (LowerMaybeVectorMapValue.No))]
    [(ast.AstExpr.Var name)
      (let
        [lookup-name : String (tc_core.tc-env-key-name-text name)]
        (if (string.eq lookup-name index)
          (LowerMaybeVectorMapValue.No)
          (let
            [var-id : i64
              (sym_i64_env.sym-i64-lookup-id-or
                env
                name
                (csym.compiler-symbols-missing-handle))]
            (if (csym.compiler-symbols-handle-found? var-id)
              (match (tc_core.tc-lookup-id type-env name)
                [(tc_core.ResultTcType.Ok ty)
                  (let
                    [scalar-ty : ast.AstType
                      (tc_core.tc-type-without-regions ty)]
                    (if (and
                      (> (lower-simd-lanes-for-elem mode scalar-ty) 0)
                      (tc_core.tc-type-eq scalar-ty dst-elem))
                      (LowerMaybeVectorMapValue.Some
                        (LowerVectorMapValue.Uniform
                          (ir.CompilerIrValue.Var var-id)))
                      (LowerMaybeVectorMapValue.No)))]
                [(tc_core.ResultTcType.Err _) (LowerMaybeVectorMapValue.No)])
              (LowerMaybeVectorMapValue.No)))))]
    [(ast.AstExpr.Literal lit)
      (let
        [lit-ty : ast.AstType (tc_core.tc-literal-type lit)]
        (match lit
          [(ast.AstLiteral.Int _ _)
            (if (and
              (> (lower-simd-lanes-for-elem mode dst-elem) 0)
              (tc_core.tc-integer-type? dst-elem))
              (LowerMaybeVectorMapValue.Some
                (LowerVectorMapValue.Uniform
                  (lower-literal-value-with-type lit dst-elem)))
              (LowerMaybeVectorMapValue.No))]
          [_
            (if (and
              (> (lower-simd-lanes-for-elem mode lit-ty) 0)
              (tc_core.tc-type-eq lit-ty dst-elem))
              (LowerMaybeVectorMapValue.Some
                (LowerVectorMapValue.Uniform
                  (lower-literal-value-with-type lit dst-elem)))
              (LowerMaybeVectorMapValue.No))]))]
    [(ast.AstExpr.Binary op lhs-box rhs-box)
      (if (lower-simple-vector-map-binop-supported? mode dst-elem op)
        (let
          [lhs : ast.AstExpr (lower-context-expr-get ctx lhs-box)]
          [rhs : ast.AstExpr (lower-context-expr-get ctx rhs-box)]
          (match (lower-simple-vector-map-value
            ctx
            mode
            env
            type-env
            index
            dst-elem
            lhs)
            [(LowerMaybeVectorMapValue.Some lhs-plan)
              (match (lower-simple-vector-map-value
                ctx
                mode
                env
                type-env
                index
                dst-elem
                rhs)
                [(LowerMaybeVectorMapValue.Some rhs-plan)
                  (LowerMaybeVectorMapValue.Some
                    (LowerVectorMapValue.BinOp
                      (lower-binop op dst-elem)
                      (box lhs-plan)
                      (box rhs-plan)))]
                [(LowerMaybeVectorMapValue.No) (LowerMaybeVectorMapValue.No)])]
            [(LowerMaybeVectorMapValue.No) (LowerMaybeVectorMapValue.No)]))
        (LowerMaybeVectorMapValue.No))]
    [_ (LowerMaybeVectorMapValue.No)]))

(define (lower-vector-map-value-array-vars [plan : LowerVectorMapValue]) : LowerArrayVarSet
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
    [(LowerVectorMapValue.Gather _ indexes-var)
      ;; Only the contiguous index stream participates in the vector loop's
      ;; range proof. Gathered source indexes are checked individually below.
      (lower-array-var-set-add (lower-array-var-set-empty) indexes-var 0)]
    [(LowerVectorMapValue.GatherLaneOffset _ _) (lower-array-var-set-empty)]
    [(LowerVectorMapValue.LaneArray _) (lower-array-var-set-empty)]
    [(LowerVectorMapValue.Uniform _) (lower-array-var-set-empty)]
    [(LowerVectorMapValue.BroadcastArray array-var _)
      (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
    [(LowerVectorMapValue.LaneIndex) (lower-array-var-set-empty)]
    [(LowerVectorMapValue.LaneCount) (lower-array-var-set-empty)]
    [(LowerVectorMapValue.Shuffle source selector)
      (lower-array-var-set-merge
        (lower-vector-map-value-array-vars (box-get source))
        (lower-vector-map-value-array-vars (box-get selector)))]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (lower-array-var-set-merge
        (lower-vector-map-value-array-vars (box-get lhs))
        (lower-vector-map-value-array-vars (box-get rhs)))]))

(define (lower-vector-map-value-uses-array?
  [plan : LowerVectorMapValue]
  [array-var : i64]) : bool
  (match plan
    [(LowerVectorMapValue.Array found) (= found array-var)]
    [(LowerVectorMapValue.Gather source indexes)
      (or (= source array-var) (= indexes array-var))]
    [(LowerVectorMapValue.GatherLaneOffset source offsets)
      (or (= source array-var) (= offsets array-var))]
    [(LowerVectorMapValue.LaneArray found) (= found array-var)]
    [(LowerVectorMapValue.BroadcastArray found _) (= found array-var)]
    [(LowerVectorMapValue.Shuffle source selector)
      (or
        (lower-vector-map-value-uses-array? (box-get source) array-var)
        (lower-vector-map-value-uses-array? (box-get selector) array-var))]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-uses-array? (box-get lhs) array-var)
        (lower-vector-map-value-uses-array? (box-get rhs) array-var))]
    [_ false]))

(define (lower-vector-map-store-list-empty) : LowerVectorMapStoreList
  (LowerVectorMapStoreList (make-array LowerVectorMapStore 0) 0))

(define (lower-vector-map-store-list-add
  [stores : LowerVectorMapStoreList]
  [store : LowerVectorMapStore]) : LowerVectorMapStoreList
  (let
    [items : (__tl_dyn-array LowerVectorMapStore) (struct-get stores items)]
    [count : i64 (struct-get stores count)]
    (begin
      (array-push! items store)
      (LowerVectorMapStoreList items (+ count 1)))))

(define (lower-vector-map-store-list-ref
  [stores : LowerVectorMapStoreList]
  [index : i64]) : LowerVectorMapStore
  (array-ref (struct-get stores items) index))

(define (lower-vector-map-store-list-has-destination?
  [stores : LowerVectorMapStoreList]
  [array-var : i64]) : bool
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore array-var-found _)
            (if (= array-var-found array-var)
              (set! found true)
              (set! index (+ index 1)))]))
      found)))

(define (lower-vector-map-store-list-input-uses-destination?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [found : bool false]
    (begin
      (while (and (not found) (< index count))
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore _ value-plan)
            (let
              [dst-index : i64 0]
              (begin
                (while (and (not found) (< dst-index count))
                  (match (lower-vector-map-store-list-ref stores dst-index)
                    [(LowerVectorMapStore dst-array _)
                      (if (lower-vector-map-value-uses-array?
                        value-plan
                        dst-array)
                        (set! found true)
                        (set! dst-index (+ dst-index 1)))]))
                (set! index (+ index 1))))]))
      found)))

(define (lower-vector-map-store-list-array-vars
  [stores : LowerVectorMapStoreList]) : LowerArrayVarSet
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [arrays : LowerArrayVarSet (lower-array-var-set-empty)]
    (begin
      (while (< index count)
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore dst-array value-plan)
            (begin
              (set!
                arrays
                (lower-array-var-set-merge
                  arrays
                  (lower-vector-map-value-array-vars value-plan)))
              (set! arrays (lower-array-var-set-add arrays dst-array 0))
              (set! index (+ index 1)))]))
      arrays)))

(define (lower-simple-vector-map-store
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [expr : ast.AstExpr]) : LowerMaybeVectorMapStore
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-simple-vector-map-store
        ctx
        mode
        env
        type-env
        index
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.ArraySet arr-box set-index-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [set-index : ast.AstExpr (lower-context-expr-get ctx set-index-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (if (lower-expr-is-var? ctx set-index index)
          (match (lower-dynamic-array-var ctx env type-env arr)
            [(LowerMaybeArrayVar.Some dst-var dst-elem)
              (let
                [lanes : i64 (lower-simd-lanes-for-elem mode dst-elem)]
                (if (> lanes 0)
                  (match (lower-simple-vector-map-value
                    ctx
                    mode
                    env
                    type-env
                    index
                    dst-elem
                    value)
                    [(LowerMaybeVectorMapValue.Some value-plan)
                      (LowerMaybeVectorMapStore.Some
                        (LowerVectorMapStore dst-var value-plan)
                        dst-elem
                        lanes)]
                    [(LowerMaybeVectorMapValue.No)
                      (LowerMaybeVectorMapStore.No)])
                  (LowerMaybeVectorMapStore.No)))]
            [(LowerMaybeArrayVar.No) (LowerMaybeVectorMapStore.No)])
          (LowerMaybeVectorMapStore.No)))]
    [_ (LowerMaybeVectorMapStore.No)]))

(define (lower-simple-vector-map-expr-list
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [exprs : ast.AstExprList]) : LowerMaybeVectorMap
  (lower-simple-vector-map-expr-list-at
    ctx
    mode
    env
    type-env
    index
    (& exprs)
    0
    (lower-vector-map-store-list-empty)
    (ast.AstType.Unit)
    0))

(define (lower-simple-vector-map-expr-list-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]
  [stores : LowerVectorMapStoreList]
  [elem-ty : ast.AstType]
  [lanes : i64]) : LowerMaybeVectorMap
  (if (>= expr-index (struct-get exprs len))
    (if (and
      (> (struct-get stores count) 0)
      (or
        (= (struct-get stores count) 1)
        (not (lower-vector-map-store-list-input-uses-destination? stores))))
      (LowerMaybeVectorMap.Some stores elem-ty lanes)
      (LowerMaybeVectorMap.No))
    (match (lower-simple-vector-map-store
      ctx
      mode
      env
      type-env
      index
      (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0)))
      [(LowerMaybeVectorMapStore.Some store store-elem store-lanes)
        (match store
          [(LowerVectorMapStore dst-array _)
            (if (or
              (lower-vector-map-store-list-has-destination? stores dst-array)
              (and
                (> (struct-get stores count) 0)
                (or
                  (not (tc_core.tc-type-eq elem-ty store-elem))
                  (not (= lanes store-lanes)))))
              (LowerMaybeVectorMap.No)
              (lower-simple-vector-map-expr-list-at
                ctx
                mode
                env
                type-env
                index
                exprs
                (+ expr-index 1)
                (lower-vector-map-store-list-add stores store)
                store-elem
                store-lanes))])]
      [(LowerMaybeVectorMapStore.No) (LowerMaybeVectorMap.No)])))

(define (lower-simple-vector-map
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [body : ast.AstExpr]) : LowerMaybeVectorMap
  (match body
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map ctx mode env type-env index inner))]
    [(ast.AstExpr.Begin exprs)
      (lower-simple-vector-map-expr-list ctx mode env type-env index exprs)]
    [(ast.AstExpr.ArraySet _ _ _)
      (match (lower-simple-vector-map-store ctx mode env type-env index body)
        [(LowerMaybeVectorMapStore.Some store elem-ty lanes)
          (LowerMaybeVectorMap.Some
            (lower-vector-map-store-list-add
              (lower-vector-map-store-list-empty)
              store)
            elem-ty
            lanes)]
        [(LowerMaybeVectorMapStore.No) (LowerMaybeVectorMap.No)])]
    [_ (LowerMaybeVectorMap.No)]))

(define (lower-simple-vector-reduce-op-supported?
  [_mode : CompilerLowerMode]
  [op : ast.AstReduceOp]
  [elem : ast.AstType]) : bool
  (match op
    [(ast.AstReduceOp.Sum)
      (match elem
        [(ast.AstType.I64) true]
        [(ast.AstType.I32) true]
        [(ast.AstType.F32) true]
        [(ast.AstType.F64) true]
        [_ false])]
    [(ast.AstReduceOp.Min)
      (match elem
        [(ast.AstType.I32) true]
        [(ast.AstType.I64) true]
        [_ false])]
    [(ast.AstReduceOp.Max)
      (match elem
        [(ast.AstType.I32) true]
        [(ast.AstType.I64) true]
        [_ false])]
    [(ast.AstReduceOp.All)
      (match elem
        [(ast.AstType.Bool) true]
        [_ false])]
    [(ast.AstReduceOp.Any)
      (match elem
        [(ast.AstType.Bool) true]
        [_ false])]))

(define (lower-simple-vector-scan-op-supported?
  [op : ast.AstReduceOp]
  [elem : ast.AstType]) : bool
  (match op
    [(ast.AstReduceOp.Sum)
      (match elem
        [(ast.AstType.I32) true]
        [(ast.AstType.I64) true]
        [_ false])]
    [(ast.AstReduceOp.Min)
      (match elem
        [(ast.AstType.I32) true]
        [(ast.AstType.I64) true]
        [_ false])]
    [(ast.AstReduceOp.Max)
      (match elem
        [(ast.AstType.I32) true]
        [(ast.AstType.I64) true]
        [_ false])]
    [(ast.AstReduceOp.All)
      (match elem
        [(ast.AstType.Bool) true]
        [_ false])]
    [(ast.AstReduceOp.Any)
      (match elem
        [(ast.AstType.Bool) true]
        [_ false])]))

(define (lower-simple-vector-scan-op [op : ast.AstReduceOp]) : ir.CompilerIrVectorPrefixOp
  (match op
    [(ast.AstReduceOp.Sum) (ir.CompilerIrVectorPrefixOp.Sum)]
    [(ast.AstReduceOp.Min) (ir.CompilerIrVectorPrefixOp.Min)]
    [(ast.AstReduceOp.Max) (ir.CompilerIrVectorPrefixOp.Max)]
    [(ast.AstReduceOp.All) (ir.CompilerIrVectorPrefixOp.All)]
    [(ast.AstReduceOp.Any) (ir.CompilerIrVectorPrefixOp.Any)]))

(define (lower-simple-vector-scan-output
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [prefix : String]
  [body : ast.AstExpr]) : LowerMaybeArrayVar
  (match body
    [(ast.AstExpr.Spanned inner-box _)
      (lower-simple-vector-scan-output
        ctx
        env
        type-env
        index
        prefix
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-simple-vector-scan-output
        ctx
        env
        type-env
        index
        prefix
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (if (and
        (lower-expr-is-var? ctx (lower-context-expr-get ctx index-box) index)
        (lower-expr-is-var? ctx (lower-context-expr-get ctx value-box) prefix))
        (lower-dynamic-array-var
          ctx
          env
          type-env
          (lower-context-expr-get ctx array-box))
        (LowerMaybeArrayVar.No))]
    [_ (LowerMaybeArrayVar.No)]))

(define (lower-simple-vector-scan
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index : String]
  [prefix : String]
  [prefix-ty : ast.AstType]
  [value : ast.AstExpr]
  [body : ast.AstExpr]) : LowerMaybeVectorScan
  (if (not (lower-mode-simd? mode))
    (LowerMaybeVectorScan.No)
    (match (lower-array-ref-var-for-index ctx env type-env value index)
      [(LowerMaybeArrayVar.Some input-var input-ty)
        (match (lower-simple-vector-scan-output
          ctx
          env
          type-env
          index
          prefix
          body)
          [(LowerMaybeArrayVar.Some output-var output-ty)
            (let
              [elem-ty : ast.AstType (tc_core.tc-type-without-regions input-ty)]
              [lanes : i64
                (if (lower-type-bool? elem-ty)
                  (lower-avx512-bool-lanes mode)
                  (lower-simd-lanes-for-elem mode elem-ty))]
              (if (and
                (> lanes 0)
                (tc_core.tc-type-eq
                  elem-ty
                  (tc_core.tc-type-without-regions output-ty))
                (tc_core.tc-type-eq
                  elem-ty
                  (tc_core.tc-type-without-regions prefix-ty))
                (lower-simple-vector-scan-op-supported? op elem-ty))
                (LowerMaybeVectorScan.Scan
                  input-var
                  output-var
                  (lower-simple-vector-scan-op op)
                  elem-ty
                  lanes)
                (LowerMaybeVectorScan.No)))]
          [(LowerMaybeArrayVar.No) (LowerMaybeVectorScan.No)])]
      [(LowerMaybeArrayVar.No) (LowerMaybeVectorScan.No)])))

(define (lower-simple-vector-reduce-op [op : ast.AstReduceOp]) : ir.CompilerIrVectorReduceOp
  (match op
    [(ast.AstReduceOp.Min) (ir.CompilerIrVectorReduceOp.Min)]
    [(ast.AstReduceOp.Max) (ir.CompilerIrVectorReduceOp.Max)]
    [_ (ir.CompilerIrVectorReduceOp.Sum)]))

(define (lower-simple-vector-reduce
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index : String]
  [value-ty : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeVectorReduce
  (if (lower-mode-simd? mode)
    (match value
      [(ast.AstExpr.Spanned inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-simple-vector-reduce
            ctx
            mode
            env
            type-env
            op
            index
            value-ty
            inner))]
      [(ast.AstExpr.Ann inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-simple-vector-reduce
            ctx
            mode
            env
            type-env
            op
            index
            value-ty
            inner))]
      [_
        (match (lower-array-ref-var-for-index ctx env type-env value index)
          [(LowerMaybeArrayVar.Some array-var elem-ty)
            (let
              [elem : ast.AstType (tc_core.tc-type-without-regions elem-ty)]
              [lanes : i64
                (if (lower-type-bool? elem)
                  (lower-avx512-bool-lanes mode)
                  (lower-simd-lanes-for-elem mode elem))]
              (if (and
                (> lanes 0)
                (lower-simple-vector-reduce-op-supported? mode op elem))
                (LowerMaybeVectorReduce.Array
                  array-var
                  (lower-simple-vector-reduce-op op)
                  elem
                  lanes)
                (LowerMaybeVectorReduce.No)))]
          [(LowerMaybeArrayVar.No)
            (let
              [elem : ast.AstType (tc_core.tc-type-without-regions value-ty)]
              [lanes : i64
                (if (lower-type-bool? elem)
                  (lower-avx512-bool-lanes mode)
                  (lower-simd-lanes-for-elem mode elem))]
              (if (and
                (> lanes 0)
                (lower-simple-vector-reduce-op-supported? mode op elem))
                (match (lower-simple-vector-map-value
                  ctx
                  mode
                  env
                  type-env
                  index
                  elem
                  value)
                  [(LowerMaybeVectorMapValue.Some value-plan)
                    (LowerMaybeVectorReduce.Value
                      value-plan
                      (lower-simple-vector-reduce-op op)
                      elem
                      lanes)]
                  [(LowerMaybeVectorMapValue.No) (LowerMaybeVectorReduce.No)])
                (LowerMaybeVectorReduce.No)))])])
    (LowerMaybeVectorReduce.No)))

(define (lower-array-len-value
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]) : LowerExpr
  (match (lower-emit-gep
    state
    arr-value
    (ir.CompilerIrValue.I64 1)
    (ast.AstType.I64))
    [(LowerExpr.Expr gep-state len-gep _)
      (lower-emit-load gep-state len-gep (ast.AstType.I64))]))

(define (lower-array-data-pointer-value
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]) : LowerExpr
  ;; Dynamic-array fat header slot 0 is the element data pointer. Emit it as a
  ;; normal load keyed by the array header value so redundant-load CSE can see
  ;; repeated SIMD accesses to the same base.
  (lower-emit-load state arr-value (ast.AstType.U64)))

(define (lower-emit-vector-load-data
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.CompilerIrInstr.VectorLoad v data-ptr index lanes elem-ty))
        (ir.CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-vector-load
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr.Expr data-state data-ptr _)
      (lower-emit-vector-load-data data-state data-ptr index lanes elem-ty)]))

(define (lower-emit-gather-load
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [index-base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [lane-offset : bool]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.ir-instr-gather-load
            v
            base
            index-base
            index
            lane-offset
            lanes
            elem-ty))
        (ir.CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-vector-shuffle-instr
  [state : LowerState]
  [source : ir.CompilerIrValue]
  [selector-low : ir.CompilerIrValue]
  [selector-high : ir.CompilerIrMaybeValue]
  [active-lanes : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.ir-instr-vector-shuffle
            v
            source
            selector-low
            selector-high
            active-lanes
            lanes
            elem-ty))
        (ir.CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-gather-lane-checks
  [_ctx : tc_core.TcContext]
  [state : LowerState]
  [indexes-data : ir.CompilerIrValue]
  [base-index-var : i64]
  [lane : i64]
  [lanes : i64]
  [source-len : ir.CompilerIrValue]) : LowerExpr
  (if (>= lane lanes)
    (LowerExpr.Expr state ir.CompilerIrValue.Unit (ast.AstType.Unit))
    (match (if (= lane 0)
      (LowerExpr.Expr
        state
        (ir.CompilerIrValue.Var base-index-var)
        (ast.AstType.I64))
      (lower-emit-binop
        state
        ir.CompilerIrBinOp.Add
        (ir.CompilerIrValue.Var base-index-var)
        (ir.CompilerIrValue.I64 lane)
        (ast.AstType.I64)))
      [(LowerExpr.Expr lane-state logical-index _)
        ;; The vector-loop range guard has already proved this contiguous
        ;; index lane is in bounds. Address it directly so gather validation
        ;; performs only the semantically required source-index check.
        (match (lower-emit-gep
          lane-state
          indexes-data
          logical-index
          (ast.AstType.I64))
          [(LowerExpr.Expr addr-state index-ptr _)
            (match (lower-emit-load addr-state index-ptr (ast.AstType.I64))
              [(LowerExpr.Expr index-state gathered-index _)
                (lower-emit-gather-lane-checks
                  _ctx
                  (lower-emit-bounds-check
                    index-state
                    gathered-index
                    source-len)
                  indexes-data
                  base-index-var
                  (+ lane 1)
                  lanes
                  source-len)])])])))

(define (lower-emit-gather-lane-offset-checks
  [state : LowerState]
  [offsets-data : ir.CompilerIrValue]
  [base-index-var : i64]
  [lane : i64]
  [lanes : i64]
  [source-len : ir.CompilerIrValue]) : LowerExpr
  (if (>= lane lanes)
    (LowerExpr.Expr state ir.CompilerIrValue.Unit (ast.AstType.Unit))
    (match (if (= lane 0)
      (LowerExpr.Expr
        state
        (ir.CompilerIrValue.Var base-index-var)
        (ast.AstType.I64))
      (lower-emit-binop
        state
        ir.CompilerIrBinOp.Add
        (ir.CompilerIrValue.Var base-index-var)
        (ir.CompilerIrValue.I64 lane)
        (ast.AstType.I64)))
      [(LowerExpr.Expr logical-state logical-index _)
        (match (lower-emit-gep
          logical-state
          offsets-data
          (ir.CompilerIrValue.I64 lane)
          (ast.AstType.I64))
          [(LowerExpr.Expr addr-state offset-ptr _)
            (match (lower-emit-load addr-state offset-ptr (ast.AstType.I64))
              [(LowerExpr.Expr offset-state offset _)
                (match (lower-emit-binop
                  offset-state
                  ir.CompilerIrBinOp.Add
                  logical-index
                  offset
                  (ast.AstType.I64))
                  [(LowerExpr.Expr index-state gathered-index _)
                    (lower-emit-gather-lane-offset-checks
                      (lower-emit-bounds-check
                        index-state
                        gathered-index
                        source-len)
                      offsets-data
                      base-index-var
                      (+ lane 1)
                      lanes
                      source-len)])])])])))

(define (lower-emit-vector-store
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr.Expr data-state data-ptr _)
      (lower-emit-vector-store-data
        data-state
        data-ptr
        index
        value
        lanes
        elem-ty)]))

(define (lower-emit-vector-store-data
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (lower-state-emit
    state
    (ir.ir-instr-vector-store data-ptr index value lanes elem-ty)))

(define (lower-emit-vector-binop
  [state : LowerState]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.ir-instr-vector-bin-op v op lhs rhs lanes elem-ty))
        (ir.CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-splat
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir.CompilerIrInstr.Splat v value lanes elem-ty))
        (ir.CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-lane-id
  [state : LowerState]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir.CompilerIrInstr.LaneId v lanes elem-ty))
        (ir.CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-foreach-index-vector
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]) : LowerExpr
  (match (lower-emit-splat
    state
    (ir.CompilerIrValue.Var index-var)
    lanes
    (ast.AstType.I64))
    [(LowerExpr.Expr base-state base-value _)
      (match (lower-emit-lane-id base-state lanes (ast.AstType.I64))
        [(LowerExpr.Expr lane-state lane-value _)
          (lower-emit-vector-binop
            lane-state
            (ir.CompilerIrBinOp.Add)
            base-value
            lane-value
            lanes
            (ast.AstType.I64))])]))

(define (lower-emit-vector-compare
  [state : LowerState]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.ir-instr-vector-compare v op lhs rhs lanes elem-ty))
        (ir.CompilerIrValue.Var v)
        (ast.AstType.Bool))]))

(define (lower-emit-mask-binop
  [state : LowerState]
  [op : ir.CompilerIrMaskBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir.CompilerIrInstr.MaskBinOp v op lhs rhs lanes))
        (ir.CompilerIrValue.Var v)
        (ast.AstType.Bool))]))

(define (lower-emit-mask-not
  [state : LowerState]
  [src : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir.CompilerIrInstr.MaskNot v src lanes))
        (ir.CompilerIrValue.Var v)
        (ast.AstType.Bool))]))

(define (lower-emit-mask-reduce
  [state : LowerState]
  [op : ir.CompilerIrMaskReduceOp]
  [src : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit s (ir.CompilerIrInstr.MaskReduce v op src lanes))
        (ir.CompilerIrValue.Var v)
        (ast.AstType.Bool))]))

(define (lower-vector-map-binop-shift? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(ir.CompilerIrBinOp.Shl _) true]
    [(ir.CompilerIrBinOp.Shr _) true]
    [_ false]))

(define (lower-emit-checked-vector-shift
  [state : LowerState (:consume)]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [op : ir.CompilerIrBinOp]
  [left-value : ir.CompilerIrValue]
  [right-value : ir.CompilerIrValue]
  [lane-ty : ast.AstType]
  [count-ty : ast.AstType]) : LowerExpr
  (let
    [s : LowerState state]
    [zero : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [width : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [negative : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [too-large : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [invalid : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [active-invalid : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [any-invalid : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [abort-label : i64 (ir.compiler-ir-label-none)]
    [continue-label : i64 (ir.compiler-ir-label-none)]
    (begin
      (match (lower-emit-splat s (ir.CompilerIrValue.I64 0) lanes count-ty)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! zero value))])
      (match (lower-emit-splat
        s
        (ir.CompilerIrValue.I64 (lower-spmd-shift-width lane-ty))
        lanes
        count-ty)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! width value))])
      (match (if (lower-type-signed? count-ty)
        (lower-emit-vector-compare
          s
          (ir.CompilerIrBinOp.Lt)
          right-value
          zero
          lanes
          count-ty)
        ;; Unsigned counts cannot be negative. Materialize an all-false mask
        ;; without relying on the backend's signed/unsigned compare expansion.
        (lower-emit-vector-compare
          s
          (ir.CompilerIrBinOp.Ne)
          zero
          zero
          lanes
          count-ty))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! negative value))])
      (match (lower-emit-vector-compare
        s
        (ir.CompilerIrBinOp.Ge)
        right-value
        width
        lanes
        count-ty)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! too-large value))])
      (match (lower-emit-mask-binop
        s
        (ir.CompilerIrMaskBinOp.Or)
        negative
        too-large
        lanes)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! invalid value))])
      (match active-mask
        [(ir.CompilerIrMaybeValue.Some mask)
          (match (lower-emit-mask-binop
            s
            (ir.CompilerIrMaskBinOp.And)
            invalid
            mask
            lanes)
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! active-invalid value))])]
        [(ir.CompilerIrMaybeValue.No) (set! active-invalid invalid)])
      (match (lower-emit-mask-reduce
        s
        (ir.CompilerIrMaskReduceOp.Any)
        active-invalid
        lanes)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! any-invalid value))])
      (match (lower-state-fresh-label s "spmd_shift_abort")
        [(LowerLabel.Label next-s label)
          (begin
            (set! s next-s)
            (set! abort-label label))])
      (match (lower-state-fresh-label s "spmd_shift_continue")
        [(LowerLabel.Label next-s label)
          (begin
            (set! s next-s)
            (set! continue-label label))])
      (set!
        s
        (lower-state-finish-block
          (lower-state-emit
            s
            (ir.CompilerIrInstr.Branch any-invalid abort-label continue-label))
          abort-label))
      (set!
        s
        (lower-state-finish-block
          (lower-state-emit
            (lower-shift-abort s)
            (ir.CompilerIrInstr.Jump continue-label))
          continue-label))
      (lower-emit-vector-binop s op left-value right-value lanes lane-ty))))

(define (lower-emit-vector-map-binop
  [state : LowerState (:consume)]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (if (lower-vector-map-binop-shift? op)
    (lower-emit-checked-vector-shift
      state
      (match emit-mode
        [(LowerVectorMapEmitMode.Full) (ir.CompilerIrMaybeValue.No)]
        [(LowerVectorMapEmitMode.Predicated _ mask)
          (ir.CompilerIrMaybeValue.Some mask)])
      lanes
      op
      lhs
      rhs
      elem-ty
      elem-ty)
    (lower-emit-vector-binop state op lhs rhs lanes elem-ty)))

(define (lower-emit-mask-select
  [state : LowerState]
  [then-mask : ir.CompilerIrValue]
  [then-value : ir.CompilerIrValue]
  [else-mask : ir.CompilerIrValue]
  [else-value : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [then-bits : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [else-bits : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    (begin
      (match (lower-emit-mask-binop
        s
        (ir.CompilerIrMaskBinOp.And)
        then-mask
        then-value
        lanes)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! then-bits value))])
      (match (lower-emit-mask-binop
        s
        (ir.CompilerIrMaskBinOp.And)
        else-mask
        else-value
        lanes)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! else-bits value))])
      (lower-emit-mask-binop
        s
        (ir.CompilerIrMaskBinOp.Or)
        then-bits
        else-bits
        lanes))))

(define (lower-emit-select
  [state : LowerState]
  [mask : ir.CompilerIrValue]
  [on-true : ir.CompilerIrValue]
  [on-false : ir.CompilerIrValue]
  [lanes : i64]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.ir-instr-select v mask on-true on-false lanes ty))
        (ir.CompilerIrValue.Var v)
        ty)]))

;; SIMD loop bounds are invariant across gangs. Build the minimum with scalar
;; mask blends in the preheader so each vector header needs only one compare.
(define (lower-vector-loop-i64-compare
  [state : LowerState]
  [op : ir.CompilerIrBinOp]
  [left : ir.CompilerIrValue]
  [right : ir.CompilerIrValue]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      ;; Comparisons produce a boolean value, but the IR instruction's type is
      ;; the operand width used by the backend comparison.
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.CompilerIrInstr.BinOp v op left right (ast.AstType.I64)))
        (ir.CompilerIrValue.Var v)
        (ast.AstType.Bool))]))

(define (lower-vector-loop-select
  [state : LowerState]
  [condition : ir.CompilerIrValue]
  [on-true : ir.CompilerIrValue]
  [on-false : ir.CompilerIrValue]) : LowerExpr
  (let
    [s : LowerState state]
    [condition-i64 : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [mask : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [different-bits : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [selected-bits : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    (begin
      (match (lower-emit-cast s condition (ast.AstType.Bool) (ast.AstType.I64))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! condition-i64 value))])
      (match (lower-emit-binop
        s
        (ir.CompilerIrBinOp.Sub)
        (ir.CompilerIrValue.I64 0)
        condition-i64
        (ast.AstType.I64))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! mask value))])
      (match (lower-emit-binop
        s
        (ir.CompilerIrBinOp.BitXor)
        on-true
        on-false
        (ast.AstType.I64))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! different-bits value))])
      (match (lower-emit-binop
        s
        (ir.CompilerIrBinOp.BitAnd)
        different-bits
        mask
        (ast.AstType.I64))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! selected-bits value))])
      (lower-emit-binop
        s
        (ir.CompilerIrBinOp.BitXor)
        on-false
        selected-bits
        (ast.AstType.I64)))))

(define (lower-vector-loop-min
  [state : LowerState]
  [left : ir.CompilerIrValue]
  [right : ir.CompilerIrValue]) : LowerExpr
  (match (lower-vector-loop-i64-compare
    state
    (ir.CompilerIrBinOp.Le)
    left
    right)
    [(LowerExpr.Expr cmp-state take-left _)
      (lower-vector-loop-select cmp-state take-left left right)]))

(define (lower-vector-loop-start-ok
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      ;; As u64, every negative i64 start is above INT64_MAX. This one check
      ;; therefore also proves that adding lanes cannot overflow.
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.CompilerIrInstr.BinOp
            v
            (ir.CompilerIrBinOp.Le)
            (ir.CompilerIrValue.Var index-var)
            (ir.CompilerIrValue.I64 (- 9223372036854775807 lanes))
            (ast.AstType.U64)))
        (ir.CompilerIrValue.Var v)
        (ast.AstType.Bool))]))

(define (lower-vector-loop-array-limit
  [state : LowerState]
  [array-var : i64]
  [offset : i64]) : LowerExpr
  (match (lower-array-len-value state (ir.CompilerIrValue.Var array-var))
    [(LowerExpr.Expr len-state array-len _)
      (if (> offset 0)
        (let
          [s : LowerState len-state]
          [offset-valid : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          [candidate : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          (begin
            (match (lower-vector-loop-i64-compare
              s
              (ir.CompilerIrBinOp.Ge)
              array-len
              (ir.CompilerIrValue.I64 offset))
              [(LowerExpr.Expr next-s value _)
                (begin
                  (set! s next-s)
                  (set! offset-valid value))])
            (match (lower-emit-binop
              s
              (ir.CompilerIrBinOp.Sub)
              array-len
              (ir.CompilerIrValue.I64 offset)
              (ast.AstType.I64))
              [(LowerExpr.Expr next-s value _)
                (begin
                  (set! s next-s)
                  (set! candidate value))])
            ;; A too-short array cannot admit a vector gang. Avoid exposing the
            ;; wrapped subtraction as a large positive bound.
            (lower-vector-loop-select
              s
              offset-valid
              candidate
              (ir.CompilerIrValue.I64 -1))))
        (LowerExpr.Expr len-state array-len (ast.AstType.I64)))]))

(define (lower-vector-loop-limit
  [state : LowerState]
  [end-value : ir.CompilerIrValue]
  [arrays : LowerArrayVarSet]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc alloc-state end-var)
      (let
        [s : LowerState
          (lower-state-emit
            alloc-state
            (ir.CompilerIrInstr.Mov end-var end-value (ast.AstType.I64)))]
        [limit : ir.CompilerIrValue ir.CompilerIrValue.Unit]
        [index : i64 0]
        [count : i64 (struct-get arrays count)]
        (begin
          ;; Materialize the end bound before comparing it: direct literal
          ;; endpoints do not retain their width through scalar min selection.
          ;;
          ;; Besides bounding the first gang, this clamp ensures the next
          ;; header's index + lanes calculation cannot overflow after a
          ;; successful gang.
          (match (lower-vector-loop-min
            s
            (ir.CompilerIrValue.Var end-var)
            (ir.CompilerIrValue.I64 (- 9223372036854775807 lanes)))
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! limit value))])
          (while (< index count)
            (begin
              (match (lower-vector-loop-array-limit
                s
                (array-ref (struct-get arrays vars) index)
                (array-ref (struct-get arrays offsets) index))
                [(LowerExpr.Expr array-state array-limit _)
                  (match (lower-vector-loop-min array-state limit array-limit)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! limit value))])])
              (set! index (+ index 1))))
          (LowerExpr.Expr s limit (ast.AstType.I64))))]))

(define (lower-vector-loop-next-ok
  [state : LowerState]
  [next-index : ir.CompilerIrValue]
  [limit : ir.CompilerIrValue]) : LowerExpr
  (lower-vector-loop-i64-compare state (ir.CompilerIrBinOp.Le) next-index limit))

(define (lower-emit-vector-reduce
  [state : LowerState]
  [op : ir.CompilerIrVectorReduceOp]
  [src : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.CompilerIrInstr.VectorReduce v op src lanes elem-ty))
        (ir.CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-spmd-reduce-mask-op [op : ast.AstReduceOp]) : ir.CompilerIrMaskReduceOp
  (match op
    [(ast.AstReduceOp.All) (ir.CompilerIrMaskReduceOp.All)]
    [_ (ir.CompilerIrMaskReduceOp.Any)]))

(define (lower-spmd-reduce-chunk
  [state : LowerState]
  [op : ast.AstReduceOp]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [src : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (if (lower-type-bool? elem-ty)
    (lower-emit-mask-reduce state (lower-spmd-reduce-mask-op op) src lanes)
    (lower-emit-vector-reduce state vector-op src lanes elem-ty)))

(define (lower-spmd-reduce-array-chunk
  [state : LowerState]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [data-ptr : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (if (lower-type-bool? elem-ty)
    (match (lower-emit-tail-mask
      state
      (ir.CompilerIrValue.Var index-var)
      next-index
      lanes)
      [(LowerExpr.Expr mask-state full-mask _)
        (lower-emit-predicated-load-data
          mask-state
          data-ptr
          (ir.CompilerIrValue.Var index-var)
          full-mask
          lanes
          elem-ty)])
    (lower-emit-vector-load-data
      state
      data-ptr
      (ir.CompilerIrValue.Var index-var)
      lanes
      elem-ty)))

(define (lower-spmd-reduce-apply-update
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [acc-var : i64]
  [elem-ty : ast.AstType]
  [value-var : i64]) : ResultLowerExpr
  (let
    [acc-name-id : i64 (lower-spmd-reduce-acc-id)]
    [current-name-id : i64 (lower-spmd-reduce-current-id)]
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    (lower-expr
      ctx
      state
      (sym_i64_env.sym-i64-bind-id
        (sym_i64_env.sym-i64-bind-id env acc-name-id acc-var)
        current-name-id
        value-var)
      (tc_core.tc-bind-id
        (tc_core.tc-bind-id type-env acc-name-id elem-ty)
        current-name-id
        elem-ty)
      (lower-context-expr-get
        ctx
        (spmd-reduce-acc-update-expr
          pools
          op
          (ast.ast-node-pool-context-expr-push
            pools
            (ast.AstExpr.Var current-name-id)))))))

(define (lower-spmd-reduce-vector-accumulator? [elem-ty : ast.AstType]) : bool
  (match elem-ty
    [(ast.AstType.I32) true]
    [(ast.AstType.I64) true]
    [_ false]))

(define (lower-spmd-reduce-vector-accumulator-init
  [op : ast.AstReduceOp]
  [acc-var : i64]) : ir.CompilerIrValue
  (match op
    [(ast.AstReduceOp.Sum) (ir.CompilerIrValue.I64 0)]
    ;; Min/max are idempotent, so seeding every lane from the scalar init
    ;; preserves seeded and empty-range semantics without signed-extreme
    ;; constants. The post-loop horizontal result already includes the seed.
    [_ (ir.CompilerIrValue.Var acc-var)]))

(define (lower-spmd-reduce-vector-accumulate
  [state : LowerState (:consume)]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [vector-acc-var : i64]
  [value : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (match vector-op
    [(ir.CompilerIrVectorReduceOp.Sum)
      (lower-state-emit
        state
        (ir.ir-instr-vector-bin-op
          vector-acc-var
          ir.CompilerIrBinOp.Add
          (ir.CompilerIrValue.Var vector-acc-var)
          value
          lanes
          elem-ty))]
    [_
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc compare-alloc mask-var)
          (let
            [compare-op : ir.CompilerIrBinOp
              (match vector-op
                [(ir.CompilerIrVectorReduceOp.Min) ir.CompilerIrBinOp.Lt]
                [_ ir.CompilerIrBinOp.Gt])]
            (lower-state-emit
              (lower-state-emit
                compare-alloc
                (ir.ir-instr-vector-compare
                  mask-var
                  compare-op
                  value
                  (ir.CompilerIrValue.Var vector-acc-var)
                  lanes
                  elem-ty))
              (ir.ir-instr-select
                vector-acc-var
                (ir.CompilerIrValue.Var mask-var)
                value
                (ir.CompilerIrValue.Var vector-acc-var)
                lanes
                elem-ty)))])]))

(define (lower-spmd-reduce-finish-vector-accumulator
  [state : LowerState]
  [op : ast.AstReduceOp]
  [acc-var : i64]
  [vector-acc-var : i64]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc reduce-alloc reduced-var)
      (let
        [reduced-state : LowerState
          (lower-state-emit
            reduce-alloc
            (ir.CompilerIrInstr.VectorReduce
              reduced-var
              vector-op
              (ir.CompilerIrValue.Var vector-acc-var)
              lanes
              elem-ty))]
        (match op
          [(ast.AstReduceOp.Sum)
            (match (lower-state-alloc-var reduced-state)
              [(LowerAlloc.Alloc update-alloc updated-var)
                (lower-state-emit
                  (lower-state-emit
                    update-alloc
                    (ir.CompilerIrInstr.BinOp
                      updated-var
                      ir.CompilerIrBinOp.Add
                      (ir.CompilerIrValue.Var acc-var)
                      (ir.CompilerIrValue.Var reduced-var)
                      elem-ty))
                  (ir.CompilerIrInstr.Mov
                    acc-var
                    (ir.CompilerIrValue.Var updated-var)
                    elem-ty))])]
          ;; Every min/max lane was initialized with acc-var, so the horizontal
          ;; result already contains the scalar seed.
          [_
            (lower-state-emit
              reduced-state
              (ir.CompilerIrInstr.Mov
                acc-var
                (ir.CompilerIrValue.Var reduced-var)
                elem-ty))]))]))

(define (lower-avx2-reduce-vector-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [acc-var : i64]
  [vector-acc-var : i64]
  [data-ptr : ir.CompilerIrValue]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-spmd-reduce-array-chunk
    state
    index-var
    next-index
    data-ptr
    lanes
    elem-ty)
    [(LowerExpr.Expr load-state chunk-vec _)
      (if (lower-spmd-reduce-vector-accumulator? elem-ty)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-state-emit
              (lower-spmd-reduce-vector-accumulate
                load-state
                vector-op
                vector-acc-var
                chunk-vec
                lanes
                elem-ty)
              (ir.CompilerIrInstr.Mov index-var next-index (ast.AstType.I64)))
            ir.CompilerIrValue.Unit
            (ast.AstType.Unit)))
        (match (lower-spmd-reduce-chunk
          load-state
          op
          vector-op
          chunk-vec
          lanes
          elem-ty)
          [(LowerExpr.Expr reduce-state reduced _)
            (match reduced
              [(ir.CompilerIrValue.Var reduced-var)
                (match (lower-spmd-reduce-apply-update
                  ctx
                  reduce-state
                  env
                  type-env
                  op
                  acc-var
                  elem-ty
                  reduced-var)
                  [(ResultLowerExpr.Ok update-lowered)
                    (match update-lowered
                      [(LowerExpr.Expr update-state _ _)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (lower-state-emit
                              update-state
                              (ir.CompilerIrInstr.Mov
                                index-var
                                next-index
                                (ast.AstType.I64)))
                            ir.CompilerIrValue.Unit
                            (ast.AstType.Unit)))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
              [_
                (ResultLowerExpr.Err
                  (box (lower-diagnostic "lower: invalid vector reduce result")))])]))]))

(define (lower-avx2-reduce-vector-value-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [acc-var : i64]
  [vector-acc-var : i64]
  [value-plan : LowerVectorMapValue]
  [preheader-cache : LowerVectorMapValueCache]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-emit-vector-map-value-cached
    ctx
    state
    index-var
    lanes
    elem-ty
    value-plan
    (LowerVectorMapEmitMode.Full)
    preheader-cache)
    [(LowerVectorMapCachedEmit.Emit value-state chunk-vec _)
      (if (lower-spmd-reduce-vector-accumulator? elem-ty)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            (lower-state-emit
              (lower-spmd-reduce-vector-accumulate
                value-state
                vector-op
                vector-acc-var
                chunk-vec
                lanes
                elem-ty)
              (ir.CompilerIrInstr.Mov index-var next-index (ast.AstType.I64)))
            ir.CompilerIrValue.Unit
            (ast.AstType.Unit)))
        (match (lower-spmd-reduce-chunk
          value-state
          op
          vector-op
          chunk-vec
          lanes
          elem-ty)
          [(LowerExpr.Expr reduce-state reduced _)
            (match reduced
              [(ir.CompilerIrValue.Var reduced-var)
                (match (lower-spmd-reduce-apply-update
                  ctx
                  reduce-state
                  env
                  type-env
                  op
                  acc-var
                  elem-ty
                  reduced-var)
                  [(ResultLowerExpr.Ok update-lowered)
                    (match update-lowered
                      [(LowerExpr.Expr update-state _ _)
                        (ResultLowerExpr.Ok
                          (LowerExpr.Expr
                            (lower-state-emit
                              update-state
                              (ir.CompilerIrInstr.Mov
                                index-var
                                next-index
                                (ast.AstType.I64)))
                            ir.CompilerIrValue.Unit
                            (ast.AstType.Unit)))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
              [_
                (ResultLowerExpr.Err
                  (box (lower-diagnostic "lower: invalid vector reduce result")))])]))]))

(define (lower-spmd-reduce-scalar-tail-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-var : i64]
  [index-ty : ast.AstType]
  [acc-var : i64]
  [array-var : i64]
  [elem-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-array-element-addr
    ctx
    state
    (ir.CompilerIrValue.Var array-var)
    (ir.CompilerIrValue.Var index-var)
    index-ty
    elem-ty)
    [(LowerExpr.Expr addr-state elem-ptr _)
      (match (lower-emit-load addr-state elem-ptr elem-ty)
        [(LowerExpr.Expr load-state loaded _)
          (match loaded
            [(ir.CompilerIrValue.Var loaded-var)
              (match (lower-spmd-reduce-apply-update
                ctx
                load-state
                env
                type-env
                op
                acc-var
                elem-ty
                loaded-var)
                [(ResultLowerExpr.Ok update-lowered)
                  (match update-lowered
                    [(LowerExpr.Expr update-state _ _)
                      (match (lower-state-alloc-var update-state)
                        [(LowerAlloc.Alloc inc-alloc inc-var)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr
                              (lower-state-emit
                                (lower-state-emit
                                  inc-alloc
                                  (ir.CompilerIrInstr.BinOp
                                    inc-var
                                    ir.CompilerIrBinOp.Add
                                    (ir.CompilerIrValue.Var index-var)
                                    (ir.CompilerIrValue.I64 1)
                                    index-ty))
                                (ir.CompilerIrInstr.Mov
                                  index-var
                                  (ir.CompilerIrValue.Var inc-var)
                                  index-ty))
                              ir.CompilerIrValue.Unit
                              (ast.AstType.Unit)))])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
            [_
              (ResultLowerExpr.Err
                (box (lower-diagnostic "lower: invalid scalar reduce load")))])])]))

(define (lower-spmd-reduce-scalar-tail-value-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [base-index-var : i64]
  [current-index-var : i64]
  [active-lanes : ir.CompilerIrValue]
  [index-ty : ast.AstType]
  [acc-var : i64]
  [value-plan : LowerVectorMapValue]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-emit-scalar-vector-map-value
    ctx
    state
    base-index-var
    current-index-var
    (ir.CompilerIrValue.I64 0)
    active-lanes
    lanes
    elem-ty
    value-plan)
    [(LowerExpr.Expr value-state scalar-value _)
      (let
        [s : LowerState value-state]
        [value-var : i64 0]
        (begin
          (match scalar-value
            [(ir.CompilerIrValue.Var var) (set! value-var var)]
            [_
              (match (lower-state-alloc-var s)
                [(LowerAlloc.Alloc alloc-state tmp-var)
                  (begin
                    (set!
                      s
                      (lower-state-emit
                        alloc-state
                        (ir.CompilerIrInstr.Mov tmp-var scalar-value elem-ty)))
                    (set! value-var tmp-var))])])
          (match (lower-spmd-reduce-apply-update
            ctx
            s
            env
            type-env
            op
            acc-var
            elem-ty
            value-var)
            [(ResultLowerExpr.Ok update-lowered)
              (match update-lowered
                [(LowerExpr.Expr update-state _ _)
                  (match (lower-state-alloc-var update-state)
                    [(LowerAlloc.Alloc inc-alloc inc-var)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-state-emit
                            (lower-state-emit
                              inc-alloc
                              (ir.CompilerIrInstr.BinOp
                                inc-var
                                ir.CompilerIrBinOp.Add
                                (ir.CompilerIrValue.Var current-index-var)
                                (ir.CompilerIrValue.I64 1)
                                index-ty))
                            (ir.CompilerIrInstr.Mov
                              current-index-var
                              (ir.CompilerIrValue.Var inc-var)
                              index-ty))
                          ir.CompilerIrValue.Unit
                          (ast.AstType.Unit)))])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))]))

(define (lower-spmd-scan-vector-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [acc-var : i64]
  [input-var : i64]
  [output-var : i64]
  [prefix-op : ir.CompilerIrVectorPrefixOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [chunk : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [full-mask : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [prefix-value : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [last-index : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    (begin
      (if (lower-type-bool? elem-ty)
        (begin
          (match (lower-emit-tail-mask
            s
            (ir.CompilerIrValue.Var index-var)
            next-index
            lanes)
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! full-mask value))])
          (match (lower-emit-predicated-load
            s
            (ir.CompilerIrValue.Var input-var)
            (ir.CompilerIrValue.Var index-var)
            full-mask
            lanes
            elem-ty)
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! chunk value))]))
        (match (lower-emit-vector-load
          s
          (ir.CompilerIrValue.Var input-var)
          (ir.CompilerIrValue.Var index-var)
          lanes
          elem-ty)
          [(LowerExpr.Expr next-s value _)
            (begin
              (set! s next-s)
              (set! chunk value))]))
      (match (lower-state-alloc-var s)
        [(LowerAlloc.Alloc next-s prefix-var)
          (begin
            (set!
              s
              (lower-state-emit
                next-s
                (ir.ir-instr-vector-prefix
                  prefix-var
                  prefix-op
                  chunk
                  (ir.CompilerIrValue.Var acc-var)
                  lanes
                  elem-ty)))
            (set! prefix-value (ir.CompilerIrValue.Var prefix-var)))])
      (if (lower-type-bool? elem-ty)
        (set!
          s
          (lower-emit-predicated-store
            s
            (ir.CompilerIrValue.Var output-var)
            (ir.CompilerIrValue.Var index-var)
            prefix-value
            full-mask
            lanes
            elem-ty))
        (set!
          s
          (lower-emit-vector-store
            s
            (ir.CompilerIrValue.Var output-var)
            (ir.CompilerIrValue.Var index-var)
            prefix-value
            lanes
            elem-ty)))
      (match (lower-emit-binop
        s
        ir.CompilerIrBinOp.Sub
        next-index
        (ir.CompilerIrValue.I64 1)
        (ast.AstType.I64))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! last-index value))])
      ;; `vector-limit` already proves the whole output gang is in bounds.
      ;; Reload the stored final lane through its raw data pointer so carry
      ;; handoff does not add a redundant scalar bounds-check block.
      (match (lower-array-data-pointer-value
        s
        (ir.CompilerIrValue.Var output-var))
        [(LowerExpr.Expr data-state data-ptr _)
          (match (lower-emit-elem-addr-gep
            ctx
            data-state
            data-ptr
            last-index
            elem-ty)
            [(LowerExpr.Expr addr-state last-addr _)
              (match (lower-emit-load addr-state last-addr elem-ty)
                [(LowerExpr.Expr load-state last-value _)
                  (set!
                    s
                    (lower-state-emit
                      load-state
                      (ir.CompilerIrInstr.Mov acc-var last-value elem-ty)))])])])
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.CompilerIrInstr.Mov index-var next-index (ast.AstType.I64)))
        ir.CompilerIrValue.Unit
        (ast.AstType.Unit)))))

(define (lower-spmd-scan-scalar-tail-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-id : i64]
  [index-var : i64]
  [index-ty : ast.AstType]
  [prefix-id : i64]
  [acc-var : i64]
  [elem-ty : ast.AstType]
  [value : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [index-env : sym_i64_env.SymI64Env
      (sym_i64_env.sym-i64-bind-id env index-id index-var)]
    [index-type-env : tc_core.TcTypeEnv
      (tc_core.tc-bind-id type-env index-id index-ty)]
    [body-env : sym_i64_env.SymI64Env
      (sym_i64_env.sym-i64-bind-id index-env prefix-id acc-var)]
    [body-type-env : tc_core.TcTypeEnv
      (tc_core.tc-bind-id index-type-env prefix-id elem-ty)]
    (match (lower-expr-expected
      ctx
      state
      index-env
      index-type-env
      value
      elem-ty
      value)
      [(ResultLowerExpr.Ok value-lowered)
        (match value-lowered
          [(LowerExpr.Expr value-state value-ir _)
            (let
              [s : LowerState value-state]
              [value-var : i64 0]
              (begin
                (match value-ir
                  [(ir.CompilerIrValue.Var var) (set! value-var var)]
                  [_
                    (match (lower-state-alloc-var s)
                      [(LowerAlloc.Alloc alloc-state var)
                        (begin
                          (set! value-var var)
                          (set!
                            s
                            (lower-state-emit
                              alloc-state
                              (ir.CompilerIrInstr.Mov var value-ir elem-ty))))])])
                (match (lower-spmd-reduce-apply-update
                  ctx
                  s
                  index-env
                  index-type-env
                  op
                  acc-var
                  elem-ty
                  value-var)
                  [(ResultLowerExpr.Ok update-lowered)
                    (match update-lowered
                      [(LowerExpr.Expr update-state _ _)
                        (match (lower-expr
                          ctx
                          update-state
                          body-env
                          body-type-env
                          body)
                          [(ResultLowerExpr.Ok body-lowered)
                            (match body-lowered
                              [(LowerExpr.Expr body-state _ _)
                                (match (lower-state-alloc-var body-state)
                                  [(LowerAlloc.Alloc inc-state inc-var)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr
                                        (lower-state-emit
                                          (lower-state-emit
                                            inc-state
                                            (ir.CompilerIrInstr.BinOp
                                              inc-var
                                              ir.CompilerIrBinOp.Add
                                              (ir.CompilerIrValue.Var index-var)
                                              (ir.CompilerIrValue.I64 1)
                                              index-ty))
                                          (ir.CompilerIrInstr.Mov
                                            index-var
                                            (ir.CompilerIrValue.Var inc-var)
                                            index-ty))
                                        ir.CompilerIrValue.Unit
                                        (ast.AstType.Unit)))])])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-spmd-scan-vector-label [state : LowerState] [suffix : String]) : String
  (str_cat.str-cat
    "spmd_scan_"
    (if (lower-mode-avx512? (lower-state-mode state))
      "avx512_"
      "avx2_")
    suffix))

(define (lower-simd-spmd-scan-build
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-id : i64]
  [index-ty : ast.AstType]
  [init-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [prefix-id : i64]
  [value : ast.AstExpr]
  [body : ast.AstExpr]
  [input-var : i64]
  [output-var : i64]
  [prefix-op : ir.CompilerIrVectorPrefixOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc acc-state acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-state
          (ir.CompilerIrInstr.Mov acc-var init-value elem-ty)))
        [(LowerAlloc.Alloc index-state index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-state
                (ir.CompilerIrInstr.Mov index-var start-value index-ty))]
            [header-label : i64 (ir.compiler-ir-label-none)]
            [body-label : i64 (ir.compiler-ir-label-none)]
            [tail-header-label : i64 (ir.compiler-ir-label-none)]
            [tail-body-label : i64 (ir.compiler-ir-label-none)]
            [exit-label : i64 (ir.compiler-ir-label-none)]
            [arrays : LowerArrayVarSet
              (lower-array-var-set-add
                (lower-array-var-set-add
                  (lower-array-var-set-empty)
                  input-var
                  0)
                output-var
                0)]
            [vector-limit : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [vector-start-ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [next-index : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [vector-ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [tail-cond : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            (begin
              (match (lower-state-fresh-label
                s
                (lower-spmd-scan-vector-label s "header"))
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label
                s
                (lower-spmd-scan-vector-label s "body"))
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "spmd_scan_tail_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (match (lower-state-fresh-label s "spmd_scan_tail_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "spmd_scan_exit")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (match (lower-vector-loop-limit s end-value arrays lanes)
                [(LowerExpr.Expr next-s limit _)
                  (begin
                    (set! s next-s)
                    (set! vector-limit limit))])
              (match (lower-vector-loop-start-ok s index-var lanes)
                [(LowerExpr.Expr next-s ok _)
                  (begin
                    (set! s next-s)
                    (set! vector-start-ok ok))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (ir.CompilerIrInstr.Branch
                      vector-start-ok
                      header-label
                      tail-header-label))
                  header-label))
              (match (lower-emit-binop
                s
                ir.CompilerIrBinOp.Add
                (ir.CompilerIrValue.Var index-var)
                (ir.CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr.Expr next-s value-ir _)
                  (begin
                    (set! s next-s)
                    (set! next-index value-ir))])
              (match (lower-vector-loop-next-ok s next-index vector-limit)
                [(LowerExpr.Expr next-s ok _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok ok))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (ir.CompilerIrInstr.Branch
                      vector-ok
                      body-label
                      tail-header-label))
                  body-label))
              (match (lower-spmd-scan-vector-body
                ctx
                s
                index-var
                next-index
                acc-var
                input-var
                output-var
                prefix-op
                elem-ty
                lanes)
                [(LowerExpr.Expr body-state _ _)
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        body-state
                        (ir.CompilerIrInstr.Jump header-label))
                      tail-header-label))])
              (match (lower-vector-loop-i64-compare
                s
                ir.CompilerIrBinOp.Lt
                (ir.CompilerIrValue.Var index-var)
                end-value)
                [(LowerExpr.Expr next-s condition _)
                  (begin
                    (set! s next-s)
                    (set! tail-cond condition))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (ir.CompilerIrInstr.Branch
                      tail-cond
                      tail-body-label
                      exit-label))
                  tail-body-label))
              (match (lower-spmd-scan-scalar-tail-body
                ctx
                s
                env
                type-env
                op
                index-id
                index-var
                index-ty
                prefix-id
                acc-var
                elem-ty
                value
                body)
                [(ResultLowerExpr.Ok tail-lowered)
                  (match tail-lowered
                    [(LowerExpr.Expr tail-state _ _)
                      (ResultLowerExpr.Ok
                        (LowerExpr.Expr
                          (lower-state-finish-block
                            (lower-state-emit
                              tail-state
                              (ir.CompilerIrInstr.Jump tail-header-label))
                            exit-label)
                          ir.CompilerIrValue.Unit
                          (ast.AstType.Unit)))])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))])]))

(define (lower-simd-spmd-scan-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-id : i64]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [prefix-id : i64]
  [prefix-ty : ast.AstType]
  [init : ast.AstExpr]
  [value : ast.AstExpr]
  [body : ast.AstExpr]
  [plan : LowerMaybeVectorScan]) : ResultLowerExpr
  (match plan
    [(LowerMaybeVectorScan.Scan input-var output-var prefix-op elem-ty lanes)
      (match (lower-expr-expected ctx state env type-env init prefix-ty init)
        [(ResultLowerExpr.Ok init-lowered)
          (match init-lowered
            [(LowerExpr.Expr init-state init-value _)
              (match (lower-expr ctx init-state env type-env end)
                [(ResultLowerExpr.Ok end-lowered)
                  (match end-lowered
                    [(LowerExpr.Expr end-state end-value _)
                      (match (lower-expr ctx end-state env type-env start)
                        [(ResultLowerExpr.Ok start-lowered)
                          (match start-lowered
                            [(LowerExpr.Expr start-state start-value _)
                              (lower-simd-spmd-scan-build
                                ctx
                                start-state
                                env
                                type-env
                                op
                                index-id
                                index-ty
                                init-value
                                end-value
                                start-value
                                prefix-id
                                value
                                body
                                input-var
                                output-var
                                prefix-op
                                elem-ty
                                lanes)])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(LowerMaybeVectorScan.No)
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: missing vector scan plan")))]))

(define (lower-avx2-spmd-reduce-build
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-ty : ast.AstType]
  [init-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [op : ast.AstReduceOp]
  [array-var : i64]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc acc-alloc acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-alloc
          (ir.CompilerIrInstr.Mov acc-var init-value elem-ty)))
        [(LowerAlloc.Alloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (ir.CompilerIrInstr.Mov index-var start-value index-ty))]
            [header-label : i64 (ir.compiler-ir-label-none)]
            [body-label : i64 (ir.compiler-ir-label-none)]
            [tail-init-label : i64 (ir.compiler-ir-label-none)]
            [tail-header-label : i64 (ir.compiler-ir-label-none)]
            [tail-body-label : i64 (ir.compiler-ir-label-none)]
            [exit-label : i64 (ir.compiler-ir-label-none)]
            [arrays : LowerArrayVarSet
              (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
            [vector-limit : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [vector-start-ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [next-index : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [vector-ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [tail-cond : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [vector-acc-var : i64 0]
            [data-ptr : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            (begin
              (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                (match (lower-state-alloc-var s)
                  [(LowerAlloc.Alloc next-s var)
                    (begin
                      (set! vector-acc-var var)
                      (set!
                        s
                        (lower-state-emit
                          next-s
                          (ir.CompilerIrInstr.Splat
                            vector-acc-var
                            (lower-spmd-reduce-vector-accumulator-init
                              op
                              acc-var)
                            lanes
                            elem-ty))))])
                unit)
              (match (lower-state-fresh-label s "spmd_reduce_avx2_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label s "spmd_reduce_avx2_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "spmd_reduce_tail_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                (match (lower-state-fresh-label s "spmd_reduce_tail_init")
                  [(LowerLabel.Label next-s label)
                    (begin
                      (set! s next-s)
                      (set! tail-init-label label))])
                unit)
              (match (lower-state-fresh-label s "spmd_reduce_tail_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "spmd_reduce_exit")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (match (lower-vector-loop-limit s end-value arrays lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-limit value))])
              (match (lower-vector-loop-start-ok s index-var lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-start-ok value))])
              (match (lower-array-data-pointer-value
                s
                (ir.CompilerIrValue.Var array-var))
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! data-ptr value))])
              (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (ir.CompilerIrInstr.Branch
                        vector-start-ok
                        header-label
                        tail-init-label))
                    header-label))
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (ir.CompilerIrInstr.Branch
                        vector-start-ok
                        header-label
                        tail-header-label))
                    header-label)))
              (match (lower-emit-binop
                s
                (ir.CompilerIrBinOp.Add)
                (ir.CompilerIrValue.Var index-var)
                (ir.CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! next-index value))])
              (match (lower-vector-loop-next-ok s next-index vector-limit)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok value))])
              (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (ir.CompilerIrInstr.Branch
                        vector-ok
                        body-label
                        tail-init-label))
                    body-label))
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (ir.CompilerIrInstr.Branch
                        vector-ok
                        body-label
                        tail-header-label))
                    body-label)))
              (match (lower-avx2-reduce-vector-body
                ctx
                s
                env
                type-env
                op
                index-var
                next-index
                acc-var
                vector-acc-var
                data-ptr
                vector-op
                elem-ty
                lanes)
                [(ResultLowerExpr.Ok body-lowered)
                  (match body-lowered
                    [(LowerExpr.Expr body-state _ _)
                      (begin
                        (set! s body-state)
                        (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                          (set!
                            s
                            (lower-state-finish-block
                              (lower-state-emit
                                s
                                (ir.CompilerIrInstr.Jump header-label))
                              tail-init-label))
                          (set!
                            s
                            (lower-state-finish-block
                              (lower-state-emit
                                s
                                (ir.CompilerIrInstr.Jump header-label))
                              tail-header-label)))
                        (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                          (begin
                            (set!
                              s
                              (lower-spmd-reduce-finish-vector-accumulator
                                s
                                op
                                acc-var
                                vector-acc-var
                                vector-op
                                lanes
                                elem-ty))
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (ir.CompilerIrInstr.Jump tail-header-label))
                                tail-header-label)))
                          unit)
                        (match (lower-vector-loop-i64-compare
                          s
                          (ir.CompilerIrBinOp.Lt)
                          (ir.CompilerIrValue.Var index-var)
                          end-value)
                          [(LowerExpr.Expr next-s value _)
                            (begin
                              (set! s next-s)
                              (set! tail-cond value))])
                        (set!
                          s
                          (lower-state-finish-block
                            (lower-state-emit
                              s
                              (ir.CompilerIrInstr.Branch
                                tail-cond
                                tail-body-label
                                exit-label))
                            tail-body-label))
                        (match (lower-spmd-reduce-scalar-tail-body
                          ctx
                          s
                          env
                          type-env
                          op
                          index-var
                          index-ty
                          acc-var
                          array-var
                          elem-ty)
                          [(ResultLowerExpr.Ok tail-lowered)
                            (match tail-lowered
                              [(LowerExpr.Expr tail-state _ _)
                                (ResultLowerExpr.Ok
                                  (LowerExpr.Expr
                                    (lower-state-finish-block
                                      (lower-state-emit
                                        tail-state
                                        (ir.CompilerIrInstr.Jump
                                          tail-header-label))
                                      exit-label)
                                    (ir.CompilerIrValue.Var acc-var)
                                    elem-ty))])]
                          [(ResultLowerExpr.Err message)
                            (ResultLowerExpr.Err message)]))])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))])]))

(define (lower-avx2-spmd-reduce-value-build
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-ty : ast.AstType]
  [init-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [op : ast.AstReduceOp]
  [value-plan : LowerVectorMapValue]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc acc-alloc acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-alloc
          (ir.CompilerIrInstr.Mov acc-var init-value elem-ty)))
        [(LowerAlloc.Alloc index-alloc index-var)
          (match (lower-state-alloc-var
            (lower-state-emit
              index-alloc
              (ir.CompilerIrInstr.Mov index-var start-value index-ty)))
            [(LowerAlloc.Alloc base-alloc tail-base-var)
              (let
                [s : LowerState base-alloc]
                [header-label : i64 (ir.compiler-ir-label-none)]
                [body-label : i64 (ir.compiler-ir-label-none)]
                [tail-init-label : i64 (ir.compiler-ir-label-none)]
                [tail-check-label : i64 (ir.compiler-ir-label-none)]
                [tail-body-label : i64 (ir.compiler-ir-label-none)]
                [exit-label : i64 (ir.compiler-ir-label-none)]
                [arrays : LowerArrayVarSet
                  (lower-vector-map-value-array-vars value-plan)]
                [vector-limit : ir.CompilerIrValue ir.CompilerIrValue.Unit]
                [vector-start-ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
                [next-index : ir.CompilerIrValue ir.CompilerIrValue.Unit]
                [vector-ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
                [active-lanes : ir.CompilerIrValue ir.CompilerIrValue.Unit]
                [tail-cond : ir.CompilerIrValue ir.CompilerIrValue.Unit]
                [vector-acc-var : i64 0]
                [preheader-cache : LowerVectorMapValueCache
                  (lower-vector-map-value-cache-empty)]
                (begin
                  (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                    (match (lower-state-alloc-var s)
                      [(LowerAlloc.Alloc next-s var)
                        (begin
                          (set! vector-acc-var var)
                          (set!
                            s
                            (lower-state-emit
                              next-s
                              (ir.CompilerIrInstr.Splat
                                vector-acc-var
                                (lower-spmd-reduce-vector-accumulator-init
                                  op
                                  acc-var)
                                lanes
                                elem-ty))))])
                    unit)
                  (match (lower-state-fresh-label s "spmd_reduce_value_header")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! header-label label))])
                  (match (lower-state-fresh-label s "spmd_reduce_value_body")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! body-label label))])
                  (match (lower-state-fresh-label
                    s
                    "spmd_reduce_value_tail_init")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! tail-init-label label))])
                  (match (lower-state-fresh-label
                    s
                    "spmd_reduce_value_tail_check")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! tail-check-label label))])
                  (match (lower-state-fresh-label
                    s
                    "spmd_reduce_value_tail_body")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! tail-body-label label))])
                  (match (lower-state-fresh-label s "spmd_reduce_value_exit")
                    [(LowerLabel.Label next-s label)
                      (begin
                        (set! s next-s)
                        (set! exit-label label))])
                  (match (lower-vector-loop-limit s end-value arrays lanes)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! vector-limit value))])
                  (match (lower-vector-loop-start-ok s index-var lanes)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! vector-start-ok value))])
                  (match (lower-vector-map-preheader-cache-plan
                    s
                    arrays
                    lanes
                    elem-ty
                    value-plan)
                    [(LowerVectorMapCachedEmit.Emit next-s _ next-cache)
                      (begin
                        (set! s next-s)
                        (set! preheader-cache next-cache))])
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        s
                        (ir.CompilerIrInstr.Branch
                          vector-start-ok
                          header-label
                          tail-init-label))
                      header-label))
                  (match (lower-emit-binop
                    s
                    (ir.CompilerIrBinOp.Add)
                    (ir.CompilerIrValue.Var index-var)
                    (ir.CompilerIrValue.I64 lanes)
                    index-ty)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! next-index value))])
                  (match (lower-vector-loop-next-ok s next-index vector-limit)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! vector-ok value))])
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        s
                        (ir.CompilerIrInstr.Branch
                          vector-ok
                          body-label
                          tail-init-label))
                      body-label))
                  (match (lower-avx2-reduce-vector-value-body
                    ctx
                    s
                    env
                    type-env
                    op
                    index-var
                    next-index
                    acc-var
                    vector-acc-var
                    value-plan
                    preheader-cache
                    vector-op
                    elem-ty
                    lanes)
                    [(ResultLowerExpr.Ok body-lowered)
                      (match body-lowered
                        [(LowerExpr.Expr body-state _ _)
                          (begin
                            (set! s body-state)
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (ir.CompilerIrInstr.Jump header-label))
                                tail-init-label))
                            (if (lower-spmd-reduce-vector-accumulator? elem-ty)
                              (set!
                                s
                                (lower-spmd-reduce-finish-vector-accumulator
                                  s
                                  op
                                  acc-var
                                  vector-acc-var
                                  vector-op
                                  lanes
                                  elem-ty))
                              unit)
                            (set!
                              s
                              (lower-state-emit
                                s
                                (ir.CompilerIrInstr.Mov
                                  tail-base-var
                                  (ir.CompilerIrValue.Var index-var)
                                  index-ty)))
                            (match (lower-emit-binop
                              s
                              ir.CompilerIrBinOp.Sub
                              end-value
                              (ir.CompilerIrValue.Var index-var)
                              (ast.AstType.I64))
                              [(LowerExpr.Expr next-s value _)
                                (begin
                                  (set! s next-s)
                                  (set! active-lanes value))])
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (ir.CompilerIrInstr.Jump tail-check-label))
                                tail-check-label))
                            (match (lower-vector-loop-i64-compare
                              s
                              (ir.CompilerIrBinOp.Lt)
                              (ir.CompilerIrValue.Var index-var)
                              end-value)
                              [(LowerExpr.Expr next-s value _)
                                (begin
                                  (set! s next-s)
                                  (set! tail-cond value))])
                            (set!
                              s
                              (lower-state-finish-block
                                (lower-state-emit
                                  s
                                  (ir.CompilerIrInstr.Branch
                                    tail-cond
                                    tail-body-label
                                    exit-label))
                                tail-body-label))
                            (match (lower-spmd-reduce-scalar-tail-value-body
                              ctx
                              s
                              env
                              type-env
                              op
                              tail-base-var
                              index-var
                              active-lanes
                              index-ty
                              acc-var
                              value-plan
                              elem-ty
                              lanes)
                              [(ResultLowerExpr.Ok tail-lowered)
                                (match tail-lowered
                                  [(LowerExpr.Expr tail-state _ _)
                                    (ResultLowerExpr.Ok
                                      (LowerExpr.Expr
                                        (lower-state-finish-block
                                          (lower-state-emit
                                            tail-state
                                            (ir.CompilerIrInstr.Jump
                                              tail-check-label))
                                          exit-label)
                                        (ir.CompilerIrValue.Var acc-var)
                                        elem-ty))])]
                              [(ResultLowerExpr.Err message)
                                (ResultLowerExpr.Err message)]))])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])))])])]))

(define (lower-avx2-spmd-reduce-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [init : ast.AstExpr]
  [op : ast.AstReduceOp]
  [plan : LowerMaybeVectorReduce]) : ResultLowerExpr
  (match plan
    [(LowerMaybeVectorReduce.Array array-var vector-op elem-ty lanes)
      (match (lower-expr-expected ctx state env type-env init elem-ty init)
        [(ResultLowerExpr.Ok init-lowered)
          (match init-lowered
            [(LowerExpr.Expr init-state init-value _)
              (match (lower-expr ctx init-state env type-env end)
                [(ResultLowerExpr.Ok end-lowered)
                  (match end-lowered
                    [(LowerExpr.Expr end-state end-value _)
                      (match (lower-expr ctx end-state env type-env start)
                        [(ResultLowerExpr.Ok start-lowered)
                          (match start-lowered
                            [(LowerExpr.Expr start-state start-value _)
                              (lower-avx2-spmd-reduce-build
                                ctx
                                start-state
                                env
                                type-env
                                index-ty
                                init-value
                                end-value
                                start-value
                                op
                                array-var
                                vector-op
                                elem-ty
                                lanes)])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(LowerMaybeVectorReduce.Value value-plan vector-op elem-ty lanes)
      (match (lower-expr-expected ctx state env type-env init elem-ty init)
        [(ResultLowerExpr.Ok init-lowered)
          (match init-lowered
            [(LowerExpr.Expr init-state init-value _)
              (match (lower-expr ctx init-state env type-env end)
                [(ResultLowerExpr.Ok end-lowered)
                  (match end-lowered
                    [(LowerExpr.Expr end-state end-value _)
                      (match (lower-expr ctx end-state env type-env start)
                        [(ResultLowerExpr.Ok start-lowered)
                          (match start-lowered
                            [(LowerExpr.Expr start-state start-value _)
                              (lower-avx2-spmd-reduce-value-build
                                ctx
                                start-state
                                env
                                type-env
                                index-ty
                                init-value
                                end-value
                                start-value
                                op
                                value-plan
                                vector-op
                                elem-ty
                                lanes)])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(LowerMaybeVectorReduce.No)
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: missing vector reduce plan")))]))

(define (lower-emit-tail-mask
  [state : LowerState]
  [index : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.CompilerIrInstr.TailMask v index end-value lanes))
        (ir.CompilerIrValue.Var v)
        (ast.AstType.Bool))]))

(define (lower-emit-predicated-load
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr.Expr data-state data-ptr _)
      (lower-emit-predicated-load-data
        data-state
        data-ptr
        index
        mask
        lanes
        elem-ty)]))

(define (lower-emit-predicated-load-data
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc s v)
      (LowerExpr.Expr
        (lower-state-emit
          s
          (ir.ir-instr-predicated-load v data-ptr index mask lanes elem-ty))
        (ir.CompilerIrValue.Var v)
        elem-ty)]))

(define (lower-emit-predicated-store
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (match (lower-array-data-pointer-value state base)
    [(LowerExpr.Expr data-state data-ptr _)
      (lower-emit-predicated-store-data
        data-state
        data-ptr
        index
        value
        mask
        lanes
        elem-ty)]))

(define (lower-emit-predicated-store-data
  [state : LowerState (:consume)]
  [data-ptr : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (lower-state-emit
    state
    (ir.ir-instr-predicated-store data-ptr index value mask lanes elem-ty)))

(define (lower-emit-spmd-broadcast-lane-check
  [state : LowerState]
  [lane : ir.CompilerIrValue]
  [active-lanes : ir.CompilerIrValue]) : LowerState
  (match (lower-emit-bounds-operand state lane (ast.AstType.I64))
    [(LowerExpr.Expr lane-state lane-u _)
      (match (lower-emit-bounds-operand
        lane-state
        active-lanes
        (ast.AstType.I64))
        [(LowerExpr.Expr count-state count-u _)
          (lower-emit-bounds-check count-state lane-u count-u)])]))

(define (lower-emit-spmd-broadcast-array
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [array-var : i64]
  [lane : ir.CompilerIrValue]
  [active-lanes : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-binop
    (lower-emit-spmd-broadcast-lane-check state lane active-lanes)
    ir.CompilerIrBinOp.Add
    (ir.CompilerIrValue.Var index-var)
    lane
    (ast.AstType.I64))
    [(LowerExpr.Expr index-state source-index _)
      (match (lower-array-element-addr
        ctx
        index-state
        (ir.CompilerIrValue.Var array-var)
        source-index
        (ast.AstType.I64)
        elem-ty)
        [(LowerExpr.Expr addr-state source-addr _)
          (match (lower-emit-load addr-state source-addr elem-ty)
            [(LowerExpr.Expr load-state source-value _)
              (lower-emit-splat load-state source-value lanes elem-ty)])])]))

(define (lower-vector-map-ir-value-eq?
  [left : ir.CompilerIrValue]
  [right : ir.CompilerIrValue]) : bool
  ;; Vector-map uniform values are restricted by the planner to local numeric
  ;; variables and numeric scalar literals. Broadcast lane operands use the
  ;; same subset. Keep this comparator aligned with that invariant instead of
  ;; paying for unrelated pointer, function, string, and unit IR variants.
  (match left
    [(ir.CompilerIrValue.Var a)
      (match right
        [(ir.CompilerIrValue.Var b) (= a b)]
        [_ false])]
    [(ir.CompilerIrValue.I64 a)
      (match right
        [(ir.CompilerIrValue.I64 b) (= a b)]
        [_ false])]
    [(ir.CompilerIrValue.F64 a)
      (match right
        [(ir.CompilerIrValue.F64 b) (= a b)]
        [_ false])]
    [_ false]))

(define (lower-vector-map-binop-eq?
  [left : ir.CompilerIrBinOp]
  [right : ir.CompilerIrBinOp]) : bool
  (match left
    [(ir.CompilerIrBinOp.Add)
      (match right
        [(ir.CompilerIrBinOp.Add) true]
        [_ false])]
    [(ir.CompilerIrBinOp.Sub)
      (match right
        [(ir.CompilerIrBinOp.Sub) true]
        [_ false])]
    [(ir.CompilerIrBinOp.Mul)
      (match right
        [(ir.CompilerIrBinOp.Mul) true]
        [_ false])]
    [(ir.CompilerIrBinOp.BitAnd)
      (match right
        [(ir.CompilerIrBinOp.BitAnd) true]
        [_ false])]
    [(ir.CompilerIrBinOp.BitOr)
      (match right
        [(ir.CompilerIrBinOp.BitOr) true]
        [_ false])]
    [(ir.CompilerIrBinOp.BitXor)
      (match right
        [(ir.CompilerIrBinOp.BitXor) true]
        [_ false])]
    [(ir.CompilerIrBinOp.Shl left-count-ty)
      (match right
        [(ir.CompilerIrBinOp.Shl right-count-ty)
          (tc_core.tc-type-eq left-count-ty right-count-ty)]
        [_ false])]
    [(ir.CompilerIrBinOp.Shr left-count-ty)
      (match right
        [(ir.CompilerIrBinOp.Shr right-count-ty)
          (tc_core.tc-type-eq left-count-ty right-count-ty)]
        [_ false])]
    [_ false]))

(define (lower-vector-map-value-key-eq?
  [left : LowerVectorMapValueKey]
  [right : LowerVectorMapValueKey]) : bool
  (match left
    [(LowerVectorMapValueKey.Array left-array)
      (match right
        [(LowerVectorMapValueKey.Array right-array) (= left-array right-array)]
        [_ false])]
    [(LowerVectorMapValueKey.ArrayData left-array)
      (match right
        [(LowerVectorMapValueKey.ArrayData right-array)
          (= left-array right-array)]
        [_ false])]
    [(LowerVectorMapValueKey.Gather left-source left-indexes)
      (match right
        [(LowerVectorMapValueKey.Gather right-source right-indexes)
          (and (= left-source right-source) (= left-indexes right-indexes))]
        [_ false])]
    [(LowerVectorMapValueKey.GatherLaneOffset left-source left-offsets)
      (match right
        [(LowerVectorMapValueKey.GatherLaneOffset right-source right-offsets)
          (and (= left-source right-source) (= left-offsets right-offsets))]
        [_ false])]
    [(LowerVectorMapValueKey.LaneArray left-array)
      (match right
        [(LowerVectorMapValueKey.LaneArray right-array)
          (= left-array right-array)]
        [_ false])]
    [(LowerVectorMapValueKey.Uniform left-value)
      (match right
        [(LowerVectorMapValueKey.Uniform right-value)
          (lower-vector-map-ir-value-eq? left-value right-value)]
        [_ false])]
    [(LowerVectorMapValueKey.BroadcastArray left-array left-lane)
      (match right
        [(LowerVectorMapValueKey.BroadcastArray right-array right-lane)
          (and
            (= left-array right-array)
            (lower-vector-map-ir-value-eq? left-lane right-lane))]
        [_ false])]
    [(LowerVectorMapValueKey.LaneIndex)
      (match right
        [(LowerVectorMapValueKey.LaneIndex) true]
        [_ false])]
    [(LowerVectorMapValueKey.LaneCount)
      (match right
        [(LowerVectorMapValueKey.LaneCount) true]
        [_ false])]
    [(LowerVectorMapValueKey.BinOp left-op left-lhs left-rhs)
      (match right
        [(LowerVectorMapValueKey.BinOp right-op right-lhs right-rhs)
          (and
            (lower-vector-map-binop-eq? left-op right-op)
            (lower-vector-map-ir-value-eq? left-lhs right-lhs)
            (lower-vector-map-ir-value-eq? left-rhs right-rhs))]
        [_ false])]))

(define (lower-vector-map-value-cache-empty) : LowerVectorMapValueCache
  (LowerVectorMapValueCache
    (make-array LowerVectorMapValueKey 0)
    (make-array ir.CompilerIrValue 0)
    0))

(define (lower-vector-map-value-cache-lookup
  [cache : LowerVectorMapValueCache]
  [key : LowerVectorMapValueKey]) : LowerMaybeIrValue
  (let
    [index : i64 0]
    [found : LowerMaybeIrValue (LowerMaybeIrValue.No)]
    (begin
      (while (and
        (< index (struct-get cache count))
        (match found
          [(LowerMaybeIrValue.No) true]
          [(LowerMaybeIrValue.Some _) false]))
        (if (lower-vector-map-value-key-eq?
          key
          (array-ref (struct-get cache keys) index))
          (set!
            found
            (LowerMaybeIrValue.Some (array-ref (struct-get cache values) index)))
          (set! index (+ index 1))))
      found)))

(define (lower-vector-map-value-cache-add
  [cache : LowerVectorMapValueCache]
  [key : LowerVectorMapValueKey]
  [value : ir.CompilerIrValue]) : LowerVectorMapValueCache
  (let
    [keys : (__tl_dyn-array LowerVectorMapValueKey) (struct-get cache keys)]
    [values : (__tl_dyn-array ir.CompilerIrValue) (struct-get cache values)]
    [count : i64 (struct-get cache count)]
    (begin
      (array-push! keys key)
      (array-push! values value)
      (LowerVectorMapValueCache keys values (+ count 1)))))

;; Populate the vector-map cache in the entry block with values whose source
;; operands cannot change between gangs. The simple-map planner accepts only
;; literals and already-bound scalar vars for `Uniform`; safe SPMD rejects
;; mutation of bindings declared outside the body, so these materializations
;; dominate both the full vector loop and its masked AVX-512 tail.
(define (lower-vector-map-preheader-cache-leaves
  [state : LowerState]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (match plan
    [(LowerVectorMapValue.Uniform value)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.Uniform value))
        [(LowerMaybeIrValue.Some cached)
          (LowerVectorMapCachedEmit.Emit state cached cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-splat state value lanes elem-ty)
            (LowerVectorMapValueKey.Uniform value)
            cache)])]
    [(LowerVectorMapValue.LaneIndex)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.LaneIndex))
        [(LowerMaybeIrValue.Some cached)
          (LowerVectorMapCachedEmit.Emit state cached cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-lane-id state lanes elem-ty)
            (LowerVectorMapValueKey.LaneIndex)
            cache)])]
    [(LowerVectorMapValue.LaneCount)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.LaneCount))
        [(LowerMaybeIrValue.Some cached)
          (LowerVectorMapCachedEmit.Emit state cached cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-splat
              state
              (ir.CompilerIrValue.I64 lanes)
              lanes
              elem-ty)
            (LowerVectorMapValueKey.LaneCount)
            cache)])]
    ;; Shuffle selectors may span two i64 vectors when the element lane count
    ;; exceeds the selector lane count. Its emitter owns that split, so a
    ;; generic leaf cache would materialize an unused, incorrectly shaped ID.
    [(LowerVectorMapValue.Shuffle _ _)
      (LowerVectorMapCachedEmit.Emit state ir.CompilerIrValue.Unit cache)]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (match (lower-vector-map-preheader-cache-leaves
        state
        lanes
        elem-ty
        (box-get lhs)
        cache)
        [(LowerVectorMapCachedEmit.Emit lhs-state _ lhs-cache)
          (lower-vector-map-preheader-cache-leaves
            lhs-state
            lanes
            elem-ty
            (box-get rhs)
            lhs-cache)])]
    [_ (LowerVectorMapCachedEmit.Emit state ir.CompilerIrValue.Unit cache)]))

(define (lower-vector-map-preheader-cache-array-data
  [state : LowerState]
  [arrays : LowerArrayVarSet]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (let
    [s : LowerState state]
    [next-cache : LowerVectorMapValueCache cache]
    [index : i64 0]
    (begin
      (while (< index (struct-get arrays count))
        (let
          [array-var : i64 (array-ref (struct-get arrays vars) index)]
          (begin
            (match (lower-array-data-pointer-value
              s
              (ir.CompilerIrValue.Var array-var))
              [(LowerExpr.Expr next-s data-ptr _)
                (begin
                  (set! s next-s)
                  (set!
                    next-cache
                    (lower-vector-map-value-cache-add
                      next-cache
                      (LowerVectorMapValueKey.ArrayData array-var)
                      data-ptr)))])
            (set! index (+ index 1)))))
      (LowerVectorMapCachedEmit.Emit s ir.CompilerIrValue.Unit next-cache))))

(define (lower-vector-map-preheader-cache-plan
  [state : LowerState]
  [arrays : LowerArrayVarSet]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]) : LowerVectorMapCachedEmit
  (match (lower-vector-map-preheader-cache-array-data
    state
    arrays
    (lower-vector-map-value-cache-empty))
    [(LowerVectorMapCachedEmit.Emit data-state _ data-cache)
      (lower-vector-map-preheader-cache-leaves
        data-state
        lanes
        elem-ty
        plan
        data-cache)]))

(define (lower-vector-map-preheader-cache-stores
  [state : LowerState]
  [arrays : LowerArrayVarSet]
  [stores : LowerVectorMapStoreList]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerVectorMapCachedEmit
  (match (lower-vector-map-preheader-cache-array-data
    state
    arrays
    (lower-vector-map-value-cache-empty))
    [(LowerVectorMapCachedEmit.Emit data-state _ data-cache)
      (let
        [s : LowerState data-state]
        [cache : LowerVectorMapValueCache data-cache]
        [index : i64 0]
        (begin
          (while (< index (struct-get stores count))
            (match (lower-vector-map-store-list-ref stores index)
              [(LowerVectorMapStore _ value-plan)
                (match (lower-vector-map-preheader-cache-leaves
                  s
                  lanes
                  elem-ty
                  value-plan
                  cache)
                  [(LowerVectorMapCachedEmit.Emit next-s _ next-cache)
                    (begin
                      (set! s next-s)
                      (set! cache next-cache))])])
            (set! index (+ index 1)))
          (LowerVectorMapCachedEmit.Emit s ir.CompilerIrValue.Unit cache)))]))

(define (lower-emit-shuffle-selector-plan
  [state : LowerState]
  [index : ir.CompilerIrValue]
  [lane-offset : i64]
  [gang-count : ir.CompilerIrValue]
  [lanes : i64]
  [plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (match emit-mode
        [(LowerVectorMapEmitMode.Full)
          (lower-emit-vector-load
            state
            (ir.CompilerIrValue.Var array-var)
            index
            lanes
            (ast.AstType.I64))]
        [(LowerVectorMapEmitMode.Predicated _ mask)
          (lower-emit-predicated-load
            state
            (ir.CompilerIrValue.Var array-var)
            index
            mask
            lanes
            (ast.AstType.I64))])]
    [(LowerVectorMapValue.Uniform value)
      (lower-emit-splat state value lanes (ast.AstType.I64))]
    [(LowerVectorMapValue.LaneIndex)
      (match (lower-emit-lane-id state lanes (ast.AstType.I64))
        [(LowerExpr.Expr lane-state lane-value _)
          (if (= lane-offset 0)
            (LowerExpr.Expr lane-state lane-value (ast.AstType.I64))
            (match (lower-emit-splat
              lane-state
              (ir.CompilerIrValue.I64 lane-offset)
              lanes
              (ast.AstType.I64))
              [(LowerExpr.Expr offset-state offset-value _)
                (lower-emit-vector-binop
                  offset-state
                  ir.CompilerIrBinOp.Add
                  lane-value
                  offset-value
                  lanes
                  (ast.AstType.I64))]))])]
    [(LowerVectorMapValue.LaneCount)
      (lower-emit-splat
        state
        (ir.CompilerIrValue.I64 lanes)
        lanes
        (ast.AstType.I64))]
    [(LowerVectorMapValue.BinOp op lhs rhs)
      (match (lower-emit-shuffle-selector-plan
        state
        index
        lane-offset
        gang-count
        lanes
        (box-get lhs)
        emit-mode)
        [(LowerExpr.Expr lhs-state lhs-value _)
          (match (lower-emit-shuffle-selector-plan
            lhs-state
            index
            lane-offset
            gang-count
            lanes
            (box-get rhs)
            emit-mode)
            [(LowerExpr.Expr rhs-state rhs-value _)
              (match (lower-emit-vector-map-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                (ast.AstType.I64)
                emit-mode)
                [(LowerExpr.Expr binop-state binop-value _)
                  (match emit-mode
                    [(LowerVectorMapEmitMode.Full)
                      (LowerExpr.Expr binop-state binop-value (ast.AstType.I64))]
                    [(LowerVectorMapEmitMode.Predicated _ mask)
                      ;; The backend validates a selector vector in one step.
                      ;; Keep inactive destination lanes at zero so their
                      ;; unevaluated selector expressions cannot contribute a
                      ;; false out-of-range bit to that reduction.
                      (match (lower-emit-splat
                        binop-state
                        (ir.CompilerIrValue.I64 0)
                        lanes
                        (ast.AstType.I64))
                        [(LowerExpr.Expr zero-state zero-value _)
                          (lower-emit-select
                            zero-state
                            mask
                            binop-value
                            zero-value
                            lanes
                            (ast.AstType.I64))])])])])])]
    ;; The planner rejects these forms before constructing Shuffle.
    [_ (LowerExpr.Expr state ir.CompilerIrValue.Unit (ast.AstType.I64))]))

(define (lower-emit-dynamic-vector-shuffle
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [source-plan : LowerVectorMapValue]
  [selector-plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (let
    [selector-lanes : i64
      (lower-simd-lanes-for-elem (lower-state-mode state) (ast.AstType.I64))]
    [index-value : ir.CompilerIrValue (ir.CompilerIrValue.Var index-var)]
    (match emit-mode
      [(LowerVectorMapEmitMode.Full)
        (match (lower-emit-vector-map-value
          ctx
          state
          index-var
          lanes
          elem-ty
          source-plan)
          [(LowerExpr.Expr source-state source-value _)
            (match (lower-emit-shuffle-selector-plan
              source-state
              index-value
              0
              (ir.CompilerIrValue.I64 lanes)
              selector-lanes
              selector-plan
              (LowerVectorMapEmitMode.Full))
              [(LowerExpr.Expr low-state selector-low _)
                (if (> lanes selector-lanes)
                  (match (lower-emit-binop
                    low-state
                    ir.CompilerIrBinOp.Add
                    index-value
                    (ir.CompilerIrValue.I64 selector-lanes)
                    (ast.AstType.I64))
                    [(LowerExpr.Expr high-index-state high-index _)
                      (match (lower-emit-shuffle-selector-plan
                        high-index-state
                        high-index
                        selector-lanes
                        (ir.CompilerIrValue.I64 lanes)
                        selector-lanes
                        selector-plan
                        (LowerVectorMapEmitMode.Full))
                        [(LowerExpr.Expr high-state selector-high _)
                          (lower-emit-vector-shuffle-instr
                            high-state
                            source-value
                            selector-low
                            (ir.CompilerIrMaybeValue.Some selector-high)
                            (ir.CompilerIrValue.I64 lanes)
                            lanes
                            elem-ty)])])
                  (lower-emit-vector-shuffle-instr
                    low-state
                    source-value
                    selector-low
                    (ir.CompilerIrMaybeValue.No)
                    (ir.CompilerIrValue.I64 lanes)
                    lanes
                    elem-ty))])])]
      [(LowerVectorMapEmitMode.Predicated end-value source-mask)
        (match (lower-emit-binop
          state
          ir.CompilerIrBinOp.Sub
          end-value
          index-value
          (ast.AstType.I64))
          [(LowerExpr.Expr count-state active-lanes _)
            (match (lower-emit-predicated-vector-map-value
              ctx
              count-state
              index-var
              end-value
              source-mask
              lanes
              elem-ty
              source-plan)
              [(LowerExpr.Expr source-state source-value _)
                (match (lower-emit-tail-mask
                  source-state
                  index-value
                  end-value
                  selector-lanes)
                  [(LowerExpr.Expr low-mask-state low-mask _)
                    (match (lower-emit-shuffle-selector-plan
                      low-mask-state
                      index-value
                      0
                      active-lanes
                      selector-lanes
                      selector-plan
                      (LowerVectorMapEmitMode.Predicated end-value low-mask))
                      [(LowerExpr.Expr low-state selector-low _)
                        (if (> lanes selector-lanes)
                          (match (lower-emit-binop
                            low-state
                            ir.CompilerIrBinOp.Add
                            index-value
                            (ir.CompilerIrValue.I64 selector-lanes)
                            (ast.AstType.I64))
                            [(LowerExpr.Expr high-index-state high-index _)
                              (match high-index
                                [(ir.CompilerIrValue.Var high-index-var)
                                  (match (lower-emit-tail-mask
                                    high-index-state
                                    high-index
                                    end-value
                                    selector-lanes)
                                    [(LowerExpr.Expr
                                        high-mask-state
                                        high-mask
                                        _)
                                      (match (lower-emit-shuffle-selector-plan
                                        high-mask-state
                                        high-index
                                        selector-lanes
                                        active-lanes
                                        selector-lanes
                                        selector-plan
                                        (LowerVectorMapEmitMode.Predicated
                                          end-value
                                          high-mask))
                                        [(LowerExpr.Expr
                                            high-state
                                            selector-high
                                            _)
                                          (lower-emit-vector-shuffle-instr
                                            high-state
                                            source-value
                                            selector-low
                                            (ir.CompilerIrMaybeValue.Some
                                              selector-high)
                                            active-lanes
                                            lanes
                                            elem-ty)])])]
                                [_
                                  (LowerExpr.Expr
                                    high-index-state
                                    ir.CompilerIrValue.Unit
                                    elem-ty)])])
                          (lower-emit-vector-shuffle-instr
                            low-state
                            source-value
                            selector-low
                            (ir.CompilerIrMaybeValue.No)
                            active-lanes
                            lanes
                            elem-ty))])])])])])))

(define (lower-emit-vector-shuffle
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [source-plan : LowerVectorMapValue]
  [selector-plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match selector-plan
    ;; Each active destination lane selects itself. Keep the Shuffle marker in
    ;; the plan so the SIMD planner knows this expression was handled, but emit
    ;; the source directly for both full and partial gangs.
    [(LowerVectorMapValue.LaneIndex)
      (match emit-mode
        [(LowerVectorMapEmitMode.Full)
          (lower-emit-vector-map-value
            ctx
            state
            index-var
            lanes
            elem-ty
            source-plan)]
        [(LowerVectorMapEmitMode.Predicated end-value mask)
          (lower-emit-predicated-vector-map-value
            ctx
            state
            index-var
            end-value
            mask
            lanes
            elem-ty
            source-plan)])]
    [_
      (lower-emit-dynamic-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        source-plan
        selector-plan
        emit-mode)]))

(define (lower-emit-vector-map-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (lower-emit-vector-load
        state
        (ir.CompilerIrValue.Var array-var)
        (ir.CompilerIrValue.Var index-var)
        lanes
        elem-ty)]
    [(LowerVectorMapValue.Gather source-var indexes-var)
      (match (lower-array-len-value state (ir.CompilerIrValue.Var source-var))
        [(LowerExpr.Expr len-state source-len _)
          (match (lower-array-data-pointer-value
            len-state
            (ir.CompilerIrValue.Var source-var))
            [(LowerExpr.Expr source-state source-data _)
              (match (lower-array-data-pointer-value
                source-state
                (ir.CompilerIrValue.Var indexes-var))
                [(LowerExpr.Expr indexes-state indexes-data _)
                  (match (lower-emit-gather-lane-checks
                    ctx
                    indexes-state
                    indexes-data
                    index-var
                    0
                    lanes
                    source-len)
                    [(LowerExpr.Expr checked-state _ _)
                      (lower-emit-gather-load
                        checked-state
                        source-data
                        indexes-data
                        (ir.CompilerIrValue.Var index-var)
                        false
                        lanes
                        elem-ty)])])])])]
    [(LowerVectorMapValue.GatherLaneOffset source-var offsets-var)
      (match (lower-array-len-value state (ir.CompilerIrValue.Var source-var))
        [(LowerExpr.Expr len-state source-len _)
          (match (lower-array-data-pointer-value
            len-state
            (ir.CompilerIrValue.Var source-var))
            [(LowerExpr.Expr source-state source-data _)
              (match (lower-array-len-value
                source-state
                (ir.CompilerIrValue.Var offsets-var))
                [(LowerExpr.Expr offsets-len-state offsets-len _)
                  (match (lower-array-data-pointer-value
                    (lower-emit-bounds-check
                      offsets-len-state
                      (ir.CompilerIrValue.I64 (- lanes 1))
                      offsets-len)
                    (ir.CompilerIrValue.Var offsets-var))
                    [(LowerExpr.Expr offsets-state offsets-data _)
                      (match (lower-emit-gather-lane-offset-checks
                        offsets-state
                        offsets-data
                        index-var
                        0
                        lanes
                        source-len)
                        [(LowerExpr.Expr checked-state _ _)
                          (lower-emit-gather-load
                            checked-state
                            source-data
                            offsets-data
                            (ir.CompilerIrValue.Var index-var)
                            true
                            lanes
                            elem-ty)])])])])])]
    [(LowerVectorMapValue.LaneArray array-var)
      (match (lower-array-len-value state (ir.CompilerIrValue.Var array-var))
        [(LowerExpr.Expr len-state array-len _)
          (lower-emit-vector-load
            (lower-emit-bounds-check
              len-state
              (ir.CompilerIrValue.I64 (- lanes 1))
              array-len)
            (ir.CompilerIrValue.Var array-var)
            (ir.CompilerIrValue.I64 0)
            lanes
            elem-ty)])]
    [(LowerVectorMapValue.Uniform value)
      (lower-emit-splat state value lanes elem-ty)]
    [(LowerVectorMapValue.BroadcastArray array-var lane)
      (lower-emit-spmd-broadcast-array
        ctx
        state
        index-var
        array-var
        lane
        (ir.CompilerIrValue.I64 lanes)
        lanes
        elem-ty)]
    [(LowerVectorMapValue.LaneIndex) (lower-emit-lane-id state lanes elem-ty)]
    [(LowerVectorMapValue.LaneCount)
      (lower-emit-splat state (ir.CompilerIrValue.I64 lanes) lanes elem-ty)]
    [(LowerVectorMapValue.Shuffle source selector)
      (lower-emit-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get source)
        (box-get selector)
        (LowerVectorMapEmitMode.Full))]
    [(LowerVectorMapValue.BinOp op lhs rhs)
      (match (lower-emit-vector-map-value
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get lhs))
        [(LowerExpr.Expr lhs-state lhs-value _)
          (match (lower-emit-vector-map-value
            ctx
            lhs-state
            index-var
            lanes
            elem-ty
            (box-get rhs))
            [(LowerExpr.Expr rhs-state rhs-value _)
              (lower-emit-vector-map-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                elem-ty
                (LowerVectorMapEmitMode.Full))])])]))

(define (lower-vector-map-cache-emitted
  [emitted : LowerExpr]
  [key : LowerVectorMapValueKey]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (match emitted
    [(LowerExpr.Expr state value _)
      (LowerVectorMapCachedEmit.Emit
        state
        value
        (lower-vector-map-value-cache-add cache key value))]))

(define (lower-emit-vector-map-value-for-mode
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match emit-mode
    [(LowerVectorMapEmitMode.Full)
      (lower-emit-vector-map-value ctx state index-var lanes elem-ty plan)]
    [(LowerVectorMapEmitMode.Predicated end-value mask)
      (lower-emit-predicated-vector-map-value
        ctx
        state
        index-var
        end-value
        mask
        lanes
        elem-ty
        plan)]))

(define (lower-emit-vector-array-data-for-mode
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match emit-mode
    [(LowerVectorMapEmitMode.Full)
      (lower-emit-vector-load-data
        state
        data-ptr
        (ir.CompilerIrValue.Var index-var)
        lanes
        elem-ty)]
    [(LowerVectorMapEmitMode.Predicated _ mask)
      (lower-emit-predicated-load-data
        state
        data-ptr
        (ir.CompilerIrValue.Var index-var)
        mask
        lanes
        elem-ty)]))

(define (lower-emit-vector-map-value-cached
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.Array array-var))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (match (lower-vector-map-value-cache-lookup
            cache
            (LowerVectorMapValueKey.ArrayData array-var))
            [(LowerMaybeIrValue.Some data-ptr)
              (lower-vector-map-cache-emitted
                (lower-emit-vector-array-data-for-mode
                  state
                  data-ptr
                  index-var
                  lanes
                  elem-ty
                  emit-mode)
                (LowerVectorMapValueKey.Array array-var)
                cache)]
            [(LowerMaybeIrValue.No)
              (lower-vector-map-cache-emitted
                (lower-emit-vector-map-value-for-mode
                  ctx
                  state
                  index-var
                  lanes
                  elem-ty
                  (LowerVectorMapValue.Array array-var)
                  emit-mode)
                (LowerVectorMapValueKey.Array array-var)
                cache)])])]
    [(LowerVectorMapValue.Gather source-var indexes-var)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.Gather source-var indexes-var))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.Gather source-var indexes-var)
              emit-mode)
            (LowerVectorMapValueKey.Gather source-var indexes-var)
            cache)])]
    [(LowerVectorMapValue.GatherLaneOffset source-var offsets-var)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.GatherLaneOffset source-var offsets-var))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.GatherLaneOffset source-var offsets-var)
              emit-mode)
            (LowerVectorMapValueKey.GatherLaneOffset source-var offsets-var)
            cache)])]
    [(LowerVectorMapValue.LaneArray array-var)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.LaneArray array-var))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.LaneArray array-var)
              emit-mode)
            (LowerVectorMapValueKey.LaneArray array-var)
            cache)])]
    [(LowerVectorMapValue.Uniform uniform-value)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.Uniform uniform-value))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.Uniform uniform-value)
              emit-mode)
            (LowerVectorMapValueKey.Uniform uniform-value)
            cache)])]
    [(LowerVectorMapValue.BroadcastArray array-var lane)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.BroadcastArray array-var lane))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.BroadcastArray array-var lane)
              emit-mode)
            (LowerVectorMapValueKey.BroadcastArray array-var lane)
            cache)])]
    [(LowerVectorMapValue.LaneIndex)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.LaneIndex))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.LaneIndex)
              emit-mode)
            (LowerVectorMapValueKey.LaneIndex)
            cache)])]
    [(LowerVectorMapValue.LaneCount)
      (match (lower-vector-map-value-cache-lookup
        cache
        (LowerVectorMapValueKey.LaneCount))
        [(LowerMaybeIrValue.Some value)
          (LowerVectorMapCachedEmit.Emit state value cache)]
        [(LowerMaybeIrValue.No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LowerVectorMapValue.LaneCount)
              emit-mode)
            (LowerVectorMapValueKey.LaneCount)
            cache)])]
    [(LowerVectorMapValue.Shuffle source selector)
      (match (lower-emit-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get source)
        (box-get selector)
        emit-mode)
        [(LowerExpr.Expr shuffle-state shuffle-value _)
          (LowerVectorMapCachedEmit.Emit shuffle-state shuffle-value cache)])]
    [(LowerVectorMapValue.BinOp op lhs rhs)
      (match (lower-emit-vector-map-value-cached
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get lhs)
        emit-mode
        cache)
        [(LowerVectorMapCachedEmit.Emit lhs-state lhs-value lhs-cache)
          (match (lower-emit-vector-map-value-cached
            ctx
            lhs-state
            index-var
            lanes
            elem-ty
            (box-get rhs)
            emit-mode
            lhs-cache)
            [(LowerVectorMapCachedEmit.Emit rhs-state rhs-value rhs-cache)
              (match (lower-vector-map-value-cache-lookup
                rhs-cache
                (LowerVectorMapValueKey.BinOp op lhs-value rhs-value))
                [(LowerMaybeIrValue.Some value)
                  (LowerVectorMapCachedEmit.Emit rhs-state value rhs-cache)]
                [(LowerMaybeIrValue.No)
                  (lower-vector-map-cache-emitted
                    (lower-emit-vector-map-binop
                      rhs-state
                      op
                      lhs-value
                      rhs-value
                      lanes
                      elem-ty
                      emit-mode)
                    (LowerVectorMapValueKey.BinOp op lhs-value rhs-value)
                    rhs-cache)])])])]))

(define (lower-emit-predicated-vector-map-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : ir.CompilerIrValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (lower-emit-predicated-load
        state
        (ir.CompilerIrValue.Var array-var)
        (ir.CompilerIrValue.Var index-var)
        mask
        lanes
        elem-ty)]
    ;; Gather maps use the scalar tail path so only active lanes are checked.
    [(LowerVectorMapValue.Gather _ _)
      (LowerExpr.Expr state ir.CompilerIrValue.Unit elem-ty)]
    [(LowerVectorMapValue.GatherLaneOffset _ _)
      (LowerExpr.Expr state ir.CompilerIrValue.Unit elem-ty)]
    [(LowerVectorMapValue.LaneArray array-var)
      (match (lower-emit-binop
        state
        ir.CompilerIrBinOp.Sub
        end-value
        (ir.CompilerIrValue.Var index-var)
        (ast.AstType.I64))
        [(LowerExpr.Expr count-state active-lanes _)
          (match (lower-emit-binop
            count-state
            ir.CompilerIrBinOp.Sub
            active-lanes
            (ir.CompilerIrValue.I64 1)
            (ast.AstType.I64))
            [(LowerExpr.Expr last-state last-lane _)
              (match (lower-array-len-value
                last-state
                (ir.CompilerIrValue.Var array-var))
                [(LowerExpr.Expr len-state array-len _)
                  (lower-emit-predicated-load
                    (lower-emit-bounds-check len-state last-lane array-len)
                    (ir.CompilerIrValue.Var array-var)
                    (ir.CompilerIrValue.I64 0)
                    mask
                    lanes
                    elem-ty)])])])]
    [(LowerVectorMapValue.Uniform value)
      (lower-emit-splat state value lanes elem-ty)]
    [(LowerVectorMapValue.BroadcastArray array-var lane)
      (match (lower-emit-binop
        state
        ir.CompilerIrBinOp.Sub
        end-value
        (ir.CompilerIrValue.Var index-var)
        (ast.AstType.I64))
        [(LowerExpr.Expr count-state active-lanes _)
          (lower-emit-spmd-broadcast-array
            ctx
            count-state
            index-var
            array-var
            lane
            active-lanes
            lanes
            elem-ty)])]
    [(LowerVectorMapValue.LaneIndex) (lower-emit-lane-id state lanes elem-ty)]
    [(LowerVectorMapValue.LaneCount)
      (lower-emit-splat state (ir.CompilerIrValue.I64 lanes) lanes elem-ty)]
    [(LowerVectorMapValue.Shuffle source selector)
      (lower-emit-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        (box-get source)
        (box-get selector)
        (LowerVectorMapEmitMode.Predicated end-value mask))]
    [(LowerVectorMapValue.BinOp op lhs rhs)
      (match (lower-emit-predicated-vector-map-value
        ctx
        state
        index-var
        end-value
        mask
        lanes
        elem-ty
        (box-get lhs))
        [(LowerExpr.Expr lhs-state lhs-value _)
          (match (lower-emit-predicated-vector-map-value
            ctx
            lhs-state
            index-var
            end-value
            mask
            lanes
            elem-ty
            (box-get rhs))
            [(LowerExpr.Expr rhs-state rhs-value _)
              (lower-emit-vector-map-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                elem-ty
                (LowerVectorMapEmitMode.Predicated end-value mask))])])]))

(define (lower-vector-map-value-needs-scalar-tail? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(LowerVectorMapValue.Gather _ _) true]
    [(LowerVectorMapValue.GatherLaneOffset _ _) true]
    [(LowerVectorMapValue.BroadcastArray _ _) true]
    [(LowerVectorMapValue.LaneArray _) true]
    [(LowerVectorMapValue.LaneIndex) true]
    [(LowerVectorMapValue.LaneCount) true]
    [(LowerVectorMapValue.Shuffle _ _) true]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-needs-scalar-tail? (box-get lhs))
        (lower-vector-map-value-needs-scalar-tail? (box-get rhs)))]
    [_ false]))

(define (lower-vector-map-value-has-gather? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(LowerVectorMapValue.Gather _ _) true]
    [(LowerVectorMapValue.GatherLaneOffset _ _) true]
    [(LowerVectorMapValue.BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-has-gather? (box-get lhs))
        (lower-vector-map-value-has-gather? (box-get rhs)))]
    [_ false]))

(define (lower-vector-map-store-list-needs-scalar-tail?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [needs-tail : bool false]
    (begin
      (while (and (not needs-tail) (< index count))
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore _ value-plan)
            (if (lower-vector-map-value-needs-scalar-tail? value-plan)
              (set! needs-tail true)
              (set! index (+ index 1)))]))
      needs-tail)))

(define (lower-vector-map-store-list-has-gather?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [has-gather : bool false]
    (begin
      (while (and (not has-gather) (< index count))
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore _ value-plan)
            (if (lower-vector-map-value-has-gather? value-plan)
              (set! has-gather true)
              (set! index (+ index 1)))]))
      has-gather)))

(define (lower-vector-map-store-list-has-shuffle?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 (struct-get stores count)]
    [index : i64 0]
    [has-shuffle : bool false]
    (begin
      (while (and (not has-shuffle) (< index count))
        (match (lower-vector-map-store-list-ref stores index)
          [(LowerVectorMapStore _ value-plan)
            (if (lower-vector-map-value-has-shuffle? value-plan)
              (set! has-shuffle true)
              (set! index (+ index 1)))]))
      has-shuffle)))

(define (lower-maybe-vector-map-needs-scalar-tail? [plan : LowerMaybeVectorMap]) : bool
  (match plan
    [(LowerMaybeVectorMap.Some stores _ _)
      (lower-vector-map-store-list-needs-scalar-tail? stores)]
    [(LowerMaybeVectorMap.No) false]))

(define (lower-maybe-vector-map-has-gather? [plan : LowerMaybeVectorMap]) : bool
  (match plan
    [(LowerMaybeVectorMap.Some stores _ _)
      (lower-vector-map-store-list-has-gather? stores)]
    [(LowerMaybeVectorMap.No) false]))

(define (lower-maybe-vector-map-has-shuffle? [plan : LowerMaybeVectorMap]) : bool
  (match plan
    [(LowerMaybeVectorMap.Some stores _ _)
      (lower-vector-map-store-list-has-shuffle? stores)]
    [(LowerMaybeVectorMap.No) false]))

(define (lower-emit-scalar-vector-map-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base-index-var : i64]
  [current-index-var : i64]
  [lane-index : ir.CompilerIrValue]
  [active-lanes : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(LowerVectorMapValue.Array array-var)
      (match (lower-array-element-addr
        ctx
        state
        (ir.CompilerIrValue.Var array-var)
        (ir.CompilerIrValue.Var current-index-var)
        (ast.AstType.I64)
        elem-ty)
        [(LowerExpr.Expr addr-state elem-ptr _)
          (lower-emit-load addr-state elem-ptr elem-ty)])]
    [(LowerVectorMapValue.Gather source-var indexes-var)
      (match (lower-array-element-addr
        ctx
        state
        (ir.CompilerIrValue.Var indexes-var)
        (ir.CompilerIrValue.Var current-index-var)
        (ast.AstType.I64)
        (ast.AstType.I64))
        [(LowerExpr.Expr index-addr-state index-ptr _)
          (match (lower-emit-load index-addr-state index-ptr (ast.AstType.I64))
            [(LowerExpr.Expr index-state gathered-index _)
              (match (lower-array-element-addr
                ctx
                index-state
                (ir.CompilerIrValue.Var source-var)
                gathered-index
                (ast.AstType.I64)
                elem-ty)
                [(LowerExpr.Expr source-addr-state source-ptr _)
                  (lower-emit-load source-addr-state source-ptr elem-ty)])])])]
    [(LowerVectorMapValue.GatherLaneOffset source-var offsets-var)
      ;; The tail loop mutates `current-index-var`. Emit this subtraction raw
      ;; instead of using the lowering-time copy folder, which otherwise sees
      ;; the loop's initial `current == base` assignment and freezes every tail
      ;; iteration to lane zero.
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc lane-alloc-state lane-var)
          (match (lower-array-element-addr
            ctx
            (lower-state-emit
              lane-alloc-state
              (ir.CompilerIrInstr.BinOp
                lane-var
                ir.CompilerIrBinOp.Sub
                (ir.CompilerIrValue.Var current-index-var)
                (ir.CompilerIrValue.Var base-index-var)
                (ast.AstType.I64)))
            (ir.CompilerIrValue.Var offsets-var)
            (ir.CompilerIrValue.Var lane-var)
            (ast.AstType.I64)
            (ast.AstType.I64))
            [(LowerExpr.Expr offset-addr-state offset-ptr _)
              (match (lower-emit-load
                offset-addr-state
                offset-ptr
                (ast.AstType.I64))
                [(LowerExpr.Expr offset-state offset _)
                  (match (lower-emit-binop
                    offset-state
                    ir.CompilerIrBinOp.Add
                    (ir.CompilerIrValue.Var current-index-var)
                    offset
                    (ast.AstType.I64))
                    [(LowerExpr.Expr index-state gathered-index _)
                      (match (lower-array-element-addr
                        ctx
                        index-state
                        (ir.CompilerIrValue.Var source-var)
                        gathered-index
                        (ast.AstType.I64)
                        elem-ty)
                        [(LowerExpr.Expr source-addr-state source-ptr _)
                          (lower-emit-load source-addr-state source-ptr elem-ty)])])])])])]
    [(LowerVectorMapValue.LaneArray array-var)
      (match (lower-emit-binop
        state
        ir.CompilerIrBinOp.Sub
        (ir.CompilerIrValue.Var current-index-var)
        (ir.CompilerIrValue.Var base-index-var)
        (ast.AstType.I64))
        [(LowerExpr.Expr lane-state lane-index _)
          (match (lower-array-element-addr
            ctx
            lane-state
            (ir.CompilerIrValue.Var array-var)
            lane-index
            (ast.AstType.I64)
            elem-ty)
            [(LowerExpr.Expr addr-state elem-ptr _)
              (lower-emit-load addr-state elem-ptr elem-ty)])])]
    [(LowerVectorMapValue.Uniform value) (LowerExpr.Expr state value elem-ty)]
    [(LowerVectorMapValue.BroadcastArray array-var lane)
      (match (lower-emit-binop
        (lower-emit-spmd-broadcast-lane-check state lane active-lanes)
        ir.CompilerIrBinOp.Add
        (ir.CompilerIrValue.Var base-index-var)
        lane
        (ast.AstType.I64))
        [(LowerExpr.Expr index-state source-index _)
          (match (lower-array-element-addr
            ctx
            index-state
            (ir.CompilerIrValue.Var array-var)
            source-index
            (ast.AstType.I64)
            elem-ty)
            [(LowerExpr.Expr addr-state elem-ptr _)
              (lower-emit-load addr-state elem-ptr elem-ty)])])]
    [(LowerVectorMapValue.LaneIndex)
      (lower-emit-binop
        state
        ir.CompilerIrBinOp.Sub
        (ir.CompilerIrValue.Var current-index-var)
        (ir.CompilerIrValue.Var base-index-var)
        elem-ty)]
    [(LowerVectorMapValue.LaneCount)
      (LowerExpr.Expr state (ir.CompilerIrValue.I64 lanes) elem-ty)]
    [(LowerVectorMapValue.Shuffle source selector)
      (match (box-get selector)
        [(LowerVectorMapValue.LaneIndex)
          (lower-emit-scalar-vector-map-value
            ctx
            state
            base-index-var
            current-index-var
            lane-index
            active-lanes
            lanes
            elem-ty
            (box-get source))]
        [_
          (match (lower-emit-scalar-vector-map-value
            ctx
            state
            base-index-var
            current-index-var
            lane-index
            active-lanes
            lanes
            (ast.AstType.I64)
            (box-get selector))
            [(LowerExpr.Expr selector-state selector-value _)
              (match (lower-state-alloc-var
                (lower-emit-spmd-broadcast-lane-check
                  selector-state
                  selector-value
                  active-lanes))
                [(LowerAlloc.Alloc source-index-state source-index-var)
                  (lower-emit-scalar-vector-map-value
                    ctx
                    (lower-state-emit
                      source-index-state
                      (ir.CompilerIrInstr.BinOp
                        source-index-var
                        ir.CompilerIrBinOp.Add
                        (ir.CompilerIrValue.Var base-index-var)
                        selector-value
                        (ast.AstType.I64)))
                    base-index-var
                    source-index-var
                    selector-value
                    active-lanes
                    lanes
                    elem-ty
                    (box-get source))])])])]
    [(LowerVectorMapValue.BinOp op lhs rhs)
      (match (lower-emit-scalar-vector-map-value
        ctx
        state
        base-index-var
        current-index-var
        lane-index
        active-lanes
        lanes
        elem-ty
        (box-get lhs))
        [(LowerExpr.Expr lhs-state lhs-value _)
          (match (lower-emit-scalar-vector-map-value
            ctx
            lhs-state
            base-index-var
            current-index-var
            lane-index
            active-lanes
            lanes
            elem-ty
            (box-get rhs))
            [(LowerExpr.Expr rhs-state rhs-value _)
              (lower-emit-binop rhs-state op lhs-value rhs-value elem-ty)])])]))

(define (lower-avx2-broadcast-tail-map-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : ir.CompilerIrValue]
  [stores : LowerVectorMapStoreList]
  [elem-ty : ast.AstType]
  [lanes : i64]
  [exit-label : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc alloc-state tail-var)
      (let
        [s : LowerState
          (lower-state-emit
            alloc-state
            (ir.CompilerIrInstr.Mov
              tail-var
              (ir.CompilerIrValue.Var index-var)
              (ast.AstType.I64)))]
        [tail-lane-var : i64 0]
        [header-label : i64 (ir.compiler-ir-label-none)]
        [body-label : i64 (ir.compiler-ir-label-none)]
        [active-lanes : ir.CompilerIrValue ir.CompilerIrValue.Unit]
        [tail-cond : ir.CompilerIrValue ir.CompilerIrValue.Unit]
        [scalar-value : ir.CompilerIrValue ir.CompilerIrValue.Unit]
        [elem-ptr : ir.CompilerIrValue ir.CompilerIrValue.Unit]
        [store-index : i64 0]
        (begin
          (match (lower-state-alloc-var s)
            [(LowerAlloc.Alloc next-s var)
              (begin
                (set! s next-s)
                (set! tail-lane-var var))])
          (set!
            s
            (lower-state-emit
              s
              (ir.CompilerIrInstr.Mov
                tail-lane-var
                (ir.CompilerIrValue.I64 0)
                (ast.AstType.I64))))
          (match (lower-state-fresh-label s "foreach_broadcast_tail_header")
            [(LowerLabel.Label next-s label)
              (begin
                (set! s next-s)
                (set! header-label label))])
          (match (lower-state-fresh-label s "foreach_broadcast_tail_body")
            [(LowerLabel.Label next-s label)
              (begin
                (set! s next-s)
                (set! body-label label))])
          (match (lower-emit-binop
            s
            ir.CompilerIrBinOp.Sub
            end-value
            (ir.CompilerIrValue.Var index-var)
            (ast.AstType.I64))
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! active-lanes value))])
          (set!
            s
            (lower-state-finish-block
              (lower-state-emit s (ir.CompilerIrInstr.Jump header-label))
              header-label))
          (match (lower-emit-binop
            s
            ir.CompilerIrBinOp.Lt
            (ir.CompilerIrValue.Var tail-var)
            end-value
            (ast.AstType.I64))
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! tail-cond value))])
          (set!
            s
            (lower-state-finish-block
              (lower-state-emit
                s
                (ir.CompilerIrInstr.Branch tail-cond body-label exit-label))
              body-label))
          (while (< store-index (struct-get stores count))
            (match (lower-vector-map-store-list-ref stores store-index)
              [(LowerVectorMapStore dst-array value-plan)
                (begin
                  (match (lower-emit-scalar-vector-map-value
                    ctx
                    s
                    index-var
                    tail-var
                    (ir.CompilerIrValue.Var tail-lane-var)
                    active-lanes
                    lanes
                    elem-ty
                    value-plan)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! scalar-value value))])
                  (match (lower-array-element-addr
                    ctx
                    s
                    (ir.CompilerIrValue.Var dst-array)
                    (ir.CompilerIrValue.Var tail-var)
                    (ast.AstType.I64)
                    elem-ty)
                    [(LowerExpr.Expr next-s value _)
                      (begin
                        (set! s next-s)
                        (set! elem-ptr value))])
                  (set!
                    s
                    (lower-array-elem-store-state
                      ctx
                      s
                      elem-ptr
                      scalar-value
                      elem-ty))
                  (set! store-index (+ store-index 1)))]))
          (match (lower-state-alloc-var s)
            [(LowerAlloc.Alloc inc-alloc inc-var)
              (match (lower-state-alloc-var inc-alloc)
                [(LowerAlloc.Alloc lane-inc-alloc lane-inc-var)
                  (ResultLowerExpr.Ok
                    (LowerExpr.Expr
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            (lower-state-emit
                              (lower-state-emit
                                (lower-state-emit
                                  lane-inc-alloc
                                  (ir.CompilerIrInstr.BinOp
                                    inc-var
                                    ir.CompilerIrBinOp.Add
                                    (ir.CompilerIrValue.Var tail-var)
                                    (ir.CompilerIrValue.I64 1)
                                    (ast.AstType.I64)))
                                (ir.CompilerIrInstr.Mov
                                  tail-var
                                  (ir.CompilerIrValue.Var inc-var)
                                  (ast.AstType.I64)))
                              (ir.CompilerIrInstr.BinOp
                                lane-inc-var
                                ir.CompilerIrBinOp.Add
                                (ir.CompilerIrValue.Var tail-lane-var)
                                (ir.CompilerIrValue.I64 1)
                                (ast.AstType.I64)))
                            (ir.CompilerIrInstr.Mov
                              tail-lane-var
                              (ir.CompilerIrValue.Var lane-inc-var)
                              (ast.AstType.I64)))
                          (ir.CompilerIrInstr.Jump header-label))
                        exit-label)
                      ir.CompilerIrValue.Unit
                      (ast.AstType.Unit)))])])))]))

(define (lower-avx2-vector-map-body
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [plan : LowerMaybeVectorMap]
  [preheader-cache : LowerVectorMapValueCache]) : LowerState
  (match plan
    [(LowerMaybeVectorMap.Some stores elem-ty lanes)
      (let
        [s : LowerState state]
        [count : i64 (struct-get stores count)]
        [results : (__tl_dyn-array ir.CompilerIrValue)
          (make-array ir.CompilerIrValue count)]
        [store-index : i64 0]
        [cache : LowerVectorMapValueCache preheader-cache]
        [result-vec : ir.CompilerIrValue ir.CompilerIrValue.Unit]
        (begin
          ;; Evaluate all values before the first store so common loads and
          ;; products stay in one side-effect-free region for normal CSE.
          (while (< store-index count)
            (match (lower-vector-map-store-list-ref stores store-index)
              [(LowerVectorMapStore _ value-plan)
                (begin
                  (match (lower-emit-vector-map-value-cached
                    ctx
                    s
                    index-var
                    lanes
                    elem-ty
                    value-plan
                    (LowerVectorMapEmitMode.Full)
                    cache)
                    [(LowerVectorMapCachedEmit.Emit next-s value next-cache)
                      (begin
                        (set! s next-s)
                        (set! result-vec value)
                        (set! cache next-cache))])
                  (array-set! results store-index result-vec)
                  (set! store-index (+ store-index 1)))]))
          (set! store-index 0)
          (while (< store-index count)
            (match (lower-vector-map-store-list-ref stores store-index)
              [(LowerVectorMapStore dst-array _)
                (begin
                  (match (lower-vector-map-value-cache-lookup
                    cache
                    (LowerVectorMapValueKey.ArrayData dst-array))
                    [(LowerMaybeIrValue.Some data-ptr)
                      (set!
                        s
                        (lower-emit-vector-store-data
                          s
                          data-ptr
                          (ir.CompilerIrValue.Var index-var)
                          (array-ref results store-index)
                          lanes
                          elem-ty))]
                    [(LowerMaybeIrValue.No)
                      (set!
                        s
                        (lower-emit-vector-store
                          s
                          (ir.CompilerIrValue.Var dst-array)
                          (ir.CompilerIrValue.Var index-var)
                          (array-ref results store-index)
                          lanes
                          elem-ty))])
                  (set! store-index (+ store-index 1)))]))
          (lower-state-emit
            s
            (ir.CompilerIrInstr.Mov index-var next-index (ast.AstType.I64)))))]
    [(LowerMaybeVectorMap.No) state]))

(define (lower-predicated-index-plus-offset
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]) : LowerExpr
  (if (> offset 0)
    (lower-emit-binop
      state
      (ir.CompilerIrBinOp.Add)
      base
      (ir.CompilerIrValue.I64 offset)
      (ast.AstType.I64))
    (LowerExpr.Expr state base (ast.AstType.I64))))

(define (lower-predicated-array-set-end-ok
  [state : LowerState]
  [ok : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [arrays : LowerArrayVarSet]) : LowerExpr
  (let
    [s : LowerState state]
    [next-ok : ir.CompilerIrValue ok]
    [index : i64 0]
    [count : i64 (struct-get arrays count)]
    (begin
      (while (< index count)
        (let
          [array-var : i64 (array-ref (struct-get arrays vars) index)]
          [offset : i64 (array-ref (struct-get arrays offsets) index)]
          (begin
            (match (lower-predicated-index-plus-offset s end-value offset)
              [(LowerExpr.Expr index-state limit-index _)
                (match (lower-array-len-value
                  index-state
                  (ir.CompilerIrValue.Var array-var))
                  [(LowerExpr.Expr len-state array-len _)
                    (match (lower-vector-loop-i64-compare
                      len-state
                      (ir.CompilerIrBinOp.Le)
                      limit-index
                      array-len)
                      [(LowerExpr.Expr cmp-state within _)
                        (match (lower-emit-binop
                          cmp-state
                          (ir.CompilerIrBinOp.And)
                          next-ok
                          within
                          (ast.AstType.Bool))
                          [(LowerExpr.Expr next-state value _)
                            (begin
                              (set! s next-state)
                              (set! next-ok value))])])])])
            (set! index (+ index 1)))))
      (LowerExpr.Expr s next-ok (ast.AstType.Bool)))))

(define (lower-predicated-tail-limit [offset : i64]) : i64
  (- 9223372036854775807 offset))

(define (lower-predicated-tail-ok
  [state : LowerState]
  [index-var : i64]
  [end-value : ir.CompilerIrValue]
  [arrays : LowerArrayVarSet]) : LowerExpr
  (let
    [s : LowerState state]
    [max-offset : i64 (lower-array-var-set-max-offset arrays)]
    [ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [within : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    (begin
      (match (lower-vector-loop-i64-compare
        s
        (ir.CompilerIrBinOp.Ge)
        (ir.CompilerIrValue.Var index-var)
        (ir.CompilerIrValue.I64 0))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-vector-loop-i64-compare
        s
        (ir.CompilerIrBinOp.Le)
        end-value
        (ir.CompilerIrValue.I64 (lower-predicated-tail-limit max-offset)))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop
        s
        (ir.CompilerIrBinOp.And)
        ok
        within
        (ast.AstType.Bool))
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! ok value))])
      (match (lower-vector-loop-i64-compare
        s
        (ir.CompilerIrBinOp.Le)
        (ir.CompilerIrValue.Var index-var)
        end-value)
        [(LowerExpr.Expr next-s value _)
          (begin
            (set! s next-s)
            (set! within value))])
      (match (lower-emit-binop
        s
        (ir.CompilerIrBinOp.And)
        ok
        within
        (ast.AstType.Bool))
        [(LowerExpr.Expr next-s value _)
          (lower-predicated-array-set-end-ok next-s value end-value arrays)]))))

(define (lower-avx512-masked-unsupported [expr : ast.AstExpr] [detail : String]) : ResultLowerExpr
  (ResultLowerExpr.Err
    (box
      (lower-diagnostic-at-expr
        expr
        (string.append "lower: SPMD masked if does not support " detail)))))

;; `No` is the proven all-active state for a full SIMD gang. Keep that proof
;; symbolic through masked lowering so parent-only memory operations can use
;; ordinary vector loads/stores. Materialize an actual mask only at operations
;; such as varying loops and private calls whose IR requires one.
(define (lower-masked-active-mask-value
  [state : LowerState]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]) : LowerExpr
  (match active-mask
    [(ir.CompilerIrMaybeValue.Some mask)
      (LowerExpr.Expr state mask (ast.AstType.Bool))]
    [(ir.CompilerIrMaybeValue.No)
      (lower-emit-tail-mask
        state
        (ir.CompilerIrValue.I64 0)
        (ir.CompilerIrValue.I64 lanes)
        lanes)]))

(define (lower-masked-active-intersect
  [state : LowerState]
  [active-mask : ir.CompilerIrMaybeValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match active-mask
    [(ir.CompilerIrMaybeValue.No)
      (LowerExpr.Expr state mask (ast.AstType.Bool))]
    [(ir.CompilerIrMaybeValue.Some parent-mask)
      (lower-emit-mask-binop
        state
        (ir.CompilerIrMaskBinOp.And)
        parent-mask
        mask
        lanes)]))

(define (lower-emit-active-load
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (if (lower-type-bool? elem-ty)
    (match (lower-masked-active-mask-value state active-mask lanes)
      [(LowerExpr.Expr mask-state mask _)
        (lower-emit-predicated-load mask-state base index mask lanes elem-ty)])
    (match active-mask
      [(ir.CompilerIrMaybeValue.No)
        (lower-emit-vector-load state base index lanes elem-ty)]
      [(ir.CompilerIrMaybeValue.Some mask)
        (lower-emit-predicated-load state base index mask lanes elem-ty)])))

(define (lower-emit-active-store
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (if (lower-type-bool? elem-ty)
    (match (lower-masked-active-mask-value state active-mask lanes)
      [(LowerExpr.Expr mask-state mask _)
        (lower-emit-predicated-store
          mask-state
          base
          index
          value
          mask
          lanes
          elem-ty)])
    (match active-mask
      [(ir.CompilerIrMaybeValue.No)
        (lower-emit-vector-store state base index value lanes elem-ty)]
      [(ir.CompilerIrMaybeValue.Some mask)
        (lower-emit-predicated-store state base index value mask lanes elem-ty)])))

(define (lower-avx512-masked-index-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index : String]
  [index-var : i64]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (let
    [offset : i64 (lower-masked-vector-index-offset ctx index expr)]
    (if (< offset 0)
      (lower-avx512-masked-unsupported
        expr
        "non-contiguous array indexes in this AVX-512 slice")
      (if (= offset 0)
        (ResultLowerExpr.Ok
          (LowerExpr.Expr
            state
            (ir.CompilerIrValue.Var index-var)
            (ast.AstType.I64)))
        (ResultLowerExpr.Ok
          (lower-emit-binop
            state
            (ir.CompilerIrBinOp.Add)
            (ir.CompilerIrValue.Var index-var)
            (ir.CompilerIrValue.I64 offset)
            (ast.AstType.I64)))))))

(define (lower-avx512-masked-bool-literal
  [state : LowerState]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [value : bool]) : LowerExpr
  (match (lower-masked-active-mask-value state active-mask lanes)
    [(LowerExpr.Expr mask-state mask _)
      (if value
        (LowerExpr.Expr mask-state mask (ast.AstType.Bool))
        (lower-emit-mask-not mask-state mask lanes))]))

(define (lower-avx512-masked-var
  [_ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [lanes : i64]
  [expr : ast.AstExpr]
  [name : i64]) : ResultLowerExpr
  (if (lower-id-set-contains? lane-locals name)
    (let
      [var-id : i64
        (sym_i64_env.sym-i64-lookup-id-or
          env
          name
          (csym.compiler-symbols-missing-handle))]
      (if (csym.compiler-symbols-handle-found? var-id)
        (match (tc_core.tc-lookup-id type-env name)
          [(tc_core.ResultTcType.Ok ty)
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                state
                (ir.CompilerIrValue.Var var-id)
                (tc_core.tc-type-without-regions ty)))]
          [(tc_core.ResultTcType.Err message)
            (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))])
        (lower-avx512-masked-unsupported expr "unknown lane-local binding")))
    (if (string.eq (tc_core.tc-env-key-name-text name) index)
      (ResultLowerExpr.Ok
        (lower-emit-foreach-index-vector state index-var lanes))
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? var-id)
          (match (tc_core.tc-lookup-id type-env name)
            [(tc_core.ResultTcType.Ok ty)
              (let
                [lane-ty : ast.AstType (tc_core.tc-type-without-regions ty)]
                (if (>
                  (lower-simd-lanes-for-elem (lower-state-mode state) lane-ty)
                  0)
                  (ResultLowerExpr.Ok
                    (lower-emit-splat
                      state
                      (ir.CompilerIrValue.Var var-id)
                      lanes
                      lane-ty))
                  (lower-avx512-masked-unsupported
                    expr
                    "uniform non-lane values inside masked vector expressions")))]
            [(tc_core.ResultTcType.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr expr message)))])
          (lower-avx512-masked-unsupported
            expr
            "unbound values inside masked vector expressions"))))))

(define (lower-avx512-masked-array-ref
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [arr : ast.AstExpr]
  [idx : ast.AstExpr]) : ResultLowerExpr
  (match (lower-dynamic-array-var ctx env type-env arr)
    [(LowerMaybeArrayVar.Some array-var elem-ty)
      (let
        [lane-ty : ast.AstType (tc_core.tc-type-without-regions elem-ty)]
        (if (lower-type-bool? lane-ty)
          (match (lower-avx512-masked-index-value ctx state index index-var idx)
            [(ResultLowerExpr.Ok idx-lowered)
              (match idx-lowered
                [(LowerExpr.Expr idx-state idx-value _)
                  (ResultLowerExpr.Ok
                    (lower-emit-active-load
                      idx-state
                      (ir.CompilerIrValue.Var array-var)
                      idx-value
                      active-mask
                      lanes
                      lane-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
          (if (=
            (lower-simd-lanes-for-elem (lower-state-mode state) lane-ty)
            lanes)
            (match (lower-avx512-masked-index-value
              ctx
              state
              index
              index-var
              idx)
              [(ResultLowerExpr.Ok idx-lowered)
                (match idx-lowered
                  [(LowerExpr.Expr idx-state idx-value _)
                    (ResultLowerExpr.Ok
                      (lower-emit-active-load
                        idx-state
                        (ir.CompilerIrValue.Var array-var)
                        idx-value
                        active-mask
                        lanes
                        lane-ty))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
            (lower-avx512-masked-unsupported
              expr
              "mixed lane widths inside one masked foreach"))))]
    [(LowerMaybeArrayVar.No)
      (lower-avx512-masked-unsupported
        expr
        "non-dynamic-array reads inside masked branches")]))

(define (lower-avx512-masked-array-set
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [arr : ast.AstExpr]
  [idx : ast.AstExpr]
  [value : ast.AstExpr]) : ResultLowerExpr
  (match (lower-dynamic-array-var ctx env type-env arr)
    [(LowerMaybeArrayVar.Some array-var elem-ty)
      (let
        [lane-ty : ast.AstType (tc_core.tc-type-without-regions elem-ty)]
        (if (lower-type-bool? lane-ty)
          (match (lower-avx512-masked-index-value ctx state index index-var idx)
            [(ResultLowerExpr.Ok idx-lowered)
              (match idx-lowered
                [(LowerExpr.Expr idx-state idx-value _)
                  (match (lower-avx512-masked-expr-expected
                    ctx
                    idx-state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    value
                    lane-ty)
                    [(ResultLowerExpr.Ok value-lowered)
                      (match value-lowered
                        [(LowerExpr.Expr value-state value-ir _)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr
                              (lower-emit-active-store
                                value-state
                                (ir.CompilerIrValue.Var array-var)
                                idx-value
                                value-ir
                                active-mask
                                lanes
                                lane-ty)
                              ir.CompilerIrValue.Unit
                              (ast.AstType.Unit)))])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
          (if (=
            (lower-simd-lanes-for-elem (lower-state-mode state) lane-ty)
            lanes)
            (match (lower-avx512-masked-index-value
              ctx
              state
              index
              index-var
              idx)
              [(ResultLowerExpr.Ok idx-lowered)
                (match idx-lowered
                  [(LowerExpr.Expr idx-state idx-value _)
                    (match (lower-avx512-masked-expr-expected
                      ctx
                      idx-state
                      env
                      type-env
                      lane-locals
                      index
                      index-var
                      active-mask
                      lanes
                      value
                      lane-ty)
                      [(ResultLowerExpr.Ok value-lowered)
                        (match value-lowered
                          [(LowerExpr.Expr value-state value-ir _)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr
                                (lower-emit-active-store
                                  value-state
                                  (ir.CompilerIrValue.Var array-var)
                                  idx-value
                                  value-ir
                                  active-mask
                                  lanes
                                  lane-ty)
                                ir.CompilerIrValue.Unit
                                (ast.AstType.Unit)))])]
                      [(ResultLowerExpr.Err message)
                        (ResultLowerExpr.Err message)])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
            (lower-avx512-masked-unsupported
              expr
              "mixed lane widths inside one masked foreach"))))]
    [(LowerMaybeArrayVar.No)
      (lower-avx512-masked-unsupported
        expr
        "non-dynamic-array writes inside masked branches")]))

;; Keep a varying enum lane as the address of the gang's first contiguous
;; element. Tag and payload vectors are assembled below from active-lane-only
;; scalar loads, avoiding a dedicated enum gather representation in both SIMD
;; backends.
(define (lower-avx2-masked-enum-source
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [expr : ast.AstExpr]) : ResultLowerMaskedEnumSource
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-avx2-masked-enum-source
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-avx2-masked-enum-source
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (lower-avx2-masked-enum-source
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Var name)
      (if (lower-id-set-contains? lane-locals name)
        (match (tc_core.tc-lookup-id type-env name)
          [(tc_core.ResultTcType.Ok ty)
            (let
              [resolved : ast.AstType
                (tc_core.tc-type-without-regions
                  (tc_core.tc-resolve-type ctx ty))]
              (if (lower-spmd-enum-type? resolved)
                (let
                  [base-var : i64
                    (sym_i64_env.sym-i64-lookup-id-or
                      env
                      name
                      (csym.compiler-symbols-missing-handle))]
                  (if (csym.compiler-symbols-handle-found? base-var)
                    (ResultLowerMaskedEnumSource.Ok
                      (LowerMaskedEnumSource.Source
                        state
                        (ir.CompilerIrValue.Var base-var)
                        resolved))
                    (ResultLowerMaskedEnumSource.Err
                      (box
                        (lower-diagnostic-at-expr
                          expr
                          "lower: varying enum source has no storage binding")))))
                ResultLowerMaskedEnumSource.No))]
          [(tc_core.ResultTcType.Err message)
            (ResultLowerMaskedEnumSource.Err
              (box (lower-diagnostic-at-expr expr message)))])
        ResultLowerMaskedEnumSource.No)]
    [(ast.AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (match (lower-dynamic-array-var ctx env type-env arr)
          [(LowerMaybeArrayVar.Some array-var elem-ty)
            (let
              [resolved : ast.AstType
                (tc_core.tc-type-without-regions
                  (tc_core.tc-resolve-type ctx elem-ty))]
              (if (lower-spmd-enum-type? resolved)
                (match (lower-avx512-masked-index-value
                  ctx
                  state
                  index
                  index-var
                  idx)
                  [(ResultLowerExpr.Ok idx-lowered)
                    (match idx-lowered
                      [(LowerExpr.Expr idx-state idx-value _)
                        (match (lower-array-data-pointer-value
                          idx-state
                          (ir.CompilerIrValue.Var array-var))
                          [(LowerExpr.Expr data-state data-ptr _)
                            (match (lower-emit-elem-addr-gep
                              ctx
                              data-state
                              data-ptr
                              idx-value
                              resolved)
                              [(LowerExpr.Expr base-state base _)
                                (ResultLowerMaskedEnumSource.Ok
                                  (LowerMaskedEnumSource.Source
                                    base-state
                                    base
                                    resolved))])])])]
                  [(ResultLowerExpr.Err message)
                    (ResultLowerMaskedEnumSource.Err message)])
                ResultLowerMaskedEnumSource.No))]
          [(LowerMaybeArrayVar.No) ResultLowerMaskedEnumSource.No]))]
    [_ ResultLowerMaskedEnumSource.No]))

(define (lower-avx512-masked-let-bindings
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [bindings : ast.AstLetBindingList]) : ResultLowerEnv
  (lower-avx512-masked-let-bindings-at
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    (& bindings)
    0))

(define (lower-avx512-masked-let-bindings-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : ResultLowerEnv
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    (ResultLowerEnv.Ok state env type-env)
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(ast.AstLetBinding.Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [enum-source : ResultLowerMaskedEnumSource
            (if (or
              (lower-mode-avx2? (lower-state-mode state))
              (lower-mode-avx512? (lower-state-mode state)))
              (lower-avx2-masked-enum-source
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                init)
              ResultLowerMaskedEnumSource.No)]
          (match enum-source
            [(ResultLowerMaskedEnumSource.Ok source)
              (match source
                [(LowerMaskedEnumSource.Source init-state init-value init-ty)
                  (let
                    [binding-ty : ast.AstType
                      (lower-let-binding-type ctx maybe-ty init-ty)]
                    (match init-value
                      [(ir.CompilerIrValue.Var init-var)
                        (lower-avx512-masked-let-bindings-at
                          ctx
                          init-state
                          (sym_i64_env.sym-i64-bind-id env name init-var)
                          (tc_core.tc-bind-id type-env name binding-ty)
                          (lower-id-set-insert lane-locals name)
                          index
                          index-var
                          active-mask
                          lanes
                          bindings
                          (+ binding-index 1))]
                      [_
                        (ResultLowerEnv.Err
                          (box
                            (lower-diagnostic-at-expr
                              init
                              "lower: varying enum source did not produce an IR variable")))]))])]
            [(ResultLowerMaskedEnumSource.Err message)
              (ResultLowerEnv.Err message)]
            [(ResultLowerMaskedEnumSource.No)
              (match (lower-avx512-masked-expr
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                init)
                [(ResultLowerExpr.Ok lowered)
                  (match lowered
                    [(LowerExpr.Expr init-state init-value init-ty)
                      (let
                        [binding-ty : ast.AstType
                          (lower-let-binding-type ctx maybe-ty init-ty)]
                        (match init-value
                          [(ir.CompilerIrValue.Var init-var)
                            (lower-avx512-masked-let-bindings-at
                              ctx
                              init-state
                              (sym_i64_env.sym-i64-bind-id env name init-var)
                              (tc_core.tc-bind-id type-env name binding-ty)
                              (lower-id-set-insert lane-locals name)
                              index
                              index-var
                              active-mask
                              lanes
                              bindings
                              (+ binding-index 1))]
                          [_
                            (ResultLowerEnv.Err
                              (box
                                (lower-diagnostic-at-expr
                                  init
                                  "lower: masked let init did not produce an IR variable")))]))])]
                [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)])]))])))

(define (lower-avx512-masked-begin
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [exprs : ast.AstExprList]) : ResultLowerExpr
  (lower-avx512-masked-begin-at
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    (& exprs)
    0))

(define (lower-avx512-masked-begin-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : ResultLowerExpr
  (if (>= expr-index (struct-get exprs len))
    (ResultLowerExpr.Ok
      (LowerExpr.Expr state ir.CompilerIrValue.Unit (ast.AstType.Unit)))
    (let
      [expr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0))]
      (match (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr next-state value ty)
              (if (= (+ expr-index 1) (struct-get exprs len))
                (ResultLowerExpr.Ok (LowerExpr.Expr next-state value ty))
                (lower-avx512-masked-begin-at
                  ctx
                  next-state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lanes
                  exprs
                  (+ expr-index 1)))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))))

(define (lower-avx512-masked-select-result-supported?
  [state : LowerState]
  [lanes : i64]
  [ty : ast.AstType]) : bool
  (=
    (lower-simd-lanes-for-elem
      (lower-state-mode state)
      (tc_core.tc-type-without-regions ty))
    lanes))

(define (lower-avx512-masked-while
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [cond : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (match (lower-masked-active-mask-value state active-mask lanes)
    [(LowerExpr.Expr active-state active-value _)
      (match (lower-state-alloc-var active-state)
        [(LowerAlloc.Alloc mask-alloc loop-mask-var)
          (let
            [s : LowerState
              (lower-state-emit
                mask-alloc
                (ir.CompilerIrInstr.MaskBinOp
                  loop-mask-var
                  (ir.CompilerIrMaskBinOp.Or)
                  active-value
                  active-value
                  lanes))]
            [header-label : i64 (ir.compiler-ir-label-none)]
            [body-label : i64 (ir.compiler-ir-label-none)]
            [exit-label : i64 (ir.compiler-ir-label-none)]
            [cond-active : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [any-active : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            (begin
              (match (lower-state-fresh-label s "spmd_vwhile_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label s "spmd_vwhile_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "spmd_vwhile_exit")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit s (ir.CompilerIrInstr.Jump header-label))
                  header-label))
              (match (lower-avx512-masked-expr
                ctx
                s
                env
                type-env
                lane-locals
                index
                index-var
                (ir.CompilerIrMaybeValue.Some
                  (ir.CompilerIrValue.Var loop-mask-var))
                lanes
                cond)
                [(ResultLowerExpr.Ok cond-lowered)
                  (match cond-lowered
                    [(LowerExpr.Expr cond-state cond-mask _)
                      (begin
                        (match (lower-emit-mask-binop
                          cond-state
                          (ir.CompilerIrMaskBinOp.And)
                          (ir.CompilerIrValue.Var loop-mask-var)
                          cond-mask
                          lanes)
                          [(LowerExpr.Expr next-s value _)
                            (begin
                              (set! s next-s)
                              (set! cond-active value))])
                        (match (lower-emit-mask-reduce
                          s
                          (ir.CompilerIrMaskReduceOp.Any)
                          cond-active
                          lanes)
                          [(LowerExpr.Expr next-s value _)
                            (begin
                              (set! s next-s)
                              (set! any-active value))]))])]
                [(ResultLowerExpr.Err message)
                  (return (ResultLowerExpr.Err message))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (ir.CompilerIrInstr.Branch any-active body-label exit-label))
                  body-label))
              (match (lower-avx512-masked-expr-expected
                ctx
                s
                env
                type-env
                lane-locals
                index
                index-var
                (ir.CompilerIrMaybeValue.Some cond-active)
                lanes
                body
                (ast.AstType.Unit))
                [(ResultLowerExpr.Ok body-lowered)
                  (match body-lowered
                    [(LowerExpr.Expr body-state _ _)
                      (set!
                        s
                        (lower-state-emit
                          body-state
                          (ir.CompilerIrInstr.MaskBinOp
                            loop-mask-var
                            (ir.CompilerIrMaskBinOp.Or)
                            cond-active
                            cond-active
                            lanes)))])]
                [(ResultLowerExpr.Err message)
                  (return (ResultLowerExpr.Err message))])
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-state-finish-block
                    (lower-state-emit s (ir.CompilerIrInstr.Jump header-label))
                    exit-label)
                  ir.CompilerIrValue.Unit
                  (ast.AstType.Unit)))))])]))

(define (lower-avx512-masked-if
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [cond : ast.AstExpr]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]) : ResultLowerExpr
  (match (lower-avx512-masked-expr
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    cond)
    [(ResultLowerExpr.Ok cond-lowered)
      (match cond-lowered
        [(LowerExpr.Expr cond-state cond-mask _)
          (match (lower-masked-active-intersect
            cond-state
            active-mask
            cond-mask
            lanes)
            [(LowerExpr.Expr then-mask-state then-mask _)
              (match (lower-emit-mask-not then-mask-state cond-mask lanes)
                [(LowerExpr.Expr not-state not-mask _)
                  (match (lower-masked-active-intersect
                    not-state
                    active-mask
                    not-mask
                    lanes)
                    [(LowerExpr.Expr else-mask-state else-mask _)
                      (match (lower-avx512-masked-expr-expected
                        ctx
                        else-mask-state
                        env
                        type-env
                        lane-locals
                        index
                        index-var
                        (ir.CompilerIrMaybeValue.Some then-mask)
                        lanes
                        then-branch
                        result-ty)
                        [(ResultLowerExpr.Ok then-lowered)
                          (match then-lowered
                            [(LowerExpr.Expr then-state then-value then-ty)
                              (match (lower-avx512-masked-expr-expected
                                ctx
                                then-state
                                env
                                type-env
                                lane-locals
                                index
                                index-var
                                (ir.CompilerIrMaybeValue.Some else-mask)
                                lanes
                                else-branch
                                result-ty)
                                [(ResultLowerExpr.Ok else-lowered)
                                  (match else-lowered
                                    [(LowerExpr.Expr
                                        else-state
                                        else-value
                                        else-ty)
                                      (match then-ty
                                        [(ast.AstType.Unit)
                                          (ResultLowerExpr.Ok
                                            (LowerExpr.Expr
                                              else-state
                                              ir.CompilerIrValue.Unit
                                              (ast.AstType.Unit)))]
                                        [_
                                          (if (and
                                            (ast.ast-type-eq-with-pools?
                                              (tc_core.tc-context-pools ctx)
                                              then-ty
                                              else-ty)
                                            (lower-type-bool? then-ty))
                                            (ResultLowerExpr.Ok
                                              (lower-emit-mask-select
                                                else-state
                                                then-mask
                                                then-value
                                                else-mask
                                                else-value
                                                lanes))
                                            (if (and
                                              (ast.ast-type-eq-with-pools?
                                                (tc_core.tc-context-pools ctx)
                                                then-ty
                                                else-ty)
                                              (lower-avx512-masked-select-result-supported?
                                                else-state
                                                lanes
                                                then-ty))
                                              (ResultLowerExpr.Ok
                                                (lower-emit-select
                                                  else-state
                                                  then-mask
                                                  then-value
                                                  else-value
                                                  lanes
                                                  then-ty))
                                              (lower-avx512-masked-unsupported
                                                expr
                                                "this value-producing masked if result type")))])])]
                                [(ResultLowerExpr.Err message)
                                  (ResultLowerExpr.Err message)])])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])])])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-simd-masked-index-mod
  [state : LowerState]
  [index-var : i64]
  [index-offset : i64]
  [lanes : i64]
  [divisor : i64]) : ResultLowerExpr
  (let
    [s : LowerState state]
    [lane-id : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [result : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [lane : i64 0]
    (begin
      (match (lower-emit-lane-id s lanes (ast.AstType.I64))
        [(LowerExpr.Expr next-state value _)
          (begin
            (set! s next-state)
            (set! lane-id value))])
      (match (lower-emit-splat
        s
        (ir.CompilerIrValue.I64 0)
        lanes
        (ast.AstType.I64))
        [(LowerExpr.Expr next-state value _)
          (begin
            (set! s next-state)
            (set! result value))])
      (while (< lane lanes)
        (let
          [one-lane : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          [lane-value : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          [lane-remainder : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          (begin
            (match (lower-emit-splat
              s
              (ir.CompilerIrValue.I64 lane)
              lanes
              (ast.AstType.I64))
              [(LowerExpr.Expr lane-state lane-splat _)
                (match (lower-emit-vector-compare
                  lane-state
                  (ir.CompilerIrBinOp.Eq)
                  lane-id
                  lane-splat
                  lanes
                  (ast.AstType.I64))
                  [(LowerExpr.Expr next-state value _)
                    (begin
                      (set! s next-state)
                      (set! one-lane value))])])
            (match (lower-emit-binop
              s
              (ir.CompilerIrBinOp.Add)
              (ir.CompilerIrValue.Var index-var)
              (ir.CompilerIrValue.I64 (+ index-offset lane))
              (ast.AstType.I64))
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-value value))])
            (match (lower-emit-binop
              s
              (ir.CompilerIrBinOp.Mod)
              lane-value
              (ir.CompilerIrValue.I64 divisor)
              (ast.AstType.I64))
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-remainder value))])
            (match (lower-emit-splat s lane-remainder lanes (ast.AstType.I64))
              [(LowerExpr.Expr splat-state lane-vector _)
                (match (lower-emit-select
                  splat-state
                  one-lane
                  lane-vector
                  result
                  lanes
                  (ast.AstType.I64))
                  [(LowerExpr.Expr next-state value _)
                    (begin
                      (set! s next-state)
                      (set! result value))])])
            (set! lane (+ lane 1)))))
      (ResultLowerExpr.Ok (LowerExpr.Expr s result (ast.AstType.I64))))))

(define (lower-avx512-masked-vector-binop
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [op : ir.CompilerIrBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    expr)
    [(tc_core.ResultTcType.Ok result-ty)
      (let
        [lane-ty : ast.AstType (tc_core.tc-type-without-regions result-ty)]
        (match (lower-avx512-masked-expr-expected
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          left
          lane-ty)
          [(ResultLowerExpr.Ok left-lowered)
            (match left-lowered
              [(LowerExpr.Expr left-state left-value _)
                (match (lower-avx512-masked-expr-expected
                  ctx
                  left-state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lanes
                  right
                  lane-ty)
                  [(ResultLowerExpr.Ok right-lowered)
                    (match right-lowered
                      [(LowerExpr.Expr right-state right-value _)
                        (ResultLowerExpr.Ok
                          (lower-emit-vector-binop
                            right-state
                            op
                            left-value
                            right-value
                            lanes
                            lane-ty))])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
          [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]))

(define (lower-masked-shift-op-name [op : ast.AstBinOp]) : String
  (match op
    [(ast.AstBinOp.Shl) "shl"]
    [(ast.AstBinOp.Shr) "shr"]
    [_ "unknown"]))

(define (lower-masked-shift-mode-name [mode : CompilerLowerMode]) : String
  (if (lower-mode-avx2? mode)
    "AVX2"
    "AVX-512"))

(define (lower-masked-shift-lane-supported? [ty : ast.AstType]) : bool
  (lower-spmd-shift-lane-supported? ty))

(define (lower-masked-shift-unsupported
  [state : LowerState]
  [expr : ast.AstExpr]
  [op : ast.AstBinOp]
  [lane-ty : ast.AstType]) : ResultLowerExpr
  (lower-avx512-masked-unsupported
    expr
    (str_cat.str-cat
      "masked shift '"
      (lower-masked-shift-op-name op)
      "' for lane type "
      (tc_core.tc-type-render lane-ty)
      " in "
      (lower-masked-shift-mode-name (lower-state-mode state))
      " backend mode; supported lane types are i32, u32, i64, and u64")))

(define (lower-avx512-masked-shift-guard-and-emit
  [state : LowerState (:consume)]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [op : ir.CompilerIrBinOp]
  [left-value : ir.CompilerIrValue]
  [right-value : ir.CompilerIrValue]
  [lane-ty : ast.AstType]
  [count-ty : ast.AstType]) : ResultLowerExpr
  (ResultLowerExpr.Ok
    (lower-emit-checked-vector-shift
      state
      active-mask
      lanes
      op
      left-value
      right-value
      lane-ty
      count-ty)))

(define (lower-avx512-masked-shift
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [ast-op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    expr)
    [(tc_core.ResultTcType.Ok result-ty)
      (let
        [lane-ty : ast.AstType (tc_core.tc-type-without-regions result-ty)]
        (if (not (lower-masked-shift-lane-supported? lane-ty))
          (lower-masked-shift-unsupported state expr ast-op lane-ty)
          (match (lower-avx512-masked-expr-expected
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            left
            lane-ty)
            [(ResultLowerExpr.Ok left-lowered)
              (match left-lowered
                [(LowerExpr.Expr left-state left-value _)
                  (match (lower-avx512-masked-expr-expected
                    ctx
                    left-state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    right
                    lane-ty)
                    [(ResultLowerExpr.Ok right-lowered)
                      (match right-lowered
                        [(LowerExpr.Expr right-state right-value right-ty)
                          (let
                            [count-ty : ast.AstType
                              (tc_core.tc-type-without-regions right-ty)]
                            [typed-ir-op : ir.CompilerIrBinOp
                              (match ast-op
                                [(ast.AstBinOp.Shl)
                                  (ir.CompilerIrBinOp.Shl count-ty)]
                                [_ (ir.CompilerIrBinOp.Shr count-ty)])]
                            (if (and
                              (tc_core.tc-integer-type? count-ty)
                              (=
                                (lower-simd-lanes-for-elem
                                  (lower-state-mode state)
                                  count-ty)
                                lanes))
                              (lower-avx512-masked-shift-guard-and-emit
                                right-state
                                active-mask
                                lanes
                                typed-ir-op
                                left-value
                                right-value
                                lane-ty
                                count-ty)
                              (lower-avx512-masked-unsupported
                                expr
                                (str_cat.str-cat
                                  "masked shift '"
                                  (lower-masked-shift-op-name ast-op)
                                  "' count lane type "
                                  (tc_core.tc-type-render count-ty)
                                  "; the count must have the same SIMD lane width as "
                                  (tc_core.tc-type-render lane-ty)))))])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]))

(define (lower-avx512-masked-binary
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultLowerExpr
  (match op
    [(ast.AstBinOp.And)
      (match (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        left)
        [(ResultLowerExpr.Ok left-lowered)
          (match left-lowered
            [(LowerExpr.Expr left-state left-value _)
              (match (lower-avx512-masked-expr
                ctx
                left-state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                right)
                [(ResultLowerExpr.Ok right-lowered)
                  (match right-lowered
                    [(LowerExpr.Expr right-state right-value _)
                      (ResultLowerExpr.Ok
                        (lower-emit-mask-binop
                          right-state
                          (ir.CompilerIrMaskBinOp.And)
                          left-value
                          right-value
                          lanes))])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(ast.AstBinOp.Or)
      (match (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        left)
        [(ResultLowerExpr.Ok left-lowered)
          (match left-lowered
            [(LowerExpr.Expr left-state left-value _)
              (match (lower-avx512-masked-expr
                ctx
                left-state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                right)
                [(ResultLowerExpr.Ok right-lowered)
                  (match right-lowered
                    [(LowerExpr.Expr right-state right-value _)
                      (ResultLowerExpr.Ok
                        (lower-emit-mask-binop
                          right-state
                          (ir.CompilerIrMaskBinOp.Or)
                          left-value
                          right-value
                          lanes))])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(ast.AstBinOp.Add)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.Add)
        left
        right)]
    [(ast.AstBinOp.Sub)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.Sub)
        left
        right)]
    [(ast.AstBinOp.Shl)
      (lower-avx512-masked-shift
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        op
        left
        right)]
    [(ast.AstBinOp.Shr)
      (lower-avx512-masked-shift
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        op
        left
        right)]
    [(ast.AstBinOp.BitAnd)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.BitAnd)
        left
        right)]
    [(ast.AstBinOp.BitOr)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.BitOr)
        left
        right)]
    [(ast.AstBinOp.BitXor)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.BitXor)
        left
        right)]
    [(ast.AstBinOp.Mul)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.Mul)
        left
        right)]
    [(ast.AstBinOp.Mod)
      (let
        [divisor : i64
          (lower-masked-vector-positive-power-two-literal ctx right)]
        [positive-divisor : i64
          (lower-masked-vector-index-literal-offset ctx right)]
        [index-offset : i64 (lower-masked-vector-index-offset ctx index left)]
        (if (and
          (or
            (lower-mode-avx2? (lower-state-mode state))
            (and (lower-mode-avx512? (lower-state-mode state)) (< divisor 0)))
          (> positive-divisor 0)
          (>= index-offset 0)
          (=
            lanes
            (lower-simd-lanes-for-elem
              (lower-state-mode state)
              (ast.AstType.I64))))
          (lower-simd-masked-index-mod
            state
            index-var
            index-offset
            lanes
            positive-divisor)
          (if (and (> divisor 0) (>= index-offset 0))
            (match (lower-avx512-masked-expr
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              left)
              [(ResultLowerExpr.Ok left-lowered)
                (match left-lowered
                  [(LowerExpr.Expr left-state left-value left-ty)
                    (match (lower-emit-splat
                      left-state
                      (ir.CompilerIrValue.I64 (- divisor 1))
                      lanes
                      left-ty)
                      [(LowerExpr.Expr rhs-state rhs-value _)
                        (ResultLowerExpr.Ok
                          (lower-emit-vector-binop
                            rhs-state
                            (ir.CompilerIrBinOp.BitAnd)
                            left-value
                            rhs-value
                            lanes
                            left-ty))])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])
            (lower-avx512-masked-unsupported expr "this binary operator"))))]
    [(ast.AstBinOp.Eq)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.Eq)
        left
        right)]
    [(ast.AstBinOp.Ne)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.Ne)
        left
        right)]
    [(ast.AstBinOp.Lt)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.Lt)
        left
        right)]
    [(ast.AstBinOp.Le)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.Le)
        left
        right)]
    [(ast.AstBinOp.Gt)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.Gt)
        left
        right)]
    [(ast.AstBinOp.Ge)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (ir.CompilerIrBinOp.Ge)
        left
        right)]
    [_ (lower-avx512-masked-unsupported expr "this binary operator")]))

(define (lower-avx512-masked-compare
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [_expr : ast.AstExpr]
  [op : ir.CompilerIrBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultLowerExpr
  (match (lower-avx512-masked-expr
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    left)
    [(ResultLowerExpr.Ok left-lowered)
      (match left-lowered
        [(LowerExpr.Expr left-state left-value left-ty)
          (match (lower-avx512-masked-expr-expected
            ctx
            left-state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            right
            left-ty)
            [(ResultLowerExpr.Ok right-lowered)
              (match right-lowered
                [(LowerExpr.Expr right-state right-value _)
                  (ResultLowerExpr.Ok
                    (lower-emit-vector-compare
                      right-state
                      op
                      left-value
                      right-value
                      lanes
                      left-ty))])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-enum-mask-lane-type [mode : CompilerLowerMode] [lanes : i64]) : ast.AstType
  (if (lower-mode-avx512? mode)
    (cond
      [(= lanes 8) (ast.AstType.I64)]
      [(= lanes 16) (ast.AstType.I32)]
      [(= lanes 32) (ast.AstType.I16)]
      [else (ast.AstType.I8)])
    (cond
      [(= lanes 4) (ast.AstType.I64)]
      [(= lanes 8) (ast.AstType.I32)]
      [(= lanes 16) (ast.AstType.I16)]
      [else (ast.AstType.I8)])))

(define (lower-avx2-enum-zero-value [ty : ast.AstType]) : ir.CompilerIrValue
  (match (tc_core.tc-type-without-regions ty)
    [(ast.AstType.F64) (ir.CompilerIrValue.F64 (cast 0 : u64))]
    [(ast.AstType.F32) (ir.CompilerIrValue.F64 (cast 0 : u64))]
    [(ast.AstType.Bool) (ir.CompilerIrValue.Bool false)]
    [_ (ir.CompilerIrValue.I64 0)]))

(define (lower-avx2-enum-zero-mask
  [state : LowerState]
  [lane-id : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]) : LowerExpr
  (lower-emit-vector-compare
    state
    (ir.CompilerIrBinOp.Ne)
    lane-id
    lane-id
    lanes
    lane-ty))

(define (lower-avx2-enum-one-lane-mask
  [state : LowerState]
  [lane-id : ir.CompilerIrValue]
  [lane : i64]
  [lanes : i64]
  [lane-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-splat state (ir.CompilerIrValue.I64 lane) lanes lane-ty)
    [(LowerExpr.Expr lane-state lane-value _)
      (lower-emit-vector-compare
        lane-state
        (ir.CompilerIrBinOp.Eq)
        lane-id
        lane-value
        lanes
        lane-ty)]))

;; Guard the load in scalar control flow. This is required for both masked arms
;; and the final partial gang: inactive lanes must not touch enum storage.
(define (lower-avx2-enum-load-active-lane
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [active : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc slot-state slot-var)
      (match (lower-state-fresh-label
        (lower-state-emit
          slot-state
          (ir.CompilerIrInstr.Mov slot-var (lower-avx2-enum-zero-value ty) ty))
        "spmd_match_lane_load")
        [(LowerLabel.Label load-label-state load-label)
          (match (lower-state-fresh-label
            load-label-state
            "spmd_match_lane_join")
            [(LowerLabel.Label join-label-state join-label)
              (let
                [load-state : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      join-label-state
                      (ir.CompilerIrInstr.Branch active load-label join-label))
                    load-label)]
                (match (lower-load-at-offset load-state base offset ty)
                  [(LowerExpr.Expr loaded-state loaded _)
                    (LowerExpr.Expr
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            loaded-state
                            (ir.CompilerIrInstr.Mov slot-var loaded ty))
                          (ir.CompilerIrInstr.Jump join-label))
                        join-label)
                      (ir.CompilerIrValue.Var slot-var)
                      ty)]))])])]))

(define (lower-avx2-enum-scalar-bool-lane-mask
  [state : LowerState]
  [condition : ir.CompilerIrValue]
  [one-lane-mask : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc word-state word-var)
      (match (lower-state-fresh-label
        (lower-state-emit
          word-state
          (ir.CompilerIrInstr.Mov word-var (ir.CompilerIrValue.I64 0) lane-ty))
        "spmd_match_lane_true")
        [(LowerLabel.Label true-label-state true-label)
          (match (lower-state-fresh-label
            true-label-state
            "spmd_match_lane_bool")
            [(LowerLabel.Label join-label-state join-label)
              (let
                [true-state : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      join-label-state
                      (ir.CompilerIrInstr.Branch
                        condition
                        true-label
                        join-label))
                    true-label)]
                (match (lower-emit-splat
                  (lower-state-finish-block
                    (lower-state-emit
                      (lower-state-emit
                        true-state
                        (ir.CompilerIrInstr.Mov
                          word-var
                          (ir.CompilerIrValue.I64 -1)
                          lane-ty))
                      (ir.CompilerIrInstr.Jump join-label))
                    join-label)
                  (ir.CompilerIrValue.Var word-var)
                  lanes
                  lane-ty)
                  [(LowerExpr.Expr splat-state splat-value _)
                    (if (lower-mode-avx512? (lower-state-mode splat-state))
                      (match (lower-emit-splat
                        splat-state
                        (ir.CompilerIrValue.I64 0)
                        lanes
                        lane-ty)
                        [(LowerExpr.Expr zero-state zero-value _)
                          (match (lower-emit-vector-compare
                            zero-state
                            (ir.CompilerIrBinOp.Ne)
                            splat-value
                            zero-value
                            lanes
                            lane-ty)
                            [(LowerExpr.Expr mask-state condition-mask _)
                              (lower-emit-mask-binop
                                mask-state
                                (ir.CompilerIrMaskBinOp.And)
                                one-lane-mask
                                condition-mask
                                lanes)])])
                      (lower-emit-mask-binop
                        splat-state
                        (ir.CompilerIrMaskBinOp.And)
                        one-lane-mask
                        splat-value
                        lanes))]))])])]))

;; Reconstruct one payload field as a varying vector without adding a gather
;; opcode: load each active lane and select its splat into a one-lane mask.
(define (lower-avx2-enum-field-vector
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [stride : i64]
  [field-offset : i64]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [field-ty : ast.AstType]) : LowerExpr
  (let
    [lane-ty : ast.AstType
      (lower-enum-mask-lane-type (lower-state-mode state) lanes)]
    [s : LowerState state]
    [lane-id : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [result : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [lane : i64 0]
    (begin
      (match (lower-emit-lane-id s lanes lane-ty)
        [(LowerExpr.Expr next-state value _)
          (begin
            (set! s next-state)
            (set! lane-id value))])
      (match (if (lower-type-bool? field-ty)
        (lower-avx2-enum-zero-mask s lane-id lanes lane-ty)
        (lower-emit-splat
          s
          (lower-avx2-enum-zero-value field-ty)
          lanes
          field-ty))
        [(LowerExpr.Expr next-state value _)
          (begin
            (set! s next-state)
            (set! result value))])
      (while (< lane lanes)
        (let
          [one-lane : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          [lane-active-mask : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          [lane-active : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          [loaded : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          (begin
            (match (lower-avx2-enum-one-lane-mask s lane-id lane lanes lane-ty)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! one-lane value))])
            (match (lower-emit-mask-binop
              s
              (ir.CompilerIrMaskBinOp.And)
              active-mask
              one-lane
              lanes)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-active-mask value))])
            (match (lower-emit-mask-reduce
              s
              (ir.CompilerIrMaskReduceOp.Any)
              lane-active-mask
              lanes)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-active value))])
            (match (lower-avx2-enum-load-active-lane
              s
              base
              (+ field-offset (* lane stride))
              lane-active
              field-ty)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! loaded value))])
            (if (lower-type-bool? field-ty)
              (match (lower-avx2-enum-scalar-bool-lane-mask
                s
                loaded
                one-lane
                lanes
                lane-ty)
                [(LowerExpr.Expr lane-state lane-value _)
                  (match (lower-emit-mask-binop
                    lane-state
                    (ir.CompilerIrMaskBinOp.Or)
                    result
                    lane-value
                    lanes)
                    [(LowerExpr.Expr next-state value _)
                      (begin
                        (set! s next-state)
                        (set! result value))])])
              (match (lower-emit-splat s loaded lanes field-ty)
                [(LowerExpr.Expr lane-state lane-value _)
                  (match (lower-emit-select
                    lane-state
                    one-lane
                    lane-value
                    result
                    lanes
                    field-ty)
                    [(LowerExpr.Expr next-state value _)
                      (begin
                        (set! s next-state)
                        (set! result value))])]))
            (set! lane (+ lane 1)))))
      (LowerExpr.Expr s result field-ty))))

(define (lower-avx2-enum-tag-arm-masks
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [stride : i64]
  [active-mask : ir.CompilerIrValue]
  [lane-id : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]
  [tag : i64]) : ResultLowerMaskedMatchMasks
  (let
    [s : LowerState state]
    [arm-mask : ir.CompilerIrValue ir.CompilerIrValue.Unit]
    [lane : i64 0]
    (begin
      (match (lower-avx2-enum-zero-mask s lane-id lanes lane-ty)
        [(LowerExpr.Expr next-state value _)
          (begin
            (set! s next-state)
            (set! arm-mask value))])
      (while (< lane lanes)
        (let
          [one-lane : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          [lane-active-mask : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          [lane-active : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          [loaded-tag : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          [tag-eq : ir.CompilerIrValue ir.CompilerIrValue.Unit]
          (begin
            (match (lower-avx2-enum-one-lane-mask s lane-id lane lanes lane-ty)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! one-lane value))])
            (match (lower-emit-mask-binop
              s
              (ir.CompilerIrMaskBinOp.And)
              active-mask
              one-lane
              lanes)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-active-mask value))])
            (match (lower-emit-mask-reduce
              s
              (ir.CompilerIrMaskReduceOp.Any)
              lane-active-mask
              lanes)
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! lane-active value))])
            (match (lower-avx2-enum-load-active-lane
              s
              base
              (* lane stride)
              lane-active
              (ast.AstType.I64))
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! loaded-tag value))])
            (match (lower-emit-binop
              s
              (ir.CompilerIrBinOp.Eq)
              loaded-tag
              (ir.CompilerIrValue.I64 tag)
              (ast.AstType.I64))
              [(LowerExpr.Expr next-state value _)
                (begin
                  (set! s next-state)
                  (set! tag-eq value))])
            (match (lower-avx2-enum-scalar-bool-lane-mask
              s
              tag-eq
              one-lane
              lanes
              lane-ty)
              [(LowerExpr.Expr lane-state lane-match _)
                (match (lower-emit-mask-binop
                  lane-state
                  (ir.CompilerIrMaskBinOp.Or)
                  arm-mask
                  lane-match
                  lanes)
                  [(LowerExpr.Expr next-state value _)
                    (begin
                      (set! s next-state)
                      (set! arm-mask value))])])
            (set! lane (+ lane 1)))))
      (match (lower-emit-mask-binop
        s
        (ir.CompilerIrMaskBinOp.And)
        active-mask
        arm-mask
        lanes)
        [(LowerExpr.Expr active-arm-state active-arm-mask _)
          (match (lower-emit-mask-not active-arm-state active-arm-mask lanes)
            [(LowerExpr.Expr not-state not-mask _)
              (match (lower-emit-mask-binop
                not-state
                (ir.CompilerIrMaskBinOp.And)
                active-mask
                not-mask
                lanes)
                [(LowerExpr.Expr rest-state rest-mask _)
                  (ResultLowerMaskedMatchMasks.Ok
                    (LowerMaskedMatchMasks.Masks
                      rest-state
                      active-arm-mask
                      rest-mask))])])]))))

(define (lower-avx2-enum-final-arm-masks
  [state : LowerState]
  [active-mask : ir.CompilerIrValue]
  [lane-id : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]) : ResultLowerMaskedMatchMasks
  (match (lower-avx2-enum-zero-mask state lane-id lanes lane-ty)
    [(LowerExpr.Expr next-state zero-mask _)
      (ResultLowerMaskedMatchMasks.Ok
        (LowerMaskedMatchMasks.Masks next-state active-mask zero-mask))]))

(define (lower-avx2-enum-pattern-arm-masks
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [enum-ty : ast.AstType]
  [active-mask : ir.CompilerIrValue]
  [lane-id : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]
  [pattern : ast.AstPattern]
  [final? : bool]
  [expr : ast.AstExpr]) : ResultLowerMaskedMatchMasks
  (if final?
    (lower-avx2-enum-final-arm-masks state active-mask lane-id lanes lane-ty)
    (match pattern
      [(ast.AstPattern.Binding name)
        (let
          [handle : i64
            (lower-variant-handle-for-scrut-id-or
              ctx
              enum-ty
              name
              (csym.compiler-symbols-missing-handle))]
          (if (csym.compiler-symbols-handle-found? handle)
            (lower-avx2-enum-tag-arm-masks
              state
              base
              (lower-type-size ctx enum-ty)
              active-mask
              lane-id
              lanes
              lane-ty
              (csym.compiler-registry-handle-child-index handle))
            (ResultLowerMaskedMatchMasks.Err
              (box
                (lower-diagnostic-at-expr
                  expr
                  "lower: varying enum pattern has no registered variant")))))]
      [(ast.AstPattern.Variant name _)
        (let
          [handle : i64
            (lower-variant-handle-for-scrut-id-or
              ctx
              enum-ty
              name
              (csym.compiler-symbols-missing-handle))]
          (if (csym.compiler-symbols-handle-found? handle)
            (lower-avx2-enum-tag-arm-masks
              state
              base
              (lower-type-size ctx enum-ty)
              active-mask
              lane-id
              lanes
              lane-ty
              (csym.compiler-registry-handle-child-index handle))
            (ResultLowerMaskedMatchMasks.Err
              (box
                (lower-diagnostic-at-expr
                  expr
                  "lower: varying enum pattern has no registered variant")))))]
      [(ast.AstPattern.Wildcard)
        (lower-avx2-enum-final-arm-masks
          state
          active-mask
          lane-id
          lanes
          lane-ty)]
      [_
        (ResultLowerMaskedMatchMasks.Err
          (box
            (lower-diagnostic-at-expr
              expr
              "lower: unsupported SIMD varying enum match pattern")))])))

(define (lower-avx2-enum-bind-payloads
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [base : ir.CompilerIrValue]
  [enum-ty : ast.AstType]
  [variant-name-id : i64]
  [patterns : ast.AstPatternList]
  [fields : ast.AstTypeList]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [pattern-index : i64]
  [cursor : i64]
  [expr : ast.AstExpr]) : ResultLowerMaskedEnumEnv
  (if (>= pattern-index (struct-get (& patterns) len))
    (if (>= pattern-index (ast.ast-type-list-len (& fields)))
      (ResultLowerMaskedEnumEnv.Ok state env type-env lane-locals)
      (ResultLowerMaskedEnumEnv.Err
        (box
          (lower-diagnostic-at-expr
            expr
            "lower: varying enum payload pattern arity mismatch"))))
    (if (>= pattern-index (ast.ast-type-list-len (& fields)))
      (ResultLowerMaskedEnumEnv.Err
        (box
          (lower-diagnostic-at-expr
            expr
            "lower: varying enum payload pattern arity mismatch")))
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get
            (& patterns)
            pattern-index
            (ast.ast-pattern-fallback))]
        [field-node : i64
          (ast.ast-type-list-get
            (& fields)
            pattern-index
            (ast.ast-type-id-fallback))]
        [field-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx field-node)))]
        [default-offset : i64
          (lower-align-up cursor (lower-type-align ctx field-ty))]
        [enum-id : i64 (lower-enum-type-name-id-or enum-ty -1)]
        [enum-name : String (lower-enum-type-name-or-empty enum-ty)]
        [variant-name : String (tc_core.tc-env-key-name-text variant-name-id)]
        [field-offset : i64
          (lower-variant-payload-offset
            ctx
            (lower-state-mode state)
            enum-id
            enum-name
            variant-name
            variant-name-id
            pattern-index
            cursor
            field-ty)]
        [next-cursor : i64 (+ default-offset (lower-type-size ctx field-ty))]
        (if (< field-offset 0)
          (ResultLowerMaskedEnumEnv.Err
            (box
              (lower-diagnostic-at-expr
                expr
                "lower: varying enum payload layout is unavailable")))
          (match pattern
            [(ast.AstPattern.Wildcard)
              (lower-avx2-enum-bind-payloads
                ctx
                state
                env
                type-env
                lane-locals
                base
                enum-ty
                variant-name-id
                patterns
                fields
                active-mask
                lanes
                (+ pattern-index 1)
                next-cursor
                expr)]
            [(ast.AstPattern.Binding name)
              (match (lower-avx2-enum-field-vector
                state
                base
                (lower-type-size ctx enum-ty)
                field-offset
                active-mask
                lanes
                field-ty)
                [(LowerExpr.Expr next-state value _)
                  (match value
                    [(ir.CompilerIrValue.Var field-var)
                      (lower-avx2-enum-bind-payloads
                        ctx
                        next-state
                        (sym_i64_env.sym-i64-bind-id env name field-var)
                        (tc_core.tc-bind-id type-env name field-ty)
                        (lower-id-set-insert lane-locals name)
                        base
                        enum-ty
                        variant-name-id
                        patterns
                        fields
                        active-mask
                        lanes
                        (+ pattern-index 1)
                        next-cursor
                        expr)]
                    [_
                      (ResultLowerMaskedEnumEnv.Err
                        (box
                          (lower-diagnostic-at-expr
                            expr
                            "lower: varying enum payload did not produce an IR variable")))])])]
            [(ast.AstPattern.Var name _)
              (match (lower-avx2-enum-field-vector
                state
                base
                (lower-type-size ctx enum-ty)
                field-offset
                active-mask
                lanes
                field-ty)
                [(LowerExpr.Expr next-state value _)
                  (match value
                    [(ir.CompilerIrValue.Var field-var)
                      (lower-avx2-enum-bind-payloads
                        ctx
                        next-state
                        (sym_i64_env.sym-i64-bind-id env name field-var)
                        (tc_core.tc-bind-id type-env name field-ty)
                        (lower-id-set-insert lane-locals name)
                        base
                        enum-ty
                        variant-name-id
                        patterns
                        fields
                        active-mask
                        lanes
                        (+ pattern-index 1)
                        next-cursor
                        expr)]
                    [_
                      (ResultLowerMaskedEnumEnv.Err
                        (box
                          (lower-diagnostic-at-expr
                            expr
                            "lower: varying enum payload did not produce an IR variable")))])])]
            [_
              (ResultLowerMaskedEnumEnv.Err
                (box
                  (lower-diagnostic-at-expr
                    expr
                    "lower: SIMD varying enum payload patterns support bindings and wildcards")))]))))))

(define (lower-avx2-enum-bind-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [base : ir.CompilerIrValue]
  [enum-ty : ast.AstType]
  [pattern : ast.AstPattern]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [expr : ast.AstExpr]) : ResultLowerMaskedEnumEnv
  (match pattern
    [(ast.AstPattern.Binding _)
      (ResultLowerMaskedEnumEnv.Ok state env type-env lane-locals)]
    [(ast.AstPattern.Variant name patterns-box)
      (let
        [handle : i64
          (lower-variant-handle-for-scrut-id-or
            ctx
            enum-ty
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? handle)
          (match (csym.compiler-registries-variant-fields-indexed
            (tc_core.tc-context-symbols ctx)
            handle)
            [(parser.ResultAstTypeList.Ok raw-fields)
              (let
                [variant-name-id : i64
                  (lower-variant-handle-name-id-or ctx handle name)]
                [fields : ast.AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    enum-ty
                    raw-fields)]
                (lower-avx2-enum-bind-payloads
                  ctx
                  state
                  env
                  type-env
                  lane-locals
                  base
                  enum-ty
                  variant-name-id
                  (box-get patterns-box)
                  fields
                  active-mask
                  lanes
                  0
                  8
                  expr))]
            [(parser.ResultAstTypeList.Err message)
              (ResultLowerMaskedEnumEnv.Err
                (box (lower-diagnostic-at-expr expr message)))])
          (ResultLowerMaskedEnumEnv.Err
            (box
              (lower-diagnostic-at-expr
                expr
                "lower: varying enum pattern has no registered variant")))))]
    [(ast.AstPattern.Wildcard)
      (ResultLowerMaskedEnumEnv.Ok state env type-env lane-locals)]
    [_
      (ResultLowerMaskedEnumEnv.Err
        (box
          (lower-diagnostic-at-expr
            expr
            "lower: unsupported SIMD varying enum match pattern")))]))

(define (lower-avx2-enum-match-arms
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrValue]
  [lane-id : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [base : ir.CompilerIrValue]
  [enum-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : ResultLowerExpr
  (if (ast.ast-match-arm-list-empty? (& arms))
    (lower-avx512-masked-unsupported
      expr
      "SIMD varying enum match with no arms")
    (match (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (let
          [rest : ast.AstMatchArmList (ast.ast-match-arm-list-tail arms)]
          [final? : bool (ast.ast-match-arm-list-empty? (& rest))]
          [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
          (match (lower-avx2-enum-pattern-arm-masks
            ctx
            state
            base
            enum-ty
            active-mask
            lane-id
            lanes
            lane-ty
            pattern
            final?
            expr)
            [(ResultLowerMaskedMatchMasks.Ok masks)
              (match masks
                [(LowerMaskedMatchMasks.Masks mask-state arm-mask rest-mask)
                  (match (lower-avx2-enum-bind-pattern
                    ctx
                    mask-state
                    env
                    type-env
                    lane-locals
                    base
                    enum-ty
                    pattern
                    arm-mask
                    lanes
                    expr)
                    [(ResultLowerMaskedEnumEnv.Ok
                        bound-state
                        bound-env
                        bound-type-env
                        bound-lane-locals)
                      (match (lower-avx512-masked-expr-expected
                        ctx
                        bound-state
                        bound-env
                        bound-type-env
                        bound-lane-locals
                        index
                        index-var
                        (ir.CompilerIrMaybeValue.Some arm-mask)
                        lanes
                        body
                        result-ty)
                        [(ResultLowerExpr.Ok body-lowered)
                          (match body-lowered
                            [(LowerExpr.Expr body-state body-value body-ty)
                              (if final?
                                (ResultLowerExpr.Ok body-lowered)
                                (match (lower-avx2-enum-match-arms
                                  ctx
                                  body-state
                                  env
                                  type-env
                                  lane-locals
                                  index
                                  index-var
                                  rest-mask
                                  lane-id
                                  lanes
                                  lane-ty
                                  result-ty
                                  expr
                                  base
                                  enum-ty
                                  rest)
                                  [(ResultLowerExpr.Ok rest-lowered)
                                    (match rest-lowered
                                      [(LowerExpr.Expr
                                          rest-state
                                          rest-value
                                          rest-ty)
                                        (match body-ty
                                          [(ast.AstType.Unit)
                                            (ResultLowerExpr.Ok
                                              (LowerExpr.Expr
                                                rest-state
                                                ir.CompilerIrValue.Unit
                                                (ast.AstType.Unit)))]
                                          [_
                                            (if (ast.ast-type-eq-with-pools?
                                              (tc_core.tc-context-pools ctx)
                                              (tc_core.tc-type-without-regions
                                                body-ty)
                                              (tc_core.tc-type-without-regions
                                                rest-ty))
                                              (lower-avx512-masked-match-select
                                                rest-state
                                                arm-mask
                                                body-value
                                                rest-mask
                                                rest-value
                                                lanes
                                                body-ty
                                                expr)
                                              (lower-avx512-masked-unsupported
                                                expr
                                                "mixed SIMD varying enum match arm result types"))])])]
                                  [(ResultLowerExpr.Err message)
                                    (ResultLowerExpr.Err message)]))])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])]
                    [(ResultLowerMaskedEnumEnv.Err message)
                      (ResultLowerExpr.Err message)])])]
            [(ResultLowerMaskedMatchMasks.Err message)
              (ResultLowerExpr.Err message)]))])))

(define (lower-avx2-masked-enum-match
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]) : ResultLowerExpr
  (match (lower-avx2-masked-enum-source
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    scrutinee)
    [(ResultLowerMaskedEnumSource.Ok source)
      (match source
        [(LowerMaskedEnumSource.Source source-state base enum-ty)
          (let
            [lane-ty : ast.AstType
              (lower-enum-mask-lane-type (lower-state-mode source-state) lanes)]
            (match (lower-emit-lane-id source-state lanes lane-ty)
              [(LowerExpr.Expr lane-state lane-id _)
                (lower-avx2-enum-match-arms
                  ctx
                  lane-state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lane-id
                  lanes
                  lane-ty
                  result-ty
                  expr
                  base
                  enum-ty
                  arms)]))])]
    [(ResultLowerMaskedEnumSource.Err message) (ResultLowerExpr.Err message)]
    [(ResultLowerMaskedEnumSource.No)
      (lower-avx512-masked-unsupported
        expr
        "a SIMD varying enum match source outside a contiguous array lane")]))

(define (lower-avx512-masked-match-literal-mask
  [state : LowerState]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [lanes : i64]
  [lit : ast.AstLiteral]) : ResultLowerExpr
  (match (tc_core.tc-type-without-regions scrut-ty)
    [(ast.AstType.Bool)
      (match lit
        [(ast.AstLiteral.Bool value)
          (if value
            (ResultLowerExpr.Ok
              (LowerExpr.Expr state scrut-value (ast.AstType.Bool)))
            (ResultLowerExpr.Ok (lower-emit-mask-not state scrut-value lanes)))]
        [_
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic "lower: unsupported bool literal match pattern")))])]
    [_
      (match (lower-emit-splat
        state
        (lower-literal-value-with-type
          lit
          (tc_core.tc-type-without-regions scrut-ty))
        lanes
        (tc_core.tc-type-without-regions scrut-ty))
        [(LowerExpr.Expr lit-state lit-value _)
          (ResultLowerExpr.Ok
            (lower-emit-vector-compare
              lit-state
              (ir.CompilerIrBinOp.Eq)
              scrut-value
              lit-value
              lanes
              (tc_core.tc-type-without-regions scrut-ty)))])]))

(define (lower-avx512-masked-match-literal-arm-masks
  [state : LowerState]
  [active-mask : ir.CompilerIrValue]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [lanes : i64]
  [lit : ast.AstLiteral]) : ResultLowerMaskedMatchMasks
  (match (lower-avx512-masked-match-literal-mask
    state
    scrut-value
    scrut-ty
    lanes
    lit)
    [(ResultLowerExpr.Ok cond-lowered)
      (match cond-lowered
        [(LowerExpr.Expr cond-state cond-mask _)
          (match (lower-emit-mask-binop
            cond-state
            (ir.CompilerIrMaskBinOp.And)
            active-mask
            cond-mask
            lanes)
            [(LowerExpr.Expr arm-mask-state arm-mask _)
              (match (lower-emit-mask-not arm-mask-state cond-mask lanes)
                [(LowerExpr.Expr not-state not-mask _)
                  (match (lower-emit-mask-binop
                    not-state
                    (ir.CompilerIrMaskBinOp.And)
                    active-mask
                    not-mask
                    lanes)
                    [(LowerExpr.Expr rest-mask-state rest-mask _)
                      (ResultLowerMaskedMatchMasks.Ok
                        (LowerMaskedMatchMasks.Masks
                          rest-mask-state
                          arm-mask
                          rest-mask))])])])])]
    [(ResultLowerExpr.Err message) (ResultLowerMaskedMatchMasks.Err message)]))

(define (lower-avx512-masked-match-select
  [state : LowerState]
  [arm-mask : ir.CompilerIrValue]
  [arm-value : ir.CompilerIrValue]
  [rest-mask : ir.CompilerIrValue]
  [rest-value : ir.CompilerIrValue]
  [lanes : i64]
  [ty : ast.AstType]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (if (lower-type-bool? ty)
    (ResultLowerExpr.Ok
      (lower-emit-mask-select
        state
        arm-mask
        arm-value
        rest-mask
        rest-value
        lanes))
    (if (lower-avx512-masked-select-result-supported? state lanes ty)
      (ResultLowerExpr.Ok
        (lower-emit-select
          state
          arm-mask
          arm-value
          rest-value
          lanes
          (tc_core.tc-type-without-regions ty)))
      (lower-avx512-masked-unsupported
        expr
        "this value-producing varying match result type"))))

(define (lower-avx512-masked-match-after-body
  [ctx : tc_core.TcContext]
  [body-state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [arm-mask : ir.CompilerIrValue]
  [rest-mask : ir.CompilerIrValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [body-value : ir.CompilerIrValue]
  [body-ty : ast.AstType]
  [rest : ast.AstMatchArmList]) : ResultLowerExpr
  (match body-ty
    [(ast.AstType.Unit)
      (lower-avx512-masked-match-arms
        ctx
        body-state
        env
        type-env
        lane-locals
        index
        index-var
        rest-mask
        lanes
        result-ty
        expr
        scrut-value
        scrut-ty
        rest)]
    [_
      (match (lower-avx512-masked-match-arms
        ctx
        body-state
        env
        type-env
        lane-locals
        index
        index-var
        rest-mask
        lanes
        result-ty
        expr
        scrut-value
        scrut-ty
        rest)
        [(ResultLowerExpr.Ok rest-lowered)
          (match rest-lowered
            [(LowerExpr.Expr rest-state rest-value rest-ty)
              (if (ast.ast-type-eq-with-pools?
                (tc_core.tc-context-pools ctx)
                (tc_core.tc-type-without-regions body-ty)
                (tc_core.tc-type-without-regions rest-ty))
                (lower-avx512-masked-match-select
                  rest-state
                  arm-mask
                  body-value
                  rest-mask
                  rest-value
                  lanes
                  body-ty
                  expr)
                (lower-avx512-masked-unsupported
                  expr
                  "mixed varying match arm result types"))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]))

(define (lower-avx512-masked-match-arm
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]) : ResultLowerExpr
  (match pattern
    [(ast.AstPattern.Literal lit)
      (if (ast.ast-match-arm-list-empty? (& rest))
        (lower-avx512-masked-expr-expected
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          (ir.CompilerIrMaybeValue.Some active-mask)
          lanes
          body
          result-ty)
        (match (lower-avx512-masked-match-literal-arm-masks
          state
          active-mask
          scrut-value
          scrut-ty
          lanes
          lit)
          [(ResultLowerMaskedMatchMasks.Ok masks)
            (match masks
              [(LowerMaskedMatchMasks.Masks mask-state arm-mask rest-mask)
                (match (lower-avx512-masked-expr-expected
                  ctx
                  mask-state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  (ir.CompilerIrMaybeValue.Some arm-mask)
                  lanes
                  body
                  result-ty)
                  [(ResultLowerExpr.Ok body-lowered)
                    (match body-lowered
                      [(LowerExpr.Expr body-state body-value body-ty)
                        (lower-avx512-masked-match-after-body
                          ctx
                          body-state
                          env
                          type-env
                          lane-locals
                          index
                          index-var
                          arm-mask
                          rest-mask
                          lanes
                          result-ty
                          expr
                          scrut-value
                          scrut-ty
                          body-value
                          body-ty
                          rest)])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
          [(ResultLowerMaskedMatchMasks.Err message)
            (ResultLowerExpr.Err message)]))]
    [(ast.AstPattern.Wildcard)
      (lower-avx512-masked-expr-expected
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (ir.CompilerIrMaybeValue.Some active-mask)
        lanes
        body
        result-ty)]
    [(ast.AstPattern.Var name _)
      (match scrut-value
        [(ir.CompilerIrValue.Var scrut-var)
          (lower-avx512-masked-expr-expected
            ctx
            state
            (sym_i64_env.sym-i64-bind-id env name scrut-var)
            (tc_core.tc-bind-id type-env name scrut-ty)
            (lower-id-set-insert lane-locals name)
            index
            index-var
            (ir.CompilerIrMaybeValue.Some active-mask)
            lanes
            body
            result-ty)]
        [_
          (lower-avx512-masked-unsupported
            expr
            "non-variable match binding values in this AVX-512 slice")])]
    [(ast.AstPattern.Binding name)
      (match scrut-value
        [(ir.CompilerIrValue.Var scrut-var)
          (lower-avx512-masked-expr-expected
            ctx
            state
            (sym_i64_env.sym-i64-bind-id env name scrut-var)
            (tc_core.tc-bind-id type-env name scrut-ty)
            (lower-id-set-insert lane-locals name)
            index
            index-var
            (ir.CompilerIrMaybeValue.Some active-mask)
            lanes
            body
            result-ty)]
        [_
          (lower-avx512-masked-unsupported
            expr
            "non-variable match binding values in this AVX-512 slice")])]
    [_
      (lower-avx512-masked-unsupported
        expr
        "this varying match pattern in the AVX-512 slice")]))

(define (lower-avx512-masked-match-arms
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : ResultLowerExpr
  (if (ast.ast-match-arm-list-empty? (& arms))
    (lower-avx512-masked-unsupported
      expr
      "match with no arms in this AVX-512 slice")
    (match (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pattern body-box)
        (lower-avx512-masked-match-arm
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          result-ty
          expr
          scrut-value
          scrut-ty
          pattern
          (lower-context-expr-get ctx body-box)
          (ast.ast-match-arm-list-tail arms))])))

(define (lower-avx512-masked-match
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]) : ResultLowerExpr
  (if (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    scrutinee)
    [(tc_core.ResultTcType.Ok scrut-ty) (lower-spmd-enum-type? scrut-ty)]
    [(tc_core.ResultTcType.Err _) false])
    (match (lower-masked-active-mask-value state active-mask lanes)
      [(LowerExpr.Expr mask-state mask _)
        (lower-avx2-masked-enum-match
          ctx
          mask-state
          env
          type-env
          lane-locals
          index
          index-var
          mask
          lanes
          result-ty
          expr
          scrutinee
          arms)])
    (match (lower-avx512-masked-expr
      ctx
      state
      env
      type-env
      lane-locals
      index
      index-var
      active-mask
      lanes
      scrutinee)
      [(ResultLowerExpr.Ok scrut-lowered)
        (match scrut-lowered
          [(LowerExpr.Expr scrut-state scrut-value scrut-ty)
            (match (lower-masked-active-mask-value
              scrut-state
              active-mask
              lanes)
              [(LowerExpr.Expr mask-state mask _)
                (lower-avx512-masked-match-arms
                  ctx
                  mask-state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  mask
                  lanes
                  result-ty
                  expr
                  scrut-value
                  scrut-ty
                  arms)])])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-spmd-ir-value-class [ty : ast.AstType] [varying : bool]) : ir.CompilerIrSpmdValueClass
  (if varying
    (if (lower-type-bool? ty)
      (ir.CompilerIrSpmdValueClass.Mask)
      (ir.CompilerIrSpmdValueClass.Varying))
    (ir.CompilerIrSpmdValueClass.Uniform)))

(define (lower-avx512-spmd-call-args
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [params : ast.AstParamList]
  [args : ast.AstExprList]) : ResultLowerSpmdCallArgs
  (lower-avx512-spmd-call-args-at
    ctx
    state
    env
    type-env
    lane-locals
    (lower-masked-vector-lane-locals-from-set lane-locals lanes)
    index
    index-var
    active-mask
    lanes
    (& params)
    (& args)
    0))

(define (lower-avx512-spmd-call-args-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [analysis-locals : lower_i64_i64_map.Map]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]) : ResultLowerSpmdCallArgs
  (cond
    [(and
        (>= arg-index (ast.ast-param-list-len params))
        (>= arg-index (struct-get args len)))
      (ResultLowerSpmdCallArgs.Ok state ir.CompilerIrSpmdCallArgList.Nil false)]
    [(or
        (>= arg-index (ast.ast-param-list-len params))
        (>= arg-index (struct-get args len)))
      (ResultLowerSpmdCallArgs.Err
        (box (lower-diagnostic "lower: SPMD helper call arity mismatch")))]
    [else
      (match (ast.ast-param-list-get params arg-index (ast.ast-param-fallback))
        [(ast.AstParam.Param _ param-ty _ _)
          (let
            [arg : ast.AstExpr
              (lower-context-expr-get
                ctx
                (ast.ast-expr-list-get args arg-index 0))]
            [resolved-ty : ast.AstType
              (tc_core.tc-type-without-regions
                (tc_core.tc-resolve-type ctx param-ty))]
            [arg-lanes : i64
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                (lower-state-mode state)
                env
                type-env
                index
                analysis-locals
                arg)]
            [varying : bool (> arg-lanes 0)]
            (if (< arg-lanes 0)
              (ResultLowerSpmdCallArgs.Err
                (box
                  (lower-diagnostic-at-expr
                    arg
                    "lower: unsupported SPMD helper argument expression")))
              (match (if varying
                (lower-avx512-masked-expr-expected
                  ctx
                  state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lanes
                  arg
                  resolved-ty)
                (lower-expr-expected ctx state env type-env arg resolved-ty arg))
                [(ResultLowerExpr.Ok lowered)
                  (match lowered
                    [(LowerExpr.Expr arg-state arg-value _)
                      (match (lower-avx512-spmd-call-args-at
                        ctx
                        arg-state
                        env
                        type-env
                        lane-locals
                        analysis-locals
                        index
                        index-var
                        active-mask
                        lanes
                        params
                        args
                        (+ arg-index 1))
                        [(ResultLowerSpmdCallArgs.Ok
                            rest-state
                            rest-args
                            rest-varying)
                          (ResultLowerSpmdCallArgs.Ok
                            rest-state
                            (ir.ir-spmd-call-arg-cons
                              (ir.CompilerIrSpmdCallArg.Arg
                                (lower-spmd-ir-value-class resolved-ty varying)
                                arg-value
                                resolved-ty)
                              rest-args)
                            (or varying rest-varying))]
                        [(ResultLowerSpmdCallArgs.Err message)
                          (ResultLowerSpmdCallArgs.Err message)])])]
                [(ResultLowerExpr.Err message)
                  (ResultLowerSpmdCallArgs.Err message)])))])]))

(define (lower-spmd-call-lane-locals
  [params : ast.AstParamList]
  [args : ir.CompilerIrSpmdCallArgList]) : LowerIdSet
  (lower-spmd-call-lane-locals-at (& params) args 0 (lower-id-set-empty)))

(define (lower-spmd-call-lane-locals-at
  [params : (& params ast.AstParamList)]
  [args : ir.CompilerIrSpmdCallArgList]
  [index : i64]
  [out : LowerIdSet]) : LowerIdSet
  (if (>= index (ast.ast-param-list-len params))
    out
    (match args
      [(ir.CompilerIrSpmdCallArgList.Array seq)
        (lower-spmd-call-lane-locals-seq-at params seq index out)]
      [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
        (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
          [(ast.AstParam.Param name _ _ _)
            (match arg
              [(ir.CompilerIrSpmdCallArg.Arg class _ _)
                (lower-spmd-call-lane-locals-at
                  params
                  (box-get rest)
                  (+ index 1)
                  (match class
                    [(ir.CompilerIrSpmdValueClass.Uniform) out]
                    [_ (lower-id-set-insert out name)]))])])]
      [(ir.CompilerIrSpmdCallArgList.Nil) out])))

(define (lower-spmd-call-lane-locals-seq-at
  [params : (& params ast.AstParamList)]
  [args : ir.CompilerIrSpmdCallArgSeq]
  [index : i64]
  [out : LowerIdSet]) : LowerIdSet
  (if (or
    (>= index (ast.ast-param-list-len params))
    (>= index (struct-get args len)))
    out
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name _ _ _)
        (match (array-ref (struct-get args slots) index)
          [(ir.CompilerIrSpmdCallArg.Arg class _ _)
            (lower-spmd-call-lane-locals-seq-at
              params
              args
              (+ index 1)
              (match class
                [(ir.CompilerIrSpmdValueClass.Uniform) out]
                [_ (lower-id-set-insert out name)]))])])))

(define (lower-spmd-source-param-types-at
  [params : (& params ast.AstParamList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : unit
  (if (>= index (ast.ast-param-list-len params))
    unit
    (begin
      (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
        [(ast.AstParam.Param _ ty _ consume?)
          (ast.ast-type-list-push
            out
            (ast.ast-node-pool-reader-type-push
              (if consume?
                (ast.ast-ty-consume ty)
                ty)))])
      (lower-spmd-source-param-types-at params (+ index 1) out))))

(define (lower-spmd-source-signature
  [params : ast.AstParamList]
  [ret : ast.AstType]) : String
  (let
    [types : ast.AstTypeList
      (ast.ast-type-list-with-capacity (ast.ast-param-list-len (& params)))]
    (begin
      (lower-spmd-source-param-types-at (& params) 0 (&mut types))
      (tc_core.tc-type-render (ast.ast-ty-func types ret)))))

(define (lower-imported-spmd-params-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [out : (&mut out ast.AstParamList)]) : unit
  (if (>= index (ast.ast-type-list-len types))
    unit
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (begin
        (match ty
          [(ast.AstType.Consume inner)
            (ast.ast-param-list-push
              out
              (ast.AstParam.Param
                cbi.compiler-builtin-id-fix-empty
                (tc_core.tc-context-type-get ctx inner)
                false
                true))]
          [_
            (ast.ast-param-list-push
              out
              (ast.AstParam.Param
                cbi.compiler-builtin-id-fix-empty
                ty
                false
                false))])
        (lower-imported-spmd-params-at ctx types (+ index 1) out)))))

(define (lower-imported-spmd-params
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : ast.AstParamList
  (let
    [out : ast.AstParamList
      (ast.ast-param-list-with-capacity (ast.ast-type-list-len (& types)))]
    (begin
      (lower-imported-spmd-params-at ctx (& types) 0 (&mut out))
      out)))

(define (lower-imported-spmd-call-arg-code [arg : ir.CompilerIrSpmdCallArg]) : String
  (match arg
    [(ir.CompilerIrSpmdCallArg.Arg class _ _)
      (match class
        [(ir.CompilerIrSpmdValueClass.Uniform) "u"]
        [_ "v"])]))

(define (lower-imported-spmd-call-args-code-at
  [args : ir.CompilerIrSpmdCallArgList]
  [index : i64]
  [count : i64]) : String
  (if (>= index count)
    ""
    (str_cat.str-cat
      (lower-imported-spmd-call-arg-code (lower-spmd-call-arg-at args index))
      (lower-imported-spmd-call-args-code-at args (+ index 1) count))))

(define (lower-imported-spmd-call-args-code
  [args : ir.CompilerIrSpmdCallArgList]) : String
  (lower-imported-spmd-call-args-code-at
    args
    0
    (ir.compiler-ir-spmd-call-arg-count args)))

;; TLCI records the final archive/link name, while existing `SpmdCall` IR
;; carries a logical TypeLisp name that the backend decorates with `_tl_`.
;; Private ABI v1 symbols are generated by that backend rule, so remove its
;; prefix exactly once before reusing the established IR.
(define (lower-imported-spmd-ir-symbol
  [item : ast.AstImportedSpmdSpecialization]) : i64
  (let
    [link-symbol-id : i64 (struct-get item symbol)]
    [link-symbol : String (ci.intern-str link-symbol-id)]
    [link-symbol-len : i64 (string.string-length link-symbol)]
    (if (and
      (> link-symbol-len 4)
      (lower-string-prefix-at? link-symbol "_tl_" 0))
      (ci.intern-generated-canonical-name
        (string.substring link-symbol 4 (- link-symbol-len 4)))
      link-symbol-id)))

(define (lower-imported-spmd-backend-name [backend : ir.CompilerIrSpmdBackend]) : String
  (match backend
    [(ir.CompilerIrSpmdBackend.Scalar) "scalar"]
    [(ir.CompilerIrSpmdBackend.Avx2) "avx2"]
    [(ir.CompilerIrSpmdBackend.Avx512) "avx512"]))

(define (lower-imported-spmd-specialization-key-matches?
  [item : ast.AstImportedSpmdSpecialization]
  [backend : String]
  [lanes : i64]
  [args-code : String]
  [index-param : i64]) : bool
  (and
    (string.eq (ci.intern-str (struct-get item backend)) backend)
    (= (struct-get item lanes) lanes)
    (string.eq (ci.intern-str (struct-get item args)) args-code)
    (= (struct-get item index-param) index-param)))

(define (lower-imported-spmd-result-compatible?
  [item : ast.AstImportedSpmdSpecialization]
  [ret : ast.AstType]) : bool
  (let
    [result : String (ci.intern-str (struct-get item result))]
    (if (tc_core.tc-type-eq
      (tc_core.tc-type-without-regions ret)
      (ast.AstType.Unit))
      (string.eq result "unit")
      (or (string.eq result "u") (string.eq result "v")))))

(define (lower-imported-spmd-selection-error
  [origin : ast.AstExpr]
  [canonical-name : String]
  [message : String]) : ResultLowerImportedSpmdSpecialization
  (ResultLowerImportedSpmdSpecialization.Err
    (box
      (lower-diagnostic-at-expr
        origin
        (str_cat.str-cat
          "lower: imported SPMD helper `"
          canonical-name
          "` "
          message)))))

(define (lower-imported-spmd-selection-scan-new) : LowerImportedSpmdSelectionScan
  (LowerImportedSpmdSelectionScan
    0
    0
    -1
    -1
    0
    (ast.ast-imported-spmd-specialization-fallback)))

(define (lower-imported-spmd-selection-scan-specializations-at
  [specializations : (& specializations ast.AstImportedSpmdSpecializationList)]
  [index : i64]
  [backend-name : String]
  [lanes : i64]
  [args-code : String]
  [requested-index-param : i64]
  [ret : ast.AstType]
  [scan : LowerImportedSpmdSelectionScan]) : LowerImportedSpmdSelectionScan
  (if (>= index (ast.ast-imported-spmd-specialization-list-len specializations))
    scan
    (let
      [item : ast.AstImportedSpmdSpecialization
        (ast.ast-imported-spmd-specialization-list-get
          specializations
          index
          (ast.ast-imported-spmd-specialization-fallback))]
      [abi-id : i64 (struct-get item abi)]
      [abi : String (ci.intern-str abi-id)]
      [key-matches : bool
        (and
          (lower-imported-spmd-specialization-key-matches?
            item
            backend-name
            lanes
            args-code
            requested-index-param)
          (lower-imported-spmd-result-compatible? item ret))]
      [next : LowerImportedSpmdSelectionScan
        (if (string.eq abi "spmd-call-v1")
          (LowerImportedSpmdSelectionScan
            (struct-get scan signature-count)
            (+ (struct-get scan supported-abi-count) 1)
            (struct-get scan unsupported-abi-id)
            (struct-get scan unsupported-key-abi-id)
            (if key-matches
              (+ (struct-get scan selected-count) 1)
              (struct-get scan selected-count))
            (if key-matches
              item
              (struct-get scan selected)))
          (LowerImportedSpmdSelectionScan
            (struct-get scan signature-count)
            (struct-get scan supported-abi-count)
            (if (< (struct-get scan unsupported-abi-id) 0)
              abi-id
              (struct-get scan unsupported-abi-id))
            (if (and key-matches (< (struct-get scan unsupported-key-abi-id) 0))
              abi-id
              (struct-get scan unsupported-key-abi-id))
            (struct-get scan selected-count)
            (struct-get scan selected)))]
      (lower-imported-spmd-selection-scan-specializations-at
        specializations
        (+ index 1)
        backend-name
        lanes
        args-code
        requested-index-param
        ret
        next))))

(define (lower-imported-spmd-selection-scan-callables-at
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [index : i64]
  [signature : String]
  [backend-name : String]
  [lanes : i64]
  [args-code : String]
  [requested-index-param : i64]
  [ret : ast.AstType]
  [scan : LowerImportedSpmdSelectionScan]) : LowerImportedSpmdSelectionScan
  (if (>= index (ast.ast-imported-spmd-callable-list-len callables))
    scan
    (let
      [callable : ast.AstImportedSpmdCallable
        (ast.ast-imported-spmd-callable-list-get
          callables
          index
          (ast.ast-imported-spmd-callable-fallback))]
      [matches-signature : bool
        (string.eq (ci.intern-str (struct-get callable signature)) signature)]
      [signature-scan : LowerImportedSpmdSelectionScan
        (if matches-signature
          (LowerImportedSpmdSelectionScan
            (+ (struct-get scan signature-count) 1)
            (struct-get scan supported-abi-count)
            (struct-get scan unsupported-abi-id)
            (struct-get scan unsupported-key-abi-id)
            (struct-get scan selected-count)
            (struct-get scan selected))
          scan)]
      [specializations : ast.AstImportedSpmdSpecializationList
        (struct-get callable specializations)]
      [next : LowerImportedSpmdSelectionScan
        (if matches-signature
          (lower-imported-spmd-selection-scan-specializations-at
            (& specializations)
            0
            backend-name
            lanes
            args-code
            requested-index-param
            ret
            signature-scan)
          signature-scan)]
      (lower-imported-spmd-selection-scan-callables-at
        callables
        (+ index 1)
        signature
        backend-name
        lanes
        args-code
        requested-index-param
        ret
        next))))

(define (lower-imported-spmd-select
  [canonical-name-id : i64]
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [signature : String]
  [backend : ir.CompilerIrSpmdBackend]
  [lanes : i64]
  [args-code : String]
  [requested-index-param : i64]
  [ret : ast.AstType]
  [origin : ast.AstExpr]) : ResultLowerImportedSpmdSpecialization
  (let
    [canonical-name : String (ci.intern-str canonical-name-id)]
    [backend-name : String (lower-imported-spmd-backend-name backend)]
    [callable-count : i64 (ast.ast-imported-spmd-callable-list-len callables)]
    [scan : LowerImportedSpmdSelectionScan
      (lower-imported-spmd-selection-scan-callables-at
        callables
        0
        signature
        backend-name
        lanes
        args-code
        requested-index-param
        ret
        (lower-imported-spmd-selection-scan-new))]
    (cond
      [(= callable-count 0)
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          "has no TLCI callable metadata")]
      [(= (struct-get scan signature-count) 0)
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          (str_cat.str-cat
            "ordinary signature mismatch; consumer resolved "
            signature))]
      [(= (struct-get scan selected-count) 1)
        (ResultLowerImportedSpmdSpecialization.Ok (struct-get scan selected))]
      [(> (struct-get scan selected-count) 1)
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          (str_cat.str-cat
            "has duplicate TLCI specializations for the requested key (backend="
            backend-name
            ", lanes="
            (string.int->string lanes)
            ", args="
            args-code
            ", index-param="
            (string.int->string requested-index-param)
            ")"))]
      [(>= (struct-get scan unsupported-key-abi-id) 0)
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          (str_cat.str-cat
            "uses unsupported private ABI `"
            (ci.intern-str (struct-get scan unsupported-key-abi-id))
            "`"))]
      [(and
          (= (struct-get scan supported-abi-count) 0)
          (>= (struct-get scan unsupported-abi-id) 0))
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          (str_cat.str-cat
            "has no supported private ABI; first advertised ABI is `"
            (ci.intern-str (struct-get scan unsupported-abi-id))
            "`"))]
      [(string.eq backend-name "avx2")
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          "is not supported in AVX2 backend mode")]
      [else
        (lower-imported-spmd-selection-error
          origin
          canonical-name
          (str_cat.str-cat
            "has no requested specialization (backend="
            backend-name
            ", lanes="
            (string.int->string lanes)
            ", args="
            args-code
            ", index-param="
            (string.int->string requested-index-param)
            ")"))])))

(define (lower-imported-spmd-result-varying?
  [item : ast.AstImportedSpmdSpecialization]) : bool
  (string.eq (ci.intern-str (struct-get item result)) "v"))

(define (lower-imported-spmd-index-param-at
  [ctx : tc_core.TcContext]
  [index-name : String]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]) : i64
  (if (or
    (= (string.string-length index-name) 0)
    (>= arg-index (struct-get args len)))
    -1
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get args arg-index 0))]
      (if (= (lower-masked-vector-index-offset ctx index-name arg) 0)
        arg-index
        (lower-imported-spmd-index-param-at ctx index-name args (+ arg-index 1))))))

(define (lower-imported-spmd-index-param
  [ctx : tc_core.TcContext]
  [index-name : String]
  [args : ast.AstExprList]) : i64
  (lower-imported-spmd-index-param-at ctx index-name (& args) 0))

(define (lower-spmd-ast-param-class-code [class : ast.AstSpmdParamClass]) : String
  (match class
    [(ast.AstSpmdParamClass.Uniform) "u"]
    [(ast.AstSpmdParamClass.Varying) "v"]))

(define (lower-spmd-ast-result-class-code [class : ast.AstSpmdResultClass]) : String
  (match class
    [(ast.AstSpmdResultClass.Unit) "unit"]
    [(ast.AstSpmdResultClass.Uniform) "u"]
    [(ast.AstSpmdResultClass.Varying) "v"]))

(define (lower-spmd-ast-param-classes-code-at
  [items : (& items ast.AstSpmdParamClassList)]
  [index : i64]) : String
  (if (>= index (ast.ast-spmd-param-class-list-len items))
    ""
    (string.append
      (lower-spmd-ast-param-class-code
        (ast.ast-spmd-param-class-list-get
          items
          index
          ast.AstSpmdParamClass.Uniform))
      (lower-spmd-ast-param-classes-code-at items (+ index 1)))))

(define (lower-spmd-ast-param-classes-code [items : ast.AstSpmdParamClassList]) : String
  (lower-spmd-ast-param-classes-code-at (& items) 0))

(define (lower-spmd-package-backend-name [backend : ir.CompilerIrSpmdBackend]) : String
  (match backend
    [(ir.CompilerIrSpmdBackend.Scalar) "scalar"]
    [(ir.CompilerIrSpmdBackend.Avx2) "avx2"]
    [(ir.CompilerIrSpmdBackend.Avx512) "avx512"]))

(define lower-spmd-package-abi : String
  "spmd-call-v1")

(define (lower-spmd-package-symbol-identity
  [package-name : String]
  [canonical-name : String]
  [signature : String]
  [backend : ir.CompilerIrSpmdBackend]
  [lanes : i64]
  [args : String]
  [result : String]
  [index-param : i64]) : String
  (str_cat.str-cat
    package-name
    "|"
    canonical-name
    "|"
    signature
    "|"
    (lower-global-shared-view lower-spmd-package-abi)
    "|"
    (lower-spmd-package-backend-name backend)
    "|"
    (string.int->string lanes)
    "|"
    args
    "|"
    result
    "|"
    (string.int->string index-param)))

(define (lower-spmd-package-symbol
  [package-name : String]
  [canonical-name : String]
  [signature : String]
  [result-ty : ast.AstType]
  [backend : ir.CompilerIrSpmdBackend]
  [lanes : i64]
  [args : String]
  [result : String]
  [index-param : i64]) : String
  (let
    [identity : String
      (lower-spmd-package-symbol-identity
        package-name
        canonical-name
        signature
        backend
        lanes
        args
        result
        index-param)]
    [hash : i64 (stdlib.hash.string-key (& identity))]
    [stable-name : String
      (string.append "__tl_spmd_pkg_" (string.int->string hash))]
    ;; The private AVX-512 ABI is selected by the function-name prefix in the
    ;; backend.  Keep the stable package hash intact after that prefix so the
    ;; archive and TLCI still share one deterministic logical identity.
    (match backend
      [(ir.CompilerIrSpmdBackend.Avx512)
        (if (string.eq result "v")
          (if (lower-type-bool? result-ty)
            (string.append "__tl_spmd_ret_mask_" stable-name)
            (string.append "__tl_spmd_ret_varying_" stable-name))
          (string.append "__tl_spmd_ret_uniform_" stable-name))]
      [_ stable-name])))

(define (lower-spmd-package-symbol-register [symbol : i64] [identity : String]) : LowerSpmdPackageSymbolRegistration
  (let
    [identity-id : i64 (ci.intern-generated-canonical-name identity)]
    (match (lower_i64_i64_map.get
      (& lower-spmd-package-symbol-identities)
      symbol)
      [(lower_i64_i64_map.LookupFound previous)
        (if (= previous identity-id)
          LowerSpmdPackageSymbolRegistration.Existing
          (LowerSpmdPackageSymbolRegistration.Collision
            (string.append
              "lower: :spmd-callable stable symbol collision for "
              (ir.compiler-ir-symbol-text symbol))))]
      [(lower_i64_i64_map.LookupMissing)
        (begin
          (lower_i64_i64_map.insert-ref!
            (&mut lower-spmd-package-symbol-identities)
            symbol
            identity-id)
          LowerSpmdPackageSymbolRegistration.New)])))

(define (lower-spmd-package-lane-width-supported? [lanes : i64]) : bool
  (or (= lanes 8) (= lanes 16) (= lanes 32) (= lanes 64)))

(define (lower-spmd-package-call-args-at
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [classes : (& classes ast.AstSpmdParamClassList)]
  [index : i64]) : ir.CompilerIrSpmdCallArgList
  (if (>= index (ast.ast-param-list-len params))
    ir.CompilerIrSpmdCallArgList.Nil
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param _ ty _ _)
        (let
          [resolved : ast.AstType
            (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
          [class : ir.CompilerIrSpmdValueClass
            (match (ast.ast-spmd-param-class-list-get
              classes
              index
              ast.AstSpmdParamClass.Uniform)
              [(ast.AstSpmdParamClass.Uniform)
                ir.CompilerIrSpmdValueClass.Uniform]
              [(ast.AstSpmdParamClass.Varying)
                (if (lower-type-bool? resolved)
                  ir.CompilerIrSpmdValueClass.Mask
                  ir.CompilerIrSpmdValueClass.Varying)])]
          (ir.ir-spmd-call-arg-cons
            (ir.CompilerIrSpmdCallArg.Arg
              class
              ir.CompilerIrValue.Unit
              resolved)
            (lower-spmd-package-call-args-at ctx params classes (+ index 1))))])))

(define (lower-spmd-package-index-name
  [params : (& params ast.AstParamList)]
  [index : i64]) : String
  (if (< index 0)
    ""
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name _ _ _) (ci.intern-str name)])))

(define (lower-spmd-package-index-param-i64?
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]) : bool
  (if (< index 0)
    true
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param _ ty _ _)
        (lower-type-i64?
          (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty)))])))

(define (lower-spmd-package-abi-type-supported? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(ast.AstType.I64) true]
    [(ast.AstType.U64) true]
    [(ast.AstType.F64) true]
    [(ast.AstType.F32) true]
    [(ast.AstType.I32) true]
    [(ast.AstType.U32) true]
    [(ast.AstType.I16) true]
    [(ast.AstType.U16) true]
    [(ast.AstType.I8) true]
    [(ast.AstType.U8) true]
    [(ast.AstType.Bool) true]
    [(ast.AstType.Unit) true]
    [_ false]))

(define (lower-spmd-package-param-validation-error-at
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [classes : (& classes ast.AstSpmdParamClassList)]
  [lanes : i64]
  [index : i64]) : String
  (if (>= index (ast.ast-param-list-len params))
    ""
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param _ ty _ _)
        (let
          [resolved : ast.AstType
            (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
          [class : ast.AstSpmdParamClass
            (ast.ast-spmd-param-class-list-get
              classes
              index
              ast.AstSpmdParamClass.Uniform)]
          (cond
            [(not (lower-spmd-package-abi-type-supported? resolved))
              "lower: :spmd-callable parameter type is not supported by private ABI v1"]
            [(and
                (match class
                  [(ast.AstSpmdParamClass.Varying) true]
                  [_ false])
                (not (lower-type-bool? resolved))
                (not
                  (=
                    (lower-simd-lanes-for-elem
                      (CompilerLowerMode.Avx512)
                      resolved)
                    lanes)))
              "lower: :spmd-callable lane width does not match varying parameter type"]
            [else
              (lower-spmd-package-param-validation-error-at
                ctx
                params
                classes
                lanes
                (+ index 1))]))])))

(define (lower-spmd-package-specialization-validation-error
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [specialization : ast.AstSpmdSpecialization]) : String
  (let
    [classes : ast.AstSpmdParamClassList
      (box-get (struct-get specialization args))]
    [index-param : i64 (struct-get specialization index-param)]
    [call-args : ir.CompilerIrSpmdCallArgList
      (lower-spmd-package-call-args-at ctx (& params) (& classes) 0)]
    [index-name : String (lower-spmd-package-index-name (& params) index-param)]
    [ret-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret))]
    [param-error : String
      (lower-spmd-package-param-validation-error-at
        ctx
        (& params)
        (& classes)
        (struct-get specialization lanes)
        0)]
    [env : sym_i64_env.SymI64Env
      (lower-bind-params params 1 (sym_i64_env.sym-i64-empty))]
    [type-env : tc_core.TcTypeEnv
      (tc_core.tc-bind-return-type
        (tc_core.tc-bind-params
          ctx
          (tc_core.tc-hygiene-global-env top-env)
          params)
        ret-ty)]
    [_recursion-reset : unit (set! lower-spmd-inline-recursion-detected false)]
    [body-lanes : i64
      (lower-masked-vector-expr-lanes-with-locals
        ctx
        (CompilerLowerMode.Avx512)
        env
        type-env
        index-name
        (lower-masked-vector-lane-locals-from-set
          (lower-spmd-call-lane-locals params call-args)
          (struct-get specialization lanes))
        body)]
    (cond
      [(not
          (lower-spmd-package-lane-width-supported?
            (struct-get specialization lanes)))
        "lower: :spmd-callable lane width is not supported by private ABI v1"]
      [(not (string.eq param-error "")) param-error]
      [(not (lower-spmd-package-abi-type-supported? ret-ty))
        "lower: :spmd-callable return type is not supported by private ABI v1"]
      [(and
          (match (struct-get specialization result)
            [(ast.AstSpmdResultClass.Varying) true]
            [_ false])
          (not (lower-type-bool? ret-ty))
          (not
            (=
              (lower-simd-lanes-for-elem (CompilerLowerMode.Avx512) ret-ty)
              (struct-get specialization lanes))))
        "lower: :spmd-callable lane width does not match varying return type"]
      [(and
          (>= index-param 0)
          (match (ast.ast-spmd-param-class-list-get
            (& classes)
            index-param
            ast.AstSpmdParamClass.Uniform)
            [(ast.AstSpmdParamClass.Varying) false]
            [_ true]))
        "lower: :spmd-callable index-param must name a varying argument"]
      [(not (lower-spmd-package-index-param-i64? ctx (& params) index-param))
        "lower: :spmd-callable index-param must name an i64 parameter"]
      [lower-spmd-inline-recursion-detected
        (lower-spmd-inline-recursive-message)]
      [(< body-lanes 0)
        "lower: :spmd-callable body does not support SPMD specialization"]
      [(tc_core.tc-type-eq ret-ty (ast.AstType.Unit))
        (match (struct-get specialization result)
          [(ast.AstSpmdResultClass.Unit) ""]
          [_ "lower: :spmd-callable unit return requires result unit"])]
      [(match (struct-get specialization result)
          [(ast.AstSpmdResultClass.Unit) true]
          [_ false])
        "lower: :spmd-callable non-unit return cannot use result unit"]
      [(and
          (> body-lanes 0)
          (match (struct-get specialization result)
            [(ast.AstSpmdResultClass.Varying) false]
            [_ true]))
        "lower: :spmd-callable varying body requires result varying"]
      [(and
          (= body-lanes 0)
          (match (struct-get specialization result)
            [(ast.AstSpmdResultClass.Uniform) false]
            [_ true]))
        "lower: :spmd-callable uniform body requires result uniform"]
      [else ""])))

;; Private SIMD helpers keep source types on their parameters, so preserve
;; the SPMD value class in the otherwise-internal parameter name.  The backend
;; and register planner use these prefixes to select the private vector/mask
;; ABI without exposing a vector type in the source type system.
(define (lower-spmd-private-param-name
  [name : i64]
  [class : ir.CompilerIrSpmdValueClass]
  [mode : CompilerLowerMode]) : String
  (match class
    [(ir.CompilerIrSpmdValueClass.Uniform) (tc_core.tc-env-key-name-text name)]
    [(ir.CompilerIrSpmdValueClass.Varying)
      (if (lower-mode-avx2? mode)
        (string.append
          "__tl_spmd_varying_arg_avx2_"
          (tc_core.tc-env-key-name-text name))
        (string.append
          "__tl_spmd_varying_arg_"
          (tc_core.tc-env-key-name-text name)))]
    [(ir.CompilerIrSpmdValueClass.Mask)
      (if (lower-mode-avx2? mode)
        (string.append
          "__tl_spmd_mask_arg_avx2_"
          (tc_core.tc-env-key-name-text name))
        (string.append
          "__tl_spmd_mask_arg_"
          (tc_core.tc-env-key-name-text name)))]))

(define (lower-spmd-call-arg-at
  [args : ir.CompilerIrSpmdCallArgList]
  [index : i64]) : ir.CompilerIrSpmdCallArg
  (match args
    [(ir.CompilerIrSpmdCallArgList.Nil)
      (ir.CompilerIrSpmdCallArg.Arg
        (ir.CompilerIrSpmdValueClass.Uniform)
        ir.CompilerIrValue.Unit
        (ast.AstType.Unit))]
    [(ir.CompilerIrSpmdCallArgList.Array seq)
      (if (and (>= index 0) (< index (struct-get seq len)))
        (array-ref (struct-get seq slots) index)
        (ir.CompilerIrSpmdCallArg.Arg
          (ir.CompilerIrSpmdValueClass.Uniform)
          ir.CompilerIrValue.Unit
          (ast.AstType.Unit)))]
    [(ir.CompilerIrSpmdCallArgList.Cons arg rest)
      (if (= index 0)
        arg
        (lower-spmd-call-arg-at (box-get rest) (- index 1)))]))

(define (lower-spmd-private-param-list
  [ctx : tc_core.TcContext]
  [params : ast.AstParamList]
  [args : ir.CompilerIrSpmdCallArgList]
  [mode : CompilerLowerMode]
  [idx : i64]) : ir.CompilerIrParamList
  (lower-spmd-private-param-list-at ctx (& params) args mode 0 idx))

(define (lower-spmd-private-param-list-at
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [args : ir.CompilerIrSpmdCallArgList]
  [mode : CompilerLowerMode]
  [index : i64]
  [idx : i64]) : ir.CompilerIrParamList
  (if (>= index (ast.ast-param-list-len params))
    ir.CompilerIrParamList.Nil
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name ty _ _)
        (match (lower-spmd-call-arg-at args index)
          [(ir.CompilerIrSpmdCallArg.Arg class _ _)
            (ir.compiler-ir-param-cons
              (ir.CompilerIrParam.Param
                (lower-spmd-private-param-name name class mode)
                (lower-one-word-register-storage-type
                  ctx
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type ctx ty)))
                idx)
              (lower-spmd-private-param-list-at
                ctx
                params
                args
                mode
                (+ index 1)
                (+ idx 1)))])])))

(define (lower-spmd-private-helper-name
  [hidden-name : i64]
  [result-ty : ast.AstType]
  [result-varying : bool]) : i64
  (let
    [hidden-text : String (ir.compiler-ir-symbol-text hidden-name)]
    [private-name : String
      (if result-varying
        (if (lower-type-bool? result-ty)
          (string.append "__tl_spmd_ret_mask_" hidden-text)
          (string.append "__tl_spmd_ret_varying_" hidden-text))
        (string.append "__tl_spmd_ret_uniform_" hidden-text))]
    (ci.intern-generated-canonical-name private-name)))

(define (lower-spmd-helper-index-param-at
  [ctx : tc_core.TcContext]
  [index-name : String]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]) : String
  (if (or
    (= (string.string-length index-name) 0)
    (>= arg-index (ast.ast-param-list-len params))
    (>= arg-index (struct-get args len)))
    ""
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get args arg-index 0))]
      (if (= (lower-masked-vector-index-offset ctx index-name arg) 0)
        (match (ast.ast-param-list-get
          params
          arg-index
          (ast.ast-param-fallback))
          [(ast.AstParam.Param param-name _ _ _)
            (tc_core.tc-env-key-name-text param-name)])
        (lower-spmd-helper-index-param-at
          ctx
          index-name
          params
          args
          (+ arg-index 1))))))

(define (lower-spmd-helper-index-param
  [ctx : tc_core.TcContext]
  [index-name : String]
  [params : ast.AstParamList]
  [args : ast.AstExprList]) : String
  (lower-spmd-helper-index-param-at ctx index-name (& params) (& args) 0))

(define (lower-spmd-call-args-copy-from
  [args : ir.CompilerIrSpmdCallArgList]
  [index : i64]
  [extra : ir.CompilerIrSpmdCallArg]) : ir.CompilerIrSpmdCallArgList
  (if (>= index (ir.compiler-ir-spmd-call-arg-count args))
    (ir.ir-spmd-call-arg-cons extra ir.CompilerIrSpmdCallArgList.Nil)
    (ir.ir-spmd-call-arg-cons
      (lower-spmd-call-arg-at args index)
      (lower-spmd-call-args-copy-from args (+ index 1) extra))))

(define (lower-spmd-call-args-append
  [args : ir.CompilerIrSpmdCallArgList]
  [extra : ir.CompilerIrSpmdCallArg]) : ir.CompilerIrSpmdCallArgList
  (lower-spmd-call-args-copy-from args 0 extra))

(define (lower-spmd-private-param-list-append-index
  [params : ir.CompilerIrParamList]
  [var-id : i64]) : ir.CompilerIrParamList
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil)
      (ir.compiler-ir-param-cons
        (ir.CompilerIrParam.Param
          "__tl_spmd_index_base"
          (ast.AstType.I64)
          var-id)
        ir.CompilerIrParamList.Nil)]
    [(ir.CompilerIrParamList.Array seq)
      (lower-spmd-private-param-list-append-index
        (ir.compiler-ir-param-seq-to-list seq)
        var-id)]
    [(ir.CompilerIrParamList.Cons head rest)
      (ir.compiler-ir-param-cons
        head
        (lower-spmd-private-param-list-append-index (box-get rest) var-id))]))

(define (lower-spmd-simd-helper-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [hidden-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [result-varying : bool]
  [body : ast.AstExpr]
  [call-args : ir.CompilerIrSpmdCallArgList]
  [lanes : i64]
  [helper-index : String]
  [helper-index-source-param : i64]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [source-param-count : i64 (+ 1 (lower-param-count params))]
    [param-count : i64
      (if (or
        (= (string.string-length helper-index) 0)
        (>= helper-index-source-param 0))
        source-param-count
        (+ source-param-count 1))]
    [ret-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret))]
    [function-spans : ir.CompilerSourceSpans
      (lower-record-function-span
        spans
        (ir.compiler-ir-symbol-typed-id hidden-name)
        body)]
    [state : LowerState
      (lower-state-new
        param-count
        0
        0
        (ir.compiler-ir-label "entry")
        (ir.compiler-ir-instr-builder-new)
        (ir.compiler-ir-block-builder-new)
        (ir.compiler-ir-function-builder-new)
        hidden-name
        (box function-spans)
        names
        type-cache
        mode
        (lower_i64_i64_map.with-capacity 8)
        1
        param-count)]
    [env : sym_i64_env.SymI64Env
      (lower-bind-params params 1 (sym_i64_env.sym-i64-empty))]
    [type-env : tc_core.TcTypeEnv
      (tc_core.tc-bind-return-type
        (tc_core.tc-bind-params
          ctx
          (tc_core.tc-hygiene-global-env top-env)
          params)
        ret-ty)]
    (match (lower-avx512-masked-expr-expected
      ctx
      state
      env
      type-env
      (lower-spmd-call-lane-locals params call-args)
      helper-index
      (if (= (string.string-length helper-index) 0)
        (- 0 1)
        (if (>= helper-index-source-param 0)
          (+ helper-index-source-param 1)
          source-param-count))
      (ir.CompilerIrMaybeValue.Some (ir.CompilerIrValue.Var 0))
      lanes
      body
      ret-ty)
      [(ResultLowerExpr.Ok lowered)
        (match lowered
          [(LowerExpr.Expr body-state value _)
            (let
              [return-expr
                : LowerExpr
                ;; Masked lowering represents a uniform result as identical
                ;; lanes; the private uniform ABI returns one scalar value.
                (cond
                  [(or
                      result-varying
                      (tc_core.tc-type-eq ret-ty (ast.AstType.Unit)))
                    lowered]
                  [(lower-type-bool? ret-ty)
                    (lower-emit-mask-reduce
                      body-state
                      (ir.CompilerIrMaskReduceOp.Any)
                      value
                      lanes)]
                  [else
                    (lower-emit-vector-reduce
                      body-state
                      (ir.CompilerIrVectorReduceOp.Min)
                      value
                      lanes
                      ret-ty)])]
              [return-state : LowerState
                (match return-expr
                  [(LowerExpr.Expr next-state _ _) next-state])]
              [return-value : ir.CompilerIrValue
                (match return-expr
                  [(LowerExpr.Expr _ next-value _) next-value])]
              [final-state : LowerState
                (lower-state-emit
                  return-state
                  (ir.CompilerIrInstr.Return
                    (if (tc_core.tc-type-eq ret-ty (ast.AstType.Unit))
                      (ir.CompilerIrMaybeValue.No)
                      (ir.CompilerIrMaybeValue.Some return-value))))]
              (ResultLowerFunction.Ok
                (lower-state-build-functions-with
                  final-state
                  (ir.CompilerIrFunction.Function
                    hidden-name
                    (ir.compiler-ir-param-cons
                      (ir.CompilerIrParam.Param
                        (if (lower-mode-avx2? mode)
                          "__tl_spmd_active_mask_avx2"
                          "__tl_spmd_active_mask")
                        (ast.AstType.Bool)
                        0)
                      (let
                        [source-params : ir.CompilerIrParamList
                          (lower-spmd-private-param-list
                            ctx
                            params
                            call-args
                            mode
                            1)]
                        (if (or
                          (= (string.string-length helper-index) 0)
                          (>= helper-index-source-param 0))
                          source-params
                          (lower-spmd-private-param-list-append-index
                            source-params
                            source-param-count))))
                    ret-ty
                    (lower-state-next-var final-state)
                    (lower-state-build-function-blocks final-state)))
                (lower-state-spans final-state)))])]
      [(ResultLowerExpr.Err message) (ResultLowerFunction.Err message)])))

(define (lower-spmd-scalar-helper-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [hidden-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [param-count : i64 (+ 1 (lower-param-count params))]
    [ret-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret))]
    [function-spans : ir.CompilerSourceSpans
      (lower-record-function-span
        spans
        (ir.compiler-ir-symbol-typed-id hidden-name)
        body)]
    [state : LowerState
      (lower-state-new
        param-count
        0
        0
        (ir.compiler-ir-label "entry")
        (ir.compiler-ir-instr-builder-new)
        (ir.compiler-ir-block-builder-new)
        (ir.compiler-ir-function-builder-new)
        hidden-name
        (box function-spans)
        names
        type-cache
        mode
        (lower_i64_i64_map.with-capacity 8)
        1
        param-count)]
    [env : sym_i64_env.SymI64Env
      (lower-bind-params params 1 (sym_i64_env.sym-i64-empty))]
    [type-env : tc_core.TcTypeEnv
      (tc_core.tc-bind-return-type
        (tc_core.tc-bind-params
          ctx
          (tc_core.tc-hygiene-global-env top-env)
          params)
        ret-ty)]
    (match (lower-tail-expr ctx state env type-env body ret-ty (- 0 1))
      [(ResultLowerState.Ok final-state)
        (ResultLowerFunction.Ok
          (lower-state-build-functions-with
            final-state
            (ir.CompilerIrFunction.Function
              hidden-name
              (ir.compiler-ir-param-cons
                (ir.CompilerIrParam.Param
                  "__tl_spmd_active_mask"
                  (ast.AstType.Bool)
                  0)
                (lower-param-list ctx params 1))
              ret-ty
              (lower-state-next-var final-state)
              (lower-state-build-function-blocks final-state)))
          (lower-state-spans final-state))]
      [(ResultLowerState.Err message) (ResultLowerFunction.Err message)])))

(define (lower-spmd-specialized-helper-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [hidden-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [result-varying : bool]
  [body : ast.AstExpr]
  [backend : ir.CompilerIrSpmdBackend]
  [call-args : ir.CompilerIrSpmdCallArgList]
  [lanes : i64]
  [helper-index : String]
  [helper-index-source-param : i64]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match backend
    [(ir.CompilerIrSpmdBackend.Scalar)
      (lower-spmd-scalar-helper-function
        ctx
        top-env
        type-cache
        hidden-name
        params
        ret
        body
        spans
        names
        mode)]
    [(ir.CompilerIrSpmdBackend.Avx512)
      (lower-spmd-simd-helper-function
        ctx
        top-env
        type-cache
        hidden-name
        params
        ret
        result-varying
        body
        call-args
        lanes
        helper-index
        helper-index-source-param
        spans
        names
        mode)]
    [(ir.CompilerIrSpmdBackend.Avx2)
      (lower-spmd-simd-helper-function
        ctx
        top-env
        type-cache
        hidden-name
        params
        ret
        result-varying
        body
        call-args
        lanes
        helper-index
        helper-index-source-param
        spans
        names
        mode)]))

(define (lower-spmd-package-specialization-function-active
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [specialization : ast.AstSpmdSpecialization]
  [backend : ir.CompilerIrSpmdBackend]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [validation-error : String
      (lower-spmd-package-specialization-validation-error
        ctx
        top-env
        params
        ret
        body
        specialization)]
    (if (not (string.eq validation-error ""))
      (ResultLowerFunction.Err (box (lower-diagnostic validation-error)))
      (let
        [classes : ast.AstSpmdParamClassList
          (box-get (struct-get specialization args))]
        [args-code : String (lower-spmd-ast-param-classes-code classes)]
        [result-code : String
          (lower-spmd-ast-result-class-code (struct-get specialization result))]
        [signature : String (lower-spmd-source-signature params ret)]
        [lanes : i64
          (match backend
            [(ir.CompilerIrSpmdBackend.Scalar) 1]
            [_ (struct-get specialization lanes)])]
        [index-param : i64 (struct-get specialization index-param)]
        [hidden-name-text : String
          (lower-spmd-package-symbol
            (lower-global-shared-view lower-spmd-package-name)
            canonical-name
            signature
            ret
            backend
            lanes
            args-code
            result-code
            index-param)]
        [hidden-name : i64
          (ci.intern-generated-canonical-name hidden-name-text)]
        [symbol-identity : String
          (lower-spmd-package-symbol-identity
            (lower-global-shared-view lower-spmd-package-name)
            canonical-name
            signature
            backend
            lanes
            args-code
            result-code
            index-param)]
        [registration : LowerSpmdPackageSymbolRegistration
          (lower-spmd-package-symbol-register hidden-name symbol-identity)]
        [call-args : ir.CompilerIrSpmdCallArgList
          (lower-spmd-package-call-args-at ctx (& params) (& classes) 0)]
        [index-name : String
          (lower-spmd-package-index-name (& params) index-param)]
        (match registration
          [(LowerSpmdPackageSymbolRegistration.Existing)
            (ResultLowerFunction.Ok ir.CompilerIrFunctionList.Nil spans)]
          [(LowerSpmdPackageSymbolRegistration.Collision collision-error)
            (ResultLowerFunction.Err (box (lower-diagnostic collision-error)))]
          [(LowerSpmdPackageSymbolRegistration.New)
            (lower-spmd-specialized-helper-function
              ctx
              top-env
              type-cache
              hidden-name
              params
              ret
              (match (struct-get specialization result)
                [(ast.AstSpmdResultClass.Varying) true]
                [_ false])
              body
              backend
              call-args
              lanes
              index-name
              index-param
              spans
              names
              mode)])))))

(define (lower-spmd-package-specialization-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [canonical-handle : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [specialization : ast.AstSpmdSpecialization]
  [backend : ir.CompilerIrSpmdBackend]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [previous : LowerIdSet
      (lower-global-shared-view lower-spmd-inline-helper-stack)]
    (begin
      (set!
        lower-spmd-inline-helper-stack
        (lower-id-set-insert previous canonical-handle))
      (let
        [result : ResultLowerFunction
          (lower-spmd-package-specialization-function-active
            ctx
            top-env
            type-cache
            canonical-name
            params
            ret
            body
            specialization
            backend
            spans
            names
            mode)]
        (begin
          (set! lower-spmd-inline-helper-stack previous)
          result)))))

(define (lower-spmd-package-specializations-from
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [canonical-handle : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [specializations : (& specializations ast.AstSpmdSpecializationList)]
  [index : i64]
  [limit : i64]
  [backend : ir.CompilerIrSpmdBackend]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]
  [functions : ir.CompilerIrFunctionBuilder (:consume)]) : ResultLowerFunction
  (if (or
    (>= index limit)
    (>= index (ast.ast-spmd-specialization-list-len specializations)))
    (ResultLowerFunction.Ok
      (ir.compiler-ir-function-builder-to-list functions)
      spans)
    (let
      [fallback : ast.AstSpmdSpecialization
        (ast.AstSpmdSpecialization
          2
          (box (ast.ast-spmd-param-class-list-new))
          ast.AstSpmdResultClass.Unit
          -1)]
      (match (lower-spmd-package-specialization-function
        ctx
        top-env
        type-cache
        canonical-name
        canonical-handle
        params
        ret
        body
        (ast.ast-spmd-specialization-list-get specializations index fallback)
        backend
        spans
        names
        mode)
        [(ResultLowerFunction.Err message) (ResultLowerFunction.Err message)]
        [(ResultLowerFunction.Ok lowered next-spans)
          (let
            [next-functions : ir.CompilerIrFunctionBuilder functions]
            (begin
              (ir.compiler-ir-function-builder-append-list!
                (&mut next-functions)
                lowered)
              (lower-spmd-package-specializations-from
                ctx
                top-env
                type-cache
                canonical-name
                canonical-handle
                params
                ret
                body
                specializations
                (+ index 1)
                limit
                backend
                next-spans
                names
                mode
                next-functions)))]))))

(define (lower-spmd-package-callable-functions
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [canonical-handle : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [callable : ast.AstSpmdCallable]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match callable
    [(ast.AstSpmdCallable.No)
      (ResultLowerFunction.Ok ir.CompilerIrFunctionList.Nil spans)]
    [(ast.AstSpmdCallable.Callable specializations)
      (if (= (string.string-length lower-spmd-package-name) 0)
        (ResultLowerFunction.Err
          (box
            (lower-diagnostic
              "lower: :spmd-callable is only supported while building a package")))
        (if (lower-mode-avx2? mode)
          (ResultLowerFunction.Err
            (box
              (lower-diagnostic
                "lower: :spmd-callable is not supported in AVX2 backend mode; use scalar or avx512")))
          (let
            [backend : ir.CompilerIrSpmdBackend
              (if (lower-mode-avx512? mode)
                ir.CompilerIrSpmdBackend.Avx512
                ir.CompilerIrSpmdBackend.Scalar)]
            [count : i64
              (ast.ast-spmd-specialization-list-len (& specializations))]
            (lower-spmd-package-specializations-from
              ctx
              top-env
              type-cache
              canonical-name
              canonical-handle
              params
              ret
              body
              (& specializations)
              0
              count
              backend
              spans
              names
              mode
              (ir.compiler-ir-function-builder-with-capacity count)))))]))

(define (lower-avx512-emit-spmd-call
  [state : LowerState (:consume)]
  [hidden-name : i64]
  [backend : ir.CompilerIrSpmdBackend]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [call-args : ir.CompilerIrSpmdCallArgList]
  [result-ty : ast.AstType]
  [result-varying : bool]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (if (tc_core.tc-type-eq result-ty (ast.AstType.Unit))
    (let
      [instr : ir.CompilerIrInstr
        (ir.ir-instr-spmd-call
          hidden-name
          backend
          lanes
          active-mask
          call-args
          (ir.CompilerIrSpmdCallResult.Unit))]
      (ResultLowerExpr.Ok
        (LowerExpr.Expr
          (lower-state-emit-at-expr state instr expr)
          ir.CompilerIrValue.Unit
          result-ty)))
    (match (lower-state-alloc-var state)
      [(LowerAlloc.Alloc allocated result-var)
        (let
          [result-class : ir.CompilerIrSpmdValueClass
            (lower-spmd-ir-value-class result-ty result-varying)]
          [instr : ir.CompilerIrInstr
            (ir.ir-instr-spmd-call
              hidden-name
              backend
              lanes
              active-mask
              call-args
              (ir.CompilerIrSpmdCallResult.Value
                result-var
                result-class
                result-ty))]
          [call-state : LowerState
            (lower-state-emit-at-expr allocated instr expr)]
          (if (or
            result-varying
            (match backend
              [(ir.CompilerIrSpmdBackend.Scalar) true]
              [_ false]))
            (ResultLowerExpr.Ok
              (LowerExpr.Expr
                call-state
                (ir.CompilerIrValue.Var result-var)
                result-ty))
            (ResultLowerExpr.Ok
              (lower-emit-splat
                call-state
                (ir.CompilerIrValue.Var result-var)
                lanes
                result-ty))))])))

(define (lower-avx512-emit-spmd-call-active
  [state : LowerState (:consume)]
  [hidden-name : i64]
  [backend : ir.CompilerIrSpmdBackend]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [call-args : ir.CompilerIrSpmdCallArgList]
  [result-ty : ast.AstType]
  [result-varying : bool]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (match (lower-masked-active-mask-value state active-mask lanes)
    [(LowerExpr.Expr mask-state mask _)
      (lower-avx512-emit-spmd-call
        mask-state
        hidden-name
        backend
        mask
        lanes
        call-args
        result-ty
        result-varying
        expr)]))

(define (lower-avx512-uniform-spmd-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [lanes : i64]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (match (lower-call ctx state env type-env func args result-ty expr)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr call-state call-value call-ty)
          (if (or
            (tc_core.tc-type-eq call-ty (ast.AstType.Unit))
            (lower-type-bool? call-ty))
            (ResultLowerExpr.Ok lowered)
            (ResultLowerExpr.Ok
              (lower-emit-splat call-state call-value lanes call-ty)))])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-imported-spmd-avx512-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [canonical-name : i64]
  [fn-ty : ast.AstType]
  [callables : ast.AstImportedSpmdCallableList]) : ResultLowerExpr
  (match fn-ty
    [(ast.AstType.Func param-types ret-id)
      (match (lower-expr-result-type-or-check
        ctx
        env
        type-env
        (lower-state-type-cache state)
        expr)
        [(tc_core.ResultTcType.Err message)
          (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]
        [(tc_core.ResultTcType.Ok result-ty)
          (let
            [params : ast.AstParamList
              (lower-imported-spmd-params ctx (box-get param-types))]
            [ret : ast.AstType (tc_core.tc-context-type-get ctx ret-id)]
            [arg-lanes : i64
              (lower-spmd-call-args-lanes
                ctx
                (lower-state-mode state)
                env
                type-env
                index
                (lower-masked-vector-lane-locals-from-set lane-locals lanes)
                args)]
            (if (= arg-lanes 0)
              (lower-avx512-uniform-spmd-call
                ctx
                state
                env
                type-env
                func
                args
                result-ty
                lanes
                expr)
              (match (lower-avx512-spmd-call-args
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                params
                args)
                [(ResultLowerSpmdCallArgs.Err message)
                  (ResultLowerExpr.Err message)]
                [(ResultLowerSpmdCallArgs.Ok args-state call-args any-varying)
                  (if (not any-varying)
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          expr
                          "lower: inconsistent imported SPMD helper argument classification")))
                    (let
                      [args-code : String
                        (lower-imported-spmd-call-args-code call-args)]
                      [signature : String
                        (lower-spmd-source-signature params ret)]
                      [requested-index-param : i64
                        (lower-imported-spmd-index-param ctx index args)]
                      (match (lower-imported-spmd-select
                        canonical-name
                        (& callables)
                        signature
                        (ir.CompilerIrSpmdBackend.Avx512)
                        lanes
                        args-code
                        requested-index-param
                        ret
                        expr)
                        [(ResultLowerImportedSpmdSpecialization.Err message)
                          (ResultLowerExpr.Err message)]
                        [(ResultLowerImportedSpmdSpecialization.Ok
                            specialization)
                          (lower-avx512-emit-spmd-call-active
                            args-state
                            (lower-imported-spmd-ir-symbol specialization)
                            (ir.CompilerIrSpmdBackend.Avx512)
                            active-mask
                            lanes
                            call-args
                            result-ty
                            (lower-imported-spmd-result-varying? specialization)
                            expr)])))])))])]
    [_
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            expr
            "lower: imported SPMD helper does not have function type")))]))

(define (lower-avx512-spmd-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultLowerExpr
  (match (lower-spmd-inline-helper-lookup ctx env type-env lane-locals func)
    [(ResultLowerSpmdInlineHelper.Ok helper)
      (match helper
        [(LowerSpmdInlineHelper.Some name params ret body)
          (match (lower-expr-result-type-or-check
            ctx
            env
            type-env
            (lower-state-type-cache state)
            expr)
            [(tc_core.ResultTcType.Ok result-ty)
              (let
                [arg-lanes : i64
                  (lower-spmd-call-args-lanes
                    ctx
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    (lower-masked-vector-lane-locals-from-set lane-locals lanes)
                    args)]
                (if (= arg-lanes 0)
                  (lower-avx512-uniform-spmd-call
                    ctx
                    state
                    env
                    type-env
                    func
                    args
                    result-ty
                    lanes
                    expr)
                  (match (lower-avx512-spmd-call-args
                    ctx
                    state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    params
                    args)
                    [(ResultLowerSpmdCallArgs.Ok
                        args-state
                        call-args
                        any-varying)
                      (if (not any-varying)
                        (ResultLowerExpr.Err
                          (box
                            (lower-diagnostic-at-expr
                              expr
                              "lower: inconsistent SPMD helper argument classification")))
                        (match (lower-state-fresh-lambda-name args-state)
                          [(LowerLambdaName.Name named-state hidden-name)
                            (let
                              [helper-index : String
                                (lower-spmd-helper-index-param
                                  ctx
                                  index
                                  params
                                  args)]
                              [abi-call-args : ir.CompilerIrSpmdCallArgList
                                (if (= (string.string-length helper-index) 0)
                                  call-args
                                  (lower-spmd-call-args-append
                                    call-args
                                    (ir.CompilerIrSpmdCallArg.Arg
                                      (ir.CompilerIrSpmdValueClass.Uniform)
                                      (ir.CompilerIrValue.Var index-var)
                                      (ast.AstType.I64))))]
                              [result-varying : bool
                                (>
                                  (lower-spmd-direct-call-result-lanes
                                    ctx
                                    (lower-state-mode named-state)
                                    env
                                    type-env
                                    index
                                    (lower-masked-vector-lane-locals-from-set
                                      lane-locals
                                      lanes)
                                    func
                                    args)
                                  0)]
                              [backend : ir.CompilerIrSpmdBackend
                                (if (lower-mode-avx2?
                                  (lower-state-mode named-state))
                                  ir.CompilerIrSpmdBackend.Avx2
                                  ir.CompilerIrSpmdBackend.Avx512)]
                              [private-name : i64
                                (lower-spmd-private-helper-name
                                  hidden-name
                                  result-ty
                                  result-varying)]
                              (match (lower-spmd-specialized-helper-function
                                ctx
                                type-env
                                (lower-state-type-cache named-state)
                                private-name
                                params
                                ret
                                result-varying
                                body
                                backend
                                abi-call-args
                                lanes
                                helper-index
                                -1
                                (lower-state-spans named-state)
                                (lower-state-names named-state)
                                (lower-state-mode named-state))
                                [(ResultLowerFunction.Ok functions helper-spans)
                                  (lower-avx512-emit-spmd-call-active
                                    (lower-state-add-functions
                                      named-state
                                      functions
                                      helper-spans)
                                    private-name
                                    backend
                                    active-mask
                                    lanes
                                    abi-call-args
                                    result-ty
                                    result-varying
                                    expr)]
                                [(ResultLowerFunction.Err message)
                                  (ResultLowerExpr.Err message)]))]))]
                    [(ResultLowerSpmdCallArgs.Err message)
                      (ResultLowerExpr.Err message)])))]
            [(tc_core.ResultTcType.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr expr message)))])]
        [(LowerSpmdInlineHelper.Imported canonical-name fn-ty callables)
          (if (lower-mode-avx2? (lower-state-mode state))
            (ResultLowerExpr.Err
              (box
                (lower-diagnostic-at-expr
                  expr
                  (str_cat.str-cat
                    "lower: imported SPMD helper `"
                    (ci.intern-str canonical-name)
                    "` is not supported in AVX2 backend mode"))))
            (lower-imported-spmd-avx512-call
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              expr
              func
              args
              canonical-name
              fn-ty
              (box-get callables)))]
        [(LowerSpmdInlineHelper.No)
          (lower-avx512-masked-unsupported expr "non-direct SPMD helper calls")])]
    [(ResultLowerSpmdInlineHelper.Err message) (ResultLowerExpr.Err message)]))

(define (lower-avx512-masked-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner))]
    [(ast.AstExpr.Literal lit)
      (match lit
        [(ast.AstLiteral.Bool value)
          (ResultLowerExpr.Ok
            (lower-avx512-masked-bool-literal state active-mask lanes value))]
        [_
          (ResultLowerExpr.Ok
            (lower-emit-splat
              state
              (lower-literal-value-with-type lit (tc_core.tc-literal-type lit))
              lanes
              (tc_core.tc-literal-type lit)))])]
    [(ast.AstExpr.SpmdProgramIndex)
      (ResultLowerExpr.Ok (lower-emit-lane-id state lanes (ast.AstType.I64)))]
    [(ast.AstExpr.SpmdProgramCount)
      (ResultLowerExpr.Ok
        (lower-emit-splat
          state
          (ir.CompilerIrValue.I64 lanes)
          lanes
          (ast.AstType.I64)))]
    [(ast.AstExpr.Var name)
      (lower-avx512-masked-var
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        lanes
        expr
        name)]
    [(ast.AstExpr.Unary op inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match op
          [(ast.AstUnOp.Not)
            (match (lower-avx512-masked-expr
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              inner)
              [(ResultLowerExpr.Ok lowered)
                (match lowered
                  [(LowerExpr.Expr next-state value _)
                    (ResultLowerExpr.Ok
                      (lower-emit-mask-not next-state value lanes))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [_ (lower-avx512-masked-unsupported expr "this unary operator")]))]
    [(ast.AstExpr.Binary op left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (lower-avx512-masked-binary
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expr
          op
          left
          right))]
    [(ast.AstExpr.Call func-box args)
      (lower-avx512-spmd-call
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (lower-context-expr-get ctx func-box)
        args)]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-avx512-masked-let-bindings
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              bindings)
              [(ResultLowerEnv.Ok bound-state bound-env bound-type-env)
                (lower-avx512-masked-expr
                  ctx
                  bound-state
                  bound-env
                  bound-type-env
                  (lower-masked-vector-let-binding-names bindings lane-locals)
                  index
                  index-var
                  active-mask
                  lanes
                  body)]
              [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)]))])]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          expr)
          [(tc_core.ResultTcType.Ok result-ty)
            (lower-avx512-masked-if
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              result-ty
              expr
              cond
              then-branch
              else-branch)]
          [(tc_core.ResultTcType.Err message)
            (ResultLowerExpr.Err (box (lower-diagnostic-at-expr expr message)))]))]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (match (lower-expr-result-type-or-check
            ctx
            env
            type-env
            (lower-state-type-cache state)
            expr)
            [(tc_core.ResultTcType.Ok result-ty)
              (lower-avx512-masked-match
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                result-ty
                expr
                (lower-context-expr-get ctx scrutinee-box)
                arms)]
            [(tc_core.ResultTcType.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr expr message)))])])]
    [(ast.AstExpr.While cond-box body-box)
      (lower-avx512-masked-while
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        (lower-context-expr-get ctx cond-box)
        (lower-context-expr-get ctx body-box))]
    [(ast.AstExpr.Begin exprs)
      (lower-avx512-masked-begin
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        exprs)]
    [(ast.AstExpr.ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (lower-avx512-masked-array-ref
          ctx
          state
          env
          type-env
          index
          index-var
          active-mask
          lanes
          expr
          arr
          idx))]
    [(ast.AstExpr.ArraySet arr-box idx-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-avx512-masked-array-set
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expr
          arr
          idx
          value))]
    [_ (lower-avx512-masked-unsupported expr "this branch expression")]))

(define (lower-avx512-masked-expr-expected
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [expected-ty : ast.AstType]) : ResultLowerExpr
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-avx512-masked-expr-expected
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner
          expected-ty))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-avx512-masked-expr-expected
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          inner
          expected-ty))]
    [(ast.AstExpr.Cast inner-box cast-ty-id)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        [resolved-cast : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx cast-ty-id)))]
        [resolved-expected : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx expected-ty))]
        (match (lower-simple-vector-map-casted-literal
          ctx
          (lower-state-mode state)
          resolved-cast
          resolved-expected
          inner)
          [(LowerMaybeVectorMapValue.Some plan)
            (match plan
              [(LowerVectorMapValue.Uniform value)
                (ResultLowerExpr.Ok
                  (lower-emit-splat state value lanes resolved-expected))]
              [_
                (lower-avx512-masked-expr
                  ctx
                  state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lanes
                  expr)])]
          [(LowerMaybeVectorMapValue.No)
            (lower-avx512-masked-expr
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              expr)]))]
    [(ast.AstExpr.Literal lit)
      (match lit
        [(ast.AstLiteral.Bool value)
          (ResultLowerExpr.Ok
            (lower-avx512-masked-bool-literal state active-mask lanes value))]
        [_
          (ResultLowerExpr.Ok
            (lower-emit-splat
              state
              (lower-literal-value-with-type
                lit
                (tc_core.tc-type-without-regions expected-ty))
              lanes
              (tc_core.tc-type-without-regions expected-ty)))])]
    [(ast.AstExpr.If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (lower-avx512-masked-if
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expected-ty
          expr
          cond
          then-branch
          else-branch))]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (lower-avx512-masked-match
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            expected-ty
            expr
            (lower-context-expr-get ctx scrutinee-box)
            arms)])]
    [_
      (lower-avx512-masked-expr
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr)]))

(define (lower-predicated-tail-map-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : ir.CompilerIrValue]
  [plan : LowerMaybeVectorMap]) : LowerState
  (match plan
    [(LowerMaybeVectorMap.Some stores elem-ty lanes)
      (let
        [s : LowerState state]
        [count : i64 (struct-get stores count)]
        [results : (__tl_dyn-array ir.CompilerIrValue)
          (make-array ir.CompilerIrValue count)]
        [store-index : i64 0]
        [cache : LowerVectorMapValueCache (lower-vector-map-value-cache-empty)]
        [mask : ir.CompilerIrValue ir.CompilerIrValue.Unit]
        [result-vec : ir.CompilerIrValue ir.CompilerIrValue.Unit]
        (begin
          (match (lower-emit-tail-mask
            s
            (ir.CompilerIrValue.Var index-var)
            end-value
            lanes)
            [(LowerExpr.Expr next-s value _)
              (begin
                (set! s next-s)
                (set! mask value))])
          (while (< store-index count)
            (match (lower-vector-map-store-list-ref stores store-index)
              [(LowerVectorMapStore _ value-plan)
                (begin
                  (match (lower-emit-vector-map-value-cached
                    ctx
                    s
                    index-var
                    lanes
                    elem-ty
                    value-plan
                    (LowerVectorMapEmitMode.Predicated end-value mask)
                    cache)
                    [(LowerVectorMapCachedEmit.Emit next-s value next-cache)
                      (begin
                        (set! s next-s)
                        (set! result-vec value)
                        (set! cache next-cache))])
                  (array-set! results store-index result-vec)
                  (set! store-index (+ store-index 1)))]))
          (set! store-index 0)
          (while (< store-index count)
            (match (lower-vector-map-store-list-ref stores store-index)
              [(LowerVectorMapStore dst-array _)
                (begin
                  (set!
                    s
                    (lower-emit-predicated-store
                      s
                      (ir.CompilerIrValue.Var dst-array)
                      (ir.CompilerIrValue.Var index-var)
                      (array-ref results store-index)
                      mask
                      lanes
                      elem-ty))
                  (set! store-index (+ store-index 1)))]))
          s))]
    [(LowerMaybeVectorMap.No) state]))

(define (lower-avx512-masked-map-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [body : ast.AstExpr]) : ResultLowerExpr
  (lower-avx512-masked-expr
    ctx
    state
    (sym_i64_env.sym-i64-bind-id env index-id index-var)
    (tc_core.tc-bind-id type-env index-id index-ty)
    (lower-id-set-empty)
    index
    index-var
    active-mask
    lanes
    body))

(define (lower-avx512-masked-foreach-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [body : ast.AstExpr]
  [plan : LowerMaybeMaskedVectorMap]) : ResultLowerExpr
  (match plan
    [(LowerMaybeMaskedVectorMap.Some lanes)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (ir.CompilerIrInstr.Mov index-var start-value index-ty))]
            [body-env : sym_i64_env.SymI64Env
              (sym_i64_env.sym-i64-bind-id env index-id index-var)]
            [body-type-env : tc_core.TcTypeEnv
              (tc_core.tc-bind-id type-env index-id index-ty)]
            [arrays : LowerArrayVarSet
              (lower-masked-vector-array-vars
                ctx
                body-env
                body-type-env
                index
                body)]
            [header-label : i64 (ir.compiler-ir-label-none)]
            [body-label : i64 (ir.compiler-ir-label-none)]
            [tail-header-label : i64 (ir.compiler-ir-label-none)]
            [tail-check-label : i64 (ir.compiler-ir-label-none)]
            [tail-mask-label : i64 (ir.compiler-ir-label-none)]
            [tail-body-label : i64 (ir.compiler-ir-label-none)]
            [exit-label : i64 (ir.compiler-ir-label-none)]
            [vector-limit : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [vector-start-ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [next-index : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [vector-ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [tail-cond : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [tail-safe : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [active-mask : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            (begin
              (match (lower-state-fresh-label s "foreach_avx512_mask_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label s "foreach_avx512_mask_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "foreach_tail_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (match (lower-state-fresh-label s "foreach_tail_check")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-check-label label))])
              (match (lower-state-fresh-label s "foreach_tail_mask")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-mask-label label))])
              (match (lower-state-fresh-label s "foreach_tail_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "foreach_exit")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (match (lower-vector-loop-limit s end-value arrays lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-limit value))])
              (match (lower-vector-loop-start-ok s index-var lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-start-ok value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (ir.CompilerIrInstr.Branch
                      vector-start-ok
                      header-label
                      tail-header-label))
                  header-label))
              (match (lower-emit-binop
                s
                (ir.CompilerIrBinOp.Add)
                (ir.CompilerIrValue.Var index-var)
                (ir.CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! next-index value))])
              (match (lower-vector-loop-next-ok s next-index vector-limit)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (ir.CompilerIrInstr.Branch
                      vector-ok
                      body-label
                      tail-header-label))
                  body-label))
              (match (lower-avx512-masked-map-body
                ctx
                s
                env
                type-env
                index-id
                index
                index-ty
                index-var
                (ir.CompilerIrMaybeValue.No)
                lanes
                body)
                [(ResultLowerExpr.Ok lowered-body)
                  (match lowered-body
                    [(LowerExpr.Expr body-state _ _)
                      (set!
                        s
                        (lower-state-emit
                          body-state
                          (ir.CompilerIrInstr.Mov index-var next-index index-ty)))])]
                [(ResultLowerExpr.Err message)
                  (return (ResultLowerExpr.Err message))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit s (ir.CompilerIrInstr.Jump header-label))
                  tail-header-label))
              (match (lower-vector-loop-i64-compare
                s
                (ir.CompilerIrBinOp.Lt)
                (ir.CompilerIrValue.Var index-var)
                end-value)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! tail-cond value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (ir.CompilerIrInstr.Branch
                      tail-cond
                      tail-check-label
                      exit-label))
                  tail-check-label))
              (match (lower-predicated-tail-ok s index-var end-value arrays)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! tail-safe value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (ir.CompilerIrInstr.Branch
                      tail-safe
                      tail-mask-label
                      tail-body-label))
                  tail-mask-label))
              (match (lower-emit-tail-mask
                s
                (ir.CompilerIrValue.Var index-var)
                end-value
                lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! active-mask value))])
              (match (lower-avx512-masked-map-body
                ctx
                s
                env
                type-env
                index-id
                index
                index-ty
                index-var
                (ir.CompilerIrMaybeValue.Some active-mask)
                lanes
                body)
                [(ResultLowerExpr.Ok lowered-tail)
                  (match lowered-tail
                    [(LowerExpr.Expr tail-state _ _)
                      (set!
                        s
                        (lower-state-finish-block
                          (lower-state-emit
                            tail-state
                            (ir.CompilerIrInstr.Jump exit-label))
                          tail-body-label))])]
                [(ResultLowerExpr.Err message)
                  (return (ResultLowerExpr.Err message))])
              (match (lower-expr ctx s body-env body-type-env body)
                [(ResultLowerExpr.Ok scalar-tail-lowered)
                  (match scalar-tail-lowered
                    [(LowerExpr.Expr post-body-state _ _)
                      (match (lower-state-alloc-var post-body-state)
                        [(LowerAlloc.Alloc inc-alloc inc-var)
                          (ResultLowerExpr.Ok
                            (LowerExpr.Expr
                              (lower-state-finish-block
                                (lower-state-emit
                                  (lower-state-emit
                                    (lower-state-emit
                                      inc-alloc
                                      (ir.CompilerIrInstr.BinOp
                                        inc-var
                                        ir.CompilerIrBinOp.Add
                                        (ir.CompilerIrValue.Var index-var)
                                        (ir.CompilerIrValue.I64 1)
                                        index-ty))
                                    (ir.CompilerIrInstr.Mov
                                      index-var
                                      (ir.CompilerIrValue.Var inc-var)
                                      index-ty))
                                  (ir.CompilerIrInstr.Jump tail-header-label))
                                exit-label)
                              ir.CompilerIrValue.Unit
                              (ast.AstType.Unit)))])])]
                [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))])]
    [(LowerMaybeMaskedVectorMap.No)
      (lower-scalar-foreach-lowered
        ctx
        state
        env
        type-env
        index-id
        index
        index-ty
        start-value
        end-value
        body)]))

;; Scalar `foreach` lowering. `(foreach ([i : ty start end]) body)`
;; lowers to the half-open reference loop `i = start; while (i < end) { body;
;; i = i + 1 }`, yielding unit. `start` and `end` are each lowered exactly once
;; before the loop; the index binding is scoped to the body. Mirrors lower-while
;; with an index var, a `<` guard, and a `+ 1` increment.
(define (lower-spmd-scalar-body-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [previous : LowerSpmdScalarCallContext
      (lower-global-shared-view lower-spmd-scalar-call-context)]
    [result : ResultLowerExpr
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: SPMD scalar body lowering failed")))]
    (begin
      (set!
        lower-spmd-scalar-call-context
        (LowerSpmdScalarCallContext.Some index))
      (set! result (lower-expr ctx state env type-env body))
      (set! lower-spmd-scalar-call-context previous)
      result)))

(define (lower-scalar-foreach-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [body : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc index-alloc index-var)
      (match (lower-state-fresh-label
        (lower-state-emit
          index-alloc
          (ir.CompilerIrInstr.Mov index-var start-value index-ty))
        "foreach_header")
        [(LowerLabel.Label header-ls header-label)
          (match (lower-state-fresh-label header-ls "foreach_body")
            [(LowerLabel.Label body-ls body-label)
              (match (lower-state-fresh-label body-ls "foreach_exit")
                [(LowerLabel.Label exit-ls exit-label)
                  (match (lower-state-alloc-var
                    (lower-state-finish-block
                      (lower-state-emit
                        exit-ls
                        (ir.CompilerIrInstr.Jump header-label))
                      header-label))
                    [(LowerAlloc.Alloc cond-alloc cond-var)
                      (match (lower-spmd-scalar-body-expr
                        ctx
                        (lower-state-finish-block
                          (lower-state-emit
                            (lower-state-emit
                              cond-alloc
                              (ir.CompilerIrInstr.BinOp
                                cond-var
                                ir.CompilerIrBinOp.Lt
                                (ir.CompilerIrValue.Var index-var)
                                end-value
                                index-ty))
                            (ir.CompilerIrInstr.Branch
                              (ir.CompilerIrValue.Var cond-var)
                              body-label
                              exit-label))
                          body-label)
                        (sym_i64_env.sym-i64-bind-id env index-id index-var)
                        (tc_core.tc-bind-id type-env index-id index-ty)
                        index
                        body)
                        [(ResultLowerExpr.Ok body-lowered)
                          (match body-lowered
                            [(LowerExpr.Expr post-body-state _ _)
                              (match (lower-state-alloc-var post-body-state)
                                [(LowerAlloc.Alloc inc-alloc inc-var)
                                  (ResultLowerExpr.Ok
                                    (LowerExpr.Expr
                                      (lower-state-finish-block
                                        (lower-state-emit
                                          (lower-state-emit
                                            (lower-state-emit
                                              inc-alloc
                                              (ir.CompilerIrInstr.BinOp
                                                inc-var
                                                ir.CompilerIrBinOp.Add
                                                (ir.CompilerIrValue.Var
                                                  index-var)
                                                (ir.CompilerIrValue.I64 1)
                                                index-ty))
                                            (ir.CompilerIrInstr.Mov
                                              index-var
                                              (ir.CompilerIrValue.Var inc-var)
                                              index-ty))
                                          (ir.CompilerIrInstr.Jump header-label))
                                        exit-label)
                                      ir.CompilerIrValue.Unit
                                      (ast.AstType.Unit)))])])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])])])])])]))

(define (lower-avx2-foreach-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [body : ast.AstExpr]
  [plan : LowerMaybeVectorMap]) : ResultLowerExpr
  (match plan
    [(LowerMaybeVectorMap.Some stores elem-ty lanes)
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (ir.CompilerIrInstr.Mov index-var start-value index-ty))]
            [arrays : LowerArrayVarSet
              (lower-vector-map-store-list-array-vars stores)]
            [header-label : i64 (ir.compiler-ir-label-none)]
            [body-label : i64 (ir.compiler-ir-label-none)]
            [tail-header-label : i64 (ir.compiler-ir-label-none)]
            [tail-check-label : i64 (ir.compiler-ir-label-none)]
            [tail-mask-label : i64 (ir.compiler-ir-label-none)]
            [tail-body-label : i64 (ir.compiler-ir-label-none)]
            [exit-label : i64 (ir.compiler-ir-label-none)]
            [vector-limit : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [vector-start-ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [next-index : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [vector-ok : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [tail-cond : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [tail-safe : ir.CompilerIrValue ir.CompilerIrValue.Unit]
            [predicated-tail? : bool
              (or
                (lower-mode-avx512? (lower-state-mode state))
                (not (lower-maybe-vector-map-needs-scalar-tail? plan)))]
            [preheader-cache : LowerVectorMapValueCache
              (lower-vector-map-value-cache-empty)]
            (begin
              (match (lower-state-fresh-label s "foreach_avx2_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! header-label label))])
              (match (lower-state-fresh-label s "foreach_avx2_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! body-label label))])
              (match (lower-state-fresh-label s "foreach_tail_header")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-header-label label))])
              (match (lower-state-fresh-label s "foreach_tail_check")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-check-label label))])
              (match (lower-state-fresh-label s "foreach_tail_mask")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-mask-label label))])
              (match (lower-state-fresh-label s "foreach_tail_body")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! tail-body-label label))])
              (match (lower-state-fresh-label s "foreach_exit")
                [(LowerLabel.Label next-s label)
                  (begin
                    (set! s next-s)
                    (set! exit-label label))])
              (match (lower-vector-loop-limit s end-value arrays lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-limit value))])
              (match (lower-vector-loop-start-ok s index-var lanes)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-start-ok value))])
              (match (lower-vector-map-preheader-cache-stores
                s
                arrays
                stores
                lanes
                elem-ty)
                [(LowerVectorMapCachedEmit.Emit next-s _ next-cache)
                  (begin
                    (set! s next-s)
                    (set! preheader-cache next-cache))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (ir.CompilerIrInstr.Branch
                      vector-start-ok
                      header-label
                      tail-header-label))
                  header-label))
              (match (lower-emit-binop
                s
                (ir.CompilerIrBinOp.Add)
                (ir.CompilerIrValue.Var index-var)
                (ir.CompilerIrValue.I64 lanes)
                index-ty)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! next-index value))])
              (match (lower-vector-loop-next-ok s next-index vector-limit)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! vector-ok value))])
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (ir.CompilerIrInstr.Branch
                      vector-ok
                      body-label
                      tail-header-label))
                  body-label))
              (set!
                s
                (lower-avx2-vector-map-body
                  ctx
                  s
                  index-var
                  next-index
                  plan
                  preheader-cache))
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit s (ir.CompilerIrInstr.Jump header-label))
                  tail-header-label))
              (match (lower-vector-loop-i64-compare
                s
                (ir.CompilerIrBinOp.Lt)
                (ir.CompilerIrValue.Var index-var)
                end-value)
                [(LowerExpr.Expr next-s value _)
                  (begin
                    (set! s next-s)
                    (set! tail-cond value))])
              (set!
                s
                (if predicated-tail?
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (ir.CompilerIrInstr.Branch
                        tail-cond
                        tail-check-label
                        exit-label))
                    tail-check-label)
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (ir.CompilerIrInstr.Branch
                        tail-cond
                        tail-body-label
                        exit-label))
                    tail-body-label)))
              (if predicated-tail?
                (if (lower-maybe-vector-map-has-gather? plan)
                  ;; Gather sources require per-lane scalar tail semantics.
                  ;; Enter the ordinary one-iteration tail body directly
                  ;; instead of materializing a predicated vector value that
                  ;; cannot represent those source checks.
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        s
                        (ir.CompilerIrInstr.Jump tail-body-label))
                      tail-body-label))
                  (begin
                    (match (lower-predicated-tail-ok
                      s
                      index-var
                      end-value
                      arrays)
                      [(LowerExpr.Expr next-s value _)
                        (begin
                          (set! s next-s)
                          (set! tail-safe value))])
                    (set!
                      s
                      (lower-state-finish-block
                        (lower-state-emit
                          s
                          (ir.CompilerIrInstr.Branch
                            tail-safe
                            tail-mask-label
                            tail-body-label))
                        tail-mask-label))
                    (set!
                      s
                      (lower-predicated-tail-map-body
                        ctx
                        s
                        index-var
                        end-value
                        plan))
                    (set!
                      s
                      (lower-state-finish-block
                        (lower-state-emit
                          s
                          (ir.CompilerIrInstr.Jump exit-label))
                        tail-body-label))))
                unit)
              (if (and
                (lower-maybe-vector-map-needs-scalar-tail? plan)
                (or
                  (not (lower-mode-avx512? (lower-state-mode s)))
                  (lower-maybe-vector-map-has-gather? plan)
                  (lower-maybe-vector-map-has-shuffle? plan)))
                (match plan
                  [(LowerMaybeVectorMap.Some stores elem-ty store-lanes)
                    (lower-avx2-broadcast-tail-map-body
                      ctx
                      s
                      index-var
                      end-value
                      stores
                      elem-ty
                      store-lanes
                      exit-label)]
                  [(LowerMaybeVectorMap.No)
                    (ResultLowerExpr.Err
                      (box (lower-diagnostic "lower: missing vector map plan")))])
                (match (lower-expr
                  ctx
                  s
                  (sym_i64_env.sym-i64-bind-id env index-id index-var)
                  (tc_core.tc-bind-id type-env index-id index-ty)
                  body)
                  [(ResultLowerExpr.Ok body-lowered)
                    (match body-lowered
                      [(LowerExpr.Expr post-body-state _ _)
                        (match (lower-state-alloc-var post-body-state)
                          [(LowerAlloc.Alloc inc-alloc inc-var)
                            (ResultLowerExpr.Ok
                              (LowerExpr.Expr
                                (lower-state-finish-block
                                  (lower-state-emit
                                    (lower-state-emit
                                      (lower-state-emit
                                        inc-alloc
                                        (ir.CompilerIrInstr.BinOp
                                          inc-var
                                          ir.CompilerIrBinOp.Add
                                          (ir.CompilerIrValue.Var index-var)
                                          (ir.CompilerIrValue.I64 1)
                                          index-ty))
                                      (ir.CompilerIrInstr.Mov
                                        index-var
                                        (ir.CompilerIrValue.Var inc-var)
                                        index-ty))
                                    (ir.CompilerIrInstr.Jump tail-header-label))
                                  exit-label)
                                ir.CompilerIrValue.Unit
                                (ast.AstType.Unit)))])])]
                  [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))))])]
    [(LowerMaybeVectorMap.No)
      (lower-scalar-foreach-lowered
        ctx
        state
        env
        type-env
        index-id
        index
        index-ty
        start-value
        end-value
        body)]))

(define (lower-foreach-lowered-inlined
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [body : ast.AstExpr]) : ResultLowerExpr
  (if (and
    (lower-mode-simd? (lower-state-mode state))
    (lower-type-i64? index-ty))
    (match (lower-simple-vector-map
      ctx
      (lower-state-mode state)
      env
      type-env
      index
      body)
      [(LowerMaybeVectorMap.Some _ _ _)
        (lower-avx2-foreach-lowered
          ctx
          state
          env
          type-env
          index-id
          index
          index-ty
          start-value
          end-value
          body
          (lower-simple-vector-map
            ctx
            (lower-state-mode state)
            env
            type-env
            index
            body))]
      [(LowerMaybeVectorMap.No)
        (if (lower-vector-body-has-atomic-call? ctx env type-env body)
          (lower-scalar-foreach-lowered
            ctx
            state
            env
            type-env
            index-id
            index
            index-ty
            start-value
            end-value
            body)
          (match (lower-masked-vector-map
            ctx
            (lower-state-mode state)
            env
            type-env
            index
            body)
            [(LowerMaybeMaskedVectorMap.Some _)
              (lower-avx512-masked-foreach-lowered
                ctx
                state
                env
                type-env
                index-id
                index
                index-ty
                start-value
                end-value
                body
                (lower-masked-vector-map
                  ctx
                  (lower-state-mode state)
                  env
                  type-env
                  index
                  body))]
            [(LowerMaybeMaskedVectorMap.No)
              (cond
                [(lower-masked-vector-body-has-varying-while?
                    ctx
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (if (lower-mode-avx2? (lower-state-mode state))
                          (lower-avx2-varying-while-diagnostic)
                          "lower: SPMD varying while AVX-512 lowering is not available for this backend mode or loop shape"))))]
                [(lower-masked-vector-body-has-varying-if?
                    ctx
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (if (lower-mode-avx2? (lower-state-mode state))
                          (lower-avx2-masked-if-diagnostic)
                          "lower: SPMD masked if AVX-512 lowering is not available for this backend mode or branch shape"))))]
                [(lower-masked-vector-body-has-varying-enum-match?
                    ctx
                    env
                    type-env
                    index
                    body)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (if (lower-mode-avx2? (lower-state-mode state))
                          "lower: AVX2 varying enum match requires a contiguous dynamic-array lane source and supported payload bindings"
                          "lower: AVX-512 varying enum match requires a contiguous dynamic-array lane source and supported payload bindings"))))]
                [(lower-masked-vector-body-has-varying-match?
                    ctx
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (if (lower-mode-avx2? (lower-state-mode state))
                          "lower: SPMD varying match AVX2 lowering is not available for this match shape"
                          "lower: SPMD varying match AVX-512 lowering is not available for this backend mode or match shape"))))]
                [(lower-vector-body-has-spmd-shuffle? ctx body)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic-at-expr
                        body
                        (lower-spmd-shuffle-diagnostic))))]
                [(lower-vector-body-has-array-read? ctx body)
                  (if (lower-simple-vector-map-has-unsupported-byte-mul?
                    ctx
                    (lower-state-mode state)
                    env
                    type-env
                    index
                    body)
                    (ResultLowerExpr.Err
                      (box
                        (lower-diagnostic-at-expr
                          body
                          (lower-spmd-byte-mul-diagnostic))))
                    (match (lower-simple-vector-map-unsupported-shift-lane
                      ctx
                      (lower-state-mode state)
                      env
                      type-env
                      index
                      true
                      body)
                      [(LowerMaybeAstType.Some lane-ty)
                        (ResultLowerExpr.Err
                          (box
                            (lower-diagnostic-at-expr
                              body
                              (lower-spmd-map-shift-diagnostic
                                "shl"
                                lane-ty
                                (lower-state-mode state)))))]
                      [(LowerMaybeAstType.No)
                        (match (lower-simple-vector-map-unsupported-shift-lane
                          ctx
                          (lower-state-mode state)
                          env
                          type-env
                          index
                          false
                          body)
                          [(LowerMaybeAstType.Some lane-ty)
                            (ResultLowerExpr.Err
                              (box
                                (lower-diagnostic-at-expr
                                  body
                                  (lower-spmd-map-shift-diagnostic
                                    "shr"
                                    lane-ty
                                    (lower-state-mode state)))))]
                          [(LowerMaybeAstType.No)
                            (ResultLowerExpr.Err
                              (box
                                (lower-diagnostic-at-expr
                                  body
                                  (lower-simd-foreach-fallback-diagnostic))))])]))]
                [else
                  (lower-scalar-foreach-lowered
                    ctx
                    state
                    env
                    type-env
                    index-id
                    index
                    index-ty
                    start-value
                    end-value
                    body)])]))])
    (lower-scalar-foreach-lowered
      ctx
      state
      env
      type-env
      index-id
      index
      index-ty
      start-value
      end-value
      body)))

(define (lower-foreach-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [body : ast.AstExpr]) : ResultLowerExpr
  (match (lower-spmd-inline-expr
    ctx
    env
    type-env
    body
    (lower-spmd-inline-subst-empty)
    (lower-id-set-insert (lower-id-set-empty) index-id))
    [(ResultLowerAstExpr.Ok inlined-body)
      (lower-foreach-lowered-inlined
        ctx
        state
        env
        type-env
        index-id
        index
        index-ty
        start-value
        end-value
        inlined-body)]
    [(ResultLowerAstExpr.Err diag) (ResultLowerExpr.Err diag)]))

(define (lower-foreach
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-expected ctx state env type-env start index-ty start)
    [(ResultLowerExpr.Ok start-lowered)
      (match start-lowered
        [(LowerExpr.Expr start-state start-value _)
          (match (lower-expr-expected
            ctx
            start-state
            env
            type-env
            end
            index-ty
            end)
            [(ResultLowerExpr.Ok end-lowered)
              (match end-lowered
                [(LowerExpr.Expr end-state end-value _)
                  (lower-foreach-lowered
                    ctx
                    end-state
                    env
                    type-env
                    index-id
                    index
                    index-ty
                    start-value
                    end-value
                    body)])]
            [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

;; Scalar `match` lowering. The scrutinee is lowered once into a fresh
;; local, then literal arms become a chain of `CompilerIrBinOp.Eq` tests + `CompilerIrInstr.Branch`
;; (mirroring `lower-if`). The typechecker guarantees exhaustiveness and arm-type
;; agreement, so the final arm reached must match: it is lowered as an
;; irrefutable catch-all (no test, jump straight to the merge block). A
;; value-typed match merges arm results with an `CompilerIrInstr.Phi`; a `unit`-typed
;; match emits no value phi. Enum matches reuse the same merge path, but load the
;; heap tag once and dispatch variant arms by tag.
(define (lower-match-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-expr ctx state env type-env scrutinee)
    [(ResultLowerExpr.Ok scrut-lowered)
      (match scrut-lowered
        [(LowerExpr.Expr scrut-state scrut-value scrut-ty)
          ;; Use the scrutinee var directly when it is already a var, like the
          ;; tail path: a copying Mov into a fresh home makes a 2-word enum pay
          ;; a Pack round-trip per copy.
          (match (lower-tail-match-scrutinee-home
            scrut-state
            scrut-value
            scrut-ty)
            [(LowerScrutineeHome.Home home-state scrut-var)
              (match (lower-state-fresh-label home-state "match_merge")
                [(LowerLabel.Label merge-state merge-label)
                  (match (tc_core.tc-type-strip-region
                    (tc_core.tc-resolve-type ctx scrut-ty))
                    [(ast.AstType.Enum _)
                      (lower-match-enum
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        (tc_core.TcMaybeNameId.No)
                        false)]
                    [(ast.AstType.EnumArgs _ _)
                      (lower-match-enum
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        (tc_core.TcMaybeNameId.No)
                        false)]
                    [(ast.AstType.Ref borrow-lifetime referent-box)
                      (let
                        [referent-ty : ast.AstType
                          (tc_core.tc-type-strip-region
                            (tc_core.tc-resolve-type
                              ctx
                              (tc_core.tc-context-type-get ctx referent-box)))]
                        (match referent-ty
                          [(ast.AstType.Enum _)
                            (lower-match-enum
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              referent-ty
                              arms
                              merge-label
                              expr-ty
                              (tc_core.TcMaybeNameId.Some borrow-lifetime)
                              true)]
                          [(ast.AstType.EnumArgs _ _)
                            (lower-match-enum
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              referent-ty
                              arms
                              merge-label
                              expr-ty
                              (tc_core.TcMaybeNameId.Some borrow-lifetime)
                              true)]
                          [_
                            (lower-match-arms
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              scrut-ty
                              arms
                              merge-label
                              expr-ty
                              ir.CompilerIrPhiInputList.Nil)]))]
                    [(ast.AstType.VarArgs _ _)
                      (lower-match-enum
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        (tc_core.TcMaybeNameId.No)
                        false)]
                    [_
                      (lower-match-arms
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arms
                        merge-label
                        expr-ty
                        ir.CompilerIrPhiInputList.Nil)])])])])]
    [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)]))

(define (lower-match-borrowed-enum
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]
  [borrow-lifetime : i64]
  [enum-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [resident : bool (lower-type-register-resident? ctx enum-ty)]
    (match (lower-expr ctx state env type-env place)
      [(ResultLowerExpr.Ok place-lowered)
        (match place-lowered
          [(LowerExpr.Expr place-state place-value _)
            ;; The borrowed payload bindings and literal compares below
            ;; address the scrutinee as MEMORY (gep off the pointer). A
            ;; register-resident enum place lowers to its packed word(s), so
            ;; spill it to a temp inline slot and run the whole match on the
            ;; slot address (force-memory). The Mov is typed U64 in that case:
            ;; the var holds an address, not a register group.
            (match (if resident
              (lower-copy-inline-aggregate-to-inline
                ctx
                place-state
                place-value
                enum-ty)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr place-state place-value enum-ty)))
              [(ResultLowerExpr.Ok scrut-expr)
                (match scrut-expr
                  [(LowerExpr.Expr scrut-state scrut-value _)
                    (match (lower-state-alloc-var scrut-state)
                      [(LowerAlloc.Alloc scrut-alloc scrut-var)
                        (match (lower-state-fresh-label
                          (lower-state-emit
                            scrut-alloc
                            (ir.CompilerIrInstr.Mov
                              scrut-var
                              scrut-value
                              (if resident
                                (ast.AstType.U64)
                                enum-ty)))
                          "match_merge")
                          [(LowerLabel.Label merge-state merge-label)
                            (lower-match-enum
                              ctx
                              merge-state
                              env
                              type-env
                              scrut-var
                              enum-ty
                              arms
                              merge-label
                              expr-ty
                              (tc_core.TcMaybeNameId.Some borrow-lifetime)
                              resident)])])])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])])]
      [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])))

(define (lower-match
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (ast.ast-expr-unspan scrutinee)
    [(ast.AstExpr.Borrow mutable _ place-box)
      (if mutable
        (lower-match-value ctx state env type-env scrutinee arms expr-ty)
        (let
          [place : ast.AstExpr (lower-context-expr-get ctx place-box)]
          (match (tc_core.tc-expr ctx type-env scrutinee)
            [(tc_core.ResultTcType.Ok scrut-ty)
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx scrut-ty))
                [(ast.AstType.Ref borrow-lifetime referent-box)
                  (let
                    [referent-ty : ast.AstType
                      (tc_core.tc-type-strip-region
                        (tc_core.tc-resolve-type
                          ctx
                          (tc_core.tc-context-type-get ctx referent-box)))]
                    (match referent-ty
                      [(ast.AstType.Enum _)
                        (lower-match-borrowed-enum
                          ctx
                          state
                          env
                          type-env
                          place
                          borrow-lifetime
                          referent-ty
                          arms
                          expr-ty)]
                      [(ast.AstType.EnumArgs _ _)
                        (lower-match-borrowed-enum
                          ctx
                          state
                          env
                          type-env
                          place
                          borrow-lifetime
                          referent-ty
                          arms
                          expr-ty)]
                      [_
                        (lower-match-value
                          ctx
                          state
                          env
                          type-env
                          scrutinee
                          arms
                          expr-ty)]))]
                [_
                  (lower-match-value
                    ctx
                    state
                    env
                    type-env
                    scrutinee
                    arms
                    expr-ty)])]
            [(tc_core.ResultTcType.Err message)
              (ResultLowerExpr.Err
                (box (lower-diagnostic-at-expr scrutinee message)))])))]
    [_ (lower-match-value ctx state env type-env scrutinee arms expr-ty)]))

(define (lower-match-enum
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [force-memory : bool]) : ResultLowerExpr
  ;; A 1-word register-resident enum value IS the tag word (nullary, no
  ;; payload); match on `scrut-var` directly. A 2-word register-group enum holds
  ;; the tag in word0; extract it with IrInstrWord. Neither touches memory. One
  ;; layout build (lower-type-register-words) decides all three cases.
  ;; `force-memory` (borrowed match of a spilled register-resident scrutinee)
  ;; overrides the value paths: scrut-var then holds the ADDRESS of the enum
  ;; bytes and tag/payloads are read through it like any memory enum.
  (let
    [scrut-words : i64 (lower-type-register-words ctx scrut-ty)]
    (if (and (> scrut-words 0) (not force-memory))
      (if (= scrut-words 2)
        (match (lower-emit-word
          state
          (ir.CompilerIrValue.Var scrut-var)
          0
          (ast.AstType.I64))
          [(LowerExpr.Expr tag-state tag-value _)
            (match tag-value
              [(ir.CompilerIrValue.Var tag-var)
                (lower-match-enum-arms
                  ctx
                  tag-state
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  tag-var
                  arms
                  merge-label
                  expr-ty
                  borrow-lifetime
                  ir.CompilerIrPhiInputList.Nil
                  true
                  false)]
              [_
                (ResultLowerExpr.Err
                  (box
                    (lower-diagnostic "lower: internal enum tag extract failed")))])])
        (lower-match-enum-arms
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          scrut-var
          arms
          merge-label
          expr-ty
          borrow-lifetime
          ir.CompilerIrPhiInputList.Nil
          false
          false))
      (match (lower-load-at-offset
        state
        (ir.CompilerIrValue.Var scrut-var)
        0
        (ast.AstType.I64))
        [(LowerExpr.Expr tag-state tag-value _)
          (match tag-value
            [(ir.CompilerIrValue.Var tag-var)
              (lower-match-enum-arms
                ctx
                tag-state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arms
                merge-label
                expr-ty
                borrow-lifetime
                ir.CompilerIrPhiInputList.Nil
                false
                false)]
            [_
              (ResultLowerExpr.Err
                (box (lower-diagnostic "lower: internal enum tag load failed")))])]))))

(define (lower-box-pattern-for-type?
  [ctx : tc_core.TcContext]
  [scrut-ty : ast.AstType]
  [name : i64]) : bool
  (if (lower-box-pattern-name? name)
    (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))
      [(ast.AstType.Box _) true]
      [_ false])
    false))

(define (lower-struct-pattern-for-type?
  [ctx : tc_core.TcContext]
  [scrut-ty : ast.AstType]
  [name : i64]) : bool
  (let
    [pattern-name : String (tc_core.tc-env-key-name-text name)]
    (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))
      [(ast.AstType.Struct struct-name)
        (tc_core.tc-struct-pattern-name-matches?
          ctx
          (tc_core.tc-nominal-name-id-display struct-name)
          pattern-name
          name)]
      [(ast.AstType.StructArgs struct-name _)
        (tc_core.tc-struct-pattern-name-matches?
          ctx
          (tc_core.tc-nominal-name-id-display struct-name)
          pattern-name
          name)]
      [_ false])))

(define (lower-bind-struct-field-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field-name-id : i64]
  [field-name : String]
  [pattern : ast.AstPattern]
  [field-ty : ast.AstType]) : ResultLowerEnv
  (match pattern
    [(ast.AstPattern.Wildcard) (ResultLowerEnv.Ok state env type-env)]
    [(ast.AstPattern.Var name _)
      (match (lower-struct-get-named
        ctx
        state
        base
        struct-id
        struct-name
        field-name-id
        field-name
        field-ty)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr field-state field-value _)
              (match field-value
                [(ir.CompilerIrValue.Var field-var)
                  (ResultLowerEnv.Ok
                    field-state
                    (sym_i64_env.sym-i64-bind-id env name field-var)
                    (tc_core.tc-bind-id type-env name field-ty))]
                [_
                  (ResultLowerEnv.Err
                    (box
                      (lower-diagnostic
                        "lower: internal struct field pattern load failed")))])])]
        [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)])]
    [(ast.AstPattern.Binding name)
      (match (lower-struct-get-named
        ctx
        state
        base
        struct-id
        struct-name
        field-name-id
        field-name
        field-ty)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr field-state field-value _)
              (match field-value
                [(ir.CompilerIrValue.Var field-var)
                  (ResultLowerEnv.Ok
                    field-state
                    (sym_i64_env.sym-i64-bind-id env name field-var)
                    (tc_core.tc-bind-id type-env name field-ty))]
                [_
                  (ResultLowerEnv.Err
                    (box
                      (lower-diagnostic
                        "lower: internal struct field pattern load failed")))])])]
        [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)])]
    [(ast.AstPattern.Tuple patterns-box)
      (match (lower-struct-get-named
        ctx
        state
        base
        struct-id
        struct-name
        field-name-id
        field-name
        field-ty)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr field-state field-value _)
              (lower-bind-tuple-pattern
                ctx
                field-state
                env
                type-env
                field-value
                field-ty
                (box-get patterns-box))])]
        [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)])]
    [(ast.AstPattern.Array patterns-box)
      (match (lower-struct-get-named
        ctx
        state
        base
        struct-id
        struct-name
        field-name-id
        field-name
        field-ty)
        [(ResultLowerExpr.Ok lowered)
          (match lowered
            [(LowerExpr.Expr field-state field-value _)
              (lower-bind-array-pattern
                ctx
                field-state
                env
                type-env
                field-value
                field-ty
                (box-get patterns-box))])]
        [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)])]
    [(ast.AstPattern.Variant name args-box)
      (if (lower-struct-pattern-for-type? ctx field-ty name)
        (match (lower-struct-get-named
          ctx
          state
          base
          struct-id
          struct-name
          field-name-id
          field-name
          field-ty)
          [(ResultLowerExpr.Ok lowered)
            (match lowered
              [(LowerExpr.Expr field-state field-value _)
                (lower-bind-struct-pattern
                  ctx
                  field-state
                  env
                  type-env
                  field-value
                  field-ty
                  (lower-struct-type-name-or-empty
                    (tc_core.tc-type-strip-region
                      (tc_core.tc-resolve-type ctx field-ty)))
                  (box-get args-box))])]
          [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)])
        (ResultLowerEnv.Err
          (box (lower-diagnostic "lower: unsupported struct field pattern"))))]
    [_
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: unsupported struct field pattern")))]))

(define (lower-bind-struct-pattern-fields
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [patterns : ast.AstPatternList]
  [fields : ast.AstFieldDefList]
  [types : ast.AstTypeList]) : ResultLowerEnv
  (lower-bind-struct-pattern-fields-at
    ctx
    state
    env
    type-env
    base
    struct-id
    struct-name
    patterns
    (& fields)
    0
    types))

(define (lower-bind-struct-pattern-fields-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [patterns : ast.AstPatternList]
  [fields : (& fields ast.AstFieldDefList)]
  [field-index : i64]
  [types : ast.AstTypeList]) : ResultLowerEnv
  (if (ast.ast-pattern-list-empty? (& patterns))
    (if (>= field-index (ast.ast-type-list-len (& types)))
      (ResultLowerEnv.Ok state env type-env)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: struct pattern arity mismatch"))))
    (let
      [pattern : ast.AstPattern
        (ast.ast-pattern-list-get (& patterns) 0 (ast.ast-pattern-fallback))]
      [rest-patterns : ast.AstPatternList (ast.ast-pattern-list-tail patterns)]
      (if (or
        (>= field-index (ast.ast-field-def-list-len fields))
        (>= field-index (ast.ast-type-list-len (& types))))
        (ResultLowerEnv.Err
          (box (lower-diagnostic "lower: struct pattern arity mismatch")))
        (match (ast.ast-field-def-list-get
          fields
          field-index
          (ast.ast-field-def-fallback))
          [(ast.AstFieldDef.Def field-name _ _)
            (let
              [ty : ast.AstType
                (tc_core.tc-context-type-get
                  ctx
                  (ast.ast-type-list-get
                    (& types)
                    field-index
                    (ast.ast-type-id-fallback)))]
              (match (lower-bind-struct-field-pattern
                ctx
                state
                env
                type-env
                base
                struct-id
                struct-name
                field-name
                (tc_core.tc-env-key-name-text field-name)
                pattern
                ty)
                [(ResultLowerEnv.Ok next-state next-env next-type-env)
                  (lower-bind-struct-pattern-fields-at
                    ctx
                    next-state
                    next-env
                    next-type-env
                    base
                    struct-id
                    struct-name
                    rest-patterns
                    fields
                    (+ field-index 1)
                    types)]
                [(ResultLowerEnv.Err message) (ResultLowerEnv.Err message)]))])))))

(define (lower-bind-struct-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [struct-name : String]
  [args : ast.AstPatternList]) : ResultLowerEnv
  (match (lower-struct-fields-id
    ctx
    (lower-struct-type-name-id-or scrut-ty -1)
    struct-name)
    [(parser.ResultAstFieldDefList.Ok fields)
      (match (tc_core.tc-struct-pattern-field-types-for-scrut
        ctx
        (lower-struct-type-name-id-or scrut-ty -1)
        scrut-ty
        fields)
        [(tc_core.ResultTcTypeList.Ok field-types)
          (lower-bind-struct-pattern-fields
            ctx
            state
            env
            type-env
            base
            (lower-struct-type-name-id-or scrut-ty -1)
            struct-name
            args
            fields
            field-types)]
        [(tc_core.ResultTcTypeList.Err message)
          (ResultLowerEnv.Err (box (lower-diagnostic message)))])]
    [(parser.ResultAstFieldDefList.Err message)
      (ResultLowerEnv.Err (box (lower-diagnostic message)))]))

(define (lower-bind-tuple-element-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [value : ir.CompilerIrValue]
  [pattern : ast.AstPattern]
  [elem-ty : ast.AstType]) : ResultLowerEnv
  (match pattern
    [(ast.AstPattern.Wildcard) (ResultLowerEnv.Ok state env type-env)]
    [(ast.AstPattern.Binding name)
      (match value
        [(ir.CompilerIrValue.Var value-var)
          (ResultLowerEnv.Ok
            state
            (sym_i64_env.sym-i64-bind-id env name value-var)
            (tc_core.tc-bind-id type-env name elem-ty))]
        [_
          (ResultLowerEnv.Err
            (box
              (lower-diagnostic
                "lower: internal tuple element pattern load failed")))])]
    [(ast.AstPattern.Var name _)
      (match value
        [(ir.CompilerIrValue.Var value-var)
          (ResultLowerEnv.Ok
            state
            (sym_i64_env.sym-i64-bind-id env name value-var)
            (tc_core.tc-bind-id type-env name elem-ty))]
        [_
          (ResultLowerEnv.Err
            (box
              (lower-diagnostic
                "lower: internal tuple element pattern load failed")))])]
    [(ast.AstPattern.Tuple patterns-box)
      (lower-bind-tuple-pattern
        ctx
        state
        env
        type-env
        value
        elem-ty
        (box-get patterns-box))]
    [(ast.AstPattern.Array patterns-box)
      (lower-bind-array-pattern
        ctx
        state
        env
        type-env
        value
        elem-ty
        (box-get patterns-box))]
    [(ast.AstPattern.Variant name args-box)
      (if (lower-box-pattern-for-type? ctx elem-ty name)
        (lower-bind-box-pattern
          ctx
          state
          env
          type-env
          value
          elem-ty
          (box-get args-box))
        (if (lower-struct-pattern-for-type? ctx elem-ty name)
          (lower-bind-struct-pattern
            ctx
            state
            env
            type-env
            value
            elem-ty
            (lower-struct-type-name-or-empty
              (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx elem-ty)))
            (box-get args-box))
          (ResultLowerEnv.Err
            (box (lower-diagnostic "lower: unsupported tuple element pattern")))))]
    [_
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: unsupported tuple element pattern")))]))

(define (lower-bind-tuple-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [tuple-ty : ast.AstType]
  [patterns : ast.AstPatternList]) : ResultLowerEnv
  (match (tc_core.tc-tuple-pattern-element-types ctx tuple-ty)
    [(tc_core.ResultTcTypeList.Ok elem-types)
      (lower-bind-tuple-pattern-at
        ctx
        state
        env
        type-env
        base
        (& patterns)
        (& elem-types)
        0
        0)]
    [(tc_core.ResultTcTypeList.Err message)
      (ResultLowerEnv.Err (box (lower-diagnostic message)))]))

(define (lower-bind-tuple-pattern-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [patterns : (& patterns ast.AstPatternList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [cursor : i64]) : ResultLowerEnv
  (if (>= index (ast.ast-pattern-list-len patterns))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerEnv.Ok state env type-env)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: tuple pattern arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: tuple pattern arity mismatch")))
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))]
        [elem-ty : ast.AstType
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [resolved : ast.AstType (tc_core.tc-resolve-type ctx elem-ty)]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        [next-cursor : i64 (+ offset (lower-type-size ctx resolved))]
        (if (match pattern
          [(ast.AstPattern.Wildcard) true]
          [_ false])
          (lower-bind-tuple-pattern-at
            ctx
            state
            env
            type-env
            base
            patterns
            types
            (+ index 1)
            next-cursor)
          (match (lower-load-inline-value-at-offset
            ctx
            state
            base
            offset
            elem-ty
            (lower-state-mode state))
            [(LowerExpr.Expr elem-state elem-value _)
              (match (lower-bind-tuple-element-pattern
                ctx
                elem-state
                env
                type-env
                elem-value
                pattern
                elem-ty)
                [(ResultLowerEnv.Ok next-state next-env next-type-env)
                  (lower-bind-tuple-pattern-at
                    ctx
                    next-state
                    next-env
                    next-type-env
                    base
                    patterns
                    types
                    (+ index 1)
                    next-cursor)]
                [(ResultLowerEnv.Err message) (ResultLowerEnv.Err message)])]))))))

(define (lower-bind-array-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [array-ty : ast.AstType]
  [patterns : ast.AstPatternList]) : ResultLowerEnv
  (match (tc_core.tc-array-pattern-info ctx array-ty)
    [(tc_core.ResultTcArrayPatternInfo.Ok elem-ty count)
      (lower-bind-array-pattern-at
        ctx
        state
        env
        type-env
        base
        (& patterns)
        elem-ty
        count
        0)]
    [(tc_core.ResultTcArrayPatternInfo.Err message)
      (ResultLowerEnv.Err (box (lower-diagnostic message)))]))

(define (lower-bind-array-pattern-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [patterns : (& patterns ast.AstPatternList)]
  [elem-ty : ast.AstType]
  [count : i64]
  [index : i64]) : ResultLowerEnv
  (if (>= index (ast.ast-pattern-list-len patterns))
    (if (>= index count)
      (ResultLowerEnv.Ok state env type-env)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: fixed-array pattern arity mismatch"))))
    (if (>= index count)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: fixed-array pattern arity mismatch")))
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))]
        [resolved : ast.AstType (tc_core.tc-resolve-type ctx elem-ty)]
        [offset : i64 (* index (lower-type-size ctx resolved))]
        (if (match pattern
          [(ast.AstPattern.Wildcard) true]
          [_ false])
          (lower-bind-array-pattern-at
            ctx
            state
            env
            type-env
            base
            patterns
            elem-ty
            count
            (+ index 1))
          (match (lower-load-inline-value-at-offset
            ctx
            state
            base
            offset
            elem-ty
            (lower-state-mode state))
            [(LowerExpr.Expr elem-state elem-value _)
              (match (lower-bind-tuple-element-pattern
                ctx
                elem-state
                env
                type-env
                elem-value
                pattern
                elem-ty)
                [(ResultLowerEnv.Ok next-state next-env next-type-env)
                  (lower-bind-array-pattern-at
                    ctx
                    next-state
                    next-env
                    next-type-env
                    base
                    patterns
                    elem-ty
                    count
                    (+ index 1))]
                [(ResultLowerEnv.Err message) (ResultLowerEnv.Err message)])]))))))

(define (lower-bind-borrowed-tuple-sub-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [borrow-lifetime : i64]
  [address : ir.CompilerIrValue]
  [pattern : ast.AstPattern]
  [elem-ty : ast.AstType]) : ResultLowerEnv
  (match pattern
    [(ast.AstPattern.Wildcard) (ResultLowerEnv.Ok state env type-env)]
    [(ast.AstPattern.Binding name)
      (match address
        [(ir.CompilerIrValue.Var address-var)
          (let
            [ref-ty : ast.AstType
              (tc_core.tc-borrowed-field-ref-type borrow-lifetime elem-ty)]
            (ResultLowerEnv.Ok
              state
              (sym_i64_env.sym-i64-bind-id env name address-var)
              (tc_core.tc-bind-id type-env name ref-ty)))]
        [_
          (ResultLowerEnv.Err
            (box
              (lower-diagnostic
                "lower: internal borrowed tuple element address failed")))])]
    [(ast.AstPattern.Var name _)
      (match address
        [(ir.CompilerIrValue.Var address-var)
          (let
            [ref-ty : ast.AstType
              (tc_core.tc-borrowed-field-ref-type borrow-lifetime elem-ty)]
            (ResultLowerEnv.Ok
              state
              (sym_i64_env.sym-i64-bind-id env name address-var)
              (tc_core.tc-bind-id type-env name ref-ty)))]
        [_
          (ResultLowerEnv.Err
            (box
              (lower-diagnostic
                "lower: internal borrowed tuple element address failed")))])]
    [(ast.AstPattern.Tuple patterns-box)
      (lower-bind-borrowed-tuple-pattern
        ctx
        state
        env
        type-env
        borrow-lifetime
        address
        elem-ty
        (box-get patterns-box))]
    [(ast.AstPattern.Array patterns-box)
      (lower-bind-borrowed-array-pattern
        ctx
        state
        env
        type-env
        borrow-lifetime
        address
        elem-ty
        (box-get patterns-box))]
    [(ast.AstPattern.Variant name args-box)
      (if (lower-struct-pattern-for-type? ctx elem-ty name)
        (lower-bind-borrowed-struct-pattern
          ctx
          state
          env
          type-env
          borrow-lifetime
          address
          elem-ty
          (lower-struct-type-name-or-empty
            (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx elem-ty)))
          (box-get args-box))
        (ResultLowerEnv.Err
          (box
            (lower-diagnostic
              "lower: unsupported borrowed tuple element pattern"))))]
    [_
      (ResultLowerEnv.Err
        (box
          (lower-diagnostic "lower: unsupported borrowed tuple element pattern")))]))

(define (lower-bind-borrowed-tuple-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [borrow-lifetime : i64]
  [base : ir.CompilerIrValue]
  [tuple-ty : ast.AstType]
  [patterns : ast.AstPatternList]) : ResultLowerEnv
  (match (tc_core.tc-tuple-pattern-element-types ctx tuple-ty)
    [(tc_core.ResultTcTypeList.Ok elem-types)
      (lower-bind-borrowed-tuple-pattern-at
        ctx
        state
        env
        type-env
        borrow-lifetime
        base
        (& patterns)
        (& elem-types)
        0
        0)]
    [(tc_core.ResultTcTypeList.Err message)
      (ResultLowerEnv.Err (box (lower-diagnostic message)))]))

(define (lower-bind-borrowed-tuple-pattern-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [borrow-lifetime : i64]
  [base : ir.CompilerIrValue]
  [patterns : (& patterns ast.AstPatternList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [cursor : i64]) : ResultLowerEnv
  (if (>= index (ast.ast-pattern-list-len patterns))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerEnv.Ok state env type-env)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: tuple pattern arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: tuple pattern arity mismatch")))
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))]
        [elem-ty : ast.AstType
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [resolved : ast.AstType (tc_core.tc-resolve-type ctx elem-ty)]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        [next-cursor : i64 (+ offset (lower-type-size ctx resolved))]
        [binds-name : bool
          (match pattern
            [(ast.AstPattern.Binding _) true]
            [(ast.AstPattern.Var _ _) true]
            [_ false])]
        [ref-ty : ast.AstType
          (tc_core.tc-borrowed-field-ref-type borrow-lifetime elem-ty)]
        (if (match pattern
          [(ast.AstPattern.Wildcard) true]
          [_ false])
          (lower-bind-borrowed-tuple-pattern-at
            ctx
            state
            env
            type-env
            borrow-lifetime
            base
            patterns
            types
            (+ index 1)
            next-cursor)
          (match (if (and binds-name (lower-str-ref-type? ctx ref-ty))
            (lower-borrowed-payload-ref-expr
              ctx
              state
              base
              offset
              elem-ty
              ref-ty)
            (lower-gep-byte state base offset))
            [(LowerExpr.Expr address-state address _)
              (match (lower-bind-borrowed-tuple-sub-pattern
                ctx
                address-state
                env
                type-env
                borrow-lifetime
                address
                pattern
                elem-ty)
                [(ResultLowerEnv.Ok next-state next-env next-type-env)
                  (lower-bind-borrowed-tuple-pattern-at
                    ctx
                    next-state
                    next-env
                    next-type-env
                    borrow-lifetime
                    base
                    patterns
                    types
                    (+ index 1)
                    next-cursor)]
                [(ResultLowerEnv.Err message) (ResultLowerEnv.Err message)])]))))))

