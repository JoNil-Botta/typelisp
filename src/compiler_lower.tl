  (LowerVectorMapBroadcastArray i64 CompilerIrValue)
  (LowerVectorMapLaneIndex)
  (LowerVectorMapLaneCount)
  (LowerVectorMapBinOp
    CompilerIrBinOp
    (Box LowerVectorMapValue)
    (Box LowerVectorMapValue)))

(defenum LowerMaybeVectorMapValue
