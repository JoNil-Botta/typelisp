            (lower-borrowed-payload-ref-expr
              ctx
              state
              base
              offset
              elem-ty
              ref-ty)
            (lower-gep-byte state base offset))
            [(LowerExpr.Expr address-state address _)
              (match (lower-bind-borrowed-tuple-sub-pattern
                ctx
                address-state
                env
                type-env
                borrow-lifetime
                address
                pattern
                elem-ty)
                [(ResultLowerEnv.Ok next-state next-env next-type-env)
                  (lower-bind-borrowed-array-pattern-at
                    ctx
                    next-state
                    next-env
                    next-type-env
                    borrow-lifetime
                    base
                    patterns
                    elem-ty
                    count
                    (+ index 1))]
                [(ResultLowerEnv.Err message) (ResultLowerEnv.Err message)])]))))))

(define (lower-bind-borrowed-struct-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [borrow-lifetime : i64]
  [base : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [struct-name : String]
  [patterns : ast.AstPatternList]) : ResultLowerEnv
  (match (lower-struct-fields-id
    ctx
    (lower-struct-type-name-id-or scrut-ty -1)
    struct-name)
    [(parser.ResultAstFieldDefList.Ok fields)
      (match (tc_core.tc-struct-pattern-field-types-for-scrut
        ctx
        (lower-struct-type-name-id-or scrut-ty -1)
        scrut-ty
        fields)
        [(tc_core.ResultTcTypeList.Ok field-types)
          (lower-bind-borrowed-struct-pattern-at
            ctx
            state
            env
            type-env
            borrow-lifetime
            base
            (lower-struct-type-name-id-or scrut-ty -1)
            struct-name
            (& patterns)
            (& fields)
            (& field-types)
            0)]
        [(tc_core.ResultTcTypeList.Err message)
          (ResultLowerEnv.Err (box (lower-diagnostic message)))])]
    [(parser.ResultAstFieldDefList.Err message)
      (ResultLowerEnv.Err (box (lower-diagnostic message)))]))

(define (lower-bind-borrowed-struct-pattern-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [borrow-lifetime : i64]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [patterns : (& patterns ast.AstPatternList)]
  [fields : (& fields ast.AstFieldDefList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultLowerEnv
  (if (>= index (ast.ast-pattern-list-len patterns))
    (if (>= index (ast.ast-type-list-len types))
      (ResultLowerEnv.Ok state env type-env)
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: struct pattern arity mismatch"))))
    (if (or
      (>= index (ast.ast-field-def-list-len fields))
      (>= index (ast.ast-type-list-len types)))
      (ResultLowerEnv.Err
        (box (lower-diagnostic "lower: struct pattern arity mismatch")))
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))]
        [field-ty : ast.AstType
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        (match (ast.ast-field-def-list-get
          fields
          index
          (ast.ast-field-def-fallback))
          [(ast.AstFieldDef.Def field-name _ _)
            (match (lower-struct-field-info
              ctx
              struct-id
              struct-name
              (tc_core.tc-env-key-name-text field-name))
              [(ResultLowerFieldInfo.Ok info)
                (match info
                  [(LowerFieldInfo.Info offset _)
                    (if (match pattern
                      [(ast.AstPattern.Wildcard) true]
                      [_ false])
                      (lower-bind-borrowed-struct-pattern-at
                        ctx
                        state
                        env
                        type-env
                        borrow-lifetime
                        base
                        struct-id
                        struct-name
                        patterns
                        fields
                        types
                        (+ index 1))
                      (match (lower-gep-byte state base offset)
                        [(LowerExpr.Expr address-state address _)
                          (match (lower-bind-borrowed-tuple-sub-pattern
                            ctx
                            address-state
                            env
                            type-env
                            borrow-lifetime
                            address
                            pattern
                            field-ty)
                            [(ResultLowerEnv.Ok
                                next-state
                                next-env
                                next-type-env)
                              (lower-bind-borrowed-struct-pattern-at
                                ctx
                                next-state
                                next-env
                                next-type-env
                                borrow-lifetime
                                base
                                struct-id
                                struct-name
                                patterns
                                fields
                                types
                                (+ index 1))]
                            [(ResultLowerEnv.Err message)
                              (ResultLowerEnv.Err message)])]))])]
              [(ResultLowerFieldInfo.Err message) (ResultLowerEnv.Err message)])])))))

(define (lower-bind-match-catch-all-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : ResultLowerEnv
  (match pattern
    [(ast.AstPattern.Binding name)
      (ResultLowerEnv.Ok
        state
        (sym_i64_env.sym-i64-bind-id env name scrut-var)
        (tc_core.tc-bind-id type-env name scrut-ty))]
    [(ast.AstPattern.Tuple patterns-box)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx scrut-ty))
        [(ast.AstType.Tuple _)
          (lower-bind-tuple-pattern
            ctx
            state
            env
            type-env
            (ir.CompilerIrValue.Var scrut-var)
            scrut-ty
            (box-get patterns-box))]
        [(ast.AstType.Ref borrow-lifetime referent-box)
          (let
            [referent-ty : ast.AstType
              (tc_core.tc-context-type-get ctx referent-box)]
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type ctx referent-ty))
              [(ast.AstType.Tuple _)
                (lower-bind-borrowed-tuple-pattern
                  ctx
                  state
                  env
                  type-env
                  borrow-lifetime
                  (ir.CompilerIrValue.Var scrut-var)
                  referent-ty
                  (box-get patterns-box))]
              [_
                (ResultLowerEnv.Err
                  (box
                    (lower-diagnostic
                      "lower: tuple pattern requires Tuple scrutinee")))]))]
        [_
          (ResultLowerEnv.Err
            (box
              (lower-diagnostic "lower: tuple pattern requires Tuple scrutinee")))])]
    [(ast.AstPattern.Array patterns-box)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx scrut-ty))
        [(ast.AstType.Array _ _)
          (lower-bind-array-pattern
            ctx
            state
            env
            type-env
            (ir.CompilerIrValue.Var scrut-var)
            scrut-ty
            (box-get patterns-box))]
        [(ast.AstType.Ref borrow-lifetime referent-box)
          (let
            [referent-ty : ast.AstType
              (tc_core.tc-context-type-get ctx referent-box)]
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type ctx referent-ty))
              [(ast.AstType.Array _ _)
                (lower-bind-borrowed-array-pattern
                  ctx
                  state
                  env
                  type-env
                  borrow-lifetime
                  (ir.CompilerIrValue.Var scrut-var)
                  referent-ty
                  (box-get patterns-box))]
              [_
                (ResultLowerEnv.Err
                  (box
                    (lower-diagnostic
                      "lower: array pattern requires fixed Array scrutinee")))]))]
        [_
          (ResultLowerEnv.Err
            (box
              (lower-diagnostic
                "lower: array pattern requires fixed Array scrutinee")))])]
    [(ast.AstPattern.Variant name args-box)
      (if (lower-box-pattern-for-type? ctx scrut-ty name)
        (lower-bind-box-pattern
          ctx
          state
          env
          type-env
          (ir.CompilerIrValue.Var scrut-var)
          scrut-ty
          (box-get args-box))
        (if (lower-struct-pattern-for-type? ctx scrut-ty name)
          (lower-bind-struct-pattern
            ctx
            state
            env
            type-env
            (ir.CompilerIrValue.Var scrut-var)
            scrut-ty
            (lower-struct-type-name-or-empty
              (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx scrut-ty)))
            (box-get args-box))
          (ResultLowerEnv.Err
            (box (lower-diagnostic "lower: unsupported match pattern")))))]
    [_ (ResultLowerEnv.Ok state env type-env)]))

(define (lower-match-arms
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [phi-inputs : ir.CompilerIrPhiInputList]) : ResultLowerExpr
  (if (ast.ast-match-arm-list-empty? (& arms))
    (ResultLowerExpr.Err (box (lower-diagnostic "lower: match with no arms")))
    (let
      [arm : ast.AstMatchArm
        (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback))]
      [rest : ast.AstMatchArmList (ast.ast-match-arm-list-tail arms)]
      (if (ast.ast-match-arm-list-empty? (& rest))
        (lower-match-catch-all
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          arm
          merge-label
          expr-ty
          phi-inputs)
        (match arm
          [(ast.AstMatchArm.Arm pat body-box)
            (let
              [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
              (match pat
                [(ast.AstPattern.Literal lit)
                  (lower-match-literal-arm
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    lit
                    body
                    rest
                    merge-label
                    expr-ty
                    phi-inputs)]
                [(ast.AstPattern.Binding _)
                  (lower-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    merge-label
                    expr-ty
                    phi-inputs)]
                [(ast.AstPattern.Wildcard)
                  (lower-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    merge-label
                    expr-ty
                    phi-inputs)]
                [(ast.AstPattern.Tuple _)
                  (lower-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    merge-label
                    expr-ty
                    phi-inputs)]
                [(ast.AstPattern.Array _)
                  (lower-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    merge-label
                    expr-ty
                    phi-inputs)]
                [(ast.AstPattern.Variant variant-name _)
                  (if (lower-box-pattern-for-type? ctx scrut-ty variant-name)
                    (lower-match-catch-all
                      ctx
                      state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arm
                      merge-label
                      expr-ty
                      phi-inputs)
                    (if (lower-struct-pattern-for-type?
                      ctx
                      scrut-ty
                      variant-name)
                      (lower-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        merge-label
                        expr-ty
                        phi-inputs)
                      (ResultLowerExpr.Err
                        (box
                          (lower-diagnostic
                            (lower-unsupported-match-pattern-message
                              ctx
                              scrut-ty
                              (tc_core.tc-env-key-name-text variant-name)))))))]
                [_
                  (ResultLowerExpr.Err
                    (box (lower-diagnostic "lower: unsupported match pattern")))]))])))))

(define (lower-match-enum-final-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arm : ast.AstMatchArm]
  [pat : ast.AstPattern]
  [body : ast.AstExpr]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [phi-inputs : ir.CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match pat
    [(ast.AstPattern.Wildcard)
      (lower-match-catch-all
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arm
        merge-label
        expr-ty
        phi-inputs)]
    [(ast.AstPattern.Binding variant-name)
      (lower-match-variant-final
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        variant-name
        (ast.ast-pattern-list-new)
        body
        merge-label
        expr-ty
        borrow-lifetime
        phi-inputs
        scrut-reg-group?)]
    [(ast.AstPattern.Variant variant-name args-box)
      (let
        [args : ast.AstPatternList (box-get args-box)]
        (lower-match-variant-final
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          variant-name
          args
          body
          merge-label
          expr-ty
          borrow-lifetime
          phi-inputs
          scrut-reg-group?))]
    [_
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: unsupported enum match pattern")))]))

(define (lower-match-enum-branch-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [arm : ast.AstMatchArm]
  [pat : ast.AstPattern]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [phi-inputs : ir.CompilerIrPhiInputList]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerExpr
  (match pat
    [(ast.AstPattern.Wildcard)
      (lower-match-catch-all
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arm
        merge-label
        expr-ty
        phi-inputs)]
    [(ast.AstPattern.Binding variant-name)
      (lower-match-variant-arm
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        tag-var
        variant-name
        (ast.ast-pattern-list-new)
        body
        rest
        merge-label
        expr-ty
        borrow-lifetime
        phi-inputs
        scrut-reg-group?
        total-enum-switch?)]
    [(ast.AstPattern.Variant variant-name args-box)
      (let
        [args : ast.AstPatternList (box-get args-box)]
        (lower-match-variant-arm
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          tag-var
          variant-name
          args
          body
          rest
          merge-label
          expr-ty
          borrow-lifetime
          phi-inputs
          scrut-reg-group?
          total-enum-switch?))]
    [_
      (ResultLowerExpr.Err
        (box (lower-diagnostic "lower: unsupported enum match pattern")))]))

(define (lower-match-enum-arms
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [arms : ast.AstMatchArmList]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [phi-inputs : ir.CompilerIrPhiInputList]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerExpr
  (if (ast.ast-match-arm-list-empty? (& arms))
    (ResultLowerExpr.Err (box (lower-diagnostic "lower: match with no arms")))
    (let
      [arm : ast.AstMatchArm
        (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback))]
      [rest : ast.AstMatchArmList (ast.ast-match-arm-list-tail arms)]
      (match arm
        [(ast.AstMatchArm.Arm pat body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (if (ast.ast-match-arm-list-empty? (& rest))
              (lower-match-enum-final-pattern
                ctx
                state
                env
                type-env
                scrut-var
                scrut-ty
                arm
                pat
                body
                merge-label
                expr-ty
                borrow-lifetime
                phi-inputs
                scrut-reg-group?)
              (lower-match-enum-branch-pattern
                ctx
                state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arm
                pat
                body
                rest
                merge-label
                expr-ty
                borrow-lifetime
                phi-inputs
                scrut-reg-group?
                total-enum-switch?)))]))))

(define (lower-match-variant-final
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [variant-name-id : i64]
  [args : ast.AstPatternList]
  [body : ast.AstExpr]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [phi-inputs : ir.CompilerIrPhiInputList]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match ctx
    [(tc_core.TcContext _ symbols registries _ _ _ _ _ _)
      (let
        [variant-name : String (tc_core.tc-env-key-name-text variant-name-id)]
        [resolved-scrut-ty : ast.AstType
          (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))]
        [handle : i64
          (lower-variant-constructor-handle-id-or
            ctx
            variant-name
            variant-name-id
            resolved-scrut-ty
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? handle)
          (match (csym.compiler-registries-variant-fields-indexed
            symbols
            handle)
            [(parser.ResultAstTypeList.Ok fields)
              (let
                [resolved-fields : ast.AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    resolved-scrut-ty
                    fields)]
                ;; The final arm has no next-arm continuation, so a refutable
                ;; payload subpattern here would have nowhere to fall through to;
                ;; require a trailing catch-all instead.
                (if (lower-pattern-list-refutable-for-types?
                  ctx
                  args
                  resolved-fields)
                  (ResultLowerExpr.Err
                    (box
                      (lower-diagnostic
                        "lower: refutable payload pattern in final match arm requires a trailing catch-all")))
                  (match (lower-bind-match-variant-payloads
                    ctx
                    state
                    env
                    type-env
                    borrow-lifetime
                    (ir.CompilerIrValue.Var scrut-var)
                    args
                    resolved-fields
                    (lower-state-mode state)
                    (lower-enum-type-name-id-or resolved-scrut-ty -1)
                    (lower-enum-type-name-or-empty resolved-scrut-ty)
                    variant-name
                    (lower-variant-handle-name-id-or ctx handle variant-name-id)
                    0
                    8
                    merge-label
                    scrut-reg-group?)
                    [(ResultLowerEnv.Ok body-start body-env body-type-env)
                      (match (lower-expr-expected
                        ctx
                        body-start
                        body-env
                        body-type-env
                        body
                        expr-ty
                        body)
                        [(ResultLowerExpr.Ok body-lowered)
                          (match body-lowered
                            [(LowerExpr.Expr body-state body-value body-ty)
                              (let
                                [body-end-label : i64
                                  (lower-state-current-label body-state)]
                                (if (tc_core.tc-never-type? body-ty)
                                  (lower-match-finish
                                    ctx
                                    body-state
                                    merge-label
                                    expr-ty
                                    phi-inputs)
                                  (lower-match-finish
                                    ctx
                                    (lower-state-emit
                                      body-state
                                      (ir.CompilerIrInstr.Jump merge-label))
                                    merge-label
                                    expr-ty
                                    (ir.compiler-ir-phi-input-cons
                                      body-value
                                      body-end-label
                                      phi-inputs))))])]
                        [(ResultLowerExpr.Err message)
                          (ResultLowerExpr.Err message)])]
                    [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)])))]
            [(parser.ResultAstTypeList.Err message)
              (ResultLowerExpr.Err (box (lower-diagnostic message)))])
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))))]))

(define (lower-match-variant-body
  [ctx : tc_core.TcContext]
  [body-start : LowerState]
  [next-label : i64]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [variant-name : String]
  [variant-name-id : i64]
  [fields : ast.AstTypeList]
  [args : ast.AstPatternList]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [phi-inputs : ir.CompilerIrPhiInputList]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerExpr
  (match (lower-bind-match-variant-payloads
    ctx
    body-start
    env
    type-env
    borrow-lifetime
    (ir.CompilerIrValue.Var scrut-var)
    args
    fields
    (lower-state-mode body-start)
    (lower-enum-type-name-id-or scrut-ty -1)
    (lower-enum-type-name-or-empty scrut-ty)
    variant-name
    variant-name-id
    0
    8
    next-label
    scrut-reg-group?)
    [(ResultLowerEnv.Ok bound-state body-env body-type-env)
      (match (lower-expr-expected
        ctx
        bound-state
        body-env
        body-type-env
        body
        expr-ty
        body)
        [(ResultLowerExpr.Ok body-lowered)
          (match body-lowered
            [(LowerExpr.Expr body-state body-value body-ty)
              (let
                [body-end-label : i64 (lower-state-current-label body-state)]
                (lower-match-enum-arms
                  ctx
                  (if (tc_core.tc-never-type? body-ty)
                    (lower-state-finish-block body-state next-label)
                    (lower-state-finish-block
                      (lower-state-emit
                        body-state
                        (ir.CompilerIrInstr.Jump merge-label))
                      next-label))
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  tag-var
                  rest
                  merge-label
                  expr-ty
                  borrow-lifetime
                  (if (tc_core.tc-never-type? body-ty)
                    phi-inputs
                    (ir.compiler-ir-phi-input-cons
                      body-value
                      body-end-label
                      phi-inputs))
                  scrut-reg-group?
                  total-enum-switch?))])]
        [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
    [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)]))

;; The switch-form pass is deliberately the only place that may materialize
;; the final enum tag and unreachable default. Lowering keeps the classic
;; fallthrough instruction shape. Once exactly four explicit comparisons
;; remain, their false-edge suffix carries TotalEnumBranch proof. Keeping the
;; proof on only this terminal suffix matters because switch formation may
;; split a long comparison chain: an earlier chunk's default still has more
;; enum tags to test and must remain checked. Labels keep the old display
;; spelling only for byte-stable IR/assembly. Small matches therefore remain
;; byte-for-byte identical at the lowered-IR stage.
(define (lower-total-enum-switch-rest-explicit-from?
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-match-arm-list-len arms))
    true
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm pat _)
        (match pat
          [(ast.AstPattern.Binding _)
            (lower-total-enum-switch-rest-explicit-from? arms (+ index 1))]
          [(ast.AstPattern.Variant _ _)
            (lower-total-enum-switch-rest-explicit-from? arms (+ index 1))]
          [_ false])])))

(define (lower-total-enum-switch-next?
  [total-enum-switch? : bool]
  [rest : (& rest ast.AstMatchArmList)]) : bool
  (or
    total-enum-switch?
    (and
      (= (ast.ast-match-arm-list-len rest) 4)
      (lower-total-enum-switch-rest-explicit-from? rest 0))))

(define (lower-enum-match-next-label-base
  [total-enum-switch? : bool]
  [rest : ast.AstMatchArmList]) : String
  ;; Preserve the old diagnostic spellings without consulting them for
  ;; semantics. The explicit proof is threaded only through this match's
  ;; outer compare chain and cannot leak into a nested arm body.
  (let
    [remaining : i64 (ast.ast-match-arm-list-len (& rest))]
    (if (and total-enum-switch? (<= remaining 4))
      (if (= remaining 1)
        "match_total_enum_default"
        "match_total_enum_chain")
      "match_next")))

(define (lower-match-variant-arm
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [variant-name-id : i64]
  [args : ast.AstPatternList]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [phi-inputs : ir.CompilerIrPhiInputList]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerExpr
  (match ctx
    [(tc_core.TcContext _ symbols registries _ _ _ _ _ _)
      (let
        [variant-name : String (tc_core.tc-env-key-name-text variant-name-id)]
        [resolved-scrut-ty : ast.AstType
          (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))]
        [handle : i64
          (lower-variant-constructor-handle-id-or
            ctx
            variant-name
            variant-name-id
            resolved-scrut-ty
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? handle)
          (match (csym.compiler-registries-variant-fields-indexed
            symbols
            handle)
            [(parser.ResultAstTypeList.Ok fields)
              (let
                [next-total-enum-switch? : bool
                  (lower-total-enum-switch-next? total-enum-switch? (& rest))]
                [resolved-fields : ast.AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    resolved-scrut-ty
                    fields)]
                (match (lower-state-alloc-var state)
                  [(LowerAlloc.Alloc eq-alloc eq-var)
                    (let
                      [eq-state : LowerState
                        (lower-state-emit
                          eq-alloc
                          (ir.CompilerIrInstr.BinOp
                            eq-var
                            ir.CompilerIrBinOp.Eq
                            (ir.CompilerIrValue.Var tag-var)
                            (ir.CompilerIrValue.I64
                              (csym.compiler-registry-handle-child-index handle))
                            (ast.AstType.I64)))]
                      (match (lower-state-fresh-label eq-state "match_arm")
                        [(LowerLabel.Label body-label-state body-label)
                          (match (lower-state-fresh-label
                            body-label-state
                            (lower-enum-match-next-label-base
                              next-total-enum-switch?
                              rest))
                            [(LowerLabel.Label next-label-state next-label)
                              (let
                                [body-start : LowerState
                                  (lower-state-finish-block
                                    (lower-state-emit
                                      next-label-state
                                      (if next-total-enum-switch?
                                        (ir.CompilerIrInstr.TotalEnumBranch
                                          (ir.CompilerIrValue.Var eq-var)
                                          body-label
                                          next-label)
                                        (ir.CompilerIrInstr.Branch
                                          (ir.CompilerIrValue.Var eq-var)
                                          body-label
                                          next-label)))
                                    body-label)]
                                (lower-match-variant-body
                                  ctx
                                  body-start
                                  next-label
                                  env
                                  type-env
                                  scrut-var
                                  scrut-ty
                                  tag-var
                                  variant-name
                                  (lower-variant-handle-name-id-or
                                    ctx
                                    handle
                                    variant-name-id)
                                  resolved-fields
                                  args
                                  body
                                  rest
                                  merge-label
                                  expr-ty
                                  borrow-lifetime
                                  phi-inputs
                                  scrut-reg-group?
                                  next-total-enum-switch?))])]))]))]
            [(parser.ResultAstTypeList.Err message)
              (ResultLowerExpr.Err (box (lower-diagnostic message)))])
          (ResultLowerExpr.Err
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))))]))

(define (lower-match-literal-arm
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [lit : ast.AstLiteral]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [phi-inputs : ir.CompilerIrPhiInputList]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc eq-alloc eq-var)
      (let
        [eq-state : LowerState
          (lower-state-emit
            eq-alloc
            (ir.CompilerIrInstr.BinOp
              eq-var
              ir.CompilerIrBinOp.Eq
              (ir.CompilerIrValue.Var scrut-var)
              (lower-literal-value-with-type lit scrut-ty)
              scrut-ty))]
        (match (lower-state-fresh-label eq-state "match_arm")
          [(LowerLabel.Label body-label-state body-label)
            (match (lower-state-fresh-label body-label-state "match_next")
              [(LowerLabel.Label next-label-state next-label)
                (let
                  [body-start : LowerState
                    (lower-state-finish-block
                      (lower-state-emit
                        next-label-state
                        (ir.CompilerIrInstr.Branch
                          (ir.CompilerIrValue.Var eq-var)
                          body-label
                          next-label))
                      body-label)]
                  (match (lower-expr-expected
                    ctx
                    body-start
                    env
                    type-env
                    body
                    expr-ty
                    body)
                    [(ResultLowerExpr.Ok body-lowered)
                      (match body-lowered
                        [(LowerExpr.Expr body-state body-value body-ty)
                          (let
                            [body-end-label : i64
                              (lower-state-current-label body-state)]
                            (lower-match-arms
                              ctx
                              (if (tc_core.tc-never-type? body-ty)
                                (lower-state-finish-block body-state next-label)
                                (lower-state-finish-block
                                  (lower-state-emit
                                    body-state
                                    (ir.CompilerIrInstr.Jump merge-label))
                                  next-label))
                              env
                              type-env
                              scrut-var
                              scrut-ty
                              rest
                              merge-label
                              expr-ty
                              (if (tc_core.tc-never-type? body-ty)
                                phi-inputs
                                (ir.compiler-ir-phi-input-cons
                                  body-value
                                  body-end-label
                                  phi-inputs))))])]
                    [(ResultLowerExpr.Err message)
                      (ResultLowerExpr.Err message)]))])]))]))

(define (lower-match-catch-all
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arm : ast.AstMatchArm]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [phi-inputs : ir.CompilerIrPhiInputList]) : ResultLowerExpr
  (match arm
    [(ast.AstMatchArm.Arm pat body-box)
      (let
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (match (lower-bind-match-catch-all-pattern
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          pat)
          [(ResultLowerEnv.Ok body-start body-env body-type-env)
            (match (lower-expr-expected
              ctx
              body-start
              body-env
              body-type-env
              body
              expr-ty
              body)
              [(ResultLowerExpr.Ok body-lowered)
                (match body-lowered
                  [(LowerExpr.Expr body-state body-value body-ty)
                    (let
                      [body-end-label : i64
                        (lower-state-current-label body-state)]
                      (if (tc_core.tc-never-type? body-ty)
                        (lower-match-finish
                          ctx
                          body-state
                          merge-label
                          expr-ty
                          phi-inputs)
                        (lower-match-finish
                          ctx
                          (lower-state-emit
                            body-state
                            (ir.CompilerIrInstr.Jump merge-label))
                          merge-label
                          expr-ty
                          (ir.compiler-ir-phi-input-cons
                            body-value
                            body-end-label
                            phi-inputs))))])]
              [(ResultLowerExpr.Err message) (ResultLowerExpr.Err message)])]
          [(ResultLowerEnv.Err message) (ResultLowerExpr.Err message)]))]))

(define (lower-phi-input-list-empty? [phi-inputs : ir.CompilerIrPhiInputList]) : bool
  (match (ir.compiler-ir-phi-input-list-force-cons phi-inputs)
    [(ir.CompilerIrPhiInputList.Nil) true]
    [_ false]))

(define (lower-match-finish
  [ctx : tc_core.TcContext]
  [state : LowerState (:consume)]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [phi-inputs : ir.CompilerIrPhiInputList]) : ResultLowerExpr
  (let
    [merge-start : LowerState (lower-state-finish-block state merge-label)]
    [expr-ir-ty : ast.AstType
      (lower-one-word-register-storage-type ctx expr-ty)]
    (if (lower-phi-input-list-empty? phi-inputs)
      (ResultLowerExpr.Ok
        (LowerExpr.Expr merge-start ir.CompilerIrValue.Unit (ast.AstType.Never)))
      (match expr-ty
        [(ast.AstType.Unit)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr merge-start ir.CompilerIrValue.Unit expr-ty))]
        [_
          (match (lower-state-alloc-var merge-start)
            [(LowerAlloc.Alloc allocated var-id)
              (ResultLowerExpr.Ok
                (LowerExpr.Expr
                  (lower-state-emit
                    allocated
                    (ir.CompilerIrInstr.Phi var-id phi-inputs expr-ir-ty))
                  (ir.CompilerIrValue.Var var-id)
                  expr-ty))])]))))

(define (lower-tail-call-var-unshadowed?
  [env : sym_i64_env.SymI64Env]
  [name : i64]) : bool
  (not (sym_i64_env.sym-i64-contains-id env name)))

(define (lower-tail-call-local-indirect-safe?
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]) : bool
  (if (sym_i64_env.sym-i64-contains-id env name)
    (not (lower-type-env-contains-reference? type-env))
    true))

(define (lower-tail-call-reference-capturing-lambda?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [callee : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan callee)
    [(ast.AstExpr.Ann inner-box _)
      (lower-tail-call-reference-capturing-lambda?
        ctx
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Cast inner-box _)
      (lower-tail-call-reference-capturing-lambda?
        ctx
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(ast.AstLambda.Lambda params _ body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (tc_core.tc-lambda-captures-reference?
              (tc_core.tc-context-expr-bases ctx)
              type-env
              params
              body))])]
    [_ false]))

(define (lower-tail-call-self-target? [state : LowerState] [name : i64]) : bool
  (string.eq
    (lower-resolve-name-id state name)
    (lower-state-current-function state)))

(define (lower-symbol-function-define-id?
  [ctx : tc_core.TcContext]
  [name-id : i64]) : bool
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        (tc_core.tc-context-symbols ctx)
        name-id
        (csym.compiler-symbols-missing-handle))]
    (and
      (csym.compiler-symbols-handle-found? handle)
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-function-define)))))

(define (lower-tail-call-compatible-return?
  [ctx : tc_core.TcContext]
  [callee-ret : ast.AstType]
  [ret-ty : ast.AstType]) : bool
  (tc_core.tc-type-eq
    (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx callee-ret))
    (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret-ty))))

(define (lower-tail-call-direct-structural-param?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]) : bool
  (match (lower-lookup-type-id
    ctx
    (lower-state-type-cache state)
    env
    type-env
    name)
    [(tc_core.ResultTcType.Ok fn-ty)
      (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx fn-ty))
        [(ast.AstType.Func param-types _)
          (lower-internal-structural-type-list? ctx (box-get param-types))]
        [_ false])]
    [(tc_core.ResultTcType.Err _) false]))

(define (lower-tail-call-direct-supported?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]
  [ret-ty : ast.AstType]) : bool
  (cond
    [(and
        ;; Direct aggregate tail calls also forward the current sret slot. A callee
        ;; early-exit path may return a heap aggregate pointer instead of filling it.
        (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty)
        (lower-rvo-callee-has-early-return-id? state env name))
      false]
    [(lower-tail-call-direct-structural-param? ctx state env type-env name)
      false]
    [(lower-tail-call-self-target? state name) true]
    [(lower-symbol-function-define-id? ctx name)
      (match (lower-lookup-type-id
        ctx
        (lower-state-type-cache state)
        env
        type-env
        name)
        [(tc_core.ResultTcType.Ok fn-ty)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx fn-ty))
            [(ast.AstType.Func param-types callee-ret)
              (lower-tail-call-compatible-return?
                ctx
                (tc_core.tc-context-type-get ctx callee-ret)
                ret-ty)]
            [_ false])]
        [(tc_core.ResultTcType.Err _) false])]
    [else false]))

(define (lower-tail-call-args-for-target
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]
  [args : ast.AstExprList]) : ResultLowerArgs
  (match (lower-lookup-type-id
    ctx
    (lower-state-type-cache state)
    env
    type-env
    name)
    [(tc_core.ResultTcType.Ok fn-ty)
      (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx fn-ty))
        [(ast.AstType.Func param-types _)
          (lower-args-as
            ctx
            state
            env
            type-env
            args
            (tc_core.tc-resolve-type-list ctx (box-get param-types)))]
        [_ (lower-args ctx state env type-env args)])]
    [(tc_core.ResultTcType.Err _) (lower-args ctx state env type-env args)]))

(define (lower-tail-call-indirect-supported?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func-ty : ast.AstType]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : bool
  (if (lower-tail-call-inline-aggregate-risk?
    ctx
    state
    env
    type-env
    args
    ret-ty
    sret-var)
    false
    (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx func-ty))
      [(ast.AstType.Func param-types callee-ret)
        (and
          (not (lower-internal-structural-type-list? ctx (box-get param-types)))
          (lower-tail-call-compatible-return?
            ctx
            (tc_core.tc-context-type-get ctx callee-ret)
            ret-ty))]
      [_ false])))

(define (lower-tail-call-indirect-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [callee : ast.AstExpr]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (tc_core.tc-expr ctx type-env callee)
    [(tc_core.ResultTcType.Ok func-ty)
      (if (lower-tail-call-indirect-supported?
        ctx
        state
        env
        type-env
        func-ty
        args
        ret-ty
        sret-var)
        (match (lower-expr ctx state env type-env callee)
          [(ResultLowerExpr.Ok lowered-func)
            (match lowered-func
              [(LowerExpr.Expr func-state func-value lowered-func-ty)
                (match (lower-indirect-call-args
                  ctx
                  func-state
                  env
                  type-env
                  args
                  lowered-func-ty)
                  [(ResultLowerArgs.Ok args-state values)
                    (match (lower-tail-call-append-current-sret-arg
                      ctx
                      args-state
                      values
                      ret-ty
                      sret-var)
                      [(ResultLowerArgs.Ok tail-state tail-values)
                        (ResultLowerState.Ok
                          (lower-state-emit-at-expr
                            tail-state
                            (ir.CompilerIrInstr.TailCallIndirect
                              func-value
                              (ir.compiler-ir-call-args-from-list tail-values)
                              (lower-one-word-register-storage-type ctx ret-ty))
                            origin))]
                      [(ResultLowerArgs.Err message)
                        (ResultLowerState.Err message)])]
                  [(ResultLowerArgs.Err message) (ResultLowerState.Err message)])])]
          [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])
        (lower-return-expr ctx state env type-env origin ret-ty sret-var))]
    [(tc_core.ResultTcType.Err message)
      (ResultLowerState.Err (box (lower-diagnostic-at-expr callee message)))]))

;; sret return ABI: when `sret-var` >= 0 the caller passed a
;; hidden result-slot pointer (bound to that var). Copy the result aggregate
;; into the caller's slot and return the slot pointer -- no per-return arena
;; alloc + escape copy. `sret-var` < 0 keeps the arena escape-copy path, which
;; is always correct (every call site uses the call's return value), so a
;; non-threaded return path simply stays unoptimized rather than incorrect.
(define (lower-return-expr-to-sret
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-inline-aggregate-copy-size ctx ret-ty)
    [(ResultLowerSize.Ok size)
      (ResultLowerState.Ok
        (lower-state-emit
          (lower-copy-bytes
            state
            (ir.CompilerIrValue.Var sret-var)
            0
            value
            0
            size)
          (ir.CompilerIrInstr.Return
            (lower-return-maybe (ir.CompilerIrValue.Var sret-var) ret-ty))))]
    [(ResultLowerSize.Err message)
      (ResultLowerState.Err (box (lower-diagnostic message)))]))

(define (lower-return-expr-generic
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [ret-ty : ast.AstType]) : ResultLowerState
  (match (lower-expr-expected ctx state env type-env expr ret-ty expr)
    [(ResultLowerExpr.Ok lowered)
      (match lowered
        [(LowerExpr.Expr body-state value expr-ty)
          (if (tc_core.tc-never-type? expr-ty)
            (ResultLowerState.Ok body-state)
            (match (lower-prepare-internal-return-value
              ctx
              body-state
              env
              value
              ret-ty)
              [(ResultLowerExpr.Ok return-copy)
                (match return-copy
                  [(LowerExpr.Expr return-state return-value _)
                    (ResultLowerState.Ok
                      (lower-state-emit
                        return-state
                        (ir.CompilerIrInstr.Return
                          (lower-return-maybe return-value ret-ty))))])]
              [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))])]
    [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))

(define (lower-return-sret
  [state : LowerState (:consume)]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (ResultLowerState.Ok
    (lower-state-emit
      state
      (ir.CompilerIrInstr.Return
        (lower-return-maybe (ir.CompilerIrValue.Var sret-var) ret-ty)))))

(define (lower-rvo-node-has-early-return? [ctx : tc_core.TcContext] [id : i64]) : bool
  (lower-rvo-expr-has-early-return? ctx (lower-context-expr-get ctx id)))

(define (lower-rvo-expr-list-has-early-return?
  [ctx : tc_core.TcContext]
  [exprs : ast.AstExprList]) : bool
  (lower-rvo-expr-list-has-early-return-at? ctx (& exprs) 0))

(define (lower-rvo-expr-list-has-early-return-at?
  [ctx : tc_core.TcContext]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-rvo-node-has-early-return?
        ctx
        (ast.ast-expr-list-get exprs index 0))
      (lower-rvo-expr-list-has-early-return-at? ctx exprs (+ index 1)))))

(define (lower-rvo-let-bindings-have-early-return?
  [ctx : tc_core.TcContext]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-rvo-let-bindings-have-early-return-at? ctx (& bindings) 0))

(define (lower-rvo-let-bindings-have-early-return-at?
  [ctx : tc_core.TcContext]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (or
      (match (ast.ast-let-binding-list-get
        bindings
        binding-index
        (ast.ast-let-binding-fallback))
        [(ast.AstLetBinding.Binding _ _ init-box)
          (lower-rvo-node-has-early-return? ctx init-box)])
      (lower-rvo-let-bindings-have-early-return-at?
        ctx
        bindings
        (+ binding-index 1)))))

(define (lower-rvo-match-arms-have-early-return?
  [ctx : tc_core.TcContext]
  [arms : ast.AstMatchArmList]) : bool
  (lower-rvo-match-arms-have-early-return-at? ctx (& arms) 0))

(define (lower-rvo-match-arms-have-early-return-at?
  [ctx : tc_core.TcContext]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm _ body-box)
        (or
          (lower-rvo-node-has-early-return? ctx body-box)
          (lower-rvo-match-arms-have-early-return-at? ctx arms (+ index 1)))])))

(define (lower-rvo-resource-bindings-have-early-return?
  [ctx : tc_core.TcContext]
  [bindings : ast.AstResourceBindingList]) : bool
  (lower-rvo-resource-bindings-have-early-return-at? ctx (& bindings) 0))

(define (lower-rvo-resource-bindings-have-early-return-at?
  [ctx : tc_core.TcContext]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-resource-binding-list-len bindings))
    false
    (or
      (match (ast.ast-resource-binding-list-get
        bindings
        binding-index
        (ast.ast-resource-binding-fallback))
        [(ast.AstResourceBinding.Binding _ acquire-box cleanup-box _)
          (or
            (lower-rvo-node-has-early-return? ctx acquire-box)
            (lower-rvo-node-has-early-return? ctx cleanup-box))])
      (lower-rvo-resource-bindings-have-early-return-at?
        ctx
        bindings
        (+ binding-index 1)))))

(define (lower-rvo-expr-has-early-return?
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Return _) true]
    [(ast.AstExpr.Try _) true]
    [(ast.AstExpr.Literal _) false]
    [(ast.AstExpr.Var _) false]
    [(ast.AstExpr.TypeLiteral _) false]
    [(ast.AstExpr.Init _) false]
    [(ast.AstExpr.PtrNull _) false]
    [(ast.AstExpr.PtrAddrOf place-box)
      (lower-rvo-node-has-early-return? ctx place-box)]
    [(ast.AstExpr.BinaryData _) false]
    [(ast.AstExpr.ProgramArgc) false]
    [(ast.AstExpr.ProgramArgv) false]
    [(ast.AstExpr.ProgramEnvp) false]
    [(ast.AstExpr.SpmdProgramIndex) false]
    [(ast.AstExpr.SpmdProgramCount) false]
    [(ast.AstExpr.Spanned inner-box _)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(ast.AstExpr.Binary _ left-box right-box)
      (or
        (lower-rvo-node-has-early-return? ctx left-box)
        (lower-rvo-node-has-early-return? ctx right-box))]
    [(ast.AstExpr.Unary _ inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(ast.AstExpr.Ann inner-box _)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(ast.AstExpr.Cast inner-box _)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(ast.AstExpr.Borrow _ _ inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(ast.AstExpr.Call func-box args)
      (or
        (lower-rvo-node-has-early-return? ctx func-box)
        (lower-rvo-expr-list-has-early-return? ctx args))]
    [(ast.AstExpr.If cond-box then-box else-box)
      (or
        (lower-rvo-node-has-early-return? ctx cond-box)
        (lower-rvo-node-has-early-return? ctx then-box)
        (lower-rvo-node-has-early-return? ctx else-box))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (or
            (lower-rvo-let-bindings-have-early-return? ctx bindings)
            (lower-rvo-node-has-early-return? ctx body-box))])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(ast.AstLambda.Lambda _ _ body-box)
          (lower-rvo-node-has-early-return? ctx body-box)])]
    [(ast.AstExpr.Tuple exprs)
      (lower-rvo-expr-list-has-early-return? ctx exprs)]
    [(ast.AstExpr.TupleRef tuple-box index-box)
      (or
        (lower-rvo-node-has-early-return? ctx tuple-box)
        (lower-rvo-node-has-early-return? ctx index-box))]
    [(ast.AstExpr.Array exprs)
      (lower-rvo-expr-list-has-early-return? ctx exprs)]
    [(ast.AstExpr.DynArray exprs)
      (lower-rvo-expr-list-has-early-return? ctx exprs)]
    [(ast.AstExpr.MakeArray _ len-box)
      (lower-rvo-node-has-early-return? ctx len-box)]
    [(ast.AstExpr.ArrayRef arr-box index-box)
      (or
        (lower-rvo-node-has-early-return? ctx arr-box)
        (lower-rvo-node-has-early-return? ctx index-box))]
    [(ast.AstExpr.ArraySet arr-box index-box value-box)
      (or
        (lower-rvo-node-has-early-return? ctx arr-box)
        (lower-rvo-node-has-early-return? ctx index-box)
        (lower-rvo-node-has-early-return? ctx value-box))]
    [(ast.AstExpr.ArrayPush arr-box value-box)
      (or
        (lower-rvo-node-has-early-return? ctx arr-box)
        (lower-rvo-node-has-early-return? ctx value-box))]
    [(ast.AstExpr.StringRef str-box index-box)
      (or
        (lower-rvo-node-has-early-return? ctx str-box)
        (lower-rvo-node-has-early-return? ctx index-box))]
    [(ast.AstExpr.While cond-box body-box)
      (or
        (lower-rvo-node-has-early-return? ctx cond-box)
        (lower-rvo-node-has-early-return? ctx body-box))]
    [(ast.AstExpr.Begin exprs)
      (lower-rvo-expr-list-has-early-return? ctx exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (lower-rvo-expr-list-has-early-return? ctx exprs)]
    [(ast.AstExpr.Set _ rhs-box) (lower-rvo-node-has-early-return? ctx rhs-box)]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrut-box arms)
          (or
            (lower-rvo-node-has-early-return? ctx scrut-box)
            (lower-rvo-match-arms-have-early-return? ctx arms))])]
    [(ast.AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(ast.AstForeach.Foreach _ _ start-box end-box body-box)
          (or
            (lower-rvo-node-has-early-return? ctx start-box)
            (lower-rvo-node-has-early-return? ctx end-box)
            (lower-rvo-node-has-early-return? ctx body-box))])]
    [(ast.AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(ast.AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (or
            (lower-rvo-node-has-early-return? ctx start-box)
            (lower-rvo-node-has-early-return? ctx end-box)
            (lower-rvo-node-has-early-return? ctx init-box)
            (lower-rvo-node-has-early-return? ctx value-box))])]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(ast.AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            _
            _
            init-box
            value-box
            body-box)
          (or
            (lower-rvo-node-has-early-return? ctx start-box)
            (lower-rvo-node-has-early-return? ctx end-box)
            (lower-rvo-node-has-early-return? ctx init-box)
            (lower-rvo-node-has-early-return? ctx value-box)
            (lower-rvo-node-has-early-return? ctx body-box))])]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (or
        (lower-rvo-node-has-early-return? ctx value-box)
        (lower-rvo-node-has-early-return? ctx lane-box))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (or
        (lower-rvo-node-has-early-return? ctx value-box)
        (lower-rvo-node-has-early-return? ctx lane-box))]
    [(ast.AstExpr.StructGet receiver-box _)
      (lower-rvo-node-has-early-return? ctx receiver-box)]
    [(ast.AstExpr.StructSet receiver-box _ value-box)
      (or
        (lower-rvo-node-has-early-return? ctx receiver-box)
        (lower-rvo-node-has-early-return? ctx value-box))]
    [(ast.AstExpr.WithRegion _ body)
      (lower-rvo-expr-list-has-early-return? ctx body)]
    [(ast.AstExpr.WithEscape scratch-box body)
      (or
        (lower-rvo-node-has-early-return? ctx scratch-box)
        (lower-rvo-expr-list-has-early-return? ctx body))]
    [(ast.AstExpr.WithScratch body)
      (lower-rvo-expr-list-has-early-return? ctx body)]
    [(ast.AstExpr.InArena arena-box body)
      (or
        (lower-rvo-node-has-early-return? ctx arena-box)
        (lower-rvo-expr-list-has-early-return? ctx body))]
    [(ast.AstExpr.WithResource wr-box)
      (match (box-get wr-box)
        [(ast.AstWithResource.WithResource bindings body)
          (or
            (lower-rvo-resource-bindings-have-early-return? ctx bindings)
            (lower-rvo-expr-list-has-early-return? ctx body))])]
    [(ast.AstExpr.Box inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(ast.AstExpr.BoxGet inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(ast.AstExpr.BoxTake inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (or
        (lower-rvo-node-has-early-return? ctx inner-box)
        (lower-rvo-node-has-early-return? ctx value-box))]
    [(ast.AstExpr.Comptime _) false]
    [(ast.AstExpr.Quote _) false]
    [(ast.AstExpr.Quasiquote _) false]
    [(ast.AstExpr.Unquote _) false]
    [(ast.AstExpr.UnquoteSplicing _) false]
    [(ast.AstExpr.BracketClause items)
      (lower-rvo-expr-list-has-early-return? ctx items)]
    [(ast.AstExpr.PtrNullCheck inner-box)
      (lower-rvo-node-has-early-return? ctx inner-box)]
    [(ast.AstExpr.PtrRead ptr-box)
      (lower-rvo-node-has-early-return? ctx ptr-box)]
    [(ast.AstExpr.PtrWrite ptr-box value-box)
      (or
        (lower-rvo-node-has-early-return? ctx ptr-box)
        (lower-rvo-node-has-early-return? ctx value-box))]
    [(ast.AstExpr.PtrOffset ptr-box offset-box)
      (or
        (lower-rvo-node-has-early-return? ctx ptr-box)
        (lower-rvo-node-has-early-return? ctx offset-box))]
    [(ast.AstExpr.PtrCast ptr-box _)
      (lower-rvo-node-has-early-return? ctx ptr-box)]
    [(ast.AstExpr.PtrToInt ptr-box)
      (lower-rvo-node-has-early-return? ctx ptr-box)]
    [(ast.AstExpr.IntToPtr value-box _)
      (lower-rvo-node-has-early-return? ctx value-box)]
    [(ast.AstExpr.StringData str-box)
      (lower-rvo-node-has-early-return? ctx str-box)]
    [(ast.AstExpr.StringFromBytes ptr-box len-box)
      (or
        (lower-rvo-node-has-early-return? ctx ptr-box)
        (lower-rvo-node-has-early-return? ctx len-box))]
    [(ast.AstExpr.ArrayData array-box)
      (lower-rvo-node-has-early-return? ctx array-box)]
    [(ast.AstExpr.CpuIdEax leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? ctx leaf-box)
        (lower-rvo-node-has-early-return? ctx subleaf-box))]
    [(ast.AstExpr.CpuIdEbx leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? ctx leaf-box)
        (lower-rvo-node-has-early-return? ctx subleaf-box))]
    [(ast.AstExpr.CpuIdEcx leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? ctx leaf-box)
        (lower-rvo-node-has-early-return? ctx subleaf-box))]
    [(ast.AstExpr.CpuIdEdx leaf-box subleaf-box)
      (or
        (lower-rvo-node-has-early-return? ctx leaf-box)
        (lower-rvo-node-has-early-return? ctx subleaf-box))]
    [(ast.AstExpr.Xgetbv index-box)
      (lower-rvo-node-has-early-return? ctx index-box)]
    [(ast.AstExpr.Syscall args)
      (lower-rvo-expr-list-has-early-return? ctx args)]
    [_ true]))

;; Aliasing guard for sret-forwarding RVO. The forwarded sret is the
;; current function's result slot, which a CALLER may legally have aliased with
;; one of this call's arguments (the `(set! place (f place ...))` /
;; aggregate-place-update pattern -- HARD CONSTRAINT #4). If a callee then reads
;; such an argument and writes its result in place through the (aliased) sret --
;; e.g. it returns an enum/struct WRAPPING one of its parameters, like
;; a generated String -> i64 map remove returning `(RemoveOk map)` -- the
;; materialize-into-fresh-temp step of the value path is what makes that safe.
;; Forwarding the sret removes that buffer, so we only forward when NO argument
;; can alias the sret. An argument cannot alias the caller-owned result slot when
;; it is a scalar (carries no inline-aggregate storage) or is itself a
;; fresh-producing call/constructor whose result is an OWNED inline struct/enum
;; (materialized into a distinct fresh temp). A place-expression of aggregate
;; type (var/field/index/deref) or any reference/borrow may alias and is unsafe.
(define (lower-rvo-arg-cannot-alias-sret?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]) : bool
  (match (tc_core.tc-expr ctx type-env arg)
    [(tc_core.ResultTcType.Ok ty)
      (or
        (not (lower-type-contains-inline-aggregate? ctx ty))
        (and
          (match (ast.ast-expr-unspan arg)
            [(ast.AstExpr.Call _ _) true]
            [_ false])
          (lower-type-inline-struct-or-enum? ctx ty)))]
    [(tc_core.ResultTcType.Err _) false]))

(define (lower-rvo-args-cannot-alias-sret?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]) : bool
  (lower-rvo-args-cannot-alias-sret-at? ctx type-env (& args) 0))

(define (lower-rvo-args-cannot-alias-sret-at?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get args len))
    true
    (and
      (lower-rvo-arg-cannot-alias-sret?
        ctx
        type-env
        (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0)))
      (lower-rvo-args-cannot-alias-sret-at? ctx type-env args (+ index 1)))))

(define (lower-rvo-callee-has-early-return-id?
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]) : bool
  (let
    [logical-id : i64
      (if (sym_i64_env.sym-i64-contains-id env name-id)
        name-id
        (let
          [names : LowerNameCache (lower-state-names state)]
          (lower-name-cache-resolve-logical-id (& names) name-id name-id)))]
    (lower_i64_i64_map.contains?
      (& lower-rvo-early-return-functions)
      logical-id)))

;; Call-slot RVO for a tail-position direct CALL whose aggregate result is
;; returned by the current function. The value path lowers the call into a fresh
;; reserved result slot (`lower-call-append-sret-arg`) and then `lower-copy-bytes`
;; copies that slot into the caller-owned sret. Instead, forward the caller's own
;; sret pointer as the callee's hidden sret argument so the callee writes the
;; final result DIRECTLY into the return slot, eliminating the materialize+copy.
;;
;; Correctness: the call's arguments are evaluated BEFORE the call exactly as on
;; the value path, the would-be temporary's sole consumer is this return, and the
;; `lower-rvo-args-cannot-alias-sret?` guard above ensures no argument can alias
;; the destination -- so substituting the destination is sound. This mirrors
;; `lower-direct-call-id`'s ordinary (non-builtin, non-C-ABI) sret path verbatim,
;; only swapping the reserved slot for the provided `sret-var` and ending with the
;; return. Anything outside that path (builtins, C-ABI/extern, bytes-view,
;; indirect targets, incompatible/aliasing returns) yields `LowerMaybeDirectStore.No`
;; and falls back to the unchanged value+copy path.
(define (lower-return-direct-call-into-sret
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [name-id : i64]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : LowerMaybeDirectStore
  (if (or
    (not (lower-type-inline-struct-or-enum? ctx ret-ty))
    ;; Require a genuine top-level function-define so a direct `CompilerIrInstr.Call` to
    ;; this symbol is the correct lowering. This excludes builtins, C-ABI/extern
    ;; declarations, and -- critically -- top-level function-VALUE globals /
    ;; closures, whose call must go through an INDIRECT load of the variable
    ;; (emitting a direct symbol call there would call into data). Same eligibility
    ;; rule `lower-tail-call-direct-supported?` uses for direct TCO.
    (not (lower-symbol-function-define-id? ctx name-id))
    ;; Explicit early exits are still lowered through return paths that may hand
    ;; back an allocated aggregate in `rax` instead of filling the forwarded sret.
    (lower-rvo-callee-has-early-return-id? state env name-id)
    (lower-bytes-view-from-parts-name? name)
    (lower-c-abi-extern-call? ctx state env name-id name)
    (lower-c-abi-extern-value-call? ctx state env name-id name)
    ;; An argument that may alias the caller-owned sret makes in-place forwarding
    ;; unsound (see `lower-rvo-args-cannot-alias-sret?`).
    (not (lower-rvo-args-cannot-alias-sret? ctx type-env args)))
    (LowerMaybeDirectStore.No)
    (match (lower-lookup-type-id
      ctx
      (lower-state-type-cache state)
      env
      type-env
      name-id)
      [(tc_core.ResultTcType.Ok fn-ty)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx fn-ty))
          [(ast.AstType.Func param-types fn-ret)
            (if (not
              (lower-tail-call-compatible-return?
                ctx
                (tc_core.tc-context-type-get ctx fn-ret)
                ret-ty))
              ;; The callee's declared return type differs from this function's
              ;; return type (beyond regions): the value path coerces the call
              ;; result into the sret slot, so forwarding the slot to the callee
              ;; -- which would write its OWN-typed result -- is unsound. Keep the
              ;; materialize+copy path. (Same compatibility rule TCO requires.)
              (LowerMaybeDirectStore.No)
              (match (lower-direct-call-param-types
                ctx
                type-env
                name-id
                args
                (tc_core.tc-resolve-type-list ctx (box-get param-types)))
                [(tc_core.ResultTcTypeList.Ok call-param-types)
                  (match (lower-call-args-as-needed
                    ctx
                    state
                    env
                    type-env
                    args
                    call-param-types)
                    [(ResultLowerCallArgs.Ok args-state values writebacks)
                      (match (lower-state-alloc-var args-state)
                        [(LowerAlloc.Alloc allocated call-var)
                          (let
                            [result-ir-ty : ast.AstType
                              (lower-one-word-register-storage-type ctx ret-ty)]
                            [sret-values : ir.CompilerIrValueList
                              (lower-value-list-append-one
                                values
                                (ir.CompilerIrValue.Var sret-var))]
                            [call-name : i64
                              (lower-resolve-call-name-id-with-display
                                allocated
                                env
                                name-id
                                name)]
                            [call-state : LowerState
                              (lower-state-emit-at-expr
                                allocated
                                (ir.CompilerIrInstr.Call
                                  call-var
                                  call-name
                                  (ir.compiler-ir-call-args-from-list
                                    sret-values)
                                  result-ir-ty)
                                origin)]
                            [writeback-state : LowerState
                              (lower-apply-arg-writebacks
                                ctx
                                call-state
                                writebacks)]
                            (LowerMaybeDirectStore.Store
                              (lower-state-emit
                                writeback-state
                                (ir.CompilerIrInstr.Return
                                  (lower-return-maybe
                                    (ir.CompilerIrValue.Var sret-var)
                                    ret-ty)))))])]
                    [(ResultLowerCallArgs.Err message)
                      (LowerMaybeDirectStore.Err message)])]
                [(tc_core.ResultTcTypeList.Err message)
                  (LowerMaybeDirectStore.Err
                    (box (lower-diagnostic-at-expr origin message)))]))]
          [_ (LowerMaybeDirectStore.No)])]
      [(tc_core.ResultTcType.Err _) (LowerMaybeDirectStore.No)])))

;; Tail-position direct-call fallback shared by the non-constructor branches of
;; `lower-return-call-name-to-sret`: try the call-slot RVO above, otherwise keep
;; the unchanged materialize-into-temp + copy-to-sret behavior.
(define (lower-return-call-fallback-to-sret
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [name-id : i64]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (lower-return-direct-call-into-sret
    ctx
    state
    env
    type-env
    name
    name-id
    args
    ret-ty
    sret-var
    origin)
    [(LowerMaybeDirectStore.Store done-state) (ResultLowerState.Ok done-state)]
    [(LowerMaybeDirectStore.Err message) (ResultLowerState.Err message)]
    [(LowerMaybeDirectStore.No)
      (lower-return-expr-generic ctx state env type-env origin ret-ty)]))

(define (lower-return-call-name-to-sret
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (let
    [source-name : String (lower-hygiene-source-name name)]
    [variant-name : String
      (lower-variant-constructor-lookup-name ctx source-name raw-name-id ret-ty)]
    [struct-name : String
      (match (tc_core.tc-type-strip-region ret-ty)
        [(ast.AstType.Struct resolved-struct)
          (if (lower-call-name-matches-nominal?
            ctx
            source-name
            (tc_core.tc-nominal-name-id-display resolved-struct))
            (tc_core.tc-nominal-name-id-display resolved-struct)
            (lower-module-lookup-name ctx source-name))]
        [(ast.AstType.StructArgs resolved-struct _)
          (if (lower-call-name-matches-nominal?
            ctx
            source-name
            (tc_core.tc-nominal-name-id-display resolved-struct))
            (tc_core.tc-nominal-name-id-display resolved-struct)
            (lower-module-lookup-name ctx source-name))]
        [_ (lower-module-lookup-name ctx source-name)])]
    [variant-handle : i64
      (lower-variant-constructor-handle-id-or
        ctx
        source-name
        raw-name-id
        ret-ty
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? variant-handle)
      (match (lower-construct-enum-with-handle-into
        ctx
        state
        env
        type-env
        (ir.CompilerIrValue.Var sret-var)
        variant-name
        variant-handle
        args
        ret-ty)
        [(ResultLowerState.Ok done-state)
          (lower-return-sret done-state ret-ty sret-var)]
        [(ResultLowerState.Err message) (ResultLowerState.Err message)])
      (let
        [struct-handle : i64
          (lower-struct-constructor-handle-id-or
            ctx
            state
            raw-name-id
            lookup-name-id
            ret-ty
            (csym.compiler-symbols-missing-handle))]
        (if (and
          (or
            (tc_core.tc-constructor-name-id? ctx raw-name-id)
            (tc_core.tc-constructor-name-id? ctx lookup-name-id))
          (csym.compiler-symbols-handle-found? struct-handle)
          (=
            (csym.compiler-symbol-handle-kind struct-handle)
            (csym.compiler-symbol-kind-defstruct)))
          (match (lower-construct-struct-into
            ctx
            state
            env
            type-env
            (ir.CompilerIrValue.Var sret-var)
            struct-name
            struct-handle
            args
            ret-ty)
            [(ResultLowerState.Ok done-state)
              (lower-return-sret done-state ret-ty sret-var)]
            [(ResultLowerState.Err message) (ResultLowerState.Err message)])
          (lower-return-call-fallback-to-sret
            ctx
            state
            env
            type-env
            name
            lookup-name-id
            args
            ret-ty
            sret-var
            origin))))))

(define (lower-return-call-to-sret
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (ast.ast-expr-unspan func)
    [(ast.AstExpr.Var raw-name)
      (let
        [source-id : i64
          (tc_core.macro-hygiene-global-source-name-id-or raw-name raw-name)]
        [raw-text : String (ci.intern-str source-id)]
        (if (tc_core.tc-dotted-local-field-name-id? type-env raw-name)
          (lower-return-expr-generic ctx state env type-env origin ret-ty)
          (if (sym_i64_env.sym-i64-contains-id env raw-name)
            (lower-return-expr-generic ctx state env type-env origin ret-ty)
            (match (if (or
              (tc_core.macro-hygiene-global-id? raw-name)
              (tc_core.tc-hygiene-global-name? raw-text))
              (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
                ctx
                type-env
                raw-text
                raw-name
                true)
                [(tc_core.TcNameLookup.Ok _ resolved-id)
                  (tc_core.TcNameLookup.Ok
                    (lower-hygiene-source-name-in-context-id
                      ctx
                      type-env
                      raw-name)
                    resolved-id)]
                [(tc_core.TcNameLookup.Err _)
                  (tc_core.TcNameLookup.Ok
                    (lower-hygiene-source-name-in-context-id
                      ctx
                      type-env
                      raw-name)
                    raw-name)])
              (if (tc_core.tc-source-slash-qualified-id? raw-text source-id)
                (tc_core.TcNameLookup.Ok raw-text source-id)
                (tc_core.tc-source-name-lookup-key-with-field-check-lookup
                  ctx
                  type-env
                  raw-text
                  raw-name
                  true)))
              [(tc_core.TcNameLookup.Ok name lookup-name-id)
                (lower-return-call-name-to-sret
                  ctx
                  state
                  env
                  type-env
                  name
                  raw-name
                  lookup-name-id
                  args
                  ret-ty
                  sret-var
                  origin)]
              [(tc_core.TcNameLookup.Err _)
                (lower-return-expr-generic ctx state env type-env origin ret-ty)]))))]
    [_ (lower-return-expr-generic ctx state env type-env origin ret-ty)]))

(define (lower-return-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (if (and
    (>= sret-var 0)
    (lower-type-inline-struct-or-enum? ctx ret-ty)
    (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty))
    (match expr
      [(ast.AstExpr.Spanned inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-return-expr ctx state env type-env inner ret-ty sret-var))]
      [(ast.AstExpr.Call func-box args)
        (let
          [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
          (lower-return-call-to-sret
            ctx
            state
            env
            type-env
            func
            args
            ret-ty
            sret-var
            expr))]
      [_ (lower-return-expr-generic ctx state env type-env expr ret-ty)])
    (lower-return-expr-generic ctx state env type-env expr ret-ty)))

(define (lower-tail-call-safe-param-aggregate-arg?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-tail-call-safe-param-aggregate-arg?
        ctx
        state
        env
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Ann inner-box _)
      (lower-tail-call-safe-param-aggregate-arg?
        ctx
        state
        env
        (lower-context-expr-get ctx inner-box))]
    [(ast.AstExpr.Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? var-id)
          (lower-state-tail-param-range-contains? state var-id)
          false))]
    [_ false]))

(define (lower-expr-list-contains-unsafe-inline-aggregate?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]) : bool
  (lower-expr-list-contains-unsafe-inline-aggregate-at?
    ctx
    state
    env
    type-env
    (& exprs)
    0))

(define (lower-expr-list-contains-unsafe-inline-aggregate-at?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (let
      [expr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
      (match (tc_core.tc-expr ctx type-env expr)
        [(tc_core.ResultTcType.Ok ty)
          (or
            (and
              (lower-type-contains-inline-aggregate? ctx ty)
              (not
                (lower-tail-call-safe-param-aggregate-arg? ctx state env expr)))
            (lower-expr-list-contains-unsafe-inline-aggregate-at?
              ctx
              state
              env
              type-env
              exprs
              (+ index 1)))]
        [(tc_core.ResultTcType.Err _)
          (lower-expr-list-contains-unsafe-inline-aggregate-at?
            ctx
            state
            env
            type-env
            exprs
            (+ index 1))]))))

(define (lower-tail-call-inline-aggregate-risk?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : bool
  (or
    ;; Structural ABI values use explicit materialization/call transforms;
    ;; tail forwarding must not bypass those steps, even with a leading sret.
    (lower-internal-structural-type? ctx ret-ty)
    ;; Aggregate returns do not make frame reuse unsafe when the current
    ;; function has the caller-owned sret slot to forward to the callee.
    (and
      (< sret-var 0)
      (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty))
    (lower-expr-list-contains-unsafe-inline-aggregate?
      ctx
      state
      env
      type-env
      args)))

(define (lower-tail-call-append-current-sret-arg
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [values : ir.CompilerIrValueList]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerArgs
  (if (and
    (>= sret-var 0)
    (lower-type-inline-struct-or-enum? ctx ret-ty)
    (lower-inline-aggregate-abi-copy-needed? ctx state ret-ty))
    (ResultLowerArgs.Ok
      state
      (lower-value-list-append-one values (ir.CompilerIrValue.Var sret-var)))
    (ResultLowerArgs.Ok state values)))

(define (lower-tail-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [callee : ast.AstExpr]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (ast.ast-expr-unspan callee)
    [(ast.AstExpr.Var name)
      (let
        [unshadowed : bool (lower-tail-call-var-unshadowed? env name)]
        (cond
          [(and unshadowed (lower-comptime-error-call-id? name))
            (ResultLowerState.Err
              (box
                (lower-diagnostic-at-expr
                  origin
                  "lower: comptime-error is compile-time only")))]
          [(and
              unshadowed
              (lower-string-concat-call-source? ctx env type-env name))
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]
          [(and
              unshadowed
              (cbi.compiler-builtin-private-intrinsic-id? name)
              (lower-top-level-builtin-available-id? ctx type-env name))
            ;; Private intrinsic calls in imported bodies must pass through the
            ;; ordinary expression lowerer before direct-tail-call selection.
            ;; Otherwise a compatible caller-owned shadow can capture the call.
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]
          [(and
              unshadowed
              ;; Only suppress TCO when THIS call actually involves inline
              ;; aggregates (sret/by-value risk); a broad inline-aggregates-mode guard
              ;; disabled tail-call optimization for every call (mode is always on),
              ;; losing TCO entirely (deep self-recursion, smoke shape failure).
              (not
                (lower-tail-call-inline-aggregate-risk?
                  ctx
                  state
                  env
                  type-env
                  args
                  ret-ty
                  sret-var))
              (lower-tail-call-direct-supported?
                ctx
                state
                env
                type-env
                name
                ret-ty))
            (match (lower-tail-call-args-for-target
              ctx
              state
              env
              type-env
              name
              args)
              [(ResultLowerArgs.Ok args-state values)
                (match (lower-tail-call-append-current-sret-arg
                  ctx
                  args-state
                  values
                  ret-ty
                  sret-var)
                  [(ResultLowerArgs.Ok tail-state tail-values)
                    (let
                      [target-id : i64
                        (lower-resolve-name-symbol-id tail-state name)]
                      (ResultLowerState.Ok
                        (lower-state-emit-at-expr
                          tail-state
                          (ir.CompilerIrInstr.TailCall
                            target-id
                            (ir.compiler-ir-call-args-from-list tail-values)
                            (lower-one-word-register-storage-type ctx ret-ty))
                          origin)))]
                  [(ResultLowerArgs.Err message) (ResultLowerState.Err message)])]
              [(ResultLowerArgs.Err message) (ResultLowerState.Err message)])]
          [unshadowed
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]
          [(lower-tail-call-local-indirect-safe? env type-env name)
            (lower-tail-call-indirect-expr
              ctx
              state
              env
              type-env
              callee
              args
              ret-ty
              sret-var
              origin)]
          [else
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]))]
    [_
      (if (lower-tail-call-reference-capturing-lambda? ctx type-env callee)
        (lower-return-expr ctx state env type-env origin ret-ty sret-var)
        (lower-tail-call-indirect-expr
          ctx
          state
          env
          type-env
          callee
          args
          ret-ty
          sret-var
          origin))]))

(define (lower-tail-begin
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (lower-tail-begin-at ctx state env type-env (& exprs) 0 ret-ty sret-var))

(define (lower-tail-begin-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (let
    [len : i64 (struct-get exprs len)]
    (if (>= index len)
      (ResultLowerState.Ok
        (lower-state-emit
          state
          (ir.CompilerIrInstr.Return
            (lower-return-maybe ir.CompilerIrValue.Unit ret-ty))))
      (let
        [expr : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
        (if (= (+ index 1) len)
          (lower-tail-expr ctx state env type-env expr ret-ty sret-var)
          (match (lower-expr ctx state env type-env expr)
            [(ResultLowerExpr.Ok lowered)
              (match lowered
                [(LowerExpr.Expr next-state _ expr-ty)
                  (if (tc_core.tc-never-type? expr-ty)
                    (ResultLowerState.Ok next-state)
                    (lower-tail-begin-at
                      ctx
                      next-state
                      env
                      type-env
                      exprs
                      (+ index 1)
                      ret-ty
                      sret-var))])]
            [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))))))

(define (lower-tail-if
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [cond : ast.AstExpr]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-expr ctx state env type-env cond)
    [(ResultLowerExpr.Ok cond-lowered)
      (match cond-lowered
        [(LowerExpr.Expr cond-state cond-value _)
          (match (lower-state-fresh-label cond-state "if_then")
            [(LowerLabel.Label then-label-state then-label)
              (match (lower-state-fresh-label then-label-state "if_else")
                [(LowerLabel.Label else-label-state else-label)
                  (let
                    [branch-state : LowerState
                      (lower-state-emit
                        else-label-state
                        (ir.CompilerIrInstr.Branch
                          cond-value
                          then-label
                          else-label))]
                    (match (lower-tail-expr
                      ctx
                      (lower-state-finish-block branch-state then-label)
                      env
                      type-env
                      then-branch
                      ret-ty
                      sret-var)
                      [(ResultLowerState.Ok then-state)
                        (lower-tail-expr
                          ctx
                          (lower-state-finish-block then-state else-label)
                          env
                          type-env
                          else-branch
                          ret-ty
                          sret-var)]
                      [(ResultLowerState.Err message)
                        (ResultLowerState.Err message)]))])])])]
    [(ResultLowerExpr.Err message) (ResultLowerState.Err message)]))

(define (lower-tail-match-arms
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (if (ast.ast-match-arm-list-empty? (& arms))
    (ResultLowerState.Err (box (lower-diagnostic "lower: match with no arms")))
    (let
      [arm : ast.AstMatchArm
        (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback))]
      [rest : ast.AstMatchArmList (ast.ast-match-arm-list-tail arms)]
      (if (ast.ast-match-arm-list-empty? (& rest))
        (lower-tail-match-catch-all
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          arm
          ret-ty
          sret-var)
        (match arm
          [(ast.AstMatchArm.Arm pat body-box)
            (let
              [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
              (match pat
                [(ast.AstPattern.Literal lit)
                  (lower-tail-match-literal-arm
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    lit
                    body
                    rest
                    ret-ty
                    sret-var)]
                [(ast.AstPattern.Binding _)
                  (lower-tail-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    ret-ty
                    sret-var)]
                [(ast.AstPattern.Wildcard)
                  (lower-tail-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    ret-ty
                    sret-var)]
                [(ast.AstPattern.Variant variant-name _)
                  (if (lower-box-pattern-for-type? ctx scrut-ty variant-name)
                    (lower-tail-match-catch-all
                      ctx
                      state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arm
                      ret-ty
                      sret-var)
                    (if (lower-struct-pattern-for-type?
                      ctx
                      scrut-ty
                      variant-name)
                      (lower-tail-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        ret-ty
                        sret-var)
                      (ResultLowerState.Err
                        (box
                          (lower-diagnostic "lower: unsupported match pattern")))))]
                [_
                  (ResultLowerState.Err
                    (box (lower-diagnostic "lower: unsupported match pattern")))]))])))))

(define (lower-tail-match-literal-arm
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [lit : ast.AstLiteral]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-state-alloc-var state)
    [(LowerAlloc.Alloc eq-alloc eq-var)
      (let
        [eq-state : LowerState
          (lower-state-emit
            eq-alloc
            (ir.CompilerIrInstr.BinOp
              eq-var
              ir.CompilerIrBinOp.Eq
              (ir.CompilerIrValue.Var scrut-var)
              (lower-literal-value-with-type lit scrut-ty)
              scrut-ty))]
        (match (lower-state-fresh-label eq-state "match_arm")
          [(LowerLabel.Label body-label-state body-label)
            (match (lower-state-fresh-label body-label-state "match_next")
              [(LowerLabel.Label next-label-state next-label)
                (let
                  [body-start : LowerState
                    (lower-state-finish-block
                      (lower-state-emit
                        next-label-state
                        (ir.CompilerIrInstr.Branch
                          (ir.CompilerIrValue.Var eq-var)
                          body-label
                          next-label))
                      body-label)]
                  (match (lower-tail-expr
                    ctx
                    body-start
                    env
                    type-env
                    body
                    ret-ty
                    sret-var)
                    [(ResultLowerState.Ok body-state)
                      (lower-tail-match-arms
                        ctx
                        (lower-state-finish-block body-state next-label)
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        rest
                        ret-ty
                        sret-var)]
                    [(ResultLowerState.Err message)
                      (ResultLowerState.Err message)]))])]))]))

(define (lower-tail-match-catch-all
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arm : ast.AstMatchArm]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (match arm
    [(ast.AstMatchArm.Arm pat body-box)
      (let
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (match (lower-bind-match-catch-all-pattern
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          pat)
          [(ResultLowerEnv.Ok body-start body-env body-type-env)
            (lower-tail-expr
              ctx
              body-start
              body-env
              body-type-env
              body
              ret-ty
              sret-var)]
          [(ResultLowerEnv.Err message) (ResultLowerState.Err message)]))]))

(define (lower-tail-match-enum
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [force-memory : bool]) : ResultLowerState
  (let
    [scrut-words : i64 (lower-type-register-words ctx scrut-ty)]
    (if (and (> scrut-words 0) (not force-memory))
      (if (= scrut-words 2)
        (match (lower-emit-word
          state
          (ir.CompilerIrValue.Var scrut-var)
          0
          (ast.AstType.I64))
          [(LowerExpr.Expr tag-state tag-value _)
            (match tag-value
              [(ir.CompilerIrValue.Var tag-var)
                (lower-tail-match-enum-arms
                  ctx
                  tag-state
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  tag-var
                  arms
                  ret-ty
                  sret-var
                  borrow-lifetime
                  true
                  false)]
              [_
                (ResultLowerState.Err
                  (box
                    (lower-diagnostic "lower: internal enum tag extract failed")))])])
        (lower-tail-match-enum-arms
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          scrut-var
          arms
          ret-ty
          sret-var
          borrow-lifetime
          false
          false))
      (match (lower-load-at-offset
        state
        (ir.CompilerIrValue.Var scrut-var)
        0
        (ast.AstType.I64))
        [(LowerExpr.Expr tag-state tag-value _)
          (match tag-value
            [(ir.CompilerIrValue.Var tag-var)
              (lower-tail-match-enum-arms
                ctx
                tag-state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arms
                ret-ty
                sret-var
                borrow-lifetime
                false
                false)]
            [_
              (ResultLowerState.Err
                (box (lower-diagnostic "lower: internal enum tag load failed")))])]))))

(define (lower-tail-match-enum-final-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arm : ast.AstMatchArm]
  [pat : ast.AstPattern]
  [body : ast.AstExpr]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match pat
    [(ast.AstPattern.Wildcard)
      (lower-tail-match-catch-all
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arm
        ret-ty
        sret-var)]
    [(ast.AstPattern.Binding variant-name)
      (lower-tail-match-variant-final
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        variant-name
        (ast.ast-pattern-list-new)
        body
        ret-ty
        sret-var
        borrow-lifetime
        scrut-reg-group?)]
    [(ast.AstPattern.Variant variant-name args-box)
      (let
        [args : ast.AstPatternList (box-get args-box)]
        (lower-tail-match-variant-final
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          variant-name
          args
          body
          ret-ty
          sret-var
          borrow-lifetime
          scrut-reg-group?))]
    [_
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: unsupported enum match pattern")))]))

(define (lower-tail-match-enum-branch-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [arm : ast.AstMatchArm]
  [pat : ast.AstPattern]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerState
  (match pat
    [(ast.AstPattern.Wildcard)
      (lower-tail-match-catch-all
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arm
        ret-ty
        sret-var)]
    [(ast.AstPattern.Binding variant-name)
      (lower-tail-match-variant-arm
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        tag-var
        variant-name
        (ast.ast-pattern-list-new)
        body
        rest
        ret-ty
        sret-var
        borrow-lifetime
        scrut-reg-group?
        total-enum-switch?)]
    [(ast.AstPattern.Variant variant-name args-box)
      (let
        [args : ast.AstPatternList (box-get args-box)]
        (lower-tail-match-variant-arm
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          tag-var
          variant-name
          args
          body
          rest
          ret-ty
          sret-var
          borrow-lifetime
          scrut-reg-group?
          total-enum-switch?))]
    [_
      (ResultLowerState.Err
        (box (lower-diagnostic "lower: unsupported enum match pattern")))]))

(define (lower-tail-match-enum-arms
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [arms : ast.AstMatchArmList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerState
  (if (ast.ast-match-arm-list-empty? (& arms))
    (ResultLowerState.Err (box (lower-diagnostic "lower: match with no arms")))
    (let
      [arm : ast.AstMatchArm
        (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback))]
      [rest : ast.AstMatchArmList (ast.ast-match-arm-list-tail arms)]
      (match arm
        [(ast.AstMatchArm.Arm pat body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (if (ast.ast-match-arm-list-empty? (& rest))
              (lower-tail-match-enum-final-pattern
                ctx
                state
                env
                type-env
                scrut-var
                scrut-ty
                arm
                pat
                body
                ret-ty
                sret-var
                borrow-lifetime
                scrut-reg-group?)
              (lower-tail-match-enum-branch-pattern
                ctx
                state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arm
                pat
                body
                rest
                ret-ty
                sret-var
                borrow-lifetime
                scrut-reg-group?
                total-enum-switch?)))]))))

;; Per-match variant arm resolution memo. Each arm of one match re-runs the
;; same constructor/payload resolution chain (tc-env-key-name-text, scrutinee
;; type resolution, lower-variant-constructor-handle-id-or,
;; compiler-registries-variant-fields-indexed,
;; lower-variant-payload-fields-for-handle,
;; lower-variant-handle-name-id-or), whose inputs are constant across the
;; arms of one match and pure (registries and ctx caches only grow during one
;; function's lowering). Memoize the resolution per (variant-name-id,
;; scrutinee type) for the lifetime of one function in a small direct-mapped
;; cache in program-arena arrays allocated at module init, tagged by a
;; generation bumped in lower-function-escaping (next to tc-rtf-next-gen!).
;; Collisions simply evict; the result is exact either way.
(defenum LowerVariantArmResolution
  (Missing String)
  (FieldsErr String)
  (Some String ast.AstType i64 ast.AstTypeList i64))

(define lower-variant-arm-memo-generation : i64
  0)
(define lower-variant-arm-memo-stamps : (__tl_dyn-array i64)
  (array.make-array i64 256))
(define lower-variant-arm-memo-keys : (__tl_dyn-array i64)
  (array.make-array i64 256))
(define lower-variant-arm-memo-scrut-tys : (__tl_dyn-array ast.AstType)
  (array.make-array ast.AstType 256))
(define lower-variant-arm-memo-outcomes : (__tl_dyn-array
    LowerVariantArmResolution)
  (array.make-array LowerVariantArmResolution 256))

(define (lower-variant-arm-memo-next-gen!) : unit
  (set!
    lower-variant-arm-memo-generation
    (+ lower-variant-arm-memo-generation 1)))

(define (lower-variant-arm-resolution-compute
  [ctx : tc_core.TcContext]
  [symbols : csym.CompilerSymbols]
  [scrut-ty : ast.AstType]
  [variant-name-id : i64]) : LowerVariantArmResolution
  (let
    [variant-name : String (tc_core.tc-env-key-name-text variant-name-id)]
    [resolved-scrut-ty : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))]
    [handle : i64
      (lower-variant-constructor-handle-id-or
        ctx
        variant-name
        variant-name-id
        resolved-scrut-ty
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (csym.compiler-registries-variant-fields-indexed symbols handle)
        [(parser.ResultAstTypeList.Ok fields)
          (LowerVariantArmResolution.Some
            variant-name
            resolved-scrut-ty
            handle
            (lower-variant-payload-fields-for-handle
              ctx
              handle
              resolved-scrut-ty
              fields)
            (lower-variant-handle-name-id-or ctx handle variant-name-id))]
        [(parser.ResultAstTypeList.Err message)
          (LowerVariantArmResolution.FieldsErr message)])
      (LowerVariantArmResolution.Missing variant-name))))

(define (lower-variant-arm-resolution
  [ctx : tc_core.TcContext]
  [symbols : csym.CompilerSymbols]
  [scrut-ty : ast.AstType]
  [variant-name-id : i64]) : LowerVariantArmResolution
  (let
    [slot : i64 (- variant-name-id (* (/ variant-name-id 256) 256))]
    (if (and
      (=
        (array-ref lower-variant-arm-memo-stamps slot)
        lower-variant-arm-memo-generation)
      (= (array-ref lower-variant-arm-memo-keys slot) variant-name-id)
      (ast.ast-type-eq-with-pools?
        (tc_core.tc-context-pools ctx)
        (lower-global-array-element-shared-view
          lower-variant-arm-memo-scrut-tys
          slot)
        scrut-ty))
      (array-ref
        (lower-global-shared-view lower-variant-arm-memo-outcomes)
        slot)
      (let
        [result : LowerVariantArmResolution
          (lower-variant-arm-resolution-compute
            ctx
            symbols
            scrut-ty
            variant-name-id)]
        (begin
          (match result
            ;; Error results stay recomputed: diagnostics are cold paths and
            ;; must not pin a stale message across scrutinee types.
            [(LowerVariantArmResolution.FieldsErr _) unit]
            [_
              (begin
                (array-set!
                  lower-variant-arm-memo-stamps
                  slot
                  lower-variant-arm-memo-generation)
                (array-set! lower-variant-arm-memo-keys slot variant-name-id)
                (array-set! lower-variant-arm-memo-scrut-tys slot scrut-ty)
                (array-set! lower-variant-arm-memo-outcomes slot result))])
          result)))))

(define (lower-tail-match-variant-final
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [variant-name-id : i64]
  [args : ast.AstPatternList]
  [body : ast.AstExpr]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]) : ResultLowerState
  (match ctx
    [(tc_core.TcContext _ symbols registries _ _ _ _ _ _)
      (match (lower-variant-arm-resolution ctx symbols scrut-ty variant-name-id)
        [(LowerVariantArmResolution.Missing variant-name)
          (ResultLowerState.Err
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))]
        [(LowerVariantArmResolution.FieldsErr message)
          (ResultLowerState.Err (box (lower-diagnostic message)))]
        [(LowerVariantArmResolution.Some
            variant-name
            resolved-scrut-ty
            handle
            resolved-fields
            handle-name-id)
          (if (lower-pattern-list-refutable-for-types? ctx args resolved-fields)
            (ResultLowerState.Err
              (box
                (lower-diagnostic
                  "lower: refutable payload pattern in final match arm requires a trailing catch-all")))
            (match (lower-bind-match-variant-payloads
              ctx
              state
              env
              type-env
              borrow-lifetime
              (ir.CompilerIrValue.Var scrut-var)
              args
              resolved-fields
              (lower-state-mode state)
              (lower-enum-type-name-id-or resolved-scrut-ty -1)
              (lower-enum-type-name-or-empty resolved-scrut-ty)
              variant-name
              handle-name-id
              0
              8
              (lower-state-current-label state)
              scrut-reg-group?)
              [(ResultLowerEnv.Ok body-start body-env body-type-env)
                (lower-tail-expr
                  ctx
                  body-start
                  body-env
                  body-type-env
                  body
                  ret-ty
                  sret-var)]
              [(ResultLowerEnv.Err message) (ResultLowerState.Err message)]))])]))

(define (lower-tail-match-variant-body
  [ctx : tc_core.TcContext]
  [body-start : LowerState]
  [next-label : i64]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [variant-name : String]
  [variant-name-id : i64]
  [fields : ast.AstTypeList]
  [args : ast.AstPatternList]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerState
  (match (lower-bind-match-variant-payloads
    ctx
    body-start
    env
    type-env
    borrow-lifetime
    (ir.CompilerIrValue.Var scrut-var)
    args
    fields
    (lower-state-mode body-start)
    (lower-enum-type-name-id-or scrut-ty -1)
    (lower-enum-type-name-or-empty scrut-ty)
    variant-name
    variant-name-id
    0
    8
    next-label
    scrut-reg-group?)
    [(ResultLowerEnv.Ok bound-state body-env body-type-env)
      (match (lower-tail-expr
        ctx
        bound-state
        body-env
        body-type-env
        body
        ret-ty
        sret-var)
        [(ResultLowerState.Ok body-state)
          (lower-tail-match-enum-arms
            ctx
            (lower-state-finish-block body-state next-label)
            env
            type-env
            scrut-var
            scrut-ty
            tag-var
            rest
            ret-ty
            sret-var
            borrow-lifetime
            scrut-reg-group?
            total-enum-switch?)]
        [(ResultLowerState.Err message) (ResultLowerState.Err message)])]
    [(ResultLowerEnv.Err message) (ResultLowerState.Err message)]))

(define (lower-tail-match-variant-arm
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [variant-name-id : i64]
  [args : ast.AstPatternList]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerState
  (match ctx
    [(tc_core.TcContext _ symbols registries _ _ _ _ _ _)
      (match (lower-variant-arm-resolution ctx symbols scrut-ty variant-name-id)
        [(LowerVariantArmResolution.Missing variant-name)
          (ResultLowerState.Err
            (box
              (lower-diagnostic
                (string.append "lower: unknown variant " variant-name))))]
        [(LowerVariantArmResolution.FieldsErr message)
          (ResultLowerState.Err (box (lower-diagnostic message)))]
        [(LowerVariantArmResolution.Some
            variant-name
            resolved-scrut-ty
            handle
            resolved-fields
            handle-name-id)
          (match (lower-state-alloc-var state)
            [(LowerAlloc.Alloc eq-alloc eq-var)
              (let
                [next-total-enum-switch? : bool
                  (lower-total-enum-switch-next? total-enum-switch? (& rest))]
                [eq-state : LowerState
                  (lower-state-emit
                    eq-alloc
                    (ir.CompilerIrInstr.BinOp
                      eq-var
                      ir.CompilerIrBinOp.Eq
                      (ir.CompilerIrValue.Var tag-var)
                      (ir.CompilerIrValue.I64
                        (csym.compiler-registry-handle-child-index handle))
                      (ast.AstType.I64)))]
                (match (lower-state-fresh-label eq-state "match_arm")
                  [(LowerLabel.Label body-label-state body-label)
                    (match (lower-state-fresh-label
                      body-label-state
                      (lower-enum-match-next-label-base
                        next-total-enum-switch?
                        rest))
                      [(LowerLabel.Label next-label-state next-label)
                        (let
                          [body-start : LowerState
                            (lower-state-finish-block
                              (lower-state-emit
                                next-label-state
                                (if next-total-enum-switch?
                                  (ir.CompilerIrInstr.TotalEnumBranch
                                    (ir.CompilerIrValue.Var eq-var)
                                    body-label
                                    next-label)
                                  (ir.CompilerIrInstr.Branch
                                    (ir.CompilerIrValue.Var eq-var)
                                    body-label
                                    next-label)))
                              body-label)]
                          (lower-tail-match-variant-body
                            ctx
                            body-start
                            next-label
                            env
                            type-env
                            scrut-var
                            scrut-ty
                            tag-var
                            variant-name
                            handle-name-id
                            resolved-fields
                            args
                            body
                            rest
                            ret-ty
                            sret-var
                            borrow-lifetime
                            scrut-reg-group?
                            next-total-enum-switch?))])]))])])]))

(define (lower-borrowed-enum-match-scrutinee?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [scrutinee : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan scrutinee)
    [(ast.AstExpr.Borrow mutable _ _)
      (if mutable
        false
        (match (tc_core.tc-expr ctx type-env scrutinee)
          [(tc_core.ResultTcType.Ok scrut-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type ctx scrut-ty))
              [(ast.AstType.Ref _ referent-box)
                (let
                  [referent-ty : ast.AstType
                    (tc_core.tc-type-strip-region
                      (tc_core.tc-resolve-type
                        ctx
                        (tc_core.tc-context-type-get ctx referent-box)))]
                  (match referent-ty
                    [(ast.AstType.Enum _) true]
                    [(ast.AstType.EnumArgs _ _) true]
                    [_ false]))]
              [_ false])]
          [(tc_core.ResultTcType.Err _) false]))]
    [_ false]))

;; Where the scrutinee of a match should live: when it is already a var (the
;; common case -- a local, an array-ref result, a call result) use that var
;; directly instead of allocating a fresh one and emitting a group-copying
;; Mov into it (a 2-word enum pays a Pack round-trip per copy).
(defenum LowerScrutineeHome
  (Home LowerState i64))

(define (lower-tail-match-scrutinee-home
  [state : LowerState]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]) : LowerScrutineeHome
  (match scrut-value
    [(ir.CompilerIrValue.Var scrutinee-var)
      (LowerScrutineeHome.Home state scrutinee-var)]
    [_
      (match (lower-state-alloc-var state)
        [(LowerAlloc.Alloc scrut-alloc scrut-var)
          (LowerScrutineeHome.Home
            (lower-state-emit
              scrut-alloc
              (ir.CompilerIrInstr.Mov scrut-var scrut-value scrut-ty))
            scrut-var)])]))

(define (lower-tail-match
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (if (lower-borrowed-enum-match-scrutinee? ctx type-env scrutinee)
    (lower-return-expr ctx state env type-env origin ret-ty sret-var)
    (match (lower-expr ctx state env type-env scrutinee)
      [(ResultLowerExpr.Ok scrut-lowered)
        (match scrut-lowered
          [(LowerExpr.Expr scrut-state scrut-value scrut-ty)
            (match (lower-tail-match-scrutinee-home
              scrut-state
              scrut-value
              scrut-ty)
              [(LowerScrutineeHome.Home match-state scrut-var)
                (match (tc_core.tc-type-strip-region
                  (tc_core.tc-resolve-type ctx scrut-ty))
                  [(ast.AstType.Enum _)
                    (lower-tail-match-enum
                      ctx
                      match-state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var
                      (tc_core.TcMaybeNameId.No)
                      false)]
                  [(ast.AstType.EnumArgs _ _)
                    (lower-tail-match-enum
                      ctx
                      match-state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var
                      (tc_core.TcMaybeNameId.No)
                      false)]
                  [(ast.AstType.Ref borrow-lifetime referent-box)
                    (let
                      [referent-ty : ast.AstType
                        (tc_core.tc-type-strip-region
                          (tc_core.tc-resolve-type
                            ctx
                            (tc_core.tc-context-type-get ctx referent-box)))]
                      (match referent-ty
                        [(ast.AstType.Enum _)
                          (lower-tail-match-enum
                            ctx
                            match-state
                            env
                            type-env
                            scrut-var
                            referent-ty
                            arms
                            ret-ty
                            sret-var
                            (tc_core.TcMaybeNameId.Some borrow-lifetime)
                            true)]
                        [(ast.AstType.EnumArgs _ _)
                          (lower-tail-match-enum
                            ctx
                            match-state
                            env
                            type-env
                            scrut-var
                            referent-ty
                            arms
                            ret-ty
                            sret-var
                            (tc_core.TcMaybeNameId.Some borrow-lifetime)
                            true)]
                        [_
                          (lower-tail-match-arms
                            ctx
                            match-state
                            env
                            type-env
                            scrut-var
                            scrut-ty
                            arms
                            ret-ty
                            sret-var)]))]
                  [(ast.AstType.VarArgs _ _)
                    (lower-tail-match-enum
                      ctx
                      match-state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var
                      (tc_core.TcMaybeNameId.No)
                      false)]
                  [_
                    (lower-tail-match-arms
                      ctx
                      match-state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arms
                      ret-ty
                      sret-var)])])])]
      [(ResultLowerExpr.Err message) (ResultLowerState.Err message)])))

(define (lower-tail-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-tail-expr ctx state env type-env inner ret-ty sret-var))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-tail-expr ctx state env type-env inner ret-ty sret-var))]
    [(ast.AstExpr.Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (tc_core.tc-expr ctx type-env inner)
          [(tc_core.ResultTcType.Ok inner-ty)
            (if (tc_core.tc-type-eq
              (tc_core.tc-type-without-regions inner-ty)
              ret-ty)
              (lower-tail-expr ctx state env type-env inner ret-ty sret-var)
              (lower-return-expr ctx state env type-env expr ret-ty sret-var))]
          [(tc_core.ResultTcType.Err message)
            (ResultLowerState.Err
              (box (lower-diagnostic-at-expr inner message)))]))]
    [(ast.AstExpr.Call callee-box args)
      (let
        [callee : ast.AstExpr (lower-context-expr-get ctx callee-box)]
        (lower-tail-call
          ctx
          state
          env
          type-env
          callee
          args
          ret-ty
          sret-var
          expr))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(ResultLowerEnv.Ok binding-state body-env body-type-env)
                (lower-tail-expr
                  ctx
                  binding-state
                  body-env
                  body-type-env
                  body
                  ret-ty
                  sret-var)]
              [(ResultLowerEnv.Err message) (ResultLowerState.Err message)]))])]
    [(ast.AstExpr.Begin exprs)
      (lower-tail-begin ctx state env type-env exprs ret-ty sret-var)]
    [(ast.AstExpr.Unsafe exprs)
      (lower-tail-begin
        ctx
        state
        env
        (tc_core.tc-enter-unsafe type-env)
        exprs
        ret-ty
        sret-var)]
    [(ast.AstExpr.If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-tail-if
          ctx
          state
          env
          type-env
          cond
          then-branch
          else-branch
          ret-ty
          sret-var))]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-tail-match
              ctx
              state
              env
              type-env
              scrutinee
              arms
              ret-ty
              sret-var
              expr))])]
    [_ (lower-return-expr ctx state env type-env expr ret-ty sret-var)]))

(define (lower-param-count [params : ast.AstParamList]) : i64
  (ast.ast-param-list-len (& params)))

(define (lower-internal-param-list-contains-structural?
  [ctx : tc_core.TcContext]
  [params : ast.AstParamList]) : bool
  (lower-internal-param-list-contains-structural-at? ctx (& params) 0))

(define (lower-internal-param-list-contains-structural-at?
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-param-list-len params))
    false
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param _ ty _ _)
        (or
          (lower-internal-structural-type? ctx ty)
          (lower-internal-param-list-contains-structural-at?
            ctx
            params
            (+ index 1)))])))

(define (lower-bind-params
  [params : ast.AstParamList]
  [idx : i64]
  [env : sym_i64_env.SymI64Env]) : sym_i64_env.SymI64Env
  (lower-bind-params-at (& params) 0 idx env))

(define (lower-bind-params-at
  [params : (& params ast.AstParamList)]
  [index : i64]
  [idx : i64]
  [env : sym_i64_env.SymI64Env]) : sym_i64_env.SymI64Env
  (if (>= index (ast.ast-param-list-len params))
    env
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name _ _ _)
        (lower-bind-params-at
          params
          (+ index 1)
          (+ idx 1)
          (sym_i64_env.sym-i64-bind-id env name idx))])))

(define (lower-param-list
  [ctx : tc_core.TcContext]
  [params : ast.AstParamList]
  [idx : i64]) : ir.CompilerIrParamList
  (lower-param-list-at ctx (& params) 0 idx))

;; Internal functions keep one physical IR argument per source parameter. A
;; structural sret pointer, when present, is the first physical argument; the
;; source range therefore starts at `source-start` and never includes hidden
;; arguments in the tail-call forwarding range.
(define (lower-internal-param-list
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [params : ast.AstParamList]
  [source-start : i64]
  [leading-sret? : bool]) : ir.CompilerIrParamList
  (let
    [source : ir.CompilerIrParamList
      (lower-internal-param-list-at ctx mode (& params) 0 source-start)]
    (if leading-sret?
      (ir.compiler-ir-param-cons
        (ir.CompilerIrParam.Param "__sret" (ast.AstType.U64) (- source-start 1))
        source)
      source)))

(define (lower-internal-param-list-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [idx : i64]) : ir.CompilerIrParamList
  (if (>= index (ast.ast-param-list-len params))
    ir.CompilerIrParamList.Nil
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name ty _ _)
        (ir.compiler-ir-param-cons
          (ir.CompilerIrParam.Param
            (tc_core.tc-env-key-name-text name)
            (lower-internal-param-physical-type ctx mode ty)
            idx)
          (lower-internal-param-list-at ctx mode params (+ index 1) (+ idx 1)))])))

(define (lower-internal-param-storage-two
  [physical : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [slots : LowerCAbiSlotList]
  [storage : ir.CompilerIrValue]
  [storage-state : LowerState]) : ResultLowerExpr
  (match (lower-c-abi-slot-list-ref slots 0)
    [(LowerCAbiSlot.Slot first-ty first-offset)
      (match (lower-emit-word storage-state physical 0 first-ty)
        [(LowerExpr.Expr first-state first-value _)
          (match (lower-c-abi-slot-list-ref slots 1)
            [(LowerCAbiSlot.Slot second-ty second-offset)
              (match (lower-emit-word first-state physical 1 second-ty)
                [(LowerExpr.Expr second-state second-value _)
                  (let
                    [with0 : LowerState
                      (lower-store-at-offset
                        second-state
                        storage
                        first-offset
                        first-value
                        first-ty)]
                    [with1 : LowerState
                      (lower-store-at-offset
                        with0
                        storage
                        second-offset
                        second-value
                        second-ty)]
                    (ResultLowerExpr.Ok
                      (LowerExpr.Expr with1 storage source-ty)))])])])]))

(define (lower-internal-param-storage
  [state : LowerState]
  [physical : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [classification : LowerCAbiAggregate]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match classification
    [(LowerCAbiAggregate.Integer scalar-ty size)
      (match (lower-reserve-inline-storage state size source-ty)
        [(LowerExpr.Expr storage-state storage _)
          (ResultLowerExpr.Ok
            (LowerExpr.Expr
              (lower-store-at-offset storage-state storage 0 physical scalar-ty)
              storage
              source-ty))])]
    [(LowerCAbiAggregate.Register slots size)
      (match (lower-reserve-inline-storage state size source-ty)
        [(LowerExpr.Expr storage-state storage _)
          (if (= (lower-c-abi-slot-list-count slots) 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(LowerCAbiSlot.Slot scalar-ty offset)
                (ResultLowerExpr.Ok
                  (LowerExpr.Expr
                    (lower-store-at-offset
                      storage-state
                      storage
                      offset
                      physical
                      scalar-ty)
                    storage
                    source-ty))])
            (lower-internal-param-storage-two
              physical
              source-ty
              slots
              storage
              storage-state))])]
    [(LowerCAbiAggregate.No)
      (ResultLowerExpr.Ok (LowerExpr.Expr state physical source-ty))]
    [(LowerCAbiAggregate.Memory _)
      (ResultLowerExpr.Ok (LowerExpr.Expr state physical source-ty))]
    [(LowerCAbiAggregate.ByRef _)
      (ResultLowerExpr.Ok (LowerExpr.Expr state physical source-ty))]
    [(LowerCAbiAggregate.Unsupported message)
      (ResultLowerExpr.Err (box (lower-diagnostic-at-expr origin message)))]
    [(LowerCAbiAggregate.Sret _)
      (ResultLowerExpr.Err
        (box
          (lower-diagnostic-at-expr
            origin
            "lower: structural return classification used for parameter")))]))

(define (lower-bind-internal-params-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [physical-index : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [origin : ast.AstExpr]) : ResultLowerEnv
  (if (>= index (ast.ast-param-list-len params))
    (ResultLowerEnv.Ok state env type-env)
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name ty _ _)
        (let
          [source-ty : ast.AstType
            (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
          [physical-value : ir.CompilerIrValue
            (ir.CompilerIrValue.Var physical-index)]
          [classification : LowerCAbiAggregate
            (lower-internal-param-class ctx mode source-ty)]
          (match (lower-internal-param-storage
            state
            physical-value
            source-ty
            classification
            origin)
            [(ResultLowerExpr.Ok materialized)
              (match materialized
                [(LowerExpr.Expr next-state source-value _)
                  (lower-bind-internal-params-at
                    ctx
                    mode
                    params
                    (+ index 1)
                    (+ physical-index 1)
                    next-state
                    (sym_i64_env.sym-i64-bind-id
                      env
                      name
                      (match source-value
                        [(ir.CompilerIrValue.Var source-var) source-var]
                        [_ physical-index]))
                    (tc_core.tc-bind-id type-env name source-ty)
                    origin)])]
            [(ResultLowerExpr.Err message) (ResultLowerEnv.Err message)]))])))

(define (lower-bind-internal-params
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [params : ast.AstParamList]
  [source-start : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [origin : ast.AstExpr]) : ResultLowerEnv
  (lower-bind-internal-params-at
    ctx
    mode
    (& params)
    0
    source-start
    state
    env
    type-env
    origin))

(define (lower-param-list-at
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [idx : i64]) : ir.CompilerIrParamList
  (if (>= index (ast.ast-param-list-len params))
    ir.CompilerIrParamList.Nil
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param name ty _ _)
        (ir.compiler-ir-param-cons
          (ir.CompilerIrParam.Param
            (tc_core.tc-env-key-name-text name)
            (lower-one-word-register-storage-type
              ctx
              (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty)))
            idx)
          (lower-param-list-at ctx params (+ index 1) (+ idx 1)))])))

;; sret ABI: append the hidden result-slot pointer param at index
;; `sret-var` (the var id reserved just past the real params). Internal calling
;; convention only -- C-ABI externs keep their own ABI on a separate path.
(define (lower-param-list-append-sret
  [params : ir.CompilerIrParamList]
  [sret-var : i64]) : ir.CompilerIrParamList
  (match (ir.compiler-ir-param-list-force-cons params)
    [(ir.CompilerIrParamList.Nil)
      (ir.compiler-ir-param-cons
        (ir.CompilerIrParam.Param "__sret" (ast.AstType.U64) sret-var)
        ir.CompilerIrParamList.Nil)]
    [(ir.CompilerIrParamList.Array seq)
      (lower-param-list-append-sret
        (ir.compiler-ir-param-seq-to-list seq)
        sret-var)]
    [(ir.CompilerIrParamList.Cons head rest)
      (ir.compiler-ir-param-cons
        head
        (lower-param-list-append-sret (box-get rest) sret-var))]))

(define (lower-supported-function-param-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (lower-supported-reference-type? ctx ty))

(define (lower-type-contains-inline-aggregate?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(ast.AstType.Struct _) true]
    [(ast.AstType.StructArgs _ _) true]
    [(ast.AstType.Enum _) true]
    [(ast.AstType.EnumArgs _ _) true]
    [(ast.AstType.Tuple _) true]
    [(ast.AstType.Array _ _) true]
    [(ast.AstType.Region _ inner)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc_core.tc-context-type-get ctx inner))]
    ;; A reference can point INTO the current frame (memory-aggregate
    ;; locals live in frame slots), so a ref arg whose referent is or
    ;; contains an inline aggregate makes a tail call unsafe -- the callee
    ;; would read through a pointer into the reused/abandoned frame.
    [(ast.AstType.Ref _ referent)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc_core.tc-context-type-get ctx referent))]
    [(ast.AstType.MutRef _ referent)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc_core.tc-context-type-get ctx referent))]
    [_ false]))

(define (lower-type-list-contains-inline-aggregate?
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : bool
  (lower-type-list-contains-inline-aggregate-at? ctx (& types) 0))

(define (lower-type-list-contains-inline-aggregate-at?
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-type-list-len types))
    false
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (or
        (lower-type-contains-inline-aggregate? ctx ty)
        (lower-type-list-contains-inline-aggregate-at? ctx types (+ index 1))))))

(define (lower-param-list-contains-unsupported-reference?
  [ctx : tc_core.TcContext]
  [params : ast.AstParamList]) : bool
  (lower-param-list-contains-unsupported-reference-at? ctx (& params) 0))

(define (lower-param-list-contains-unsupported-reference-at?
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-param-list-len params))
    false
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(ast.AstParam.Param _ ty _ _)
        (or
          (not (lower-supported-function-param-type? ctx ty))
          (lower-param-list-contains-unsupported-reference-at?
            ctx
            params
            (+ index 1)))])))

(define (lower-supported-function-return-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-resolve-type ctx ty)
    [(ast.AstType.Region _ inner)
      (lower-supported-function-return-type?
        ctx
        (tc_core.tc-context-type-get ctx inner))]
    [_ true]))

(define (lower-logical-name-has-prefix?
  [logical-name : String]
  [prefix : String]) : bool
  (let
    [name-len : i64 (string.string-length logical-name)]
    [prefix-len : i64 (string.string-length prefix)]
    (and
      (>= name-len prefix-len)
      (string.eq (string.substring logical-name 0 prefix-len) prefix))))

;; sret ABI: a `__global_init_<name>` initializer's result is stored into
;; a forever-lived global by the backend's startup sequence (not a normal call
;; site), so it must return stable arena storage -- never a caller stack sret
;; slot. Keep these on the arena return path.
(define (lower-global-init-function? [logical-name : String]) : bool
  (lower-logical-name-has-prefix? logical-name "__global_init_"))

(define (lower-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (if (or
    (lower-param-list-contains-unsupported-reference? ctx params)
    (not (lower-supported-reference-type? ctx ret)))
    (ResultLowerFunction.Err
      (box (lower-diagnostic (lower-reference-support-message))))
    (let
      [logical-name-text : String (ir.compiler-ir-symbol-text logical-name)]
      [param-count : i64 (lower-param-count params)]
      [ret-ty : ast.AstType
        (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret))]
      [ret-class : LowerCAbiAggregate
        (lower-internal-return-class-for-name ctx mode logical-name-text ret-ty)]
      [structural-sret? : bool
        (match ret-class
          [(LowerCAbiAggregate.Sret _) true]
          [_ false])]
      [nominal-sret? : bool
        (and
          (not structural-sret?)
          (lower-mode-inline-aggregates? mode)
          (not (lower-global-init-function? logical-name-text))
          (lower-type-inline-struct-or-enum? ctx ret-ty)
          (not (lower-type-register-resident? ctx ret-ty)))]
      [source-start : i64
        (if structural-sret?
          1
          0)]
      [structural-params? : bool
        (lower-internal-param-list-contains-structural? ctx params)]
      [sret-var : i64
        (if structural-sret?
          0
          (if nominal-sret?
            (+ source-start param-count)
            (- 0 1)))]
      [ret-ir-ty : ast.AstType
        (match ret-class
          [(LowerCAbiAggregate.Unsupported _) (ast.AstType.U64)]
          [_ (lower-internal-return-physical-type ctx mode ret-ty)])]
      [type-env : tc_core.TcTypeEnv
        (tc_core.tc-bind-return-type
          (tc_core.tc-bind-params
            ctx
            (tc_core.tc-hygiene-global-env top-env)
            params)
          ret-ty)]
      [function-spans : ir.CompilerSourceSpans
        (lower-record-function-span
          spans
          (ir.compiler-ir-symbol-typed-id logical-name)
          body)]
      [state : LowerState
        (lower-state-new
          (+
            source-start
            param-count
            (if nominal-sret?
              1
              0))
          0
          0
          (ir.compiler-ir-label "entry")
          (ir.compiler-ir-instr-builder-new)
          (ir.compiler-ir-block-builder-new)
          (ir.compiler-ir-function-builder-new)
          logical-name
          (box function-spans)
          names
          type-cache
          mode
          (lower_i64_i64_map.with-capacity 8)
          source-start
          (+ source-start param-count))]
      (match ret-class
        [(LowerCAbiAggregate.Unsupported message)
          (ResultLowerFunction.Err
            (box (lower-diagnostic-at-expr body message)))]
        [_
          (if (lower-supported-function-return-type? ctx ret-ty)
            (let
              [initial-env : sym_i64_env.SymI64Env
                (if (>= sret-var 0)
                  (sym_i64_env.sym-i64-bind-id
                    (sym_i64_env.sym-i64-empty)
                    (lower-sret-param-marker-id)
                    sret-var)
                  (sym_i64_env.sym-i64-empty))]
              (match (if structural-params?
                (lower-bind-internal-params
                  ctx
                  mode
                  params
                  source-start
                  state
                  initial-env
                  type-env
                  body)
                (ResultLowerEnv.Ok
                  state
                  (lower-bind-params params source-start initial-env)
                  type-env))
                [(ResultLowerEnv.Ok bound-state bound-env bound-type-env)
                  (match (lower-tail-expr
                    ctx
                    bound-state
                    bound-env
                    bound-type-env
                    body
                    ret-ty
                    sret-var)
                    [(ResultLowerState.Ok final-state)
                      (let
                        [source-params : ir.CompilerIrParamList
                          (if structural-params?
                            (lower-internal-param-list
                              ctx
                              mode
                              params
                              source-start
                              structural-sret?)
                            (let
                              [source : ir.CompilerIrParamList
                                (lower-param-list ctx params source-start)]
                              (if structural-sret?
                                (ir.compiler-ir-param-cons
                                  (ir.CompilerIrParam.Param
                                    "__sret"
                                    (ast.AstType.U64)
                                    (- source-start 1))
                                  source)
                                source)))]
                        [all-params : ir.CompilerIrParamList
                          (if nominal-sret?
                            (lower-param-list-append-sret
                              source-params
                              sret-var)
                            source-params)]
                        (ResultLowerFunction.Ok
                          (lower-state-build-functions-with
                            final-state
                            (ir.CompilerIrFunction.Function
                              logical-name
                              all-params
                              ret-ir-ty
                              (lower-state-next-var final-state)
                              (lower-state-build-function-blocks final-state)))
                          (lower-state-spans final-state)))]
                    [(ResultLowerState.Err message)
                      (ResultLowerFunction.Err message)])]
                [(ResultLowerEnv.Err message) (ResultLowerFunction.Err message)]))
            (ResultLowerFunction.Err
              (box
                (lower-diagnostic-at-expr body "lower: unsupported expression"))))]))))

(define (lower-global-value
  [ctx : tc_core.TcContext]
  [names : LowerNameCache]
  [expr : ast.AstExpr]
  [ty : ast.AstType]) : ResultLowerValue
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-global-value ctx names inner ty))]
    [(ast.AstExpr.Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-global-value ctx names inner ty))]
    [(ast.AstExpr.Cast inner-box cast-ty-id)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-global-value
          ctx
          names
          inner
          (tc_core.tc-context-type-get ctx cast-ty-id)))]
    [(ast.AstExpr.Literal lit)
      (ResultLowerValue.Ok (lower-literal-value-with-type lit ty))]
    [(ast.AstExpr.BinaryData bytes)
      (ResultLowerValue.Ok (ir.CompilerIrValue.Bytes bytes))]
    [(ast.AstExpr.SpmdProgramIndex)
      (ResultLowerValue.Ok (ir.CompilerIrValue.I64 0))]
    [(ast.AstExpr.SpmdProgramCount)
      (ResultLowerValue.Ok (ir.CompilerIrValue.I64 1))]
    [(ast.AstExpr.Var name)
      (let
        [logical-id : i64
          (lower-name-cache-resolve-logical-id (& names) name name)]
        [display-name : String
          (match (lower-name-cache-resolve-id-display names name)
            [(tc_core.TcMaybeString.Some resolved) resolved]
            [(tc_core.TcMaybeString.No)
              (ci.intern-str
                (tc_core.macro-hygiene-global-source-name-id-or name name))])]
        (ResultLowerValue.Ok
          (ir.CompilerIrValue.Global
            (lower-name-cache-ir-symbol names logical-id name display-name))))]
    [_
      (ResultLowerValue.Err
        (box (lower-diagnostic "lower: unsupported global initializer")))]))

(define (lower-global-init-function-name [global : i64]) : i64
  (ci.intern-generated-name
    (string.append "__global_init_" (ir.compiler-ir-symbol-text global))))

(define (lower-top-decl-type-or-check
  [ctx : tc_core.TcContext]
  [env : tc_core.TcTypeEnv]
  [decl : ast.AstDecl]) : tc_core.ResultTcType
  (let
    [actual : ast.AstDecl (ast.ast-decl-unwrapped decl)]
    (match actual
      [(ast.AstDecl.Def decl-meta name _ _)
        (match (tc_core.tc-lookup-id env name)
          [(tc_core.ResultTcType.Ok ty) (tc_core.ResultTcType.Ok ty)]
          [(tc_core.ResultTcType.Err _)
            (tc_core.tc-top-decl-type-with-env ctx env actual)])]
      [_ (tc_core.tc-top-decl-type-with-env ctx env actual)])))

;; Record `name -> body span` into the provenance table. A function whose
;;
;; body carries no source span leaves the table unchanged, so the backend simply
;;
;; falls back to its default location for that function.
(define (lower-record-function-span
  [spans : ir.CompilerSourceSpans]
  [name : ir.CompilerIrSymbolId]
  [body : ast.AstExpr]) : ir.CompilerSourceSpans
  (match (lower-ast-expr-direct-span body)
    [(ir.CompilerMaybeSourceSpan.Some span)
      (if (ir.compiler-debug-info-enabled?)
        (ir.compiler-source-spans-insert-located
          spans
          name
          lower-current-source-path-id
          span)
        (ir.compiler-source-spans-insert spans name span))]
    [(ir.CompilerMaybeSourceSpan.No) spans]))

;; Reusable per-function lowering scratch arena. Lowering one function
;; allocates a fresh `LowerState` plus the transient IR/AST-walk scratch the bump
;; allocator never frees; summed across cli.tl's ~5000 functions this transient
;; dominates the lower phase's peak live (the headline self-build memory number).
;; We lower each function inside one shared scratch arena and `tl_region_reset` it
;; after deep-`clone`ing ONLY the produced IR function list back into the
;; enclosing (program) arena -- reclaiming the per-function transient before the
;; next function. The arena is created lazily once and reused (rewound, never
;; remapped) per function, mirroring the optimizer's per-function escape
;; (`optimize-function-escaping`). The spans side-table insertion is recomputed
;; in the enclosing arena (it never affects emitted assembly, only backend-error
;; source locations). `lower-function-escaping` is only ever called at decl
;; granularity (never re-entrant within `lower-function`'s body walk), so a
;; single shared mark/rewind region is sound. Output stays byte-identical: the
;; clone is a structural deep copy, so the escaped IR lowers to the same assembly
;; as the in-place IR did.
;; Dotted imports create transient lookup-key strings during function lowering
;; (`module/name` from `alias.name`). Any new intern entry made from those
;; strings must survive the scratch rewind, so the scope mirrors
;; `tc-check-fn-decl-scoped` and forces persistent intern storage while active.
(defstruct CompilerLowerArenaState
  (scratch-arena (__tl_dyn-array i64))
  (ir-arena (__tl_dyn-array i64)))

(define lower-scratch-arena : i64
  0)

(define (lower-scratch-arena-get) : i64
  (if (= lower-scratch-arena 0)
    (let
      [scratch : i64 (arena.tl_arena_make)]
      (begin
        (set! lower-scratch-arena scratch)
        scratch))
    lower-scratch-arena))

(define (lower-scratch-arena-release!) : unit
  (if (= lower-scratch-arena 0)
    unit
    (begin
      (unsafe
        (arena.tl_arena_destroy lower-scratch-arena))
      (set! lower-scratch-arena 0))))

(define (lower-scratch-arena-release-after-overflow!
  [scratch : i64]
  [scratch-head : i64]) : unit
  ;; Region reset retains overflow mappings to preserve the public stale-address
  ;; semantics. A lowered function has already cloned every live result into the
  ;; IR/enclosing arenas, so recycle an overflowed internal scratch arena here
  ;; instead of accumulating one 64 MiB mapping per large function.
  (if (= scratch scratch-head)
    unit
    (lower-scratch-arena-release!)))

;; Dedicated arena for the escaped (lowered) IR function bodies. The
;; lowered IR is consumed exactly once: at opt levels >= 1 the optimizer
;; deep-clones every surviving function into the enclosing arena
;; (optimize-function-escaping), after which the entire input IR is dead --
;; ~172MB on a cli.tl self-compile that the program-lifetime arena would
;; never reclaim. Cloning the lowered functions into this arena instead lets
;; the driver destroy it right after optimization. At opt level 0 the
;; program flows to the backend unchanged, so the arena must stay alive for
;; the whole compile (the driver only releases it for levels >= 1; batch
;; compiles release it between entries). Globals, externs, and the spans
;; side-table are NOT allocated here -- they outlive optimization.
(define lower-ir-arena : i64
  0)

(define (lower-ir-arena-get) : i64
  (if (= lower-ir-arena 0)
    (let
      [arena : i64 (arena.tl_arena_make)]
      (begin
        (set! lower-ir-arena arena)
        arena))
    lower-ir-arena))

(define (lower-ir-arena-release!) : unit
  (if (= lower-ir-arena 0)
    unit
    (begin
      (unsafe
        (arena.tl_arena_destroy lower-ir-arena))
      (set! lower-ir-arena 0))))

(define (lower-arenas-release!) : unit
  (begin
    (lower-scratch-arena-release!)
    (lower-ir-arena-release!)))

(define (compiler-lower-arena-state-new) : CompilerLowerArenaState
  (let
    [scratch : (__tl_dyn-array i64) (make-array i64 1)]
    [ir : (__tl_dyn-array i64) (make-array i64 1)]
    (begin
      (array-set! scratch 0 0)
      (array-set! ir 0 0)
      (CompilerLowerArenaState scratch ir))))

(define (compiler-lower-arena-state-scratch-arena
  [state : CompilerLowerArenaState]) : i64
  (array-ref (struct-get state scratch-arena) 0))

(define (compiler-lower-arena-state-ir-arena [state : CompilerLowerArenaState]) : i64
  (array-ref (struct-get state ir-arena) 0))

(define (compiler-lower-arena-state-set!
  [state : CompilerLowerArenaState]
  [scratch : i64]
  [ir : i64]) : unit
  (begin
    (array-set! (struct-get state scratch-arena) 0 scratch)
    (array-set! (struct-get state ir-arena) 0 ir)))

(define (compiler-lower-arena-state-capture-from-globals!
  [state : CompilerLowerArenaState]) : unit
  (compiler-lower-arena-state-set! state lower-scratch-arena lower-ir-arena))

(define (compiler-lower-arena-state-install! [state : CompilerLowerArenaState]) : unit
  (begin
    (set! lower-scratch-arena (compiler-lower-arena-state-scratch-arena state))
    (set! lower-ir-arena (compiler-lower-arena-state-ir-arena state))))

;; State-owned release: destroy the arenas named by the state's own cells and
;; zero them. The compatibility-global selectors are zeroed only when they
;; still name this state's handles (the state is the installed owner);
;; releasing an uninstalled state must not disturb another state's installed
;; arenas. Destroying an older head still reclaims the whole chain -- the
;; runtime root tracks the newest live segment -- but callers must refresh the
;; state's cells from the globals after any phase that can grow a chain
;; (post-emission session-floor capture), so a stored head never trails the
;; installed selector by the time a release runs.
(define (compiler-lower-arena-state-release-scratch!
  [state : CompilerLowerArenaState]) : unit
  (let
    [scratch : i64 (compiler-lower-arena-state-scratch-arena state)]
    (if (= scratch 0)
      unit
      (begin
        (array-set! (struct-get state scratch-arena) 0 0)
        (if (= lower-scratch-arena scratch)
          (set! lower-scratch-arena 0)
          unit)
        (unsafe
          (arena.tl_arena_destroy scratch))))))

(define (compiler-lower-arena-state-release-ir!
  [state : CompilerLowerArenaState]) : unit
  (let
    [ir : i64 (compiler-lower-arena-state-ir-arena state)]
    (if (= ir 0)
      unit
      (begin
        (array-set! (struct-get state ir-arena) 0 0)
        (if (= lower-ir-arena ir)
          (set! lower-ir-arena 0)
          unit)
        (unsafe
          (arena.tl_arena_destroy ir))))))

(define (compiler-lower-arena-state-release! [state : CompilerLowerArenaState]) : unit
  (begin
    (compiler-lower-arena-state-release-scratch! state)
    (compiler-lower-arena-state-release-ir! state)))

(define (lower-function-list-escape-to-ir-arena
  [functions : ir.CompilerIrFunctionList]) : ir.CompilerIrFunctionList
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    (begin
      (unsafe
        (arena.tl_arena_set (lower-ir-arena-get)))
      (let
        [escaped : ir.CompilerIrFunctionList
          (ir.compiler-ir-clone-function-list
            (ast.ast-node-pool-reader-context-current)
            functions)]
        (begin
          (set! lower-ir-arena (arena.tl_arena_current))
          (unsafe
            (arena.tl_arena_set enclosing))
          escaped)))))

(define (lower-function-escaping
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (lower-scratch-arena-get)]
    (begin
      ;; Type-name/owner caches may contain keys allocated by earlier
      ;; typecheck or lower scratch scopes. Keep them scoped to this lowering
      ;; pass and invalidate them before rewinding this function's scratch arena.
      (tc_core.tc-nominal-owner-cache-reset!)
      ;; Compile-time: new generation for the result-type-fast memo, so
      ;; this function's cached node types are independent of every other
      ;; function's (and never outlive this function's scratch arena).
      (tc-rtf-next-gen!)
      ;; Same generation discipline for the per-match variant arm
      ;; resolution memo.
      (lower-variant-arm-memo-next-gen!)
      ;; The scalar context and recursive-helper stack carry scratch-owned
      ;; values while lowering one function. Never let those scoped values
      ;; cross the per-function arena rewind into the next top-level function.
      (set! lower-spmd-scalar-call-context (LowerSpmdScalarCallContext.No))
      (set!
        lower-spmd-inline-helper-stack
        (lower-spmd-inline-empty-helper-stack))
      (unsafe
        (arena.tl_arena_set scratch))
      (let
        [mark : i64 (arena.tl_region_mark)]
        (match (lower-function
          ctx
          top-env
          type-cache
          logical-name
          params
          ret
          body
          spans
          names
          mode)
          [(ResultLowerFunction.Ok fns function-spans)
            (let
              [scratch-head : i64 (arena.tl_arena_current)]
              [escaped-fns : ir.CompilerIrFunctionList
                (lower-function-list-escape-to-ir-arena fns)]
              ;; The IR function clones go to the dedicated lowered-IR
              ;; arena (released by the driver after optimization); the
              ;; spans side-table is rebuilt in the enclosing arena since
              ;; it outlives the lowered IR. The stored handle must follow
              ;; the arena's grown head, or every later allocation re-walks
              ;; the overflow path from the full first segment.
              (begin
                (unsafe
                  (arena.tl_arena_set enclosing))
                (set!
                  lower-spmd-inline-helper-stack
                  (lower-spmd-inline-empty-helper-stack))
                (let
                  [escaped-spans : ir.CompilerSourceSpans
                    (ir.compiler-source-spans-append-new spans function-spans)]
                  [new-enclosing : i64 (arena.tl_arena_current)]
                  (begin
                    (unsafe
                      (arena.tl_arena_set scratch-head)
                      (arena.tl_region_reset mark)
                      (arena.tl_arena_set new-enclosing))
                    (lower-scratch-arena-release-after-overflow!
                      scratch
                      scratch-head)
                    (tc_core.tc-nominal-owner-cache-reset!)
                    (ResultLowerFunction.Ok escaped-fns escaped-spans)))))]
          [(ResultLowerFunction.Err message)
            (let
              [scratch-head : i64 (arena.tl_arena_current)]
              (begin
                (unsafe
                  (arena.tl_arena_set enclosing))
                (set!
                  lower-spmd-inline-helper-stack
                  (lower-spmd-inline-empty-helper-stack))
                (let
                  [escaped-message : (Box cdiag.CompilerDiagnostic)
                    (clone message)]
                  [new-enclosing : i64 (arena.tl_arena_current)]
                  (begin
                    (unsafe
                      (arena.tl_arena_set scratch-head)
                      (arena.tl_region_reset mark)
                      (arena.tl_arena_set new-enclosing))
                    (lower-scratch-arena-release-after-overflow!
                      scratch
                      scratch-head)
                    (tc_core.tc-nominal-owner-cache-reset!)
                    (ResultLowerFunction.Err escaped-message)))))])))))

(define lower-struct-cleanup-param-id-cache : i64
  -1)
(define lower-struct-cleanup-param-id-cache-generation : i64
  -1)

(define (lower-struct-cleanup-param-id) : i64
  (if (= lower-struct-cleanup-param-id-cache-generation (ci.intern-generation))
    lower-struct-cleanup-param-id-cache
    (let
      [id : i64 (ci.intern-generated-name "__tl_cleanup_value")]
      (begin
        (set! lower-struct-cleanup-param-id-cache id)
        (set!
          lower-struct-cleanup-param-id-cache-generation
          (ci.intern-generation))
        id))))

(define (lower-struct-cleanup-qualified-id
  [ctx : tc_core.TcContext]
  [struct-id : i64]
  [cleanup-id : i64]) : i64
  (if (or
    (tc_core.tc-name-qualified-id? cleanup-id)
    (>= cleanup-id (ci.intern-capacity)))
    cleanup-id
    (let
      [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols ctx)]
      [handle : i64
        (csym.compiler-symbols-lookup-type-id-or
          symbols
          struct-id
          (csym.compiler-symbols-missing-handle))]
      [module-id : i64
        (if (csym.compiler-symbols-handle-found? handle)
          (csym.compiler-symbols-owner-module-id-at-index-or
            symbols
            (csym.compiler-symbol-handle-index handle)
            cbi.compiler-builtin-id-fix-empty)
          cbi.compiler-builtin-id-fix-empty)]
      (if (or (< module-id 0) (= module-id cbi.compiler-builtin-id-fix-empty))
        cleanup-id
        (ci.intern-generated-canonical-qualified-name
          (csym.compiler-symbol-module-key
            (ci.intern-str module-id)
            (tc_core.tc-env-key-name-text cleanup-id))
          module-id
          cleanup-id)))))

(define (lower-struct-cleanup-id-for-struct
  [ctx : tc_core.TcContext]
  [struct-id : i64]) : tc_core.ResultTcNameId
  (match (tc_core.tc-struct-decl-id ctx struct-id)
    [(tc_core.ResultTcStructDecl.Ok decl)
      (match decl
        [(tc_core.TcStructDecl _ cleanup _)
          (match cleanup
            [(ast.AstStructCleanup.Fn cleanup-name)
              (tc_core.ResultTcNameId.Ok
                (lower-struct-cleanup-qualified-id ctx struct-id cleanup-name))]
            [(ast.AstStructCleanup.No)
              (tc_core.ResultTcNameId.Err
                (string.append
                  "lower: owned cleanup field type has no cleanup function "
                  (tc_core.tc-nominal-name-id-display struct-id)))])])]
    [(tc_core.ResultTcStructDecl.Err message)
      (tc_core.ResultTcNameId.Err message)]))

(define (lower-enum-cleanup-id-for-enum
  [ctx : tc_core.TcContext]
  [enum-id : i64]) : tc_core.ResultTcNameId
  (match (tc_core.tc-enum-decl-id ctx enum-id)
    [(tc_core.ResultTcEnumDecl.Ok decl)
      (match decl
        [(tc_core.TcEnumDecl cleanup _)
          (match cleanup
            [(ast.AstEnumCleanup.Fn cleanup-name)
              (tc_core.ResultTcNameId.Ok
                (lower-struct-cleanup-qualified-id ctx enum-id cleanup-name))]
            [(ast.AstEnumCleanup.No)
              (tc_core.ResultTcNameId.Err
                (string.append
                  "lower: owned cleanup payload type has no cleanup function "
                  (tc_core.tc-nominal-name-id-display enum-id)))])])]
    [(tc_core.ResultTcEnumDecl.Err message)
      (tc_core.ResultTcNameId.Err message)]))

(define (lower-struct-cleanup-id-for-type
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : tc_core.ResultTcNameId
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    (match resolved
      [(ast.AstType.Struct name) (lower-struct-cleanup-id-for-struct ctx name)]
      [(ast.AstType.StructArgs name _)
        (lower-struct-cleanup-id-for-struct ctx name)]
      [(ast.AstType.Enum name) (lower-enum-cleanup-id-for-enum ctx name)]
      [(ast.AstType.EnumArgs name _) (lower-enum-cleanup-id-for-enum ctx name)]
      [_
        (tc_core.ResultTcNameId.Err
          (string.append
            "lower: owned cleanup field type is not a cleanup-owning aggregate "
            (tc_core.tc-type-render resolved)))])))

(define (lower-struct-cleanup-call-expr
  [cleanup-name-id : i64]
  [value-name-id : i64]
  [field-name-id : i64]) : i64
  (ast.ast-expr-call
    (ast.ast-node-push (ast.AstExpr.Var cleanup-name-id))
    (ast.ast-expr-cons
      (ast.ast-expr-struct-get-id
        (ast.ast-node-push (ast.AstExpr.Var value-name-id))
        field-name-id)
      (ast.ast-expr-list-new))))

(define (lower-struct-cleanup-field-exprs
  [ctx : tc_core.TcContext]
  [value-name-id : i64]
  [field : ast.AstFieldDef]
  [acc : ast.AstExprList]) : parser.ResultAstExprList
  (match field
    [(ast.AstFieldDef.Def field-name ty cleanup)
      (match cleanup
        [(ast.AstFieldCleanup.No) (parser.ResultAstExprList.Ok acc)]
        [(ast.AstFieldCleanup.Fn cleanup-name)
          (parser.ResultAstExprList.Ok
            (ast.ast-expr-cons
              (lower-struct-cleanup-call-expr
                cleanup-name
                value-name-id
                field-name)
              acc))]
        [(ast.AstFieldCleanup.Owned)
          (match (lower-struct-cleanup-id-for-type ctx ty)
            [(tc_core.ResultTcNameId.Ok cleanup-name-id)
              (parser.ResultAstExprList.Ok
                (ast.ast-expr-cons
                  (lower-struct-cleanup-call-expr
                    cleanup-name-id
                    value-name-id
                    field-name)
                  acc))]
            [(tc_core.ResultTcNameId.Err message)
              (parser.ResultAstExprList.Err message)])])]))

(define (lower-struct-cleanup-body-fields
  [ctx : tc_core.TcContext]
  [value-name-id : i64]
  [fields : ast.AstFieldDefList]
  [acc : ast.AstExprList]) : parser.ResultAstExprList
  (lower-struct-cleanup-body-fields-at ctx value-name-id (& fields) acc 0))

(define (lower-struct-cleanup-body-fields-at
  [ctx : tc_core.TcContext]
  [value-name-id : i64]
  [fields : (& fields ast.AstFieldDefList)]
  [acc : ast.AstExprList]
  [index : i64]) : parser.ResultAstExprList
  (if (>= index (struct-get fields len))
    (parser.ResultAstExprList.Ok acc)
    (match (lower-struct-cleanup-field-exprs
      ctx
      value-name-id
      (ast.ast-field-def-list-get fields index (ast.ast-field-def-fallback))
      acc)
      [(parser.ResultAstExprList.Ok next)
        (lower-struct-cleanup-body-fields-at
          ctx
          value-name-id
          fields
          next
          (+ index 1))]
      [(parser.ResultAstExprList.Err message)
        (parser.ResultAstExprList.Err message)])))

(define (lower-struct-cleanup-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [struct-ty : ast.AstType]
  [fields : ast.AstFieldDefList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [value-name-id : i64 (lower-struct-cleanup-param-id)]
    (match (lower-struct-cleanup-body-fields
      ctx
      value-name-id
      fields
      (ast.ast-expr-list-new))
      [(parser.ResultAstExprList.Ok exprs)
        (let
          [params : ast.AstParamList
            (ast.ast-param-cons
              (ast.ast-param-id value-name-id struct-ty false)
              (ast.ast-param-list-new))]
          [body : ast.AstExpr
            (if (= (struct-get (& exprs) len) 0)
              (ast.AstExpr.Literal ast.AstLiteral.Unit)
              (ast.AstExpr.Begin exprs))]
          (lower-function-escaping
            ctx
            top-env
            type-cache
            logical-name
            params
            (ast.AstType.Unit)
            body
            spans
            names
            mode))]
      [(parser.ResultAstExprList.Err message)
        (ResultLowerFunction.Err (box (lower-diagnostic message)))])))

(define (lower-struct-cleanup-decl
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [cleanup : ast.AstStructCleanup]
  [struct-ty : ast.AstType]
  [fields : ast.AstFieldDefList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match cleanup
    [(ast.AstStructCleanup.No)
      (ResultLowerFunction.Ok ir.CompilerIrFunctionList.Nil spans)]
    [(ast.AstStructCleanup.Fn _)
      (lower-struct-cleanup-function
        ctx
        top-env
        type-cache
        logical-name
        struct-ty
        fields
        spans
        names
        mode)]))

(define (lower-enum-cleanup-payload-id [index : i64]) : i64
  (ci.intern-generated-canonical-name
    (string.append "__tl_cleanup_payload_" (string.int->string index))))

(define (lower-enum-cleanup-call-expr
  [cleanup-name-id : i64]
  [value-name-id : i64]) : i64
  (ast.ast-expr-call
    (ast.ast-node-push (ast.AstExpr.Var cleanup-name-id))
    (ast.ast-expr-cons
      (ast.ast-node-push (ast.AstExpr.Var value-name-id))
      (ast.ast-expr-list-new))))

(define (lower-enum-cleanup-payload-patterns [count : i64]) : ast.AstPatternList
  (lower-enum-cleanup-payload-patterns-at
    count
    0
    (ast.ast-pattern-list-with-capacity count)))

(define (lower-enum-cleanup-payload-patterns-at
  [count : i64]
  [index : i64]
  [out : ast.AstPatternList (:consume)]) : ast.AstPatternList
  (if (>= index count)
    out
    (let
      [next : ast.AstPatternList out]
      (begin
        (ast.ast-pattern-list-push
          (&mut next)
          (ast.ast-pat-binding-id (lower-enum-cleanup-payload-id index)))
        (lower-enum-cleanup-payload-patterns-at count (+ index 1) next)))))

(define (lower-enum-cleanup-payload-exprs
  [ctx : tc_core.TcContext]
  [payloads : ast.AstTypeList]
  [cleanups : ast.AstVariantPayloadCleanupList]) : parser.ResultAstExprList
  (lower-enum-cleanup-payload-exprs-at
    ctx
    (& payloads)
    (& cleanups)
    0
    (ast.ast-expr-list-new)))

(define (lower-enum-cleanup-payload-exprs-at
  [ctx : tc_core.TcContext]
  [payloads : (& payloads ast.AstTypeList)]
  [cleanups : (& cleanups ast.AstVariantPayloadCleanupList)]
  [index : i64]
  [acc : ast.AstExprList]) : parser.ResultAstExprList
  (if (>= index (ast.ast-type-list-len payloads))
    (parser.ResultAstExprList.Ok acc)
    (let
      [cleanup : ast.AstVariantPayloadCleanup
        (ast.ast-variant-payload-cleanup-list-get
          cleanups
          index
          (ast.ast-variant-payload-cleanup-fallback))]
      [value-name-id : i64 (lower-enum-cleanup-payload-id index)]
      (match cleanup
        [(ast.AstVariantPayloadCleanup.No)
          (lower-enum-cleanup-payload-exprs-at
            ctx
            payloads
            cleanups
            (+ index 1)
            acc)]
        [(ast.AstVariantPayloadCleanup.Fn cleanup-name)
          (lower-enum-cleanup-payload-exprs-at
            ctx
            payloads
            cleanups
            (+ index 1)
            (ast.ast-expr-cons
              (lower-enum-cleanup-call-expr cleanup-name value-name-id)
              acc))]
        [(ast.AstVariantPayloadCleanup.Owned)
          (match (lower-struct-cleanup-id-for-type
            ctx
            (tc_core.tc-context-type-get
              ctx
              (ast.ast-type-list-get payloads index (ast.ast-type-id-fallback))))
            [(tc_core.ResultTcNameId.Ok cleanup-name-id)
              (lower-enum-cleanup-payload-exprs-at
                ctx
                payloads
                cleanups
                (+ index 1)
                (ast.ast-expr-cons
                  (lower-enum-cleanup-call-expr cleanup-name-id value-name-id)
                  acc))]
            [(tc_core.ResultTcNameId.Err message)
              (parser.ResultAstExprList.Err message)])]))))

(define (lower-enum-cleanup-arm
  [ctx : tc_core.TcContext]
  [variant : ast.AstVariantDef]) : parser.ResultAstMatchArm
  (match variant
    [(ast.AstVariantDef.Def name payloads cleanups)
      (match (lower-enum-cleanup-payload-exprs ctx payloads cleanups)
        [(parser.ResultAstExprList.Ok exprs)
          (parser.ResultAstMatchArm.Ok
            (ast.ast-match-arm
              (ast.ast-pat-variant-id
                name
                (lower-enum-cleanup-payload-patterns
                  (ast.ast-type-list-len (& payloads))))
              (ast.ast-node-push
                (if (= (ast.ast-expr-list-len exprs) 0)
                  (ast.AstExpr.Literal ast.AstLiteral.Unit)
                  (ast.AstExpr.Begin exprs)))))]
        [(parser.ResultAstExprList.Err message)
          (parser.ResultAstMatchArm.Err message)])]))

(define (lower-enum-cleanup-arms
  [ctx : tc_core.TcContext]
  [variants : ast.AstVariantDefList]) : parser.ResultAstMatchArmList
  (lower-enum-cleanup-arms-at
    ctx
    (& variants)
    0
    (ast.ast-match-arm-list-with-capacity
      (ast.ast-variant-def-list-len (& variants)))))

(define (lower-enum-cleanup-arms-at
  [ctx : tc_core.TcContext]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]
  [out : ast.AstMatchArmList (:consume)]) : parser.ResultAstMatchArmList
  (if (>= index (ast.ast-variant-def-list-len variants))
    (parser.ResultAstMatchArmList.Ok out)
    (match (lower-enum-cleanup-arm
      ctx
      (ast.ast-variant-def-list-get
        variants
        index
        (ast.ast-variant-def-fallback)))
      [(parser.ResultAstMatchArm.Ok arm)
        (let
          [next : ast.AstMatchArmList out]
          (begin
            (ast.ast-match-arm-list-push (&mut next) arm)
            (lower-enum-cleanup-arms-at ctx variants (+ index 1) next)))]
      [(parser.ResultAstMatchArm.Err message)
        (parser.ResultAstMatchArmList.Err message)])))

(define (lower-enum-cleanup-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [enum-ty : ast.AstType]
  [variants : ast.AstVariantDefList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [value-name-id : i64 (lower-struct-cleanup-param-id)]
    (match (lower-enum-cleanup-arms ctx variants)
      [(parser.ResultAstMatchArmList.Ok arms)
        (lower-function-escaping
          ctx
          top-env
          type-cache
          logical-name
          (ast.ast-param-cons
            (ast.ast-param-id value-name-id enum-ty false)
            (ast.ast-param-list-new))
          (ast.AstType.Unit)
          (ast.ast-node-get
            (ast.ast-expr-match
              (ast.ast-node-push (ast.AstExpr.Var value-name-id))
              arms))
          spans
          names
          mode)]
      [(parser.ResultAstMatchArmList.Err message)
        (ResultLowerFunction.Err (box (lower-diagnostic message)))])))

(define (lower-enum-cleanup-decl
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [cleanup : ast.AstEnumCleanup]
  [enum-ty : ast.AstType]
  [variants : ast.AstVariantDefList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match cleanup
    [(ast.AstEnumCleanup.No)
      (ResultLowerFunction.Ok ir.CompilerIrFunctionList.Nil spans)]
    [(ast.AstEnumCleanup.Fn _)
      (lower-enum-cleanup-function
        ctx
        top-env
        type-cache
        logical-name
        enum-ty
        variants
        spans
        names
        mode)]))

(define (lower-dispatch-cache-name [logical-name : String]) : String
  (string.append "__tl_dispatch_cache_" logical-name))

(define (lower-dispatch-variant-prefix [isa : ast.AstDispatchIsa]) : String
  (match isa
    [(ast.AstDispatchIsa.Scalar) "__tl_dispatch_variant_scalar_"]
    [(ast.AstDispatchIsa.Avx2) "__tl_dispatch_variant_avx2_"]
    [(ast.AstDispatchIsa.Avx512) "__tl_dispatch_variant_avx512_"]))

(define (lower-dispatch-variant-internal-name
  [dispatch-name : String]
  [isa : ast.AstDispatchIsa]
  [variant-name : String]) : String
  (string.append
    (lower-dispatch-variant-prefix isa)
    (string.append dispatch-name (string.append "__" variant-name))))

(define (lower-dispatch-lower-mode
  [isa : ast.AstDispatchIsa]
  [mode : CompilerLowerMode]) : CompilerLowerMode
  (match isa
    [(ast.AstDispatchIsa.Scalar)
      (if (lower-mode-windows-c-abi? mode)
        (CompilerLowerMode.WindowsScalar)
        (if (lower-mode-linux-c-abi? mode)
          (CompilerLowerMode.LinuxScalar)
          (CompilerLowerMode.Scalar)))]
    [(ast.AstDispatchIsa.Avx2)
      (if (lower-mode-windows-c-abi? mode)
        (CompilerLowerMode.WindowsAvx2)
        (if (lower-mode-linux-c-abi? mode)
          (CompilerLowerMode.LinuxAvx2)
          (CompilerLowerMode.Avx2)))]
    [(ast.AstDispatchIsa.Avx512)
      (if (lower-mode-windows-c-abi? mode)
        (CompilerLowerMode.WindowsAvx512)
        (if (lower-mode-linux-c-abi? mode)
          (CompilerLowerMode.LinuxAvx512)
          (CompilerLowerMode.Avx512)))]))

(define (lower-dispatch-type-list-without-regions
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (lower-dispatch-type-list-without-regions-at ctx (& types) 0))

(define (lower-dispatch-type-list-without-regions-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (tc_core.tc-type-without-regions
        (ast.ast-type-strip-consuming-param-with-pools
          (tc_core.tc-context-pools ctx)
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))))
      (lower-dispatch-type-list-without-regions-at ctx types (+ index 1)))))

(define (lower-dispatch-param-type-count [types : ast.AstTypeList]) : i64
  (ast.ast-type-list-len (& types)))

(define (lower-dispatch-param-list-from-types
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]
  [idx : i64]) : ir.CompilerIrParamList
  (lower-dispatch-param-list-from-types-at ctx (& types) idx))

(define (lower-dispatch-param-list-from-types-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [idx : i64]) : ir.CompilerIrParamList
  (if (>= idx (ast.ast-type-list-len types))
    ir.CompilerIrParamList.Nil
    (ir.compiler-ir-param-cons
      (ir.CompilerIrParam.Param
        (string.append "arg" (string.int->string idx))
        (tc_core.tc-type-without-regions
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types idx (ast.ast-type-id-fallback))))
        idx)
      (lower-dispatch-param-list-from-types-at ctx types (+ idx 1)))))

(define (lower-dispatch-param-values [types : ast.AstTypeList] [idx : i64]) : ir.CompilerIrValueList
  (if (>= idx (ast.ast-type-list-len (& types)))
    ir.CompilerIrValueList.Nil
    (ir.compiler-ir-value-cons
      (ir.CompilerIrValue.Var idx)
      (lower-dispatch-param-values types (+ idx 1)))))

(define (lower-dispatch-physical-param-list
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [types : ast.AstTypeList]
  [source-start : i64]
  [leading-sret? : bool]) : ir.CompilerIrParamList
  (if leading-sret?
    (ir.compiler-ir-param-cons
      (ir.CompilerIrParam.Param "__sret" (ast.AstType.U64) 0)
      (lower-dispatch-physical-param-list-at ctx mode (& types) 0 source-start))
    (lower-dispatch-physical-param-list-at ctx mode (& types) 0 source-start)))

(define (lower-dispatch-physical-param-list-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [idx : i64]) : ir.CompilerIrParamList
  (if (>= index (ast.ast-type-list-len types))
    ir.CompilerIrParamList.Nil
    (let
      [source-ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (ir.compiler-ir-param-cons
        (ir.CompilerIrParam.Param
          (string.append "arg" (string.int->string index))
          (lower-internal-param-physical-type ctx mode source-ty)
          idx)
        (lower-dispatch-physical-param-list-at
          ctx
          mode
          types
          (+ index 1)
          (+ idx 1))))))

(define (lower-dispatch-physical-param-values [count : i64] [idx : i64]) : ir.CompilerIrValueList
  (if (>= idx count)
    ir.CompilerIrValueList.Nil
    (ir.compiler-ir-value-cons
      (ir.CompilerIrValue.Var idx)
      (lower-dispatch-physical-param-values count (+ idx 1)))))

(define (lower-dispatch-find-internal-name-from
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [module-id : i64]
  [names : LowerNameCache]
  [dispatch-name : String]
  [wanted : ast.AstDispatchIsa]) : LowerMaybeIrSymbol
  (if (>= index (struct-get variants len))
    (LowerMaybeIrSymbol.No)
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(ast.AstDispatchVariant.Variant isa variant-name)
        (if (tc_core.tc-dispatch-isa-eq? isa wanted)
          (LowerMaybeIrSymbol.Some
            (lower-derived-symbol-id
              (lower-dispatch-variant-internal-name
                dispatch-name
                isa
                (lower-dispatch-variant-logical-name
                  module-id
                  names
                  variant-name))))
          (lower-dispatch-find-internal-name-from
            variants
            (+ index 1)
            module-id
            names
            dispatch-name
            wanted))])))

(define (lower-dispatch-find-internal-name
  [variants : ast.AstDispatchVariantList]
  [module-id : i64]
  [names : LowerNameCache]
  [dispatch-name : String]
  [wanted : ast.AstDispatchIsa]) : LowerMaybeIrSymbol
  (lower-dispatch-find-internal-name-from
    (& variants)
    0
    module-id
    names
    dispatch-name
    wanted))

(define (lower-dispatch-call-return-instr
  [call-var : i64]
  [ret-ty : ast.AstType]) : ir.CompilerIrInstr
  (ir.CompilerIrInstr.Return
    (lower-return-maybe (ir.CompilerIrValue.Var call-var) ret-ty)))

(define (lower-dispatch-cached-block
  [cache-name : i64]
  [args : ir.CompilerIrCallArgs]
  [ret-ty : ast.AstType]
  [call-var : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    (ir.compiler-ir-label "cached")
    (ir.compiler-ir-instr-cons
      (ir.CompilerIrInstr.CallIndirect
        call-var
        (ir.CompilerIrValue.Global cache-name)
        args
        ret-ty)
      (ir.compiler-ir-instr-cons
        (lower-dispatch-call-return-instr call-var ret-ty)
        ir.CompilerIrInstrList.Nil))))

(define (lower-dispatch-select-block
  [label : i64]
  [cache-name : i64]
  [fn-name : i64]
  [fn-ty : ast.AstType]
  [args : ir.CompilerIrCallArgs]
  [ret-ty : ast.AstType]
  [call-var : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    label
    (ir.compiler-ir-instr-cons
      (ir.CompilerIrInstr.Store
        cache-name
        (ir.CompilerIrValue.Function fn-name)
        fn-ty)
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.CallIndirect
          call-var
          (ir.CompilerIrValue.Function fn-name)
          args
          ret-ty)
        (ir.compiler-ir-instr-cons
          (lower-dispatch-call-return-instr call-var ret-ty)
          ir.CompilerIrInstrList.Nil)))))

(define (lower-dispatch-entry-block
  [cache-name : i64]
  [_fn-ty : ast.AstType]
  [cached-var : i64]
  [resolve-label : i64]) : ir.CompilerIrBlock
  (ir.compiler-ir-block
    (ir.compiler-ir-label "entry")
    (ir.compiler-ir-instr-cons
      (ir.CompilerIrInstr.BinOp
        cached-var
        ir.CompilerIrBinOp.Ne
        (ir.CompilerIrValue.Global cache-name)
        (ir.CompilerIrValue.I64 0)
        (ast.AstType.I64))
      (ir.compiler-ir-instr-cons
        (ir.CompilerIrInstr.Branch
          (ir.CompilerIrValue.Var cached-var)
          (ir.compiler-ir-label "cached")
          resolve-label)
        ir.CompilerIrInstrList.Nil))))

(define lower-dispatch-avx512-required-feature-mask : i64
  ;; CPUID.7.0:EBX AVX512F bit 16, AVX512DQ bit 17, AVX512BW bit 30.
  1073938432)

(define (lower-dispatch-feature-blocks
  [prefix : String]
  [xcr0-mask : i64]
  [feature-mask : i64]
  [select-label : i64]
  [fallback-label : i64]
  [base : i64]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [check-label : i64 (ir.compiler-ir-label (clone prefix))]
    [osxsave-label : i64
      (ir.compiler-ir-label (string.append (clone prefix) "_osxsave"))]
    [xcr0-label : i64
      (ir.compiler-ir-label (string.append (clone prefix) "_xcr0"))]
    [leaf7-label : i64 (ir.compiler-ir-label (string.append prefix "_leaf7"))]
    [max-leaf-var : i64 base]
    [max-ok-var : i64 (+ base 1)]
    [leaf1-ecx-var : i64 (+ base 2)]
    [osxsave-mask-var : i64 (+ base 3)]
    [osxsave-ok-var : i64 (+ base 4)]
    [xcr0-var : i64 (+ base 5)]
    [xcr0-mask-var : i64 (+ base 6)]
    [xcr0-ok-var : i64 (+ base 7)]
    [leaf7-ebx-var : i64 (+ base 8)]
    [feature-mask-var : i64 (+ base 9)]
    [feature-ok-var : i64 (+ base 10)]
    [blocks : ir.CompilerIrBlockBuilder
      (ir.compiler-ir-block-builder-with-capacity
        (+ 4 (ir.compiler-ir-block-list-count tail)))]
    (begin
      (ir.compiler-ir-block-builder-push!
        (&mut blocks)
        (ir.compiler-ir-block
          check-label
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.CpuId
              max-leaf-var
              (ir.CompilerIrValue.I64 0)
              (ir.CompilerIrValue.I64 0)
              0)
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                max-ok-var
                ir.CompilerIrBinOp.Ge
                (ir.CompilerIrValue.Var max-leaf-var)
                (ir.CompilerIrValue.I64 7)
                (ast.AstType.I64))
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.Branch
                  (ir.CompilerIrValue.Var max-ok-var)
                  osxsave-label
                  fallback-label)
                ir.CompilerIrInstrList.Nil)))))
      (ir.compiler-ir-block-builder-push!
        (&mut blocks)
        (ir.compiler-ir-block
          osxsave-label
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.CpuId
              leaf1-ecx-var
              (ir.CompilerIrValue.I64 1)
              (ir.CompilerIrValue.I64 0)
              2)
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                osxsave-mask-var
                ir.CompilerIrBinOp.BitAnd
                (ir.CompilerIrValue.Var leaf1-ecx-var)
                (ir.CompilerIrValue.I64 134217728)
                (ast.AstType.I64))
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.BinOp
                  osxsave-ok-var
                  ir.CompilerIrBinOp.Ne
                  (ir.CompilerIrValue.Var osxsave-mask-var)
                  (ir.CompilerIrValue.I64 0)
                  (ast.AstType.I64))
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.Branch
                    (ir.CompilerIrValue.Var osxsave-ok-var)
                    xcr0-label
                    fallback-label)
                  ir.CompilerIrInstrList.Nil))))))
      (ir.compiler-ir-block-builder-push!
        (&mut blocks)
        (ir.compiler-ir-block
          xcr0-label
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.Xgetbv xcr0-var (ir.CompilerIrValue.I64 0))
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                xcr0-mask-var
                ir.CompilerIrBinOp.BitAnd
                (ir.CompilerIrValue.Var xcr0-var)
                (ir.CompilerIrValue.I64 xcr0-mask)
                (ast.AstType.I64))
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.BinOp
                  xcr0-ok-var
                  ir.CompilerIrBinOp.Eq
                  (ir.CompilerIrValue.Var xcr0-mask-var)
                  (ir.CompilerIrValue.I64 xcr0-mask)
                  (ast.AstType.I64))
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.Branch
                    (ir.CompilerIrValue.Var xcr0-ok-var)
                    leaf7-label
                    fallback-label)
                  ir.CompilerIrInstrList.Nil))))))
      (ir.compiler-ir-block-builder-push!
        (&mut blocks)
        (ir.compiler-ir-block
          leaf7-label
          (ir.compiler-ir-instr-cons
            (ir.CompilerIrInstr.CpuId
              leaf7-ebx-var
              (ir.CompilerIrValue.I64 7)
              (ir.CompilerIrValue.I64 0)
              1)
            (ir.compiler-ir-instr-cons
              (ir.CompilerIrInstr.BinOp
                feature-mask-var
                ir.CompilerIrBinOp.BitAnd
                (ir.CompilerIrValue.Var leaf7-ebx-var)
                (ir.CompilerIrValue.I64 feature-mask)
                (ast.AstType.I64))
              (ir.compiler-ir-instr-cons
                (ir.CompilerIrInstr.BinOp
                  feature-ok-var
                  ir.CompilerIrBinOp.Eq
                  (ir.CompilerIrValue.Var feature-mask-var)
                  (ir.CompilerIrValue.I64 feature-mask)
                  (ast.AstType.I64))
                (ir.compiler-ir-instr-cons
                  (ir.CompilerIrInstr.Branch
                    (ir.CompilerIrValue.Var feature-ok-var)
                    select-label
                    fallback-label)
                  ir.CompilerIrInstrList.Nil))))))
      (ir.compiler-ir-block-builder-append-list! (&mut blocks) tail)
      (ir.compiler-ir-block-builder-to-list blocks))))

(define (lower-dispatch-select-blocks
  [cache-name : i64]
  [fn-ty : ast.AstType]
  [args : ir.CompilerIrCallArgs]
  [ret-ty : ast.AstType]
  [scalar-name : i64]
  [maybe-avx2 : LowerMaybeIrSymbol]
  [maybe-avx512 : LowerMaybeIrSymbol]
  [base : i64]) : ir.CompilerIrBlockList
  (let
    [blocks : ir.CompilerIrBlockBuilder
      (ir.compiler-ir-block-builder-with-capacity 3)]
    (begin
      (match maybe-avx512
        [(LowerMaybeIrSymbol.Some avx512-name)
          (ir.compiler-ir-block-builder-push!
            (&mut blocks)
            (lower-dispatch-select-block
              (ir.compiler-ir-label "select_avx512")
              cache-name
              avx512-name
              fn-ty
              args
              ret-ty
              (+ base 26)))]
        [(LowerMaybeIrSymbol.No) unit])
      (match maybe-avx2
        [(LowerMaybeIrSymbol.Some avx2-name)
          (ir.compiler-ir-block-builder-push!
            (&mut blocks)
            (lower-dispatch-select-block
              (ir.compiler-ir-label "select_avx2")
              cache-name
              avx2-name
              fn-ty
              args
              ret-ty
              (+ base 25)))]
        [(LowerMaybeIrSymbol.No) unit])
      (ir.compiler-ir-block-builder-push!
        (&mut blocks)
        (lower-dispatch-select-block
          (ir.compiler-ir-label "select_scalar")
          cache-name
          scalar-name
          fn-ty
          args
          ret-ty
          (+ base 24)))
      (ir.compiler-ir-block-builder-to-list blocks))))

(define (lower-dispatch-resolve-label
  [maybe-avx2 : LowerMaybeIrSymbol]
  [maybe-avx512 : LowerMaybeIrSymbol]) : i64
  (match maybe-avx512
    [(LowerMaybeIrSymbol.Some _) (ir.compiler-ir-label "check_avx512")]
    [(LowerMaybeIrSymbol.No)
      (match maybe-avx2
        [(LowerMaybeIrSymbol.Some _) (ir.compiler-ir-label "check_avx2")]
        [(LowerMaybeIrSymbol.No) (ir.compiler-ir-label "select_scalar")])]))

(define (lower-dispatch-resolve-blocks
  [maybe-avx2 : LowerMaybeIrSymbol]
  [maybe-avx512 : LowerMaybeIrSymbol]
  [base : i64]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [with-avx2 : ir.CompilerIrBlockList
      (match maybe-avx2
        [(LowerMaybeIrSymbol.Some _)
          (lower-dispatch-feature-blocks
            "check_avx2"
            6
            32
            (ir.compiler-ir-label "select_avx2")
            (ir.compiler-ir-label "select_scalar")
            (+ base 12)
            tail)]
        [(LowerMaybeIrSymbol.No) tail])]
    (match maybe-avx512
      [(LowerMaybeIrSymbol.Some _)
        (lower-dispatch-feature-blocks
          "check_avx512"
          230
          lower-dispatch-avx512-required-feature-mask
          (ir.compiler-ir-label "select_avx512")
          (match maybe-avx2
            [(LowerMaybeIrSymbol.Some _) (ir.compiler-ir-label "check_avx2")]
            [(LowerMaybeIrSymbol.No) (ir.compiler-ir-label "select_scalar")])
          (+ base 1)
          with-avx2)]
      [(LowerMaybeIrSymbol.No) with-avx2])))

(define (lower-dispatch-thunk-function
  [ctx : tc_core.TcContext]
  [logical-name : i64]
  [cache-name : i64]
  [fn-ty : ast.AstType]
  [variants : ast.AstDispatchVariantList]
  [module-id : i64]
  [names : LowerNameCache]
  [spans : ir.CompilerSourceSpans]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match fn-ty
    [(ast.AstType.Func param-types ret-box)
      (let
        [logical-name-text : String (ir.compiler-ir-symbol-text logical-name)]
        [ret-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-context-type-get ctx ret-box))]
        [clean-param-types : ast.AstTypeList
          (lower-dispatch-type-list-without-regions ctx (box-get param-types))]
        [ret-class : LowerCAbiAggregate
          (lower-internal-return-class ctx mode ret-ty)]
        [leading-sret? : bool
          (match ret-class
            [(LowerCAbiAggregate.Sret _) true]
            [_ false])]
        [source-start : i64
          (if leading-sret?
            1
            0)]
        [source-count : i64 (lower-dispatch-param-type-count clean-param-types)]
        [param-count : i64 (+ source-start source-count)]
        [physical-ret-ty : ast.AstType
          (lower-internal-return-physical-type ctx mode ret-ty)]
        [args : ir.CompilerIrCallArgs
          (ir.compiler-ir-call-args-from-list
            (lower-dispatch-physical-param-values param-count 0))]
        [maybe-avx2 : LowerMaybeIrSymbol
          (lower-dispatch-find-internal-name
            variants
            module-id
            names
            logical-name-text
            (ast.AstDispatchIsa.Avx2))]
        [maybe-avx512 : LowerMaybeIrSymbol
          (lower-dispatch-find-internal-name
            variants
            module-id
            names
            logical-name-text
            (ast.AstDispatchIsa.Avx512))]
        (match (lower-dispatch-find-internal-name
          variants
          module-id
          names
          logical-name-text
          (ast.AstDispatchIsa.Scalar))
          [(LowerMaybeIrSymbol.Some scalar-name)
            (let
              [tail-blocks : ir.CompilerIrBlockList
                (lower-dispatch-resolve-blocks
                  maybe-avx2
                  maybe-avx512
                  param-count
                  (lower-dispatch-select-blocks
                    cache-name
                    fn-ty
                    args
                    physical-ret-ty
                    scalar-name
                    maybe-avx2
                    maybe-avx512
                    param-count))]
              [blocks : ir.CompilerIrBlockBuilder
                (ir.compiler-ir-block-builder-with-capacity
                  (+ 2 (ir.compiler-ir-block-list-count tail-blocks)))]
              (begin
                (ir.compiler-ir-block-builder-push!
                  (&mut blocks)
                  (lower-dispatch-entry-block
                    cache-name
                    fn-ty
                    param-count
                    (lower-dispatch-resolve-label maybe-avx2 maybe-avx512)))
                (ir.compiler-ir-block-builder-push!
                  (&mut blocks)
                  (lower-dispatch-cached-block
                    cache-name
                    args
                    physical-ret-ty
                    (+ param-count 23)))
                (ir.compiler-ir-block-builder-append-list!
                  (&mut blocks)
                  tail-blocks)
                (ResultLowerFunction.Ok
                  (ir.compiler-ir-function-list-single
                    (ir.CompilerIrFunction.Function
                      logical-name
                      (lower-dispatch-physical-param-list
                        ctx
                        mode
                        clean-param-types
                        source-start
                        leading-sret?)
                      physical-ret-ty
                      (+ param-count 27)
                      (ir.compiler-ir-block-builder-to-list blocks)))
                  spans)))]
          [(LowerMaybeIrSymbol.No)
            (ResultLowerFunction.Err
              (box
                (lower-diagnostic
                  "lower: defdispatch requires a scalar variant")))]))]
    [_
      (ResultLowerFunction.Err
        (box
          (lower-diagnostic
            "lower: defdispatch did not typecheck as a function")))]))

(define (lower-dispatch-lower-variant-decl
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [internal-name : i64]
  [isa : ast.AstDispatchIsa]
  [decl : ast.AstDecl]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match decl
    [(ast.AstDecl.DefFn decl-meta _ params ret body-box _)
      (let
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (lower-function-escaping
          ctx
          top-env
          type-cache
          internal-name
          params
          ret
          body
          spans
          names
          (lower-dispatch-lower-mode isa mode)))]
    [(ast.AstDecl.Unsafe inner-box)
      (let
        [inner : ast.AstDecl (box-get inner-box)]
        (lower-dispatch-lower-variant-decl
          ctx
          top-env
          type-cache
          internal-name
          isa
          inner
          spans
          names
          mode))]
    [_
      (ResultLowerFunction.Err
        (box
          (lower-diagnostic
            "lower: defdispatch variants must be local functions")))]))

(define (lower-dispatch-lower-variant
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-name : String]
  [variant : ast.AstDispatchVariant]
  [module-id : i64]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match variant
    [(ast.AstDispatchVariant.Variant isa variant-name)
      (let
        [variant-logical : String
          (lower-dispatch-variant-logical-name module-id names variant-name)]
        [internal-name : i64
          (lower-derived-symbol-id
            (lower-dispatch-variant-internal-name
              dispatch-name
              isa
              variant-logical))]
        [handle : i64
          (if (tc_core.tc-name-qualified-id? variant-name)
            (csym.compiler-symbols-lookup-value-id-or
              (tc_core.tc-context-symbols ctx)
              variant-name
              (csym.compiler-symbols-missing-handle))
            (csym.compiler-symbols-lookup-value-in-module-id-or
              (tc_core.tc-context-symbols ctx)
              module-id
              variant-name
              (csym.compiler-symbols-missing-handle)))]
        (if (csym.compiler-symbols-handle-found? handle)
          (match (csym.compiler-program-decl-at-index
            (tc_core.tc-context-program ctx)
            (csym.compiler-symbol-handle-index handle))
            [(parser.ResultAstDecl.Ok decl)
              (lower-dispatch-lower-variant-decl
                ctx
                top-env
                type-cache
                internal-name
                isa
                decl
                spans
                names
                mode)]
            [(parser.ResultAstDecl.Err message)
              (ResultLowerFunction.Err (box (lower-diagnostic message)))])
          (ResultLowerFunction.Err
            (box
              (lower-diagnostic
                (string.append
                  "lower: unknown defdispatch variant "
                  (tc_core.tc-env-key-name-text variant-name)))))))]))

(define (lower-dispatch-lower-variants-from
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-name : String]
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [module-id : i64]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]
  [functions : ir.CompilerIrFunctionBuilder (:consume)]) : ResultLowerFunction
  (if (>= index (struct-get variants len))
    (ResultLowerFunction.Ok
      (ir.compiler-ir-function-builder-to-list functions)
      spans)
    (match (lower-dispatch-lower-variant
      ctx
      top-env
      type-cache
      dispatch-name
      (ast.ast-dispatch-variant-list-get
        variants
        index
        (ast.ast-dispatch-variant-fallback))
      module-id
      spans
      names
      mode)
      [(ResultLowerFunction.Ok lowered-functions function-spans)
        (let
          [next-functions : ir.CompilerIrFunctionBuilder functions]
          (begin
            (ir.compiler-ir-function-builder-append-list!
              (&mut next-functions)
              lowered-functions)
            (lower-dispatch-lower-variants-from
              ctx
              top-env
              type-cache
              dispatch-name
              variants
              (+ index 1)
              module-id
              function-spans
              names
              mode
              next-functions)))]
      [(ResultLowerFunction.Err message) (ResultLowerFunction.Err message)])))

(define (lower-dispatch-lower-variants
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-name : String]
  [variants : ast.AstDispatchVariantList]
  [module-id : i64]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (lower-dispatch-lower-variants-from
    ctx
    top-env
    type-cache
    dispatch-name
    (& variants)
    0
    module-id
    spans
    names
    mode
    (ir.compiler-ir-function-builder-new)))

(define (lower-dispatch-decl
  [ctx : tc_core.TcContext]
  [_top-env : tc_core.TcTypeEnv]
  [local-top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [name-id : i64]
  [variants : ast.AstDispatchVariantList]
  [spans : ir.CompilerSourceSpans]
  [name-cache : LowerNameCache]
  [mode : CompilerLowerMode]
  [module : String]
  [module-id : i64]
  [logical-module : String]
  [logical-module-id : i64]) : ResultLowerDispatchDecl
  (let
    [name : String (tc_core.tc-env-key-name-text name-id)]
    [decl-ctx : tc_core.TcContext
      (tc_core.tc-context-with-module-id ctx module module-id)]
    [logical-name : String
      (lower-current-decl-logical-name-cache-id
        name-cache
        logical-module
        name
        name-id)]
    [key-id : i64 (lower-module-name-key-id-by-id logical-module-id name-id)]
    [logical-id : i64
      (lower-name-cache-lookup-logical-id (& name-cache) key-id key-id)]
    [logical-symbol : i64
      (lower-name-cache-ir-symbol name-cache logical-id name-id logical-name)]
    [cache-text : String (lower-dispatch-cache-name logical-name)]
    [cache-id : i64 (ci.intern-generated-name cache-text)]
    [cache-symbol : i64 cache-id]
    (match (tc_core.tc-lookup-id local-top-env name-id)
      [(tc_core.ResultTcType.Ok dispatch-ty)
        (let
          [fn-ty : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type decl-ctx dispatch-ty))]
          (match (lower-dispatch-lower-variants
            decl-ctx
            local-top-env
            type-cache
            logical-name
            variants
            module-id
            spans
            name-cache
            mode)
            [(ResultLowerFunction.Ok variant-functions variant-spans)
              (match (lower-dispatch-thunk-function
                decl-ctx
                logical-symbol
                cache-symbol
                fn-ty
                variants
                module-id
                name-cache
                variant-spans
                mode)
                [(ResultLowerFunction.Ok thunk-functions thunk-spans)
                  (let
                    ;; The synthesized thunk is built directly in the enclosing
                    ;; source arena, so give it the same lifetime as variants
                    ;; lowered through lower-function-escaping.
                    [escaped-thunk-functions : ir.CompilerIrFunctionList
                      (lower-function-list-escape-to-ir-arena thunk-functions)]
                    [functions : ir.CompilerIrFunctionBuilder
                      (ir.compiler-ir-function-builder-with-capacity
                        (+
                          (ir.compiler-ir-function-list-count variant-functions)
                          (ir.compiler-ir-function-list-count
                            escaped-thunk-functions)))]
                    (begin
                      (ir.compiler-ir-function-builder-append-list!
                        (&mut functions)
                        variant-functions)
                      (ir.compiler-ir-function-builder-append-list!
                        (&mut functions)
                        escaped-thunk-functions)
                      (ResultLowerDispatchDecl.Ok
                        (box
                          (LowerDispatchDecl.Decl
                            (ir.CompilerIrGlobal.Global
                              cache-symbol
                              fn-ty
                              (ir.CompilerIrValue.I64 0))
                            (ir.compiler-ir-function-builder-to-list functions)
                            thunk-spans)))))]
                [(ResultLowerFunction.Err message)
                  (ResultLowerDispatchDecl.Err message)])]
            [(ResultLowerFunction.Err message)
              (ResultLowerDispatchDecl.Err message)]))]
      [(tc_core.ResultTcType.Err message)
        (ResultLowerDispatchDecl.Err (box (lower-diagnostic message)))])))

(define (lower-rvo-early-return-functions-from-decls-in-module
  [ctx : tc_core.TcContext]
  [decls : ast.AstDeclList]
  [names : LowerNameEnv]
  [_ : String]
  [module-id : i64]
  [out : lower_i64_i64_map.Map (:consume)]) : lower_i64_i64_map.Map
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [name-cache : LowerNameCache (lower-name-cache-from-env names)]
    [cur-out : lower_i64_i64_map.Map out]
    ;; Feed the wrapper peel the backing slot directly. Binding the row to a
    ;; local first materialised a 104 B copy that `ast-decl-unwrapped` then
    ;; copied again; an aggregate argument is passed by reference, so the
    ;; projection costs nothing.
    [decl-slots : (__tl_dyn-array ast.AstDecl) (struct-get decls slots)]
    [decl-offset : i64 (struct-get decls offset)]
    (begin
      (while (< index count)
        (begin
          (match (ast.ast-decl-unwrapped
            (array-ref decl-slots (+ decl-offset index)))
            [(ast.AstDecl.Module next-module) (set! cur-module-id next-module)]
            [(ast.AstDecl.DefFn decl-meta name _ _ body-box _)
              ;; #6056 threads the per-body typecheck state through the
              ;; early-exit fact lookup; keep that argument while the walk
              ;; itself reads the backing slot instead of a stepped-out row.
              (let
                [has-early-return : bool
                  (match (tc_core.tc-body-early-exit-fact
                    (tc_core.tc-context-body-state ctx)
                    body-box)
                    [(tc_core.TcBodyEarlyExitFact.Known value) value]
                    [(tc_core.TcBodyEarlyExitFact.Unknown)
                      (lower-rvo-node-has-early-return? ctx body-box)])]
                (if has-early-return
                  (let
                    [key-id : i64
                      (lower-module-name-key-id-by-id cur-module-id name)]
                    (lower_i64_i64_map.insert-ref!
                      (&mut cur-out)
                      (lower-name-cache-lookup-logical-id
                        (& name-cache)
                        key-id
                        key-id)
                      1))
                  unit))]
            [_ unit])
          (set! index (+ index 1))))
      cur-out)))

(define (lower-rvo-early-return-functions-from-decls
  [ctx : tc_core.TcContext]
  [decls : ast.AstDeclList]
  [names : LowerNameEnv]) : lower_i64_i64_map.Map
  (lower-rvo-early-return-functions-from-decls-in-module
    ctx
    decls
    names
    ""
    cbi.compiler-builtin-id-fix-empty
    (lower_i64_i64_map.with-capacity 8192)))

(define (lower-decls
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [globals : ir.CompilerIrGlobalList]
  [functions : ir.CompilerIrFunctionList]
  [externs : ir.CompilerIrExternList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameEnv]
  [clone-roots : clone_support.CloneRootEntries]
  [mode : CompilerLowerMode]) : ResultLowerDecls
  (begin
    (set! lower-active-symbols (tc_core.tc-context-symbols ctx))
    (set! lower-active-symbols-ready true)
    (let
      [dispatch-name-cache : LowerNameCache
        (lower-name-cache-with-clone-roots
          (lower-name-cache-from-env names)
          clone-roots)]
      [dispatch-variants : lower_i64_i64_map.Map
        (lower-dispatch-variant-set-from-decls
          decls
          paths
          entry-path
          dispatch-name-cache)]
      (begin
        ;; Build the shared global name/type caches once; per-module caches
        ;; are small overlays that fall through to them. The initial cur caches are
        ;; empty overlays (everything resolves via the global caches) for decls in
        ;; the leading "" module before the first (module ...) marker.
        (set! lower-active-global-name-cache dispatch-name-cache)
        (set! lower-active-module-local-views (LowerModuleLocalViewList.Nil))
        (set! lower-decls-global-type-cache (lower-type-cache-from-env top-env))
        (set!
          lower-rvo-early-return-functions
          (lower-rvo-early-return-functions-from-decls ctx decls names))
        (lower-decls-in-module
          ctx
          top-env
          top-env
          decls
          paths
          entry-path
          globals
          functions
          externs
          spans
          names
          (lower-name-cache-overlay
            (LowerNameEnv.Nil)
            cbi.compiler-builtin-id-fix-empty)
          (lower-type-cache-overlay (tc_core.tc-empty-env))
          dispatch-variants
          mode
          ""
          cbi.compiler-builtin-id-fix-empty)))))

(defenum LowerSkippedRuntimeWithPaths
  (Skipped ast.AstDeclList ast.AstDeclPathList))

(define (lower-skip-runtime-until-next-module-with-paths
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]) : LowerSkippedRuntimeWithPaths
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil)
      (LowerSkippedRuntimeWithPaths.Skipped
        (ast.ast-decl-list-new)
        (ast.ast-decl-path-list-new))]
    [(ast.AstDeclListStep.Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String (ast.ast-decl-path-list-get (& paths) 0 "")]
        [owner-id : i64
          (ast.ast-decl-path-list-owner-id
            (& paths)
            0
            cbi.compiler-builtin-id-fix-empty)]
        [rest-paths : ast.AstDeclPathList (ast.ast-decl-path-list-tail paths)]
        (match decl
          [(ast.AstDecl.Module _)
            (LowerSkippedRuntimeWithPaths.Skipped decls paths)]
          [_
            (match (lower-skip-runtime-until-next-module-with-paths
              rest
              rest-paths)
              [(LowerSkippedRuntimeWithPaths.Skipped kept kept-paths)
                (if (lower-type-decl? decl)
                  (LowerSkippedRuntimeWithPaths.Skipped
                    (ast.ast-decl-list-prepend-builder decl kept)
                    (ast.ast-decl-path-list-prepend-builder-with-owner-id
                      decl-path
                      owner-id
                      kept-paths))
                  (LowerSkippedRuntimeWithPaths.Skipped kept kept-paths))])]))]))

(define (lower-decls-in-module
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [local-top-env : tc_core.TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [globals : ir.CompilerIrGlobalList]
  [functions : ir.CompilerIrFunctionList]
  [externs : ir.CompilerIrExternList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [type-cache : LowerTypeCache]
  [dispatch-variants : lower_i64_i64_map.Map]
  [mode : CompilerLowerMode]
  [module : String]
  [module-id : i64]) : ResultLowerDecls
  (let
    [cur-decls : ast.AstDeclList decls]
    [cur-paths : ast.AstDeclPathList paths]
    [cur-local-top-env : tc_core.TcTypeEnv local-top-env]
    [cur-globals : ir.CompilerIrGlobalList globals]
    [cur-functions : ir.CompilerIrFunctionBuilder
      (ir.compiler-ir-function-builder-from-list functions)]
    [cur-externs : ir.CompilerIrExternList externs]
    [cur-spans : ir.CompilerSourceSpans spans]
    [cur-name-cache : LowerNameCache name-cache]
    [cur-type-cache : LowerTypeCache type-cache]
    [cur-module : String module]
    [cur-module-id : i64 module-id]
    [result : ResultLowerDecls
      (ResultLowerDecls.Err
        (box (lower-diagnostic "lower: internal decls walk")))]
    [done : bool false]
    (begin
      (while (not done)
        (match (ast.ast-decl-list-step cur-decls)
          [(ast.AstDeclListStep.Nil)
            (begin
              (set!
                result
                (ResultLowerDecls.Ok
                  (box
                    (LowerDeclsSuccess
                      (ir.compiler-ir-global-list-compact-reversed cur-globals)
                      (ir.compiler-ir-function-builder-snapshot-list
                        (& cur-functions))
                      (ir.compiler-ir-extern-list-compact-reversed cur-externs)
                      cur-spans))))
              (set! done true))]
          [(ast.AstDeclListStep.Cons decl rest)
            (let
              [rest : ast.AstDeclList rest]
              [decl-path : String
                (ast.ast-decl-path-list-get (& cur-paths) 0 entry-path)]
              [logical-module-id : i64
                (lower-decl-owner-module-id
                  (& cur-paths)
                  0
                  entry-path
                  decl-path
                  cur-module-id)]
              [logical-module : String
                (lower-decl-owner-module-name cur-module-id logical-module-id)]
              [decl-name-cache : LowerNameCache
                (lower-name-cache-with-module-id
                  cur-name-cache
                  logical-module-id)]
              [rest-paths : ast.AstDeclPathList
                (ast.ast-decl-path-list-tail cur-paths)]
              [_advance-paths : unit (set! cur-paths rest-paths)]
              [_source-path : unit
                (set!
                  lower-current-source-path-id
                  (if (> (string.string-length decl-path) 0)
                    (load.compiler-load-source-path-id decl-path)
                    0))]
              [_generated-decl : unit
                (set!
                  lower-current-decl-generated?
                  (match (ast.ast-decl-generated-meta decl)
                    [(ast.AstGeneratedDeclMeta.Some _ _ _ _) true]
                    [(ast.AstGeneratedDeclMeta.No) false]))]
              (match (ast.ast-decl-unwrapped decl)
                [(ast.AstDecl.ModuleBody _ _) (set! cur-decls rest)]
                [(ast.AstDecl.Def decl-meta name _ expr-box)
                  (let
                    [decl-ctx : tc_core.TcContext
                      (tc_core.tc-context-with-module-id
                        ctx
                        cur-module
                        cur-module-id)]
                    [expr : ast.AstExpr
                      (lower-context-expr-get decl-ctx expr-box)]
                    (match (lower-top-decl-type-or-check
                      decl-ctx
                      cur-local-top-env
                      decl)
                      [(tc_core.ResultTcType.Ok ty)
                        (let
                          [global-ty : ast.AstType
                            (tc_core.tc-type-without-regions ty)]
                          [global-name : String
                            (lower-current-decl-logical-name-cache-id
                              decl-name-cache
                              logical-module
                              (tc_core.tc-env-key-name-text name)
                              name)]
                          [global-key-id : i64
                            (lower-module-name-key-id-by-id
                              logical-module-id
                              name)]
                          [global-id : i64
                            (lower-name-cache-lookup-logical-id
                              (& decl-name-cache)
                              global-key-id
                              global-key-id)]
                          [global-symbol : i64
                            (lower-name-cache-ir-symbol
                              decl-name-cache
                              global-id
                              name
                              global-name)]
                          (match (lower-global-value
                            decl-ctx
                            decl-name-cache
                            expr
                            global-ty)
                            [(ResultLowerValue.Ok value)
                              (begin
                                (set!
                                  cur-globals
                                  (ir.compiler-ir-global-cons
                                    (ir.CompilerIrGlobal.Global
                                      global-symbol
                                      global-ty
                                      value)
                                    cur-globals))
                                (set! cur-decls rest))]
                            ;; A global whose initializer is not a compile-time
                            ;; constant is evaluated at startup by a hidden
                            ;; `__global_init_<name>` function whose return
                            ;; value the backend stores into the global before
                            ;; `main`. This applies to any non-unit type
                            ;; (scalars as well as aggregates), mirroring the
                            ;; former Rust lowerer, which emits an init function
                            ;; whenever `extract_const` yields no constant.
                            [(ResultLowerValue.Err _)
                              (let
                                [init-symbol : i64
                                  (lower-global-init-function-name
                                    global-symbol)]
                                (match (lower-function-escaping
                                  decl-ctx
                                  cur-local-top-env
                                  cur-type-cache
                                  init-symbol
                                  (ast.ast-param-list-new)
                                  global-ty
                                  expr
                                  cur-spans
                                  decl-name-cache
                                  mode)
                                  [(ResultLowerFunction.Ok
                                      init-funcs
                                      init-spans)
                                    (begin
                                      (set!
                                        cur-globals
                                        (ir.compiler-ir-global-cons
                                          (ir.CompilerIrGlobal.Global
                                            global-symbol
                                            global-ty
                                            (ir.CompilerIrValue.RuntimeGlobal
                                              init-symbol))
                                          cur-globals))
                                      (ir.compiler-ir-function-builder-append-list!
                                        (&mut cur-functions)
                                        init-funcs)
                                      (set! cur-spans init-spans)
                                      (set! cur-decls rest))]
                                  [(ResultLowerFunction.Err init-message)
                                    (begin
                                      (set!
                                        result
                                        (ResultLowerDecls.Err init-message))
                                      (set! done true))]))]))]
                      [(tc_core.ResultTcType.Err message)
                        (begin
                          (set!
                            result
                            (ResultLowerDecls.Err
                              (box (lower-diagnostic message))))
                          (set! done true))]))]
                [(ast.AstDecl.Extern decl-meta name _ metadata ty)
                  (let
                    [decl-ctx : tc_core.TcContext
                      (tc_core.tc-context-with-module-id
                        ctx
                        cur-module
                        cur-module-id)]
                    [resolved-ty : ast.AstType
                      (tc_core.tc-resolve-type decl-ctx ty)]
                    [logical-name : String
                      (lower-current-decl-logical-name-cache-id
                        decl-name-cache
                        logical-module
                        (tc_core.tc-env-key-name-text name)
                        name)]
                    [logical-key-id : i64
                      (lower-module-name-key-id-by-id logical-module-id name)]
                    [logical-id : i64
                      (lower-name-cache-lookup-logical-id
                        (& decl-name-cache)
                        logical-key-id
                        logical-key-id)]
                    (if (and
                      (tc_core.tc-type-contains-reference? resolved-ty)
                      (not
                        (lower-supported-reference-extern?
                          decl-ctx
                          name
                          resolved-ty)))
                      (begin
                        (set!
                          result
                          (ResultLowerDecls.Err
                            (box
                              (lower-diagnostic
                                (lower-reference-support-message)))))
                        (set! done true))
                      (begin
                        (set!
                          cur-externs
                          (ir.compiler-ir-extern-cons
                            (ir.CompilerIrExtern.Extern
                              (lower-extern-logical-symbol-id
                                logical-id
                                logical-name
                                name
                                (box-get metadata))
                              name
                              logical-name
                              (tc_core.tc-type-without-regions resolved-ty)
                              (ast.ast-extern-metadata-abi (box-get metadata))
                              (ast.ast-extern-metadata-symbol-id
                                (box-get metadata))
                              (ast.ast-extern-metadata-link-inputs
                                (box-get metadata))
                              false)
                            cur-externs))
                        (set! cur-decls rest))))]
                [(ast.AstDecl.DefFn decl-meta name params ret body-box metadata)
                  (let
                    [decl-ctx : tc_core.TcContext
                      (tc_core.tc-context-with-module-id
                        ctx
                        cur-module
                        cur-module-id)]
                    [body : ast.AstExpr
                      (lower-context-expr-get decl-ctx body-box)]
                    [logical-id : i64
                      (lower-decl-logical-id
                        entry-path
                        decl-path
                        logical-module
                        logical-module-id
                        name
                        (tc_core.tc-env-key-name-text name))]
                    [logical-name : String
                      (if (= logical-id cbi.compiler-builtin-id-fix-main)
                        "main"
                        (lower-current-decl-logical-name-cache-id
                          decl-name-cache
                          logical-module
                          (tc_core.tc-env-key-name-text name)
                          name))]
                    [function-symbol : i64
                      (lower-decl-function-symbol-id
                        decl-name-cache
                        logical-id
                        name
                        logical-name)]
                    (if (lower_i64_i64_map.contains?
                      (& dispatch-variants)
                      logical-id)
                      (set! cur-decls rest)
                      (begin
                        (cfg
                          compile-profile
                          (compiler-lower-profile-detail-start))
                        (match (lower-function-escaping
                          decl-ctx
                          cur-local-top-env
                          cur-type-cache
                          function-symbol
                          params
                          ret
                          body
                          cur-spans
                          decl-name-cache
                          mode)
                          [(ResultLowerFunction.Ok
                              lowered-functions
                              function-spans)
                            (match (lower-spmd-package-callable-functions
                              decl-ctx
                              cur-local-top-env
                              cur-type-cache
                              (csym.compiler-symbol-module-key
                                (if (= (string.string-length cur-module) 0)
                                  (lower-global-shared-view
                                    lower-spmd-package-name)
                                  cur-module)
                                (tc_core.tc-env-key-name-text name))
                              (csym.compiler-symbols-lookup-value-id-or
                                (tc_core.tc-context-symbols decl-ctx)
                                logical-id
                                (csym.compiler-symbols-lookup-value-id-or
                                  (tc_core.tc-context-symbols decl-ctx)
                                  name
                                  (csym.compiler-symbols-missing-handle)))
                              params
                              ret
                              body
                              (ast.ast-fn-metadata-spmd-callable metadata)
                              function-spans
                              cur-name-cache
                              mode)
                              [(ResultLowerFunction.Err message)
                                (begin
                                  (cfg
                                    compile-profile
                                    (compiler-lower-profile-detail-finish
                                      "function"
                                      logical-name))
                                  (set! result (ResultLowerDecls.Err message))
                                  (set! done true))]
                              [(ResultLowerFunction.Ok
                                  callable-functions
                                  next-spans)
                                (let
                                  [next-externs : ir.CompilerIrExternList
                                    (match (ast.ast-fn-metadata-export metadata)
                                      [(ast.AstFnExport.No) cur-externs]
                                      [(ast.AstFnExport.Export symbol)
                                        (ir.compiler-ir-extern-cons
                                          (ir.CompilerIrExtern.Extern
                                            function-symbol
                                            function-symbol
                                            logical-name
                                            (ast.ast-ty-func
                                              (tc_core.tc-type-list-without-regions
                                                (tc_core.tc-param-type-list
                                                  decl-ctx
                                                  params))
                                              (tc_core.tc-type-without-regions
                                                (tc_core.tc-resolve-type
                                                  decl-ctx
                                                  ret)))
                                            (ast.AstExternAbi.C)
                                            symbol
                                            (ast.ast-extern-link-input-list-new)
                                            true)
                                          cur-externs)])]
                                  (begin
                                    (cfg
                                      compile-profile
                                      (compiler-lower-profile-detail-finish
                                        "function"
                                        logical-name))
                                    (ir.compiler-ir-function-builder-append-list!
                                      (&mut cur-functions)
                                      lowered-functions)
                                    (ir.compiler-ir-function-builder-append-list!
                                      (&mut cur-functions)
                                      callable-functions)
                                    (set! cur-externs next-externs)
                                    (set! cur-spans next-spans)
                                    (set! cur-decls rest)))])]
                          [(ResultLowerFunction.Err message)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-lower-profile-detail-finish
                                  "function"
                                  logical-name))
                              (set! result (ResultLowerDecls.Err message))
                              (set! done true))]))))]
                [(ast.AstDecl.DefMacro decl-meta _ _ _ _) (set! cur-decls rest)]
                [(ast.AstDecl.DefDispatch decl-meta name variants)
                  (match (lower-dispatch-decl
                    ctx
                    top-env
                    cur-local-top-env
                    cur-type-cache
                    name
                    variants
                    cur-spans
                    decl-name-cache
                    mode
                    cur-module
                    cur-module-id
                    logical-module
                    logical-module-id)
                    [(ResultLowerDispatchDecl.Ok lowered)
                      (match (box-get lowered)
                        [(LowerDispatchDecl.Decl
                            cache-global
                            lowered-functions
                            function-spans)
                          (begin
                            (set!
                              cur-globals
                              (ir.compiler-ir-global-cons
                                cache-global
                                cur-globals))
                            (ir.compiler-ir-function-builder-append-list!
                              (&mut cur-functions)
                              lowered-functions)
                            (set! cur-spans function-spans)
                            (set! cur-decls rest))])]
                    [(ResultLowerDispatchDecl.Err message)
                      (begin
                        (set! result (ResultLowerDecls.Err message))
                        (set! done true))])]
                [(ast.AstDecl.Import decl-meta _) (set! cur-decls rest)]
                [(ast.AstDecl.IncludeStr _ _) (set! cur-decls rest)]
                [(ast.AstDecl.IncludeStrComptime _ _) (set! cur-decls rest)]
                [(ast.AstDecl.IncludeStrLzss _ _) (set! cur-decls rest)]
                [(ast.AstDecl.IncludeBin _ _) (set! cur-decls rest)]
                [(ast.AstDecl.Module next-module)
                  (let
                    [next-module-str : String (ci.intern-str next-module)]
                    [skip-runtime : bool
                      (lower-comptime-runtime-skip-module? next-module-str)]
                    (match (lower-module-local-view-cached
                      ctx
                      top-env
                      names
                      next-module-str
                      next-module)
                      [(ResultLowerModuleLocalView.Ok view)
                        (begin
                          (set!
                            cur-local-top-env
                            (struct-get view local-top-env))
                          (set! cur-name-cache (struct-get view name-cache))
                          (set! cur-type-cache (struct-get view type-cache))
                          (set! cur-module next-module-str)
                          (set! cur-module-id next-module)
                          (if skip-runtime
                            (match (lower-skip-runtime-until-next-module-with-paths
                              rest
                              cur-paths)
                              [(LowerSkippedRuntimeWithPaths.Skipped
                                  kept-decls
                                  kept-paths)
                                (begin
                                  (set! cur-decls kept-decls)
                                  (set! cur-paths kept-paths))])
                            (set! cur-decls rest)))]
                      [(ResultLowerModuleLocalView.Err message)
                        (begin
                          (set!
                            result
                            (ResultLowerDecls.Err
                              (box (lower-diagnostic message))))
                          (set! done true))]))]
                [(ast.AstDecl.Test _ _ _) (set! cur-decls rest)]
                [(ast.AstDecl.DefEnum decl-meta name cleanup variants)
                  (let
                    [decl-ctx : tc_core.TcContext
                      (tc_core.tc-context-with-module-id
                        ctx
                        cur-module
                        cur-module-id)]
                    [logical-name : i64
                      (match cleanup
                        [(ast.AstEnumCleanup.No) -1]
                        [(ast.AstEnumCleanup.Fn cleanup-name)
                          (let
                            [key-id : i64
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                cleanup-name)]
                            (lower-name-cache-ir-symbol
                              decl-name-cache
                              (lower-name-cache-lookup-logical-id
                                (& decl-name-cache)
                                key-id
                                key-id)
                              cleanup-name
                              (lower-current-decl-logical-name-cache-id
                                decl-name-cache
                                logical-module
                                (tc_core.tc-env-key-name-text cleanup-name)
                                cleanup-name)))])]
                    [enum-id : i64
                      (csym.compiler-symbol-module-key-id-by-id
                        cur-module-id
                        name)]
                    (begin
                      (if (lower-comptime-runtime-skip-module? cur-module)
                        unit
                        (set!
                          cur-globals
                          (lower-nullary-variant-globals
                            (lower-name-cache-lookup-logical-id
                              (& decl-name-cache)
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                name)
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                name))
                            (lower-current-decl-logical-name-cache-id
                              decl-name-cache
                              logical-module
                              (tc_core.tc-env-key-name-text name)
                              name)
                            variants
                            0
                            cur-globals)))
                      (match (lower-enum-cleanup-decl
                        decl-ctx
                        cur-local-top-env
                        cur-type-cache
                        logical-name
                        cleanup
                        (ast.AstType.Enum enum-id)
                        variants
                        cur-spans
                        decl-name-cache
                        mode)
                        [(ResultLowerFunction.Ok
                            cleanup-functions
                            cleanup-spans)
                          (begin
                            (ir.compiler-ir-function-builder-append-list!
                              (&mut cur-functions)
                              cleanup-functions)
                            (set! cur-spans cleanup-spans)
                            (set! cur-decls rest))]
                        [(ResultLowerFunction.Err message)
                          (begin
                            (set! result (ResultLowerDecls.Err message))
                            (set! done true))])))]
                [(ast.AstDecl.DefEnumLifetimes
                    decl-meta
                    name
                    lifetimes
                    cleanup
                    variants)
                  (let
                    [decl-ctx : tc_core.TcContext
                      (tc_core.tc-context-with-module-id
                        ctx
                        cur-module
                        cur-module-id)]
                    [logical-name : i64
                      (match cleanup
                        [(ast.AstEnumCleanup.No) -1]
                        [(ast.AstEnumCleanup.Fn cleanup-name)
                          (let
                            [key-id : i64
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                cleanup-name)]
                            (lower-name-cache-ir-symbol
                              decl-name-cache
                              (lower-name-cache-lookup-logical-id
                                (& decl-name-cache)
                                key-id
                                key-id)
                              cleanup-name
                              (lower-current-decl-logical-name-cache-id
                                decl-name-cache
                                logical-module
                                (tc_core.tc-env-key-name-text cleanup-name)
                                cleanup-name)))])]
                    [enum-id : i64
                      (csym.compiler-symbol-module-key-id-by-id
                        cur-module-id
                        name)]
                    (begin
                      (if (lower-comptime-runtime-skip-module? cur-module)
                        unit
                        (set!
                          cur-globals
                          (lower-nullary-variant-globals
                            (lower-name-cache-lookup-logical-id
                              (& decl-name-cache)
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                name)
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                name))
                            (lower-current-decl-logical-name-cache-id
                              decl-name-cache
                              logical-module
                              (tc_core.tc-env-key-name-text name)
                              name)
                            variants
                            0
                            cur-globals)))
                      (match (lower-enum-cleanup-decl
                        decl-ctx
                        cur-local-top-env
                        cur-type-cache
                        logical-name
                        cleanup
                        (ast.ast-ty-enum-args enum-id lifetimes)
                        variants
                        cur-spans
                        decl-name-cache
                        mode)
                        [(ResultLowerFunction.Ok
                            cleanup-functions
                            cleanup-spans)
                          (begin
                            (ir.compiler-ir-function-builder-append-list!
                              (&mut cur-functions)
                              cleanup-functions)
                            (set! cur-spans cleanup-spans)
                            (set! cur-decls rest))]
                        [(ResultLowerFunction.Err message)
                          (begin
                            (set! result (ResultLowerDecls.Err message))
                            (set! done true))])))]
                [(ast.AstDecl.DefStruct decl-meta name _ cleanup fields)
                  (let
                    [decl-ctx : tc_core.TcContext
                      (tc_core.tc-context-with-module-id
                        ctx
                        cur-module
                        cur-module-id)]
                    [logical-name : i64
                      (match cleanup
                        [(ast.AstStructCleanup.No) -1]
                        [(ast.AstStructCleanup.Fn cleanup-name)
                          (let
                            [key-id : i64
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                cleanup-name)]
                            (lower-name-cache-ir-symbol
                              decl-name-cache
                              (lower-name-cache-lookup-logical-id
                                (& decl-name-cache)
                                key-id
                                key-id)
                              cleanup-name
                              (lower-current-decl-logical-name-cache-id
                                decl-name-cache
                                logical-module
                                (tc_core.tc-env-key-name-text cleanup-name)
                                cleanup-name)))])]
                    [struct-ty : ast.AstType
                      (ast.AstType.Struct
                        (csym.compiler-symbol-module-key-id-by-id
                          cur-module-id
                          name))]
                    (match (lower-struct-cleanup-decl
                      decl-ctx
                      cur-local-top-env
                      cur-type-cache
                      logical-name
                      cleanup
                      struct-ty
                      fields
                      cur-spans
                      decl-name-cache
                      mode)
                      [(ResultLowerFunction.Ok cleanup-functions cleanup-spans)
                        (begin
                          (ir.compiler-ir-function-builder-append-list!
                            (&mut cur-functions)
                            cleanup-functions)
                          (set! cur-spans cleanup-spans)
                          (set! cur-decls rest))]
                      [(ResultLowerFunction.Err message)
                        (begin
                          (set! result (ResultLowerDecls.Err message))
                          (set! done true))]))]
                [(ast.AstDecl.DefStructLifetimes
                    decl-meta
                    name
                    lifetimes
                    _
                    cleanup
                    fields)
                  (let
                    [decl-ctx : tc_core.TcContext
                      (tc_core.tc-context-with-module-id
                        ctx
                        cur-module
                        cur-module-id)]
                    [logical-name : i64
                      (match cleanup
                        [(ast.AstStructCleanup.No) -1]
                        [(ast.AstStructCleanup.Fn cleanup-name)
                          (let
                            [key-id : i64
                              (lower-module-name-key-id-by-id
                                logical-module-id
                                cleanup-name)]
                            (lower-name-cache-ir-symbol
                              decl-name-cache
                              (lower-name-cache-lookup-logical-id
                                (& decl-name-cache)
                                key-id
                                key-id)
                              cleanup-name
                              (lower-current-decl-logical-name-cache-id
                                decl-name-cache
                                logical-module
                                (tc_core.tc-env-key-name-text cleanup-name)
                                cleanup-name)))])]
                    [struct-ty : ast.AstType
                      (ast.ast-ty-struct-args
                        (csym.compiler-symbol-module-key-id-by-id
                          cur-module-id
                          name)
                        lifetimes)]
                    (match (lower-struct-cleanup-decl
                      decl-ctx
                      cur-local-top-env
                      cur-type-cache
                      logical-name
                      cleanup
                      struct-ty
                      fields
                      cur-spans
                      decl-name-cache
                      mode)
                      [(ResultLowerFunction.Ok cleanup-functions cleanup-spans)
                        (begin
                          (ir.compiler-ir-function-builder-append-list!
                            (&mut cur-functions)
                            cleanup-functions)
                          (set! cur-spans cleanup-spans)
                          (set! cur-decls rest))]
                      [(ResultLowerFunction.Err message)
                        (begin
                          (set! result (ResultLowerDecls.Err message))
                          (set! done true))]))]
                [(ast.AstDecl.Unsafe _) (set! cur-decls rest)]))]))
      result)))

(define (lower-compiler-program-checked-with-names-mode
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [clone-roots : clone_support.CloneRootEntries]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (begin
    ;; Clone-root discovery and checked typechecking can probe aggregate layout
    ;; with helper contexts before final lowering. Emitted code must use one
    ;; internally consistent layout view for all functions in this pass.
    (tc_core.tc-agg-caches-reset!)
    (tc_core.tc-nominal-owner-cache-reset!)
    (match program
      [(ast.AstProgram.Program decls-box)
        (let
          [decls : ast.AstDeclList (box-get decls-box)]
          (match (lower-decls
            ctx
            top-env
            decls
            paths
            entry-path
            ir.CompilerIrGlobalList.Nil
            ir.CompilerIrFunctionList.Nil
            ir.CompilerIrExternList.Nil
            (ir.compiler-source-spans-empty)
            names
            clone-roots
            mode)
            [(ResultLowerDecls.Ok payload)
              (let
                [success : LowerDeclsSuccess (box-get payload)]
                (ResultCompilerLower.Ok
                  (ir.CompilerIrProgram.Program
                    (struct-get success globals)
                    (struct-get success functions)
                    (struct-get success externs))
                  (struct-get success spans)))]
            [(ResultLowerDecls.Err message) (ResultCompilerLower.Err message)]))])))

;; Internal `expanded` workers assume macro expansion has already run; the
;; public `-mode` wrappers below own the expand -> specialize -> typecheck
;; boundary so every lowering path (scalar and SPMD) expands exactly once.
(define (lower-compiler-expanded-program-unlocated-mode
  [program : ast.AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (match (spec.compiler-specialize-program program)
    [(spec.ResultSpecProgram.Ok specialized)
      (let
        [paths : ast.AstDeclPathList (ast.ast-decl-path-list-new)]
        [pools : ast.AstNodePoolContext
          (ast.ast-node-pool-context-capture-active)]
        [keep-plan : LowerDeclKeepPlan
          (match specialized
            [(ast.AstProgram.Program decls-box)
              (lower-decl-keep-plan-all
                (ast.ast-decl-list-len (& (box-get decls-box))))])]
        [alias-names : LowerNameEnv
          (match specialized
            [(ast.AstProgram.Program decls-box)
              (lower-name-env-with-import-aliases
                (box-get decls-box)
                paths
                "<source>"
                LowerNameEnv.Nil
                false)])]
        (begin
          (tc_core.tc-clone-root-collection-use! specialized)
          (lower-typecheck-clone-and-lower
            "<source>"
            specialized
            paths
            keep-plan
            alias-names
            true
            mode
            (svec.new)
            (tc_core.tc-prefix-default-cache-scope)
            pools)))]
    [(spec.ResultSpecProgram.Err diag) (ResultCompilerLower.Err diag)]))

(define (lower-compiler-program-unlocated-mode
  [program : ast.AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (begin
    (tc_core.tc-agg-caches-reset!)
    ;; Generate declaration families before macro expansion (see
    ;; typecheck-compiler-program-with-paths for why).
    (match (spec.gen-normalize-program program)
      [(spec.ResultGenProgram.Ok generated)
        (match (tc_core.macro-expand-program generated)
          [(tc_core.ResultMacroExpand.Ok expanded _)
            (lower-compiler-expanded-program-unlocated-mode expanded mode)]
          [(tc_core.ResultMacroExpand.Err diag) (ResultCompilerLower.Err diag)])]
      [(spec.ResultGenProgram.Err diag) (ResultCompilerLower.Err diag)])))

(define (lower-compiler-program-with-path-mode
  [path : String]
  [program : ast.AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (match (lower-compiler-program-unlocated-mode program mode)
    [(ResultCompilerLower.Ok ir spans) (ResultCompilerLower.Ok ir spans)]
    [(ResultCompilerLower.Err diag)
      (ResultCompilerLower.Err
        (box (lower-diagnostic-with-path (box-get diag) path)))]))

(define (lower-compiler-program-with-path
  [path : String]
  [program : ast.AstProgram]) : ResultCompilerLower
  (lower-compiler-program-with-path-mode
    path
    program
    (CompilerLowerMode.Scalar)))

;; Check source declarations once, collect clone-helper roots as a side effect
;; of that real semantic walk, then append the generated helpers and extend the
;; checked context with only the appended function signatures. Generated clone
;; declarations have never been checked by tc-check-decls (they are trusted
;; compiler output), so building them before typecheck only forced a redundant
;; symbols/registries/top-env construction and a shadow expression typecheck.
(define (lower-typecheck-clone-and-lower-with-source-names-and-intern-state
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [keep-plan : LowerDeclKeepPlan]
  [escaped-names : LowerNameEnv]
  [needs-specialization : bool]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state : ci.InternCompatState]) : ResultCompilerLower
  (let
    [result : ResultCompilerLower
      (match (tc_core.typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools-and-source-names-and-prefix-cache-state-and-intern-state
        load-state
        prefix-cache
        job-state
        program
        paths
        stdlib-roots
        cache-scope
        pools
        source-names
        intern-state)
        [(tc_core.ResultCompilerTypecheckChecked.Ok
            _
            source-ctx
            source-top-env
            _)
          (let
            [clone-roots : clone_support.CloneRootEntries
              (tc_core.tc-clone-root-collection-finish! source-ctx)]
            [source-decl-count : i64
              (match program
                [(ast.AstProgram.Program decls-box)
                  (ast.ast-decl-list-len (& (box-get decls-box)))])]
            [checked-keep-plan : LowerDeclKeepPlan
              (lower-decl-keep-plan-add-clone-roots
                keep-plan
                program
                clone-roots)]
            [clone-able : clone_support.CloneNameSet
              (tc_core.tc-clone-able-set source-ctx)]
            [_install-clone-pools : unit
              (ast.ast-node-pool-context-install! pools)]
            [clone-augmentation : ResultLowerCloneAugment
              (lower-clone-handoff-augment
                source-ctx
                source-top-env
                entry-path
                program
                clone-able
                clone-roots
                pools)]
            [checked-program : ast.AstProgram
              (match clone-augmentation
                [(ResultLowerCloneAugment.Ok augmented _) augmented]
                [(ResultLowerCloneAugment.Err _) program])]
            [_install-augmented-pools : unit
              (ast.ast-node-pool-context-install! pools)]
            [checked-context : ResultLowerCheckedContext
              (match clone-augmentation
                [(ResultLowerCloneAugment.Ok _ _)
                  (lower-extend-checked-context-with-clone-decls
                    source-ctx
                    source-top-env
                    source-decl-count
                    checked-program)]
                [(ResultLowerCloneAugment.Err message)
                  (ResultLowerCheckedContext.Err message)])]
            [lower-names : LowerNameEnv
              (match checked-program
                [(ast.AstProgram.Program decls-box)
                  (let
                    [decls : ast.AstDeclList (box-get decls-box)]
                    (if needs-specialization
                      (lower-name-env-add-clone-decls
                        decls
                        paths
                        entry-path
                        escaped-names)
                      (lower-name-env-from-decls
                        decls
                        paths
                        entry-path
                        LowerNameEnv.Nil)))])]
            (begin
              (cfg compile-profile (compiler-lower-profile-finish "typecheck"))
              (cfg compile-profile (compiler-lower-profile-start))
              (match checked-context
                [(ResultLowerCheckedContext.Ok ctx top-env)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-lower-profile-finish "clone_augment_names"))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-pools "typecheck" pools))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-pools "pre_decls" pools))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-program-counts
                        "pre_decls"
                        checked-program))
                    (cfg compile-profile (compiler-lower-profile-start))
                    ;; Whole-program source typecheck is complete. Apply the
                    ;; declaration decisions retained by reachability; clone
                    ;; helpers are appended and marked by add-clone-roots.
                    (let
                      [pruned-program : ast.AstProgram
                        (lower-decl-keep-plan-apply
                          checked-keep-plan
                          checked-program)]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-lower-profile-finish "prune_apply"))
                        (cfg
                          compile-profile
                          (compiler-lower-profile-program-counts
                            "reachable"
                            pruned-program))
                        (cfg compile-profile (compiler-lower-profile-start))
                        (cfg
                          compile-profile
                          (compiler-lower-profile-string-concat-reset))
                        (match (lower-compiler-program-checked-with-names-mode
                          ctx
                          top-env
                          pruned-program
                          (lower-decl-keep-plan-apply-paths
                            checked-keep-plan
                            paths)
                          entry-path
                          lower-names
                          clone-roots
                          mode)
                          [(ResultCompilerLower.Ok ir spans)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-lower-profile-string-concat-finish))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-name-finish))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-finish "decls"))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-ir-shape
                                  "after_decls"
                                  ir))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-ir-arena "after_decls"))
                              (ResultCompilerLower.Ok ir spans))]
                          [(ResultCompilerLower.Err diag)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-lower-profile-string-concat-finish))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-name-finish))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-finish "decls"))
                              (ResultCompilerLower.Err
                                (box
                                  (lower-diagnostic-with-path
                                    (box-get diag)
                                    entry-path))))]))))]
                [(ResultLowerCheckedContext.Err message)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-lower-profile-finish "clone_augment_names"))
                    (ResultCompilerLower.Err (box (lower-diagnostic message))))])))]
        [(tc_core.ResultCompilerTypecheckChecked.Err diag)
          (begin
            (tc_core.tc-clone-root-collection-abort!)
            (cfg compile-profile (compiler-lower-profile-finish "typecheck"))
            (ResultCompilerLower.Err
              (box (cdiag.compiler-diagnostic-list-first (box-get diag)))))])]
    (begin
      (ast.ast-node-pool-context-capture-active! pools)
      (ci.intern-compat-state-capture-from-globals! intern-state)
      result)))

;; Serial/test compatibility adapter.  Production lower jobs pass the
;; compile-owned intern state through the explicit entry above.
(define (lower-typecheck-clone-and-lower-with-source-names
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [keep-plan : LowerDeclKeepPlan]
  [escaped-names : LowerNameEnv]
  [needs-specialization : bool]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (lower-typecheck-clone-and-lower-with-source-names-and-intern-state
    load-state
    prefix-cache
    job-state
    entry-path
    program
    paths
    keep-plan
    escaped-names
    needs-specialization
    mode
    stdlib-roots
    cache-scope
    pools
    source-names
    (ci.intern-compat-state-capture-active)))

(define (lower-typecheck-clone-and-lower
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [keep-plan : LowerDeclKeepPlan]
  [escaped-names : LowerNameEnv]
  [needs-specialization : bool]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]) : ResultCompilerLower
  (lower-typecheck-clone-and-lower-with-source-names
    (load.compiler-load-serial-test-session-state)
    (tc_core.tc-prefix-snapshot-serial-test-cache-state-shared-view)
    (tc_core.tc-serial-job-state)
    entry-path
    program
    paths
    keep-plan
    escaped-names
    needs-specialization
    mode
    stdlib-roots
    cache-scope
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache-active-and-pools-and-source-names-and-intern-state
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state : ci.InternCompatState]) : ResultCompilerLower
  (begin
    (cfg compile-profile (compiler-lower-profile-name-reset))
    (spec.spec-profile-reset!)
    (cfg compile-profile (compiler-lower-profile-start))
    (let
      [needs-specialization : bool
        (spec.compiler-specialize-needed-with-pools program pools)]
      [names : LowerNameEnv
        (match program
          [(ast.AstProgram.Program decls-box)
            (let
              [decls : ast.AstDeclList (box-get decls-box)]
              (lower-name-env-from-decls
                decls
                paths
                entry-path
                LowerNameEnv.Nil))])]
      [specialized-result : spec.ResultSpecProgramWithPaths
        (begin
          ;; Lower-name construction is a legacy ambient phase; publish its
          ;; scalar interner changes before explicit specialization begins.
          (ci.intern-compat-state-capture-from-globals! intern-state)
          (if needs-specialization
            (spec.compiler-specialize-program-with-paths-and-pools-and-intern-state
              program
              paths
              entry-path
              pools
              intern-state)
            (spec.ResultSpecProgramWithPaths.Ok program paths)))]
      (begin
        ;; Explicit specialization mutates owner pool/interner cells; publish
        ;; them before matching either result or entering legacy lowering.
        (ast.ast-node-pool-context-install! pools)
        (ci.intern-compat-state-install! intern-state)
        (match specialized-result
          [(spec.ResultSpecProgramWithPaths.Ok specialized specialized-paths)
            (begin
              (cfg compile-profile (compiler-lower-profile-finish "specialize"))
              (cfg
                compile-profile
                (compiler-lower-profile-specialization-counters))
              (cfg compile-profile (compiler-lower-profile-start))
              (let
                [prune-names : LowerNameEnv
                  (if needs-specialization
                    (match specialized
                      [(ast.AstProgram.Program decls-box)
                        (let
                          [decls : ast.AstDeclList (box-get decls-box)]
                          (lower-name-env-from-decls
                            decls
                            specialized-paths
                            entry-path
                            LowerNameEnv.Nil))])
                    names)]
                ;; Typecheck remains complete and whole-program while lower,
                ;; optimize, and codegen are gated on reachability. This up-front
                ;; walk records the dense declaration selection consumed both by
                ;; typecheck's clone-root observer and by the final linear prune.
                (match (lower-prune-unreachable-functions-with-clone-roots-and-plan
                  pools
                  entry-path
                  specialized
                  specialized-paths
                  prune-names
                  (clone_support.CloneRootEntries.Empty))
                  [(LowerPrunedProgramWithPlan.Program
                      reach-program
                      _reach-paths
                      reach-keep-plan)
                    (begin
                      (cfg
                        compile-profile
                        (compiler-lower-profile-finish "prune"))
                      (cfg compile-profile (compiler-lower-profile-start))
                      ;; Capture stable retained declaration keys before optional
                      ;; pool compaction releases the reach-program AST.
                      (tc_core.tc-clone-root-collection-use! reach-program)
                      (let
                        [detach-source? : bool lower-checked-dest-pools-active]
                        [source-compaction : ast.AstProgramCompaction
                          (if detach-source?
                            (ast.ast-program-compact-with-pools
                              pools
                              (lower-global-shared-view
                                lower-checked-dest-pools-context)
                              specialized)
                            (ast.AstProgramCompaction specialized pools))]
                        [source-program : ast.AstProgram
                          (match source-compaction
                            [(ast.AstProgramCompaction out _) out])]
                        [source-pools : ast.AstNodePoolContext
                          (match source-compaction
                            [(ast.AstProgramCompaction _ out-pools) out-pools])]
                        [source-entry-path : String
                          (if detach-source?
                            (lower-copy-string-into-pools
                              entry-path
                              source-pools)
                            entry-path)]
                        [source-cache-scope : String
                          (if detach-source?
                            (lower-copy-string-into-pools
                              cache-scope
                              source-pools)
                            cache-scope)]
                        [source-paths : ast.AstDeclPathList
                          (if detach-source?
                            (lower-copy-paths-into-pools
                              specialized-paths
                              source-pools)
                            specialized-paths)]
                        [source-keep-plan : LowerDeclKeepPlan
                          (if detach-source?
                            (lower-decl-keep-plan-copy-into-pools
                              reach-keep-plan
                              source-pools)
                            reach-keep-plan)]
                        [escaped-names : LowerNameEnv
                          (if (and detach-source? needs-specialization)
                            (lower-name-env-copy-into-pools names source-pools)
                            names)]
                        [_clear-source-derived-caches : unit
                          (if detach-source?
                            (lower-clear-macro-expanded-source-caches-into-pools!
                              source-pools)
                            unit)]
                        [_commit-dest : unit
                          (lower-checked-dest-pools-commit! source-pools)]
                        [_capture-before-typecheck : unit
                          (ci.intern-compat-state-capture-from-globals!
                            intern-state)]
                        (lower-typecheck-clone-and-lower-with-source-names-and-intern-state
                          load-state
                          prefix-cache
                          job-state
                          source-entry-path
                          source-program
                          source-paths
                          source-keep-plan
                          escaped-names
                          needs-specialization
                          mode
                          stdlib-roots
                          source-cache-scope
                          source-pools
                          source-names
                          intern-state)))])))]
          [(spec.ResultSpecProgramWithPaths.Err diag)
            (begin
              (cfg compile-profile (compiler-lower-profile-finish "specialize"))
              (cfg
                compile-profile
                (compiler-lower-profile-specialization-counters))
              (ResultCompilerLower.Err
                (box (lower-diagnostic-with-path (box-get diag) entry-path))))])))))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-intern-state
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state : ci.InternCompatState]) : ResultCompilerLower
  (let
    [prev-active : bool lower-entry-main-module-active]
    [prev-module : String (string.copy (& lower-entry-main-module))]
    [prev-module-id : i64 lower-entry-main-module-id]
    [selection : LowerMaybeEntryMainModule
      (lower-entry-main-selection-for-program entry-path program paths)]
    (begin
      (lower-entry-main-selection-install! selection)
      (let
        [result : ResultCompilerLower
          (lower-compiler-expanded-program-with-decl-paths-mode-cache-active-and-pools-and-source-names-and-intern-state
            load-state
            prefix-cache
            job-state
            entry-path
            program
            paths
            mode
            stdlib-roots
            cache-scope
            pools
            source-names
            intern-state)]
        (begin
          (lower-entry-main-selection-restore!
            prev-active
            prev-module
            prev-module-id)
          result)))))

(define (lower-compiler-program-with-decl-paths-mode-cache
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools
    entry-path
    program
    paths
    mode
    stdlib-roots
    cache-scope
    (ast.ast-node-pool-context-capture-active)))

(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state-and-intern-state
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state : ci.InternCompatState]) : ResultCompilerLower
  (begin
    (cfg compile-profile (compiler-lower-profile-start))
    (tc_core.tc-agg-caches-reset!)
    ;; Generate declaration families before macro expansion (see
    ;; typecheck-compiler-program-with-paths for why).
    (let
      [generated-result : spec.ResultGenProgramWithPaths
        (spec.gen-normalize-program-with-paths-and-pools-and-intern-state
          program
          paths
          entry-path
          (spec.spec-owner-context-new pools intern-state))]
      (begin
        ;; Publish explicit generation mutations before matching either result
        ;; or entering the legacy macro-expansion phase.
        (ast.ast-node-pool-context-install! pools)
        (ci.intern-compat-state-install! intern-state)
        (match generated-result
          [(spec.ResultGenProgramWithPaths.Ok generated generated-paths)
            (let
              [detach-before-macro? : bool lower-checked-dest-pools-active]
              [generated-compaction : ast.AstProgramCompaction
                (if detach-before-macro?
                  (ast.ast-program-compact-with-pools
                    pools
                    (compiler-lower-checked-dest-pools-current)
                    generated)
                  (ast.AstProgramCompaction generated pools))]
              [macro-program : ast.AstProgram
                (match generated-compaction
                  [(ast.AstProgramCompaction out _) out])]
              [macro-pools : ast.AstNodePoolContext
                (match generated-compaction
                  [(ast.AstProgramCompaction _ out-pools) out-pools])]
              [macro-entry-path : String
                (if detach-before-macro?
                  (lower-copy-string-into-pools entry-path macro-pools)
                  entry-path)]
              [macro-cache-scope : String
                (if detach-before-macro?
                  (lower-copy-string-into-pools cache-scope macro-pools)
                  cache-scope)]
              [macro-paths : ast.AstDeclPathList
                (if detach-before-macro?
                  (lower-copy-paths-into-pools generated-paths macro-pools)
                  generated-paths)]
              [_clear-source-derived-caches : unit
                (if detach-before-macro?
                  (begin
                    (lower-clear-macro-expanded-source-caches-into-pools!
                      macro-pools)
                    (load.compiler-load-session-state-program-cache-clear!
                      load-state)
                    (load.compiler-load-session-state-runtime-prelude-cache-clear!
                      load-state)
                    (tc_core.tc-prefix-snapshot-cache-clear-for-state!
                      prefix-cache))
                  unit)]
              [_commit-generated-pools : unit
                (if detach-before-macro?
                  (lower-checked-dest-pools-commit! macro-pools)
                  unit)]
              [committed-macro-pools : ast.AstNodePoolContext
                (if detach-before-macro?
                  (compiler-lower-checked-dest-pools-current)
                  macro-pools)]
              [_arm-post-macro-detach : unit
                (if detach-before-macro?
                  (lower-checked-dest-pools-rollover-for-macro!)
                  unit)]
              [_macro-handoff-profile-finish : unit
                (cfg
                  compile-profile
                  (compiler-lower-profile-finish "macro_handoff"))]
              (begin
                (cfg compile-profile (compiler-lower-profile-start))
                (let
                  [macro-result : tc_core.ResultMacroExpand
                    (tc_core.macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state-and-intern-state
                      load-state
                      macro-program
                      macro-paths
                      committed-macro-pools
                      source-names
                      job-state
                      stdlib-roots
                      (lower-source-language-cfgs)
                      intern-state)]
                  (begin
                    (ci.intern-compat-state-capture-from-globals! intern-state)
                    (match macro-result
                      [(tc_core.ResultMacroExpand.Ok expanded expanded-paths)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-lower-profile-finish "macro_expand"))
                          (cfg
                            compile-profile
                            (compiler-lower-profile-pools
                              "macro_expand"
                              committed-macro-pools))
                          (let
                            [checked-detach? : bool
                              lower-checked-dest-pools-active]
                            [macro-changed? : bool
                              (tc_core.macro-expand-program-structurally-changed?)]
                            [retain-macro-source? : bool
                              (and checked-detach? (not macro-changed?))]
                            [detach-load-pools? : bool
                              (and checked-detach? macro-changed?)]
                            [_detach-profile-decision : unit
                              (cfg
                                compile-profile
                                (begin
                                  (compiler-lower-profile-counter
                                    "macro_detach.fast_path_hits"
                                    (if retain-macro-source?
                                      1
                                      0))
                                  (compiler-lower-profile-counter
                                    "macro_detach.fast_path_misses"
                                    (if detach-load-pools?
                                      1
                                      0))
                                  (compiler-lower-profile-counter
                                    "macro_detach.change_reasons"
                                    (tc_core.macro-expand-program-structural-change-reasons-value))))]
                            [_finalize-profile-start : unit
                              (if checked-detach?
                                (cfg
                                  compile-profile
                                  (compiler-lower-profile-start))
                                unit)]
                            [detached-compaction : ast.AstProgramCompaction
                              (if detach-load-pools?
                                (ast.ast-program-compact-with-pools
                                  committed-macro-pools
                                  (compiler-lower-checked-dest-pools-current)
                                  expanded)
                                (ast.AstProgramCompaction
                                  (if retain-macro-source?
                                    macro-program
                                    expanded)
                                  committed-macro-pools))]
                            [detached-program : ast.AstProgram
                              (match detached-compaction
                                [(ast.AstProgramCompaction out _) out])]
                            [detached-pools : ast.AstNodePoolContext
                              (match detached-compaction
                                [(ast.AstProgramCompaction _ out-pools)
                                  out-pools])]
                            [detached-entry-path : String
                              (if detach-load-pools?
                                (lower-copy-string-into-pools
                                  macro-entry-path
                                  detached-pools)
                                macro-entry-path)]
                            [detached-cache-scope : String
                              (if detach-load-pools?
                                (lower-copy-string-into-pools
                                  macro-cache-scope
                                  detached-pools)
                                macro-cache-scope)]
                            [detached-paths : ast.AstDeclPathList
                              (if detach-load-pools?
                                (lower-copy-paths-into-pools
                                  expanded-paths
                                  detached-pools)
                                (if retain-macro-source?
                                  macro-paths
                                  expanded-paths))]
                            [_clear-source-derived-caches : unit
                              (if checked-detach?
                                (lower-clear-macro-expanded-source-caches-into-pools!
                                  detached-pools)
                                unit)]
                            [_commit-detached-pools : unit
                              (cond
                                [detach-load-pools?
                                  (lower-checked-dest-pools-commit!
                                    detached-pools)]
                                [retain-macro-source?
                                  (lower-checked-dest-pools-retain-macro-source!
                                    detached-pools)]
                                [else unit])]
                            [committed-pools : ast.AstNodePoolContext
                              (if checked-detach?
                                (compiler-lower-checked-dest-pools-current)
                                detached-pools)]
                            [_disable-late-detach : unit
                              (if checked-detach?
                                (lower-checked-dest-pools-deactivate-after-commit!)
                                unit)]
                            [_finalize-profile-finish : unit
                              (if checked-detach?
                                (cfg
                                  compile-profile
                                  (compiler-lower-profile-finish
                                    "macro_finalize"))
                                unit)]
                            (lower-compiler-expanded-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-intern-state
                              load-state
                              prefix-cache
                              job-state
                              detached-entry-path
                              detached-program
                              detached-paths
                              mode
                              stdlib-roots
                              detached-cache-scope
                              committed-pools
                              source-names
                              intern-state)))]
                      [(tc_core.ResultMacroExpand.Err diag)
                        (begin
                          (cfg
                            compile-profile
                            (compiler-lower-profile-finish "macro_expand"))
                          (ResultCompilerLower.Err
                            (box
                              (cdiag.compiler-diagnostic-copy
                                (lower-diagnostic-with-path
                                  (box-get diag)
                                  macro-entry-path)))))])))))]
          [(spec.ResultGenProgramWithPaths.Err diag)
            (begin
              (cfg
                compile-profile
                (compiler-lower-profile-finish "macro_handoff"))
              (ResultCompilerLower.Err
                (box (lower-diagnostic-with-path (box-get diag) entry-path))))])))))

;; Serial/test compatibility adapter for callers that already provide the
;; explicit loader/prefix/job state but still rely on the active interner.
(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state-and-intern-state
    load-state
    prefix-cache
    job-state
    entry-path
    program
    paths
    mode
    stdlib-roots
    cache-scope
    pools
    source-names
    (ci.intern-compat-state-capture-active)))

;; Serial/test compatibility adapter. Driver-owned compilation uses the
;; explicit load-state entry above.
(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state
    (load.compiler-load-serial-test-session-state)
    (tc_core.tc-prefix-snapshot-serial-test-cache-state-shared-view)
    (tc_core.tc-serial-job-state)
    entry-path
    program
    paths
    mode
    stdlib-roots
    cache-scope
    pools
    source-names))

(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names
    entry-path
    program
    paths
    mode
    stdlib-roots
    cache-scope
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(define (lower-compiler-program-with-decl-paths-mode
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache
    entry-path
    program
    paths
    mode
    (svec.new)
    (tc_core.tc-prefix-default-cache-scope)))

(define (lower-compiler-program [program : ast.AstProgram]) : ResultCompilerLower
  (lower-compiler-program-with-path "<source>" program))

(define (lower-compiler-source [src : String]) : ResultCompilerLower
  (lower-compiler-source-with-path "<source>" src))

(define (lower-compiler-source-with-mode
  [src : String]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-source-with-path-mode "<source>" src mode))

(define (lower-source-decls-define-module?
  [decls : ast.AstDeclList]
  [module : String]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) false]
    [(ast.AstDeclListStep.Cons decl rest)
      (match decl
        [(ast.AstDecl.Module name)
          (if (string.eq (tc_core.tc-env-key-name-text name) module)
            true
            (lower-source-decls-define-module? rest module))]
        [_ (lower-source-decls-define-module? rest module)])]))

(define (lower-source-language-cfgs) : sym_i64_env.SymI64Env
  (begin
    (cbi.compiler-builtin-initialize-for-parse!)
    (cfg_core.compiler-cfg-empty)))

(define (lower-source-load [src : String]) : load.ResultCompilerLoadWithPaths
  (let
    [stdlib-roots : svec.Vec (svec.new)]
    [cfgs : sym_i64_env.SymI64Env (lower-source-language-cfgs)]
    (match (load.compiler-load-core-macro-prelude-with-roots-cfg
      (sym_i64_env.sym-i64-empty)
      stdlib-roots
      cfgs)
      [(load.ResultCompilerLoadWithPaths.Ok
          prelude-decls
          prelude-paths
          prelude-modules
          prelude-seen)
        (match (load.compiler-load-source-with-paths-and-roots-cfg
          ""
          src
          prelude-seen
          stdlib-roots
          cfgs)
          [(load.ResultCompilerLoadWithPaths.Ok
              entry-decls
              entry-paths
              entry-modules
              seen)
            (load.ResultCompilerLoadWithPaths.Ok
              (load.compiler-load-decl-list-append prelude-decls entry-decls)
              (load.compiler-load-decl-path-list-append
                prelude-paths
                entry-paths)
              (load.compiler-load-decl-module-list-append
                prelude-modules
                entry-modules)
              seen)]
          [(load.ResultCompilerLoadWithPaths.Err diagnostic)
            (load.ResultCompilerLoadWithPaths.Err diagnostic)])]
      [(load.ResultCompilerLoadWithPaths.Err diagnostic)
        (load.ResultCompilerLoadWithPaths.Err diagnostic)])))

(define (lower-source-stdlib-import-kind?
  [kind : ast.AstImportKind]
  [path : String]) : bool
  (match kind
    [(ast.AstImportKind.Module)
      (load.compiler-load-stdlib-import?
        (load.compiler-load-dotted-module-path path))]
    [_ false]))

(define (lower-source-stdlib-import-needs-loader?
  [all-decls : ast.AstDeclList]
  [kind : ast.AstImportKind]
  [path : String]) : bool
  (if (lower-source-stdlib-import-kind? kind path)
    (match kind
      [(ast.AstImportKind.Module)
        (not (lower-source-decls-define-module? all-decls path))]
      [_ true])
    false))

(define (lower-source-node-has-import-call?
  [pools : ast.AstNodePoolContext]
  [id : i64]) : bool
  (lower-source-expr-has-import-call?
    pools
    (ast.ast-node-pool-context-expr-get pools id)))

(define (lower-source-expr-list-has-import-call?
  [pools : ast.AstNodePoolContext]
  [exprs : ast.AstExprList]) : bool
  (lower-source-expr-list-has-import-call-at? pools (& exprs) 0))

(define (lower-source-expr-list-has-import-call-at?
  [pools : ast.AstNodePoolContext]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index (struct-get exprs len))
    false
    (or
      (lower-source-node-has-import-call?
        pools
        (ast.ast-expr-list-get exprs index 0))
      (lower-source-expr-list-has-import-call-at? pools exprs (+ index 1)))))

(define (lower-source-let-bindings-have-import-call?
  [pools : ast.AstNodePoolContext]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-source-let-bindings-have-import-call-at? pools (& bindings) 0))

(define (lower-source-let-bindings-have-import-call-at?
  [pools : ast.AstNodePoolContext]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (or
      (match (ast.ast-let-binding-list-get
        bindings
        binding-index
        (ast.ast-let-binding-fallback))
        [(ast.AstLetBinding.Binding _ _ init-box)
          (lower-source-node-has-import-call? pools init-box)])
      (lower-source-let-bindings-have-import-call-at?
        pools
        bindings
        (+ binding-index 1)))))

(define (lower-source-match-arms-have-import-call?
  [pools : ast.AstNodePoolContext]
  [arms : ast.AstMatchArmList]) : bool
  (lower-source-match-arms-have-import-call-at? pools (& arms) 0))

(define (lower-source-match-arms-have-import-call-at?
  [pools : ast.AstNodePoolContext]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (struct-get arms len))
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(ast.AstMatchArm.Arm _ body-box)
        (or
          (lower-source-node-has-import-call? pools body-box)
          (lower-source-match-arms-have-import-call-at? pools arms (+ index 1)))])))

(define (lower-source-resource-bindings-have-import-call?
  [pools : ast.AstNodePoolContext]
  [bindings : ast.AstResourceBindingList]) : bool
  (lower-source-resource-bindings-have-import-call-at? pools (& bindings) 0))

(define (lower-source-resource-bindings-have-import-call-at?
  [pools : ast.AstNodePoolContext]
  [bindings : (& bindings ast.AstResourceBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-resource-binding-list-len bindings))
    false
    (or
      (match (ast.ast-resource-binding-list-get
        bindings
        binding-index
        (ast.ast-resource-binding-fallback))
        [(ast.AstResourceBinding.Binding _ acquire-box cleanup-box _)
          (or
            (lower-source-node-has-import-call? pools acquire-box)
            (lower-source-node-has-import-call? pools cleanup-box))])
      (lower-source-resource-bindings-have-import-call-at?
        pools
        bindings
        (+ binding-index 1)))))

(define (lower-source-call-head-import?
  [pools : ast.AstNodePoolContext]
  [func-box : i64]) : bool
  (match (ast.ast-expr-unspan-with-pools
    pools
    (ast.ast-node-pool-context-expr-get pools func-box))
    [(ast.AstExpr.Var name) (= name cbi.compiler-builtin-id-fix-import)]
    [_ false]))

(define (lower-source-expr-has-import-call?
  [pools : ast.AstNodePoolContext]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(ast.AstExpr.Spanned inner-box _)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.Call func-box args)
      (or
        (lower-source-call-head-import? pools func-box)
        (lower-source-node-has-import-call? pools func-box)
        (lower-source-expr-list-has-import-call? pools args))]
    [(ast.AstExpr.BracketClause items)
      (lower-source-expr-list-has-import-call? pools items)]
    [(ast.AstExpr.Binary _ left-box right-box)
      (or
        (lower-source-node-has-import-call? pools left-box)
        (lower-source-node-has-import-call? pools right-box))]
    [(ast.AstExpr.Unary _ inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.If cond-box then-box else-box)
      (or
        (lower-source-node-has-import-call? pools cond-box)
        (lower-source-node-has-import-call? pools then-box)
        (lower-source-node-has-import-call? pools else-box))]
    [(ast.AstExpr.Let let-box)
      (match (box-get let-box)
        [(ast.AstLet.Let bindings body-box)
          (or
            (lower-source-let-bindings-have-import-call? pools bindings)
            (lower-source-node-has-import-call? pools body-box))])]
    [(ast.AstExpr.Lambda lambda-box)
      (match (box-get lambda-box)
        [(ast.AstLambda.Lambda _ _ body-box)
          (lower-source-node-has-import-call? pools body-box)])]
    [(ast.AstExpr.Tuple exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(ast.AstExpr.TupleRef tuple-box index-box)
      (or
        (lower-source-node-has-import-call? pools tuple-box)
        (lower-source-node-has-import-call? pools index-box))]
    [(ast.AstExpr.Array exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(ast.AstExpr.DynArray exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(ast.AstExpr.MakeArray _ len-box)
      (lower-source-node-has-import-call? pools len-box)]
    [(ast.AstExpr.ArrayRef array-box index-box)
      (or
        (lower-source-node-has-import-call? pools array-box)
        (lower-source-node-has-import-call? pools index-box))]
    [(ast.AstExpr.ArraySet array-box index-box value-box)
      (or
        (lower-source-node-has-import-call? pools array-box)
        (lower-source-node-has-import-call? pools index-box)
        (lower-source-node-has-import-call? pools value-box))]
    [(ast.AstExpr.ArrayPush array-box value-box)
      (or
        (lower-source-node-has-import-call? pools array-box)
        (lower-source-node-has-import-call? pools value-box))]
    [(ast.AstExpr.StringRef string-box index-box)
      (or
        (lower-source-node-has-import-call? pools string-box)
        (lower-source-node-has-import-call? pools index-box))]
    [(ast.AstExpr.While cond-box body-box)
      (or
        (lower-source-node-has-import-call? pools cond-box)
        (lower-source-node-has-import-call? pools body-box))]
    [(ast.AstExpr.Begin exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(ast.AstExpr.Unsafe exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(ast.AstExpr.Set _ rhs-box)
      (lower-source-node-has-import-call? pools rhs-box)]
    [(ast.AstExpr.Ann inner-box _)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.Cast inner-box _)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.Borrow _ _ inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.Match match-box)
      (match (box-get match-box)
        [(ast.AstMatch.Match scrutinee-box arms)
          (or
            (lower-source-node-has-import-call? pools scrutinee-box)
            (lower-source-match-arms-have-import-call? pools arms))])]
    [(ast.AstExpr.Foreach foreach-box)
      (match (box-get foreach-box)
        [(ast.AstForeach.Foreach _ _ start-box end-box body-box)
          (or
            (lower-source-node-has-import-call? pools start-box)
            (lower-source-node-has-import-call? pools end-box)
            (lower-source-node-has-import-call? pools body-box))])]
    [(ast.AstExpr.SpmdReduce reduce-box)
      (match (box-get reduce-box)
        [(ast.AstSpmdReduce.Reduce _ _ _ start-box end-box init-box value-box)
          (or
            (lower-source-node-has-import-call? pools start-box)
            (lower-source-node-has-import-call? pools end-box)
            (lower-source-node-has-import-call? pools init-box)
            (lower-source-node-has-import-call? pools value-box))])]
    [(ast.AstExpr.SpmdScan scan-box)
      (match (box-get scan-box)
        [(ast.AstSpmdScan.Scan
            _
            _
            _
            start-box
            end-box
            init-box
            _
            value-box
            body-box
            _)
          (or
            (lower-source-node-has-import-call? pools start-box)
            (lower-source-node-has-import-call? pools end-box)
            (lower-source-node-has-import-call? pools init-box)
            (lower-source-node-has-import-call? pools value-box)
            (lower-source-node-has-import-call? pools body-box))])]
    [(ast.AstExpr.SpmdBroadcast value-box lane-box)
      (or
        (lower-source-node-has-import-call? pools value-box)
        (lower-source-node-has-import-call? pools lane-box))]
    [(ast.AstExpr.SpmdShuffle value-box lane-box)
      (or
        (lower-source-node-has-import-call? pools value-box)
        (lower-source-node-has-import-call? pools lane-box))]
    [(ast.AstExpr.StructGet target-box _)
      (lower-source-node-has-import-call? pools target-box)]
    [(ast.AstExpr.StructSet target-box _ value-box)
      (or
        (lower-source-node-has-import-call? pools target-box)
        (lower-source-node-has-import-call? pools value-box))]
    [(ast.AstExpr.WithRegion _ exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(ast.AstExpr.WithEscape escape-box exprs)
      (or
        (lower-source-node-has-import-call? pools escape-box)
        (lower-source-expr-list-has-import-call? pools exprs))]
    [(ast.AstExpr.WithScratch exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [(ast.AstExpr.InArena arena-box exprs)
      (or
        (lower-source-node-has-import-call? pools arena-box)
        (lower-source-expr-list-has-import-call? pools exprs))]
    [(ast.AstExpr.WithResource resource-box)
      (match (box-get resource-box)
        [(ast.AstWithResource.WithResource bindings body)
          (or
            (lower-source-resource-bindings-have-import-call? pools bindings)
            (lower-source-expr-list-has-import-call? pools body))])]
    [(ast.AstExpr.Box inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.BoxGet inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.BoxTake inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.BoxSet inner-box value-box)
      (or
        (lower-source-node-has-import-call? pools inner-box)
        (lower-source-node-has-import-call? pools value-box))]
    [(ast.AstExpr.Comptime inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.Quote inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.Quasiquote inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.Unquote inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.UnquoteSplicing inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.Try inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.Return inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.PtrNullCheck inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.PtrRead inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.PtrWrite pointer-box value-box)
      (or
        (lower-source-node-has-import-call? pools pointer-box)
        (lower-source-node-has-import-call? pools value-box))]
    [(ast.AstExpr.PtrOffset pointer-box offset-box)
      (or
        (lower-source-node-has-import-call? pools pointer-box)
        (lower-source-node-has-import-call? pools offset-box))]
    [(ast.AstExpr.PtrCast inner-box _)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.PtrToInt inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.IntToPtr inner-box _)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.StringData inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.StringFromBytes data-box len-box)
      (or
        (lower-source-node-has-import-call? pools data-box)
        (lower-source-node-has-import-call? pools len-box))]
    [(ast.AstExpr.ArrayData inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.CpuIdEax left-box right-box)
      (or
        (lower-source-node-has-import-call? pools left-box)
        (lower-source-node-has-import-call? pools right-box))]
    [(ast.AstExpr.CpuIdEbx left-box right-box)
      (or
        (lower-source-node-has-import-call? pools left-box)
        (lower-source-node-has-import-call? pools right-box))]
    [(ast.AstExpr.CpuIdEcx left-box right-box)
      (or
        (lower-source-node-has-import-call? pools left-box)
        (lower-source-node-has-import-call? pools right-box))]
    [(ast.AstExpr.CpuIdEdx left-box right-box)
      (or
        (lower-source-node-has-import-call? pools left-box)
        (lower-source-node-has-import-call? pools right-box))]
    [(ast.AstExpr.Xgetbv inner-box)
      (lower-source-node-has-import-call? pools inner-box)]
    [(ast.AstExpr.Syscall exprs)
      (lower-source-expr-list-has-import-call? pools exprs)]
    [_ false]))

(define (lower-source-decl-needs-loader?
  [pools : ast.AstNodePoolContext]
  [decl : ast.AstDecl]
  [all-decls : ast.AstDeclList]) : bool
  (match decl
    [(ast.AstDecl.Import decl-meta (ast.AstImportSpec.Spec kind path _ _ _))
      (lower-source-stdlib-import-needs-loader? all-decls kind path)]
    [(ast.AstDecl.DefMacro decl-meta _ _ ret body-box)
      (and
        (tc_core.tc-macro-result-decl-emitting? ret)
        (lower-source-node-has-import-call? pools body-box))]
    [(ast.AstDecl.Unsafe inner-box)
      (lower-source-decl-needs-loader? pools (box-get inner-box) all-decls)]
    [_ false]))

(define (lower-source-decls-need-loader?
  [pools : ast.AstNodePoolContext]
  [decls : ast.AstDeclList]
  [all-decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(ast.AstDeclListStep.Nil) false]
    [(ast.AstDeclListStep.Cons decl rest)
      (or
        (lower-source-decl-needs-loader? pools decl all-decls)
        (lower-source-decls-need-loader? pools rest all-decls))]))

(define (lower-source-program-needs-loader? [program : ast.AstProgram]) : bool
  (match program
    [(ast.AstProgram.Program decls-box)
      (let
        [decls : ast.AstDeclList (box-get decls-box)]
        [pools : ast.AstNodePoolContext
          (ast.ast-node-pool-context-capture-active)]
        (lower-source-decls-need-loader? pools decls decls))]))

(define (lower-compiler-source-with-path-mode
  [path : String]
  [src : String]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (begin
    (when
      (lower-resetting-entry-in-live-session?)
      (return
        (lower-resetting-entry-live-session-error
          "lower-compiler-source-with-path-mode"
          path)))
    ;; Each standalone single-source compile (smoke self-tests, emit-source,
    ;; check tools) runs in a fresh arena, so interned name strings from a
    ;; previous compile are freed. Reset the persistent intern table here so a
    ;; later compile never probes a dangling key. The multi-file driver compiles
    ;; through the loader, not this entry, so cli.tl's fixpoint is unaffected.
    (lower-reset-file-state!)
    (tc_core.compiler-typecheck-reset-file-state!)
    (ci.intern-reset!)
    (lower-reset-intern-owned-state!)
    (cbi.compiler-builtin-reset!)
    (match (parser.parse-ast-source src)
      [(parser.ResultAstProgram.Ok program)
        (if (lower-source-program-needs-loader? program)
          (let
            [stdlib-roots : svec.Vec (svec.new)]
            [cfgs : sym_i64_env.SymI64Env (lower-source-language-cfgs)]
            (match (lower-source-load src)
              [(load.ResultCompilerLoadWithPaths.Ok decls paths _ _)
                (lower-compiler-program-with-decl-paths-mode-cache
                  path
                  (ast.ast-program decls)
                  paths
                  mode
                  stdlib-roots
                  (load.compiler-load-prelude-cache-key
                    "typecheck-prefix-lower"
                    stdlib-roots
                    cfgs))]
              [(load.ResultCompilerLoadWithPaths.Err diag)
                (ResultCompilerLower.Err diag)]))
          (lower-compiler-program-with-path-mode path program mode))]
      [(parser.ResultAstProgram.Err message)
        (ResultCompilerLower.Err
          (box (lower-diagnostic-with-path (lower-diagnostic message) path)))])))

(define (lower-compiler-source-with-path [path : String] [src : String]) : ResultCompilerLower
  (lower-compiler-source-with-path-mode path src (CompilerLowerMode.Scalar)))