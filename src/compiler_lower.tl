  (LowerSomeArgWriteback LowerArgWriteback))

(defenum LowerCallArg
  (LowerCallArg LowerState CompilerIrValue LowerMaybeArgWriteback))

(defenum ResultLowerCallArg
  (OkLowerCallArg LowerCallArg)
