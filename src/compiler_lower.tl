            (+ arm-index 1)))])))

(define (lower-masked-vector-body-has-varying-enum-match?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [expr : ast.AstExpr]) : bool
  (let
    [enum-locals (lower-id-set-empty)]
    (lower-masked-vector-body-has-varying-enum-match-with-locals?
      ctx
      env
      type-env
      index
      enum-locals
      expr)))

(define (lower-masked-vector-bool-array-lane?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [arr : ast.AstExpr]
  [idx : ast.AstExpr]) : bool
  (if (>= (lower-masked-vector-index-offset ctx index idx) 0)
    (match (lower-contiguous-sequence-var ctx env type-env arr)
      [(Some _ elem-ty) (lower-type-bool? elem-ty)]
      [(No) false])
    false))

(define (lower-masked-vector-body-has-bool-array-lane?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          inner))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          inner))]
    [(Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          inner))]
    [(Unary _ inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          inner))]
    [(Binary _ left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (or
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            left)
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            right)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (or
              (lower-masked-vector-let-bindings-have-bool-array-lane?
                ctx
                env
                type-env
                index
                bindings)
              (lower-masked-vector-body-has-bool-array-lane?
                ctx
                env
                type-env
                index
                body)))])]
    [(If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (or
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            cond)
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            then-branch)
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            else-branch)))]
    [(While cond-box body-box)
      (or
        (lower-masked-vector-body-has-bool-array-lane?
          ctx
          env
          type-env
          index
          (lower-context-expr-get ctx cond-box))
        (lower-masked-vector-expr-list-has-bool-array-lane?
          ctx
          env
          type-env
          index
          body-box))]
    [(Begin exprs)
      (lower-masked-vector-expr-list-has-bool-array-lane?
        ctx
        env
        type-env
        index
        exprs)]
    [(ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (lower-masked-vector-bool-array-lane? ctx env type-env index arr idx))]
    [(ArraySet arr-box idx-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-masked-vector-bool-array-lane? ctx env type-env index arr idx)
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            value)))]
    [(StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (or
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            receiver)
          (lower-masked-vector-body-has-bool-array-lane?
            ctx
            env
            type-env
            index
            value)))]
    [_ false]))

(define (lower-masked-vector-expr-list-has-bool-array-lane?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [exprs : ast.AstExprList]) : bool
  (lower-masked-vector-expr-list-has-bool-array-lane-at?
    ctx
    env
    type-env
    index
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-has-bool-array-lane-at?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : bool
  (if (>= expr-index exprs.len)
    false
    (or
      (lower-masked-vector-body-has-bool-array-lane?
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0)))
      (lower-masked-vector-expr-list-has-bool-array-lane-at?
        ctx
        env
        type-env
        index
        exprs
        (+ expr-index 1)))))

(define (lower-masked-vector-let-bindings-have-bool-array-lane?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-masked-vector-let-bindings-have-bool-array-lane-at?
    ctx
    env
    type-env
    index
    (& bindings)
    0))

(define (lower-masked-vector-let-bindings-have-bool-array-lane-at?
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          (or
            (lower-masked-vector-body-has-bool-array-lane?
              ctx
              env
              type-env
              index
              init)
            (lower-masked-vector-let-bindings-have-bool-array-lane-at?
              ctx
              env
              type-env
              index
              bindings
              (+ binding-index 1))))])))

;; The calls an SPMD body's strategy depends on: a call to an SPMD helper that
;; stays out of line (an imported callable, or a helper whose body needs its
;; own frame), or a call that reaches an atomic.
(defenum LowerSpmdCallProbe
  (OutOfLine)
  (Atomic))

;; Whether `expr` holds a call `probe` looks for. Both probes descend the same
;; scalar, let, begin and array forms; an atomic call is also looked for in
;; struct stores and inside the callee expression and the helper bodies it
;; inlines.
(define (lower-spmd-expr-has-call?
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [probe : LowerSpmdCallProbe]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(Spanned inner-box _)
      (lower-spmd-expr-has-call?
        ctx
        function-state
        env
        type-env
        probe
        (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-spmd-expr-has-call?
        ctx
        function-state
        env
        type-env
        probe
        (lower-context-expr-get ctx inner-box))]
    [(Cast inner-box _)
      (lower-spmd-expr-has-call?
        ctx
        function-state
        env
        type-env
        probe
        (lower-context-expr-get ctx inner-box))]
    [(Unary _ inner-box)
      (lower-spmd-expr-has-call?
        ctx
        function-state
        env
        type-env
        probe
        (lower-context-expr-get ctx inner-box))]
    [(Binary _ left-box right-box)
      (or
        (lower-spmd-expr-has-call?
          ctx
          function-state
          env
          type-env
          probe
          (lower-context-expr-get ctx left-box))
        (lower-spmd-expr-has-call?
          ctx
          function-state
          env
          type-env
          probe
          (lower-context-expr-get ctx right-box)))]
    [(Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (or
          (match probe
            [(OutOfLine)
              (match (lower-spmd-inline-helper-lookup
                ctx
                function-state
                env
                type-env
                (lower-id-set-empty)
                func)
                [(Ok helper)
                  (match helper
                    [(Some _ _ _ body)
                      (lower-spmd-helper-out-of-line? ctx body)]
                    [(Imported _ _ _ _ _) true]
                    [(No) false])]
                [(Err _) false])]
            [(Atomic)
              (or
                (>
                  (string.string-length
                    (lower-atomic-extern-symbol-for-func
                      (compiler-lower-function-state-owner function-state)
                      ctx
                      type-env
                      (lower-global-shared-view func)))
                  0)
                (lower-atomic-pointer-func?
                  type-env
                  (lower-global-shared-view func))
                (lower-vector-call-target-has-atomic?
                  ctx
                  function-state
                  env
                  type-env
                  (lower-global-shared-view func))
                (lower-spmd-expr-has-call?
                  ctx
                  function-state
                  env
                  type-env
                  probe
                  func))])
          (lower-spmd-expr-list-has-call-at?
            ctx
            function-state
            env
            type-env
            probe
            (& args)
            0)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (or
            (lower-spmd-let-bindings-have-call-at?
              ctx
              function-state
              env
              type-env
              probe
              (& bindings)
              0)
            (lower-spmd-expr-has-call?
              ctx
              function-state
              env
              type-env
              probe
              (lower-context-expr-get ctx body-box)))])]
    [(If cond-box then-box else-box)
      (or
        (lower-spmd-expr-has-call?
          ctx
          function-state
          env
          type-env
          probe
          (lower-context-expr-get ctx cond-box))
        (lower-spmd-expr-has-call?
          ctx
          function-state
          env
          type-env
          probe
          (lower-context-expr-get ctx then-box))
        (lower-spmd-expr-has-call?
          ctx
          function-state
          env
          type-env
          probe
          (lower-context-expr-get ctx else-box)))]
    [(Begin exprs)
      (lower-spmd-expr-list-has-call-at?
        ctx
        function-state
        env
        type-env
        probe
        (& exprs)
        0)]
    [(ArrayRef array-box index-box)
      (or
        (lower-spmd-expr-has-call?
          ctx
          function-state
          env
          type-env
          probe
          (lower-context-expr-get ctx array-box))
        (lower-spmd-expr-has-call?
          ctx
          function-state
          env
          type-env
          probe
          (lower-context-expr-get ctx index-box)))]
    [(ArraySet array-box index-box value-box)
      (or
        (lower-spmd-expr-has-call?
          ctx
          function-state
          env
          type-env
          probe
          (lower-context-expr-get ctx array-box))
        (lower-spmd-expr-has-call?
          ctx
          function-state
          env
          type-env
          probe
          (lower-context-expr-get ctx index-box))
        (lower-spmd-expr-has-call?
          ctx
          function-state
          env
          type-env
          probe
          (lower-context-expr-get ctx value-box)))]
    [(StructSet receiver-box _ value-box)
      (match probe
        [(Atomic)
          (or
            (lower-spmd-expr-has-call?
              ctx
              function-state
              env
              type-env
              probe
              (lower-context-expr-get ctx receiver-box))
            (lower-spmd-expr-has-call?
              ctx
              function-state
              env
              type-env
              probe
              (lower-context-expr-get ctx value-box)))]
        [(OutOfLine) false])]
    [_ false]))

(define (lower-spmd-expr-list-has-call-at?
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [probe : LowerSpmdCallProbe]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (or
      (lower-spmd-expr-has-call?
        ctx
        function-state
        env
        type-env
        probe
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      (lower-spmd-expr-list-has-call-at?
        ctx
        function-state
        env
        type-env
        probe
        exprs
        (+ index 1)))))

(define (lower-spmd-let-bindings-have-call-at?
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [probe : LowerSpmdCallProbe]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ init-box)
        (or
          (lower-spmd-expr-has-call?
            ctx
            function-state
            env
            type-env
            probe
            (lower-context-expr-get ctx init-box))
          (lower-spmd-let-bindings-have-call-at?
            ctx
            function-state
            env
            type-env
            probe
            bindings
            (+ binding-index 1)))])))

;; What a foreach body holds that only the masked SPMD strategy lowers, computed
;; once per body: the masked strategy is chosen on these facts, and when it
;; cannot lower the body the fallback diagnostic names the first that holds.
(defstruct LowerMaskedVectorFacts
  (varying-if bool)
  (varying-while bool)
  (varying-match bool)
  (varying-enum-match bool)
  (bool-array-lane bool)
  (out-of-line-call bool))

(define (lower-masked-vector-facts
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [body : ast.AstExpr]) : LowerMaskedVectorFacts
  (let
    [varying-if : bool
      (lower-masked-vector-body-has-varying?
        ctx
        function-state
        mode
        env
        type-env
        (If)
        (lower-global-shared-view index)
        (lower-global-shared-view body))]
    [varying-while : bool
      (lower-masked-vector-body-has-varying?
        ctx
        function-state
        mode
        env
        type-env
        (While)
        (lower-global-shared-view index)
        (lower-global-shared-view body))]
    [varying-match : bool
      (lower-masked-vector-body-has-varying?
        ctx
        function-state
        mode
        env
        type-env
        (Match)
        (lower-global-shared-view index)
        (lower-global-shared-view body))]
    [varying-enum-match : bool
      (lower-masked-vector-body-has-varying-enum-match?
        ctx
        env
        type-env
        index
        (lower-global-shared-view body))]
    [bool-array-lane : bool
      (lower-masked-vector-body-has-bool-array-lane?
        ctx
        env
        type-env
        index
        (lower-global-shared-view body))]
    (LowerMaskedVectorFacts
      varying-if
      varying-while
      varying-match
      varying-enum-match
      bool-array-lane
      (lower-spmd-expr-has-call?
        ctx
        function-state
        env
        type-env
        (OutOfLine)
        body))))

(define (lower-masked-vector-map
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [body : ast.AstExpr]
  [facts : LowerMaskedVectorFacts]) : LowerMaybeMaskedVectorMap
  (if (and
    (lower-mode-simd? mode)
    (or
      facts.varying-if
      facts.varying-while
      facts.varying-match
      facts.varying-enum-match
      facts.bool-array-lane
      facts.out-of-line-call))
    (let
      [lanes : i64
        (lower-masked-vector-expr-lanes
          ctx
          function-state
          mode
          env
          type-env
          index
          body)]
      (if (> lanes 0)
        (Some lanes)
        (No)))
    (No)))

(define (lower-masked-vector-array-vars
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [expr : ast.AstExpr]) : LowerArrayVarSet
  (match expr
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(Unary _ inner-box)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-masked-vector-array-vars ctx env type-env index inner))]
    [(Binary _ left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars ctx env type-env index left)
          (lower-masked-vector-array-vars ctx env type-env index right)))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (lower-array-var-set-merge
              (lower-masked-vector-let-binding-array-vars
                ctx
                env
                type-env
                index
                bindings)
              (lower-masked-vector-array-vars ctx env type-env index body)))])]
    [(If cond-box then-box else-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars ctx env type-env index cond)
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars ctx env type-env index then-branch)
            (lower-masked-vector-array-vars ctx env type-env index else-branch))))]
    [(While cond-box body-box)
      (lower-array-var-set-merge
        (lower-masked-vector-array-vars
          ctx
          env
          type-env
          index
          (lower-context-expr-get ctx cond-box))
        (lower-masked-vector-expr-list-array-vars
          ctx
          env
          type-env
          index
          body-box))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars
              ctx
              env
              type-env
              index
              (lower-context-expr-get ctx scrutinee-box))
            (lower-masked-vector-match-arms-array-vars
              ctx
              env
              type-env
              index
              arms))])]
    [(Begin exprs)
      (lower-masked-vector-expr-list-array-vars ctx env type-env index exprs)]
    [(ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [idx-offset : i64 (lower-masked-vector-index-offset ctx index idx)]
        (if (>= idx-offset 0)
          (match (lower-contiguous-sequence-var ctx env type-env arr)
            [(Some var _)
              (lower-array-var-set-add
                (lower-array-var-set-empty)
                var
                idx-offset)]
            [(No) (lower-array-var-set-empty)])
          (lower-array-var-set-empty)))]
    [(ArraySet arr-box idx-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [idx-offset : i64 (lower-masked-vector-index-offset ctx index idx)]
        (lower-array-var-set-merge
          (if (>= idx-offset 0)
            (match (lower-contiguous-sequence-var ctx env type-env arr)
              [(Some var _)
                (lower-array-var-set-add
                  (lower-array-var-set-empty)
                  var
                  idx-offset)]
              [(No) (lower-array-var-set-empty)])
            (lower-array-var-set-empty))
          (lower-masked-vector-array-vars ctx env type-env index value)))]
    [(StructSet receiver-box _ value-box)
      (let
        [receiver : ast.AstExpr (lower-context-expr-get ctx receiver-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars ctx env type-env index receiver)
          (lower-masked-vector-array-vars ctx env type-env index value)))]
    [_ (lower-array-var-set-empty)]))

(define (lower-masked-vector-expr-list-array-vars
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [exprs : ast.AstExprList]) : LowerArrayVarSet
  (lower-masked-vector-expr-list-array-vars-at
    ctx
    env
    type-env
    index
    (& exprs)
    0))

(define (lower-masked-vector-expr-list-array-vars-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : LowerArrayVarSet
  (if (>= expr-index exprs.len)
    (lower-array-var-set-empty)
    (lower-array-var-set-merge
      (lower-masked-vector-array-vars
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0)))
      (lower-masked-vector-expr-list-array-vars-at
        ctx
        env
        type-env
        index
        exprs
        (+ expr-index 1)))))

(define (lower-masked-vector-match-arms-array-vars
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [arms : ast.AstMatchArmList]) : LowerArrayVarSet
  (lower-masked-vector-match-arms-array-vars-at
    ctx
    env
    type-env
    index
    (& arms)
    0))

(define (lower-masked-vector-match-arms-array-vars-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [arms : (& arms ast.AstMatchArmList)]
  [arm-index : i64]) : LowerArrayVarSet
  (if (>= arm-index arms.len)
    (lower-array-var-set-empty)
    (match (ast.ast-match-arm-list-get
      arms
      arm-index
      (ast.ast-match-arm-fallback))
      [(Arm _ body-box)
        (lower-array-var-set-merge
          (lower-masked-vector-array-vars
            ctx
            env
            type-env
            index
            (lower-context-expr-get ctx body-box))
          (lower-masked-vector-match-arms-array-vars-at
            ctx
            env
            type-env
            index
            arms
            (+ arm-index 1)))])))

(define (lower-masked-vector-let-binding-array-vars
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [bindings : ast.AstLetBindingList]) : LowerArrayVarSet
  (lower-masked-vector-let-binding-array-vars-at
    ctx
    env
    type-env
    index
    (& bindings)
    0))

(define (lower-masked-vector-let-binding-array-vars-at
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : LowerArrayVarSet
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    (lower-array-var-set-empty)
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          (lower-array-var-set-merge
            (lower-masked-vector-array-vars ctx env type-env index init)
            (lower-masked-vector-let-binding-array-vars-at
              ctx
              env
              type-env
              index
              bindings
              (+ binding-index 1))))])))

(define (lower-masked-vector-let-binding-names
  [bindings : ast.AstLetBindingList]
  [lane-locals : LowerIdSet]) : LowerIdSet
  (lower-masked-vector-let-binding-names-at (& bindings) lane-locals 0))

(define (lower-masked-vector-let-binding-names-at
  [bindings : (& bindings ast.AstLetBindingList)]
  [lane-locals : LowerIdSet]
  [binding-index : i64]) : LowerIdSet
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    lane-locals
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding name _ _)
        (lower-masked-vector-let-binding-names-at
          bindings
          (lower-id-set-insert lane-locals name)
          (+ binding-index 1))])))

;; What the SPMD fallback diagnostics look for in a vector body: an array
;; element read, or an SPMD shuffle.
(defenum LowerVectorBodyProbe
  (ArrayRead)
  (Shuffle))

;; Whether `expr` holds what `probe` looks for. Both probes descend the same
;; scalar, let, begin, call and store forms; an array read is found at an
;; ArrayRef and is also looked for inside matches, while a shuffle is found at a
;; SpmdShuffle and is looked for inside ArrayRef and SpmdBroadcast operands.
(define (lower-vector-body-has?
  [ctx : tc_core.TcContext]
  [probe : LowerVectorBodyProbe]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(Spanned inner-box _)
      (lower-vector-body-has? ctx probe (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-vector-body-has? ctx probe (lower-context-expr-get ctx inner-box))]
    [(Cast inner-box _)
      (lower-vector-body-has? ctx probe (lower-context-expr-get ctx inner-box))]
    [(Unary _ inner-box)
      (lower-vector-body-has? ctx probe (lower-context-expr-get ctx inner-box))]
    [(ArrayRef arr-box idx-box)
      (match probe
        [(ArrayRead) true]
        [(Shuffle)
          (or
            (lower-vector-body-has?
              ctx
              probe
              (lower-context-expr-get ctx arr-box))
            (lower-vector-body-has?
              ctx
              probe
              (lower-context-expr-get ctx idx-box)))])]
    [(SpmdShuffle _ _)
      (match probe
        [(Shuffle) true]
        [(ArrayRead) false])]
    [(SpmdBroadcast value-box lane-box)
      (match probe
        [(Shuffle)
          (or
            (lower-vector-body-has?
              ctx
              probe
              (lower-context-expr-get ctx value-box))
            (lower-vector-body-has?
              ctx
              probe
              (lower-context-expr-get ctx lane-box)))]
        [(ArrayRead) false])]
    [(Binary _ left-box right-box)
      (or
        (lower-vector-body-has? ctx probe (lower-context-expr-get ctx left-box))
        (lower-vector-body-has?
          ctx
          probe
          (lower-context-expr-get ctx right-box)))]
    [(If cond-box then-box else-box)
      (or
        (lower-vector-body-has? ctx probe (lower-context-expr-get ctx cond-box))
        (lower-vector-body-has? ctx probe (lower-context-expr-get ctx then-box))
        (lower-vector-body-has? ctx probe (lower-context-expr-get ctx else-box)))]
    [(Match match-box)
      (match probe
        [(ArrayRead)
          (match (__tl-box-place match-box)
            [(Match scrutinee-box arms)
              (or
                (lower-vector-body-has?
                  ctx
                  probe
                  (lower-context-expr-get ctx scrutinee-box))
                (lower-vector-match-arms-have-at? ctx probe (& arms) 0))])]
        [(Shuffle) false])]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (or
            (lower-vector-let-bindings-have-at? ctx probe (& bindings) 0)
            (lower-vector-body-has?
              ctx
              probe
              (lower-context-expr-get ctx body-box)))])]
    [(Begin exprs) (lower-vector-expr-list-has-at? ctx probe (& exprs) 0)]
    [(Call func-box args)
      (or
        (lower-vector-body-has? ctx probe (lower-context-expr-get ctx func-box))
        (lower-vector-expr-list-has-at? ctx probe (& args) 0))]
    [(ArraySet arr-box idx-box value-box)
      (or
        (lower-vector-body-has? ctx probe (lower-context-expr-get ctx arr-box))
        (lower-vector-body-has? ctx probe (lower-context-expr-get ctx idx-box))
        (lower-vector-body-has?
          ctx
          probe
          (lower-context-expr-get ctx value-box)))]
    [(StructSet receiver-box _ value-box)
      (or
        (lower-vector-body-has?
          ctx
          probe
          (lower-context-expr-get ctx receiver-box))
        (lower-vector-body-has?
          ctx
          probe
          (lower-context-expr-get ctx value-box)))]
    [_ false]))

(define (lower-vector-match-arms-have-at?
  [ctx : tc_core.TcContext]
  [probe : LowerVectorBodyProbe]
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index arms.len)
    false
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm _ body-box)
        (or
          (lower-vector-body-has?
            ctx
            probe
            (lower-context-expr-get ctx body-box))
          (lower-vector-match-arms-have-at? ctx probe arms (+ index 1)))])))

(define (lower-vector-expr-list-has-at?
  [ctx : tc_core.TcContext]
  [probe : LowerVectorBodyProbe]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (or
      (lower-vector-body-has?
        ctx
        probe
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      (lower-vector-expr-list-has-at? ctx probe exprs (+ index 1)))))

(define (lower-vector-let-bindings-have-at?
  [ctx : tc_core.TcContext]
  [probe : LowerVectorBodyProbe]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding _ _ init-box)
        (or
          (lower-vector-body-has?
            ctx
            probe
            (lower-context-expr-get ctx init-box))
          (lower-vector-let-bindings-have-at?
            ctx
            probe
            bindings
            (+ binding-index 1)))])))

(define (lower-vector-call-target-has-atomic?
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]) : bool
  (match (lower-spmd-inline-helper-lookup
    ctx
    function-state
    env
    type-env
    (lower-id-set-empty)
    func)
    [(Ok helper)
      (match helper
        [(Some name _ _ body)
          (if (let
            [helper-stack
              (compiler-lower-function-state-inline-helper-stack function-state)]
            (lower-id-set-contains? helper-stack name))
            false
            (let
              [previous : LowerIdSet
                (compiler-lower-function-state-inline-helper-stack
                  function-state)]
              [result : bool false]
              (compiler-lower-function-state-inline-helper-stack-set!
                function-state
                (lower-id-set-insert (lower-global-shared-view previous) name))
              (set!
                result
                (lower-spmd-expr-has-call?
                  ctx
                  function-state
                  env
                  type-env
                  (Atomic)
                  body))
              (compiler-lower-function-state-inline-helper-stack-set!
                function-state
                previous)
              result))]
        [(Imported _ _ _ _ _) false]
        [(No) false])]
    [(Err _) false]))

(defenum LowerMaybeSpmdNumericFailure
  (No)
  (Some ast.AstExpr spmd_numeric.CompilerSpmdNumericDecision))

(define (lower-spmd-numeric-failure-in-expr-list-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [numeric-context : spmd_numeric.CompilerSpmdNumericContext]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : LowerMaybeSpmdNumericFailure
  (if (>= index exprs.len)
    (No)
    (match (lower-spmd-numeric-failure
      ctx
      function-state
      mode
      env
      type-env
      numeric-context
      (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      [(Some origin decision) (Some origin decision)]
      [(No)
        (lower-spmd-numeric-failure-in-expr-list-at
          ctx
          function-state
          mode
          env
          type-env
          numeric-context
          exprs
          (+ index 1))])))

(define (lower-spmd-numeric-failure-in-expr-list
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [numeric-context : spmd_numeric.CompilerSpmdNumericContext]
  [exprs : ast.AstExprList]) : LowerMaybeSpmdNumericFailure
  (lower-spmd-numeric-failure-in-expr-list-at
    ctx
    function-state
    mode
    env
    type-env
    numeric-context
    (& exprs)
    0))

(define (lower-spmd-numeric-failure-in-let-bindings-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [numeric-context : spmd_numeric.CompilerSpmdNumericContext]
  [bindings : (& bindings ast.AstLetBindingList)]
  [index : i64]) : LowerMaybeSpmdNumericFailure
  (if (>= index (ast.ast-let-binding-list-len bindings))
    (No)
    (match (ast.ast-let-binding-list-get
      bindings
      index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (match (lower-spmd-numeric-failure
          ctx
          function-state
          mode
          env
          type-env
          numeric-context
          (lower-context-expr-get ctx init-box))
          [(Some origin decision) (Some origin decision)]
          [(No)
            (match (tc_core.tc-expr
              ctx
              type-env
              (lower-context-expr-get ctx init-box))
              [(Ok init-ty)
                (lower-spmd-numeric-failure-in-let-bindings-at
                  ctx
                  function-state
                  mode
                  env
                  (tc_core.tc-bind-id
                    type-env
                    name
                    (lower-let-binding-type ctx maybe-ty init-ty))
                  numeric-context
                  bindings
                  (+ index 1))]
              [(Err _)
                (lower-spmd-numeric-failure-in-let-bindings-at
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  numeric-context
                  bindings
                  (+ index 1))])])])))

(define (lower-spmd-numeric-failure-in-let-bindings
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [numeric-context : spmd_numeric.CompilerSpmdNumericContext]
  [bindings : (& bindings ast.AstLetBindingList)]) : LowerMaybeSpmdNumericFailure
  (lower-spmd-numeric-failure-in-let-bindings-at
    ctx
    function-state
    mode
    env
    type-env
    numeric-context
    (& bindings)
    0))

(define (lower-spmd-numeric-failure-first
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [numeric-context : spmd_numeric.CompilerSpmdNumericContext]
  [first : ast.AstExpr]
  [second : ast.AstExpr]) : LowerMaybeSpmdNumericFailure
  (match (lower-spmd-numeric-failure
    ctx
    function-state
    mode
    env
    type-env
    numeric-context
    first)
    [(Some origin decision) (Some origin decision)]
    [(No)
      (lower-spmd-numeric-failure
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        second)]))

(define (lower-spmd-numeric-failure-node
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [numeric-context : spmd_numeric.CompilerSpmdNumericContext]
  [origin : ast.AstExpr]
  [expr : ast.AstExpr]) : LowerMaybeSpmdNumericFailure
  (match expr
    [(Binary op left-box right-box)
      (let
        [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
        [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
        (match (tc_core.tc-expr ctx type-env (lower-global-shared-view left))
          [(Ok source-ty)
            (let
              [source : ast.AstType
                (tc_core.tc-type-without-regions
                  (tc_core.tc-resolve-type ctx source-ty))]
              [source-lane : spmd_numeric.CompilerSpmdNumericLane
                (spmd_numeric.compiler-spmd-numeric-lane
                  (lower-global-shared-view source))]
              [decision : spmd_numeric.CompilerSpmdNumericDecision
                (spmd_numeric.compiler-spmd-numeric-binary-decision
                  (lower-global-shared-view source)
                  (if (spmd_numeric.compiler-spmd-numeric-comparison-op? op)
                    (Bool)
                    source)
                  numeric-context
                  (lower-spmd-numeric-backend mode)
                  op)]
              (if (and
                (spmd_numeric.compiler-spmd-numeric-lane? source-lane)
                (not
                  (spmd_numeric.compiler-spmd-numeric-decision-supported?
                    decision)))
                (Some origin decision)
                (lower-spmd-numeric-failure-first
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  numeric-context
                  left
                  right)))]
          [(Err _)
            (lower-spmd-numeric-failure-first
              ctx
              function-state
              mode
              env
              type-env
              numeric-context
              left
              right)]))]
    [(Cast inner-box cast-ty-id)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        [destination : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx cast-ty-id)))]
        (if (or
          (tc_core.tc-integer-literal-expr?
            ctx
            (lower-global-shared-view inner))
          (tc_core.tc-float-literal-expr? ctx (lower-global-shared-view inner)))
          (No)
          (match (tc_core.tc-expr ctx type-env (lower-global-shared-view inner))
            [(Ok source-ty)
              (let
                [source : ast.AstType
                  (tc_core.tc-type-without-regions
                    (tc_core.tc-resolve-type ctx source-ty))]
                [decision : spmd_numeric.CompilerSpmdNumericDecision
                  (spmd_numeric.compiler-spmd-numeric-conversion-decision
                    (lower-global-shared-view source)
                    (lower-global-shared-view destination)
                    numeric-context
                    (lower-spmd-numeric-backend mode))]
                (if (and
                  (spmd_numeric.compiler-spmd-numeric-lane?
                    (spmd_numeric.compiler-spmd-numeric-lane source))
                  (spmd_numeric.compiler-spmd-numeric-lane?
                    (spmd_numeric.compiler-spmd-numeric-lane destination))
                  (not
                    (spmd_numeric.compiler-spmd-numeric-decision-supported?
                      decision)))
                  (Some origin decision)
                  (lower-spmd-numeric-failure
                    ctx
                    function-state
                    mode
                    env
                    type-env
                    numeric-context
                    inner)))]
            [(Err _) (No)])))]
    [(Ann inner-box _)
      (lower-spmd-numeric-failure
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        (lower-context-expr-get ctx inner-box))]
    [(Unary _ inner-box)
      (lower-spmd-numeric-failure
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        (lower-context-expr-get ctx inner-box))]
    [(ArrayRef array-box index-box)
      (lower-spmd-numeric-failure-first
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        (lower-context-expr-get ctx array-box)
        (lower-context-expr-get ctx index-box))]
    [(ArraySet array-box index-box value-box)
      (match (lower-spmd-numeric-failure
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        (lower-context-expr-get ctx value-box))
        [(Some found decision) (Some found decision)]
        [(No)
          (lower-spmd-numeric-failure-first
            ctx
            function-state
            mode
            env
            type-env
            numeric-context
            (lower-context-expr-get ctx array-box)
            (lower-context-expr-get ctx index-box))])]
    [(If condition-box then-box else-box)
      (let
        [masked : spmd_numeric.CompilerSpmdNumericContext (MaskedControl)]
        (match (lower-spmd-numeric-failure
          ctx
          function-state
          mode
          env
          type-env
          masked
          (lower-context-expr-get ctx condition-box))
          [(Some found decision) (Some found decision)]
          [(No)
            (lower-spmd-numeric-failure-first
              ctx
              function-state
              mode
              env
              type-env
              masked
              (lower-context-expr-get ctx then-box)
              (lower-context-expr-get ctx else-box))]))]
    [(While condition-box body-box)
      (lower-spmd-numeric-failure-first
        ctx
        function-state
        mode
        env
        type-env
        (MaskedControl)
        (lower-context-expr-get ctx condition-box)
        (Begin body-box))]
    [(Begin exprs)
      (lower-spmd-numeric-failure-in-expr-list
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        exprs)]
    [(Unsafe exprs)
      (lower-spmd-numeric-failure-in-expr-list
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        exprs)]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (match (lower-spmd-numeric-failure-in-let-bindings
            ctx
            function-state
            mode
            env
            type-env
            numeric-context
            bindings)
            [(Some found decision) (Some found decision)]
            [(No)
              (lower-spmd-numeric-failure
                ctx
                function-state
                mode
                env
                (lower-spmd-numeric-let-type-env ctx type-env bindings)
                numeric-context
                (lower-context-expr-get ctx body-box))])])]
    [(Call func-box args)
      (let
        [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
        (match (lower-spmd-inline-helper-lookup
          ctx
          function-state
          env
          type-env
          (lower-id-set-empty)
          func)
          [(Ok helper)
            (match helper
              [(Some name params _ body)
                (if (let
                  [helper-stack
                    (compiler-lower-function-state-inline-helper-stack
                      function-state)]
                  (lower-id-set-contains? helper-stack name))
                  (lower-spmd-numeric-failure-in-expr-list
                    ctx
                    function-state
                    mode
                    env
                    type-env
                    numeric-context
                    args)
                  (let
                    [previous : LowerIdSet
                      (compiler-lower-function-state-inline-helper-stack
                        function-state)]
                    [helper-context : spmd_numeric.CompilerSpmdNumericContext
                      (if (lower-spmd-helper-out-of-line?
                        ctx
                        (lower-global-shared-view body))
                        (PrivateHelper)
                        (InlineHelper))]
                    [result : LowerMaybeSpmdNumericFailure (No)]
                    (compiler-lower-function-state-inline-helper-stack-set!
                      function-state
                      (lower-id-set-insert
                        (lower-global-shared-view previous)
                        name))
                    (set!
                      result
                      (lower-spmd-numeric-failure
                        ctx
                        function-state
                        mode
                        env
                        (tc_core.tc-bind-params ctx type-env params)
                        helper-context
                        body))
                    (compiler-lower-function-state-inline-helper-stack-set!
                      function-state
                      previous)
                    (match result
                      [(Some found decision) (Some found decision)]
                      [(No)
                        (lower-spmd-numeric-failure-in-expr-list
                          ctx
                          function-state
                          mode
                          env
                          type-env
                          numeric-context
                          args)])))]
              [(Imported _ _ _ _ _)
                (lower-spmd-numeric-failure-in-expr-list
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  numeric-context
                  args)]
              [(No)
                (lower-spmd-numeric-failure-in-expr-list
                  ctx
                  function-state
                  mode
                  env
                  type-env
                  numeric-context
                  args)])]
          [(Err _)
            (lower-spmd-numeric-failure-in-expr-list
              ctx
              function-state
              mode
              env
              type-env
              numeric-context
              args)]))]
    [(Set _ value-box)
      (lower-spmd-numeric-failure
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        (lower-context-expr-get ctx value-box))]
    [(StructSet receiver-box _ value-box)
      (lower-spmd-numeric-failure-first
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        (lower-context-expr-get ctx receiver-box)
        (lower-context-expr-get ctx value-box))]
    [(SpmdBroadcast value-box lane-box)
      (lower-spmd-numeric-failure-first
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        (lower-context-expr-get ctx value-box)
        (lower-context-expr-get ctx lane-box))]
    [(SpmdShuffle value-box lane-box)
      (lower-spmd-numeric-failure-first
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        (lower-context-expr-get ctx value-box)
        (lower-context-expr-get ctx lane-box))]
    [_ (No)]))

(define (lower-spmd-numeric-failure
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [numeric-context : spmd_numeric.CompilerSpmdNumericContext]
  [expr : ast.AstExpr]) : LowerMaybeSpmdNumericFailure
  (match (lower-global-shared-view expr)
    [(Spanned inner-box _)
      (lower-spmd-numeric-failure-node
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        expr
        (lower-context-expr-get ctx inner-box))]
    [_
      (lower-spmd-numeric-failure-node
        ctx
        function-state
        mode
        env
        type-env
        numeric-context
        (lower-global-shared-view expr)
        expr)]))

(define (lower-spmd-numeric-failure-message
  [decision : spmd_numeric.CompilerSpmdNumericDecision]) : String
  (str_cat.str-cat
    "lower: SPMD numeric "
    (match decision.operation
      [(Binary op)
        (str_cat.str-cat
          "operation '"
          (spmd_numeric.compiler-spmd-numeric-operation-name op)
          "'")]
      [(Conversion) "conversion"])
    " from "
    (spmd_numeric.compiler-spmd-numeric-lane-name decision.source)
    " to "
    (spmd_numeric.compiler-spmd-numeric-lane-name decision.destination)
    " is unsupported in "
    (spmd_numeric.compiler-spmd-numeric-context-name decision.context)
    " context for "
    (spmd_numeric.compiler-spmd-numeric-backend-name decision.backend)
    " backend; "
    (spmd_numeric.compiler-spmd-numeric-limitation decision)))

(define (lower-simple-vector-map-binop-supported?
  [mode : CompilerLowerMode]
  [elem-ty : ast.AstType]
  [context : spmd_numeric.CompilerSpmdNumericContext]
  [op : ast.AstBinOp]) : bool
  (match (spmd_numeric.compiler-spmd-numeric-binary-decision
    (lower-global-shared-view elem-ty)
    elem-ty
    context
    (lower-spmd-numeric-backend mode)
    op).strategy
    ;; This planner emits ordinary vector binops. Checked active-lane rows are
    ;; consumed by the masked planner after this direct planner declines them.
    [(MaskedPlannerExpansion) false]
    [(Unsupported) false]
    [_ true]))

(define (lower-spmd-shift-lane-supported? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(I8) true]
    [(U8) true]
    [(I16) true]
    [(U16) true]
    [(I32) true]
    [(U32) true]
    [(I64) true]
    [(U64) true]
    [_ false]))

(define (lower-spmd-shift-width [ty : ast.AstType]) : i64
  (match (tc_core.tc-type-without-regions ty)
    [(I8) 8]
    [(U8) 8]
    [(I16) 16]
    [(U16) 16]
    [(I32) 32]
    [(U32) 32]
    [(I64) 64]
    [(U64) 64]
    [_ 0]))

(define (lower-spmd-map-shift-diagnostic
  [op-name : String]
  [lane-ty : ast.AstType]
  [mode : CompilerLowerMode]) : String
  (str_cat.str-cat
    "lower: SPMD foreach SIMD lowering does not support shift '"
    op-name
    "' for lane type "
    (tc_core.tc-type-render lane-ty)
    " in "
    (if (lower-mode-avx2? mode)
      "AVX2"
      "AVX-512")
    " backend mode; supported lane types are i8, u8, i16, u16, i32, u32, i64, and u64"))

(define (lower-spmd-expr-has-shift?
  [ctx : tc_core.TcContext]
  [want-left : bool]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(Spanned inner-box _)
      (lower-spmd-expr-has-shift?
        ctx
        want-left
        (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-spmd-expr-has-shift?
        ctx
        want-left
        (lower-context-expr-get ctx inner-box))]
    [(Cast inner-box _)
      (lower-spmd-expr-has-shift?
        ctx
        want-left
        (lower-context-expr-get ctx inner-box))]
    [(Binary op lhs-box rhs-box)
      (let
        [matches : bool
          (match op
            [(Shl) want-left]
            [(Shr) (not want-left)]
            [_ false])]
        (or
          matches
          (lower-spmd-expr-has-shift?
            ctx
            want-left
            (lower-context-expr-get ctx lhs-box))
          (lower-spmd-expr-has-shift?
            ctx
            want-left
            (lower-context-expr-get ctx rhs-box))))]
    [(ArraySet arr-box index-box value-box)
      (or
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx arr-box))
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx index-box))
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx value-box)))]
    [(Begin exprs) (lower-spmd-expr-list-has-shift? ctx want-left exprs)]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (or
            (lower-spmd-let-bindings-have-shift? ctx want-left bindings)
            (lower-spmd-expr-has-shift?
              ctx
              want-left
              (lower-context-expr-get ctx body-box)))])]
    [(If cond-box then-box else-box)
      (or
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx cond-box))
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx then-box))
        (lower-spmd-expr-has-shift?
          ctx
          want-left
          (lower-context-expr-get ctx else-box)))]
    [_ false]))

(define (lower-spmd-expr-list-has-shift?
  [ctx : tc_core.TcContext]
  [want-left : bool]
  [exprs : ast.AstExprList]) : bool
  (lower-spmd-expr-list-has-shift-at? ctx want-left (& exprs) 0))

(define (lower-spmd-expr-list-has-shift-at?
  [ctx : tc_core.TcContext]
  [want-left : bool]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (or
      (lower-spmd-expr-has-shift?
        ctx
        want-left
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0)))
      (lower-spmd-expr-list-has-shift-at? ctx want-left exprs (+ index 1)))))

(define (lower-spmd-let-bindings-have-shift?
  [ctx : tc_core.TcContext]
  [want-left : bool]
  [bindings : ast.AstLetBindingList]) : bool
  (lower-spmd-let-bindings-have-shift-at? ctx want-left (& bindings) 0))

(define (lower-spmd-let-bindings-have-shift-at?
  [ctx : tc_core.TcContext]
  [want-left : bool]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : bool
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    false
    (or
      (match (ast.ast-let-binding-list-get
        bindings
        binding-index
        (ast.ast-let-binding-fallback))
        [(Binding _ _ init-box)
          (lower-spmd-expr-has-shift?
            ctx
            want-left
            (lower-context-expr-get ctx init-box))])
      (lower-spmd-let-bindings-have-shift-at?
        ctx
        want-left
        bindings
        (+ binding-index 1)))))

(define (lower-simple-vector-map-unsupported-shift-lane
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [want-left : bool]
  [body : ast.AstExpr]) : LowerMaybeAstType
  (match body
    [(Spanned inner-box _)
      (lower-simple-vector-map-unsupported-shift-lane
        ctx
        mode
        env
        type-env
        index
        want-left
        (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-simple-vector-map-unsupported-shift-lane
        ctx
        mode
        env
        type-env
        index
        want-left
        (lower-context-expr-get ctx inner-box))]
    [(Begin exprs)
      (lower-simple-vector-map-expr-list-unsupported-shift-lane-at
        ctx
        mode
        env
        type-env
        index
        want-left
        (& exprs)
        0)]
    [(ArraySet arr-box set-index-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [set-index : ast.AstExpr (lower-context-expr-get ctx set-index-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (if (lower-expr-is-var? ctx set-index index)
          (match (lower-contiguous-sequence-var ctx env type-env arr)
            [(Some _ dst-elem)
              (if (and
                (>
                  (lower-simd-lanes-for-elem
                    mode
                    (lower-global-shared-view dst-elem))
                  0)
                (not
                  (lower-spmd-shift-lane-supported?
                    (lower-global-shared-view dst-elem)))
                (lower-spmd-expr-has-shift? ctx want-left value))
                (Some dst-elem)
                (No))]
            [(No) (No)])
          (No)))]
    [_ (No)]))

(define (lower-simple-vector-map-expr-list-unsupported-shift-lane-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [want-left : bool]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : LowerMaybeAstType
  (if (>= expr-index exprs.len)
    (No)
    (match (lower-simple-vector-map-unsupported-shift-lane
      ctx
      mode
      env
      type-env
      index
      want-left
      (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0)))
      [(Some lane-ty) (Some lane-ty)]
      [(No)
        (lower-simple-vector-map-expr-list-unsupported-shift-lane-at
          ctx
          mode
          env
          type-env
          index
          want-left
          exprs
          (+ expr-index 1))])))

(define (lower-simple-vector-map-casted-literal
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [target-ty : ast.AstType]
  [dst-elem : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeVectorMapValue
  (match value
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-casted-literal
          ctx
          mode
          target-ty
          dst-elem
          inner))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-casted-literal
          ctx
          mode
          target-ty
          dst-elem
          inner))]
    [(Literal lit)
      (if (and
        (>
          (lower-simd-lanes-for-elem mode (lower-global-shared-view target-ty))
          0)
        (tc_core.tc-type-eq (lower-global-shared-view target-ty) dst-elem))
        (Some
          (Uniform
            (lower-literal-value-with-type
              (tc_core.tc-context-source-names ctx)
              lit
              target-ty)))
        (No))]
    [_ (No)]))

(define (lower-simple-vector-map-lane-array-value
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [dst-elem : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeVectorMapValue
  (match (lower-array-ref-var-for-program-index ctx env type-env value)
    [(Some array-var array-elem)
      (if (tc_core.tc-type-eq array-elem dst-elem)
        (Some (LaneArray array-var))
        (No))]
    [(No) (No)]))

(define (lower-simple-vector-map-gather-lane-offset-var
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [value : ast.AstExpr]) : LowerMaybeArrayVar
  (match value
    [(Spanned inner-box _)
      (lower-simple-vector-map-gather-lane-offset-var
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-simple-vector-map-gather-lane-offset-var
        ctx
        env
        type-env
        index
        (lower-context-expr-get ctx inner-box))]
    [(Binary (Add) lhs-box rhs-box)
      (let
        [lhs : ast.AstExpr (lower-context-expr-get ctx lhs-box)]
        [rhs : ast.AstExpr (lower-context-expr-get ctx rhs-box)]
        (if (lower-expr-is-var? ctx (lower-global-shared-view lhs) index)
          (lower-array-ref-var-for-program-index ctx env type-env rhs)
          (if (lower-expr-is-var? ctx rhs index)
            (lower-array-ref-var-for-program-index ctx env type-env lhs)
            (No))))]
    [_ (No)]))

(define (lower-simple-vector-map-gather-value
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [dst-elem : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeVectorMapValue
  (match value
    [(ArrayRef source-box indexes-box)
      (let
        [source : ast.AstExpr (lower-context-expr-get ctx source-box)]
        [indexes : ast.AstExpr (lower-context-expr-get ctx indexes-box)]
        (match (lower-contiguous-sequence-var ctx env type-env source)
          [(Some source-var source-elem)
            (match (lower-array-ref-var-for-index
              ctx
              env
              type-env
              (lower-global-shared-view indexes)
              index)
              [(Some indexes-var indexes-elem)
                (if (and
                  (tc_core.tc-type-eq source-elem dst-elem)
                  (tc_core.tc-type-eq indexes-elem (I64)))
                  (Some (Gather source-var indexes-var))
                  (No))]
              [(No)
                (match (lower-simple-vector-map-gather-lane-offset-var
                  ctx
                  env
                  type-env
                  index
                  indexes)
                  [(Some offsets-var offsets-elem)
                    (if (and
                      (tc_core.tc-type-eq source-elem dst-elem)
                      (tc_core.tc-type-eq offsets-elem (I64)))
                      (Some (GatherLaneOffset source-var offsets-var))
                      (No))]
                  [(No) (No)])])]
          [(No) (No)]))]
    [_ (No)]))

(define (lower-vector-shuffle-value-type? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(I32) true]
    [(U32) true]
    [(I64) true]
    [(U64) true]
    [(F32) true]
    [(F64) true]
    [_ false]))

;; Keep shuffle operand evaluation to plans whose inactive lanes can be
;; suppressed by the existing predicated vector machinery. Gather and
;; broadcast plans need their own ordered gang-tail treatment and remain a
;; focused diagnostic instead of silently changing to one-lane semantics.
(define (lower-vector-shuffle-operand-plan? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(Array _) true]
    [(Uniform _) true]
    [(LaneIndex) true]
    [(LaneCount) true]
    [(Stage staged value)
      (and
        (lower-vector-shuffle-operand-plan? (deref staged))
        (lower-vector-shuffle-operand-plan? (deref value)))]
    [(BinOp _ lhs rhs)
      (and
        (lower-vector-shuffle-operand-plan? (deref lhs))
        (lower-vector-shuffle-operand-plan? (deref rhs)))]
    [_ false]))

(define (lower-vector-map-value-has-shuffle? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(Shuffle _ _) true]
    [(Stage staged value)
      (or
        (lower-vector-map-value-has-shuffle? (deref staged))
        (lower-vector-map-value-has-shuffle? (deref value)))]
    [(BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-has-shuffle? (deref lhs))
        (lower-vector-map-value-has-shuffle? (deref rhs)))]
    [_ false]))

;; The plan a `let` bound NAME to, or `No` outside every binding.
(define (lower-vector-map-local-lookup
  [locals : LowerVectorMapLocals]
  [name : i64]) : LowerMaybeVectorMapValue
  (match locals
    [(Nil) (No)]
    [(Cons bound plan rest)
      (if (= bound name)
        (Some plan)
        (lower-vector-map-local-lookup (deref rest) name))]))

;; A `let` in a direct-map value, such as an inlined helper's argument staging
;; (#7541). Each binding is planned in order, in the map's element type, then
;; the body with the bindings as lane locals. The plan stages every binding
;; ahead of the body in binding order, so each is evaluated once, before the
;; body, whether the body reads it or not. A binding must declare a lane type
;; the map's element type admits, as a cast of it would.
(define (lower-simple-vector-map-let
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [numeric-context : spmd_numeric.CompilerSpmdNumericContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [dst-elem : ast.AstType]
  [bindings : (& bindings ast.AstLetBindingList)]
  [at : i64]
  [body : ast.AstExpr]
  [locals : LowerVectorMapLocals]) : LowerMaybeVectorMapValue
  (if (>= at (ast.ast-let-binding-list-len bindings))
    (lower-simple-vector-map-value
      ctx
      mode
      numeric-context
      env
      type-env
      index
      dst-elem
      body
      locals)
    (match (ast.ast-let-binding-list-get
      bindings
      at
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (match maybe-ty
          [(Some declared)
            (let
              [binding-ty : ast.AstType
                (tc_core.tc-type-without-regions
                  (tc_core.tc-resolve-type ctx declared))]
              (if (or
                (tc_core.tc-type-eq
                  (lower-global-shared-view binding-ty)
                  (lower-global-shared-view dst-elem))
                (spmd_numeric.compiler-spmd-numeric-decision-supported?
                  (spmd_numeric.compiler-spmd-numeric-conversion-decision
                    (lower-global-shared-view binding-ty)
                    (lower-global-shared-view dst-elem)
                    numeric-context
                    (lower-spmd-numeric-backend mode))))
                (match (lower-simple-vector-map-value
                  ctx
                  mode
                  numeric-context
                  env
                  type-env
                  index
                  (lower-global-shared-view dst-elem)
                  (lower-context-expr-get ctx init-box)
                  (lower-global-shared-view locals))
                  [(Some staged)
                    (match (lower-simple-vector-map-let
                      ctx
                      mode
                      numeric-context
                      env
                      (tc_core.tc-bind-id type-env name binding-ty)
                      index
                      dst-elem
                      bindings
                      (+ at 1)
                      body
                      (Cons name (lower-global-shared-view staged) (box locals)))
                      [(Some value) (Some (Stage (box staged) (box value)))]
                      [(No) (No)])]
                  [(No) (No)])
                (No)))]
          [(No) (No)])])))

(define (lower-simple-vector-map-value
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [numeric-context : spmd_numeric.CompilerSpmdNumericContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [dst-elem : ast.AstType]
  [value : ast.AstExpr]
  [locals : LowerVectorMapLocals]) : LowerMaybeVectorMapValue
  (match (lower-global-shared-view value)
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-value
          ctx
          mode
          numeric-context
          env
          type-env
          index
          dst-elem
          inner
          (lower-global-shared-view locals)))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map-value
          ctx
          mode
          numeric-context
          env
          type-env
          index
          dst-elem
          inner
          (lower-global-shared-view locals)))]
    [(Cast inner-box cast-ty-id)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        [target-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-context-type-get ctx cast-ty-id))]
        (match (lower-simple-vector-map-casted-literal
          ctx
          mode
          (lower-global-shared-view target-ty)
          (lower-global-shared-view dst-elem)
          (lower-global-shared-view inner))
          [(Some plan) (Some plan)]
          [(No)
            (match (tc_core.tc-expr
              ctx
              type-env
              (lower-global-shared-view inner))
              [(Ok source-ty)
                (if (spmd_numeric.compiler-spmd-numeric-decision-supported?
                  (spmd_numeric.compiler-spmd-numeric-conversion-decision
                    (tc_core.tc-type-without-regions source-ty)
                    target-ty
                    numeric-context
                    (lower-spmd-numeric-backend mode)))
                  (lower-simple-vector-map-value
                    ctx
                    mode
                    numeric-context
                    env
                    type-env
                    index
                    dst-elem
                    inner
                    (lower-global-shared-view locals))
                  (No))]
              [(Err _) (No)])]))]
    [(ArrayRef _ _)
      (match (lower-array-ref-var-for-index
        ctx
        env
        type-env
        (lower-global-shared-view value)
        index)
        [(Some array-var array-elem)
          (if (tc_core.tc-type-eq array-elem dst-elem)
            (Some (Array array-var))
            (No))]
        [(No)
          (match (lower-simple-vector-map-gather-value
            ctx
            env
            type-env
            index
            (lower-global-shared-view dst-elem)
            (lower-global-shared-view value))
            [(Some plan) (Some plan)]
            [(No)
              (lower-simple-vector-map-lane-array-value
                ctx
                env
                type-env
                dst-elem
                value)])])]
    [(SpmdShuffle value-box lane-box)
      (let
        [source : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [selector : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (if (and
          (lower-vector-shuffle-value-type? (lower-global-shared-view dst-elem))
          (>
            (lower-simd-lanes-for-elem mode (lower-global-shared-view dst-elem))
            0))
          (match (lower-simple-vector-map-value
            ctx
            mode
            numeric-context
            env
            type-env
            index
            dst-elem
            source
            (lower-global-shared-view locals))
            [(Some source-plan)
              (match (lower-simple-vector-map-value
                ctx
                mode
                numeric-context
                env
                type-env
                index
                (I64)
                selector
                (lower-global-shared-view locals))
                [(Some selector-plan)
                  (if (and
                    (lower-vector-shuffle-operand-plan?
                      (lower-global-shared-view source-plan))
                    (lower-vector-shuffle-operand-plan?
                      (lower-global-shared-view selector-plan)))
                    (Some (Shuffle (box source-plan) (box selector-plan)))
                    (No))]
                [(No) (No)])]
            [(No) (No)])
          (No)))]
    [(SpmdBroadcast value-box lane-box)
      (let
        [source : ast.AstExpr (lower-context-expr-get ctx value-box)]
        [lane : ast.AstExpr (lower-context-expr-get ctx lane-box)]
        (match (lower-simple-spmd-broadcast-lane ctx env type-env lane)
          [(Some lane-value)
            (match (lower-array-ref-var-for-index
              ctx
              env
              type-env
              (lower-global-shared-view source)
              index)
              [(Some array-var array-elem)
                (if (tc_core.tc-type-eq array-elem dst-elem)
                  (Some (BroadcastArray array-var lane-value))
                  (No))]
              [(No)
                (lower-simple-vector-map-value
                  ctx
                  mode
                  numeric-context
                  env
                  type-env
                  index
                  dst-elem
                  source
                  (lower-global-shared-view locals))])]
          [(No) (No)]))]
    [(SpmdProgramIndex)
      (if (and
        (>
          (lower-simd-lanes-for-elem mode (lower-global-shared-view dst-elem))
          0)
        (tc_core.tc-type-eq dst-elem (I64)))
        (Some (LaneIndex))
        (No))]
    [(SpmdProgramCount)
      (if (and
        (>
          (lower-simd-lanes-for-elem mode (lower-global-shared-view dst-elem))
          0)
        (tc_core.tc-type-eq dst-elem (I64)))
        (Some (LaneCount))
        (No))]
    [(Var name)
      (match (lower-vector-map-local-lookup locals name)
        [(Some bound) (Some bound)]
        [(No)
          (let
            [lookup-name : String (tc_core.tc-env-key-name-text name)]
            (if (string.eq lookup-name index)
              (No)
              (let
                [var-id : i64
                  (sym_i64_env.sym-i64-lookup-id-or
                    env
                    name
                    (csym.compiler-symbols-missing-handle))]
                (if (csym.compiler-symbols-handle-found? var-id)
                  (match (tc_core.tc-lookup-id type-env name)
                    [(Ok ty)
                      (let
                        [scalar-ty : ast.AstType
                          (tc_core.tc-type-without-regions ty)]
                        (if (and
                          (>
                            (lower-simd-lanes-for-elem
                              mode
                              (lower-global-shared-view scalar-ty))
                            0)
                          (tc_core.tc-type-eq scalar-ty dst-elem))
                          (Some (Uniform (Var var-id)))
                          (No)))]
                    [(Err _) (No)])
                  (No)))))])]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (lower-simple-vector-map-let
            ctx
            mode
            numeric-context
            env
            type-env
            index
            dst-elem
            (& bindings)
            0
            (lower-context-expr-get ctx body-box)
            (lower-global-shared-view locals))])]
    [(Literal lit)
      (let
        [lit-ty : ast.AstType
          (tc_core.tc-literal-type (lower-global-shared-view lit))]
        (match (lower-global-shared-view lit)
          [(Int _ _)
            (if (and
              (>
                (lower-simd-lanes-for-elem
                  mode
                  (lower-global-shared-view dst-elem))
                0)
              (tc_core.tc-integer-type? (lower-global-shared-view dst-elem)))
              (Some
                (Uniform
                  (lower-literal-value-with-type
                    (tc_core.tc-context-source-names ctx)
                    lit
                    dst-elem)))
              (No))]
          [_
            (if (and
              (>
                (lower-simd-lanes-for-elem
                  mode
                  (lower-global-shared-view lit-ty))
                0)
              (tc_core.tc-type-eq lit-ty (lower-global-shared-view dst-elem)))
              (Some
                (Uniform
                  (lower-literal-value-with-type
                    (tc_core.tc-context-source-names ctx)
                    lit
                    dst-elem)))
              (No))]))]
    [(Binary op lhs-box rhs-box)
      (if (lower-simple-vector-map-binop-supported?
        mode
        (lower-global-shared-view dst-elem)
        numeric-context
        op)
        (let
          [lhs : ast.AstExpr (lower-context-expr-get ctx lhs-box)]
          [rhs : ast.AstExpr (lower-context-expr-get ctx rhs-box)]
          (match (lower-simple-vector-map-value
            ctx
            mode
            numeric-context
            env
            type-env
            index
            (lower-global-shared-view dst-elem)
            lhs
            (lower-global-shared-view locals))
            [(Some lhs-plan)
              (match (lower-simple-vector-map-value
                ctx
                mode
                numeric-context
                env
                type-env
                index
                (lower-global-shared-view dst-elem)
                rhs
                (lower-global-shared-view locals))
                [(Some rhs-plan)
                  (Some
                    (BinOp
                      (lower-binop op dst-elem)
                      (box lhs-plan)
                      (box rhs-plan)))]
                [(No) (No)])]
            [(No) (No)]))
        (No))]
    [_ (No)]))

(define (lower-vector-map-value-array-vars [plan : LowerVectorMapValue]) : LowerArrayVarSet
  (match plan
    [(Array array-var)
      (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
    [(Gather _ indexes-var)
      ;; Only the contiguous index stream participates in the vector loop's
      ;; range proof. Gathered source indexes are checked individually below.
      (lower-array-var-set-add (lower-array-var-set-empty) indexes-var 0)]
    [(GatherLaneOffset _ _) (lower-array-var-set-empty)]
    [(LaneArray _) (lower-array-var-set-empty)]
    [(Uniform _) (lower-array-var-set-empty)]
    [(BroadcastArray array-var _)
      (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
    [(LaneIndex) (lower-array-var-set-empty)]
    [(LaneCount) (lower-array-var-set-empty)]
    [(Shuffle source selector)
      (lower-array-var-set-merge
        (lower-vector-map-value-array-vars (deref source))
        (lower-vector-map-value-array-vars (deref selector)))]
    [(Stage staged value)
      (lower-array-var-set-merge
        (lower-vector-map-value-array-vars (deref staged))
        (lower-vector-map-value-array-vars (deref value)))]
    [(BinOp _ lhs rhs)
      (lower-array-var-set-merge
        (lower-vector-map-value-array-vars (deref lhs))
        (lower-vector-map-value-array-vars (deref rhs)))]))

(define (lower-vector-map-value-uses-array?
  [plan : LowerVectorMapValue]
  [array-var : i64]) : bool
  (match plan
    [(Array found) (= found array-var)]
    [(Gather source indexes) (or (= source array-var) (= indexes array-var))]
    [(GatherLaneOffset source offsets)
      (or (= source array-var) (= offsets array-var))]
    [(LaneArray found) (= found array-var)]
    [(BroadcastArray found _) (= found array-var)]
    [(Shuffle source selector)
      (or
        (lower-vector-map-value-uses-array? (deref source) array-var)
        (lower-vector-map-value-uses-array? (deref selector) array-var))]
    [(Stage staged value)
      (or
        (lower-vector-map-value-uses-array? (deref staged) array-var)
        (lower-vector-map-value-uses-array? (deref value) array-var))]
    [(BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-uses-array? (deref lhs) array-var)
        (lower-vector-map-value-uses-array? (deref rhs) array-var))]
    [_ false]))

(define (lower-vector-map-store-list-empty) : LowerVectorMapStoreList
  (LowerVectorMapStoreList (__tl_make-array LowerVectorMapStore 0) 0))

(define (lower-vector-map-store-list-add
  [stores : LowerVectorMapStoreList]
  [store : LowerVectorMapStore]) : LowerVectorMapStoreList
  (let
    [items : (__tl_dyn-array LowerVectorMapStore) stores.items]
    [count : i64 stores.count]
    (__tl_array-push! items store)
    (LowerVectorMapStoreList items (+ count 1))))

(define (lower-vector-map-store-list-ref
  [stores : (& stores LowerVectorMapStoreList)]
  [index : i64]) : LowerVectorMapStore
  (let
    [stores : LowerVectorMapStoreList
      (owned_view.compiler-owned-reference-shared-view stores)]
    (array-ref stores.items index)))

(define (lower-vector-map-store-list-has-destination?
  [stores : LowerVectorMapStoreList]
  [array-var : i64]) : bool
  (let
    [count : i64 stores.count]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (lower-vector-map-store-list-ref stores index)
        [(LowerVectorMapStore array-var-found _)
          (if (= array-var-found array-var)
            (set! found true)
            (set! index (+ index 1)))]))
    found))

(define (lower-vector-map-store-list-input-uses-destination?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 stores.count]
    [index : i64 0]
    [found : bool false]
    (while (and (not found) (< index count))
      (match (lower-vector-map-store-list-ref stores index)
        [(LowerVectorMapStore _ value-plan)
          (let
            [dst-index : i64 0]
            (while (and (not found) (< dst-index count))
              (match (lower-vector-map-store-list-ref stores dst-index)
                [(LowerVectorMapStore dst-array _)
                  (if (lower-vector-map-value-uses-array?
                    (lower-global-shared-view value-plan)
                    dst-array)
                    (set! found true)
                    (set! dst-index (+ dst-index 1)))]))
            (set! index (+ index 1)))]))
    found))

(define (lower-vector-map-store-list-array-vars
  [stores : LowerVectorMapStoreList]) : LowerArrayVarSet
  (let
    [count : i64 stores.count]
    [index : i64 0]
    [arrays : LowerArrayVarSet (lower-array-var-set-empty)]
    (while (< index count)
      (match (lower-vector-map-store-list-ref stores index)
        [(LowerVectorMapStore dst-array value-plan)
          (set!
            arrays
            (lower-array-var-set-merge
              arrays
              (lower-vector-map-value-array-vars value-plan)))
          (set! arrays (lower-array-var-set-add arrays dst-array 0))
          (set! index (+ index 1))]))
    arrays))

(define (lower-simple-vector-map-store
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [expr : ast.AstExpr]) : LowerMaybeVectorMapStore
  (match expr
    [(Spanned inner-box _)
      (lower-simple-vector-map-store
        ctx
        mode
        env
        type-env
        index
        (lower-context-expr-get ctx inner-box))]
    [(ArraySet arr-box set-index-box value-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [set-index : ast.AstExpr (lower-context-expr-get ctx set-index-box)]
        [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
        (if (lower-expr-is-var? ctx set-index index)
          (match (lower-contiguous-sequence-var ctx env type-env arr)
            [(Some dst-var dst-elem)
              (let
                [lanes : i64
                  (lower-simd-lanes-for-elem
                    mode
                    (lower-global-shared-view dst-elem))]
                (if (> lanes 0)
                  (match (lower-simple-vector-map-value
                    ctx
                    mode
                    (DirectMap)
                    env
                    type-env
                    index
                    (lower-global-shared-view dst-elem)
                    value
                    (Nil))
                    [(Some value-plan)
                      (Some
                        (LowerVectorMapStore dst-var value-plan)
                        dst-elem
                        lanes)]
                    [(No) (No)])
                  (No)))]
            [(No) (No)])
          (No)))]
    [_ (No)]))

(define (lower-simple-vector-map-expr-list
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [exprs : ast.AstExprList]) : LowerMaybeVectorMap
  (lower-simple-vector-map-expr-list-at
    ctx
    mode
    env
    type-env
    index
    (& exprs)
    0
    (lower-vector-map-store-list-empty)
    (Unit)
    0))

(define (lower-simple-vector-map-expr-list-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]
  [stores : LowerVectorMapStoreList]
  [elem-ty : ast.AstType]
  [lanes : i64]) : LowerMaybeVectorMap
  (if (>= expr-index exprs.len)
    (if (and
      (> stores.count 0)
      (or
        (= stores.count 1)
        (not
          (lower-vector-map-store-list-input-uses-destination?
            (lower-global-shared-view stores)))))
      (Some stores elem-ty lanes)
      (No))
    (match (lower-simple-vector-map-store
      ctx
      mode
      env
      type-env
      index
      (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0)))
      [(Some store store-elem store-lanes)
        (match (lower-global-shared-view store)
          [(LowerVectorMapStore dst-array _)
            (if (or
              (lower-vector-map-store-list-has-destination?
                (lower-global-shared-view stores)
                dst-array)
              (and
                (> stores.count 0)
                (or
                  (not
                    (tc_core.tc-type-eq
                      elem-ty
                      (lower-global-shared-view store-elem)))
                  (not (= lanes store-lanes)))))
              (No)
              (lower-simple-vector-map-expr-list-at
                ctx
                mode
                env
                type-env
                index
                exprs
                (+ expr-index 1)
                (lower-vector-map-store-list-add stores store)
                store-elem
                store-lanes))])]
      [(No) (No)])))

(define (lower-simple-vector-map
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [body : ast.AstExpr]) : LowerMaybeVectorMap
  (match (lower-global-shared-view body)
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-simple-vector-map ctx mode env type-env index inner))]
    [(Begin exprs)
      (lower-simple-vector-map-expr-list ctx mode env type-env index exprs)]
    [(ArraySet _ _ _)
      (match (lower-simple-vector-map-store ctx mode env type-env index body)
        [(Some store elem-ty lanes)
          (Some
            (lower-vector-map-store-list-add
              (lower-vector-map-store-list-empty)
              store)
            elem-ty
            lanes)]
        [(No) (No)])]
    [_ (No)]))

(define (lower-simple-vector-reduce-op-supported?
  [_mode : CompilerLowerMode]
  [op : ast.AstReduceOp]
  [elem : ast.AstType]) : bool
  (match op
    [(Sum)
      (match elem
        [(I64) true]
        [(I32) true]
        [(F32) true]
        [(F64) true]
        [_ false])]
    [(Min)
      (match elem
        [(I32) true]
        [(I64) true]
        [_ false])]
    [(Max)
      (match elem
        [(I32) true]
        [(I64) true]
        [_ false])]
    [(All)
      (match elem
        [(Bool) true]
        [_ false])]
    [(Any)
      (match elem
        [(Bool) true]
        [_ false])]))

(define (lower-simple-vector-scan-op-supported?
  [op : ast.AstReduceOp]
  [elem : ast.AstType]) : bool
  (match op
    [(Sum)
      (match elem
        [(I32) true]
        [(I64) true]
        [_ false])]
    [(Min)
      (match elem
        [(I32) true]
        [(I64) true]
        [_ false])]
    [(Max)
      (match elem
        [(I32) true]
        [(I64) true]
        [_ false])]
    [(All)
      (match elem
        [(Bool) true]
        [_ false])]
    [(Any)
      (match elem
        [(Bool) true]
        [_ false])]))

(define (lower-simple-vector-scan-op [op : ast.AstReduceOp]) : ir.CompilerIrVectorPrefixOp
  (match op
    [(Sum) (Sum)]
    [(Min) (Min)]
    [(Max) (Max)]
    [(All) (All)]
    [(Any) (Any)]))

(define (lower-simple-vector-scan-output
  [ctx : tc_core.TcContext]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [prefix : (& prefix str)]
  [body : ast.AstExpr]) : LowerMaybeArrayVar
  (match body
    [(Spanned inner-box _)
      (lower-simple-vector-scan-output
        ctx
        env
        type-env
        index
        prefix
        (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-simple-vector-scan-output
        ctx
        env
        type-env
        index
        prefix
        (lower-context-expr-get ctx inner-box))]
    [(ArraySet array-box index-box value-box)
      (if (and
        (lower-expr-is-var? ctx (lower-context-expr-get ctx index-box) index)
        (lower-expr-is-var? ctx (lower-context-expr-get ctx value-box) prefix))
        (lower-contiguous-sequence-var
          ctx
          env
          type-env
          (lower-context-expr-get ctx array-box))
        (No))]
    [_ (No)]))

(define (lower-simple-vector-scan
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index : (& index str)]
  [prefix : (& prefix str)]
  [prefix-ty : ast.AstType]
  [value : ast.AstExpr]
  [body : ast.AstExpr]) : LowerMaybeVectorScan
  (if (not (lower-mode-simd? mode))
    (No)
    (match (lower-array-ref-var-for-index ctx env type-env value index)
      [(Some input-var input-ty)
        (match (lower-simple-vector-scan-output
          ctx
          env
          type-env
          index
          prefix
          body)
          [(Some output-var output-ty)
            (let
              [elem-ty : ast.AstType (tc_core.tc-type-without-regions input-ty)]
              [lanes : i64
                (if (lower-type-bool? elem-ty)
                  (lower-avx512-bool-lanes mode)
                  (lower-simd-lanes-for-elem
                    mode
                    (lower-global-shared-view elem-ty)))]
              (if (and
                (> lanes 0)
                (tc_core.tc-type-eq
                  (lower-global-shared-view elem-ty)
                  (tc_core.tc-type-without-regions output-ty))
                (tc_core.tc-type-eq
                  (lower-global-shared-view elem-ty)
                  (tc_core.tc-type-without-regions prefix-ty))
                (lower-simple-vector-scan-op-supported?
                  op
                  (lower-global-shared-view elem-ty)))
                (Scan
                  input-var
                  output-var
                  (lower-simple-vector-scan-op op)
                  elem-ty
                  lanes)
                (No)))]
          [(No) (No)])]
      [(No) (No)])))

(define (lower-simple-vector-reduce-op [op : ast.AstReduceOp]) : ir.CompilerIrVectorReduceOp
  (match op
    [(Min) (Min)]
    [(Max) (Max)]
    [_ (Sum)]))

(define (lower-simple-vector-reduce
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index : (& index str)]
  [value-ty : ast.AstType]
  [value : ast.AstExpr]) : LowerMaybeVectorReduce
  (if (lower-mode-simd? mode)
    (match (lower-global-shared-view value)
      [(Spanned inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-simple-vector-reduce
            ctx
            mode
            env
            type-env
            op
            index
            value-ty
            inner))]
      [(Ann inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-simple-vector-reduce
            ctx
            mode
            env
            type-env
            op
            index
            value-ty
            inner))]
      [_
        (match (lower-array-ref-var-for-index
          ctx
          env
          type-env
          (lower-global-shared-view value)
          index)
          [(Some array-var elem-ty)
            (let
              [elem : ast.AstType (tc_core.tc-type-without-regions elem-ty)]
              [lanes : i64
                (if (lower-type-bool? elem)
                  (lower-avx512-bool-lanes mode)
                  (lower-simd-lanes-for-elem
                    mode
                    (lower-global-shared-view elem)))]
              (if (and
                (> lanes 0)
                (lower-simple-vector-reduce-op-supported?
                  mode
                  op
                  (lower-global-shared-view elem)))
                (Array array-var (lower-simple-vector-reduce-op op) elem lanes)
                (No)))]
          [(No)
            (let
              [elem : ast.AstType (tc_core.tc-type-without-regions value-ty)]
              [lanes : i64
                (if (lower-type-bool? elem)
                  (lower-avx512-bool-lanes mode)
                  (lower-simd-lanes-for-elem
                    mode
                    (lower-global-shared-view elem)))]
              (if (and
                (> lanes 0)
                (lower-simple-vector-reduce-op-supported?
                  mode
                  op
                  (lower-global-shared-view elem)))
                (match (lower-simple-vector-map-value
                  ctx
                  mode
                  (FusedReduction)
                  env
                  type-env
                  index
                  (lower-global-shared-view elem)
                  value
                  (Nil))
                  [(Some value-plan)
                    (Value
                      value-plan
                      (lower-simple-vector-reduce-op op)
                      elem
                      lanes)]
                  [(No) (No)])
                (No)))])])
    (No)))

(define (lower-array-len-value
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]) : LowerExpr
  (match (lower-emit-gep state arr-value (I64 1) (I64))
    [(Expr gep-state len-gep _) (lower-emit-load gep-state len-gep (I64))]))

(define (lower-array-data-pointer-value
  [state : LowerState]
  [arr-value : ir.CompilerIrValue]) : LowerExpr
  ;; Dynamic-array fat header slot 0 is the element data pointer. Emit it as a
  ;; normal load keyed by the array header value so redundant-load CSE can see
  ;; repeated SIMD accesses to the same base.
  (lower-emit-load state arr-value (U64)))

(define (lower-sequence-len-value [state : LowerState] [sequence-var : i64]) : LowerExpr
  (if (lower-sequence-var-slice? sequence-var)
    (lower-emit-word state (lower-sequence-ir-value sequence-var) 1 (I64))
    (lower-array-len-value state (lower-sequence-ir-value sequence-var))))

(define (lower-sequence-data-pointer-value
  [state : LowerState]
  [sequence-var : i64]) : LowerExpr
  (match (lower-masked-preheader-array-data-get state sequence-var)
    [(Some data-ptr) (Expr state data-ptr (U64))]
    [(No)
      (if (lower-sequence-var-slice? sequence-var)
        (lower-emit-word state (lower-sequence-ir-value sequence-var) 0 (U64))
        (lower-array-data-pointer-value
          state
          (lower-sequence-ir-value sequence-var)))]))

(define (lower-sequence-element-addr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [sequence-var : i64]
  [idx-value : ir.CompilerIrValue]
  [idx-ty : ast.AstType]
  [elem-ty : ast.AstType]) : LowerExpr
  (if (lower-sequence-var-slice? sequence-var)
    (match (lower-sequence-data-pointer-value state sequence-var)
      [(Expr data-state data-ptr _)
        (match (lower-sequence-len-value data-state sequence-var)
          [(Expr len-state length-i64 _)
            (match (lower-emit-bounds-operand
              len-state
              (lower-global-shared-view idx-value)
              (lower-global-shared-view idx-ty))
              [(Expr index-state idx-u _)
                (match (lower-emit-cast index-state idx-value idx-ty (I64))
                  [(Expr cast-state idx-off _)
                    (match (lower-emit-bounds-operand
                      cast-state
                      length-i64
                      (I64))
                      [(Expr bounds-state length-u _)
                        (lower-emit-elem-addr-gep
                          ctx
                          (lower-emit-bounds-check bounds-state idx-u length-u)
                          data-ptr
                          idx-off
                          elem-ty)])])])])])
    (lower-array-element-addr
      ctx
      state
      (lower-sequence-ir-value sequence-var)
      idx-value
      idx-ty
      elem-ty)))

(define (lower-emit-vector-load-data
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (VectorLoad v data-ptr index lanes (lower-global-shared-view elem-ty)))
        (Var v)
        elem-ty)]))

(define (lower-emit-sequence-vector-load
  [state : LowerState]
  [sequence-var : i64]
  [index : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-sequence-data-pointer-value state sequence-var)
    [(Expr data-state data-ptr _)
      (lower-emit-vector-load-data data-state data-ptr index lanes elem-ty)]))

(define (lower-emit-gather-load
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [index-base : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [lane-offset : bool]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (ir.ir-instr-gather-load
            v
            base
            index-base
            index
            lane-offset
            lanes
            (lower-global-shared-view elem-ty)))
        (Var v)
        elem-ty)]))

(define (lower-emit-vector-shuffle-instr
  [state : LowerState]
  [source : ir.CompilerIrValue]
  [selector-low : ir.CompilerIrValue]
  [selector-high : ir.CompilerIrMaybeValue]
  [active-lanes : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (ir.ir-instr-vector-shuffle
            v
            source
            selector-low
            selector-high
            active-lanes
            lanes
            (lower-global-shared-view elem-ty)))
        (Var v)
        elem-ty)]))

(define (lower-emit-gather-lane-checks
  [_ctx : tc_core.TcContext]
  [state : LowerState]
  [indexes-data : ir.CompilerIrValue]
  [base-index-var : i64]
  [lane : i64]
  [lanes : i64]
  [source-len : ir.CompilerIrValue]) : LowerExpr
  (if (>= lane lanes)
    (Expr state Unit (Unit))
    (match (if (= lane 0)
      (Expr state (Var base-index-var) (I64))
      (lower-emit-binop state Add (Var base-index-var) (I64 lane) (I64)))
      [(Expr lane-state logical-index _)
        ;; The vector-loop range guard has already proved this contiguous
        ;; index lane is in bounds. Address it directly so gather validation
        ;; performs only the semantically required source-index check.
        (match (lower-emit-gep
          lane-state
          (lower-global-shared-view indexes-data)
          logical-index
          (I64))
          [(Expr addr-state index-ptr _)
            (match (lower-emit-load addr-state index-ptr (I64))
              [(Expr index-state gathered-index _)
                (lower-emit-gather-lane-checks
                  _ctx
                  (lower-emit-bounds-check
                    index-state
                    gathered-index
                    (lower-global-shared-view source-len))
                  indexes-data
                  base-index-var
                  (+ lane 1)
                  lanes
                  source-len)])])])))

(define (lower-emit-gather-lane-offset-checks
  [state : LowerState]
  [offsets-data : ir.CompilerIrValue]
  [base-index-var : i64]
  [lane : i64]
  [lanes : i64]
  [source-len : ir.CompilerIrValue]) : LowerExpr
  (if (>= lane lanes)
    (Expr state Unit (Unit))
    (match (if (= lane 0)
      (Expr state (Var base-index-var) (I64))
      (lower-emit-binop state Add (Var base-index-var) (I64 lane) (I64)))
      [(Expr logical-state logical-index _)
        (match (lower-emit-gep
          logical-state
          (lower-global-shared-view offsets-data)
          (I64 lane)
          (I64))
          [(Expr addr-state offset-ptr _)
            (match (lower-emit-load addr-state offset-ptr (I64))
              [(Expr offset-state offset _)
                (match (lower-emit-binop
                  offset-state
                  Add
                  logical-index
                  offset
                  (I64))
                  [(Expr index-state gathered-index _)
                    (lower-emit-gather-lane-offset-checks
                      (lower-emit-bounds-check
                        index-state
                        gathered-index
                        (lower-global-shared-view source-len))
                      offsets-data
                      base-index-var
                      (+ lane 1)
                      lanes
                      source-len)])])])])))

(define (lower-emit-vector-store-data
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (lower-state-emit
    state
    (ir.ir-instr-vector-store data-ptr index value lanes elem-ty)))

(define (lower-emit-sequence-vector-store
  [state : LowerState]
  [sequence-var : i64]
  [index : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (match (lower-sequence-data-pointer-value state sequence-var)
    [(Expr data-state data-ptr _)
      (lower-emit-vector-store-data
        data-state
        data-ptr
        index
        value
        lanes
        elem-ty)]))

(define (lower-emit-vector-binop
  [state : LowerState]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (ir.ir-instr-vector-bin-op
            v
            op
            lhs
            rhs
            lanes
            (lower-global-shared-view elem-ty)))
        (Var v)
        elem-ty)]))

(define (lower-emit-splat
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (Splat v value lanes (lower-global-shared-view elem-ty)))
        (Var v)
        elem-ty)]))

;; Only source-level uniform values participate in the masked preheader cache.
;; Internal enum-mask and lane-stitch splats are control-flow temporaries; making
;; those loop-wide creates very long AVX2 live ranges through recursive matches.
(define (lower-emit-masked-preheader-splat
  [state : LowerState]
  [value : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-masked-preheader-uniform-get
    state
    (lower-global-shared-view value)
    (lower-global-shared-view elem-ty))
    [(Some cached) (Expr state cached elem-ty)]
    [(No)
      (if (lower-masked-preheader-uniform-can-add? state)
        (match (lower-state-alloc-var state)
          [(Alloc next-state vector-var)
            (let
              [vector : ir.CompilerIrValue (Var vector-var)]
              (match (lower-state-masked-preheader-cache next-state)
                [(Some cache)
                  (ir.compiler-ir-instr-builder-push!
                    (&mut
                      (__tl-project-field (__tl-box-place cache) uniform-instrs))
                    (ir.CompilerIrInstr.Splat
                      vector-var
                      (lower-global-shared-view value)
                      lanes
                      (lower-global-shared-view elem-ty)))]
                [(No) unit])
              (lower-masked-preheader-uniform-add!
                next-state
                value
                (lower-global-shared-view elem-ty)
                (lower-global-shared-view vector))
              (Expr next-state vector elem-ty))])
        (lower-emit-splat state value lanes elem-ty))]))

(define (lower-emit-lane-id
  [state : LowerState]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit s (LaneId v lanes (lower-global-shared-view elem-ty)))
        (Var v)
        elem-ty)]))

(define (lower-emit-foreach-index-vector
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]) : LowerExpr
  (match (lower-emit-splat state (Var index-var) lanes (I64))
    [(Expr base-state base-value _)
      (match (lower-emit-lane-id base-state lanes (I64))
        [(Expr lane-state lane-value _)
          (lower-emit-vector-binop
            lane-state
            (Add)
            base-value
            lane-value
            lanes
            (I64))])]))

(define (lower-emit-vector-compare
  [state : LowerState]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (ir.ir-instr-vector-compare v op lhs rhs lanes elem-ty))
        (Var v)
        (Bool))]))

(define (lower-emit-mask-binop
  [state : LowerState]
  [op : ir.CompilerIrMaskBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr (lower-state-emit s (MaskBinOp v op lhs rhs lanes)) (Var v) (Bool))]))

(define (lower-emit-mask-not
  [state : LowerState]
  [src : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr (lower-state-emit s (MaskNot v src lanes)) (Var v) (Bool))]))

(define (lower-emit-mask-reduce
  [state : LowerState]
  [op : ir.CompilerIrMaskReduceOp]
  [src : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr (lower-state-emit s (MaskReduce v op src lanes)) (Var v) (Bool))]))

(define (lower-vector-map-binop-shift? [op : ir.CompilerIrBinOp]) : bool
  (match op
    [(Shl _) true]
    [(Shr _) true]
    [_ false]))

(define (lower-emit-checked-vector-shift
  [state : LowerState]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [op : ir.CompilerIrBinOp]
  [left-value : ir.CompilerIrValue]
  [right-value : ir.CompilerIrValue]
  [lane-ty : ast.AstType]
  [count-ty : ast.AstType]) : LowerExpr
  (let
    [s : LowerState state]
    [zero : ir.CompilerIrValue Unit]
    [width : ir.CompilerIrValue Unit]
    [negative : ir.CompilerIrValue Unit]
    [too-large : ir.CompilerIrValue Unit]
    [invalid : ir.CompilerIrValue Unit]
    [active-invalid : ir.CompilerIrValue Unit]
    [any-invalid : ir.CompilerIrValue Unit]
    [abort-label : i64 (ir.compiler-ir-label-none)]
    [continue-label : i64 (ir.compiler-ir-label-none)]
    (match (lower-emit-splat
      s
      (I64 0)
      lanes
      (lower-global-shared-view count-ty))
      [(Expr next-s value _)
        (set! s next-s)
        (set! zero value)])
    (match (lower-emit-splat
      s
      (I64 (lower-spmd-shift-width (lower-global-shared-view lane-ty)))
      lanes
      (lower-global-shared-view count-ty))
      [(Expr next-s value _)
        (set! s next-s)
        (set! width value)])
    (match (if (lower-type-signed? (lower-global-shared-view count-ty))
      (lower-emit-vector-compare
        s
        (Lt)
        (lower-global-shared-view right-value)
        zero
        lanes
        (lower-global-shared-view count-ty))
      ;; Unsigned counts cannot be negative. Materialize an all-false mask
      ;; without relying on the backend's signed/unsigned compare expansion.
      (lower-emit-vector-compare
        s
        (Ne)
        (lower-global-shared-view zero)
        zero
        lanes
        (lower-global-shared-view count-ty)))
      [(Expr next-s value _)
        (set! s next-s)
        (set! negative value)])
    (match (lower-emit-vector-compare
      s
      (Ge)
      (lower-global-shared-view right-value)
      width
      lanes
      count-ty)
      [(Expr next-s value _)
        (set! s next-s)
        (set! too-large value)])
    (match (lower-emit-mask-binop s (Or) negative too-large lanes)
      [(Expr next-s value _)
        (set! s next-s)
        (set! invalid value)])
    (match active-mask
      [(Some mask)
        (match (lower-emit-mask-binop s (And) invalid mask lanes)
          [(Expr next-s value _)
            (set! s next-s)
            (set! active-invalid value)])]
      [(No) (set! active-invalid invalid)])
    (match (lower-emit-mask-reduce s (Any) active-invalid lanes)
      [(Expr next-s value _)
        (set! s next-s)
        (set! any-invalid value)])
    (match (lower-state-fresh-label s "spmd_shift_abort")
      [(Label next-s label)
        (set! s next-s)
        (set! abort-label label)])
    (match (lower-state-fresh-label s "spmd_shift_continue")
      [(Label next-s label)
        (set! s next-s)
        (set! continue-label label)])
    (set!
      s
      (lower-state-finish-block
        (lower-state-emit s (Branch any-invalid abort-label continue-label))
        abort-label))
    (set!
      s
      (lower-state-finish-block
        (lower-state-emit (lower-shift-abort s) (Jump continue-label))
        continue-label))
    (lower-emit-vector-binop s op left-value right-value lanes lane-ty)))

(define (lower-emit-vector-map-binop
  [state : LowerState]
  [op : ir.CompilerIrBinOp]
  [lhs : ir.CompilerIrValue]
  [rhs : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (if (lower-vector-map-binop-shift? (lower-global-shared-view op))
    (lower-emit-checked-vector-shift
      state
      (match emit-mode
        [(Full) (No)]
        [(Predicated _ mask) (Some mask)])
      lanes
      op
      lhs
      rhs
      (lower-global-shared-view elem-ty)
      elem-ty)
    (lower-emit-vector-binop state op lhs rhs lanes elem-ty)))

(define (lower-emit-mask-select
  [state : LowerState]
  [then-mask : ir.CompilerIrValue]
  [then-value : ir.CompilerIrValue]
  [else-mask : ir.CompilerIrValue]
  [else-value : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [then-bits : ir.CompilerIrValue Unit]
    [else-bits : ir.CompilerIrValue Unit]
    (match (lower-emit-mask-binop s (And) then-mask then-value lanes)
      [(Expr next-s value _)
        (set! s next-s)
        (set! then-bits value)])
    (match (lower-emit-mask-binop s (And) else-mask else-value lanes)
      [(Expr next-s value _)
        (set! s next-s)
        (set! else-bits value)])
    (lower-emit-mask-binop s (Or) then-bits else-bits lanes)))

(define (lower-emit-select
  [state : LowerState]
  [mask : ir.CompilerIrValue]
  [on-true : ir.CompilerIrValue]
  [on-false : ir.CompilerIrValue]
  [lanes : i64]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (ir.ir-instr-select
            v
            mask
            on-true
            on-false
            lanes
            (lower-global-shared-view ty)))
        (Var v)
        ty)]))

;; SIMD loop bounds are invariant across gangs. Build the minimum with scalar
;; mask blends in the preheader so each vector header needs only one compare.
(define (lower-vector-loop-i64-compare
  [state : LowerState]
  [op : ir.CompilerIrBinOp]
  [left : ir.CompilerIrValue]
  [right : ir.CompilerIrValue]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      ;; Comparisons produce a boolean value, but the IR instruction's type is
      ;; the operand width used by the backend comparison.
      (Expr (lower-state-emit s (BinOp v op left right (I64))) (Var v) (Bool))]))

(define (lower-vector-loop-select
  [state : LowerState]
  [condition : ir.CompilerIrValue]
  [on-true : ir.CompilerIrValue]
  [on-false : ir.CompilerIrValue]) : LowerExpr
  (let
    [s : LowerState state]
    [condition-i64 : ir.CompilerIrValue Unit]
    [mask : ir.CompilerIrValue Unit]
    [different-bits : ir.CompilerIrValue Unit]
    [selected-bits : ir.CompilerIrValue Unit]
    (match (lower-emit-cast s condition (Bool) (I64))
      [(Expr next-s value _)
        (set! s next-s)
        (set! condition-i64 value)])
    (match (lower-emit-binop s (Sub) (I64 0) condition-i64 (I64))
      [(Expr next-s value _)
        (set! s next-s)
        (set! mask value)])
    (match (lower-emit-binop
      s
      (BitXor)
      on-true
      (lower-global-shared-view on-false)
      (I64))
      [(Expr next-s value _)
        (set! s next-s)
        (set! different-bits value)])
    (match (lower-emit-binop s (BitAnd) different-bits mask (I64))
      [(Expr next-s value _)
        (set! s next-s)
        (set! selected-bits value)])
    (lower-emit-binop s (BitXor) on-false selected-bits (I64))))

(define (lower-vector-loop-min
  [state : LowerState]
  [left : ir.CompilerIrValue]
  [right : ir.CompilerIrValue]) : LowerExpr
  (match (lower-vector-loop-i64-compare
    state
    (Le)
    (lower-global-shared-view left)
    (lower-global-shared-view right))
    [(Expr cmp-state take-left _)
      (lower-vector-loop-select cmp-state take-left left right)]))

(define (lower-vector-loop-start-ok
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      ;; As u64, every negative i64 start is above INT64_MAX. This one check
      ;; therefore also proves that adding lanes cannot overflow.
      (Expr
        (lower-state-emit
          s
          (BinOp
            v
            (Le)
            (Var index-var)
            (I64 (- 9223372036854775807 lanes))
            (U64)))
        (Var v)
        (Bool))]))

(define (lower-vector-loop-array-limit
  [state : LowerState]
  [array-var : i64]
  [offset : i64]) : LowerExpr
  (match (lower-sequence-len-value state array-var)
    [(Expr len-state array-len _)
      (if (> offset 0)
        (let
          [s : LowerState len-state]
          [offset-valid : ir.CompilerIrValue Unit]
          [candidate : ir.CompilerIrValue Unit]
          (match (lower-vector-loop-i64-compare
            s
            (Ge)
            (lower-global-shared-view array-len)
            (I64 offset))
            [(Expr next-s value _)
              (set! s next-s)
              (set! offset-valid value)])
          (match (lower-emit-binop s (Sub) array-len (I64 offset) (I64))
            [(Expr next-s value _)
              (set! s next-s)
              (set! candidate value)])
          ;; A too-short array cannot admit a vector gang. Avoid exposing the
          ;; wrapped subtraction as a large positive bound.
          (lower-vector-loop-select s offset-valid candidate (I64 -1)))
        (Expr len-state array-len (I64)))]))

(define (lower-vector-loop-limit
  [state : LowerState]
  [end-value : ir.CompilerIrValue]
  [arrays : (& arrays LowerArrayVarSet)]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc alloc-state end-var)
      (let
        [s : LowerState
          (lower-state-emit alloc-state (Mov end-var end-value (I64)))]
        [limit : ir.CompilerIrValue Unit]
        [index : i64 0]
        [count : i64 arrays.count]
        ;; Materialize the end bound before comparing it: direct literal
        ;; endpoints do not retain their width through scalar min selection.
        ;;
        ;; Besides bounding the first gang, this clamp ensures the next
        ;; header's index + lanes calculation cannot overflow after a
        ;; successful gang.
        (match (lower-vector-loop-min
          s
          (Var end-var)
          (I64 (- 9223372036854775807 lanes)))
          [(Expr next-s value _)
            (set! s next-s)
            (set! limit value)])
        (while (< index count)
          (match (lower-vector-loop-array-limit
            s
            (array-ref arrays.vars index)
            (array-ref arrays.offsets index))
            [(Expr array-state array-limit _)
              (match (lower-vector-loop-min
                array-state
                (lower-global-shared-view limit)
                array-limit)
                [(Expr next-s value _)
                  (set! s next-s)
                  (set! limit value)])])
          (set! index (+ index 1)))
        (Expr s limit (I64)))]))

(define (lower-vector-loop-next-ok
  [state : LowerState]
  [next-index : ir.CompilerIrValue]
  [limit : ir.CompilerIrValue]) : LowerExpr
  (lower-vector-loop-i64-compare state (Le) next-index limit))

(define (lower-emit-vector-reduce
  [state : LowerState]
  [op : ir.CompilerIrVectorReduceOp]
  [src : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (VectorReduce v op src lanes (lower-global-shared-view elem-ty)))
        (Var v)
        elem-ty)]))

(define (lower-spmd-reduce-mask-op [op : ast.AstReduceOp]) : ir.CompilerIrMaskReduceOp
  (match op
    [(All) (All)]
    [_ (Any)]))

(define (lower-spmd-reduce-chunk
  [state : LowerState]
  [op : ast.AstReduceOp]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [src : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (if (lower-type-bool? elem-ty)
    (lower-emit-mask-reduce state (lower-spmd-reduce-mask-op op) src lanes)
    (lower-emit-vector-reduce state vector-op src lanes elem-ty)))

(define (lower-spmd-reduce-array-chunk
  [state : LowerState]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [data-ptr : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (if (lower-type-bool? elem-ty)
    (match (lower-emit-tail-mask state (Var index-var) next-index lanes)
      [(Expr mask-state full-mask _)
        (lower-emit-predicated-load-data
          mask-state
          data-ptr
          (Var index-var)
          full-mask
          lanes
          elem-ty)])
    (lower-emit-vector-load-data state data-ptr (Var index-var) lanes elem-ty)))

(define (lower-spmd-reduce-apply-update
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [acc-var : i64]
  [elem-ty : ast.AstType]
  [value-var : i64]) : ResultLowerExpr
  (let
    [acc-name-id : i64
      (cis.intern-lower-private-identity-raw (lower-spmd-reduce-acc-id state))]
    [current-name-id : i64
      (cis.intern-lower-private-identity-raw
        (lower-spmd-reduce-current-id state))]
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    (lower-expr
      ctx
      state
      (sym_i64_env.sym-i64-bind-id
        (sym_i64_env.sym-i64-bind-id env acc-name-id acc-var)
        current-name-id
        value-var)
      (tc_core.tc-bind-id
        (tc_core.tc-bind-id
          type-env
          acc-name-id
          (lower-global-shared-view elem-ty))
        current-name-id
        elem-ty)
      (lower-context-expr-get
        ctx
        (spmd-reduce-acc-update-expr
          state
          pools
          op
          (ast.ast-node-pool-context-expr-push pools (Var current-name-id)))))))

(define (lower-spmd-reduce-vector-accumulator? [elem-ty : ast.AstType]) : bool
  (match elem-ty
    [(I32) true]
    [(I64) true]
    [_ false]))

(define (lower-spmd-reduce-vector-accumulator-init
  [op : ast.AstReduceOp]
  [acc-var : i64]) : ir.CompilerIrValue
  (match op
    [(Sum) (I64 0)]
    ;; Min/max are idempotent, so seeding every lane from the scalar init
    ;; preserves seeded and empty-range semantics without signed-extreme
    ;; constants. The post-loop horizontal result already includes the seed.
    [_ (Var acc-var)]))

(define (lower-spmd-reduce-vector-accumulate
  [state : LowerState]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [vector-acc-var : i64]
  [value : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (match vector-op
    [(Sum)
      (lower-state-emit
        state
        (ir.ir-instr-vector-bin-op
          vector-acc-var
          Add
          (Var vector-acc-var)
          value
          lanes
          elem-ty))]
    [_
      (match (lower-state-alloc-var state)
        [(Alloc compare-alloc mask-var)
          (let
            [compare-op : ir.CompilerIrBinOp
              (match vector-op
                [(Min) Lt]
                [_ Gt])]
            (lower-state-emit
              (lower-state-emit
                compare-alloc
                (ir.ir-instr-vector-compare
                  mask-var
                  compare-op
                  (lower-global-shared-view value)
                  (Var vector-acc-var)
                  lanes
                  (lower-global-shared-view elem-ty)))
              (ir.ir-instr-select
                vector-acc-var
                (Var mask-var)
                value
                (Var vector-acc-var)
                lanes
                elem-ty)))])]))

(define (lower-spmd-reduce-finish-vector-accumulator
  [state : LowerState]
  [op : ast.AstReduceOp]
  [acc-var : i64]
  [vector-acc-var : i64]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (match (lower-state-alloc-var state)
    [(Alloc reduce-alloc reduced-var)
      (let
        [reduced-state : LowerState
          (lower-state-emit
            reduce-alloc
            (VectorReduce
              reduced-var
              vector-op
              (Var vector-acc-var)
              lanes
              (lower-global-shared-view elem-ty)))]
        (match op
          [(Sum)
            (match (lower-state-alloc-var reduced-state)
              [(Alloc update-alloc updated-var)
                (lower-state-emit
                  (lower-state-emit
                    update-alloc
                    (BinOp
                      updated-var
                      Add
                      (Var acc-var)
                      (Var reduced-var)
                      (lower-global-shared-view elem-ty)))
                  (Mov acc-var (Var updated-var) elem-ty))])]
          ;; Every min/max lane was initialized with acc-var, so the horizontal
          ;; result already contains the scalar seed.
          [_
            (lower-state-emit
              reduced-state
              (Mov acc-var (Var reduced-var) elem-ty))]))]))

;; Folds one chunk of lanes into the reduction and advances the index.
(define (lower-avx2-reduce-vector-chunk
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [acc-var : i64]
  [vector-acc-var : i64]
  [chunk-vec : ir.CompilerIrValue]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (if (lower-spmd-reduce-vector-accumulator? (lower-global-shared-view elem-ty))
    (Ok
      (Expr
        (lower-state-emit
          (lower-spmd-reduce-vector-accumulate
            state
            vector-op
            vector-acc-var
            chunk-vec
            lanes
            elem-ty)
          (Mov index-var next-index (I64)))
        Unit
        (Unit)))
    (match (lower-spmd-reduce-chunk
      state
      op
      vector-op
      chunk-vec
      lanes
      (lower-global-shared-view elem-ty))
      [(Expr reduce-state reduced _)
        (match reduced
          [(Var reduced-var)
            (let
              [update-lowered : LowerExpr
                (try
                  (lower-spmd-reduce-apply-update
                    ctx
                    reduce-state
                    env
                    type-env
                    op
                    acc-var
                    elem-ty
                    reduced-var))]
              (match update-lowered
                [(Expr update-state _ _)
                  (Ok
                    (Expr
                      (lower-state-emit
                        update-state
                        (Mov index-var next-index (I64)))
                      Unit
                      (Unit)))]))]
          [_
            (Err (box (lower-diagnostic "lower: invalid vector reduce result")))])])))

(define (lower-avx2-reduce-vector-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [acc-var : i64]
  [vector-acc-var : i64]
  [data-ptr : ir.CompilerIrValue]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-spmd-reduce-array-chunk
    state
    index-var
    (lower-global-shared-view next-index)
    data-ptr
    lanes
    (lower-global-shared-view elem-ty))
    [(Expr load-state chunk-vec _)
      (lower-avx2-reduce-vector-chunk
        ctx
        load-state
        env
        type-env
        op
        index-var
        next-index
        acc-var
        vector-acc-var
        chunk-vec
        vector-op
        elem-ty
        lanes)]))

(define (lower-avx2-reduce-vector-value-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [acc-var : i64]
  [vector-acc-var : i64]
  [value-plan : LowerVectorMapValue]
  [preheader-cache : LowerVectorMapValueCache]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-emit-vector-map-value-cached
    ctx
    state
    index-var
    lanes
    (lower-global-shared-view elem-ty)
    value-plan
    (Full)
    preheader-cache)
    [(Emit value-state chunk-vec _)
      (lower-avx2-reduce-vector-chunk
        ctx
        value-state
        env
        type-env
        op
        index-var
        next-index
        acc-var
        vector-acc-var
        chunk-vec
        vector-op
        elem-ty
        lanes)]))

(define (lower-spmd-reduce-scalar-tail-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-var : i64]
  [index-ty : ast.AstType]
  [acc-var : i64]
  [array-var : i64]
  [elem-ty : ast.AstType]) : ResultLowerExpr
  (match (lower-sequence-element-addr
    ctx
    state
    array-var
    (Var index-var)
    (lower-global-shared-view index-ty)
    (lower-global-shared-view elem-ty))
    [(Expr addr-state elem-ptr _)
      (match (lower-emit-load
        addr-state
        elem-ptr
        (lower-global-shared-view elem-ty))
        [(Expr load-state loaded _)
          (match loaded
            [(Var loaded-var)
              (let
                [update-lowered : LowerExpr
                  (try
                    (lower-spmd-reduce-apply-update
                      ctx
                      load-state
                      env
                      type-env
                      op
                      acc-var
                      elem-ty
                      loaded-var))]
                (match update-lowered
                  [(Expr update-state _ _)
                    (match (lower-state-alloc-var update-state)
                      [(Alloc inc-alloc inc-var)
                        (Ok
                          (Expr
                            (lower-state-emit
                              (lower-state-emit
                                inc-alloc
                                (BinOp
                                  inc-var
                                  Add
                                  (Var index-var)
                                  (I64 1)
                                  (lower-global-shared-view index-ty)))
                              (Mov index-var (Var inc-var) index-ty))
                            Unit
                            (Unit)))])]))]
            [_
              (Err (box (lower-diagnostic "lower: invalid scalar reduce load")))])])]))

(define (lower-spmd-reduce-scalar-tail-value-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [base-index-var : i64]
  [current-index-var : i64]
  [active-lanes : ir.CompilerIrValue]
  [index-ty : ast.AstType]
  [acc-var : i64]
  [value-plan : LowerVectorMapValue]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-emit-scalar-vector-map-value
    ctx
    state
    base-index-var
    current-index-var
    (I64 0)
    active-lanes
    lanes
    (lower-global-shared-view elem-ty)
    value-plan)
    [(Expr value-state scalar-value _)
      (let
        [s : LowerState value-state]
        [value-var : i64 0]
        (match (lower-global-shared-view scalar-value)
          [(Var var) (set! value-var var)]
          [_
            (match (lower-state-alloc-var s)
              [(Alloc alloc-state tmp-var)
                (set!
                  s
                  (lower-state-emit
                    alloc-state
                    (Mov
                      tmp-var
                      scalar-value
                      (lower-global-shared-view elem-ty))))
                (set! value-var tmp-var)])])
        (let
          [update-lowered : LowerExpr
            (try
              (lower-spmd-reduce-apply-update
                ctx
                s
                env
                type-env
                op
                acc-var
                elem-ty
                value-var))]
          (match update-lowered
            [(Expr update-state _ _)
              (match (lower-state-alloc-var update-state)
                [(Alloc inc-alloc inc-var)
                  (Ok
                    (Expr
                      (lower-state-emit
                        (lower-state-emit
                          inc-alloc
                          (BinOp
                            inc-var
                            Add
                            (Var current-index-var)
                            (I64 1)
                            (lower-global-shared-view index-ty)))
                        (Mov current-index-var (Var inc-var) index-ty))
                      Unit
                      (Unit)))])])))]))

(define (lower-spmd-scan-vector-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [acc-var : i64]
  [input-var : i64]
  [output-var : i64]
  [prefix-op : ir.CompilerIrVectorPrefixOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : LowerExpr
  (let
    [s : LowerState state]
    [chunk : ir.CompilerIrValue Unit]
    [full-mask : ir.CompilerIrValue Unit]
    [prefix-value : ir.CompilerIrValue Unit]
    [last-index : ir.CompilerIrValue Unit]
    (if (lower-type-bool? elem-ty)
      (begin
        (match (lower-emit-tail-mask
          s
          (Var index-var)
          (lower-global-shared-view next-index)
          lanes)
          [(Expr next-s value _)
            (set! s next-s)
            (set! full-mask value)])
        (match (lower-emit-sequence-predicated-load
          s
          input-var
          (Var index-var)
          (lower-global-shared-view full-mask)
          lanes
          (lower-global-shared-view elem-ty))
          [(Expr next-s value _)
            (set! s next-s)
            (set! chunk value)]))
      (match (lower-emit-sequence-vector-load
        s
        input-var
        (Var index-var)
        lanes
        (lower-global-shared-view elem-ty))
        [(Expr next-s value _)
          (set! s next-s)
          (set! chunk value)]))
    (match (lower-state-alloc-var s)
      [(Alloc next-s prefix-var)
        (set!
          s
          (lower-state-emit
            next-s
            (ir.ir-instr-vector-prefix
              prefix-var
              prefix-op
              chunk
              (Var acc-var)
              lanes
              (lower-global-shared-view elem-ty))))
        (set! prefix-value (Var prefix-var))])
    (if (lower-type-bool? elem-ty)
      (set!
        s
        (lower-emit-sequence-predicated-store
          s
          output-var
          (Var index-var)
          prefix-value
          full-mask
          lanes
          (lower-global-shared-view elem-ty)))
      (set!
        s
        (lower-emit-sequence-vector-store
          s
          output-var
          (Var index-var)
          prefix-value
          lanes
          (lower-global-shared-view elem-ty))))
    (match (lower-emit-binop
      s
      Sub
      (lower-global-shared-view next-index)
      (I64 1)
      (I64))
      [(Expr next-s value _)
        (set! s next-s)
        (set! last-index value)])
    ;; `vector-limit` already proves the whole output gang is in bounds.
    ;; Reload the stored final lane through its raw data pointer so carry
    ;; handoff does not add a redundant scalar bounds-check block.
    (match (lower-sequence-data-pointer-value s output-var)
      [(Expr data-state data-ptr _)
        (match (lower-emit-elem-addr-gep
          ctx
          data-state
          data-ptr
          last-index
          (lower-global-shared-view elem-ty))
          [(Expr addr-state last-addr _)
            (match (lower-emit-load
              addr-state
              last-addr
              (lower-global-shared-view elem-ty))
              [(Expr load-state last-value _)
                (set!
                  s
                  (lower-state-emit load-state (Mov acc-var last-value elem-ty)))])])])
    (Expr (lower-state-emit s (Mov index-var next-index (I64))) Unit (Unit))))

(define (lower-spmd-scan-scalar-tail-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-id : i64]
  [index-var : i64]
  [index-ty : ast.AstType]
  [prefix-id : i64]
  [acc-var : i64]
  [elem-ty : ast.AstType]
  [value : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [index-env : sym_i64_env.SymI64Env
      (sym_i64_env.sym-i64-bind-id env index-id index-var)]
    [index-type-env : tc_core.TcTypeEnv
      (tc_core.tc-bind-id type-env index-id (lower-global-shared-view index-ty))]
    [body-env : sym_i64_env.SymI64Env
      (sym_i64_env.sym-i64-bind-id index-env prefix-id acc-var)]
    [body-type-env : tc_core.TcTypeEnv
      (tc_core.tc-bind-id
        index-type-env
        prefix-id
        (lower-global-shared-view elem-ty))]
    [value-lowered
      (try
        (lower-expr-expected
          ctx
          state
          index-env
          index-type-env
          (lower-global-shared-view value)
          (lower-global-shared-view elem-ty)
          value))]
    (match value-lowered
      [(Expr value-state value-ir _)
        (let
          [s : LowerState value-state]
          [value-var : i64 0]
          (match (lower-global-shared-view value-ir)
            [(Var var) (set! value-var var)]
            [_
              (match (lower-state-alloc-var s)
                [(Alloc alloc-state var)
                  (set! value-var var)
                  (set!
                    s
                    (lower-state-emit
                      alloc-state
                      (Mov var value-ir (lower-global-shared-view elem-ty))))])])
          (let
            [update-lowered : LowerExpr
              (try
                (lower-spmd-reduce-apply-update
                  ctx
                  s
                  index-env
                  index-type-env
                  op
                  acc-var
                  elem-ty
                  value-var))]
            (match update-lowered
              [(Expr update-state _ _)
                (let
                  [body-lowered : LowerExpr
                    (try
                      (lower-expr ctx update-state body-env body-type-env body))]
                  (match body-lowered
                    [(Expr body-state _ _)
                      (match (lower-state-alloc-var body-state)
                        [(Alloc inc-state inc-var)
                          (Ok
                            (Expr
                              (lower-state-emit
                                (lower-state-emit
                                  inc-state
                                  (BinOp
                                    inc-var
                                    Add
                                    (Var index-var)
                                    (I64 1)
                                    (lower-global-shared-view index-ty)))
                                (Mov index-var (Var inc-var) index-ty))
                              Unit
                              (Unit)))])]))])))])))

(define (lower-spmd-scan-vector-label [state : LowerState] [suffix : String]) : String
  (str_cat.str-cat
    "spmd_scan_"
    (if (lower-mode-avx512? (lower-state-mode state))
      "avx512_"
      "avx2_")
    suffix))

(define (lower-simd-spmd-scan-build
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-id : i64]
  [index-ty : ast.AstType]
  [init-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [prefix-id : i64]
  [value : ast.AstExpr]
  [body : ast.AstExpr]
  [input-var : i64]
  [output-var : i64]
  [prefix-op : ir.CompilerIrVectorPrefixOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc acc-state acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-state
          (Mov acc-var init-value (lower-global-shared-view elem-ty))))
        [(Alloc index-state index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-state
                (Mov index-var start-value (lower-global-shared-view index-ty)))]
            [header-label : i64 (ir.compiler-ir-label-none)]
            [body-label : i64 (ir.compiler-ir-label-none)]
            [tail-header-label : i64 (ir.compiler-ir-label-none)]
            [tail-body-label : i64 (ir.compiler-ir-label-none)]
            [exit-label : i64 (ir.compiler-ir-label-none)]
            [arrays : LowerArrayVarSet
              (lower-array-var-set-add
                (lower-array-var-set-add
                  (lower-array-var-set-empty)
                  input-var
                  0)
                output-var
                0)]
            [vector-limit : ir.CompilerIrValue Unit]
            [vector-start-ok : ir.CompilerIrValue Unit]
            [next-index : ir.CompilerIrValue Unit]
            [vector-ok : ir.CompilerIrValue Unit]
            [tail-cond : ir.CompilerIrValue Unit]
            (match (lower-state-fresh-label
              s
              (lower-spmd-scan-vector-label s "header"))
              [(Label next-s label)
                (set! s next-s)
                (set! header-label label)])
            (match (lower-state-fresh-label
              s
              (lower-spmd-scan-vector-label s "body"))
              [(Label next-s label)
                (set! s next-s)
                (set! body-label label)])
            (match (lower-state-fresh-label s "spmd_scan_tail_header")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-header-label label)])
            (match (lower-state-fresh-label s "spmd_scan_tail_body")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-body-label label)])
            (match (lower-state-fresh-label s "spmd_scan_exit")
              [(Label next-s label)
                (set! s next-s)
                (set! exit-label label)])
            (match (lower-vector-loop-limit
              s
              (lower-global-shared-view end-value)
              arrays
              lanes)
              [(Expr next-s limit _)
                (set! s next-s)
                (set! vector-limit limit)])
            (match (lower-vector-loop-start-ok s index-var lanes)
              [(Expr next-s ok _)
                (set! s next-s)
                (set! vector-start-ok ok)])
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit
                  s
                  (Branch vector-start-ok header-label tail-header-label))
                header-label))
            (match (lower-emit-binop
              s
              Add
              (Var index-var)
              (I64 lanes)
              (lower-global-shared-view index-ty))
              [(Expr next-s value-ir _)
                (set! s next-s)
                (set! next-index value-ir)])
            (match (lower-vector-loop-next-ok
              s
              (lower-global-shared-view next-index)
              vector-limit)
              [(Expr next-s ok _)
                (set! s next-s)
                (set! vector-ok ok)])
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit
                  s
                  (Branch vector-ok body-label tail-header-label))
                body-label))
            (match (lower-spmd-scan-vector-body
              ctx
              s
              index-var
              next-index
              acc-var
              input-var
              output-var
              prefix-op
              (lower-global-shared-view elem-ty)
              lanes)
              [(Expr body-state _ _)
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit body-state (Jump header-label))
                    tail-header-label))])
            (match (lower-vector-loop-i64-compare
              s
              Lt
              (Var index-var)
              end-value)
              [(Expr next-s condition _)
                (set! s next-s)
                (set! tail-cond condition)])
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit
                  s
                  (Branch tail-cond tail-body-label exit-label))
                tail-body-label))
            (let
              [tail-lowered : LowerExpr
                (try
                  (lower-spmd-scan-scalar-tail-body
                    ctx
                    s
                    env
                    type-env
                    op
                    index-id
                    index-var
                    index-ty
                    prefix-id
                    acc-var
                    elem-ty
                    value
                    body))]
              (match tail-lowered
                [(Expr tail-state _ _)
                  (Ok
                    (Expr
                      (lower-state-finish-block
                        (lower-state-emit tail-state (Jump tail-header-label))
                        exit-label)
                      Unit
                      (Unit)))])))])]))

(define (lower-simd-spmd-scan-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [op : ast.AstReduceOp]
  [index-id : i64]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [prefix-id : i64]
  [prefix-ty : ast.AstType]
  [init : ast.AstExpr]
  [value : ast.AstExpr]
  [body : ast.AstExpr]
  [plan : LowerMaybeVectorScan]) : ResultLowerExpr
  (match plan
    [(Scan input-var output-var prefix-op elem-ty lanes)
      (let
        [init-lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view init)
              prefix-ty
              init))]
        (match init-lowered
          [(Expr init-state init-value _)
            (let
              [end-lowered : LowerExpr
                (try (lower-expr ctx init-state env type-env end))]
              (match end-lowered
                [(Expr end-state end-value _)
                  (let
                    [start-lowered : LowerExpr
                      (try (lower-expr ctx end-state env type-env start))]
                    (match start-lowered
                      [(Expr start-state start-value _)
                        (lower-simd-spmd-scan-build
                          ctx
                          start-state
                          env
                          type-env
                          op
                          index-id
                          index-ty
                          init-value
                          end-value
                          start-value
                          prefix-id
                          value
                          body
                          input-var
                          output-var
                          prefix-op
                          elem-ty
                          lanes)]))]))]))]
    [(No) (Err (box (lower-diagnostic "lower: missing vector scan plan")))]))

(define (lower-avx2-spmd-reduce-build
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-ty : ast.AstType]
  [init-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [op : ast.AstReduceOp]
  [array-var : i64]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc acc-alloc acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-alloc
          (Mov acc-var init-value (lower-global-shared-view elem-ty))))
        [(Alloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (Mov index-var start-value (lower-global-shared-view index-ty)))]
            [header-label : i64 (ir.compiler-ir-label-none)]
            [body-label : i64 (ir.compiler-ir-label-none)]
            [tail-init-label : i64 (ir.compiler-ir-label-none)]
            [tail-header-label : i64 (ir.compiler-ir-label-none)]
            [tail-body-label : i64 (ir.compiler-ir-label-none)]
            [exit-label : i64 (ir.compiler-ir-label-none)]
            [arrays : LowerArrayVarSet
              (lower-array-var-set-add (lower-array-var-set-empty) array-var 0)]
            [vector-limit : ir.CompilerIrValue Unit]
            [vector-start-ok : ir.CompilerIrValue Unit]
            [next-index : ir.CompilerIrValue Unit]
            [vector-ok : ir.CompilerIrValue Unit]
            [tail-cond : ir.CompilerIrValue Unit]
            [vector-acc-var : i64 0]
            [data-ptr : ir.CompilerIrValue Unit]
            (if (lower-spmd-reduce-vector-accumulator?
              (lower-global-shared-view elem-ty))
              (match (lower-state-alloc-var s)
                [(Alloc next-s var)
                  (set! vector-acc-var var)
                  (set!
                    s
                    (lower-state-emit
                      next-s
                      (Splat
                        vector-acc-var
                        (lower-spmd-reduce-vector-accumulator-init op acc-var)
                        lanes
                        (lower-global-shared-view elem-ty))))])
              unit)
            (match (lower-state-fresh-label s "spmd_reduce_avx2_header")
              [(Label next-s label)
                (set! s next-s)
                (set! header-label label)])
            (match (lower-state-fresh-label s "spmd_reduce_avx2_body")
              [(Label next-s label)
                (set! s next-s)
                (set! body-label label)])
            (match (lower-state-fresh-label s "spmd_reduce_tail_header")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-header-label label)])
            (if (lower-spmd-reduce-vector-accumulator?
              (lower-global-shared-view elem-ty))
              (match (lower-state-fresh-label s "spmd_reduce_tail_init")
                [(Label next-s label)
                  (set! s next-s)
                  (set! tail-init-label label)])
              unit)
            (match (lower-state-fresh-label s "spmd_reduce_tail_body")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-body-label label)])
            (match (lower-state-fresh-label s "spmd_reduce_exit")
              [(Label next-s label)
                (set! s next-s)
                (set! exit-label label)])
            (match (lower-vector-loop-limit
              s
              (lower-global-shared-view end-value)
              arrays
              lanes)
              [(Expr next-s value _)
                (set! s next-s)
                (set! vector-limit value)])
            (match (lower-vector-loop-start-ok s index-var lanes)
              [(Expr next-s value _)
                (set! s next-s)
                (set! vector-start-ok value)])
            (match (lower-sequence-data-pointer-value s array-var)
              [(Expr next-s value _)
                (set! s next-s)
                (set! data-ptr value)])
            (if (lower-spmd-reduce-vector-accumulator?
              (lower-global-shared-view elem-ty))
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (Branch vector-start-ok header-label tail-init-label))
                  header-label))
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (Branch vector-start-ok header-label tail-header-label))
                  header-label)))
            (match (lower-emit-binop
              s
              (Add)
              (Var index-var)
              (I64 lanes)
              (lower-global-shared-view index-ty))
              [(Expr next-s value _)
                (set! s next-s)
                (set! next-index value)])
            (match (lower-vector-loop-next-ok
              s
              (lower-global-shared-view next-index)
              vector-limit)
              [(Expr next-s value _)
                (set! s next-s)
                (set! vector-ok value)])
            (if (lower-spmd-reduce-vector-accumulator?
              (lower-global-shared-view elem-ty))
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (Branch vector-ok body-label tail-init-label))
                  body-label))
              (set!
                s
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (Branch vector-ok body-label tail-header-label))
                  body-label)))
            (let
              [body-lowered
                (try
                  (lower-avx2-reduce-vector-body
                    ctx
                    s
                    env
                    type-env
                    op
                    index-var
                    next-index
                    acc-var
                    vector-acc-var
                    data-ptr
                    vector-op
                    (lower-global-shared-view elem-ty)
                    lanes))]
              (match body-lowered
                [(Expr body-state _ _)
                  (set! s body-state)
                  (if (lower-spmd-reduce-vector-accumulator?
                    (lower-global-shared-view elem-ty))
                    (set!
                      s
                      (lower-state-finish-block
                        (lower-state-emit s (Jump header-label))
                        tail-init-label))
                    (set!
                      s
                      (lower-state-finish-block
                        (lower-state-emit s (Jump header-label))
                        tail-header-label)))
                  (when
                    (lower-spmd-reduce-vector-accumulator?
                      (lower-global-shared-view elem-ty))
                    (set!
                      s
                      (lower-spmd-reduce-finish-vector-accumulator
                        s
                        op
                        acc-var
                        vector-acc-var
                        vector-op
                        lanes
                        (lower-global-shared-view elem-ty)))
                    (set!
                      s
                      (lower-state-finish-block
                        (lower-state-emit s (Jump tail-header-label))
                        tail-header-label)))
                  (match (lower-vector-loop-i64-compare
                    s
                    (Lt)
                    (Var index-var)
                    end-value)
                    [(Expr next-s value _)
                      (set! s next-s)
                      (set! tail-cond value)])
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        s
                        (Branch tail-cond tail-body-label exit-label))
                      tail-body-label))
                  (let
                    [tail-lowered
                      (try
                        (lower-spmd-reduce-scalar-tail-body
                          ctx
                          s
                          env
                          type-env
                          op
                          index-var
                          index-ty
                          acc-var
                          array-var
                          (lower-global-shared-view elem-ty)))]
                    (match tail-lowered
                      [(Expr tail-state _ _)
                        (Ok
                          (Expr
                            (lower-state-finish-block
                              (lower-state-emit
                                tail-state
                                (Jump tail-header-label))
                              exit-label)
                            (Var acc-var)
                            elem-ty))]))])))])]))

(define (lower-avx2-spmd-reduce-value-build
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-ty : ast.AstType]
  [init-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [start-value : ir.CompilerIrValue]
  [op : ast.AstReduceOp]
  [value-plan : LowerVectorMapValue]
  [vector-op : ir.CompilerIrVectorReduceOp]
  [elem-ty : ast.AstType]
  [lanes : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc acc-alloc acc-var)
      (match (lower-state-alloc-var
        (lower-state-emit
          acc-alloc
          (Mov acc-var init-value (lower-global-shared-view elem-ty))))
        [(Alloc index-alloc index-var)
          (match (lower-state-alloc-var
            (lower-state-emit
              index-alloc
              (Mov index-var start-value (lower-global-shared-view index-ty))))
            [(Alloc base-alloc tail-base-var)
              (let
                [s : LowerState base-alloc]
                [header-label : i64 (ir.compiler-ir-label-none)]
                [body-label : i64 (ir.compiler-ir-label-none)]
                [tail-init-label : i64 (ir.compiler-ir-label-none)]
                [tail-check-label : i64 (ir.compiler-ir-label-none)]
                [tail-body-label : i64 (ir.compiler-ir-label-none)]
                [exit-label : i64 (ir.compiler-ir-label-none)]
                [arrays : LowerArrayVarSet
                  (lower-vector-map-value-array-vars
                    (lower-global-shared-view value-plan))]
                [vector-limit : ir.CompilerIrValue Unit]
                [vector-start-ok : ir.CompilerIrValue Unit]
                [next-index : ir.CompilerIrValue Unit]
                [vector-ok : ir.CompilerIrValue Unit]
                [active-lanes : ir.CompilerIrValue Unit]
                [tail-cond : ir.CompilerIrValue Unit]
                [vector-acc-var : i64 0]
                [preheader-cache : LowerVectorMapValueCache
                  (lower-vector-map-value-cache-empty)]
                (if (lower-spmd-reduce-vector-accumulator?
                  (lower-global-shared-view elem-ty))
                  (match (lower-state-alloc-var s)
                    [(Alloc next-s var)
                      (set! vector-acc-var var)
                      (set!
                        s
                        (lower-state-emit
                          next-s
                          (Splat
                            vector-acc-var
                            (lower-spmd-reduce-vector-accumulator-init
                              op
                              acc-var)
                            lanes
                            (lower-global-shared-view elem-ty))))])
                  unit)
                (match (lower-state-fresh-label s "spmd_reduce_value_header")
                  [(Label next-s label)
                    (set! s next-s)
                    (set! header-label label)])
                (match (lower-state-fresh-label s "spmd_reduce_value_body")
                  [(Label next-s label)
                    (set! s next-s)
                    (set! body-label label)])
                (match (lower-state-fresh-label s "spmd_reduce_value_tail_init")
                  [(Label next-s label)
                    (set! s next-s)
                    (set! tail-init-label label)])
                (match (lower-state-fresh-label
                  s
                  "spmd_reduce_value_tail_check")
                  [(Label next-s label)
                    (set! s next-s)
                    (set! tail-check-label label)])
                (match (lower-state-fresh-label s "spmd_reduce_value_tail_body")
                  [(Label next-s label)
                    (set! s next-s)
                    (set! tail-body-label label)])
                (match (lower-state-fresh-label s "spmd_reduce_value_exit")
                  [(Label next-s label)
                    (set! s next-s)
                    (set! exit-label label)])
                (match (lower-vector-loop-limit
                  s
                  (lower-global-shared-view end-value)
                  arrays
                  lanes)
                  [(Expr next-s value _)
                    (set! s next-s)
                    (set! vector-limit value)])
                (match (lower-vector-loop-start-ok s index-var lanes)
                  [(Expr next-s value _)
                    (set! s next-s)
                    (set! vector-start-ok value)])
                (match (lower-vector-map-preheader-cache-plan
                  s
                  arrays
                  lanes
                  (lower-global-shared-view elem-ty)
                  (lower-global-shared-view value-plan))
                  [(Emit next-s _ next-cache)
                    (set! s next-s)
                    (set! preheader-cache next-cache)])
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (Branch vector-start-ok header-label tail-init-label))
                    header-label))
                (match (lower-emit-binop
                  s
                  (Add)
                  (Var index-var)
                  (I64 lanes)
                  (lower-global-shared-view index-ty))
                  [(Expr next-s value _)
                    (set! s next-s)
                    (set! next-index value)])
                (match (lower-vector-loop-next-ok
                  s
                  (lower-global-shared-view next-index)
                  vector-limit)
                  [(Expr next-s value _)
                    (set! s next-s)
                    (set! vector-ok value)])
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit
                      s
                      (Branch vector-ok body-label tail-init-label))
                    body-label))
                (let
                  [body-lowered
                    (try
                      (lower-avx2-reduce-vector-value-body
                        ctx
                        s
                        env
                        type-env
                        op
                        index-var
                        next-index
                        acc-var
                        vector-acc-var
                        (lower-global-shared-view value-plan)
                        preheader-cache
                        vector-op
                        (lower-global-shared-view elem-ty)
                        lanes))]
                  (match body-lowered
                    [(Expr body-state _ _)
                      (set! s body-state)
                      (set!
                        s
                        (lower-state-finish-block
                          (lower-state-emit s (Jump header-label))
                          tail-init-label))
                      (if (lower-spmd-reduce-vector-accumulator?
                        (lower-global-shared-view elem-ty))
                        (set!
                          s
                          (lower-spmd-reduce-finish-vector-accumulator
                            s
                            op
                            acc-var
                            vector-acc-var
                            vector-op
                            lanes
                            (lower-global-shared-view elem-ty)))
                        unit)
                      (set!
                        s
                        (lower-state-emit
                          s
                          (Mov
                            tail-base-var
                            (Var index-var)
                            (lower-global-shared-view index-ty))))
                      (match (lower-emit-binop
                        s
                        Sub
                        (lower-global-shared-view end-value)
                        (Var index-var)
                        (I64))
                        [(Expr next-s value _)
                          (set! s next-s)
                          (set! active-lanes value)])
                      (set!
                        s
                        (lower-state-finish-block
                          (lower-state-emit s (Jump tail-check-label))
                          tail-check-label))
                      (match (lower-vector-loop-i64-compare
                        s
                        (Lt)
                        (Var index-var)
                        end-value)
                        [(Expr next-s value _)
                          (set! s next-s)
                          (set! tail-cond value)])
                      (set!
                        s
                        (lower-state-finish-block
                          (lower-state-emit
                            s
                            (Branch tail-cond tail-body-label exit-label))
                          tail-body-label))
                      (let
                        [tail-lowered
                          (try
                            (lower-spmd-reduce-scalar-tail-value-body
                              ctx
                              s
                              env
                              type-env
                              op
                              tail-base-var
                              index-var
                              active-lanes
                              index-ty
                              acc-var
                              value-plan
                              (lower-global-shared-view elem-ty)
                              lanes))]
                        (match tail-lowered
                          [(Expr tail-state _ _)
                            (Ok
                              (Expr
                                (lower-state-finish-block
                                  (lower-state-emit
                                    tail-state
                                    (Jump tail-check-label))
                                  exit-label)
                                (Var acc-var)
                                elem-ty))]))])))])])]))

(define (lower-avx2-spmd-reduce-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [init : ast.AstExpr]
  [op : ast.AstReduceOp]
  [plan : LowerMaybeVectorReduce]) : ResultLowerExpr
  (match plan
    [(Array array-var vector-op elem-ty lanes)
      (let
        [init-lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view init)
              (lower-global-shared-view elem-ty)
              init))]
        (match init-lowered
          [(Expr init-state init-value _)
            (let
              [end-lowered : LowerExpr
                (try (lower-expr ctx init-state env type-env end))]
              (match end-lowered
                [(Expr end-state end-value _)
                  (let
                    [start-lowered : LowerExpr
                      (try (lower-expr ctx end-state env type-env start))]
                    (match start-lowered
                      [(Expr start-state start-value _)
                        (lower-avx2-spmd-reduce-build
                          ctx
                          start-state
                          env
                          type-env
                          index-ty
                          init-value
                          end-value
                          start-value
                          op
                          array-var
                          vector-op
                          elem-ty
                          lanes)]))]))]))]
    [(Value value-plan vector-op elem-ty lanes)
      (let
        [init-lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view init)
              (lower-global-shared-view elem-ty)
              init))]
        (match init-lowered
          [(Expr init-state init-value _)
            (let
              [end-lowered : LowerExpr
                (try (lower-expr ctx init-state env type-env end))]
              (match end-lowered
                [(Expr end-state end-value _)
                  (let
                    [start-lowered : LowerExpr
                      (try (lower-expr ctx end-state env type-env start))]
                    (match start-lowered
                      [(Expr start-state start-value _)
                        (lower-avx2-spmd-reduce-value-build
                          ctx
                          start-state
                          env
                          type-env
                          index-ty
                          init-value
                          end-value
                          start-value
                          op
                          value-plan
                          vector-op
                          elem-ty
                          lanes)]))]))]))]
    [(No) (Err (box (lower-diagnostic "lower: missing vector reduce plan")))]))

(define (lower-emit-tail-mask
  [state : LowerState]
  [index : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit s (TailMask v index end-value lanes))
        (Var v)
        (Bool))]))

(define (lower-emit-predicated-load-data
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc s v)
      (Expr
        (lower-state-emit
          s
          (ir.ir-instr-predicated-load
            v
            data-ptr
            index
            mask
            lanes
            (lower-global-shared-view elem-ty)))
        (Var v)
        elem-ty)]))

(define (lower-emit-predicated-store-data
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (lower-state-emit
    state
    (ir.ir-instr-predicated-store data-ptr index value mask lanes elem-ty)))

(define (lower-emit-sequence-predicated-load
  [state : LowerState]
  [sequence-var : i64]
  [index : ir.CompilerIrValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-sequence-data-pointer-value state sequence-var)
    [(Expr data-state data-ptr _)
      (lower-emit-predicated-load-data
        data-state
        data-ptr
        index
        mask
        lanes
        elem-ty)]))

(define (lower-emit-sequence-predicated-store
  [state : LowerState]
  [sequence-var : i64]
  [index : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (match (lower-sequence-data-pointer-value state sequence-var)
    [(Expr data-state data-ptr _)
      (lower-emit-predicated-store-data
        data-state
        data-ptr
        index
        value
        mask
        lanes
        elem-ty)]))

(define (lower-emit-spmd-broadcast-lane-check
  [state : LowerState]
  [lane : ir.CompilerIrValue]
  [active-lanes : ir.CompilerIrValue]) : LowerState
  (match (lower-emit-bounds-operand state lane (I64))
    [(Expr lane-state lane-u _)
      (match (lower-emit-bounds-operand lane-state active-lanes (I64))
        [(Expr count-state count-u _)
          (lower-emit-bounds-check count-state lane-u count-u)])]))

(define (lower-emit-spmd-broadcast-array
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [array-var : i64]
  [lane : ir.CompilerIrValue]
  [active-lanes : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-binop
    (lower-emit-spmd-broadcast-lane-check
      state
      (lower-global-shared-view lane)
      active-lanes)
    Add
    (Var index-var)
    lane
    (I64))
    [(Expr index-state source-index _)
      (match (lower-sequence-element-addr
        ctx
        index-state
        array-var
        source-index
        (I64)
        (lower-global-shared-view elem-ty))
        [(Expr addr-state source-addr _)
          (match (lower-emit-load
            addr-state
            source-addr
            (lower-global-shared-view elem-ty))
            [(Expr load-state source-value _)
              (lower-emit-splat load-state source-value lanes elem-ty)])])]))

(define (lower-vector-map-ir-value-eq?
  [left : ir.CompilerIrValue]
  [right : ir.CompilerIrValue]) : bool
  ;; Vector-map uniform values are restricted by the planner to local numeric
  ;; variables and numeric scalar literals. Broadcast lane operands use the
  ;; same subset. Keep this comparator aligned with that invariant instead of
  ;; paying for unrelated pointer, function, string, and unit IR variants.
  (match left
    [(Var a)
      (match right
        [(Var b) (= a b)]
        [_ false])]
    [(I64 a)
      (match right
        [(I64 b) (= a b)]
        [_ false])]
    [(F64 a)
      (match right
        [(F64 b) (= a b)]
        [_ false])]
    [_ false]))

(define (lower-vector-map-binop-eq?
  [left : ir.CompilerIrBinOp]
  [right : ir.CompilerIrBinOp]) : bool
  (match left
    [(Add)
      (match right
        [(Add) true]
        [_ false])]
    [(Sub)
      (match right
        [(Sub) true]
        [_ false])]
    [(Mul)
      (match right
        [(Mul) true]
        [_ false])]
    [(BitAnd)
      (match right
        [(BitAnd) true]
        [_ false])]
    [(BitOr)
      (match right
        [(BitOr) true]
        [_ false])]
    [(BitXor)
      (match right
        [(BitXor) true]
        [_ false])]
    [(Shl left-count-ty)
      (match right
        [(Shl right-count-ty) (tc_core.tc-type-eq left-count-ty right-count-ty)]
        [_ false])]
    [(Shr left-count-ty)
      (match right
        [(Shr right-count-ty) (tc_core.tc-type-eq left-count-ty right-count-ty)]
        [_ false])]
    [_ false]))

(define (lower-vector-map-value-key-eq?
  [left : LowerVectorMapValueKey]
  [right : LowerVectorMapValueKey]) : bool
  (match left
    [(Array left-array)
      (match right
        [(Array right-array) (= left-array right-array)]
        [_ false])]
    [(ArrayData left-array)
      (match right
        [(ArrayData right-array) (= left-array right-array)]
        [_ false])]
    [(Gather left-source left-indexes)
      (match right
        [(Gather right-source right-indexes)
          (and (= left-source right-source) (= left-indexes right-indexes))]
        [_ false])]
    [(GatherLaneOffset left-source left-offsets)
      (match right
        [(GatherLaneOffset right-source right-offsets)
          (and (= left-source right-source) (= left-offsets right-offsets))]
        [_ false])]
    [(LaneArray left-array)
      (match right
        [(LaneArray right-array) (= left-array right-array)]
        [_ false])]
    [(Uniform left-value)
      (match right
        [(Uniform right-value)
          (lower-vector-map-ir-value-eq? left-value right-value)]
        [_ false])]
    [(BroadcastArray left-array left-lane)
      (match right
        [(BroadcastArray right-array right-lane)
          (and
            (= left-array right-array)
            (lower-vector-map-ir-value-eq? left-lane right-lane))]
        [_ false])]
    [(LaneIndex)
      (match right
        [(LaneIndex) true]
        [_ false])]
    [(LaneCount)
      (match right
        [(LaneCount) true]
        [_ false])]
    [(BinOp left-op left-lhs left-rhs)
      (match right
        [(BinOp right-op right-lhs right-rhs)
          (and
            (lower-vector-map-binop-eq? left-op right-op)
            (lower-vector-map-ir-value-eq? left-lhs right-lhs)
            (lower-vector-map-ir-value-eq? left-rhs right-rhs))]
        [_ false])]))

(define (lower-vector-map-value-cache-empty) : LowerVectorMapValueCache
  (LowerVectorMapValueCache
    (__tl_make-array LowerVectorMapValueKey 0)
    (__tl_make-array ir.CompilerIrValue 0)
    0))

(define (lower-vector-map-value-cache-lookup
  [cache : (& cache LowerVectorMapValueCache)]
  [key : LowerVectorMapValueKey]) : LowerMaybeIrValue
  (let
    [index : i64 0]
    [found : LowerMaybeIrValue (No)]
    (while (and
      (< index cache.count)
      (match (lower-global-shared-view found)
        [(No) true]
        [(Some _) false]))
      (if (lower-vector-map-value-key-eq?
        (lower-global-shared-view key)
        (lower-global-array-element-shared-view cache.keys index))
        (set!
          found
          (Some (lower-global-array-element-shared-view cache.values index)))
        (set! index (+ index 1))))
    found))

(define (lower-vector-map-value-cache-add
  [cache : LowerVectorMapValueCache]
  [key : LowerVectorMapValueKey]
  [value : ir.CompilerIrValue]) : LowerVectorMapValueCache
  (let
    [keys : (__tl_dyn-array LowerVectorMapValueKey) cache.keys]
    [values : (__tl_dyn-array ir.CompilerIrValue) cache.values]
    [count : i64 cache.count]
    (__tl_array-push! keys key)
    (__tl_array-push! values value)
    (LowerVectorMapValueCache keys values (+ count 1))))

;; Populate the vector-map cache in the entry block with values whose source
;; operands cannot change between gangs. The simple-map planner accepts only
;; literals and already-bound scalar vars for `Uniform`; safe SPMD rejects
;; mutation of bindings declared outside the body, so these materializations
;; dominate both the full vector loop and its masked AVX-512 tail.
(define (lower-vector-map-preheader-cache-leaves
  [state : LowerState]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (match plan
    [(Uniform value)
      (match (lower-vector-map-value-cache-lookup
        cache
        (Uniform (lower-global-shared-view value)))
        [(Some cached) (Emit state cached cache)]
        [(No)
          (lower-vector-map-cache-emitted
            (lower-emit-splat
              state
              (lower-global-shared-view value)
              lanes
              elem-ty)
            (Uniform value)
            cache)])]
    [(LaneIndex)
      (match (lower-vector-map-value-cache-lookup cache (LaneIndex))
        [(Some cached) (Emit state cached cache)]
        [(No)
          (lower-vector-map-cache-emitted
            (lower-emit-lane-id state lanes elem-ty)
            (LaneIndex)
            cache)])]
    [(LaneCount)
      (match (lower-vector-map-value-cache-lookup cache (LaneCount))
        [(Some cached) (Emit state cached cache)]
        [(No)
          (lower-vector-map-cache-emitted
            (lower-emit-splat state (I64 lanes) lanes elem-ty)
            (LaneCount)
            cache)])]
    ;; Shuffle selectors may span two i64 vectors when the element lane count
    ;; exceeds the selector lane count. Its emitter owns that split, so a
    ;; generic leaf cache would materialize an unused, incorrectly shaped ID.
    [(Shuffle _ _) (Emit state Unit cache)]
    [(Stage staged value)
      (match (lower-vector-map-preheader-cache-leaves
        state
        lanes
        (lower-global-shared-view elem-ty)
        (deref staged)
        cache)
        [(Emit staged-state _ staged-cache)
          (lower-vector-map-preheader-cache-leaves
            staged-state
            lanes
            elem-ty
            (deref value)
            staged-cache)])]
    [(BinOp _ lhs rhs)
      (match (lower-vector-map-preheader-cache-leaves
        state
        lanes
        (lower-global-shared-view elem-ty)
        (deref lhs)
        cache)
        [(Emit lhs-state _ lhs-cache)
          (lower-vector-map-preheader-cache-leaves
            lhs-state
            lanes
            elem-ty
            (deref rhs)
            lhs-cache)])]
    [_ (Emit state Unit cache)]))

(define (lower-vector-map-preheader-cache-array-data
  [state : LowerState]
  [arrays : (& arrays LowerArrayVarSet)]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (let
    [s : LowerState state]
    [next-cache : LowerVectorMapValueCache cache]
    [index : i64 0]
    (while (< index arrays.count)
      (let
        [array-var : i64 (array-ref arrays.vars index)]
        (match (lower-sequence-data-pointer-value s array-var)
          [(Expr next-s data-ptr _)
            (set! s next-s)
            (set!
              next-cache
              (lower-vector-map-value-cache-add
                next-cache
                (ArrayData array-var)
                data-ptr))])
        (set! index (+ index 1))))
    (Emit s Unit next-cache)))

(define (lower-vector-map-preheader-cache-plan
  [state : LowerState]
  [arrays : LowerArrayVarSet]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]) : LowerVectorMapCachedEmit
  (match (lower-vector-map-preheader-cache-array-data
    state
    arrays
    (lower-vector-map-value-cache-empty))
    [(Emit data-state _ data-cache)
      (lower-vector-map-preheader-cache-leaves
        data-state
        lanes
        elem-ty
        plan
        data-cache)]))

(define (lower-vector-map-preheader-cache-stores
  [state : LowerState]
  [arrays : (& arrays LowerArrayVarSet)]
  [stores : LowerVectorMapStoreList]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerVectorMapCachedEmit
  (match (lower-vector-map-preheader-cache-array-data
    state
    arrays
    (lower-vector-map-value-cache-empty))
    [(Emit data-state _ data-cache)
      (let
        [s : LowerState data-state]
        [cache : LowerVectorMapValueCache data-cache]
        [index : i64 0]
        (while (< index stores.count)
          (match (lower-vector-map-store-list-ref stores index)
            [(LowerVectorMapStore _ value-plan)
              (match (lower-vector-map-preheader-cache-leaves
                s
                lanes
                (lower-global-shared-view elem-ty)
                value-plan
                (lower-global-shared-view cache))
                [(Emit next-s _ next-cache)
                  (set! s next-s)
                  (set! cache next-cache)])])
          (set! index (+ index 1)))
        (Emit s Unit cache))]))

(define (lower-emit-shuffle-selector-plan
  [state : LowerState]
  [index : ir.CompilerIrValue]
  [lane-offset : i64]
  [gang-count : ir.CompilerIrValue]
  [lanes : i64]
  [plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match plan
    [(Array array-var)
      (match emit-mode
        [(Full)
          (lower-emit-sequence-vector-load state array-var index lanes (I64))]
        [(Predicated _ mask)
          (lower-emit-sequence-predicated-load
            state
            array-var
            index
            mask
            lanes
            (I64))])]
    [(Uniform value) (lower-emit-splat state value lanes (I64))]
    [(LaneIndex)
      (match (lower-emit-lane-id state lanes (I64))
        [(Expr lane-state lane-value _)
          (if (= lane-offset 0)
            (Expr lane-state lane-value (I64))
            (match (lower-emit-splat lane-state (I64 lane-offset) lanes (I64))
              [(Expr offset-state offset-value _)
                (lower-emit-vector-binop
                  offset-state
                  Add
                  lane-value
                  offset-value
                  lanes
                  (I64))]))])]
    [(LaneCount) (lower-emit-splat state (I64 lanes) lanes (I64))]
    [(Stage staged value)
      (match (lower-emit-shuffle-selector-plan
        state
        (lower-global-shared-view index)
        lane-offset
        (lower-global-shared-view gang-count)
        lanes
        (deref staged)
        (lower-global-shared-view emit-mode))
        [(Expr staged-state _ _)
          (lower-emit-shuffle-selector-plan
            staged-state
            index
            lane-offset
            gang-count
            lanes
            (deref value)
            emit-mode)])]
    [(BinOp op lhs rhs)
      (match (lower-emit-shuffle-selector-plan
        state
        (lower-global-shared-view index)
        lane-offset
        (lower-global-shared-view gang-count)
        lanes
        (deref lhs)
        (lower-global-shared-view emit-mode))
        [(Expr lhs-state lhs-value _)
          (match (lower-emit-shuffle-selector-plan
            lhs-state
            index
            lane-offset
            gang-count
            lanes
            (deref rhs)
            (lower-global-shared-view emit-mode))
            [(Expr rhs-state rhs-value _)
              (match (lower-emit-vector-map-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                (I64)
                (lower-global-shared-view emit-mode))
                [(Expr binop-state binop-value _)
                  (match emit-mode
                    [(Full) (Expr binop-state binop-value (I64))]
                    [(Predicated _ mask)
                      ;; The backend validates a selector vector in one step.
                      ;; Keep inactive destination lanes at zero so their
                      ;; unevaluated selector expressions cannot contribute a
                      ;; false out-of-range bit to that reduction.
                      (match (lower-emit-splat binop-state (I64 0) lanes (I64))
                        [(Expr zero-state zero-value _)
                          (lower-emit-select
                            zero-state
                            mask
                            binop-value
                            zero-value
                            lanes
                            (I64))])])])])])]
    ;; The planner rejects these forms before constructing Shuffle.
    [_ (Expr state Unit (I64))]))

(define (lower-emit-dynamic-vector-shuffle
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [source-plan : LowerVectorMapValue]
  [selector-plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (let
    [selector-lanes : i64
      (lower-simd-lanes-for-elem (lower-state-mode state) (I64))]
    [index-value : ir.CompilerIrValue (Var index-var)]
    (match emit-mode
      [(Full)
        (match (lower-emit-vector-map-value
          ctx
          state
          index-var
          lanes
          (lower-global-shared-view elem-ty)
          source-plan)
          [(Expr source-state source-value _)
            (match (lower-emit-shuffle-selector-plan
              source-state
              (lower-global-shared-view index-value)
              0
              (I64 lanes)
              selector-lanes
              (lower-global-shared-view selector-plan)
              (Full))
              [(Expr low-state selector-low _)
                (if (> lanes selector-lanes)
                  (match (lower-emit-binop
                    low-state
                    Add
                    index-value
                    (I64 selector-lanes)
                    (I64))
                    [(Expr high-index-state high-index _)
                      (match (lower-emit-shuffle-selector-plan
                        high-index-state
                        high-index
                        selector-lanes
                        (I64 lanes)
                        selector-lanes
                        selector-plan
                        (Full))
                        [(Expr high-state selector-high _)
                          (lower-emit-vector-shuffle-instr
                            high-state
                            source-value
                            selector-low
                            (Some selector-high)
                            (I64 lanes)
                            lanes
                            elem-ty)])])
                  (lower-emit-vector-shuffle-instr
                    low-state
                    source-value
                    selector-low
                    (No)
                    (I64 lanes)
                    lanes
                    elem-ty))])])]
      [(Predicated end-value source-mask)
        (match (lower-emit-binop
          state
          Sub
          (lower-global-shared-view end-value)
          (lower-global-shared-view index-value)
          (I64))
          [(Expr count-state active-lanes _)
            (match (lower-emit-predicated-vector-map-value
              ctx
              count-state
              index-var
              (lower-global-shared-view end-value)
              source-mask
              lanes
              (lower-global-shared-view elem-ty)
              source-plan)
              [(Expr source-state source-value _)
                (match (lower-emit-tail-mask
                  source-state
                  (lower-global-shared-view index-value)
                  (lower-global-shared-view end-value)
                  selector-lanes)
                  [(Expr low-mask-state low-mask _)
                    (match (lower-emit-shuffle-selector-plan
                      low-mask-state
                      (lower-global-shared-view index-value)
                      0
                      (lower-global-shared-view active-lanes)
                      selector-lanes
                      (lower-global-shared-view selector-plan)
                      (Predicated (lower-global-shared-view end-value) low-mask))
                      [(Expr low-state selector-low _)
                        (if (> lanes selector-lanes)
                          (match (lower-emit-binop
                            low-state
                            Add
                            index-value
                            (I64 selector-lanes)
                            (I64))
                            [(Expr high-index-state high-index _)
                              (match (lower-global-shared-view high-index)
                                [(Var high-index-var)
                                  (match (lower-emit-tail-mask
                                    high-index-state
                                    (lower-global-shared-view high-index)
                                    (lower-global-shared-view end-value)
                                    selector-lanes)
                                    [(Expr high-mask-state high-mask _)
                                      (match (lower-emit-shuffle-selector-plan
                                        high-mask-state
                                        high-index
                                        selector-lanes
                                        (lower-global-shared-view active-lanes)
                                        selector-lanes
                                        selector-plan
                                        (Predicated end-value high-mask))
                                        [(Expr high-state selector-high _)
                                          (lower-emit-vector-shuffle-instr
                                            high-state
                                            source-value
                                            selector-low
                                            (Some selector-high)
                                            active-lanes
                                            lanes
                                            elem-ty)])])]
                                [_ (Expr high-index-state Unit elem-ty)])])
                          (lower-emit-vector-shuffle-instr
                            low-state
                            source-value
                            selector-low
                            (No)
                            active-lanes
                            lanes
                            elem-ty))])])])])])))

(define (lower-emit-vector-shuffle
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [source-plan : LowerVectorMapValue]
  [selector-plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match (lower-global-shared-view selector-plan)
    ;; Each active destination lane selects itself. Keep the Shuffle marker in
    ;; the plan so the SIMD planner knows this expression was handled, but emit
    ;; the source directly for both full and partial gangs.
    [(LaneIndex)
      (match emit-mode
        [(Full)
          (lower-emit-vector-map-value
            ctx
            state
            index-var
            lanes
            elem-ty
            source-plan)]
        [(Predicated end-value mask)
          (lower-emit-predicated-vector-map-value
            ctx
            state
            index-var
            end-value
            mask
            lanes
            elem-ty
            source-plan)])]
    [_
      (lower-emit-dynamic-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        source-plan
        selector-plan
        emit-mode)]))

(define (lower-emit-vector-map-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(Array array-var)
      (lower-emit-sequence-vector-load
        state
        array-var
        (Var index-var)
        lanes
        elem-ty)]
    [(Gather source-var indexes-var)
      (match (lower-sequence-len-value state source-var)
        [(Expr len-state source-len _)
          (match (lower-sequence-data-pointer-value len-state source-var)
            [(Expr source-state source-data _)
              (match (lower-sequence-data-pointer-value
                source-state
                indexes-var)
                [(Expr indexes-state indexes-data _)
                  (match (lower-emit-gather-lane-checks
                    ctx
                    indexes-state
                    (lower-global-shared-view indexes-data)
                    index-var
                    0
                    lanes
                    source-len)
                    [(Expr checked-state _ _)
                      (lower-emit-gather-load
                        checked-state
                        source-data
                        indexes-data
                        (Var index-var)
                        false
                        lanes
                        elem-ty)])])])])]
    [(GatherLaneOffset source-var offsets-var)
      (match (lower-sequence-len-value state source-var)
        [(Expr len-state source-len _)
          (match (lower-sequence-data-pointer-value len-state source-var)
            [(Expr source-state source-data _)
              (match (lower-sequence-len-value source-state offsets-var)
                [(Expr offsets-len-state offsets-len _)
                  (match (lower-sequence-data-pointer-value
                    (lower-emit-bounds-check
                      offsets-len-state
                      (I64 (- lanes 1))
                      offsets-len)
                    offsets-var)
                    [(Expr offsets-state offsets-data _)
                      (match (lower-emit-gather-lane-offset-checks
                        offsets-state
                        (lower-global-shared-view offsets-data)
                        index-var
                        0
                        lanes
                        source-len)
                        [(Expr checked-state _ _)
                          (lower-emit-gather-load
                            checked-state
                            source-data
                            offsets-data
                            (Var index-var)
                            true
                            lanes
                            elem-ty)])])])])])]
    [(LaneArray array-var)
      (match (lower-sequence-len-value state array-var)
        [(Expr len-state array-len _)
          (lower-emit-sequence-vector-load
            (lower-emit-bounds-check len-state (I64 (- lanes 1)) array-len)
            array-var
            (I64 0)
            lanes
            elem-ty)])]
    [(Uniform value) (lower-emit-splat state value lanes elem-ty)]
    [(BroadcastArray array-var lane)
      (lower-emit-spmd-broadcast-array
        ctx
        state
        index-var
        array-var
        lane
        (I64 lanes)
        lanes
        elem-ty)]
    [(LaneIndex) (lower-emit-lane-id state lanes elem-ty)]
    [(LaneCount) (lower-emit-splat state (I64 lanes) lanes elem-ty)]
    [(Shuffle source selector)
      (lower-emit-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        (deref source)
        (deref selector)
        (Full))]
    [(Stage staged value)
      (match (lower-emit-vector-map-value
        ctx
        state
        index-var
        lanes
        (lower-global-shared-view elem-ty)
        (deref staged))
        [(Expr staged-state _ _)
          (lower-emit-vector-map-value
            ctx
            staged-state
            index-var
            lanes
            elem-ty
            (deref value))])]
    [(BinOp op lhs rhs)
      (match (lower-emit-vector-map-value
        ctx
        state
        index-var
        lanes
        (lower-global-shared-view elem-ty)
        (deref lhs))
        [(Expr lhs-state lhs-value _)
          (match (lower-emit-vector-map-value
            ctx
            lhs-state
            index-var
            lanes
            (lower-global-shared-view elem-ty)
            (deref rhs))
            [(Expr rhs-state rhs-value _)
              (lower-emit-vector-map-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                elem-ty
                (Full))])])]))

(define (lower-vector-map-cache-emitted
  [emitted : LowerExpr]
  [key : LowerVectorMapValueKey]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (match emitted
    [(Expr state value _)
      (Emit
        state
        (lower-global-shared-view value)
        (lower-vector-map-value-cache-add cache key value))]))

(define (lower-emit-vector-map-value-for-mode
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match emit-mode
    [(Full)
      (lower-emit-vector-map-value ctx state index-var lanes elem-ty plan)]
    [(Predicated end-value mask)
      (lower-emit-predicated-vector-map-value
        ctx
        state
        index-var
        end-value
        mask
        lanes
        elem-ty
        plan)]))

(define (lower-emit-vector-array-data-for-mode
  [state : LowerState]
  [data-ptr : ir.CompilerIrValue]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [emit-mode : LowerVectorMapEmitMode]) : LowerExpr
  (match emit-mode
    [(Full)
      (lower-emit-vector-load-data state data-ptr (Var index-var) lanes elem-ty)]
    [(Predicated _ mask)
      (lower-emit-predicated-load-data
        state
        data-ptr
        (Var index-var)
        mask
        lanes
        elem-ty)]))

(define (lower-emit-vector-map-value-cached
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]
  [emit-mode : LowerVectorMapEmitMode]
  [cache : LowerVectorMapValueCache]) : LowerVectorMapCachedEmit
  (match plan
    [(Array array-var)
      (match (lower-vector-map-value-cache-lookup cache (Array array-var))
        [(Some value) (Emit state value cache)]
        [(No)
          (match (lower-vector-map-value-cache-lookup
            cache
            (ArrayData array-var))
            [(Some data-ptr)
              (lower-vector-map-cache-emitted
                (lower-emit-vector-array-data-for-mode
                  state
                  data-ptr
                  index-var
                  lanes
                  elem-ty
                  emit-mode)
                (Array array-var)
                cache)]
            [(No)
              (lower-vector-map-cache-emitted
                (lower-emit-vector-map-value-for-mode
                  ctx
                  state
                  index-var
                  lanes
                  elem-ty
                  (Array array-var)
                  emit-mode)
                (Array array-var)
                cache)])])]
    [(Gather source-var indexes-var)
      (match (lower-vector-map-value-cache-lookup
        cache
        (Gather source-var indexes-var))
        [(Some value) (Emit state value cache)]
        [(No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (Gather source-var indexes-var)
              emit-mode)
            (Gather source-var indexes-var)
            cache)])]
    [(GatherLaneOffset source-var offsets-var)
      (match (lower-vector-map-value-cache-lookup
        cache
        (GatherLaneOffset source-var offsets-var))
        [(Some value) (Emit state value cache)]
        [(No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (GatherLaneOffset source-var offsets-var)
              emit-mode)
            (GatherLaneOffset source-var offsets-var)
            cache)])]
    [(LaneArray array-var)
      (match (lower-vector-map-value-cache-lookup cache (LaneArray array-var))
        [(Some value) (Emit state value cache)]
        [(No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LaneArray array-var)
              emit-mode)
            (LaneArray array-var)
            cache)])]
    [(Uniform uniform-value)
      (match (lower-vector-map-value-cache-lookup
        cache
        (Uniform (lower-global-shared-view uniform-value)))
        [(Some value) (Emit state value cache)]
        [(No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (Uniform (lower-global-shared-view uniform-value))
              emit-mode)
            (Uniform uniform-value)
            cache)])]
    [(BroadcastArray array-var lane)
      (match (lower-vector-map-value-cache-lookup
        cache
        (BroadcastArray array-var (lower-global-shared-view lane)))
        [(Some value) (Emit state value cache)]
        [(No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (BroadcastArray array-var (lower-global-shared-view lane))
              emit-mode)
            (BroadcastArray array-var lane)
            cache)])]
    [(LaneIndex)
      (match (lower-vector-map-value-cache-lookup cache (LaneIndex))
        [(Some value) (Emit state value cache)]
        [(No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LaneIndex)
              emit-mode)
            (LaneIndex)
            cache)])]
    [(LaneCount)
      (match (lower-vector-map-value-cache-lookup cache (LaneCount))
        [(Some value) (Emit state value cache)]
        [(No)
          (lower-vector-map-cache-emitted
            (lower-emit-vector-map-value-for-mode
              ctx
              state
              index-var
              lanes
              elem-ty
              (LaneCount)
              emit-mode)
            (LaneCount)
            cache)])]
    [(Shuffle source selector)
      (match (lower-emit-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        (deref source)
        (deref selector)
        emit-mode)
        [(Expr shuffle-state shuffle-value _)
          (Emit shuffle-state shuffle-value cache)])]
    [(Stage staged value)
      (match (lower-emit-vector-map-value-cached
        ctx
        state
        index-var
        lanes
        (lower-global-shared-view elem-ty)
        (deref staged)
        (lower-global-shared-view emit-mode)
        cache)
        [(Emit staged-state _ staged-cache)
          (lower-emit-vector-map-value-cached
            ctx
            staged-state
            index-var
            lanes
            elem-ty
            (deref value)
            emit-mode
            staged-cache)])]
    [(BinOp op lhs rhs)
      (match (lower-emit-vector-map-value-cached
        ctx
        state
        index-var
        lanes
        (lower-global-shared-view elem-ty)
        (deref lhs)
        (lower-global-shared-view emit-mode)
        cache)
        [(Emit lhs-state lhs-value lhs-cache)
          (match (lower-emit-vector-map-value-cached
            ctx
            lhs-state
            index-var
            lanes
            (lower-global-shared-view elem-ty)
            (deref rhs)
            (lower-global-shared-view emit-mode)
            lhs-cache)
            [(Emit rhs-state rhs-value rhs-cache)
              (match (lower-vector-map-value-cache-lookup
                rhs-cache
                (BinOp
                  (lower-global-shared-view op)
                  (lower-global-shared-view lhs-value)
                  (lower-global-shared-view rhs-value)))
                [(Some value) (Emit rhs-state value rhs-cache)]
                [(No)
                  (lower-vector-map-cache-emitted
                    (lower-emit-vector-map-binop
                      rhs-state
                      (lower-global-shared-view op)
                      (lower-global-shared-view lhs-value)
                      (lower-global-shared-view rhs-value)
                      lanes
                      elem-ty
                      emit-mode)
                    (BinOp op lhs-value rhs-value)
                    rhs-cache)])])])]))

(define (lower-emit-predicated-vector-map-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : ir.CompilerIrValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(Array array-var)
      (lower-emit-sequence-predicated-load
        state
        array-var
        (Var index-var)
        mask
        lanes
        elem-ty)]
    ;; Gather maps use the scalar tail path so only active lanes are checked.
    [(Gather _ _) (Expr state Unit elem-ty)]
    [(GatherLaneOffset _ _) (Expr state Unit elem-ty)]
    [(LaneArray array-var)
      (match (lower-emit-binop state Sub end-value (Var index-var) (I64))
        [(Expr count-state active-lanes _)
          (match (lower-emit-binop count-state Sub active-lanes (I64 1) (I64))
            [(Expr last-state last-lane _)
              (match (lower-sequence-len-value last-state array-var)
                [(Expr len-state array-len _)
                  (lower-emit-sequence-predicated-load
                    (lower-emit-bounds-check len-state last-lane array-len)
                    array-var
                    (I64 0)
                    mask
                    lanes
                    elem-ty)])])])]
    [(Uniform value) (lower-emit-splat state value lanes elem-ty)]
    [(BroadcastArray array-var lane)
      (match (lower-emit-binop state Sub end-value (Var index-var) (I64))
        [(Expr count-state active-lanes _)
          (lower-emit-spmd-broadcast-array
            ctx
            count-state
            index-var
            array-var
            lane
            active-lanes
            lanes
            elem-ty)])]
    [(LaneIndex) (lower-emit-lane-id state lanes elem-ty)]
    [(LaneCount) (lower-emit-splat state (I64 lanes) lanes elem-ty)]
    [(Shuffle source selector)
      (lower-emit-vector-shuffle
        ctx
        state
        index-var
        lanes
        elem-ty
        (deref source)
        (deref selector)
        (Predicated end-value mask))]
    [(Stage staged value)
      (match (lower-emit-predicated-vector-map-value
        ctx
        state
        index-var
        (lower-global-shared-view end-value)
        (lower-global-shared-view mask)
        lanes
        (lower-global-shared-view elem-ty)
        (deref staged))
        [(Expr staged-state _ _)
          (lower-emit-predicated-vector-map-value
            ctx
            staged-state
            index-var
            end-value
            mask
            lanes
            elem-ty
            (deref value))])]
    [(BinOp op lhs rhs)
      (match (lower-emit-predicated-vector-map-value
        ctx
        state
        index-var
        (lower-global-shared-view end-value)
        (lower-global-shared-view mask)
        lanes
        (lower-global-shared-view elem-ty)
        (deref lhs))
        [(Expr lhs-state lhs-value _)
          (match (lower-emit-predicated-vector-map-value
            ctx
            lhs-state
            index-var
            (lower-global-shared-view end-value)
            (lower-global-shared-view mask)
            lanes
            (lower-global-shared-view elem-ty)
            (deref rhs))
            [(Expr rhs-state rhs-value _)
              (lower-emit-vector-map-binop
                rhs-state
                op
                lhs-value
                rhs-value
                lanes
                elem-ty
                (Predicated end-value mask))])])]))

(define (lower-vector-map-value-needs-scalar-tail? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(Gather _ _) true]
    [(GatherLaneOffset _ _) true]
    [(BroadcastArray _ _) true]
    [(LaneArray _) true]
    [(LaneIndex) true]
    [(LaneCount) true]
    [(Shuffle _ _) true]
    [(Stage staged value)
      (or
        (lower-vector-map-value-needs-scalar-tail? (deref staged))
        (lower-vector-map-value-needs-scalar-tail? (deref value)))]
    [(BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-needs-scalar-tail? (deref lhs))
        (lower-vector-map-value-needs-scalar-tail? (deref rhs)))]
    [_ false]))

(define (lower-vector-map-value-has-gather? [plan : LowerVectorMapValue]) : bool
  (match plan
    [(Gather _ _) true]
    [(GatherLaneOffset _ _) true]
    [(Stage staged value)
      (or
        (lower-vector-map-value-has-gather? (deref staged))
        (lower-vector-map-value-has-gather? (deref value)))]
    [(BinOp _ lhs rhs)
      (or
        (lower-vector-map-value-has-gather? (deref lhs))
        (lower-vector-map-value-has-gather? (deref rhs)))]
    [_ false]))

(define (lower-vector-map-store-list-needs-scalar-tail?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 stores.count]
    [index : i64 0]
    [needs-tail : bool false]
    (while (and (not needs-tail) (< index count))
      (match (lower-vector-map-store-list-ref stores index)
        [(LowerVectorMapStore _ value-plan)
          (if (lower-vector-map-value-needs-scalar-tail? value-plan)
            (set! needs-tail true)
            (set! index (+ index 1)))]))
    needs-tail))

(define (lower-vector-map-store-list-has-gather?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 stores.count]
    [index : i64 0]
    [has-gather : bool false]
    (while (and (not has-gather) (< index count))
      (match (lower-vector-map-store-list-ref stores index)
        [(LowerVectorMapStore _ value-plan)
          (if (lower-vector-map-value-has-gather? value-plan)
            (set! has-gather true)
            (set! index (+ index 1)))]))
    has-gather))

(define (lower-vector-map-store-list-has-shuffle?
  [stores : LowerVectorMapStoreList]) : bool
  (let
    [count : i64 stores.count]
    [index : i64 0]
    [has-shuffle : bool false]
    (while (and (not has-shuffle) (< index count))
      (match (lower-vector-map-store-list-ref stores index)
        [(LowerVectorMapStore _ value-plan)
          (if (lower-vector-map-value-has-shuffle? value-plan)
            (set! has-shuffle true)
            (set! index (+ index 1)))]))
    has-shuffle))

(define (lower-maybe-vector-map-needs-scalar-tail? [plan : LowerMaybeVectorMap]) : bool
  (match plan
    [(Some stores _ _) (lower-vector-map-store-list-needs-scalar-tail? stores)]
    [(No) false]))

(define (lower-maybe-vector-map-has-gather? [plan : LowerMaybeVectorMap]) : bool
  (match plan
    [(Some stores _ _) (lower-vector-map-store-list-has-gather? stores)]
    [(No) false]))

(define (lower-maybe-vector-map-has-shuffle? [plan : LowerMaybeVectorMap]) : bool
  (match plan
    [(Some stores _ _) (lower-vector-map-store-list-has-shuffle? stores)]
    [(No) false]))

(define (lower-emit-scalar-vector-map-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base-index-var : i64]
  [current-index-var : i64]
  [lane-index : ir.CompilerIrValue]
  [active-lanes : ir.CompilerIrValue]
  [lanes : i64]
  [elem-ty : ast.AstType]
  [plan : LowerVectorMapValue]) : LowerExpr
  (match plan
    [(Array array-var)
      (match (lower-sequence-element-addr
        ctx
        state
        array-var
        (Var current-index-var)
        (I64)
        (lower-global-shared-view elem-ty))
        [(Expr addr-state elem-ptr _)
          (lower-emit-load addr-state elem-ptr elem-ty)])]
    [(Gather source-var indexes-var)
      (match (lower-sequence-element-addr
        ctx
        state
        indexes-var
        (Var current-index-var)
        (I64)
        (I64))
        [(Expr index-addr-state index-ptr _)
          (match (lower-emit-load index-addr-state index-ptr (I64))
            [(Expr index-state gathered-index _)
              (match (lower-sequence-element-addr
                ctx
                index-state
                source-var
                gathered-index
                (I64)
                (lower-global-shared-view elem-ty))
                [(Expr source-addr-state source-ptr _)
                  (lower-emit-load source-addr-state source-ptr elem-ty)])])])]
    [(GatherLaneOffset source-var offsets-var)
      ;; The tail loop mutates `current-index-var`. Emit this subtraction raw
      ;; instead of using the lowering-time copy folder, which otherwise sees
      ;; the loop's initial `current == base` assignment and freezes every tail
      ;; iteration to lane zero.
      (match (lower-state-alloc-var state)
        [(Alloc lane-alloc-state lane-var)
          (match (lower-sequence-element-addr
            ctx
            (lower-state-emit
              lane-alloc-state
              (BinOp
                lane-var
                Sub
                (Var current-index-var)
                (Var base-index-var)
                (I64)))
            offsets-var
            (Var lane-var)
            (I64)
            (I64))
            [(Expr offset-addr-state offset-ptr _)
              (match (lower-emit-load offset-addr-state offset-ptr (I64))
                [(Expr offset-state offset _)
                  (match (lower-emit-binop
                    offset-state
                    Add
                    (Var current-index-var)
                    offset
                    (I64))
                    [(Expr index-state gathered-index _)
                      (match (lower-sequence-element-addr
                        ctx
                        index-state
                        source-var
                        gathered-index
                        (I64)
                        (lower-global-shared-view elem-ty))
                        [(Expr source-addr-state source-ptr _)
                          (lower-emit-load source-addr-state source-ptr elem-ty)])])])])])]
    [(LaneArray array-var)
      (match (lower-emit-binop
        state
        Sub
        (Var current-index-var)
        (Var base-index-var)
        (I64))
        [(Expr lane-state lane-index _)
          (match (lower-sequence-element-addr
            ctx
            lane-state
            array-var
            lane-index
            (I64)
            (lower-global-shared-view elem-ty))
            [(Expr addr-state elem-ptr _)
              (lower-emit-load addr-state elem-ptr elem-ty)])])]
    [(Uniform value) (Expr state value elem-ty)]
    [(BroadcastArray array-var lane)
      (match (lower-emit-binop
        (lower-emit-spmd-broadcast-lane-check
          state
          (lower-global-shared-view lane)
          active-lanes)
        Add
        (Var base-index-var)
        lane
        (I64))
        [(Expr index-state source-index _)
          (match (lower-sequence-element-addr
            ctx
            index-state
            array-var
            source-index
            (I64)
            (lower-global-shared-view elem-ty))
            [(Expr addr-state elem-ptr _)
              (lower-emit-load addr-state elem-ptr elem-ty)])])]
    [(LaneIndex)
      (lower-emit-binop
        state
        Sub
        (Var current-index-var)
        (Var base-index-var)
        elem-ty)]
    [(LaneCount) (Expr state (I64 lanes) elem-ty)]
    [(Shuffle source selector)
      (match (lower-box-shared-view selector)
        [(LaneIndex)
          (lower-emit-scalar-vector-map-value
            ctx
            state
            base-index-var
            current-index-var
            lane-index
            active-lanes
            lanes
            elem-ty
            (deref source))]
        [_
          (match (lower-emit-scalar-vector-map-value
            ctx
            state
            base-index-var
            current-index-var
            lane-index
            (lower-global-shared-view active-lanes)
            lanes
            (I64)
            (deref selector))
            [(Expr selector-state selector-value _)
              (match (lower-state-alloc-var
                (lower-emit-spmd-broadcast-lane-check
                  selector-state
                  (lower-global-shared-view selector-value)
                  (lower-global-shared-view active-lanes)))
                [(Alloc source-index-state source-index-var)
                  (lower-emit-scalar-vector-map-value
                    ctx
                    (lower-state-emit
                      source-index-state
                      (BinOp
                        source-index-var
                        Add
                        (Var base-index-var)
                        (lower-global-shared-view selector-value)
                        (I64)))
                    base-index-var
                    source-index-var
                    selector-value
                    active-lanes
                    lanes
                    elem-ty
                    (deref source))])])])]
    [(Stage staged value)
      (match (lower-emit-scalar-vector-map-value
        ctx
        state
        base-index-var
        current-index-var
        (lower-global-shared-view lane-index)
        (lower-global-shared-view active-lanes)
        lanes
        (lower-global-shared-view elem-ty)
        (deref staged))
        [(Expr staged-state _ _)
          (lower-emit-scalar-vector-map-value
            ctx
            staged-state
            base-index-var
            current-index-var
            lane-index
            active-lanes
            lanes
            elem-ty
            (deref value))])]
    [(BinOp op lhs rhs)
      (match (lower-emit-scalar-vector-map-value
        ctx
        state
        base-index-var
        current-index-var
        (lower-global-shared-view lane-index)
        (lower-global-shared-view active-lanes)
        lanes
        (lower-global-shared-view elem-ty)
        (deref lhs))
        [(Expr lhs-state lhs-value _)
          (match (lower-emit-scalar-vector-map-value
            ctx
            lhs-state
            base-index-var
            current-index-var
            lane-index
            active-lanes
            lanes
            (lower-global-shared-view elem-ty)
            (deref rhs))
            [(Expr rhs-state rhs-value _)
              (lower-emit-binop rhs-state op lhs-value rhs-value elem-ty)])])]))

(define (lower-avx2-broadcast-tail-map-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : ir.CompilerIrValue]
  [stores : LowerVectorMapStoreList]
  [elem-ty : ast.AstType]
  [lanes : i64]
  [exit-label : i64]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc alloc-state tail-var)
      (let
        [s : LowerState
          (lower-state-emit alloc-state (Mov tail-var (Var index-var) (I64)))]
        [tail-lane-var : i64 0]
        [header-label : i64 (ir.compiler-ir-label-none)]
        [body-label : i64 (ir.compiler-ir-label-none)]
        [active-lanes : ir.CompilerIrValue Unit]
        [tail-cond : ir.CompilerIrValue Unit]
        [scalar-value : ir.CompilerIrValue Unit]
        [elem-ptr : ir.CompilerIrValue Unit]
        [store-index : i64 0]
        (match (lower-state-alloc-var s)
          [(Alloc next-s var)
            (set! s next-s)
            (set! tail-lane-var var)])
        (set! s (lower-state-emit s (Mov tail-lane-var (I64 0) (I64))))
        (match (lower-state-fresh-label s "foreach_broadcast_tail_header")
          [(Label next-s label)
            (set! s next-s)
            (set! header-label label)])
        (match (lower-state-fresh-label s "foreach_broadcast_tail_body")
          [(Label next-s label)
            (set! s next-s)
            (set! body-label label)])
        (match (lower-emit-binop
          s
          Sub
          (lower-global-shared-view end-value)
          (Var index-var)
          (I64))
          [(Expr next-s value _)
            (set! s next-s)
            (set! active-lanes value)])
        (set!
          s
          (lower-state-finish-block
            (lower-state-emit s (Jump header-label))
            header-label))
        (match (lower-emit-binop s Lt (Var tail-var) end-value (I64))
          [(Expr next-s value _)
            (set! s next-s)
            (set! tail-cond value)])
        (set!
          s
          (lower-state-finish-block
            (lower-state-emit s (Branch tail-cond body-label exit-label))
            body-label))
        (while (< store-index stores.count)
          (match (lower-vector-map-store-list-ref stores store-index)
            [(LowerVectorMapStore dst-array value-plan)
              (match (lower-emit-scalar-vector-map-value
                ctx
                s
                index-var
                tail-var
                (Var tail-lane-var)
                (lower-global-shared-view active-lanes)
                lanes
                (lower-global-shared-view elem-ty)
                value-plan)
                [(Expr next-s value _)
                  (set! s next-s)
                  (set! scalar-value value)])
              (match (lower-sequence-element-addr
                ctx
                s
                dst-array
                (Var tail-var)
                (I64)
                (lower-global-shared-view elem-ty))
                [(Expr next-s value _)
                  (set! s next-s)
                  (set! elem-ptr value)])
              (set!
                s
                (lower-array-elem-store-state
                  ctx
                  s
                  (lower-global-shared-view elem-ptr)
                  (lower-global-shared-view scalar-value)
                  (lower-global-shared-view elem-ty)))
              (set! store-index (+ store-index 1))]))
        (match (lower-state-alloc-var s)
          [(Alloc inc-alloc inc-var)
            (match (lower-state-alloc-var inc-alloc)
              [(Alloc lane-inc-alloc lane-inc-var)
                (Ok
                  (Expr
                    (lower-state-finish-block
                      (lower-state-emit
                        (lower-state-emit
                          (lower-state-emit
                            (lower-state-emit
                              (lower-state-emit
                                lane-inc-alloc
                                (BinOp inc-var Add (Var tail-var) (I64 1) (I64)))
                              (Mov tail-var (Var inc-var) (I64)))
                            (BinOp
                              lane-inc-var
                              Add
                              (Var tail-lane-var)
                              (I64 1)
                              (I64)))
                          (Mov tail-lane-var (Var lane-inc-var) (I64)))
                        (Jump header-label))
                      exit-label)
                    Unit
                    (Unit)))])]))]))

(define (lower-avx2-vector-map-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [next-index : ir.CompilerIrValue]
  [plan : LowerMaybeVectorMap]
  [preheader-cache : LowerVectorMapValueCache]) : LowerState
  (match plan
    [(Some stores elem-ty lanes)
      (let
        [s : LowerState state]
        [count : i64 stores.count]
        [results : (__tl_dyn-array ir.CompilerIrValue)
          (__tl_make-array ir.CompilerIrValue count)]
        [store-index : i64 0]
        [cache : LowerVectorMapValueCache preheader-cache]
        [result-vec : ir.CompilerIrValue Unit]
        ;; Evaluate all values before the first store so common loads and
        ;; products stay in one side-effect-free region for normal CSE.
        (while (< store-index count)
          (match (lower-vector-map-store-list-ref stores store-index)
            [(LowerVectorMapStore _ value-plan)
              (match (lower-emit-vector-map-value-cached
                ctx
                s
                index-var
                lanes
                (lower-global-shared-view elem-ty)
                value-plan
                (Full)
                (lower-global-shared-view cache))
                [(Emit next-s value next-cache)
                  (set! s next-s)
                  (set! result-vec value)
                  (set! cache next-cache)])
              (set! (array-ref results store-index) result-vec)
              (set! store-index (+ store-index 1))]))
        (set! store-index 0)
        (while (< store-index count)
          (match (lower-vector-map-store-list-ref stores store-index)
            [(LowerVectorMapStore dst-array _)
              (match (lower-vector-map-value-cache-lookup
                cache
                (ArrayData dst-array))
                [(Some data-ptr)
                  (set!
                    s
                    (lower-emit-vector-store-data
                      s
                      data-ptr
                      (Var index-var)
                      (lower-global-array-element-shared-view
                        results
                        store-index)
                      lanes
                      (lower-global-shared-view elem-ty)))]
                [(No)
                  (set!
                    s
                    (lower-emit-sequence-vector-store
                      s
                      dst-array
                      (Var index-var)
                      (lower-global-array-element-shared-view
                        results
                        store-index)
                      lanes
                      (lower-global-shared-view elem-ty)))])
              (set! store-index (+ store-index 1))]))
        (lower-state-emit s (Mov index-var next-index (I64))))]
    [(No) state]))

(define (lower-predicated-index-plus-offset
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]) : LowerExpr
  (if (> offset 0)
    (lower-emit-binop state (Add) base (I64 offset) (I64))
    (Expr state base (I64))))

(define (lower-predicated-array-set-end-ok
  [state : LowerState]
  [ok : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [arrays : LowerArrayVarSet]) : LowerExpr
  (let
    [s : LowerState state]
    [next-ok : ir.CompilerIrValue ok]
    [index : i64 0]
    [count : i64 arrays.count]
    (while (< index count)
      (let
        [array-var : i64 (array-ref arrays.vars index)]
        [offset : i64 (array-ref arrays.offsets index)]
        (match (lower-predicated-index-plus-offset
          s
          (lower-global-shared-view end-value)
          offset)
          [(Expr index-state limit-index _)
            (match (lower-sequence-len-value index-state array-var)
              [(Expr len-state array-len _)
                (match (lower-vector-loop-i64-compare
                  len-state
                  (Le)
                  limit-index
                  array-len)
                  [(Expr cmp-state within _)
                    (match (lower-emit-binop
                      cmp-state
                      (And)
                      (lower-global-shared-view next-ok)
                      within
                      (Bool))
                      [(Expr next-state value _)
                        (set! s next-state)
                        (set! next-ok value)])])])])
        (set! index (+ index 1))))
    (Expr s next-ok (Bool))))

(define (lower-predicated-tail-limit [offset : i64]) : i64
  (- 9223372036854775807 offset))

(define (lower-predicated-tail-ok
  [state : LowerState]
  [index-var : i64]
  [end-value : ir.CompilerIrValue]
  [arrays : LowerArrayVarSet]) : LowerExpr
  (let
    [s : LowerState state]
    [max-offset : i64 (lower-array-var-set-max-offset arrays)]
    [ok : ir.CompilerIrValue Unit]
    [within : ir.CompilerIrValue Unit]
    (match (lower-vector-loop-i64-compare s (Ge) (Var index-var) (I64 0))
      [(Expr next-s value _)
        (set! s next-s)
        (set! ok value)])
    (match (lower-vector-loop-i64-compare
      s
      (Le)
      (lower-global-shared-view end-value)
      (I64 (lower-predicated-tail-limit max-offset)))
      [(Expr next-s value _)
        (set! s next-s)
        (set! within value)])
    (match (lower-emit-binop
      s
      (And)
      (lower-global-shared-view ok)
      (lower-global-shared-view within)
      (Bool))
      [(Expr next-s value _)
        (set! s next-s)
        (set! ok value)])
    (match (lower-vector-loop-i64-compare
      s
      (Le)
      (Var index-var)
      (lower-global-shared-view end-value))
      [(Expr next-s value _)
        (set! s next-s)
        (set! within value)])
    (match (lower-emit-binop s (And) ok within (Bool))
      [(Expr next-s value _)
        (lower-predicated-array-set-end-ok next-s value end-value arrays)])))

(define (lower-avx512-masked-unsupported
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]
  [detail : String]) : ResultLowerExpr
  (Err
    (box
      (lower-diagnostic-at-expr
        ctx
        expr
        (str_cat.str-cat "lower: SPMD masked if does not support " detail)))))

;; `No` is the proven all-active state for a full SIMD gang. Keep that proof
;; symbolic through masked lowering so parent-only memory operations can use
;; ordinary vector loads/stores. Materialize an actual mask only at operations
;; such as varying loops and private calls whose IR requires one.
(define (lower-masked-active-mask-value
  [state : LowerState]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]) : LowerExpr
  (match active-mask
    [(Some mask) (Expr state mask (Bool))]
    [(No) (lower-emit-tail-mask state (I64 0) (I64 lanes) lanes)]))

(define (lower-masked-active-intersect
  [state : LowerState]
  [active-mask : ir.CompilerIrMaybeValue]
  [mask : ir.CompilerIrValue]
  [lanes : i64]) : LowerExpr
  (match (match (lower-global-shared-view active-mask)
    [(No) (Expr state mask (Bool))]
    [(Some parent-mask)
      (lower-emit-mask-binop state (And) parent-mask mask lanes)])
    [(Expr child-state child-mask child-ty)
      (lower-masked-load-register-mask!
        child-state
        active-mask
        (lower-global-shared-view child-mask))
      (Expr child-state child-mask child-ty)]))

(define (lower-emit-active-load
  [state : LowerState]
  [sequence-var : i64]
  [index : ir.CompilerIrValue]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerExpr
  (if (lower-type-bool? elem-ty)
    (match (lower-masked-active-mask-value state active-mask lanes)
      [(Expr mask-state mask _)
        (lower-emit-sequence-predicated-load
          mask-state
          sequence-var
          index
          mask
          lanes
          elem-ty)])
    (match active-mask
      [(No)
        (lower-emit-sequence-vector-load state sequence-var index lanes elem-ty)]
      [(Some mask)
        (lower-emit-sequence-predicated-load
          state
          sequence-var
          index
          mask
          lanes
          elem-ty)])))

(define (lower-emit-active-store
  [state : LowerState]
  [sequence-var : i64]
  [index : ir.CompilerIrValue]
  [value : ir.CompilerIrValue]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [elem-ty : ast.AstType]) : LowerState
  (if (lower-type-bool? elem-ty)
    (match (lower-masked-active-mask-value state active-mask lanes)
      [(Expr mask-state mask _)
        (lower-emit-sequence-predicated-store
          mask-state
          sequence-var
          index
          value
          mask
          lanes
          elem-ty)])
    (match active-mask
      [(No)
        (lower-emit-sequence-vector-store
          state
          sequence-var
          index
          value
          lanes
          elem-ty)]
      [(Some mask)
        (lower-emit-sequence-predicated-store
          state
          sequence-var
          index
          value
          mask
          lanes
          elem-ty)])))

(define (lower-avx512-masked-index-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index : (& index str)]
  [index-var : i64]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (let
    [offset : i64
      (lower-masked-vector-index-offset
        ctx
        index
        (lower-global-shared-view expr))]
    (if (< offset 0)
      (lower-avx512-masked-unsupported
        ctx
        expr
        "non-contiguous array indexes in this AVX-512 slice")
      (if (= offset 0)
        (Ok (Expr state (Var index-var) (I64)))
        (Ok (lower-emit-binop state (Add) (Var index-var) (I64 offset) (I64)))))))

(define (lower-avx512-masked-bool-literal
  [state : LowerState]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [value : bool]) : LowerExpr
  (match (lower-masked-active-mask-value state active-mask lanes)
    [(Expr mask-state mask _)
      (if value
        (Expr mask-state mask (Bool))
        (lower-emit-mask-not mask-state mask lanes))]))

(define (lower-avx512-masked-var
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [lanes : i64]
  [expr : ast.AstExpr]
  [name : i64]) : ResultLowerExpr
  (if (lower-id-set-contains? lane-locals name)
    (let
      [var-id : i64
        (sym_i64_env.sym-i64-lookup-id-or
          env
          name
          (csym.compiler-symbols-missing-handle))]
      (if (csym.compiler-symbols-handle-found? var-id)
        (match (tc_core.tc-lookup-id type-env name)
          [(Ok ty)
            (Ok (Expr state (Var var-id) (tc_core.tc-type-without-regions ty)))]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx expr message)))])
        (lower-avx512-masked-unsupported ctx expr "unknown lane-local binding")))
    (if (string.eq (tc_core.tc-env-key-name-text name) index)
      (Ok (lower-emit-foreach-index-vector state index-var lanes))
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? var-id)
          (match (tc_core.tc-lookup-id type-env name)
            [(Ok ty)
              (let
                [lane-ty : ast.AstType (tc_core.tc-type-without-regions ty)]
                (if (>
                  (lower-simd-lanes-for-elem
                    (lower-state-mode state)
                    (lower-global-shared-view lane-ty))
                  0)
                  (Ok
                    (lower-emit-masked-preheader-splat
                      state
                      (Var var-id)
                      lanes
                      lane-ty))
                  (lower-avx512-masked-unsupported
                    ctx
                    expr
                    "uniform non-lane values inside masked vector expressions")))]
            [(Err message)
              (Err (box (lower-diagnostic-at-expr ctx expr message)))])
          (lower-avx512-masked-unsupported
            ctx
            expr
            "unbound values inside masked vector expressions"))))))

(define (lower-avx512-masked-array-ref
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : (& index str)]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [arr : ast.AstExpr]
  [idx : ast.AstExpr]) : ResultLowerExpr
  (match (lower-contiguous-sequence-var ctx env type-env arr)
    [(Some array-var elem-ty)
      (let
        [lane-ty : ast.AstType (tc_core.tc-type-without-regions elem-ty)]
        [offset : i64
          (lower-masked-vector-index-offset
            ctx
            index
            (lower-global-shared-view idx))]
        (if (and
          (not (lower-type-bool? lane-ty))
          (not
            (=
              (lower-simd-lanes-for-elem
                (lower-state-mode state)
                (lower-global-shared-view lane-ty))
              lanes)))
          (lower-avx512-masked-unsupported
            ctx
            expr
            "mixed lane widths inside one masked foreach")
          (if (< offset 0)
            (lower-avx512-masked-unsupported
              ctx
              expr
              "non-contiguous array indexes in this AVX-512 slice")
            (match (lower-masked-load-cache-get
              state
              array-var
              offset
              (lower-global-shared-view active-mask))
              [(Some value) (Ok (Expr state value lane-ty))]
              [(No)
                (let
                  [idx-lowered : LowerExpr
                    (try
                      (lower-avx512-masked-index-value
                        ctx
                        state
                        index
                        index-var
                        idx))]
                  (match idx-lowered
                    [(Expr idx-state idx-value _)
                      (match (lower-emit-active-load
                        idx-state
                        array-var
                        idx-value
                        (lower-global-shared-view active-mask)
                        lanes
                        lane-ty)
                        [(Expr load-state load-value load-ty)
                          (lower-masked-load-cache-put!
                            load-state
                            array-var
                            offset
                            active-mask
                            (lower-global-shared-view load-value))
                          (Ok (Expr load-state load-value load-ty))])]))]))))]
    [(No)
      (lower-avx512-masked-unsupported
        ctx
        expr
        "non-contiguous sequence reads inside masked branches")]))

(define (lower-avx512-masked-array-set
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [arr : ast.AstExpr]
  [idx : ast.AstExpr]
  [value : ast.AstExpr]) : ResultLowerExpr
  (match (lower-contiguous-sequence-var ctx env type-env arr)
    [(Some array-var elem-ty)
      (let
        [lane-ty : ast.AstType (tc_core.tc-type-without-regions elem-ty)]
        (if (lower-type-bool? lane-ty)
          (let
            [idx-lowered : LowerExpr
              (try
                (lower-avx512-masked-index-value ctx state index index-var idx))]
            (match idx-lowered
              [(Expr idx-state idx-value _)
                (let
                  [value-lowered
                    (try
                      (lower-avx512-masked-expr-expected
                        ctx
                        idx-state
                        env
                        type-env
                        lane-locals
                        index
                        index-var
                        (lower-global-shared-view active-mask)
                        lanes
                        value
                        lane-ty))]
                  (match value-lowered
                    [(Expr value-state value-ir _)
                      (Ok
                        (Expr
                          (lower-emit-active-store
                            value-state
                            array-var
                            idx-value
                            value-ir
                            active-mask
                            lanes
                            lane-ty)
                          Unit
                          (Unit)))]))]))
          (if (=
            (lower-simd-lanes-for-elem
              (lower-state-mode state)
              (lower-global-shared-view lane-ty))
            lanes)
            (let
              [idx-lowered : LowerExpr
                (try
                  (lower-avx512-masked-index-value
                    ctx
                    state
                    index
                    index-var
                    idx))]
              (match idx-lowered
                [(Expr idx-state idx-value _)
                  (let
                    [value-lowered
                      (try
                        (lower-avx512-masked-expr-expected
                          ctx
                          idx-state
                          env
                          type-env
                          lane-locals
                          index
                          index-var
                          (lower-global-shared-view active-mask)
                          lanes
                          value
                          lane-ty))]
                    (match value-lowered
                      [(Expr value-state value-ir _)
                        (Ok
                          (Expr
                            (lower-emit-active-store
                              value-state
                              array-var
                              idx-value
                              value-ir
                              active-mask
                              lanes
                              lane-ty)
                            Unit
                            (Unit)))]))]))
            (lower-avx512-masked-unsupported
              ctx
              expr
              "mixed lane widths inside one masked foreach"))))]
    [(No)
      (lower-avx512-masked-unsupported
        ctx
        expr
        "non-contiguous sequence writes inside masked branches")]))

;; Keep a varying enum lane as the address of the gang's first contiguous
;; element. Tag and payload vectors are assembled below from active-lane-only
;; scalar loads, avoiding a dedicated enum gather representation in both SIMD
;; backends.
(define (lower-avx2-masked-enum-source
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : (& lane-locals LowerIdSet)]
  [index : (& index str)]
  [index-var : i64]
  [expr : ast.AstExpr]) : ResultLowerMaskedEnumSource
  (match (lower-global-shared-view expr)
    [(Spanned inner-box _)
      (lower-avx2-masked-enum-source
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-avx2-masked-enum-source
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (lower-context-expr-get ctx inner-box))]
    [(Cast inner-box _)
      (lower-avx2-masked-enum-source
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (lower-context-expr-get ctx inner-box))]
    [(Var name)
      (if (lower-id-set-contains? lane-locals name)
        (match (tc_core.tc-lookup-id type-env name)
          [(Ok ty)
            (let
              [resolved : ast.AstType
                (tc_core.tc-type-without-regions
                  (tc_core.tc-resolve-type ctx ty))]
              (if (lower-spmd-enum-type? (lower-global-shared-view resolved))
                (let
                  [base-var : i64
                    (sym_i64_env.sym-i64-lookup-id-or
                      env
                      name
                      (csym.compiler-symbols-missing-handle))]
                  (if (csym.compiler-symbols-handle-found? base-var)
                    (Ok (Source state (Var base-var) resolved))
                    (Err
                      (box
                        (lower-diagnostic-at-expr
                          ctx
                          expr
                          "lower: varying enum source has no storage binding")))))
                No))]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx expr message)))])
        No)]
    [(ArrayRef arr-box idx-box)
      (let
        [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
        [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
        (match (lower-contiguous-sequence-var ctx env type-env arr)
          [(Some array-var elem-ty)
            (let
              [resolved : ast.AstType
                (tc_core.tc-type-without-regions
                  (tc_core.tc-resolve-type ctx elem-ty))]
              (if (lower-spmd-enum-type? (lower-global-shared-view resolved))
                (match (lower-avx512-masked-index-value
                  ctx
                  state
                  index
                  index-var
                  idx)
                  [(Ok idx-lowered)
                    (match idx-lowered
                      [(Expr idx-state idx-value _)
                        (match (lower-sequence-data-pointer-value
                          idx-state
                          array-var)
                          [(Expr data-state data-ptr _)
                            (match (lower-emit-elem-addr-gep
                              ctx
                              data-state
                              data-ptr
                              idx-value
                              (lower-global-shared-view resolved))
                              [(Expr base-state base _)
                                (Ok (Source base-state base resolved))])])])]
                  [(Err message) (Err message)])
                No))]
          [(No) No]))]
    [_ No]))

(define (lower-avx512-masked-let-bindings
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [bindings : (& bindings ast.AstLetBindingList)]) : ResultLowerEnv
  (lower-avx512-masked-let-bindings-at
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    (& bindings)
    0))

(define (lower-avx512-masked-let-bindings-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [bindings : (& bindings ast.AstLetBindingList)]
  [binding-index : i64]) : ResultLowerEnv
  (if (>= binding-index (ast.ast-let-binding-list-len bindings))
    (Ok state env type-env)
    (match (ast.ast-let-binding-list-get
      bindings
      binding-index
      (ast.ast-let-binding-fallback))
      [(Binding name maybe-ty init-box)
        (let
          [init : ast.AstExpr (lower-context-expr-get ctx init-box)]
          [enum-source : ResultLowerMaskedEnumSource
            (if (or
              (lower-mode-avx2? (lower-state-mode state))
              (lower-mode-avx512? (lower-state-mode state)))
              (lower-avx2-masked-enum-source
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                (lower-global-shared-view init))
              No)]
          (match enum-source
            [(Ok source)
              (match source
                [(Source init-state init-value init-ty)
                  (let
                    [binding-ty : ast.AstType
                      (lower-let-binding-type ctx maybe-ty init-ty)]
                    (match init-value
                      [(Var init-var)
                        (lower-avx512-masked-let-bindings-at
                          ctx
                          init-state
                          (sym_i64_env.sym-i64-bind-id env name init-var)
                          (tc_core.tc-bind-id type-env name binding-ty)
                          (lower-id-set-insert lane-locals name)
                          index
                          index-var
                          active-mask
                          lanes
                          bindings
                          (+ binding-index 1))]
                      [_
                        (Err
                          (box
                            (lower-diagnostic-at-expr
                              ctx
                              init
                              "lower: varying enum source did not produce an IR variable")))]))])]
            [(Err message) (Err message)]
            [(No)
              (let
                [lowered
                  (try
                    (lower-avx512-masked-expr
                      ctx
                      state
                      env
                      type-env
                      lane-locals
                      (lower-global-shared-view index)
                      index-var
                      (lower-global-shared-view active-mask)
                      lanes
                      (lower-global-shared-view init)))]
                (match lowered
                  [(Expr init-state init-value init-ty)
                    (let
                      [binding-ty : ast.AstType
                        (lower-let-binding-type ctx maybe-ty init-ty)]
                      (match init-value
                        [(Var init-var)
                          (lower-avx512-masked-let-bindings-at
                            ctx
                            init-state
                            (sym_i64_env.sym-i64-bind-id env name init-var)
                            (tc_core.tc-bind-id type-env name binding-ty)
                            (lower-id-set-insert lane-locals name)
                            index
                            index-var
                            active-mask
                            lanes
                            bindings
                            (+ binding-index 1))]
                        [_
                          (Err
                            (box
                              (lower-diagnostic-at-expr
                                ctx
                                init
                                "lower: masked let init did not produce an IR variable")))]))]))]))])))

(define (lower-avx512-masked-begin
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [exprs : ast.AstExprList]) : ResultLowerExpr
  (lower-avx512-masked-begin-at
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    active-mask
    lanes
    (& exprs)
    0))

(define (lower-avx512-masked-begin-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [exprs : (& exprs ast.AstExprList)]
  [expr-index : i64]) : ResultLowerExpr
  (if (>= expr-index exprs.len)
    (Ok (Expr state Unit (Unit)))
    (let
      [expr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs expr-index 0))]
      [lowered
        (try
          (lower-avx512-masked-expr
            ctx
            state
            env
            type-env
            lane-locals
            (lower-global-shared-view index)
            index-var
            (lower-global-shared-view active-mask)
            lanes
            expr))]
      (match lowered
        [(Expr next-state value ty)
          (if (= (+ expr-index 1) exprs.len)
            (Ok (Expr next-state value ty))
            (lower-avx512-masked-begin-at
              ctx
              next-state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              exprs
              (+ expr-index 1)))]))))

(define (lower-avx512-masked-select-result-supported?
  [state : LowerState]
  [lanes : i64]
  [ty : ast.AstType]) : bool
  (=
    (lower-simd-lanes-for-elem
      (lower-state-mode state)
      (tc_core.tc-type-without-regions ty))
    lanes))

(define (lower-avx512-masked-while
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [cond : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (match (lower-masked-active-mask-value state active-mask lanes)
    [(Expr active-state active-value _)
      (match (lower-state-alloc-var active-state)
        [(Alloc mask-alloc loop-mask-var)
          (let
            [s : LowerState
              (lower-state-emit
                mask-alloc
                (MaskBinOp
                  loop-mask-var
                  (Or)
                  (lower-global-shared-view active-value)
                  active-value
                  lanes))]
            [header-label : i64 (ir.compiler-ir-label-none)]
            [body-label : i64 (ir.compiler-ir-label-none)]
            [exit-label : i64 (ir.compiler-ir-label-none)]
            [cond-active : ir.CompilerIrValue Unit]
            [any-active : ir.CompilerIrValue Unit]
            (match (lower-state-fresh-label s "spmd_vwhile_header")
              [(Label next-s label)
                (set! s next-s)
                (set! header-label label)])
            (match (lower-state-fresh-label s "spmd_vwhile_body")
              [(Label next-s label)
                (set! s next-s)
                (set! body-label label)])
            (match (lower-state-fresh-label s "spmd_vwhile_exit")
              [(Label next-s label)
                (set! s next-s)
                (set! exit-label label)])
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit s (Jump header-label))
                header-label))
            (let
              [cond-lowered
                (try
                  (lower-avx512-masked-expr
                    ctx
                    s
                    env
                    type-env
                    lane-locals
                    (lower-global-shared-view index)
                    index-var
                    (Some (Var loop-mask-var))
                    lanes
                    cond))]
              (match cond-lowered
                [(Expr cond-state cond-mask _)
                  (match (lower-emit-mask-binop
                    cond-state
                    (And)
                    (Var loop-mask-var)
                    cond-mask
                    lanes)
                    [(Expr next-s value _)
                      (set! s next-s)
                      (set! cond-active value)])
                  (match (lower-emit-mask-reduce
                    s
                    (Any)
                    (lower-global-shared-view cond-active)
                    lanes)
                    [(Expr next-s value _)
                      (set! s next-s)
                      (set! any-active value)])]))
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit s (Branch any-active body-label exit-label))
                body-label))
            (let
              [body-lowered
                (try
                  (let
                    [active-mask
                      (ir.CompilerIrMaybeValue.Some
                        (lower-global-shared-view cond-active))]
                    [expected-ty (ast.AstType.Unit)]
                    (lower-avx512-masked-expr-expected
                      ctx
                      s
                      env
                      type-env
                      lane-locals
                      index
                      index-var
                      active-mask
                      lanes
                      body
                      expected-ty)))]
              (match body-lowered
                [(Expr body-state _ _)
                  (set!
                    s
                    (lower-state-emit
                      body-state
                      (MaskBinOp
                        loop-mask-var
                        (Or)
                        (lower-global-shared-view cond-active)
                        cond-active
                        lanes)))]))
            (Ok
              (Expr
                (lower-state-finish-block
                  (lower-state-emit s (Jump header-label))
                  exit-label)
                Unit
                (Unit))))])]))

(define (lower-avx512-masked-if
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [cond : ast.AstExpr]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]) : ResultLowerExpr
  (let
    [cond-lowered
      (try
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          (lower-global-shared-view index)
          index-var
          (lower-global-shared-view active-mask)
          lanes
          cond))]
    (match cond-lowered
      [(Expr cond-state cond-mask _)
        (match (lower-masked-active-intersect
          cond-state
          (lower-global-shared-view active-mask)
          (lower-global-shared-view cond-mask)
          lanes)
          [(Expr then-mask-state then-mask _)
            (match (lower-emit-mask-not then-mask-state cond-mask lanes)
              [(Expr not-state not-mask _)
                (match (lower-masked-active-intersect
                  not-state
                  active-mask
                  not-mask
                  lanes)
                  [(Expr else-mask-state else-mask _)
                    (let
                      [then-lowered
                        (try
                          (lower-avx512-masked-expr-expected
                            ctx
                            else-mask-state
                            env
                            type-env
                            (lower-global-shared-view lane-locals)
                            (lower-global-shared-view index)
                            index-var
                            (Some (lower-global-shared-view then-mask))
                            lanes
                            then-branch
                            result-ty))]
                      (match then-lowered
                        [(Expr then-state then-value then-ty)
                          (let
                            [else-lowered
                              (try
                                (lower-avx512-masked-expr-expected
                                  ctx
                                  then-state
                                  env
                                  type-env
                                  lane-locals
                                  index
                                  index-var
                                  (Some (lower-global-shared-view else-mask))
                                  lanes
                                  else-branch
                                  result-ty))]
                            (match else-lowered
                              [(Expr else-state else-value else-ty)
                                (match (lower-global-shared-view then-ty)
                                  [(Unit) (Ok (Expr else-state Unit (Unit)))]
                                  [_
                                    (if (and
                                      (ast.ast-type-eq-with-pools?
                                        (tc_core.tc-context-pools ctx)
                                        (lower-global-shared-view then-ty)
                                        (lower-global-shared-view else-ty))
                                      (lower-type-bool? then-ty))
                                      (Ok
                                        (lower-emit-mask-select
                                          else-state
                                          then-mask
                                          then-value
                                          else-mask
                                          else-value
                                          lanes))
                                      (if (and
                                        (ast.ast-type-eq-with-pools?
                                          (tc_core.tc-context-pools ctx)
                                          (lower-global-shared-view then-ty)
                                          else-ty)
                                        (lower-avx512-masked-select-result-supported?
                                          else-state
                                          lanes
                                          (lower-global-shared-view then-ty)))
                                        (Ok
                                          (lower-emit-select
                                            else-state
                                            then-mask
                                            then-value
                                            else-value
                                            lanes
                                            then-ty))
                                        (lower-avx512-masked-unsupported
                                          ctx
                                          expr
                                          "this value-producing masked if result type")))])]))]))])])])])))

(define (lower-simd-masked-index-mod
  [state : LowerState]
  [index-var : i64]
  [index-offset : i64]
  [lanes : i64]
  [divisor : i64]) : ResultLowerExpr
  (let
    [s : LowerState state]
    [lane-id : ir.CompilerIrValue Unit]
    [result : ir.CompilerIrValue Unit]
    [lane : i64 0]
    (match (lower-emit-lane-id s lanes (I64))
      [(Expr next-state value _)
        (set! s next-state)
        (set! lane-id value)])
    (match (lower-emit-splat s (I64 0) lanes (I64))
      [(Expr next-state value _)
        (set! s next-state)
        (set! result value)])
    (while (< lane lanes)
      (let
        [one-lane : ir.CompilerIrValue Unit]
        [lane-value : ir.CompilerIrValue Unit]
        [lane-remainder : ir.CompilerIrValue Unit]
        (match (lower-emit-splat s (I64 lane) lanes (I64))
          [(Expr lane-state lane-splat _)
            (match (lower-emit-vector-compare
              lane-state
              (Eq)
              (lower-global-shared-view lane-id)
              lane-splat
              lanes
              (I64))
              [(Expr next-state value _)
                (set! s next-state)
                (set! one-lane value)])])
        (match (lower-emit-binop
          s
          (Add)
          (Var index-var)
          (I64 (+ index-offset lane))
          (I64))
          [(Expr next-state value _)
            (set! s next-state)
            (set! lane-value value)])
        (match (lower-emit-binop s (Mod) lane-value (I64 divisor) (I64))
          [(Expr next-state value _)
            (set! s next-state)
            (set! lane-remainder value)])
        (match (lower-emit-splat s lane-remainder lanes (I64))
          [(Expr splat-state lane-vector _)
            (match (lower-emit-select
              splat-state
              one-lane
              lane-vector
              (lower-global-shared-view result)
              lanes
              (I64))
              [(Expr next-state value _)
                (set! s next-state)
                (set! result value)])])
        (set! lane (+ lane 1))))
    (Ok (Expr s result (I64)))))

(define (lower-avx512-masked-vector-binop
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [op : ir.CompilerIrBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    expr)
    [(Ok result-ty)
      (let
        [lane-ty : ast.AstType (tc_core.tc-type-without-regions result-ty)]
        [left-lowered
          (try
            (lower-avx512-masked-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view lane-locals)
              (lower-global-shared-view index)
              index-var
              (lower-global-shared-view active-mask)
              lanes
              left
              lane-ty))]
        (match left-lowered
          [(Expr left-state left-value _)
            (let
              [right-lowered
                (try
                  (lower-avx512-masked-expr-expected
                    ctx
                    left-state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    right
                    lane-ty))]
              (match right-lowered
                [(Expr right-state right-value _)
                  (Ok
                    (lower-emit-vector-binop
                      right-state
                      op
                      left-value
                      right-value
                      lanes
                      lane-ty))]))]))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx expr message)))]))

(define (lower-masked-shift-op-name [op : ast.AstBinOp]) : String
  (match op
    [(Shl) "shl"]
    [(Shr) "shr"]
    [_ "unknown"]))

(define (lower-masked-shift-mode-name [mode : CompilerLowerMode]) : String
  (if (lower-mode-avx2? mode)
    "AVX2"
    "AVX-512"))

(define (lower-masked-shift-lane-supported? [ty : ast.AstType]) : bool
  (lower-spmd-shift-lane-supported? ty))

(define (lower-masked-shift-unsupported
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [expr : ast.AstExpr]
  [op : ast.AstBinOp]
  [lane-ty : ast.AstType]) : ResultLowerExpr
  (lower-avx512-masked-unsupported
    ctx
    expr
    (str_cat.str-cat
      "masked shift '"
      (lower-masked-shift-op-name op)
      "' for lane type "
      (tc_core.tc-type-render lane-ty)
      " in "
      (lower-masked-shift-mode-name (lower-state-mode state))
      " backend mode; supported lane types are i8, u8, i16, u16, i32, u32, i64, and u64")))

(define (lower-avx512-masked-shift-guard-and-emit
  [state : LowerState]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [op : ir.CompilerIrBinOp]
  [left-value : ir.CompilerIrValue]
  [right-value : ir.CompilerIrValue]
  [lane-ty : ast.AstType]
  [count-ty : ast.AstType]) : ResultLowerExpr
  (Ok
    (lower-emit-checked-vector-shift
      state
      active-mask
      lanes
      op
      left-value
      right-value
      lane-ty
      count-ty)))

(define (lower-avx512-masked-shift
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [ast-op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultLowerExpr
  (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    expr)
    [(Ok result-ty)
      (let
        [lane-ty : ast.AstType (tc_core.tc-type-without-regions result-ty)]
        (if (not
          (lower-masked-shift-lane-supported?
            (lower-global-shared-view lane-ty)))
          (lower-masked-shift-unsupported ctx state expr ast-op lane-ty)
          (let
            [left-lowered
              (try
                (lower-avx512-masked-expr-expected
                  ctx
                  state
                  env
                  type-env
                  (lower-global-shared-view lane-locals)
                  (lower-global-shared-view index)
                  index-var
                  (lower-global-shared-view active-mask)
                  lanes
                  left
                  lane-ty))]
            (match left-lowered
              [(Expr left-state left-value _)
                (let
                  [right-lowered
                    (try
                      (lower-avx512-masked-expr-expected
                        ctx
                        left-state
                        env
                        type-env
                        lane-locals
                        index
                        index-var
                        (lower-global-shared-view active-mask)
                        lanes
                        right
                        lane-ty))]
                  (match right-lowered
                    [(Expr right-state right-value right-ty)
                      (let
                        [count-ty : ast.AstType
                          (tc_core.tc-type-without-regions right-ty)]
                        [typed-ir-op : ir.CompilerIrBinOp
                          (match ast-op
                            [(Shl) (Shl (lower-global-shared-view count-ty))]
                            [_ (Shr (lower-global-shared-view count-ty))])]
                        (if (and
                          (tc_core.tc-integer-type?
                            (lower-global-shared-view count-ty))
                          (=
                            (lower-simd-lanes-for-elem
                              (lower-state-mode state)
                              (lower-global-shared-view count-ty))
                            lanes))
                          (lower-avx512-masked-shift-guard-and-emit
                            right-state
                            active-mask
                            lanes
                            typed-ir-op
                            left-value
                            right-value
                            lane-ty
                            count-ty)
                          (lower-avx512-masked-unsupported
                            ctx
                            expr
                            (str_cat.str-cat
                              "masked shift '"
                              (lower-masked-shift-op-name ast-op)
                              "' count lane type "
                              (tc_core.tc-type-render count-ty)
                              "; the count must have the same SIMD lane width as "
                              (tc_core.tc-type-render lane-ty)))))]))]))))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx expr message)))]))

;; The numeric context the masked emitter reports: a helper body inlined into
;; masked control is checked as private-helper code.
(define (lower-masked-spmd-numeric-context [state : LowerState]) : spmd_numeric.CompilerSpmdNumericContext
  (if (>
    (compiler-lower-function-state-inline-helper-stack
      (lower-state-function-state state)).len
    0)
    (PrivateHelper)
    (MaskedControl)))

(define (lower-avx512-masked-binary-unsupported
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]) : ResultLowerExpr
  (match (lower-masked-spmd-numeric-expr-type ctx env type-env left)
    [(Ok source-ty)
      (let
        [source : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx source-ty))]
        [decision : spmd_numeric.CompilerSpmdNumericDecision
          (spmd_numeric.compiler-spmd-numeric-binary-decision
            (lower-global-shared-view source)
            (if (spmd_numeric.compiler-spmd-numeric-comparison-op? op)
              (Bool)
              (owned_view.compiler-owned-shared-view source))
            (lower-masked-spmd-numeric-context state)
            (lower-spmd-numeric-backend (lower-state-mode state))
            op)]
        (if (and
          (spmd_numeric.compiler-spmd-numeric-lane?
            (spmd_numeric.compiler-spmd-numeric-lane source))
          (not
            (spmd_numeric.compiler-spmd-numeric-decision-supported? decision)))
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                expr
                (lower-spmd-numeric-failure-message decision))))
          (lower-avx512-masked-unsupported ctx expr "this binary operator")))]
    [(Err _) (lower-avx512-masked-unsupported ctx expr "this binary operator")]))

(define (lower-avx512-masked-binary
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [op : ast.AstBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultLowerExpr
  (match op
    [(And)
      (let
        [left-lowered
          (try
            (lower-avx512-masked-expr
              ctx
              state
              env
              type-env
              lane-locals
              (lower-global-shared-view index)
              index-var
              (lower-global-shared-view active-mask)
              lanes
              left))]
        (match left-lowered
          [(Expr left-state left-value _)
            (let
              [right-lowered : LowerExpr
                (try
                  (lower-avx512-masked-expr
                    ctx
                    left-state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    right))]
              (match right-lowered
                [(Expr right-state right-value _)
                  (Ok
                    (lower-emit-mask-binop
                      right-state
                      (And)
                      left-value
                      right-value
                      lanes))]))]))]
    [(Or)
      (let
        [left-lowered
          (try
            (lower-avx512-masked-expr
              ctx
              state
              env
              type-env
              lane-locals
              (lower-global-shared-view index)
              index-var
              (lower-global-shared-view active-mask)
              lanes
              left))]
        (match left-lowered
          [(Expr left-state left-value _)
            (let
              [right-lowered : LowerExpr
                (try
                  (lower-avx512-masked-expr
                    ctx
                    left-state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    right))]
              (match right-lowered
                [(Expr right-state right-value _)
                  (Ok
                    (lower-emit-mask-binop
                      right-state
                      (Or)
                      left-value
                      right-value
                      lanes))]))]))]
    [(Add)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (Add)
        left
        right)]
    [(Sub)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (Sub)
        left
        right)]
    [(Shl)
      (lower-avx512-masked-shift
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        op
        left
        right)]
    [(Shr)
      (lower-avx512-masked-shift
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        op
        left
        right)]
    [(BitAnd)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (BitAnd)
        left
        right)]
    [(BitOr)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (BitOr)
        left
        right)]
    [(BitXor)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (BitXor)
        left
        right)]
    [(Mul)
      (lower-avx512-masked-vector-binop
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (Mul)
        left
        right)]
    [(Mod)
      (let
        [divisor : i64
          (lower-masked-vector-positive-power-two-literal
            ctx
            (lower-global-shared-view right))]
        [positive-divisor : i64
          (lower-masked-vector-index-literal-offset ctx right)]
        [index-offset : i64
          (lower-masked-vector-index-offset
            ctx
            index
            (lower-global-shared-view left))]
        (if (and
          (or
            (lower-mode-avx2? (lower-state-mode state))
            (and (lower-mode-avx512? (lower-state-mode state)) (< divisor 0)))
          (> positive-divisor 0)
          (>= index-offset 0)
          (= lanes (lower-simd-lanes-for-elem (lower-state-mode state) (I64))))
          (lower-simd-masked-index-mod
            state
            index-var
            index-offset
            lanes
            positive-divisor)
          (if (and (> divisor 0) (>= index-offset 0))
            (let
              [left-lowered : LowerExpr
                (try
                  (lower-avx512-masked-expr
                    ctx
                    state
                    env
                    type-env
                    lane-locals
                    index
                    index-var
                    active-mask
                    lanes
                    left))]
              (match left-lowered
                [(Expr left-state left-value left-ty)
                  (match (lower-emit-splat
                    left-state
                    (I64 (- divisor 1))
                    lanes
                    (lower-global-shared-view left-ty))
                    [(Expr rhs-state rhs-value _)
                      (Ok
                        (lower-emit-vector-binop
                          rhs-state
                          (BitAnd)
                          left-value
                          rhs-value
                          lanes
                          left-ty))])]))
            (lower-avx512-masked-unsupported ctx expr "this binary operator"))))]
    [(Eq)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (Eq)
        left
        right)]
    [(Ne)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (Ne)
        left
        right)]
    [(Lt)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (Lt)
        left
        right)]
    [(Le)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (Le)
        left
        right)]
    [(Gt)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (Gt)
        left
        right)]
    [(Ge)
      (lower-avx512-masked-compare
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        active-mask
        lanes
        expr
        (Ge)
        left
        right)]
    [_
      (lower-avx512-masked-binary-unsupported
        ctx
        state
        env
        type-env
        expr
        op
        left)]))

(define (lower-avx512-masked-compare
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [_expr : ast.AstExpr]
  [op : ir.CompilerIrBinOp]
  [left : ast.AstExpr]
  [right : ast.AstExpr]) : ResultLowerExpr
  (let
    [left-lowered
      (try
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          (lower-global-shared-view index)
          index-var
          (lower-global-shared-view active-mask)
          lanes
          left))]
    (match left-lowered
      [(Expr left-state left-value left-ty)
        (let
          [right-lowered
            (try
              (lower-avx512-masked-expr-expected
                ctx
                left-state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                right
                left-ty))]
          (match right-lowered
            [(Expr right-state right-value _)
              (Ok
                (lower-emit-vector-compare
                  right-state
                  op
                  left-value
                  right-value
                  lanes
                  left-ty))]))])))

(define (lower-enum-mask-lane-type [mode : CompilerLowerMode] [lanes : i64]) : ast.AstType
  (if (lower-mode-avx512? mode)
    (cond
      [(= lanes 8) (I64)]
      [(= lanes 16) (I32)]
      [(= lanes 32) (I16)]
      [else (I8)])
    (cond
      [(= lanes 4) (I64)]
      [(= lanes 8) (I32)]
      [(= lanes 16) (I16)]
      [else (I8)])))

(define (lower-avx2-enum-zero-value [ty : ast.AstType]) : ir.CompilerIrValue
  (match (tc_core.tc-type-without-regions ty)
    [(F64) (F64 (cast 0 : u64))]
    [(F32) (F64 (cast 0 : u64))]
    [(Bool) (Bool false)]
    [_ (I64 0)]))

(define (lower-avx2-enum-zero-mask
  [state : LowerState]
  [lane-id : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]) : LowerExpr
  (lower-emit-vector-compare
    state
    (Ne)
    (lower-global-shared-view lane-id)
    lane-id
    lanes
    lane-ty))

(define (lower-avx2-enum-one-lane-mask
  [state : LowerState]
  [lane-id : ir.CompilerIrValue]
  [lane : i64]
  [lanes : i64]
  [lane-ty : ast.AstType]) : LowerExpr
  (match (lower-emit-splat
    state
    (I64 lane)
    lanes
    (lower-global-shared-view lane-ty))
    [(Expr lane-state lane-value _)
      (lower-emit-vector-compare
        lane-state
        (Eq)
        lane-id
        lane-value
        lanes
        lane-ty)]))

;; Guard the load in scalar control flow. This is required for both masked arms
;; and the final partial gang: inactive lanes must not touch enum storage.
(define (lower-avx2-enum-load-active-lane
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [active : ir.CompilerIrValue]
  [ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc slot-state slot-var)
      (match (lower-state-fresh-label
        (lower-state-emit
          slot-state
          (Mov
            slot-var
            (lower-avx2-enum-zero-value (lower-global-shared-view ty))
            (lower-global-shared-view ty)))
        "spmd_match_lane_load")
        [(Label load-label-state load-label)
          (match (lower-state-fresh-label
            load-label-state
            "spmd_match_lane_join")
            [(Label join-label-state join-label)
              (let
                [load-state : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      join-label-state
                      (Branch active load-label join-label))
                    load-label)]
                (match (lower-load-at-offset
                  load-state
                  base
                  offset
                  (lower-global-shared-view ty))
                  [(Expr loaded-state loaded _)
                    (Expr
                      (lower-state-finish-block
                        (lower-state-emit
                          (lower-state-emit
                            loaded-state
                            (Mov slot-var loaded (lower-global-shared-view ty)))
                          (Jump join-label))
                        join-label)
                      (Var slot-var)
                      ty)]))])])]))

(define (lower-avx2-enum-scalar-bool-lane-mask
  [state : LowerState]
  [condition : ir.CompilerIrValue]
  [one-lane-mask : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]) : LowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc word-state word-var)
      (match (lower-state-fresh-label
        (lower-state-emit
          word-state
          (Mov word-var (I64 0) (lower-global-shared-view lane-ty)))
        "spmd_match_lane_true")
        [(Label true-label-state true-label)
          (match (lower-state-fresh-label
            true-label-state
            "spmd_match_lane_bool")
            [(Label join-label-state join-label)
              (let
                [true-state : LowerState
                  (lower-state-finish-block
                    (lower-state-emit
                      join-label-state
                      (Branch condition true-label join-label))
                    true-label)]
                (match (lower-emit-splat
                  (lower-state-finish-block
                    (lower-state-emit
                      (lower-state-emit
                        true-state
                        (Mov
                          word-var
                          (I64 -1)
                          (lower-global-shared-view lane-ty)))
                      (Jump join-label))
                    join-label)
                  (Var word-var)
                  lanes
                  (lower-global-shared-view lane-ty))
                  [(Expr splat-state splat-value _)
                    (if (lower-mode-avx512? (lower-state-mode splat-state))
                      (match (lower-emit-splat
                        splat-state
                        (I64 0)
                        lanes
                        (lower-global-shared-view lane-ty))
                        [(Expr zero-state zero-value _)
                          (match (lower-emit-vector-compare
                            zero-state
                            (Ne)
                            splat-value
                            zero-value
                            lanes
                            lane-ty)
                            [(Expr mask-state condition-mask _)
                              (lower-emit-mask-binop
                                mask-state
                                (And)
                                one-lane-mask
                                condition-mask
                                lanes)])])
                      (lower-emit-mask-binop
                        splat-state
                        (And)
                        one-lane-mask
                        splat-value
                        lanes))]))])])]))

;; Reconstruct one payload field as a varying vector without adding a gather
;; opcode: load each active lane and select its splat into a one-lane mask.
(define (lower-avx2-enum-field-vector
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [stride : i64]
  [field-offset : i64]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [field-ty : ast.AstType]) : LowerExpr
  (let
    [lane-ty : ast.AstType
      (lower-enum-mask-lane-type (lower-state-mode state) lanes)]
    [s : LowerState state]
    [lane-id : ir.CompilerIrValue Unit]
    [result : ir.CompilerIrValue Unit]
    [lane : i64 0]
    (match (lower-emit-lane-id s lanes (lower-global-shared-view lane-ty))
      [(Expr next-state value _)
        (set! s next-state)
        (set! lane-id value)])
    (match (if (lower-type-bool? field-ty)
      (lower-avx2-enum-zero-mask
        s
        (lower-global-shared-view lane-id)
        lanes
        (lower-global-shared-view lane-ty))
      (lower-emit-splat
        s
        (lower-avx2-enum-zero-value (lower-global-shared-view field-ty))
        lanes
        (lower-global-shared-view field-ty)))
      [(Expr next-state value _)
        (set! s next-state)
        (set! result value)])
    (while (< lane lanes)
      (let
        [one-lane : ir.CompilerIrValue Unit]
        [lane-active-mask : ir.CompilerIrValue Unit]
        [lane-active : ir.CompilerIrValue Unit]
        [loaded : ir.CompilerIrValue Unit]
        (match (lower-avx2-enum-one-lane-mask
          s
          (lower-global-shared-view lane-id)
          lane
          lanes
          (lower-global-shared-view lane-ty))
          [(Expr next-state value _)
            (set! s next-state)
            (set! one-lane value)])
        (match (lower-emit-mask-binop
          s
          (And)
          (lower-global-shared-view active-mask)
          (lower-global-shared-view one-lane)
          lanes)
          [(Expr next-state value _)
            (set! s next-state)
            (set! lane-active-mask value)])
        (match (lower-emit-mask-reduce s (Any) lane-active-mask lanes)
          [(Expr next-state value _)
            (set! s next-state)
            (set! lane-active value)])
        (match (lower-avx2-enum-load-active-lane
          s
          (lower-global-shared-view base)
          (+ field-offset (* lane stride))
          lane-active
          (lower-global-shared-view field-ty))
          [(Expr next-state value _)
            (set! s next-state)
            (set! loaded value)])
        (if (lower-type-bool? field-ty)
          (match (lower-avx2-enum-scalar-bool-lane-mask
            s
            loaded
            one-lane
            lanes
            (lower-global-shared-view lane-ty))
            [(Expr lane-state lane-value _)
              (match (lower-emit-mask-binop
                lane-state
                (Or)
                (lower-global-shared-view result)
                lane-value
                lanes)
                [(Expr next-state value _)
                  (set! s next-state)
                  (set! result value)])])
          (match (lower-emit-splat
            s
            loaded
            lanes
            (lower-global-shared-view field-ty))
            [(Expr lane-state lane-value _)
              (match (lower-emit-select
                lane-state
                one-lane
                lane-value
                (lower-global-shared-view result)
                lanes
                (lower-global-shared-view field-ty))
                [(Expr next-state value _)
                  (set! s next-state)
                  (set! result value)])]))
        (set! lane (+ lane 1))))
    (Expr s result field-ty)))

(define (lower-avx2-enum-tag-arm-masks
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [stride : i64]
  [active-mask : ir.CompilerIrValue]
  [lane-id : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]
  [tag : i64]) : ResultLowerMaskedMatchMasks
  (let
    [s : LowerState state]
    [arm-mask : ir.CompilerIrValue Unit]
    [lane : i64 0]
    (match (lower-avx2-enum-zero-mask
      s
      (lower-global-shared-view lane-id)
      lanes
      (lower-global-shared-view lane-ty))
      [(Expr next-state value _)
        (set! s next-state)
        (set! arm-mask value)])
    (while (< lane lanes)
      (let
        [one-lane : ir.CompilerIrValue Unit]
        [lane-active-mask : ir.CompilerIrValue Unit]
        [lane-active : ir.CompilerIrValue Unit]
        [loaded-tag : ir.CompilerIrValue Unit]
        [tag-eq : ir.CompilerIrValue Unit]
        (match (lower-avx2-enum-one-lane-mask
          s
          (lower-global-shared-view lane-id)
          lane
          lanes
          (lower-global-shared-view lane-ty))
          [(Expr next-state value _)
            (set! s next-state)
            (set! one-lane value)])
        (match (lower-emit-mask-binop
          s
          (And)
          (lower-global-shared-view active-mask)
          (lower-global-shared-view one-lane)
          lanes)
          [(Expr next-state value _)
            (set! s next-state)
            (set! lane-active-mask value)])
        (match (lower-emit-mask-reduce s (Any) lane-active-mask lanes)
          [(Expr next-state value _)
            (set! s next-state)
            (set! lane-active value)])
        (match (lower-avx2-enum-load-active-lane
          s
          (lower-global-shared-view base)
          (* lane stride)
          lane-active
          (I64))
          [(Expr next-state value _)
            (set! s next-state)
            (set! loaded-tag value)])
        (match (lower-emit-binop s (Eq) loaded-tag (I64 tag) (I64))
          [(Expr next-state value _)
            (set! s next-state)
            (set! tag-eq value)])
        (match (lower-avx2-enum-scalar-bool-lane-mask
          s
          tag-eq
          one-lane
          lanes
          (lower-global-shared-view lane-ty))
          [(Expr lane-state lane-match _)
            (match (lower-emit-mask-binop
              lane-state
              (Or)
              (lower-global-shared-view arm-mask)
              lane-match
              lanes)
              [(Expr next-state value _)
                (set! s next-state)
                (set! arm-mask value)])])
        (set! lane (+ lane 1))))
    (match (lower-emit-mask-binop
      s
      (And)
      (lower-global-shared-view active-mask)
      arm-mask
      lanes)
      [(Expr active-arm-state active-arm-mask _)
        (match (lower-emit-mask-not
          active-arm-state
          (lower-global-shared-view active-arm-mask)
          lanes)
          [(Expr not-state not-mask _)
            (match (lower-emit-mask-binop
              not-state
              (And)
              active-mask
              not-mask
              lanes)
              [(Expr rest-state rest-mask _)
                (Ok (Masks rest-state active-arm-mask rest-mask))])])])))

(define (lower-avx2-enum-final-arm-masks
  [state : LowerState]
  [active-mask : ir.CompilerIrValue]
  [lane-id : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]) : ResultLowerMaskedMatchMasks
  (match (lower-avx2-enum-zero-mask state lane-id lanes lane-ty)
    [(Expr next-state zero-mask _)
      (Ok (Masks next-state active-mask zero-mask))]))

(define (lower-avx2-enum-pattern-arm-masks
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [base : ir.CompilerIrValue]
  [enum-ty : ast.AstType]
  [active-mask : ir.CompilerIrValue]
  [lane-id : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]
  [pattern : ast.AstPattern]
  [final? : bool]
  [expr : ast.AstExpr]) : ResultLowerMaskedMatchMasks
  (if final?
    (lower-avx2-enum-final-arm-masks state active-mask lane-id lanes lane-ty)
    (match pattern
      [(Binding name)
        (let
          [handle : i64
            (lower-variant-handle-for-scrut-id-or
              ctx
              (lower-global-shared-view enum-ty)
              name
              (csym.compiler-symbols-missing-handle))]
          (if (csym.compiler-symbols-handle-found? handle)
            (lower-avx2-enum-tag-arm-masks
              state
              base
              (lower-type-size ctx enum-ty)
              active-mask
              lane-id
              lanes
              lane-ty
              (csym.compiler-registry-handle-child-index handle))
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  expr
                  "lower: varying enum pattern has no registered variant")))))]
      [(Variant name _)
        (let
          [handle : i64
            (lower-variant-handle-for-scrut-id-or
              ctx
              (lower-global-shared-view enum-ty)
              name
              (csym.compiler-symbols-missing-handle))]
          (if (csym.compiler-symbols-handle-found? handle)
            (lower-avx2-enum-tag-arm-masks
              state
              base
              (lower-type-size ctx enum-ty)
              active-mask
              lane-id
              lanes
              lane-ty
              (csym.compiler-registry-handle-child-index handle))
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  expr
                  "lower: varying enum pattern has no registered variant")))))]
      [(Wildcard)
        (lower-avx2-enum-final-arm-masks
          state
          active-mask
          lane-id
          lanes
          lane-ty)]
      [_
        (Err
          (box
            (lower-diagnostic-at-expr
              ctx
              expr
              "lower: unsupported SIMD varying enum match pattern")))])))

(define (lower-avx2-enum-bind-payloads
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [base : ir.CompilerIrValue]
  [enum-ty : ast.AstType]
  [variant-name-id : i64]
  [patterns : ast.AstPatternList]
  [fields : ast.AstTypeList]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [pattern-index : i64]
  [cursor : i64]
  [expr : ast.AstExpr]) : ResultLowerMaskedEnumEnv
  (if (>= pattern-index patterns.len)
    (if (>= pattern-index (ast.ast-type-list-len (& fields)))
      (Ok state env type-env lane-locals)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            expr
            "lower: varying enum payload pattern arity mismatch"))))
    (if (>= pattern-index (ast.ast-type-list-len (& fields)))
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            expr
            "lower: varying enum payload pattern arity mismatch")))
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get
            (& patterns)
            pattern-index
            (ast.ast-pattern-fallback))]
        [field-node : i64
          (ast.ast-type-list-get
            (& fields)
            pattern-index
            (ast.ast-type-id-fallback))]
        [field-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx field-node)))]
        [default-offset : i64
          (lower-align-up cursor (lower-type-align ctx field-ty))]
        [enum-id : i64 (lower-enum-type-name-id-or enum-ty -1)]
        [enum-name : String
          (lower-enum-type-name-or-empty (lower-global-shared-view enum-ty))]
        [variant-name : String (tc_core.tc-env-key-name-text variant-name-id)]
        [field-offset : i64
          (lower-variant-payload-offset
            ctx
            enum-id
            enum-name
            variant-name
            variant-name-id
            pattern-index
            cursor
            (lower-global-shared-view field-ty))]
        [next-cursor : i64 (+ default-offset (lower-type-size ctx field-ty))]
        (if (< field-offset 0)
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                expr
                "lower: varying enum payload layout is unavailable")))
          (match pattern
            [(Wildcard)
              (lower-avx2-enum-bind-payloads
                ctx
                state
                env
                type-env
                lane-locals
                base
                enum-ty
                variant-name-id
                patterns
                fields
                active-mask
                lanes
                (+ pattern-index 1)
                next-cursor
                expr)]
            [(Binding name)
              (match (lower-avx2-enum-field-vector
                state
                (lower-global-shared-view base)
                (lower-type-size ctx enum-ty)
                field-offset
                (lower-global-shared-view active-mask)
                lanes
                (lower-global-shared-view field-ty))
                [(Expr next-state value _)
                  (match value
                    [(Var field-var)
                      (lower-avx2-enum-bind-payloads
                        ctx
                        next-state
                        (sym_i64_env.sym-i64-bind-id env name field-var)
                        (tc_core.tc-bind-id type-env name field-ty)
                        (lower-id-set-insert lane-locals name)
                        base
                        enum-ty
                        variant-name-id
                        patterns
                        fields
                        active-mask
                        lanes
                        (+ pattern-index 1)
                        next-cursor
                        expr)]
                    [_
                      (Err
                        (box
                          (lower-diagnostic-at-expr
                            ctx
                            expr
                            "lower: varying enum payload did not produce an IR variable")))])])]
            [(Var name _)
              (match (lower-avx2-enum-field-vector
                state
                (lower-global-shared-view base)
                (lower-type-size ctx enum-ty)
                field-offset
                (lower-global-shared-view active-mask)
                lanes
                (lower-global-shared-view field-ty))
                [(Expr next-state value _)
                  (match value
                    [(Var field-var)
                      (lower-avx2-enum-bind-payloads
                        ctx
                        next-state
                        (sym_i64_env.sym-i64-bind-id env name field-var)
                        (tc_core.tc-bind-id type-env name field-ty)
                        (lower-id-set-insert lane-locals name)
                        base
                        enum-ty
                        variant-name-id
                        patterns
                        fields
                        active-mask
                        lanes
                        (+ pattern-index 1)
                        next-cursor
                        expr)]
                    [_
                      (Err
                        (box
                          (lower-diagnostic-at-expr
                            ctx
                            expr
                            "lower: varying enum payload did not produce an IR variable")))])])]
            [_
              (Err
                (box
                  (lower-diagnostic-at-expr
                    ctx
                    expr
                    "lower: SIMD varying enum payload patterns support bindings and wildcards")))]))))))

(define (lower-avx2-enum-bind-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [base : ir.CompilerIrValue]
  [enum-ty : ast.AstType]
  [pattern : ast.AstPattern]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [expr : ast.AstExpr]) : ResultLowerMaskedEnumEnv
  (match pattern
    [(Binding _) (Ok state env type-env lane-locals)]
    [(Variant name patterns-box)
      (let
        [handle : i64
          (lower-variant-handle-for-scrut-id-or
            ctx
            (lower-global-shared-view enum-ty)
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? handle)
          (match (csym.compiler-registries-variant-fields-indexed
            (tc_core.tc-context-symbols ctx)
            handle)
            [(Ok raw-fields)
              (let
                [variant-name-id : i64
                  (lower-variant-handle-name-id-or ctx handle name)]
                [fields : ast.AstTypeList
                  (lower-variant-payload-fields-for-handle
                    ctx
                    handle
                    (lower-global-shared-view enum-ty)
                    raw-fields)]
                (lower-avx2-enum-bind-payloads
                  ctx
                  state
                  env
                  type-env
                  lane-locals
                  base
                  enum-ty
                  variant-name-id
                  (deref patterns-box)
                  fields
                  active-mask
                  lanes
                  0
                  8
                  expr))]
            [(Err message)
              (Err (box (lower-diagnostic-at-expr ctx expr message)))])
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                expr
                "lower: varying enum pattern has no registered variant")))))]
    [(Wildcard) (Ok state env type-env lane-locals)]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            expr
            "lower: unsupported SIMD varying enum match pattern")))]))

(define (lower-avx2-enum-match-arms
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrValue]
  [lane-id : ir.CompilerIrValue]
  [lanes : i64]
  [lane-ty : ast.AstType]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [base : ir.CompilerIrValue]
  [enum-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : ResultLowerExpr
  (if (ast.ast-match-arm-list-empty? (& arms))
    (lower-avx512-masked-unsupported
      ctx
      expr
      "SIMD varying enum match with no arms")
    (match (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (let
          [rest : ast.AstMatchArmList (ast.ast-match-arm-list-tail arms)]
          [final? : bool (ast.ast-match-arm-list-empty? (& rest))]
          [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
          [masks
            (try
              (lower-avx2-enum-pattern-arm-masks
                ctx
                state
                (lower-global-shared-view base)
                (lower-global-shared-view enum-ty)
                active-mask
                (lower-global-shared-view lane-id)
                lanes
                (lower-global-shared-view lane-ty)
                (lower-global-shared-view pattern)
                final?
                (lower-global-shared-view expr)))]
          (match masks
            [(Masks mask-state arm-mask rest-mask)
              (match (lower-avx2-enum-bind-pattern
                ctx
                mask-state
                env
                type-env
                (lower-global-shared-view lane-locals)
                (lower-global-shared-view base)
                (lower-global-shared-view enum-ty)
                pattern
                (lower-global-shared-view arm-mask)
                lanes
                (lower-global-shared-view expr))
                [(Ok bound-state bound-env bound-type-env bound-lane-locals)
                  (let
                    [body-lowered
                      (try
                        (lower-avx512-masked-expr-expected
                          ctx
                          bound-state
                          bound-env
                          bound-type-env
                          bound-lane-locals
                          (lower-global-shared-view index)
                          index-var
                          (Some (lower-global-shared-view arm-mask))
                          lanes
                          body
                          result-ty))]
                    (match (lower-global-shared-view body-lowered)
                      [(Expr body-state body-value body-ty)
                        (if final?
                          (Ok body-lowered)
                          (let
                            [rest-lowered
                              (try
                                (lower-avx2-enum-match-arms
                                  ctx
                                  body-state
                                  env
                                  type-env
                                  lane-locals
                                  index
                                  index-var
                                  (lower-global-shared-view rest-mask)
                                  lane-id
                                  lanes
                                  lane-ty
                                  result-ty
                                  (lower-global-shared-view expr)
                                  base
                                  enum-ty
                                  rest))]
                            (match rest-lowered
                              [(Expr rest-state rest-value rest-ty)
                                (match (lower-global-shared-view body-ty)
                                  [(Unit) (Ok (Expr rest-state Unit (Unit)))]
                                  [_
                                    (if (ast.ast-type-eq-with-pools?
                                      (tc_core.tc-context-pools ctx)
                                      (tc_core.tc-type-without-regions
                                        (lower-global-shared-view body-ty))
                                      (tc_core.tc-type-without-regions rest-ty))
                                      (lower-avx512-masked-match-select
                                        ctx
                                        rest-state
                                        arm-mask
                                        body-value
                                        rest-mask
                                        rest-value
                                        lanes
                                        body-ty
                                        expr)
                                      (lower-avx512-masked-unsupported
                                        ctx
                                        expr
                                        "mixed SIMD varying enum match arm result types"))])])))]))]
                [(Err message) (Err message)])]))])))

(define (lower-avx2-masked-enum-match
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]) : ResultLowerExpr
  (match (lower-avx2-masked-enum-source
    ctx
    state
    env
    type-env
    lane-locals
    index
    index-var
    scrutinee)
    [(Ok source)
      (match source
        [(Source source-state base enum-ty)
          (let
            [lane-ty : ast.AstType
              (lower-enum-mask-lane-type (lower-state-mode source-state) lanes)]
            (match (lower-emit-lane-id
              source-state
              lanes
              (lower-global-shared-view lane-ty))
              [(Expr lane-state lane-id _)
                (lower-avx2-enum-match-arms
                  ctx
                  lane-state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lane-id
                  lanes
                  lane-ty
                  result-ty
                  expr
                  base
                  enum-ty
                  arms)]))])]
    [(Err message) (Err message)]
    [(No)
      (lower-avx512-masked-unsupported
        ctx
        expr
        "a SIMD varying enum match source outside a contiguous array lane")]))

(define (lower-avx512-masked-match-literal-mask
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [lanes : i64]
  [lit : ast.AstLiteral]) : ResultLowerExpr
  (match (tc_core.tc-type-without-regions (lower-global-shared-view scrut-ty))
    [(Bool)
      (match lit
        [(Bool value)
          (if value
            (Ok (Expr state scrut-value (Bool)))
            (Ok (lower-emit-mask-not state scrut-value lanes)))]
        [_
          (Err
            (box
              (lower-diagnostic "lower: unsupported bool literal match pattern")))])]
    [_
      (match (lower-emit-splat
        state
        (lower-literal-value-with-type
          (tc_core.tc-context-source-names ctx)
          lit
          (tc_core.tc-type-without-regions (lower-global-shared-view scrut-ty)))
        lanes
        (tc_core.tc-type-without-regions (lower-global-shared-view scrut-ty)))
        [(Expr lit-state lit-value _)
          (Ok
            (lower-emit-vector-compare
              lit-state
              (Eq)
              scrut-value
              lit-value
              lanes
              (tc_core.tc-type-without-regions scrut-ty)))])]))

(define (lower-avx512-masked-match-literal-arm-masks
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [active-mask : ir.CompilerIrValue]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [lanes : i64]
  [lit : ast.AstLiteral]) : ResultLowerMaskedMatchMasks
  (let
    [cond-lowered : LowerExpr
      (try
        (lower-avx512-masked-match-literal-mask
          ctx
          state
          scrut-value
          scrut-ty
          lanes
          lit))]
    (match cond-lowered
      [(Expr cond-state cond-mask _)
        (match (lower-emit-mask-binop
          cond-state
          (And)
          (lower-global-shared-view active-mask)
          (lower-global-shared-view cond-mask)
          lanes)
          [(Expr arm-mask-state arm-mask _)
            (match (lower-emit-mask-not arm-mask-state cond-mask lanes)
              [(Expr not-state not-mask _)
                (match (lower-emit-mask-binop
                  not-state
                  (And)
                  (lower-global-shared-view active-mask)
                  not-mask
                  lanes)
                  [(Expr rest-mask-state rest-mask _)
                    (lower-masked-load-register-mask!
                      rest-mask-state
                      (Some (lower-global-shared-view active-mask))
                      (lower-global-shared-view arm-mask))
                    (lower-masked-load-register-mask!
                      rest-mask-state
                      (Some active-mask)
                      (lower-global-shared-view rest-mask))
                    (Ok (Masks rest-mask-state arm-mask rest-mask))])])])])))

(define (lower-avx512-masked-match-select
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [arm-mask : ir.CompilerIrValue]
  [arm-value : ir.CompilerIrValue]
  [rest-mask : ir.CompilerIrValue]
  [rest-value : ir.CompilerIrValue]
  [lanes : i64]
  [ty : ast.AstType]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (if (lower-type-bool? ty)
    (Ok
      (lower-emit-mask-select
        state
        arm-mask
        arm-value
        rest-mask
        rest-value
        lanes))
    (if (lower-avx512-masked-select-result-supported?
      state
      lanes
      (lower-global-shared-view ty))
      (Ok
        (lower-emit-select
          state
          arm-mask
          arm-value
          rest-value
          lanes
          (tc_core.tc-type-without-regions ty)))
      (lower-avx512-masked-unsupported
        ctx
        expr
        "this value-producing varying match result type"))))

(define (lower-avx512-masked-match-after-body
  [ctx : tc_core.TcContext]
  [body-state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [arm-mask : ir.CompilerIrValue]
  [rest-mask : ir.CompilerIrValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [body-value : ir.CompilerIrValue]
  [body-ty : ast.AstType]
  [rest : ast.AstMatchArmList]) : ResultLowerExpr
  (match (lower-global-shared-view body-ty)
    [(Unit)
      (lower-avx512-masked-match-arms
        ctx
        body-state
        env
        type-env
        lane-locals
        index
        index-var
        rest-mask
        lanes
        result-ty
        expr
        scrut-value
        scrut-ty
        rest)]
    [_
      (let
        [rest-lowered
          (try
            (lower-avx512-masked-match-arms
              ctx
              body-state
              env
              type-env
              lane-locals
              index
              index-var
              (lower-global-shared-view rest-mask)
              lanes
              result-ty
              (lower-global-shared-view expr)
              scrut-value
              scrut-ty
              rest))]
        (match rest-lowered
          [(Expr rest-state rest-value rest-ty)
            (if (ast.ast-type-eq-with-pools?
              (tc_core.tc-context-pools ctx)
              (tc_core.tc-type-without-regions
                (lower-global-shared-view body-ty))
              (tc_core.tc-type-without-regions rest-ty))
              (lower-avx512-masked-match-select
                ctx
                rest-state
                arm-mask
                body-value
                rest-mask
                rest-value
                lanes
                body-ty
                expr)
              (lower-avx512-masked-unsupported
                ctx
                expr
                "mixed varying match arm result types"))]))]))

(define (lower-avx512-masked-match-arm
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]) : ResultLowerExpr
  (match pattern
    [(Literal lit)
      (if (ast.ast-match-arm-list-empty? (& rest))
        (lower-avx512-masked-expr-expected
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          (Some active-mask)
          lanes
          body
          result-ty)
        (let
          [masks
            (try
              (lower-avx512-masked-match-literal-arm-masks
                ctx
                state
                active-mask
                (lower-global-shared-view scrut-value)
                (lower-global-shared-view scrut-ty)
                lanes
                lit))]
          (match masks
            [(Masks mask-state arm-mask rest-mask)
              (let
                [body-lowered
                  (try
                    (lower-avx512-masked-expr-expected
                      ctx
                      mask-state
                      env
                      type-env
                      (lower-global-shared-view lane-locals)
                      (lower-global-shared-view index)
                      index-var
                      (Some (lower-global-shared-view arm-mask))
                      lanes
                      body
                      result-ty))]
                (match body-lowered
                  [(Expr body-state body-value body-ty)
                    (lower-avx512-masked-match-after-body
                      ctx
                      body-state
                      env
                      type-env
                      lane-locals
                      index
                      index-var
                      arm-mask
                      rest-mask
                      lanes
                      result-ty
                      expr
                      scrut-value
                      scrut-ty
                      body-value
                      body-ty
                      rest)]))])))]
    [(Wildcard)
      (lower-avx512-masked-expr-expected
        ctx
        state
        env
        type-env
        lane-locals
        index
        index-var
        (Some active-mask)
        lanes
        body
        result-ty)]
    [(Var name _)
      (match scrut-value
        [(Var scrut-var)
          (lower-avx512-masked-expr-expected
            ctx
            state
            (sym_i64_env.sym-i64-bind-id env name scrut-var)
            (tc_core.tc-bind-id type-env name scrut-ty)
            (lower-id-set-insert lane-locals name)
            index
            index-var
            (Some active-mask)
            lanes
            body
            result-ty)]
        [_
          (lower-avx512-masked-unsupported
            ctx
            expr
            "non-variable match binding values in this AVX-512 slice")])]
    [(Binding name)
      (match scrut-value
        [(Var scrut-var)
          (lower-avx512-masked-expr-expected
            ctx
            state
            (sym_i64_env.sym-i64-bind-id env name scrut-var)
            (tc_core.tc-bind-id type-env name scrut-ty)
            (lower-id-set-insert lane-locals name)
            index
            index-var
            (Some active-mask)
            lanes
            body
            result-ty)]
        [_
          (lower-avx512-masked-unsupported
            ctx
            expr
            "non-variable match binding values in this AVX-512 slice")])]
    [_
      (lower-avx512-masked-unsupported
        ctx
        expr
        "this varying match pattern in the AVX-512 slice")]))

(define (lower-avx512-masked-match-arms
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]) : ResultLowerExpr
  (if (ast.ast-match-arm-list-empty? (& arms))
    (lower-avx512-masked-unsupported
      ctx
      expr
      "match with no arms in this AVX-512 slice")
    (match (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback))
      [(Arm pattern body-box)
        (lower-avx512-masked-match-arm
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          result-ty
          expr
          scrut-value
          scrut-ty
          pattern
          (lower-context-expr-get ctx body-box)
          (ast.ast-match-arm-list-tail arms))])))

(define (lower-avx512-masked-match
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [result-ty : ast.AstType]
  [expr : ast.AstExpr]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]) : ResultLowerExpr
  (if (match (lower-expr-result-type-or-check
    ctx
    env
    type-env
    (lower-state-type-cache state)
    (lower-state-function-state state)
    scrutinee)
    [(Ok scrut-ty) (lower-spmd-enum-type? scrut-ty)]
    [(Err _) false])
    (match (lower-masked-active-mask-value state active-mask lanes)
      [(Expr mask-state mask _)
        (lower-avx2-masked-enum-match
          ctx
          mask-state
          env
          type-env
          lane-locals
          index
          index-var
          mask
          lanes
          result-ty
          expr
          scrutinee
          arms)])
    (let
      [scrut-lowered
        (try
          (lower-avx512-masked-expr
            ctx
            state
            env
            type-env
            lane-locals
            (lower-global-shared-view index)
            index-var
            (lower-global-shared-view active-mask)
            lanes
            scrutinee))]
      (match scrut-lowered
        [(Expr scrut-state scrut-value scrut-ty)
          (match (lower-masked-active-mask-value scrut-state active-mask lanes)
            [(Expr mask-state mask _)
              (lower-avx512-masked-match-arms
                ctx
                mask-state
                env
                type-env
                lane-locals
                index
                index-var
                mask
                lanes
                result-ty
                expr
                scrut-value
                scrut-ty
                arms)])]))))

(define (lower-spmd-ir-value-class [ty : ast.AstType] [varying : bool]) : ir.CompilerIrSpmdValueClass
  (if varying
    (if (lower-type-bool? ty)
      (Mask)
      (Varying))
    (Uniform)))

(define (lower-avx512-spmd-call-args
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]) : ResultLowerSpmdCallArgs
  (let
    [builder : ir.CompilerIrSpmdCallArgBuilder
      (ir.compiler-ir-spmd-call-arg-builder-with-capacity
        (ast.ast-param-list-len (& params)))]
    (lower-avx512-spmd-call-args-at
      ctx
      (lower-state-function-state state)
      state
      env
      type-env
      (lower-global-shared-view lane-locals)
      (lower-masked-vector-lane-locals-from-set lane-locals lanes)
      index
      index-var
      active-mask
      lanes
      (& params)
      (& args)
      0
      (&mut builder))))

(define (lower-avx512-spmd-call-args-at
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [analysis-locals : lower_i64_i64_map.Map]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]
  [builder : (&mut builder ir.CompilerIrSpmdCallArgBuilder)]) : ResultLowerSpmdCallArgs
  (cond
    [(and
        (>= arg-index (ast.ast-param-list-len params))
        (>= arg-index args.len))
      (Ok state (ir.compiler-ir-spmd-call-arg-builder-snapshot builder) false)]
    [(or (>= arg-index (ast.ast-param-list-len params)) (>= arg-index args.len))
      (Err (box (lower-diagnostic "lower: SPMD helper call arity mismatch")))]
    [else
      (match (ast.ast-param-list-get params arg-index (ast.ast-param-fallback))
        [(Param _ param-ty _)
          (let
            [arg : ast.AstExpr
              (lower-context-expr-get
                ctx
                (ast.ast-expr-list-get args arg-index 0))]
            [resolved-ty : ast.AstType
              (tc_core.tc-type-without-regions
                (tc_core.tc-resolve-type ctx param-ty))]
            [arg-lanes : i64
              (lower-masked-vector-expr-lanes-with-locals
                ctx
                (lower-state-function-state state)
                (lower-state-mode state)
                env
                type-env
                (lower-global-shared-view index)
                analysis-locals
                (lower-global-shared-view arg))]
            [varying : bool (> arg-lanes 0)]
            (if (< arg-lanes 0)
              (Err
                (box
                  (lower-diagnostic-at-expr
                    ctx
                    arg
                    "lower: unsupported SPMD helper argument expression")))
              (let
                [lowered
                  (try
                    (if varying
                      (lower-avx512-masked-expr-expected
                        ctx
                        state
                        env
                        type-env
                        (lower-global-shared-view lane-locals)
                        (lower-global-shared-view index)
                        index-var
                        (lower-global-shared-view active-mask)
                        lanes
                        arg
                        resolved-ty)
                      (lower-expr-expected
                        ctx
                        state
                        env
                        type-env
                        (lower-global-shared-view arg)
                        (lower-global-shared-view resolved-ty)
                        arg)))]
                (match lowered
                  [(Expr arg-state arg-value _)
                    (ir.compiler-ir-spmd-call-arg-builder-push!
                      builder
                      (ir.CompilerIrSpmdCallArg.Arg
                        (lower-spmd-ir-value-class
                          (lower-global-shared-view resolved-ty)
                          varying)
                        arg-value
                        resolved-ty))
                    (match (lower-avx512-spmd-call-args-at
                      ctx
                      function-state
                      arg-state
                      env
                      type-env
                      lane-locals
                      analysis-locals
                      index
                      index-var
                      active-mask
                      lanes
                      params
                      args
                      (+ arg-index 1)
                      builder)
                      [(Ok rest-state rest-args rest-varying)
                        (Ok rest-state rest-args (or varying rest-varying))]
                      [(Err message) (Err message)])]))))])]))

(define (lower-spmd-call-lane-locals
  [params : (& params ast.AstParamList)]
  [args : (& args ir.CompilerIrSpmdCallArgSeq)]) : LowerIdSet
  (lower-spmd-call-lane-locals-at (& params) args 0 (lower-id-set-empty)))

(define (lower-spmd-call-lane-locals-at
  [params : (& params ast.AstParamList)]
  [args : (& args ir.CompilerIrSpmdCallArgSeq)]
  [index : i64]
  [out : LowerIdSet]) : LowerIdSet
  (lower-spmd-call-lane-locals-seq-at params args index out))

(define (lower-spmd-call-lane-locals-seq-at
  [params : (& params ast.AstParamList)]
  [args : (& args ir.CompilerIrSpmdCallArgSeq)]
  [index : i64]
  [out : LowerIdSet]) : LowerIdSet
  (if (or (>= index (ast.ast-param-list-len params)) (>= index args.len))
    out
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name _ _)
        (match (array-ref args.slots index)
          [(Arg class _ _)
            (lower-spmd-call-lane-locals-seq-at
              params
              args
              (+ index 1)
              (match class
                [(Uniform) out]
                [_ (lower-id-set-insert out name)]))])])))

(define (lower-spmd-source-param-types-at
  [params : (& params ast.AstParamList)]
  [index : i64]
  [out : (&mut out ast.AstTypeList)]) : unit
  (unless
    (>= index (ast.ast-param-list-len params))
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param _ ty _)
        (ast.ast-type-list-push out (ast.ast-node-pool-reader-type-push ty))])
    (lower-spmd-source-param-types-at params (+ index 1) out)))

(define (lower-spmd-source-signature
  [params : ast.AstParamList]
  [ret : ast.AstType]) : String
  (let
    [types : ast.AstTypeList
      (ast.ast-type-list-with-capacity (ast.ast-param-list-len (& params)))]
    (lower-spmd-source-param-types-at (& params) 0 (&mut types))
    (tc_core.tc-type-render (ast.ast-ty-func types ret))))

(define (lower-imported-spmd-params-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [out : (&mut out ast.AstParamList)]) : unit
  (if (>= index (ast.ast-type-list-len types))
    unit
    (let
      [ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (ast.ast-param-list-push
        out
        (ast.AstParam.Param cbi.compiler-builtin-id-fix-empty ty false))
      (lower-imported-spmd-params-at ctx types (+ index 1) out))))

(define (lower-imported-spmd-params
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : ast.AstParamList
  (let
    [out : ast.AstParamList
      (ast.ast-param-list-with-capacity (ast.ast-type-list-len (& types)))]
    (lower-imported-spmd-params-at ctx (& types) 0 (&mut out))
    out))

(define (lower-imported-spmd-call-arg-code [arg : ir.CompilerIrSpmdCallArg]) : String
  (match arg
    [(Arg class _ _)
      (match class
        [(Uniform) "u"]
        [_ "v"])]))

(define (lower-imported-spmd-call-args-code-at
  [args : ir.CompilerIrSpmdCallArgSeq]
  [index : i64]
  [count : i64]) : String
  (if (>= index count)
    ""
    (str_cat.str-cat
      (lower-imported-spmd-call-arg-code (lower-spmd-call-arg-at args index))
      (lower-imported-spmd-call-args-code-at args (+ index 1) count))))

(define (lower-imported-spmd-call-args-code
  [args : ir.CompilerIrSpmdCallArgSeq]) : String
  (lower-imported-spmd-call-args-code-at
    (lower-global-shared-view args)
    0
    (ir.compiler-ir-spmd-call-arg-seq-count args)))

;; TLCI records the final archive/link name, while existing `SpmdCall` IR
;; carries a logical TypeLisp name that the backend decorates with `_tl_`.
;; Private ABI v1 symbols are generated by that backend rule, so remove its
;; prefix exactly once before reusing the established IR.
(define (lower-imported-spmd-ir-symbol
  [interns : (&mut interns ci.InternCompatState)]
  [item : ast.AstImportedSpmdSpecialization]) : i64
  (let
    [link-symbol-id : ci.InternId item.symbol]
    [link-symbol : String
      (ci.intern-compat-state-id-str interns link-symbol-id)]
    [link-symbol-len : i64 (string.string-length link-symbol)]
    (if (and
      (> link-symbol-len 4)
      (lower-string-prefix-at? (lower-global-shared-view link-symbol) "_tl_" 0))
      (ci.intern-compat-state-generated-canonical-name
        interns
        (string.substring link-symbol 4 (- link-symbol-len 4)))
      (ci.intern-id-value link-symbol-id))))

(define (lower-imported-spmd-call-origin
  [interns : (& interns ci.InternCompatState)]
  [owner : String]
  [version : String]
  [canonical-name : ci.InternId]
  [signature : String]
  [item : ast.AstImportedSpmdSpecialization]) : ir.CompilerIrSpmdCallOrigin
  (Imported
    (box
      (ir.CompilerIrImportedSpmdCall
        owner
        version
        (ci.intern-compat-state-id-str interns canonical-name)
        signature
        (ci.intern-compat-state-id-str interns item.abi)
        (ci.intern-compat-state-id-str interns item.backend)
        item.lanes
        (ci.intern-compat-state-id-str interns item.args)
        (ci.intern-compat-state-id-str interns item.result)
        item.index-param
        (ci.intern-compat-state-id-str interns item.symbol)))))

(define (lower-imported-spmd-backend-name [backend : ir.CompilerIrSpmdBackend]) : String
  (match backend
    [(Scalar) "scalar"]
    [(Avx2) "avx2"]
    [(Avx512) "avx512"]))

(define (lower-imported-spmd-specialization-key-matches?
  [interns : (& interns ci.InternCompatState)]
  [item : ast.AstImportedSpmdSpecialization]
  [backend : (& backend str)]
  [lanes : i64]
  [args-code : (& args-code str)]
  [index-param : i64]) : bool
  (and
    (string.eq (ci.intern-compat-state-id-str interns item.backend) backend)
    (= item.lanes lanes)
    (string.eq (ci.intern-compat-state-id-str interns item.args) args-code)
    (= item.index-param index-param)))

(define (lower-imported-spmd-result-compatible?
  [interns : (& interns ci.InternCompatState)]
  [item : ast.AstImportedSpmdSpecialization]
  [ret : ast.AstType]) : bool
  (let
    [result : String (ci.intern-compat-state-id-str interns item.result)]
    (if (tc_core.tc-type-eq (tc_core.tc-type-without-regions ret) (Unit))
      (string.eq result "unit")
      (or (string.eq result "u") (string.eq result "v")))))

(define (lower-imported-spmd-selection-error
  [pools : ast.AstNodePoolContext]
  [origin : ast.AstExpr]
  [canonical-name : String]
  [message : String]) : ResultLowerImportedSpmdSpecialization
  (Err
    (box
      (lower-diagnostic-at-expr-with-pools
        pools
        origin
        (str_cat.str-cat
          "lower: imported SPMD helper `"
          canonical-name
          "` "
          message)))))

(define (lower-imported-spmd-selection-scan-new) : LowerImportedSpmdSelectionScan
  (LowerImportedSpmdSelectionScan
    0
    0
    -1
    -1
    0
    (ast.ast-imported-spmd-specialization-fallback)))

(define (lower-imported-spmd-selection-scan-specializations-at
  [interns : (& interns ci.InternCompatState)]
  [specializations : (& specializations ast.AstImportedSpmdSpecializationList)]
  [index : i64]
  [backend-name : (& backend-name str)]
  [lanes : i64]
  [args-code : (& args-code str)]
  [requested-index-param : i64]
  [ret : ast.AstType]
  [scan : LowerImportedSpmdSelectionScan]) : LowerImportedSpmdSelectionScan
  (if (>= index (ast.ast-imported-spmd-specialization-list-len specializations))
    scan
    (let
      [item : ast.AstImportedSpmdSpecialization
        (ast.ast-imported-spmd-specialization-list-get
          specializations
          index
          (ast.ast-imported-spmd-specialization-fallback))]
      [abi-id : ci.InternId item.abi]
      [abi : String (ci.intern-compat-state-id-str interns abi-id)]
      [abi-raw : i64 (ci.intern-id-value abi-id)]
      [key-matches : bool
        (and
          (lower-imported-spmd-specialization-key-matches?
            interns
            item
            backend-name
            lanes
            args-code
            requested-index-param)
          (lower-imported-spmd-result-compatible?
            interns
            item
            (lower-global-shared-view ret)))]
      [next : LowerImportedSpmdSelectionScan
        (if (string.eq abi "spmd-call-v1")
          (LowerImportedSpmdSelectionScan
            scan.signature-count
            (+ scan.supported-abi-count 1)
            scan.unsupported-abi-id
            scan.unsupported-key-abi-id
            (if key-matches
              (+ scan.selected-count 1)
              scan.selected-count)
            (if key-matches
              item
              scan.selected))
          (LowerImportedSpmdSelectionScan
            scan.signature-count
            scan.supported-abi-count
            (if (< scan.unsupported-abi-id 0)
              abi-raw
              scan.unsupported-abi-id)
            (if (and key-matches (< scan.unsupported-key-abi-id 0))
              abi-raw
              scan.unsupported-key-abi-id)
            scan.selected-count
            scan.selected))]
      (lower-imported-spmd-selection-scan-specializations-at
        interns
        specializations
        (+ index 1)
        backend-name
        lanes
        args-code
        requested-index-param
        ret
        next))))

(define (lower-imported-spmd-selection-scan-callables-at
  [interns : (& interns ci.InternCompatState)]
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [index : i64]
  [signature : (& signature str)]
  [backend-name : (& backend-name str)]
  [lanes : i64]
  [args-code : (& args-code str)]
  [requested-index-param : i64]
  [ret : ast.AstType]
  [scan : LowerImportedSpmdSelectionScan]) : LowerImportedSpmdSelectionScan
  (if (>= index (ast.ast-imported-spmd-callable-list-len callables))
    scan
    (let
      [callable : ast.AstImportedSpmdCallable
        (ast.ast-imported-spmd-callable-list-get
          callables
          index
          (ast.ast-imported-spmd-callable-fallback))]
      [matches-signature : bool
        (string.eq
          (ci.intern-compat-state-id-str interns callable.signature)
          signature)]
      [signature-scan : LowerImportedSpmdSelectionScan
        (if matches-signature
          (LowerImportedSpmdSelectionScan
            (+ scan.signature-count 1)
            scan.supported-abi-count
            scan.unsupported-abi-id
            scan.unsupported-key-abi-id
            scan.selected-count
            scan.selected)
          scan)]
      [specializations : ast.AstImportedSpmdSpecializationList
        callable.specializations]
      [next : LowerImportedSpmdSelectionScan
        (if matches-signature
          (lower-imported-spmd-selection-scan-specializations-at
            interns
            (& specializations)
            0
            backend-name
            lanes
            args-code
            requested-index-param
            (lower-global-shared-view ret)
            signature-scan)
          signature-scan)]
      (lower-imported-spmd-selection-scan-callables-at
        interns
        callables
        (+ index 1)
        signature
        backend-name
        lanes
        args-code
        requested-index-param
        ret
        next))))

(define (lower-imported-spmd-select
  [interns : (& interns ci.InternCompatState)]
  [pools : ast.AstNodePoolContext]
  [canonical-name-id : ci.InternId]
  [callables : (& callables ast.AstImportedSpmdCallableList)]
  [signature : String]
  [backend : ir.CompilerIrSpmdBackend]
  [lanes : i64]
  [args-code : String]
  [requested-index-param : i64]
  [ret : ast.AstType]
  [origin : (& origin ast.AstExpr)]) : ResultLowerImportedSpmdSpecialization
  (let
    [origin : ast.AstExpr
      (owned_view.compiler-owned-reference-shared-view origin)]
    [canonical-name : String
      (ci.intern-compat-state-id-str interns canonical-name-id)]
    [backend-name : String (lower-imported-spmd-backend-name backend)]
    [callable-count : i64 (ast.ast-imported-spmd-callable-list-len callables)]
    [scan : LowerImportedSpmdSelectionScan
      (lower-imported-spmd-selection-scan-callables-at
        interns
        callables
        0
        signature
        backend-name
        lanes
        args-code
        requested-index-param
        ret
        (lower-imported-spmd-selection-scan-new))]
    (cond
      [(= callable-count 0)
        (lower-imported-spmd-selection-error
          pools
          origin
          canonical-name
          "has no TLCI callable metadata")]
      [(= scan.signature-count 0)
        (lower-imported-spmd-selection-error
          pools
          origin
          canonical-name
          (str_cat.str-cat
            "ordinary signature mismatch; consumer resolved "
            signature))]
      [(= scan.selected-count 1) (Ok scan.selected)]
      [(> scan.selected-count 1)
        (lower-imported-spmd-selection-error
          pools
          origin
          canonical-name
          (str_cat.str-cat
            "has duplicate TLCI specializations for the requested key (backend="
            backend-name
            ", lanes="
            (string.int->string lanes)
            ", args="
            args-code
            ", index-param="
            (string.int->string requested-index-param)
            ")"))]
      [(>= scan.unsupported-key-abi-id 0)
        (lower-imported-spmd-selection-error
          pools
          origin
          canonical-name
          (str_cat.str-cat
            "uses unsupported private ABI `"
            (ci.intern-compat-state-str interns scan.unsupported-key-abi-id)
            "`"))]
      [(and (= scan.supported-abi-count 0) (>= scan.unsupported-abi-id 0))
        (lower-imported-spmd-selection-error
          pools
          origin
          canonical-name
          (str_cat.str-cat
            "has no supported private ABI; first advertised ABI is `"
            (ci.intern-compat-state-str interns scan.unsupported-abi-id)
            "`"))]
      [(string.eq backend-name "avx2")
        (lower-imported-spmd-selection-error
          pools
          origin
          canonical-name
          "is not supported in AVX2 backend mode")]
      [else
        (lower-imported-spmd-selection-error
          pools
          origin
          canonical-name
          (str_cat.str-cat
            "has no requested specialization (backend="
            backend-name
            ", lanes="
            (string.int->string lanes)
            ", args="
            args-code
            ", index-param="
            (string.int->string requested-index-param)
            ")"))])))

(define (lower-imported-spmd-result-varying?
  [interns : (& interns ci.InternCompatState)]
  [item : ast.AstImportedSpmdSpecialization]) : bool
  (string.eq (ci.intern-compat-state-id-str interns item.result) "v"))

(define (lower-imported-spmd-index-param-at
  [ctx : tc_core.TcContext]
  [index-name : (& index-name str)]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]) : i64
  (if (or (= (string.string-length index-name) 0) (>= arg-index args.len))
    -1
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get args arg-index 0))]
      (if (= (lower-masked-vector-index-offset ctx index-name arg) 0)
        arg-index
        (lower-imported-spmd-index-param-at ctx index-name args (+ arg-index 1))))))

(define (lower-imported-spmd-index-param
  [ctx : tc_core.TcContext]
  [index-name : String]
  [args : (& args ast.AstExprList)]) : i64
  (lower-imported-spmd-index-param-at ctx index-name (& args) 0))

(define (lower-spmd-ast-param-class-code [class : ast.AstSpmdParamClass]) : String
  (match class
    [(Uniform) "u"]
    [(Varying) "v"]))

(define (lower-spmd-ast-result-class-code [class : ast.AstSpmdResultClass]) : String
  (match class
    [(Unit) "unit"]
    [(Uniform) "u"]
    [(Varying) "v"]))

(define (lower-spmd-ast-param-classes-code-at
  [items : (& items ast.AstSpmdParamClassList)]
  [index : i64]) : String
  (if (>= index (ast.ast-spmd-param-class-list-len items))
    ""
    (str_cat.str-cat
      (lower-spmd-ast-param-class-code
        (ast.ast-spmd-param-class-list-get items index Uniform))
      (lower-spmd-ast-param-classes-code-at items (+ index 1)))))

(define (lower-spmd-ast-param-classes-code [items : ast.AstSpmdParamClassList]) : String
  (lower-spmd-ast-param-classes-code-at (& items) 0))

(define (lower-spmd-package-backend-name [backend : ir.CompilerIrSpmdBackend]) : String
  (match backend
    [(Scalar) "scalar"]
    [(Avx2) "avx2"]
    [(Avx512) "avx512"]))

(define lower-spmd-package-abi : String
  "spmd-call-v1")

(define (lower-spmd-package-symbol-identity
  [package-name : String]
  [canonical-name : String]
  [signature : String]
  [backend : ir.CompilerIrSpmdBackend]
  [lanes : i64]
  [args : String]
  [result : String]
  [index-param : i64]) : String
  (str_cat.str-cat
    package-name
    "|"
    canonical-name
    "|"
    signature
    "|"
    (lower-global-shared-view lower-spmd-package-abi)
    "|"
    (lower-spmd-package-backend-name backend)
    "|"
    (string.int->string lanes)
    "|"
    args
    "|"
    result
    "|"
    (string.int->string index-param)))

(define (lower-spmd-package-symbol
  [package-name : String]
  [canonical-name : String]
  [signature : String]
  [result-ty : ast.AstType]
  [backend : ir.CompilerIrSpmdBackend]
  [lanes : i64]
  [args : String]
  [result : String]
  [index-param : i64]) : String
  (let
    [identity : String
      (lower-spmd-package-symbol-identity
        package-name
        canonical-name
        signature
        backend
        lanes
        args
        (lower-global-shared-view result)
        index-param)]
    [hash : i64 (stdlib.hash.string-key (& identity))]
    [stable-name : String
      (str_cat.str-cat "__tl_spmd_pkg_" (string.int->string hash))]
    ;; The private AVX-512 ABI is selected by the function-name prefix in the
    ;; backend.  Keep the stable package hash intact after that prefix so the
    ;; archive and TLCI still share one deterministic logical identity.
    (match backend
      [(Avx512)
        (if (string.eq result "v")
          (if (lower-type-bool? result-ty)
            (str_cat.str-cat "__tl_spmd_ret_mask_" stable-name)
            (str_cat.str-cat "__tl_spmd_ret_varying_" stable-name))
          (str_cat.str-cat "__tl_spmd_ret_uniform_" stable-name))]
      [_ stable-name])))

;; Typed scalar tags live only in fixed structural-record lanes. They are not
;; serialized and therefore cannot perturb the versioned `spmd-call-v1` text.
(define (lower-spmd-package-abi-role-tag) : i64
  1)

(define (lower-spmd-package-backend-role-tag
  [backend : ir.CompilerIrSpmdBackend]) : i64
  (match backend
    [(Scalar) 1]
    [(Avx2) 2]
    [(Avx512) 3]))

(define (lower-spmd-package-result-role-tag [result : ast.AstSpmdResultClass]) : i64
  (match result
    [(Unit) 1]
    [(Uniform) 2]
    [(Varying) 3]))

(define (lower-spmd-package-param-role-tag [class : ast.AstSpmdParamClass]) : i64
  (match class
    [(Uniform) 1]
    [(Varying) 2]))

(define (lower-spmd-private-param-class-role-tag
  [class : ir.CompilerIrSpmdValueClass]) : i64
  (match class
    [(Uniform) 1]
    [(Varying) 2]
    [(Mask) 3]))

(define (lower-spmd-private-param-mode-role-tag [mode : CompilerLowerMode]) : i64
  (cond [(lower-mode-avx2? mode) 2] [(lower-mode-avx512? mode) 3] [else 1]))

;; SPMD package ABI v1 admits only these resolved scalar source types. Keeping
;; the return type as its own typed lane makes identities structurally distinct
;; even if a future diagnostic fixture deliberately supplies equal serialized
;; text at the stable-hash boundary.
(define (lower-spmd-package-type-role-tag [ty : ast.AstType]) : i64
  (match (tc_core.tc-type-without-regions ty)
    [(I64) 1]
    [(U64) 2]
    [(F64) 3]
    [(F32) 4]
    [(I32) 5]
    [(U32) 6]
    [(I16) 7]
    [(U16) 8]
    [(I8) 9]
    [(U8) 10]
    [(Bool) 11]
    [(Unit) 12]
    [_ 0]))

(define (lower-spmd-package-arg-classes-role-at
  [intern-state : ci.InternCompatState]
  [classes : (& classes ast.AstSpmdParamClassList)]
  [index : i64]) : i64
  (if (>= index (ast.ast-spmd-param-class-list-len classes))
    0
    (let
      [owned-intern-state : ci.InternCompatState intern-state]
      [rest : i64
        (lower-spmd-package-arg-classes-role-at
          (lower-global-shared-view owned-intern-state)
          classes
          (+ index 1))]
      (ci.intern-compat-state-composite-triple-id
        (&mut owned-intern-state)
        -6023
        (lower-spmd-package-param-role-tag
          (ast.ast-spmd-param-class-list-get classes index Uniform))
        rest))))

(define (lower-spmd-result-wrapper-role
  [result-ty : ast.AstType]
  [varying? : bool]) : i64
  (if varying?
    (if (lower-type-bool? result-ty)
      (ci.intern-generated-symbol-role-spmd-result-mask)
      (ci.intern-generated-symbol-role-spmd-result-varying))
    (ci.intern-generated-symbol-role-spmd-result-uniform)))

(define (lower-spmd-package-stable-hash
  [lower-state : CompilerLowerState]
  [identity : i64]
  [identity-components : i64]) : i64
  (compiler-lower-state-ensure-spmd-package! lower-state)
  (let
    [package : CompilerLowerSpmdPackageState
      (compiler-lower-state-spmd-package lower-state)]
    (match (lower_i64_i64_map.get (& package.identity-stable-hashes) identity)
      [(LookupFound hash)
        ;; Record the cached serialization lookup as a render-cache hit.
        (lower-spmd-package-identity-render lower-state identity-components)
        hash]
      [(LookupMissing)
        (let
          [serialized : String
            (lower-spmd-package-identity-render lower-state identity-components)]
          [hash : i64 (stdlib.hash.string-key (& serialized))]
          (begin
            (cfg
              (any compile-profile test)
              (compiler-lower-profile-add!
                lower-state
                compiler-lower-profile-spmd-stable-hash-computations-metric
                1)
              unit)
            (in-arena
              (arena.Arena package.arena)
              (lower_i64_i64_map.insert-ref!
                (&mut package.identity-stable-hashes)
                identity
                hash))
            (compiler-lower-state-write!
              lower-state
              CompilerLowerSpmdPackageState
              spmd-package-state
              package)
            hash))])))

(define (lower-spmd-package-structural-symbol
  [lower-state : CompilerLowerState]
  [package-name : String]
  [canonical-name : String]
  [canonical-handle : i64]
  [signature : String]
  [result-ty : ast.AstType]
  [backend : ir.CompilerIrSpmdBackend]
  [lanes : i64]
  [classes : (& classes ast.AstSpmdParamClassList)]
  [result : ast.AstSpmdResultClass]
  [index-param : i64]) : i64
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    [package-atom : i64
      (ci.intern-compat-state-intern (&mut intern-state) package-name)]
    [canonical-text-atom : i64
      (ci.intern-compat-state-intern (&mut intern-state) canonical-name)]
    [signature-atom : i64
      (ci.intern-compat-state-intern (&mut intern-state) signature)]
    [canonical-components : i64
      (ci.intern-compat-state-composite-pair-id
        (&mut intern-state)
        canonical-handle
        canonical-text-atom)]
    [source-components : i64
      (ci.intern-compat-state-composite-pair-id
        (&mut intern-state)
        package-atom
        canonical-components)]
    [signature-components : i64
      (ci.intern-compat-state-composite-pair-id
        (&mut intern-state)
        signature-atom
        (lower-spmd-package-abi-role-tag))]
    [arg-components : i64
      (lower-spmd-package-arg-classes-role-at
        (lower-global-shared-view intern-state)
        (& classes)
        0)]
    [result-components : i64
      (ci.intern-compat-state-composite-pair-id
        (&mut intern-state)
        (lower-spmd-package-result-role-tag result)
        (lower-spmd-package-type-role-tag (lower-global-shared-view result-ty)))]
    [call-components : i64
      (ci.intern-compat-state-composite-triple-id
        (&mut intern-state)
        arg-components
        result-components
        index-param)]
    [backend-components : i64
      (ci.intern-compat-state-composite-triple-id
        (&mut intern-state)
        (lower-spmd-package-backend-role-tag backend)
        lanes
        call-components)]
    [identity-components : i64
      (ci.intern-compat-state-composite-triple-id
        (&mut intern-state)
        source-components
        signature-components
        backend-components)]
    [identity : i64
      (ci.intern-compat-state-generated-role-symbol-id
        (&mut intern-state)
        (ci.intern-generated-symbol-role-spmd-identity)
        identity-components)]
    [stable-hash : i64
      (lower-spmd-package-stable-hash lower-state identity identity-components)]
    [symbol-components : i64
      (ci.intern-compat-state-composite-pair-id
        (&mut intern-state)
        identity-components
        stable-hash)]
    [stable-symbol : i64
      (ci.intern-compat-state-generated-role-symbol-id
        (&mut intern-state)
        (ci.intern-generated-symbol-role-spmd-package-symbol)
        symbol-components)]
    [final-role : i64
      (match backend
        [(Avx512)
          (lower-spmd-result-wrapper-role
            result-ty
            (match result
              [(Varying) true]
              [_ false]))]
        [_ (ci.intern-generated-symbol-role-spmd-package-symbol)])]
    [symbol : i64
      (match backend
        [(Avx512)
          (ci.intern-compat-state-generated-role-symbol-id
            (&mut intern-state)
            final-role
            stable-symbol)]
        [_ stable-symbol])]
    [registration-key : i64
      (ci.intern-compat-state-composite-pair-id
        (&mut intern-state)
        final-role
        stable-hash)]
    [registration-components : i64
      (ci.intern-compat-state-composite-pair-id
        (&mut intern-state)
        registration-key
        identity-components)]
    ;; One structural transport handle carries the typed identity, final
    ;; symbol, collision key, and retained serializer recipe without requiring
    ;; a generated aggregate declaration in the compiler's own source graph.
    (ci.intern-compat-state-composite-triple-id
      (&mut intern-state)
      identity
      symbol
      registration-components)))

(define (lower-spmd-package-structural-identity
  [intern-state : ci.InternCompatState]
  [record : i64]) : i64
  (ci.intern-compat-state-composite-left-id-unchecked intern-state record))

(define (lower-spmd-package-structural-linker-symbol
  [intern-state : (& intern-state ci.InternCompatState)]
  [record : i64]) : i64
  (ci.intern-compat-state-composite-middle-id-unchecked intern-state record))

(define (lower-spmd-package-structural-registration-key
  [intern-state : (& intern-state ci.InternCompatState)]
  [record : i64]) : i64
  (ci.intern-compat-state-composite-left-id-unchecked
    intern-state
    (ci.intern-compat-state-composite-right-id-unchecked intern-state record)))

(define (lower-spmd-package-symbol-register
  [lower-state : CompilerLowerState]
  [symbol : i64]
  [registration-key : i64]
  [identity : i64]) : LowerSpmdPackageSymbolRegistration
  (compiler-lower-state-ensure-spmd-package! lower-state)
  (let
    [package : CompilerLowerSpmdPackageState
      (compiler-lower-state-spmd-package lower-state)]
    (match (lower_i64_i64_map.get
      (& package.symbol-identities)
      registration-key)
      [(LookupFound existing-identity)
        (if (= existing-identity identity)
          Existing
          (begin
            ;; A collision is a diagnostic boundary. Materialize the exact
            ;; linker spelling only on this exceptional path.
            (lower-materialize-generated-role-symbols! lower-state)
            (Collision
              (str_cat.str-cat
                "lower: :spmd-callable stable symbol collision for "
                (ci.intern-compat-state-str
                  (compiler-lower-state-interns lower-state)
                  symbol)))))]
      [(LookupMissing)
        (in-arena
          (arena.Arena package.arena)
          (lower_i64_i64_map.insert-ref!
            (&mut package.symbol-identities)
            registration-key
            identity)
          (compiler-lower-state-write!
            lower-state
            CompilerLowerSpmdPackageState
            spmd-package-state
            package)
          New)])))

(define (lower-spmd-package-lane-width-supported? [lanes : i64]) : bool
  (or (= lanes 8) (= lanes 16) (= lanes 32) (= lanes 64)))

(define (lower-spmd-package-call-args-at
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [classes : (& classes ast.AstSpmdParamClassList)]
  [index : i64]) : ir.CompilerIrSpmdCallArgSeq
  (if (>= index (ast.ast-param-list-len params))
    (ir.compiler-ir-spmd-call-arg-seq-empty)
    (let
      [count : i64 (- (ast.ast-param-list-len params) index)]
      [slots : (__tl_dyn-array ir.CompilerIrSpmdCallArg)
        (__tl_make-array ir.CompilerIrSpmdCallArg count)]
      [cursor : i64 index]
      (while (< cursor (ast.ast-param-list-len params))
        (match (ast.ast-param-list-get params cursor (ast.ast-param-fallback))
          [(Param _ ty _)
            (let
              [resolved : ast.AstType
                (tc_core.tc-type-without-regions
                  (tc_core.tc-resolve-type ctx ty))]
              [class : ir.CompilerIrSpmdValueClass
                (match (ast.ast-spmd-param-class-list-get
                  classes
                  cursor
                  Uniform)
                  [(Uniform) Uniform]
                  [(Varying)
                    (if (lower-type-bool? resolved)
                      Mask
                      Varying)])]
              (set!
                (array-ref slots (- cursor index))
                (ir.CompilerIrSpmdCallArg.Arg class Unit resolved)))])
        (set! cursor (+ cursor 1)))
      (ir.CompilerIrSpmdCallArgSeq slots count))))

(define (lower-spmd-package-index-name
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]) : String
  (if (< index 0)
    ""
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name _ _) (lower-context-intern-str ctx name)])))

(define (lower-spmd-package-index-param-i64?
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]) : bool
  (if (< index 0)
    true
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param _ ty _)
        (lower-type-i64?
          (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty)))])))

(define (lower-spmd-package-abi-type-supported? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(I64) true]
    [(U64) true]
    [(F64) true]
    [(F32) true]
    [(I32) true]
    [(U32) true]
    [(I16) true]
    [(U16) true]
    [(I8) true]
    [(U8) true]
    [(Bool) true]
    [(Unit) true]
    [_ false]))

(define (lower-spmd-package-param-validation-error-at
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [classes : (& classes ast.AstSpmdParamClassList)]
  [lanes : i64]
  [index : i64]) : String
  (if (>= index (ast.ast-param-list-len params))
    ""
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param _ ty _)
        (let
          [resolved : ast.AstType
            (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
          [class : ast.AstSpmdParamClass
            (ast.ast-spmd-param-class-list-get classes index Uniform)]
          (cond
            [(not
                (lower-spmd-package-abi-type-supported?
                  (lower-global-shared-view resolved)))
              "lower: :spmd-callable parameter type is not supported by private ABI v1"]
            [(and
                (match class
                  [(Varying) true]
                  [_ false])
                (not (lower-type-bool? resolved))
                (not
                  (=
                    (lower-simd-lanes-for-elem
                      (CompilerLowerMode.Avx512)
                      resolved)
                    lanes)))
              "lower: :spmd-callable lane width does not match varying parameter type"]
            [else
              (lower-spmd-package-param-validation-error-at
                ctx
                params
                classes
                lanes
                (+ index 1))]))])))

(define (lower-spmd-package-specialization-validation-error
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [function-state : CompilerLowerFunctionState]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [specialization : ast.AstSpmdSpecialization]) : String
  (let
    [classes : ast.AstSpmdParamClassList
      (lower-box-shared-view specialization.args)]
    [index-param : i64 specialization.index-param]
    [call-args : ir.CompilerIrSpmdCallArgSeq
      (lower-spmd-package-call-args-at ctx (& params) (& classes) 0)]
    [index-name : String
      (lower-spmd-package-index-name ctx (& params) index-param)]
    [ret-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret))]
    [param-error : String
      (lower-spmd-package-param-validation-error-at
        ctx
        (& params)
        (& classes)
        specialization.lanes
        0)]
    [env : sym_i64_env.SymI64Env
      (lower-bind-params params 1 (sym_i64_env.sym-i64-empty))]
    [type-env : tc_core.TcTypeEnv
      (tc_core.tc-bind-return-type
        (tc_core.tc-bind-params
          ctx
          (tc_core.tc-hygiene-global-env top-env)
          params)
        (lower-global-shared-view ret-ty))]
    [_recursion-reset : unit
      (compiler-lower-function-state-recursion-detected-set!
        function-state
        false)]
    [body-lanes : i64
      (let
        [mode (CompilerLowerMode.Avx512)]
        [lane-locals-arg
          (let
            [lane-locals (lower-spmd-call-lane-locals params call-args)]
            (lower-masked-vector-lane-locals-from-set
              lane-locals
              specialization.lanes))]
        (lower-masked-vector-expr-lanes-with-locals
          ctx
          function-state
          mode
          env
          type-env
          index-name
          lane-locals-arg
          body))]
    (cond
      [(not (lower-spmd-package-lane-width-supported? specialization.lanes))
        "lower: :spmd-callable lane width is not supported by private ABI v1"]
      [(not (string.eq param-error "")) param-error]
      [(not
          (lower-spmd-package-abi-type-supported?
            (lower-global-shared-view ret-ty)))
        "lower: :spmd-callable return type is not supported by private ABI v1"]
      [(and
          (match specialization.result
            [(Varying) true]
            [_ false])
          (not (lower-type-bool? ret-ty))
          (not
            (=
              (lower-simd-lanes-for-elem
                (CompilerLowerMode.Avx512)
                (lower-global-shared-view ret-ty))
              specialization.lanes)))
        "lower: :spmd-callable lane width does not match varying return type"]
      [(and
          (>= index-param 0)
          (match (ast.ast-spmd-param-class-list-get
            (& classes)
            index-param
            Uniform)
            [(Varying) false]
            [_ true]))
        "lower: :spmd-callable index-param must name a varying argument"]
      [(not (lower-spmd-package-index-param-i64? ctx (& params) index-param))
        "lower: :spmd-callable index-param must name an i64 parameter"]
      [(compiler-lower-function-state-recursion-detected? function-state)
        (lower-spmd-inline-recursive-message)]
      [(< body-lanes 0)
        "lower: :spmd-callable body does not support SPMD specialization"]
      [(tc_core.tc-type-eq ret-ty (Unit))
        (match specialization.result
          [(Unit) ""]
          [_ "lower: :spmd-callable unit return requires result unit"])]
      [(match specialization.result
          [(Unit) true]
          [_ false])
        "lower: :spmd-callable non-unit return cannot use result unit"]
      [(and
          (> body-lanes 0)
          (match specialization.result
            [(Varying) false]
            [_ true]))
        "lower: :spmd-callable varying body requires result varying"]
      [(and
          (= body-lanes 0)
          (match specialization.result
            [(Uniform) false]
            [_ true]))
        "lower: :spmd-callable uniform body requires result uniform"]
      [else ""])))

;; Private SIMD helpers keep source types on their parameters, so preserve
;; the SPMD value class in the otherwise-internal parameter name.  The backend
;; and register planner use these prefixes to select the private vector/mask
;; ABI without exposing a vector type in the source type system.
(define (lower-spmd-private-param-name
  [lower-state : CompilerLowerState]
  [name : i64]
  [class : ir.CompilerIrSpmdValueClass]
  [mode : CompilerLowerMode]) : String
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    [handle : i64 (lower-spmd-private-param-symbol lower-state name class mode)]
    [cached : String (ci.intern-compat-state-str intern-state handle)]
    (if (> (string.string-length cached) 0)
      cached
      (ci.intern-compat-state-generated-role-symbol-materialize!
        (&mut intern-state)
        (ci.intern-generated-symbol-role-spmd-private-parameter)
        handle
        (match class
          [(Uniform) (tc_core.tc-env-key-name-text name)]
          [(Varying)
            (if (lower-mode-avx2? mode)
              (str_cat.str-cat
                "__tl_spmd_varying_arg_avx2_"
                (tc_core.tc-env-key-name-text name))
              (str_cat.str-cat
                "__tl_spmd_varying_arg_"
                (tc_core.tc-env-key-name-text name)))]
          [(Mask)
            (if (lower-mode-avx2? mode)
              (str_cat.str-cat
                "__tl_spmd_mask_arg_avx2_"
                (tc_core.tc-env-key-name-text name))
              (str_cat.str-cat
                "__tl_spmd_mask_arg_"
                (tc_core.tc-env-key-name-text name)))])))))

(define (lower-spmd-private-param-symbol
  [lower-state : CompilerLowerState]
  [name : i64]
  [class : ir.CompilerIrSpmdValueClass]
  [mode : CompilerLowerMode]) : i64
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    [components : i64
      (ci.intern-compat-state-composite-triple-id
        (&mut intern-state)
        name
        (lower-spmd-private-param-class-role-tag class)
        (lower-spmd-private-param-mode-role-tag mode))]
    (ci.intern-compat-state-generated-role-symbol-id
      (&mut intern-state)
      (ci.intern-generated-symbol-role-spmd-private-parameter)
      components)))

(define (lower-spmd-call-arg-at
  [args : (& args ir.CompilerIrSpmdCallArgSeq)]
  [index : i64]) : ir.CompilerIrSpmdCallArg
  (if (and (>= index 0) (< index args.len))
    (array-ref args.slots index)
    (Arg (Uniform) Unit (Unit))))

(define (lower-spmd-private-param-list
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [params : ast.AstParamList]
  [args : (& args ir.CompilerIrSpmdCallArgSeq)]
  [mode : CompilerLowerMode]
  [idx : i64]) : ir.CompilerIrParamSeq
  (let
    [builder : ir.CompilerIrParamBuilder
      (ir.compiler-ir-param-builder-with-capacity
        (ast.ast-param-list-len (& params)))]
    (lower-spmd-private-param-list-into!
      lower-state
      ctx
      (& params)
      args
      mode
      0
      idx
      (&mut builder))
    (ir.compiler-ir-param-builder-to-seq builder)))

(define (lower-spmd-private-param-list-into!
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [args : (& args ir.CompilerIrSpmdCallArgSeq)]
  [mode : CompilerLowerMode]
  [index : i64]
  [idx : i64]
  [builder : (&mut builder ir.CompilerIrParamBuilder)]) : unit
  (if (>= index (ast.ast-param-list-len params))
    unit
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name ty _)
        (match (lower-spmd-call-arg-at args index)
          [(Arg class _ _)
            (ir.compiler-ir-param-builder-push!
              builder
              (ir.CompilerIrParam.Param
                (lower-spmd-private-param-name lower-state name class mode)
                (let
                  [ty-arg
                    (tc_core.tc-type-without-regions
                      (tc_core.tc-type-strip-invalidate
                        (tc_core.tc-resolve-type ctx ty)))]
                  (lower-one-word-register-storage-type ctx ty-arg))
                idx))
            (lower-spmd-private-param-list-into!
              lower-state
              ctx
              params
              args
              mode
              (+ index 1)
              (+ idx 1)
              builder)])])))

(define (lower-spmd-private-helper-name
  [names : LowerNameCache]
  [hidden-name : i64]
  [result-ty : ast.AstType]
  [result-varying : bool]) : i64
  (lower-spmd-private-helper-symbol
    (compiler-lower-state-from-name-cache names)
    hidden-name
    result-ty
    result-varying))

(define (lower-spmd-private-helper-symbol
  [lower-state : CompilerLowerState]
  [hidden-name : i64]
  [result-ty : ast.AstType]
  [result-varying : bool]) : i64
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    [private-base : i64
      (ci.intern-compat-state-generated-role-symbol-id
        (&mut intern-state)
        (ci.intern-generated-symbol-role-spmd-private-helper)
        hidden-name)]
    (ci.intern-compat-state-generated-role-symbol-id
      (&mut intern-state)
      (lower-spmd-result-wrapper-role result-ty result-varying)
      private-base)))

(define (lower-spmd-helper-index-param-at
  [ctx : tc_core.TcContext]
  [index-name : (& index-name str)]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]
  [arg-index : i64]) : String
  (if (or
    (= (string.string-length index-name) 0)
    (>= arg-index (ast.ast-param-list-len params))
    (>= arg-index args.len))
    ""
    (let
      [arg : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get args arg-index 0))]
      (if (= (lower-masked-vector-index-offset ctx index-name arg) 0)
        (match (ast.ast-param-list-get
          params
          arg-index
          (ast.ast-param-fallback))
          [(Param param-name _ _) (tc_core.tc-env-key-name-text param-name)])
        (lower-spmd-helper-index-param-at
          ctx
          index-name
          params
          args
          (+ arg-index 1))))))

(define (lower-spmd-helper-index-param
  [ctx : tc_core.TcContext]
  [index-name : (& index-name str)]
  [params : (& params ast.AstParamList)]
  [args : (& args ast.AstExprList)]) : String
  (lower-spmd-helper-index-param-at ctx index-name (& params) (& args) 0))

(define (lower-spmd-call-args-append
  [args : ir.CompilerIrSpmdCallArgSeq]
  [extra : ir.CompilerIrSpmdCallArg]) : ir.CompilerIrSpmdCallArgSeq
  (ir.compiler-ir-spmd-call-arg-seq-append args extra))

;; The private SPMD ABI descriptor of a generated helper (#7405), built from
;; the helper's physical signature and the call argument classification it was
;; specialized for. `physical-params` is the signature exactly as emitted: the
;; active mask, one parameter per declared source parameter in order, then the
;; hidden index base when `index` is `Appended`. `call-args` supplies each
;; source parameter's class and source type. The helper and every call to it
;; carry this one record.
(define (lower-spmd-private-abi
  [callee : i64]
  [backend : ir.CompilerIrSpmdBackend]
  [lanes : i64]
  [physical-params : ir.CompilerIrParamSeq]
  [call-args : (& call-args ir.CompilerIrSpmdCallArgSeq)]
  [index : ir.CompilerIrSpmdPrivateIndex]
  [ret-ty : ast.AstType]
  [result-varying : bool]) : ir.CompilerIrSpmdPrivateAbi
  (let
    [params : ir.CompilerIrSpmdPrivateParamSeq
      (ir.compiler-ir-spmd-private-param-seq-with-capacity physical-params.len)]
    [appended : bool
      (match index
        [(Appended _) true]
        [_ false])]
    [ordinal : i64 0]
    (while (< ordinal physical-params.len)
      (match (ir.compiler-ir-param-seq-ref physical-params ordinal)
        [(Param _ ty _)
          (ir.compiler-ir-spmd-private-param-seq-push!
            (&mut params)
            (ir.CompilerIrSpmdPrivateParam.Param
              ordinal
              (cond
                [(= ordinal 0) (ActiveMask)]
                [(and appended (= ordinal (- physical-params.len 1)))
                  (IndexBase)]
                [else
                  (match (lower-spmd-call-arg-at call-args (- ordinal 1))
                    [(Arg class _ source-ty)
                      (Source (- ordinal 1) class source-ty)])])
              ty))])
      (set! ordinal (+ ordinal 1)))
    (ir.CompilerIrSpmdPrivateAbi
      (V1)
      callee
      backend
      lanes
      params
      index
      (if (tc_core.tc-type-eq (lower-global-shared-view ret-ty) (Unit))
        (Unit)
        (Value
          (lower-spmd-ir-value-class
            (lower-global-shared-view ret-ty)
            result-varying)
          ret-ty)))))

;; The ABI of the generated helper named `helper` among the functions its
;; lowering produced. The helper itself is pushed last, after any functions its
;; body lifted, so the search starts there.
(define (lower-spmd-generated-helper-abi
  [functions : ir.CompilerIrFunctionSeq]
  [helper : i64]) : ir.CompilerIrFunctionAbi
  (let
    [index : i64 (- functions.len 1)]
    [found : ir.CompilerIrFunctionAbi Ordinary]
    (while (>= index 0)
      (match (ir.compiler-ir-function-seq-ref functions index)
        [(Function name _ _ _ _ function-abi)
          (if (ir.compiler-ir-symbol-eq? name helper)
            (begin
              (set! found (clone function-abi))
              (set! index -1))
            (set! index (- index 1)))]))
    found))

(define (lower-spmd-private-param-list-append-index
  [params : ir.CompilerIrParamSeq]
  [var-id : i64]) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-append-one
    params
    (Param "__tl_spmd_index_base" (I64) var-id)))

(define (lower-spmd-simd-helper-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [hidden-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [result-varying : bool]
  [body : ast.AstExpr]
  [backend : ir.CompilerIrSpmdBackend]
  [call-args : (& call-args ir.CompilerIrSpmdCallArgSeq)]
  [lanes : i64]
  [helper-index : String]
  [helper-index-source-param : i64]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [source-param-count : i64 (+ 1 (lower-param-count params))]
    [param-count : i64
      (if (or
        (= (string.string-length helper-index) 0)
        (>= helper-index-source-param 0))
        source-param-count
        (+ source-param-count 1))]
    [ret-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret))]
    [function-spans : ir.CompilerSourceSpans
      (lower-record-function-span
        (compiler-lower-state-from-name-cache names)
        (& (tc_core.tc-context-pools ctx))
        spans
        (ir.compiler-ir-symbol-typed-id hidden-name)
        (lower-global-shared-view body))]
    [state : LowerState
      (lower-state-new
        param-count
        0
        0
        (ir.compiler-ir-label "entry")
        (ir.compiler-ir-instr-builder-new)
        (ir.compiler-ir-block-builder-new)
        (ir.compiler-ir-function-builder-new)
        hidden-name
        (box function-spans)
        (lower-global-shared-view names)
        type-cache
        function-state
        mode
        (lower_i64_i64_map.with-capacity 8)
        1
        param-count)]
    [env : sym_i64_env.SymI64Env
      (lower-bind-params params 1 (sym_i64_env.sym-i64-empty))]
    [type-env : tc_core.TcTypeEnv
      (tc_core.tc-bind-return-type
        (tc_core.tc-bind-params
          ctx
          (tc_core.tc-hygiene-global-env top-env)
          params)
        (lower-global-shared-view ret-ty))]
    [lowered
      (try
        (lower-avx512-masked-expr-expected
          ctx
          state
          env
          type-env
          (lower-spmd-call-lane-locals params call-args)
          (lower-global-shared-view helper-index)
          (if (= (string.string-length helper-index) 0)
            (- 0 1)
            (if (>= helper-index-source-param 0)
              (+ helper-index-source-param 1)
              source-param-count))
          (Some (Var 0))
          lanes
          body
          ret-ty))]
    (match (lower-global-shared-view lowered)
      [(Expr body-state value _)
        (let
          [return-expr
            : LowerExpr
            ;; Masked lowering represents a uniform result as identical
            ;; lanes; the private uniform ABI returns one scalar value.
            (cond
              [(or
                  result-varying
                  (tc_core.tc-type-eq (lower-global-shared-view ret-ty) (Unit)))
                lowered]
              [(lower-type-bool? ret-ty)
                (lower-emit-mask-reduce body-state (Any) value lanes)]
              [else
                (lower-emit-vector-reduce
                  body-state
                  (Min)
                  value
                  lanes
                  (lower-global-shared-view ret-ty))])]
          [return-state : LowerState
            (match (lower-global-shared-view return-expr)
              [(Expr next-state _ _) next-state])]
          [return-value : ir.CompilerIrValue
            (match return-expr
              [(Expr _ next-value _) next-value])]
          [final-state : LowerState
            (lower-state-emit
              return-state
              (Return
                (if (tc_core.tc-type-eq
                  (lower-global-shared-view ret-ty)
                  (Unit))
                  (No)
                  (Some return-value))))]
          [physical-params : ir.CompilerIrParamSeq
            (ir.compiler-ir-param-seq-prepend
              (Param
                (if (lower-mode-avx2? mode)
                  "__tl_spmd_active_mask_avx2"
                  "__tl_spmd_active_mask")
                (Bool)
                0)
              (let
                [source-params : ir.CompilerIrParamSeq
                  (lower-spmd-private-param-list
                    (compiler-lower-state-from-name-cache names)
                    ctx
                    params
                    call-args
                    mode
                    1)]
                (if (or
                  (= (string.string-length helper-index) 0)
                  (>= helper-index-source-param 0))
                  source-params
                  (lower-spmd-private-param-list-append-index
                    source-params
                    source-param-count))))]
          [index-mapping : ir.CompilerIrSpmdPrivateIndex
            (cond
              [(= (string.string-length helper-index) 0) (None)]
              [(>= helper-index-source-param 0)
                (ReuseSource helper-index-source-param)]
              [else (Appended source-param-count)])]
          [abi : ir.CompilerIrSpmdPrivateAbi
            (lower-spmd-private-abi
              hidden-name
              backend
              lanes
              (lower-global-shared-view physical-params)
              call-args
              index-mapping
              (lower-global-shared-view ret-ty)
              result-varying)]
          (Ok
            (lower-state-build-functions-with
              final-state
              (Function
                hidden-name
                physical-params
                ret-ty
                (lower-state-next-var final-state)
                (lower-state-build-function-blocks final-state)
                (ir.compiler-ir-function-abi-private abi)))
            (lower-state-spans final-state)))])))

(define (lower-spmd-scalar-helper-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [hidden-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [result-varying : bool]
  [body : ast.AstExpr]
  [call-args : (& call-args ir.CompilerIrSpmdCallArgSeq)]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [param-count : i64 (+ 1 (lower-param-count params))]
    [ret-ty : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret))]
    [function-spans : ir.CompilerSourceSpans
      (lower-record-function-span
        (compiler-lower-state-from-name-cache names)
        (& (tc_core.tc-context-pools ctx))
        spans
        (ir.compiler-ir-symbol-typed-id hidden-name)
        (lower-global-shared-view body))]
    [state : LowerState
      (lower-state-new
        param-count
        0
        0
        (ir.compiler-ir-label "entry")
        (ir.compiler-ir-instr-builder-new)
        (ir.compiler-ir-block-builder-new)
        (ir.compiler-ir-function-builder-new)
        hidden-name
        (box function-spans)
        names
        type-cache
        function-state
        mode
        (lower_i64_i64_map.with-capacity 8)
        1
        param-count)]
    [env : sym_i64_env.SymI64Env
      (lower-bind-params params 1 (sym_i64_env.sym-i64-empty))]
    [type-env : tc_core.TcTypeEnv
      (tc_core.tc-bind-return-type
        (tc_core.tc-bind-params
          ctx
          (tc_core.tc-hygiene-global-env top-env)
          params)
        (lower-global-shared-view ret-ty))]
    [final-state
      (try
        (lower-tail-expr
          ctx
          state
          env
          type-env
          body
          (lower-global-shared-view ret-ty)
          (- 0 1)))]
    [physical-params : ir.CompilerIrParamSeq
      (ir.compiler-ir-param-seq-prepend
        (Param "__tl_spmd_active_mask" (Bool) 0)
        (lower-param-list ctx params 1))]
    [abi : ir.CompilerIrSpmdPrivateAbi
      (lower-spmd-private-abi
        hidden-name
        (Scalar)
        1
        (lower-global-shared-view physical-params)
        call-args
        (None)
        (lower-global-shared-view ret-ty)
        result-varying)]
    (Ok
      (lower-state-build-functions-with
        final-state
        (Function
          hidden-name
          physical-params
          ret-ty
          (lower-state-next-var final-state)
          (lower-state-build-function-blocks final-state)
          (ir.compiler-ir-function-abi-private abi)))
      (lower-state-spans final-state))))

(define (lower-spmd-specialized-helper-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [hidden-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [result-varying : bool]
  [body : ast.AstExpr]
  [backend : ir.CompilerIrSpmdBackend]
  [call-args : (& call-args ir.CompilerIrSpmdCallArgSeq)]
  [lanes : i64]
  [helper-index : String]
  [helper-index-source-param : i64]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match backend
    [(Scalar)
      (lower-spmd-scalar-helper-function
        ctx
        top-env
        type-cache
        function-state
        hidden-name
        params
        ret
        result-varying
        body
        call-args
        spans
        names
        mode)]
    [(Avx512)
      (lower-spmd-simd-helper-function
        ctx
        top-env
        type-cache
        function-state
        hidden-name
        params
        ret
        result-varying
        body
        (Avx512)
        call-args
        lanes
        helper-index
        helper-index-source-param
        spans
        names
        mode)]
    [(Avx2)
      (lower-spmd-simd-helper-function
        ctx
        top-env
        type-cache
        function-state
        hidden-name
        params
        ret
        result-varying
        body
        (Avx2)
        call-args
        lanes
        helper-index
        helper-index-source-param
        spans
        names
        mode)]))

(define (lower-spmd-package-specialization-function-active
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [canonical-name : String]
  [canonical-handle : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [specialization : ast.AstSpmdSpecialization]
  [backend : ir.CompilerIrSpmdBackend]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [lower-state : CompilerLowerState
      (compiler-lower-state-from-name-cache names)]
    [package-name : String (compiler-lower-state-spmd-package-name lower-state)]
    [validation-error : String
      (lower-spmd-package-specialization-validation-error
        ctx
        top-env
        function-state
        (lower-global-shared-view params)
        (lower-global-shared-view ret)
        (lower-global-shared-view body)
        (lower-global-shared-view specialization))]
    (if (not (string.eq validation-error ""))
      (Err (box (lower-diagnostic validation-error)))
      (let
        [classes : ast.AstSpmdParamClassList
          (lower-box-shared-view specialization.args)]
        [signature : String
          (lower-spmd-source-signature
            (lower-global-shared-view params)
            (lower-global-shared-view ret))]
        [resolved-ret : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-resolve-type ctx (lower-global-shared-view ret)))]
        [lanes : i64
          (match backend
            [(Scalar) 1]
            [_ specialization.lanes])]
        [index-param : i64 specialization.index-param]
        [structural-symbol : i64
          (lower-spmd-package-structural-symbol
            lower-state
            package-name
            canonical-name
            canonical-handle
            signature
            resolved-ret
            backend
            lanes
            classes
            specialization.result
            index-param)]
        [intern-state : ci.InternCompatState
          (compiler-lower-state-interns lower-state)]
        [hidden-name : i64
          (lower-spmd-package-structural-linker-symbol
            intern-state
            structural-symbol)]
        [registration : LowerSpmdPackageSymbolRegistration
          (lower-spmd-package-symbol-register
            lower-state
            hidden-name
            (lower-spmd-package-structural-registration-key
              intern-state
              structural-symbol)
            (lower-spmd-package-structural-identity
              intern-state
              structural-symbol))]
        [call-args : ir.CompilerIrSpmdCallArgSeq
          (lower-spmd-package-call-args-at ctx (& params) (& classes) 0)]
        [index-name : String
          (lower-spmd-package-index-name ctx (& params) index-param)]
        (match registration
          [(Existing) (Ok (ir.compiler-ir-function-seq-empty) spans)]
          [(Collision collision-error)
            (Err (box (lower-diagnostic collision-error)))]
          [(New)
            (lower-spmd-specialized-helper-function
              ctx
              top-env
              type-cache
              function-state
              hidden-name
              params
              ret
              (match specialization.result
                [(Varying) true]
                [_ false])
              body
              backend
              call-args
              lanes
              index-name
              index-param
              spans
              names
              mode)])))))

(define (lower-spmd-package-specialization-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [canonical-handle : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [specialization : ast.AstSpmdSpecialization]
  [backend : ir.CompilerIrSpmdBackend]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [function-state : CompilerLowerFunctionState
      (compiler-lower-function-state-new-with-stack
        (compiler-lower-state-from-name-cache names)
        (lower-id-set-insert
          (lower-spmd-inline-empty-helper-stack)
          canonical-handle))]
    (lower-spmd-package-specialization-function-active
      ctx
      top-env
      type-cache
      function-state
      canonical-name
      canonical-handle
      params
      ret
      body
      specialization
      backend
      spans
      names
      mode)))

(define (lower-spmd-package-specializations-from
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [canonical-handle : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [specializations : (& specializations ast.AstSpmdSpecializationList)]
  [index : i64]
  [limit : i64]
  [backend : ir.CompilerIrSpmdBackend]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]
  [functions : ir.CompilerIrFunctionBuilder]) : ResultLowerFunction
  (if (or
    (>= index limit)
    (>= index (ast.ast-spmd-specialization-list-len specializations)))
    (Ok (ir.compiler-ir-function-builder-to-seq functions) spans)
    (let
      [fallback : ast.AstSpmdSpecialization
        (ast.AstSpmdSpecialization
          2
          (box (ast.ast-spmd-param-class-list-new))
          Unit
          -1)]
      (match (lower-spmd-package-specialization-function
        ctx
        top-env
        (lower-global-shared-view type-cache)
        (lower-global-shared-view canonical-name)
        canonical-handle
        (lower-global-shared-view params)
        (lower-global-shared-view ret)
        (lower-global-shared-view body)
        (ast.ast-spmd-specialization-list-get specializations index fallback)
        backend
        spans
        (lower-global-shared-view names)
        mode)
        [(Err message) (Err message)]
        [(Ok lowered next-spans)
          (let
            [next-functions : ir.CompilerIrFunctionBuilder functions]
            (ir.compiler-ir-function-builder-append-seq!
              (&mut next-functions)
              lowered)
            (lower-spmd-package-specializations-from
              ctx
              top-env
              type-cache
              canonical-name
              canonical-handle
              params
              ret
              body
              specializations
              (+ index 1)
              limit
              backend
              next-spans
              names
              mode
              next-functions))]))))

(define (lower-spmd-package-callable-functions
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [canonical-name : String]
  [canonical-handle : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [callable : ast.AstSpmdCallable]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [package-name : String
      (compiler-lower-state-spmd-package-name
        (compiler-lower-state-from-name-cache names))]
    (match callable
      [(No) (Ok (ir.compiler-ir-function-seq-empty) spans)]
      [(Callable specializations)
        (if (= (string.string-length package-name) 0)
          (Err
            (box
              (lower-diagnostic
                "lower: :spmd-callable is only supported while building a package")))
          (if (lower-mode-avx2? mode)
            (Err
              (box
                (lower-diagnostic
                  "lower: :spmd-callable is not supported in AVX2 backend mode; use scalar or avx512")))
            (let
              [backend : ir.CompilerIrSpmdBackend
                (if (lower-mode-avx512? mode)
                  Avx512
                  Scalar)]
              [count : i64
                (ast.ast-spmd-specialization-list-len (& specializations))]
              (match (lower-spmd-package-specializations-from
                ctx
                top-env
                type-cache
                canonical-name
                canonical-handle
                params
                ret
                body
                (& specializations)
                0
                count
                backend
                spans
                names
                mode
                (ir.compiler-ir-function-builder-with-capacity count))
                [(Err message) (Err message)]
                [(Ok functions next-spans)
                  ;; Generated package functions bypass lower-function-escaping.
                  ;; Their parameters, blocks and instructions need the same
                  ;; retained IR owner before checked frontend retirement.
                  (Ok
                    (lower-function-seq-escape-to-ir-arena functions)
                    next-spans)]))))])))

(define (lower-avx512-emit-spmd-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [hidden-name : i64]
  [backend : ir.CompilerIrSpmdBackend]
  [active-mask : ir.CompilerIrValue]
  [lanes : i64]
  [call-args : ir.CompilerIrSpmdCallArgSeq]
  [result-ty : ast.AstType]
  [result-varying : bool]
  [expr : ast.AstExpr]
  [origin : ir.CompilerIrSpmdCallOrigin]) : ResultLowerExpr
  (if (tc_core.tc-type-eq (lower-global-shared-view result-ty) (Unit))
    (let
      [instr : ir.CompilerIrInstr
        (ir.ir-instr-spmd-call-with-origin
          hidden-name
          backend
          lanes
          active-mask
          call-args
          (Unit)
          (clone origin))]
      (Ok (Expr (lower-state-emit-at-expr ctx state instr expr) Unit result-ty)))
    (match (lower-state-alloc-var state)
      [(Alloc allocated result-var)
        (let
          [result-class : ir.CompilerIrSpmdValueClass
            (lower-spmd-ir-value-class
              (lower-global-shared-view result-ty)
              result-varying)]
          [instr : ir.CompilerIrInstr
            (ir.ir-instr-spmd-call-with-origin
              hidden-name
              backend
              lanes
              active-mask
              call-args
              (Value
                result-var
                result-class
                (lower-global-shared-view result-ty))
              (clone origin))]
          [call-state : LowerState
            (lower-state-emit-at-expr ctx allocated instr expr)]
          (if (or
            result-varying
            (match backend
              [(Scalar) true]
              [_ false]))
            (Ok (Expr call-state (Var result-var) result-ty))
            (Ok (lower-emit-splat call-state (Var result-var) lanes result-ty))))])))

(define (lower-avx512-emit-spmd-call-active
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [hidden-name : i64]
  [backend : ir.CompilerIrSpmdBackend]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [call-args : ir.CompilerIrSpmdCallArgSeq]
  [result-ty : ast.AstType]
  [result-varying : bool]
  [expr : ast.AstExpr]
  [origin : ir.CompilerIrSpmdCallOrigin]) : ResultLowerExpr
  (match (lower-masked-active-mask-value state active-mask lanes)
    [(Expr mask-state mask _)
      (lower-avx512-emit-spmd-call
        ctx
        mask-state
        hidden-name
        backend
        mask
        lanes
        call-args
        result-ty
        result-varying
        expr
        origin)]))

(define (lower-avx512-uniform-spmd-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [result-ty : ast.AstType]
  [lanes : i64]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (let
    [lowered : LowerExpr
      (try (lower-call ctx state env type-env func args result-ty expr))]
    (match (lower-global-shared-view lowered)
      [(Expr call-state call-value call-ty)
        (if (or
          (tc_core.tc-type-eq (lower-global-shared-view call-ty) (Unit))
          (lower-type-bool? call-ty))
          (Ok lowered)
          (Ok (lower-emit-splat call-state call-value lanes call-ty)))])))

(define (lower-imported-spmd-avx512-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [owner : String]
  [version : String]
  [canonical-name : ci.InternId]
  [fn-ty : ast.AstType]
  [callables : ast.AstImportedSpmdCallableList]) : ResultLowerExpr
  (match fn-ty
    [(Func param-types ret-id)
      (match (lower-expr-result-type-or-check
        ctx
        env
        type-env
        (lower-state-type-cache state)
        (lower-state-function-state state)
        expr)
        [(Err message) (Err (box (lower-diagnostic-at-expr ctx expr message)))]
        [(Ok result-ty)
          (let
            [params : ast.AstParamList
              (lower-imported-spmd-params ctx (deref param-types))]
            [ret : ast.AstType (tc_core.tc-context-type-get ctx ret-id)]
            [arg-lanes : i64
              (lower-spmd-call-args-lanes
                ctx
                (lower-state-function-state state)
                (lower-state-mode state)
                env
                type-env
                (lower-global-shared-view index)
                (lower-masked-vector-lane-locals-from-set lane-locals lanes)
                args)]
            (if (= arg-lanes 0)
              (lower-avx512-uniform-spmd-call
                ctx
                state
                env
                type-env
                func
                args
                result-ty
                lanes
                expr)
              (match (lower-avx512-spmd-call-args
                ctx
                state
                env
                type-env
                lane-locals
                (lower-global-shared-view index)
                index-var
                (lower-global-shared-view active-mask)
                lanes
                params
                args)
                [(Err message) (Err message)]
                [(Ok args-state call-args any-varying)
                  (if (not any-varying)
                    (Err
                      (box
                        (lower-diagnostic-at-expr
                          ctx
                          expr
                          "lower: inconsistent imported SPMD helper argument classification")))
                    (let
                      [args-code : String
                        (lower-imported-spmd-call-args-code
                          (lower-global-shared-view call-args))]
                      [signature : String
                        (lower-spmd-source-signature
                          params
                          (lower-global-shared-view ret))]
                      [requested-index-param : i64
                        (lower-imported-spmd-index-param ctx index args)]
                      [imported-interns : ci.InternCompatState
                        (compiler-lower-state-interns
                          (lower-state-owner (lower-state-clone args-state)))]
                      [specialization
                        (try
                          (lower-imported-spmd-select
                            (& imported-interns)
                            (tc_core.tc-context-pools ctx)
                            canonical-name
                            (& callables)
                            (string.copy signature)
                            (Avx512)
                            lanes
                            args-code
                            requested-index-param
                            ret
                            expr))]
                      (lower-avx512-emit-spmd-call-active
                        ctx
                        args-state
                        (lower-imported-spmd-ir-symbol
                          (&mut imported-interns)
                          specialization)
                        (Avx512)
                        active-mask
                        lanes
                        call-args
                        result-ty
                        (lower-imported-spmd-result-varying?
                          (& imported-interns)
                          specialization)
                        expr
                        (lower-imported-spmd-call-origin
                          (& imported-interns)
                          owner
                          version
                          canonical-name
                          signature
                          specialization))))])))])]
    [_
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            expr
            "lower: imported SPMD helper does not have function type")))]))

(define (lower-avx512-spmd-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [func : ast.AstExpr]
  [args : ast.AstExprList]) : ResultLowerExpr
  (let
    [helper
      (try
        (lower-spmd-inline-helper-lookup
          ctx
          (lower-state-function-state state)
          env
          type-env
          (lower-global-shared-view lane-locals)
          (lower-global-shared-view func)))]
    (match helper
      [(Some name params ret body)
        (match (lower-expr-result-type-or-check
          ctx
          env
          type-env
          (lower-state-type-cache state)
          (lower-state-function-state state)
          expr)
          [(Ok result-ty)
            (let
              [arg-lanes : i64
                (lower-spmd-call-args-lanes
                  ctx
                  (lower-state-function-state state)
                  (lower-state-mode state)
                  env
                  type-env
                  (lower-global-shared-view index)
                  (lower-masked-vector-lane-locals-from-set lane-locals lanes)
                  args)]
              (if (= arg-lanes 0)
                (lower-avx512-uniform-spmd-call
                  ctx
                  state
                  env
                  type-env
                  func
                  args
                  result-ty
                  lanes
                  expr)
                (match (lower-avx512-spmd-call-args
                  ctx
                  state
                  env
                  type-env
                  (lower-global-shared-view lane-locals)
                  (lower-global-shared-view index)
                  index-var
                  (lower-global-shared-view active-mask)
                  lanes
                  params
                  args)
                  [(Ok args-state call-args any-varying)
                    (if (not any-varying)
                      (Err
                        (box
                          (lower-diagnostic-at-expr
                            ctx
                            expr
                            "lower: inconsistent SPMD helper argument classification")))
                      (match (lower-state-fresh-lambda-name args-state)
                        [(Name named-state hidden-name)
                          (let
                            [helper-index : String
                              (lower-spmd-helper-index-param
                                ctx
                                index
                                params
                                args)]
                            [abi-call-args : ir.CompilerIrSpmdCallArgSeq
                              (if (= (string.string-length helper-index) 0)
                                call-args
                                (lower-spmd-call-args-append
                                  call-args
                                  (Arg (Uniform) (Var index-var) (I64))))]
                            [result-varying : bool
                              (>
                                (lower-spmd-direct-call-result-lanes
                                  ctx
                                  (lower-state-function-state named-state)
                                  (lower-state-mode named-state)
                                  env
                                  type-env
                                  index
                                  (lower-masked-vector-lane-locals-from-set
                                    lane-locals
                                    lanes)
                                  func
                                  args)
                                0)]
                            [backend : ir.CompilerIrSpmdBackend
                              (if (lower-mode-avx2?
                                (lower-state-mode named-state))
                                Avx2
                                Avx512)]
                            [private-name : i64
                              (lower-spmd-private-helper-name
                                (lower-state-names named-state)
                                hidden-name
                                (lower-global-shared-view result-ty)
                                result-varying)]
                            [helper-function-state : CompilerLowerFunctionState
                              (compiler-lower-function-state-new-with-stack
                                (lower-state-owner named-state)
                                (compiler-lower-function-state-inline-helper-stack
                                  (lower-state-function-state named-state)))]
                            (match (lower-spmd-specialized-helper-function
                              ctx
                              type-env
                              (lower-state-type-cache named-state)
                              helper-function-state
                              private-name
                              params
                              ret
                              result-varying
                              body
                              backend
                              abi-call-args
                              lanes
                              helper-index
                              -1
                              (lower-state-spans named-state)
                              (lower-state-names named-state)
                              (lower-state-mode named-state))
                              [(Ok functions helper-spans)
                                (match (lower-spmd-generated-helper-abi
                                  (lower-global-shared-view functions)
                                  private-name)
                                  [(SpmdPrivate helper-abi)
                                    (lower-avx512-emit-spmd-call-active
                                      ctx
                                      (lower-state-add-functions
                                        named-state
                                        functions
                                        helper-spans)
                                      private-name
                                      backend
                                      active-mask
                                      lanes
                                      abi-call-args
                                      result-ty
                                      result-varying
                                      expr
                                      (Private helper-abi))]
                                  [(Ordinary)
                                    (Err
                                      (box
                                        (lower-diagnostic-at-expr
                                          ctx
                                          expr
                                          "lower: generated SPMD helper has no private ABI descriptor")))])]
                              [(Err message) (Err message)]))]))]
                  [(Err message) (Err message)])))]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx expr message)))])]
      [(Imported owner version canonical-name fn-ty callables)
        (if (lower-mode-avx2? (lower-state-mode state))
          (Err
            (box
              (lower-diagnostic-at-expr
                ctx
                expr
                (str_cat.str-cat
                  "lower: imported SPMD helper `"
                  (compiler-lower-state-intern-id-str
                    (lower-state-owner state)
                    canonical-name)
                  "` is not supported in AVX2 backend mode"))))
          (lower-imported-spmd-avx512-call
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            expr
            func
            args
            owner
            version
            canonical-name
            fn-ty
            (deref callables)))]
      [(No)
        (lower-avx512-masked-unsupported
          ctx
          expr
          "non-direct SPMD helper calls")])))

;; Masked SPMD lowering has no vector conversion, so a cast may reach its
;; operand only when lanes need no conversion: a cast between identical numeric
;; lanes, or a casted numeric literal, a constant that keeps its existing
;; lowering (#7306 leaves literals unchanged). An integer literal cast to a
;; float lane is not converted here and fails closed in the backend (#8568).
;; Every other cast is rejected at `origin` here, whatever a caller's census
;; admitted: lowering its operand would load lanes in the source domain and
;; store the same bits in the destination domain (#7306).
(define (lower-avx512-masked-cast
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [origin : ast.AstExpr]
  [inner : ast.AstExpr]
  [cast-ty-id : i64]) : ResultLowerExpr
  (if (or
    (tc_core.tc-integer-literal-expr? ctx (lower-global-shared-view inner))
    (tc_core.tc-float-literal-expr? ctx (lower-global-shared-view inner)))
    (lower-avx512-masked-expr
      ctx
      state
      env
      type-env
      lane-locals
      index
      index-var
      active-mask
      lanes
      inner)
    (match (lower-masked-spmd-numeric-expr-type
      ctx
      env
      type-env
      (lower-global-shared-view inner))
      [(Ok source-ty)
        (let
          [source : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type ctx source-ty))]
          [destination : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type
                ctx
                (tc_core.tc-context-type-get ctx cast-ty-id)))]
          [source-lane : spmd_numeric.CompilerSpmdNumericLane
            (spmd_numeric.compiler-spmd-numeric-lane
              (lower-global-shared-view source))]
          [destination-lane : spmd_numeric.CompilerSpmdNumericLane
            (spmd_numeric.compiler-spmd-numeric-lane
              (lower-global-shared-view destination))]
          (cond
            [(not
                (and
                  (spmd_numeric.compiler-spmd-numeric-lane? source-lane)
                  (spmd_numeric.compiler-spmd-numeric-lane? destination-lane)))
              (lower-avx512-masked-unsupported ctx origin "this cast")]
            [(spmd_numeric.compiler-spmd-numeric-lane-eq?
                source-lane
                destination-lane)
              (lower-avx512-masked-expr
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                inner)]
            [else
              (Err
                (box
                  (lower-diagnostic-at-expr
                    ctx
                    origin
                    (lower-spmd-numeric-failure-message
                      (spmd_numeric.compiler-spmd-numeric-conversion-decision
                        source
                        destination
                        (lower-masked-spmd-numeric-context state)
                        (lower-spmd-numeric-backend (lower-state-mode state)))))))]))]
      [(Err _) (lower-avx512-masked-unsupported ctx origin "this cast")])))

;; A casted literal with a known lane type folds to its typed splat; every
;; other cast takes the checked path above.
(define (lower-avx512-masked-cast-expected
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [origin : ast.AstExpr]
  [inner : ast.AstExpr]
  [cast-ty-id : i64]
  [expected-ty : ast.AstType]) : ResultLowerExpr
  (let
    [resolved-cast : ast.AstType
      (tc_core.tc-type-without-regions
        (tc_core.tc-resolve-type
          ctx
          (tc_core.tc-context-type-get ctx cast-ty-id)))]
    [resolved-expected : ast.AstType
      (tc_core.tc-type-without-regions
        (tc_core.tc-resolve-type ctx expected-ty))]
    (match (lower-simple-vector-map-casted-literal
      ctx
      (lower-state-mode state)
      resolved-cast
      (lower-global-shared-view resolved-expected)
      (lower-global-shared-view inner))
      [(Some plan)
        (match plan
          [(Uniform value)
            (Ok
              (lower-emit-masked-preheader-splat
                state
                value
                lanes
                resolved-expected))]
          [_
            (lower-avx512-masked-cast
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              origin
              inner
              cast-ty-id)])]
      [(No)
        (lower-avx512-masked-cast
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          origin
          inner
          cast-ty-id)])))

(define (lower-avx512-masked-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : (& lane-locals LowerIdSet)]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]) : ResultLowerExpr
  (let
    [lane-locals : LowerIdSet
      (owned_view.compiler-owned-reference-shared-view lane-locals)]
    (match (lower-global-shared-view expr)
      [(Spanned inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (match (lower-global-shared-view inner)
            ;; A rejected cast is reported at its own span.
            [(Cast cast-box cast-ty-id)
              (lower-avx512-masked-cast
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                expr
                (lower-context-expr-get ctx cast-box)
                cast-ty-id)]
            [_
              (lower-avx512-masked-expr
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                inner)]))]
      [(Ann inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-avx512-masked-expr
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            inner))]
      [(Cast inner-box cast-ty-id)
        (lower-avx512-masked-cast
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expr
          (lower-context-expr-get ctx inner-box)
          cast-ty-id)]
      [(Literal lit)
        (match (lower-global-shared-view lit)
          [(Bool value)
            (Ok
              (lower-avx512-masked-bool-literal state active-mask lanes value))]
          [_
            (Ok
              (lower-emit-masked-preheader-splat
                state
                (lower-literal-value-with-type
                  (tc_core.tc-context-source-names ctx)
                  (lower-global-shared-view lit)
                  (tc_core.tc-literal-type (lower-global-shared-view lit)))
                lanes
                (tc_core.tc-literal-type lit)))])]
      [(SpmdProgramIndex) (Ok (lower-emit-lane-id state lanes (I64)))]
      [(SpmdProgramCount)
        (Ok (lower-emit-masked-preheader-splat state (I64 lanes) lanes (I64)))]
      [(Var name)
        (lower-avx512-masked-var
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          lanes
          expr
          name)]
      [(Unary op inner-box)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (match op
            [(Not)
              (let
                [lowered
                  (try
                    (lower-avx512-masked-expr
                      ctx
                      state
                      env
                      type-env
                      lane-locals
                      index
                      index-var
                      active-mask
                      lanes
                      inner))]
                (match lowered
                  [(Expr next-state value _)
                    (Ok (lower-emit-mask-not next-state value lanes))]))]
            [_ (lower-avx512-masked-unsupported ctx expr "this unary operator")]))]
      [(Binary op left-box right-box)
        (let
          [left : ast.AstExpr (lower-context-expr-get ctx left-box)]
          [right : ast.AstExpr (lower-context-expr-get ctx right-box)]
          (lower-avx512-masked-binary
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            expr
            op
            left
            right))]
      [(Call func-box args)
        (lower-masked-load-cache-invalidate-result
          (lower-avx512-spmd-call
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            expr
            (lower-context-expr-get ctx func-box)
            args))]
      [(Let let-box)
        (match (__tl-box-place let-box)
          [(Let bindings body-box)
            (let
              [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
              (match (lower-avx512-masked-let-bindings
                ctx
                state
                env
                type-env
                (lower-global-shared-view lane-locals)
                (lower-global-shared-view index)
                index-var
                (lower-global-shared-view active-mask)
                lanes
                bindings)
                [(Ok bound-state bound-env bound-type-env)
                  (let
                    [lane-locals-arg
                      (lower-masked-vector-let-binding-names
                        bindings
                        lane-locals)]
                    (lower-avx512-masked-expr
                      ctx
                      bound-state
                      bound-env
                      bound-type-env
                      lane-locals-arg
                      index
                      index-var
                      active-mask
                      lanes
                      body))]
                [(Err message) (Err message)]))])]
      [(If cond-box then-box else-box)
        (let
          [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
          [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
          [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
          (match (lower-expr-result-type-or-check
            ctx
            env
            type-env
            (lower-state-type-cache state)
            (lower-state-function-state state)
            expr)
            [(Ok result-ty)
              (lower-avx512-masked-if
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                result-ty
                expr
                cond
                then-branch
                else-branch)]
            [(Err message)
              (Err (box (lower-diagnostic-at-expr ctx expr message)))]))]
      [(Match match-box)
        (match (deref match-box)
          [(Match scrutinee-box arms)
            (match (lower-expr-result-type-or-check
              ctx
              env
              type-env
              (lower-state-type-cache state)
              (lower-state-function-state state)
              expr)
              [(Ok result-ty)
                (lower-avx512-masked-match
                  ctx
                  state
                  env
                  type-env
                  lane-locals
                  index
                  index-var
                  active-mask
                  lanes
                  result-ty
                  expr
                  (lower-context-expr-get ctx scrutinee-box)
                  arms)]
              [(Err message)
                (Err (box (lower-diagnostic-at-expr ctx expr message)))])])]
      [(While cond-box body-box)
        (lower-masked-load-cache-invalidate! state)
        (lower-masked-load-cache-invalidate-result
          (lower-avx512-masked-while
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            (lower-context-expr-get ctx cond-box)
            (Begin body-box)))]
      [(Begin exprs)
        (lower-avx512-masked-begin
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          exprs)]
      [(ArrayRef arr-box idx-box)
        (let
          [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
          [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
          (lower-avx512-masked-array-ref
            ctx
            state
            env
            type-env
            index
            index-var
            active-mask
            lanes
            expr
            arr
            idx))]
      [(ArraySet arr-box idx-box value-box)
        (let
          [arr : ast.AstExpr (lower-context-expr-get ctx arr-box)]
          [idx : ast.AstExpr (lower-context-expr-get ctx idx-box)]
          [value : ast.AstExpr (lower-context-expr-get ctx value-box)]
          (lower-masked-load-cache-invalidate-result
            (lower-avx512-masked-array-set
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              expr
              arr
              idx
              value)))]
      [_ (lower-avx512-masked-unsupported ctx expr "this branch expression")])))

(define (lower-avx512-masked-expr-expected
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane-locals : LowerIdSet]
  [index : String]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [expr : ast.AstExpr]
  [expected-ty : (& expected-ty ast.AstType)]) : ResultLowerExpr
  (let
    [expected-ty : ast.AstType
      (owned_view.compiler-owned-reference-shared-view expected-ty)]
    (match (lower-global-shared-view expr)
      [(Spanned inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (match (lower-global-shared-view inner)
            ;; A rejected cast is reported at its own span.
            [(Cast cast-box cast-ty-id)
              (lower-avx512-masked-cast-expected
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                expr
                (lower-context-expr-get ctx cast-box)
                cast-ty-id
                expected-ty)]
            [_
              (lower-avx512-masked-expr-expected
                ctx
                state
                env
                type-env
                lane-locals
                index
                index-var
                active-mask
                lanes
                inner
                expected-ty)]))]
      [(Ann inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-avx512-masked-expr-expected
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            inner
            expected-ty))]
      ;; A `let`, such as an inlined helper's argument staging (#7541), gives
      ;; its body the expected type, so a literal body splats in the store's
      ;; element type as it would without the `let`.
      [(Let let-box)
        (match (__tl-box-place let-box)
          [(Let bindings body-box)
            (match (lower-avx512-masked-let-bindings
              ctx
              state
              env
              type-env
              (lower-global-shared-view lane-locals)
              (lower-global-shared-view index)
              index-var
              (lower-global-shared-view active-mask)
              lanes
              (& bindings))
              [(Ok bound-state bound-env bound-type-env)
                (lower-avx512-masked-expr-expected
                  ctx
                  bound-state
                  bound-env
                  bound-type-env
                  (lower-masked-vector-let-binding-names bindings lane-locals)
                  index
                  index-var
                  active-mask
                  lanes
                  (lower-context-expr-get ctx body-box)
                  expected-ty)]
              [(Err message) (Err message)])])]
      [(Cast inner-box cast-ty-id)
        (lower-avx512-masked-cast-expected
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expr
          (lower-context-expr-get ctx inner-box)
          cast-ty-id
          expected-ty)]
      [(Literal lit)
        (match (lower-global-shared-view lit)
          [(Bool value)
            (Ok
              (lower-avx512-masked-bool-literal state active-mask lanes value))]
          [_
            (Ok
              (lower-emit-masked-preheader-splat
                state
                (lower-literal-value-with-type
                  (tc_core.tc-context-source-names ctx)
                  lit
                  (tc_core.tc-type-without-regions
                    (lower-global-shared-view expected-ty)))
                lanes
                (tc_core.tc-type-without-regions expected-ty)))])]
      [(If cond-box then-box else-box)
        (let
          [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
          [then-branch : ast.AstExpr (lower-context-expr-get ctx then-box)]
          [else-branch : ast.AstExpr (lower-context-expr-get ctx else-box)]
          (lower-avx512-masked-if
            ctx
            state
            env
            type-env
            lane-locals
            index
            index-var
            active-mask
            lanes
            expected-ty
            expr
            cond
            then-branch
            else-branch))]
      [(Match match-box)
        (match (__tl-box-place match-box)
          [(Match scrutinee-box arms)
            (lower-avx512-masked-match
              ctx
              state
              env
              type-env
              lane-locals
              index
              index-var
              active-mask
              lanes
              expected-ty
              expr
              (lower-context-expr-get ctx scrutinee-box)
              arms)])]
      [_
        (lower-avx512-masked-expr
          ctx
          state
          env
          type-env
          lane-locals
          index
          index-var
          active-mask
          lanes
          expr)])))

(define (lower-predicated-tail-map-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [index-var : i64]
  [end-value : ir.CompilerIrValue]
  [plan : LowerMaybeVectorMap]) : LowerState
  (match plan
    [(Some stores elem-ty lanes)
      (let
        [s : LowerState state]
        [count : i64 stores.count]
        [results : (__tl_dyn-array ir.CompilerIrValue)
          (__tl_make-array ir.CompilerIrValue count)]
        [store-index : i64 0]
        [cache : LowerVectorMapValueCache (lower-vector-map-value-cache-empty)]
        [mask : ir.CompilerIrValue Unit]
        [result-vec : ir.CompilerIrValue Unit]
        (match (lower-emit-tail-mask
          s
          (Var index-var)
          (lower-global-shared-view end-value)
          lanes)
          [(Expr next-s value _)
            (set! s next-s)
            (set! mask value)])
        (while (< store-index count)
          (match (lower-vector-map-store-list-ref stores store-index)
            [(LowerVectorMapStore _ value-plan)
              (match (lower-emit-vector-map-value-cached
                ctx
                s
                index-var
                lanes
                (lower-global-shared-view elem-ty)
                value-plan
                (Predicated
                  (lower-global-shared-view end-value)
                  (lower-global-shared-view mask))
                (lower-global-shared-view cache))
                [(Emit next-s value next-cache)
                  (set! s next-s)
                  (set! result-vec value)
                  (set! cache next-cache)])
              (set! (array-ref results store-index) result-vec)
              (set! store-index (+ store-index 1))]))
        (set! store-index 0)
        (while (< store-index count)
          (match (lower-vector-map-store-list-ref stores store-index)
            [(LowerVectorMapStore dst-array _)
              (set!
                s
                (lower-emit-sequence-predicated-store
                  s
                  dst-array
                  (Var index-var)
                  (lower-global-array-element-shared-view results store-index)
                  (lower-global-shared-view mask)
                  lanes
                  (lower-global-shared-view elem-ty)))
              (set! store-index (+ store-index 1))]))
        s)]
    [(No) state]))

(define (lower-masked-preheader-cache-array-data
  [state : LowerState]
  [arrays : (& arrays LowerArrayVarSet)]) : LowerState
  (let
    [s : LowerState state]
    [array-index : i64 0]
    (while (< array-index arrays.count)
      (let
        [array-var : i64 (array-ref arrays.vars array-index)]
        (match (lower-sequence-data-pointer-value s array-var)
          [(Expr next-state data-ptr _)
            (set! s next-state)
            (lower-masked-preheader-array-data-add! s array-var data-ptr)])
        (set! array-index (+ array-index 1))))
    s))

(define (lower-avx512-masked-map-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [index-var : i64]
  [active-mask : ir.CompilerIrMaybeValue]
  [lanes : i64]
  [body : ast.AstExpr]) : ResultLowerExpr
  (lower-masked-load-cache-enable! state)
  (let
    [env-arg (sym_i64_env.sym-i64-bind-id env index-id index-var)]
    [type-env-arg (tc_core.tc-bind-id type-env index-id index-ty)]
    [lane-locals (lower-id-set-empty)]
    (lower-avx512-masked-expr
      ctx
      state
      env-arg
      type-env-arg
      lane-locals
      index
      index-var
      active-mask
      lanes
      body)))

(define (lower-avx512-masked-foreach-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [body : ast.AstExpr]
  [plan : LowerMaybeMaskedVectorMap]) : ResultLowerExpr
  (match plan
    [(Some lanes)
      (match (lower-state-alloc-var state)
        [(Alloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (Mov index-var start-value (lower-global-shared-view index-ty)))]
            [body-env : sym_i64_env.SymI64Env
              (sym_i64_env.sym-i64-bind-id env index-id index-var)]
            [body-type-env : tc_core.TcTypeEnv
              (tc_core.tc-bind-id
                type-env
                index-id
                (lower-global-shared-view index-ty))]
            [arrays : LowerArrayVarSet
              (lower-masked-vector-array-vars
                ctx
                body-env
                body-type-env
                index
                (lower-global-shared-view body))]
            [preheader-cache : (Box LowerMaskedPreheaderCacheData)
              (lower-masked-preheader-cache-new)]
            [header-label : i64 (ir.compiler-ir-label-none)]
            [body-label : i64 (ir.compiler-ir-label-none)]
            [tail-header-label : i64 (ir.compiler-ir-label-none)]
            [tail-check-label : i64 (ir.compiler-ir-label-none)]
            [tail-mask-label : i64 (ir.compiler-ir-label-none)]
            [tail-body-label : i64 (ir.compiler-ir-label-none)]
            [exit-label : i64 (ir.compiler-ir-label-none)]
            [preheader-label : i64 (ir.compiler-ir-label-none)]
            [preheader-block-index : i64 (- 0 1)]
            [vector-limit : ir.CompilerIrValue Unit]
            [vector-start-ok : ir.CompilerIrValue Unit]
            [next-index : ir.CompilerIrValue Unit]
            [vector-ok : ir.CompilerIrValue Unit]
            [tail-cond : ir.CompilerIrValue Unit]
            [tail-safe : ir.CompilerIrValue Unit]
            [active-mask : ir.CompilerIrValue Unit]
            (match (lower-state-fresh-label s "foreach_avx512_mask_header")
              [(Label next-s label)
                (set! s next-s)
                (set! header-label label)])
            (match (lower-state-fresh-label s "foreach_avx512_mask_body")
              [(Label next-s label)
                (set! s next-s)
                (set! body-label label)])
            (match (lower-state-fresh-label s "foreach_tail_header")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-header-label label)])
            (match (lower-state-fresh-label s "foreach_tail_check")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-check-label label)])
            (match (lower-state-fresh-label s "foreach_tail_mask")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-mask-label label)])
            (match (lower-state-fresh-label s "foreach_tail_body")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-body-label label)])
            (match (lower-state-fresh-label s "foreach_exit")
              [(Label next-s label)
                (set! s next-s)
                (set! exit-label label)])
            (match (lower-state-fresh-label s "foreach_mask_preheader")
              [(Label next-s label)
                (set! s next-s)
                (set! preheader-label label)])
            (match (lower-vector-loop-limit
              s
              (lower-global-shared-view end-value)
              arrays
              lanes)
              [(Expr next-s value _)
                (set! s next-s)
                (set! vector-limit value)])
            (match (lower-vector-loop-start-ok s index-var lanes)
              [(Expr next-s value _)
                (set! s next-s)
                (set! vector-start-ok value)])
            (lower-masked-preheader-cache-set! s preheader-cache)
            (set! s (lower-masked-preheader-cache-array-data s arrays))
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit s (Jump preheader-label))
                preheader-label))
            (let
              [data : (Box LowerStateData) (lower-state-box s)]
              [blocks : ir.CompilerIrBlockBuilder
                (lower-box-field-shared-view data blocks)]
              (set! preheader-block-index blocks.len))
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit
                  s
                  (Branch
                    (lower-global-shared-view vector-start-ok)
                    header-label
                    tail-header-label))
                header-label))
            (match (lower-emit-binop
              s
              (Add)
              (Var index-var)
              (I64 lanes)
              (lower-global-shared-view index-ty))
              [(Expr next-s value _)
                (set! s next-s)
                (set! next-index value)])
            (match (lower-vector-loop-next-ok
              s
              (lower-global-shared-view next-index)
              vector-limit)
              [(Expr next-s value _)
                (set! s next-s)
                (set! vector-ok value)])
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit
                  s
                  (Branch vector-ok body-label tail-header-label))
                body-label))
            (let
              [lowered-body
                (try
                  (lower-avx512-masked-map-body
                    ctx
                    s
                    env
                    type-env
                    index-id
                    (lower-global-shared-view index)
                    (lower-global-shared-view index-ty)
                    index-var
                    (No)
                    lanes
                    (lower-global-shared-view body)))]
              (match lowered-body
                [(Expr body-state _ _)
                  (set!
                    s
                    (lower-state-emit
                      body-state
                      (Mov
                        index-var
                        next-index
                        (lower-global-shared-view index-ty))))]))
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit s (Jump header-label))
                tail-header-label))
            (match (lower-vector-loop-i64-compare
              s
              (Lt)
              (Var index-var)
              (lower-global-shared-view end-value))
              [(Expr next-s value _)
                (set! s next-s)
                (set! tail-cond value)])
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit
                  s
                  (Branch tail-cond tail-check-label exit-label))
                tail-check-label))
            (match (lower-predicated-tail-ok
              s
              index-var
              (lower-global-shared-view end-value)
              arrays)
              [(Expr next-s value _)
                (set! s next-s)
                (set! tail-safe value)])
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit
                  s
                  (Branch tail-safe tail-mask-label tail-body-label))
                tail-mask-label))
            (match (lower-emit-tail-mask s (Var index-var) end-value lanes)
              [(Expr next-s value _)
                (set! s next-s)
                (set! active-mask value)])
            (let
              [lowered-tail
                (try
                  (lower-avx512-masked-map-body
                    ctx
                    s
                    env
                    type-env
                    index-id
                    index
                    (lower-global-shared-view index-ty)
                    index-var
                    (Some active-mask)
                    lanes
                    (lower-global-shared-view body)))]
              (match lowered-tail
                [(Expr tail-state _ _)
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit tail-state (Jump exit-label))
                      tail-body-label))]))
            (match (lower-state-masked-preheader-cache s)
              [(Some cache)
                (ir.compiler-ir-instr-builder-push!
                  (&mut
                    (__tl-project-field (__tl-box-place cache) uniform-instrs))
                  (ir.CompilerIrInstr.Branch
                    vector-start-ok
                    header-label
                    tail-header-label))
                (let
                  [data : (Box LowerStateData) (lower-state-box s)]
                  [blocks : ir.CompilerIrBlockBuilder
                    (lower-box-field-shared-view data blocks)]
                  (set!
                    (array-ref blocks.slots preheader-block-index)
                    (ir.CompilerIrBlock.Block
                      preheader-label
                      (ir.compiler-ir-instr-builder-to-seq
                        (lower-box-field-shared-view cache uniform-instrs)))))]
              [(No) unit])
            (lower-masked-preheader-cache-disable! s)
            (let
              [scalar-tail-lowered : LowerExpr
                (try (lower-expr ctx s body-env body-type-env body))]
              (match scalar-tail-lowered
                [(Expr post-body-state _ _)
                  (match (lower-state-alloc-var post-body-state)
                    [(Alloc inc-alloc inc-var)
                      (Ok
                        (Expr
                          (lower-state-finish-block
                            (lower-state-emit
                              (lower-state-emit
                                (lower-state-emit
                                  inc-alloc
                                  (BinOp
                                    inc-var
                                    Add
                                    (Var index-var)
                                    (I64 1)
                                    (lower-global-shared-view index-ty)))
                                (Mov index-var (Var inc-var) index-ty))
                              (Jump tail-header-label))
                            exit-label)
                          Unit
                          (Unit)))])])))])]
    [(No)
      (lower-scalar-foreach-lowered
        ctx
        state
        env
        type-env
        index-id
        index
        index-ty
        start-value
        end-value
        body)]))

;; Scalar `foreach` lowering. `(foreach ([i : ty start end]) body)`
;; lowers to the half-open reference loop `i = start; while (i < end) { body;
;; i = i + 1 }`, yielding unit. `start` and `end` are each lowered exactly once
;; before the loop; the index binding is scoped to the body. Mirrors lower-while
;; with an index var, a `<` guard, and a `+ 1` increment.
(define (lower-spmd-scalar-body-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index : String]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [function-state : CompilerLowerFunctionState
      (lower-state-function-state state)]
    [previous : LowerSpmdScalarCallContext
      (compiler-lower-function-state-scalar-call-context function-state)]
    [result : ResultLowerExpr
      (Err (box (lower-diagnostic "lower: SPMD scalar body lowering failed")))]
    (compiler-lower-function-state-scalar-call-context-set!
      function-state
      (Some index))
    (set! result (lower-expr ctx state env type-env body))
    (compiler-lower-function-state-scalar-call-context-set!
      function-state
      previous)
    result))

(define (lower-scalar-foreach-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [body : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc index-alloc index-var)
      (match (lower-state-fresh-label
        (lower-state-emit
          index-alloc
          (Mov index-var start-value (lower-global-shared-view index-ty)))
        "foreach_header")
        [(Label header-ls header-label)
          (match (lower-state-fresh-label header-ls "foreach_body")
            [(Label body-ls body-label)
              (match (lower-state-fresh-label body-ls "foreach_exit")
                [(Label exit-ls exit-label)
                  (match (lower-state-alloc-var
                    (lower-state-finish-block
                      (lower-state-emit exit-ls (Jump header-label))
                      header-label))
                    [(Alloc cond-alloc cond-var)
                      (let
                        [body-lowered
                          (try
                            (lower-spmd-scalar-body-expr
                              ctx
                              (lower-state-finish-block
                                (lower-state-emit
                                  (lower-state-emit
                                    cond-alloc
                                    (BinOp
                                      cond-var
                                      Lt
                                      (Var index-var)
                                      end-value
                                      (lower-global-shared-view index-ty)))
                                  (Branch (Var cond-var) body-label exit-label))
                                body-label)
                              (sym_i64_env.sym-i64-bind-id
                                env
                                index-id
                                index-var)
                              (tc_core.tc-bind-id
                                type-env
                                index-id
                                (lower-global-shared-view index-ty))
                              index
                              body))]
                        (match body-lowered
                          [(Expr post-body-state _ _)
                            (match (lower-state-alloc-var post-body-state)
                              [(Alloc inc-alloc inc-var)
                                (Ok
                                  (Expr
                                    (lower-state-finish-block
                                      (lower-state-emit
                                        (lower-state-emit
                                          (lower-state-emit
                                            inc-alloc
                                            (BinOp
                                              inc-var
                                              Add
                                              (Var index-var)
                                              (I64 1)
                                              (lower-global-shared-view
                                                index-ty)))
                                          (Mov index-var (Var inc-var) index-ty))
                                        (Jump header-label))
                                      exit-label)
                                    Unit
                                    (Unit)))])]))])])])])]))

(define (lower-avx2-foreach-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [body : ast.AstExpr]
  [plan : LowerMaybeVectorMap]) : ResultLowerExpr
  (match (lower-global-shared-view plan)
    [(Some stores elem-ty lanes)
      (match (lower-state-alloc-var state)
        [(Alloc index-alloc index-var)
          (let
            [s : LowerState
              (lower-state-emit
                index-alloc
                (Mov index-var start-value (lower-global-shared-view index-ty)))]
            [arrays : LowerArrayVarSet
              (lower-vector-map-store-list-array-vars
                (lower-global-shared-view stores))]
            [header-label : i64 (ir.compiler-ir-label-none)]
            [body-label : i64 (ir.compiler-ir-label-none)]
            [tail-header-label : i64 (ir.compiler-ir-label-none)]
            [tail-check-label : i64 (ir.compiler-ir-label-none)]
            [tail-mask-label : i64 (ir.compiler-ir-label-none)]
            [tail-body-label : i64 (ir.compiler-ir-label-none)]
            [exit-label : i64 (ir.compiler-ir-label-none)]
            [vector-limit : ir.CompilerIrValue Unit]
            [vector-start-ok : ir.CompilerIrValue Unit]
            [next-index : ir.CompilerIrValue Unit]
            [vector-ok : ir.CompilerIrValue Unit]
            [tail-cond : ir.CompilerIrValue Unit]
            [tail-safe : ir.CompilerIrValue Unit]
            [predicated-tail? : bool
              (or
                (lower-mode-avx512? (lower-state-mode state))
                (not
                  (lower-maybe-vector-map-needs-scalar-tail?
                    (lower-global-shared-view plan))))]
            [preheader-cache : LowerVectorMapValueCache
              (lower-vector-map-value-cache-empty)]
            (match (lower-state-fresh-label s "foreach_avx2_header")
              [(Label next-s label)
                (set! s next-s)
                (set! header-label label)])
            (match (lower-state-fresh-label s "foreach_avx2_body")
              [(Label next-s label)
                (set! s next-s)
                (set! body-label label)])
            (match (lower-state-fresh-label s "foreach_tail_header")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-header-label label)])
            (match (lower-state-fresh-label s "foreach_tail_check")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-check-label label)])
            (match (lower-state-fresh-label s "foreach_tail_mask")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-mask-label label)])
            (match (lower-state-fresh-label s "foreach_tail_body")
              [(Label next-s label)
                (set! s next-s)
                (set! tail-body-label label)])
            (match (lower-state-fresh-label s "foreach_exit")
              [(Label next-s label)
                (set! s next-s)
                (set! exit-label label)])
            (match (lower-vector-loop-limit
              s
              (lower-global-shared-view end-value)
              arrays
              lanes)
              [(Expr next-s value _)
                (set! s next-s)
                (set! vector-limit value)])
            (match (lower-vector-loop-start-ok s index-var lanes)
              [(Expr next-s value _)
                (set! s next-s)
                (set! vector-start-ok value)])
            (match (lower-vector-map-preheader-cache-stores
              s
              arrays
              stores
              lanes
              elem-ty)
              [(Emit next-s _ next-cache)
                (set! s next-s)
                (set! preheader-cache next-cache)])
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit
                  s
                  (Branch vector-start-ok header-label tail-header-label))
                header-label))
            (match (lower-emit-binop
              s
              (Add)
              (Var index-var)
              (I64 lanes)
              (lower-global-shared-view index-ty))
              [(Expr next-s value _)
                (set! s next-s)
                (set! next-index value)])
            (match (lower-vector-loop-next-ok
              s
              (lower-global-shared-view next-index)
              vector-limit)
              [(Expr next-s value _)
                (set! s next-s)
                (set! vector-ok value)])
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit
                  s
                  (Branch vector-ok body-label tail-header-label))
                body-label))
            (set!
              s
              (lower-avx2-vector-map-body
                ctx
                s
                index-var
                next-index
                (lower-global-shared-view plan)
                preheader-cache))
            (set!
              s
              (lower-state-finish-block
                (lower-state-emit s (Jump header-label))
                tail-header-label))
            (match (lower-vector-loop-i64-compare
              s
              (Lt)
              (Var index-var)
              (lower-global-shared-view end-value))
              [(Expr next-s value _)
                (set! s next-s)
                (set! tail-cond value)])
            (set!
              s
              (if predicated-tail?
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (Branch tail-cond tail-check-label exit-label))
                  tail-check-label)
                (lower-state-finish-block
                  (lower-state-emit
                    s
                    (Branch tail-cond tail-body-label exit-label))
                  tail-body-label)))
            (if predicated-tail?
              (if (lower-maybe-vector-map-has-gather?
                (lower-global-shared-view plan))
                ;; Gather sources require per-lane scalar tail semantics.
                ;; Enter the ordinary one-iteration tail body directly
                ;; instead of materializing a predicated vector value that
                ;; cannot represent those source checks.
                (set!
                  s
                  (lower-state-finish-block
                    (lower-state-emit s (Jump tail-body-label))
                    tail-body-label))
                (begin
                  (match (lower-predicated-tail-ok
                    s
                    index-var
                    (lower-global-shared-view end-value)
                    arrays)
                    [(Expr next-s value _)
                      (set! s next-s)
                      (set! tail-safe value)])
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit
                        s
                        (Branch tail-safe tail-mask-label tail-body-label))
                      tail-mask-label))
                  (set!
                    s
                    (lower-predicated-tail-map-body
                      ctx
                      s
                      index-var
                      (lower-global-shared-view end-value)
                      (lower-global-shared-view plan)))
                  (set!
                    s
                    (lower-state-finish-block
                      (lower-state-emit s (Jump exit-label))
                      tail-body-label))))
              unit)
            (if (and
              (lower-maybe-vector-map-needs-scalar-tail?
                (lower-global-shared-view plan))
              (or
                (not (lower-mode-avx512? (lower-state-mode s)))
                (lower-maybe-vector-map-has-gather?
                  (lower-global-shared-view plan))
                (lower-maybe-vector-map-has-shuffle?
                  (lower-global-shared-view plan))))
              (match plan
                [(Some stores elem-ty store-lanes)
                  (lower-avx2-broadcast-tail-map-body
                    ctx
                    s
                    index-var
                    end-value
                    stores
                    elem-ty
                    store-lanes
                    exit-label)]
                [(No)
                  (Err
                    (box (lower-diagnostic "lower: missing vector map plan")))])
              (let
                [body-lowered
                  (try
                    (lower-expr
                      ctx
                      s
                      (sym_i64_env.sym-i64-bind-id env index-id index-var)
                      (tc_core.tc-bind-id
                        type-env
                        index-id
                        (lower-global-shared-view index-ty))
                      body))]
                (match body-lowered
                  [(Expr post-body-state _ _)
                    (match (lower-state-alloc-var post-body-state)
                      [(Alloc inc-alloc inc-var)
                        (Ok
                          (Expr
                            (lower-state-finish-block
                              (lower-state-emit
                                (lower-state-emit
                                  (lower-state-emit
                                    inc-alloc
                                    (BinOp
                                      inc-var
                                      Add
                                      (Var index-var)
                                      (I64 1)
                                      (lower-global-shared-view index-ty)))
                                  (Mov index-var (Var inc-var) index-ty))
                                (Jump tail-header-label))
                              exit-label)
                            Unit
                            (Unit)))])]))))])]
    [(No)
      (lower-scalar-foreach-lowered
        ctx
        state
        env
        type-env
        index-id
        index
        index-ty
        start-value
        end-value
        body)]))

(define (lower-foreach-lowered-inlined
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [diagnostic-body : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (if (and
    (lower-mode-simd? (lower-state-mode state))
    (lower-type-i64? (lower-global-shared-view index-ty)))
    (match (lower-simple-vector-map
      ctx
      (lower-state-mode state)
      env
      type-env
      index
      (lower-global-shared-view body))
      [(Some stores elem-ty lanes)
        (lower-avx2-foreach-lowered
          ctx
          state
          env
          type-env
          index-id
          index
          index-ty
          start-value
          end-value
          body
          (Some stores elem-ty lanes))]
      [(No)
        (if (lower-spmd-expr-has-call?
          ctx
          (lower-state-function-state state)
          env
          type-env
          (Atomic)
          (lower-global-shared-view body))
          (lower-scalar-foreach-lowered
            ctx
            state
            env
            type-env
            index-id
            index
            index-ty
            start-value
            end-value
            body)
          (let
            [facts : LowerMaskedVectorFacts
              (lower-masked-vector-facts
                ctx
                (lower-state-function-state state)
                (lower-state-mode state)
                env
                type-env
                (lower-global-shared-view index)
                (lower-global-shared-view body))]
            (match (lower-masked-vector-map
              ctx
              (lower-state-function-state state)
              (lower-state-mode state)
              env
              type-env
              (lower-global-shared-view index)
              (lower-global-shared-view body)
              facts)
              [(Some lanes)
                (lower-avx512-masked-foreach-lowered
                  ctx
                  state
                  env
                  type-env
                  index-id
                  index
                  index-ty
                  start-value
                  end-value
                  body
                  (Some lanes))]
              [(No)
                (match (lower-spmd-numeric-failure
                  ctx
                  (lower-state-function-state state)
                  (lower-state-mode state)
                  env
                  (tc_core.tc-bind-id
                    type-env
                    index-id
                    (lower-global-shared-view index-ty))
                  (DirectMap)
                  diagnostic-body)
                  [(Some origin decision)
                    (Err
                      (box
                        (lower-diagnostic-at-expr
                          ctx
                          origin
                          (lower-spmd-numeric-failure-message decision))))]
                  [(No)
                    (cond
                      [facts.varying-while
                        (Err
                          (box
                            (lower-diagnostic-at-expr
                              ctx
                              body
                              (if (lower-mode-avx2? (lower-state-mode state))
                                (lower-avx2-varying-while-diagnostic)
                                "lower: SPMD varying while AVX-512 lowering is not available for this backend mode or loop shape"))))]
                      [facts.varying-if
                        (Err
                          (box
                            (lower-diagnostic-at-expr
                              ctx
                              body
                              (if (lower-mode-avx2? (lower-state-mode state))
                                (lower-avx2-masked-if-diagnostic)
                                "lower: SPMD masked if AVX-512 lowering is not available for this backend mode or branch shape"))))]
                      [facts.varying-enum-match
                        (Err
                          (box
                            (lower-diagnostic-at-expr
                              ctx
                              body
                              (if (lower-mode-avx2? (lower-state-mode state))
                                "lower: AVX2 varying enum match requires a contiguous dynamic-array lane source and supported payload bindings"
                                "lower: AVX-512 varying enum match requires a contiguous dynamic-array lane source and supported payload bindings"))))]
                      [facts.varying-match
                        (Err
                          (box
                            (lower-diagnostic-at-expr
                              ctx
                              body
                              (if (lower-mode-avx2? (lower-state-mode state))
                                "lower: SPMD varying match AVX2 lowering is not available for this match shape"
                                "lower: SPMD varying match AVX-512 lowering is not available for this backend mode or match shape"))))]
                      [(lower-vector-body-has?
                          ctx
                          (Shuffle)
                          (lower-global-shared-view body))
                        (Err
                          (box
                            (lower-diagnostic-at-expr
                              ctx
                              body
                              (lower-spmd-shuffle-diagnostic))))]
                      [(lower-vector-body-has?
                          ctx
                          (ArrayRead)
                          (lower-global-shared-view body))
                        (match (lower-simple-vector-map-unsupported-shift-lane
                          ctx
                          (lower-state-mode state)
                          env
                          type-env
                          index
                          true
                          (lower-global-shared-view body))
                          [(Some lane-ty)
                            (Err
                              (box
                                (lower-diagnostic-at-expr
                                  ctx
                                  body
                                  (lower-spmd-map-shift-diagnostic
                                    "shl"
                                    lane-ty
                                    (lower-state-mode state)))))]
                          [(No)
                            (match (lower-simple-vector-map-unsupported-shift-lane
                              ctx
                              (lower-state-mode state)
                              env
                              type-env
                              index
                              false
                              (lower-global-shared-view body))
                              [(Some lane-ty)
                                (Err
                                  (box
                                    (lower-diagnostic-at-expr
                                      ctx
                                      body
                                      (lower-spmd-map-shift-diagnostic
                                        "shr"
                                        lane-ty
                                        (lower-state-mode state)))))]
                              [(No)
                                (Err
                                  (box
                                    (lower-diagnostic-at-expr
                                      ctx
                                      body
                                      (lower-simd-foreach-fallback-diagnostic))))])])]
                      [else
                        (lower-scalar-foreach-lowered
                          ctx
                          state
                          env
                          type-env
                          index-id
                          index
                          index-ty
                          start-value
                          end-value
                          body)])])])))])
    (lower-scalar-foreach-lowered
      ctx
      state
      env
      type-env
      index-id
      index
      index-ty
      start-value
      end-value
      body)))

;; Fixed-array SPMD operands (#8346). A fixed array, and a reference to one,
;; lowers to a raw pointer to its inline storage, so a foreach body reads and
;; writes it through the native Slice path the SIMD plans already support: the
;; preheader packs `(pointer, N)` once per array and rebinds the name to that
;; view for the body. The view aliases the same storage with the same static
;; length, so every element access keeps its value and its bounds check, and
;; fixed arrays need no gather or map path of their own. A name gets a view only
;; when each occurrence in the body is the base of an `array-ref` or of an
;; element store. Any other occurrence -- a borrow, a whole-array `set!`, a call
;; argument, a binder of the same name -- keeps the array binding, and a shared
;; reference never gets a writable view.
(defenum LowerSpmdArrayViews
  (Views LowerState sym_i64_env.SymI64Env tc_core.TcTypeEnv))

(defenum ResultLowerSpmdArrayViews
  (Ok LowerSpmdArrayViews)
  (Err (Box cdiag.CompilerDiagnostic)))

(define lower-spmd-array-view-read : i64
  1)
(define lower-spmd-array-view-write : i64
  2)
(define lower-spmd-array-view-other : i64
  4)

(define (lower-spmd-array-view-note!
  [flags : (&mut flags lower_i64_i64_map.Map)]
  [name : i64]
  [flag : i64]) : unit
  (let
    [prior : i64 (lower_i64_i64_map.get-value-or flags name 0)]
    (lower_i64_i64_map.insert-ref! flags name (bit-or prior flag))))

(define (lower-spmd-array-view-base-name
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]) : i64
  (match expr
    [(Spanned inner-box _)
      (lower-spmd-array-view-base-name
        ctx
        (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-spmd-array-view-base-name
        ctx
        (lower-context-expr-get ctx inner-box))]
    [(Var name) name]
    [_ -1]))

(define (lower-spmd-array-view-note-base!
  [ctx : tc_core.TcContext]
  [flags : (&mut flags lower_i64_i64_map.Map)]
  [base-id : i64]
  [flag : i64]) : unit
  (let
    [base : ast.AstExpr (lower-context-expr-get ctx base-id)]
    [name : i64
      (lower-spmd-array-view-base-name ctx (lower-global-shared-view base))]
    (if (< name 0)
      (lower-spmd-array-view-scan! ctx flags base)
      (lower-spmd-array-view-note! flags name flag))))

(define (lower-spmd-array-view-note-pattern!
  [flags : (&mut flags lower_i64_i64_map.Map)]
  [pattern : ast.AstPattern]) : unit
  (match pattern
    [(Var name _)
      (lower-spmd-array-view-note! flags name lower-spmd-array-view-other)]
    [(Binding name)
      (lower-spmd-array-view-note! flags name lower-spmd-array-view-other)]
    [(Tuple patterns-box)
      (lower-spmd-array-view-note-patterns! flags (deref patterns-box))]
    [(Array patterns-box)
      (lower-spmd-array-view-note-patterns! flags (deref patterns-box))]
    [(Slice patterns-box _)
      (lower-spmd-array-view-note-patterns! flags (deref patterns-box))]
    [(Variant _ patterns-box)
      (lower-spmd-array-view-note-patterns! flags (deref patterns-box))]
    [_ unit]))

(define (lower-spmd-array-view-note-patterns!
  [flags : (&mut flags lower_i64_i64_map.Map)]
  [patterns : ast.AstPatternList]) : unit
  (let
    [index : i64 0]
    (while (< index patterns.len)
      (lower-spmd-array-view-note-pattern!
        flags
        (ast.ast-pattern-list-get (& patterns) index (ast.ast-pattern-fallback)))
      (set! index (+ index 1)))))

;; Names a node carries as payload rather than as a `Var` child: binders and
;; the whole-variable `set!` target. Each counts as an "other" use.
(define (lower-spmd-array-view-note-payload-names!
  [flags : (&mut flags lower_i64_i64_map.Map)]
  [expr : ast.AstExpr]) : unit
  (let
    [other : i64 lower-spmd-array-view-other]
    (match expr
      [(Set name _) (lower-spmd-array-view-note! flags name other)]
      [(Let let-box)
        (match (__tl-box-place let-box)
          [(Let bindings _)
            (let
              [index : i64 0]
              (while (< index bindings.len)
                (match (array-ref bindings.slots index)
                  [(Binding name _ _)
                    (lower-spmd-array-view-note! flags name other)])
                (set! index (+ index 1))))])]
      [(Lambda lambda-box)
        (match (__tl-box-place lambda-box)
          [(Lambda params _ _)
            (let
              [index : i64 0]
              (while (< index params.len)
                (match (array-ref params.slots index)
                  [(Param name _ _)
                    (lower-spmd-array-view-note! flags name other)])
                (set! index (+ index 1))))])]
      [(Foreach foreach-box)
        (match (__tl-box-place foreach-box)
          [(Foreach name _ _ _ _)
            (lower-spmd-array-view-note! flags name other)]
          [(Foreach2 outer _ _ _ inner _ _ _ _)
            (lower-spmd-array-view-note! flags outer other)
            (lower-spmd-array-view-note! flags inner other)])]
      [(SpmdReduce reduce-box)
        (match (__tl-box-place reduce-box)
          [(Reduce _ name _ _ _ _ _)
            (lower-spmd-array-view-note! flags name other)])]
      [(SpmdScan scan-box)
        (match (__tl-box-place scan-box)
          [(Scan _ name _ _ _ result _ _ _ _)
            (lower-spmd-array-view-note! flags name other)
            (lower-spmd-array-view-note! flags result other)])]
      [(SpmdCompact compact-box)
        (match (__tl-box-place compact-box)
          [(Compact name _ _ _ result _ _ _ _)
            (lower-spmd-array-view-note! flags name other)
            (lower-spmd-array-view-note! flags result other)])]
      [(WithResource resource-box)
        (match (__tl-box-place resource-box)
          [(WithResource bindings _)
            (let
              [index : i64 0]
              (while (< index bindings.len)
                (match (array-ref bindings.slots index)
                  [(Binding name _ _ _)
                    (lower-spmd-array-view-note! flags name other)])
                (set! index (+ index 1))))])]
      [(ForeachActive lane _) (lower-spmd-array-view-note! flags lane other)]
      [_ unit])))

(define (lower-spmd-array-view-scan!
  [ctx : tc_core.TcContext]
  [flags : (&mut flags lower_i64_i64_map.Map)]
  [expr : ast.AstExpr]) : unit
  (match (lower-global-shared-view expr)
    [(Var name)
      (lower-spmd-array-view-note! flags name lower-spmd-array-view-other)]
    [(ArrayRef array-box index-box)
      (lower-spmd-array-view-note-base!
        ctx
        flags
        array-box
        lower-spmd-array-view-read)
      (lower-spmd-array-view-scan!
        ctx
        flags
        (lower-context-expr-get ctx index-box))]
    [(ArraySet array-box index-box value-box)
      (lower-spmd-array-view-note-base!
        ctx
        flags
        array-box
        lower-spmd-array-view-write)
      (lower-spmd-array-view-scan!
        ctx
        flags
        (lower-context-expr-get ctx index-box))
      (lower-spmd-array-view-scan!
        ctx
        flags
        (lower-context-expr-get ctx value-box))]
    [_
      (let
        [children : ast.AstExprChildList
          (ast.ast-expr-children (lower-global-shared-view expr))]
        [index : i64 0]
        (lower-spmd-array-view-note-payload-names!
          flags
          (lower-global-shared-view expr))
        (while (< index children.len)
          (match (ast.ast-expr-child-list-get
            (& children)
            index
            (ast.ast-expr-child-fallback))
            [(Expr child-id)
              (lower-spmd-array-view-scan!
                ctx
                flags
                (lower-context-expr-get ctx child-id))]
            [(Pattern pattern)
              (lower-spmd-array-view-note-pattern! flags pattern)]
            [_ unit])
          (set! index (+ index 1))))]))

(define (lower-spmd-array-view-elem? [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-without-regions ty)
    [(I8) true]
    [(U8) true]
    [(I16) true]
    [(U16) true]
    [(I32) true]
    [(U32) true]
    [(I64) true]
    [(U64) true]
    [(F32) true]
    [(F64) true]
    [_ false]))

;; The fixed array a name's current binding reaches, and whether that binding
;; may be written through: a fixed-array value or a `&mut` to one may, a shared
;; reference may not. Returns the array type, or `Unit` when the name is not a
;; fixed array of scalar lanes.
(define (lower-spmd-array-view-array-type
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]
  [write : bool]) : ast.AstType
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    [array : ast.AstType
      (match (lower-global-shared-view resolved)
        [(Array _ _) resolved]
        [(MutRef _ inner)
          (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx inner)))]
        [(Ref _ inner)
          (if write
            (Unit)
            (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type
                ctx
                (tc_core.tc-context-type-get ctx inner))))]
        [_ (Unit)])]
    (match (lower-global-shared-view array)
      [(Array elem _)
        (if (lower-spmd-array-view-elem? (tc_core.tc-context-type-get ctx elem))
          array
          (Unit))]
      [_ (Unit)])))

(define (lower-spmd-array-view-bind
  [ctx : tc_core.TcContext]
  [views : LowerSpmdArrayViews]
  [name : i64]
  [write : bool]) : ResultLowerSpmdArrayViews
  (match views
    [(Views state env type-env)
      (match (tc_core.tc-lookup-id type-env name)
        [(Err _) (Ok (Views state env type-env))]
        [(Ok ty)
          (match (lower-spmd-array-view-array-type ctx ty write)
            [(Array elem count)
              (let
                [slice : i64
                  (ast.ast-node-pool-context-type-push
                    (tc_core.tc-context-pools ctx)
                    (Slice elem))]
                [view-ty : ast.AstType
                  (if write
                    (MutRef -1 slice)
                    (Ref -1 slice))]
                [lowered (try (lower-expr ctx state env type-env (Var name)))]
                (match lowered
                  [(Expr source-state source-value source-ty)
                    (match (lower-cast-value
                      source-state
                      source-value
                      source-ty
                      (U64))
                      [(Expr ptr-state ptr _)
                        (match (lower-slice-view-pack
                          ptr-state
                          ptr
                          (I64 count)
                          (lower-global-shared-view view-ty))
                          [(Expr view-state view-value _)
                            (match view-value
                              [(Var view-var)
                                (Ok
                                  (Views
                                    view-state
                                    (sym_i64_env.sym-i64-bind-id
                                      env
                                      name
                                      view-var)
                                    (tc_core.tc-bind-id type-env name view-ty)))]
                              [_
                                (Err
                                  (box
                                    (lower-diagnostic
                                      "lower: internal SPMD fixed-array view pack failed")))])])])]))]
            [_ (Ok (Views state env type-env))])])]))

(define (lower-spmd-array-views
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-ty : ast.AstType]
  [body : ast.AstExpr]) : ResultLowerSpmdArrayViews
  (if (and
    (lower-mode-simd? (lower-state-mode state))
    (lower-type-i64? index-ty))
    (let
      [flags : lower_i64_i64_map.Map (lower_i64_i64_map.with-capacity 16)]
      [_scan : unit (lower-spmd-array-view-scan! ctx (&mut flags) body)]
      [capacity : i64 (lower_i64_i64_map.capacity (& flags))]
      [slot : i64 (lower_i64_i64_map.next-occupied (& flags) 0)]
      [views : LowerSpmdArrayViews (Views state env type-env)]
      [failed : ResultLowerSpmdArrayViews (Ok (Views state env type-env))]
      [ok : bool true]
      (while (and ok (< slot capacity))
        (match (lower_i64_i64_map.entry-at (& flags) slot)
          [(EntrySome name bits)
            (if (and
              (= (bit-and bits lower-spmd-array-view-other) 0)
              (> bits 0))
              (match (lower-spmd-array-view-bind
                ctx
                views
                name
                (> (bit-and bits lower-spmd-array-view-write) 0))
                [(Ok next) (set! views next)]
                [(Err diag)
                  (set! failed (Err diag))
                  (set! ok false)])
              unit)]
          [(EntryNone) unit])
        (set! slot (lower_i64_i64_map.next-occupied (& flags) (+ slot 1))))
      (if ok
        (Ok views)
        failed))
    (Ok (Views state env type-env))))

(define (lower-foreach-lowered-after-numeric-admission
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [body : ast.AstExpr]) : ResultLowerExpr
  (let
    [inlined-body
      (try
        (let
          [function-state (lower-state-function-state state)]
          [expr (lower-global-shared-view body)]
          [subst (lower-spmd-inline-subst-empty)]
          [shadowed (lower-id-set-insert (lower-id-set-empty) index-id)]
          (lower-spmd-inline-expr
            ctx
            function-state
            env
            type-env
            expr
            subst
            shadowed)))]
    [views
      (try
        (lower-spmd-array-views
          ctx
          state
          env
          type-env
          (lower-global-shared-view index-ty)
          (lower-global-shared-view inlined-body)))]
    (match views
      [(Views view-state view-env view-type-env)
        (lower-foreach-lowered-inlined
          ctx
          view-state
          view-env
          view-type-env
          index-id
          index
          index-ty
          start-value
          end-value
          body
          inlined-body)])))

(define (lower-foreach-lowered
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start-value : ir.CompilerIrValue]
  [end-value : ir.CompilerIrValue]
  [body : ast.AstExpr]) : ResultLowerExpr
  (if (and
    (lower-mode-simd? (lower-state-mode state))
    (lower-type-i64? (lower-global-shared-view index-ty))
    (lower-spmd-expr-has-call?
      ctx
      (lower-state-function-state state)
      env
      type-env
      (OutOfLine)
      (lower-global-shared-view body)))
    (match (lower-spmd-numeric-failure
      ctx
      (lower-state-function-state state)
      (lower-state-mode state)
      env
      (tc_core.tc-bind-id type-env index-id (lower-global-shared-view index-ty))
      (DirectMap)
      (lower-global-shared-view body))
      [(Some origin decision)
        (match decision.context
          [(PrivateHelper)
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  (lower-spmd-numeric-failure-message decision))))]
          [_
            (lower-foreach-lowered-after-numeric-admission
              ctx
              state
              env
              type-env
              index-id
              index
              index-ty
              start-value
              end-value
              body)])]
      [(No)
        (lower-foreach-lowered-after-numeric-admission
          ctx
          state
          env
          type-env
          index-id
          index
          index-ty
          start-value
          end-value
          body)])
    (lower-foreach-lowered-after-numeric-admission
      ctx
      state
      env
      type-env
      index-id
      index
      index-ty
      start-value
      end-value
      body)))

;; --- foreach-active (#8306) ---
;; The SIMD backends lower foreach-active in #8307; until then a gang that
;; holds one is rejected in every SIMD mode, never lowered through a scalar
;; fallback.
(define (lower-foreach-active-simd-message [mode : CompilerLowerMode]) : String
  (str_cat.str-cat
    "lower: foreach-active is not yet lowered for "
    (if (lower-mode-avx2? mode)
      "AVX2"
      "AVX-512")))

;; The first foreach-active in EXPR, as its nearest spanned enclosing node.
(define (lower-find-foreach-active
  [ctx : tc_core.TcContext]
  [expr : ast.AstExpr]
  [origin : ast.AstExpr]) : LowerMaybeAstExpr
  (match (lower-global-shared-view expr)
    [(Spanned inner-box _)
      (lower-find-foreach-active
        ctx
        (lower-context-expr-get ctx inner-box)
        expr)]
    [(ForeachActive _ _) (Some origin)]
    [_
      (let
        [children : ast.AstExprList (ast.ast-expr-child-ids expr)]
        (lower-find-foreach-active-at ctx (& children) 0 origin))]))

(define (lower-find-foreach-active-at
  [ctx : tc_core.TcContext]
  [children : (& children ast.AstExprList)]
  [index : i64]
  [origin : ast.AstExpr]) : LowerMaybeAstExpr
  (if (>= index children.len)
    No
    (match (lower-find-foreach-active
      ctx
      (lower-context-expr-get ctx (ast.ast-expr-list-get children index 0))
      (lower-global-shared-view origin))
      [(Some found) (Some found)]
      [(No) (lower-find-foreach-active-at ctx children (+ index 1) origin)])))

;; Scalar reference lowering: the scalar gang is one lane wide, so the body
;; runs once, for lane 0, the lane program-index reads. A masked-out index
;; never reaches it.
(define (lower-scalar-foreach-active
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [lane : i64]
  [body : ast.AstExpr]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc lane-state lane-var)
      (let
        [lowered
          (try
            (lower-expr-expected
              ctx
              (lower-state-emit lane-state (Mov lane-var (I64 0) (I64)))
              (sym_i64_env.sym-i64-bind-id env lane lane-var)
              (tc_core.tc-bind-id type-env lane (I64))
              (lower-global-shared-view body)
              (Unit)
              body))]
        (match lowered
          [(Expr body-state _ _) (Ok (Expr body-state Unit (Unit)))]))]))

(define (lower-foreach
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [index-id : i64]
  [index : String]
  [index-ty : ast.AstType]
  [start : ast.AstExpr]
  [end : ast.AstExpr]
  [body : ast.AstExpr]) : ResultLowerExpr
  (match (if (lower-mode-simd? (lower-state-mode state))
    (lower-find-foreach-active
      ctx
      (lower-global-shared-view body)
      (lower-global-shared-view body))
    LowerMaybeAstExpr.No)
    [(Some origin)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            (lower-foreach-active-simd-message (lower-state-mode state)))))]
    [(No)
      (let
        [start-lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view start)
              (lower-global-shared-view index-ty)
              start))]
        (match start-lowered
          [(Expr start-state start-value _)
            (let
              [end-lowered
                (try
                  (lower-expr-expected
                    ctx
                    start-state
                    env
                    type-env
                    (lower-global-shared-view end)
                    (lower-global-shared-view index-ty)
                    end))]
              (match end-lowered
                [(Expr end-state end-value _)
                  (lower-foreach-lowered
                    ctx
                    end-state
                    env
                    type-env
                    index-id
                    index
                    index-ty
                    start-value
                    end-value
                    body)]))]))]))

;; Scalar `match` lowering. The scrutinee is lowered once into a fresh
;; local, then literal arms become a chain of `CompilerIrBinOp.Eq` tests + `CompilerIrInstr.Branch`
;; (mirroring `lower-if`). The typechecker guarantees exhaustiveness and arm-type
;; agreement, so the final arm reached must match: it is lowered as an
;; irrefutable catch-all (no test, jump straight to the merge block). A
;; value-typed match merges arm results with an `CompilerIrInstr.Phi`; a `unit`-typed
;; match emits no value phi. Enum matches reuse the same merge path, but load the
;; heap tag once and dispatch variant arms by tag.
(define (lower-match-value
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [scrut-lowered (try (lower-expr ctx state env type-env scrutinee))]
    (match scrut-lowered
      [(Expr scrut-state scrut-value scrut-ty)
        ;; Use the scrutinee var directly when it is already a var, like the
        ;; tail path: a copying Mov into a fresh home makes a 2-word enum pay
        ;; a Pack round-trip per copy.
        (match (lower-tail-match-scrutinee-home
          scrut-state
          scrut-value
          (lower-global-shared-view scrut-ty))
          [(Home home-state scrut-var)
            (match (lower-state-fresh-label home-state "match_merge")
              [(Label merge-state merge-label)
                (lower-match-dispatch
                  ctx
                  merge-state
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  arms
                  (Value
                    merge-label
                    expr-ty
                    (ir.compiler-ir-phi-input-seq-empty)))])])])))

(define (lower-match-borrowed-enum
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [place : ast.AstExpr]
  [borrow-lifetime : i64]
  [enum-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (let
    [resident : bool
      (lower-type-register-resident? ctx (lower-global-shared-view enum-ty))]
    [place-lowered : LowerExpr (try (lower-expr ctx state env type-env place))]
    (match place-lowered
      [(Expr place-state place-value _)
        ;; The borrowed payload bindings and literal compares below
        ;; address the scrutinee as MEMORY (gep off the pointer). A
        ;; register-resident enum place lowers to its packed word(s), so
        ;; spill it to a temp inline slot and run the whole match on the
        ;; slot address (force-memory). The Mov is typed U64 in that case:
        ;; the var holds an address, not a register group.
        (let
          [scrut-expr
            (try
              (if resident
                (lower-copy-inline-aggregate-to-inline
                  ctx
                  place-state
                  place-value
                  (lower-global-shared-view enum-ty))
                (ResultLowerExpr.Ok
                  (Expr
                    place-state
                    place-value
                    (lower-global-shared-view enum-ty)))))]
          (match scrut-expr
            [(Expr scrut-state scrut-value _)
              (match (lower-state-alloc-var scrut-state)
                [(Alloc scrut-alloc scrut-var)
                  (match (lower-state-fresh-label
                    (lower-state-emit
                      scrut-alloc
                      (Mov
                        scrut-var
                        scrut-value
                        (if resident
                          (U64)
                          (owned_view.compiler-owned-shared-view enum-ty))))
                    "match_merge")
                    [(Label merge-state merge-label)
                      (lower-match-enum
                        ctx
                        merge-state
                        env
                        type-env
                        scrut-var
                        enum-ty
                        arms
                        (Value
                          merge-label
                          expr-ty
                          (ir.compiler-ir-phi-input-seq-empty))
                        (Some borrow-lifetime)
                        resident)])])]))])))

(define (lower-match
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]
  [expr-ty : ast.AstType]) : ResultLowerExpr
  (match (ast.ast-expr-unspan (lower-global-shared-view scrutinee))
    [(Borrow mutable _ place-box)
      (if mutable
        (lower-match-value ctx state env type-env scrutinee arms expr-ty)
        (let
          [place : ast.AstExpr (lower-context-expr-get ctx place-box)]
          (match (tc_core.tc-expr
            ctx
            type-env
            (lower-global-shared-view scrutinee))
            [(Ok scrut-ty)
              (match (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx scrut-ty))
                [(Ref borrow-lifetime referent-box)
                  (let
                    [referent-ty : ast.AstType
                      (tc_core.tc-type-strip-region
                        (tc_core.tc-resolve-type
                          ctx
                          (tc_core.tc-context-type-get ctx referent-box)))]
                    (match (lower-global-shared-view referent-ty)
                      [(Enum _)
                        (lower-match-borrowed-enum
                          ctx
                          state
                          env
                          type-env
                          place
                          borrow-lifetime
                          referent-ty
                          arms
                          expr-ty)]
                      [(EnumArgs _ _)
                        (lower-match-borrowed-enum
                          ctx
                          state
                          env
                          type-env
                          place
                          borrow-lifetime
                          referent-ty
                          arms
                          expr-ty)]
                      [_
                        (lower-match-value
                          ctx
                          state
                          env
                          type-env
                          scrutinee
                          arms
                          expr-ty)]))]
                [_
                  (lower-match-value
                    ctx
                    state
                    env
                    type-env
                    scrutinee
                    arms
                    expr-ty)])]
            [(Err message)
              (Err (box (lower-diagnostic-at-expr ctx scrutinee message)))])))]
    [_ (lower-match-value ctx state env type-env scrutinee arms expr-ty)]))

(define (lower-box-pattern-for-type?
  [ctx : tc_core.TcContext]
  [scrut-ty : ast.AstType]
  [name : i64]) : bool
  (if (lower-box-pattern-name? name)
    (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))
      [(Box _) true]
      [_ false])
    false))

(define (lower-struct-pattern-for-type?
  [ctx : tc_core.TcContext]
  [scrut-ty : ast.AstType]
  [name : i64]) : bool
  (let
    [pattern-name : String (tc_core.tc-env-key-name-text name)]
    (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))
      [(Struct struct-name)
        (tc_core.tc-struct-pattern-name-matches?
          ctx
          (tc_core.tc-nominal-name-id-display struct-name)
          pattern-name
          name)]
      [(StructArgs struct-name _)
        (tc_core.tc-struct-pattern-name-matches?
          ctx
          (tc_core.tc-nominal-name-id-display struct-name)
          pattern-name
          name)]
      [_ false])))

(define (lower-bind-struct-field-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [field-name : String]
  [pattern : ast.AstPattern]
  [field-ty : ast.AstType]) : ResultLowerEnv
  (match pattern
    [(Wildcard) (Ok state env type-env)]
    [(Var name _)
      (let
        [lowered
          (try
            (lower-struct-get-named
              ctx
              state
              base
              struct-id
              struct-name
              field-name
              (lower-global-shared-view field-ty)))]
        (match lowered
          [(Expr field-state field-value _)
            (match field-value
              [(Var field-var)
                (Ok
                  field-state
                  (sym_i64_env.sym-i64-bind-id env name field-var)
                  (tc_core.tc-bind-id type-env name field-ty))]
              [_
                (Err
                  (box
                    (lower-diagnostic
                      "lower: internal struct field pattern load failed")))])]))]
    [(Binding name)
      (let
        [lowered
          (try
            (lower-struct-get-named
              ctx
              state
              base
              struct-id
              struct-name
              field-name
              (lower-global-shared-view field-ty)))]
        (match lowered
          [(Expr field-state field-value _)
            (match field-value
              [(Var field-var)
                (Ok
                  field-state
                  (sym_i64_env.sym-i64-bind-id env name field-var)
                  (tc_core.tc-bind-id type-env name field-ty))]
              [_
                (Err
                  (box
                    (lower-diagnostic
                      "lower: internal struct field pattern load failed")))])]))]
    [(Tuple patterns-box)
      (let
        [lowered
          (try
            (lower-struct-get-named
              ctx
              state
              base
              struct-id
              struct-name
              field-name
              (lower-global-shared-view field-ty)))]
        (match lowered
          [(Expr field-state field-value _)
            (lower-bind-tuple-pattern
              ctx
              field-state
              env
              type-env
              (Owned)
              field-value
              field-ty
              (deref patterns-box))]))]
    [(Array patterns-box)
      (let
        [lowered
          (try
            (lower-struct-get-named
              ctx
              state
              base
              struct-id
              struct-name
              field-name
              (lower-global-shared-view field-ty)))]
        (match lowered
          [(Expr field-state field-value _)
            (lower-bind-array-pattern
              ctx
              field-state
              env
              type-env
              (Owned)
              field-value
              field-ty
              (deref patterns-box))]))]
    [(Variant name args-box)
      (if (lower-struct-pattern-for-type?
        ctx
        (lower-global-shared-view field-ty)
        name)
        (let
          [lowered
            (try
              (lower-struct-get-named
                ctx
                state
                base
                struct-id
                struct-name
                field-name
                (lower-global-shared-view field-ty)))]
          (match lowered
            [(Expr field-state field-value _)
              (lower-bind-struct-pattern
                ctx
                field-state
                env
                type-env
                field-value
                (lower-global-shared-view field-ty)
                (lower-struct-type-name-or-empty
                  (tc_core.tc-type-strip-region
                    (tc_core.tc-resolve-type ctx field-ty)))
                (deref args-box))]))
        (Err (box (lower-diagnostic "lower: unsupported struct field pattern"))))]
    [_ (Err (box (lower-diagnostic "lower: unsupported struct field pattern")))]))

(define (lower-bind-struct-pattern-fields
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [patterns : ast.AstPatternList]
  [fields : ast.AstFieldDefList]
  [types : ast.AstTypeList]) : ResultLowerEnv
  (lower-bind-struct-pattern-fields-at
    ctx
    state
    env
    type-env
    base
    struct-id
    struct-name
    patterns
    (& fields)
    0
    types))

(define (lower-bind-struct-pattern-fields-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [patterns : ast.AstPatternList]
  [fields : (& fields ast.AstFieldDefList)]
  [field-index : i64]
  [types : ast.AstTypeList]) : ResultLowerEnv
  (if (ast.ast-pattern-list-empty? (& patterns))
    (if (>= field-index (ast.ast-type-list-len (& types)))
      (Ok state env type-env)
      (Err (box (lower-diagnostic "lower: struct pattern arity mismatch"))))
    (let
      [pattern : ast.AstPattern
        (ast.ast-pattern-list-get (& patterns) 0 (ast.ast-pattern-fallback))]
      [rest-patterns : ast.AstPatternList (ast.ast-pattern-list-tail patterns)]
      (if (or
        (>= field-index (ast.ast-field-def-list-len fields))
        (>= field-index (ast.ast-type-list-len (& types))))
        (Err (box (lower-diagnostic "lower: struct pattern arity mismatch")))
        (match (ast.ast-field-def-list-get
          fields
          field-index
          (ast.ast-field-def-fallback))
          [(Def field-name _ _)
            (let
              [ty : ast.AstType
                (tc_core.tc-context-type-get
                  ctx
                  (ast.ast-type-list-get
                    (& types)
                    field-index
                    (ast.ast-type-id-fallback)))]
              (match (lower-bind-struct-field-pattern
                ctx
                state
                env
                type-env
                (lower-global-shared-view base)
                struct-id
                (lower-global-shared-view struct-name)
                (tc_core.tc-env-key-name-text
                  (ci.intern-syntax-id-value field-name))
                pattern
                ty)
                [(Ok next-state next-env next-type-env)
                  (lower-bind-struct-pattern-fields-at
                    ctx
                    next-state
                    next-env
                    next-type-env
                    base
                    struct-id
                    struct-name
                    rest-patterns
                    fields
                    (+ field-index 1)
                    types)]
                [(Err message) (Err message)]))])))))

(define (lower-bind-struct-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [base : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [struct-name : String]
  [args : ast.AstPatternList]) : ResultLowerEnv
  (match (lower-struct-fields-id
    ctx
    (lower-struct-type-name-id-or scrut-ty -1)
    (lower-global-shared-view struct-name))
    [(Ok fields)
      (match (tc_core.tc-struct-pattern-field-types-for-scrut
        ctx
        (lower-struct-type-name-id-or scrut-ty -1)
        (lower-global-shared-view scrut-ty)
        (lower-global-shared-view fields))
        [(Ok field-types)
          (lower-bind-struct-pattern-fields
            ctx
            state
            env
            type-env
            base
            (lower-struct-type-name-id-or scrut-ty -1)
            struct-name
            args
            fields
            field-types)]
        [(Err message) (Err (box (lower-diagnostic message)))])]
    [(Err message) (Err (box (lower-diagnostic message)))]))

;; Binds one tuple, fixed-array or struct element: `value` is the element's
;; loaded value when owned, and its address when borrowed.
(define (lower-bind-element-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bind-mode : LowerBindMode]
  [value : ir.CompilerIrValue]
  [pattern : ast.AstPattern]
  [elem-ty : ast.AstType]) : ResultLowerEnv
  (match pattern
    [(Wildcard) (Ok state env type-env)]
    [(Binding name)
      (lower-bind-element-name
        ctx
        state
        env
        type-env
        bind-mode
        value
        name
        elem-ty)]
    [(Var name _)
      (lower-bind-element-name
        ctx
        state
        env
        type-env
        bind-mode
        value
        name
        elem-ty)]
    [(Tuple patterns-box)
      (lower-bind-tuple-pattern
        ctx
        state
        env
        type-env
        bind-mode
        value
        elem-ty
        (deref patterns-box))]
    [(Array patterns-box)
      (lower-bind-array-pattern
        ctx
        state
        env
        type-env
        bind-mode
        value
        elem-ty
        (deref patterns-box))]
    [(Variant name args-box)
      (match bind-mode
        [(Owned)
          (if (lower-box-pattern-for-type?
            ctx
            (lower-global-shared-view elem-ty)
            name)
            (lower-bind-box-pattern
              ctx
              state
              env
              type-env
              value
              elem-ty
              (deref args-box))
            (if (lower-struct-pattern-for-type?
              ctx
              (lower-global-shared-view elem-ty)
              name)
              (lower-bind-struct-pattern
                ctx
                state
                env
                type-env
                value
                (lower-global-shared-view elem-ty)
                (lower-struct-type-name-or-empty
                  (tc_core.tc-type-strip-region
                    (tc_core.tc-resolve-type ctx elem-ty)))
                (deref args-box))
              (Err
                (box
                  (lower-diagnostic "lower: unsupported tuple element pattern")))))]
        [(Borrowed borrow-lifetime)
          (if (lower-struct-pattern-for-type?
            ctx
            (lower-global-shared-view elem-ty)
            name)
            (lower-bind-borrowed-struct-pattern
              ctx
              state
              env
              type-env
              borrow-lifetime
              value
              (lower-global-shared-view elem-ty)
              (lower-struct-type-name-or-empty
                (tc_core.tc-type-strip-region
                  (tc_core.tc-resolve-type ctx elem-ty)))
              (deref args-box))
            (Err
              (box
                (lower-diagnostic
                  "lower: unsupported borrowed tuple element pattern"))))])]
    [_
      (Err
        (box
          (lower-diagnostic
            (match bind-mode
              [(Owned) "lower: unsupported tuple element pattern"]
              [(Borrowed _) "lower: unsupported borrowed tuple element pattern"]))))]))

(define (lower-bind-element-name
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bind-mode : LowerBindMode]
  [value : ir.CompilerIrValue]
  [name : i64]
  [elem-ty : ast.AstType]) : ResultLowerEnv
  (match value
    [(Var value-var)
      (let
        [bound-ty : ast.AstType
          (lower-bind-mode-ref-type ctx bind-mode elem-ty)]
        (Ok
          state
          (sym_i64_env.sym-i64-bind-id env name value-var)
          (tc_core.tc-bind-id type-env name bound-ty)))]
    [_
      (Err
        (box
          (lower-diagnostic
            (match bind-mode
              [(Owned) "lower: internal tuple element pattern load failed"]
              [(Borrowed _)
                "lower: internal borrowed tuple element address failed"]))))]))

;; An element's access for binding its pattern: the loaded value when owned; when
;; borrowed, `lower-borrowed-binding-expr` for a name binding and the address
;; for a nested pattern.
(define (lower-bind-element-access
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [bind-mode : LowerBindMode]
  [base : ir.CompilerIrValue]
  [offset : i64]
  [pattern : ast.AstPattern]
  [elem-ty : ast.AstType]) : LowerExpr
  (match bind-mode
    [(LowerBindMode.Owned)
      (lower-load-inline-value-at-offset ctx state base offset elem-ty)]
    [(LowerBindMode.Borrowed _)
      (if (match pattern
        [(ast.AstPattern.Binding _) true]
        [(ast.AstPattern.Var _ _) true]
        [_ false])
        (lower-borrowed-binding-expr
          ctx
          state
          base
          offset
          (lower-global-shared-view elem-ty)
          (lower-bind-mode-ref-type ctx bind-mode elem-ty))
        (lower-gep-byte state base offset))]))

;; The type a name bound to an element gets: the element type when owned, and
;; `tc-borrowed-binding-type` when borrowed.
(define (lower-bind-mode-ref-type
  [ctx : tc_core.TcContext]
  [bind-mode : LowerBindMode]
  [elem-ty : ast.AstType]) : ast.AstType
  (match bind-mode
    [(LowerBindMode.Owned) elem-ty]
    [(LowerBindMode.Borrowed borrow-lifetime)
      (tc_core.tc-borrowed-binding-type ctx borrow-lifetime elem-ty)]))

(define (lower-bind-tuple-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bind-mode : LowerBindMode]
  [base : ir.CompilerIrValue]
  [tuple-ty : ast.AstType]
  [patterns : ast.AstPatternList]) : ResultLowerEnv
  (match (tc_core.tc-tuple-pattern-element-types ctx tuple-ty)
    [(Ok elem-types)
      (lower-bind-tuple-pattern-at
        ctx
        state
        env
        type-env
        bind-mode
        base
        (& patterns)
        (& elem-types)
        0
        0)]
    [(Err message) (Err (box (lower-diagnostic message)))]))

(define (lower-bind-tuple-pattern-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bind-mode : LowerBindMode]
  [base : ir.CompilerIrValue]
  [patterns : (& patterns ast.AstPatternList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [cursor : i64]) : ResultLowerEnv
  (if (>= index (ast.ast-pattern-list-len patterns))
    (if (>= index (ast.ast-type-list-len types))
      (Ok state env type-env)
      (Err (box (lower-diagnostic "lower: tuple pattern arity mismatch"))))
    (if (>= index (ast.ast-type-list-len types))
      (Err (box (lower-diagnostic "lower: tuple pattern arity mismatch")))
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))]
        [elem-ty : ast.AstType
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        [resolved : ast.AstType
          (tc_core.tc-resolve-type ctx (lower-global-shared-view elem-ty))]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx resolved))]
        [next-cursor : i64 (+ offset (lower-type-size ctx resolved))]
        (if (match (lower-global-shared-view pattern)
          [(Wildcard) true]
          [_ false])
          (lower-bind-tuple-pattern-at
            ctx
            state
            env
            type-env
            bind-mode
            base
            patterns
            types
            (+ index 1)
            next-cursor)
          (match (lower-bind-element-access
            ctx
            state
            bind-mode
            (lower-global-shared-view base)
            offset
            (lower-global-shared-view pattern)
            (lower-global-shared-view elem-ty))
            [(Expr elem-state elem-value _)
              (match (lower-bind-element-pattern
                ctx
                elem-state
                env
                type-env
                bind-mode
                elem-value
                pattern
                elem-ty)
                [(Ok next-state next-env next-type-env)
                  (lower-bind-tuple-pattern-at
                    ctx
                    next-state
                    next-env
                    next-type-env
                    bind-mode
                    base
                    patterns
                    types
                    (+ index 1)
                    next-cursor)]
                [(Err message) (Err message)])]))))))

(define (lower-bind-array-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bind-mode : LowerBindMode]
  [base : ir.CompilerIrValue]
  [array-ty : ast.AstType]
  [patterns : ast.AstPatternList]) : ResultLowerEnv
  (match (tc_core.tc-array-pattern-info ctx array-ty)
    [(Ok elem-ty count)
      (lower-bind-array-pattern-at
        ctx
        state
        env
        type-env
        bind-mode
        base
        (& patterns)
        elem-ty
        count
        0)]
    [(Err message) (Err (box (lower-diagnostic message)))]))

(define (lower-bind-array-pattern-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [bind-mode : LowerBindMode]
  [base : ir.CompilerIrValue]
  [patterns : (& patterns ast.AstPatternList)]
  [elem-ty : ast.AstType]
  [count : i64]
  [index : i64]) : ResultLowerEnv
  (if (>= index (ast.ast-pattern-list-len patterns))
    (if (>= index count)
      (Ok state env type-env)
      (Err (box (lower-diagnostic "lower: fixed-array pattern arity mismatch"))))
    (if (>= index count)
      (Err (box (lower-diagnostic "lower: fixed-array pattern arity mismatch")))
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))]
        [resolved : ast.AstType
          (tc_core.tc-resolve-type ctx (lower-global-shared-view elem-ty))]
        [offset : i64 (* index (lower-type-size ctx resolved))]
        (if (match (lower-global-shared-view pattern)
          [(Wildcard) true]
          [_ false])
          (lower-bind-array-pattern-at
            ctx
            state
            env
            type-env
            bind-mode
            base
            patterns
            elem-ty
            count
            (+ index 1))
          (match (lower-bind-element-access
            ctx
            state
            bind-mode
            (lower-global-shared-view base)
            offset
            (lower-global-shared-view pattern)
            (lower-global-shared-view elem-ty))
            [(Expr elem-state elem-value _)
              (match (lower-bind-element-pattern
                ctx
                elem-state
                env
                type-env
                bind-mode
                elem-value
                pattern
                (lower-global-shared-view elem-ty))
                [(Ok next-state next-env next-type-env)
                  (lower-bind-array-pattern-at
                    ctx
                    next-state
                    next-env
                    next-type-env
                    bind-mode
                    base
                    patterns
                    elem-ty
                    count
                    (+ index 1))]
                [(Err message) (Err message)])]))))))

(define (lower-bind-borrowed-struct-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [borrow-lifetime : i64]
  [base : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]
  [struct-name : String]
  [patterns : ast.AstPatternList]) : ResultLowerEnv
  (match (lower-struct-fields-id
    ctx
    (lower-struct-type-name-id-or scrut-ty -1)
    (lower-global-shared-view struct-name))
    [(Ok fields)
      (match (tc_core.tc-struct-pattern-field-types-for-scrut
        ctx
        (lower-struct-type-name-id-or scrut-ty -1)
        (lower-global-shared-view scrut-ty)
        (lower-global-shared-view fields))
        [(Ok field-types)
          (lower-bind-borrowed-struct-pattern-at
            ctx
            state
            env
            type-env
            borrow-lifetime
            base
            (lower-struct-type-name-id-or scrut-ty -1)
            struct-name
            (& patterns)
            (& fields)
            (& field-types)
            0)]
        [(Err message) (Err (box (lower-diagnostic message)))])]
    [(Err message) (Err (box (lower-diagnostic message)))]))

(define (lower-bind-borrowed-struct-pattern-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [borrow-lifetime : i64]
  [base : ir.CompilerIrValue]
  [struct-id : i64]
  [struct-name : String]
  [patterns : (& patterns ast.AstPatternList)]
  [fields : (& fields ast.AstFieldDefList)]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ResultLowerEnv
  (if (>= index (ast.ast-pattern-list-len patterns))
    (if (>= index (ast.ast-type-list-len types))
      (Ok state env type-env)
      (Err (box (lower-diagnostic "lower: struct pattern arity mismatch"))))
    (if (or
      (>= index (ast.ast-field-def-list-len fields))
      (>= index (ast.ast-type-list-len types)))
      (Err (box (lower-diagnostic "lower: struct pattern arity mismatch")))
      (let
        [pattern : ast.AstPattern
          (ast.ast-pattern-list-get patterns index (ast.ast-pattern-fallback))]
        [field-ty : ast.AstType
          (tc_core.tc-context-type-get
            ctx
            (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
        (match (ast.ast-field-def-list-get
          fields
          index
          (ast.ast-field-def-fallback))
          [(Def field-name _ _)
            (let
              [info
                (try
                  (lower-struct-field-info
                    ctx
                    struct-id
                    (lower-global-shared-view struct-name)
                    (tc_core.tc-env-key-name-text
                      (ci.intern-syntax-id-value field-name))))]
              (match info
                [(Info offset _)
                  (if (match (lower-global-shared-view pattern)
                    [(Wildcard) true]
                    [_ false])
                    (lower-bind-borrowed-struct-pattern-at
                      ctx
                      state
                      env
                      type-env
                      borrow-lifetime
                      base
                      struct-id
                      struct-name
                      patterns
                      fields
                      types
                      (+ index 1))
                    (match (lower-bind-element-access
                      ctx
                      state
                      (Borrowed borrow-lifetime)
                      (lower-global-shared-view base)
                      offset
                      (lower-global-shared-view pattern)
                      (lower-global-shared-view field-ty))
                      [(Expr address-state address _)
                        (match (lower-bind-element-pattern
                          ctx
                          address-state
                          env
                          type-env
                          (Borrowed borrow-lifetime)
                          address
                          pattern
                          field-ty)
                          [(Ok next-state next-env next-type-env)
                            (lower-bind-borrowed-struct-pattern-at
                              ctx
                              next-state
                              next-env
                              next-type-env
                              borrow-lifetime
                              base
                              struct-id
                              struct-name
                              patterns
                              fields
                              types
                              (+ index 1))]
                          [(Err message) (Err message)])]))]))])))))

(define (lower-bind-match-catch-all-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [pattern : ast.AstPattern]) : ResultLowerEnv
  (match pattern
    [(Binding name)
      (Ok
        state
        (sym_i64_env.sym-i64-bind-id env name scrut-var)
        (tc_core.tc-bind-id type-env name scrut-ty))]
    [(Tuple patterns-box)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (lower-global-shared-view scrut-ty)))
        [(Tuple _)
          (lower-bind-tuple-pattern
            ctx
            state
            env
            type-env
            (Owned)
            (Var scrut-var)
            scrut-ty
            (deref patterns-box))]
        [(Ref borrow-lifetime referent-box)
          (let
            [referent-ty : ast.AstType
              (tc_core.tc-context-type-get ctx referent-box)]
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type
                ctx
                (lower-global-shared-view referent-ty)))
              [(Tuple _)
                (lower-bind-tuple-pattern
                  ctx
                  state
                  env
                  type-env
                  (Borrowed borrow-lifetime)
                  (Var scrut-var)
                  referent-ty
                  (deref patterns-box))]
              [_
                (Err
                  (box
                    (lower-diagnostic
                      "lower: tuple pattern requires Tuple scrutinee")))]))]
        [_
          (Err
            (box
              (lower-diagnostic "lower: tuple pattern requires Tuple scrutinee")))])]
    [(Array patterns-box)
      (match (tc_core.tc-type-strip-region
        (tc_core.tc-resolve-type ctx (lower-global-shared-view scrut-ty)))
        [(Array _ _)
          (lower-bind-array-pattern
            ctx
            state
            env
            type-env
            (Owned)
            (Var scrut-var)
            scrut-ty
            (deref patterns-box))]
        [(Ref borrow-lifetime referent-box)
          (let
            [referent-ty : ast.AstType
              (tc_core.tc-context-type-get ctx referent-box)]
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type
                ctx
                (lower-global-shared-view referent-ty)))
              [(Array _ _)
                (lower-bind-array-pattern
                  ctx
                  state
                  env
                  type-env
                  (Borrowed borrow-lifetime)
                  (Var scrut-var)
                  referent-ty
                  (deref patterns-box))]
              [_
                (Err
                  (box
                    (lower-diagnostic
                      "lower: array pattern requires fixed Array scrutinee")))]))]
        [_
          (Err
            (box
              (lower-diagnostic
                "lower: array pattern requires fixed Array scrutinee")))])]
    [(Variant name args-box)
      (if (lower-box-pattern-for-type?
        ctx
        (lower-global-shared-view scrut-ty)
        name)
        (lower-bind-box-pattern
          ctx
          state
          env
          type-env
          (Var scrut-var)
          scrut-ty
          (deref args-box))
        (if (lower-struct-pattern-for-type?
          ctx
          (lower-global-shared-view scrut-ty)
          name)
          (lower-bind-struct-pattern
            ctx
            state
            env
            type-env
            (Var scrut-var)
            (lower-global-shared-view scrut-ty)
            (lower-struct-type-name-or-empty
              (tc_core.tc-type-strip-region
                (tc_core.tc-resolve-type ctx scrut-ty)))
            (deref args-box))
          (Err (box (lower-diagnostic "lower: unsupported match pattern")))))]
    [_ (Ok state env type-env)]))

;; The switch-form pass is deliberately the only place that may materialize
;; the final enum tag and unreachable default. Lowering keeps the classic
;; fallthrough instruction shape. Once exactly four explicit comparisons
;; remain, their false-edge suffix carries TotalEnumBranch proof. Keeping the
;; proof on only this terminal suffix matters because switch formation may
;; split a long comparison chain: an earlier chunk's default still has more
;; enum tags to test and must remain checked. Label spellings are display-only
;; and stay fixed for byte-stable IR/assembly.
(define (lower-total-enum-switch-rest-explicit-from?
  [arms : (& arms ast.AstMatchArmList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-match-arm-list-len arms))
    true
    (match (ast.ast-match-arm-list-get arms index (ast.ast-match-arm-fallback))
      [(Arm pat _)
        (match pat
          [(Binding _)
            (lower-total-enum-switch-rest-explicit-from? arms (+ index 1))]
          [(Variant _ _)
            (lower-total-enum-switch-rest-explicit-from? arms (+ index 1))]
          [_ false])])))

(define (lower-total-enum-switch-next?
  [total-enum-switch? : bool]
  [rest : (& rest ast.AstMatchArmList)]) : bool
  (or
    total-enum-switch?
    (and
      (= (ast.ast-match-arm-list-len rest) 4)
      (lower-total-enum-switch-rest-explicit-from? rest 0))))

(define (lower-enum-match-next-label-base
  [total-enum-switch? : bool]
  [rest : (& rest ast.AstMatchArmList)]) : String
  ;; Keep the diagnostic spellings without consulting them for
  ;; semantics. The explicit proof is threaded only through this match's
  ;; outer compare chain and cannot leak into a nested arm body.
  (let
    [remaining : i64 (ast.ast-match-arm-list-len (& rest))]
    (if (and total-enum-switch? (<= remaining 4))
      (if (= remaining 1)
        "match_total_enum_default"
        "match_total_enum_chain")
      "match_next")))

(define (lower-phi-input-seq-empty? [phi-inputs : ir.CompilerIrPhiInputSeq]) : bool
  (let
    [phi-inputs-at-71745-3 : ir.CompilerIrPhiInputSeq phi-inputs]
    (if (<= phi-inputs-at-71745-3.len 0)
      true
      false)))

(define (lower-match-finish
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [merge-label : i64]
  [expr-ty : ast.AstType]
  [phi-inputs : ir.CompilerIrPhiInputSeq]) : ResultLowerExpr
  (let
    [merge-start : LowerState (lower-state-finish-block state merge-label)]
    [expr-ir-ty : ast.AstType
      (lower-one-word-register-storage-type ctx expr-ty)]
    (if (lower-phi-input-seq-empty? (lower-global-shared-view phi-inputs))
      (Ok (Expr merge-start Unit (Never)))
      (match (lower-global-shared-view expr-ty)
        [(Unit) (Ok (Expr merge-start Unit expr-ty))]
        [_
          (match (lower-state-alloc-var merge-start)
            [(Alloc allocated var-id)
              (Ok
                (Expr
                  (lower-state-emit
                    allocated
                    (Phi var-id phi-inputs expr-ir-ty))
                  (Var var-id)
                  expr-ty))])]))))

(define (lower-tail-call-var-unshadowed?
  [env : sym_i64_env.SymI64Env]
  [name : i64]) : bool
  (not (sym_i64_env.sym-i64-contains-id env name)))

(define (lower-tail-call-local-indirect-safe?
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]) : bool
  (if (sym_i64_env.sym-i64-contains-id env name)
    (not (lower-type-env-contains-reference? type-env))
    true))

;; How a match arm's body continues. A value match (`lower-match-value`) jumps
;; from each arm to `merge-label` and feeds its result to the merge phi, whose
;; inputs accumulate arm by arm; a tail match (`lower-tail-match`) returns from
;; the function in every arm. One arm walker serves both.
(defenum LowerMatchCont
  (Value i64 ast.AstType ir.CompilerIrPhiInputSeq)
  (Tail ast.AstType i64))

(defenum ResultLowerMatchArm
  (Ok LowerState LowerMatchCont)
  (Err (Box cdiag.CompilerDiagnostic)))

(define (lower-match-cont-tail? [cont : LowerMatchCont]) : bool
  (match cont
    [(Value _ _ _) false]
    [(Tail _ _) true]))

;; Lower one arm body. A value arm that does not diverge jumps to the merge
;; block and records its result as a phi input; a tail arm returns. The
;; returned state is still inside the arm's last block.
(define (lower-match-arm-body
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [body : ast.AstExpr]
  [cont : LowerMatchCont]) : ResultLowerMatchArm
  (match cont
    [(Value merge-label expr-ty phi-inputs)
      (let
        [body-lowered
          (try
            (lower-expr-expected
              ctx
              state
              env
              type-env
              (lower-global-shared-view body)
              (lower-global-shared-view expr-ty)
              body))]
        (match body-lowered
          [(Expr body-state body-value body-ty)
            (let
              [body-end-label : i64 (lower-state-current-label body-state)]
              (if (tc_core.tc-never-type? body-ty)
                (Ok body-state (Value merge-label expr-ty phi-inputs))
                (Ok
                  (lower-state-emit body-state (Jump merge-label))
                  (Value
                    merge-label
                    expr-ty
                    (ir.compiler-ir-phi-input-seq-prepend
                      body-value
                      body-end-label
                      phi-inputs)))))]))]
    [(Tail ret-ty sret-var)
      (let
        [body-state
          (try
            (lower-tail-expr
              ctx
              state
              env
              type-env
              body
              (lower-global-shared-view ret-ty)
              sret-var))]
        (Ok body-state (Tail ret-ty sret-var)))]))

;; Lower the last arm's body and close the match: a value match builds its
;; merge block and phi; a tail match has already returned.
(define (lower-match-arm-final
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [body : ast.AstExpr]
  [cont : LowerMatchCont]) : ResultLowerExpr
  (match (lower-match-arm-body ctx state env type-env body cont)
    [(Ok body-state next-cont)
      (match next-cont
        [(Value merge-label expr-ty phi-inputs)
          (lower-match-finish ctx body-state merge-label expr-ty phi-inputs)]
        [(Tail _ _) (Ok (Expr body-state Unit (Never)))])]
    [(Err message) (Err message)]))

(define (lower-match-tail-result [result : ResultLowerExpr]) : ResultLowerState
  (let
    [lowered : LowerExpr (try result)]
    (match lowered
      [(Expr tail-state _ _) (Ok tail-state)])))

;; Dispatch a lowered scrutinee: enums (directly, through a shared reference,
;; or generic) match by tag, everything else by the scalar compare chain.
(define (lower-match-dispatch
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [cont : LowerMatchCont]) : ResultLowerExpr
  (match (tc_core.tc-type-strip-region
    (tc_core.tc-resolve-type ctx (lower-global-shared-view scrut-ty)))
    [(Enum _)
      (lower-match-enum
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arms
        cont
        (No)
        false)]
    [(EnumArgs _ _)
      (lower-match-enum
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arms
        cont
        (No)
        false)]
    [(Ref borrow-lifetime referent-box)
      (let
        [referent-ty : ast.AstType
          (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type
              ctx
              (tc_core.tc-context-type-get ctx referent-box)))]
        (match (lower-global-shared-view referent-ty)
          [(Enum _)
            (lower-match-enum
              ctx
              state
              env
              type-env
              scrut-var
              referent-ty
              arms
              cont
              (Some borrow-lifetime)
              true)]
          [(EnumArgs _ _)
            (lower-match-enum
              ctx
              state
              env
              type-env
              scrut-var
              referent-ty
              arms
              cont
              (Some borrow-lifetime)
              true)]
          [_
            (lower-match-arms
              ctx
              state
              env
              type-env
              scrut-var
              scrut-ty
              arms
              cont)]))]
    [(VarArgs _ _)
      (lower-match-enum
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        arms
        cont
        (No)
        false)]
    [_ (lower-match-arms ctx state env type-env scrut-var scrut-ty arms cont)]))

(define (lower-match-arms
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [cont : LowerMatchCont]) : ResultLowerExpr
  (if (ast.ast-match-arm-list-empty? (& arms))
    (Err (box (lower-diagnostic "lower: match with no arms")))
    (let
      [arm : ast.AstMatchArm
        (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback))]
      [rest : ast.AstMatchArmList (ast.ast-match-arm-list-tail arms)]
      (if (ast.ast-match-arm-list-empty? (& rest))
        (lower-match-catch-all
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          arm
          cont)
        (match (lower-global-shared-view arm)
          [(Arm pat body-box)
            (let
              [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
              (match pat
                [(Literal lit)
                  (lower-match-literal-arm
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    lit
                    body
                    rest
                    cont)]
                [(Binding _)
                  (lower-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    cont)]
                [(Wildcard)
                  (lower-match-catch-all
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    arm
                    cont)]
                ;; A tuple or array pattern before the last arm is a catch-all
                ;; in value position; tail position does not accept one.
                [(Tuple _)
                  (if (lower-match-cont-tail? (lower-global-shared-view cont))
                    (Err
                      (box
                        (lower-diagnostic "lower: unsupported match pattern")))
                    (lower-match-catch-all
                      ctx
                      state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arm
                      cont))]
                [(Array _)
                  (if (lower-match-cont-tail? (lower-global-shared-view cont))
                    (Err
                      (box
                        (lower-diagnostic "lower: unsupported match pattern")))
                    (lower-match-catch-all
                      ctx
                      state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arm
                      cont))]
                [(Slice items-box has-rest)
                  (lower-match-slice-arm
                    ctx
                    state
                    env
                    type-env
                    scrut-var
                    scrut-ty
                    (deref items-box)
                    has-rest
                    body
                    rest
                    cont)]
                [(Variant variant-name _)
                  (if (lower-box-pattern-for-type?
                    ctx
                    (lower-global-shared-view scrut-ty)
                    variant-name)
                    (lower-match-catch-all
                      ctx
                      state
                      env
                      type-env
                      scrut-var
                      scrut-ty
                      arm
                      cont)
                    (if (lower-struct-pattern-for-type?
                      ctx
                      (lower-global-shared-view scrut-ty)
                      variant-name)
                      (lower-match-catch-all
                        ctx
                        state
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        arm
                        cont)
                      (Err
                        (box
                          (lower-diagnostic
                            (if (lower-match-cont-tail? cont)
                              "lower: unsupported match pattern"
                              (lower-unsupported-match-pattern-message
                                ctx
                                scrut-ty
                                (tc_core.tc-env-key-name-text variant-name))))))))]
                [_
                  (Err
                    (box (lower-diagnostic "lower: unsupported match pattern")))]))])))))

(define (lower-match-literal-arm
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [lit : ast.AstLiteral]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]
  [cont : LowerMatchCont]) : ResultLowerExpr
  (match (lower-state-alloc-var state)
    [(Alloc eq-alloc eq-var)
      (let
        [eq-state : LowerState
          (lower-state-emit
            eq-alloc
            (BinOp
              eq-var
              Eq
              (Var scrut-var)
              (lower-literal-value-with-type
                (tc_core.tc-context-source-names ctx)
                lit
                (lower-global-shared-view scrut-ty))
              (lower-global-shared-view scrut-ty)))]
        (match (lower-state-fresh-label eq-state "match_arm")
          [(Label body-label-state body-label)
            (match (lower-state-fresh-label body-label-state "match_next")
              [(Label next-label-state next-label)
                (let
                  [body-start : LowerState
                    (lower-state-finish-block
                      (lower-state-emit
                        next-label-state
                        (Branch (Var eq-var) body-label next-label))
                      body-label)]
                  (match (lower-match-arm-body
                    ctx
                    body-start
                    env
                    type-env
                    body
                    cont)
                    [(Ok body-state next-cont)
                      (lower-match-arms
                        ctx
                        (lower-state-finish-block body-state next-label)
                        env
                        type-env
                        scrut-var
                        scrut-ty
                        rest
                        next-cont)]
                    [(Err message) (Err message)]))])]))]))

;; A slice arm before the last: its length and element tests fall through to
;; the next arm.
(define (lower-match-slice-arm
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [items : ast.AstPatternList]
  [has-rest : bool]
  [body : ast.AstExpr]
  [rest : ast.AstMatchArmList]
  [cont : LowerMatchCont]) : ResultLowerExpr
  (match (lower-state-fresh-label state "match_next")
    [(Label next-label-state next-label)
      (match (lower-bind-slice-pattern
        ctx
        next-label-state
        env
        type-env
        (Var scrut-var)
        (lower-global-shared-view scrut-ty)
        items
        has-rest
        (lower-state-mode next-label-state)
        next-label
        true)
        [(Ok body-start body-env body-type-env)
          (match (lower-match-arm-body
            ctx
            body-start
            body-env
            body-type-env
            body
            cont)
            [(Ok body-state next-cont)
              (lower-match-arms
                ctx
                (lower-state-finish-block body-state next-label)
                env
                type-env
                scrut-var
                scrut-ty
                rest
                next-cont)]
            [(Err message) (Err message)])]
        [(Err message) (Err message)])]))

;; The last arm of an exhaustive slice match binds without its length test.
;; Like a final enum arm, it has no next arm to fall through to, so its element
;; patterns must be irrefutable.
(define (lower-bind-final-slice-arm
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [items : ast.AstPatternList]
  [has-rest : bool]
  [cont : LowerMatchCont]) : ResultLowerEnv
  (match (tc_core.tc-slice-pattern-scrutinee
    ctx
    (lower-global-shared-view scrut-ty))
    [(View _ _ elem-ty _)
      (if (tc_core.tc-slice-pattern-elements-irrefutable?
        ctx
        (& items)
        (tc_core.tc-slice-pattern-element-count (& items) has-rest)
        elem-ty)
        (lower-bind-slice-pattern
          ctx
          state
          env
          type-env
          (Var scrut-var)
          scrut-ty
          items
          has-rest
          (lower-state-mode state)
          (match cont
            [(Value merge-label _ _) merge-label]
            [(Tail _ _) (lower-state-current-label state)])
          false)
        (Err
          (box
            (lower-diagnostic
              "lower: refutable slice element pattern in final match arm requires a trailing catch-all"))))]
    [(Invalid)
      (Err
        (box
          (lower-diagnostic
            "lower: slice pattern requires a borrowed Slice or fixed-array scrutinee")))]))

(define (lower-match-catch-all
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arm : ast.AstMatchArm]
  [cont : LowerMatchCont]) : ResultLowerExpr
  (match arm
    [(Arm pat body-box)
      (let
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (match (match (lower-global-shared-view pat)
          [(Slice items-box has-rest)
            (lower-bind-final-slice-arm
              ctx
              state
              env
              type-env
              scrut-var
              (lower-global-shared-view scrut-ty)
              (deref items-box)
              has-rest
              (lower-global-shared-view cont))]
          [_
            (lower-bind-match-catch-all-pattern
              ctx
              state
              env
              type-env
              scrut-var
              scrut-ty
              pat)])
          [(Ok body-start body-env body-type-env)
            (lower-match-arm-final
              ctx
              body-start
              body-env
              body-type-env
              body
              cont)]
          [(Err message) (Err message)]))]))

(define (lower-match-enum
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arms : ast.AstMatchArmList]
  [cont : LowerMatchCont]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [force-memory : bool]) : ResultLowerExpr
  ;; A 1-word register-resident enum value IS the tag word (nullary, no
  ;; payload); match on `scrut-var` directly. A 2-word register-group enum holds
  ;; the tag in word0; extract it with CompilerIrInstr.Word. Neither touches
  ;; memory. One
  ;; layout build (lower-type-register-words) decides all three cases.
  ;; `force-memory` (borrowed match of a spilled register-resident scrutinee)
  ;; overrides the value paths: scrut-var then holds the ADDRESS of the enum
  ;; bytes and tag/payloads are read through it like any memory enum.
  (let
    [scrut-words : i64
      (lower-type-register-words ctx (lower-global-shared-view scrut-ty))]
    (if (and (> scrut-words 0) (not force-memory))
      (if (= scrut-words 2)
        (match (lower-emit-word state (Var scrut-var) 0 (I64))
          [(Expr tag-state tag-value _)
            (match tag-value
              [(Var tag-var)
                (lower-match-enum-arms
                  ctx
                  tag-state
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  tag-var
                  arms
                  cont
                  borrow-lifetime
                  true
                  false)]
              [_
                (Err
                  (box
                    (lower-diagnostic "lower: internal enum tag extract failed")))])])
        (lower-match-enum-arms
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          scrut-var
          arms
          cont
          borrow-lifetime
          false
          false))
      (match (let
        [base (ir.CompilerIrValue.Var scrut-var)]
        (lower-load-at-offset state base 0 (I64)))
        [(Expr tag-state tag-value _)
          (match tag-value
            [(Var tag-var)
              (lower-match-enum-arms
                ctx
                tag-state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arms
                cont
                borrow-lifetime
                false
                false)]
            [_
              (Err
                (box (lower-diagnostic "lower: internal enum tag load failed")))])]))))

(define (lower-match-enum-final-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [arm : ast.AstMatchArm]
  [pat : ast.AstPattern]
  [body : ast.AstExpr]
  [body-id : i64]
  [cont : LowerMatchCont]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (match pat
    [(Wildcard)
      (lower-match-catch-all ctx state env type-env scrut-var scrut-ty arm cont)]
    [(Binding variant-name)
      (lower-match-variant-final
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        variant-name
        (ast.ast-pattern-list-new)
        body
        body-id
        cont
        borrow-lifetime
        scrut-reg-group?)]
    [(Variant variant-name args-box)
      (let
        [args : ast.AstPatternList (deref args-box)]
        (lower-match-variant-final
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          variant-name
          args
          body
          body-id
          cont
          borrow-lifetime
          scrut-reg-group?))]
    [_ (Err (box (lower-diagnostic "lower: unsupported enum match pattern")))]))

(define (lower-match-enum-branch-pattern
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [arm : ast.AstMatchArm]
  [pat : ast.AstPattern]
  [body : ast.AstExpr]
  [body-id : i64]
  [rest : ast.AstMatchArmList]
  [cont : LowerMatchCont]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerExpr
  (match pat
    [(Wildcard)
      (lower-match-catch-all ctx state env type-env scrut-var scrut-ty arm cont)]
    [(Binding variant-name)
      (lower-match-variant-arm
        ctx
        state
        env
        type-env
        scrut-var
        scrut-ty
        tag-var
        variant-name
        (ast.ast-pattern-list-new)
        body
        body-id
        rest
        cont
        borrow-lifetime
        scrut-reg-group?
        total-enum-switch?)]
    [(Variant variant-name args-box)
      (let
        [args : ast.AstPatternList (deref args-box)]
        (lower-match-variant-arm
          ctx
          state
          env
          type-env
          scrut-var
          scrut-ty
          tag-var
          variant-name
          args
          body
          body-id
          rest
          cont
          borrow-lifetime
          scrut-reg-group?
          total-enum-switch?))]
    [_ (Err (box (lower-diagnostic "lower: unsupported enum match pattern")))]))

(define (lower-match-enum-arms
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [arms : ast.AstMatchArmList]
  [cont : LowerMatchCont]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerExpr
  (if (ast.ast-match-arm-list-empty? (& arms))
    (Err (box (lower-diagnostic "lower: match with no arms")))
    (let
      [arm : ast.AstMatchArm
        (ast.ast-match-arm-list-get (& arms) 0 (ast.ast-match-arm-fallback))]
      [rest : ast.AstMatchArmList (ast.ast-match-arm-list-tail arms)]
      (match (lower-global-shared-view arm)
        [(Arm pat body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (if (ast.ast-match-arm-list-empty? (& rest))
              (lower-match-enum-final-pattern
                ctx
                state
                env
                type-env
                scrut-var
                scrut-ty
                arm
                pat
                body
                body-box
                cont
                borrow-lifetime
                scrut-reg-group?)
              (lower-match-enum-branch-pattern
                ctx
                state
                env
                type-env
                scrut-var
                scrut-ty
                tag-var
                arm
                pat
                body
                body-box
                rest
                cont
                borrow-lifetime
                scrut-reg-group?
                total-enum-switch?)))]))))

(define (lower-match-variant-final
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [variant-name-id : i64]
  [args : ast.AstPatternList]
  [body : ast.AstExpr]
  [body-id : i64]
  [cont : LowerMatchCont]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]) : ResultLowerExpr
  (let
    [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols-view ctx)]
    (match (lower-variant-arm-resolution
      ctx
      (lower-state-function-state state)
      symbols
      scrut-ty
      variant-name-id)
      [(Missing variant-name)
        (Err
          (box
            (lower-diagnostic
              (str_cat.str-cat "lower: unknown variant " variant-name))))]
      [(FieldsErr message) (Err (box (lower-diagnostic message)))]
      [(Some
          variant-name
          resolved-scrut-ty
          handle
          resolved-fields
          handle-name-id)
        ;; The final arm has no next-arm continuation, so a refutable
        ;; payload subpattern here would have nowhere to fall through to;
        ;; require a trailing catch-all instead.
        (if (lower-pattern-list-refutable-for-types? ctx args resolved-fields)
          (Err
            (box
              (lower-diagnostic
                "lower: refutable payload pattern in final match arm requires a trailing catch-all")))
          (match (lower-bind-match-variant-payloads
            ctx
            state
            env
            type-env
            borrow-lifetime
            (Var scrut-var)
            args
            resolved-fields
            (lower-state-mode state)
            (lower-enum-type-name-id-or resolved-scrut-ty -1)
            (lower-enum-type-name-or-empty resolved-scrut-ty)
            variant-name
            handle-name-id
            0
            8
            (match (lower-global-shared-view cont)
              [(Value merge-label _ _) merge-label]
              [(Tail _ _) (lower-state-current-label state)])
            scrut-reg-group?
            body-id)
            [(Ok body-start body-env body-type-env)
              (lower-match-arm-final
                ctx
                body-start
                body-env
                body-type-env
                body
                cont)]
            [(Err message) (Err message)]))])))

(define (lower-match-variant-body
  [ctx : tc_core.TcContext]
  [body-start : LowerState]
  [next-label : i64]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [variant-name : String]
  [variant-name-id : i64]
  [fields : ast.AstTypeList]
  [args : ast.AstPatternList]
  [body : ast.AstExpr]
  [body-id : i64]
  [rest : ast.AstMatchArmList]
  [cont : LowerMatchCont]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerExpr
  (match (lower-bind-match-variant-payloads
    ctx
    body-start
    env
    type-env
    borrow-lifetime
    (Var scrut-var)
    args
    fields
    (lower-state-mode body-start)
    (lower-enum-type-name-id-or scrut-ty -1)
    (lower-enum-type-name-or-empty (lower-global-shared-view scrut-ty))
    variant-name
    variant-name-id
    0
    8
    next-label
    scrut-reg-group?
    body-id)
    [(Ok bound-state body-env body-type-env)
      (match (lower-match-arm-body
        ctx
        bound-state
        body-env
        body-type-env
        body
        cont)
        [(Ok body-state next-cont)
          (lower-match-enum-arms
            ctx
            (lower-state-finish-block body-state next-label)
            env
            type-env
            scrut-var
            scrut-ty
            tag-var
            rest
            next-cont
            borrow-lifetime
            scrut-reg-group?
            total-enum-switch?)]
        [(Err message) (Err message)])]
    [(Err message) (Err message)]))

(define (lower-match-variant-arm
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrut-var : i64]
  [scrut-ty : ast.AstType]
  [tag-var : i64]
  [variant-name-id : i64]
  [args : ast.AstPatternList]
  [body : ast.AstExpr]
  [body-id : i64]
  [rest : ast.AstMatchArmList]
  [cont : LowerMatchCont]
  [borrow-lifetime : tc_core.TcMaybeNameId]
  [scrut-reg-group? : bool]
  [total-enum-switch? : bool]) : ResultLowerExpr
  (let
    [symbols : csym.CompilerSymbols (tc_core.tc-context-symbols-view ctx)]
    (match (lower-variant-arm-resolution
      ctx
      (lower-state-function-state state)
      symbols
      (lower-global-shared-view scrut-ty)
      variant-name-id)
      [(Missing variant-name)
        (Err
          (box
            (lower-diagnostic
              (str_cat.str-cat "lower: unknown variant " variant-name))))]
      [(FieldsErr message) (Err (box (lower-diagnostic message)))]
      [(Some
          variant-name
          resolved-scrut-ty
          handle
          resolved-fields
          handle-name-id)
        (match (lower-state-alloc-var state)
          [(Alloc eq-alloc eq-var)
            (let
              [next-total-enum-switch? : bool
                (lower-total-enum-switch-next? total-enum-switch? (& rest))]
              [eq-state : LowerState
                (lower-state-emit
                  eq-alloc
                  (BinOp
                    eq-var
                    Eq
                    (Var tag-var)
                    (I64 (csym.compiler-registry-handle-child-index handle))
                    (I64)))]
              (match (lower-state-fresh-label eq-state "match_arm")
                [(Label body-label-state body-label)
                  (match (lower-state-fresh-label
                    body-label-state
                    (lower-enum-match-next-label-base
                      next-total-enum-switch?
                      rest))
                    [(Label next-label-state next-label)
                      (let
                        [body-start : LowerState
                          (lower-state-finish-block
                            (lower-state-emit
                              next-label-state
                              (if next-total-enum-switch?
                                (TotalEnumBranch
                                  (Var eq-var)
                                  body-label
                                  next-label)
                                (Branch (Var eq-var) body-label next-label)))
                            body-label)]
                        (lower-match-variant-body
                          ctx
                          body-start
                          next-label
                          env
                          type-env
                          scrut-var
                          scrut-ty
                          tag-var
                          variant-name
                          handle-name-id
                          resolved-fields
                          args
                          body
                          body-id
                          rest
                          cont
                          borrow-lifetime
                          scrut-reg-group?
                          next-total-enum-switch?))])]))])])))

(define (lower-tail-call-reference-capturing-lambda?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [callee : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan callee)
    [(Ann inner-box _)
      (lower-tail-call-reference-capturing-lambda?
        ctx
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(Cast inner-box _)
      (lower-tail-call-reference-capturing-lambda?
        ctx
        type-env
        (lower-context-expr-get ctx inner-box))]
    [(Lambda lambda-box)
      (match (__tl-box-place lambda-box)
        [(Lambda params _ body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (tc_core.tc-lambda-captures-reference?
              (tc_core.tc-context-expr-bases ctx)
              type-env
              params
              body))])]
    [_ false]))

(define (lower-tail-call-self-target? [state : LowerState] [name : i64]) : bool
  (string.eq
    (lower-resolve-name-id state name)
    (lower-state-current-function state)))

(define (lower-symbol-function-define-id?
  [ctx : tc_core.TcContext]
  [name-id : i64]) : bool
  (let
    [handle : i64
      (csym.compiler-symbols-lookup-value-id-or
        (tc_core.tc-context-symbols ctx)
        name-id
        (csym.compiler-symbols-missing-handle))]
    (and
      (csym.compiler-symbols-handle-found? handle)
      (=
        (csym.compiler-symbol-handle-kind handle)
        (csym.compiler-symbol-kind-function-define)))))

(define (lower-tail-call-compatible-return?
  [ctx : tc_core.TcContext]
  [callee-ret : ast.AstType]
  [ret-ty : ast.AstType]) : bool
  (tc_core.tc-type-eq
    (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx callee-ret))
    (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret-ty))))

(define (lower-tail-call-direct-structural-param?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]) : bool
  (match (lower-lookup-type-id
    ctx
    (lower-state-type-cache state)
    env
    type-env
    name)
    [(Ok fn-ty)
      (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx fn-ty))
        [(Func param-types _)
          (lower-internal-structural-type-list? ctx (deref param-types))]
        [_ false])]
    [(Err _) false]))

(define (lower-tail-call-direct-supported?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]
  [ret-ty : ast.AstType]) : bool
  (cond
    [(and
        ;; Direct aggregate tail calls also forward the current sret slot. A callee
        ;; early-exit path may return a heap aggregate pointer instead of filling it.
        (lower-inline-aggregate-abi-copy-needed?
          ctx
          (lower-global-shared-view ret-ty))
        (lower-rvo-callee-has-early-return-id? state env name))
      false]
    [(lower-tail-call-direct-structural-param? ctx state env type-env name)
      false]
    [(lower-tail-call-self-target? state name) true]
    [(lower-symbol-function-define-id? ctx name)
      (match (lower-lookup-type-id
        ctx
        (lower-state-type-cache state)
        env
        type-env
        name)
        [(Ok fn-ty)
          (match (tc_core.tc-type-strip-region
            (tc_core.tc-resolve-type ctx fn-ty))
            [(Func param-types callee-ret)
              (lower-tail-call-compatible-return?
                ctx
                (tc_core.tc-context-type-get ctx callee-ret)
                ret-ty)]
            [_ false])]
        [(Err _) false])]
    [else false]))

(define (lower-tail-call-args-for-target
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : i64]
  [args : ast.AstExprList]) : ResultLowerArgs
  (match (lower-lookup-type-id
    ctx
    (lower-state-type-cache state)
    env
    type-env
    name)
    [(Ok fn-ty)
      (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx fn-ty))
        [(Func param-types _)
          (lower-args-as
            ctx
            state
            env
            type-env
            args
            (tc_core.tc-resolve-type-list ctx (deref param-types)))]
        [_ (lower-args ctx state env type-env args)])]
    [(Err _) (lower-args ctx state env type-env args)]))

(define (lower-tail-call-indirect-supported?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func-ty : ast.AstType]
  [args : (& args ast.AstExprList)]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : bool
  (if (lower-tail-call-inline-aggregate-risk?
    ctx
    state
    env
    type-env
    args
    (lower-global-shared-view ret-ty)
    sret-var)
    false
    (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx func-ty))
      [(Func param-types callee-ret)
        (and
          (not (lower-internal-structural-type-list? ctx (deref param-types)))
          (lower-tail-call-compatible-return?
            ctx
            (tc_core.tc-context-type-get ctx callee-ret)
            ret-ty))]
      [_ false])))

(define (lower-tail-call-indirect-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [callee : ast.AstExpr]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (tc_core.tc-expr ctx type-env (lower-global-shared-view callee))
    [(Ok func-ty)
      (if (lower-tail-call-indirect-supported?
        ctx
        state
        env
        type-env
        func-ty
        args
        (lower-global-shared-view ret-ty)
        sret-var)
        (let
          [lowered-func (try (lower-expr ctx state env type-env callee))]
          (match lowered-func
            [(Expr func-state func-value lowered-func-ty)
              (match (lower-indirect-call-args
                ctx
                func-state
                env
                type-env
                args
                lowered-func-ty)
                [(Ok args-state values)
                  (match (lower-tail-call-append-current-sret-arg
                    ctx
                    args-state
                    values
                    (lower-global-shared-view ret-ty)
                    sret-var)
                    [(Ok tail-state tail-values)
                      (Ok
                        (lower-state-emit-at-expr
                          ctx
                          tail-state
                          (TailCallIndirect
                            func-value
                            (ir.compiler-ir-call-args-from-seq tail-values)
                            (lower-one-word-register-storage-type ctx ret-ty))
                          origin))]
                    [(Err message) (Err message)])]
                [(Err message) (Err message)])]))
        (lower-return-expr ctx state env type-env origin ret-ty sret-var))]
    [(Err message) (Err (box (lower-diagnostic-at-expr ctx callee message)))]))

(define (lower-return-expr-generic
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [ret-ty : ast.AstType]) : ResultLowerState
  (let
    [lowered
      (try
        (lower-expr-expected
          ctx
          state
          env
          type-env
          (lower-global-shared-view expr)
          (lower-global-shared-view ret-ty)
          expr))]
    (match lowered
      [(Expr body-state value expr-ty)
        (if (tc_core.tc-never-type? expr-ty)
          (Ok body-state)
          (let
            [return-copy
              (try
                (lower-prepare-internal-return-value
                  ctx
                  body-state
                  env
                  value
                  (lower-global-shared-view ret-ty)))]
            (match return-copy
              [(Expr return-state return-value _)
                (Ok
                  (lower-state-emit
                    return-state
                    (Return (lower-return-maybe return-value ret-ty))))])))])))

(define (lower-return-sret
  [state : LowerState]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (Ok
    (lower-state-emit state (Return (lower-return-maybe (Var sret-var) ret-ty)))))

;; List fold hook for the early-return scan.
(defmacro (lower-rvo-child-has-early-return? [ctx : Expr] [id : Expr]) : Expr
  `(lower-rvo-node-has-early-return? (lower-global-shared-view ,ctx) ,id))

(define (lower-rvo-node-has-early-return? [ctx : tc_core.TcContext] [id : i64]) : bool
  ;; `return` exits early. A `try` does not count: its error exit builds the
  ;; Err in the forwarded sret slot (`lower-return-result-err`). The arms
  ;; below also answer for quoted syntax (no), for the forms this scan does not
  ;; descend into (yes, to stay conservative) and for TupleRef, whose index it
  ;; reads as a node; every other variant asks its expression children through
  ;; the AstExpr child list.
  (match (lower-context-expr-get ctx id)
    [(Return _) true]
    [(TupleRef tuple-box index-box)
      (or
        (lower-rvo-node-has-early-return? ctx tuple-box)
        (lower-rvo-node-has-early-return? ctx index-box))]
    [(Comptime _) false]
    [(Quote _) false]
    [(Quasiquote _) false]
    [(Unquote _) false]
    [(UnquoteSplicing _) false]
    [(ArrayTake _ _ _) true]
    [(Replace _ _) true]
    [(Break) true]
    [(Continue) true]
    [(ForOwnedState _) true]
    [(ForOwnedStep _) true]
    [(MacroExpansion _ _ _) true]
    [_
      (ast.ast-expr-list-fold
        (ast.ast-expr-child-ids (lower-context-expr-get ctx id))
        ast.ast-fold-or
        false
        lower-rvo-child-has-early-return?
        ctx)]))

;; Aliasing guard for sret-forwarding RVO. The forwarded sret is the
;; current function's result slot, which a CALLER may legally have aliased with
;; one of this call's arguments (the `(set! place (f place ...))` /
;; aggregate-place-update pattern -- HARD CONSTRAINT #4). If a callee then reads
;; such an argument and writes its result in place through the (aliased) sret --
;; e.g. it returns an enum/struct WRAPPING one of its parameters, like
;; a generated String -> i64 map remove returning `(RemoveOk map)` -- the
;; materialize-into-fresh-temp step of the value path is what makes that safe.
;; Forwarding the sret removes that buffer, so we only forward when NO argument
;; can alias the sret. An argument cannot alias the caller-owned result slot when
;; it is a scalar (carries no inline-aggregate storage) or is itself a
;; fresh-producing call/constructor whose result is an OWNED inline struct/enum
;; (materialized into a distinct fresh temp). A place-expression of aggregate
;; type (var/field/index/deref) or any reference/borrow may alias and is unsafe.
(define (lower-rvo-arg-cannot-alias-sret?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [arg : ast.AstExpr]) : bool
  (match (tc_core.tc-expr ctx type-env (lower-global-shared-view arg))
    [(Ok ty)
      (or
        (not
          (lower-type-contains-inline-aggregate?
            ctx
            (lower-global-shared-view ty)))
        (and
          (match (ast.ast-expr-unspan arg)
            [(Call _ _) true]
            [_ false])
          (lower-type-inline-struct-or-enum? ctx ty)))]
    [(Err _) false]))

(define (lower-rvo-args-cannot-alias-sret?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]) : bool
  (lower-rvo-args-cannot-alias-sret-at? ctx type-env (& args) 0))

(define (lower-rvo-args-cannot-alias-sret-at?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index args.len)
    true
    (and
      (lower-rvo-arg-cannot-alias-sret?
        ctx
        type-env
        (lower-context-expr-get ctx (ast.ast-expr-list-get args index 0)))
      (lower-rvo-args-cannot-alias-sret-at? ctx type-env args (+ index 1)))))

(define (lower-rvo-callee-has-early-return-id?
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [name-id : i64]) : bool
  (let
    [logical-id : i64
      (if (sym_i64_env.sym-i64-contains-id env name-id)
        name-id
        (let
          [names : LowerNameCache (lower-state-names state)]
          (lower-name-cache-resolve-logical-id (& names) name-id name-id)))]
    [early-returns : lower_i64_i64_map.Map
      (compiler-lower-state-read
        (lower-state-owner state)
        lower_i64_i64_map.Map
        rvo-early-return-functions)]
    (lower_i64_i64_map.contains? (& early-returns) logical-id)))

;; Call-slot RVO for a tail-position direct CALL whose aggregate result is
;; returned by the current function. The value path lowers the call into a fresh
;; reserved result slot (`lower-call-append-sret-arg`) and then `lower-copy-bytes`
;; copies that slot into the caller-owned sret. Instead, forward the caller's own
;; sret pointer as the callee's hidden sret argument so the callee writes the
;; final result DIRECTLY into the return slot, eliminating the materialize+copy.
;;
;; Correctness: the call's arguments are evaluated BEFORE the call exactly as on
;; the value path, the would-be temporary's sole consumer is this return, and the
;; `lower-rvo-args-cannot-alias-sret?` guard above ensures no argument can alias
;; the destination -- so substituting the destination is sound. This mirrors
;; `lower-direct-call-id`'s ordinary (non-builtin, non-C-ABI) sret path verbatim,
;; only swapping the reserved slot for the provided `sret-var` and ending with the
;; return. Anything outside that path (builtins, C-ABI/extern, bytes-view,
;; indirect targets, incompatible/aliasing returns) yields `LowerMaybeDirectStore.No`
;; and falls back to the unchanged value+copy path.
(define (lower-return-direct-call-into-sret
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [name-id : i64]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : LowerMaybeDirectStore
  (if (or
    (not
      (lower-type-inline-struct-or-enum? ctx (lower-global-shared-view ret-ty)))
    ;; Require a genuine top-level function-define so a direct `CompilerIrInstr.Call` to
    ;; this symbol is the correct lowering. This excludes builtins, C-ABI/extern
    ;; declarations, and -- critically -- top-level function-VALUE globals /
    ;; closures, whose call must go through an INDIRECT load of the variable
    ;; (emitting a direct symbol call there would call into data). Same eligibility
    ;; rule `lower-tail-call-direct-supported?` uses for direct TCO.
    (not (lower-symbol-function-define-id? ctx name-id))
    ;; Explicit early exits are still lowered through return paths that may hand
    ;; back an allocated aggregate in `rax` instead of filling the forwarded sret.
    (lower-rvo-callee-has-early-return-id? state env name-id)
    (lower-bytes-view-from-parts-name? (lower-global-shared-view name))
    (lower-c-abi-extern-call?
      ctx
      state
      env
      name-id
      (lower-global-shared-view name))
    (lower-c-abi-extern-value-call?
      ctx
      state
      env
      name-id
      (lower-global-shared-view name))
    ;; An argument that may alias the caller-owned sret makes in-place forwarding
    ;; unsound (see `lower-rvo-args-cannot-alias-sret?`).
    (not (lower-rvo-args-cannot-alias-sret? ctx type-env args)))
    (No)
    (match (lower-lookup-type-id
      ctx
      (lower-state-type-cache state)
      env
      type-env
      name-id)
      [(Ok fn-ty)
        (match (tc_core.tc-type-strip-region
          (tc_core.tc-resolve-type ctx fn-ty))
          [(Func param-types fn-ret)
            (if (not
              (lower-tail-call-compatible-return?
                ctx
                (tc_core.tc-context-type-get ctx fn-ret)
                (lower-global-shared-view ret-ty)))
              ;; The callee's declared return type differs from this function's
              ;; return type (beyond regions): the value path coerces the call
              ;; result into the sret slot, so forwarding the slot to the callee
              ;; -- which would write its OWN-typed result -- is unsound. Keep the
              ;; materialize+copy path. (Same compatibility rule TCO requires.)
              (No)
              (match (lower-direct-call-param-types
                ctx
                type-env
                name-id
                (lower-global-shared-view args)
                (tc_core.tc-resolve-type-list ctx (deref param-types)))
                [(Ok call-param-types)
                  (match (lower-call-args-as-needed
                    ctx
                    state
                    env
                    type-env
                    args
                    call-param-types)
                    [(Ok args-state values writebacks)
                      (match (lower-state-alloc-var args-state)
                        [(Alloc allocated call-var)
                          (let
                            [result-ir-ty : ast.AstType
                              (lower-one-word-register-storage-type ctx ret-ty)]
                            [sret-values : ir.CompilerIrValueSeq
                              (lower-value-seq-append-one values (Var sret-var))]
                            [call-name : i64
                              (lower-resolve-call-name-id-with-display
                                allocated
                                env
                                name-id
                                name)]
                            [call-state : LowerState
                              (lower-state-emit-at-expr
                                ctx
                                allocated
                                (Call
                                  call-var
                                  call-name
                                  (ir.compiler-ir-call-args-from-seq
                                    sret-values)
                                  result-ir-ty)
                                origin)]
                            [writeback-state : LowerState
                              (lower-apply-arg-writebacks
                                ctx
                                call-state
                                writebacks)]
                            (Store
                              (lower-state-emit
                                writeback-state
                                (Return
                                  (lower-return-maybe (Var sret-var) ret-ty)))))])]
                    [(Err message) (Err message)])]
                [(Err message)
                  (Err (box (lower-diagnostic-at-expr ctx origin message)))]))]
          [_ (No)])]
      [(Err _) (No)])))

;; Tail-position direct-call fallback shared by the non-constructor branches of
;; `lower-return-call-name-to-sret`: try the call-slot RVO above, otherwise keep
;; the unchanged materialize-into-temp + copy-to-sret behavior.
(define (lower-return-call-fallback-to-sret
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [name-id : i64]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (lower-return-direct-call-into-sret
    ctx
    state
    env
    type-env
    name
    name-id
    args
    (lower-global-shared-view ret-ty)
    sret-var
    (lower-global-shared-view origin))
    [(Store done-state) (Ok done-state)]
    [(Err message) (Err message)]
    [(No) (lower-return-expr-generic ctx state env type-env origin ret-ty)]))

(define (lower-return-call-name-to-sret
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [name : String]
  [raw-name-id : i64]
  [lookup-name-id : i64]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (let
    [source-name : String
      (lower-hygiene-source-name (lower-global-shared-view name))]
    [variant-name : String
      (lower-variant-constructor-lookup-name
        ctx
        (lower-global-shared-view source-name)
        raw-name-id
        (lower-global-shared-view ret-ty))]
    [struct-name : String
      (match (tc_core.tc-type-strip-region (lower-global-shared-view ret-ty))
        [(Struct resolved-struct)
          (if (lower-call-name-matches-nominal?
            ctx
            source-name
            (tc_core.tc-nominal-name-id-display resolved-struct))
            (tc_core.tc-nominal-name-id-display resolved-struct)
            (lower-module-lookup-name
              ctx
              (lower-global-shared-view source-name)))]
        [(StructArgs resolved-struct _)
          (if (lower-call-name-matches-nominal?
            ctx
            source-name
            (tc_core.tc-nominal-name-id-display resolved-struct))
            (tc_core.tc-nominal-name-id-display resolved-struct)
            (lower-module-lookup-name
              ctx
              (lower-global-shared-view source-name)))]
        [_
          (lower-module-lookup-name ctx (lower-global-shared-view source-name))])]
    [variant-handle : i64
      (lower-variant-constructor-handle-id-or
        ctx
        source-name
        raw-name-id
        (lower-global-shared-view ret-ty)
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? variant-handle)
      (let
        [done-state
          (try
            (lower-construct-enum-with-handle-into
              ctx
              state
              env
              type-env
              (Var sret-var)
              variant-name
              variant-handle
              args
              (lower-global-shared-view ret-ty)))]
        (lower-return-sret done-state ret-ty sret-var))
      (let
        [struct-handle : i64
          (lower-struct-constructor-handle-id-or
            ctx
            state
            raw-name-id
            lookup-name-id
            (lower-global-shared-view ret-ty)
            (csym.compiler-symbols-missing-handle))]
        (if (and
          (or
            (tc_core.tc-constructor-source-name-id? ctx raw-name-id)
            (tc_core.tc-constructor-source-name-id? ctx lookup-name-id))
          (csym.compiler-symbols-handle-found? struct-handle)
          (=
            (csym.compiler-symbol-handle-kind struct-handle)
            (csym.compiler-symbol-kind-defstruct)))
          (let
            [done-state
              (try
                (lower-construct-struct-into
                  ctx
                  state
                  env
                  type-env
                  (Var sret-var)
                  struct-name
                  struct-handle
                  args
                  (lower-global-shared-view ret-ty)))]
            (lower-return-sret done-state ret-ty sret-var))
          (lower-return-call-fallback-to-sret
            ctx
            state
            env
            type-env
            name
            lookup-name-id
            args
            ret-ty
            sret-var
            origin))))))

(define (lower-return-call-to-sret
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [func : ast.AstExpr]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (ast.ast-expr-unspan func)
    [(Var raw-name)
      (let
        [source-id : i64
          (tc_core.macro-hygiene-global-source-name-id-or
            (tc_core.tc-context-structural-session ctx)
            raw-name
            raw-name)]
        [raw-text : String (lower-context-intern-str ctx source-id)]
        (if (tc_core.tc-dotted-local-field-name-id? type-env raw-name)
          (lower-return-expr-generic ctx state env type-env origin ret-ty)
          (if (sym_i64_env.sym-i64-contains-id env raw-name)
            (lower-return-expr-generic ctx state env type-env origin ret-ty)
            (match (if (or
              (tc_core.macro-hygiene-global-id?
                (tc_core.tc-context-structural-session ctx)
                raw-name)
              (tc_core.tc-hygiene-global-name? raw-text))
              (match (tc_core.tc-source-name-lookup-key-with-field-check-lookup
                ctx
                type-env
                raw-text
                raw-name
                true)
                [(Ok _ resolved-id)
                  (tc_core.TcNameLookup.Ok
                    (lower-hygiene-source-name-in-context-id
                      (lower-state-owner state)
                      ctx
                      type-env
                      raw-name)
                    resolved-id)]
                [(Err _)
                  (tc_core.TcNameLookup.Ok
                    (lower-hygiene-source-name-in-context-id
                      (lower-state-owner state)
                      ctx
                      type-env
                      raw-name)
                    raw-name)])
              (if (tc_core.tc-source-slash-qualified-id?
                (tc_core.tc-context-structural-session ctx)
                (lower-global-shared-view raw-text)
                source-id)
                (tc_core.TcNameLookup.Ok raw-text source-id)
                (tc_core.tc-source-name-lookup-key-with-field-check-lookup
                  ctx
                  type-env
                  raw-text
                  raw-name
                  true)))
              [(Ok name lookup-name-id)
                (lower-return-call-name-to-sret
                  ctx
                  state
                  env
                  type-env
                  name
                  raw-name
                  lookup-name-id
                  args
                  ret-ty
                  sret-var
                  origin)]
              [(Err _)
                (lower-return-expr-generic ctx state env type-env origin ret-ty)]))))]
    [_ (lower-return-expr-generic ctx state env type-env origin ret-ty)]))

(define (lower-return-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (if (and
    (>= sret-var 0)
    (lower-type-inline-struct-or-enum? ctx (lower-global-shared-view ret-ty))
    (lower-inline-aggregate-abi-copy-needed?
      ctx
      (lower-global-shared-view ret-ty)))
    (match (lower-global-shared-view expr)
      [(Spanned inner-box _)
        (let
          [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
          (lower-return-expr ctx state env type-env inner ret-ty sret-var))]
      [(Call func-box args)
        (let
          [func : ast.AstExpr (lower-context-expr-get ctx func-box)]
          (lower-return-call-to-sret
            ctx
            state
            env
            type-env
            func
            args
            ret-ty
            sret-var
            expr))]
      [_ (lower-return-expr-generic ctx state env type-env expr ret-ty)])
    (lower-return-expr-generic ctx state env type-env expr ret-ty)))

(define (lower-tail-call-safe-param-aggregate-arg?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [expr : ast.AstExpr]) : bool
  (match expr
    [(Spanned inner-box _)
      (lower-tail-call-safe-param-aggregate-arg?
        ctx
        state
        env
        (lower-context-expr-get ctx inner-box))]
    [(Ann inner-box _)
      (lower-tail-call-safe-param-aggregate-arg?
        ctx
        state
        env
        (lower-context-expr-get ctx inner-box))]
    [(Var name)
      (let
        [var-id : i64
          (sym_i64_env.sym-i64-lookup-id-or
            env
            name
            (csym.compiler-symbols-missing-handle))]
        (if (csym.compiler-symbols-handle-found? var-id)
          (lower-state-tail-param-range-contains? state var-id)
          false))]
    [_ false]))

(define (lower-expr-list-contains-unsafe-inline-aggregate?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]) : bool
  (lower-expr-list-contains-unsafe-inline-aggregate-at?
    ctx
    state
    env
    type-env
    (& exprs)
    0))

(define (lower-expr-list-contains-unsafe-inline-aggregate-at?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]) : bool
  (if (>= index exprs.len)
    false
    (let
      [expr : ast.AstExpr
        (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
      (match (tc_core.tc-expr ctx type-env (lower-global-shared-view expr))
        [(Ok ty)
          (or
            (and
              (lower-type-contains-inline-aggregate? ctx ty)
              (not
                (lower-tail-call-safe-param-aggregate-arg? ctx state env expr)))
            (lower-expr-list-contains-unsafe-inline-aggregate-at?
              ctx
              state
              env
              type-env
              exprs
              (+ index 1)))]
        [(Err _)
          (lower-expr-list-contains-unsafe-inline-aggregate-at?
            ctx
            state
            env
            type-env
            exprs
            (+ index 1))]))))

(define (lower-tail-call-inline-aggregate-risk?
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [args : (& args ast.AstExprList)]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : bool
  (or
    ;; Structural ABI values use explicit materialization/call transforms;
    ;; tail forwarding must not bypass those steps, even with a leading sret.
    (lower-internal-structural-type? ctx (lower-global-shared-view ret-ty))
    ;; Aggregate returns do not make frame reuse unsafe when the current
    ;; function has the caller-owned sret slot to forward to the callee.
    (and (< sret-var 0) (lower-inline-aggregate-abi-copy-needed? ctx ret-ty))
    (lower-expr-list-contains-unsafe-inline-aggregate?
      ctx
      state
      env
      type-env
      args)))

(define (lower-tail-call-append-current-sret-arg
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [values : ir.CompilerIrValueSeq]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerArgs
  (if (and
    (>= sret-var 0)
    (lower-type-inline-struct-or-enum? ctx (lower-global-shared-view ret-ty))
    (lower-inline-aggregate-abi-copy-needed? ctx ret-ty))
    (Ok state (lower-value-seq-append-one values (Var sret-var)))
    (Ok state values)))

(define (lower-tail-call
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [callee : ast.AstExpr]
  [args : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (match (ast.ast-expr-unspan (lower-global-shared-view callee))
    [(ast.AstExpr.Var name)
      (let
        [unshadowed : bool (lower-tail-call-var-unshadowed? env name)]
        (cond
          [(and
              unshadowed
              (lower-comptime-error-call-id? (lower-state-owner state) name))
            (ResultLowerState.Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  origin
                  "lower: comptime-error is compile-time only")))]
          [(and
              unshadowed
              (lower-string-concat-call-source? ctx env state type-env name))
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]
          [(and
              unshadowed
              (cbi.compiler-builtin-private-intrinsic-id? name)
              (lower-top-level-builtin-available-id? ctx type-env name))
            ;; Private intrinsic calls in imported bodies must pass through the
            ;; ordinary expression lowerer before direct-tail-call selection.
            ;; Otherwise a compatible caller-owned shadow can capture the call.
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]
          [(and
              unshadowed
              ;; Only suppress TCO when THIS call actually involves inline
              ;; aggregates (sret/by-value risk); a broad inline-aggregates-mode guard
              ;; disabled tail-call optimization for every call (mode is always on),
              ;; losing TCO entirely (deep self-recursion, smoke shape failure).
              (not
                (lower-tail-call-inline-aggregate-risk?
                  ctx
                  state
                  env
                  type-env
                  args
                  (lower-global-shared-view ret-ty)
                  sret-var))
              (lower-tail-call-direct-supported?
                ctx
                state
                env
                type-env
                name
                (lower-global-shared-view ret-ty))
              ;; A borrowed temporary lives in this frame until the call
              ;; returns and may need cleanup afterwards, so the call cannot
              ;; replace the frame.
              (not (lower-call-args-borrow-temporary? ctx (& args))))
            (match (lower-tail-call-args-for-target
              ctx
              state
              env
              type-env
              name
              args)
              [(ResultLowerArgs.Ok args-state values)
                (match (lower-tail-call-append-current-sret-arg
                  ctx
                  args-state
                  values
                  (lower-global-shared-view ret-ty)
                  sret-var)
                  [(ResultLowerArgs.Ok tail-state tail-values)
                    (let
                      [target-id : i64
                        (lower-resolve-name-symbol-id tail-state name)]
                      (ResultLowerState.Ok
                        (lower-state-emit-at-expr
                          ctx
                          tail-state
                          (ir.CompilerIrInstr.TailCall
                            target-id
                            (ir.compiler-ir-call-args-from-seq tail-values)
                            (lower-one-word-register-storage-type ctx ret-ty))
                          origin)))]
                  [(ResultLowerArgs.Err message) (ResultLowerState.Err message)])]
              [(ResultLowerArgs.Err message) (ResultLowerState.Err message)])]
          [unshadowed
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]
          [(and
              (lower-tail-call-local-indirect-safe? env type-env name)
              (not (lower-call-args-borrow-temporary? ctx (& args))))
            (lower-tail-call-indirect-expr
              ctx
              state
              env
              type-env
              callee
              args
              ret-ty
              sret-var
              origin)]
          [else
            (lower-return-expr ctx state env type-env origin ret-ty sret-var)]))]
    [_
      (if (or
        (lower-call-args-borrow-temporary? ctx (& args))
        (lower-tail-call-reference-capturing-lambda?
          ctx
          type-env
          (lower-global-shared-view callee)))
        (lower-return-expr ctx state env type-env origin ret-ty sret-var)
        (lower-tail-call-indirect-expr
          ctx
          state
          env
          type-env
          callee
          args
          ret-ty
          sret-var
          origin))]))

(define (lower-tail-begin
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : ast.AstExprList]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (lower-tail-begin-at ctx state env type-env (& exprs) 0 ret-ty sret-var))

(define (lower-tail-begin-at
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [exprs : (& exprs ast.AstExprList)]
  [index : i64]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (let
    [len : i64 exprs.len]
    (if (>= index len)
      (Ok (lower-state-emit state (Return (lower-return-maybe Unit ret-ty))))
      (let
        [expr : ast.AstExpr
          (lower-context-expr-get ctx (ast.ast-expr-list-get exprs index 0))]
        (if (= (+ index 1) len)
          (lower-tail-expr ctx state env type-env expr ret-ty sret-var)
          (let
            [lowered : LowerExpr (try (lower-expr ctx state env type-env expr))]
            (match lowered
              [(Expr next-state _ expr-ty)
                (if (tc_core.tc-never-type? expr-ty)
                  (Ok next-state)
                  (lower-tail-begin-at
                    ctx
                    next-state
                    env
                    type-env
                    exprs
                    (+ index 1)
                    ret-ty
                    sret-var))])))))))

(define (lower-tail-if
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [cond : ast.AstExpr]
  [then-branch : ast.AstExpr]
  [else-branch : ast.AstExpr]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (let
    [cond-lowered : LowerExpr (try (lower-expr ctx state env type-env cond))]
    (match cond-lowered
      [(Expr cond-state cond-value _)
        (match (lower-state-fresh-label cond-state "if_then")
          [(Label then-label-state then-label)
            (match (lower-state-fresh-label then-label-state "if_else")
              [(Label else-label-state else-label)
                (let
                  [branch-state : LowerState
                    (lower-state-emit
                      else-label-state
                      (Branch cond-value then-label else-label))]
                  [then-state
                    (try
                      (lower-tail-expr
                        ctx
                        (lower-state-finish-block branch-state then-label)
                        env
                        type-env
                        then-branch
                        (lower-global-shared-view ret-ty)
                        sret-var))]
                  (lower-tail-expr
                    ctx
                    (lower-state-finish-block then-state else-label)
                    env
                    type-env
                    else-branch
                    ret-ty
                    sret-var))])])])))

;; Per-match variant arm resolution memo. Each arm of one match re-runs the
;; same constructor/payload resolution chain (tc-env-key-name-text, scrutinee
;; type resolution, lower-variant-constructor-handle-id-or,
;; compiler-registries-variant-fields-indexed,
;; lower-variant-payload-fields-for-handle,
;; lower-variant-handle-name-id-or), whose inputs are constant across the
;; arms of one match and pure (registries and ctx caches only grow during one
;; function's lowering). Memoize the resolution per (variant-name-id,
;; scrutinee type) for the lifetime of one function in a small direct-mapped
;; cache in job-owned lazy arrays, tagged by the explicitly passed function
;; state's generation. Collisions simply evict; the result is exact either way.
(define (lower-variant-arm-resolution-compute
  [ctx : tc_core.TcContext]
  [symbols : csym.CompilerSymbols]
  [scrut-ty : ast.AstType]
  [variant-name-id : i64]) : LowerVariantArmResolution
  (let
    [variant-name : String (tc_core.tc-env-key-name-text variant-name-id)]
    [resolved-scrut-ty : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx scrut-ty))]
    [handle : i64
      (lower-variant-constructor-handle-id-or
        ctx
        (lower-global-shared-view variant-name)
        variant-name-id
        (lower-global-shared-view resolved-scrut-ty)
        (csym.compiler-symbols-missing-handle))]
    (if (csym.compiler-symbols-handle-found? handle)
      (match (csym.compiler-registries-variant-fields-indexed symbols handle)
        [(Ok fields)
          (Some
            variant-name
            (lower-global-shared-view resolved-scrut-ty)
            handle
            (lower-variant-payload-fields-for-handle
              ctx
              handle
              resolved-scrut-ty
              fields)
            (lower-variant-handle-name-id-or ctx handle variant-name-id))]
        [(Err message) (FieldsErr message)])
      (Missing variant-name))))

(define (lower-variant-arm-resolution
  [ctx : tc_core.TcContext]
  [function-state : CompilerLowerFunctionState]
  [symbols : csym.CompilerSymbols]
  [scrut-ty : ast.AstType]
  [variant-name-id : i64]) : LowerVariantArmResolution
  (let
    [storage : CompilerLowerFunctionMemoStorage
      (compiler-lower-function-memo-storage
        (compiler-lower-function-state-owner function-state))]
    [generation : i64
      (compiler-lower-function-state-variant-generation function-state)]
    [slot : i64
      (-
        variant-name-id
        (*
          (/ variant-name-id lower-variant-arm-memo-cap)
          lower-variant-arm-memo-cap))]
    (if (and
      (= (array-ref storage.variant-stamps slot) generation)
      (= (array-ref storage.variant-keys slot) variant-name-id)
      (ast.ast-type-eq-with-pools?
        (tc_core.tc-context-pools ctx)
        (lower-global-array-element-shared-view
          storage.variant-scrutinee-types
          slot)
        (lower-global-shared-view scrut-ty)))
      (lower-global-array-element-shared-view storage.variant-outcomes slot)
      (let
        [result : LowerVariantArmResolution
          (lower-variant-arm-resolution-compute
            ctx
            symbols
            (lower-global-shared-view scrut-ty)
            variant-name-id)]
        (match (lower-global-shared-view result)
          ;; Error results stay recomputed: diagnostics are cold paths and
          ;; must not pin a stale message across scrutinee types.
          [(FieldsErr _) unit]
          [_
            (set! (array-ref storage.variant-stamps slot) generation)
            (set! (array-ref storage.variant-keys slot) variant-name-id)
            (set! (array-ref storage.variant-scrutinee-types slot) scrut-ty)
            (set! (array-ref storage.variant-outcomes slot) result)])
        result))))

(define (lower-borrowed-enum-match-scrutinee?
  [ctx : tc_core.TcContext]
  [type-env : tc_core.TcTypeEnv]
  [scrutinee : ast.AstExpr]) : bool
  (match (ast.ast-expr-unspan (lower-global-shared-view scrutinee))
    [(Borrow mutable _ _)
      (if mutable
        false
        (match (tc_core.tc-expr ctx type-env scrutinee)
          [(Ok scrut-ty)
            (match (tc_core.tc-type-strip-region
              (tc_core.tc-resolve-type ctx scrut-ty))
              [(Ref _ referent-box)
                (let
                  [referent-ty : ast.AstType
                    (tc_core.tc-type-strip-region
                      (tc_core.tc-resolve-type
                        ctx
                        (tc_core.tc-context-type-get ctx referent-box)))]
                  (match referent-ty
                    [(Enum _) true]
                    [(EnumArgs _ _) true]
                    [_ false]))]
              [_ false])]
          [(Err _) false]))]
    [_ false]))

;; Where the scrutinee of a match should live: when it is already a var (the
;; common case -- a local, an array-ref result, a call result) use that var
;; directly instead of allocating a fresh one and emitting a group-copying
;; Mov into it (a 2-word enum pays a Pack round-trip per copy).
(defenum LowerScrutineeHome
  (Home LowerState i64))

(define (lower-tail-match-scrutinee-home
  [state : LowerState]
  [scrut-value : ir.CompilerIrValue]
  [scrut-ty : ast.AstType]) : LowerScrutineeHome
  (match (lower-global-shared-view scrut-value)
    [(Var scrutinee-var) (Home state scrutinee-var)]
    [_
      (match (lower-state-alloc-var state)
        [(Alloc scrut-alloc scrut-var)
          (Home
            (lower-state-emit scrut-alloc (Mov scrut-var scrut-value scrut-ty))
            scrut-var)])]))

(define (lower-tail-match
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [scrutinee : ast.AstExpr]
  [arms : ast.AstMatchArmList]
  [ret-ty : ast.AstType]
  [sret-var : i64]
  [origin : ast.AstExpr]) : ResultLowerState
  (if (lower-borrowed-enum-match-scrutinee?
    ctx
    type-env
    (lower-global-shared-view scrutinee))
    (lower-return-expr ctx state env type-env origin ret-ty sret-var)
    (let
      [scrut-lowered : LowerExpr
        (try (lower-expr ctx state env type-env scrutinee))]
      (match scrut-lowered
        [(Expr scrut-state scrut-value scrut-ty)
          (match (lower-tail-match-scrutinee-home
            scrut-state
            scrut-value
            (lower-global-shared-view scrut-ty))
            [(Home match-state scrut-var)
              (lower-match-tail-result
                (lower-match-dispatch
                  ctx
                  match-state
                  env
                  type-env
                  scrut-var
                  scrut-ty
                  arms
                  (Tail ret-ty sret-var)))])]))))

(define (lower-tail-expr
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [ret-ty : ast.AstType]
  [sret-var : i64]) : ResultLowerState
  (match (lower-global-shared-view expr)
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-tail-expr ctx state env type-env inner ret-ty sret-var))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-tail-expr ctx state env type-env inner ret-ty sret-var))]
    [(Cast inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (match (tc_core.tc-expr ctx type-env (lower-global-shared-view inner))
          [(Ok inner-ty)
            (if (tc_core.tc-type-eq
              (tc_core.tc-type-without-regions inner-ty)
              (lower-global-shared-view ret-ty))
              (lower-tail-expr ctx state env type-env inner ret-ty sret-var)
              (lower-return-expr ctx state env type-env expr ret-ty sret-var))]
          [(Err message)
            (Err (box (lower-diagnostic-at-expr ctx inner message)))]))]
    [(Call callee-box args)
      (let
        [callee : ast.AstExpr (lower-context-expr-get ctx callee-box)]
        (lower-tail-call
          ctx
          state
          env
          type-env
          callee
          args
          ret-ty
          sret-var
          expr))]
    [(Let let-box)
      (match (__tl-box-place let-box)
        [(Let bindings body-box)
          (let
            [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
            (match (lower-let-bindings ctx state env type-env bindings)
              [(Ok binding-state body-env body-type-env)
                (lower-tail-expr
                  ctx
                  binding-state
                  body-env
                  body-type-env
                  body
                  ret-ty
                  sret-var)]
              [(Err message) (Err message)]))])]
    [(Begin exprs)
      (lower-tail-begin ctx state env type-env exprs ret-ty sret-var)]
    [(Unsafe exprs)
      (lower-tail-begin
        ctx
        state
        env
        (tc_core.tc-enter-unsafe type-env)
        exprs
        ret-ty
        sret-var)]
    [(If cond-box then-branch-box else-branch-box)
      (let
        [cond : ast.AstExpr (lower-context-expr-get ctx cond-box)]
        [then-branch : ast.AstExpr (lower-context-expr-get ctx then-branch-box)]
        [else-branch : ast.AstExpr (lower-context-expr-get ctx else-branch-box)]
        (lower-tail-if
          ctx
          state
          env
          type-env
          cond
          then-branch
          else-branch
          ret-ty
          sret-var))]
    [(Match match-box)
      (match (__tl-box-place match-box)
        [(Match scrutinee-box arms)
          (let
            [scrutinee : ast.AstExpr (lower-context-expr-get ctx scrutinee-box)]
            (lower-tail-match
              ctx
              state
              env
              type-env
              scrutinee
              arms
              ret-ty
              sret-var
              expr))])]
    [_ (lower-return-expr ctx state env type-env expr ret-ty sret-var)]))

(define (lower-param-count [params : (& params ast.AstParamList)]) : i64
  (ast.ast-param-list-len (& params)))

(define (lower-internal-param-list-contains-structural?
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]) : bool
  (lower-internal-param-list-contains-structural-at? ctx (& params) 0))

(define (lower-internal-param-list-contains-structural-at?
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-param-list-len params))
    false
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param _ ty _)
        (or
          (lower-internal-structural-type? ctx ty)
          (lower-internal-param-list-contains-structural-at?
            ctx
            params
            (+ index 1)))])))

(define (lower-bind-params
  [params : (& params ast.AstParamList)]
  [idx : i64]
  [env : sym_i64_env.SymI64Env]) : sym_i64_env.SymI64Env
  (lower-bind-params-at (& params) 0 idx env))

(define (lower-bind-params-at
  [params : (& params ast.AstParamList)]
  [index : i64]
  [idx : i64]
  [env : sym_i64_env.SymI64Env]) : sym_i64_env.SymI64Env
  (if (>= index (ast.ast-param-list-len params))
    env
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name _ _)
        (lower-bind-params-at
          params
          (+ index 1)
          (+ idx 1)
          (sym_i64_env.sym-i64-bind-id env name idx))])))

(define (lower-param-list
  [ctx : tc_core.TcContext]
  [params : ast.AstParamList]
  [idx : i64]) : ir.CompilerIrParamSeq
  (let
    [builder : ir.CompilerIrParamBuilder
      (ir.compiler-ir-param-builder-with-capacity
        (ast.ast-param-list-len (& params)))]
    (lower-param-list-into! ctx (& params) 0 idx (&mut builder))
    (ir.compiler-ir-param-builder-to-seq builder)))

;; Internal functions keep one physical IR argument per source parameter. A
;; structural sret pointer, when present, is the first physical argument; the
;; source range therefore starts at `source-start` and never includes hidden
;; arguments in the tail-call forwarding range.
(define (lower-internal-param-list
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [params : ast.AstParamList]
  [source-start : i64]
  [leading-sret? : bool]) : ir.CompilerIrParamSeq
  (let
    [source : ir.CompilerIrParamSeq
      (let
        [builder : ir.CompilerIrParamBuilder
          (ir.compiler-ir-param-builder-with-capacity
            (ast.ast-param-list-len (& params)))]
        (lower-internal-param-list-into!
          ctx
          mode
          (& params)
          0
          source-start
          (&mut builder))
        (ir.compiler-ir-param-builder-to-seq builder))]
    (if leading-sret?
      (ir.compiler-ir-param-seq-prepend
        (Param (ir.compiler-ir-hidden-sret-param-name) (U64) (- source-start 1))
        source)
      source)))

(define (lower-internal-param-list-into!
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [idx : i64]
  [builder : (&mut builder ir.CompilerIrParamBuilder)]) : unit
  (if (>= index (ast.ast-param-list-len params))
    unit
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name ty _)
        (ir.compiler-ir-param-builder-push!
          builder
          (ir.CompilerIrParam.Param
            (tc_core.tc-env-key-name-text name)
            (lower-internal-param-physical-type ctx mode ty)
            idx))
        (lower-internal-param-list-into!
          ctx
          mode
          params
          (+ index 1)
          (+ idx 1)
          builder)])))

(define (lower-internal-param-storage-two
  [physical : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [slots : LowerCAbiSlotList]
  [storage : ir.CompilerIrValue]
  [storage-state : LowerState]) : ResultLowerExpr
  (match (lower-c-abi-slot-list-ref slots 0)
    [(Slot first-ty first-offset)
      (match (lower-emit-word
        storage-state
        (lower-global-shared-view physical)
        0
        (lower-global-shared-view first-ty))
        [(Expr first-state first-value _)
          (match (lower-c-abi-slot-list-ref slots 1)
            [(Slot second-ty second-offset)
              (match (lower-emit-word
                first-state
                physical
                1
                (lower-global-shared-view second-ty))
                [(Expr second-state second-value _)
                  (let
                    [with0 : LowerState
                      (lower-store-at-offset
                        second-state
                        storage
                        first-offset
                        first-value
                        first-ty)]
                    [with1 : LowerState
                      (lower-store-at-offset
                        with0
                        storage
                        second-offset
                        second-value
                        second-ty)]
                    (Ok (Expr with1 storage source-ty)))])])])]))

(define (lower-internal-param-storage
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [physical : ir.CompilerIrValue]
  [source-ty : ast.AstType]
  [classification : LowerCAbiAggregate]
  [origin : ast.AstExpr]) : ResultLowerExpr
  (match classification
    [(Integer scalar-ty size)
      (match (lower-reserve-inline-storage state size source-ty)
        [(Expr storage-state storage _)
          (Ok
            (Expr
              (lower-store-at-offset storage-state storage 0 physical scalar-ty)
              storage
              source-ty))])]
    [(Register slots size)
      (match (lower-reserve-inline-storage state size source-ty)
        [(Expr storage-state storage _)
          (if (= (lower-c-abi-slot-list-count slots) 1)
            (match (lower-c-abi-slot-list-ref slots 0)
              [(Slot scalar-ty offset)
                (Ok
                  (Expr
                    (lower-store-at-offset
                      storage-state
                      storage
                      offset
                      physical
                      scalar-ty)
                    storage
                    source-ty))])
            (lower-internal-param-storage-two
              physical
              source-ty
              slots
              storage
              storage-state))])]
    [(No) (Ok (Expr state physical source-ty))]
    [(Memory _) (Ok (Expr state physical source-ty))]
    [(ByRef _) (Ok (Expr state physical source-ty))]
    [(Unsupported message)
      (Err (box (lower-diagnostic-at-expr ctx origin message)))]
    [(Sret _)
      (Err
        (box
          (lower-diagnostic-at-expr
            ctx
            origin
            "lower: structural return classification used for parameter")))]))

(define (lower-bind-internal-params-at
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [physical-index : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [origin : ast.AstExpr]) : ResultLowerEnv
  (if (>= index (ast.ast-param-list-len params))
    (Ok state env type-env)
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name ty _)
        (let
          [source-ty : ast.AstType
            (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
          [physical-value : ir.CompilerIrValue (Var physical-index)]
          [classification : LowerCAbiAggregate
            (lower-internal-param-class
              ctx
              mode
              (lower-global-shared-view source-ty))]
          [materialized
            (try
              (lower-internal-param-storage
                ctx
                state
                physical-value
                (lower-global-shared-view source-ty)
                classification
                (lower-global-shared-view origin)))]
          (match materialized
            [(Expr next-state source-value _)
              (lower-bind-internal-params-at
                ctx
                mode
                params
                (+ index 1)
                (+ physical-index 1)
                next-state
                (sym_i64_env.sym-i64-bind-id
                  env
                  name
                  (match source-value
                    [(Var source-var) source-var]
                    [_ physical-index]))
                (tc_core.tc-bind-id type-env name source-ty)
                origin)]))])))

(define (lower-bind-internal-params
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [params : (& params ast.AstParamList)]
  [source-start : i64]
  [state : LowerState]
  [env : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [origin : ast.AstExpr]) : ResultLowerEnv
  (lower-bind-internal-params-at
    ctx
    mode
    (& params)
    0
    source-start
    state
    env
    type-env
    origin))

(define (lower-pointer-proof-type [ctx : tc_core.TcContext] [ty : ast.AstType]) : pointer_proof.PointerProofType
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ty))]
    (match (lower-global-shared-view resolved)
      [(Ptr _) Pointer]
      [(MutPtr _) MutablePointer]
      [_
        (if (tc_core.tc-integer-type? (lower-global-shared-view resolved))
          Integer
          NonPointer)])))

(define (lower-pointer-proof-scalar-type? [ty : pointer_proof.PointerProofType]) : bool
  (match ty
    [(Integer) true]
    [(NonPointer) true]
    [_ false]))

;; These cases give provenance semantics; all other child enumeration uses the
;; shared AST walker. An unknown pointer-producing case is explicitly incomplete.
(define (lower-pointer-proof-operation
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [bindings : sym_i64_env.SymI64Env]
  [expr : ast.AstExpr]
  [ty : pointer_proof.PointerProofType]) : pointer_proof.PointerProofOperation
  (match expr
    [(Var name)
      (let
        [binding : i64 (sym_i64_env.sym-i64-lookup-id-or (& bindings) name -1)]
        (if (>= binding 0)
          (Read binding)
          (Global
            (ir.compiler-ir-symbol-typed-id
              (lower-resolve-call-name-id state bindings name)))))]
    [(PtrCast _ _) PointerCast]
    [(PtrToInt _) PointerToInteger]
    [(IntToPtr _ _) IntegerToPointer]
    [(PtrNull _) Null]
    [(PtrOffset _ _) Offset]
    [(PtrAddrOf _) AddressOf]
    [(PtrRead _) MemoryRead]
    [(StringData _) StringData]
    [(ArrayData _) ArrayData]
    [(ProgramArgv) ProgramArgv]
    [(ProgramEnvp) ProgramEnvp]
    [(TupleRef _ index) (TupleProjection index)]
    [(StructGet _ field) (StructProjection field)]
    [(ArrayRef _ _) ArrayProjection]
    [(BoxGet _) BoxProjection]
    [(BoxTake _) BoxProjection]
    [(Literal literal)
      (match literal
        [(String _) StaticStorage]
        [_ Scalar])]
    [(BinaryData _) StaticStorage]
    [(Cast _ _) IntegerCast]
    [(Ann _ _) Identity]
    [(If _ _ _) Join]
    [(Begin _) Sequence]
    [(Unsafe _) Sequence]
    [(Let _) Sequence]
    [(While _ _) Loop]
    [(Return _) Return]
    [(Set name _)
      (Assignment (sym_i64_env.sym-i64-lookup-id-or (& bindings) name -1))]
    [(Call func-id _)
      (match (ast.ast-expr-unspan-with-segment-bases
        (tc_core.tc-context-expr-bases ctx)
        (lower-context-expr-get ctx func-id))
        [(Var name)
          (let
            [names : LowerNameCache (lower-state-names state)]
            [lookup : i64
              (lower-name-cache-resolve-logical-id (& names) name name)]
            [callable : bool
              (and
                (not (sym_i64_env.sym-i64-contains-id bindings name))
                (lower-top-level-callable-lookup-id?
                  ctx
                  (lower-callable-lookup-id ctx name lookup)))]
            (if callable
              (DirectCall
                (ir.compiler-ir-symbol-typed-id
                  (lower-resolve-call-name-id state bindings name)))
              IndirectCall))]
        [_ IndirectCall])]
    ;; Binder forms other than let and parameters are not modelled. A read of
    ;; one of their bindings would miss the capture's bindings and could
    ;; resolve to a same-named global, so they fail closed at any type.
    [(Match _) Unsupported]
    [(Lambda _) Unsupported]
    [(Foreach _) Unsupported]
    [(ForOwnedState _) Unsupported]
    [(ForOwnedStep _) Unsupported]
    [(SpmdReduce _) Unsupported]
    [(SpmdScan _) Unsupported]
    [(SpmdCompact _) Unsupported]
    [(WithResource _) Unsupported]
    [_
      (if (lower-pointer-proof-scalar-type? ty)
        Scalar
        Unsupported)]))

(define (lower-pointer-proof-capture-id
  [input : pointer_proof.PointerProofInput]
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [bindings : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [id : i64]
  [span : ir.CompilerMaybeSourceSpan]) : pointer_proof.PointerProofRef
  (lower-pointer-proof-capture-expr
    input
    ctx
    state
    bindings
    type-env
    (lower-context-expr-get ctx id)
    span))

(define (lower-pointer-proof-source-path
  [input : pointer_proof.PointerProofInput]
  [state : LowerState]) : String
  (let
    [path-id : i64 (lower-state-current-source-path-id state)]
    [path : String
      (if (> path-id 0)
        (compiler-lower-state-name-text (lower-state-owner state) path-id)
        "")]
    (if (or
      (= (string.string-length (& path)) 0)
      (string.eq (& path) "<source>"))
      (pointer_proof.pointer-proof-input-default-path input)
      path)))

(define (lower-pointer-proof-capture-expr
  [input : pointer_proof.PointerProofInput]
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [bindings : sym_i64_env.SymI64Env]
  [type-env : tc_core.TcTypeEnv]
  [expr : ast.AstExpr]
  [span : ir.CompilerMaybeSourceSpan]) : pointer_proof.PointerProofRef
  (match (lower-global-shared-view expr)
    [(Spanned inner own-span)
      (lower-pointer-proof-capture-id
        input
        ctx
        state
        bindings
        type-env
        inner
        (Some own-span))]
    [(MacroExpansion inner _ _)
      (lower-pointer-proof-capture-id
        input
        ctx
        state
        bindings
        type-env
        inner
        span)]
    [_
      (let
        [ty : pointer_proof.PointerProofType
          (match (lower-expr-result-type-or-check
            ctx
            bindings
            type-env
            (lower-state-type-cache state)
            (lower-state-function-state state)
            (& expr))
            [(Ok source-ty) (lower-pointer-proof-type ctx source-ty)]
            [(Err _) Missing])]
        [operation : pointer_proof.PointerProofOperation
          (lower-pointer-proof-operation
            ctx
            state
            bindings
            (lower-global-shared-view expr)
            ty)]
        [operands : proof_refs.Vec
          (pointer_proof.pointer-proof-input-operands input)]
        [function : ir.CompilerIrSymbolId
          (ir.compiler-ir-symbol-typed-id
            (lower-state-current-function-id state))]
        [path : String (lower-pointer-proof-source-path input state)]
        (match operation
          [(Unsupported)
            (pointer_proof.pointer-proof-input-fail-at!
              input
              "pointer proof: unsupported semantic pointer operation"
              (lower-global-shared-view path)
              span)]
          [(Assignment binding)
            (when
              (< binding 0)
              (pointer_proof.pointer-proof-input-fail-at!
                input
                "pointer proof: assignment has no semantic binding"
                (lower-global-shared-view path)
                span))]
          [_ unit])
        (match (lower-global-shared-view expr)
          [(Let payload)
            (match (__tl-box-place payload)
              [(Let lets body)
                (let
                  [local-bindings : sym_i64_env.SymI64Env bindings]
                  [local-types : tc_core.TcTypeEnv type-env]
                  [index : i64 0]
                  (while (< index (ast.ast-let-binding-list-len (& lets)))
                    (match (ast.ast-let-binding-list-get
                      (& lets)
                      index
                      (ast.ast-let-binding-fallback))
                      [(Binding name maybe-ty init)
                        (let
                          [value : pointer_proof.PointerProofRef
                            (lower-pointer-proof-capture-id
                              input
                              ctx
                              state
                              local-bindings
                              local-types
                              init
                              span)]
                          [edges : proof_refs.Vec
                            (pointer_proof.pointer-proof-input-operands input)]
                          [binding-type : tc_core.ResultTcType
                            (tc_core.tc-let-binding-plain-type
                              ctx
                              local-types
                              (tc_core.tc-let-binding-resolve-maybe-type
                                ctx
                                maybe-ty)
                              (lower-context-expr-get ctx init))]
                          (pointer_proof.pointer-proof-input-push-operand!
                            input
                            (&mut edges)
                            value)
                          (match binding-type
                            [(Ok source-ty)
                              (let
                                [binding : pointer_proof.PointerProofRef
                                  (pointer_proof.pointer-proof-input-push!
                                    input
                                    function
                                    Binding
                                    (lower-pointer-proof-type
                                      ctx
                                      (lower-global-shared-view source-ty))
                                    edges
                                    (lower-global-shared-view path)
                                    span)]
                                (pointer_proof.pointer-proof-input-push-operand!
                                  input
                                  (&mut operands)
                                  binding)
                                (set!
                                  local-bindings
                                  (sym_i64_env.sym-i64-bind-id
                                    local-bindings
                                    name
                                    binding.index))
                                (set!
                                  local-types
                                  (tc_core.tc-bind-id
                                    local-types
                                    name
                                    source-ty)))]
                            [(Err _)
                              (pointer_proof.pointer-proof-input-fail!
                                input
                                "pointer proof: missing binding type")])
                          (set! index (+ index 1)))]))
                  (pointer_proof.pointer-proof-input-push-operand!
                    input
                    (&mut operands)
                    (lower-pointer-proof-capture-id
                      input
                      ctx
                      state
                      local-bindings
                      local-types
                      body
                      span)))])]
          [_
            (let
              [children : ast.AstExprList
                (ast.ast-expr-child-ids (lower-global-shared-view expr))]
              [child-env : tc_core.TcTypeEnv
                (match (lower-global-shared-view expr)
                  [(Unsafe _) (tc_core.tc-enter-unsafe type-env)]
                  [_ type-env])]
              [start : i64
                (match (lower-global-shared-view expr)
                  [(Call _ _) 1]
                  [_ 0])]
              [index : i64 start]
              (while (< index children.len)
                (pointer_proof.pointer-proof-input-push-operand!
                  input
                  (&mut operands)
                  (lower-pointer-proof-capture-id
                    input
                    ctx
                    state
                    bindings
                    child-env
                    (ast.ast-expr-list-get (& children) index -1)
                    span))
                (set! index (+ index 1))))])
        (pointer_proof.pointer-proof-input-push!
          input
          function
          operation
          ty
          operands
          path
          span))]))

(define (lower-pointer-proof-capture-function!
  [ctx : tc_core.TcContext]
  [state : LowerState]
  [type-env : tc_core.TcTypeEnv]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]) : unit
  (match (compiler-lower-state-read
    (lower-state-owner state)
    pointer_proof.PointerProofRequest
    pointer-proof-request)
    [(Disabled) unit]
    [(Requested input)
      (let
        [bindings : sym_i64_env.SymI64Env (sym_i64_env.sym-i64-empty)]
        [references : proof_refs.Vec
          (pointer_proof.pointer-proof-input-operands input)]
        [symbol : ir.CompilerIrSymbolId
          (ir.compiler-ir-symbol-typed-id
            (lower-state-current-function-id state))]
        [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
        [span : ir.CompilerMaybeSourceSpan
          (lower-ast-expr-span (& pools) (lower-global-shared-view body))]
        [index : i64 0]
        (while (< index (ast.ast-param-list-len (& params)))
          (match (ast.ast-param-list-get
            (& params)
            index
            (ast.ast-param-fallback))
            [(Param name source-ty _)
              (let
                [reference : pointer_proof.PointerProofRef
                  (pointer_proof.pointer-proof-input-push!
                    input
                    symbol
                    (Parameter index)
                    (lower-pointer-proof-type ctx source-ty)
                    (pointer_proof.pointer-proof-input-operands input)
                    (lower-pointer-proof-source-path input state)
                    span)]
                (set!
                  bindings
                  (sym_i64_env.sym-i64-bind-id bindings name reference.index))
                (pointer_proof.pointer-proof-input-push-operand!
                  input
                  (&mut references)
                  reference)
                (set! index (+ index 1)))]))
        (pointer_proof.pointer-proof-input-add-function!
          input
          (pointer_proof.PointerProofFunction
            symbol
            references
            (lower-pointer-proof-capture-expr
              input
              ctx
              state
              bindings
              type-env
              body
              span)
            (lower-pointer-proof-type ctx ret))))]))

(define (lower-param-list-into!
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]
  [idx : i64]
  [builder : (&mut builder ir.CompilerIrParamBuilder)]) : unit
  (if (>= index (ast.ast-param-list-len params))
    unit
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param name ty _)
        (ir.compiler-ir-param-builder-push!
          builder
          (ir.CompilerIrParam.Param
            (tc_core.tc-env-key-name-text name)
            (let
              [ty-arg
                (tc_core.tc-type-without-regions
                  (tc_core.tc-type-strip-invalidate
                    (tc_core.tc-resolve-type ctx ty)))]
              (lower-one-word-register-storage-type ctx ty-arg))
            idx))
        (lower-param-list-into! ctx params (+ index 1) (+ idx 1) builder)])))

;; sret ABI: append the hidden result-slot pointer param at index
;; `sret-var` (the var id reserved just past the real params). Internal calling
;; convention only -- C-ABI externs keep their own ABI on a separate path.
(define (lower-param-list-append-sret
  [params : ir.CompilerIrParamSeq]
  [sret-var : i64]) : ir.CompilerIrParamSeq
  (ir.compiler-ir-param-seq-append-one
    params
    (Param (ir.compiler-ir-hidden-sret-param-name) (U64) sret-var)))

(define (lower-supported-function-param-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (lower-supported-reference-type? ctx ty))

(define (lower-type-contains-inline-aggregate?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))
    [(Struct _) true]
    [(StructArgs _ _) true]
    [(Enum _) true]
    [(EnumArgs _ _) true]
    [(Tuple _) true]
    [(Array _ _) true]
    [(Region _ inner)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc_core.tc-context-type-get ctx inner))]
    ;; A reference can point INTO the current frame (memory-aggregate
    ;; locals live in frame slots), so a ref arg whose referent is or
    ;; contains an inline aggregate makes a tail call unsafe -- the callee
    ;; would read through a pointer into the reused/abandoned frame.
    [(Ref _ referent)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc_core.tc-context-type-get ctx referent))]
    [(MutRef _ referent)
      (lower-type-contains-inline-aggregate?
        ctx
        (tc_core.tc-context-type-get ctx referent))]
    [_ false]))

(define (lower-param-list-contains-unsupported-reference?
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]) : bool
  (lower-param-list-contains-unsupported-reference-at? ctx (& params) 0))

(define (lower-param-list-contains-unsupported-reference-at?
  [ctx : tc_core.TcContext]
  [params : (& params ast.AstParamList)]
  [index : i64]) : bool
  (if (>= index (ast.ast-param-list-len params))
    false
    (match (ast.ast-param-list-get params index (ast.ast-param-fallback))
      [(Param _ ty _)
        (or
          (not (lower-supported-function-param-type? ctx ty))
          (lower-param-list-contains-unsupported-reference-at?
            ctx
            params
            (+ index 1)))])))

(define (lower-supported-function-return-type?
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : bool
  (match (tc_core.tc-resolve-type ctx ty)
    [(Region _ inner)
      (lower-supported-function-return-type?
        ctx
        (tc_core.tc-context-type-get ctx inner))]
    [_ true]))

;; sret ABI: a `__global_init_<name>` initializer's result is stored into
;; a forever-lived global by the backend's startup sequence (not a normal call
;; site), so it must return stable arena storage -- never a caller stack sret
;; slot. Keep these on the arena return path.
(define (lower-global-init-function-symbol?
  [names : (& names LowerNameCache)]
  [symbol : i64]) : bool
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns
        (compiler-lower-state-from-name-cache names))]
    (ci.intern-compat-state-generated-role-symbol?
      (& intern-state)
      symbol
      (ci.intern-generated-symbol-role-global-initializer))))

(define (lower-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [function-state : CompilerLowerFunctionState]
  [logical-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (if (or
    (lower-param-list-contains-unsupported-reference? ctx params)
    (not (lower-supported-reference-type? ctx (lower-global-shared-view ret))))
    (Err (box (lower-diagnostic (lower-reference-support-message))))
    (let
      [param-count : i64 (lower-param-count params)]
      [ret-ty : ast.AstType
        (tc_core.tc-type-without-regions (tc_core.tc-resolve-type ctx ret))]
      [global-init? : bool
        (lower-global-init-function-symbol? names logical-name)]
      [ret-class : LowerCAbiAggregate
        (lower-internal-return-class-for-symbol
          ctx
          mode
          (lower-global-shared-view names)
          logical-name
          (lower-global-shared-view ret-ty))]
      [structural-sret? : bool
        (match (& ret-class)
          [(Sret _) true]
          [_ false])]
      [nominal-sret? : bool
        (and
          (not structural-sret?)
          (not global-init?)
          (lower-type-inline-struct-or-enum?
            ctx
            (lower-global-shared-view ret-ty))
          (not
            (lower-type-register-resident?
              ctx
              (lower-global-shared-view ret-ty))))]
      [source-start : i64
        (if structural-sret?
          1
          0)]
      [structural-params? : bool
        (lower-internal-param-list-contains-structural? ctx params)]
      [sret-var : i64
        (if structural-sret?
          0
          (if nominal-sret?
            (+ source-start param-count)
            (- 0 1)))]
      [ret-ir-ty : ast.AstType
        (match (& ret-class)
          [(Unsupported _) (U64)]
          [_
            (lower-internal-return-physical-type
              ctx
              mode
              (lower-global-shared-view ret-ty))])]
      [type-env : tc_core.TcTypeEnv
        (tc_core.tc-bind-return-type
          (tc_core.tc-bind-params
            ctx
            (tc_core.tc-hygiene-global-env top-env)
            params)
          (lower-global-shared-view ret-ty))]
      [function-spans : ir.CompilerSourceSpans
        (lower-record-function-span
          (compiler-lower-state-from-name-cache names)
          (& (tc_core.tc-context-pools ctx))
          spans
          (ir.compiler-ir-symbol-typed-id logical-name)
          (lower-global-shared-view body))]
      [state : LowerState
        (lower-state-new
          (+
            source-start
            param-count
            (if nominal-sret?
              1
              0))
          0
          0
          (ir.compiler-ir-label "entry")
          (ir.compiler-ir-instr-builder-new)
          (ir.compiler-ir-block-builder-new)
          (ir.compiler-ir-function-builder-new)
          logical-name
          (box function-spans)
          names
          type-cache
          function-state
          mode
          (lower_i64_i64_map.with-capacity 8)
          source-start
          (+ source-start param-count))]
      [_pointer-proof : unit
        (lower-pointer-proof-capture-function!
          ctx
          state
          type-env
          (lower-global-shared-view params)
          (lower-global-shared-view ret-ty)
          (lower-global-shared-view body))]
      [_debug-types : unit
        (lower-debug-function-roots!
          (lower-state-owner state)
          ctx
          (lower-global-shared-view params)
          (lower-global-shared-view ret-ty))]
      (match ret-class
        [(Unsupported message)
          (Err (box (lower-diagnostic-at-expr ctx body message)))]
        [_
          (if (lower-supported-function-return-type?
            ctx
            (lower-global-shared-view ret-ty))
            (let
              [initial-env : sym_i64_env.SymI64Env
                (if (>= sret-var 0)
                  (sym_i64_env.sym-i64-bind-id
                    (sym_i64_env.sym-i64-empty)
                    (cis.intern-lower-private-identity-raw
                      (lower-sret-param-marker-id state))
                    sret-var)
                  (sym_i64_env.sym-i64-empty))]
              (match (if structural-params?
                (lower-bind-internal-params
                  ctx
                  mode
                  params
                  source-start
                  state
                  initial-env
                  type-env
                  (lower-global-shared-view body))
                (ResultLowerEnv.Ok
                  state
                  (lower-bind-params params source-start initial-env)
                  type-env))
                [(Ok bound-state bound-env bound-type-env)
                  (let
                    [final-state
                      (try
                        (lower-tail-expr
                          ctx
                          bound-state
                          bound-env
                          bound-type-env
                          body
                          ret-ty
                          sret-var))]
                    [source-params : ir.CompilerIrParamSeq
                      (if structural-params?
                        (lower-internal-param-list
                          ctx
                          mode
                          params
                          source-start
                          structural-sret?)
                        (let
                          [source : ir.CompilerIrParamSeq
                            (lower-param-list ctx params source-start)]
                          (if structural-sret?
                            (ir.compiler-ir-param-seq-prepend
                              (Param
                                (ir.compiler-ir-hidden-sret-param-name)
                                (U64)
                                (- source-start 1))
                              source)
                            source)))]
                    [all-params : ir.CompilerIrParamSeq
                      (if nominal-sret?
                        (lower-param-list-append-sret source-params sret-var)
                        source-params)]
                    (Ok
                      (lower-state-build-functions-with
                        final-state
                        (Function
                          logical-name
                          all-params
                          ret-ir-ty
                          (lower-state-next-var final-state)
                          (lower-state-build-function-blocks final-state)
                          Ordinary))
                      (lower-state-spans final-state)))]
                [(Err message) (Err message)]))
            (Err
              (box
                (lower-diagnostic-at-expr
                  ctx
                  body
                  "lower: unsupported expression"))))]))))

(define (lower-global-value
  [ctx : tc_core.TcContext]
  [names : LowerNameCache]
  [expr : ast.AstExpr]
  [ty : ast.AstType]) : ResultLowerValue
  (match (lower-global-shared-view expr)
    [(Spanned inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-global-value ctx names inner ty))]
    [(MacroExpansion inner-box _ _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-global-value ctx names inner ty))]
    [(Ann inner-box _)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-global-value ctx names inner ty))]
    [(Cast inner-box cast-ty-id)
      (let
        [inner : ast.AstExpr (lower-context-expr-get ctx inner-box)]
        (lower-global-value
          ctx
          names
          inner
          (tc_core.tc-context-type-get ctx cast-ty-id)))]
    [(Literal lit)
      (Ok
        (lower-literal-value-with-type
          (tc_core.tc-context-source-names ctx)
          lit
          ty))]
    [(BinaryData bytes) (Ok (Bytes bytes))]
    [(SpmdProgramIndex) (Ok (I64 0))]
    [(SpmdProgramCount) (Ok (I64 1))]
    [(Var name)
      (let
        [logical-id : i64
          (lower-name-cache-resolve-logical-id (& names) name name)]
        (if (lower-symbol-function-value-id? ctx logical-id)
          (let
            [display-name : String
              (match (lower-name-cache-resolve-id-display
                (lower-global-shared-view names)
                name)
                [(Some resolved) resolved]
                [(No)
                  (lower-name-cache-intern-str
                    names
                    (tc_core.macro-hygiene-global-source-name-id-or
                      (lower-name-cache-structural-session (& names))
                      name
                      name))])]
            [symbol : i64
              (lower-name-cache-ir-symbol names logical-id name display-name)]
            (Ok
              (if (lower-function-type? ty)
                ;; Function values are closure-descriptor pointers. A plain
                ;; Global initializer names the function's code symbol instead,
                ;; which makes the first indirect call interpret instruction
                ;; bytes as a closure.
                (Function symbol)
                (Global symbol))))
          ;; Any other name is a global variable, an extern data symbol or an
          ;; enum variant, and the initializer wants its value. Static data can
          ;; only hold the symbol's address (`.quad symbol`), so the value is
          ;; read by the runtime initializer the caller builds for non-constant
          ;; initializers (#7804).
          (Err
            (box
              (lower-diagnostic
                "lower: global initializer reads a value at startup")))))]
    [_ (lower-global-static-array ctx names expr ty)]))

;; A fixed array of constant scalars is static data (#8369): the global's cell
;; points at the exact element bytes, laid out at the element size `array-ref`
;; addresses, instead of at a copy a startup initializer allocates and fills.
;; Anything else is an unsupported global initializer, for which the caller
;; builds a runtime initializer with its conversions.
(define (lower-global-static-array
  [ctx : tc_core.TcContext]
  [names : LowerNameCache]
  [expr : ast.AstExpr]
  [ty : ast.AstType]) : ResultLowerValue
  (let
    [bytes : byte_buf_core.ByteBufBuilder (byte_buf_core.byte-buf-builder-new)]
    (if (match expr
      [(Array values)
        (lower-static-array-encode! ctx names values ty (&mut bytes))]
      [_ false])
      (Ok
        (StaticArray (byte_buf_core.byte-buf-builder-finish-string (& bytes))))
      (Err (box (lower-diagnostic "lower: unsupported global initializer"))))))

;; Appends the elements' little-endian bytes. False unless `ty` is `(Array T N)`
;; and all N elements are constants of scalar T's kind; an empty array has no
;; element to check, so it is (empty) static data for any T.
(define (lower-static-array-encode!
  [ctx : tc_core.TcContext]
  [names : LowerNameCache]
  [values : ast.AstExprList]
  [ty : ast.AstType]
  [bytes : (&mut bytes byte_buf_core.ByteBufBuilder)]) : bool
  (match (tc_core.tc-resolve-type ctx ty)
    [(Array elem-id count)
      (let
        [elem-ty : ast.AstType
          (tc_core.tc-resolve-type
            ctx
            (tc_core.tc-context-type-get ctx elem-id))]
        [elem-size : i64 (lower-type-size ctx (& elem-ty))]
        [index : i64 0]
        [ok : bool (= values.len count)]
        (while (and ok (< index values.len))
          (match (lower-global-value
            ctx
            (lower-global-shared-view names)
            (lower-context-expr-get ctx (ast.ast-expr-list-get values index 0))
            (lower-global-shared-view elem-ty))
            [(Ok value)
              (if (lower-static-array-element-kind?
                (lower-global-shared-view value)
                (lower-global-shared-view elem-ty))
                (let
                  [bits : i64 (lower-static-array-element-bits value)]
                  [byte : i64 0]
                  (while (< byte elem-size)
                    (byte_buf_core.byte-buf-builder-push
                      bytes
                      (cast (bit-and (shr bits (* 8 byte)) 255) : u8))
                    (set! byte (+ byte 1))))
                (set! ok false))]
            [(Err _) (set! ok false)])
          (set! index (+ index 1)))
        ok)]
    [_ false]))

;; Whether constant `value` is data of scalar type `ty`: integer literals only
;; for integer elements, float bits (already in `ty`'s width) only for floats.
(define (lower-static-array-element-kind?
  [value : ir.CompilerIrValue]
  [ty : ast.AstType]) : bool
  (match value
    [(I64 _) (tc_core.tc-integer-type? ty)]
    [(F64 _)
      (match ty
        [(F64) true]
        [(F32) true]
        [_ false])]
    [(Bool _)
      (match ty
        [(Bool) true]
        [_ false])]
    [(Char _)
      (match ty
        [(Char) true]
        [_ false])]
    [_ false]))

;; The element's bits, little-endian from bit 0; only the element size's low
;; bytes are stored.
(define (lower-static-array-element-bits [value : ir.CompilerIrValue]) : i64
  (match value
    [(I64 n) n]
    [(F64 bits) (cast bits : i64)]
    [(Bool b)
      (if b
        1
        0)]
    [(Char c) (cast c : i64)]
    [_ 0]))

(define (lower-global-init-function-name
  [lower-state : CompilerLowerState]
  [global : i64]) : i64
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    (ci.intern-compat-state-generated-role-symbol-id
      (&mut intern-state)
      (ci.intern-generated-symbol-role-global-initializer)
      global)))

(define (lower-top-decl-type-or-check
  [ctx : tc_core.TcContext]
  [env : tc_core.TcTypeEnv]
  [decl : ast.AstDecl]) : tc_core.ResultTcType
  (let
    [actual : ast.AstDecl (ast.ast-decl-unwrapped decl)]
    (match (lower-global-shared-view actual)
      [(Def decl-meta name _ _)
        (match (tc_core.tc-lookup-id env name)
          [(Ok ty) (Ok ty)]
          [(Err _) (tc_core.tc-top-decl-type-with-env ctx env actual)])]
      [_ (tc_core.tc-top-decl-type-with-env ctx env actual)])))

;; The span a function's provenance row records: the body's own span. A body
;; of several forms reaches lowering as the parser's implicit `Begin`
;; (`parse-ast-body-tail`), which has no `Spanned` wrapper, so it takes its
;; first form's span -- where an explicit `(begin ...)` around the same forms
;; would have started. Without it such a function had no location in a
;; `--backtrace` map, and a `stdlib/runtime.tl` frame escaped the renderer's
;; runtime-path filter (#8651).
(define (lower-function-body-span
  [pools : (& pools ast.AstNodePoolContext)]
  [body : ast.AstExpr]) : ir.CompilerMaybeSourceSpan
  (match body
    [(Spanned _ span) (Some span)]
    [(Begin exprs)
      (if (> exprs.len 0)
        (lower-ast-expr-direct-span
          (ast.ast-node-pool-context-expr-get
            pools
            (ast.ast-expr-list-get (& exprs) 0 0)))
        (No))]
    [_ (No)]))

;; Record `name -> body span` into the provenance table. A function whose
;; body carries no source span leaves the table unchanged, so the backend simply
;; falls back to its default location for that function.
(define (lower-record-function-span
  [lower-state : CompilerLowerState]
  [pools : (& pools ast.AstNodePoolContext)]
  [spans : ir.CompilerSourceSpans]
  [name : ir.CompilerIrSymbolId]
  [body : ast.AstExpr]) : ir.CompilerSourceSpans
  (match (lower-function-body-span pools body)
    [(Some span)
      (if (ir.compiler-debug-info-enabled?)
        (ir.compiler-source-spans-insert-located
          spans
          name
          (compiler-lower-state-read lower-state i64 current-source-path-id)
          span)
        (ir.compiler-source-spans-insert spans name span))]
    [(No) spans]))

;; Reusable per-function lowering scratch arena. Lowering one function
;; allocates a fresh `LowerState` plus the transient IR/AST-walk scratch the bump
;; allocator never frees; summed across a large program's functions this
;; transient would dominate the lower phase's peak live.
;; We lower each function inside one shared scratch arena and `tl_region_reset` it
;; after deep-`clone`ing ONLY the produced IR function list back into the
;; enclosing (program) arena -- reclaiming the per-function transient before the
;; next function. The arena is created lazily once and reused (rewound, never
;; remapped) per function, mirroring the optimizer's per-function escape
;; (`optimize-function-escaping-with-summaries`). The spans side-table
;; insertion is recomputed in the enclosing arena (it never affects emitted
;; assembly, only backend-error source locations). `lower-function-escaping`
;; is only ever called at decl granularity (never re-entrant within
;; `lower-function`'s body walk), so a single shared mark/rewind region is
;; sound. Output stays byte-identical: the
;; clone is a structural deep copy, so the escaped IR lowers to the same assembly
;; as the in-place IR did.
;; Dotted imports create transient lookup-key strings during function lowering
;; (`module/name` from `alias.name`). Any new intern entry made from those
;; strings must survive the scratch rewind, so the scope mirrors
;; `tc-check-fn-decl-scoped` and forces persistent intern storage while active.
(define lower-scratch-arena : i64
  0)

(define (lower-scratch-arena-get) : i64
  (if (= lower-scratch-arena 0)
    (let
      [scratch : i64 (arena.tl_arena_make)]
      (set! lower-scratch-arena scratch)
      scratch)
    lower-scratch-arena))

(define (lower-scratch-arena-release!) : unit
  (unless
    (= lower-scratch-arena 0)
    (unsafe
      (arena.tl_arena_destroy lower-scratch-arena))
    (set! lower-scratch-arena 0)))

;; Dedicated arena for the escaped (lowered) IR function bodies. The
;; lowered IR is consumed exactly once: at opt levels >= 1 the optimizer
;; deep-clones every surviving function into the enclosing arena
;; (optimize-function-escaping-with-summaries), after which the entire input IR
;; is dead -- memory the program-lifetime arena would
;; never reclaim. Cloning the lowered functions into this arena instead lets
;; the driver destroy it right after optimization. At opt level 0 the
;; program flows to the backend unchanged, so the arena must stay alive for
;; the whole compile (the driver only releases it for levels >= 1; batch
;; compiles release it between entries). Globals, externs, and the spans
;; side-table are NOT allocated here -- they outlive optimization.
(define lower-ir-arena : i64
  0)

(define (lower-ir-arena-get) : i64
  (if (= lower-ir-arena 0)
    (let
      [arena : i64 (arena.tl_arena_make)]
      (set! lower-ir-arena arena)
      arena)
    lower-ir-arena))

(define (lower-ir-arena-release!) : unit
  (unless
    (= lower-ir-arena 0)
    (unsafe
      (arena.tl_arena_destroy lower-ir-arena))
    (set! lower-ir-arena 0)))

(define (lower-arenas-release!) : unit
  (lower-scratch-arena-release!)
  (lower-ir-arena-release!))

(define (compiler-lower-arena-state-new) : CompilerLowerArenaState
  (let
    [scratch : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    [ir : (__tl_dyn-array i64) (__tl_make-array i64 1)]
    (set! (array-ref scratch 0) 0)
    (set! (array-ref ir 0) 0)
    (CompilerLowerArenaState scratch ir)))

(define (compiler-lower-arena-state-scratch-arena
  [state : (& state CompilerLowerArenaState)]) : i64
  (array-ref state.scratch-arena 0))

(define (compiler-lower-arena-state-ir-arena
  [state : (& state CompilerLowerArenaState)]) : i64
  (array-ref state.ir-arena 0))

(define (compiler-lower-arena-state-set!
  [state : (& state CompilerLowerArenaState)]
  [scratch : i64]
  [ir : i64]) : unit
  (set! (array-ref state.scratch-arena 0) scratch)
  (set! (array-ref state.ir-arena 0) ir))

(define (compiler-lower-arena-state-capture-from-globals!
  [state : CompilerLowerArenaState]) : unit
  (compiler-lower-arena-state-set! state lower-scratch-arena lower-ir-arena))

(define (compiler-lower-arena-state-install! [state : CompilerLowerArenaState]) : unit
  (set! lower-scratch-arena (compiler-lower-arena-state-scratch-arena state))
  (set! lower-ir-arena (compiler-lower-arena-state-ir-arena state)))

;; State-owned release: destroy the arenas named by the state's own cells and
;; zero them. The compatibility-global selectors are zeroed only when they
;; still name this state's handles (the state is the installed owner);
;; releasing an uninstalled state must not disturb another state's installed
;; arenas. Destroying an older head still reclaims the whole chain -- the
;; runtime root tracks the newest live segment -- but callers must refresh the
;; state's cells from the globals after any phase that can grow a chain
;; (post-emission session-floor capture), so a stored head never trails the
;; installed selector by the time a release runs.
(define (compiler-lower-arena-state-release-scratch!
  [state : (& state CompilerLowerArenaState)]) : unit
  (let
    [scratch : i64 (compiler-lower-arena-state-scratch-arena state)]
    (unless
      (= scratch 0)
      (set! (array-ref state.scratch-arena 0) 0)
      (if (= lower-scratch-arena scratch)
        (set! lower-scratch-arena 0)
        unit)
      (unsafe
        (arena.tl_arena_destroy scratch)))))

(define (compiler-lower-arena-state-release-ir!
  [state : (& state CompilerLowerArenaState)]) : unit
  (let
    [ir : i64 (compiler-lower-arena-state-ir-arena state)]
    (unless
      (= ir 0)
      (set! (array-ref state.ir-arena 0) 0)
      (if (= lower-ir-arena ir)
        (set! lower-ir-arena 0)
        unit)
      (unsafe
        (arena.tl_arena_destroy ir)))))

(define (compiler-lower-arena-state-release! [state : CompilerLowerArenaState]) : unit
  (compiler-lower-arena-state-release-scratch! state)
  (compiler-lower-arena-state-release-ir! state))

(define (lower-function-seq-escape-to-ir-arena
  [functions : ir.CompilerIrFunctionSeq]) : ir.CompilerIrFunctionSeq
  (in-arena
    (arena.Arena (lower-ir-arena-get))
    (ir.compiler-ir-clone-function-seq
      (ast.ast-node-pool-reader-context-current)
      functions)))

(define (lower-function-escaping
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [params : ast.AstParamList]
  [ret : ast.AstType]
  [body : ast.AstExpr]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [enclosing : i64 (arena.tl_arena_current)]
    [scratch : i64 (lower-scratch-arena-get)]
    [job-state : tc_core.TcJobState (tc_core.tc-context-job-state ctx)]
    ;; Type-name/owner caches may contain keys allocated by earlier
    ;; typecheck or lower scratch scopes. Keep them scoped to this lowering
    ;; pass and invalidate them before rewinding this function's scratch arena.
    (tc_core.tc-nominal-owner-cache-reset-for-job! job-state)
    (unsafe
      (arena.tl_arena_set scratch))
    (let
      [mark : i64 (arena.tl_region_mark)]
      [function-state : CompilerLowerFunctionState
        (compiler-lower-function-state-new
          (compiler-lower-state-from-name-cache names))]
      (match (lower-function
        ctx
        top-env
        type-cache
        function-state
        logical-name
        params
        ret
        body
        (lower-global-shared-view spans)
        names
        mode)
        [(Ok fns function-spans)
          (let
            [escaped-fns : ir.CompilerIrFunctionSeq
              (lower-function-seq-escape-to-ir-arena fns)]
            ;; The IR function clones go to the dedicated lowered-IR
            ;; arena (released by the driver after optimization); the
            ;; spans side-table is rebuilt in the enclosing arena since
            ;; it outlives the lowered IR. Stable-root arena handles preserve
            ;; both owners across any segment growth during those clones.
            (unsafe
              (arena.tl_arena_set enclosing))
            (let
              [escaped-spans : ir.CompilerSourceSpans
                (ir.compiler-source-spans-append-new spans function-spans)]
              (unsafe
                (arena.tl_arena_set scratch)
                (arena.tl_region_reset mark)
                (arena.tl_arena_set enclosing))
              (tc_core.tc-nominal-owner-cache-reset-for-job! job-state)
              (Ok escaped-fns escaped-spans)))]
        [(Err message)
          (unsafe
            (arena.tl_arena_set enclosing))
          (let
            [escaped-message : (Box cdiag.CompilerDiagnostic) (clone message)]
            (unsafe
              (arena.tl_arena_set scratch)
              (arena.tl_region_reset mark)
              (arena.tl_arena_set enclosing))
            (tc_core.tc-nominal-owner-cache-reset-for-job! job-state)
            (Err escaped-message))]))))

(define (lower-struct-cleanup-param-id [lower-state : CompilerLowerState]) : i64
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    [id : i64
      (ci.intern-compat-state-generated-role-symbol-id
        (&mut intern-state)
        (ci.intern-generated-symbol-role-cleanup-parameter)
        0)]
    ;; This identity enters a synthetic AST immediately, so construction of
    ;; that AST is the text boundary for the local parameter spelling.
    (ci.intern-compat-state-generated-role-symbol-materialize!
      (&mut intern-state)
      (ci.intern-generated-symbol-role-cleanup-parameter)
      id
      "__tl_cleanup_value")
    id))

(define (lower-struct-cleanup-qualified-id
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [struct-id : i64]
  [cleanup-id : i64]) : i64
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    (if (or
      (< cleanup-id 0)
      (and
        (>= cleanup-id 0)
        (< cleanup-id (ci.intern-capacity))
        (or
          (< cleanup-id (ci.intern-compat-state-pool-len (& intern-state)))
          (not
            (ci.intern-compat-state-macro-local-name-id?
              (& intern-state)
              cleanup-id)))
        (ci.intern-compat-state-qualified? (& intern-state) cleanup-id))
      (>= cleanup-id (ci.intern-capacity)))
      cleanup-id
      (let
        [handle : i64
          (csym.compiler-symbols-lookup-type-id-or
            (tc_core.tc-context-symbols ctx)
            struct-id
            (csym.compiler-symbols-missing-handle))]
        [module-id : i64
          (if (csym.compiler-symbols-handle-found? handle)
            (csym.compiler-symbols-owner-module-id-at-index-or
              (tc_core.tc-context-symbols ctx)
              (csym.compiler-symbol-handle-index handle)
              cbi.compiler-builtin-id-fix-empty)
            cbi.compiler-builtin-id-fix-empty)]
        (if (or (< module-id 0) (= module-id cbi.compiler-builtin-id-fix-empty))
          cleanup-id
          (let
            [components : i64
              (ci.intern-compat-state-composite-pair-id
                (&mut intern-state)
                struct-id
                cleanup-id)]
            [id : i64
              (ci.intern-compat-state-generated-role-qualified-symbol-id
                (&mut intern-state)
                (ci.intern-generated-symbol-role-cleanup-helper)
                components
                module-id
                cleanup-id)]
            [display : String
              (csym.compiler-symbol-module-key
                (ci.intern-compat-state-str intern-state module-id)
                (ci.intern-compat-state-str intern-state cleanup-id))]
            ;; Synthetic cleanup calls resolve this qualified name during
            ;; their immediate typecheck/lowering boundary.
            (ci.intern-compat-state-generated-role-symbol-materialize!
              (&mut intern-state)
              (ci.intern-generated-symbol-role-cleanup-helper)
              id
              display)
            id))))))

(define (lower-struct-cleanup-id-for-struct
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [struct-id : i64]) : tc_core.ResultTcNameId
  (let
    [decl (try (tc_core.tc-struct-decl-id ctx struct-id))]
    (match decl
      [(TcStructDecl _ cleanup _)
        (match cleanup
          [(Fn cleanup-name)
            (Ok
              (lower-struct-cleanup-qualified-id
                lower-state
                ctx
                struct-id
                (ci.intern-syntax-id-value cleanup-name)))]
          [(No)
            (Err
              (str_cat.str-cat
                "lower: owned cleanup field type has no cleanup function "
                (tc_core.tc-nominal-name-id-display struct-id)))])])))

(define (lower-enum-cleanup-id-for-enum
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [enum-id : i64]) : tc_core.ResultTcNameId
  (let
    [decl (try (tc_core.tc-enum-decl-id ctx enum-id))]
    (match decl
      [(TcEnumDecl cleanup _)
        (match cleanup
          [(Fn cleanup-name)
            (Ok
              (lower-struct-cleanup-qualified-id
                lower-state
                ctx
                enum-id
                (ci.intern-syntax-id-value cleanup-name)))]
          [(No)
            (Err
              (str_cat.str-cat
                "lower: owned cleanup payload type has no cleanup function "
                (tc_core.tc-nominal-name-id-display enum-id)))])])))

(define (lower-struct-cleanup-id-for-type
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : tc_core.ResultTcNameId
  (let
    [resolved : ast.AstType
      (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))]
    (match (lower-global-shared-view resolved)
      [(Struct name) (lower-struct-cleanup-id-for-struct lower-state ctx name)]
      [(StructArgs name _)
        (lower-struct-cleanup-id-for-struct lower-state ctx name)]
      [(Enum name) (lower-enum-cleanup-id-for-enum lower-state ctx name)]
      [(EnumArgs name _) (lower-enum-cleanup-id-for-enum lower-state ctx name)]
      [_
        (Err
          (str_cat.str-cat
            "lower: owned cleanup field type is not a cleanup-owning aggregate "
            (tc_core.tc-type-render resolved)))])))

(define (lower-struct-cleanup-call-expr
  [pools : ast.AstNodePoolContext]
  [cleanup-name-id : i64]
  [value-name-id : i64]
  [field-name-id : i64]) : i64
  (ast.ast-expr-call-with-pools
    pools
    (ast.ast-node-pool-context-expr-push pools (Var cleanup-name-id))
    (ast.ast-expr-cons
      (ast.ast-expr-struct-get-id-with-pools
        pools
        (ast.ast-node-pool-context-expr-push pools (Var value-name-id))
        field-name-id)
      (ast.ast-expr-list-new))))

(define (lower-struct-cleanup-field-exprs
  [lower-state : CompilerLowerState]
  [pools : ast.AstNodePoolContext]
  [ctx : tc_core.TcContext]
  [value-name-id : i64]
  [field : ast.AstFieldDef]
  [acc : ast.AstExprList]) : parser.ResultAstExprList
  (match field
    [(Def field-name ty cleanup)
      (match cleanup
        [(No) (Ok acc)]
        [(Fn cleanup-name)
          (Ok
            (ast.ast-expr-cons
              (lower-struct-cleanup-call-expr
                pools
                (ci.intern-syntax-id-value cleanup-name)
                value-name-id
                (ci.intern-syntax-id-value field-name))
              acc))]
        [(Owned)
          (let
            [cleanup-name-id : i64
              (try (lower-struct-cleanup-id-for-type lower-state ctx ty))]
            (Ok
              (ast.ast-expr-cons
                (lower-struct-cleanup-call-expr
                  pools
                  cleanup-name-id
                  value-name-id
                  (ci.intern-syntax-id-value field-name))
                acc)))])]))

(define (lower-struct-cleanup-body-fields
  [lower-state : CompilerLowerState]
  [pools : ast.AstNodePoolContext]
  [ctx : tc_core.TcContext]
  [value-name-id : i64]
  [fields : ast.AstFieldDefList]
  [acc : ast.AstExprList]) : parser.ResultAstExprList
  (lower-struct-cleanup-body-fields-at
    lower-state
    pools
    ctx
    value-name-id
    (& fields)
    acc
    0))

(define (lower-struct-cleanup-body-fields-at
  [lower-state : CompilerLowerState]
  [pools : ast.AstNodePoolContext]
  [ctx : tc_core.TcContext]
  [value-name-id : i64]
  [fields : (& fields ast.AstFieldDefList)]
  [acc : ast.AstExprList]
  [index : i64]) : parser.ResultAstExprList
  (if (>= index fields.len)
    (Ok acc)
    (let
      [next : ast.AstExprList
        (try
          (lower-struct-cleanup-field-exprs
            lower-state
            pools
            ctx
            value-name-id
            (ast.ast-field-def-list-get
              fields
              index
              (ast.ast-field-def-fallback))
            acc))]
      (lower-struct-cleanup-body-fields-at
        lower-state
        pools
        ctx
        value-name-id
        fields
        next
        (+ index 1)))))

(define (lower-struct-cleanup-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [struct-ty : ast.AstType]
  [fields : ast.AstFieldDefList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [lower-state : CompilerLowerState
      (compiler-lower-state-from-name-cache names)]
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    [value-name-id : i64 (lower-struct-cleanup-param-id lower-state)]
    (match (lower-struct-cleanup-body-fields
      lower-state
      pools
      ctx
      value-name-id
      fields
      (ast.ast-expr-list-new))
      [(Ok exprs)
        (let
          [params : ast.AstParamList
            (ast.ast-param-cons
              (ast.ast-param-id value-name-id struct-ty false)
              (ast.ast-param-list-new))]
          [body : ast.AstExpr
            (if (= exprs.len 0)
              (Literal Unit)
              (Begin exprs))]
          (lower-function-escaping
            ctx
            top-env
            type-cache
            logical-name
            params
            (Unit)
            body
            spans
            names
            mode))]
      [(Err message) (Err (box (lower-diagnostic message)))])))

(define (lower-struct-cleanup-decl
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [cleanup : ast.AstStructCleanup]
  [struct-ty : ast.AstType]
  [fields : ast.AstFieldDefList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match cleanup
    [(No) (Ok (ir.compiler-ir-function-seq-empty) spans)]
    [(Fn _)
      (lower-struct-cleanup-function
        ctx
        top-env
        type-cache
        logical-name
        struct-ty
        fields
        spans
        names
        mode)]))

(define (lower-enum-cleanup-payload-id
  [lower-state : CompilerLowerState]
  [index : i64]) : i64
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    [id : i64
      (ci.intern-compat-state-generated-role-symbol-id
        (&mut intern-state)
        (ci.intern-generated-symbol-role-cleanup-payload)
        index)]
    (ci.intern-compat-state-generated-role-symbol-materialize!
      (&mut intern-state)
      (ci.intern-generated-symbol-role-cleanup-payload)
      id
      (str_cat.str-cat "__tl_cleanup_payload_" (string.int->string index)))
    id))

(define (lower-enum-cleanup-call-expr
  [pools : ast.AstNodePoolContext]
  [cleanup-name-id : i64]
  [value-name-id : i64]) : i64
  (ast.ast-expr-call-with-pools
    pools
    (ast.ast-node-pool-context-expr-push pools (Var cleanup-name-id))
    (ast.ast-expr-cons
      (ast.ast-node-pool-context-expr-push pools (Var value-name-id))
      (ast.ast-expr-list-new))))

(define (lower-enum-cleanup-payload-patterns
  [lower-state : CompilerLowerState]
  [count : i64]) : ast.AstPatternList
  (lower-enum-cleanup-payload-patterns-at
    lower-state
    count
    0
    (ast.ast-pattern-list-with-capacity count)))

(define (lower-enum-cleanup-payload-patterns-at
  [lower-state : CompilerLowerState]
  [count : i64]
  [index : i64]
  [out : ast.AstPatternList]) : ast.AstPatternList
  (if (>= index count)
    out
    (let
      [next : ast.AstPatternList out]
      (ast.ast-pattern-list-push
        (&mut next)
        (ast.ast-pat-binding-id
          (lower-enum-cleanup-payload-id lower-state index)))
      (lower-enum-cleanup-payload-patterns-at
        lower-state
        count
        (+ index 1)
        next))))

(define (lower-enum-cleanup-payload-exprs
  [lower-state : CompilerLowerState]
  [pools : ast.AstNodePoolContext]
  [ctx : tc_core.TcContext]
  [payloads : (& payloads ast.AstTypeList)]
  [cleanups : ast.AstVariantPayloadCleanupList]) : parser.ResultAstExprList
  (lower-enum-cleanup-payload-exprs-at
    lower-state
    pools
    ctx
    (& payloads)
    (& cleanups)
    0
    (ast.ast-expr-list-new)))

(define (lower-enum-cleanup-payload-exprs-at
  [lower-state : CompilerLowerState]
  [pools : ast.AstNodePoolContext]
  [ctx : tc_core.TcContext]
  [payloads : (& payloads ast.AstTypeList)]
  [cleanups : (& cleanups ast.AstVariantPayloadCleanupList)]
  [index : i64]
  [acc : ast.AstExprList]) : parser.ResultAstExprList
  (if (>= index (ast.ast-type-list-len payloads))
    (Ok acc)
    (let
      [cleanup : ast.AstVariantPayloadCleanup
        (ast.ast-variant-payload-cleanup-list-get
          cleanups
          index
          (ast.ast-variant-payload-cleanup-fallback))]
      [value-name-id : i64 (lower-enum-cleanup-payload-id lower-state index)]
      (match cleanup
        [(No)
          (lower-enum-cleanup-payload-exprs-at
            lower-state
            pools
            ctx
            payloads
            cleanups
            (+ index 1)
            acc)]
        [(Fn cleanup-name)
          (lower-enum-cleanup-payload-exprs-at
            lower-state
            pools
            ctx
            payloads
            cleanups
            (+ index 1)
            (ast.ast-expr-cons
              (lower-enum-cleanup-call-expr
                pools
                (ci.intern-syntax-id-value cleanup-name)
                value-name-id)
              acc))]
        [(Owned)
          (let
            [cleanup-name-id : i64
              (try
                (lower-struct-cleanup-id-for-type
                  lower-state
                  ctx
                  (tc_core.tc-context-type-get
                    ctx
                    (ast.ast-type-list-get
                      payloads
                      index
                      (ast.ast-type-id-fallback)))))]
            (lower-enum-cleanup-payload-exprs-at
              lower-state
              pools
              ctx
              payloads
              cleanups
              (+ index 1)
              (ast.ast-expr-cons
                (lower-enum-cleanup-call-expr
                  pools
                  cleanup-name-id
                  value-name-id)
                acc)))]))))

(define (lower-enum-cleanup-arm
  [lower-state : CompilerLowerState]
  [pools : ast.AstNodePoolContext]
  [ctx : tc_core.TcContext]
  [variant : ast.AstVariantDef]) : parser.ResultAstMatchArm
  (match variant
    [(Def name payloads cleanups)
      (let
        [exprs : ast.AstExprList
          (try
            (lower-enum-cleanup-payload-exprs
              lower-state
              pools
              ctx
              payloads
              cleanups))]
        (Ok
          (ast.ast-match-arm
            (ast.ast-pat-variant-id
              name
              (lower-enum-cleanup-payload-patterns
                lower-state
                (ast.ast-type-list-len (& payloads))))
            (ast.ast-node-pool-context-expr-push
              pools
              (if (= (ast.ast-expr-list-len exprs) 0)
                (Literal Unit)
                (Begin exprs))))))]))

(define (lower-enum-cleanup-arms
  [lower-state : CompilerLowerState]
  [pools : ast.AstNodePoolContext]
  [ctx : tc_core.TcContext]
  [variants : ast.AstVariantDefList]) : parser.ResultAstMatchArmList
  (lower-enum-cleanup-arms-at
    lower-state
    pools
    ctx
    (& variants)
    0
    (ast.ast-match-arm-list-with-capacity
      (ast.ast-variant-def-list-len (& variants)))))

(define (lower-enum-cleanup-arms-at
  [lower-state : CompilerLowerState]
  [pools : ast.AstNodePoolContext]
  [ctx : tc_core.TcContext]
  [variants : (& variants ast.AstVariantDefList)]
  [index : i64]
  [out : ast.AstMatchArmList]) : parser.ResultAstMatchArmList
  (if (>= index (ast.ast-variant-def-list-len variants))
    (Ok out)
    (let
      [arm : ast.AstMatchArm
        (try
          (lower-enum-cleanup-arm
            lower-state
            pools
            ctx
            (ast.ast-variant-def-list-get
              variants
              index
              (ast.ast-variant-def-fallback))))]
      [next : ast.AstMatchArmList out]
      (ast.ast-match-arm-list-push (&mut next) arm)
      (lower-enum-cleanup-arms-at
        lower-state
        pools
        ctx
        variants
        (+ index 1)
        next))))

(define (lower-enum-cleanup-function
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [enum-ty : ast.AstType]
  [variants : ast.AstVariantDefList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (let
    [lower-state : CompilerLowerState
      (compiler-lower-state-from-name-cache names)]
    [pools : ast.AstNodePoolContext (tc_core.tc-context-pools ctx)]
    [value-name-id : i64 (lower-struct-cleanup-param-id lower-state)]
    (match (lower-enum-cleanup-arms lower-state pools ctx variants)
      [(Ok arms)
        (lower-function-escaping
          ctx
          top-env
          type-cache
          logical-name
          (ast.ast-param-cons
            (ast.ast-param-id value-name-id enum-ty false)
            (ast.ast-param-list-new))
          (Unit)
          (let
            [match-id
              (ast.ast-expr-match-with-pools
                pools
                (ast.ast-node-pool-context-expr-push pools (Var value-name-id))
                arms)]
            (ast.ast-node-pool-context-expr-get pools match-id))
          spans
          names
          mode)]
      [(Err message) (Err (box (lower-diagnostic message)))])))

(define (lower-enum-cleanup-decl
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [logical-name : i64]
  [cleanup : ast.AstEnumCleanup]
  [enum-ty : ast.AstType]
  [variants : ast.AstVariantDefList]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match cleanup
    [(No) (Ok (ir.compiler-ir-function-seq-empty) spans)]
    [(Fn _)
      (lower-enum-cleanup-function
        ctx
        top-env
        type-cache
        logical-name
        enum-ty
        variants
        spans
        names
        mode)]))

(define (lower-dispatch-cache-name [logical-name : String]) : String
  (str_cat.str-cat "__tl_dispatch_cache_" logical-name))

(define (lower-generated-role-dispatch-variant-prefix [tag : i64]) : String
  (cond
    [(= tag 1) "__tl_dispatch_variant_scalar_"]
    [(= tag 2) "__tl_dispatch_variant_avx2_"]
    [(= tag 3) "__tl_dispatch_variant_avx512_"]
    [else ""]))

(define (lower-spmd-package-result-code-from-role-tag [tag : i64]) : String
  (cond [(= tag 1) "unit"] [(= tag 2) "u"] [(= tag 3) "v"] [else ""]))

(define (lower-spmd-package-arg-classes-render
  [intern-state : (& intern-state ci.InternCompatState)]
  [components : i64]) : String
  (if (= components 0)
    ""
    (if (and
      (ci.intern-compat-state-composite-triple-id? (& intern-state) components)
      (=
        (ci.intern-compat-state-composite-left-id-unchecked
          (& intern-state)
          components)
        -6023))
      (str_cat.str-cat
        (if (=
          (ci.intern-compat-state-composite-middle-id-unchecked
            (& intern-state)
            components)
          1)
          "u"
          "v")
        (lower-spmd-package-arg-classes-render
          intern-state
          (ci.intern-compat-state-composite-right-id-unchecked
            (& intern-state)
            components)))
      "")))

;; This is the documented hashing/metadata boundary. Cache the byte-exact ABI
;; serialization on the structural identity recipe; internal registration and
;; deduplication compare only the identity handle.
(define (lower-spmd-package-identity-render
  [lower-state : CompilerLowerState]
  [components : i64]) : String
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    [cached : String
      (ci.intern-compat-state-composite-rendered-name intern-state components)]
    (if (> (string.string-length cached) 0)
      (begin
        (cfg
          (any compile-profile test)
          (compiler-lower-profile-add!
            lower-state
            compiler-lower-profile-spmd-render-cache-hits-metric
            1)
          unit)
        cached)
      (let
        [source-components : i64
          (ci.intern-compat-state-composite-left-id-unchecked
            intern-state
            components)]
        [signature-components : i64
          (ci.intern-compat-state-composite-middle-id-unchecked
            intern-state
            components)]
        [backend-components : i64
          (ci.intern-compat-state-composite-right-id-unchecked
            intern-state
            components)]
        [canonical-components : i64
          (ci.intern-compat-state-composite-right-id-unchecked
            intern-state
            source-components)]
        [call-components : i64
          (ci.intern-compat-state-composite-right-id-unchecked
            intern-state
            backend-components)]
        [result-components : i64
          (ci.intern-compat-state-composite-middle-id-unchecked
            intern-state
            call-components)]
        [rendered : String
          (lower-spmd-package-symbol-identity
            (ci.intern-compat-state-str
              intern-state
              (ci.intern-compat-state-composite-left-id-unchecked
                intern-state
                source-components))
            (ci.intern-compat-state-str
              intern-state
              (ci.intern-compat-state-composite-right-id-unchecked
                intern-state
                canonical-components))
            (ci.intern-compat-state-str
              intern-state
              (ci.intern-compat-state-composite-left-id-unchecked
                intern-state
                signature-components))
            (match (ci.intern-compat-state-composite-left-id-unchecked
              intern-state
              backend-components)
              [1 Scalar]
              [2 Avx2]
              [_ Avx512])
            (ci.intern-compat-state-composite-middle-id-unchecked
              intern-state
              backend-components)
            (lower-spmd-package-arg-classes-render
              intern-state
              (ci.intern-compat-state-composite-left-id-unchecked
                intern-state
                call-components))
            (lower-spmd-package-result-code-from-role-tag
              (ci.intern-compat-state-composite-left-id-unchecked
                intern-state
                result-components))
            (ci.intern-compat-state-composite-right-id-unchecked
              intern-state
              call-components))]
        (begin
          (cfg
            (any compile-profile test)
            (begin
              (compiler-lower-profile-add!
                lower-state
                compiler-lower-profile-spmd-identity-serializations-metric
                1)
              (compiler-lower-profile-add!
                lower-state
                compiler-lower-profile-spmd-render-cache-misses-metric
                1))
            unit)
          (ci.intern-compat-state-composite-rendered-name-record!
            (&mut intern-state)
            components
            rendered))))))

(define (lower-spmd-result-wrapper-prefix [role : i64]) : String
  (cond
    [(= role (ci.intern-generated-symbol-role-spmd-result-uniform))
      "__tl_spmd_ret_uniform_"]
    [(= role (ci.intern-generated-symbol-role-spmd-result-varying))
      "__tl_spmd_ret_varying_"]
    [(= role (ci.intern-generated-symbol-role-spmd-result-mask))
      "__tl_spmd_ret_mask_"]
    [else ""]))

(define (lower-generated-role-render
  [lower-state : CompilerLowerState]
  [role : i64]
  [qualification : i64]
  [components : i64]) : String
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    (cond
      [(= role (ci.intern-generated-symbol-role-lambda))
        (if (ci.intern-compat-state-composite-pair-id? intern-state components)
          (str_cat.str-cat
            "__tl_lambda_"
            (ir.compiler-ir-symbol-text
              (ci.intern-compat-state-composite-left-id-unchecked
                intern-state
                components))
            "_"
            (string.int->string
              (ci.intern-compat-state-composite-right-id-unchecked
                intern-state
                components)))
          "")]
      [(= role (ci.intern-generated-symbol-role-global-initializer))
        (str_cat.str-cat
          "__global_init_"
          (ir.compiler-ir-symbol-text components))]
      [(= role (ci.intern-generated-symbol-role-cleanup-helper))
        (if (ci.intern-compat-state-composite-pair-id?
          intern-state
          qualification)
          (csym.compiler-symbol-module-key
            (ci.intern-compat-state-str
              intern-state
              (ci.intern-compat-state-composite-left-id-unchecked
                intern-state
                qualification))
            (ci.intern-compat-state-str
              intern-state
              (ci.intern-compat-state-composite-right-id-unchecked
                intern-state
                qualification)))
          "")]
      [(= role (ci.intern-generated-symbol-role-cleanup-parameter))
        "__tl_cleanup_value"]
      [(= role (ci.intern-generated-symbol-role-cleanup-payload))
        (str_cat.str-cat
          "__tl_cleanup_payload_"
          (string.int->string components))]
      [(= role (ci.intern-generated-symbol-role-dispatch-cache))
        (lower-dispatch-cache-name (ir.compiler-ir-symbol-text components))]
      [(= role (ci.intern-generated-symbol-role-dispatch-variant))
        (if (ci.intern-compat-state-composite-triple-id?
          intern-state
          components)
          (str_cat.str-cat
            (lower-generated-role-dispatch-variant-prefix
              (ci.intern-compat-state-composite-middle-id-unchecked
                intern-state
                components))
            (ir.compiler-ir-symbol-text
              (ci.intern-compat-state-composite-left-id-unchecked
                intern-state
                components))
            "__"
            (ir.compiler-ir-symbol-text
              (ci.intern-compat-state-composite-right-id-unchecked
                intern-state
                components)))
          "")]
      [(= role (ci.intern-generated-symbol-role-nullary-enum-object))
        (if (ci.intern-compat-state-composite-pair-id? intern-state components)
          (str_cat.str-cat
            "__enum_obj_"
            (tc_core.tc-nominal-name-id-display
              (ci.intern-compat-state-composite-left-id-unchecked
                intern-state
                components))
            "_"
            (tc_core.tc-env-key-name-text
              (ci.intern-compat-state-composite-right-id-unchecked
                intern-state
                components)))
          "")]
      [(= role (ci.intern-generated-symbol-role-spmd-identity))
        (lower-spmd-package-identity-render lower-state components)]
      [(= role (ci.intern-generated-symbol-role-spmd-package-symbol))
        (if (ci.intern-compat-state-composite-pair-id? intern-state components)
          (str_cat.str-cat
            "__tl_spmd_pkg_"
            (string.int->string
              (ci.intern-compat-state-composite-right-id-unchecked
                intern-state
                components)))
          "")]
      [(or
          (= role (ci.intern-generated-symbol-role-spmd-result-uniform))
          (= role (ci.intern-generated-symbol-role-spmd-result-varying))
          (= role (ci.intern-generated-symbol-role-spmd-result-mask)))
        (str_cat.str-cat
          (lower-spmd-result-wrapper-prefix role)
          (ci.intern-compat-state-str intern-state components))]
      [(= role (ci.intern-generated-symbol-role-spmd-private-helper))
        (ci.intern-compat-state-str intern-state components)]
      [(= role (ci.intern-generated-symbol-role-spmd-private-parameter))
        (let
          [name : i64
            (ci.intern-compat-state-composite-left-id-unchecked
              intern-state
              components)]
          [class : i64
            (ci.intern-compat-state-composite-middle-id-unchecked
              intern-state
              components)]
          [mode : i64
            (ci.intern-compat-state-composite-right-id-unchecked
              intern-state
              components)]
          [source-name : String (tc_core.tc-env-key-name-text name)]
          (cond
            [(= class 1) source-name]
            [(= class 2)
              (str_cat.str-cat
                (if (= mode 2)
                  "__tl_spmd_varying_arg_avx2_"
                  "__tl_spmd_varying_arg_")
                source-name)]
            [else
              (str_cat.str-cat
                (if (= mode 2)
                  "__tl_spmd_mask_arg_avx2_"
                  "__tl_spmd_mask_arg_")
                source-name)]))]
      [else ""])))

(define (lower-materialize-generated-role-symbols!
  [lower-state : CompilerLowerState]) : unit
  (let
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    [count : i64
      (ci.intern-compat-state-generated-role-record-count intern-state)]
    [index : i64 0]
    (while (< index count)
      (let
        [handle : i64
          (ci.intern-compat-state-generated-role-record-handle-at
            intern-state
            index)]
        (when
          (and
            (> handle 0)
            (=
              (string.string-length
                (ci.intern-compat-state-str intern-state handle))
              0))
          (let
            [role : i64
              (ci.intern-compat-state-generated-role-record-role-at
                intern-state
                index)]
            [rendered : String
              (lower-generated-role-render
                lower-state
                role
                (ci.intern-compat-state-generated-role-record-qualification-at
                  intern-state
                  index)
                (ci.intern-compat-state-generated-role-record-components-at
                  intern-state
                  index))]
            (when
              (> (string.string-length rendered) 0)
              (begin
                (ci.intern-compat-state-generated-role-symbol-materialize!
                  (&mut intern-state)
                  role
                  handle
                  rendered)
                unit))))
        (set! index (+ index 1))))))

(define (lower-dispatch-isa-role-tag [isa : ast.AstDispatchIsa]) : i64
  (match isa
    [(Scalar) 1]
    [(Avx2) 2]
    [(Avx512) 3]))

(define (lower-dispatch-variant-role-symbol
  [names : LowerNameCache]
  [dispatch-symbol : i64]
  [module-id : i64]
  [isa : ast.AstDispatchIsa]
  [variant-name : i64]) : i64
  (let
    [lower-state : CompilerLowerState
      (compiler-lower-state-from-name-cache names)]
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns lower-state)]
    [variant-logical-name : String
      (lower-dispatch-variant-logical-name
        module-id
        (lower-global-shared-view names)
        variant-name)]
    [variant-logical-id : i64
      (lower-dispatch-variant-logical-id module-id names variant-name)]
    [variant-symbol : i64
      (lower-name-cache-ir-symbol
        names
        variant-logical-id
        variant-name
        variant-logical-name)]
    [components : i64
      (ci.intern-compat-state-composite-triple-id
        (&mut intern-state)
        dispatch-symbol
        (lower-dispatch-isa-role-tag isa)
        variant-symbol)]
    (ci.intern-compat-state-generated-role-symbol-id
      (&mut intern-state)
      (ci.intern-generated-symbol-role-dispatch-variant)
      components)))

(define (lower-dispatch-lower-mode
  [isa : ast.AstDispatchIsa]
  [mode : CompilerLowerMode]) : CompilerLowerMode
  (lower-mode-of
    (lower-mode-abi mode)
    (match isa
      [(Scalar) (Scalar)]
      [(Avx2) (Avx2)]
      [(Avx512) (Avx512)])))

(define (lower-dispatch-type-list-without-regions
  [ctx : tc_core.TcContext]
  [types : ast.AstTypeList]) : ast.AstTypeList
  (lower-dispatch-type-list-without-regions-at ctx (& types) 0))

(define (lower-dispatch-type-list-without-regions-at
  [ctx : tc_core.TcContext]
  [types : (& types ast.AstTypeList)]
  [index : i64]) : ast.AstTypeList
  (if (>= index (ast.ast-type-list-len types))
    (ast.ast-type-list-new)
    (ast.ast-type-cons
      (tc_core.tc-type-without-regions
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback))))
      (lower-dispatch-type-list-without-regions-at ctx types (+ index 1)))))

(define (lower-dispatch-param-type-count [types : (& types ast.AstTypeList)]) : i64
  (ast.ast-type-list-len (& types)))

(define (lower-dispatch-physical-param-list
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [types : ast.AstTypeList]
  [source-start : i64]
  [leading-sret? : bool]) : ir.CompilerIrParamSeq
  (let
    [builder : ir.CompilerIrParamBuilder
      (ir.compiler-ir-param-builder-with-capacity
        (+
          (ast.ast-type-list-len (& types))
          (if leading-sret?
            1
            0)))]
    (if leading-sret?
      (ir.compiler-ir-param-builder-push!
        (&mut builder)
        (ir.CompilerIrParam.Param
          (ir.compiler-ir-hidden-sret-param-name)
          (U64)
          0))
      unit)
    (lower-dispatch-physical-param-list-into!
      ctx
      mode
      (& types)
      0
      source-start
      (&mut builder))
    (ir.compiler-ir-param-builder-to-seq builder)))

(define (lower-dispatch-physical-param-list-into!
  [ctx : tc_core.TcContext]
  [mode : CompilerLowerMode]
  [types : (& types ast.AstTypeList)]
  [index : i64]
  [idx : i64]
  [builder : (&mut builder ir.CompilerIrParamBuilder)]) : unit
  (if (>= index (ast.ast-type-list-len types))
    unit
    (let
      [source-ty : ast.AstType
        (tc_core.tc-context-type-get
          ctx
          (ast.ast-type-list-get types index (ast.ast-type-id-fallback)))]
      (ir.compiler-ir-param-builder-push!
        builder
        (ir.CompilerIrParam.Param
          (str_cat.str-cat "arg" (string.int->string index))
          (lower-internal-param-physical-type ctx mode source-ty)
          idx))
      (lower-dispatch-physical-param-list-into!
        ctx
        mode
        types
        (+ index 1)
        (+ idx 1)
        builder))))

(define (lower-dispatch-physical-param-values [count : i64] [idx : i64]) : ir.CompilerIrValueSeq
  (let
    [len : i64
      (if (>= idx count)
        0
        (- count idx))]
    [slots : (__tl_dyn-array ir.CompilerIrValue)
      (__tl_make-array ir.CompilerIrValue len)]
    [cursor : i64 0]
    (while (< cursor len)
      (set! (array-ref slots cursor) (ir.CompilerIrValue.Var (+ idx cursor)))
      (set! cursor (+ cursor 1)))
    (ir.CompilerIrValueSeq slots len)))

(define (lower-dispatch-find-internal-name-from
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [module-id : i64]
  [names : LowerNameCache]
  [dispatch-symbol : i64]
  [wanted : ast.AstDispatchIsa]) : LowerMaybeIrSymbol
  (if (>= index variants.len)
    (No)
    (match (ast.ast-dispatch-variant-list-get
      variants
      index
      (ast.ast-dispatch-variant-fallback))
      [(Variant isa variant-name)
        (if (tc_core.tc-dispatch-isa-eq? isa wanted)
          (Some
            (lower-dispatch-variant-role-symbol
              names
              dispatch-symbol
              module-id
              isa
              variant-name))
          (lower-dispatch-find-internal-name-from
            variants
            (+ index 1)
            module-id
            names
            dispatch-symbol
            wanted))])))

(define (lower-dispatch-find-internal-name
  [variants : (& variants ast.AstDispatchVariantList)]
  [module-id : i64]
  [names : LowerNameCache]
  [dispatch-symbol : i64]
  [wanted : ast.AstDispatchIsa]) : LowerMaybeIrSymbol
  (lower-dispatch-find-internal-name-from
    (& variants)
    0
    module-id
    names
    dispatch-symbol
    wanted))

(define (lower-dispatch-call-return-instr
  [call-var : i64]
  [ret-ty : ast.AstType]) : ir.CompilerIrInstr
  (Return (lower-return-maybe (Var call-var) ret-ty)))

(define (lower-dispatch-cached-block
  [cached-word-var : i64]
  [fn-ty : ast.AstType]
  [args : ir.CompilerIrCallArgs]
  [ret-ty : ast.AstType]
  [base : i64]) : ir.CompilerIrBlock
  (Block
    (ir.compiler-ir-label "cached")
    (ir.compiler-ir-instr-seq3
      ;; The atomic primitive returns a machine word. Retype it to the exact
      ;; checked dispatch signature before the indirect call so ABI lowering
      ;; never has to infer the signature from an untyped cache word.
      (Cast base (Var cached-word-var) (I64) fn-ty)
      (CallIndirect
        (+ base 1)
        (Var base)
        args
        (lower-global-shared-view ret-ty))
      (lower-dispatch-call-return-instr (+ base 1) ret-ty))))

(define (lower-dispatch-select-block
  [label : i64]
  [cache-name : i64]
  [fn-name : i64]
  [fn-ty : ast.AstType]
  [args : ir.CompilerIrCallArgs]
  [ret-ty : ast.AstType]
  [base : i64]) : ir.CompilerIrBlock
  (let
    [instrs : ir.CompilerIrInstrBuilder
      (ir.compiler-ir-instr-builder-with-capacity 6)]
    ;; The cache is a private pointer-width word. Sequentially consistent CAS
    ;; publishes exactly once: zero means this thread won; otherwise the old
    ;; nonzero word is the winner another resolver already published.
    (ir.compiler-ir-instr-builder-push!
      (&mut instrs)
      (ir.CompilerIrInstr.Call
        base
        cbi.compiler-builtin-id-tl-atomic-i64-cas-ptr
        (ir.compiler-ir-call-args-from-seq
          (ir.compiler-ir-value-seq3
            (GlobalAddr cache-name)
            (I64 0)
            (Function fn-name)))
        (I64)))
    (ir.compiler-ir-instr-builder-push!
      (&mut instrs)
      (ir.CompilerIrInstr.BinOp (+ base 1) Ne (Var base) (I64 0) (I64)))
    (ir.compiler-ir-instr-builder-push!
      (&mut instrs)
      (ir.ir-instr-select
        (+ base 2)
        (Var (+ base 1))
        (Var base)
        (Function fn-name)
        0
        (I64)))
    ;; Retype the winning machine word only after zero has been excluded.
    (ir.compiler-ir-instr-builder-push!
      (&mut instrs)
      (ir.CompilerIrInstr.Cast (+ base 3) (Var (+ base 2)) (I64) fn-ty))
    (ir.compiler-ir-instr-builder-push!
      (&mut instrs)
      (ir.CompilerIrInstr.CallIndirect
        (+ base 4)
        (Var (+ base 3))
        args
        (lower-global-shared-view ret-ty)))
    (ir.compiler-ir-instr-builder-push!
      (&mut instrs)
      (lower-dispatch-call-return-instr (+ base 4) ret-ty))
    (Block label (ir.compiler-ir-instr-builder-to-seq instrs))))

(define (lower-dispatch-entry-block
  [cache-name : i64]
  [cached-word-var : i64]
  [cached-nonzero-var : i64]
  [resolve-label : i64]) : ir.CompilerIrBlock
  (Block
    (ir.compiler-ir-label "entry")
    (ir.compiler-ir-instr-seq3
      (Call
        cached-word-var
        cbi.compiler-builtin-id-tl-atomic-i64-load-ptr
        (One (GlobalAddr cache-name))
        (I64))
      (BinOp cached-nonzero-var Ne (Var cached-word-var) (I64 0) (I64))
      (Branch
        (Var cached-nonzero-var)
        (ir.compiler-ir-label "cached")
        resolve-label))))

(define lower-dispatch-avx512-required-feature-mask : i64
  ;; CPUID.7.0:EBX AVX512F bit 16, AVX512DQ bit 17, AVX512BW bit 30.
  1073938432)

(define (lower-dispatch-feature-blocks
  [prefix : String]
  [xcr0-mask : i64]
  [feature-mask : i64]
  [select-label : i64]
  [fallback-label : i64]
  [base : i64]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [check-label : i64 (ir.compiler-ir-label (string.copy prefix))]
    [osxsave-label : i64
      (ir.compiler-ir-label (str_cat.str-cat (string.copy prefix) "_osxsave"))]
    [xcr0-label : i64
      (ir.compiler-ir-label (str_cat.str-cat (string.copy prefix) "_xcr0"))]
    [leaf7-label : i64 (ir.compiler-ir-label (str_cat.str-cat prefix "_leaf7"))]
    [max-leaf-var : i64 base]
    [max-ok-var : i64 (+ base 1)]
    [leaf1-ecx-var : i64 (+ base 2)]
    [osxsave-mask-var : i64 (+ base 3)]
    [osxsave-ok-var : i64 (+ base 4)]
    [xcr0-var : i64 (+ base 5)]
    [xcr0-mask-var : i64 (+ base 6)]
    [xcr0-ok-var : i64 (+ base 7)]
    [leaf7-ebx-var : i64 (+ base 8)]
    [feature-mask-var : i64 (+ base 9)]
    [feature-ok-var : i64 (+ base 10)]
    [blocks : ir.CompilerIrBlockBuilder
      (ir.compiler-ir-block-builder-with-capacity
        (+ 4 (ir.compiler-ir-block-list-count tail)))]
    (ir.compiler-ir-block-builder-push!
      (&mut blocks)
      (ir.CompilerIrBlock.Block
        check-label
        (ir.compiler-ir-instr-seq3
          (CpuId max-leaf-var (I64 0) (I64 0) 0)
          (BinOp max-ok-var Ge (Var max-leaf-var) (I64 7) (I64))
          (Branch (Var max-ok-var) osxsave-label fallback-label))))
    (ir.compiler-ir-block-builder-push!
      (&mut blocks)
      (ir.CompilerIrBlock.Block
        osxsave-label
        (ir.compiler-ir-instr-seq4
          (CpuId leaf1-ecx-var (I64 1) (I64 0) 2)
          (BinOp
            osxsave-mask-var
            BitAnd
            (Var leaf1-ecx-var)
            (I64 134217728)
            (I64))
          (BinOp osxsave-ok-var Ne (Var osxsave-mask-var) (I64 0) (I64))
          (Branch (Var osxsave-ok-var) xcr0-label fallback-label))))
    (ir.compiler-ir-block-builder-push!
      (&mut blocks)
      (ir.CompilerIrBlock.Block
        xcr0-label
        (ir.compiler-ir-instr-seq4
          (Xgetbv xcr0-var (I64 0))
          (BinOp xcr0-mask-var BitAnd (Var xcr0-var) (I64 xcr0-mask) (I64))
          (BinOp xcr0-ok-var Eq (Var xcr0-mask-var) (I64 xcr0-mask) (I64))
          (Branch (Var xcr0-ok-var) leaf7-label fallback-label))))
    (ir.compiler-ir-block-builder-push!
      (&mut blocks)
      (ir.CompilerIrBlock.Block
        leaf7-label
        (ir.compiler-ir-instr-seq4
          (CpuId leaf7-ebx-var (I64 7) (I64 0) 1)
          (BinOp
            feature-mask-var
            BitAnd
            (Var leaf7-ebx-var)
            (I64 feature-mask)
            (I64))
          (BinOp
            feature-ok-var
            Eq
            (Var feature-mask-var)
            (I64 feature-mask)
            (I64))
          (Branch (Var feature-ok-var) select-label fallback-label))))
    (ir.compiler-ir-block-builder-append-list! (&mut blocks) tail)
    (ir.compiler-ir-block-builder-to-list blocks)))

(define (lower-dispatch-select-blocks
  [cache-name : i64]
  [fn-ty : ast.AstType]
  [args : ir.CompilerIrCallArgs]
  [ret-ty : ast.AstType]
  [scalar-name : i64]
  [maybe-avx2 : LowerMaybeIrSymbol]
  [maybe-avx512 : LowerMaybeIrSymbol]
  [base : i64]) : ir.CompilerIrBlockList
  (let
    [blocks : ir.CompilerIrBlockBuilder
      (ir.compiler-ir-block-builder-with-capacity 3)]
    (match maybe-avx512
      [(Some avx512-name)
        (ir.compiler-ir-block-builder-push!
          (&mut blocks)
          (lower-dispatch-select-block
            (ir.compiler-ir-label "select_avx512")
            cache-name
            avx512-name
            (lower-global-shared-view fn-ty)
            (lower-global-shared-view args)
            (lower-global-shared-view ret-ty)
            (+ base 36)))]
      [(No) unit])
    (match maybe-avx2
      [(Some avx2-name)
        (ir.compiler-ir-block-builder-push!
          (&mut blocks)
          (lower-dispatch-select-block
            (ir.compiler-ir-label "select_avx2")
            cache-name
            avx2-name
            (lower-global-shared-view fn-ty)
            (lower-global-shared-view args)
            (lower-global-shared-view ret-ty)
            (+ base 31)))]
      [(No) unit])
    (ir.compiler-ir-block-builder-push!
      (&mut blocks)
      (lower-dispatch-select-block
        (ir.compiler-ir-label "select_scalar")
        cache-name
        scalar-name
        fn-ty
        args
        ret-ty
        (+ base 26)))
    (ir.compiler-ir-block-builder-to-list blocks)))

(define (lower-dispatch-resolve-label
  [maybe-avx2 : LowerMaybeIrSymbol]
  [maybe-avx512 : LowerMaybeIrSymbol]) : i64
  (match maybe-avx512
    [(Some _) (ir.compiler-ir-label "check_avx512")]
    [(No)
      (match maybe-avx2
        [(Some _) (ir.compiler-ir-label "check_avx2")]
        [(No) (ir.compiler-ir-label "select_scalar")])]))

(define (lower-dispatch-resolve-blocks
  [maybe-avx2 : LowerMaybeIrSymbol]
  [maybe-avx512 : LowerMaybeIrSymbol]
  [base : i64]
  [tail : ir.CompilerIrBlockList]) : ir.CompilerIrBlockList
  (let
    [with-avx2 : ir.CompilerIrBlockList
      (match maybe-avx2
        [(Some _)
          (lower-dispatch-feature-blocks
            "check_avx2"
            6
            32
            (ir.compiler-ir-label "select_avx2")
            (ir.compiler-ir-label "select_scalar")
            (+ base 12)
            tail)]
        [(No) tail])]
    (match maybe-avx512
      [(Some _)
        (lower-dispatch-feature-blocks
          "check_avx512"
          230
          lower-dispatch-avx512-required-feature-mask
          (ir.compiler-ir-label "select_avx512")
          (match maybe-avx2
            [(Some _) (ir.compiler-ir-label "check_avx2")]
            [(No) (ir.compiler-ir-label "select_scalar")])
          (+ base 1)
          with-avx2)]
      [(No) with-avx2])))

(define (lower-dispatch-thunk-function
  [ctx : tc_core.TcContext]
  [logical-name : i64]
  [cache-name : i64]
  [fn-ty : ast.AstType]
  [variants : ast.AstDispatchVariantList]
  [module-id : i64]
  [names : LowerNameCache]
  [spans : ir.CompilerSourceSpans]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match (lower-global-shared-view fn-ty)
    [(Func param-types ret-box)
      (let
        [ret-ty : ast.AstType
          (tc_core.tc-type-without-regions
            (tc_core.tc-context-type-get ctx ret-box))]
        [clean-param-types : ast.AstTypeList
          (lower-dispatch-type-list-without-regions ctx (deref param-types))]
        [ret-class : LowerCAbiAggregate
          (lower-internal-return-class
            ctx
            mode
            (lower-global-shared-view ret-ty))]
        [leading-sret? : bool
          (match ret-class
            [(Sret _) true]
            [_ false])]
        [source-start : i64
          (if leading-sret?
            1
            0)]
        [source-count : i64 (lower-dispatch-param-type-count clean-param-types)]
        [param-count : i64 (+ source-start source-count)]
        [physical-ret-ty : ast.AstType
          (lower-internal-return-physical-type ctx mode ret-ty)]
        [args : ir.CompilerIrCallArgs
          (ir.compiler-ir-call-args-from-seq
            (lower-dispatch-physical-param-values param-count 0))]
        [maybe-avx2 : LowerMaybeIrSymbol
          (lower-dispatch-find-internal-name
            variants
            module-id
            (lower-global-shared-view names)
            logical-name
            (Avx2))]
        [maybe-avx512 : LowerMaybeIrSymbol
          (lower-dispatch-find-internal-name
            variants
            module-id
            (lower-global-shared-view names)
            logical-name
            (Avx512))]
        (match (lower-dispatch-find-internal-name
          variants
          module-id
          names
          logical-name
          (Scalar))
          [(Some scalar-name)
            (let
              [tail-blocks : ir.CompilerIrBlockList
                (lower-dispatch-resolve-blocks
                  maybe-avx2
                  maybe-avx512
                  (+ param-count 1)
                  (lower-dispatch-select-blocks
                    cache-name
                    (lower-global-shared-view fn-ty)
                    (lower-global-shared-view args)
                    (lower-global-shared-view physical-ret-ty)
                    scalar-name
                    maybe-avx2
                    maybe-avx512
                    param-count))]
              [blocks : ir.CompilerIrBlockBuilder
                (ir.compiler-ir-block-builder-with-capacity
                  (+ 2 (ir.compiler-ir-block-list-count tail-blocks)))]
              (ir.compiler-ir-block-builder-push!
                (&mut blocks)
                (lower-dispatch-entry-block
                  cache-name
                  param-count
                  (+ param-count 1)
                  (lower-dispatch-resolve-label maybe-avx2 maybe-avx512)))
              (ir.compiler-ir-block-builder-push!
                (&mut blocks)
                (lower-dispatch-cached-block
                  param-count
                  fn-ty
                  args
                  (lower-global-shared-view physical-ret-ty)
                  (+ param-count 24)))
              (ir.compiler-ir-block-builder-append-list!
                (&mut blocks)
                tail-blocks)
              (Ok
                (ir.compiler-ir-function-seq1
                  (Function
                    logical-name
                    (lower-dispatch-physical-param-list
                      ctx
                      mode
                      clean-param-types
                      source-start
                      leading-sret?)
                    physical-ret-ty
                    (+ param-count 41)
                    (ir.compiler-ir-block-builder-to-list blocks)
                    Ordinary))
                spans))]
          [(No)
            (Err
              (box
                (lower-diagnostic
                  "lower: defdispatch requires a scalar variant")))]))]
    [_
      (Err
        (box
          (lower-diagnostic
            "lower: defdispatch did not typecheck as a function")))]))

(define (lower-dispatch-lower-variant-decl
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [internal-name : i64]
  [isa : ast.AstDispatchIsa]
  [decl : ast.AstDecl]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match decl
    [(DefFn decl-meta _ params ret body-box _)
      (let
        [body : ast.AstExpr (lower-context-expr-get ctx body-box)]
        (lower-function-escaping
          ctx
          top-env
          type-cache
          internal-name
          params
          ret
          body
          spans
          names
          (lower-dispatch-lower-mode isa mode)))]
    [(Unsafe inner-box)
      (let
        [inner : ast.AstDecl (deref inner-box)]
        (lower-dispatch-lower-variant-decl
          ctx
          top-env
          type-cache
          internal-name
          isa
          inner
          spans
          names
          mode))]
    [_
      (Err
        (box
          (lower-diagnostic
            "lower: defdispatch variants must be local functions")))]))

(define (lower-dispatch-lower-variant
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-symbol : i64]
  [variant : ast.AstDispatchVariant]
  [module-id : i64]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (match variant
    [(Variant isa variant-name)
      (let
        [internal-name : i64
          (lower-dispatch-variant-role-symbol
            (lower-global-shared-view names)
            dispatch-symbol
            module-id
            isa
            variant-name)]
        [handle : i64
          (if (tc_core.tc-name-qualified-id?
            (tc_core.tc-context-structural-session ctx)
            variant-name)
            (csym.compiler-symbols-lookup-value-id-or
              (tc_core.tc-context-symbols ctx)
              variant-name
              (csym.compiler-symbols-missing-handle))
            (csym.compiler-symbols-lookup-value-in-module-id-or
              (tc_core.tc-context-symbols ctx)
              module-id
              variant-name
              (csym.compiler-symbols-missing-handle)))]
        (if (csym.compiler-symbols-handle-found? handle)
          (match (csym.compiler-symbols-decl-at-index
            (tc_core.tc-context-symbols ctx)
            (csym.compiler-symbol-handle-index handle))
            [(Ok decl)
              (lower-dispatch-lower-variant-decl
                ctx
                top-env
                type-cache
                internal-name
                isa
                decl
                spans
                names
                mode)]
            [(Err message) (Err (box (lower-diagnostic message)))])
          (Err
            (box
              (lower-diagnostic
                (str_cat.str-cat
                  "lower: unknown defdispatch variant "
                  (tc_core.tc-env-key-name-text-for-session
                    (tc_core.tc-context-structural-session ctx)
                    variant-name)))))))]))

(define (lower-dispatch-lower-variants-from
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-symbol : i64]
  [variants : (& variants ast.AstDispatchVariantList)]
  [index : i64]
  [module-id : i64]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]
  [functions : ir.CompilerIrFunctionBuilder]) : ResultLowerFunction
  (if (>= index variants.len)
    (Ok (ir.compiler-ir-function-builder-to-seq functions) spans)
    (match (lower-dispatch-lower-variant
      ctx
      top-env
      (lower-global-shared-view type-cache)
      dispatch-symbol
      (ast.ast-dispatch-variant-list-get
        variants
        index
        (ast.ast-dispatch-variant-fallback))
      module-id
      spans
      (lower-global-shared-view names)
      mode)
      [(Ok lowered-functions function-spans)
        (let
          [next-functions : ir.CompilerIrFunctionBuilder functions]
          (ir.compiler-ir-function-builder-append-seq!
            (&mut next-functions)
            lowered-functions)
          (lower-dispatch-lower-variants-from
            ctx
            top-env
            type-cache
            dispatch-symbol
            variants
            (+ index 1)
            module-id
            function-spans
            names
            mode
            next-functions))]
      [(Err message) (Err message)])))

(define (lower-dispatch-lower-variants
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [dispatch-symbol : i64]
  [variants : (& variants ast.AstDispatchVariantList)]
  [module-id : i64]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameCache]
  [mode : CompilerLowerMode]) : ResultLowerFunction
  (lower-dispatch-lower-variants-from
    ctx
    top-env
    type-cache
    dispatch-symbol
    (& variants)
    0
    module-id
    spans
    names
    mode
    (ir.compiler-ir-function-builder-new)))

(define (lower-dispatch-decl
  [ctx : tc_core.TcContext]
  [_top-env : tc_core.TcTypeEnv]
  [local-top-env : tc_core.TcTypeEnv]
  [type-cache : LowerTypeCache]
  [name-id : i64]
  [variants : ast.AstDispatchVariantList]
  [spans : ir.CompilerSourceSpans]
  [name-cache : LowerNameCache]
  [mode : CompilerLowerMode]
  [module : String]
  [module-id : i64]
  [logical-module : String]
  [logical-module-id : i64]) : ResultLowerDispatchDecl
  (let
    [name : String
      (tc_core.tc-env-key-name-text-for-session
        (tc_core.tc-context-structural-session ctx)
        name-id)]
    [decl-ctx : tc_core.TcContext
      (tc_core.tc-context-with-module-id ctx module module-id)]
    [logical-name : String
      (lower-current-decl-logical-name-cache-id
        name-cache
        logical-module
        name
        name-id)]
    [key-id : i64 (lower-module-name-key-id-by-id logical-module-id name-id)]
    [logical-id : i64
      (lower-name-cache-lookup-logical-id (& name-cache) key-id key-id)]
    [logical-symbol : i64
      (lower-name-cache-ir-symbol name-cache logical-id name-id logical-name)]
    [intern-state : ci.InternCompatState
      (compiler-lower-state-interns
        (compiler-lower-state-from-name-cache name-cache))]
    [cache-id : i64
      (ci.intern-compat-state-generated-role-symbol-id
        (&mut intern-state)
        (ci.intern-generated-symbol-role-dispatch-cache)
        logical-symbol)]
    [cache-symbol : i64 cache-id]
    (match (tc_core.tc-lookup-id local-top-env name-id)
      [(Ok dispatch-ty)
        (let
          [fn-ty : ast.AstType
            (tc_core.tc-type-without-regions
              (tc_core.tc-resolve-type decl-ctx dispatch-ty))]
          (match (lower-dispatch-lower-variants
            decl-ctx
            local-top-env
            type-cache
            logical-symbol
            variants
            module-id
            spans
            (lower-global-shared-view name-cache)
            mode)
            [(Ok variant-functions variant-spans)
              (match (lower-dispatch-thunk-function
                decl-ctx
                logical-symbol
                cache-symbol
                fn-ty
                variants
                module-id
                name-cache
                variant-spans
                mode)
                [(Ok thunk-functions thunk-spans)
                  (let
                    ;; The synthesized thunk is built directly in the enclosing
                    ;; source arena, so give it the same lifetime as variants
                    ;; lowered through lower-function-escaping.
                    [escaped-thunk-functions : ir.CompilerIrFunctionSeq
                      (lower-function-seq-escape-to-ir-arena thunk-functions)]
                    [functions : ir.CompilerIrFunctionBuilder
                      (ir.compiler-ir-function-builder-with-capacity
                        (+
                          (ir.compiler-ir-function-seq-count variant-functions)
                          (ir.compiler-ir-function-seq-count
                            escaped-thunk-functions)))]
                    (ir.compiler-ir-function-builder-append-seq!
                      (&mut functions)
                      variant-functions)
                    (ir.compiler-ir-function-builder-append-seq!
                      (&mut functions)
                      escaped-thunk-functions)
                    (Ok
                      (box
                        (Decl
                          (Global
                            cache-symbol
                            (I64)
                            ;; A non-unit typed Unit initializer is the IR's
                            ;; zero-filled static-cell form. The backend emits
                            ;; this pointer-width cache as an 8-byte-aligned
                            ;; common symbol on Linux and Windows.
                            (Unit))
                          (ir.compiler-ir-function-builder-to-seq functions)
                          thunk-spans))))]
                [(Err message) (Err message)])]
            [(Err message) (Err message)]))]
      [(Err message) (Err (box (lower-diagnostic message)))])))

(define (lower-rvo-early-return-functions-from-decls-in-module
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [decls : (& decls ast.AstDeclList)]
  [names : LowerNameEnv]
  [_ : String]
  [module-id : i64]
  [out : lower_i64_i64_map.Map]) : lower_i64_i64_map.Map
  (let
    [count : i64 (ast.ast-decl-list-len (& decls))]
    [index : i64 0]
    [cur-module-id : i64 module-id]
    [name-cache : LowerNameCache (lower-name-cache-from-env lower-state names)]
    [cur-out : lower_i64_i64_map.Map out]
    ;; Feed the wrapper peel the backing slot directly. Binding the row to a
    ;; local first would materialise a copy that `ast-decl-unwrapped` then
    ;; copies again; an aggregate argument is passed by reference, so the
    ;; projection costs nothing.
    [decl-slots : (__tl_dyn-array ast.AstDecl) decls.slots]
    [decl-offset : i64 decls.offset]
    (while (< index count)
      (match (ast.ast-decl-unwrapped
        (lower-global-array-element-shared-view
          decl-slots
          (+ decl-offset index)))
        [(Module next-module) (set! cur-module-id next-module)]
        [(DefFn decl-meta name _ _ body-box _)
          ;; The early-exit fact lookup takes the per-body typecheck state
          ;; (#6056); the walk itself reads the backing slot instead of a
          ;; stepped-out row.
          (let
            [has-early-return : bool
              (match (tc_core.tc-body-early-exit-fact
                (tc_core.tc-context-body-state ctx)
                body-box)
                [(Known value) value]
                [(Unknown) (lower-rvo-node-has-early-return? ctx body-box)])]
            (if has-early-return
              (let
                [key-id : i64
                  (lower-module-name-key-id-by-id cur-module-id name)]
                (lower_i64_i64_map.insert-ref!
                  (&mut cur-out)
                  (lower-name-cache-lookup-logical-id
                    (& name-cache)
                    key-id
                    key-id)
                  1))
              unit))]
        [_ unit])
      (set! index (+ index 1)))
    cur-out))

(define (lower-rvo-early-return-functions-from-decls
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [decls : (& decls ast.AstDeclList)]
  [names : LowerNameEnv]) : lower_i64_i64_map.Map
  (lower-rvo-early-return-functions-from-decls-in-module
    lower-state
    ctx
    decls
    names
    ""
    cbi.compiler-builtin-id-fix-empty
    (lower_i64_i64_map.with-capacity 8192)))

(define (lower-decls
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [globals : ir.CompilerIrGlobalSeq]
  [functions : ir.CompilerIrFunctionSeq]
  [externs : ir.CompilerIrExternSeq]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameEnv]
  [clone-roots : clone_support.CloneRootEntries]
  [mode : CompilerLowerMode]) : ResultLowerDecls
  (compiler-lower-state-write!
    lower-state
    csym.CompilerSymbols
    active-symbols
    (csym.compiler-symbols-shared-view (tc_core.tc-context-symbols ctx)))
  (compiler-lower-state-write! lower-state bool active-symbols-ready true)
  (let
    [dispatch-name-cache : LowerNameCache
      (lower-name-cache-with-clone-roots
        (lower-name-cache-from-env lower-state (lower-global-shared-view names))
        clone-roots)]
    [dispatch-variants : lower_i64_i64_map.Map
      (lower-dispatch-variant-set-from-decls
        (lower-global-shared-view decls)
        paths
        (lower-global-shared-view entry-path)
        dispatch-name-cache)]
    ;; Build the shared global name/type caches once; per-module caches
    ;; are small overlays that fall through to them. The initial cur caches are
    ;; empty overlays (everything resolves via the global caches) for decls in
    ;; the leading "" module before the first (module ...) marker.
    (lower-active-global-name-cache-set! lower-state dispatch-name-cache)
    (compiler-lower-state-write!
      lower-state
      LowerModuleLocalViewStore
      active-module-local-views
      (lower-module-local-view-store-empty))
    (compiler-lower-state-write!
      lower-state
      LowerTypeCache
      decls-global-type-cache
      (lower-type-cache-from-env lower-state top-env))
    (compiler-lower-state-write!
      lower-state
      lower_i64_i64_map.Map
      rvo-early-return-functions
      (lower-rvo-early-return-functions-from-decls
        lower-state
        ctx
        decls
        (lower-global-shared-view names)))
    (lower-decls-in-module
      ctx
      top-env
      top-env
      decls
      paths
      entry-path
      globals
      functions
      externs
      spans
      names
      (lower-name-cache-overlay
        lower-state
        (Nil)
        cbi.compiler-builtin-id-fix-empty)
      (lower-type-cache-overlay lower-state (tc_core.tc-empty-env))
      dispatch-variants
      mode
      ""
      cbi.compiler-builtin-id-fix-empty)))

(defenum LowerSkippedRuntimeWithPaths
  (Skipped ast.AstDeclList ast.AstDeclPathList))

(define (lower-skip-runtime-until-next-module-with-paths
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]) : LowerSkippedRuntimeWithPaths
  (match (ast.ast-decl-list-step decls)
    [(Nil) (Skipped (ast.ast-decl-list-new) (ast.ast-decl-path-list-new))]
    [(Cons decl rest)
      (let
        [rest : ast.AstDeclList rest]
        [decl-path : String (ast.ast-decl-path-list-get (& paths) 0 "")]
        [owner-id : i64
          (ast.ast-decl-path-list-owner-id
            (& paths)
            0
            cbi.compiler-builtin-id-fix-empty)]
        [provenance-id : i64
          (ast.ast-decl-path-list-provenance-id
            (& paths)
            0
            cbi.compiler-builtin-id-fix-empty)]
        [rest-paths : ast.AstDeclPathList
          (ast.ast-decl-path-list-tail (lower-global-shared-view paths))]
        (match (lower-global-shared-view decl)
          [(Module _) (Skipped decls paths)]
          [_
            (match (lower-skip-runtime-until-next-module-with-paths
              rest
              rest-paths)
              [(Skipped kept kept-paths)
                (if (lower-type-decl? (lower-global-shared-view decl))
                  (Skipped
                    (ast.ast-decl-list-prepend-builder decl kept)
                    (ast.ast-decl-path-list-prepend-builder-with-owner-and-provenance-id
                      decl-path
                      owner-id
                      provenance-id
                      kept-paths))
                  (Skipped kept kept-paths))])]))]))

(define (lower-decls-in-module
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [local-top-env : tc_core.TcTypeEnv]
  [decls : ast.AstDeclList]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [globals : ir.CompilerIrGlobalSeq]
  [functions : ir.CompilerIrFunctionSeq]
  [externs : ir.CompilerIrExternSeq]
  [spans : ir.CompilerSourceSpans]
  [names : LowerNameEnv]
  [name-cache : LowerNameCache]
  [type-cache : LowerTypeCache]
  [dispatch-variants : lower_i64_i64_map.Map]
  [mode : CompilerLowerMode]
  [module : String]
  [module-id : i64]) : ResultLowerDecls
  (let
    [lower-state : CompilerLowerState
      (compiler-lower-state-from-name-cache name-cache)]
    [cur-decls : ast.AstDeclList decls]
    [cur-paths : ast.AstDeclPathList paths]
    [cur-local-top-env : tc_core.TcTypeEnv local-top-env]
    [cur-globals : ir.CompilerIrGlobalBuilder
      (ir.compiler-ir-global-builder-from-seq globals)]
    [cur-functions : ir.CompilerIrFunctionBuilder
      (ir.compiler-ir-function-builder-from-seq functions)]
    [cur-externs : ir.CompilerIrExternBuilder
      (ir.compiler-ir-extern-builder-from-seq externs)]
    [cur-spans : ir.CompilerSourceSpans spans]
    [cur-name-cache : LowerNameCache name-cache]
    [cur-type-cache : LowerTypeCache type-cache]
    [cur-module : String module]
    [cur-module-id : i64 module-id]
    [view-epochs : LowerModuleViewEpochs
      (lower-module-view-epochs-new (lower-global-shared-view cur-decls))]
    [marker-index : i64 0]
    [result : ResultLowerDecls
      (Err (box (lower-diagnostic "lower: internal decls walk")))]
    [done : bool false]
    (while (not done)
      (match (ast.ast-decl-list-step cur-decls)
        [(Nil)
          (lower-module-view-epochs-release-before!
            lower-state
            (&mut view-epochs)
            view-epochs.marker-count)
          (set!
            result
            (Ok
              (box
                (LowerDeclsSuccess
                  (ir.compiler-ir-global-builder-snapshot-seq (& cur-globals))
                  (ir.compiler-ir-function-builder-snapshot (& cur-functions))
                  (ir.compiler-ir-extern-builder-snapshot-seq (& cur-externs))
                  (lower-global-shared-view cur-spans)))))
          (set! done true)]
        [(Cons decl rest)
          (let
            [rest : ast.AstDeclList rest]
            [decl-path : String
              (ast.ast-decl-path-list-get
                (& cur-paths)
                0
                (lower-global-shared-view entry-path))]
            [logical-module-id : i64
              (lower-decl-owner-module-id
                lower-state
                (& cur-paths)
                0
                (lower-global-shared-view entry-path)
                (lower-global-shared-view decl-path)
                cur-module-id)]
            [logical-module : String
              (lower-decl-owner-module-name
                lower-state
                cur-module-id
                logical-module-id)]
            [decl-name-cache : LowerNameCache
              (lower-name-cache-with-module-id
                (lower-global-shared-view cur-name-cache)
                logical-module-id)]
            [rest-paths : ast.AstDeclPathList
              (ast.ast-decl-path-list-tail (lower-global-shared-view cur-paths))]
            [_advance-paths : unit (set! cur-paths rest-paths)]
            ;; Emitted locations (abort messages, line tables) name a
            ;; root-resolved stdlib module by its canonical path, as the
            ;; embedded payload does; compiler diagnostics keep the
            ;; physical one.
            [_source-path : unit
              (compiler-lower-state-write!
                lower-state
                i64
                current-source-path-id
                (if (> (string.string-length decl-path) 0)
                  (let
                    [location-path : String
                      (load.compiler-load-canonical-stdlib-path
                        (lower-global-shared-view decl-path))]
                    (load.compiler-load-source-path-id location-path))
                  0))]
            [_generated-decl : unit
              (compiler-lower-state-write!
                lower-state
                bool
                current-decl-generated
                (match (ast.ast-decl-generated-meta decl)
                  [(Some _ _ _ _) true]
                  [(No) false]))]
            (match (ast.ast-decl-unwrapped (lower-global-shared-view decl))
              [(ModuleBody _ _) (set! cur-decls rest)]
              [(Def decl-meta name _ expr-box)
                (let
                  [decl-ctx : tc_core.TcContext
                    (tc_core.tc-context-with-module-id
                      ctx
                      (lower-global-shared-view cur-module)
                      cur-module-id)]
                  [expr : ast.AstExpr
                    (lower-context-expr-get decl-ctx expr-box)]
                  (match (lower-top-decl-type-or-check
                    decl-ctx
                    cur-local-top-env
                    decl)
                    [(Ok ty)
                      (let
                        [global-ty : ast.AstType
                          (tc_core.tc-type-without-regions ty)]
                        [global-name : String
                          (lower-current-decl-logical-name-cache-id
                            decl-name-cache
                            logical-module
                            (lower-name-id-text lower-state name)
                            name)]
                        [global-key-id : i64
                          (lower-module-name-key-id-by-id
                            logical-module-id
                            name)]
                        [global-id : i64
                          (lower-name-cache-lookup-logical-id
                            (& decl-name-cache)
                            global-key-id
                            global-key-id)]
                        [global-symbol : i64
                          (lower-name-cache-ir-symbol
                            decl-name-cache
                            global-id
                            name
                            global-name)]
                        (match (lower-global-value
                          decl-ctx
                          (lower-global-shared-view decl-name-cache)
                          (lower-global-shared-view expr)
                          (lower-global-shared-view global-ty))
                          [(Ok value)
                            (ir.compiler-ir-global-builder-push!
                              (&mut cur-globals)
                              (ir.CompilerIrGlobal.Global
                                global-symbol
                                global-ty
                                value))
                            (set! cur-decls rest)]
                          ;; A global whose initializer is not a compile-time
                          ;; constant is evaluated at startup by a hidden
                          ;; `__global_init_<name>` function whose return
                          ;; value the backend stores into the global before
                          ;; `main`. This applies to any non-unit type
                          ;; (scalars as well as aggregates), mirroring the
                          ;; former Rust lowerer, which emits an init function
                          ;; whenever `extract_const` yields no constant.
                          [(Err _)
                            (let
                              [init-symbol : i64
                                (lower-global-init-function-name
                                  lower-state
                                  global-symbol)]
                              (match (lower-function-escaping
                                decl-ctx
                                cur-local-top-env
                                (lower-global-shared-view cur-type-cache)
                                init-symbol
                                (ast.ast-param-list-new)
                                (lower-global-shared-view global-ty)
                                expr
                                (lower-global-shared-view cur-spans)
                                decl-name-cache
                                mode)
                                [(Ok init-funcs init-spans)
                                  (ir.compiler-ir-global-builder-push!
                                    (&mut cur-globals)
                                    (ir.CompilerIrGlobal.Global
                                      global-symbol
                                      global-ty
                                      (RuntimeGlobal init-symbol)))
                                  (ir.compiler-ir-function-builder-append-seq!
                                    (&mut cur-functions)
                                    init-funcs)
                                  (set! cur-spans init-spans)
                                  (set! cur-decls rest)]
                                [(Err init-message)
                                  (set! result (Err init-message))
                                  (set! done true)]))]))]
                    [(Err message)
                      (set! result (Err (box (lower-diagnostic message))))
                      (set! done true)]))]
              [(Extern decl-meta name _ metadata ty)
                (let
                  [decl-ctx : tc_core.TcContext
                    (tc_core.tc-context-with-module-id
                      ctx
                      (lower-global-shared-view cur-module)
                      cur-module-id)]
                  [resolved-ty : ast.AstType
                    (tc_core.tc-resolve-type decl-ctx ty)]
                  [logical-name : String
                    (lower-current-decl-logical-name-cache-id
                      decl-name-cache
                      logical-module
                      (lower-name-id-text lower-state name)
                      name)]
                  [logical-key-id : i64
                    (lower-module-name-key-id-by-id logical-module-id name)]
                  [logical-id : i64
                    (lower-name-cache-lookup-logical-id
                      (& decl-name-cache)
                      logical-key-id
                      logical-key-id)]
                  (if (and
                    (tc_core.tc-type-contains-reference?
                      (lower-global-shared-view resolved-ty))
                    (not
                      (lower-supported-reference-extern?
                        decl-ctx
                        name
                        (lower-global-shared-view resolved-ty))))
                    (begin
                      (set!
                        result
                        (Err
                          (box
                            (lower-diagnostic (lower-reference-support-message)))))
                      (set! done true))
                    (begin
                      (ir.compiler-ir-extern-builder-push!
                        (&mut cur-externs)
                        (ir.CompilerIrExtern.Extern
                          (lower-extern-logical-symbol-id
                            lower-state
                            logical-id
                            (lower-global-shared-view logical-name)
                            name
                            (lower-box-shared-view metadata))
                          name
                          logical-name
                          (tc_core.tc-type-without-regions resolved-ty)
                          (ast.ast-extern-metadata-abi
                            (lower-box-shared-view metadata))
                          (ci.intern-id-value
                            (ast.ast-extern-metadata-symbol-id
                              (lower-box-shared-view metadata)))
                          (ast.ast-extern-metadata-link-inputs (deref metadata))
                          false))
                      (set! cur-decls rest))))]
              [(DefFn decl-meta name params ret body-box metadata)
                (let
                  [decl-ctx : tc_core.TcContext
                    (tc_core.tc-context-with-module-id
                      ctx
                      (lower-global-shared-view cur-module)
                      cur-module-id)]
                  [body : ast.AstExpr
                    (lower-context-expr-get decl-ctx body-box)]
                  [logical-id : i64
                    (lower-decl-logical-id
                      lower-state
                      (lower-global-shared-view entry-path)
                      decl-path
                      (lower-global-shared-view logical-module)
                      logical-module-id
                      name
                      (lower-name-id-text lower-state name))]
                  [logical-name : String
                    (if (= logical-id cbi.compiler-builtin-id-fix-main)
                      "main"
                      (lower-current-decl-logical-name-cache-id
                        decl-name-cache
                        logical-module
                        (lower-name-id-text lower-state name)
                        name))]
                  [function-symbol : i64
                    (lower-decl-function-symbol-id
                      decl-name-cache
                      logical-id
                      name
                      (lower-global-shared-view logical-name))]
                  (if (lower_i64_i64_map.contains?
                    (& dispatch-variants)
                    logical-id)
                    (set! cur-decls rest)
                    (begin
                      (cfg
                        compile-profile
                        (compiler-lower-profile-detail-start lower-state))
                      (match (lower-function-escaping
                        decl-ctx
                        cur-local-top-env
                        (lower-global-shared-view cur-type-cache)
                        function-symbol
                        (lower-global-shared-view params)
                        (lower-global-shared-view ret)
                        (lower-global-shared-view body)
                        (lower-global-shared-view cur-spans)
                        decl-name-cache
                        mode)
                        [(Ok lowered-functions function-spans)
                          (match (lower-spmd-package-callable-functions
                            decl-ctx
                            cur-local-top-env
                            (lower-global-shared-view cur-type-cache)
                            (csym.compiler-symbol-module-key
                              (if (= (string.string-length cur-module) 0)
                                (compiler-lower-state-spmd-package-name
                                  lower-state)
                                (owned_view.compiler-owned-shared-view
                                  cur-module))
                              (lower-name-id-text lower-state name))
                            (csym.compiler-symbols-lookup-value-id-or
                              (tc_core.tc-context-symbols decl-ctx)
                              logical-id
                              (csym.compiler-symbols-lookup-value-id-or
                                (tc_core.tc-context-symbols decl-ctx)
                                name
                                (csym.compiler-symbols-missing-handle)))
                            (lower-global-shared-view params)
                            (lower-global-shared-view ret)
                            body
                            (ast.ast-fn-metadata-spmd-callable
                              (lower-global-shared-view metadata))
                            function-spans
                            (lower-global-shared-view cur-name-cache)
                            mode)
                            [(Err message)
                              (begin
                                (cfg
                                  compile-profile
                                  (compiler-lower-profile-detail-finish
                                    lower-state
                                    "function"
                                    logical-name))
                                (set! result (Err message))
                                (set! done true))]
                            [(Ok callable-functions next-spans)
                              (let
                                [_export : unit
                                  (match (ast.ast-fn-metadata-export metadata)
                                    [(No) unit]
                                    [(Export symbol)
                                      (ir.compiler-ir-extern-builder-push!
                                        (&mut cur-externs)
                                        (ir.CompilerIrExtern.Extern
                                          function-symbol
                                          function-symbol
                                          (lower-global-shared-view
                                            logical-name)
                                          (ast.ast-ty-func
                                            (tc_core.tc-type-list-without-regions
                                              (tc_core.tc-param-type-list
                                                decl-ctx
                                                params))
                                            (tc_core.tc-type-without-regions
                                              (tc_core.tc-resolve-type
                                                decl-ctx
                                                ret)))
                                          (C)
                                          (ci.intern-id-value symbol)
                                          (ast.ast-extern-link-input-list-new)
                                          true))])]
                                (begin
                                  (cfg
                                    compile-profile
                                    (compiler-lower-profile-detail-finish
                                      lower-state
                                      "function"
                                      logical-name))
                                  (ir.compiler-ir-function-builder-append-seq!
                                    (&mut cur-functions)
                                    lowered-functions)
                                  (ir.compiler-ir-function-builder-append-seq!
                                    (&mut cur-functions)
                                    callable-functions)
                                  (set! cur-spans next-spans)
                                  (set! cur-decls rest)))])]
                        [(Err message)
                          (begin
                            (cfg
                              compile-profile
                              (compiler-lower-profile-detail-finish
                                lower-state
                                "function"
                                logical-name))
                            (set! result (Err message))
                            (set! done true))]))))]
              [(DefMacro decl-meta _ _ _ _) (set! cur-decls rest)]
              [(DefDispatch decl-meta name variants)
                (match (lower-dispatch-decl
                  ctx
                  top-env
                  cur-local-top-env
                  (lower-global-shared-view cur-type-cache)
                  name
                  variants
                  (lower-global-shared-view cur-spans)
                  decl-name-cache
                  mode
                  (lower-global-shared-view cur-module)
                  cur-module-id
                  logical-module
                  logical-module-id)
                  [(Ok lowered)
                    (match (deref lowered)
                      [(Decl cache-global lowered-functions function-spans)
                        (ir.compiler-ir-global-builder-push!
                          (&mut cur-globals)
                          cache-global)
                        (ir.compiler-ir-function-builder-append-seq!
                          (&mut cur-functions)
                          lowered-functions)
                        (set! cur-spans function-spans)
                        (set! cur-decls rest)])]
                  [(Err message)
                    (set! result (Err message))
                    (set! done true)])]
              [(Import decl-meta _) (set! cur-decls rest)]
              [(IncludeStr _ _) (set! cur-decls rest)]
              [(IncludeStrComptime _ _) (set! cur-decls rest)]
              [(IncludeStrLzss _ _) (set! cur-decls rest)]
              [(IncludeBin _ _) (set! cur-decls rest)]
              [(Module next-module)
                (let
                  [next-module-str : String
                    (lower-name-id-text lower-state next-module)]
                  [skip-runtime : bool
                    (lower-comptime-runtime-skip-module? next-module-str)]
                  [marker : i64 marker-index]
                  [_next-marker : unit (set! marker-index (+ marker-index 1))]
                  (match (lower-module-local-view-cached
                    lower-state
                    ctx
                    top-env
                    (lower-global-shared-view names)
                    next-module-str
                    next-module
                    (&mut view-epochs))
                    [(Ok view)
                      (set! cur-local-top-env view.local-top-env)
                      (set! cur-name-cache view.name-cache)
                      (set! cur-type-cache view.type-cache)
                      (set! cur-module next-module-str)
                      (set! cur-module-id next-module)
                      (lower-module-view-epochs-release-before!
                        lower-state
                        (&mut view-epochs)
                        marker)
                      (if skip-runtime
                        (match (lower-skip-runtime-until-next-module-with-paths
                          rest
                          cur-paths)
                          [(Skipped kept-decls kept-paths)
                            (set! cur-decls kept-decls)
                            (set! cur-paths kept-paths)])
                        (set! cur-decls rest))]
                    [(Err message)
                      (set! result (Err (box (lower-diagnostic message))))
                      (set! done true)]))]
              [(Test _ _ _ _) (set! cur-decls rest)]
              [(DefEnum decl-meta name cleanup variants)
                (let
                  [decl-ctx : tc_core.TcContext
                    (tc_core.tc-context-with-module-id
                      ctx
                      (lower-global-shared-view cur-module)
                      cur-module-id)]
                  [logical-name : i64
                    (match cleanup
                      [(No) -1]
                      [(Fn cleanup-name)
                        (let
                          [cleanup-name-id : i64
                            (ci.intern-syntax-id-value cleanup-name)]
                          [key-id : i64
                            (lower-module-name-key-id-by-id
                              logical-module-id
                              cleanup-name-id)]
                          (lower-name-cache-ir-symbol
                            decl-name-cache
                            (lower-name-cache-lookup-logical-id
                              (& decl-name-cache)
                              key-id
                              key-id)
                            cleanup-name-id
                            (lower-current-decl-logical-name-cache-id
                              decl-name-cache
                              (lower-global-shared-view logical-module)
                              (lower-name-id-text lower-state cleanup-name-id)
                              cleanup-name-id)))])]
                  [enum-id : i64
                    (csym.compiler-symbol-module-key-id-by-id
                      cur-module-id
                      name)]
                  (if (lower-comptime-runtime-skip-module? cur-module)
                    unit
                    (lower-nullary-variant-globals
                      (compiler-lower-state-interns lower-state)
                      (lower-name-cache-lookup-logical-id
                        (& decl-name-cache)
                        (lower-module-name-key-id-by-id logical-module-id name)
                        (lower-module-name-key-id-by-id logical-module-id name))
                      (lower-current-decl-logical-name-cache-id
                        decl-name-cache
                        logical-module
                        (lower-name-id-text lower-state name)
                        name)
                      variants
                      0
                      (&mut cur-globals)))
                  (match (lower-enum-cleanup-decl
                    decl-ctx
                    cur-local-top-env
                    (lower-global-shared-view cur-type-cache)
                    logical-name
                    cleanup
                    (Enum enum-id)
                    variants
                    (lower-global-shared-view cur-spans)
                    decl-name-cache
                    mode)
                    [(Ok cleanup-functions cleanup-spans)
                      (ir.compiler-ir-function-builder-append-seq!
                        (&mut cur-functions)
                        cleanup-functions)
                      (set! cur-spans cleanup-spans)
                      (set! cur-decls rest)]
                    [(Err message)
                      (set! result (Err message))
                      (set! done true)]))]
              [(DefEnumLifetimes decl-meta name lifetimes cleanup variants)
                (let
                  [decl-ctx : tc_core.TcContext
                    (tc_core.tc-context-with-module-id
                      ctx
                      (lower-global-shared-view cur-module)
                      cur-module-id)]
                  [logical-name : i64
                    (match cleanup
                      [(No) -1]
                      [(Fn cleanup-name)
                        (let
                          [cleanup-name-id : i64
                            (ci.intern-syntax-id-value cleanup-name)]
                          [key-id : i64
                            (lower-module-name-key-id-by-id
                              logical-module-id
                              cleanup-name-id)]
                          (lower-name-cache-ir-symbol
                            decl-name-cache
                            (lower-name-cache-lookup-logical-id
                              (& decl-name-cache)
                              key-id
                              key-id)
                            cleanup-name-id
                            (lower-current-decl-logical-name-cache-id
                              decl-name-cache
                              (lower-global-shared-view logical-module)
                              (lower-name-id-text lower-state cleanup-name-id)
                              cleanup-name-id)))])]
                  [enum-id : i64
                    (csym.compiler-symbol-module-key-id-by-id
                      cur-module-id
                      name)]
                  (if (lower-comptime-runtime-skip-module? cur-module)
                    unit
                    (lower-nullary-variant-globals
                      (compiler-lower-state-interns lower-state)
                      (lower-name-cache-lookup-logical-id
                        (& decl-name-cache)
                        (lower-module-name-key-id-by-id logical-module-id name)
                        (lower-module-name-key-id-by-id logical-module-id name))
                      (lower-current-decl-logical-name-cache-id
                        decl-name-cache
                        logical-module
                        (lower-name-id-text lower-state name)
                        name)
                      variants
                      0
                      (&mut cur-globals)))
                  (match (lower-enum-cleanup-decl
                    decl-ctx
                    cur-local-top-env
                    (lower-global-shared-view cur-type-cache)
                    logical-name
                    cleanup
                    (ast.ast-ty-enum-args enum-id lifetimes)
                    variants
                    (lower-global-shared-view cur-spans)
                    decl-name-cache
                    mode)
                    [(Ok cleanup-functions cleanup-spans)
                      (ir.compiler-ir-function-builder-append-seq!
                        (&mut cur-functions)
                        cleanup-functions)
                      (set! cur-spans cleanup-spans)
                      (set! cur-decls rest)]
                    [(Err message)
                      (set! result (Err message))
                      (set! done true)]))]
              [(DefStruct decl-meta name _ cleanup fields)
                (let
                  [decl-ctx : tc_core.TcContext
                    (tc_core.tc-context-with-module-id
                      ctx
                      (lower-global-shared-view cur-module)
                      cur-module-id)]
                  [logical-name : i64
                    (match cleanup
                      [(No) -1]
                      [(Fn cleanup-name)
                        (let
                          [cleanup-name-id : i64
                            (ci.intern-syntax-id-value cleanup-name)]
                          [key-id : i64
                            (lower-module-name-key-id-by-id
                              logical-module-id
                              cleanup-name-id)]
                          (lower-name-cache-ir-symbol
                            decl-name-cache
                            (lower-name-cache-lookup-logical-id
                              (& decl-name-cache)
                              key-id
                              key-id)
                            cleanup-name-id
                            (lower-current-decl-logical-name-cache-id
                              decl-name-cache
                              logical-module
                              (lower-name-id-text lower-state cleanup-name-id)
                              cleanup-name-id)))])]
                  [struct-ty : ast.AstType
                    (Struct
                      (csym.compiler-symbol-module-key-id-by-id
                        cur-module-id
                        name))]
                  (match (lower-struct-cleanup-decl
                    decl-ctx
                    cur-local-top-env
                    (lower-global-shared-view cur-type-cache)
                    logical-name
                    cleanup
                    struct-ty
                    fields
                    (lower-global-shared-view cur-spans)
                    decl-name-cache
                    mode)
                    [(Ok cleanup-functions cleanup-spans)
                      (ir.compiler-ir-function-builder-append-seq!
                        (&mut cur-functions)
                        cleanup-functions)
                      (set! cur-spans cleanup-spans)
                      (set! cur-decls rest)]
                    [(Err message)
                      (set! result (Err message))
                      (set! done true)]))]
              [(DefStructLifetimes decl-meta name lifetimes _ cleanup fields)
                (let
                  [decl-ctx : tc_core.TcContext
                    (tc_core.tc-context-with-module-id
                      ctx
                      (lower-global-shared-view cur-module)
                      cur-module-id)]
                  [logical-name : i64
                    (match cleanup
                      [(No) -1]
                      [(Fn cleanup-name)
                        (let
                          [cleanup-name-id : i64
                            (ci.intern-syntax-id-value cleanup-name)]
                          [key-id : i64
                            (lower-module-name-key-id-by-id
                              logical-module-id
                              cleanup-name-id)]
                          (lower-name-cache-ir-symbol
                            decl-name-cache
                            (lower-name-cache-lookup-logical-id
                              (& decl-name-cache)
                              key-id
                              key-id)
                            cleanup-name-id
                            (lower-current-decl-logical-name-cache-id
                              decl-name-cache
                              logical-module
                              (lower-name-id-text lower-state cleanup-name-id)
                              cleanup-name-id)))])]
                  [struct-ty : ast.AstType
                    (ast.ast-ty-struct-args
                      (csym.compiler-symbol-module-key-id-by-id
                        cur-module-id
                        name)
                      lifetimes)]
                  (match (lower-struct-cleanup-decl
                    decl-ctx
                    cur-local-top-env
                    (lower-global-shared-view cur-type-cache)
                    logical-name
                    cleanup
                    struct-ty
                    fields
                    (lower-global-shared-view cur-spans)
                    decl-name-cache
                    mode)
                    [(Ok cleanup-functions cleanup-spans)
                      (ir.compiler-ir-function-builder-append-seq!
                        (&mut cur-functions)
                        cleanup-functions)
                      (set! cur-spans cleanup-spans)
                      (set! cur-decls rest)]
                    [(Err message)
                      (set! result (Err message))
                      (set! done true)]))]
              [(Unsafe _) (set! cur-decls rest)]))]))
    result))

;; --- debug type graph (#8237) ----------------------------------------------
;; Job-owned under debug info. Every binding type lowering meets is interned
;; into `graph` at once, in the job's `arena`, so nothing refers to a
;; function's scratch storage. `keys` runs parallel to the graph's nodes and
;; holds each node's dedup key; `index` maps a key's hash, linearly probed, to
;; its node. A nominal node still being built has size -1.
;; Under `--verify-ir`, `error` holds the first layout disagreement found.
(defstruct LowerDebugTypes
  (arena i64)
  (keys (__tl_dyn-array String))
  (index lower_i64_i64_map.Map)
  (error String)
  (graph ir.CompilerDebugTypeGraph))

(define (lower-debug-types-empty) : LowerDebugTypes
  (LowerDebugTypes
    (arena.tl_arena_current)
    (__tl_make-array String 0)
    (lower_i64_i64_map.with-capacity 64)
    ""
    (ir.compiler-debug-type-graph-empty)))

;; Intern TY into the debug type graph; a no-op without debug info.
(define (lower-debug-type-root!
  [owner : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [ty : ast.AstType]) : unit
  (when
    (ir.compiler-debug-info-enabled?)
    (let
      [types : LowerDebugTypes
        (compiler-lower-state-read owner LowerDebugTypes debug-types)]
      (in-arena
        (arena.Arena types.arena)
        (lower-debug-type-id! ctx (&mut types) ty))
      (compiler-lower-state-write! owner LowerDebugTypes debug-types types))))

;; Record a function's parameter and result types as debug type roots.
(define (lower-debug-function-roots!
  [owner : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [params : ast.AstParamList]
  [ret : ast.AstType]) : unit
  (when
    (ir.compiler-debug-info-enabled?)
    (let
      [index : i64 0]
      (while (< index (ast.ast-param-list-len (& params)))
        (match (ast.ast-param-list-get
          (& params)
          index
          (ast.ast-param-fallback))
          [(ast.AstParam.Param _ ty _) (lower-debug-type-root! owner ctx ty)])
        (set! index (+ index 1)))
      (lower-debug-type-root! owner ctx ret))))

(define (compiler-lower-state-debug-type-graph [owner : CompilerLowerState]) : ir.CompilerDebugTypeGraph
  (let
    [types : LowerDebugTypes
      (compiler-lower-state-read owner LowerDebugTypes debug-types)]
    types.graph))

(define (lower-debug-type-resolve [ctx : tc_core.TcContext] [ty : ast.AstType]) : ast.AstType
  (tc_core.tc-type-strip-invalidate
    (tc_core.tc-type-strip-region (tc_core.tc-resolve-type ctx ty))))

(define (lower-debug-type-layout [ctx : tc_core.TcContext] [ty : ast.AstType]) : tc_core.TcLayoutInfo
  (match (tc_core.tc-inline-aggregate-type-layout ctx ty)
    [(tc_core.ResultTcLayoutInfo.Ok info) info]
    [(tc_core.ResultTcLayoutInfo.Err _) (tc_core.TcLayoutInfo.TcLayoutInfo 0 1)]))

(define (lower-debug-node
  [kind : i64]
  [name : String]
  [size : i64]
  [align : i64]
  [target : i64]
  [count : i64]) : ir.CompilerDebugTypeNode
  (ir.CompilerDebugTypeNode kind name size align target count 0 0 0))

;; The node for KEY, or -1. On a miss, the hash slot where KEY would go is the
;; first empty one probed.
(define (lower-debug-type-slot
  [types : (& types LowerDebugTypes)]
  [key : (& key str)]) : i64
  (let
    [slot : i64 (stdlib.hash.string-key key)]
    [found : bool false]
    (while (not found)
      (let
        [id : i64 (lower_i64_i64_map.get-value-or (& types.index) slot -1)]
        (if (or (< id 0) (string.eq (& (array-ref types.keys id)) key))
          (set! found true)
          (set! slot (+ slot 1)))))
    slot))

(define (lower-debug-type-find
  [types : (& types LowerDebugTypes)]
  [key : (& key str)]) : i64
  (lower_i64_i64_map.get-value-or
    (& types.index)
    (lower-debug-type-slot types key)
    -1))

;; Append NODE under KEY and return its id.
(define (lower-debug-type-push!
  [types : (&mut types LowerDebugTypes)]
  [key : String]
  [node : ir.CompilerDebugTypeNode]) : i64
  (let
    [id : i64 (ir.compiler-debug-type-graph-push-node! (&mut types.graph) node)]
    (when
      (>= id (array-length types.keys))
      (let
        [keys : (__tl_dyn-array String)
          (__tl_make-array String (+ 16 (* 2 id)))]
        [index : i64 0]
        (while (< index id)
          (set!
            (array-ref keys index)
            (owned_view.compiler-owned-array-element-shared-view
              types.keys
              index))
          (set! index (+ index 1)))
        (set! types.keys keys)))
    (lower_i64_i64_map.insert-ref!
      (&mut types.index)
      (lower-debug-type-slot types (& key))
      id)
    (set! (array-ref types.keys id) key)
    id))

(define (lower-debug-member!
  [types : (&mut types LowerDebugTypes)]
  [variant : i64]
  [name : String]
  [name-id : i64]
  [type-id : i64]
  [offset : i64]) : unit
  (ir.compiler-debug-type-graph-push-member!
    (&mut types.graph)
    (ir.CompilerDebugTypeMember variant name name-id type-id offset)))

;; The node id of TY, building it and everything it reaches on first use.
(define (lower-debug-type-id!
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [raw : ast.AstType]) : i64
  (let
    [ty : ast.AstType (lower-debug-type-resolve ctx raw)]
    (match (lower-global-shared-view ty)
      [(ast.AstType.Struct name-id)
        (lower-debug-nominal-id! ctx types name-id ty)]
      [(ast.AstType.StructArgs name-id _)
        (lower-debug-nominal-id! ctx types name-id ty)]
      [(ast.AstType.Enum name-id)
        (lower-debug-nominal-id! ctx types name-id ty)]
      [(ast.AstType.EnumArgs name-id _)
        (lower-debug-nominal-id! ctx types name-id ty)]
      [_
        (let
          [key : String (tc_core.tc-type-render (lower-global-shared-view ty))]
          [found : i64 (lower-debug-type-find types (& key))]
          (if (>= found 0)
            found
            (lower-debug-structural-id! ctx types ty key)))])))

(define (lower-debug-structural-id!
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [ty : ast.AstType]
  [key : String]) : i64
  (let
    [layout : tc_core.TcLayoutInfo
      (lower-debug-type-layout ctx (lower-global-shared-view ty))]
    [size : i64 (tc_core.tc-layout-info-size layout)]
    [align : i64 (tc_core.tc-layout-info-align layout)]
    [id : i64
      (lower-debug-type-push!
        types
        (string.copy (& key))
        (lower-debug-node ir.compiler-debug-type-opaque key size align -1 -1))]
    (ir.compiler-debug-type-graph-set-node!
      (&mut types.graph)
      id
      (lower-debug-structural-node ctx types ty size align))
    id))

(define (lower-debug-structural-node
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [ty : ast.AstType]
  [size : i64]
  [align : i64]) : ir.CompilerDebugTypeNode
  (let
    [name : String (tc_core.tc-type-render (lower-global-shared-view ty))]
    (match ty
      [(ast.AstType.String)
        (lower-debug-node
          ir.compiler-debug-type-handle
          name
          8
          8
          (lower-debug-type-id! ctx types (ast.AstType.U8))
          -1)]
      [(ast.AstType.Str)
        (lower-debug-node
          ir.compiler-debug-type-handle
          name
          8
          8
          (lower-debug-type-id! ctx types (ast.AstType.U8))
          -1)]
      [(ast.AstType.Tuple elems)
        (lower-debug-tuple-node ctx types name (deref elems) size align)]
      [(ast.AstType.Array elem count)
        (lower-debug-node
          ir.compiler-debug-type-array
          name
          size
          align
          (lower-debug-type-id!
            ctx
            types
            (tc_core.tc-context-type-get ctx elem))
          count)]
      [(ast.AstType.DynArray elem)
        (lower-debug-node
          ir.compiler-debug-type-handle
          name
          8
          8
          (lower-debug-type-id!
            ctx
            types
            (tc_core.tc-context-type-get ctx elem))
          -1)]
      [(ast.AstType.Box elem) (lower-debug-pointer-node ctx types name elem)]
      [(ast.AstType.Ptr elem) (lower-debug-pointer-node ctx types name elem)]
      [(ast.AstType.MutPtr elem) (lower-debug-pointer-node ctx types name elem)]
      [(ast.AstType.Ref _ inner)
        (lower-debug-reference-node ctx types name inner)]
      [(ast.AstType.MutRef _ inner)
        (lower-debug-reference-node ctx types name inner)]
      [(ast.AstType.Func _ _)
        (lower-debug-node ir.compiler-debug-type-function name 8 8 -1 -1)]
      [(ast.AstType.CFunc _ _)
        (lower-debug-node ir.compiler-debug-type-function name 8 8 -1 -1)]
      [(ast.AstType.Expr)
        (lower-debug-node ir.compiler-debug-type-opaque name size align -1 -1)]
      [(ast.AstType.ExprList)
        (lower-debug-node ir.compiler-debug-type-opaque name size align -1 -1)]
      [(ast.AstType.Var _)
        (lower-debug-node ir.compiler-debug-type-opaque name size align -1 -1)]
      [(ast.AstType.VarArgs _ _)
        (lower-debug-node ir.compiler-debug-type-opaque name size align -1 -1)]
      [(ast.AstType.Slice _)
        (lower-debug-node ir.compiler-debug-type-opaque name size align -1 -1)]
      [(ast.AstType.Bytes)
        (lower-debug-node ir.compiler-debug-type-opaque name size align -1 -1)]
      [_ (lower-debug-node ir.compiler-debug-type-scalar name size align -1 -1)])))

(define (lower-debug-pointer-node
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [name : String]
  [elem : i64]) : ir.CompilerDebugTypeNode
  (lower-debug-node
    ir.compiler-debug-type-pointer
    name
    8
    8
    (lower-debug-type-id! ctx types (tc_core.tc-context-type-get ctx elem))
    -1))

;; A borrow of str or a dynamic array reuses the referent's handle; a borrow of
;; a Slice or bytes is a {data, len} view; any other borrow addresses its
;; referent's storage.
(define (lower-debug-reference-node
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [name : String]
  [inner : i64]) : ir.CompilerDebugTypeNode
  (let
    [referent : ast.AstType
      (lower-debug-type-resolve ctx (tc_core.tc-context-type-get ctx inner))]
    (match (lower-global-shared-view referent)
      [(ast.AstType.Str)
        (lower-debug-node
          ir.compiler-debug-type-handle
          name
          8
          8
          (lower-debug-type-id! ctx types (ast.AstType.U8))
          -1)]
      [(ast.AstType.DynArray elem)
        (lower-debug-node
          ir.compiler-debug-type-handle
          name
          8
          8
          (lower-debug-type-id!
            ctx
            types
            (tc_core.tc-context-type-get ctx elem))
          -1)]
      [(ast.AstType.Slice elem)
        (lower-debug-node
          ir.compiler-debug-type-view
          name
          16
          8
          (lower-debug-type-id!
            ctx
            types
            (tc_core.tc-context-type-get ctx elem))
          -1)]
      [(ast.AstType.Bytes)
        (lower-debug-node
          ir.compiler-debug-type-view
          name
          16
          8
          (lower-debug-type-id! ctx types (ast.AstType.U8))
          -1)]
      [_
        (lower-debug-node
          ir.compiler-debug-type-pointer
          name
          8
          8
          (lower-debug-type-id! ctx types referent)
          -1)])))

;; Tuple elements sit where lowering addresses them: each aligned after the
;; previous one.
(define (lower-debug-tuple-node
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [name : String]
  [elems : ast.AstTypeList]
  [size : i64]
  [align : i64]) : ir.CompilerDebugTypeNode
  (let
    [count : i64 (ast.ast-type-list-len (& elems))]
    [ids : (__tl_dyn-array i64) (__tl_make-array i64 count)]
    [offsets : (__tl_dyn-array i64) (__tl_make-array i64 count)]
    [index : i64 0]
    [cursor : i64 0]
    [checked : i64 0]
    (while (< index count)
      (let
        [elem : ast.AstType
          (lower-debug-type-resolve
            ctx
            (tc_core.tc-context-type-get
              ctx
              (ast.ast-type-list-get (& elems) index (ast.ast-type-id-fallback))))]
        [offset : i64 (lower-align-up cursor (lower-type-align ctx (& elem)))]
        [elem-layout : tc_core.TcLayoutInfo
          (lower-debug-type-layout ctx (lower-global-shared-view elem))]
        [expected : i64
          (tc_core.tc-align-up
            checked
            (tc_core.tc-layout-info-align elem-layout))]
        (lower-debug-check! types (& name) "element offset" offset expected)
        (set! checked (+ expected (tc_core.tc-layout-info-size elem-layout)))
        (set! (array-ref offsets index) offset)
        (set! cursor (+ offset (lower-type-size ctx (& elem))))
        (set! (array-ref ids index) (lower-debug-type-id! ctx types elem))
        (set! index (+ index 1))))
    (let
      [first : i64 types.graph.member-count]
      (set! index 0)
      (while (< index count)
        (lower-debug-member!
          types
          -1
          (string.int->string index)
          index
          (array-ref ids index)
          (array-ref offsets index))
        (set! index (+ index 1)))
      (ir.CompilerDebugTypeNode
        ir.compiler-debug-type-tuple
        name
        size
        align
        -1
        -1
        0
        first
        count))))

;; A nominal type reached again while its own layout is being built is
;; referenced through one forward node, so the graph stays acyclic.
(define (lower-debug-nominal-id!
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [name-id : i64]
  [ty : ast.AstType]) : i64
  (let
    [key : String (str_cat.str-cat "#" (string.int->string name-id))]
    [found : i64 (lower-debug-type-find types (& key))]
    (cond
      [(< found 0) (lower-debug-nominal-build! ctx types name-id ty key)]
      [(< (__tl-project-field (array-ref types.graph.nodes found) size) 0)
        (let
          [forward-key : String (str_cat.str-cat "forward " key)]
          [forward : i64 (lower-debug-type-find types (& forward-key))]
          (if (>= forward 0)
            forward
            (let
              [layout : tc_core.TcLayoutInfo
                (lower-debug-type-layout ctx (lower-global-shared-view ty))]
              (lower-debug-type-push!
                types
                forward-key
                (lower-debug-node
                  ir.compiler-debug-type-forward
                  (tc_core.tc-nominal-name-id-display name-id)
                  (tc_core.tc-layout-info-size layout)
                  (tc_core.tc-layout-info-align layout)
                  found
                  -1)))))]
      [else found])))

(define (lower-debug-nominal-build!
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [name-id : i64]
  [ty : ast.AstType]
  [key : String]) : i64
  (let
    [name : String (tc_core.tc-nominal-name-id-display name-id)]
    [id : i64
      (lower-debug-type-push!
        types
        key
        (lower-debug-node
          ir.compiler-debug-type-struct
          (string.copy (& name))
          -1
          -1
          -1
          -1))]
    (ir.compiler-debug-type-graph-set-node!
      (&mut types.graph)
      id
      (match (tc_core.tc-inline-aggregate-layout-for-id ctx name-id)
        [(tc_core.ResultTcInlineAggregateLayout.Ok layout)
          (lower-debug-aggregate-node ctx types name layout)]
        [(tc_core.ResultTcInlineAggregateLayout.Err _)
          (lower-debug-node ir.compiler-debug-type-opaque name 0 1 -1 -1)]))
    (lower-debug-nominal-check! ctx types id name-id ty)
    id))

(define (lower-debug-aggregate-node
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [name : String]
  [layout : tc_core.TcInlineAggregateLayout]) : ir.CompilerDebugTypeNode
  (let
    [resident : bool
      (tc_core.tc-inline-aggregate-layout-register-resident?
        (lower-global-shared-view layout))]
    (match layout
      [(tc_core.TcInlineAggregateLayout.Struct size align fields)
        (let
          [count : i64 (tc_core.tc-inline-field-layout-list-count (& fields))]
          [ids : (__tl_dyn-array i64) (__tl_make-array i64 count)]
          [index : i64 0]
          (while (< index count)
            (match (tc_core.tc-inline-field-layout-list-ref (& fields) index)
              [(tc_core.TcInlineFieldLayout.Field _ field-ty _)
                (set!
                  (array-ref ids index)
                  (lower-debug-type-id! ctx types field-ty))])
            (set! index (+ index 1)))
          (let
            [first : i64 types.graph.member-count]
            (set! index 0)
            (while (< index count)
              (match (tc_core.tc-inline-field-layout-list-ref (& fields) index)
                [(tc_core.TcInlineFieldLayout.Field field-id _ offset)
                  (lower-debug-member!
                    types
                    -1
                    (tc_core.tc-env-key-name-text field-id)
                    field-id
                    (array-ref ids index)
                    offset)])
              (set! index (+ index 1)))
            (ir.CompilerDebugTypeNode
              ir.compiler-debug-type-struct
              name
              size
              align
              -1
              -1
              (if resident
                (/ size 8)
                0)
              first
              count)))]
      [(tc_core.TcInlineAggregateLayout.Enum size align variants)
        (lower-debug-enum-node ctx types name size align variants resident)])))

(define (lower-debug-enum-node
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [name : String]
  [size : i64]
  [align : i64]
  [variants : tc_core.TcInlineVariantLayoutList]
  [resident : bool]) : ir.CompilerDebugTypeNode
  (let
    [tag : i64 (lower-debug-type-id! ctx types (ast.AstType.I64))]
    [count : i64 (tc_core.tc-inline-variant-layout-list-count (& variants))]
    [total : i64 0]
    [variant : i64 0]
    (while (< variant count)
      (match (tc_core.tc-inline-variant-layout-list-ref (& variants) variant)
        [(tc_core.TcInlineVariantLayout.Variant _ _ _ payloads)
          (set!
            total
            (+ total (tc_core.tc-inline-payload-layout-list-count (& payloads))))])
      (set! variant (+ variant 1)))
    (let
      [ids : (__tl_dyn-array i64) (__tl_make-array i64 total)]
      [slot : i64 0]
      (set! variant 0)
      (while (< variant count)
        (match (tc_core.tc-inline-variant-layout-list-ref (& variants) variant)
          [(tc_core.TcInlineVariantLayout.Variant _ _ _ payloads)
            (let
              [index : i64 0]
              (while (<
                index
                (tc_core.tc-inline-payload-layout-list-count (& payloads)))
                (match (tc_core.tc-inline-payload-layout-list-ref
                  (& payloads)
                  index)
                  [(tc_core.TcInlinePayloadLayout.Payload _ payload-ty _)
                    (set!
                      (array-ref ids slot)
                      (lower-debug-type-id! ctx types payload-ty))])
                (set! slot (+ slot 1))
                (set! index (+ index 1))))])
        (set! variant (+ variant 1)))
      (let
        [first : i64 types.graph.member-count]
        (set! variant 0)
        (set! slot 0)
        (while (< variant count)
          (match (tc_core.tc-inline-variant-layout-list-ref
            (& variants)
            variant)
            [(tc_core.TcInlineVariantLayout.Variant variant-id _ _ payloads)
              (let
                [index : i64 0]
                (lower-debug-member!
                  types
                  variant
                  (tc_core.tc-env-key-name-text variant-id)
                  variant-id
                  -1
                  -1)
                (while (<
                  index
                  (tc_core.tc-inline-payload-layout-list-count (& payloads)))
                  (match (tc_core.tc-inline-payload-layout-list-ref
                    (& payloads)
                    index)
                    [(tc_core.TcInlinePayloadLayout.Payload
                        payload-index
                        _
                        offset)
                      (lower-debug-member!
                        types
                        variant
                        (string.int->string payload-index)
                        payload-index
                        (array-ref ids slot)
                        offset)])
                  (set! slot (+ slot 1))
                  (set! index (+ index 1))))])
          (set! variant (+ variant 1)))
        (ir.CompilerDebugTypeNode
          ir.compiler-debug-type-enum
          name
          size
          align
          tag
          count
          (if resident
            (/ size 8)
            0)
          first
          (- types.graph.member-count first))))))

;; The first layout disagreement `--verify-ir` found, or "".
(define (lower-debug-types-error [owner : CompilerLowerState]) : String
  (if (ir.compiler-debug-info-enabled?)
    (let
      [types : LowerDebugTypes
        (compiler-lower-state-read owner LowerDebugTypes debug-types)]
      (string.copy (& types.error)))
    ""))

;; Under `--verify-ir`, keep the first disagreement between a graph value and
;; the independent query EXPECTED.
(define (lower-debug-check!
  [types : (&mut types LowerDebugTypes)]
  [name : (& name str)]
  [what : String]
  [graph-value : i64]
  [expected : i64]) : unit
  (when
    (and
      (ir.compiler-debug-type-graph-verify?)
      (= (string.string-length (& types.error)) 0)
      (!= graph-value expected))
    (set!
      types.error
      (str_cat.str-cat
        "debug type graph: "
        (string.copy name)
        " "
        what
        " is "
        (string.int->string graph-value)
        ", the typechecker says "
        (string.int->string expected)))))

;; Check a finished nominal node against the typechecker: its size and
;; alignment as a type, and every member offset looked up by name.
(define (lower-debug-nominal-check!
  [ctx : tc_core.TcContext]
  [types : (&mut types LowerDebugTypes)]
  [id : i64]
  [name-id : i64]
  [ty : ast.AstType]) : unit
  (when
    (ir.compiler-debug-type-graph-verify?)
    (let
      [node : ir.CompilerDebugTypeNode
        (owned_view.compiler-owned-array-element-shared-view
          types.graph.nodes
          id)]
      [layout : tc_core.TcLayoutInfo (lower-debug-type-layout ctx ty)]
      [member : i64 node.first-member]
      [variant-id : i64 -1]
      (lower-debug-check!
        types
        (& node.name)
        "size"
        node.size
        (tc_core.tc-layout-info-size layout))
      (lower-debug-check!
        types
        (& node.name)
        "align"
        node.align
        (tc_core.tc-layout-info-align layout))
      (match (tc_core.tc-inline-aggregate-layout-for-id ctx name-id)
        [(tc_core.ResultTcInlineAggregateLayout.Ok aggregate)
          (while (< member (+ node.first-member node.member-count))
            (let
              [row : ir.CompilerDebugTypeMember
                (owned_view.compiler-owned-array-element-shared-view
                  types.graph.members
                  member)]
              (if (< row.type 0)
                (set! variant-id row.name-id)
                (lower-debug-check!
                  types
                  (& node.name)
                  (str_cat.str-cat "member " row.name " offset")
                  row.offset
                  (if (< variant-id 0)
                    (tc_core.tc-inline-aggregate-layout-field-offset-id
                      (lower-global-shared-view aggregate)
                      row.name-id)
                    (tc_core.tc-inline-aggregate-layout-variant-payload-offset-id
                      (lower-global-shared-view aggregate)
                      variant-id
                      row.name-id))))
              (set! member (+ member 1))))]
        [(tc_core.ResultTcInlineAggregateLayout.Err _) unit]))))

(define (lower-compiler-program-checked-with-names-mode
  [lower-state : CompilerLowerState]
  [ctx : tc_core.TcContext]
  [top-env : tc_core.TcTypeEnv]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [entry-path : String]
  [names : LowerNameEnv]
  [clone-roots : clone_support.CloneRootEntries]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (match (compiler-lower-state-read
    lower-state
    pointer_proof.PointerProofRequest
    pointer-proof-request)
    [(Disabled) unit]
    [(Requested input)
      (let
        [error : String (pointer_proof.pointer-proof-input-begin-error input)]
        (when
          (> (string.string-length (& error)) 0)
          (return (Err (box (lower-diagnostic error)))))
        (pointer_proof.pointer-proof-input-use-default-path!
          input
          (if (> (string.string-length (& entry-path)) 0)
            (lower-global-shared-view entry-path)
            "<source>")))])
  ;; Clone-root discovery and checked typechecking can probe aggregate layout
  ;; with helper contexts before final lowering. Emitted code must use one
  ;; internally consistent layout view for all functions in this pass.
  (tc_core.tc-agg-caches-reset-for-job! (tc_core.tc-context-job-state ctx))
  (tc_core.tc-nominal-owner-cache-reset-for-job!
    (tc_core.tc-context-job-state ctx))
  (match program
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (deref decls-box)]
        (match (lower-decls
          lower-state
          ctx
          top-env
          decls
          paths
          entry-path
          (ir.compiler-ir-global-seq-empty)
          (ir.compiler-ir-function-seq-empty)
          (ir.compiler-ir-extern-seq-empty)
          (ir.compiler-source-spans-empty)
          names
          clone-roots
          mode)
          [(Ok payload)
            (let
              [success : LowerDeclsSuccess (deref payload)]
              [program : ir.CompilerIrProgram
                (Program success.globals success.functions success.externs)]
              ;; Returning the public IR is the explicit text boundary:
              ;; diagnostics, optimizers, and backend emitters may inspect
              ;; symbol spellings, while construction above uses handles.
              (lower-materialize-generated-role-symbols! lower-state)
              (let
                [debug-error : String (lower-debug-types-error lower-state)]
                (when
                  (> (string.string-length (& debug-error)) 0)
                  (return
                    (ResultCompilerLower.Err
                      (box (lower-diagnostic debug-error))))))
              (match (compiler-lower-state-read
                lower-state
                pointer_proof.PointerProofRequest
                pointer-proof-request)
                [(Disabled) unit]
                [(Requested input)
                  (pointer_proof.pointer-proof-input-bind!
                    input
                    (lower-global-shared-view program)
                    (lower-global-shared-view success.spans))])
              (Ok program success.spans))]
          [(Err message)
            (match (compiler-lower-state-read
              lower-state
              pointer_proof.PointerProofRequest
              pointer-proof-request)
              [(Requested input)
                (pointer_proof.pointer-proof-input-fail!
                  input
                  "pointer proof: requested lowering did not complete")]
              [_ unit])
            (Err message)]))]))

;; Internal `expanded` workers assume macro expansion has already run; the
;; public `-mode` wrappers below own the expand -> specialize -> typecheck
;; boundary so every lowering path (scalar and SPMD) expands exactly once.
(define (lower-compiler-expanded-program-unlocated-mode
  [lower-state : CompilerLowerState]
  [program : ast.AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (let
    [specialized (try (spec.compiler-specialize-program program))]
    [paths : ast.AstDeclPathList (ast.ast-decl-path-list-new)]
    [pools : ast.AstNodePoolContext (ast.ast-node-pool-context-capture-active)]
    [keep-plan : LowerDeclKeepPlan
      (match (lower-global-shared-view specialized)
        [(Program decls-box)
          (let
            [decls : ast.AstDeclList (deref decls-box)]
            (lower-decl-keep-plan-all (ast.ast-decl-list-len (& decls))))])]
    [alias-names : LowerNameEnv
      (match (lower-global-shared-view specialized)
        [(Program decls-box)
          (lower-name-env-with-import-aliases
            lower-state
            (deref decls-box)
            (lower-global-shared-view paths)
            "<source>"
            Nil
            false)])]
    (tc_core.tc-clone-root-collection-use!
      (tc_core.tc-serial-job-state)
      (lower-global-shared-view specialized))
    (lower-typecheck-clone-and-lower
      lower-state
      "<source>"
      specialized
      paths
      keep-plan
      alias-names
      true
      mode
      (svec.new)
      (tc_core.tc-prefix-default-cache-scope)
      pools)))

(define (lower-compiler-program-unlocated-mode
  [lower-state : CompilerLowerState]
  [program : ast.AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  ;; A standalone source entry constructs its compatibility state before
  ;; resetting and parsing the next source. Rebind to the active post-parse
  ;; interner so structural name keys use the same owner as typechecking.
  (compiler-lower-state-use-intern-state!
    lower-state
    (ci.intern-compat-state-capture-active))
  (tc_core.tc-agg-caches-reset!)
  ;; Generate declaration families before macro expansion (see
  ;; typecheck-compiler-program-with-paths for why).
  (let
    [generated (try (spec.gen-normalize-program program))]
    (match (tc_core.macro-expand-program generated)
      [(Ok expanded _)
        (lower-compiler-expanded-program-unlocated-mode
          lower-state
          expanded
          mode)]
      [(Err diag) (Err diag)])))

(define (lower-compiler-program-with-path-mode-and-state
  [lower-state : CompilerLowerState]
  [path : String]
  [program : ast.AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (match (lower-compiler-program-unlocated-mode lower-state program mode)
    [(Ok ir spans) (Ok ir spans)]
    [(Err diag)
      (Err (box (lower-diagnostic-with-fallback-path (deref diag) path)))]))

(define (lower-compiler-program-with-path-mode
  [path : String]
  [program : ast.AstProgram]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-program-with-path-mode-and-state
    (compiler-lower-state-new)
    path
    program
    mode))

;; Check source declarations once, collect clone-helper roots as a side effect
;; of that real semantic walk, then append the generated helpers and extend the
;; checked context with only the appended function signatures. Generated clone
;; declarations have never been checked by tc-check-decls (they are trusted
;; compiler output), so building them before typecheck only forced a redundant
;; symbols/registries/top-env construction and a shadow expression typecheck.
(define (lower-typecheck-clone-and-lower-with-source-names-and-intern-state
  [lower-state : CompilerLowerState]
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [keep-plan : LowerDeclKeepPlan]
  [escaped-names : LowerNameEnv]
  [needs-specialization : bool]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state-input : ci.InternCompatState]) : ResultCompilerLower
  (let
    [intern-state : ci.InternCompatState intern-state-input]
    [typecheck-intern-state : ci.InternCompatState
      (ci.intern-global-shared-view intern-state)]
    [result : ResultCompilerLower
      (match (tc_core.typecheck-compiler-specialized-program-with-paths-checked-cache-with-pools-and-source-names-and-prefix-cache-state-and-intern-state
        load-state
        prefix-cache
        job-state
        (lower-global-shared-view program)
        (lower-global-shared-view paths)
        stdlib-roots
        cache-scope
        pools
        source-names
        typecheck-intern-state)
        [(Ok summary source-ctx source-top-env _)
          (let
            [clone-roots : clone_support.CloneRootEntries
              (tc_core.tc-clone-root-collection-finish! source-ctx)]
            [source-decl-count : i64
              (match (lower-global-shared-view program)
                [(Program decls-box)
                  (let
                    [decls : ast.AstDeclList (deref decls-box)]
                    (ast.ast-decl-list-len (& decls)))])]
            [_finish-package-surface : unit
              (cfg
                (any
                  compiler-surface-producer
                  compiler-build-identity
                  embedded-stdlib-tlci)
                (match summary
                  [(CompilerTypecheckSummary values functions externs)
                    (package_surface.package-surface-capture-finish!
                      source-decl-count
                      values
                      functions
                      externs)])
                unit)]
            [checked-keep-plan : LowerDeclKeepPlan
              (lower-decl-keep-plan-add-clone-roots
                keep-plan
                (lower-global-shared-view program)
                clone-roots)]
            [clone-able : clone_support.CloneNameSet
              (tc_core.tc-clone-able-set source-ctx)]
            [_install-clone-pools : unit
              (ast.ast-node-pool-context-install! pools)]
            [clone-augmentation : ResultLowerCloneAugment
              (lower-clone-handoff-augment
                lower-state
                source-ctx
                source-top-env
                (lower-global-shared-view entry-path)
                (lower-global-shared-view program)
                clone-able
                clone-roots
                pools)]
            [checked-program : ast.AstProgram
              (match (lower-global-shared-view clone-augmentation)
                [(Ok augmented _ _) augmented]
                [(Err _) program])]
            [all-clone-roots : clone_support.CloneRootEntries
              (match (lower-global-shared-view clone-augmentation)
                [(Ok _ _ handoff-roots) handoff-roots]
                [(Err _) clone-roots])]
            [_install-augmented-pools : unit
              (ast.ast-node-pool-context-install! pools)]
            [checked-context : ResultLowerCheckedContext
              (match clone-augmentation
                [(Ok _ _ _)
                  (lower-extend-checked-context-with-clone-decls
                    source-ctx
                    source-top-env
                    source-decl-count
                    (lower-global-shared-view checked-program))]
                [(Err message) (Err message)])]
            [lower-names : LowerNameEnv
              (match (lower-global-shared-view checked-program)
                [(Program decls-box)
                  (let
                    [decls : ast.AstDeclList (deref decls-box)]
                    [base-names : LowerNameEnv
                      (if needs-specialization
                        escaped-names
                        (lower-name-env-from-decls-with-state
                          lower-state
                          (lower-global-shared-view decls)
                          (lower-global-shared-view paths)
                          (lower-global-shared-view entry-path)
                          Nil))]
                    (lower-name-env-add-clone-decls
                      lower-state
                      decls
                      paths
                      (lower-global-shared-view entry-path)
                      base-names
                      all-clone-roots
                      needs-specialization))])]
            (begin
              (cfg
                compile-profile
                (compiler-lower-profile-finish lower-state "typecheck"))
              (cfg compile-profile (compiler-lower-profile-start lower-state))
              (match checked-context
                [(Ok ctx top-env)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-lower-profile-finish
                        lower-state
                        "clone_augment_names"))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-pools "typecheck" pools))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-pools "pre_decls" pools))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-program-counts
                        "pre_decls"
                        (lower-global-shared-view checked-program)))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-start lower-state))
                    ;; Whole-program source typecheck is complete. Apply the
                    ;; declaration decisions retained by reachability; clone
                    ;; helpers are appended and marked by add-clone-roots.
                    (let
                      [pruned-program : ast.AstProgram
                        (lower-decl-keep-plan-apply
                          checked-keep-plan
                          checked-program)]
                      (begin
                        (cfg
                          compile-profile
                          (compiler-lower-profile-finish
                            lower-state
                            "prune_apply"))
                        (cfg
                          compile-profile
                          (compiler-lower-profile-program-counts
                            "reachable"
                            (lower-global-shared-view pruned-program)))
                        (cfg
                          compile-profile
                          (compiler-lower-profile-start lower-state))
                        (cfg
                          compile-profile
                          (compiler-lower-profile-string-concat-reset
                            lower-state))
                        (match (lower-compiler-program-checked-with-names-mode
                          lower-state
                          ctx
                          ;; Additive macro splices intentionally retain a
                          ;; shallow forest of delta layers. Lowering performs
                          ;; repeated whole-program lookups after the final
                          ;; splice, so publish one flat front cache at this
                          ;; phase boundary instead of paying the layer walk in
                          ;; every lowered function.
                          (tc_core.tc-env-with-cache top-env)
                          pruned-program
                          (lower-decl-keep-plan-apply-paths
                            checked-keep-plan
                            paths)
                          (lower-global-shared-view entry-path)
                          lower-names
                          clone-roots
                          mode)
                          [(Ok ir spans)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-lower-profile-string-concat-finish
                                  lower-state))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-name-finish lower-state))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-finish
                                  lower-state
                                  "decls"))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-ir-shape
                                  "after_decls"
                                  (lower-global-shared-view ir)))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-ir-arena "after_decls"))
                              (Ok ir spans))]
                          [(Err diag)
                            (begin
                              (cfg
                                compile-profile
                                (compiler-lower-profile-string-concat-finish
                                  lower-state))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-name-finish lower-state))
                              (cfg
                                compile-profile
                                (compiler-lower-profile-finish
                                  lower-state
                                  "decls"))
                              (Err
                                (box
                                  (lower-diagnostic-with-fallback-path
                                    (deref diag)
                                    entry-path))))]))))]
                [(Err message)
                  (begin
                    (cfg
                      compile-profile
                      (compiler-lower-profile-finish
                        lower-state
                        "clone_augment_names"))
                    (Err (box (lower-diagnostic message))))])))]
        [(Partial diag _ _ _)
          (begin
            (tc_core.tc-clone-root-collection-abort! job-state)
            (cfg
              (any
                compiler-surface-producer
                compiler-build-identity
                embedded-stdlib-tlci)
              (package_surface.package-surface-capture-abort!
                "package surface: checked compilation was partial")
              unit)
            (cfg
              compile-profile
              (compiler-lower-profile-finish lower-state "typecheck"))
            (Err (box (cdiag.compiler-diagnostic-list-first (deref diag)))))]
        [(Err diag)
          (begin
            (tc_core.tc-clone-root-collection-abort! job-state)
            (cfg
              (any
                compiler-surface-producer
                compiler-build-identity
                embedded-stdlib-tlci)
              (package_surface.package-surface-capture-abort!
                "package surface: checked compilation failed")
              unit)
            (cfg
              compile-profile
              (compiler-lower-profile-finish lower-state "typecheck"))
            (Err (box (cdiag.compiler-diagnostic-list-first (deref diag)))))])]
    (ast.ast-node-pool-context-capture-active! pools)
    (ci.intern-compat-state-capture-from-globals! (&mut intern-state))
    result))

;; Serial/test compatibility adapter.  Production lower jobs pass the
;; compile-owned intern state through the explicit entry above.
(define (lower-typecheck-clone-and-lower-with-source-names
  [lower-state : CompilerLowerState]
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [keep-plan : LowerDeclKeepPlan]
  [escaped-names : LowerNameEnv]
  [needs-specialization : bool]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (lower-typecheck-clone-and-lower-with-source-names-and-intern-state
    lower-state
    load-state
    prefix-cache
    job-state
    entry-path
    program
    paths
    keep-plan
    escaped-names
    needs-specialization
    mode
    stdlib-roots
    cache-scope
    pools
    source-names
    (ci.intern-compat-state-capture-active)))

(define (lower-typecheck-clone-and-lower
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [keep-plan : LowerDeclKeepPlan]
  [escaped-names : LowerNameEnv]
  [needs-specialization : bool]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]) : ResultCompilerLower
  (lower-typecheck-clone-and-lower-with-source-names
    lower-state
    (load.compiler-load-serial-test-session-state)
    (tc_core.tc-prefix-snapshot-serial-test-cache-state-shared-view)
    (tc_core.tc-serial-job-state)
    entry-path
    program
    paths
    keep-plan
    escaped-names
    needs-specialization
    mode
    stdlib-roots
    cache-scope
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache-active-and-pools-and-source-names-and-intern-state
  [lower-state : CompilerLowerState]
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state-input : ci.InternCompatState]) : ResultCompilerLower
  (begin
    (cfg
      (any
        compiler-surface-producer
        compiler-build-identity
        embedded-stdlib-tlci)
      (package_surface.package-surface-capture-expanded!
        (cis.intern-structural-session-handle-from-source-names source-names)
        (lower-global-shared-view program)
        (lower-global-shared-view paths)
        pools)
      unit)
    (cfg
      (any compile-profile test)
      (compiler-lower-profile-reset! lower-state)
      unit)
    (cfg compile-profile (compiler-lower-profile-name-reset lower-state))
    (cfg
      (any compile-profile test)
      (spec.spec-profile-reset! (compiler-lower-state-profile lower-state))
      unit)
    (cfg compile-profile (compiler-lower-profile-start lower-state))
    (let
      [intern-state : ci.InternCompatState intern-state-input]
      [needs-specialization : bool
        (spec.compiler-specialize-needed-with-pools
          (lower-global-shared-view program)
          pools)]
      [names : LowerNameEnv
        (match (lower-global-shared-view program)
          [(Program decls-box)
            (let
              [decls : ast.AstDeclList (deref decls-box)]
              (lower-name-env-from-decls-with-state
                lower-state
                decls
                (lower-global-shared-view paths)
                (lower-global-shared-view entry-path)
                Nil))])]
      [specialized-result : spec.ResultSpecProgramWithPaths
        (begin
          ;; Lower-name construction is a legacy ambient phase; publish its
          ;; scalar interner changes before explicit specialization begins.
          (ci.intern-compat-state-capture-from-globals! (&mut intern-state))
          (if needs-specialization
            (cfg
              (any compile-profile test)
              (spec.compiler-specialize-program-with-paths-and-pools-and-intern-state-and-profile-state
                program
                paths
                (lower-global-shared-view entry-path)
                pools
                (lower-global-shared-view intern-state)
                (compiler-lower-state-profile lower-state))
              (spec.compiler-specialize-program-with-paths-and-pools-and-intern-state
                program
                paths
                (lower-global-shared-view entry-path)
                pools
                (lower-global-shared-view intern-state)))
            (Ok program paths)))]
      ;; Explicit specialization mutates owner pool/interner cells; publish
      ;; them before matching either result or entering legacy lowering.
      (ast.ast-node-pool-context-install! pools)
      (ci.intern-compat-state-install! intern-state)
      (match specialized-result
        [(Ok specialized specialized-paths)
          (begin
            (cfg
              compile-profile
              (compiler-lower-profile-finish lower-state "specialize"))
            (cfg
              compile-profile
              (compiler-lower-profile-specialization-counters
                (compiler-lower-state-profile lower-state)))
            (cfg compile-profile (compiler-lower-profile-start lower-state))
            (let
              ;; The environment over the specialized declarations serves
              ;; the reachability walk only: lowering keeps `names`, in which
              ;; specialized instances stay private symbols. Its store grows
              ;; in its owner arena, so give it one of its own and retire it
              ;; as soon as the walk returns instead of carrying it to the
              ;; end of lowering (#7882).
              [prune-names-arena : i64
                (if needs-specialization
                  (arena.tl_arena_make)
                  0)]
              [prune-names : LowerNameEnv
                (if needs-specialization
                  (let
                    [enclosing : i64 (arena.tl_arena_current)]
                    [_enter : unit
                      (unsafe
                        (arena.tl_arena_set prune-names-arena))]
                    [built : LowerNameEnv
                      (match (lower-global-shared-view specialized)
                        [(Program decls-box)
                          (let
                            [decls : ast.AstDeclList (deref decls-box)]
                            (lower-name-env-from-decls-with-state
                              lower-state
                              decls
                              (lower-global-shared-view specialized-paths)
                              (lower-global-shared-view entry-path)
                              Nil))])]
                    [_leave : unit
                      (unsafe
                        (arena.tl_arena_set enclosing))]
                    built)
                  (owned_view.compiler-owned-shared-view names))]
              ;; Typecheck remains complete and whole-program while lower,
              ;; optimize, and codegen are gated on reachability. This up-front
              ;; walk records the dense declaration selection consumed both by
              ;; typecheck's clone-root observer and by the final linear prune.
              (match (lower-prune-unreachable-functions-with-clone-roots-and-plan
                lower-state
                pools
                (lower-global-shared-view entry-path)
                (lower-global-shared-view specialized)
                (lower-global-shared-view specialized-paths)
                prune-names
                (Empty))
                [(Program reach-program _reach-paths reach-keep-plan)
                  (begin
                    (if (= prune-names-arena 0)
                      unit
                      (unsafe
                        (arena.tl_arena_destroy prune-names-arena)))
                    ;; The lowering metric slots are a fixed range shared with
                    ;; the interner's, so this one fact is reported directly.
                    (cfg
                      compile-profile
                      (compiler-lower-profile-counter
                        "name_env.prune_arena_releases"
                        (if (= prune-names-arena 0)
                          0
                          1)))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-finish lower-state "prune"))
                    (cfg
                      compile-profile
                      (compiler-lower-profile-start lower-state))
                    ;; Capture stable retained declaration keys before optional
                    ;; pool compaction releases the reach-program AST.
                    (tc_core.tc-clone-root-collection-use!
                      job-state
                      reach-program)
                    (let
                      [detach-source? : bool
                        (compiler-lower-checked-dest-pools-active? lower-state)]
                      [source-compaction : ast.AstProgramCompaction
                        (if detach-source?
                          (ast.ast-program-compact-with-pools
                            pools
                            (compiler-lower-checked-dest-pools-current
                              lower-state)
                            specialized)
                          (AstProgramCompaction specialized pools))]
                      [source-program : ast.AstProgram
                        (match (lower-global-shared-view source-compaction)
                          [(AstProgramCompaction out _) out])]
                      [source-pools : ast.AstNodePoolContext
                        (match source-compaction
                          [(AstProgramCompaction _ out-pools) out-pools])]
                      [source-entry-path : String
                        (if detach-source?
                          (lower-copy-string-into-pools entry-path source-pools)
                          entry-path)]
                      [source-cache-scope : String
                        (if detach-source?
                          (lower-copy-string-into-pools
                            cache-scope
                            source-pools)
                          cache-scope)]
                      [source-paths : ast.AstDeclPathList
                        (if detach-source?
                          (lower-copy-paths-into-pools
                            specialized-paths
                            source-pools)
                          specialized-paths)]
                      [source-keep-plan : LowerDeclKeepPlan
                        (if detach-source?
                          (lower-decl-keep-plan-copy-into-pools
                            reach-keep-plan
                            source-pools)
                          reach-keep-plan)]
                      [escaped-names : LowerNameEnv
                        (if (and detach-source? needs-specialization)
                          (lower-name-env-copy-into-pools-owned
                            lower-state
                            names
                            source-pools)
                          names)]
                      [_clear-source-derived-caches : unit
                        (if detach-source?
                          (lower-clear-macro-expanded-source-caches-into-pools!
                            job-state
                            source-pools)
                          unit)]
                      [_commit-dest : unit
                        (lower-checked-dest-pools-commit!
                          lower-state
                          source-pools)]
                      [_capture-before-typecheck : unit
                        (ci.intern-compat-state-capture-from-globals!
                          (&mut intern-state))]
                      (lower-typecheck-clone-and-lower-with-source-names-and-intern-state
                        lower-state
                        load-state
                        prefix-cache
                        job-state
                        source-entry-path
                        source-program
                        source-paths
                        source-keep-plan
                        escaped-names
                        needs-specialization
                        mode
                        stdlib-roots
                        source-cache-scope
                        source-pools
                        source-names
                        intern-state)))])))]
        [(Err diag)
          (begin
            (cfg
              (any
                compiler-surface-producer
                compiler-build-identity
                embedded-stdlib-tlci)
              (package_surface.package-surface-capture-abort!
                "package surface: specialization failed")
              unit)
            (cfg
              compile-profile
              (compiler-lower-profile-finish lower-state "specialize"))
            (cfg
              compile-profile
              (compiler-lower-profile-specialization-counters
                (compiler-lower-state-profile lower-state)))
            (Err
              (box
                (lower-diagnostic-with-fallback-path (deref diag) entry-path))))]))))

(define (lower-compiler-expanded-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-intern-state
  [lower-state : CompilerLowerState]
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state : ci.InternCompatState]) : ResultCompilerLower
  (let
    [prev-active : bool (lower-entry-main-module-active-current lower-state)]
    [prev-module : String (lower-entry-main-module-current lower-state)]
    [prev-module-id : i64 (lower-entry-main-module-id-current lower-state)]
    [selection : LowerMaybeEntryMainModule
      (lower-entry-main-selection-for-program
        lower-state
        (lower-global-shared-view entry-path)
        (lower-global-shared-view program)
        (lower-global-shared-view paths))]
    (lower-entry-main-selection-install! lower-state selection)
    (let
      [result : ResultCompilerLower
        (lower-compiler-expanded-program-with-decl-paths-mode-cache-active-and-pools-and-source-names-and-intern-state
          lower-state
          load-state
          prefix-cache
          job-state
          entry-path
          program
          paths
          mode
          stdlib-roots
          cache-scope
          pools
          source-names
          intern-state)]
      (lower-entry-main-selection-restore!
        lower-state
        prev-active
        prev-module
        prev-module-id)
      result)))

(define (lower-compiler-program-with-decl-paths-mode-cache-and-state
  [lower-state : CompilerLowerState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [cache-scope : String]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state-and-intern-state
    lower-state
    (load.compiler-load-serial-test-session-state)
    (tc_core.tc-prefix-snapshot-serial-test-cache-state-shared-view)
    (tc_core.tc-serial-job-state)
    entry-path
    program
    paths
    mode
    stdlib-roots
    cfgs
    cache-scope
    (ast.ast-node-pool-context-capture-active)
    (ci.intern-source-name-session-capture-active-handle)
    (ci.intern-compat-state-capture-active)
    (cbi.state-capture)))

(define (lower-compiler-program-with-decl-paths-mode-cache
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [cache-scope : String]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-state
    (compiler-lower-state-new)
    entry-path
    program
    paths
    mode
    stdlib-roots
    cfgs
    cache-scope))

(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state-and-intern-state
  [lower-state : CompilerLowerState]
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]
  [intern-state-input : ci.InternCompatState]
  [builtin-state : cbi.CompilerBuiltinIdsState]) : ResultCompilerLower
  (let
    [intern-state : ci.InternCompatState intern-state-input]
    (begin
      (compiler-lower-state-use-intern-state-and-source-names!
        lower-state
        (ci.intern-global-shared-view intern-state)
        source-names)
      (lower-comptime-error-ids-ensure! lower-state builtin-state)
      (cfg
        (any compile-profile test)
        (compiler-lower-profile-reset! lower-state)
        unit)
      (cfg compile-profile (compiler-lower-profile-start lower-state))
      (tc_core.tc-agg-caches-reset-for-job! job-state)
      ;; Generate declaration families before macro expansion (see
      ;; typecheck-compiler-program-with-paths for why).
      (let
        [generation-owner : spec.SpecOwnerContext
          (cfg
            (any compile-profile test)
            (spec.spec-owner-context-new-with-profile-state
              pools
              (ci.intern-global-shared-view intern-state)
              (compiler-lower-state-profile lower-state))
            (spec.spec-owner-context-new pools intern-state))]
        [generated-result : spec.ResultGenProgramWithPaths
          (spec.gen-normalize-program-with-paths-and-pools-and-intern-state
            program
            paths
            (lower-global-shared-view entry-path)
            generation-owner)]
        ;; Publish explicit generation mutations before matching either result
        ;; or entering the legacy macro-expansion phase.
        (ast.ast-node-pool-context-install! pools)
        (ci.intern-compat-state-install! intern-state)
        (match generated-result
          [(Ok generated generated-paths)
            (let
              [detach-before-macro? : bool
                (compiler-lower-checked-dest-pools-active? lower-state)]
              [generated-compaction : ast.AstProgramCompaction
                (if detach-before-macro?
                  (ast.ast-program-compact-with-pools
                    pools
                    (compiler-lower-checked-dest-pools-current lower-state)
                    generated)
                  (AstProgramCompaction generated pools))]
              [macro-program : ast.AstProgram
                (match (lower-global-shared-view generated-compaction)
                  [(AstProgramCompaction out _) out])]
              [macro-pools : ast.AstNodePoolContext
                (match generated-compaction
                  [(AstProgramCompaction _ out-pools) out-pools])]
              [macro-entry-path : String
                (if detach-before-macro?
                  (lower-copy-string-into-pools entry-path macro-pools)
                  entry-path)]
              [macro-cache-scope : String
                (if detach-before-macro?
                  (lower-copy-string-into-pools cache-scope macro-pools)
                  cache-scope)]
              [macro-paths : ast.AstDeclPathList
                (if detach-before-macro?
                  (lower-copy-paths-into-pools generated-paths macro-pools)
                  generated-paths)]
              [_clear-source-derived-caches : unit
                (when
                  detach-before-macro?
                  (lower-clear-macro-expanded-source-caches-into-pools!
                    job-state
                    macro-pools)
                  (load.compiler-load-session-state-program-cache-clear!
                    (lower-global-shared-view load-state))
                  (load.compiler-load-session-state-runtime-prelude-cache-clear!
                    (lower-global-shared-view load-state))
                  (tc_core.tc-prefix-snapshot-cache-clear-for-state!
                    prefix-cache))]
              [_commit-generated-pools : unit
                (if detach-before-macro?
                  (lower-checked-dest-pools-commit! lower-state macro-pools)
                  unit)]
              [committed-macro-pools : ast.AstNodePoolContext
                (if detach-before-macro?
                  (compiler-lower-checked-dest-pools-current lower-state)
                  macro-pools)]
              [_arm-post-macro-detach : unit
                (if detach-before-macro?
                  (lower-checked-dest-pools-rollover-for-macro! lower-state)
                  unit)]
              [_macro-handoff-profile-finish : unit
                (cfg
                  compile-profile
                  (compiler-lower-profile-finish lower-state "macro_handoff"))]
              (begin
                (cfg
                  (any compile-profile test)
                  (compiler-lower-profile-reset! lower-state)
                  unit)
                (cfg compile-profile (compiler-lower-profile-start lower-state))
                (let
                  [macro-intern-state : ci.InternCompatState
                    (ci.intern-global-shared-view intern-state)]
                  [macro-result : tc_core.ResultMacroExpand
                    (tc_core.macro-expand-program-with-paths-and-pools-roots-cfg-and-source-names-and-job-state-and-intern-state
                      (lower-global-shared-view load-state)
                      (lower-global-shared-view macro-program)
                      (lower-global-shared-view macro-paths)
                      committed-macro-pools
                      source-names
                      job-state
                      (lower-global-shared-view stdlib-roots)
                      cfgs
                      macro-intern-state)]
                  (ci.intern-compat-state-capture-from-globals!
                    (&mut intern-state))
                  (match macro-result
                    [(Ok expanded expanded-paths)
                      (begin
                        (cfg
                          compile-profile
                          (compiler-lower-profile-finish
                            lower-state
                            "macro_expand"))
                        (cfg
                          compile-profile
                          (compiler-lower-profile-pools
                            "macro_expand"
                            committed-macro-pools))
                        (let
                          [checked-detach? : bool
                            (compiler-lower-checked-dest-pools-active?
                              lower-state)]
                          [macro-changed? : bool
                            (tc_core.macro-expand-program-structurally-changed?
                              (tc_core.tc-job-state-macro-state job-state))]
                          [retain-macro-source? : bool
                            (and checked-detach? (not macro-changed?))]
                          [detach-load-pools? : bool
                            (and checked-detach? macro-changed?)]
                          [_detach-profile-decision : unit
                            (cfg
                              compile-profile
                              (begin
                                (compiler-lower-profile-counter
                                  "macro_detach.fast_path_hits"
                                  (if retain-macro-source?
                                    1
                                    0))
                                (compiler-lower-profile-counter
                                  "macro_detach.fast_path_misses"
                                  (if detach-load-pools?
                                    1
                                    0))
                                (compiler-lower-profile-counter
                                  "macro_detach.change_reasons"
                                  (tc_core.macro-expand-program-structural-change-reasons-value))))]
                          [_finalize-profile-start : unit
                            (if checked-detach?
                              (cfg
                                compile-profile
                                (compiler-lower-profile-start lower-state))
                              unit)]
                          [detached-compaction : ast.AstProgramCompaction
                            (if detach-load-pools?
                              (ast.ast-program-compact-with-pools
                                committed-macro-pools
                                (compiler-lower-checked-dest-pools-current
                                  lower-state)
                                expanded)
                              (AstProgramCompaction
                                (if retain-macro-source?
                                  macro-program
                                  expanded)
                                committed-macro-pools))]
                          [detached-program : ast.AstProgram
                            (match (lower-global-shared-view
                              detached-compaction)
                              [(AstProgramCompaction out _) out])]
                          [detached-pools : ast.AstNodePoolContext
                            (match detached-compaction
                              [(AstProgramCompaction _ out-pools) out-pools])]
                          [detached-entry-path : String
                            (if detach-load-pools?
                              (lower-copy-string-into-pools
                                macro-entry-path
                                detached-pools)
                              macro-entry-path)]
                          [detached-cache-scope : String
                            (if detach-load-pools?
                              (lower-copy-string-into-pools
                                macro-cache-scope
                                detached-pools)
                              macro-cache-scope)]
                          [detached-paths : ast.AstDeclPathList
                            (if detach-load-pools?
                              (lower-copy-paths-into-pools
                                expanded-paths
                                detached-pools)
                              (if retain-macro-source?
                                macro-paths
                                expanded-paths))]
                          [_clear-source-derived-caches : unit
                            (if checked-detach?
                              (lower-clear-macro-expanded-source-caches-into-pools!
                                job-state
                                detached-pools)
                              unit)]
                          [_commit-detached-pools : unit
                            (cond
                              [detach-load-pools?
                                (lower-checked-dest-pools-commit!
                                  lower-state
                                  detached-pools)]
                              [retain-macro-source?
                                (lower-checked-dest-pools-retain-macro-source!
                                  lower-state
                                  detached-pools)]
                              [else unit])]
                          [committed-pools : ast.AstNodePoolContext
                            (if checked-detach?
                              (compiler-lower-checked-dest-pools-current
                                lower-state)
                              detached-pools)]
                          [_disable-late-detach : unit
                            (if checked-detach?
                              (lower-checked-dest-pools-deactivate-after-commit!
                                lower-state)
                              unit)]
                          [_finalize-profile-finish : unit
                            (if checked-detach?
                              (cfg
                                compile-profile
                                (compiler-lower-profile-finish
                                  lower-state
                                  "macro_finalize"))
                              unit)]
                          (lower-compiler-expanded-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-intern-state
                            lower-state
                            load-state
                            prefix-cache
                            job-state
                            detached-entry-path
                            detached-program
                            detached-paths
                            mode
                            stdlib-roots
                            detached-cache-scope
                            committed-pools
                            source-names
                            intern-state)))]
                    [(Err diag)
                      (begin
                        (cfg
                          compile-profile
                          (compiler-lower-profile-finish
                            lower-state
                            "macro_expand"))
                        (Err
                          (box
                            (cdiag.compiler-diagnostic-copy
                              (lower-diagnostic-with-fallback-path
                                (deref diag)
                                macro-entry-path)))))]))))]
          [(Err diag)
            (begin
              (cfg
                compile-profile
                (compiler-lower-profile-finish lower-state "macro_handoff"))
              (Err
                (box
                  (lower-diagnostic-with-fallback-path (deref diag) entry-path))))])))))

;; Serial/test compatibility adapter for callers that already provide the
;; explicit loader/prefix/job state but still rely on the active interner.
(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state
  [load-state : load.CompilerLoadSessionState]
  [prefix-cache : tc_core.TcPrefixSnapshotCacheState]
  [job-state : tc_core.TcJobState]
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state-and-intern-state
    (compiler-lower-state-new)
    load-state
    prefix-cache
    job-state
    entry-path
    program
    paths
    mode
    stdlib-roots
    cfgs
    cache-scope
    pools
    source-names
    (ci.intern-compat-state-capture-active)
    (cbi.state-capture)))

;; Serial/test compatibility adapter. Driver-owned compilation uses the
;; explicit load-state entry above.
(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]
  [source-names : ci.InternSourceNameSessionHandle]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names-and-load-state
    (load.compiler-load-serial-test-session-state)
    (tc_core.tc-prefix-snapshot-serial-test-cache-state-shared-view)
    (tc_core.tc-serial-job-state)
    entry-path
    program
    paths
    mode
    stdlib-roots
    cfgs
    cache-scope
    pools
    source-names))

(define (lower-compiler-program-with-decl-paths-mode-cache-and-pools
  [entry-path : String]
  [program : ast.AstProgram]
  [paths : ast.AstDeclPathList]
  [mode : CompilerLowerMode]
  [stdlib-roots : svec.Vec]
  [cfgs : sym_i64_env.SymI64Env]
  [cache-scope : String]
  [pools : ast.AstNodePoolContext]) : ResultCompilerLower
  (lower-compiler-program-with-decl-paths-mode-cache-and-pools-and-source-names
    entry-path
    program
    paths
    mode
    stdlib-roots
    cfgs
    cache-scope
    pools
    (ci.intern-source-name-session-capture-active-handle)))

(define (lower-compiler-source [src : String]) : ResultCompilerLower
  (lower-compiler-source-with-path "<source>" src))

(define (lower-compiler-source-with-mode
  [src : String]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-source-with-path-mode "<source>" src mode))

(define (lower-source-decls-define-module?
  [decls : ast.AstDeclList]
  [module : String]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (match decl
        [(Module name)
          (if (string.eq (tc_core.tc-env-key-name-text name) module)
            true
            (lower-source-decls-define-module? rest module))]
        [_ (lower-source-decls-define-module? rest module)])]))

(define (lower-source-language-cfgs) : sym_i64_env.SymI64Env
  (cbi.compiler-builtin-initialize-for-parse!)
  (cfg_core.compiler-cfg-empty))

(define (lower-source-load [src : String]) : load.ResultCompilerLoadWithPaths
  (let
    [stdlib-roots : svec.Vec (svec.new)]
    [cfgs : sym_i64_env.SymI64Env (lower-source-language-cfgs)]
    (match (load.compiler-load-core-macro-prelude-with-roots-cfg
      (sym_i64_env.sym-i64-empty)
      (lower-global-shared-view stdlib-roots)
      cfgs)
      [(Ok prelude-decls prelude-paths prelude-modules prelude-seen)
        (match (load.compiler-load-source-with-paths-and-roots-cfg
          ""
          src
          prelude-seen
          stdlib-roots
          cfgs)
          [(Ok entry-decls entry-paths entry-modules seen)
            (Ok
              (load.compiler-load-decl-list-append prelude-decls entry-decls)
              (load.compiler-load-decl-path-list-append
                prelude-paths
                entry-paths)
              (load.compiler-load-decl-module-list-append
                prelude-modules
                entry-modules)
              seen)]
          [(Err diagnostic) (Err diagnostic)])]
      [(Err diagnostic) (Err diagnostic)])))

(define (lower-source-stdlib-import-kind?
  [kind : ast.AstImportKind]
  [path : String]) : bool
  (match kind
    [(Module)
      (load.compiler-load-stdlib-import?
        (load.compiler-load-dotted-module-path path))]
    [_ false]))

(define (lower-source-stdlib-import-needs-loader?
  [all-decls : ast.AstDeclList]
  [kind : ast.AstImportKind]
  [path : String]) : bool
  (if (lower-source-stdlib-import-kind? kind (lower-global-shared-view path))
    (match kind
      [(Module) (not (lower-source-decls-define-module? all-decls path))]
      [_ true])
    false))

(define (lower-source-call-head-import?
  [pools : (& pools ast.AstNodePoolContext)]
  [func-box : i64]) : bool
  (match (ast.ast-expr-unspan-with-pools
    pools
    (ast.ast-node-pool-context-expr-get pools func-box))
    [(Var name) (= name cbi.compiler-builtin-id-fix-import)]
    [_ false]))

(define (lower-source-node-has-import-call?
  [pools : (& pools ast.AstNodePoolContext)]
  [id : i64]) : bool
  ;; The arms below check call heads, keep this scan's own operands for
  ;; TupleRef (its index read as a node) and SpmdScan, and skip the forms it
  ;; does not descend into; every other variant asks its expression children
  ;; through the AstExpr child list.
  (match (ast.ast-node-pool-context-expr-get pools id)
    [(Call func-box args)
      (or
        (lower-source-call-head-import? pools func-box)
        (lower-source-node-has-import-call? pools func-box)
        (ast.ast-expr-list-fold
          args
          ast.ast-fold-or
          false
          lower-source-node-has-import-call?
          pools))]
    [(TupleRef tuple-box index-box)
      (or
        (lower-source-node-has-import-call? pools tuple-box)
        (lower-source-node-has-import-call? pools index-box))]
    [(SpmdScan scan-box)
      (match (__tl-box-place scan-box)
        [(Scan _ _ _ start-box end-box init-box _ value-box body-box _)
          (or
            (lower-source-node-has-import-call? pools start-box)
            (lower-source-node-has-import-call? pools end-box)
            (lower-source-node-has-import-call? pools init-box)
            (lower-source-node-has-import-call? pools value-box)
            (lower-source-node-has-import-call? pools body-box))])]
    [(ArrayTake _ _ _) false]
    [(Replace _ _) false]
    [(PtrAddrOf _) false]
    [(ForOwnedState _) false]
    [(ForOwnedStep _) false]
    [(MacroExpansion _ _ _) false]
    [_
      (ast.ast-expr-list-fold
        (ast.ast-expr-child-ids (ast.ast-node-pool-context-expr-get pools id))
        ast.ast-fold-or
        false
        lower-source-node-has-import-call?
        pools)]))

(define (lower-source-decl-needs-loader?
  [pools : (& pools ast.AstNodePoolContext)]
  [decl : ast.AstDecl]
  [all-decls : ast.AstDeclList]) : bool
  (match decl
    [(Import decl-meta (Spec kind path _ _ _))
      (lower-source-stdlib-import-needs-loader? all-decls kind path)]
    [(DefMacro decl-meta _ _ ret body-box)
      (and
        (tc_core.tc-macro-result-decl-emitting? ret)
        (lower-source-node-has-import-call? pools body-box))]
    [(Unsafe inner-box)
      (lower-source-decl-needs-loader? pools (deref inner-box) all-decls)]
    [_ false]))

(define (lower-source-decls-need-loader?
  [pools : ast.AstNodePoolContext]
  [decls : ast.AstDeclList]
  [all-decls : ast.AstDeclList]) : bool
  (match (ast.ast-decl-list-step decls)
    [(Nil) false]
    [(Cons decl rest)
      (or
        (lower-source-decl-needs-loader?
          pools
          decl
          (lower-global-shared-view all-decls))
        (lower-source-decls-need-loader? pools rest all-decls))]))

(define (lower-source-program-needs-loader? [program : ast.AstProgram]) : bool
  (match program
    [(Program decls-box)
      (let
        [decls : ast.AstDeclList (deref decls-box)]
        [pools : ast.AstNodePoolContext
          (ast.ast-node-pool-context-capture-active)]
        (lower-source-decls-need-loader?
          pools
          (lower-global-shared-view decls)
          decls))]))

(define (lower-compiler-source-with-path-mode-package-and-state
  [lower-state : CompilerLowerState]
  [path : String]
  [src : String]
  [mode : CompilerLowerMode]
  [package-name : String]) : ResultCompilerLower
  (when
    (lower-resetting-entry-in-live-session?)
    (return
      (lower-resetting-entry-live-session-error
        "lower-compiler-source-with-path-mode"
        path)))
  ;; Each standalone single-source compile (smoke self-tests, emit-source,
  ;; check tools) runs in a fresh arena, so interned name strings from a
  ;; previous compile are freed. Reset the persistent intern table here so a
  ;; later compile never probes a dangling key. The multi-file driver compiles
  ;; through the loader, not this entry, so cli.tl's fixpoint is unaffected.
  (lower-reset-file-state!)
  (compiler-lower-state-reset! lower-state)
  (compiler-lower-state-set-spmd-package! lower-state package-name)
  (tc_core.compiler-typecheck-reset-file-state!)
  (ci.intern-reset!)
  (lower-reset-intern-owned-state!)
  (cbi.compiler-builtin-reset!)
  (match (parser.parse-ast-source (lower-global-shared-view src))
    [(Ok program)
      (if (lower-source-program-needs-loader?
        (lower-global-shared-view program))
        (let
          [stdlib-roots : svec.Vec (svec.new)]
          [cfgs : sym_i64_env.SymI64Env (lower-source-language-cfgs)]
          (match (lower-source-load src)
            [(Ok decls paths _ _)
              (lower-compiler-program-with-decl-paths-mode-cache-and-state
                lower-state
                path
                (ast.ast-program decls)
                paths
                mode
                (lower-global-shared-view stdlib-roots)
                cfgs
                (load.compiler-load-prelude-cache-key
                  "typecheck-prefix-lower"
                  stdlib-roots
                  cfgs))]
            [(Err diag) (Err diag)]))
        (lower-compiler-program-with-path-mode-and-state
          lower-state
          path
          program
          mode))]
    [(Err message)
      (Err
        (box
          (lower-diagnostic-with-fallback-path (lower-diagnostic message) path)))]))

(define (lower-compiler-source-with-path-mode-and-state
  [lower-state : CompilerLowerState]
  [path : String]
  [src : String]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-source-with-path-mode-package-and-state
    lower-state
    path
    src
    mode
    ""))

(define (lower-compiler-source-with-path-mode
  [path : String]
  [src : String]
  [mode : CompilerLowerMode]) : ResultCompilerLower
  (lower-compiler-source-with-path-mode-and-state
    (compiler-lower-state-new)
    path
    src
    mode))

(define (lower-compiler-source-with-path [path : String] [src : String]) : ResultCompilerLower
  (lower-compiler-source-with-path-mode path src (CompilerLowerMode.Scalar)))

(define (lower-compiler-source-with-request
  [path : String]
  [src : String]
  [request : CompilerLowerRequest]) : ResultCompilerLower
  (let
    [state : CompilerLowerState (compiler-lower-state-new)]
    (compiler-lower-state-use-request! state request)
    (match request.pointer-proof
      [(Disabled) unit]
      [(Requested input)
        (let
          [error : String (pointer_proof.pointer-proof-input-begin-error input)]
          (when
            (> (string.string-length (& error)) 0)
            (return
              (Err
                (box
                  (cdiag.compiler-diagnostic-at-start
                    (lower-global-shared-view path)
                    error)))))
          (pointer_proof.pointer-proof-input-use-default-path!
            input
            (lower-global-shared-view path)))])
    (let
      [result : ResultCompilerLower
        (lower-compiler-source-with-path-mode-and-state
          state
          path
          src
          request.mode)]
      (match (lower-global-shared-view result)
        [(Err _)
          (match request.pointer-proof
            [(Requested input)
              (pointer_proof.pointer-proof-input-fail!
                input
                "pointer proof: requested source lowering did not complete")]
            [_ unit])]
        [_ unit])
      result)))