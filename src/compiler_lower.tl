      (ast-decl-cons
        (ast-decl-def-enum
          "DeadEnum"
          AstEnumCleanup.No
          (ast-variant-def-cons
            (ast-variant-def
              "DeadA"
              AstTypeList.Nil
              AstVariantPayloadCleanupList.Nil)
            AstVariantDefList.Nil))
        (ast-decl-cons
          (ast-decl-def-struct
