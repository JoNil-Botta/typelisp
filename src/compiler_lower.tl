(define (compiler-lower-profile-reset! [_state : CompilerLowerState]) : unit
  (cfg
    (any compile-profile test)
    (begin
      (profile_state.compiler-profile-state-metric-reset-range!
        (compiler-lower-state-profile _state)
        compiler-lower-profile-start-ms-metric
        compiler-lower-name-cache-profile-end)
      (profile_state.compiler-profile-state-metric-reset-range!
        (compiler-lower-state-profile _state)
        compiler-lower-profile-name-cache-id-growth-views-metric
        compiler-lower-name-storage-profile-end)
      (profile_state.compiler-profile-state-metric-reset-range!
        (compiler-lower-state-profile _state)
        compiler-lower-profile-module-local-view-released-metric
        compiler-lower-module-view-profile-end))
    unit))

(define (compiler-lower-profile-value
  [_state : CompilerLowerState]
  [_metric : i64]) : i64
  (cfg
    (any compile-profile test)
    (profile_state.compiler-profile-state-metric-value
      (compiler-lower-state-profile _state)
      _metric)
    0))

(define (compiler-lower-profile-set!
  [_state : CompilerLowerState]
  [_metric : i64]
  [_value : i64]) : unit
  (cfg
    (any compile-profile test)
    (profile_state.compiler-profile-state-metric-set!
      (compiler-lower-state-profile _state)
      _metric
      _value)
    unit))

(define (compiler-lower-profile-add!
  [_state : CompilerLowerState]
  [_metric : i64]
  [_value : i64]) : unit
  (cfg
    (any compile-profile test)
    (profile_state.compiler-profile-state-metric-add!
      (compiler-lower-state-profile _state)
      _metric
      _value)
    unit))

(defmacro (compiler-lower-profile-metrics-view [_state : Expr]) : Expr
  `(profile_state.compiler-profile-state-metrics
    (compiler-lower-state-profile ,_state)))

(defmacro (compiler-lower-profile-intern-metrics-address [_state : Expr]) : Expr
  `(profile_state.compiler-profile-state-metrics-address
    (compiler-lower-state-profile ,_state)))

(cfg
  compile-profile
  (define (compiler-lower-profile-field [value : i64]) : String
    (str_cat.str-cat "|" (string.int->string value))))

(cfg
  compile-profile
  (define (compiler-lower-profile-start [state : CompilerLowerState]) : unit
    (compiler-lower-profile-set!
      state
      compiler-lower-profile-start-ms-metric
      (profile.now-ms))
    (compiler-lower-profile-set!
      state
      compiler-lower-profile-start-total-metric
      (profile.alloc-total))
    (compiler-lower-profile-set!
      state
      compiler-lower-profile-start-live-metric
      (profile.alloc-live))
    (compiler-lower-profile-set!
      state
      compiler-lower-profile-start-intern-render-metric
      (ci.intern-profile-render-value
        (compiler-lower-profile-intern-metrics-address state)))
    (profile.alloc-reset-peak)))

(cfg
  compile-profile
  (define (compiler-lower-profile-finish
    [state : CompilerLowerState]
    [phase : String]) : unit
    (let
      [end-ms : i64 (profile.now-ms)]
      [end-total : i64 (profile.alloc-total)]
      [end-live : i64 (profile.alloc-live)]
      [peak-delta : i64
        (-
          (profile.alloc-peak)
          (compiler-lower-profile-value
            state
            compiler-lower-profile-start-live-metric))]
      (begin
        (io.print-error
          (str_cat.str-cat
            "compile-profile|lower."
            (lower-global-shared-view phase)
            (compiler-lower-profile-field
              (-
                end-ms
                (compiler-lower-profile-value
                  state
                  compiler-lower-profile-start-ms-metric)))
            (compiler-lower-profile-field
              (-
                end-total
                (compiler-lower-profile-value
                  state
                  compiler-lower-profile-start-total-metric)))
            (compiler-lower-profile-field
              (-
                end-live
                (compiler-lower-profile-value
                  state
                  compiler-lower-profile-start-live-metric)))
            (compiler-lower-profile-field peak-delta)
            "\n"))
        (cfg
          compile-profile-summary
          unit
          (io.print-error
            (str_cat.str-cat
              "compile-profile-detail|intern.lower_phase.render|"
              (lower-global-shared-view phase)
              "|"
              (string.int->string
                (-
                  (ci.intern-profile-render-value
                    (compiler-lower-profile-intern-metrics-address state))
                  (compiler-lower-profile-value
                    state
                    compiler-lower-profile-start-intern-render-metric)))
              "\n")))))))

(cfg
  compile-profile
  (define (compiler-lower-profile-detail-start [state : CompilerLowerState]) : unit
    (compiler-lower-profile-set!
      state
      compiler-lower-profile-detail-start-ms-metric
      (profile.now-ms))))

(cfg
  compile-profile
  (define (compiler-lower-profile-detail-finish
    [state : CompilerLowerState]
    [phase : String]
    [name : String]) : unit
    (let
      [elapsed : i64
        (-
          (profile.now-ms)
          (compiler-lower-profile-value
            state
            compiler-lower-profile-detail-start-ms-metric))]
      (cfg
        compile-profile-summary
        unit
        (if (>= elapsed 1)
          (io.print-error
            (str_cat.str-cat
              "compile-profile-detail|lower."
              phase
              "|"
              (string.int->string elapsed)
              "|"
              name
              "\n"))
          unit)))))

(cfg
  compile-profile
  ;; Counter rows reuse the six-field phase schema so benchmark profile.tsv
  ;; extraction preserves them; the counter value lives in the live-delta slot.
  (define (compiler-lower-profile-counter [name : String] [value : i64]) : unit
    (io.print-error
      (str_cat.str-cat
        "compile-profile|lower."
        name
        "|0|0"
        (compiler-lower-profile-field value)
        "|0\n"))))

(cfg
  compile-profile
  (define (compiler-lower-profile-specialization-counters
    [state : profile_state.CompilerProfileState]) : unit
    (spec.spec-profile-emit!
      (profile_state.compiler-profile-state-metrics-address state))))

