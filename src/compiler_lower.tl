(define (lower-masked-vector-body-has-varying-match-with-locals?
  [mode : CompilerLowerMode]
  [env : sym_i64_env.SymI64Env]
  [type-env : TcTypeEnv]
  [index : String]
  [lane-locals : hashmap.StringI64Map]
  [expr : AstExpr]) : bool
  (match expr
    [(AstExpr.Spanned inner-box _)
      (lower-masked-vector-body-has-varying-match-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        (ast-node-get inner-box))]
    [(AstExpr.Ann inner-box _)
      (lower-masked-vector-body-has-varying-match-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        (ast-node-get inner-box))]
    [(AstExpr.Cast inner-box _)
      (lower-masked-vector-body-has-varying-match-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        (ast-node-get inner-box))]
    [(AstExpr.Unary _ inner-box)
      (lower-masked-vector-body-has-varying-match-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        (ast-node-get inner-box))]
    [(AstExpr.Binary _ left-box right-box)
      (or
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get left-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get right-box)))]
    [(AstExpr.Let let-box)
      (match (box-get let-box)
        [(AstLet.Let bindings body-box)
          (or
            (lower-masked-vector-let-bindings-have-varying-match-with-locals?
              mode
              env
              type-env
              index
              lane-locals
              bindings)
            (lower-masked-vector-body-has-varying-match-with-locals?
              mode
              env
              type-env
              index
              (lower-masked-vector-let-bindings-locals
                mode
                env
                type-env
                index
                lane-locals
                bindings)
              (ast-node-get body-box)))])]
    [(AstExpr.If cond-box then-box else-box)
      (or
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get cond-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get then-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get else-box)))]
    [(AstExpr.Match match-box)
      (match (box-get match-box)
        [(AstMatch.Match scrutinee-box arms)
          (let
            [scrutinee : AstExpr (ast-node-get scrutinee-box)]
            [scrut-lanes : i64
              (lower-masked-vector-expr-lanes-with-locals
                mode
                env
                type-env
                index
                lane-locals
                scrutinee)]
            (or
              (> scrut-lanes 0)
              (lower-masked-vector-match-arms-have-varying-match-with-locals?
                mode
                env
                type-env
                index
                lane-locals
                scrut-lanes
                arms)))])]
    [(AstExpr.Begin exprs)
      (lower-masked-vector-expr-list-has-varying-match-with-locals?
        mode
        env
        type-env
        index
        lane-locals
        exprs)]
    [(AstExpr.ArrayRef arr-box idx-box)
      (or
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get arr-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get idx-box)))]
    [(AstExpr.ArraySet arr-box idx-box value-box)
      (or
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get arr-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get idx-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get value-box)))]
    [(AstExpr.StructSet receiver-box _ value-box)
      (or
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get receiver-box))
        (lower-masked-vector-body-has-varying-match-with-locals?
          mode
          env
          type-env
          index
          lane-locals
          (ast-node-get value-box)))]
    [_ false]))

